    def _build_bloc_suivi(self, parent) -> QWidget:
        """Grille de statuts des sous-projets + bouton Démarrer/Arrêter
        (section 4 et 8 du patch)."""
        bloc = QWidget(parent)
        layout = QVBoxLayout(bloc)
        layout.setContentsMargins(0, 0, 0, 0)
        layout.setSpacing(10)

        ligne_titre = QHBoxLayout()
        titre = QLabel("Suivi et démarrage", bloc)
        titre.setObjectName("PlaceholderTitle")
        ligne_titre.addWidget(titre)
        ligne_titre.addStretch(1)

        self.bouton_rafraichir_sous_projets = QToolButton(bloc)
        self.bouton_rafraichir_sous_projets.setObjectName("RetourButton")
        self.bouton_rafraichir_sous_projets.setIcon(qta.icon("mdi6.refresh", color=Mocha.subtext0))
        self.bouton_rafraichir_sous_projets.setIconSize(QSize(18, 18))
        self.bouton_rafraichir_sous_projets.setCursor(Qt.PointingHandCursor)
        self.bouton_rafraichir_sous_projets.setToolTip("Rafraîchir la liste des sous-projets depuis le disque")
        self.bouton_rafraichir_sous_projets.clicked.connect(self._reload_sous_projets)
        ligne_titre.addWidget(self.bouton_rafraichir_sous_projets)
        layout.addLayout(ligne_titre)

        # Bouton unique, bascule Démarrer/Arrêter (même pattern que
        # ProfilsInstancesScreen.bouton_lancer_arreter) selon qu'un
        # MoteurExecutionBatch est en cours ou non.
        self.bouton_demarrer_arreter = QPushButton(qta.icon("mdi6.play", color=Mocha.crust), "Démarrer le batch", bloc)
        self.bouton_demarrer_arreter.setObjectName("CaptureButton")
        self.bouton_demarrer_arreter.clicked.connect(self._on_clic_demarrer_ou_arreter)
        layout.addWidget(self.bouton_demarrer_arreter)

        # PATCH (Patch 4.4.a -- "Envoyer vers un sAutoniax") : action
        # distincte du Démarrer/Arrêter local ci-dessus -- délègue
        # l'exécution ENTIÈRE de ce ProjetBatch à un sAutoniax connecté,
        # au lieu de traiter localement. Ouvre un dialogue de sélection
        # (cible + profils cloud à cocher), cf. DialogueEnvoiSautoniax.
        self.bouton_envoyer_sautoniax = QPushButton(
            qta.icon("mdi6.upload-network-outline", color=Mocha.subtext0), "Envoyer vers un sAutoniax", bloc,
        )
        self.bouton_envoyer_sautoniax.setCursor(Qt.PointingHandCursor)
        self.bouton_envoyer_sautoniax.clicked.connect(self._on_clic_envoyer_sautoniax)
        layout.addWidget(self.bouton_envoyer_sautoniax)

        # PATCH E.7 (cf. cahier des charges patchs.md, section E.7 --
        # "Assignation des profils : un profil par sous-projet"). "C'est
        # dans l'interface de Batch que l'assignation réelle et
        # définitive a lieu, via un bouton 'Attribuer les profils' qui
        # ouvre cette mini-app" -- ouvre AttributionProfilsScreen dans la
        # zone d'application (cf. B.5, même mécanisme que le bouton
        # "Aperçu" d'E.1), présélectionne le mapping déjà enregistré s'il
        # y en a un.
        #
        # IMPORTANT (cf. docstring de ProjetBatch.mapping_profils_sous_
        # projets pour le détail complet) : à ce stade, ce bouton
        # PERSISTE l'attribution choisie mais NE LA FAIT PAS ENCORE
        # RESPECTER à l'exécution -- MoteurExecutionBatch reste un pool
        # FIFO pur (local ET distant sur sAutoniax), le pool coché dans
        # DialogueEnvoiSautoniax reste seul déterminant à l'envoi.
        # Brancher réellement l'appariement dans le dispatch d'exécution
        # est reporté à une session dédiée (modification du cœur
        # d'exécution, à tester en conditions réelles plutôt qu'à
        # l'aveugle).
        self.bouton_attribuer_profils = QPushButton(
            qta.icon("mdi6.account-multiple-check-outline", color=Mocha.subtext0), "Attribuer les profils", bloc,
        )
        self.bouton_attribuer_profils.setCursor(Qt.PointingHandCursor)
        self.bouton_attribuer_profils.setToolTip(
            "Assigne individuellement un profil par sous-projet (remplace le pool "
            "partagé pour ce batch précis, cf. cahier des charges section E.7)."
        )
        self.bouton_attribuer_profils.clicked.connect(self._on_clic_attribuer_profils)
        layout.addWidget(self.bouton_attribuer_profils)

        # PATCH E.5 (cf. cahier des charges patchs.md, section E.5) --
        # "Depuis un batch terminé, actions possibles : Traiter les
        # échecs (relance uniquement les sous-projets/profils qui ont
        # échoué) / Retraiter (relance l'intégralité du batch, comme un
        # nouveau batch frais)". Les DEUX réutilisent le mécanisme de
        # sélection déjà existant (_appliquer_selection_sous_projets,
        # même prédicat que les boutons raccourcis "Cocher les
        # non-succès"/"Tout cocher" juste au-dessus) -- la seule pièce
        # manquante était que l'envoi réseau (_on_clic_envoyer_sautoniax)
        # ignorait complètement _sous_projets_coches et envoyait TOUJOURS
        # tout chemin_racine (comportement voulu pour le premier envoi,
        # cf. E.4 -- CE bouton-ci ne le change pas). Ces deux nouveaux
        # boutons appellent donc un chemin d'envoi FILTRÉ distinct (cf.
        # _on_clic_traiter_echecs/_on_clic_retraiter et le nouveau signal
        # demande_envoi_projet_sautoniax_filtre), qui ne construit un zip
        # que pour les sous-projets sélectionnés au moment du clic --
        # jamais le bouton "Envoyer vers un sAutoniax" original, qui
        # reste inchangé.
        #
        # N'ont de sens que sur un batch ayant déjà connu AU MOINS un
        # passage (sinon "traiter les échecs"/"retraiter" n'ont rien à
        # traiter -- tous les sous-projets sont encore "non_traite") --
        # désactivés tant que ce n'est pas le cas, cf. _reload_sous_projets
        # qui appelle _rafraichir_boutons_retraitement après reconstruction.
        ligne_retraitement = QHBoxLayout()
        self.bouton_traiter_echecs = QPushButton(
            qta.icon("mdi6.reload-alert", color=Mocha.subtext0), "Traiter les échecs", bloc,
        )
        self.bouton_traiter_echecs.setCursor(Qt.PointingHandCursor)
        self.bouton_traiter_echecs.setToolTip(
            "Relance uniquement les sous-projets en échec sur un sAutoniax "
            "(coche automatiquement les sous-projets 'échec', décoche le reste)."
        )
        self.bouton_traiter_echecs.clicked.connect(self._on_clic_traiter_echecs)
        ligne_retraitement.addWidget(self.bouton_traiter_echecs)

        self.bouton_retraiter_tout = QPushButton(
            qta.icon("mdi6.reload", color=Mocha.subtext0), "Retraiter (tout)", bloc,
        )
        self.bouton_retraiter_tout.setCursor(Qt.PointingHandCursor)
        self.bouton_retraiter_tout.setToolTip(
            "Relance l'intégralité du batch sur un sAutoniax, comme un nouveau batch frais "
            "(coche tous les sous-projets, y compris ceux déjà en succès)."
        )
        self.bouton_retraiter_tout.clicked.connect(self._on_clic_retraiter_tout)
        ligne_retraitement.addWidget(self.bouton_retraiter_tout)
        layout.addLayout(ligne_retraitement)

        self.label_statut_batch = QLabel(bloc)
        self.label_statut_batch.setObjectName("PlaceholderSubtitle")
        self.label_statut_batch.setWordWrap(True)
        layout.addWidget(self.label_statut_batch)

        # Boutons raccourcis de sélection (décision explicite utilisateur,
        # section "sélection des sous-projets") -- agissent sur TOUTES les
        # SousProjetCarte actuellement affichées, peu importe leur statut
        # pour les deux premiers ; le 3e ("cocher les non-succès") coche
        # non_traite+echec et décoche succes, soit exactement la même
        # règle que la présélection automatique à l'ouverture (cf.
        # _reload_sous_projets) -- utile pour revenir à cet état par
        # défaut après une sélection manuelle.
        ligne_raccourcis = QHBoxLayout()
        self.bouton_tout_cocher = QToolButton(bloc)
        self.bouton_tout_cocher.setText("Tout cocher")
        self.bouton_tout_cocher.setCursor(Qt.PointingHandCursor)
        self.bouton_tout_cocher.clicked.connect(lambda: self._appliquer_selection_sous_projets(lambda statut: True))
        ligne_raccourcis.addWidget(self.bouton_tout_cocher)

        self.bouton_tout_decocher = QToolButton(bloc)
        self.bouton_tout_decocher.setText("Tout décocher")
        self.bouton_tout_decocher.setCursor(Qt.PointingHandCursor)
        self.bouton_tout_decocher.clicked.connect(lambda: self._appliquer_selection_sous_projets(lambda statut: False))
        ligne_raccourcis.addWidget(self.bouton_tout_decocher)

        self.bouton_cocher_non_succes = QToolButton(bloc)
        self.bouton_cocher_non_succes.setText("Cocher les non-succès")
        self.bouton_cocher_non_succes.setCursor(Qt.PointingHandCursor)
        self.bouton_cocher_non_succes.setToolTip("Coche uniquement les sous-projets non_traité et échec (décoche les succès) -- même règle que la présélection à l'ouverture.")
        self.bouton_cocher_non_succes.clicked.connect(lambda: self._appliquer_selection_sous_projets(lambda statut: statut != "succes"))
        ligne_raccourcis.addWidget(self.bouton_cocher_non_succes)

        ligne_raccourcis.addStretch(1)
        layout.addLayout(ligne_raccourcis)

        # Deuxième ligne : marquage manuel du statut des sous-projets
        # COCHÉS (indépendant de la sélection elle-même -- un sous-projet
        # reste coché ou décoché tel quel après le marquage, seul son
        # statut change). Utile pour forcer un statut sans repasser par un
        # vrai traitement (ex: correction manuelle après vérification hors
        # AutoniaX, ou pour retirer un sous-projet de la file sans avoir à
        # le décocher un par un après un batch problématique).
        ligne_marquage = QHBoxLayout()
        self.bouton_marquer_succes = QToolButton(bloc)
        self.bouton_marquer_succes.setText("Marquer comme succès")
        self.bouton_marquer_succes.setCursor(Qt.PointingHandCursor)
        self.bouton_marquer_succes.setToolTip("Force le statut 'succes' pour tous les sous-projets actuellement cochés.")
        self.bouton_marquer_succes.clicked.connect(lambda: self._marquer_statut_sous_projets_coches("succes"))
        ligne_marquage.addWidget(self.bouton_marquer_succes)

        self.bouton_marquer_echec = QToolButton(bloc)
        self.bouton_marquer_echec.setText("Marquer comme échec")
        self.bouton_marquer_echec.setCursor(Qt.PointingHandCursor)
        self.bouton_marquer_echec.setToolTip("Force le statut 'echec' pour tous les sous-projets actuellement cochés.")
        self.bouton_marquer_echec.clicked.connect(lambda: self._marquer_statut_sous_projets_coches("echec"))
        ligne_marquage.addWidget(self.bouton_marquer_echec)

        ligne_marquage.addStretch(1)
        layout.addLayout(ligne_marquage)

        self.sous_projets_scroll = QScrollArea(bloc)
        self.sous_projets_scroll.setObjectName("FlowGridViewport")
        self.sous_projets_scroll.setWidgetResizable(True)
        self.sous_projets_scroll.setFrameShape(QFrame.NoFrame)
        self.sous_projets_scroll.setHorizontalScrollBarPolicy(Qt.ScrollBarAlwaysOff)
        self.sous_projets_scroll.setVerticalScrollBarPolicy(Qt.ScrollBarAlwaysOff)
        self.sous_projets_scroll.setFixedHeight(320)

        sous_projets_wrapper = QWidget(self.sous_projets_scroll)
        sous_projets_wrapper_layout = QVBoxLayout(sous_projets_wrapper)
        sous_projets_wrapper_layout.setContentsMargins(0, 0, 0, 0)
        sous_projets_wrapper_layout.setSpacing(0)
        self.flow_grid_sous_projets = FlowGrid(item_width=160, spacing=12, center=False)
        sous_projets_wrapper_layout.addWidget(self.flow_grid_sous_projets)
        sous_projets_wrapper_layout.addStretch(1)
        self.sous_projets_scroll.setWidget(sous_projets_wrapper)
        layout.addWidget(self.sous_projets_scroll)

        self.label_aucun_sous_projet = QLabel(
            "Aucun sous-projet trouvé dans le dossier racine (dossiers numérotés 1/, 2/, ... attendus).",
            bloc,
        )
        self.label_aucun_sous_projet.setObjectName("PlaceholderSubtitle")
        self.label_aucun_sous_projet.setWordWrap(True)
        self.label_aucun_sous_projet.setVisible(False)
        layout.addWidget(self.label_aucun_sous_projet)

        return bloc

    # ------------------------------------------------------------------
    # Onglet "Aperçu d'exécution" (PATCH -- demande explicite utilisateur :
    # "je ne veux plus qu'il y ait le screen d'aperçu, c'est inutile, le
    # dashboard a déjà un rendu d'aperçu pour les profils ... ce que on doit
    # juste faire c'est afficher les output, les sorties d'exécution de
    # chaque profil ... tu mets juste un nombre d'onglet correspondant aux
    # profils dont les task sont en train de s'exécuter") -- l'écran divisé
    # en 2 colonnes (liste d'instances + rendu vidéo InstanceApercuScreen)
    # est remplacé par un simple QTabWidget interne : UN onglet par
    # instance ayant (ou ayant eu, cf. plus bas) une tâche active pendant
    # cette session, chaque onglet ne contenant QUE le notebook en lecture
    # seule (logs/sorties par cellule, cf. NotebookExecutionLectureSeule)
    # de cette instance précise. Plus aucun rendu visuel ici -- le Dashboard
    # remplit déjà ce rôle (streaming des profils), cf. demande explicite.
    #
    # instance_apercu_batch (InstanceApercuScreen) est CONSERVÉE en
    # interne, mais entièrement invisible (setVisible(False) sur son
    # _panneau_rendu ET son _scroll, cf. plus bas) : elle ne sert plus
    # qu'à porter la connexion réseau "pilote exclusif" utilisée par le
    # BUGFIX de _demarrer_batch (self.instance_apercu_batch.client_reseau /
    # ._instance_liee / .selectionner_instance(None), cf. leurs docstrings
    # -- libère explicitement l'instance avant que MoteurExecutionBatch.
    # lancer() ne vérifie la disponibilité, pour éviter la boucle
    # "InstancesIndisponiblesError" déjà corrigée). Supprimer cet objet
    # réintroduirait ce bug -- seul son AFFICHAGE est retiré ici, jamais sa
    # connexion réseau.
    #
    # État propre à cet onglet (initialisé ici plutôt que dans __init__ de
    # la classe -- ne concerne QUE cette brique, regroupé pour rester
    # lisible) :
    #   _onglets_apercu_par_instance : instance_id -> dict des widgets de
    #     l'onglet créé pour cette instance (cf. _obtenir_ou_creer_onglet_
    #     apercu), un onglet par instance ayant démarré au moins un
    #     sous-projet pendant cette ouverture du ProjetBatch -- créé à la
    #     demande (première fois que _sur_apercu_sous_projet_demarre est
    #     appelé pour cette instance), jamais retiré avant la fermeture/
    #     réouverture de l'écran (le dernier résultat reste visible/figé
    #     une fois la tâche de cette instance terminée, plutôt que de faire
    #     disparaître l'onglet sous les yeux de l'utilisateur).
    #   _historique_par_instance : instance_id -> list[numero] des sous-
    #     projets traités par CETTE instance pendant la session courante
    #     (jamais persisté -- reconstruit à partir de zéro à chaque
    #     ouverture de l'écran), alimenté à chaque sous_projet_cellule_
    #     demarree (cf. _sur_apercu_cellule_demarree) pour peupler le
    #     précédent/suivant sans reparcourir tout l'historique disque à
    #     chaque clic.
    #   _index_historique_par_instance : instance_id -> index courant
    #     dans _historique_par_instance[instance_id] (position de
    #     navigation précédent/suivant) -- None/absent = "position live"
    #     (dernier élément, mode LIVE si un sous-projet est en cours pour
    #     cette instance, sinon dernière tentative de l'historique disque).
    # ------------------------------------------------------------------
    def _build_apercu_execution(self) -> QWidget:
        page = QWidget(self.editeur_tabs)
        page.setObjectName("ProjetBatchApercuExecution")
        layout_racine = QVBoxLayout(page)
        layout_racine.setContentsMargins(0, 0, 0, 0)
        layout_racine.setSpacing(0)

        self._historique_par_instance: dict = {}  # instance_id -> list[numero]
        self._index_historique_par_instance: dict = {}  # instance_id -> index courant (absent = position live)
        self._onglets_apercu_par_instance: dict = {}  # instance_id -> {"page": QWidget, "notebook": NotebookExecutionLectureSeule, "bouton_precedent": ..., "bouton_suivant": ..., "label_position": ...}

        # Label affiché tant qu'aucune instance n'a encore démarré de
        # sous-projet dans cette session (avant le tout premier onglet
        # créé) -- évite un QTabWidget vide et déroutant à l'ouverture.
        self._label_apercu_vide = QLabel(
            "Aucune tâche en cours pour l'instant -- un onglet apparaît ici "
            "dès qu'une instance démarre un sous-projet.", page,
        )
        self._label_apercu_vide.setObjectName("NotebookExecutionLabelVide")
        self._label_apercu_vide.setAlignment(Qt.AlignCenter)
        layout_racine.addWidget(self._label_apercu_vide, 1)

        self.onglets_apercu_instances = QTabWidget(page)
        self.onglets_apercu_instances.setObjectName("ProjetBatchApercuInstancesTabs")
        self.onglets_apercu_instances.setVisible(False)
        layout_racine.addWidget(self.onglets_apercu_instances, 1)

        # --- InstanceApercuScreen conservée mais entièrement masquée --
        # cf. bloc de commentaires ci-dessus : uniquement pour sa connexion
        # réseau "pilote exclusif" (BUGFIX de _demarrer_batch), jamais
        # affichée ni ajoutée à un layout visible. Pas de parent visuel
        # nécessaire (jamais montrée), `page` comme parent Qt suffit pour
        # que son cycle de vie suive celui de cet onglet.
        self.instance_apercu_batch = InstanceApercuScreen(
            id_pilote_prefixe="autoniax-batch-apercu", titre_apercu="APERÇU DE L'INSTANCE (BATCH)", parent=page,
        )
        self.instance_apercu_batch.setVisible(False)
        self.instance_apercu_batch._scroll.setVisible(False)
        self.instance_apercu_batch._panneau_rendu.setVisible(False)
        self.instance_apercu_batch.demarrer_reseau()

        return page

    # ------------------------------------------------------------------
    # Un onglet de logs par instance active (remplace la sélection unique
    # + rendu vidéo de l'ancien écran, cf. docstring _build_apercu_execution)
    # ------------------------------------------------------------------
    def _obtenir_ou_creer_onglet_apercu(self, instance_id: str) -> dict:
        """Retourne le dict de widgets de l'onglet dédié à instance_id,
        le créant (et l'ajoutant à onglets_apercu_instances) s'il n'existe
        pas encore -- premier appel pour une instance donnée déclenché par
        _sur_apercu_sous_projet_demarre. Bascule aussi la visibilité entre
        le label "vide" et le QTabWidget dès le tout premier onglet créé."""
        onglet = self._onglets_apercu_par_instance.get(instance_id)
        if onglet is not None:
            return onglet

        page_onglet = QWidget(self.onglets_apercu_instances)
        layout_onglet = QVBoxLayout(page_onglet)
        layout_onglet.setContentsMargins(16, 12, 16, 16)
        layout_onglet.setSpacing(8)

        ligne_navigation = QHBoxLayout()
        bouton_precedent = QToolButton(page_onglet)
        bouton_precedent.setIcon(qta.icon("mdi6.chevron-left", color=Mocha.text))
        bouton_precedent.setCursor(Qt.PointingHandCursor)
        bouton_precedent.setToolTip("Tentative précédente de cette instance")
        bouton_precedent.clicked.connect(lambda: self._sur_clic_historique_precedent(instance_id))
        ligne_navigation.addWidget(bouton_precedent)

        label_position = QLabel("—", page_onglet)
        label_position.setAlignment(Qt.AlignCenter)
        label_position.setStyleSheet(f"color: {Mocha.subtext0}; font-size: 11px;")
        ligne_navigation.addWidget(label_position, 1)

        bouton_suivant = QToolButton(page_onglet)
        bouton_suivant.setIcon(qta.icon("mdi6.chevron-right", color=Mocha.text))
        bouton_suivant.setCursor(Qt.PointingHandCursor)
        bouton_suivant.setToolTip("Tentative suivante de cette instance")
        bouton_suivant.clicked.connect(lambda: self._sur_clic_historique_suivant(instance_id))
        ligne_navigation.addWidget(bouton_suivant)
        layout_onglet.addLayout(ligne_navigation)

        notebook = NotebookExecutionLectureSeule(parent=page_onglet)
        layout_onglet.addWidget(notebook, 1)

        onglet = {
            "page": page_onglet,
            "notebook": notebook,
            "bouton_precedent": bouton_precedent,
            "bouton_suivant": bouton_suivant,
            "label_position": label_position,
        }
        self._onglets_apercu_par_instance[instance_id] = onglet
        self.onglets_apercu_instances.addTab(page_onglet, instance_id)

        if self.onglets_apercu_instances.count() == 1:
            self._label_apercu_vide.setVisible(False)
            self.onglets_apercu_instances.setVisible(True)

        return onglet

    def _vider_onglets_apercu(self):
        """Retire tous les onglets d'instance et revient à l'état initial
        (label "vide") -- appelé à chaque (ré)ouverture d'un ProjetBatch
        (cf. _peupler_editeur), même moment que la remise à zéro de
        _historique_par_instance : un onglet créé pendant l'exécution
        précédemment observée sur CET écran n'a plus de raison de rester
        affiché une fois qu'on rouvre (ou qu'on ouvre un autre) ProjetBatch."""
        self.onglets_apercu_instances.clear()
        self._onglets_apercu_par_instance = {}
        self.onglets_apercu_instances.setVisible(False)
        self._label_apercu_vide.setVisible(True)

    def _afficher_position_live(self, instance_id: str):
        """Affiche, dans l'onglet de instance_id (créé au besoin), le
        sous-projet EN COURS s'il y en a un (mode LIVE -- cf.
        MoteurExecutionBatch._en_cours), sinon la DERNIÈRE tentative de
        son historique disque le plus récent parmi les sous-projets déjà
        traités par cette instance dans la session courante (cf.
        _historique_par_instance). Réinitialise la navigation précédent/
        suivant de CET onglet sur cette position ("position live", donc
        absente de _index_historique_par_instance -- cf. sa docstring)."""
        onglet = self._obtenir_ou_creer_onglet_apercu(instance_id)
        self._index_historique_par_instance.pop(instance_id, None)
        projet_batch = self._projet_batch_ouvert()
        sous_projet_en_cours = None
        if self._moteur_batch is not None and projet_batch is not None:
            sous_projet_en_cours = self._moteur_batch._en_cours.get(instance_id)
        if sous_projet_en_cours is not None:
            sequence = self._moteur_batch.sequence_cellules_pour_instance(instance_id)
            onglet["notebook"].demarrer_sequence(sequence)
        else:
            self._afficher_derniere_tentative_connue(instance_id)
        self._rafraichir_navigation_historique(instance_id)

    def _afficher_derniere_tentative_connue(self, instance_id: str):
        """Affiche, dans l'onglet de instance_id, la dernière tentative de
        l'historique disque du DERNIER sous-projet traité par instance_id
        dans la session courante (cf. _historique_par_instance) -- vide
        l'affichage si cette instance n'a encore rien traité depuis
        l'ouverture de l'écran (aucun historique de session à montrer,
        même si d'anciennes tentatives existent peut-être sur disque
        d'une session précédente -- cohérent avec _historique_par_instance,
        jamais reconstruit depuis le disque, cf. sa docstring)."""
        onglet = self._obtenir_ou_creer_onglet_apercu(instance_id)
        projet_batch = self._projet_batch_ouvert()
        numeros = self._historique_par_instance.get(instance_id) or []
        if not numeros or projet_batch is None:
            onglet["notebook"].vider_affichage()
            return
        dossier = Path(projet_batch.chemin_racine) / str(numeros[-1])
        tentatives = SousProjet.depuis_dossier(dossier).lire_historique_executions()
        tentatives_instance = [t for t in tentatives if t.get("instance_id") == instance_id]
        if tentatives_instance:
            onglet["notebook"].charger_tentative(tentatives_instance[-1])
        else:
            onglet["notebook"].vider_affichage()

    # ------------------------------------------------------------------
    # Navigation précédent/suivant dans l'historique de CHAQUE onglet
    # d'instance (cf. docstring _build_apercu_execution) -- chaque onglet
    # possède sa propre navigation indépendante, contrairement à l'ancienne
    # sélection unique.
    # ------------------------------------------------------------------
    def _rafraichir_navigation_historique(self, instance_id: str):
        onglet = self._onglets_apercu_par_instance.get(instance_id)
        if onglet is None:
            return
        numeros = self._historique_par_instance.get(instance_id) or []
        if not numeros:
            onglet["label_position"].setText("—")
            onglet["bouton_precedent"].setEnabled(False)
            onglet["bouton_suivant"].setEnabled(False)
            return
        index = self._index_historique_par_instance.get(instance_id, len(numeros) - 1)
        onglet["label_position"].setText(f"{index + 1}/{len(numeros)} (sous-projet {numeros[index]})")
        onglet["bouton_precedent"].setEnabled(index > 0)
        # "Suivant" reste actif même à la dernière position connue tant
        # qu'on n'est pas déjà en position live (permet de revenir au
        # live après être remonté dans l'historique) -- désactivé
        # seulement si l'index n'est pas explicitement suivi (déjà live).
        est_en_position_live = instance_id not in self._index_historique_par_instance
        onglet["bouton_suivant"].setEnabled(not est_en_position_live)

    def _sur_clic_historique_precedent(self, instance_id: str):
        numeros = self._historique_par_instance.get(instance_id) or []
        if not numeros:
            return
        index_actuel = self._index_historique_par_instance.get(instance_id, len(numeros) - 1)
        nouvel_index = max(0, index_actuel - 1)
        self._afficher_position_historique(instance_id, nouvel_index)

    def _sur_clic_historique_suivant(self, instance_id: str):
        numeros = self._historique_par_instance.get(instance_id) or []
        if not numeros:
            return
        index_actuel = self._index_historique_par_instance.get(instance_id, len(numeros) - 1)
        if index_actuel >= len(numeros) - 1:
            # Déjà à la dernière tentative connue -- "suivant" revient à
            # la position live plutôt que de rester bloqué sur place.
            self._afficher_position_live(instance_id)
            return
        # cf. _afficher_position_historique : si le numéro visé est le
        # sous-projet EN COURS sur cette instance (pas encore de tentative
        # sur disque), elle redirige elle-même vers le mode live -- pas
        # besoin de dupliquer cette vérification ici.
        self._afficher_position_historique(instance_id, index_actuel + 1)

    def _afficher_position_historique(self, instance_id: str, index: int):
        onglet = self._onglets_apercu_par_instance.get(instance_id)
        projet_batch = self._projet_batch_ouvert()
        numeros = self._historique_par_instance.get(instance_id) or []
        if onglet is None or projet_batch is None or not (0 <= index < len(numeros)):
            return
        # Garde symétrique à celle de _sur_clic_historique_suivant : si le
        # numéro visé est justement le sous-projet EN COURS sur cette
        # instance (pas encore de notebook_execution.json sur disque),
        # rediriger vers le mode live plutôt que d'afficher un historique
        # vide qui laisserait croire à une tentative disque valide (cf.
        # label "x/y (sous-projet n)" qui ne distingue pas live/historique).
        sous_projet_en_cours = self._moteur_batch._en_cours.get(instance_id) if self._moteur_batch is not None else None
        if sous_projet_en_cours is not None and numeros[index] == sous_projet_en_cours.numero:
            self._afficher_position_live(instance_id)
            return
        self._index_historique_par_instance[instance_id] = index
        dossier = Path(projet_batch.chemin_racine) / str(numeros[index])
        tentatives = SousProjet.depuis_dossier(dossier).lire_historique_executions()
        tentatives_instance = [t for t in tentatives if t.get("instance_id") == instance_id]
        if tentatives_instance:
            onglet["notebook"].charger_tentative(tentatives_instance[-1])
        else:
            onglet["notebook"].vider_affichage()
        self._rafraichir_navigation_historique(instance_id)

    # ------------------------------------------------------------------
    # Relais des signaux de progression de MoteurExecutionBatch --
    # connectés/déconnectés en même temps que sous_projet_maj/
    # batch_termine (cf. _demarrer_batch/_deconnecter_signaux_moteur_
    # affiche). PATCH : met désormais à jour l'onglet DE CETTE instance
    # (créé à la demande, cf. _obtenir_ou_creer_onglet_apercu) au lieu de
    # filtrer sur une sélection unique -- toutes les instances actives
    # progressent en parallèle, chacune dans son propre onglet.
    # ------------------------------------------------------------------
    def _sur_apercu_sous_projet_demarre(self, numero: int, instance_id: str):
        """cf. _sur_sous_projet_maj (statut "en_cours") -- construit le
        notebook LIVE (blocs vides) dans l'onglet de cette instance
        (créé s'il n'existait pas encore), et alimente _historique_par_
        instance (cf. sa docstring)."""
        self._historique_par_instance.setdefault(instance_id, [])
        if not self._historique_par_instance[instance_id] or self._historique_par_instance[instance_id][-1] != numero:
            self._historique_par_instance[instance_id].append(numero)
        onglet = self._obtenir_ou_creer_onglet_apercu(instance_id)
        sequence = self._moteur_batch.sequence_cellules_pour_instance(instance_id) if self._moteur_batch else []
        onglet["notebook"].demarrer_sequence(sequence)
        self._index_historique_par_instance.pop(instance_id, None)
        self._rafraichir_navigation_historique(instance_id)

    def _sur_apercu_cellule_demarree(self, instance_id: str, cellule_id: str, titre: str):
        onglet = self._onglets_apercu_par_instance.get(instance_id)
        if onglet is None:
            return  # ne devrait pas arriver : _sur_apercu_sous_projet_demarre crée toujours l'onglet en premier
        onglet["notebook"].marquer_cellule_demarree(cellule_id, titre)

    def _sur_apercu_cellule_terminee(self, instance_id: str, cellule_id: str, ok: bool, sortie_ou_erreur: str):
        onglet = self._onglets_apercu_par_instance.get(instance_id)
        if onglet is None:
            return
        onglet["notebook"].marquer_cellule_terminee(cellule_id, ok, sortie_ou_erreur)

    def _sur_apercu_cellule_image_bug(self, instance_id: str, cellule_id: str, chemin_image: str):
        """Relais de MoteurExecutionBatch.sous_projet_cellule_image_bug --
        arrive toujours APRÈS _sur_apercu_cellule_terminee pour la même
        cellule (capture réseau asynchrone, cf. docstring du signal), donc
        le bloc existe déjà dans le notebook LIVE de cet onglet à ce
        stade. Ignoré silencieusement si l'onglet a depuis été fermé/
        n'existe plus (ne devrait pas arriver, les onglets restent figés
        jusqu'à la fin du batch, cf. docstring _obtenir_ou_creer_onglet_
        apercu)."""
        onglet = self._onglets_apercu_par_instance.get(instance_id)
        if onglet is None:
            return
        onglet["notebook"].afficher_image_bug_cellule(cellule_id, chemin_image)

    # ------------------------------------------------------------------
    # PATCH -- plus de rendu vidéo à suspendre/reprendre selon l'onglet
    # visible (InstanceApercuScreen n'est plus affichée, cf. docstring
    # _build_apercu_execution) : ce handler ne fait donc plus rien, gardé
    # uniquement parce qu'il reste connecté à editeur_tabs.currentChanged
    # (cf. son .connect() plus haut) -- laissé en no-op explicite plutôt
    # que de retirer la connexion, pour ne pas complexifier ce point pour
    # un signal qui ne coûte rien à laisser branché.
    # ------------------------------------------------------------------
    def _sur_changement_onglet_editeur(self, index: int):
        pass

    # ------------------------------------------------------------------
    # Ouverture/fermeture d'un ProjetBatch
    # ------------------------------------------------------------------
    def _ouvrir_projet_batch(self, projet_batch_id: str):
        projet_batch = self.project.find_projet_batch(projet_batch_id)
        if projet_batch is None:
            return
        self._projet_batch_courant = projet_batch_id
        self._peupler_editeur(projet_batch)
        self.stack.setCurrentWidget(self.editeur_page)

    def _notify_status(self, message: str, error: bool = False):
        window = self.window()
        if hasattr(window, "statusBar"):
            window.statusBar().showMessage(message, 4000)

    def _projet_batch_ouvert(self) -> Optional["ProjetBatch"]:
        if self._projet_batch_courant is None:
            return None
        return self.project.find_projet_batch(self._projet_batch_courant)

    def _peupler_editeur(self, projet_batch: "ProjetBatch"):
        self.nom_edit.setText(projet_batch.nom)

        # Reconstruit la liste des Tasks disponibles à chaque ouverture
        # (même logique que TaskConfigScreen : reste à jour si des Tasks
        # ont été ajoutés/supprimés depuis la dernière ouverture) --
        # signal bloqué pendant le peuplement pour ne pas déclencher
        # _on_task_changed (qui réinitialiserait le mapping) juste en
        # affichant la sélection déjà existante.
        self.task_combo.blockSignals(True)
        self.task_combo.clear()
        self.task_combo.addItem("(Aucun Task sélectionné)", "")
        index_a_selectionner = 0
        for i, task in enumerate(self.project.tasks, start=1):
            self.task_combo.addItem(task.nom, task.id)
            if task.id == projet_batch.task_id:
                index_a_selectionner = i
        self.task_combo.setCurrentIndex(index_a_selectionner)
        self.task_combo.blockSignals(False)

        # Présélectionne les instances déjà cochées pour CE ProjetBatch
        # (persisté, cf. ProjetBatch.instances_selectionnees) -- distinct de
        # self._instances_cochees, qui reflète l'état VISUEL courant de la
        # liste et sera réinitialisé ici avant le prochain peuplement.
        self._instances_cochees = set(projet_batch.instances_selectionnees)
        self._rafraichir_liste_instances_batch()
        # Recalcul explicite de la grille à l'ouverture (QTimer.singleShot(0, ...)
        # laisse Qt stabiliser la géométrie du widget avant de mesurer sa largeur
        # -- même pattern que ProfilsInstancesScreen dans son __init__, cf.
        # _recalculer_grille_profils) : un simple appel direct ici verrait parfois
        # encore l'ancienne largeur (page pas encore affichée au moment du switch
        # d'onglet), ce qui figerait la grille sur un mauvais nombre de colonnes
        # jusqu'au prochain redimensionnement manuel de la fenêtre.
        QTimer.singleShot(0, self._recalculer_grille_instances_batch)

        self.racine_edit.setText(projet_batch.chemin_racine)

        self._variable_selectionnee: Optional[str] = None
        self._rafraichir_bloc_mapping(projet_batch)
        self._reload_sous_projets()
        self._rafraichir_bouton_demarrer_arreter()
        self.label_statut_batch.setText("")

        # PATCH -- onglet "Aperçu d'exécution" (logs par instance) :
        # historique de session réinitialisé à chaque (ré)ouverture d'un
        # ProjetBatch (cf. docstring _build_apercu_execution :
        # _historique_par_instance n'est jamais persisté ni relu depuis
        # un ProjetBatch précédemment ouvert dans cette même fenêtre) --
        # les onglets d'instance créés lors d'une exécution précédemment
        # observée sur cet écran sont retirés en même temps (cf.
        # _vider_onglets_apercu), ils réapparaîtront à la demande dès
        # qu'une instance redémarre un sous-projet sur CE ProjetBatch.
        self._historique_par_instance = {}
        self._index_historique_par_instance = {}
        self._vider_onglets_apercu()

    def _on_nom_edited(self):
        projet_batch = self._projet_batch_ouvert()
        if projet_batch is None:
            return
        nouveau_nom = self.nom_edit.text().strip()
        if not nouveau_nom:
            self.nom_edit.setText(projet_batch.nom)
            return
        projet_batch.nom = nouveau_nom
        self.project.save()
        carte = self._projet_batch_cartes.get(projet_batch.id)
        if carte is not None:
            carte.rafraichir(projet_batch, self.project)

    def _supprimer_projet_batch(self):
        projet_batch = self._projet_batch_ouvert()
        if projet_batch is None:
            return
        if self._moteur_batch is not None:
            # Un batch en cours ne doit pas pouvoir être supprimé sous les
            # pieds de MoteurExecutionBatch (qui garde une référence directe
            # à cet objet ProjetBatch, cf. son __init__) -- l'utilisateur
            # doit d'abord arrêter explicitement.
            BoiteDialogueAutoniaX.warning(
                self, "Batch en cours",
                "Arrêtez le batch avant de supprimer ce Projet Batch.",
            )
            return
        # PATCH (demande utilisateur explicite : corbeille) : plus de
        # QMessageBox de confirmation ici -- remove_projet_batch déplace
        # désormais le Projet Batch vers la corbeille au lieu de le
        # supprimer pour de bon (l'avertissement "Batch en cours"
        # ci-dessus reste : ce n'est PAS une confirmation de suppression,
        # c'est un blocage de sécurité pendant qu'une exécution est en
        # cours, qui doit rester).
        self.project.remove_projet_batch(projet_batch.id)
        self.project.save()
        self._retour_grille()

    # ------------------------------------------------------------------
    # Bloc config
    # ------------------------------------------------------------------
    def _on_task_changed(self, index: int):
        projet_batch = self._projet_batch_ouvert()
        if projet_batch is None:
            return
        nouveau_task_id = self.task_combo.currentData() or ""
        if nouveau_task_id == projet_batch.task_id:
            return
        # Changer de Task invalide le mapping existant (les variables
        # dynamiques détectées dépendent du Task, cf. section 3 du patch)
        # -- réinitialisé plutôt que laissé pointer vers des noms de
        # variable qui n'existent plus forcément dans le nouveau Task.
        if projet_batch.mapping_variables:
            confirme = BoiteDialogueAutoniaX.question(
                self, "Changer de Task",
                "Changer de Task réinitialise l'association fichier ↔ variable "
                "déjà configurée (les variables détectées dépendent du Task). "
                "Continuer ?",
            )
            if not confirme:
                # Remet la sélection précédente sans redéclencher ce slot.
                self.task_combo.blockSignals(True)
                idx_precedent = self.task_combo.findData(projet_batch.task_id)
                self.task_combo.setCurrentIndex(idx_precedent if idx_precedent >= 0 else 0)
                self.task_combo.blockSignals(False)
                return
        projet_batch.task_id = nouveau_task_id
        projet_batch.mapping_variables = {}
        self.project.save()
        carte = self._projet_batch_cartes.get(projet_batch.id)
        if carte is not None:
            carte.rafraichir(projet_batch, self.project)
        self._variable_selectionnee = None
        self._rafraichir_bloc_mapping(projet_batch)

    # ------------------------------------------------------------------
    # Sélection d'instances déjà lancées (remplace l'ancien nb_instances_
    # paralleles/mode_orchestration -- cf. docstring de classe)
    # ------------------------------------------------------------------
    def _sur_liste_instances_recue_batch(self, instances: list):
        """Connecté à self._client_reseau_instances (observateur DÉDIÉ à
        cet écran, cf. __init__) -- tourne pendant TOUTE la vie de
        ProjetBatchScreen, pas seulement pendant l'édition d'un ProjetBatch
        précis, pour que la liste soit déjà à jour dès l'ouverture d'un
        écran d'édition. Ne touche la QListWidget que si un ProjetBatch est
        actuellement ouvert (_rafraichir_liste_instances_batch lit ses
        widgets, qui n'existent que sur la page éditeur -- toujours
        construits, cf. _build_bloc_config, mais inutile de les repeupler
        tant que cette page n'est pas affichée)."""
        self._instances_connues = {i["id"]: i.get("libre", False) for i in instances}
        if self._projet_batch_ouvert() is not None:
            self._rafraichir_liste_instances_batch()

    def _recalculer_grille_instances_batch(self):
        """Calcule et applique la gridSize de liste_instances_batch pour
        tenir exactement NB_COLONNES_INSTANCES_BATCH colonnes dans la
        largeur actuellement disponible (même principe que
        ProfilsInstancesScreen._recalculer_grille_profils, en plus léger
        puisque les items ici restent du texte + case à cocher standard
        Qt, sans delegate custom). MARGE_SECURITE_PX : évite qu'une
        largeur d'item tombant pile sur la largeur du viewport ne fasse
        perdre une colonne (Qt fait alors passer le dernier item à la
        ligne suivante)."""
        NB_COLONNES_INSTANCES_BATCH = 5
        MARGE_SECURITE_PX = 4
        largeur_dispo = self.liste_instances_batch.viewport().width()
        if largeur_dispo <= 0:
            return
        largeur_item = max((largeur_dispo - MARGE_SECURITE_PX) // NB_COLONNES_INSTANCES_BATCH, 1)
        hauteur_item = 26  # une ligne de texte + case à cocher, padding QSS inclus
        self.liste_instances_batch.setGridSize(QSize(largeur_item, hauteur_item))

    def eventFilter(self, watched, event):
        # PATCH (demande utilisateur explicite : "je veux aussi que les
        # profils s'affichent sur ... 5 colonne") -- recalcule la taille
        # de grille de liste_instances_batch à chaque redimensionnement
        # du panneau, même pattern que ProfilsInstancesScreen.eventFilter
        # pour liste_instances.
        if watched is self.liste_instances_batch and event.type() == QEvent.Resize:
            self._recalculer_grille_instances_batch()
        return super().eventFilter(watched, event)

    def showEvent(self, event):
        # BUGFIX (retour utilisateur : "quand je reviens sur projet
        # config avec un projet ouvert, les checkbox des instances
        # s'affichent très mal, je suis obligé de rouvrir le projet")
        # -- même cause que ProfilsInstancesScreen.showEvent (cf. son
        # commentaire) : _rafraichir_liste_instances_batch() peut être
        # appelée pendant que cet écran est en arrière-plan (la liste des
        # instances se met à jour en continu via le réseau, même hors
        # écran), moment où liste_instances_batch.viewport().width() vaut
        # 0 -- _recalculer_grille_instances_batch() se contente alors de
        # `return` immédiatement (cf. son "if largeur_dispo <= 0: return"),
        # laissant la grille figée sur une largeur d'item invalide. Aucun
        # nouveau QEvent.Resize ne survient forcément au retour sur cet
        # écran (la fenêtre elle-même ne change pas de taille), donc la
        # grille reste cassée tant qu'aucun redimensionnement réel n'a
        # lieu -- d'où le contournement observé ("obligé de rouvrir le
        # projet", qui reconstruit l'écran et déclenche un Resize initial
        # correct). On force donc un recalcul dès que cet écran redevient
        # réellement visible, différé de 0ms via singleShot pour laisser
        # Qt terminer la mise en page en cours avant de mesurer la
        # largeur disponible -- idempotent et sans effet de bord si la
        # grille était déjà correcte.
        super().showEvent(event)
        QTimer.singleShot(0, self._recalculer_grille_instances_batch)

    def _rafraichir_liste_instances_batch(self):
        """(Re)peuple liste_instances_batch depuis self._instances_connues,
        en préservant l'état coché de chaque instance déjà présente
        (self._instances_cochees -- sinon un simple rafraîchissement
        périodique de la liste déferait silencieusement les choix de
        l'utilisateur à chaque nouvel arrivant/départ d'instance)."""
        self.liste_instances_batch.blockSignals(True)
        self.liste_instances_batch.clear()
        for instance_id in sorted(self._instances_connues.keys()):
            libre = self._instances_connues[instance_id]
            texte_item = instance_id if libre else f"{instance_id}  (occupée)"
            item = QListWidgetItem(texte_item)
            item.setFlags(item.flags() | Qt.ItemIsUserCheckable)
            item.setData(Qt.UserRole, instance_id)
            item.setCheckState(Qt.Checked if instance_id in self._instances_cochees else Qt.Unchecked)
            # Cellule de grille étroite (5 colonnes, cf.
            # _recalculer_grille_instances_batch) -- alignement à gauche
            # (plus lisible qu'un centrage pour du texte+case à cocher) et
            # tooltip reprenant le texte complet, au cas où Qt le tronque
            # en ellipsis si l'id d'instance est long.
            item.setTextAlignment(Qt.AlignLeft | Qt.AlignVCenter)
            item.setToolTip(texte_item)
            if not libre:
                # Reste cochable (l'occupation peut cesser d'ici le clic
                # sur Démarrer -- MoteurExecutionBatch revérifie de toute
                # façon à ce moment-là, cf. _verifier_instances_bloquant),
                # mais visuellement distinguée pour ne pas surprendre
                # l'utilisateur si le démarrage est ensuite bloqué.
                item.setForeground(QColor(Mocha.subtext0))
            self.liste_instances_batch.addItem(item)
        self.liste_instances_batch.blockSignals(False)
        vide = not self._instances_connues
        self.label_aucune_instance.setVisible(vide)
        self.liste_instances_batch.setVisible(not vide)

    def _on_instance_batch_item_changed(self, item: "QListWidgetItem"):
        instance_id = item.data(Qt.UserRole)
        if item.checkState() == Qt.Checked:
            self._instances_cochees.add(instance_id)
        else:
            self._instances_cochees.discard(instance_id)
        projet_batch = self._projet_batch_ouvert()
        if projet_batch is None:
            return
        # Ordre stable (celui d'apparition dans la liste, déjà triée par
        # instance_id, cf. _rafraichir_liste_instances_batch) -- purement
        # cosmétique pour la persistance, MoteurExecutionBatch dédoublonne
        # de toute façon et ne dépend d'aucun ordre précis (mode pool).
        projet_batch.instances_selectionnees = [
            self.liste_instances_batch.item(i).data(Qt.UserRole)
            for i in range(self.liste_instances_batch.count())
            if self.liste_instances_batch.item(i).checkState() == Qt.Checked
        ]
        self.project.save()

    def _choisir_dossier_racine(self):
        """Bouton "Choisir..." du dossier racine -- PATCH (retour
        utilisateur : "je veux que la liste des data de projets fictifs
        soit proposée quand on essaie de sélectionner le dossier de
        données, lors de la configuration d'un projet") : plutôt que
        d'ouvrir directement le sélecteur de dossier natif, affiche
        d'abord un menu listant les projets de données fictives déjà
        générés (cf. lister_projets_donnees_fictives) -- un raccourci
        d'un clic vers ce qu'on vient probablement de créer avec l'outil
        "Données fictives" -- avec "Parcourir..." toujours en dernière
        option pour choisir un dossier arbitraire ailleurs sur le disque
        (comportement inchangé pour ce cas)."""
        projet_batch = self._projet_batch_ouvert()
        if projet_batch is None:
            return

        projets_fictifs = lister_projets_donnees_fictives()
        menu = QMenu(self)

        if projets_fictifs:
            titre_section = menu.addAction("Données fictives générées")
            titre_section.setEnabled(False)
            for dossier in projets_fictifs:
                nb_sous_projets = compter_sous_dossiers_numerotes(dossier)
                libelle = dossier.name
                libelle += f"  ({nb_sous_projets} sous-projet{'s' if nb_sous_projets != 1 else ''})" if nb_sous_projets else "  (vide)"
                action = menu.addAction(qta.icon("mdi6.creation", color=Mocha.mauve), libelle)
                action.setData(str(dossier))
            menu.addSeparator()

        action_parcourir = menu.addAction(qta.icon("mdi6.folder-open-outline", color=Mocha.subtext0), "Parcourir...")

        chosen = menu.exec(
            self.bouton_choisir_racine.mapToGlobal(self.bouton_choisir_racine.rect().bottomLeft())
        )
        if chosen is None:
            return

        if chosen is action_parcourir:
            dossier = BoiteDialogueAutoniaX.ouvrir_dossier(
                self, "Choisir le dossier racine des sous-projets", projet_batch.chemin_racine or "",
            )
            if not dossier:
                return
        else:
            dossier = chosen.data()
            if not dossier:
                return

        self._appliquer_racine(projet_batch, dossier)

    def _appliquer_racine(self, projet_batch, dossier: str):
        """Applique `dossier` comme chemin_racine de `projet_batch` --
        factorisé entre _choisir_dossier_racine (menu + Parcourir) et
        _on_racine_edited_manuellement (saisie directe dans le champ),
        pour ne pas dupliquer sauvegarde + rafraîchissements à deux
        endroits."""
        self.racine_edit.setText(dossier)
        projet_batch.chemin_racine = dossier
        self.project.save()
        self._rafraichir_bloc_mapping(projet_batch)
        self._reload_sous_projets()

    def _on_racine_edited_manuellement(self):
        projet_batch = self._projet_batch_ouvert()
        if projet_batch is None:
            return
        nouveau_chemin = self.racine_edit.text().strip()
        if nouveau_chemin == projet_batch.chemin_racine:
            return
        self._appliquer_racine(projet_batch, nouveau_chemin)

    # ------------------------------------------------------------------
    # Bloc mapping (section 3 et 7 du patch)
    # ------------------------------------------------------------------
    def _rafraichir_bloc_mapping(self, projet_batch: "ProjetBatch"):
        """Repeuple les deux QListWidget (variables détectées, fichiers du
        sous-projet 1/data/ pris comme référence) et le résumé du mapping
        déjà établi."""
        self.liste_variables.clear()
        task = self.project.find_task(projet_batch.task_id)
        toutes_variables = extraire_variables_dynamiques_task(task)
        # PATCH -- les variables détectées comme "valeur" (int/float/bool
        # littéral, cf. detecter_type_variable_dynamique) sortent
        # entièrement du périmètre de liste_variables/liste_fichiers :
        # elles ne sont JAMAIS proposées au mapping fichier, seulement
        # dans layout_valeurs (colonne dédiée) plus bas.
        variables = [
            nom for nom in toutes_variables
            if detecter_type_variable_dynamique(task, nom) != "valeur"
        ]
        variables_valeur = [
            nom for nom in toutes_variables
            if detecter_type_variable_dynamique(task, nom) == "valeur"
        ]
        for nom_variable in variables:
            fichier_associe = projet_batch.mapping_variables.get(nom_variable)
            texte = f"{nom_variable}  →  {fichier_associe}" if fichier_associe else nom_variable
            item = QListWidgetItem(texte)
            item.setData(Qt.UserRole, nom_variable)
            if fichier_associe:
                item.setIcon(qta.icon("mdi6.link-variant", color=Mocha.green))
            else:
                item.setIcon(qta.icon("mdi6.link-variant-off", color=Mocha.subtext0))
            self.liste_variables.addItem(item)

        # Colonne dédiée aux variables "valeur" -- reconstruit entièrement
        # la liste de LigneVariableValeur à chaque rafraîchissement (même
        # pattern de vidage que variantes_layout ailleurs dans ce fichier),
        # jamais de blockSignals nécessaire ici : editingFinished ne se
        # déclenche que sur une vraie frappe utilisateur dans un QLineEdit,
        # pas simplement en construisant le widget avec setText().
        while self.layout_valeurs.count():
            item = self.layout_valeurs.takeAt(0)
            w = item.widget()
            if w is not None:
                w.deleteLater()

        for nom_variable in variables_valeur:
            valeur_defaut = valeur_par_defaut_variable_dynamique(task, nom_variable)
            if nom_variable in projet_batch.variables_personnalisees:
                valeur_actuelle = projet_batch.variables_personnalisees[nom_variable]
            else:
                valeur_actuelle = valeur_defaut
            ligne = LigneVariableValeur(nom_variable, valeur_actuelle, valeur_defaut, self.scroll_valeurs)
            ligne.valeur_modifiee.connect(self._sur_valeur_variable_modifiee)
            self.layout_valeurs.addWidget(ligne)
        self.layout_valeurs.addStretch(1)
        self.label_aucune_valeur.setVisible(not variables_valeur)
        self.scroll_valeurs.setVisible(bool(variables_valeur))

        self.liste_fichiers.clear()
        dossier_reference = Path(projet_batch.chemin_racine) / "1" / "data" if projet_batch.chemin_racine else None
        if dossier_reference is not None and dossier_reference.is_dir():
            # PATCH (retour utilisateur -- "les elements que lon peu lier
            # a un path nes pas seulement des fichier mais aussi un
            # dossier") : un dossier de data/ (ex: un lot d'images) est
            # maintenant listé au même titre qu'un fichier -- icône
            # distincte (dossier vs fichier) pour que ce soit visuellement
            # clair au moment du clic, mais le mapping stocké reste juste
            # un nom (cf. _sur_clic_fichier_mapping), la distinction
            # fichier/dossier n'a pas besoin d'être mémorisée : elle est
            # re-détectée sur le disque à chaque validation de conformité
            # (cf. valider_conformite_projet_batch, exists() pour les deux).
            for chemin_element in sorted(dossier_reference.iterdir()):
                item = QListWidgetItem(chemin_element.name)
                item.setData(Qt.UserRole, chemin_element.name)
                if chemin_element.is_dir():
                    item.setIcon(qta.icon("mdi6.folder-outline", color=Mocha.subtext0))
                else:
                    item.setIcon(qta.icon("mdi6.file-outline", color=Mocha.subtext0))
                self.liste_fichiers.addItem(item)

        # nb_mappees : ne compte que les entrées de mapping_variables qui
        # correspondent bien à une variable "path" ACTUELLE -- filtre les
        # résidus possibles (ex: variable mappée avant ce patch, puis son
        # code a changé pour devenir un littéral simple, donc reclassée
        # "valeur" entre-temps ; mapping_variables.get(nom) ne serait
        # alors jamais nettoyé automatiquement sinon, cf. absence de
        # purge explicite ailleurs dans ce fichier).
        nb_mappees = sum(1 for nom in variables if nom in projet_batch.mapping_variables)
        nb_total = len(variables)
        nb_valeurs_perso = sum(1 for nom in variables_valeur if nom in projet_batch.variables_a_personnaliser)
        nb_valeurs_total = len(variables_valeur)
        if not task:
            self.label_mapping_resume.setText("Sélectionnez un Task pour détecter ses variables dynamiques.")
        elif nb_total == 0 and nb_valeurs_total == 0:
            self.label_mapping_resume.setText(
                "Aucune variable dynamique détectée dans la cellule « Variable dynamique » de ce Task."
            )
        else:
            texte = f"{nb_mappees} / {nb_total} variable(s) associée(s) à un fichier."
            if nb_valeurs_total:
                texte += f" {nb_valeurs_perso} / {nb_valeurs_total} valeur(s) personnalisée(s)."
            self.label_mapping_resume.setText(texte)

    def _sur_selection_variable(self, item: QListWidgetItem):
        self._variable_selectionnee = item.data(Qt.UserRole)

    def _sur_clic_fichier_mapping(self, item: QListWidgetItem):
        projet_batch = self._projet_batch_ouvert()
        if projet_batch is None:
            return
        if not getattr(self, "_variable_selectionnee", None):
            BoiteDialogueAutoniaX.information(
                self, "Sélectionnez d'abord une variable",
                "Cliquez d'abord sur une variable dans la liste de gauche, "
                "puis sur le fichier à lui associer.",
            )
            return
        nom_fichier = item.data(Qt.UserRole)
        projet_batch.mapping_variables[self._variable_selectionnee] = nom_fichier
        self.project.save()
        self._rafraichir_bloc_mapping(projet_batch)

    def _sur_valeur_variable_modifiee(self, nom_variable: str, texte_saisi: str):
        """Connecté à LigneVariableValeur.valeur_modifiee (editingFinished
        du QLineEdit, ou clic sur la flèche de réinitialisation) -- même
        conversion ast.literal_eval qu'avant ce patch (cf. ancien
        _ouvrir_dialogue_valeur), mais plus de dialogue bloquant : une
        valeur invalide remet simplement le champ à la dernière valeur
        connue (personnalisée si elle existait, sinon celle du script) et
        prévient dans la barre de statut plutôt que d'interrompre la
        saisie avec un QMessageBox -- cohérent avec l'esprit "édition
        directe" de ce patch (retour utilisateur : "directement avoir
        leur entrybox... que l'on peut maintenant éditer")."""
        projet_batch = self._projet_batch_ouvert()
        if projet_batch is None:
            return
        task = self.project.find_task(projet_batch.task_id)
        texte_saisi = texte_saisi.strip()
        valeur_defaut = valeur_par_defaut_variable_dynamique(task, nom_variable)
        try:
            valeur_convertie = ast.literal_eval(texte_saisi) if texte_saisi else valeur_defaut
        except (ValueError, SyntaxError):
            self._notify_status(
                f"« {texte_saisi} » n'est pas une valeur Python valide pour {nom_variable} "
                f"(ex: 3, 0.2, True) -- valeur précédente conservée."
            )
            self._rafraichir_bloc_mapping(projet_batch)
            return
        projet_batch.variables_personnalisees[nom_variable] = valeur_convertie
        # Toute variable "valeur" affichée ici a désormais TOUJOURS une
        # entrybox éditable (plus de coché/décoché) -- elle reste donc
        # systématiquement dans variables_a_personnaliser dès qu'on la
        # voit, pour que _construire_variables_pour_sous_projet (qui ne
        # lit que les noms listés ici, cf. sa docstring) injecte bien la
        # valeur actuellement affichée, qu'elle égale ou non la valeur par
        # défaut du script.
        if nom_variable not in projet_batch.variables_a_personnaliser:
            projet_batch.variables_a_personnaliser.append(nom_variable)
        self.project.save()
        self._rafraichir_bloc_mapping(projet_batch)

    # ------------------------------------------------------------------
    # Bloc suivi : sous-projets + démarrage/arrêt (section 4 et 8 du patch)
    # ------------------------------------------------------------------
    def _reload_sous_projets(self):
        """Reconstruit entièrement la grille depuis le disque. Présélection
        automatique (décision explicite utilisateur : "toujours recalculée
        à l'ouverture, pas de mémoire") -- non_traite et echec cochés,
        succes décoché -- TOUJOURS recalculée ici, jamais lue depuis un
        état précédent : self._sous_projets_coches est entièrement
        reconstruit à partir de cette règle, sans tenir compte d'un choix
        manuel antérieur (même après un simple rafraîchissement manuel via
        self.bouton_rafraichir_sous_projets, cf. sa docstring)."""
        projet_batch = self._projet_batch_ouvert()
        if projet_batch is None:
            return
        self.flow_grid_sous_projets.clear()
        self._sous_projet_cartes = {}
        self._sous_projets_coches = set()
        dossiers = projet_batch.lister_sous_projets()
        for dossier in dossiers:
            sous_projet = SousProjet.depuis_dossier(dossier)
            sous_projet.selectionne = sous_projet.statut != "succes"
            if sous_projet.selectionne:
                self._sous_projets_coches.add(sous_projet.numero)
            carte = SousProjetCarte(sous_projet)
            carte.selection_changee.connect(self._on_sous_projet_selection_changee)
            self._sous_projet_cartes[sous_projet.numero] = carte
            self.flow_grid_sous_projets.add_item(carte)
        vide = len(dossiers) == 0
        self.label_aucun_sous_projet.setVisible(vide)
        self.sous_projets_scroll.setVisible(not vide)
        # PATCH E.5 -- l'activation des boutons "Traiter les échecs"/
        # "Retraiter" dépend des statuts RÉELS lus depuis le disque
        # (déjà fait ci-dessus, une itération suffit), pas d'un état
        # séparé à maintenir.
        self._rafraichir_boutons_retraitement()

    def _on_sous_projet_selection_changee(self, numero: int, coche: bool):
        # Reflète la case cochée/décochée d'une SousProjetCarte précise
        # (clic utilisateur direct) dans le set d'ensemble -- c'est CE set,
        # pas l'état visuel des cartes, qui sert de source de vérité pour
        # _demarrer_batch (cf. _sous_projets_selectionnes()).
        if coche:
            self._sous_projets_coches.add(numero)
        else:
            self._sous_projets_coches.discard(numero)

    def _appliquer_selection_sous_projets(self, predicat: callable):
        """predicat(statut: str) -> bool. Utilisé par les 3 boutons
        raccourcis (tout cocher/tout décocher/cocher les non-succès) --
        agit sur TOUTES les SousProjetCarte actuellement affichées. Le
        statut est relu depuis carte.statut_actuel (pas depuis le disque
        -- suffisant, une carte affichée reflète déjà le dernier
        _reload_sous_projets ou la dernière mise à jour reçue pendant un
        batch, cf. SousProjetCarte.rafraichir)."""
        for numero, carte in self._sous_projet_cartes.items():
            coche = predicat(carte.statut_actuel)
            carte.set_coche(coche)
            if coche:
                self._sous_projets_coches.add(numero)
            else:
                self._sous_projets_coches.discard(numero)

    # ------------------------------------------------------------------
    # PATCH E.5 (cf. cahier des charges patchs.md, section E.5 --
    # "Depuis un batch terminé, actions possibles : Traiter les échecs /
    # Retraiter"). Les deux boutons appliquent une sélection PAR
    # PRÉDICAT (même mécanisme exact que les 3 boutons raccourcis
    # existants, cf. _appliquer_selection_sous_projets), puis ouvrent le
    # MÊME DialogueEnvoiSautoniax que l'envoi normal (cf. _on_clic_
    # envoyer_sautoniax) -- seule la CIBLE change : demande_envoi_projet_
    # sautoniax_filtre au lieu de demande_envoi_projet_sautoniax, avec en
    # plus la liste des numéros cochés au moment de la validation du
    # dialogue (PAS recalculée après -- si l'utilisateur décoche/coche
    # manuellement une carte pendant que le dialogue est ouvert, ce
    # n'est pas possible, le dialogue est modal, donc aucune ambiguïté
    # possible ici).
    # ------------------------------------------------------------------

    def _rafraichir_boutons_retraitement(self):
        """Active "Traiter les échecs"/"Retraiter" seulement si CE batch
        a déjà connu au moins un passage (au moins un sous-projet dont le
        statut n'est plus "non_traite") -- sinon les deux actions
        n'auraient rigoureusement rien à faire de différent d'un premier
        "Envoyer vers un sAutoniax"/"Démarrer le batch" normal, et
        laisseraient croire à une action distincte qui ne l'est pas
        encore. "Traiter les échecs" est PLUS restrictif : désactivé
        aussi tant qu'aucun sous-projet n'est en "echec" précisément
        (rien à traiter, même si d'autres sont déjà en "succes")."""
        statuts = [carte.statut_actuel for carte in self._sous_projet_cartes.values()]
        deja_traite_une_fois = any(s != "non_traite" for s in statuts)
        au_moins_un_echec = any(s == "echec" for s in statuts)
        self.bouton_retraiter_tout.setEnabled(deja_traite_une_fois)
        self.bouton_traiter_echecs.setEnabled(deja_traite_une_fois and au_moins_un_echec)

    def _demander_envoi_sautoniax_filtre(self, numeros_sous_projets: list):
        """Factorise la partie commune de _on_clic_traiter_echecs/_on_clic_
        retraiter_tout -- validations + ouverture du dialogue + émission
        du signal, cf. docstring du bloc ci-dessus. `numeros_sous_projets`
        est déjà résolu par l'appelant (la sélection ayant déjà été
        appliquée via _appliquer_selection_sous_projets juste avant)."""
        projet_batch = self._projet_batch_ouvert()
        if projet_batch is None:
            return
        if not projet_batch.task_id:
            BoiteDialogueAutoniaX.warning(self, "Task manquant", "Sélectionnez un Task avant d'envoyer ce projet.")
            return
        if not projet_batch.chemin_racine or not Path(projet_batch.chemin_racine).is_dir():
            BoiteDialogueAutoniaX.warning(self, "Dossier racine invalide", "Choisissez un dossier racine valide avant d'envoyer ce projet.")
            return
        if not numeros_sous_projets:
            BoiteDialogueAutoniaX.information(
                self, "Rien à traiter",
                "Aucun sous-projet ne correspond à cette action pour le moment.",
            )
            return
        if not self._executants_disponibles:
            BoiteDialogueAutoniaX.warning(self, "Aucun sAutoniax connecté", "Aucun sAutoniax n'est actuellement connecté au serveurT.")
            return

        dialogue = DialogueEnvoiSautoniax(self._executants_disponibles, self._profils_cloud_disponibles, self)
        if dialogue.exec() != QDialog.Accepted:
            return
        id_executant = dialogue.id_executant_choisi()
        profils_coches = dialogue.profils_coches()
        if not id_executant:
            BoiteDialogueAutoniaX.warning(self, "Aucune cible", "Choisissez un sAutoniax cible.")
            return
        if not profils_coches:
            BoiteDialogueAutoniaX.warning(self, "Aucun profil", "Cochez au moins un profil cloud à utiliser.")
            return

        self.demande_envoi_projet_sautoniax_filtre.emit(
            id_executant, projet_batch.id, projet_batch.chemin_racine, projet_batch.nom,
            profils_coches, sorted(numeros_sous_projets),
        )

    def _on_clic_traiter_echecs(self):
        """"Traiter les échecs" (cf. cahier des charges, E.5) : relance
        UNIQUEMENT les sous-projets actuellement en "echec" -- même
        prédicat que si on cliquait manuellement une sélection ciblée,
        cf. _appliquer_selection_sous_projets."""
        self._appliquer_selection_sous_projets(lambda statut: statut == "echec")
        self._demander_envoi_sautoniax_filtre(sorted(self._sous_projets_coches))

    def _on_clic_retraiter_tout(self):
        """"Retraiter" (tout) (cf. cahier des charges, E.5) : relance
        L'INTÉGRALITÉ du batch, "comme un nouveau batch frais" -- tous
        les sous-projets, y compris ceux déjà en "succes" (contrairement
        à "Traiter les échecs" et au bouton raccourci "Cocher les
        non-succès")."""
        self._appliquer_selection_sous_projets(lambda statut: True)
        self._demander_envoi_sautoniax_filtre(sorted(self._sous_projets_coches))

    # ------------------------------------------------------------------
    # PATCH E.7 (cf. cahier des charges patchs.md, section E.7 --
    # "Attribuer les profils"). Construit AttributionProfilsScreen à la
    # demande (jamais réutilisée entre deux clics -- cf. docstring de
    # AttributionProfilsScreen) avec le contexte du ProjetBatch OUVERT,
    # et demande à MainWindow (via demande_ouvrir_attribution_profils,
    # même route que demande_ouvrir_rendu_reseau) de l'ouvrir dans la
    # zone d'application, cf. B.5.
    # ------------------------------------------------------------------
    def _on_clic_attribuer_profils(self):
        projet_batch = self._projet_batch_ouvert()
        if projet_batch is None:
            return
        numeros = [int(d.name) for d in projet_batch.lister_sous_projets()]
        if not numeros:
            BoiteDialogueAutoniaX.information(
                self, "Aucun sous-projet",
                "Ce ProjetBatch n'a aucun sous-projet numéroté sous son dossier racine.",
            )
            return
        if not self._infos_profils_cloud:
            BoiteDialogueAutoniaX.warning(
                self, "Aucun profil cloud",
                "Aucun profil n'est actuellement connu dans Profils Cloud -- "
                "envoyez au moins un profil vers le cloud avant d'attribuer.",
            )
            return

        ecran = AttributionProfilsScreen(
            projet_batch.nom, numeros, projet_batch.mapping_profils_sous_projets,
            self._infos_profils_cloud, self,
        )
        id_projet_batch = projet_batch.id
        ecran.mapping_enregistre.connect(
            lambda mapping, _id=id_projet_batch: self._sur_mapping_profils_enregistre(_id, mapping)
        )
        # Fermeture : accès DIRECT à ApplicationsScreen (même patron que
        # TaskConfigScreen._applications_screen_ou_none/_sur_fermeture_
        # rendu_reseau) -- pas besoin de repasser par MainWindow pour
        # ça, contrairement à l'OUVERTURE (demande_ouvrir_attribution_
        # profils) : cet écran-ci n'est JAMAIS réutilisé d'un clic à
        # l'autre (contrairement à FenetreRenduTaskReseau), donc aucune
        # référence à garder vivante après fermeture -- deleteLater()
        # direct suffit, pas de self._ecran_attribution = None à gérer.
        def _sur_fermeture_attribution(_e=ecran):
            applications_screen = getattr(self.window(), "screens", {}).get("applications")
            if applications_screen is not None:
                applications_screen.retirer_rendu_task_reseau(_e)
            _e.deleteLater()

        ecran.fermeture_demandee.connect(_sur_fermeture_attribution)
        self.demande_ouvrir_attribution_profils.emit(ecran, f"Profils -- {projet_batch.nom}")

    def _sur_mapping_profils_enregistre(self, id_projet_batch: str, mapping: dict):
        """Écrit RÉELLEMENT le mapping dans le ProjetBatch concerné (cf.
        docstring de AttributionProfilsScreen : cet écran ne connaît ni
        Project ni la persistance -- c'est ici, et seulement ici, que
        mapping_profils_sous_projets est mis à jour et sauvegardé) --
        même mécanisme de sauvegarde que le reste de cet écran pour tout
        changement de ProjetBatch, cf. _sur_clic_fichier_mapping juste
        au-dessus (self.project.save() appelé directement, pas de signal
        dédié -- cet écran possède déjà self.project)."""
        projet_batch = next(
            (p for p in self.project.projets_batch if p.id == id_projet_batch), None,
        )
        if projet_batch is None:
            return  # ProjetBatch supprimé entre l'ouverture de la mini-app et l'enregistrement -- ignoré silencieusement
        projet_batch.mapping_profils_sous_projets = dict(mapping)
        self.project.save()
        if self._projet_batch_ouvert() is projet_batch:
            self.label_statut_batch.setText(
                f"{len(mapping)} profil(s) individuellement attribué(s) pour ce batch."
            )

    def _sous_projets_selectionnes(self) -> list:
        """Reconstruit la liste des SousProjet (relue depuis le disque,
        toujours à jour) correspondant aux numéros actuellement cochés
        (self._sous_projets_coches) -- c'est cette liste, et SEULEMENT
        elle, que _demarrer_batch passe à MoteurExecutionBatch.lancer()."""
        projet_batch = self._projet_batch_ouvert()
        if projet_batch is None:
            return []
        resultat = []
        for numero in sorted(self._sous_projets_coches):
            carte = self._sous_projet_cartes.get(numero)
            if carte is None:
                continue
            dossier = Path(projet_batch.chemin_racine) / str(numero)
            resultat.append(SousProjet.depuis_dossier(dossier))
        return resultat

    def _marquer_statut_sous_projets_coches(self, statut: str):
        """Force `statut` ("succes" ou "echec") pour chaque sous-projet
        actuellement COCHÉ (self._sous_projets_coches), écrit sur disque
        via SousProjet.ecrire_statut (même mécanisme que MoteurExecutionBatch
        après un vrai traitement) puis reflété immédiatement sur la
        SousProjetCarte correspondante -- sans repasser par un vrai
        traitement/instance. Ne touche PAS à l'état coché/décoché des
        cartes : un sous-projet reste sélectionné ou non tel quel après
        le marquage, seul son statut (et donc son icône/badge) change.

        Bloqué pendant qu'un batch tourne (cf. _rafraichir_bouton_
        demarrer_arreter, ces boutons y sont désactivés) -- écrire un
        statut manuellement pendant que MoteurExecutionBatch traite
        activement les mêmes dossiers créerait une confusion (quel
        statut gagne : celui du marquage manuel ou celui du batch en
        cours ?)."""
        if statut not in ("succes", "echec"):
            return
        projet_batch = self._projet_batch_ouvert()
        if projet_batch is None:
            return
        if not self._sous_projets_coches:
            BoiteDialogueAutoniaX.information(
                self, "Aucun sous-projet coché",
                "Cochez au moins un sous-projet avant de forcer son statut.",
            )
            return
        for numero in sorted(self._sous_projets_coches):
            carte = self._sous_projet_cartes.get(numero)
            if carte is None:
                continue
            dossier = Path(projet_batch.chemin_racine) / str(numero)
            sous_projet = SousProjet.depuis_dossier(dossier)
            # message_erreur remis à None : un marquage manuel "succes" ou
            # "echec" repart d'un message propre, jamais un message d'un
            # échec précédent qui traînerait après un marquage "succes".
            sous_projet.ecrire_statut(statut, message_erreur=None)
            carte.rafraichir(sous_projet.statut, sous_projet.message_erreur)

    def _rafraichir_bouton_demarrer_arreter(self):
        en_cours = self._moteur_batch is not None
        if en_cours:
            self.bouton_demarrer_arreter.setIcon(qta.icon("mdi6.stop", color=Mocha.crust))
            self.bouton_demarrer_arreter.setText("Arrêter le batch")
        else:
            self.bouton_demarrer_arreter.setIcon(qta.icon("mdi6.play", color=Mocha.crust))
            self.bouton_demarrer_arreter.setText("Démarrer le batch")
        # Édition désactivée pendant l'exécution -- changer le Task, la
        # sélection d'instances, la sélection de sous-projets, le mapping
        # ou la racine sous un batch en cours n'aurait aucun effet cohérent
        # (MoteurExecutionBatch a déjà capturé sa propre référence à
        # self.projet_batch ET à la liste de sous-projets à la construction/
        # à l'appel de lancer(), cf. son __init__/lancer()) et créerait une
        # confusion pour l'utilisateur.
        for widget in (
            self.task_combo, self.liste_instances_batch,
            self.racine_edit, self.bouton_choisir_racine,
            self.liste_variables, self.liste_fichiers,
            self.bouton_supprimer_projet,
            self.bouton_tout_cocher, self.bouton_tout_decocher, self.bouton_cocher_non_succes,
            self.bouton_marquer_succes, self.bouton_marquer_echec,
            # PATCH E.5 -- mêmes raisons que les boutons de sélection
            # ci-dessus : lancer un envoi filtré (ou même juste ouvrir le
            # dialogue) pendant qu'un MoteurExecutionBatch local tourne
            # déjà sur ce même chemin_racine créerait une confusion
            # équivalente (deux traitements concurrents sur les mêmes
            # sous-dossiers disque).
            self.bouton_traiter_echecs, self.bouton_retraiter_tout,
            # Cf. _demarrer_batch -- désélectionné avant le démarrage pour
            # casser la boucle de re-liaison automatique (instance
            # reprise par cet aperçu à chaque instances_list, cf.
            # InstanceApercuScreen._on_instance_changed) ; désactivé ICI
            # en plus pour empêcher l'utilisateur de la resélectionner
            # PENDANT que le batch tourne, ce qui recréerait exactement le
            # même blocage pour la prochaine instance que le pool
            # réutiliserait (cf. docstring de MoteurExecutionBatch : les
            # instances sont reprises entre sous-projets, jamais fermées).
            self.instance_apercu_batch.instance_combo,
        ):
            widget.setEnabled(not en_cours)

    # ------------------------------------------------------------------
    # PATCH (Patch 4.4.a -- "Envoyer vers un sAutoniax").
    # ------------------------------------------------------------------

    def definir_executants_disponibles(self, executants: dict):
        """Alimenté par MainWindow depuis ClientServeurT.executants_
        detail_change (même source que l'onglet Instances, cf. §4.2 :
        "Choix du sAutoniax cible, parmi la liste des connectés") --
        id_executant -> nom affiché."""
        self._executants_disponibles = dict(executants)

    def definir_profils_cloud_disponibles(self, noms_profils: list):
        """Alimenté par MainWindow depuis ReseauScreen.profils_cloud_
        screen.noms_profils_cloud() (§4.3), à chaque rafraîchissement de
        cette liste -- pas les profils LOCAUX (cf. spec §4.4.a, point 2 :
        "pas les profils locaux")."""
        self._profils_cloud_disponibles = list(noms_profils)

    def definir_infos_profils_cloud(self, infos: dict):
        """PATCH E.7 -- symétrique de definir_profils_cloud_disponibles
        ci-dessus, mais porte les métadonnées (proxy/pays/date d'envoi)
        plutôt que les seuls noms (cf. ProfilsCloudScreen.infos_profils_
        cloud). Consommé par _on_clic_attribuer_profils pour construire
        AttributionProfilsScreen à la demande -- jamais lu ailleurs."""
        self._infos_profils_cloud = dict(infos)

    def _on_clic_envoyer_sautoniax(self):
        projet_batch = self._projet_batch_ouvert()
        if projet_batch is None:
            return
        if not projet_batch.task_id:
            BoiteDialogueAutoniaX.warning(self, "Task manquant", "Sélectionnez un Task avant d'envoyer ce projet.")
            return
        if not projet_batch.chemin_racine or not Path(projet_batch.chemin_racine).is_dir():
            BoiteDialogueAutoniaX.warning(self, "Dossier racine invalide", "Choisissez un dossier racine valide avant d'envoyer ce projet.")
            return
        if not self._executants_disponibles:
            BoiteDialogueAutoniaX.warning(self, "Aucun sAutoniax connecté", "Aucun sAutoniax n'est actuellement connecté au serveurT.")
            return

        dialogue = DialogueEnvoiSautoniax(self._executants_disponibles, self._profils_cloud_disponibles, self)
        if dialogue.exec() != QDialog.Accepted:
            return
        id_executant = dialogue.id_executant_choisi()
        profils_coches = dialogue.profils_coches()
        if not id_executant:
            BoiteDialogueAutoniaX.warning(self, "Aucune cible", "Choisissez un sAutoniax cible.")
            return
        if not profils_coches:
            BoiteDialogueAutoniaX.warning(self, "Aucun profil", "Cochez au moins un profil cloud à utiliser.")
            return

        self.demande_envoi_projet_sautoniax.emit(
            id_executant, projet_batch.id, projet_batch.chemin_racine, projet_batch.nom, profils_coches,
        )

    def _on_clic_demarrer_ou_arreter(self):
        if self._moteur_batch is not None:
            self._arreter_batch()
        else:
            self._demarrer_batch()

    def _demarrer_batch(self):
        projet_batch = self._projet_batch_ouvert()
        if projet_batch is None:
            return
        if not projet_batch.task_id:
            BoiteDialogueAutoniaX.warning(self, "Task manquant", "Sélectionnez un Task avant de démarrer.")
            return
        if not projet_batch.chemin_racine or not Path(projet_batch.chemin_racine).is_dir():
            BoiteDialogueAutoniaX.warning(self, "Dossier racine invalide", "Choisissez un dossier racine valide avant de démarrer.")
            return

        # Validation de conformité déclenchée ICI, avant même de construire
        # le moteur (en plus de la vérification que MoteurExecutionBatch.
        # lancer() refait de toute façon en interne, cf. brique 5) -- pour
        # afficher une erreur claire et groupée à l'utilisateur AVANT de
        # tenter quoi que ce soit, plutôt que de laisser l'exception
        # remonter depuis lancer() sans contexte UI (section 7 du patch :
        # "Validation de conformité déclenchée à l'ouverture du panneau de
        # mapping ET juste avant le démarrage effectif du batch").
        problemes = valider_conformite_projet_batch(projet_batch)
        if problemes:
            detail = "\n".join(f"• Dossier {p['numero']} : {p['raison']}" for p in problemes)
            BoiteDialogueAutoniaX.critical(
                self, "Sous-projets non conformes",
                f"Le démarrage est bloqué -- {len(problemes)} sous-projet(s) "
                f"non conforme(s) :\n\n{detail}",
            )
            return

        # Capture la sélection AVANT tout rafraîchissement -- décision
        # explicite utilisateur : la sélection cochée à l'instant du clic
        # sur "Démarrer" doit être respectée telle quelle (choix manuel
        # inclus), jamais écrasée par la présélection automatique que
        # _reload_sous_projets() réappliquerait sinon (cf. sa docstring :
        # "toujours recalculée à l'ouverture, pas de mémoire" -- ça
        # s'applique à l'OUVERTURE de l'écran, pas au clic sur Démarrer).
        sous_projets_a_traiter = self._sous_projets_selectionnes()
        if not sous_projets_a_traiter:
            BoiteDialogueAutoniaX.warning(
                self, "Aucun sous-projet sélectionné",
                "Cochez au moins un sous-projet avant de démarrer.",
            )
            return

        # BUGFIX (retour utilisateur : batch bloqué en boucle sur
        # "InstancesIndisponiblesError ... déjà occupée par un autre
        # pilote", même après un force_unlink manuel via le bouton "Free")
        # : l'écran d'aperçu de CET onglet (self.instance_apercu_batch,
        # un InstanceApercuScreen role="pilote" EXCLUSIF, cf. sa docstring)
        # se relie automatiquement à l'instance sélectionnée dans son
        # combo à CHAQUE instances_list reçu (cf. _on_instance_changed,
        # rappelé par _sur_liste_instances_recue). Un force_unlink externe
        # libère l'instance un court instant, mais le prochain
        # instances_list reçu par CET aperçu la reprend aussitôt -- boucle
        # qui empêche l'instance de rester libre assez longtemps pour que
        # MoteurExecutionBatch.lancer() la voie disponible. Désélectionner
        # explicitement ici (envoie un unlink propre pour l'instance
        # actuellement affichée, cf. InstanceApercuScreen._on_instance_
        # changed) casse ce cycle AVANT la vérification de disponibilité
        # faite par lancer() juste en dessous -- aucune instance du batch
        # ne doit rester liée à cet aperçu pendant que le batch tourne.
        instance_a_liberer = self.instance_apercu_batch._instance_liee
        self.instance_apercu_batch.selectionner_instance(None)

        # BUGFIX (suite -- retour utilisateur : le batch échouait ENCORE
        # après ce qui précède, y compris après un "Free" manuel) : le
        # 'unlink' envoyé ci-dessus par selectionner_instance(None) part de
        # façon asynchrone (websocket) et n'est JAMAIS confirmé par le
        # serveur (cf. ClientReseauAutoniaX.force_unlink_ok_recu, dont la
        # docstring précise explicitement que 'unlink' normal n'a pas cette
        # confirmation). Rien ne garantissait donc que le serveur ait fini
        # de traiter cet unlink avant que le code continue, juste en
        # dessous, vers MoteurExecutionBatch.lancer() -- qui ouvre sa PROPRE
        # connexion websocket (client "verif-batch-...", cf. logs) pour
        # vérifier la disponibilité des instances. Deux connexions
        # distinctes vers le même serveur n'offrent aucune garantie d'ordre
        # : "verif-batch-..." pouvait recevoir l'instances_list du serveur
        # AVANT que celui-ci ait fini de traiter l'unlink, et voyait donc
        # encore l'instance comme occupée (exactement le crash observé,
        # y compris après un "Free" manuel qui souffrait du même problème
        # de fond). On attend ici, bloquant mais bref, la confirmation
        # réelle (prochain instances_list où l'instance apparaît libre)
        # avant de laisser lancer() faire sa propre vérification.
        if instance_a_liberer is not None and self.instance_apercu_batch.client_reseau is not None:
            event_libere = threading.Event()

            def _sur_liste_attente_liberation(instances: list, cible=instance_a_liberer):
                for item in instances:
                    if item.get("id") == cible and item.get("libre"):
                        event_libere.set()
                        return
                    if item.get("id") == cible:
                        return  # encore listée mais pas libre -- pas encore traité côté serveur

            self.instance_apercu_batch.client_reseau.liste_instances_recue.connect(
                _sur_liste_attente_liberation, Qt.DirectConnection
            )
            try:
                event_libere.wait(timeout=MoteurExecutionBatch.TIMEOUT_VERIF_INSTANCES_S)
            finally:
                self.instance_apercu_batch.client_reseau.liste_instances_recue.disconnect(
                    _sur_liste_attente_liberation
                )

        self._moteur_batch = MoteurExecutionBatch(project=self.project, projet_batch=projet_batch)
        self._moteur_batch.sous_projet_maj.connect(self._sur_sous_projet_maj)
        self._moteur_batch.batch_termine.connect(self._sur_batch_termine)
        # Cf. Brique F du plan de patch -- relais de progression cellule
        # par cellule vers l'onglet "Aperçu d'exécution", connectés/
        # déconnectés en même temps que les deux signaux ci-dessus (même
        # cycle de vie, cf. _deconnecter_signaux_moteur_affiche).
        self._moteur_batch.sous_projet_cellule_demarree.connect(self._sur_apercu_cellule_demarree)
        self._moteur_batch.sous_projet_cellule_terminee.connect(self._sur_apercu_cellule_terminee)
        self._moteur_batch.sous_projet_cellule_image_bug.connect(self._sur_apercu_cellule_image_bug)
        self._rafraichir_bouton_demarrer_arreter()
        self.label_statut_batch.setText("Batch en cours d'exécution...")
        try:
            self._moteur_batch.lancer(sous_projets_a_traiter, lambda: None)  # fin réelle gérée par batch_termine, cf. _sur_batch_termine
        except NonConformiteSousProjetError as e:
            # Filet de sécurité -- ne devrait normalement pas se produire
            # puisque la validation ci-dessus vient de passer, sauf
            # modification du disque entre les deux (fenêtre de temps très
            # courte, ex: fichier supprimé manuellement entre-temps).
            BoiteDialogueAutoniaX.critical(self, "Sous-projets non conformes", str(e))
            self._deconnecter_signaux_moteur_affiche()
            self._moteur_batch = None
            self._rafraichir_bouton_demarrer_arreter()
            self.label_statut_batch.setText("")

    def _arreter_batch(self):
        if self._moteur_batch is None:
            return
        self.label_statut_batch.setText("Arrêt du batch en cours...")
        self._moteur_batch.arreter()  # déclenche _sur_batch_termine via batch_termine, cf. MoteurExecutionBatch.arreter -> _terminer_normalement

    def _sur_sous_projet_maj(self, numero: int, statut: str):
        carte = self._sous_projet_cartes.get(numero)
        if carte is None:
            # Sous-projet apparu après le dernier _reload_sous_projets (cas
            # rare -- dossier ajouté sur disque pendant l'exécution) : pas
            # grave, il apparaîtra correctement au prochain rafraîchissement
            # manuel ou à la prochaine ouverture de l'écran.
            return
        message_erreur = None
        if statut == "echec":
            projet_batch = self._projet_batch_ouvert()
            if projet_batch is not None:
                # Relit statut.json pour le message d'erreur détaillé --
                # sous_projet_maj ne transporte QUE (numero, statut), pas le
                # message (cf. sa signature dans MoteurExecutionBatch),
                # volontairement minimal pour rester un signal Qt simple.
                sous_projet_dossier = Path(projet_batch.chemin_racine) / str(numero)
                message_erreur = SousProjet.depuis_dossier(sous_projet_dossier).message_erreur
        carte.rafraichir(statut, message_erreur)

        # Cf. Brique F du plan de patch, onglet "Aperçu d'exécution" --
        # statut "en_cours" == le moment précis où MoteurExecutionBatch.
        # _demarrer_sous_projet_sur_instance vient d'assigner ce
        # sous-projet à une instance (cf. son emit, juste avant de
        # construire le MoteurExecutionTaskHeadless) : c'est ICI, pas
        # dans sous_projet_cellule_demarree (qui ne porte pas le numéro
        # de sous-projet), qu'on peut relier numero <-> instance_id pour
        # alimenter _historique_par_instance. sous_projet_maj ne transporte
        # pas instance_id -- retrouvé en cherchant, dans _en_cours (dict
        # instance_id -> SousProjet du moteur), l'entrée dont le numéro
        # correspond (._en_cours vient d'être peuplé synchrone, avant cet
        # emit, cf. _demarrer_sous_projet_sur_instance).
        if statut == "en_cours" and self._moteur_batch is not None:
            instance_id = next(
                (iid for iid, sp in self._moteur_batch._en_cours.items() if sp.numero == numero),
                None,
            )
            if instance_id is not None:
                self._sur_apercu_sous_projet_demarre(numero, instance_id)

    def _sur_batch_termine(self):
        self._deconnecter_signaux_moteur_affiche()
        self._moteur_batch = None
        self._rafraichir_bouton_demarrer_arreter()
        self.label_statut_batch.setText("Batch terminé.")
        self._reload_sous_projets()

    def _deconnecter_signaux_moteur_affiche(self):
        if self._moteur_batch is None:
            return
        try:
            self._moteur_batch.sous_projet_maj.disconnect(self._sur_sous_projet_maj)
            self._moteur_batch.batch_termine.disconnect(self._sur_batch_termine)
            self._moteur_batch.sous_projet_cellule_demarree.disconnect(self._sur_apercu_cellule_demarree)
            self._moteur_batch.sous_projet_cellule_terminee.disconnect(self._sur_apercu_cellule_terminee)
            self._moteur_batch.sous_projet_cellule_image_bug.disconnect(self._sur_apercu_cellule_image_bug)
        except (RuntimeError, TypeError):
            # Déjà déconnecté (ex: batch_termine a déjà tout nettoyé juste
            # avant un retour_grille qui rappelle ceci) -- sans effet, pas
            # une vraie erreur.
            pass


