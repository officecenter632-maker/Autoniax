# ---------------------------------------------------------------------------
# Génération de trajectoire souris humaine -- moteur intégré depuis
# mouse_trajectory_app.py (demande utilisateur explicite : "je veux que tu
# integre directement notre code dans l'app ... pour move mouse sa doit
# notre mouse trajectory doit genere le chemin et maintenant, l'evenement
# mouse move l'utilise"). Segmentation des trajets réels enregistrés par
# mouse_tracker.py -> décomposition forme lisse (Savitzky-Golay) + résidu
# de tremblement -> indexation KDTree par (distance, angle) -> génération
# d'un nouveau trajet A->B par transformation géométrique du trajet réel le
# plus proche + resynthèse du tremblement par block-bootstrap. Utilisé par
# action_camoufox_click / action_camoufox_mousemove plus bas (cf.
# _charger_banque_trajectoire_souris pour le branchement avec
# get_mouse_data_path()). np/savgol_filter/KDTree déjà importés plus haut
# (bloc défensif, cf. TRAJECTOIRE_SOURIS_DISPONIBLE) -- pas de ré-import ici.
# ---------------------------------------------------------------------------

GAP_THRESHOLD_MS = 200.0
MIN_POINTS_PER_SEGMENT = 6
SPEED_PAUSE_THRESHOLD_PX_S = 60.0
MIN_SUBSEGMENT_POINTS = 6
MIN_TRAJECTORY_DISTANCE_PX = 15.0

# Un trajet est considéré "anodin" (mouvement sans but précis, cf. mode
# JUST_MOVE) s'il ne se termine ni ne débute à moins de ce seuil temporel
# d'un clic réel. Seuil dérivé empiriquement : sur les données observées,
# la distance temporelle au clic le plus proche a une médiane ~0.87s et un
# p25 ~0.47s -- 0.6s sépare raisonnablement le coeur des mouvements qui
# précèdent immédiatement un clic (ajustement fin de dernière seconde) du
# reste des mouvements, sans être si strict qu'il ne reste trop peu de
# trajets "anodins" exploitables.
ANODIN_CLICK_DISTANCE_THRESHOLD_S = 0.6


def load_segments(db_path, gap_threshold_ms=GAP_THRESHOLD_MS,
                   min_points=MIN_POINTS_PER_SEGMENT):
    """Lit la table `positions` et découpe le flux continu en segments bruts.

    Compatible avec deux schémas : celui qui stocke un `dt_ms` déjà calculé
    par ligne, et celui (produit par mouse_tracker.py) qui ne stocke que
    `timestamp_epoch` -- dans ce second cas, dt_ms est recalculé ici comme
    l'écart avec la ligne précédente de la même session, en millisecondes.
    """
    conn = sqlite3.connect(db_path)
    cur = conn.cursor()
    cur.execute("PRAGMA table_info(positions)")
    columns = {row[1] for row in cur.fetchall()}
    has_dt_ms = "dt_ms" in columns

    if has_dt_ms:
        cur.execute(
            "SELECT timestamp_epoch, x, y, dt_ms, session_id "
            "FROM positions ORDER BY session_id, id"
        )
        rows = cur.fetchall()
    else:
        cur.execute(
            "SELECT timestamp_epoch, x, y, session_id "
            "FROM positions ORDER BY session_id, id"
        )
        raw_rows = cur.fetchall()
        rows = []
        prev_t, prev_sid = None, None
        for t_epoch, x, y, sid in raw_rows:
            if sid == prev_sid and prev_t is not None:
                dt_ms = (t_epoch - prev_t) * 1000.0
            else:
                dt_ms = None  # première ligne d'une session : pas de "gap" à mesurer
            rows.append((t_epoch, x, y, dt_ms, sid))
            prev_t, prev_sid = t_epoch, sid
    conn.close()

    segments = []
    cur_t, cur_x, cur_y, cur_sid = [], [], [], None

    def flush():
        if len(cur_x) >= min_points:
            t_epoch = np.array(cur_t, dtype=np.float64)
            segments.append({
                "x": np.array(cur_x, dtype=np.float64),
                "y": np.array(cur_y, dtype=np.float64),
                "t": t_epoch - t_epoch[0],
                "t_epoch": t_epoch,
                "session_id": cur_sid,
            })

    for t_epoch, x, y, dt_ms, sid in rows:
        new_segment = (
            cur_sid is None or sid != cur_sid
            or (dt_ms is not None and dt_ms > gap_threshold_ms)
        )
        if new_segment and cur_x:
            flush()
            cur_t, cur_x, cur_y = [], [], []
        cur_t.append(t_epoch)
        cur_x.append(x)
        cur_y.append(y)
        cur_sid = sid
    flush()
    return segments


def split_on_speed_minima(segments, speed_threshold=SPEED_PAUSE_THRESHOLD_PX_S,
                           min_points=MIN_SUBSEGMENT_POINTS):
    """Resegmente sur les minima locaux de vitesse (sous-mouvements composites)."""
    result = []
    for seg in segments:
        x, y, t, t_epoch = seg["x"], seg["y"], seg["t"], seg["t_epoch"]
        n = len(x)
        if n < min_points * 2:
            result.append(seg)
            continue

        dt = np.diff(t)
        dx = np.diff(x)
        dy = np.diff(y)
        speed = np.hypot(dx, dy) / np.maximum(dt, 1e-6)

        point_speed = np.zeros(n)
        point_speed[0] = speed[0]
        point_speed[-1] = speed[-1]
        point_speed[1:-1] = (speed[:-1] + speed[1:]) / 2.0

        is_slow = point_speed < speed_threshold
        cut_indices = []
        i = 1
        while i < n - 1:
            if is_slow[i]:
                j = i
                while j < n - 1 and is_slow[j]:
                    j += 1
                cut_indices.append((i + j - 1) // 2)
                i = j
            else:
                i += 1

        if not cut_indices:
            result.append(seg)
            continue

        bounds = [0] + [c + 1 for c in cut_indices] + [n]
        bounds = sorted(set(b for b in bounds if 0 <= b <= n))
        for a, b in zip(bounds[:-1], bounds[1:]):
            if b - a >= min_points:
                result.append({
                    "x": x[a:b], "y": y[a:b], "t": t[a:b] - t[a],
                    "t_epoch": t_epoch[a:b], "session_id": seg["session_id"],
                })
    return result


def load_click_times(db_path):
    """Charge les timestamps epoch des clics enfoncés (pressed=1) depuis la
    table `clicks`, s'ils existent. Retourne un tableau trié (vide si la
    table n'existe pas ou est vide)."""
    conn = sqlite3.connect(db_path)
    cur = conn.cursor()
    try:
        cur.execute("SELECT timestamp_epoch FROM clicks WHERE pressed=1")
        rows = cur.fetchall()
    except sqlite3.OperationalError:
        rows = []
    conn.close()
    return np.array(sorted(r[0] for r in rows), dtype=np.float64)


def tag_anodin_segments(segments, click_times,
                         threshold_s=ANODIN_CLICK_DISTANCE_THRESHOLD_S):
    """
    Marque chaque segment comme "anodin" (True) ou "intentionnel" (False),
    en se basant EXCLUSIVEMENT sur vos données mesurées : un trajet est
    intentionnel s'il se termine à moins de `threshold_s` secondes d'un
    clic réel enregistré (avant ou après), ce qui capture le pattern
    observé empiriquement -- les mouvements qui précèdent un clic sont
    significativement plus courts et plus lents (ajustement fin de
    dernière seconde) que le reste des mouvements de souris.

    Si la base ne contient aucun clic exploitable, tous les segments sont
    considérés anodins par défaut (impossible de distinguer sans référence).
    """
    if len(click_times) == 0:
        return np.ones(len(segments), dtype=bool)
    flags = []
    for s in segments:
        end_t = s["t_epoch"][-1]
        idx = np.searchsorted(click_times, end_t)
        candidates = []
        if idx < len(click_times):
            candidates.append(abs(click_times[idx] - end_t))
        if idx > 0:
            candidates.append(abs(click_times[idx - 1] - end_t))
        min_dist = min(candidates) if candidates else 999.0
        flags.append(min_dist > threshold_s)
    return np.array(flags, dtype=bool)


def _savgol_window_for_segment(n_points, target_fraction=0.25, min_window=5):
    window = max(min_window, int(round(n_points * target_fraction)))
    if window % 2 == 0:
        window += 1
    window = min(window, n_points - (1 - n_points % 2))
    if window < 5:
        window = min(5, n_points if n_points % 2 == 1 else n_points - 1)
    return max(window, 3)


def decompose_segment(seg, polyorder=3):
    """Décompose un trajet en couche lente (forme) + résidu (tremblement)."""
    t, x, y = seg["t"], seg["x"], seg["y"]
    n = len(x)

    if n < 5:
        seg["x_smooth"] = x.copy()
        seg["y_smooth"] = y.copy()
        seg["res_x"] = np.zeros(n)
        seg["res_y"] = np.zeros(n)
        seg["savgol_window"] = 0
        return seg

    dt_real = np.diff(t)
    dt_median = np.median(dt_real[dt_real > 0]) if np.any(dt_real > 0) else 0.01
    dt_median = max(dt_median, 1e-4)
    n_grid = max(n, int(round((t[-1] - t[0]) / dt_median)) + 1)
    n_grid = min(n_grid, n * 8)
    t_grid = np.linspace(t[0], t[-1], n_grid)

    x_grid = np.interp(t_grid, t, x)
    y_grid = np.interp(t_grid, t, y)

    window = _savgol_window_for_segment(n_grid)
    polyorder_eff = min(polyorder, window - 1) if window > polyorder else max(1, window - 1)

    x_smooth_grid = savgol_filter(x_grid, window_length=window, polyorder=polyorder_eff, mode='interp')
    y_smooth_grid = savgol_filter(y_grid, window_length=window, polyorder=polyorder_eff, mode='interp')

    x_smooth = np.interp(t, t_grid, x_smooth_grid)
    y_smooth = np.interp(t, t_grid, y_smooth_grid)

    seg["x_smooth"] = x_smooth
    seg["y_smooth"] = y_smooth
    seg["res_x"] = x - x_smooth
    seg["res_y"] = y - y_smooth
    seg["savgol_window"] = window
    return seg


def decompose_all(segments, polyorder=3):
    return [decompose_segment(s, polyorder=polyorder) for s in segments]


def segment_geometry(seg):
    dx = seg["x"][-1] - seg["x"][0]
    dy = seg["y"][-1] - seg["y"][0]
    return float(np.hypot(dx, dy)), float(np.arctan2(dy, dx))


class TrajectoryBank:
    """Banque de trajets réels indexée (KDTree sur distance/angle) pour
    recherche par similarité. Se reconstruit entièrement depuis la base
    SQLite à l'instanciation."""

    def __init__(self, db_path, min_distance_px=MIN_TRAJECTORY_DISTANCE_PX):
        self.db_path = db_path
        self.min_distance_px = min_distance_px
        self.segments = []
        self.distances = None
        self.angles = None
        self._tree = None
        self._tree_anodin = None
        self._anodin_indices = np.array([], dtype=int)
        self.is_anodin = np.array([], dtype=bool)
        self._distance_scale = 1.0
        self.duration_law_exponent = 0.0
        self.duration_law_scale = 1.0
        self.span_x = (0.0, 1920.0)
        self.span_y = (0.0, 1080.0)
        self.build()

    def build(self):
        segs = load_segments(self.db_path)
        segs = split_on_speed_minima(segs)
        segs = decompose_all(segs)

        kept, geoms = [], []
        for s in segs:
            d, a = segment_geometry(s)
            if d >= self.min_distance_px:
                kept.append(s)
                geoms.append((d, a))

        self.segments = kept
        if not geoms:
            self.distances = np.array([])
            self.angles = np.array([])
            self._tree = None
            self.is_anodin = np.array([], dtype=bool)
            self._tree_anodin = None
            return

        self.distances = np.array([g[0] for g in geoms])
        self.angles = np.array([g[1] for g in geoms])
        self._distance_scale = max(float(np.std(self.distances)), 1.0)

        # Tag anodin/intentionnel, dérivé du croisement avec les vrais clics
        # enregistrés (cf. tag_anodin_segments). Permet le mode JUST_MOVE :
        # générer un déplacement qui imite spécifiquement vos mouvements
        # "sans but" plutôt que vos approches de clic.
        click_times = load_click_times(self.db_path)
        self.is_anodin = tag_anodin_segments(self.segments, click_times)

        durations = np.array([s["t"][-1] for s in kept if s["t"][-1] > 0])
        dist_for_fit = np.array([segment_geometry(s)[0] for s in kept if s["t"][-1] > 0])
        mask = (durations > 0) & (dist_for_fit > 0)
        if mask.sum() >= 5:
            logd = np.log(dist_for_fit[mask])
            logt = np.log(durations[mask])
            A = np.vstack([logd, np.ones_like(logd)]).T
            coef_b, coef_loga = np.linalg.lstsq(A, logt, rcond=None)[0]
            self.duration_law_exponent = float(coef_b)
            self.duration_law_scale = float(np.exp(coef_loga))

        coords = self._to_feature_space(self.distances, self.angles)
        self._tree = KDTree(coords)

        # Index secondaire, restreint aux seuls trajets anodins, pour que
        # le mode JUST_MOVE recherche exclusivement parmi eux sans avoir à
        # filtrer les résultats après coup (plus rapide, et évite de
        # retomber sur un trajet intentionnel faute de mieux).
        anodin_idx = np.where(self.is_anodin)[0]
        self._anodin_indices = anodin_idx
        if len(anodin_idx) >= 1:
            coords_anodin = self._to_feature_space(
                self.distances[anodin_idx], self.angles[anodin_idx]
            )
            self._tree_anodin = KDTree(coords_anodin)
        else:
            self._tree_anodin = None

        all_x = np.concatenate([s["x"] for s in kept])
        all_y = np.concatenate([s["y"] for s in kept])
        self.span_x = (float(all_x.min()), float(all_x.max()))
        self.span_y = (float(all_y.min()), float(all_y.max()))

    def _to_feature_space(self, distances, angles):
        d_norm = np.asarray(distances) / self._distance_scale
        return np.stack([d_norm, np.cos(angles), np.sin(angles)], axis=1)

    def query(self, target_distance, target_angle, k=5, anodin_only=False):
        """
        Retourne les k trajets réels les plus proches (distance, angle) de
        la requête. Si anodin_only=True, la recherche est restreinte à
        l'index secondaire des trajets "anodins" (loin de tout clic réel,
        cf. tag_anodin_segments) -- utilisé par le mode JUST_MOVE.
        """
        if anodin_only:
            if self._tree_anodin is None or len(self._anodin_indices) == 0:
                return []
            k_eff = min(k, len(self._anodin_indices))
            q = self._to_feature_space(np.array([target_distance]), np.array([target_angle]))[0]
            dists, local_idxs = self._tree_anodin.query(q, k=k_eff)
            if k_eff == 1:
                dists, local_idxs = [dists], [local_idxs]
            results = []
            for fd, li in zip(dists, local_idxs):
                i = self._anodin_indices[li]
                results.append((self.segments[i], self.distances[i], self.angles[i], float(fd)))
            return results

        if self._tree is None or len(self.segments) == 0:
            return []
        k_eff = min(k, len(self.segments))
        q = self._to_feature_space(np.array([target_distance]), np.array([target_angle]))[0]
        dists, idxs = self._tree.query(q, k=k_eff)
        if k_eff == 1:
            dists, idxs = [dists], [idxs]
        return [(self.segments[i], self.distances[i], self.angles[i], float(fd))
                for fd, i in zip(dists, idxs)]

    def residual_bank(self):
        return [np.stack([s["res_x"], s["res_y"]], axis=1) for s in self.segments]

    def __len__(self):
        return len(self.segments)


def _similarity_transform(points, src_a, src_b, dst_a, dst_b):
    """Rotation + échelle uniforme envoyant src_a->dst_a et src_b->dst_b,
    sans déformer la forme relative de la courbe."""
    points = np.asarray(points, dtype=np.float64)
    src_a, src_b = np.asarray(src_a, dtype=np.float64), np.asarray(src_b, dtype=np.float64)
    dst_a, dst_b = np.asarray(dst_a, dtype=np.float64), np.asarray(dst_b, dtype=np.float64)

    src_vec = src_b - src_a
    dst_vec = dst_b - dst_a
    src_len = np.linalg.norm(src_vec)
    if src_len < 1e-9:
        return np.linspace(dst_a, dst_b, len(points))

    scale = np.linalg.norm(dst_vec) / src_len
    rotation = np.arctan2(dst_vec[1], dst_vec[0]) - np.arctan2(src_vec[1], src_vec[0])
    cos_r, sin_r = np.cos(rotation), np.sin(rotation)
    R = np.array([[cos_r, -sin_r], [sin_r, cos_r]])
    return (R @ (points - src_a).T).T * scale + dst_a


def _resample_profile_to_n(values, n_out):
    values = np.asarray(values, dtype=np.float64)
    n_in = len(values)
    if n_in == n_out:
        return values.copy()
    return np.interp(np.linspace(0, 1, n_out), np.linspace(0, 1, n_in), values)


def _block_bootstrap_noise(residual_bank, n_out, rng, block_size_range=(4, 12)):
    """Recolle des blocs contigus de résidus réels tirés au hasard (préserve
    l'autocorrélation locale du tremblement, pas seulement son amplitude)."""
    usable = [r for r in residual_bank if len(r) >= block_size_range[0]]
    if not usable:
        return np.zeros((n_out, 2))

    out = np.zeros((n_out, 2))
    pos, fade, prev_tail = 0, 3, None
    while pos < n_out:
        src = usable[rng.integers(0, len(usable))]
        max_block = min(block_size_range[1], len(src))
        min_block = min(block_size_range[0], max_block)
        bsize = rng.integers(min_block, max_block + 1)
        start = rng.integers(0, len(src) - bsize + 1)
        block = src[start:start + bsize].copy()

        if prev_tail is not None:
            k = min(fade, len(block), len(prev_tail))
            if k > 0:
                w = np.linspace(0, 1, k)[:, None]
                block[:k] = prev_tail[-k:] * (1 - w) + block[:k] * w

        end = min(pos + bsize, n_out)
        out[pos:end] = block[:end - pos]
        pos = end
        prev_tail = block
    return out


def generate_trajectory(bank: TrajectoryBank, point_a, point_b, rng=None,
                         k_candidates=5, mode="normal", speed_percent=0):
    """Génère un nouveau trajet A->B dérivé du trajet réel le plus proche en
    (distance, angle), avec tremblement resynthétisé par block bootstrap
    (aléatoire contrôlé -> résultat légèrement différent à chaque appel).

    mode:
        "normal"    : cherche parmi TOUS les trajets réels de la banque.
        "just_move" : cherche exclusivement parmi les trajets "anodins"
                      (mouvements qui n'ont mené à aucun clic dans les
                      environs temporels, cf. tag_anodin_segments) --
                      simule un déplacement de souris sans intention de
                      clic, avec la signature de vitesse/distance propre à
                      ce type de mouvement observée dans vos données
                      (généralement plus rapide et moins "freiné en fin de
                      course" qu'une approche de clic).
    speed_percent : float, défaut 0
        Ajustement de la vitesse GLOBALE du trajet généré par rapport au
        rythme réellement mesuré dans vos données (la forme géométrique du
        geste et l'amplitude du tremblement ne sont pas affectées, seule la
        cadence temporelle "t" change) :
            0    -> vitesse normale (comportement d'origine, inchangé)
            200  -> 3x plus rapide (facteur = 1 + 200/100)
            -50  -> 2x plus lent   (facteur = 1 - 50/100 = 0.5)
        Plancher à 0.05 (20x plus lent max) pour éviter une division par
        zéro ou un temps négatif en cas de valeur aberrante (<= -100).
    """
    if rng is None:
        rng = np.random.default_rng()

    point_a = np.asarray(point_a, dtype=np.float64)
    point_b = np.asarray(point_b, dtype=np.float64)
    target_distance = float(np.linalg.norm(point_b - point_a))
    target_angle = float(np.arctan2(*(point_b - point_a)[::-1]))

    anodin_only = (mode == "just_move")
    used_fallback = False
    candidates = bank.query(target_distance, target_angle, k=k_candidates,
                             anodin_only=anodin_only)
    if not candidates and anodin_only:
        # Repli : pas assez de trajets anodins indexés (base trop petite ou
        # sans clics) -> on retombe sur la banque complète plutôt que
        # d'échouer, en le signalant dans source_info.
        candidates = bank.query(target_distance, target_angle, k=k_candidates,
                                 anodin_only=False)
        used_fallback = True
    if not candidates:
        raise ValueError("Banque de trajets vide : impossible de générer.")

    # Tirage pondéré parmi les k plus proches candidats (pas toujours le
    # 1er) : c'est ce qui rend deux générations successives différentes en
    # plus de l'aléa du bruit, tout en restant ancré sur des trajets réels
    # proches de la requête.
    weights = 1.0 / (np.array([c[3] for c in candidates]) + 1e-3)
    weights /= weights.sum()
    choice_idx = rng.choice(len(candidates), p=weights)
    src_seg, src_d, src_a, _ = candidates[choice_idx]

    src_points_smooth = np.stack([src_seg["x_smooth"], src_seg["y_smooth"]], axis=1)
    src_a_point, src_b_point = src_points_smooth[0], src_points_smooth[-1]

    transformed_smooth = _similarity_transform(
        src_points_smooth, src_a_point, src_b_point, point_a, point_b
    )
    transformed_smooth[0] = point_a
    transformed_smooth[-1] = point_b

    src_t = src_seg["t"]
    n_src = len(src_t)
    src_total_t = max(src_t[-1], 1e-3)
    scale_ratio = max(target_distance, 1e-6) / max(src_d, 1e-6)
    time_factor = scale_ratio ** bank.duration_law_exponent
    predicted_tgt_duration = max(src_total_t * time_factor, 1e-3)

    src_dt_mean = max(src_total_t / max(n_src - 1, 1), 1e-3)
    n_out = max(6, int(round(predicted_tgt_duration / src_dt_mean)) + 1)

    # LOG DIAGNOSTIC (demande utilisateur explicite : "enrichir les logs...
    # inere plus de logs pour que a tout les niveau on a vraiment une vue
    # densemble") -- pièce centrale pour diagnostiquer un mousemove
    # anormalement long (cf. cas observé : ~178px parcourus en 23-37s
    # réelles) : expose TOUTE la chaîne de calcul qui aboutit à
    # predicted_tgt_duration, pour voir en un coup d'oeil si le trajet
    # source choisi dans la banque est lui-même long (donnée d'origine),
    # si c'est l'extrapolation par la distance (scale_ratio ** exponent)
    # qui l'amplifie démesurément, ou si duration_law_exponent/scale
    # (ajustés globalement sur toute la banque, cf. TrajectoryBank.build)
    # sont aberrants.
    #
    # PATCH (nettoyage des logs -- problème #2 : ces logs de calcul
    # apparaissent à CHAQUE mouvement de souris, des centaines de lignes
    # en usage normal) -- passés en DEBUG (invisibles par défaut, niveau
    # racine INFO ; visibles avec AUTONIAX_DEBUG=1, cf. logging.basicConfig
    # en tête de fichier). Le résumé utile en production (durée totale
    # réellement attendue) reste en INFO, cf. le dernier log.info de cette
    # fonction plus bas ("durée FINALE du trajet=...").
    log.debug(
        f"[trajectoire] mode={mode!r} target_distance={target_distance:.1f}px "
        f"target_angle={math.degrees(target_angle):.1f}° -- candidat choisi : "
        f"src_distance={src_d:.1f}px src_angle={math.degrees(src_a):.1f}° "
        f"src_total_t={src_total_t:.3f}s src_n_points={n_src} "
        f"used_fallback={used_fallback} (anodin_only demandé={anodin_only}, "
        f"nb_candidats={len(candidates)})"
    )
    log.debug(
        f"[trajectoire] extrapolation durée : scale_ratio={scale_ratio:.3f} "
        f"(=target_distance/src_distance) duration_law_exponent={bank.duration_law_exponent:.3f} "
        f"-> time_factor={time_factor:.3f} -> predicted_tgt_duration="
        f"{predicted_tgt_duration:.3f}s (AVANT speed_percent) -- n_out={n_out} points générés "
        f"(src_dt_mean={src_dt_mean * 1000:.1f}ms)"
    )

    src_t_normalized = src_t / max(src_t[-1], 1e-6)
    u_out = _resample_profile_to_n(src_t_normalized, n_out)
    t_out = u_out * predicted_tgt_duration

    x_smooth_out = _resample_profile_to_n(transformed_smooth[:, 0], n_out)
    y_smooth_out = _resample_profile_to_n(transformed_smooth[:, 1], n_out)

    noise = _block_bootstrap_noise(bank.residual_bank(), n_out, rng)
    x_out = x_smooth_out + noise[:, 0]
    y_out = y_smooth_out + noise[:, 1]
    x_out[0], y_out[0] = point_a
    x_out[-1], y_out[-1] = point_b

    # Ajustement de la cadence temporelle selon speed_percent, appliqué ici
    # (au coeur du calcul) plutôt que seulement dans generate_mouse_path, pour
    # que l'UI (qui appelle generate_trajectory directement) en bénéficie aussi.
    speed_factor = max(1.0 + speed_percent / 100.0, 0.05)
    t_out = t_out / speed_factor

    log.info(
        f"[trajectoire] speed_percent={speed_percent:.0f} -> speed_factor={speed_factor:.3f} "
        f"-- durée FINALE du trajet={float(t_out[-1]):.3f}s (c'est cette valeur, sommée sur "
        f"tous les 'dt', que la boucle de rejeu va réellement attendre via asyncio.sleep)"
    )

    return {
        "x": x_out, "y": y_out, "t": t_out,
        "x_smooth": x_smooth_out, "y_smooth": y_smooth_out,
        "source_info": {
            "source_distance_px": src_d, "source_angle_deg": float(np.rad2deg(src_a)),
            "source_n_points": n_src, "target_distance_px": target_distance,
            "target_angle_deg": float(np.rad2deg(target_angle)), "n_points_generated": n_out,
            "mode": mode, "used_fallback": used_fallback, "speed_percent": speed_percent,
        },
    }


# ==============================================================================
# ========================  FONCTION PUBLIQUE (REJEU)  ========================
# ==============================================================================

# Cache de banques déjà construites, indexé par chemin de base absolu. Évite
# de relire/relissée/réindexer toute la base à chaque appel si la même base
# est utilisée pour plusieurs trajets d'affilée (cas typique d'une boucle de
# rejeu qui appelle generate_mouse_path() en rafale). Le cache est invalidé
# automatiquement si le fichier a été modifié depuis (mtime), pour que les
# nouvelles données enregistrées soient bien prises en compte.
_bank_cache: dict[str, tuple[float, "TrajectoryBank"]] = {}


def _get_cached_bank(db_path: str) -> "TrajectoryBank":
    import os
    abs_path = os.path.abspath(db_path)
    mtime = os.path.getmtime(abs_path)
    cached = _bank_cache.get(abs_path)
    if cached is not None and cached[0] == mtime:
        return cached[1]
    bank = TrajectoryBank(abs_path)
    _bank_cache[abs_path] = (mtime, bank)
    return bank


def generate_mouse_path(db_path, point_a, point_b, intent="click",
                         click_button="left", seed=None, bank=None,
                         speed_percent=0):
    """
    Génère un trajet de souris rejouable, de point_a à point_b, dérivé
    statistiquement des mouvements réels enregistrés dans `db_path`.

    Conçu pour être importé et utilisé directement dans une boucle de rejeu
    pilotant une souris réelle (ex. via pynput.mouse.Controller) :

        from mouse_trajectory_app import generate_mouse_path
        import time
        from pynput.mouse import Controller, Button

        events = generate_mouse_path(
            "mouse_tracking.sqlite3", (150, 150), (900, 500), intent="click"
        )
        mouse = Controller()
        for ev in events:
            time.sleep(ev["dt"])
            if ev["type"] == "move":
                mouse.position = (ev["x"], ev["y"])
            elif ev["type"] == "click":
                mouse.position = (ev["x"], ev["y"])
                mouse.click(Button.left if ev["button"] == "left" else Button.right)

    Paramètres
    ----------
    db_path : str
        Chemin vers la base SQLite de mouvements enregistrés (table
        `positions`, et optionnellement `clicks` pour le mode "move").
    point_a : tuple(float, float)
        Point de départ (x, y) en pixels écran.
    point_b : tuple(float, float)
        Point d'arrivée (x, y) en pixels écran.
    intent : "click" | "move"
        "click"  : le trajet a pour but final un clic en B -- dérivé des
                   trajets réels qui précèdent effectivement un clic
                   (approche généralement plus lente/précise en fin de
                   course), et un événement "click" est ajouté à la fin de
                   la liste retournée.
        "move"   : mouvement sans intention de clic ("just move") -- dérivé
                   exclusivement des trajets réels qui ne mènent à aucun
                   clic dans leur voisinage temporel. Aucun événement
                   "click" n'est ajouté.
    click_button : "left" | "right" | "middle"
        Bouton à rapporter dans l'événement "click" (n'affecte pas la
        trajectoire elle-même, seulement l'événement final). Ignoré si
        intent="move".
    seed : int, optionnel
        Graine aléatoire pour reproductibilité (même seed -> même trajet).
        Si None, un tirage aléatoire différent est fait à chaque appel.
    bank : TrajectoryBank, optionnel
        Banque déjà construite (cf. TrajectoryBank(db_path)), pour éviter
        de la reconstruire si vous générez beaucoup de trajets d'affilée
        vous-même en dehors de cette fonction. Si omis, une banque mise en
        cache automatiquement (par chemin de fichier + date de modification)
        est utilisée.
    speed_percent : float, défaut 0
        Ajustement de la vitesse GLOBALE d'exécution par rapport au rythme
        réellement mesuré dans vos données (la forme du geste et le
        tremblement ne sont pas affectés, seule la cadence temporelle des
        "dt" change) :
            0    -> vitesse normale (comportement par défaut, inchangé)
            200  -> 200% plus rapide, donc 3x plus vite (facteur = 1+200/100)
            -50  -> 50% plus lent, donc 2x plus lent (facteur = 1-50/100 = 0.5)
            100  -> 2x plus rapide
        Formule : facteur_vitesse = 1 + speed_percent/100, avec un plancher
        à 0.05 (20x plus lent max) pour éviter une division par zéro ou un
        temps négatif si une valeur <= -100 est passée par erreur.

    Retour
    ------
    list[dict] : liste ordonnée d'événements à rejouer, chacun de la forme
        {"type": "move", "t": float, "dt": float, "x": float, "y": float}
        ou, en dernière position si intent="click" :
        {"type": "click", "t": float, "dt": float, "x": float, "y": float,
         "button": str}
        - "t"  : temps absolu depuis le début du trajet, en secondes
                 (déjà ajusté selon speed_percent).
        - "dt" : délai à attendre depuis l'événement précédent, en secondes
                 (ce que la boucle de rejeu doit utiliser : time.sleep(dt)
                 puis exécuter l'événement).
        - "x", "y" : position cible en pixels écran (non affectés par
                     speed_percent -- seule la cadence temporelle change).

    Lève ValueError si la banque ne contient aucun trajet exploitable
    (base vide ou trop peu de données enregistrées).
    """
    if intent not in ("click", "move"):
        raise ValueError('intent doit être "click" ou "move"')

    if bank is None:
        bank = _get_cached_bank(db_path)
    if len(bank) == 0:
        raise ValueError(
            f"Aucun trajet exploitable dans la base '{db_path}' "
            "(trop peu de données enregistrées, ou déplacements trop courts)."
        )

    # Facteur multiplicatif appliqué au temps : > 1 accélère (dt plus petits),
    # < 1 ralentit. Le calcul réel est fait dans generate_trajectory (seule
    # source de vérité pour l'ajustement de cadence, partagée avec l'UI) ;
    # on ne fait plus que passer speed_percent tel quel.
    mode = "just_move" if intent == "move" else "normal"
    rng = np.random.default_rng(seed)
    traj = generate_trajectory(bank, point_a, point_b, rng=rng, mode=mode,
                                speed_percent=speed_percent)

    events = []
    prev_t = 0.0
    for xi, yi, ti in zip(traj["x"], traj["y"], traj["t"]):
        ti_scaled = float(ti)
        dt = ti_scaled - prev_t
        events.append({
            "type": "move", "t": ti_scaled, "dt": dt,
            "x": float(xi), "y": float(yi),
        })
        prev_t = ti_scaled

    if intent == "click":
        events.append({
            "type": "click", "t": prev_t, "dt": 0.0,
            "x": float(point_b[0]), "y": float(point_b[1]),
            "button": click_button,
        })

    return events


# ==============================================================================
# =====================  GÉNÉRATION DE SCROLL HUMAIN  ========================
# ==============================================================================
# Même esprit que TrajectoryBank/generate_trajectory ci-dessus, appliqué à la
# table `scrolls` de mouseData.sqlite3 (cf. get_mouse_data_path) -- dérive une
# séquence de crans de molette réaliste (quantité, cadence, amplitude par
# cran) des rafales de scroll réellement enregistrées, plutôt qu'un seul
# événement wheel() instantané pour tout le montant demandé.
#
# Conclusions de l'analyse empirique (segmentation + visualisation des
# 8987 événements de scroll disponibles, cf. conversation) qui guident ce
# design :
#   - dt (délai entre crans, médiane ~30ms) et |dy| ne sont quasiment pas
#     corrélés (Pearson -0.05) -> traités séparément pour la cadence.
#   - dy[i-1] et dy[i] SONT fortement corrélés (Pearson 0.93) au sein d'une
#     même rafale réelle (la direction/amplitude reste stable d'un cran au
#     suivant) -> on rejoue des BLOCS CONTIGUS de (dt, dy) tirés de rafales
#     réelles (block-bootstrap, même technique que le tremblement des
#     trajectoires souris), jamais des dy tirés indépendamment.
#   - des rafales de quantité totale égale peuvent avoir une composition
#     très différente (certaines 100% homogènes en -1, d'autres un mélange
#     -2/-1/0/+1) -> le bootstrap pioche ses blocs parmi PLUSIEURS rafales
#     candidates proches en quantité (pas une seule source figée), sans
#     quoi deux générations successives pour la même quantité demandée
#     produisaient un résultat quasi identique dès que la source la plus
#     proche était homogène (constaté et corrigé lors de la validation
#     visuelle, cf. conversation).
# ==============================================================================

MIN_SCROLL_BURST_EVENTS_BANK = 2  # une rafale à 1 seul cran n'a pas de dt à en tirer
GAP_THRESHOLD_SCROLL_S = 0.5
# Durée réelle MAXIMALE (secondes) qu'une séquence de scroll générée peut
# occuper avant que generate_scroll_events n'accélère automatiquement sa
# cadence -- cf. bloc "ACCÉLÉRATION AUTOMATIQUE SUR LES GROS SCROLLS" plus
# bas. Un scroll de faible amplitude (peu de crans, somme des dt déjà sous
# ce seuil) n'est jamais affecté ; seuls les gros delta_y/delta_x, qui
# génèreraient sinon une séquence de plusieurs dizaines de secondes,
# passent sous ce plafond.
DUREE_SCROLL_MAX_S = 3.0

# Nombre ABSOLU maximal de crans qu'une séquence de scroll générée peut
# contenir, quel que soit target_dy -- PAR-DESSUS le garde-fou relatif
# (median_n_src * 20 + 20) déjà présent plus bas, qui ne suffit pas à lui
# seul : chaque cran coûte un aller-retour réel avec le navigateur (un
# await page.mouse.wheel() séparé), pas juste un délai de sleep. Or seul
# DUREE_SCROLL_MAX_S ci-dessus était pris en compte pour l'accélération
# automatique, et il ne majore QUE la somme des délais "dt" (sleeps) entre
# crans, jamais leur NOMBRE -- donc un gros target_dy pouvait toujours
# produire des centaines/milliers de crans (observé en pratique : 1120
# crans pour un delta_y=900, la cadence ramenée à 3s de sleeps au total,
# mais le temps RÉEL dominé par ~1120 x overhead Playwright, dépassant
# largement le timeout de 20s de la commande -- cf. logs "toujours en
# attente" puis "BLOQUÉE" alors qu'aucun cran individuel n'était
# réellement figé, juste beaucoup trop nombreux). Cette valeur borne donc
# directement n_events, indépendamment de la durée : un scroll de grande
# amplitude est représenté par des crans plus GROS (dy plus élevé après
# rescale), pas par plus de crans.
N_EVENTS_SCROLL_MAX = 80


def load_scroll_bursts(db_path, gap_threshold_s=GAP_THRESHOLD_SCROLL_S):
    """Lit la table `scrolls` et découpe le flux continu en rafales
    (coupure si le delta de temps avec l'événement précédent dépasse
    gap_threshold_s, ou changement de session_id -- même principe que
    load_segments pour les positions souris)."""
    conn = sqlite3.connect(db_path)
    cur = conn.cursor()
    cur.execute(
        "SELECT timestamp_epoch, dx, dy, session_id FROM scrolls "
        "ORDER BY session_id, id"
    )
    rows = cur.fetchall()
    conn.close()

    bursts = []
    cur_t, cur_dx, cur_dy, cur_sid, last_ts = [], [], [], None, None

    def flush():
        if len(cur_t) >= 1:
            t_arr = np.array(cur_t, dtype=np.float64)
            bursts.append({
                "t": t_arr - t_arr[0],
                "dx": np.array(cur_dx, dtype=np.float64),
                "dy": np.array(cur_dy, dtype=np.float64),
                "session_id": cur_sid,
            })

    for ts, dx, dy, sid in rows:
        new_burst = cur_sid is None or sid != cur_sid or (last_ts is not None and ts - last_ts > gap_threshold_s)
        if new_burst and cur_t:
            flush()
            cur_t, cur_dx, cur_dy = [], [], []
        cur_t.append(ts)
        cur_dx.append(dx)
        cur_dy.append(dy)
        cur_sid = sid
        last_ts = ts
    flush()
    return bursts


class ScrollBank:
    """Banque de rafales de scroll réelles, indexée par quantité totale
    scrollée (somme signée des dy) pour recherche par similarité -- même
    principe que TrajectoryBank mais sur un seul axe (quantité) au lieu de
    (distance, angle) : le scroll n'a pas d'orientation 2D à préserver
    (dx est quasi toujours nul dans les données observées -- scroll
    horizontal traité comme une composante annexe, pas un mode séparé)."""

    def __init__(self, db_path):
        self.db_path = db_path
        self.bursts = []
        self.total_dy = None
        self._tree = None
        self.build()

    def build(self):
        bursts = load_scroll_bursts(self.db_path)
        self.bursts = [b for b in bursts if len(b["dy"]) >= MIN_SCROLL_BURST_EVENTS_BANK]
        if not self.bursts:
            self.total_dy = np.array([])
            self._tree = None
            return
        self.total_dy = np.array([b["dy"].sum() for b in self.bursts])
        coords = self.total_dy.reshape(-1, 1)
        self._tree = KDTree(coords)

    def query(self, target_total_dy, k=12):
        """Retourne les k rafales réelles les plus proches en quantité
        totale scrollée (somme des dy) de la requête."""
        if self._tree is None or len(self.bursts) == 0:
            return []
        k_eff = min(k, len(self.bursts))
        q = np.array([[target_total_dy]])
        dists, idxs = self._tree.query(q, k=k_eff)
        dists, idxs = np.atleast_1d(dists[0]), np.atleast_1d(idxs[0])
        return [(self.bursts[i], self.total_dy[i], float(d)) for d, i in zip(dists, idxs)]

    def __len__(self):
        return len(self.bursts)


def _block_bootstrap_scroll_multi(candidate_bursts, n_events_needed, rng, block_size_range=(4, 12)):
    """Construit une séquence de n_events_needed (dt, dy, dx) en recollant
    des blocs CONTIGUS tirés de PLUSIEURS rafales candidates (une rafale
    différente peut être piochée à chaque bloc), préservant ainsi :
      - l'autocorrélation locale dy[i-1]->dy[i] mesurée À L'INTÉRIEUR de
        chaque bloc (extrait contigu d'une seule rafale réelle) ;
      - la diversité de composition ENTRE rafales de quantité comparable
        (cf. docstring du bloc GÉNÉRATION DE SCROLL HUMAIN ci-dessus).
    Si une rafale source est plus courte que le bloc à prélever, elle est
    utilisée en entier (repioche une autre rafale/un autre bloc ensuite)."""
    usable = [b for b in candidate_bursts if len(b["dy"]) >= 2]
    if not usable:
        raise ValueError("Aucune rafale candidate exploitable pour le bootstrap de scroll.")

    all_dt = [np.diff(b["t"]) for b in usable]

    out_dt, out_dy, out_dx = [], [], []
    pos = 0
    while pos < n_events_needed:
        src_idx = int(rng.integers(0, len(usable)))
        src = usable[src_idx]
        src_dt = all_dt[src_idx]
        src_dy = src["dy"]
        src_dx = src["dx"]
        n_src = len(src_dy)

        max_block = min(block_size_range[1], n_src)
        min_block = min(block_size_range[0], max_block)
        bsize = int(rng.integers(min_block, max_block + 1)) if max_block > min_block else max_block
        start = int(rng.integers(0, max(n_src - bsize + 1, 1)))
        end = min(start + bsize, n_src)

        block_dy = src_dy[start:end]
        block_dx = src_dx[start:end]
        if start == 0:
            first_dt = float(np.median(src_dt)) if len(src_dt) else 0.03
        else:
            first_dt = float(src_dt[start - 1])
        block_dt = np.concatenate([[first_dt], src_dt[start:max(end - 1, start)]]) if end > start else np.array([first_dt])
        block_dt = block_dt[:len(block_dy)]
        if len(block_dt) < len(block_dy):
            pad = float(np.median(src_dt)) if len(src_dt) else 0.03
            block_dt = np.concatenate([block_dt, np.full(len(block_dy) - len(block_dt), pad)])

        take = min(len(block_dy), n_events_needed - pos)
        out_dt.extend(block_dt[:take].tolist())
        out_dy.extend(block_dy[:take].tolist())
        out_dx.extend(block_dx[:take].tolist())
        pos += take

    return np.array(out_dt), np.array(out_dy), np.array(out_dx)


_scroll_bank_cache: dict[str, tuple[float, "ScrollBank"]] = {}


def _get_cached_scroll_bank(db_path: str) -> "ScrollBank":
    """Même principe de cache que _get_cached_bank (trajectoires souris),
    invalidation automatique par mtime du fichier."""
    abs_path = os.path.abspath(db_path)
    mtime = os.path.getmtime(abs_path)
    cached = _scroll_bank_cache.get(abs_path)
    if cached is not None and cached[0] == mtime:
        return cached[1]
    bank = ScrollBank(abs_path)
    _scroll_bank_cache[abs_path] = (mtime, bank)
    return bank


def generate_scroll_events(db_path, target_dy, target_dx=0.0, seed=None,
                            bank=None, speed_percent=0, k_candidates=12):
    """
    Génère une séquence de crans de molette rejouable dont la somme des dy
    est égale à target_dy (et dx à target_dx), dérivée statistiquement des
    rafales de scroll réelles enregistrées dans `db_path` (table
    `scrolls`).

    Paramètres
    ----------
    db_path : str
        Chemin vers la base SQLite de mouvements enregistrés (table
        `scrolls`, cf. mouse_tracker.py).
    target_dy, target_dx : float
        Quantité totale de scroll souhaitée, mêmes unités que dy/dx
        enregistrés (crans de molette signés : négatif = vers le bas,
        cohérent avec le sens WHEEL_DELTA déjà utilisé côté SequenceurAction).
    seed : int, optionnel
        Graine aléatoire pour reproductibilité (même seed -> même séquence).
    bank : ScrollBank, optionnel
        Banque déjà construite, pour éviter de la reconstruire à chaque
        appel (cf. _get_cached_scroll_bank, utilisé par défaut si omis).
    speed_percent : float, défaut 0
        Même formule que generate_mouse_path/generate_trajectory :
        facteur_vitesse = 1 + speed_percent/100 (plancher 0.05), appliqué
        UNIQUEMENT aux délais "dt" entre crans -- n'affecte pas l'amplitude
        dy/dx de chaque cran.
    k_candidates : int, défaut 12
        Nombre de rafales réelles proches en quantité totale parmi
        lesquelles le bootstrap pioche ses blocs (cf. docstring de
        _block_bootstrap_scroll_multi -- un k trop petit reproduirait
        presque le même résultat à chaque appel si la rafale la plus
        proche est homogène).

    Retour
    ------
    list[dict] : liste ordonnée d'événements
        {"dt": float, "dy": float, "dx": float, "t": float}
        - "dt" : délai à attendre depuis l'événement précédent, en
                 secondes (déjà ajusté selon speed_percent).
        - "dy", "dx" : amplitude de CE cran (pas cumulée).
        - "t"  : temps absolu depuis le début de la séquence, en secondes.

    Lève ValueError si la banque ne contient aucune rafale exploitable.
    """
    if bank is None:
        bank = _get_cached_scroll_bank(db_path)
    if len(bank) == 0:
        raise ValueError(
            f"Aucune rafale de scroll exploitable dans la base '{db_path}' "
            "(trop peu de données enregistrées)."
        )

    rng = np.random.default_rng(seed)

    candidates = bank.query(target_dy, k=k_candidates)
    if not candidates:
        raise ValueError("Banque de scroll vide : impossible de générer.")

    candidate_bursts = [c[0] for c in candidates]
    candidate_totals = np.array([c[1] for c in candidates])
    median_n_src = float(np.median([len(b["dy"]) for b in candidate_bursts]))
    median_total = float(np.median(candidate_totals))
    scale_ratio = abs(target_dy) / abs(median_total) if abs(median_total) > 1e-6 else 1.0
    n_events = max(1, int(round(median_n_src * scale_ratio)))
    n_events = min(n_events, int(median_n_src) * 20 + 20)  # garde-fou anti-répétition absurde
    if n_events > N_EVENTS_SCROLL_MAX:
        log.info(
            f"[camoufox] generate_scroll_events() : n_events={n_events} plafonné à "
            f"N_EVENTS_SCROLL_MAX={N_EVENTS_SCROLL_MAX} (target_dy={target_dy:.0f}, "
            f"median_n_src={median_n_src:.0f}, scale_ratio={scale_ratio:.2f}) -- "
            "crans rendus plus gros après rescale, pas plus nombreux."
        )
        n_events = N_EVENTS_SCROLL_MAX

    if n_events == 1:
        sign = 1.0 if target_dy >= 0 else -1.0
        events_dy = np.array([sign * max(abs(target_dy), 1.0)])
        events_dx = np.array([target_dx])
        events_dt = np.array([0.0])
    else:
        events_dt, events_dy, events_dx = _block_bootstrap_scroll_multi(
            candidate_bursts, n_events, rng
        )
        # Rescale proportionnel pour que la somme corresponde exactement à
        # target_dy (le bootstrap donne la bonne forme/cadence/diversité,
        # pas exactement la bonne quantité totale) -- préserve le signe et
        # la forme relative de chaque cran plutôt que d'ajouter un dernier
        # cran correctif arbitraire.
        cur_sum = events_dy.sum()
        if abs(cur_sum) > 1e-6:
            events_dy = events_dy * (target_dy / cur_sum)
        if target_dx != 0.0 and abs(events_dx.sum()) > 1e-6:
            events_dx = events_dx * (target_dx / events_dx.sum())
        else:
            events_dx = np.zeros_like(events_dy) if target_dx == 0.0 else events_dx

    # ACCÉLÉRATION AUTOMATIQUE SUR LES GROS SCROLLS (retour utilisateur :
    # "il faut que quand le delta_y est élevé le scroll soit beaucoup plus
    # rapide") -- SANS ce facteur, le temps réel total est proportionnel
    # au nombre de crans (n_events, lui-même proportionnel à target_dy) :
    # un delta_y=9000 pouvait générer ~300 crans à ~30ms d'intervalle
    # (cadence humaine mesurée, cf. tête de section GÉNÉRATION DE SCROLL
    # HUMAIN plus haut), soit plusieurs dizaines de secondes pour un seul
    # appel scroll() -- observé en pratique : la commande ne répondait
    # plus avant le timeout de la commande suivante (capture_propre).
    # Un humain qui doit défiler beaucoup scrolle objectivement plus vite
    # (rafales plus denses), pas au même rythme qu'un petit ajustement de
    # quelques crans -- ce facteur reproduit ça : le TEMPS TOTAL de la
    # séquence ne dépasse jamais DUREE_SCROLL_MAX_S, quel que soit
    # n_events, en accélérant la cadence proportionnellement au nombre de
    # crans réels générés (jamais leur nombre ni leur forme, cf.
    # n_events/events_dy ci-dessus, laissés intacts -- seule la cadence dt
    # change). Une séquence déjà sous ce plafond n'est jamais ralentie par
    # ce facteur (facteur_acceleration_amplitude reste à 1.0). speed_percent
    # (contrôle explicite de l'appelant) reste appliqué PAR-DESSUS, donc
    # toujours prioritaire dans son sens habituel (positif = encore plus
    # rapide, négatif = plus lent) -- les deux facteurs se multiplient.
    duree_brute_s = float(events_dt.sum())
    if duree_brute_s > DUREE_SCROLL_MAX_S:
        facteur_acceleration_amplitude = duree_brute_s / DUREE_SCROLL_MAX_S
    else:
        facteur_acceleration_amplitude = 1.0

    speed_factor = max(1.0 + speed_percent / 100.0, 0.05) * facteur_acceleration_amplitude
    events_dt = events_dt / speed_factor

    out = []
    t_cum = 0.0
    for dt, dy, dx in zip(events_dt, events_dy, events_dx):
        t_cum += float(dt)
        out.append({"dt": float(dt), "dy": float(dy), "dx": float(dx), "t": t_cum})
    return out


# ---------------------------------------------------------------------------
# GÉNÉRATION DE DURÉE DE CLIC HUMAINE (retour utilisateur explicite : "les
# duree des clic dun clic normal comment es ce que cest fait" -> constat que
# duree_appui_ms était une constante fixe (60ms, cf. action_click/
# action_camoufox_click) sans aucune variabilité, contrairement au mousemove
# et au scroll qui dérivent déjà leur cadence de mouvements réels enregistrés
# -- puis "je veux vraiment un algo robuste" une fois les données de clics
# réelles fournies, cf. table `clicks` de mouseData.sqlite3, PAS de trajet
# 2D ni de rafale ici : juste UNE durée (mousedown->mouseup) par clic, donc
# un modèle beaucoup plus simple que TrajectoryBank/ScrollBank -- pas besoin
# de KDTree/scipy, un bootstrap dans le tableau 1D des durées réelles suffit
# (numpy seul, déjà une dépendance dure de ce fichier, contrairement à scipy
# qui reste optionnel).
#
# FILTRAGE DES OUTLIERS (retour utilisateur explicite, choix parmi les
# options proposées : "seuil adaptatif (percentile 95 ... robuste si le
# profil change)") -- MAIS un p95 calculé sur la distribution BRUTE (sans
# filtrage préalable) s'est révélé lui-même pollué par les vrais outliers :
# sur les données de validation fournies (756 clics table `clicks`), p95 brut
# valait ~803ms alors que le corps réel de la distribution (clics francs)
# s'arrête net vers ~220ms, avec un creux net avant le prochain palier
# (300ms+, très probablement des drags/sélections de texte capturés dans la
# même table faute de distinction dans le tracker). Un percentile fixe
# choisi À L'AVEUGLE sur la distribution brute n'aurait donc pas été robuste
# du tout -- il aurait justement inclus une partie des outliers qu'il est
# censé exclure. Solution retenue : clôture de Tukey (Q3 + 1.5*IQR), LA
# méthode statistique standard pour détecter des outliers sans supposer de
# forme de distribution a priori (contrairement à un z-score, qui suppose une
# normalité que cette distribution n'a pas -- cf. pic dominant à ~155ms) --
# validé sur les données fournies : donne ~193ms, coupe exactement dans le
# creux observé (90.9% des clics conservés, coupure nette juste après le
# corps dense de la distribution). "Adaptatif" ici veut dire : recalculé à
# chaque construction de banque depuis les données réelles présentes, PAS
# une constante gelée à 193ms -- si le profil de frappe change (nouvelle
# banque enregistrée), le seuil suit automatiquement.
# ---------------------------------------------------------------------------

# Nombre minimal de clics valides (après filtrage Tukey) pour qu'une banque
# soit considérée exploitable -- sous ce seuil, le bootstrap piocherait
# systématiquement dans un tout petit échantillon non représentatif (même
# esprit que MIN_SCROLL_BURST_EVENTS_BANK, adapté à l'échelle "quelques
# dizaines de clics minimum" plutôt que "au moins 2 crans par rafale").
MIN_CLICS_BANK = 8

# Facteur de la clôture de Tukey (Q3 + TUKEY_K * IQR) -- 1.5 est la valeur
# standard ("outlier modéré"), cf. docstring du bloc ci-dessus.
TUKEY_K = 1.5


def load_click_durations(db_path: str) -> np.ndarray:
    """Lit la table `clicks` (paires d'événements pressed=1/pressed=0 au
    même point, cf. mouse_tracker.py) et retourne un tableau 1D des durées
    RÉELLES d'appui (mousedown->mouseup) en millisecondes, tous boutons/
    sessions confondus (une seule distribution globale, demande utilisateur
    explicite : pas de séparation gauche/droit pour l'instant).

    Appariement : un `pressed=1` ouvre un appui en attente pour la paire
    (session_id, button) ; le `pressed=0` suivant sur la MÊME paire le
    referme et produit une durée. Un up sans down correspondant (base
    tronquée en plein appui, ex. enregistrement coupé) est ignoré plutôt que
    de produire une durée négative ou aberrante -- même tolérance que
    load_scroll_bursts face à des données de capture imparfaites."""
    conn = sqlite3.connect(db_path)
    cur = conn.cursor()
    cur.execute(
        "SELECT timestamp_epoch, button, pressed, session_id FROM clicks "
        "ORDER BY session_id, id"
    )
    rows = cur.fetchall()
    conn.close()

    pending: dict[tuple, float] = {}
    durations_ms: list[float] = []
    for ts, button, pressed, session_id in rows:
        key = (session_id, button)
        if pressed == 1:
            pending[key] = ts
        else:
            down_ts = pending.pop(key, None)
            if down_ts is not None and ts >= down_ts:
                durations_ms.append((ts - down_ts) * 1000.0)
    return np.array(durations_ms, dtype=np.float64)


def _filtrer_durees_clic_tukey(durations_ms: np.ndarray, k: float = TUKEY_K) -> tuple[np.ndarray, float]:
    """Retire les outliers hauts (maintiens longs, drag, sélection -- pas de
    vrais "clics") via la clôture de Tukey : tout ce qui dépasse
    Q3 + k*IQR est exclu. AUCUN filtrage bas volontairement -- un clic très
    rapide (quelques ms) est un clic humain plausible, pas un artefact,
    contrairement à un appui anormalement long. Retourne (durées filtrées,
    seuil calculé) -- le seuil est renvoyé pour logging/diagnostic, jamais
    codé en dur : il est recalculé à chaque construction de banque depuis
    les données réellement présentes (cf. tête de section)."""
    if len(durations_ms) < 4:
        return durations_ms, float("inf")
    q1, q3 = np.percentile(durations_ms, [25, 75])
    iqr = q3 - q1
    seuil = float(q3 + k * iqr)
    filtrees = durations_ms[durations_ms <= seuil]
    return filtrees, seuil


class ClickBank:
    """Banque de durées de clic réelles (mousedown->mouseup, en ms),
    filtrées des maintiens longs (cf. _filtrer_durees_clic_tukey). Pas
    d'indexation spatiale ici (contrairement à TrajectoryBank/ScrollBank) :
    une durée de clic n'a pas de paramètre de requête naturel comme une
    distance ou une quantité de scroll -- une seule distribution globale
    dont on tire un bootstrap simple (cf. generate_click_duration_ms)."""

    def __init__(self, db_path: str):
        self.db_path = db_path
        self.durations_ms: np.ndarray = np.array([])
        self.seuil_tukey_ms: float = float("inf")
        self.build()

    def build(self):
        brutes = load_click_durations(self.db_path)
        self.durations_ms, self.seuil_tukey_ms = _filtrer_durees_clic_tukey(brutes)
        if len(brutes) > 0:
            log.info(
                f"[ClickBank] {len(brutes)} clic(s) lu(s), seuil Tukey="
                f"{self.seuil_tukey_ms:.1f}ms, {len(self.durations_ms)} conservé(s) "
                f"({len(brutes) - len(self.durations_ms)} exclu(s) comme maintien/drag)."
            )

    def __len__(self):
        return len(self.durations_ms)


_click_bank_cache: dict[str, tuple[float, "ClickBank"]] = {}


def _get_cached_click_bank(db_path: str) -> "ClickBank":
    """Même principe de cache que _get_cached_bank/_get_cached_scroll_bank,
    invalidation automatique par mtime du fichier -- une seule lecture
    SQLite + filtrage Tukey tant que mouseData.sqlite3 ne change pas."""
    abs_path = os.path.abspath(db_path)
    mtime = os.path.getmtime(abs_path)
    cached = _click_bank_cache.get(abs_path)
    if cached is not None and cached[0] == mtime:
        return cached[1]
    bank = ClickBank(abs_path)
    _click_bank_cache[abs_path] = (mtime, bank)
    return bank


def generate_click_duration_ms(db_path: str, seed=None, bank: Optional["ClickBank"] = None,
                                jitter_pct: float = 0.0) -> float:
    """Tire UNE durée d'appui (mousedown->mouseup, en ms) par bootstrap
    direct dans les durées de clic RÉELLES observées (demande utilisateur
    explicite : "tirage direct dans les valeurs réelles observées ...
    préserve exactement la distribution/le pic à 155ms" -- pas de KDE, pas
    de loi théorique ajustée : on repioche littéralement une valeur déjà
    mesurée, donc le résultat reproduit fidèlement la forme réelle de la
    distribution, y compris son pic dominant, sans lissage qui l'atténuerait).

    jitter_pct : optionnel, défaut 0.0 (désactivé) -- bruit multiplicatif
    uniforme +/- jitter_pct appliqué APRÈS le tirage, pour éviter de
    rejouer une poignée de valeurs strictement identiques si le bootstrap
    retombe plusieurs fois sur le même point du pic à 155ms (692 valeurs
    disponibles, mais 61% concentrées dans une bande de 10ms -- deux tirages
    consécutifs peuvent légitimement se ressembler beaucoup). Laissé à 0.0
    par défaut : la demande explicite était un bootstrap PUR, ce paramètre
    n'est qu'une option pour l'appelant, pas un comportement imposé.

    Lève TrajectoireSourisIndisponible (même exception que mousemove/scroll,
    cf. sa docstring -- contrat d'échec explicite déjà en place, pas de
    repli silencieux) si la banque est vide ou trop petite (cf.
    MIN_CLICS_BANK)."""
    if bank is None:
        bank = _get_cached_click_bank(db_path)
    if len(bank) < MIN_CLICS_BANK:
        raise TrajectoireSourisIndisponible(
            f"Banque de durées de clic insuffisante dans '{db_path}' : "
            f"{len(bank)} clic(s) exploitable(s) après filtrage des maintiens "
            f"longs, minimum requis={MIN_CLICS_BANK}."
        )
    rng = np.random.default_rng(seed)
    tirage = float(rng.choice(bank.durations_ms))
    if jitter_pct > 0.0:
        facteur = 1.0 + rng.uniform(-jitter_pct, jitter_pct)
        tirage = max(1.0, tirage * facteur)
    return tirage


def _charger_banque_click_souris() -> "ClickBank":
    """Résout et met en cache (cf. _get_cached_click_bank, invalidation par
    mtime) la banque de durées de clic réelles depuis get_mouse_data_path()
    (Data/files/mouseData.sqlite3) -- même fichier que les banques de
    trajectoire/scroll, table `clicks` au lieu de `positions`/`scrolls`.
    Lève TrajectoireSourisIndisponible avec un message explicite si le
    fichier n'existe pas encore ou si la banque ne contient pas assez de
    clics exploitables (même contrat que _charger_banque_scroll_souris/
    _charger_banque_trajectoire_souris, réutilisé pour rester cohérent).
    Contrairement à ces deux dernières, PAS de dépendance à scipy/
    TRAJECTOIRE_SOURIS_DISPONIBLE -- un bootstrap 1D n'a besoin que de
    numpy, déjà une dépendance dure de ce fichier."""
    chemin = get_mouse_data_path()
    if not chemin.is_file():
        raise TrajectoireSourisIndisponible(
            f"Aucune donnée de clic trouvée : {chemin} n'existe pas. "
            "Enregistrez d'abord des clics réels avec mouse_tracker.py (le "
            "fichier doit s'appeler mouseData.sqlite3 et se trouver dans "
            "Data/files/)."
        )
    try:
        bank = _get_cached_click_bank(str(chemin))
    except Exception as exc:
        raise TrajectoireSourisIndisponible(
            f"Échec du chargement de la banque de clics depuis {chemin} : {exc!r}"
        ) from exc
    if len(bank) < MIN_CLICS_BANK:
        raise TrajectoireSourisIndisponible(
            f"La base {chemin} ne contient pas assez de clics exploitables "
            f"({len(bank)} après filtrage, minimum requis={MIN_CLICS_BANK})."
        )
    return bank


# ---------------------------------------------------------------------------
# GÉNÉRATION DE DÉLAI DE FRAPPE HUMAIN (retour utilisateur explicite, même
# démarche que pour ClickBank ci-dessus : "et maintenant pour la saisie, es
# ce que la bd contient des données exploitable pour la saisie" -> table
# `keystrokes` de mouseData.sqlite3, 22859 événements pressed=1/pressed=0
# par touche, largement exploitable) -- remplace le random.randint(delai_
# min_ms, delai_max_ms) UNIFORME actuel de action_type_text/action_camoufox_
# type_text (cf. leur code, borné en dur 60-180ms) par un bootstrap dans les
# INTERVALLES RÉELS mesurés entre deux appuis de touche consécutifs
# (key_down[i] -> key_down[i+1]).
#
# COMPARAISON QUI JUSTIFIE CE PATCH (retour utilisateur explicite : "es ce
# que cest relement utile" -- vérifié avant de coder, cf. discussion) :
# randint(60,180) produit une distribution UNIFORME (60 et 180 aussi
# probables que 120, coupure nette aux deux bornes) alors que la vraie
# distribution mesurée est une cloche asymétrique décalée (pic 100-200ms,
# longue traîne jusqu'à ~1000ms, minimum observé ~9ms) -- une forme
# statistiquement très différente, pas juste "moins précise". C'est ce
# point précis (forme de distribution, pas seulement sa moyenne) qui rend
# le remplacement utile, pas cosmétique.
#
# PÉRIMÈTRE VOLONTAIREMENT SIMPLE (décisions utilisateur explicites,
# "pas de préférence" sur les raffinements proposés -> option la plus
# simple retenue par défaut, cohérente avec ClickBank) :
#   - UNE SEULE distribution globale, tous caractères confondus (pas de
#     distinction Shift/lettre/espace/backspace, malgré leur dynamique très
#     différente observée -- cf. discussion, laissé pour un futur patch si
#     besoin) ;
#   - bootstrap INDÉPENDANT par caractère (pas de bootstrap par bloc
#     contigu façon _block_bootstrap_scroll_multi -- chaque délai est tiré
#     seul, sans préserver l'enchaînement rafale-rapide/pause-lente réel).
#
# FILTRAGE (même esprit que le seuil Tukey de ClickBank, mais méthode
# différente ici -- volontairement) : contrairement aux durées de clic
# (outliers hauts fréquents et proches du corps de la distribution, d'où
# Tukey), les intervalles inter-touches ont une coupure évidente et franche
# dans les données observées (~96% des intervalles sous 1000ms, chute nette
# ensuite -- au-delà, ce sont des PAUSES de frappe, pas des délais entre
# deux touches d'un même geste). Un seuil fixe simple (GAP_THRESHOLD_
# FRAPPE_S) suffit donc ici, pas besoin de recalculer Q1/Q3/IQR à chaque
# construction de banque.
# ---------------------------------------------------------------------------

# Au-delà de ce seuil (secondes) entre deux key_down consécutifs, on
# considère que la frappe s'est interrompue (pause/réflexion), pas un
# simple délai entre deux touches d'un même geste de saisie -- cf. tête de
# section pour la justification empirique (~96% des intervalles mesurés
# sous ce seuil, chute nette au-delà).
GAP_THRESHOLD_FRAPPE_S = 1.0

# Nombre minimal d'intervalles exploitables pour qu'une banque de frappe
# soit considérée utilisable -- même esprit que MIN_CLICS_BANK.
MIN_INTERVALLES_FRAPPE_BANK = 20


def load_keystroke_intervals_ms(db_path: str, gap_threshold_s: float = GAP_THRESHOLD_FRAPPE_S) -> np.ndarray:
    """Lit la table `keystrokes` et retourne un tableau 1D des intervalles
    RÉELS (en ms) entre deux appuis (pressed=1) consécutifs d'une même
    session, en excluant tout intervalle qui dépasse gap_threshold_s (une
    pause de frappe, pas un délai entre deux touches d'un même geste --
    même principe de coupure que load_scroll_bursts/GAP_THRESHOLD_SCROLL_S,
    mais ICI le filtrage se fait directement sur les intervalles retournés
    plutôt qu'en down des rafales séparées : pas besoin de préserver la
    structure de rafale pour un simple bootstrap indépendant par caractère,
    cf. tête de section).

    Ne considère QUE les événements pressed=1 (key_down) -- pas besoin
    d'apparier avec les pressed=0 ici (contrairement à load_click_durations)
    puisqu'on mesure l'écart entre deux appuis, pas la durée d'un appui."""
    conn = sqlite3.connect(db_path)
    cur = conn.cursor()
    cur.execute(
        "SELECT timestamp_epoch, pressed, session_id FROM keystrokes "
        "WHERE pressed = 1 ORDER BY session_id, id"
    )
    rows = cur.fetchall()
    conn.close()

    intervalles_ms: list[float] = []
    dernier_ts_par_session: dict[str, float] = {}
    for ts, pressed, session_id in rows:
        dernier = dernier_ts_par_session.get(session_id)
        if dernier is not None:
            dt_s = ts - dernier
            if 0.0 <= dt_s <= gap_threshold_s:
                intervalles_ms.append(dt_s * 1000.0)
        dernier_ts_par_session[session_id] = ts
    return np.array(intervalles_ms, dtype=np.float64)


class TypingBank:
    """Banque d'intervalles inter-touches réels (en ms), déjà filtrés des
    pauses de frappe (cf. load_keystroke_intervals_ms). Même principe que
    ClickBank : pas d'indexation spatiale, une seule distribution globale
    dont generate_keystroke_delay_ms tire un bootstrap indépendant."""

    def __init__(self, db_path: str):
        self.db_path = db_path
        self.intervalles_ms: np.ndarray = np.array([])
        self.build()

    def build(self):
        self.intervalles_ms = load_keystroke_intervals_ms(self.db_path)
        if len(self.intervalles_ms) > 0:
            log.info(
                f"[TypingBank] {len(self.intervalles_ms)} intervalle(s) inter-touche "
                f"exploitable(s) chargé(s) depuis {self.db_path}."
            )

    def __len__(self):
        return len(self.intervalles_ms)


_typing_bank_cache: dict[str, tuple[float, "TypingBank"]] = {}


def _get_cached_typing_bank(db_path: str) -> "TypingBank":
    """Même principe de cache que _get_cached_click_bank, invalidation
    automatique par mtime du fichier."""
    abs_path = os.path.abspath(db_path)
    mtime = os.path.getmtime(abs_path)
    cached = _typing_bank_cache.get(abs_path)
    if cached is not None and cached[0] == mtime:
        return cached[1]
    bank = TypingBank(abs_path)
    _typing_bank_cache[abs_path] = (mtime, bank)
    return bank


def generate_keystroke_delay_ms(db_path: str, seed=None, bank: Optional["TypingBank"] = None) -> float:
    """Tire UN délai inter-touche (en ms) par bootstrap indépendant dans les
    intervalles réels mesurés (cf. tête de section GÉNÉRATION DE DÉLAI DE
    FRAPPE HUMAIN -- même démarche que generate_click_duration_ms : pas de
    KDE ni de loi théorique, un tirage direct dans les valeurs mesurées
    préserve fidèlement la forme réelle de la distribution).

    Lève TrajectoireSourisIndisponible (même exception que pour le clic/
    mousemove/scroll -- contrat d'échec explicite déjà en place) si la
    banque est vide ou trop petite (cf. MIN_INTERVALLES_FRAPPE_BANK)."""
    if bank is None:
        bank = _get_cached_typing_bank(db_path)
    if len(bank) < MIN_INTERVALLES_FRAPPE_BANK:
        raise TrajectoireSourisIndisponible(
            f"Banque d'intervalles de frappe insuffisante dans '{db_path}' : "
            f"{len(bank)} intervalle(s) exploitable(s), minimum requis="
            f"{MIN_INTERVALLES_FRAPPE_BANK}."
        )
    rng = np.random.default_rng(seed)
    return float(rng.choice(bank.intervalles_ms))


def _charger_banque_frappe_souris() -> "TypingBank":
    """Résout et met en cache (cf. _get_cached_typing_bank, invalidation
    par mtime) la banque d'intervalles de frappe réels depuis
    get_mouse_data_path() (Data/files/mouseData.sqlite3) -- même fichier
    que les banques de clic/trajectoire/scroll, table `keystrokes` au lieu
    de `clicks`/`positions`/`scrolls`. Lève TrajectoireSourisIndisponible
    avec un message explicite si le fichier n'existe pas encore ou si la
    banque ne contient pas assez d'intervalles exploitables (même contrat
    que _charger_banque_click_souris, réutilisé pour rester cohérent)."""
    chemin = get_mouse_data_path()
    if not chemin.is_file():
        raise TrajectoireSourisIndisponible(
            f"Aucune donnée de frappe trouvée : {chemin} n'existe pas. "
            "Enregistrez d'abord de la frappe réelle avec mouse_tracker.py "
            "(le fichier doit s'appeler mouseData.sqlite3 et se trouver "
            "dans Data/files/)."
        )
    try:
        bank = _get_cached_typing_bank(str(chemin))
    except Exception as exc:
        raise TrajectoireSourisIndisponible(
            f"Échec du chargement de la banque de frappe depuis {chemin} : {exc!r}"
        ) from exc
    if len(bank) < MIN_INTERVALLES_FRAPPE_BANK:
        raise TrajectoireSourisIndisponible(
            f"La base {chemin} ne contient pas assez d'intervalles de frappe "
            f"exploitables ({len(bank)}, minimum requis="
            f"{MIN_INTERVALLES_FRAPPE_BANK})."
        )
    return bank


def _charger_banque_scroll_souris() -> "ScrollBank":
    """Résout et met en cache (cf. _get_cached_scroll_bank, invalidation
    par mtime) la banque de rafales de scroll réelles depuis
    get_mouse_data_path() (Data/files/mouseData.sqlite3) -- même fichier
    que la banque de trajectoires, table `scrolls` au lieu de `positions`.
    Lève TrajectoireSourisIndisponible avec un message explicite si scipy
    n'est pas installé, si le fichier n'existe pas encore, ou si la banque
    ne contient aucune rafale exploitable (même contrat que
    _charger_banque_trajectoire_souris, réutilisé pour rester cohérent
    avec l'échec explicite déjà demandé pour mousemove/click)."""
    if not TRAJECTOIRE_SOURIS_DISPONIBLE:
        raise TrajectoireSourisIndisponible(
            "Génération de scroll humain indisponible : scipy n'est pas "
            "installé (pip install scipy)."
        )
    chemin = get_mouse_data_path()
    if not chemin.is_file():
        raise TrajectoireSourisIndisponible(
            f"Aucune donnée de mouvement de souris trouvée : {chemin} "
            "n'existe pas. Enregistrez d'abord des mouvements réels (avec "
            "scroll) avec mouse_tracker.py (le fichier doit s'appeler "
            "mouseData.sqlite3 et se trouver dans Data/files/)."
        )
    try:
        bank = _get_cached_scroll_bank(str(chemin))
    except Exception as exc:
        raise TrajectoireSourisIndisponible(
            f"Échec du chargement de la banque de scroll depuis {chemin} : {exc!r}"
        ) from exc
    if len(bank) == 0:
        raise TrajectoireSourisIndisponible(
            f"La base {chemin} ne contient aucune rafale de scroll exploitable "
            "(trop peu de scrolls enregistrés)."
        )
    return bank


# ---------------------------------------------------------------------------
# Branchement AutoniaX -- résout get_mouse_data_path() et gère l'échec
# explicite (base absente / pas assez de trajets exploitables), cf. demande
# utilisateur : "si generate_mouse_path échoue ... faire échouer l'action
# avec une erreur explicite" plutôt qu'un repli silencieux sur l'ancien
# comportement de saut instantané.
# ---------------------------------------------------------------------------

class TrajectoireSourisIndisponible(Exception):
    """Levée quand aucune trajectoire humaine ne peut être générée : scipy
    absent, fichier mouseData.sqlite3 introuvable, ou banque sans trajet
    exploitable (base vide / déplacements trop courts). Le mousemove
    Camoufox échoue explicitement plutôt que de retomber sur l'ancien
    comportement (saut instantané)."""
    pass


def _charger_banque_trajectoire_souris() -> "TrajectoryBank":
    """Résout et met en cache (cf. _get_cached_bank, invalidation par
    mtime) la banque de trajets réels depuis get_mouse_data_path()
    (Data/files/mouseData.sqlite3). Lève TrajectoireSourisIndisponible
    avec un message explicite si scipy n'est pas installé, si le fichier
    n'existe pas encore (aucune session enregistrée via mouse_tracker.py),
    ou si la banque ne contient aucun trajet exploitable."""
    if not TRAJECTOIRE_SOURIS_DISPONIBLE:
        raise TrajectoireSourisIndisponible(
            "Génération de trajectoire souris indisponible : scipy n'est "
            "pas installé (pip install scipy)."
        )
    chemin = get_mouse_data_path()
    if not chemin.is_file():
        raise TrajectoireSourisIndisponible(
            f"Aucune donnée de mouvement de souris trouvée : {chemin} "
            "n'existe pas. Enregistrez d'abord des mouvements réels avec "
            "mouse_tracker.py (le fichier doit s'appeler mouseData.sqlite3 "
            "et se trouver dans Data/files/)."
        )
    try:
        bank = _get_cached_bank(str(chemin))
    except Exception as exc:
        raise TrajectoireSourisIndisponible(
            f"Échec du chargement de la banque de trajectoires depuis "
            f"{chemin} : {exc!r}"
        ) from exc
    if len(bank) == 0:
        raise TrajectoireSourisIndisponible(
            f"La base {chemin} ne contient aucun trajet exploitable "
            "(trop peu de données enregistrées, ou déplacements trop courts)."
        )
    return bank


def _precharger_banques_mouvement_sync() -> None:
    """Construit et met en cache TrajectoryBank ET ScrollBank de façon
    SYNCHRONE (build() est CPU-bound : lecture SQLite complète, filtrage
    numpy/scipy, construction de KDTree -- cf. TrajectoryBank.build/
    ScrollBank.build) -- fonction volontairement dépourvue de tout `await`,
    faite pour être exécutée dans un thread séparé (cf.
    _precharger_banques_mouvement, asyncio.to_thread) et non directement
    dans la boucle asyncio, où ce même coût bloquerait la boucle événements
    le temps du calcul, exactement comme le premier mousemove/click/scroll
    réel le fait actuellement en l'absence de préchargement.

    Échecs AVALÉS volontairement (scipy absent, fichier introuvable, base
    vide) : un échec de préchargement ne doit jamais empêcher le démarrage
    de l'instance -- si la banque reste indisponible, action_mousemove/
    action_scroll (et leurs équivalents Camoufox) échoueront ou retomberont
    sur leur repli respectif exactement comme si ce préchargement n'avait
    jamais existé (cf. TrajectoireSourisIndisponible, repli explicite de
    action_scroll/action_camoufox_scroll)."""
    for nom, charger in (
        ("trajectoire souris", _charger_banque_trajectoire_souris),
        ("scroll souris", _charger_banque_scroll_souris),
    ):
        try:
            charger()
            log.info(f"Préchargement banque '{nom}' : OK.")
        except TrajectoireSourisIndisponible as exc:
            log.info(f"Préchargement banque '{nom}' : indisponible ({exc!r}) -- rien de cassé, chargement (ou repli) différé au premier usage réel.")
        except Exception as exc:
            log.warning(f"Préchargement banque '{nom}' : échec inattendu ({exc!r}) -- chargement différé au premier usage réel.")


async def _precharger_banques_mouvement() -> None:
    """Enveloppe async de _precharger_banques_mouvement_sync -- exécutée
    dans un thread à part (asyncio.to_thread) pour ne jamais bloquer la
    boucle événements de l'instance pendant le calcul (numpy/scipy ne
    relâchent pas le GIL en continu, un simple `await` ne suffirait pas à
    lui seul à éviter le gel de la boucle si le calcul restait sur le
    thread principal).

    Appelée en TÂCHE DE FOND (asyncio.create_task), PAS attendue avant la
    suite du démarrage (cf. _main_async/_main_async_camoufox) -- lancée en
    parallèle du lancement du navigateur (demarrer_navigateur /
    camoufox_demarrer_navigateur), pour que son coût soit absorbé pendant
    ce temps d'attente déjà existant plutôt que de s'additionner en série
    après. Si la première commande mousemove/click/scroll arrive AVANT que
    cette tâche de fond ait fini, elle attend simplement le résultat déjà
    en cours via le cache (_bank_cache/_scroll_bank_cache) comme
    auparavant -- ce préchargement est un GAIN DE LATENCE dans le cas
    courant (banque déjà prête au moment du premier geste), jamais une
    garantie stricte, et ne change donc rien au comportement si jamais il
    n'a pas eu le temps de finir."""
    await asyncio.to_thread(_precharger_banques_mouvement_sync)


