class _PontRaccourciGlobalArrierePlan(QObject):
    """Pont thread-safe entre le thread pynput (thread OS, hors event
    loop Qt) et le thread principal Qt -- pynput exécute ses callbacks
    dans son propre thread ; on ne peut pas y toucher aux widgets Qt
    directement. Un Signal Qt en Qt.QueuedConnection fait traverser
    proprement l'appel vers le thread Qt, même patron EXACT que
    _HotkeyBridge dans IngeniaXExplorer.py."""

    _declenche = Signal()

    def __init__(self, callback):
        super().__init__()
        self._callback = callback
        self._declenche.connect(self._executer, Qt.ConnectionType.QueuedConnection)

    def _executer(self):
        try:
            self._callback()
        except Exception:
            log.exception(
                "Erreur dans le callback du raccourci global "
                "\u00ab toujours_arriere_plan_toggle \u00bb"
            )

    def depuis_thread_pynput(self):
        """Appelé depuis le thread pynput -- programme l'exécution du
        callback dans le thread Qt via le signal ci-dessus."""
        self._declenche.emit()


def _normaliser_combo_vers_pynput(combo: str) -> Optional[str]:
    """Convertit un combo au format QKeySequence (ex: 'Ctrl+Shift+D')
    vers le format chaîne attendu par pynput.GlobalHotKeys (ex:
    '<ctrl>+<shift>+d') -- conversion simplifiée dédiée à ce seul
    raccourci (pas de gestion VK/layout indépendant façon
    _GlobalHotkeyManager.rebuild_listener de IngeniaXExplorer.py, qui
    gère un catalogue entier de combos : ici un seul combo, la
    correspondance pynput standard suffit). Retourne None si le combo
    est vide ou non convertible -- l'appelant doit alors renoncer à
    enregistrer le raccourci global plutôt que lever."""
    if not combo:
        return None
    SPECIAUX = {
        "ctrl": "<ctrl>", "control": "<ctrl>",
        "alt": "<alt>",
        "shift": "<shift>",
        "meta": "<cmd>", "win": "<cmd>", "windows": "<cmd>",
        "f1": "<f1>", "f2": "<f2>", "f3": "<f3>", "f4": "<f4>",
        "f5": "<f5>", "f6": "<f6>", "f7": "<f7>", "f8": "<f8>",
        "f9": "<f9>", "f10": "<f10>", "f11": "<f11>", "f12": "<f12>",
        "escape": "<esc>", "esc": "<esc>", "tab": "<tab>", "space": "<space>",
        "insert": "<insert>", "delete": "<delete>", "del": "<delete>",
        "home": "<home>", "end": "<end>",
        "pageup": "<page_up>", "pagedown": "<page_down>",
        "up": "<up>", "down": "<down>", "left": "<left>", "right": "<right>",
    }
    morceaux = [p.strip().lower() for p in combo.split("+") if p.strip()]
    if not morceaux:
        return None
    resultat = []
    for p in morceaux:
        resultat.append(SPECIAUX.get(p, p))
    return "+".join(resultat)


def _forcer_premier_plan_windows(fenetre: "QWidget") -> None:
    """Force `fenetre` au premier plan depuis un contexte SANS focus
    natif (callback pynput, thread OS) -- même technique EXACTE que
    IngeniaXExplorer._force_foreground : sous Windows,
    SetForegroundWindow() est bloqué par l'OS pour tout processus qui
    ne "possède" pas déjà le focus ; simuler un appui/relâchement de la
    touche Alt via keybd_event() débloque ce verrou juste avant l'appel.
    ShowWindow(SW_RESTORE) sort la fenêtre de l'état minimisé au niveau
    natif (nécessaire en plus du showNormal() Qt, cf. appelant). Sur
    toute plateforme non-Windows, ce hack n'a pas lieu d'être -- Qt
    seul (activateWindow) suffit, cf. appelant."""
    if sys.platform != "win32":
        return
    try:
        user32 = ctypes.windll.user32
        hwnd = int(fenetre.winId())
        SW_RESTORE = 9
        user32.ShowWindow(hwnd, SW_RESTORE)
        VK_MENU = 0x12
        KEYEVENTF_KEYUP = 0x0002
        user32.keybd_event(VK_MENU, 0, 0, 0)
        user32.keybd_event(VK_MENU, 0, KEYEVENTF_KEYUP, 0)
        user32.SetForegroundWindow(hwnd)
        user32.BringWindowToTop(hwnd)
    except Exception:
        pass


# ---------------------------------------------------------------------------
# Désactivation globale de "la molette change la valeur" sur les combos et
# spinbox. Comportement par défaut de Qt, très gênant dans une interface
# pleine de listes scrollables (QComboBox/QSpinBox/QDoubleSpinBox capturent
# l'événement de molette dès que la souris les survole et changent leur
# valeur au lieu de laisser l'événement remonter au parent) : ça empêchait
# de faire défiler la liste des Feature cards dès que la souris passait sur
# n'importe lequel de ces champs. On veut qu'à N'IMPORTE QUELLE position, la
# molette ne serve JAMAIS qu'à faire défiler l'interface — jamais à changer
# la valeur d'un champ sous le curseur. event.ignore() (au lieu de traiter
# l'événement) fait automatiquement remonter l'événement molette au widget
# parent (ici jusqu'au QListWidget/QScrollArea englobant), qui peut alors le
# traiter pour défiler.
def _ignorer_molette(self, event):
    event.ignore()


QComboBox.wheelEvent = _ignorer_molette
QSpinBox.wheelEvent = _ignorer_molette
QDoubleSpinBox.wheelEvent = _ignorer_molette


