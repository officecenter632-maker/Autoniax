def _icone_qta_premiere_disponible(noms: list, color):
    """CORRECTIF (toggle "bloquer médias" -- le bouton pouvait rester
    muet/incomplet selon la version de qtawesome installée) -- qta.icon()
    LÈVE une exception quand le nom d'icône demandé n'existe pas dans la
    police embarquée par la version de qtawesome présente sur la machine
    (les jeux MDI6 varient d'une version à l'autre : une icône ajoutée en
    amont n'est pas forcément dans un paquet plus ancien). Levée depuis
    paint(), cette exception interrompt le rendu de la carte EN COURS de
    route -- tout ce qui devait être peint après ne l'est plus.

    Essaie donc les noms fournis dans l'ordre et retourne la première
    icône réellement construite, ou None si aucune n'existe (l'appelant
    peint alors juste la pastille, sans glyphe -- dégradé visuel, jamais
    un rendu cassé ni une exception)."""
    for nom in noms:
        try:
            return qta.icon(nom, color=color)
        except Exception:
            continue
    return None


class ProfilsGridItemDelegate(QStyledItemDelegate):
    """Delegate de rendu dédié à liste_instances (cf. ProfilsInstancesScreen,
    patch "3 colonnes" -- #ProfilsGridList). Deux retours utilisateur
    traités ici :

    - "je veux que pour les profils actif il on des bordure vert" -- une
      vraie bordure verte par item ne peut pas se faire en QSS pur : le
      pseudo-état "actif" n'existe pas nativement sur QListWidgetItem (ce
      n'est pas un QWidget, donc aucun sélecteur de propriété dynamique
      QSS du type [actif="true"] n'est disponible dessus). Un delegate
      custom est la façon standard Qt de peindre différemment certains
      items selon une donnée du modèle, sans toucher au mécanisme sous-
      jacent (checkbox native, itemClicked, currentItem, itemAt --
      utilisés à de nombreux endroits de ProfilsInstancesScreen -- restent
      TOUS intacts, contrairement à un passage en setItemWidget() qui les
      aurait cassés).
    - "je veux aussi que on affiche la duree de chaque instance... un
      endroit un peu discret" -- petit texte gris sous le nom du profil,
      lu depuis DELEGATE_ROLE_DUREE.

    HAUTEUR DE LIGNE (point technique) : en IconMode, le rect que Qt
    donne à paint() (option.rect) suit la taille du CONTENU (le texte),
    pas la cellule de grille entière (gridSize gère l'espacement entre
    cellules, pas la hauteur de leur contenu -- vérifié empiriquement :
    sans le sizeHint() ci-dessous, option.rect restait cantonné à la
    hauteur d'une seule ligne de texte même avec un gridSize bien plus
    grand). sizeHint() ci-dessous ajoute EXTRA_HAUTEUR_DUREE de hauteur
    quand une durée doit s'afficher -- Qt agrandit alors option.rect
    d'autant, ce qui laisse la place de peindre le texte de durée juste
    sous le nom, dans paint().

    Ne fait QUE peindre/dimensionner -- la case à cocher, le fond hover/
    sélection et le texte principal restent gérés par
    QStyledItemDelegate (appelé en premier dans paint() ci-dessous), ce
    delegate rajoute juste la bordure verte et le texte de durée PAR-
    DESSUS. #ProfilsGridList::item conserve donc son style QSS existant
    (padding, arrondi, hover, sélection, cf. plus haut dans ce fichier)
    -- ce delegate ne le remplace pas, il le complète."""

    EXTRA_HAUTEUR_DUREE = 16  # px -- assez pour une ligne de petit texte (cf. paint)
    # PATCH (retour utilisateur explicite : "juse en bas de la ligne de
    # drapeau on met ladresse proxy, ladress ip" + "pas despace unitile
    # ... je dit en hauteur") -- la carte affiche maintenant QUATRE lignes
    # d'info compactes au lieu d'une seule "ligne badges" centrée dans un
    # grand vide (cf. ancien EXTRA_HAUTEUR_BADGES/rect_ligne_badges,
    # remplacés) :
    #   1. HAUTEUR_LIGNE_PAYS   : drapeau + statut/pays.
    #   2. HAUTEUR_LIGNE_IP     : IP publique détectée seule.
    #   3. HAUTEUR_LIGNE_PROXY  : IP + host:port du proxy configuré.
    #   4. HAUTEUR_LIGNE_BADGES : badges YouTube/TikTok/IA (cf. PATCH
    #      juste en dessous -- retirés de la ligne pays, où le badge
    #      YouTube seul était ancré à droite jusqu'ici).
    # Empilées directement sous le nom, SANS le centrage dans un gap
    # (l'espace libre du patch précédent est justement ce que l'utilisateur
    # demande de supprimer ici) -- cf. rect_bloc_infos ci-dessous, seule
    # source de vérité pour ces 4 rects.
    HAUTEUR_LIGNE_PAYS = 24  # px -- assez pour le drapeau 20px de haut + respiration
    HAUTEUR_LIGNE_IP = 16  # px -- simple ligne de texte, plus petite police
    HAUTEUR_LIGNE_PROXY = 16  # px -- idem
    # PATCH (retour utilisateur explicite : "enlève le badge youtube, tu
    # le mets sur une autre ligne en bas, en bas des données de l'adresse
    # ip, tu vas mettre 3 badges : youtube, tiktok, et un symbole de ia")
    # -- 4e ligne compacte, dédiée aux 3 icônes de réseaux/IA togglables
    # (cf. rect_badges_reseaux ci-dessous). Plus petite que
    # HAUTEUR_LIGNE_PAYS (qui doit accueillir le drapeau, 20px de haut) :
    # ici seulement des icônes carrées TAILLE_BADGE_RESEAU, alignées à
    # gauche comme le reste du bloc infos (pas ancrées à droite comme
    # l'était l'ancien badge YouTube seul sur la ligne pays -- avec 3
    # badges, un alignement à gauche reste lisible sans calcul de
    # position individuel par badge).
    HAUTEUR_LIGNE_BADGES = 22  # px -- icônes 18px + respiration verticale
    ESPACE_ENTRE_LIGNES_INFOS = 2  # px -- séparation minimale entre les lignes, volontairement serrée
    EXTRA_HAUTEUR_BADGES = (
        HAUTEUR_LIGNE_PAYS + HAUTEUR_LIGNE_IP + HAUTEUR_LIGNE_PROXY + HAUTEUR_LIGNE_BADGES
        + 3 * ESPACE_ENTRE_LIGNES_INFOS
    )  # px -- hauteur totale du bloc infos (4 lignes + 3 interlignes), conservé sous ce nom pour ne pas devoir retoucher tous ses appelants (sizeHint, _recalculer_grille_profils...)
    TAILLE_DRAPEAU_LARGEUR = 24
    TAILLE_DRAPEAU_HAUTEUR = 17
    TAILLE_BADGE_YOUTUBE = 24  # px -- CONSERVÉE (valeur historique) pour rect_bouton_youtube, ancienne API encore appelée par eventFilter -- cf. PATCH sur rect_bouton_youtube ci-dessous, qui délègue maintenant à rect_badges_reseaux
    TAILLE_BADGE_RESEAU = 18  # px -- icône seule, les 3 badges tiennent côte à côte sur HAUTEUR_LIGNE_BADGES sans se toucher
    ESPACE_ENTRE_BADGES_RESEAUX = 10  # px -- espace horizontal ENTRE deux badges consécutifs de la ligne 4
    # PATCH (retour utilisateur : "cest pas pro, cest pas bien diposer,
    # arrage bien") -- reprise complète de la géométrie de la ligne
    # d'actions (bas de carte) : marges désormais alignées sur le padding
    # QSS de la carte (#ProfilsGridList::item, padding: 8px 10px, cf. plus
    # haut dans ce fichier) plutôt que des marges arbitraires différentes
    # du texte au-dessus -- sans ça, boutons et texte de durée ne
    # tombaient pas sur la même ligne verticale, ce qui donnait un rendu
    # bricolé plutôt qu'une vraie carte structurée. Un fin séparateur
    # (cf. paint()) marque désormais la frontière entre la zone
    # texte/infos et la zone d'actions, comme une vraie carte à deux
    # zones plutôt que des boutons flottant en bas.
    MARGE_H = 10  # px -- identique au padding horizontal QSS de la carte
    TAILLE_BOUTON = 24
    MARGE_BOUTON = 6  # px -- espace ENTRE les deux boutons
    # CORRECTIF (retour utilisateur explicite : "sa ne fontionne pas, le
    # bouton ne peu pas etre cliquer") -- la zone de CLIC du bouton
    # "bloquer médias" est volontairement plus large que sa zone de
    # DESSIN, de cette marge sur les 4 côtés (cf.
    # rect_clic_bloquer_media). Un cercle de 24px de diamètre peint au
    # milieu d'une ligne de 3 boutons est une cible étroite : quelques
    # pixels de tolérance suffisent à rendre le bouton réellement
    # cliquable sans empiéter sur ses voisins (MARGE_BOUTON = 6px les
    # sépare, donc 4px de tolérance de chaque côté ne peuvent jamais
    # faire se chevaucher deux zones de clic consécutives).
    MARGE_CLIC_BOUTON = 4  # px
    MARGE_BAS_BOUTONS = 8  # px -- respiration entre le bas du bouton et le bord de la carte
    ESPACE_AU_DESSUS_BOUTONS = 10  # px -- respiration entre le séparateur et les boutons
    EXTRA_HAUTEUR_BOUTONS = (
        TAILLE_BOUTON + MARGE_BAS_BOUTONS + ESPACE_AU_DESSUS_BOUTONS
    )  # px -- ligne de boutons + ses deux marges (haut et bas)

    def __init__(self, parent=None):
        super().__init__(parent)
        # PATCH (retour utilisateur explicite, capture montrant des
        # cartes minuscules collées à gauche dans des cellules de grille
        # bien plus larges -- "cest encore statique") -- BUG RÉEL,
        # confirmé par mesure Qt offscreen (visualItemRect donnait 83px
        # de large pour une cellule de gridSize 281px) : sizeHint()
        # ci-dessous retournait taille.width() = super().sizeHint(...).width(),
        # c'est-à-dire la largeur NATIVE basée sur le texte du nom de
        # profil -- JAMAIS la largeur de cellule de grille (largeur_item,
        # calculée dans _recalculer_grille_profils). En IconMode, gridSize
        # gère l'ESPACEMENT entre cellules, mais sizeHint() du delegate
        # reste la taille RÉELLEMENT PEINTE de l'item À L'INTÉRIEUR de sa
        # cellule (même mécanisme que documenté pour la hauteur dans la
        # docstring de la classe, ci-dessus, mais jamais appliqué à la
        # largeur) -- d'où une "carte" visuelle petite et alignée à
        # gauche, avec un vide à droite jusqu'au bord de sa cellule.
        # self.largeur_cible_px : pilotée par ProfilsInstancesScreen.
        # _recalculer_grille_profils (setGridSize ET ce champ, TOUJOURS
        # ensemble) -- sizeHint() la retourne directement au lieu de
        # deviner depuis le texte. 0 tant que le premier recalcul n'a pas
        # eu lieu (cf. son propre garde-fou largeur_dispo <= 0) : dans ce
        # cas sizeHint() retombe sur le comportement natif, pour ne
        # jamais retourner une largeur de 0 avant la première mesure
        # réelle du viewport.
        self.largeur_cible_px = 0
        # PATCH (retour utilisateur explicite : "pourquoi tu na pas
        # augmeter leur hauteur ,idiot il faut doubler leur hautuer") --
        # MÊME BUG que largeur_cible_px ci-dessus, pour la hauteur cette
        # fois, confirmé par la même mesure Qt offscreen : gridSize disait
        # 116px de haut, visualItemRect en donnait seulement 74px. Cause :
        # sizeHint() (ci-dessous) recalculait SA PROPRE formule de hauteur
        # (taille.height() natif + EXTRA_HAUTEUR_BOUTONS + EXTRA_HAUTEUR_BADGES
        # [+ EXTRA_HAUTEUR_DUREE conditionnel]), qui ne correspond PAS à la
        # formule utilisée dans _recalculer_grille_profils pour hauteur_item
        # (mêmes constantes, mais base hauteur_ligne_nom=24 fixe au lieu
        # de taille.height() natif, PLUS une marge de respiration de 16px
        # absente ici) -- deux formules livrées séparément, jamais gardées
        # synchronisées. Comme pour largeur_cible_px : _recalculer_grille_profils
        # pose maintenant cette valeur en même temps que setGridSize, et
        # sizeHint() la retourne directement au lieu de recalculer sa
        # propre formule divergente -- gridSize et sizeHint utilisent
        # désormais LA MÊME SOURCE DE VÉRITÉ pour la hauteur, comme pour
        # la largeur.
        self.hauteur_cible_px = 0

    @classmethod
    def rect_bloc_infos(cls, option: QStyleOptionViewItem) -> dict:
        """PATCH (retour utilisateur explicite : "juse en bas de la ligne
        de drapeau on met ladresse proxy, ladress ip" + "pas despace
        unitile ... je dit en hauteur") -- remplace l'ancien
        _gap_vertical/rect_ligne_badges (qui CENTRAIENT une unique ligne
        badges dans tout l'espace libre entre le nom et le bloc boutons,
        créant le vide que l'utilisateur demande justement de supprimer
        ici). Calcule maintenant les 3 sous-rects du bloc infos (pays,
        ip, proxy -- cf. HAUTEUR_LIGNE_PAYS/IP/PROXY), empilés SANS
        espace superflu directement sous la zone nom (HAUTEUR_ZONE_NOM),
        peu importe la hauteur totale de la carte : l'espace en trop
        (carte agrandie) reste désormais en bas, entre ce bloc et le
        séparateur/boutons -- jamais entre les lignes elles-mêmes ni
        entre le nom et ce bloc, un bloc d'infos compact se lit mieux
        qu'un bloc étiré.

        Retourne {"pays": QRect, "ip": QRect, "proxy": QRect, "badges":
        QRect}, tous alignés sur la même largeur utile (MARGE_H de
        chaque côté) -- seule source de vérité pour ces 4 zones,
        réutilisée par paint() ET par tout hit-test (rect_bouton_youtube
        continue de dépendre de la ligne "pays" pour sa signature
        partagée avec les appelants existants, mais peint désormais sur
        "badges" -- cf. sa propre docstring ; "ip"/"proxy" restent de
        simple texte, non cliquables).

        PATCH (retour utilisateur explicite : "enlève le badge youtube,
        tu le mets sur une autre ligne en bas, en bas des données de
        l'adresse ip, tu vas mettre 3 badges : youtube, tiktok, et un
        symbole de ia") -- 4e ligne "badges", empilée directement sous
        "proxy" comme les 3 précédentes (cf. rect_badges_reseaux
        ci-dessous, qui positionne les 3 icônes À L'INTÉRIEUR de cette
        zone)."""
        HAUTEUR_ZONE_NOM = 28  # cf. HAUTEUR_ZONE_NOM_MAX dans initStyleOption/paint -- MÊME valeur, gardée en phase
        y = option.rect.top() + HAUTEUR_ZONE_NOM
        x = option.rect.x() + cls.MARGE_H
        largeur = option.rect.width() - 2 * cls.MARGE_H

        rect_pays = QRect(x, y, largeur, cls.HAUTEUR_LIGNE_PAYS)
        y += cls.HAUTEUR_LIGNE_PAYS + cls.ESPACE_ENTRE_LIGNES_INFOS
        rect_ip = QRect(x, y, largeur, cls.HAUTEUR_LIGNE_IP)
        y += cls.HAUTEUR_LIGNE_IP + cls.ESPACE_ENTRE_LIGNES_INFOS
        rect_proxy = QRect(x, y, largeur, cls.HAUTEUR_LIGNE_PROXY)
        y += cls.HAUTEUR_LIGNE_PROXY + cls.ESPACE_ENTRE_LIGNES_INFOS
        rect_badges = QRect(x, y, largeur, cls.HAUTEUR_LIGNE_BADGES)

        return {"pays": rect_pays, "ip": rect_ip, "proxy": rect_proxy, "badges": rect_badges}

    @classmethod
    def rect_bouton(cls, option: QStyleOptionViewItem, actif: bool, duree) -> QRect:
        """Zone (carrée) du bouton lancer/arrêter -- 1er bouton de la
        ligne du bas, calée sur la même marge gauche que le texte
        (MARGE_H, cohérente avec le padding QSS de la carte). Calculée
        UNE SEULE FOIS ici et réutilisée à l'identique par paint()
        (dessin) ET par ProfilsInstancesScreen.eventFilter() (hit-test au
        clic, cf. plus bas dans ce fichier) : les deux DOIVENT rester
        rigoureusement synchronisés, sinon la zone cliquable ne
        correspondrait plus à ce qui est visuellement dessiné.

        PATCH (retour utilisateur explicite : "les agrandir et les
        centrer dans le grand espace vide du milieu") -- `actif`/`duree` :
        conservés en paramètres (signature partagée avec rect_bouton_free
        et les appelants existants) mais plus utilisés pour un gap ici :
        les boutons restent désormais ANCRÉS au bord bas de la carte,
        position fixe indépendante de la hauteur de la carte -- c'est la
        zone badges/pays (cf. rect_ligne_badges) qui absorbe tout
        l'espace supplémentaire en se centrant au-dessus, pas les boutons
        qui remontent."""
        return QRect(
            option.rect.left() + cls.MARGE_H,
            option.rect.bottom() - cls.MARGE_BAS_BOUTONS - cls.TAILLE_BOUTON,
            cls.TAILLE_BOUTON,
            cls.TAILLE_BOUTON,
        )

    @classmethod
    def rect_bouton_free(cls, option: QStyleOptionViewItem, actif: bool, duree) -> QRect:
        """Zone du 2e bouton (Free -- force_unlink), juste À DROITE de
        rect_bouton ci-dessus, même ligne du bas, même principe de calcul
        partagé dessin/hit-test. MARGE_BOUTON entre les deux boutons en
        plus de la marge habituelle, pour qu'ils restent visuellement
        distincts au lieu de se toucher.

        PATCH (retour utilisateur explicite : "espacer nom/badges/boutons
        uniformément") -- `actif`/`duree` transmis tels quels à
        rect_bouton ci-dessus (cf. sa docstring) : les deux boutons
        doivent rester sur EXACTEMENT la même ligne, donc partager le
        même gap vertical."""
        base = cls.rect_bouton(option, actif, duree)
        return QRect(
            base.right() + cls.MARGE_BOUTON,
            base.top(),
            cls.TAILLE_BOUTON,
            cls.TAILLE_BOUTON,
        )

    @classmethod
    def rect_bouton_bloquer_media(cls, option: QStyleOptionViewItem, actif: bool, duree) -> QRect:
        """Zone du 3e bouton (toggle "bloquer médias" -- PATCH demande
        utilisateur explicite, bouton sur la ligne du bas à côté du
        bouton lancer/arrêter et du bouton Free), juste À DROITE de
        rect_bouton_free ci-dessus -- même principe de calcul partagé
        dessin/hit-test que rect_bouton/rect_bouton_free (cf. leurs
        docstrings), même ligne, même MARGE_BOUTON entre boutons
        consécutifs. `actif`/`duree` transmis tels quels à
        rect_bouton_free (donc in fine à rect_bouton) : les trois
        boutons doivent rester sur EXACTEMENT la même ligne."""
        base = cls.rect_bouton_free(option, actif, duree)
        return QRect(
            base.right() + cls.MARGE_BOUTON,
            base.top(),
            cls.TAILLE_BOUTON,
            cls.TAILLE_BOUTON,
        )

    @classmethod
    def rect_clic_bloquer_media(cls, option: QStyleOptionViewItem, actif: bool, duree) -> QRect:
        """CORRECTIF (retour utilisateur explicite : "le bouton ne peu
        pas etre cliquer") -- zone de CLIC du bouton "bloquer médias",
        égale à sa zone de dessin (rect_bouton_bloquer_media ci-dessus)
        élargie de MARGE_CLIC_BOUTON sur les 4 côtés.

        SÉPARÉE du rect de dessin volontairement : le dessin doit rester
        un cercle de TAILLE_BOUTON strictement aligné sur les deux autres
        boutons de la ligne, alors que la cible de clic a tout intérêt à
        être un peu plus généreuse (cf. MARGE_CLIC_BOUTON). C'est cette
        zone-ci, jamais celle de dessin, qu'utilise le hit-test de
        ProfilsInstancesScreen.eventFilter."""
        m = cls.MARGE_CLIC_BOUTON
        return cls.rect_bouton_bloquer_media(option, actif, duree).adjusted(-m, -m, m, m)

    @classmethod
    def rect_ligne_badges(cls, option: QStyleOptionViewItem, actif: bool, duree) -> QRect:
        """Zone complète (pleine largeur utile) de la ligne badges --
        proxy/pays à GAUCHE, badge YouTube ANCRÉ À DROITE (cf.
        rect_bouton_youtube ci-dessous). Toujours présente (cf.
        EXTRA_HAUTEUR_BADGES, non conditionnelle -- à la différence de la
        ligne durée juste en dessous, qui ne s'affiche que si actif+duree)
        -- empilée en partant du BAS de la carte, dans le même ordre que
        le reste du delegate (bas -> haut : boutons, puis durée si
        présente, puis cette ligne de badges, le nom occupant tout le
        reste au-dessus). `actif`/`duree` : mêmes valeurs que celles déjà
        lues par l'appelant (paint()/initStyleOption ci-dessus) --
        transmises plutôt que relues via `option` pour rester la SEULE
        source de vérité sur la présence de la ligne durée.

        PATCH (retour utilisateur explicite : "les agrandir et les
        centrer dans le grand espace vide du milieu") -- cette zone
        n'est plus juste décalée d'un gap fixe depuis le bloc boutons :
        elle est CENTRÉE verticalement dans tout l'espace libre entre le
        bas de la zone nom (HAUTEUR_ZONE_NOM, cf. _gap_vertical) et le
        haut du bloc boutons (EXTRA_HAUTEUR_BOUTONS [+ EXTRA_HAUTEUR_DUREE
        si actif+durée]). Sa propre hauteur (EXTRA_HAUTEUR_BADGES, agrandie
        pour accueillir drapeau/texte/YouTube plus grands) est soustraite
        de cet espace avant de centrer, pour qu'elle ne déborde ni sur le
        nom ni sur le séparateur/boutons même sur une carte à sa hauteur
        minimale (l'espace résiduel est alors nul ou négatif, cf. max()
        ci-dessous -- dans ce cas la zone se retrouve collée juste
        au-dessus des boutons, comportement de repli identique à avant ce
        patch)."""
        HAUTEUR_ZONE_NOM = 28  # cf. _gap_vertical -- MÊME valeur, gardée en phase
        hauteur_sous_badges = cls.EXTRA_HAUTEUR_BOUTONS
        if actif and duree:
            hauteur_sous_badges += cls.EXTRA_HAUTEUR_DUREE
        y_haut_bloc_boutons = option.rect.bottom() - hauteur_sous_badges
        y_bas_zone_nom = option.rect.top() + HAUTEUR_ZONE_NOM
        espace_disponible = y_haut_bloc_boutons - y_bas_zone_nom
        espace_residuel = max(espace_disponible - cls.EXTRA_HAUTEUR_BADGES, 0)
        y_zone_badges = y_bas_zone_nom + espace_residuel // 2
        return QRect(
            option.rect.x() + cls.MARGE_H,
            y_zone_badges,
            option.rect.width() - 2 * cls.MARGE_H,
            cls.EXTRA_HAUTEUR_BADGES,
        )

    @classmethod
    def rect_badges_reseaux(cls, option: QStyleOptionViewItem) -> dict:
        """Zones (carrées) des 3 badges togglables -- YouTube, TikTok,
        IA -- alignés à GAUCHE sur la ligne 4 du bloc infos (cf.
        rect_bloc_infos(option)["badges"]), côte à côte dans l'ordre
        YouTube -> TikTok -> IA, séparés par ESPACE_ENTRE_BADGES_RESEAUX.
        Calculée ici et réutilisée à l'identique par paint() ET par
        ProfilsInstancesScreen.eventFilter() (hit-test au clic) -- même
        principe que rect_bouton/rect_bouton_free ci-dessus : DOIT rester
        rigoureusement synchronisée entre les deux, sinon la zone
        cliquable ne correspondrait plus à ce qui est visuellement
        dessiné.

        PATCH (retour utilisateur explicite : "enlève le badge youtube,
        tu le mets sur une autre ligne en bas, en bas des données de
        l'adresse ip, tu vas mettre 3 badges : youtube, tiktok, et un
        symbole de ia") -- remplace l'ancien badge YouTube seul, ancré à
        droite de la ligne pays (cf. rect_bouton_youtube, qui délègue
        maintenant ici). Alignement à gauche choisi plutôt qu'un
        positionnement individuel par badge : avec 3 icônes côte à côte,
        un ancrage à gauche (comme le reste du bloc infos : pays/ip/proxy)
        reste lisible sans calcul de centrage particulier.

        Retourne {"youtube": QRect, "tiktok": QRect, "ia": QRect,
        "favori": QRect, "test": QRect}.

        PATCH (demande utilisateur explicite : onglet Favoris) -- 4e
        badge ajouté à la suite des trois existants, dans le même ordre
        côte à côte (youtube -> tiktok -> ia -> favori), même espacement
        ESPACE_ENTRE_BADGES_RESEAUX -- aucun changement de position pour
        les trois premiers badges, celui-ci s'ajoute simplement à droite
        du dernier.

        PATCH (demande utilisateur explicite : "tu vas rajouter le badge
        Test, comme il y a le badge youtube, tiktok") -- 5e badge, même
        principe, ajouté à la suite du favori."""
        ligne = cls.rect_bloc_infos(option)["badges"]
        cote = cls.TAILLE_BADGE_RESEAU
        y = ligne.top() + (ligne.height() - cote) // 2
        x = ligne.left()
        rects = {}
        for cle in ("youtube", "tiktok", "ia", "favori", "test"):
            rects[cle] = QRect(x, y, cote, cote)
            x += cote + cls.ESPACE_ENTRE_BADGES_RESEAUX
        return rects

    @classmethod
    def rect_bouton_youtube(cls, option: QStyleOptionViewItem, actif: bool, duree) -> QRect:
        """Zone (carrée) du badge YouTube togglable.
        `actif`/`duree` : conservés en paramètres (signature partagée
        avec les appelants existants -- eventFilter, _rafraichir_etats_
        boutons_liste_profils) mais plus utilisés ici.

        PATCH (retour utilisateur explicite : "enlève le badge youtube,
        tu le mets sur une autre ligne en bas ... tu vas mettre 3
        badges : youtube, tiktok, et un symbole de ia") -- délègue
        maintenant à rect_badges_reseaux (ligne 4 dédiée, alignée à
        gauche) au lieu de se positionner elle-même ancrée à droite de
        la ligne pays (ancien comportement, cf. historique ci-dessus
        dans les PATCH précédents de cette méthode). TAILLE_BADGE_YOUTUBE
        n'est plus utilisée ici (cf. TAILLE_BADGE_RESEAU dans
        rect_badges_reseaux) -- conservée comme constante pour ne pas
        casser d'éventuelles autres références, mais paint() calcule
        désormais `rect_texte_repli` avec TAILLE_BADGE_RESEAU (cf. PATCH
        dans paint(), la ligne pays n'a plus besoin de réserver de place
        pour un badge qui n'y est plus peint)."""
        return cls.rect_badges_reseaux(option)["youtube"]

