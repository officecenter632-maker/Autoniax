    /* --- Écran Works : grille (Patch 8) --- style partagé par
    ProjetBatchCarte et SousProjetCarte (même objectName réutilisé,
    cf. ces deux classes).
    PATCH (retour utilisateur : "recherche dans lapp les endroit qui on
    un style trop plat") -- même langage visuel que #ServiceAPICarteV2
    (dégradé subtil au lieu d'un aplat, bordure gauche en accent lavender
    au repos / mauve au survol) pour une cohérence avec l'écran ServiceAPI
    déjà refondu, plutôt que de garder l'ancien style plat ici. Bordure
    gauche à 2px seulement (au lieu de 3px sur ServiceAPICarteV2) : cette
    card est aussi utilisée par SousProjetCarte qui loge une QCheckBox
    tout contre le bord gauche (cf. header_row), un accent trop épais
    empiéterait visuellement dessus. */
    #ServiceAPICarte {{
        background: qlineargradient(x1:0, y1:0, x2:0, y2:1,
            stop:0 {m.surface0}, stop:1 {m.mantle});
        border: 1px solid {m.surface1};
        border-left: 2px solid {m.lavender};
        border-radius: {RADIUS}px;
    }}

    #ServiceAPICarte:hover {{
        background: qlineargradient(x1:0, y1:0, x2:0, y2:1,
            stop:0 {m.surface1}, stop:1 {m.surface0});
        border: 1px solid {m.mauve};
        border-left: 2px solid {m.mauve};
    }}

    #ServiceAPICarteNom {{
        color: {m.text};
        font-size: 14px;
        font-weight: 600;
    }}

    #ServiceAPICarteInfo {{
        color: {m.subtext0};
        font-size: 12px;
    }}

    /* --- Écran ServiceAPI : grille de cards, refonte demandée
    ("jaime absolument pas le desig de representation de Service API,
    rend sa plus moderne") -- objectName dédié (V2) pour ne PAS impacter
    ProjetBatchCarte/SousProjetCarte qui réutilisent le style ci-dessus.
    Dégradé subtil pour la profondeur (au lieu d'un aplat uni), coins
    plus généreusement arrondis (12px), et une bordure gauche colorée en
    accent (lavender au repos, mauve au survol) qui donne à la carte un
    "spine" identifiable -- signature visuelle distincte plutôt qu'un
    simple encadré plat. Le hover relève aussi légèrement le fond, pour
    suggérer une élévation sans vraie ombre portée (non supportée
    nativement par QSS sur QFrame). --- */
    #ServiceAPICarteV2 {{
        background: qlineargradient(x1:0, y1:0, x2:0, y2:1,
            stop:0 {m.surface0}, stop:1 {m.mantle});
        border: 1px solid {m.surface1};
        border-left: 3px solid {m.lavender};
        border-radius: 12px;
    }}

    #ServiceAPICarteV2:hover {{
        background: qlineargradient(x1:0, y1:0, x2:0, y2:1,
            stop:0 {m.surface1}, stop:1 {m.surface0});
        border: 1px solid {m.mauve};
        border-left: 3px solid {m.mauve};
    }}

    #ServiceAPICarteV2IconBadge {{
        background: qlineargradient(x1:0, y1:0, x2:1, y2:1,
            stop:0 {m.mauve}, stop:1 {m.blue});
        border: none;
        border-radius: 17px;
    }}

    #ServiceAPICarteV2IconBadgeIcon {{
        background: transparent;
        border: none;
    }}

    #ServiceAPICarteV2Nom {{
        background: transparent;
        color: {m.text};
        font-size: 15px;
        font-weight: 700;
    }}

    #ServiceAPICarteV2Info {{
        color: {m.crust};
        background-color: {m.subtext1};
        font-size: 11px;
        font-weight: 600;
        border-radius: 8px;
        padding: 2px 9px;
    }}

    /* --- Sous-onglet "Zone" de ComposantLayoutConfigScreen : grille de
    ZoneCarte (retour utilisateur explicite : "sa reseemble trop au card
    de serviceAPI, le super patron, ce qui est scandaleux ... l'icône me
    plaît mais change le design d'effet du card") -- rompt DÉLIBÉRÉMENT
    avec le langage #ServiceAPICarteV2 (carte carrée, dégradé de fond,
    badge en dégradé, bordure gauche accentuée) : fond PLAT uni (pas de
    dégradé), PAS de bordure gauche colorée, pastille icône de couleur
    UNIE (pas de dégradé mauve/blue) -- l'icône elle-même est conservée
    telle quelle, seul le traitement autour change. Carte HORIZONTALE
    compacte (icône à gauche, nom + statut empilés à droite) plutôt que
    verticale. Le statut devient un simple point coloré + texte (comme un
    indicateur de connexion/présence) plutôt qu'une pilule pleine vert/
    ambre. Seul élément qui reste : l'état sélectionné en contour plein
    couleur accent, nécessaire pour que la sélection reste repérable. --- */
    #ZoneCarte {{
        background-color: {m.surface0};
        border: 1px solid {m.surface1};
        border-radius: 8px;
    }}

    #ZoneCarte:hover {{
        background-color: {m.surface1};
        border: 1px solid {m.overlay0};
    }}

    #ZoneCarte[selectionnee="true"] {{
        background-color: {m.surface1};
        border: 2px solid {m.lavender};
    }}

    #ZoneCarteIconBadge {{
        background-color: {m.surface2};
        border: none;
        border-radius: 8px;
    }}

    #ZoneCarteIconBadgeIcon {{
        background: transparent;
        border: none;
    }}

    #ZoneCarteNom {{
        background: transparent;
        color: {m.text};
        font-size: 13px;
        font-weight: 700;
    }}

    #ZoneCartePoint {{
        border-radius: 3px;
    }}

    #ZoneCartePoint[tracee="true"] {{
        background-color: {m.green};
    }}

    #ZoneCartePoint[tracee="false"] {{
        background-color: {m.yellow};
    }}

    #ZoneCarteStatut {{
        background: transparent;
        color: {m.subtext0};
        font-size: 11px;
        font-weight: 500;
    }}

    /* --- Tuile "+ Ajouter une Zone" (ZoneCarteAjout) -- REFONTE (demande
    explicite, capture_002.png) : item de la même FlowGrid que #ZoneCarte,
    mais volontairement DISTINCT (bordure en tirets, fond transparent, pas
    de couleur accent) pour se lire comme une action d'ajout plutôt qu'une
    Zone existante. --- */
    #ZoneCarteAjout {{
        background-color: transparent;
        border: 1px dashed {m.surface2};
        border-radius: 8px;
    }}

    #ZoneCarteAjout:hover {{
        background-color: {m.surface0};
        border: 1px dashed {m.overlay0};
    }}

    #ZoneCarteAjoutTexte {{
        background: transparent;
        color: {m.subtext0};
        font-size: 13px;
        font-weight: 600;
    }}

