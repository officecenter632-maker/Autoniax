log_sequenceur_reseau = logging.getLogger("autoniax.sequenceur_reseau")

# ---------------------------------------------------------------------------
# [SYNC-DIAG] DIAGNOSTIC de latence de fin d'exécution sAutoniax -> mAutoniax
# (demande utilisateur : savoir QUI perd du temps entre la fin réelle d'un
# notebook sur un sAutoniax et l'actualisation du bouton de statut côté
# mAutoniax). Tous les logs portent le motif "[SYNC-DIAG]" (grep facile) :
#   [sAutoniax] FIN EXECUTEUR   : résultat reçu de l'exécuteur + réveil coroutine
#   [sAutoniax] ENVOI RESULTAT  : heure de fin, appel d'envoi, envoi WS effectif
#   [mAutoniax] RECEPTION       : heure de réception du message réseau
#   [mAutoniax] SLOT Qt         : heure d'arrivée sur le thread Qt (UI)
#   [mAutoniax] UI              : heure d'actualisation du bouton de statut
# ATTENTION : les écarts entre une heure sAutoniax et une heure mAutoniax
# dépendent de la synchronisation des horloges des deux machines (Kaggle vs
# PC local) -- indicatifs seulement ; les écarts MESURÉS SUR LA MÊME MACHINE
# (ex. réception -> slot Qt -> bouton) sont, eux, fiables.
# ---------------------------------------------------------------------------
log_sync_diag = logging.getLogger("autoniax.sync_diag")
log_sync_diag.setLevel(logging.INFO)
_SYNC_DIAG_DERNIERE: dict = {}  # enregistrement de la DERNIÈRE réception côté pilote


def _sync_diag_hms(ts) -> str:
    if ts is None:
        return "?"
    return datetime.fromtimestamp(ts).strftime("%H:%M:%S.%f")[:-3]


def _sync_diag_ecart(a, b) -> str:
    if a is None or b is None:
        return "?"
    return f"{(b - a) * 1000:+.0f} ms"


def _sync_diag_reception(session_id: str, ok, t_entree_msg: float, data: dict):
    """[mAutoniax] appelée dès que notebook_distant_resultat est décodé."""
    t_recep = time.time()
    h_fin = data.get("horodatage_fin")
    h_env = data.get("horodatage_envoi")
    _SYNC_DIAG_DERNIERE.clear()
    _SYNC_DIAG_DERNIERE.update({"session_id": session_id, "t_reception": t_recep, "t_slot": None, "ui": set(), "ok": ok})
    log_sync_diag.info(
        f"[SYNC-DIAG][mAutoniax] RECEPTION notebook_distant_resultat session={session_id!r} ok={ok!r} "
        f"| reçu à {_sync_diag_hms(t_recep)} "
        f"| (message entré dans _traiter_message à {_sync_diag_hms(t_entree_msg)}, décodage {_sync_diag_ecart(t_entree_msg, t_recep)}) "
        f"| fin exécution sAutoniax = {_sync_diag_hms(h_fin)} (écart fin->réception {_sync_diag_ecart(h_fin, t_recep)}) "
        f"| envoi WS sAutoniax = {_sync_diag_hms(h_env)} (écart envoi->réception {_sync_diag_ecart(h_env, t_recep)}) "
        f"[écarts inter-machines = indicatifs, cf. synchro des horloges]"
    )


def _sync_diag_slot(session_id: str):
    """[mAutoniax] appelée à l'entrée du slot Qt (thread UI)."""
    rec = _SYNC_DIAG_DERNIERE
    if rec.get("session_id") != session_id:
        return
    t = time.time()
    rec["t_slot"] = t
    log_sync_diag.info(
        f"[SYNC-DIAG][mAutoniax] SLOT Qt session={session_id!r} atteint à {_sync_diag_hms(t)} "
        f"| {_sync_diag_ecart(rec.get('t_reception'), t)} après la réception réseau (même machine : fiable)"
    )


def _sync_diag_marquer_ui(nom: str, detail: str = ""):
    """[mAutoniax] trace UNE FOIS par réception (et seulement si récente, < 30 s)
    l'heure à laquelle un élément d'interface a été actualisé."""
    rec = _SYNC_DIAG_DERNIERE
    t_recep = rec.get("t_reception")
    if t_recep is None or nom in rec["ui"]:
        return
    t = time.time()
    if t - t_recep > 30.0:
        return
    rec["ui"].add(nom)
    log_sync_diag.info(
        f"[SYNC-DIAG][mAutoniax] UI {nom} session={rec.get('session_id')!r} à {_sync_diag_hms(t)} "
        f"| {_sync_diag_ecart(t_recep, t)} après réception réseau, {_sync_diag_ecart(rec.get('t_slot'), t)} après slot Qt"
        f"{(' | ' + detail) if detail else ''}"
    )


# Dédié à vider_captures_dir() (cf. plus bas) -- défini ici, tôt dans le
# fichier, car cette fonction est appelée depuis main() bien avant que
# `log` générique (cf. logging.getLogger("autoniax.instance"), plus bas
# dans ce fichier, dédié au process "instance" séparé) n'existe -- même
# convention de nommage "autoniax.<domaine>" que les autres loggers de ce
# fichier.
log_captures = logging.getLogger("autoniax.captures")

# Seule constante survivante de l'ancien module Win32 retiré (cf. ci-dessus) :
# WHEEL_DELTA (120 unités par "cran" de molette) n'a rien de spécifique à
# Win32 en soi -- c'est juste la convention numérique historique reprise
# ici pour convertir "quantité de crans" (valeur saisie dans l'UI) en delta
# de scroll CDP, afin de garder le même sens qu'avant la migration
# nodriver/CDP (cf. _lancer_scroll ci-dessous).
WHEEL_DELTA = 120


class SequenceurActionReseau(QObject):
    """Seul séquenceur d'actions du projet -- même API publique
    (lancer(action, cx, cy, params), signal termine(), position_changee(x, y),
    clic_evenement(str)) que l'ancien SequenceurAction/module Win32 bas
    niveau (user32/gdi32, PostMessage, hwnd) qu'il remplaçait, MAIS ce
    dernier a depuis été intégralement retiré du code (cf. discussion :
    plus aucune fenêtre Windows locale comme cible d'exécution, uniquement
    nodriver/CDP). Les comparaisons "vs SequenceurAction"/"Win32" ci-dessous
    sont conservées à titre historique -- elles expliquent pourquoi certains
    choix ont été faits, mais SequenceurAction lui-même n'existe plus.

    Différences de fond avec l'ancien SequenceurAction (retiré), dictées par
    la nature réseau (cf. discussion, décisions actées) :
      - "double_clic"/"double_clic_droit" : un SEUL click(nb_clics=2)
        envoyé, pas deux clics espacés d'un délai calculé côté client --
        action_click (instance_nodriver.py) passe nb_clics tel quel à
        click_count CDP, qui gère nativement le timing interne du
        double-clic navigateur. obtenir_double_click_time_ms() (Win32,
        registre système, retiré avec le reste du module) n'a donc plus
        lieu d'être ici.
      - "saisir" -> une SEULE commande type_text(x, y, texte,
        delai_min_ms, delai_max_ms) (cf. instance_nodriver.py,
        action_type_text) -- toute la boucle et les délais entre
        caractères sont gérés côté instance, pas ici caractère par
        caractère.
      - "scroller" -> delta en PIXELS (deltaY), pas en "crans" WM_MOUSEWHEEL
        -- converti via WHEEL_DELTA (120, même convention que l'ancien
        envoyer_scroll/WM_MOUSEWHEEL, retirés) pour que la valeur saisie
        dans l'UI ("3 crans") garde le même sens qu'avant.
      - Chaque étape "réelle" (click, scroll, paste, type_text) ATTEND le
        command_result avant d'enchaîner (cf. docstring instance_nodriver.py :
        "un exécuteur séquentiel côté pilote a aussi besoin de savoir
        qu'un simple click/scroll est bien terminé avant d'enchaîner").
        Seul moveCursor reste fire-and-forget (pure animation visuelle du
        curseur virtuel, sans effet de bord sur la page -- attendre son
        command_result n'apporterait rien d'autre que de la latence entre
        chaque point de l'animation).
      - En cas d'échec réseau (command_result ok=False, ou timeout -- le
        pilote ne bloque jamais indéfiniment si l'instance ne répond
        plus, cf. TIMEOUT_COMMANDE_MS) : la séquence s'arrête et
        erreur_sequence(str) est émis, PLUTÔT que termine() -- pour que
        TestComposantScreen puisse distinguer un échec réseau/CDP d'une
        séquence normalement terminée (l'ancien SequenceurAction n'avait
        pas ce besoin, aucune commande ne pouvant "échouer" côté
        PostMessage local, fire-and-forget par nature)."""

    termine = Signal()
    erreur_sequence = Signal(str)
    position_changee = Signal(int, int)
    clic_evenement = Signal(str)

    NB_ETAPES_DEPLACEMENT = 12
    TIMEOUT_COMMANDE_MS = 8000  # au-delà, on considère l'instance/le réseau en défaut plutôt que d'attendre indéfiniment

    def __init__(self, client_reseau: "ClientReseauAutoniaX", instance_id: str,
                 largeur_fenetre: int, hauteur_fenetre: int, parent=None):
        super().__init__(parent)
        self.client_reseau = client_reseau
        self.instance_id = instance_id
        self.largeur_fenetre = max(1, largeur_fenetre)
        self.hauteur_fenetre = max(1, hauteur_fenetre)
        self._callbacks_en_attente: dict[str, callable] = {}
        self._timers_timeout: dict[str, QTimer] = {}
        self._arrete = False
        self.client_reseau.command_result_recu.connect(self._sur_command_result)

    # ------------------------------------------------------------------
    # Envoi de commande + corrélation par requete_id
    # ------------------------------------------------------------------
    def _envoyer_commande(self, action: str, extra: dict, puis_callback=None):
        """Envoie {"type": "command", "instance_id": ..., "action": ...,
        **extra} avec un requete_id unique. Si puis_callback est fourni,
        il sera appelé avec le dict command_result complet dès réception
        (ou avec {"ok": False, "error": "timeout"} si TIMEOUT_COMMANDE_MS
        est dépassé sans réponse -- l'instance a pu se déconnecter en
        cours de route, cf. NavigateurFerme côté instance_nodriver.py)."""
        if self._arrete:
            log_sequenceur_reseau.info(f"[{self.instance_id}] _envoyer_commande({action}) ignorée : séquenceur arrêté")
            return
        requete_id = uuid.uuid4().hex[:12]
        message = {
            "type": "command", "instance_id": self.instance_id,
            "action": action, "requete_id": requete_id, **extra,
        }
        log_sequenceur_reseau.info(
            f"[{self.instance_id}] _envoyer_commande({action!r}) requete_id={requete_id} "
            f"attend_callback={puis_callback is not None}"
        )
        if puis_callback is not None:
            self._callbacks_en_attente[requete_id] = puis_callback
            timer = QTimer(self)
            timer.setSingleShot(True)
            timer.timeout.connect(lambda: self._sur_timeout(requete_id))
            timer.start(self.TIMEOUT_COMMANDE_MS)
            self._timers_timeout[requete_id] = timer
        self.client_reseau.envoyer_commande(message)

    def _sur_command_result(self, data: dict):
        requete_id = data.get("requete_id")
        callback = self._callbacks_en_attente.pop(requete_id, None)
        if callback is None:
            log_sequenceur_reseau.debug(
                f"[{self.instance_id}] _sur_command_result() : requete_id={requete_id!r} "
                f"pas pour nous (autre séquence ou déjà expiré par timeout)"
            )
            return  # pas pour nous (autre séquence, ou déjà expiré par timeout)
        timer = self._timers_timeout.pop(requete_id, None)
        if timer is not None:
            timer.stop()
        log_sequenceur_reseau.info(
            f"[{self.instance_id}] _sur_command_result() : requete_id={requete_id!r} ok={data.get('ok')!r}"
        )
        callback(data)

    def _sur_timeout(self, requete_id: str):
        # LOG DIAGNOSTIC (bug "2e test qui bloque") : si ceci se déclenche,
        # l'instance n'a PAS répondu dans les TIMEOUT_COMMANDE_MS (8s) --
        # piste sérieuse pour une instance/onglet CDP planté ou déconnecté
        # en cours de séquence (cf. NavigateurFerme, instance_nodriver.py).
        log_sequenceur_reseau.warning(
            f"[{self.instance_id}] _sur_timeout() : requete_id={requete_id!r} -- "
            f"AUCUNE réponse de l'instance après {self.TIMEOUT_COMMANDE_MS}ms"
        )
        callback = self._callbacks_en_attente.pop(requete_id, None)
        self._timers_timeout.pop(requete_id, None)
        if callback is not None:
            callback({"ok": False, "error": "timeout : aucune réponse de l'instance"})

    def arreter(self):
        """Empêche tout nouvel envoi et toute résolution tardive de
        callback après arrêt (onglet fermé/test annulé en cours de
        séquence) -- cf. TestComposantScreen.arreter()."""
        log_sequenceur_reseau.info(
            f"[{self.instance_id}] arreter() : {len(self._callbacks_en_attente)} callback(s) en attente annulé(s)"
        )
        self._arrete = True
        for timer in self._timers_timeout.values():
            timer.stop()
        self._timers_timeout.clear()
        self._callbacks_en_attente.clear()
        try:
            self.client_reseau.command_result_recu.disconnect(self._sur_command_result)
        except (RuntimeError, TypeError):
            pass

    # ------------------------------------------------------------------
    def lancer(self, action: str, cx: int, cy: int, params: dict):
        if action == "positionner":
            self._lancer_deplacement(cx, cy, params, puis=self.termine.emit)
        elif action in ("clic_gauche", "clic_droit", "double_clic", "double_clic_droit"):
            bouton = "droit" if action in ("clic_droit", "double_clic_droit") else "gauche"
            nb_clics = 2 if action in ("double_clic", "double_clic_droit") else 1
            self._lancer_deplacement(
                cx, cy, params,
                puis=lambda: self._lancer_clic(cx, cy, bouton, nb_clics, params),
            )
        elif action == "scroller":
            self._lancer_scroll(cx, cy, params)
        elif action == "saisir":
            self._lancer_saisie(cx, cy, params)
        elif action == "coller":
            self._lancer_coller(cx, cy, params)
        elif action == "clear":
            self._lancer_clear(cx, cy, params)
        elif action == "drag":
            self._lancer_drag(cx, cy, params)
        else:
            self.termine.emit()

    # ------------------------------------------------------------------
    # Positionnement / clic
    # ------------------------------------------------------------------
    def _lancer_deplacement(self, cx: int, cy: int, params: dict, puis):
        depart_x = random.randint(0, self.largeur_fenetre - 1)
        depart_y = random.randint(0, self.hauteur_fenetre - 1)
        duree_ms = max(0, int(params.get("duree_deplacement_ms", 150)))
        nb_etapes = max(1, self.NB_ETAPES_DEPLACEMENT)
        intervalle = max(1, duree_ms // nb_etapes)

        def etape(i=1):
            if self._arrete:
                return
            if i >= nb_etapes:
                self._envoyer_commande("moveCursor", {"x": cx, "y": cy})
                self.position_changee.emit(cx, cy)
                puis()
                return
            t = i / nb_etapes
            x = round(depart_x + (cx - depart_x) * t)
            y = round(depart_y + (cy - depart_y) * t)
            self._envoyer_commande("moveCursor", {"x": x, "y": y})
            self.position_changee.emit(x, y)
            QTimer.singleShot(intervalle, lambda: etape(i + 1))

        self._envoyer_commande("moveCursor", {"x": depart_x, "y": depart_y})
        self.position_changee.emit(depart_x, depart_y)
        QTimer.singleShot(intervalle, lambda: etape(1))

    def _lancer_clic(self, cx: int, cy: int, bouton: str, nb_clics: int, params: dict):
        duree_clic_ms = max(0, int(params.get("duree_clic_ms", 60)))
        self.clic_evenement.emit("appui")

        def sur_resultat(data: dict):
            self.clic_evenement.emit("relachement")
            if data.get("ok"):
                self.termine.emit()
            else:
                self.erreur_sequence.emit(str(data.get("error", "échec du clic")))

        self._envoyer_commande(
            "click",
            {"x": cx, "y": cy, "bouton": bouton, "duree_appui_ms": duree_clic_ms, "nb_clics": nb_clics},
            puis_callback=sur_resultat,
        )

    # ------------------------------------------------------------------
    # Scroll
    # ------------------------------------------------------------------
    def _lancer_scroll(self, cx: int, cy: int, params: dict):
        """BRANCHEMENT scroll humanisé (ScrollBank/generate_scroll_events,
        cf. discussion) -- même principe que _lancer_deplacement/mousemove :
        UNE SEULE commande réseau transporte la quantité TOTALE demandée
        (targetDeltaX/targetDeltaY), et c'est l'instance (action_scroll,
        côté CDP) qui génère la rafale humanisée (bootstrap multi-sources
        sur les rafales réelles enregistrées) et la rejoue elle-même en
        respectant les délais -- au lieu de boucler ici cran par cran avec
        un aller-retour réseau par cran (ancien comportement, delta fixe
        WHEEL_DELTA, cadence programmée uniforme). La boucle "restant"
        d'avant a donc disparu d'ici : elle est maintenant côté instance,
        dans action_scroll (cf. sa docstring), exactement comme le trajet
        point-par-point de mousemove est rejoué dans action_mousemove et
        non ici.

        Le signe/l'axe restent inchangés : direction=-1 défile vers le bas
        OU vers la droite, direction=1 vers le haut OU la gauche (cf.
        TestActionScreen.DIRECTIONS_SCROLL_VERS_PARAMS) ; delta_total est en
        MÊMES UNITÉS que l'ancien delta_par_cran * quantite (WHEEL_DELTA=120
        par cran), pour que la quantité saisie dans l'UI ("3 crans") garde
        exactement le même sens/la même amplitude totale qu'avant ce
        branchement -- seule la façon dont cette quantité est débitée dans
        le temps change (rafale humanisée plutôt que crans égaux)."""
        direction = params.get("direction", -1)
        axe = params.get("axe", "y")  # "y" (haut/bas) ou "x" (gauche/droite)
        quantite = max(0, int(params.get("quantite_crans", 1)))
        frequence = max(0.1, float(params.get("frequence_crans_par_sec", 5.0)))
        speed_percent = float(params.get("speed_percent", 0))

        if quantite <= 0:
            self.termine.emit()
            return

        # Même convention que WHEEL_DELTA (Win32, ci-dessus) : 120 unités
        # par "cran", pour que la valeur saisie dans l'UI garde le même
        # sens qu'avant la migration (cf. docstring de la classe).
        delta_total = -direction * WHEEL_DELTA * quantite
        delta_x_total = delta_total if axe == "x" else 0.0
        delta_y_total = delta_total if axe == "y" else 0.0

        def sur_resultat(data: dict):
            if data.get("ok"):
                self.termine.emit()
            else:
                self.erreur_sequence.emit(str(data.get("error", "échec du scroll")))

        self._envoyer_commande(
            "scroll",
            {
                "x": cx, "y": cy,
                "targetDeltaX": float(delta_x_total), "targetDeltaY": float(delta_y_total),
                # cadence "de secours" : utilisée par action_scroll UNIQUEMENT
                # si generate_scroll_events échoue (banque indisponible) et
                # qu'un repli sur l'ancien envoi en crans réguliers a lieu --
                # cf. docstring action_scroll.
                "frequenceCransParSec": float(frequence),
                "speedPercent": speed_percent,
            },
            puis_callback=sur_resultat,
        )

    # ------------------------------------------------------------------
    # Saisie de texte -- une SEULE commande type_text (cf. docstring de
    # la classe), à la différence de SequenceurAction._lancer_saisie qui
    # boucle caractère par caractère côté client.
    # ------------------------------------------------------------------
    def _lancer_saisie(self, cx: int, cy: int, params: dict):
        texte = params.get("texte", "")
        delai_min = max(0, int(params.get("delai_min_ms", 60)))
        delai_max = max(delai_min, int(params.get("delai_max_ms", 180)))

        def sur_resultat(data: dict):
            if data.get("ok"):
                self.termine.emit()
            else:
                self.erreur_sequence.emit(str(data.get("error", "échec de la saisie")))

        self._envoyer_commande(
            "type_text",
            {"x": cx, "y": cy, "texte": texte, "delai_min_ms": delai_min, "delai_max_ms": delai_max},
            puis_callback=sur_resultat,
        )

    # ------------------------------------------------------------------
    # Collage presse-papier -- Ctrl+V sur le presse-papier VIRTUEL de
    # l'instance (action_paste côté serveur, corrigé pour ne plus toucher
    # le presse-papier système -- cf. etat_navigateur["presse_papier_virtuel"]),
    # distinct de _lancer_saisie/type_text qui tape caractère par
    # caractère. Pas de paramètre "texte" ici : le contenu collé est déjà
    # celui du presse-papier virtuel au moment de l'exécution.
    # ------------------------------------------------------------------
    def _lancer_coller(self, cx: int, cy: int, params: dict):
        def sur_resultat(data: dict):
            if data.get("ok"):
                self.termine.emit()
            else:
                self.erreur_sequence.emit(str(data.get("error", "échec du collage")))

        self._envoyer_commande(
            "paste",
            {"x": cx, "y": cy},
            puis_callback=sur_resultat,
        )

    # ------------------------------------------------------------------
    # Effacer -- sélectionne tout le contenu du composant de référence puis
    # l'efface (Ctrl+A + Suppr système, action_clear côté instance), en UNE
    # seule action banale plutôt que deux étapes séparées à enchaîner
    # manuellement (cf. discussion : l'utilisateur ne doit jamais avoir à
    # connaître/saisir de raccourci clavier). Même forme que _lancer_coller :
    # pas de paramètre "texte", un seul aller-retour réseau.
    # ------------------------------------------------------------------
    def _lancer_clear(self, cx: int, cy: int, params: dict):
        def sur_resultat(data: dict):
            if data.get("ok"):
                self.termine.emit()
            else:
                self.erreur_sequence.emit(str(data.get("error", "échec de l'effacement")))

        self._envoyer_commande(
            "clear",
            {"x": cx, "y": cy},
            puis_callback=sur_resultat,
        )

    # ------------------------------------------------------------------
    # Drag -- dépose un fichier local (Action.fichier_drag) sur l'input
    # file repéré à (x, y) côté serveur (cf. action_drag / DOM.setFileInputFiles).
    # Comme coller/type_text : un seul aller-retour réseau, pas de boucle
    # ni d'étapes intermédiaires côté client.
    # ------------------------------------------------------------------
    def _lancer_drag(self, cx: int, cy: int, params: dict):
        chemin_fichier = params.get("chemin_fichier", "")

        def sur_resultat(data: dict):
            if data.get("ok"):
                self.termine.emit()
            else:
                self.erreur_sequence.emit(str(data.get("error", "échec du drag")))

        self._envoyer_commande(
            "drag",
            {"x": cx, "y": cy, "chemin_fichier": chemin_fichier},
            puis_callback=sur_resultat,
        )


def tirer_point_aleatoire_zone(resultat: dict, action: "Action", composant: "Composant") -> tuple:
    """Tire un point ALÉATOIRE (pas le centre) dans la zone de clic
    effective d'une Action détectée, selon Action.zone_clic_mode :
      - "personnalise" : zone_clic_rect de l'ACTION elle-même (tracée via
        CoordonneeActionScreen), en coordonnées relatives au coin haut-
        gauche du composant à l'échelle 1.0 (donc remise à l'échelle de
        détection ci-dessous, comme dans TestComposantScreen._executer_action).
      - "par_defaut" (ou zone_clic_rect vide) : zone_clic_mode du COMPOSANT
        lui-même (composant.zone_clic_rect si "personnalise", sinon toute
        la surface détectée).
    Retourne (cx, cy) en coordonnées ÉCRAN de la fenêtre cible (mêmes
    coordonnées que resultat['x']/['y'], voir rechercher_composant_multi_variantes)."""
    echelle = resultat["echelle"]

    zone = None
    if action.zone_clic_mode == "personnalise" and action.zone_clic_rect and not action.zone_clic_rect.est_vide():
        zone = action.zone_clic_rect
    elif composant.zone_clic_mode == "personnalise" and not composant.zone_clic_rect.est_vide():
        zone = composant.zone_clic_rect

    if zone is not None:
        largeur = max(1, round(zone.largeur * echelle))
        hauteur = max(1, round(zone.hauteur * echelle))
        origine_x = resultat["x"] + round(zone.x * echelle)
        origine_y = resultat["y"] + round(zone.y * echelle)
    else:
        largeur = max(1, resultat["largeur"])
        hauteur = max(1, resultat["hauteur"])
        origine_x = resultat["x"]
        origine_y = resultat["y"]

    cx = origine_x + random.randint(0, largeur - 1)
    cy = origine_y + random.randint(0, hauteur - 1)
    return cx, cy


