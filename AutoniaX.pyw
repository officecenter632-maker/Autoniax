    # ------------------------------------------------------------------
    # Résolution du nom d'affichage d'un sAutoniax -- cf. InstancesConnecteesScreen
    # (même source Connexion.vers_dict, "id"/"nom"), tenue à jour par MainWindow
    # via le même signal executants_detail_change que l'onglet Instances.
    # ------------------------------------------------------------------

    def definir_executants_connus(self, executants: list):
        self._noms_executants = {e.get("id", ""): e.get("nom") or e.get("id", "") for e in executants if e.get("id")}
        # PATCH E.1 -- garde aussi le statut brut de chaque sAutoniax
        # connu (cf. Connexion.vers_dict côté serveurT : "inactif" /
        # "demarrage_profils" / "execution:<nom>" / "erreur", selon
        # l'implémentation exacte du champ "statut") -- nécessaire pour
        # la condition du bouton "Aperçu" (cf. _sur_clic_apercu_execution) :
        # "seulement si le sAutoniax cible est toujours actif" (E.1). Un
        # id_executant absent de ce dict (déconnecté) est traité comme
        # inactif par _sautoniax_toujours_actif ci-dessous.
        self._statuts_executants = {e.get("id", ""): e.get("statut", "") for e in executants if e.get("id")}
        # Un id_executant déjà utilisé dans une session existante peut
        # maintenant se résoudre en nom -- reconstruit les libellés sans
        # perdre l'état des sessions elles-mêmes.
        self._reconstruire_table()

    def _sautoniax_toujours_actif(self, id_executant: str) -> bool:
        """PATCH E.1 -- cf. docstring de definir_executants_connus.
        "toujours actif" = connu du serveurT (present dans le dernier
        executants_detail_change reçu) ET son statut n'est pas
        "inactif" -- un sAutoniax connecté mais qui n'exécute plus rien
        (déconnexion du batch en cours, redémarrage manuel, etc.) ne
        doit pas laisser croire qu'un aperçu est encore possible."""
        statut = getattr(self, "_statuts_executants", {}).get(id_executant)
        return statut is not None and statut != "inactif"

    # ------------------------------------------------------------------
    # Slots réseau -- cf. docstring de classe pour la source de chaque
    # signal (branché par MainWindow).
    # ------------------------------------------------------------------

    def sur_envoi_demande(self, id_executant: str, id_projet_batch: str, chemin_racine: str, nom_projet: str, session_id: str):
        """PATCH -- Option A validée : ProjetBatchScreen.demande_envoi_
        projet_sautoniax ne porte pas de session_id (il n'existe pas
        encore à ce stade, généré par ClientServeurT au moment de l'appel
        réseau) -- cf. MainWindow._sur_demande_envoi_projet_sautoniax qui
        fait le pont et appelle cette méthode avec le session_id résultant,
        pour que la ligne apparaisse dès le lancement de l'envoi (spec
        §4.4.b : "une session apparaît dès demande_envoi_projet_sautoniax")."""
        nom_executant = getattr(self, "_noms_executants", {}).get(id_executant, id_executant)
        self._sessions[session_id] = {
            "id_executant": id_executant, "nom_executant": nom_executant,
            "id_projet_batch": id_projet_batch, "chemin_racine": chemin_racine, "nom_projet": nom_projet,
            "statut": "envoi", "total": 0, "traites": 0, "en_echec": 0, "restants": 0,
            "statuts_sous_projets": [], "chemin_dossier_recu": None, "recupere": False,
            # "" par défaut -- distingue un envoi mono-projet (jamais
            # rattaché à un batch) d'un ProjetBatch envoyé dans le cadre
            # d'un BatchDistribue (cf. sur_envoi_demande_batch ci-dessous,
            # seule à passer une valeur non vide ici).
            "id_batch_distribue": "",
            # PATCH E.1 -- {nom_profil: instance_id}, vide tant que
            # sur_instances_recues n'a pas reçu la table réelle depuis le
            # sAutoniax (cf. ClientServeurT.instances_projet_recu). Le
            # bouton "Aperçu" par sous-projet (colonne Actions) reste
            # désactivé tant que ce dict est vide pour la session.
            "instances_par_profil": {},
        }
        self._reconstruire_table()

    def sur_envoi_demande_batch(
        self, id_executant: str, id_batch_distribue: str, session_id: str, id_projet_batch: str, nom_projet: str,
    ):
        """PATCH E (E.4 -- pendant multi-projets de sur_envoi_demande
        ci-dessus, cf. ClientServeurT.envoi_batch_projet_demarre). Un
        appel par ProjetBatch du batch, dans l'ordre du séquencement
        réel (pas tous en même temps -- cf. docstring du signal : émis
        au moment où CHAQUE ProjetBatch commence réellement à être
        envoyé, pas au moment où le batch entier est demandé). Chaque
        ProjetBatch garde sa propre ligne dans la table (même
        granularité qu'un envoi mono-projet, cf. sur_envoi_demande),
        avec en plus id_batch_distribue pour pouvoir les identifier
        comme appartenant au même batch (regroupement visuel éventuel,
        pas encore fait dans ce patch -- cf. _reconstruire_table,
        inchangée pour l'instant).

        `chemin_racine` n'est pas porté par ce signal (contrairement à
        sur_envoi_demande) -- jamais lu ailleurs dans _sessions (cf. sa
        construction ci-dessus, gardé seulement par cohérence avec le
        modèle d'un envoi mono-projet)."""
        self.sur_envoi_demande(id_executant, id_projet_batch, "", nom_projet, session_id)
        self._sessions[session_id]["id_batch_distribue"] = id_batch_distribue
        self._reconstruire_table()

    def sur_resultat_envoi(self, ok: bool, session_id: str, message: str):
        session = self._sessions.get(session_id)
        if session is None:
            return
        session["statut"] = "en_cours" if ok else "echec_envoi"
        if not ok:
            session["message_erreur"] = message
        self._reconstruire_table()
        nom_projet = session.get("nom_projet", "")
        nom_executant = session.get("nom_executant", "")
        if ok:
            texte = f"Projet '{nom_projet}' envoyé à '{nom_executant}' -- exécution démarrée."
        else:
            texte = f"Échec d'envoi du projet '{nom_projet}' à '{nom_executant}' : {message}"
        self.resultat_envoi_confirme.emit(ok, texte)

    def sur_progression_recue(
        self, session_id: str, id_executant: str, total: int, traites: int, en_echec: int, restants: int,
        statuts_sous_projets: list,
    ):
        session = self._sessions.get(session_id)
        if session is None:
            # Progression reçue pour une session envoyée avant un
            # redémarrage de l'écran (ou toute autre perte d'état côté
            # pilote) -- reconstitue une ligne minimale plutôt que de
            # perdre silencieusement l'information, même philosophie
            # défensive que sur_resultat_liste_stockage (jamais bloquant).
            nom_executant = getattr(self, "_noms_executants", {}).get(id_executant, id_executant)
            session = self._sessions[session_id] = {
                "id_executant": id_executant, "nom_executant": nom_executant,
                "id_projet_batch": "", "chemin_racine": "", "nom_projet": "(projet distant)",
                "statut": "en_cours", "total": 0, "traites": 0, "en_echec": 0, "restants": 0,
                "statuts_sous_projets": [], "chemin_dossier_recu": None, "recupere": False,
                "id_batch_distribue": "",
                # PATCH E.1 -- cf. sur_envoi_demande pour la docstring
                # complète. Même valeur par défaut ici : une session
                # reconstituée défensivement (progression arrivée avant
                # sur_envoi_demande, ex. après un redémarrage de l'écran)
                # n'a pas encore reçu sa table d'instances -- le bouton
                # "Aperçu" reste désactivé jusqu'à sur_instances_recues.
                "instances_par_profil": {},
            }
        session["statut"] = "en_cours"
        session["total"] = total
        session["traites"] = traites
        session["en_echec"] = en_echec
        session["restants"] = restants
        session["statuts_sous_projets"] = statuts_sous_projets
        self._reconstruire_table()
        if session_id == self._session_selectionnee:
            self._rafraichir_detail(session_id)

    def sur_retour_recu(self, session_id: str, id_executant: str, chemin_dossier_recu: str):
        session = self._sessions.get(session_id)
        if session is None:
            return
        session["chemin_dossier_recu"] = chemin_dossier_recu
        # Échec partiel = au moins un sous-projet en échec parmi ceux
        # traités -- sinon Terminé (succès complet, ou aucune progression
        # n'a jamais été reçue -- cf. §4.4.c : un échec de démarrage des
        # profils renvoie directement un retour, sans jamais émettre de
        # projet_distant_progression, session["en_echec"] reste alors à 0
        # par défaut : traité comme "Terminé" ici, l'erreur elle-même est
        # visible via erreur_sautoniax.txt/annule_sautoniax.txt dans le
        # dossier reçu, hors scope de cette table de compteurs).
        session["statut"] = "echec_partiel" if session.get("en_echec", 0) > 0 else "termine"
        # PATCH E.1 -- une fois le batch terminé, les profils qu'il avait
        # ouverts sont fermés côté sAutoniax (cf. cahier des charges,
        # E.6 point 1 : "nettoyage post-exécution"). Les instance_id
        # connus pour cette session sont donc désormais périmés -- vider
        # la table évite que le bouton "Aperçu" reste actif sur une
        # instance qui n'existe plus (_sautoniax_toujours_actif seul ne
        # suffirait pas : le sAutoniax peut rester "actif" au sens
        # connecté tout en ayant fermé CE profil précis).
        session["instances_par_profil"] = {}
        self._reconstruire_table()
        if session_id == self._session_selectionnee:
            self._rafraichir_detail(session_id)

    def sur_instances_recues(self, session_id: str, id_executant: str, instance_id_par_profil: dict):
        """PATCH E.1 (cf. cahier des charges patchs.md, section E.1) --
        connecté par MainWindow à ClientServeurT.instances_projet_recu
        (cf. sa docstring pour le POURQUOI de ce message dédié). Reçu une
        fois que le sAutoniax ciblé a confirmé avoir démarré tous les
        profils du projet -- avant ça, `instances_par_profil` reste vide
        pour cette session (cf. sur_envoi_demande) et le bouton "Aperçu"
        de chaque sous-projet reste désactivé (rien à cibler).

        id_executant n'est utile ici que défensivement (vérifie qu'on ne
        vient pas d'écraser une table d'instances avec celle d'un AUTRE
        sAutoniax pour la même session_id -- ne devrait jamais arriver
        côté protocole, mais on ne fait pas confiance à l'ordre
        d'arrivée réseau, même prudence que sur_progression_recue)."""
        session = self._sessions.get(session_id)
        if session is None:
            # Même repli défensif que sur_progression_recue -- une table
            # d'instances peut arriver avant sur_envoi_demande dans de
            # rares cas de perte d'état côté pilote (redémarrage de
            # l'écran). Reconstitue une ligne minimale plutôt que de
            # perdre l'info : au pire une ligne incomplète apparaît,
            # jamais une exception.
            nom_executant = getattr(self, "_noms_executants", {}).get(id_executant, id_executant)
            session = self._sessions[session_id] = {
                "id_executant": id_executant, "nom_executant": nom_executant,
                "id_projet_batch": "", "chemin_racine": "", "nom_projet": "(projet distant)",
                "statut": "en_cours", "total": 0, "traites": 0, "en_echec": 0, "restants": 0,
                "statuts_sous_projets": [], "chemin_dossier_recu": None, "recupere": False,
                "id_batch_distribue": "",
            }
        if session.get("id_executant") and session["id_executant"] != id_executant:
            return
        session["instances_par_profil"] = dict(instance_id_par_profil)
        self._reconstruire_table()

    # ------------------------------------------------------------------
    # Reconstruction UI
    # ------------------------------------------------------------------

    def _texte_resultat(self, session: dict) -> str:
        """PATCH E.3 (cf. cahier des charges patchs.md, section E.3) --
        colonne "Résultat" unique remplaçant les 3 anciennes colonnes
        Traités/En échec/Restants :
        - "En attente" (statut "envoi") ou "Échec d'envoi" -> aucune
          exécution n'a eu lieu, donc AUCUN compteur -- "—", pas "0
          succès / 0 échec" qui laisserait croire à une exécution vide.
        - "En exécution" -> compteur succès/échec mis à jour en continu
          (traites = succès, en_echec = échecs), plus le nombre restant
          entre parenthèses (information utile pendant que ça tourne,
          disparaît une fois terminé -- cf. cahier des charges : "mis à
          jour en continu" ne précise pas explicitement les restants,
          mais cette info était déjà affichée avant ce patch et reste
          pertinente tant que le batch n'est pas fini).
        - "Terminé" -> compteur final succès/échec, sans "restants"
          (toujours 0 à ce stade, redondant à afficher)."""
        statut = session.get("statut", "")
        if statut in ("envoi", "echec_envoi"):
            return "—"
        traites = session.get("traites", 0)
        en_echec = session.get("en_echec", 0)
        if statut == "en_cours":
            restants = session.get("restants", 0)
            return f"{traites} succès / {en_echec} échec(s) ({restants} restant(s))"
        # "termine" / "echec_partiel"
        return f"{traites} succès / {en_echec} échec(s)"

    def _reconstruire_table(self):
        id_selectionne_avant = self._session_selectionnee
        self.table_sessions.setSortingEnabled(False)
        self.table_sessions.clear()
        for session_id, session in sorted(
            self._sessions.items(), key=lambda kv: kv[1].get("nom_projet", ""),
        ):
            item = QTreeWidgetItem()
            item.setText(0, session.get("nom_executant", ""))
            item.setText(1, session.get("nom_projet", ""))
            item.setText(2, self._LIBELLES_STATUT_GLOBAL.get(session.get("statut", ""), session.get("statut", "")))
            item.setText(3, self._texte_resultat(session))
            item.setData(0, Qt.UserRole, session_id)
            self.table_sessions.addTopLevelItem(item)
            self.table_sessions.setItemWidget(
                item, 4, self._construire_widget_actions_ligne(session_id, session)
            )
            if session_id == id_selectionne_avant:
                item.setSelected(True)
        self.table_sessions.setSortingEnabled(True)
        for i in range(4):
            self.table_sessions.resizeColumnToContents(i)

    def _profil_en_cours_pour_apercu(self, session: dict) -> Optional[tuple]:
        """PATCH E.1 -- résout, pour UNE session, le premier couple
        (nom_profil, instance_id) exploitable pour ouvrir un aperçu, ou
        None si aucun n'est disponible. cf. cahier des charges, condition
        exacte : "seulement si le sAutoniax cible est toujours actif ET
        que le profil associé est toujours en cours d'exécution".

        Dans ce modèle (E.4, un batch = plusieurs projets séquentiels,
        chacun potentiellement multi-profils), "le profil associé" à une
        LIGNE de la table (qui représente un projet entier, pas un seul
        sous-projet) est ambigu au sens strict -- on retient ici le
        premier profil encore réellement actif parmi ceux du projet
        courant (instances_par_profil, peuplé par sur_instances_recues),
        ce qui correspond à l'usage réel : voir CE qui tourne
        actuellement sur ce sAutoniax pour ce projet. Un aperçu par
        SOUS-projet précis (plusieurs boutons par ligne) serait plus
        fidèle à la notion de "profil associé" mais n'est pas ce que la
        table actuelle (une ligne par projet, pas par sous-projet)
        permet d'exposer proprement -- cf. section détail (FlowGrid des
        sous-projets) pour le suivi fin par sous-projet, hors scope de ce
        bouton."""
        instances = session.get("instances_par_profil") or {}
        if not instances:
            return None
        # Ordre déterministe (premier profil par ordre alphabétique) --
        # peu importe lequel tant que c'est stable d'un rafraîchissement
        # à l'autre (évite un bouton qui semble "sauter" entre plusieurs
        # cibles sans raison visible pour l'utilisateur).
        nom_profil = sorted(instances.keys())[0]
        return nom_profil, instances[nom_profil]

    def _apercu_disponible(self, session: dict) -> bool:
        """PATCH E.1 -- condition d'activation du bouton "Aperçu" (cf.
        cahier des charges, E.1) : le sAutoniax cible est toujours actif
        ET le profil associé est toujours en cours d'exécution. "En
        cours d'exécution" se lit ici comme session["statut"] ==
        "en_cours" (signal local le plus fiable, cf. session de travail
        précédente qui a tranché ce point -- pas besoin d'un aller-retour
        serveur supplémentaire, sur_progression_recue/sur_retour_recu
        maintiennent déjà ce champ à jour en direct) ET la présence d'au
        moins une instance encore réellement démarrée pour ce projet."""
        if session.get("statut") != "en_cours":
            return False
        if not self._sautoniax_toujours_actif(session.get("id_executant", "")):
            return False
        return self._profil_en_cours_pour_apercu(session) is not None

    def _construire_widget_actions_ligne(self, session_id: str, session: dict) -> QWidget:
        """PATCH E.1 -- même patron que InstancesConnecteesScreen.
        _construire_widget_actions_ligne (cf. sa docstring) : petit
        widget posé via setItemWidget sur la colonne "Actions" de CETTE
        ligne, reconstruit à chaque appel de _reconstruire_table (pas de
        réutilisation d'instance entre deux rafraîchissements)."""
        conteneur = QWidget()
        ligne = QHBoxLayout(conteneur)
        ligne.setContentsMargins(4, 2, 4, 2)
        ligne.setSpacing(4)

        disponible = self._apercu_disponible(session)
        bouton_apercu = QToolButton(conteneur)
        bouton_apercu.setIcon(qta.icon("mdi6.monitor-eye", color=Mocha.text if disponible else Mocha.overlay0))
        bouton_apercu.setToolTip(
            "Aperçu -- ouvre le rendu de l'instance en cours d'exécution."
            if disponible else
            "Aperçu indisponible -- le sAutoniax n'est plus actif ou aucun "
            "profil de ce projet n'est actuellement en cours d'exécution."
        )
        bouton_apercu.setEnabled(disponible)
        bouton_apercu.setAutoRaise(True)
        bouton_apercu.clicked.connect(lambda: self._sur_clic_apercu_execution(session_id))
        ligne.addWidget(bouton_apercu)

        ligne.addStretch(1)
        return conteneur

    def _sur_selection_changee(self):
        items = self.table_sessions.selectedItems()
        if not items:
            self._session_selectionnee = None
            self.bloc_detail.setVisible(False)
            return
        session_id = items[0].data(0, Qt.UserRole)
        self._session_selectionnee = session_id
        self.bloc_detail.setVisible(True)
        self._rafraichir_detail(session_id)

    def _rafraichir_detail(self, session_id: str):
        session = self._sessions.get(session_id)
        if session is None:
            return
        self.label_titre_detail.setText(f"Détail -- {session.get('nom_projet', '')} ({session.get('nom_executant', '')})")
        self.bouton_recuperer_local.setEnabled(
            session.get("statut") in ("termine", "echec_partiel")
            and bool(session.get("chemin_dossier_recu"))
            and not session.get("recupere", False)
        )
        self.flow_grid_detail.clear()
        for numero, statut in sorted(session.get("statuts_sous_projets", [])):
            self.flow_grid_detail.add_item(SousProjetCarte.creer_lecture_seule(numero, statut, self.flow_grid_detail))

    def _sur_clic_recuperer_local(self):
        if self._session_selectionnee is None:
            return
        session = self._sessions.get(self._session_selectionnee)
        if session is None or not session.get("chemin_dossier_recu"):
            return
        self.demande_recuperation_locale.emit(
            self._session_selectionnee, session.get("id_projet_batch", ""), session["chemin_dossier_recu"],
        )
        session["recupere"] = True
        self._rafraichir_detail(self._session_selectionnee)

    # ------------------------------------------------------------------
    # PATCH E.1 -- panneau de rendu d'instance (cf. section B du cahier
    # des charges pour le panneau lui-même, réutilisé tel quel via
    # FenetreRenduTaskReseau, même composant que TaskConfigScreen). Ce
    # bloc reproduit le patron de TaskConfigScreen._sur_clic_voir_rendu_
    # reseau, avec UNE différence structurelle : là où TaskConfigScreen
    # résout sa cible via le profil actif du panneau clone (un seul
    # sAutoniax à la fois, mode mono-profil), ici la cible
    # (id_executant, instance_id) est déterminée par LA LIGNE cliquée
    # (plusieurs lignes possibles, mode multi-instances) -- donc figée à
    # l'ouverture plutôt que résolue à chaque émission de signal.
    # ------------------------------------------------------------------

    def _sur_clic_apercu_execution(self, session_id: str):
        session = self._sessions.get(session_id)
        if session is None:
            return
        if not self._apercu_disponible(session):
            # Condition E.1 non remplie au moment du clic (a pu changer
            # entre le rafraîchissement de la table et le clic, ex.
            # sAutoniax déconnecté entre-temps) -- message d'erreur dans
            # la barre de statut, PAS d'ouverture de panneau (cf. cahier
            # des charges : "Sinon : message d'erreur dans la barre de
            # statut"), même canal que resultat_envoi_confirme.
            nom_projet = session.get("nom_projet", "")
            self.resultat_envoi_confirme.emit(
                False,
                f"Aperçu indisponible pour '{nom_projet}' -- le sAutoniax n'est plus actif "
                "ou aucun profil de ce projet n'est actuellement en cours d'exécution.",
            )
            return
        resolu = self._profil_en_cours_pour_apercu(session)
        if resolu is None:
            return  # Ne devrait pas arriver (_apercu_disponible vient de confirmer), garde-fou silencieux.
        nom_profil, instance_id = resolu
        id_executant = session.get("id_executant", "")

        if self._fenetre_rendu_reseau is None:
            self._fenetre_rendu_reseau = FenetreRenduTaskReseau(self)
            self._fenetre_rendu_reseau.fermeture_demandee.connect(self._sur_fermeture_rendu_reseau)
            self._fenetre_rendu_reseau.demande_rafraichissement.connect(self._sur_demande_rafraichissement_rendu_reseau)
            self._fenetre_rendu_reseau.taux_capture_change.connect(self._sur_taux_capture_reseau_change)
            # PATCH B.3 -- réglages compression/qualité visibles ici
            # aussi (même patron que TaskConfigScreen -- decision
            # explicite utilisateur : "dans le panneau de rendue"), câblé
            # vers ClientServeurT.definir_preference_capture VIA
            # MainWindow (ce widget n'a pas de référence directe au
            # client réseau, cf. docstring de classe -- "les écrans
            # réseau ne font que relayer, jamais de connexion directe au
            # client réseau"). Pas de persistance ReglagesApp ici
            # (contrairement à TaskConfigScreen qui a self.reglages) --
            # la préférence de capture par pilote est déjà globale côté
            # serveurT (definir_preference_capture s'applique à toutes
            # les captures relayées à CE pilote, pas seulement celles de
            # ce panneau), donc réutiliser le dernier réglage connu
            # ailleurs dans l'app (TaskConfigScreen) comme valeur
            # initiale évite d'incohérence sans dupliquer le stockage.
            self._fenetre_rendu_reseau.panneau.definir_reglages_capture_reseau_visibles(True)
            # PATCH (demande explicite utilisateur : afficher nom/proxy/
            # pays du profil actif) -- même patron que definir_reglages_
            # capture_reseau_visibles ci-dessus.
            self._fenetre_rendu_reseau.panneau.definir_infos_profil_visibles(True)
            self._fenetre_rendu_reseau.panneau.demande_preference_capture.connect(
                self.demande_preference_capture_reseau.emit
            )

            def _sur_commande_controle_distance(payload: dict):
                if self._rendu_reseau_cible is None:
                    return
                id_exec_cible, instance_id_cible, _session_id_cible = self._rendu_reseau_cible
                self.demande_commande_instance_reseau.emit(
                    id_exec_cible, instance_id_cible, payload["requete_id"], payload["commande"],
                )

            self._fenetre_rendu_reseau.commande_controle_distance.connect(_sur_commande_controle_distance)

            # PATCH (liste déroulante d'onglet actif, cf. panneau.
            # bande_onglet.setVisible(True) dans FenetreRenduTaskReseau.
            # __init__) -- même protocole/même raisonnement que
            # PanneauProprietesSautoniax (cf. son propre câblage "Onglet
            # navigateur distant"), adapté ici : PAS de self._client_
            # serveur_t direct dans ce Screen (cf. docstring de classe,
            # "les écrans réseau ne font que relayer") --
            # demande_commande_instance_reseau.emit comme les autres
            # commandes de contrôle ci-dessus, et réception du résultat
            # via sur_command_result_reseau (nouveau slot public, câblé
            # par MainWindow sur ClientServeurT.command_result_recu,
            # même patron que les autres sur_resultat_xxx de cette
            # classe).
            self._requete_id_liste_onglets_reseau: Optional[str] = None
            self._requete_id_switch_onglet_reseau: Optional[str] = None

            def _demander_liste_onglets_reseau():
                if self._rendu_reseau_cible is None:
                    return
                id_exec_cible, instance_id_cible, _session_id_cible = self._rendu_reseau_cible
                requete_id = uuid.uuid4().hex[:12]
                self._requete_id_liste_onglets_reseau = requete_id
                self._fenetre_rendu_reseau.panneau.label_statut_onglets.definir_texte("Récupération des onglets…")
                self._fenetre_rendu_reseau.panneau.label_statut_onglets.setStyleSheet(f"color: {Mocha.subtext0}; font-size: 11px;")
                self.demande_commande_instance_reseau.emit(
                    id_exec_cible, instance_id_cible, requete_id, {"action": "listTabs"},
                )

            def _sur_onglet_reseau_change(_index: int):
                combo = self._fenetre_rendu_reseau.panneau.onglet_combo
                tab_id = combo.currentData()
                if tab_id is None or self._rendu_reseau_cible is None:
                    return
                id_exec_cible, instance_id_cible, _session_id_cible = self._rendu_reseau_cible
                requete_id = uuid.uuid4().hex[:12]
                self._requete_id_switch_onglet_reseau = requete_id
                self.demande_commande_instance_reseau.emit(
                    id_exec_cible, instance_id_cible, requete_id, {"action": "switchTab", "tabId": tab_id},
                )

            self._fenetre_rendu_reseau.panneau.onglet_combo.currentIndexChanged.connect(_sur_onglet_reseau_change)
            self._fenetre_rendu_reseau.panneau.onglet_combo.popup_ouvert.connect(_demander_liste_onglets_reseau)
            self._fenetre_rendu_reseau.panneau.rafraichir_onglets_button.clicked.connect(_demander_liste_onglets_reseau)
            self._fenetre_rendu_reseau.panneau.onglet_combo.setEnabled(True)
            self._fenetre_rendu_reseau.panneau.rafraichir_onglets_button.setEnabled(True)
            self._demander_liste_onglets_reseau_interne = _demander_liste_onglets_reseau

            # REFONTE -- même changement que TaskConfigScreen._sur_clic_
            # voir_rendu_reseau (cf. docstring de FenetreRenduTaskReseau.
            # afficher_par_dessus_tout) : plus de mode onglet/détaché, le
            # bouton Détacher/Réattacher reste masqué.

        log_reseau_t.info(
            f"[DIAG clic apercu #2] self_id={id(self)} session_id={session_id!r} nom_profil={nom_profil!r} "
            f"id_executant={id_executant!r} instance_id={instance_id!r} "
            f"-- fixation de _rendu_reseau_cible sur cet objet."
        )
        self._rendu_reseau_cible = (id_executant, instance_id, session_id)
        self._fenetre_rendu_reseau.titre_label.setText(self._titre_rendu_reseau_actuel())
        # PATCH (demande explicite utilisateur : afficher nom/proxy/
        # pays du profil actif) -- nom_profil déjà résolu ci-dessus par
        # _profil_en_cours_pour_apercu, obtenir_config_profil donne le
        # proxy/pays associés (même fonction que la grille de profils,
        # cf. obtenir_config_profil).
        config_profil = obtenir_config_profil(nom_profil)
        self._fenetre_rendu_reseau.panneau.definir_infos_profil(
            nom_profil, config_profil.get("proxy"), config_profil.get("pays")
        )
        self._fenetre_rendu_reseau.definir_image(None)
        # Demande immédiate d'une capture ponctuelle -- le panneau
        # s'ouvre vide sinon jusqu'au prochain tick du cycle
        # périodique côté sAutoniax (même correctif que le bouton
        # "Rafraîchir" manuel, appliqué ici automatiquement à
        # l'ouverture pour un premier rendu sans attente).
        self.demande_capture_ponctuelle_instance_reseau.emit(id_executant, instance_id)

        # REFONTE -- toujours par-dessus tout, sans bordure, à la taille
        # de l'écran (cf. FenetreRenduTaskReseau.afficher_par_dessus_tout).
        self._fenetre_rendu_reseau.afficher_par_dessus_tout()

    def _titre_rendu_reseau_actuel(self) -> str:
        if self._rendu_reseau_cible is None:
            return "Aperçu réseau"
        id_executant, _instance_id, session_id = self._rendu_reseau_cible
        session = self._sessions.get(session_id, {})
        nom_executant = session.get("nom_executant") or getattr(self, "_noms_executants", {}).get(id_executant, id_executant)
        nom_projet = session.get("nom_projet", "")
        return f"Aperçu : {nom_projet} ({nom_executant})" if nom_projet else f"Aperçu : {nom_executant}"

    def _sur_fermeture_rendu_reseau(self):
        """Symétrique de TaskConfigScreen._sur_fermeture_rendu_reseau
        (cf. sa docstring pour le POURQUOI du retrait explicite avant
        destruction)."""
        if self._fenetre_rendu_reseau is None:
            return
        applications_screen = self._applications_screen_ou_none()
        if applications_screen is not None:
            applications_screen.retirer_rendu_task_reseau(self._fenetre_rendu_reseau)
        log_reseau_t.info(
            f"[DIAG fermeture apercu #2] self_id={id(self)} -- fenetre et _rendu_reseau_cible remis à None "
            f"(ancienne cible={self._rendu_reseau_cible!r})"
        )
        self._fenetre_rendu_reseau.deleteLater()
        self._fenetre_rendu_reseau = None
        self._rendu_reseau_cible = None

    def _applications_screen_ou_none(self):
        """Même patron que TaskConfigScreen._applications_screen_ou_none
        (cf. sa docstring) -- accès best-effort, garde-fou silencieux."""
        main_window = self.window()
        return getattr(main_window, "screens", {}).get("applications")

    def _sur_demande_rafraichissement_rendu_reseau(self):
        if self._rendu_reseau_cible is None:
            return
        id_executant, instance_id, _session_id = self._rendu_reseau_cible
        self.demande_capture_ponctuelle_instance_reseau.emit(id_executant, instance_id)

    def _sur_taux_capture_reseau_change(self, fps: float):
        if self._rendu_reseau_cible is None:
            return
        id_executant, instance_id, _session_id = self._rendu_reseau_cible
        self.demande_taux_capture_instance_reseau.emit(id_executant, instance_id, fps)

    def sur_capture_reseau_recue(self, id_executant: str, _nom_executant: str, instance_id: str, image_b64: str):
        """PATCH E.1 -- connecté par MainWindow à ClientServeurT.capture_
        recue (même signal source que TaskConfigScreen.sur_capture_
        reseau_recue, cf. sa docstring pour le détail des 4 champs).
        Contrairement à TaskConfigScreen (filtre par id_executant seul,
        mode mono-profil -- un seul instance_id possible par sAutoniax à
        la fois), ce filtre exige AUSSI instance_id : plusieurs instances
        peuvent tourner en parallèle sur le même sAutoniax (E.4), une
        capture pour une AUTRE instance du même sAutoniax ne doit pas
        s'afficher dans ce panneau."""
        if self._fenetre_rendu_reseau is None or self._rendu_reseau_cible is None:
            log_reseau_t.info(
                f"[DIAG capture rendu direct #2] self_id={id(self)} capture_recue ignorée -- "
                f"fenetre_ouverte={self._fenetre_rendu_reseau is not None}, "
                f"cible_definie={self._rendu_reseau_cible is not None} "
                f"(recu id_executant={id_executant!r}, instance_id={instance_id!r})"
            )
            return
        id_exec_cible, instance_id_cible, _session_id_cible = self._rendu_reseau_cible
        log_reseau_t.info(
            f"[DIAG capture rendu direct #2] recu id_executant={id_executant!r} instance_id={instance_id!r} "
            f"vs cible id_exec_cible={id_exec_cible!r} instance_id_cible={instance_id_cible!r} "
            f"-> match={id_executant == id_exec_cible and instance_id == instance_id_cible}"
        )
        if id_executant == id_exec_cible and instance_id == instance_id_cible:
            self._fenetre_rendu_reseau.definir_image(image_b64)

    def sur_echec_reglage_capture_reseau(self, id_executant: str, message: str):
        """PATCH E.1 -- même patron que TaskConfigScreen.sur_echec_
        reglage_capture_reseau (échec de TRANSMISSION d'une demande de
        capture/taux, ex. sAutoniax déconnecté entre le clic et l'envoi)
        -- affiché dans la barre de statut globale via resultat_envoi_
        confirme, seul canal de feedback que possède cet écran (cf.
        docstring de classe)."""
        if self._rendu_reseau_cible is None or self._rendu_reseau_cible[0] != id_executant:
            return
        nom_executant = getattr(self, "_noms_executants", {}).get(id_executant, id_executant)
        self.resultat_envoi_confirme.emit(False, f"Aperçu -- échec de réglage capture pour '{nom_executant}' : {message}")

    def sur_command_result_reseau(self, data: dict):
        """PATCH (liste déroulante d'onglet actif) -- connecté par
        MainWindow à ClientServeurT.command_result_recu (signal GLOBAL,
        tous les command_result confondus, cf. sa docstring). Filtre sur
        les requete_id des commandes listTabs/switchTab émises par
        _demander_liste_onglets_reseau/_sur_onglet_reseau_change (cf.
        _sur_clic_apercu_execution ci-dessus), ignore tout le reste --
        même patron EXACT que PanneauProprietesSautoniax.sur_command_
        result_reseau, adapté ici au tuple à 3 éléments (id_executant,
        instance_id, session_id) de self._rendu_reseau_cible."""
        _fen_copie = getattr(self, "_fenetre_rendu_reseau", None)
        if _fen_copie is not None and _fen_copie.traiter_resultat_copie_distante(data):
            return  # PATCH Ctrl+C : réponse traitée
        if self._fenetre_rendu_reseau is None:
            return
        panneau = self._fenetre_rendu_reseau.panneau
        requete_id = data.get("requete_id")
        if requete_id == getattr(self, "_requete_id_liste_onglets_reseau", None):
            self._requete_id_liste_onglets_reseau = None
            if not data.get("ok", False):
                panneau.label_statut_onglets.definir_texte(f"Échec : {data.get('error', 'erreur inconnue')}")
                panneau.label_statut_onglets.setStyleSheet(f"color: {Mocha.red}; font-size: 11px;")
                return
            onglets = data.get("result") or []
            combo = panneau.onglet_combo
            combo.blockSignals(True)
            combo.clear()
            id_actif = None
            for onglet in onglets:
                titre = onglet.get("titre") or onglet.get("url") or onglet.get("id", "")
                libelle = titre if len(titre) <= 50 else titre[:47] + "…"
                combo.addItem(libelle, onglet.get("id"))
                if onglet.get("actif"):
                    id_actif = onglet.get("id")
            if not onglets:
                combo.addItem("Aucun onglet ouvert", None)
            index_actif = combo.findData(id_actif) if id_actif else -1
            combo.setCurrentIndex(max(0, index_actif))
            combo.blockSignals(False)
            combo.setEnabled(len(onglets) > 0)
            panneau.label_statut_onglets.definir_texte(f"{len(onglets)} onglet(s) trouvé(s).")
            panneau.label_statut_onglets.setStyleSheet(f"color: {Mocha.green}; font-size: 11px;")
        elif requete_id == getattr(self, "_requete_id_switch_onglet_reseau", None):
            self._requete_id_switch_onglet_reseau = None
            if not data.get("ok", False):
                panneau.label_statut_onglets.definir_texte(f"Échec du changement d'onglet : {data.get('error', 'erreur inconnue')}")
                panneau.label_statut_onglets.setStyleSheet(f"color: {Mocha.red}; font-size: 11px;")


class FenetreRenduNotebookDistant(QWidget):
    """Fenêtre flottante NON-MODALE affichant le dernier screenview reçu
    de l'instance en cours d'exécution sur le sAutoniax sélectionné dans
    NotebookDistantScreen (demande explicite utilisateur : "je veux que
    le rendu soit bien visible, donc il faut enlever le rendu de l'onglet,
    ça doit être un petit bouton qui affiche le screenview de l'instance
    en cours d'exécution, avec tout les éléments widget que
    screenAppView de base possède, donc ça va apparaître au-dessus de
    l'app avec la taille d'affichage de l'instance exécutée sur
    sautoniax").

    Même famille que DialogueZoomImage (QWidget top-level, Qt.Window |
    Qt.FramelessWindowHint retiré ici : contrairement au zoom "juste pour
    regarder puis refermer au clic", cette fenêtre reste ouverte et se
    mets à jour EN DIRECT tant que l'utilisateur ne la ferme pas
    explicitement -- une barre de titre minimale avec bouton fermer est
    donc conservée, pas de fermeture au clic n'importe où dans la fenêtre).

    "tout les éléments widget que screenAppView de base possède" (cf.
    demande utilisateur) : réutilise EXACTEMENT le même décodage d'image
    (decoder_image_b64 + repli Pillow WebP) et la même zone de défilement
    que l'ancien onglet "Rendu" retiré d'ici -- rien de nouveau inventé
    côté rendu lui-même, seulement déplacé d'un onglet vers cette popup,
    plus un léger habillage (titre = sAutoniax ciblé, taille informative).

    Pure surface d'affichage : ne détient aucune connexion réseau propre,
    c'est NotebookDistantScreen qui lui pousse chaque nouvelle capture via
    definir_image (déjà reçue via ClientServeurT.capture_recue, cf.
    sur_capture_recue de l'écran parent) -- même séparation de
    responsabilités que le reste de ce fichier (les écrans réseau ne
    font que relayer, jamais de connexion directe au client réseau)."""

    fermeture_demandee = Signal()

    def __init__(self, parent=None):
        super().__init__(parent, Qt.Window)
        self.setObjectName("FenetreRenduNotebookDistant")
        self.setWindowTitle("Rendu -- Notebook Distant")
        self.setMinimumSize(420, 320)
        self.resize(720, 540)

        layout_racine = QVBoxLayout(self)
        layout_racine.setContentsMargins(0, 0, 0, 0)
        layout_racine.setSpacing(0)

        # --- Barre de titre minimale (nom du sAutoniax ciblé + fermer) ---
        barre = QWidget(self)
        barre.setObjectName("FenetreRenduNotebookDistantBarre")
        barre_layout = QHBoxLayout(barre)
        barre_layout.setContentsMargins(14, 10, 10, 10)
        barre_layout.setSpacing(8)

        self.label_titre = QLabel("Aucun sAutoniax sélectionné", barre)
        self.label_titre.setObjectName("ReglagesLabel")
        barre_layout.addWidget(self.label_titre, stretch=1)

        self.bouton_fermer = QToolButton(barre)
        self.bouton_fermer.setObjectName("APIFeaturesMenuButton")
        self.bouton_fermer.setIcon(qta.icon("mdi6.close", color=Mocha.subtext0))
        self.bouton_fermer.setIconSize(QSize(16, 16))
        self.bouton_fermer.setCursor(Qt.PointingHandCursor)
        self.bouton_fermer.setToolTip("Fermer")
        self.bouton_fermer.clicked.connect(self.close)
        barre_layout.addWidget(self.bouton_fermer)

        layout_racine.addWidget(barre)

        # --- Zone de rendu : identique à l'ancien onglet "Rendu" ---
        self.zone_defilement = QScrollArea(self)
        self.zone_defilement.setWidgetResizable(True)
        self.zone_defilement.setObjectName("ReceptionApercuScroll")
        self.label_image = QLabel(self)
        self.label_image.setAlignment(Qt.AlignCenter)
        self.label_image.setText("Aucune capture reçue pour l'instant.")
        self.zone_defilement.setWidget(self.label_image)
        layout_racine.addWidget(self.zone_defilement, stretch=1)

    def definir_titre_executant(self, nom_executant: str):
        self.label_titre.setText(
            f"sAutoniax : {nom_executant}" if nom_executant else "Aucun sAutoniax sélectionné"
        )

    def definir_image(self, image_b64: Optional[str]):
        """Décode et affiche `image_b64` (WebP, cf. ClientServeurT.
        capture_recue) -- même logique EXACTE que l'ancienne
        NotebookDistantScreen._rafraichir_rendu (repli Pillow inclus),
        déplacée ici tel quel."""
        if not image_b64:
            self.label_image.setText("Aucune capture reçue pour l'instant.")
            self.label_image.setPixmap(QPixmap())
            return
        image = decoder_image_b64(image_b64)
        if (image is None or image.isNull()) and PILLOW_DISPONIBLE:
            try:
                brut = base64.b64decode(image_b64)
                with PILImage.open(io.BytesIO(brut)) as img_pil:
                    tampon_png = io.BytesIO()
                    img_pil.convert("RGB").save(tampon_png, format="PNG")
                image_secours = QImage()
                if image_secours.loadFromData(QByteArray(tampon_png.getvalue())) and not image_secours.isNull():
                    image = image_secours
            except Exception as e:
                log_reseau_t.debug(f"[NotebookDistant/Rendu] repli Pillow de décodage WebP échoué : {e!r}")
        if image is None or image.isNull():
            self.label_image.setText("Capture reçue mais illisible (décodage échoué).")
            self.label_image.setPixmap(QPixmap())
            return
        self.label_image.setText("")
        self.label_image.setPixmap(QPixmap.fromImage(image))

    def closeEvent(self, event):
        self.fermeture_demandee.emit()
        super().closeEvent(event)


