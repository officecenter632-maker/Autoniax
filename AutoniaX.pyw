        # ------------------------------------------------------------------
        # PATCH E (E.4 -- "Notion de Batch"). Symétrique multi-projets du
        # bloc _sur_demande_envoi_projet_sautoniax ci-dessus : même
        # construction de project.json minimal, répétée pour CHAQUE
        # ProjetBatch du batch (dans l'ordre reçu -- cf. docstring de
        # ClientServeurT.envoyer_batch_vers_sautoniax, "projets" doit déjà
        # être dans l'ordre d'exécution voulu). ProjetBatchScreen reste
        # responsable de la sélection multiple + de l'ordre choisi par
        # l'utilisateur (cf. sa vue grille) ; ce bloc-ci ne fait que
        # résoudre chaque id_projet_batch en (chemin_racine, nom_projet)
        # et écrire le fichier, exactement comme pour un envoi unique.
        # ------------------------------------------------------------------

        def _sur_demande_envoi_batch_sautoniax(
            id_executant: str, ids_projets_batch: list, profils: list,
        ):
            id_batch_distribue = uuid.uuid4().hex[:12]
            projets_resolus = []
            for id_projet_batch in ids_projets_batch:
                projet_batch = next(
                    (p for p in self.project.projets_batch if p.id == id_projet_batch), None,
                )
                if projet_batch is None:
                    reseau_screen.projets_distribues_screen.sur_resultat_envoi(
                        False, "", f"ProjetBatch introuvable (a-t-il été supprimé ?) : {id_projet_batch}",
                    )
                    return
                task = self.project.find_task(projet_batch.task_id)
                if task is None:
                    reseau_screen.projets_distribues_screen.sur_resultat_envoi(
                        False, "", f"Task introuvable pour le ProjetBatch '{projet_batch.nom}'.",
                    )
                    return
                if not projet_batch.chemin_racine or not Path(projet_batch.chemin_racine).is_dir():
                    reseau_screen.projets_distribues_screen.sur_resultat_envoi(
                        False, "", f"Dossier racine invalide pour le ProjetBatch '{projet_batch.nom}'.",
                    )
                    return
                project_minimal = Project(tasks=[task], projets_batch=[projet_batch])
                try:
                    (Path(projet_batch.chemin_racine) / "project.json").write_text(
                        json.dumps(project_minimal.to_dict(), ensure_ascii=False, indent=2), encoding="utf-8",
                    )
                except OSError as e:
                    reseau_screen.projets_distribues_screen.sur_resultat_envoi(
                        False, "", f"Échec d'écriture de project.json pour '{projet_batch.nom}' : {e}",
                    )
                    return
                projets_resolus.append((projet_batch.id, projet_batch.chemin_racine, projet_batch.nom))

            self.client_serveur_t.envoyer_batch_vers_sautoniax(
                id_executant, id_batch_distribue, projets_resolus, profils,
            )

        dashboard_screen.projets_batch_screen.demande_envoi_batch_sautoniax.connect(
            _sur_demande_envoi_batch_sautoniax
        )
        # PATCH E.7 -- même route générique que TaskConfigScreen.demande_
        # ouvrir_rendu_reseau/ProjetsDistribuesScreen.demande_ouvrir_
        # rendu_reseau ci-dessus (_ouvrir_rendu_task_reseau accepte
