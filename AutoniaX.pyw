    def definir_composant(self, composant: Optional[Composant]):
        """Appelé par TestComposantScreen à chaque changement de sélection
        dans "COMPOSANT À TESTER" (cf. _on_composant_changed) -- affiche
        les réglages de ce composant précis, ou repasse sur le message
        "aucun composant" si None (aucun composant valide sélectionné).

        PATCH (SPEC_GLOBALE_AutoniaX.md, Partie A §5.4.2) -- peuple
        désormais aussi self.variante_combo avec les variantes de ce
        composant (libellé = nom de fichier, données = index dans
        composant.variantes) et sélectionne l'index 0 par défaut, pour que
        les 6 widgets ci-dessous chargent les réglages de LA VARIANTE
        sélectionnée plutôt que les valeurs par défaut du composant (qui
        n'affectent plus la détection réelle une fois une Variante
        présente, cf. Partie A §3)."""
        self._composant_nom = composant.nom if composant is not None else None
        self.label_aucun_composant.setVisible(composant is None)
        self._reglages_container.setVisible(composant is not None)
        if composant is None:
            self.variante_combo.blockSignals(True)
            self.variante_combo.clear()
            self.variante_combo.blockSignals(False)
            return

        self.variante_combo.blockSignals(True)
        self.variante_combo.clear()
        for i, variante in enumerate(composant.variantes):
            self.variante_combo.addItem(Path(str(variante)).name, i)
        self.variante_combo.blockSignals(False)

        self._variante_index_selectionnee = 0
        self.variante_combo.blockSignals(True)
        self.variante_combo.setCurrentIndex(0)
        self.variante_combo.blockSignals(False)

        self._charger_widgets_pour_variante(composant)
        self.variante_selection_changee.emit(self._variante_index_selectionnee)

    def _charger_widgets_pour_variante(self, composant: Composant):
        """AJOUT (SPEC_GLOBALE_AutoniaX.md, Partie A §5.4.2) -- factorise le
        chargement des 6 widgets de réglages depuis
        composant.variantes[self._variante_index_selectionnee], appelé à la
        fois par definir_composant (sélection initiale, index 0) et par
        _on_variante_selection_changed (changement de variante en cours de
        réglage). Repli sur les valeurs par défaut DU COMPOSANT si jamais
        l'index est hors bornes ou composant.variantes est vide (cas limite
        défensif -- ne devrait pas arriver en pratique, cf. §4.2
        remove_variante_composant qui refuse de descendre à 0 variante)."""
        variantes = composant.variantes
        index = self._variante_index_selectionnee
        variante = variantes[index] if 0 <= index < len(variantes) else None

        # BUGFIX (cf. commentaire de self.apercu_variante_label ci-dessus)
        # -- affiche l'image RÉELLE de la variante actuellement réglée,
        # pour que changer de variante dans le combo se voie à l'écran et
        # ne repose plus uniquement sur le nom de fichier en texte.
        if variante is not None:
            image_absolue = get_app_data_dir() / str(variante)
            pixmap = QPixmap(str(image_absolue)) if image_absolue.exists() else QPixmap()
        else:
            pixmap = QPixmap()
        if not pixmap.isNull():
            pixmap = pixmap.scaled(
                219, 110, Qt.KeepAspectRatio, Qt.SmoothTransformation
            )
            self.apercu_variante_label.setPixmap(pixmap)
            self.apercu_variante_label.setText("")
        else:
            self.apercu_variante_label.setPixmap(QPixmap())
            self.apercu_variante_label.setText("(image introuvable)")

        priorite_selection = variante.priorite_selection if variante is not None else composant.priorite_selection
        seuil_confiance = variante.seuil_confiance if variante is not None else composant.seuil_confiance
        flou_noyau = variante.flou_noyau if variante is not None else composant.flou_noyau
        delta_conflit = variante.delta_conflit if variante is not None else composant.delta_conflit
        seuil_candidats_potentiels = (
            variante.seuil_candidats_potentiels if variante is not None else composant.seuil_candidats_potentiels
        )
        couleur_succes = variante.couleur_succes if variante is not None else composant.couleur_succes
        couleur_echec = variante.couleur_echec if variante is not None else composant.couleur_echec

        index_priorite = self.priorite_combo.findData(priorite_selection)
        self.priorite_combo.blockSignals(True)
        self.priorite_combo.setCurrentIndex(max(0, index_priorite))
        self.priorite_combo.blockSignals(False)

        self.seuil_spin.blockSignals(True)
        self.seuil_spin.setValue(seuil_confiance)
        self.seuil_spin.blockSignals(False)

        self.flou_spin.blockSignals(True)
        self.flou_spin.setValue(flou_noyau)
        self.flou_spin.blockSignals(False)

        self.delta_conflit_spin.blockSignals(True)
        self.delta_conflit_spin.setValue(delta_conflit)
        self.delta_conflit_spin.blockSignals(False)

        self.seuil_candidats_spin.blockSignals(True)
        self.seuil_candidats_spin.setValue(seuil_candidats_potentiels)
        self.seuil_candidats_spin.blockSignals(False)

        self.couleur_succes_bouton.definir_couleur(couleur_succes)
        self.couleur_echec_bouton.definir_couleur(couleur_echec)

    def _on_variante_selection_changed(self, index: int):
        """AJOUT (SPEC_GLOBALE_AutoniaX.md, Partie A §5.4.1/§5.4.5) -- slot
        du nouveau variante_combo : change de variante réglée et rafraîchit
        immédiatement les 6 widgets pour refléter les valeurs DE CETTE
        VARIANTE (comme un formulaire qui change de contexte), pour que
        l'utilisateur puisse enchaîner le réglage de plusieurs variantes du
        même composant sans quitter l'écran de test."""
        if self.project is None or self._composant_nom is None:
            return
        composant = self.project.find_composant(self._composant_nom)
        if not composant:
            return
        donnee = self.variante_combo.itemData(index)
        self._variante_index_selectionnee = donnee if donnee is not None else 0
        self._charger_widgets_pour_variante(composant)
        self.variante_selection_changee.emit(self._variante_index_selectionnee)

    # ------------------------------------------------------------------
    # Slots -- PATCH (SPEC_GLOBALE_AutoniaX.md, Partie A §5.4.4) : ces 7
    # handlers écrivaient auparavant directement sur composant.<champ> (les
    # valeurs par défaut du composant, cf. ComposantSingle §2.2 -- qui
    # n'affectent plus la détection réelle une fois une Variante présente,
    # cf. §3). Ils retrouvent désormais LA VARIANTE SÉLECTIONNÉE
    # (composant.variantes[self._variante_index_selectionnee]) et modifient
    # SES attributs -- même patron déjà en place (modifie l'objet du
    # modèle partagé directement, effet immédiat même sur un test en
    # cours, aucune copie intermédiaire, puis project.save()), juste
    # redirigé vers la Variante au lieu du Composant. Garde-fou commun en
    # tête de chaque handler : composant sans aucune variante ou index hors
    # bornes (cas limite déjà rare, cf. remove_variante_composant qui
    # refuse de descendre à 0) -> ne rien faire plutôt que planter.
    # ------------------------------------------------------------------
    def _variante_selectionnee_pour_ecriture(self, composant: Composant) -> Optional[Variante]:
        """Retourne la Variante actuellement sélectionnée dans
        variante_combo pour CE composant, ou None si composant.variantes
        est vide ou que l'index est hors bornes (cf. garde-fou décrit
        ci-dessus) -- factorisé pour éviter de répéter cette vérification
        dans les 7 handlers."""
        variantes = composant.variantes
        index = self._variante_index_selectionnee
        if not variantes or not (0 <= index < len(variantes)):
            return None
        return variantes[index]

    def _on_priorite_changed(self, index: int):
        if self.project is None or self._composant_nom is None:
            return
        composant = self.project.find_composant(self._composant_nom)
        if not composant:
            return
        variante = self._variante_selectionnee_pour_ecriture(composant)
        if variante is None:
            return
        variante.priorite_selection = self.priorite_combo.currentData()
        self.project.save()

    def _on_seuil_changed(self, valeur: float):
        if self.project is None or self._composant_nom is None:
            return
        composant = self.project.find_composant(self._composant_nom)
        if not composant:
            return
        variante = self._variante_selectionnee_pour_ecriture(composant)
        if variante is None:
            return
        variante.seuil_confiance = round(valeur, 2)
        self.project.save()

    def _on_flou_changed(self, valeur: int):
        if self.project is None or self._composant_nom is None:
            return
        composant = self.project.find_composant(self._composant_nom)
        if not composant:
            return
        variante = self._variante_selectionnee_pour_ecriture(composant)
        if variante is None:
            return
        # cf. ComposantReglagesPanel._on_flou_changed -- cv2.GaussianBlur
        # exige un noyau impair, corrigé ici dans l'UI elle-même.
        if valeur > 0 and valeur % 2 == 0:
            valeur += 1
            self.flou_spin.blockSignals(True)
            self.flou_spin.setValue(valeur)
            self.flou_spin.blockSignals(False)
        variante.flou_noyau = valeur
        self.project.save()

    def _on_delta_conflit_changed(self, valeur: float):
        if self.project is None or self._composant_nom is None:
            return
        composant = self.project.find_composant(self._composant_nom)
        if not composant:
            return
        variante = self._variante_selectionnee_pour_ecriture(composant)
        if variante is None:
            return
        variante.delta_conflit = round(valeur, 3)
        self.project.save()

    def _on_seuil_candidats_changed(self, valeur: float):
        if self.project is None or self._composant_nom is None:
            return
        composant = self.project.find_composant(self._composant_nom)
        if not composant:
            return
        variante = self._variante_selectionnee_pour_ecriture(composant)
        if variante is None:
            return
        variante.seuil_candidats_potentiels = round(valeur, 2)
        self.project.save()

    def _on_couleur_succes_changed(self, couleur: str):
        if self.project is None or self._composant_nom is None:
            return
        composant = self.project.find_composant(self._composant_nom)
        if not composant:
            return
        variante = self._variante_selectionnee_pour_ecriture(composant)
        if variante is None:
            return
        variante.couleur_succes = couleur
        self.project.save()

    def _on_couleur_echec_changed(self, couleur: str):
        if self.project is None or self._composant_nom is None:
            return
        composant = self.project.find_composant(self._composant_nom)
        if not composant:
            return
        variante = self._variante_selectionnee_pour_ecriture(composant)
        if variante is None:
            return
        variante.couleur_echec = couleur
        self.project.save()


class ComposantLayoutReglagesNumeriquesPanel(QWidget):
