def _tester_proxy_sync(proxy: dict) -> tuple[bool, dict]:
    """Factorisation (PATCH -- création de profil sAutoniax à distance,
    demande explicite utilisateur : "test EN LOCAL par le sAutoniax
    distant lui-même") du corps de TestProxyWorker._executer, en fonction
    SYNCHRONE pure (aucun signal Qt, aucune dépendance à un QThread) --
    réutilisable aussi bien par TestProxyWorker (thread Qt dédié côté
    pilote, cf. son docstring de classe) que par le nouveau handler
    réseau côté sAutoniax (_sur_demander_tester_proxy_sautoniax_demande,
    exécuté via loop.run_in_executor -- même raison de ne jamais bloquer
    une boucle asyncio/Qt qu'un thread GUI : une requête HTTP via un
    proxy potentiellement lent/hors service peut prendre plusieurs
    secondes, voire le timeout).

    Retourne (succes, infos) -- infos: {"ip", "pays", "ville",
    "code_pays"} si succes=True, {"erreur"} sinon. Comportement,
    messages et service testé (ip-api.com) IDENTIQUES à l'ancien
    TestProxyWorker._executer -- aucun changement fonctionnel pour
    l'appelant existant, seulement une extraction."""
    try:
        url_test = "http://ip-api.com/json/?fields=status,message,country,countryCode,city,query"
        port = proxy.get("port") or (1080 if proxy.get("protocole") == "socks5" else 8080)
        auth = ""
        if proxy.get("user"):
            mdp = proxy.get("password") or ""
            auth = f"{proxy['user']}:{mdp}@"
        url_proxy = f"{proxy.get('protocole') or 'http'}://{auth}{proxy['host']}:{port}"
        # PATCH -- urllib.request.ProxyHandler ne sait nativement gérer
        # que des proxys HTTP/HTTPS (pas SOCKS5, qui demanderait PySocks
        # + un monkeypatch de socket, hors scope stdlib) : un proxy
        # socks5 est donc signalé comme non supporté ici plutôt que de
        # silencieusement tenter une connexion qui échouerait de façon
        # confuse.
        if (proxy.get("protocole") or "http") in ("socks5", "socks4"):
            return False, {
                "erreur": "Les proxys SOCKS4/SOCKS5 ne sont pas testables directement -- "
                          "seuls HTTP/HTTPS le sont. Le proxy sera tout de même enregistré."
            }
        gestionnaire = urllib.request.ProxyHandler({"http": url_proxy, "https": url_proxy})
        opener = urllib.request.build_opener(gestionnaire)

        requete = urllib.request.Request(url_test, headers={"User-Agent": "AutoniaX/1.0"})
        with opener.open(requete, timeout=10) as reponse:
            donnees = json.loads(reponse.read().decode("utf-8"))

        if donnees.get("status") != "success":
            return False, {"erreur": donnees.get("message") or "Réponse inattendue du service de test."}

        return True, {
            "ip": donnees.get("query") or "?",
            "pays": donnees.get("country") or "?",
            "ville": donnees.get("city") or "?",
            "code_pays": donnees.get("countryCode") or None,
        }
    except urllib.error.URLError as e:
        return False, {"erreur": f"Connexion impossible : {e.reason}"}
    except TimeoutError:
        return False, {"erreur": "Délai dépassé (10s) -- le proxy ne répond pas."}
    except Exception as e:
        log_dashboard_ui.exception(f"Erreur inattendue lors du test de proxy : {e!r}")
        return False, {"erreur": f"Erreur inattendue : {e}"}


class PousserDriveWorker(QObject):
    """CORRECTIF (blocage UI signalé -- "la mise a jour du code serverT
    est bloquant dans mon app") -- exécute l'envoi de serveur.py vers
    Google Drive dans un QThread séparé, JAMAIS sur le thread GUI (même
    principe que TestProxyWorker juste en dessous : _ClientDriveMinimal
    parle à l'API Google Drive via googleapiclient.discovery.build(...)
    .execute(), un appel HTTP entièrement synchrone/bloquant, sans await
    ni thread interne -- l'exécuter directement dans le handler du bouton
    "Envoyer vers Drive" (cf. GitScreen._pousser_vers_drive) gelait toute
    la fenêtre mAutoniax pendant tout l'envoi, potentiellement plusieurs
    secondes selon la taille du fichier et la latence Google, exactement
    le même défaut que celui déjà corrigé côté serveur.py pour l'event
    loop asyncio (cf. GestionnaireStockage._a_thread côté serveurT).

    Un seul aller-retour par instance de GitScreen (cf. son __init__) :
    demande_envoi (reglages, contenu) -> résultat via resultat_pret,
    jamais d'identifiant de requête façon TestProxyWorker puisque le
    bouton "Envoyer vers Drive" est désactivé pendant l'envoi (cf.
    _pousser_vers_drive) -- aucun risque de recouvrement entre deux
    demandes concurrentes sur ce même bouton."""

    demande_envoi = Signal(object, bytes)  # (reglages: ReglagesApp, contenu) -- émis depuis le thread GUI
    resultat_pret = Signal(bool, str)  # (ok, message) -- message vide si ok=True

    def __init__(self):
        super().__init__()
        self.demande_envoi.connect(self._executer)

    def _executer(self, reglages: "ReglagesApp", contenu: bytes):
        # Ce slot tourne dans le thread du worker (cf. TestProxyWorker,
        # même mécanisme de routage via moveToThread + connexion faite
        # ici même dans __init__) -- l'appel Drive bloquant ci-dessous ne
        # gèle donc que ce thread dédié, jamais l'UI.
        try:
            GestionnaireStockageDriveDirect(reglages).envoyer_serveur_py(contenu)
        except Exception as e:
            self.resultat_pret.emit(False, str(e))
            return
        self.resultat_pret.emit(True, "")


class TestProxyWorker(QObject):
    """PATCH (retour utilisateur : "on va meme tester le proxy pour voir
    si sa fontionne, recuperer les donne comme le pays, ladrese ip") --
    exécute le test de connectivité d'un proxy dans un QThread séparé,
    JAMAIS sur le thread GUI (même principe que DetectionWorker plus haut
    dans ce fichier : une requête HTTP via un proxy potentiellement lent/
    hors service peut bloquer plusieurs secondes, voire jusqu'au timeout
    -- inacceptable sur le thread GUI, qui gèlerait l'appli entière
    pendant ce temps).

    Utilise urllib.request (stdlib, déjà disponible, pas de nouvelle
    dépendance comme `requests` à ajouter) avec un ProxyHandler configuré
    sur le proxy à tester, contre ip-api.com/json (gratuit, pas de clé
    API requise, retourne directement pays/ville/IP en JSON -- cf.
    docstring de _construire_carte_creation_profil pour le choix de ce
    service). Timeout court (10s) : un proxy mort ne doit pas laisser
    l'utilisateur face à un bouton "Test en cours..." indéfiniment.

    BUG CORRIGÉ (retour utilisateur explicite : un champ proxy vide ne
    doit jamais afficher un faux "succès" avec l'IP réelle de
    l'utilisateur) -- ce worker exige désormais TOUJOURS un proxy non
    vide (cf. _executer, `proxy: dict` non-Optional) : il ne teste plus
    jamais la connexion directe sans proxy. Le cas "champ vide" est
    intercepté en amont, côté UI (cf. _on_clic_tester_proxy), qui
    n'émet même plus demande_test dans ce cas.

    PATCH -- le corps du test lui-même est désormais factorisé dans
    _tester_proxy_sync (fonction module-level ci-dessus), réutilisée
    aussi par le nouveau test de proxy à distance (sAutoniax, cf. sa
    docstring) : cette classe ne fait plus que le routage thread Qt +
    émission de signal, comportement utilisateur inchangé."""

    demande_test = Signal(str, object)  # (id_requete, proxy_dict_ou_None) -- émis depuis le thread GUI
    resultat_pret = Signal(str, bool, dict)  # (id_requete, succes, infos) -- infos: {"ip", "pays", "ville", "erreur"}

    def __init__(self):
        super().__init__()
        self.demande_test.connect(self._executer)

    def _executer(self, id_requete: str, proxy: dict):

        # Ce slot tourne dans le thread du worker (cf. DetectionWorker,
        # même mécanisme de routage via moveToThread + connexion faite
        # ici même dans __init__).
        #
        # BUG CORRIGÉ (retour utilisateur explicite : "si je netre aucune
        # valeur, sa vas prendre mon ip lcl et lenvoyer pour le test et sa
        # vas afficher sucess") -- `proxy` n'est plus jamais None ici :
        # l'ancien fallback "champ vide -> teste la connexion directe,
        # sans proxy" a été retiré à la source (cf.
        # _on_clic_tester_proxy, qui n'émet plus demande_test du tout
        # pour un champ vide -- affiche directement un avertissement
        # côté UI sans solliciter ce worker). Le paramètre reste requis
        # (plus Optional) pour que ce soit visible dans la signature :
        # ce worker ne teste QUE via un proxy, jamais l'IP réelle.
        #
        # PATCH -- corps du test factorisé dans _tester_proxy_sync
        # (fonction module-level, cf. sa docstring) : ce slot ne fait
        # plus que router vers le thread du worker puis émettre le
        # signal Qt, comportement/messages inchangés pour l'appelant.
        succes, infos = _tester_proxy_sync(proxy)
        self.resultat_pret.emit(id_requete, succes, infos)


class ProfilsInstancesScreen(QWidget):
    """Ex-`DashboardScreen` -- gestion de profils/instances (créer un
    profil, lancer/arrêter une instance manuellement, aperçu streaming).
    Renommée lors de l'introduction du patch "Projet Batch" (cf.
    PATCH_projet_batch.md, section 8, question tranchée : cette
    fonctionnalité est déplacée dans un ONGLET séparé du nouveau
    DashboardScreen -- qui devient, lui, le gestionnaire de ProjetBatch --
    plutôt que supprimée ou déplacée ailleurs dans la sidebar. Contenu de
    cette classe INCHANGÉ par ce renommage : seul le nom de la classe et
    son point d'instanciation (désormais interne à DashboardScreen, cf.
    plus bas dans ce fichier) ont changé -- tous les commentaires de ce
    fichier qui mentionnent encore "DashboardScreen" en référence à CETTE
    classe (gestion profils/instances) restent valides en substance, pas
    mis à jour un par un pour ne pas gonfler ce patch d'un renommage
    cosmétique sans risque fonctionnel."""

    # BUG CORRIGÉ (retour utilisateur : "le teste arret de ... encours
    # est toujours là" -- confirmé par logs [ARRET-THREAD]/[ARRET-QT-SLOT] :
    # QTimer.singleShot(0, ...) appelé depuis _travail_arret (thread dédié,
    # cf. _arreter_instance_pour_profil) ne déclenchait JAMAIS son callback,
    # silencieusement, sans exception -- exactement le même diagnostic déjà
    # posé et corrigé ailleurs dans ce fichier pour MoteurExecutionCellion
    # (cf. son BUGFIX, recherche "QTimer.singleShot lie le timer au thread
    # qui l'appelle") : un QTimer.singleShot appelé depuis un
    # threading.Thread SANS event loop Qt n'a jamais de thread capable de
    # le faire expirer. Un signal Qt classique + Qt.QueuedConnection
    # traverse les threads de façon fiable, contrairement à
    # QTimer.singleShot -- même remède ici : ce signal, émis depuis
    # _travail_arret (n'importe quel thread), est garanti de faire
    # exécuter son slot sur le thread Qt principal (celui qui possède CET
    # objet ProfilsInstancesScreen), grâce à Qt.QueuedConnection explicite
    # dans le .connect() (cf. __init__ ci-dessous).
    _arret_instance_termine = Signal(str, object)
    # Même correctif, même cause, pour le second usage de QTimer.singleShot(0, ...)
    # depuis un thread trouvé dans cette classe (cf. _fermer_instance_puis_relancer
    # -> _travail_fermeture, docstring identique à _arret_instance_termine
    # ci-dessus) -- signature dédiée : (nom_profil, instance_id, resultat_ok, message).
    _fermeture_orpheline_terminee = Signal(str, str, bool, str)
    # AJOUT (surbrillance focus navigateur, cf. _minuteur_focus_navigateur
    # dans __init__) -- nom du profil dont la fenêtre navigateur vient de
    # prendre le focus OS, "" si le focus est passé à une fenêtre qui ne
    # correspond à AUCUN navigateur lancé depuis ce Dashboard (une autre
    # appli, ou AutoniaX lui-même). Relayé par MainWindow vers
    # PanneauExecutionClone (TaskConfigScreen) -- cf. son câblage, même
    # patron que les autres signaux inter-écrans déjà relayés là-bas
    # (jamais d'appel direct entre deux écrans-frères).
    focus_navigateur_local_change = Signal(str)

    def __init__(self, reglages: "ReglagesApp"):
        super().__init__()
        self.reglages = reglages
        self._processus_instances: dict[str, subprocess.Popen] = {}
        # Handle du Job Object Windows dédié aux INSTANCES (navigateurs).
        # ABANDONNÉ EN TANT QUE MÉCANISME "à jour en continu" (cf. analyse
        # complète dans _synchroniser_job_object_instances, plus bas dans
        # cette classe) : un Job maintenu pendant toute la session, même
        # resynchronisé à chaque bascule du réglage, tue les instances au
        # moment du CloseHandle -- pas seulement à la fermeture voulue.
        # Reste TOUJOURS None pendant toute la session normale ; conservé
        # uniquement pour compatibilité avec le code de nettoyage en fin
        # de arreter_tout() (qui ne fait plus rien en pratique, puisque ce
        # champ ne devient jamais autre chose que None). La fermeture des
        # instances à l'arrêt de l'app passe désormais uniquement par
        # arreter_tout() -> shutdown réseau propre, puis terminate()/kill()
        # en repli -- plus par un Job Object.
        self._job_object_instances = None
        self._instance_selectionnee: str | None = None
        self._profil_selectionne: str | None = None
        # PATCH (demande utilisateur : sélection rapide par cases à cocher
        # + lancement en lot) -- {noms de profil actuellement cochés dans
        # la liste}, INDÉPENDANT de self._profil_selectionne (qui, lui, ne
        # concerne que l'aperçu/contrôle fin d'un seul profil à la fois).
        # Alimenté par _sur_case_profil_changee/_appliquer_coche_tous_profils,
        # lu par _on_clic_lancer_profils_coches. Préservé d'un
        # _rafraichir_liste_profils à l'autre (cf. cette méthode, qui
        # réapplique l'état coché sur les items reconstruits) -- sans quoi
        # cocher des profils puis attendre le prochain instances_list du
        # serveur perdrait silencieusement la sélection en cours.
        self._profils_coches: set[str] = set()
        # PATCH (demande utilisateur explicite : "il faut que sa detecte
        # si cest un clic long avant que sa selctionne toute la ligne...
        # clic long est dur en environ 0.4 second") -- appui long (bouton
        # gauche, n'importe où sur une carte) qui coche/décoche en
        # bascule toute la LIGNE de la grille contenant cette carte, cf.
        # eventFilter (blocs MouseButtonPress/MouseMove/MouseButtonRelease
        # dédiés) et _sur_timeout_appui_long_ligne. Un seul QTimer
        # partagé pour TOUTE la classe (pas un par item -- un seul appui
        # possible à la fois, un bouton de souris ne peut être pressé
        # qu'une fois) ; singleShot=True : ne se répète jamais tout seul,
        # redémarré explicitement à chaque nouveau press (cf. .start()
        # dans eventFilter).
        self.SEUIL_APPUI_LONG_LIGNE_MS = 400
        self._minuteur_appui_long_ligne = QTimer(self)
        self._minuteur_appui_long_ligne.setSingleShot(True)
        self._minuteur_appui_long_ligne.timeout.connect(self._sur_timeout_appui_long_ligne)
        # Item/liste sur lesquels l'appui en cours a commencé (None entre
        # deux appuis) -- capturés au PRESS, lus par le timeout ET par
        # MouseMove (pour annuler si la souris quitte cette carte avant
        # l'échéance, cf. eventFilter) ET par MouseButtonRelease (pour
        # savoir si CE relâche doit être consommé, cf. _appui_long_ligne_
        # declenche juste en dessous).
        # CORRECTIF : on retient le NOM du profil pressé (str) et non une
        # référence QListWidgetItem -- _rafraichir_liste_profils appelle
        # liste.clear() à chaque événement serveur (démarrage/arrêt d'une
        # instance...), ce qui DÉTRUIT les items C++ ; une référence
        # gardée pendant les 0,4 s d'un appui pointerait alors sur un objet
        # mort au moment du timeout. Le nom, lui, survit à la
        # reconstruction et permet de RETROUVER l'item vivant au timeout.
        self._nom_presse_pour_appui_long: Optional[str] = None
        self._liste_presse_pour_appui_long: Optional[QListWidget] = None
        # True entre le moment où _sur_timeout_appui_long_ligne a
        # effectivement basculé une ligne et le MouseButtonRelease qui
        # suit -- évite que ce même relâche ne déclenche EN PLUS le
        # comportement standard (sélection simple de l'item sous le
        # curseur, cf. eventFilter).
        self._appui_long_ligne_declenche = False
        self._compteur_lancements = 0
        # True pendant la fenêtre "confirmation acceptée -> arrêt de
        # l'instance si besoin -> suppression effective" de
        # _on_clic_supprimer_profil -- évite un double-clic qui lancerait
        # deux suppressions concurrentes du même profil (ex. deuxième clic
        # pendant l'arrêt réseau de l'instance, qui peut prendre jusqu'à
        # ~10s, cf. _arreter_instance_pour_profil).
        self._suppression_en_cours = False
        # --- Profils PERSISTANTS nommés (cf. creer_ou_obtenir_profil) --
        # {nom_profil: chemin_dossier}, chargé depuis le registre sur
        # disque au démarrage du Dashboard : ces profils existent
        # indépendamment de toute instance en cours d'exécution (cf.
        # décision utilisateur : les profils créés doivent toujours
        # apparaître dans la liste, avec leur nom, qu'une instance tourne
        # dessus ou non). ---
        self._profils: dict[str, str] = charger_registre_profils()
        # {nom_profil: instance_id} UNIQUEMENT pour les profils sur
        # lesquels une instance est actuellement lancée DEPUIS CE
        # Dashboard (cf. _processus_instances -- même limite : un profil
        # lancé par un autre Dashboard n'apparaît "actif" qu'une fois
        # confirmé par le prochain instances_list du serveur, cf.
        # _sur_liste_instances_recue).
        self._instance_id_par_profil: dict[str, str] = {}
        # {nom_profil} actuellement en train de s'arrêter -- entre l'appel à
        # _arreter_instance_pour_profil (le shutdown réseau bloquant part sur
        # un thread dédié, jusqu'à ~10s, cf. sa docstring) et la fin réelle
        # du thread. PATCH (retour utilisateur : "quand japui sur arreter un
        # profils sa perd le temps avant darreter et cet normal, je veux que
        # pendant ce laps de temps, le bouton devient arret en cours") --
        # sert uniquement à afficher un état intermédiaire sur
        # bouton_lancer_arreter (cf. _rafraichir_bouton_lancer_arreter) et à
        # désactiver ce bouton pendant l'attente, pour qu'un double-clic ne
        # relance pas un second arrêt en parallèle sur la même instance.
        # Retiré du set dans le bloc finally du thread d'arrêt, que le
        # shutdown réseau ait réussi ou non (repli sur kill direct inclus).
        self._profils_en_cours_arret: set[str] = set()
        # PATCH (bouton Free par carte, demande utilisateur : "que chque
        # card de profisl gere") -- même pattern que
        # self._profils_en_cours_arret juste au-dessus, mais pour l'action
        # Free (force_unlink) : {nom_profil} entre l'envoi de la commande
        # (cf. _on_clic_free_pilote_pour_profil) et sa confirmation par le
        # serveur (cf. _sur_force_unlink_ok) -- pilote l'état visuel
        # "libération en cours" du 2e bouton peint sur chaque carte (cf.
        # DELEGATE_ROLE_ETAT_FREE) et empêche un double-clic d'envoyer un
        # second force_unlink en double pendant l'aller-retour réseau.
        self._profils_en_cours_free: set[str] = set()
        # PATCH (retour utilisateur : "lorsque on clic sur le bouton de
        # lancement dun profils de navigaiton, il reste inchagé et demare
        # apres eniviron 30 ou 50 sec avant de changer de forme visuelle,
        # je veux que pendant ce lapas de temps on modife sont icone on
        # met demarage") -- même pattern que self._profils_en_cours_arret
        # ci-dessus, mais pour le LANCEMENT : {nom_profil} entre le clic
        # (cf. _lancer_instance_pour_profil, juste après le Popen) et la
        # confirmation réelle par le serveur que l'instance est bien
        # connue (cf. _sur_liste_instances_recue, qui réconcilie alors
        # self._instance_id_par_profil avec la réalité serveur -- avant
        # ça, self._instance_id_par_profil[nom_profil] est certes déjà
        # posé localement dès le Popen, mais reste effacé à chaque
        # instances_list reçue tant que le serveur ne connaît pas encore
        # cette instance, cf. boucle "Réconcilie [...] avec la réalité
        # serveur" -- d'où les 30-50s où le bouton restait figé sur
        # l'icône "inactif" sans aucun feedback). Retiré du set dès que
        # nom_profil réapparaît dans self._instance_id_par_profil
        # (lancement confirmé) ou en cas d'échec de lancement (Popen qui
        # lève OSError) -- jamais laissé bloqué indéfiniment sur cet état.
        self._profils_en_cours_lancement: set[str] = set()
        # PATCH (bouton lancer/arrêter par profil, demande utilisateur) --
        # nom du profil dont le bouton (peint par ProfilsGridItemDelegate)
        # vient de recevoir un MouseButtonPress, en attente du
        # MouseButtonRelease correspondant (cf. eventFilter) ; None si
        # aucun press en cours sur un bouton. Pattern presse/relâche
        # standard d'un bouton -- évite de déclencher lancer/arrêter sur
        # un simple press si l'utilisateur glisse hors du bouton avant de
        # relâcher.
        self._item_bouton_presse: str | None = None
        # PATCH (bouton Free par profil, cf. eventFilter et
        # _on_clic_free_pilote_pour_profil) -- même pattern presse/relâche
        # que _item_bouton_presse ci-dessus, mais pour le second bouton
        # peint sur la carte (rect_bouton_free). Un état séparé est
        # nécessaire : un press sur le bouton lancer/arrêter puis un
        # relâchement sur le bouton Free (ou l'inverse) ne doit déclencher
        # ni l'un ni l'autre, exactement comme pour deux QPushButton
        # distincts.
        self._item_bouton_free_presse: str | None = None
        # PATCH (badge YouTube togglable, demande utilisateur explicite :
        # "un badge youtube ... que lon peu activer et desactiver par
        # clic dessus") -- même pattern presse/relâche que
        # _item_bouton_presse/_item_bouton_free_presse ci-dessus, pour le
        # 3e élément cliquable peint sur la carte (rect_bouton_youtube).
        self._item_bouton_youtube_presse: str | None = None
        # PATCH (badge Favori togglable, demande utilisateur explicite :
        # "je veux que on peu mettre un statut de favoris pour un
        # profils") -- même pattern presse/relâche que
        # _item_bouton_youtube_presse ci-dessus, pour le 4e élément
        # cliquable peint sur la carte (rect_bouton_favori).
        self._item_bouton_favori_presse: str | None = None
        # {nom_profil: timestamp monotone de démarrage} -- PATCH (retour
        # utilisateur : "je veux aussi que on affiche la duree de chaque
        # instance, le temps detat actif de chaque instance"). time.monotonic()
        # plutôt que datetime/time.time() : insensible à un changement
        # d'horloge système pendant que l'instance tourne (cf. usage identique
        # ailleurs dans ce fichier pour des mesures de durée). Alimenté aux
        # mêmes points d'entrée que self._instance_id_par_profil (lancement
        # local ET découverte d'une instance déjà active côté serveur, cf.
        # _sur_liste_instances_recue) ; retiré aux mêmes points de sortie.
        self._heure_debut_par_profil: dict[str, float] = {}
        # {instance_id: pid} -- PID OS réel de chaque instance connue, reçu via
        # instances_list (cf. srv_liste_instances_message, champ "pid" ajouté --
        # PATCH demandé par l'utilisateur : "je veux que ça tue directement le
        # processus qui lui est associé"). Alimenté même pour une instance
        # orpheline (pas de Popen local suivi) -- c'est justement le cas que ce
        # dict comble : _processus_instances ne la connaît pas, mais son PID OS
        # reste atteignable directement via ce dict + os.kill().
        self._pid_par_instance: dict[str, int] = {}
        # Connexion du signal cross-thread (cf. docstring de
        # _arret_instance_termine, juste avant la classe) -- Qt.QueuedConnection
        # explicite : garantit que le slot s'exécute sur le thread propriétaire
        # de CET objet (thread Qt principal, puisque ProfilsInstancesScreen est
        # construit sur ce thread-là), peu importe le thread depuis lequel
        # .emit() est appelé (ici : le thread _travail_arret dédié à chaque
        # arrêt d'instance, cf. _arreter_instance_pour_profil).
        self._arret_instance_termine.connect(self._sur_arret_instance_termine, Qt.QueuedConnection)
        self._fermeture_orpheline_terminee.connect(self._apres_fermeture_orpheline, Qt.QueuedConnection)
        # --- État de rafraîchissement -- mêmes attributs/logique
        # qu'InstanceApercuScreen (cf. PanneauRenduInstance : bouton
        # ponctuel / case auto+FPS / statut) : jamais de flux continu
        # imposé par défaut, cf. docstring d'InstanceApercuScreen. ---
        self._derniere_image: Optional[QImage] = None
        self._derniere_taille_frame: tuple[int, int] = (1280, 800)
        self._rafraichissement_auto_actif = False
        self._rafraichissement_ponctuel_en_attente = False
        self._requete_id_liste_onglets: Optional[str] = None  # cf. bloc Onglet navigateur (listTabs/switchTab)
        self._requete_id_switch_onglet: Optional[str] = None
        # cf. onglet "Propriétés" du panneau droit (PanneauProprietesInstance)
        # -- même pattern que _requete_id_liste_onglets ci-dessus, requête
        # séparée puisque get_fingerprint et listTabs peuvent être en vol
        # en même temps (sélection d'une instance déclenche les deux).
        self._requete_id_proprietes: Optional[str] = None
        # Sous-onglet "Réel" du panneau Propriétés (cf. get_fingerprint_reel)
        # -- requête indépendante de _requete_id_proprietes ci-dessus : les
        # deux sous-onglets (Fictif/Réel) sont demandés en parallèle à
        # l'ouverture du panneau, chacun avec son propre requete_id, pour
        # ne jamais faire attendre l'un après la réponse de l'autre.
        self._requete_id_proprietes_reelles: Optional[str] = None
        # État affiché par la carte de stat "Serveur central" du dashboard
        # (cf. _creer_carte_stat/_rafraichir_cartes_stats) -- mis à jour
        # par _sur_connecte/_sur_echec_connexion.
        self._serveur_connecte = False
        # BUGFIX (détecté à l'instanciation) : self.client_reseau n'est
        # normalement assigné pour de vrai que plus bas (soit None si
        # RESEAU_DASHBOARD_DISPONIBLE est faux, soit un vrai
        # ClientReseauAutoniaX sinon) -- mais _construire_ui() ci-dessous
        # appelle _rafraichir_cartes_stats(), qui lit déjà self.client_reseau
        # pour la carte "Serveur central". Sans cette pré-initialisation,
        # AttributeError immédiat à la construction de l'écran. None ici
        # est écrasé sans effet de bord juste après par l'affectation
        # réelle (RESEAU_DASHBOARD_DISPONIBLE ou pas).
        self.client_reseau: Optional["ClientReseauAutoniaX"] = None

        # --- Test de proxy dans un QThread séparé -- JAMAIS sur le
        # thread GUI (cf. TestProxyWorker : une requête HTTP via un proxy
        # potentiellement lent/hors service peut bloquer plusieurs
        # secondes). Même pattern que self._detection_thread ailleurs
        # dans ce fichier (DetectionWorker) : un seul worker/thread pour
        # toute la durée de vie de cet écran, démarré ici. Doit exister
        # AVANT _construire_ui() ci-dessous, qui connecte resultat_pret
        # au slot de la carte de création. ---
        self._test_proxy_thread = QThread(self)
        self._test_proxy_worker = TestProxyWorker()
        self._test_proxy_worker.moveToThread(self._test_proxy_thread)
        self._test_proxy_thread.start()
        # Identifiant de la requête de test en cours (None si aucune) --
        # incrémenté à chaque clic sur "Tester le proxy" (cf.
        # _on_clic_tester_proxy) pour ignorer un résultat obsolète qui
        # reviendrait après qu'un NOUVEAU test a déjà été lancé
        # entre-temps (clic rapide sur "Tester" deux fois de suite avant
        # que la première requête n'ait fini).
        self._id_test_proxy_en_cours: Optional[str] = None

        # --- Drapeau du résultat de test de proxy -- même pattern que
        # self._test_proxy_thread juste au-dessus (QThread dédié, jamais
        # de requête réseau sur le thread GUI) et que PanneauProprietesInstance
        # plus bas dans ce fichier (cf. DrapeauWorker, réutilisé tel quel
        # ici, simplement avec sa propre instance de thread/worker --
        # chaque écran garde le sien, pas de partage entre écrans).
        # PATCH (demande utilisateur explicite : "lorsque on teste la
        # connexion proxy le drapeua doit aussi aparaitre").
        self._drapeau_test_proxy_thread = QThread(self)
        self._drapeau_test_proxy_worker = DrapeauWorker()
        self._drapeau_test_proxy_worker.moveToThread(self._drapeau_test_proxy_thread)
        self._drapeau_test_proxy_thread.start()
        self._id_drapeau_test_proxy_en_cours: Optional[str] = None

        # PATCH (demande utilisateur explicite : "le pays doit venir du
        # proxy") -- dernier code pays (ISO alpha-2) obtenu par un test de
        # proxy RÉUSSI dans la carte de création, cf. _sur_resultat_test_proxy
        # (l'écrit) et _on_clic_nouveau_profil (le lit pour l'attacher au
        # profil créé, via enregistrer_config_profil). Remis à None dès que
        # le champ proxy est modifié (cf. _construire_carte_creation_profil,
        # connexion sur textChanged) -- un pays ne doit jamais rester
        # associé à un texte de proxy différent de celui réellement testé.
        self._dernier_code_pays_teste: Optional[str] = None

        # --- Drapeaux affichés sur les cartes de la grille (badge pays,
        # cf. ProfilsGridItemDelegate.paint) -- PATCH (demande utilisateur
        # explicite : "je veux que on rajoute ... le pays"). Même pattern
        # que self._drapeau_test_proxy_worker/PanneauProprietesInstance
        # ci-dessus (QThread dédié, jamais de requête réseau sur le thread
        # GUI) mais worker SÉPARÉ : celui de la carte de création cible un
        # seul QLabel, celui-ci doit pouvoir alimenter N cartes à la fois
        # et déclenche un repaint de grille (pas un setPixmap ciblé) à
        # chaque résultat -- rôles suffisamment différents pour ne pas
        # partager la même instance de worker.
        # self._pixmaps_drapeaux_grille : cache EN MÉMOIRE {code_pays:
        # QPixmap|None} -- lu directement par ProfilsGridItemDelegate.paint
        # via self.parent()._pixmaps_drapeaux_grille (parent = la
        # QListWidget, dont le parent Python logique est CET écran, cf.
        # _construire_bloc_onglet_profils). None = déjà tenté, échoué
        # (jamais retenté en boucle à chaque repaint).
        self._pixmaps_drapeaux_grille: dict[str, Optional[QPixmap]] = {}
        self._codes_pays_demandes_grille: set[str] = set()  # évite les doublons de requête pendant un même téléchargement en vol
        self._drapeau_grille_thread = QThread(self)
        self._drapeau_grille_worker = DrapeauWorker()
        self._drapeau_grille_worker.moveToThread(self._drapeau_grille_thread)
        self._drapeau_grille_thread.start()
        self._drapeau_grille_worker.resultat_pret.connect(self._sur_drapeau_grille_recu)

        # PATCH (retour utilisateur explicite : "je ne voir pas le
        # rapeua ni le pays") -- profils créés avant ce patch, ou créés
        # sans jamais tester le proxy dans la carte de création, n'ont
        # AUCUN code pays enregistré (cf. obtenir_config_profil(...)["pays"],
        # None par défaut) même quand ils ont bien un proxy configuré --
        # rien ne fait de géoip automatique en tâche de fond (cf.
        # docstring de definir_pays_config_profil : volontairement, pour
        # ne pas multiplier les requêtes réseau à chaque affichage).
        # Worker DÉDIÉ (pas celui de la carte de création, self._test_proxy_worker
        # -- réutiliser le même exposerait à un id_requete de la carte de
        # création qui écraserait/serait écrasé par celui d'une
        # localisation lancée depuis le menu contextuel d'une carte,
        # cf. _id_localisation_proxy_en_cours ci-dessous) pour "Localiser
        # le proxy" dans le menu contextuel (cf. _afficher_menu_profil,
        # _on_clic_localiser_proxy_profil).
        self._localisation_proxy_thread = QThread(self)
        self._localisation_proxy_worker = TestProxyWorker()
        self._localisation_proxy_worker.moveToThread(self._localisation_proxy_thread)
        self._localisation_proxy_thread.start()
        self._localisation_proxy_worker.resultat_pret.connect(self._sur_resultat_localisation_proxy)
        # {id_requete: nom_profil} -- plusieurs localisations peuvent être
        # lancées à la suite (clic droit sur plusieurs cartes) avant que
        # la première ait répondu ; ce dict route chaque résultat vers le
        # bon profil sans dépendre d'un unique id "en cours" global (à la
        # différence de self._id_test_proxy_en_cours dans la carte de
        # création, où un seul test peut être en vol à la fois -- un seul
        # champ proxy visible).
        self._localisations_proxy_en_cours: dict[str, str] = {}

        self._construire_ui()
        self._rafraichir_liste_profils()

        # PATCH (retour utilisateur : "je veux aussi que on affiche la
        # duree de chaque instance") -- timer dédié, indépendant de tout
        # évènement réseau (contrairement à _rafraichir_liste_profils,
        # reconstruite seulement sur changement réel de contenu) : la
        # durée affichée doit progresser seconde par seconde même si rien
        # d'autre ne change côté serveur. 1000ms : suffisant pour un
        # affichage "il y a X min/h", inutile d'aller plus fin pour ce
        # niveau de granularité (cf. _formater_duree_activite, pas de
        # dixième de seconde affiché). Démarré ici (avant le early return
        # RESEAU_DASHBOARD_DISPONIBLE juste en dessous) car sans effet de
        # bord s'il n'y a aucun profil actif à ce moment -- pas besoin
        # d'un chemin séparé pour ce cas.
        self._timer_durees_profils = QTimer(self)
        self._timer_durees_profils.timeout.connect(self._rafraichir_durees_profils_actifs)
        self._timer_durees_profils.start(1000)

        # AJOUT (demande explicite utilisateur : "quand je clic sur sont
        # naviatuer, quand sa prend le focus, sont profils dans le panneau
        # de clone est en surbrillance ... jai du mal a reconnaitre qui
        # est tels naviatuer") -- surveille PÉRIODIQUEMENT quelle fenêtre
        # Windows a le focus (cf. _pid_fenetre_premier_plan/_instance_
        # locale_pour_pid_fenetre plus haut dans ce fichier) pour émettre
        # focus_navigateur_local_change dès qu'elle correspond (ou cesse
        # de correspondre) à un navigateur lancé DEPUIS CE Dashboard.
        # Indépendant du réseau serveurT/serveur local (RESEAU_DASHBOARD_
        # DISPONIBLE plus bas) : posé AVANT ce garde-fou -- la détection
        # de focus n'a besoin ni de websockets ni du serveur local, juste
        # de self._processus_instances déjà peuplé par _lancer_instance_
        # pour_profil, qui ne dépend lui non plus d'aucun des deux.
        # Intervalle 500ms : assez réactif pour un alt-tab/clic perçu comme
        # immédiat, assez espacé pour rester négligeable en CPU (un
        # CreateToolhelp32Snapshot par tick, cf. _pid_parent -- pas fait à
        # chaque frame). Dernier profil signalé mémorisé (_dernier_nom_
        # profil_focus) pour n'émettre le signal QUE lors d'un changement
        # réel, pas à chaque tick -- un panneau clone qui reconstruirait sa
        # table 2x/seconde pour rien serait un gaspillage inutile côté
        # TaskConfigScreen (cf. son récepteur, MainWindow relais).
        self._dernier_nom_profil_focus: Optional[str] = None
        self._minuteur_focus_navigateur = QTimer(self)
        self._minuteur_focus_navigateur.timeout.connect(self._sur_tick_focus_navigateur)
        self._minuteur_focus_navigateur.start(500)

        if not RESEAU_DASHBOARD_DISPONIBLE:
            # websockets absent -- l'écran s'affiche mais reste inerte,
            # avec un message explicite plutôt qu'un crash (même convention
            # défensive que VISION_DISPONIBLE pour numpy/cv2).
            self.label_statut_serveur.setText("Module 'websockets' non installé -- Dashboard indisponible")
            self.label_statut_serveur.setStyleSheet("color: #f38ba8; font-size: 12px;")
            self.client_reseau = None
            return

        # role="observateur" (ex-"dashboard", renommé -- cf. décision utilisateur) :
        # le Dashboard ne fait que de l'aperçu/streaming, jamais de commande d'action
        # réelle -- il peut donc coexister sans conflit avec un pilote (Task en cours
        # d'exécution) sur la même instance, et avec d'autres observateurs.
        self.client_reseau = ClientReseauAutoniaX(SERVER_URL_DASHBOARD, role="observateur", id_client="dashboard-autoniax")
        self.client_reseau.connecte.connect(self._sur_connecte)
        self.client_reseau.echec_connexion.connect(self._sur_echec_connexion)
        self.client_reseau.liste_instances_recue.connect(self._sur_liste_instances_recue)
        self.client_reseau.frame_recue.connect(self._sur_frame_recue)
        self.client_reseau.erreur_recue.connect(self._sur_erreur_recue)
        self.client_reseau.instance_deliee.connect(self._sur_instance_deliee)
        self.client_reseau.liaison_echouee.connect(self._sur_liaison_echouee)
        self.client_reseau.command_result_recu.connect(self._sur_command_result_onglet)
        self.client_reseau.force_unlink_ok_recu.connect(self._sur_force_unlink_ok)

        # Démarre le thread réseau APRÈS avoir connecté tous les signaux
        # ci-dessus -- sans quoi les tout premiers événements (connecte,
        # liste_instances_recue) pourraient être émis avant que quiconque
        # ne les écoute.
        self.client_reseau.demarrer()

    # --- Construction de l'UI ---

    def _ouvrir_dialogue_nouveau_profil(self, type_instance: str):
        """PATCH (retour utilisateur explicite : "on vas enlever ce card ,
        on vas lajouter dans longlet des type de proifls (chrome ,
        camoufox) ... il yauras toujour le champ de noms et de test de
        proxy et le bouton de validation de creation") -- remplace
        _construire_carte_creation_profil (carte fixe autrefois posée au
        milieu entre panneau_gauche et panneau_droit, SUPPRIMÉE) par un
        QDialog modal, ouvert à la demande depuis le bouton "+ Créer un
        profil" de CET onglet (cf. _construire_bloc_onglet_profils,
        bouton_creer_profil) -- un dialogue par clic, détruit à la
        fermeture (WA_DeleteOnClose), plutôt qu'une carte persistante :
        plus de widgets de formulaire à garder synchronisés en
        permanence sur self, tout vit le temps du dialogue.

        type_instance ("chrome" ou "camoufox") est REÇU en paramètre,
        capturé par la fermeture du connect() du bouton de l'onglet
        appelant (cf. _construire_bloc_onglet_profils) -- plus de
        sélecteur Chrome/Camoufox dans le formulaire lui-même (retour
        utilisateur explicite : "le type se déduise simplement de
        l'onglet actif") : le type est déjà déterminé avant même que ce
        dialogue s'ouvre, par la carte sur laquelle l'utilisateur a
        cliqué.

        Réutilise TELS QUELS TestProxyWorker/DrapeauWorker déjà démarrés
        dans __init__ (self._test_proxy_worker, self._drapeau_test_proxy_worker)
        et leurs slots existants (_on_clic_tester_proxy, _sur_resultat_test_proxy,
        _demander_drapeau_test_proxy, _sur_drapeau_test_proxy_recu,
        _on_clic_nouveau_profil) -- ces méthodes lisaient jusqu'ici des
        attributs FIXES sur self (self._champ_nom_creation_profil, etc.),
        posés une seule fois à la construction de l'écran. Elles lisent
        désormais les MÊMES NOMS D'ATTRIBUTS, mais réaffectés à chaque
        ouverture de dialogue (cf. plus bas) -- un seul dialogue peut être
        ouvert à la fois (modal), donc aucun risque de collision entre
        deux formulaires simultanés malgré ce partage."""
        dialogue = DialogueAutoniaXBase("Créer un nouveau profil", self, largeur_min=360)
        dialogue.setObjectName("DialogueNouveauProfilOnglet")
        dialogue.setAttribute(Qt.WA_DeleteOnClose, True)

        # --- Icône + titre fixe désormais portés par DialogueTitleBar
        # (cf. DialogueAutoniaXBase) -- même titre invariant "Créer un
        # nouveau profil" qu'avant (cf. retour utilisateur explicite :
        # "le titre de la carte reste toujours [...] Créer un nouveau
        # profil"), plus besoin d'un en-tête dupliqué dans le contenu. ---

        # --- Nom du profil ---
        dialogue.ajouter_widget(QLabel("Nom du profil"))
        self._champ_nom_creation_profil = QLineEdit(dialogue.zone_contenu)
        self._champ_nom_creation_profil.setObjectName("DashboardNewProfilInput")
        self._champ_nom_creation_profil.setPlaceholderText("Nom du profil")
        dialogue.ajouter_widget(self._champ_nom_creation_profil)

        # --- Proxy -- TOUJOURS visible, quel que soit le type (cf.
        # décision utilisateur historique conservée : "je veux que pour
        # tout les compte tu mets les donne proxy"). ---
        dialogue.ajouter_widget(QLabel("Proxy (optionnel)"))
        self._champ_proxy_creation_profil = QLineEdit(dialogue.zone_contenu)
        self._champ_proxy_creation_profil.setPlaceholderText("http://user:motdepasse@hote:port")
        # PATCH (demande utilisateur explicite : "le pays doit venir du
        # proxy") -- toute modification du texte invalide le dernier pays
        # testé (self._dernier_code_pays_teste, cf. _sur_resultat_test_proxy) :
        # sans ça, un pays obtenu pour un PREMIER proxy testé resterait
        # associé au profil créé même si l'utilisateur a ensuite changé le
        # texte du champ pour un proxy différent, jamais retesté.
        self._champ_proxy_creation_profil.textChanged.connect(
            lambda _texte: setattr(self, "_dernier_code_pays_teste", None)
        )
        dialogue.ajouter_widget(self._champ_proxy_creation_profil)

        self._label_erreur_creation_profil = QLabel("", dialogue.zone_contenu)
        self._label_erreur_creation_profil.setStyleSheet(f"color: {Mocha.red}; font-size: 11px;")
        self._label_erreur_creation_profil.setWordWrap(True)
        self._label_erreur_creation_profil.hide()
        dialogue.ajouter_widget(self._label_erreur_creation_profil)

        # --- Bouton + résultat du test de proxy (cf. TestProxyWorker) --
        # purement informatif, ne crée rien. ---
        self._bouton_tester_proxy = QToolButton(dialogue.zone_contenu)
        self._bouton_tester_proxy.setText("Tester le proxy")
        self._bouton_tester_proxy.setIcon(qta.icon("mdi6.connection", color=Mocha.text))
        self._bouton_tester_proxy.setCursor(Qt.PointingHandCursor)
        self._bouton_tester_proxy.setObjectName("ProfilMenuButton")
        self._bouton_tester_proxy.setToolButtonStyle(Qt.ToolButtonTextBesideIcon)
        self._bouton_tester_proxy.clicked.connect(self._on_clic_tester_proxy)
        dialogue.ajouter_widget(self._bouton_tester_proxy)

        self._label_resultat_test_proxy = QLabel("", dialogue.zone_contenu)
        self._label_resultat_test_proxy.setWordWrap(True)
        self._label_resultat_test_proxy.setStyleSheet(f"color: {Mocha.subtext0}; font-size: 11px;")
        self._label_resultat_test_proxy.hide()

        # PATCH (demande utilisateur explicite : "lorsque on teste la
        # connexion proxy le drapeua doit aussi aparaitre") -- même widget
        # PNG que _demander_drapeau/_sur_drapeau_recu (PanneauProprietesInstance),
        # posé ICI à côté du texte de résultat, via self._drapeau_test_proxy_worker
        # (partagé, cf. __init__) -- pas de police/emoji, pour un rendu
        # fiable du drapeau.
        ligne_resultat_test_proxy = QHBoxLayout()
        ligne_resultat_test_proxy.setSpacing(6)
        self._label_drapeau_test_proxy = QLabel(dialogue.zone_contenu)
        self._label_drapeau_test_proxy.setFixedSize(24, 18)
        self._label_drapeau_test_proxy.hide()
        ligne_resultat_test_proxy.addWidget(self._label_drapeau_test_proxy, 0, Qt.AlignTop)
        ligne_resultat_test_proxy.addWidget(self._label_resultat_test_proxy, 1)
        dialogue.ajouter_layout(ligne_resultat_test_proxy)

        # --- Bouton de création -- ferme le dialogue lui-même après
        # création réussie (cf. _on_clic_nouveau_profil, qui appelle
        # dialogue.accept() en toute fin, une fois le profil enregistré
        # et la liste rafraîchie). type_instance capturé par cette
        # fermeture -- c'est lui, pas un sélecteur du formulaire, qui
        # détermine dans quel onglet/registre le profil est créé. ---
        bouton_creer = _creer_bouton_dialogue("Créer le profil", primaire=True, parent=dialogue.zone_contenu)
        bouton_creer.setIcon(qta.icon("mdi6.plus", color=Mocha.crust))
        bouton_creer.clicked.connect(lambda: self._on_clic_nouveau_profil(type_instance, dialogue))
        dialogue.ajouter_widget(bouton_creer)

        self._champ_nom_creation_profil.setFocus()
        dialogue.exec()

    def _on_clic_tester_proxy(self):
        """PATCH (retour utilisateur explicite : "on vas meme tester le
        proxy pour voir si sa fontionne, recuperer les donne comme le
        pays, ladrese ip") -- lit le champ proxy du formulaire (pas encore
        enregistré/créé, purement un test), le parse (cf. parser_proxy),
        et délègue la requête réseau réelle à self._test_proxy_worker
        (cf. TestProxyWorker, tourne dans son propre QThread -- jamais de
        requête HTTP bloquante ici, sur le thread GUI).

        BUG CORRIGÉ (retour utilisateur explicite : "si je netre aucune
        valeur, sa vas prendre mon ip lcl et lenvoyer pour le test et sa
        vas afficher sucess, non je veux que si cest vide sa me signal
        quand meme que je ne suis pas masquer") -- un champ proxy vide NE
        déclenche PLUS aucune requête réseau : avant, proxy=None était
        quand même envoyé à TestProxyWorker, qui testait alors la
        connexion INTERNET DIRECTE (sans ProxyHandler, cf. son ancienne
        docstring) et recevait un succès légitime -- techniquement vrai
        (la connexion marche) mais trompeur ici, puisque ça affichait "✓
        Proxy fonctionnel" avec la vraie IP locale de l'utilisateur alors
        qu'aucun proxy n'est en jeu et qu'il n'est donc PAS masqué. Le
        champ vide est désormais traité comme un cas à part, avant même
        de solliciter le worker : affiche directement un avertissement
        (orange, ni succès ni échec réseau) et s'arrête là."""
        texte_proxy = self._champ_proxy_creation_profil.text().strip()
        if not texte_proxy:
            self._label_resultat_test_proxy.setText(
                "⚠ Aucun proxy renseigné -- votre IP réelle ne sera PAS masquée."
            )
            self._label_resultat_test_proxy.setStyleSheet(f"color: {Mocha.yellow}; font-size: 11px;")
            self._label_resultat_test_proxy.show()
            return

        proxy = parser_proxy(texte_proxy)
        if proxy is None:
            self._label_resultat_test_proxy.setText(
                "Format de proxy non reconnu -- ex: host:port:utilisateur:motdepasse ou http://utilisateur:motdepasse@hote:port."
            )
            self._label_resultat_test_proxy.setStyleSheet(f"color: {Mocha.red}; font-size: 11px;")
            self._label_resultat_test_proxy.show()
            return

        id_requete = str(uuid.uuid4())
        self._id_test_proxy_en_cours = id_requete
        self._bouton_tester_proxy.setEnabled(False)
        self._bouton_tester_proxy.setText("Test en cours...")
        self._label_resultat_test_proxy.setText("Connexion en cours, jusqu'à 10s...")
        self._label_resultat_test_proxy.setStyleSheet(f"color: {Mocha.subtext0}; font-size: 11px;")
        self._label_resultat_test_proxy.show()
        self._label_drapeau_test_proxy.hide()
        self._test_proxy_worker.demande_test.emit(id_requete, proxy)

    def _sur_resultat_test_proxy(self, id_requete: str, succes: bool, infos: dict):
        """Slot connecté à TestProxyWorker.resultat_pret (cf.
        _construire_ui, connexion faite une fois, cette méthode reste sur
        le thread GUI grâce à Qt.QueuedConnection implicite -- signal émis
        depuis le thread du worker, récepteur vivant sur le thread GUI).

        Ignore silencieusement tout résultat dont l'id_requete ne
        correspond plus à self._id_test_proxy_en_cours (cf. sa docstring
        dans __init__) -- cas d'un second clic sur "Tester le proxy"
        pendant qu'un premier test était encore en vol : seul le DERNIER
        clic doit mettre à jour l'affichage, pas une réponse tardive et
        désormais obsolète du premier."""
        if id_requete != self._id_test_proxy_en_cours:
            return
        self._id_test_proxy_en_cours = None
        self._bouton_tester_proxy.setEnabled(True)
        self._bouton_tester_proxy.setText("Tester le proxy")

        if succes:
            self._label_resultat_test_proxy.setText(
                f"✓ Proxy fonctionnel -- IP {infos['ip']} ({infos['ville']}, {infos['pays']})"
            )
            self._label_resultat_test_proxy.setStyleSheet(f"color: {Mocha.green}; font-size: 11px;")
            # PATCH (demande utilisateur explicite : "lorsque on teste la
            # connexion proxy le drapeua doit aussi aparaitre") -- code_pays
            # ajouté par TestProxyWorker (cf. countryCode ip-api.com),
            # absent pour un résultat de test antérieur à ce patch (repli
            # silencieux : pas de drapeau plutôt qu'une exception).
            code_pays = infos.get("code_pays")
            # PATCH (demande utilisateur explicite : "le pays doit venir
            # du proxy") -- mémorisé ICI (test réussi), pas seulement
            # utilisé pour le drapeau visuel du formulaire : c'est cette
            # valeur que _on_clic_nouveau_profil lit pour l'attacher au
            # profil au moment de sa création (cf. self._dernier_code_pays_teste,
            # docstring dans __init__).
            self._dernier_code_pays_teste = code_pays
            if code_pays:
                self._demander_drapeau_test_proxy(code_pays)
            else:
                self._label_drapeau_test_proxy.hide()
        else:
            self._label_resultat_test_proxy.setText(f"✗ {infos.get('erreur', 'Échec du test.')}")
            self._label_resultat_test_proxy.setStyleSheet(f"color: {Mocha.red}; font-size: 11px;")
            self._label_drapeau_test_proxy.hide()
            self._dernier_code_pays_teste = None
        self._label_resultat_test_proxy.show()

    def _demander_drapeau_test_proxy(self, code_pays: str):
        """Affiche le PNG du drapeau à côté du résultat du test de proxy
        -- même principe que PanneauProprietesInstance._demander_drapeau
        (cf. sa docstring), simplifié : un seul label cible possible ici
        (self._label_drapeau_test_proxy), pas de grille dynamique à gérer,
        donc pas besoin d'un cache mémoire ni d'une liste de labels en
        attente -- un nouveau test de proxy pendant qu'un téléchargement
        de drapeau précédent est encore en vol est déjà couvert par
        self._id_drapeau_test_proxy_en_cours (cf. _sur_drapeau_test_proxy_recu),
        même garde-fou que self._id_test_proxy_en_cours pour le test
        lui-même."""
        id_requete = str(uuid.uuid4())
        self._id_drapeau_test_proxy_en_cours = id_requete
        self._label_drapeau_test_proxy.setProperty("code_pays_attendu", code_pays)
        self._drapeau_test_proxy_worker.demande_drapeau.emit(id_requete, code_pays)

    def _sur_drapeau_test_proxy_recu(self, id_requete: str, chemin):
        """Slot connecté à self._drapeau_test_proxy_worker.resultat_pret
        (cf. __init__) -- ignore un résultat obsolète (id_requete ne
        correspond plus à self._id_drapeau_test_proxy_en_cours, cf. même
        garde-fou que _sur_resultat_test_proxy pour le test de proxy
        lui-même) ou un chemin manquant (téléchargement échoué, cf.
        _telecharger_drapeau_pays -- le label reste alors caché plutôt
        que d'afficher un pixmap vide)."""
        if id_requete != self._id_drapeau_test_proxy_en_cours:
            return
        if chemin:
            self._label_drapeau_test_proxy.setPixmap(QPixmap(str(chemin)))
            self._label_drapeau_test_proxy.show()
        else:
            self._label_drapeau_test_proxy.hide()

    def _demander_drapeau_grille(self, code_pays: str):
        """Déclenche (si besoin) le chargement du drapeau `code_pays` pour
        le badge pays des cartes de la grille -- PATCH (demande
        utilisateur explicite : "je veux que on rajoute ... le pays").
        Ne fait RIEN si déjà en cache mémoire (cf.
        self._pixmaps_drapeaux_grille, y compris un échec déjà enregistré
        -- valeur None -- pour ne jamais reboucler indéfiniment sur un
        code pays dont le téléchargement a échoué une première fois) ni
        si une requête est déjà en vol pour ce même code (cf.
        self._codes_pays_demandes_grille) -- plusieurs cartes peuvent
        partager le même pays, une seule requête réseau suffit pour
        toutes les alimenter (cf. _sur_drapeau_grille_recu, qui repaint
        TOUTE la grille, pas une carte précise)."""
        if code_pays in self._pixmaps_drapeaux_grille or code_pays in self._codes_pays_demandes_grille:
            return
        self._codes_pays_demandes_grille.add(code_pays)
        self._drapeau_grille_worker.demande_drapeau.emit(code_pays, code_pays)

    def _sur_drapeau_grille_recu(self, code_pays: str, chemin):
        """Slot connecté à self._drapeau_grille_worker.resultat_pret (cf.
        __init__) -- met à jour le cache mémoire (y compris en cas
        d'échec, chemin=None : évite de retenter indéfiniment, cf.
        _demander_drapeau_grille) puis demande un repaint de TOUTES les
        listes de profils (contrairement à _sur_drapeau_test_proxy_recu,
        qui cible un seul QLabel connu à l'avance -- ici, un nombre
        arbitraire de cartes potentiellement réparties dans les DEUX
        onglets peuvent utiliser ce même pays, pas de ciblage possible
        item par item sans reparcourir toute la grille -- un simple
        .viewport().update() suffit et reste bon marché, Qt ne redessine
        que ce qui est réellement visible à l'écran)."""
        self._codes_pays_demandes_grille.discard(code_pays)
        self._pixmaps_drapeaux_grille[code_pays] = QPixmap(str(chemin)) if chemin else None
        for infos_onglet in self._onglets_profils.values():
            infos_onglet["liste"].viewport().update()

    def _construire_bloc_onglet_profils(self, type_instance: str) -> QWidget:
        """Construit UN bloc complet et autonome (liste de profils du type
        `type_instance` + sa propre rangée de boutons de lot) destiné à
        devenir le contenu d'un onglet de self._tabs_profils. Appelée une
        fois par type ("chrome", "camoufox") depuis _construire_ui --
        garde les deux blocs strictement identiques en structure/QSS/
        comportement, cf. commentaire d'appel.

        Tous les widgets créés ici sont stockés dans
        self._onglets_profils[type_instance] (dict), PAS en attributs
        plats du style self.liste_instances -- il y a désormais 2 listes
        et 2 jeux de boutons, un seul nom d'attribut ne suffirait plus à
        les distinguer. Les méthodes qui opéraient auparavant sur
        self.liste_instances doivent maintenant soit itérer sur
        self._onglets_profils.values() (cas "toutes les listes doivent
        rester à jour, même en arrière-plan" : _rafraichir_liste_profils,
        _rafraichir_durees_profils_actifs, _rafraichir_etats_boutons_liste_profils),
        soit recevoir explicitement le type_instance concerné (cas
        "action déclenchée par UN widget précis" : eventFilter,
        _afficher_menu_profil, les callbacks de boutons ci-dessous, tous
        connectés via une fermeture qui capture type_instance)."""
        bloc = QWidget()
        layout_bloc = QVBoxLayout(bloc)
        layout_bloc.setContentsMargins(0, 8, 0, 0)
        layout_bloc.setSpacing(10)

        liste = QListWidget()
        liste.setObjectName("ProfilsGridList")
        # PATCH (badges proxy/pays/YouTube) -- référence Python DIRECTE
        # vers cet écran, posée sur l'objet `liste` lui-même : le
        # delegate (cf. ProfilsGridItemDelegate.paint) accède à cet écran
        # via self.parent() (= liste, cf. `ProfilsGridItemDelegate(liste)`
        # plus bas), PAS via liste.parent() (= le QWidget conteneur
        # `bloc`, aucun rapport avec cet écran) -- c'est donc bien SUR
        # liste, pas sur bloc, que cette référence doit être posée.
        # Nécessaire pour lire self._pixmaps_drapeaux_grille et appeler
        # self._demander_drapeau_grille depuis paint() (cf. son bloc
        # badge pays) sans dupliquer ce cache par liste.
        liste._ecran_profils_instances = self
        # PATCH (retour utilisateur : "je veux que pour les profils actif
        # il on des bordure vert" + "je veux aussi que on affiche la duree
        # de chaque instance") -- delegate custom dédié (cf.
        # ProfilsGridItemDelegate, classe module plus haut) : peint une
        # bordure verte par-dessus les items actifs et un petit texte de
        # durée, sans rien changer au comportement natif de la liste
        # (checkbox, sélection, clic droit -- tous inchangés, cf. sa
        # docstring). Une instance de delegate PAR liste (pas partagée) --
        # gardée dans self._onglets_profils[type_instance]["delegate"]
        # pour éviter que Python ne la garbage-collect : QListWidget.
        # setItemDelegate() ne prend qu'une RÉFÉRENCE C++, il ne prolonge
        # pas la durée de vie de l'objet Python côté PySide6.
        delegate = ProfilsGridItemDelegate(liste)
        liste.setItemDelegate(delegate)
        liste.itemClicked.connect(self._sur_selection_instance)
        # PATCH (demande utilisateur : "on est obliger de tout selectionner
        # un pas un avant de pourvoir demarer un profils... je veux que tu
        # met aussi des bouton qui vont faire une selecton rapide, donc sa
        # vas plutot fontionner avec les coche") -- chaque item porte
        # désormais SA PROPRE case à cocher (Qt.ItemIsUserCheckable), en
        # plus de la sélection simple existante (surlignage bleu au clic,
        # qui pilote toujours l'aperçu/le panneau de droite -- inchangée).
        # Les deux mécanismes coexistent : cliquer sur la ligne choisit le
        # profil dont on voit l'aperçu à droite (comme avant) ; cocher la
        # case l'ajoute/le retire du lot visé par "Lancer les profils
        # cochés" de CET onglet, indépendamment du profil actuellement
        # sélectionné pour l'aperçu. itemChanged se déclenche pour tout
        # changement de données de l'item, y compris un simple rafraîchissement
        # de texte -- filtré dans _sur_case_profil_changee (cf. plus bas) pour
        # ne réagir qu'aux vraies bascules de case, jamais à un setText().
        liste.itemChanged.connect(self._sur_case_profil_changee)
        # MAJ décision utilisateur : barre masquée, défilement toujours
        # fonctionnel si la liste de profils dépasse la hauteur disponible.
        liste.setVerticalScrollBarPolicy(Qt.ScrollBarAlwaysOff)
        liste.setHorizontalScrollBarPolicy(Qt.ScrollBarAlwaysOff)
        # PATCH (retour utilisateur : "je veux que tu range la les profils
        # sur 3 colonne et non une seule colone") -- QListWidget est en
        # mode ListMode/TopToBottom par défaut (une colonne, empilée
        # verticalement) ; IconMode + flow LeftToRight + wrapping bascule
        # en grille qui remplit une ligne avant de passer à la suivante.
        # gridSize FIXE nécessaire en IconMode pour un alignement propre
        # (sans grille, chaque item ne prendrait que sa largeur de texte,
        # cassant l'alignement en colonnes) -- recalculée dynamiquement à
        # chaque redimensionnement du panneau par _recalculer_grille_profils
        # (cf. eventFilter plus bas) pour occuper toujours exactement
        # NB_COLONNES colonnes, quelle que soit la largeur réelle
        # disponible (panneau_gauche redimensionné, DPI différent, etc.)
        # plutôt qu'une largeur de colonne codée en dur qui laisserait un
        # espace mort ou tronquerait le texte selon l'écran.
        liste.setViewMode(QListWidget.IconMode)
        liste.setFlow(QListWidget.LeftToRight)
        liste.setWrapping(True)
        liste.setResizeMode(QListWidget.Adjust)
        liste.setMovement(QListWidget.Static)
        liste.setUniformItemSizes(True)
        liste.setSpacing(0)
        # PATCH (retour utilisateur : "le pas de scroll est trop eleve") --
        # par défaut, Qt avance la scrollbar verticale d'un nombre de
        # pixels dérivé de la taille des items (souvent une carte entière
        # d'un coup en IconMode), ce qui rend chaque cran de molette
        # brutal. On force un pas fixe, beaucoup plus fin, pour un
        # défilement progressif -- ScrollPerPixel nécessaire pour que
        # singleStep s'exprime bien en pixels (par défaut QListWidget
        # défile par ITEM, cf. ScrollPerItem, où singleStep n'a alors
        # aucun effet visuel).
        liste.setVerticalScrollMode(QListWidget.ScrollPerPixel)
        liste.verticalScrollBar().setSingleStep(24)
        # PATCH (demande utilisateur : le bouton de suppression d'un
        # profil ne doit pas être affiché directement/en permanence, et
        # on doit pouvoir renommer un profil -- jusqu'ici impossible).
        # Renommer/Supprimer sortent du panneau principal et deviennent
        # un menu contextuel sur l'item lui-même (clic droit), pattern
        # déjà utilisé ailleurs dans l'app (cf. _show_service_api_menu) --
        # plus discret qu'un bouton rouge pleine largeur toujours visible,
        # tout en restant à portée d'un clic pour qui sait où chercher.
        # lambda avec pos=... par défaut : capture la VALEUR actuelle de
        # `liste` à la définition, pas une référence tardive (piège
        # classique des closures dans une boucle -- ici pas une boucle,
        # mais même prudence pour rester cohérent avec les connect()
        # similaires plus bas dans cette méthode).
        liste.setContextMenuPolicy(Qt.CustomContextMenu)
        liste.customContextMenuRequested.connect(
            lambda position, l=liste: self._afficher_menu_profil(l, position)
        )
        liste.installEventFilter(self)
        # PATCH (bouton lancer/arrêter par profil, demande utilisateur) --
        # installEventFilter(self) ci-dessus, posé sur `liste` (le
        # QListWidget lui-même), ne reçoit QUE les événements du widget
        # conteneur (ex. QEvent.Resize, cf. eventFilter plus bas -- c'est
        # pour ça que ce filtre existait déjà). Les clics souris, eux,
        # arrivent sur liste.viewport() (le widget interne qui affiche
        # réellement le contenu défilant) -- vérifié empiriquement, un
        # QMouseEvent.MouseButtonPress posé sur le QListWidget lui-même
        # n'atteint jamais son eventFilter, seul le viewport le reçoit.
        # Sans cette 2e installation, le hit-test du bouton lancer/arrêter
        # par item (cf. eventFilter ci-dessous) ne recevrait donc jamais
        # aucun clic.
        liste.viewport().installEventFilter(self)
        layout_bloc.addWidget(liste, stretch=1)

        # PATCH (retour utilisateur : "les bouton widget de creation de
        # nouveau compte doivent etre directement dans les onglet de type
        # de profils") -- champ nom + bouton "Nouveau profil" DUPLIQUÉS
        # ici, dans CET onglet, plutôt que communs au-dessus du
        # QTabWidget (ancien emplacement, cf. commentaire dans
        # _construire_ui) : la création de profil devient une CARTE
        # DÉDIÉE séparée (cf. _construire_carte_creation_profil, placée
        # au milieu entre panneau_gauche et panneau_droit dans
        # _construire_ui), pliable/dépliable, avec sélection du type
        # (Chrome/Camoufox), nom, configuration proxy ET test de proxy en
        # direct (pays/IP détectés) -- remplace à la fois l'ancien champ
        # commun au-dessus des onglets ET la tentative précédente de
        # champ dupliqué par onglet (ni l'un ni l'autre n'avaient de
        # place pour un vrai formulaire de test de proxy). Chaque onglet
        # ne garde donc plus AUCUN widget de création, seulement sa
        # liste + ses boutons de lot.

        # PATCH (retour utilisateur explicite : "je veux que les bouton
        # tout selctionner , deselctionner soit sur la meme ligne que
        # celui qui permet de creer un nouveau profils") -- FUSION de
        # l'ancienne ligne_selection_rapide (Tout sélectionner/Tout
        # désélectionner/Sélectionner les actifs) et de l'ancienne
        # ligne_creer_profil (bouton "+ Créer un profil", posée juste en
        # dessous) en UNE SEULE ligne -- "+ Créer un profil" en PREMIER
        # (retour utilisateur explicite : "créer en premier"), puis les 3
        # raccourcis de sélection dans leur ordre historique inchangé.
        # bouton_creer_profil garde sa largeur naturelle/compacte
        # (stretch=0, cf. son propre commentaire plus bas) -- ce sont
        # TOUJOURS les 3 boutons de sélection qui se partagent le reste
        # de la largeur disponible (stretch=1 chacun, inchangé), pas de
        # raison de les rétrécir juste parce que ce nouveau venu partage
        # maintenant leur ligne.
        ligne_selection_rapide = QHBoxLayout()
        ligne_selection_rapide.setSpacing(6)

        # --- "+ Créer un profil {type}" -- cf. son propre commentaire
        # plus bas dans ce bloc pour le détail (style, provenance,
        # capture de type_instance). Posé EN PREMIER sur cette ligne. ---
        #
        # PATCH (demande utilisateur explicite : onglet Favoris) --
        # "favoris" n'est PAS un vrai type d'instance créable (cf.
        # TYPES_INSTANCE_VALIDES, docstring de _profils_coches_pour_type) :
        # cet onglet ne fait QUE filtrer des profils Chrome/Camoufox
        # existants marqués favoris, il n'a pas de sens d'y proposer un
        # bouton "Créer un profil Favoris" qui ouvrirait un dialogue de
        # création sans type valide. Le bouton n'est donc simplement PAS
        # construit dans ce cas -- ligne_selection_rapide démarre alors
        # directement sur "Tout sélectionner", les deux autres onglets
        # (Chrome/Camoufox) restent inchangés.
        if type_instance != "favoris":
            libelle_type = {"chrome": "Chrome", "camoufox": "Camoufox", "cloakbrowser": "CloakBrowser", "feather": "Feather"}.get(type_instance, type_instance.capitalize())
            bouton_creer_profil = QPushButton(
                qta.icon("mdi6.plus", color=Mocha.crust),
                f"Créer un profil {libelle_type}",
            )
            bouton_creer_profil.setObjectName("CreerProfilOngletButton")
            bouton_creer_profil.setCursor(Qt.PointingHandCursor)
            # PATCH (retour utilisateur explicite : "largeur naturelle/compacte,
            # centré ou aligné à gauche") -- QPushButton s'étire par défaut
            # (sizePolicy horizontale Expanding sur ce style Qt) : sans cette
            # ligne, il absorbait tout l'espace disponible de la ligne malgré
            # stretch=0 passé à addWidget ci-dessous (stretch ne fait
            # qu'ARBITRER l'espace EXTRA entre plusieurs widgets expansibles,
            # il ne force pas un widget expansible à rester à sa taille
            # naturelle). Preferred/Fixed : la largeur suit strictement le
            # texte + icône du bouton, jamais plus.
            bouton_creer_profil.setSizePolicy(QSizePolicy.Fixed, QSizePolicy.Fixed)
            bouton_creer_profil.clicked.connect(
                lambda: self._ouvrir_dialogue_nouveau_profil(type_instance)
            )
            ligne_selection_rapide.addWidget(bouton_creer_profil, 0)

        # PATCH (retour utilisateur explicite : "regarde ces boutons,
        # c'est extrêmement mal mis, c'est bête. je veux des boutons
        # minimalistes qui n'occupent pas d'espace inutilement comme
        # actuellement, ça fait être une organisation pro") -- ces 3
        # raccourcis passent de stretch=1 (ils s'étiraient pour se
        # partager TOUTE la largeur restante de la ligne, chacun avec
        # son texte perdu au milieu d'un bouton bien trop large) à une
        # largeur COMPACTE (sizePolicy Fixed, comme bouton_creer_profil
        # juste au-dessus) : leur taille suit désormais strictement leur
        # texte, alignés à gauche à la suite de "+ Créer un profil", un
        # addStretch(1) final absorbant l'espace qui reste plutôt que de
        # le répartir entre eux.
        bouton_tout_selectionner = QToolButton()
        bouton_tout_selectionner.setText("Tout sélectionner")
        bouton_tout_selectionner.setCursor(Qt.PointingHandCursor)
        bouton_tout_selectionner.setObjectName("ProfilMenuButton")
        bouton_tout_selectionner.setSizePolicy(QSizePolicy.Fixed, QSizePolicy.Fixed)
        bouton_tout_selectionner.clicked.connect(
            lambda: self._appliquer_coche_tous_profils(type_instance, True)
        )
        ligne_selection_rapide.addWidget(bouton_tout_selectionner, 0)

        bouton_tout_deselectionner = QToolButton()
        bouton_tout_deselectionner.setText("Tout désélectionner")
        bouton_tout_deselectionner.setCursor(Qt.PointingHandCursor)
        bouton_tout_deselectionner.setObjectName("ProfilMenuButton")
        bouton_tout_deselectionner.setSizePolicy(QSizePolicy.Fixed, QSizePolicy.Fixed)
        bouton_tout_deselectionner.clicked.connect(
            lambda: self._appliquer_coche_tous_profils(type_instance, False)
        )
        ligne_selection_rapide.addWidget(bouton_tout_deselectionner, 0)

        # PATCH (demande utilisateur explicite : "ajoute l'option
        # sélectionner les actifs") -- coche UNIQUEMENT les profils de CET
        # onglet actuellement actifs (cf. self._instance_id_par_profil,
        # même test que le badge "● actif" dans _rafraichir_liste_profils
        # et que le comptage de _rafraichir_bouton_lancer_profils_coches)
        # et décoche tout le reste de cet onglet -- comportement
        # remplaçant, pas additif, pour que l'état des cases reflète
        # exactement "les actifs, rien d'autre" après le clic, sans
        # dépendre de ce qui était coché avant. N'affecte jamais les cases
        # de l'AUTRE onglet.
        bouton_selectionner_actifs = QToolButton()
        bouton_selectionner_actifs.setText("Sélectionner les actifs")
        bouton_selectionner_actifs.setCursor(Qt.PointingHandCursor)
        bouton_selectionner_actifs.setObjectName("ProfilMenuButton")
        bouton_selectionner_actifs.setSizePolicy(QSizePolicy.Fixed, QSizePolicy.Fixed)
        bouton_selectionner_actifs.clicked.connect(
            lambda: self._selectionner_profils_actifs(type_instance)
        )
        ligne_selection_rapide.addWidget(bouton_selectionner_actifs, 0)
        # Pousse les 4 boutons ci-dessus à gauche -- sans ce stretch
        # final, un QHBoxLayout ne contenant plus que des widgets Fixed
        # les laisserait collés les uns aux autres au milieu d'un grand
        # vide à droite (Qt centre/étire sinon l'espace restant de façon
        # peu prévisible selon le nombre de widgets).
        ligne_selection_rapide.addStretch(1)
        layout_bloc.addLayout(ligne_selection_rapide)

        # PATCH (demande utilisateur) : "maintenant le bouon de demarage
        # de task vas le faire sur tout ceux qui on ete cocher" -- le
        # bouton bascule Lancer/Arrêter existant reste inchangé pour le
        # profil sélectionné seul (aperçu/contrôle fin d'UN profil à la
        # fois), et ce nouveau bouton s'y ajoute pour lancer D'UN COUP
        # tous les profils DE CET ONGLET actuellement cochés (cf.
        # self._profils_coches, filtré par type -- cf.
        # _profils_coches_pour_type -- dans _on_clic_lancer_profils_coches).
        #
        # PATCH (demande utilisateur explicite : "je veux que tu mets
        # aussi le bouton de free pour tout ce qui on ete selctionner...
        # a cote des deux bouton de lancer et arreter les selectioner...
        # a droit, de facon a ce que il occupe la meme hauteur que les
        # deux bouton, donc sur la meme ligne mais pas meme colone") --
        # Lancer et Arrêter à gauche (stretch=1 chacun, texte complet avec
        # compteur -- ce sont les actions principales, elles gardent toute
        # la place utile), Free à droite (stretch=0, largeur fixe à son
        # contenu -- action secondaire, plus rarement utilisée que
        # lancer/arrêter). Un QHBoxLayout aligne tous ses enfants sur la
        # même hauteur de ligne par défaut -- donc les trois boutons
        # occupent naturellement la même hauteur sans réglage
        # supplémentaire, tout en restant dans des colonnes séparées.
        #
        # PATCH (onglets Chrome/Camoufox, demande utilisateur explicite :
        # "jamais les deux en meme temps, juste longlet actif") -- CETTE
        # rangée entière est désormais dupliquée par onglet plutôt que
        # mutualisée : chaque clic n'agit que sur les profils DE CE TYPE
        # cochés (cf. _profils_coches_pour_type(type_instance) dans les 3
        # handlers _on_clic_*_profils_coches), jamais sur l'autre onglet.
        ligne_actions_coches = QHBoxLayout()
        ligne_actions_coches.setSpacing(6)
        bouton_lancer = QPushButton(
            qta.icon("mdi6.play-box-multiple-outline", color=Mocha.crust), "Lancer les profils cochés"
        )
        bouton_lancer.setObjectName("BatchLancerButton")
        bouton_lancer.setEnabled(False)
        bouton_lancer.setToolTip(
            "Lance en une fois tous les profils de cet onglet dont la case est cochée ci-dessus."
        )
        bouton_lancer.clicked.connect(lambda: self._on_clic_lancer_profils_coches(type_instance))
        ligne_actions_coches.addWidget(bouton_lancer, 1)

        # PATCH (retour utilisateur : "je ne vois pas de bouton pour
        # arreter un profil lancer" -- en fait un bouton d'arrêt EXISTAIT
        # déjà, bouton_lancer_arreter plus bas, mais seulement pour LE
        # profil actuellement sélectionné dans la liste (un par un) --
        # aucun équivalent en LOT pour les profils cochés, alors que
        # "Lancer les profils cochés" existe symétriquement depuis le
        # patch Projet Batch. Même logique que _on_clic_lancer_profils_coches,
        # juste l'arrêt à la place du lancement -- réutilise
        # _arreter_instance_pour_profil pour chaque profil de cet onglet
        # coché ET actuellement actif (skip silencieusement les cochés
        # déjà arrêtés, cf. _on_clic_arreter_profils_coches).
        bouton_arreter = QPushButton(
            qta.icon("mdi6.stop-circle-outline", color=Mocha.crust), "Arrêter les profils cochés"
        )
        bouton_arreter.setObjectName("BatchArreterButton")
        bouton_arreter.setEnabled(False)
        bouton_arreter.setToolTip(
            "Arrête en une fois tous les profils actifs de cet onglet dont la case est cochée ci-dessus."
        )
        bouton_arreter.clicked.connect(lambda: self._on_clic_arreter_profils_coches(type_instance))
        ligne_actions_coches.addWidget(bouton_arreter, 1)

        # PATCH (demande utilisateur explicite, cf. commentaire au-dessus
        # de ligne_actions_coches) -- Free en lot, symétrique de
        # _on_clic_arreter_profils_coches : ne touche que les profils de
        # cet onglet cochés qui ont ACTUELLEMENT une instance active (cf.
        # self._instance_id_par_profil -- Free/force_unlink n'a de sens
        # que s'il y a une instance à libérer, exactement le même test
        # que pour "Arrêter"). Bouton compact (icône + libellé court,
        # stretch=0) plutôt qu'un QPushButton pleine largeur comme
        # Lancer/Arrêter : c'est une action secondaire (libérer le lien
        # pilote, pas arrêter l'instance), elle n'a pas besoin d'autant de
        # place, et ça la distingue visuellement des deux actions
        # principales à gauche.
        bouton_free = QPushButton(qta.icon("mdi6.link-off", color=Mocha.crust), "Free")
        bouton_free.setObjectName("BatchFreeButton")
        bouton_free.setEnabled(False)
        bouton_free.setToolTip(
            "Libère (force_unlink) toutes les instances actives de cet onglet dont le profil est coché ci-dessus."
        )
        bouton_free.clicked.connect(lambda: self._on_clic_free_profils_coches(type_instance))
        ligne_actions_coches.addWidget(bouton_free, 0)
        layout_bloc.addLayout(ligne_actions_coches)

        self._onglets_profils[type_instance] = {
            "liste": liste,
            "delegate": delegate,
            "bouton_tout_selectionner": bouton_tout_selectionner,
            "bouton_tout_deselectionner": bouton_tout_deselectionner,
            "bouton_selectionner_actifs": bouton_selectionner_actifs,
            "bouton_lancer": bouton_lancer,
            "bouton_arreter": bouton_arreter,
            "bouton_free": bouton_free,
        }
        return bloc

    def _construire_ui(self):
        """Refonte visuelle (demande explicite utilisateur : "le dashboard
        ne ressemble pas vraiment a un dashboard moderne, on dirait
        directement une page de configuration ... un bon template, bien
        moderne, cool, qui transmet émotionnellement ce que fait le
        logiciel"). AUCUN changement fonctionnel ici hors PATCH boutons
        par carte (bouton_lancer_arreter/bouton_free_pilote/
        bouton_menu_profil supprimés, cf. leur ancien emplacement plus
        bas -- remplacés par les petits boutons peints sur chaque carte
        et le menu contextuel déjà existant) : tous les autres widgets
        (self.label_statut_serveur, self._panneau_rendu et tout ce qu'il
        expose) gardent exactement le même nom d'attribut et les mêmes
        signaux connectés qu'avant -- seule leur mise en page/habillage
        change. Structure, du haut vers le bas :
          1. Un bandeau d'accueil ("hero") qui présente AutoniaX en une
             phrase -- l'écran s'introduit lui-même au lieu d'exposer
             directement des réglages, avant même de savoir ce que fait
             l'app.
          2. Une rangée de cartes de statistiques (profils enregistrés /
             actifs, statut serveur) -- lecture d'un coup d'œil, façon
             tableau de bord, plutôt que du texte de statut discret.
          3. Le contenu fonctionnel existant (colonne profils + aperçu
             d'instance), inchangé en logique, mais posé dans deux
             "cartes panneau" (#DashboardPanel) au lieu de flotter nu sur
             le fond de la fenêtre.
        Tout l'ensemble est mis dans un QScrollArea : la rangée de cartes
        stats + le hero ajoutent de la hauteur, et la fenêtre peut être
        redimensionnée plus petite (cf. MainWindow.setMinimumSize) sans
        que rien ne soit coupé."""
        layout_ecran = QVBoxLayout(self)
        layout_ecran.setContentsMargins(0, 0, 0, 0)
        layout_ecran.setSpacing(0)

        scroll = QScrollArea(self)
        scroll.setWidgetResizable(True)
        scroll.setFrameShape(QFrame.NoFrame)
        scroll.setObjectName("ContentArea")
        # MAJ décision utilisateur ("je veux que tu enleve les barre de
        # scroll... pas que ce nes plus scrollable, enleve les barre de
        # srcoll") : barres masquées, le défilement (molette/glissement/
        # clavier) reste pleinement fonctionnel -- setScrollBarPolicy ne
        # contrôle QUE l'affichage de la barre elle-même, jamais la
        # capacité de défiler (contrairement à désactiver le scroll, ce
        # qui n'a pas été demandé).
        scroll.setVerticalScrollBarPolicy(Qt.ScrollBarAlwaysOff)
        scroll.setHorizontalScrollBarPolicy(Qt.ScrollBarAlwaysOff)
        layout_ecran.addWidget(scroll)

        contenu = QWidget()
        contenu.setObjectName("ContentArea")
        scroll.setWidget(contenu)

        layout_principal = QVBoxLayout(contenu)
        layout_principal.setContentsMargins(24, 24, 24, 24)
        layout_principal.setSpacing(20)

        # ------------------------------------------------------------
        # 1. Bandeau d'accueil ("hero") -- présente le logiciel avant
        #    d'exposer ses réglages.
        # ------------------------------------------------------------
        hero = QFrame()
        hero.setObjectName("DashboardHero")
        hero_layout = QHBoxLayout(hero)
        hero_layout.setContentsMargins(28, 24, 28, 24)
        hero_layout.setSpacing(20)

        icone_conteneur = QLabel()
        icone_conteneur.setObjectName("DashboardHeroIcone")
        icone_conteneur.setFixedSize(64, 64)
        icone_conteneur.setAlignment(Qt.AlignCenter)
        # PATCH (retour utilisateur : "ce logo doit etre changer, je veux
        # que tu remplace par le vrai logo de l'application") -- l'icône
        # mdi6.robot-outline (générique, sans rapport avec l'identité
        # visuelle de l'app) est remplacée par le VRAI logo AutoniaX :
        # l'anneau de pilotage + 3 rayons + moyeu central en dégradé
        # mauve/blue, déjà défini une seule fois en SVG inline (cf.
        # _ICON_SVG_AUTONIAX, tout en haut de ce fichier) et déjà réutilisé
        # tel quel pour l'icône de la fenêtre/barre des tâches (cf.
        # MainWindow.setWindowIcon et app.setWindowIcon, tout en bas de ce
        # fichier) et pour l'icône de la CustomTitleBar (cf. ligne ~6576)
        # -- même pixmap ici, pas une nouvelle variante, pour rester
        # visuellement identique partout où le logo de l'app apparaît.
        icone_conteneur.setPixmap(_generate_icon_pixmap_autoniax(48))
        hero_layout.addWidget(icone_conteneur, 0, Qt.AlignTop)

        hero_texte = QVBoxLayout()
        hero_texte.setSpacing(6)
        eyebrow = QLabel("AUTONIAX")
        eyebrow.setObjectName("DashboardHeroEyebrow")
        hero_texte.addWidget(eyebrow)
        hero_titre = QLabel("Clone The Mind")
        hero_titre.setObjectName("DashboardHeroTitle")
        hero_titre.setWordWrap(True)
        hero_texte.addWidget(hero_titre)
        hero_sous_titre = QLabel(
            "Reconnaissance visuelle de composants, profils persistants et instances de "
            "navigateur pilotées à distance -- lancez un profil ci-dessous pour voir son "
            "aperçu en direct et reprendre la main dessus."
        )
        hero_sous_titre.setObjectName("DashboardHeroSubtitle")
        hero_sous_titre.setWordWrap(True)
        hero_texte.addWidget(hero_sous_titre)
        hero_layout.addLayout(hero_texte, stretch=1)

        layout_principal.addWidget(hero)

        # ------------------------------------------------------------
        # 2. Rangée de cartes de statistiques -- lecture d'un coup
        #    d'œil, alimentées par _rafraichir_cartes_stats() (appelée
        #    ici une première fois, puis à chaque rafraîchissement de
        #    la liste de profils/instances).
        # ------------------------------------------------------------
        rangee_stats = QHBoxLayout()
        rangee_stats.setSpacing(16)

        self._carte_stat_total, self._valeur_stat_total = self._creer_carte_stat(
            "mdi6.account-multiple-outline", "PROFILS ENREGISTRÉS"
        )
        rangee_stats.addWidget(self._carte_stat_total, stretch=1)

        self._carte_stat_actifs, self._valeur_stat_actifs = self._creer_carte_stat(
            "mdi6.play-circle-outline", "PROFILS ACTIFS", accent=True
        )
        rangee_stats.addWidget(self._carte_stat_actifs, stretch=1)

        self._carte_stat_serveur, self._valeur_stat_serveur = self._creer_carte_stat(
            "mdi6.server-network-outline", "SERVEUR CENTRAL"
        )
        rangee_stats.addWidget(self._carte_stat_serveur, stretch=1)

        layout_principal.addLayout(rangee_stats)

        # ------------------------------------------------------------
        # 3. Contenu fonctionnel existant -- deux cartes panneau
        #    (colonne profils / aperçu d'instance), même widgets et
        #    signaux qu'avant ce redesign.
        # ------------------------------------------------------------
        # PATCH (demande utilisateur explicite : "tu dois mettre un
        # qspliter ici de tel sorte que on puisse glisser le fermer, et
        # tu augmente progressivement le nombre de profils affiché sur
        # une ligne sur le card de profils") -- remplace l'ancien
        # QHBoxLayout (rangee_contenu, deux panneaux à largeur figée par
        # setFixedWidth/setMaximumWidth ci-dessous) par un vrai
        # QSplitter horizontal : poignée glissable à la souris entre les
        # deux panneaux, qui peut aller jusqu'à ramener panneau_droit à
        # 0px (fermé) en faisant grandir panneau_gauche d'autant. Le
        # nombre de colonnes de la grille de profils suit alors
        # AUTOMATIQUEMENT cette largeur qui grandit (cf.
        # _recalculer_grille_profils, NB_COLONNES rendu dynamique par ce
        # même patch) -- plus on glisse vers la droite, plus de profils
        # tiennent sur une ligne, sans palier brutal.
        rangee_contenu = QSplitter(Qt.Horizontal)
        rangee_contenu.setObjectName("SplitterProfilsApercu")
        rangee_contenu.setChildrenCollapsible(True)
        rangee_contenu.setHandleWidth(10)

        # --- Panneau gauche : profils persistants ---
        panneau_gauche = QFrame()
        panneau_gauche.setObjectName("DashboardPanel")
        colonne_gauche = QVBoxLayout(panneau_gauche)
        colonne_gauche.setContentsMargins(20, 18, 20, 18)
        colonne_gauche.setSpacing(10)

        titre_ligne = QHBoxLayout()
        titre_ligne.setSpacing(8)
        titre_icone = QLabel()
        titre_icone.setPixmap(qta.icon("mdi6.account-multiple-outline", color=Mocha.lavender).pixmap(18, 18))
        titre_ligne.addWidget(titre_icone)
        titre = QLabel("Profils")
        titre.setObjectName("DashboardPanelTitle")
        titre_ligne.addWidget(titre)
        titre_ligne.addStretch(1)
        colonne_gauche.addLayout(titre_ligne)

        legende = QLabel("Créez un profil par identité/compte à garder séparé, puis lancez-le pour ouvrir son navigateur.")
        legende.setObjectName("DashboardSectionCaption")
        legende.setWordWrap(True)
        colonne_gauche.addWidget(legende)

        # PATCH (retour utilisateur explicite, dernier état en date :
        # "on vas enlever ce card , on vas lajouter dans longlet des type
        # de proifls (chrome , camoufox)") -- AUCUN widget de création
        # n'est construit ici, dans colonne_gauche : la création de
        # profil vit désormais dans un bouton "+ Créer un profil" PROPRE
        # À CHAQUE ONGLET (cf. _construire_bloc_onglet_profils), qui
        # ouvre un QDialog modal (cf. _ouvrir_dialogue_nouveau_profil)
        # avec nom, proxy (pour TOUS les types, plus seulement Camoufox)
        # et test de proxy en direct -- le type est déduit de l'onglet
        # cliqué, aucun sélecteur dans le dialogue. Historique : ce
        # formulaire est passé par 3 emplacements successifs -- champ
        # commun au-dessus des onglets, puis carte dédiée fixe entre
        # panneau_gauche et panneau_droit (SUPPRIMÉE, cf.
        # _construire_carte_creation_profil), avant d'atterrir ici, dans
        # les onglets eux-mêmes.

        # PATCH (onglets Chrome/Camoufox, demande utilisateur explicite :
        # "jamais les deux en meme temps, juste longlet actif ... peutere
        # que cest mieux de metre chque bouton pour chque page et non en
        # commun") -- l'ancienne liste unique self.liste_instances +
        # l'ancienne rangée unique de boutons de lot sont REMPLACÉES par un
        # QTabWidget interne à 2 onglets (Chrome / Camoufox), chaque
        # onglet étant un bloc COMPLET ET AUTONOME : sa propre QListWidget
        # (grille de cartes, delegate custom, etc. -- exactement la même
        # config qu'avant, dupliquée) ET sa propre rangée de boutons de
        # lot (Tout sélectionner / Tout désélectionner / Sélectionner les
        # actifs / Lancer / Arrêter / Free). Aucune mutualisation des
        # boutons : un clic sur "Lancer les profils cochés" dans l'onglet
        # Chrome n'agit QUE sur les profils Chrome cochés, jamais sur les
        # profils Camoufox, même s'ils sont cochés dans l'autre onglet.
        #
        # self._onglets_profils est le nouveau point d'entrée pour accéder
        # à un widget dupliqué : {"chrome": {...}, "camoufox": {...}},
        # chaque valeur portant les clés "liste", "delegate",
        # "bouton_tout_selectionner", "bouton_tout_deselectionner",
        # "bouton_selectionner_actifs", "bouton_lancer", "bouton_arreter",
        # "bouton_free". Construit par _construire_bloc_onglet_profils(),
        # appelée une fois par type -- garde les DEUX blocs rigoureusement
        # identiques en structure/QSS/comportement, seul le type_instance
        # ciblé change.
        #
        # self._profils_coches (cf. __init__) reste un UNIQUE set global de
        # noms de profils, tous types confondus -- c'est le TYPE du profil
        # (cf. obtenir_config_profil) qui détermine dans quelle liste/sous
        # quel jeu de boutons il apparaît, pas une structure de données
        # séparée par type. Un profil coché dans l'onglet Chrome reste donc
        # dans ce même set, simplement filtré par type au moment de
        # peupler/rafraîchir chaque onglet (cf. _rafraichir_liste_profils)
        # et au moment de compter/agir en lot (cf. _profils_coches_pour_type).
        self._onglets_profils: dict[str, dict] = {}
        # PATCH (dialogue de création, préremplissage du type) --
        # mapping inverse {index_onglet_qt: type_instance}, construit en
        # parallèle de la boucle ci-dessous plutôt que déduit de l'ordre
        # des onglets à l'usage (cf. _on_clic_nouveau_profil, qui lit
        # self._tabs_profils.currentIndex()) -- robuste même si l'ordre
        # chrome/camoufox dans le tuple ci-dessous changeait un jour.
        self._type_instance_par_index_onglet: dict[int, str] = {}
        # PATCH (retour utilisateur : "je veux aussi que tu affiche le
        # nombre de profils par onglet, juste a cote du nom de l'onglet,
        # chrome (...)") -- libellé DE BASE (sans compteur) par index
        # d'onglet, mémorisé ici au moment de la création (avant tout
        # setTabText qui viendra y ajouter " (N)"). Nécessaire pour
        # reconstruire "Chrome (5)" sans jamais lire le texte déjà
        # affiché par l'onglet (qui contiendrait déjà un ancien compteur
        # à retirer/parser) -- cf. _rafraichir_compteurs_onglets_profils.
        self._libelle_base_par_index_onglet: dict[int, str] = {}
        self._tabs_profils = QTabWidget()
        self._tabs_profils.setObjectName("ProfilsTypeTabs")
        # PATCH (demande utilisateur explicite : "je veux que on peu
        # mettre un statut de favoris pour un profils, donc dans les
        # card des profils tu vas mettre un onglet : favoris, cest lui
        # qui seras ouvert par defaut") -- "favoris" est un 3e onglet,
        # placé EN PREMIER dans ce tuple (donc premier onglet créé, donc
        # onglet actif par défaut à l'ouverture de l'écran -- QTabWidget
        # affiche son 1er onglet ajouté tant que rien d'autre n'a encore
        # appelé setCurrentIndex/setCurrentWidget). PAS un vrai type
        # d'instance (cf. TYPES_INSTANCE_VALIDES, qui reste inchangé :
        # ("chrome", "camoufox") uniquement) -- un pseudo-type de
        # FILTRAGE transverse, reconnu explicitement partout où ça compte
        # (cf. _profils_coches_pour_type, _construire_bloc_onglet_profils
        # -- bouton "Créer un profil" masqué pour ce pseudo-type -- et
        # _rafraichir_liste_profils -- duplication des profils favoris
        # vers cet onglet, tous types réels confondus).
        for type_instance, libelle_onglet, icone_onglet in (
            ("favoris", "Favoris", "mdi6.star"),
            ("chrome", "Chrome", "mdi6.google-chrome"),
            ("camoufox", "Camoufox", "mdi6.firefox"),
            ("cloakbrowser", "CloakBrowser", "mdi6.incognito"),
            ("feather", "Feather", "mdi6.feather"),
        ):
            widget_onglet = self._construire_bloc_onglet_profils(type_instance)
            index_onglet = self._tabs_profils.addTab(
                widget_onglet, qta.icon(icone_onglet, color=Mocha.text), libelle_onglet
            )
            self._type_instance_par_index_onglet[index_onglet] = type_instance
            self._libelle_base_par_index_onglet[index_onglet] = libelle_onglet
        # PATCH (retour utilisateur explicite : capture montrant des
        # cartes minuscules avec un grand vide à droite, alors que
        # panneau_gauche/NB_COLONNES avaient bien été élargis/réduits --
        # BUG : un onglet CACHÉ au moment où colonne_gauche change de
        # largeur (self._tabs_profils élargi, cf. plus bas) ne reçoit pas
        # forcément de QEvent.Resize fiable sur sa QListWidget tant qu'il
        # reste masqué (Qt ne garantit pas un layout précis sur un widget
        # non visible) -- sa grille (cf. _recalculer_grille_profils) reste
        # alors figée sur une largeur provisoire/périmée jusqu'à un
        # redimensionnement réel de la FENÊTRE (pas juste un changement
        # d'onglet). showEvent (cf. plus bas) ne couvre que le tout
        # premier affichage de CET ÉCRAN, pas chaque bascule Chrome<->Camoufox
        # ultérieure. Recalcule donc explicitement la grille de l'onglet
        # qui DEVIENT visible à chaque changement -- idempotent, sans
        # effet si elle était déjà correcte.
        self._tabs_profils.currentChanged.connect(self._sur_changement_onglet_profils)
        # PATCH (retour utilisateur explicite : "on vas enlever ce card ,
        # on vas lajouter dans longlet des type de proifls (chrome ,
        # camoufox) ... juste a la suite direct des card de profils de
        # chque onglet") -- la carte de création séparée (autrefois posée
        # ici, à côté de self._tabs_profils dans une ligne dédiée) est
        # SUPPRIMÉE (cf. _construire_carte_creation_profil, plus appelée
        # nulle part, méthode morte conservée sans appelant). self._tabs_profils
        # occupe maintenant TOUTE la largeur de colonne_gauche, sans plus
        # aucun widget voisin à droite -- la mécanique de stretch=1 sur
        # les tabs pour dimensionner la grille reste inchangée (cf.
        # _recalculer_grille_profils, toujours basé sur liste.viewport().width()),
        # simplement plus rien ne vient rétrécir l'espace qui leur est
        # offert.
        #
        # La création de profil elle-même (nom, proxy, test) vit
        # désormais dans un QDialog modal ouvert depuis un bouton "+
        # Créer un profil" propre à CHAQUE onglet (cf.
        # _construire_bloc_onglet_profils, ligne_actions_coches --
        # bouton_creer_profil, ET _ouvrir_dialogue_nouveau_profil pour le
        # contenu du dialogue) -- le type d'instance n'est donc plus
        # choisi via un sélecteur dédié : il est déduit directement de
        # l'onglet dont le bouton a été cliqué (type_instance capturé par
        # la fermeture du connect(), cf. _construire_bloc_onglet_profils).
        colonne_gauche.addWidget(self._tabs_profils, stretch=1)
        # Connexion faite ICI (une seule fois pour tout l'écran, workers
        # partagés par TOUS les dialogues de création -- un seul dialogue
        # peut être ouvert à la fois puisqu'il est modal, cf.
        # _ouvrir_dialogue_nouveau_profil) -- Qt.QueuedConnection implicite
        # puisque resultat_pret est émis depuis le thread de
        # self._test_proxy_worker (cf. son moveToThread dans __init__),
        # pas le thread GUI.
        self._test_proxy_worker.resultat_pret.connect(self._sur_resultat_test_proxy)
        self._drapeau_test_proxy_worker.resultat_pret.connect(self._sur_drapeau_test_proxy_recu)

        # PATCH (demande utilisateur explicite : "idiot meme le bouon :
        # doit etre suprimer, idiot je veux que tout ces control soit
        # plus necesaire... que chque card de profisl gere") -- l'ancien
        # bouton bascule Lancer/Arrêter (self.bouton_lancer_arreter), le
        # bouton Free (self.bouton_free_pilote) et le bouton "⋮ Gérer le
        # profil" (self.bouton_menu_profil, cf. plus bas) sont TOUS
        # SUPPRIMÉS de ce panneau -- remplacés respectivement par : le
        # petit bouton lancer/arrêter peint directement sur chaque carte
        # (cf. ProfilsGridItemDelegate, patch précédent), un nouveau petit
        # bouton Free peint lui aussi sur chaque carte (cf. même classe,
        # DELEGATE_ROLE_LIEN_ACTIF/rect_bouton_free ci-dessous), et le
        # menu contextuel déjà existant sur clic droit (cf.
        # _afficher_menu_profil, inchangé -- Renommer/Supprimer restent
        # accessibles ainsi, sans bouton dédié). Les méthodes
        # _on_clic_lancer_ou_arreter/_on_clic_free_pilote/
        # _on_clic_bouton_menu_profil, qui pilotaient CES boutons
        # spécifiquement, sont donc mortes et supprimées avec eux (cf.
        # leurs anciens emplacements, remplacées par les équivalents
        # "_pour_profil" utilisés par le hit-test des cartes).


        self.label_statut_serveur = QLabel("Connexion au serveur...")
        self.label_statut_serveur.setStyleSheet("color: #a6adc8; font-size: 12px;")
        colonne_gauche.addWidget(self.label_statut_serveur)

        # PATCH (retour utilisateur : "je veux que tu range la les profils
        # sur 3 colonne et non une seule colone") -- élargi de 320 à 420
        # pour laisser ~130px utiles par colonne (420 - marges 20+20 = 380,
        # / 3 colonnes) une fois liste_instances passée en mode grille
        # (cf. _recalculer_grille_profils) -- à 320px les colonnes
        # auraient été trop étroites pour rester lisibles (nom de profil +
        # badge actif/inactif tronqués).
        #
        # PATCH (demande utilisateur explicite : "augemente le with de
        # 1/2" + "sa veut dire que le contenur du bloc des profils doit
        # seleargir en wisth pour que tout soit afficher sans probleme")
        # -- 420 -> 620px. Point important : dans une grille à colonnes
        # FIXES (NB_COLONNES=3, cf. _recalculer_grille_profils), la
        # largeur d'une carte est mécaniquement largeur_viewport / 3 --
        # elle ne peut donc PAS grandir de 50% sans élargir le CONTENEUR
        # (panneau_gauche) en proportion, sous peine de déborder du
        # viewport ou de casser l'alignement en grille. 620px donne
        # ~195px utiles par colonne (620 - 40 marges = 580 / 3), soit
        # bien +50% par rapport aux ~130px précédents.
        # PATCH (demande utilisateur explicite : "je veux que le card du
        # mileu, celui qui creer les profils, tu le met pluot directaent
        # dans le carde des profils, toujours a la droite ... la taille
        # actuels de proifs reste pas partager, tu doit ajouter la taille
        # necessaire en width pour que sa ne se retrecisse pas") -- la
        # carte de création de profil (360px fixe, cf.
        # _construire_carte_creation_profil) n'est plus une colonne
        # séparée entre panneau_gauche et panneau_droit : elle est
        # maintenant posée À L'INTÉRIEUR de panneau_gauche, à droite de
        # la liste de profils (cf. bloc_tabs_et_creation plus bas). La
        # liste de profils elle-même garde EXACTEMENT sa largeur
        # d'affichage précédente (620px, grille à 3 colonnes inchangée,
        # cf. _recalculer_grille_profils) -- c'est panneau_gauche qui
        # s'élargit pour ABSORBER la carte en plus, jamais l'inverse :
        # 620 (liste, inchangé) + 20 (espacement interne) + 360 (carte)
        # + marges internes du panneau (20 de chaque côté, cf.
        # setContentsMargins juste en dessous) = 1040px.
        # PATCH (demande utilisateur explicite : "il vas facloir reduire
        # enormenent lespace de laendorit ou on creer les nouveau
        # profils ... reuire le de 2 en width") -- la carte de création
        # est passée de 360 à 180px (cf. _construire_carte_creation_profil),
        # panneau_gauche réduit d'autant (1040 -> 860) pour ne pas
        # laisser un vide à droite de la carte -- la liste de profils
        # (620px) garde exactement la même largeur qu'avant, seule la
        # carte a rétréci.
        # PATCH (retour utilisateur explicite : "pourquoi tu ne veu pas
        # augmeter les dimension du card inidviduels de profils ? cest
        # pourcela que jai dit que tu reduire le width du card de
        # lapercu dinstance") -- la réduction de panneau_droit (cf.
        # LARGEUR_MAX_PANNEAU_DROIT_PX plus bas dans cette méthode) libère
        # ~235px (955 -> 720) dans rangee_contenu ; panneau_gauche
        # absorbait alors cet espace en plus (860 + 235 = 1095px), ce qui
        # faisait grandir _tabs_profils (stretch=1) et donc la largeur
        # RÉELLE de chaque carte de la grille (cf. _recalculer_grille_profils,
        # qui dérive largeur_item de liste.viewport().width()).
        #
        # PATCH (retour utilisateur explicite : "on vas enlever ce card" --
        # cf. commentaire au-dessus de colonne_gauche.addWidget(self._tabs_profils, ...))
        # -- la carte de création à côté des tabs (180px + 20px
        # d'espacement, cf. ancienne ligne_tabs_et_creation) a disparu :
        # panneau_gauche absorbe cet espace en plus à son tour
        # (1095 + 180 + 20 = 1295px), pour que _tabs_profils (toujours
        # seul, stretch=1, dans colonne_gauche) occupe la place ainsi
        # libérée plutôt que de la laisser vide. panneau_droit, lui, ne
        # change pas (cf. LARGEUR_MAX_PANNEAU_DROIT_PX plus bas -- resté
        # intact, seul panneau_gauche grandit ici).
        # PATCH (retour utilisateur : "le width est trop grand, au point
        # ou je suis capable de slider legerement en width") -- 1295px
        # (cf. historique des PATCH ci-dessus) additionné à panneau_droit
        # (jusqu'à 720px, cf. LARGEUR_MAX_PANNEAU_DROIT_PX plus bas) et à
        # la sidebar (72px, cf. Sidebar.setFixedWidth) dépassait largement
        # la largeur par défaut ET minimale de MainWindow (cf.
        # self.resize(1280, 800) / self.setMinimumSize(960, 600)) --
        # d'où un débordement horizontal (la fenêtre pouvait être
        # "slidée" légèrement en largeur car son contenu dépassait).
        # PATCH (retour utilisateur : "le card de profils tu as trop
        # retrecir, augmenter bien le width, et le card de droit (onglet
        # apercu et Propriete) tu laisse exactement tels quel") --
        # première valeur (780px) trop agressive : les cartes de la
        # grille (NB_COLONNES=4, cf. _recalculer_grille_profils) devenaient
        # trop étroites pour afficher le texte en entier (ex. "Roy..."
        # tronqué au lieu de "Royaume-Uni"). 1050px redonne assez de
        # largeur à CHAQUE colonne pour rester lisible, sans revenir au
        # 1295px d'origine qui faisait déborder la fenêtre -- panneau_droit
        # INCHANGÉ (cf. LARGEUR_MAX_PANNEAU_DROIT_PX plus bas, toujours
        # 720px, non touché par ce patch). La grille se recalcule
        # dynamiquement à partir de liste.viewport().width(), donc cet
        # élargissement s'applique automatiquement à la largeur des
        # cartes, sans autre changement de code nécessaire.
        #
        # PATCH (QSplitter glissable, cf. commentaire sur rangee_contenu
        # plus haut) -- setFixedWidth(1050) SUPPRIMÉ : un widget à
        # largeur fixe ne peut pas être redimensionné par la poignée
        # d'un QSplitter (Qt ignore le glissement dans ce cas). 1050
        # devient la largeur INITIALE seulement (cf. rangee_contenu.
        # setSizes(...) après l'ajout de panneau_droit, plus bas) --
        # minimumWidth conservé pour qu'un glissement extrême vers la
        # gauche ne rende jamais la grille de profils inutilisable.
        panneau_gauche.setMinimumWidth(420)
        rangee_contenu.addWidget(panneau_gauche)

        # --- Panneau droit : le vrai widget de RENDU d'une instance
        # nodriver -- même composant que TestComposantScreen et
        # CoordonneeActionScreen (cf. InstanceApercuScreen), avec ses 3
        # modes de rafraîchissement (bouton ponctuel / auto+FPS / désactivé)
        # et sa gestion correcte du redimensionnement -- au lieu d'un
        # QLabel+QSpinBox+bouton Pause réimplémentés à la main ici, qui
        # dupliquaient partiellement cette logique sans ses correctifs
        # (redimensionnement figé, etc.) ni son statut détaillé. Le
        # Dashboard garde sa propre connexion réseau (role="observateur",
        # liste globale, lancement/arrêt de process) -- seul le RENDU est
        # partagé, en composition, pas la connexion. Posé dans une carte
        # panneau (#DashboardPanel) pour rester visuellement cohérent avec
        # le panneau de gauche -- PanneauRenduInstance lui-même reste
        # inchangé (réutilisé tel quel ailleurs dans l'app).
        panneau_droit = QFrame()
        panneau_droit.setObjectName("DashboardPanel")
        layout_panneau_droit = QVBoxLayout(panneau_droit)
        layout_panneau_droit.setContentsMargins(20, 18, 20, 18)
        layout_panneau_droit.setSpacing(10)

        # PATCH (demande utilisateur explicite : "je veux que tu creer un
        # onglet proprieter qui vas afficheir les propreite de lintance
        # selecionner ... c'est mieux dans le panneau droit ... on poura
        # switcher entre propreite et rendue") -- switch pilule (même
        # composant que DashboardScreen.switch_onglets, cf. SwitchOnglets,
        # pour rester visuellement cohérent avec le reste du Dashboard
        # plutôt qu'une QTabBar native grise) au-dessus d'un QStackedWidget
        # à 2 pages : "Aperçu" (PanneauRenduInstance, INCHANGÉ) et
        # "Propriétés" (nouveau PanneauProprietesInstance, cf. sa classe
        # plus bas dans ce fichier -- fingerprint BrowserForge/geoip de
        # l'instance Camoufox sélectionnée, avec bouton copier).
        self._switch_apercu_proprietes = SwitchOnglets(
            [("Aperçu", "mdi6.eye-outline"), ("Propriétés", "mdi6.card-account-details-outline")],
            panneau_droit,
        )
        layout_panneau_droit.addWidget(self._switch_apercu_proprietes)

        self._pages_panneau_droit = QStackedWidget(panneau_droit)

        self._panneau_rendu = PanneauRenduInstance("APERÇU DE L'INSTANCE SÉLECTIONNÉE")
        self.rafraichir_button = self._panneau_rendu.rafraichir_button
        self.rafraichir_button.clicked.connect(self._demander_rafraichissement)
        self.case_auto = self._panneau_rendu.case_auto
        self.case_auto.toggled.connect(self._on_case_auto_toggled)
        self.fps_auto_spin = self._panneau_rendu.fps_auto_spin
        self.fps_auto_spin.valueChanged.connect(self._on_fps_auto_change)
        self.label_statut_rafraichissement = self._panneau_rendu.label_statut_rafraichissement
        # --- Onglet navigateur (listTabs/switchTab) -- reçu automatiquement
        # via PanneauRenduInstance (composition, cf. sa docstring), même
        # câblage que InstanceApercuScreen.__init__ (rafraichir_button/
        # case_auto/fps_auto_spin juste au-dessus) : DashboardScreen n'a
        # RIEN eu à dupliquer côté UI pour recevoir ce bloc -- seule la
        # logique réseau qui le pilote (ci-dessous, section Onglet
        # navigateur) est propre à cet écran, adaptée à
        # self._instance_selectionnee (équivalent Dashboard de
        # self._instance_liee côté InstanceApercuScreen).
        self.onglet_combo = self._panneau_rendu.onglet_combo
        self.onglet_combo.currentIndexChanged.connect(self._on_onglet_navigateur_change)
        self.onglet_combo.popup_ouvert.connect(self._demander_liste_onglets_navigateur)
        self.rafraichir_onglets_button = self._panneau_rendu.rafraichir_onglets_button
        self.rafraichir_onglets_button.clicked.connect(self._demander_liste_onglets_navigateur)
        self.label_statut_onglets = self._panneau_rendu.label_statut_onglets
        self.apercu_label = self._panneau_rendu.apercu_label
        self.apercu_label.redimensionne.connect(self._sur_redimensionnement_apercu)
        self.apercu_label.setText("Sélectionnez une instance pour voir son aperçu")
        self._pages_panneau_droit.addWidget(self._panneau_rendu)

        self._panneau_proprietes = PanneauProprietesInstance(panneau_droit)
        self._panneau_proprietes.bouton_rafraichir.clicked.connect(self._demander_proprietes_fingerprint)
        self._pages_panneau_droit.addWidget(self._panneau_proprietes)

        layout_panneau_droit.addWidget(self._pages_panneau_droit, stretch=1)

        self._switch_apercu_proprietes.indice_change.connect(self._pages_panneau_droit.setCurrentIndex)
        self._pages_panneau_droit.currentChanged.connect(self._sur_page_panneau_droit_changee)

        # PATCH (demande utilisateur explicite : "tu doit reduire le card
        # de apercu instance de 1/4 encore en width") -- avant ce patch,
        # panneau_droit n'avait AUCUNE largeur plafonnée : posé avec
        # stretch=1 seul dans rangee_contenu, il absorbait tout l'espace
        # restant après panneau_gauche (860px fixe), quelle que soit la
        # largeur de la fenêtre -- ~955px observés sur un écran de test à
        # ~1820px de large. LARGEUR_MAX_PANNEAU_DROIT_PX fixe un plafond
        # (~955 * 3/4 ≈ 716px, arrondi à 720) : panneau_droit garde son
        # stretch=1 (continue de suivre les variations de largeur de la
        # fenêtre en dessous de ce plafond, jamais plus étroit que
        # nécessaire), mais ne peut plus dépasser ~3/4 de sa largeur
        # précédente sur un écran large.
        # PATCH (QSplitter glissable, cf. commentaire sur rangee_contenu
        # plus haut) -- setMaximumWidth SUPPRIMÉ pour la même raison que
        # setFixedWidth sur panneau_gauche ci-dessus : un plafond de
        # largeur empêcherait de glisser panneau_droit plus large, ET
        # (plus gênant ici) bloquerait le glissement vers 0 puisque Qt
        # respecte ce maximum même quand on cherche à RÉDUIRE le widget
        # via la poignée. 720 devient la largeur INITIALE seulement (cf.
        # setSizes ci-dessous). setChildrenCollapsible(True) (posé sur
        # rangee_contenu à sa création) autorise la poignée à aller
        # jusqu'à ramener panneau_droit à 0px -- panneau_gauche absorbe
        # alors tout l'espace ainsi libéré, la grille de profils gagnant
        # des colonnes en conséquence (cf. NB_COLONNES dynamique dans
        # _recalculer_grille_profils).
        LARGEUR_MAX_PANNEAU_DROIT_PX = 720
        panneau_droit.setMinimumWidth(0)
        rangee_contenu.addWidget(panneau_droit)

        # Tailles INITIALES seulement (cf. commentaires ci-dessus) --
        # l'utilisateur peut ensuite glisser librement la poignée entre
        # les deux panneaux, Qt redistribue alors l'espace entre les
        # deux valeurs qu'il donne ici.
        # PATCH (demande utilisateur explicite : "par défaut au démarrage ce
        # qsplitter ferme complètement le panneau de propriétés") -- le
        # panneau droit (aperçu/propriétés) démarre FERMÉ (0 px) et la grille
        # de profils occupe toute la largeur. Vérifié empiriquement avec un
        # QSplitter hors écran reproduisant cette structure : (1) setSizes([_,
        # 0]) tient après le premier show() (Qt ne le réécrit pas), même quand
        # le contenu du panneau droit a une largeur minimale de ~600 px, car
        # setMinimumWidth(0) + setChildrenCollapsible(True) (posés plus haut)
        # autorisent la fermeture ; (2) la poignée reste visible au bord droit
        # et un glissement vers la gauche rouvre le panneau, jusqu'à sa largeur
        # minimale de contenu. La valeur 1050 n'a aucun effet de mise en page
        # ici (Qt normalise les tailles à la largeur réelle) : seul le 0 compte.
        # LARGEUR_MAX_PANNEAU_DROIT_PX (720) n'est plus la taille au démarrage
        # mais reste la largeur d'OUVERTURE de référence (cf. bascule via
        # self._splitter_profils_apercu, lu par le raccourci qui rouvre le
        # panneau si besoin).
        rangee_contenu.setSizes([1050, 0])
        self._splitter_profils_apercu = rangee_contenu
        self._largeur_ouverture_panneau_droit_px = LARGEUR_MAX_PANNEAU_DROIT_PX
        # Panneau gauche (profils) prioritaire sur l'espace supplémentaire
        # quand la fenêtre s'agrandit -- panneau_droit garde sa largeur
        # au lieu de s'étirer indéfiniment sur un écran très large.
        rangee_contenu.setStretchFactor(0, 1)
        rangee_contenu.setStretchFactor(1, 0)

        layout_principal.addWidget(rangee_contenu, stretch=1)

        self._rafraichir_statut_rafraichissement()
        self._rafraichir_cartes_stats()

    def _creer_carte_stat(self, icon_name: str, label: str, accent: bool = False) -> tuple[QFrame, QLabel]:
        """Construit une carte de statistique (#DashboardStatCard) pour la
        rangée en haut du dashboard -- icône, grande valeur, libellé.
        Retourne (la carte elle-même, le QLabel de la valeur) : l'appelant
        garde une référence sur ce dernier pour le mettre à jour depuis
        _rafraichir_cartes_stats() sans avoir à retraverser le layout."""
        carte = QFrame()
        carte.setObjectName("DashboardStatCard")
        carte.setProperty("accent", "true" if accent else "false")
        layout = QHBoxLayout(carte)
        layout.setContentsMargins(18, 16, 18, 16)
        layout.setSpacing(14)

        icone = QLabel()
        icone.setPixmap(qta.icon(icon_name, color=Mocha.mauve if accent else Mocha.subtext0).pixmap(26, 26))
        layout.addWidget(icone, 0, Qt.AlignTop)

        texte = QVBoxLayout()
        texte.setSpacing(2)
        valeur = QLabel("—")
        valeur.setObjectName("DashboardStatValue")
        texte.addWidget(valeur)
        libelle = QLabel(label)
        libelle.setObjectName("DashboardStatLabel")
        texte.addWidget(libelle)
        layout.addLayout(texte, stretch=1)

        return carte, valeur

    def _rafraichir_cartes_stats(self):
        """Met à jour les 3 cartes de statistiques du haut à partir de
        l'état déjà tenu à jour ailleurs (self._profils,
        self._instance_id_par_profil) -- appelée depuis _construire_ui
        (valeur initiale) puis à chaque _rafraichir_liste_profils, pour
        rester synchrone avec la liste affichée juste en dessous, sans
        dupliquer la moindre logique de comptage : ce sont les mêmes
        dicts que ceux déjà utilisés par _rafraichir_liste_profils."""
        if not hasattr(self, "_valeur_stat_total"):
            return  # appelée avant construction complète -- ne devrait pas arriver, garde défensive
        total = len(self._profils)
        actifs = len(self._instance_id_par_profil)
        self._valeur_stat_total.setText(str(total))
        self._valeur_stat_actifs.setText(str(actifs))
        if self.client_reseau is None:
            self._valeur_stat_serveur.setText("Indisponible")
            self._valeur_stat_serveur.setObjectName("DashboardStatBadgeErr")
        elif getattr(self, "_serveur_connecte", False):
            self._valeur_stat_serveur.setText("Connecté")
            self._valeur_stat_serveur.setObjectName("DashboardStatBadgeOk")
        else:
            self._valeur_stat_serveur.setText("Hors ligne")
            self._valeur_stat_serveur.setObjectName("DashboardStatBadgeWarn")
        # Réapplique le style après changement d'objectName dynamique
        # (Qt ne réévalue pas automatiquement le QSS sans ce cycle
        # unpolish/polish, même pattern que les autres bascules d'état
        # visuel par objectName dans ce fichier, ex. TaskCelluleWidget).
        self._valeur_stat_serveur.style().unpolish(self._valeur_stat_serveur)
        self._valeur_stat_serveur.style().polish(self._valeur_stat_serveur)

    # --- Réseau : événements entrants ---

    def _sur_connecte(self):
        self.label_statut_serveur.setText("Connecté au serveur central")
        self.label_statut_serveur.setStyleSheet("color: #a6e3a1; font-size: 12px;")
        # Alimente la carte de stat "Serveur central" du dashboard (cf.
        # _rafraichir_cartes_stats) -- même info que label_statut_serveur
        # ci-dessus, juste reflétée aussi dans la rangée de cartes du haut.
        self._serveur_connecte = True
        self._rafraichir_cartes_stats()

    def _sur_echec_connexion(self, message: str):
        self.label_statut_serveur.setText(f"Échec de connexion au serveur : {message}")
        self.label_statut_serveur.setStyleSheet("color: #f38ba8; font-size: 12px;")
        log_dashboard_ui.error(f"Échec de connexion au serveur central : {message}")
        self._serveur_connecte = False
        self._rafraichir_cartes_stats()

    def _sur_liste_instances_recue(self, instances: list):
        log_dashboard_ui.info(
            f"DashboardScreen._sur_liste_instances_recue() appelée avec {len(instances)} instance(s) : {instances}"
        )
        ids_connus = {i["id"] for i in instances}

        # Mémorise le PID OS de chaque instance connue (cf. self._pid_par_instance,
        # PATCH demandé par l'utilisateur) -- toujours à jour, y compris pour une
        # instance orpheline qui n'a jamais été lancée par CE Dashboard.
        for i in instances:
            pid = i.get("pid")
            if pid is not None:
                self._pid_par_instance[i["id"]] = pid
        for iid in list(self._pid_par_instance.keys()):
            if iid not in ids_connus:
                del self._pid_par_instance[iid]

        # Découvre les instances déjà existantes côté serveur (lancées avant
        # l'ouverture de ce Dashboard, ou par un autre Dashboard) et associe
        # chacune à son profil par préfixe de nom -- self._instance_id_par_profil
        # n'était rempli QUE par _lancer_instance_pour_profil (ce Dashboard
        # précis), donc restait vide pour toute instance déjà en cours au
        # premier instances_list reçu (ex: 'Default-1' déjà lancée, cf. log
        # utilisateur), laissant le profil affiché "○ inactif" à tort.
        # instance_id est TOUJOURS "{_nom_dossier_valide(nom_profil)}-{n}"
        # (cf. _lancer_instance_pour_profil) -- jamais réutilisé pour un
        # AUTRE profil déjà mappé (une instance associée reste associée
        # tant qu'elle est vivante, cf. boucle de nettoyage juste après).
        ids_deja_associes = set(self._instance_id_par_profil.values())
        for nom_profil in self._profils.keys():
            if nom_profil in self._instance_id_par_profil:
                continue
            prefixe = f"{_nom_dossier_valide(nom_profil)}-"
            for iid in ids_connus:
                if iid in ids_deja_associes:
                    continue
                if iid.startswith(prefixe) and iid[len(prefixe):].isdigit():
                    self._instance_id_par_profil[nom_profil] = iid
                    ids_deja_associes.add(iid)
                    # Le serveur ne transmet pas l'heure de démarrage réelle
                    # de cette instance (déjà active avant même l'ouverture
                    # de ce Dashboard, ou lancée par un autre Dashboard) --
                    # on ne peut donc pas connaître sa durée d'activité
                    # réelle. On démarre le chrono maintenant (découverte)
                    # plutôt que de laisser un profil actif sans durée
                    # affichée du tout (cf. _rafraichir_liste_profils) ;
                    # affiche donc "depuis combien de temps ce Dashboard le
                    # sait actif", pas "depuis combien de temps il tourne
                    # vraiment" -- meilleure approximation disponible.
                    self._heure_debut_par_profil.setdefault(nom_profil, time.monotonic())
                    log_dashboard_ui.info(
                        f"Instance '{iid}' déjà active côté serveur -- associée au profil '{nom_profil}'"
                    )
                    log_dashboard_ui.info(
                        f"[ORPHELINE] '{iid}' associée SANS entrée dans self._processus_instances "
                        f"(pas de subprocess.Popen local dans cette session) -- NE sera donc PAS "
                        f"couverte par _synchroniser_job_object_instances/le Job Object, quel que soit "
                        f"l'état du réglage \"Fermer les instances à la fermeture\". Sa fermeture "
                        f"éventuelle à la sortie ne peut passer que par arreter_tout() -> "
                        f"_fermer_instance_orpheline_bloquant() (chemin \"réglage actif\" uniquement)."
                    )
                    break

        # Réconcilie self._instance_id_par_profil avec la réalité serveur :
        # un profil dont l'instance_id associé a disparu (process arrêté,
        # navigateur fermé -- cf. NavigateurFerme dans instance_nodriver.py,
        # ou arrêt depuis un autre Dashboard) redevient inactif ici, jamais
        # laissé à pointer vers un instance_id mort.
        for nom_profil, iid in list(self._instance_id_par_profil.items()):
            if iid not in ids_connus:
                del self._instance_id_par_profil[nom_profil]
                self._heure_debut_par_profil.pop(nom_profil, None)

        # PATCH (retour utilisateur, feedback "lancement en cours") --
        # dès que le serveur confirme l'instance (nom_profil réapparaît
        # ici dans self._instance_id_par_profil, réconcilié juste
        # au-dessus avec ids_connus), le lancement n'est plus "en cours"
        # : on retire le profil du set pour que le bouton bascule sur
        # l'icône "actif" (stop, fond rouge) au prochain rafraîchissement
        # -- cf. docstring complète de self._profils_en_cours_lancement
        # dans __init__. discard() par sécurité (no-op si déjà absent,
        # ex: profil découvert comme orpheline plutôt que lancé par ce
        # Dashboard, jamais ajouté au set dans ce cas).
        for nom_profil in list(self._profils_en_cours_lancement):
            if nom_profil in self._instance_id_par_profil:
                self._profils_en_cours_lancement.discard(nom_profil)

        if self._instance_selectionnee and self._instance_selectionnee not in ids_connus:
            # Le profil sélectionné vient de perdre son instance (voir
            # ci-dessus) : on désélectionne proprement plutôt que de
            # laisser l'UI dans un état incohérent (aperçu d'une instance
            # morte, bouton dans le mauvais état).
            self._instance_selectionnee = None
            self._derniere_image = None
            self.apercu_label.setPixmap(QPixmap())
            self.apercu_label.setText("L'instance s'est déconnectée")
            self._rafraichir_disponibilite_onglets()

        if (
            self._instance_selectionnee is None
            and self._profil_selectionne is not None
            and self._profil_selectionne in self._instance_id_par_profil
        ):
            # FIX : le profil actuellement sélectionné vient d'obtenir une
            # instance active (ex: _lancer_instance_pour_profil, confirmée
            # ici par le serveur) sans passer par _sur_selection_instance --
            # QListWidget.setCurrentItem() (cf. _rafraichir_liste_profils
            # plus bas) ne réémet PAS itemClicked, donc rien ne reliait
            # jamais l'instance tant que l'utilisateur ne re-cliquait pas
            # manuellement sur un item déjà sélectionné visuellement. Même
            # séquence que _sur_selection_instance pour un profil actif.
            nouvelle_instance = self._instance_id_par_profil[self._profil_selectionne]
            self._instance_selectionnee = nouvelle_instance
            self._derniere_image = None
            self._rafraichissement_ponctuel_en_attente = False
            self.apercu_label.setPixmap(QPixmap())
            if self.client_reseau is not None:
                self.apercu_label.setText(f"En attente du flux de {nouvelle_instance}…")
                self.client_reseau.envoyer_commande({
                    "type": "link", "pilote_id": self.client_reseau.id_client, "instance_id": nouvelle_instance,
                })
                self._appliquer_etat_streaming(nouvelle_instance)
            self._rafraichir_disponibilite_onglets()
            self._demander_liste_onglets_navigateur()

        # Nettoie les process qu'on suivait mais qui ne sont plus dans le
        # registre serveur (ex: navigateur fermé manuellement -- le process
        # instance_nodriver.py s'est terminé de lui-même, cf. NavigateurFerme)
        for id_suivi in list(self._processus_instances.keys()):
            if id_suivi not in ids_connus:
                del self._processus_instances[id_suivi]

        self._rafraichir_liste_profils()
        self._rafraichir_bouton_lancer_arreter()

    def eventFilter(self, watched, event):
        # PATCH (onglets Chrome/Camoufox) -- il y a désormais 2 listes (une
        # par type_instance, cf. self._onglets_profils) au lieu d'une
        # seule self.liste_instances : ce filtre doit réagir de la même
        # façon quelle que soit celle concernée. `liste_concernee` reste
        # None si `watched` n'est ni une des 2 listes ni un de leurs
        # viewports -- dans ce cas les deux blocs ci-dessous ne
        # s'appliquent pas, comme avant ce patch.
        liste_concernee = None
        for infos_onglet in self._onglets_profils.values():
            if watched is infos_onglet["liste"] or watched is infos_onglet["liste"].viewport():
                liste_concernee = infos_onglet["liste"]
                break

        # PATCH (retour utilisateur : "je veux que tu range la les
        # profils sur 3 colonne et non une seule colone") -- recalcule la
        # taille de grille de la liste concernée à chaque redimensionnement
        # du panneau (cf. _recalculer_grille_profils), pour que NB_COLONNES
        # colonnes restent exactement NB_COLONNES colonnes quelle que soit
        # la largeur réelle disponible, plutôt qu'une largeur de colonne
        # figée qui laisserait un espace mort ou en afficherait un nombre
        # différent selon l'écran/le DPI.
        if liste_concernee is not None and watched is liste_concernee and event.type() == QEvent.Resize:
            self._recalculer_grille_profils(liste_concernee)

        # PATCH (bouton lancer/arrêter par profil, demande utilisateur :
        # "je veux que sur jaque profils affiché il ya directement le
        # bouon de lancement") -- chaque liste reste un QListWidget en
        # IconMode avec delegate peint à la main (cf. ProfilsGridItemDelegate
        # plus haut dans ce fichier) : PAS de vrai QPushButton par cellule
        # (aurait nécessité setItemWidget() sur chaque item, cassant le
        # mécanisme actuel -- case à cocher native, sélection simple,
        # bordure verte peinte par le delegate -- tous utilisés ailleurs
        # dans cette classe). Le bouton est donc seulement DESSINÉ par le
        # delegate (cf. ProfilsGridItemDelegate.paint) ; le clic dessus est
        # intercepté ICI, sur le viewport de la liste concernée (cf.
        # commentaire sur l'installation du filtre, _construire_bloc_onglet_profils
        # plus haut), AVANT que Qt ne traite ce même clic comme une
        # sélection normale ou un basculement de case à cocher.
        #
        # CORRECTIF (retour utilisateur explicite : "sa ne fontionne pas,
        # le bouton ne peu pas etre cliquer" / "regarde bien comment les
        # autres boutons sur la meme ligne se clic") -- le toggle "bloquer
        # médias" était traité DANS le bloc générique ci-dessous, en 3e
        # position, avec exactement le même patron que les boutons
        # lancer/arrêter et Free. Ce patron repose sur DEUX hypothèses
        # qui tiennent pour eux mais pas forcément pour lui :
        #
        #   1. liste.itemAt(point) renvoie bien l'item SUR LEQUEL le
        #      bouton est peint. Le delegate peint en coordonnées
        #      dérivées d'option.rect sans être bridé par les frontières
        #      de cellule : dès que la zone du 3e bouton déborde du rect
        #      de son propre item (grille étroite, DPI, gridSize/sizeHint
        #      momentanément désynchronisés au premier affichage --
        #      cf. _recalculer_grille_profils), itemAt() renvoie le
        #      VOISIN, le rect recalculé sur ce voisin ne contient pas le
        #      point, et le clic tombe dans le vide. Exactement le
        #      symptôme décrit : le bouton s'affiche, mais rien ne se
        #      passe quand on clique dessus.
        #   2. le presse ET le relâche arrivent tous les deux sur le
        #      viewport et sont appariés. Un double-clic (Press, Release,
        #      DblClick, Release) casse cet appariement : le DblClick
        #      n'est pas un MouseButtonPress, donc il retombe dans la
        #      sélection normale de l'item.
        #
        # Ce bloc-ci ne dépend NI de l'un NI de l'autre : il cherche
        # lui-même l'item dont la zone de clic contient le point (cf.
        # _item_sous_bouton_bloquer_media), bascule dès le PRESS, et
        # consomme aussi le relâche et le double-clic de cette même zone
        # pour qu'aucun d'eux ne déclenche sélection ou case à cocher.
        # Placé AVANT le bloc générique : plus rien ne peut le masquer.
        if (
            liste_concernee is not None
            and watched is liste_concernee.viewport()
            and event.type() in (
                QEvent.MouseButtonPress, QEvent.MouseButtonRelease, QEvent.MouseButtonDblClick,
            )
            and event.button() == Qt.LeftButton
        ):
            item_media = self._item_sous_bouton_bloquer_media(
                liste_concernee, event.position().toPoint()
            )
            if item_media is not None:
                if event.type() == QEvent.MouseButtonPress:
                    nom_profil_media = item_media.data(Qt.UserRole)
                    if nom_profil_media is not None:
                        self._on_clic_bouton_bloquer_media_pour_profil(str(nom_profil_media))
                return True  # consommé -- ni sélection ni case à cocher sur ce clic

        # PATCH (demande utilisateur explicite : "il faut que sa detecte
        # si cest un clic long avant que sa selctionne toute la ligne, si
        # non cest le comportement standard... on clic aussi longuement
        # et sa deselctionne pour tout la ligne. clic long est dur en
        # environ 0.4 second" -- remplace une première version à icône
        # dédiée, abandonnée après retour utilisateur : "cest pas tres
        # intelligent") -- un appui long (SEUIL_APPUI_LONG_LIGNE_MS, cf.
        # __init__) du bouton GAUCHE n'importe où sur une carte de la
        # grille sélectionne/désélectionne toute SA ligne (bascule : si la
        # ligne est déjà entièrement cochée, l'appui long la décoche --
        # "toggle si deja selectioner" -- sinon il la coche). Un clic
        # COURT (relâché avant le seuil) n'est PAS intercepté ici :
        # l'événement retombe intact dans le bloc générique ci-dessous et
        # les blocs suivants, qui gardent leur comportement standard
        # exact (sélection simple de l'item, case à cocher unitaire,
        # boutons lancer/arrêter/free par profil...). Le clic DROIT n'est
        # PAS concerné par ce mécanisme (demande explicite : "non plus de
        # bouton droit... toujours bouton gauche") -- customContextMenuRequested
        # (menu Renommer/Supprimer) continue de fonctionner sans aucun
        # changement.
        #
        # Démarré au PRESS (self._minuteur_appui_long_ligne, cf.
        # __init__) plutôt que vérifié après coup à intervalles fixes :
        # un QTimer.singleShot posé ici tire après exactement le délai
        # voulu, sans dépendre d'un luxe de polling. Annulé (stop())
        # si relâché avant l'échéance (clic court, cf. bloc générique
        # ci-dessous, qui gère alors normalement CE relâche) OU si la
        # souris quitte la carte de départ avant l'échéance (glissement
        # accidentel -- pas un vrai "appui maintenu sur cette carte").
        # self._nom_presse_pour_appui_long retient le profil concerné pour
        # le callback du timer (capturé dans la lambda ci-dessous), ET
        # sert à MouseMove/Release pour savoir si on est encore dans la
        # fenêtre d'un appui potentiellement long.
        if (
            liste_concernee is not None
            and watched is liste_concernee.viewport()
            and event.type() == QEvent.MouseButtonPress
            and event.button() == Qt.LeftButton
        ):
            item_presse = liste_concernee.itemAt(event.position().toPoint())
            if item_presse is not None:
                nom_presse = item_presse.data(Qt.UserRole)
                self._nom_presse_pour_appui_long = str(nom_presse) if nom_presse is not None else None
                self._liste_presse_pour_appui_long = liste_concernee
                self._appui_long_ligne_declenche = False
                self._minuteur_appui_long_ligne.stop()
                self._minuteur_appui_long_ligne.start(self.SEUIL_APPUI_LONG_LIGNE_MS)
                # PAS de `return True` ici : un press COURT doit continuer
                # à produire le comportement standard (sélection de
                # l'item, éventuellement le début d'un drag natif Qt) --
                # seul un appui qui atteint réellement le seuil devient
                # une action DIFFÉRENTE (cf. _sur_timeout_appui_long_ligne),
                # qui elle-même n'a plus besoin de consommer quoi que ce
                # soit puisqu'elle se déclenche APRÈS coup, hors de ce
                # eventFilter.

        if (
            liste_concernee is not None
            and watched is liste_concernee.viewport()
            and event.type() == QEvent.MouseMove
            and getattr(self, "_nom_presse_pour_appui_long", None) is not None
        ):
            # Glissement pendant l'appui : si la souris quitte la carte
            # sur laquelle l'appui a commencé, ce n'est plus "un appui
            # maintenu sur cette carte" (ex. début d'un drag) -- annule le
            # minuteur, comme pour un relâchement anticipé ci-dessous.
            item_sous_curseur = liste_concernee.itemAt(event.position().toPoint())
            nom_sous_curseur = item_sous_curseur.data(Qt.UserRole) if item_sous_curseur is not None else None
            if nom_sous_curseur != self._nom_presse_pour_appui_long:
                self._minuteur_appui_long_ligne.stop()
                self._nom_presse_pour_appui_long = None
                self._liste_presse_pour_appui_long = None

        if (
            liste_concernee is not None
            and watched is liste_concernee.viewport()
            and event.type() == QEvent.MouseButtonRelease
            and event.button() == Qt.LeftButton
        ):
            self._minuteur_appui_long_ligne.stop()
            # Si l'appui long a déjà déclenché la bascule de la ligne
            # (cf. _sur_timeout_appui_long_ligne) AVANT ce relâche, ce
            # relâche-ci ne doit PAS en plus déclencher le comportement
            # standard (sélection simple de l'item) -- consommé.
            declenche = getattr(self, "_appui_long_ligne_declenche", False)
            self._nom_presse_pour_appui_long = None
            self._liste_presse_pour_appui_long = None
            self._appui_long_ligne_declenche = False
            if declenche:
                return True  # consommé -- l'action a déjà eu lieu pendant le maintien

        # Pattern presse/relâche classique d'un bouton (plutôt qu'agir dès
        # le press) : n'agit que si presse ET relâche tombent tous deux
        # dans le rect du bouton -- un press sur le bouton suivi d'un
        # relâchement ailleurs (glissement accidentel) n'exécute rien,
        # cohérent avec le comportement standard de n'importe quel
        # QPushButton.
        if (
            liste_concernee is not None
            and watched is liste_concernee.viewport()
            and event.type() in (QEvent.MouseButtonPress, QEvent.MouseButtonRelease)
        ):
            if event.button() == Qt.LeftButton:
                item = liste_concernee.itemAt(event.position().toPoint())
                if item is not None:
                    # NOTE (correctif) : QListWidget.viewOptions() n'existe
                    # pas côté PySide6 (méthode C++ Qt privée, jamais
                    # exposée aux bindings -- confirmé par crash en usage
                    # réel : AttributeError). rect_bouton() ci-dessous ne
                    # lit QUE option.rect (cf. sa définition dans
                    # ProfilsGridItemDelegate) : un QStyleOptionViewItem()
                    # tout nu avec juste .rect renseigné suffit donc, pas
                    # besoin de récupérer les options de rendu complètes
                    # de la vue.
                    option = QStyleOptionViewItem()
                    option.rect = liste_concernee.visualItemRect(item)
                    # PATCH (retour utilisateur explicite : "espacer nom/
                    # badges/boutons uniformément") -- rect_bouton/
                    # rect_bouton_free exigent désormais actif/duree (cf.
                    # leur docstring -- _gap_vertical en a besoin pour
                    # calculer le même espacement que paint()). Lus UNE
                    # SEULE FOIS ici, réutilisés pour les deux boutons ET
                    # le badge YouTube plus bas dans ce bloc.
                    actif_item = item.data(DELEGATE_ROLE_ACTIF)
                    duree_item = item.data(DELEGATE_ROLE_DUREE)
                    rect_bouton = ProfilsGridItemDelegate.rect_bouton(option, actif_item, duree_item)
                    if rect_bouton.contains(event.position().toPoint()):
                        if event.type() == QEvent.MouseButtonPress:
                            self._item_bouton_presse = item.data(Qt.UserRole)
                        else:  # MouseButtonRelease
                            nom_profil = item.data(Qt.UserRole)
                            if (
                                nom_profil is not None
                                and nom_profil == getattr(self, "_item_bouton_presse", None)
                            ):
                                self._on_clic_bouton_item_profil(nom_profil)
                            self._item_bouton_presse = None
                        return True  # consommé -- pas de sélection/case à cocher sur ce clic

                    # PATCH (bouton Free par profil) -- même pattern
                    # presse/relâche que rect_bouton ci-dessus, mais pour
                    # le second bouton peint par le delegate
                    # (rect_bouton_free). Sans ce bloc le bouton est
                    # dessiné mais un clic dessus ne fait rien (retombe
                    # sur la sélection/case à cocher normale de l'item).
                    rect_free = ProfilsGridItemDelegate.rect_bouton_free(option, actif_item, duree_item)
                    if rect_free.contains(event.position().toPoint()):
                        if event.type() == QEvent.MouseButtonPress:
                            self._item_bouton_free_presse = item.data(Qt.UserRole)
                        else:  # MouseButtonRelease
                            nom_profil = item.data(Qt.UserRole)
                            if (
                                nom_profil is not None
                                and nom_profil == getattr(self, "_item_bouton_free_presse", None)
                            ):
                                self._on_clic_free_pilote_pour_profil(nom_profil)
                            self._item_bouton_free_presse = None
                        return True  # consommé -- pas de sélection/case à cocher sur ce clic

                    # NOTE (toggle "bloquer médias") -- son hit-test ne se
                    # trouve PLUS ici : il a été sorti de ce bloc générique
                    # et placé tout en haut de cette méthode, en bloc
                    # autonome (cf. le CORRECTIF détaillé là-haut -- ce
                    # patron presse/relâche + itemAt() ne le rendait pas
                    # cliquable de façon fiable). Le clic est donc déjà
                    # consommé bien avant d'arriver ici.

                    # PATCH (badge YouTube togglable, demande utilisateur
                    # explicite : "un badge youtube ... que lon peu
                    # activer et desactiver par clic dessus") -- même
                    # pattern presse/relâche que rect_bouton/rect_bouton_free
                    # ci-dessus. actif/duree relus ICI sur l'item cliqué
                    # (DELEGATE_ROLE_ACTIF/DELEGATE_ROLE_DUREE) : rect_bouton_youtube
                    # exige ces deux valeurs pour rester rigoureusement
                    # synchronisé avec la position réellement peinte par
                    # paint() (cf. sa docstring -- la ligne badges monte
                    # d'EXTRA_HAUTEUR_DUREE quand la durée est affichée).
                    actif_item = item.data(DELEGATE_ROLE_ACTIF)
                    duree_item = item.data(DELEGATE_ROLE_DUREE)
                    rect_youtube = ProfilsGridItemDelegate.rect_bouton_youtube(option, actif_item, duree_item)
                    if rect_youtube.contains(event.position().toPoint()):
                        if event.type() == QEvent.MouseButtonPress:
                            self._item_bouton_youtube_presse = item.data(Qt.UserRole)
                        else:  # MouseButtonRelease
                            nom_profil = item.data(Qt.UserRole)
                            if (
                                nom_profil is not None
                                and nom_profil == getattr(self, "_item_bouton_youtube_presse", None)
                            ):
                                self._on_clic_badge_youtube_pour_profil(nom_profil)
                            self._item_bouton_youtube_presse = None
                        return True  # consommé -- pas de sélection/case à cocher sur ce clic

                    # PATCH (retour utilisateur explicite : "enlève le
                    # badge youtube, tu le mets sur une autre ligne en
                    # bas ... tu vas mettre 3 badges : youtube, tiktok,
                    # et un symbole de ia") -- même pattern presse/relâche
                    # que le badge YouTube ci-dessus, pour le badge TikTok.
                    rect_tiktok = ProfilsGridItemDelegate.rect_bouton_tiktok(option)
                    if rect_tiktok.contains(event.position().toPoint()):
                        if event.type() == QEvent.MouseButtonPress:
                            self._item_bouton_tiktok_presse = item.data(Qt.UserRole)
                        else:  # MouseButtonRelease
                            nom_profil = item.data(Qt.UserRole)
                            if (
                                nom_profil is not None
                                and nom_profil == getattr(self, "_item_bouton_tiktok_presse", None)
                            ):
                                self._on_clic_badge_tiktok_pour_profil(nom_profil)
                            self._item_bouton_tiktok_presse = None
                        return True  # consommé -- pas de sélection/case à cocher sur ce clic

                    # PATCH (idem ci-dessus) -- badge IA, 3e badge de la
                    # ligne 4.
                    rect_ia = ProfilsGridItemDelegate.rect_bouton_ia(option)
                    if rect_ia.contains(event.position().toPoint()):
                        if event.type() == QEvent.MouseButtonPress:
                            self._item_bouton_ia_presse = item.data(Qt.UserRole)
                        else:  # MouseButtonRelease
                            nom_profil = item.data(Qt.UserRole)
                            if (
                                nom_profil is not None
                                and nom_profil == getattr(self, "_item_bouton_ia_presse", None)
                            ):
                                self._on_clic_badge_ia_pour_profil(nom_profil)
                            self._item_bouton_ia_presse = None
                        return True  # consommé -- pas de sélection/case à cocher sur ce clic

                    # PATCH (demande utilisateur explicite : "je veux que
                    # on peu mettre un statut de favoris pour un profils,
                    # donc dans les card des profils tu vas mettre un
                    # onglet : favoris") -- badge Favori, 4e et dernier
                    # badge de la ligne 4, même pattern presse/relâche que
                    # les trois autres ci-dessus.
                    rect_favori = ProfilsGridItemDelegate.rect_bouton_favori(option)
                    if rect_favori.contains(event.position().toPoint()):
                        if event.type() == QEvent.MouseButtonPress:
                            self._item_bouton_favori_presse = item.data(Qt.UserRole)
                        else:  # MouseButtonRelease
                            nom_profil = item.data(Qt.UserRole)
                            if (
                                nom_profil is not None
                                and nom_profil == getattr(self, "_item_bouton_favori_presse", None)
                            ):
                                self._on_clic_badge_favori_pour_profil(nom_profil)
                            self._item_bouton_favori_presse = None
                        return True  # consommé -- pas de sélection/case à cocher sur ce clic

                    # PATCH (demande utilisateur explicite : "tu vas
                    # rajouter le badge Test, comme il y a le badge
                    # youtube, tiktok") -- badge Test, 5e badge de la
                    # ligne 4, même pattern presse/relâche que les
                    # quatre autres ci-dessus.
                    rect_test = ProfilsGridItemDelegate.rect_bouton_test(option)
                    if rect_test.contains(event.position().toPoint()):
                        if event.type() == QEvent.MouseButtonPress:
                            self._item_bouton_test_presse = item.data(Qt.UserRole)
                        else:  # MouseButtonRelease
                            nom_profil = item.data(Qt.UserRole)
                            if (
                                nom_profil is not None
                                and nom_profil == getattr(self, "_item_bouton_test_presse", None)
                            ):
                                self._on_clic_badge_test_pour_profil(nom_profil)
                            self._item_bouton_test_presse = None
                        return True  # consommé -- pas de sélection/case à cocher sur ce clic

        return super().eventFilter(watched, event)

    def _item_sous_bouton_bloquer_media(self, liste: QListWidget, point) -> Optional[QListWidgetItem]:
        """CORRECTIF (retour utilisateur explicite : "le bouton ne peu pas
        etre cliquer") -- retourne l'item de `liste` dont la ZONE DE CLIC
        du bouton "bloquer médias" (cf. ProfilsGridItemDelegate.
        rect_clic_bloquer_media) contient `point`, ou None.

        POURQUOI NE PAS SIMPLEMENT UTILISER liste.itemAt(point) comme le
        font les autres boutons peints de la carte : itemAt() répond "quel
        item OCCUPE ce point", alors que la vraie question ici est "quel
        item a PEINT SON BOUTON sous ce point". Les deux coïncident tant
        que le bouton reste strictement à l'intérieur du rect de son
        propre item -- mais le delegate peint en coordonnées libres, sans
        être borné par les frontières de cellule. Dès que la zone du 3e
        bouton mord sur la cellule voisine, itemAt() désigne le voisin, le
        rect recalculé sur ce voisin ne contient pas le point, et le clic
        est silencieusement perdu. On balaie donc les items nous-mêmes :
        c'est la seule formulation qui reste vraie quelles que soient la
        largeur de colonne, la densité de pixels et l'état de
        synchronisation gridSize/sizeHint (cf. _recalculer_grille_profils).

        Coût : une passe sur les items VISIBLES seulement (les autres sont
        écartés par le test d'intersection avec le viewport), à chaque
        press/release/double-clic gauche -- quelques dizaines de QRect au
        plus, imperceptible pour un clic, contrairement à une boucle à
        haute fréquence comme le streaming de frames.

        Premier item correspondant retourné : deux zones de clic ne
        peuvent pas se chevaucher (MARGE_BOUTON = 6px sépare deux boutons
        consécutifs, MARGE_CLIC_BOUTON = 4px de tolérance de chaque côté),
        donc l'ordre de balayage n'introduit aucune ambiguïté."""
        rect_viewport = liste.viewport().rect()
        for i in range(liste.count()):
            item = liste.item(i)
            if item is None:
                continue
            rect_item = liste.visualItemRect(item)
            if rect_item.isEmpty() or not rect_item.intersects(rect_viewport):
                continue
            # Même construction d'option que le bloc générique plus haut :
            # rect_clic_bloquer_media ne lit QUE option.rect, un
            # QStyleOptionViewItem nu suffit (QListWidget.viewOptions()
            # n'existe pas côté PySide6 -- cf. NOTE dans eventFilter).
            option = QStyleOptionViewItem()
            option.rect = rect_item
            zone = ProfilsGridItemDelegate.rect_clic_bloquer_media(
                option, item.data(DELEGATE_ROLE_ACTIF), item.data(DELEGATE_ROLE_DUREE)
            )
            if zone.contains(point):
                return item
        return None

    def showEvent(self, event):
        # PATCH (retour utilisateur : "a louverture de lápplication la
        # liste des profils cest sur une seule ranger, je suis obliger
        # de maximiser toute la fenetre avant que les 3 ranger
        # apparaisent") -- au tout premier affichage, une liste peut
        # recevoir un QEvent.Resize avec une largeur provisoire (avant que
        # le layout de la fenêtre principale ne soit stabilisé), ce qui
        # fige _recalculer_grille_profils() sur un mauvais nombre de
        # colonnes tant qu'aucun redimensionnement réel ne survient
        # ensuite (typiquement en maximisant). On force donc un recalcul
        # supplémentaire dès que cet écran devient réellement visible,
        # différé de 0ms via singleShot pour laisser Qt terminer la mise
        # en page en cours avant de mesurer la largeur disponible --
        # idempotent et sans effet de bord si la grille était déjà
        # correcte. Aucun argument passé -> recalcule pour LES DEUX
        # onglets (cf. _recalculer_grille_profils), y compris celui
        # actuellement caché derrière l'autre : sans quoi l'onglet
        # non-visible au premier affichage resterait figé sur une
        # mauvaise grille jusqu'à son premier vrai resize.
        super().showEvent(event)
        QTimer.singleShot(0, self._recalculer_grille_profils)

    def _sur_changement_onglet_profils(self, index_onglet: int):
        """Connecté à self._tabs_profils.currentChanged (cf. son
        commentaire d'appel) -- recalcule la grille de L'ONGLET QUI
        DEVIENT VISIBLE, sur le même principe que showEvent ci-dessus
        (singleShot(0) : laisse Qt terminer la mise en page de bascule
        d'onglet avant de mesurer liste.viewport().width(), sinon la
        largeur lue pourrait encore être celle -- provisoire -- d'avant
        la bascule)."""
        type_instance = self._type_instance_par_index_onglet.get(index_onglet)
        infos_onglet = self._onglets_profils.get(type_instance) if type_instance else None
        if infos_onglet is not None:
            QTimer.singleShot(0, lambda: self._recalculer_grille_profils(infos_onglet["liste"]))

    def _recalculer_grille_profils(self, liste: Optional[QListWidget] = None):
        """Calcule et applique la gridSize d'une liste de profils pour
        tenir exactement NB_COLONNES colonnes dans la largeur actuellement
        disponible (viewport, donc déjà net de la barre de défilement si
        jamais elle redevient visible). Doit rester cohérent avec
        setUniformItemSizes (cf. _construire_bloc_onglet_profils) : TOUS
        les items d'une même liste partagent cette même taille,
        indépendamment de la longueur du nom de profil -- un nom trop
        long est tronqué par Qt (ellipsis), pas de retour à la ligne dans
        la cellule (aurait cassé l'alignement de la grille).

        PATCH (onglets Chrome/Camoufox) -- `liste` : la QListWidget à
        recalculer. None (par défaut) -> recalcule pour LES DEUX listes
        de self._onglets_profils (cf. showEvent, qui doit couvrir l'onglet
        caché en plus du visible) ; sinon ne recalcule QUE la liste
        passée (cf. eventFilter, appelé pour la liste précise qui vient de
        recevoir un QEvent.Resize -- pas besoin de recalculer l'autre,
        dont la largeur n'a pas changé).

        MARGE_SECURITE_PX (vérifié empiriquement avec un test Qt
        offscreen) : quand largeur_item * NB_COLONNES tombe EXACTEMENT
        sur la largeur du viewport, Qt fait passer le dernier item à la
        ligne suivante au lieu de le garder sur la même rangée (résultat :
        une colonne de moins que prévu, pile le bug qu'on cherche à
        éviter) -- quelques pixels de marge suffisent à rester
        strictement en dessous de cette limite et donc à garantir
        NB_COLONNES colonnes de façon fiable, sur toute largeur de
        panneau testée."""
        if liste is None:
            for infos_onglet in self._onglets_profils.values():
                self._recalculer_grille_profils(infos_onglet["liste"])
            return

        # PATCH (demande utilisateur explicite : "tu augmente
        # progressivement le nombre de profils affiché sur une ligne sur
        # le card de profils" -- pensé pour accompagner le QSplitter
        # glissable ajouté entre panneau_gauche/panneau_droit, cf.
        # _construire_ui) -- NB_COLONNES n'est plus une constante fixe
        # (4, historique ci-dessous conservé pour mémoire) : elle est
        # recalculée à CHAQUE appel à partir de la largeur RÉELLEMENT
        # disponible, pour que glisser la poignée du splitter vers la
        # droite (panneau_gauche qui s'élargit) fasse apparaître des
        # colonnes supplémentaires progressivement, au lieu de rester
        # bloqué sur un nombre fixe alors que la carte de gauche a
        # pourtant toute la place pour en afficher plus. LARGEUR_CIBLE_
        # ITEM_PX (~190px) est la largeur de carte confortable visée
        # (nom de profil + badges lisibles sans troncature, cf. les PATCH
        # historiques ci-dessous qui étaient déjà arrivés empiriquement à
        # ~195-210px de largeur utile par carte) : le nombre de colonnes
        # est le plus grand nombre qui tient dans largeur_dispo sans
        # descendre sous cette cible, borné entre NB_COLONNES_MIN (jamais
        # une grille inutilisable même poignée glissée à l'extrême
        # gauche) et NB_COLONNES_MAX (jamais des cartes ridiculement
        # étroites même sur un panneau_droit totalement fermé, sur un
        # écran très large).
        #
        # (Historique conservé : "es ce que tu peu faire a ce que la
        # liste des proisl saffiche sur 4 colonne au lie de 3" -- 4
        # restait alors la valeur fixe, panneau_gauche lui-même à
        # largeur figée par setFixedWidth ; ce n'est plus le cas depuis
        # l'introduction du QSplitter, la largeur variant désormais en
        # continu.)
        LARGEUR_CIBLE_ITEM_PX = 190
        NB_COLONNES_MIN = 2
        NB_COLONNES_MAX = 8
        MARGE_SECURITE_PX = 4
        largeur_dispo = liste.viewport().width()
        if largeur_dispo <= 0:
            # Pas encore de géométrie stable (premier appel dans __init__,
            # avant le premier show()) -- retenter au premier vrai resize.
            return
        NB_COLONNES = max(
            NB_COLONNES_MIN,
            min(NB_COLONNES_MAX, largeur_dispo // LARGEUR_CIBLE_ITEM_PX),
        )
        largeur_item = max((largeur_dispo - MARGE_SECURITE_PX) // NB_COLONNES, 1)
        # PATCH (demande utilisateur : "augemente le with de 1/2" +
        # "change aussi la hauteur") -- NB_COLONNES conservé : largeur_item
        # grandit donc automatiquement avec largeur_dispo (elle-même
        # élargie via panneau_gauche.setFixedWidth(620), cf. plus bas dans
        # ce fichier) -- pas besoin d'y toucher ici, la formule
        # largeur_dispo/NB_COLONNES fait le travail.
        #
        # PATCH (retour utilisateur : "on dirait que la hautuer na pas
        # ete doubler, le temps est mal affiher, il ya pas assez despace
        # en hauteur") -- setUniformItemSizes (cf.
        # _construire_bloc_onglet_profils) impose la MÊME hauteur à toutes
        # les cartes d'une liste, donc cette valeur doit couvrir le cas le
        # PLUS haut (profil actif : nom+badge, durée, ET la ligne de
        # boutons lancer/arrêter+Free en bas), pas seulement le cas d'un
        # profil inactif -- sinon les cartes actives débordent
        # silencieusement de la hauteur allouée et le texte de durée/la
        # ligne de boutons se retrouvent coupés ou chevauchés. Dérivée des
        # constantes réelles du delegate (ProfilsGridItemDelegate) plutôt
        # qu'un nombre en dur, pour que les deux restent garantis
        # synchronisés si ces constantes changent un jour.
        hauteur_ligne_nom = 24  # hauteur d'une ligne de texte (nom + badge), padding QSS inclus
        # CORRECTIF (retour utilisateur explicite : "il y a encore un
        # grand vide entre la ligne des badges et la dernière partie en
        # bas") -- cause trouvée : l'ancienne marge fixe (EXTRA_HAUTEUR_DUREE
        # + 16px de padding QSS, additionnés SANS lien l'un avec l'autre)
        # réservait 32px entre le bas du bloc infos (rect_bloc_infos,
        # ancré en haut sous le nom -- sa hauteur EXTRA_HAUTEUR_BADGES
        # vient de grandir avec l'ajout de la 4e ligne "badges", cf. plus
        # haut) et le haut de la ligne durée/boutons (ancrée depuis le
        # BAS de la carte, rect_duree/rect_bouton) -- alors que ces deux
        # blocs devraient normalement se toucher avec juste une petite
        # respiration, PAS un espace de 28px. La ligne durée n'occupe
        # cet espace que sur les profils actifs AVEC durée affichée
        # (cf. rect_duree, ancrée depuis le bas indépendamment du bloc
        # infos) -- sur tous les autres profils, l'espace réservé pour
        # elle restait entièrement vide.
        # MARGE_RESPIRATION_BAS (6px, cohérente avec les petits
        # espacements déjà utilisés ailleurs sur la carte -- 6px entre
        # point/drapeau, drapeau/texte, cf. paint()) : la plus petite
        # marge qui, ajoutée à EXTRA_HAUTEUR_DUREE, place tout juste le
        # haut de la ligne durée au ras du bas du bloc infos SANS
        # chevauchement (vérifié : bas du bloc infos = HAUTEUR_ZONE_NOM +
        # EXTRA_HAUTEUR_BADGES ; haut de la ligne durée dans la nouvelle
        # hauteur = hauteur_ligne_nom + EXTRA_HAUTEUR_BADGES + marge -
        # EXTRA_HAUTEUR_DUREE -- les deux s'égalent exactement pour
        # marge = HAUTEUR_ZONE_NOM - hauteur_ligne_nom + EXTRA_HAUTEUR_DUREE
        # = 20, +6 de respiration = 26).
        MARGE_RESPIRATION_BAS = 26  # px -- remplace l'ancien "+ 16" (qui datait d'avant la 4e ligne badges)
        hauteur_item_base = (
            hauteur_ligne_nom
            + ProfilsGridItemDelegate.EXTRA_HAUTEUR_BOUTONS
            + ProfilsGridItemDelegate.EXTRA_HAUTEUR_BADGES
            + MARGE_RESPIRATION_BAS
        )
        # PATCH (retour utilisateur explicite : "pourquoi je voir un
        # enorme vide entre les boutons et le contenue de chaque card" +
        # "jai dit que tu enleve lespace unitile") -- le x2 ci-dessous
        # (ancien commentaire : "il faut doubler leur hauteur") datait du
        # design à UNE SEULE ligne badge (cf. ancien rect_ligne_badges,
        # remplacé depuis par rect_bloc_infos/3 lignes compactes) : à
        # l'époque, doubler compensait une carte visuellement trop
        # petite. Maintenant que hauteur_item_base inclut déjà les 3
        # lignes réelles du bloc infos (pays+ip+proxy, cf.
        # EXTRA_HAUTEUR_BADGES) + la marge de respiration, le contenu
        # remplit correctement l'espace SANS multiplicateur -- doubler
        # ne fait plus que créer le grand vide signalé, entre le bloc
        # infos (ancré en haut, cf. rect_bloc_infos) et le séparateur/
        # boutons (ancrés en bas, cf. rect_bouton).
        hauteur_item = hauteur_item_base
        liste.setGridSize(QSize(largeur_item, hauteur_item))
        # PATCH (retour utilisateur explicite -- cf. docstring de
        # ProfilsGridItemDelegate.largeur_cible_px) -- gridSize seul ne
        # suffit pas : sizeHint() du delegate doit AUSSI être mis à jour
        # avec la même largeur_item, sous peine de cartes minuscules
        # collées à gauche dans des cellules pourtant bien dimensionnées
        # (cf. bug documenté en détail sur largeur_cible_px). Récupéré
        # via liste.itemDelegate() (API Qt native) plutôt que
        # self._onglets_profils[...]["delegate"] -- cette méthode ne
        # reçoit que `liste`, pas le type_instance associé.
        delegate = liste.itemDelegate()
        if isinstance(delegate, ProfilsGridItemDelegate) and (
            delegate.largeur_cible_px != largeur_item or delegate.hauteur_cible_px != hauteur_item
        ):
            delegate.largeur_cible_px = largeur_item
            # PATCH (retour utilisateur explicite : cartes visuellement
            # écrasées malgré un gridSize correct -- cf. docstring de
            # ProfilsGridItemDelegate.hauteur_cible_px) -- même
            # synchronisation que largeur_cible_px ci-dessus, appliquée à
            # la hauteur : gridSize et sizeHint() doivent utiliser LA
            # MÊME valeur, sous peine de cartes dont la hauteur peinte ne
            # correspond pas à la cellule qui leur est allouée.
            delegate.hauteur_cible_px = hauteur_item
            # setGridSize seul ne redéclenche pas toujours un nouveau
            # sizeHint() pour des items déjà en place (Qt peut réutiliser
            # la géométrie déjà calculée) -- scheduleDelayedItemsLayout()
            # force explicitement Qt à recalculer la géométrie de tous
            # les items à partir du delegate mis à jour, sans reconstruire
            # les items eux-mêmes (contrairement à _rafraichir_liste_profils,
            # inutilement coûteux ici pour un simple changement de taille).
            liste.scheduleDelayedItemsLayout()


    def _formater_duree_activite(self, nom_profil: str) -> Optional[str]:
        """Formate depuis combien de temps l'instance du profil tourne
        (cf. self._heure_debut_par_profil, en secondes time.monotonic()) --
        None si le profil n'a pas d'heure de début connue (jamais lancé
        depuis ce Dashboard ni découvert actif côté serveur, ne devrait
        normalement pas arriver pour un profil actif, cf. les deux points
        d'entrée de self._heure_debut_par_profil). Format volontairement
        compact ("12 min", "1 h 05") -- affiché en petit sous le nom du
        profil par ProfilsGridItemDelegate, dans un espace de grille
        limité (cf. patch "3 colonnes")."""
        debut = self._heure_debut_par_profil.get(nom_profil)
        if debut is None:
            return None
        secondes = max(0, int(time.monotonic() - debut))
        if secondes < 60:
            return f"{secondes} s"
        minutes, secondes = divmod(secondes, 60)
        if minutes < 60:
            return f"{minutes} min"
        heures, minutes = divmod(minutes, 60)
        return f"{heures} h {minutes:02d}"

    def _rafraichir_durees_profils_actifs(self):
        """Appelée à intervalle régulier par self._timer_durees_profils
        (cf. __init__) -- met à jour UNIQUEMENT le texte de durée
        (DELEGATE_ROLE_DUREE) des items déjà construits, sans passer par
        _rafraichir_liste_profils (qui reconstruit tout : perdrait la
        sélection/le scroll pour un simple rafraîchissement de texte).
        viewport().update() force le repaint -- setData() seul ne suffit
        pas à faire redessiner un delegate custom immédiatement, cf. doc
        Qt sur QAbstractItemView.dataChanged (pas connecté automatiquement
        à un repaint pour un rôle custom).

        PATCH (onglets Chrome/Camoufox) -- boucle sur LES DEUX listes de
        self._onglets_profils, pas seulement celle actuellement visible :
        un profil actif dans l'onglet caché doit voir sa durée progresser
        exactement comme celui de l'onglet visible, pour être à jour dès
        que l'utilisateur bascule d'onglet plutôt que de figer jusqu'au
        prochain _rafraichir_liste_profils."""
        for infos_onglet in self._onglets_profils.values():
            liste = infos_onglet["liste"]
            if liste.count() == 0:
                continue
            au_moins_un_actif = False
            for i in range(liste.count()):
                item = liste.item(i)
                nom_profil = item.data(Qt.UserRole)
                if nom_profil in self._instance_id_par_profil:
                    au_moins_un_actif = True
                    item.setData(DELEGATE_ROLE_DUREE, self._formater_duree_activite(nom_profil))
            if au_moins_un_actif:
                liste.viewport().update()

    def _rafraichir_etats_boutons_liste_profils(self):
        """PATCH (bouton lancer/arrêter + Free par profil, demande
        utilisateur) -- même pattern que _rafraichir_durees_profils_actifs
        juste au-dessus : met à jour UNIQUEMENT DELEGATE_ROLE_ETAT_BOUTON
        et DELEGATE_ROLE_ETAT_FREE sur les items déjà construits (pas de
        passage par _rafraichir_liste_profils, qui perdrait sélection/
        scroll pour un simple changement d'état visuel). Appelée depuis
        _rafraichir_bouton_lancer_arreter (cf. plus bas -- point déjà
        centralisé, appelé à chaque changement d'état actif/inactif/en-
        cours-d'arrêt d'un profil, 12 sites dans ce fichier) et depuis
        _on_clic_free_pilote_pour_profil/_sur_force_unlink_ok, plutôt que
        dupliquée à chacun de ces sites.

        PATCH (onglets Chrome/Camoufox) -- boucle sur LES DEUX listes,
        même raison que _rafraichir_durees_profils_actifs ci-dessus :
        l'état visuel des boutons peints doit rester correct même dans
        l'onglet actuellement caché."""
        for infos_onglet in self._onglets_profils.values():
            liste = infos_onglet["liste"]
            if liste.count() == 0:
                continue
            for i in range(liste.count()):
                item = liste.item(i)
                nom_profil = item.data(Qt.UserRole)
                if nom_profil is None:
                    continue
                actif = nom_profil in self._instance_id_par_profil
                if nom_profil in self._profils_en_cours_arret:
                    etat_bouton = "arret_en_cours"
                elif actif:
                    etat_bouton = "actif"
                elif nom_profil in self._profils_en_cours_lancement:
                    # PATCH (retour utilisateur : bouton figé "inactif"
                    # pendant les 30-50s avant que le serveur confirme
                    # l'instance) -- cf. docstring de
                    # self._profils_en_cours_lancement dans __init__.
                    etat_bouton = "lancement_en_cours"
                else:
                    etat_bouton = "inactif"
                if item.data(DELEGATE_ROLE_ETAT_BOUTON) != etat_bouton:
                    item.setData(DELEGATE_ROLE_ETAT_BOUTON, etat_bouton)
                if not actif:
                    etat_free = None
                elif nom_profil in self._profils_en_cours_free:
                    etat_free = "free_en_cours"
                else:
                    etat_free = "actif"
                if item.data(DELEGATE_ROLE_ETAT_FREE) != etat_free:
                    item.setData(DELEGATE_ROLE_ETAT_FREE, etat_free)
            liste.viewport().update()

    def _rafraichir_liste_profils(self):
        """Reconstruit la liste de gauche à partir de self._profils (tous
        les profils PERSISTANTS connus, cf. charger_registre_profils --
        qu'une instance tourne dessus ou non, cf. décision utilisateur :
        les profils créés doivent toujours apparaître, par leur nom) et de
        self._instance_id_par_profil (quels profils ont actuellement une
        instance active). Chaque item porte le NOM du profil dans
        Qt.UserRole (pas un instance_id -- cf. _sur_selection_instance),
        pour que la sélection reste valable même quand le profil est
        inactif (aucune instance associée pour l'instant)."""
        # PATCH (onglets Chrome/Camoufox) -- il n'y a plus UNE liste à
        # reconstruire mais DEUX (une par type_instance, cf.
        # self._onglets_profils) : chaque profil est routé vers celle qui
        # correspond à son type (cf. obtenir_config_profil ci-dessous).
        # La sélection courante (nom_selectionne_avant) est mémorisée PAR
        # liste -- un profil sélectionné dans l'onglet Chrome ne doit pas
        # se retrouver "sélectionné" dans l'onglet Camoufox après
        # reconstruction, les deux listes ont chacune leur propre notion
        # d'item courant.
        noms_selectionnes_avant = {}
        for type_instance, infos_onglet in self._onglets_profils.items():
            item_courant = infos_onglet["liste"].currentItem()
            if item_courant is not None:
                noms_selectionnes_avant[type_instance] = item_courant.data(Qt.UserRole)

        # PATCH (retour utilisateur : "lorsque je demare un profils, le
        # scroll se reinitialise et sa vas jusqu'au debut") -- liste.clear()
        # plus bas détruit tous les items de la QListWidget, ce qui remet
        # sa scrollbar verticale interne à 0 ; comme _rafraichir_liste_profils
        # tourne à chaque démarrage/arrêt de profil (reconstruction
        # complète), l'utilisateur se retrouvait ramené en haut de la
        # grille à chaque action. On mémorise ici la position de scroll de
        # CHAQUE liste avant le clear, pour la restaurer après
        # reconstruction (cf. plus bas, juste avant le retour de la
        # méthode) -- même principe que noms_selectionnes_avant ci-dessus.
        positions_scroll_avant = {
            type_instance: infos_onglet["liste"].verticalScrollBar().value()
            for type_instance, infos_onglet in self._onglets_profils.items()
        }

        # Un profil supprimé/renommé entre-temps ne doit pas laisser de
        # nom fantôme dans le lot coché (cf. self._profils_coches) --
        # intersection avec les profils qui existent encore réellement.
        self._profils_coches &= set(self._profils.keys())

        # blockSignals : la boucle ci-dessous appelle setCheckState() sur
        # chaque item construit, ce qui émettrait itemChanged pour chacun
        # -- inutile et potentiellement coûteux ici (reconstruction complète),
        # cf. _sur_case_profil_changee, qui n'a besoin de réagir qu'à une
        # bascule faite PAR l'utilisateur, pas à ce peuplement programmatique.
        for infos_onglet in self._onglets_profils.values():
            infos_onglet["liste"].blockSignals(True)
            infos_onglet["liste"].clear()

        # PATCH (demande explicite utilisateur : "je veux que dans
        # l'interface du dashboard tu patch de tel sorte que les profils
        # se rangent par date de création") -- remplace le tri
        # alphabétique (str.lower) par un tri sur la date de création du
        # DOSSIER de chaque profil (self._profils[nom_profil] = chemin
        # du dossier, cf. charger_registre_profils), du plus RÉCENT au
        # plus ANCIEN (reverse=True, choix explicite de l'utilisateur).
        # os.stat().st_ctime : sous Windows c'est réellement la date de
        # création ; sous Linux/macOS c'est la date de dernier
        # changement de métadonnées de l'inode (pas une vraie date de
        # création, mais la meilleure approximation dispo nativement --
        # un dossier de profil n'est en pratique jamais renommé/modifié
        # après sa création). Aucune migration nécessaire : ça marche
        # immédiatement pour tous les profils déjà existants, puisque ce
        # timestamp est déjà porté par le système de fichiers lui-même.
        # Défensif (dossier absent/inaccessible -> 0.0, relégué en toute
        # fin de liste) pour ne jamais faire planter tout le
        # rafraîchissement du Dashboard à cause d'un seul profil
        # problématique.
        def _date_creation_profil(nom_profil: str) -> float:
            try:
                return os.stat(self._profils[nom_profil]).st_ctime
            except OSError:
                return 0.0

        for nom_profil in sorted(self._profils.keys(), key=_date_creation_profil, reverse=True):
            actif = nom_profil in self._instance_id_par_profil
            # PATCH (retour utilisateur : "juste le point de actifs [doit
            # devenir vert]") -- le symbole "●"/"○" n'est plus dans le
            # texte natif (peint en couleur de texte uniforme, donc pas
            # colorable indépendamment du mot "actif"/"inactif" à côté) :
            # il est maintenant peint à la main juste avant ce texte, cf.
            # ProfilsGridItemDelegate.paint -- vert si actif, gris sinon.
            # PATCH (retour utilisateur : "puisque il ya le point de
            # couleur vert, je pense que on a plus besoin du mot actifs
            # ou inactifs") -- le point peint par ProfilsGridItemDelegate
            # (vert si actif, gris sinon, cf. paint()) porte maintenant
            # seul cette information ; le mot texte devenait redondant à
            # côté de lui.
            # PATCH (onglets Chrome/Camoufox) -- config_profil détermine
            # maintenant dans QUELLE liste ce profil est ajouté (routage),
            # plus seulement un badge textuel cosmétique : chaque profil
            # apparaît désormais UNIQUEMENT dans l'onglet de son type,
            # jamais dans les deux. obtenir_config_profil retombe sur
            # "chrome" pour tout profil créé avant l'introduction de
            # profils_config.json (pas d'entrée dedans) -- il atterrit
            # donc naturellement dans l'onglet Chrome, comportement
            # historique préservé pour les profils existants.
            config_profil = obtenir_config_profil(nom_profil)
            type_instance = config_profil["type_instance"]
            infos_onglet = self._onglets_profils.get(type_instance)
            if infos_onglet is None:
                # Filet de sécurité : type inconnu/futur -> ne devrait pas
                # arriver (obtenir_config_profil garantit déjà une valeur
                # parmi TYPES_INSTANCE_VALIDES), mais on ne veut jamais
                # perdre silencieusement un profil existant si ce
                # dictionnaire venait à ne pas couvrir un type.
                infos_onglet = self._onglets_profils["chrome"]
            liste = infos_onglet["liste"]

            item = QListWidgetItem(nom_profil)
            item.setData(Qt.UserRole, nom_profil)
            # PATCH (retour utilisateur : "je veux que pour les profils
            # actif il on des bordure vert" + "je veux aussi que on
            # affiche la duree de chaque instance") -- deux rôles custom
            # lus par ProfilsGridItemDelegate (cf. plus bas dans ce
            # fichier) : DELEGATE_ROLE_ACTIF pilote la bordure verte,
            # DELEGATE_ROLE_DUREE le petit texte de durée sous le nom.
            # Recalculés aussi par _rafraichir_durees_profils_actifs (timer
            # dédié, cf. __init__) SANS reconstruire toute la liste --
            # cette méthode-ci (_rafraichir_liste_profils) ne tourne, elle,
            # qu'aux vrais changements de contenu (profil ajouté/retiré,
            # instance démarrée/arrêtée).
            item.setData(DELEGATE_ROLE_ACTIF, actif)
            item.setData(
                DELEGATE_ROLE_DUREE,
                self._formater_duree_activite(nom_profil) if actif else None,
            )
            # PATCH (bouton lancer/arrêter par profil) -- mêmes 3 états que
            # bouton_lancer_arreter global (cf. _rafraichir_bouton_lancer_arreter) :
            # "arret_en_cours" prioritaire sur "actif", cohérent avec cette
            # méthode-là.
            if nom_profil in self._profils_en_cours_arret:
                etat_bouton = "arret_en_cours"
            elif actif:
                etat_bouton = "actif"
            elif nom_profil in self._profils_en_cours_lancement:
                # PATCH (retour utilisateur, même correction que dans
                # _rafraichir_etats_boutons_liste_profils ci-dessus --
                # garder les deux méthodes cohérentes) -- cf. docstring
                # de self._profils_en_cours_lancement dans __init__.
                etat_bouton = "lancement_en_cours"
            else:
                etat_bouton = "inactif"
            item.setData(DELEGATE_ROLE_ETAT_BOUTON, etat_bouton)
            # PATCH (bouton Free par profil) -- même 3 états que dans
            # _rafraichir_etats_boutons_liste_profils (garder les deux
            # méthodes cohérentes) : sans cette ligne, chaque
            # reconstruction complète de la liste (ajout/suppression/
            # renommage de profil, ouverture de l'écran) fait disparaître
            # le bouton Free de toutes les cartes actives jusqu'au
            # prochain appel de _rafraichir_etats_boutons_liste_profils,
            # puisque DELEGATE_ROLE_ETAT_FREE ne serait alors jamais
            # renseigné sur les items fraîchement construits.
            if not actif:
                etat_free = None
            elif nom_profil in self._profils_en_cours_free:
                etat_free = "free_en_cours"
            else:
                etat_free = "actif"
            item.setData(DELEGATE_ROLE_ETAT_FREE, etat_free)
            # PATCH (demande utilisateur explicite : "je veux que on
            # rajoute certains truc : le signe de proxy, le pays, et un
            # badge youtube") -- trois rôles custom supplémentaires, lus
            # depuis config_profil (déjà chargé juste au-dessus pour le
            # routage type_instance -- aucun accès disque supplémentaire
            # ici). DELEGATE_ROLE_PROXY_ACTIF/DELEGATE_ROLE_PAYS pilotent
            # l'icône proxy + drapeau/code pays, DELEGATE_ROLE_YOUTUBE le
            # badge togglable (cf. ProfilsGridItemDelegate.paint).
            item.setData(DELEGATE_ROLE_PROXY_ACTIF, config_profil["proxy"] is not None)
            item.setData(DELEGATE_ROLE_PAYS, config_profil["pays"])
            item.setData(DELEGATE_ROLE_YOUTUBE, config_profil["youtube"])
            # PATCH (retour utilisateur explicite : "juse en bas de la
            # ligne de drapeau on met ladresse proxy, ladress ip") --
            # DELEGATE_ROLE_IP (ip publique détectée au dernier test
            # réussi, cf. definir_pays_config_profil) et DELEGATE_ROLE_PROXY
            # (dict proxy configuré tel quel -- {"host","port",...}, cf.
            # obtenir_config_profil -- paint() en extrait juste host:port,
            # pas besoin d'un rôle séparé par sous-champ).
            item.setData(DELEGATE_ROLE_IP, config_profil["ip"])
            item.setData(DELEGATE_ROLE_PROXY, config_profil["proxy"])
            # PATCH (retour utilisateur explicite : "enlève le badge
            # youtube, tu le mets sur une autre ligne en bas ... tu vas
            # mettre 3 badges : youtube, tiktok, et un symbole de ia") --
            # DELEGATE_ROLE_TIKTOK/DELEGATE_ROLE_IA, même principe que
            # DELEGATE_ROLE_YOUTUBE ci-dessus (lus depuis le MÊME
            # config_profil déjà chargé, aucun accès disque
            # supplémentaire).
            item.setData(DELEGATE_ROLE_TIKTOK, config_profil["tiktok"])
            item.setData(DELEGATE_ROLE_IA, config_profil["ia"])
            # PATCH (demande utilisateur explicite : "je veux que on peu
            # mettre un statut de favoris pour un profils") --
            # DELEGATE_ROLE_FAVORI, même principe que TIKTOK/IA ci-dessus
            # (lu depuis le MÊME config_profil déjà chargé).
            item.setData(DELEGATE_ROLE_FAVORI, config_profil["favori"])
            # PATCH (demande utilisateur explicite : "tu vas rajouter le
            # badge Test") -- DELEGATE_ROLE_TEST, même principe que
            # TIKTOK/IA/FAVORI ci-dessus (lu depuis le MÊME config_profil
            # déjà chargé).
            item.setData(DELEGATE_ROLE_TEST, config_profil["test"])
            # PATCH (demande utilisateur explicite : toggle "bloquer
            # médias", 3e bouton de la ligne du bas) -- même principe que
            # TIKTOK/IA/FAVORI/TEST ci-dessus (lu depuis le MÊME
            # config_profil déjà chargé, aucun accès disque
            # supplémentaire).
            item.setData(DELEGATE_ROLE_BLOQUER_MEDIA, config_profil["bloquer_media"])
            # PATCH (demande utilisateur : sélection rapide par cases à
            # cocher) -- ItemIsUserCheckable ajoute une vraie case à
            # cocher cliquable au début de la ligne, indépendante du
            # surlignage de sélection simple (itemClicked, inchangé) qui
            # pilote l'aperçu à droite.
            item.setFlags(item.flags() | Qt.ItemIsUserCheckable)
            item.setCheckState(Qt.Checked if nom_profil in self._profils_coches else Qt.Unchecked)
            liste.addItem(item)
            if nom_profil == noms_selectionnes_avant.get(type_instance):
                liste.setCurrentItem(item)

            # PATCH (demande utilisateur explicite : "je veux que on peu
            # mettre un statut de favoris pour un profils, donc dans les
            # card des profils tu vas mettre un onglet : favoris") -- un
            # profil marqué favori est EN PLUS dupliqué (2e QListWidgetItem,
            # même nom/UserRole/rôles delegate) dans l'onglet "favoris"
            # (self._onglets_profils["favoris"], TOUS types confondus --
            # cf. demande explicite : "seulement les profils marqués
            # favoris, tous types confondus"), sans jamais remplacer sa
            # présence dans son onglet natif (Chrome/Camoufox) construite
            # juste au-dessus : c'est bien une DUPLICATION visuelle, pas
            # un déplacement -- le même profil reste sélectionnable/
            # cochable indépendamment dans les deux onglets à la fois.
            # Reconstruit ici un item SÉPARÉ (pas le même objet Python
            # réutilisé dans deux QListWidget -- Qt ne le permettrait pas)
            # avec exactement les mêmes données, pour que le delegate le
            # peigne à l'identique dans l'onglet Favoris.
            if config_profil["favori"]:
                infos_onglet_favoris = self._onglets_profils.get("favoris")
                if infos_onglet_favoris is not None:
                    liste_favoris = infos_onglet_favoris["liste"]
                    item_favori = QListWidgetItem(nom_profil)
                    item_favori.setData(Qt.UserRole, nom_profil)
                    item_favori.setData(DELEGATE_ROLE_ACTIF, actif)
                    item_favori.setData(DELEGATE_ROLE_DUREE, item.data(DELEGATE_ROLE_DUREE))
                    item_favori.setData(DELEGATE_ROLE_ETAT_BOUTON, etat_bouton)
                    item_favori.setData(DELEGATE_ROLE_ETAT_FREE, etat_free)
                    item_favori.setData(DELEGATE_ROLE_PROXY_ACTIF, config_profil["proxy"] is not None)
                    item_favori.setData(DELEGATE_ROLE_PAYS, config_profil["pays"])
                    item_favori.setData(DELEGATE_ROLE_YOUTUBE, config_profil["youtube"])
                    item_favori.setData(DELEGATE_ROLE_IP, config_profil["ip"])
                    item_favori.setData(DELEGATE_ROLE_PROXY, config_profil["proxy"])
                    item_favori.setData(DELEGATE_ROLE_TIKTOK, config_profil["tiktok"])
                    item_favori.setData(DELEGATE_ROLE_IA, config_profil["ia"])
                    item_favori.setData(DELEGATE_ROLE_FAVORI, True)
                    item_favori.setData(DELEGATE_ROLE_TEST, config_profil["test"])
                    item_favori.setData(DELEGATE_ROLE_BLOQUER_MEDIA, config_profil["bloquer_media"])
                    item_favori.setFlags(item_favori.flags() | Qt.ItemIsUserCheckable)
                    item_favori.setCheckState(Qt.Checked if nom_profil in self._profils_coches else Qt.Unchecked)
                    liste_favoris.addItem(item_favori)
                    if nom_profil == noms_selectionnes_avant.get("favoris"):
                        liste_favoris.setCurrentItem(item_favori)

        for infos_onglet in self._onglets_profils.values():
            infos_onglet["liste"].blockSignals(False)

        # PATCH (suite positions_scroll_avant ci-dessus) -- restaure la
        # position de scroll mémorisée AVANT le clear/repeuplement de
        # chaque liste. setValue() seul serait sans effet ici : au moment
        # où le clear() a eu lieu, le layout de la grille n'était pas
        # encore recalculé pour le nouveau contenu, donc le maximum()
        # de la scrollbar pouvait encore être celui (obsolète) d'avant le
        # clear -- on force explicitement un recalcul du layout
        # (QListWidget.doItemsLayout()) avant de réappliquer la valeur,
        # pour que le clamp interne de
        # Qt (setValue borne toujours à [0, maximum()]) se fasse contre
        # le VRAI maximum, celui d'après reconstruction.
        for type_instance, infos_onglet in self._onglets_profils.items():
            liste_a_restaurer = infos_onglet["liste"]
            valeur_avant = positions_scroll_avant.get(type_instance)
            if valeur_avant:
                liste_a_restaurer.doItemsLayout()
                liste_a_restaurer.verticalScrollBar().setValue(valeur_avant)

        self._rafraichir_bouton_lancer_profils_coches()
        self._rafraichir_cartes_stats()
        self._rafraichir_compteurs_onglets_profils()

    def _rafraichir_compteurs_onglets_profils(self):
        """PATCH (retour utilisateur explicite : "je veux aussi que tu
        affiche le nombre de profils par onglet, juste a cote du nom de
        l'onglet, chrome (...)") -- ajoute "(N)" après le libellé de
        chaque onglet (self._tabs_profils), N étant le nombre de profils
        actuellement listés dans SA QListWidget (count() -- reflète donc
        aussi bien les profils de l'onglet Chrome/Camoufox natif que les
        profils dupliqués dans l'onglet Favoris, cf. _rafraichir_liste_profils
        qui les y ajoute réellement comme items séparés).
        Appelée à la fin de _rafraichir_liste_profils (seule méthode qui
        change le CONTENU des listes -- ajout/suppression/renommage de
        profil, changement de favori/type, démarrage/arrêt d'instance),
        donc toujours à jour sans travail supplémentaire ailleurs."""
        for index_onglet, type_instance in self._type_instance_par_index_onglet.items():
            infos_onglet = self._onglets_profils.get(type_instance)
            libelle_base = self._libelle_base_par_index_onglet.get(index_onglet)
            if infos_onglet is None or libelle_base is None:
                continue
            nombre_profils = infos_onglet["liste"].count()
            self._tabs_profils.setTabText(index_onglet, f"{libelle_base} ({nombre_profils})")

    def _sur_case_profil_changee(self, item: QListWidgetItem):
        """Bascule de la case à cocher d'UN item (utilisateur uniquement --
        cf. blockSignals dans _rafraichir_liste_profils qui évite que ce
        handler tourne pour les bascules programmatiques de peuplement).
        Tient self._profils_coches à jour et rafraîchit l'état du bouton
        de lancement en lot (activé seulement si au moins un profil est
        coché)."""
        nom_profil = item.data(Qt.UserRole)
        if nom_profil is None:
            return
        if item.checkState() == Qt.Checked:
            self._profils_coches.add(nom_profil)
        else:
            self._profils_coches.discard(nom_profil)
        self._rafraichir_bouton_lancer_profils_coches()

    def _profils_coches_pour_type(self, type_instance: str) -> set[str]:
        """PATCH (onglets Chrome/Camoufox) -- self._profils_coches (cf.
        __init__) reste un UNIQUE set global de noms de profils, tous
        types confondus (cf. commentaire dans
        _construire_bloc_onglet_profils) : ce helper filtre ce set pour
        ne retourner que les noms dont le profil est bien du type demandé
        (cf. obtenir_config_profil), afin qu'un bouton de lot d'un onglet
        n'agisse jamais sur les profils cochés de l'AUTRE onglet. Filtre
        aussi silencieusement tout nom qui ne serait plus dans
        self._profils (profil supprimé entre-temps) -- même garde que
        celle déjà faite site par site avant ce patch.

        PATCH (demande utilisateur explicite : onglet Favoris, "tous
        types confondus") -- "favoris" N'EST PAS une vraie valeur de
        obtenir_config_profil(...)["type_instance"] (toujours "chrome"
        ou "camoufox", cf. TYPES_INSTANCE_VALIDES) : c'est un onglet de
        FILTRAGE transverse, pas un 3e type d'instance. Cas spécial ici
        -- filtre alors sur config["favori"] (peu importe le type réel)
        plutôt que sur config["type_instance"], pour que les boutons de
        lot de l'onglet Favoris (Tout sélectionner/Lancer/Arrêter/Free
        les profils cochés) agissent bien sur les profils favoris cochés,
        Chrome ET Camoufox confondus -- exactement le même ensemble de
        profils que celui affiché dans cet onglet (cf.
        _rafraichir_liste_profils, routage supplémentaire vers
        "favoris")."""
        if type_instance == "favoris":
            return {
                nom for nom in self._profils_coches
                if nom in self._profils and obtenir_config_profil(nom)["favori"]
            }
        return {
            nom for nom in self._profils_coches
            if nom in self._profils and obtenir_config_profil(nom)["type_instance"] == type_instance
        }

    def _appliquer_coche_tous_profils(self, type_instance: str, coche: bool):
        """Boutons raccourcis "Tout sélectionner" / "Tout désélectionner"
        (demande utilisateur explicite) -- coche/décoche en une fois
        toutes les cases actuellement affichées DANS L'ONGLET
        `type_instance`, sans avoir à cliquer profil par profil. N'affecte
        jamais les cases de l'autre onglet (cf. patch "jamais les deux en
        meme temps, juste longlet actif")."""
        liste = self._onglets_profils[type_instance]["liste"]
        liste.blockSignals(True)
        for i in range(liste.count()):
            item = liste.item(i)
            item.setCheckState(Qt.Checked if coche else Qt.Unchecked)
            nom_profil = item.data(Qt.UserRole)
            if nom_profil is None:
                continue
            if coche:
                self._profils_coches.add(nom_profil)
            else:
                self._profils_coches.discard(nom_profil)
        liste.blockSignals(False)
        self._rafraichir_bouton_lancer_profils_coches(type_instance)

    def _indices_ligne_pour_item(self, liste: QListWidget, item: QListWidgetItem) -> list:
        """Liste des indices des cartes situées sur la MÊME LIGNE VISUELLE
        que `item` -- réutilisée par _ligne_est_entierement_cochee et
        _appliquer_coche_ligne (même calcul, jamais dupliqué).

        CORRECTIF (retour utilisateur : \"ça reconnaît mal les éléments de
        la liste... surtout si je redimensionne\") -- l'ancienne version
        DEVINAIT la ligne par le calcul (indice // nb_colonnes) à partir de
        delegate.nb_colonnes, une valeur écrite par
        _recalculer_grille_profils. Or Qt applique le nouvel agencement
        (wrapping) de façon différée : entre un redimensionnement et le
        recalcul, nb_colonnes est périmé et le calcul visait la mauvaise
        plage (reproduit : nb périmé=4 -> [4..7] alors que la ligne réelle
        affichée était [0..5]). Le nombre de colonnes n'a plus besoin
        d'être connu du tout : on lit la POSITION RÉELLE de chaque carte
        (visualItemRect, la même géométrie que celle que Qt peint à
        l'écran, donc toujours cohérente avec ce que voit l'utilisateur)
        et on retient celles qui partagent la même coordonnée verticale
        que `item`. Insensible au redimensionnement, au nombre de colonnes,
        au défilement (le décalage de scroll s'applique pareillement à
        toutes les cartes, la comparaison reste juste) et à toute future
        évolution du calcul de grille.

        top() de deux cartes d'une même ligne est identique (grille à
        cellules uniformes, cf. setUniformItemSizes) ; une tolérance de
        quelques pixels absorbe tout arrondi éventuel sans jamais fusionner
        deux lignes distinctes (elles sont séparées d'au moins la hauteur
        d'une carte, bien supérieure à la tolérance)."""
        if item is None or liste.row(item) < 0:
            return []
        TOLERANCE_PX = 3
        top_ref = liste.visualItemRect(item).top()
        indices = []
        for i in range(liste.count()):
            candidat = liste.item(i)
            if candidat is None or candidat.isHidden():
                continue
            if abs(liste.visualItemRect(candidat).top() - top_ref) <= TOLERANCE_PX:
                indices.append(i)
        return indices

    def _ligne_est_entierement_cochee(self, liste: QListWidget, item: QListWidgetItem) -> bool:
        """PATCH (demande utilisateur explicite : appui long qui bascule
        -- "on clic aussi longuement et sa deselctionne" quand la ligne
        est déjà sélectionnée) -- True si TOUS les profils de la ligne de
        `item` sont actuellement cochés (une ligne vide, cas limite d'une
        liste qui vient d'être vidée entre le press et le timeout, compte
        comme "non entièrement cochée" -- any(...) sur une plage vide via
        all() renverrait True à tort sans cette garde explicite)."""
        indices_ligne = self._indices_ligne_pour_item(liste, item)
        if len(indices_ligne) == 0:
            return False
        return all(liste.item(i).checkState() == Qt.Checked for i in indices_ligne)

    def _sur_timeout_appui_long_ligne(self):
        """Callback de self._minuteur_appui_long_ligne (cf. son
        connect() dans __init__) -- se déclenche SEULEMENT si le bouton
        gauche est resté pressé sur la même carte pendant au moins
        SEUIL_APPUI_LONG_LIGNE_MS sans bouger (cf. eventFilter, qui stop()
        ce minuteur au moindre relâche anticipé ou déplacement hors de la
        carte de départ) -- un clic court n'atteint donc jamais ce
        callback. Bascule (toggle) : si la ligne est déjà entièrement
        cochée, cet appui long la DÉCOCHE ; sinon il la coche -- reproduit
        exactement "un clic long ... sélectionne toute la ligne, si non
        c'est le comportement standard ... on clic aussi longuement et ça
        désélectionne" (demande utilisateur explicite)."""
        nom = self._nom_presse_pour_appui_long
        liste = self._liste_presse_pour_appui_long
        if nom is None or liste is None:
            return
        # Retrouve l'item VIVANT portant ce nom dans la liste actuelle :
        # si la liste a été reconstruite pendant l'appui (liste.clear()),
        # l'item d'origine n'existe plus, mais un item de même nom oui.
        item = None
        for i in range(liste.count()):
            candidat = liste.item(i)
            if candidat is not None and candidat.data(Qt.UserRole) == nom:
                item = candidat
                break
        if item is None:
            return  # profil supprimé entre-temps : rien à faire
        self._appui_long_ligne_declenche = True
        deja_cochee = self._ligne_est_entierement_cochee(liste, item)
        self._appliquer_coche_ligne(liste, item, coche=not deja_cochee)

    def _appliquer_coche_ligne(self, liste: QListWidget, item_de_la_ligne: QListWidgetItem, coche: bool):
        """PATCH (demande utilisateur explicite : appui long de 0.4s sur
        une carte, cf. _sur_timeout_appui_long_ligne ci-dessus) -- coche/
        décoche en une fois tous les profils de la MÊME LIGNE visuelle de
        la grille que `item_de_la_ligne` (n'importe quelle carte de cette
        ligne, pas forcément la première -- cf. _indices_ligne_pour_item)
        -- jamais les autres lignes de cet onglet. Même patron que
        _appliquer_coche_tous_profils juste au-dessus (blockSignals
        pendant la boucle, _profils_coches tenu à jour manuellement, un
        seul rafraîchissement des boutons de lot à la fin), restreint à
        une plage d'indices au lieu de la liste entière."""
        indices_ligne = self._indices_ligne_pour_item(liste, item_de_la_ligne)
        if len(indices_ligne) == 0:
            return
        liste.blockSignals(True)
        for i in indices_ligne:
            item = liste.item(i)
            item.setCheckState(Qt.Checked if coche else Qt.Unchecked)
            nom_profil = item.data(Qt.UserRole)
            if nom_profil is None:
                continue
            if coche:
                self._profils_coches.add(nom_profil)
            else:
                self._profils_coches.discard(nom_profil)
        liste.blockSignals(False)
        type_instance = self._type_instance_pour_liste(liste)
        self._rafraichir_bouton_lancer_profils_coches(type_instance)

    def _type_instance_pour_liste(self, liste: QListWidget) -> Optional[str]:
        """Retrouve la clé type_instance ("chrome"/"camoufox"/"favoris")
        associée à `liste` dans self._onglets_profils -- petit utilitaire
        factorisé pour _appliquer_coche_ligne ci-dessus (qui reçoit la
        QListWidget concernée directement depuis l'eventFilter, pas le
        type_instance qui l'a créée)."""
        for type_instance, infos_onglet in self._onglets_profils.items():
            if infos_onglet["liste"] is liste:
                return type_instance
        return None

    def _selectionner_profils_actifs(self, type_instance: str):
        """Bouton raccourci "Sélectionner les actifs" (demande utilisateur
        explicite) -- coche tous les profils DE L'ONGLET `type_instance`
        actuellement actifs (cf. self._instance_id_par_profil, même test
        que le badge "● actif" de _rafraichir_liste_profils) et décoche
        tous les autres profils DE CE MÊME ONGLET, en un seul clic.
        Remplaçant, pas additif, pour cet onglet : reflète l'état réel des
        instances de ce type au moment du clic, indépendamment de ce qui
        était coché avant. N'affecte jamais les cases de l'autre onglet."""
        liste = self._onglets_profils[type_instance]["liste"]
        liste.blockSignals(True)
        for i in range(liste.count()):
            item = liste.item(i)
            nom_profil = item.data(Qt.UserRole)
            if nom_profil is None:
                continue
            actif = nom_profil in self._instance_id_par_profil
            item.setCheckState(Qt.Checked if actif else Qt.Unchecked)
            if actif:
                self._profils_coches.add(nom_profil)
            else:
                self._profils_coches.discard(nom_profil)
        liste.blockSignals(False)
        self._rafraichir_bouton_lancer_profils_coches(type_instance)

    def _rafraichir_bouton_lancer_profils_coches(self, type_instance: Optional[str] = None):
        """PATCH (onglets Chrome/Camoufox) -- `type_instance` : None (par
        défaut) rafraîchit les boutons des DEUX onglets (cf.
        _rafraichir_liste_profils, qui doit remettre les deux jeux de
        boutons d'aplomb après une reconstruction complète) ; sinon ne
        rafraîchit que les boutons de CET onglet (cf. les callbacks
        connectés directement à un onglet précis, plus bas -- inutile de
        recalculer l'autre onglet, dont l'ensemble des cochés n'a pas
        changé)."""
        if type_instance is None:
            for type_connu in self._onglets_profils:
                self._rafraichir_bouton_lancer_profils_coches(type_connu)
            return

        infos_onglet = self._onglets_profils[type_instance]
        coches_de_cet_onglet = self._profils_coches_pour_type(type_instance)

        # PATCH (retour utilisateur : "quand je selectionne des profils
        # qui sont tous deja encours, le bouton de lancement affiche
        # encore demarrer les profils") -- ne compte/n'active le bouton
        # "Lancer" que sur les cochés (de cet onglet) qui ne sont PAS
        # ENCORE actifs (symétrique de la logique déjà en place pour
        # "Arrêter" juste en dessous, qui ne compte que les cochés
        # ACTIFS). Avant ce correctif, nb_coches comptait TOUS les cochés
        # sans regarder leur état : cocher uniquement des profils déjà
        # actifs laissait "Lancer les profils cochés (N)" actif et
        # cliquable, alors qu'un clic dessus aurait en réalité FERMÉ PUIS
        # RELANCÉ chacun d'eux (cf. _lancer_instance_pour_profil, qui
        # relance un profil déjà actif plutôt que de l'ignorer) --
        # trompeur et potentiellement destructeur pour des instances déjà
        # en cours d'utilisation.
        nb_coches_inactifs = sum(
            1 for nom in coches_de_cet_onglet if nom not in self._instance_id_par_profil
        )
        infos_onglet["bouton_lancer"].setEnabled(nb_coches_inactifs > 0)
        if nb_coches_inactifs > 0:
            infos_onglet["bouton_lancer"].setText(f"Lancer les profils cochés ({nb_coches_inactifs})")
        else:
            infos_onglet["bouton_lancer"].setText("Lancer les profils cochés")
        # PATCH (bouton "Arrêter les profils cochés") : n'active le bouton
        # que s'il y a AU MOINS un profil coché (de cet onglet) qui est
        # actuellement actif (cf. self._instance_id_par_profil) -- sinon
        # "Arrêter" resterait cliquable sans rien avoir à faire, ce qui
        # prêterait à confusion. Le compteur affiché ne compte que les
        # cochés ACTIFS, pas tous les cochés (contrairement à "Lancer"
        # ci-dessus), pour donner un aperçu correct de ce que le clic va
        # réellement arrêter.
        nb_coches_actifs = sum(
            1 for nom in coches_de_cet_onglet if nom in self._instance_id_par_profil
        )
        infos_onglet["bouton_arreter"].setEnabled(nb_coches_actifs > 0)
        if nb_coches_actifs > 0:
            infos_onglet["bouton_arreter"].setText(f"Arrêter les profils cochés ({nb_coches_actifs})")
        else:
            infos_onglet["bouton_arreter"].setText("Arrêter les profils cochés")

        # PATCH (bouton "Free" en lot, demande utilisateur explicite) --
        # même critère que "Arrêter" ci-dessus : n'active le bouton que
        # s'il y a au moins un profil coché (de cet onglet) ACTUELLEMENT
        # ACTIF (Free/force_unlink n'a de sens que s'il existe une
        # instance liée à libérer, cf. _on_clic_free_profils_coches).
        # Réutilise directement nb_coches_actifs déjà calculé juste
        # au-dessus -- même population exacte, pas besoin de la
        # recalculer.
        infos_onglet["bouton_free"].setEnabled(nb_coches_actifs > 0)
        if nb_coches_actifs > 0:
            infos_onglet["bouton_free"].setText(f"Free ({nb_coches_actifs})")
        else:
            infos_onglet["bouton_free"].setText("Free")

    def _on_clic_lancer_profils_coches(self, type_instance: str):
        """Lance d'un coup tous les profils DE L'ONGLET `type_instance`
        cochés et PAS ENCORE actifs (demande utilisateur explicite : "le
        bouon de demarage de task vas le faire sur tout ceux qui on ete
        cocher") -- réutilise _lancer_instance_pour_profil pour chacun.
        Ne touche jamais aux profils cochés de l'AUTRE onglet (cf. patch
        onglets Chrome/Camoufox, boutons dupliqués par onglet).

        PATCH (retour utilisateur : "quand je selectionne des profils qui
        sont tous deja encours, le bouton de lancement affiche encore
        demarer les profils") -- ne touche plus les profils cochés déjà
        actifs (cf. self._instance_id_par_profil) : avant ce correctif,
        _lancer_instance_pour_profil sur un profil déjà actif le
        FERMAIT PUIS RELANÇAIT (comportement voulu pour un lancement
        individuel volontaire, cf. sa docstring), ce qui ici aurait
        silencieusement redémarré des instances déjà en cours d'usage à
        chaque clic sur ce bouton en lot -- surprenant et potentiellement
        destructeur. Symétrique de _on_clic_arreter_profils_coches, qui
        ignore déjà les cochés non actifs. Ne touche PAS aux profils non
        cochés, actifs ou non."""
        coches_de_cet_onglet = self._profils_coches_pour_type(type_instance)
        if not coches_de_cet_onglet:
            return
        for nom_profil in sorted(coches_de_cet_onglet, key=str.lower):
            if nom_profil in self._instance_id_par_profil:
                continue  # déjà actif -- rien à lancer, cf. docstring ci-dessus
            self._lancer_instance_pour_profil(nom_profil)

    def _on_clic_arreter_profils_coches(self, type_instance: str):
        """Symétrique de _on_clic_lancer_profils_coches (cf. patch
        "bouton Arrêter les profils cochés" -- retour utilisateur : "je ne
        vois pas de bouton pour arreter un profil lancer"). Ne touche que
        les profils DE L'ONGLET `type_instance` cochés qui sont
        ACTUELLEMENT ACTIFS (cf. self._instance_id_par_profil) -- un
        profil coché mais déjà arrêté est silencieusement ignoré, comme
        pour le lancement. Ne touche jamais aux profils cochés de l'AUTRE
        onglet.

        PATCH (retour utilisateur : "il y a un probleme avec arreter les
        profils cocher, sa ne arrete pas tout directement, sa arrete un a
        un, je suis obliger de cliquer plusieurs fois de suite") -- lance
        maintenant tous les _arreter_instance_pour_profil EN PARALLÈLE
        (un thread dédié par instance, déjà le cas cf. sa docstring)
        plutôt que de les enchaîner un par un via callback_apres. Le choix
        initial (séquentiel, pour ménager le serveur central) allait à
        l'encontre de l'attente réelle de l'utilisateur -- un arrêt en
        lot doit arrêter le lot, pas un profil à la fois avec un délai de
        plusieurs secondes entre chacun. Chaque _arreter_instance_pour_profil
        gère déjà son propre état "en cours d'arrêt" (cf.
        self._profils_en_cours_arret) indépendamment des autres, donc rien
        d'autre à synchroniser ici."""
        coches_de_cet_onglet = self._profils_coches_pour_type(type_instance)
        noms_a_arreter = sorted(
            (nom for nom in coches_de_cet_onglet if nom in self._instance_id_par_profil),
            key=str.lower,
        )
        if not noms_a_arreter:
            return

        for nom_profil in noms_a_arreter:
            self._arreter_instance_pour_profil(nom_profil)

    def _on_clic_free_profils_coches(self, type_instance: str):
        """PATCH (demande utilisateur explicite : "je veux que tu mets
        aussi le bouton de free pour tout ce qui on ete selctionner")
        -- Free en lot, symétrique de _on_clic_arreter_profils_coches :
        ne touche que les profils DE L'ONGLET `type_instance` cochés qui
        ont ACTUELLEMENT une instance active (cf.
        self._instance_id_par_profil) -- Free (force_unlink) n'a de sens
        que s'il y a une instance liée à libérer ; un profil coché mais
        déjà sans instance est silencieusement ignoré, exactement comme
        pour "Arrêter". Ne touche jamais aux profils cochés de l'AUTRE
        onglet.

        Réutilise _on_clic_free_pilote_pour_profil pour chaque profil
        concerné -- même action que le petit bouton Free peint sur
        chaque carte individuelle (cf. ProfilsGridItemDelegate.
        rect_bouton_free), donc même garde anti-double-clic
        (self._profils_en_cours_free) et même feedback déjà en place,
        sans rien dupliquer ici."""
        coches_de_cet_onglet = self._profils_coches_pour_type(type_instance)
        noms_a_liberer = sorted(
            (nom for nom in coches_de_cet_onglet if nom in self._instance_id_par_profil),
            key=str.lower,
        )
        if not noms_a_liberer:
            return

        for nom_profil in noms_a_liberer:
            self._on_clic_free_pilote_pour_profil(nom_profil)


    def _sur_frame_recue(self, instance_id: str, image_b64: str, seq: int):
        if instance_id != self._instance_selectionnee:
            return
        try:
            donnees = base64.b64decode(image_b64)
        except Exception as e:
            log_dashboard_ui.warning(f"Frame illisible reçue pour {instance_id} (seq={seq}) : {e!r}")
            return
        image = QImage()
        if not image.loadFromData(QByteArray(donnees)) or image.isNull():
            log_dashboard_ui.warning(f"Frame invalide/non décodable pour {instance_id} (seq={seq})")
            return
        self._derniere_taille_frame = (image.width(), image.height())
        self._derniere_image = image

        capture_ponctuelle = self._rafraichissement_ponctuel_en_attente
        if capture_ponctuelle:
            self._rafraichissement_ponctuel_en_attente = False
            self.rafraichir_button.setEnabled(True)
            self._rafraichir_texte_bouton_rafraichir(en_attente=False)
            if not self._rafraichissement_auto_actif and self._instance_selectionnee is not None and self.client_reseau is not None:
                # Capture ponctuelle simulée (pas de commande "capture
                # unique" côté protocole, cf. InstanceApercuScreen) : on
                # désactive le streaming aussitôt cette frame reçue.
                self.client_reseau.envoyer_commande({
                    "type": "command", "instance_id": self._instance_selectionnee,
                    "action": "set_streaming", "actif": False,
                })

        self._afficher_apercu(image)

    def _afficher_apercu(self, image: QImage):
        # Échelle réelle (1:1), même principe que InstanceApercuScreen.
        # _afficher_apercu_defaut / FenetreRenduTaskReseau.
        # _appliquer_pixmap_a_l_echelle.
        pixmap = QPixmap.fromImage(image)
        self.apercu_label.setPixmap(pixmap)
        self.apercu_label.resize(pixmap.size())

    def _sur_redimensionnement_apercu(self):
        # Échelle réelle (1:1, cf. _afficher_apercu) : plus rien à
        # recalculer au redimensionnement du panneau, apercu_scroll
        # (QScrollArea) gère seul l'apparition des barres de défilement.
        # Méthode conservée (vidée) pour ne pas casser la connexion
        # existante sur apercu_label.redimensionne.
        pass

    def _sur_erreur_recue(self, message: str):
        log_dashboard_ui.warning(f"Erreur reçue du serveur : {message}")
        # PATCH (bug rapporté : "le bouton de demande d'obtention de
        # propriétés a été bloqué") -- un message serveur {"type": "error"}
        # (ex: "instance 'X' introuvable", envoyé quand une commande arrive
        # AVANT que l'instance ne soit enregistrée, cf. srv_gerer_command)
        # N'EMPORTE JAMAIS de requete_id (cf. commentaire dans
        # srv_gerer_command : "ce message d'erreur n'emporte PAS
        # requete_id") -- il part donc sur erreur_recue, PAS sur
        # command_result_recu/_sur_command_result_onglet, qui est la SEULE
        # méthode qui réactivait bouton_rafraichir/onglet_combo. Résultat
        # avant ce patch : un clic (ou un changement d'onglet Propriétés)
        # arrivé trop tôt désactivait le bouton puis n'était plus JAMAIS
        # réactivé, aucun command_result correspondant ne pouvant arriver
        # pour un requete_id que le serveur n'a pas renvoyé.
        # Sans requete_id à faire correspondre, impossible de savoir QUELLE
        # requête en vol cette erreur concerne précisément -- on débloque
        # donc les 3 requêtes Dashboard potentiellement en vol (propriétés/
        # listTabs/switchTab), même geste que leur branche ok=False dans
        # _sur_command_result_onglet. Inoffensif si aucune n'était en vol
        # (les champs sont déjà à None, les boutons déjà activés).
        #
        # PATCH (demande utilisateur explicite : "il faut mettre le
        # message de camoufox1 introuvable en jaune et non en rouge") --
        # une erreur générique serveur SANS requete_id (cf. srv_gerer_command,
        # ex: "instance 'X' introuvable") survient typiquement pendant le
        # démarrage de l'instance, AVANT son enregistrement réseau (cf. le
        # long délai entre Popen et registered côté Camoufox) : ce n'est
        # pas un vrai échec de lecture du fingerprint/des onglets, juste un
        # état transitoire normal -- jaune (avertissement), pas rouge
        # (erreur définitive, réservé aux command_result ok=False émis par
        # _sur_command_result_onglet, qui restent rouges, cf. plus haut).
        if self._requete_id_proprietes is not None:
            self._requete_id_proprietes = None
            if self._requete_id_proprietes_reelles is None:
                self._panneau_proprietes.bouton_rafraichir.setEnabled(True)
            self._panneau_proprietes.definir_message(
                f"Propriétés indisponibles pour l'instant : {message}",
                est_avertissement=True, sous_onglet="fictif",
            )
        if self._requete_id_proprietes_reelles is not None:
            self._requete_id_proprietes_reelles = None
            if self._requete_id_proprietes is None:
                self._panneau_proprietes.bouton_rafraichir.setEnabled(True)
            self._panneau_proprietes.definir_message(
                f"Propriétés indisponibles pour l'instant : {message}",
                est_avertissement=True, sous_onglet="reel",
            )
        if self._requete_id_liste_onglets is not None:
            self._requete_id_liste_onglets = None
            self.label_statut_onglets.definir_texte(f"Pas encore prêt : {message}")
            self.label_statut_onglets.setStyleSheet(f"color: {Mocha.yellow}; font-size: 11px;")
        if self._requete_id_switch_onglet is not None:
            self._requete_id_switch_onglet = None
            log_dashboard_ui.warning(f"switchTab échoué : {message}")
            self.label_statut_onglets.definir_texte(f"Pas encore prêt : {message}")
            self.label_statut_onglets.setStyleSheet(f"color: {Mocha.yellow}; font-size: 11px;")

    def _sur_instance_deliee(self, instance_id: str, raison: str):
        """Le serveur nous a délié automatiquement de cette instance (cf.
        gerer_link, serveur.py) -- un autre pilote OU un autre Dashboard
        vient de la reprendre (reprise automatique, décision utilisateur :
        le dernier demandeur a toujours la main, quel que soit son rôle).
        On ne contrôle plus rien pour cette instance : remise à plat de
        l'aperçu et des contrôles, même logique que le cas "instance
        disparue" plus haut. La liste elle-même (libellé "● / ○ (liée)")
        se met à jour séparément via le prochain instances_list, déjà
        diffusé par le serveur à ce moment-là (diffuser_liste_instances_a_tous,
        appelé juste après)."""
        log_dashboard_ui.info(f"Instance '{instance_id}' déliée par le serveur -- raison : {raison!r}")
        if self._instance_selectionnee != instance_id:
            return
        self._instance_selectionnee = None
        self._derniere_image = None
        self._rafraichissement_ponctuel_en_attente = False
        self.apercu_label.setPixmap(QPixmap())
        self.apercu_label.setText(f"'{instance_id}' reprise par un autre écran ({raison})")
        self._rafraichir_bouton_lancer_arreter()
        self._rafraichir_disponibilite_onglets()
        self._reinitialiser_panneau_proprietes()

    def _sur_liaison_echouee(self, instance_id: str, message: str):
        """Même correctif qu'InstanceApercuScreen._sur_liaison_echouee (cf.
        sa docstring) : sans ça, un link refusé par le serveur laissait le
        Dashboard croire à tort qu'il contrôlait l'instance."""
        if instance_id != self._instance_selectionnee:
            return
        log_dashboard_ui.warning(
            f"Liaison sur '{instance_id}' refusée par le serveur ({message}) -- annulation de l'état local"
        )
        self._instance_selectionnee = None
        self._derniere_image = None
        self._rafraichissement_ponctuel_en_attente = False
        self.apercu_label.setPixmap(QPixmap())
        self.apercu_label.setText(f"Liaison refusée : {message}")
        self._rafraichir_bouton_lancer_arreter()
        self._rafraichir_disponibilite_onglets()
        self._reinitialiser_panneau_proprietes()

    # --- UI : événements sortants ---

    def _sur_selection_instance(self, item: QListWidgetItem):
        nom_profil = item.data(Qt.UserRole)
        if nom_profil == self._profil_selectionne:
            return
        self._profil_selectionne = nom_profil
        # None si le profil sélectionné n'a actuellement aucune instance
        # active (cf. self._instance_id_par_profil, mis à jour par
        # _sur_liste_instances_recue) -- dans ce cas on ne tente aucun
        # lien réseau, juste un aperçu vide en attendant un lancement.
        instance_id = self._instance_id_par_profil.get(nom_profil)
        self._instance_selectionnee = instance_id
        self._derniere_image = None
        self._rafraichissement_ponctuel_en_attente = False
        self.apercu_label.setPixmap(QPixmap())
        self._rafraichir_bouton_lancer_arreter()
        self._reinitialiser_panneau_proprietes()
        if instance_id is None or self.client_reseau is None:
            self.apercu_label.setText(
                "Profil inactif -- cliquez sur \"Lancer le profil sélectionné\"." if nom_profil else ""
            )
            self._rafraichir_disponibilite_onglets()
            return
        self.apercu_label.setText(f"En attente du flux de {instance_id}…")
        self.client_reseau.envoyer_commande({
            "type": "link", "pilote_id": self.client_reseau.id_client, "instance_id": instance_id,
        })
        # Jamais de flux imposé ici : applique l'état de rafraîchissement
        # auto déjà choisi par l'utilisateur pour CE panneau (actif ou
        # non) -- même logique qu'InstanceApercuScreen._on_instance_changed.
        self._appliquer_etat_streaming(instance_id)
        self._rafraichir_disponibilite_onglets()
        self._demander_liste_onglets_navigateur()
        # PATCH (onglet Propriétés) -- si ce panneau est déjà ouvert au
        # moment où l'utilisateur change de profil sélectionné, on
        # redemande directement le fingerprint de la NOUVELLE instance
        # plutôt que de laisser affichées les propriétés de l'ancienne
        # (ou de forcer un aller-retour manuel sur le switch pour
        # rafraîchir). Si l'onglet Aperçu est actif, rien à faire ici :
        # _sur_page_panneau_droit_changee s'en chargera à la prochaine
        # ouverture de l'onglet Propriétés.
        if self._pages_panneau_droit.currentWidget() is self._panneau_proprietes:
            self._demander_proprietes_fingerprint()

    def _reinitialiser_panneau_proprietes(self):
        """Annule toute requête "get_fingerprint"/"get_fingerprint_reel" en
        vol et remet le panneau Propriétés (les 2 sous-onglets Fictif/Réel)
        à son état neutre -- appelée à chaque fois que
        self._instance_selectionnee change ou se vide (nouvelle sélection,
        liaison perdue/refusée, cf. call sites), pour ne jamais laisser
        affichées les propriétés d'une instance qui n'est plus celle
        sélectionnée. Invalider les 2 requete_id (plutôt que de les
        laisser tels quels) évite qu'une réponse tardive de l'ANCIENNE
        instance ne vienne écraser l'affichage après coup."""
        self._requete_id_proprietes = None
        self._requete_id_proprietes_reelles = None
        self._panneau_proprietes.bouton_rafraichir.setEnabled(True)
        self._panneau_proprietes.definir_message(
            "Sélectionnez une instance Camoufox pour voir ses propriétés.", sous_onglet="fictif",
        )
        self._panneau_proprietes.definir_message(
            "Sélectionnez une instance Camoufox pour voir ses propriétés.", sous_onglet="reel",
        )


    # ------------------------------------------------------------------
    # Rafraîchissement -- mêmes 3 réglages qu'InstanceApercuScreen (bouton
    # ponctuel / case auto+FPS / désactivé), cf. PanneauRenduInstance.
    # ------------------------------------------------------------------
    # ------------------------------------------------------------------
    # Envoi centralisé de commande vers l'instance sélectionnée -- même
    # principe qu'InstanceApercuScreen._envoyer_commande_liee (cf. sa
    # docstring pour le détail), dupliqué ici car DashboardScreen n'hérite
    # pas d'InstanceApercuScreen (bloc rafraîchissement/onglets déjà
    # dupliqué pour la même raison, cf. commentaire plus haut).
    # ------------------------------------------------------------------
    def _envoyer_commande_liee(self, payload_commande: dict):
        if self._instance_selectionnee is None or self.client_reseau is None:
            return
        self.client_reseau.envoyer_commande({
            "type": "link", "pilote_id": self.client_reseau.id_client,
            "instance_id": self._instance_selectionnee,
        })
        self.client_reseau.envoyer_commande(payload_commande)

    def _appliquer_etat_streaming(self, instance_id: str | None = None):
        instance_id = instance_id or self._instance_selectionnee
        if instance_id is None or self.client_reseau is None:
            return
        # Un seul link ici en tête (pas via _envoyer_commande_liee, qui en
        # enverrait un par commande) -- même raison que côté
        # InstanceApercuScreen._appliquer_etat_streaming.
        self.client_reseau.envoyer_commande({
            "type": "link", "pilote_id": self.client_reseau.id_client, "instance_id": instance_id,
        })
        if self._rafraichissement_auto_actif:
            self.client_reseau.envoyer_commande({
                "type": "command", "instance_id": instance_id,
                "action": "set_fps", "fps": max(1, round(self.fps_auto_spin.value())),
            })
            self.client_reseau.envoyer_commande({
                "type": "command", "instance_id": instance_id,
                "action": "set_streaming", "actif": True,
            })
        else:
            self.client_reseau.envoyer_commande({
                "type": "command", "instance_id": instance_id,
                "action": "set_streaming", "actif": False,
            })

    def _on_fps_auto_change(self, valeur: float):
        if self._rafraichissement_auto_actif and self._instance_selectionnee is not None:
            self._appliquer_etat_streaming()
        self._rafraichir_statut_rafraichissement()

    def _on_case_auto_toggled(self, actif: bool):
        self._rafraichissement_auto_actif = actif
        if self._instance_selectionnee is not None:
            self._appliquer_etat_streaming()
        self._rafraichir_statut_rafraichissement()

    def _rafraichir_statut_rafraichissement(self):
        if self._rafraichissement_auto_actif:
            texte = f"Rafraîchissement automatique actif ({self.fps_auto_spin.value():.1f} im/s)."
        else:
            texte = (
                "Rafraîchissement automatique désactivé -- utilisez le bouton "
                "\"Rafraîchir\" pour une image ponctuelle."
            )
        self.label_statut_rafraichissement.definir_texte(texte)

    def _rafraichir_texte_bouton_rafraichir(self, en_attente: bool):
        if en_attente:
            self.rafraichir_button.setText(" Capture en cours…")
        else:
            self.rafraichir_button.setIcon(qta.icon("mdi6.image-refresh-outline", color=Mocha.text))
            self.rafraichir_button.setText(" Rafraîchir")

    def _demander_rafraichissement(self):
        """Bouton "Rafraîchir" : capture PONCTUELLE -- même logique
        qu'InstanceApercuScreen._demander_rafraichissement."""
        if self._instance_selectionnee is None or self.client_reseau is None:
            return
        if self._rafraichissement_auto_actif:
            # Flux déjà actif : rien à activer, juste attendre la
            # prochaine frame qui arrivera de toute façon.
            self._rafraichissement_ponctuel_en_attente = True
            self.rafraichir_button.setEnabled(False)
            self._rafraichir_texte_bouton_rafraichir(en_attente=True)
            return
        self._rafraichissement_ponctuel_en_attente = True
        self.rafraichir_button.setEnabled(False)
        self._rafraichir_texte_bouton_rafraichir(en_attente=True)
        self._envoyer_commande_liee({
            "type": "command", "instance_id": self._instance_selectionnee,
            "action": "set_streaming", "actif": True,
        })

    # ------------------------------------------------------------------
    # Onglet navigateur (listTabs/switchTab) -- MÊME logique que
    # InstanceApercuScreen (cf. ses méthodes homonymes), adaptée à
    # self._instance_selectionnee (équivalent Dashboard de
    # self._instance_liee). Le bloc UI lui-même (combo, bouton, statut)
    # n'a rien de spécifique à dupliquer : il est déjà reçu via
    # self._panneau_rendu (cf. _construire_ui), composé depuis
    # PanneauRenduInstance comme Rafraîchir/Mode/Taux.
    # ------------------------------------------------------------------
    def _rafraichir_disponibilite_onglets(self):
        selectionnee = self._instance_selectionnee is not None
        self.onglet_combo.setEnabled(selectionnee and self.onglet_combo.count() > 0)
        self.rafraichir_onglets_button.setEnabled(selectionnee)
        if not selectionnee:
            self.onglet_combo.blockSignals(True)
            self.onglet_combo.clear()
            self.onglet_combo.blockSignals(False)
            self.label_statut_onglets.definir_texte("Aucune instance liée.")
            self.label_statut_onglets.setStyleSheet(f"color: {Mocha.subtext0}; font-size: 11px;")

    def _demander_liste_onglets_navigateur(self):
        if self._instance_selectionnee is None or self.client_reseau is None:
            return
        requete_id = uuid.uuid4().hex[:12]
        self._requete_id_liste_onglets = requete_id
        self.label_statut_onglets.definir_texte("Récupération des onglets…")
        self.label_statut_onglets.setStyleSheet(f"color: {Mocha.subtext0}; font-size: 11px;")
        self._envoyer_commande_liee({
            "type": "command", "instance_id": self._instance_selectionnee,
            "action": "listTabs", "requete_id": requete_id,
        })

    def _demander_switch_onglet_navigateur(self, tab_id: str):
        if self._instance_selectionnee is None or self.client_reseau is None:
            return
        requete_id = uuid.uuid4().hex[:12]
        self._requete_id_switch_onglet = requete_id
        self._envoyer_commande_liee({
            "type": "command", "instance_id": self._instance_selectionnee,
            "action": "switchTab", "requete_id": requete_id, "tabId": tab_id,
        })

    def _on_onglet_navigateur_change(self, index: int):
        tab_id = self.onglet_combo.currentData()
        if tab_id is None:
            return
        log_dashboard_ui.info(f"_on_onglet_navigateur_change() : tabId={tab_id!r}")
        self._demander_switch_onglet_navigateur(tab_id)

    def _sur_command_result_onglet(self, data: dict):
        requete_id = data.get("requete_id")
        if requete_id == self._requete_id_liste_onglets:
            self._requete_id_liste_onglets = None
            if not data.get("ok", False):
                self.label_statut_onglets.definir_texte(f"Échec : {data.get('error', 'erreur inconnue')}")
                self.label_statut_onglets.setStyleSheet(f"color: {Mocha.red}; font-size: 11px;")
                return
            onglets = data.get("result") or []
            self.onglet_combo.blockSignals(True)
            self.onglet_combo.clear()
            id_actif = None
            for onglet in onglets:
                titre = onglet.get("titre") or onglet.get("url") or onglet.get("id", "")
                libelle = titre if len(titre) <= 50 else titre[:47] + "…"
                self.onglet_combo.addItem(libelle, onglet.get("id"))
                if onglet.get("actif"):
                    id_actif = onglet.get("id")
            if not onglets:
                self.onglet_combo.addItem("Aucun onglet ouvert", None)
            index_actif = self.onglet_combo.findData(id_actif) if id_actif else -1
            self.onglet_combo.setCurrentIndex(max(0, index_actif))
            self.onglet_combo.blockSignals(False)
            self.onglet_combo.setEnabled(len(onglets) > 0)
            self.label_statut_onglets.definir_texte(f"{len(onglets)} onglet(s) trouvé(s).")
            self.label_statut_onglets.setStyleSheet(f"color: {Mocha.green}; font-size: 11px;")
        elif requete_id == self._requete_id_switch_onglet:
            self._requete_id_switch_onglet = None
            if not data.get("ok", False):
                log_dashboard_ui.warning(f"switchTab échoué : {data.get('error', 'erreur inconnue')}")
                self.label_statut_onglets.definir_texte(f"Échec du changement d'onglet : {data.get('error', 'erreur inconnue')}")
                self.label_statut_onglets.setStyleSheet(f"color: {Mocha.red}; font-size: 11px;")
                self._demander_liste_onglets_navigateur()
        elif requete_id == self._requete_id_proprietes:
            self._requete_id_proprietes = None
            if self._requete_id_proprietes_reelles is None:
                self._panneau_proprietes.bouton_rafraichir.setEnabled(True)
            if not data.get("ok", False):
                self._panneau_proprietes.definir_message(
                    f"Impossible de récupérer les propriétés : {data.get('error', 'erreur inconnue')}",
                    est_erreur=True, sous_onglet="fictif",
                )
                return
            proprietes = data.get("result") or {}
            self._panneau_proprietes.definir_proprietes(proprietes, sous_onglet="fictif")
        elif requete_id == self._requete_id_proprietes_reelles:
            self._requete_id_proprietes_reelles = None
            if self._requete_id_proprietes is None:
                self._panneau_proprietes.bouton_rafraichir.setEnabled(True)
            if not data.get("ok", False):
                self._panneau_proprietes.definir_message(
                    f"Impossible de récupérer les propriétés réelles : {data.get('error', 'erreur inconnue')}",
                    est_erreur=True, sous_onglet="reel",
                )
                return
            proprietes = data.get("result") or {}
            self._panneau_proprietes.definir_proprietes(proprietes, sous_onglet="reel")

    # ------------------------------------------------------------------
    # Onglet "Propriétés" du panneau droit (PanneauProprietesInstance) --
    # PATCH (demande utilisateur explicite, cf. docstring de la classe) :
    # même principe requête/réponse que le bloc Onglet navigateur
    # juste au-dessus (listTabs), mais pour l'action "get_fingerprint"
    # (traitée côté instance par _session_camoufox_minimale -- SEULEMENT
    # pour les profils Camoufox, cf. son docstring : un profil "chrome"
    # ne comprend pas cette action, d'où le message dédié plus bas).
    # ------------------------------------------------------------------
    def _sur_page_panneau_droit_changee(self, index: int):
        """Appelée à chaque bascule Aperçu <-> Propriétés (cf.
        self._switch_apercu_proprietes.indice_change, connecté dans
        _construire_ui) -- déclenche la requête SEULEMENT à l'ouverture
        de l'onglet Propriétés (pas en continu pendant que l'Aperçu est
        affiché) : le fingerprint d'une instance déjà lancée ne change
        jamais en cours de session (cf. _camoufox_chemin_fingerprint,
        relu tel quel), donc pas besoin de le redemander tant que la
        sélection d'instance elle-même n'a pas changé."""
        est_page_proprietes = self._pages_panneau_droit.widget(index) is self._panneau_proprietes
        if est_page_proprietes:
            self._demander_proprietes_fingerprint()

    def _demander_proprietes_fingerprint(self):
        """Envoie "get_fingerprint" (sous-onglet Fictif) ET
        "get_fingerprint_reel" (sous-onglet Réel) à l'instance
        sélectionnée, en parallèle -- appelée à l'ouverture de l'onglet
        Propriétés (cf. _sur_page_panneau_droit_changee) et par le bouton
        "Rafraîchir" du panneau (cf. connexion dans _construire_ui).

        PATCH (demande utilisateur explicite : sous-onglet "Réel", pour
        comparaison avec le fictif) -- les deux requêtes sont
        indépendantes (requete_id séparés, cf. _requete_id_proprietes /
        _requete_id_proprietes_reelles) : chacune met à jour SON
        sous-onglet dès sa propre réponse, sans attendre l'autre."""
        if self._instance_selectionnee is None or self.client_reseau is None:
            self._panneau_proprietes.definir_message(
                "Sélectionnez une instance active pour voir ses propriétés.", sous_onglet="fictif",
            )
            self._panneau_proprietes.definir_message(
                "Sélectionnez une instance active pour voir ses propriétés.", sous_onglet="reel",
            )
            return
        self._panneau_proprietes.bouton_rafraichir.setEnabled(False)

        requete_id_fictif = uuid.uuid4().hex[:12]
        self._requete_id_proprietes = requete_id_fictif
        self._panneau_proprietes.definir_message("Récupération des propriétés…", sous_onglet="fictif")
        self._envoyer_commande_liee({
            "type": "command", "instance_id": self._instance_selectionnee,
            "action": "get_fingerprint", "requete_id": requete_id_fictif,
        })

        requete_id_reel = uuid.uuid4().hex[:12]
        self._requete_id_proprietes_reelles = requete_id_reel
        self._panneau_proprietes.definir_message("Récupération des propriétés…", sous_onglet="reel")
        self._envoyer_commande_liee({
            "type": "command", "instance_id": self._instance_selectionnee,
            "action": "get_fingerprint_reel", "requete_id": requete_id_reel,
        })

    def _on_clic_nouveau_profil(self, type_instance: str, dialogue: QDialog):
        """PATCH (retour utilisateur explicite : "on vas enlever ce card ,
        on vas lajouter dans longlet des type de proifls (chrome ,
        camoufox), ainsi le nons du card seras toujour creer nouveau
        pofils , il yauras toujour le champ de noms et de test de proxy
        et le bouton de validation de creation") -- `type_instance` est
        maintenant REÇU en paramètre (déduit de l'onglet dont le bouton
        "+ Créer un profil" a été cliqué, cf. _construire_bloc_onglet_profils),
        plus lu depuis un sélecteur du formulaire (self._bouton_type_camoufox,
        SUPPRIMÉ avec l'ancienne carte de création) : le formulaire lui-
        même ne choisit plus le type, il ne fait que nom + proxy + test,
        cf. _ouvrir_dialogue_nouveau_profil.

        `dialogue` : le QDialog modal ouvert par _ouvrir_dialogue_nouveau_profil
        (cf. sa docstring) -- fermé via dialogue.accept() en toute fin de
        cette méthode, UNIQUEMENT en cas de succès (une erreur de
        validation laisse le dialogue ouvert, cf. les `return` anticipés
        ci-dessous, pour que l'utilisateur puisse corriger sans tout
        ressaisir).

        Le proxy n'est pas réservé à Camoufox (cf. décision utilisateur
        historique conservée : "je veux que pour tout les compte tu mets
        les donne proxy") -- parsé et enregistré quel que soit le type,
        si le champ n'est pas vide.

        Les erreurs de validation (nom vide, nom déjà pris, proxy
        illisible) s'affichent dans self._label_erreur_creation_profil,
        DANS le dialogue.

        Le profil est ajouté au registre sur disque (cf.
        creer_ou_obtenir_profil pour le chemin, enregistrer_config_profil
        pour le type/proxy) et apparaît aussitôt dans l'onglet
        correspondant à son type, inactif -- aucune instance n'est lancée
        automatiquement ici, cf. bouton séparé "Lancer le profil
        sélectionné". Bascule automatiquement vers cet onglet après
        création (cf. self._type_instance_par_index_onglet) -- reste
        pertinent même si le bouton cliqué appartenait déjà à cet onglet
        (aucun effet dans ce cas, juste une garantie si jamais un jour ce
        dialogue devenait accessible autrement).

        Cette étape reste UI + stockage uniquement (cf. décision
        utilisateur en dialogue d'origine) : le type/proxy stockés ici ne
        sont pas encore branchés au lancement réel -- _lancer_instance_pour_profil
        continue de lancer du Chrome standard pour tous les profils, y
        compris ceux créés ici en "Camoufox", jusqu'à un patch séparé."""
        self._label_erreur_creation_profil.hide()

        nom = self._champ_nom_creation_profil.text().strip()
        if not nom:
            self._label_erreur_creation_profil.setText("Le nom du profil est requis.")
            self._label_erreur_creation_profil.show()
            self._champ_nom_creation_profil.setFocus()
            return

        if nom in self._profils:
            self._label_erreur_creation_profil.setText(f"Le profil '{nom}' existe déjà -- sélectionnez-le dans la liste.")
            self._label_erreur_creation_profil.show()
            return

        proxy = None
        texte_proxy = self._champ_proxy_creation_profil.text().strip()
        if texte_proxy:
            proxy = parser_proxy(texte_proxy)
            if proxy is None:
                self._label_erreur_creation_profil.setText(
                    "Format de proxy non reconnu -- ex: http://utilisateur:motdepasse@hote:port ou hote:port."
                )
                self._label_erreur_creation_profil.show()
                self._champ_proxy_creation_profil.setFocus()
                return

        nom, chemin = creer_ou_obtenir_profil(nom)
        # PATCH (demande utilisateur explicite : "le pays doit venir du
        # proxy") -- self._dernier_code_pays_teste (cf. _sur_resultat_test_proxy)
        # n'est transmis que si un proxy a bien été saisi ICI (`proxy`
        # non None) : un pays mémorisé d'un test précédent ne doit jamais
        # s'attacher à un profil créé SANS proxy (champ vidé après le
        # test, par exemple).
        pays = self._dernier_code_pays_teste if proxy else None
        enregistrer_config_profil(nom, type_instance, proxy, pays)
        self._profils[nom] = chemin
        self._champ_nom_creation_profil.clear()
        self._champ_proxy_creation_profil.clear()
        self._label_resultat_test_proxy.hide()
        self._dernier_code_pays_teste = None
        log_dashboard_ui.info(f"Profil '{nom}' créé ({chemin}, type={type_instance}, proxy={'oui' if proxy else 'non'}).")
        self._rafraichir_liste_profils()
        # Bascule vers l'onglet du type créé, pour que le profil
        # fraîchement créé soit immédiatement visible (cf. docstring
        # ci-dessus).
        for index_onglet, type_onglet in self._type_instance_par_index_onglet.items():
            if type_onglet == type_instance:
                self._tabs_profils.setCurrentIndex(index_onglet)
                break

        # PATCH (dialogue modal, cf. _ouvrir_dialogue_nouveau_profil) --
        # ferme le dialogue UNIQUEMENT ici, une fois le profil réellement
        # créé et enregistré : les erreurs de validation plus haut
        # (return anticipés) laissent le dialogue ouvert pour correction.
        dialogue.accept()

    def _rafraichir_bouton_lancer_arreter(self):
        """PATCH (demande utilisateur explicite : "je veux que tout ces
        control soit plus necesaire, que chque card de profisl gere") --
        bouton_lancer_arreter/bouton_free_pilote/bouton_menu_profil ont
        été SUPPRIMÉS (cf. leur ancien emplacement dans _construire_ui) :
        cette méthode ne touche donc plus AUCUN widget global, seulement
        les DEUX rafraîchissements par-item qui restent nécessaires,
        indépendants de tout widget global :
        - _rafraichir_bouton_lancer_profils_coches() : compteur "X actifs"
          du bouton de lancement EN LOT (cf. plus bas), toujours utile,
          jamais concerné par cette suppression.
        - _rafraichir_etats_boutons_liste_profils() : état visuel (play/
          stop/sablier) des petits boutons peints sur CHAQUE carte de la
          grille (cf. ProfilsGridItemDelegate).

        Nom de méthode CONSERVÉ tel quel (plutôt que renommé) : appelée
        depuis une douzaine de sites dans ce fichier (cf. recherche
        "_rafraichir_bouton_lancer_arreter()") à chaque changement d'état
        actif/inactif/en-cours-d'arrêt d'un profil -- renommer aurait
        demandé de patcher chacun de ces sites pour un gain cosmétique
        seulement, avec un risque de faute de frappe à chaque site."""
        self._rafraichir_bouton_lancer_profils_coches()
        self._rafraichir_etats_boutons_liste_profils()

    def _on_clic_bouton_item_profil(self, nom_profil: str):
        """PATCH (bouton lancer/arrêter par profil, demande utilisateur :
        "au lieu dattendre de selctionner un seul profils pour pourvoir
        lancer, mieux tu met deja petit bouton de lancement") -- pour UN
        profil arbitraire de la grille (nom_profil), pas forcément
        self._profil_selectionne : c'est justement le but de ce bouton,
        pouvoir lancer/arrêter un profil directement depuis sa carte
        sans avoir à le sélectionner d'abord (cf. eventFilter, qui
        déclenche cet appel au relâchement du clic sur le bouton peint par
        ProfilsGridItemDelegate). Remplace l'ancien
        _on_clic_lancer_ou_arreter (bouton global bouton_lancer_arreter,
        SUPPRIMÉ -- cf. demande utilisateur "que chque card de profisl
        gere").

        Aucune action si ce profil est actuellement en train de s'arrêter
        (cf. self._profils_en_cours_arret) -- même garde-fou que l'ancien
        bouton global (désactivé dans ce cas) : un second clic pendant le
        shutdown réseau, potentiellement long (~10s), ne doit pas relancer
        un second arrêt en parallèle sur la même instance.

        PATCH (retour utilisateur, feedback "lancement en cours") --
        même garde-fou ajouté pour self._profils_en_cours_lancement :
        un second clic pendant les 30-50s d'attente de confirmation
        serveur ne doit pas relancer un second Popen en parallèle sur
        le même dossier de profil."""
        if nom_profil in self._profils_en_cours_arret:
            return
        if nom_profil in self._profils_en_cours_lancement:
            return
        if nom_profil in self._instance_id_par_profil:
            self._arreter_instance_pour_profil(nom_profil)
        else:
            self._lancer_instance_pour_profil(nom_profil)

    def _on_clic_free_pilote_pour_profil(self, nom_profil: str):
        """PATCH (demande utilisateur : "que chque card de profisl gere")
        -- remplace l'ancien _on_clic_free_pilote (bouton global
        bouton_free_pilote, SUPPRIMÉ) : même action (force_unlink, cf.
        docstring d'origine ci-dessous), mais pour UN profil arbitraire de
        la grille, pas forcément self._profil_selectionne -- déclenché
        par le hit-test du 2e petit bouton peint sur chaque carte (cf.
        eventFilter, ProfilsGridItemDelegate.rect_bouton_free).

        Envoie force_unlink au serveur pour l'instance de CE profil --
        PAS un unlink normal (qui ne libérerait que CE Dashboard s'il
        était lui-même le pilote, cf. srv_gerer_unlink) : le serveur seul
        sait qui détient réellement la liaison en ce moment et la retire,
        quel que soit ce pilote (cf. srv_gerer_force_unlink).

        Marque nom_profil dans self._profils_en_cours_free immédiatement
        après l'envoi et jusqu'à la confirmation serveur
        (_sur_force_unlink_ok) -- empêche un double-clic de partir en
        double pendant l'aller-retour réseau (même pattern que
        self._profils_en_cours_arret pour Arrêter), et rend visible sur
        LA CARTE que l'action est en cours plutôt que silencieuse."""
        instance_id = self._instance_id_par_profil.get(nom_profil)
        if instance_id is None:
            self.label_statut_serveur.setText(
                f"Profil '{nom_profil}' : aucune instance active à libérer."
            )
            self.label_statut_serveur.setStyleSheet("color: #a6adc8; font-size: 12px;")
            return
        if nom_profil in self._profils_en_cours_free:
            return
        if self.client_reseau is None:
            self.label_statut_serveur.setText("Non connecté au serveur -- impossible d'envoyer Free.")
            self.label_statut_serveur.setStyleSheet(f"color: {Mocha.red}; font-size: 12px;")
            return
        log_dashboard_ui.info(f"_on_clic_free_pilote_pour_profil('{nom_profil}') : envoi force_unlink pour '{instance_id}'")
        self._profils_en_cours_free.add(nom_profil)
        self._rafraichir_etats_boutons_liste_profils()
        self.label_statut_serveur.setText(f"Libération de '{instance_id}' en cours…")
        self.label_statut_serveur.setStyleSheet("color: #a6adc8; font-size: 12px;")
        self.client_reseau.envoyer_commande({"type": "force_unlink", "instance_id": instance_id})

    def _definir_statut_proxy_carte(self, nom_profil: str, statut: Optional[str]):
        """PATCH (retour utilisateur explicite : "on doit nettement voir
        le statut du proxy") -- écrit DELEGATE_ROLE_STATUT_PROXY (cf. sa
        docstring) sur l'item du profil concerné et repeint UNIQUEMENT
        cette carte (même pattern que _on_clic_badge_youtube_pour_profil
        juste en dessous : setData + viewport().update() ciblé, pas de
        passage par _rafraichir_liste_profils). `statut` : None (efface
        -- retour à l'affichage neutre habituel), "en_cours" ou "echec"
        (cf. valeurs possibles listées sur DELEGATE_ROLE_STATUT_PROXY).
        Appelée à la fois par _lancer_instance_pour_profil (pose
        "en_cours" dès l'émission de la requête de test) et par
        _sur_resultat_localisation_proxy (repasse à None en cas de
        succès -- le pays affiché suffit alors -- ou "echec" sinon)."""
        config_profil = obtenir_config_profil(nom_profil)
        type_instance = config_profil["type_instance"]
        infos_onglet = self._onglets_profils.get(type_instance)
        if infos_onglet is None:
            return
        liste = infos_onglet["liste"]
        for i in range(liste.count()):
            item = liste.item(i)
            if item.data(Qt.UserRole) != nom_profil:
                continue
            item.setData(DELEGATE_ROLE_STATUT_PROXY, statut)
            liste.viewport().update()
            break

    def _on_clic_bouton_bloquer_media_pour_profil(self, nom_profil: str):
        """PATCH (demande utilisateur explicite : toggle "bloquer médias"
        sur la ligne du bouton de démarrage de chaque carte, "revocable
        a toutu meme si le profils a deja demarer") -- déclenché par le
        hit-test du 3e bouton peint sur chaque carte (cf. eventFilter,
        ProfilsGridItemDelegate.rect_bouton_bloquer_media). Purement
        local (même principe que _on_clic_badge_youtube_pour_profil
        ci-dessus, PAS un aller-retour réseau comme _on_clic_free_pilote_
        pour_profil) : bascule l'état ET l'écrit sur disque immédiatement
        (cf. definir_bloquer_media_config_profil), aucune confirmation
        asynchrone à attendre.

        Effectif même si le profil est DÉJÀ EN COURS D'EXÉCUTION, sans
        redémarrer l'instance : action_navigate/action_new_tab, côté
        processus instance, relisent ce champ à CHAQUE navigation (cf.
        leurs docstrings) -- un décochage prend donc effet dès la
        prochaine navigation ou réactualisation de page dans le
        navigateur déjà ouvert, jamais besoin d'un canal réseau dédié ni
        de relancer le profil.

        CORRECTIF n°1 (source de vérité) -- l'état à inverser est relu SUR
        DISQUE (obtenir_config_profil), plus déduit de DELEGATE_ROLE_
        BLOQUER_MEDIA de l'item cliqué. L'item n'est qu'un cache de
        peinture : s'il avait dérivé du fichier pour une raison
        quelconque, chaque clic aurait recopié cette valeur fausse sur le
        disque au lieu de la corriger. Le fichier est le même que celui
        relu à chaud côté instance (cf. _lire_toggle_bloquer_media_profil)
        -- c'est donc lui, et lui seul, qui doit décider de la bascule.

        CORRECTIF n°2 (échec d'écriture) -- definir_bloquer_media_config_
        profil retourne le succès RÉEL de l'écriture disque (cf.
        sauvegarder_registre_profils_config, dont c'est justement le
        correctif historique). En cas d'échec on ne repeint RIEN : un
        bouton qui passe au vert alors que rien n'a été écrit est pire
        que pas de retour visuel du tout, puisque l'instance, elle,
        continuerait de lire l'ancienne valeur.

        CORRECTIF n°3 (onglet Favoris) -- met à jour l'item dans TOUTES
        les listes de self._onglets_profils, pas seulement celle de son
        type_instance natif. Un profil marqué favori est DUPLIQUÉ dans
        l'onglet Favoris (cf. _rafraichir_liste_profils) : en ne
        cherchant que dans l'onglet natif, un clic donné DEPUIS l'onglet
        Favoris écrivait bien le fichier mais ne repeignait jamais la
        carte réellement cliquée -- vu de l'utilisateur, un bouton qui ne
        réagit pas."""
        try:
            etat_courant = bool(obtenir_config_profil(nom_profil).get("bloquer_media", False))
        except Exception as e:
            log_dashboard_ui.warning(
                f"_on_clic_bouton_bloquer_media_pour_profil('{nom_profil}') : "
                f"lecture de la config impossible ({e!r}) -- bascule ignorée"
            )
            return
        nouvel_etat = not etat_courant
        if not definir_bloquer_media_config_profil(nom_profil, nouvel_etat):
            log_dashboard_ui.warning(
                f"_on_clic_bouton_bloquer_media_pour_profil('{nom_profil}') : "
                f"écriture disque échouée -- le bouton reste sur son état précédent"
            )
            return
        log_dashboard_ui.info(
            f"_on_clic_bouton_bloquer_media_pour_profil('{nom_profil}') : "
            f"blocage des médias {'ACTIVÉ' if nouvel_etat else 'désactivé'}"
        )
        for infos_onglet in self._onglets_profils.values():
            liste = infos_onglet["liste"]
            for i in range(liste.count()):
                item = liste.item(i)
                if item is not None and item.data(Qt.UserRole) == nom_profil:
                    item.setData(DELEGATE_ROLE_BLOQUER_MEDIA, nouvel_etat)
            liste.viewport().update()

    def _on_clic_badge_youtube_pour_profil(self, nom_profil: str):
        """PATCH (demande utilisateur explicite : "un badge youtube ...
        que lon peu activer et desactiver par clic dessus, sa doit etre
        persistant") -- déclenché par le hit-test du badge YouTube peint
        sur chaque carte (cf. eventFilter, ProfilsGridItemDelegate.
        rect_bouton_youtube). Purement local (contrairement à
        _on_clic_free_pilote_pour_profil ci-dessus, qui passe par le
        serveur) : bascule l'état ET l'écrit sur disque immédiatement (cf.
        definir_youtube_config_profil), aucune confirmation asynchrone à
        attendre.

        Ne repeint QUE l'item concerné (même pattern que
        _rafraichir_etats_boutons_liste_profils : setData +
        viewport().update(), pas de passage par _rafraichir_liste_profils
        qui reconstruirait toute la grille pour un simple toggle) --
        cherche l'item dans LA liste où il se trouve réellement (cf.
        obtenir_config_profil(nom_profil)["type_instance"], qui détermine
        déjà le routage dans _rafraichir_liste_profils) plutôt que dans
        les deux par sécurité, un profil n'apparaissant jamais que dans
        une seule des deux listes à la fois."""
        config_profil = obtenir_config_profil(nom_profil)
        type_instance = config_profil["type_instance"]
        infos_onglet = self._onglets_profils.get(type_instance)
        if infos_onglet is None:
            return
        liste = infos_onglet["liste"]
        for i in range(liste.count()):
            item = liste.item(i)
            if item.data(Qt.UserRole) != nom_profil:
                continue
            nouvel_etat = not bool(item.data(DELEGATE_ROLE_YOUTUBE))
            definir_youtube_config_profil(nom_profil, nouvel_etat)
            item.setData(DELEGATE_ROLE_YOUTUBE, nouvel_etat)
            liste.viewport().update()
            break

