        signal TaskConfigScreen.demande_ouvrir_rendu_reseau. Contrairement
        à _ouvrir_test_composant/_ouvrir_coordonnee_action juste au-dessus,
        NE bascule PAS automatiquement vers la section Applications ni ne
        coche le bouton sidebar correspondant : le cahier des charges est
        explicite ("sans forcer le focus en permanence sur l'app") --
        l'onglet est ajouté/mis à jour en arrière-plan dans
        ApplicationsScreen, l'utilisateur y accède quand il clique
        lui-même sur "Applications" dans la sidebar, exactement comme un
        onglet resté ouvert après un clic sur "Retour" (cf.
        _retour_depuis_applications juste en dessous)."""
        self.screens["applications"].ouvrir_rendu_task_reseau(widget, titre, origine="taskconfig")

    def _retour_depuis_applications(self, cle_ecran_origine: str):
        """Ramène vers l'écran d'où un onglet Applications a été ouvert
        (bouton "Retour" cliqué DANS l'onglet). L'onglet reste ouvert en
        arrière-plan dans la section Applications — ce bouton ne le ferme
        jamais, il ne fait que changer l'écran affiché au premier plan."""
        if cle_ecran_origine and cle_ecran_origine in self.screens:
            self._show_screen(cle_ecran_origine)
            if cle_ecran_origine in self.sidebar.buttons:
                self.sidebar.buttons[cle_ecran_origine].setChecked(True)

    def _show_screen(self, key: str):
        # PATCH (demande utilisateur explicite : corbeille) : l'écran
        # Corbeille est reconstruit une seule fois dans _build_screens,
        # mais son contenu (Project.corbeille) peut avoir changé depuis
        # (suppression d'un Task/Composant/ServiceAPI/Projet Batch depuis
        # n'importe quel autre écran) -- on le rafraîchit systématiquement
        # à chaque navigation vers cette section plutôt que de dupliquer
        # un appel à rafraichir() sur chacun des 4 sites de suppression.
        screen = self.screens[key]
        if key == "corbeille" and isinstance(screen, CorbeilleScreen):
            screen.rafraichir()
        self.content_stack.setCurrentWidget(screen)


