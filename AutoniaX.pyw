        # --- Rangée 1 : image + les 2 toggles sur la même ligne (SPEC) ---
        self.image_label = QLabel(self)
        self.image_label.setObjectName("PanneauLayoutImage")
        self.image_label.setAlignment(Qt.AlignCenter)
