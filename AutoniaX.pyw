            # global est relevé au-delà de debug) ; le reste (log simple,
            # ex. "writeText() intercepté") en log.info -- ces logs sont
            # PEU FRÉQUENTS par construction (un clic copier = quelques
            # lignes), donc pas besoin de les reléguer en debug comme le
            # reste de la robustesse presse-papier.
            fonction_log = log.warning if type_message in ("error", "warning") else log.info
            fonction_log(f"[camoufox][console-page] {texte}")

        try:
            page.on("console", _sur_message_console)
        except Exception:  # noqa: BLE001 -- page déjà fermée entre-temps
            pass

    for page_existante in list(context.pages):
        _brancher_page(page_existante)
    context.on("page", _brancher_page)


async def camoufox_installer_interception_presse_papier(context, etat_navigateur: dict) -> None:
    """À appeler UNE SEULE FOIS sur le contexte, juste après sa création
    (cf. camoufox_demarrer_navigateur ci-dessous).
    etat_navigateur["presse_papier_virtuel"] est mis à jour par le
    callback à chaque copie déclenchée par une page, quel que soit
    l'onglet -- même clé ("presse_papier_virtuel") que le dict
    etat_navigateur du client nodriver, pour rester interchangeable si ce
    client est branché plus tard.

    PATCH (retour utilisateur explicite -- id DOM en propriété du
    composant) : en plus de cette valeur globale (filet de sécurité,
    comportement historique 100% inchangé), etat_navigateur[
    "presse_papier_virtuel_par_id"] accumule la DERNIÈRE copie propre à
    chaque id d'élément déclencheur rencontré -- {id_dom: {"texte": ...,
    "ts": ...}} depuis le PATCH robustesse (cf.
    _memoriser_copie_presse_papier, point d'écriture unique partagé), cf.
    action_camoufox_click qui y pioche quand id_dom_presse_papier est
    fourni dans les params. Jamais vidé/réinitialisé automatiquement
    (comme presse_papier_virtuel lui-même) : une entrée absente signifie
    simplement "cet id n'a encore jamais déclenché de copie observée"."""

    async def _sur_copie(texte: str, id_declencheur: str = "") -> None:
        # PATCH (robustesse capture de copie) -- même point d'écriture
        # unique que côté CDP (_sur_binding_appele), cf. docstring de
        # _memoriser_copie_presse_papier : horodatage monotone du global
        # ET de l'entrée par id, sans quoi la vérification de fraîcheur
        # du click(copier_presse_papier=True) est impossible.
        #
        # DIAGNOSTIC (demande explicite utilisateur : "jespere que tout
        # sa seras loguer directement dans le terminal") -- ce cas
        # particulier est le signal d'installation envoyé tout en tête de
        # _JS_CAMOUFOX_INTERCEPTION_PRESSE_PAPIER (cf. son commentaire
        # DIAGNOSTIC), PAS une vraie copie : on le loggue à part pour ne
        # jamais le confondre avec une copie de texte réelle en lisant les
        # logs, et on N'ÉCRIT PAS dans le presse-papier virtuel pour cette
        # entrée spéciale (un texte vide écraserait sinon une copie
        # antérieure légitime encore utile).
        if id_declencheur.startswith("__diag_installation__:"):
            log.info(
                f"[camoufox][diag-copie] script d'interception CONFIRMÉ installé et "
                f"fonctionnel sur : {id_declencheur[len('__diag_installation__:'):]!r}"
            )
            return
        _memoriser_copie_presse_papier(etat_navigateur, texte, id_declencheur)
        if texte:  # TOUTE copie est aussi écrite dans le presse-papier Windows
            threading.Thread(target=_ecrire_presse_papier_windows, args=(texte,), daemon=True).start()
        # DIAGNOSTIC -- monté de debug à info (visible dans le terminal
        # avec le niveau par défaut, sans AUTONIAX_DEBUG=1) : c'est LE log
        # qui confirme qu'une copie a bien été interceptée et transmise
        # jusqu'à Python, peu importe ensuite si _attendre_copie_presse_
        # papier_fraiche la juge fraîche ou non -- essentiel pour trancher
        # "aucune voie de copie n'a jamais atteint Python" (ce log
        # n'apparaît jamais) de "une copie arrive mais trop tard/avec le
        # mauvais id" (ce log apparaît mais après le message d'échec, ou
        # avec un id inattendu).
        log.info(
            f"[camoufox][diag-copie] presse-papier virtuel mis à jour depuis la page : {texte!r}"
            + (f" (id={id_declencheur!r})" if id_declencheur else " (aucun id déclencheur détecté)")
        )

    await context.expose_function("__autoniax_camoufox_copie__", _sur_copie)
    await context.add_init_script(_JS_CAMOUFOX_INTERCEPTION_PRESSE_PAPIER)


async def action_camoufox_copy(page) -> str:
    """copy() -- déclenche un Ctrl+C sur la sélection courante, PUIS
    laisse l'interception JS mettre à jour etat_navigateur[
    "presse_papier_virtuel"] de façon asynchrone (cf. docstring
    camoufox_installer_interception_presse_papier). Retourne "" comme
    valeur immédiate -- la vraie valeur arrive via le callback, cohérent
    avec le script standalone de validation ; l'appelant
    (_executer_commande_camoufox) doit relire etat_navigateur[
    "presse_papier_virtuel"] après un court délai s'il veut la valeur à
    jour dans la même commande."""
    try:
        await page.keyboard.press("Control+c")
    except Exception as exc:
        _camoufox_relever_si_fermeture(exc)
        raise
    await asyncio.sleep(0.1)
    return ""


def action_camoufox_get_clipboard(etat_navigateur: dict) -> str:
    """get_clipboard() -- lecture pure du presse-papier virtuel, sans
    déclencher de copie (identique à action_get_clipboard côté nodriver)."""
    return str(etat_navigateur.get("presse_papier_virtuel", ""))


# ---------------------------------------------------------------------------
# Gestion d'onglets -- 4.2 (listTabs, switchTab) + étendues (newTab,
# resetInterface). Playwright n'expose pas d'identifiant stable comparable
# au target_id CDP : on maintient nous-mêmes un registre id <-> objet Page.
# ---------------------------------------------------------------------------

class GestionOngletsCamoufox:
    """Registre id <-> Page. Un nouvel onglet reçoit un uuid4 court à sa
    création (via action_camoufox_new_tab) ou à la première rencontre
    (via action_camoufox_list_tabs, si l'onglet a été ouvert nativement
    par la page pilotée -- target="_blank", window.open() JS -- même cas
    que celui documenté pour switchTab côté nodriver)."""

    def __init__(self) -> None:
        self._id_vers_page: dict = {}
        self._page_vers_id: dict = {}

    def enregistrer(self, page) -> str:
        cle = id(page)
        if cle in self._page_vers_id:
            return self._page_vers_id[cle]
        nouvel_id = uuid.uuid4().hex[:12]
        self._id_vers_page[nouvel_id] = page
        self._page_vers_id[cle] = nouvel_id
        # PATCH (retour utilisateur -- goBack/goForward Camoufox "ok=True
        # mais rien ne bouge visuellement", cf. docstring complète sur
        # action_camoufox_go_back un peu plus bas) -- cause racine :
        # page.go_back()/page.go_forward() de Playwright peuvent se
        # contenter d'une restauration bfcache silencieuse, désynchronisée
        # de l'état réellement visible, au lieu d'une vraie navigation
        # réseau. Contournement : on suit l'historique de navigation
        # NOUS-MÊMES (Playwright n'expose aucun équivalent de
        # cdp.page.get_navigation_history()), via l'événement
        # "framenavigated" -- posé ICI, au moment où CETTE page entre
        # dans le registre (création initiale, newTab, ou premIère
        # rencontre via listTabs/resynchroniser pour un onglet ouvert
        # nativement par le site) -- donc couvre tous les cas d'origine
        # d'une page, pas seulement celles créées via action_camoufox_
        # new_tab.
        page._autoniax_historique_back = []
        page._autoniax_historique_forward = []
        page._autoniax_derniere_url_historisee = page.url

        def _sur_navigation(frame, _page=page):
            # frame.parent_frame is None -- ne compter QUE les
            # navigations du frame PRINCIPAL (top-level), jamais celles
            # d'une iframe interne au site (pub, widget, etc.), sinon
            # goBack/goForward navigueraient au mauvais niveau.
            if frame.parent_frame is not None:
                return
            nouvelle_url = frame.url
            if nouvelle_url == _page._autoniax_derniere_url_historisee:
                return
            # Une navigation "fraîche" (pas causée par notre propre
            # action_camoufox_go_back/_go_forward, cf. leur code qui
            # dépile AVANT le page.goto()) efface toujours la pile
            # forward -- comportement standard d'un historique de
            # navigateur : aller sur un nouveau lien après un retour en
            # arrière supprime la branche "avenir" qui existait avant.
            if not getattr(_page, "_autoniax_navigation_interne_en_cours", False):
                _page._autoniax_historique_back.append(_page._autoniax_derniere_url_historisee)
                _page._autoniax_historique_forward.clear()
            _page._autoniax_derniere_url_historisee = nouvelle_url

        page.on("framenavigated", _sur_navigation)
        return nouvel_id

    def oublier(self, page) -> None:
        cle = id(page)
        tab_id = self._page_vers_id.pop(cle, None)
        if tab_id is not None:
            self._id_vers_page.pop(tab_id, None)

    def par_id(self, tab_id: str):
        return self._id_vers_page.get(tab_id)

    def resynchroniser(self, pages: list) -> None:
        for p in pages:
            self.enregistrer(p)


async def action_camoufox_list_tabs(context, gestion: GestionOngletsCamoufox, page_active) -> list:
    """listTabs() -- même forme de résultat que action_list_tabs côté
    nodriver (liste de dict id/url/titre/actif)."""
    gestion.resynchroniser(context.pages)
    resultat = []
    for p in context.pages:
        tab_id = gestion.enregistrer(p)
        try:
            titre = await p.title()
        except Exception:
            titre = "(inconnu)"
        resultat.append({"id": tab_id, "url": p.url, "titre": titre, "actif": p is page_active})
    return resultat


async def action_camoufox_switch_tab(context, gestion: GestionOngletsCamoufox, tab_id: str):
    """switchTab(tabId) -- lève KeyError si l'onglet est introuvable,
    charge à l'appelant (_executer_commande_camoufox) de le traduire en
    command_result ok=False, même contrat que le KeyError levé par
    browser.get()/le mapping nodriver équivalent."""
    gestion.resynchroniser(context.pages)
    page = gestion.par_id(tab_id)
    if page is None:
        raise KeyError(f"onglet introuvable : {tab_id!r}")
    await page.bring_to_front()
    return page


async def action_camoufox_bring_to_front(page_active) -> None:
    """bringToFront() -- équivalent Playwright de action_bring_to_front
    (CDP/nodriver, cf. sa docstring pour le contexte complet de la
    demande utilisateur) : remonte la fenêtre du navigateur au premier
    plan du bureau, ponctuellement, SANS changer d'onglet -- page_active
    est déjà l'onglet actif, page.bring_to_front() (même appel que
    action_camoufox_switch_tab ci-dessus) se contente de lui redonner le
    focus fenêtre.

    Lève ValueError si page_active est None, même contrat que action_
    bring_to_front côté CDP/nodriver."""
    if page_active is None:
        raise ValueError("aucune page active connue pour cette instance -- impossible de la mettre au premier plan")
    await page_active.bring_to_front()
    # PATCH (« ça ne remonte pas, la barre des tâches clignote ») -- même
    # forçage Windows que côté Chrome (cf. _forcer_fenetre_navigateur_premier_plan).
    if sys.platform == "win32":
        try:
            try:
                titre = str(await page_active.title() or "")
            except Exception:
                titre = ""
            diag = await asyncio.get_running_loop().run_in_executor(
                None, lambda: _forcer_fenetre_navigateur_premier_plan(
                    {os.getpid()}, titre, {"MozillaWindowClass"}, PREMIER_PLAN_PREND_LE_FOCUS))
            log.info(f"[bringToFront] {diag}")
        except Exception as exc:
            log.warning(f"[bringToFront] forçage Windows impossible : {exc!r}")


# PATCH (retour utilisateur -- cf. commentaire jumeau sur action_go_back/
# action_go_forward, chemin CDP/nodriver, un peu plus haut dans ce
# fichier) -- équivalent Playwright, nettement plus simple côté API :
# page.go_back()/page.go_forward() gèrent nativement le cas "déjà en
# bout d'historique" en renvoyant None plutôt qu'une exception, pas
# besoin de lire l'historique/l'index à la main comme côté CDP bas
# niveau.
async def action_camoufox_go_back(page) -> bool:
    """goBack() -- navigue vers la page précédente de l'historique de cet
    onglet. Retourne False (sans erreur) si déjà sur la première entrée
    -- comportement identique à un bouton précédent natif désactivé/sans
    effet en bout d'historique.

    PATCH (retour utilisateur : "ça ne fonctionne pas" -- log confirmé
    ok=True/'Action exécutée' à chaque appel, mais aucune navigation
    visible sur l'instance) -- N'UTILISE PLUS page.go_back() (Playwright).
    Cause racine identifiée par recherche : Playwright désactive le
    back/forward cache (bfcache) mais son état interne de navigation
    reste basé sur les événements réseau -- une restauration bfcache ne
    déclenche pas ces événements, donc go_back()/go_forward() peuvent
    "réussir" silencieusement (pas d'exception, retour non-None) sans
    déclencher de navigation réseau réelle ni resynchroniser l'état
    interne de Playwright avec ce qui est réellement affiché.

    CONTOURNEMENT : on suit l'historique de navigation NOUS-MÊMES (pile
    _autoniax_historique_back/_forward posée sur l'objet page par
    GestionOngletsCamoufox.enregistrer(), alimentée par l'événement
    "framenavigated" -- cf. son commentaire pour le détail), et on fait
    un vrai page.goto(url) vers l'entrée précédente. page.goto() est
    toujours une navigation réseau complète, jamais une restauration
    bfcache silencieuse."""
    pile_back = getattr(page, "_autoniax_historique_back", None)
    if not pile_back:
        return False
    url_cible = pile_back.pop()
    pile_forward = page._autoniax_historique_forward
    pile_forward.append(page._autoniax_derniere_url_historisee)
    # Empêche le listener framenavigated (posé par enregistrer()) de
    # traiter CETTE navigation comme un nouveau clic utilisateur --
    # sinon il repousserait bêtement l'URL qu'on vient de dépiler dans
    # pile_back et viderait pile_forward qu'on vient de remplir juste
    # au-dessus.
    page._autoniax_navigation_interne_en_cours = True
    try:
        await page.goto(url_cible)
    finally:
        page._autoniax_navigation_interne_en_cours = False
    page._autoniax_derniere_url_historisee = url_cible
    return True


async def action_camoufox_go_forward(page) -> bool:
    """goForward() -- symétrique de action_camoufox_go_back (cf. son
    docstring pour le détail complet du contournement bfcache)."""
    pile_forward = getattr(page, "_autoniax_historique_forward", None)
    if not pile_forward:
        return False
    url_cible = pile_forward.pop()
    page._autoniax_historique_back.append(page._autoniax_derniere_url_historisee)
    page._autoniax_navigation_interne_en_cours = True
    try:
        await page.goto(url_cible)
    finally:
        page._autoniax_navigation_interne_en_cours = False
    page._autoniax_derniere_url_historisee = url_cible
    return True


async def action_camoufox_new_tab(context, gestion: GestionOngletsCamoufox, url: str, timeout_attente_page_s: float = 8.0):
    """newTab(url) -- ouvre un nouvel onglet et attend son chargement.
    Retourne (page, charge, erreur) -- même contrat que action_new_tab
    côté nodriver : charge=False n'est JAMAIS une exception qui remonte,
    toujours un tuple exploitable par l'appelant pour construire un
    command_result ok=False propre. Seule une fermeture réelle du
    navigateur pendant l'attente lève NavigateurFermeCamoufox."""
    page = await context.new_page()
    gestion.enregistrer(page)
    try:
        if (url or "").startswith("data:text/html"):     # page locale (welcome page) : pas d'attente de load, cf. démarrage d'instance
            await page.goto(url, timeout=timeout_attente_page_s * 1000, wait_until="commit")
        else:
            await page.goto(url or "about:blank", timeout=timeout_attente_page_s * 1000)
        return page, True, None
    except Exception as exc:
        if _camoufox_est_erreur_fermeture(exc):
            raise NavigateurFermeCamoufox(str(exc)) from exc
        return page, False, str(exc)


async def action_camoufox_navigate(page, url: str, timeout_attente_page_s: float = 8.0) -> Tuple[bool, Optional[str]]:
    """navigate(url) -- AJOUT demandé par l'utilisateur (symétrique
    nodriver de action_navigate, cf. sa docstring) : navigue vers url
    SUR L'ONGLET DÉJÀ ACTIF (page, passée par l'appelant), sans en créer
    un nouveau -- contrairement à action_camoufox_new_tab. page.goto()
    attend nativement le chargement complet côté Playwright (même
    mécanisme que action_camoufox_new_tab, cf. son docstring), pas de
    polling manuel nécessaire ici contrairement au côté CDP/nodriver.

    Retourne (charge, erreur) -- MÊME contrat que action_camoufox_new_tab :
    charge=False n'est JAMAIS une exception qui remonte, toujours un
    tuple exploitable par l'appelant pour construire un command_result
    ok=False propre. Seule une fermeture réelle du navigateur pendant la
    navigation lève NavigateurFermeCamoufox (même exception, même
    convention)."""
    try:
        await page.goto(url or "about:blank", timeout=timeout_attente_page_s * 1000)
        return True, None
    except Exception as exc:
        if _camoufox_est_erreur_fermeture(exc):
            raise NavigateurFermeCamoufox(str(exc)) from exc
        return False, str(exc)


# ---------------------------------------------------------------------------
# AJOUT -- clearBrowsingData : vide TOUTES les données de navigation du contexte (cookies, localStorage, sessionStorage, IndexedDB, Cache Storage,
# service workers, cache HTTP, permissions...). Moteurs Playwright : CloakBrowser (Chromium : en plus, nettoyage CDP complet) et Camoufox (Firefox :
# cookies + permissions + nettoyage JS de chaque onglet, pas de CDP). NE touche NI aux onglets NI au profil sur disque (historique, mots de passe, favoris).
# ---------------------------------------------------------------------------
JS_VIDER_STOCKAGE_PAGE = """(async () => {
  var n = 0;
  try { localStorage.clear(); n++; } catch (e) {}
  try { sessionStorage.clear(); n++; } catch (e) {}
  try { if (indexedDB && indexedDB.databases) { var d = await indexedDB.databases();
    await Promise.all(d.map(function (x) { return new Promise(function (r) { var q = indexedDB.deleteDatabase(x.name); q.onsuccess = q.onerror = q.onblocked = function () { r(); }; }); })); n++; } } catch (e) {}
  try { var k = await caches.keys(); await Promise.all(k.map(function (c) { return caches.delete(c); })); n++; } catch (e) {}
  try { var s = await navigator.serviceWorker.getRegistrations(); await Promise.all(s.map(function (r) { return r.unregister(); })); n++; } catch (e) {}
  return n;
})()"""

async def action_camoufox_clear_browsing_data(context) -> dict:
    """clearBrowsingData -- retourne un rapport {"ok": bool, "cookies": bool, "permissions": bool, "cdp": [...], "pages_nettoyees": int, "erreurs": [...]}.
    ok=True si AU MOINS les cookies ont été vidés sans erreur bloquante."""
    rapport = {"ok": False, "cookies": False, "permissions": False, "cdp": [], "pages_nettoyees": 0, "erreurs": []}
    pages = [p for p in list(context.pages) if not p.is_closed()]
    origines = set()
    # 1) stockage de chaque onglet (JS) : fonctionne aussi sur Firefox/Camoufox
    for p in pages:
        url = p.url or ""
        if url.startswith(("http://", "https://")):
            try:
                origines.add(url.split("/", 3)[0] + "//" + url.split("/", 3)[2])
            except Exception:
                pass
        try:
            await asyncio.wait_for(p.evaluate(JS_VIDER_STOCKAGE_PAGE), timeout=6.0)
            rapport["pages_nettoyees"] += 1
        except Exception as exc:
            rapport["erreurs"].append(f"stockage onglet {url[:60]!r} : {exc!r}")
    # 2) CDP (Chromium/CloakBrowser uniquement) : cache HTTP, tous les types de stockage de TOUTES les origines, cookies
    if pages:
        sess = None
        try:
            sess = await context.new_cdp_session(pages[0])
        except Exception as exc:
            rapport["erreurs"].append(f"CDP indisponible (normal sous Firefox/Camoufox) : {exc!r}")
        if sess is not None:
            try:
                etapes = [("Network.clearBrowserCache", {}), ("Network.clearBrowserCookies", {}),
                          ("Storage.clearDataForOrigin", {"origin": "*", "storageTypes": "all"})]
                etapes += [("Storage.clearDataForOrigin", {"origin": o, "storageTypes": "all"}) for o in sorted(origines)]
                for methode, params in etapes:
                    try:
                        await asyncio.wait_for(sess.send(methode, params), timeout=6.0)
                        rapport["cdp"].append(methode + (" " + params.get("origin", "") if params else ""))
                    except Exception as exc:
                        rapport["erreurs"].append(f"{methode} {params.get('origin', '')} : {exc!r}")
            finally:
                try:
                    await sess.detach()
                except Exception:
                    pass
    # 3) cookies + permissions du contexte (en DERNIER : plus rien ne les repose après)
    try:
        await context.clear_cookies()
        rapport["cookies"] = True
    except Exception as exc:
        rapport["erreurs"].append(f"clear_cookies : {exc!r}")
    try:
        await context.clear_permissions()
        rapport["permissions"] = True
    except Exception as exc:
        rapport["erreurs"].append(f"clear_permissions : {exc!r}")
    rapport["ok"] = rapport["cookies"]
    return rapport


async def action_camoufox_reset_interface(context, gestion: GestionOngletsCamoufox, url_accueil: str, etat_navigateur: Optional[dict] = None):
    """resetInterface() -- ouvre le nouvel onglet (welcome page) AVANT de
    fermer tous les anciens, jamais l'inverse (même précaution que
    action_reset_interface côté nodriver : fermer tous les onglets d'un
    coup peut tuer le process navigateur entier). Retourne le nouvel
    onglet actif, à réaffecter par l'appelant."""
    nouvel_onglet = await context.new_page()
    gestion.enregistrer(nouvel_onglet)
    await nouvel_onglet.goto(url_accueil)
    # CORRECTIF (plantage reset/capture) -- la page active est réaffectée AVANT
    # la fermeture des anciens onglets : sinon le streaming continuait de
    # capturer un onglet en train de mourir (TargetClosedError pris à tort
    # pour la mort du navigateur).
    if etat_navigateur is not None:
        etat_navigateur["page"] = nouvel_onglet

    anciens = [p for p in context.pages if p is not nouvel_onglet]
    for onglet in anciens:
        gestion.oublier(onglet)
        try:
            await asyncio.wait_for(onglet.close(), timeout=3.0)
        except Exception as exc:
            log.debug(f"[camoufox] resetInterface : fermeture d'un ancien onglet ignorée -- {exc!r}")
    return nouvel_onglet


# ---------------------------------------------------------------------------
# Welcome page -- reconnaissance par data: URL + instance_id encodé, EXACTE-
# MENT le même mécanisme que côté nodriver (cf. action_is_interface_
# initialisee / action_get_home_tab_id / _data_url_page_accueil) : préfixe
# "data:text/html" + urllib.parse.quote(instance_id) présent dans l'URL.
# Réutilise volontairement les MÊMES fonctions de rendu HTML
# (contenu_page_accueil / _data_url_page_accueil, définies plus haut pour
# le client nodriver) plutôt que d'en dupliquer une version Camoufox --
# c'est strictement le contenu HTML de la page, indépendant du client qui
# pilote le navigateur.
# ---------------------------------------------------------------------------

async def action_camoufox_is_interface_initialisee(context, instance_id: str) -> bool:
    """isInterfaceInitialisee() -- UN SEUL onglet ouvert, ET cet onglet
    pointe vers la welcome page de CETTE instance -- même définition que
    action_is_interface_initialisee côté nodriver."""
    pages = context.pages
    if len(pages) != 1:
        return False
    url_unique_onglet = pages[0].url or ""
    if not url_unique_onglet.startswith("data:text/html"):
        return False
    fragment_instance_id = urllib.parse.quote(instance_id or "—")
    return fragment_instance_id in url_unique_onglet


async def action_camoufox_get_home_tab_id(context, gestion: GestionOngletsCamoufox, instance_id: str) -> Optional[str]:
    """getHomeTabId() -- retrouve le tab_id (id maison, cf.
    GestionOngletsCamoufox) de l'onglet welcome page de cette instance,
    SANS l'exigence "un seul onglet ouvert" (contrairement à
    isInterfaceInitialisee) -- même relâchement que
    action_get_home_tab_id côté nodriver. Retourne None si introuvable
    (fermé manuellement, ou instance démarrée avec une url_ouverture
    personnalisée) -- à l'appelant de traduire ça en command_result
    ok=False."""
    gestion.resynchroniser(context.pages)
    fragment_instance_id = urllib.parse.quote(instance_id or "—")
    for page in context.pages:
        url_page = page.url or ""
        if url_page.startswith("data:text/html") and fragment_instance_id in url_page:
            return gestion.enregistrer(page)
    return None


# ---------------------------------------------------------------------------
# capture_propre -- étendue, dédiée à la détection OpenCV (jamais utilisée
# par le streaming continu, qui garde le curseur visible). Même séquence
# que action_capture_propre côté nodriver : masquer -> capturer -> réafficher
# (toujours, même en cas d'échec de capture -- finally).
# ---------------------------------------------------------------------------

async def action_camoufox_capture_propre(page) -> dict:
    """capture_propre() -- retourne {"image_b64": ...}, même format de
    payload qu'une frame normale ; lève RuntimeError si la capture a
    échoué (image_b64 vide), même contrat que action_capture_propre côté
    nodriver."""
    image_b64 = None
    debut_total = _horloge()
    debut_masquage = _horloge()
    await _camoufox_masquer_curseur_virtuel(page)
    duree_masquage = _horloge() - debut_masquage
    try:
        image_b64 = await camoufox_capturer_frame_reelle(page, "capture_propre", haute_qualite=True)
    finally:
        debut_reaffichage = _horloge()
        await _camoufox_reafficher_curseur_virtuel(page)
        duree_reaffichage = _horloge() - debut_reaffichage
    duree_totale = _horloge() - debut_total
    # LOG DIAGNOSTIC : ventile la durée totale de capture_propre entre ses
    # 3 étapes (masquage curseur / capture écran / réaffichage curseur) --
    # si duree_totale est anormalement longue, ce log dit immédiatement
    # laquelle des 3 étapes en est responsable, sans avoir à deviner.
    if duree_totale > 1.0:
        log.warning(
            f"[camoufox] action_camoufox_capture_propre() : LENTE -- total={duree_totale:.3f}s "
            f"(masquage_curseur={duree_masquage:.3f}s, réaffichage_curseur={duree_reaffichage:.3f}s, "
            f"capture={duree_totale - duree_masquage - duree_reaffichage:.3f}s, succès={image_b64 is not None})"
        )
    else:
        log.debug(
            f"[camoufox] action_camoufox_capture_propre() : total={duree_totale:.3f}s "
            f"(masquage={duree_masquage:.3f}s, réaffichage={duree_reaffichage:.3f}s)"
        )
    if image_b64 is None:
        raise RuntimeError("capture_propre (camoufox) : échec de capture (image_b64 vide)")
    return {"image_b64": image_b64}


# ---------------------------------------------------------------------------
# Téléchargements -- étendue (set_download_dir). Mécanique différente de
# Browser.setDownloadBehavior (CDP) : Playwright gère les téléchargements
# via l'événement "download" par page + download.save_as(...) vers le
# dossier voulu. accept_downloads est déjà activé par défaut par Camoufox/
# Playwright (pas de réglage équivalent à passer explicitement au
# démarrage) -- il suffit d'écouter "download" sur chaque page, présente
# et future, pour rediriger tout téléchargement déclenché par cette
# instance.
# ---------------------------------------------------------------------------

async def camoufox_installer_gestion_telechargements(page, download_dir: str) -> None:
    Path(download_dir).mkdir(parents=True, exist_ok=True)

    async def _sur_telechargement(download) -> None:
        cible = Path(download_dir) / download.suggested_filename
        try:
            await download.save_as(str(cible))
            log.info(f"[camoufox] téléchargement reçu -> {cible}")
        except Exception as exc:
            log.warning(f"[camoufox] échec de l'enregistrement du téléchargement ({cible}) : {exc!r}")

    page.on("download", lambda d: asyncio.create_task(_sur_telechargement(d)))


async def action_camoufox_set_download_dir(page, download_dir: str, instance_id: str = "") -> bool:
    """set_download_dir(download_dir) -- équivalent Camoufox de
    _appliquer_download_dir (Browser.setDownloadBehavior en CDP) : réabonne
    l'événement "download" de la page active vers le nouveau dossier.
    Applicable À CHAUD sur une instance déjà connectée (cf. usage "Projet
    Batch" côté nodriver -- même besoin ici si ce client est branché plus
    tard sur un mode pool similaire). Non bloquant par construction :
    retourne True/False plutôt que de lever, mêmes conventions que
    _appliquer_download_dir."""
    try:
        await camoufox_installer_gestion_telechargements(page, download_dir)
        log.info(f"[camoufox] téléchargements de l'instance '{instance_id}' redirigés vers {download_dir}")
        return True
    except Exception as exc:
        log.warning(f"[camoufox] échec de configuration du dossier de téléchargement ({download_dir!r}) : {exc!r}")
        return False


# ---------------------------------------------------------------------------
# Construction de la config de lancement -- PATCH (demande utilisateur
# explicite : "je veux quelque chose de extremement robuste") pour une
# empreinte (fingerprint) COHÉRENTE plutôt que les seuls
# headless/persistent_context/user_data_dir d'origine (aucun paramètre
# anti-détection avant ce patch).
#
# Principe retenu (cf. recherche Camoufox/BrowserForge) : laisser Camoufox
# lui-même générer le fingerprint via BrowserForge (statistiquement
# cohérent OS/GPU/police/écran, cf. doc officielle) plutôt que de
# recalculer chaque point à la main -- notre valeur ajoutée se limite à
# CE que Camoufox ne déduit pas tout seul :
#   - le proxy à utiliser (vient du profil, cf. obtenir_config_profil)
#   - geoip=True : aligne automatiquement timezone/locale/géolocalisation
#     WebRTC sur l'IP réelle DU PROXY (calculé par Camoufox via une
#     requête à travers ce même proxy -- cf. doc "geoip (Optional[str,
#     bool])... Pass the target IP, or True to find it"). Ce point précis
#     est celui qui, non fait, causerait l'incohérence la plus flagrante
#     et la plus commune (proxy russe + fuseau horaire français) --
#     PRIORITAIRE sur tout le reste.
#   - humanize=True : trajectoires de curseur non linéaires (cf. doc,
#     évite la détection comportementale, indépendante du fingerprint
#     statique).
#   - un fingerprint persistant PAR PROFIL (fichier JSON à côté du
#     user_data_dir, cf. _camoufox_chemin_fingerprint) : sans ça, Camoufox
#     générerait un fingerprint ALÉATOIRE DIFFÉRENT à chaque relance du
#     même profil -- ce qui est en réalité suspect aussi (un vrai appareil
#     garde le même matériel d'une session à l'autre). PAS de paramètre
#     `seed` (n'existe pas dans l'API publique, cf. CORRECTIF dans
#     camoufox_demarrer_navigateur) : la persistance passe par
#     camoufox.utils.launch_options() sauvegardée en JSON, rechargée via
#     AsyncCamoufox(from_options=...).
#
# Sans proxy configuré sur le profil (type_instance="chrome" migré, ou
# Camoufox créé sans proxy) : pas de geoip (rien à aligner dessus), le
# reste (os/humanize/fingerprint persistant) s'applique quand même -- un
# fingerprint cohérent reste utile même sans proxy.
# ---------------------------------------------------------------------------

def _camoufox_chemin_fingerprint(profil: Optional[str]) -> Optional[Path]:
    """Chemin du fichier JSON où persiste le fingerprint Camoufox de CE
    profil (généré une seule fois via camoufox.utils.launch_options, puis
    rechargé tel quel à chaque relance via AsyncCamoufox(from_options=...)
    -- cf. docstring de _camoufox_construire_config_lancement pour le
    pourquoi de cette approche plutôt qu'un paramètre `seed`, qui n'existe
    PAS dans l'API publique de Camoufox (vérifié : ni AsyncCamoufox ni
    launch_options n'acceptent de kwarg `seed` -- confusion initiale de
    ma part avec BrowserForge, corrigée ici).

    Stocké DANS le dossier du profil lui-même (à côté du user_data_dir
    Firefox que Camoufox y gère) -- même profil => même fichier => même
    fingerprint rechargé, exactement comme les exemples officiels du
    projet (cf. discussions daijro/camoufox #151 et #332 : un
    fingerprint.json/opts.json à côté du user_data_dir, chargé si présent,
    généré et sauvegardé sinon).

    profil=None (cas limite) : pas de dossier où écrire -> pas de
    persistance possible, l'appelant doit alors se rabattre sur un
    fingerprint généré à la volée sans sauvegarde."""
    if not profil:
        return None
    return Path(profil) / "camoufox_fingerprint.json"


def _camoufox_extraire_config_brute(opts_from_options: dict) -> dict:
    """Reconstruit le dict de CONFIG BrowserForge complet (navigator.*,
    screen.*, geolocation:*, webGl:*, etc.) à partir du dict retourné par
    camoufox.utils.launch_options(...) / sauvegardé en JSON par
    camoufox_demarrer_navigateur.

    Vérifié par lecture directe du code source de camoufox/utils.py
    (get_env_vars) : ce `config` n'est PAS une clé de premier niveau du
    dict -- il est sérialisé en JSON puis DÉCOUPÉ en morceaux dans
    opts["env"]["CAMOU_CONFIG_1"], ["CAMOU_CONFIG_2"], etc. (limite de
    taille des variables d'environnement, notamment 2047 caractères sous
    Windows) pour être lu côté C++ au démarrage du navigateur. Il faut
    donc concaténer ces morceaux DANS L'ORDRE de leur suffixe numérique
    avant de reparser le JSON -- une seule des clés ne contiendrait qu'un
    fragment tronqué, pas un JSON valide.

    Défensif : retourne {} (jamais d'exception) si la structure ne
    correspond pas à ce qui est attendu -- une version de camoufox plus
    récente/ancienne pourrait changer ce détail interne, auquel cas
    afficher "propriétés indisponibles" côté UI est préférable à un
    crash de tout l'onglet Propriétés."""
    try:
        env_vars = opts_from_options.get("env") or {}
        morceaux = sorted(
            (
                (int(cle.rsplit("_", 1)[1]), valeur)
                for cle, valeur in env_vars.items()
                if cle.startswith("CAMOU_CONFIG_")
            ),
            key=lambda t: t[0],
        )
        if not morceaux:
            return {}
        config_str = "".join(valeur for _, valeur in morceaux)
        config = json.loads(config_str)
        return config if isinstance(config, dict) else {}
    except (ValueError, TypeError, AttributeError):
        return {}


# PATCH (retour utilisateur explicite : "je veux juste le pays et le
# drapeau") -- DELEGATE_ROLE_PAYS (cf. plus haut) ne transporte qu'un
# code ISO 3166-1 alpha-2 (ex: "FR", "GB" -- cf. countryCode fourni par
# ip-api.com dans WorkerTestProxy), jamais le nom complet du pays.
#
# CORRECTIF (retour utilisateur explicite : "le nom du pays, es ce que on
# peu resoudre ce probleme avec pycountry ?") -- cette table codée en dur
# ne couvrait qu'environ 70 pays (les plus courants pour des proxys
# résidentiels/datacenter à l'origine) : tout code absent (ex: "PE"
# Pérou, "KE" Kenya, "IQ" Irak...) retombait sur le code brut affiché tel
# quel ("Connecté • PE" au lieu de "Connecté • Pérou"). Résolu via babel
# (cf. NOMS_PAYS_BABEL_DISPONIBLE/_LOCALE_PAYS_FR tout en haut de ce
# fichier), qui couvre ~250 codes EN FRANÇAIS directement -- cf.
# _nom_pays_depuis_code ci-dessous, qui l'utilise désormais en PREMIER.
# Cette table est CONSERVÉE comme repli ultime (si babel n'est pas
# installé sur la machine cible, cf. convention défensive numpy/cv2/
# websockets en tête de fichier) -- jamais d'exception ni de régression
# pour un champ de présentation, peu importe l'environnement.
_NOMS_PAYS_ISO_ALPHA2 = {
    "FR": "France", "GB": "Royaume-Uni", "US": "États-Unis", "DE": "Allemagne",
    "ES": "Espagne", "IT": "Italie", "PT": "Portugal", "NL": "Pays-Bas",
