# PATCH sortie de logs PAR PROFIL (demande utilisateur : "un bouton par profil qui
# permet d'activer ou désactiver sa sortie d'exécution, on ne bloque plus tout
# depuis le notebook de lancement"). L'exécuteur d'un profil est un process séparé :
# l'état est donc un petit fichier-drapeau (dossier temporaire, un fichier par
# instance_id) écrit par le process principal du sAutoniax et relu par l'exécuteur.
#   "1" = sortie COUPÉE pour cette instance ; "0" = sortie ACTIVE pour cette
#   instance même si le notebook a posé AUTONIAX_SILENCIEUX=1 ; absent = on suit
#   AUTONIAX_SILENCIEUX comme avant (comportement inchangé sans clic sur le bouton).
_DOSSIER_DRAPEAUX_LOGS = os.path.join(tempfile.gettempdir(), "autoniax_sortie_logs")
_CACHE_DRAPEAUX_LOGS: dict = {}
# Côté PILOTE : instance_id dont la sortie a été explicitement ACTIVÉE (tout le reste est coupé par défaut).
# Module-level : partagé entre l'onglet Instances et le panneau de clone.
_INSTANCES_LOGS_ACTIVES_PILOTE: set = set()


def _chemin_drapeau_logs(instance_id: str) -> str:
    sur = re.sub(r"[^A-Za-z0-9_.-]", "_", str(instance_id or ""))[:120]
    return os.path.join(_DOSSIER_DRAPEAUX_LOGS, sur or "_")


def _sortie_logs_coupee(instance_id: str = "") -> bool:
    """True si la sortie de logs de CETTE instance est coupée. Ne lève jamais."""
    if instance_id:
        maintenant = time.monotonic()
        en_cache = _CACHE_DRAPEAUX_LOGS.get(instance_id)
        if en_cache is not None and maintenant - en_cache[0] < 1.0:
            valeur = en_cache[1]
        else:
            try:
                with open(_chemin_drapeau_logs(instance_id), encoding="utf-8") as f:
                    valeur = f.read().strip()
            except Exception:
                valeur = ""
            _CACHE_DRAPEAUX_LOGS[instance_id] = (maintenant, valeur)
        if valeur == "1":
            return True
        if valeur == "0":
            return False
    # PATCH : PAR DÉFAUT toute sortie de logs est COUPÉE. Seul un drapeau explicite de l'instance
    # (bouton du profil / bouton « Forcer » du panneau clone) la réactive. AUTONIAX_SILENCIEUX du notebook
    # n'est plus nécessaire ; AUTONIAX_LOGS_PAR_DEFAUT=1 rétablit l'ancien défaut « sortie active ».
    return os.environ.get("AUTONIAX_LOGS_PAR_DEFAUT", "0") != "1"


_VERROU_JOURNAL_INSTANCE = threading.Lock()
_JOURNAL_MAX_OCTETS = 2_000_000
_JOURNAL_LIGNES_GARDEES = 5000


def _chemin_journal_instance(instance_id: str) -> str:
    return _chemin_drapeau_logs(instance_id) + ".journal"


def _journal_instance_ajouter(instance_id: str, texte: str) -> None:
    """Ajoute des lignes (horodatées) au journal de l'instance, même si la sortie est
    coupée -- c'est ce qui permet de copier le journal d'un profil silencieux. Ne lève jamais."""
    try:
        lignes = [ligne for ligne in str(texte).splitlines() if ligne.strip()]
        if not lignes or not instance_id:
            return
        horodatage = time.strftime("%H:%M:%S")
        with _VERROU_JOURNAL_INSTANCE:
            os.makedirs(_DOSSIER_DRAPEAUX_LOGS, exist_ok=True)
            chemin = _chemin_journal_instance(instance_id)
            with open(chemin, "a", encoding="utf-8", errors="replace") as f:
                for ligne in lignes:
                    f.write(f"[{horodatage}] {ligne[:4000]}\n")
            if os.path.getsize(chemin) > _JOURNAL_MAX_OCTETS:
                with open(chemin, encoding="utf-8", errors="replace") as f:
                    gardees = f.readlines()[-_JOURNAL_LIGNES_GARDEES:]
                with open(chemin, "w", encoding="utf-8") as f:
                    f.writelines(gardees)
    except Exception:
        pass


def _journal_instance_dernieres_lignes(instance_id: str, nombre: int):
    """(dernières `nombre` lignes, total de lignes lues) ; ([], 0) si aucun journal."""
    try:
        with _VERROU_JOURNAL_INSTANCE:
            with open(_chemin_journal_instance(instance_id), encoding="utf-8", errors="replace") as f:
                lignes = [ligne.rstrip("\n") for ligne in f.readlines()]
    except Exception:
        return [], 0
    return lignes[-max(1, int(nombre)):], len(lignes)


def _definir_sortie_logs_instance(instance_id: str, coupee: bool) -> bool:
    """Écrit le drapeau de l'instance. True si réussi. Ne lève jamais."""
    try:
        os.makedirs(_DOSSIER_DRAPEAUX_LOGS, exist_ok=True)
        limite = time.time() - 86400  # purge des drapeaux de plus d'un jour (anciennes sessions)
        for nom in os.listdir(_DOSSIER_DRAPEAUX_LOGS):
            chemin = os.path.join(_DOSSIER_DRAPEAUX_LOGS, nom)
            try:
                if os.path.getmtime(chemin) < limite:
                    os.remove(chemin)
            except Exception:
                pass
        with open(_chemin_drapeau_logs(instance_id), "w", encoding="utf-8") as f:
            f.write("1" if coupee else "0")
        _CACHE_DRAPEAUX_LOGS.pop(instance_id, None)
        return True
    except Exception:
        return False

