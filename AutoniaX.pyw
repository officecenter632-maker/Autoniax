    def _construire_sous_onglet_gabarit(self, conteneur: QWidget):
        """Sous-onglet "Gabarit" (AJOUT, demande explicite utilisateur :
        "ajouter un sous onglet qui vas juste contenir les donnee du
        gabarit, comme sa on pourra copier facilement pour une prochaine
        edition") -- PUREMENT en lecture, aucun champ éditable (contraire-
        ment à Général/Filtre/Zone) : sert uniquement à exposer
        composant_layout.to_dict() en JSON lisible et copiable en un clic,
        pour pouvoir le coller ailleurs (analyse, debug, sauvegarde
        manuelle avant expérimentation) sans devoir ouvrir project.json à
        la main et y retrouver le bon ComposantLayout dans la liste.

        Contenu = to_dict() complet (nom, service_api_nom, image_
        reference, code_filtre, zones, couleurs) -- pas un sous-ensemble :
        c'est la même sérialisation que celle utilisée par project.save,
        donc ce qui est copié ici peut être recollé tel quel dans le JSON
        du projet pour reconstituer ce ComposantLayout à l'identique.

        Régénéré à CHAQUE affichage de l'onglet (cf. _sur_changement_
        sous_onglet, modifié pour appeler _rafraichir_onglet_gabarit)
        plutôt qu'une seule fois à la construction -- reflète donc
        toujours l'état courant même après des changements faits dans
        Général/Filtre/Zone pendant la même session, sans action manuelle
        de rafraîchissement."""
        layout = QVBoxLayout(conteneur)
        layout.setContentsMargins(0, 12, 0, 0)
        layout.setSpacing(8)

        bouton_copier_gabarit = self._bouton_copier(
            lambda: self.gabarit_json_edit.toPlainText(), conteneur, "Copier les données du gabarit"
        )
        # AJOUT (demande explicite utilisateur : "je veux aussi que on
        # puisse editer donc appuyer sur coller, par ce que les IA vont
        # souvent traiter ça") -- contrairement au reste de l'onglet
        # (lecture seule), coller REMPLACE les champs de composant_layout
        # par le contenu du presse-papier, pour permettre un aller-retour
        # complet : copier -> faire éditer/générer par une IA externe ->
        # recoller le résultat sans repasser par Général/Filtre/Zone un
        # par un. Cf. _coller_donnees_gabarit pour le détail (validation,
        # champs exclus, rafraîchissement des 3 autres sous-onglets).
        bouton_coller_gabarit = self._bouton_coller(
            lambda t: self._coller_donnees_gabarit(t), conteneur, "Coller et appliquer un JSON de gabarit"
        )
        layout.addLayout(
            self._ligne_section_avec_actions(
                "DONNÉES DU GABARIT (JSON)", conteneur, bouton_copier_gabarit, bouton_coller_gabarit
            )
        )

        aide_gabarit = QLabel(
            "Représentation complète de ce ComposantLayout (zones, filtre, "
            "couleurs). Copiez pour réutiliser ailleurs, ou collez "
            "un JSON du même format pour l'appliquer directement ici (le "
            "nom n'est PAS repris par le collage, à modifier dans Général "
            "si besoin).",
            conteneur,
        )
        aide_gabarit.setWordWrap(True)
        aide_gabarit.setObjectName("ReglagesHintLabel")
        layout.addWidget(aide_gabarit)

        self.gabarit_erreur_label = QLabel("", conteneur)
        self.gabarit_erreur_label.setWordWrap(True)
        self.gabarit_erreur_label.setStyleSheet(f"color: {Mocha.red};")
        self.gabarit_erreur_label.hide()
        layout.addWidget(self.gabarit_erreur_label)

        self.gabarit_confirmation_label = QLabel("", conteneur)
        self.gabarit_confirmation_label.setStyleSheet(f"color: {Mocha.green};")
        self.gabarit_confirmation_label.hide()
        layout.addWidget(self.gabarit_confirmation_label)

        self.gabarit_json_edit = QPlainTextEdit(conteneur)
        self.gabarit_json_edit.setObjectName("CodeFiltreEdit")
        self.gabarit_json_edit.setReadOnly(True)
        self.gabarit_json_edit.setLineWrapMode(QPlainTextEdit.NoWrap)
        layout.addWidget(self.gabarit_json_edit, 1)

        self._rafraichir_onglet_gabarit()

    def _coller_donnees_gabarit(self, texte: str):
        """Bouton "Coller" du sous-onglet Gabarit -- cf. docstring de
        _construire_sous_onglet_gabarit pour le contexte (demande
        explicite : permettre à une IA externe de régénérer le JSON puis
        de le recoller directement, sans passer champ par champ dans
        Général/Filtre/Zone).

        Parse `texte` en JSON puis DÉLÈGUE à ComposantLayout.from_dict
        (même parsing/mêmes défauts de rétrocompatibilité que le
        chargement d'un project.json -- un champ manquant dans le JSON
        collé retombe donc sur un défaut sûr plutôt que de planter, cf.
        sa docstring) pour obtenir un ComposantLayout "propre", puis copie
        CHAMP PAR CHAMP dans self.composant_layout -- jamais un remplace-
        ment de l'objet lui-même : self.composant_layout est référencé
        ailleurs (grille de ComposantsLayoutScreen, TestComposantScreen
        si un test est ouvert dans un autre onglet) et le remplacer
        casserait ces références.

        EXCLUSION VOLONTAIRE de 2 champs, contrairement à un from_dict
        générique :
        - `nom` : renommer un cL a des effets de bord (fichier image sur
          disque, entrée dans service_api.composants_layout, cf. Project.
          rename_composant_layout) qu'une simple mutation de champ ne
          fait PAS -- appliquer un nom différent ici sans passer par ce
          chemin dédié casserait la cohérence du projet. Un JSON collé
          avec un nom différent n'est donc PAS un renommage : le nom
          affiché reste celui du cL actuellement ouvert.
        - `service_api_nom` / `image_reference` : identifient le cL et son
          image de référence sur disque -- copier ces champs depuis un
          JSON externe (ex: collé depuis un AUTRE cL) ferait pointer ce
          cL vers l'image d'un autre, incohérence silencieuse. Non repris
          pour la même raison que `nom`.

        Tous les AUTRES champs (zones, code_filtre, code_scindement,
        couleur_zone, couleur_zone_selectionnee, epaisseur_zone) sont
        appliqués tels quels, puis composant_layout_modifie.emit()
        (persistance disque, même mécanisme que Save sur le filtre) et
        les sous-onglets sont resynchronisés pour refléter immédiatement
        le contenu collé sans devoir rouvrir l'écran."""
        self.gabarit_erreur_label.hide()
        self.gabarit_confirmation_label.hide()
        try:
            d = json.loads(texte)
        except Exception as e:
            self.gabarit_erreur_label.setText(f"JSON invalide : {e}")
            self.gabarit_erreur_label.show()
            return
        if not isinstance(d, dict):
            self.gabarit_erreur_label.setText("Le JSON collé doit être un objet (dict), pas une liste ou une valeur simple.")
            self.gabarit_erreur_label.show()
            return

        try:
            cl_colle = ComposantLayout.from_dict(d)
        except Exception as e:
            self.gabarit_erreur_label.setText(f"Impossible d'interpréter ce JSON comme un gabarit : {e}")
            self.gabarit_erreur_label.show()
            return

        # Copie champ par champ -- cf. docstring ci-dessus pour les 3
        # champs volontairement exclus (nom, service_api_nom, image_
        # reference).
        self.composant_layout.zones = cl_colle.zones
        self.composant_layout.code_filtre = cl_colle.code_filtre
        # AJOUT (code_scindement, même traitement que code_filtre juste
        # au-dessus -- champ ajouté après coup, doit suivre le même
        # chemin de copie/resynchronisation, pas seulement to_dict/
        # from_dict).
        self.composant_layout.code_scindement = cl_colle.code_scindement
        self.composant_layout.couleur_fond = cl_colle.couleur_fond
        self.composant_layout.couleur_zone = cl_colle.couleur_zone
        self.composant_layout.couleur_zone_selectionnee = cl_colle.couleur_zone_selectionnee
        self.composant_layout.epaisseur_zone = cl_colle.epaisseur_zone

        self.composant_layout_modifie.emit()

        # Resynchronise les widgets des 3 AUTRES sous-onglets (construits
        # une seule fois à l'ouverture de l'écran, cf. __init__ -- ils ne
        # se reconstruisent pas tout seuls) pour que ce qui vient d'être
        # collé soit visible immédiatement partout, pas seulement dans
        # composant_layout en mémoire. blockSignals sur chaque widget
        # pour éviter que le setValue déclenche son propre slot _sur_xxx_
        # change, qui réécrirait une valeur déjà à jour et re-émettrait
        # composant_layout_modifie inutilement (même précaution que
        # ComposantLayoutReglagesNumeriquesPanel.definir_composant_layout
        # plus haut dans ce fichier).
        # RETRAIT (REFONTE) : plus de seuil_confiance_spin/delta_conflit_
        # spin à resynchroniser ici, ces widgets n'existent plus (cf.
        # _construire_sous_onglet_general).
        self.couleur_zone_bouton.definir_couleur(self.composant_layout.couleur_zone)
        self.couleur_zone_selectionnee_bouton.definir_couleur(self.composant_layout.couleur_zone_selectionnee)

        self.epaisseur_zone_spin.blockSignals(True)
        self.epaisseur_zone_spin.setValue(self.composant_layout.epaisseur_zone)
        self.epaisseur_zone_spin.blockSignals(False)

        self.code_filtre_edit.setPlainText(self.composant_layout.code_filtre)
        self.filtre_erreur_label.hide()

        # AJOUT (miroir du bloc filtre juste au-dessus)
        self.code_scindement_edit.setPlainText(self.composant_layout.code_scindement)
        self.scindement_erreur_label.hide()

        self._rafraichir_grille_zones()
        self._rafraichir_apercu_zones_nommees()
        self._rafraichir_panneau_zone()
        self._rafraichir_affichage_image()
        self._rafraichir_onglet_gabarit()

        self.gabarit_confirmation_label.setText(
            "Gabarit appliqué (zones, filtre, seuils, couleurs) -- le nom n'a pas été modifié."
        )
        self.gabarit_confirmation_label.show()
        QTimer.singleShot(2500, self.gabarit_confirmation_label.hide)

    def _rafraichir_onglet_gabarit(self):
        """Recharge self.gabarit_json_edit depuis composant_layout.
        to_dict() -- cf. docstring de _construire_sous_onglet_gabarit.
        json.dumps avec ensure_ascii=False (les noms de Zone/le code
        filtre peuvent contenir des accents, pas de raison de les
        échapper en \\uXXXX pour un texte destiné à être relu par un
        humain) et indent=2 pour rester lisible tel quel."""
        try:
            texte = json.dumps(self.composant_layout.to_dict(), ensure_ascii=False, indent=2)
        except Exception as e:
            texte = f"# Erreur lors de la génération du JSON : {e}"
        self.gabarit_json_edit.setPlainText(texte)

    def _construire_sous_onglet_donnees_test(self, conteneur: QWidget):
        """Sous-onglet "Données de test" (AJOUT, demande explicite
        utilisateur : "je pense que ça serait bien si on pouvait
        sauvegarder des images pour les tests, parce qu'on doit
        effectuer le test sur plusieurs cas avant de valider, et ça
        devient précieux de garder certaines images ... on va juste
        glisser des images dans son onglet pour que ça s'ajoute").

        Simple LISTE de noms de fichiers avec bouton supprimer à côté
        (demande explicite -- PAS une grille de vignettes comme "Zone" :
        "simple liste de nom de fichier avec le bouton de suppression à
        côté"), pas d'aperçu miniature ni de tri particulier.

        Stockage : cf. get_composant_layout_tests_dir -- components/
        <ServiceAPI>/<nom_court>_tests/, DANS le même dossier que l'image
        de référence (revenu sur un premier jet avec un dossier séparé
        "test_data/", demande explicite : "est-ce que ça serait beaucoup
        plus simple de mettre dans le même dossier ? si oui fait le" --
        hérite ainsi du renommage/déplacement/suppression déjà gérés pour
        components/<ServiceAPI>/, cf. rename_composant_layout et remove_
        service_api).

        Ces images sont ensuite rejouables dans TestComposantScreen via
        des flèches < > (cf. sa docstring, capture_001.png à l'appui --
        même demande, "uniquement si des images de test existent pour ce
        cL sinon rien de nouveau")."""
        layout = QVBoxLayout(conteneur)
        layout.setContentsMargins(0, 12, 0, 0)
        layout.setSpacing(10)

        # AJOUT (demande explicite utilisateur : "je veux que tu met un
        # bouton qui vas permettre de copier tout les image dans le
        # presse papier ... les images de test") -- en-tête avec le
        # bouton "Copier toutes les images" à droite, MÊME PATTERN que
        # ApercuDragHandle._sur_clic (cf. sa docstring détaillée sur le
        # choix CF_HDROP/QMimeData.setUrls plutôt que setImage : "QClipboard
        # ne sait coller qu'UNE seule image bitmap à la fois -- une liste
        # de fichiers est le seul mécanisme presse-papier standard qui
        # transporte plusieurs images en un seul Ctrl+V") -- directement
        # les fichiers DÉJÀ sur disque (get_composant_layout_tests_dir),
        # aucune réencodage/copie temporaire nécessaire ici contrairement
        # à ApercuDragHandle (qui part d'un QPixmap en mémoire, pas d'un
        # fichier déjà présent).
        entete_donnees_test = QHBoxLayout()
        entete_donnees_test.addWidget(self._section_label("DONNÉES DE TEST", conteneur))
        entete_donnees_test.addStretch(1)
        self._bouton_copier_toutes_images_test = QToolButton(conteneur)
        self._bouton_copier_toutes_images_test.setIcon(qta.icon("mdi6.content-copy", color=Mocha.subtext0))
        self._bouton_copier_toutes_images_test.setToolTip(
            "Copier toutes les images de test dans le presse-papier (Ctrl+V pour coller)"
        )
        self._bouton_copier_toutes_images_test.setCursor(Qt.PointingHandCursor)
        self._bouton_copier_toutes_images_test.setAutoRaise(True)
        self._bouton_copier_toutes_images_test.clicked.connect(self._copier_toutes_images_donnees_test)
        entete_donnees_test.addWidget(self._bouton_copier_toutes_images_test)
        layout.addLayout(entete_donnees_test)

        aide = QLabel(
            "Glissez une ou plusieurs images ici pour les conserver comme "
            "cas de test pour ce ComposantLayout. Elles seront ensuite "
            "accessibles en navigant avec les flèches ‹ › dans l'écran de "
            "test, sans avoir à les redéposer à chaque fois.",
            conteneur,
        )
        aide.setWordWrap(True)
        aide.setObjectName("ReglagesHintLabel")
        layout.addWidget(aide)

        # Zone de drop -- QFrame dédié avec sa propre bordure en pointillé
        # (cf. objectName "ZoneDeposeImageTest", à ajouter dans la feuille
        # de style globale), plutôt que le conteneur entier : évite de
        # confondre visuellement toute la zone de liste (qui accepte AUSSI
        # le drop, cf. eventFilter ci-dessous -- l'un ou l'autre suffit)
        # avec une simple zone de texte d'aide.
        self._zone_drop_test = QFrame(conteneur)
        self._zone_drop_test.setObjectName("ZoneDeposeImageTest")
        self._zone_drop_test.setAcceptDrops(True)
        self._zone_drop_test.installEventFilter(self)
        zone_drop_layout = QVBoxLayout(self._zone_drop_test)
        zone_drop_layout.setContentsMargins(16, 16, 16, 16)
        label_drop = QLabel("Glissez des images ici (.png, .jpg, .webp…)", self._zone_drop_test)
        label_drop.setAlignment(Qt.AlignCenter)
        label_drop.setObjectName("ReglagesHintLabel")
        zone_drop_layout.addWidget(label_drop)
        self._zone_drop_test.setFixedHeight(70)
        layout.addWidget(self._zone_drop_test)

        self.donnees_test_erreur_label = QLabel("", conteneur)
        self.donnees_test_erreur_label.setWordWrap(True)
        self.donnees_test_erreur_label.setStyleSheet(f"color: {Mocha.red};")
        self.donnees_test_erreur_label.hide()
        layout.addWidget(self.donnees_test_erreur_label)

        # Liste -- scrollable, un widget hôte par ligne (nom de fichier +
        # bouton supprimer), reconstruite entièrement à chaque changement
        # (cf. _rafraichir_liste_donnees_test) -- même principe que
        # _rafraichir_grille_zones, la liste reste de taille raisonnable.
        scroll_liste = QScrollArea(conteneur)
        scroll_liste.setWidgetResizable(True)
        scroll_liste.setFrameShape(QFrame.NoFrame)
        scroll_liste.setHorizontalScrollBarPolicy(Qt.ScrollBarAlwaysOff)
        contenu_liste = QWidget(scroll_liste)
        self._liste_donnees_test_layout = QVBoxLayout(contenu_liste)
        self._liste_donnees_test_layout.setContentsMargins(0, 0, 0, 0)
        self._liste_donnees_test_layout.setSpacing(4)
        self._liste_donnees_test_layout.addStretch(1)
        scroll_liste.setWidget(contenu_liste)
        layout.addWidget(scroll_liste, 1)

        self._rafraichir_liste_donnees_test()

    def _rafraichir_liste_donnees_test(self):
        """Reconstruit la liste depuis le contenu RÉEL du dossier disque
        (get_composant_layout_tests_dir), pas depuis un champ en mémoire
        sur composant_layout -- ces images ne sont PAS un champ de la
        dataclass ComposantLayout (contrairement à zones/code_filtre) :
        le dossier lui-même EST la source de vérité, aucune entrée dans
        project.json à maintenir en double pour la liste des fichiers."""
        while self._liste_donnees_test_layout.count() > 1:  # garde le addStretch final
            item = self._liste_donnees_test_layout.takeAt(0)
            w = item.widget()
            if w is not None:
                w.deleteLater()

        dossier = get_composant_layout_tests_dir(self.composant_layout)
        fichiers = sorted(
            [p for p in dossier.iterdir() if p.is_file() and p.suffix.lower() in EXTENSIONS_IMAGE_ACCEPTEES],
            key=lambda p: p.name.lower(),
        )
        for chemin in fichiers:
            ligne = QWidget()
            ligne_layout = QHBoxLayout(ligne)
            ligne_layout.setContentsMargins(4, 4, 4, 4)
            ligne_layout.setSpacing(8)

            label_nom = QLabel(chemin.name, ligne)
            label_nom.setObjectName("ReglagesLabel")
            ligne_layout.addWidget(label_nom, 1)

            bouton_supprimer = QToolButton(ligne)
            bouton_supprimer.setIcon(qta.icon("mdi6.delete-outline", color=Mocha.red))
            bouton_supprimer.setToolTip("Supprimer cette image de test")
            bouton_supprimer.setCursor(Qt.PointingHandCursor)
            bouton_supprimer.setAutoRaise(True)
            bouton_supprimer.clicked.connect(
                lambda checked=False, c=chemin: self._supprimer_image_donnees_test(c)
            )
            ligne_layout.addWidget(bouton_supprimer, 0)

            self._liste_donnees_test_layout.insertWidget(self._liste_donnees_test_layout.count() - 1, ligne)

    def _copier_toutes_images_donnees_test(self):
        """AJOUT (demande explicite utilisateur : "un bouton qui vas
        permettre de copier tout les image dans le presse papier ... les
        images de test") -- copie TOUTES les images actuellement listées
        (contenu réel du dossier disque, cf. get_composant_layout_tests_dir
        -- même source de vérité que _rafraichir_liste_donnees_test, pas
        une sélection partielle) en une seule fois dans le presse-papier
        système, sous forme de liste de fichiers (CF_HDROP).

        CORRECTIF (retour utilisateur : "je veux que tu fais à ce que ce
        bouton de copie copie non seulement tout les image mais aussi
        l'image du composantlayout") -- inclut EN PLUS l'image de
        référence du ComposantLayout (composant_layout.image_reference,
        résolue en absolu via get_app_data_dir(), MÊME pattern que
        partout ailleurs dans ce fichier -- cf. par ex. _apercu_pixmap_
        depuis_disque/rename_composant_layout), PLACÉE EN PREMIER dans la
        liste (avant les images de test elles-mêmes) : c'est l'image
        "source"/gabarit du cL, il est plus naturel qu'elle arrive en
        tête d'un collage groupé plutôt que mélangée arbitrairement parmi
        les cas de test. Ignorée silencieusement si absente ou si le
        fichier n'existe plus sur disque (composant_layout pas encore
        configuré, ou image supprimée/déplacée hors de l'app) -- ne
        bloque jamais la copie des images de test elles-mêmes pour
        autant.

        MÊME MÉCANISME que ApercuDragHandle._sur_clic (cf. sa docstring) :
        QMimeData.setUrls([...]) + QGuiApplication.clipboard().setMimeData
        -- PAS QClipboard.setImage/setPixmap, qui ne transporte qu'UNE
        seule image bitmap à la fois et ne conviendrait donc pas ici où
        il peut y avoir plusieurs images de test. Un Ctrl+V dans
        l'Explorateur (ou toute appli acceptant un collage de fichiers)
        colle alors l'ensemble des images d'un coup, exactement comme un
        Ctrl+C de sélection multiple de fichiers.

        Si AUCUNE image (ni référence, ni test) n'est disponible, ne
        touche PAS au presse-papier existant (pas de mime vide qui
        écraserait silencieusement un copier-coller en cours de
        l'utilisateur pour autre chose) -- affiche seulement un message
        dans donnees_test_erreur_label, réutilisant le même label que les
        erreurs de copie/suppression ci-dessus plutôt que d'en introduire
        un second."""
        dossier = get_composant_layout_tests_dir(self.composant_layout)
        fichiers = sorted(
            [p for p in dossier.iterdir() if p.is_file() and p.suffix.lower() in EXTENSIONS_IMAGE_ACCEPTEES],
            key=lambda p: p.name.lower(),
        )

        # Image de référence du cL EN PLUS des images de test (cf.
        # docstring ci-dessus) -- résolue en absolu, vérifiée présente
        # sur disque, et dédupliquée par chemin résolu au cas où elle
        # pointerait (situation anormale) vers un fichier déjà présent
        # dans le dossier de tests, pour ne jamais la lister deux fois.
        chemin_reference = None
        if self.composant_layout.image_reference:
            candidat = (get_app_data_dir() / self.composant_layout.image_reference).resolve()
            if candidat.is_file():
                chemin_reference = candidat
        fichiers_resolus = [p.resolve() for p in fichiers]
        if chemin_reference is not None and chemin_reference not in fichiers_resolus:
            tous_les_fichiers = [chemin_reference] + fichiers
        else:
            tous_les_fichiers = fichiers

        if not tous_les_fichiers:
            self.donnees_test_erreur_label.setText("Aucune image de test à copier pour le moment.")
            self.donnees_test_erreur_label.show()
            return

        mime = QMimeData()
        mime.setUrls([QUrl.fromLocalFile(str(chemin)) for chemin in tous_les_fichiers])
        QGuiApplication.clipboard().setMimeData(mime)
        self.donnees_test_erreur_label.hide()

        # Même feedback visuel que _bouton_copier (icône -> check vert
        # temporaire, restaurée après 1200ms) -- cohérent avec le seul
        # autre bouton "copier" de cet écran plutôt qu'un style inédit.
        self._bouton_copier_toutes_images_test.setIcon(qta.icon("mdi6.check", color=Mocha.green))
        QTimer.singleShot(
            1200,
            lambda: self._bouton_copier_toutes_images_test.setIcon(
                qta.icon("mdi6.content-copy", color=Mocha.subtext0)
            ),
        )

    def _ajouter_images_donnees_test(self, chemins: list):
        """Copie chaque chemin source vers get_composant_layout_tests_dir
        -- copie, jamais un déplacement : le fichier glissé peut provenir
        de n'importe où sur le disque de l'utilisateur (ex: son dossier
        Téléchargements), le déplacer serait une surprise destructive.
        En cas de collision de nom (même fichier déposé deux fois, ou
        deux fichiers sources de même nom), suffixe numérique croissant
        -- jamais d'écrasement silencieux d'une image de test déjà là."""
        dossier = get_composant_layout_tests_dir(self.composant_layout)
        erreurs = []
        for chemin_str in chemins:
            source = Path(chemin_str)
            if not source.is_file() or source.suffix.lower() not in EXTENSIONS_IMAGE_ACCEPTEES:
                continue
            dest = dossier / source.name
            if dest.exists():
                i = 1
                while (dossier / f"{source.stem}_{i}{source.suffix}").exists():
                    i += 1
                dest = dossier / f"{source.stem}_{i}{source.suffix}"
            try:
                shutil.copy2(source, dest)
            except Exception as e:
                erreurs.append(f"{source.name} : {e}")

        if erreurs:
            self.donnees_test_erreur_label.setText("Erreur lors de la copie -- " + " ; ".join(erreurs))
            self.donnees_test_erreur_label.show()
        else:
            self.donnees_test_erreur_label.hide()
        self._rafraichir_liste_donnees_test()

    def _supprimer_image_donnees_test(self, chemin: Path):
        """Bouton supprimer d'une ligne -- suppression DIRECTE (même
        contrat que le reste de cet écran, cf. bouton_supprimer_forme :
        "suppression DIRECTE, pas de confirmation"), pas de corbeille ici
        contrairement aux images de RÉFÉRENCE (cf. _deplacer_dossier_vers_
        corbeille) -- ce ne sont que des copies de confort pour rejouer un
        test, jamais la seule copie d'un contenu important."""
        try:
            chemin.unlink(missing_ok=True)
        except Exception as e:
            self.donnees_test_erreur_label.setText(f"Impossible de supprimer {chemin.name} : {e}")
            self.donnees_test_erreur_label.show()
        self._rafraichir_liste_donnees_test()

    def _construire_sous_onglet_zones(self, conteneur: QWidget):
        """AJOUT (REFONTE COMPLÈTE -- ancienne ZoneForme puis Forme, cf.
        docstring de la dataclass Zone) -- sous-onglet "Zone" : GRILLE de
        cards cliquables (ZoneCarte, une par Zone du ComposantLayout),
        remplace l'ancienne QListWidget + bouton "Tracer une zone" ici
        (demande explicite : "il ne doit pas y avoir le bouton de tracer
        directement dans l'onglet, il doit juste y avoir un bouton +").

        Cliquer une card ouvre ses propriétés dans le panneau de droite
        (nom éditable + bouton Tracer/Mettre à jour + rectangle), cf.
        _sur_carte_zone_cliquee/_rafraichir_panneau_zone/
        _construire_panneau_zone -- le tracé lui-même n'est plus déclenché
        depuis CE sous-onglet, mais depuis le panneau, sur la Zone
        actuellement sélectionnée (cf. _sur_toggle_mode_trace_zone)."""
        layout = QVBoxLayout(conteneur)
        layout.setContentsMargins(0, 12, 0, 0)
        layout.setSpacing(12)

        entete = QHBoxLayout()
        entete.addWidget(self._section_label("ZONES", conteneur))
        entete.addStretch(1)
        # REFONTE (demande explicite, capture_002.png) : le bouton "+" isolé
        # ici (entete.addWidget(self.bouton_ajouter_zone)) est RETIRÉ -- il
        # devient un item de la grille elle-même (ZoneCarteAjout, ajouté en
        # dernier dans _rafraichir_grille_zones), donc dans la même rangée
        # que les ZoneCarte plutôt qu'au-dessus dans une ligne séparée.
        layout.addLayout(entete)

        info_zones = QLabel(
            "Cliquez « + » pour créer une Zone, puis sélectionnez-la "
            "ci-dessous pour la nommer, la tracer et la configurer à "
            "droite.",
            conteneur,
        )
        info_zones.setWordWrap(True)
        info_zones.setObjectName("ReglagesHintLabel")
        layout.addWidget(info_zones)

        self._grille_zones_scroll = QScrollArea(conteneur)
        self._grille_zones_scroll.setObjectName("GrilleZonesScroll")
        self._grille_zones_scroll.setWidgetResizable(True)
        self._grille_zones_scroll.setFrameShape(QFrame.NoFrame)
        self._grille_zones_scroll.setHorizontalScrollBarPolicy(Qt.ScrollBarAlwaysOff)
        self._grille_zones = FlowGrid(item_width=168, spacing=10)
        self._grille_zones_scroll.setWidget(self._grille_zones)
        layout.addWidget(self._grille_zones_scroll, 1)

        self._zone_cartes: dict = {}  # nom -> ZoneCarte, cf. _rafraichir_grille_zones

    def _nom_zone_disponible(self, base: str = "NouvelleZone") -> str:
        """Trouve un nom de Zone unique DANS CE ComposantLayout (portée
        pertinente : Zone.nom n'a besoin d'être unique que parmi les
        Zone d'un même cL, cf. InstanceLayoutDetectee/videoTemplateItems.
        nom_zone -- deux cL différents ont chacun leur propre liste
        composant_layout.zones, indépendante, donc aucun risque de
        collision entre cL, pas besoin d'un espace de noms plus large).
        Même convention que _nom_court_disponible (Base, Base2, Base3...).

        AJOUT (REFONTE, cf. SPEC_refonte_filtre_zones_dynamiques.md,
        "espace de noms partagé") : évite aussi les noms actuellement
        utilisés par une zone DYNAMIQUE (self._dernieres_zones_filtre,
        dernier résultat du filtre) -- même portée que le renommage
        manuel (cf. _sur_nom_zone_selectionnee_change), pour qu'un clic
        sur "+" ne puisse jamais créer de collision silencieuse."""
        noms_existants = {z.nom for z in self.composant_layout.zones} | set(self._dernieres_zones_filtre)
        candidat = base
        i = 1
        while candidat in noms_existants:
            i += 1
            candidat = f"{base}{i}"
        return candidat

    def _creer_zone_avec_nom_auto(self):
        """Bouton "+" (demande explicite : "un bouton + que lorsque on
        crée sa crée") -- crée immédiatement une Zone avec un nom par
        défaut unique et un rectangle vide (jamais tracée), sélectionnée
        aussitôt dans le panneau de droite pour que l'utilisateur puisse
        la renommer et/ou la tracer sans dialogue intermédiaire."""
        nom = self._nom_zone_disponible()
        self.composant_layout.zones.append(Zone(nom=nom, rect=ZoneClicRect()))
        self.composant_layout_modifie.emit()
        self._nom_zone_selectionnee = nom
        self._rafraichir_grille_zones()
        self._rafraichir_apercu_zones_nommees()
        self._rafraichir_panneau_zone()

    def _rafraichir_grille_zones(self):
        """Reconstruit la grille de ZoneCarte depuis composant_layout.zones
        -- reconstruction complète (comme ServiceAPIScreen._reload_grille)
        plutôt qu'un diff incrémental, la liste de Zone reste petite.

        REFONTE (demande explicite, capture_002.png) : la tuile "+ Ajouter"
        (ZoneCarteAjout) est ajoutée en DERNIER item, dans la même FlowGrid
        que les ZoneCarte -- remplace l'ancien bouton_ajouter_zone isolé
        dans l'en-tête (cf. _construire_sous_onglet_zones).

        AJOUT (demande explicite utilisateur : personnaliser la zone de
        clic d'une zone DYNAMIQUE, "les deux ensemble mélangées dans une
        seule grille") -- après les ZoneCarte (statiques), une
        ZoneDynamiqueCarte par entrée de self._dernieres_zones_filtre
        (dernier résultat du filtre exécuté, cf. _appliquer_filtre) est
        ajoutée dans CETTE MÊME grille, avant la tuile "+ Ajouter" (qui ne
        concerne que la création d'une Zone statique, donc reste en tout
        dernier). self._dernieres_zones_filtre étant volatile (recalculé
        à chaque exécution du filtre, jamais persisté), ces cartes
        disparaissent/réapparaissent avec lui -- contrairement aux
        ZoneCarte, stables tant que la Zone statique existe."""
        self._grille_zones.clear()
        self._zone_cartes = {}
        for zone in self.composant_layout.zones:
            carte = ZoneCarte(zone)
            carte.definir_selectionnee(zone.nom == self._nom_zone_selectionnee)
            carte.clique.connect(self._sur_carte_zone_cliquee)
            self._zone_cartes[zone.nom] = carte
            self._grille_zones.add_item(carte)

        self._zone_dynamique_cartes = {}
        for nom_zone in sorted(self._dernieres_zones_filtre):
            config = self.composant_layout.zones_dynamiques_clic.get(nom_zone)
            mode_clic = config.zone_clic_mode if config is not None else "toute_surface"
            carte = ZoneDynamiqueCarte(nom_zone, mode_clic)
            carte.definir_selectionnee(nom_zone == self._nom_zone_dynamique_selectionnee)
            carte.clique.connect(self._sur_carte_zone_dynamique_cliquee)
            self._zone_dynamique_cartes[nom_zone] = carte
            self._grille_zones.add_item(carte)

        carte_ajout = ZoneCarteAjout()
        carte_ajout.clique.connect(self._creer_zone_avec_nom_auto)
        self._grille_zones.add_item(carte_ajout)

    def _sur_carte_zone_cliquee(self, nom: str):
        """Cliquer une ZoneCarte peuple le panneau de droite avec ses
        propriétés (demande explicite confirmée : "quand on clic dessus
        ça va afficher ses propriétés dans le panneau"), cf.
        _rafraichir_panneau_zone. Recolore aussi son contour sur les deux
        aperçus (couleur_zone_selectionnee, cf. _rafraichir_apercu_zones_
        nommees) -- demande explicite : "lorsque on clic une zone ... il
        faut que la couleur du contour sur les images soit plus foncé et
        change de couleur"."""
        self._nom_zone_selectionnee = nom
        # AJOUT : sélection MUTUELLEMENT EXCLUSIVE avec une carte
        # dynamique (cf. docstring de _nom_zone_dynamique_selectionnee) --
        # sélectionner une Zone statique désélectionne toute zone
        # dynamique actuellement choisie, une seule carte active à la
        # fois dans toute la grille.
        self._nom_zone_dynamique_selectionnee = None
        for nom_carte, carte in self._zone_cartes.items():
            carte.definir_selectionnee(nom_carte == nom)
        for carte in self._zone_dynamique_cartes.values():
            carte.definir_selectionnee(False)
        self._rafraichir_panneau_zone()
        self._rafraichir_apercu_zones_nommees()

    def _sur_carte_zone_dynamique_cliquee(self, nom: str):
        """AJOUT -- pendant de _sur_carte_zone_cliquee ci-dessus pour une
        ZoneDynamiqueCarte : peuple le panneau de droite avec sa page
        dédiée (_page_zone_dynamique_config, cf. _rafraichir_panneau_zone
        et _construire_panneau_zone), qui n'expose que le bloc "Zone de
        clic" -- pas de nom éditable, pas de bouton Tracer/Supprimer,
        cette zone n'étant ni renommable ni traçable/supprimable
        manuellement (cf. docstring de ZoneDynamiqueCarte)."""
        self._nom_zone_dynamique_selectionnee = nom
        self._nom_zone_selectionnee = None
        for carte in self._zone_cartes.values():
            carte.definir_selectionnee(False)
        for nom_carte, carte in self._zone_dynamique_cartes.items():
            carte.definir_selectionnee(nom_carte == nom)
        self._rafraichir_panneau_zone()

    def _construire_panneau_zone(self, conteneur: QWidget):
        """Colonne de droite -- panneau de configuration de la Zone
        actuellement sélectionnée (demande explicite d'origine, étendue
        par la REFONTE qui a fusionné Forme dans Zone -- "je veux juste
        zone" : plus aucune notion de Forme séparée, donc plus de zone de
        clic personnalisée type Forme.zone_clic_mode/zone_clic_rect ici).

        DEUX états, empilés dans un QStackedLayout (cf. self._pile_
        panneau_zone) et basculés par _rafraichir_panneau_zone :
        - _page_zone_vide (index 0) : placeholder, aucune Zone
          sélectionnée (état par défaut à l'ouverture de l'écran).
        - _page_zone_config (index 1) : nom ÉDITABLE (demande explicite :
          "il ya maintenant tout les propriété éditable, notamment le
          nom"), bouton Tracer/Mettre à jour le tracé (texte dynamique
          selon si la Zone a déjà un rect défini -- "si on trace et que
          on veut modifier et bien c'est plus tracer mais update, donc
          mettre à jour le tracé"), rectangle (spinboxes x/y/largeur/
          hauteur, fractions du cL ENTIER, cf. docstring de Zone), et
          bouton Supprimer (déplacé ici depuis l'ancien sous-onglet, qui
          n'a plus de liste avec sélection + bouton associé -- cf.
          _construire_sous_onglet_zones)."""
        conteneur.setFixedWidth(300)
        layout_ext = QVBoxLayout(conteneur)
        layout_ext.setContentsMargins(0, 0, 0, 0)

        scroll = QScrollArea(conteneur)
        scroll.setObjectName("ComposantLayoutPanneauFormeScroll")
        scroll.setWidgetResizable(True)
        scroll.setFrameShape(QFrame.NoFrame)
        scroll.setHorizontalScrollBarPolicy(Qt.ScrollBarAlwaysOff)
        layout_ext.addWidget(scroll)

        pile_hote = QWidget(scroll)
        self._pile_panneau_zone = QStackedLayout(pile_hote)
        scroll.setWidget(pile_hote)

        # --- Page 0 : aucune Zone sélectionnée ---
        self._page_zone_vide = QWidget(pile_hote)
        layout_vide = QVBoxLayout(self._page_zone_vide)
        label_vide = QLabel(
            "Sélectionnez une Zone (onglet ci-dessus) pour la configurer "
            "ici.",
            self._page_zone_vide,
        )
        label_vide.setWordWrap(True)
        label_vide.setObjectName("ReglagesHintLabel")
        layout_vide.addWidget(label_vide)
        layout_vide.addStretch(1)
        self._pile_panneau_zone.addWidget(self._page_zone_vide)

        # --- Page 1 : légende des zones dynamiques (résultat du dernier
        # filtre exécuté, cf. _appliquer_filtre) -- affichée tant qu'aucune
        # Zone statique n'est sélectionnée. Simple panneau de détails en
        # LECTURE SEULE : ne change RIEN d'autre au comportement existant
        # (la Zone statique sélectionnée reste toujours prioritaire, cf.
        # _rafraichir_panneau_zone). Repeuplée dynamiquement (pastille de
        # couleur + nom, une ligne par zone) par _rafraichir_panneau_zone,
        # à partir de self._dernieres_zones_filtre / self._couleurs_zones_
        # filtre -- pas de widgets fixes ici, juste le layout hôte.
        self._page_zone_legende = QWidget(pile_hote)
        self._layout_zone_legende = QVBoxLayout(self._page_zone_legende)
        self._layout_zone_legende.setContentsMargins(0, 0, 0, 0)
        self._layout_zone_legende.setSpacing(6)
        self._layout_zone_legende.addWidget(
            self._section_label("ZONES DÉTECTÉES (FILTRE)", self._page_zone_legende)
        )
        self._pile_panneau_zone.addWidget(self._page_zone_legende)

        # --- Page 2 : configuration de la Zone sélectionnée -- nom
        # éditable + bouton Tracer/Mettre à jour + rectangle en fractions
        # du cL ENTIER (spinboxes) + bouton Supprimer. ---
        self._page_zone_config = QWidget(pile_hote)
        layout_zone_config = QVBoxLayout(self._page_zone_config)
        layout_zone_config.setContentsMargins(0, 0, 0, 0)
        layout_zone_config.setSpacing(12)

        layout_zone_config.addWidget(self._section_label("NOM", self._page_zone_config))
        self.nom_zone_selectionnee_edit = QLineEdit(self._page_zone_config)
        self.nom_zone_selectionnee_edit.setObjectName("ReglagesEdit")
        self.nom_zone_selectionnee_edit.editingFinished.connect(self._sur_nom_zone_selectionnee_change)
        layout_zone_config.addWidget(self.nom_zone_selectionnee_edit)

        self.erreur_nom_zone_label = QLabel("", self._page_zone_config)
        self.erreur_nom_zone_label.setWordWrap(True)
        self.erreur_nom_zone_label.setStyleSheet(f"color: {Mocha.red}; font-size: 11px;")
        self.erreur_nom_zone_label.hide()
        layout_zone_config.addWidget(self.erreur_nom_zone_label)

        # Bouton Tracer / Mettre à jour le tracé -- checkable, même
        # principe que l'ancien "Tracer une zone" mais ciblant désormais
        # LA ZONE SÉLECTIONNÉE dans le panneau (plus de dialogue de
        # nommage après coup, cf. _sur_toggle_mode_trace_zone /
        # _sur_zone_tracee) : le texte et l'icône changent selon que la
        # Zone a déjà un rect défini ou non (cf. _rafraichir_panneau_zone).
        self.bouton_tracer_zone = QPushButton(
            qta.icon("mdi6.vector-square-edit", color=Mocha.text), " Tracer", self._page_zone_config
        )
        self.bouton_tracer_zone.setObjectName("ReglagesButton")
        self.bouton_tracer_zone.setCheckable(True)
        self.bouton_tracer_zone.setCursor(Qt.PointingHandCursor)
        self.bouton_tracer_zone.toggled.connect(self._sur_toggle_mode_trace_zone)
        layout_zone_config.addWidget(self.bouton_tracer_zone)

        info_trace = QLabel(
            "Une fois « Tracer » actif, dessinez le rectangle sur l'un "
            "des deux aperçus ci-dessus.",
            self._page_zone_config,
        )
        info_trace.setWordWrap(True)
        info_trace.setObjectName("ReglagesHintLabel")
        layout_zone_config.addWidget(info_trace)

