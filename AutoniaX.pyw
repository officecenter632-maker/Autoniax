    # camoufox trop ancienne pour exposer Screen ne doit pas empêcher le
    # reste du fichier de fonctionner, juste désactiver silencieusement
    # cette contrainte précise (cf. docstring de _camoufox_construire_
    # config_lancement pour le repli exact).
    try:
        from camoufox.utils import Screen as _CamoufoxScreen
    except ImportError:
        _CamoufoxScreen = None
    # AJOUT (demande explicite utilisateur -- "peut tu patcher mon code
    # pour que sa demare en enlevent cela" [l'adblocker uBlock Origin,
