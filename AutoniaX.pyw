        # userData porte le type_instance réel ("chrome"/"camoufox") tel
        # qu'attendu par demande_creer_profil -- le texte affiché reste
        # le libellé lisible, cohérent avec le reste de l'app (cf.
        # libelle_type = {"chrome": "Chrome", "camoufox": "Camoufox", "cloakbrowser": "CloakBrowser", "feather": "Feather"}
        # déjà utilisé ailleurs pour l'affichage).
        self.combo_type_generation = QComboBox(self._bloc_generation_masse)
        self.combo_type_generation.addItem("Camoufox", "camoufox")
        self.combo_type_generation.addItem("Chrome", "chrome")
        self.combo_type_generation.addItem("CloakBrowser", "cloakbrowser")
        self.combo_type_generation.setCursor(Qt.PointingHandCursor)
        self.combo_type_generation.setToolTip(
            "Type de profil créé par « Générer » ci-contre -- Camoufox ou Chrome."
        )
        self.combo_type_generation.currentIndexChanged.connect(
            self._sur_changement_type_generation
        )
        layout_generation.addWidget(self.combo_type_generation)

        label_nombre_generation = QLabel("Nombre :", self._bloc_generation_masse)
        layout_generation.addWidget(label_nombre_generation)

        self.spin_nombre_generation = QSpinBox(self._bloc_generation_masse)
        self.spin_nombre_generation.setMinimum(1)
        # Borne arbitraire de garde-fou -- évite un lot absurdement long
        # qui spammerait le sAutoniax de centaines d'appels séquentiels
        # (cf. section 3.4 de la spec, "à ajuster selon les besoins réels").
        self.spin_nombre_generation.setMaximum(200)
        self.spin_nombre_generation.setValue(5)
        self.spin_nombre_generation.setCursor(Qt.PointingHandCursor)
        self.spin_nombre_generation.setFixedWidth(64)
        layout_generation.addWidget(self.spin_nombre_generation)

        # Soudé au spinbox (spacing=0 local via un conteneur dédié) pour
        # lire comme un seul contrôle composé "quantité + action" plutôt
        # que deux widgets indépendants espacés.
        self.bouton_generer_profils = QPushButton(
            qta.icon("mdi6.auto-fix", color=Mocha.crust), " Générer", self._bloc_generation_masse,
        )
        self.bouton_generer_profils.setObjectName("CaptureButton")
        self.bouton_generer_profils.setCursor(Qt.PointingHandCursor)
        self.bouton_generer_profils.clicked.connect(self._on_clic_generer_profils_masse)
        layout_generation.addWidget(self.bouton_generer_profils)
        # Tooltip initial cohérent avec le premier item du combo
        # ci-dessus ("Camoufox") -- tenu à jour ensuite par
        # _sur_changement_type_generation à chaque changement de choix.
        self._rafraichir_tooltip_bouton_generer()

        self._bloc_generation_masse.setVisible(False)
        layout.addWidget(self._bloc_generation_masse)

        # PATCH (même demande explicite -- "tu dois aussi mettre un
        # bouton tout demarer") -- démarre TOUS les profils actuellement
        # inactifs de ce sAutoniax, peu importe leur origine (générés en
        # masse ci-dessus, créés avant ce patch, importés du cloud...),
        # cf. section 4.1 de la spec (TRANCHÉ : aucun filtrage par
        # provenance). Réutilise _sur_clic_demarrer_profil tel quel, en
        # boucle -- cf. son docstring, aucune modification nécessaire là.
        #
        # PATCH (demande explicite utilisateur : "je veux que ajoute
        # aussi le bouton tout arreter, sur la meme ligne que le bouton
        # tout demarer") -- "Tout démarrer" et "Tout arrêter" partagent
        # désormais une ligne horizontale commune (layout_tout_demarrer_
        # arreter) au lieu d'être chacun sur leur propre ligne verticale.
        # "Tout arrêter" réutilise le protocole de kill déjà existant
        # (demande_kill_profil / _sur_clic_kill_profil), en boucle sur
        # tous les profils ACTIFS -- symétrique exact de "Tout démarrer"
        # qui boucle sur les profils inactifs.
        layout_tout_demarrer_arreter = QHBoxLayout()
        layout_tout_demarrer_arreter.setContentsMargins(0, 0, 0, 0)

        self.bouton_tout_demarrer = QPushButton(
            qta.icon("mdi6.play-box-multiple-outline", color=Mocha.crust), " Tout démarrer", self,
