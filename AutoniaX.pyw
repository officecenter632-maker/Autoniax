class IndicateurDefilementFin(QWidget):
    """Fin indicateur de défilement pour une QScrollArea dont la vraie barre est masquée (ex. le notebook d'un Task).
    Demande utilisateur : « quand on scrolle on ne sait pas combien de temps on va attendre la fin de la page ».
    Une fine pastille arrondie, SUPERPOSÉE au bord droit (elle ne prend aucune place) : sa TAILLE montre la part du notebook visible à
    l'écran (petite = page longue) et sa POSITION montre où l'on en est. Elle apparaît dès qu'on défile, puis s'efface en fondu
    quand on s'arrête. Insensible à la souris. Les cellules étant montées à la demande, la longueur totale est une estimation
    qui s'affine au fil du défilement."""
    LARGEUR = 4        # épaisseur de la pastille (px)
    MARGE = 3          # espace entre la pastille et le bord droit (px)
    MARGE_V = 4        # espace haut/bas (px)
    HAUTEUR_MIN = 28   # la pastille ne devient jamais plus petite (page très longue)
    ATTENTE_MS = 1100  # durée d'affichage après le dernier défilement
    PAS_FONDU = 28     # perte d'opacité par étape de 30 ms

    def __init__(self, zone):
        super().__init__(zone.viewport())
        self._zone = zone
        self._sb = zone.verticalScrollBar()
        self._alpha = 0
        self.setAttribute(Qt.WA_TransparentForMouseEvents, True)
        self.setAttribute(Qt.WA_NoSystemBackground, True)
        self.hide()
        self._attente = QTimer(self)
        self._attente.setSingleShot(True)
        self._attente.setInterval(self.ATTENTE_MS)
        self._attente.timeout.connect(self._debut_fondu)
        self._fondu = QTimer(self)
        self._fondu.setInterval(30)
        self._fondu.timeout.connect(self._pas_fondu)
        self._sb.valueChanged.connect(self._activite)
        self._sb.rangeChanged.connect(lambda *_: self.update())   # la longueur estimée change : redessine, sans faire apparaître
        zone.viewport().installEventFilter(self)
        self._placer()

    def _placer(self):
        vp = self._zone.viewport()
        largeur = self.LARGEUR + 2 * self.MARGE
        self.setGeometry(max(0, vp.width() - largeur), 0, largeur, vp.height())

    def eventFilter(self, obj, event):
        try:
            if event.type() == QEvent.Resize and obj is self._zone.viewport():
                self._placer()
        except RuntimeError:
            pass   # zone déjà détruite (fermeture de l'application)
        return False

    def _activite(self, *_):
        if self._sb.maximum() <= 0:
            return
        self._fondu.stop()
        self._alpha = 255
        self._placer()
        self.show()
        self.raise_()
        self.update()
        self._attente.start()

    def _debut_fondu(self):
        self._fondu.start()

    def _pas_fondu(self):
        self._alpha -= self.PAS_FONDU
        if self._alpha <= 0:
            self._alpha = 0
            self._fondu.stop()
            self.hide()
        self.update()

    def paintEvent(self, event):
        maxi = self._sb.maximum()
        if self._alpha <= 0 or maxi <= 0:
            return
        page = max(1, self._sb.pageStep())
        piste = max(1, self.height() - 2 * self.MARGE_V)
        taille = max(self.HAUTEUR_MIN, piste * page / float(maxi + page))
        taille = min(taille, piste)
        y = self.MARGE_V + (piste - taille) * min(1.0, max(0.0, self._sb.value() / float(maxi)))
        couleur = QColor(getattr(Mocha, "overlay1", Mocha.overlay0))
        couleur.setAlpha(int(self._alpha * 0.8))
        painter = QPainter(self)
        painter.setRenderHint(QPainter.Antialiasing, True)
        painter.setPen(Qt.NoPen)
        painter.setBrush(couleur)
        painter.drawRoundedRect(QRectF(self.MARGE, y, self.LARGEUR, taille), self.LARGEUR / 2.0, self.LARGEUR / 2.0)
        painter.end()


class ListeLibsTroisColonnes(QListWidget):
    """PATCH (demande utilisateur : fichiers de lib affichés sur 3 colonnes, pas 2) : liste en flux gauche->droite qui
    revient à la ligne ; chaque cellule occupe 1/3 de la largeur UTILE. La largeur est lue sur l'événement Resize du
    viewport lui-même (viewport().width() est périmé dans resizeEvent) et une marge de sécurité évite qu'un pixel de
    trop ne fasse retomber à 2 colonnes."""
    NB_COLONNES = 3
    MARGE_SECURITE = 16

    def __init__(self, parent=None):
        super().__init__(parent)
        self.setViewMode(QListView.ListMode)
        self.setFlow(QListView.LeftToRight)
        self.setWrapping(True)
        self.setResizeMode(QListView.Adjust)
        self.setUniformItemSizes(True)
        self.setMovement(QListView.Static)
        self.setHorizontalScrollBarPolicy(Qt.ScrollBarAlwaysOff)
        self.setSpacing(0)
        self.viewport().installEventFilter(self)

    def _ajuster_grille(self, largeur=None):
        if largeur is None:
            largeur = self.viewport().width()
        largeur -= self.MARGE_SECURITE
        if largeur > 0:
            self.setGridSize(QSize(max(100, largeur // self.NB_COLONNES), 34))

    def eventFilter(self, obj, event):
        if obj is self.viewport() and event.type() == QEvent.Resize:
            self._ajuster_grille(event.size().width())
        return super().eventFilter(obj, event)

    def showEvent(self, event):
        super().showEvent(event)
        self._ajuster_grille()


def _appliquer_barre_titre_sombre(fenetre, fond="#1E1F1C", texte="#F8F8F2"):
    """Windows 10/11 : colore la barre de titre NATIVE d'une fenêtre secondaire (mode sombre + couleurs de légende).
    Sans effet (et sans erreur) sur les autres plateformes ou les Windows trop anciens."""
    if sys.platform != "win32":
        return
    try:
        hwnd = ctypes.c_void_p(int(fenetre.winId()))
        dwm = ctypes.windll.dwmapi

        def colorref(hexa):
            c = QColor(hexa)
            return c.red() | (c.green() << 8) | (c.blue() << 16)   # COLORREF = 0x00BBGGRR

        def attribut(code, valeur):
            v = ctypes.c_int(valeur)
            return dwm.DwmSetWindowAttribute(hwnd, code, ctypes.byref(v), ctypes.sizeof(v))

        if attribut(20, 1) != 0:       # DWMWA_USE_IMMERSIVE_DARK_MODE (Win10 20H1+ / Win11)
            attribut(19, 1)            # ancienne valeur (Win10 1809-1909)
        attribut(34, colorref(fond))   # DWMWA_BORDER_COLOR   (Win11)
        attribut(35, colorref(fond))   # DWMWA_CAPTION_COLOR  (Win11)
        attribut(36, colorref(texte))  # DWMWA_TEXT_COLOR     (Win11)
    except Exception:
        pass


class ColorationMonokai(PythonHighlighter):
    """Coloration Python au style Sublime Text (Monokai) : réutilise PythonHighlighter (chaînes multi-lignes, commentaires,
    mots-clés, fonctions, méthodes, nombres) en ne changeant que les couleurs."""

    def __init__(self, document):
        super().__init__(document)

        def teinte(fmt, couleur):
            fmt.setForeground(QColor(couleur))
            fmt.setFontWeight(QFont.Normal)

        teinte(self._fmt_mot_cle, "#F92672")        # def / if / return / import...
        teinte(self._fmt_chaine, "#E6DB74")         # chaînes
        teinte(self._fmt_commentaire, "#75715E")    # commentaires
        # les 3 dernières règles de PythonHighlighter : méthode après un point, fonction appelée, nombre
        if len(self._regles) >= 3:
            teinte(self._regles[-3][1], "#A6E22E")
            teinte(self._regles[-2][1], "#A6E22E")
            teinte(self._regles[-1][1], "#AE81FF")
        self.rehighlight()


