    def _task_config_editeur_est_page_active(self) -> bool:
        """Vrai UNIQUEMENT si TaskConfigScreen.editeur_page (ce que
        l'utilisateur nomme familièrement "TaskScriptEditor") est
        RÉELLEMENT la page affichée à l'écran en ce moment -- double
        vérification demandée explicitement ("ce bouton est censé
        s'exécuter que si TaskScriptEditor est ouvert, je veux dire page
        actuellement ouverte de l'app") :
          1. l'écran "taskconfig" est la page active de self.content_stack
             (pas seulement instancié quelque part dans self.screens) ;
          2. ET, à l'intérieur de cet écran, c'est bien editeur_page qui
             est active dans son propre sous-stack interne (pas
             grille_page, la liste des Tasks) -- cf. TaskConfigScreen.
             stack/grille_page/editeur_page.
        Défensif comme le reste de cette zone (jamais lever) : un écran
        absent ou un attribut manquant retombe simplement sur False."""
        try:
            taskconfig_screen = self.screens.get("taskconfig")
            if taskconfig_screen is None:
                return False
            if self.content_stack.currentWidget() is not taskconfig_screen:
                return False
            return taskconfig_screen.stack.currentWidget() is taskconfig_screen.editeur_page
        except Exception:
            return False

    def keyPressEvent(self, event):
        """Raccourci "Interne" task_executer_tout_toggle (cf. sa
        docstring dans DEFAULT_RACCOURCIS_APP) -- même patron de lecture
        live que FenetreRenduTaskReseau.keyPressEvent (_touche_correspond_
        au_raccourci relit charger_raccourcis_app() à chaque frappe, pas
        de cache). Contrairement à fermeture_app (QShortcut global
        ci-dessus), celui-ci DOIT rester limité à une page précise --
        d'où la vérification explicite via _task_config_editeur_est_page_
        active() avant tout déclenchement, plutôt qu'un second
        QShortcut qui serait, lui, actif partout dans l'app."""
        if (
            _touche_correspond_au_raccourci(event, "task_executer_tout_toggle")
            and self._task_config_editeur_est_page_active()
        ):
            self.screens["taskconfig"]._sur_clic_bouton_executer_tout()
            return
        # AJOUT (raccourci sync_api_toggle, cf. sa docstring dans
        # DEFAULT_RACCOURCIS_APP) -- même garde de page active, même
        # relais direct vers le handler du bouton (_sur_clic_sync_api_
        # reseau porte déjà tous les garde-fous nécessaires : task,
        # réseau disponible, sAutoniax choisi, séquence déjà en cours).
        if (
            _touche_correspond_au_raccourci(event, "sync_api_toggle")
            and self._task_config_editeur_est_page_active()
        ):
            self.screens["taskconfig"]._sur_clic_sync_api_reseau()
            return
        # sync_service_api_seul_toggle/sync_project_json_seul_toggle : PAS
        # câblés ici (cf. leur QShortcut global dans __init__/_sur_
        # raccourci_sync_service_api_seul/_sur_raccourci_sync_project_
        # json_seul) -- même raison exactement que copier_doc_ia (cf. son
        # commentaire CORRECTIF dans __init__) : le focus clavier pendant
        # l'édition d'une Task est presque toujours dans TaskScriptEditor,
        # qui consomme l'événement avant qu'il n'atteigne ce keyPressEvent
        # -- posés d'emblée en QShortcut global pour ne pas reproduire ce
        # bug déjà rencontré et corrigé une première fois.
        super().keyPressEvent(event)

    def lancer_prechargement_banques(self):
        """Démarre le préchargement des banques (trajectoire souris +
        scroll) À LA DEMANDE -- appelé par le bouton dédié dans les
        Réglages (cf. ReglagesScreen), plus jamais automatiquement au
        démarrage de l'app. Même montage QThread que précédemment (cf.
        PrechargementBanquesWorker) : ne bloque jamais le thread GUI
        pendant TrajectoryBank.build()/ScrollBank.build().

        Ignore silencieusement (ne relance rien) si un chargement est déjà
        en cours -- évite d'empiler plusieurs QThread si l'utilisateur
        clique plusieurs fois sur le bouton avant que le premier ait fini ;
        le bouton appelant (ReglagesScreen) se désactive de toute façon
        pendant le chargement, ceci n'est qu'un filet de sécurité
        supplémentaire."""
        if self._thread_prechargement_banques is not None and self._thread_prechargement_banques.isRunning():
            log.info("lancer_prechargement_banques() : un chargement est déjà en cours, ignoré.")
            return
        self._thread_prechargement_banques = QThread(self)
        self._worker_prechargement_banques = PrechargementBanquesWorker()
        self._worker_prechargement_banques.moveToThread(self._thread_prechargement_banques)
        self._worker_prechargement_banques.termine.connect(self._sur_prechargement_banques_termine)
        self._thread_prechargement_banques.started.connect(self._worker_prechargement_banques.demarrer)
        self._thread_prechargement_banques.start()

    def _afficher_message_statut_reseau(self, ok: bool, message: str, duree_ms: int = 6000):
        """PATCH A (cf. cahier des charges patchs.md -- "chaque action
        réseau doit avoir une confirmation visible dans la barre de
        statut de mAutoniax"). Point d'entrée UNIQUE pour toutes les
        actions réseau ponctuelles (kill, redémarrer, mettre à jour
        service API, mettre à jour app, configurer stockage, envoyer
        profil, envoyer projet vers sAutoniax...) -- réutilise la
        statusBar() globale de MainWindow, déjà utilisée pour le
        préchargement des banques de mouvement (cf. _sur_prechargement_
        banques_termine juste au-dessus, même patron couleur rouge/
        style réinitialisé). Ne REMPLACE aucun des label_statut locaux
        déjà existants par écran (InstancesConnecteesScreen, Stockage
        Screen, etc.) -- s'ajoute EN PLUS : un message visible même si
        l'utilisateur n'est plus sur l'onglet d'où l'action a été
        lancée, ce qui est précisément le trou signalé ("aucune
        confirmation dans le status bar")."""
        if ok:
            self.statusBar().setStyleSheet("")
        else:
            self.statusBar().setStyleSheet(f"QStatusBar {{ color: {Mocha.red}; }}")
        self.statusBar().showMessage(message, duree_ms)

    def _sur_prechargement_banques_termine(self, resultat: dict):
        """Slot GUI (thread principal) -- reçoit le résultat du
        préchargement (cf. PrechargementBanquesWorker.termine) et l'émet
        aussi via banques_prechargement_termine (cf. Signal plus haut dans
        la classe) pour que ReglagesScreen puisse réactiver son bouton et
        afficher le même résultat localement, en plus du message dans la
        statusBar ci-dessous."""
        ok_trajectoire, msg_trajectoire = resultat.get("trajectoire", (False, "résultat manquant"))
        ok_scroll, msg_scroll = resultat.get("scroll", (False, "résultat manquant"))

        if ok_trajectoire and ok_scroll:
            self.statusBar().setStyleSheet("")
            self.statusBar().showMessage(
                "Banques de mouvement humain (trajectoire souris + scroll) chargées.", 5000
            )
        else:
            parties = []
            if not ok_trajectoire:
                parties.append(f"trajectoire souris : {msg_trajectoire}")
            if not ok_scroll:
                parties.append(f"scroll : {msg_scroll}")
            # setStyleSheet ciblé sur CETTE statusBar (pas de couleur
            # d'erreur définie dans le thème global de QStatusBar, cf.
            # build_stylesheet) -- réinitialisé (chaîne vide) dans la
            # branche ok ci-dessus si un futur rechargement réutilisait un
            # jour ce même worker, pour ne pas laisser le rouge collé en
            # permanence après un succès.
            self.statusBar().setStyleSheet(f"QStatusBar {{ color: {Mocha.red}; }}")
            self.statusBar().showMessage(
                "Génération de mouvement humain indisponible (" + " | ".join(parties) + ") "
                "-- l'app reste utilisable, un comportement de repli moins réaliste sera "
                "utilisé pour la souris/le scroll.",
                12000,
            )

        self._thread_prechargement_banques.quit()
        self._thread_prechargement_banques.wait()
        self.banques_prechargement_termine.emit(resultat)

    def lancer_copie_tous_logs(self, ids_sautoniax_coches: list, motif_filtre: str = "", pourcentage_conservation: int = 100):
        """PATCH (bouton "Copier tous les logs") -- point d'entrée
        appelé sur ParametresScreen.demande_copier_tous_logs. Détermine
        l'ensemble EXACT des sources attendues (ordre stable : Serveur,
        mAutoniax, puis chaque sAutoniax coché par ordre alphabétique de
        nom -- même ordre que la liste affichée, cf. ParametresScreen.
        _rafraichir_liste_sources_logs) puis déclenche leur récupération
        respective : GET /logs en thread séparé pour le serveurT (cf.
        CopieLogsWorker), lecture directe de tampon_journal pour
        mAutoniax (déjà en mémoire, aucune attente), et un message
        "demander_logs_executant" par sAutoniax coché (déjà asynchrone,
        cf. ClientServeurT.demander_logs_executant -- les réponses
        arrivent au fil de l'eau via logs_executant_recu, cf. câblage
        dans _build_screens et _sur_logs_executant_recus ci-dessous).

        _copie_logs_en_cours["restantes"] est le jeu des clés encore en
        attente -- _tenter_finaliser_copie_logs() assemble et copie dans
        le presse-papier dès que ce jeu est vide (toutes les sources ont
        répondu, avec succès ou en erreur -- une erreur individuelle
        n'empêche jamais les autres sources d'apparaître dans le résultat
        final, cf. sa docstring).

        AJOUT (filtre par motif, cf. ParametresScreen.champ_filtre_logs)
        -- `motif_filtre` (déjà .strip() côté appelant) est mémorisé tel
        quel dans _copie_logs_en_cours -- toutes les sources sont TOUJOURS
        récupérées en entier à ce stade (aucune économie réseau), le
        filtre n'intervient qu'à l'assemblage final ligne par ligne (cf.
        _tenter_finaliser_copie_logs) -- chaîne vide = aucun filtre."""
        parametres_screen = self.screens.get("parametres")
        mautoniax_coche, serveur_coche = (
            parametres_screen.sources_mautoniax_et_serveur_cochees() if parametres_screen else (False, False)
        )

        sections_attendues = []  # liste de (cle, titre) dans l'ordre final voulu
        if serveur_coche:
            sections_attendues.append(("__serveur__", "Serveur (serveurT)"))
        if mautoniax_coche:
            sections_attendues.append(("__mautoniax__", "mAutoniax (cette instance)"))
        noms_par_id = getattr(parametres_screen, "_executants_logs_connus", {}) if parametres_screen else {}
        for id_executant in sorted(ids_sautoniax_coches, key=lambda i: noms_par_id.get(i, i)):
            sections_attendues.append((id_executant, f"sAutoniax : {noms_par_id.get(id_executant, id_executant)}"))

        self._copie_logs_en_cours = {
            "ordre": [cle for cle, _titre in sections_attendues],
            "titres": {cle: titre for cle, titre in sections_attendues},
            "resultats": {},  # cle -> (ok: bool, lignes: list[str] | erreur: str)
            "restantes": {cle for cle, _titre in sections_attendues},
            "motif_filtre": motif_filtre,
            "pourcentage_conservation": pourcentage_conservation,
        }

        if not sections_attendues:
            # Ne devrait pas arriver (ParametresScreen refuse déjà le
            # clic si _sources_logs_cochees est vide) -- filet de
            # sécurité si jamais les deux listes divergent un jour.
            if parametres_screen:
                parametres_screen.afficher_resultat_copie_logs(False, "Aucune source cochée -- rien à copier.")
            self._copie_logs_en_cours = None
            return

        if serveur_coche:
            if parametres_screen:
                parametres_screen.afficher_progression_copie_logs("Récupération des logs du serveurT…")
            url_http = _url_http_depuis_url_websocket_serveur_t(self.client_serveur_t.server_url)
            self._thread_copie_logs_serveur = QThread(self)
            self._worker_copie_logs_serveur = CopieLogsWorker(url_http)
            self._worker_copie_logs_serveur.moveToThread(self._thread_copie_logs_serveur)
            self._worker_copie_logs_serveur.termine.connect(self._sur_logs_serveur_recus)
            self._thread_copie_logs_serveur.started.connect(self._worker_copie_logs_serveur.demarrer)
            self._thread_copie_logs_serveur.start()

        if mautoniax_coche:
            # Déjà en mémoire (tampon_journal, alimenté depuis le tout
            # début du process, cf. TamponJournalMemoire en tête de
            # fichier) -- aucune attente réseau, résolu immédiatement.
            self._copie_logs_en_cours["resultats"]["__mautoniax__"] = (True, list(tampon_journal.lignes))
            self._copie_logs_en_cours["restantes"].discard("__mautoniax__")

        for id_executant in ids_sautoniax_coches:
            nom_affiche = noms_par_id.get(id_executant, id_executant)
            if parametres_screen:
                parametres_screen.afficher_progression_copie_logs(f"Récupération des logs de '{nom_affiche}'…")
            self.client_serveur_t.demander_logs_executant(id_executant)

        self._tenter_finaliser_copie_logs()

    def lancer_copie_logs_execution_clone(
        self, ids_executant_sautoniax: list, debut_epoch: float, fin_epoch: Optional[float],
    ):
        """AJOUT (bouton "Copier les logs de cette exécution" du panneau
        clone -- demande explicite utilisateur : "je vais pouvoir copier
        les logs de tout le monde à partir de ce temps là, jusqu'à la
        fin de l'exécution") -- point d'entrée appelé sur
        TaskConfigScreen._sur_demande_copier_logs_execution_clone,
        sœur de lancer_copie_tous_logs ci-dessus (même mécanisme
        d'agrégation _copie_logs_en_cours/_tenter_finaliser_copie_logs,
        réutilisé tel quel) mais qui :

        1. cible TOUJOURS Serveur + mAutoniax + TOUS LES sAutoniax
           REPRÉSENTÉS dans cette exécution (REFONTE MULTI-SAUTONIAX --
           ids_executant_sautoniax, la liste dédupliquée des id_executant
           figés par profil dans ce lot, cf. TaskConfigScreen._sur_
           demande_copier_logs_execution_clone ; auparavant un seul
           ExecutionCloneEtat.id_executant_sautoniax, insuffisant dès
           qu'un même lot mélange des profils de PLUSIEURS sAutoniax --
           chacun doit apparaître comme sa propre section, exactement
           comme lancer_copie_tous_logs le fait déjà pour une liste de
           sAutoniax COCHÉS ; même patron de construction de
           sections_attendues et de boucle d'émission repris ici, sans
           dépendance sur ParametresScreen ni sur ses cases à cocher,
           cette copie reste indépendante de l'écran Paramètres) ;
        2. filtre par PLAGE TEMPORELLE [debut_epoch, fin_epoch] au lieu
           d'un motif texte -- `motif_filtre` reste une chaîne vide
           dans _copie_logs_en_cours, c'est la présence de la clé
           "plage_temporelle" qui indique à _tenter_finaliser_copie_logs
           quel mode de filtrage appliquer (cf. sa docstring).

        `fin_epoch=None` (lot encore en cours, cf. ExecutionCloneEtat.
        horodatage_fin_lot) -- l'instant présent (time.time(), capturé
        ICI au moment du clic) est utilisé comme borne de fin plutôt que
        d'attendre une valeur qui n'existe pas encore, pour permettre de
        copier les logs SANS attendre la fin de l'exécution."""
        fin_epoch_resolue = fin_epoch if fin_epoch is not None else time.time()
        noms_par_id = getattr(self.client_serveur_t, "_executants", {})

        sections_attendues = [
            ("__serveur__", "Serveur (serveurT)"),
            ("__mautoniax__", "mAutoniax (cette instance)"),
        ]
        # REFONTE MULTI-SAUTONIAX -- une section PAR sAutoniax représenté
        # dans le lot, même ordre stable (alphabétique de nom affiché) que
        # lancer_copie_tous_logs, plutôt qu'une seule section conditionnée
        # par `if id_executant_sautoniax:` (ancien comportement mono-
        # sAutoniax). ids_executant_sautoniax est déjà dédupliqué par
        # l'appelant (cf. TaskConfigScreen._sur_demande_copier_logs_
        # execution_clone) -- aucun filtrage supplémentaire nécessaire ici.
        for id_executant in sorted(ids_executant_sautoniax, key=lambda i: noms_par_id.get(i, {}).get("nom", i)):
            nom_affiche = noms_par_id.get(id_executant, {}).get("nom", id_executant)
            sections_attendues.append((id_executant, f"sAutoniax : {nom_affiche}"))

        self._copie_logs_en_cours = {
            "ordre": [cle for cle, _titre in sections_attendues],
            "titres": {cle: titre for cle, titre in sections_attendues},
            "resultats": {},
            "restantes": {cle for cle, _titre in sections_attendues},
            "motif_filtre": "",
            "plage_temporelle": (debut_epoch, fin_epoch_resolue),
        }

        parametres_screen = self.screens.get("parametres")
        if parametres_screen:
            parametres_screen.afficher_progression_copie_logs("Récupération des logs du serveurT…")
        url_http = _url_http_depuis_url_websocket_serveur_t(self.client_serveur_t.server_url)
        self._thread_copie_logs_serveur = QThread(self)
        self._worker_copie_logs_serveur = CopieLogsWorker(url_http)
        self._worker_copie_logs_serveur.moveToThread(self._thread_copie_logs_serveur)
        self._worker_copie_logs_serveur.termine.connect(self._sur_logs_serveur_recus)
        self._thread_copie_logs_serveur.started.connect(self._worker_copie_logs_serveur.demarrer)
        self._thread_copie_logs_serveur.start()

        # mAutoniax : source de vérité horodatée (tampon_journal.
        # horodatages, liste PARALLÈLE à tampon_journal.lignes -- cf.
        # TamponJournalMemoire) -- conservée à part dans le résultat pour
        # que _tenter_finaliser_copie_logs puisse filtrer par timestamp
        # Unix EXACT plutôt que d'estimer depuis le texte "HH:MM:SS"
        # (cf. _filtrer_lignes_par_plage, paramètre horodatages_reels).
        self._copie_logs_en_cours["resultats"]["__mautoniax__"] = (
            True, (list(tampon_journal.lignes), list(tampon_journal.horodatages)),
        )
        self._copie_logs_en_cours["restantes"].discard("__mautoniax__")

        # REFONTE MULTI-SAUTONIAX -- un demander_logs_executant PAR
        # sAutoniax représenté, chaque réponse étant agrégée séparément
        # via _sur_logs_executant_recus (déjà générique par id_executant,
        # cf. sa docstring -- aucun changement nécessaire de ce côté).
        for id_executant in ids_executant_sautoniax:
            nom_affiche = noms_par_id.get(id_executant, {}).get("nom", id_executant)
            if parametres_screen:
                parametres_screen.afficher_progression_copie_logs(f"Récupération des logs de '{nom_affiche}'…")
            self.client_serveur_t.demander_logs_executant(id_executant)

        self._tenter_finaliser_copie_logs()

    def _sur_logs_serveur_recus(self, ok: bool, lignes: list, erreur: str):
        """Callback de CopieLogsWorker.termine -- même nettoyage de
        thread que _sur_prechargement_banques_termine (quit/wait avant
        de relâcher les références, pour ne jamais laisser un QThread
        orphelin)."""
        self._thread_copie_logs_serveur.quit()
        self._thread_copie_logs_serveur.wait()
        self._thread_copie_logs_serveur = None
        self._worker_copie_logs_serveur = None
        if self._copie_logs_en_cours is None or "__serveur__" not in self._copie_logs_en_cours["restantes"]:
            # Une opération plus récente a démarré entre-temps (nouveau
            # clic) -- cette réponse est périmée, on l'ignore.
            return
        self._copie_logs_en_cours["resultats"]["__serveur__"] = (ok, lignes if ok else erreur)
        self._copie_logs_en_cours["restantes"].discard("__serveur__")
        self._tenter_finaliser_copie_logs()

    def _sur_logs_executant_recus(self, id_executant: str, lignes: list, offset_utc_secondes: float = 0.0):
        """Câblée sur ClientServeurT.logs_executant_recu (cf.
        _build_screens) -- reçoit la réponse d'UN sAutoniax à la fois.
        lignes vide ET id_executant absent de _copie_logs_en_cours (ex.
        un sAutoniax déconnecté entre le clic et sa réponse, cf.
        ClientServeurT._traiter_message qui émet quand même le signal
        avec lignes=[] dans ce cas) est traité comme un résultat vide
        mais réussi -- rien à distinguer d'un sAutoniax qui n'a
        simplement encore rien loggé, l'important est de ne pas bloquer
        indéfiniment l'agrégation en attente d'une réponse qui
        n'arrivera jamais faute d'accusé d'échec explicite ici.

        BUGFIX (fenêtre temporelle sAutoniax toujours vide) --
        offset_utc_secondes (fuseau LOCAL de la machine sAutoniax,
        cf. docstring du signal) conservé à côté de `lignes` dans
        `resultats`, pour que _tenter_finaliser_copie_logs puisse
        resituer correctement les lignes "HH:MM:SS" de CETTE source
        précise lors du filtrage temporel -- inutile pour le filtrage
        par motif texte, mais transmis dans tous les cas (source unique
        de vérité, pas de branche séparée à maintenir)."""
        if self._copie_logs_en_cours is None or id_executant not in self._copie_logs_en_cours["restantes"]:
            return
        self._copie_logs_en_cours["resultats"][id_executant] = (True, lignes, offset_utc_secondes)
        self._copie_logs_en_cours["restantes"].discard(id_executant)
        self._tenter_finaliser_copie_logs()

    def _tenter_finaliser_copie_logs(self):
        """Assemble et copie dans le presse-papier dès que toutes les
        sources attendues ont répondu (cf. _copie_logs_en_cours[
        "restantes"], vidé au fil de l'eau par _sur_logs_serveur_recus/
        _sur_logs_executant_recus/lancer_copie_tous_logs pour mAutoniax).
        Séparateurs clairs entre sections (ligne de "=" + titre), une
        section en erreur affiche le message d'erreur À LA PLACE des
        logs plutôt que d'être simplement omise -- pour que l'utilisateur
        sache qu'une source cochée a été tentée mais a échoué, au lieu
        de se demander silencieusement pourquoi elle manque.

        AJOUT (filtre par motif, cf. ParametresScreen.champ_filtre_logs)
        -- si etat["motif_filtre"] est non vide, seules les lignes DE
        CHAQUE SECTION contenant ce motif (recherche simple, insensible
        à la casse -- pas de regex) sont conservées dans le corps ;
        l'entête de section reste toujours affiché même si son corps
        finit vide après filtrage (pour qu'on voie que cette source a
        bien été inspectée, juste sans correspondance) plutôt que de
        faire disparaître la section entière. Une section en ERREUR
        n'est jamais filtrée (le message d'erreur reste visible tel
        quel, peu importe le motif -- perdre une info d'échec à cause
        d'un filtre serait pire que de l'afficher en trop).

        AJOUT (bouton "Copier les logs de cette exécution" du panneau
        clone, cf. MainWindow.lancer_copie_logs_execution_clone) -- si
        etat["plage_temporelle"] est présent (tuple (debut_epoch,
        fin_epoch)), le filtrage bascule en mode TEMPOREL au lieu du
        motif texte (les deux modes sont mutuellement exclusifs --
        lancer_copie_logs_execution_clone laisse toujours motif_filtre
        vide, cf. sa docstring) : chaque section est passée à
        _filtrer_lignes_par_plage, avec `reference_epoch=debut_epoch`
        (sert de pivot pour résoudre l'ambiguïté de date des sources ne
        renvoyant que "HH:MM:SS", cf. sa docstring) et les horodatages
        RÉELS de mAutoniax quand disponibles (contenu est alors un tuple
        (lignes, horodatages) plutôt qu'une simple liste, cf.
        lancer_copie_logs_execution_clone -- Serveur et sAutoniax ne
        renvoient eux que du texte, donc estimation seule pour ces
        deux-là)."""
        if self._copie_logs_en_cours is None or self._copie_logs_en_cours["restantes"]:
            return
        etat = self._copie_logs_en_cours
        self._copie_logs_en_cours = None
        motif_filtre = etat.get("motif_filtre", "")
        motif_filtre_bas = motif_filtre.lower()
        pourcentage_conservation = etat.get("pourcentage_conservation", 100)
        plage_temporelle = etat.get("plage_temporelle")

        blocs = []
        echecs = []
        for cle in etat["ordre"]:
            titre = etat["titres"][cle]
            # BUGFIX (fenêtre temporelle sAutoniax toujours vide) --
            # dépaquetage en deux temps : `ok` d'abord, puis `reste` de
            # longueur VARIABLE selon la source, plutôt que le
            # `ok, contenu = ...` fixe d'avant ce patch, qui levait
            # ValueError dès que _sur_logs_executant_recus stocke
            # désormais un 3-tuple (True, lignes, offset_utc_secondes)
            # au lieu du 2-tuple (True, lignes) d'origine.
            # __mautoniax__/__serveur__ restent des 2-tuples inchangés
            # (True/ok, contenu) -- offset_utc_secondes vaut alors 0.0
            # par défaut (__serveur__ n'en a pas besoin, timestamps deja
            # complets ; __mautoniax__ non plus, horodatages_reels déjà
            # exacts).
            resultat_brut = etat["resultats"].get(cle, (False, "Aucune réponse reçue."))
            ok, contenu, *reste = resultat_brut
            offset_utc_secondes_source = reste[0] if reste else 0.0
            entete = f"{'=' * 20} {titre} {'=' * 20}"
            if ok:
                if isinstance(contenu, tuple):
                    lignes_brutes, horodatages_reels = contenu
                else:
                    lignes_brutes, horodatages_reels = contenu, None
                if plage_temporelle is not None:
                    debut_epoch, fin_epoch = plage_temporelle
                    lignes = _filtrer_lignes_par_plage(
                        lignes_brutes, debut_epoch, fin_epoch,
                        reference_epoch=debut_epoch, horodatages_reels=horodatages_reels,
                        offset_utc_secondes=offset_utc_secondes_source,
                    )
                elif motif_filtre_bas:
                    lignes = [ligne for ligne in lignes_brutes if motif_filtre_bas in ligne.lower()]
                else:
                    lignes = lignes_brutes
                # AJOUT (demande explicite utilisateur : "un pourcentage
                # de logs a conserver [...] si je met 50 pourcent sa veut
                # dire que je vais garder 50 pourcent des logs en allant
                # du plus recent au plus ancien") -- appliqué EN DERNIER,
                # après le filtre par motif/plage temporelle, PAR SOURCE
                # (décision explicite utilisateur : chaque section est
                # tronquée indépendamment, pas le total agrégé). Les
                # lignes de chaque source sont en ordre chronologique
                # CROISSANT (plus ancienne en premier -- cf.
                # tampon_journal.lignes pour mAutoniax, même convention
                # pour Serveur/sAutoniax), donc "les plus récentes" sont
                # en FIN de liste : lignes[-n:] garde la fin, pas le
                # début. math.ceil plutôt qu'une division entière plate,
                # pour qu'un pourcentage non nul sur une poignée de
                # lignes ne retombe jamais à 0 ligne conservée (ex : 1
                # ligne à 50% garde cette ligne, ne la perd pas à cause
                # d'un arrondi vers le bas). pourcentage_conservation=100
                # (valeur par défaut/comportement pré-existant) laisse
                # lignes intact, aucun slicing effectué.
                if lignes and pourcentage_conservation < 100:
                    if pourcentage_conservation <= 0:
                        lignes = []
                    else:
                        nb_a_garder = math.ceil(len(lignes) * pourcentage_conservation / 100)
                        lignes = lignes[-nb_a_garder:]
                if lignes:
                    corps = "\n".join(lignes)
                elif plage_temporelle is not None:
                    corps = "(aucune ligne de log dans cette fenêtre d'exécution)"
                elif motif_filtre_bas:
                    corps = f"(aucune ligne ne contient « {motif_filtre} »)"
                elif pourcentage_conservation <= 0:
                    corps = "(0% de logs conservés)"
                else:
                    corps = "(aucune ligne de log)"
            else:
                corps = f"(échec de la récupération : {contenu})"
                echecs.append(titre)
            blocs.append(f"{entete}\n{corps}")

        texte_final = "\n\n".join(blocs)
        QGuiApplication.clipboard().setText(texte_final)
        if plage_temporelle is not None:
            log_reseau_t.info(
                f"[Copier les logs de cette exécution] {len(etat['ordre'])} section(s) copiée(s) "
                f"dans le presse-papier (fenêtre : {plage_temporelle[0]:.0f} -> {plage_temporelle[1]:.0f})."
            )
        elif motif_filtre:
            log_reseau_t.info(
                f"[Copier tous les logs] {len(etat['ordre'])} section(s) copiée(s) dans le presse-papier "
                f"(filtre appliqué : « {motif_filtre} »)."
            )
        else:
            log_reseau_t.info(f"[Copier tous les logs] {len(etat['ordre'])} section(s) copiée(s) dans le presse-papier.")

        parametres_screen = self.screens.get("parametres")
        message_succes = (
            f"Logs de cette exécution copiés dans le presse-papier ({len(etat['ordre'])} source(s))."
            if plage_temporelle is not None
            else f"Logs copiés dans le presse-papier ({len(etat['ordre'])} source(s))."
        )
        if echecs:
            message_succes = (
                f"Logs copiés dans le presse-papier -- échec pour : {', '.join(echecs)} "
                f"(section incluse avec le message d'erreur)."
            )
        if plage_temporelle is not None:
            self.statusBar().showMessage(message_succes, 6000)
        if parametres_screen is not None:
            parametres_screen.afficher_resultat_copie_logs(True, message_succes)

    def _build_screens(self):
        # Écran Dashboard (12.4) : remplace l'ancien PlaceholderScreen.
        # Instancié seulement si websockets est disponible -- sinon on
        # retombe sur le placeholder d'origine plutôt que de crasher
        # (même logique défensive que VISION_DISPONIBLE pour numpy/cv2).
        if RESEAU_DASHBOARD_DISPONIBLE:
            dashboard_screen = DashboardScreen(self.project, self.reglages)
        else:
            dashboard_screen = PlaceholderScreen(
                "Dashboard", "Module 'websockets' non installé — Dashboard indisponible",
                "mdi6.view-dashboard-outline",
            )
        self.screens["dashboard"] = dashboard_screen
        self.content_stack.addWidget(dashboard_screen)

        placeholders = []
        for key, title, subtitle, icon_name in placeholders:
            screen = PlaceholderScreen(title, subtitle, icon_name)
            self.screens[key] = screen
            self.content_stack.addWidget(screen)

        # Écran Paramètres (section Débogage : choix de la fenêtre
        # présélectionnée automatiquement dans les écrans de test — cf.
        # ParametresScreen et ReglagesApp).
        parametres_screen = ParametresScreen(self.reglages)
        self.screens["parametres"] = parametres_screen
        self.content_stack.addWidget(parametres_screen)

        # PATCH (onglet "Raccourcis") -- fermeture_app est posé en
        # QShortcut (cf. MainWindow.__init__/_rafraichir_raccourci_
        # fermeture_app), contrairement aux raccourcis "Internes" comme
        # rafraichissement_toggle/selection_capture_toggle/task_executer_
        # tout_toggle qui relisent charger_raccourcis_app() en direct à
        # chaque frappe (cf. _touche_correspond_au_raccourci) : un
        # QShortcut a besoin d'être resynchronisé EXPLICITEMENT quand le
        # combo change, d'où cette connexion à raccourcis_app_changes
        # (émis par ParametresScreen à chaque modification/reset réel
        # d'un raccourci) pour qu'une réassignation de Ctrl+Echap depuis
        # l'onglet Raccourcis prenne effet immédiatement, sans attendre
        # un redémarrage de l'app.
        parametres_screen.raccourcis_app_changes.connect(self._rafraichir_raccourci_fermeture_app)
        # AJOUT (raccourci mettre_a_jour_autoniax_cloud) -- même patron
        # exact que fermeture_app juste au-dessus.
        parametres_screen.raccourcis_app_changes.connect(self._rafraichir_raccourci_maj_autoniax_cloud)
        # AJOUT (raccourci redemarrer_tous_sautoniax) -- même patron
        # exact que les deux au-dessus.
        parametres_screen.raccourcis_app_changes.connect(self._rafraichir_raccourci_redemarrer_tous_sautoniax)
        # AJOUT (raccourci redemarrer_application_autoniax) -- même patron
        # exact que les trois au-dessus.
        parametres_screen.raccourcis_app_changes.connect(self._rafraichir_raccourci_redemarrer_application)
        # AJOUT (raccourci copier_doc_ia, désormais QShortcut global --
        # cf. docstring de son initialisation dans __init__ pour le
        # correctif qui a motivé ce passage depuis un raccourci
        # "Interne") -- même patron exact que les trois au-dessus.
        parametres_screen.raccourcis_app_changes.connect(self._rafraichir_raccourci_copier_doc_ia)
        # AJOUT (raccourcis notebook_copier_fichier_py/notebook_coller,
        # demande explicite utilisateur : "ajoute des raccourcis de copie
        # de fichier .py du code du notebook comme son bouton le fait,
        # ajoute aussi un raccourci pour le collage du code notebook") --
        # même patron exact que copier_doc_ia juste au-dessus (QShortcut
        # global d'emblée, combo vide par défaut -- personnalisable par
        # l'utilisateur via l'onglet Raccourcis).
        parametres_screen.raccourcis_app_changes.connect(self._rafraichir_raccourci_notebook_copier_fichier_py)
        parametres_screen.raccourcis_app_changes.connect(self._rafraichir_raccourci_notebook_coller)
        # AJOUT (raccourcis sync_service_api_seul_toggle/sync_project_
        # json_seul_toggle, demande explicite utilisateur : "un raccourci
        # clavier pour mettre a jour projet.json seule, et service api
        # seule") -- même patron exact que copier_doc_ia juste au-dessus
        # (QShortcut global d'emblée, cf. son commentaire CORRECTIF).
        parametres_screen.raccourcis_app_changes.connect(self._rafraichir_raccourci_sync_service_api_seul)
        parametres_screen.raccourcis_app_changes.connect(self._rafraichir_raccourci_sync_project_json_seul)
        # AJOUT (raccourci toujours_arriere_plan_toggle, toggle "Toujours
        # en arrière-plan" de l'onglet Général) -- même patron exact que
        # les raccourcis "Application" ci-dessus (QShortcut global
        # d'emblée, resynchronisé à chaque modification/reset).
        parametres_screen.raccourcis_app_changes.connect(self._rafraichir_raccourci_toujours_arriere_plan)
        # Bascule du toggle UI (onglet Général) -- applique le nouveau
        # window flag EN DIRECT sur cette fenêtre (cf. docstring du
        # signal toujours_arriere_plan_changee et de _appliquer_
        # toujours_arriere_plan).
        parametres_screen.toujours_arriere_plan_changee.connect(self._appliquer_toujours_arriere_plan)

        # BRANCHEMENT bouton "Charger les banques" (section MOUVEMENT HUMAIN
        # de ParametresScreen) -- le worker/thread vit dans MainWindow (cf.
        # PrechargementBanquesWorker, lancer_prechargement_banques), l'écran
        # ne fait qu'émettre la demande et afficher le résultat. Sans ces
        # deux connexions, le bouton émettait demande_precharger_banques
        # dans le vide (rien ne chargeait jamais rien) : c'était le bug
        # restant, corrigé ici.
        parametres_screen.demande_precharger_banques.connect(self.lancer_prechargement_banques)
        self.banques_prechargement_termine.connect(parametres_screen.afficher_resultat_prechargement_banques)

        # Écran API (Phase C : grille de ServiceAPI -> éditeur Composants
        # uniquement. Les Actions sont désormais globales au Project
        # (Project.bibliotheque_actions), simples fonctions natives isolées
        # du code -- pas d'UI d'édition dédiée, plus de Features.)
        service_api_screen = ServiceAPIScreen(self.project)
        service_api_screen.demande_ouvrir_test_composant.connect(self._ouvrir_test_composant)
        service_api_screen.demande_ouvrir_config_layout.connect(self._ouvrir_config_layout)
        # AJOUT (retrait de l'onglet Test intégré à ComposantLayoutConfigScreen,
        # cf. docstring de PanneauProprietesLayoutFlottant.demande_tester) --
        # MÊME patron que les deux connexions juste au-dessus.
        service_api_screen.demande_ouvrir_test_composant_layout.connect(self._ouvrir_test_composant_layout)
        self.screens["api"] = service_api_screen
        self.content_stack.addWidget(service_api_screen)

        # Écran TaskConfig : grille de Tasks -> éditeur (panneau composants
        # importés + script Python), cf. TaskConfigScreen plus haut dans ce
        # fichier. Remplace l'ancien PlaceholderScreen maintenant que la
        # classe est écrite.
        taskconfig_screen = TaskConfigScreen(self.project, self.reglages)
        taskconfig_screen.demande_ouvrir_coordonnee_action.connect(self._ouvrir_coordonnee_action)
        # PATCH B.5 -- même patron que demande_ouvrir_coordonnee_action
        # juste au-dessus (cf. sa docstring de signal côté TaskConfigScreen).
        taskconfig_screen.demande_ouvrir_rendu_reseau.connect(self._ouvrir_rendu_task_reseau)
        self.screens["taskconfig"] = taskconfig_screen
        self.content_stack.addWidget(taskconfig_screen)
        QTimer.singleShot(400, taskconfig_screen.precharger_editeur)   # PATCH (préchauffage)
        QTimer.singleShot(0, TraceOuverture.preparer)   # PATCH6 (diagnostic ouverture)

        # PATCH -- lien inter-écrans injecté par MainWindow (seule à
        # connaître à la fois service_api_screen et taskconfig_screen),
        # même patron que les .connect(...) ci-dessus mais via callback
        # plutôt que signal : ComposantsScreen (dans service_api_screen)
        # a besoin de lire l'état COURANT de l'image de rendu réseau AU
        # MOMENT du clic sur son bouton "capturer depuis le rendu", pas
        # de réagir à un événement -- cf. ServiceAPIScreen.definir_source_
        # rendu_reseau / ComposantsScreen.definir_source_rendu_reseau.
        # taskconfig_screen._fenetre_rendu_reseau est None tant que le
        # panneau n'a jamais été ouvert (cf. son __init__) -- le callback
        # gère ce cas sans lever d'exception.
        def _prendre_captures_selectionnees_reseau() -> list:
            """PATCH (mode sélection multiple, demande explicite
            utilisateur) -- second callback injecté à côté du premier :
            renvoie la liste des zones déjà découpées dans le panneau de
            rendu réseau (FenetreRenduTaskReseau._captures_selectionnees)
            ET la VIDE dans la foulée côté source, pour qu'un import ne
            soit jamais rejoué deux fois (même principe que consommer une
            file d'attente). Liste vide si le panneau n'a jamais été
            ouvert -- même garde-fou que le callback image ci-dessous."""
            fenetre = taskconfig_screen._fenetre_rendu_reseau
            if fenetre is None:
                return []
            captures = fenetre._captures_selectionnees
            fenetre._captures_selectionnees = []
            return captures

        def _consulter_captures_selectionnees_reseau() -> list:
            """AJOUT (demande explicite utilisateur : choisir UNE capture
            parmi celles déjà en attente pour mettre à jour l'image d'un
            composant existant, ou lui ajouter une variante, SANS perdre
            les autres captures non choisies) -- troisième callback,
            complémentaire de _prendre_captures_selectionnees_reseau
            ci-dessus : celui-ci CONSULTE seulement (copie défensive, la
            liste d'origine côté FenetreRenduTaskReseau n'est jamais
            vidée ni modifiée ici). Le retrait de l'unique capture
            effectivement choisie se fait séparément, cf.
            _retirer_capture_selectionnee_reseau juste en dessous."""
            fenetre = taskconfig_screen._fenetre_rendu_reseau
            if fenetre is None:
                return []
            return list(fenetre._captures_selectionnees)

        def _retirer_capture_selectionnee_reseau(index: int):
            """AJOUT -- retire UNE capture précise (par index dans la
            liste renvoyée par _consulter_captures_selectionnees_reseau,
            prise à l'instant T) de FenetreRenduTaskReseau._captures_
            selectionnees, une fois qu'elle a été utilisée pour mettre à
            jour l'image d'un composant ou lui ajouter une variante --
            même mécanique que FenetreRenduTaskReseau._supprimer_capture_
            selectionnee (bouton "x" de la galerie), réutilisée ici pour
            que la capture consommée ne réapparaisse pas indéfiniment
            dans la liste."""
            fenetre = taskconfig_screen._fenetre_rendu_reseau
            if fenetre is None:
                return
            if 0 <= index < len(fenetre._captures_selectionnees):
                del fenetre._captures_selectionnees[index]

        service_api_screen.definir_source_rendu_reseau(
            lambda: (
                taskconfig_screen._fenetre_rendu_reseau._derniere_image
                if taskconfig_screen._fenetre_rendu_reseau is not None
                else None
            ),
            _prendre_captures_selectionnees_reseau,
            _consulter_captures_selectionnees_reseau,
            _retirer_capture_selectionnee_reseau,
        )

        # Synchronisation bidirectionnelle des deux contrôles de taille de
        # police (toolbar de l'éditeur TaskConfig <-> écran Paramètres) --
        # les deux pointent vers le même réglage persistant (ReglagesApp.
        # taille_police_editeur_script), donc doivent toujours s'accorder.
        def _sync_depuis_parametres(taille_pt: int):
            for widget in taskconfig_screen._cellule_widgets.values():
                widget.editeur.appliquer_taille_police(taille_pt)
            if taskconfig_screen._liste_virtuelle_active():   # PATCH (étape 3)
                taskconfig_screen._liste_virtuelle.invalider_hauteurs()
            taskconfig_screen.spin_taille_police_editeur.blockSignals(True)
            taskconfig_screen.spin_taille_police_editeur.setValue(taille_pt)
            taskconfig_screen.spin_taille_police_editeur.blockSignals(False)

        def _sync_vers_parametres(taille_pt: int):
            parametres_screen.spin_taille_police.blockSignals(True)
            parametres_screen.spin_taille_police.setValue(taille_pt)
            parametres_screen.spin_taille_police.blockSignals(False)

        parametres_screen.taille_police_editeur_changee.connect(_sync_depuis_parametres)
        taskconfig_screen.spin_taille_police_editeur.valueChanged.connect(_sync_vers_parametres)

        # PATCH (demande explicite utilisateur : "un bouton toggle dans les
        # paramètres qui va désactiver la sortie de cellules quand on a
        # exécuté un notebook... je veux pouvoir bloquer l'affichage de
        # sortie") -- propage IMMÉDIATEMENT le blocage à toutes les cellules
        # du notebook actuellement ouvert dans TaskConfigScreen, sans
        # attendre une réouverture (même circuit que la taille de police
        # juste au-dessus). Les cellules créées ensuite lisent, elles,
        # directement le réglage persisté à leur construction (cf.
        # TaskCelluleWidget.__init__). NB : `parametres_screen` et
        # `taskconfig_screen` sont les MÊMES variables locales que celles
        # utilisées par _sync_depuis_parametres ci-dessus.
        def _appliquer_blocage_sortie_aux_cellules(bloque: bool):
            for widget in taskconfig_screen._cellule_widgets.values():
                widget.definir_sortie_bloquee(bloque)

        parametres_screen.bloquer_sortie_cellules_changee.connect(_appliquer_blocage_sortie_aux_cellules)

        # PATCH (retour utilisateur : désactiver "Fermer les instances à
        # la fermeture" en cours de session puis fermer l'app tuait quand
        # même les instances -- "sa ne prend pas en compte directement")
        # : resynchronise immédiatement le Job Object Windows du
        # Dashboard sur le nouvel état du réglage dès qu'il bascule dans
        # Paramètres, au lieu d'attendre le prochain lancement d'instance
        # ou un redémarrage complet de l'app (cf. ProfilsInstancesScreen.
        # _synchroniser_job_object_instances). Uniquement si le vrai
        # Dashboard a bien pu être construit (cf. RESEAU_DASHBOARD_
        # DISPONIBLE ci-dessus) -- le PlaceholderScreen de repli n'a pas
        # d'attribut profils_instances_screen, et de toute façon, sans
        # websockets, aucune instance ne peut être lancée depuis l'UI.
        #
        # LOGS DIAGNOSTIC (retour utilisateur : "le fix ne fonctionne pas
        # toujours") -- try/except explicite autour du lambda : PyQt/
        # PySide peut avaler silencieusement une exception levée DANS un
        # slot connecté à un signal (juste un warning succinct en console,
        # facile à manquer), ce qui masquerait un vrai plantage ici sans
        # jamais atteindre _synchroniser_job_object_instances. Confirme
        # aussi, sans ambiguïté, si cette connexion a bien été établie du
        # tout au démarrage (log [CONNECT-TOGGLE] immédiat ci-dessous) et
        # si le lambda est bien déclenché à chaque bascule ([TOGGLE-SLOT]).
        log_dashboard_ui.info(
            f"[CONNECT-TOGGLE] RESEAU_DASHBOARD_DISPONIBLE={RESEAU_DASHBOARD_DISPONIBLE!r} -- "
            f"{'connexion établie' if RESEAU_DASHBOARD_DISPONIBLE else 'connexion NON établie (voir cause ci-dessus)'} "
            f"entre fermer_instances_a_fermeture_changee et _synchroniser_job_object_instances."
        )
        if RESEAU_DASHBOARD_DISPONIBLE:
            def _sur_toggle_fermer_instances(_actif):
                log_dashboard_ui.info(f"[TOGGLE-SLOT] slot déclenché (_actif={_actif!r}) -- appel de _synchroniser_job_object_instances()...")
                try:
                    dashboard_screen.profils_instances_screen._synchroniser_job_object_instances()
                    log_dashboard_ui.info("[TOGGLE-SLOT] _synchroniser_job_object_instances() terminé sans exception.")
                except Exception:
                    log_dashboard_ui.exception("[TOGGLE-SLOT] EXCEPTION levée dans _synchroniser_job_object_instances() -- voir traceback ci-dessus.")
            parametres_screen.fermer_instances_a_fermeture_changee.connect(_sur_toggle_fermer_instances)

        # Écran Applications (5ème section sidebar, à la demande de
        # l'utilisateur — conteneur générique à onglets, vide par défaut ;
        # remplace la 5ème icône fixe "Test de composant" et le QDialog
        # de test initial)
        applications_screen = ApplicationsScreen(self.project, self.reglages)
        applications_screen.demande_retour.connect(self._retour_depuis_applications)
        # CORRECTIF (bug rapporté : "j'ai renommé un cL et ça n'apparaît
        # même plus [dans la grille ComposantLayout]") -- relais retour,
        # symétrique à demande_ouvrir_config_layout juste au-dessus (qui
        # descend de ServiceAPIScreen vers ApplicationsScreen) : ici le
        # renommage remonte d'ApplicationsScreen (où il a réellement lieu,
        # cf. ComposantLayoutConfigScreen.composant_layout_renomme) vers
        # ServiceAPIScreen, seul à connaître composants_layout_tab. Posé
        # ICI (pas plus haut à la construction de service_api_screen) car
        # applications_screen n'existe pas encore à ce moment-là.
        applications_screen.composant_layout_renomme.connect(service_api_screen.sur_composant_layout_renomme)
        # CORRECTIF (retour utilisateur : "le badge de validation... je
        # suis obligé de rouvrir la page des composants pour que ça
        # prenne effet") -- MÊME câblage EXACT que composant_layout_
        # renomme juste au-dessus, pour le cas d'une modification en
        # place (toggle "Validé" en particulier, cf. docstring du signal
        # côté ApplicationsScreen).
        applications_screen.composant_layout_modifie_relais.connect(service_api_screen.sur_composant_layout_modifie)
        self.screens["applications"] = applications_screen
        self.content_stack.addWidget(applications_screen)

        # Écran Réseau (5ème section sidebar) : QTabWidget dont "Git" est
        # le premier onglet -- édition + push du serveurT, cf. GitScreen
        # (PATCH : "remlacer liconde de sidebare git par licone resau,
        # git ne doit etre que on onglet de reseau"). reglages transmis
        # (pas project) : les identifiants GitHub/URL du dépôt sont des
        # réglages locaux machine, pas des données de projet partageables.
        reseau_screen = ReseauScreen(self.reglages)
        self.screens["reseau"] = reseau_screen
        self.content_stack.addWidget(reseau_screen)

        # Client serveurT (PATCH -- demande explicite utilisateur : "sa
        # doit essayer de se connecter au serveur au demarage, et je veux
        # que dans la paritie reau on affihcie le nombre dinstance
        # autoniax conncter"). Démarré ici, après la construction de
        # reseau_screen ci-dessus, pour pouvoir connecter ses signaux à
        # l'onglet Instances dès le départ -- aucun message émis avant
        # cette connexion ne peut donc être manqué. Le client tourne dans
        # son propre thread (cf. ClientServeurT) : ce démarrage ne bloque
        # pas la construction de l'UI.
        #
        # PATCH stockage R2 (demande explicite utilisateur : "je veux que
        # on connecte deja notre stokage cloudflare avec notre serveur")
        # -- config_stockage construite depuis les Réglages persistés
        # (r2_access_key_id, etc.), transmise dès l'instanciation. Reste
        # vide/no-op côté serveurT tant que l'utilisateur n'a rien
        # renseigné (cf. GitScreen -- même onglet Réglages Git/Stockage).
        self.client_serveur_t = ClientServeurT(config_stockage=_config_stockage_depuis_reglages(self.reglages))

        # PATCH (SPEC_proxy_natif_tunnel.md, section 7) -- ServiceSortieProxy
        # réutilise la boucle réseau de client_serveur_t (cf. son docstring,
        # "IMPORTANT" -- pas de troisième boucle asyncio pour le process).
        # `lambda: getattr(self.client_serveur_t, "_loop", None)` plutôt
        # qu'une référence figée à sa boucle ACTUELLE : self._loop est
        # recréée par ClientServeurT._thread_principal à CHAQUE
        # (re)connexion (cf. son docstring PATCH reconnexion), donc une
        # capture figée deviendrait une boucle fermée après la première
        # coupure réseau.
        self.service_sortie_proxy = ServiceSortieProxy(
            self.client_serveur_t._id_pilote_stable,
            lambda: getattr(self.client_serveur_t, "_loop", None),
        )

        # PATCH (demande explicite utilisateur : "je veux que tu me disen
        # sil a finit le dernier correctif" -> puis "ques ce qui vas se
        # passee si il ya plusier profils sur une instance" -- le
        # sélecteur "Instance cible" groupe RÉSEAU de TestComposantScreen
        # ne listait jusqu'ici que le sAutoniax lui-même (id_executant,
        # ex. "sAutoniax-1"), jamais les profils réellement actifs
        # dessus -- en réutilisant CE MÊME id_executant comme instance_id
        # (cf. _AdapteurSequenceurReseauSautoniax.envoyer_commande), un
        # mode "mono-profil" qui ne peut pas fonctionner correctement dès
        # que PLUSIEURS profils tournent en même temps sur un même
        # sAutoniax (id_executant ne désigne alors aucun des deux profils
        # réels côté sAutoniax).
        #
        # self.instances_par_profil_reseau : {id_executant: {nom_profil:
        # instance_id}} -- construit ICI, côté client, à partir des DEUX
        # signaux déjà émis par ClientServeurT pour d'autres besoins
        # (jamais consommés jusqu'ici pour peupler un sélecteur de
        # profil) : demarrer_profil_isole_resultat_recu (AJOUTE une
        # entrée, id_executant/nom_profil/instance_id réels du profil
        # qui vient de démarrer) et kill_profil_resultat_reel_recu
        # (RETIRE l'entrée quand redemarrer=False -- si redemarrer=True,
        # le profil va se reconnecter avec un instance_id DIFFÉRENT, cf.
        # sautoniax-isole-<profil>-<hex aléatoire> dans les logs sAutoniax,
        # donc gardé pour l'instant : le prochain demarrer_profil_isole_
        # resultat_recu le remplacera de toute façon avec le nouvel id).
        # PAS alimenté par Registre.profils_en_cours côté serveur.py --
        # cette structure-là est réservée aux Projets Distribués/Batch
        # (session_id/id_projet_batch), pas exposée telle quelle au
        # pilote (cf. sa docstring : "reste interne au serveur"), et de
        # toute façon insuffisante ici (pas d'instance_id dedans).
        self.instances_par_profil_reseau: dict[str, dict[str, str]] = {}

        def _sur_demarrage_profil_isole_pour_registre(
            id_executant: str, nom_profil: str, ok: bool, instance_id: str, message: str,
        ):
            if not ok or not instance_id:
                return
            self.instances_par_profil_reseau.setdefault(id_executant, {})[nom_profil] = instance_id
            applications_screen.definir_instances_par_profil_reseau(self.instances_par_profil_reseau)

        def _sur_kill_profil_pour_registre(
            id_executant: str, nom_profil: str, redemarrer: bool, ok: bool, message: str,
        ):
            if not ok or redemarrer:
                return
            profils_executant = self.instances_par_profil_reseau.get(id_executant)
            if profils_executant is not None:
                profils_executant.pop(nom_profil, None)
                applications_screen.definir_instances_par_profil_reseau(self.instances_par_profil_reseau)

        self.client_serveur_t.demarrer_profil_isole_resultat_recu.connect(_sur_demarrage_profil_isole_pour_registre)
        self.client_serveur_t.kill_profil_resultat_reel_recu.connect(_sur_kill_profil_pour_registre)

        # PATCH (retour utilisateur : "j'ai créé un profil sur un
        # sAutoniax et démarré le profil [via Notebook Distant, bouton
        # "Initialiser" de TaskConfigScreen], et l'app de test de
        # composant dit qu'il n'y a aucun profil actif") -- cause :
        # instances_par_profil_reseau (ci-dessus) n'était JUSQU'ICI
        # alimenté QUE par le flux "profil isolé" (demarrer_profil_isole_
        # resultat_recu), jamais par le flux "Notebook Distant"
        # (initialiser_notebook_distant_resultat_recu) -- deux façons de
        # démarrer un profil sur un sAutoniax, mais une seule notifiait
        # ce registre. Décision explicite utilisateur : les deux doivent
        # y apparaître.
        #
        # initialiser_notebook_distant_resultat_recu ne transmet QUE
        # (session_id, id_executant, ok, message) -- ni nom_profil ni
        # instance_id (cf. protocole serveur, jamais étendu pour les
        # transporter). nom_profil est donc capturé ICI, au moment de la
        # DEMANDE (seul point où le pilote le connaît), dans ce dict
        # local session_id -> nom_profil, consommé puis retiré au
        # résultat -- même pattern que TaskConfigScreen._sessions_
        # initialisation_reseau (dict local analogue, cf. sa docstring),
        # en parallèle et indépendamment de lui (deux dicts distincts,
        # deux consommateurs distincts du même résultat).
        #
        # instance_id : AUCUNE valeur distincte n'est jamais renvoyée par
        # ce protocole pour le mode Notebook Distant (contrairement au
        # profil isolé, où le sAutoniax génère et renvoie explicitement
        # un instance_id dédié) -- la convention déjà en place ailleurs
        # pour ce mode (cf. demande_capture_ponctuelle_notebook_distant/
        # demande_taux_capture_notebook_distant plus bas dans cette
        # méthode : "instance_id == id_executant ici, mode mono-profil
        # Task réseau : un seul flux de capture par sAutoniax ciblé") est
        # donc réutilisée telle quelle ici, pour rester cohérent avec ce
        # que le panneau de rendu réseau cible déjà réellement pour cette
        # instance.
        self._sessions_notebook_distant_pour_registre: dict[str, str] = {}

        def _sur_resultat_initialisation_notebook_distant_pour_registre(
            session_id: str, id_executant: str, ok: bool, message: str,
        ):
            nom_profil = self._sessions_notebook_distant_pour_registre.pop(session_id, None)
            if not ok or not nom_profil:
                return
            self.instances_par_profil_reseau.setdefault(id_executant, {})[nom_profil] = id_executant
            applications_screen.definir_instances_par_profil_reseau(self.instances_par_profil_reseau)

        self.client_serveur_t.initialiser_notebook_distant_resultat_recu.connect(
            _sur_resultat_initialisation_notebook_distant_pour_registre
        )

        # PATCH (retour utilisateur : "jai redemarer mautonix et dans
        # linterface de test, sa naffiche pas profils actifs" -- alors
        # que l'onglet Instances sAutoniax, lui, les affiche correctement
        # une fois cliqué) -- cause racine : TOUT ce qui précède
        # n'alimente instances_par_profil_reseau qu'à partir d'ÉVÉNEMENTS
        # PONCTUELS de démarrage/arrêt (démarrer_profil_isole_resultat_
        # recu, kill_profil_resultat_reel_recu, initialiser_notebook_
        # distant_resultat_recu) -- jamais rejoués pour des profils qui
        # tournaient DÉJÀ côté sAutoniax avant que ce client ne se
        # (re)connecte. Le registre repart donc toujours vide après un
        # redémarrage d'AutoniaX, même si le serveur, lui, sait très bien
        # que des profils sont actifs.
        #
        # profils_sautoniax_recu (id_executant, profils), déjà émis pour
        # alimenter PanneauProprietesSautoniax (cf. son câblage plus haut)
        # EST cet état réel et complet : chaque entrée contient déjà
        # {"nom", "actif", "instance_id"} pour CE sAutoniax précis (scan
        # disque + statut réel côté exécutant, cf. sa docstring). Deux
        # ajouts, tous deux nécessaires ensemble :
        #
        # 1) SYNCHRONISATION -- écoute ICI ce même signal (Qt permet
        #    plusieurs abonnés indépendants sur un seul signal, donc ceci
        #    s'ajoute au câblage PanneauProprietesSautoniax existant sans
        #    le modifier ni le dupliquer) pour REMPLACER entièrement
        #    (pas fusionner -- une liste avec un profil retiré doit aussi
        #    disparaître d'ici) l'entrée de ce sAutoniax dans le registre.
        # 2) DÉCLENCHEMENT AUTOMATIQUE -- sans demande explicite envoyée
        #    au serveur, ce signal ne revient jamais de lui-même. cf.
        #    juste plus bas (câblage sur executants_detail_change) : une
        #    demande est émise pour CHAQUE sAutoniax connu dès qu'il
        #    apparaît, sans attendre qu'un utilisateur clique sur sa
        #    ligne dans l'onglet Instances.
        def _sur_profils_sautoniax_recu_pour_registre(id_executant: str, profils: list):
            profils_actifs = {
                p["nom"]: p.get("instance_id") or id_executant
                for p in profils if p.get("nom") and p.get("actif")
            }
            if profils_actifs:
                self.instances_par_profil_reseau[id_executant] = profils_actifs
            else:
                self.instances_par_profil_reseau.pop(id_executant, None)
            applications_screen.definir_instances_par_profil_reseau(self.instances_par_profil_reseau)

        self.client_serveur_t.profils_sautoniax_recu.connect(_sur_profils_sautoniax_recu_pour_registre)

        # Déclenchement automatique -- un sAutoniax déjà connu au moment
        # de la (re)connexion ne provoque jamais demarrer_profil_isole_
        # resultat_recu/kill_profil_resultat_reel_recu/initialiser_
        # notebook_distant_resultat_recu (ces signaux ne rejouent que des
        # actions FUTURES) : sans cette demande explicite, le cas
        # "profils déjà actifs avant redémarrage" ne serait toujours pas
        # couvert malgré l'écoute ajoutée ci-dessus. Un set mémorise les
        # id_executant déjà demandés pour ne pas renvoyer la demande à
        # CHAQUE répétition de executants_detail_change (émis en continu,
        # cf. sa docstring) -- une seule demande par sAutoniax qui
        # apparaît, le rafraîchissement manuel (bouton "Rafraîchir" de
        # PanneauProprietesSautoniax) restant disponible pour rescanner
        # à la demande en cas de changement ultérieur.
        self._sautoniax_deja_interroges_pour_registre: set = set()

        def _sur_executants_change_demander_profils_pour_registre(executants: list):
            ids_actuels = {e.get("id", "") for e in executants if e.get("id")}
            # Un sAutoniax disparu de la liste (déconnecté) est retiré du
            # set -- si le même sAutoniax se reconnecte plus tard dans
            # CETTE session (pas seulement au redémarrage complet
            # d'AutoniaX), sa demande doit repartir : ses profils ont pu
            # changer pendant la déconnexion, l'ancien cache serait
            # potentiellement obsolète.
            self._sautoniax_deja_interroges_pour_registre &= ids_actuels
            for id_executant in ids_actuels:
                if id_executant not in self._sautoniax_deja_interroges_pour_registre:
                    self._sautoniax_deja_interroges_pour_registre.add(id_executant)
                    self.client_serveur_t.demander_profils_sautoniax(id_executant)

        self.client_serveur_t.executants_detail_change.connect(
            _sur_executants_change_demander_profils_pour_registre
        )

        instances_screen = reseau_screen.instances_screen
        self.client_serveur_t.connecte.connect(instances_screen.sur_connecte)
        self.client_serveur_t.deconnecte.connect(instances_screen.sur_deconnecte)
        self.client_serveur_t.nombre_executants_change.connect(instances_screen.sur_nombre_executants_change)
        # PATCH (demande explicite utilisateur : pastille verte/grise sur
        # l'icône "reseau" de la Sidebar, reflétant en direct l'état de
        # connexion au serveurT -- cf. Sidebar.definir_statut_serveur_t).
        self.client_serveur_t.connecte.connect(lambda: self.sidebar.definir_statut_serveur_t(True))
        self.client_serveur_t.deconnecte.connect(lambda: self.sidebar.definir_statut_serveur_t(False))
        reseau_screen.stockage_modifie.connect(self.client_serveur_t.definir_config_stockage)
        # AJOUT (bouton "Redémarrer le serveurT" de ParametresScreen --
        # retour utilisateur : "pourquoi pas une fois lie avec la logique
        # de ping puisque la comande vient de lapp elle meme") --
        # connecté ICI (après la création de self.client_serveur_t,
        # contrairement à demande_precharger_banques câblé plus haut
        # avant ce point) car parametres_screen est construit AVANT
        # client_serveur_t dans cette méthode : ce branchement doit donc
        # attendre que les deux existent. cf. ClientServeurT.
        # forcer_reconnexion pour le détail de ce que fait cet appel.
        parametres_screen.demande_redemarrer_serveurt.connect(self.client_serveur_t.forcer_reconnexion)
        # PATCH D (cf. cahier des charges patchs.md -- 3 boutons
        # indépendants au lieu d'un bouton global + cases à cocher).
        # SCRIPT_INSTANCE_DASHBOARD (= Path(__file__).resolve(), déjà
        # défini plus haut dans le fichier) pointe vers AutoniaX.py
        # lui-même quel que soit le dossier d'où l'app est lancée -- pas
        # de chemin en dur ici, contrairement à D:\ScaleTube\...\Data
        # (get_app_data_dir). get_mouse_data_path() gère elle-même
        # l'absence du fichier (dossier créé mais mouseData.sqlite3 pas
        # forcément généré) -- cf. ClientServeurT._envoyer_mise_a_jour_app
        # qui traite un fichier manquant comme un échec propre. Le
        # signal ne porte plus que le NOM de l'élément à envoyer (str) --
        # les 3 chemins sont TOUJOURS résolus ici (peu coûteux), seul
        # l'élément demandé sera effectivement lu/envoyé côté
        # ClientServeurT (cf. sa docstring : "un seul des trois part par
        # appel"). get_service_api_dir() : même dossier LOCAL du pilote
        # que celui déjà utilisé par l'action "Mettre à jour le dossier
        # service API" par ligne de l'onglet Instances (§4.2), mais
        # envoyé ici vers App/service_api.zip plutôt que poussé
        # directement à UN sAutoniax précis : c'est la copie de
        # RÉFÉRENCE dans le cloud (cf. _sautoniax_assurer_donnees_de_base,
        # §4.7, qui la télécharge au premier démarrage d'un sAutoniax
        # fraîchement provisionné).
        # CORRECTIF (demande explicite utilisateur : "es ce que tu peu
        # modifie le serveur de tels sorteq que sa envoie aussi
        # directement a tout les sautoniax encours" -- au sujet du
        # bouton "Mettre à jour le dossier service API" de Stockage >
        # Mise à jour Système). Rien à modifier côté serveurT lui-même
        # (relais pur, cf. mettre_a_jour_service_api déjà existant et
        # déjà utilisé par l'action équivalente de l'onglet Instances) --
        # le "serveur" au sens large ici, c'est ce câblage pilote : pour
        # l'élément "service_api" UNIQUEMENT, EN PLUS de l'envoi cloud
        # existant ci-dessous (conservé tel quel, c'est la copie de
        # RÉFÉRENCE qu'un sAutoniax fraîchement provisionné télécharge à
        # son premier démarrage), le dossier synchronisé est aussi
        # poussé directement, dans la FOULÉE, à CHAQUE sAutoniax
        # actuellement connecté (cf. InstancesConnecteesScreen.tous_ids_
        # executants_connectes -- même méthode ClientServeurT.mettre_a_
        # jour_service_api que l'action par ligne/en masse de l'onglet
        # Instances, aucun nouveau protocole nécessaire) -- écrit par ce
        # sAutoniax au MÊME emplacement (get_service_api_dir(), cf.
        # mettre_a_jour_service_api_fin) que celui lu pour le template
        # matching, donc immédiatement pris en compte sans redémarrage.
        # synchroniser_service_api_dir() n'est appelée QU'UNE FOIS ici
        # (pas une fois par sAutoniax) -- son coût (parcours de
        # "components/") est indépendant du nombre de cibles.
        def _sur_demande_mise_a_jour_app(element: str):
            # synchroniser_service_api_dir() n'a de sens QUE pour l'élément
            # "service_api" (les 2 autres boutons n'utilisent jamais ce
            # chemin, cf. ClientServeurT._envoyer_mise_a_jour_app qui ne
            # lit que l'élément réellement demandé) -- get_service_api_dir()
            # (simple accesseur de chemin, sans coût de parcours) suffit
            # pour les deux autres cas, elle est de toute façon ignorée.
            chemin_service_api = (
                synchroniser_service_api_dir() if element == "service_api" else get_service_api_dir()
            )
            # AJOUT (project.json sur B2, cf. docstring de
            # ClientServeurT._envoyer_mise_a_jour_app pour la raison
            # d'être) -- get_project_json_path() est un simple accesseur de
            # chemin (aucun coût de parcours), passé inconditionnellement
            # comme chemin_service_api ci-dessus : ignoré par l'appelé pour
            # tout element différent de "project".
            self.client_serveur_t.envoyer_mise_a_jour_app(
                element, SCRIPT_INSTANCE_DASHBOARD, get_mouse_data_path(), chemin_service_api,
                get_project_json_path(),
            )
            if element == "service_api":
                ids_executants_connectes = instances_screen.tous_ids_executants_connectes()
                for id_executant in ids_executants_connectes:
                    self.client_serveur_t.mettre_a_jour_service_api(id_executant, str(chemin_service_api))
                if ids_executants_connectes:
                    log_reseau_t.info(
                        f"[Stockage] service API aussi poussé directement à "
                        f"{len(ids_executants_connectes)} sAutoniax connecté(s)."
                    )

        reseau_screen.demande_mise_a_jour_app.connect(_sur_demande_mise_a_jour_app)

        # CORRECTIF -- _sur_demande_pousser_vers_bb SUPPRIMÉ : l'envoi de
        # serveur.py vers le stockage cloud ne passe plus par ClientServeurT
        # (qui exigeait une connexion websocket active, impossible tant que
        # serveur.py n'est pas déjà publié -- dépendance circulaire).
        # GitScreen envoie maintenant directement via
        # GestionnaireStockageDriveDirect (appel Drive local via
        # PousserDriveWorker, cf. GitScreen._pousser_vers_drive --
        # MIGRATION TOTALE B2 -> Drive).
        self.client_serveur_t.mise_a_jour_app_resultat.connect(
            reseau_screen.stockage_screen.sur_resultat_mise_a_jour_app
        )
        # PATCH (upload fiabilisé -- protocole en chunks avec
        # retry+pause, cf. TransfertMiseAJourEnCours côté ClientServeurT)
        # -- même patron exact que mise_a_jour_app_resultat juste
        # au-dessus, pour les deux nouveaux signaux de progression/pause.
        self.client_serveur_t.mise_a_jour_app_progression.connect(
            reseau_screen.stockage_screen.sur_progression_mise_a_jour_app
        )
        self.client_serveur_t.mise_a_jour_app_pause.connect(
            reseau_screen.stockage_screen.sur_pause_mise_a_jour_app
        )
        # PATCH (upload fiabilisé) -- clic sur "Reprendre" côté
        # MiseAJourStockageScreen, relayé jusqu'ici via StockageScreen
        # puis ReseauScreen -- appelle directement reprendre_mise_a_jour_
        # app (méthode synchrone, thread-safe via run_coroutine_
        # threadsafe en interne, même patron que les autres méthodes
        # publiques de ClientServeurT).
        reseau_screen.demande_reprise_mise_a_jour_app.connect(self.client_serveur_t.reprendre_mise_a_jour_app)
        # PATCH A -- confirmation centrale en plus du label local
        # ci-dessus (cf. _afficher_message_statut_reseau).
        self.client_serveur_t.mise_a_jour_app_resultat.connect(
            lambda ok, nom_fichier, message: self._afficher_message_statut_reseau(
                ok, f"{nom_fichier} envoyé avec succès." if ok else f"Échec pour {nom_fichier} : {message}",
            )
        )
        # RETRAIT (cf. docstring Connexion.upload_service_api côté
        # serveur.py) : connect vers TaskConfigScreen.sur_resultat_maj_
        # app_cloud_reseau supprimé -- cette méthode a elle-même été
        # retirée (cf. son ancien emplacement), le serveur gérant
        # désormais seul l'upload cloud de service_api.zip/project.json
        # dans ses propres handlers _fin, plus besoin de ce relais.
        # PATCH (feedback réseau manquant) : même patron exact que
        # mise_a_jour_app_resultat juste au-dessus -- StockageScreen
        # reste le seul point d'entrée connu de MainWindow, elle relaie
        # elle-même vers son sous-écran Identifiant.
        self.client_serveur_t.stockage_configure_resultat.connect(
            reseau_screen.stockage_screen.sur_resultat_configuration_stockage
        )
        # PATCH A -- confirmation centrale, mais via resultat_confirme
        # (déjà filtré par _attente_confirmation_serveur côté Identifiant
        # StockageScreen) et non le signal brut ci-dessus : sinon une
        # reconnexion automatique afficherait un message dans la
        # statusBar sans rapport avec une action de l'utilisateur (cf.
        # docstring de IdentifiantStockageScreen.sur_resultat_
        # configuration_stockage).
        reseau_screen.resultat_confirme.connect(self._afficher_message_statut_reseau)
        # PATCH (sous-onglet "Stockage cloud" -- demande explicite
        # utilisateur : arborescence du bucket + bouton "Actualiser").
        # PATCH (Patch 4.3) : stockage_liste_resultat est désormais
        # distribué à DEUX écrans (StockageCloudScreen -- arborescence
        # brute -- ET ProfilsCloudScreen -- table filtrée sur Test/
        # Profils/, cf. ReseauScreen.demande_liste_stockage, connecté
        # depuis les DEUX écrans vers ce même signal côté ReseauScreen).
        reseau_screen.demande_liste_stockage.connect(self.client_serveur_t.demander_liste_stockage)
        self.client_serveur_t.stockage_liste_resultat.connect(
            reseau_screen.stockage_screen.sur_resultat_liste_stockage
        )
        self.client_serveur_t.stockage_liste_resultat.connect(
            reseau_screen.profils_screen.sur_resultat_liste_stockage
        )
        # PATCH E.2 -- troisième abonné au même signal partagé (cf.
        # docstring de BatchTraiteScreen) : filtre lui-même les clés
        # "Batch Traité/", aucun nouveau message serveur nécessaire.
        self.client_serveur_t.stockage_liste_resultat.connect(
            reseau_screen.batch_traite_screen.sur_resultat_liste_stockage
        )
        # PATCH (clic-droit "Supprimer" dans Stockage cloud -- demande
        # explicite utilisateur) -- même patron exact que demande_liste_
        # stockage/stockage_liste_resultat juste au-dessus, mais un seul
        # abonné (StockageCloudScreen, seul écran qui affiche des
        # éléments individuellement supprimables pour l'instant).
        reseau_screen.demande_suppression_stockage.connect(self.client_serveur_t.demander_suppression_stockage)
        self.client_serveur_t.stockage_supprimer_resultat.connect(
