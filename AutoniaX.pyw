        self.setVisible(False)

    def _sur_clic_supprimer(self):
        if self._composant_layout_nom:
            self.demande_suppression.emit(self._composant_layout_nom)

    def _sur_clic_tester(self):
        if self._composant_layout_nom:
            self.demande_tester.emit(self._composant_layout_nom)

    def _sur_clic_modifier(self):
        if self._composant_layout_nom:
            self.demande_modifier.emit(self._composant_layout_nom)

    def afficher_pour(self, composant_layout_nom: str, pixmap: Optional[QPixmap]):
        self._composant_layout_nom = composant_layout_nom
        self._appliquer_pixmap(pixmap)
        self.setVisible(True)
        self.repositionner()
        self.raise_()

    def _appliquer_pixmap(self, pixmap: Optional[QPixmap]):
        if pixmap is None or pixmap.isNull():
            self.image_label.setText("Aperçu indisponible")
            self.image_label.setPixmap(QPixmap())
            return
        cible = self.image_label.size()
        if cible.width() > 0 and cible.height() > 0:
            pixmap = pixmap.scaled(cible, Qt.KeepAspectRatio, Qt.SmoothTransformation)
        self.image_label.setPixmap(pixmap)

    def masquer(self):
        self._composant_layout_nom = None
        self.setVisible(False)

    def repositionner(self):
        """Replace le panneau au coin bas-gauche du parent, à sa taille
        courante (ratio par défaut tant que l'utilisateur n'a pas
        redimensionné manuellement, cf. mousePressEvent/mouseMoveEvent
        ci-dessous qui mettent à jour _largeur_ratio/_hauteur_ratio)."""
        parent = self.parentWidget()
        if parent is None:
            return
        largeur = max(240, round(parent.width() * self._largeur_ratio))
        hauteur = max(160, round(parent.height() * self._hauteur_ratio))
        self.setGeometry(0, parent.height() - hauteur, largeur, hauteur)

    # ------------------------------------------------------------------
    # Redimensionnement maison (poignées haut/droite), cf. docstring de
    # classe pour la justification du choix vs QSplitter.
    # ------------------------------------------------------------------
    def _sur_bande_haut(self, pos: QPoint) -> bool:
        return pos.y() <= self.LARGEUR_POIGNEE

    def _sur_bande_droite(self, pos: QPoint) -> bool:
        return pos.x() >= self.width() - self.LARGEUR_POIGNEE

    def mousePressEvent(self, event):
        if event.button() == Qt.LeftButton:
            pos = event.pos()
            self._drag_hauteur = self._sur_bande_haut(pos)
            self._drag_largeur = self._sur_bande_droite(pos)
            if self._drag_hauteur or self._drag_largeur:
                self._pos_drag_depart = event.globalPosition().toPoint()
                self._taille_drag_depart = self.size()
                event.accept()
                return
        super().mousePressEvent(event)

    def mouseMoveEvent(self, event):
        parent = self.parentWidget()
        if parent is None or not (self._drag_hauteur or self._drag_largeur):
            pos = event.pos()
            if self._sur_bande_haut(pos) or self._sur_bande_droite(pos):
                self.setCursor(Qt.SizeFDiagCursor if self._sur_bande_haut(pos) and self._sur_bande_droite(pos) else (Qt.SizeVerCursor if self._sur_bande_haut(pos) else Qt.SizeHorCursor))
            else:
                self.setCursor(Qt.ArrowCursor)
            return super().mouseMoveEvent(event)

        delta = event.globalPosition().toPoint() - self._pos_drag_depart
        nouvelle_taille = QSize(self._taille_drag_depart)
        if self._drag_hauteur:
            # Tirer vers le HAUT (delta.y négatif) agrandit le panneau,
            # ancré en bas -- donc hauteur = hauteur_depart - delta.y.
            nouvelle_taille.setHeight(max(160, self._taille_drag_depart.height() - delta.y()))
        if self._drag_largeur:
            nouvelle_taille.setWidth(max(240, self._taille_drag_depart.width() + delta.x()))
        nouvelle_taille.setWidth(min(nouvelle_taille.width(), parent.width()))
        nouvelle_taille.setHeight(min(nouvelle_taille.height(), parent.height()))
        self._largeur_ratio = nouvelle_taille.width() / max(1, parent.width())
        self._hauteur_ratio = nouvelle_taille.height() / max(1, parent.height())
        self.setGeometry(0, parent.height() - nouvelle_taille.height(), nouvelle_taille.width(), nouvelle_taille.height())
        self._appliquer_pixmap(self.image_label.pixmap())

    def mouseReleaseEvent(self, event):
        self._drag_hauteur = False
        self._drag_largeur = False
        super().mouseReleaseEvent(event)


class ComposantsLayoutScreen(QWidget):
    """Onglet "ComposantLayout" -- SPEC section 7.1, second onglet de
    ServiceAPIScreen.editeur_page à côté de Composants (cf. modification
    de ServiceAPIScreen._build_editeur juste après cette classe).

    **[DÉCISION ASSUMÉE]** sur le placement (aucune section de la SPEC ne
    tranche OÙ exactement "nouvel onglet" doit apparaître) : réintroduit
    un QTabWidget léger dans ServiceAPIScreen.editeur_page, qui n'en avait
    plus depuis la Phase C (retrait de Features/Actions -- cf. docstring
    de ServiceAPIScreen). Ce n'est PAS annuler la Phase C : la raison de
    la Phase C était que Features/Actions étaient devenues globales au
    Project (donc n'avaient plus leur place ICI, dans un écran par-
    ServiceAPI) -- cL est au contraire un contenu PROPRE à un ServiceAPI
    (comme les Composants cS), donc la même justification ne s'applique
    pas : il a bien sa place comme second onglet de cet écran. Alternative
    rejetée : sidebar dédiée -- la philosophie explicite du fichier est
    de ne pas saturer la sidebar d'une icône par outil (cf. commentaire
    sur ApplicationsScreen), et cL n'est de toute façon significatif que
    DANS le contexte d'un ServiceAPI déjà ouvert, pas au niveau racine.

    Pas de groupes/navigation/sélection multiple (cf. docstring de
    section juste avant ComposantLayoutTuile) : simple FlowGrid.

    CORRECTIF (trou fonctionnel signalé après relecture de la SPEC) :
    bouton flottant "+ Nouveau ComposantLayout" ajouté ci-dessous -- SANS
    lui, rien dans tout le fichier n'appelait jamais ComposantLayout(...)
    pour en créer un premier : ComposantLayoutConfigScreen n'était
    atteignable QUE depuis le bouton "Modifier" du panneau flottant,
    c'est-à-dire sur un cL déjà existant. Même patron visuel ET même
    comportement que ComposantsScreen.floating_add_button (cS) --
    demande explicite utilisateur : "le bouton d'ajout de cL doit être
    exactement comme celui de cS, ça doit faire une sélection au bureau" :
    cache la fenêtre, capture le bureau complet, ouvre SelectionZoneOverlay
    plein écran pour tracer la zone (Espace valide, Échap annule), crée le
    ComposantLayout avec cette zone comme image_reference
    (Project.add_composant_layout_avec_nom_auto, nom par défaut
    modifiable ensuite -- cf. point restant plus bas), puis ouvre
    directement l'app de config dessus (section 5) pour enchaîner sur le
    filtre/formes. Cf. _sur_nouveau/_capturer_bureau_et_afficher_overlay_
    layout/_sur_zone_selectionnee_nouveau ci-dessous."""

    demande_ouvrir_config_layout = Signal(str)  # nom complet du ComposantLayout, cf. _sur_modifier / _sur_nouveau
    # CORRECTIF (hasattr(self, "_notify_status") mort constaté dans
    # _charger_grille : ComposantsLayoutScreen n'a JAMAIS eu de
    # _notify_status propre -- cette méthode vit sur ComposantsScreen,
    # une classe soeur, pas un parent. Le hasattr ne trouvait donc
    # jamais rien et le message n'atteignait jamais l'utilisateur.
    # Signal relayé par ServiceAPIScreen vers SON _notify_status --
    # même patron que demande_ouvrir_config_layout ci-dessus.
    demande_notification = Signal(str, bool)  # message, error
    # AJOUT (retrait de l'onglet Test intégré à ComposantLayoutConfigScreen
    # -- cf. docstring de PanneauProprietesLayoutFlottant.demande_tester)
    # : nom complet du ComposantLayout, MÊME patron que
    # demande_ouvrir_config_layout ci-dessus, relayé jusqu'à
    # ApplicationsScreen.ouvrir_test_composant_layout via ServiceAPIScreen
    # puis MainWindow (cf. _sur_tester ci-dessous).
    demande_ouvrir_test_composant_layout = Signal(str)
    # AJOUT (SPEC_lot_corrections_2026-09.md section 3, compteur cL/cS) :
    # MÊME patron que ComposantsScreen.nb_composants_change -- émis à
    # chaque changement du nombre de ComposantLayout affichés (rechargement
    # complet ou suppression unitaire ; l'ajout passe toujours par un
    # rechargement complet côté cL, cf. _sur_zone_selectionnee_nouveau).
    nb_composants_layout_change = Signal(int)

    def __init__(self, project: Project, parent=None):
        super().__init__(parent)
        self.project = project
        self._service_api_actif: Optional[str] = None
        self._tuiles: dict = {}  # nom complet -> ComposantLayoutTuile
        self._composant_layout_ouvert: Optional[str] = None  # nom du cL dans le panneau flottant
        self._config_screens_ouverts: dict = {}  # nom complet -> ComposantLayoutConfigScreen (cf. _sur_modifier)
        # CORRECTIF 2 (capture bureau pour "+ Nouveau ComposantLayout") :
        # référence forte le temps de l'édition, même raison que
        # ComposantsScreen._overlay_capture -- éviter le garbage-collect
        # prématuré de l'overlay plein écran.
        self._overlay_capture: Optional["SelectionZoneOverlay"] = None
        # PATCH (rendu réseau pour cL, demande explicite utilisateur :
        # "il faut faire a ce que on puisse ajouter ausi un composant
        # layout apres la selection de region dimage dans
        # panneaurendutaskreseau. actuelement sa fontionne uniquement
        # avec les composantSingle") -- MÊMES deux callbacks que
        # ComposantsScreen._get_image_rendu_reseau_actif/_prendre_captures_
        # selectionnees_reseau, injectés par ServiceAPIScreen.definir_
        # source_rendu_reseau (cf. sa docstring mise à jour) : jusqu'ici
        # ce relais ne visait QUE composants_tab, jamais composants_
        # layout_tab -- rien de ce côté-là ne consommait le rendu réseau.
        self._get_image_rendu_reseau_actif: Optional[Callable[[], Optional[QImage]]] = None
        self._prendre_captures_selectionnees_reseau: Optional[Callable[[], list]] = None

        root_layout = QVBoxLayout(self)
        root_layout.setContentsMargins(0, 0, 0, 0)
        root_layout.setSpacing(0)

        self.placeholder_widget = QWidget(self)
        placeholder_layout = QVBoxLayout(self.placeholder_widget)
        placeholder_layout.setAlignment(Qt.AlignCenter)
        placeholder_layout.setSpacing(16)
        placeholder_icon = QLabel(self.placeholder_widget)
        placeholder_icon.setPixmap(qta.icon("mdi6.view-grid-outline", color=Mocha.surface2).pixmap(40, 40))
        placeholder_icon.setAlignment(Qt.AlignCenter)
        placeholder_layout.addWidget(placeholder_icon)
        placeholder_label = QLabel("Aucun ComposantLayout pour ce ServiceAPI.", self.placeholder_widget)
        placeholder_label.setObjectName("PlaceholderSubtitle")
        placeholder_label.setAlignment(Qt.AlignCenter)
        placeholder_layout.addWidget(placeholder_label)
        root_layout.addWidget(self.placeholder_widget, 1)

        self.grid_scroll = QScrollArea(self)
        self.grid_scroll.setObjectName("FlowGridViewport")
        self.grid_scroll.setWidgetResizable(True)
        self.grid_scroll.setFrameShape(QFrame.NoFrame)
        self.grid_scroll.setHorizontalScrollBarPolicy(Qt.ScrollBarAlwaysOff)
        self.grid_scroll.setVerticalScrollBarPolicy(Qt.ScrollBarAlwaysOff)
        # REFONTE (demande explicite : "les composants n'auront pas
        # forcément toujours la même forme ... pas forcément de ligne ou
        # de colonne, relatif à la taille de chaque composant") --
        # MasonryGrid remplace FlowGrid ICI uniquement (cf. sa docstring
        # complète pour la justification : FlowGrid force une hauteur de
        # ligne uniforme, incompatible avec des cL de ratios très
        # différents). colonne_largeur = EXACTEMENT ComposantLayoutTuile.
        # LARGEUR_IMAGE + 2*MARGES, pour que chaque tuile occupe toute sa
        # colonne sans marge résiduelle ni débordement (cf. docstring de
        # ComposantLayoutTuile.hauteur_pour_largeur sur ce couplage).
        self.flow_grid = MasonryGrid(
            colonne_largeur=ComposantLayoutTuile.LARGEUR_IMAGE + 2 * ComposantLayoutTuile.MARGES,
            spacing=18,
            parent=None,
        )
        self.grid_scroll.setWidget(self.flow_grid)
        self.grid_scroll.setVisible(False)
        root_layout.addWidget(self.grid_scroll, 1)

        # --- Bouton flottant "+ Nouveau ComposantLayout" (CORRECTIF ci-
        # dessus) -- même style que ComposantsScreen.floating_add_button,
        # parent = self (comme le panneau ci-dessous) pour flotter par-
        # dessus toute la vue, repositionné dans resizeEvent. ---
        self.floating_add_button = QToolButton(self)
        self.floating_add_button.setObjectName("FloatingAddButton")
        self.floating_add_button.setIcon(qta.icon("mdi6.plus", color=Mocha.crust))
        self.floating_add_button.setIconSize(QSize(26, 26))
        self.floating_add_button.setFixedSize(44, 44)
        self.floating_add_button.setCursor(Qt.PointingHandCursor)
        self.floating_add_button.setToolTip("Nouveau ComposantLayout")
        self.floating_add_button.clicked.connect(self._sur_nouveau)
        self.floating_add_button.setVisible(False)
        self.floating_add_button.raise_()

        # --- Bouton flottant "Capturer depuis le rendu réseau" (PATCH cL
        # depuis rendu réseau, cf. docstring des attributs _get_image_
        # rendu_reseau_actif/_prendre_captures_selectionnees_reseau plus
        # haut) -- MÊME style/icône que ComposantsScreen.floating_add_
        # depuis_rendu_button, empilé juste au-dessus de floating_add_
        # button (cf. _repositionner_bouton_flottant ci-dessous). Masqué
        # par défaut, comme son homologue cS -- cf. _rafraichir_
        # visibilite_bouton_depuis_rendu. ---
        self.floating_add_depuis_rendu_button = QToolButton(self)
        self.floating_add_depuis_rendu_button.setObjectName("FloatingAddDepuisRenduButton")
        self.floating_add_depuis_rendu_button.setIcon(qta.icon("mdi6.monitor-screenshot", color=Mocha.crust))
        self.floating_add_depuis_rendu_button.setIconSize(QSize(22, 22))
        self.floating_add_depuis_rendu_button.setFixedSize(44, 44)
        self.floating_add_depuis_rendu_button.setCursor(Qt.PointingHandCursor)
        self.floating_add_depuis_rendu_button.setToolTip(
            "Créer un ComposantLayout depuis le rendu réseau"
        )
        self.floating_add_depuis_rendu_button.clicked.connect(
            self._start_capture_composant_layout_depuis_rendu_reseau
        )
        self.floating_add_depuis_rendu_button.setVisible(False)
        self.floating_add_depuis_rendu_button.raise_()

        # --- Panneau flottant, overlay sur TOUT self (pas seulement la
        # grille) : posé en dernier dans root_layout n'aurait rien changé
        # à sa nature d'overlay -- il est repositionné manuellement en
        # coordonnées absolues (cf. repositionner()), donc son parent
        # direct doit être `self`, pas la grille, pour couvrir tout
        # l'onglet même si le clic vient de la grille en scroll. ---
        self.panneau_flottant = PanneauProprietesLayoutFlottant(self)
        self.panneau_flottant.demande_fermeture.connect(self._fermer_panneau)
        self.panneau_flottant.demande_suppression.connect(self._sur_supprimer)
        self.panneau_flottant.demande_modifier.connect(self._sur_modifier)
        self.panneau_flottant.demande_toggle_change.connect(self._rafraichir_image_panneau)
        self.panneau_flottant.demande_tester.connect(self._sur_tester)

    def resizeEvent(self, event):
        super().resizeEvent(event)
        if self.panneau_flottant.isVisible():
            self.panneau_flottant.repositionner()
        self._repositionner_bouton_flottant()

    def _repositionner_bouton_flottant(self):
        marge = 24
        espacement = 12
        x = self.width() - self.floating_add_button.width() - marge
        y = self.height() - self.floating_add_button.height() - marge
        self.floating_add_button.move(max(0, x), max(0, y))
        # "Capturer depuis le rendu réseau" empilé juste au-dessus (même
        # colonne) -- PATCH cL depuis rendu réseau, même patron que
        # ComposantsScreen._repositionner_bouton_flottant.
        x_depuis_rendu = self.width() - self.floating_add_depuis_rendu_button.width() - marge
        y_depuis_rendu = y - self.floating_add_depuis_rendu_button.height() - espacement
        self.floating_add_depuis_rendu_button.move(max(0, x_depuis_rendu), max(0, y_depuis_rendu))

    def _sur_nouveau(self):
        """CORRECTIF 2 (demande explicite utilisateur : "le bouton d'ajout
        de cL doit être exactement comme celui de cS, ça doit faire une
        sélection au bureau") -- reprend le MÊME flux que
        ComposantsScreen._start_capture_composant/_lancer_capture_ecran/
        _capturer_bureau_et_afficher_overlay/_on_zone_selectionnee : cache
        la fenêtre AutoniaX, capture le bureau complet, ouvre
        SelectionZoneOverlay plein écran (Espace valide, Échap annule),
        puis crée le ComposantLayout à partir de la zone découpée.

        Version précédente (créait un cL vide sans aucune capture, à
        corriger) abandonnée : elle ne suivait pas le parcours cS demandé."""
        if not self._service_api_actif:
            return  # bouton normalement masqué dans ce cas, garde-fou
        main_window = self.window()
        main_window.hide()
        QApplication.processEvents()
        # Même délai que _lancer_capture_ecran (cS) -- laisse le temps au
        # compositeur de retirer réellement la fenêtre avant la capture.
        QTimer.singleShot(150, self._capturer_bureau_et_afficher_overlay_layout)

    def _capturer_bureau_et_afficher_overlay_layout(self):
        """CORRECTIF 2 : symétrique de ComposantsScreen._capturer_bureau_
        et_afficher_overlay, pour cL. Référence forte sur l'overlay
        conservée (self._overlay_capture) pour la même raison (éviter le
        garbage-collect prématuré, cf. docstring cS)."""
        image_bureau = capture_bureau_complet()
        main_window = self.window()

        if image_bureau is None or image_bureau.isNull():
            main_window.show()
            return

        self._overlay_capture = SelectionZoneOverlay(image_bureau)
        self._overlay_capture.zone_selectionnee.connect(
            lambda rect: self._sur_zone_selectionnee_nouveau(image_bureau, rect)
        )
        self._overlay_capture.annulee.connect(self._sur_capture_annulee)
        self._overlay_capture.showFullScreen()
        self._overlay_capture.activateWindow()

    def _sur_capture_annulee(self):
        self._overlay_capture = None
        self.window().show()

    def _sur_zone_selectionnee_nouveau(self, image_source: QImage, rect: QRect):
        """CORRECTIF 2 : symétrique du "cas nouveau composant" de
        ComposantsScreen._on_zone_selectionnee -- crée immédiatement le
        ComposantLayout avec un nom par défaut (modifiable ensuite, cf.
        point restant signalé dans la docstring de classe : pas de champ
        de renommage dédié pour l'instant), PUIS ouvre directement l'app
        de config dessus (section 5) pour enchaîner sur le filtre/formes."""
        self._overlay_capture = None
        image_decoupee = image_source.copy(rect)
        self.window().show()

        try:
            composant_layout = self.project.add_composant_layout_avec_nom_auto(
                self._service_api_actif, image_decoupee
            )
        except ValueError:
            return
        self.project.save()
        self._charger_grille(self._service_api_actif)
        self.demande_ouvrir_config_layout.emit(composant_layout.nom)

    def definir_source_rendu_reseau(
        self,
        get_image: Optional[Callable[[], Optional[QImage]]],
        prendre_captures_selectionnees: Optional[Callable[[], list]] = None,
    ):
        """PATCH (cL depuis rendu réseau) -- symétrique EXACT de
        ComposantsScreen.definir_source_rendu_reseau (cf. sa docstring
        complète pour le détail des deux callbacks). Injecté depuis
        ServiceAPIScreen.definir_source_rendu_reseau, qui relaie
        désormais à composants_tab ET composants_layout_tab (avant ce
        patch, seul composants_tab recevait ce relais -- cf. commentaire
        historique retiré de ServiceAPIScreen.definir_source_rendu_
        reseau, qui affirmait à tort que cL ne consommait jamais de
        rendu réseau)."""
        self._get_image_rendu_reseau_actif = get_image
        self._prendre_captures_selectionnees_reseau = prendre_captures_selectionnees
        self._rafraichir_visibilite_bouton_depuis_rendu()

    def _rafraichir_visibilite_bouton_depuis_rendu(self):
        """PATCH (cL depuis rendu réseau) -- symétrique EXACT de
        ComposantsScreen._rafraichir_visibilite_bouton_depuis_rendu."""
        if self._service_api_actif is None or self._get_image_rendu_reseau_actif is None:
            self.floating_add_depuis_rendu_button.setVisible(False)
            return
        try:
            image = self._get_image_rendu_reseau_actif()
        except Exception:
            image = None
        self.floating_add_depuis_rendu_button.setVisible(image is not None and not image.isNull())

    def _start_capture_composant_layout_depuis_rendu_reseau(self):
        """PATCH (cL depuis rendu réseau) -- symétrique de ComposantsScreen.
        _start_capture_composant_depuis_rendu_reseau (cf. sa docstring
        complète pour la logique des deux chemins), adapté à cL :

        1. Si des zones ont déjà été découpées dans le panneau de rendu
           réseau (bouton ciseau) : self._prendre_captures_selectionnees_
           reseau() les renvoie TOUTES -- UN ComposantLayout est créé PAR
           image, immédiatement, via add_composant_layout_avec_nom_auto
           (même fonction que _sur_zone_selectionnee_nouveau). DIFFÉRENCE
           volontaire avec cS ici : un cL fraîchement créé a toujours
           besoin d'un passage par sa config (filtre/scindement/zones,
           section 5) avant d'être utilisable -- contrairement à un cS,
           qui est déjà pleinement fonctionnel dès sa création. Avec un
           seul cL créé, on ouvre donc directement sa config (même geste
           que le chemin 2 / _sur_zone_selectionnee_nouveau) ; avec
           plusieurs, ouvrir une config à la fois n'aurait pas de sens
           (l'utilisateur ne peut en configurer qu'un seul en même temps)
           -- on les crée tous et on notifie, à charge pour l'utilisateur
           d'ouvrir chaque config depuis la grille ensuite.
        2. Sinon (aucune sélection en attente) : comportement inchangé
           du bouton "+" classique mais avec l'image de rendu réseau
           comme source -- ouvre SelectionZoneOverlay sur l'image
           actuellement affichée, PUIS enchaîne sur _sur_zone_
           selectionnee_nouveau (crée le cL ET ouvre sa config), exactement
           comme le bouton "+ Nouveau ComposantLayout" classique."""
        if not self._service_api_actif:
            return  # bouton normalement masqué dans ce cas, garde-fou

        captures_en_attente: list = []
        if self._prendre_captures_selectionnees_reseau is not None:
            try:
                captures_en_attente = self._prendre_captures_selectionnees_reseau() or []
            except Exception:
                captures_en_attente = []

        if captures_en_attente:
            service_api_nom = self._service_api_actif
            noms_crees = []
            for image_decoupee in captures_en_attente:
                if image_decoupee is None or image_decoupee.isNull():
                    continue
                try:
                    composant_layout = self.project.add_composant_layout_avec_nom_auto(
                        service_api_nom, image_decoupee
                    )
                except ValueError:
                    continue
                self.project.save()
                noms_crees.append(composant_layout.nom)
            if noms_crees:
                self._charger_grille(service_api_nom)
                if len(noms_crees) == 1:
                    self.demande_ouvrir_config_layout.emit(noms_crees[0])
                else:
                    self.demande_notification.emit(
                        f"{len(noms_crees)} ComposantLayout créés depuis la sélection -- "
                        "ouvrez chaque config pour terminer leur paramétrage.",
                        False,
                    )
            return

        if self._get_image_rendu_reseau_actif is None:
            return  # bouton normalement masqué dans ce cas, garde-fou
        try:
            image_rendu = self._get_image_rendu_reseau_actif()
        except Exception:
            image_rendu = None
        if image_rendu is None or image_rendu.isNull():
            # Même garde-fou que ComposantsScreen : le rendu a pu perdre
            # son image entre l'affichage du bouton et le clic.
            self.demande_notification.emit(
                "Aucune image de rendu réseau disponible pour le moment.", True
            )
            self._rafraichir_visibilite_bouton_depuis_rendu()
            return
        self._overlay_capture = SelectionZoneOverlay(image_rendu)
        self._overlay_capture.zone_selectionnee.connect(
            lambda rect: self._sur_zone_selectionnee_nouveau(image_rendu, rect)
        )
        self._overlay_capture.annulee.connect(self._sur_capture_annulee)
        self._overlay_capture.showFullScreen()
        self._overlay_capture.activateWindow()

    @property
    def nb_composants_layout(self) -> int:
        """AJOUT (section 3, compteur cL/cS) : nombre de ComposantLayout
        actuellement affichés, pour le libellé d'onglet "ComposantLayout
        (N)" côté ServiceAPIScreen."""
        return len(self._tuiles)

    # ------------------------------------------------------------------
    def set_service_api_actif(self, nom: Optional[str]):
        self._service_api_actif = nom
        self._fermer_panneau()
        if nom is None:
            self.grid_scroll.setVisible(False)
            self.placeholder_widget.setVisible(True)
            self.floating_add_button.setVisible(False)
            # PATCH (cL depuis rendu réseau) : même garde-fou que
            # ComposantsScreen -- pas de ServiceAPI actif, le bouton
            # réseau ne doit jamais rester visible.
            self.floating_add_depuis_rendu_button.setVisible(False)
            self.nb_composants_layout_change.emit(self.nb_composants_layout)
            return
        self._charger_grille(nom)
        self.floating_add_button.setVisible(True)
        # PATCH (cL depuis rendu réseau) : réévalue si le bouton réseau
        # doit apparaître pour ce ServiceAPI (dépend aussi de la présence
        # d'une image de rendu réseau actuellement disponible, cf.
        # _rafraichir_visibilite_bouton_depuis_rendu).
        self._rafraichir_visibilite_bouton_depuis_rendu()
        self._repositionner_bouton_flottant()
        self.nb_composants_layout_change.emit(self.nb_composants_layout)

    def _charger_grille(self, service_api_nom: str):
        self.flow_grid.clear()
        self._tuiles.clear()
        service_api = self.project.find_service_api(service_api_nom)
        noms_ordonnes = list(service_api.composants_layout) if service_api else []
        composants_layout_bruts = [(n, self.project.find_composant_layout(n)) for n in noms_ordonnes]
        # GARDE-FOU (bug constaté sur données réelles : un cL référencé par
        # service_api.composants_layout mais introuvable par nom --
        # normalement plus possible depuis Project._reparer_coherence_
        # composants_layout, appelée à CHAQUE chargement de projet, cf. sa
        # docstring pour le détail complet). Si ça se produit quand même
        # (ex: incohérence introduite en cours de session, pas au
        # chargement), le signaler plutôt que filtrer en silence comme
        # avant -- un cL manquant sans aucune explication est exactement
        # ce qui a fait perdre du temps la dernière fois.
        # CORRECTIF : hasattr(self, "_notify_status") remplacé -- cette
        # classe n'a jamais eu cette méthode (cf. docstring de
        # demande_notification ci-dessus), le message n'atteignait donc
        # jamais l'utilisateur malgré une apparence de code fonctionnel.
        noms_manquants = [n for n, c in composants_layout_bruts if c is None]
        if noms_manquants:
            print(
                f"[AVERTISSEMENT] {len(noms_manquants)} ComposantLayout référencé(s) "
                f"par le ServiceAPI « {service_api_nom} » introuvable(s) : {noms_manquants}. "
                f"Vérifiez project.json (nom vs service_api.composants_layout)."
            )
            self.demande_notification.emit(
                f"{len(noms_manquants)} ComposantLayout introuvable(s) pour ce service "
                f"(voir la console) — vérifiez project.json.",
                True,
            )
        composants_layout = [c for _, c in composants_layout_bruts if c is not None]

        if not composants_layout:
            self.grid_scroll.setVisible(False)
            self.placeholder_widget.setVisible(True)
            return
        self.placeholder_widget.setVisible(False)
        self.grid_scroll.setVisible(True)

        for composant_layout in composants_layout:
            image_absolue = get_app_data_dir() / composant_layout.image_reference if composant_layout.image_reference else Path()
            # GARDE-FOU (fichier référencé mais absent sur disque -- cf.
            # le cas "VideoTemplate" -> NouveauServiceAPI-
            # NouveauComposantLayout.png inexistant) : ComposantLayoutTuile
            # affiche déjà "Aperçu indisponible" si image_absolue.exists()
            # est faux (cf. ComposantLayoutTuile._charger_image), donc
            # rien à changer côté rendu -- seulement journaliser pour que
            # ce cas soit visible plutôt que découvert par une vignette
            # vide sans explication.
            if composant_layout.image_reference and not image_absolue.exists():
                print(
                    f"[AVERTISSEMENT] Image introuvable pour le ComposantLayout "
                    f"« {composant_layout.nom} » : {image_absolue}"
                )
            tuile = ComposantLayoutTuile(composant_layout, image_absolue)
            tuile.clique.connect(self._sur_tuile_cliquee)
            self.flow_grid.add_item(tuile)
            self._tuiles[composant_layout.nom] = tuile

    # ------------------------------------------------------------------
    # Panneau de propriétés flottant (7.2)
    # ------------------------------------------------------------------
    def _sur_tuile_cliquee(self, composant_layout_nom: str):
        # CORRECTIF (demande explicite : "lorsqu'on clique sur un cL ça
        # doit directement ouvrir l'app de modif") -- le panneau flottant
        # intermédiaire (aperçu + boutons Modifier/Supprimer) est retiré
        # du clic simple : un clic ouvre maintenant directement
        # ComposantLayoutConfigScreen, même effet que l'ancien bouton
        # "Modifier" du panneau (cf. _sur_modifier, INCHANGÉE, réutilisée
        # telle quelle ci-dessous). Le bouton Supprimer, qui vivait dans
        # ce panneau, a été déplacé dans l'onglet Général de l'écran de
        # config (cf. ComposantLayoutConfigScreen.demande_suppression) --
        # accord explicite de l'utilisateur sur ce nouvel emplacement.
        # self.panneau_flottant reste déclaré/câblé (cf. __init__) mais
        # n'est plus jamais montré depuis cette méthode -- pas retiré
        # entièrement de la classe pour ne pas casser sur_composant_
        # layout_renomme, qui peut encore le manipuler indirectement.
        self._sur_modifier(composant_layout_nom)

    def _rafraichir_image_panneau(self):
        if not self._composant_layout_ouvert:
            return
        composant_layout = self.project.find_composant_layout(self._composant_layout_ouvert)
        if composant_layout is None:
            self._fermer_panneau()
            return
        pixmap = self._construire_pixmap_apercu(composant_layout)
        self.panneau_flottant.afficher_pour(composant_layout.nom, pixmap)

    def _construire_pixmap_apercu(self, composant_layout: "ComposantLayout") -> Optional[QPixmap]:
        """Construit le QPixmap affiché dans le panneau, en tenant compte
        des 2 toggles (filtré/brut, entourer formes+zones -- SPEC 7.2 :
        "les deux ensemble, pas de toggle séparé entre Forme et
        ZoneForme"). Filtré : réexécute code_filtre sur l'image_reference
        à la volée (même fonction que l'app de config, section 4.1) --
        pas de cache : ce panneau est rouvert rarement par rapport à la
        fréquence de rafraîchissement live de l'app de config, un calcul
        à chaque ouverture/toggle reste largement assez rapide."""
        if not composant_layout.image_reference:
            return None
        chemin = get_app_data_dir() / composant_layout.image_reference
        if not chemin.exists():
            return None
        pixmap_brut = QPixmap(str(chemin))
        if pixmap_brut.isNull():
            return None

        afficher_filtre = self.panneau_flottant.toggle_filtre.isChecked()
        pixmap_base = pixmap_brut
        if afficher_filtre and VISION_DISPONIBLE:
            image_bgr = cv2.imread(str(chemin))
            if image_bgr is not None:
                try:
                    resultat_bgr = executer_filtre_layout(image_bgr, composant_layout.code_filtre)
                    # MÊME conversion que ComposantLayoutConfigScreen.
                    # _rafraichir_affichage_image (pas de helper
                    # bgr_vers_qpixmap générique dans ce fichier -- inline
                    # ici, identique à l'app de config).
                    resultat_3c = resultat_bgr if resultat_bgr.ndim == 3 else cv2.cvtColor(resultat_bgr, cv2.COLOR_GRAY2BGR)
                    h, w = resultat_3c.shape[:2]
                    resultat_rgb = cv2.cvtColor(resultat_3c, cv2.COLOR_BGR2RGB)
                    qimage_filtree = QImage(resultat_rgb.data, w, h, resultat_rgb.strides[0], QImage.Format_RGB888).copy()
                    pixmap_filtree = QPixmap.fromImage(qimage_filtree)
                    if not pixmap_filtree.isNull():
                        pixmap_base = pixmap_filtree
                except DetectionLayoutError:
                    pass  # code_filtre invalide -- retombe silencieusement sur l'image brute

        if not self.panneau_flottant.toggle_formes.isChecked() or not composant_layout.zones:
            return pixmap_base

        # Superpose Zone (bleu), MÊME convention de couleur que
        # ApercuLayoutLabel (cf. sa docstring) pour rester visuellement
        # cohérent avec l'app de config.
        # CORRECTIF (REFONTE Zone) : Forme a disparu (fusionnée dans
        # Zone) -- composant_layout.zones est l'UNIQUE liste de
        # rectangles nommés du cL, relative au cL entier, dessinée dans
        # une seule boucle.
        resultat = QPixmap(pixmap_base)
        painter = QPainter(resultat)
        try:
            largeur_img = resultat.width()
            hauteur_img = resultat.height()
            stylo_zone = QPen(QColor(Mocha.blue))
            stylo_zone.setWidth(1)
            for zone in composant_layout.zones:
                zx, zy, zl, zh = zone.rect.x, zone.rect.y, zone.rect.largeur, zone.rect.hauteur
                rect_zone_px = QRect(
                    round(zx * largeur_img), round(zy * hauteur_img),
                    round(zl * largeur_img), round(zh * hauteur_img),
                )
                painter.setPen(stylo_zone)
                painter.drawRect(rect_zone_px)
        finally:
            painter.end()
        return resultat

    def _fermer_panneau(self):
        self._composant_layout_ouvert = None
        self.panneau_flottant.masquer()

    def _sur_supprimer(self, composant_layout_nom: str):
        # BUGFIX (cf. docstring de Project.remove_composant_layout) :
        # toujours pas de QMessageBox de confirmation ici (comportement
        # inchangé, cohérent avec remove_composant/cS qui n'en a pas non
        # plus), mais remove_composant_layout envoie désormais l'élément
        # à la corbeille au lieu de le supprimer pour de bon -- une
        # confirmation immédiate serait de toute façon redondante
        # puisqu'une restauration reste possible depuis l'écran Corbeille.
        self.project.remove_composant_layout(composant_layout_nom)
        self.project.save()
        tuile = self._tuiles.pop(composant_layout_nom, None)
        if tuile is not None:
            # CORRECTIF (flow_grid est désormais un MasonryGrid, cf. sa
            # docstring) : plus de self.flow_grid._grid (QGridLayout) à
            # nettoyer -- MasonryGrid positionne ses items en coordonnées
            # absolues (setGeometry), pas via un QLayout Qt. Seul
            # self.flow_grid._items (liste partagée, même nom d'attribut
            # que FlowGrid) doit être mis à jour avant de relayouter.
            if tuile in self.flow_grid._items:
                self.flow_grid._items.remove(tuile)
            self.flow_grid._relayout()
            tuile.setParent(None)
            tuile.deleteLater()
        self._fermer_panneau()
        if not self._tuiles:
            self.grid_scroll.setVisible(False)
            self.placeholder_widget.setVisible(True)
        # AJOUT (section 3, compteur cL/cS) : suppression unitaire hors
        # rechargement complet -- même raisonnement que côté cS.
        self.nb_composants_layout_change.emit(self.nb_composants_layout)

    def _sur_modifier(self, composant_layout_nom: str):
        # Ouvre ComposantLayoutConfigScreen pré-remplie -- MÊME registre
        # d'onglets Applications que TestComposantScreen (cf. SPEC 7.2 :
        # "ouvre ComposantLayoutConfigScreen ... section 5"). Ce screen
        # lui-même ne sait pas où s'ouvrir : c'est signalé au parent via
        # demande_ouvrir_config_layout, relayé jusqu'à ApplicationsScreen
        # (cf. modification de ServiceAPIScreen juste après cette classe).
        # Signal déclaré en tête de classe (cf. docstring, partagé avec
        # _sur_nouveau depuis le CORRECTIF "+ Nouveau ComposantLayout").
        self.demande_ouvrir_config_layout.emit(composant_layout_nom)

    def _sur_tester(self, composant_layout_nom: str):
        # AJOUT (cf. docstring de demande_ouvrir_test_composant_layout en
        # tête de classe) -- MÊME patron que _sur_modifier ci-dessus :
        # simple relais, la construction réelle de TestComposantScreen en
        # MODE_COMPOSANT_LAYOUT est faite par ApplicationsScreen.ouvrir_
        # test_composant_layout (cf. sa docstring), pas ici.
        self.demande_ouvrir_test_composant_layout.emit(composant_layout_nom)

    def sur_composant_layout_renomme(self, ancien_nom_complet: str, nouveau_nom_complet: str):
        """CORRECTIF (bug rapporté : "j'ai renommé un cL et ça n'apparaît
        même plus [dans la grille]") -- appelée par MainWindow (relais
        depuis ApplicationsScreen.composant_layout_renomme, cf. sa
        docstring de signal) dès que ComposantLayoutConfigScreen renomme,
        SANS attendre un changement d'onglet contrairement au correctif
        partiel existant (cf. onglets_editeur.currentChanged côté
        ServiceAPIScreen, conservé comme filet de sécurité pour les autres
        cas de désync -- suppression concurrente, etc.).

        No-op silencieux si ce ServiceAPIScreen n'affiche pas actuellement
        le ServiceAPI concerné (self._tuiles vide ou clé absente) : le
        renommage reste correct en mémoire/disque (Project.rename_
        composant_layout) de toute façon, la grille se corrigera au
        prochain set_service_api_actif."""
        tuile = self._tuiles.pop(ancien_nom_complet, None)
        if tuile is None:
            return
        self._tuiles[nouveau_nom_complet] = tuile
        composant_layout = self.project.find_composant_layout(nouveau_nom_complet)
        if composant_layout is None:
            return
        image_absolue = (
            get_app_data_dir() / composant_layout.image_reference
            if composant_layout.image_reference else Path()
        )
        tuile.composant_layout_nom = nouveau_nom_complet
        tuile.rafraichir(composant_layout, image_absolue)
        if self._composant_layout_ouvert == ancien_nom_complet:
            self._composant_layout_ouvert = nouveau_nom_complet
            self._rafraichir_image_panneau()
        config_screen = self._config_screens_ouverts.pop(ancien_nom_complet, None)
        if config_screen is not None:
            self._config_screens_ouverts[nouveau_nom_complet] = config_screen

    def sur_composant_layout_modifie(self, composant_layout_nom: str):
        """CORRECTIF (retour utilisateur : "le badge de validation...
        j'ai remarqué que je suis obligé de rouvrir la page des
        composants pour que ça prenne effet") -- MÊME patron EXACT que
        sur_composant_layout_renomme juste au-dessus (relais depuis
        MainWindow, connecté sur composant_layout_modifie dans _ouvrir_
        config_layout, cf. sa docstring), mais pour le cas plus courant
        d'une simple modification en place (toggle "Validé", couleur de
        zone, etc.) -- pas de changement de nom ici, donc pas de pop/
        réinsertion dans self._tuiles, juste un rafraîchissement de la
        tuile déjà en place à sa clé actuelle.

        No-op silencieux si ce ServiceAPIScreen n'affiche pas
        actuellement le ServiceAPI concerné (même garde que sur_
        composant_layout_renomme) : la donnée est de toute façon déjà
        persistée sur disque via composant_layout_modifie.connect(self.
        project.save) côté MainWindow, ce relais ne fait que rafraîchir
        l'affichage immédiat si la grille concernée est visible."""
        tuile = self._tuiles.get(composant_layout_nom)
        if tuile is None:
            return
        composant_layout = self.project.find_composant_layout(composant_layout_nom)
        if composant_layout is None:
            return
        image_absolue = (
            get_app_data_dir() / composant_layout.image_reference
            if composant_layout.image_reference else Path()
        )
        tuile.rafraichir(composant_layout, image_absolue)


# ---------------------------------------------------------------------------
# Écran Tasks (Patch 8 : structure de base — liste des Tasks, création/
# nommage, fréquence de polling, States en cards accordéon réordonnables
# par drag). Pas encore présent à ce stade (patchs suivants) : contenu des
# States (palette ON/OFF, Actions), moteur d'exécution, dashboard temps réel.
# ---------------------------------------------------------------------------
class ServiceAPICarte(QFrame):
    """Mini-card d'un ServiceAPI dans la grille du haut (point 18 : ServiceAPI

    sauvegardés présentés en cards). Cliquer dessus OUVRE le ServiceAPI (pas
    une simple sélection) : la grille disparaît, remplacée par l'éditeur —
    voir ServiceAPIScreen._ouvrir_service_api."""

    clique = Signal(str)  # nom du ServiceAPI

    def __init__(self, service_api: ServiceAPI, parent=None):
        super().__init__(parent)
        self.service_api_nom = service_api.nom
        # PATCH (retour utilisateur : "jaime absolument pas le desig de
        # representation de Service API, rend sa plus moderne") --
        # objectName dédié "V2" (cf. commentaire QSS #ServiceAPICarteV2)
        # pour ne pas impacter ProjetBatchCarte/SousProjetCarte, qui
        # réutilisent l'ancien objectName "ServiceAPICarte" partagé.
        self.setObjectName("ServiceAPICarteV2")
        self.setFixedSize(216, 132)
        self.setCursor(Qt.PointingHandCursor)

        layout = QVBoxLayout(self)
        layout.setContentsMargins(16, 14, 16, 14)
        layout.setSpacing(10)

        header_row = QHBoxLayout()
        header_row.setSpacing(0)
        # Badge icône circulaire en dégradé (cf. #ServiceAPICarteV2IconBadge)
        # à la place de la petite icône flottante seule d'origine -- donne
        # à la carte un point d'ancrage visuel fort, cohérent avec le
        # dégradé mauve/blue du logo de l'application (cf. _ICON_SVG_AUTONIAX).
        self.icon_badge = QFrame(self)
        self.icon_badge.setObjectName("ServiceAPICarteV2IconBadge")
        self.icon_badge.setFixedSize(34, 34)
        icon_badge_layout = QVBoxLayout(self.icon_badge)
        icon_badge_layout.setContentsMargins(0, 0, 0, 0)
        icon_label = QLabel(self.icon_badge)
        # PATCH : sans objectName dédié, ce QLabel hérite du fond opaque
        # de la règle globale QWidget (cf. build_stylesheet) et recouvre
        # ENTIÈREMENT le dégradé du badge parent, puisqu'il occupe toute
        # sa géométrie (34x34, aucune marge dans icon_badge_layout) --
        # objectName + fond transparent explicite (cf. QSS
        # #ServiceAPICarteV2IconBadgeIcon) pour laisser le dégradé du
        # parent visible au travers.
        icon_label.setObjectName("ServiceAPICarteV2IconBadgeIcon")
        icon_label.setAlignment(Qt.AlignCenter)
        icon_label.setPixmap(qta.icon("mdi6.format-list-checks", color=Mocha.crust).pixmap(18, 18))
        icon_badge_layout.addWidget(icon_label)
        header_row.addWidget(self.icon_badge)
        header_row.addStretch(1)
        layout.addLayout(header_row)

        self.nom_label = QLabel(service_api.nom, self)
        self.nom_label.setObjectName("ServiceAPICarteV2Nom")
        self.nom_label.setWordWrap(True)
        layout.addWidget(self.nom_label)

        layout.addStretch(1)

        info_row = QHBoxLayout()
        info_row.setSpacing(0)
        self.info_label = QLabel(self)
        self.info_label.setObjectName("ServiceAPICarteV2Info")
        info_row.addWidget(self.info_label)
        info_row.addStretch(1)
        layout.addLayout(info_row)
        self._rafraichir_info(service_api)

    def _rafraichir_info(self, service_api: ServiceAPI):
        # CORRECTIF (retour utilisateur : "ça compte que les composants
        # single" -- le badge n'incluait pas les ComposantLayout) --
        # service_api.composants_layout est une liste SÉPARÉE de
        # composants (cf. sa docstring dans ServiceAPI : "cS et cL ont
        # des schémas de champs significativement différents ... LISTE
        # SÉPARÉE plutôt que fusionnée"), donc jamais comptée par le seul
        # len(service_api.composants) ci-dessous -- somme des deux pour
        # refléter le total réel de composants (cS + cL) de ce ServiceAPI.
        nb = len(service_api.composants) + len(service_api.composants_layout)
        suffixe = "composant" if nb <= 1 else "composants"
        self.info_label.setText(f"{nb} {suffixe}")

    def rafraichir(self, service_api: ServiceAPI):
        self.nom_label.setText(service_api.nom)
        self._rafraichir_info(service_api)

    def mousePressEvent(self, event):
        if event.button() == Qt.LeftButton:
            self.clique.emit(self.service_api_nom)
        super().mousePressEvent(event)


class ComposantMiniTuile(QFrame):
    """Mini-vignette cliquable d'un Composant, utilisée dans le panneau
    d'import (Patch 9, point 12 : grille de composants disponibles avec
    miniatures, groupés par Interface en accordéon). Plus petite que
    ComposantTuile (grille principale de l'écran Composants) pour tenir
    dans un panneau latéral étroit.

    Sélection multiple type "coché/décoché" (pas d'ajout immédiat au
    clic) : un clic bascule l'état visuel sélectionné, la validation finale
    se fait via le bouton "Importer" du panneau (voir PaletteComposantsPanel)."""

    clique = Signal(str)  # nom complet du composant

    def __init__(self, composant: Composant, image_absolue: Path, parent=None):
        super().__init__(parent)
        self.composant_nom = composant.nom
        self.setObjectName("ComposantMiniTuile")
        self.setProperty("selectionnee", "false")
        self.setFixedWidth(112)
        self.setCursor(Qt.PointingHandCursor)

        layout = QVBoxLayout(self)
        layout.setContentsMargins(8, 8, 8, 8)
        layout.setSpacing(6)

        image_frame = QFrame(self)
        image_frame.setObjectName("ComposantTuileImageFrame")
        image_frame.setFixedSize(96, 68)
        image_layout = QVBoxLayout(image_frame)
        image_layout.setContentsMargins(0, 0, 0, 0)

        self.image_label = QLabel(image_frame)
        self.image_label.setAlignment(Qt.AlignCenter)
        if image_absolue.exists():
            pixmap = QPixmap(str(image_absolue))
            if not pixmap.isNull():
                pixmap = pixmap.scaled(96, 68, Qt.KeepAspectRatio, Qt.SmoothTransformation)
                self.image_label.setPixmap(pixmap)
        image_layout.addWidget(self.image_label)
        layout.addWidget(image_frame, alignment=Qt.AlignCenter)

        self.nom_label = QLabel(self._nom_court(composant.nom, composant.service_api_nom), self)
        self.nom_label.setObjectName("ComposantMiniTuileNom")
        self.nom_label.setAlignment(Qt.AlignCenter)
        self.nom_label.setWordWrap(True)
        layout.addWidget(self.nom_label)

        self.coche_icon = QLabel(self)
        self.coche_icon.setPixmap(qta.icon("mdi6.check-circle", color=Mocha.green).pixmap(16, 16))
        self.coche_icon.setFixedSize(16, 16)
        self.coche_icon.setVisible(False)
        self.coche_icon.move(90, 6)
        self.coche_icon.raise_()

    @staticmethod
    def _nom_court(nom_complet: str, service_api_nom: str) -> str:
        prefixe = f"{service_api_nom}-"
        return nom_complet[len(prefixe):] if nom_complet.startswith(prefixe) else nom_complet

    def set_selectionnee(self, selectionnee: bool):
        self.setProperty("selectionnee", "true" if selectionnee else "false")
        self.style().unpolish(self)
        self.style().polish(self)
        self.coche_icon.setVisible(selectionnee)

    def mousePressEvent(self, event):
        if event.button() == Qt.LeftButton:
            self.clique.emit(self.composant_nom)
        super().mousePressEvent(event)


class ComposantImporteTuile(QFrame):
    """Mini-vignette d'un composant IMPORTÉ dans le pool d'un APIFeatures,
    affichée dans la card « Composants » en haut de l'éditeur de ServiceAPI.
    Reprend le même gabarit visuel que ComposantMiniTuile.

    Deux modes, exclusifs l'un de l'autre (Patch 9bis — mode sélection
    pour une zone deb/running/end d'une Feature) :
    - Mode normal : petit bouton "x" superposé (même pattern que
      VarianteVignette) pour retirer le composant du pool importé de
      l'APIFeatures. Clic simple = rien (pas de sélection).
    - Mode sélection (une zone d'une Feature demande à ajouter des
      composants) : le bouton "x" est caché, la tuile entière devient
      cliquable et bascule un état visuel coché/décoché (comme
      ComposantMiniTuile), sans effet immédiat — la validation groupée se
      fait via le bouton "Valider" de la card (voir CardComposantsAPIFeatures)."""

    demande_suppression = Signal(str)  # nom complet du composant
    clique = Signal(str)  # nom complet du composant (mode sélection uniquement)

    def __init__(self, composant: Composant, image_absolue: Path, parent=None):
        super().__init__(parent)
        self.composant_nom = composant.nom
        self.setObjectName("ComposantMiniTuile")
        self.setProperty("selectionnee", "false")
        self.setFixedWidth(112)
        self._mode_selection = False
        self._survolee = False

        layout = QVBoxLayout(self)
        layout.setContentsMargins(8, 8, 8, 8)
        layout.setSpacing(6)

        image_frame = QFrame(self)
        image_frame.setObjectName("ComposantTuileImageFrame")
        image_frame.setFixedSize(96, 68)
        image_layout = QVBoxLayout(image_frame)
        image_layout.setContentsMargins(0, 0, 0, 0)

        self.image_label = QLabel(image_frame)
        self.image_label.setAlignment(Qt.AlignCenter)
        if image_absolue.exists():
            pixmap = QPixmap(str(image_absolue))
            if not pixmap.isNull():
                pixmap = pixmap.scaled(96, 68, Qt.KeepAspectRatio, Qt.SmoothTransformation)
                self.image_label.setPixmap(pixmap)
            else:
                print(f"[AutoniaX] Image illisible (fichier corrompu ?) pour « {composant.nom} » : {image_absolue}")
                self.image_label.setText("(image\nillisible)")
        else:
            print(f"[AutoniaX] Image introuvable pour « {composant.nom} » : {image_absolue}")
            self.image_label.setText("(image\nintrouvable)")
        image_layout.addWidget(self.image_label)
        layout.addWidget(image_frame, alignment=Qt.AlignCenter)

        self.nom_label = QLabel(
            ComposantMiniTuile._nom_court(composant.nom, composant.service_api_nom), self
        )
        self.nom_label.setObjectName("ComposantMiniTuileNom")
        self.nom_label.setAlignment(Qt.AlignCenter)
        self.nom_label.setWordWrap(True)
        layout.addWidget(self.nom_label)

        self.suppr_button = QToolButton(self)
        self.suppr_button.setObjectName("VarianteSupprButton")
        self.suppr_button.setIcon(qta.icon("mdi6.close", color=Mocha.crust))
        self.suppr_button.setIconSize(QSize(10, 10))
        self.suppr_button.setFixedSize(16, 16)
        self.suppr_button.setCursor(Qt.PointingHandCursor)
        self.suppr_button.setToolTip("Retirer ce composant de la Feature")
        self.suppr_button.clicked.connect(
            lambda: self.demande_suppression.emit(self.composant_nom)
        )
        self.suppr_button.move(88, 2)
        self.suppr_button.raise_()
        self.suppr_button.setVisible(False)  # caché tant que la souris n'a pas survolé

        self.coche_icon = QLabel(self)
        self.coche_icon.setPixmap(qta.icon("mdi6.check-circle", color=Mocha.green).pixmap(16, 16))
        self.coche_icon.setFixedSize(16, 16)
        self.coche_icon.setVisible(False)
        self.coche_icon.move(90, 6)
        self.coche_icon.raise_()

    def set_mode_selection(self, actif: bool):
        """Bascule entre mode normal (bouton "x" de retrait) et mode
        sélection (tuile cliquable, coche visuelle, pas de retrait)."""
        self._mode_selection = actif
        self.suppr_button.setVisible((not actif) and self._survolee)
        self.setCursor(Qt.PointingHandCursor if actif else Qt.ArrowCursor)
        if not actif:
            self.set_selectionnee(False)

    def set_selectionnee(self, selectionnee: bool):
        self.setProperty("selectionnee", "true" if selectionnee else "false")
        self.style().unpolish(self)
        self.style().polish(self)
        self.coche_icon.setVisible(selectionnee)

    def enterEvent(self, event):
        self._survolee = True
        self.suppr_button.setVisible(not self._mode_selection)
        super().enterEvent(event)

    def leaveEvent(self, event):
        self._survolee = False
        self.suppr_button.setVisible(False)
        super().leaveEvent(event)

    def mousePressEvent(self, event):
        if self._mode_selection and event.button() == Qt.LeftButton:
            self.clique.emit(self.composant_nom)
            return
        super().mousePressEvent(event)


class ServiceAPIAccordeonSection(QWidget):
    """Section dépliable pour un ServiceAPI dans le panneau d'import
    (PaletteComposantsPanel) : en-tête cliquable (checkbox + nom de
    le ServiceAPI + chevron + compteur de composants) qui déplie/replie la
    grille de composants en dessous. Replié par défaut — on ne voit
    d'abord que la liste des ServiceAPI, on déplie pour voir/sélectionner
    les composants un par un, OU on coche la checkbox de l'en-tête pour
    tout sélectionner d'un coup.

    Cocher la checkbox de le ServiceAPI = sélectionne tous ses composants et
    verrouille l'accordéon fermé (impossible de déplier tant qu'elle reste
    cochée). Décocher = déselectionne tout et déverrouille le dépli. Les
    deux modes (tout-ou-rien via la checkbox, ou un par un via le dépli)
    coexistent, mais pas en même temps sur un ServiceAPI donnée."""

    selection_service_api_changee = Signal(str, bool)  # (service_api_nom, tout_selectionne)

    def __init__(self, service_api_nom: str, nb_composants: int, parent=None):
        super().__init__(parent)
        self.setObjectName("ServiceAPIAccordeonSection")
        self.service_api_nom = service_api_nom
        self._plie = True
        self._verrouillee = False

        layout = QVBoxLayout(self)
        layout.setContentsMargins(0, 0, 0, 0)
        layout.setSpacing(0)

        self.header = QWidget(self)
        self.header.setObjectName("ServiceAPIAccordeonHeader")
        self.header.setCursor(Qt.PointingHandCursor)
        header_layout = QHBoxLayout(self.header)
        header_layout.setContentsMargins(10, 8, 10, 8)
        header_layout.setSpacing(8)

        self.case_tout = QCheckBox(self.header)
        self.case_tout.setObjectName("ServiceAPIAccordeonCase")
        self.case_tout.setCursor(Qt.PointingHandCursor)
        self.case_tout.toggled.connect(self._on_case_tout_toggled)
        header_layout.addWidget(self.case_tout)

        self.chevron_label = QLabel(self.header)
        self.chevron_label.setPixmap(qta.icon("mdi6.chevron-right", color=Mocha.subtext0).pixmap(16, 16))
        header_layout.addWidget(self.chevron_label)

        nom_label = QLabel(service_api_nom, self.header)
        nom_label.setObjectName("ServiceAPIAccordeonNom")
        header_layout.addWidget(nom_label, 1)

        compteur_label = QLabel(f"{nb_composants}", self.header)
        compteur_label.setObjectName("ServiceAPIAccordeonCompteur")
        header_layout.addWidget(compteur_label)

        self.header.mousePressEvent = self._on_header_clicked
        layout.addWidget(self.header)

        self.grid_container = FlowGrid(item_width=112, spacing=10)
        self.grid_container.setVisible(False)
        layout.addWidget(self.grid_container)

    def _on_header_clicked(self, event):
        if event.button() != Qt.LeftButton:
            return
        # Un clic sur la checkbox elle-même ne doit pas aussi basculer le
        # dépli (elle gère son propre clic via toggled) ; on ignore donc
        # les clics dont la position tombe sur la case.
        if self.case_tout.geometry().contains(event.pos()):
            return
        if self._verrouillee:
            return
        self.set_plie(not self._plie)

    def _on_case_tout_toggled(self, coche: bool):
        self._verrouillee = coche
        if coche and not self._plie:
            self.set_plie(True)
        self.selection_service_api_changee.emit(self.service_api_nom, coche)

    def set_case_tout_coche(self, coche: bool):
        """Met à jour la checkbox sans redéclencher la logique de
        sélection (utilisé quand le panneau parent resynchronise l'état
        visuel, par ex. après une sélection individuelle qui reconstitue
        une sélection complète)."""
        self.case_tout.blockSignals(True)
        self.case_tout.setChecked(coche)
        self.case_tout.blockSignals(False)
        self._verrouillee = coche

    def set_plie(self, plie: bool):
        if self._verrouillee and not plie:
            return  # verrouillée : impossible de déplier tant que cochée
        self._plie = plie
        self.grid_container.setVisible(not plie)
        icone = "mdi6.chevron-right" if plie else "mdi6.chevron-down"
        self.chevron_label.setPixmap(qta.icon(icone, color=Mocha.subtext0).pixmap(16, 16))

    def add_tuile(self, tuile: "ComposantMiniTuile"):
        self.grid_container.add_item(tuile)


class PaletteComposantsPanel(QWidget):
    """Panneau latéral rétractable (Patch 9, point 12), dédié à l'IMPORT de
    composants du Project vers le pool de l'APIFeatures courante (CardComposantsAPIFeatures).

    Affichage en accordéon : une section repliée par défaut par ServiceAPI
    (nom + compteur), qu'on déplie pour voir la grille de composants. Un
    clic sur une tuile bascule sa sélection (coché/décoché, pas d'ajout
    immédiat). Le bouton « Importer » en bas du panneau valide toute la
    sélection d'un coup et ferme le panneau."""

    demande_import_valide = Signal(list)  # liste des noms complets sélectionnés
    demande_fermeture = Signal()

    def __init__(self, project: Project, parent=None):
        super().__init__(parent)
        self.project = project
        self.setObjectName("PalettePanel")
        self.setFixedWidth(260)
        self._selection: set = set()  # noms complets actuellement cochés

        outer_layout = QVBoxLayout(self)
        outer_layout.setContentsMargins(0, 0, 0, 0)
        outer_layout.setSpacing(0)

        header_row = QHBoxLayout()
        header_row.setContentsMargins(16, 14, 12, 8)
        header_label = QLabel("IMPORTER DES COMPOSANTS", self)
        header_label.setObjectName("ReglagesPanelTitle")
        header_row.addWidget(header_label)
        header_row.addStretch(1)
        close_button = QToolButton(self)
        close_button.setObjectName("ClosePanelButton")
        close_button.setIcon(qta.icon("mdi6.close", color=Mocha.subtext0))
        close_button.setCursor(Qt.PointingHandCursor)
        close_button.clicked.connect(self.demande_fermeture.emit)
        header_row.addWidget(close_button)
        outer_layout.addLayout(header_row)

        hint_label = QLabel(
            "Dépliez un ServiceAPI, cliquez les composants voulus, puis Importer.",
            self,
        )
        hint_label.setObjectName("PaletteHintLabel")
        hint_label.setWordWrap(True)
        outer_layout.addWidget(hint_label)

        scroll_area = QScrollArea(self)
        scroll_area.setObjectName("ReglagesPanelScroll")
        scroll_area.setWidgetResizable(True)
        scroll_area.setFrameShape(QFrame.NoFrame)
        scroll_area.setHorizontalScrollBarPolicy(Qt.ScrollBarAlwaysOff)
        scroll_area.setVerticalScrollBarPolicy(Qt.ScrollBarAlwaysOff)
        outer_layout.addWidget(scroll_area, 1)

        self.content = QWidget(scroll_area)
        self.content_layout = QVBoxLayout(self.content)
        self.content_layout.setContentsMargins(12, 8, 12, 16)
        self.content_layout.setSpacing(6)
        self.content_layout.addStretch(1)
        scroll_area.setWidget(self.content)

        self.placeholder_label = QLabel(
            "Aucun composant dans le projet. Créez-en depuis l'écran Composants.",
            self.content,
        )
        self.placeholder_label.setObjectName("PlaceholderSubtitle")
        self.placeholder_label.setWordWrap(True)
        self.content_layout.insertWidget(0, self.placeholder_label)

        # --- Bouton "Importer" en bas du panneau (validation finale) ---
        importer_row = QWidget(self)
        importer_row_layout = QHBoxLayout(importer_row)
        importer_row_layout.setContentsMargins(16, 8, 16, 16)
        self.importer_button = QPushButton(
            qta.icon("mdi6.tray-arrow-down", color=Mocha.text), " Importer", importer_row
        )
        self.importer_button.setObjectName("UpdateImageButton")
        self.importer_button.setCursor(Qt.PointingHandCursor)
        self.importer_button.setEnabled(False)
        self.importer_button.clicked.connect(self._on_importer_clicked)
        importer_row_layout.addWidget(self.importer_button)
        outer_layout.addWidget(importer_row)

    def rafraichir(self, exclure: Optional[list] = None):
        """Reconstruit le panneau en accordéon, groupé par ServiceAPI.
        `exclure` : noms de composants à ne pas proposer (déjà importés
        dans la Feature courante)."""
        exclure = set(exclure or [])
        self._selection = set()
        self._mettre_a_jour_bouton_importer()

        # Retire tout SAUF le placeholder (identifié explicitement, pas par
        # position d'index — takeAt(0) sur un layout ne remet jamais le
        # widget retiré à sa place, donc s'y fier romprait le placeholder
        # dès le 2e appel).
        widgets_a_retirer = []
        for i in range(self.content_layout.count()):
            item = self.content_layout.itemAt(i)
            w = item.widget()
            if w is not None and w is not self.placeholder_label:
                widgets_a_retirer.append(w)
        for w in widgets_a_retirer:
            self.content_layout.removeWidget(w)
            w.setParent(None)
            w.deleteLater()

        composants_par_service_api: dict = {}
        for composant in self.project.composants:
            if composant.nom in exclure:
                continue
            composants_par_service_api.setdefault(composant.service_api_nom, []).append(composant)

        if not composants_par_service_api:
            self.placeholder_label.setText(
                "Aucun composant disponible à importer "
                "(déjà tous importés, ou aucun composant dans le projet)."
            )
            self.placeholder_label.setVisible(True)
            return
        self.placeholder_label.setVisible(False)

        index_insertion = 0
        for service_api_nom in sorted(composants_par_service_api.keys()):
            composants = composants_par_service_api[service_api_nom]
            section = ServiceAPIAccordeonSection(service_api_nom, len(composants), self.content)
            section.selection_service_api_changee.connect(self._on_selection_service_api_changee)
            for composant in composants:
                image_absolue = get_app_data_dir() / composant.image_path
                tuile = ComposantMiniTuile(composant, image_absolue)
                tuile.clique.connect(self._on_tuile_cliquee)
                section.add_tuile(tuile)
            self.content_layout.insertWidget(index_insertion, section)
            index_insertion += 1

    def _on_tuile_cliquee(self, composant_nom: str):
        # Bascule la sélection (coché/décoché) — recherche la tuile
        # concernée pour rafraîchir son état visuel sans reconstruire tout
        # le panneau (évite de replier les sections déjà dépliées).
        if composant_nom in self._selection:
            self._selection.discard(composant_nom)
        else:
            self._selection.add(composant_nom)
        self._rafraichir_etat_visuel_tuiles()
        self._mettre_a_jour_bouton_importer()

    def _on_selection_service_api_changee(self, service_api_nom: str, tout_selectionne: bool):
        # Case cochée sur l'en-tête d'un ServiceAPI = tout sélectionner
        # d'un coup ; décochée = tout retirer de la sélection. La case
        # globale prend le dessus sur une éventuelle sélection partielle
        # existante (pas de retour à l'état partiel précédent en décochant).
        section = self._trouver_section(service_api_nom)
        if section is None:
            return
        for tuile in section.grid_container._items:
            if tout_selectionne:
                self._selection.add(tuile.composant_nom)
            else:
                self._selection.discard(tuile.composant_nom)
        self._rafraichir_etat_visuel_tuiles()
        self._mettre_a_jour_bouton_importer()

    def _trouver_section(self, service_api_nom: str) -> Optional["ServiceAPIAccordeonSection"]:
        for i in range(self.content_layout.count()):
            item = self.content_layout.itemAt(i)
            section = item.widget()
            if isinstance(section, ServiceAPIAccordeonSection) and section.service_api_nom == service_api_nom:
                return section
        return None

    def _rafraichir_etat_visuel_tuiles(self):
        for i in range(self.content_layout.count()):
            item = self.content_layout.itemAt(i)
            section = item.widget()
            if not isinstance(section, ServiceAPIAccordeonSection):
                continue
            tuiles = section.grid_container._items
            for tuile in tuiles:
                tuile.set_selectionnee(tuile.composant_nom in self._selection)
            # Resynchronise la checkbox de l'en-tête : cochée seulement si
            # TOUS les composants de ce ServiceAPI sont sélectionnés.
            tout_coche = bool(tuiles) and all(t.composant_nom in self._selection for t in tuiles)
            section.set_case_tout_coche(tout_coche)

    def _mettre_a_jour_bouton_importer(self):
        nb = len(self._selection)
        if nb:
            self.importer_button.setText(f" Importer ({nb})")
        else:
            self.importer_button.setText(" Importer")
        self.importer_button.setEnabled(nb > 0)

    def _on_importer_clicked(self):
        if not self._selection:
            return
        self.demande_import_valide.emit(list(self._selection))


class ServiceAPIScreen(QWidget):
    """
    Onglet API (Patch 8 — structure de base, Patch 9/9bis — palette
    ON/OFF, renommage Task->Work / State->Task + restructuration en 3
    zones deb/running/end ; renommage ultérieur Work->APIFeatures,
    Task->Feature, Interface->ServiceAPI ; Phase B — fusion avec l'ancien
    écran séparé "Composants" en un seul écran par ServiceAPI ; Phase C —
    retrait complet de Feature/APIFeatures, décision explicite utilisateur :
    les Actions sont désormais globales à tout le Project
    (Project.bibliotheque_actions, cf. BibliothequeActionsScreen), plus du
    tout liées à un ServiceAPI précis).
    - Vue par défaut : grille de cards des ServiceAPI sauvegardés (point 18),
      + bouton flottant "+ Nouveau ServiceAPI".
    - Clic sur une card -> OUVRE le ServiceAPI : la grille disparaît, remplacée
      par l'éditeur (bouton "Retour" pour revenir à la grille). Jamais
      d'ouverture ailleurs dans l'app (pas d'onglet Applications ici,
      contrairement au test de composant).
    - Éditeur (Phase C, redevenu simple, puis section 7.1 de
      SPEC_composantLayout.md) : plus de Features/Actions ici -- l'éditeur
      porte désormais 2 onglets (self.onglets_editeur, QTabWidget léger
      réintroduit pour cL, cf. docstring de ComposantsLayoutScreen pour la
      justification détaillée) : "Composants" (édition des ComposantSingle
      -- capture, grille de vignettes, panneau de réglages, variantes,
      zone de clic -- pilotée via set_service_api_actif(nom) sur
      l'instance de ComposantsScreen réutilisée telle quelle) et
      "ComposantLayout" (grille + panneau flottant de ComposantsLayoutScreen,
      même pilotage par set_service_api_actif(nom)). CORRECTIF : cette
      docstring affirmait encore "plus de QTabWidget" après l'ajout de cL,
      contredisant le code juste en dessous -- mis à jour ici.
    """

    demande_ouvrir_test_composant = Signal(str)  # relais depuis l'écran Composants (nom complet du composant)
    # AJOUT (cL, SPEC section 7.2) : relais depuis ComposantsLayoutScreen
    # (bouton "Modifier" du panneau flottant) -- nom complet du
    # ComposantLayout, MÊME patron que demande_ouvrir_test_composant.
    demande_ouvrir_config_layout = Signal(str)
    # AJOUT (retrait de l'onglet Test intégré à ComposantLayoutConfigScreen)
    # : relais depuis ComposantsLayoutScreen (bouton "Tester" du panneau
    # flottant) -- nom complet du ComposantLayout, MÊME patron que
    # demande_ouvrir_test_composant/demande_ouvrir_config_layout ci-dessus.
    demande_ouvrir_test_composant_layout = Signal(str)

    def __init__(self, project: Project, parent=None):
        super().__init__(parent)
        self.project = project
        self._service_api_courant: Optional[str] = None  # nom du ServiceAPI ouvert, None = vue grille
        self._service_api_cartes: dict = {}  # nom ServiceAPI -> ServiceAPICarte

        root_layout = QVBoxLayout(self)
        root_layout.setContentsMargins(0, 0, 0, 0)
        root_layout.setSpacing(0)

        self.stack = QStackedWidget(self)
        root_layout.addWidget(self.stack, 1)

        self._build_grille()
        self._build_editeur()

        self.stack.addWidget(self.grille_page)
        self.stack.addWidget(self.editeur_page)
        self.stack.setCurrentWidget(self.grille_page)

        self._reload_grille()

    # ------------------------------------------------------------------
    # Vue grille (par défaut)
    # ------------------------------------------------------------------
    def _build_grille(self):
        self.grille_page = QWidget(self)
        outer_layout = QVBoxLayout(self.grille_page)
        outer_layout.setContentsMargins(28, 24, 28, 24)
        outer_layout.setSpacing(4)

        # --- Titre de page (point 18 : la vue ServiceAPI doit s'introduire
        # elle-même, ce n'est pas juste une grille nue) ---
        titre_label = QLabel("ServiceAPI", self.grille_page)
        titre_label.setObjectName("PlaceholderTitle")
        outer_layout.addWidget(titre_label)

        sous_titre_label = QLabel(
            "Cliquez sur un ServiceAPI pour l'ouvrir, ou créez-en un nouveau.",
            self.grille_page,
        )
        sous_titre_label.setObjectName("PlaceholderSubtitle")
        outer_layout.addWidget(sous_titre_label)
        outer_layout.addSpacing(16)

        # --- Zone de contenu (placeholder ou grille), centrée verticalement
        # ET horizontalement dans l'espace restant sous le titre. ---
        self.zone_contenu = QWidget(self.grille_page)
        zone_layout = QVBoxLayout(self.zone_contenu)
        zone_layout.setContentsMargins(0, 0, 0, 0)
        zone_layout.setSpacing(0)
        outer_layout.addWidget(self.zone_contenu, 1)

        # Placeholder affiché tant qu'aucun ServiceAPI n'existe — centré dans la zone.
        self.placeholder_widget = QWidget(self.zone_contenu)
        placeholder_layout = QVBoxLayout(self.placeholder_widget)
        placeholder_layout.setAlignment(Qt.AlignCenter)
        placeholder_layout.setSpacing(16)
        placeholder_icon = QLabel(self.placeholder_widget)
        placeholder_icon.setPixmap(qta.icon("mdi6.format-list-checks", color=Mocha.surface2).pixmap(40, 40))
        placeholder_icon.setAlignment(Qt.AlignCenter)
        placeholder_layout.addWidget(placeholder_icon)
        placeholder_texte = QLabel(
            "Aucun ServiceAPI pour l'instant. Cliquez sur « + » pour en créer un.",
            self.placeholder_widget,
        )
        placeholder_texte.setObjectName("PlaceholderSubtitle")
        placeholder_texte.setAlignment(Qt.AlignCenter)
        placeholder_layout.addWidget(placeholder_texte)
        zone_layout.addWidget(self.placeholder_widget, 1)

        # Grille de ServiceAPI (FlowGrid centrée horizontalement via center=True).
        # Enrobée dans un wrapper avec stretch haut/bas : ça centre aussi
        # verticalement quand peu de ServiceAPI tiennent sur un seul écran (les
        # stretchs s'effacent naturellement dès que le contenu dépasse la
        # hauteur visible, et le scroll reprend la main normalement).
        self.grid_scroll = QScrollArea(self.zone_contenu)
        self.grid_scroll.setObjectName("FlowGridViewport")
        self.grid_scroll.setWidgetResizable(True)
        self.grid_scroll.setFrameShape(QFrame.NoFrame)
        self.grid_scroll.setHorizontalScrollBarPolicy(Qt.ScrollBarAlwaysOff)
        self.grid_scroll.setVerticalScrollBarPolicy(Qt.ScrollBarAlwaysOff)

        grid_wrapper = QWidget(self.grid_scroll)
        grid_wrapper_layout = QVBoxLayout(grid_wrapper)
        grid_wrapper_layout.setContentsMargins(0, 0, 0, 0)
        grid_wrapper_layout.setSpacing(0)
        grid_wrapper_layout.addStretch(1)
        self.flow_grid = FlowGrid(item_width=200, spacing=14, center=True)
        grid_wrapper_layout.addWidget(self.flow_grid)
        grid_wrapper_layout.addStretch(1)
        self.grid_scroll.setWidget(grid_wrapper)
        self.grid_scroll.setVisible(False)
        zone_layout.addWidget(self.grid_scroll, 1)

        # --- Bouton flottant "+ Nouveau ServiceAPI", toujours en bas à droite
        # de l'écran (repositionné par un eventFilter sur grille_page, plus
        # fiable qu'un resizeEvent de ServiceAPIScreen : celui-ci ne se déclenche
        # pas forcément avant que le QStackedWidget n'ait donné sa
        # géométrie finale à grille_page au tout premier affichage). ---
        self.floating_add_button = QToolButton(self.grille_page)
        self.floating_add_button.setObjectName("FloatingAddButton")
        self.floating_add_button.setIcon(qta.icon("mdi6.plus", color=Mocha.crust))
        self.floating_add_button.setIconSize(QSize(26, 26))
        self.floating_add_button.setFixedSize(44, 44)
        self.floating_add_button.setCursor(Qt.PointingHandCursor)
        self.floating_add_button.setToolTip("Nouveau ServiceAPI")
        self.floating_add_button.clicked.connect(self._creer_service_api)
        self.floating_add_button.raise_()

        # --- Bouton flottant "Importer un ServiceAPI" (PATCH demandé par
        # l'utilisateur : "importer un service api deja creer avec tout les
        # composant" -- DISTINCT du bouton "+" ci-dessus, qui crée un
        # ServiceAPI VIDE. Même agencement que floating_import_button de
        # TaskConfigScreen (cf. _demande_import_task) : positionné juste à
        # GAUCHE du "+", même y, repositionné par le même eventFilter/
        # resizeEvent -- cohérence avec le seul autre import déjà présent
        # dans l'app plutôt qu'un empilement vertical inédit). ---
        self.floating_import_button = QToolButton(self.grille_page)
        self.floating_import_button.setObjectName("FloatingAddButton")
        self.floating_import_button.setIcon(qta.icon("mdi6.tray-arrow-down", color=Mocha.crust))
        self.floating_import_button.setIconSize(QSize(22, 22))
        self.floating_import_button.setFixedSize(44, 44)
        self.floating_import_button.setCursor(Qt.PointingHandCursor)
        self.floating_import_button.setToolTip(f"Importer un ServiceAPI ({EXTENSION_FICHIER_SERVICE_API})")
        self.floating_import_button.clicked.connect(self._demande_import_service_api_fichier)
        self.floating_import_button.raise_()

        self.grille_page.installEventFilter(self)

    def eventFilter(self, watched, event):
        if watched is self.grille_page and event.type() in (QEvent.Resize, QEvent.Show):
            self._repositionner_bouton_flottant()
        return super().eventFilter(watched, event)

    def resizeEvent(self, event):
        super().resizeEvent(event)
        self._repositionner_bouton_flottant()

    def _repositionner_bouton_flottant(self):
        parent = self.floating_add_button.parentWidget()
        if parent is None:
            return
        marge = 24
        x = parent.width() - self.floating_add_button.width() - marge
        y = parent.height() - self.floating_add_button.height() - marge
        self.floating_add_button.move(max(0, x), max(0, y))
        # Bouton d'import juste à gauche du "+" -- même y, x décalé d'une
        # largeur de bouton + un petit espacement (même constante locale
        # que floating_import_button de TaskConfigScreen).
        espacement = 10
        x_import = x - self.floating_import_button.width() - espacement
        self.floating_import_button.move(max(0, x_import), max(0, y))

    def _reload_grille(self):
        self.flow_grid.clear()
        self._service_api_cartes = {}
        for service_api in self.project.services_api:
            carte = ServiceAPICarte(service_api)
            carte.clique.connect(self._ouvrir_service_api)
            self._service_api_cartes[service_api.nom] = carte
            self.flow_grid.add_item(carte)

        vide = len(self.project.services_api) == 0
        self.placeholder_widget.setVisible(vide)
        self.grid_scroll.setVisible(not vide)
        self._repositionner_bouton_flottant()

    def _creer_service_api(self):
        service_api = self.project.add_service_api_avec_nom_auto()
        self.project.save()
        self._reload_grille()
        self._notify_status(f"ServiceAPI « {service_api.nom} » créé.")
        self._ouvrir_service_api(service_api.nom)

    def _demande_import_service_api_fichier(self):
        """PATCH demandé par l'utilisateur : "importer un service api deja
        creer avec tout les composant" -- lit un pack .autoniaxservice
        choisi par l'utilisateur et ajoute le ServiceAPI reconstruit (+
        tous ses Composants + leurs images) au Project courant (cf.
        importer_service_api_depuis_zip). DISTINCT de _creer_service_api :
        celui-ci crée toujours un NOUVEAU ServiceAPI déjà rempli, jamais un
        ServiceAPI vide à capturer manuellement ensuite.

        Nommage volontairement distinct de TaskConfigScreen.
        _demande_import_service_api (classe différente, rôle différent :
        celle-ci importe un ServiceAPI DEPUIS UN FICHIER dans le Project,
        l'autre lie un ServiceAPI déjà présent dans le Project à un Task
        précis -- même verbe "importer" au sens utilisateur, deux actions
        distinctes, d'où le suffixe _fichier ici pour éviter toute
        confusion à la lecture du code).

        Point d'entrée : floating_import_button (cf. _build_grille),
        toujours visible dans la vue grille -- pas besoin d'être dans
        l'éditeur pour importer, même logique que _demande_import_task
        côté TaskConfigScreen."""
        chemin, _ = BoiteDialogueAutoniaX.ouvrir_fichier(
            self, "Importer un ServiceAPI", "",
            f"ServiceAPI AutoniaX (*{EXTENSION_FICHIER_SERVICE_API});;Tous les fichiers (*)",
        )
        if not chemin:
            return
        try:
            service_api, avertissements = importer_service_api_depuis_zip(self.project, chemin)
        except ValueError as e:
            BoiteDialogueAutoniaX.critical(self, "Échec de l'import", str(e))
            return

        self.project.save()
        self._reload_grille()

        if avertissements:
            BoiteDialogueAutoniaX.warning(
                self, "ServiceAPI importé avec avertissements",
                f"ServiceAPI « {service_api.nom} » importé, avec {len(avertissements)} avertissement(s) :\n\n"
                + "\n".join(f"• {a}" for a in avertissements),
            )
        # CORRECTIF (même bug que ServiceAPICarteV2._rafraichir_info,
        # retour utilisateur : "ça compte que les composants single") --
        # ce message ne comptait que service_api.composants, jamais
        # composants_layout (liste séparée, cf. sa docstring dans
        # ServiceAPI) alors qu'un pack importé peut très bien contenir
        # des ComposantLayout.
        nb_total = len(service_api.composants) + len(service_api.composants_layout)
        self._notify_status(f"ServiceAPI « {service_api.nom} » importé ({nb_total} composant(s)).")
        self._ouvrir_service_api(service_api.nom)

    # ------------------------------------------------------------------
    # Vue éditeur (ouverte au clic sur une card) -- Phase C : un seul
    # contenu (Composants), plus d'onglets.
    # ------------------------------------------------------------------
    def _build_editeur(self):
        self.editeur_page = QWidget(self)
        outer_layout = QVBoxLayout(self.editeur_page)
        outer_layout.setContentsMargins(0, 0, 0, 0)
        outer_layout.setSpacing(0)

        # --- Barre d'outils du haut (nom inline + menu ⋮ + retour) ---
        toolbar = QWidget(self.editeur_page)
        toolbar.setObjectName("APIFeaturesEditeurToolbar")
        toolbar_layout = QHBoxLayout(toolbar)
        toolbar_layout.setContentsMargins(16, 12, 16, 12)
        toolbar_layout.setSpacing(14)

        self.retour_button = QToolButton(toolbar)
        self.retour_button.setObjectName("RetourButton")
        self.retour_button.setIcon(qta.icon("mdi6.arrow-left", color=Mocha.subtext0))
        self.retour_button.setIconSize(QSize(18, 18))
        self.retour_button.setCursor(Qt.PointingHandCursor)
        self.retour_button.setToolTip("Retour à la liste des ServiceAPI")
        self.retour_button.clicked.connect(self._retour_grille)
        toolbar_layout.addWidget(self.retour_button)

        nom_label = QLabel("Nom :", toolbar)
        nom_label.setObjectName("ReglagesLabel")
        toolbar_layout.addWidget(nom_label)

        self.nom_edit = QLineEdit(toolbar)
        self.nom_edit.setObjectName("APIFeaturesNomEdit")
        self.nom_edit.setFixedWidth(240)
        self.nom_edit.editingFinished.connect(self._on_nom_edited)
        toolbar_layout.addWidget(self.nom_edit)

        toolbar_layout.addStretch(1)

        self.menu_api_features_button = QToolButton(toolbar)
        self.menu_api_features_button.setObjectName("APIFeaturesMenuButton")
        self.menu_api_features_button.setIcon(qta.icon("mdi6.dots-vertical", color=Mocha.subtext0))
        self.menu_api_features_button.setIconSize(QSize(20, 20))
        self.menu_api_features_button.setCursor(Qt.PointingHandCursor)
        self.menu_api_features_button.setToolTip("Options du ServiceAPI")
        self.menu_api_features_button.clicked.connect(self._show_service_api_menu)
        toolbar_layout.addWidget(self.menu_api_features_button)

        outer_layout.addWidget(toolbar)

        # --- Corps : QTabWidget à 2 onglets (Composants | ComposantLayout)
        # -- AJOUT (cL, SPEC_composantLayout.md section 7.1) : réintroduit
        # un QTabWidget léger ici, retiré en Phase C (cf. docstring de
        # classe ci-dessus pour la justification complète de pourquoi ce
        # n'est PAS une régression de Phase C -- raison différente, motif
        # nouveau). ComposantsScreen reste le premier onglet, INCHANGÉE. ---
        self.onglets_editeur = QTabWidget(self.editeur_page)
        self.onglets_editeur.setObjectName("ServiceAPIEditeurTabs")

        self.composants_tab = ComposantsScreen(self.project, self.editeur_page)
        self.composants_tab.demande_ouvrir_test_composant.connect(
            self.demande_ouvrir_test_composant.emit
        )
        # AJOUT (SPEC_lot_corrections_2026-09.md section 3, compteur
        # cL/cS) : tient à jour le libellé de l'onglet "ComposantSingle
        # (N)" à chaque changement du nombre de composants affichés.
        self.composants_tab.nb_composants_change.connect(
            self._sur_nb_composants_change
        )
        # CORRECTIF (oubli signalé : "je dis l'onglet qui s'affiche
        # lorsqu'on ouvre un service api, actuellement c'est uniquement
        # celui de composant layout qui est bien écrit") -- symétrique du
        # libellé "ComposantLayout" juste en dessous, pour bien
        # distinguer les deux types de composant dès le libellé de
        # l'onglet (avant, "Composants" seul ne précisait pas qu'il
        # s'agit spécifiquement du composant SINGLE, par opposition au
        # layout).
        self.onglets_editeur.addTab(self.composants_tab, "ComposantSingle")

        self.composants_layout_tab = ComposantsLayoutScreen(self.project, self.editeur_page)
        self.composants_layout_tab.demande_ouvrir_config_layout.connect(
            self.demande_ouvrir_config_layout.emit
        )
        # AJOUT (section 3, compteur cL/cS) : MÊME patron que nb_composants_
        # change ci-dessus, pour le libellé "ComposantLayout (N)".
        self.composants_layout_tab.nb_composants_layout_change.connect(
            self._sur_nb_composants_layout_change
        )
        # AJOUT (retrait de l'onglet Test intégré) -- relais pur, MÊME
        # patron que demande_ouvrir_config_layout juste au-dessus.
        self.composants_layout_tab.demande_ouvrir_test_composant_layout.connect(
            self.demande_ouvrir_test_composant_layout.emit
        )
        # CORRECTIF (hasattr(self, "_notify_status") mort dans
        # ComposantsLayoutScreen._charger_grille -- cette classe n'a
        # jamais eu son propre _notify_status). Relais vers CELUI de
        # ServiceAPIScreen (défini plus bas dans cette classe), seul
        # endroit qui possède réellement ce mécanisme pour cet onglet.
        self.composants_layout_tab.demande_notification.connect(self._notify_status)
        self.onglets_editeur.addTab(self.composants_layout_tab, "ComposantLayout")
        # AJOUT (section 3) : libellé initial correct dès la construction
        # -- les deux onglets démarrent à 0 composant (aucun ServiceAPI
        # actif pour l'instant, cf. set_service_api_actif(None) implicite
        # tant qu'aucune card n'a été ouverte), les signaux ci-dessus ne
        # se déclenchant qu'au PROCHAIN changement d'état.
        self._sur_nb_composants_change(self.composants_tab.nb_composants)
        self._sur_nb_composants_layout_change(self.composants_layout_tab.nb_composants_layout)

        # CORRECTIF (bug rapporté : "j'ai renommé un cL et ça n'apparaît
        # plus dans la grille") -- ComposantLayoutConfigScreen (ouvert
        # depuis ApplicationsScreen, un écran DISTINCT de celui-ci) peut
        # désormais renommer un ComposantLayout (cf. Project.rename_
        # composant_layout) sans que cette grille -- dont les tuiles
        # (_tuiles, cf. ComposantsLayoutScreen._charger_grille) sont
        # indexées par nom et construites une seule fois par set_
        # service_api_actif -- en soit informée. Plutôt que relier un
        # signal fragile entre deux écrans qui peuvent vivre à des
        # moments différents, on recharge simplement la grille à chaque
        # retour sur cet onglet : rafraîchissement à coût négligeable
        # (une poignée de ComposantLayout par ServiceAPI), et corrige du
        # même coup toute autre désynchronisation possible (suppression
        # depuis un autre écran, etc.), pas seulement le renommage.
        self.onglets_editeur.currentChanged.connect(self._sur_changement_onglet_editeur)

        outer_layout.addWidget(self.onglets_editeur, 1)

    def _sur_changement_onglet_editeur(self, index: int):
        """Cf. commentaire [CORRECTIF] posé sur onglets_editeur.currentChanged
        plus haut -- recharge la grille ComposantLayout à chaque fois
        qu'elle redevient l'onglet actif, pour refléter tout changement
        fait depuis un autre écran (renommage via ComposantLayoutConfigScreen
        en particulier) pendant qu'elle n'était pas visible."""
        if self.onglets_editeur.widget(index) is self.composants_layout_tab and self._service_api_courant:
            self.composants_layout_tab.set_service_api_actif(self._service_api_courant)

    def _sur_nb_composants_change(self, n: int):
        """AJOUT (SPEC_lot_corrections_2026-09.md section 3, compteur
        cL/cS) : met à jour le libellé de l'onglet ComposantSingle au
        format "ComposantSingle (N)" -- même format que _sur_nb_
        composants_layout_change ci-dessous, décision explicite de la
        spec (cohérence de format entre les deux onglets)."""
        index = self.onglets_editeur.indexOf(self.composants_tab)
        if index != -1:
            self.onglets_editeur.setTabText(index, f"ComposantSingle ({n})")

    def _sur_nb_composants_layout_change(self, n: int):
        """AJOUT (section 3) : symétrique EXACT de _sur_nb_composants_
        change ci-dessus, pour l'onglet ComposantLayout."""
        index = self.onglets_editeur.indexOf(self.composants_layout_tab)
        if index != -1:
            self.onglets_editeur.setTabText(index, f"ComposantLayout ({n})")

    def sur_composant_layout_renomme(self, ancien_nom_complet: str, nouveau_nom_complet: str):
        """CORRECTIF (bug rapporté : "j'ai renommé un cL et ça n'apparaît
        même plus") -- relais pur vers composants_layout_tab (nom complet
        du ComposantLayout puisque le renommage ne touche que le nom
        COURT, cf. ComposantLayoutConfigScreen._sur_nom_composant_layout_
        change -- le préfixe service_api_nom- reste identique). Appelée
        par MainWindow (cf. sa connexion posée dans _ouvrir_config_layout),
        seule à connaître à la fois ApplicationsScreen et ServiceAPIScreen."""
        self.composants_layout_tab.sur_composant_layout_renomme(ancien_nom_complet, nouveau_nom_complet)

    def sur_composant_layout_modifie(self, composant_layout_nom: str):
        """CORRECTIF (retour utilisateur : badge de validation qui
        nécessitait de rouvrir la page des composants pour se
        rafraîchir) -- relais pur vers composants_layout_tab, MÊME
        patron EXACT que sur_composant_layout_renomme juste au-dessus.
        Appelée par MainWindow (cf. sa connexion posée dans _ouvrir_
        config_layout)."""
        self.composants_layout_tab.sur_composant_layout_modifie(composant_layout_nom)

    def definir_source_rendu_reseau(
        self,
        get_image: Optional[Callable[[], Optional[QImage]]],
        prendre_captures_selectionnees: Optional[Callable[[], list]] = None,
        consulter_captures_selectionnees: Optional[Callable[[], list]] = None,
        retirer_capture_selectionnee: Optional[Callable[[int], None]] = None,
    ):
        """Relais public vers ComposantsScreen.definir_source_rendu_reseau
        ET ComposantsLayoutScreen.definir_source_rendu_reseau (cf. leurs
        docstrings) -- ServiceAPIScreen ne fait ici QUE transmettre, même
        patron que demande_ouvrir_test_composant ci-dessus (relais pur,
        aucune logique propre). Appelée depuis MainWindow, qui est seule à
        connaître à la fois ServiceAPIScreen et TaskConfigScreen (cf. leur
        instanciation commune dans MainWindow._construire_ecrans ou
        équivalent). prendre_captures_selectionnees (PATCH -- mode
        sélection multiple) : relayé tel quel, cf. docstring côté
        ComposantsScreen.

        CORRECTIF (demande explicite utilisateur : "il faut faire a ce
        que on puisse ajouter ausi un composant layout apres la
        selection de region dimage dans panneaurendutaskreseau.
        actuelement sa fontionne uniquement avec les composantSingle") --
        ce relais ne visait auparavant QUE composants_tab ; le commentaire
        alors en place affirmait que ComposantsLayoutScreen ne consommait
        jamais de rendu réseau "aucune section de la SPEC ne le demande",
        ce qui était vrai à l'époque mais ne l'est plus : composants_
        layout_tab reçoit désormais le même relais, symétrique en tous
        points (mêmes deux callbacks, même bouton flottant, cf. sa
        docstring de classe).

        AJOUT (demande explicite utilisateur : choisir une capture déjà
        en attente pour mettre à jour l'image d'un composant existant ou
        lui ajouter une variante, plutôt que de refaire systématiquement
        une capture libre) -- consulter_captures_selectionnees et
        retirer_capture_selectionnee, relayés tel quel eux aussi, ne
        concernent QUE ComposantsScreen (mettre à jour l'image/ajouter
        une variante n'existent pas côté ComposantLayout) : transmis à
        composants_tab uniquement, composants_layout_tab garde son appel
        à deux arguments inchangé."""
        self.composants_tab.definir_source_rendu_reseau(
            get_image, prendre_captures_selectionnees,
            consulter_captures_selectionnees, retirer_capture_selectionnee,
        )
        self.composants_layout_tab.definir_source_rendu_reseau(get_image, prendre_captures_selectionnees)

    def _ouvrir_service_api(self, service_api_nom: str):
        service_api = self.project.find_service_api(service_api_nom)
        if service_api is None:
            return
        self._service_api_courant = service_api_nom

        self.nom_edit.blockSignals(True)
        self.nom_edit.setText(service_api.nom)
        self.nom_edit.blockSignals(False)

        self.composants_tab.set_service_api_actif(service_api_nom)
        self.composants_layout_tab.set_service_api_actif(service_api_nom)
        self.stack.setCurrentWidget(self.editeur_page)

    def _retour_grille(self):
        self._service_api_courant = None
        self.composants_tab.set_service_api_actif(None)
        self.composants_layout_tab.set_service_api_actif(None)
        self._reload_grille()
        self.stack.setCurrentWidget(self.grille_page)

    def _service_api_courant_obj(self) -> Optional[ServiceAPI]:
        if self._service_api_courant is None:
            return None
        return self.project.find_service_api(self._service_api_courant)

    # ------------------------------------------------------------------
    # Réglages ServiceAPI (nom, suppression)
    # ------------------------------------------------------------------
    def _on_nom_edited(self):
        service_api = self._service_api_courant_obj()
        if service_api is None:
            return
        ancien_nom = service_api.nom
        nouveau_nom = self.nom_edit.text().strip()
        if not nouveau_nom or nouveau_nom == ancien_nom:
            self.nom_edit.setText(ancien_nom)
            return

        # Bug corrigé (Phase B) : une simple affectation directe
        # (service_api.nom = nouveau_nom) ne renommait ni le dossier disque
        # components/<nom>/, ni les Composant.nom / service_api_nom /
        # variantes associés — désynchronisation silencieuse. On passe
        # maintenant par Project.rename_service_api, qui gère tout ça en
        # cascade (même logique déjà utilisée et éprouvée côté
        # ComposantsScreen avant la fusion).
        try:
            self.project.rename_service_api(ancien_nom, nouveau_nom)
        except ValueError as e:
            self.nom_edit.setText(ancien_nom)
            self._notify_status(str(e), error=True)
            return

        self.project.save()
        self._service_api_courant = nouveau_nom

        # La clé de _service_api_cartes est indexée par nom : on la
        # déplace vers le nouveau nom plutôt que de la chercher sous un nom
        # qui n'existe plus dans le dict.
        carte = self._service_api_cartes.pop(ancien_nom, None)
        if carte is not None:
            carte.rafraichir(service_api)
            self._service_api_cartes[nouveau_nom] = carte

        # Les noms de Composants ont changé en cascade (préfixe
        # NouveauNom-) : on recharge l'onglet Composants pour refléter les
        # nouveaux noms/chemins d'image plutôt que de laisser des tuiles
        # avec des références obsolètes.
        self.composants_tab.set_service_api_actif(nouveau_nom)

        self._notify_status(f"ServiceAPI « {ancien_nom} » renommé en « {nouveau_nom} ».")

    def _show_service_api_menu(self):
        menu = QMenu(self)
        delete_action = menu.addAction(qta.icon("mdi6.trash-can-outline", color=Mocha.red), "Supprimer le ServiceAPI")
        chosen = menu.exec(self.menu_api_features_button.mapToGlobal(self.menu_api_features_button.rect().bottomRight()))
        if chosen == delete_action:
            self._confirm_delete_service_api()

    def _confirm_delete_service_api(self):
        """PATCH (demande utilisateur explicite : corbeille) : plus de
        QMessageBox -- remove_service_api déplace désormais le
        ServiceAPI et ses Composants (images comprises) vers la
        corbeille au lieu de les supprimer pour de bon."""
        service_api = self._service_api_courant_obj()
        if service_api is None:
            return
        nom = service_api.nom
        self.project.remove_service_api(service_api.nom)
        self.project.save()
        self._retour_grille()
        self._notify_status(f"ServiceAPI « {nom} » supprimé.")

    # ------------------------------------------------------------------
    def _notify_status(self, message: str, error: bool = False):
        window = self.window()
        if hasattr(window, "statusBar"):
            window.statusBar().showMessage(message, 4000)


# ---------------------------------------------------------------------------
# TaskConfig (section sidebar, remplace le PlaceholderScreen "à venir") :
# scripts d'automatisation en pur Python (décision explicite utilisateur --
# pas de langage custom "autone", abandonné au profit de vrai code Python
# exécuté tel quel), manipulant des Composants importés via
# ComposantExecutable (cf. plus haut dans ce fichier).
#
# Un Task importe des ServiceAPI entiers (pas composant par composant,
# décision explicite utilisateur), et expose ses composants dans le
# panneau gauche de l'éditeur, GROUPÉS PAR ServiceAPI (jamais mélangés).
# Cliquer sur un composant dans ce panneau copie son nom dans le
# presse-papier (décision explicite utilisateur : "sa copie sont noms, sa
# vas faciliter la programmation") pour le coller directement dans le
# script, plutôt que de l'insérer automatiquement dans l'éditeur -- laisse
# l'utilisateur choisir où/quand le coller, cohérent avec un vrai éditeur
# de code où le curseur peut être n'importe où.
#
# Structure reprise de ServiceAPIScreen (grille de cards -> éditeur, même
# pattern de navigation, mêmes objectName CSS de toolbar/menu quand
# pertinent) pour rester visuellement cohérent avec le reste de l'app.
# ---------------------------------------------------------------------------

# Palette de coloration syntaxique Python : thème Darcula (couleurs
# officielles PyCharm/IntelliJ, cf. DarculaTheme plus haut) -- dédiée à cet
# éditeur uniquement (le reste de l'app garde Mocha).
class PythonHighlighter(QSyntaxHighlighter):
    """Coloration syntaxique Python pour l'éditeur de script Task : mots-clés,
    chaînes (simples/doubles/triples), commentaires, nombres, noms de méthode
    après un point (ex: .click()), et noms de COMPOSANTS IMPORTÉS reconnus
    (variables connues du Task courant, colorées distinctement -- cf.
    definir_composants_connus). Volontairement simple (regex par ligne, pas
    un vrai tokenizer Python) : suffisant pour un éditeur de script court,
    pas un IDE complet.

    BUGFIX (retour utilisateur : une variable assignée à '''...'''/\"\"\"...\"\"\"
    sur PLUSIEURS lignes -- ex: "Request3 = \"\"\"\\ntexte...\\n\"\"\"" -- n'était
    pas du tout reconnue comme une chaîne : highlightBlock() ci-dessous ne
    reçoit QUE le texte d'UNE ligne à la fois (c'est le fonctionnement normal
    de QSyntaxHighlighter, qui traite le document bloc par bloc), et
    l'ancienne implémentation n'avait AUCUN mécanisme pour se souvenir,
    d'une ligne à l'autre, qu'on se trouvait encore "à l'intérieur" d'une
    chaîne ouverte sur une ligne précédente -- chaque ligne était donc
    colorée en vase clos avec les règles normales (mots-clés, etc.),
    produisant exactement le résultat incohérent rapporté ("sa ne reconnais
    pas le teste de ces triple guillemet comme des comentaire").

    Correctif : setCurrentBlockState()/previousBlockState(), le mécanisme
    STANDARD de QSyntaxHighlighter conçu précisément pour ce cas (cf. doc
    Qt "Syntax Highlighter Example") -- chaque bloc (ligne) se voit assigner
    un entier d'état à la fin de highlightBlock (ici : quel délimiteur
    triple-guillemet reste ouvert, ou aucun), relu au bloc SUIVANT via
    previousBlockState() pour savoir si celui-ci commence déjà "dans" une
    chaîne. _ETAT_AUCUN/_ETAT_TRIPLE_SIMPLE/_ETAT_TRIPLE_DOUBLE distinguent
    '''...''' de \"\"\"...\"\"\" : nécessaire pour qu'un \"\"\" rencontré alors
    qu'on est dans un ''' ouvert (ou l'inverse) ne soit pas pris à tort
    pour la fermeture -- exactement comme le fait l'interpréteur Python
    lui-même, qui ne confond jamais les deux délimiteurs."""

    MOTS_CLES = (
        "False None True and as assert async await break class continue "
        "def del elif else except finally for from global if import in is "
        "lambda nonlocal not or pass raise return try while with yield"
    ).split()

    # États de bloc (cf. docstring de classe) -- 0 réservé par Qt à "aucun
    # état particulier" (valeur de previousBlockState() pour le tout premier
    # bloc du document, ou tout bloc jamais encore visité), donc _ETAT_AUCUN
    # est explicitement -1 pour ne jamais être confondu avec cette valeur
    # initiale par défaut.
    _ETAT_AUCUN = -1
    _ETAT_TRIPLE_SIMPLE = 1   # à l'intérieur d'un '''...''' encore ouvert
    _ETAT_TRIPLE_DOUBLE = 2   # à l'intérieur d'un """...""" encore ouvert

    def __init__(self, document: QTextDocument):
        super().__init__(document)
        self._regles = []

        def format_couleur(couleur_hex: str, gras: bool = False) -> QTextCharFormat:
            fmt = QTextCharFormat()
            fmt.setForeground(QColor(couleur_hex))
            if gras:
                fmt.setFontWeight(QFont.Bold)
            return fmt

        self._fmt_mot_cle = format_couleur(DarculaTheme.mot_cle, gras=True)
        for mot in self.MOTS_CLES:
            self._regles.append((re.compile(rf"\b{mot}\b"), self._fmt_mot_cle))

        # Méthode appelée après un point (ex: MonComposant.click) --
        # distingue visuellement les appels de méthode des noms de variable.
        self._regles.append(
            (re.compile(r"(?<=\.)\b[A-Za-z_][A-Za-z0-9_]*\b"), format_couleur(DarculaTheme.methode))
        )

        # PATCH (retour utilisateur : "actuellement cest les methode qui
        # sont colorer, pas les fonction -- actuellement les fonction nont
        # pas de coloration a eux") : appel de fonction "autonome" (SANS
        # point avant, ex: print(...), definir_composants_connus(...)) --
        # jusqu'ici seuls les appels de MÉTHODE (après un point, règle
        # ci-dessus, jaune) étaient distingués ; un simple identifiant
        # suivi de "(" restait dans la couleur de texte par défaut.
        # Couleur DÉDIÉE (DarculaTheme.fonction, bleu clair désaturé --
        # demande explicite : "pas trop loin de la palette, pas saturé,
        # bleu un peu plus clair que les chiffres"), distincte du jaune
        # des méthodes pour bien séparer les deux catégories. Lookahead
        # (?=\() plutôt que de consommer la parenthèse, pour qu'elle
        # garde sa propre couleur (texte par défaut, comme toute
        # ponctuation). Négatif lookbehind (?<!\.) pour ne jamais
        # re-matcher ce que la règle précédente (méthodes) vient de
        # colorer.
        self._regles.append(
            (re.compile(r"(?<!\.)\b[A-Za-z_][A-Za-z0-9_]*\b(?=\s*\()"), format_couleur(DarculaTheme.fonction))
        )

        # Nombres (entiers/flottants).
        self._regles.append((re.compile(r"\b\d+\.?\d*\b"), format_couleur(DarculaTheme.nombre)))

        # Chaînes simples (single-line, '...' ou "..."), traitées avant les
        # commentaires pour qu'un "#" à l'intérieur d'une chaîne ne soit pas
        # pris pour un commentaire.
        self._regle_chaine_simple = re.compile(r"'[^'\\]*(?:\\.[^'\\]*)*'|\"[^\"\\]*(?:\\.[^\"\\]*)*\"")
        self._fmt_chaine = format_couleur(DarculaTheme.chaine)

        # Délimiteurs triple-guillemet (cf. docstring de classe) -- repérés
        # AVANT les chaînes simples ci-dessus dans highlightBlock, sans quoi
        # _regle_chaine_simple pourrait mal interpréter deux des trois
        # guillemets d'un \"\"\" comme une chaîne vide "" suivie d'un
        # guillemet seul.
        self._regle_triple_simple = re.compile(r"'''")
        self._regle_triple_double = re.compile(r'"""')

        self._fmt_commentaire = format_couleur(DarculaTheme.commentaire)
        self._regle_commentaire = re.compile(r"#.*$")

        # Noms de composants importés connus (ex: MonComposant) -- mis à
        # jour dynamiquement via definir_composants_connus(), reconstruit à
        # chaque import/suppression de ServiceAPI dans le Task courant.
        self._fmt_composant = format_couleur(DarculaTheme.composant_connu, gras=True)
        self._regle_composants: Optional[re.Pattern] = None

        # Noms de ServiceAPI importés connus (ex: "Word" dans
        # Word.instance()) -- couleur distincte des composants, mise à
        # jour dynamiquement via definir_services_api_connus(), reconstruit
        # comme _regle_composants ci-dessus.
        self._fmt_service_api = format_couleur(DarculaTheme.service_api_connu, gras=True)
        self._regle_services_api: Optional[re.Pattern] = None

    def definir_composants_connus(self, noms_variables: list):
        """Reconstruit la regex des noms de composants connus (identifiants
        Python exacts, cf. nom_variable_python) et redéclenche une passe de
        coloration complète du document. Liste vide -> plus aucun composant
        mis en valeur distinctement (redevient un identifiant Python normal)."""
        if noms_variables:
            alternatives = "|".join(re.escape(n) for n in sorted(set(noms_variables), key=len, reverse=True))
            self._regle_composants = re.compile(rf"\b(?:{alternatives})\b")
        else:
            self._regle_composants = None
        self._rehighlight_si_utile()

    def definir_services_api_connus(self, noms_variables: list):
        """Reconstruit la regex des noms de ServiceAPI connus (identifiants
        Python exacts, cf. nom_variable_python -- ex: "Word" pour
        Word.instance()) et redéclenche une passe de coloration complète du
        document. Même principe que definir_composants_connus, mais couleur
        distincte (cf. DarculaTheme.service_api_connu) pour bien séparer
        visuellement les deux catégories de variables connues."""
        if noms_variables:
            alternatives = "|".join(re.escape(n) for n in sorted(set(noms_variables), key=len, reverse=True))
            self._regle_services_api = re.compile(rf"\b(?:{alternatives})\b")
        else:
            self._regle_services_api = None
        self._rehighlight_si_utile()

    def _rehighlight_si_utile(self):
        """PATCH8 : remplace rehighlight() dans les trois setters de noms
        connus. Les formats posés ne dépendent des noms connus QUE par les
        occurrences de ces noms dans le texte : si le jeu de regex n'a pas
        changé, ou si ni l'ancienne ni la nouvelle regex ne trouvent quoi que
        ce soit dans le document, une recoloration complète reproduirait
        exactement les formats actuels. Dans tous les autres cas (et au
        moindre doute : exception, document absent) on recolore comme avant."""
        def _motif(regle):
            return None if regle is None else regle.pattern

        anciennes = getattr(self, "_signature_noms_appliquee", None)
        if anciennes is None:
            anciennes = (None, None, None, None)   # (motif, regle) x 2, état initial : aucun nom
        motifs_anciens = (anciennes[0], anciennes[2])
        regles_anciennes = (anciennes[1], anciennes[3])
        motifs_nouveaux = (_motif(self._regle_composants), _motif(self._regle_services_api))
        regles_nouvelles = (self._regle_composants, self._regle_services_api)
        self._signature_noms_appliquee = (
            motifs_nouveaux[0], regles_nouvelles[0], motifs_nouveaux[1], regles_nouvelles[1],
        )
        if motifs_anciens == motifs_nouveaux:
            return
        try:
            document = self.document()
            if document is None:
                return
            texte = document.toPlainText()
            blocs = set()
            for i in (0, 1):
                if motifs_anciens[i] == motifs_nouveaux[i]:
                    continue
                for regle in (regles_anciennes[i], regles_nouvelles[i]):
                    if regle is None:
                        continue
                    for m in regle.finditer(texte):
                        blocs.add(document.findBlock(m.start()).blockNumber())
            if not blocs:
                return
            # PATCH9 : recoloration par blocs (état de bloc indépendant des noms)
            if len(blocs) * 4 > document.blockCount():
                self.rehighlight()
                return
            for numero in sorted(blocs):
                self.rehighlightBlock(document.findBlockByNumber(numero))
        except Exception:
            self.rehighlight()

    @staticmethod
    def _compiler_alternatives(noms) -> Optional[re.Pattern]:
        """Regex `\\b(?:a|b|c)\\b` pour un ensemble de noms (plus longs
        d'abord, pour qu'un nom ne soit jamais masqué par son préfixe), ou
        None si vide. Même construction EXACTE que definir_composants_connus
        / definir_services_api_connus ci-dessus."""
        if not noms:
            return None
        alternatives = "|".join(re.escape(n) for n in sorted(set(noms), key=len, reverse=True))
        return re.compile(rf"\b(?:{alternatives})\b")

    def definir_noms_connus_en_une_passe(self, noms_composants, noms_services_api):
        """AJOUT (optimisation de l'ouverture d'un Task) : pose les regex
        des composants ET des ServiceAPI puis ne déclenche qu'UN SEUL
        rehighlight(). Les deux setters existants (definir_composants_
        connus, definir_services_api_connus) relancent chacun une coloration
        COMPLÈTE du document -- appelés à la suite pour toutes les cellules
        d'un Task, ils recoloraient chaque cellule 2 à 3 fois de suite pour
        obtenir un résultat final strictement identique (mesuré : 150
        lignes recolorées pour un texte de 50 lignes). Les setters
        d'origine sont conservés tels quels pour les autres appelants."""
        self._regle_composants = self._compiler_alternatives(noms_composants)
        self._regle_services_api = self._compiler_alternatives(noms_services_api)
        self._rehighlight_si_utile()

    def _traiter_triples_guillemets(self, texte: str) -> list[tuple[int, int]]:
        """Repère et colore toutes les portions de CE bloc (ligne) qui
        appartiennent à une chaîne triple-guillemet ('''...''' ou
        \"\"\"...\"\"\"), qu'elle commence sur cette ligne, qu'elle continue
        depuis une ligne précédente (cf. previousBlockState()), et/ou
        qu'elle se poursuive au-delà de cette ligne (cf. setCurrentBlockState
        posé à la fin pour la ligne suivante). Retourne la liste des plages
        (debut, fin) couvertes, pour que highlightBlock() puisse ensuite
        appliquer les autres règles (mots-clés, nombres...) uniquement EN
        DEHORS de ces plages -- une chaîne ne doit jamais se faire re-colorer
        par-dessus comme du code normal.

        Algorithme : un seul passage gauche->droite sur la ligne, en
        alternant explicitement entre deux modes -- "dans_chaine" (on
        cherche le délimiteur COURANT, ''' ou \"\"\", pour fermer, en
        ignorant l'autre -- cf. docstring de classe) et "hors_chaine" (on
        cherche le prochain délimiteur d'ouverture, le premier rencontré
        parmi les deux). Le mode ET le délimiteur courant sont toujours
        mis à jour ENSEMBLE à chaque transition, jamais l'un sans l'autre
        -- c'est cette règle qui manquait dans une première version et
        provoquait un crash (position redevenant un entier valide alors
        que le délimiteur associé retombait à None)."""
        plages: list[tuple[int, int]] = []
        position = 0
        etat_precedent = self.previousBlockState()
        if etat_precedent == self._ETAT_TRIPLE_SIMPLE:
            dans_chaine, delimiteur, regle = True, "'''", self._regle_triple_simple
        elif etat_precedent == self._ETAT_TRIPLE_DOUBLE:
            dans_chaine, delimiteur, regle = True, '"""', self._regle_triple_double
        else:
            dans_chaine, delimiteur, regle = False, None, None

        while True:
            if dans_chaine:
                # Dans une chaîne déjà ouverte (depuis le début de ligne si
                # on arrive avec un état hérité, ou depuis une ouverture
                # trouvée juste en dessous) : cherche SEULEMENT ce
                # délimiteur précis pour la fermeture, jamais l'autre.
                m_fermeture = regle.search(texte, position)
                if m_fermeture is None:
                    plages.append((position, len(texte)))
                    self.setCurrentBlockState(
                        self._ETAT_TRIPLE_SIMPLE if delimiteur == "'''" else self._ETAT_TRIPLE_DOUBLE
                    )
                    return plages
                plages.append((position, m_fermeture.end()))
                position = m_fermeture.end()
                dans_chaine, delimiteur, regle = False, None, None
            else:
                # Hors chaîne : cherche le PREMIER délimiteur d'ouverture
                # rencontré à partir d'ici, quel qu'il soit (''' ou \"\"\") --
                # celui qui apparaît en premier dans le texte restant
                # l'emporte, exactement comme le ferait l'interpréteur Python.
                m_simple = self._regle_triple_simple.search(texte, position)
                m_double = self._regle_triple_double.search(texte, position)
                if m_simple is None and m_double is None:
                    self.setCurrentBlockState(self._ETAT_AUCUN)
                    return plages
                if m_double is None or (m_simple is not None and m_simple.start() < m_double.start()):
                    debut_ouverture, delimiteur, regle = m_simple.start(), "'''", self._regle_triple_simple
                else:
                    debut_ouverture, delimiteur, regle = m_double.start(), '"""', self._regle_triple_double
                # Cherche la fermeture APRÈS l'ouverture (donc jamais les
                # 3 mêmes guillemets qui viennent d'ouvrir).
                m_fermeture = regle.search(texte, debut_ouverture + 3)
                if m_fermeture is None:
                    plages.append((debut_ouverture, len(texte)))
                    self.setCurrentBlockState(
                        self._ETAT_TRIPLE_SIMPLE if delimiteur == "'''" else self._ETAT_TRIPLE_DOUBLE
                    )
                    return plages
                plages.append((debut_ouverture, m_fermeture.end()))
                position = m_fermeture.end()
                dans_chaine, delimiteur, regle = False, None, None

    def highlightBlock(self, texte: str):
        # Chaînes triple-guillemet EN PREMIER (cf. docstring de
        # _traiter_triples_guillemets) : posent aussi le nouvel état de bloc
        # pour la ligne suivante, donc doivent tourner à chaque appel, même
        # si le résultat est une liste de plages vide.
        plages_triples = self._traiter_triples_guillemets(texte)
        for debut, fin in plages_triples:
            self.setFormat(debut, fin - debut, self._fmt_chaine)
        if not texte:
            return   # PATCH8 : ligne vide, rien à colorier (l'état de bloc est déjà posé)

        def hors_chaine_triple(debut: int, fin: int) -> bool:
            """True si [debut, fin) ne chevauche AUCUNE plage de chaîne
            triple-guillemet déjà colorée ci-dessus -- les autres règles
            (mots-clés, nombres, chaînes simples, commentaires...) ne
            doivent jamais repeindre par-dessus une chaîne triple, sous
            peine de faire réapparaître un mot-clé ou un "#" en couleur
            normale à l'intérieur d'un texte censé rester entièrement
            coloré comme une chaîne."""
            if not plages_triples:   # PATCH8 : chemin rapide, cas de loin le plus fréquent
                return True
            return all(fin <= p_debut or debut >= p_fin for p_debut, p_fin in plages_triples)

        for regle, fmt in self._regles:
            for m in regle.finditer(texte):
                if hors_chaine_triple(m.start(), m.end()):
                    self.setFormat(m.start(), m.end() - m.start(), fmt)
        # Chaînes simples par-dessus (priorité sur mots-clés/nombres si un
        # mot-clé apparaît à l'intérieur d'une chaîne, ex: "return" en texte
        # litéral) -- toujours exclues des plages triple-guillemet, sinon un
        # \"\" isolé à l'intérieur d'un \"\"\"...\"\"\" pourrait être
        # (re)coloré comme une chaîne simple vide par-dessus la chaîne
        # triple déjà correcte.
        plages_simples: list[tuple[int, int]] = []
        for m in self._regle_chaine_simple.finditer(texte):
            if hors_chaine_triple(m.start(), m.end()):
                self.setFormat(m.start(), m.end() - m.start(), self._fmt_chaine)
                plages_simples.append((m.start(), m.end()))

        # BUGFIX (retour utilisateur : "si je copi le noms dun composant et
        # que je colle dans une chaine de caractere et bien sa vas garder
        # sa coloration particulier et pourtant sa doit devenir une chaine
        # de caractere aussi") : hors_chaine_triple ne couvrait QUE les
        # triple-guillemets, jamais les chaînes simples ('...'/"...")
        # collectées juste au-dessus -- les règles suivantes (composants
        # connus, ServiceAPI connus) tournent APRÈS les chaînes simples
        # (nécessaire pour leur propre priorité d'affichage, cf. commentaires
        # ci-dessous) et repeignaient donc par-dessus un nom de composant/
        # ServiceAPI même s'il se trouvait À L'INTÉRIEUR d'une chaîne simple
        # déjà correctement colorée juste avant -- exactement le bug
        # rapporté. hors_chaine (nouvelle fonction) exclut les DEUX
        # ensembles de plages (triples ET simples) ; hors_chaine_triple
        # reste utilisée telle quelle plus haut (elle n'a pas encore besoin
        # d'exclure les chaînes simples, qui ne sont posées qu'ici).
        def hors_chaine(debut: int, fin: int) -> bool:
            return hors_chaine_triple(debut, fin) and (not plages_simples or all(
                fin <= p_debut or debut >= p_fin for p_debut, p_fin in plages_simples
            ))

        # Composants connus par-dessus les méthodes/identifiants génériques
        # (priorité la plus haute avant commentaires) -- ex: dans
        # "MonComposant.click()", "MonComposant" doit rester coloré comme
        # composant même si la regle générique de méthode ne le touche pas
        # (elle ne cible que ce qui suit un point). Jamais à l'intérieur
        # d'une chaîne (triple OU simple, cf. hors_chaine ci-dessus) : un
        # nom de composant collé dans une chaîne de caractères doit rester
        # coloré comme une chaîne, pas comme un composant.
        if self._regle_composants is not None:
            for m in self._regle_composants.finditer(texte):
                if hors_chaine(m.start(), m.end()):
                    self.setFormat(m.start(), m.end() - m.start(), self._fmt_composant)
        # ServiceAPI connus (ex: "Word" dans Word.instance()) -- même
        # priorité que les composants ci-dessus, appliqué juste après pour
        # ne jamais être écrasé par eux (les deux ensembles de noms sont de
        # toute façon disjoints : un ServiceAPI et ses composants n'ont
        # jamais le même nom_variable_python, cf. préfixe "NomService-").
        # Même correctif que les composants ci-dessus : jamais à l'intérieur
        # d'une chaîne, simple ou triple.
        if self._regle_services_api is not None:
            for m in self._regle_services_api.finditer(texte):
                if hors_chaine(m.start(), m.end()):
                    self.setFormat(m.start(), m.end() - m.start(), self._fmt_service_api)
        # Commentaires en dernier : priorité absolue sur tout le reste de la
        # ligne après le "#" (sauf s'il est dans une chaîne -- limite connue
        # de cette implémentation simple par regex, acceptable pour un
        # éditeur de script court). Un "#" à l'intérieur d'une chaîne triple
        # (ex: une URL commentée dans une docstring) ne doit jamais déclencher
        # de commentaire -- cf. hors_chaine_triple.
        m = self._regle_commentaire.search(texte)
        if m and hors_chaine_triple(m.start(), len(texte)):
            self.setFormat(m.start(), len(texte) - m.start(), self._fmt_commentaire)



_CACHE_PIXMAP_TUILES: dict = {}


class ComposantImportTuile(QFrame):
    """Vignette cliquable d'un Composant dans le panneau gauche de l'éditeur
    de Task (liste des composants importés, groupés par ServiceAPI).
    Affiche le VISUEL du composant (image capturée, même pattern que
    ComposantMiniTuile) -- décision explicite utilisateur : "sa doit être
    le visuel et non le nom qui s'affiche". Un clic copie le nom du
    composant dans le presse-papier (inchangé), pour le coller directement
    dans le script -- le tooltip au survol affiche le nom en clair, pour
    rester identifiable sans avoir à cliquer d'abord."""

    clique = Signal(str)  # nom du composant
    demande_ouvrir_coordonnee_action = Signal(str)  # nom du composant -- clic droit -> "Ouvrir Coordonnée action"

    def __init__(self, composant: Composant, parent=None):
        super().__init__(parent)
        self.composant_nom = composant.nom
        self.setObjectName("ComposantImportTuile")
        self.setCursor(Qt.PointingHandCursor)
        self.setToolTip(f"Cliquer pour copier « {composant.nom} » -- clic droit pour définir sa coordonnée d'action")

        layout = QVBoxLayout(self)
        layout.setContentsMargins(8, 8, 8, 8)
        layout.setSpacing(4)

        image_frame = QFrame(self)
        image_frame.setObjectName("ComposantTuileImageFrame")
        image_frame.setFixedSize(96, 68)
        image_layout = QVBoxLayout(image_frame)
        image_layout.setContentsMargins(0, 0, 0, 0)

        self.image_label = QLabel(image_frame)
        self.image_label.setAlignment(Qt.AlignCenter)
        image_absolue = get_app_data_dir() / composant.image_path
        try:
            _mtime = image_absolue.stat().st_mtime
        except OSError:
            _mtime = None
        if _mtime is not None:
            # PATCH : cache (chemin, mtime) -> pixmap 96x68, évite relecture
            # disque + redimensionnement lissé à chaque réouverture.
            _cle = (str(image_absolue), _mtime)
            pixmap = _CACHE_PIXMAP_TUILES.get(_cle)
            if pixmap is None:
                pixmap = QPixmap(str(image_absolue))
                if not pixmap.isNull():
                    pixmap = pixmap.scaled(96, 68, Qt.KeepAspectRatio, Qt.SmoothTransformation)
                    if len(_CACHE_PIXMAP_TUILES) > 500:
                        _CACHE_PIXMAP_TUILES.clear()
                    _CACHE_PIXMAP_TUILES[_cle] = pixmap
            if pixmap is not None and not pixmap.isNull():
                self.image_label.setPixmap(pixmap)
        image_layout.addWidget(self.image_label)
        layout.addWidget(image_frame, alignment=Qt.AlignCenter)

        copie_icon = QLabel(self)
        copie_icon.setPixmap(qta.icon("mdi6.content-copy", color=Mocha.overlay1).pixmap(12, 12))
        copie_icon.setAlignment(Qt.AlignCenter)
        layout.addWidget(copie_icon)

    def mousePressEvent(self, event):
        if event.button() == Qt.LeftButton:
            self.clique.emit(self.composant_nom)
        super().mousePressEvent(event)

    def contextMenuEvent(self, event):
        """Clic droit -> ouvre CoordonneeActionScreen fixé sur ce composant
        (cf. docstring de CoordonneeActionScreen : "ouvert directement sur
        un Composant précis depuis un clic droit sur sa tuile")."""
        menu = QMenu(self)
        action = menu.addAction(
            qta.icon("mdi6.cursor-default-click-outline", color=Mocha.lavender), "Ouvrir Coordonnée action"
        )
        chosen = menu.exec(event.globalPos())
        if chosen == action:
            self.demande_ouvrir_coordonnee_action.emit(self.composant_nom)


# NOTE : une première version de la navigation entre ServiceAPI utilisait
# un QTabWidget avec une QTabBar custom (TabBarHorizontale, empilant les
# onglets en colonne) en setTabPosition(West). Abandonnée après retour
# utilisateur explicite -- West place le contenu de l'onglet à DROITE de la
# barre, alors que la demande était "le contenu doit être toujours
# directement en bas [...] pas à droite ni à gauche, en bas". Remplacée par
# PanneauComposantsImportesTask._construire_barre_onglets ci-dessous : une
# colonne de QToolButton checkables (QButtonGroup, exclusif) dans un
# QScrollArea de hauteur plafonnée (3 onglets visibles, scroll silencieux
# au-delà -- cf. docstring de cette méthode), pilotant un QStackedWidget
# affiché juste en dessous.


class EnteteServiceAPITask(QWidget):
    """En-tête cliquable d'un groupe ServiceAPI dans le panneau de gauche
    de l'éditeur de Task (cf. PanneauComposantsImportesTask). Affiche le
    nom du ServiceAPI et, en dessous, son statut de liaison à une instance
    ("lié à auto-1" en vert, ou "non lié — cliquer pour choisir" en jaune
    si instance_id == "", cf. état transitoire de Task.services_api_importes).
    Cliquable dans les deux cas -- permet de choisir une instance après
    coup (pas seulement au moment de l'import), ou d'en changer.

    Un bouton "retirer" (icône poubelle) permet aussi de désimporter
    entièrement ce ServiceAPI de ce Task (cf. demande_retrait_service_api
    -- jusqu'ici cette fonctionnalité manquait : un ServiceAPI importé par
    erreur ne pouvait plus être retiré du Task une fois l'import fait).

    PATCH (navigation rapide entre groupes, panneau gauche du TaskEditor) :
    sous le nom/statut, une rangée de petits liens -- un par groupe de
    composants de ce ServiceAPI ("Général" en premier, puis
    ServiceAPI.groupes dans l'ordre, même liste que GroupesNavPanel côté
    onglet Composants) -- cliquable pour faire défiler le panneau jusqu'à
    la portion de la liste correspondant à ce groupe (cf.
    PanneauComposantsImportesTask._scroller_vers_groupe). N'apparaît que
    si ce ServiceAPI a au moins un groupe créé (service_api.groupes non
    vide) : pas la peine d'encombrer l'en-tête d'un unique lien "Général"
    quand il n'y a jamais eu de groupe créé pour ce ServiceAPI."""

    clique = Signal(str)  # nom du ServiceAPI
    nom_copie = Signal(str)  # nom de variable Python copié (pour feedback UI, cf. mousePressEvent)
    demande_retrait = Signal(str)  # nom du ServiceAPI -- clic sur le bouton poubelle
    groupe_choisi = Signal(str, str)  # (nom_service, nom_groupe) -- clic sur un lien de groupe

    def __init__(self, nom_service: str, instance_id: str, noms_groupes: Optional[list] = None, parent=None, libelle: Optional[str] = None, mode_reseau: bool = False):
        super().__init__(parent)
        self.nom_service = nom_service
        # SPEC_profils_environnements.md section 3.3 : en mode réseau, la
        # liaison ne vient plus jamais d'un clic sur cet en-tête -- elle
        # vient exclusivement de la sélection de ligne dans la liste de
        # profils (TaskConfigScreen._sur_demande_definir_profil_actif).
        # `mode_reseau` désactive donc l'affordance cliquable ici pour ne
        # pas laisser une UI qui suggère une action qui n'existe plus ;
        # le mode local (hors-scope de cette spec, section 8) garde son
        # comportement actuel inchangé (clic = choisir/changer l'instance).
        self._mode_reseau = mode_reseau
        if mode_reseau:
            self.setCursor(Qt.ArrowCursor)
            self.setToolTip("")
        else:
            self.setCursor(Qt.PointingHandCursor)
            self.setToolTip("Cliquer pour choisir/changer l'instance liée")
        # PATCH (mode réseau) : instance_id sert toujours de test de vérité
        # ("lié" vs "non lié", cf. plus bas) -- il reste l'ID technique
        # (id_executant en mode réseau, volatile d'une session Kaggle à
        # l'autre). `libelle`, lui, est le TEXTE affiché à l'utilisateur ;
        # en mode réseau, PanneauComposantsImportesTask._libelle_liaison
        # y résout le nom du profil (ex. "camoufox_claude", stable) quand
        # il est connu, sinon retombe sur le nom du sAutoniax. Par défaut
        # (libelle=None, cf. tout appelant hors mode réseau), on retombe
        # simplement sur instance_id -- comportement inchangé.
        if libelle is None:
            libelle = instance_id

        layout = QVBoxLayout(self)
        layout.setContentsMargins(0, 0, 0, 0)
        layout.setSpacing(4)

        ligne_principale = QHBoxLayout()
        ligne_principale.setContentsMargins(0, 0, 0, 0)
        ligne_principale.setSpacing(4)

        textes = QWidget(self)
        textes_layout = QVBoxLayout(textes)
        textes_layout.setContentsMargins(0, 0, 0, 0)
        textes_layout.setSpacing(2)

        nom_label = QLabel(nom_service, textes)
        nom_label.setObjectName("ServiceAPICarteNom")
        # PATCH (demande explicite utilisateur : "je veux que lorsque on
        # clic sur le nom du service api ça copie directement le nom a
        # utiliser dans le code" -- le nom affiché, ex. "yt-view", n'est
        # pas forcément l'identifiant Python valide utilisé dans les
        # cellules du Task, ex. "yt_view", cf. nom_variable_python) :
        # cliquer précisément sur ce label copie nom_variable_python(nom_
        # service) dans le presse-papier, plutôt que d'ouvrir le sélecteur
        # d'instance comme le reste de l'en-tête -- même exclusion de zone
        # cliquable que retrait_button/_boutons_groupe (cf. mousePressEvent
        # plus bas), pour ne jamais ouvrir les deux actions à la fois sur
        # un même clic.
        nom_label.setCursor(Qt.PointingHandCursor)
        nom_label.setToolTip("Cliquer pour copier le nom à utiliser dans le code")
        textes_layout.addWidget(nom_label)
        self._nom_label = nom_label

        if instance_id:
            statut_label = QLabel(f"lié à « {libelle} »", textes)
            statut_label.setStyleSheet(f"color: {DarculaTheme.vert};")
        else:
            if mode_reseau:
                statut_label = QLabel("non lié — sélectionnez un profil dans la liste", textes)
            else:
                statut_label = QLabel("non lié — cliquer pour choisir une instance", textes)
            statut_label.setStyleSheet(f"color: {Mocha.yellow};")
        statut_label.setObjectName("PlaceholderSubtitle")
        # BUGFIX (retour utilisateur : "le bouton de supression [...] ne
        # saffiche que quand il est lie a une instance") -- ce label n'avait
        # PAS setWordWrap(True). Le texte "non lié — cliquer pour choisir
        # une instance" (~43 caractères) est près de 3x plus long que
        # "lié à « xxx »" : sans retour à la ligne autorisé, ce QLabel
        # réclame une largeur MINIMALE suffisante pour tenir tout son texte
        # sur une seule ligne, ce qui pousse retrait_button hors de la
        # largeur réellement disponible du panneau (PanneauComposantsImportesTask
        # a une largeur FIXE de 260px, cf. self.setFixedWidth(260)) -- le
        # bouton reste bien créé et fonctionnel, seulement rendu invisible
        # par manque de place, exactement quand le statut est "non lié" (le
        # texte court "lié à « xxx »" ne posait jamais ce problème). Avec
        # setWordWrap(True), le label passe sur 2 lignes au lieu d'élargir
        # le widget, et retrait_button retrouve sa place garantie par
        # setMinimumSize ci-dessous.
        statut_label.setWordWrap(True)
        textes_layout.addWidget(statut_label)

        ligne_principale.addWidget(textes, 1)

        self.retrait_button = QToolButton(self)
        self.retrait_button.setObjectName("APIFeaturesMenuButton")
        self.retrait_button.setIcon(qta.icon("mdi6.trash-can-outline", color=Mocha.subtext0))
        self.retrait_button.setIconSize(QSize(16, 16))
        self.retrait_button.setCursor(Qt.PointingHandCursor)
        self.retrait_button.setToolTip(f"Retirer « {nom_service} » de ce Task")
        # BUGFIX (complément setWordWrap ci-dessus) : taille minimale
        # explicite pour que le layout ne puisse JAMAIS écraser ce bouton
        # à 0px de large, quelle que soit la longueur du texte de statut à
        # côté -- ceinture et bretelles, le setWordWrap seul suffit déjà en
        # pratique mais cette garantie protège aussi contre un panneau
        # redimensionné plus étroit que 260px.
        self.retrait_button.setMinimumSize(28, 28)
        self.retrait_button.setSizePolicy(QSizePolicy.Fixed, QSizePolicy.Fixed)
        # Cf. mousePressEvent ci-dessous : ce bouton vit DANS le widget
        # cliquable (dont le clic émet `clique`) -- setCursor seul ne
        # suffit pas à empêcher la propagation, donc le clic sur ce
        # bouton précis est explicitement absorbé par la vérification
        # childAt() plutôt que de laisser les deux signaux s'émettre à
        # la fois pour un même clic (cf. mousePressEvent).
        self.retrait_button.clicked.connect(lambda: self.demande_retrait.emit(self.nom_service))
        ligne_principale.addWidget(self.retrait_button, 0, Qt.AlignTop)

        layout.addLayout(ligne_principale)

        # PATCH (navigation rapide entre groupes) : rangée de liens, un par
        # groupe -- cf. docstring de classe. Widgets mémorisés dans
        # self._boutons_groupe pour que mousePressEvent puisse les exclure
        # du clic "choisir une instance", même logique que retrait_button.
        self._boutons_groupe: list = []
        if noms_groupes:
            groupes_row = QWidget(self)
            groupes_layout = QHBoxLayout(groupes_row)
            groupes_layout.setContentsMargins(0, 0, 0, 0)
            groupes_layout.setSpacing(4)
            for nom_groupe, libelle in noms_groupes:
                bouton = QToolButton(groupes_row)
                bouton.setObjectName("EnteteServiceAPITaskGroupeLien")
                bouton.setText(libelle)
                bouton.setCursor(Qt.PointingHandCursor)
                bouton.setToolTip(f"Aller au groupe « {libelle} »")
                bouton.clicked.connect(
                    lambda checked=False, n=nom_groupe: self.groupe_choisi.emit(self.nom_service, n)
                )
                groupes_layout.addWidget(bouton)
                self._boutons_groupe.append(bouton)
            groupes_layout.addStretch(1)
            layout.addWidget(groupes_row)

    def mousePressEvent(self, event):
        if event.button() == Qt.LeftButton:
            # Le bouton retrait, les liens de groupe et le label de nom ont
            # chacun leur propre zone cliquable à l'intérieur de ce widget
            # -- ne pas émettre `clique` (choix d'instance) quand c'est
            # L'UN D'EUX qui a été visé, sous peine d'ouvrir le menu de
            # sélection d'instance EN PLUS de l'action réellement demandée.
            widget_sous_le_curseur = self.childAt(event.position().toPoint())
            if widget_sous_le_curseur is self.retrait_button or widget_sous_le_curseur in self._boutons_groupe:
                super().mousePressEvent(event)
                return
            if widget_sous_le_curseur is self._nom_label:
                # PATCH (cf. docstring de self._nom_label ci-dessus) :
                # copie le nom de variable Python réellement utilisable
                # dans le code, jamais le libellé affiché tel quel.
                nom_variable = nom_variable_python(self.nom_service)
                QGuiApplication.clipboard().setText(nom_variable)
                self.nom_copie.emit(nom_variable)
                super().mousePressEvent(event)
                return
            if not self._mode_reseau:
                self.clique.emit(self.nom_service)
        super().mousePressEvent(event)


class PoigneeSplitterBasculable(QSplitterHandle):
    """PATCH20 : poignee du splitter composants/notebook. Double-clic = replier /
    reafficher le panneau de gauche ; petit chevron dessine quand il est replie."""

    def mouseDoubleClickEvent(self, e):
        sp = self.splitter()
        if hasattr(sp, "basculer_panneau_gauche"):
            sp.basculer_panneau_gauche()
        e.accept()

    def paintEvent(self, e):
        super().paintEvent(e)
        sp = self.splitter()
        try:
            replie = sp.sizes()[0] == 0
        except Exception:
            replie = False
        if replie:
            p = QPainter(self)
            p.setRenderHint(QPainter.RenderHint.Antialiasing)
            p.setPen(Qt.PenStyle.NoPen)
            p.setBrush(QColor(Mocha.mauve))
            cx, cy = self.width() / 2.0, self.height() / 2.0
            p.drawPolygon([QPointF(cx - 2, cy - 6), QPointF(cx + 3, cy), QPointF(cx - 2, cy + 6)])
            p.end()


class SplitterComposantsNotebook(QSplitter):
    """PATCH20 : QSplitter horizontal [panneau composants | notebook+clone]."""

    def createHandle(self):
        h = PoigneeSplitterBasculable(self.orientation(), self)
        h.setToolTip("Glisser pour redimensionner - double-clic : replier / afficher les composants importes")
        h.setCursor(Qt.CursorShape.SplitHCursor)
        return h

    def basculer_panneau_gauche(self):
        try:
            s = self.sizes()
            total = max(1, sum(s))
            panneau = self.widget(0)
            if s[0] == 0:
                # CORRECTIF : si le panneau est replié par son chevron, sa
                # largeur max est bloquée à LARGEUR_REPLIEE -- on le
                # "déplie" via le bouton pour lever ce blocage, sinon
                # setSizes ci-dessous resterait plafonné à la bande étroite.
                bouton = getattr(panneau, "bouton_replier", None)
                if bouton is not None and bouton.isChecked():
                    bouton.setChecked(False)
                l = int(getattr(panneau, "_largeur_memorisee", 260))
                self.setSizes([l, max(1, total - l)])
            else:
                self.setSizes([0, total])
            for i in range(self.count() - 1):
                self.handle(i + 1).update()
        except Exception:
            pass


class PanneauComposantsImportesTask(QWidget):
    """Panneau gauche de l'éditeur de Task : liste des composants importés
    dans ce Task, GROUPÉE PAR ServiceAPI (décision explicite utilisateur :
    "tu délimite bien lors de leur affichage, ne mélange pas les
    composants"), même si plusieurs ServiceAPI différents sont importés
    dans un même Task. Cliquer sur un composant copie son nom dans le
    presse-papier (decision explicite utilisateur)."""

    demande_import_service_api = Signal()  # bouton "+" cliqué
    composant_copie = Signal(str)  # nom du composant copié (pour feedback UI)
    demande_liaison_instance = Signal(str)  # nom du ServiceAPI dont on veut choisir/changer l'instance liée
    demande_ouvrir_coordonnee_action = Signal(str)  # nom du composant -- relais depuis ComposantImportTuile (clic droit)
    demande_retrait_service_api = Signal(str)  # nom du ServiceAPI -- bouton poubelle de son en-tête

    # Largeur du panneau déployé (comportement historique, inchangé) vs
    # replié -- AJOUT (demande explicite utilisateur : "le panneau de
    # gauche... sa occupe trop lespace de lediteur... un petit bouton en
    # haut qui plie et deplie") : repliée, seule une bande étroite reste
    # visible (juste le bouton chevron, cf. _basculer_replie) -- assez
    # large pour rester cliquable confortablement, mais bien plus étroite
    # que les 260px habituels, pour rendre à l'éditeur de cellules l'espace
    # que ce panneau lui prenait.
    LARGEUR_DEPLOYEE = 260
    LARGEUR_REPLIEE = 26   # PATCH (réduction de l'espace panneau gauche replié / notebook) : 44 -> 26
    LARGEUR_MIN_SPLITTER = 200   # PATCH20 : en dessous, le splitter replie tout
    LARGEUR_MAX_SPLITTER = 700   # PATCH20

    # Nombre d'onglets (ServiceAPI) visibles simultanément dans la barre
    # avant qu'elle ne devienne scrollable -- décision explicite
    # utilisateur : "3 noms de service dépasser sa devient scroll, pas
    # plus". Au-delà, la barre garde une hauteur fixe de HAUTEUR_ONGLET *
    # MAX_ONGLETS_VISIBLES et le surplus défile (molette/drag), plutôt que
    # de continuer à grandir et empiéter sur la zone de contenu en dessous.
    MAX_ONGLETS_VISIBLES = 3
    HAUTEUR_ONGLET = 32

    def __init__(self, project: Project, parent=None):
        super().__init__(parent)
        self.project = project
        self.setObjectName("PanneauComposantsImportesTask")
        # PATCH20 : largeur variable (splitter), plus de largeur fixe
        self._largeur_memorisee = self.LARGEUR_DEPLOYEE
        self.setMinimumWidth(self.LARGEUR_MIN_SPLITTER)
        self.setMaximumWidth(self.LARGEUR_MAX_SPLITTER)
        # (nom_service, nom_groupe) -> widget de sous-section, reconstruit
        # à chaque rafraichir() -- cf. _scroller_vers_groupe. nom_service ->
        # QScrollArea du contenu de cet onglet (dans self.stack), pour que
        # cette même méthode puisse cibler le bon scroll (un par
        # ServiceAPI). nom_service -> QToolButton de la barre d'onglets,
        # pour pouvoir le cocher par programmation (cf. _activer_service).
        # Référence forte vers l'animation de scroll en cours, pour pouvoir
        # l'arrêter proprement si l'utilisateur re-clique sur un lien de
        # groupe avant la fin d'un scroll précédent (même pattern que
        # ComposantsScreen._scroll_animation).
        self._sections_par_groupe: dict = {}
        self._scrolls_par_service: dict = {}
        self._boutons_par_service: dict = {}
        self._scroll_animation: Optional[QPropertyAnimation] = None
        # PATCH (retour utilisateur explicite, capture d'écran annotée :
        # "ici je veux sa dit instance et non le sautoniax id, donc sa
        # devait etre pluot lie a camoufox_claude") -- mode "reseau" UNIQUEMENT :
        # le libellé de statut de EnteteServiceAPITask affiche le NOM du
