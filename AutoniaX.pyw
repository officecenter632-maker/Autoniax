# Capture d'écran (Patch 4) — type "outil de capture" (Snipping Tool)
# ---------------------------------------------------------------------------
def capture_bureau_complet() -> Optional[QImage]:
    """Capture l'ensemble du bureau (tous les moniteurs, en une seule image
    couvrant leur zone combinée), via l'API Qt native — aucune dépendance
    Win32 nécessaire ici. Utilisé uniquement pour la capture manuelle d'un
    composant de référence (point 2) : contrairement au ciblage d'une Feature
    à l'exécution (point 8/11, qui vise un hwnd précis pour fonctionner même
    en arrière-plan), la capture d'un composant se fait sur ce qui est
    visuellement affiché à l'écran, peu importe la fenêtre concernée.
    Retourne None si aucun écran n'est détecté."""
    virtual_geometry = None
    images_par_ecran = []
    for screen in QGuiApplication.screens():
        pixmap = screen.grabWindow(0)
        geometry = screen.geometry()
        images_par_ecran.append((geometry, pixmap))
        virtual_geometry = geometry if virtual_geometry is None else virtual_geometry.united(geometry)

    if virtual_geometry is None or not images_par_ecran:
        return None

    composite = QImage(virtual_geometry.size(), QImage.Format_RGB32)
    composite.fill(Qt.black)
    painter = QPainter(composite)
    for geometry, pixmap in images_par_ecran:
        painter.drawPixmap(geometry.topLeft() - virtual_geometry.topLeft(), pixmap)
    painter.end()
    return composite


