    /^_r_[0-9a-z]+_$/i,               // React 19+ useId()
    /^:r[0-9a-z]+:$/i,                // React 18 useId()
    /^radix-[-_:a-z0-9]+$/i,          // Radix UI
    /^headlessui-[-_:a-z0-9]+$/i,     // Headless UI
    /^mui-[0-9]+$/i,                  // MUI useId()
    /^(?:mat|cdk)-[a-z-]*[0-9]+$/i    // Angular Material / Angular CDK
