  .doc-methode p {
    margin: 6px 0 0;
    font-size: 13px;
    line-height: 1.55;
    color: var(--encre-douce);
  }
</style>
</head>
<body>
  <div class="fond-degrade"></div>
  <div class="conteneur">
    <div class="marque"><span class="point"></span>Instance prête</div>
    <h1>Bienvenue sur <em>AutoniaX</em></h1>
    <p class="sous-titre">
      Cette instance est connectée et attend une commande. Ouvrez un onglet,
      liez un composant, ou lancez un Task depuis le tableau de bord —
      cette page reviendra automatiquement à chaque réinitialisation.
    </p>
    <div class="grille-fonctions">
      <div class="carte">
        <div class="icone">&#9673;</div>
        <h3>Reconnaissance visuelle</h3>
        <p>Détection de composants par template matching et validation croisée, indépendante du DOM.</p>
      </div>
      <div class="carte">
        <div class="icone">&#9998;</div>
        <h3>Tasks scriptables</h3>
        <p>Chaque Task est un notebook Python : composants, instances et services s'y pilotent directement.</p>
      </div>
      <div class="carte">
        <div class="icone">&#8635;</div>
        <h3>Instances pilotables</h3>
        <p>Liaison, aperçu en direct et contrôle à distance de chaque profil navigateur, onglet par onglet.</p>
      </div>
    </div>
    <div class="pied">
      <span class="etat"><span class="puce-vivante"></span>En attente</span>
      <span>&middot;</span>
      <span class="id-instance">__INSTANCE_ID__</span>
      <span>&middot;</span>
      <button type="button" class="lien-doc" onclick="autoniaxOuvrirDoc()">Documentation rapide</button>
      <span>&middot;</span>
      <a href="__URL_FICHIER_PAGE_TEST__" target="_blank" rel="noopener" class="lien-doc">Page de test</a>
      <span>&middot;</span>
      <a href="https://duckduckgo.com" class="lien-doc">Tester une recherche (DuckDuckGo)</a>
    </div>
  </div>

  <div id="doc-fond" class="doc-fond">
    <div class="doc-panneau doc-panneau-libre">
      <button type="button" class="doc-fermer" onclick="autoniaxFermerDoc()">&times;</button>
      <div class="doc-contenu-libre">__DOC_RAPIDE_HTML__</div>
    </div>
  </div>

  <script>
    function autoniaxOuvrirDoc() {
      document.getElementById("doc-fond").classList.add("ouvert");
    }
    function autoniaxFermerDoc() {
      document.getElementById("doc-fond").classList.remove("ouvert");
    }
    document.addEventListener("keydown", function (e) {
      if (e.key === "Escape") autoniaxFermerDoc();
    });
    document.addEventListener("click", function (e) {
      if (e.target && e.target.id === "doc-fond") autoniaxFermerDoc();
    });

    // PATCH (demande utilisateur) : la page de test n'est plus ouverte par
    // window.open()/document.write() en JS -- cf. historique complet dans
    // contenu_page_accueil (docstring Python). Le bouton "Page de test" est
    // désormais un vrai lien <a href="file://..."> (cf. pied de page
    // ci-dessus) : le HTML est écrit sur disque par _ecrire_page_test_disque
    // avant même l'affichage de cette welcome page, et le clic déclenche une
    // navigation NATIVE (pas de window.open ni de data: URL), donc totalement
    // hors du champ de la restriction Chrome qui posait problème.
  </script>

</body>
</html>
"""


# PATCH (demande utilisateur) : page de test d'outils -- couvre TOUTES les
# méthodes des listes METHODES_COMPOSANT_EXECUTABLE/METHODES_INSTANCE_
# EXECUTABLE/METHODES_SERVICE_API_EXECUTABLE ci-dessous (Composants,
# Instances, Services API, Fonctions utiles -- anciennement aussi
# documentées en HTML par _generer_html_doc_rapide(), supprimée, cf.
# SPEC_GLOBALE_AutoniaX.md Partie B ; ces listes restent utilisées telles
# quelles pour l'auto-complétion de l'éditeur de script Task, usage
# indépendant de cette spec), avec un élément HTML RÉEL et
# CIBLABLE pour chacune (pas de simulation en JS pur : ces méthodes pilotent
# l'instance via CDP -- souris/clavier réels au niveau OS pour click/saisir/
# scroll/etc., DOM.setFileInputFiles pour drag/drop -- donc seuls de vrais
# éléments natifs (input, textarea, div scrollable, input[type=file]...)
# donnent un test représentatif du comportement réel en usage). Même
# mécanisme d'injection que la welcome page (data: URL, cf.
# _data_url_page_test_outils plus bas) -- même thème visuel (creme/
# terracotta) pour rester cohérent, mais template SÉPARÉ (pas de fusion
# avec WELCOME_PAGE_HTML_TEMPLATE : ce sont deux pages distinctes, ouvertes
# dans des onglets distincts, cf. bouton "Page de test" dans le pied de la
# welcome page).
#
# Chaque bloc de test suit le même schéma : un titre (nom de la méthode +
# signature), l'élément HTML ciblable lui-même, et une zone de statut
# "en direct" DÉDIÉE à ce bloc (cf. demande utilisateur : statut par
# élément, pas un journal global unique) mise à jour par un listener JS
# natif (input/change/click/scroll/mouseenter selon le cas) -- jamais par
# une simulation, toujours par un événement DOM réel déclenché par l'action
# pilotée.
def contenu_page_test_outils(instance_id: str = "") -> str:
    """Rend PAGE_TEST_OUTILS_HTML_TEMPLATE en mémoire (aucune écriture
    disque, même approche que contenu_page_accueil) et retourne le HTML
    final. __INSTANCE_ID__ substitué pour cohérence visuelle avec la
    welcome page (purement informatif, affiché en pied de page).
    __BLOCS_TEST_HTML__ substitué par _generer_blocs_test_outils()
    (un bloc par méthode documentée, cf. cette fonction) et
    __SCRIPT_TEST_OUTILS__ par SCRIPT_TEST_OUTILS_JS (listeners DOM
    natifs correspondants)."""
    html_final = PAGE_TEST_OUTILS_HTML_TEMPLATE.replace("__INSTANCE_ID__", instance_id or "—")
    html_final = html_final.replace("__BLOCS_TEST_HTML__", _generer_blocs_test_outils())
    html_final = html_final.replace("__SCRIPT_TEST_OUTILS__", SCRIPT_TEST_OUTILS_JS)
    return html_final


def _nom_fichier_page_test(instance_id: str = "") -> str:
    """Nom de fichier fixe et prévisible pour la page de test d'une
    instance donnée -- pas d'aléatoire (pas de NamedTemporaryFile) car on
    VEUT réécrire le même fichier à chaque régénération de la welcome
    page plutôt que d'accumuler des fichiers orphelins dans le dossier
    temporaire à chaque redémarrage/reset. instance_id est déjà un
    identifiant sûr (cf. usages existants en pied de page) ; à défaut on
    retombe sur "defaut" plutôt que de planter sur instance_id vide."""
    id_sur = "".join(c if (c.isalnum() or c in "-_") else "_" for c in (instance_id or "defaut"))
    return f"page_test_{id_sur}.html"


def _chemin_fichier_page_test(instance_id: str = "") -> Path:
    """Chemin complet du fichier HTML de la page de test pour cette
    instance, dans DOSSIER_TMP_PAGE_TEST. Ne garantit PAS que le fichier
    existe déjà -- cf. _ecrire_page_test_disque pour l'écriture."""
    return DOSSIER_TMP_PAGE_TEST / _nom_fichier_page_test(instance_id)


def _ecrire_page_test_disque(instance_id: str = "") -> Path:
    """Écrit le HTML complet de la page de test sur disque, dans un
    répertoire temporaire dédié (DOSSIER_TMP_PAGE_TEST), et retourne le
    Path final. Appelée depuis contenu_page_accueil() à CHAQUE génération
    de la welcome page (démarrage d'instance + resetInterface) -- donc le
    fichier est toujours à jour avec le HTML courant avant même que le
    bouton ne soit cliquable, pas de génération paresseuse au clic (le
    clic reste un simple <a href="file://..."> natif, aucun aller-retour
    JS->Python possible depuis la page pilotée).

    PATCH (demande utilisateur) : remplace l'ancienne data: URL
    (_data_url_page_test_outils, conservée ci-dessous pour compat/repli
    éventuel mais plus utilisée par le template) -- écrire sur disque et
    ouvrir un vrai file:// évite complètement la restriction Chrome sur
    les navigations JS vers data: (cf. contenu_page_accueil), sans les
    complications de document.write()/same-origin/échappement </script>
    que cette solution intermédiaire imposait."""
    DOSSIER_TMP_PAGE_TEST.mkdir(parents=True, exist_ok=True)
    chemin = _chemin_fichier_page_test(instance_id)
    html_complet = contenu_page_test_outils(instance_id)
    chemin.write_text(html_complet, encoding="utf-8")
    return chemin


def _data_url_page_test_outils(instance_id: str = "") -> str:
    """OBSOLÈTE -- conservée uniquement pour référence/repli manuel
    éventuel. Construit la data: URL de la page de test, même mécanisme
    que _data_url_page_accueil. N'est plus utilisée par
    contenu_page_accueil depuis le passage au fichier disque
    (_ecrire_page_test_disque) : cette approche data: URL est
    précisément celle qui posait le problème de navigation JS bloquée
    par Chrome, documenté en détail plus haut."""
    html_complet = contenu_page_test_outils(instance_id)
    return "data:text/html;charset=utf-8," + urllib.parse.quote(html_complet)


def _generer_blocs_test_outils() -> str:
    """Construit le HTML de TOUS les blocs de test (un par méthode des
    listes METHODES_COMPOSANT_EXECUTABLE, METHODES_INSTANCE_EXECUTABLE,
    METHODES_SERVICE_API_EXECUTABLE, + extraire_texte_fichier et
    ecrire_texte_fichier -- mêmes listes qu'utilisées anciennement par
    _generer_html_doc_rapide(), supprimée, cf. SPEC_GLOBALE_AutoniaX.md
    Partie B) --
    remplace le placeholder __BLOCS_TEST_HTML__ de
    PAGE_TEST_OUTILS_HTML_TEMPLATE.

    Chaque méthode de composant (click/visible/saisir/etc.) pilote un
    point (x, y) réel de la page via CDP -- donc chaque bloc fournit un
    VRAI élément HTML ciblable, pas une simulation. id_prefixe distingue
    les statuts (ex: "st-click", "st-saisir") pour que le script en bas
    de page puisse les mettre à jour indépendamment (cf. demande
    utilisateur : statut PAR élément, pas un journal global)."""

    def bloc(id_prefixe: str, signature: str, description: str, corps_html: str) -> str:
        return f"""
      <div class="bloc-test">
        <div class="bloc-entete">
          <div><code>{html.escape(signature)}</code><p>{html.escape(description)}</p></div>
        </div>
        {corps_html}
        <div class="statut" id="st-{id_prefixe}"><span class="attente">en attente…</span></div>
      </div>"""

    blocs_composants = (
        '<h2 class="section-titre">Composants -- MonComposant.méthode()</h2>'
        + bloc(
            "click", "click(zone=None, bouton='gauche', duree_appui_ms=60, nb_clics=1, retry=None, timeout=None, latence_avant=None, latence_apres=None, copier_presse_papier=False, timeout_copie=None)",
            "Clic simulé sur ce composant -- cible le bouton ci-dessous.",
            '<button type="button" class="btn-test" id="cible-click">Cliquez-moi (ou ciblez-moi depuis un Task)</button>',
        )
        + bloc(
            "visible", "visible(timeout=None, freq=None, click=False)",
            "Détecte si le composant est présent à l'écran -- ce bloc est toujours visible ; masquez/affichez-le pour tester la détection.",
            '<div class="zone-cible" id="cible-visible"><span style="font-size:13px;">Élément détectable ici.</span></div>',
        )
        + bloc(
            "saisir", "saisir(texte, zone=None, delai_min_ms=60, delai_max_ms=180, retry=None, timeout=None, latence_avant=None, latence_apres=None)",
            "Saisit du texte caractère par caractère -- ciblez le champ ci-dessous.",
            '<input type="text" class="champ-test" id="cible-saisir" placeholder="Le texte saisi apparaît ici">',
        )
        + bloc(
            "mousemove", "mousemove(zone=None, retry=None, timeout=None, latence_avant=None, latence_apres=None)",
            "Déplace le curseur RÉEL (sans clic) -- survolez la zone ci-dessous pour voir le point suivre.",
            '<div class="curseur-zone" id="cible-mousemove"><div class="curseur-point" id="point-mousemove"></div></div>',
        )
        + bloc(
            "scroll", "scroll(zone=None, depart=None, arrivee=None, delta_x=0.0, delta_y=0.0, retry=None, timeout=None, latence_avant=None, latence_apres=None)",
            "Défilement simulé sur ce composant -- ciblez la zone ci-dessous, qui contient plus de lignes que sa hauteur visible.",
            '<div class="scroll-zone" id="cible-scroll">Ligne 1<br>Ligne 2<br>Ligne 3<br>Ligne 4<br>Ligne 5<br>Ligne 6<br>Ligne 7<br>Ligne 8<br>Ligne 9<br>Ligne 10</div>',
        )
        + bloc(
            "clear", "clear(zone=None, retry=None, timeout=None, latence_avant=None, latence_apres=None)",
            "Sélectionne tout (Ctrl+A) puis efface (Delete) -- pré-rempli, ciblez pour effacer.",
            '<input type="text" class="champ-test" id="cible-clear" value="Contenu pré-rempli à effacer">',
        )
        + bloc(
            "paste", "paste(texte=None, zone=None, retry=None, timeout=None, latence_avant=None, latence_apres=None)",
            "Colle du texte (fourni, ou le dernier copy() de l'instance) -- ciblez le champ ci-dessous.",
            '<input type="text" class="champ-test" id="cible-paste" placeholder="Le texte collé apparaît ici">',
        )
        + bloc(
            "move_cursor", "move_cursor(zone=None, retry=None, timeout=None, latence_avant=None, latence_apres=None)",
            "Déplace le curseur VIRTUEL seulement (pas de vrai mouvement souris OS) -- même zone que mousemove, mais sans mouvement réel détectable par mouseenter : le statut se met à jour via move_cursor si l'action est appelée explicitement côté script (repérage visuel identique à mousemove, mécanisme de test différent).",
            '<div class="curseur-zone" id="cible-move-cursor"><div class="curseur-point" id="point-move-cursor"></div></div>',
        )
        + bloc(
            "drag", "drag(chemin_fichier, zone=None, retry=None, timeout=None, latence_avant=None, latence_apres=None)",
            "Dépose un fichier local sur ce composant -- vrai <input type=\"file\"> ci-dessous (drag/drop réel = DOM.setFileInputFiles côté serveur).",
            '<div class="drop-zone" id="cible-drag">Déposez un fichier ici (ou ciblez cette zone avec drag() depuis un Task)<input type="file" id="input-drag"></div>',
        )
        + bloc(
            "drop", "drop(chemin_fichier, zone=None, retry=None, timeout=None, latence_avant=None, latence_apres=None)",
            "Alias de drag() -- second <input type=\"file\"> séparé pour tester drop() indépendamment de drag().",
            '<div class="drop-zone" id="cible-drop">Déposez un fichier ici (ou ciblez cette zone avec drop() depuis un Task)<input type="file" id="input-drop"></div>',
        )
    )

    blocs_instances = (
        '<h2 class="section-titre">Instances -- NomServiceAPI.instance().méthode()</h2>'
        + bloc(
            "capture", "capture()",
            "Capture propre de l'instance, écrite en PNG sur disque -- aucun élément à cibler ici : appelez mon_instance.capture() depuis un Task et vérifiez le fichier PNG produit (chemin retourné par la méthode).",
            '<div class="zone-cible"><span style="font-size:13px;">Rien à cibler sur la page -- capture() photographie toute l\'instance.</span></div>',
        )
        + bloc(
            "get_presse_papier", "get_presse_papier()",
            "Lit le texte actuellement dans le presse-papier du navigateur -- copiez (Ctrl+C) le texte ci-dessous, puis appelez get_presse_papier() depuis un Task.",
            '<input type="text" class="champ-test" id="cible-clipboard" value="Copiez-moi avec Ctrl+C, puis lisez-moi via get_presse_papier()">',
        )
        + bloc(
            "new_tab", "new_tab(url)",
            "Ouvre un nouvel onglet et navigue vers url -- appelez mon_instance.new_tab(\"https://exemple.com\") depuis un Task ; un nouvel onglet doit apparaître dans le navigateur piloté.",
            '<div class="zone-cible"><span style="font-size:13px;">Rien à cibler sur cette page -- vérifiez visuellement l\'apparition du nouvel onglet.</span></div>',
        )
        + bloc(
            "naviguer", "naviguer(url)",
            "Navigue vers url SUR CET ONGLET, sans en ouvrir un nouveau, et attend la fin du chargement -- appelez mon_instance.naviguer(\"https://exemple.com\") depuis un Task ; CET onglet de test doit être remplacé par la nouvelle page, vérifiez r.statut pour confirmer le succès du chargement.",
            '<div class="zone-cible"><span style="font-size:13px;">⚠ naviguer() remplacera cette page de test par l\'url cible -- c\'est le comportement attendu.</span></div>',
        )
        + bloc(
            "switch_tab", "switch_tab(tab_id)",
            "Bascule l'onglet actif de cette instance -- ouvrez d'abord un onglet avec new_tab(), notez le tab_id retourné, puis appelez switch_tab(tab_id) pour revenir ici et vérifier le changement visuel d'onglet actif.",
            '<div class="zone-cible"><span style="font-size:13px;">Vérifiez visuellement que cet onglet redevient actif après switch_tab().</span></div>',
        )
        + bloc(
            "tab_accueil", "tab_accueil()",
            "Retrouve le tab_id de la welcome page -- appelez mon_instance.tab_accueil() depuis un Task, puis mon_instance.switch_tab(ce tab_id) pour vérifier qu'il ramène bien sur la welcome page (pas sur cette page de test).",
            '<div class="zone-cible"><span style="font-size:13px;">tab_accueil() cible la welcome page, pas cette page -- vérifiez le retour sur l\'onglet d\'accueil.</span></div>',
        )
        + bloc(
            "list_tabs", "list_tabs()",
            "Liste tous les onglets actuellement ouverts de cette instance (id, titre, url, actif) -- ouvrez un ou plusieurs onglets avec new_tab(), appelez mon_instance.list_tabs() depuis un Task et vérifiez que cette page de test apparaît bien dans la liste retournée.",
            '<div class="zone-cible"><span style="font-size:13px;">Rien à cibler visuellement -- list_tabs() ne fait que lire l\'état des onglets, vérifiez la liste de dict retournée.</span></div>',
        )
        + bloc(
            "reset_interface", "reset_interface()",
            "Referme tous les onglets et ré-affiche la welcome page -- ATTENTION : appeler ceci fermera cette page de test elle-même (comportement normal, à vérifier).",
            '<div class="zone-cible"><span style="font-size:13px;">⚠ reset_interface() fermera cet onglet de test -- c\'est le comportement attendu.</span></div>',
        )
        + bloc(
            "est_interface_initialisee", "est_interface_initialisee()",
            "Indique si un seul onglet (welcome page) est ouvert -- doit retourner False tant que cette page de test est ouverte en plus de la welcome page.",
            '<div class="zone-cible"><span style="font-size:13px;">Doit retourner False tant que cet onglet de test reste ouvert.</span></div>',
        )
        + bloc(
            "position_aleatoire", "position_aleatoire(rayon_cm, timeout=None)",
            "Tire un point (x, y) sur un cercle de rayon rayon_cm (en centimètres) autour de la position actuelle du curseur virtuel, ou du centre de l'écran si le curseur n'a jamais bougé -- appelez mon_instance.position_aleatoire(2) depuis un Task et vérifiez que le point retourné reste dans les dimensions de l'écran.",
            '<div class="zone-cible"><span style="font-size:13px;">Rien à cibler sur cette page -- position_aleatoire() ne fait que calculer un point, vérifiez le tuple (x, y) retourné.</span></div>',
        )
        + bloc(
            "mouse_move", "mouse_move(x, y, retry=None, timeout=None, latence_avant=None, latence_apres=None, speed_percent=0)",
            "Déplace le curseur RÉEL de sa position actuelle vers un point (x, y) donné directement -- contrairement à mousemove() sur un Composant, aucune zone/détection visuelle : appelez mon_instance.mouse_move(x, y) avec des coordonnées de votre choix (ex: celles retournées par position_aleatoire()) et observez le curseur se déplacer.",
            '<div class="curseur-zone" id="cible-mouse-move"><div class="curseur-point" id="point-mouse-move"></div></div>',
        )
        + bloc(
            "centrer_curseur", "centrer_curseur(retry=None, timeout=None, latence_avant=None, latence_apres=None, speed_percent=0)",
            "Déplace le curseur RÉEL vers le centre de l'écran de cette instance (largeur/2, hauteur/2) -- même mécanisme que mouse_move(), sans avoir à calculer le point soi-même : appelez mon_instance.centrer_curseur() depuis un Task et observez le curseur rejoindre le centre de cette page.",
            '<div class="zone-cible"><span style="font-size:13px;">Rien à cibler précisément -- centrer_curseur() vise toujours le centre de la page, quelle que soit sa taille.</span></div>',
        )
    )

    blocs_services = (
        '<h2 class="section-titre">Services API -- NomServiceAPI.méthode()</h2>'
        + bloc(
            "instance", "instance()",
            "Retourne l'InstanceExecutable liée à ce ServiceAPI dans ce Task -- aucun élément à cibler ici : vérifiez côté script que NomServiceAPI.instance() ne lève pas d'erreur et retourne bien un objet InstanceExecutable.",
            '<div class="zone-cible"><span style="font-size:13px;">Rien à cibler -- test purement côté script (absence d\'exception).</span></div>',
        )
    )

    blocs_fonctions = (
        '<h2 class="section-titre">Fonctions utiles -- sans import</h2>'
        + bloc(
            "extraire-texte-fichier", "extraire_texte_fichier(chemin)",
            "Lit un fichier .txt/.md/.html/.htm et renvoie son texte -- aucun élément à cibler ici : appelez extraire_texte_fichier(chemin) depuis un Task sur un fichier local et vérifiez le texte retourné.",
            '<div class="zone-cible"><span style="font-size:13px;">Rien à cibler -- test purement côté script (contenu du texte retourné).</span></div>',
        )
        + bloc(
            "ecrire-texte-fichier", "ecrire_texte_fichier(chemin, texte)",
            "Écrit du texte dans un fichier, en le créant s'il n'existe pas -- aucun élément à cibler ici : appelez ecrire_texte_fichier(chemin, texte) depuis un Task et vérifiez le fichier obtenu sur disque.",
            '<div class="zone-cible"><span style="font-size:13px;">Rien à cibler -- test purement côté script (fichier écrit sur disque).</span></div>',
        )
    )

    return blocs_composants + blocs_instances + blocs_services + blocs_fonctions


# Script JS de la page de test -- écoute des événements DOM NATIFS
# uniquement (click, input, change, mouseenter/mousemove, scroll, focus/
# keyup, paste) : jamais de simulation, chaque listener reflète l'action
# RÉELLEMENT produite côté navigateur par la commande pilotée
# correspondante (cf. action_click/action_type_text/action_drag/etc. plus
# haut dans ce fichier -- toutes passent par CDP, donc déclenchent les
# mêmes événements DOM qu'une interaction utilisateur véritable).
SCRIPT_TEST_OUTILS_JS = r"""
function majStatut(id, texte, ok) {
  var el = document.getElementById("st-" + id);
  if (!el) return;
  el.textContent = texte;
  el.classList.toggle("ok", !!ok);
}
function horodatage() {
  var d = new Date();
  function pad(n) { return String(n).padStart(2, "0"); }
  return pad(d.getHours()) + ":" + pad(d.getMinutes()) + ":" + pad(d.getSeconds());
}

// --- click ---------------------------------------------------------
document.getElementById("cible-click").addEventListener("click", function () {
  majStatut("click", "Clic détecté à " + horodatage(), true);
});

// --- visible ---------------------------------------------------------
// visible() est une détection côté serveur (template matching), pas un
// événement JS déclenché par l'action elle-même -- ce bloc reste donc
// statique (rien à écouter), le statut sert juste de repère visuel fixe.
majStatut("visible", "Élément présent dans le DOM depuis le chargement de la page (rien à écouter ici -- visible() est une détection visuelle côté serveur).", true);

// --- saisir ---------------------------------------------------------
document.getElementById("cible-saisir").addEventListener("input", function (e) {
  majStatut("saisir", "Texte actuel : \"" + e.target.value + "\" (" + horodatage() + ")", e.target.value.length > 0);
});

// --- mousemove (curseur RÉEL) ---------------------------------------
(function () {
  var zone = document.getElementById("cible-mousemove");
  var point = document.getElementById("point-mousemove");
  zone.addEventListener("mousemove", function (e) {
    var r = zone.getBoundingClientRect();
    point.style.left = (e.clientX - r.left - 5) + "px";
    point.style.top = (e.clientY - r.top - 5) + "px";
    majStatut("mousemove", "Curseur réel détecté à (" + Math.round(e.clientX - r.left) + ", " + Math.round(e.clientY - r.top) + ") -- " + horodatage(), true);
  });
})();

// --- mouse_move (InstanceExecutable, curseur RÉEL vers x,y absolus) -
(function () {
  var zone = document.getElementById("cible-mouse-move");
  var point = document.getElementById("point-mouse-move");
  zone.addEventListener("mousemove", function (e) {
    var r = zone.getBoundingClientRect();
    point.style.left = (e.clientX - r.left - 5) + "px";
    point.style.top = (e.clientY - r.top - 5) + "px";
    majStatut("mouse_move", "Curseur réel détecté à (" + Math.round(e.clientX) + ", " + Math.round(e.clientY) + ") côté page -- " + horodatage(), true);
  });
})();

// --- scroll ---------------------------------------------------------
document.getElementById("cible-scroll").addEventListener("scroll", function (e) {
  majStatut("scroll", "Défilement détecté, position verticale : " + Math.round(e.target.scrollTop) + "px (" + horodatage() + ")", true);
});

// --- clear ---------------------------------------------------------
document.getElementById("cible-clear").addEventListener("input", function (e) {
  if (e.target.value === "") {
    majStatut("clear", "Champ vidé avec succès (" + horodatage() + ")", true);
  } else {
    majStatut("clear", "Contenu actuel : \"" + e.target.value + "\" -- pas encore vide (" + horodatage() + ")", false);
  }
});

// --- paste ---------------------------------------------------------
document.getElementById("cible-paste").addEventListener("input", function (e) {
  majStatut("paste", "Contenu collé : \"" + e.target.value + "\" (" + horodatage() + ")", e.target.value.length > 0);
});
document.getElementById("cible-paste").addEventListener("paste", function () {
  majStatut("paste", "Événement paste natif détecté (" + horodatage() + ")", true);
});

// --- move_cursor (curseur VIRTUEL) -----------------------------------
// move_cursor() ne génère PAS de vrai mousemove OS (curseur virtuel
// seulement, cf. doc) -- rien à écouter côté DOM natif pour cette
// méthode précise : le repère visuel (point) existe pour que
// l'utilisateur positionne la zone, mais le statut reste informatif,
// pas déclenché par un événement (aucun événement natif ne distingue
// move_cursor() de mousemove() côté navigateur).
majStatut("move_cursor", "move_cursor() déplace un curseur virtuel (aucun événement DOM natif ne le distingue de mousemove côté navigateur) -- vérifiez le repère visuel affiché par l'app AutoniaX elle-même.", true);

// --- drag / drop (input file réel) -----------------------------------
function ecouterInputFichier(idInput, idStatut) {
  document.getElementById(idInput).addEventListener("change", function (e) {
    var fichiers = Array.prototype.slice.call(e.target.files).map(function (f) { return f.name; });
    majStatut(idStatut, fichiers.length
      ? "Fichier(s) reçu(s) : " + fichiers.join(", ") + " (" + horodatage() + ")"
      : "Aucun fichier (" + horodatage() + ")", fichiers.length > 0);
  });
}
ecouterInputFichier("input-drag", "drag");
ecouterInputFichier("input-drop", "drop");

// --- get_presse_papier ------------------------------------------------
// Rien à écouter ici : get_presse_papier() LIT le presse-papier système,
// ne déclenche aucun événement sur la page -- le champ sert seulement de
// texte source à copier manuellement (Ctrl+C) avant l'appel côté script.
document.getElementById("cible-clipboard").addEventListener("copy", function () {
  majStatut("get_presse_papier", "Ctrl+C détecté sur ce champ -- appelez maintenant get_presse_papier() depuis un Task (" + horodatage() + ")", true);
});
"""


