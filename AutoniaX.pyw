@dataclass
class ZoneClicRect:
    """Rectangle de la zone de clic personnalisée, en coordonnées de l'image
    du composant (donc indépendant de sa position réelle à l'écran)."""
    x: int = 0
    y: int = 0
    largeur: int = 0
    hauteur: int = 0

    def to_dict(self) -> dict:
        return asdict(self)

    @staticmethod
    def from_dict(d: dict) -> "ZoneClicRect":
        return ZoneClicRect(**d)

    def est_vide(self) -> bool:
        return self.largeur <= 0 or self.hauteur <= 0


@dataclass
class ZoneClicRectFraction:
    """AJOUT (zone de clic personnalisée pour les zones DYNAMIQUES d'un
    ComposantLayout, cf. docstring de ComposantLayout.zones_dynamiques_
    clic) -- contrairement à ZoneClicRect (pixels absolus, utilisé pour
    les Zone STATIQUES et pour ComposantSingle/Action), ce rectangle est
    exprimé en FRACTIONS (0.0-1.0) de la zone dynamique elle-même, exactement
    comme Zone.rect est une fraction du ComposantLayout entier.

    Nécessaire car une zone dynamique n'a pas de taille fixe : son
    rectangle est recalculé à CHAQUE exécution du filtre (cf.
    ComposantLayoutConfigScreen._appliquer_filtre, self._dernieres_zones_
    filtre) et peut légèrement bouger d'une capture à l'autre. Stocker en
    pixels absolus (comme pour une Zone statique) serait faux dès que la
    zone dynamique se déplace ne serait-ce que d'un pixel ; la fraction,
    elle, reste valide tant que la zone de clic personnalisée occupe
    toujours la même portion RELATIVE de la zone dynamique (ex: "le quart
    supérieur gauche du bouton 'input'", peu importe où 'input' atterrit
    exactement à la prochaine détection)."""
    x: float = 0.0
    y: float = 0.0
    largeur: float = 0.0
    hauteur: float = 0.0

    def to_dict(self) -> dict:
        return asdict(self)

    @staticmethod
    def from_dict(d: dict) -> "ZoneClicRectFraction":
        return ZoneClicRectFraction(**d)

    def est_vide(self) -> bool:
        return self.largeur <= 0 or self.hauteur <= 0


