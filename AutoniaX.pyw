    client_t.tester_proxy_sautoniax_demande.connect(_sur_tester_proxy_sautoniax_demande, Qt.DirectConnection)

    def _sur_creer_profil_sautoniax_demande(nom_profil: str, type_instance: str, proxy_texte: str, id_pilote: str, contraintes: dict):
        # PATCH (bouton "+" du panneau de propriétés de l'onglet
        # "Instances sAutoniax" -- demande explicite utilisateur : "je
        # veux que desormais on puisse creer un profils"). Simple
        # enveloppe autour de _sautoniax_creer_profil (cf. sa docstring
        # pour le détail complet : dossier sous sautoniax_profils/<nom> +
        # enregistrer_config_profil, PAS de démarrage automatique) pour
        # répondre à TOUS les pilotes connectés via envoyer_creer_profil_
        # sautoniax_resultat (DIFFUSÉ, contrairement au test de proxy
        # ci-dessus -- même raisonnement que _sur_demarrer_profil_isole_
        # demande : ce nouveau profil doit apparaître à jour dans le
        # panneau de n'importe quel pilote ayant ce sAutoniax
        # sélectionné, pas seulement celui qui l'a créé). `id_pilote` non
        # utilisé ici (le résultat est diffusé, pas relayé au seul
        # demandeur) -- conservé dans la signature du signal pour
        # symétrie avec les autres *_demande de ce fichier, qui le
        # reçoivent tous, même quand ils ne l'utilisent pas.
        #
        # `contraintes` (AJOUT, spec A.4) : relayée tel quel jusqu'à
        # enregistrer_config_profil (cf. _sautoniax_creer_profil) --
        # n'a d'effet qu'au tout premier lancement Camoufox de ce
        # profil (cf. _camoufox_construire_config_lancement).
        def _programmer():
            async def _executer():
                ok, message = await _sautoniax_creer_profil(loop, nom_profil, type_instance, proxy_texte, contraintes)
                client_t.envoyer_creer_profil_sautoniax_resultat(nom_profil, ok, message)
            tache = loop.create_task(_executer())
            _taches_projets_en_cours.add(tache)
            tache.add_done_callback(_taches_projets_en_cours.discard)
        loop.call_soon_threadsafe(_programmer)

    client_t.creer_profil_sautoniax_demande.connect(_sur_creer_profil_sautoniax_demande, Qt.DirectConnection)

    def _profil_est_actif_sur_ce_sautoniax(nom_profil: str) -> bool:
        """Factorisé de _sur_profils_sautoniax_demande ci-dessus : même
        fusion EXACTE des quatre registres d'instances actives possibles
        (ProjetBatch E.7, profils isolés, mode legacy, Notebook Distant)
        -- source de vérité unique pour "ce profil est-il actif ?",
        réutilisée ici par _sur_supprimer_profil_demande pour ne jamais
        supprimer le dossier d'un profil actuellement en cours d'usage
        (même raisonnement que _sur_kill_profil_demande, mais avec la
        détection COMPLÈTE des quatre registres plutôt que les trois
        vérifiés par kill_profil)."""
        moteur = _moteur_batch_courant.get("moteur")
        instances_actives_batch = (
            dict(moteur._instances_par_profil)
            if moteur is not None and hasattr(moteur, "_instances_par_profil") else {}
        )
        profil_notebook_distant_charge = namespace_notebook_distant.get("profil_charge")
        instances_notebook_distant = (
            {profil_notebook_distant_charge: instance_id} if profil_notebook_distant_charge else {}
        )
        registres_fusionnes = {
            **instances_actives_batch, **_instances_isolees,
            **_instances_legacy_par_profil, **instances_notebook_distant,
        }
        return bool(registres_fusionnes.get(nom_profil))

    def _sur_supprimer_profil_demande(nom_profil: str, id_pilote: str):
        # PATCH (bouton "Supprimer tous les profils" du panneau de
        # propriétés de l'onglet "Instances sAutoniax" -- demande
        # explicite utilisateur : "je veux que tu ajoute un bouton pour
        # suprimer tout les profils"). Simple enveloppe autour de
        # _sautoniax_supprimer_profil (cf. sa docstring) pour répondre à
        # TOUS les pilotes connectés via envoyer_supprimer_profil_
        # sautoniax_resultat (DIFFUSÉ -- même raisonnement que _sur_creer_
        # profil_sautoniax_demande : ce profil, une fois supprimé, doit
        # disparaître du panneau de n'importe quel pilote ayant ce
        # sAutoniax sélectionné, pas seulement celui qui a cliqué). Le
        # calcul de `profil_actif` se fait ICI (thread/boucle Qt, avant
        # de programmer la coroutine) plutôt que dans _sautoniax_
        # supprimer_profil elle-même, qui n'a pas accès à ces registres
        # (_moteur_batch_courant, _instances_isolees, etc. -- tous locaux
        # à _main_async_sautoniax). `id_pilote` non utilisé (résultat
        # diffusé) -- conservé pour la même symétrie que les autres
        # *_demande de ce fichier.
        profil_actif = _profil_est_actif_sur_ce_sautoniax(nom_profil)

        def _programmer():
            async def _executer():
                ok, message = await _sautoniax_supprimer_profil(loop, nom_profil, profil_actif)
                client_t.envoyer_supprimer_profil_sautoniax_resultat(nom_profil, ok, message)
            tache = loop.create_task(_executer())
            _taches_projets_en_cours.add(tache)
            tache.add_done_callback(_taches_projets_en_cours.discard)
        loop.call_soon_threadsafe(_programmer)

    client_t.supprimer_profil_sautoniax_demande.connect(_sur_supprimer_profil_demande, Qt.DirectConnection)

    def _sur_dupliquer_profil_demande(nom_source: str, noms_cibles: list, id_pilote: str):
        # AJOUT (dupliquer un profil cible). Même patron que
