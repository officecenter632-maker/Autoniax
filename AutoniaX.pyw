    # PATCH (retour utilisateur explicite : "jespere queil yaplus ce
    # genre bugs visuesls dansle code" -- après correctif similaire sur
    # InstancesConnecteesScreen.label_statut) : même bug ici, en pire
    # (~15 messages ponctuels concernés -- démarrage/suppression/copie/
    # échecs de profil) -- setText() seul ne s'efface jamais tout seul.
    # _afficher_statut_temporaire centralise le pattern (déjà utilisé
    # ailleurs dans le fichier via QTimer.singleShot, cf. gabarit_
    # confirmation_label) : affiche le texte, puis programme son
    # effacement après DUREE_AFFICHAGE_STATUT_MS -- SEULEMENT si le
    # label affiche encore ce même texte à l'échéance, pour ne jamais
    # écraser un message plus récent arrivé entre-temps (ex. un
    # changement de sélection de sAutoniax, cf. definir_sautoniax_
    # selectionne qui vide déjà explicitement ce label). Les messages
    # d'ÉTAPE INTERMÉDIAIRE ("Génération en cours... 3/10 créé(s)",
    # "Suppression en cours...", "Récupération des propriétés...") ne
    # passent PAS par cette méthode : ils sont volontairement remplacés
    # par le message suivant de la même opération, jamais par un
    # effacement automatique qui ferait disparaître une progression en
    # cours.
    DUREE_AFFICHAGE_STATUT_MS = 4000

    def _afficher_statut_temporaire(self, texte: str):
        self.label_statut.setText(texte)
        QTimer.singleShot(
            self.DUREE_AFFICHAGE_STATUT_MS,
            lambda: self.label_statut.setText("") if self.label_statut.text() == texte else None,
        )

    # --- Sélection / affichage ---

    def definir_sautoniax_selectionne(self, id_executant: Optional[str], nom_executant: str = "", sautoniax_pret: bool = False):
        """Appelé par InstancesConnecteesScreen à chaque changement de
        sélection dans la liste de gauche -- id_executant=None si la
        sélection est vidée (retour au placeholder). PATCH (demande
        explicite utilisateur : "je suis oblige de toujours appuyer sur
        le bouton de rafraichissement pour que ca apparaisse") : demande
        désormais AUTOMATIQUEMENT les profils dès qu'un sAutoniax est
        sélectionné -- même signal demande_rafraichir_profils que le
        bouton "Rafraîchir" explicite (cf. _sur_clic_rafraichir
        ci-dessous), qui reste disponible pour rescanner manuellement en
        cas de changement côté sAutoniax pendant que le panneau reste
        ouvert sur la même sélection.

        `sautoniax_pret` (RÉTABLI -- cf. CORRECTIF plus bas : le
        contournement "bouton toujours actif" n'est plus nécessaire
        depuis que serveur.py persiste sautoniax_pret sur la connexion,
        cf. Connexion.sautoniax_pret) -- fourni par l'appelant
        (InstancesConnecteesScreen._sur_selection_changee), garanti True
        ici puisqu'une ligne pas encore prête n'est de toute façon jamais
        sélectionnable (Qt.ItemIsSelectable retiré, cf. sur_executants_
        detail_change) -- paramètre gardé explicite (plutôt que supposé
        toujours True) pour que cette méthode reste correcte si jamais
        appelée un jour d'un autre contexte moins garanti."""
        if id_executant == self._id_executant_courant:
            return
        self._id_executant_courant = id_executant
        self._nom_executant_courant = nom_executant
        self._profils = {}
        self._profils_action_en_cours.clear()
        # PATCH (SPEC_proxy_natif_tunnel.md, section 13.6) -- même
        # raisonnement EXACT que _profils_action_en_cours.clear()
        # ci-dessus : un résultat de toggle tardif concernant l'ANCIEN
        # sAutoniax sélectionné ne doit pas laisser un profil bloqué
        # "en cours" indéfiniment pour la nouvelle sélection (le filtre
        # `if id_executant != self._id_executant_courant: return` de
        # sur_resultat_toggle_proxy_natif ignorera de toute façon cette
        # réponse tardive, donc sans ce vidage le set resterait pollué).
        self._profils_toggle_proxy_natif_en_cours.clear()
        # PATCH (bouton "Renommer") -- même raisonnement EXACT que
        # _profils_toggle_proxy_natif_en_cours.clear() ci-dessus.
        self._profils_renommage_en_cours.clear()
        # PATCH (bouton "copier les propriétés") -- même raisonnement EXACT
        # que _profils_action_en_cours.clear() ci-dessus : une réponse
        # get_fingerprint tardive concernant l'ANCIEN sAutoniax sélectionné
        # ne doit plus affecter ce panneau une fois qu'il affiche un autre
        # sAutoniax (ou plus aucun) -- sur_command_result_reseau la
        # traiterait sinon comme si elle concernait la sélection actuelle.
        self._requetes_copie_proprietes.clear()
        self._file_suppression_masse = []
        self._resultats_suppression_masse = {}
        self._id_executant_suppression_masse = None
        self.bouton_supprimer_tous_profils.setEnabled(True)
        # AJOUT (spec A.2) -- même raisonnement EXACT que _file_
        # suppression_masse ci-dessus : un lot de copie en cours pointe
        # vers l'ANCIEN sAutoniax (id_executant_courant lu directement
        # dans _envoyer_prochaine_copie_masse, contrairement aux lots
        # génération/suppression qui figent leur propre id_executant
        # dédié -- cf. leur docstring). Sans ce vidage, la file resterait
        # non vide indéfiniment (sa requête en vol ne sera plus jamais
        # reconnue par sur_command_result_reseau une fois _requetes_
        # copie_proprietes vidé ci-dessus) et bouton_copier_proprietes_
        # masse resterait grisé pour toujours, faute de _terminer_copie_
        # masse jamais atteinte. setEnabled(True) ici n'est qu'un état
        # transitoire (même remarque que bouton_supprimer_tous_profils
        # juste au-dessus) : _profils_coches.clear() ci-dessous fait que
        # la future reconstruction de table le regrisera de toute façon
        # puisque l'ensemble cochés sera vide pour ce nouveau sAutoniax.
        self._file_copie_masse = []
        self._textes_copie_masse = {}
        self._nb_ignores_copie_masse = 0
        self._nb_echecs_copie_masse = 0
        self._nb_traites_copie_masse = 0
        self.bouton_copier_proprietes_masse.setEnabled(True)
        # AJOUT (spec A.1) -- une case cochée pour l'ANCIEN sAutoniax n'a
        # plus de sens une fois la sélection changée (même raisonnement
        # EXACT que _profils_action_en_cours.clear()/_requetes_copie_
        # proprietes.clear() ci-dessus) -- _reconstruire_table (appelée
        # par le futur sur_profils_recus déclenché par demande_
        # rafraichir_profils.emit ci-dessous) regrise les 4 boutons
        # concernés puisque l'ensemble est maintenant vide.
        #
        # CORRECTIF (retour utilisateur : "sa ne met pas a jour les
        # checkbox des profils de chaque sautoniax ... actuellement sa
        # actualise seulement pour le sautoniax qui est selectionner")
        # -- un simple .clear() effaçait aussi la sélection que
        # l'orchestrateur global avait DÉJÀ appliquée à ce NOUVEAU
        # id_executant pendant qu'un autre sAutoniax était affiché (cf.
        # docstring de self._orchestrateur_actions_globales dans
        # __init__) : on reprend maintenant CET état si l'orchestrateur
        # est injecté et connaît ce sAutoniax, un ensemble vide sinon
        # (aucun changement pour id_executant=None/orchestrateur non
        # injecté/sAutoniax jamais touché par une action globale --
        # même résultat qu'avant dans ces trois cas). La purge des noms
        # disparus reste de toute façon assurée juste après par sur_
        # profils_recus (self._profils_coches &= set(self._profils.
        # keys())), donc pas besoin de la refaire ici.
        if self._orchestrateur_actions_globales is not None and id_executant is not None:
            self._profils_coches = set(
                self._orchestrateur_actions_globales.profils_coches_pour(id_executant)
            )
        else:
            self._profils_coches = set()
        self.label_statut.setText("")
        if id_executant is None:
            self.label_titre.setText("Sélectionnez un sAutoniax à gauche")
            self.label_sous_titre.setText("")
            self.bouton_rafraichir.setEnabled(False)
            self.table_profils.setVisible(False)
            self._bloc_selection_masse.setVisible(False)
            self._bloc_generation_masse.setVisible(False)
            self.bouton_tout_demarrer.setVisible(False)
            self.bouton_tout_arreter.setVisible(False)
            self.bouton_supprimer_tous_profils.setVisible(False)
            self.label_placeholder.setVisible(True)
            self.table_profils.clear()
            return
        self.label_titre.setText(nom_executant or id_executant)
        self.label_sous_titre.setText("Actualisation en cours...")
        self.bouton_rafraichir.setEnabled(True)
        self.label_placeholder.setVisible(False)
        self.table_profils.setVisible(True)
        self._bloc_selection_masse.setVisible(True)
        self._bloc_generation_masse.setVisible(True)
        self.bouton_tout_demarrer.setVisible(True)
        self.bouton_tout_arreter.setVisible(True)
        self.bouton_supprimer_tous_profils.setVisible(True)
        # ANCIEN BUGFIX (retour utilisateur explicite : "ne me grise plus
        # le bouton") -- HISTORIQUE, conservé pour traçabilité : la
        # validation "grisé tant que le signal prêt n'a pas encore été
        # reçu pour cet id_executant" (spec A.3) avait dû être retirée à
        # l'époque, MALGRÉ le compromis clairement annoncé, parce que le
        # signal "sautoniax_pret" n'était diffusé par le serveurT QU'AUX
        # pilotes connectés au moment précis de son émission (aucune
        # mémorisation par exécutant côté serveur à cette époque) : un
        # pilote qui se (re)connectait APRÈS cette émission ne le
        # recevait jamais et ne pouvait plus le retrouver, self.
        # _sautoniax_prets restant vide pour lui -- le bouton restait
        # alors TOUJOURS actif par défaut, y compris pendant que le
        # sAutoniax téléchargeait encore ses données de base, un clic
        # dans cette fenêtre repartant dans le vide en silence.
        #
        # CORRECTIF ACTUEL (retour utilisateur explicite : "sa ligne est
        # resté grisée et pourtant il avait déjà téléchargé ses
        # dépendances") -- ce contournement n'a plus lieu d'être depuis
        # que serveur.py persiste sautoniax_pret directement sur la
        # connexion (cf. Connexion.sautoniax_pret, exposé dans chaque
        # entrée de instances_list) : `sautoniax_pret` reçu en paramètre
        # est désormais fiable (garanti True dès qu'on arrive ici, cf.
        # docstring ci-dessus), donc le vrai garde-fou de la spec A.3 est
        # rétabli tel quel -- un clic ne peut plus jamais partir dans le
        # vide vers un sAutoniax dont aucun .connect() de commande n'est
        # encore posé.
        if sautoniax_pret:
            self.bouton_generer_profils.setEnabled(True)
            # CORRECTIF (résidu du patch choix Chrome/Camoufox) -- ce tooltip
            # était réécrit ici avec "Camoufox" figé, écrasant le tooltip
            # dynamique posé par _rafraichir_tooltip_bouton_generer même
            # quand "Chrome" était sélectionné dans combo_type_generation.
            self._rafraichir_tooltip_bouton_generer()
        else:
            self.bouton_generer_profils.setEnabled(False)
            self.bouton_generer_profils.setToolTip(
                "Ce sAutoniax termine encore son démarrage (téléchargement de "
                "ses dépendances de base) -- réessayez une fois sa ligne "
                "dégrisée dans la liste de gauche."
            )
        self.table_profils.clear()
        self.demande_rafraichir_profils.emit(id_executant)

    def _sur_clic_rafraichir(self):
        if self._id_executant_courant is None:
            return
        self.label_sous_titre.setText("Actualisation en cours...")
        self.demande_rafraichir_profils.emit(self._id_executant_courant)

    # --- Génération en masse de profils (remplace l'ancien dialogue
    # modal unitaire "Créer un profil" -- demande explicite utilisateur :
    # "je veux que la generation se fasse en masse, tu met pluot un
    # endorit qui accepte les chiffre et un bouton de generations, la sa
    # vas generer un nombre de profils aleatoire, tu vas leur nomer :
    # iaX1, iaX2..." -- cf. SPEC_generation_masse_profils.md, section 3.
    # Camoufox, sans proxy, toujours (section 3.5, TRANCHÉ) ; envoi
    # SÉQUENTIEL au sAutoniax, un profil à la fois, le suivant n'étant
    # émis qu'après le résultat réel du précédent (section 3.3, même
    # raisonnement que la spec : le protocole demande_creer_profil/
    # sur_resultat_creer_profil n'a jamais été conçu/éprouvé pour des
    # créations concurrentes sur le même sAutoniax). ---

    def _prochains_noms_iax(self, nombre: int) -> list[str]:
        """Retourne `nombre` noms iaX{n} inédits, en poursuivant la
        numérotation après le plus grand indice iaX déjà présent dans
        self._profils (connus au dernier rafraîchissement reçu via
        sur_profils_recus) -- ne réutilise JAMAIS un indice existant,
        même si un profil intermédiaire a été supprimé depuis (même
        philosophie que Task.versions/numero ailleurs dans ce fichier :
        toujours croissant, jamais réutilisé), pour qu'un utilisateur ne
        se retrouve jamais avec une collision surprise en cas de
        rafraîchissement périmé.

        Ce calcul se fait CÔTÉ CLIENT à partir du dernier scan connu --
        un TOCTOU reste possible si un autre pilote crée un profil
        iaX{n} entre ce calcul et l'envoi réel (plusieurs pilotes
        connectés simultanément sur le même sAutoniax, cas rare) :
        _sautoniax_creer_profil refuse déjà côté serveur tout dossier
        non vide existant, donc une collision résiduelle se traduit par
        un échec propre pour CE nom précis (cf. _sur_resultat_creation_
        masse), jamais un écrasement silencieux."""
        motif = re.compile(r"^iaX(\d+)$", re.IGNORECASE)
        indices_existants = []
        for nom in self._profils.keys():
            m = motif.match(nom)
            if m:
                indices_existants.append(int(m.group(1)))
        depart = (max(indices_existants) + 1) if indices_existants else 1
        return [f"iaX{depart + i}" for i in range(nombre)]

    def _sur_clic_coller_contraintes(self):
        """AJOUT (spec A.4) -- lit le presse-papier système (même patron
        QGuiApplication.clipboard().text() que _bouton_coller ailleurs
        dans ce fichier), valide via parser_contraintes_generation_profil,
        et met à jour self._contraintes_generation + label_statut_
        contraintes en conséquence.

        DÉCISION UTILISATEUR (cf. commentaire d'init de
        self._contraintes_generation) : le JSON collé n'est JAMAIS
        affiché à l'écran -- seul le résultat de la validation (actif/
        invalide/vide) apparaît dans le label. Un presse-papier vide (ou
        blanc) EFFACE le filtre actif au lieu de le laisser inchangé --
        c'est le seul moyen de désactiver le filtre puisqu'il n'y a pas
        de champ texte à vider manuellement."""
        texte = QGuiApplication.clipboard().text().strip()
        if not texte:
            self._contraintes_generation = {}
            self._definir_statut_contraintes("Aucun filtre de génération actif.", Mocha.surface2)
            return

        ok, contraintes, erreur = parser_contraintes_generation_profil(texte)
        if not ok:
            # Filtre précédent conservé tel quel -- un JSON invalide collé
            # par erreur ne doit pas effacer silencieusement un filtre
            # valide déjà actif.
            self._definir_statut_contraintes(f"JSON invalide : {erreur}", Mocha.red)
            return

        self._contraintes_generation = contraintes
        resume = "; ".join(
            f"{cle} : {', '.join(valeurs)}" for cle, valeurs in contraintes.items()
        )
        self._definir_statut_contraintes(f"Filtre actif -- {resume}", Mocha.green)

    def _definir_statut_contraintes(self, texte: str, couleur: str) -> None:
        """REFONTE (cf. commentaire de construction du bloc génération,
        "tu ne peut pas reflechir comme un designer?") -- remplace
        l'ancien label_statut_contraintes en toutes lettres par un point
        d'état compact (self.point_statut_contraintes) coloré selon le
        statut, plus le tooltip du bouton "Coller les contraintes"
        lui-même -- les DEUX portent le même texte complet (`texte`),
        pour que l'info reste consultable qu'on survole le point ou le
        bouton, sans jamais prendre de place dans la mise en page."""
        self.point_statut_contraintes.setStyleSheet(f"color: {couleur}; font-size: 10px;")
        self.point_statut_contraintes.setToolTip(texte)
        self.bouton_coller_contraintes.setToolTip(
            f"Coller les contraintes -- {texte}\n"
            "Colle un JSON de contraintes depuis le presse-papier "
            "(ex. {\"Résolution d'écran\": [\"height>700\", \"width>600\"]}) -- "
            "un presse-papier vide efface le filtre actif."
        )

    def _type_instance_generation_choisi(self) -> str:
        """Type ("chrome"/"camoufox") actuellement sélectionné dans
        self.combo_type_generation -- lu à chaque usage, jamais mis en
        cache (cf. commentaire de construction du combo : même principe
        que self.spin_nombre_generation pour la quantité). Repli sur
        "camoufox" si le combo n'a par extraordinaire aucun item
        sélectionné (currentData() renverrait alors None)."""
        return self.combo_type_generation.currentData() or "camoufox"

    def _rafraichir_tooltip_bouton_generer(self):
        """Tooltip du bouton Générer, dépendant du type actuellement
        choisi dans self.combo_type_generation -- rappelée à la
        construction ET à chaque changement de ce combo (cf.
        _sur_changement_type_generation)."""
        libelle = self.combo_type_generation.currentText() or "Camoufox"
        self.bouton_generer_profils.setToolTip(
            f"Crée automatiquement N profils {libelle} (sans proxy) nommés "
            "iaX1, iaX2... -- la numérotation reprend après le plus grand "
            "indice iaX déjà présent sur ce sAutoniax."
        )

    def _sur_changement_type_generation(self, _index: int):
        self._rafraichir_tooltip_bouton_generer()

    def _on_clic_generer_profils_masse(self):
        """AJOUT (demande explicite utilisateur : \"quand on clic sur genere r,
        il ya deux option qui se propose : aleatoire, ou dupliquer ... deux
        option se prosoe si on a cocher un profils parmie la liste\").

        - Aucun profil coché : comportement INCHANGÉ (génération aléatoire
          directe, exactement comme avant).
        - Profil(s) coché(s) : menu à 2 choix -- « Aléatoire » (génération
          habituelle) ou « Dupliquer » (copies identiques du profil coché).
          « Dupliquer » n'est proposé QUE si exactement UN profil est coché
          (sinon la source serait ambiguë).
        """
        if self._id_executant_courant is None:
            return
        if self._file_generation_masse:
            return  # un lot est déjà en cours d'envoi, cf. bouton désactivé pendant ce temps
        if not self._profils_coches:
            self._lancer_generation_masse(self._id_executant_courant, self.spin_nombre_generation.value())
            return

        menu = QMenu(self.bouton_generer_profils)
        action_aleatoire = menu.addAction(qta.icon("mdi6.dice-multiple", color=Mocha.text), "Aléatoire")
        action_aleatoire.setToolTip("Crée N profils neufs au fingerprint aléatoire (comportement habituel).")
        action_dupliquer = menu.addAction(qta.icon("mdi6.content-duplicate", color=Mocha.text), "Dupliquer")
        if len(self._profils_coches) == 1:
            action_dupliquer.setToolTip("Crée N copies identiques du profil coché (même fingerprint, même config).")
        else:
            action_dupliquer.setEnabled(False)
            action_dupliquer.setToolTip(
                "Sélectionne exactement UN profil pour le dupliquer "
                f"({len(self._profils_coches)} coché(s) actuellement)."
            )

        menu.addSeparator()
        action_regenerer = menu.addAction(qta.icon("mdi6.refresh", color=Mocha.text), "Régénérer le navigateur")
        if len(self._profils_coches) == 1:
            action_regenerer.setToolTip(
                "Supprime le navigateur du profil coché et en crée un nouveau (nouvelle empreinte), "
                "avec le MÊME proxy/IP."
            )
        else:
            action_regenerer.setEnabled(False)
            action_regenerer.setToolTip(
                "Sélectionne exactement UN profil pour régénérer son navigateur "
                f"({len(self._profils_coches)} coché(s) actuellement)."
            )

        choix = menu.exec(self.bouton_generer_profils.mapToGlobal(
            self.bouton_generer_profils.rect().bottomLeft()
        ))
        if choix is action_aleatoire:
            self._lancer_generation_masse(self._id_executant_courant, self.spin_nombre_generation.value())
        elif choix is action_dupliquer:
            self._lancer_duplication_masse(self._id_executant_courant, next(iter(self._profils_coches)))
        elif choix is action_regenerer:
            self._lancer_regeneration_navigateur(self._id_executant_courant, next(iter(self._profils_coches)))

    def _lancer_duplication_masse(self, id_executant: str, nom_source: str):
        """AJOUT (dupliquer un profil cible) -- crée `spin_nombre_generation`
        copies IDENTIQUES du profil source, en UNE seule requête réseau (pas
        une file séquentielle comme la génération aléatoire, la copie est
        atomique côté sAutoniax : _sautoniax_dupliquer_profil). Les noms
        suivent la numérotation iaX existante (_prochains_noms_iax)."""
        nombre = self.spin_nombre_generation.value()
        noms_cibles = self._prochains_noms_iax(nombre)
        self.bouton_generer_profils.setEnabled(False)
        self.label_statut.setText(f"Duplication de « {nom_source} » en {nombre} copie(s)...")
        self.demande_dupliquer_profil.emit(id_executant, nom_source, noms_cibles)

    def _lancer_regeneration_navigateur(self, id_executant: str, nom_profil: str):
        """AJOUT (régénérer le navigateur) -- confirmation (avec case « garder
        les données »), puis UNE requête réseau ; le résultat arrive via
        sur_resultat_regenerer_profil."""
        garder_donnees = _demander_confirmation_regeneration_navigateur(self, nom_profil)
        if garder_donnees is None:
            return  # annulé par l'utilisateur
        self.bouton_generer_profils.setEnabled(False)
        self.label_statut.setText(f"Régénération du navigateur de « {nom_profil} »...")
        self.demande_regenerer_profil.emit(id_executant, nom_profil, bool(garder_donnees), True)

    def sur_resultat_regenerer_profil(self, id_executant: str, nom_profil: str, ok: bool, message: str, instance_id: str = ""):
        """AJOUT (régénérer le navigateur) -- connecté par MainWindow à
        ClientServeurT.regenerer_profil_sautoniax_resultat_recu (DIFFUSÉ) et
        à l'échec de transmission."""
        if id_executant != self._id_executant_courant:
            return
        self.bouton_generer_profils.setEnabled(not self._file_generation_masse)
        if ok:
            self._afficher_statut_temporaire(f"Navigateur de « {nom_profil} » régénéré. {message}".strip())
            self.demande_rafraichir_profils.emit(id_executant)
        else:
            self._afficher_statut_temporaire(f"Échec de la régénération de « {nom_profil} » : {message}")

    def _lancer_generation_masse(self, id_executant: str, nombre: int):
        noms = self._prochains_noms_iax(nombre)
        self._file_generation_masse = list(noms)
        self._resultats_generation_masse = {}
        self._id_executant_generation_masse = id_executant
        # PATCH (choix Chrome/Camoufox) -- figé ICI, au lancement du lot,
        # comme id_executant l'est déjà juste au-dessus : si l'utilisateur
        # change le combo PENDANT qu'un lot est en cours d'envoi (cas
        # limite, le bouton est désactivé mais le combo reste actif), ce
        # lot déjà lancé reste sur le type choisi au moment du clic --
        # jamais un mélange de types au sein d'un même lot séquentiel.
        self._type_instance_generation_masse_en_cours = self._type_instance_generation_choisi()
        self.bouton_generer_profils.setEnabled(False)
        self.label_statut.setText(f"Génération en cours... 0/{nombre} créé(s)")
        self._envoyer_prochaine_creation_masse()

    def _envoyer_prochaine_creation_masse(self):
        """Émet demande_creer_profil pour le PROCHAIN nom de la file --
        celui-ci reste en tête de _file_generation_masse (pas retiré
        ici) tant que sa réponse réelle n'est pas revenue via
        sur_resultat_creer_profil, seul point qui le fait avancer (cf.
        _sur_resultat_creation_masse)."""
        if not self._file_generation_masse:
            self._terminer_generation_masse()
            return
        nom_profil = self._file_generation_masse[0]
        self.demande_creer_profil.emit(
            self._id_executant_generation_masse, nom_profil,
            self._type_instance_generation_masse_en_cours, self._proxy_generation_masse,
            self._contraintes_generation,
        )

    def _sur_resultat_creation_masse(self, nom_profil: str, ok: bool, message: str):
        """Appelée par sur_resultat_creer_profil (ci-dessous) quand la
        réponse concerne le lot en masse en cours -- enchaîne
        automatiquement la création suivante, succès ET échec confondus
        (un nom déjà pris par un autre pilote, cf. docstring de
        _prochains_noms_iax, ne doit jamais bloquer le reste du lot)."""
        self._resultats_generation_masse[nom_profil] = (ok, message)
        if self._file_generation_masse and self._file_generation_masse[0] == nom_profil:
            self._file_generation_masse.pop(0)
        total = len(self._resultats_generation_masse) + len(self._file_generation_masse)
        faits = len(self._resultats_generation_masse)
        self.label_statut.setText(f"Génération en cours... {faits}/{total} créé(s)")
        self._envoyer_prochaine_creation_masse()

    def _terminer_generation_masse(self):
        reussis = [n for n, (ok, _msg) in self._resultats_generation_masse.items() if ok]
        echecs = [(n, msg) for n, (ok, msg) in self._resultats_generation_masse.items() if not ok]
        self.bouton_generer_profils.setEnabled(True)
        if echecs:
            details = "; ".join(f"{n} ({msg})" for n, msg in echecs[:3])
            suffixe = "..." if len(echecs) > 3 else ""
            self._afficher_statut_temporaire(
                f"{len(reussis)} profil(s) créé(s), {len(echecs)} échec(s) : {details}{suffixe}"
            )
        else:
            self._afficher_statut_temporaire(f"{len(reussis)} profil(s) créé(s) avec succès.")
        id_executant_lot = self._id_executant_generation_masse
        self._resultats_generation_masse = {}
        self._id_executant_generation_masse = None
        if reussis and id_executant_lot is not None:
            self.demande_rafraichir_profils.emit(id_executant_lot)

    def sur_resultat_creer_profil(self, id_executant: str, nom_profil: str, ok: bool, message: str):
        """Connecté par MainWindow à ClientServeurT.creer_profil_
        sautoniax_resultat_recu -- DIFFUSÉ à tous les pilotes (cf.
        docstring de envoyer_creer_profil_sautoniax_resultat côté
        serveur), donc peut arriver même si CE poste n'a pas de lot de
        génération en cours (ex. un autre pilote a créé un profil) --
        ignoré dans ce cas.

        PATCH (remplacement du dialogue unitaire par la génération en
        masse) : seul point d'entrée des résultats de création restant,
        entièrement dédié au lot en masse (cf. _sur_resultat_creation_
        masse) -- l'ancien routage vers un dialogue modal unitaire a
        disparu avec lui."""
        if id_executant != self._id_executant_generation_masse:
            return
        if nom_profil not in self._file_generation_masse:
            return  # réponse tardive hors lot actuel (ex. lot déjà terminé) -- ignorée
        self._sur_resultat_creation_masse(nom_profil, ok, message)

    # --- "Tout démarrer" (demande explicite utilisateur : "tu dois
    # aussi mettre un bouton tout demarer") -- cible TOUS les profils
    # actuellement inactifs de ce sAutoniax, peu importe leur origine
    # (cf. section 4.1 de la spec, TRANCHÉ). ---

    def _on_clic_tout_demarrer(self):
        if self._id_executant_courant is None:
            return
        # AJOUT (spec A.1) -- filtré désormais sur les profils COCHÉS EN
        # PLUS du filtre d'état existant (inactif + pas déjà en cours
        # d'action) -- ce bouton est de toute façon grisé tant qu'aucun
        # profil coché n'est inactif (cf. _rafraichir_etat_boutons_masse),
        # ce filtre est donc surtout défensif si l'état change entre le
        # moment où le bouton a été activé et le clic réel.
        noms_inactifs = [
            nom for nom, infos in self._profils.items()
            if not infos.get("actif") and nom not in self._profils_action_en_cours
            and nom in self._profils_coches
        ]
        if not noms_inactifs:
            self._afficher_statut_temporaire("Aucun profil coché et inactif à démarrer.")
            return
        for nom_profil in noms_inactifs:
            self._sur_clic_demarrer_profil(self._id_executant_courant, nom_profil)

    # --- "Tout arrêter" (demande explicite utilisateur : "je veux que
    # ajoute aussi le bouton tout arreter, sur la meme ligne que le
    # bouton tout demarer") -- symétrique exact de "Tout démarrer"
    # ci-dessus : cible TOUS les profils actuellement ACTIFS de ce
    # sAutoniax (peu importe leur origine, même logique TRANCHÉE que
    # pour "Tout démarrer") et réutilise _sur_clic_kill_profil tel quel,
    # en boucle -- aucune modification nécessaire côté protocole réseau
    # puisque demande_kill_profil existe déjà pour l'arrêt unitaire. ---

    def _on_clic_tout_arreter(self):
        if self._id_executant_courant is None:
            return
        # AJOUT (spec A.1) -- cf. commentaire équivalent dans
        # _on_clic_tout_demarrer ci-dessus.
        noms_actifs = [
            nom for nom, infos in self._profils.items()
            if infos.get("actif") and nom not in self._profils_action_en_cours
            and nom in self._profils_coches
        ]
        if not noms_actifs:
            self._afficher_statut_temporaire("Aucun profil coché et actif à arrêter.")
            return
        for nom_profil in noms_actifs:
            self._sur_clic_kill_profil(self._id_executant_courant, nom_profil)

    # --- "Supprimer tous les profils" (demande explicite utilisateur :
    # "je veux que tu ajoute un bouton pour suprimer tout les profils")
    # -- AJOUT (spec A.1) : cible désormais uniquement les profils
    # COCHÉS de ce sAutoniax (auparavant TOUS, sans distinction) --
    # actifs ET inactifs parmi les cochés : ceux qui sont actifs sont
    # simplement REFUSÉS un par un côté sAutoniax (cf. _sautoniax_
    # supprimer_profil, "actif = arrête-le d'abord") plutôt que filtrés
    # silencieusement ici -- l'utilisateur voit ainsi clairement, dans
    # le bilan final, lesquels n'ont pas pu être supprimés et pourquoi.
    # Même patron SÉQUENTIEL EXACT que la génération en masse
    # (_lancer_generation_masse et sa file), un seul lot à la fois
    # (bouton désactivé pendant l'envoi). ---

    def _on_clic_supprimer_tous_profils(self):
        if self._id_executant_courant is None:
            return
        if self._file_suppression_masse:
            return  # une suppression en masse est déjà en cours d'envoi
        noms = sorted(
            (nom for nom in self._profils.keys() if nom in self._profils_coches),
            key=_cle_tri_numerique_profil,
        )
        if not noms:
            self._afficher_statut_temporaire("Aucun profil coché à supprimer sur ce sAutoniax.")
            return
        # MIGRÉ (section 6, cohérence de thème) : QMessageBox natif ->
        # BoiteDialogueAutoniaX.question, MÊME contrat (bool : True si
        # confirmé). "Cancel" -> texte_non="Annuler" pour préserver le
        # libellé exact affiché avant migration (ce n'était pas un vrai
        # "Non" sémantique, cf. setStandardButtons Yes|Cancel d'origine).
        confirme = BoiteDialogueAutoniaX.question(
            self,
            "Supprimer les profils cochés",
            f"Supprimer définitivement les {len(noms)} profil(s) coché(s) de "
            f"« {self._nom_executant_courant or self._id_executant_courant} » ?",
            texte_oui="Supprimer",
            texte_non="Annuler",
            texte_informatif=(
                "Cette action est irréversible. Les profils cochés mais "
                "actuellement actifs seront ignorés (arrête-les d'abord via Kill)."
            ),
        )
        if not confirme:
            return
        self._lancer_suppression_masse(self._id_executant_courant, noms)

    def _lancer_suppression_masse(self, id_executant: str, noms: list[str]):
        self._file_suppression_masse = list(noms)
        self._resultats_suppression_masse = {}
        self._id_executant_suppression_masse = id_executant
        self.bouton_supprimer_tous_profils.setEnabled(False)
        self.label_statut.setText(f"Suppression en cours... 0/{len(noms)} traité(s)")
        self._envoyer_prochaine_suppression_masse()

    def _envoyer_prochaine_suppression_masse(self):
        """Émet demande_supprimer_profil pour le PROCHAIN nom de la file
        -- même patron EXACT que _envoyer_prochaine_creation_masse :
        celui-ci reste en tête de _file_suppression_masse tant que sa
        réponse réelle n'est pas revenue via sur_resultat_supprimer_
        profil, seul point qui le fait avancer."""
        if not self._file_suppression_masse:
            self._terminer_suppression_masse()
            return
        nom_profil = self._file_suppression_masse[0]
        self.demande_supprimer_profil.emit(self._id_executant_suppression_masse, nom_profil)

    def _sur_resultat_suppression_masse(self, nom_profil: str, ok: bool, message: str):
        self._resultats_suppression_masse[nom_profil] = (ok, message)
        if self._file_suppression_masse and self._file_suppression_masse[0] == nom_profil:
            self._file_suppression_masse.pop(0)
        total = len(self._resultats_suppression_masse) + len(self._file_suppression_masse)
        faits = len(self._resultats_suppression_masse)
        self.label_statut.setText(f"Suppression en cours... {faits}/{total} traité(s)")
        self._envoyer_prochaine_suppression_masse()

    def _terminer_suppression_masse(self):
        reussis = [n for n, (ok, _msg) in self._resultats_suppression_masse.items() if ok]
        echecs = [(n, msg) for n, (ok, msg) in self._resultats_suppression_masse.items() if not ok]
        # AJOUT (spec A.1) -- remplace l'ancien setEnabled(True)
        # inconditionnel : le bouton doit rester grisé si _profils_coches
        # est vide (ex. tous les noms cochés viennent d'être supprimés
        # avec succès -- purgés de _profils_coches par sur_profils_recus
        # si un rafraîchissement suit ci-dessous, mais ce recalcul reste
        # correct même si aucun profil n'a réussi, cf. docstring de
        # _rafraichir_etat_boutons_masse).
        self._rafraichir_etat_boutons_masse()
        if echecs:
            details = "; ".join(f"{n} ({msg})" for n, msg in echecs[:3])
            suffixe = "..." if len(echecs) > 3 else ""
            self._afficher_statut_temporaire(
                f"{len(reussis)} profil(s) supprimé(s), {len(echecs)} ignoré(s)/échec(s) : {details}{suffixe}"
            )
        else:
            self._afficher_statut_temporaire(f"{len(reussis)} profil(s) supprimé(s) avec succès.")
        id_executant_lot = self._id_executant_suppression_masse
        self._resultats_suppression_masse = {}
        self._id_executant_suppression_masse = None
        if reussis and id_executant_lot is not None:
            self.demande_rafraichir_profils.emit(id_executant_lot)

    def sur_resultat_dupliquer_profil(self, id_executant: str, nom_source: str, ok: bool, message: str):
        """AJOUT (dupliquer un profil cible) -- connecté par MainWindow à
        ClientServeurT.dupliquer_profil_sautoniax_resultat_recu (DIFFUSÉ à
        tous les pilotes) ET à demander_dupliquer_profil_sautoniax_resultat
        (échec de transmission). Réactive le bouton, affiche le bilan, et
        demande un rafraîchissement de la liste si la copie a réussi."""
        if id_executant != self._id_executant_courant:
            return
        self.bouton_generer_profils.setEnabled(not self._file_generation_masse)
        if ok:
            self._afficher_statut_temporaire(f"Profil « {nom_source} » dupliqué avec succès.")
            self.demande_rafraichir_profils.emit(id_executant)
        else:
            self._afficher_statut_temporaire(f"Échec de la duplication de « {nom_source} » : {message}")

    def sur_resultat_supprimer_profil(self, id_executant: str, nom_profil: str, ok: bool, message: str):
        """Connecté par MainWindow à ClientServeurT.supprimer_profil_
        sautoniax_resultat_recu -- DIFFUSÉ à tous les pilotes (même
        raisonnement EXACT que sur_resultat_creer_profil), donc peut
        arriver même si CE poste n'a pas de lot de suppression en cours
        -- ignoré dans ce cas."""
        if id_executant != self._id_executant_suppression_masse:
            return
        if nom_profil not in self._file_suppression_masse:
            return  # réponse tardive hors lot actuel (ex. lot déjà terminé) -- ignorée
        self._sur_resultat_suppression_masse(nom_profil, ok, message)

    def sur_sautoniax_pret(self, id_executant: str):
        """AJOUT (spec A.3) -- connecté par MainWindow à ClientServeurT.
        sautoniax_pret_recu (DIFFUSÉ à tous les pilotes dès qu'un
        exécutant termine sa connexion/enregistrement, cf. docstring du
        signal). Ajoute à _sautoniax_prets (jamais retiré ensuite, cf.
        docstring de l'attribut dans __init__) puis, si cet exécutant est
        celui actuellement affiché par ce panneau, débloque bouton_
        generer_profils -- sous réserve qu'aucun lot de génération ne
        soit déjà en cours (cf. _file_generation_masse), auquel cas le
        bouton doit rester grisé pour la raison habituelle (lot en vol),
        pas pour la raison "pas prêt" qui vient de se résoudre."""
        self._sautoniax_prets.add(id_executant)
        if id_executant != self._id_executant_courant:
            return
        if self._file_generation_masse:
            return
        self.bouton_generer_profils.setEnabled(True)
        # CORRECTIF (résidu du patch choix Chrome/Camoufox) -- même raison
        # que dans definir_executant : plus de "Camoufox" figé ici, le
        # tooltip suit le type réellement choisi dans le combo.
        self._rafraichir_tooltip_bouton_generer()

    def sur_profils_recus(self, id_executant: str, profils: list):
        """Connecté par MainWindow à ClientServeurT.profils_sautoniax_
        recu -- liste RÉELLE (actifs + inactifs, cf. son docstring pour
        le format exact). Ignore toute réception concernant un AUTRE
        sAutoniax que celui actuellement affiché (peut arriver si un
        rafraîchissement était en cours au moment où l'utilisateur a
        changé de sélection à gauche)."""
        if id_executant != self._id_executant_courant:
            return
        self._profils = {p["nom"]: p for p in profils if p.get("nom")}
        # AJOUT (spec A.1) -- purge les noms cochés qui ont disparu de ce
        # nouveau scan (profil supprimé entre-temps par un autre poste,
        # ou par le lot de suppression en masse qui vient de se
        # terminer) : une case cochée pour un profil qui n'existe plus
        # ferait planter/serait sans effet si on tentait de le
        # démarrer/copier ensuite.
        self._profils_coches &= set(self._profils.keys())
        nb_actifs = sum(1 for p in self._profils.values() if p.get("actif"))
        self.label_sous_titre.setText(
            f"{len(self._profils)} profil(s) -- {nb_actifs} actif(s)."
            if self._profils else "Aucun profil trouvé sur ce sAutoniax."
        )
        self._reconstruire_table()

    def _reconstruire_table(self):
        self.table_profils.clear()
        for nom_profil, infos in sorted(
            self._profils.items(), key=lambda paire: _cle_tri_numerique_profil(paire[0])
        ):
            item = QTreeWidgetItem()
            # AJOUT (spec A.1, sélection multiple) -- même patron EXACT
            # que PanneauExecutionClone._reconstruire_table (référence
            # visuelle explicitement demandée par la spec) : checkbox
            # posée AVANT addTopLevelItem, pour ne pas déclencher
            # itemChanged prématurément pendant la reconstruction (elle
            # ne l'aurait de toute façon pas fait ici puisque l'état
            # coché est lu directement depuis _profils_coches, pas
            # modifié -- mais reproduit l'ordre pour rester cohérent).
            item.setFlags(item.flags() | Qt.ItemIsUserCheckable)
            item.setCheckState(0, Qt.Checked if nom_profil in self._profils_coches else Qt.Unchecked)
            item.setText(0, nom_profil)
            actif = bool(infos.get("actif"))
            item.setText(1, "Actif" if actif else "Inactif")
            self.table_profils.addTopLevelItem(item)
            self.table_profils.setItemWidget(
                item, 2, self._construire_widget_actions_profil(nom_profil, infos)
            )
        for i in range(2):
            self.table_profils.resizeColumnToContents(i)
        # AJOUT (spec A.1/A.2) -- recalcule l'état grisé/actif des 4
        # boutons qui dépendent désormais de _profils_coches (Tout
        # démarrer, Tout arrêter, Supprimer tous les profils, Copier --
        # cf. leurs handlers respectifs, tous filtrent maintenant sur
        # nom in self._profils_coches EN PLUS de leur filtre d'état
        # existant, et sont grisés tant que l'ensemble est vide).
        self._rafraichir_etat_boutons_masse()

    def _sur_item_changed_profil(self, item: QTreeWidgetItem, colonne: int):
        """AJOUT (spec A.1) -- même patron EXACT que PanneauExecutionClone.
        _sur_item_changed : déclenché par le clic sur la checkbox de
        colonne 0 (le connect posé dans __init__ ne filtre pas la
        colonne, on le fait ici pour ignorer tout itemChanged qui ne
        concernerait pas la case -- aucun autre setText ne se produit
        actuellement sur cette table en dehors de _reconstruire_table,
        mais ce garde-fou reste peu coûteux et cohérent avec la
        référence visuelle citée)."""
        if colonne != 0:
            return
        nom_profil = item.text(0)
        if nom_profil not in self._profils:
            return
        if item.checkState(0) == Qt.Checked:
            self._profils_coches.add(nom_profil)
        else:
            self._profils_coches.discard(nom_profil)
        self._rafraichir_etat_boutons_masse()

    def _sur_clic_tout_selectionner_profils(self):
        """AJOUT (spec A.1) -- coche la case de TOUTES les lignes
        actuellement affichées -- déclenche itemChanged pour chacune
        (cf. _sur_item_changed_profil, déjà connecté), qui se charge
        lui-même de synchroniser _profils_coches et l'état des boutons."""
        for i in range(self.table_profils.topLevelItemCount()):
            self.table_profils.topLevelItem(i).setCheckState(0, Qt.Checked)

    def _sur_clic_tout_deselectionner_profils(self):
        """AJOUT (spec A.1) -- symétrique de _sur_clic_tout_selectionner_
        profils ci-dessus -- décoche tout."""
        for i in range(self.table_profils.topLevelItemCount()):
            self.table_profils.topLevelItem(i).setCheckState(0, Qt.Unchecked)

    def _sur_clic_selectionner_actifs_profils(self):
        """AJOUT (demande explicite utilisateur : "je veux que tu ajoute
        parmie les bouton de selection: selectionner les actifs, non
        actifs") -- coche UNIQUEMENT les lignes dont le profil est
        actuellement actif (self._profils[nom].get("actif"), même
        source que la colonne "État" posée par _reconstruire_table),
        laisse les lignes inactives dans leur état de coche courant
        (ni forcé coché, ni décoché) -- contrairement à _sur_clic_tout_
        selectionner_profils qui, lui, coche absolument tout sans
        distinction. Déclenche itemChanged pour chaque ligne touchée
        (cf. _sur_item_changed_profil, déjà connecté), qui se charge lui-
        même de synchroniser _profils_coches et l'état des boutons."""
        for i in range(self.table_profils.topLevelItemCount()):
            item = self.table_profils.topLevelItem(i)
            nom_profil = item.text(0)
            infos = self._profils.get(nom_profil)
            if infos is not None and infos.get("actif"):
                item.setCheckState(0, Qt.Checked)

    def _sur_clic_selectionner_inactifs_profils(self):
        """AJOUT (même demande explicite que _sur_clic_selectionner_
        actifs_profils ci-dessus) -- symétrique exact, mais pour les
        profils actuellement INACTIFS -- coche uniquement les lignes
        dont infos.get("actif") est falsy, laisse les lignes actives
        dans leur état de coche courant."""
        for i in range(self.table_profils.topLevelItemCount()):
            item = self.table_profils.topLevelItem(i)
            nom_profil = item.text(0)
            infos = self._profils.get(nom_profil)
            if infos is not None and not infos.get("actif"):
                item.setCheckState(0, Qt.Checked)

    def _rafraichir_etat_boutons_masse(self):
        """AJOUT (spec A.1/A.2) -- point UNIQUE de recalcul de l'état
        grisé/actif des 4 boutons qui dépendent de _profils_coches, pour
        que ce recalcul ne puisse pas être oublié à l'un des 3 endroits
        où l'ensemble change (coche/décoche individuelle, tout
        sélectionner/désélectionner, reconstruction complète après un
        nouveau scan) -- appelé depuis _reconstruire_table (donc après
        CHAQUE scan) et _sur_item_changed_profil (donc après CHAQUE
        coche/décoche individuelle ou en masse, puisque _sur_clic_tout_
        selectionner_profils/_deselectionner_profils passent tous les
        deux par setCheckState qui redéclenche itemChanged pour chaque
        ligne).

        Un profil coché doit aussi être ACTIF pour Tout arrêter/Copier,
        ou INACTIF pour Tout démarrer -- ces 2 boutons restent activés
        dès qu'au moins un profil coché correspond à leur état requis,
        pas seulement dès que _profils_coches est non vide (cohérent
        avec le message "Aucun profil inactif/actif à démarrer/arrêter"
        déjà affiché par leurs handlers si la liste filtrée est vide au
        moment du clic -- ce recalcul en amont évite un clic qui ne
        ferait rien d'observable).

        BUGFIX (bouton "Rafraîchir" non bloqué pendant un lot en masse) --
        _reconstruire_table (donc CE recalcul) est aussi déclenchée par
        sur_profils_recus, atteignable via un clic sur bouton_rafraichir
        À TOUT MOMENT, y compris pendant qu'un lot de suppression ou de
        copie en masse est encore en vol (_file_suppression_masse/
        _file_copie_masse non vides -- ces deux lots restent grisés par
        leur propre setEnabled(False) posé à leur lancement, cf. _lancer_
        suppression_masse/_sur_clic_copier_proprietes_masse, MAIS ce
        recalcul, lui, ignorait cet état et réactivait le bouton dès
        qu'au moins un profil coché correspondait -- un rafraîchissement
        reçu en plein lot pouvait donc redégriser le bouton et permettre
        un second lot concurrent, alors que le protocole séquentiel
        sous-jacent (une requête à la fois, cf. leurs docstrings) n'a
        jamais été conçu pour ça. bouton_tout_demarrer/bouton_tout_
        arreter ne sont PAS concernés (pas de file d'attente : chaque
        clic émet directement une commande par profil, sans état de lot
        à protéger)."""
        if not self._profils_coches:
            self.bouton_tout_demarrer.setEnabled(False)
            self.bouton_tout_arreter.setEnabled(False)
            self.bouton_supprimer_tous_profils.setEnabled(False)
            self.bouton_copier_proprietes_masse.setEnabled(False)
            return
        nb_coches_inactifs = sum(
            1 for nom in self._profils_coches
            if not self._profils.get(nom, {}).get("actif")
        )
        nb_coches_actifs = len(self._profils_coches) - nb_coches_inactifs
        self.bouton_tout_demarrer.setEnabled(nb_coches_inactifs > 0)
        self.bouton_tout_arreter.setEnabled(nb_coches_actifs > 0)
        # BUGFIX -- `and not self._file_..._masse` ajouté sur ces 2
        # lignes (cf. docstring ci-dessus) : sans cette condition, un
        # rafraîchissement reçu pendant qu'un lot de suppression/copie est
        # encore en vol réactivait le bouton correspondant dès qu'au
        # moins un profil coché correspondait, par-dessus le setEnabled
        # (False) posé à l'ouverture du lot -- permettant un second lot
        # concurrent sur un protocole séquentiel qui n'en supporte qu'un
        # à la fois.
        self.bouton_supprimer_tous_profils.setEnabled(not self._file_suppression_masse)
        self.bouton_copier_proprietes_masse.setEnabled(nb_coches_actifs > 0 and not self._file_copie_masse)

    def definir_orchestrateur_actions_globales(self, orchestrateur: "OrchestrateurActionsGlobalesInstances"):
        """CORRECTIF (retour utilisateur : "sa ne met pas a jour les
        checkbox des profils de chaque sautoniax ... actuellement sa
        actualise seulement pour le sautoniax qui est selectionner") --
        injection tardive, MÊME patron EXACT que definir_reglages/
        definir_client_reseau ailleurs dans ce fichier, posée une fois
        par MainWindow juste après construction des deux (cf. son
        docstring de câblage). Permet à definir_sautoniax_selectionne de
        consulter l'état "coché" réellement tenu par l'orchestrateur
        pour le sAutoniax qui devient affiché, plutôt que de repartir
        d'un ensemble vide à chaque changement de sélection -- cf.
        docstring de self._orchestrateur_actions_globales dans __init__
        pour le détail complet du trou comblé ici."""
        self._orchestrateur_actions_globales = orchestrateur

    def appliquer_coches_externes(self, id_executant: str, noms_coches: set):
        """CORRECTIF (demande explicite utilisateur : "lorsque on
        selectionne ou deselectionne avec le bouton global sa le fait
        bien, mais sa ne met pas a jour les checkbox des profils de
        chaque sautoniax") -- point d'entrée PUBLIC appelé par
        OrchestrateurActionsGlobalesInstances.sur_profils_recus_pour_
        selection (cf. son docstring) juste après avoir recalculé sa
        propre sélection globale pour `id_executant`. Jusqu'ici,
        l'orchestrateur gardait cet état "en silence" dans sa propre
        _profils_coches (keyée par id_executant), SANS jamais toucher à
        celle de CE panneau (_profils_coches, singulière -- un seul
        sAutoniax affiché à la fois) : les 2 restaient donc désynchro-
        nisées dès que le sAutoniax visé par un bouton global était
        aussi celui actuellement affiché ici, laissant les cases à
        l'écran dans leur ancien état malgré une action globale bel et
        bien appliquée côté réseau.

        Ignore tout appel concernant un AUTRE sAutoniax que celui
        actuellement affiché (même garde que sur_profils_recus) --
        cette méthode ne fait que RATTRAPER l'affichage quand il
        s'agit bien de ce sAutoniax-ci, jamais forcer un changement de
        sAutoniax affiché. Réutilise _reconstruire_table telle quelle
        (elle lit déjà _profils_coches, pas besoin d'une variante) : la
        seule différence avec un rafraîchissement normal est que
        l'ensemble coché vient d'ailleurs plutôt que d'un clic
        utilisateur sur une case."""
        if id_executant != self._id_executant_courant:
            return
        self._profils_coches = set(noms_coches) & set(self._profils.keys())
        self._reconstruire_table()

    # --- Bouton "Copier" en masse (spec A.2) -- même patron SÉQUENTIEL
    # EXACT que _lancer_generation_masse/_envoyer_prochaine_creation_masse/
    # _terminer_generation_masse ci-dessus, adapté à get_fingerprint via
    # self._requetes_copie_proprietes (réutilisé tel quel, cf. sa
    # docstring dans __init__ et _sur_clic_copier_proprietes_profil). ---

    def _sur_clic_copier_proprietes_masse(self):
        """AJOUT (spec A.2) -- déclenché par bouton_copier_proprietes_
        masse (grisé tant qu'aucun profil coché n'est actif, cf.
        _rafraichir_etat_boutons_masse) : construit la file des profils
        COCHÉS et ACTIFS (instance_id résolu UNE FOIS ici, cf. docstring
        de self._file_copie_masse dans __init__), compte au passage les
        cochés-mais-inactifs pour le message de bilan final, puis lance
        le lot séquentiel."""
        if self._id_executant_courant is None or not self._profils_coches:
            return
        file_a_traiter = []
        nb_ignores = 0
        for nom_profil in self._profils_coches:
            infos = self._profils.get(nom_profil)
            if infos is None:
                continue
            if not infos.get("actif"):
                nb_ignores += 1
                continue
            file_a_traiter.append((nom_profil, infos.get("instance_id", "")))
        if not file_a_traiter:
            self._afficher_statut_temporaire(
                "Aucun profil actif parmi les profils cochés -- rien à copier."
            )
            return
        self._file_copie_masse = file_a_traiter
        self._textes_copie_masse = {}
        self._nb_ignores_copie_masse = nb_ignores
        self._nb_echecs_copie_masse = 0
        self._nb_traites_copie_masse = 0
        self.bouton_copier_proprietes_masse.setEnabled(False)
        self.label_statut.setText(f"Récupération des propriétés... 0/{len(file_a_traiter)}")
        self._envoyer_prochaine_copie_masse()

    def _envoyer_prochaine_copie_masse(self):
        """Émet la requête get_fingerprint pour le PROCHAIN couple de la
        file -- celui-ci reste en tête de _file_copie_masse (pas retiré
        ici) tant que sa réponse réelle n'est pas revenue via
        sur_command_result_reseau (cf. _sur_resultat_copie_masse), même
        raisonnement EXACT que _envoyer_prochaine_creation_masse.

        Un instance_id vide (profil actif "orphelin" sans instance
        résolue, cf. docstring de _sur_clic_copier_proprietes_profil)
        est traité comme un échec immédiat pour CE profil précis --
        enchaîné directement sans aller-retour réseau voué à échouer."""
        if not self._file_copie_masse:
            self._terminer_copie_masse()
            return
        nom_profil, instance_id = self._file_copie_masse[0]
        if not instance_id:
            self._sur_resultat_copie_masse(nom_profil, False, "aucune instance active connue")
            return
        requete_id = uuid.uuid4().hex[:12]
        self._requetes_copie_proprietes[requete_id] = nom_profil
        self.demande_commande_instance_reseau.emit(
            self._id_executant_courant, instance_id, requete_id, {"action": "get_fingerprint"},
        )

    def _sur_resultat_copie_masse(self, nom_profil: str, ok: bool, resultat):
        """Appelée par sur_command_result_reseau (branche get_fingerprint)
        quand la réponse concerne le lot en masse en cours -- enchaîne
        automatiquement la copie suivante, succès ET échec confondus (un
        profil qui échoue ne doit jamais bloquer le reste du lot, même
        raisonnement que _sur_resultat_creation_masse).

        `resultat` : dict de propriétés si ok, sinon message d'erreur --
        formaté ici en texte "Profil : xxx\\n<props>" et stocké dans
        _textes_copie_masse (seuls les succès y sont ajoutés ; un échec
        ne produit pas de bloc de texte, juste compté dans le bilan
        final via self._nb_echecs_copie_masse, cf. _terminer_copie_masse).
        self._nb_traites_copie_masse : nombre total déjà traité (succès
        ET échecs) dans le lot EN COURS -- distinct de len(_textes_copie_
        masse) qui ne compte que les succès, pour que la progression
        affichée "faits/total" avance à chaque réponse, pas seulement à
        chaque succès."""
        if self._file_copie_masse and self._file_copie_masse[0][0] == nom_profil:
            self._file_copie_masse.pop(0)
        if ok:
            proprietes = resultat or {}
            texte = f"Profil : {nom_profil}\n" + "\n".join(
                f"{cle} : {valeur}" for cle, valeur in proprietes.items()
            )
            self._textes_copie_masse[nom_profil] = texte
        else:
            self._nb_echecs_copie_masse += 1
        self._nb_traites_copie_masse += 1
        total = self._nb_traites_copie_masse + len(self._file_copie_masse)
        self.label_statut.setText(f"Récupération des propriétés... {self._nb_traites_copie_masse}/{total}")
        self._envoyer_prochaine_copie_masse()

    def _terminer_copie_masse(self):
        """Concatène tous les textes accumulés en UN SEUL setText final
        (jamais un par profil, cf. décision explicite de la spec A.2) --
        séparateur : une ligne vide entre chaque profil, dans l'ordre
        d'achèvement des requêtes (pas nécessairement l'ordre de
        sélection initial, cf. réponses réseau asynchrones)."""
        textes = list(self._textes_copie_masse.values())
        nb_copies = len(textes)
        nb_ignores = self._nb_ignores_copie_masse
        nb_echecs = self._nb_echecs_copie_masse
        self._textes_copie_masse = {}
        self._nb_ignores_copie_masse = 0
        self._nb_echecs_copie_masse = 0
        self._nb_traites_copie_masse = 0
        self._rafraichir_etat_boutons_masse()
        if textes:
            QGuiApplication.clipboard().setText("\n\n".join(textes))
        details = []
        if nb_ignores:
            details.append(f"{nb_ignores} ignoré(s) (inactif(s))")
        if nb_echecs:
            details.append(f"{nb_echecs} échec(s)")
        if nb_copies and details:
            self._afficher_statut_temporaire(f"{nb_copies} profil(s) copié(s), {', '.join(details)}.")
        elif nb_copies:
            self._afficher_statut_temporaire(f"{nb_copies} profil(s) copié(s) dans le presse-papier.")
        elif details:
            self._afficher_statut_temporaire(f"Aucun profil copié -- {', '.join(details)}.")
        else:
            self._afficher_statut_temporaire("Aucun profil actif parmi les profils cochés -- rien à copier.")

    def _construire_widget_actions_profil(self, nom_profil: str, infos: dict) -> QWidget:
        """Un profil ACTIF propose Aperçu / Kill / Upload cloud. Un
        profil INACTIF propose Démarrer / Upload cloud (upload reste
        disponible même inactif : le dossier local existe indépendamment
        de l'exécution en cours, cf. envoyer_upload_profil_vers_cloud
        côté exécutant qui zippe le dossier tel quel).

        PATCH (demande explicite utilisateur, cf. docstring de
        self._profils_action_en_cours) : le bouton Démarrer/Kill de CE
        profil est désactivé tant qu'une action est en attente de
        résultat réel pour lui -- évite les clics répétés pendant les
        5-13s d'aller-retour réseau observés pour un démarrage complet."""
        conteneur = QWidget()
        ligne = QHBoxLayout(conteneur)
        ligne.setContentsMargins(4, 2, 4, 2)
        ligne.setSpacing(4)
        actif = bool(infos.get("actif"))
        id_executant = self._id_executant_courant
        en_cours = nom_profil in self._profils_action_en_cours

        if actif:
            bouton_apercu = QToolButton(conteneur)
            bouton_apercu.setIcon(qta.icon("mdi6.eye-outline", color=Mocha.blue))
            bouton_apercu.setToolTip("Aperçu -- voir l'écran de cette instance en direct.")
            bouton_apercu.setAutoRaise(True)
            instance_id = infos.get("instance_id", "")
            bouton_apercu.clicked.connect(
                lambda: self._sur_clic_apercu(nom_profil, instance_id)
            )
            ligne.addWidget(bouton_apercu)

            bouton_kill = QToolButton(conteneur)
            bouton_kill.setIcon(qta.icon("mdi6.stop-circle-outline", color=Mocha.red))
            bouton_kill.setToolTip("Arrêt demandé, en attente de confirmation..." if en_cours else "Arrêter ce profil précis.")
            bouton_kill.setAutoRaise(True)
            bouton_kill.setEnabled(not en_cours)
            bouton_kill.clicked.connect(
                lambda: self._sur_clic_kill_profil(id_executant, nom_profil)
            )
            ligne.addWidget(bouton_kill)

            # PATCH (bouton "copier les propriétés" -- cf. docstring de
            # self._requetes_copie_proprietes) : UNIQUEMENT sur un profil
            # ACTIF -- le fingerprint (résolution d'écran, User-Agent,
            # WebGL...) est lu sur disque par le serveur local embarqué de
            # l'instance elle-même (cf. _camoufox_extraire_proprietes_
            # fingerprint côté sAutoniax), donc rien à lire tant qu'aucune
            # instance ne tourne pour ce profil -- même contrainte EXACTE
            # que l'onglet Propriétés local (ProfilsInstancesScreen),
            # cf. _demander_proprietes_fingerprint : "Sélectionnez une
            # instance active pour voir ses propriétés."
            en_cours_copie = nom_profil in self._requetes_copie_proprietes.values()
            bouton_copier = QToolButton(conteneur)
            bouton_copier.setIcon(qta.icon("mdi6.content-copy", color=Mocha.yellow))
            bouton_copier.setToolTip(
                "Récupération des propriétés..." if en_cours_copie
                else "Copier les propriétés (résolution d'écran, OS, User-Agent, WebGL...) de cette instance."
            )
            bouton_copier.setAutoRaise(True)
            bouton_copier.setEnabled(not en_cours_copie)
            instance_id_copie = infos.get("instance_id", "")
            bouton_copier.clicked.connect(
                lambda: self._sur_clic_copier_proprietes_profil(id_executant, nom_profil, instance_id_copie)
            )
            ligne.addWidget(bouton_copier)
        else:
            bouton_demarrer = QToolButton(conteneur)
            bouton_demarrer.setIcon(qta.icon("mdi6.play-circle-outline", color=Mocha.green))
            bouton_demarrer.setToolTip("Démarrage en cours..." if en_cours else "Démarrer ce profil (hors ProjetBatch).")
            bouton_demarrer.setAutoRaise(True)
            bouton_demarrer.setEnabled(not en_cours)
            bouton_demarrer.clicked.connect(
                lambda: self._sur_clic_demarrer_profil(id_executant, nom_profil)
            )
            ligne.addWidget(bouton_demarrer)

        bouton_upload = QToolButton(conteneur)
        bouton_upload.setIcon(qta.icon("mdi6.cloud-upload-outline", color=Mocha.mauve))
        bouton_upload.setToolTip("Mettre à jour ce profil vers le cloud.")
        bouton_upload.setAutoRaise(True)
        bouton_upload.clicked.connect(
            lambda: self._sur_clic_upload_profil_cloud(id_executant, nom_profil)
        )
        ligne.addWidget(bouton_upload)

        bouton_telecharger = QToolButton(conteneur)
        bouton_telecharger.setIcon(qta.icon("mdi6.cloud-download-outline", color=Mocha.teal))
        bouton_telecharger.setToolTip("Retélécharger ce profil depuis le cloud (écrase la version locale).")
        bouton_telecharger.setAutoRaise(True)
        bouton_telecharger.clicked.connect(
            lambda: self.demande_telecharger_profil_cloud.emit(id_executant, nom_profil)
        )
        ligne.addWidget(bouton_telecharger)

        # PATCH (bouton "Renommer" -- demande explicite utilisateur : "on
        # puisse renommer un profil qui est sur un sautoniax (on le
        # renomme quand il est fermé, pas en cours)") -- visible
        # UNIQUEMENT quand `actif` est False, contrairement à Upload/
        # Télécharger ci-dessus qui restent disponibles dans les deux
        # cas : renommer un profil actif désynchroniserait son
        # instance_id déjà en cours du nouveau nom affiché, même risque
        # exact que documenté sur renommer_profil() (registre local côté
        # pilote) -- ici la garantie est en plus RÉELLEMENT appliquée
        # côté exécutant (cf. _sur_renommer_profil_sautoniax_demande),
        # ce bouton n'est qu'une première ligne de défense côté UI.
        if not actif:
            renommage_en_cours = nom_profil in self._profils_renommage_en_cours
            bouton_renommer = QToolButton(conteneur)
            bouton_renommer.setIcon(qta.icon("mdi6.rename-box", color=Mocha.sky))
            bouton_renommer.setToolTip("Renommage en cours..." if renommage_en_cours else "Renommer ce profil.")
            bouton_renommer.setAutoRaise(True)
            bouton_renommer.setEnabled(not renommage_en_cours)
            bouton_renommer.clicked.connect(
                lambda: self._sur_clic_renommer_profil_sautoniax(id_executant, nom_profil)
            )
            ligne.addWidget(bouton_renommer)

        # PATCH (SPEC_proxy_natif_tunnel.md, section 13.6 -- toggle
        # "Proxy natif" par profil) : UN SEUL QToolButton checkable,
        # visible que le profil soit actif ou inactif (contrairement à
        # Aperçu/Kill/Démarrer ci-dessus qui dépendent de `actif`),
        # placé juste avant addStretch(1) comme convenu. Pas de texte,
        # pas de badge séparé -- l'état se lit uniquement à la couleur
        # de l'icône (cf. 13.6 : gris/atténué = éteint, Mocha.lavender
        # = allumé -- choix tranché par l'utilisateur pour rester
        # distinct de toutes les autres couleurs déjà prises sur cette
        # ligne, y compris Mocha.green qui reste réservé à Démarrer).
        # setEnabled(not actif) : cf. 13.5, décision tranchée --
        # interdit de changer le proxy natif tant que le profil tourne
        # (un --proxy-server ne peut pas être modifié à chaud sur un
        # navigateur déjà lancé), avec tooltip explicite dans ce cas.
        proxy_natif_actif = bool(infos.get("proxy_natif"))
        en_cours_toggle = nom_profil in self._profils_toggle_proxy_natif_en_cours
        bouton_proxy_natif = QToolButton(conteneur)
        bouton_proxy_natif.setCheckable(True)
        bouton_proxy_natif.setChecked(proxy_natif_actif)
        bouton_proxy_natif.setIcon(
            qta.icon("mdi6.lan-connect", color=(Mocha.lavender if proxy_natif_actif else Mocha.overlay0))
        )
        bouton_proxy_natif.setAutoRaise(True)
        if actif:
            bouton_proxy_natif.setEnabled(False)
            bouton_proxy_natif.setToolTip("Arrêtez le profil avant de changer le proxy natif.")
        else:
            bouton_proxy_natif.setEnabled(not en_cours_toggle)
            bouton_proxy_natif.setToolTip(
                "Changement en cours..." if en_cours_toggle
                else ("Proxy natif activé -- ce profil sort via l'IP du mAutoniaX."
                      if proxy_natif_actif else
                      "Proxy natif désactivé -- clic pour activer.")
            )
        bouton_proxy_natif.clicked.connect(
            lambda: self._sur_clic_toggle_proxy_natif(id_executant, nom_profil, not proxy_natif_actif)
        )
        ligne.addWidget(bouton_proxy_natif)

        # PATCH sortie de logs par profil : activer/couper la sortie d'exécution de CE
        # profil (profil actif uniquement : il faut une instance à commander).
        instance_id_logs = infos.get("instance_id", "")
        logs_coupes = instance_id_logs not in _INSTANCES_LOGS_ACTIVES_PILOTE  # coupée par défaut
        logs_en_cours = any(iid == instance_id_logs for iid, _c in self._requetes_logs_profil.values())
        bouton_logs = QToolButton(conteneur)
        bouton_logs.setAutoRaise(True)
        bouton_logs.setIcon(qta.icon(
            "mdi6.text-box-remove-outline" if logs_coupes else "mdi6.text-box-check-outline",
            color=(Mocha.overlay0 if logs_coupes else Mocha.sapphire),
        ))
        if not (actif and instance_id_logs):
            bouton_logs.setEnabled(False)
            bouton_logs.setToolTip("Sortie de logs : disponible quand le profil est démarré.")
        else:
            bouton_logs.setEnabled(not logs_en_cours)
            bouton_logs.setToolTip(
                "Changement en cours..." if logs_en_cours
                else ("Sortie de logs COUPÉE (défaut) -- clic pour l'activer pour ce profil."
                      if logs_coupes else "Sortie de logs active pour ce profil -- clic pour la couper.")
            )
            bouton_logs.clicked.connect(
                lambda: self._sur_clic_toggle_logs_profil(id_executant, nom_profil, instance_id_logs, not logs_coupes)
            )
        if actif and instance_id_logs:
            bouton_logs.setToolTip(bouton_logs.toolTip() + "\nClic droit : copier les dernières lignes du journal de ce profil.")
            bouton_logs.setContextMenuPolicy(Qt.CustomContextMenu)
            bouton_logs.customContextMenuRequested.connect(
                lambda _pos: self._sur_clic_droit_journal_profil(id_executant, nom_profil, instance_id_logs)
            )
        ligne.addWidget(bouton_logs)

        # PATCH DIAGNOSTIC -- bouton "copier les logs de démarrage" : copie EXACTEMENT le dernier bloc
        # [PROFIL-DEMARRAGE] (+ [PROFIL-RESTAURATION] qui le précède) du journal autoniax_diag.log du profil.
        # Disponible profil actif OU inactif (le fichier est sur disque chez l'exécutant).
        instance_id_diag = infos.get("instance_id", "") or ""
        en_cours_diag = nom_profil in self._requetes_diag_demarrage.values()
        bouton_diag = QToolButton(conteneur)
        bouton_diag.setAutoRaise(True)
        bouton_diag.setIcon(qta.icon("mdi6.clipboard-text-clock-outline", color=Mocha.peach))
        bouton_diag.setEnabled(not en_cours_diag)
        bouton_diag.setToolTip(
            "Récupération..." if en_cours_diag
            else "Copier le RAPPORT COMPLET de ce profil (arborescence, fingerprint, xulstore/prefs, cookies, dernier démarrage) pour comparer deux copies."
        )
        bouton_diag.clicked.connect(
            lambda: self._sur_clic_copier_diag_demarrage(id_executant, nom_profil, instance_id_diag)
        )
        ligne.addWidget(bouton_diag)

        ligne.addStretch(1)
        return conteneur

    def _sur_clic_copier_diag_demarrage(self, id_executant: str, nom_profil: str, instance_id: str):
        """Demande à l'exécutant (action get_diag_demarrage) le dernier bloc de démarrage de ce profil ;
        la réponse revient par sur_command_result_reseau (filtrée par requete_id)."""
        requete_id = uuid.uuid4().hex[:12]
        self._requetes_diag_demarrage[requete_id] = nom_profil
        self._afficher_statut_temporaire(f"Récupération des logs de démarrage de '{nom_profil}'...")
        self.demande_commande_instance_reseau.emit(
            id_executant, instance_id or "-", requete_id,
            {"action": "get_diag_demarrage", "nom_profil": nom_profil},
        )

    # --- Émission des actions Démarrer/Kill (marquage "en cours" avant
    # envoi -- cf. docstring de self._profils_action_en_cours) ---

    def _sur_clic_demarrer_profil(self, id_executant: str, nom_profil: str):
        self._profils_action_en_cours.add(nom_profil)
        self._reconstruire_table()
        self.demande_demarrer_profil.emit(id_executant, nom_profil)

    def _sur_clic_kill_profil(self, id_executant: str, nom_profil: str):
        self._profils_action_en_cours.add(nom_profil)
        self._reconstruire_table()
        self.demande_kill_profil.emit(id_executant, nom_profil)

    def _sur_clic_toggle_proxy_natif(self, id_executant: str, nom_profil: str, actif_demande: bool):
        # PATCH (SPEC_proxy_natif_tunnel.md, section 13.6) -- même
        # patron EXACT que _sur_clic_kill_profil ci-dessus : marquage
        # "en cours" AVANT l'émission (désactive le bouton immédiatement
        # via en_cours_toggle dans _construire_widget_actions_profil),
        # réactivé par sur_resultat_toggle_proxy_natif ci-dessous (succès
        # ET échec) ou par le prochain _reconstruire_table déclenché par
        # un rafraîchissement. Pas de mise à jour optimiste de l'état
        # `proxy_natif` lui-même (contrairement au bouton, dont l'icône
        # ne change de couleur qu'après confirmation réelle) -- seul le
        # champ "en cours" change ici, cf. décision 13.5/13.6 : le
        # sAutoniax peut refuser (profil devenu actif entre-temps).
        self._profils_toggle_proxy_natif_en_cours.add(nom_profil)
        self._reconstruire_table()
        self.demande_toggle_proxy_natif.emit(id_executant, nom_profil, actif_demande)

    def _sur_clic_renommer_profil_sautoniax(self, id_executant: str, nom_profil: str):
        """PATCH (bouton "Renommer" -- demande explicite utilisateur :
        "on puisse renommer un profil qui est sur un sautoniax (on le
        renomme quand il est fermé, pas en cours)"). Même dialogue EXACT
        que ProfilsInstancesScreen._on_clic_renommer_profil (renommage
        LOCAL déjà existant, cf. BoiteDialogueAutoniaX.saisie_texte) --
        mais ici le renommage réel se fait à DISTANCE sur l'exécutant,
        via demande_renommer_profil_sautoniax (aller-retour réseau, cf.
        sur_resultat_renommer_profil_sautoniax pour le résultat).

        Vérifications faites ICI (avant tout aller-retour réseau) :
        nom vide/inchangé (abandon silencieux, rien à faire), nom déjà
        pris par un AUTRE profil connu de CE sAutoniax (self._profils,
        déjà à jour depuis le dernier scan/rafraîchissement -- évite un
        aller-retour voué à l'échec dans le cas courant, mais l'exécutant
        revalide quand même de son côté, cf. _sur_renommer_profil_
        sautoniax_demande, au cas où l'état aurait changé entre-temps).
        PAS de vérification "profil actif" ici : le bouton n'est déjà
        construit que pour un profil inactif (cf. `if not actif:` dans
        _construire_widget_actions_profil), et l'exécutant revalide de
        toute façon lui-même en dernier ressort."""
        nouveau_nom, ok = BoiteDialogueAutoniaX.saisie_texte(
            self, "Renommer le profil", "Nouveau nom :", QLineEdit.EchoMode.Normal, nom_profil,
        )
        if not ok:
            return
        nouveau_nom = nouveau_nom.strip()
        if not nouveau_nom or nouveau_nom == nom_profil:
            return
        if nouveau_nom in self._profils:
            self._afficher_statut_temporaire(f"Le profil '{nouveau_nom}' existe déjà sur ce sAutoniax.")
            return

        self._profils_renommage_en_cours.add(nom_profil)
        self._reconstruire_table()
        self.demande_renommer_profil_sautoniax.emit(id_executant, nom_profil, nouveau_nom)

    def _sur_clic_copier_proprietes_profil(self, id_executant: str, nom_profil: str, instance_id: str):
        """PATCH (bouton "copier les propriétés" -- cf. docstring de
        self._requetes_copie_proprietes) : envoie "get_fingerprint" à
        l'instance ciblée via demande_commande_instance_reseau (même
        signal EXACT que l'aperçu réseau, cf. docstring de classe et
        câblage MainWindow -> ClientServeurT.envoyer_commande_instance).
        Le résultat réel revient de façon asynchrone via "command_result"
        -> sur_command_result_reseau ci-dessous, filtré par requete_id.

        Si instance_id est vide (ne devrait pas arriver pour un profil
        actif, cf. condition `if actif:` dans _construire_widget_actions_
        profil -- mais un profil peut en théorie apparaître actif dans
        `infos` sans instance_id résolu, cf. commentaire de _reconstruire_
        table sur les profils actifs "orphelins" de scan local) : abandon
        immédiat avec message explicite plutôt qu'un aller-retour réseau
        voué à échouer côté sAutoniax (aucune instance à interroger)."""
        if not instance_id:
            self._afficher_statut_temporaire(
                f"Impossible de copier les propriétés de '{nom_profil}' : aucune instance active connue."
            )
            return
        requete_id = uuid.uuid4().hex[:12]
        self._requetes_copie_proprietes[requete_id] = nom_profil
        self._reconstruire_table()  # désactive le bouton le temps de l'attente (cf. en_cours_copie)
        self.label_statut.setText(f"Récupération des propriétés de '{nom_profil}'...")
        self.demande_commande_instance_reseau.emit(
            id_executant, instance_id, requete_id, {"action": "get_fingerprint"},
        )

    def _sur_clic_droit_journal_profil(self, id_executant: str, nom_profil: str, instance_id: str):
        """PATCH journal par profil : clic droit sur le bouton de logs -> demande au sAutoniax les
        N dernières lignes du journal de ce profil (N = réglage Paramètres, 100 par défaut)."""
        try:
            nombre = int(ReglagesApp.load().lignes_copie_journal_profil)
        except Exception:
            nombre = 100
        requete_id = uuid.uuid4().hex[:12]
        self._requetes_journal_profil[requete_id] = (nom_profil, nombre)
        self._afficher_statut_temporaire(f"Récupération des {nombre} dernières lignes du journal de '{nom_profil}'...")
        self.demande_commande_instance_reseau.emit(
            id_executant, instance_id, requete_id, {"action": "get_journal_profil", "lignes": nombre},
        )

    def _sur_clic_toggle_logs_profil(self, id_executant: str, nom_profil: str, instance_id: str, couper: bool):
        """PATCH sortie de logs par profil : envoie set_sortie_logs à l'instance via le
        canal commande_instance (relayé tel quel par serveur.py). Le résultat revient par
        sur_command_result_reseau, filtré par requete_id."""
        if not instance_id:
            self._afficher_statut_temporaire(f"Impossible : aucune instance active connue pour '{nom_profil}'.")
            return
        requete_id = uuid.uuid4().hex[:12]
        self._requetes_logs_profil[requete_id] = (instance_id, couper)
        self._reconstruire_table()  # désactive le bouton le temps de l'attente
        self.demande_commande_instance_reseau.emit(
            id_executant, instance_id, requete_id, {"action": "set_sortie_logs", "coupee": couper},
        )

    # --- Résultats d'actions (affichage statut + rafraîchissement table) ---

    def sur_resultat_kill_profil(self, id_executant: str, nom_profil: str, ok: bool, message: str):
        if id_executant != self._id_executant_courant:
            return
        self._profils_action_en_cours.discard(nom_profil)
        self._afficher_statut_temporaire(
            f"Profil '{nom_profil}' arrêté." if ok else f"Échec de l'arrêt de '{nom_profil}' : {message}"
        )
        # PATCH (demande explicite utilisateur : "quand j'ai essayé de
        # tuer un profil la première fois ça a bien dit que ça a été
        # détruit mais le widget ne s'est pas mis à jour") -- même
        # patron que sur_resultat_demarrer_profil ci-dessous : synchronise
        # l'état local ET reconstruit la table immédiatement, plutôt que
        # d'attendre un rafraîchissement manuel pour refléter l'arrêt
        # réel confirmé par le sAutoniax.
        if ok and nom_profil in self._profils:
            self._profils[nom_profil]["actif"] = False
            self._profils[nom_profil]["instance_id"] = ""
        self._reconstruire_table()

    def sur_resultat_demarrer_profil(self, id_executant: str, nom_profil: str, ok: bool, instance_id: str, message: str):
        if id_executant != self._id_executant_courant:
            return
        self._profils_action_en_cours.discard(nom_profil)
        if ok:
            self._afficher_statut_temporaire(f"Profil '{nom_profil}' démarré.")
            if nom_profil in self._profils:
                self._profils[nom_profil]["actif"] = True
                self._profils[nom_profil]["instance_id"] = instance_id
        else:
            self._afficher_statut_temporaire(f"Échec du démarrage de '{nom_profil}' : {message}")
        self._reconstruire_table()

    def sur_resultat_toggle_proxy_natif(self, ok: bool, id_executant: str, nom_profil: str, actif: bool, message: str):
        # PATCH (SPEC_proxy_natif_tunnel.md, section 13.3/13.6) -- même
        # patron EXACT que sur_resultat_demarrer_profil ci-dessus, ET
        # même ORDRE de paramètres EXACT que le signal ClientServeurT.
        # toggle_proxy_natif_resultat_recu = Signal(bool, str, str,
        # bool, str) -- (ok, id_executant, nom_profil, actif, message)
        # -- pour permettre une connexion DIRECTE sans lambda (cf.
        # câblage MainWindow), contrairement à demander_toggle_proxy_
        # natif_resultat (ack en échec seulement) qui n'a pas de champ
        # `actif` et passe donc par un petit lambda avec actif=False en
        # dur (sans effet puisque ok=False dans ce cas -- rien n'est
        # synchronisé, cf. plus bas).
        #
        # Appelé à la fois pour l'échec précoce (ack ok=False côté
        # ClientServeurT.demander_toggle_proxy_natif_resultat -- pilote
        # non connecté, exécutant introuvable...) ET pour le résultat
        # RÉEL diffusé par le sAutoniax (toggle_proxy_natif_resultat_
        # recu -- accepté ou refusé selon 13.5, cf. câblage MainWindow).
        # Si ok : synchronise self._profils[nom_profil]["proxy_natif"]
        # sur l'état réel confirmé. Si échec (ex. profil actif entre-
        # temps) : rien à synchroniser, _reconstruire_table ci-dessous
        # suffit à annuler tout effet optimiste puisque le bouton lit
        # bool(infos.get("proxy_natif")) -- jamais modifié ici en cas
        # d'échec, donc revient à son état d'avant clic tel quel.
        if id_executant != self._id_executant_courant:
            return
        self._profils_toggle_proxy_natif_en_cours.discard(nom_profil)
        if ok:
            self._afficher_statut_temporaire(
                f"Proxy natif {'activé' if actif else 'désactivé'} pour '{nom_profil}'."
            )
            if nom_profil in self._profils:
                self._profils[nom_profil]["proxy_natif"] = actif
        else:
            self._afficher_statut_temporaire(f"Échec du changement de proxy natif pour '{nom_profil}' : {message}")
        self._reconstruire_table()

    def _sur_clic_upload_profil_cloud(self, id_executant: str, nom_profil: str):
        """AJOUT (demande explicite utilisateur : \"juste un logs simple qui dit
        encoie en cours, envoie envoyer avec sucess\") -- pas de boîte de
        dialogue : affiche seulement un message de statut « en cours »,
        puis émet la demande d'upload (le résultat final remplace ce message,
        cf. sur_resultat_upload_profil_cloud)."""
        self._afficher_statut_temporaire(f"Envoi de '{nom_profil}' en cours...")
        self.demande_upload_profil_cloud.emit(id_executant, nom_profil)

    def sur_resultat_upload_profil_cloud(self, ok: bool, id_executant: str, nom_profil: str, taille_octets: int, message: str):
        if id_executant != self._id_executant_courant:
            return
        if ok:
            self._afficher_statut_temporaire(f"'{nom_profil}' envoyé avec succès.")
        else:
            self._afficher_statut_temporaire(f"Échec de l'envoi de '{nom_profil}' : {message}")

    def sur_resultat_renommer_profil_sautoniax(self, ok: bool, id_executant: str, ancien_nom: str, nouveau_nom: str, message: str):
        # PATCH (bouton "Renommer") -- même patron EXACT que
        # sur_resultat_kill_profil/sur_resultat_toggle_proxy_natif :
        # filtre par sélection courante, retire du set "en cours", puis
        # synchronise self._profils sur succès (remplace la clé --
        # l'entrée `infos` associée est conservée telle quelle, seul le
        # NOM change) avant de reconstruire la table.
        if id_executant != self._id_executant_courant:
            return
        self._profils_renommage_en_cours.discard(ancien_nom)
        if ok:
            self._afficher_statut_temporaire(f"Profil '{ancien_nom}' renommé en '{nouveau_nom}'.")
            if ancien_nom in self._profils:
                infos = self._profils.pop(ancien_nom)
                infos["nom"] = nouveau_nom
                self._profils[nouveau_nom] = infos
            # Migre aussi la coche éventuelle (spec A.1, self._profils_
            # coches) -- sinon une case cochée sur l'ancien nom disparaît
            # silencieusement après renommage (nom_profil not in
            # self._profils_coches lors du prochain rendu).
            if ancien_nom in self._profils_coches:
                self._profils_coches.discard(ancien_nom)
                self._profils_coches.add(nouveau_nom)
        else:
            self._afficher_statut_temporaire(f"Échec du renommage de '{ancien_nom}' : {message}")
        self._reconstruire_table()

    def sur_resultat_telecharger_profil_cloud(self, id_executant: str, nom_profil: str, ok: bool, message: str):
        if id_executant != self._id_executant_courant:
            return
        self._afficher_statut_temporaire(
            f"Profil '{nom_profil}' retéléchargé depuis le cloud." if ok
            else f"Échec du téléchargement de '{nom_profil}' : {message}"
        )

    # --- Aperçu réseau (FenetreRenduTaskReseau, même patron EXACT que
    # ProjetsDistribuesScreen._sur_clic_apercu_execution) ---

    def _sur_clic_apercu(self, nom_profil: str, instance_id: str):
        if not instance_id:
            self._afficher_statut_temporaire(f"Aperçu indisponible pour '{nom_profil}' -- aucune instance active.")
            return
        id_executant = self._id_executant_courant
        log_reseau_t.info(
            f"[DIAG clic apercu #1] self_id={id(self)} nom_profil={nom_profil!r} "
            f"id_executant={id_executant!r} instance_id={instance_id!r} "
            f"-- fixation de _rendu_reseau_cible sur cet objet."
        )

        if self._fenetre_rendu_reseau is None:
            self._fenetre_rendu_reseau = FenetreRenduTaskReseau(self)
            self._fenetre_rendu_reseau.fermeture_demandee.connect(self._sur_fermeture_rendu_reseau)
            self._fenetre_rendu_reseau.demande_rafraichissement.connect(
                self._sur_demande_rafraichissement_rendu_reseau
            )
            self._fenetre_rendu_reseau.taux_capture_change.connect(self._sur_taux_capture_reseau_change)
            self._fenetre_rendu_reseau.panneau.definir_reglages_capture_reseau_visibles(True)
            self._fenetre_rendu_reseau.panneau.definir_infos_profil_visibles(True)
            self._fenetre_rendu_reseau.panneau.demande_preference_capture.connect(
                self.demande_preference_capture_reseau.emit
            )

            def _sur_commande_controle_distance(payload: dict):
                if self._rendu_reseau_cible is None:
                    return
                id_exec_cible, instance_id_cible, _nom_cible = self._rendu_reseau_cible
                self.demande_commande_instance_reseau.emit(
                    id_exec_cible, instance_id_cible, payload["requete_id"], payload["commande"],
                )

            self._fenetre_rendu_reseau.commande_controle_distance.connect(_sur_commande_controle_distance)

            # PATCH (liste déroulante d'onglet actif, cf. panneau.
            # bande_onglet.setVisible(True) dans FenetreRenduTaskReseau.
            # __init__) -- même protocole/même raisonnement que
            # TaskConfigScreen (cf. son propre câblage "Onglet navigateur
            # distant"), adapté ici : PAS de self._client_serveur_t direct
            # dans ce Screen (cf. docstring de classe, "les écrans réseau
            # ne font que relayer") -- demande_commande_instance_reseau.emit
            # comme les autres commandes de contrôle ci-dessus, et
            # réception du résultat via sur_command_result_reseau
            # (nouveau slot public, câblé par MainWindow sur
            # ClientServeurT.command_result_recu, même patron que les
            # autres sur_resultat_xxx de cette classe).
            self._requete_id_liste_onglets_reseau: Optional[str] = None
            self._requete_id_switch_onglet_reseau: Optional[str] = None

            def _demander_liste_onglets_reseau():
                if self._rendu_reseau_cible is None:
                    return
                id_exec_cible, instance_id_cible, _nom_cible = self._rendu_reseau_cible
                requete_id = uuid.uuid4().hex[:12]
                self._requete_id_liste_onglets_reseau = requete_id
                self._fenetre_rendu_reseau.panneau.label_statut_onglets.definir_texte("Récupération des onglets…")
                self._fenetre_rendu_reseau.panneau.label_statut_onglets.setStyleSheet(f"color: {Mocha.subtext0}; font-size: 11px;")
                self.demande_commande_instance_reseau.emit(
                    id_exec_cible, instance_id_cible, requete_id, {"action": "listTabs"},
                )

            def _sur_onglet_reseau_change(_index: int):
                combo = self._fenetre_rendu_reseau.panneau.onglet_combo
                tab_id = combo.currentData()
                if tab_id is None or self._rendu_reseau_cible is None:
                    return
                id_exec_cible, instance_id_cible, _nom_cible = self._rendu_reseau_cible
                requete_id = uuid.uuid4().hex[:12]
                self._requete_id_switch_onglet_reseau = requete_id
                self.demande_commande_instance_reseau.emit(
                    id_exec_cible, instance_id_cible, requete_id, {"action": "switchTab", "tabId": tab_id},
                )

            self._fenetre_rendu_reseau.panneau.onglet_combo.currentIndexChanged.connect(_sur_onglet_reseau_change)
            self._fenetre_rendu_reseau.panneau.onglet_combo.popup_ouvert.connect(_demander_liste_onglets_reseau)
            self._fenetre_rendu_reseau.panneau.rafraichir_onglets_button.clicked.connect(_demander_liste_onglets_reseau)
            self._fenetre_rendu_reseau.panneau.onglet_combo.setEnabled(True)
            self._fenetre_rendu_reseau.panneau.rafraichir_onglets_button.setEnabled(True)
            self._demander_liste_onglets_reseau_interne = _demander_liste_onglets_reseau

        self._rendu_reseau_cible = (id_executant, instance_id, nom_profil)
        self._fenetre_rendu_reseau.titre_label.setText(
            f"Aperçu : {nom_profil} ({self._nom_executant_courant or id_executant})"
        )
        config_profil = obtenir_config_profil(nom_profil)
        self._fenetre_rendu_reseau.panneau.definir_infos_profil(
            nom_profil, config_profil.get("proxy"), config_profil.get("pays")
        )
        self._fenetre_rendu_reseau.definir_image(None)
        self.demande_capture_ponctuelle_instance_reseau.emit(id_executant, instance_id)
        self._fenetre_rendu_reseau.afficher_par_dessus_tout()

    def _sur_fermeture_rendu_reseau(self):
        log_reseau_t.info(
            f"[DIAG fermeture apercu #1] self_id={id(self)} -- _rendu_reseau_cible remis à None "
            f"(ancienne valeur={self._rendu_reseau_cible!r})"
        )
        self._rendu_reseau_cible = None

    def _sur_demande_rafraichissement_rendu_reseau(self):
        if self._rendu_reseau_cible is None:
            return
        id_executant, instance_id, _nom_profil = self._rendu_reseau_cible
        self.demande_capture_ponctuelle_instance_reseau.emit(id_executant, instance_id)

    def _sur_taux_capture_reseau_change(self, fps: float):
        if self._rendu_reseau_cible is None:
            return
        id_executant, instance_id, _nom_profil = self._rendu_reseau_cible
        self.demande_taux_capture_instance_reseau.emit(id_executant, instance_id, fps)

    def id_executant_cible_apercu(self) -> str:
        """Expose l'id_executant actuellement ciblé par l'aperçu ouvert
        (ou "" si aucun) -- pour MainWindow, qui doit résoudre l'id_
        executant CIBLE avant de relayer regler_capture_instance_echec
        (protocole indexé par instance_id seul, cf. sa déclaration) sans
        avoir à lire l'état interne de ce panneau directement."""
        return self._rendu_reseau_cible[0] if self._rendu_reseau_cible else ""

    def sur_capture_reseau_recue(self, id_executant: str, _nom_executant: str, instance_id: str, image_b64: str):
        """Connecté par MainWindow à ClientServeurT.capture_recue (même
        signal source EXACT que ProjetsDistribuesScreen.sur_capture_
        reseau_recue, cf. sa docstring) -- affiche l'image UNIQUEMENT si
        elle concerne l'aperçu actuellement ouvert par ce panneau."""
        if self._fenetre_rendu_reseau is None or self._rendu_reseau_cible is None:
            log_reseau_t.info(
                f"[DIAG capture rendu direct #1] self_id={id(self)} capture_recue ignorée -- "
                f"fenetre_ouverte={self._fenetre_rendu_reseau is not None}, "
                f"cible_definie={self._rendu_reseau_cible is not None} "
                f"(recu id_executant={id_executant!r}, instance_id={instance_id!r})"
            )
            return
        id_exec_cible, instance_id_cible, _nom = self._rendu_reseau_cible
        log_reseau_t.info(
            f"[DIAG capture rendu direct #1] recu id_executant={id_executant!r} instance_id={instance_id!r} "
            f"vs cible id_exec_cible={id_exec_cible!r} instance_id_cible={instance_id_cible!r} "
            f"-> match={id_executant == id_exec_cible and instance_id == instance_id_cible}"
        )
        if id_executant == id_exec_cible and instance_id == instance_id_cible:
            self._fenetre_rendu_reseau.definir_image(image_b64)

    def sur_echec_reglage_capture_reseau(self, id_executant: str, message: str):
        """Connecté par MainWindow à ClientServeurT.regler_capture_
        instance_echec (même patron EXACT que ProjetsDistribuesScreen --
        échec de TRANSMISSION d'une demande de capture/taux, filtré par
        id_executant CIBLE actuellement mémorisé pour ce panneau)."""
        if self._rendu_reseau_cible is None or self._fenetre_rendu_reseau is None:
            return
        id_exec_cible, _instance_id_cible, _nom = self._rendu_reseau_cible
        if id_executant == id_exec_cible:
            self._afficher_statut_temporaire(f"Échec du réglage de capture : {message}")

    def sur_command_result_reseau(self, data: dict):
        """PATCH (liste déroulante d'onglet actif) -- connecté par
        MainWindow à ClientServeurT.command_result_recu (signal GLOBAL,
        tous les command_result confondus, cf. sa docstring). Filtre sur
        les requete_id des commandes listTabs/switchTab émises par
        _demander_liste_onglets_reseau/_sur_onglet_reseau_change (cf.
        _sur_clic_apercu ci-dessus), ignore tout le reste -- même
        patron EXACT que PanneauRenduInstance._sur_command_result_onglet
        (protocole local), adapté au protocole réseau.

        PATCH (bouton "copier les propriétés" -- cf. docstring de self.
        _requetes_copie_proprietes) : branche get_fingerprint traitée EN
        PREMIER, AVANT le early-return sur self._fenetre_rendu_reseau
        ci-dessous -- contrairement à listTabs/switchTab (qui n'ont de
        sens que si un aperçu réseau est ouvert), copier les propriétés
        est une action indépendante déclenchée directement depuis la
        table des profils, jamais depuis la fenêtre d'aperçu : filtrer
        sur _fenetre_rendu_reseau avant de la traiter la laisserait
        silencieusement sans effet tant qu'aucun aperçu n'est ouvert.

        AJOUT (spec A.2) -- une requête de self._requetes_copie_
        proprietes peut désormais venir SOIT d'une copie unitaire par
        ligne (_sur_clic_copier_proprietes_profil), SOIT du lot en masse
        (_envoyer_prochaine_copie_masse) : distinguée en vérifiant si ce
        nom_profil est bien celui actuellement attendu en tête de
        _file_copie_masse -- un lot en masse ne peut avoir qu'une seule
        requête en vol à la fois (séquentiel), donc cette vérification
        est sans ambiguïté."""
        _fen_copie = getattr(self, "_fenetre_rendu_reseau", None)
        if _fen_copie is not None and _fen_copie.traiter_resultat_copie_distante(data):
            return  # PATCH Ctrl+C : réponse traitée
        requete_id = data.get("requete_id")
        if requete_id in self._requetes_diag_demarrage:  # PATCH DIAGNOSTIC logs de démarrage
            nom_diag = self._requetes_diag_demarrage.pop(requete_id)
            if not data.get("ok", False):
                self._afficher_statut_temporaire(
                    f"Échec de la copie des logs de démarrage de '{nom_diag}' : {data.get('error', 'erreur inconnue')}"
                )
                return
            lignes_diag = (data.get("result") or {}).get("lignes") or []
            if not lignes_diag:
                self._afficher_statut_temporaire(
                    f"Profil '{nom_diag}' introuvable sur la machine exécutante : rien à copier."
                )
                return
            QGuiApplication.clipboard().setText("\n".join(str(l) for l in lignes_diag))
            self._afficher_statut_temporaire(f"Rapport complet de '{nom_diag}' copié ({len(lignes_diag)} ligne(s)).")
            return
        if requete_id in self._requetes_journal_profil:  # PATCH journal par profil
            nom_journal, nombre_journal = self._requetes_journal_profil.pop(requete_id)
            if not data.get("ok", False):
                self._afficher_statut_temporaire(
                    f"Échec de la copie du journal de '{nom_journal}' : {data.get('error', 'erreur inconnue')}"
                )
                return
            resultat_journal = data.get("result") or {}
            lignes_journal = resultat_journal.get("lignes") or []
            if not lignes_journal:
                self._afficher_statut_temporaire(
                    f"Journal vide pour '{nom_journal}' : aucune sortie enregistrée depuis le démarrage de ce profil."
                )
                return
            QGuiApplication.clipboard().setText("\n".join(str(ligne) for ligne in lignes_journal))
            self._afficher_statut_temporaire(
                f"{len(lignes_journal)} dernière(s) ligne(s) du journal de '{nom_journal}' copiée(s) "
                f"(demandé : {nombre_journal}, journal total : {resultat_journal.get('total', len(lignes_journal))})."
            )
            return
        if requete_id in self._requetes_logs_profil:  # PATCH sortie de logs par profil
            instance_id_logs, coupee_demandee = self._requetes_logs_profil.pop(requete_id)
            if data.get("ok", False):
                if coupee_demandee:
                    _INSTANCES_LOGS_ACTIVES_PILOTE.discard(instance_id_logs)
                else:
                    _INSTANCES_LOGS_ACTIVES_PILOTE.add(instance_id_logs)
                self._afficher_statut_temporaire(
                    "Sortie de logs coupée pour ce profil." if coupee_demandee else "Sortie de logs réactivée pour ce profil."
                )
            else:
                self._afficher_statut_temporaire(
                    f"Échec du changement de sortie de logs : {data.get('error', 'erreur inconnue')}"
                )
            self._reconstruire_table()
            return
        if requete_id in self._requetes_copie_proprietes:
            nom_profil = self._requetes_copie_proprietes.pop(requete_id)
            if self._file_copie_masse and self._file_copie_masse[0][0] == nom_profil:
                ok = data.get("ok", False)
                resultat = data.get("result") if ok else data.get("error", "erreur inconnue")
                self._sur_resultat_copie_masse(nom_profil, ok, resultat)
                return
            self._reconstruire_table()  # réactive le bouton de cette ligne
            if not data.get("ok", False):
                erreur = data.get("error", "erreur inconnue")
                self._afficher_statut_temporaire(f"Échec de récupération des propriétés de '{nom_profil}' : {erreur}")
                return
            proprietes = data.get("result") or {}
            texte = f"Profil : {nom_profil}\n" + "\n".join(
                f"{cle} : {valeur}" for cle, valeur in proprietes.items()
            )
            QGuiApplication.clipboard().setText(texte)
            self._afficher_statut_temporaire(f"Propriétés de '{nom_profil}' copiées dans le presse-papier.")
            return

        if self._fenetre_rendu_reseau is None:
            return
        panneau = self._fenetre_rendu_reseau.panneau
        if requete_id == getattr(self, "_requete_id_liste_onglets_reseau", None):
            self._requete_id_liste_onglets_reseau = None
            if not data.get("ok", False):
                panneau.label_statut_onglets.definir_texte(f"Échec : {data.get('error', 'erreur inconnue')}")
                panneau.label_statut_onglets.setStyleSheet(f"color: {Mocha.red}; font-size: 11px;")
                return
            onglets = data.get("result") or []
            combo = panneau.onglet_combo
            combo.blockSignals(True)
            combo.clear()
            id_actif = None
            for onglet in onglets:
                titre = onglet.get("titre") or onglet.get("url") or onglet.get("id", "")
                libelle = titre if len(titre) <= 50 else titre[:47] + "…"
                combo.addItem(libelle, onglet.get("id"))
                if onglet.get("actif"):
                    id_actif = onglet.get("id")
            if not onglets:
                combo.addItem("Aucun onglet ouvert", None)
            index_actif = combo.findData(id_actif) if id_actif else -1
            combo.setCurrentIndex(max(0, index_actif))
            combo.blockSignals(False)
            combo.setEnabled(len(onglets) > 0)
            panneau.label_statut_onglets.definir_texte(f"{len(onglets)} onglet(s) trouvé(s).")
            panneau.label_statut_onglets.setStyleSheet(f"color: {Mocha.green}; font-size: 11px;")
        elif requete_id == getattr(self, "_requete_id_switch_onglet_reseau", None):
            self._requete_id_switch_onglet_reseau = None
            if not data.get("ok", False):
                panneau.label_statut_onglets.definir_texte(f"Échec du changement d'onglet : {data.get('error', 'erreur inconnue')}")
                panneau.label_statut_onglets.setStyleSheet(f"color: {Mocha.red}; font-size: 11px;")


class OrchestrateurActionsGlobalesInstances(QObject):
    """AJOUT (SPEC_lot_corrections_2026-09.md section 13) : logique
    "silencieuse" (aucun widget visible propre) des boutons globaux de la
    nouvelle barre en bas de la colonne gauche d'InstancesConnecteesScreen
    -- cf. décision 1 : "Pas de nouvelle liste agrégée visible [...] Les
    boutons globaux agissent 'en silence' sur l'état de sélection [...]".

    POURQUOI UNE CLASSE SÉPARÉE, PLUTÔT QUE DE RÉUTILISER PanneauProprietes
    Sautoniax TEL QUEL (cf. échange de clarification avant implémentation) :
    ce panneau est câblé pour UN SEUL sAutoniax à la fois (self._id_
    executant_courant singulier, self._profils/_profils_coches non keyés
    par id_executant, aller-retour réseau asynchrone qui suppose ce
    sAutoniax "actuellement affiché") -- le faire "sauter" d'un sAutoniax à
    l'autre pour appliquer une action en masse ferait clignoter le panneau
    visible à l'écran (label_titre, table_profils...) à chaque étape,
    contrairement à l'esprit "en silence" de la décision 1. Cette classe
    répète donc la partie strictement nécessaire de la logique réseau
    (appels directs sur ClientServeurT, mêmes méthodes exactes que celles
    déjà câblées pour PanneauProprietesSautoniax, cf. MainWindow autour de
    "panneau_proprietes.demande_xxx.connect"), mais keyée PAR id_executant
    dès le départ.

    CORRECTIF (demande explicite utilisateur : "lorsque on selectionne ou
    deselectionne avec le bouton global sa le fait bien, mais sa ne met
    pas a jour les checkbox des profils de chaque sautoniax") -- la
    phrase "sans jamais toucher au panneau visible" ci-dessus décrivait
    le comportement D'ORIGINE, désormais corrigé : cette classe garde
    toujours son propre état de sélection PAR sAutoniax (_profils_coches
    ci-dessous, jamais écrasé par le panneau ni l'inverse), mais notifie
    en plus PanneauProprietesSautoniax (référence optionnelle posée par
    definir_panneau_proprietes) quand le sAutoniax concerné par une
    action globale est celui ACTUELLEMENT AFFICHÉ dans ce panneau --
    cf. sur_profils_recus_pour_selection, qui appelle désormais panneau_
    proprietes.appliquer_coches_externes() en plus de mettre à jour sa
    propre _profils_coches. Un panneau affichant un AUTRE sAutoniax
    n'est jamais perturbé (appliquer_coches_externes ignore tout
    id_executant différent du sien), donc aucun "clignotement" au sens
    de la décision 1 -- seul l'affichage déjà pertinent est rafraîchi.

    Sélection de profils PAR SAUTONIAX (cf. décision 1, "l'état de
    sélection déjà porté par CHAQUE PanneauProprietesSautoniax individuel"
    -- lu comme : un état de sélection par sAutoniax, indépendant duquel
    est actuellement affiché à l'écran) : self._profils_coches est keyé
    par id_executant, jamais partagé/écrasé entre deux sAutoniax comme
    l'aurait été un set() unique. "Tout sélectionner/désélectionner/actifs/
    inactifs" (global) commence donc par (re)scanner chaque sAutoniax
    coché (demander_profils_sautoniax) avant d'appliquer le filtre demandé
    sur la réponse fraîche -- la sélection porte toujours sur l'état RÉEL
    le plus récent, jamais sur un scan potentiellement périmé.

    Signal `progression` (bool succès_partiel_ou_total, str message) --
    même contrat que PanneauExecutionClone/PanneauProprietesSautoniax
    (label de statut mis à jour au fil de l'eau) : câblé par
    InstancesConnecteesScreen sur son propre label_statut_actions_
    globales, jamais directement sur un widget de MainWindow (cette
    classe ignore tout de l'UI qui l'affiche, cf. son nom "sans widget
    visible propre")."""

    progression = Signal(bool, str)  # (ok, message) -- message de statut à afficher

    def __init__(self, parent=None):
        super().__init__(parent)
        self._client_serveur_t: Optional["ClientServeurT"] = None
        # CORRECTIF (cf. docstring de classe) -- référence optionnelle
        # vers le panneau visible, posée par definir_panneau_proprietes
        # juste après construction (même patron EXACT que definir_
        # client_reseau ci-dessous). None tant qu'elle n'a pas encore
        # été injectée (ex. tests unitaires isolés de cette classe) --
        # sur_profils_recus_pour_selection s'en passe silencieusement
        # dans ce cas, la synchronisation de l'affichage n'étant qu'un
        # rattrapage EN PLUS de la sélection globale elle-même (déjà
        # pleinement fonctionnelle sans panneau injecté).
        self._panneau_proprietes: Optional["PanneauProprietesSautoniax"] = None
        # id_executant -> {nom_profil: infos}, dernier scan CONNU pour ce
        # sAutoniax (indépendant de PanneauProprietesSautoniax._profils,
        # qui ne connaît que le sAutoniax actuellement affiché à l'écran).
        self._profils_connus: dict[str, dict] = {}
        # id_executant -> set(nom_profil coché) -- cf. docstring de classe.
        self._profils_coches: dict[str, set] = {}
        # File d'attente de rescans en cours (avant d'appliquer un filtre
        # de sélection global) -- {id_executant: filtre_a_appliquer_apres},
        # filtre_a_appliquer_apres ∈ {"tout", "aucun", "actifs", "inactifs"}.
        self._rescans_en_attente: dict[str, str] = {}
        # Files de lots séquentiels PAR sAutoniax (même patron EXACT que
        # PanneauProprietesSautoniax._file_generation_masse/_file_
        # suppression_masse, mais un dict de files au lieu d'une file
        # unique -- plusieurs sAutoniax peuvent avoir un lot en vol
        # simultanément, chacun progresse indépendamment des autres).
        self._files_demarrage: dict[str, list] = {}
        self._files_arret: dict[str, list] = {}
        self._files_generation: dict[str, list] = {}
        self._files_suppression: dict[str, list] = {}
        # Bilan agrégé multi-sAutoniax, remis à zéro au lancement de
        # chaque action globale -- {id_executant: {nom: (ok, message)}}.
        self._resultats_generation: dict[str, dict] = {}
        self._resultats_suppression: dict[str, dict] = {}
        self._nombre_generation_en_cours: int = 0
        # Type ("chrome"/"camoufox") réellement utilisé pour le lot EN
        # COURS d'envoi (figé au lancement, cf. lancer_generation) --
        # initialisé ici par défense en profondeur seulement, même
        # raisonnement EXACT que PanneauProprietesSautoniax.
        # _type_instance_generation_masse_en_cours.
        self._type_instance_generation_en_cours: str = "camoufox"
        # CORRECTIF (retour utilisateur : "il a oublie de mettre le
        # filtre global" -- SPEC_lot_corrections_2026-09.md section 13,
        # "Un bouton de filtre global + le widget de génération de
        # profils global") -- MÊME mécanique EXACTE que PanneauProprietes
        # Sautoniax._contraintes_generation (JSON de contraintes collé
        # depuis le presse-papier, jamais affiché à l'écran, cf. son
        # docstring), mais tenu ici séparément puisque cette classe agit
        # sur plusieurs sAutoniax à la fois sans jamais passer par l'état
        # interne d'un panneau individuel (cf. docstring de classe).
        self._contraintes_generation: dict = {}

    def definir_client_reseau(self, client_serveur_t: "ClientServeurT"):
        """Injection tardive (même patron que PanneauProprietesSautoniax.
        definir_reglages) -- posée une fois par MainWindow juste après
        construction, cf. son docstring."""
        self._client_serveur_t = client_serveur_t

    def definir_panneau_proprietes(self, panneau_proprietes: "PanneauProprietesSautoniax"):
        """CORRECTIF (cf. docstring de classe) -- injection tardive,
        même patron EXACT que definir_client_reseau ci-dessus, posée une
        fois par MainWindow juste après construction. Permet à
        sur_profils_recus_pour_selection de rattraper l'affichage du
        panneau visible quand une action globale concerne le sAutoniax
        qu'il affiche actuellement -- cf. PanneauProprietesSautoniax.
        appliquer_coches_externes pour le détail de cette synchronisation."""
        self._panneau_proprietes = panneau_proprietes

    def profils_coches_pour(self, id_executant: str) -> set:
        """CORRECTIF (retour utilisateur : "sa ne met pas a jour les
        checkbox des profils de chaque sautoniax ... actuellement sa
        actualise seulement pour le sautoniax qui est selectionner") --
        accesseur PUBLIC en lecture seule sur self._profils_coches (cf.
        docstring de classe), appelé par PanneauProprietesSautoniax.
        definir_sautoniax_selectionne au moment où un NOUVEAU sAutoniax
        devient affiché, pour initialiser l'affichage sur ce que les
        actions globales ont réellement appliqué à ce sAutoniax-là
        plutôt que de repartir d'un ensemble vide -- symétrique de
        appliquer_coches_externes (qui rattrape le panneau EN TEMPS
        RÉEL pendant qu'il reste affiché), celui-ci couvre le cas
        laissé ouvert : un sAutoniax touché pendant qu'il n'était PAS
        affiché.

        Retourne une COPIE (jamais la référence interne) : le panneau a
        sa propre vie ensuite (cases cochées/décochées manuellement,
        purge des profils disparus via sur_profils_recus) sans jamais
        devoir affecter l'état de cette classe en retour -- les deux
        ensembles divergent délibérément après ce point initial, seule
        une NOUVELLE action globale (via appliquer_coches_externes ou
        un futur retour sur cette méthode) les fait reconverger."""
        return set(self._profils_coches.get(id_executant, set()))

    def sur_clic_coller_contraintes_globales(self) -> tuple[str, str]:
        """CORRECTIF (retour utilisateur : "il a oublie de mettre le
        filtre global") -- MÊME logique EXACTE que PanneauProprietesSautoniax.
        _sur_clic_coller_contraintes (lit le presse-papier, valide via
        parser_contraintes_generation_profil, presse-papier vide efface
        le filtre), mais cette classe n'a pas de widget propre (cf.
        docstring de classe) : retourne (texte_statut, couleur_nom) pour
        que l'appelant (la nouvelle barre globale) les applique lui-même
        à son propre point d'état/tooltip -- couleur_nom vaut "gris",
        "vert" ou "rouge", résolu en couleur Mocha réelle côté appelant
        (cette classe ne doit pas connaître Mocha/QSS, cf. son statut
        headless)."""
        texte = QGuiApplication.clipboard().text().strip()
        if not texte:
            self._contraintes_generation = {}
            return "Aucun filtre de génération actif.", "gris"

        ok, contraintes, erreur = parser_contraintes_generation_profil(texte)
        if not ok:
            # Filtre précédent conservé tel quel -- même décision EXACTE
            # que le panneau individuel (cf. sa docstring).
            return f"JSON invalide : {erreur}", "rouge"

        self._contraintes_generation = contraintes
        resume = "; ".join(
            f"{cle} : {', '.join(valeurs)}" for cle, valeurs in contraintes.items()
        )
        return f"Filtre actif -- {resume}", "vert"

    # ------------------------------------------------------------------
    # Sélection de profils globale (Tout sélectionner / désélectionner /
    # actifs / inactifs) -- cf. décision 1 : rescan avant application.
    # ------------------------------------------------------------------

    def _lancer_selection_globale(self, ids_executants: list, filtre: str):
        """Point d'entrée commun aux 4 boutons de sélection globale --
        `filtre` ∈ {"tout", "aucun", "actifs", "inactifs"}. Rescanne
        CHAQUE sAutoniax coché (demander_profils_sautoniax), le filtre
        n'étant appliqué qu'à la réception de sur_profils_recus_pour_
        selection ci-dessous -- jamais sur un scan potentiellement
        périmé (cf. docstring de classe)."""
        if not ids_executants:
            self.progression.emit(False, "Aucun sAutoniax coché.")
            return
        if self._client_serveur_t is None:
            self.progression.emit(False, "Non connecté au serveurT.")
            return
        for id_executant in ids_executants:
            self._rescans_en_attente[id_executant] = filtre
            self._client_serveur_t.demander_profils_sautoniax(id_executant)
        self.progression.emit(True, f"Actualisation de {len(ids_executants)} sAutoniax avant sélection...")

    def lancer_tout_selectionner(self, ids_executants: list):
        self._lancer_selection_globale(ids_executants, "tout")

    def lancer_tout_deselectionner(self, ids_executants: list):
        self._lancer_selection_globale(ids_executants, "aucun")

    def lancer_selectionner_actifs(self, ids_executants: list):
        self._lancer_selection_globale(ids_executants, "actifs")

    def lancer_selectionner_inactifs(self, ids_executants: list):
        self._lancer_selection_globale(ids_executants, "inactifs")

    def sur_profils_recus_pour_selection(self, id_executant: str, profils: list):
        """Connecté sur ClientServeurT.profils_sautoniax_recu (DIFFUSÉ à
        tous les pilotes, cf. son docstring) -- ignore toute réception ne
        correspondant à aucun rescan en attente ICI (peut arriver si
        InstancesConnecteesScreen a aussi rescanné ce même sAutoniax pour
        une autre raison, ex. PanneauProprietesSautoniax affiché dessus en
        même temps -- cette classe garde son propre état de sélection,
        jamais mélangé à celui du panneau visible, cf. docstring de
        classe).

        CORRECTIF (cf. docstring de classe) -- appelle désormais aussi
        panneau_proprietes.appliquer_coches_externes() une fois
        _profils_coches[id_executant] recalculé : le panneau ignore lui-
        même cet appel s'il affiche un AUTRE sAutoniax (cf. sa docstring),
        donc aucun risque de "sauter" sur ce sAutoniax ni de perturber un
        affichage sans rapport -- seul un panneau déjà sur CE sAutoniax
        voit ses cases se rafraîchir pour refléter la sélection globale
        qui vient d'être appliquée."""
        self._profils_connus[id_executant] = {p["nom"]: p for p in profils if p.get("nom")}
        filtre = self._rescans_en_attente.pop(id_executant, None)
        if filtre is None:
            return
        noms = self._profils_connus[id_executant]
        if filtre == "tout":
            self._profils_coches[id_executant] = set(noms.keys())
        elif filtre == "aucun":
            self._profils_coches[id_executant] = set()
        elif filtre == "actifs":
            self._profils_coches[id_executant] = {
                nom for nom, infos in noms.items() if infos.get("actif")
            }
        elif filtre == "inactifs":
            self._profils_coches[id_executant] = {
                nom for nom, infos in noms.items() if not infos.get("actif")
            }
        if self._panneau_proprietes is not None:
            self._panneau_proprietes.appliquer_coches_externes(
                id_executant, self._profils_coches[id_executant]
            )
        if not self._rescans_en_attente:
            total_coches = sum(len(s) for s in self._profils_coches.values())
            self.progression.emit(True, f"Sélection globale mise à jour -- {total_coches} profil(s) coché(s) au total.")

    # ------------------------------------------------------------------
    # Tout démarrer / Tout arrêter (global) -- sur les profils COCHÉS de
    # chaque sAutoniax coché uniquement (cf. décision : "profils
    # sélectionnés, pas tous").
    # ------------------------------------------------------------------

    def lancer_tout_demarrer(self, ids_executants: list):
        if self._client_serveur_t is None:
            self.progression.emit(False, "Non connecté au serveurT.")
            return
        nb_lances = 0
        for id_executant in ids_executants:
            noms_coches = self._profils_coches.get(id_executant, set())
            profils_connus = self._profils_connus.get(id_executant, {})
            noms_inactifs = [
                nom for nom in noms_coches
                if nom in profils_connus and not profils_connus[nom].get("actif")
            ]
            for nom_profil in noms_inactifs:
                self._client_serveur_t.demander_demarrer_profil_isole(id_executant, nom_profil)
                nb_lances += 1
        if nb_lances == 0:
            self.progression.emit(False, "Aucun profil coché et inactif à démarrer parmi les sAutoniax cochés.")
        else:
            self.progression.emit(True, f"Démarrage envoyé pour {nb_lances} profil(s).")

    def lancer_tout_arreter(self, ids_executants: list):
        if self._client_serveur_t is None:
            self.progression.emit(False, "Non connecté au serveurT.")
            return
        nb_lances = 0
        for id_executant in ids_executants:
            noms_coches = self._profils_coches.get(id_executant, set())
            profils_connus = self._profils_connus.get(id_executant, {})
            noms_actifs = [
                nom for nom in noms_coches
                if nom in profils_connus and profils_connus[nom].get("actif")
            ]
            for nom_profil in noms_actifs:
                self._client_serveur_t.kill_profil(id_executant, nom_profil)
                nb_lances += 1
        if nb_lances == 0:
            self.progression.emit(False, "Aucun profil coché et actif à arrêter parmi les sAutoniax cochés.")
        else:
            self.progression.emit(True, f"Arrêt envoyé pour {nb_lances} profil(s).")

    # ------------------------------------------------------------------
    # Générer (global) -- N profils PAR sAutoniax coché (cf. décision 2 :
    # "N=5 et 3 sAutoniax cochés -> 15 profils créés au total").
    # ------------------------------------------------------------------

    @staticmethod
    def _prochains_noms_iax_pour(profils_connus: dict, nombre: int) -> list:
        """Même algorithme EXACT que PanneauProprietesSautoniax.
        _prochains_noms_iax (cf. sa docstring pour le raisonnement complet
        -- jamais de réutilisation d'indice), paramétré ici par le dict de
        profils connus d'UN sAutoniax précis plutôt que self._profils."""
        motif = re.compile(r"^iaX(\d+)$", re.IGNORECASE)
        indices_existants = []
        for nom in profils_connus.keys():
            m = motif.match(nom)
            if m:
                indices_existants.append(int(m.group(1)))
        depart = (max(indices_existants) + 1) if indices_existants else 1
        return [f"iaX{depart + i}" for i in range(nombre)]

    def lancer_generation(self, ids_executants: list, nombre: int, type_instance: str = "camoufox"):
        """PATCH (demande explicite utilisateur : "on doit pouvoir
        choisir entre generer des profils chrome ou camoufox, dans le
        panneau de profils des sautoniax") -- `type_instance` ("chrome"
        ou "camoufox") n'est plus figé en dur : transmis par l'appelant
        (cf. PanneauInstancesSautoniax._on_clic_generer_profils_masse_
        globale, lu depuis son combo_type_generation_globale), avec
        repli sur "camoufox" par défaut pour ne pas casser un appelant
        qui ne le préciserait pas encore."""
        if not ids_executants:
            self.progression.emit(False, "Aucun sAutoniax coché.")
            return
        if self._client_serveur_t is None:
            self.progression.emit(False, "Non connecté au serveurT.")
            return
        if any(self._files_generation.get(id_executant) for id_executant in ids_executants):
            self.progression.emit(False, "Une génération globale est déjà en cours sur au moins un sAutoniax coché.")
            return
        self._resultats_generation = {}
        self._nombre_generation_en_cours = nombre
        # Figé ICI, pour tout le lot (tous sAutoniax cochés confondus) --
        # même raisonnement que PanneauProprietesSautoniax._lancer_
        # generation_masse/_type_instance_generation_masse_en_cours :
        # un changement du combo PENDANT que ce lot est encore en vol
        # (cas limite, asynchrone par id_executant) ne doit jamais faire
        # dévier une création déjà lancée vers un autre type.
        self._type_instance_generation_en_cours = type_instance or "camoufox"
        for id_executant in ids_executants:
            noms = self._prochains_noms_iax_pour(self._profils_connus.get(id_executant, {}), nombre)
            self._files_generation[id_executant] = list(noms)
            self._resultats_generation[id_executant] = {}
            self._envoyer_prochaine_creation(id_executant)
        libelle_type = {"chrome": "Chrome", "camoufox": "Camoufox", "cloakbrowser": "CloakBrowser", "feather": "Feather"}.get(
            self._type_instance_generation_en_cours, self._type_instance_generation_en_cours
        )
        self.progression.emit(
            True,
            f"Génération en cours -- {nombre} profil(s) {libelle_type} sur chacun des "
            f"{len(ids_executants)} sAutoniax coché(s)...",
        )

    def _envoyer_prochaine_creation(self, id_executant: str):
        file = self._files_generation.get(id_executant) or []
        if not file:
            self._files_generation.pop(id_executant, None)
            self._verifier_fin_generation()
            return
        nom_profil = file[0]
        # CORRECTIF (retour utilisateur : "il a oublie de mettre le
        # filtre global" -- le commentaire précédent affirmait à tort
        # que la spec section 13 ne demandait pas de filtre pour la
        # génération globale ; elle le demande explicitement, "Un
        # bouton de filtre global + le widget de génération de profils
        # global"). Proxy par défaut toujours vide, comme la génération
        # individuelle -- seul le type change désormais, cf. docstring
        # de lancer_generation (self._type_instance_generation_en_cours,
        # figé pour tout le lot, PLUS "camoufox" en dur comme avant ce
        # patch). Dernier argument : self._contraintes_generation (cf.
        # sur_clic_coller_contraintes_globales, alimenté par la barre
        # globale).
        self._client_serveur_t.demander_creer_profil_sautoniax(
            id_executant, nom_profil, self._type_instance_generation_en_cours, "", self._contraintes_generation
        )

    def sur_resultat_creer_profil_global(self, id_executant: str, nom_profil: str, ok: bool, message: str):
        """Connecté sur ClientServeurT.creer_profil_sautoniax_resultat_recu
        (DIFFUSÉ à tous les pilotes) -- ignoré si ce nom/sAutoniax ne fait
        pas partie d'un lot de génération globale en cours (même
        raisonnement EXACT que PanneauProprietesSautoniax.sur_resultat_
        creer_profil)."""
        file = self._files_generation.get(id_executant)
        if not file or file[0] != nom_profil:
            return
        file.pop(0)
        self._resultats_generation.setdefault(id_executant, {})[nom_profil] = (ok, message)
        self._envoyer_prochaine_creation(id_executant)

    def _verifier_fin_generation(self):
        if self._files_generation:
            return  # au moins un sAutoniax n'a pas fini son lot
        total_reussis = sum(
            1 for resultats in self._resultats_generation.values()
            for ok, _msg in resultats.values() if ok
        )
        total_echecs = sum(
            1 for resultats in self._resultats_generation.values()
            for ok, _msg in resultats.values() if not ok
        )
        ids_a_rafraichir = list(self._resultats_generation.keys())
        self._resultats_generation = {}
        if total_echecs:
            self.progression.emit(
                True, f"Génération globale terminée -- {total_reussis} créé(s), {total_echecs} échec(s)."
            )
        else:
            self.progression.emit(True, f"Génération globale terminée -- {total_reussis} profil(s) créé(s).")
        # Rescanne chaque sAutoniax concerné pour que self._profils_connus
        # reflète les profils fraîchement créés (utile à un futur bouton
        # de sélection/démarrage global sans attendre un rafraîchissement
        # manuel, cf. même raisonnement que PanneauProprietesSautoniax.
        # _terminer_generation_masse -> demande_rafraichir_profils.emit).
        if self._client_serveur_t is not None:
            for id_executant in ids_a_rafraichir:
                self._client_serveur_t.demander_profils_sautoniax(id_executant)

    # ------------------------------------------------------------------
    # Supprimer (global) -- profils COCHÉS de chaque sAutoniax coché
    # uniquement (cf. décision : "uniquement ceux sélectionnés/cochés").
    # ------------------------------------------------------------------

    def lancer_suppression(self, ids_executants: list):
        if self._client_serveur_t is None:
            self.progression.emit(False, "Non connecté au serveurT.")
            return
        if any(self._files_suppression.get(id_executant) for id_executant in ids_executants):
            self.progression.emit(False, "Une suppression globale est déjà en cours sur au moins un sAutoniax coché.")
            return
        cible = {
            id_executant: sorted(self._profils_coches.get(id_executant, set()), key=_cle_tri_numerique_profil)
            for id_executant in ids_executants
        }
        cible = {id_executant: noms for id_executant, noms in cible.items() if noms}
        if not cible:
            self.progression.emit(False, "Aucun profil coché à supprimer parmi les sAutoniax cochés.")
            return
        self._resultats_suppression = {}
        for id_executant, noms in cible.items():
            self._files_suppression[id_executant] = list(noms)
            self._resultats_suppression[id_executant] = {}
            self._envoyer_prochaine_suppression(id_executant)
        total = sum(len(noms) for noms in cible.values())
        self.progression.emit(True, f"Suppression en cours -- {total} profil(s) coché(s) sur {len(cible)} sAutoniax...")

    def _envoyer_prochaine_suppression(self, id_executant: str):
        file = self._files_suppression.get(id_executant) or []
        if not file:
            self._files_suppression.pop(id_executant, None)
            self._verifier_fin_suppression()
            return
        nom_profil = file[0]
        self._client_serveur_t.demander_supprimer_profil_sautoniax(id_executant, nom_profil)

    def sur_resultat_supprimer_profil_global(self, id_executant: str, nom_profil: str, ok: bool, message: str):
        """Connecté sur ClientServeurT.supprimer_profil_sautoniax_
        resultat_recu (DIFFUSÉ) -- même raisonnement EXACT que sur_
        resultat_creer_profil_global ci-dessus."""
        file = self._files_suppression.get(id_executant)
        if not file or file[0] != nom_profil:
            return
        file.pop(0)
        self._resultats_suppression.setdefault(id_executant, {})[nom_profil] = (ok, message)
        if ok:
            # Cf. décision 1 -- une case cochée pour un profil qui vient
            # d'être supprimé avec succès n'a plus de sens (même
            # raisonnement EXACT que PanneauProprietesSautoniax.sur_
            # profils_recus, "purge les noms cochés qui ont disparu").
            self._profils_coches.get(id_executant, set()).discard(nom_profil)
        self._envoyer_prochaine_suppression(id_executant)

    def _verifier_fin_suppression(self):
        if self._files_suppression:
            return
        total_reussis = sum(
            1 for resultats in self._resultats_suppression.values()
            for ok, _msg in resultats.values() if ok
        )
        total_echecs = sum(
            1 for resultats in self._resultats_suppression.values()
            for ok, _msg in resultats.values() if not ok
        )
        ids_a_rafraichir = list(self._resultats_suppression.keys())
        self._resultats_suppression = {}
        if total_echecs:
            self.progression.emit(
                True,
                f"Suppression globale terminée -- {total_reussis} supprimé(s), {total_echecs} ignoré(s)/échec(s) "
                "(un profil actif est ignoré -- arrêtez-le d'abord).",
            )
        else:
            self.progression.emit(True, f"Suppression globale terminée -- {total_reussis} profil(s) supprimé(s).")
        if self._client_serveur_t is not None:
            for id_executant in ids_a_rafraichir:
                self._client_serveur_t.demander_profils_sautoniax(id_executant)


class InstancesConnecteesScreen(QWidget):
    """Onglet "Instances" de ReseauScreen (PATCH -- demande explicite
