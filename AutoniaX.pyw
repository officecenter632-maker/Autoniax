    def _on_zone_clic_mode_changed(self, index: int):
        if self.project is None or self._composant_nom is None:
            return
        composant = self.project.find_composant(self._composant_nom)
        if not composant:
            return
        nouveau_mode = self.zone_clic_combo.currentData()
        composant.zone_clic_mode = nouveau_mode
        self.definir_zone_button.setVisible(nouveau_mode == "personnalise")
        self.project.save()
        self._rafraichir_apercu_avec_zone()
        # Si on repasse sur "personnalisé" et qu'aucune zone n'a jamais été
        # définie, on ouvre directement le sélecteur pour guider l'utilisateur.
        if nouveau_mode == "personnalise" and composant.zone_clic_rect.est_vide():
            self.demande_definir_zone_clic.emit(self._composant_nom)


