    def demander_horloge_mautoniax(self, id_pilote: str) -> "concurrent.futures.Future":
        """Côté EXÉCUTANT -- envoie demander_horloge_mautoniax (cf.
        serveur.py, handler du même nom) ciblant le pilote `id_pilote`
        (cf. RelaisProxyLocal.dernier_id_pilote_connu, déjà posé avant
        obtenir_port_local). Retourne une concurrent.futures.Future
        (thread-safe, appelable depuis n'importe quel thread -- même
        patron que api2api_attendre_requete_bloquant) résolue avec
        (iso_local, nom_fuseau) dès que horloge_mautoniax_resultat
        arrive (cf. _traiter_message plus bas), ou dont l'exception est
        posée si l'envoi échoue. AU PLUS UNE demande en vol à la fois
        pour ce client (cf. docstring de _attente_horloge_mautoniax) --
        toute Future précédente encore pendante est annulée avant d'en
        poser une nouvelle, jamais laissée orpheline. Timeout/relance :
        à la charge de l'appelant (cf. RelaisProxyLocal.obtenir_horloge_
        mautoniax), pas de cette méthode."""
        future: "concurrent.futures.Future" = concurrent.futures.Future()
        if self._loop is None or not self._loop.is_running() or self._ws is None:
            future.set_exception(RuntimeError("Non connecté au serveurT."))
            return future
        asyncio.run_coroutine_threadsafe(
            self._envoyer_demander_horloge_mautoniax(id_pilote, future), self._loop,
        )
        return future

    async def _envoyer_demander_horloge_mautoniax(self, id_pilote: str, future: "concurrent.futures.Future"):
        ancienne = self._attente_horloge_mautoniax
        if ancienne is not None and not ancienne.done():
            ancienne.cancel()
        self._attente_horloge_mautoniax = future
        try:
            await self._ws.send(json.dumps({
                "type": "demander_horloge_mautoniax", "id_pilote": id_pilote,
            }))
            log_reseau_t.info(f"-> demander_horloge_mautoniax envoyé au serveurT (id_pilote={id_pilote!r})")
        except Exception as e:
            log_reseau_t.warning(f"Échec envoi demander_horloge_mautoniax (id_pilote={id_pilote!r}) : {e!r}")
            if not future.done():
                future.set_exception(e)

