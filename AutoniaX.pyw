try:
    from cloakbrowser import launch_persistent_context_async as _cloak_launch_pc_async
    CLOAKBROWSER_DISPONIBLE = True
except ImportError:
    _cloak_launch_pc_async = None
    CLOAKBROWSER_DISPONIBLE = False


class _GestionnaireContexteCloak:
    """Mime AsyncCamoufox : le reste du code appelle
    camoufox_cm.__aexit__(None, None, None) à la fermeture de l'instance."""

    def __init__(self, context):
        self._context = context

    async def __aexit__(self, *exc):
        try:
            await self._context.close()
        except Exception:
            pass


def _cloak_graine_profil(nom_profil, profil) -> int:
    """Graine de fingerprint STABLE par profil (10000-99999) : même profil =>
    même identité à chaque relance (équivalent du JSON BrowserForge persisté
    côté Camoufox)."""
    cle = (nom_profil or profil or "defaut").encode("utf-8")
    return int(hashlib.sha256(cle).hexdigest(), 16) % 90000 + 10000


def _moteur_playwright_pour_profil(nom_profil) -> str:
    """Moteur Playwright à utiliser pour un profil (mode sAutoniax, qui
    lançait toujours Camoufox) : "cloakbrowser" si le profil est de ce type,
    "camoufox" sinon (comportement inchangé)."""
    try:
        if obtenir_config_profil(nom_profil).get("type_instance") == "cloakbrowser":
            return "cloakbrowser"
    except Exception:
        pass
    return "camoufox"


# PATCH CloakBrowser v2 -- trois corrections :
#  1. matériel varié PAR PROFIL (coeurs, mémoire, écran) dérivé de la graine ;
#  2. contraintes_ecran du profil appliquées (même syntaxe que Camoufox) ;
#  3. plus de fuite WebRTC silencieuse si geoip échoue avec un proxy.
CLOAK_BLOQUER_SI_GEOIP_ECHOUE = False  # True : refuse de lancer plutôt que de se replier
_CLOAK_RESOLUTIONS = [(1366, 768), (1440, 900), (1536, 864), (1600, 900),
                      (1920, 1080), (1920, 1200), (2560, 1440)]
_CLOAK_POIDS_RESOLUTIONS = [2, 1, 3, 2, 6, 1, 2]   # répartition proche du réel
_CLOAK_COEURS = [4, 6, 8, 8, 12, 16]
_CLOAK_MEMOIRE = [4, 8, 8, 8]                      # Chrome plafonne deviceMemory à 8


def _cloak_lire_graine(profil, nom_profil) -> int:
    """Graine native CloakBrowser (<profil>/.cloakbrowser-seed, voyage avec le
    zip du profil) ; repli sur la graine dérivée du nom si l'API est absente."""
    try:
        from cloakbrowser.config import persistent_seed_args
        for a in persistent_seed_args(profil, True, []) or []:
            if a.startswith("--fingerprint="):
                return int(a.split("=", 1)[1])
    except Exception:
        pass
    return _cloak_graine_profil(nom_profil, profil)


def _cloak_bornes_ecran(contraintes):
    """Contraintes \"Résolution d'écran\" -> bornes inclusives (même parsing
    que _construire_screen_camoufox_depuis_contraintes, sans dépendre de camoufox)."""
    bornes = {}
    for entree in (contraintes or {}).get("Résolution d'écran") or []:
        m = _REGEX_CONTRAINTE_RESOLUTION.match(str(entree).strip())
        if not m:
            continue
        champ, op, val = m.group(1), m.group(2), int(m.group(3))
        kmin, kmax = ("min_height", "max_height") if champ == "height" else ("min_width", "max_width")
        if op == ">":
            bornes[kmin] = val + 1
        elif op == ">=":
            bornes[kmin] = val
        elif op == "<":
            bornes[kmax] = val - 1
        elif op == "<=":
            bornes[kmax] = val
        elif op == "=":
            bornes[kmin] = bornes[kmax] = val
    return bornes


def _cloak_materiel_depuis_graine(graine, contraintes=None) -> dict:
    """Matériel déterministe (même graine => mêmes valeurs) qui respecte les
    contraintes d'écran. Lève RuntimeError si elles sont insatisfiables."""
    rng = random.Random(graine)
    b = _cloak_bornes_ecran(contraintes)

    def ok(w, h):
        return (b.get("min_width", 0) <= w <= b.get("max_width", 10**6)
                and b.get("min_height", 0) <= h <= b.get("max_height", 10**6))

    cand = [(r, p) for r, p in zip(_CLOAK_RESOLUTIONS, _CLOAK_POIDS_RESOLUTIONS) if ok(*r)]
    if cand:
        w, h = rng.choices([c[0] for c in cand], weights=[c[1] for c in cand])[0]
    else:
        # Aucune résolution courante ne convient : on en synthétise une en 16:9.
        h = min(max(1080, b.get("min_height", 0)), b.get("max_height", 10**6))
        w = (round(h * 16 / 9) // 2) * 2
        if not ok(w, h):
            w = min(max(w, b.get("min_width", 0)), b.get("max_width", 10**6))
        if not ok(w, h):
            raise RuntimeError(
                f"[cloakbrowser] contraintes_ecran insatisfiables ({contraintes!r}) : "
                f"aucune résolution cohérente trouvée.")
    return {"largeur": w, "hauteur": h,
            "coeurs": rng.choice(_CLOAK_COEURS), "memoire": rng.choice(_CLOAK_MEMOIRE)}


async def cloakbrowser_creer_contexte(profil, nom_profil, headless, proxy, instance_id=""):
    """Lance CloakBrowser avec un profil persistant. Retourne (cm, context),
    même contrat que _camoufox_creer_contexte : cm.__aexit__ ferme le navigateur."""
    if not CLOAKBROWSER_DISPONIBLE:
        raise RuntimeError(
            "cloakbrowser_creer_contexte() : le package 'cloakbrowser' n'est pas installé "
            "dans cet interpréteur (pip install -U cloakbrowser[geoip] && "
            "python -m cloakbrowser install)."
        )
    graine = _cloak_lire_graine(profil, nom_profil)
    try:
        contraintes = obtenir_config_profil(nom_profil).get("contraintes_ecran") if nom_profil else None
    except Exception:
        contraintes = None
    mat = _cloak_materiel_depuis_graine(graine, contraintes)
    args_base = [
        f"--fingerprint={graine}",
        f"--fingerprint-screen-width={mat['largeur']}",
        f"--fingerprint-screen-height={mat['hauteur']}",
        f"--fingerprint-hardware-concurrency={mat['coeurs']}",
        f"--fingerprint-device-memory={mat['memoire']}",
        # Équivalent des firefox_user_prefs anti-throttling de Camoufox.
        "--disable-background-timer-throttling",
        "--disable-renderer-backgrounding",
        "--disable-backgrounding-occluded-windows",
    ]
    kwargs = {
        "headless": headless,
        # humanize=False : AutoniaX a ses propres trajectoires ; l'activer
        # donnerait une double humanisation.
        "humanize": False,
        "args": list(args_base),
    }
    if proxy and proxy.get("host"):
        p = {"server": f"{proxy.get('protocole') or 'http'}://{proxy['host']}:{proxy['port']}"}
        if proxy.get("user"):
            p["username"] = proxy["user"]
            p["password"] = proxy.get("password") or ""
        kwargs["proxy"] = p
        kwargs["geoip"] = True  # timezone/locale/WebRTC alignés sur l'IP du proxy
    try:
        context = await _cloak_launch_pc_async(profil, **kwargs)
    except Exception as exc:
        if not kwargs.get("geoip"):
            raise
        if CLOAK_BLOQUER_SI_GEOIP_ECHOUE:
            raise RuntimeError(
                f"[cloakbrowser] geoip a échoué avec un proxy ({exc!r}) : lancement refusé "
                f"pour éviter une fuite WebRTC. pip install -U cloakbrowser[geoip]") from exc
        # Repli : proxy conservé + WebRTC forcé à passer par le proxy (aucune
        # candidate UDP directe => l'IP réelle de la machine ne peut pas fuiter).
        log.error(
            f"[cloakbrowser] geoip échoué ({exc!r}) -- relance avec proxy + politique WebRTC "
            f"disable_non_proxied_udp. Fuseau/langue NON alignés sur le proxy.")
        kwargs.pop("geoip", None)
        kwargs["args"] = args_base + ["--force-webrtc-ip-handling-policy=disable_non_proxied_udp"]
        context = await _cloak_launch_pc_async(profil, **kwargs)
    log.info(
        f"[cloakbrowser] instance '{instance_id}' lancée -- graine={graine}, "
        f"écran={mat['largeur']}x{mat['hauteur']}, coeurs={mat['coeurs']}, mémoire={mat['memoire']} Go, "
        f"proxy={'oui' if 'proxy' in kwargs else 'non'}, headless={headless}."
    )
    return _GestionnaireContexteCloak(context), context

