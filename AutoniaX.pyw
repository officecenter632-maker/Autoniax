    # ------------------------------------------------------------------
    # Chargement / capture de image_reference
    # ------------------------------------------------------------------
    def _charger_image_reference_existante(self):
        """Si composant_layout.image_reference pointe déjà vers un fichier
        existant (édition d'un cL déjà configuré), le charge en mémoire et
        l'affiche -- sans quoi l'onglet Formes s'ouvrirait vide à chaque
        réouverture d'un cL déjà capturé."""
        if not self.composant_layout.image_reference or not VISION_DISPONIBLE:
            return
        chemin = get_app_data_dir() / self.composant_layout.image_reference
        if not chemin.exists():
            return
        image_bgr = cv2.imread(str(chemin))
        if image_bgr is None:
            return
        self._image_reference_bgr = image_bgr
        # AJOUT (correctif bandes noires, cf. docstring de
        # _recalculer_taille_conteneur_apercus) : recalcule tout de suite
        # la taille du conteneur d'aperçus selon le RATIO de cette image
        # -- sans ça, le calcul restait figé sur celui du dernier resize
        # de fenêtre (souvent avant même qu'une image existe), donc les
        # bandes ne disparaissaient qu'après avoir redimensionné la
        # fenêtre manuellement.
        self._recalculer_taille_conteneur_apercus()
        self._rafraichir_affichage_image()
        self._appliquer_filtre()

    def _demarrer_capture_zone(self):
        """Arme une capture ponctuelle : la PROCHAINE frame reçue de
        l'instance liée devient image_reference (SPEC 5.1 -- réutilise le
        mécanisme de rafraîchissement ponctuel déjà fourni par
        InstanceApercuScreen, pas de nouveau protocole réseau)."""
        self._capture_en_attente = True
        self.demander_rafraichissement_pour_test()

    def _sur_nouvelle_frame(self, image: QImage, capture_ponctuelle: bool):
        """Override du hook de InstanceApercuScreen (cf. sa docstring) --
        appelé à chaque frame utile reçue de l'instance liée."""
        if self._capture_en_attente:
            self._capture_en_attente = False
            image_bgr = qimage_vers_bgr(image)
            if image_bgr is not None:
                self._image_reference_bgr = image_bgr
                # cf. commentaire équivalent dans
                # _charger_image_reference_existante.
                self._recalculer_taille_conteneur_apercus()
                nom_fichier = f"{self.composant_layout.service_api_nom}_{self.composant_layout.nom}_ref.png".replace(" ", "_")
                # BUGFIX : get_components_dir(service_api_nom) exige son
                # argument (crée elle-même le dossier, cf. sa docstring) --
                # l'appel précédent get_components_dir() sans argument
                # levait TypeError dès la première capture d'un cL.
                dossier = get_components_dir(self.composant_layout.service_api_nom or "_sans_service")
                chemin = dossier / nom_fichier
                image.save(str(chemin), "PNG")
                self.composant_layout.image_reference = str(chemin.relative_to(get_app_data_dir()))
                self.composant_layout_modifie.emit()
                self._rafraichir_affichage_image()
                self._appliquer_filtre()
            return
        # Pas de capture en attente : comportement par défaut, affichage
        # brut (même fallback que TestComposantScreen quand aucun test
        # n'est armé).
        self._afficher_apercu_defaut(image)

    # ------------------------------------------------------------------
    # Filtre + détection de blocs (5.2, 5.3)
    # ------------------------------------------------------------------
    def _rafraichir_liste_zones_dynamiques(self):
        """Repeuple self.liste_zones_dynamiques (lecture seule, cf.
        _construire_sous_onglet_filtre) à partir de self._dernieres_
        zones_filtre -- appelée après CHAQUE exécution du filtre (cf.
        _appliquer_filtre), réussie ou non. Simple liste de noms, pas de
        rectangle affiché ici (déjà visible en overlay sur l'aperçu de
        droite) -- juste de quoi confirmer d'un coup d'œil ce que le
        filtre a nommé lors du dernier essai."""
        self.liste_zones_dynamiques.clear()
        if not self._dernieres_zones_filtre:
            item = QListWidgetItem("(aucune -- exécutez le filtre)")
            item.setFlags(item.flags() & ~Qt.ItemIsSelectable)
            self.liste_zones_dynamiques.addItem(item)
            return
        for nom_zone in sorted(self._dernieres_zones_filtre):
            item = QListWidgetItem(nom_zone)
            item.setFlags(item.flags() & ~Qt.ItemIsSelectable)
            self.liste_zones_dynamiques.addItem(item)

    def _reconstruire_overlay_filtre(self):
        """Reconstruit self._resultat_filtre_bgr depuis l'état ACTUEL de
        self._dernieres_zones_filtre / self._couleurs_zones_filtre /
        composant_layout.zones_dynamiques_clic -- sans réexécuter le
        filtre lui-même (cf. _appliquer_filtre, qui appelle celle-ci
        après avoir peuplé ces trois éléments). Factorisée hors de
        _appliquer_filtre (AJOUT, cf. bloc "Zone de clic personnalisée --
        zones DYNAMIQUES") pour être réutilisable après une simple
        modification de la zone de clic personnalisée (mode ou
        rectangle) SANS relancer le filtre : le rectangle en pointillé
        doit apparaître/changer/disparaître immédiatement dès que
        l'utilisateur ferme ZoneClicSelector ou bascule le combo, pas
        seulement à la prochaine exécution du filtre (cf. appelants :
        _on_zone_clic_dynamique_definie, _sur_zone_clic_dynamique_mode_
        change).

        Ne fait rien si _dernieres_zones_filtre est vide (rien à
        dessiner) -- cf. les 3 branches d'échec de _appliquer_filtre, qui
        vident déjà _resultat_filtre_bgr directement et n'appellent pas
        cette méthode."""
        if self._image_reference_bgr is None or not self._dernieres_zones_filtre:
            return
        # Overlay dessiné CÔTÉ SYSTÈME, même principe EXACT que
        # _appliquer_scindement pour les "cartes" -- une copie de l'image
        # de référence, chaque zone en rectangle coloré. Plus AUCUN texte
        # dessiné sur l'image elle-même (retour utilisateur : "ne doit
        # pas etre sur limage") -- le nom de chaque zone est désormais
        # affiché uniquement dans la légende du panneau de droite (cf.
        # _peupler_page_zone_legende), pas ici.
        overlay = self._image_reference_bgr.copy()
        if overlay.ndim != 3:
            overlay = cv2.cvtColor(overlay, cv2.COLOR_GRAY2BGR)
        for nom_zone, (x, y, largeur, hauteur) in self._dernieres_zones_filtre.items():
            couleur = self._couleurs_zones_filtre.get(nom_zone, (0, 255, 0))
            cv2.rectangle(overlay, (x, y), (x + largeur, y + hauteur), couleur, 2)
            # AJOUT (demande explicite utilisateur : "il faut aussi
            # dessiner" la zone de clic personnalisée d'une zone
            # DYNAMIQUE) -- si cette zone a une config avec mode
            # "personnalise" (composant_layout.zones_dynamiques_clic),
            # son rectangle (stocké en FRACTIONS de CETTE zone, cf.
            # docstring de ZoneClicRectFraction) est reconverti en
            # pixels absolus de l'image de référence puis dessiné en
            # POINTILLÉ (cf. dessiner_rectangle_pointille) par-dessus le
            # rectangle plein ci-dessus -- MÊME couleur que la zone
            # (demande explicite : distinguer seulement par le style de
            # trait, pas par la couleur), pour que le rectangle
            # personnalisé reste visuellement rattaché à sa zone même
            # quand plusieurs zones sont affichées simultanément.
            config_clic = self.composant_layout.zones_dynamiques_clic.get(nom_zone)
            if config_clic is not None and config_clic.zone_clic_mode == "personnalise" and not config_clic.zone_clic_rect.est_vide():
                fr = config_clic.zone_clic_rect
                x_clic = x + round(fr.x * largeur)
                y_clic = y + round(fr.y * hauteur)
                largeur_clic = round(fr.largeur * largeur)
                hauteur_clic = round(fr.hauteur * hauteur)
                dessiner_rectangle_pointille(
                    overlay,
                    (x_clic, y_clic),
                    (x_clic + largeur_clic, y_clic + hauteur_clic),
                    couleur,
                    1,
                )
        self._resultat_filtre_bgr = overlay

    def _appliquer_filtre(self):
        """Exécute le code de l'éditeur (aperçu + scan des zones) SANS
        jamais toucher à composant_layout.code_filtre (demande explicite
        : "la zone de code actuellement ne doit afficher que le filtre
        que l'on a mis pour tester ... si je modifie et que j'exécute,
        ça ne doit pas écraser ce qui a été sauvegardé"). L'écriture
        dans composant_layout.code_filtre + composant_layout_modifie
        (persistance disque) est désormais l'UNIQUE responsabilité de
        _sauvegarder_code_filtre (bouton Save explicite ci-dessous).

        REFONTE (cf. SPEC_refonte_filtre_zones_dynamiques.md) : le filtre
        ne retourne plus une image (`resultat`) mais (zones, valide) --
        cf. executer_filtre_layout. Contrairement à _appliquer_scindement
        (déjà sur ce principe pour les "cartes"), l'aperçu de droite
        n'est donc plus le retour brut du filtre : c'est une COPIE de
        l'image de référence avec chaque zone de `zones` dessinée en
        overlay (cv2.rectangle + nom), calculée CÔTÉ SYSTÈME -- jamais
        par le filtre lui-même (cf. docstring de executer_filtre_layout).
        Si valide[0] est False, la raison (valide[1]) s'affiche dans
        filtre_erreur_label -- MÊME emplacement que les vraies erreurs
        d'exécution, mais ce n'est pas une exception technique, juste
        "pas un exemplaire valide" (cf. SPEC, section "Règle de
        validation").

        self._dernieres_zones_filtre (dict nom -> rect) est mémorisé à
        chaque exécution, réussie ou non (vidé sinon), pour alimenter la
        liste "Zones dynamiques" en lecture seule (cf. _rafraichir_
        liste_zones_dynamiques) -- SANS lien avec les Zone statiques
        tracées à la main, qui restent gérées par le sous-onglet Zone.

        COLLISION DE NOMS (cf. SPEC, point tranché) : espace de noms
        PARTAGÉ entre Zone statiques et zones dynamiques -- si `zones`
        contient une clé identique au nom d'une Zone statique existante,
        le résultat est REJETÉ (message rouge, rien appliqué) plutôt que
        d'afficher silencieusement un doublon.

        CORRECTIF (retour utilisateur : "si j'appuie sur le bouton
        d'exécution ça va fonctionner ?") -- sans image de référence
        chargée (aucune capture faite pour ce ComposantLayout), le clic
        ne faisait RIEN de visible : return silencieux, comme s'il ne
        s'était rien passé. Message explicite désormais affiché dans ce
        cas, pour ne pas laisser croire que le filtre est cassé alors
        que c'est juste l'image de référence qui manque encore (cf.
        bouton Capturer, à utiliser en premier)."""
        if not VISION_DISPONIBLE:
            return
        if self._image_reference_bgr is None:
            self.filtre_erreur_label.setText(
                "Aucune image de référence chargée pour ce ComposantLayout -- "
                "il faut d'abord en capturer une avant de pouvoir tester un filtre."
            )
            self.filtre_erreur_label.show()
            return
        code = self.code_filtre_edit.toPlainText()
        # AJOUT : ce sous-onglet reprend la main sur le panneau de droite
        # partagé (cf. docstring de self._dernier_apercu_droite) -- posé
        # AVANT les returns anticipés ci-dessous pour qu'un champ vidé/
        # une erreur bascule aussi correctement l'affichage sur "filtre"
        # (donc sur son propre repli image brute) plutôt que de laisser
        # traîner un résultat de scindement d'un onglet précédent.
        self._dernier_apercu_droite = "filtre"
        if not code.strip():
            self._resultat_filtre_bgr = None
            self._dernieres_zones_filtre = {}
            self._couleurs_zones_filtre = {}
            self.filtre_erreur_label.hide()
            self._rafraichir_affichage_image()
            self._rafraichir_liste_zones_dynamiques()
            # AJOUT (cf. bloc "Zone de clic personnalisée -- zones
            # DYNAMIQUES") : _dernieres_zones_filtre vient de changer
            # (vidé) -- la grille de cartes doit suivre, sinon elle
            # continuerait d'afficher des ZoneDynamiqueCarte pour des
            # zones qui n'existent plus dans ce résultat.
            self._rafraichir_grille_zones()
            self._rafraichir_panneau_zone()
            return
        try:
            zones, valide = executer_filtre_layout(self._image_reference_bgr, code)
        except DetectionLayoutError as e:
            self.filtre_erreur_label.setText(str(e))
            self.filtre_erreur_label.show()
            self._resultat_filtre_bgr = None
            self._dernieres_zones_filtre = {}
            self._couleurs_zones_filtre = {}
            self._rafraichir_affichage_image()
            self._rafraichir_liste_zones_dynamiques()
            self._rafraichir_grille_zones()
            self._rafraichir_panneau_zone()
            return

        # AJOUT (REFONTE, cf. SPEC section "UI -- sous-onglet Filtre",
        # "Collision de noms") : espace de noms PARTAGÉ entre Zone
        # statiques et zones dynamiques -- un nom ne peut désigner qu'UNE
        # seule chose. Si le filtre renvoie une clé qui collisionne avec
        # le nom d'une Zone statique déjà tracée (self.composant_layout.
        # zones), c'est signalé au même endroit que valide[1] (message
        # rouge) plutôt que d'afficher silencieusement un doublon --
        # aucun overlay ni liste "Zones dynamiques" mis à jour dans ce
        # cas, le résultat n'est pas fiable tant que la collision existe.
        noms_zones_statiques = {z.nom for z in self.composant_layout.zones}
        noms_en_collision = sorted(set(zones) & noms_zones_statiques)
        if noms_en_collision:
            pluriel = "s" if len(noms_en_collision) > 1 else ""
            self.filtre_erreur_label.setText(
                f"Le filtre a nommé une zone dynamique en conflit avec une "
                f"Zone statique existante{pluriel} : {', '.join(noms_en_collision)}. "
                f"Renommez l'une des deux (un nom ne peut désigner qu'une seule zone)."
            )
            self.filtre_erreur_label.show()
            self._resultat_filtre_bgr = None
            self._dernieres_zones_filtre = {}
            self._couleurs_zones_filtre = {}
            self._rafraichir_affichage_image()
            self._rafraichir_liste_zones_dynamiques()
            self._rafraichir_grille_zones()
            self._rafraichir_panneau_zone()
            return

        self._dernieres_zones_filtre = zones
        # AJOUT (retour utilisateur : "les couleur doivent etre
        # aleatorie ... la legende tu la met dans le panneau de droit")
        # -- une couleur BGR tirée au hasard PAR ZONE et PAR EXÉCUTION
        # (donc pas dérivée du nom : deux exécutions successives peuvent
        # changer les couleurs). Stockée à part (nom -> (b, g, r)) pour
        # que _peupler_page_zone_legende affiche la même pastille que le
        # rectangle dessiné ci-dessous.
        self._couleurs_zones_filtre = {
            nom_zone: (
                random.randint(0, 255),
                random.randint(0, 255),
                random.randint(0, 255),
            )
            for nom_zone in zones
        }
        self._reconstruire_overlay_filtre()

        valide_bool, valide_raison = valide
        if not valide_bool:
            # PAS une erreur technique (cf. docstring ci-dessus) -- même
            # emplacement d'affichage que les erreurs d'exécution, mais
            # l'overlay des zones trouvées reste affiché malgré tout :
            # utile pour comprendre POURQUOI le filtre a jugé la carte
            # invalide (ex: vignette trouvée mais pas de menu 3 points).
            self.filtre_erreur_label.setText(valide_raison)
            self.filtre_erreur_label.show()
        else:
            self.filtre_erreur_label.hide()
        # REFONTE Zone : plus de blocs cliquables à calculer/afficher ici
        # (ApercuLayoutLabel n'a plus de MODE_BLOCS -- le tracé de Zone,
        # cf. _sur_toggle_mode_trace_zone, est le seul mode interactif
        # hors MODE_INSTANCES). Le résultat filtré reste affiché
        # normalement, mode inchangé (MODE_TRACE_ZONE si déjà actif,
        # MODE_INERTE sinon).
        self._rafraichir_affichage_image()
        self._rafraichir_liste_zones_dynamiques()
        # AJOUT (cf. bloc "Zone de clic personnalisée -- zones
        # DYNAMIQUES") : reconstruit la grille pour refléter le nouveau
        # jeu de zones dynamiques (self._dernieres_zones_filtre qui vient
        # d'être réassigné ci-dessus) -- une carte qui a disparu du
        # résultat disparaît de la grille, une nouvelle apparaît, et le
        # statut Personnalisée/Zone entière de chacune est relu depuis
        # composant_layout.zones_dynamiques_clic (persistant, cf. son
        # docstring) donc survit correctement à cette reconstruction.
        self._rafraichir_grille_zones()
        # AJOUT (légende dans le panneau de droite, cf. _peupler_page_
        # zone_legende) : simple rafraîchissement d'affichage -- si une
        # Zone statique est sélectionnée elle reste prioritaire (cf.
        # _rafraichir_panneau_zone), sinon la légende des zones dynamiques
        # qu'on vient de calculer ci-dessus remplace le placeholder vide.
        self._rafraichir_panneau_zone()

    def _sauvegarder_code_filtre(self):
        """Bouton "Save" (demande explicite : "en haut de l'éditeur de
        code, il doit y avoir le bouton save, avec confirmation de
        sauvegarde ... il doit y avoir un fichier qui contient le code
        du filtre qui a été validé"). Contrairement à _appliquer_filtre
        (test seul, jamais d'écriture), c'est l'UNIQUE point d'entrée qui
        écrit le contenu actuel de l'éditeur dans composant_layout.
        code_filtre puis émet composant_layout_modifie -- persistance
        réelle sur disque via le connect existant vers self.project.save
        (cf. docstring de classe ComposantLayoutConfigScreen), pas de
        nouveau mécanisme de fichier séparé : code_filtre est déjà un
        champ de ComposantLayout, lui-même sérialisé par Project.save
        (cf. to_dict/from_dict plus haut dans ce fichier)."""
        code = self.code_filtre_edit.toPlainText()
        self.composant_layout.code_filtre = code
        self.composant_layout_modifie.emit()
        # Confirmation visuelle (demande explicite "avec confirmation de
        # sauvegarde") -- même feedback bref que _bouton_copier (icône
        # temporaire + texte, restaurés après 1800ms ; un peu plus long
        # que les 1200ms des boutons copier/coller car le message texte
        # ci-dessous prend plus de temps à lire qu'une icône seule).
        self.bouton_sauvegarder_filtre.setIcon(qta.icon("mdi6.check", color=Mocha.green))
        self.filtre_sauvegarde_label.setText("Code du filtre sauvegardé.")
        self.filtre_sauvegarde_label.setStyleSheet(f"color: {Mocha.green};")
        self.filtre_sauvegarde_label.show()
        QTimer.singleShot(1800, self._restaurer_apres_sauvegarde_filtre)

    def _restaurer_apres_sauvegarde_filtre(self):
        self.bouton_sauvegarder_filtre.setIcon(qta.icon("mdi6.content-save-outline", color=Mocha.text))
        self.filtre_sauvegarde_label.hide()

    def _copier_image_composant_layout(self):
        """Bouton de copie ajouté dans la bande du haut, juste à côté de
        "Tester" (cf. son insertWidget dans __init__ -- demande explicite
        utilisateur, capture à l'appui : rectangle rose au même endroit).

        Copie l'image de RÉFÉRENCE de ce ComposantLayout (composant_layout.
        image_reference, résolue en absolu via get_app_data_dir(), MÊME
        pattern que _copier_toutes_images_donnees_test/rename_composant_
        layout) dans le presse-papier système -- MÊME mécanisme que
        partout ailleurs dans ce fichier pour copier une image (QMimeData.
        setUrls + QGuiApplication.clipboard().setMimeData, PAS setImage/
        setPixmap qui ne transporterait qu'un bitmap non collable comme
        fichier). Toujours le fichier tel qu'enregistré sur disque, jamais
        l'aperçu actuellement affiché à l'écran (qui peut être un overlay
        de filtre/scindement) -- cohérent avec la distinction déjà faite
        par ApercuDragHandle._sur_clic (capture SANS overlay) pour la
        bonne raison inverse : ici il n'y a même pas le choix, une seule
        image de référence existe par ComposantLayout.

        Ignore silencieusement (message d'erreur bref, pas de dialogue
        bloquant) si aucune image_reference n'est configurée ou si le
        fichier a disparu du disque -- même philosophie que les autres
        boutons de copie de cet écran (ne jamais lever d'exception visible
        pour un simple bouton de confort).

        BUGFIX : utilisait auparavant self.statut_label, qui n'existe
        PAS sur ComposantLayoutConfigScreen ni sur sa classe parente
        InstanceApercuScreen -- c'est un attribut d'une AUTRE sous-classe
        (TestComposantScreen). Ces deux cas d'erreur levaient donc un
        AttributeError au lieu d'afficher le message prévu. Remplacé par
        donnees_test_erreur_label, le seul label de statut/erreur
        réellement présent sur cet écran (même mécanisme show()/hide()
        que _copier_toutes_images_donnees_test)."""
        if not self.composant_layout.image_reference:
            self.donnees_test_erreur_label.setText("Aucune image de référence à copier pour ce ComposantLayout.")
            self.donnees_test_erreur_label.show()
            return
        chemin = (get_app_data_dir() / self.composant_layout.image_reference).resolve()
        if not chemin.is_file():
            self.donnees_test_erreur_label.setText("Image de référence introuvable sur disque.")
            self.donnees_test_erreur_label.show()
            return
        self.donnees_test_erreur_label.hide()

        mime = QMimeData()
        mime.setUrls([QUrl.fromLocalFile(str(chemin))])
        QGuiApplication.clipboard().setMimeData(mime)

        # Même feedback visuel que les autres boutons copier de ce fichier
        # (icône -> check vert temporaire, restaurée après 1200ms).
        self.bouton_copier_image_layout.setIcon(qta.icon("mdi6.check", color=Mocha.green))
        QTimer.singleShot(
            1200,
            lambda: self.bouton_copier_image_layout.setIcon(
                qta.icon("mdi6.content-copy", color=Mocha.text)
            ),
        )

    def _sur_toggle_valide_change(self, coche: bool):
        """Callback du toggle "Validé" (cf. son insertWidget dans __init__
        -- SPEC_lot_corrections_2026-09.md section 1). Modifie composant_
        layout.filtre_scindement_valide EN PLACE puis émet composant_
        layout_modifie, MÊME contrat que _sur_code_filtre_sauvegarder ci-
        dessous (persistance réelle déléguée à l'appelant via ce signal,
        cf. docstring de classe). Purement manuel : aucune vérification
        technique n'est déclenchée ici, coche = état choisi par
        l'utilisateur, rien de plus."""
        self.composant_layout.filtre_scindement_valide = coche
        self.composant_layout_modifie.emit()

    def _copier_codes_filtre_scindement_en_fichiers(self):
        """Bouton ajouté dans la bande du haut, juste à côté du bouton de
        copie d'image (cf. son insertWidget dans __init__ -- demande
        explicite utilisateur : "un code qui va copier une fois les code
        des deux filtre sous forme de fichier python distinct ... deux
        fichier python distinct pour chaque code").

        Écrit le contenu ACTUEL des deux éditeurs (code_filtre_edit et
        code_scindement_edit -- ce qui est affiché à l'écran à l'instant
        du clic, pas forcément la dernière version SAUVEGARDÉE via les
        boutons "Save" respectifs : cohérent avec _appliquer_filtre/
        _appliquer_scindement, qui testent eux aussi toujours le texte
        actuel de l'éditeur plutôt que composant_layout.code_filtre/
        code_scindement) dans DEUX fichiers .py RÉELS et DISTINCTS sur
        disque -- jamais un seul bloc de texte copié-collé (un Ctrl+V de
        texte ne donnerait qu'UN SEUL fichier/contenu à la fois, ce n'est
        pas ce qui est demandé ici).

        MÊME dossier temporaire dédié que ApercuDragHandle._sur_clic
        (Path(tempfile.gettempdir()) / "AutoniaX_drag", PAS Téléchargements,
        cf. son commentaire) et MÊME mécanisme de copie (QMimeData.setUrls
        + QGuiApplication.clipboard().setMimeData) que bouton_copier_
        image_layout ci-dessus -- un Ctrl+V dans l'Explorateur (ou toute
        appli acceptant un collage de fichiers) colle alors les deux
        fichiers .py d'un coup, exactement comme un Ctrl+C de sélection
        multiple de fichiers.

        Noms de fichiers dérivés du nom du ComposantLayout (plutôt que
        des noms fixes "code_filtre.py"/"code_scindement.py") pour éviter
        qu'un second export, pour un AUTRE ComposantLayout, écrase
        silencieusement dans le même dossier temporaire des fichiers du
        premier avant qu'ils n'aient été effectivement collés quelque
        part -- même prudence que les noms horodatés utilisés ailleurs
        dans ce fichier pour ce même dossier temporaire.

        N'écrit rien et affiche un message bref si les deux éditeurs sont
        vides (rien à exporter) -- jamais de fichier .py vide généré pour
        autant, même philosophie que les autres boutons de cet écran.

        BUGFIX : utilisait auparavant self.statut_label, inexistant sur
        cette classe (cf. docstring de _copier_image_composant_layout
        ci-dessus pour le détail) -- ce cas d'erreur levait donc un
        AttributeError au lieu d'afficher le message. Remplacé par
        donnees_test_erreur_label, même correctif que ci-dessus."""
        code_filtre = self.code_filtre_edit.toPlainText()
        code_scindement = self.code_scindement_edit.toPlainText()
        if not code_filtre.strip() and not code_scindement.strip():
            self.donnees_test_erreur_label.setText("Aucun code de filtre ou de scindement à copier pour le moment.")
            self.donnees_test_erreur_label.show()
            return
        self.donnees_test_erreur_label.hide()

        nom_base = re.sub(r"[^A-Za-z0-9_-]+", "_", self.composant_layout.nom or "ComposantLayout")
        dossier_tmp = Path(tempfile.gettempdir()) / "AutoniaX_drag"
        dossier_tmp.mkdir(parents=True, exist_ok=True)

        chemins = []
        if code_filtre.strip():
            chemin_filtre = dossier_tmp / f"{nom_base}_code_filtre.py"
            chemin_filtre.write_text(code_filtre, encoding="utf-8")
            chemins.append(chemin_filtre)
        if code_scindement.strip():
            chemin_scindement = dossier_tmp / f"{nom_base}_code_scindement.py"
            chemin_scindement.write_text(code_scindement, encoding="utf-8")
            chemins.append(chemin_scindement)

        mime = QMimeData()
        mime.setUrls([QUrl.fromLocalFile(str(chemin)) for chemin in chemins])
        QGuiApplication.clipboard().setMimeData(mime)

        # Même feedback visuel que les autres boutons copier de ce fichier
        # (icône -> check vert temporaire, restaurée après 1200ms).
        self.bouton_copier_codes_layout.setIcon(qta.icon("mdi6.check", color=Mocha.green))
        QTimer.singleShot(
            1200,
            lambda: self.bouton_copier_codes_layout.setIcon(
                qta.icon("mdi6.language-python", color=Mocha.text)
            ),
        )

    def _copier_export_pedagogique_ia(self):
        """Bouton ajouté dans la bande du haut, juste à côté du bouton
        Python (copie des codes -- cf. son insertWidget dans __init__)
        -- demande explicite utilisateur : "un bouton qui vas copier
        beaucoup de donnée que je vais envoyer à une IA pour lui montrer
        comment fonctionne un composant layout ... dans le but qu'il me
        réécrive le code de filtre pour un autre composant layout".

        Rassemble en UN SEUL copier-coller tout ce qu'il faut pour
        qu'une IA comprenne le fonctionnement de CE ComposantLayout et
        puisse en écrire un similaire pour un autre :
        - un prompt indicatif (00_LIRE_MOI_prompt_ia.txt) qui explique à
          l'IA CE QU'ELLE REÇOIT et CE QU'ON ATTEND D'ELLE EN RETOUR
          (correctif -- demande explicite utilisateur : "tu dois aussi
          mettre un prompt indicatif qu'il doit bien comprendre ce que
          cela fait, comme ça je vais lui envoyer d'autres images de
          composant layout et de scindement pour qu'il me donne le code
          de filtre et de scindement") ;
        - les DEUX mini-doc de règles (doc_regles_filtre.txt et
          doc_regles_scindement.txt), CHACUNE en fichier .txt à part
          entière, en plus d'être redonnée en commentaire d'en-tête des
          .py (correctif -- le premier jet ne les mettait QU'en
          commentaire dans les .py, donc rien n'était réellement copié
          d'équivalent aux deux mini-doc affichées à côté des éditeurs de
          code dans l'écran) ;
        - code_filtre.py ET code_scindement.py (texte ACTUEL des deux
          éditeurs, même source que _copier_codes_filtre_scindement_en_
          fichiers ci-dessus), chacun préfixé en commentaire par sa
          mini-doc respective (self._TEXTE_DOC_FILTRE/_TEXTE_DOC_
          SCINDEMENT, cf. colonne gauche des onglets Filtre/Scindement)
          -- pour qu'une IA lisant SEULEMENT le fichier .py ait aussi les
          règles du contrat (variables d'entrée/sortie attendues), sans
          avoir à deviner depuis le code seul ;
        - AJOUT (SPEC_lot_corrections_2026-09.md section 14) -- UN SEUL
          fichier zip (au lieu des images éparpillées en vrac aux côtés
          des .txt/.py ci-dessus) contenant EXCLUSIVEMENT les images,
          réparties en deux sous-dossiers internes : images_reference/
          (l'image de référence du ComposantLayout, composant_layout.
          image_reference, même résolution que bouton_copier_image_
          layout/_copier_toutes_images_donnees_test -- au plus un
          fichier) et images_test/ (TOUTES les images de test de
          scindement, get_composant_layout_tests_dir, même source que
          _copier_toutes_images_donnees_test -- les cas réels sur
          lesquels le scindement doit fonctionner, essentiels pour
          qu'une IA comprenne la variabilité d'entrée).

        MÊME mécanisme presse-papier fichiers que les trois boutons
        voisins (QMimeData.setUrls + QGuiApplication.clipboard().
        setMimeData, PAS de texte brut) : un seul Ctrl+V colle le prompt,
        les deux .txt de règles, les deux .py documentés, ET le zip
        d'images d'un coup -- exactement ce qu'il faut glisser dans une
        conversation avec une IA en une seule pièce jointe groupée (cf.
        décision 2 : le zip ne contient QUE les images, le reste continue
        de voyager en fichiers séparés aux côtés du zip, comportement
        inchangé pour ces éléments-là).
        MÊME dossier temporaire dédié (Path(tempfile.gettempdir()) /
        "AutoniaX_drag") et même préfixe de noms de fichiers dérivé du
        nom du ComposantLayout que _copier_codes_filtre_scindement_en_
        fichiers, pour ne jamais écraser un export fait pour un AUTRE
        ComposantLayout avant qu'il n'ait été collé quelque part.

        N'échoue jamais bruyamment si une pièce manque (pas de code de
        filtre/scindement encore écrit, pas d'image de référence, pas
        d'images de test) : inclut simplement ce qui est disponible,
        même philosophie "best effort" que les autres boutons de cet
        écran. N'écrit rien dans le presse-papier et affiche un message
        bref si RIEN n'est disponible du tout (cas limite : Composant
        Layout tout juste créé, sans rien configuré)."""
        chemins: list[Path] = []
        nom_base = re.sub(r"[^A-Za-z0-9_-]+", "_", self.composant_layout.nom or "ComposantLayout")
        dossier_tmp = Path(tempfile.gettempdir()) / "AutoniaX_drag"
        dossier_tmp.mkdir(parents=True, exist_ok=True)

        # 0. Prompt indicatif pour l'IA destinataire, TOUJOURS en tout
        # premier (nom de fichier préfixé "00_" pour qu'il trie en tête
        # même dans un gestionnaire de fichiers qui n'affiche pas l'ordre
        # du presse-papier) -- demande explicite utilisateur : "tu dois
        # aussi mettre un prompt indicatif qu'il doit bien comprendre ce
        # que cela fait comme ça je vais lui envoyer d'autres images de
        # composant layout et de scindement pour qu'il me donne le code
        # de filtre et de scindement". Explique en clair, à une IA qui ne
        # connaît pas AutoniaX, ce qu'elle reçoit et ce qu'on attend
        # d'elle en retour -- SANS dupliquer le contenu des deux mini-doc
        # (qui suivent en fichiers séparés, complètes) : seulement le
        # cadrage de la tâche et le format de réponse attendu.
        prompt_ia = (
            "Tu reçois un EXEMPLE complet de \"ComposantLayout\" pour le "
            "logiciel AutoniaX : une image de référence, le code Python "
            "de scindement (découpe la page en cartes candidates), le "
            "code Python de filtre (analyse une carte découpée et en "
            "extrait des zones nommées), et des images de test réelles "
            "sur lesquelles ce scindement doit fonctionner.\n\n"
            "Chaque code .py est précédé en commentaire de sa "
            "documentation complète (variables d'entrée/sortie "
            "attendues, bibliothèques disponibles, règles). Étudie "
            "l'exemple : la logique image (formes, couleurs, tailles, "
            "positions) qui permet à CE scindement et à CE filtre de "
            "fonctionner sur CES images.\n\n"
            "Je vais ensuite t'envoyer, dans un autre message : une "
            "NOUVELLE image de référence de ComposantLayout, et des "
            "NOUVELLES images de test de scindement -- pour un "
            "ComposantLayout DIFFÉRENT de celui-ci.\n\n"
            "Ce que j'attends de toi à ce moment-là : écrire le code de "
            "scindement ET le code de filtre pour ce nouveau "
            "ComposantLayout, en respectant EXACTEMENT le même contrat "
            "(mêmes variables d'entrée/sortie, mêmes bibliothèques "
            "disponibles) que dans l'exemple ci-joint, mais avec la "
            "logique adaptée aux nouvelles images. Réponds avec les deux "
            "blocs de code Python prêts à coller (un pour le scindement, "
            "un pour le filtre), sans les recopier ici -- attends "
            "d'abord les nouvelles images."
        )
        chemin_prompt = dossier_tmp / f"{nom_base}_00_LIRE_MOI_prompt_ia.txt"
        chemin_prompt.write_text(prompt_ia, encoding="utf-8")
        chemins.append(chemin_prompt)

        # 1. Image de référence du ComposantLayout -- AJOUT (SPEC_lot_
        # corrections_2026-09.md section 14, décisions 1+2) : n'est PLUS
        # ajoutée directement à `chemins` (qui deviendrait un tas de
        # fichiers indifférenciés une fois les images de test ajoutées
        # au point 5) -- mise en réserve dans `chemin_image_reference`,
        # empaquetée plus bas dans un unique zip sous images_reference/,
        # aux côtés de images_test/ (cf. bloc de compression après le
        # point 5). Tout le reste de cette méthode (prompt, mini-doc,
        # .py) continue d'aller tel quel dans `chemins`, en dehors du zip
        # (cf. décision 2 : "restent en dehors du zip").
        chemin_image_reference: Optional[Path] = None
        if self.composant_layout.image_reference:
            candidate = (get_app_data_dir() / self.composant_layout.image_reference).resolve()
            if candidate.is_file():
                chemin_image_reference = candidate

        # 2. Mini-doc du filtre ET du scindement, CHACUNE dans son
        # propre fichier .txt à part entière (en plus d'être redonnée en
        # commentaire d'en-tête des .py ci-dessous) -- CORRECTIF : la
        # version précédente ne les mettait QU'en commentaire dans les
        # .py, ce qui les rendait faciles à rater/tronquer pour une IA
        # qui ne lirait que le code. Ici, les deux règles du contrat sont
        # un livrable à part, lisible seul, exactement comme les boutons
        # "Copier la documentation" à côté de chaque QLabel d'aide (cf.
        # self._TEXTE_DOC_FILTRE/_TEXTE_DOC_SCINDEMENT, même texte, une
        # seule source -- pas de duplication de contenu, juste de
        # présentation).
        chemin_doc_filtre = dossier_tmp / f"{nom_base}_doc_regles_filtre.txt"
        chemin_doc_filtre.write_text(
            "COMMENT ÉCRIRE UN FILTRE\n\n" + self._TEXTE_DOC_FILTRE, encoding="utf-8"
        )
        chemins.append(chemin_doc_filtre)

        chemin_doc_scindement = dossier_tmp / f"{nom_base}_doc_regles_scindement.txt"
        chemin_doc_scindement.write_text(
            "COMMENT ÉCRIRE UN SCINDEMENT\n\n" + self._TEXTE_DOC_SCINDEMENT, encoding="utf-8"
        )
        chemins.append(chemin_doc_scindement)

        # 3. Code de filtre + sa mini-doc en commentaire d'en-tête (le
        # code reste aussi autoporteur seul, sans dépendre du .txt
        # ci-dessus).
        code_filtre = self.code_filtre_edit.toPlainText()
        if code_filtre.strip():
            doc_filtre_commentee = "\n".join(
                f"# {ligne}" if ligne else "#"
                for ligne in self._TEXTE_DOC_FILTRE.split("\n")
            )
            contenu_filtre = (
                f"# === Documentation : comment écrire un filtre ===\n"
                f"{doc_filtre_commentee}\n"
                f"# ================================================\n\n"
                f"{code_filtre}"
            )
            chemin_filtre = dossier_tmp / f"{nom_base}_code_filtre.py"
            chemin_filtre.write_text(contenu_filtre, encoding="utf-8")
            chemins.append(chemin_filtre)

        # 4. Code de scindement + sa mini-doc en commentaire d'en-tête.
        code_scindement = self.code_scindement_edit.toPlainText()
        if code_scindement.strip():
            doc_scindement_commentee = "\n".join(
                f"# {ligne}" if ligne else "#"
                for ligne in self._TEXTE_DOC_SCINDEMENT.split("\n")
            )
            contenu_scindement = (
                f"# === Documentation : comment écrire un scindement ===\n"
                f"{doc_scindement_commentee}\n"
                f"# ===================================================\n\n"
                f"{code_scindement}"
            )
            chemin_scindement = dossier_tmp / f"{nom_base}_code_scindement.py"
            chemin_scindement.write_text(contenu_scindement, encoding="utf-8")
            chemins.append(chemin_scindement)

        # 5. Toutes les images de test de scindement (même source/tri
        # que _copier_toutes_images_donnees_test), dédupliquées par
        # chemin résolu au cas (anormal) où l'une d'elles coïnciderait
        # avec l'image de référence mise en réserve plus haut.
        dossier_tests = get_composant_layout_tests_dir(self.composant_layout)
        chemins_resolus = {p.resolve() for p in chemins}
        if chemin_image_reference is not None:
            chemins_resolus.add(chemin_image_reference)
        images_test = sorted(
            [
                p for p in dossier_tests.iterdir()
                if p.is_file()
                and p.suffix.lower() in EXTENSIONS_IMAGE_ACCEPTEES
                and p.resolve() not in chemins_resolus
            ],
            key=lambda p: p.name.lower(),
        )

        # AJOUT (SPEC_lot_corrections_2026-09.md section 14) -- UN SEUL
        # zip (cf. décision 1), avec deux sous-dossiers internes
        # images_reference/ et images_test/, contenant UNIQUEMENT les
        # images (cf. décision 2 -- le prompt/mini-doc/.py restent dans
        # `chemins`, copiés à part, comportement inchangé pour eux). Rien
        # à zipper si ni référence ni images de test (cas limite déjà
        # couvert par le garde-fou `if not chemins` plus bas, qui teste
        # `chemins` seul -- volontaire : un export avec SEULEMENT le
        # prompt + du code, sans aucune image, reste un export valide).
        if chemin_image_reference is not None or images_test:
            # Indicateur visuel temporaire pendant la compression (cf.
            # décision 3) -- curseur sablier, la compression d'un gros
            # dossier de test pouvant prendre un instant perceptible.
            # setOverrideCursor/restoreOverrideCursor s'empilent proprement
            # (Qt garantit le retour au curseur normal après un seul
            # restore ici, un seul override posé) ; le try/finally
            # garantit le retour au curseur normal même en cas d'erreur
            # de compression (ex. disque plein) plutôt que de laisser le
            # sablier bloqué indéfiniment.
            QApplication.setOverrideCursor(Qt.WaitCursor)
            QApplication.processEvents()
            try:
                chemin_zip = dossier_tmp / f"{nom_base}_images.zip"
                with zipfile.ZipFile(chemin_zip, "w", zipfile.ZIP_DEFLATED) as archive:
                    if chemin_image_reference is not None:
                        archive.write(
                            chemin_image_reference,
                            arcname=f"images_reference/{chemin_image_reference.name}",
                        )
                    for image in images_test:
                        archive.write(image, arcname=f"images_test/{image.name}")
                chemins.append(chemin_zip)
            finally:
                QApplication.restoreOverrideCursor()

        if not chemins:
            # BUGFIX (avant même publication) -- self.statut_label
            # n'existe PAS sur ComposantLayoutConfigScreen (ni sur sa
            # classe parente InstanceApercuScreen) : c'est un attribut de
            # TestComposantScreen, une AUTRE sous-classe de InstanceApercu
            # Screen -- confondre les deux aurait levé un AttributeError
            # dès le premier cas "rien à exporter" rencontré. Utilise
            # donnees_test_erreur_label, le seul label de statut/erreur
            # réellement présent sur CET écran (déjà utilisé par
            # _copier_toutes_images_donnees_test un peu plus haut, même
            # mécanisme show()/hide()). Voir aussi la remarque séparée
            # sur _copier_image_composant_layout/_copier_codes_filtre_
            # scindement_en_fichiers ci-dessus, qui portent le même bug
            # préexistant (statut_label inexistant), non corrigé ici pour
            # rester dans le périmètre de cet ajout.
            self.donnees_test_erreur_label.setText(
                "Rien à exporter pour l'IA : configurez d'abord une image de référence, "
                "du code, ou des images de test pour ce ComposantLayout."
            )
            self.donnees_test_erreur_label.show()
            return

        mime = QMimeData()
        mime.setUrls([QUrl.fromLocalFile(str(chemin)) for chemin in chemins])
        QGuiApplication.clipboard().setMimeData(mime)
        self.donnees_test_erreur_label.hide()

        # Même feedback visuel que les autres boutons copier de ce fichier
        # (icône -> check vert temporaire, restaurée après 1200ms).
        self.bouton_copier_export_ia.setIcon(qta.icon("mdi6.check", color=Mocha.green))
        QTimer.singleShot(
            1200,
            lambda: self.bouton_copier_export_ia.setIcon(
                qta.icon("mdi6.robot-outline", color=Mocha.text)
            ),
        )

    def _reinitialiser_code_filtre(self):
        """Bouton "Réinitialiser" (demande explicite : "il doit y avoir
        le bouton de réinitialisation qui doit afficher le code qui est
        sauvegardé actuellement"). Recharge composant_layout.code_filtre
        -- la dernière version SAUVEGARDÉE (via Save ci-dessus), pas
        forcément celle actuellement affichée -- dans l'éditeur,
        écrasant tout code tapé/testé depuis. Ne réexécute PAS le filtre
        automatiquement : recharger le texte et lancer un scan sont deux
        actions distinctes dans ce sous-onglet (cf. bouton "Exécuter le
        filtre" séparé), même principe que le reste de cette refonte.

        Même repli que le chargement initial (cf. CODE_FILTRE_PAR_DEFAUT
        dans _construire_sous_onglet_filtre) : si rien n'a jamais été
        sauvegardé, réinitialiser revient au filtre de démo plutôt qu'à
        un champ vide."""
        self.code_filtre_edit.setPlainText(
            self.composant_layout.code_filtre or self.CODE_FILTRE_PAR_DEFAUT
        )
        self.filtre_erreur_label.hide()

    def _appliquer_scindement(self):
        """Bouton "Exécuter le scindement" -- pendant EXACT de
        _appliquer_filtre pour code_scindement (mêmes garde-fous : VISION_
        DISPONIBLE, image de référence absente, code vide -- mêmes
        messages adaptés). Contrairement au filtre, dont le résultat est
        un masque affiché tel quel, le résultat ici est une IMAGE DE
        RECTANGLES : une copie de l'image de référence (page entière)
        avec chaque rectangle de "cartes" dessiné en overlay (cv2.rectangle,
        même esprit que dessiner_zones côté detection_carte_video.py) --
        c'est la façon la plus directe de juger visuellement si le
        découpage obtenu correspond aux cartes réellement présentes sur
        la page, AVANT même de se soucier du filtre qui s'appliquera
        ensuite à chacune.

        N'écrit jamais dans composant_layout.code_scindement (test seul)
        -- cf. _sauvegarder_code_scindement, seule responsable de la
        persistance, même contrat que le filtre."""
        if not VISION_DISPONIBLE:
            return
        if self._image_reference_bgr is None:
            self.scindement_erreur_label.setText(
                "Aucune image de référence chargée pour ce ComposantLayout -- "
                "il faut d'abord en capturer une avant de pouvoir tester un scindement."
            )
            self.scindement_erreur_label.show()
            return
        code = self.code_scindement_edit.toPlainText()
        self._dernier_apercu_droite = "scindement"
        if not code.strip():
            self._resultat_scindement_bgr = None
            self.scindement_erreur_label.hide()
            self._rafraichir_affichage_image()
            return
        try:
            cartes = executer_code_scindement(self._image_reference_bgr, code)
        except DetectionScindementError as e:
            self.scindement_erreur_label.setText(str(e))
            self.scindement_erreur_label.show()
            self._resultat_scindement_bgr = None
            self._rafraichir_affichage_image()
            return
        self.scindement_erreur_label.hide()
        overlay = self._image_reference_bgr.copy()
        if overlay.ndim != 3:
            overlay = cv2.cvtColor(overlay, cv2.COLOR_GRAY2BGR)
        for (x, y, largeur, hauteur) in cartes:
            cv2.rectangle(overlay, (x, y), (x + largeur, y + hauteur), (0, 255, 0), 2)
        self._resultat_scindement_bgr = overlay
        self._rafraichir_affichage_image()

    def _sauvegarder_code_scindement(self):
        """Bouton "Save" -- pendant EXACT de _sauvegarder_code_filtre pour
        code_scindement, même contrat de persistance (écrit dans
        composant_layout.code_scindement puis émet composant_layout_
        modifie, sérialisé par Project.save via to_dict/from_dict)."""
        code = self.code_scindement_edit.toPlainText()
        self.composant_layout.code_scindement = code
        self.composant_layout_modifie.emit()
        self.bouton_sauvegarder_scindement.setIcon(qta.icon("mdi6.check", color=Mocha.green))
        self.scindement_sauvegarde_label.setText("Code du scindement sauvegardé.")
        self.scindement_sauvegarde_label.setStyleSheet(f"color: {Mocha.green};")
        self.scindement_sauvegarde_label.show()
        QTimer.singleShot(1800, self._restaurer_apres_sauvegarde_scindement)

    def _restaurer_apres_sauvegarde_scindement(self):
        self.bouton_sauvegarder_scindement.setIcon(qta.icon("mdi6.content-save-outline", color=Mocha.text))
        self.scindement_sauvegarde_label.hide()

    def _reinitialiser_code_scindement(self):
        """Bouton "Réinitialiser" -- pendant EXACT de _reinitialiser_code_
        filtre pour code_scindement (recharge la dernière version
        SAUVEGARDÉE, écrasant tout code tapé/testé depuis ; repli sur
        CODE_SCINDEMENT_PAR_DEFAUT si rien n'a jamais été sauvegardé)."""
        self.code_scindement_edit.setPlainText(
            self.composant_layout.code_scindement or self.CODE_SCINDEMENT_PAR_DEFAUT
        )
        self.scindement_erreur_label.hide()

    def _rafraichir_affichage_image(self):
        """AJOUT (demande explicite : "ajouter à côté de l'image, la
        même image mais filtrée ... si pas de code de filtre on doit
        juste dupliquer simplement") -- refonte complète : les DEUX
        labels sont désormais peuplés à chaque appel, plus de bascule
        via toggle_brut_filtre (retiré, cf. _construire_sous_onglet_
        filtre -- n'avait plus de sens avec les deux versions visibles
        simultanément) :
          - apercu_layout_label (gauche, interactif) : TOUJOURS l'image
            de référence brute, jamais le résultat du filtre -- c'est
            elle (avec apercu_layout_filtre_label) qui reçoit le tracé
            de Zone (coordonnées toujours relatives à l'image brute,
            cf. _sur_zone_tracee).
          - apercu_layout_filtre_label (droite, inerte) : le résultat du
            filtre (_resultat_filtre_bgr) s'il existe, sinon une SIMPLE
            DUPLICATION de l'image brute (demande explicite ci-dessus,
            pas de placeholder vide ni de texte -- juste la même image)."""
        if self._image_reference_bgr is None:
            return
        image_brute_bgr_3c = (
            self._image_reference_bgr if self._image_reference_bgr.ndim == 3
            else cv2.cvtColor(self._image_reference_bgr, cv2.COLOR_GRAY2BGR)
        )
        h, w = image_brute_bgr_3c.shape[:2]
        image_brute_rgb = cv2.cvtColor(image_brute_bgr_3c, cv2.COLOR_BGR2RGB)
        qimage_brute = QImage(image_brute_rgb.data, w, h, image_brute_rgb.strides[0], QImage.Format_RGB888).copy()
        self.apercu_layout_label.afficher_image(qimage_brute)

        # Aperçu de droite : reflète le dernier résultat exécuté, filtre
        # OU scindement (cf. docstring de self._dernier_apercu_droite --
        # les deux sous-onglets partagent ce même panneau). Résultat réel
        # si disponible pour la source active, sinon duplication simple
        # de l'image brute déjà convertie ci-dessus (pas de code saisi,
        # ou jamais exécuté -- même image des deux côtés, demande
        # explicite d'origine pour le filtre, conservée à l'identique
        # pour le scindement).
        resultat_actif = (
            self._resultat_scindement_bgr if self._dernier_apercu_droite == "scindement"
            else self._resultat_filtre_bgr
        )
        if resultat_actif is not None:
            image_filtre_bgr_3c = (
                resultat_actif if resultat_actif.ndim == 3
                else cv2.cvtColor(resultat_actif, cv2.COLOR_GRAY2BGR)
            )
            hf, wf = image_filtre_bgr_3c.shape[:2]
            image_filtre_rgb = cv2.cvtColor(image_filtre_bgr_3c, cv2.COLOR_BGR2RGB)
            qimage_filtre = QImage(image_filtre_rgb.data, wf, hf, image_filtre_rgb.strides[0], QImage.Format_RGB888).copy()
            self.apercu_layout_filtre_label.afficher_image(qimage_filtre)
        else:
            self.apercu_layout_filtre_label.afficher_image(qimage_brute)

    # ------------------------------------------------------------------
    # Zone (REFONTE COMPLÈTE -- ancienne ZoneForme puis Forme, cf.
    # docstring de la dataclass Zone) : tracé libre sur le ComposantLayout
    # ENTIER, seul mécanisme de création/modification -- activé par le
    # bouton dédié "Tracer"/"Mettre à jour le tracé" du panneau de droite,
    # cible TOUJOURS la Zone actuellement sélectionnée (cf.
    # _construire_panneau_zone/_sur_toggle_mode_trace_zone). Plus de
    # dialogue de nommage après coup (ancien mécanisme _valider_zone_
    # nommee/_nommage_zone_widget, jamais branché à la grille de cards et
    # source du crash 'liste_zones' -- retiré).
    # ------------------------------------------------------------------
    def _sur_toggle_mode_trace_zone(self, actif: bool):
        """Bascule MODE_TRACE_ZONE sur LES DEUX aperçus (demande
        explicite confirmée : "un bouton dédié" -- évite tout tracé par
        erreur en dehors de ce mode explicitement activé). Repasse en
        MODE_INERTE (comportement par défaut) quand désactivé. Ne peut
        être activé que si une Zone est sélectionnée (le bouton n'est
        visible que sur _page_zone_config, cf. _construire_panneau_zone,
        donc ce cas ne devrait jamais se produire, mais on protège quand
        même contre un toggle programmatique sans sélection)."""
        if actif and self._zone_selectionnee_courante() is None:
            self.bouton_tracer_zone.blockSignals(True)
            self.bouton_tracer_zone.setChecked(False)
            self.bouton_tracer_zone.blockSignals(False)
            return
        self._mode_trace_zone_actif = actif
        nouveau_mode = ApercuLayoutLabel.MODE_TRACE_ZONE if actif else ApercuLayoutLabel.MODE_INERTE
        self.apercu_layout_label.definir_mode(nouveau_mode)
        # L'aperçu filtré n'a pas de blocs à sélectionner (bloc_clique
        # n'y est jamais connecté, cf. _construire_onglet_formes) --
        # MODE_TRACE_ZONE quand actif, sinon MODE_INERTE (jamais
        # MODE_BLOCS, qui n'aurait aucun effet utile dessus).
        self.apercu_layout_filtre_label.definir_mode(
            ApercuLayoutLabel.MODE_TRACE_ZONE if actif else ApercuLayoutLabel.MODE_INERTE
        )
        if not actif:
            self.apercu_layout_label.effacer_trace()
            self.apercu_layout_filtre_label.effacer_trace()

    def _sur_zone_tracee(self, rect_image: QRect):
        """rect_image : coordonnées de l'IMAGE ENTIÈRE du ComposantLayout
        (REFONTE -- plus recadrée sur une Forme, cf. docstring de la
        dataclass Zone) -- émis par LEQUEL des deux aperçus l'utilisateur
        a utilisé pour tracer (les deux sont connectés au même callback,
        cf. _construire_onglet_formes).

        Écrit DIRECTEMENT dans zone.rect de la Zone actuellement
        sélectionnée (demande explicite : "si on trace et que on veut
        modifier et bien c'est plus tracer mais update, donc mettre à
        jour le tracé") -- pas de création d'une nouvelle Zone ici, la
        Zone existe déjà depuis le bouton "+" (cf.
        _creer_zone_avec_nom_auto) ; tracer ne fait que remplir/remplacer
        son rect."""
        if not self._mode_trace_zone_actif or self._image_reference_bgr is None:
            return
        zone = self._zone_selectionnee_courante()
        if zone is None:
            return
        h_img, w_img = self._image_reference_bgr.shape[:2]
        if w_img <= 0 or h_img <= 0:
            return
        # Zone.rect est désormais relatif au cL ENTIER, mêmes fractions
        # 0.0-1.0 que Forme.rect_relatif (cf. docstring de Zone) --
        # transformation directe depuis les dimensions de image_reference,
        # sans passer par le rectangle d'une Forme comme avant.
        rx = rect_image.x() / w_img
        ry = rect_image.y() / h_img
        rl = rect_image.width() / w_img
        rh = rect_image.height() / h_img
        zone.rect = ZoneClicRect(x=rx, y=ry, largeur=rl, hauteur=rh)
        self.composant_layout_modifie.emit()

        # Sort du mode traçage (un seul rectangle par activation du
        # bouton, cohérent avec le comportement "une tentative par clic"
        # déjà en place ailleurs dans cet écran) et rafraîchit tout ce qui
        # dépend du rect : fond permanent sur les aperçus, spinboxes du
        # panneau, texte du bouton (passe de "Tracer" à "Mettre à jour le
        # tracé"), et la pastille de statut sur la card correspondante.
        self.bouton_tracer_zone.setChecked(False)
        self._rafraichir_apercu_zones_nommees()
        self._rafraichir_panneau_zone()
        carte = self._zone_cartes.get(zone.nom)
        if carte is not None:
            carte.rafraichir_statut(zone)

    def _rafraichir_apercu_zones_nommees(self):
        """Recalcule les rectangles (coords image_reference) de toutes les
        Zone déjà nommées, transmis à ApercuLayoutLabel pour affichage --
        CORRECTIF (retour utilisateur : "ça doit s'afficher uniquement
        quand on clique sur un rect") : depuis ce correctif, paintEvent
        n'affiche plus QUE la Zone actuellement SÉLECTIONNÉE
        (self._nom_zone_selectionnee, en couleur_zone_selectionnee) --
        toutes les autres restent en mémoire (utile pour la collision de
        noms, le tracé, etc.) mais ne sont plus dessinées tant qu'elles
        ne sont pas sélectionnées. L'ancien affichage permanent de TOUTES
        les Zone (couleur_zone) créait des rectangles parasites façon
        bandes sur l'image, notamment quand plusieurs Zone étaient bord-
        à-bord ou proches des limites de l'image."""
        if self._image_reference_bgr is None:
            self.apercu_layout_label.definir_zones_nommees({})
            self.apercu_layout_filtre_label.definir_zones_nommees({})
            return
        h_img, w_img = self._image_reference_bgr.shape[:2]
        zones_rects = {}
        for zone in self.composant_layout.zones:
            zx, zy, zl, zh = zone.rect.x, zone.rect.y, zone.rect.largeur, zone.rect.hauteur
            zones_rects[zone.nom] = QRect(round(zx * w_img), round(zy * h_img), round(zl * w_img), round(zh * h_img))
        for label in (self.apercu_layout_label, self.apercu_layout_filtre_label):
            label.definir_zones_nommees(
                zones_rects,
                couleur=self.composant_layout.couleur_zone,
                epaisseur=self.composant_layout.epaisseur_zone,
                nom_selectionnee=self._nom_zone_selectionnee,
                couleur_selectionnee=self.composant_layout.couleur_zone_selectionnee,
            )

    def _zone_selectionnee_courante(self) -> Optional["Zone"]:
        nom = self._nom_zone_selectionnee
        if nom is None:
            return None
        return next((z for z in self.composant_layout.zones if z.nom == nom), None)

    def _sur_nom_zone_selectionnee_change(self):
        """editingFinished du champ nom dans le panneau (demande
        explicite : "il ya maintenant tout les propriété éditable,
        notamment le nom") -- même pattern de validation que
        _sur_nom_composant_layout_change : anti-vide, anti-collision
        DANS CE ComposantLayout (cf. _nom_zone_disponible), restaure
        l'ancien nom affiché si invalide plutôt que de planter ou de
        créer un doublon silencieux.

        AJOUT (REFONTE, cf. SPEC_refonte_filtre_zones_dynamiques.md,
        "espace de noms partagé") : la collision est aussi vérifiée
        contre les zones DYNAMIQUES actuellement affichées (self.
        _dernieres_zones_filtre, dernier résultat du filtre) -- pas
        seulement contre les autres Zone statiques. Un nom ne peut
        désigner qu'UNE seule chose, peu importe laquelle des deux
        catégories a été nommée en premier."""
        zone = self._zone_selectionnee_courante()
        if zone is None:
            return
        nouveau_nom = self.nom_zone_selectionnee_edit.text().strip()
        ancien_nom = zone.nom
        if not nouveau_nom or nouveau_nom == ancien_nom:
            self.nom_zone_selectionnee_edit.setText(ancien_nom)
            self.erreur_nom_zone_label.hide()
            return
        if any(z.nom == nouveau_nom for z in self.composant_layout.zones if z is not zone):
            self.erreur_nom_zone_label.setText(
                f"Une Zone nommée « {nouveau_nom} » existe déjà dans ce ComposantLayout."
            )
            self.erreur_nom_zone_label.show()
            self.nom_zone_selectionnee_edit.setText(ancien_nom)
            return
        if nouveau_nom in self._dernieres_zones_filtre:
            self.erreur_nom_zone_label.setText(
                f"« {nouveau_nom} » est actuellement utilisé par une zone dynamique "
                f"du filtre -- choisissez un autre nom (un nom ne peut désigner "
                f"qu'une seule zone, statique ou dynamique)."
            )
            self.erreur_nom_zone_label.show()
            self.nom_zone_selectionnee_edit.setText(ancien_nom)
            return
        self.erreur_nom_zone_label.hide()
        zone.nom = nouveau_nom
        self.composant_layout_modifie.emit()
        self._nom_zone_selectionnee = nouveau_nom

        carte = self._zone_cartes.pop(ancien_nom, None)
        if carte is not None:
            carte.renommer(nouveau_nom)
            self._zone_cartes[nouveau_nom] = carte
        self._rafraichir_apercu_zones_nommees()

    def _supprimer_zone_selectionnee(self):
        """Bouton "Supprimer cette Zone" du panneau de droite (déplacé
        depuis l'ancien sous-onglet, qui n'a plus de liste avec sélection
        + bouton associé -- cf. _construire_sous_onglet_zones)."""
        zone = self._zone_selectionnee_courante()
        if zone is None:
            return
        if self.bouton_tracer_zone.isChecked():
            self.bouton_tracer_zone.setChecked(False)
        self.composant_layout.zones = [z for z in self.composant_layout.zones if z.nom != zone.nom]
        self.composant_layout_modifie.emit()
        self._nom_zone_selectionnee = None
        self._rafraichir_grille_zones()
        self._rafraichir_apercu_zones_nommees()
        self._rafraichir_panneau_zone()

    def _sur_nom_zone_rect_change(self, _valeur: float = 0.0):
        """Édition directe des fractions de la Zone sélectionnée par
        spinboxes (cf. _construire_panneau_zone) -- même pattern que
        _sur_zone_clic_rect_change côté Forme."""
        zone = self._zone_selectionnee_courante()
        if zone is None:
            return
        zone.rect = ZoneClicRect(
            x=self.zone_rect_x_spin.value(),
            y=self.zone_rect_y_spin.value(),
            largeur=self.zone_rect_largeur_spin.value(),
            hauteur=self.zone_rect_hauteur_spin.value(),
        )
        self.composant_layout_modifie.emit()
        self._rafraichir_apercu_zones_nommees()
        carte = self._zone_cartes.get(zone.nom)
        if carte is not None:
            carte.rafraichir_statut(zone)

    # ------------------------------------------------------------------
    # Zone de clic personnalisée PAR ZONE (demande explicite utilisateur :
    # "on vas aussi mettre la notion de zone personnalisée pour chaque
    # zone pour un ComposantLayout ... quand on clic dessus ça suit
    # exactement la même logique que le bouton personnaliser d'un
    # ComposantSingle") -- même trio combo/bouton/ZoneClicSelector que
    # ComposantsScreen._start_definir_zone_clic/_on_zone_clic_definie,
    # mais ciblant zone.zone_clic_mode/zone_clic_rect (Zone d'un cL) au
    # lieu de composant.zone_clic_mode/zone_clic_rect (ComposantSingle),
    # et ouvert sur l'image DÉCOUPÉE de cette Zone (cf. docstring du champ
    # Zone.zone_clic_rect) plutôt que sur l'image entière du composant.
    # ------------------------------------------------------------------
    def _sur_zone_clic_zone_mode_change(self, _index: int):
        """currentIndexChanged du combo zone_clic_zone_combo -- même
        pattern que ComposantReglagesPanel._on_zone_clic_mode_changed."""
        zone = self._zone_selectionnee_courante()
        if zone is None:
            return
        nouveau_mode = self.zone_clic_zone_combo.currentData()
        zone.zone_clic_mode = nouveau_mode
        self.definir_zone_clic_zone_button.setVisible(nouveau_mode == "personnalise")
        self.zone_clic_zone_erreur_label.hide()
        self.composant_layout_modifie.emit()

    def _image_zone_selectionnee_decoupee(self, zone: "Zone") -> Optional[QImage]:
        """Découpe, depuis self._image_reference_bgr, le rectangle de
        CETTE Zone précise (zone.rect, fractions du cL entier -- même
        conversion fraction -> pixels que _rafraichir_apercu_zones_
        nommees) et renvoie l'image obtenue en QImage RGB888 (même
        conversion cv2 BGR -> QImage que _rafraichir_affichage_image).
        None si l'image de référence est absente ou si zone.rect est
        vide/hors image (Zone pas encore tracée -- cf. bouton_tracer_zone,
        Zone.rect.est_vide()) : impossible de définir une zone de clic
        relative à une Zone qui n'a elle-même aucun rectangle."""
        if self._image_reference_bgr is None or zone.rect.est_vide():
            return None
        h_img, w_img = self._image_reference_bgr.shape[:2]
        x = round(zone.rect.x * w_img)
        y = round(zone.rect.y * h_img)
        largeur = round(zone.rect.largeur * w_img)
        hauteur = round(zone.rect.hauteur * h_img)
        # Bornage défensif dans les limites de l'image de référence, même
        # esprit que Zone.rect potentiellement tracée près d'un bord.
        x = max(0, min(x, w_img - 1))
        y = max(0, min(y, h_img - 1))
        largeur = max(1, min(largeur, w_img - x))
        hauteur = max(1, min(hauteur, h_img - y))
        decoupe_bgr = self._image_reference_bgr[y:y + hauteur, x:x + largeur]
        decoupe_bgr_3c = (
            decoupe_bgr if decoupe_bgr.ndim == 3
            else cv2.cvtColor(decoupe_bgr, cv2.COLOR_GRAY2BGR)
        )
        decoupe_rgb = cv2.cvtColor(decoupe_bgr_3c, cv2.COLOR_BGR2RGB)
        hd, wd = decoupe_rgb.shape[:2]
        return QImage(decoupe_rgb.data, wd, hd, decoupe_rgb.strides[0], QImage.Format_RGB888).copy()

    def _start_definir_zone_clic_zone(self):
        """Bouton "Définir la zone..." du panneau -- ouvre ZoneClicSelector
        sur l'image DÉCOUPÉE de la Zone sélectionnée (cf. _image_zone_
        selectionnee_decoupee), pas sur l'image entière du cL : le
        rectangle personnalisé reste ainsi relatif à cette Zone précise."""
        zone = self._zone_selectionnee_courante()
        if zone is None:
            return
        image = self._image_zone_selectionnee_decoupee(zone)
        if image is None or image.isNull():
            self.zone_clic_zone_erreur_label.setText(
                "Cette Zone doit d'abord être tracée (bouton « Tracer » "
                "ci-dessus) avant de pouvoir définir sa zone de clic."
            )
            self.zone_clic_zone_erreur_label.show()
            return
        self.zone_clic_zone_erreur_label.hide()

        zone_initiale = None
        if not zone.zone_clic_rect.est_vide():
            r = zone.zone_clic_rect
            zone_initiale = QRect(r.x, r.y, r.largeur, r.hauteur)

        # Référence forte conservée le temps de l'édition (même raison que
        # ComposantsScreen._zone_clic_selector : éviter le garbage-collect
        # prématuré d'une fenêtre non-modale). Le NOM de la Zone (pas
        # l'objet lui-même) est capturé dans la lambda ci-dessous : si la
        # Zone est supprimée ou renommée pendant que cette fenêtre reste
        # ouverte, _on_zone_clic_zone_definie la retrouve par nom via
        # _zone_selectionnee_courante-like lookup et n'écrit rien si elle
        # n'existe plus (même garde-fou que ComposantsScreen._on_zone_
        # clic_definie avec project.find_composant).
        nom_zone_cible = zone.nom
        self._zone_clic_zone_selector = ZoneClicSelector(image, zone_initiale)
        self._zone_clic_zone_selector.zone_selectionnee.connect(
            lambda rect: self._on_zone_clic_zone_definie(nom_zone_cible, rect)
        )
        self._zone_clic_zone_selector.annulee.connect(self._on_zone_clic_zone_annulee)
        self._zone_clic_zone_selector.show()
        self._zone_clic_zone_selector.activateWindow()

    def _on_zone_clic_zone_annulee(self):
        self._zone_clic_zone_selector = None

    def _on_zone_clic_zone_definie(self, nom_zone_cible: str, rect: QRect):
        self._zone_clic_zone_selector = None
        # GARDE-FOU (cf. docstring de _start_definir_zone_clic_zone) : la
        # Zone visée peut avoir été supprimée ou renommée pendant que la
        # fenêtre de sélection était ouverte -- recherche par nom plutôt
        # que référence directe à l'objet, cohérent avec _zone_
        # selectionnee_courante ; ne fait rien si elle n'existe plus.
        zone = next((z for z in self.composant_layout.zones if z.nom == nom_zone_cible), None)
        if zone is None:
            return
        zone.zone_clic_rect = ZoneClicRect(x=rect.x(), y=rect.y(), largeur=rect.width(), hauteur=rect.height())
        self.composant_layout_modifie.emit()

    # ------------------------------------------------------------------
    # Zone de clic personnalisée -- zones DYNAMIQUES (AJOUT, demande
    # explicite utilisateur). Même pattern que le bloc _sur_zone_clic_
    # zone_mode_change/_start_definir_zone_clic_zone/_on_zone_clic_zone_
    # definie ci-dessus (Zone STATIQUE), à trois différences près :
    #   1) la config vit dans composant_layout.zones_dynamiques_clic[nom]
    #      (dict séparé, cf. docstring du champ) et pas sur un objet Zone,
    #      puisqu'une zone dynamique n'a pas d'objet persistant ;
    #   2) le rectangle découpé/écrit est en FRACTIONS (0-1) de la zone
    #      dynamique elle-même (ZoneClicRectFraction), pas en pixels
    #      absolus (ZoneClicRect) -- une zone dynamique n'a pas de taille
    #      fixe d'une exécution de filtre à l'autre (cf. docstring de
    #      ZoneClicRectFraction) ;
    #   3) le rectangle source de la découpe vient de self._dernieres_
    #      zones_filtre[nom] (dernier résultat du filtre, en PIXELS de
    #      l'image de référence), pas de zone.rect -- si le nom n'y
    #      figure plus (filtre pas encore exécuté, ou réexécuté sans que
    #      ce nom ressorte), on ne peut pas découper d'image, message
    #      d'erreur équivalent à "Zone pas encore tracée" côté statique.
    # ------------------------------------------------------------------
    def _config_zone_dynamique(self, nom: str) -> "ZoneDynamiqueClicConfig":
        """Retourne la ZoneDynamiqueClicConfig existante pour ce nom, ou
        une config par défaut ("toute_surface") si aucune entrée n'existe
        encore -- ne crée PAS d'entrée dans le dict tant que le mode
        n'est pas explicitement passé à "personnalise" (cf. _sur_zone_
        clic_dynamique_mode_change), pour ne pas polluer le JSON d'une
        entrée par défaut inutile pour chaque zone jamais personnalisée."""
        return self.composant_layout.zones_dynamiques_clic.get(nom, ZoneDynamiqueClicConfig())

    def _image_et_rect_zone_dynamique(self, nom: str) -> Tuple[Optional[QImage], Optional[Tuple[int, int, int, int]]]:
        """Découpe, depuis self._image_reference_bgr, le rectangle de
        cette zone dynamique tel que connu du DERNIER résultat de filtre
        (self._dernieres_zones_filtre, en pixels absolus de l'image de
        référence -- cf. _appliquer_filtre) et renvoie (image_decoupee,
        rect_source_pixels). rect_source_pixels est renvoyé en plus (pas
        seulement l'image) car nécessaire ensuite pour convertir le
        rectangle choisi dans ZoneClicSelector -- exprimé en pixels DE LA
        DÉCOUPE -- en fractions DE LA ZONE DYNAMIQUE (cf. _on_zone_clic_
        dynamique_definie). (None, None) si l'image de référence est
        absente ou si ce nom n'apparaît pas dans le dernier résultat du
        filtre (jamais exécuté, ou réexécuté sans que ce nom ressorte)."""
        if self._image_reference_bgr is None:
            return None, None
        rect_source = self._dernieres_zones_filtre.get(nom)
        if rect_source is None:
            return None, None
        x, y, largeur, hauteur = rect_source
        h_img, w_img = self._image_reference_bgr.shape[:2]
        # Bornage défensif, même esprit que _image_zone_selectionnee_decoupee.
        x = max(0, min(x, w_img - 1))
        y = max(0, min(y, h_img - 1))
        largeur = max(1, min(largeur, w_img - x))
        hauteur = max(1, min(hauteur, h_img - y))
        decoupe_bgr = self._image_reference_bgr[y:y + hauteur, x:x + largeur]
        decoupe_bgr_3c = (
            decoupe_bgr if decoupe_bgr.ndim == 3
            else cv2.cvtColor(decoupe_bgr, cv2.COLOR_GRAY2BGR)
        )
        decoupe_rgb = cv2.cvtColor(decoupe_bgr_3c, cv2.COLOR_BGR2RGB)
        hd, wd = decoupe_rgb.shape[:2]
        image = QImage(decoupe_rgb.data, wd, hd, decoupe_rgb.strides[0], QImage.Format_RGB888).copy()
        return image, (x, y, largeur, hauteur)

    def _sur_zone_clic_dynamique_mode_change(self, _index: int):
        """currentIndexChanged du combo zone_clic_dynamique_combo -- même
        pattern que _sur_zone_clic_zone_mode_change, mais écrit dans
        composant_layout.zones_dynamiques_clic[nom] (créant l'entrée si
        elle n'existe pas encore) au lieu d'un attribut direct sur Zone."""
        nom = self._nom_zone_dynamique_selectionnee
        if nom is None:
            return
        nouveau_mode = self.zone_clic_dynamique_combo.currentData()
        config = self.composant_layout.zones_dynamiques_clic.get(nom)
        if config is None:
            config = ZoneDynamiqueClicConfig()
            self.composant_layout.zones_dynamiques_clic[nom] = config
        config.zone_clic_mode = nouveau_mode
        self.definir_zone_clic_dynamique_button.setVisible(nouveau_mode == "personnalise")
        self.zone_clic_dynamique_erreur_label.hide()
        carte = self._zone_dynamique_cartes.get(nom)
        if carte is not None:
            carte.rafraichir_statut(nouveau_mode)
        # AJOUT (overlay pointillé, cf. _reconstruire_overlay_filtre) :
        # basculer vers "toute_surface" doit faire DISPARAÎTRE le
        # pointillé immédiatement (la condition mode == "personnalise"
        # dans _reconstruire_overlay_filtre l'exclut alors du dessin),
        # et basculer vers "personnalise" doit le faire réapparaître
        # aussitôt s'il existe déjà un rect enregistré d'un usage
        # précédent -- dans les deux cas, sans attendre une réexécution
        # du filtre.
        self._reconstruire_overlay_filtre()
        self._rafraichir_affichage_image()
        self.composant_layout_modifie.emit()

    def _start_definir_zone_clic_dynamique(self):
        """Bouton "Définir la zone..." de la page zone dynamique -- ouvre
        ZoneClicSelector sur l'image découpée du rectangle CONNU ACTUEL de
        cette zone (cf. _image_et_rect_zone_dynamique), avec le rectangle
        personnalisé déjà enregistré (s'il y en a un) reconverti en
        pixels de CETTE découpe précise pour pré-remplir le sélecteur."""
        nom = self._nom_zone_dynamique_selectionnee
        if nom is None:
            return
        image, rect_source = self._image_et_rect_zone_dynamique(nom)
        if image is None or image.isNull() or rect_source is None:
            self.zone_clic_dynamique_erreur_label.setText(
                "Cette zone dynamique n'apparaît pas dans le dernier "
                "résultat du filtre -- exécutez le filtre (onglet Filtre) "
                "pour pouvoir définir sa zone de clic."
            )
            self.zone_clic_dynamique_erreur_label.show()
            return
        self.zone_clic_dynamique_erreur_label.hide()

        config = self._config_zone_dynamique(nom)
        zone_initiale = None
        if not config.zone_clic_rect.est_vide():
            _, _, largeur_source, hauteur_source = rect_source
            fr = config.zone_clic_rect
            zone_initiale = QRect(
                round(fr.x * largeur_source),
                round(fr.y * hauteur_source),
                round(fr.largeur * largeur_source),
                round(fr.hauteur * hauteur_source),
            )

        # Référence forte + capture du nom (pas de l'objet, il n'y en a
        # de toute façon pas ici) -- même garde-fou que _start_definir_
        # zone_clic_zone : si cette zone dynamique disparaît du résultat
        # du filtre pendant que la fenêtre reste ouverte (filtre
        # réexécuté), _on_zone_clic_dynamique_definie le revérifie avant
        # d'écrire quoi que ce soit.
        nom_cible = nom
        largeur_source_cible, hauteur_source_cible = rect_source[2], rect_source[3]
        self._zone_clic_dynamique_selector = ZoneClicSelector(image, zone_initiale)
        self._zone_clic_dynamique_selector.zone_selectionnee.connect(
            lambda rect: self._on_zone_clic_dynamique_definie(nom_cible, largeur_source_cible, hauteur_source_cible, rect)
        )
        self._zone_clic_dynamique_selector.annulee.connect(self._on_zone_clic_dynamique_annulee)
        self._zone_clic_dynamique_selector.show()
        self._zone_clic_dynamique_selector.activateWindow()

    def _on_zone_clic_dynamique_annulee(self):
        self._zone_clic_dynamique_selector = None

    def _on_zone_clic_dynamique_definie(self, nom_cible: str, largeur_source: int, hauteur_source: int, rect: QRect):
        self._zone_clic_dynamique_selector = None
        # GARDE-FOU (cf. docstring de _start_definir_zone_clic_dynamique) :
        # revérifie que cette zone dynamique existe TOUJOURS dans le
        # dernier résultat du filtre (a pu changer/disparaître pendant que
        # la fenêtre était ouverte, ex: filtre réexécuté) -- n'écrit rien
        # sinon, même esprit que le garde-fou côté Zone statique.
        if nom_cible not in self._dernieres_zones_filtre:
            return
        config = self.composant_layout.zones_dynamiques_clic.get(nom_cible)
        if config is None:
            config = ZoneDynamiqueClicConfig(zone_clic_mode="personnalise")
            self.composant_layout.zones_dynamiques_clic[nom_cible] = config
        # Conversion pixels (de la découpe, taille largeur_source x
        # hauteur_source figée au moment de l'ouverture du sélecteur) ->
        # fractions DE LA ZONE DYNAMIQUE (cf. docstring de
        # ZoneClicRectFraction) -- division défensive (largeur_source/
        # hauteur_source ne peuvent pas être nuls ici, cf. bornage
        # max(1, ...) dans _image_et_rect_zone_dynamique, mais gardé par
        # prudence si cette méthode est un jour appelée autrement).
        config.zone_clic_rect = ZoneClicRectFraction(
            x=rect.x() / largeur_source if largeur_source else 0.0,
            y=rect.y() / hauteur_source if hauteur_source else 0.0,
            largeur=rect.width() / largeur_source if largeur_source else 0.0,
            hauteur=rect.height() / hauteur_source if hauteur_source else 0.0,
        )
        # AJOUT (overlay pointillé, cf. _reconstruire_overlay_filtre) :
        # le nouveau rectangle personnalisé doit apparaître sur l'aperçu
        # immédiatement à la fermeture du sélecteur, sans attendre une
        # réexécution du filtre.
        self._reconstruire_overlay_filtre()
        self._rafraichir_affichage_image()
        self.composant_layout_modifie.emit()

    def _peupler_page_zone_dynamique_config(self, nom: str):
        """Repeuple _page_zone_dynamique_config pour la zone dynamique
        `nom` -- appelée par _rafraichir_panneau_zone juste avant de
        basculer sur cette page. Même pattern de synchronisation
        combo/bouton que _rafraichir_panneau_zone fait pour zone_clic_
        zone_combo/definir_zone_clic_zone_button côté Zone statique."""
        self.nom_zone_dynamique_label.setText(nom)
        config = self._config_zone_dynamique(nom)
        index = self.zone_clic_dynamique_combo.findData(config.zone_clic_mode)
        self.zone_clic_dynamique_combo.blockSignals(True)
        self.zone_clic_dynamique_combo.setCurrentIndex(max(0, index))
        self.zone_clic_dynamique_combo.blockSignals(False)
        self.definir_zone_clic_dynamique_button.setVisible(config.zone_clic_mode == "personnalise")
        self.zone_clic_dynamique_erreur_label.hide()

    def _peupler_page_zone_legende(self):
        """Repeuple _page_zone_legende : une ligne par zone dynamique du
        dernier filtre exécuté (self._dernieres_zones_filtre), pastille
        de la couleur utilisée pour son rectangle sur l'aperçu (self.
        _couleurs_zones_filtre, cf. _appliquer_filtre) + nom. Appelée
        uniquement par _rafraichir_panneau_zone juste avant de basculer
        sur cette page -- simple panneau de détails en lecture seule, ne
        modifie ni _dernieres_zones_filtre ni aucun autre état."""
        layout = self._layout_zone_legende
        # Vide tout sauf le _section_label (item 0, toujours conservé).
        while layout.count() > 1:
            item = layout.takeAt(1)
            w = item.widget()
            if w is not None:
                w.deleteLater()
        for nom_zone in sorted(self._dernieres_zones_filtre):
            b, g, r = self._couleurs_zones_filtre.get(nom_zone, (0, 255, 0))
            ligne = QWidget(self._page_zone_legende)
            layout_ligne = QHBoxLayout(ligne)
            layout_ligne.setContentsMargins(0, 0, 0, 0)
            layout_ligne.setSpacing(8)
            pastille = QLabel(ligne)
            pastille.setFixedSize(12, 12)
            pastille.setStyleSheet(
                f"background-color: rgb({r}, {g}, {b}); border-radius: 6px;"
            )
            layout_ligne.addWidget(pastille)
            label_nom = QLabel(nom_zone, ligne)
            label_nom.setWordWrap(True)
            layout_ligne.addWidget(label_nom, 1)
            layout.addWidget(ligne)
        layout.addStretch(1)

    def _rafraichir_panneau_zone(self):
        """Bascule la pile (_pile_panneau_zone) selon qu'une Zone est
        sélectionnée ou non, et peuple ses champs, cf.
        _construire_panneau_zone. Le texte/icône du bouton Tracer change
        selon l'état de zone.rect (demande explicite : "si on trace et
        que on veut modifier et bien c'est plus tracer mais update, donc
        mettre à jour le tracé")."""
        zone = self._zone_selectionnee_courante()
        if zone is None:
            # AJOUT (personnalisation zone de clic sur zones DYNAMIQUES) :
            # une ZoneDynamiqueCarte sélectionnée (_nom_zone_dynamique_
            # selectionnee) passe AVANT la légende en lecture seule
            # ci-dessous -- seule une des trois pages (config statique /
            # config dynamique / légende / vide) est affichée à la fois,
            # cf. la mutuelle exclusion posée dans _sur_carte_zone_
            # cliquee/_sur_carte_zone_dynamique_cliquee. Le nom doit aussi
            # encore exister dans le dernier résultat du filtre (sinon la
            # sélection est devenue obsolète -- ex: filtre réexécuté sans
            # que ce nom ressorte -- et on retombe sur la légende/vide
            # comme si rien n'était sélectionné).
            if (
                self._nom_zone_dynamique_selectionnee is not None
                and self._nom_zone_dynamique_selectionnee in self._dernieres_zones_filtre
            ):
                self._peupler_page_zone_dynamique_config(self._nom_zone_dynamique_selectionnee)
                self._pile_panneau_zone.setCurrentWidget(self._page_zone_dynamique_config)
                return
            # AJOUT : la Zone statique sélectionnée reste PRIORITAIRE (cf.
            # ci-dessus, comportement inchangé) -- seulement si aucune ne
            # l'est, on regarde s'il y a un résultat de filtre à afficher
            # en légende (self._dernieres_zones_filtre, peuplé par
            # _appliquer_filtre) avant de retomber sur le placeholder vide
            # d'origine. Simple bascule d'affichage, ne touche à aucun
            # autre comportement (_dernieres_zones_filtre, _rafraichir_
            # liste_zones_dynamiques, etc. restent inchangés).
            if self._dernieres_zones_filtre:
                self._peupler_page_zone_legende()
                self._pile_panneau_zone.setCurrentWidget(self._page_zone_legende)
            else:
                self._pile_panneau_zone.setCurrentWidget(self._page_zone_vide)
            return
        self._pile_panneau_zone.setCurrentWidget(self._page_zone_config)
        self.nom_zone_selectionnee_edit.setText(zone.nom)
        self.erreur_nom_zone_label.hide()

        self.bouton_tracer_zone.blockSignals(True)
        self.bouton_tracer_zone.setChecked(False)
        self.bouton_tracer_zone.blockSignals(False)
        deja_tracee = not zone.rect.est_vide()
        self.bouton_tracer_zone.setText(" Mettre à jour le tracé" if deja_tracee else " Tracer")
        self.bouton_tracer_zone.setIcon(
            qta.icon("mdi6.vector-square-edit" if deja_tracee else "mdi6.vector-square-plus", color=Mocha.text)
        )

        for spin, valeur in (
            (self.zone_rect_x_spin, zone.rect.x),
            (self.zone_rect_y_spin, zone.rect.y),
            (self.zone_rect_largeur_spin, zone.rect.largeur),
            (self.zone_rect_hauteur_spin, zone.rect.hauteur),
        ):
            spin.blockSignals(True)
            spin.setValue(valeur)
            spin.blockSignals(False)

        # AJOUT (zone de clic personnalisée PAR ZONE) : synchronise le
        # combo + la visibilité du bouton "Définir la zone..." sur la
        # Zone nouvellement sélectionnée -- même pattern que
        # ComposantReglagesPanel.afficher_composant pour zone_clic_combo/
        # definir_zone_button côté ComposantSingle.
        index_zone_clic_zone = self.zone_clic_zone_combo.findData(zone.zone_clic_mode)
        self.zone_clic_zone_combo.blockSignals(True)
        self.zone_clic_zone_combo.setCurrentIndex(max(0, index_zone_clic_zone))
        self.zone_clic_zone_combo.blockSignals(False)
        self.definir_zone_clic_zone_button.setVisible(zone.zone_clic_mode == "personnalise")
        self.zone_clic_zone_erreur_label.hide()

    def _sur_changement_sous_onglet(self, index: int):
        """CORRECTIF (bouton "Tracer une zone" laissé actif en quittant
        le sous-onglet Zone -- pouvait surprendre en repartant sur
        Général/Filtre avec l'aperçu toujours en MODE_TRACE_ZONE) --
        désactive proprement le mode traçage dès qu'on quitte le
        sous-onglet "Zone" (index correspond à son ordre d'ajout dans
        _construire_onglet_formes -- Général=0, Filtre=1, Zone=2, puis
        Gabarit=3, cf. AJOUT ci-dessous).

        AJOUT (sous-onglet "Gabarit") : régénère son contenu à chaque
        fois qu'on y entre (pas seulement à la construction de l'écran)
        -- cf. docstring de _rafraichir_onglet_gabarit, reflète ainsi
        d'éventuels changements faits dans Général/Filtre/Zone pendant
        la même session sans action manuelle."""
        if self._sous_onglets.widget(index) is not getattr(self, "_onglet_zones_widget", None):
            if self.bouton_tracer_zone.isChecked():
                self.bouton_tracer_zone.setChecked(False)
        if self._sous_onglets.widget(index) is getattr(self, "_onglet_gabarit_widget", None):
            self._rafraichir_onglet_gabarit()

    # ------------------------------------------------------------------
    # Réglages simples
    # ------------------------------------------------------------------
    # RETRAIT (REFONTE, cf. SPEC_refonte_filtre_zones_dynamiques.md) --
    # _sur_seuil_confiance_change/_sur_delta_conflit_change supprimés en
    # même temps que les spinbox correspondantes dans le sous-onglet
    # Général (cf. _construire_sous_onglet_general) : plus de champ
    # seuil_confiance/delta_conflit sur ComposantLayout.

    # AJOUT (demande explicite utilisateur : "il faut que la couleur du
    # contour sur les images soit plus foncé et change de couleur, par
    # exemple vert ... ces couleurs doivent être définies dans l'onglet
    # Général ... sa sera persistant et en fonction de chaque cL") --
    # mutation directe du champ sur self.composant_layout puis
    # composant_layout_modifie.emit() pour laisser l'appelant
    # (ComposantsLayoutScreen) persister via project.save (cf. connexion
    # composant_layout_modifie.connect(self.project.save) dans
    # ComposantsLayoutScreen). Rafraîchit aussi immédiatement les deux
    # aperçus (brut + filtré) pour que le nouveau contour soit visible
    # sans attendre une reconstruction de l'écran.
    def _sur_couleur_zone_change(self, couleur: str):
        self.composant_layout.couleur_zone = couleur
        self.composant_layout_modifie.emit()
        self._rafraichir_apercu_zones_nommees()

    def _sur_couleur_zone_selectionnee_change(self, couleur: str):
        self.composant_layout.couleur_zone_selectionnee = couleur
        self.composant_layout_modifie.emit()
        self._rafraichir_apercu_zones_nommees()

    def _sur_epaisseur_zone_change(self, valeur: int):
        self.composant_layout.epaisseur_zone = valeur
        self.composant_layout_modifie.emit()
        self._rafraichir_apercu_zones_nommees()

    def _nom_court_composant_layout(self, nom_complet: str) -> str:
        prefixe = f"{self.composant_layout.service_api_nom}-"
        return nom_complet[len(prefixe):] if nom_complet.startswith(prefixe) else nom_complet

    def _sur_nom_composant_layout_change(self):
        """CORRECTIF (bug rapporté : renommer un cL le faisait disparaître
        de la grille) -- passe désormais par Project.rename_composant_
        layout au lieu d'un simple `self.composant_layout.nom = ...`, cf.
        docstring de _construire_sous_onglet_general pour le détail
        complet du bug et du correctif."""
        nouveau_nom_court = self.nom_composant_layout_edit.text().strip()
        ancien_nom_complet = self.composant_layout.nom
        ancien_nom_court = self._nom_court_composant_layout(ancien_nom_complet)
        if not nouveau_nom_court or nouveau_nom_court == ancien_nom_court:
            self.nom_composant_layout_edit.setText(ancien_nom_court)
            return
        try:
            self.project.rename_composant_layout(ancien_nom_complet, nouveau_nom_court)
        except ValueError as e:
            self.erreur_nom_composant_layout_label.setText(str(e))
            self.erreur_nom_composant_layout_label.show()
            self.nom_composant_layout_edit.setText(ancien_nom_court)
            return
        self.erreur_nom_composant_layout_label.hide()
        self.composant_layout_modifie.emit()
        self.composant_layout_renomme.emit(ancien_nom_complet, self.composant_layout.nom)

    # ------------------------------------------------------------------
    # REFONTE (retrait de l'onglet Test, cf. docstring du __init__) :
    # _demarrer_test_detection/_rafraichir_affichage_test (ex-section
    # "Onglet Test (5.5)") sont retirées -- cette logique de détection
    # synchrone est désormais portée par TestComposantScreen en
    # MODE_COMPOSANT_LAYOUT (cf. _sur_capture_propre_pour_detection_layout,
    # qui réutilise exactement le même appel à detecter_toutes_instances_
    # composant_layout que ces méthodes faisaient ici).
    # ------------------------------------------------------------------

    def _sur_zone_definie_non_applicable(self, *args):
        # Placeholder intentionnellement absent : ComposantLayoutConfigScreen
        # n'émet pas de signal zone_definie (contrat propre à
        # CoordonneeActionScreen/cS, sans équivalent ici -- la persistance
        # de ComposantLayout passe par composant_layout_modifie).
        pass

    def arreter(self):
        self.arreter_reseau()



# ---------------------------------------------------------------------------
# Outil "Données fictives" -- panneau gauche d'ApplicationsScreen (cf. sa
# docstring plus bas). Génère un jeu de fichiers/dossiers de test
# (images/textes/dossiers) et le réplique dans <racine>/<n>/data/ pour
# nb_sous_projets sous-projets numérotés -- cf. generer_donnees_fictives,
# toute la logique disque est déportée là-bas, cet écran ne fait QUE
# construire la liste d'ElementDonneeFictive depuis les champs saisis puis
# l'appeler.
# ---------------------------------------------------------------------------
class LigneNomElement(QWidget):
    """Un seul champ nom, avec un petit label indiquant son rang (ex:
    "Image 2") -- réutilisé identiquement pour les 3 types d'éléments,
    cf. GenerationDonneesFictivesScreen._reconstruire_champs_noms."""

    def __init__(self, label_texte: str, nom_par_defaut: str, parent=None):
        super().__init__(parent)
        layout = QHBoxLayout(self)
        layout.setContentsMargins(0, 0, 0, 0)
        layout.setSpacing(8)
        label = QLabel(label_texte, self)
        label.setObjectName("ReglagesLabel")
        label.setFixedWidth(90)
        layout.addWidget(label)
        self.champ_nom = QLineEdit(self)
        self.champ_nom.setObjectName("APIFeaturesNomEdit")
        self.champ_nom.setText(nom_par_defaut)
        layout.addWidget(self.champ_nom, 1)

    def nom(self) -> str:
        return self.champ_nom.text().strip()


class GenerationDonneesFictivesScreen(QWidget):
    """Outil de test (cf. retour utilisateur : "je veux créer des données
    fictives, juste pour des tests") -- formulaire pur, AUCUNE connexion
    réseau/instance (contrairement à TestComposantScreen/CoordonneeAction
    Screen, qui héritent d'InstanceApercuScreen) : ouvert comme un onglet
    parmi d'autres dans ApplicationsScreen, pas relayé depuis un écran
    d'origine, donc pas de retour_bar/retour_button ici -- se ferme comme
    n'importe quel onglet standard (bouton x de l'onglet).

    Modèle de configuration (décision explicite utilisateur, cf. exemple
    donné : "je met image a 2, fichier texte a 1, dossier a 0... en bas je
    donne les noms des images pour ces deux fichiers image, même chose
    pour le fichier texte, puisque je n'ai pas sélectionné dossier, ça
    n'apparaît pas") : 3 spinbox de quantité (un par type), qui pilotent
    dynamiquement l'apparition de champs de nom en dessous -- un champ par
    élément, jamais un champ "pattern" générique. Cette même liste
    d'éléments (mêmes noms, même contenu) est répliquée à l'identique dans
    CHAQUE sous-projet numéroté (cf. generer_donnees_fictives)."""

    NOMS_PAR_DEFAUT = {"image": "image", "texte": "texte", "dossier": "dossier"}

    def __init__(self, parent=None):
        super().__init__(parent)
        self._lignes_noms: dict[str, list[LigneNomElement]] = {"image": [], "texte": [], "dossier": []}

        layout = QVBoxLayout(self)
        layout.setContentsMargins(28, 24, 28, 24)
        layout.setSpacing(14)

        titre = QLabel("Données fictives", self)
        titre.setObjectName("PlaceholderTitle")
        layout.addWidget(titre)

        sous_titre = QLabel(
            "Générez un jeu de fichiers/dossiers de test (images, fichiers "
            "texte, dossiers vides), répliqué à l'identique dans chaque "
            "sous-projet numéroté (1/data/, 2/data/, ...).",
            self,
        )
        sous_titre.setObjectName("PlaceholderSubtitle")
        sous_titre.setWordWrap(True)
        layout.addWidget(sous_titre)

        # --- Quantités par type ---
        bloc_quantites = QWidget(self)
        grille_quantites = QGridLayout(bloc_quantites)
        grille_quantites.setContentsMargins(0, 0, 0, 0)
        grille_quantites.setHorizontalSpacing(16)
        grille_quantites.setVerticalSpacing(8)

        self._spins_quantite: dict[str, QSpinBox] = {}
        specs_types = [("image", "Images"), ("texte", "Fichiers texte"), ("dossier", "Dossiers")]
        for ligne, (type_element, label_texte) in enumerate(specs_types):
            label = QLabel(label_texte, bloc_quantites)
            label.setObjectName("ReglagesLabel")
            grille_quantites.addWidget(label, ligne, 0)
            spin = QSpinBox(bloc_quantites)
            spin.setRange(0, 50)
            spin.setValue(0)
            spin.valueChanged.connect(lambda _valeur, t=type_element: self._reconstruire_champs_noms(t))
            grille_quantites.addWidget(spin, ligne, 1)
            self._spins_quantite[type_element] = spin
        grille_quantites.setColumnStretch(1, 0)
        layout.addWidget(bloc_quantites)

        # --- Champs de noms, un bloc par type, peuplé dynamiquement ---
        self._zones_noms: dict[str, QVBoxLayout] = {}
        for type_element, label_texte in specs_types:
            titre_zone = QLabel(f"Noms -- {label_texte}", self)
            titre_zone.setObjectName("ReglagesLabel")
            titre_zone.setVisible(False)
            layout.addWidget(titre_zone)
            conteneur = QWidget(self)
            zone_layout = QVBoxLayout(conteneur)
            zone_layout.setContentsMargins(0, 0, 0, 8)
            zone_layout.setSpacing(6)
            layout.addWidget(conteneur)
            self._zones_noms[type_element] = zone_layout
            # Le titre de zone suit la visibilité du conteneur (caché tant
            # que quantité == 0, cf. _reconstruire_champs_noms) -- gardé
            # dans self pour pouvoir le retrouver depuis là-bas.
            setattr(self, f"_titre_zone_{type_element}", titre_zone)

        # --- Nombre de sous-projets ---
        ligne_config = QHBoxLayout()
        label_nb = QLabel("Nombre de sous-projets", self)
        label_nb.setObjectName("ReglagesLabel")
        ligne_config.addWidget(label_nb)
        self.spin_nb_sous_projets = QSpinBox(self)
        self.spin_nb_sous_projets.setRange(1, 500)
        self.spin_nb_sous_projets.setValue(20)
        ligne_config.addWidget(self.spin_nb_sous_projets)
        ligne_config.addStretch(1)
        layout.addLayout(ligne_config)

        # --- Nom du dossier de projet (PATCH -- retour utilisateur :
        # "on créer plusieurs données fictives pour différents projets, ça
        # va se mélanger") : auparavant, tout partait tout droit dans
        # <racine>/<n>/data/, donc une 2e génération écrasait/mélangeait
        # la 1ère (mêmes numéros de sous-projets 1..N). Maintenant, un
        # sous-dossier nommé par l'utilisateur s'intercale entre la racine
        # fixe et les sous-projets numérotés : <racine>/<nom_projet>/<n>/
        # data/ -- chaque génération va dans son propre espace isolé.
        self._racine_fixe = RACINE_DONNEES_FICTIVES
        ligne_projet = QHBoxLayout()
        label_projet = QLabel("Nom du dossier de projet", self)
        label_projet.setObjectName("ReglagesLabel")
        label_projet.setFixedWidth(160)
        ligne_projet.addWidget(label_projet)
        self.champ_nom_projet = QLineEdit(self)
        self.champ_nom_projet.setObjectName("APIFeaturesNomEdit")
        self.champ_nom_projet.setText(f"projet_{datetime.now().strftime('%Y%m%d_%H%M%S')}")
        self.champ_nom_projet.setPlaceholderText("ex: campagne_test_1")
        self.champ_nom_projet.textChanged.connect(self._mettre_a_jour_label_racine)
        ligne_projet.addWidget(self.champ_nom_projet, 1)
        layout.addLayout(ligne_projet)

        self.label_racine = QLabel(self)
        self.label_racine.setObjectName("PlaceholderSubtitle")
        self.label_racine.setWordWrap(True)
        layout.addWidget(self.label_racine)
        self._mettre_a_jour_label_racine()

        self.bouton_generer = QPushButton(
            qta.icon("mdi6.creation", color=Mocha.crust), " Générer", self
        )
        self.bouton_generer.setObjectName("CaptureButton")
        self.bouton_generer.clicked.connect(self._generer)
        layout.addWidget(self.bouton_generer, 0, Qt.AlignLeft)

        self.label_resultat = QLabel(self)
        self.label_resultat.setObjectName("PlaceholderSubtitle")
        self.label_resultat.setWordWrap(True)
        layout.addWidget(self.label_resultat)

        layout.addStretch(1)

    def _nom_projet_normalise(self) -> str:
        """Nom du sous-dossier de projet tel qu'utilisé sur disque -- champ
        vidé par l'utilisateur retombe sur un nom horodaté (jamais de
        génération directement à la racine, pour garantir l'isolation
        entre projets même si le champ est laissé vide par erreur)."""
        nom = self.champ_nom_projet.text().strip()
        return nom or f"projet_{datetime.now().strftime('%Y%m%d_%H%M%S')}"

    def _racine_effective(self) -> Path:
        return self._racine_fixe / self._nom_projet_normalise()

    def _mettre_a_jour_label_racine(self):
        self.label_racine.setText(f"Dossier de sortie : {self._racine_effective()}")

    def _reconstruire_champs_noms(self, type_element: str):
        """Ajoute/retire des LigneNomElement pour que leur nombre suive
        exactement la quantité du spinbox correspondant -- ne reconstruit
        QUE la différence (garde les noms déjà saisis sur les lignes
        existantes, cf. décision implicite : changer 2->3 ne doit pas
        effacer les 2 noms déjà tapés)."""
        quantite = self._spins_quantite[type_element].value()
        lignes = self._lignes_noms[type_element]
        zone_layout = self._zones_noms[type_element]
        label_singulier = {"image": "Image", "texte": "Texte", "dossier": "Dossier"}[type_element]

        while len(lignes) < quantite:
            rang = len(lignes) + 1
            nom_defaut = f"{self.NOMS_PAR_DEFAUT[type_element]}_{rang}"
            ligne = LigneNomElement(f"{label_singulier} {rang}", nom_defaut, self)
            zone_layout.addWidget(ligne)
            lignes.append(ligne)
        while len(lignes) > quantite:
            ligne = lignes.pop()
            zone_layout.removeWidget(ligne)
            ligne.deleteLater()

        titre_zone = getattr(self, f"_titre_zone_{type_element}")
        titre_zone.setVisible(quantite > 0)
        zone_layout.parentWidget().setVisible(quantite > 0)

    def _collecter_elements(self) -> list:
        """Construit la liste finale d'ElementDonneeFictive depuis l'état
        actuel des champs -- noms vides silencieusement ignorés (plutôt que
        bloquer toute la génération pour un seul champ oublié), avec repli
        sur le nom par défaut si l'utilisateur a laissé le placeholder
        généré automatiquement mais vidé le champ."""
        elements = []
        for type_element, lignes in self._lignes_noms.items():
            for index, ligne in enumerate(lignes, start=1):
                nom = ligne.nom() or f"{self.NOMS_PAR_DEFAUT[type_element]}_{index}"
                elements.append(ElementDonneeFictive(nom=nom, type_element=type_element))
        return elements

    def _generer(self):
        elements = self._collecter_elements()
        if not elements:
            self.label_resultat.setText("Choisissez au moins un élément (image, fichier texte ou dossier) à générer.")
            self.label_resultat.setStyleSheet(f"color: {Mocha.peach};")
            return
        nb_sous_projets = self.spin_nb_sous_projets.value()
        racine_cible = self._racine_effective()
        # Avertissement (pas un blocage) si ce dossier de projet existe déjà
        # -- cf. retour utilisateur : plusieurs générations mélangées faute
        # de séparation par projet. On préfère prévenir plutôt que réécrire
        # silencieusement par-dessus un jeu de données déjà généré, mais on
        # laisse l'utilisateur relancer volontairement (ex: régénérer le
        # même projet après avoir changé quelques noms).
        deja_existant = racine_cible.exists()
        self.bouton_generer.setEnabled(False)
        try:
            racine = generer_donnees_fictives(racine_cible, elements, nb_sous_projets)
        except OSError as e:
            self.label_resultat.setText(f"Échec de la génération : {e}")
            self.label_resultat.setStyleSheet(f"color: {Mocha.red};")
            return
        finally:
            self.bouton_generer.setEnabled(True)
        if deja_existant:
            self.label_resultat.setText(
                f"{len(elements)} élément(s) régénérés dans {nb_sous_projets} sous-projet(s), sous {racine} "
                f"(ce dossier de projet existait déjà -- contenu réécrit par-dessus)."
            )
            self.label_resultat.setStyleSheet(f"color: {Mocha.yellow};")
        else:
            self.label_resultat.setText(
                f"{len(elements)} élément(s) générés dans {nb_sous_projets} sous-projet(s), sous {racine}"
            )
            self.label_resultat.setStyleSheet(f"color: {Mocha.green};")


class GuideOutilScreen(QWidget):
    """PATCH (retour utilisateur -- "ils ne doivent pas forcément pouvoir
    s'ouvrir, il faut que quand on clique dessus ça guide juste comment
    l'utiliser réellement") : pour un outil du panneau gauche
    d'ApplicationsScreen qui EXIGE un contexte externe (ex: Test de
    composant/Coordonnée action ont besoin d'un composant déjà capturé,
    donc ne peuvent pas s'ouvrir "à vide" depuis une simple liste), le clic
    ouvre CET écran à la place de l'outil lui-même -- texte expliquant où
    et comment le lancer réellement, plus un bouton optionnel qui amène
    directement au bon écran (cf. cle_ecran_cible / demande_navigation).

    Volontairement une classe générique unique (pas une sous-classe par
    outil) : seul le contenu texte change d'un guide à l'autre, cf.
    ApplicationsScreen.OUTILS_GENERIQUES, qui fournit titre/texte/cible."""

    demande_navigation = Signal(str)  # clé d'écran (self.screens) à afficher

    def __init__(self, titre: str, texte_guide: str, cle_ecran_cible: Optional[str] = None,
                 label_bouton_cible: str = "", parent=None):
        super().__init__(parent)
        layout = QVBoxLayout(self)
        layout.setContentsMargins(28, 24, 28, 24)
        layout.setSpacing(14)

        titre_label = QLabel(titre, self)
        titre_label.setObjectName("PlaceholderTitle")
        layout.addWidget(titre_label)

        texte_label = QLabel(texte_guide, self)
        texte_label.setObjectName("PlaceholderSubtitle")
        texte_label.setWordWrap(True)
        layout.addWidget(texte_label)

        if cle_ecran_cible and label_bouton_cible:
            bouton = QPushButton(qta.icon("mdi6.arrow-right", color=Mocha.crust), f" {label_bouton_cible}", self)
            bouton.setObjectName("CaptureButton")
            bouton.clicked.connect(lambda: self.demande_navigation.emit(cle_ecran_cible))
            layout.addWidget(bouton, 0, Qt.AlignLeft)

        layout.addStretch(1)


class PanneauOutilsEscamotable(QWidget):
    """PATCH (demande explicite utilisateur : "le panneau d'outils
    appartient au layout de la sidebar ... ça occupe l'espace pour rien"
    -- puis : "replié contre le bord gauche par défaut ... se déplie
    automatiquement quand le curseur entre dans cette zone ... se replie
    quand le curseur en sort" -- PUIS, ce patch-ci, nouvelle demande
    explicite CORRIGEANT la version précédente : "je veux plus que elle
    modifie le layout ... elle est censee s'afficher au dessus de
    l'interface des app ouvert, pas modifier le layout") : cette classe
    ne vit donc plus DU TOUT dans layout_racine (l'ancienne version,
    elle, y restait -- cf. commentaire git ci-dessous pour ce qui a
    changé) -- elle est posée en enfant FLOTTANT de colonne_droite
    (setParent direct, HORS de tout layout géré, positionnement par
    setGeometry manuel), overlay par-dessus les onglets déjà ouverts,
    exactement le même patron que le panneau de réglages flottant de
    TaskConfigScreen/ProjetsDistribuesScreen (cf. _preparer_mode_overlay
    plus bas dans ce fichier, docstring) -- MÊME dans son état "déplié"
    au survol, elle ne pousse donc plus jamais colonne_droite/self.tabs,
    qui gardent désormais toujours leur pleine largeur.

    ANCIEN COMPORTEMENT (avant ce patch, docstring conservée à titre
    d'historique) : le panneau restait dans layout_racine (QHBoxLayout),
    minimumWidth fixé en permanence à _LARGEUR_REPLIEE (28px) et
    maximumWidth animé entre 28 et 220 via enterEvent/leaveEvent
    classiques sur ce widget -- suffisant à l'époque puisque le panneau
    restait toujours dans le flux normal (jamais masqué), mais CETTE
    largeur minimale de 28px, même repliée, réservait un espace
    permanent et redimensionnait mécaniquement colonne_droite à chaque
    animation : exactement le "modifie le layout" reproché ici.

    NOUVEAU COMPORTEMENT : plus de minimumWidth/maximumWidth du tout --
    ce widget a une géométrie FIXE (setGeometry), posée par-dessus
    colonne_droite, jamais insérée dans un layout Qt (aucun addWidget
    nulle part sur ce widget). Comme pour colonne_reglages dans
    _preparer_mode_overlay, un widget flottant masqué la plupart du
    temps ne reçoit pas enterEvent/leaveEvent de façon fiable -- un
    QTimer léger compare donc QCursor.pos() à sa bande sensible/à sa
    propre géométrie, même logique que _verifier_survol_panneau_flottant
    (repère GLOBAL des deux côtés de la comparaison, jamais de
    mapFromGlobal vers un repère local -- cf. son commentaire CORRECTIF
    pour pourquoi ce point précis compte)."""

    _LARGEUR_DEPLIEE = 220  # largeur d'origine de panneau_gauche, inchangée
    _LARGEUR_REPLIEE = 28  # largeur de la languette visible/cliquable, contre le bord gauche
    _DUREE_ANIMATION_MS = 220  # plus court que le scroll (350ms) : geste réflexe, pas une action délibérée
    _INTERVALLE_SURVEILLANCE_SOURIS_MS = 60  # même valeur que _preparer_mode_overlay, cf. sa docstring

    def __init__(self, parent_ancrage: QWidget, parent=None):
        """parent_ancrage : widget (colonne_droite d'ApplicationsScreen)
        contre le bord gauche duquel ce panneau reste plaqué, et dont le
        redimensionnement (eventFilter, QEvent.Resize) redéclenche
        _repositionner. PAS forcément le même objet que `parent` Qt
        (ici si : ApplicationsScreen.__init__ passe colonne_droite pour
        les deux -- ce panneau est un enfant DIRECT de colonne_droite,
        pas de ApplicationsScreen lui-même, pour que raise_()/la pile
        de peinture le place bien au-dessus des onglets sans dépendre de
        l'ordre d'empilement au niveau de la fenêtre entière)."""
        super().__init__(parent)
        self._parent_ancrage = parent_ancrage
        # Pas de minimumWidth/maximumWidth : geometry() explicite gère
        # entièrement la taille (setFixedWidth ferait doublon et
        # réintroduirait une contrainte de layout, cf. docstring
        # ci-dessus -- ce widget n'est justement plus DANS un layout).
        self._largeur_courante = float(self._LARGEUR_REPLIEE)
        self._animation: Optional[QPropertyAnimation] = None
        self._deplie = False

        # Ombre légère : seul signal visuel qu'il s'agit bien d'un
        # panneau flottant PAR-DESSUS le contenu (pas une simple colonne
        # de plus) -- discret, cohérent avec colonne_reglages qui, elle,
        # compte sur autoFillBackground seul (cf. _preparer_mode_overlay)
        # mais reste posée à plat contre un bord d'image, pas devant du
        # texte/interactif comme ici où la distinction mérite d'être un
        # peu plus marquée.
        ombre = QGraphicsDropShadowEffect(self)
        ombre.setBlurRadius(24)
        ombre.setXOffset(2)
        ombre.setYOffset(0)
        ombre.setColor(QColor(0, 0, 0, 140))
        self.setGraphicsEffect(ombre)

        # BUGFIX (retour utilisateur : "le paneau [...] on dirait que sa
        # na aucun fond [...] cest pas opaque flotant au dessus" -- capture
        # d'écran à l'appui : le texte du contenu DERRIÈRE (colonne_droite/
        # les onglets ouverts) reste bien visible À TRAVERS ce panneau une
        # fois déplié) -- setAutoFillBackground(True) seul ne peint la
        # palette du widget QUE si la feuille QSS globale de l'app définit
        # déjà un background-color pour lui (par objectName ou type) ;
        # sans cette règle QSS, Qt.WA_StyledBackground n'est pas posé
        # automatiquement sur un QWidget nu et rien n'est réellement
        # peint -- exactement ce qui se produisait ici, ce panneau n'ayant
        # aucune règle QSS dédiée. Corrigé en forçant explicitement un
        # style opaque directement sur CE widget (styleSheet + attribut
        # WA_StyledBackground), indépendant de toute règle QSS globale
        # existante ou future -- Mocha.base/Mocha.surface1 déjà utilisés
        # ailleurs dans ce fichier pour ce même rôle de fond de panneau.
        self.setAttribute(Qt.WA_StyledBackground, True)
        self.setStyleSheet(
            f"PanneauOutilsEscamotable {{ background-color: {Mocha.base}; "
            f"border-right: 1px solid {Mocha.surface1}; }}"
        )
        parent_ancrage.installEventFilter(self)

        self._minuteur_survol = QTimer(self)
        self._minuteur_survol.setInterval(self._INTERVALLE_SURVEILLANCE_SOURIS_MS)
        self._minuteur_survol.timeout.connect(self._verifier_survol)
        self._minuteur_survol.start()

        self._repositionner()
        self.raise_()

    def _repositionner(self):
        """Plaque ce panneau contre le bord GAUCHE de parent_ancrage,
        pleine hauteur, à sa largeur courante (repliée, dépliée, ou une
        valeur intermédiaire en cours d'animation) -- appelé au départ,
        à chaque tick d'animation (cf. _animer_vers) et à chaque
        redimensionnement de parent_ancrage (cf. eventFilter)."""
        hauteur = self._parent_ancrage.height() or self._parent_ancrage.sizeHint().height()
        self.setGeometry(0, 0, round(self._largeur_courante), hauteur)
        self.raise_()

    def _definir_largeur_courante(self, largeur):
        self._largeur_courante = largeur
        self._repositionner()

    def _lire_largeur_courante(self):
        return self._largeur_courante

    # Qt property animable (cf. QPropertyAnimation ci-dessous) -- même
    # patron que maximumWidth utilisé par l'ancienne version, mais sur
    # une propriété Python dédiée puisque ce widget n'a plus de
    # min/maximumWidth signifiant hors layout (Qt ignore ces bornes pour
    # un widget positionné à la main par setGeometry).
    largeurAnimee = Property(float, _lire_largeur_courante, _definir_largeur_courante)

    def _animer_vers(self, largeur_cible: float):
        if self._animation is not None:
            self._animation.stop()
        animation = QPropertyAnimation(self, b"largeurAnimee", self)
        animation.setDuration(self._DUREE_ANIMATION_MS)
        animation.setStartValue(self._largeur_courante)
        animation.setEndValue(largeur_cible)
        animation.setEasingCurve(QEasingCurve.OutCubic)
        self._animation = animation
        animation.start()

    def _verifier_survol(self):
        """Réplique de _verifier_survol_panneau_flottant (cf. sa
        docstring pour le détail du bug déjà corrigé là-bas sur la
        comparaison de repères) -- déplié si la souris est dans la
        bande sensible du bord gauche de parent_ancrage OU déjà
        au-dessus de ce panneau une fois déplié (pour ne pas le
        refermer sous le curseur pendant qu'on l'utilise), replié
        sinon. Comparaison entièrement en repère GLOBAL des deux
        côtés : jamais de mapFromGlobal vers un repère local, ce
        widget étant positionné à la main (setGeometry), hors de
        tout layout géré."""
        if not self._parent_ancrage.isVisible():
            return
        pos_globale = QCursor.pos()
        origine_ancrage = self._parent_ancrage.mapToGlobal(QPoint(0, 0))
        rect_zone_sensible = QRect(
            origine_ancrage.x(), origine_ancrage.y(),
            self._LARGEUR_REPLIEE, self._parent_ancrage.height(),
        )
        origine_self = self.mapToGlobal(QPoint(0, 0))
        rect_self_global = QRect(origine_self, self.size())
        dans_zone_sensible = rect_zone_sensible.contains(pos_globale)
        dans_panneau_deja_deplie = self._deplie and rect_self_global.contains(pos_globale)
        doit_etre_deplie = dans_zone_sensible or dans_panneau_deja_deplie
        if doit_etre_deplie != self._deplie:
            self._deplie = doit_etre_deplie
            self._animer_vers(self._LARGEUR_DEPLIEE if doit_etre_deplie else self._LARGEUR_REPLIEE)

    def eventFilter(self, obj, event):
        if obj is self._parent_ancrage and event.type() == QEvent.Resize:
            self._repositionner()
        return super().eventFilter(obj, event)


# Remplace la 5ème section fixe "Test de composant" : à la demande de
# l'utilisateur, la sidebar ne doit pas se saturer d'une icône par outil.
# Vide par défaut (aucun onglet à l'ouverture de l'app) ; chaque action
# ailleurs dans l'app qui a besoin d'un espace graphique paramétrable (ex:
# "Tester le composant") ouvre son exécution dans un nouvel onglet ici.
# Onglets fermables ; pas de dédup — un même composant peut être ouvert
# dans plusieurs onglets simultanément (à la demande explicite).
# ---------------------------------------------------------------------------
class ApplicationsScreen(QWidget):
    """Conteneur générique d'outils/interfaces sous forme d'onglets.

    Aucun contenu par défaut : un message d'état neutre s'affiche tant
    qu'aucun onglet n'est ouvert. Les autres écrans de l'app appellent
    ouvrir_test_composant(nom, origine) pour y ajouter un nouvel onglet.

    Chaque onglet mémorise sa propre "origine" (l'écran depuis lequel il a
    été ouvert) : un bouton "Retour" apparaît DANS l'onglet lui-même
    (cf. TestComposantScreen.retour_bar) et, une fois cliqué, ferme
    d'abord l'onglet (arrêt propre de tout timer/test en cours, cf.
    _retour_et_fermer) puis ramène à cet écran d'origine.

    PATCH (retour utilisateur -- "j'aimerais améliorer l'interface
    d'ApplicationsScreen, par défaut quand on ouvre ApplicationsScreen ça
    a un panneau gauche qui contient la liste des app qui s'ouvrent là-bas")
    : panneau gauche fixe (self.liste_outils) listant les outils
    GÉNÉRIQUES -- ceux qui s'ouvrent sans contexte externe requis (pas de
    composant_nom à fournir, contrairement à Test de composant/Coordonnée
    action, qui restent exclusivement ouverts depuis leurs écrans d'origine
    respectifs via ouvrir_test_composant/ouvrir_coordonnee_action, donc
    absents de cette liste). Premier et seul outil pour l'instant :
    "Données fictives" (cf. GenerationDonneesFictivesScreen) -- décision
    par défaut : PAS de dédup au clic, cohérent avec le comportement déjà
    en place pour les autres onglets (cf. ouvrir_test_composant, "à la
    demande explicite de l'utilisateur") -- recliquer ouvre un nouvel
    onglet plutôt que de réutiliser un onglet déjà ouvert.

    PATCH (demande explicite utilisateur : "je veux plus que elle
    modifie le layout ... elle est censee s'afficher au dessus de
    l'interface des app ouvert, pas modifier le layout") -- panneau_
    gauche (cf. PanneauOutilsEscamotable, docstring) n'est désormais
    PLUS ajouté à layout_racine du tout : construit APRÈS colonne_droite
    (dont il a besoin comme parent d'ancrage/parent Qt réel) et posé en
    overlay flottant par-dessus elle. layout_racine ne contient donc
    plus que colonne_droite, seule à occuper toute la largeur -- ouvrir/
    replier le panneau d'outils, quel que soit son état, ne redimensionne
    plus jamais self.tabs."""

    demande_retour = Signal(str)  # clé de l'écran d'origine à réafficher
    # CORRECTIF (bug rapporté : "j'ai renommé un cL et ça n'apparaît même
    # plus [dans le titre de l'onglet]") -- relais pur vers MainWindow,
    # MÊME patron que demande_ouvrir_config_layout mais dans l'autre sens
    # (ici : ApplicationsScreen -> MainWindow -> ServiceAPIScreen ->
    # ComposantsLayoutScreen, cf. connexion posée dans
    # MainWindow._ouvrir_config_layout). Émis tel quel depuis
    # ComposantLayoutConfigScreen.composant_layout_renomme (ancien nom
    # complet, nouveau nom complet), cf. ouvrir_config_layout ci-dessous.
    composant_layout_renomme = Signal(str, str)

    # CORRECTIF (retour utilisateur : "le badge de validation... j'ai
    # remarqué que je suis obligé de rouvrir la page des composants pour
    # que ça prenne effet") -- MÊME patron EXACT que composant_layout_
    # renomme juste au-dessus, mais pour une modification EN PLACE (pas
    # de changement de nom). Émis tel quel depuis ComposantLayoutConfigScreen.
    # composant_layout_modifie (qui, lui, n'a pas d'argument -- signal
    # générique réutilisé pour couleur_zone, etc., cf. sa docstring de
    # classe), avec le nom complet du ComposantLayout ajouté ici via
    # lambda pour que MainWindow sache QUELLE tuile rafraîchir sans
    # changer la signature du signal d'origine (cf. ouvrir_config_layout
    # ci-dessous).
    composant_layout_modifie_relais = Signal(str)

    # (id_outil, label, icône qta) -- cf. _sur_clic_outil_generique. Ajouter
    # un futur outil générique ici suffit, aucun autre endroit à toucher.
    OUTILS_GENERIQUES = [
        ("donnees_fictives", "Données fictives", "mdi6.creation"),
        ("test_composant", "Test de composant", "mdi6.test-tube"),
        ("coordonnee_action", "Coordonnée action", "mdi6.cursor-default-click"),
    ]

    # Contenu des guides pour les outils qui exigent un composant déjà
    # capturé (donc pas ouvrables "à vide" depuis ce panneau) -- cf.
    # GuideOutilScreen. id_outil -> (titre, texte, cle_ecran_cible,
    # label_bouton_cible). Clé cible = "api" (écran ServiceAPI, qui
    # contient l'onglet interne Composants -- cf. vérification faite
    # avant ce patch : pas de clé "composants" directe dans self.screens).
    GUIDES_OUTILS = {
        "test_composant": (
            "Test de composant",
            "Cet outil s'ouvre depuis la carte d'un composant : écran "
            "Service API → onglet Composants → bouton \"Tester\" sur la "
            "carte du composant voulu. Il ouvre alors un nouvel onglet ici "
            "même, présélectionné sur ce composant.",
            "api",
            "Aller à Service API",
        ),
        "coordonnee_action": (
            "Coordonnée action",
            "Cet outil s'ouvre depuis la carte d'un composant : écran "
            "Service API → onglet Composants → bouton \"Définir zone de "
            "clic\" sur la carte du composant voulu. Il ouvre alors un "
            "nouvel onglet ici même, fixé sur ce composant.",
            "api",
            "Aller à Service API",
        ),
    }

    def __init__(self, project: Project, reglages: "ReglagesApp", parent=None):
        super().__init__(parent)
        self.project = project
        self.reglages = reglages
        # PATCH (sélecteur groupé Local/Réseau de TestComposantScreen) --
        # câblé par MainWindow (definir_client_serveur_t/definir_
        # executants_reseau_connus), propagé à CHAQUE TestComposantScreen
        # créée dans ouvrir_test_composant (un nouvel onglet = une nouvelle
        # instance de l'écran, cf. sa docstring : "toujours un nouvel
        # onglet... pas de dédup"), puisqu'aucun état n'est partagé entre
        # onglets pour cet écran (contrairement à _noms_executants_reseau
        # côté TaskConfigScreen, qui n'a qu'UNE seule instance vivante).
        self._client_serveur_t: Optional["ClientServeurT"] = None
        self._noms_executants_reseau: dict[str, str] = {}
        # PATCH (sélecteur de PROFIL réseau, pas juste de sAutoniax --
        # cf. definir_instances_par_profil_reseau) -- {id_executant:
        # {nom_profil: instance_id}}, même patron de propagation que
        # _noms_executants_reseau juste au-dessus (câblé par MainWindow,
        # redistribué à chaque TestComposantScreen créée ET déjà ouverte).
        self._instances_par_profil_reseau: dict[str, dict[str, str]] = {}
        # Onglets TestComposantScreen actuellement ouverts -- pour
        # rediffuser un futur executants_detail_change à TOUS les onglets
        # déjà ouverts, pas seulement à ceux créés APRÈS ce signal (cf.
        # definir_executants_reseau_connus ci-dessous).
        self._onglets_test_composant: list["TestComposantScreen"] = []

        layout_racine = QHBoxLayout(self)
        layout_racine.setContentsMargins(0, 0, 0, 0)
        layout_racine.setSpacing(0)

        # --- Colonne droite : onglets + état vide (comportement inchangé
        # sur le fond -- SEUL changement : elle occupe maintenant TOUTE
        # la largeur de layout_racine, cf. docstring de classe, PATCH
        # "pas modifier le layout" -- construite EN PREMIER, avant
        # panneau_gauche, puisque ce dernier en a besoin comme parent
        # d'ancrage/parent Qt réel, cf. PanneauOutilsEscamotable.__init__) ---
        colonne_droite = QWidget(self)
        layout = QVBoxLayout(colonne_droite)
        # FIX (retour utilisateur : "le panneau même replié cache encore
        # légèrement l'interface de test") -- PanneauOutilsEscamotable
        # (cf. plus bas) reste un widget FLOTTANT hors de tout layout
        # (demande explicite précédente : "pas modifier le layout"), mais
        # même REPLIÉE, sa languette de _LARGEUR_REPLIEE (28px, cf. sa
        # classe) est ancrée à x=0 de CE widget -- exactement là où
        # commence le contenu de chaque onglet (TestComposantScreen and
        # co, eux aussi posés à x=0 dans leur propre layout géré). Une
        # marge gauche FIXE de 28px ici pousse tout le CONTENU des
        # onglets de ces 28px vers la droite, dégageant en permanence la
        # zone qu'occupe la languette au repos -- SANS que ce widget
        # (colonne_droite) lui-même ne bouge ni ne se redimensionne
        # jamais (contrairement à l'ancien comportement corrigé par le
        # patch ci-dessous, où c'était panneau_gauche qui poussait tout
        # via addWidget dans layout_racine) : au dépli au survol, la
        # languette continue de grandir PAR-DESSUS ce contenu décalé
        # (setGeometry manuel, indépendant de cette marge), exactement le
        # comportement demandé.
        layout.setContentsMargins(PanneauOutilsEscamotable._LARGEUR_REPLIEE, 0, 0, 0)
        layout.setSpacing(0)
        layout_racine.addWidget(colonne_droite, 1)

        # --- Panneau gauche : liste des outils génériques ---
        # PATCH (demande explicite utilisateur : "je veux plus que elle
        # modifie le layout merde, elle est censee s'afficher au dessus
        # de l'interface des app ouvert, pas modifier le layout") --
        # n'est PLUS ajouté à layout_racine (cf. l'ancien layout_racine.
        # addWidget(panneau_gauche) ici avant ce patch) : parent Qt réel
        # = colonne_droite (pas self), pour que ce panneau se pose
        # au-dessus DES ONGLETS déjà ouverts, jamais à côté d'eux dans le
        # layout -- PanneauOutilsEscamotable gère elle-même sa geometry
        # (setGeometry manuel, hors de tout layout) et son repli/dépli au
        # survol, cf. sa docstring pour le mécanisme complet.
        panneau_gauche = PanneauOutilsEscamotable(colonne_droite, colonne_droite)
        panneau_gauche.setObjectName("ApplicationsPanneauOutils")
        panneau_layout = QVBoxLayout(panneau_gauche)
        panneau_layout.setContentsMargins(12, 16, 12, 16)
        panneau_layout.setSpacing(8)
        titre_panneau = QLabel("Outils", panneau_gauche)
        titre_panneau.setObjectName("ReglagesLabel")
        panneau_layout.addWidget(titre_panneau)
        self.liste_outils = QListWidget(panneau_gauche)
        self.liste_outils.setObjectName("ServiceAPIList")
        for id_outil, label_outil, icone in self.OUTILS_GENERIQUES:
            item = QListWidgetItem(qta.icon(icone, color=Mocha.subtext0), label_outil)
            item.setData(Qt.UserRole, id_outil)
            self.liste_outils.addItem(item)
        self.liste_outils.itemClicked.connect(self._sur_clic_outil_generique)
        panneau_layout.addWidget(self.liste_outils, 1)

        self.bouton_tout_fermer = QPushButton(
            qta.icon("mdi6.close-box-multiple-outline", color=Mocha.subtext0),
            " Tout fermer", panneau_gauche,
        )
        self.bouton_tout_fermer.setObjectName("RetourButton")
        self.bouton_tout_fermer.clicked.connect(self._tout_fermer)
        panneau_layout.addWidget(self.bouton_tout_fermer)
        # panneau_gauche.raise_() déjà fait dans PanneauOutilsEscamotable
        # .__init__ (après _repositionner()) -- rien à faire de plus ici
        # pour qu'il se pose bien au-dessus de self.tabs/empty_state
        # construits juste en dessous.

        self.tabs = QTabWidget(colonne_droite)
        self.tabs.setObjectName("ApplicationsTabs")
        self.tabs.setTabsClosable(True)
        self.tabs.setMovable(True)
        self.tabs.setDocumentMode(True)

        self.tabs.tabCloseRequested.connect(self._fermer_onglet)
        layout.addWidget(self.tabs, 1)

        # --- État vide (aucun onglet ouvert) ---
        self.empty_state = QWidget(colonne_droite)
        empty_layout = QVBoxLayout(self.empty_state)
        empty_layout.setAlignment(Qt.AlignCenter)
        empty_layout.setSpacing(10)
        empty_icon = QLabel(self.empty_state)
        empty_icon.setPixmap(qta.icon("mdi6.apps", color=Mocha.surface2).pixmap(48, 48))
        empty_icon.setAlignment(Qt.AlignCenter)
        empty_layout.addWidget(empty_icon)
        empty_label = QLabel(
            "Aucun outil ouvert.\nLes actions de l'application qui ont besoin "
            "d'un espace dédié s'ouvriront ici, dans un nouvel onglet.",
            self.empty_state,
        )
        empty_label.setAlignment(Qt.AlignCenter)
        empty_label.setWordWrap(True)
        empty_label.setStyleSheet(f"color: {Mocha.subtext0};")
        empty_layout.addWidget(empty_label)
        layout.addWidget(self.empty_state, 1)

        self._mettre_a_jour_etat_vide()

    def _mettre_a_jour_etat_vide(self):
        vide = self.tabs.count() == 0
        self.empty_state.setVisible(vide)
        self.tabs.setVisible(not vide)

    def _sur_clic_outil_generique(self, item: QListWidgetItem):
        """Clic sur un item du panneau gauche (cf. OUTILS_GENERIQUES) --
        ouvre un nouvel onglet SANS origine (contrairement à
        ouvrir_test_composant/ouvrir_coordonnee_action) : ces outils
        génériques sont ouverts directement depuis ce panneau, pas relayés
        depuis un autre écran, donc aucun bouton "Retour" n'a de sens ici
        -- l'onglet se ferme comme n'importe quel onglet standard (x)."""
        id_outil = item.data(Qt.UserRole)
        if id_outil == "donnees_fictives":
            screen = GenerationDonneesFictivesScreen(self)
            index = self.tabs.addTab(screen, qta.icon("mdi6.creation", color=Mocha.text), "Données fictives")
            self.tabs.setCurrentIndex(index)
            self._mettre_a_jour_etat_vide()
        elif id_outil in self.GUIDES_OUTILS:
            # Outils qui exigent un composant déjà capturé (Test de
            # composant / Coordonnée action) -- pas d'ouverture directe,
            # cf. GuideOutilScreen : un onglet guide s'ouvre à la place,
            # expliquant où/comment lancer réellement l'outil.
            titre, texte, cle_cible, label_bouton = self.GUIDES_OUTILS[id_outil]
            screen = GuideOutilScreen(titre, texte, cle_cible, label_bouton, self)
            screen.demande_navigation.connect(self.demande_retour.emit)
            index = self.tabs.addTab(screen, qta.icon("mdi6.compass-outline", color=Mocha.text), titre)
            self.tabs.setCurrentIndex(index)
            self._mettre_a_jour_etat_vide()

    # ------------------------------------------------------------------
    # Contexte réseau (sAutoniax) -- câblé par MainWindow, propagé à
    # chaque TestComposantScreen créée (cf. docstring de self._client_
    # serveur_t/_noms_executants_reseau/_onglets_test_composant, __init__)
    # ------------------------------------------------------------------
    def definir_client_serveur_t(self, client_serveur_t: Optional["ClientServeurT"]):
        self._client_serveur_t = client_serveur_t

    def definir_executants_reseau_connus(self, executants: dict):
        """Branché par MainWindow sur ClientServeurT.executants_detail_change
        (déjà reformaté en {id: nom}, même patron que TaskConfigScreen.
        definir_executants_reseau_connus) -- mémorise pour les FUTURS
        onglets Test de composant, ET rediffuse aux onglets DÉJÀ ouverts
        (cf. self._onglets_test_composant), sans quoi un onglet ouvert
        avant le premier signal resterait à jamais sans aucun sAutoniax
        dans son groupe réseau."""
        self._noms_executants_reseau = dict(executants)
        for onglet in self._onglets_test_composant:
            onglet.definir_executants_reseau_connus(self._noms_executants_reseau)

    def definir_instances_par_profil_reseau(self, instances_par_profil: dict):
        """PATCH (correctif "plusieurs profils sur une instance") -- même
        patron que definir_executants_reseau_connus juste au-dessus,
        branché par MainWindow sur son registre self.instances_par_
        profil_reseau (alimenté par demarrer_profil_isole_resultat_recu/
        kill_profil_resultat_reel_recu). {id_executant: {nom_profil:
        instance_id}} -- mémorisé pour les FUTURS onglets, rediffusé aux
        onglets DÉJÀ ouverts. dict(v) sur chaque sous-dict (copie, pas la
        même référence que le registre de MainWindow) : un TestComposantScreen
        qui modifierait son propre exemplaire par erreur ne doit jamais
        corrompre le registre partagé source."""
        self._instances_par_profil_reseau = {k: dict(v) for k, v in instances_par_profil.items()}
        for onglet in self._onglets_test_composant:
            onglet.definir_instances_par_profil_reseau(self._instances_par_profil_reseau)

    # ------------------------------------------------------------------
    # Ouverture d'outils (appelé depuis MainWindow, relayé depuis les
    # autres écrans via leurs signaux respectifs)
    # ------------------------------------------------------------------
    def ouvrir_test_composant(self, composant_nom: str, origine: Optional[str] = None):
        """Ouvre un nouvel onglet 'Test de composant' présélectionné sur
        composant_nom. Toujours un nouvel onglet, même si un autre onglet
        teste déjà le même composant (pas de dédup, à la demande explicite
        de l'utilisateur). `origine` est la clé de l'écran depuis lequel
        cette ouverture a été demandée (ex: "composants") : si fournie, un
        bouton "Retour" apparaît dans l'onglet pour y revenir directement."""
        screen = TestComposantScreen(self.project, self.reglages)
        screen.rafraichir_liste_composants()
        screen.preselectionner(composant_nom)
        screen.definir_onglet_origine(origine)
        # PATCH (sélecteur groupé Local/Réseau) -- propage le contexte
        # réseau déjà connu à CET onglet dès sa création (cf. definir_
        # executants_reseau_connus ci-dessus pour la rediffusion des
        # signaux FUTURS), et l'enregistre pour en recevoir sa part.
        screen.definir_client_serveur_t(self._client_serveur_t)
        screen.definir_executants_reseau_connus(self._noms_executants_reseau)
        screen.definir_instances_par_profil_reseau(self._instances_par_profil_reseau)
        self._onglets_test_composant.append(screen)
        screen.retour_button.clicked.connect(lambda: self._retour_et_fermer(screen, origine))
        # CORRECTIF (retour utilisateur, capture_001.png : "comment se
        # fait-il que l'interface de configuration n'a pas son nom
        # distinctif à lui, même chose que l'onglet de test composant --
        # il faut bien mettre le nom de chaque app dans son onglet avant
        # de compléter avec le nom du service et du composant") -- avant
        # ce préfixe, "Tester le ComposantLayout" (icône view-grid-outline,
        # cf. ouvrir_config_layout) et "Tester ce ComposantLayout" (icône
        # test-tube, cf. ouvrir_test_composant_layout) affichaient
        # EXACTEMENT le même texte de titre (le nom du composant/cL seul),
        # seule l'icône différait -- indiscernables dans la barre
        # d'onglets une fois côte à côte. Préfixe "Test : " ICI, cohérent
        # avec "Config : " (ouvrir_config_layout) et "Action : "
        # (ouvrir_coordonnee_action) plus bas dans ce fichier.
        index = self.tabs.addTab(screen, qta.icon("mdi6.test-tube", color=Mocha.text), f"Test : {composant_nom}")
        self.tabs.setCurrentIndex(index)
        self._mettre_a_jour_etat_vide()

    def ouvrir_test_composant_layout(self, composant_layout_nom: str, origine: Optional[str] = None):
        """REFONTE (demande explicite utilisateur : "enlève l'onglet Test
        [de ComposantLayoutConfigScreen], on va directement réutiliser
        l'interface de test de composant actuelle, exactement la même
        interface") -- MÊME patron que ouvrir_test_composant ci-dessus,
        seule différence : TestComposantScreen construite en
        MODE_COMPOSANT_LAYOUT (combo listant project.composants_layout,
        bloc "ACTION SI DÉTECTÉ" masqué, détection via detecter_toutes_
        instances_composant_layout au lieu de DetectionWorker -- cf.
        docstring de TestComposantScreen.__init__/_sur_capture_propre_
        pour_detection). Même liste self._onglets_test_composant que cS
        (rediffusion réseau générique, indifférente au mode -- cf.
        definir_executants_reseau_connus/definir_instances_par_profil_
        reseau ci-dessus)."""
        screen = TestComposantScreen(self.project, self.reglages, mode=TestComposantScreen.MODE_COMPOSANT_LAYOUT)
        screen.rafraichir_liste_composants()
        screen.preselectionner(composant_layout_nom)
        screen.definir_onglet_origine(origine)
        screen.definir_client_serveur_t(self._client_serveur_t)
        screen.definir_executants_reseau_connus(self._noms_executants_reseau)
        screen.definir_instances_par_profil_reseau(self._instances_par_profil_reseau)
        self._onglets_test_composant.append(screen)
        screen.retour_button.clicked.connect(lambda: self._retour_et_fermer(screen, origine))
        # CORRECTIF (même préfixe "Test : " que ouvrir_test_composant
        # ci-dessus, cf. son commentaire détaillé -- distingue cet onglet
        # de "Config : {nom}" pour le MÊME ComposantLayout, ouvert depuis
        # ouvrir_config_layout).
        index = self.tabs.addTab(screen, qta.icon("mdi6.test-tube", color=Mocha.text), f"Test : {composant_layout_nom}")
        self.tabs.setCurrentIndex(index)
        self._mettre_a_jour_etat_vide()

    def ouvrir_coordonnee_action(self, composant_nom: str, origine: Optional[str] = None):
        """Ouvre un nouvel onglet CoordonneeActionScreen fixé sur
        composant_nom (pas de sélecteur, contrairement à
        ouvrir_test_composant -- cf. docstring de CoordonneeActionScreen).
        Toujours un nouvel onglet, même contrat de `origine` que
        ouvrir_test_composant. zone_definie est connecté ici pour persister
        directement dans le Project (même logique que
        ComposantsScreen._on_zone_clic_definie, cf. contrat de la docstring
        de CoordonneeActionScreen : "cette classe ne touche PAS au Project
        directement")."""
        composant = self.project.find_composant(composant_nom)
        if composant is None:
            return
        screen = CoordonneeActionScreen(self.project, composant, self.reglages)
        screen.definir_onglet_origine(origine)
        screen.zone_definie.connect(self._sur_zone_definie)
        screen.retour_button.clicked.connect(lambda: self._retour_et_fermer(screen, origine))
        # CORRECTIF (même besoin de préfixe distinctif que ouvrir_test_
        # composant/ouvrir_config_layout, cf. leurs commentaires) --
        # "Action : " pour cet écran de coordonnée de clic.
        index = self.tabs.addTab(
            screen, qta.icon("mdi6.cursor-default-click-outline", color=Mocha.text), f"Action : {composant_nom}"
        )
        self.tabs.setCurrentIndex(index)
        self._mettre_a_jour_etat_vide()

    def _sur_zone_definie(self, composant_nom: str, zone: ZoneClicRect):
        composant = self.project.find_composant(composant_nom)
        if composant is None:
            return
        composant.zone_clic_rect = zone
        self.project.save()

    def ouvrir_config_layout(self, composant_layout_nom: str, origine: Optional[str] = None):
        """AJOUT (cL, SPEC_composantLayout.md section 5/7.2) : ouvre un
        nouvel onglet ComposantLayoutConfigScreen pré-rempli sur ce
        ComposantLayout -- MÊME patron que ouvrir_coordonnee_action
        ci-dessus (composant déjà déterminé, pas de sélecteur). Toujours
        un nouvel onglet, même contrat de `origine`.

        composant_layout_modifie (cf. sa docstring côté
        ComposantLayoutConfigScreen : "laisse l'appelant décider du
        rythme de sauvegarde sur disque") -- ici, sauvegarde à CHAQUE
        émission plutôt qu'un debounce : le screen lui-même n'émet déjà
        qu'à des points de changement significatifs (pas à chaque frappe
        clavier dans code_filtre, cf. sa propre docstring de signal),
        donc pas de sur-sollicitation disque à craindre."""
        composant_layout = self.project.find_composant_layout(composant_layout_nom)
        if composant_layout is None:
            return
        screen = ComposantLayoutConfigScreen(self.project, composant_layout, self.reglages)
        screen.definir_onglet_origine(origine)
        screen.composant_layout_modifie.connect(self.project.save)
        # CORRECTIF (retour utilisateur : badge de validation qui
        # nécessitait de rouvrir la page des composants pour se
        # rafraîchir) -- relais vers MainWindow avec le nom complet
        # capturé par fermeture lexicale (cf. composant_layout_modifie_
        # relais, docstring de sa déclaration juste au-dessus dans cette
        # classe) : composant_layout_nom est fixe pour tout le cycle de
        # vie de CET onglet (pas de sélecteur, cf. docstring de cette
        # méthode), donc pas besoin d'aller relire self.composant_layout
        # côté screen -- même simplicité que le lambda de composant_
        # layout_renomme juste plus bas.
        screen.composant_layout_modifie.connect(
            lambda: self.composant_layout_modifie_relais.emit(composant_layout_nom)
        )
        screen.retour_button.clicked.connect(lambda: self._retour_et_fermer(screen, origine))
        # CORRECTIF (retour utilisateur, capture_001.png -- cf. commentaire
        # détaillé dans ouvrir_test_composant ci-dessus) : préfixe
        # "Config : " pour distinguer cet onglet de "Test : {même nom}"
        # (ouvrir_test_composant_layout), auparavant identiques.
        index = self.tabs.addTab(
            screen, qta.icon("mdi6.view-grid-outline", color=Mocha.text), f"Config : {composant_layout_nom}"
        )
        self.tabs.setCurrentIndex(index)
        self._mettre_a_jour_etat_vide()

        # CORRECTIF (bug rapporté : "j'ai renommé un cL et ça n'apparaît
        # même plus") -- le renommage (cf. ComposantLayoutConfigScreen.
        # _sur_nom_composant_layout_change) est bien persisté (Project.
        # rename_composant_layout) mais rien ne rafraîchissait ni le
        # titre de CET onglet, ni la grille d'origine (ComposantsLayoutScreen,
        # qui ne se rechargeait qu'au changement d'onglet -- cf. son
        # correctif partiel existant, currentChanged). Ici : (1) le titre
        # de l'onglet suit le nouveau nom immédiatement, PRÉFIXÉ "Config : "
        # (cf. commentaire détaillé sur le préfixe juste au-dessus --
        # sans quoi un renommage ferait perdre le préfixe distinctif et
        # redeviendrait indiscernable d'un onglet "Test : {même nom}") :
        # deux onglets peuvent viser des cL différents, indexOf(screen)
        # retrouve précisément CET onglet même si d'autres ont été
        # ouverts/fermés entretemps. (2) relais tel quel vers MainWindow
        # pour que la grille d'origine se corrige aussi sans attendre un
        # changement d'onglet.
        screen.composant_layout_renomme.connect(
            lambda ancien, nouveau: self.tabs.setTabText(self.tabs.indexOf(screen), f"Config : {nouveau}")
        )
        screen.composant_layout_renomme.connect(self.composant_layout_renomme.emit)

        # AJOUT (bouton Supprimer déplacé dans l'onglet Général, cf.
        # ComposantLayoutConfigScreen.demande_suppression) : suppression
        # RÉELLE ici (cet écran ne touche jamais au Project directement,
        # même contrat que composant_layout_modifie ci-dessus), puis
        # fermeture de CET onglet -- même chemin que retour_button (cf.
        # _retour_et_fermer). La grille d'origine (ComposantsLayoutScreen)
        # n'a pas besoin d'un rafraîchissement séparé ici : elle se
        # recharge déjà à chaque set_service_api_actif/changement d'onglet
        # (cf. son mécanisme existant, currentChanged côté ServiceAPIScreen).
        screen.demande_suppression.connect(
            lambda nom: self._supprimer_composant_layout_et_fermer(screen, nom, origine)
        )

        # AJOUT (retour utilisateur, capture à l'appui : bouton "Tester"
        # directement dans la bande du haut de ComposantLayoutConfigScreen,
        # cf. docstring de ComposantLayoutConfigScreen.demande_tester) --
        # simple relais vers ouvrir_test_composant_layout, MÊME patron que
        # le bouton "Tester" du panneau flottant de la grille (cf.
        # ComposantsLayoutScreen._sur_tester ci-dessus), à une différence
        # près : ici `origine` est CET onglet de configuration lui-même
        # (et non la grille), pour que le bouton "Retour" du nouvel onglet
        # Test ramène bien vers cet écran de config -- cohérent avec le
        # fait que ce nouvel onglet est ouvert DEPUIS lui.
        screen.demande_tester.connect(
            lambda nom: self.ouvrir_test_composant_layout(nom, origine)
        )

    def ouvrir_rendu_task_reseau(self, widget: QWidget, titre: str, origine: Optional[str] = None):
        """PATCH B.5 (cf. cahier des charges patchs.md) -- ajoute EN
        ONGLET un widget de rendu réseau DÉJÀ CONSTRUIT (contrairement à
        ouvrir_test_composant/ouvrir_coordonnee_action, qui construisent
        eux-mêmes leur écran) : `widget` est FenetreRenduTaskReseau,
        possédé et réutilisé par TaskConfigScreen d'un clic à l'autre sur
        "Voir le rendu" (cf. self._fenetre_rendu_reseau côté
        TaskConfigScreen) -- CE widget ne doit donc JAMAIS être détruit
        par cet écran (contrairement aux onglets Test composant/
        Coordonnée action, qui sont possédés et détruits ici). Si déjà
        présent dans self.tabs (rouvrir "Voir le rendu" alors que
        l'onglet est déjà ouvert), le sélectionne simplement au lieu d'en
        ajouter un second -- DÉDUP explicite ici, contrairement aux
        autres ouvrir_xxx (pas d'ambiguïté possible : un seul rendu réseau
        possible par TaskConfigScreen, un seul widget existe jamais).

        Retourne l'index de l'onglet (nouveau ou déjà existant)."""
        # CORRECTIF : le rendu réseau ne doit jamais devenir un onglet.
        if type(widget).__name__ == "FenetreRenduTaskReseau":
            return -1
        index_existant = self.tabs.indexOf(widget)
        if index_existant != -1:
            self.tabs.setTabText(index_existant, titre)
            self.tabs.setCurrentIndex(index_existant)
            self._mettre_a_jour_etat_vide()
            return index_existant
        index = self.tabs.addTab(widget, qta.icon("mdi6.monitor-eye", color=Mocha.text), titre)
        self.tabs.setCurrentIndex(index)
        self._mettre_a_jour_etat_vide()
        return index

    def retirer_rendu_task_reseau(self, widget: QWidget):
        """Symétrique de ouvrir_rendu_task_reseau -- retire `widget` de
        self.tabs SANS le détruire (cf. docstring ci-dessus : possédé par
        TaskConfigScreen, jamais par cet écran). Appelée par
        TaskConfigScreen dans deux cas : (1) détachement en fenêtre
        flottante (cf. FenetreRenduTaskReseau.detacher_demande), le
        widget doit quitter le QTabWidget avant de devenir top-level, un
        widget ne peut pas être aux deux endroits à la fois ; (2) fermeture
        définitive (cf. TaskConfigScreen._sur_fermeture_rendu_reseau) --
        no-op silencieux si le widget n'est déjà plus dans les onglets
        (ex. déjà détaché)."""
        index = self.tabs.indexOf(widget)
        if index != -1:
            self.tabs.removeTab(index)
            self._mettre_a_jour_etat_vide()

    def _fermer_onglet(self, index: int):
        widget = self.tabs.widget(index)
        # Coupe proprement toute boucle en cours (QTimer) avant destruction,
        # pour ne pas laisser un test tourner sur un widget détruit.
        if hasattr(widget, "arreter"):
            widget.arreter()
        # PATCH B.5 -- FenetreRenduTaskReseau (bouton (x) natif du
        # QTabWidget cliqué directement sur SON onglet, cf. ouvrir_rendu_
        # task_reseau) n'est PAS détruite ici, contrairement aux autres
        # widgets d'onglet (Test composant, Coordonnée action) : elle est
        # possédée par TaskConfigScreen, qui doit garder une référence
        # valide. self.tabs.tabCloseRequested reste connecté globalement
        # à cette même méthode pour tous les onglets (cf. __init__) --
        # isinstance() distingue ce cas particulier sans complexifier le
        # branchement du signal lui-même.
        if isinstance(widget, FenetreRenduTaskReseau):
            self.tabs.removeTab(index)
            self._mettre_a_jour_etat_vide()
            widget.fermeture_demandee.emit()
            return
        self.tabs.removeTab(index)
        if isinstance(widget, TestComposantScreen) and widget in self._onglets_test_composant:
            # cf. docstring de self._onglets_test_composant (__init__) --
            # évite de rediffuser un futur executants_detail_change vers
            # un widget sur le point d'être détruit (deleteLater() juste
            # en dessous : le widget existe encore en mémoire Python
            # jusqu'au prochain passage de la boucle d'événements, un
            # signal Qt émis entre-temps vers lui ne planterait pas
            # forcément, mais n'aurait plus aucun sens).
            self._onglets_test_composant.remove(widget)
        if widget is not None:
            widget.deleteLater()
        self._mettre_a_jour_etat_vide()

    def _tout_fermer(self):
        """Bouton "Tout fermer" du panneau gauche (retour utilisateur :
        "je veux que tu mets un bouton pour tout fermer les onglets") --
        ferme chaque onglet ouvert un par un, en repartant systématiquement
        du dernier (index le plus élevé) pour ne jamais décaler les index
        restants pendant la boucle. Réutilise _fermer_onglet telle quelle
        pour chaque onglet, donc même arrêt propre des timers/tests en
        cours (widget.arreter()) qu'une fermeture individuelle -- pas de
        confirmation demandée, cohérent avec la fermeture (x) d'un onglet
        seul, qui n'en demande pas non plus."""
        while self.tabs.count() > 0:
            self._fermer_onglet(self.tabs.count() - 1)

    def arreter_tout_avant_fermeture_app(self):
        """BUGFIX (persistance du profil de test non sauvegardée à la
        fermeture de l'app) -- appelée par MainWindow.closeEvent AVANT que
        la fenêtre ne se ferme réellement. Sans ça, quitter directement
        AutoniaX (bouton fermer natif, Alt+F4, etc.) SANS avoir au
        préalable fermé à la main chaque onglet "Test de composant" (via
        le (x) de l'onglet, seul chemin qui appelait jusqu'ici
        TestComposantScreen.arreter(), cf. _fermer_onglet ci-dessus)
        sautait entièrement la sauvegarde de dernier_profil_test_local/
        dernier_profil_test_reseau (posée dans arreter(), cf. sa
        docstring) -- la resélection automatique au prochain lancement
        n'avait alors tout simplement rien à resélectionner. Boucle sur
        une COPIE de self._onglets_test_composant (list(...)) : arreter()
        ne modifie pas cette liste elle-même, mais rester sur l'original
        pendant une itération est une prudence peu coûteuse si jamais un
        futur appel déclenché en cascade venait à la modifier. Ne ferme
        PAS les onglets (pas de removeTab/deleteLater ici) : la fenêtre
        entière est de toute façon sur le point d'être détruite juste
        après par MainWindow.closeEvent, inutile de dupliquer ce travail."""
        for onglet in list(self._onglets_test_composant):
            onglet.arreter()

    def _retour_et_fermer(self, screen: QWidget, origine: Optional[str]):
        """Callback commun des 3 boutons "Retour" (Test composant,
        Coordonnée action, Test action) : contrairement au comportement
        précédent (qui laissait l'onglet ouvert en arrière-plan), "Retour"
        ferme désormais l'onglet — même logique que le bouton de fermeture
        d'onglet standard (_fermer_onglet, arrêt propre du timer/test en
        cours) — puis seulement ensuite ramène à l'écran d'origine."""
        index = self.tabs.indexOf(screen)
        if index != -1:
            self._fermer_onglet(index)
        self.demande_retour.emit(origine)

    def _supprimer_composant_layout_et_fermer(self, screen: QWidget, composant_layout_nom: str, origine: Optional[str]):
        """Callback du bouton "Supprimer ce ComposantLayout" (onglet
        Général de ComposantLayoutConfigScreen, cf. son signal
        demande_suppression) : suppression RÉELLE côté Project (cet écran
        de config, comme tous les autres ouverts depuis cette classe, ne
        touche jamais au Project directement), sauvegarde immédiate, puis
        fermeture de cet onglet -- même chemin que _retour_et_fermer,
        pour ne pas dupliquer la logique de fermeture propre d'onglet."""
        self.project.remove_composant_layout(composant_layout_nom)
        self.project.save()
        self._retour_et_fermer(screen, origine)


