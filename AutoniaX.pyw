        padding: 2px 4px;
    }}

    #CelluleTitreLabel[vide="true"] {{
        color: {m.subtext0};
        font-weight: 400;
        font-style: italic;
    }}

    #CelluleTitreEdit {{
        background-color: {m.surface0};
        color: {m.text};
        border: 1px solid {m.mauve};
        border-radius: {RADIUS}px;
        padding: 4px 6px;
        font-size: 14px;
        font-weight: 600;
    }}

    #CelluleDescriptionLabel {{
        color: {m.subtext1};
        font-size: 12px;
        padding: 0px 4px;
    }}

    #CelluleDescriptionLabel[vide="true"] {{
        color: {m.subtext0};
        font-style: italic;
    }}

    #CelluleDescriptionEdit {{
        background-color: {m.surface0};
        color: {m.text};
        border: 1px solid {m.mauve};
        border-radius: {RADIUS}px;
        padding: 4px 6px;
        font-size: 12px;
    }}

    #CelluleSortie {{
        background-color: {DarculaTheme.bordure};
        color: {DarculaTheme.texte};
        border: 1px solid {DarculaTheme.bordure};
