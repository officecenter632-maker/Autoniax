    # ------------------------------------------------------------------
    # Reglages / correspondance
    # ------------------------------------------------------------------
    def definir_reglages(self, reglages):
        self._reglages = reglages
        self._rafraichir_resume_correspondance()
        self._recalculer_noms()

    def _reglages_courants(self):
        if self._reglages is None:
            self._reglages = ReglagesApp.load()
        return self._reglages

    def _correspondance(self) -> dict:
        return dict(getattr(self._reglages_courants(), "kaggle_correspondance_noms", None) or {})

    def _rafraichir_resume_correspondance(self):
        libelle, infobulle = resume_correspondance(self._reglages_courants())
        self.label_correspondance.setText(libelle)
        self.label_correspondance.setToolTip(infobulle)

    def _sur_clic_importer(self):
        texte = QGuiApplication.clipboard().text()
        try:
            correspondance, avertissements = importer_correspondance(self._reglages_courants(), texte)
        except ErreurCorrespondance as e:
            self.ajouter_journal(f"Import refuse : {e}")
            QMessageBox.warning(self, "Correspondance Kaggle",
                                f"{e}\n\nLa correspondance precedente est conservee.")
            return
        self.ajouter_journal(f"Correspondance importee : {len(correspondance)} entree(s).")
        self._rafraichir_resume_correspondance()
        self._recalculer_noms()
        if avertissements:
            QMessageBox.information(self, "Correspondance Kaggle", "Importee avec avertissement(s) :\n\n" + "\n".join(avertissements[:15]))

    def _sur_clic_copier_ia(self):
        noms = [str(p.get("nom", "")) for profils in self._profils_par_sautoniax.values() for p in profils]
        correspondance = self._correspondance()
        if not noms and not correspondance:
            self.ajouter_journal("Rien à copier : aucun profil chargé et aucune correspondance enregistrée.")
            return
        texte = construire_texte_correspondance_ia(noms, correspondance)
        QGuiApplication.clipboard().setText(texte)
        nb_entrees = len(json.loads(texte[len(PROMPT_CORRESPONDANCE_IA):]))
        self.ajouter_journal(f"Prompt + JSON copiés dans le presse-papiers ({nb_entrees} entrée(s)).")

    def texte_journal(self) -> str:
        return "\n".join(self.journal.item(i).text() for i in range(self.journal.count()))

    def _sur_clic_copier_logs(self):
        texte = self.texte_journal()
        if not texte:
            self.ajouter_journal("Journal vide : rien a copier.")
            return
        QGuiApplication.clipboard().setText(texte)
        self.ajouter_journal(f"Logs copiés dans le presse-papiers ({self.journal.count()} ligne(s)).")

    def _sur_clic_vider(self):
        vider_correspondance(self._reglages_courants())
        self.ajouter_journal("Correspondance videe.")
        self._rafraichir_resume_correspondance()
        self._recalculer_noms()

    # ------------------------------------------------------------------
    # Donnees entrantes (appelees par MainWindow)
    # ------------------------------------------------------------------
    def definir_sautoniax_disponibles(self, executants: dict):
        """{id_executant: nom} des sAutoniax connectes. Les sAutoniax deconnectes
        disparaissent ; les nouveaux demandent leurs profils si l'ecran a deja ete affiche."""
        nouveaux = sorted(i for i in executants if i not in self._sautoniax)
        coches = {self.liste_cibles.item(r).data(Qt.UserRole): self.liste_cibles.item(r).checkState()
                  for r in range(self.liste_cibles.count())}
        self._sautoniax = dict(executants)
        for i in list(self._profils_par_sautoniax):
            if i not in self._sautoniax:
                del self._profils_par_sautoniax[i]
        self.liste_cibles.blockSignals(True)
        self.liste_cibles.clear()
        for id_executant, nom in sorted(self._sautoniax.items(), key=lambda kv: (kv[1], kv[0])):
            it = QListWidgetItem(nom)
            it.setFlags(it.flags() | Qt.ItemIsUserCheckable)
            it.setData(Qt.UserRole, id_executant)
            it.setCheckState(coches.get(id_executant, Qt.Unchecked))
            self.liste_cibles.addItem(it)
        self.liste_cibles.blockSignals(False)
        self._reconstruire_arbre()
        self._rafraichir_boutons()
        if nouveaux and self._deja_affiche:
            self.demande_kaggle_actualiser_profils.emit(nouveaux)

    def definir_profils_sautoniax(self, id_executant: str, profils: list):
        """profils : [{"nom", "taille_octets", "modifie_ts", "origine_kaggle" (str|None)}]."""
        if id_executant not in self._sautoniax:
            return
        self._profils_par_sautoniax[id_executant] = list(profils or [])
        self._reconstruire_arbre()
        self.ajouter_journal(f"{self._sautoniax.get(id_executant, id_executant)} : {len(profils or [])} profil(s).")

    def definir_activite_kaggle(self, en_cours: bool, texte: str = ""):
        """Indicateur visible d'une requete Kaggle en cours : barre indeterminee + libelle + ligne de journal."""
        self.barre_activite_kaggle.setVisible(bool(en_cours))
        if en_cours:
            self.label_connexion.setText(f"Kaggle : {texte or 'requete en cours...'}")
            self.label_connexion.setToolTip("")
            self.ajouter_journal(texte or "Requete Kaggle en cours...")

    def definir_etat_connexion(self, ok: bool, message: str = "", quota_octets: Optional[int] = None):
        if not ok:
            self.barre_activite_kaggle.setVisible(False)
        self.label_connexion.setText("Kaggle : connecte" if ok else f"Kaggle : {message or 'erreur de connexion'}")
        self.label_connexion.setToolTip(message)
        if quota_octets is not None:
            self.label_quota.setText(f"Quota prive : {formater_taille_octets(quota_octets)} / {QUOTA_PRIVE_GO} Go")
        self.ajouter_journal("Connexion Kaggle OK." if ok else f"Connexion Kaggle : {message}")

    def definir_datasets(self, datasets: list):
        self.barre_activite_kaggle.setVisible(False)
        self._datasets = list(datasets or [])
        self._reconstruire_table_datasets()
        self.label_quota.setText(
            f"Quota prive : {formater_taille_octets(GestionnaireKaggle.quota_utilise_octets(self._datasets))} / {QUOTA_PRIVE_GO} Go")
        total = _DIAG_KAGGLE.get("total_datasets_vus")
        self.ajouter_journal(f"{len(self._datasets)} dataset(s) ax- sur Kaggle."
                             + (f" ({total} dataset(s) au total sur le compte.)" if total is not None else ""))
        self._recalculer_noms()

    # ------------------------------------------------------------------
    # Bloc A : arbre
    # ------------------------------------------------------------------
    def _reconstruire_arbre(self):
        if self._operation_id is not None:
            self._arbre_perime = True  # reconstruit a la fin de l'operation (cf. terminer_operation)
            return
        self._arbre_perime = False
        self._maj_en_cours = True
        try:
            for (i, nom), it in self._items.items():
                self._etat_cases[(i, nom)] = (it.checkState(self.COL_PROFIL) == Qt.Checked,
                                              it.checkState(self.COL_GARDER) == Qt.Checked)
            self.arbre_envoi.clear()
            self._items.clear()
            self._items_sautoniax.clear()
            for id_executant, nom_sautoniax in sorted(self._sautoniax.items(), key=lambda kv: (kv[1], kv[0])):
                parent = QTreeWidgetItem([nom_sautoniax])
                parent.setFlags(parent.flags() | Qt.ItemIsUserCheckable | Qt.ItemIsAutoTristate)
                parent.setCheckState(self.COL_PROFIL, Qt.Checked)
                self.arbre_envoi.addTopLevelItem(parent)
                self._items_sautoniax[id_executant] = parent
                profils = self._profils_par_sautoniax.get(id_executant)
                if profils is None:
                    parent.setText(self.COL_ETAT, "profils non charges")
                    continue
                for p in sorted(profils, key=lambda p: str(p.get("nom", "")).lower()):
                    nom_local = str(p.get("nom", ""))
                    origine = p.get("origine_kaggle")
                    coche, garder = self._etat_cases.get((id_executant, nom_local), (True, bool(origine)))
                    it = QTreeWidgetItem([nom_local, formater_taille_octets(p.get("taille_octets")),
                                          formater_horodatage(p.get("modifie_ts")), "", "", "", ""])
                    it.setFlags(it.flags() | Qt.ItemIsUserCheckable)
                    it.setCheckState(self.COL_PROFIL, Qt.Checked if coche else Qt.Unchecked)
                    it.setCheckState(self.COL_GARDER, Qt.Checked if garder else Qt.Unchecked)
                    it.setData(self.COL_PROFIL, Qt.UserRole, float(p.get("modifie_ts") or 0))
                    if origine:
                        it.setToolTip(self.COL_GARDER, f"Profil venu de Kaggle (archive : {origine}).")
                    parent.addChild(it)
                    self._items[(id_executant, nom_local)] = it
                parent.setExpanded(True)
        finally:
            self._maj_en_cours = False
        self._recalculer_noms()

    def _lignes(self) -> list:
        lignes = []
        for (i, nom), it in self._items.items():
            lignes.append({"id_executant": i, "nom_executant": self._sautoniax.get(i, i), "nom_local": nom,
                           "garder_nom": it.checkState(self.COL_GARDER) == Qt.Checked,
                           "coche": it.checkState(self.COL_PROFIL) == Qt.Checked,
                           "modifie_ts": it.data(self.COL_PROFIL, Qt.UserRole) or 0})
        return lignes

    def _sur_case_changee(self, item, colonne):
        if self._maj_en_cours or self._operation_id is not None:
            return
        if colonne in (self.COL_PROFIL, self.COL_GARDER):
            self._recalculer_noms()

    def _recalculer_noms(self):
        """Resout les noms d'archive et colore les lignes (rouge = erreur, gris = ignoree)."""
        if self._operation_id is not None:
            self._rafraichir_boutons()
            return
        lignes = self._lignes()
        self._plan_courant = planifier_envoi(lignes, self._correspondance())
        self._lignes_courantes_cache = lignes
        self._maj_en_cours = True
        try:
            for ligne, plan in zip(lignes, self._plan_courant):
                it = self._items.get((ligne["id_executant"], ligne["nom_local"]))
                if it is None:
                    continue
                couleur = None
                if not ligne["coche"]:
                    etat, archive, infobulle = "non selectionne", "", ""
                    couleur = Mocha.overlay1
                elif plan["erreur"]:
                    etat, archive, infobulle = "erreur de nommage", plan["nom_archive"], plan["erreur"]
                    couleur = Mocha.red
                elif plan["ignore"]:
                    etat, archive, infobulle = "ignore (copie plus ancienne)", "", plan["avertissement"] or ""
                    couleur = Mocha.overlay1
                else:
                    etat = "pret"
                    archive = plan["nom_archive"]
                    infobulle = plan["avertissement"] or ""
                    couleur = Mocha.yellow if plan["avertissement"] else None
                    if self._datasets and plan["slug"] in {d["slug"] for d in self._datasets}:
                        etat = "pret (mise a jour)"
                    elif self._datasets:
                        etat = "pret (creation)"
                it.setText(self.COL_ARCHIVE, archive)
                it.setText(self.COL_ETAT, etat)
                it.setText(self.COL_PROG, "")
                for col in range(7):
                    it.setForeground(col, QBrush(QColor(couleur)) if couleur else QBrush())
                it.setToolTip(self.COL_ARCHIVE, infobulle)
                it.setToolTip(self.COL_ETAT, infobulle)
        finally:
            self._maj_en_cours = False
        self._rafraichir_boutons()

    def _sur_clic_actualiser_profils(self):
        if self._operation_id is not None:
            return
        if not self._sautoniax:
            self.ajouter_journal("Aucun sAutoniax connecte.")
            return
        self.ajouter_journal("Demande des profils aux sAutoniax connectes...")
        self.demande_kaggle_actualiser_profils.emit(sorted(self._sautoniax))

    def _sur_clic_envoyer(self):
        if self._operation_id is not None:
            return
        self._recalculer_noms()
        lignes, plan = self._lignes_courantes_cache, self._plan_courant
        slugs = {d["slug"] for d in self._datasets} if self._datasets else None
        supprimer = self.case_supprimer.isChecked()
        r = resume_plan_envoi(plan, lignes, slugs, supprimer)
        if r["total"] == 0:
            QMessageBox.information(self, "Envoyer vers Kaggle",
                                    "Aucun profil a envoyer (selection vide ou toutes les lignes sont en erreur).")
            return
        detail = (f"{r['total']} profil(s) sur {r['sautoniax']} sAutoniax.\n"
                  + ("Archives : liste Kaggle non chargee (creation ou mise a jour inconnue).\n" if r["inconnus"]
                     else f"Archives : {r['crees']} creee(s), {r['maj']} mise(s) a jour.\n")
                  + "Les executions de ces profils seront ARRETEES avant l'archivage.\n"
                  + f"Suppression du dossier sur le sAutoniax apres envoi verifie : {'OUI' if supprimer else 'non'}.\n")
        if r["bloques"]:
            detail += f"\n{r['bloques']} ligne(s) bloquee(s) (erreur de nommage) : non envoyees."
        if r["ignores"]:
            detail += f"\n{r['ignores']} copie(s) plus ancienne(s) ignoree(s)."
        if QMessageBox.question(self, "Arreter + Archiver + Envoyer", detail + "\n\nConfirmer ?",
                                QMessageBox.Yes | QMessageBox.No, QMessageBox.No) != QMessageBox.Yes:
            return
        corr = self._correspondance()
        profils = []
        for ligne, p in zip(lignes, plan):
            if not p["partira"]:
                continue
            profils.append({"id_executant": ligne["id_executant"], "nom_executant": ligne["nom_executant"],
                            "nom_local": ligne["nom_local"], "nom_archive": p["nom_archive"], "slug": p["slug"],
                            "email": corr.get(ligne["nom_local"], ""), "modifie_ts": ligne["modifie_ts"]})
        self._operation_id = uuid.uuid4().hex[:12]
        self._marquer_lignes_en_attente({(p["id_executant"], p["nom_local"]) for p in profils})
        self._rafraichir_boutons()
        self.ajouter_journal(f"Envoi : {len(profils)} profil(s) (operation {self._operation_id}).")
        self.demande_kaggle_envoyer.emit({"id_operation": self._operation_id, "supprimer_local": supprimer,
                                          "profils": profils})

    def _marquer_lignes_en_attente(self, cles: set):
        self._maj_en_cours = True
        try:
            for cle, it in self._items.items():
                if cle in cles:
                    it.setText(self.COL_ETAT, "en attente")
                    it.setText(self.COL_PROG, "0 %")
        finally:
            self._maj_en_cours = False

    def sur_progression_envoi(self, id_operation: str, id_executant: str, nom_local: str, etape: str, pourcentage: int):
        if id_operation != self._operation_id:
            return
        it = self._items.get((id_executant, nom_local))
        if it is not None:
            self._maj_en_cours = True
            it.setText(self.COL_ETAT, etape)
            it.setText(self.COL_PROG, f"{max(0, min(100, int(pourcentage)))} %")
            self._maj_en_cours = False

    def sur_resultat_envoi(self, id_operation: str, id_executant: str, nom_local: str, ok: bool, message: str):
        if id_operation != self._operation_id:
            return
        it = self._items.get((id_executant, nom_local))
        if it is not None:
            self._maj_en_cours = True
            it.setText(self.COL_ETAT, "envoye" if ok else "ERREUR")
            if ok:
                it.setText(self.COL_PROG, "100 %")
            for col in range(7):
                it.setForeground(col, QBrush(QColor(Mocha.green if ok else Mocha.red)))
            it.setToolTip(self.COL_ETAT, message or "")
            self._maj_en_cours = False
        self.ajouter_journal(f"{self._sautoniax.get(id_executant, id_executant)} / {nom_local} : {'OK' if ok else 'ERREUR'}"
                             + (f" ({message})" if message else ""))

    # ------------------------------------------------------------------
    # Bloc B : datasets
    # ------------------------------------------------------------------
    def _rafraichir_libelle_tri(self):
        self.label_tri.setText("Tri : " + ("creation" if self._tri_datasets == "cree" else "mise a jour")
                               + ", du plus recent au plus ancien (clic sur un en-tete Cree le / Mis a jour le).")

    def _sur_clic_entete_datasets(self, section: int):
        if section in (2, 3):
            self._tri_datasets = "cree" if section == 2 else "maj"
            self._rafraichir_libelle_tri()
            self._reconstruire_table_datasets()

    def _reconstruire_table_datasets(self):
        coches = {self.table_datasets.topLevelItem(r).data(0, Qt.UserRole): self.table_datasets.topLevelItem(r).checkState(0)
                  for r in range(self.table_datasets.topLevelItemCount())}
        self.table_datasets.blockSignals(True)
        self.table_datasets.clear()
        for d in trier_datasets(self._datasets, self._tri_datasets):
            it = QTreeWidgetItem([d.get("nom_archive", ""), formater_taille_octets(d.get("taille_octets")),
                                  formater_horodatage(d.get("cree_le")), formater_horodatage(d.get("maj_le"))])
            it.setFlags(it.flags() | Qt.ItemIsUserCheckable)
            it.setCheckState(0, coches.get(d["slug"], Qt.Unchecked))
            it.setData(0, Qt.UserRole, d["slug"])
            self.table_datasets.addTopLevelItem(it)
        self.table_datasets.blockSignals(False)
        self._rafraichir_boutons()

    def _datasets_coches(self) -> list:
        """Datasets coches, dans l'ordre d'affichage."""
        par_slug = {d["slug"]: d for d in self._datasets}
        sortie = []
        for r in range(self.table_datasets.topLevelItemCount()):
            it = self.table_datasets.topLevelItem(r)
            if it.checkState(0) == Qt.Checked and it.data(0, Qt.UserRole) in par_slug:
                sortie.append(par_slug[it.data(0, Qt.UserRole)])
        return sortie

    def _cibles_cochees(self) -> list:
        return [self.liste_cibles.item(r).data(Qt.UserRole) for r in range(self.liste_cibles.count())
                if self.liste_cibles.item(r).checkState() == Qt.Checked]

    def _sur_clic_actualiser_datasets(self):
        if self._operation_id is not None:
            return
        self.definir_activite_kaggle(True, "Actualisation de la liste des datasets Kaggle en cours...")
        self.demande_kaggle_actualiser_datasets.emit()

    def _sur_clic_telecharger(self):
        if self._operation_id is not None:
            return
        choisis, cibles = self._datasets_coches(), self._cibles_cochees()
        if not choisis or not cibles:
            return
        repartition = repartir_equitablement(choisis, cibles)
        lignes = [f"{self._sautoniax.get(i, i)} : {len(v)} profil(s)" for i, v in sorted(repartition.items()) if v]
        apercu = "\n".join(lignes) + "\n\nUn profil du meme nom sur le sAutoniax cible sera ECRASE (refuse s'il est en cours d'execution)."
        if QMessageBox.question(self, "Repartir et telecharger", apercu + "\n\nConfirmer ?",
                                QMessageBox.Yes | QMessageBox.No, QMessageBox.No) != QMessageBox.Yes:
            return
        self._operation_id = uuid.uuid4().hex[:12]
        self._rafraichir_boutons()
        charge = {"id_operation": self._operation_id, "repartition": [
            {"id_executant": i, "nom_executant": self._sautoniax.get(i, i),
             "profils": [{"slug": d["slug"], "nom_archive": d["nom_archive"], "nom_local": d["nom_archive"]} for d in v]}
            for i, v in sorted(repartition.items()) if v]}
        self.ajouter_journal(f"Telechargement : {len(choisis)} profil(s) sur {len(charge['repartition'])} sAutoniax (operation {self._operation_id}).")
        self.demande_kaggle_telecharger.emit(charge)

    def sur_progression_telechargement(self, id_operation: str, id_executant: str, nom_local: str, etape: str, pourcentage: int):
        if id_operation == self._operation_id:
            self.ajouter_journal(f"{self._sautoniax.get(id_executant, id_executant)} / {nom_local} : {etape} {int(pourcentage)} %")

    def sur_resultat_telechargement(self, id_operation: str, id_executant: str, nom_local: str, ok: bool, message: str):
        if id_operation == self._operation_id:
            self.ajouter_journal(f"{self._sautoniax.get(id_executant, id_executant)} / {nom_local} : {'OK' if ok else 'ERREUR'}"
                                 + (f" ({message})" if message else ""))

    # ------------------------------------------------------------------
    # Etat, journal
    # ------------------------------------------------------------------
    def terminer_operation(self, id_operation: Optional[str] = None):
        """Libere l'ecran (une seule operation Kaggle a la fois)."""
        if id_operation is not None and id_operation != self._operation_id:
            return
        self._operation_id = None
        self.ajouter_journal("Operation terminee.")
        self._reconstruire_arbre()  # recalcule aussi les noms et les boutons
        # Les listes ont change (dossiers supprimes, profils telecharges) : on les rafraichit.
        self.demande_kaggle_actualiser_datasets.emit()
        if self._sautoniax:
            self.demande_kaggle_actualiser_profils.emit(sorted(self._sautoniax))

    def sur_non_branche(self, id_operation: Optional[str], libelle: str = "Ce flux"):
        """Phase 2 : le flux reseau n'est pas encore branche. Libere l'ecran."""
        self.ajouter_journal(f"{libelle} n'est pas encore branche (phases suivantes).")
        self._operation_id = id_operation if id_operation else self._operation_id
        self.terminer_operation(id_operation)

    def operation_en_cours(self) -> bool:
        return self._operation_id is not None

    def _rafraichir_boutons(self):
        libre = self._operation_id is None
        plan = self._plan_courant
        self.bouton_importer.setEnabled(libre)
        self.bouton_vider.setEnabled(libre)
        self.bouton_actualiser_profils.setEnabled(libre)
        self.bouton_actualiser_datasets.setEnabled(libre)
        self.bouton_envoyer.setEnabled(libre and any(p["partira"] for p in plan))
        self.bouton_telecharger.setEnabled(libre and bool(self._datasets_coches()) and bool(self._cibles_cochees()))

    def ajouter_journal(self, texte: str):
        self.journal.addItem(f"{time.strftime('%H:%M:%S')}  {texte}")
        while self.journal.count() > self.LIGNES_JOURNAL_MAX:
            self.journal.takeItem(0)
        self.journal.scrollToBottom()

    def showEvent(self, event):
        super().showEvent(event)
        if not self._deja_affiche:
            self._deja_affiche = True
            self.definir_activite_kaggle(True, "Connexion a Kaggle en cours...")
            self.demande_kaggle_verifier_connexion.emit()
            if self._sautoniax:
                self.demande_kaggle_actualiser_profils.emit(sorted(self._sautoniax))


class ControleurKaggle(QObject):
    """Profils Kaggle (phase 3) -- colle ProfilsKaggleScreen, ClientServeurT et GestionnaireKaggle.
    - connexion / quota / liste des datasets : GestionnaireKaggle dans un thread (jamais le thread Qt) ;
    - liste des profils d'un sAutoniax : ordre kaggle_lister_profils ;
    - flux A : FluxEnvoiKaggle (listage -> arret -> envoi, 1 profil par ordre).
    Flux B : FluxTelechargementKaggle (1 profil par ordre)."""

    _connexion_prete = Signal(bool, str, object)
    _datasets_prets = Signal(object)

    def __init__(self, client_serveur_t, ecran, fabrique_gestionnaire=None, parent=None):
        super().__init__(parent)
        self._client = client_serveur_t
        self._ecran = ecran
        self._fabrique = fabrique_gestionnaire or GestionnaireKaggle
        self._flux: Optional[FluxEnvoiKaggle] = None
        self._operation: Optional[str] = None
        self._type_operation = "envoi"
        self._supprimer_local = False
        self._thread_liste: Optional[threading.Thread] = None
        self._connexion_prete.connect(self._sur_connexion_prete)
        self._datasets_prets.connect(self._sur_datasets_prets)
        self._minuteur = QTimer(self)
        self._minuteur.setInterval(1000)
        self._minuteur.timeout.connect(self._sur_minuteur)
        self._minuteur.start()
        # ecran -> controleur
        ecran.demande_kaggle_verifier_connexion.connect(self.verifier_connexion)
        ecran.demande_kaggle_actualiser_profils.connect(self.actualiser_profils)
        ecran.demande_kaggle_actualiser_datasets.connect(self.actualiser_datasets)
        ecran.demande_kaggle_envoyer.connect(self.demarrer_envoi)
        ecran.demande_kaggle_telecharger.connect(self.demarrer_telechargement)
        # reseau -> controleur
        client_serveur_t.kaggle_profils_recus.connect(self._sur_profils_recus)
        client_serveur_t.kaggle_progression_recue.connect(self._sur_progression)
        client_serveur_t.kaggle_resultat_recu.connect(self._sur_resultat)
        client_serveur_t.kaggle_ack_recu.connect(self._sur_ack)
        client_serveur_t.arreter_execution_profil_resultat.connect(self._sur_ack_arret)
        client_serveur_t.arreter_execution_profil_resultat_reel_recu.connect(self._sur_arret_reel)

    # -- connexion Kaggle, quota, datasets (thread) ------------------------
    def verifier_connexion(self):
        def travail():
            try:
                g = self._fabrique()
                g.authentifier()
                datasets = g.lister_datasets()
                self._connexion_prete.emit(True, "", GestionnaireKaggle.quota_utilise_octets(datasets))
                self._datasets_prets.emit(datasets)
            except Exception as e:
                self._connexion_prete.emit(False, str(e), None)
        threading.Thread(target=travail, name="kaggle-connexion", daemon=True).start()

    def actualiser_datasets(self):
        def travail():
            try:
                self._datasets_prets.emit(self._fabrique().lister_datasets())
            except Exception as e:
                self._connexion_prete.emit(False, str(e), None)
        threading.Thread(target=travail, name="kaggle-datasets", daemon=True).start()

    def _sur_connexion_prete(self, ok, message, quota):
        self._ecran.definir_etat_connexion(bool(ok), message or "", quota)

    def _sur_datasets_prets(self, datasets):
        self._ecran.definir_datasets(datasets)

    # -- liste des profils d'un sAutoniax ----------------------------------
    def actualiser_profils(self, ids_executants):
        for id_executant in ids_executants:
            self._client.envoyer_ordre_kaggle("kaggle_lister_profils", id_executant, uuid.uuid4().hex[:12])

    def _sur_profils_recus(self, id_executant, profils):
        self._ecran.definir_profils_sautoniax(id_executant, profils)
        if self._flux is not None:
            self._flux.sur_liste(id_executant, profils)

    # -- flux A ------------------------------------------------------------
    def demarrer_envoi(self, charge: dict):
        id_operation = charge.get("id_operation", "")
        profils = list(charge.get("profils") or [])
        if self._flux is not None and not self._flux.est_termine():
            self._ecran.ajouter_journal("Une operation Kaggle est deja en cours.")
            self._ecran.terminer_operation(id_operation)
            return
        self._operation = id_operation
        self._type_operation = "envoi"
        self._supprimer_local = bool(charge.get("supprimer_local"))
        self._flux = FluxEnvoiKaggle(
            profils,
            lister=lambda i: self._client.envoyer_ordre_kaggle("kaggle_lister_profils", i, id_operation),
            arreter=self._arreter_profil,
            envoyer=self._envoyer_profil,
            notifier=lambda i, n, ok, m: self._ecran.sur_resultat_envoi(id_operation, i, n, ok, m),
            terminer=lambda: self._ecran.terminer_operation(id_operation),
        )
        self._flux.demarrer()

    def demarrer_telechargement(self, charge: dict):
        id_operation = charge.get("id_operation", "")
        if self._flux is not None and not self._flux.est_termine():
            self._ecran.ajouter_journal("Une operation Kaggle est deja en cours.")
            self._ecran.terminer_operation(id_operation)
            return
        self._operation = id_operation
        self._type_operation = "telechargement"
        self._flux = FluxTelechargementKaggle(
            list(charge.get("repartition") or []),
            envoyer=lambda i, p: self._client.envoyer_ordre_kaggle(
                "kaggle_telecharger_profils", i, id_operation,
                profils=[{"slug": p["slug"], "nom_archive": p["nom_archive"],
                          "nom_local": p.get("nom_local") or p["nom_archive"]}]),
            notifier=lambda i, n, ok, m: self._ecran.sur_resultat_telechargement(id_operation, i, n, ok, m),
            terminer=lambda: self._ecran.terminer_operation(id_operation),
        )
        self._flux.demarrer()

    def _arreter_profil(self, id_executant, nom_local):
        self._ecran.ajouter_journal(f"Arret de l'execution : {self._ecran._sautoniax.get(id_executant, id_executant)} / {nom_local}")
        self._client.arreter_execution_profil(id_executant, nom_local)

    def _envoyer_profil(self, id_executant, profil):
        self._client.envoyer_ordre_kaggle(
            "kaggle_envoyer_profils", id_executant, self._operation or "",
            supprimer_local=self._supprimer_local,
            profils=[{"nom_local": profil["nom_local"], "nom_archive": profil["nom_archive"],
                      "email": profil.get("email", "")}])

    def _flux_actif(self):
        return self._flux if (self._flux is not None and not self._flux.est_termine()) else None

    def _sur_progression(self, id_operation, id_executant, nom_local, etape, pourcentage):
        if id_operation != self._operation:
            return
        if self._type_operation == "telechargement":
            self._ecran.sur_progression_telechargement(id_operation, id_executant, nom_local, etape, pourcentage)
        else:
            self._ecran.sur_progression_envoi(id_operation, id_executant, nom_local, etape, pourcentage)
        if self._flux is not None:
            self._flux.sur_progression(id_executant, nom_local)

    def _sur_resultat(self, id_operation, id_executant, nom_local, ok, message):
        if id_operation == self._operation and self._flux is not None:
            self._flux.sur_resultat(id_executant, nom_local, ok, message)

    def _sur_ack(self, type_ordre, id_executant, id_operation, ok, erreur):
        if not ok and self._flux is not None and id_operation == self._operation:
            self._flux.sur_echec_transmission(type_ordre, id_executant, erreur)

    def _sur_ack_arret(self, ok, id_executant, nom_profil, erreur):
        # ok=True : simple transmission ; le vrai resultat arrive via arreter_..._resultat_reel
        if not ok and self._flux is not None:
            self._flux.sur_arret(id_executant, nom_profil, False, erreur)

    def _sur_arret_reel(self, id_executant, nom_profil, ok, message):
        if self._flux is not None:
            self._flux.sur_arret(id_executant, nom_profil, bool(ok), message)

    def sur_executants_connectes(self, executants: dict):
        if self._flux is not None:
            self._flux.sur_executants_connectes(set(executants))

    def _sur_minuteur(self):
        if self._flux is not None:
            self._flux.verifier_delais()


class ProfilsScreen(QWidget):
    """Onglet "Profils" de ReseauScreen (PATCH -- demande explicite
    utilisateur : "je veux que tu renomme Profils Cloud en Profils tout
    simplement, bon, je veux que il y ait deux onglets : Profils Cloud
    et profils local"). Remplace l'ancien onglet unique "Profils Cloud"
    (auparavant ProfilsCloudScreen directement) par un conteneur à deux
    sous-onglets :
    - "Cloud" : contenu EXACT de l'ancien onglet "Profils Cloud" (cf.
      ProfilsCloudScreen, INCHANGÉE -- tous ses signaux/méthodes publics
      restent identiques, exposés ici via self.cloud_screen pour ne
      rien casser des connexions existantes côté MainWindow).
    - "Local" : nouveau, cf. ProfilsLocalScreen -- liste des profils
      PRÉSENTS SUR CE POSTE, cochables, envoyés vers Profils/ du cloud.

    PATCH (compatibilité ascendante) : ce widget expose lui-même TOUS
    les signaux de ProfilsCloudScreen (redirigés vers self.cloud_screen)
    pour que MainWindow puisse continuer à s'y connecter exactement
    comme avant (aucun changement requis côté câblage, seul le nom de
    l'attribut change : profils_cloud_screen -> profils_screen, cf.
    MainWindow.__init__)."""

    demande_liste_stockage = Signal()
    demande_liste_profils_locaux = Signal()
    demande_envoi_profil = Signal(str)
    demande_telechargement_meta = Signal(str)
    demande_envoi_profil_vers_sautoniax = Signal(str, str)
    demande_liste_sautoniax_disponibles = Signal()
    # PATCH (colonne "Badges" cliquable de Profils Cloud, demande
    # explicite utilisateur : "en cloud ça persiste sur le cloud") --
    # relayé tel quel depuis self.cloud_screen, même patron que les
    # signaux ci-dessus.
    demande_maj_meta_profil = Signal(str, str, bool)
    # PATCH (boutons Renommer/Supprimer par ligne, demande explicite
    # utilisateur) -- relayés tels quels depuis self.cloud_screen, même
    # patron que demande_maj_meta_profil juste au-dessus.
    demande_renommer_profil_cloud = Signal(str, str)
    demande_suppression_profil_cloud = Signal(list)
    # PATCH (bouton "Télécharger en local" de l'onglet "Transfert de
    # profils", demande explicite utilisateur) -- relayé tel quel depuis
    # self.cloud_screen, même patron que demande_envoi_profil_vers_
    # sautoniax juste au-dessus.
    demande_telechargement_local_profil = Signal(str)
    # PATCH (sous-onglet "Profils Kaggle", phase 2) -- relais des signaux de
    # ProfilsKaggleScreen, meme patron que ceux de Cloud/Local.
    demande_kaggle_verifier_connexion = Signal()
    demande_kaggle_actualiser_profils = Signal(list)
    demande_kaggle_actualiser_datasets = Signal()
    demande_kaggle_envoyer = Signal(dict)
    demande_kaggle_telecharger = Signal(dict)

    def __init__(self, parent=None):
        super().__init__(parent)
        layout = QVBoxLayout(self)
        layout.setContentsMargins(0, 0, 0, 0)
        layout.setSpacing(0)

        self.sous_onglets = QTabWidget(self)

        self.cloud_screen = ProfilsCloudScreen(self.sous_onglets)
        self.sous_onglets.addTab(self.cloud_screen, "Profils Cloud")

        self.local_screen = ProfilsLocalScreen(self.sous_onglets)
        self.sous_onglets.addTab(self.local_screen, "Profils Local")

        # PATCH (Profils Kaggle, phase 2) -- troisieme sous-onglet, apres "Profils Local".
        self.kaggle_screen = ProfilsKaggleScreen(self.sous_onglets)
        self.sous_onglets.addTab(self.kaggle_screen, "Profils Kaggle")

        layout.addWidget(self.sous_onglets)

        # --- Relais des signaux du sous-onglet Cloud vers l'extérieur,
        # pour compatibilité ascendante (cf. docstring de classe) ---
        # CORRECTIF (AttributeError au démarrage : 'ProfilsCloudScreen'
        # object has no attribute 'demande_envoi_profil') -- ce signal
        # (ainsi que definir_profils_disponibles/sur_progression_envoi_
        # profil/sur_resultat_envoi_profil plus bas) a été RETIRÉ de
        # ProfilsCloudScreen lors du patch "enlève le bloc Envoyer un
        # profil de cette page" (cf. docstring de ProfilsCloudScreen),
        # mais cette relève ici n'avait pas été mise à jour en
        # conséquence -- oubli corrigé : demande_envoi_profil ne relaie
        # plus désormais que local_screen (cf. juste en dessous, déjà
        # correctement câblé), plus cloud_screen qui ne l'émet plus.
        self.cloud_screen.demande_liste_stockage.connect(self.demande_liste_stockage)
        self.cloud_screen.demande_liste_profils_locaux.connect(self.demande_liste_profils_locaux)
        self.cloud_screen.demande_telechargement_meta.connect(self.demande_telechargement_meta)
        self.cloud_screen.demande_envoi_profil_vers_sautoniax.connect(self.demande_envoi_profil_vers_sautoniax)
        self.cloud_screen.demande_liste_sautoniax_disponibles.connect(self.demande_liste_sautoniax_disponibles)
        self.cloud_screen.demande_maj_meta_profil.connect(self.demande_maj_meta_profil)
        self.cloud_screen.demande_renommer_profil_cloud.connect(self.demande_renommer_profil_cloud)
        self.cloud_screen.demande_suppression_profil_cloud.connect(self.demande_suppression_profil_cloud)
        self.cloud_screen.demande_telechargement_local_profil.connect(self.demande_telechargement_local_profil)

        # --- Le sous-onglet Local a besoin des MÊMES informations que
        # le combo "Envoyer un profil" du sous-onglet Cloud (liste des
        # profils locaux + leur config proxy/pays) -- partage le MÊME
        # signal demande_liste_profils_locaux plutôt que d'en dupliquer
        # un second identique (MainWindow répond aux DEUX écrans à la
        # fois, cf. definir_profils_disponibles ci-dessous). ---
        self.local_screen.demande_liste_profils_locaux.connect(self.demande_liste_profils_locaux)
        self.local_screen.demande_envoi_profil.connect(self.demande_envoi_profil)

        self.kaggle_screen.demande_kaggle_verifier_connexion.connect(self.demande_kaggle_verifier_connexion)
        self.kaggle_screen.demande_kaggle_actualiser_profils.connect(self.demande_kaggle_actualiser_profils)
        self.kaggle_screen.demande_kaggle_actualiser_datasets.connect(self.demande_kaggle_actualiser_datasets)
        self.kaggle_screen.demande_kaggle_envoyer.connect(self.demande_kaggle_envoyer)
        self.kaggle_screen.demande_kaggle_telecharger.connect(self.demande_kaggle_telecharger)

    # --- Méthodes déléguées au sous-onglet Cloud, pour compatibilité
    # ascendante totale (cf. docstring de classe -- MainWindow appelle
    # aujourd'hui reseau_screen.profils_screen.<methode>, demain
    # reseau_screen.profils_screen.<methode> sans autre changement). ---

    def definir_profils_disponibles(self, noms_profils: list):
        # CORRECTIF (AttributeError au démarrage) -- ProfilsCloudScreen
        # ne porte plus definir_profils_disponibles (retiré avec le bloc
        # "Envoyer un profil" de cet écran) : seul local_screen le porte
        # encore désormais.
        self.local_screen.definir_profils_disponibles(noms_profils)

    def noms_profils_cloud(self) -> list:
        return self.cloud_screen.noms_profils_cloud()

    def infos_profils_cloud(self) -> dict:
        return self.cloud_screen.infos_profils_cloud()

    def sur_resultat_liste_stockage(self, ok: bool, objets: list, message: str):
        self.cloud_screen.sur_resultat_liste_stockage(ok, objets, message)

    def sur_meta_profil_recu(self, cle: str, meta: Optional[dict]):
        self.cloud_screen.sur_meta_profil_recu(cle, meta)

    def sur_resultat_maj_meta_profil(self, ok: bool, nom_profil: str, champ: str, valeur: bool, message: str):
        """Nouveau (cf. ProfilsCloudScreen) -- pas de délégation
        préexistante, ce signal n'existait pas avant ce patch."""
        self.cloud_screen.sur_resultat_maj_meta_profil(ok, nom_profil, champ, valeur, message)

    def sur_resultat_renommer_profil_cloud(self, ok: bool, ancien_nom: str, nouveau_nom: str, message: str):
        """PATCH (boutons Renommer/Supprimer) -- même patron de
        délégation directe que sur_resultat_maj_meta_profil juste
        au-dessus."""
        self.cloud_screen.sur_resultat_renommer_profil_cloud(ok, ancien_nom, nouveau_nom, message)

    def sur_resultat_suppression_profil_cloud(self, ok: bool, cles: list, message: str):
        """PATCH (boutons Renommer/Supprimer) -- CONTRAIREMENT à sur_
        resultat_maj_meta_profil/sur_resultat_renommer_profil_cloud
        juste au-dessus, ce n'est PAS une simple délégation directe :
        ce signal est câblé (MainWindow) directement sur ClientServeurT.
        stockage_supprimer_resultat, réutilisé tel quel depuis Stockage
        cloud (cf. docstring de ReseauScreen.demande_suppression_profil_
        cloud) -- qui émet (bool, list[str], str), une liste de clés S3
        ("Profils/<nom>.zip", "Profils/<nom>.meta.json"), PAS un nom de
        profil unique. On retrouve le nom de profil à partir de la
        première clé de la liste avant de déléguer, pour que cloud_
        screen conserve sa signature (ok, nom_profil: str, message)."""
        nom_profil = ""
        if cles:
            nom_profil = cles[0].split("/")[-1]
            if nom_profil.endswith(".zip"):
                nom_profil = nom_profil[: -len(".zip")]
            elif nom_profil.endswith(".meta.json"):
                nom_profil = nom_profil[: -len(".meta.json")]
        self.cloud_screen.sur_resultat_suppression_profil_cloud(ok, nom_profil, message)

    def sur_progression_envoi_profil(self, nom_profil: str, pourcentage: int):
        # CORRECTIF (AttributeError au démarrage) -- ProfilsCloudScreen
        # ne porte plus sur_progression_envoi_profil (retiré avec le
        # bloc "Envoyer un profil" de cet écran, cf. sa docstring) :
        # seul local_screen le porte encore désormais.
        self.local_screen.sur_progression_envoi_profil(nom_profil, pourcentage)

    def sur_resultat_envoi_profil(self, ok: bool, nom_profil: str, message: str):
        # CORRECTIF (idem sur_progression_envoi_profil ci-dessus).
        self.local_screen.sur_resultat_envoi_profil(ok, nom_profil, message)

    def definir_sautoniax_disponibles(self, executants: dict):
        self.cloud_screen.definir_sautoniax_disponibles(executants)
        self.kaggle_screen.definir_sautoniax_disponibles(executants)

    def definir_reglages_kaggle(self, reglages):
        """Profils Kaggle (phase 2) -- fournit ReglagesApp (correspondance de noms persistee)."""
