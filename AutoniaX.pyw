@dataclass
class TaskCellule:
    """Une cellule de code d'un Task, exactement comme une cellule de
    notebook (Jupyter) -- décision explicite utilisateur : "exactement le
    meme mecanisme que un notebok". Chaque cellule porte son propre code
    Python, un titre et une description optionnels rendus en Markdown
    (comme les cellules Markdown d'un vrai notebook, affichées juste
    au-dessus du code pour documenter ce que fait la cellule), et le
    résultat de sa DERNIÈRE exécution (texte de sortie/erreur + statut),
    affiché juste en dessous d'elle dans l'éditeur -- pas de sortie
    séparée globale, chaque cellule garde la sienne comme dans un vrai
    notebook.

    L'exécution réelle (namespace partagé entre cellules d'un même Task,
    injection des ComposantExecutable importés, pont réseau/asyncio) n'est
    pas encore branchée à ce stade -- structure de données prête à la
    recevoir (cf. TaskConfigScreen, à venir)."""
    id: str = field(default_factory=_new_id)
    titre: str = ""  # rendu en Markdown au-dessus du code (## Titre, **gras**, etc.)
    description: str = ""  # rendu en Markdown, contexte optionnel sous le titre
    code: str = ""
    sortie: str = ""  # texte affiché sous la cellule après exécution (stdout/repr/erreur)
    statut: str = "inedit"  # "inedit" | "succes" | "erreur" | "interrompu" -- pour l'indicateur visuel [ ]/✓/✗/■
    # "interrompu" : cellule qui tournait au moment d'un "Tout arrêter" (cf.
    # TaskConfigScreen._arreter_sequence) -- décision explicite utilisateur :
    # état visuel distinct (orange), ni un succès ni une vraie erreur
    # d'exécution, pour ne pas laisser croire que le code a échoué alors
    # qu'il a simplement été coupé avant la fin.
    numero_execution: Optional[int] = None  # cf. compteur In[n]/Out[n] d'un notebook
    # Pertinent UNIQUEMENT pour cellules[0] (cellule statique/insuprimable,
    # cf. TaskCelluleWidget) -- état du bouton "étiquette" togglable, activé
    # par défaut (décision explicite utilisateur : "pardefaut cest bein
    # etiquetter"). Ignoré pour toute autre cellule.
    etiquetee: bool = True
    # Cellule activée/désactivée (décision explicite utilisateur : "chque
    # cellule peu etre desactiver donc une cellule qui quad on desactive
    # on ne peu plus executer, si je lance lexecution globale elle est
    # ignorer") -- basculée par un CLIC DROIT sur le bouton ▶ de la
    # cellule (cf. TaskCelluleWidget.bouton_executer, même pattern que
    # BoutonAjoutCellule.clic_droit). Une cellule désactivée : bouton ▶
    # non cliquable (exécution individuelle bloquée) ET ignorée par "Tout
    # exécuter" (cf. TaskConfigScreen._executer_toutes_cellules). Activée
    # par défaut -- ne change rien au comportement existant tant que
    # l'utilisateur n'a pas explicitement désactivé une cellule.
    active: bool = True
    # Cellule repliée/dépliée (bouton chevron du bandeau gauche, cf.
    # TaskCelluleWidget.bouton_replier) -- masque l'éditeur de code + la
    # zone de sortie tout en gardant le titre/description et le bandeau
    # (▶, index, statut) visibles, pour parcourir rapidement un notebook
    # à beaucoup de cellules sans perdre le fil de ce que fait chacune.
    # Dépliée par défaut -- ne change rien au comportement existant tant
    # que l'utilisateur n'a pas explicitement replié une cellule.
    repliee: bool = False
    # BUGFIX (retour utilisateur : "tu dois aussi stoker les images
    # comme le texte en permanence" -- mode clone, profil non-actif dont
    # la cellule se termine AVANT sélection) -- cf. TaskConfigScreen.
    # _sur_demande_lancer_clone_profil/_callback_termine (mode clone) :
    # une fois la cellule terminée, moteur_courant repasse à None et son
    # _sortie_accumulee (qui porte le texte ET les images intercalées,
    # cf. MoteurExecutionCelluleReseau.sur_image_recue) disparaît avec
    # lui -- seul resultat["sortie"] (texte pur, JAMAIS l'image) était
    # jusqu'ici recopié dans le TaskCellule temporaire de CloneProfilEtat.
    # cellules_resultats. Ce champ porte désormais la DERNIÈRE image
    # connue pour cette exécution (None si aucun .view() n'a été appelé),
    # pour que _definir_profil_actif puisse la réafficher même après la
    # fin de la cellule. Volontairement ABSENT de to_dict/from_dict :
    # jamais persisté sur disque, comme sortie/statut le sont déjà pour
    # les vraies cellules de task.cellules -- mais ces TaskCellule
    # temporaires (cf. leur propre commentaire de construction : "COPIE
    # de TaskCellule -- JAMAIS l'objet réel") ne sont de toute façon
    # jamais sauvegardées par self.project.save(), donc ce champ ne
    # circule qu'en mémoire, le temps de la session.
    derniere_image_b64: Optional[str] = None

    def to_dict(self) -> dict:
        return {
            "id": self.id,
            "titre": self.titre,
            "description": self.description,
            "code": self.code,
            "sortie": self.sortie,
            "statut": self.statut,
            "numero_execution": self.numero_execution,
            "etiquetee": self.etiquetee,
            "active": self.active,
            "repliee": self.repliee,
        }

    @staticmethod
    def from_dict(d: dict) -> "TaskCellule":
        d = dict(d)
        champs_valides = {f.name for f in fields(TaskCellule)}
        d = {k: v for k, v in d.items() if k in champs_valides}
        d.setdefault("id", _new_id())
        return TaskCellule(**d)


