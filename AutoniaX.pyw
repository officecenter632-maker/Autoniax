    def regenerer_profil_bloquant(self, id_executant: str, nom_profil: str, garder_donnees: bool = False,
                                  relancer: bool = True, timeout_s: float = 180.0) -> dict:
        """AJOUT (régénérer le navigateur depuis le notebook) -- version
        BLOQUANTE de demander_regenerer_profil_sautoniax, pour un script/une
        cellule (cf. regenerer_navigateur dans _construire_espace_noms_api2api).
        Envoie la demande puis attend le résultat RÉEL (diffusé) du sAutoniax
        visé pour CE (id_executant, nom_profil), ou l'échec de transmission,
        ou le timeout. Ne doit PAS être appelée depuis le thread Qt principal
        ni depuis la boucle réseau de ce client (elle bloque). Retourne
        {"ok", "message", "instance_id"} ; jamais d'exception."""
        if self._loop is None or not self._loop.is_running() or self._ws is None:
            return {"ok": False, "message": "Non connecté au serveurT.", "instance_id": ""}
        evenement = threading.Event()
        boite: dict = {}

        def _sur_transmission(ok, id_exec, nom, erreur):
            # ok=True : simple accusé de transmission, on attend le résultat réel.
            if ok or evenement.is_set():
                return
            if (id_exec == id_executant and nom == nom_profil) or (not id_exec and not nom):
                boite["resultat"] = {"ok": False, "message": erreur or "Transmission refusée par le serveurT.", "instance_id": ""}
                evenement.set()

        def _sur_resultat(id_exec, nom, ok, message, instance_id):
            if id_exec != id_executant or nom != nom_profil or evenement.is_set():
                return
            boite["resultat"] = {"ok": bool(ok), "message": message or "", "instance_id": instance_id or ""}
            evenement.set()

        self.demander_regenerer_profil_resultat.connect(_sur_transmission, Qt.DirectConnection)
        self.regenerer_profil_sautoniax_resultat_recu.connect(_sur_resultat, Qt.DirectConnection)
        try:
            self.demander_regenerer_profil_sautoniax(id_executant, nom_profil, garder_donnees, relancer)
            if not evenement.wait(timeout=timeout_s):
                return {"ok": False, "message": f"Délai dépassé ({timeout_s:.0f}s) : aucune réponse du sAutoniax « {id_executant} ».", "instance_id": ""}
            return boite["resultat"]
        finally:
            for signal_, slot_ in (
                (self.demander_regenerer_profil_resultat, _sur_transmission),
                (self.regenerer_profil_sautoniax_resultat_recu, _sur_resultat),
            ):
                try:
                    signal_.disconnect(slot_)
                except (RuntimeError, TypeError):
                    pass

