        if proxy and proxy.get("host"):
            port = proxy.get("port") or (1080 if proxy.get("protocole") == "socks5" else 8080)
            self._label_profil_proxy.setText(f"Proxy : {proxy['host']}:{port}")
            self._label_profil_pays.setText(f"Pays : {pays or 'None'}")
        else:
            self._label_profil_proxy.setText("Proxy : None")
            self._label_profil_pays.setText("Pays : None")

    def ajouter_ligne_terminal(self, ligne: str):
        """Ajoute une ligne au terminal de sortie et scrolle automatiquement
        vers le bas -- appelée à CHAQUE ligne de sortie reçue d'une cellule
        en cours d'exécution (cf. TaskConfigScreen.sur_log_execution_
        reseau_recu), au fil de l'eau, même comportement "en direct" que
        l'affichage dans l'éditeur de notebook lui-même.

        PATCH -- append() (QTextEdit) remplace appendPlainText() (ancien
        QPlainTextEdit) : `ligne` est du texte de log brut, potentiellement
        avec des caractères type '<', '&' -- html.escape() (déjà utilisé
        ailleurs dans ce fichier pour le même besoin) évite qu'un log
        contenant par exemple "<div>" ou "a && b" soit interprété comme du
        HTML par erreur (QTextEdit.append() traite son argument comme du
        rich text, contrairement à QPlainTextEdit.appendPlainText() qui
        traitait tout comme texte brut sans distinction)."""
        self.terminal_sortie.append(html.escape(ligne))
        barre_verticale = self.terminal_sortie.verticalScrollBar()
        barre_verticale.setValue(barre_verticale.maximum())

    def ajouter_image_terminal(self, image_b64: str):
        """AJOUT (demande explicite utilisateur : "je veux que le terminal
        affiche aussi les images ... laffichage de limage dans le terminal")
        -- insère l'image DANS le flux du terminal, au même endroit que les
        lignes de texte (pas une fenêtre séparée), à l'endroit exact où
        elle arrive chronologiquement -- même esprit "au fil de l'eau" que
        ajouter_ligne_terminal ci-dessus. Décode `image_b64` (PNG, cf.
        bgr_vers_image_b64 côté script Task/Image.view()) en QImage, puis
        insère via QTextCursor.insertImage -- le mécanisme natif Qt pour
        du contenu rich text dans un QTextEdit, ce que QPlainTextEdit ne
        permettait pas (d'où le remplacement du widget, cf. commentaire de
        construction ci-dessus). Rate silencieusement (log seulement) si
        le décodage échoue plutôt que de planter l'affichage du terminal
        pour une image corrompue -- une image invalide ne doit jamais faire
        perdre le reste du flux de logs déjà affiché."""
        try:
            donnees = base64.b64decode(image_b64)
            image_qt = QImage()
            if not image_qt.loadFromData(donnees):
                raise ValueError("QImage.loadFromData a échoué (données non reconnues comme image)")
        except Exception as e:
            log.warning(f"[terminal réseau] image reçue invalide, ignorée : {e!r}")
            return
        # Redimensionne si plus large que le terminal -- une capture de
        # zone/composant peut dépasser la largeur du panneau (colonne
        # fixe, cf. LARGEUR_PANNEAU_REGLAGES), et QTextEdit n'ajoute pas
        # de scroll horizontal pour une image insérée trop large : sans
        # ça, l'image serait tronquée visuellement plutôt que redimensionnée.
        largeur_max = max(100, self.terminal_sortie.viewport().width() - 20)
        if image_qt.width() > largeur_max:
            image_qt = image_qt.scaledToWidth(largeur_max, Qt.SmoothTransformation)
        curseur = self.terminal_sortie.textCursor()
        curseur.movePosition(QTextCursor.End)
        curseur.insertImage(image_qt)
        curseur.insertBlock()  # retour à la ligne après l'image, pour que la ligne de log suivante ne s'accole pas dedans
        barre_verticale = self.terminal_sortie.verticalScrollBar()
        barre_verticale.setValue(barre_verticale.maximum())

    def definir_texte_terminal(self, texte: str):
        """Remplace intégralement le contenu du terminal -- utilisée pour
        réafficher la sortie déjà accumulée d'une cellule (cf. cellule.
        sortie) quand on change d'exécutant/de Task, plutôt que d'ajouter
        ligne par ligne (cf. ajouter_ligne_terminal).

        PATCH -- setPlainText() reste utilisable tel quel sur QTextEdit
        (elle existe nativement, contrairement à un simple renommage) :
        cellule.sortie est TOUJOURS du texte pur (cf. docstring de
        sur_image_execution_reseau_recu -- les images n'y sont jamais
        écrites), donc aucune image n'est perdue en réhydratant ainsi ;
        seul un éventuel réaffichage d'image resterait absent après un
        changement de Task, limite déjà assumée et documentée ailleurs."""
        self.terminal_sortie.setPlainText(texte)
        barre_verticale = self.terminal_sortie.verticalScrollBar()
        barre_verticale.setValue(barre_verticale.maximum())

    def effacer_terminal(self):
        self.terminal_sortie.clear()

    def copier_terminal(self):
        """Copie l'intégralité de la sortie du terminal dans le
        presse-papier système -- PATCH, demande explicite utilisateur.
        Ne fait rien si le terminal est vide (rien d'utile à copier,
        évite d'écraser silencieusement un presse-papier déjà utile)."""
        texte = self.terminal_sortie.toPlainText()
        if texte:
            QApplication.clipboard().setText(texte)

    def definir_reglage_capture_initial(self, resolution: str, qualite: int):
        """Restaure un réglage déjà connu (cf. ReglagesApp.preference_
        capture_resolution côté FenetreRenduTaskReseau/TaskConfigScreen)
        SANS redéclencher demande_preference_capture (blockSignals) --
        même patron que InstancesConnecteesScreen.definir_reglage_
        capture_initial (ancien emplacement, cf. docstring de bande_
        reglages_capture pour pourquoi ce réglage vit maintenant ici
        plutôt que là-bas).

        CHANGEMENT (demande explicite utilisateur -- combo Résolution
        remplacé par un combo Qualité, cf. docstring de bande_reglages_
        capture) : `resolution` reste dans la signature pour ne pas
        casser les appelants existants (ReglagesApp persiste encore les
        deux valeurs), mais n'est plus utilisé ici -- c'est `qualite`
        (10/50/100) qui pilote maintenant combo_qualite_capture."""
        index_qualite = next(
            (i for i, (_l, v) in enumerate(self.QUALITES_CAPTURE_AFFICHEES) if v == qualite), 0
        )
        self.combo_qualite_capture.blockSignals(True)
        self.combo_qualite_capture.setCurrentIndex(index_qualite)
        self.combo_qualite_capture.blockSignals(False)

    # CHANGEMENT (demande explicite utilisateur : "cest au serveur que
    # sa doit compresser ... je veux que dans les parametre de rendue tu
    # mets le parametre de compressioon : 100, 50, 10, webp biensure")
    # -- ancienne RESOLUTION_CAPTURE_FIXE/QUALITE_CAPTURE_FIXE (qualité
    # figée à 100, seule la résolution variait) INVERSÉ : la résolution
    # est maintenant TOUJOURS "full" (plus de redimensionnement possible,
    # cf. serveur.py _recompresser_pour_diffusion), c'est la qualité de
    # compression WebP qui varie depuis ce panneau.
    RESOLUTION_CAPTURE_FIXE = "full"

    def _sur_reglage_capture_change(self, _index: int):
        _libelle_qualite, valeur_qualite = self.QUALITES_CAPTURE_AFFICHEES[self.combo_qualite_capture.currentIndex()]
        self.demande_preference_capture.emit(self.RESOLUTION_CAPTURE_FIXE, valeur_qualite)

    def definir_profil_actif(self, libelle: Optional[str]):
        """Met à jour profil_label (cf. son docstring) -- libelle=None ou
        chaîne vide affiche un état neutre ("aucun") plutôt que de
        laisser un texte périmé affiché après déconnexion/désélection.
        Appelée par InstanceApercuScreen._on_instance_changed (cas local
        ET réseau) à chaque changement de cible."""
        texte = libelle.strip() if libelle else ""
        self.profil_label.setText(f"Profil actif : {texte}" if texte else "Profil actif : aucun")


class InstanceApercuScreen(QWidget):
    """Classe de base pour tout écran connecté à UNE instance nodriver via
    le serveur central, avec aperçu (frames) et contrôle du rythme de
    rafraîchissement. Factorise ce que TestComposantScreen et
    CoordonneeActionScreen dupliquaient à l'identique : connexion réseau
    indépendante, sélecteur d'instance + liaison (link), réception des
    frames, et maintenant les 3 modes de rafraîchissement ci-dessous.

    Pensée pour être héritée par d'autres écrans à l'avenir (d'où le nom
    générique) -- chaque sous-classe ajoute ses propres widgets/paramètres
    SOUS ceux définis ici (cf. widget_reglages_specifiques, à peupler par
    la sous-classe dans son __init__ après super().__init__()), sans avoir
    à ré-implémenter la connexion réseau ni la logique de rafraîchissement.

    Rafraîchissement -- 3 réglages distincts, tous pilotés depuis CET écran
    (jamais un flux continu imposé par défaut, contrairement à l'ancienne
    implémentation qui alignait le FPS de streaming sur un intervalle dès
    la sélection d'instance) :
      - "Rafraîchir" (bouton) : capture PONCTUELLE, une seule image. Le
        protocole serveur/instance n'a pas de commande "capture unique"
        (cf. instance_nodriver.py, set_fps/set_streaming uniquement) --
        simulée ici par une activation du streaming, l'attente de la
        PROCHAINE frame, puis une désactivation immédiate (cf.
        _demander_rafraichissement/_sur_frame_recue).
      - Taux de rafraîchissement automatique (spinbox, en FPS) : si activé
        (case "Rafraîchissement automatique"), le streaming reste actif en
        continu à ce FPS -- le bouton "Rafraîchir" reste utilisable mais
        n'a plus grand intérêt puisque le flux tourne déjà.
      - Désactiver : coupe le streaming continu (set_streaming actif=False)
        -- état par défaut à l'ouverture de l'écran, pour ne jamais imposer
        un flux continu sans que l'utilisateur l'ait demandé.

    derniere_frame_disponible(image) : hook appelé par la sous-classe à
    chaque frame utile (après link, avant tout traitement spécifique) --
    voir _sur_frame_recue, qui appelle self._sur_nouvelle_frame(image) que
    les sous-classes redéfinissent (défaut : affichage brut via
    _afficher_apercu_defaut)."""

    def __init__(self, id_pilote_prefixe: str, titre_apercu: str = "APERÇU DE L'INSTANCE CIBLE", parent=None):
        super().__init__(parent)
        self._instance_liee: Optional[str] = None
        self._derniere_taille_frame: tuple[int, int] = (1280, 800)  # repli tant qu'aucune frame reçue
        self._derniere_image: Optional[QImage] = None
        self._rafraichissement_auto_actif = False  # état par défaut : PAS de flux continu (cf. docstring)
        self._rafraichissement_ponctuel_en_attente = False  # une capture "Rafraîchir" est en cours
        self._requete_id_liste_onglets: Optional[str] = None  # cf. bloc Onglet navigateur (listTabs/switchTab)
        self._requete_id_switch_onglet: Optional[str] = None
        # cf. bloc "Capture propre" (détection OpenCV, sans le curseur
        # virtuel) -- dict plutôt qu'un requete_id unique : par robustesse
        # si jamais plusieurs demandes se chevauchaient (ne devrait pas
        # arriver en usage normal, un seul test à la fois par écran), même
        # esprit que SequenceurActionReseau._callbacks_en_attente.
        self._callbacks_capture_propre_en_attente: dict[str, callable] = {}

        # PATCH (support cible RÉSEAU dans _envoyer_commande_liee, cf. sa
        # docstring plus bas) -- self._client_serveur_t reste None tant
        # qu'aucune sous-classe n'appelle definir_client_serveur_t (cf.
        # cette méthode) : _envoyer_commande_liee retombe alors TOUJOURS
        # sur le protocole local, comportement STRICTEMENT INCHANGÉ pour
        # toute sous-classe qui n'a pas connaissance du réseau sAutoniax
        # (CoordonneeActionScreen à ce jour). self._id_executant_reseau,
        # lui, distingue "quelle CIBLE" (local self._instance_liee, ou
        # réseau self._id_executant_reseau) parmi les instances/exécutants
        # actuellement CONNUS DE CET ÉCRAN -- les deux restent mutuellement
        # exclusifs (cf. TestComposantScreen._sur_cible_changee : choisir
        # dans un groupe vide TOUJOURS l'autre, jamais les deux à la fois).
        self._client_serveur_t: Optional["ClientServeurT"] = None
        self._id_executant_reseau: Optional[str] = None
        # PATCH (correctif "ques ce qui vas se passee si il ya plusier
        # profils sur une instance") -- self._id_executant_reseau (ci-
        # dessus) désigne QUEL sAutoniax est ciblé (ex. "sAutoniax-1"),
        # mais un sAutoniax peut faire tourner PLUSIEURS profils en
        # parallèle, chacun avec son PROPRE instance_id réel (ex.
        # "sautoniax-isole-camoufox4-8e17f358") -- distinct du nom du
        # sAutoniax lui-même. self._instance_id_reseau porte ce second
        # identifiant, utilisé pour le paramètre instance_id des appels
        # ClientServeurT (envoyer_commande_instance/demander_capture_
        # ponctuelle_instance), tandis que _id_executant_reseau reste
        # utilisé pour ROUTER vers le bon sAutoniax. Repli sur _id_
        # executant_reseau si jamais None alors qu'un sAutoniax est
        # ciblé (cf. _instance_id_reseau_effectif ci-dessous) : ancien
        # comportement mono-profil, pour toute sous-classe/tout appelant
        # qui ne connaît pas encore cette distinction (CoordonneeActionScreen
        # à ce jour, jamais mise à jour vers un choix de PROFIL précis).
        self._instance_id_reseau: Optional[str] = None

        # --- Connexion réseau INDÉPENDANTE, propre à cet écran -- id_client
        # unique via uuid, jamais une constante partagée entre onglets (cf.
        # docstring de ClientReseauAutoniaX : pas de déduplication de
        # pilote_id côté serveur.py) ---
        self._id_pilote = f"{id_pilote_prefixe}-{uuid.uuid4().hex[:10]}"
        self.client_reseau: Optional[ClientReseauAutoniaX] = None
        if RESEAU_DASHBOARD_DISPONIBLE:
            self.client_reseau = ClientReseauAutoniaX(SERVER_URL_DASHBOARD, role="pilote", id_client=self._id_pilote)

        self._root_layout = QVBoxLayout(self)
        self._root_layout.setContentsMargins(0, 0, 0, 0)
        self._root_layout.setSpacing(0)

        # --- Barre "Retour" (masquée tant qu'aucune origine n'est fixée
        # par ApplicationsScreen — cf. definir_onglet_origine) ---
        self.retour_bar = QWidget(self)
        retour_layout = QHBoxLayout(self.retour_bar)
        retour_layout.setContentsMargins(16, 12, 16, 0)
        self.retour_button = QPushButton(
            qta.icon("mdi6.arrow-left", color=Mocha.text), " Retour", self.retour_bar
        )
        self.retour_button.setObjectName("RetourButton")
        self.retour_button.setCursor(Qt.PointingHandCursor)
        retour_layout.addWidget(self.retour_button)
        retour_layout.addStretch(1)
        self._root_layout.addWidget(self.retour_bar)
        self.retour_bar.setVisible(False)

        # PATCH (demande explicite utilisateur : "je veux que le panneau
        # d'outils doit etre pliable, donc affiche au dessus ... le
        # paneau de control qui est a droit doit etre aussi pliable,
        # donc affihcer audessus") -- une seule bande fine, TOUJOURS
        # visible, posée juste au-dessus de la zone de contenu
        # (_contenu, qui contient elle-même colonne gauche + panneau de
        # rendu) : deux boutons toggle, un par panneau repliable. Décochés
        # par défaut (les deux panneaux visibles à l'ouverture, aucune
        # régression pour qui n'utilise jamais ce repli) -- l'utilisateur
        # les replie lui-même au besoin pour maximiser l'aperçu.
        self._bande_pliage = QWidget(self)
        self._construire_bande_pliage(self._bande_pliage)
        self._root_layout.addWidget(self._bande_pliage)

        self._contenu = QWidget(self)
        self._root_layout.addWidget(self._contenu, 1)

        self._main_layout = QHBoxLayout(self._contenu)
        self._main_layout.setContentsMargins(24, 24, 24, 24)
        # FIX (demande utilisateur, cf. capture : "je veux que les paramètres
        # par défaut du screen s'affichent directement à côté du screen dans
        # cette zone") -- spacing à 0 : le panneau de réglages doit être
        # directement collé à l'aperçu, sans bande vide entre les deux.
        self._main_layout.setSpacing(0)

        # --- Colonne gauche : scroll, réglages -- la sous-classe ajoute ses
        # propres widgets dans self.layout_reglages (au-dessus ou en dessous
        # du bloc instance/rafraîchissement ci-dessous, à sa convenance).
        #
        # FIX (demande utilisateur, cf. capture : "le screen de
        # visualisation doit prendre environ la moitié de l'écran,
        # légèrement moins de la moitié") -- ANNULE un correctif précédent
        # qui donnait TOUT le stretch à cette colonne (stretch=1 ici,
        # stretch=0 sur le panneau de rendu, cf. plus bas) : le panneau de
        # rendu ne recevait alors jamais plus que sa taille minimale,
        # écrasé contre le bord droit quel que soit l'agrandissement de la
        # fenêtre (cf. capture utilisateur -- rendu ~1/4 de la largeur,
        # colonne gauche ~3/4). Stretch abaissé à 9 ici contre 11 sur le
        # panneau de rendu (cf. _main_layout.addWidget(self._panneau_rendu,
        # 11) plus bas) : proportion ~45/55, légèrement MOINS de la moitié
        # pour la colonne de réglages, comme demandé. ---
        # CORRECTIF (demande explicite utilisateur : "TEST DE COMPOsant
        # doit reduit en widht, cest trop grand inutlsement ... tu dois
        # reduire sont width actuel de diviser par 2 ... lapercus vas
        # occuper la cquasi toaliter de lecran") -- 340 -> 170, ET
        # stretch abaissé en conséquence (1 au lieu de 9) : à largeur
        # FIXE désormais restreinte, un gros stretch ne servait plus à
        # rien d'autre qu'à revendiquer un espace que le contenu
        # n'utilise pas -- cf. _main_layout.addWidget(self._panneau_
        # rendu, 30) plus bas, largement dominant. cf. definir_panneau_
        # reglages_replie pour le mécanisme de repli complet (bouton
        # au-dessus, cf. _construire_bande_pliage).
        self._scroll = QScrollArea(self._contenu)
        self._scroll.setWidgetResizable(True)
        self._scroll.setFrameShape(QFrame.NoFrame)
        self._scroll.setHorizontalScrollBarPolicy(Qt.ScrollBarAlwaysOff)
        self._scroll.setVerticalScrollBarPolicy(Qt.ScrollBarAlwaysOff)
        LARGEUR_PANNEAU = 170
        self._largeur_panneau_outils = LARGEUR_PANNEAU  # cf. _sur_bascule_panneau_outils
        self._scroll.setMinimumWidth(LARGEUR_PANNEAU)
        self._scroll.setSizePolicy(QSizePolicy.Expanding, QSizePolicy.Expanding)
        self._colonne_gauche = QWidget(self._scroll)
        self._colonne_gauche.setMinimumWidth(LARGEUR_PANNEAU)
        self._scroll.setWidget(self._colonne_gauche)
        self.layout_reglages = QVBoxLayout(self._colonne_gauche)
        self.layout_reglages.setContentsMargins(12, 0, 12, 0)
        self.layout_reglages.setSpacing(12)
        self._main_layout.addWidget(self._scroll, 1)

        # --- Bloc "Instance cible" (sélecteur + statut réseau) ---
        self.layout_reglages.addWidget(self._section_label("INSTANCE CIBLE"))
        ligne_instance = QHBoxLayout()
        self.instance_combo = ComboBoxAvecFermeturePopup(self._colonne_gauche)
        self.instance_combo.setObjectName("ReglagesCombo")
        self.instance_combo.currentIndexChanged.connect(self._on_instance_changed)
        ligne_instance.addWidget(self.instance_combo, 1)
        self.rafraichir_liste_button = QToolButton(self._colonne_gauche)
        self.rafraichir_liste_button.setIcon(qta.icon("mdi6.refresh", color=Mocha.text))
        self.rafraichir_liste_button.setCursor(Qt.PointingHandCursor)
        self.rafraichir_liste_button.setToolTip("Redemander la liste des instances au serveur")
        self.rafraichir_liste_button.clicked.connect(self._demander_liste_instances)
        ligne_instance.addWidget(self.rafraichir_liste_button)

        # BUGFIX (retour utilisateur : "jai toujour des problem de liason
        # de conexions... il faut mettre un bouton de deconnection claire
        # pour claire claire") -- bouton explicite, séparé du combo, pour
        # quitter l'instance actuellement liée SANS ambiguïté : repasse le
        # combo sur l'item "(aucune sélection)", ce qui déclenche
        # _on_instance_changed(None) normalement (même chemin que si
        # l'utilisateur choisissait cet item lui-même) -- donc l'unlink
        # explicite ajouté dans _on_instance_changed s'applique ici aussi,
        # sans dupliquer cette logique. Désactivé quand rien n'est lié
        # (rien à déconnecter), cf. _rafraichir_etat_bouton_deconnexion.
        self.deconnecter_button = QToolButton(self._colonne_gauche)
        self.deconnecter_button.setIcon(qta.icon("mdi6.link-off", color=Mocha.red))
        self.deconnecter_button.setCursor(Qt.PointingHandCursor)
        self.deconnecter_button.setToolTip("Déconnecter l'instance actuellement liée")
        self.deconnecter_button.setEnabled(False)
        self.deconnecter_button.clicked.connect(self._deconnecter_instance)
        ligne_instance.addWidget(self.deconnecter_button)
        self.layout_reglages.addLayout(ligne_instance)

        self.label_statut_reseau = QLabel("Connexion au serveur…", self._colonne_gauche)
        self.label_statut_reseau.setWordWrap(True)
        self.label_statut_reseau.setStyleSheet(f"color: {Mocha.subtext0}; font-size: 11px;")
        self.layout_reglages.addWidget(self.label_statut_reseau)

        # --- Onglet navigateur (listTabs/switchTab) -- DÉPLACÉ dans
        # PanneauRenduInstance (bande du bas, sous Rafraîchir/Mode/Taux),
        # cf. sa docstring : un paramètre du RENDU doit vivre dans le
        # panneau de rendu partagé, pas ici, sinon DashboardScreen (qui
        # compose son PROPRE PanneauRenduInstance sans hériter de cette
        # classe) ne le reçoit jamais. self.onglet_combo etc. sont
        # aliasés depuis self._panneau_rendu juste plus bas, même
        # pattern que rafraichir_button/case_auto/fps_auto_spin.

        # --- Panneau de RENDU (colonne droite) -- widget autonome avec son
        # propre layout (cf. PanneauRenduInstance), qui regroupe titre,
        # contrôles de rafraîchissement (bouton/case/taux/statut), et
        # l'image elle-même. DÉPLACÉ ici depuis layout_reglages (demande
        # explicite : le rafraîchissement est une propriété du RENDU, pas
        # un réglage propre au composant/action testé -- il doit vivre
        # dans le panneau de visualisation lui-même, pas dans la colonne
        # de gauche à côté). ---
        self._panneau_rendu = PanneauRenduInstance(
            titre_apercu, self._contenu, largeur_colonne_reglages=130,
        )
        self.rafraichir_button = self._panneau_rendu.rafraichir_button
        self.rafraichir_button.clicked.connect(self._demander_rafraichissement)
        self.case_auto = self._panneau_rendu.case_auto
        self.case_auto.toggled.connect(self._on_case_auto_toggled)
        self.fps_auto_spin = self._panneau_rendu.fps_auto_spin
        self.fps_auto_spin.valueChanged.connect(self._on_fps_auto_change)
        self.label_statut_rafraichissement = self._panneau_rendu.label_statut_rafraichissement
        self.onglet_combo = self._panneau_rendu.onglet_combo
        self.onglet_combo.currentIndexChanged.connect(self._on_onglet_navigateur_change)
        self.onglet_combo.popup_ouvert.connect(self._demander_liste_onglets_navigateur)
        self.rafraichir_onglets_button = self._panneau_rendu.rafraichir_onglets_button
        self.rafraichir_onglets_button.clicked.connect(self._demander_liste_onglets_navigateur)
        self.label_statut_onglets = self._panneau_rendu.label_statut_onglets
        # FIX (retour utilisateur : "lorsque on clique déjà sur ce bouton
        # pour le drag, l'interface doit se réduire automatiquement pour
        # qu'on puisse glisser vers où l'on veut") -- ApercuDragHandle
        # émet déjà drag_demarre/drag_termine (cf. sa docstring, utilisés
        # jusqu'ici uniquement par FenetreRenduTaskReseau, qui MASQUE sa
        # fenêtre comme Échap). Ici, InstanceApercuScreen est un ONGLET
        # DANS la fenêtre principale AutoniaX (pas une fenêtre séparée).
        #
        # CORRECTIF (retour explicite utilisateur : "sa ne fonctionne
        # toujours pas ... surtout quand l'interface se réduit, je sais
        # pas, ça fait quelque chose") -- la première tentative appelait
        # showMinimized() sur la fenêtre top-level PENDANT le drag.exec()
        # bloquant (cf. ApercuDragHandle.mouseMoveEvent, drag_demarre émis
        # juste AVANT drag.exec()) : sous Windows en particulier, minimiser
        # la fenêtre SOURCE pendant qu'un QDrag natif est en cours casse le
        # grab souris du drag lui-même (le drop n'arrive plus jamais à
        # destination). C'est exactement la même erreur que celle déjà
        # rencontrée et corrigée sur FenetreRenduTaskReseau (cf. son
        # docstring _sur_drag_capture_demarre : "après une première
        # tentative 'réduire' qui visait à tort showMinimized()") -- son
        # correctif utilise hide() (équivalent Échap) plutôt que
        # showMinimized(), ce qui ne perturbe pas le drag natif puisque la
        # fenêtre n'est alors plus une fenêtre "réduite" mais simplement
        # non affichée à l'écran (le grab souris survit à un hide(),
        # contrairement à un showMinimized()).
        #
        # SIMPLIFICATION (cf. docstring de classe ApercuDragHandle) : ce
        # bouton fonctionne désormais par simple clic (copie presse-papier),
        # plus par QDrag -- plus de signaux drag_demarre/drag_termine à
        # connecter, donc plus besoin de masquer/restaurer la fenêtre.
        self.bouton_drag_capture = self._panneau_rendu.bouton_drag_capture

        # AJOUT -- MÊME PATTERN d'alias que bouton_drag_capture ci-dessus :
        # profil_label et layout_ligne_profil vivent RÉELLEMENT dans
        # PanneauRenduInstance (cf. son __init__, "Label 'profil actif'"),
        # pas ici -- sans cet alias, une sous-classe de InstanceApercuScreen
        # (TestComposantScreen notamment, cf. sa docstring sur la
        # navigation ‹ › entre images de test, capture_001.png) qui
        # accède à self.layout_ligne_profil planterait avec un
        # AttributeError, exactement comme bouton_drag_capture en aurait
        # besoin s'il n'était pas déjà aliasé. profil_label lui-même
        # n'était PAS encore exposé du tout sur self avant cet ajout
        # (aucun appelant existant n'en avait besoin jusqu'ici) -- ajouté
        # par cohérence, au cas où un futur appelant en ait besoin comme
        # bouton_drag_capture aujourd'hui.
        self.profil_label = self._panneau_rendu.profil_label
        self.layout_ligne_profil = self._panneau_rendu.layout_ligne_profil

        # --- Alias conservés pour compatibilité -- CoordonneeActionScreen
        # (cf. son __init__) manipule apercu_label et _droite_layout
        # directement (indexOf/removeWidget/insertWidget) pour substituer
        # ApercuTraceableLabel à la place du label par défaut, EN PLACE,
        # sans connaître PanneauRenduInstance. Ces alias pointent vers les
        # attributs réels du panneau, pas des copies -- toute réassignation
        # de self.apercu_label par une sous-classe doit AUSSI mettre à jour
        # self._panneau_rendu.apercu_label (voir CoordonneeActionScreen). ---
        self._colonne_droite = self._panneau_rendu.colonne_image
        self._droite_layout = self._panneau_rendu.droite_layout
        self.apercu_label = self._panneau_rendu.apercu_label
        self.apercu_label.redimensionne.connect(self._sur_redimensionnement_apercu)
        self._main_layout.addWidget(self._panneau_rendu, 30)

        self._rafraichir_statut_rafraichissement()

    def _instance_id_reseau_effectif(self) -> Optional[str]:
        """Retourne l'instance_id réel à utiliser pour les appels réseau
        (envoyer_commande_instance/demander_capture_ponctuelle_instance) :
        self._instance_id_reseau s'il est renseigné (cas normal pour
        TestComposantScreen depuis le correctif "plusieurs profils sur une
        instance", cf. son docstring), sinon repli sur self._id_executant_
        reseau (ancien comportement mono-profil -- id_executant réutilisé
        comme instance_id, cf. CoordonneeActionScreen ou tout usage
        antérieur à ce correctif qui ne fixe jamais explicitement
        self._instance_id_reseau). None si aucune cible réseau active."""
        if self._id_executant_reseau is None:
            return None
        return self._instance_id_reseau or self._id_executant_reseau

    def _construire_bande_pliage(self, conteneur: QWidget):
        """PATCH (demande explicite utilisateur, cf. commentaire dans
        __init__ juste avant l'appel) -- une bande fine, horizontale,
        TOUJOURS visible juste au-dessus de la zone de contenu (jamais
        repliée elle-même : sans ça, un panneau replié n'aurait plus
        aucun moyen d'être redéplié). Deux boutons toggle indépendants :
        - "Outils" pilote self._scroll (colonne gauche, réglages propres
          à la sous-classe -- "TEST DE COMPOSANT" pour TestComposantScreen).
        - "Contrôles" pilote self._panneau_rendu.colonne_reglages (colonne
          de droite, Rafraîchir/Mode/Taux/Onglet -- cf. PanneauRenduInstance
          .definir_colonne_reglages_repliee).
        Décochés par défaut : les deux panneaux restent visibles tant que
        l'utilisateur n'a pas explicitement demandé le repli, aucune
        régression pour l'existant."""
        layout = QHBoxLayout(conteneur)
        layout.setContentsMargins(24, 12, 24, 0)
        layout.setSpacing(8)

        self.bouton_repli_outils = QPushButton(
            qta.icon("mdi6.tune-variant", color=Mocha.text), " Outils", conteneur
        )
        self.bouton_repli_outils.setObjectName("BoutonRepliPanneau")
        self.bouton_repli_outils.setCursor(Qt.PointingHandCursor)
        self.bouton_repli_outils.setCheckable(True)
        self.bouton_repli_outils.setChecked(True)  # coché = visible, état par défaut
        self.bouton_repli_outils.setToolTip("Afficher/masquer le panneau d'outils (colonne de gauche)")
        self.bouton_repli_outils.toggled.connect(self._sur_bascule_panneau_outils)
        layout.addWidget(self.bouton_repli_outils)

        layout.addStretch(1)

        self.bouton_repli_controles = QPushButton(
            qta.icon("mdi6.cog-outline", color=Mocha.text), " Contrôles", conteneur
        )
        self.bouton_repli_controles.setObjectName("BoutonRepliPanneau")
        self.bouton_repli_controles.setCursor(Qt.PointingHandCursor)
        self.bouton_repli_controles.setCheckable(True)
        self.bouton_repli_controles.setChecked(True)  # coché = visible, état par défaut
        self.bouton_repli_controles.setToolTip("Afficher/masquer le panneau de contrôles (colonne de droite)")
        self.bouton_repli_controles.toggled.connect(self._sur_bascule_panneau_controles)
        layout.addWidget(self.bouton_repli_controles)

    def _sur_bascule_panneau_outils(self, visible: bool):
        """Coché (défaut) = colonne gauche visible à sa largeur normale.
        Décoché = repliée (largeur minimale 0, cf. self._largeur_panneau_
        outils fixé dans __init__ -- même principe que definir_colonne_
        reglages_repliee côté PanneauRenduInstance : la largeur MINIMALE
        est ramenée à 0 plutôt que setVisible(False) seul, pour que
        _main_layout libère immédiatement la place au profit du panneau
        de rendu à côté). setMinimumWidth (pas setFixedWidth) : cohérent
        avec le SizePolicy.Expanding déjà posé sur self._scroll dans
        __init__ -- une largeur MINIMALE laisse Qt libre de grandir au
        besoin (jamais le cas ici en pratique, le panneau de rendu prend
        tout le stretch, mais reste le contrat le plus proche du réglage
        d'origine)."""
        self._scroll.setMinimumWidth(self._largeur_panneau_outils if visible else 0)
        self._scroll.setMaximumWidth(16777215 if visible else 0)
        self._scroll.setVisible(visible)

    def _sur_bascule_panneau_controles(self, visible: bool):
        self._panneau_rendu.definir_colonne_reglages_repliee(not visible)

    def _sur_redimensionnement_apercu(self):
        """CHANGEMENT (échelle réelle 1:1, cf. PanneauRenduInstance.
        apercu_scroll) : ancien comportement (historique ci-dessous)
        inversé -- l'aperçu n'est plus recalculé/remis à l'échelle au
        redimensionnement du panneau, il garde sa taille réelle en
        pixels, et apercu_scroll (QScrollArea) fait seul apparaître les
        barres de défilement nécessaires. Méthode conservée (vidée) pour
        ne pas casser la connexion existante sur apercu_label.
        redimensionne, et pour que les sous-classes qui la redéfinissent
        encore (overlay curseur/détection) continuent de fonctionner.

        ANCIEN COMPORTEMENT (avant ce changement) : recalculait le pixmap
        à la taille ACTUELLE du label à partir de la dernière QImage
        reçue (self._derniere_image), pour que l'aperçu suive
        l'agrandissement de la zone en conservant son ratio."""
        pass

    # ------------------------------------------------------------------
    # Aides de construction (utilisables par les sous-classes)
    # ------------------------------------------------------------------
    def _section_label(self, texte: str, parent_widget: Optional[QWidget] = None) -> QLabel:
        # FIX (débordement visuel, cf. capture utilisateur : "il ya un
        # probleme dans cette zone, il faut legerement decaler vers la
        # gauche l'interface de l'onglet, il est legerement cacher par le
        # panneau replié") -- sans setWordWrap, un texte de section plus
        # long que LARGEUR_PANNEAU (170px, cf. __init__) ne s'enroule
        # jamais sur une 2e ligne et déborde hors de la colonne (donc hors
        # de la QScrollArea qui la contient), chevauchant visuellement ce
        # qui est affiché à gauche -- ici, PanneauOutilsEscamotable replié.
        # Le wrap ne réduit pas LARGEUR_PANNEAU elle-même (toujours 170,
        # demande explicite précédente), il fait juste tenir le texte
        # DANS cette largeur plutôt que de la dépasser silencieusement.
        label = QLabel(texte, parent_widget or self._colonne_gauche)
        label.setObjectName("ReglagesLabel")
        label.setWordWrap(True)
        return label

    def definir_onglet_origine(self, cle_ecran: Optional[str]):
        self.onglet_origine = cle_ecran
        self.retour_bar.setVisible(cle_ecran is not None)

    # ------------------------------------------------------------------
    # Réseau
    # ------------------------------------------------------------------
    def demarrer_reseau(self):
        """À appeler par la sous-classe à la fin de son __init__ (une fois
        tous ses propres signaux connectés), pas automatiquement ici --
        certaines sous-classes ont besoin de finir leur propre mise en
        place avant de recevoir la première frame."""
        if self.client_reseau is None:
            self.label_statut_reseau.setText("Indisponible (module 'websockets' manquant).")
            self.label_statut_reseau.setStyleSheet(f"color: {Mocha.red}; font-size: 11px;")
            return
        self.client_reseau.connecte.connect(self._sur_connecte)
        self.client_reseau.echec_connexion.connect(self._sur_echec_connexion)
        self.client_reseau.liste_instances_recue.connect(self._sur_liste_instances_recue)
        self.client_reseau.frame_recue.connect(self._sur_frame_recue)
        self.client_reseau.erreur_recue.connect(self._sur_erreur_recue)
        self.client_reseau.liaison_echouee.connect(self._sur_liaison_echouee)
        self.client_reseau.instance_deliee.connect(self._sur_instance_deliee)
        self.client_reseau.command_result_recu.connect(self._sur_command_result_onglet)
        self.client_reseau.demarrer()

    def _sur_connecte(self):
        self.label_statut_reseau.setText(f"Connecté au serveur (pilote {self._id_pilote}).")
        self.label_statut_reseau.setStyleSheet(f"color: {Mocha.green}; font-size: 11px;")

    def _sur_echec_connexion(self, message: str):
        self.label_statut_reseau.setText(f"Connexion impossible : {message}")
        self.label_statut_reseau.setStyleSheet(f"color: {Mocha.red}; font-size: 11px;")

    def _sur_erreur_recue(self, message: str):
        log_instance_apercu.warning(f"[{self._id_pilote}] Erreur reçue du serveur : {message}")
        self._sur_erreur_reseau(message)

    def _sur_erreur_reseau(self, message: str):
        """Hook -- la sous-classe redéfinit pour afficher l'erreur sur son
        propre statut_label (chaque écran a son propre libellé/contexte).

        PATCH (demande utilisateur explicite : "il faut mettre le message
        de camoufox1 introuvable en jaune et non en rouge") : une erreur
        générique serveur SANS requete_id (typiquement "instance
        introuvable", émise pendant que l'instance démarre encore, avant
        son enregistrement réseau) est transitoire, pas un vrai échec
        métier -- jaune, pas rouge (rouge réservé aux command_result
        ok=False, cf. _sur_command_result_onglet, inchangé).

        Débloque les deux requêtes potentiellement en vol (impossible de
        savoir laquelle sans requete_id) ; inoffensif si aucune ne l'était."""
        if getattr(self, "_requete_id_liste_onglets", None) is not None:
            self._requete_id_liste_onglets = None
            self.label_statut_onglets.definir_texte(f"Pas encore prêt : {message}")
            self.label_statut_onglets.setStyleSheet(f"color: {Mocha.yellow}; font-size: 11px;")
        if getattr(self, "_requete_id_switch_onglet", None) is not None:
            self._requete_id_switch_onglet = None
            log_instance_apercu.warning(f"[{self._id_pilote}] switchTab échoué : {message}")
            self.label_statut_onglets.definir_texte(f"Pas encore prêt : {message}")
            self.label_statut_onglets.setStyleSheet(f"color: {Mocha.yellow}; font-size: 11px;")

    def _sur_liaison_echouee(self, instance_id: str, message: str):
        """FIX (bug : test qui tourne dans le vide) -- avant ce patch, un
        échec de link (ex: instance déjà liée à un AUTRE pilote, cf.
        gerer_link/serveur.py) n'était visible que via erreur_recue
        (jamais vérifié par _on_instance_changed), qui continuait donc
        comme si la liaison avait réussi : set_streaming était envoyé,
        toutes les commandes ultérieures étaient rejetées une par une par
        le serveur, en silence pour l'utilisateur.

        Si l'instance signalée est bien celle que CET écran croit avoir
        liée, on annule cette croyance localement (_instance_liee = None)
        et on prévient la sous-classe via le hook _sur_liaison_echouee_pour_instance,
        qui peut alors bloquer un test en cours plutôt que de le laisser
        tourner sur une liaison qui n'existe pas réellement côté serveur."""
        if instance_id != self._instance_liee:
            return
        log_instance_apercu.warning(
            f"[{self._id_pilote}] _sur_liaison_echouee() : liaison sur '{instance_id}' refusée par le "
            f"serveur ({message}) -- annulation de l'état de liaison local"
        )
        self._instance_liee = None
        self._rafraichissement_ponctuel_en_attente = False
        self._rafraichir_disponibilite_onglets()
        # BUGFIX (bouton "Déconnecter") : le serveur a REFUSÉ la liaison,
        # donc rien à unlink de son côté -- mais le combo et le bouton
        # doivent quand même refléter "plus rien de lié" localement,
        # sinon le bouton resterait actif pour une liaison qui n'a en
        # fait jamais existé côté serveur.
        self._rafraichir_etat_bouton_deconnexion()
        # Message déjà complet et grammaticalement correct pour CE cas
        # précis (refus dès la demande initiale) -- le hook commun
        # l'insère tel quel, sans reformuler de verbe, pour rester
        # cohérent avec le cas symétrique _sur_instance_deliee ci-dessous
        # (raison différente, donc phrase différente).
        message_complet = (
            f"Impossible de lier l'instance '{instance_id}' : {message}."
        )
        self._sur_liaison_echouee_pour_instance(instance_id, message_complet)

    def _sur_instance_deliee(self, instance_id: str, raison: str):
        """Réagit au message 'unlinked' du serveur (cf. srv_gerer_link) :
        CET écran avait bien la liaison, mais un AUTRE pilote/dashboard
        vient de la reprendre (reprise automatique, décision utilisateur --
        le dernier demandeur a toujours la main). Symétrique à
        _sur_liaison_echouee, qui gère le cas où la liaison était refusée
        dès la demande initiale plutôt que retirée après coup -- même
        conséquence pour l'écran dans les deux cas (plus de liaison
        valide), donc même hook _sur_liaison_echouee_pour_instance
        réutilisé tel quel (ex: TestFeatureScreen y arrête un test en
        cours plutôt que de le laisser tourner sur une instance qu'il ne
        contrôle plus)."""
        if instance_id != self._instance_liee:
            return
        log_instance_apercu.warning(
            f"[{self._id_pilote}] _sur_instance_deliee() : liaison sur '{instance_id}' "
            f"retirée par le serveur ({raison}) -- annulation de l'état de liaison local"
        )
        self._instance_liee = None
        self._rafraichissement_ponctuel_en_attente = False
        self._rafraichir_disponibilite_onglets()
        # BUGFIX (bouton "Déconnecter") : liaison retirée CÔTÉ SERVEUR
        # (reprise par un autre pilote) -- rien à unlink nous-même, mais
        # même besoin de resynchroniser l'état local du bouton, cf.
        # commentaire jumeau dans _sur_liaison_echouee ci-dessus.
        self._rafraichir_etat_bouton_deconnexion()
        # Message déjà complet, distinct de celui de _sur_liaison_echouee
        # ci-dessus : la liaison avait RÉUSSI puis a été RETIRÉE (ex:
        # "repris par 'dashboard-autoniax'"), donc "Impossible de lier"
        # serait faux ici -- on annonce plutôt la reprise.
        message_complet = (
            f"Liaison sur l'instance '{instance_id}' retirée : {raison}."
        )
        self._sur_liaison_echouee_pour_instance(instance_id, message_complet)

    def _sur_liaison_echouee_pour_instance(self, instance_id: str, message: str):
        """Hook -- la sous-classe redéfinit pour réagir à une perte de
        liaison, qu'elle soit refusée dès le départ (_sur_liaison_echouee)
        ou retirée après coup (_sur_instance_deliee). Dans les deux cas,
        `message` est déjà une phrase complète et correctement formulée
        pour le cas réel (verbe différent selon la cause) -- la
        sous-classe doit l'afficher tel quel, sans le réinsérer dans un
        gabarit du type "Impossible de lier... : {message}" qui serait
        faux si la liaison avait en fait réussi puis a été retirée."""
        pass

    def _demander_liste_instances(self):
        if self.client_reseau is not None:
            self.client_reseau.envoyer_commande({"type": "list_instances"})

    def _sur_liste_instances_recue(self, instances: list):
        instance_actuelle = self.instance_combo.currentData()
        self.instance_combo.blockSignals(True)
        self.instance_combo.clear()
        # BUGFIX (retour utilisateur : "je démarre une instance et je tente
        # de l'utiliser dans le task config, on me dit qu'elle est déjà
        # occupée" -- alors que l'instance est toute neuve et n'a jamais
        # été manipulée). Un QComboBox Qt sélectionne AUTOMATIQUEMENT son
        # premier item dès qu'on lui en ajoute un (currentIndex passe à 0
        # tout seul, indépendamment de tout appel explicite à
        # setCurrentIndex) -- donc peupler directement avec les vraies
        # instances ci-dessous, sans rien d'autre, revenait déjà à
        # sélectionner la première par défaut. C'est exactement contraire
        # à l'intention documentée de selectionner_instance() plus bas :
        # cet écran doit rester PASSIF (rien lié) tant qu'un appelant
        # externe (ex: instance_apercu_batch, construite UNE FOIS avec son
        # combo natif volontairement MASQUÉ, jamais piloté par
        # l'utilisateur) n'a pas explicitement choisi une instance --
        # jamais de sélection par défaut, qui envoyait alors un vrai "link"
        # (role="pilote", EXCLUSIF, cf. __init__ et _on_instance_changed
        # juste en dessous) sur la première instance apparue dans la
        # liste, à l'insu de l'utilisateur -- avant même sa première
        # tentative volontaire de liaison ailleurs (ex: TaskConfigScreen),
        # qui la trouvait alors déjà "occupée". Un item factice, non
        # sélectionnable comme vraie instance (data=None), ajouté en tête
        # UNIQUEMENT si rien n'était déjà sélectionné, absorbe cette
        # sélection Qt par défaut sans effet de bord : currentData() reste
        # None, donc _on_instance_changed (déclenché normalement par ce
        # premier ajout, avant que le bloc ci-dessous n'ait even commencé)
        # ne fait rien (cf. son tout premier test : "nouvelle_instance is
        # not None").
        if not instance_actuelle:
            self.instance_combo.addItem("(aucune sélection)", None)
        # Une instance déjà liée à un AUTRE pilote reste listée (le
        # serveur ne les masque pas, cf. _liste_instances_message côté
        # serveur.py -- "libre" est juste un booléen d'info). L'indication
        # visuelle "(occupée)" a été retirée à la demande de l'utilisateur
        # -- le libellé n'affiche plus l'état "libre"/"occupée", mais la
        # règle de liaison exclusive côté serveur reste INCHANGÉE : une
        # instance déjà liée à un autre pilote sera toujours refusée au
        # link (cf. _sur_liaison_echouee_pour_instance), seul l'affichage
        # change.
        for item in instances:
            id_instance = item.get("id")
            libelle = id_instance
            self.instance_combo.addItem(libelle, id_instance)
        if self.instance_combo.count() == 0:
            self.instance_combo.addItem("Aucune instance connectée", None)
        index = self.instance_combo.findData(instance_actuelle) if instance_actuelle else -1
        if index >= 0:
            self.instance_combo.setCurrentIndex(index)
        self.instance_combo.blockSignals(False)
        if index >= 0:
            self._on_instance_changed(self.instance_combo.currentIndex())

    def _on_instance_changed(self, index: int):
        nouvelle_instance = self.instance_combo.currentData()
        if nouvelle_instance == self._instance_liee:
            return
        log_instance_apercu.info(
            f"[{self._id_pilote}] _on_instance_changed() : {self._instance_liee!r} -> {nouvelle_instance!r}"
        )
        # BUGFIX (retour utilisateur : "jai toujour des problem de liason
        # de conexions") : avant de changer/quitter l'instance liée, on
        # envoie un 'unlink' EXPLICITE au serveur pour l'ancienne instance
        # (self._instance_liee, encore l'ancienne valeur ici). Avant ce
        # correctif, quitter une instance en repassant le combo sur
        # "(aucune sélection)" ne faisait QUE mettre à jour l'état LOCAL
        # (self._instance_liee = None) -- le verrou côté serveur restait
        # posé jusqu'à la déconnexion complète du pilote (cf. logs :
        # "Instance ... libérée (pilote ... déconnecté)" seulement à la
        # fermeture). Résultat observé : une instance apparemment "libre"
        # dans un autre écran, mais dont le lien précédent traînait encore
        # côté serveur, ou un état local/serveur désynchronisé après un
        # changement d'instance répété. Un unlink redemandé sur une
        # instance déjà libre reste sans effet côté serveur (même esprit
        # que le link redondant documenté juste en dessous), donc sûr même
        # si l'ancienne liaison avait déjà été perdue entre-temps.
        if self._instance_liee is not None and self.client_reseau is not None:
            self.client_reseau.envoyer_commande({
                "type": "unlink", "instance_id": self._instance_liee,
            })
        self._changement_instance_pre(nouvelle_instance)
        self._instance_liee = nouvelle_instance
        self._derniere_image = None
        self.apercu_label.setPixmap(QPixmap())
        self._rafraichissement_ponctuel_en_attente = False
        # cf. PanneauRenduInstance.definir_profil_actif -- cas LOCAL : pas
        # de "nom de profil" convivial distinct de l'instance_id ici
        # (contrairement au réseau, cf. TestComposantScreen._on_instance_
        # changed, qui affiche "sAutoniax-1 · xian1"), donc affichage
        # direct de l'instance_id, ou état neutre si nouvelle_instance
        # est None (désélection/déconnexion).
        self._panneau_rendu.definir_profil_actif(nouvelle_instance)
        if nouvelle_instance is not None and self.client_reseau is not None:
            self.apercu_label.setText(f"En attente du flux de {nouvelle_instance}…")
            # link explicite ici + un autre renvoyé par _appliquer_etat_streaming
            # juste en dessous (et potentiellement un 3e par
            # _demander_liste_onglets_navigateur -> _envoyer_commande_liee,
            # cf. plus bas) : redondant mais volontairement laissé ainsi --
            # un link répété reste SANS EFFET côté serveur (cf.
            # srv_gerer_link), donc plus simple et plus sûr que d'essayer
            # de dédupliquer ces envois.
            self.client_reseau.envoyer_commande({
                "type": "link", "pilote_id": self._id_pilote, "instance_id": nouvelle_instance,
            })
            # Jamais de flux imposé ici : on applique l'état de
            # rafraîchissement automatique déjà choisi par l'utilisateur
            # pour CET écran (actif ou non), la nouvelle instance liée
            # démarre dans le même état que l'ancienne.
            self._appliquer_etat_streaming(nouvelle_instance)
        self._rafraichir_disponibilite_onglets()
        if nouvelle_instance is not None:
            self._demander_liste_onglets_navigateur()
        self._rafraichir_etat_bouton_deconnexion()
        self._changement_instance_post(nouvelle_instance)

    def _rafraichir_etat_bouton_deconnexion(self):
        """Le bouton "Déconnecter" (cf. __init__) n'a de sens que si une
        instance est réellement liée -- désactivé sinon, pour ne pas
        laisser l'utilisateur cliquer sur un bouton qui ne ferait rien
        (et éviter un unlink inutile envoyé pour self._instance_liee=None,
        déjà de toute façon sans effet côté _on_instance_changed mais
        autant que le bouton reflète honnêtement l'état actuel)."""
        self.deconnecter_button.setEnabled(self._instance_liee is not None)

    def _sur_drag_capture_demarre(self):
        """Connectée à bouton_drag_capture.drag_demarre (cf. __init__) --
        masque la fenêtre principale AutoniaX dès le début du glisser de
        la capture, pour dégager la vue vers l'application cible sous la
        souris (retour utilisateur : "lorsque on clic déjà sur ce bouton
        pour le drag, l'interface doit se réduire automatiquement pour
        qu'on puisse glisser vers où l'on veut").

        CORRECTIF (retour explicite utilisateur : "sa ne fonctionne
        toujours pas ... surtout quand l'interface se réduit, ça fait
        quelque chose") -- hide() au lieu de showMinimized() : cf. le
        commentaire détaillé dans __init__ juste au-dessus de la
        connexion de ce signal. showMinimized() cassait le grab souris du
        QDrag natif en cours (drag.exec() bloquant, cf. ApercuDragHandle.
        mouseMoveEvent), empêchant le drop d'arriver à destination --
        exactement le même piège déjà rencontré et corrigé sur
        FenetreRenduTaskReseau._sur_drag_capture_demarre (son docstring
        documente la même correction, showMinimized() -> masquage)."""
        self.window().hide()

    def _sur_drag_capture_termine(self):
        """Contrepartie de _sur_drag_capture_demarre -- réaffiche la
        fenêtre principale dès le drag terminé (succès ou annulation
        confondus, Qt ne distingue pas les deux ici, cf. docstring de
        ApercuDragHandle). Contrairement à FenetreRenduTaskReseau (fenêtre
        séparée accessoire que l'utilisateur rouvre lui-même), self.window()
        est ICI la fenêtre principale AutoniaX -- la laisser cachée sans
        restauration automatique la rendrait introuvable (pas d'icône de
        réduction dans la barre des tâches contrairement à showMinimized())."""
        self.window().show()

    def _deconnecter_instance(self):
        """Bouton "Déconnecter" -- quitte l'instance actuellement liée de
        façon EXPLICITE et sans ambiguïté (retour utilisateur : "bouton de
        deconnection claire pour claire claire"). Repasse le combo sur
        l'item "(aucune sélection)" (data=None) pour déclencher
        _on_instance_changed(None) via currentIndexChanged (déjà connecté)
        -- qui envoie le vrai unlink au serveur (cf. BUGFIX plus haut) et
        nettoie l'état local (aperçu, streaming, onglets).

        BUGFIX : ne peut PAS se contenter d'un findData(None) --
        _sur_liste_instances_recue n'ajoute l'item "(aucune sélection)" au
        combo QUE si rien n'était déjà sélectionné (cf. sa docstring) ;
        or ce bouton n'est activé QUE quand une vraie instance EST liée
        (cf. _rafraichir_etat_bouton_deconnexion), donc l'item factice est
        alors systématiquement ABSENT du combo -- findData(None)
        renverrait toujours -1 ici, bouton silencieusement cassé. On
        l'insère donc nous-même en position 0 si besoin avant de
        sélectionner : addItem() de Qt appelle currentIndexChanged tout
        seul, mais un item déjà data=None a beau être présent, tant qu'il
        n'est pas SÉLECTIONNÉ le signal ne part pas -- setCurrentIndex()
        juste après s'en charge normalement."""
        index_avant = self.instance_combo.currentIndex()
        index = self.instance_combo.findData(None)
        if index < 0:
            self.instance_combo.blockSignals(True)
            self.instance_combo.insertItem(0, "(aucune sélection)", None)
            self.instance_combo.blockSignals(False)
            index = 0
        self.instance_combo.setCurrentIndex(index)
        if index == index_avant:
            # setCurrentIndex() n'émet currentIndexChanged QUE si l'index
            # a réellement changé -- déjà à cette position (ne devrait pas
            # arriver puisque le bouton est désactivé quand rien n'est
            # lié, mais défense en profondeur), donc le signal Qt ne
            # partirait pas tout seul : on force l'appel pour ne jamais
            # laisser le bouton sans effet visible.
            self._on_instance_changed(index)

    def _changement_instance_pre(self, nouvelle_instance: Optional[str]):
        """Hook -- appelé juste avant de changer d'instance liée (encore
        sur l'ancienne self._instance_liee). Les sous-classes y arrêtent
        leur propre logique en cours (ex: test armé, séquence d'action)."""
        pass

    def _changement_instance_post(self, nouvelle_instance: Optional[str]):
        """Hook -- appelé juste après avoir changé d'instance liée et
        envoyé link/set_streaming. Les sous-classes y rafraîchissent par
        exemple la disponibilité de leur propre bouton d'action."""
        pass

    # ------------------------------------------------------------------
    # Contrôle externe (décision explicite utilisateur, cf. onglet Aperçu
    # d'exécution de ProjetBatchScreen : "je ne veux pas que en arrière-
    # plan le programme rafraîchisse des images si ce n'est même pas
    # visible/actif/sélectionné/courant") -- ajout PUR, sans impact sur
    # les sous-classes existantes (TestComposantScreen, CoordonneeAction
    # Screen) qui n'appellent jamais ces méthodes et gardent leur
    # comportement inchangé.
    # ------------------------------------------------------------------
    def suspendre_streaming(self):
        """Coupe le streaming continu de l'instance actuellement liée SANS
        toucher à self._rafraichissement_auto_actif (préserve l'état de la
        case "Rafraîchissement automatique" pour une reprise ultérieure via
        reprendre_streaming()) -- à appeler par l'écran conteneur quand CET
        écran devient invisible (onglet quitté, écran fermé) pour ne
        jamais laisser un flux tourner pour rien en arrière-plan."""
        if self._instance_liee is None or self.client_reseau is None:
            return
        self.client_reseau.envoyer_commande({
            "type": "command", "instance_id": self._instance_liee,
            "action": "set_streaming", "actif": False,
        })

    def reprendre_streaming(self):
        """Réapplique l'état de streaming déjà choisi par l'utilisateur
        pour l'instance actuellement liée (actif ou non selon la case
        "Rafraîchissement automatique", cf. _appliquer_etat_streaming) --
        à appeler par l'écran conteneur quand CET écran redevient visible,
        symétrique de suspendre_streaming()."""
        if self._instance_liee is None:
            return
        self._appliquer_etat_streaming(self._instance_liee)

    def selectionner_instance(self, instance_id: Optional[str]):
        """Sélectionne instance_id dans self.instance_combo par
        programmation (déclenche _on_instance_changed normalement, via le
        signal currentIndexChanged déjà connecté, cf. __init__) -- pour un
        appelant externe (ex: ProjetBatchScreen) qui pilote cet écran
        depuis sa propre liste d'instances plutôt que via le combo natif
        de cet écran. Si instance_id est une vraie instance absente de la
        liste actuelle (pas encore reçue via liste_instances_recue), ne
        fait rien -- l'appelant peut réessayer après le prochain
        _sur_liste_instances_recue si besoin.

        BUGFIX (retour utilisateur : batch bloqué en boucle sur
        "InstancesIndisponiblesError ... déjà occupée par un autre
        pilote", MÊME après un force_unlink manuel via le bouton "Free" --
        et même après l'appel à selectionner_instance(None) déjà en place
        dans _demarrer_batch) : le cas instance_id=None est différent des
        vraies instances. _sur_liste_instances_recue n'ajoute l'item
        factice "(aucune sélection)" (data=None) au combo QUE si rien
        n'était déjà sélectionné à ce moment-là (cf. sa docstring) -- donc
        tant qu'une instance EST liée (le cas exact que cette méthode sert
        à dénouer), cet item est ABSENT du combo. findData(None) renvoyait
        alors -1, et l'ancien code faisait un retour immédiat SANS jamais
        appeler setCurrentIndex ni déclencher _on_instance_changed -- la
        méthode censée libérer l'instance ne faisait donc RIEN dans le cas
        même où elle était utile. Même pattern déjà identifié et corrigé
        pour le bouton "Déconnecter" (cf. _deconnecter_instance) mais
        jamais répliqué ici : on insère nous-même l'item factice si besoin
        avant de sélectionner, et on force l'appel à _on_instance_changed
        si setCurrentIndex n'émettrait pas currentIndexChanged tout seul
        (index déjà courant)."""
        if instance_id is None:
            index_avant = self.instance_combo.currentIndex()
            index = self.instance_combo.findData(None)
            if index < 0:
                self.instance_combo.blockSignals(True)
                self.instance_combo.insertItem(0, "(aucune sélection)", None)
                self.instance_combo.blockSignals(False)
                index = 0
            self.instance_combo.setCurrentIndex(index)
            if index == index_avant:
                self._on_instance_changed(index)
            return
        index = self.instance_combo.findData(instance_id)
        if index < 0:
            return
        self.instance_combo.setCurrentIndex(index)

    # ------------------------------------------------------------------
    # Envoi centralisé de commande vers l'instance liée -- TOUJOURS
    # précédé d'un link (cf. docstring ci-dessous). Utilisé par TOUTES les
    # commandes "importantes" adressées à l'instance (listTabs, switchTab,
    # capture_propre, set_streaming, set_fps...), jamais par 'link' lui-même
    # ni par 'list_instances' (pas d'instance_id concerné).
    # ------------------------------------------------------------------
    # ------------------------------------------------------------------
    # Support cible RÉSEAU (sAutoniax distant) -- cf. _envoyer_commande_liee
    # ------------------------------------------------------------------
    def definir_client_serveur_t(self, client_serveur_t: Optional["ClientServeurT"]):
        """À appeler par la sous-classe si elle propose une cible RÉSEAU
        (sAutoniax) en plus des instances locales (cf. TestComposantScreen)
        -- sans cet appel, self._client_serveur_t reste None et
        _envoyer_commande_liee retombe toujours sur le protocole local
        (comportement inchangé pour CoordonneeActionScreen, qui n'appelle
        jamais cette méthode). Câble aussi commande_controle_distance_
        resultat_recu vers le MÊME dispatcher que le local (_sur_command_
        result_onglet) : formats identiques des deux côtés (requete_id/ok/
        error/result, cf. sur_command_result_reseau ailleurs dans ce
        fichier pour confirmation), donc aucune duplication de dispatcher
        nécessaire -- une commande "capture_propre" envoyée en mode
        réseau est traitée à l'identique d'une envoyée en local, quelle
        que soit la source du signal."""
        self._client_serveur_t = client_serveur_t
        if client_serveur_t is not None:
            client_serveur_t.commande_controle_distance_resultat_recu.connect(self._sur_command_result_onglet)

    def _envoyer_commande_liee(self, payload_commande: dict):
        """Renvoie D'ABORD un link vers self._instance_liee, PUIS le
        payload_commande demandé -- dans cet ordre, sur la même connexion
        (le serveur traite les messages entrants dans l'ordre de réception).
        Nécessaire depuis que la liaison peut être reprise automatiquement
        par un AUTRE pilote/dashboard à tout moment (cf. srv_gerer_link,
        décision utilisateur : le dernier demandeur a toujours la main) --
        sans ce renvoi systématique, un écran resté inactif un moment
        pourrait croire avoir toujours la liaison alors que le serveur l'a
        réattribuée entre-temps, et voir sa commande rejetée silencieusement
        (cf. bug initial : Dashboard qui envoyait set_streaming sans plus
        avoir de liaison valide).

        Un link redemandé alors qu'on l'a déjà reste SANS EFFET côté
        serveur (cf. srv_gerer_link : 'Redemander la même liaison... reste
        sans effet ici, sans erreur') -- donc toujours sûr d'en renvoyer un
        ici, même quand ce n'était pas strictement nécessaire.

        PATCH (cible RÉSEAU, cf. definir_client_serveur_t/TestComposantScreen)
        -- si self._id_executant_reseau est renseigné, bifurque ENTIÈREMENT
        vers ClientServeurT.envoyer_commande_instance : aucun 'link' à
        renvoyer dans ce cas (notion propre au protocole LOCAL uniquement,
        cf. srv_gerer_link -- le contrôle réseau d'un sAutoniax ne connaît
        pas cette étape, même patron EXACT que TaskConfigScreen._sur_
        commande_controle_distance : id_executant == instance_id en mode
        mono-profil Task réseau). Les deux cibles restent mutuellement
        exclusives (cf. docstring de self._id_executant_reseau) : jamais
        les deux envois à la fois pour un même appel.

        Ne fait rien si aucune instance/exécutant n'est ciblé localement
        ni côté réseau : appelant responsable de vérifier avant si un
        comportement différent (ex: callback d'erreur immédiat) est
        souhaité -- cf. _demander_capture_propre."""
        if self._id_executant_reseau is not None and self._client_serveur_t is not None:
            commande = {k: v for k, v in payload_commande.items() if k not in ("type", "instance_id", "requete_id")}
            self._client_serveur_t.envoyer_commande_instance(
                self._id_executant_reseau, self._instance_id_reseau_effectif(),
                payload_commande.get("requete_id", ""), commande,
            )
            return
        if self._instance_liee is None or self.client_reseau is None:
            return
        self.client_reseau.envoyer_commande({
            "type": "link", "pilote_id": self._id_pilote, "instance_id": self._instance_liee,
        })
        self.client_reseau.envoyer_commande(payload_commande)

    # ------------------------------------------------------------------
    # Onglet navigateur (listTabs/switchTab) -- cf. bloc UI dans __init__
    # ------------------------------------------------------------------
    def _rafraichir_disponibilite_onglets(self):
        """Active/désactive le combo + bouton selon qu'une instance est
        liée, et vide la liste dès qu'il n'y a plus d'instance (une
        instance différente peut avoir des onglets complètement
        différents -- jamais garder l'ancienne liste affichée)."""
        liee = self._instance_liee is not None
        self.onglet_combo.setEnabled(liee and self.onglet_combo.count() > 0)
        self.rafraichir_onglets_button.setEnabled(liee)
        if not liee:
            self.onglet_combo.blockSignals(True)
            self.onglet_combo.clear()
            self.onglet_combo.blockSignals(False)
            self.label_statut_onglets.definir_texte("Aucune instance liée.")
            self.label_statut_onglets.setStyleSheet(f"color: {Mocha.subtext0}; font-size: 11px;")

    def _demander_liste_onglets_navigateur(self):
        """Envoie listTabs à l'instance/exécutant ciblé (local ou réseau,
        cf. _envoyer_commande_liee). Corrélation par requete_id, même
        mécanisme que SequenceurActionReseau (cf. _envoyer_commande),
        réimplémenté ici en plus léger (pas de timer de timeout : un
        échec silencieux laisse simplement le combo dans son état
        précédent, sans bloquer le reste de l'écran)."""
        if self._instance_liee is None and self._id_executant_reseau is None:
            return
        requete_id = uuid.uuid4().hex[:12]
        self._requete_id_liste_onglets = requete_id
        self.label_statut_onglets.definir_texte("Récupération des onglets…")
        self.label_statut_onglets.setStyleSheet(f"color: {Mocha.subtext0}; font-size: 11px;")
        self._envoyer_commande_liee({
            "type": "command", "instance_id": self._instance_liee,
            "action": "listTabs", "requete_id": requete_id,
        })

    def _demander_switch_onglet_navigateur(self, tab_id: str):
        """Envoie switchTab(tabId) à l'instance/exécutant ciblé (local ou
        réseau) -- fire-and-forget côté UI (pas de callback bloquant : le
        combo affiche déjà la sélection choisie par l'utilisateur, la
        confirmation ok/error n'a besoin que d'être logguée, cf. _sur_
        command_result_onglet)."""
        if self._instance_liee is None and self._id_executant_reseau is None:
            return
        requete_id = uuid.uuid4().hex[:12]
        self._requete_id_switch_onglet = requete_id
        self._envoyer_commande_liee({
            "type": "command", "instance_id": self._instance_liee,
            "action": "switchTab", "requete_id": requete_id, "tabId": tab_id,
        })

    def _on_onglet_navigateur_change(self, index: int):
        tab_id = self.onglet_combo.currentData()
        if tab_id is None:
            return
        log_instance_apercu.info(f"[{self._id_pilote}] _on_onglet_navigateur_change() : tabId={tab_id!r}")
        self._demander_switch_onglet_navigateur(tab_id)

    # ------------------------------------------------------------------
    # Capture propre (détection OpenCV, cf. action_capture_propre côté
    # instance_nodriver.py) -- capture CDP dédiée SANS le curseur virtuel,
    # jamais utilisée pour l'affichage/streaming (qui garde le curseur
    # visible, cf. self._derniere_image/_sur_frame_recue, inchangés).
    # ------------------------------------------------------------------
    def _demander_capture_propre(self, callback: callable):
        """Envoie capture_propre à l'instance/exécutant ciblé (local OU
        réseau, cf. _envoyer_commande_liee). callback(image_b64: str|None,
        erreur: str|None) est appelé exactement une fois, à la réception
        du command_result (ou immédiatement avec une erreur si aucune
        cible n'est sélectionnée -- jamais d'attente silencieuse dans ce
        cas, contrairement à listTabs qui peut se permettre de ne rien
        faire). Pas de timer de timeout dédié ici : le timeout 5s côté
        instance (cf. _consommer_file_commandes) borne déjà l'attente en
        mode local, et un timeout équivalent côté serveurT/pilote existe
        pour le mode réseau (cf. commande_instance_ack/timeout_s) --
        renvoie dans les deux cas un command_result ok=False explicite
        plutôt que de laisser cette requête muette indéfiniment."""
        if self._instance_liee is None and self._id_executant_reseau is None:
            callback(None, "aucune instance liée")
            return
        requete_id = uuid.uuid4().hex[:12]
        self._callbacks_capture_propre_en_attente[requete_id] = callback
        self._envoyer_commande_liee({
            "type": "command", "instance_id": self._instance_liee,
            "action": "capture_propre", "requete_id": requete_id,
        })

    def _sur_command_result_onglet(self, data: dict):
        """Connecté à client_reseau.command_result_recu (cf.
        demarrer_reseau) -- filtre sur les requete_id des commandes de ce
        bloc (listTabs/switchTab/capture_propre), ignore tout le reste
        (résultats destinés à SequenceurActionReseau ou au rafraîchissement
        d'aperçu, qui utilisent leurs propres requete_id)."""
        requete_id = data.get("requete_id")
        callback_capture = self._callbacks_capture_propre_en_attente.pop(requete_id, None)
        if callback_capture is not None:
            if not data.get("ok", False):
                callback_capture(None, data.get("error", "erreur inconnue"))
            else:
                callback_capture((data.get("result") or {}).get("image_b64"), None)
            return
        if requete_id == getattr(self, "_requete_id_liste_onglets", None):
            self._requete_id_liste_onglets = None
            if not data.get("ok", False):
                self.label_statut_onglets.definir_texte(f"Échec : {data.get('error', 'erreur inconnue')}")
                self.label_statut_onglets.setStyleSheet(f"color: {Mocha.red}; font-size: 11px;")
                return
            onglets = data.get("result") or []
            self.onglet_combo.blockSignals(True)
            self.onglet_combo.clear()
            id_actif = None
            for onglet in onglets:
                titre = onglet.get("titre") or onglet.get("url") or onglet.get("id", "")
                libelle = titre if len(titre) <= 50 else titre[:47] + "…"
                self.onglet_combo.addItem(libelle, onglet.get("id"))
                if onglet.get("actif"):
                    id_actif = onglet.get("id")
            if not onglets:
                self.onglet_combo.addItem("Aucun onglet ouvert", None)
            index_actif = self.onglet_combo.findData(id_actif) if id_actif else -1
            self.onglet_combo.setCurrentIndex(max(0, index_actif))
            self.onglet_combo.blockSignals(False)
            self.onglet_combo.setEnabled(len(onglets) > 0)
            self.label_statut_onglets.definir_texte(f"{len(onglets)} onglet(s) trouvé(s).")
            self.label_statut_onglets.setStyleSheet(f"color: {Mocha.green}; font-size: 11px;")
        elif requete_id == getattr(self, "_requete_id_switch_onglet", None):
            self._requete_id_switch_onglet = None
            if not data.get("ok", False):
                log_instance_apercu.warning(
                    f"[{self._id_pilote}] switchTab échoué : {data.get('error', 'erreur inconnue')}"
                )
                self.label_statut_onglets.definir_texte(f"Échec du changement d'onglet : {data.get('error', 'erreur inconnue')}")
                self.label_statut_onglets.setStyleSheet(f"color: {Mocha.red}; font-size: 11px;")
                # Rattrapage automatique : CDP peut renvoyer un target déjà
                # fermé côté navigateur (délai de propagation interne,
                # indépendant du cache nodriver -- cf. update_targets()
                # déjà appelé côté action_list_tabs). Plutôt que de garder
                # un tabId mort affiché, on redemande la liste fraîche
                # immédiatement pour que le combo se corrige tout seul.
                self._demander_liste_onglets_navigateur()

    # ------------------------------------------------------------------
    # Rafraîchissement -- 3 réglages (cf. docstring de la classe)
    # ------------------------------------------------------------------
    def _appliquer_etat_streaming(self, instance_id: Optional[str] = None):
        instance_id = instance_id or self._instance_liee
        if instance_id is None or self.client_reseau is None:
            return
        # Un seul link envoyé ici en tête (pas via _envoyer_commande_liee,
        # qui en enverrait un par commande -- redondant entre set_fps et
        # set_streaming ci-dessous, un seul suffit avant les deux). Même
        # raison que _envoyer_commande_liee : la liaison peut avoir été
        # reprise automatiquement entre-temps par un autre écran (cf.
        # srv_gerer_link), donc toujours sûr de la renvoyer avant toute
        # commande importante plutôt que d'espérer qu'elle tient encore.
        self.client_reseau.envoyer_commande({
            "type": "link", "pilote_id": self._id_pilote, "instance_id": instance_id,
        })
        if self._rafraichissement_auto_actif:
            self.client_reseau.envoyer_commande({
                "type": "command", "instance_id": instance_id,
                "action": "set_fps", "fps": self._fps_auto_arrondi(),
            })
            self.client_reseau.envoyer_commande({
                "type": "command", "instance_id": instance_id,
                "action": "set_streaming", "actif": True,
            })
        else:
            self.client_reseau.envoyer_commande({
                "type": "command", "instance_id": instance_id,
                "action": "set_streaming", "actif": False,
            })

    def _fps_auto_arrondi(self) -> int:
        # set_fps côté instance attend un entier (cf. instance_nodriver.py,
        # int(data.get("fps", ...))) -- le réglage UI reste en decimal pour
        # permettre un taux lent (ex: 0.2 im/s = 1 image/5s) sans forcer un
        # FPS minimum de 1 qui serait déjà relativement lourd en continu.
        # En dessous de 1 FPS, on demande 1 (plancher protocole, cf.
        # FPS_MIN côté instance) et on régule le rythme réel nous-mêmes en
        # ignorant certaines frames -- non fait pour l'instant : le
        # plancher FPS_MIN de l'instance prévaut, cf. limitation ci-dessous.
        return max(1, round(self.fps_auto_spin.value()))

    def _on_fps_auto_change(self, valeur: float):
        if self._rafraichissement_auto_actif and self._instance_liee is not None:
            self._appliquer_etat_streaming()
        self._rafraichir_statut_rafraichissement()

    def _on_case_auto_toggled(self, actif: bool):
        self._rafraichissement_auto_actif = actif
        if self._instance_liee is not None:
            self._appliquer_etat_streaming()
        self._rafraichir_statut_rafraichissement()

    def _rafraichir_statut_rafraichissement(self):
        # FIX (layout qui bougeait au toggle) : LabelStatutElide garde une
        # hauteur fixe sur une seule ligne et élide lui-même le texte
        # selon sa largeur réelle -- le texte complet reste consultable
        # via le tooltip. Voir la classe LabelStatutElide pour le détail.
        if self._rafraichissement_auto_actif:
            texte_complet = f"Rafraîchissement automatique actif ({self.fps_auto_spin.value():.1f} im/s)."
        else:
            texte_complet = (
                "Rafraîchissement automatique désactivé -- utilisez le bouton "
                "\"Rafraîchir\" pour une image ponctuelle."
            )
        self.label_statut_rafraichissement.definir_texte(texte_complet)

    def _demander_rafraichissement(self):
        """Bouton "Rafraîchir" : capture PONCTUELLE. Si le rafraîchissement
        automatique est déjà actif, la prochaine frame du flux existant
        suffit -- pas besoin de forcer quoi que ce soit de plus, on attend
        juste qu'elle arrive (cf. _sur_frame_recue).

        PATCH (cible RÉSEAU, cf. definir_client_serveur_t) -- bifurque
        vers une capture_propre directe : set_streaming (flux continu)
        n'a pas d'équivalent dans le protocole commande_instance réseau
        (cf. son absence totale côté instance_nodriver.py/serveur.py pour
        ce protocole, même raisonnement déjà établi pour TestComposantScreen.
        _demarrer_test/_lancer_detection_reseau) -- capture_propre EST
        déjà, en réseau, la seule façon d'obtenir une image, ponctuelle
        par nature (pas de notion de 'flux déjà actif' à vérifier dans ce
        mode, contrairement au chemin local juste en dessous)."""
        if self._id_executant_reseau is not None and self._client_serveur_t is not None:
            log_instance_apercu.info(f"[{self._id_pilote}] _demander_rafraichissement() : capture_propre réseau")
            self._rafraichissement_ponctuel_en_attente = True
            self.rafraichir_button.setEnabled(False)
            self._rafraichir_texte_bouton_rafraichir(en_attente=True)
            self._demander_capture_propre(self._sur_capture_propre_pour_rafraichissement_reseau)
            return
        if self._instance_liee is None or self.client_reseau is None:
            log_instance_apercu.warning(
                f"[{self._id_pilote}] _demander_rafraichissement() : abandon "
                f"(instance_liee={self._instance_liee!r}, client_reseau={self.client_reseau is not None})"
            )
            return
        log_instance_apercu.info(
            f"[{self._id_pilote}] _demander_rafraichissement() : "
            f"ponctuel_en_attente déjà à {self._rafraichissement_ponctuel_en_attente} -> True"
        )
        if self._rafraichissement_auto_actif:
            # Flux déjà actif : rien à activer/désactiver, juste attendre
            # la prochaine frame qui arrivera de toute façon.
            self._rafraichissement_ponctuel_en_attente = True
            self.rafraichir_button.setEnabled(False)
            self._rafraichir_texte_bouton_rafraichir(en_attente=True)
            return
        self._rafraichissement_ponctuel_en_attente = True
        self.rafraichir_button.setEnabled(False)
        self._rafraichir_texte_bouton_rafraichir(en_attente=True)
        self._envoyer_commande_liee({
            "type": "command", "instance_id": self._instance_liee,
            "action": "set_streaming", "actif": True,
        })

    def _sur_capture_propre_pour_rafraichissement_reseau(self, image_b64: Optional[str], erreur: Optional[str]):
        """Callback de _demander_capture_propre depuis _demander_
        rafraichissement en mode réseau -- affiche directement l'image
        reçue via le hook _sur_nouvelle_frame (même point d'entrée que le
        chemin LOCAL via _sur_frame_recue, cf. son docstring), plutôt que
        de dupliquer l'affichage ici. Sur échec, affiche l'erreur au lieu
        de laisser le bouton "Capture en cours…" indéfiniment."""
        self._rafraichissement_ponctuel_en_attente = False
        self.rafraichir_button.setEnabled(True)
        self._rafraichir_texte_bouton_rafraichir(en_attente=False)
        if erreur is not None:
            log_instance_apercu.warning(f"[{self._id_pilote}] capture_propre (rafraîchissement réseau) échouée : {erreur}")
            self.label_statut_reseau.setText(f"Échec du rafraîchissement : {erreur}")
            self.label_statut_reseau.setStyleSheet(f"color: {Mocha.red}; font-size: 11px;")
            return
        image = decoder_image_b64(image_b64) if image_b64 else None
        if image is None:
            log_instance_apercu.warning(f"[{self._id_pilote}] capture_propre (rafraîchissement réseau) : image invalide")
            self.label_statut_reseau.setText("Échec du rafraîchissement : image invalide.")
            self.label_statut_reseau.setStyleSheet(f"color: {Mocha.red}; font-size: 11px;")
            return
        if image.width() > 0 and image.height() > 0:
            self._derniere_taille_frame = (image.width(), image.height())
        self._derniere_image = image
        self._sur_nouvelle_frame(image, capture_ponctuelle=True)

    def _rafraichir_texte_bouton_rafraichir(self, en_attente: bool):
        if en_attente:
            self.rafraichir_button.setText(" Capture en cours…")
        else:
            self.rafraichir_button.setIcon(qta.icon("mdi6.image-refresh-outline", color=Mocha.text))
            self.rafraichir_button.setText(" Rafraîchir")

    def _sur_frame_recue(self, instance_id: str, image_b64: str, seq: int):
        if instance_id != self._instance_liee:
            log_instance_apercu.debug(
                f"[{self._id_pilote}] _sur_frame_recue() : frame ignorée, pour une autre instance "
                f"(reçue={instance_id!r}, liée={self._instance_liee!r}, seq={seq})"
            )
            return
        try:
            donnees = base64.b64decode(image_b64)
        except Exception as e:
            log_instance_apercu.warning(f"[{self._id_pilote}] Frame illisible (seq={seq}) : {e!r}")
            return
        image = QImage()
        if not image.loadFromData(QByteArray(donnees)) or image.isNull():
            log_instance_apercu.warning(f"[{self._id_pilote}] Frame invalide/non décodable (seq={seq})")
            return
        self._derniere_taille_frame = (image.width(), image.height())
        self._derniere_image = image

        capture_ponctuelle = self._rafraichissement_ponctuel_en_attente
        log_instance_apercu.debug(
            f"[{self._id_pilote}] _sur_frame_recue() : seq={seq} taille={image.width()}x{image.height()} "
            f"capture_ponctuelle={capture_ponctuelle}"
        )
        if capture_ponctuelle:
            log_instance_apercu.info(f"[{self._id_pilote}] _sur_frame_recue() : capture ponctuelle résolue (seq={seq})")
            self._rafraichissement_ponctuel_en_attente = False
            self.rafraichir_button.setEnabled(True)
            self._rafraichir_texte_bouton_rafraichir(en_attente=False)
            if not self._rafraichissement_auto_actif and self._instance_liee is not None and self.client_reseau is not None:
                # Capture ponctuelle simulée (cf. docstring) : on désactive
                # le streaming aussitôt cette frame reçue, pour ne pas
                # laisser un flux continu tourner alors que l'utilisateur
                # n'a demandé qu'UNE image.
                self.client_reseau.envoyer_commande({
                    "type": "command", "instance_id": self._instance_liee,
                    "action": "set_streaming", "actif": False,
                })

        self._sur_nouvelle_frame(image, capture_ponctuelle)

    def _sur_nouvelle_frame(self, image: QImage, capture_ponctuelle: bool):
        """Hook -- appelé à chaque frame utile (déjà décodée, taille déjà
        mémorisée). Défaut : affichage brut sans overlay. Les sous-classes
        redéfinissent pour brancher leur propre logique (détection,
        exécution d'action...)."""
        self._afficher_apercu_defaut(image)

    def _afficher_apercu_defaut(self, image: QImage):
        # Échelle réelle (1:1), même principe que FenetreRenduTaskReseau
        # ._appliquer_pixmap_a_l_echelle -- apercu_label vit dans
        # apercu_scroll (QScrollArea, setWidgetResizable(False)), donc le
        # resize() explicite ci-dessous est nécessaire pour que les
        # barres de défilement se calculent sur la vraie taille du pixmap.
        pixmap = QPixmap.fromImage(image)
        self.apercu_label.setPixmap(pixmap)
        self.apercu_label.resize(pixmap.size())
        # cf. TestComposantScreen._afficher_apercu_avec_resultat et
        # ApercuDragHandle.mouseMoveEvent -- ce chemin-ci (pas d'overlay)
        # n'en pose jamais, mais efface un éventuel _pixmap_brute_sans_
        # overlay périmé d'un test précédent sur ce même apercu_label
        # réutilisé, pour que le drag retombe proprement sur pixmap()
        # (déjà "propre" ici) plutôt que de glisser une vieille capture
        # annotée qui ne correspond plus à ce qui est affiché.
        if hasattr(self.apercu_label, "_pixmap_brute_sans_overlay"):
            self.apercu_label._pixmap_brute_sans_overlay = None

    def demander_rafraichissement_pour_test(self) -> bool:
        """API publique pour la sous-classe : déclenche une capture
        ponctuelle si aucun flux automatique n'est actif (cf. demande
        explicite -- "Tester le composant" doit demander une image
        fraîche et analyser directement dessus, SAUF si un taux de
        rafraîchissement est déjà actif, auquel cas la dernière frame déjà
        reçue du flux existant suffit). Retourne True si une capture a été
        lancée (la sous-classe doit attendre _sur_nouvelle_frame), False si
        le flux auto est déjà actif (la sous-classe peut utiliser
        self._derniere_image immédiatement, ou attendre la prochaine
        frame du flux -- à sa convenance)."""
        log_instance_apercu.info(
            f"[{self._id_pilote}] demander_rafraichissement_pour_test() : "
            f"auto_actif={self._rafraichissement_auto_actif} "
            f"ponctuel_deja_en_attente={self._rafraichissement_ponctuel_en_attente} "
            f"instance_liee={self._instance_liee!r}"
        )
        if self._rafraichissement_auto_actif:
            return False
        self._demander_rafraichissement()
        return True

    def arreter_reseau(self):
        """À appeler par la sous-classe dans son propre arreter(), avant de
        fermer l'onglet -- ferme la connexion réseau propre à cet écran."""
        log_instance_apercu.info(f"[{self._id_pilote}] arreter_reseau()")
        if self.client_reseau is not None:
            self.client_reseau.arreter()


class DetectionWorker(QObject):
    """Exécute rechercher_composant_multi_variantes dans un QThread séparé,
    JAMAIS sur le thread GUI principal.

    Contexte du correctif : l'ancienne implémentation appelait la détection
    directement depuis le slot connecté à ClientReseauAutoniaX.frame_recue
    (donc bien dans le thread GUI malgré l'émission depuis le thread réseau,
    une connexion Signal/Slot inter-thread restant marshalée vers le thread
    de l'objet récepteur). rechercher_composant fait plusieurs passes
    matchTemplate (paliers DPI + balayage fin en secours) par variante, plus
    une validation croisée ORB/SSIM en cas d'ambiguïté -- répété à chaque
    frame reçue (jusqu'à ~20-30/s selon le FPS demandé à l'instance), ça
    sature le thread GUI en continu (interface figée, jusqu'au freeze
    complet de la machine selon la charge). rechercher_composant /
    rechercher_composant_multi_variantes sont du pur numpy/cv2 sans aucune
    dépendance Qt -- donc safe à exécuter hors du thread GUI.

    Transport de la demande de travail : un signal Qt (demande_detection),
    PAS QMetaObject.invokeMethod/Q_ARG. Tenté d'abord avec Q_ARG(object, ...)
    pour la liste de templates -- échoue à l'exécution sous PySide6
    ("Unable to find a QMetaType for 'object'"), Q_ARG exigeant un type
    enregistré dans le système de méta-types de Qt, ce que "object" n'est
    pas. Un signal/slot Qt, lui, sait transporter n'importe quel objet
    Python à travers une connexion inter-thread (PySide6 le sérialise en
    interne, sans passer par Q_ARG) -- c'est le mécanisme normal pour ce
    genre de worker, Q_ARG étant surtout utile pour invoquer une méthode
    avec des types Qt/C++ déjà connus.

    Un seul job à la fois : demander_detection() ignore silencieusement tout
    appel reçu pendant qu'un job est déjà en cours (voir _occupe), plutôt que
    d'empiler les demandes -- si les frames arrivent plus vite que la
    détection ne peut les traiter, on veut sauter des frames, pas accumuler
    un arriéré qui ferait dériver l'aperçu par rapport au flux réel."""

    demande_detection = Signal(QImage, list, float, str, int, float, str)  # émis depuis le thread GUI (5e arg : flou_noyau, cf. Composant.flou_noyau ; 6e arg : delta_conflit, cf. Composant.delta_conflit ; 7e arg : code_filtre, cf. Composant.code_filtre)
    resultat_pret = Signal(object, object, object)  # (resultat: dict|None, erreur: DetectionAmbigueError|DetectionFiltreComposantSingleError|None, score_brut: float|None)

    # PATCH (demande explicite utilisateur : voir aussi les "autres
    # candidats potentiels", PAS seulement le meilleur, mais UNIQUEMENT
    # dans l'écran de test -- jamais en production, cf. docstring de
    # rechercher_candidats_multiples) -- signal/slot séparés de
    # demande_detection/resultat_pret ci-dessus, pour ne rien changer au
    # comportement existant (production ET mode single-candidat de test
    # restent intacts, inchangés). Partage le même verrou self._occupe :
    # un seul job à la fois sur ce worker, quel que soit le mode demandé.
    demande_detection_multiple = Signal(QImage, list, float, int, str)  # (image, templates_bgr, seuil_candidats, flou_noyau, code_filtre)
    resultats_multiples_prets = Signal(list, object)  # (liste de dicts triée par score décroissant, erreur: DetectionFiltreComposantSingleError|None)

    def __init__(self):
        super().__init__()
        self._occupe = False
        self.demande_detection.connect(self._executer)
        self.demande_detection_multiple.connect(self._executer_multiple)

    def demander_detection(self, image: QImage, templates_bgr: list, seuil: Optional[float] = None,
                            priorite: Optional[str] = None, flou_noyau: Optional[int] = None,
                            delta_conflit: Optional[float] = None, code_filtre: Optional[str] = None):
        # PATCH (SPEC_GLOBALE_AutoniaX.md, Partie A §3.6) -- seuil/priorite/
        # flou_noyau/delta_conflit/code_filtre sont désormais optionnels
        # (None = "pas fourni par l'appelant") : templates_bgr contient
        # normalement des tuples (image_bgr, Variante) (cf.
        # charger_templates_bgr), et rechercher_composant_multi_variantes
        # lit alors les réglages PROPRES À CHAQUE variante -- ces 5
        # arguments ne servent plus que de repli rétrocompatible pour un
        # appelant qui passerait encore des images nues. La signature du
        # SIGNAL Qt demande_detection (cf. son Signal(...) ci-dessus), elle,
        # reste inchangée (types Qt fixes, non-Optional) -- les défauts
        # concrets ci-dessous (0.9/"mostTop"/0/0.0/"") sont substitués ICI,
        # avant le .emit(), pour rester compatibles avec cette signature.
        if self._occupe:
            return False
        self._occupe = True
        self.demande_detection.emit(
            image, templates_bgr,
            seuil if seuil is not None else 0.9,
            priorite if priorite is not None else "mostTop",
            flou_noyau if flou_noyau is not None else 0,
            delta_conflit if delta_conflit is not None else 0.0,
            code_filtre if code_filtre is not None else "",
        )
        return True

    def demander_detection_multiple(self, image: QImage, templates_bgr: list,
                                     seuil_candidats: Optional[float] = None,
                                     flou_noyau: Optional[int] = None,
                                     code_filtre: Optional[str] = None):
        """Équivalent de demander_detection(), mais pour le mode "candidats
        multiples" (écran de test uniquement, cf. rechercher_candidats_
        multiples). Retourne False sans rien faire si le worker est déjà
        occupé -- même règle "un seul job à la fois" que demander_detection.

        PATCH (SPEC_GLOBALE_AutoniaX.md, Partie A §3.3) -- seuil_candidats/
        flou_noyau/code_filtre optionnels, même principe que demander_detection
        ci-dessus : rechercher_candidats_multiples lit désormais ces réglages
        PAR VARIANTE depuis templates_bgr (tuples (image_bgr, Variante)) --
        seuil_candidats reste toutefois un réglage PROPRE À CHAQUE variante
        (cf. Variante.seuil_candidats_potentiels) tandis que ce paramètre-ci
        ne sert plus que de repli si une variante donnée n'en porte pas."""
        if self._occupe:
            return False
        self._occupe = True
        self.demande_detection_multiple.emit(
            image, templates_bgr,
            seuil_candidats if seuil_candidats is not None else 0.5,
            flou_noyau if flou_noyau is not None else 0,
            code_filtre if code_filtre is not None else "",
        )
        return True

    def _executer(self, image: QImage, templates_bgr: list, seuil: float, priorite: str, flou_noyau: int = 0,
                   delta_conflit: float = 0.0, code_filtre: str = ""):
        # Ce slot tourne dans le thread du worker : demande_detection est
        # connecté ici même (self.demande_detection.connect(self._executer)
        # dans __init__), et comme ce QObject a été déplacé vers le
        # QThread via moveToThread avant tout emit, Qt route automatiquement
        # l'appel en AutoConnection -> QueuedConnection (thread différent de
        # l'émetteur), donc bien exécuté sur le thread du worker.
        try:
            # qimage_vers_bgr (cvtColor + reshape numpy) ET la détection
            # elle-même tournent ici, dans ce thread -- rien de tout ça sur
            # le thread GUI (cf. docstring de la classe). seuil/priorite/
            # flou_noyau/delta_conflit/code_filtre reçus ici sont TOUJOURS
            # concrets (jamais None, cf. demander_detection qui substitue
            # les défauts avant le .emit()) -- rechercher_composant_multi_
            # variantes les utilise seulement en repli si templates_bgr
            # contient des images nues plutôt que des tuples (image_bgr,
            # Variante), cf. sa docstring.
            image_bgr = qimage_vers_bgr(image)
            resultat, score_brut = rechercher_composant_multi_variantes(image_bgr, templates_bgr, seuil, priorite, flou_noyau,
                                                                         delta_conflit, code_filtre)
            self.resultat_pret.emit(resultat, None, score_brut)
        except DetectionAmbigueError as e:
            self.resultat_pret.emit(None, e, None)
        except DetectionFiltreComposantSingleError as e:
            self.resultat_pret.emit(None, e, None)
        except Exception as e:
            log_test_composant.exception(f"Erreur inattendue dans le worker de détection : {e!r}")
            self.resultat_pret.emit(None, None, None)
        finally:
            self._occupe = False

    def _executer_multiple(self, image: QImage, templates_bgr: list, seuil_candidats: float, flou_noyau: int = 0,
                            code_filtre: str = ""):
        """Pendant de _executer() pour le mode candidats multiples -- même
        thread worker, même règle (jamais sur le thread GUI). Une erreur
        inattendue renvoie une liste vide plutôt que de laisser le worker
        bloqué en _occupe=True (même filet de sécurité que _executer). Une
        DetectionFiltreComposantSingleError (code_filtre invalide) est
        remontée explicitement via le second élément du signal, plutôt
        qu'avalée en silence comme une simple absence de candidat -- pour
        que TestComposantScreen puisse afficher l'erreur de code à
        l'utilisateur (même esprit que le mode simple ci-dessus)."""
        try:
            image_bgr = qimage_vers_bgr(image)
            candidats = rechercher_candidats_multiples(image_bgr, templates_bgr, seuil_candidats, flou_noyau,
                                                        code_filtre=code_filtre)
            self.resultats_multiples_prets.emit(candidats, None)
        except DetectionFiltreComposantSingleError as e:
            self.resultats_multiples_prets.emit([], e)
        except Exception as e:
            log_test_composant.exception(f"Erreur inattendue dans le worker de détection (mode multiple) : {e!r}")
            self.resultats_multiples_prets.emit([], None)
        finally:
            self._occupe = False


class DetectionLayoutWorker(QObject):
    """AJOUT (retour utilisateur explicite : "le templatematching fait
    aussi geler l'app, je veux que tu essai de mettre ces operations dans
    un wokers") -- pendant EXACT de DetectionWorker ci-dessus, mais pour
    le mode cL : exécute detecter_toutes_instances_composant_layout dans
    un QThread séparé, JAMAIS sur le thread GUI.

    Avant ce patch, _sur_capture_propre_pour_detection_layout appelait
    cette fonction DIRECTEMENT, de façon synchrone, sur le thread GUI (cf.
    son ancienne docstring : "REFONTE -- appel synchrone, pas besoin de
    worker séparé... rapide car UNE SEULE tentative par clic, jamais en
    boucle"). Ce raisonnement s'est avéré faux en pratique sur des
    gabarits/filtres coûteux (plusieurs passes -- filtre, extraction de
    blocs, regroupement spatial, évaluation de cluster par Zone, cf.
    detecter_toutes_instances_composant_layout) : même une seule tentative
    peut geler l'interface le temps du calcul. detecter_toutes_instances_
    composant_layout est du pur numpy/cv2 sans aucune dépendance Qt --
    donc safe à exécuter hors du thread GUI, exactement comme
    rechercher_composant_multi_variantes pour cS.

    Même règle "un seul job à la fois" que DetectionWorker (self._occupe)
    -- une demande reçue pendant qu'un job tourne déjà est ignorée plutôt
    qu'empilée (ne devrait de toute façon jamais arriver ici : une seule
    tentative par clic sur "Démarrer le test", cf. docstring de
    TestComposantScreen)."""

    # REFONTE (cf. SPEC_refonte_filtre_zones_dynamiques.md) : signature
    # allégée en même temps que detecter_toutes_instances_composant_
    # layout_sur_page -- plus de zones_gabarit/seuil_confiance/delta_
    # conflit/distance_max_regroupement_px (plus de gabarit statique à
    # matcher, le filtre nomme et valide lui-même chaque zone).
    demande_detection_layout = Signal(object, str, str)  # (image_bgr: np.ndarray, code_scindement, code_filtre) -- émis depuis le thread GUI
    resultat_layout_pret = Signal(list, object)  # (instances: list[dict], erreur: DetectionLayoutError|DetectionScindementError|None)

    def __init__(self):
        super().__init__()
        self._occupe = False
        self.demande_detection_layout.connect(self._executer)

    def demander_detection_layout(self, image_bgr, code_scindement: str, code_filtre: str):
        if self._occupe:
            return False
        self._occupe = True
        self.demande_detection_layout.emit(image_bgr, code_scindement, code_filtre)
        return True

    def _executer(self, image_bgr, code_scindement: str, code_filtre: str):
        # Ce slot tourne dans le thread du worker -- même mécanisme de
        # routage Qt (moveToThread + signal/slot) que DetectionWorker._executer
        # ci-dessus, cf. sa docstring pour le détail.
        #
        # MODIFIÉ : appelle désormais detecter_toutes_instances_composant_
        # layout_sur_page (scindement PUIS filtre par carte) au lieu du
        # pipeline mono-passe -- image_bgr reçue ici est la PAGE ENTIÈRE
        # capturée par TestComposantScreen, exactement comme pour visible()
        # en production (même contrat désormais des deux côtés).
        try:
            instances = detecter_toutes_instances_composant_layout_sur_page(
                image_bgr, code_scindement, code_filtre,
            )
            self.resultat_layout_pret.emit(instances, None)
        except (DetectionLayoutError, DetectionScindementError) as e:
            self.resultat_layout_pret.emit([], e)
        except Exception as e:
            log_test_composant.exception(f"Erreur inattendue dans le worker de détection layout : {e!r}")
            self.resultat_layout_pret.emit([], None)
        finally:
            self._occupe = False


class _AdapteurSequenceurReseauSautoniax(QObject):
    """Adaptateur minimal -- expose la SEULE interface que SequenceurActionReseau
    utilise réellement sur `client_reseau` (cf. son __init__/_envoyer_commande/
    arreter : le signal command_result_recu et la méthode envoyer_commande(message)),
    mais route vers le protocole RÉSEAU (sAutoniax distant, via ClientServeurT.
    envoyer_commande_instance) au lieu du protocole LOCAL (serveur 127.0.0.1:8765,
    via ClientReseauAutoniaX.envoyer_commande).

    Permet à TestComposantScreen de réutiliser SequenceurActionReseau TEL QUEL
    (aucune duplication de sa logique de séquencement/timeout/corrélation
    requete_id) pour piloter une instance sAutoniax, en mode réseau, exactement
    comme pour une instance locale -- seul ce petit adaptateur change de
    "destination" pour les deux points de contact utilisés.

    `message` reçu par envoyer_commande a la forme {"type": "command",
    "instance_id": ..., "action": ..., "requete_id": ..., **params} (cf.
    SequenceurActionReseau._envoyer_commande) -- reformaté ici vers l'appel
    ClientServeurT.envoyer_commande_instance(id_executant, instance_id,
    requete_id, {"action": ..., **params}), même patron EXACT que
    TaskConfigScreen._sur_clic_voir_rendu_reseau (cf. son _sur_commande_
    controle_distance).

    PATCH (correctif "plusieurs profils sur une instance") -- `instance_id`
    est maintenant un paramètre DISTINCT de `id_executant` : le premier
    route vers le bon sAutoniax, le second désigne le PROFIL précis à
    piloter dessus (ex. 'sautoniax-isole-camoufox4-8e17f358', pas le nom
    du sAutoniax lui-même). Optionnel, replié sur id_executant si omis --
    comportement mono-profil inchangé pour tout appelant qui ne connaît
    pas encore cette distinction."""

    command_result_recu = Signal(dict)

    def __init__(self, client_serveur_t: "ClientServeurT", id_executant: str, instance_id: Optional[str] = None, parent=None):
        super().__init__(parent)
        self._client_serveur_t = client_serveur_t
        self._id_executant = id_executant
        self._instance_id = instance_id or id_executant
        self._client_serveur_t.commande_controle_distance_resultat_recu.connect(
            self.command_result_recu.emit
        )

    def envoyer_commande(self, message: dict):
        commande = {k: v for k, v in message.items() if k not in ("type", "instance_id", "requete_id")}
        self._client_serveur_t.envoyer_commande_instance(
            self._id_executant, self._instance_id, message.get("requete_id", ""), commande,
        )

    def deconnecter(self):
        """Appelée par TestComposantScreen avant d'abandonner cet
        adaptateur (changement de cible réseau, ou retour en mode local) --
        évite que commande_controle_distance_resultat_recu (signal QUI VIT
        sur ClientServeurT, donc PLUS LONGTEMPS que cet adaptateur) continue
        de réémettre command_result_recu vers un adaptateur périmé."""
        try:
            self._client_serveur_t.commande_controle_distance_resultat_recu.disconnect(
                self.command_result_recu.emit
            )
        except (RuntimeError, TypeError):
            pass


class LectureImageDrapeeWorker(QObject):
    """AJOUT (retour utilisateur explicite : "lorsque je fait un drag sur
    l'interface ça freeze un peu, je veux que tu essai de mettre ces
    operations dans un wokers") -- lit le fichier déposé (I/O disque) et
    l'encode en base64 dans un QThread séparé, plutôt que directement sur
    le thread GUI dans le slot du dropEvent (cf. ancienne _sur_image_
    deposee : chemin.read_bytes() + base64.b64encode() synchrones). Pour
    un fichier volumineux (grosse capture d'écran haute résolution), ces
    deux opérations peuvent geler perceptiblement l'interface -- même
    logique de principe que DetectionWorker/DetectionLayoutWorker :
    déplacer tout calcul/I/O non trivial hors du thread GUI.

    Même règle "un seul job à la fois" que les autres workers de ce
    fichier (self._occupe)."""

    demande_lecture = Signal(str)  # chemin (str, PAS Path -- même prudence de type que les autres signaux Qt de ce fichier) émis depuis le thread GUI
    lecture_prete = Signal(str, object, object)  # (chemin: str, image_b64: str|None, erreur: str|None)

    def __init__(self):
        super().__init__()
        self._occupe = False
        self.demande_lecture.connect(self._executer)

    def demander_lecture(self, chemin: str):
        if self._occupe:
            return False
        self._occupe = True
        self.demande_lecture.emit(chemin)
        return True

    def _executer(self, chemin: str):
        try:
            donnees = Path(chemin).read_bytes()
            image_b64 = base64.b64encode(donnees).decode("ascii")
            self.lecture_prete.emit(chemin, image_b64, None)
        except OSError as exc:
            self.lecture_prete.emit(chemin, None, str(exc))
        except Exception as e:
            log_test_composant.exception(f"Erreur inattendue dans le worker de lecture d'image déposée : {e!r}")
            self.lecture_prete.emit(chemin, None, str(e))
        finally:
            self._occupe = False


class TestComposantScreen(InstanceApercuScreen):
    """Écran de test manuel d'un composant — ouvert en onglet dans la
    section Applications (5ème icône sidebar, "mdi6.apps") plutôt que dans
    un QDialog séparé (point 18 : "QDialog réservé aux seuls cas réellement
    bloquants"). Contient son propre sélecteur de composant (tous ceux du
    projet, toutes Interfaces confondues).

    Hérite de InstanceApercuScreen pour tout ce qui est connexion réseau
    indépendante, sélecteur d'instance, et les 3 réglages de
    rafraîchissement (bouton ponctuel / auto+FPS / désactivé) -- ne garde
    ici que ce qui est propre à CET écran : sélection du composant, action
    à exécuter si détecté (et ses paramètres), et la détection elle-même.

    MIGRÉ (Win32/hwnd -> instance nodriver/CDP) : la cible n'est plus une
    fenêtre Windows locale capturée via PrintWindow/PostMessage, mais une
    instance de navigateur pilotée à distance via le serveur central (cf.
    serveur.py, instance_nodriver.py).

    Détection déclenchée par "Démarrer le test", jamais en boucle continue
    imposée : self.demander_rafraichissement_pour_test() (cf.
    InstanceApercuScreen) demande une capture ponctuelle si aucun flux
    automatique n'est actif -- la détection attend alors _sur_nouvelle_frame
    -- ou renvoie False si un flux auto tourne déjà, auquel cas la
    DERNIÈRE frame reçue (self._derniere_image) est utilisée directement,
    sans redemander d'image. Dans tous les cas, UNE SEULE tentative de
    détection est lancée par clic sur "Démarrer le test" (jamais une
    tentative par frame en boucle -- cf. DetectionWorker : la détection est
    un calcul CPU-intensif, saturer le thread GUI ou même juste le
    redéclencher à chaque frame d'un flux rapide fige la machine).

    Taille de fenêtre pour l'animation du curseur (point de départ
    aléatoire, cf. SequenceurActionReseau._lancer_deplacement) : dérivée
    de la DERNIÈRE frame reçue (self._derniere_taille_frame, tenue à jour
    par InstanceApercuScreen._sur_frame_recue) plutôt qu'un
    obtenir_taille_fenetre(hwnd) Win32 -- nodriver.start() ne configure
    aucune résolution de fenêtre fixe ni ne l'expose sur le protocole
    (vérifié dans instance_nodriver.py), donc utiliser la taille réelle de
    ce qu'on voit est plus fidèle qu'une constante en dur.

    onglet_origine (str | None) : clé de l'écran depuis lequel cet onglet a
    été ouvert (ex: "composants"), mémorisée par ApplicationsScreen pour
    afficher un bouton "Retour" qui ramène précisément là — sans jamais
    fermer l'onglet, qui reste ouvert en arrière-plan dans Applications.

    reglages (ReglagesApp) : réglages globaux de l'app (onglet Paramètres).
    Le champ fenetre_debug_titre (Win32) n'est plus utilisé par cet écran
    depuis la migration -- resté propre à ParametresScreen, pas encore
    migré (hors scope de ce patch)."""

    # Modes possibles (REFONTE -- demande explicite utilisateur : "enlève
    # l'onglet Test [de ComposantLayoutConfigScreen], on va directement
    # réutiliser l'interface de test de composant actuelle, exactement la
    # même interface, sauf qu'on va juste enlever les paramètres que
    # composantL ne prend pas en compte") -- UN SEUL écran, mode fixé à la
    # construction (jamais changé en cours de vie de l'onglet -- pas de
    # sélecteur cS/cL mélangé dans le même combo).
    MODE_COMPOSANT = "composant"
    MODE_COMPOSANT_LAYOUT = "composant_layout"

    def __init__(self, project: Project, reglages: "ReglagesApp", mode: str = MODE_COMPOSANT, parent=None):
        super().__init__(id_pilote_prefixe="autoniax-test", titre_apercu="APERÇU DE L'INSTANCE CIBLE", parent=parent)
        self.project = project
        self.reglages = reglages
        self._mode = mode
        self.composant: Optional[Composant] = None
        self.composant_layout: Optional["ComposantLayout"] = None
        self._templates_bgr: list = []  # un template BGR par variante du composant -- cS uniquement
        self.onglet_origine: Optional[str] = None  # cf. ApplicationsScreen

        # PATCH (demande explicite utilisateur : "je veux maintenant que
        # ce bouton de drag prend l'image actuelle mais aussi l'image du
        # composant qui est testé") -- branché ICI, une seule fois, juste
        # après l'initialisation de self.composant : la factory lit
        # self.composant DYNAMIQUEMENT à chaque drag (via la closure),
        # jamais une valeur figée au moment de ce branchement -- pas
        # besoin de la rebrancher à chaque changement de composant dans
        # le combo "COMPOSANT À TESTER" (cf. _on_composant_changed).
        # get_app_data_dir() / image_path (Composant.image_path : chemin
        # relatif de la 1ère variante, cf. sa docstring), même résolution
        # de chemin que le reste du fichier (cf. par ex. ligne ~4193,
        # get_app_data_dir() / composant.variantes[0]).
        #
        # REFONTE (mode composant_layout) : _entite_testee() ci-dessous
        # retourne self.composant OU self.composant_layout selon le mode
        # -- ComposantLayout.image_path existe et pointe vers image_
        # reference (propriété alignée explicitement sur Composant.
        # image_path, cf. sa docstring), donc AUCUN changement nécessaire
        # ici au-delà de lire la bonne entité.
        def _image_composant_teste() -> Optional[Path]:
            entite = self._entite_testee()
            if entite is None:
                return None
            chemin_relatif = entite.image_path
            if not chemin_relatif:
                return None
            return get_app_data_dir() / chemin_relatif

        self._panneau_rendu.definir_image_composant_teste_factory(_image_composant_teste)

        # _en_cours : test armé, EN ATTENTE de la PROCHAINE frame reçue pour
        # tenter UNE SEULE détection (jamais une boucle continue -- cf.
        # DetectionWorker : ça saturait le thread GUI et pouvait figer la
        # machine). Repasse à False dès que la tentative a eu lieu, qu'il y
        # ait détection ou non -- relancer le test nécessite de recliquer
        # "Démarrer le test".
        self._en_cours = False
        self._detection_en_vol = False  # une tentative est partie vers le worker, en attente de resultat_pret
        self._image_en_cours_analyse: Optional[QImage] = None  # image associée à la détection en vol
        # cf. docstring de _sur_capture_propre_pour_detection_layout --
        # pendant, pour cL, de self._image_en_cours_analyse ci-dessus :
        # ComposantLayout figé au moment de la demande envoyée au worker,
        # pour retrouver le bon libellé dans _sur_resultat_detection_layout
        # même si la sélection a changé entre-temps.
        self._composant_layout_en_cours_analyse: Optional["ComposantLayout"] = None
        # AJOUT (retour utilisateur : "quand je démarre le test ça
        # considère toujours que je veux utiliser le profil [réseau]" --
        # après un drop d'image sur apercu_label, cf. _sur_image_deposee,
        # un clic sur "Démarrer le test" doit RETESTER cette même image,
        # jamais retomber sur le chemin réseau normal) -- base64 brut de
        # la DERNIÈRE image déposée (même format que decoder_image_b64
        # attend), None tant qu'aucun drop n'a eu lieu. Vérifié en tout
        # premier dans _demarrer_test (cf. son docstring) : tant qu'elle
        # est non-None, elle prime SYSTÉMATIQUEMENT sur toute cible
        # réseau/locale sélectionnée -- jamais effacée automatiquement
        # par un changement de composant/instance (cf. docstring de
        # _sur_image_deposee : reste active jusqu'au prochain drop).
        self._image_deposee_b64: Optional[str] = None
        # AJOUT (retour utilisateur : "non" à l'exécution d'action réelle
        # sur une image déposée) -- True UNIQUEMENT pendant qu'une
        # tentative de détection lancée depuis l'image déposée est en
        # vol (posé par _lancer_detection_sur_image_deposee, lu par
        # _sur_resultat_detection en mode cS) : empêche _executer_action
        # de déclencher clic/saisie/etc. sur une instance réseau pour un
        # résultat qui ne provient PAS d'une capture réelle de cette
        # instance -- aucun sens à agir sur une cible que l'image
        # déposée ne représente pas forcément. Repassé à False dès que
        # ce résultat a été traité (même point que _detection_en_vol),
        # jamais laissé actif entre deux tentatives.
        self._test_depuis_image_deposee: bool = False
        self._sequenceur: Optional[SequenceurActionReseau] = None
        self._adaptateur_reseau_sautoniax: Optional["_AdapteurSequenceurReseauSautoniax"] = None
        # PATCH (sélecteur groupé Local/Réseau, cf. _peupler_selecteur_cible)
        # -- {id_executant: nom}, câblé par ApplicationsScreen.ouvrir_test_
        # composant (même source unique ClientServeurT.executants_detail_
        # change que TaskConfigScreen._noms_executants_reseau, cf. sa
        # docstring pour le patron d'origine). Mutation EN PLACE
        # (.clear()+.update()) dans definir_executants_reseau_connus, même
        # raison que _noms_executants_reseau côté TaskConfigScreen -- mais
        # ici aucun autre widget ne garde de référence à ce dict, la
        # mutation en place n'est donc qu'un choix de cohérence, pas une
        # nécessité stricte.
        self._noms_executants_reseau: dict[str, str] = {}
        # PATCH (correctif "plusieurs profils sur une instance") -- {id_executant:
        # {nom_profil: instance_id}}, câblé par ApplicationsScreen.definir_
        # instances_par_profil_reseau (même patron de mutation par réassignation
        # complète que côté ApplicationsScreen -- cf. sa docstring : dict(v) par
        # sous-dict, jamais la même référence que le registre source de
        # MainWindow). Alimente _repeupler_selecteur_cible pour lister UN
        # profil par ligne dans le groupe réseau, plutôt qu'une seule entrée
        # par sAutoniax qui masquerait les profils au-delà du premier.
        self._instances_par_profil_reseau: dict[str, dict[str, str]] = {}

        # AJOUT (SPEC_GLOBALE_AutoniaX.md, Partie C §3.1) -- mêmes rôles
        # que _instance_id_par_profil_local du panneau clone (cf. ligne
        # ~57479 et _associer_profils_actifs_locaux) -- reconstruit à
        # chaque instances_list reçu, pour permettre la resélection par
        # NOM de profil (cf. §2) au lieu du seul id_instance volatile.
        self._profils_locaux_connus: dict[str, str] = {}  # {nom_profil: chemin_dossier}
        self._instance_id_par_profil_local: dict[str, str] = {}  # {nom_profil: instance_id}, actifs seulement

        # --- Détection OpenCV dans un QThread séparé -- JAMAIS sur le
        # thread GUI (cf. DetectionWorker : rechercher_composant_multi_variantes
        # est un calcul CPU-intensif, plusieurs passes matchTemplate +
        # validation croisée ORB/SSIM par variante, incompatible avec un
        # appel direct depuis le slot de frame_recue). Un seul worker/thread
        # par onglet, démarré ici et arrêté dans arreter(). ---
        self._detection_thread = QThread(self)
        self._detection_worker = DetectionWorker()
        self._detection_worker.moveToThread(self._detection_thread)
        self._detection_worker.resultat_pret.connect(self._sur_resultat_detection)
        # PATCH (candidats multiples, écran de test UNIQUEMENT, cf.
        # rechercher_candidats_multiples) : connexion séparée -- ne
        # remplace ni ne modifie resultat_pret/_sur_resultat_detection
        # ci-dessus, purement additive.
        self._detection_worker.resultats_multiples_prets.connect(self._sur_resultats_multiples_detection)
        self._detection_thread.start()
        self._derniers_candidats_multiples: list = []

        # --- Détection layout (cL) OpenCV dans un QThread séparé -- MÊME
        # raison que ci-dessus pour cS (retour utilisateur explicite : "le
        # templatematching fait aussi geler l'app, je veux que tu essai de
        # mettre ces operations dans un wokers"), cf. docstring de
        # DetectionLayoutWorker. Thread DÉDIÉ, séparé de _detection_thread
        # (cS) -- même si un seul des deux tourne réellement selon
        # self._mode (fixé à la construction, jamais mélangé), garder deux
        # threads distincts évite tout couplage accidentel entre les deux
        # chemins de détection, et reste cohérent avec le principe "mode
        # fixé une fois pour toutes" déjà appliqué ailleurs dans cette
        # classe. ---
        self._detection_layout_thread = QThread(self)
        self._detection_layout_worker = DetectionLayoutWorker()
        self._detection_layout_worker.moveToThread(self._detection_layout_thread)
        self._detection_layout_worker.resultat_layout_pret.connect(self._sur_resultat_detection_layout)
        self._detection_layout_thread.start()

        # --- Lecture du fichier déposé (drag & drop) dans un QThread
        # séparé -- cf. docstring de LectureImageDrapeeWorker. ---
        self._lecture_image_thread = QThread(self)
        self._lecture_image_worker = LectureImageDrapeeWorker()
        self._lecture_image_worker.moveToThread(self._lecture_image_thread)
        self._lecture_image_worker.lecture_prete.connect(self._sur_lecture_image_deposee_prete)
        self._lecture_image_thread.start()
        # PATCH (retour utilisateur : "je ne vois meme pas de coloration
        # vert pour la detection") -- cause : avec le rafraîchissement
        # automatique actif (case_auto = On), chaque nouvelle frame du
        # flux, reçue quasi immédiatement après la fin de la détection
        # (_en_cours déjà False, _detection_en_vol déjà False -- cf.
        # _sur_nouvelle_frame), déclenchait un simple affichage BRUT
        # (_afficher_apercu_avec_resultat(image, None) sans overlay), qui
        # écrasait le rectangle vert/jaune avant même qu'il soit visible
        # à l'écran. self._dernier_overlay_affiche mémorise (resultat,
        # candidats) du DERNIER test effectué, pour que _sur_nouvelle_
        # frame puisse le redessiner sur chaque frame suivante tant
        # qu'aucun nouveau test n'a été relancé (cf. _demarrer_test, qui
        # le remet à None au moment précis où un nouveau test commence --
        # sans quoi l'ancien overlay resterait affiché à tort sur la
        # toute première frame du nouveau test, avant que son propre
        # résultat n'arrive)."""
        self._dernier_overlay_affiche: Optional[tuple] = None  # (resultat: dict|None, candidats: list|None)

        # AJOUT (retour utilisateur explicite : "en plus on va rajouter un
        # bouton: afficher les zones, sa vas dessiner les zones sur tout
        # les template trouver") -- mode cL uniquement. self._dernieres_
        # instances_layout mémorise la DERNIÈRE liste instances_qrect
        # calculée par _sur_capture_propre_pour_detection_layout (même
        # rôle que self._dernier_overlay_affiche côté cS ci-dessus, format
        # dédié ici puisque cL utilise déjà sa propre structure {englobant,
        # zones}), pour permettre au bouton "Afficher les zones" de
        # rebasculer l'affichage SANS relancer une détection. self._
        # afficher_zones_layout est l'état du toggle -- True par défaut
        # (les Zones étaient déjà dessinées systématiquement avant ce
        # bouton, cf. _afficher_apercu_layout_avec_instances plus bas : on
        # ne change pas le comportement par défaut, juste la possibilité
        # de le désactiver pour ne voir que les englobants verts).
        self._dernieres_instances_layout: list = []
        self._afficher_zones_layout: bool = True

        # PATCH (demande explicite utilisateur : remplacer la colonne de
        # droite "Contrôles" de PanneauRenduInstance par le panneau de
        # réglages du composant sélectionné, cf. ComposantReglagesNumeriques
        # Panel plus haut dans le fichier) -- self._panneau_rendu.colonne_
        # reglages (130px, Rafraîchir/Mode/Taux/Rafraîchissement auto/
        # Onglet) N'A PLUS SA PLACE sur cet écran : le bouton Rafraîchir en
        # a déjà été extrait ci-dessus (cf. action_layout.addWidget(self.
        # rafraichir_button) plus bas), donc il ne reste dans cette colonne
        # que des contrôles sans usage pour Test de composant (Mode/Taux/
        # Rafraîchissement auto/Onglet navigateur -- cet écran capture sur
        # demande via rafraichir_button, pas en flux continu). On la
        # masque et on la retire de _corps_layout plutôt que de la vider
        # widget par widget (elle reste intacte, juste inutilisée, pour ne
        # rien casser sur les autres écrans qui, eux, continuent à utiliser
        # PanneauRenduInstance telle quelle). Précédent direct pour l'accès
        # à _corps_layout depuis l'extérieur de PanneauRenduInstance : cf.
        # l'overlay flottant ligne ~35822 (self.panneau._corps_layout.
        # removeWidget(colonne_reglages)) -- même patron, en plus simple
        # ici puisqu'il n'y a pas de remise en place à prévoir : le
        # remplacement est définitif pour cet écran.
        self._panneau_rendu.colonne_reglages.setVisible(False)
        self._panneau_rendu._corps_layout.removeWidget(self._panneau_rendu.colonne_reglages)
        # REFONTE (mode composant_layout) : self._mode est fixé une fois
        # pour toutes à la construction de cet écran (jamais changé en
        # cours de vie de l'onglet, cf. docstring de la classe) -- donc le
        # bon panneau (ComposantReglagesNumeriquesPanel pour cS,
        # ComposantLayoutReglagesNumeriquesPanel pour cL, cf. sa docstring
        # "pendant EXACT de ComposantReglagesNumeriquesPanel... pour le
        # mode cL") est choisi une seule fois ici, jamais recréé ensuite.
        # self._panneau_reglages_composant reste le nom générique utilisé
        # partout ailleurs dans cette classe (_on_composant_changed, etc.)
        # -- seul CE branchement dépend du mode.
        if self._mode == self.MODE_COMPOSANT_LAYOUT:
            self._panneau_reglages_composant = ComposantLayoutReglagesNumeriquesPanel(self._contenu)
        else:
            self._panneau_reglages_composant = ComposantReglagesNumeriquesPanel(self._contenu)
            # AJOUT (demande explicite utilisateur : "sa ne doit plus
            # tester tout dun coup, il faut que sa teste juste la
            # variante qui a ete selectionner") -- sans cette connexion,
            # self._templates_bgr restait toujours celui construit par
            # _on_composant_changed (TOUTES les variantes, cf. sa
            # docstring/charger_templates_bgr), même après que
            # l'utilisateur change de variante dans ce panneau : le test
            # revenait donc toujours au comportement "n'importe quelle
            # variante peut matcher", jamais celui de LA variante
            # affichée/réglée à l'écran.
            self._panneau_reglages_composant.variante_selection_changee.connect(
                self._on_variante_panneau_changee
            )
        self._panneau_reglages_composant.project = self.project
        self._panneau_rendu._corps_layout.addWidget(self._panneau_reglages_composant)

        # PATCH (retour utilisateur : "lorsque je utilise test de
        # composant, et que je quitte, sa doit sauvegardez le profils
        # que jutilisait ... mais sil cest fermer avant que sa ne doit
        # pas selectionner de profils") -- cf. docstring de
        # ReglagesApp.dernier_profil_test_reseau. True dès qu'un test a
        # RÉELLEMENT été lancé au moins une fois sur cet écran (cf.
        # _demarrer_test), jamais remis à False ensuite -- arreter() ne
        # sauvegarde le profil réseau courant dans les Réglages QUE si ce
        # flag est True, pour respecter exactement la consigne : ouvrir
        # l'onglet puis le refermer sans jamais cliquer "Démarrer le
        # test" ne doit RIEN changer à l'ancien profil déjà sauvegardé.
        self._test_a_ete_lance = False

        # --- Widgets propres à cet écran, insérés dans layout_reglages
        # (fourni par InstanceApercuScreen) AU-DESSUS du bloc
        # instance/rafraîchissement déjà en place -- cf. insertWidget/
        # insertLayout à index croissant pour les empiler dans l'ordre
        # voulu tout en haut du panneau. ---
        index_insertion = 0

        titre = QLabel("TEST DE COMPOSANT", self._colonne_gauche)
        titre.setObjectName("ReglagesPanelTitle")
        titre.setWordWrap(True)  # cf. _section_label -- même correctif de débordement
        self.layout_reglages.insertWidget(index_insertion, titre)
        index_insertion += 1

        if not VISION_DISPONIBLE:
            avertissement = QLabel(
                "cv2/numpy introuvables sur cette machine : la reconnaissance "
                "visuelle est indisponible. Installez opencv-python et numpy "
                "pour utiliser le test de composant.",
                self._colonne_gauche,
            )
            avertissement.setWordWrap(True)
            avertissement.setStyleSheet(f"color: {Mocha.red};")
            self.layout_reglages.insertWidget(index_insertion, avertissement)
            index_insertion += 1
        elif not RESEAU_DASHBOARD_DISPONIBLE:
            avertissement = QLabel(
                "Module 'websockets' non installé -- le test de composant "
                "nécessite une connexion au serveur central (même dépendance "
                "que le Dashboard).",
                self._colonne_gauche,
            )
            avertissement.setWordWrap(True)
            avertissement.setStyleSheet(f"color: {Mocha.red};")
            self.layout_reglages.insertWidget(index_insertion, avertissement)
            index_insertion += 1

        # --- Composant à tester (libellé adapté au mode -- REFONTE) ---
        libelle_a_tester = "COMPOSANT LAYOUT À TESTER" if self._mode == self.MODE_COMPOSANT_LAYOUT else "COMPOSANT À TESTER"
        self.layout_reglages.insertWidget(index_insertion, self._section_label(libelle_a_tester))
        index_insertion += 1
        self.composant_combo = QComboBox(self._colonne_gauche)
        self.composant_combo.setObjectName("ReglagesCombo")
        self.composant_combo.currentIndexChanged.connect(self._on_composant_changed)
        self.layout_reglages.insertWidget(index_insertion, self.composant_combo)
        index_insertion += 1

        # --- Action à exécuter si détecté (placée ici, AU-DESSUS du bloc
        # instance cible hérité -- ordre conservé identique à avant la
        # migration : composant, puis instance, puis action, cf. bloc
        # ci-dessous inséré juste après le bloc instance/rafraîchissement
        # de la classe de base) ---
        #
        # REFONTE (mode composant_layout, demande explicite utilisateur :
        # "ce bouton doit être désactivé, tout ce qu'on doit faire lorsque
        # c'est détecté et bien c'est juste entourer les éléments à
        # l'écran, entourer avec les zones") -- self._widget_action
        # (section "ACTION SI DÉTECTÉ" + tous ses sous-paramètres) N'A DE
        # SENS QUE POUR cS (une action réseau à exécuter sur la cible
        # détectée) : masqué en bloc en mode MODE_COMPOSANT_LAYOUT (cf.
        # fin du __init__), jamais retiré/détruit pour ne rien casser côté
        # cS. Le bloc "TEST" (rafraîchir/Démarrer/statut) est maintenant
        # un widget SÉPARÉ (self._widget_test_demarrage), commun aux deux
        # modes -- lui reste TOUJOURS visible, seule la détection change
        # de comportement au clic (cf. _sur_capture_propre_pour_detection).
        self._widget_action = QWidget(self._colonne_gauche)
        action_layout = QVBoxLayout(self._widget_action)
        action_layout.setContentsMargins(0, 0, 0, 0)
        action_layout.setSpacing(12)
        action_layout.addWidget(self._section_label("ACTION SI DÉTECTÉ"))
        self.action_combo = QComboBox(self._colonne_gauche)
        self.action_combo.setObjectName("ReglagesCombo")
        for valeur in ACTIONS_TEST:
            self.action_combo.addItem(LABELS_ACTION_TEST[valeur], valeur)
        self.action_combo.currentIndexChanged.connect(self._on_action_changed)
        action_layout.addWidget(self.action_combo)

        # --- Paramètres "Positionner / Clic gauche / Clic droit / Double-clic" ---
        # Vitesse de positionnement = durée du trajet curseur -> cible,
        # depuis un point de départ aléatoire dans la fenêtre (comportement
        # moins mécanique qu'un saut instantané).
        self.deplacement_options = QWidget(self._colonne_gauche)
        deplacement_layout = QVBoxLayout(self.deplacement_options)
        deplacement_layout.setContentsMargins(0, 0, 0, 0)
        deplacement_layout.setSpacing(6)
        deplacement_layout.addWidget(self._section_label("VITESSE DE POSITIONNEMENT"))
        self.duree_deplacement_spin = QSpinBox(self._colonne_gauche)
        self.duree_deplacement_spin.setObjectName("ReglagesSpin")
        self.duree_deplacement_spin.setRange(0, 5000)
        self.duree_deplacement_spin.setSingleStep(50)
        self.duree_deplacement_spin.setValue(150)
        self.duree_deplacement_spin.setSuffix(" ms")
        deplacement_layout.addWidget(self.duree_deplacement_spin)
        action_layout.addWidget(self.deplacement_options)

        # --- Paramètres propres aux clics (durée d'appui) ---
        self.clic_options = QWidget(self._colonne_gauche)
        clic_layout = QVBoxLayout(self.clic_options)
        clic_layout.setContentsMargins(0, 0, 0, 0)
        clic_layout.setSpacing(6)
        clic_layout.addWidget(self._section_label("DURÉE DU CLIC"))
        self.duree_clic_spin = QSpinBox(self._colonne_gauche)
        self.duree_clic_spin.setObjectName("ReglagesSpin")
        self.duree_clic_spin.setRange(0, 2000)
        self.duree_clic_spin.setSingleStep(10)
        self.duree_clic_spin.setValue(60)
        self.duree_clic_spin.setSuffix(" ms")
        clic_layout.addWidget(self.duree_clic_spin)
        action_layout.addWidget(self.clic_options)

        # --- Paramètres "Scroller" ---
        self.scroll_options = QWidget(self._colonne_gauche)
        scroll_options_layout = QVBoxLayout(self.scroll_options)
        scroll_options_layout.setContentsMargins(0, 0, 0, 0)
        scroll_options_layout.setSpacing(6)
        ligne_scroll_1 = QHBoxLayout()
        ligne_scroll_1.setSpacing(6)
        self.scroll_direction_combo = QComboBox(self._colonne_gauche)
        self.scroll_direction_combo.setObjectName("ReglagesCombo")
        self.scroll_direction_combo.addItem("Vers le bas", -1)
        self.scroll_direction_combo.addItem("Vers le haut", 1)
        ligne_scroll_1.addWidget(self.scroll_direction_combo, 1)
        self.scroll_quantite_spin = QSpinBox(self._colonne_gauche)
        self.scroll_quantite_spin.setObjectName("ReglagesSpin")
        self.scroll_quantite_spin.setRange(1, 50)
        self.scroll_quantite_spin.setValue(3)
        self.scroll_quantite_spin.setSuffix(" cran(s)")
        ligne_scroll_1.addWidget(self.scroll_quantite_spin, 1)
        scroll_options_layout.addLayout(ligne_scroll_1)
        scroll_options_layout.addWidget(self._section_label("VITESSE DE SCROLL"))
        self.scroll_frequence_spin = QDoubleSpinBox(self._colonne_gauche)
        self.scroll_frequence_spin.setObjectName("ReglagesSpin")
        self.scroll_frequence_spin.setRange(0.5, 30.0)
        self.scroll_frequence_spin.setSingleStep(0.5)
        self.scroll_frequence_spin.setValue(5.0)
        self.scroll_frequence_spin.setSuffix(" cran(s)/s")
        scroll_options_layout.addWidget(self.scroll_frequence_spin)
        action_layout.addWidget(self.scroll_options)
        self.scroll_options.setVisible(False)

        # --- Paramètres "Saisir du texte" ---
        # Note (cf. SequenceurActionReseau._lancer_saisie) : la saisie est
        # désormais envoyée en UNE SEULE commande type_text -- l'instance
        # gère la boucle caractère par caractère et les délais en interne
        # (décision actée). Les réglages ci-dessous restent inchangés côté
        # UI, seule la mécanique d'exécution change.
        self.saisir_options = QWidget(self._colonne_gauche)
        saisir_layout = QVBoxLayout(self.saisir_options)
        saisir_layout.setContentsMargins(0, 0, 0, 0)
        saisir_layout.setSpacing(6)
        saisir_layout.addWidget(self._section_label("TEXTE À SAISIR"))
        self.saisir_texte_edit = QLineEdit(self._colonne_gauche)
        self.saisir_texte_edit.setObjectName("ReglagesLineEdit")
        self.saisir_texte_edit.setPlaceholderText("Texte à envoyer caractère par caractère…")
        saisir_layout.addWidget(self.saisir_texte_edit)
        saisir_layout.addWidget(self._section_label("DÉLAI ENTRE CARACTÈRES"))
        ligne_delai = QHBoxLayout()
        ligne_delai.setSpacing(6)
        self.delai_min_spin = QSpinBox(self._colonne_gauche)
        self.delai_min_spin.setObjectName("ReglagesSpin")
        self.delai_min_spin.setRange(0, 3000)
        self.delai_min_spin.setSingleStep(10)
        self.delai_min_spin.setValue(60)
        self.delai_min_spin.setSuffix(" ms")
        ligne_delai.addWidget(self.delai_min_spin, 1)
        label_a = QLabel("à", self._colonne_gauche)
        label_a.setAlignment(Qt.AlignCenter)
        label_a.setFixedWidth(16)
        ligne_delai.addWidget(label_a)
        self.delai_max_spin = QSpinBox(self._colonne_gauche)
        self.delai_max_spin.setObjectName("ReglagesSpin")
        self.delai_max_spin.setRange(0, 3000)
        self.delai_max_spin.setSingleStep(10)
        self.delai_max_spin.setValue(180)
        self.delai_max_spin.setSuffix(" ms")
        ligne_delai.addWidget(self.delai_max_spin, 1)
        saisir_layout.addLayout(ligne_delai)
        action_layout.addWidget(self.saisir_options)
        self.saisir_options.setVisible(False)

        # --- Démarrer/arrêter le test ---
        # REFONTE (mode composant_layout) : ce bloc ("TEST" -- rafraîchir/
        # Démarrer/statut) est désormais un widget SÉPARÉ de _widget_action
        # (cf. commentaire à sa construction ci-dessus), ajouté APRÈS lui
        # dans layout_reglages -- reste TOUJOURS visible, y compris quand
        # _widget_action est masqué en mode cL (Démarrer le test reste le
        # déclencheur de la détection dans les deux modes, seule l'action
        # exécutée en résultat diffère : _executer_action pour cS, simple
        # entourage des Zones pour cL, cf. _sur_capture_propre_pour_
        # detection).
        # PATCH (demande explicite utilisateur : remplacer la colonne de
        # droite "Contrôles" par le panneau de réglages du composant --
        # cf. definir_composant plus bas) -- le bouton "Rafraîchir"
        # (capture ponctuelle) est le SEUL élément de cette ancienne
        # colonne conservé pour cet écran, déplacé ici juste au-dessus de
        # "Démarrer le test" : réponse explicite utilisateur ("tu vas
        # juste mettre le bouton de rafraichissement en haut du bouton de
        # démarrer test"). self.rafraichir_button est le MÊME widget déjà
        # construit par InstanceApercuScreen.__init__ (super().__init__()
        # ci-dessus, cf. self._panneau_rendu.rafraichir_button) -- un
        # widget Qt ne pouvant appartenir qu'à UN SEUL layout à la fois,
        # cet addWidget() le retire automatiquement de layout_colonne_
        # reglages (PanneauRenduInstance) où il vivait, sans qu'il faille
        # de removeWidget() explicite. Le reste de l'ancienne colonne
        # (Mode/Taux/Rafraîchissement auto/Onglet navigateur) N'EST PAS
        # repris ici -- cf. _remplacer_colonne_reglages_par_composant plus
        # bas, qui masque tout le reste de _panneau_rendu.colonne_reglages
        # d'un coup plutôt que de le vider widget par widget.
        self._widget_test_demarrage = QWidget(self._colonne_gauche)
        test_demarrage_layout = QVBoxLayout(self._widget_test_demarrage)
        test_demarrage_layout.setContentsMargins(0, 0, 0, 0)
        test_demarrage_layout.setSpacing(12)
        test_demarrage_layout.addWidget(self.rafraichir_button)
        test_demarrage_layout.addWidget(self._section_label("TEST"))
        self.demarrer_button = QPushButton(
            qta.icon("mdi6.play", color=Mocha.text), " Démarrer le test", self._colonne_gauche
        )
        self.demarrer_button.setObjectName("UpdateImageButton")
        self.demarrer_button.setCursor(Qt.PointingHandCursor)
        self.demarrer_button.clicked.connect(self._toggle_test)
        self.demarrer_button.setEnabled(False)  # activé une fois composant + instance valides (cf. _rafraichir_disponibilite_demarrer)
        # AJOUT (retour utilisateur : "en cS c'est nettement un peu plus
        # grand en hauteur") -- hauteur minimale explicite, le padding
        # QSS seul (#UpdateImageButton, 9px 14px) ne suffisant pas à
        # garantir la même hauteur perçue que sur les autres écrans.
        self.demarrer_button.setMinimumHeight(40)
        test_demarrage_layout.addWidget(self.demarrer_button)

        # AJOUT (retour utilisateur explicite : "en plus on va rajouter un
        # bouton: affihcier les zone, sa vas dessisner les zonne sur tout
        # les template trouver") -- mode cL uniquement (masqué en bloc
        # avec _widget_action ci-dessous n'aurait pas de sens ici puisque
        # ce bouton, lui, doit apparaître UNIQUEMENT en cL -- donc
        # setVisible(False) posé explicitement, comme _widget_action, dans
        # le même bloc "if self._mode == MODE_COMPOSANT_LAYOUT" plus bas).
        # Toggle (pas une action ponctuelle) : coché par défaut puisque
        # les Zones sont déjà dessinées par défaut sur chaque instance
        # détectée (cf. _afficher_apercu_layout_avec_instances) -- ce
        # bouton permet de les MASQUER pour ne voir que les englobants
        # verts, aussi bien que de les réafficher, sans jamais relancer
        # une détection (cf. self._dernieres_instances_layout).
        self.afficher_zones_button = QPushButton(
            qta.icon("mdi6.vector-square", color=Mocha.text), " Afficher les zones", self._colonne_gauche
        )
        self.afficher_zones_button.setObjectName("ReglagesButton")
        self.afficher_zones_button.setCursor(Qt.PointingHandCursor)
        self.afficher_zones_button.setCheckable(True)
        self.afficher_zones_button.setChecked(self._afficher_zones_layout)
        self.afficher_zones_button.toggled.connect(self._on_toggle_afficher_zones_layout)
        test_demarrage_layout.addWidget(self.afficher_zones_button)

        self.statut_label = QLabel("Sélectionnez un composant à tester.", self._colonne_gauche)
        self.statut_label.setWordWrap(True)
        self.statut_label.setStyleSheet(f"color: {Mocha.subtext0};")
        test_demarrage_layout.addWidget(self.statut_label)

        # Bloc "action" (masqué en bloc en mode cL, cf. fin du __init__)
        # puis bloc "TEST" (toujours visible) -- insérés APRÈS le bloc
        # instance/rafraîchissement hérité (qui occupe déjà layout_
        # reglages à cet index) -- donc à la fin du layout, pas à
        # index_insertion (les widgets composant/titre ci-dessus, eux,
        # sont bien tout en haut via insertWidget croissant).
        self.layout_reglages.addWidget(self._widget_action)
        self.layout_reglages.addWidget(self._widget_test_demarrage)
        self.layout_reglages.addStretch(1)

        # REFONTE (mode composant_layout) : masque le bloc "ACTION SI
        # DÉTECTÉ" en bloc pour cL -- aucune action à exécuter, cf.
        # docstring à la construction de _widget_action ci-dessus. Posé
        # ICI, une seule fois, APRÈS que tous les widgets référencés
        # existent (action_combo, demarrer_button, etc.).
        if self._mode == self.MODE_COMPOSANT_LAYOUT:
            self._widget_action.setVisible(False)
        else:
            self.afficher_zones_button.setVisible(False)

        # En plus du hook _changement_instance_post (qui ne s'exécute que
        # si l'instance change RÉELLEMENT, cf. InstanceApercuScreen._on_instance_changed) :
        # couvre le cas où l'instance sélectionnée reste la même (ex: juste
        # après _sur_liste_instances_recue) -- l'ancien code rafraîchissait
        # la disponibilité du bouton dans tous les cas, pas seulement au
        # changement réel.
        self.instance_combo.currentIndexChanged.connect(lambda _index: self._rafraichir_disponibilite_demarrer())

        self.rafraichir_liste_composants()
        self._on_action_changed(self.action_combo.currentIndex())
        self.demarrer_reseau()

        # REFONTE (mode composant_layout) : substitution de apercu_label
        # par ApercuLayoutLabel, EN PLACE, sur _droite_layout -- MÊME
        # protocole que CoordonneeActionScreen.__init__ (cf. son
        # commentaire détaillé : "droite_layout ne gère QUE apercu_label",
        # "toute réassignation de self.apercu_label par une sous-classe
        # doit AUSSI mettre à jour self._panneau_rendu.apercu_label").
        # Nécessaire ici pour réutiliser MODE_INSTANCES (entourage des
        # Zones détectées, cf. _lancer_detection_layout_et_afficher) --
        # un QLabel simple (apercu_label par défaut, mode cS) ne sait pas
        # dessiner cet overlay lui-même. Posé en tout dernier dans
        # __init__, une fois tous les autres widgets/connexions en place.
        if self._mode == self.MODE_COMPOSANT_LAYOUT:
            # CORRECTIF (bug rapporté : "la zone d'affichage ne s'affiche
            # pas bien" -- image compressée tout en bas, gros espace vide
            # au-dessus) -- MÊME diagnostic que le correctif déjà présent
            # dans ComposantLayoutConfigScreen.__init__ (cf. son
            # commentaire : "l'apercu_label par défaut ne vit pas
            # directement dans _droite_layout mais DEDANS apercu_scroll
            # (QScrollArea.setWidget) -- un removeWidget sur _droite_layout
            # était donc un no-op muet") : ancien_label ICI est le QLabel
            # lui-même, jamais un enfant DIRECT de _droite_layout (c'est
            # apercu_scroll, le QScrollArea qui le contient, qui y est
            # posé -- cf. PanneauRenduInstance.__init__,
            # droite_layout.addWidget(self.apercu_scroll, 1)). L'ancien
            # code ci-dessous (indexOf/removeWidget sur ancien_label)
            # ne faisait donc RIEN : apercu_scroll restait dans
            # _droite_layout, vide mais toujours avec sa taille minimale
            # (320, 200) et sa SizePolicy Expanding, à se partager
            # l'espace vertical avec le nouveau apercu_layout_label
            # inséré juste à côté (à l'index -1, faute d'avoir trouvé
            # ancien_label -> ajouté en FIN de layout plutôt qu'à la
            # place de l'ancien) -- exactement le symptôme observé.
            #
            # Fix : takeWidget() retire proprement apercu_label de son
            # VRAI parent (apercu_scroll), PUIS apercu_scroll lui-même
            # est retiré de _droite_layout et masqué (jamais détruit :
            # c'est un attribut public de PanneauRenduInstance, partagé
            # avec d'autres écrans -- seul TestComposantScreen n'en a
            # plus besoin en mode cL, cf. même prudence que le correctif
            # cité ci-dessus). apercu_layout_label est alors le SEUL
            # widget de _droite_layout, sur tout l'espace disponible.
            ancien_label = self.apercu_label
            self._panneau_rendu.apercu_scroll.takeWidget()
            self._droite_layout.removeWidget(self._panneau_rendu.apercu_scroll)
            self._panneau_rendu.apercu_scroll.setVisible(False)
            ancien_label.setParent(None)
            ancien_label.deleteLater()

            # CORRECTIF (retour utilisateur : "pourquoi tu ne veux pas
            # reprendre exactement le même process que le mode cS" --
            # ApercuLayoutLabel avait un paintEvent ENTIÈREMENT Python,
            # redessiné par Qt à chaque DragMove pendant le survol d'un
            # drag externe -- freeze net observé UNIQUEMENT en mode cL,
            # jamais en cS où apercu_label est un QLabel natif sans
            # paintEvent custom, cf. LabelApercuRedimensionnable, aucun
            # coût Python déclenché par le survol). Fix définitif : cL
            # utilise maintenant EXACTEMENT le même widget que cS
            # (LabelApercuRedimensionnable, QLabel pur -- rendu du pixmap
            # entièrement géré par Qt en natif), posé dans un QScrollArea
            # identique (mêmes réglages que PanneauRenduInstance.
            # apercu_scroll : setWidgetResizable(False), scrollbars à la
            # demande -- dimension réelle avec défilement). Les
            # rectangles d'instances/Zone détectées (ex-MODE_INSTANCES de
            # ApercuLayoutLabel) sont maintenant peints UNE FOIS
            # directement DANS le pixmap via QPainter, cf.
            # _afficher_apercu_layout_avec_instances -- même procédé déjà
            # utilisé par _afficher_apercu_avec_resultat en mode cS, pas
            # un paintEvent réévalué à chaque repaint.
            self.apercu_layout_label = LabelApercuRedimensionnable(None)
            self.apercu_layout_label.setObjectName("ComposantTuileImageFrame")
            self.apercu_layout_label.setAlignment(Qt.AlignCenter)

            self._apercu_layout_scroll = QScrollArea(self._colonne_droite)
            self._apercu_layout_scroll.setObjectName("ApercuScrollArea")
            self._apercu_layout_scroll.setFrameShape(QFrame.NoFrame)
            self._apercu_layout_scroll.setWidgetResizable(False)
            self._apercu_layout_scroll.setHorizontalScrollBarPolicy(Qt.ScrollBarAsNeeded)
            self._apercu_layout_scroll.setVerticalScrollBarPolicy(Qt.ScrollBarAsNeeded)
            self._apercu_layout_scroll.setWidget(self.apercu_layout_label)
            self._apercu_layout_scroll.setMinimumSize(320, 200)
            self._apercu_layout_scroll.setSizePolicy(QSizePolicy.Expanding, QSizePolicy.Expanding)
            self._droite_layout.addWidget(self._apercu_layout_scroll, 1)

            self.apercu_label = self.apercu_layout_label
            self._panneau_rendu.apercu_label = self.apercu_layout_label
            self.apercu_layout_label.redimensionne.connect(self._sur_redimensionnement_apercu)
            # Dernière image reçue (QImage brute, SANS overlay) -- gardée
            # pour repeindre les rectangles si besoin (même rôle que
            # self._image_en_cours_analyse pour cS, mais nom dédié : cL
            # n'utilise jamais _image_en_cours_analyse, cf. _sur_capture_
            # propre_pour_detection_layout qui le met explicitement à
            # None dès l'entrée).
            self._derniere_image_layout: Optional[QImage] = None

            # AJOUT (demande explicite utilisateur, capture_001.png à
            # l'appui : "tu dois mettre cette navigation en haut de
            # l'image, sur la même ligne que le nom du profil") -- flèches
            # ‹ › pour rejouer les images de test sauvegardées pour ce cL
            # (cf. ComposantLayoutConfigScreen._construire_sous_onglet_
            # donnees_test / get_composant_layout_tests_dir, même stockage
            # sur disque -- ces deux écrans sont reliés par ce seul
            # dossier, aucun état dupliqué entre eux). Construite ICI
            # (mode cL uniquement -- n'a aucun sens en MODE_COMPOSANT, qui
            # n'a pas de notion d'images de test) et posée dans
            # self.layout_ligne_profil (cf. son AJOUT en attribut public
            # dans InstanceApercuScreen.__init__), ENTRE profil_label
            # (stretch=1, garde tout l'espace) et bouton_drag_capture --
            # donc sur la même ligne que "Profil actif : ...", à gauche du
            # bouton de drag déjà présent là.
            #
            # Masquée en bloc par défaut (cf. _rafraichir_navigation_
            # images_test, appelée juste après la construction ci-dessous
            # ET à chaque changement de ComposantLayout sélectionné, cf.
            # _on_composant_changed) -- demande explicite : "uniquement si
            # des images de test existent pour ce cL sinon rien de
            # nouveau", jamais affichée pour un cL sans aucune image de
            # test enregistrée.
            self._images_test_courantes: list = []  # list[Path], cf. _rafraichir_navigation_images_test
            self._index_image_test: int = -1  # -1 = aucune image test actuellement affichée/rejouée

            self._widget_nav_images_test = QWidget(self)
            nav_layout = QHBoxLayout(self._widget_nav_images_test)
            nav_layout.setContentsMargins(0, 0, 0, 0)
            nav_layout.setSpacing(2)

            self._bouton_image_test_precedente = QToolButton(self._widget_nav_images_test)
            self._bouton_image_test_precedente.setIcon(qta.icon("mdi6.chevron-left", color=Mocha.subtext0))
            self._bouton_image_test_precedente.setToolTip("Image de test précédente")
            self._bouton_image_test_precedente.setCursor(Qt.PointingHandCursor)
            self._bouton_image_test_precedente.setAutoRaise(True)
            self._bouton_image_test_precedente.clicked.connect(lambda: self._naviguer_image_test(-1))
            nav_layout.addWidget(self._bouton_image_test_precedente)

            self._label_index_image_test = QLabel("", self._widget_nav_images_test)
            self._label_index_image_test.setObjectName("ReglagesHintLabel")
            self._label_index_image_test.setAlignment(Qt.AlignCenter)
            nav_layout.addWidget(self._label_index_image_test)

            self._bouton_image_test_suivante = QToolButton(self._widget_nav_images_test)
            self._bouton_image_test_suivante.setIcon(qta.icon("mdi6.chevron-right", color=Mocha.subtext0))
            self._bouton_image_test_suivante.setToolTip("Image de test suivante")
            self._bouton_image_test_suivante.setCursor(Qt.PointingHandCursor)
            self._bouton_image_test_suivante.setAutoRaise(True)
            self._bouton_image_test_suivante.clicked.connect(lambda: self._naviguer_image_test(1))
            nav_layout.addWidget(self._bouton_image_test_suivante)

            # Inséré à l'index juste avant bouton_drag_capture (déjà posé
            # en dernier dans layout_ligne_profil, cf. InstanceApercuScreen.
            # __init__) -- insertWidget plutôt qu'addWidget : addWidget
            # l'aurait mis APRÈS bouton_drag_capture, à l'extrême droite,
            # alors que la capture montre la navigation directement à
            # gauche de ce bouton.
            index_insertion = self.layout_ligne_profil.indexOf(self.bouton_drag_capture)
            if index_insertion < 0:
                index_insertion = self.layout_ligne_profil.count()
            self.layout_ligne_profil.insertWidget(index_insertion, self._widget_nav_images_test, 0, Qt.AlignVCenter)

            self._rafraichir_navigation_images_test()



        # AJOUT (retour utilisateur : "si on fait un drag d'image sur
        # l'interface de rendu, ça devient l'image sur laquelle on va
        # rechercher le composant") -- glisser-déposer un fichier image
        # depuis l'extérieur (explorateur de fichiers, navigateur...)
        # DIRECTEMENT sur apercu_label lance la détection SUR CETTE IMAGE,
        # à la place d'une capture réseau -- même point d'entrée que le
        # test normal (_sur_capture_propre_pour_detection, cf. son
        # docstring), donc AUCUNE différence de traitement en aval une
        # fois l'image décodée (mode cS -> DetectionWorker, mode cL ->
        # detecter_toutes_instances_composant_layout).
        #
        # eventFilter posé depuis l'extérieur, PAS de sous-classe dédiée
        # (même choix déjà fait pour le contrôle à distance sur
        # apercu_label, cf. docstring du bloc equivalent dans
        # FenetreRenduTaskReseau plus bas dans ce fichier : "on ne modifie
        # JAMAIS le pixmap affiché, seulement la CAPTURE d'événements") --
        # posé ICI, APRÈS la substitution éventuelle en ApercuLayoutLabel
        # ci-dessus, pour toujours cibler le widget RÉELLEMENT affiché,
        # quel que soit le mode. self.apercu_label est toujours à jour à
        # ce point de __init__ (dernier bloc avant la fin du constructeur).
        self.apercu_label.setAcceptDrops(True)
        self.apercu_label.installEventFilter(self)

        # CORRECTIF (retour utilisateur : "le drag ne fonctionne pas
        # quand je m'en vais tester un composant single") -- en
        # MODE_COMPOSANT, apercu_label reste un LabelApercuRedimensionnable
        # posé DEDANS self._panneau_rendu.apercu_scroll (un QScrollArea,
        # cf. PanneauRenduInstance.__init__ : apercu_scroll.setWidget
        # (apercu_label)), jamais substitué -- MÊME piège déjà documenté
        # ailleurs dans ce fichier pour la molette (cf. eventFilter plus
        # bas dans FenetreRenduTaskReseau : "c'est le VIEWPORT qui reçoit
        # réellement... pas apercu_label lui-même") : le QScrollArea/son
        # viewport peut intercepter DragEnter/Drop avant qu'ils
        # n'atteignent le widget enfant, qui ne les recevait donc jamais
        # en mode cS. En MODE_COMPOSANT_LAYOUT, apercu_scroll est masqué
        # (cf. bloc de substitution ci-dessus) -- ce branchement
        # supplémentaire y reste inoffensif (viewport masqué ne reçoit
        # plus aucun événement utilisateur), donc posé ici de façon
        # INCONDITIONNELLE plutôt que de dupliquer ce bloc dans un if.
        self._panneau_rendu.apercu_scroll.setAcceptDrops(True)
        self._panneau_rendu.apercu_scroll.installEventFilter(self)
        self._panneau_rendu.apercu_scroll.viewport().setAcceptDrops(True)
        self._panneau_rendu.apercu_scroll.viewport().installEventFilter(self)

        # AJOUT (même piège QScrollArea/viewport que ci-dessus, cf.
        # commentaire détaillé juste au-dessus -- retour utilisateur :
        # "pourquoi c'est pas identique" en mode cL) -- _apercu_layout_
        # scroll n'existe QU'en MODE_COMPOSANT_LAYOUT (cf. bloc de
        # substitution plus haut, qui remplace l'ancien montage "label nu
        # dans _droite_layout" par ce QScrollArea dédié) : sans ce
        # branchement, le drop viserait bien self.apercu_label (posé
        # ci-dessus), mais le QScrollArea/son viewport qui l'entoure
        # désormais pourrait intercepter DragEnter/Drop en premier sans
        # les relayer, exactement comme pour apercu_scroll en mode cS
        # avant son propre correctif.
        if hasattr(self, "_apercu_layout_scroll"):
            self._apercu_layout_scroll.setAcceptDrops(True)
            self._apercu_layout_scroll.installEventFilter(self)
            self._apercu_layout_scroll.viewport().setAcceptDrops(True)
            self._apercu_layout_scroll.viewport().installEventFilter(self)

    def _entite_testee(self):
        """REFONTE (mode composant_layout) -- retourne l'entité actuellement
        sélectionnée dans self.composant_combo, quel que soit son type réel
        (Composant en MODE_COMPOSANT, ComposantLayout en MODE_COMPOSANT_
        LAYOUT). Centralise ce choix pour tout code générique (factory de
        drag ci-dessus, etc.) qui n'a pas besoin de connaître le mode
        courant pour fonctionner."""
        return self.composant_layout if self._mode == self.MODE_COMPOSANT_LAYOUT else self.composant

    def _rafraichir_navigation_images_test(self):
        """Recharge self._images_test_courantes depuis le contenu RÉEL du
        dossier disque (get_composant_layout_tests_dir -- même source de
        vérité que ComposantLayoutConfigScreen._rafraichir_liste_donnees_
        test, aucun état dupliqué entre les deux écrans), puis affiche ou
        masque en bloc self._widget_nav_images_test.

        Appelée à la construction (cf. __init__) ET à chaque changement
        de ComposantLayout sélectionné dans le combo (cf. _on_composant_
        changed) -- la liste doit toujours refléter le cL ACTUELLEMENT
        sélectionné, jamais celui d'avant.

        N'existe qu'en MODE_COMPOSANT_LAYOUT (self._widget_nav_images_test
        n'est construit que dans ce mode, cf. __init__) -- appelée
        uniquement depuis du code déjà propre à ce mode, mais hasattr par
        prudence si jamais appelée plus tôt dans __init__ que prévu.

        Demande explicite : "uniquement si des images de test existent
        pour ce cL sinon rien de nouveau" -- masquée en bloc dès que la
        liste est vide ou qu'aucun ComposantLayout n'est sélectionné,
        plutôt que affichée avec des flèches désactivées."""
        if not hasattr(self, "_widget_nav_images_test"):
            return
        if self.composant_layout is None:
            self._images_test_courantes = []
            self._index_image_test = -1
            self._widget_nav_images_test.setVisible(False)
            return
        dossier = get_composant_layout_tests_dir(self.composant_layout)
        self._images_test_courantes = sorted(
            [p for p in dossier.iterdir() if p.is_file() and p.suffix.lower() in EXTENSIONS_IMAGE_ACCEPTEES],
            key=lambda p: p.name.lower(),
        )
        if not self._images_test_courantes:
            self._index_image_test = -1
            self._widget_nav_images_test.setVisible(False)
            return
        self._index_image_test = -1  # aucune image encore rejouée pour cette sélection -- cf. _naviguer_image_test
        self._label_index_image_test.setText(f"- / {len(self._images_test_courantes)}")
        self._widget_nav_images_test.setVisible(True)

    def _naviguer_image_test(self, delta: int):
        """Clic sur ‹ (delta=-1) ou › (delta=+1) -- avance/recule dans
        self._images_test_courantes (liste déjà triée et filtrée par
        _rafraichir_navigation_images_test) avec un bouclage circulaire
        (dernière -> première et inversement), puis relance le test SUR
        CETTE IMAGE via self._sur_image_deposee(chemin) -- RÉUTILISE
        EXACTEMENT le même point d'entrée qu'un vrai glisser-déposer (cf.
        sa docstring), donc aucune divergence de traitement en aval :
        même worker de lecture asynchrone, même détection, même overlay.

        self._index_image_test part de -1 (cf. _rafraichir_navigation_
        images_test : "aucune image encore rejouée") -- le premier clic
        sur › doit donc afficher l'image d'INDEX 0, pas l'index 1 :
        (-1 + 1) % n = 0, correct sans cas particulier à gérer à part."""
        if not self._images_test_courantes:
            return
        n = len(self._images_test_courantes)
        self._index_image_test = (self._index_image_test + delta) % n
        chemin = self._images_test_courantes[self._index_image_test]
        self._label_index_image_test.setText(f"{self._index_image_test + 1} / {n}")
        self._sur_image_deposee(chemin)

    # ------------------------------------------------------------------
    # Glisser-déposer une image externe sur apercu_label -- AJOUT (retour
    # utilisateur : "si on fait un drag d'image sur l'interface de rendu,
    # ça devient l'image sur laquelle on va rechercher le composant").
    # eventFilter posé sur self.apercu_label depuis __init__ (cf. son
    # commentaire) -- cette classe n'a AUCUN autre eventFilter existant
    # (vérifié), donc pas de risque d'écraser une définition précédente
    # (contrairement au piège documenté ailleurs dans ce fichier : une
    # deuxième `def eventFilter` dans le même corps de classe REMPLACE
    # silencieusement la première).
    # ------------------------------------------------------------------
    EXTENSIONS_IMAGE_ACCEPTEES = EXTENSIONS_IMAGE_ACCEPTEES

    def eventFilter(self, obj, event):
        # CORRECTIF (retour utilisateur : "le drag ne fonctionne pas
        # quand je m'en vais tester un composant single") -- surveille
        # aussi apercu_scroll ET son viewport (cf. commentaire détaillé
        # dans __init__ : en MODE_COMPOSANT, c'est LUI qui reçoit
        # réellement les événements de drag, pas apercu_label posé
        # dedans). QEvent.DragMove explicitement accepté en plus de
        # DragEnter -- certains styles Qt/OS redemandent l'acceptation à
        # CHAQUE mouvement pendant le survol, un DragEnter accepté seul
        # ne suffit pas toujours à garantir que le Drop final aboutisse.
        # AJOUT (retour utilisateur : "pourquoi c'est pas identique" en
        # mode cL) -- surveille aussi _apercu_layout_scroll ET son
        # viewport (n'existe qu'en MODE_COMPOSANT_LAYOUT, cf. bloc de
        # substitution dans __init__) -- MÊME piège QScrollArea/viewport
        # que apercu_scroll ci-dessus, hasattr par prudence (widget
        # inexistant en mode cS, jamais créé par le bloc de substitution).
        #
        # CORRECTIF PERF (retour utilisateur : "le drag sur l'interface
        # est très lent, ça fait planter l'interface pendant une petite
        # période" -- UNIQUEMENT en mode cL, jamais en cS) -- DragMove est
        # envoyé par Qt en RAFALE (potentiellement 60+ fois/seconde)
        # pendant tout le survol, contrairement à DragEnter (une seule
        # fois) et Drop (une seule fois). L'ancien code refaisait, à
        # CHAQUE DragMove : reconstruction de la liste objets_surveilles,
        # un hasattr(), un test d'appartenance QWidget (coûteux côté
        # binding PySide), PUIS _mime_data_contient_image (parcourt
        # event.mimeData().urls() et recalcule chaque suffixe de fichier)
        # -- négligeable en cS (QLabel natif, paintEvent géré en C++ par
        # Qt, aucun repaint Python déclenché par le survol), mais
        # ApercuLayoutLabel a un paintEvent ENTIÈREMENT Python (redessine
        # le pixmap complet + reboucle sur _zones_nommees à chaque
        # repaint, cf. sa docstring) -- Qt redessine le widget survolé à
        # chaque DragMove pour le feedback visuel de survol, ce qui
        # déclenchait donc ce paintEvent Python coûteux en rafale,
        # d'où le freeze observé seulement en mode cL.
        #
        # Fix : DragMove n'a plus besoin de retraiter le mimeData -- si
        # CE widget a déjà accepté un DragEnter pour ce même survol (state
        # mémorisé dans self._drag_image_active), on réaccepte
        # directement sans reparcourir les URLs ni retoucher la liste des
        # objets surveillés. DragEnter (une fois par survol) et Drop (une
        # fois à la fin) restent les seuls points qui font le travail
        # complet -- comportement de FIN inchangé, seule la fréquence du
        # travail redondant pendant le survol est éliminée.
        type_evt = event.type()
        if type_evt == QEvent.DragMove:
            if getattr(self, "_drag_image_active", False):
                event.acceptProposedAction()
                return True
            return False

        objets_surveilles = [self.apercu_label, self._panneau_rendu.apercu_scroll, self._panneau_rendu.apercu_scroll.viewport()]
        if hasattr(self, "_apercu_layout_scroll"):
            objets_surveilles.append(self._apercu_layout_scroll)
            objets_surveilles.append(self._apercu_layout_scroll.viewport())
        if obj in objets_surveilles:
            if type_evt == QEvent.DragEnter:
                if self._mime_data_contient_image(event.mimeData()):
                    self._drag_image_active = True
                    event.acceptProposedAction()
                    return True
                self._drag_image_active = False
                return False
            if type_evt == QEvent.DragLeave:
                self._drag_image_active = False
                return False
            if type_evt == QEvent.Drop:
                self._drag_image_active = False
                chemin = self._chemin_image_depuis_mime_data(event.mimeData())
                if chemin is not None:
                    event.acceptProposedAction()
                    self._sur_image_deposee(chemin)
                    return True
                return False
        return super().eventFilter(obj, event)

    def _mime_data_contient_image(self, mime_data) -> bool:
        """Délègue à la fonction de module mime_data_contient_image (cf.
        sa docstring) -- REFACTOR (remontée en fonctions de module pour
        être réutilisées par ComposantLayoutConfigScreen, cf. son
        eventFilter) : cette méthode ne fait plus le travail elle-même,
        gardée uniquement pour ne rien casser ailleurs dans cette classe
        qui l'appelle encore en self._mime_data_contient_image(...)."""
        return mime_data_contient_image(mime_data, self.EXTENSIONS_IMAGE_ACCEPTEES)

    def _chemin_image_depuis_mime_data(self, mime_data) -> Optional[Path]:
        """Délègue à la fonction de module chemin_image_depuis_mime_data
        (cf. sa docstring) -- même REFACTOR que _mime_data_contient_image
        ci-dessus, une seule image à la fois : cf. docstring de
        _sur_image_deposee (jamais un traitement en lot ici, contrairement
        au Drop de ComposantLayoutConfigScreen sur _zone_drop_test)."""
        return chemin_image_depuis_mime_data(mime_data, self.EXTENSIONS_IMAGE_ACCEPTEES)

    def _sur_image_deposee(self, chemin: Path):
        """Point d'entrée du drop.

        CORRECTIF (retour utilisateur explicite : "lorsque je fait un
        drag sur l'interface ssa freeze un peu, je veux que tu essai de
        mettre ces operations dans un wokers") -- la lecture du fichier
        et l'encodage base64 (MÊME format que decoder_image_b64 attend,
        cf. sa docstring : brut, sans préfixe data:...;base64,) ne sont
        PLUS faits ici, de façon synchrone sur le thread GUI, mais
        délégués à self._lecture_image_worker (cf. sa docstring) --
        résultat reçu de façon asynchrone dans _sur_lecture_image_
        deposee_prete ci-dessous, qui mémorise ensuite le b64 dans
        self._image_deposee_b64 (cf. sa docstring : permet à un clic
        ultérieur sur "Démarrer le test" de retester CETTE image, cf.
        _demarrer_test) et lance la détection via _lancer_detection_sur_
        image_deposee, exactement comme avant.

        Une tentative de détection déjà en vol (self._detection_en_vol)
        fait ignorer ce drop plutôt que de superposer deux analyses
        concurrentes -- même prudence que _demarrer_test face à un
        second clic pendant l'attente d'une capture."""
        if self._detection_en_vol:
            self.statut_label.setText("Détection déjà en cours -- réessayez dans un instant.")
            return
        if self._mode == self.MODE_COMPOSANT_LAYOUT:
            # CORRECTIF (cf. commentaire détaillé dans _rafraichir_
            # disponibilite_demarrer) : Zone statiques hors-sujet ici,
            # seuls code_filtre/code_scindement conditionnent une
            # détection dynamique fonctionnelle.
            if (
                self.composant_layout is None
                or not self.composant_layout.code_filtre
                or not self.composant_layout.code_scindement
            ):
                self.statut_label.setText("Aucun ComposantLayout valide sélectionné.")
                return
        elif self.composant is None or not self._templates_bgr:
            self.statut_label.setText("Aucun composant valide sélectionné.")
            return
        self.statut_label.setText(f"Lecture de l'image déposée ({chemin.name})…")
        if not self._lecture_image_worker.demander_lecture(str(chemin)):
            # Ne devrait pas arriver (un seul drop traité à la fois, cf.
            # docstring de la classe) -- filet de sécurité si le worker
            # était malgré tout déjà occupé.
            self.statut_label.setText("Lecture déjà en cours -- réessayez dans un instant.")

    def _sur_lecture_image_deposee_prete(self, chemin: str, image_b64: Optional[str], erreur: Optional[str]):
        """Slot connecté à LectureImageDrapeeWorker.lecture_prete --
        contient la suite de l'ancienne _sur_image_deposee (avant qu'elle
        ne devienne asynchrone, cf. sa docstring) : mémorisation du b64
        puis lancement de la détection.

        Revérifie composant/composant_layout ICI plutôt que de supposer
        que la sélection de composant_combo n'a pas changé pendant la
        lecture (même prudence que self._composant_layout_en_cours_
        analyse pour la détection cL, cf. sa docstring) -- un drop très
        rapidement suivi d'un changement de sélection ne doit pas lancer
        une détection avec un composant/gabarit devenu incohérent."""
        if erreur is not None:
            self.statut_label.setText(f"Impossible de lire le fichier déposé : {erreur}")
            return
        if image_b64 is None:
            self.statut_label.setText("Impossible de lire le fichier déposé.")
            return
        if self._mode == self.MODE_COMPOSANT_LAYOUT:
            # CORRECTIF (cf. commentaire détaillé dans _rafraichir_
            # disponibilite_demarrer) : Zone statiques hors-sujet ici,
            # seuls code_filtre/code_scindement conditionnent une
            # détection dynamique fonctionnelle.
            if (
                self.composant_layout is None
                or not self.composant_layout.code_filtre
                or not self.composant_layout.code_scindement
            ):
                self.statut_label.setText("Aucun ComposantLayout valide sélectionné.")
                return
        elif self.composant is None or not self._templates_bgr:
            self.statut_label.setText("Aucun composant valide sélectionné.")
            return
        self._image_deposee_b64 = image_b64
        nom_fichier = Path(chemin).name
        self._lancer_detection_sur_image_deposee(f"Image déposée ({nom_fichier}) -- analyse en cours…")

    def _lancer_detection_sur_image_deposee(self, libelle_statut: str):
        """Factorise la partie commune à _sur_image_deposee (premier
        drop) ET à la bifurcation de _demarrer_test (retest d'un clic
        ultérieur sur "Démarrer le test", cf. son docstring et le
        commentaire en tête de self._image_deposee_b64) -- réinjecte
        self._image_deposee_b64 DIRECTEMENT dans _sur_capture_propre_
        pour_detection, EXACTEMENT le même point d'entrée que la capture
        réseau normale (cf. _lancer_detection/_lancer_detection_reseau) --
        aucune divergence de traitement en aval : bifurcation cS/cL,
        affichage, worker de détection, tout est déjà géré là-bas.

        Suppose self._image_deposee_b64 déjà valide (non-None) et
        self._detection_en_vol déjà vérifié False -- appelant
        responsable de ces deux garde-fous (cf. _sur_image_deposee et
        _demarrer_test, qui les vérifient chacun avant d'appeler ici)."""
        # cf. docstring de self._dernier_overlay_affiche -- même reset
        # qu'en tête de _demarrer_test, pour ne jamais laisser l'overlay
        # de l'ex-test redessiné par erreur sur cette nouvelle analyse.
        self._dernier_overlay_affiche = None
        self._en_cours = False
        self._detection_en_vol = True
        self._test_a_ete_lance = True
        # cf. docstring de self._test_depuis_image_deposee -- posé ICI,
        # AVANT l'appel à _sur_capture_propre_pour_detection ci-dessous,
        # pour que _sur_resultat_detection (callback du DetectionWorker
        # en mode cS, potentiellement appelé bien plus tard sur le
        # thread GUI une fois le résultat prêt) le trouve déjà à True et
        # n'exécute jamais d'action réelle pour CETTE tentative.
        self._test_depuis_image_deposee = True
        self.demarrer_button.setEnabled(True)
        self.demarrer_button.setText(" Arrêter le test")
        self.demarrer_button.setIcon(qta.icon("mdi6.stop", color=Mocha.text))
        self.statut_label.setText(libelle_statut)
        self._sur_capture_propre_pour_detection(self._image_deposee_b64, None)

    # ------------------------------------------------------------------
    # Sélecteur groupé "Local" / "sAutoniax (réseau)" -- UN SEUL combo
    # (self.instance_combo, hérité de InstanceApercuScreen), avec des
    # en-têtes de section non sélectionnables entre les deux groupes
    # (décision explicite utilisateur : "séparé visuellement, je ne veux
    # pas de saturation" -> "un seul menu à ouvrir... mais lisible").
    #
    # Format de `data` par item, pour distinguer les 3 cas possibles dans
    # _on_instance_changed ci-dessous :
    #   - None                    -> "(aucune sélection)" (item factice)
    #     OU en-tête de groupe désactivé (jamais sélectionnable de toute
    #     façon, cf. Qt.ItemIsEnabled retiré -- la distinction entre les
    #     deux n'a pas besoin d'être faite ici, currentData() ne peut de
    #     toute façon jamais RETOMBER sur un en-tête via une sélection
    #     utilisateur réelle).
    #   - str (id_instance)       -> instance LOCALE (comportement hérité
    #     de InstanceApercuScreen._on_instance_changed, INCHANGÉ)
    #   - tuple ("reseau", id)    -> exécutant RÉSEAU (nouveau, cf.
    #     _on_instance_changed override ci-dessous)
    # ------------------------------------------------------------------
    def definir_executants_reseau_connus(self, executants: dict):
        """Branché par ApplicationsScreen sur ClientServeurT.executants_
        detail_change (déjà reformaté en {id: nom}, même patron que
        TaskConfigScreen._noms_executants_reseau) -- rafraîchit le groupe
        "sAutoniax (réseau)" du sélecteur groupé. Mutation EN PLACE (cf.
        docstring du champ dans __init__), puis repeuplement complet du
        combo (même widget que les instances locales, cf. docstring de
        cette section) en préservant la sélection courante si elle reste
        valide (même esprit que _sur_liste_instances_recue hérité)."""
        self._noms_executants_reseau.clear()
        self._noms_executants_reseau.update(executants)
        self._repeupler_selecteur_cible()

    def definir_instances_par_profil_reseau(self, instances_par_profil: dict):
        """PATCH (correctif "plusieurs profils sur une instance") -- branché
        par ApplicationsScreen.definir_instances_par_profil_reseau/ouvrir_
        test_composant (cf. leurs docstrings pour la source : registre
        MainWindow alimenté par demarrer_profil_isole_resultat_recu/kill_
        profil_resultat_reel_recu). Réassignation complète (pas de mutation
        en place comme definir_executants_reseau_connus juste au-dessus) :
        ApplicationsScreen fournit déjà une copie fraîche à chaque appel
        (dict(v) par sous-dict, cf. sa docstring), donc garder EXACTEMENT
        ce qu'elle transmet plutôt que fusionner évite de faire persister
        un profil déjà fermé (kill) qu'une simple .update() laisserait
        traîner indéfiniment dans ce dict local."""
        self._instances_par_profil_reseau = instances_par_profil
        self._repeupler_selecteur_cible()

    def _sur_liste_instances_recue(self, instances: list):
        """Override -- même rôle que InstanceApercuScreen._sur_liste_
        instances_recue (peuplement du groupe LOCAL), mais délègue au
        repeuplement GROUPÉ complet (cf. _repeupler_selecteur_cible) pour
        que le groupe RÉSEAU déjà connu (self._noms_executants_reseau)
        reste affiché à chaque nouvelle liste_instances_recue locale,
        plutôt que d'être écrasé par un clear() qui ne repeuplerait que
        le local (cf. l'implémentation héritée, qui ignore totalement le
        réseau).

        AJOUT (SPEC_GLOBALE_AutoniaX.md, Partie C §3.2) -- reconstruit
        self._instance_id_par_profil_local à chaque réception, AVANT le
        repeuplement du sélecteur, pour que la resélection automatique
        du dernier profil local (cf. _repeupler_selecteur_cible, §3.3)
        dispose d'une association {nom_profil: instance_id} à jour.
        self._profils_locaux_connus est rechargé à chaque appel (même
        patron que le panneau clone, cf. ligne ~59714) plutôt qu'une
        seule fois à l'ouverture -- un profil créé après l'ouverture de
        cet onglet doit être reconnu sans avoir à rouvrir l'onglet."""
        self._dernieres_instances_locales = instances
        self._profils_locaux_connus = charger_registre_profils()
        self._instance_id_par_profil_local = _associer_profils_actifs_locaux(
            instances,
            list(self._profils_locaux_connus.keys()),
            self._instance_id_par_profil_local,
        )
        self._repeupler_selecteur_cible()

    def _repeupler_selecteur_cible(self):
        """Repeuple ENTIÈREMENT self.instance_combo avec les deux groupes
        -- source de vérité unique pour l'affichage du sélecteur (appelée
        par _sur_liste_instances_recue ET definir_executants_reseau_connus,
        jamais l'un sans l'autre) : sans ça, recevoir l'un des deux
        signaux sans l'autre effacerait le groupe qui n'a pas déclenché
        cet appel (cf. leur docstring respective)."""
        instances_locales = getattr(self, "_dernieres_instances_locales", [])
        cible_actuelle = self.instance_combo.currentData()
        self.instance_combo.blockSignals(True)
        self.instance_combo.clear()
        if not cible_actuelle:
            self.instance_combo.addItem("(aucune sélection)", None)

        self._ajouter_en_tete_groupe("── Instances locales ──")
        for item in instances_locales:
            id_instance = item.get("id")
            self.instance_combo.addItem(id_instance, id_instance)
        if not instances_locales:
            index_vide = self.instance_combo.count()
            self.instance_combo.addItem("Aucune instance locale connectée", None)
            self.instance_combo.model().item(index_vide).setEnabled(False)

        self._ajouter_en_tete_groupe("── sAutoniax (réseau) ──")
        # PATCH (correctif "plusieurs profils sur une instance") -- UNE
        # ligne par PROFIL actif (pas une par sAutoniax, cf. docstring de
        # definir_instances_par_profil_reseau) : tuple à 3 éléments
        # ("reseau", id_executant, instance_id) -- id_executant route le
        # message vers le bon sAutoniax (cf. _envoyer_commande_liee),
        # instance_id cible le profil précis à piloter à l'intérieur de ce
        # sAutoniax (cf. _instance_id_reseau_effectif). Un sAutoniax listé
        # dans _noms_executants_reseau mais absent de _instances_par_profil_
        # reseau (aucun profil démarré dessus pour l'instant) apparaît quand
        # même, désactivé, plutôt que de disparaître silencieusement du
        # combo -- cohérent avec le "Aucun sAutoniax connecté" juste en bas,
        # qui a la même intention (rendre visible l'état vide, pas le taire).
        au_moins_un_profil = False
        for id_executant, nom_executant in sorted(self._noms_executants_reseau.items(), key=lambda kv: kv[1]):
            profils = self._instances_par_profil_reseau.get(id_executant, {})
            if not profils:
                index_vide = self.instance_combo.count()
                self.instance_combo.addItem(f"{nom_executant} (aucun profil actif)", None)
                self.instance_combo.model().item(index_vide).setEnabled(False)
                continue
            au_moins_un_profil = True
            for nom_profil, instance_id in sorted(profils.items()):
                self.instance_combo.addItem(
                    f"{nom_executant} · {nom_profil}", ("reseau", id_executant, instance_id),
                )
        if not self._noms_executants_reseau:
            index_vide = self.instance_combo.count()
            self.instance_combo.addItem("Aucun sAutoniax connecté", None)
            self.instance_combo.model().item(index_vide).setEnabled(False)
        elif not au_moins_un_profil:
            index_vide = self.instance_combo.count()
            self.instance_combo.addItem("Aucun profil actif sur le réseau", None)
            self.instance_combo.model().item(index_vide).setEnabled(False)

        # Retrouve la cible précédente dans SA forme exacte (str pour le
        # local, tuple pour le réseau).
        #
        # BUGFIX découvert en testant la resélection automatique
        # ci-dessous : QComboBox.findData() de PySide6 ne compare PAS les
        # tuples Python par égalité de valeur (contrairement à sa
        # docstring Qt) -- confirmé par test isolé : un tuple ("reseau",
        # x, y) fraîchement reconstruit (même valeurs, nouvel objet
        # Python) n'est PAS retrouvé par findData(), alors que le MÊME
        # objet tuple déjà présent dans le modèle l'est. Visiblement,
        # findData() sur ce binding compare par identité d'objet au
        # travers du round-trip QVariant, pas par ==. Repasser
        # EXACTEMENT l'objet cible_actuelle capturé juste au-dessus
        # (même objet Python que celui déjà stocké comme itemData avant
        # le clear()) fonctionne dans le cas de préservation de sélection
        # ci-dessous -- mais le cas de resélection depuis les Réglages
        # plus bas reconstruit forcément un tuple NEUF (les valeurs
        # viennent du JSON persisté, pas d'un objet déjà dans le combo),
        # donc findData() y échouerait silencieusement. D'où
        # _trouver_index_par_donnee ci-dessous : recherche manuelle par
        # égalité Python (==), fiable pour tous les types (str comme
        # tuple), utilisée aux deux endroits pour rester cohérent plutôt
        # que de laisser une des deux résolutions sur un findData
        # potentiellement mensonger.
        index = self._trouver_index_par_donnee(cible_actuelle) if cible_actuelle else -1
        # PATCH (cf. docstring de ReglagesApp.dernier_profil_test_reseau)
        # -- SEULEMENT si aucune sélection n'est déjà active dans CETTE
        # session (cible_actuelle vide : premier repeuplement après
        # ouverture de l'onglet, ou plus généralement rien n'a encore été
        # choisi) : tente de resélectionner automatiquement le dernier
        # profil réseau utilisé lors d'un test précédent. Renvoie -1 si
        # ce profil précis n'est plus dans la liste (ex: sAutoniax
        # déconnecté, ou profil arrêté depuis) : dans ce cas on ne fait
        # RIEN de plus, le combo retombe normalement sur "(aucune
        # sélection)" comme avant ce patch, sans erreur ni sélection
        # approximative.
        if index < 0 and not cible_actuelle and self.reglages.dernier_profil_test_reseau:
            id_executant_sauve, instance_id_sauve = self.reglages.dernier_profil_test_reseau
            index_sauve = self._trouver_index_par_donnee(("reseau", id_executant_sauve, instance_id_sauve))
            if index_sauve >= 0:
                index = index_sauve
                log_test_composant.info(
                    f"[{self._id_pilote}] _repeupler_selecteur_cible() : "
                    f"resélection automatique du dernier profil réseau -> "
                    f"({id_executant_sauve!r}, {instance_id_sauve!r})"
                )
        # AJOUT (SPEC_GLOBALE_AutoniaX.md, Partie C §3.3) -- même
        # principe que le bloc réseau ci-dessus, étendu au LOCAL.
        # PRIORITÉ AU RÉSEAU s'il y a un dernier_profil_test_reseau
        # sauvegardé, MÊME si ce profil réseau précis n'est pas
        # RETROUVÉ dans la liste actuelle (sAutoniax déconnecté, ex.) :
        # dans ce cas on ne bascule PAS silencieusement sur un profil
        # local différent -- comportement conservateur, cf. docstring
        # complète de ce choix dans SPEC_GLOBALE_AutoniaX.md Partie C
        # §3.3 ("point de vigilance"). Un instance_id local est stocké
        # tel quel (chaîne brute) comme itemData des entrées locales du
        # combo (cf. plus haut, self.instance_combo.addItem(id_instance,
        # id_instance)) -- pas de tuple à reconstruire ici, contrairement
        # au cas réseau.
        if (index < 0 and not cible_actuelle
                and not self.reglages.dernier_profil_test_reseau
                and self.reglages.dernier_profil_test_local):
            nom_profil_sauve = self.reglages.dernier_profil_test_local
            instance_id_sauve = self._instance_id_par_profil_local.get(nom_profil_sauve)
            if instance_id_sauve:
                index_sauve = self._trouver_index_par_donnee(instance_id_sauve)
                if index_sauve >= 0:
                    index = index_sauve
                    log_test_composant.info(
                        f"[{self._id_pilote}] _repeupler_selecteur_cible() : "
                        f"resélection automatique du dernier profil local -> "
                        f"{nom_profil_sauve!r} (instance_id={instance_id_sauve!r})"
                    )
        if index >= 0:
            self.instance_combo.setCurrentIndex(index)
        self.instance_combo.blockSignals(False)
        if index >= 0:
            self._on_instance_changed(self.instance_combo.currentIndex())

    def _trouver_index_par_donnee(self, donnee) -> int:
        """Recherche manuelle par égalité Python (==) dans instance_combo
        -- cf. le BUGFIX juste au-dessus (docstring de _repeupler_
        selecteur_cible) : QComboBox.findData() n'est PAS fiable ici pour
        un tuple reconstruit (cas réseau), contrairement à sa promesse
        Qt. Boucle simple sur un combo de quelques dizaines d'entrées au
        plus (jamais un goulot d'étranglement réel)."""
        for i in range(self.instance_combo.count()):
            if self.instance_combo.itemData(i) == donnee:
                return i
        return -1


    def _ajouter_en_tete_groupe(self, libelle: str):
        """Ajoute un item non sélectionnable (Qt.ItemIsEnabled retiré du
        modèle) servant de titre de section dans le combo groupé -- cf.
        docstring de la section ci-dessus. data=None (jamais retourné par
        une sélection utilisateur réelle, Qt saute les items désactivés
        au clavier/à la molette, mais reste cliquable en théorie à la
        souris selon le style -- le désactivé empêche aussi ce cas)."""
        self.instance_combo.addItem(libelle, None)
        item = self.instance_combo.model().item(self.instance_combo.count() - 1)
        item.setEnabled(False)

    def _quitter_instance_locale_si_liee(self):
        """Reproduit EXACTEMENT la portion "quitter l'instance locale
        actuelle" de InstanceApercuScreen._on_instance_changed (unlink
        explicite + nettoyage d'état local, cf. son BUGFIX pour le détail
        du raisonnement) -- extraite ici en helper autonome car cette
        méthode-là lit self.instance_combo.currentData() en interne pour
        déterminer nouvelle_instance, ce qui la rend impossible à
        réutiliser TELLE QUELLE quand currentData() pointe déjà vers un
        item RÉSEAU (cas qui nous intéresse ici, cf. _on_instance_changed
        ci-dessous) plutôt que vers "(aucune sélection)"."""
        if self._instance_liee is None:
            return
        if self.client_reseau is not None:
            self.client_reseau.envoyer_commande({
                "type": "unlink", "instance_id": self._instance_liee,
            })
        self._changement_instance_pre(None)
        self._instance_liee = None
        self._derniere_image = None
        self.apercu_label.setPixmap(QPixmap())
        self._rafraichissement_ponctuel_en_attente = False
        self._rafraichir_disponibilite_onglets()
        self._changement_instance_post(None)

    def _on_instance_changed(self, index: int):
        """Override -- intercepte le cas RÉSEAU (data = tuple) avant de
        déléguer tout le reste (None, str = local) à l'implémentation
        héritée de InstanceApercuScreen, INCHANGÉE pour ces cas-là."""
        donnee = self.instance_combo.currentData()
        if isinstance(donnee, tuple) and donnee[0] == "reseau":
            # PATCH (correctif "plusieurs profils sur une instance") --
            # tuple à 3 éléments désormais (cf. _repeupler_selecteur_cible) :
            # id_executant route vers le bon sAutoniax, instance_id cible le
            # profil précis. self._instance_id_reseau est le champ que lit
            # _instance_id_reseau_effectif -- sans cette assignation, elle
            # retombait systématiquement sur id_executant (le bug corrigé
            # ici : piloter "l'instance" revenait à piloter tout le
            # sAutoniax, jamais un profil précis parmi plusieurs).
            _, id_executant, instance_id = donnee
            if id_executant == self._id_executant_reseau and instance_id == self._instance_id_reseau:
                return
            log_test_composant.info(
                f"[{self._id_pilote}] _on_instance_changed() : cible RÉSEAU "
                f"({self._id_executant_reseau!r}, {self._instance_id_reseau!r}) -> "
                f"({id_executant!r}, {instance_id!r})"
            )
            self._quitter_instance_locale_si_liee()
            self._id_executant_reseau = id_executant
            self._instance_id_reseau = instance_id
            self._rafraichir_disponibilite_demarrer()
            self._rafraichir_etat_bouton_deconnexion()
            # cf. PanneauRenduInstance.definir_profil_actif -- cas RÉSEAU :
            # currentText() porte déjà le libellé lisible construit par
            # _repeupler_selecteur_cible ("{nom_executant} · {nom_profil}",
            # ex. "sAutoniax-1 · xian1"), bien plus parlant que l'instance_id
            # technique complet ("sautoniax-isole-xian1-7d07745a").
            self._panneau_rendu.definir_profil_actif(self.instance_combo.currentText())
            return
        # Cas LOCAL (str) ou aucune sélection (None) : quitte proprement
        # une éventuelle cible RÉSEAU encore active avant de déléguer --
        # aucun message réseau à envoyer pour ça (contrairement au local,
        # cf. srv_gerer_link : le protocole commande_instance réseau n'a
        # pas de notion de "liaison" à libérer explicitement, chaque
        # commande est adressée directement par id_executant).
        self._id_executant_reseau = None
        self._instance_id_reseau = None
        super()._on_instance_changed(index)
        self._rafraichir_disponibilite_demarrer()

    def rafraichir_liste_composants(self):
        """REFONTE (mode composant_layout) : liste project.composants OU
        project.composants_layout selon self._mode -- jamais mélangés dans
        le même combo (cf. docstring du __init__)."""
        entite_actuelle = self._entite_testee()
        nom_actuel = entite_actuelle.nom if entite_actuelle else None
        source = self.project.composants_layout if self._mode == self.MODE_COMPOSANT_LAYOUT else self.project.composants
        libelle_vide = "Aucun ComposantLayout configuré" if self._mode == self.MODE_COMPOSANT_LAYOUT else "Aucun composant capturé"
        self.composant_combo.blockSignals(True)
        self.composant_combo.clear()
        for entite in sorted(source, key=lambda c: c.nom):
            self.composant_combo.addItem(entite.nom, entite.nom)
        if self.composant_combo.count() == 0:
            self.composant_combo.addItem(libelle_vide, None)
        index = self.composant_combo.findData(nom_actuel) if nom_actuel else -1
        self.composant_combo.setCurrentIndex(max(0, index))
        self.composant_combo.blockSignals(False)
        self._on_composant_changed(self.composant_combo.currentIndex())

    def preselectionner(self, composant_nom: str):
        """Appelé depuis le bouton 'Tester le composant'/'Tester le
        ComposantLayout' du panneau de réglages : sélectionne cette entité
        dans la liste de cet onglet. La liste elle-même est déjà rafraîchie
        par rafraichir_liste_composants juste avant cet appel (fait par
        ApplicationsScreen.ouvrir_test_composant/ouvrir_test_composant_layout).

        CORRECTIF : Qt n'émet currentIndexChanged QUE si l'index change
        RÉELLEMENT -- si rafraichir_liste_composants avait déjà positionné
        le combo sur ce même index (ex: seule entrée de la liste, ou déjà
        l'entité la plus récemment testée), setCurrentIndex(index) ici ne
        déclencherait alors AUCUN signal, et _on_composant_changed ne
        serait jamais appelé avec ce composant_nom -- self.composant_layout/
        self.composant resterait sur une valeur potentiellement différente
        (ou None), et _rafraichir_navigation_images_test ne serait jamais
        rappelée. On force donc l'appel explicitement dans ce cas précis,
        exactement comme le fait déjà rafraichir_liste_composants elle-même
        en toute fin de fonction."""
        index = self.composant_combo.findData(composant_nom)
        if index < 0:
            return
        if index == self.composant_combo.currentIndex():
            self._on_composant_changed(index)
        else:
            self.composant_combo.setCurrentIndex(index)

    def _on_composant_changed(self, index: int):
        if self._en_cours:
            self._arreter_test(action_executee=False)
        nom = self.composant_combo.currentData()

        # REFONTE (mode composant_layout) : bifurque intégralement -- pas
        # de templates BGR/multi-variantes pour cL (une seule image_
        # reference, détection structurelle via detecter_toutes_instances_
        # composant_layout, cf. _sur_capture_propre_pour_detection).
        # self._panneau_reglages_composant est maintenant, dans ce mode,
        # une instance de ComposantLayoutReglagesNumeriquesPanel (cf.
        # branchement dans __init__ ci-dessus) -- on lui passe donc le
        # ComposantLayout via son propre definir_composant_layout, pendant
        # EXACT de definir_composant(Composant) pour cS.
        if self._mode == self.MODE_COMPOSANT_LAYOUT:
            self.composant_layout = self.project.find_composant_layout(nom) if nom else None
            self._panneau_reglages_composant.definir_composant_layout(self.composant_layout)
            self._templates_bgr = []
            # AJOUT (demande explicite, capture_001.png : navigation ‹ ›
            # entre images de test) -- rafraîchie ICI, avant tout return
            # précoce ci-dessous : une image de test déjà enregistrée
            # doit rester consultable/rejouable même si ce cL n'est pas
            # (ou plus) complètement configuré pour la détection en
            # direct (zones/image de référence/code_filtre manquants).
            self._rafraichir_navigation_images_test()
            if self.composant_layout is None:
                self.statut_label.setText("Sélectionnez un ComposantLayout à tester.")
                self._rafraichir_disponibilite_demarrer()
                return
            # CORRECTIF (retour utilisateur explicite : "sa doit verifier
            # la zone dynamique pas la zone statique je m'en fiche des
            # zones statique") -- l'ancien check `not self.composant_
            # layout.zones` portait sur les Zone STATIQUES (tracées à la
            # main, cf. docstring de Zone/ComposantLayout.zones), jamais
            # renseignées quand seul le filtre (zones DYNAMIQUES, ex:
            # vignette/titre/menu_3points) est utilisé -- ce qui bloquait
            # le test même avec un code_filtre + code_scindement
            # parfaitement fonctionnels. Les zones dynamiques ne sont
            # JAMAIS persistées sur l'objet (elles ne sortent que de
            # l'exécution réelle de code_filtre, cf. sa docstring) : rien
            # à vérifier ici avant coup pour elles, seule la présence du
            # CODE qui les produit (code_filtre/code_scindement,
            # vérifiée juste en dessous) est un prérequis valable.
            if (
                not self.composant_layout.image_reference
                or not self.composant_layout.code_filtre
                # AJOUT (code_scindement OBLIGATOIRE, même titre que
                # code_filtre -- cf. docstring du champ) : un cL sans
                # scindement configuré n'est pas plus "prêt" qu'un cL
                # sans filtre, même message générique regroupant les
                # trois causes possibles plutôt que d'en distinguer une
                # quatrième variante de phrase pour un cas déjà couvert
                # par le même statut "pas configuré".
                or not self.composant_layout.code_scindement
            ):
                self.statut_label.setText("Ce ComposantLayout n'a pas de capture de référence/scindement/filtre configuré.")
                self._rafraichir_disponibilite_demarrer()
                return
            self.statut_label.setText(f"Prêt à tester « {self.composant_layout.nom} ».")
            self._rafraichir_disponibilite_demarrer()
            return

        self.composant = self.project.find_composant(nom) if nom else None
        # PATCH (cf. remplacement de colonne_reglages plus haut dans
        # __init__) -- le panneau de droite doit refléter le composant
        # SÉLECTIONNÉ, y compris quand il n'a aucune variante ou aucune
        # image valide sur disque (ses réglages de détection n'en restent
        # pas moins valides et modifiables) -- donc appelé ici, avant les
        # `return` précoces plus bas, et non pas seulement en fin de
        # fonction. definir_composant(None) gère déjà proprement le cas
        # "aucun composant" (cf. sa docstring).
        self._panneau_reglages_composant.definir_composant(self.composant)
        self._templates_bgr = []
        if self.composant is None:
            self.statut_label.setText("Sélectionnez un composant à tester.")
            self._rafraichir_disponibilite_demarrer()
            return

        if not self.composant.variantes:
            self.statut_label.setText("Ce composant n'a aucune variante d'image.")
            self._rafraichir_disponibilite_demarrer()
            return

        # CHANGEMENT (demande explicite utilisateur : "sa ne doit plus
        # tester tout dun coup, il faut que sa teste juste la variante
        # qui a ete selectionner") -- REMPLACE l'ancien comportement qui
        # chargeait ICI systématiquement TOUTES les variantes du composant
        # via charger_templates_bgr(self.composant) (une seule devait
        # matcher à la reconnaissance, cf. rechercher_composant_multi_
        # variantes) : l'écran de test ne doit désormais évaluer QUE la
        # variante actuellement sélectionnée dans ComposantReglagesNumeriquesPanel
        # (index 0 par défaut à ce stade, cf. definir_composant appelé
        # juste au-dessus, qui vient elle-même de se positionner sur 0 et
        # d'émettre variante_selection_changee(0) -- capté par
        # _on_variante_panneau_changee, cf. sa docstring). _charger_
        # templates_variante_unique (factorisée, cf. sa docstring) pose
        # self._templates_bgr et le message de statut correspondant --
        # rien de plus à faire ici.
        self._charger_templates_variante_unique(0)

    def _charger_templates_variante_unique(self, index_variante: int):
        """AJOUT (demande explicite utilisateur : "sa ne doit plus tester
        tout dun coup, il faut que sa teste juste la variante qui a ete
        selectionner") -- construit self._templates_bgr avec UNE SEULE
        entrée (image_bgr, Variante), celle d'index index_variante dans
        self.composant.variantes, plutôt que charger_templates_bgr(self.
        composant) qui les charge TOUTES. Factorise ce que _on_composant_
        changed (sélection initiale, index 0) et _on_variante_panneau_
        changee (l'utilisateur change de variante dans le panneau de
        réglages pendant que cet onglet de test est ouvert) ont en commun,
        pour ne pas dupliquer la résolution de chemin/le chargement QImage/
        la conversion BGR ni les messages de statut.

        Index hors bornes (composant sans variante à cet index, cas limite
        qui ne devrait pas arriver en pratique puisque variante_combo est
        peuplé depuis composant.variantes) ou fichier introuvable/illisible
        sur disque -> self._templates_bgr vidée et message d'erreur, MÊME
        esprit que charger_templates_bgr (une variante illisible est
        ignorée plutôt que de faire planter l'écran), mais ici une seule
        variante manquante suffit à vider le test puisqu'aucune autre ne
        prendra silencieusement le relais."""
        self._templates_bgr = []
        if self.composant is None or not (0 <= index_variante < len(self.composant.variantes)):
            self.statut_label.setText("Variante sélectionnée introuvable.")
            self._rafraichir_disponibilite_demarrer()
            return

        variante = self.composant.variantes[index_variante]
        if not isinstance(variante, Variante):
            # Filet défensif -- même raisonnement que charger_templates_bgr
            # (project pas encore migré/str brute) : construit une Variante
            # à la volée avec les défauts plutôt que de planter plus loin
            # sur variante.chemin/.seuil_confiance/etc.
            variante = Variante(str(variante))

        if not VISION_DISPONIBLE:
            self.statut_label.setText("Détection indisponible (dépendances de vision manquantes).")
            self._rafraichir_disponibilite_demarrer()
            return

        chemin = variante.chemin if isinstance(variante, Variante) else str(variante)
        image_absolue = get_app_data_dir() / chemin
        if not image_absolue.exists():
            self.statut_label.setText(f"Image de la variante introuvable sur disque : {chemin}")
            self._rafraichir_disponibilite_demarrer()
            return

        image = QImage(str(image_absolue))
        if image.isNull():
            self.statut_label.setText(f"Image de la variante illisible : {chemin}")
            self._rafraichir_disponibilite_demarrer()
            return

        self._templates_bgr = [(qimage_vers_bgr(image), variante)]
        self.statut_label.setText(f"Prêt à tester « {self.composant.nom} » (variante : {Path(chemin).name}).")
        self._rafraichir_disponibilite_demarrer()

    def _on_variante_panneau_changee(self, index_variante: int):
        """AJOUT (demande explicite utilisateur : "sa ne doit plus tester
        tout dun coup, il faut que sa teste juste la variante qui a ete
        selectionner") -- slot connecté à ComposantReglagesNumeriquesPanel.
        variante_selection_changee (cf. sa docstring) : recharge self.
        _templates_bgr sur la SEULE variante nouvellement sélectionnée dans
        le panneau, pendant que cet onglet de test reste ouvert sur le même
        composant. Sans ce slot, changer de variante dans le panneau ne
        mettait à jour QUE les 6 widgets de réglages affichés (priorité,
        seuil, etc.) -- self._templates_bgr, lui, restait figé sur ce que
        _on_composant_changed avait chargé initialement, donc le clic sur
        "Démarrer le test" testait toujours la même variante quoi que
        l'utilisateur sélectionne ensuite dans ce panneau."""
        if self.composant is None:
            return
        self._charger_templates_variante_unique(index_variante)

    def _changement_instance_pre(self, nouvelle_instance: Optional[str]):
        """Override du hook de InstanceApercuScreen -- coupe un test en
        cours (armé ou détection en vol) avant de changer d'instance liée,
        pour ne pas laisser une détection ou une attente de capture
        ponctuelle porter sur l'ancienne instance."""
        if self._en_cours or self._detection_en_vol:
            self._arreter_test(action_executee=False)

    def _changement_instance_post(self, nouvelle_instance: Optional[str]):
        """Override du hook de InstanceApercuScreen -- rafraîchit la
        disponibilité du bouton "Démarrer le test" (dépend notamment
        d'une instance sélectionnée, cf. _rafraichir_disponibilite_demarrer)."""
        self._rafraichir_disponibilite_demarrer()

    def _rafraichir_etat_bouton_deconnexion(self):
        """Override -- même rôle que InstanceApercuScreen._rafraichir_
        etat_bouton_deconnexion, mais active aussi le bouton "Déconnecter"
        pour une cible RÉSEAU active (self._id_executant_reseau), pas
        seulement une instance LOCALE liée (self._instance_liee)."""
        self.deconnecter_button.setEnabled(
            self._instance_liee is not None or self._id_executant_reseau is not None
        )

    def _sur_liaison_echouee_pour_instance(self, instance_id: str, message: str):
        """FIX (bug : test qui tourne dans le vide sur une instance déjà
        liée à un AUTRE pilote, ex: le Dashboard) -- avant ce patch, rien
        ne vérifiait la réponse au 'link' envoyé par _on_instance_changed :
        le test démarrait, la détection tournait, et CHAQUE commande de la
        séquence d'action (moveCursor, click...) était rejetée une par une
        par le serveur (gerer_command : instance non liée à ce pilote),
        sans qu'aucun message clair n'atteigne l'utilisateur -- seul un
        WARNING dans le log, jamais affiché à l'écran."""
        log_test_composant.warning(
            f"[{self._id_pilote}] _sur_liaison_echouee_pour_instance() : arrêt du test sur '{instance_id}'"
        )
        if self._en_cours or self._detection_en_vol:
            self._arreter_test(action_executee=False)
        self._rafraichir_disponibilite_demarrer()
        # message est déjà une phrase complète et correctement formulée
        # (cf. InstanceApercuScreen._sur_liaison_echouee / _sur_instance_deliee,
        # qui distinguent "refusé dès le départ" de "retiré après coup").
        self.statut_label.setText(
            f"{message} Sélectionnez une autre instance ou libérez celle-ci."
        )

    def _rafraichir_disponibilite_demarrer(self):
        """Le bouton "Démarrer" exige : vision dispo, réseau dispo,
        composant+templates valides (cS) ou ComposantLayout+Zones valides
        (cL, cf. REFONTE ci-dessous) ET une instance sélectionnée (peu
        importe si elle est déjà "occupée" par un autre pilote -- la
        tentative de link échouera alors proprement via
        _sur_liaison_echouee_pour_instance, qui arrête le test et
        affiche un message clair, plutôt que de bloquer le bouton par
        anticipation sur une info qui peut changer entre-temps côté
        serveur)."""
        if self._mode == self.MODE_COMPOSANT_LAYOUT:
            # REFONTE (mode composant_layout) : pas de _templates_bgr ici
            # -- ce mode exige un ComposantLayout avec une image_reference,
            # un code_filtre ET un code_scindement (cf. _on_composant_
            # changed, mêmes conditions déjà validées là-bas -- AJOUT
            # code_scindement : OBLIGATOIRE au même titre que code_filtre,
            # cf. docstring du champ sur ComposantLayout).
            # CORRECTIF (retour utilisateur explicite : "sa doit verifier
            # la zone dynamique pas la zone statique je m'en fiche des
            # zones statique") -- ancien `bool(self.composant_layout.
            # zones)` retiré : ce champ ne contient que les Zone STATIQUES
            # tracées à la main (cf. docstring de la dataclass Zone), sans
            # rapport avec les zones DYNAMIQUES produites par code_filtre
            # à l'exécution (vignette/titre/menu_3points...), qui elles ne
            # sont jamais persistées sur l'objet -- exiger `zones` ici
            # bloquait le bouton même avec un filtre+scindement
            # entièrement fonctionnels, tant qu'aucune Zone statique
            # n'avait été tracée en plus (superflu pour ce flux).
            entite_prete = (
                self.composant_layout is not None
                and bool(self.composant_layout.image_reference)
                and bool(self.composant_layout.code_filtre)
                and bool(self.composant_layout.code_scindement)
            )
        else:
            entite_prete = self.composant is not None and bool(self._templates_bgr)
        pret = (
            VISION_DISPONIBLE
            and RESEAU_DASHBOARD_DISPONIBLE
            and entite_prete
            and self.instance_combo.currentData() is not None
        )
        self.demarrer_button.setEnabled(pret)

    def _on_action_changed(self, index: int):
        action = self.action_combo.currentData()
        self.deplacement_options.setVisible(
            action in ("positionner", "clic_gauche", "clic_droit", "double_clic")
        )
        self.clic_options.setVisible(action in ("clic_gauche", "clic_droit", "double_clic"))
        self.scroll_options.setVisible(action == "scroller")
        self.saisir_options.setVisible(action == "saisir")

    def _toggle_test(self):
        log_test_composant.info(
            f"[{self._id_pilote}] _toggle_test() : _en_cours={self._en_cours} "
            f"_detection_en_vol={self._detection_en_vol} sequenceur_actif={self._sequenceur is not None}"
        )
        if self._en_cours:
            self._arreter_test(action_executee=False)
        else:
            self._demarrer_test()

    def _demarrer_test(self):
        log_test_composant.info(f"[{self._id_pilote}] _demarrer_test() : entrée")
        # REFONTE (mode composant_layout) : condition de garde adaptée --
        # cf. _rafraichir_disponibilite_demarrer pour le même distinguo
        # (pas de _templates_bgr en cL).
        if self._mode == self.MODE_COMPOSANT_LAYOUT:
            # CORRECTIF (cf. commentaire détaillé dans _rafraichir_
            # disponibilite_demarrer) : Zone statiques hors-sujet ici,
            # seuls code_filtre/code_scindement conditionnent une
            # détection dynamique fonctionnelle.
            if (
                self.composant_layout is None
                or not self.composant_layout.code_filtre
                or not self.composant_layout.code_scindement
            ):
                self.statut_label.setText("Aucun ComposantLayout valide sélectionné.")
                return
        elif self.composant is None or not self._templates_bgr:
            self.statut_label.setText("Aucun composant valide sélectionné.")
            return

        # AJOUT (retour utilisateur : "quand je démarre le test ça
        # considère toujours que je veux utiliser le profil [réseau]") --
        # bifurque ICI, AVANT toute logique réseau/locale ci-dessous : si
        # une image a déjà été déposée sur apercu_label (cf. docstring de
        # self._image_deposee_b64/_sur_image_deposee), ce clic RETESTE
        # cette même image plutôt que de redemander une capture réseau --
        # jamais effacée automatiquement, donc prioritaire tant qu'aucun
        # nouveau drop n'a eu lieu, quelle que soit l'instance cible
        # sélectionnée dans instance_combo (même vide/"aucune").
        if self._image_deposee_b64 is not None:
            if self._detection_en_vol:
                self.statut_label.setText("Détection déjà en cours -- réessayez dans un instant.")
                return
            self._lancer_detection_sur_image_deposee("Nouvelle analyse de l'image déposée…")
            return

        # cf. docstring de self._dernier_overlay_affiche -- efface l'overlay
        # de l'EX-test avant que le nouveau ne commence : sans ce reset, la
        # toute première frame reçue après ce clic (avant que le résultat
        # de CE nouveau test n'arrive) redessinerait encore l'ancien
        # rectangle vert/jaune, potentiellement trompeur (composant/cible
        # différents entre les deux tests).
        self._dernier_overlay_affiche = None
        # Même reset, pendant cL de la ligne ci-dessus (cf. docstring de
        # self._dernieres_instances_layout) -- évite qu'un clic sur le
        # toggle "Afficher les zones" entre ce clic et l'arrivée du
        # nouveau résultat ne redessine les instances de l'EX-test.
        self._dernieres_instances_layout = []

        # PATCH (cible RÉSEAU) -- bifurque AVANT toute vérification de
        # liaison locale (instance_id != self._instance_liee) : cette
        # vérification n'a pas d'équivalent en mode réseau (pas de notion
        # de "liaison confirmée par le serveur", cf. srv_gerer_link,
        # propre au protocole LOCAL uniquement -- chaque commande réseau
        # est adressée directement par id_executant, sans étape de
        # liaison préalable à confirmer). De même, demander_rafraichissement_
        # pour_test()/le flux "avec curseur" n'existe QUE côté local (cf.
        # sa docstring : set_streaming, jamais utilisé pour la RÉELLE
        # analyse OpenCV, qui redemande de toute façon une capture_propre
        # séparée, cf. _lancer_detection) -- en réseau, on demande donc
        # DIRECTEMENT cette capture_propre, sans étape d'affichage
        # intermédiaire inutile.
        if self._id_executant_reseau is not None:
            self._en_cours = True
            # cf. docstring de self._test_a_ete_lance -- posé ICI (test
            # réseau réellement lancé, toutes les vérifications au-dessus
            # étant passées), jamais remis à False ensuite.
            self._test_a_ete_lance = True
            self.instance_combo.setEnabled(False)
            self.action_combo.setEnabled(False)
            self.composant_combo.setEnabled(False)
            self.demarrer_button.setEnabled(False)
            self.demarrer_button.setText(" Capture en cours…")
            self.statut_label.setText("Capture en cours…")
            self._lancer_detection_reseau()
            return

        instance_id = self.instance_combo.currentData()
        if instance_id is None or self.client_reseau is None:
            self.statut_label.setText("Sélectionnez une instance cible valide.")
            return
        if instance_id != self._instance_liee:
            # FIX : instance_combo.currentData() reflète juste ce que l'UI
            # affiche comme sélectionné, PAS si le serveur a réellement
            # confirmé la liaison (cf. _sur_liaison_echouee, qui remet
            # _instance_liee à None si le link a été refusé -- ex: instance
            # déjà liée à un autre pilote). Sans cette vérification, le test
            # démarrait quand même et chaque commande de la séquence
            # d'action était rejetée en silence par le serveur.
            log_test_composant.warning(
                f"[{self._id_pilote}] _demarrer_test() : abandon -- combo affiche {instance_id!r} "
                f"mais liaison confirmée = {self._instance_liee!r}"
            )
            self.statut_label.setText(
                f"Liaison à '{instance_id}' non confirmée par le serveur -- "
                f"resélectionnez l'instance."
            )
            return
        self._en_cours = True
        # cf. docstring de self._test_a_ete_lance -- posé ICI (test local
        # réellement lancé, toutes les vérifications au-dessus étant
        # passées : instance_id valide, liaison confirmée), jamais remis
        # à False ensuite.
        self._test_a_ete_lance = True
        self.instance_combo.setEnabled(False)
        self.action_combo.setEnabled(False)
        self.composant_combo.setEnabled(False)
        # demander_rafraichissement_pour_test() (cf. InstanceApercuScreen) :
        # - si aucun flux automatique n'est actif, lance une capture
        #   ponctuelle et renvoie True -- la détection démarre depuis
        #   _sur_nouvelle_frame, dès réception de cette image fraîche.
        #   Le bouton reste GRISÉ (pas juste relabellisé) le temps de
        #   cette attente, pour ne pas laisser croire qu'un second clic
        #   ferait quoi que ce soit -- cf. _lancer_detection, qui rebascule
        #   sur "Arrêter le test" une fois la détection réellement lancée ;
        # - si un flux automatique tourne déjà, renvoie False sans rien
        #   redemander -- on utilise alors self._derniere_image tout de
        #   suite (jamais redemander une image en plus si un taux de
        #   rafraîchissement est déjà en place), et on bascule directement
        #   sur "Arrêter le test" puisqu'il n'y a pas d'attente ici.
        capture_lancee = self.demander_rafraichissement_pour_test()
        log_test_composant.info(
            f"[{self._id_pilote}] _demarrer_test() : demander_rafraichissement_pour_test() -> "
            f"capture_lancee={capture_lancee} (auto_actif={self._rafraichissement_auto_actif}, "
            f"ponctuel_en_attente={self._rafraichissement_ponctuel_en_attente})"
        )
        if capture_lancee:
            self.demarrer_button.setEnabled(False)
            self.demarrer_button.setText(" Capture en cours…")
            self.statut_label.setText("Capture en cours…")
            return
        if self._derniere_image is None:
            log_test_composant.info(f"[{self._id_pilote}] _demarrer_test() : aucune image dispo, abandon")
            self._en_cours = False
            self.instance_combo.setEnabled(True)
            self.action_combo.setEnabled(True)
            self.composant_combo.setEnabled(True)
            self.statut_label.setText(
                "Aucune image disponible pour l'instant -- patientez la "
                "prochaine frame du flux automatique."
            )
            return
        self.demarrer_button.setText(" Arrêter le test")
        self.demarrer_button.setIcon(qta.icon("mdi6.stop", color=Mocha.text))
        log_test_composant.info(f"[{self._id_pilote}] _demarrer_test() : image déjà dispo, détection directe")
        self._lancer_detection(self._derniere_image)

    def _arreter_test(self, action_executee: bool):
        log_test_composant.info(f"[{self._id_pilote}] _arreter_test(action_executee={action_executee})")
        self._en_cours = False
        # setEnabled(True) couvre aussi le cas où le test est annulé PENDANT
        # l'attente d'une capture ponctuelle (bouton alors grisé/"Capture en
        # cours…", cf. _demarrer_test) -- sans effet visible s'il était déjà
        # activé.
        self.demarrer_button.setEnabled(True)
        self.demarrer_button.setText(" Démarrer le test")
        self.demarrer_button.setIcon(qta.icon("mdi6.play", color=Mocha.text))
        self.instance_combo.setEnabled(True)
        # REFONTE (mode composant_layout) : action_combo est sans effet
        # visible en mode cL (_widget_action masqué en bloc, cf. __init__)
        # -- réactiver un widget invisible ne change rien à l'écran, cette
        # ligne reste donc inconditionnelle plutôt que de la conditionner
        # pour rien.
        self.action_combo.setEnabled(True)
        self.composant_combo.setEnabled(True)
        if not action_executee:
            self.statut_label.setText("Test arrêté par l'utilisateur.")

    def _sur_nouvelle_frame(self, image: QImage, capture_ponctuelle: bool):
        """Override du hook de InstanceApercuScreen -- remplace l'ancien
        _sur_frame_recue. Reçoit CHAQUE frame utile (image déjà décodée,
        _derniere_taille_frame déjà mise à jour par la classe de base).

        Si le test n'est pas armé (_en_cours), ou si une détection est déjà
        en vol pour une frame précédente, simple affichage brut -- jamais
        de détection hors demande explicite ni de deuxième tentative
        empilée par-dessus une déjà en cours (cf. DetectionWorker : un seul
        job à la fois)."""
        if not self._en_cours or self._detection_en_vol:
            log_test_composant.debug(
                f"[{self._id_pilote}] _sur_nouvelle_frame() : frame ignorée pour détection "
                f"(_en_cours={self._en_cours}, _detection_en_vol={self._detection_en_vol}, "
                f"capture_ponctuelle={capture_ponctuelle})"
            )
            # REFONTE (mode composant_layout) : _afficher_apercu_avec_
            # resultat dessine via QPainter/setPixmap -- apercu_layout_
            # label est maintenant EXACTEMENT ce même genre de QLabel
            # natif (cf. docstring du bloc de substitution dans __init__,
            # "reprendre exactement le même process que le mode cS") --
            # affichage brut de la frame courante via setPixmap/resize
            # directement, jamais d'overlay hors résultat de détection en
            # mode cL (le dernier résultat affiché reste visible tel
            # quel, cf. _afficher_apercu_layout_avec_instances, jusqu'au
            # prochain "Démarrer le test").
            if self._mode == self.MODE_COMPOSANT_LAYOUT:
                pixmap_brut = QPixmap.fromImage(image.copy())
                self.apercu_layout_label.setPixmap(pixmap_brut)
                self.apercu_layout_label.resize(pixmap_brut.size())
                return
            # PATCH (cf. docstring de self._dernier_overlay_affiche) --
            # redessine le dernier rectangle vert/jaune connu plutôt
            # qu'un affichage brut, pour qu'il reste visible tant qu'un
            # nouveau test n'a pas été explicitement relancé (sinon le
            # flux automatique l'efface avant que l'utilisateur ait pu
            # le voir). None (défaut avant tout test, ou juste après
            # _demarrer_test) reproduit exactement l'ancien comportement.
            if self._dernier_overlay_affiche is not None:
                resultat, candidats, candidats_en_conflit = self._dernier_overlay_affiche
                self._afficher_apercu_avec_resultat(image, resultat, candidats, candidats_en_conflit)
            else:
                self._afficher_apercu_avec_resultat(image, None)
            return
        log_test_composant.info(
            f"[{self._id_pilote}] _sur_nouvelle_frame() : frame retenue pour détection "
            f"(capture_ponctuelle={capture_ponctuelle})"
        )
        self._lancer_detection(image)

    def _lancer_detection(self, image: QImage):
        """Envoie UNE tentative de détection au worker -- appelée soit
        depuis _sur_nouvelle_frame (capture ponctuelle ou frame suivante
        d'un flux déjà actif), soit directement depuis _demarrer_test
        quand un flux automatique est déjà actif et que self._derniere_image
        est immédiatement disponible.

        `image` (avec le curseur virtuel, cf. streaming normal) sert
        UNIQUEMENT à l'affichage immédiat ci-dessous -- jamais au
        traitement OpenCV lui-même : celui-ci utilise une capture_propre
        fraîche, demandée à l'instance juste après (sans le curseur
        virtuel, cf. action_capture_propre côté instance_nodriver.py),
        pour ne jamais fausser matchTemplate/ORB/SSIM avec le cercle du
        curseur incrusté dans les pixels.

        _en_cours repasse à False dès l'envoi : qu'il y ait détection ou
        non au retour (cf. _sur_resultat_detection), il faudra recliquer
        "Démarrer le test" pour retenter -- jamais de boucle continue."""
        log_test_composant.info(f"[{self._id_pilote}] _lancer_detection() : demande de capture_propre")
        self._en_cours = False
        self._detection_en_vol = True
        self._image_en_cours_analyse = image
        # cf. docstring de self._test_depuis_image_deposee -- chemin
        # RÉSEAU normal, jamais une tentative sur image déposée (celle-ci
        # passe exclusivement par _lancer_detection_sur_image_deposee,
        # cf. son commentaire) : remis à False par défensivité, au cas où
        # un résultat d'une PRÉCÉDENTE tentative sur image déposée
        # traînerait encore (ne devrait pas arriver, _sur_resultat_
        # detection le remet déjà à False dès qu'il est lu).
        self._test_depuis_image_deposee = False
        # Rebascule le bouton en "Arrêter le test" cliquable -- couvre le
        # cas où il était grisé/"Capture en cours…" (cf. _demarrer_test,
        # capture ponctuelle qui vient tout juste d'aboutir). Sans effet
        # visible si le bouton l'était déjà (chemin flux auto déjà actif).
        self.demarrer_button.setEnabled(True)
        self.demarrer_button.setText(" Arrêter le test")
        self.demarrer_button.setIcon(qta.icon("mdi6.stop", color=Mocha.text))
        # REFONTE (mode composant_layout) : apercu_layout_label est
        # maintenant un QLabel natif (cf. docstring du bloc de
        # substitution dans __init__) -- setPixmap/resize directement,
        # comme _afficher_apercu_avec_resultat le fait pour cS, mais sans
        # overlay (rien à dessiner avant que le résultat de détection
        # n'arrive, cf. _afficher_apercu_layout_avec_instances).
        if self._mode == self.MODE_COMPOSANT_LAYOUT:
            pixmap_brut = QPixmap.fromImage(image.copy())
            self.apercu_layout_label.setPixmap(pixmap_brut)
            self.apercu_layout_label.resize(pixmap_brut.size())
        else:
            self._afficher_apercu_avec_resultat(image, None)
        self.statut_label.setText("Capture sans curseur pour l'analyse…")
        self._demander_capture_propre(self._sur_capture_propre_pour_detection)

    def _lancer_detection_reseau(self):
        """Équivalent RÉSEAU de _lancer_detection -- appelée depuis
        _demarrer_test quand self._id_executant_reseau est actif. Diffère
        du chemin LOCAL sur un seul point : il n'existe pas de flux "avec
        curseur" à afficher immédiatement (pas de set_streaming côté
        protocole commande_instance réseau, cf. son absence totale dans
        instance_nodriver.py/serveur.py pour ce protocole) -- demande donc
        DIRECTEMENT la capture_propre, sans image intermédiaire à afficher
        avant. self._image_en_cours_analyse reste None jusqu'à la
        réception de cette capture -- cf. _sur_capture_propre_pour_
        detection, adaptée pour la fixer elle-même dans ce cas plutôt que
        de dupliquer sa logique de décodage/callback ici."""
        log_test_composant.info(f"[{self._id_pilote}] _lancer_detection_reseau() : demande de capture_propre")
        self._en_cours = False
        self._detection_en_vol = True
        self._image_en_cours_analyse = None  # cf. docstring -- fixée par _sur_capture_propre_pour_detection
        self._test_depuis_image_deposee = False  # cf. docstring dans _lancer_detection ci-dessus
        self._demander_capture_propre(self._sur_capture_propre_pour_detection)

    def _sur_capture_propre_pour_detection(self, image_b64: Optional[str], erreur: Optional[str]):
        """Callback de _demander_capture_propre, appelé depuis
        _lancer_detection (local) OU _lancer_detection_reseau. Sur succès :
        décode l'image propre et l'envoie au DetectionWorker en mode cS
        (jamais l'image avec curseur affichée juste avant en mode local,
        cf. _lancer_detection), OU directement à detecter_toutes_instances_
        composant_layout en mode cL (REFONTE -- appel synchrone, pas besoin
        de worker séparé : même fonction déjà utilisée par l'ancien
        ComposantLayoutConfigScreen._demarrer_test_detection, rapide car
        UNE SEULE tentative par clic, jamais en boucle). Sur échec (pas
        d'instance/exécutant ciblé, timeout, erreur CDP) : abandonne cette
        tentative proprement plutôt que de retomber silencieusement sur
        l'image avec curseur, ce qui fausserait la détection sans que
        l'utilisateur le sache."""
        if erreur is not None:
            log_test_composant.warning(f"[{self._id_pilote}] capture_propre échouée : {erreur}")
            self._detection_en_vol = False
            self._image_en_cours_analyse = None
            self._arreter_test(action_executee=False)
            self.statut_label.setText(f"Échec de la capture sans curseur : {erreur}")
            return
        image_propre = decoder_image_b64(image_b64) if image_b64 else None
        if image_propre is None:
            log_test_composant.warning(f"[{self._id_pilote}] capture_propre : image reçue invalide/non décodable")
            self._detection_en_vol = False
            self._image_en_cours_analyse = None
            self._arreter_test(action_executee=False)
            self.statut_label.setText("Échec de la capture sans curseur : image invalide.")
            return

        # REFONTE (mode composant_layout) : bifurque ICI, avant tout appel
        # à _afficher_apercu_avec_resultat -- cette méthode dessine via
        # QPainter sur un QPixmap posé par setPixmap(), API que
        # ApercuLayoutLabel.paintEvent IGNORE complètement (il ne dessine
        # QUE self._pixmap_base, alimenté par afficher_image(), cf. sa
        # docstring) : l'appeler en mode cL n'afficherait rien à l'écran.
        if self._mode == self.MODE_COMPOSANT_LAYOUT:
            self._sur_capture_propre_pour_detection_layout(image_propre)
            return

        # PATCH (cible RÉSEAU, cf. _lancer_detection_reseau) -- en mode
        # local, self._image_en_cours_analyse est déjà fixée par
        # _lancer_detection AVANT cet appel (image "avec curseur",
        # utilisée pour l'affichage immédiat pendant l'attente) ; en mode
        # réseau, aucune image de ce genre n'existe -- la capture_propre
        # reçue ICI sert alors à la fois à l'analyse ET à l'affichage
        # (via _sur_resultat_detection, qui lit self._image_en_cours_
        # analyse sans distinction d'origine).
        if self._image_en_cours_analyse is None:
            self._image_en_cours_analyse = image_propre
            self._afficher_apercu_avec_resultat(image_propre, None)
            # Taille dérivée de CETTE capture -- même rôle que _derniere_
            # taille_frame tenue par InstanceApercuScreen._sur_frame_recue
            # en mode local (utilisée par SequenceurActionReseau pour le
            # point de départ aléatoire du curseur, cf. sa docstring),
            # mais jamais mise à jour ici en mode réseau puisqu'aucune
            # frame de streaming n'y transite (cf. _lancer_detection_
            # reseau). capture_propre étant la SEULE image reçue du tout
            # en mode réseau, elle est la source la plus fidèle possible.
            if image_propre.width() > 0 and image_propre.height() > 0:
                self._derniere_taille_frame = (image_propre.width(), image_propre.height())
        log_test_composant.info(f"[{self._id_pilote}] capture_propre reçue -- envoi au DetectionWorker")
        self.statut_label.setText("Analyse en cours…")
        # image_propre (sans curseur) passée au worker -- la conversion
        # qimage_vers_bgr est elle-même un appel cv2/numpy non-trivial
        # (cvtColor sur l'image complète) : elle a aussi sa place dans le
        # worker, pas sur le thread GUI (cf. DetectionWorker._executer).
        # PATCH (candidats multiples, demande explicite utilisateur) : le
        # mode "candidats multiples" REMPLACE l'appel simple ICI (écran de
        # test uniquement, cf. rechercher_candidats_multiples) plutôt que
        # de les chaîner -- le worker n'accepte qu'un job à la fois
        # (self._occupe), et lancer les deux dupliquerait le calcul
        # matchTemplate pour rien : le meilleur des candidats multiples
        # (résultats[0], cf. _sur_resultats_multiples_detection) EST le
        # même résultat que l'ancien mode simple aurait donné, seuil de
        # confiance appliqué en aval plutôt qu'en amont du calcul.
        self._detection_worker.demander_detection_multiple(
            image_propre, self._templates_bgr,
            self.composant.seuil_candidats_potentiels,
            self.composant.flou_noyau,
            self.composant.code_filtre,
        )

    def _sur_capture_propre_pour_detection_layout(self, image_propre: QImage):
        """REFONTE (mode composant_layout) -- pendant de
        _sur_capture_propre_pour_detection ci-dessus, pour cL.

        CORRECTIF (retour utilisateur explicite : "le templatematching
        fait aussi geler l'app, je veux que tu essai de mettre ces
        operations dans un wokers") -- l'appel à detecter_toutes_
        instances_composant_layout N'EST PLUS synchrone sur le thread GUI
        (contrairement à l'ancienne version de cette méthode, dont le
        raisonnement -- "rapide car UNE SEULE tentative par clic" -- s'est
        avéré faux sur des gabarits/filtres coûteux) : cette méthode
        prépare seulement la demande (décodage image) puis
        la délègue à self._detection_layout_worker (cf. sa docstring),
        exactement comme _lancer_detection le fait déjà pour cS via
        self._detection_worker. Le résultat arrive de façon asynchrone
        dans _sur_resultat_detection_layout ci-dessous.

        Affiche le résultat via ApercuLayoutLabel.MODE_INSTANCES (chaque
        occurrence détectée du ComposantLayout entourée, Zone assignées
        à l'intérieur) -- JAMAIS d'action exécutée (demande explicite
        utilisateur : "ce bouton doit être désactivé, tout ce qu'on doit
        faire lorsque c'est détecté et bien c'est juste entourer les
        éléments à l'écran, entourer avec les zones")."""
        self._detection_en_vol = False
        self._image_en_cours_analyse = None
        if not VISION_DISPONIBLE:
            self._arreter_test(action_executee=False)
            self.statut_label.setText("Détection visuelle indisponible (numpy/cv2 non installés).")
            return
        if self.composant_layout is None:
            self._arreter_test(action_executee=False)
            self.statut_label.setText("Aucun ComposantLayout valide sélectionné.")
            return

        self.statut_label.setText("Préparation de l'image pour l'analyse…")
        image_bgr = qimage_vers_bgr(image_propre)
        if image_bgr is None:
            self._arreter_test(action_executee=False)
            self.statut_label.setText("Image invalide reçue.")
            return

        # cf. docstring de self._derniere_image_layout -- conservée SANS
        # overlay, pour repeindre proprement si un futur appelant en
        # avait besoin (même prudence que self._image_en_cours_analyse
        # côté cS, jamais partagé avec cL -- cf. docstring de l'attribut).
        self._derniere_image_layout = image_propre
        # REFONTE (cf. SPEC_refonte_filtre_zones_dynamiques.md) : plus de
        # zones_gabarit ici -- le nommage/positionnement des zones vient
        # désormais entièrement de code_filtre à l'exécution (zones
        # "dynamiques"), il n'y a donc plus de gabarit statique de Zones à
        # transmettre au worker, ni de garde-fou "aucune Zone définie" à
        # faire ici (une absence de Zone n'empêche plus rien : le filtre
        # peut très bien ne dépendre d'aucune Zone statique).
        # AJOUT (code_scindement désormais OBLIGATOIRE au même titre que
        # code_filtre, demande explicite utilisateur -- cf. docstring du
        # champ sur ComposantLayout) : même style de garde-fou explicite
        # que pour zones_gabarit ci-dessus, plutôt que de laisser
        # DetectionScindementError remonter comme une erreur d'exécution
        # générique pour un cas de configuration incomplète, prévisible
        # et facile à corriger.
        if not self.composant_layout.code_scindement.strip():
            self._arreter_test(action_executee=False)
            self.statut_label.setText("Aucun code de scindement défini dans ce ComposantLayout -- rien à détecter.")
            self._afficher_apercu_layout_avec_instances(image_propre, [])
            return

        # cf. docstring de self._composant_layout_en_cours_analyse --
        # même prudence que self.composant_layout_nom sur le panneau de
        # réglages : la sélection dans composant_combo peut changer
        # PENDANT que le worker calcule (job asynchrone maintenant),
        # donc le nom/libellé du composant_layout à utiliser dans le
        # statut de résultat est figé ICI, au moment de la demande,
        # plutôt que relu depuis self.composant_layout (qui pourrait déjà
        # pointer sur autre chose) une fois le résultat revenu.
        self._composant_layout_en_cours_analyse = self.composant_layout
        self.statut_label.setText("Analyse en cours (filtre)…")
        # REFONTE : signature allégée en même temps que DetectionLayoutWorker
        # (cf. sa docstring) -- plus de zones_gabarit/seuil_confiance/
        # delta_conflit/distance_max_regroupement_px à transmettre.
        if not self._detection_layout_worker.demander_detection_layout(
            image_bgr, self.composant_layout.code_scindement, self.composant_layout.code_filtre,
        ):
            # Ne devrait pas arriver (une seule tentative par clic, cf.
            # docstring de la classe) -- filet de sécurité si le worker
            # était malgré tout déjà occupé.
            self._composant_layout_en_cours_analyse = None
            self._arreter_test(action_executee=False)
            self.statut_label.setText("Détection déjà en cours -- réessayez dans un instant.")

    def _sur_resultat_detection_layout(self, instances: list, erreur: Optional[Union["DetectionLayoutError", "DetectionScindementError"]]):
        """Slot connecté à DetectionLayoutWorker.resultat_layout_pret --
        pendant, pour cL, de _sur_resultat_detection (cS) ci-dessus.
        Contient la suite de l'ancienne _sur_capture_propre_pour_
        detection_layout (avant qu'elle ne devienne asynchrone, cf. sa
        docstring) : conversion des rectangles, affichage, statut.

        JAMAIS d'action exécutée en mode cL -- entourer les instances/
        Zones détectées EST le résultat final du test (cf. docstring de
        _sur_capture_propre_pour_detection_layout), donc _arreter_test
        appelé systématiquement, quel que soit le résultat."""
        image_propre = self._derniere_image_layout
        composant_layout = self._composant_layout_en_cours_analyse
        self._composant_layout_en_cours_analyse = None
        if image_propre is None or composant_layout is None:
            # Ne devrait pas arriver (garde-fou, même esprit que le
            # garde-fou "image is None" de _sur_resultat_detection côté
            # cS) -- l'onglet a pu être fermé/arrêté pendant le calcul.
            log_test_composant.warning(f"[{self._id_pilote}] _sur_resultat_detection_layout() : image/composant_layout=None (garde-fou déclenché)")
            return

        if erreur is not None:
            # DISTINCTION (deux codes désormais impliqués, cf. docstring
            # de la classe) -- un message générique "Erreur du filtre"
            # pour une DetectionScindementError induirait l'utilisateur
            # en erreur (il irait corriger le mauvais sous-onglet).
            prefixe = "Erreur du scindement" if isinstance(erreur, DetectionScindementError) else "Erreur du filtre"
            self._arreter_test(action_executee=False)
            self.statut_label.setText(f"{prefixe} : {erreur}")
            self._afficher_apercu_layout_avec_instances(image_propre, [])
            return

        # Conversion englobant/zones (tuples x,y,l,h pixels image) -> QRect,
        # même conversion que l'ancien ComposantLayoutConfigScreen._demarrer_
        # test_detection (cf. son docstring).
        instances_qrect = []
        for inst in instances:
            instances_qrect.append({
                "englobant": QRect(*inst["englobant"]),
                "zones": {nom: QRect(*rect) for nom, rect in inst["zones"].items()},
            })
        # cf. docstring de self._dernieres_instances_layout -- mémorisées
        # AVANT l'affichage, pour que le toggle "Afficher les zones"
        # puisse rebasculer sans redétecter (même image self._derniere_
        # image_layout, déjà conservée juste au-dessus).
        self._dernieres_instances_layout = instances_qrect
        self._afficher_apercu_layout_avec_instances(image_propre, instances_qrect)

        self._arreter_test(action_executee=False)
        if not instances:
            self.statut_label.setText(f"Aucun « {composant_layout.nom} » détecté.")
        else:
            nb = len(instances)
            suffixe = "s" if nb > 1 else ""
            self.statut_label.setText(f"{nb} « {composant_layout.nom} »{suffixe} détecté{suffixe}.")

    def _afficher_apercu_layout_avec_instances(self, image: QImage, instances_qrect: list):
        """Pendant, pour le mode cL, de _afficher_apercu_avec_resultat
        (mode cS) -- MÊME procédé exactement (retour utilisateur : "pourquoi
        tu ne veux pas reprendre exactement le même process que le mode
        cS") : peint les rectangles UNE SEULE FOIS, directement dans le
        QPixmap via QPainter, puis setPixmap()/resize() sur apercu_label
        (LabelApercuRedimensionnable, QLabel natif) -- jamais un paintEvent
        Python réévalué à chaque repaint (cf. ex-ApercuLayoutLabel.
        paintEvent, retiré : c'est LUI qui causait le freeze pendant le
        drag, cf. docstring du bloc de substitution dans __init__).

        instances_qrect : liste de {"englobant": QRect, "zones": {nom:
        QRect}} en coordonnées de l'image -- englobant en VERT (couleur_
        succes du composant_layout si définie, sinon Mocha.green -- pas de
        couleur_succes dédiée sur ComposantLayout à ce jour, repli
        systématique), chaque Zone assignée à l'intérieur en couleur_zone
        (cf. ComposantLayout.couleur_zone/epaisseur_zone, réglages déjà
        utilisés par l'ancien ApercuLayoutLabel.definir_zones_nommees)."""
        pixmap = QPixmap.fromImage(image.copy())
        if instances_qrect and image.width() > 0 and image.height() > 0:
            painter = QPainter(pixmap)
            pen_englobant = QPen(QColor(Mocha.green))
            pen_englobant.setWidth(3)
            couleur_zone = self.composant_layout.couleur_zone if self.composant_layout is not None else Mocha.mauve
            epaisseur_zone = max(1, self.composant_layout.epaisseur_zone) if self.composant_layout is not None else 2
            pen_zone = QPen(QColor(couleur_zone))
            pen_zone.setWidth(epaisseur_zone)
            painter.setBrush(Qt.NoBrush)
            # cf. docstring de self._afficher_zones_layout et du bouton
            # "Afficher les zones" (_on_toggle_afficher_zones_layout) --
            # l'englobant vert reste TOUJOURS dessiné (c'est le résultat
            # de détection lui-même), seules les Zones à l'intérieur sont
            # conditionnées au toggle.
            for instance in instances_qrect:
                painter.setPen(pen_englobant)
                painter.drawRect(instance["englobant"])
                if self._afficher_zones_layout:
                    painter.setPen(pen_zone)
                    for rect_zone in instance["zones"].values():
                        painter.drawRect(rect_zone)
            painter.end()
        self.apercu_layout_label.setPixmap(pixmap)
        self.apercu_layout_label.resize(pixmap.size())

    def _on_toggle_afficher_zones_layout(self, coche: bool):
        """Slot du bouton "Afficher les zones" (mode cL uniquement, cf.
        sa construction dans __init__). Rebasculer ce toggle ne relance
        JAMAIS de détection -- il redessine simplement la DERNIÈRE image
        analysée (self._derniere_image_layout) avec les DERNIÈRES
        instances détectées (self._dernieres_instances_layout), exactement
        comme _sur_capture_propre_pour_detection_layout le fait après une
        détection, sans repasser par detecter_toutes_instances_composant_
        layout. Si aucun test n'a encore été lancé (self._derniere_image_
        layout est None, cf. son initialisation), ne fait rien -- rien à
        redessiner."""
        self._afficher_zones_layout = coche
        if self._derniere_image_layout is None:
            return
        self._afficher_apercu_layout_avec_instances(self._derniere_image_layout, self._dernieres_instances_layout)

    def _sur_resultat_detection(self, resultat: Optional[dict], erreur: Optional["DetectionAmbigueError"], score_brut: Optional[float]):
        """Slot connecté à DetectionWorker.resultat_pret -- reçoit le
        résultat de l'UNIQUE tentative de détection lancée par
        _lancer_detection (jamais appelé en boucle continue, cf. correctif :
        avant ce patch, la détection tournait sur CHAQUE frame reçue et
        directement sur le thread GUI, ce qui pouvait figer la machine).

        Toute frame reçue pendant que ce résultat était en vol a été
        ignorée (cf. _detection_en_vol) -- l'aperçu qu'elles portaient est
        donc perdu, mais celui-ci (associé à l'image réellement envoyée au
        worker, self._image_en_cours_analyse) reste affiché."""
        log_test_composant.info(
            f"[{self._id_pilote}] _sur_resultat_detection() : "
            f"resultat={'trouvé' if resultat is not None else None} erreur={erreur!r} score_brut={score_brut}"
        )
        self._detection_en_vol = False
        image = self._image_en_cours_analyse
        self._image_en_cours_analyse = None
        if image is None:
            log_test_composant.warning(f"[{self._id_pilote}] _sur_resultat_detection() : image_en_cours_analyse=None (garde-fou déclenché)")
            return  # ne devrait pas arriver, garde-fou

        if erreur is not None:
            self._arreter_test(action_executee=False)
            self.statut_label.setText(f"Ambigu : {erreur}")
            return

        # cf. docstring de self._dernier_overlay_affiche -- même logique
        # que _sur_resultats_multiples_detection, sans liste de candidats
        # jaunes ni conflit ici (mode simple legacy, plus jamais emprunté
        # en pratique depuis le passage à demander_detection_multiple
        # dans _sur_capture_propre_pour_detection -- cf. son docstring --
        # mais le tuple garde 3 éléments pour rester déballable sans
        # erreur par _sur_nouvelle_frame si ce chemin était un jour
        # réactivé).
        self._dernier_overlay_affiche = (resultat, None, None)
        self._afficher_apercu_avec_resultat(image, resultat)

        if resultat is None:
            # Pas de détection sur cette tentative -- le test reste arrêté
            # (comportement voulu : une seule tentative par clic sur
            # "Démarrer le test", jamais un retry automatique en boucle).
            self._test_depuis_image_deposee = False  # cf. docstring -- ne doit jamais rester bloqué à True
            self._arreter_test(action_executee=False)
            info_score = f" (meilleure correspondance : {score_brut:.2f})" if score_brut is not None else ""
            self.statut_label.setText(
                f"Aucune correspondance suffisante sur cette tentative{info_score}. "
                "Relancez le test si besoin."
            )
            return

        nb_variantes = len(self._templates_bgr)
        info_variante = (
            f", variante {resultat['index_variante'] + 1}/{nb_variantes}" if nb_variantes > 1 else ""
        )
        # AJOUT (retour utilisateur : jamais d'action réelle -- clic,
        # saisie... -- sur une instance réseau à partir d'un résultat de
        # détection obtenu sur une image DÉPOSÉE, cf. docstring de
        # self._test_depuis_image_deposee) -- affiche le résultat
        # normalement (rectangle déjà dessiné ci-dessus), mais s'arrête
        # ICI au lieu d'appeler _executer_action.
        if self._test_depuis_image_deposee:
            self._test_depuis_image_deposee = False
            self._arreter_test(action_executee=False)
            self.statut_label.setText(
                f"Détecté sur l'image déposée (score {resultat['score']:.2f}, "
                f"échelle {resultat['echelle']:.2f}{info_variante}) -- aucune action exécutée."
            )
            return
        self.statut_label.setText(
            f"Détecté (score {resultat['score']:.2f}, échelle {resultat['echelle']:.2f}"
            f"{info_variante}) — exécution de l'action…"
        )
        self._executer_action(resultat)

    def _sur_resultats_multiples_detection(self, candidats: list, erreur: Optional["DetectionFiltreComposantSingleError"] = None):
        """Slot connecté à DetectionWorker.resultats_multiples_prets --
        pendant de _sur_resultat_detection() ci-dessus, pour le mode
        "candidats multiples" (cf. rechercher_candidats_multiples,
        Composant.seuil_candidats_potentiels). Reproduit la même logique
        de déclenchement d'action (meilleur candidat seulement, s'il
        dépasse seuil_confiance -- seuil_candidats_potentiels sert
        UNIQUEMENT à décider quels candidats sont montrés, jamais à
        décider si l'action se déclenche), mais transmet la LISTE
        complète à _afficher_apercu_avec_resultat pour le rendu
        vert (meilleur) / jaune (autres candidats potentiels).

        erreur (AJOUT, cf. ComposantSingle.code_filtre) : non None quand
        code_filtre a levé une DetectionFiltreComposantSingleError (code
        invalide ou variable 'resultat' mal formée) -- affiché en toutes
        lettres dans le statut, test arrêté, MÊME traitement que
        l'ambiguïté (erreur is not None) dans _sur_resultat_detection."""
        log_test_composant.info(
            f"[{self._id_pilote}] _sur_resultats_multiples_detection() : {len(candidats)} candidat(s) erreur={erreur!r}"
        )
        self._detection_en_vol = False
        self._derniers_candidats_multiples = candidats
        image = self._image_en_cours_analyse
        self._image_en_cours_analyse = None
        if image is None:
            log_test_composant.warning(f"[{self._id_pilote}] _sur_resultats_multiples_detection() : image_en_cours_analyse=None (garde-fou déclenché)")
            return  # ne devrait pas arriver, garde-fou

        if erreur is not None:
            self._arreter_test(action_executee=False)
            self.statut_label.setText(f"Erreur du filtre (code_filtre) : {erreur}")
            return

        meilleur = candidats[0] if candidats else None

        # BUGFIX (retour utilisateur explicite : "je narrive pas a tester
        # une variante specifique ,sa prend toujour la premiere variant
        # meme quand jai selectionner une autre variaent") -- AVANT ce
        # correctif, la décision "détecté ou pas" et le calcul des
        # conflits ci-dessous utilisaient inconditionnellement
        # self.composant.seuil_confiance/delta_conflit (les valeurs PAR
        # DÉFAUT du composant, jamais mises à jour par
        # ComposantReglagesNumeriquesPanel qui écrit, lui, sur
        # variante.seuil_confiance/delta_conflit -- cf. sa docstring
        # "réglage silencieusement sans effet observable pendant un
        # test"). Résultat : quel que soit le réglage de seuil de LA
        # VARIANTE réellement sélectionnée/testée (self._templates_bgr,
        # cf. _charger_templates_variante_unique), le verdict "détecté"
        # retombait toujours sur l'ancien seuil par défaut du composant --
        # donnant l'impression que le test ignore la variante choisie et
        # se comporte "toujours comme la première variante". self.
        # _templates_bgr ne contient qu'UNE entrée (image_bgr, Variante) --
        # cf. _charger_templates_variante_unique -- c'est donc SA
        # seuil_confiance/delta_conflit propre qu'il faut utiliser ici,
        # exactement comme rechercher_candidats_multiples le fait déjà
        # pour seuil_candidats_potentiels/flou_noyau/code_filtre. Repli
        # sur composant.<champ> uniquement dans le cas défensif où
        # l'élément ne serait pas une vraie Variante (cf. même repli dans
        # _charger_templates_variante_unique).
        variante_testee = (
            self._templates_bgr[0][1]
            if self._templates_bgr and isinstance(self._templates_bgr[0], tuple)
            and len(self._templates_bgr[0]) == 2 and isinstance(self._templates_bgr[0][1], Variante)
            else None
        )
        seuil_confiance_v = variante_testee.seuil_confiance if variante_testee is not None else self.composant.seuil_confiance
        delta_conflit_v = variante_testee.delta_conflit if variante_testee is not None else self.composant.delta_conflit

        # seuil_confiance (pas seuil_candidats_potentiels) décide si le
        # meilleur candidat compte comme "détecté" pour l'action -- même
        # seuil que l'ancien mode simple, comportement de déclenchement
        # d'action inchangé malgré le changement de mécanisme de recherche.
        detecte = meilleur is not None and meilleur["score"] >= seuil_confiance_v

        # PATCH (demande explicite utilisateur : "sa doit prendre en
        # compte le paramètre le delta de conflit, si deux correspondance
        # on un delta de conflit valide sa veux dire que il doivent etre
        # en vert puisque sa provoque déjà l'ambiguïté") -- même condition
        # que _departager_conflit (production, cf. sa docstring) : chaque
        # AUTRE candidat qui (1) dépasse lui aussi seuil_confiance ET (2)
        # a un écart de score avec le meilleur <= delta_conflit est en
        # conflit avec lui. Contrairement à la production (qui n'en
        # retient qu'UN via priorite_selection et cache l'ambiguïté à
        # l'exécution), l'écran de TEST les affiche tous en vert -- c'est
        # justement cette ambiguïté que l'utilisateur doit pouvoir
        # constater ici, avant qu'elle ne soit tranchée silencieusement
        # en production. delta_conflit <= 0 (désactivé, valeur par défaut
        # de Composant) -> liste toujours vide, comportement identique à
        # avant ce patch. BUGFIX ci-dessus : seuil_confiance_v/
        # delta_conflit_v (propres à la variante testée) remplacent ici
        # aussi self.composant.seuil_confiance/delta_conflit.
        candidats_en_conflit = []
        if detecte and delta_conflit_v and delta_conflit_v > 0:
            for candidat in candidats[1:]:
                if (candidat["score"] >= seuil_confiance_v
                        and (meilleur["score"] - candidat["score"]) <= delta_conflit_v):
                    candidats_en_conflit.append(candidat)

        # cf. docstring de self._dernier_overlay_affiche -- mémorisé AVANT
        # l'appel d'affichage lui-même (même valeurs), pour que la toute
        # prochaine frame du flux automatique (potentiellement reçue
        # avant même que ce _afficher_apercu_avec_resultat ne retourne,
        # cf. la boucle d'événements Qt) trouve déjà l'état à jour.
        # PATCH (candidats_en_conflit) -- mémorisé comme un tuple à 3
        # (pas 2) désormais ; cf. _sur_nouvelle_frame, seul autre lecteur
        # de ce tuple, adapté en conséquence.
        self._dernier_overlay_affiche = (meilleur if detecte else None, candidats, candidats_en_conflit)
        self._afficher_apercu_avec_resultat(image, meilleur if detecte else None, candidats, candidats_en_conflit)

        if not detecte:
            # cf. docstring de self._test_depuis_image_deposee -- ne doit
            # jamais rester bloqué à True (même correctif que la branche
            # symétrique de _sur_resultat_detection ci-dessus) : sans ce
            # reset, un échec de détection sur une image déposée laisserait
            # le flag à True, et une détection RÉUSSIE lors d'un futur test
            # réseau normal (après un nouveau drop puis un test réseau
            # classique, si un tel chemin de sortie existait) se verrait
            # à tort privée de _executer_action.
            self._test_depuis_image_deposee = False
            self._arreter_test(action_executee=False)
            info_score = f" (meilleure correspondance : {meilleur['score']:.2f})" if meilleur is not None else ""
            self.statut_label.setText(
                f"Aucune correspondance suffisante sur cette tentative{info_score}. "
                "Relancez le test si besoin."
            )
            return

        nb_variantes = len(self._templates_bgr)
        info_variante = (
            f", variante {meilleur['index_variante'] + 1}/{nb_variantes}" if nb_variantes > 1 else ""
        )
        nb_autres = len(candidats) - 1
        info_autres = f", {nb_autres} autre(s) candidat(s) proche(s)" if nb_autres > 0 else ""
        # PATCH (cf. docstring candidats_en_conflit) -- signale
        # explicitement l'ambiguïté en toutes lettres dans le statut,
        # plutôt que de laisser l'utilisateur déduire un conflit
        # seulement du fait que plusieurs rectangles soient en vert.
        # BUGFIX (même correctif que ci-dessus) : affiche le delta_conflit
        # RÉELLEMENT appliqué (celui de la variante testée), pas l'ancien
        # self.composant.delta_conflit qui pouvait afficher une valeur
        # trompeuse (différente de celle configurée sur la variante).
        info_conflit = (
            f" -- ⚠ {len(candidats_en_conflit)} candidat(s) EN CONFLIT (delta_conflit={delta_conflit_v:.3f})"
            if candidats_en_conflit else ""
        )
        # AJOUT (retour utilisateur : jamais d'action réelle -- clic,
        # saisie... -- sur une instance réseau à partir d'un résultat de
        # détection obtenu sur une image DÉPOSÉE, cf. docstring de
        # self._test_depuis_image_deposee) -- MÊME correctif que
        # _sur_resultat_detection ci-dessus, appliqué ICI au chemin
        # RÉELLEMENT emprunté en pratique (cf. docstring de classe :
        # "mode simple legacy, plus jamais emprunté... depuis le passage
        # à demander_detection_multiple").
        if self._test_depuis_image_deposee:
            self._test_depuis_image_deposee = False
            self._arreter_test(action_executee=False)
            self.statut_label.setText(
                f"Détecté sur l'image déposée (score {meilleur['score']:.2f}, échelle {meilleur['echelle']:.2f}"
                f"{info_variante}{info_autres}){info_conflit} -- aucune action exécutée."
            )
            return
        self.statut_label.setText(
            f"Détecté (score {meilleur['score']:.2f}, échelle {meilleur['echelle']:.2f}"
            f"{info_variante}{info_autres}){info_conflit} — exécution de l'action…"
        )
        self._executer_action(meilleur)

    def _afficher_apercu_avec_resultat(self, image: QImage, resultat: Optional[dict], candidats: Optional[list] = None,
                                        candidats_en_conflit: Optional[list] = None):
        """Affichage avec rectangle de détection -- remplace l'usage direct
        de _afficher_apercu_defaut (celle de InstanceApercuScreen, qui ne
        sait afficher qu'une image brute sans overlay).

        Échelle réelle (1:1, cf. PanneauRenduInstance.apercu_scroll) : le
        pixmap n'est plus mis à l'échelle de apercu_label, donc echelle_x/
        echelle_y valent toujours 1.0 -- resultat["x"/"y"/"largeur"/
        "hauteur"] sont déjà exprimés dans le repère de l'image d'origine,
        le rectangle se dessine donc directement à ces coordonnées.

        candidats : PATCH (demande explicite utilisateur, mode candidats
        multiples) -- liste optionnelle de TOUS les candidats trouvés
        (cf. rechercher_candidats_multiples), triée par score décroissant.
        Si fournie, chaque candidat AUTRE que `resultat` (le meilleur,
        déjà dessiné en vert ci-dessous) ET AUTRE que ceux listés dans
        candidats_en_conflit (cf. ci-dessous) est dessiné en JAUNE avec
        son score affiché au-dessus -- pour repérer d'un coup d'œil les
        composants visuellement proches qui auraient pu être confondus
        avec la bonne cible. None (défaut) = comportement inchangé
        (aucun candidat jaune), utilisé par tous les appelants existants
        qui ne passent pas ce 3e argument.

        candidats_en_conflit : PATCH (demande explicite utilisateur : "sa
        doit prendre en compte le paramètre le delta de conflit, si deux
        correspondance on un delta de conflit valide sa veux dire que il
        doivent etre en vert puisque sa provoque déjà l'ambiguïté") --
        liste optionnelle de candidats supplémentaires à dessiner EN VERT
        (comme `resultat`, pas en jaune) -- cf. _sur_resultats_multiples_
        detection, qui y place tout candidat dont l'écart de score avec
        `resultat` est <= Composant.delta_conflit (même seuil que le
        mécanisme de production _departager_conflit/rechercher_composant,
        cf. leur docstring -- mais ICI, contrairement à la production qui
        tranche automatiquement via priorite_selection et n'en retient
        qu'UN, les deux (ou plus) restent visibles en vert simultanément :
        c'est précisément CE cas d'ambiguïté que l'écran de test doit
        signaler à l'utilisateur, pas le résoudre silencieusement à sa
        place. None (défaut) = comportement inchangé (resultat seul en
        vert), utilisé par tous les appelants existants qui ne passent
        pas ce 4e argument."""
        # FIX (bug de cache QPixmap::fromImage, reproduit et confirmé par
        # test réel bout-en-bout) : quand la MÊME instance Python de QImage
        # (même objet, cf. self._image_en_cours_analyse réutilisé entre
        # _sur_capture_propre_pour_detection puis _sur_resultat_detection/
        # _sur_resultats_multiples_detection) est convertie en QPixmap
        # plusieurs fois de suite via QPixmap.fromImage(), Qt (observé sur
        # le backend offscreen, mais rien n'indique que ce soit spécifique
        # à ce backend) réutilise un pixmap déjà en cache pour cette même
        # QImage plutôt que d'en créer un nouveau -- le QPainter dessine
        # alors correctement sur l'objet retourné, mais une lecture
        # ultérieure de apercu_label.pixmap() peut renvoyer un pixmap
        # différent (même cacheKey qu'un appel précédent), SANS le
        # rectangle vert/jaune qu'on vient de dessiner : le rendu final
        # affiché reste l'image brute, sans overlay, alors que l'action a
        # bien été déclenchée (score au-dessus du seuil). image.copy()
        # force une QImage détachée (nouvelle identité pour Qt) à chaque
        # appel, ce qui contourne ce cache de façon fiable -- confirmé par
        # test différentiel (bug présent avec l'image partagée, absent
        # avec .copy()).
        pixmap = QPixmap.fromImage(image.copy())
        if image.width() > 0 and image.height() > 0:
            painter = QPainter(pixmap)

            # Ensemble de tous les résultats dessinés en VERT (le meilleur
            # + ceux en conflit, cf. docstring candidats_en_conflit) --
            # comparaison par IDENTITÉ (is), pas par égalité de valeur :
            # deux candidats distincts peuvent avoir des scores/positions
            # identiques par coïncidence, seule l'identité de l'objet dict
            # garantit qu'on exclut le BON candidat du rendu jaune ci-
            # dessous (même logique que l'exclusion resultat/candidat déjà
            # en place avant ce patch).
            resultats_verts = []
            if resultat is not None:
                resultats_verts.append(resultat)
            if candidats_en_conflit:
                resultats_verts.extend(candidats_en_conflit)

            if candidats:
                # PATCH (demande explicite utilisateur : "jai du mal a
                # lire parfois les texte de corespondance ... tu vas
                # mettre une des widget pour la configuration de couleur
                # ... la couleur a afficher pour les echecs") -- couleur
                # réglable par composant (cf. Composant.couleur_echec,
                # ComposantReglagesNumeriquesPanel) au lieu de Mocha.
                # yellow fixe ; repli sur Mocha.yellow si self.composant
                # est None (ne devrait pas arriver ici en pratique --
                # `candidats` implique une détection déjà lancée sur un
                # composant sélectionné -- mais reste défensif plutôt que
                # de crasher sur un self.composant.couleur_echec attribué
                # à None).
                couleur_echec = self.composant.couleur_echec if self.composant is not None else Mocha.yellow
                pen_jaune = QPen(QColor(couleur_echec))
                pen_jaune.setWidth(2)
                painter.setPen(pen_jaune)
                police = painter.font()
                police.setBold(True)
                painter.setFont(police)
                for candidat in candidats:
                    if any(candidat is vert for vert in resultats_verts):
                        continue  # dessiné en vert plus bas, jamais en double
                    x, y = round(candidat["x"]), round(candidat["y"])
                    l, h = round(candidat["largeur"]), round(candidat["hauteur"])
                    painter.drawRect(x, y, l, h)
                    painter.drawText(x, max(0, y - 6), f"{candidat['score']:.2f}")

            if resultats_verts:
                # PATCH (même demande explicite ci-dessus, "la couleur a
                # ffficher pour les sucess") -- couleur réglable par
                # composant (cf. Composant.couleur_succes), même repli
                # défensif que couleur_echec ci-dessus.
                couleur_succes = self.composant.couleur_succes if self.composant is not None else Mocha.green
                pen_vert = QPen(QColor(couleur_succes))
                pen_vert.setWidth(2)
                painter.setPen(pen_vert)
                police = painter.font()
                police.setBold(True)
                painter.setFont(police)
                for vert in resultats_verts:
                    x, y = round(vert["x"]), round(vert["y"])
                    l, h = round(vert["largeur"]), round(vert["hauteur"])
                    painter.drawRect(x, y, l, h)
                    if candidats:
                        # Score aussi affiché quand le mode multiple est
                        # actif, par cohérence visuelle avec les
                        # rectangles jaunes voisins (sinon un vert
                        # resterait "muet") -- y compris pour un candidat
                        # en conflit, pas seulement `resultat` : c'est
                        # justement l'écart (ou son absence) entre ces
                        # scores affichés qui rend l'ambiguïté lisible
                        # d'un coup d'œil.
                        painter.drawText(x, max(0, y - 6), f"{vert['score']:.2f}")

            painter.end()
        self.apercu_label.setPixmap(pixmap)
        self.apercu_label.resize(pixmap.size())
        # CORRECTIF (retour explicite utilisateur : "sa doit prendre
        # l'image sans les dessins qui sont dessus, dessins de
        # correspondance") -- pixmap ci-dessus est l'image ANNOTÉE
        # (rectangles verts/jaunes + scores, dessinés juste au-dessus par
        # le QPainter) et devient le pixmap affiché sur apercu_label. Sans
        # ce correctif, ApercuDragHandle (cf. sa docstring : lit
        # label.pixmap() en dernier recours quand _pixmap_base est absent,
        # ce qui EST le cas ici -- apercu_label est un LabelApercuRedimen-
        # sionnable standard, pas un ApercuTraceableLabel) glisserait cette
        # même image annotée, montrant les rectangles de correspondance
        # dans le fichier exporté -- alors que l'utilisateur veut glisser
        # la capture BRUTE de l'instance, telle qu'elle serait sans le
        # test de composant en cours. _pixmap_brute_sans_overlay est donc
        # posée ICI (image, PAS pixmap : la QImage reçue avant toute
        # annotation), séparément du pixmap réellement affiché à l'écran
        # -- ApercuDragHandle la préfère désormais à label.pixmap().
        self.apercu_label._pixmap_brute_sans_overlay = QPixmap.fromImage(image.copy())

    def arreter(self):
        """Coupe la détection (et toute séquence d'action en cours), arrête
        le QThread de détection et ferme la connexion réseau propre à cet
        onglet (cf. InstanceApercuScreen.arreter_reseau). Appelé par
        ApplicationsScreen juste avant de fermer l'onglet contenant cet
        écran, pour ne pas laisser une connexion/boucle/thread tourner sur
        un widget détruit."""
        log_test_composant.info(
            f"[{self._id_pilote}] arreter() : _en_cours={self._en_cours} "
            f"sequenceur_actif={self._sequenceur is not None}"
        )
        # cf. docstring de ReglagesApp.dernier_profil_test_reseau et de
        # self._test_a_ete_lance -- sauvegarde le profil RÉSEAU courant
        # UNIQUEMENT si :
        #   1. un test a RÉELLEMENT été lancé au moins une fois sur cet
        #      écran (sinon : ouvrir puis fermer sans tester ne doit RIEN
        #      changer à l'ancien profil déjà sauvegardé -- décision
        #      explicite utilisateur) ;
        #   2. la cible actuelle est RÉSEAU (self._id_executant_reseau
        #      non None) -- une cible LOCALE n'a pas de sens à
        #      resélectionner d'une session à l'autre (cf. docstring du
        #      champ), donc on n'écrit rien dans ce cas plutôt que
        #      d'effacer un ancien profil réseau valide par une valeur
        #      locale sans objet.
        # Lu et sauvegardé AVANT arreter_reseau()/tout autre nettoyage
        # plus bas, par précaution -- même si aucun ne réinitialise
        # actuellement ces deux attributs.
        if self._test_a_ete_lance and self._id_executant_reseau is not None:
            nouveau_profil = [self._id_executant_reseau, self._instance_id_reseau]
            # CORRECTIF (bug "le combo retombe sur (aucune sélection) après
            # un Retour en mode LOCAL") -- la "dernière cible testée" est
            # UNIQUE par nature : c'est SOIT un profil réseau, SOIT un
            # profil local, jamais les deux. Avant ce correctif, chaque
            # branche n'écrivait QUE son propre champ sans jamais effacer
            # l'autre, et rien nulle part ne remettait dernier_profil_test_
            # reseau à None : dès qu'UN SEUL test réseau avait été lancé
            # une fois dans l'histoire de l'installation, ce champ restait
            # renseigné indéfiniment dans reglages.json, et la condition
            # de priorité de _repeupler_selecteur_cible (`not self.reglages.
            # dernier_profil_test_reseau`, cf. §3.3) neutralisait
            # DÉFINITIVEMENT la resélection automatique du profil LOCAL --
            # en silence, sans exception ni log, y compris quand le profil
            # réseau mémorisé n'était plus retrouvable (sAutoniax
            # déconnecté), auquel cas le combo retombait sur "(aucune
            # sélection)". L'effacement croisé ci-dessous rétablit
            # l'invariant "un seul des deux champs est renseigné à la
            # fois" et rend cette condition de priorité inoffensive.
            #
            # La garde teste maintenant si QUOI QUE CE SOIT change (pas
            # seulement le profil réseau) : sans le second terme, un
            # retest sur le MÊME profil réseau sauterait le save() et ne
            # nettoierait donc jamais un dernier_profil_test_local
            # résiduel.
            if (nouveau_profil != self.reglages.dernier_profil_test_reseau
                    or self.reglages.dernier_profil_test_local is not None):
                self.reglages.dernier_profil_test_reseau = nouveau_profil
                self.reglages.dernier_profil_test_local = None
                self.reglages.save()
                log_test_composant.info(
                    f"[{self._id_pilote}] arreter() : profil réseau sauvegardé "
                    f"pour resélection future -> {nouveau_profil!r}"
                )
        elif self._test_a_ete_lance and self._instance_liee is not None:
            # AJOUT (SPEC_GLOBALE_AutoniaX.md, Partie C §3.4) -- cas
            # LOCAL, symétrique du bloc réseau ci-dessus. self._instance_
            # liee est l'instance_id LOCAL brut de la cible actuellement
            # liée (hérité de InstanceApercuScreen, cf. son __init__) --
            # on retrouve le NOM du profil correspondant en cherchant
            # dans self._instance_id_par_profil_local (reconstruit à
            # chaque instances_list, cf. _sur_liste_instances_recue)
            # quel nom de profil pointe vers cet instance_id précis --
            # inverse de la resélection faite en _repeupler_selecteur_
            # cible (§3.3). Si aucune correspondance n'est trouvée (cas
            # limite, ex. instance_id qui ne suit aucune convention de
            # nommage reconnue par _associer_profils_actifs_locaux), on
            # ne sauvegarde simplement rien -- pas d'exception, pas
            # d'écrasement du profil local précédemment sauvegardé par
            # une valeur fausse.
            nom_profil_actuel = next(
                (nom for nom, iid in self._instance_id_par_profil_local.items()
                 if iid == self._instance_liee),
                None,
            )
            # CORRECTIF (cf. le commentaire détaillé de la branche RÉSEAU
            # ci-dessus) -- effacement croisé symétrique : sauvegarder un
            # profil LOCAL efface le profil RÉSEAU mémorisé, sans quoi la
            # priorité réseau de _repeupler_selecteur_cible empêcherait à
            # jamais la resélection de CE profil local.
            #
            # La garde teste maintenant si QUOI QUE CE SOIT change (pas
            # seulement le nom local) : sans le second terme, refermer
            # l'onglet sur le MÊME profil local que la fois précédente
            # sauterait le save() -- et c'est EXACTEMENT le cas nominal du
            # bug -- donc ne nettoierait jamais le dernier_profil_test_
            # reseau résiduel qui bloque la resélection.
            if nom_profil_actuel and (
                    nom_profil_actuel != self.reglages.dernier_profil_test_local
                    or self.reglages.dernier_profil_test_reseau is not None):
                self.reglages.dernier_profil_test_local = nom_profil_actuel
                self.reglages.dernier_profil_test_reseau = None
                self.reglages.save()
                log_test_composant.info(
                    f"[{self._id_pilote}] arreter() : profil local sauvegardé "
                    f"pour resélection future -> {nom_profil_actuel!r}"
                )
        if self._sequenceur is not None:
            self._sequenceur.arreter()
            try:
                self._sequenceur.termine.disconnect()
                self._sequenceur.erreur_sequence.disconnect()
            except (RuntimeError, TypeError):
                pass
            self._sequenceur = None
        if self._adaptateur_reseau_sautoniax is not None:
            self._adaptateur_reseau_sautoniax.deconnecter()
        self._adaptateur_reseau_sautoniax = None
        if self._en_cours:
            self._arreter_test(action_executee=False)
        self.arreter_reseau()
        # Le worker peut être en train de calculer (job en vol) : quit()
        # arrête la boucle d'événements du thread une fois le job courant
        # terminé (QueuedConnection déjà en attente ou en cours), wait()
        # bloque jusqu'à la fin réelle du thread -- évite un thread Python
        # actif après destruction du widget (crash silencieux ou fuite).
        self._detection_thread.quit()
        self._detection_thread.wait(3000)
        # cf. docstring de self._detection_layout_thread dans __init__ --
        # même arrêt propre que _detection_thread ci-dessus.
        self._detection_layout_thread.quit()
        self._detection_layout_thread.wait(3000)
        # cf. docstring de self._lecture_image_thread dans __init__.
        self._lecture_image_thread.quit()
        self._lecture_image_thread.wait(3000)

    def _executer_action(self, resultat: dict):
        """Calcule le point cible (respecte la zone de clic personnalisée
        du composant si définie, point 2) puis lance l'action choisie de
        façon asynchrone (SequenceurActionReseau, via la connexion réseau
        propre à cet onglet) avec les paramètres saisis. Le test n'est
        marqué "arrêté" qu'à réception de termine() ou erreur_sequence()."""
        composant = self.composant
        if composant.zone_clic_mode == "personnalise" and not composant.zone_clic_rect.est_vide():
            zone = composant.zone_clic_rect
            # zone est en coordonnées de l'image d'origine du composant ;
            # comme le template n'a pas été redimensionné avant la mise à
            # l'échelle de détection, on applique le même facteur d'échelle
            # que celui trouvé pour rester cohérent avec la zone détectée.
            echelle = resultat["echelle"]
            cx = resultat["x"] + round(zone.x * echelle + zone.largeur * echelle / 2)
            cy = resultat["y"] + round(zone.y * echelle + zone.hauteur * echelle / 2)
        else:
            cx = resultat["x"] + resultat["largeur"] // 2
            cy = resultat["y"] + resultat["hauteur"] // 2

        action = self.action_combo.currentData()
        params = {
            "duree_deplacement_ms": self.duree_deplacement_spin.value(),
            "duree_clic_ms": self.duree_clic_spin.value(),
            "direction": self.scroll_direction_combo.currentData(),
            "quantite_crans": self.scroll_quantite_spin.value(),
            "frequence_crans_par_sec": self.scroll_frequence_spin.value(),
            "texte": self.saisir_texte_edit.text(),
            "delai_min_ms": self.delai_min_spin.value(),
            "delai_max_ms": self.delai_max_spin.value(),
        }

        largeur_fenetre, hauteur_fenetre = self._derniere_taille_frame

        log_test_composant.info(
            f"[{self._id_pilote}] _executer_action() : action={action!r} cible=({cx},{cy}) "
            f"instance={self._instance_liee!r} id_executant_reseau={self._id_executant_reseau!r} "
            f"taille_fenetre=({largeur_fenetre},{hauteur_fenetre})"
        )
        # PATCH (cible RÉSEAU, cf. _AdapteurSequenceurReseauSautoniax et
        # definir_client_serveur_t) -- SequenceurActionReseau n'utilise
        # que .command_result_recu/.envoyer_commande sur "client_reseau"
        # (duck-typing, cf. sa docstring/_envoyer_commande) : l'adaptateur
        # expose exactement ces deux points, donc réutilisable TEL QUEL,
        # aucune duplication de la logique de séquencement/timeout. Une
        # référence est gardée (self._adaptateur_reseau_sautoniax) pour
        # pouvoir la déconnecter proprement dans _executer (cf. sa
        # docstring : évite qu'un signal ClientServeurT, qui vit plus
        # longtemps que ce séquenceur, continue de réémettre vers un
        # adaptateur périmé après la fin de CETTE tentative).
        self._adaptateur_reseau_sautoniax = None
        if self._id_executant_reseau is not None and self._client_serveur_t is not None:
            instance_id_reseau = self._instance_id_reseau_effectif()
            self._adaptateur_reseau_sautoniax = _AdapteurSequenceurReseauSautoniax(
                self._client_serveur_t, self._id_executant_reseau, instance_id_reseau, self,
            )
            client_pour_sequenceur = self._adaptateur_reseau_sautoniax
            instance_id_pour_sequenceur = instance_id_reseau
        else:
            client_pour_sequenceur = self.client_reseau
            instance_id_pour_sequenceur = self._instance_liee
        self._sequenceur = SequenceurActionReseau(
            client_pour_sequenceur, instance_id_pour_sequenceur, largeur_fenetre, hauteur_fenetre, self,
        )
        self._sequenceur.termine.connect(self._on_action_terminee)
        self._sequenceur.erreur_sequence.connect(self._on_action_erreur)
        self._sequenceur.lancer(action, cx, cy, params)

    def _nettoyer_sequenceur(self):
        """Point d'arrêt UNIQUE pour self._sequenceur (et son éventuel
        self._adaptateur_reseau_sautoniax, cf. _executer_action) --
        appelée depuis _on_action_terminee, _on_action_erreur, ET arreter()
        (plutôt que de dupliquer cette même séquence trois fois), pour
        garantir qu'aucun futur appelant ne puisse oublier de déconnecter
        l'adaptateur réseau en même temps que le séquenceur.

        FIX (sequenceur) : sans le .arreter() ci-dessous, la connexion Qt
        client_reseau.command_result_recu -> sequenceur._sur_command_result
        n'était jamais déconnectée (seul SequenceurActionReseau.arreter()
        le fait) -- chaque test réussi laissait une connexion Qt fantôme
        accumulée sur ce signal, câblée à un QObject orphelin (parenté Qt
        = self, donc pas un leak mémoire au sens strict, mais un slot mort
        qui reste appelé sur CHAQUE command_result reçu par la suite tant
        que le widget existe). Même raisonnement pour l'adaptateur réseau
        -- cf. sa méthode deconnecter()."""
        if self._sequenceur is not None:
            self._sequenceur.arreter()
        self._sequenceur = None
        if self._adaptateur_reseau_sautoniax is not None:
            self._adaptateur_reseau_sautoniax.deconnecter()
        self._adaptateur_reseau_sautoniax = None

    def _on_action_terminee(self):
        log_test_composant.info(f"[{self._id_pilote}] _on_action_terminee()")
        self._nettoyer_sequenceur()
        self._arreter_test(action_executee=True)
        self.statut_label.setText("Action exécutée avec succès.")

    def _on_action_erreur(self, message: str):
        log_test_composant.info(f"[{self._id_pilote}] _on_action_erreur() : {message!r}")
        self._nettoyer_sequenceur()
        self._arreter_test(action_executee=True)
        self.statut_label.setText(f"Échec de l'action : {message}")


# ---------------------------------------------------------------------------
# Écran "Coordonnée d'action" — version réduite de TestComposantScreen,
# dédiée à UNE seule chose : détecter le composant_reference d'une Action
# précise sur une fenêtre cible, puis laisser l'utilisateur TRACER (glisser-
# relâcher) une SURFACE directement sur l'aperçu, pour fixer zone_clic_rect
# de cette Action (relatif au coin haut-gauche du composant détecté, à
# l'échelle 1.0 — l'échelle de détection est neutralisée au moment du
# calcul pour rester stable quelle que soit la taille de la fenêtre au
# moment du tracé ultérieur en exécution réelle).
#
# Pas de "action à exécuter" ici (pas de SequenceurAction) : dès détection,
# la boucle s'arrête et affiche un aperçu figé avec deux repères possibles :
#   - un rectangle ORANGE à l'ancienne surface déjà enregistrée (si elle
#     existait avant l'ouverture de cet onglet), pour comparaison ;
#   - le rectangle VERT du composant détecté, comme TestComposantScreen.
# Un nouveau tracé relance une nouvelle recherche (utile si la fenêtre a
# bougé ou si le composant a changé de position depuis la 1ère détection).
# ---------------------------------------------------------------------------
# ---------------------------------------------------------------------------
# QLabel qui émet un signal à chaque redimensionnement réel — un simple
# setPixmap() figé ne se remet pas à l'échelle tout seul quand l'utilisateur
# redimensionne la fenêtre/le panneau : sans ce signal, l'aperçu reste
# affiché à l'ancienne taille jusqu'au prochain rafraîchissement de contenu.
# Déplacée ICI (avant ApercuTraceableLabel, qui en hérite maintenant) --
# toute classe d'aperçu affichée dans PanneauRenduInstance a besoin de ce
# signal pour rester connectée à _sur_redimensionnement_apercu, y compris
# ApercuTraceableLabel (CoordonneeActionScreen), qui héritait avant de
# QLabel directement et n'avait donc PAS ce signal -- .connect() aurait
# levé un AttributeError dès l'instanciation de cet écran.
# ---------------------------------------------------------------------------
class LabelApercuRedimensionnable(QLabel):
    redimensionne = Signal()

    def resizeEvent(self, event):
        super().resizeEvent(event)
        self.redimensionne.emit()


# ---------------------------------------------------------------------------
# ApercuLayoutLabel -- widget dédié à ComposantLayoutConfigScreen (SPEC
# section 5), classe ENTIÈREMENT PERSONNALISÉE (pas une adaptation de
# ApercuTraceableLabel, dont le rôle -- un unique rectangle tracé par
# l'utilisateur pour zone_clic_rect d'un cS -- ne correspond pas au besoin
# ici).
#
# FUSION (demande explicite : "forme et zone sont en fait la même chose
# ... on va éliminer la notion de forme, et conserver zone" -- et "on
# enlève la notion de scan clic, nous même on va dessiner la zone") :
# plus qu'UN SEUL mode d'usage dans l'onglet Configuration -- tracé libre
# (glisser-relâcher) sur le cL ENTIER, activé par le bouton dédié du
# sous-onglet "Zone" (cf. ComposantLayoutConfigScreen.
# _construire_sous_onglet_zones). L'ancien mode "blocs" (clic sur un
# rectangle détecté par le scan pour le nommer comme Forme) est RETIRÉ --
# REFONTE (cf. SPEC_refonte_filtre_zones_dynamiques.md) : le filtre
# (code_filtre) nomme désormais lui-même chaque zone dynamique qu'il
# trouve (variables `zones` + `valide` en sortie), plus aucun matching
# structurel à alimenter -- ce mécanisme est entièrement supprimé.
#
# AJOUT (demande explicite : le tracé doit se synchroniser visuellement
# sur les DEUX aperçus -- brut à gauche, filtré à droite, cf. docstring
# de ComposantLayoutConfigScreen._construire_onglet_formes) : le
# rectangle en cours de tracé (pendant le drag) est exposé/reçu en
# coordonnées IMAGE (pas widget) via definir_rect_trace_externe(), pour
# rester valide même si les deux labels n'ont pas exactement la même
# taille en pixels à l'écran -- ils affichent la MÊME image (mêmes
# dimensions logiques), donc les coordonnées image sont le référentiel
# commun ; chaque label refait sa propre conversion image->widget selon
# sa taille réelle. Cf. ComposantLayoutConfigScreen._sur_trace_zone_
# maj/_sur_zone_tracee, qui font le pont entre les deux instances.
# ---------------------------------------------------------------------------
class ApercuLayoutLabel(LabelApercuRedimensionnable):
    """Widget d'aperçu pour l'onglet Configuration de
    ComposantLayoutConfigScreen.

    zone_tracee(QRect) : émis en mode "trace_zone" quand l'utilisateur
    relâche la souris après un tracé valide (rectangle non vide), en
    coordonnées de l'IMAGE affichée (coordonnées du ComposantLayout
    ENTIER, cf. ComposantLayoutConfigScreen._sur_zone_tracee pour la
    conversion finale en Zone.rect relatif).

    trace_en_cours(object) : émis à CHAQUE mouvement de souris pendant le
    drag en mode "trace_zone" (rectangle EN COURS, pas encore validé),
    en coordonnées IMAGE -- object plutôt que QRect pour pouvoir émettre
    None au relâchement/annulation (efface le tracé miroir sur l'autre
    aperçu). AJOUT pour la synchronisation visuelle entre les deux
    aperçus (brut/filtré, cf. bloc de commentaire ci-dessus)."""

    zone_tracee = Signal(object)  # QRect, coordonnées image affichée
    trace_en_cours = Signal(object)  # QRect | None, coordonnées image affichée

    MODE_TRACE_ZONE = "trace_zone"
    MODE_INERTE = "inerte"  # ni sélection de bloc ni tracé -- juste affichage
    # CORRECTIF (SPEC section 5.5) : pendant le test, chaque instance de
    # cL détectée est entourée (rectangle englobant), et chacune de ses
    # Zone est également entourée à l'intérieur. Mode dédié plutôt que de
    # surcharger MODE_TRACE_ZONE (sémantique différente : ici on affiche
    # le RÉSULTAT d'une détection multi-instances déjà assignée aux Zone
    # du gabarit -- pas d'interaction souris dans ce mode).
    MODE_INSTANCES = "instances"

    def __init__(self, parent=None):
        super().__init__(parent)
        self.setAlignment(Qt.AlignCenter)
        self.setFocusPolicy(Qt.StrongFocus)
        self.setObjectName("ApercuLayoutLabel")

        self._pixmap_base: Optional[QPixmap] = None
        self._taille_image: QSize = QSize(0, 0)

        # AJOUT (retour utilisateur : "pourquoi c'est pas identique" --
        # en mode cS, l'image déposée s'affiche en dimension RÉELLE avec
        # scroll (cf. LabelApercuRedimensionnable + apercu_scroll), alors
        # qu'en mode cL, ApercuLayoutLabel redimensionne TOUJOURS l'image
        # pour tenir dans le widget, cf. _rect_pixmap_affiche/paintEvent
        # ci-dessous) -- False par défaut : comportement STRICTEMENT
        # inchangé pour ComposantLayoutConfigScreen (2 instances de cette
        # classe, écran de config des zones -- jamais concerné par cette
        # demande). Activé uniquement par TestComposantScreen (cf.
        # definir_echelle_1_1 ci-dessous et son appelant), posé dans un
        # QScrollArea dédié plutôt que directement dans _droite_layout.
        self._echelle_1_1: bool = False

        self._mode: str = self.MODE_INERTE

        # Mode "trace_zone" : glisser-relâcher classique, coords WIDGET
        # pendant le drag, converties en coords image au relâchement.
        self._origine_drag: Optional[QPoint] = None
        self._rect_widget_courant: Optional[QRect] = None

        # AJOUT (synchronisation visuelle entre les deux aperçus, cf.
        # bloc de commentaire au-dessus de la classe) : rectangle tracé
        # sur l'AUTRE ApercuLayoutLabel, reçu en coordonnées IMAGE via
        # definir_rect_trace_externe(), reconverti ici en coordonnées
        # WIDGET à chaque paintEvent (comme _zones_nommees) -- purement
        # visuel, ne déclenche jamais zone_tracee.
        self._rect_trace_externe_image: Optional[QRect] = None

        # Zones déjà nommées -- affichées en fond dans tous les modes,
        # couleur/épaisseur réglables PAR cL (cf. ComposantLayout.couleur_
        # zone/epaisseur_zone, PATCH demande explicite utilisateur) --
        # {nom: QRect en coords image}.
        self._zones_nommees: dict = {}
        self._couleur_zones: str = Mocha.mauve
        self._epaisseur_zones: int = 2
        self._nom_zone_selectionnee_affichage: Optional[str] = None
        self._couleur_zone_selectionnee_affichage: str = Mocha.green

        # CORRECTIF, mode "instances" (SPEC 5.5) : liste de dicts
        # {"englobant": QRect, "zones": {nom: QRect}}, en coordonnées de
        # l'image affichée -- cf. definir_instances_test ci-dessous.
        self._instances_test: list = []

    # --- alimentation depuis l'écran parent -------------------------------

    def afficher_image(self, image: QImage):
        self._taille_image = image.size()
        self._pixmap_base = QPixmap.fromImage(image)
        # cf. docstring de self._echelle_1_1 -- en mode dimension réelle,
        # le widget se redimensionne à la taille EXACTE du pixmap (comme
        # LabelApercuRedimensionnable.setPixmap + .resize() en mode cS),
        # pour que le QScrollArea parent affiche des barres de défilement
        # plutôt que de comprimer l'image dans l'espace disponible.
        if self._echelle_1_1 and not self._pixmap_base.isNull():
            self.resize(self._pixmap_base.size())
        self.update()

    def definir_echelle_1_1(self, actif: bool):
        """AJOUT (retour utilisateur, cf. docstring de self._echelle_1_1)
        -- active/désactive l'affichage en dimension réelle (1 pixel image
        = 1 pixel écran, pas de mise à l'échelle) plutôt que la mise à
        l'échelle habituelle de ApercuLayoutLabel (Qt.KeepAspectRatio dans
        les limites du widget). Doit être appelée UNE FOIS, avant tout
        afficher_image, par l'appelant qui pose ce label dans un
        QScrollArea dédié (cf. TestComposantScreen.__init__) -- les 2
        instances de ComposantLayoutConfigScreen ne l'appellent jamais,
        conservant leur comportement mis à l'échelle inchangé."""
        self._echelle_1_1 = actif
        if actif and self._pixmap_base is not None and not self._pixmap_base.isNull():
            self.resize(self._pixmap_base.size())
        self.update()

    def definir_mode(self, mode: str):
        if mode not in (self.MODE_TRACE_ZONE, self.MODE_INERTE, self.MODE_INSTANCES):
            raise ValueError(f"Mode ApercuLayoutLabel inconnu : {mode!r}")
        self._mode = mode
        self._origine_drag = None
        self._rect_widget_courant = None
        self.setCursor(Qt.CrossCursor if mode == self.MODE_TRACE_ZONE else Qt.ArrowCursor)
        self.update()

    def definir_zones_nommees(
        self, zones: dict, couleur: str = None, epaisseur: int = 2,
        nom_selectionnee: str = None, couleur_selectionnee: str = None,
    ):
        """zones : {nom: QRect en coordonnées de l'image affichée}.

        couleur/epaisseur : réglages du cL (cf. ComposantLayout.couleur_
        zone/epaisseur_zone) -- CORRECTIF (retour utilisateur : "ça doit
        s'afficher uniquement quand on clique sur un rect") : paintEvent
        n'affiche désormais QUE la Zone nommée nom_selectionnee (dans
        couleur_selectionnee, cf. ComposantLayout.couleur_zone_
        selectionnee) -- toutes les autres restent stockées ici (utiles
        pour la collision de noms, etc.) mais ne sont plus dessinées tant
        qu'elles ne sont pas sélectionnées. couleur=None/couleur_
        selectionnee=None retombent respectivement sur Mocha.mauve/
        Mocha.green (ancien comportement en dur, pour tout appelant qui
        ne préciserait pas encore ces paramètres)."""
        self._zones_nommees = dict(zones)
        self._couleur_zones = couleur if couleur else Mocha.mauve
        self._epaisseur_zones = max(1, epaisseur)
        self._nom_zone_selectionnee_affichage = nom_selectionnee
        self._couleur_zone_selectionnee_affichage = couleur_selectionnee if couleur_selectionnee else Mocha.green
        self.update()

    def definir_rect_trace_externe(self, rect_image: Optional[QRect]):
        """AJOUT (synchronisation visuelle entre les deux aperçus, cf.
        bloc de commentaire au-dessus de la classe) -- affiche EN PLUS,
        par-dessus le rendu normal de CE label, le rectangle actuellement
        en cours de tracé sur L'AUTRE ApercuLayoutLabel (coordonnées
        IMAGE, reconverties ici selon la taille réelle de CE label).
        None efface ce rectangle miroir (relâchement/annulation côté
        origine du tracé)."""
        self._rect_trace_externe_image = rect_image
        self.update()

    def definir_instances_test(self, instances: list):
        """CORRECTIF (SPEC 5.5) : instances = liste de dicts
        {"englobant": QRect, "zones": {nom_zone: QRect}}, en coordonnées
        de l'image affichée -- une entrée par instance de cL détectée à
        l'écran (potentiellement plusieurs, cf. detecter_toutes_instances_
        composant_layout). Alimentée par TestComposantScreen (en
        MODE_COMPOSANT_LAYOUT, cf. _sur_capture_propre_pour_detection_layout)
        -- anciennement par ComposantLayoutConfigScreen._demarrer_test_
        detection, retirée depuis le passage de la détection cL dans
        l'onglet Test partagé (cf. REFONTE, docstring du __init__ de
        ComposantLayoutConfigScreen)."""
        self._instances_test = list(instances)
        self.update()

    def effacer_trace(self):
        self._origine_drag = None
        self._rect_widget_courant = None
        self.update()

    # --- conversion widget <-> image --------------------------------------

    def _rect_pixmap_affiche(self) -> QRect:
        if self._pixmap_base is None or self._pixmap_base.isNull():
            return QRect()
        # cf. docstring de self._echelle_1_1 -- dimension réelle : le
        # pixmap occupe le widget entier depuis (0, 0), sans mise à
        # l'échelle ni centrage (le widget EST à la taille du pixmap,
        # cf. resize() dans afficher_image/definir_echelle_1_1 -- un
        # éventuel QScrollArea parent gère le défilement si la zone
        # visible est plus petite).
        if self._echelle_1_1:
            return QRect(0, 0, self._pixmap_base.width(), self._pixmap_base.height())
        pixmap_mis_echelle = self._pixmap_base.scaled(
            self.width(), self.height(), Qt.KeepAspectRatio, Qt.SmoothTransformation,
        )
        x = (self.width() - pixmap_mis_echelle.width()) // 2
        y = (self.height() - pixmap_mis_echelle.height()) // 2
        return QRect(x, y, pixmap_mis_echelle.width(), pixmap_mis_echelle.height())

    def _image_vers_widget(self, rect_image: QRect) -> QRect:
        zone_pixmap = self._rect_pixmap_affiche()
        if zone_pixmap.isEmpty() or self._taille_image.width() <= 0 or self._taille_image.height() <= 0:
            return QRect()
        ex = zone_pixmap.width() / self._taille_image.width()
        ey = zone_pixmap.height() / self._taille_image.height()
        return QRect(
            zone_pixmap.x() + round(rect_image.x() * ex),
            zone_pixmap.y() + round(rect_image.y() * ey),
            round(rect_image.width() * ex),
            round(rect_image.height() * ey),
        )

    def _widget_vers_image(self, point_ou_rect):
        zone_pixmap = self._rect_pixmap_affiche()
        if zone_pixmap.isEmpty() or self._taille_image.width() <= 0 or self._taille_image.height() <= 0:
            return None
        ex = self._taille_image.width() / zone_pixmap.width()
        ey = self._taille_image.height() / zone_pixmap.height()
        if isinstance(point_ou_rect, QRect):
            rect = point_ou_rect.normalized().intersected(zone_pixmap)
            if rect.isEmpty():
                return None
            return QRect(
                round((rect.x() - zone_pixmap.x()) * ex),
                round((rect.y() - zone_pixmap.y()) * ey),
                max(1, round(rect.width() * ex)),
                max(1, round(rect.height() * ey)),
            )
        else:  # QPoint
            if not zone_pixmap.contains(point_ou_rect):
                return None
            return QPoint(
                round((point_ou_rect.x() - zone_pixmap.x()) * ex),
                round((point_ou_rect.y() - zone_pixmap.y()) * ey),
            )

    # --- rendu --------------------------------------------------------------

    def paintEvent(self, event):
        painter = QPainter(self)
        painter.fillRect(self.rect(), QColor(Mocha.crust))
        zone_pixmap = self._rect_pixmap_affiche()
        if self._pixmap_base is not None and not self._pixmap_base.isNull():
            # cf. docstring de self._echelle_1_1 -- dessine le pixmap TEL
            # QUEL (aucune mise à l'échelle) en mode dimension réelle ;
            # sinon, comportement inchangé (mis à l'échelle, centré).
            if self._echelle_1_1:
                painter.drawPixmap(zone_pixmap.topLeft(), self._pixmap_base)
            else:
                pixmap_mis_echelle = self._pixmap_base.scaled(
                    self.width(), self.height(), Qt.KeepAspectRatio, Qt.SmoothTransformation,
                )
                painter.drawPixmap(zone_pixmap.topLeft(), pixmap_mis_echelle)

        if zone_pixmap.isEmpty():
            return

        # Zones tracées à la main -- CORRECTIF (retour utilisateur,
        # capture à l'appui : "il y a aussi certaines bandes qui sont
        # affichées par défaut sur l'image, je crois que ce sont les
        # zones dessinées manuellement ... ça doit s'afficher uniquement
        # quand on clique sur un rect") -- l'ancien comportement dessinait
        # TOUTES les Zone statiques en permanence (couleur_zone), même
        # sans rien sélectionner ; avec plusieurs Zone dont certaines
        # bord-à-bord ou proches des limites de l'image, ça rendait
        # visuellement comme des bandes parasites collées à l'image.
        # Désormais : rien n'est dessiné tant qu'aucune Zone n'est
        # sélectionnée dans le panneau de droite -- seule la Zone
        # SÉLECTIONNÉE (self._nom_zone_selectionnee_affichage) apparaît,
        # dans couleur_zone_selectionnee.
        if self._nom_zone_selectionnee_affichage is not None:
            rect_image_selectionnee = self._zones_nommees.get(self._nom_zone_selectionnee_affichage)
            if rect_image_selectionnee is not None:
                pen_zone_selectionnee = QPen(QColor(self._couleur_zone_selectionnee_affichage))
                pen_zone_selectionnee.setWidth(self._epaisseur_zones)
                painter.setBrush(Qt.NoBrush)
                painter.setPen(pen_zone_selectionnee)
                painter.drawRect(self._image_vers_widget(rect_image_selectionnee))

        # AJOUT (synchronisation visuelle entre les deux aperçus) :
        # rectangle en cours de tracé sur L'AUTRE label -- pointillé pour
        # le distinguer du tracé natif de CE label (trait plein, cf.
        # MODE_TRACE_ZONE ci-dessous) même quand les deux se superposent
        # visuellement (mêmes coordonnées image par construction).
        if self._rect_trace_externe_image is not None and not self._rect_trace_externe_image.isEmpty():
            pen_externe = QPen(QColor(Mocha.mauve))
            pen_externe.setWidth(2)
            pen_externe.setStyle(Qt.DashLine)
            painter.setPen(pen_externe)
            painter.setBrush(Qt.NoBrush)
            painter.drawRect(self._image_vers_widget(self._rect_trace_externe_image))

        if self._mode == self.MODE_TRACE_ZONE:
            if self._rect_widget_courant is not None and not self._rect_widget_courant.isEmpty():
                pen = QPen(QColor(Mocha.mauve))
                pen.setWidth(2)
                painter.setPen(pen)
                painter.setBrush(Qt.NoBrush)
                painter.drawRect(self._rect_widget_courant.normalized())

        elif self._mode == self.MODE_INSTANCES:
            # CORRECTIF (SPEC 5.5) : englobant de CHAQUE instance en vert
            # ("détection positive"), et à l'intérieur, les Zone assignées
            # en mauve (même couleur que _zones_nommees, cohérence
            # visuelle avec l'app de config).
            pen_englobant = QPen(QColor(Mocha.green))
            pen_englobant.setWidth(3)
            pen_zone_detectee = QPen(QColor(Mocha.mauve))
            pen_zone_detectee.setWidth(2)
            for instance in self._instances_test:
                painter.setPen(pen_englobant)
                painter.setBrush(Qt.NoBrush)
                painter.drawRect(self._image_vers_widget(instance["englobant"]))
                painter.setPen(pen_zone_detectee)
                for rect_zone in instance["zones"].values():
                    painter.drawRect(self._image_vers_widget(rect_zone))

    # --- interaction souris --------------------------------------------------

    def mousePressEvent(self, event):
        if event.button() == Qt.LeftButton:
            if self._mode == self.MODE_TRACE_ZONE:
                self._origine_drag = event.pos()
                self._rect_widget_courant = QRect(self._origine_drag, QSize())
                self.update()
        super().mousePressEvent(event)

    def mouseMoveEvent(self, event):
        if self._mode == self.MODE_TRACE_ZONE and self._origine_drag is not None:
            self._rect_widget_courant = QRect(self._origine_drag, event.pos())
            self.update()
            # AJOUT (synchronisation visuelle) : rediffuse le rectangle EN
            # COURS (pas encore validé) en coordonnées IMAGE, à chaque
            # mouvement -- cf. ComposantLayoutConfigScreen._sur_trace_
            # zone_maj, qui le relaie vers l'autre ApercuLayoutLabel.
            rect_widget_visible = self._rect_widget_courant.normalized().intersected(self._rect_pixmap_affiche())
            rect_image_courant = self._widget_vers_image(rect_widget_visible)
            self.trace_en_cours.emit(rect_image_courant)
        super().mouseMoveEvent(event)

    def mouseReleaseEvent(self, event):
        if self._mode == self.MODE_TRACE_ZONE and event.button() == Qt.LeftButton and self._origine_drag is not None:
            rect_widget_final = QRect(self._origine_drag, event.pos()).normalized().intersected(self._rect_pixmap_affiche())
            self._origine_drag = None
            self._rect_widget_courant = None
            self.update()
            # Efface le miroir sur l'autre aperçu (tracé terminé, plus de
            # rectangle "en cours" -- cf. trace_en_cours ci-dessus).
            self.trace_en_cours.emit(None)
            rect_image = self._widget_vers_image(rect_widget_final)
            if rect_image is not None and not rect_image.isEmpty():
                self.zone_tracee.emit(rect_image)
        super().mouseReleaseEvent(event)

    def keyPressEvent(self, event):
        if event.key() == Qt.Key_Escape and self._mode == self.MODE_TRACE_ZONE:
            self.effacer_trace()
            self.trace_en_cours.emit(None)
            return
        super().keyPressEvent(event)


class ApercuTraceableLabel(LabelApercuRedimensionnable):
    """Label d'aperçu embarqué (remplace apercu_label dans PanneauRenduInstance
    UNIQUEMENT pour CoordonneeActionScreen) qui dessine l'image reçue ainsi
    que jusqu'à trois rectangles : ORANGE (ancienne zone_clic_rect déjà
    enregistrée, si elle existait avant l'ouverture de cet onglet), VERT (le
    composant détecté par la recherche), et MAUVE (le rectangle en cours de
    tracé / déjà tracé par l'utilisateur, glisser-relâcher souris).

    Tous les rectangles sont conservés en coordonnées DE L'IMAGE (pas du
    widget) puis remis à l'échelle à chaque paintEvent -- même pattern que
    TestComposantScreen._afficher_apercu_avec_resultat, pour rester correct
    quel que soit le redimensionnement de la fenêtre.

    Espace : si un rectangle tracé est valide, calcule le ZoneClicRect
    résultant (relatif au coin haut-gauche du composant détecté, à
    l'échelle 1.0 -- cf. commentaire d'origine de CoordonneeActionScreen),
    le copie dans le presse-papier (repr lisible) et l'émet via
    zone_validee(ZoneClicRect) — ne ferme PAS l'écran (l'utilisateur peut
    retracer et revalider autant de fois que nécessaire).
    Échap : annule uniquement le tracé en cours (ne ferme pas l'écran non
    plus -- cf. ZoneClicSelector, dont Échap ferme la fenêtre séparée ; ici
    ce label est embarqué dans un écran permanent, pas un dialog).
    """

    zone_validee = Signal(object)  # ZoneClicRect, en coordonnées image du composant détecté (échelle 1.0)

    def __init__(self, parent=None):
        super().__init__(parent)
        self.setCursor(Qt.CrossCursor)
        self.setFocusPolicy(Qt.StrongFocus)

        self._pixmap_base: Optional[QPixmap] = None
        self._taille_image: QSize = QSize(0, 0)  # taille de la DERNIÈRE image reçue (pas du pixmap mis à l'échelle)

        self._rect_ancienne_zone: Optional[QRect] = None  # coords image du composant, orange -- ancienne zone_clic_rect
        self._rect_detecte: Optional[QRect] = None  # coords image ENTIÈRE (frame), vert -- résultat de détection
        self._echelle_detection: float = 1.0  # resultat["echelle"] de la dernière détection -- pour neutraliser au calcul

        self._origine_drag: Optional[QPoint] = None  # coords WIDGET, pendant le drag
        self._rect_widget_courant: Optional[QRect] = None  # coords WIDGET -- tracé en cours ou déjà tracé

    def afficher_image(self, image: QImage):
        """Remplace le pixmap affiché -- appelée par CoordonneeActionScreen
        à chaque frame (comme _afficher_apercu_defaut), jamais directement
        via setPixmap pour ne pas perdre la taille d'image mémorisée
        (nécessaire pour reconvertir widget -> image dans keyPressEvent)."""
        self._taille_image = image.size()
        self._pixmap_base = QPixmap.fromImage(image)
        self.update()

    def definir_ancienne_zone(self, rect: Optional[QRect]):
        """rect en coordonnées de l'image du composant (comme
        Composant.zone_clic_rect), ou None si le composant n'avait pas
        encore de zone personnalisée avant l'ouverture de cet onglet."""
        self._rect_ancienne_zone = rect
        self.update()

    def definir_resultat_detection(self, rect_frame: Optional[QRect], echelle: float):
        """rect_frame en coordonnées de l'image ENTIÈRE reçue (comme
        TestComposantScreen : resultat["x"]/["y"]/["largeur"]/["hauteur"]),
        echelle = resultat["echelle"] de cette détection. None efface le
        rectangle vert (nouvelle recherche en cours ou composant non
        trouvé)."""
        self._rect_detecte = rect_frame
        self._echelle_detection = echelle if echelle else 1.0
        self.update()

    def effacer_trace(self):
        self._origine_drag = None
        self._rect_widget_courant = None
        self.update()

    def _rect_pixmap_affiche(self) -> QRect:
        """Zone du widget où le pixmap est RÉELLEMENT dessiné (centré,
        Qt.KeepAspectRatio) -- nécessaire pour convertir widget <-> image,
        le pixmap ne remplissant pas forcément tout le label."""
        if self._pixmap_base is None or self._pixmap_base.isNull():
            return QRect()
        pixmap_mis_echelle = self._pixmap_base.scaled(
            self.width(), self.height(), Qt.KeepAspectRatio, Qt.SmoothTransformation,
        )
        x = (self.width() - pixmap_mis_echelle.width()) // 2
        y = (self.height() - pixmap_mis_echelle.height()) // 2
        return QRect(x, y, pixmap_mis_echelle.width(), pixmap_mis_echelle.height())

    def _widget_vers_image(self, rect_widget: QRect) -> Optional[QRect]:
        """Reconvertit un QRect en coordonnées WIDGET vers coordonnées de
        l'image d'ORIGINE (self._taille_image) -- même esprit que
        ZoneClicSelector.keyPressEvent (division par le facteur d'échelle
        affiché, PAS l'échelle de détection, cf. appelant)."""
        zone_pixmap = self._rect_pixmap_affiche()
        if zone_pixmap.isEmpty() or self._taille_image.width() <= 0 or self._taille_image.height() <= 0:
            return None
        rect = rect_widget.normalized().intersected(zone_pixmap)
        if rect.isEmpty():
            return None
        echelle_x = self._taille_image.width() / zone_pixmap.width()
        echelle_y = self._taille_image.height() / zone_pixmap.height()
        return QRect(
            round((rect.x() - zone_pixmap.x()) * echelle_x),
            round((rect.y() - zone_pixmap.y()) * echelle_y),
            max(1, round(rect.width() * echelle_x)),
            max(1, round(rect.height() * echelle_y)),
        )

    def paintEvent(self, event):
        painter = QPainter(self)
        painter.fillRect(self.rect(), QColor(Mocha.crust))
        zone_pixmap = self._rect_pixmap_affiche()
        if self._pixmap_base is not None and not self._pixmap_base.isNull():
            pixmap_mis_echelle = self._pixmap_base.scaled(
                self.width(), self.height(), Qt.KeepAspectRatio, Qt.SmoothTransformation,
            )
            painter.drawPixmap(zone_pixmap.topLeft(), pixmap_mis_echelle)

        if not zone_pixmap.isEmpty() and self._taille_image.width() > 0 and self._taille_image.height() > 0:
            echelle_affichage_x = zone_pixmap.width() / self._taille_image.width()
            echelle_affichage_y = zone_pixmap.height() / self._taille_image.height()

            def _image_vers_widget(rect_image: QRect) -> QRect:
                return QRect(
                    zone_pixmap.x() + round(rect_image.x() * echelle_affichage_x),
                    zone_pixmap.y() + round(rect_image.y() * echelle_affichage_y),
                    round(rect_image.width() * echelle_affichage_x),
                    round(rect_image.height() * echelle_affichage_y),
                )

            if self._rect_ancienne_zone is not None and not self._rect_ancienne_zone.isEmpty():
                pen = QPen(QColor(Mocha.peach))
                pen.setWidth(2)
                painter.setPen(pen)
                painter.setBrush(Qt.NoBrush)
                painter.drawRect(_image_vers_widget(self._rect_ancienne_zone))

            if self._rect_detecte is not None and not self._rect_detecte.isEmpty():
                pen = QPen(QColor(Mocha.green))
                pen.setWidth(2)
                painter.setPen(pen)
                painter.setBrush(Qt.NoBrush)
                painter.drawRect(_image_vers_widget(self._rect_detecte))

        if self._rect_widget_courant is not None and not self._rect_widget_courant.isEmpty():
            pen = QPen(QColor(Mocha.mauve))
            pen.setWidth(2)
            painter.setPen(pen)
            painter.setBrush(Qt.NoBrush)
            painter.drawRect(self._rect_widget_courant.normalized())

    def mousePressEvent(self, event):
        if event.button() == Qt.LeftButton:
            self._origine_drag = event.pos()
            self._rect_widget_courant = QRect(self._origine_drag, QSize())
            self.update()
        super().mousePressEvent(event)

    def mouseMoveEvent(self, event):
        if self._origine_drag is not None:
            self._rect_widget_courant = QRect(self._origine_drag, event.pos())
            self.update()
        super().mouseMoveEvent(event)

    def mouseReleaseEvent(self, event):
        if event.button() == Qt.LeftButton and self._origine_drag is not None:
            self._rect_widget_courant = QRect(self._origine_drag, event.pos()).normalized().intersected(
                self._rect_pixmap_affiche()
            )
            self._origine_drag = None
            self.update()
        super().mouseReleaseEvent(event)

    def keyPressEvent(self, event):
        if event.key() == Qt.Key_Escape:
            self.effacer_trace()
            return
        if event.key() == Qt.Key_Space:
            if self._rect_widget_courant is None or self._rect_widget_courant.isEmpty():
                return
            rect_image_entiere = self._widget_vers_image(self._rect_widget_courant)
            if rect_image_entiere is None:
                return
            # Rend le rectangle RELATIF au coin haut-gauche du composant
            # détecté (cf. Composant.zone_clic_rect : "en coordonnées de
            # l'image du composant"), et neutralise l'échelle de détection
            # pour rester valable quelle que soit la taille de la fenêtre
            # au moment du tracé réel en exécution (cf. docstring d'origine
            # juste avant cette classe).
            origine_x, origine_y = 0, 0
            if self._rect_detecte is not None and not self._rect_detecte.isEmpty():
                origine_x, origine_y = self._rect_detecte.x(), self._rect_detecte.y()
            echelle = self._echelle_detection or 1.0
            zone = ZoneClicRect(
                x=round((rect_image_entiere.x() - origine_x) / echelle),
                y=round((rect_image_entiere.y() - origine_y) / echelle),
                largeur=max(1, round(rect_image_entiere.width() / echelle)),
                hauteur=max(1, round(rect_image_entiere.height() / echelle)),
            )
            QGuiApplication.clipboard().setText(
                f"ZoneClicRect(x={zone.x}, y={zone.y}, largeur={zone.largeur}, hauteur={zone.hauteur})"
            )
            self.zone_validee.emit(zone)
            return
        super().keyPressEvent(event)


# ---------------------------------------------------------------------------
# Écran "Coordonnée d'action" — version réduite de TestComposantScreen,
# dédiée à UNE seule chose : détecter un composant précis sur une fenêtre
# cible, puis laisser l'utilisateur TRACER (glisser-relâcher) un RECTANGLE
# directement sur l'aperçu, pour fixer zone_clic_rect de ce Composant
# (relatif au coin haut-gauche du composant détecté, à l'échelle 1.0).
#
# Une SEULE tentative de détection par clic sur "Rechercher le composant"
# (jamais de boucle continue -- même mécanisme que TestComposantScreen,
# décision explicite utilisateur). Trouvé -> aperçu figé avec rectangle
# VERT (composant détecté) + rectangle ORANGE (ancienne zone_clic_rect si
# elle existait déjà) ; l'utilisateur trace alors son rectangle (glisser-
# relâcher), Espace copie les coordonnées dans le presse-papier ET les
# renvoie via signal, Échap annule le tracé en cours (pas l'écran).
# ---------------------------------------------------------------------------
class CoordonneeActionScreen(InstanceApercuScreen):
    """Composant FIXÉ dès l'ouverture (pas de sélecteur, contrairement à
    TestComposantScreen) -- ouvert directement sur un Composant précis
    depuis un clic droit sur sa tuile (cf. PanneauComposantsImportesTask /
    ComposantImportTuile). Templates chargés UNE fois via
    charger_templates_bgr (factorisée, cf. _on_composant_changed de
    TestComposantScreen pour la logique équivalente non factorisée).

    zone_definie(str nom_composant, ZoneClicRect) : émis quand l'utilisateur
    valide un tracé (Espace) -- à connecter par l'appelant pour persister
    zone_clic_rect sur le Composant réel dans le Project (cette classe ne
    touche PAS au Project directement, cf. contrat identique à
    PanneauComposantsImportesTask.composant_copie)."""

    zone_definie = Signal(str, object)  # (nom_composant, ZoneClicRect)

    def __init__(self, project: "Project", composant: Composant, reglages: "ReglagesApp", parent=None):
        super().__init__(id_pilote_prefixe="autoniax-coord", titre_apercu="APERÇU DE L'INSTANCE CIBLE", parent=parent)
        self.project = project
        self.reglages = reglages
        self.composant = composant
        self._templates_bgr: list = charger_templates_bgr(composant) if VISION_DISPONIBLE else []
        self.onglet_origine: Optional[str] = None

        self._en_cours = False  # armé, en attente de la prochaine frame pour UNE tentative
        self._detection_en_vol = False
        self._image_en_cours_analyse: Optional[QImage] = None
        self._dernier_rect_detecte: Optional[QRect] = None  # coords frame entière -- pour _executer_action-like usages futurs
        self._derniere_echelle_detection: float = 1.0

        # --- Détection OpenCV dans un QThread séparé -- JAMAIS sur le
        # thread GUI (même pattern que TestComposantScreen.__init__ : cf.
        # DetectionWorker, rechercher_composant_multi_variantes est un
        # calcul CPU-intensif). Un seul worker/thread par onglet, démarré
        # ici et arrêté dans arreter() (qui appelait déjà quit()/wait()
        # sur self._detection_thread sans que ce bloc existe -- oubli
        # corrigé ici). ---
        self._detection_thread = QThread(self)
        self._detection_worker = DetectionWorker()
        self._detection_worker.moveToThread(self._detection_thread)
        self._detection_worker.resultat_pret.connect(self._sur_resultat_detection)
        self._detection_thread.start()

        # --- Substitution de apercu_label par ApercuTraceableLabel, EN
        # PLACE, sur droite_layout (cf. docstring de PanneauRenduInstance :
        # "droite_layout ne gère QUE apercu_label" -- un seul widget à cet
        # index) -- ET mise à jour de self._panneau_rendu.apercu_label (cf.
        # docstring de InstanceApercuScreen.__init__ : "toute réassignation
        # de self.apercu_label par une sous-classe doit AUSSI mettre à jour
        # self._panneau_rendu.apercu_label"). ---
        # CORRECTIF (même bug identifié et corrigé dans TestComposantScreen.
        # __init__, cf. son commentaire détaillé, et dans
        # ComposantLayoutConfigScreen.__init__ AVANT lui) : ancien_label
        # ci-dessous est le QLabel lui-même, jamais un enfant DIRECT de
        # _droite_layout -- c'est apercu_scroll (le QScrollArea qui le
        # contient, cf. PanneauRenduInstance.__init__ : droite_layout.
        # addWidget(self.apercu_scroll, 1)) qui y est réellement posé.
        # indexOf(ancien_label)/removeWidget(ancien_label) sur
        # _droite_layout étaient donc un no-op muet : apercu_scroll
        # restait dans _droite_layout, vide mais toujours avec sa taille
        # minimale (320, 200) et sa SizePolicy Expanding, à se partager
        # l'espace vertical avec le nouveau apercu_traceable inséré juste
        # à côté (à l'index -1, faute d'avoir trouvé ancien_label ->
        # ajouté en FIN de layout) -- aperçu compressé, gros espace vide
        # au-dessus, même symptôme visuel que sur TestComposantScreen.
        #
        # Fix : takeWidget() retire proprement apercu_label de son VRAI
        # parent (apercu_scroll), PUIS apercu_scroll lui-même est retiré
        # de _droite_layout et masqué (jamais détruit : attribut public
        # de PanneauRenduInstance, partagé avec d'autres écrans -- seul
        # CoordonneeActionScreen n'en a plus besoin une fois apercu_
        # traceable en place). apercu_traceable devient alors le SEUL
        # widget de _droite_layout, sur tout l'espace disponible.
        ancien_label = self.apercu_label
        self._panneau_rendu.apercu_scroll.takeWidget()
        self._droite_layout.removeWidget(self._panneau_rendu.apercu_scroll)
        self._panneau_rendu.apercu_scroll.setVisible(False)
        ancien_label.setParent(None)
        ancien_label.deleteLater()

        self.apercu_traceable = ApercuTraceableLabel(self._colonne_droite)
        self.apercu_traceable.setAlignment(Qt.AlignCenter)
        self.apercu_traceable.setMinimumSize(320, 200)
        self.apercu_traceable.setSizePolicy(QSizePolicy.Expanding, QSizePolicy.Expanding)
        self.apercu_traceable.setObjectName("ComposantTuileImageFrame")
        self._droite_layout.addWidget(self.apercu_traceable, 1)
        self.apercu_traceable.zone_validee.connect(self._sur_zone_validee)

        self.apercu_label = self.apercu_traceable
        self._panneau_rendu.apercu_label = self.apercu_traceable
        # Le signal redimensionne de l'ancien label était connecté à
        # _sur_redimensionnement_apercu (cf. InstanceApercuScreen.__init__) --
        # reconnecté ici sur le nouveau label, override plus bas gère le
        # redessin propre à cet écran (pas juste l'image brute).
        self.apercu_traceable.redimensionne.connect(self._sur_redimensionnement_apercu)

        if not self.composant.zone_clic_rect.est_vide():
            zone = self.composant.zone_clic_rect
            self.apercu_traceable.definir_ancienne_zone(QRect(zone.x, zone.y, zone.largeur, zone.hauteur))

        # --- Widgets propres à cet écran, insérés tout en haut de
        # layout_reglages, même pattern que TestComposantScreen. ---
        index_insertion = 0

        titre = QLabel("COORDONNÉE D'ACTION", self._colonne_gauche)
        titre.setObjectName("ReglagesPanelTitle")
        self.layout_reglages.insertWidget(index_insertion, titre)
        index_insertion += 1

        if not VISION_DISPONIBLE:
            avertissement = QLabel(
                "cv2/numpy introuvables sur cette machine : la reconnaissance "
                "visuelle est indisponible.",
                self._colonne_gauche,
            )
            avertissement.setWordWrap(True)
            avertissement.setStyleSheet(f"color: {Mocha.red};")
            self.layout_reglages.insertWidget(index_insertion, avertissement)
            index_insertion += 1
        elif not RESEAU_DASHBOARD_DISPONIBLE:
            avertissement = QLabel(
                "Module 'websockets' non installé -- cet écran nécessite une "
                "connexion au serveur central.",
                self._colonne_gauche,
            )
            avertissement.setWordWrap(True)
            avertissement.setStyleSheet(f"color: {Mocha.red};")
            self.layout_reglages.insertWidget(index_insertion, avertissement)
            index_insertion += 1

        self.layout_reglages.insertWidget(index_insertion, self._section_label("COMPOSANT"))
        index_insertion += 1
        self.composant_label = QLabel(self.composant.nom, self._colonne_gauche)
        self.composant_label.setWordWrap(True)
        self.layout_reglages.insertWidget(index_insertion, self.composant_label)
        index_insertion += 1

        # --- Démarrer/arrêter la recherche (une seule tentative par clic,
        # jamais de boucle continue -- même mécanisme que
        # TestComposantScreen._toggle_test) ---
        self._widget_recherche = QWidget(self._colonne_gauche)
        recherche_layout = QVBoxLayout(self._widget_recherche)
        recherche_layout.setContentsMargins(0, 0, 0, 0)
        recherche_layout.setSpacing(12)
        recherche_layout.addWidget(self._section_label("RECHERCHE"))
        self.demarrer_button = QPushButton(
            qta.icon("mdi6.play", color=Mocha.text), " Rechercher le composant", self._colonne_gauche
        )
        self.demarrer_button.setObjectName("UpdateImageButton")
        self.demarrer_button.setCursor(Qt.PointingHandCursor)
        self.demarrer_button.clicked.connect(self._toggle_recherche)
        self.demarrer_button.setEnabled(False)
        recherche_layout.addWidget(self.demarrer_button)

        self.statut_label = QLabel(
            "Sélectionnez une instance cible puis lancez la recherche." if self._templates_bgr
            else "Ce composant n'a aucune variante d'image valide.",
            self._colonne_gauche,
        )
        self.statut_label.setWordWrap(True)
        self.statut_label.setStyleSheet(f"color: {Mocha.subtext0};")
        recherche_layout.addWidget(self.statut_label)

        self.layout_reglages.addWidget(self._widget_recherche)

        # --- Tracé : instructions + bouton "Effacer le tracé" ---
        self.layout_reglages.addWidget(self._section_label("ZONE DE CLIC"))
        instructions = QLabel(
            "Une fois le composant détecté : glisser-relâcher sur l'aperçu "
            "pour tracer un rectangle, Espace pour copier ses coordonnées "
            "et les valider, Échap pour annuler le tracé en cours.",
            self._colonne_gauche,
        )
        instructions.setWordWrap(True)
        instructions.setStyleSheet(f"color: {Mocha.subtext0}; font-size: 11px;")
        self.layout_reglages.addWidget(instructions)

        self.effacer_trace_button = QPushButton(
            qta.icon("mdi6.eraser", color=Mocha.text), " Effacer le tracé", self._colonne_gauche
        )
        self.effacer_trace_button.setCursor(Qt.PointingHandCursor)
        self.effacer_trace_button.clicked.connect(lambda: self.apercu_traceable.effacer_trace())
        self.layout_reglages.addWidget(self.effacer_trace_button)

        self.derniere_zone_label = QLabel("Aucune zone validée pour l'instant.", self._colonne_gauche)
        self.derniere_zone_label.setWordWrap(True)
        self.derniere_zone_label.setStyleSheet(f"color: {Mocha.subtext0}; font-size: 11px;")
        self.layout_reglages.addWidget(self.derniere_zone_label)

        self.layout_reglages.addStretch(1)

        self.instance_combo.currentIndexChanged.connect(lambda _index: self._rafraichir_disponibilite_demarrer())
        self._rafraichir_disponibilite_demarrer()
        self.demarrer_reseau()

    # ------------------------------------------------------------------
    def _rafraichir_disponibilite_demarrer(self):
        pret = (
            VISION_DISPONIBLE
            and RESEAU_DASHBOARD_DISPONIBLE
            and bool(self._templates_bgr)
            and self.instance_combo.currentData() is not None
        )
        self.demarrer_button.setEnabled(pret)

    def _changement_instance_pre(self, nouvelle_instance: Optional[str]):
        if self._en_cours or self._detection_en_vol:
            self._arreter_recherche(trouve=False)

    def _changement_instance_post(self, nouvelle_instance: Optional[str]):
        self._rafraichir_disponibilite_demarrer()

    def _sur_liaison_echouee_pour_instance(self, instance_id: str, message: str):
        if self._en_cours or self._detection_en_vol:
            self._arreter_recherche(trouve=False)
        self._rafraichir_disponibilite_demarrer()
        self.statut_label.setText(f"{message} Sélectionnez une autre instance ou libérez celle-ci.")

    def _toggle_recherche(self):
        if self._en_cours or self._detection_en_vol:
            self._arreter_recherche(trouve=False)
        else:
            self._demarrer_recherche()

    def _demarrer_recherche(self):
        if not self._templates_bgr:
            self.statut_label.setText("Ce composant n'a aucune variante d'image valide.")
            return
        instance_id = self.instance_combo.currentData()
        if instance_id is None or self.client_reseau is None:
            self.statut_label.setText("Sélectionnez une instance cible valide.")
            return
        if instance_id != self._instance_liee:
            self.statut_label.setText(
                f"Liaison à '{instance_id}' non confirmée par le serveur -- resélectionnez l'instance."
            )
            return
        self._en_cours = True
        self.instance_combo.setEnabled(False)
        self.apercu_traceable.definir_resultat_detection(None, 1.0)
        capture_lancee = self.demander_rafraichissement_pour_test()
        if capture_lancee:
            self.demarrer_button.setEnabled(False)
            self.demarrer_button.setText(" Capture en cours…")
            self.statut_label.setText("Capture en cours…")
            return
        if self._derniere_image is None:
            self._en_cours = False
            self.instance_combo.setEnabled(True)
            self.statut_label.setText(
                "Aucune image disponible pour l'instant -- patientez la prochaine frame du flux automatique."
            )
            return
        self.demarrer_button.setText(" Arrêter la recherche")
        self.demarrer_button.setIcon(qta.icon("mdi6.stop", color=Mocha.text))
        self._lancer_detection(self._derniere_image)

    def _arreter_recherche(self, trouve: bool):
        self._en_cours = False
        self.demarrer_button.setEnabled(True)
        self.demarrer_button.setText(" Rechercher le composant")
        self.demarrer_button.setIcon(qta.icon("mdi6.play", color=Mocha.text))
        self.instance_combo.setEnabled(True)
        if not trouve:
            self.statut_label.setText("Recherche arrêtée. Relancez si besoin.")

    def _sur_nouvelle_frame(self, image: QImage, capture_ponctuelle: bool):
        if not self._en_cours or self._detection_en_vol:
            self.apercu_traceable.afficher_image(image)
            return
        self._lancer_detection(image)

    def _lancer_detection(self, image: QImage):
        self._en_cours = False
        self._detection_en_vol = True
        self._image_en_cours_analyse = image
        self.demarrer_button.setEnabled(True)
        self.demarrer_button.setText(" Arrêter la recherche")
        self.demarrer_button.setIcon(qta.icon("mdi6.stop", color=Mocha.text))
        self.apercu_traceable.afficher_image(image)
        self.statut_label.setText("Capture sans curseur pour l'analyse…")
        self._demander_capture_propre(self._sur_capture_propre_pour_detection)

    def _sur_capture_propre_pour_detection(self, image_b64: Optional[str], erreur: Optional[str]):
        if erreur is not None:
            self._detection_en_vol = False
            self._image_en_cours_analyse = None
            self._arreter_recherche(trouve=False)
            self.statut_label.setText(f"Échec de la capture sans curseur : {erreur}")
            return
        image_propre = decoder_image_b64(image_b64) if image_b64 else None
        if image_propre is None:
            self._detection_en_vol = False
            self._image_en_cours_analyse = None
            self._arreter_recherche(trouve=False)
            self.statut_label.setText("Échec de la capture sans curseur : image invalide.")
            return
        self.statut_label.setText("Analyse en cours…")
        # PATCH (SPEC_GLOBALE_AutoniaX.md, Partie A §3.6) -- self._templates_bgr
        # contient désormais des tuples (image_bgr, Variante) (cf.
        # charger_templates_bgr) : les réglages composant.seuil_confiance/
        # priorite_selection/flou_noyau/delta_conflit/code_filtre ne sont
        # plus lus ici, chaque Variante porte désormais les siens propres.
        # Les 5 arguments par défaut de demander_detection (seuil=0.9,
        # priorite="mostTop", etc.) ne servent alors que de repli
        # rétrocompatible si jamais self._templates_bgr contenait encore
        # des images nues (ne devrait plus arriver, cf. charger_templates_bgr).
        self._detection_worker.demander_detection(image_propre, self._templates_bgr)

    def _sur_resultat_detection(self, resultat: Optional[dict], erreur: Optional["DetectionAmbigueError"], score_brut: Optional[float]):
        self._detection_en_vol = False
        image = self._image_en_cours_analyse
        self._image_en_cours_analyse = None
        if image is None:
            return

        if erreur is not None:
            self._arreter_recherche(trouve=False)
            # AJOUT (cf. ComposantSingle.code_filtre) : une DetectionFiltreComposantSingleError
            # (code_filtre invalide) transite par ce même paramètre erreur --
            # message dédié plutôt que le générique "Ambigu" hérité de
            # DetectionAmbigueError, pour rester clair sur la cause réelle.
            prefixe = "Erreur du filtre (code_filtre)" if isinstance(erreur, DetectionFiltreComposantSingleError) else "Ambigu"
            self.statut_label.setText(f"{prefixe} : {erreur}")
            return

        self.apercu_traceable.afficher_image(image)

        if resultat is None:
            self.apercu_traceable.definir_resultat_detection(None, 1.0)
            self._arreter_recherche(trouve=False)
            info_score = f" (meilleure correspondance : {score_brut:.2f})" if score_brut is not None else ""
            self.statut_label.setText(
                f"Aucune correspondance suffisante sur cette tentative{info_score}. Relancez si besoin."
            )
            return

        rect_detecte = QRect(resultat["x"], resultat["y"], resultat["largeur"], resultat["hauteur"])
        self.apercu_traceable.definir_resultat_detection(rect_detecte, resultat["echelle"])
        self._dernier_rect_detecte = rect_detecte
        self._derniere_echelle_detection = resultat["echelle"]
        self._arreter_recherche(trouve=True)
        self.statut_label.setText(
            f"Détecté (score {resultat['score']:.2f}, échelle {resultat['echelle']:.2f}). "
            "Tracez la zone de clic sur l'aperçu."
        )

    def _sur_zone_validee(self, zone: ZoneClicRect):
        self.derniere_zone_label.setText(
            f"Copié : x={zone.x}, y={zone.y}, largeur={zone.largeur}, hauteur={zone.hauteur}"
        )
        self.zone_definie.emit(self.composant.nom, zone)

    def arreter(self):
        if self._en_cours:
            self._arreter_recherche(trouve=False)
        self.arreter_reseau()
        self._detection_thread.quit()
        self._detection_thread.wait(3000)


