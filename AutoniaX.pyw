    def _on_clic_redemarrer_serveurt(self):
        """Bouton "Redémarrer le serveurT" (section Serveur central) --
        même patron synchrone-bloquant que GitScreen._pousser_vers_bb_
        direct (put_object Drive de quelques dizaines d'octets, de
        l'ordre de la seconde -- pas besoin d'un thread/signal délégué à
        MainWindow comme pour le chargement des banques, bien plus long).
        Import des libs Google (googleapiclient/google.oauth2) fait
        paresseusement à l'intérieur de _ClientDriveMinimal -- ne
        bloque jamais l'ouverture de cet écran si le paquet n'est pas
        installé, l'erreur ne remonte qu'au clic réel sur ce bouton
        précis."""
        self.bouton_redemarrer_serveurt.setEnabled(False)
        self.label_statut_serveurt.setStyleSheet("")
        self.label_statut_serveurt.setText("Envoi du signal de redémarrage…")
        QApplication.processEvents()
        try:
            GestionnaireStockageDriveDirect(self.reglages).forcer_redemarrage_serveurt()
        except Exception as e:
            log_git.error("_on_clic_redemarrer_serveurt() : échec de l'envoi du signal de redémarrage -- %r", e)
            self.label_statut_serveurt.setStyleSheet(f"color: {Mocha.red};")
            self.label_statut_serveurt.setText(f"Échec : {e}")
            return
        finally:
            self.bouton_redemarrer_serveurt.setEnabled(True)
        self.label_statut_serveurt.setText(
            "Signal envoyé -- le serveurT redémarre (sondage toutes les 10s côté notebook), "
            "reconnexion automatique ensuite."
        )
        # AJOUT (cf. docstring de demande_redemarrer_serveurt et de
        # ClientServeurT.forcer_reconnexion) -- émis seulement APRÈS
        # confirmation que le put_object B2 a réussi (donc jamais dans
        # le except ci-dessus) : forcer une reconnexion immédiate n'a de
        # sens que si le signal de redémarrage est bien parti, sinon le
        # serveurT actuel n'a aucune raison de tomber et on couperait
        # une connexion parfaitement valide pour rien.
        self.demande_redemarrer_serveurt.emit()

    def afficher_resultat_prechargement_banques(self, resultat: dict):
        """Appelée par MainWindow (cf. connexion dans _build_screens, sur
        banques_prechargement_termine) une fois le chargement terminé --
        réactive le bouton et affiche le résultat : message en ROUGE
        (Mocha.red, même couleur d'erreur qu'ailleurs dans l'app, ex.
        ComposantEditor.erreur_nom_label) si au moins une des deux banques
        (trajectoire souris / scroll) est indisponible, sinon confirmation
        neutre."""
        self.bouton_charger_banques.setEnabled(True)
        ok_trajectoire, msg_trajectoire = resultat.get("trajectoire", (False, "résultat manquant"))
        ok_scroll, msg_scroll = resultat.get("scroll", (False, "résultat manquant"))

        if ok_trajectoire and ok_scroll:
            self.label_statut_banques.setStyleSheet("")
            self.label_statut_banques.setText(
                "Banques chargées : trajectoire souris et scroll prêts pour un rendu humanisé."
            )
        else:
            parties = []
            if not ok_trajectoire:
                parties.append(f"trajectoire souris : {msg_trajectoire}")
            if not ok_scroll:
                parties.append(f"scroll : {msg_scroll}")
            self.label_statut_banques.setStyleSheet(f"color: {Mocha.red};")
            self.label_statut_banques.setText(" | ".join(parties))


# ---------------------------------------------------------------------------
# Flux de capture de composant (Patch 4)
# ---------------------------------------------------------------------------
class SelectionZoneOverlay(QWidget):
    """Overlay de capture type "outil de capture" (Snipping Tool / Greenshot) :
    couvre l'ensemble du bureau (tous moniteurs) par-dessus une image déjà
    capturée du bureau réel, assombrit tout, puis éclaircit en direct la
    zone tracée à la souris pour délimiter le composant (point 2). Aucune
    notion de fenêtre/hwnd ici — uniquement ce qui est visible à l'écran.

    Mécanisme corrigé (redessinable, comme un outil de capture classique) :
      - Le relâchement de la souris NE valide PAS et NE ferme PAS l'overlay :
        il fige simplement le rectangle actuel, librement retraçable ensuite
        (un nouveau mousePressEvent efface le précédent et permet de redessiner
        autant de fois que nécessaire tant que rien n'a été validé).
      - Espace = valide la sélection courante -> ferme l'overlay -> émet
        zone_selectionnee(QRect) en coordonnées de l'image d'origine.
      - Échap = annule tout -> ferme l'overlay -> émet annulee(), rien n'est
        transmis (l'image capturée ne doit pas disparaître "avec" l'overlay
        sans that l'utilisateur ait pu la récupérer : ici rien n'a jamais
        été validé, donc il n'y a rien à perdre).

    CORRECTIF (bug rapporté -- image de rendu réseau plus grande que l'écran :
    "cest un probleme daffihcage , si les dimeniond elimasont plus grand que
    lecran actuels cest nromal que sa affihce la zonne pardefut, il faut que
    tu change sa") -- à l'origine cette classe posait sa PROPRE géométrie à
    la taille EXACTE de l'image (self.setGeometry(0, 0, pixmap.width(),
    pixmap.height())), ce qui fonctionnait bien pour son cas d'usage
    d'origine (capture bureau réelle, jamais plus grande que l'écran qui l'a
    produite). Une image de rendu réseau (résolution du navigateur distant)
    peut en revanche largement dépasser l'écran local -- la fenêtre se
    retrouvait alors contrainte à l'écran par Qt/l'OS, ce qui revenait
    toujours à afficher le coin haut-gauche de l'image (0,0), quelle que
    soit la position de défilement que l'utilisateur avait dans le panneau
    d'aperçu juste avant de cliquer sur le ciseau -- d'où l'impression que
    "le slide se réinitialise" alors qu'en réalité rien n'était mémorisé
    entre les deux.

    Fix : la fenêtre est maintenant toujours contrainte à la taille de
    l'ÉCRAN (jamais à celle de l'image), et un défilement interne propre
    (self._offset, molette ou PageUp/PageDown/flèches) permet de naviguer
    dans une image plus grande -- paintEvent dessine la portion de
    self._pixmap correspondant à cet offset plutôt que systématiquement son
    coin (0,0). offset_initial (nouveau paramètre optionnel) permet à
    l'appelant de préremplir ce décalage avec la position de scroll qu'il
    avait déjà (cf. FenetreRenduTaskReseau._demarrer_selection_zone), pour
    que l'overlay s'ouvre exactement sur la zone déjà visible à l'écran,
    plutôt que de repartir du début. Toutes les coordonnées souris
    (mousePress/Move/Release) sont converties widget -> image via +
    self._offset avant d'être mémorisées, pour que le rectangle tracé et la
    découpe finale (zone_selectionnee) restent en coordonnées IMAGE
    correctes quel que soit le défilement courant. Comportement inchangé
    pour une image qui tient déjà entièrement dans l'écran (cas d'usage
    d'origine, capture bureau classique) : l'offset possible y est de toute
    façon (0, 0) sur les deux axes, aucune régression."""

    zone_selectionnee = Signal(QRect)
    annulee = Signal()

    # Assombrissement appliqué en dehors de la zone sélectionnée.
    OPACITE_VOILE = 120  # sur 255

    # Pas de défilement au clavier (flèches/PageUp/PageDown) et à la
    # molette, en pixels IMAGE (pas widget) -- valeurs confortables pour
    # naviguer une capture de plusieurs écrans sans trop de crans.
    _PAS_DEFILEMENT_FLECHE = 80
    _PAS_DEFILEMENT_PAGE = 600

    def __init__(
        self, image_bureau: QImage, parent=None,
        offset_initial: Optional[QPoint] = None, ecran: Optional["QScreen"] = None,
    ):
        super().__init__(parent)
        self.setWindowFlags(Qt.FramelessWindowHint | Qt.WindowStaysOnTopHint | Qt.Tool)
        self.setWindowTitle("Sélectionnez le composant — Espace valide, Échap annule")
        self._image_bureau = image_bureau
        self._pixmap = QPixmap.fromImage(image_bureau)

        # CORRECTIF (cf. docstring de classe) -- géométrie bornée à
        # l'écran courant, JAMAIS à la taille réelle de l'image : c'est
        # elle qui pouvait dépasser l'écran (rendu réseau), pas l'inverse.
        #
        # CORRECTIF 2 (bug rapporté -- défilement horizontal totalement
        # bloqué en multi-écrans : "il ya un turc etrange" / molette Shift
        # et flèches gauche/droite sans aucun effet) -- self.screen(),
        # appelé ICI avant que ce widget n'ait jamais été affiché nulle
        # part, ne reflète PAS fiablement l'écran où se trouve réellement
        # la fenêtre appelante (FenetreRenduTaskReseau) sur une
        # configuration multi-moniteurs : Qt retombe alors souvent sur
        # l'écran PRIMAIRE par défaut, qui peut être plus large que
        # l'écran réel -- _borner_offset calculait alors max_x = max(0,
        # largeur_image - largeur_écran_primaire) à partir de cette
        # largeur erronée (trop grande), le ramenant à 0 dès que l'image
        # ne dépassait pas CETTE largeur-là, même si elle dépassait
        # largement la largeur de l'écran RÉEL, plus étroit -- d'où un
        # défilement vertical qui fonctionnait (la hauteur souffrait
        # moins souvent de cet écart) mais un horizontal totalement figé.
        # Fixé en acceptant désormais un `ecran` explicite fourni par
        # l'appelant (cf. FenetreRenduTaskReseau._demarrer_selection_zone,
        # qui utilise self.window().screen() -- l'écran RÉEL de la
        # fenêtre déjà affichée, fiable) ; repli sur self.screen() puis
        # l'écran primaire UNIQUEMENT si rien n'est fourni (autres
        # appelants existants de cette classe, non modifiés par ce
        # correctif, cf. leur propre revue).
        ecran_effectif = ecran or self.screen() or QGuiApplication.primaryScreen()
        geometry_ecran = ecran_effectif.geometry() if ecran_effectif is not None else QRect(0, 0, 1280, 800)
        self.setGeometry(geometry_ecran)

        # Décalage de défilement courant (coin haut-gauche de la portion
        # de self._pixmap actuellement affichée), en coordonnées IMAGE --
        # borné dans _borner_offset dès que la taille du widget est connue
        # (ici, juste après setGeometry ci-dessus).
        self._offset = QPoint(offset_initial) if offset_initial is not None else QPoint(0, 0)
        self._offset = self._borner_offset(self._offset)

        # PATCH (demande explicite utilisateur : "actuelement la croix de
        # slection nes pas bien visible , je veux que tu met sa couleur
        # bien plus foncer ,cest visible juste qund je commence a
        # maintenir le clic , si non , avant sa cest trop grisee") --
        # Qt.CrossCursor est un curseur SYSTÈME (fin, gris clair sur la
        # plupart des thèmes), sans couleur personnalisable directement.
        # On le masque et on dessine nous-mêmes une croix plein écran dans
        # paintEvent (cf. plus bas), dans une couleur bien plus foncée et
        # contrastée -- visible dès l'ouverture de l'overlay, PAS seulement
        # une fois le clic maintenu (contrairement au rectangle de sélection
        # ci-dessous, qui lui reste normal : n'apparaît qu'au tracé).
        self.setCursor(Qt.BlankCursor)
        # Position courante de la souris dans le repère de l'overlay, tenue
        # à jour par mouseMoveEvent même AVANT tout clic (nécessaire pour
        # dessiner la croix dès l'ouverture, avant le premier mousePress) --
        # cf. setMouseTracking ci-dessous.
        self._pos_souris: Optional[QPoint] = None
        self.setMouseTracking(True)
        self.setFocusPolicy(Qt.StrongFocus)

        self._origine_drag: Optional[QPoint] = None
        self._rect_courant: Optional[QRect] = None

    def showEvent(self, event):
        super().showEvent(event)
        # CORRECTIF (cf. docstring de classe) -- recalcule l'offset une
        # fois la géométrie RÉELLE et définitive du widget connue :
        # showFullScreen() (appelé juste après la construction, cf.
        # FenetreRenduTaskReseau._demarrer_selection_zone) peut légèrement
        # ajuster la géométrie posée dans __init__ selon le gestionnaire
        # de fenêtres/l'écran effectivement utilisé -- s'assure que
        # l'offset initial reste valide (jamais hors de l'image) même
        # dans ce cas, plutôt que de se fier uniquement au borne fait au
        # moment de la construction.
        self._offset = self._borner_offset(self._offset)
        # Nécessaire pour recevoir les événements clavier (Espace/Échap)
        # immédiatement, sans clic préalable requis.
        self.setFocus(Qt.OtherFocusReason)

    def _rect_valide(self) -> bool:
        return (
            self._rect_courant is not None
            and not self._rect_courant.isEmpty()
            and self._rect_courant.normalized().width() >= 4
            and self._rect_courant.normalized().height() >= 4
        )

    def _borner_offset(self, offset: QPoint) -> QPoint:
        """Contraint `offset` pour que la portion affichée reste toujours
        À L'INTÉRIEUR de self._pixmap -- appelé à chaque changement de
        défilement (molette, flèches/PageUp/PageDown) ET une fois à
        l'ouverture (offset_initial fourni par l'appelant peut, en théorie,
        pointer légèrement hors bornes si la taille du panneau d'origine
        différait de celle de cet écran)."""
        max_x = max(0, self._pixmap.width() - self.width())
        max_y = max(0, self._pixmap.height() - self.height())
        return QPoint(
            max(0, min(offset.x(), max_x)),
            max(0, min(offset.y(), max_y)),
        )

    def _defiler(self, delta_x: int, delta_y: int):
        """Déplace self._offset de (delta_x, delta_y) en coordonnées
        IMAGE, borné à l'intérieur de self._pixmap -- pas d'effet si
        l'image tient déjà entièrement dans l'écran (max_x/max_y à 0 des
        deux côtés dans _borner_offset, donc offset toujours ramené à
        (0, 0))."""
        nouvel_offset = QPoint(self._offset.x() + delta_x, self._offset.y() + delta_y)
        nouvel_offset = self._borner_offset(nouvel_offset)
        if nouvel_offset != self._offset:
            self._offset = nouvel_offset
            self.update()

    def _dessiner_croix_curseur(self, painter: QPainter):
        """PATCH (curseur croix bien plus visible, demande explicite
        utilisateur) -- dessine une croix plein écran centrée sur
        self._pos_souris, en remplacement de Qt.CrossCursor (masqué, cf.
        setCursor(Qt.BlankCursor) dans __init__). Couleur nettement plus
        foncée/contrastée que le curseur système par défaut, ET visible
        en PERMANENCE dès l'ouverture de l'overlay -- pas seulement une
        fois le clic maintenu, contrairement à avant."""
        if self._pos_souris is None:
            return
        pen = QPen(QColor(Mocha.crust))
        pen.setWidth(1)
        painter.setPen(pen)
        x, y = self._pos_souris.x(), self._pos_souris.y()
        painter.drawLine(0, y, self.width(), y)
        painter.drawLine(x, 0, x, self.height())

    def paintEvent(self, event):
        painter = QPainter(self)
        # CORRECTIF (cf. docstring de classe) -- dessine la portion de
        # self._pixmap décalée de self._offset (coin haut-gauche de la
        # zone image actuellement visible), plus jamais systématiquement
        # son coin (0, 0) : -self._offset décale le pixmap ENTIER, Qt ne
        # peint que ce qui tombe dans self.rect() (taille écran), exactement
        # comme un QScrollArea le ferait avec son propre widget interne.
        painter.drawPixmap(-self._offset, self._pixmap)

        voile = QColor(0, 0, 0, self.OPACITE_VOILE)
        if self._rect_courant is None or self._rect_courant.isEmpty():
            painter.fillRect(self.rect(), voile)
            self._dessiner_croix_curseur(painter)
            return

        # self._rect_courant est en coordonnées WIDGET (cf. mousePress/
        # Move/Release ci-dessous, qui travaillent déjà dans ce repère
        # pour le tracé visuel) -- l'assombrissement/le cadre restent donc
        # calculés tels quels, aucune conversion supplémentaire ici.
        zone = self._rect_courant.normalized()
        # Assombrit tout sauf la zone sélectionnée (4 bandes autour d'elle),
        # pour que la portion choisie apparaisse nette/éclaircie comme dans
        # un outil de capture classique.
        painter.fillRect(QRect(0, 0, self.width(), zone.top()), voile)
        painter.fillRect(QRect(0, zone.bottom() + 1, self.width(), self.height() - zone.bottom() - 1), voile)
        painter.fillRect(QRect(0, zone.top(), zone.left(), zone.height() + 1), voile)
        painter.fillRect(
            QRect(zone.right() + 1, zone.top(), self.width() - zone.right() - 1, zone.height() + 1),
            voile,
        )

        pen = QPen(QColor(Mocha.mauve))
        pen.setWidth(2)
        painter.setPen(pen)
        painter.setBrush(Qt.NoBrush)
        painter.drawRect(zone)
        self._dessiner_croix_curseur(painter)

    def mousePressEvent(self, event):
        if event.button() == Qt.LeftButton:
            # Redémarre toujours un nouveau tracé : permet de redessiner
            # librement autant de fois que voulu avant validation (Espace).
            self._origine_drag = event.pos()
            self._rect_courant = QRect(self._origine_drag, QSize())
            self.update()

    def mouseMoveEvent(self, event):
        # PATCH (croix curseur custom) -- tenue à jour à CHAQUE mouvement,
        # même hors drag (mousePressEvent pas encore appelé) : nécessaire
        # pour que la croix suive la souris dès l'ouverture de l'overlay,
        # avant tout premier clic. setMouseTracking(True) dans __init__
        # rend ce cas possible (sinon Qt n'émettrait ce signal que pendant
        # un bouton maintenu).
        self._pos_souris = event.pos()
        if self._origine_drag is not None:
            self._rect_courant = QRect(self._origine_drag, event.pos())
        self.update()

    def mouseReleaseEvent(self, event):
        if event.button() == Qt.LeftButton and self._origine_drag is not None:
            # Relâchement = fige juste le rectangle courant (normalisé et
            # borné au widget, PAS à l'image -- cf. conversion en
            # coordonnées image dans keyPressEvent/Espace, seul moment où
            # cela compte réellement). L'utilisateur peut retracer une
            # nouvelle zone à tout moment, ou appuyer sur Espace pour
            # valider celle-ci.
            rect = QRect(self._origine_drag, event.pos()).normalized()
            rect = rect.intersected(self.rect())
            self._origine_drag = None
            self._rect_courant = rect
            self.update()

    def wheelEvent(self, event):
        # CORRECTIF (cf. docstring de classe) -- permet de défiler DANS
        # l'overlay si l'image dépasse l'écran (rendu réseau), au lieu de
        # n'avoir aucun moyen d'atteindre une zone hors de la portion
        # initialement visible. Deux sources possibles pour l'axe
        # horizontal : un vrai geste horizontal natif (trackpad, molette
        # à inclinaison latérale -- angleDelta().x() directement rempli
        # par Qt dans ce cas) OU Shift + molette verticale (convention
        # desktop courante sur souris classique, sans axe horizontal
        # physique) -- géré en repli SEULEMENT si aucun delta horizontal
        # natif n'est présent, pour ne jamais cumuler les deux.
        delta = event.angleDelta()
        if delta.x() != 0:
            self._defiler(-delta.x(), 0)
        elif event.modifiers() & Qt.ShiftModifier:
            self._defiler(-delta.y(), 0)
        else:
            self._defiler(0, -delta.y())
        event.accept()

    def keyPressEvent(self, event):
        if event.key() == Qt.Key_Escape:
            self.annulee.emit()
            self.close()
        elif event.key() == Qt.Key_Space:
            if self._rect_valide():
                # CORRECTIF (cf. docstring de classe) -- self._rect_courant
                # est en coordonnées WIDGET (repère de l'écran affiché),
                # jamais directement en coordonnées IMAGE dès que l'overlay
                # est défilé (self._offset != (0, 0)) : + self._offset
                # convertit vers le repère de l'image AVANT d'émettre, pour
                # que la zone découpée par _sur_zone_selection_validee (cf.
                # FenetreRenduTaskReseau) corresponde bien à ce que
                # l'utilisateur voyait à l'écran, pas à un décalage
                # erroné. intersected() reste calculé sur la taille réelle
                # de l'image (jamais celle, plus petite, de l'écran).
                zone_widget = self._rect_courant.normalized()
                zone = zone_widget.translated(self._offset).intersected(
                    QRect(QPoint(0, 0), self._pixmap.size())
                )
                self.zone_selectionnee.emit(zone)
                self.close()
            # Si aucune zone valide n'est encore tracée, Espace ne fait
            # rien (pas de fermeture prématurée sans sélection).
        elif event.key() in (Qt.Key_Left, Qt.Key_Right, Qt.Key_Up, Qt.Key_Down):
            # CORRECTIF (cf. docstring de classe) -- défilement clavier,
            # complémentaire à la molette (wheelEvent) : pratique pour
            # ajuster finement la zone visible sans quitter le clavier
            # pendant le tracé. Sans effet si l'image tient déjà
            # entièrement dans l'écran (cf. _borner_offset).
            pas = self._PAS_DEFILEMENT_FLECHE
            if event.key() == Qt.Key_Left:
                self._defiler(-pas, 0)
            elif event.key() == Qt.Key_Right:
                self._defiler(pas, 0)
            elif event.key() == Qt.Key_Up:
                self._defiler(0, -pas)
            elif event.key() == Qt.Key_Down:
                self._defiler(0, pas)
        elif event.key() in (Qt.Key_PageUp, Qt.Key_PageDown):
            pas = self._PAS_DEFILEMENT_PAGE
            self._defiler(0, -pas if event.key() == Qt.Key_PageUp else pas)
        else:
            super().keyPressEvent(event)


class ZoneClicSelector(QWidget):
    """Fenêtre séparée affichant l'image d'un composant en grand (zoomée) pour
    tracer précisément sa zone de clic personnalisée. Même mécanisme que
    SelectionZoneOverlay (redessin libre, Espace valide, Échap annule), mais
    sur une image de composant déjà capturée plutôt que sur le bureau entier,
    et dans une fenêtre centrée à l'écran plutôt qu'en plein écran.

    Émet zone_selectionnee(QRect) en coordonnées de l'IMAGE D'ORIGINE du
    composant (donc indépendant du facteur de zoom affiché), ou annulee()."""

    zone_selectionnee = Signal(QRect)
    annulee = Signal()

    OPACITE_VOILE = 120
    MARGE_FENETRE = 60  # espace réservé autour de l'image zoomée

    def __init__(self, image_composant: QImage, zone_initiale: Optional[QRect] = None, parent=None):
        super().__init__(parent)
        self.setWindowFlags(Qt.Dialog | Qt.FramelessWindowHint | Qt.WindowStaysOnTopHint)
        self.setWindowTitle("Zone de clic — Espace valide, Échap annule")
        self.setCursor(Qt.CrossCursor)
        self.setFocusPolicy(Qt.StrongFocus)

        self._image_originale = image_composant
        self._facteur_zoom = self._calculer_facteur_zoom(image_composant)
        image_zoomee = image_composant.scaled(
            int(image_composant.width() * self._facteur_zoom),
            int(image_composant.height() * self._facteur_zoom),
            Qt.KeepAspectRatio,
            Qt.SmoothTransformation,
        )
        self._pixmap = QPixmap.fromImage(image_zoomee)

        largeur_fenetre = self._pixmap.width() + self.MARGE_FENETRE
        hauteur_fenetre = self._pixmap.height() + self.MARGE_FENETRE
        self.resize(largeur_fenetre, hauteur_fenetre)
        self._centrer_sur_ecran()

        self._offset = QPoint(self.MARGE_FENETRE // 2, self.MARGE_FENETRE // 2)
        self._origine_drag: Optional[QPoint] = None
        self._rect_courant: Optional[QRect] = None  # en coordonnées widget (zoomées + offset)

        if zone_initiale is not None and not zone_initiale.isEmpty():
            # Convertit la zone existante (coords image d'origine) vers l'affichage zoomé.
            zoomee = QRect(
                int(zone_initiale.x() * self._facteur_zoom) + self._offset.x(),
                int(zone_initiale.y() * self._facteur_zoom) + self._offset.y(),
                int(zone_initiale.width() * self._facteur_zoom),
                int(zone_initiale.height() * self._facteur_zoom),
            )
            self._rect_courant = zoomee

    def _calculer_facteur_zoom(self, image: QImage) -> float:
        ecran = QGuiApplication.primaryScreen()
        geometry = ecran.availableGeometry() if ecran else QRect(0, 0, 1280, 800)
        largeur_max = geometry.width() * 0.7
        hauteur_max = geometry.height() * 0.7
        if image.width() <= 0 or image.height() <= 0:
            return 1.0
        facteur = min(largeur_max / image.width(), hauteur_max / image.height())
        # Agrandit toujours un minimum pour faciliter le tracé précis sur de
        # petits composants, sans dépasser un facteur déraisonnable.
        return max(1.0, min(facteur, 6.0))

    def _centrer_sur_ecran(self):
        ecran = QGuiApplication.primaryScreen()
        geometry = ecran.availableGeometry() if ecran else QRect(0, 0, 1280, 800)
        x = geometry.x() + (geometry.width() - self.width()) // 2
        y = geometry.y() + (geometry.height() - self.height()) // 2
        self.move(x, y)

    def showEvent(self, event):
        super().showEvent(event)
        self.setFocus(Qt.OtherFocusReason)

    def _zone_image_bounds(self) -> QRect:
        return QRect(self._offset, self._pixmap.size())

    def _rect_valide(self) -> bool:
        if self._rect_courant is None or self._rect_courant.isEmpty():
            return False
        zone = self._rect_courant.normalized().intersected(self._zone_image_bounds())
        return zone.width() >= 2 and zone.height() >= 2

    def paintEvent(self, event):
        painter = QPainter(self)
        painter.fillRect(self.rect(), QColor(Mocha.crust))
        painter.drawPixmap(self._offset, self._pixmap)

        voile = QColor(0, 0, 0, self.OPACITE_VOILE)
        bounds = self._zone_image_bounds()

        if self._rect_courant is None or self._rect_courant.isEmpty():
            painter.fillRect(bounds, voile)
        else:
            zone = self._rect_courant.normalized().intersected(bounds)
            painter.fillRect(QRect(bounds.left(), bounds.top(), bounds.width(), zone.top() - bounds.top()), voile)
            painter.fillRect(QRect(bounds.left(), zone.bottom() + 1, bounds.width(), bounds.bottom() - zone.bottom()), voile)
            painter.fillRect(QRect(bounds.left(), zone.top(), zone.left() - bounds.left(), zone.height() + 1), voile)
            painter.fillRect(
                QRect(zone.right() + 1, zone.top(), bounds.right() - zone.right(), zone.height() + 1),
                voile,
            )
            pen = QPen(QColor(Mocha.mauve))
            pen.setWidth(2)
            painter.setPen(pen)
            painter.setBrush(Qt.NoBrush)
            painter.drawRect(zone)

        # Cadre autour de l'image pour la distinguer nettement du fond.
        pen_cadre = QPen(QColor(Mocha.surface2))
        pen_cadre.setWidth(1)
        painter.setPen(pen_cadre)
        painter.setBrush(Qt.NoBrush)
        painter.drawRect(bounds.adjusted(0, 0, -1, -1))

    def mousePressEvent(self, event):
        if event.button() == Qt.LeftButton:
            self._origine_drag = event.pos()
            self._rect_courant = QRect(self._origine_drag, QSize())
            self.update()

    def mouseMoveEvent(self, event):
        if self._origine_drag is not None:
            self._rect_courant = QRect(self._origine_drag, event.pos())
            self.update()

    def mouseReleaseEvent(self, event):
        if event.button() == Qt.LeftButton and self._origine_drag is not None:
            rect = QRect(self._origine_drag, event.pos()).normalized()
            rect = rect.intersected(self._zone_image_bounds())
            self._origine_drag = None
            self._rect_courant = rect
            self.update()

    def keyPressEvent(self, event):
        if event.key() == Qt.Key_Escape:
            self.annulee.emit()
            self.close()
        elif event.key() == Qt.Key_Space:
            if self._rect_valide():
                zone_widget = self._rect_courant.normalized().intersected(self._zone_image_bounds())
                # Reconvertit vers les coordonnées de l'image d'ORIGINE (pas
                # zoomée) : c'est ce qui doit être stocké dans le modèle, pour
                # rester valable quel que soit le facteur de zoom d'affichage.
                zone_originale = QRect(
                    int((zone_widget.x() - self._offset.x()) / self._facteur_zoom),
                    int((zone_widget.y() - self._offset.y()) / self._facteur_zoom),
                    max(1, int(zone_widget.width() / self._facteur_zoom)),
                    max(1, int(zone_widget.height() / self._facteur_zoom)),
                )
                zone_originale = zone_originale.intersected(
                    QRect(QPoint(0, 0), self._image_originale.size())
                )
                self.zone_selectionnee.emit(zone_originale)
                self.close()
        else:
            super().keyPressEvent(event)


class FlowGrid(QWidget):
    """Grille responsive simple : place des widgets enfants en lignes/colonnes
    qui se réajustent automatiquement à la largeur disponible (retour à la
    ligne automatique), inspirée du principe de FlowGallery. Utilisée pour la
    grille de vignettes de composants.

    center=True : centre horizontalement le bloc de colonnes réellement
    utilisé dans la largeur disponible (au lieu de le coller à gauche) —
    utilisé pour la grille de Tasks, qui contient peu de cards et ne doit
    pas paraître "rangée depuis le haut-gauche" quand l'écran est large."""

    def __init__(self, item_width: int = 160, spacing: int = 14, center: bool = False, parent=None):
        super().__init__(parent)
        self._item_width = item_width
        self._spacing = spacing
        self._center = center
        self._items: list = []  # list[QWidget]
        self._hauteur_calculee = 2 * spacing
        self._grid = QGridLayout(self)
        self._grid.setContentsMargins(spacing, spacing, spacing, spacing)
        self._grid.setSpacing(spacing)
        self._grid.setAlignment(Qt.AlignTop | Qt.AlignLeft)

    def clear(self):
        for item in self._items:
            self._grid.removeWidget(item)
            item.setParent(None)
            item.deleteLater()
        self._items = []

    def add_item(self, widget: QWidget):
        self._items.append(widget)
        self._relayout()

    def _largeur_reference(self) -> int:
        """Largeur à utiser pour décider du nombre de colonnes.

        Bug corrigé : self.width() ne convient PAS ici. FlowGrid vit dans
        un QScrollArea (setWidgetResizable=True), et son propre QGridLayout
        interne exige une largeur minimale égale à la somme des colonnes
        déjà posées (N colonnes de item_width) — donc self.width() suit le
        CONTENU déjà posé, jamais l'inverse. Résultat observé : la grille ne
        rétrécit jamais quand l'espace diminue (panneau de réglages ouvert),
        les vignettes suivantes restent alignées sur la même rangée derrière
        le panneau au lieu de repasser à la ligne, et le QScrollArea fait
        apparaître une scrollbar horizontale au lieu de recalculer les
        colonnes. En utilisant la largeur du VIEWPORT du QScrollArea
        ancêtre (le vrai espace visuellement disponible, qui lui suit
        correctement les redimensionnements de la fenêtre/du panneau), le
        calcul des colonnes redevient piloté par l'espace réel plutôt que
        par le contenu déjà en place.

        On remonte dynamiquement la hiérarchie de parents (pas un nombre
        fixe de niveaux) : FlowGrid peut être le widget direct passé à
        QScrollArea.setWidget() (cas ComposantsScreen), ou enveloppée dans
        un wrapper intermédiaire pour un centrage vertical (cas
        ServiceAPIScreen, grid_wrapper) — dans les deux cas, le premier
        QScrollArea rencontré en remontant est le bon."""
        widget = self.parentWidget()
        while widget is not None:
            if isinstance(widget, QScrollArea):
                return widget.viewport().width()
            widget = widget.parentWidget()
        return self.width()

    def _colonnes_possibles(self) -> int:
        largeur_ref = self._largeur_reference()
        largeur_dispo = max(largeur_ref - 2 * self._spacing, self._item_width)
        colonnes = max(1, (largeur_dispo + self._spacing) // (self._item_width + self._spacing))
        return int(colonnes)

    def _relayout(self):
        colonnes = self._colonnes_possibles()
        # Retire tout du layout sans détruire les widgets, puis replace.
        for item in self._items:
            self._grid.removeWidget(item)

        colonnes_utilisees = min(colonnes, len(self._items)) if self._items else colonnes
        marge_gauche = self._spacing
        if self._center and colonnes_utilisees > 0:
            largeur_bloc = colonnes_utilisees * self._item_width + (colonnes_utilisees - 1) * self._spacing
            largeur_dispo = max(self._largeur_reference() - 2 * self._spacing, largeur_bloc)
            marge_gauche = self._spacing + max(0, (largeur_dispo - largeur_bloc) // 2)
        self._grid.setContentsMargins(int(marge_gauche), self._spacing, self._spacing, self._spacing)

        for index, item in enumerate(self._items):
            ligne, colonne = divmod(index, colonnes)
            self._grid.addWidget(item, ligne, colonne)

        # Sans hauteur explicite recalculée + notification au layout parent,
        # la QScrollArea (setWidgetResizable=True) ne détecte pas toujours
        # qu'un ajout dynamique de lignes a fait grandir le contenu réel,
        # et tronque silencieusement l'affichage sans scrollbar visible.
        self._hauteur_calculee = self._calculer_hauteur(colonnes)
        self.setMinimumHeight(self._hauteur_calculee)
        self.updateGeometry()

    def _calculer_hauteur(self, colonnes: int) -> int:
        if not self._items:
            return 2 * self._spacing
        lignes = -(-len(self._items) // colonnes)  # division entière arrondie au-dessus
        item_height = self._items[0].sizeHint().height() or self._items[0].height() or 100
        return int(2 * self._spacing + lignes * item_height + max(0, lignes - 1) * self._spacing)

    def sizeHint(self):
        colonnes = self._colonnes_possibles()
        return QSize(self.width(), self._calculer_hauteur(colonnes))

    def heightForWidth(self, width: int) -> int:
        largeur_dispo = max(width - 2 * self._spacing, self._item_width)
        colonnes = max(1, (largeur_dispo + self._spacing) // (self._item_width + self._spacing))
        return self._calculer_hauteur(int(colonnes))

    def hasHeightForWidth(self) -> bool:
        return True

    def resizeEvent(self, event):
        super().resizeEvent(event)
        self._relayout()

    def showEvent(self, event):
        super().showEvent(event)
        # Le viewport du QScrollArea ancêtre est la vraie source de vérité
        # pour la largeur disponible (cf. _largeur_reference). On installe
        # un eventFilter dessus pour être notifié de SES redimensionnements
        # directement — plus fiable que de compter uniquement sur le
        # resizeEvent de FlowGrid elle-même, qui ne se déclenche pas de
        # façon synchrone quand un widget FRÈRE (ex: le panneau de réglages)
        # change de visibilité dans le layout parent.
        widget = self.parentWidget()
        while widget is not None:
            if isinstance(widget, QScrollArea):
                widget.viewport().installEventFilter(self)
                break
            widget = widget.parentWidget()

    def eventFilter(self, watched, event):
        if event.type() == QEvent.Resize:
            self._relayout()
        return super().eventFilter(watched, event)


class MasonryGrid(QWidget):
    """Grille "masonry" (façon Pinterest) : contrairement à FlowGrid
    ci-dessus (cellules UNIFORMES -- même item_width pour toutes les
    colonnes, hauteur de ligne = hauteur du premier item), chaque widget
    ici garde sa PROPRE taille naturelle (sizeHint), potentiellement très
    différente d'un item à l'autre.

    AJOUT (demande explicite utilisateur, grille ComposantsLayoutScreen :
    "les composants n'auront pas forcément toujours la même forme, il y
    en a de très rectangulaires, carrés, ou nettement plus grands ... je
    ne veux pas forcément de ligne ou de colonne, c'est relatif à la
    taille de chaque composant") -- FlowGrid ne convient PAS ici car son
    QGridLayout interne force une cellule uniforme par colonne (toutes
    les tuiles d'une même ligne partagent la même hauteur de ligne),
    donc une tuile 3x plus haute qu'une autre "tire" toute sa ligne vers
    le bas au lieu de laisser ses voisines remonter -- exactement l'effet
    de grille rigide que l'utilisateur ne veut plus pour cet écran.

    Algorithme : N colonnes de largeur FIXE (colonne_largeur), calculées
    depuis la largeur disponible comme FlowGrid._colonnes_possibles
    (même logique, même raison -- cf. sa docstring sur le viewport du
    QScrollArea ancêtre). Chaque item est placé dans la colonne dont la
    hauteur cumulée actuelle est la plus petite (algorithme masonry
    standard), puis positionné en coordonnées absolues (widget enfant
    avec move() + resize(), PAS de QLayout Qt -- aucun layout standard
    Qt ne supporte nativement un packing par plus-petite-colonne). La
    largeur de la colonne est FIXE mais la HAUTEUR de chaque item suit
    son propre ratio naturel (cf. ComposantLayoutTuile, hauteur dérivée
    du ratio réel de image_reference) : c'est ce qui produit l'aspect
    "pas de ligne ni de colonne alignée" recherché, contrairement à
    FlowGrid où toutes les cellules d'une ligne ont la même hauteur.

    API volontairement identique à FlowGrid (clear/add_item/_items/
    _relayout) : ComposantsLayoutScreen s'en sert exactement comme elle
    se servait de FlowGrid (cf. _charger_grille/_sur_supprimer), aucun
    autre appelant de FlowGrid dans le fichier n'est touché par cette
    classe séparée."""

    def __init__(self, colonne_largeur: int = 420, spacing: int = 18, parent=None):
        super().__init__(parent)
        self._colonne_largeur = colonne_largeur
        self._spacing = spacing
        self._items: list = []  # list[QWidget], même nom d'attribut que FlowGrid (cf. docstring)
        self._hauteur_calculee = 2 * spacing

    def clear(self):
        for item in self._items:
            item.setParent(None)
            item.deleteLater()
        self._items = []
        self._hauteur_calculee = 2 * self._spacing
        self.setMinimumHeight(self._hauteur_calculee)

    def add_item(self, widget: QWidget):
        widget.setParent(self)
        widget.show()
        self._items.append(widget)
        self._relayout()

    def _largeur_reference(self) -> int:
        # MÊME logique que FlowGrid._largeur_reference (cf. sa docstring
        # complète pour la justification du viewport de QScrollArea
        # ancêtre plutôt que self.width()) -- dupliquée ici plutôt que
        # partagée par héritage : les deux classes n'ont plus d'autre
        # code en commun (packing radicalement différent), une base
        # commune n'apporterait que de la complexité de lecture pour
        # deux lignes identiques.
        widget = self.parentWidget()
        while widget is not None:
            if isinstance(widget, QScrollArea):
                return widget.viewport().width()
            widget = widget.parentWidget()
        return self.width()

    def _colonnes_possibles(self) -> int:
        largeur_ref = self._largeur_reference()
        largeur_dispo = max(largeur_ref - 2 * self._spacing, self._colonne_largeur)
        colonnes = max(1, (largeur_dispo + self._spacing) // (self._colonne_largeur + self._spacing))
        return int(colonnes)

    def _relayout(self):
        colonnes = self._colonnes_possibles()
        hauteurs_colonnes = [self._spacing] * colonnes

        for item in self._items:
            # Chaque tuile connaît sa propre hauteur idéale pour la
            # largeur de colonne fixe (cf. ComposantLayoutTuile.
            # hauteur_pour_largeur, dérivée du ratio réel de son image)
            # -- c'est cette hauteur VARIABLE par item, pas une hauteur
            # de ligne uniforme, qui produit l'effet masonry recherché.
            if hasattr(item, "hauteur_pour_largeur"):
                hauteur_item = item.hauteur_pour_largeur(self._colonne_largeur)
            else:
                hauteur_item = item.sizeHint().height() or item.height() or 100

            colonne_cible = hauteurs_colonnes.index(min(hauteurs_colonnes))
            x = self._spacing + colonne_cible * (self._colonne_largeur + self._spacing)
            y = hauteurs_colonnes[colonne_cible]

            item.setGeometry(int(x), int(y), self._colonne_largeur, int(hauteur_item))
            hauteurs_colonnes[colonne_cible] = y + hauteur_item + self._spacing

        self._hauteur_calculee = max(hauteurs_colonnes) if self._items else 2 * self._spacing
        self.setMinimumHeight(int(self._hauteur_calculee))
        self.updateGeometry()

    def sizeHint(self):
        return QSize(self.width(), int(self._hauteur_calculee))

    def heightForWidth(self, width: int) -> int:
        # Utilisé par certains parents Qt pour anticiper la hauteur sans
        # attendre un resizeEvent complet -- approximation raisonnable
        # (recalcul complet différé au prochain _relayout réel), même
        # rôle que FlowGrid.heightForWidth.
        return int(self._hauteur_calculee)

    def hasHeightForWidth(self) -> bool:
        return True

    def resizeEvent(self, event):
        super().resizeEvent(event)
        self._relayout()

    def showEvent(self, event):
        super().showEvent(event)
        # MÊME mécanisme que FlowGrid.showEvent (cf. sa docstring) --
        # le viewport du QScrollArea ancêtre est la vraie source de
        # largeur disponible, ses redimensionnements ne se propagent pas
        # toujours de façon synchrone via resizeEvent de ce widget seul.
        widget = self.parentWidget()
        while widget is not None:
            if isinstance(widget, QScrollArea):
                widget.viewport().installEventFilter(self)
                break
            widget = widget.parentWidget()

    def eventFilter(self, watched, event):
        if event.type() == QEvent.Resize:
            self._relayout()
        return super().eventFilter(watched, event)


class GroupesNavPanel(QFrame):
    """PATCH (navigation rapide entre groupes) : panneau latéral fixe, à
    gauche de la grille de vignettes de l'onglet Composants, listant les
    groupes du ServiceAPI actif ("Général" toujours en premier, puis les
    groupes dans l'ordre de ServiceAPI.groupes -- même ordre que les
    GroupeSection affichées, cf. ComposantsScreen._charger_grille_composants).

    Un clic sur une entrée émet groupe_choisi(nom_groupe) ; c'est
    ComposantsScreen (qui connaît grid_scroll et _sections_groupe) qui se
    charge d'effectuer le défilement animé -- ce panneau reste une pure
    liste de navigation, sans dépendance vers le contenu qu'il pilote."""

    groupe_choisi = Signal(str)  # nom du groupe cible ("" pour Général)

    LARGEUR = 190

    def __init__(self, parent=None):
        super().__init__(parent)
        self.setObjectName("GroupesNavPanel")
        self.setFixedWidth(self.LARGEUR)
        self._boutons: dict = {}  # nom_groupe -> QToolButton

        outer_layout = QVBoxLayout(self)
        outer_layout.setContentsMargins(0, 0, 0, 0)
        outer_layout.setSpacing(0)

        titre = QLabel("GROUPES", self)
        titre.setObjectName("GroupesNavPanelTitre")
        titre_wrap = QHBoxLayout()
        titre_wrap.setContentsMargins(16, 16, 16, 8)
        titre_wrap.addWidget(titre)
        outer_layout.addLayout(titre_wrap)

        scroll_area = QScrollArea(self)
        scroll_area.setObjectName("GroupesNavPanelScroll")
        scroll_area.setWidgetResizable(True)
        scroll_area.setFrameShape(QFrame.NoFrame)
        scroll_area.setHorizontalScrollBarPolicy(Qt.ScrollBarAlwaysOff)
        scroll_area.setVerticalScrollBarPolicy(Qt.ScrollBarAlwaysOff)
        outer_layout.addWidget(scroll_area, 1)

        content = QWidget(scroll_area)
        content.setObjectName("GroupesNavPanelContent")
        scroll_area.setWidget(content)

        self._boutons_layout = QVBoxLayout(content)
        self._boutons_layout.setContentsMargins(8, 0, 8, 12)
        self._boutons_layout.setSpacing(2)
        self._boutons_layout.setAlignment(Qt.AlignTop)

    def definir_groupes(self, groupes: list):
        """Reconstruit la liste des boutons. `groupes` : liste de tuples
        (nom_groupe, libelle_affiche), Général ("", "Général") en premier
        -- laissé au choix de l'appelant, qui connaît déjà cet ordre
        (cf. ComposantsScreen._charger_grille_composants)."""
        for bouton in self._boutons.values():
            self._boutons_layout.removeWidget(bouton)
            bouton.setParent(None)
            bouton.deleteLater()
        self._boutons = {}

        for nom_groupe, libelle in groupes:
            bouton = QToolButton(self)
            bouton.setObjectName("GroupesNavPanelBouton")
            bouton.setText(libelle)
            bouton.setToolButtonStyle(Qt.ToolButtonTextBesideIcon)
            bouton.setCursor(Qt.PointingHandCursor)
            icone = "mdi6.folder-outline" if nom_groupe else "mdi6.view-grid-outline"
            bouton.setIcon(qta.icon(icone, color=Mocha.subtext0))
            bouton.setIconSize(QSize(16, 16))
            bouton.setSizePolicy(QSizePolicy.Expanding, QSizePolicy.Fixed)
            bouton.clicked.connect(lambda checked=False, n=nom_groupe: self.groupe_choisi.emit(n))
            self._boutons_layout.addWidget(bouton)
            self._boutons[nom_groupe] = bouton

        self.setVisible(bool(self._boutons))


class GroupeSection(QFrame):
    """PATCH (groupes de composants, drag & drop) : une section empilée
    verticalement dans la grille de l'onglet Composants, une par groupe --
    en-tête (nom du groupe + bouton menu ⋮ pour renommer/supprimer) suivi
    d'une FlowGrid des vignettes du groupe. "Général" (nom_groupe == "") est
    une instance de cette MÊME classe mais sans menu ⋮ (cf. est_general) :
    section spéciale toujours présente, jamais renommable ni supprimable,
    qui sert aussi de cible de drop pour désassigner un composant (le
    ramener à groupe = "").

    Accepte les drops de ComposantTuile (cf. ComposantTuile.MIME_TYPE) sur
    TOUTE sa surface (en-tête compris) -- pas seulement sur la FlowGrid
    interne -- pour que déposer sur une section vide (pas encore de
    vignette dedans) fonctionne aussi bien que sur une section pleine."""

    demande_deplacement_composant = Signal(str, str)  # (nom_complet_composant, nom_groupe_cible)
    demande_renommer_groupe = Signal(str)  # nom_groupe actuel
    demande_supprimer_groupe = Signal(str)  # nom_groupe actuel

    def __init__(self, nom_groupe: str, est_general: bool, parent=None):
        super().__init__(parent)
        self.nom_groupe = nom_groupe  # "" pour Général
        self.est_general = est_general
        self.setObjectName("GroupeSection")
        self.setAcceptDrops(True)

        layout = QVBoxLayout(self)
        layout.setContentsMargins(0, 0, 0, 0)
        layout.setSpacing(4)

        header = QFrame(self)
        header.setObjectName("GroupeSectionHeader")
        header_layout = QHBoxLayout(header)
        header_layout.setContentsMargins(14, 8, 8, 8)
        header_layout.setSpacing(8)

        titre_affiche = "Général" if est_general else nom_groupe
        self.titre_label = QLabel(titre_affiche, header)
        self.titre_label.setObjectName("GroupeSectionTitre")
        header_layout.addWidget(self.titre_label)
        header_layout.addStretch(1)

        self.menu_button: Optional[QToolButton] = None
        if not est_general:
            self.menu_button = QToolButton(header)
            self.menu_button.setObjectName("GroupeSectionMenuButton")
            self.menu_button.setIcon(qta.icon("mdi6.dots-vertical", color=Mocha.subtext0))
            self.menu_button.setIconSize(QSize(18, 18))
            self.menu_button.setFixedSize(28, 28)
            self.menu_button.setCursor(Qt.PointingHandCursor)
            self.menu_button.setToolTip("Renommer ou supprimer ce groupe")
            self.menu_button.clicked.connect(self._afficher_menu_groupe)
            header_layout.addWidget(self.menu_button)

        layout.addWidget(header)

        # REFONTE (demande explicite utilisateur : "applique MasonryGrid
        # aussi au niveau de ComposantSingle, mais sans modifier le
        # design des tuiles, juste l'organisation") -- MasonryGrid (cf.
        # sa docstring complète) remplace FlowGrid ICI. ComposantTuile a
        # une largeur ET une hauteur FIXES (setFixedWidth(160), image_
        # frame 140x100 -- design INCHANGÉ, cf. demande explicite), donc
        # à la différence de ComposantLayoutTuile toutes les tuiles ont
        # rigoureusement la même hauteur : le packing masonry ne produit
        # ici aucune différence visuelle de hauteur de ligne par rapport
        # à FlowGrid (toutes les colonnes montent au même rythme), mais
        # organise désormais les tuiles par "colonne la plus courte"
        # plutôt que par grille ligne/colonne rigide -- cohérent avec le
        # remplacement déjà fait pour ComposantsLayoutScreen. colonne_
        # largeur = 160, EXACTEMENT ComposantTuile.setFixedWidth ci-
        # dessus (cf. son __init__), pour ne rien changer à la taille ni
        # à l'espacement visuel des tuiles.
        self.flow_grid = MasonryGrid(colonne_largeur=160, spacing=14)
        layout.addWidget(self.flow_grid)

    def _afficher_menu_groupe(self):
        menu = QMenu(self)
        action_renommer = menu.addAction(qta.icon("mdi6.pencil-outline", color=Mocha.text), "Renommer le groupe")
        action_supprimer = menu.addAction(qta.icon("mdi6.trash-can-outline", color=Mocha.red), "Supprimer le groupe")
        choix = menu.exec(self.menu_button.mapToGlobal(self.menu_button.rect().bottomRight()))
        if choix == action_renommer:
            self.demande_renommer_groupe.emit(self.nom_groupe)
        elif choix == action_supprimer:
            self.demande_supprimer_groupe.emit(self.nom_groupe)

    def dragEnterEvent(self, event):
        if event.mimeData().hasFormat(ComposantTuile.MIME_TYPE):
            event.acceptProposedAction()
            # Grise la zone qui accepte réellement le drag, pour voir à
            # l'oeil nu la frontière exacte de la cible de drop.
            self.setStyleSheet("QFrame#GroupeSection { background-color: rgba(160,160,160,120); }")
        else:
            event.ignore()

    def dragMoveEvent(self, event):
        if event.mimeData().hasFormat(ComposantTuile.MIME_TYPE):
            event.acceptProposedAction()
        else:
            event.ignore()

    def dragLeaveEvent(self, event):
        self.setStyleSheet("")  # retire le gris en sortant de la zone
        super().dragLeaveEvent(event)

    def dropEvent(self, event):
        self.setStyleSheet("")  # retire le gris une fois le drop traité
        mime = event.mimeData()
        if not mime.hasFormat(ComposantTuile.MIME_TYPE):
            event.ignore()
            return
        composant_nom = bytes(mime.data(ComposantTuile.MIME_TYPE)).decode("utf-8")
        self.demande_deplacement_composant.emit(composant_nom, self.nom_groupe)
        event.acceptProposedAction()


class DialogueZoomImage(QWidget):
    """Fenêtre de zoom légère (double-clic sur l'image d'un Composant, cf.
    ComposantTuile.mouseDoubleClickEvent) : affiche l'image ORIGINALE du
    composant (pas la version réduite 140x100 de la vignette) agrandie,
    sans déformation, centrée sur l'écran. Pure surface d'affichage --
    aucune interaction de tracé/zone de clic ici (cf. ApercuTraceableLabel
    pour ça) : Échap ou un clic quelconque referme simplement la fenêtre.

    QWidget top-level plutôt que QDialog : ce projet n'utilise aucun QDialog
    modal ailleurs (cf. le panneau latéral coulissant de
    ComposantReglagesPanel) -- on reste cohérent avec ce parti pris non-modal
    en popup fenêtre indépendante, fermable sans bloquer le reste de l'UI."""

    TAILLE_MAX = 900  # plafond en pixels (largeur ET hauteur) pour rester lisible sur un petit écran

    def __init__(self, image_absolue: Path, titre: str, parent=None):
        # Qt.FramelessWindowHint en plus de Qt.Window : retire la barre de
        # titre native (et donc son bouton de fermeture "x") -- demande
        # explicite utilisateur. La fenêtre reste top-level (Qt.Window) et
        # se ferme toujours au clic ou à Échap (cf. mousePressEvent /
        # keyPressEvent plus bas), donc aucune perte de fonctionnalité.
        super().__init__(parent, Qt.Window | Qt.FramelessWindowHint)
        self.setWindowTitle(titre)
        self.setObjectName("DialogueZoomImage")
        self.setStyleSheet(f"#DialogueZoomImage {{ background-color: {Mocha.crust}; }}")
        self.setCursor(Qt.PointingHandCursor)

        layout = QVBoxLayout(self)
        layout.setContentsMargins(16, 16, 16, 16)

        self.image_label = QLabel(self)
        self.image_label.setAlignment(Qt.AlignCenter)
        layout.addWidget(self.image_label)

        pixmap = QPixmap()
        if image_absolue.exists():
            pixmap = QPixmap(str(image_absolue))

        if pixmap.isNull():
            self.image_label.setText("Image indisponible")
            self.image_label.setStyleSheet(f"color: {Mocha.subtext0}; padding: 40px;")
            self.resize(320, 160)
        else:
            # Zoom réel : on part de l'image d'origine (pas d'un pixmap déjà
            # réduit par un appelant), mise à l'échelle une seule fois vers
            # le plafond TAILLE_MAX -- jamais agrandie au-delà de sa taille
            # native pour ne pas produire un rendu flou/pixelisé (comparer:
            # le sourceSize à afficher est toujours <= la taille d'origine
            # OU <= TAILLE_MAX, selon ce qui est le plus petit).
            cible = min(self.TAILLE_MAX, max(pixmap.width(), pixmap.height()))
            pixmap_affiche = pixmap.scaled(
                cible, cible, Qt.KeepAspectRatio, Qt.SmoothTransformation,
            )
            self.image_label.setPixmap(pixmap_affiche)
            self.resize(
                pixmap_affiche.width() + 32,
                pixmap_affiche.height() + 32,
            )

        self._centrer_sur_ecran()

    def _centrer_sur_ecran(self):
        ecran = QGuiApplication.primaryScreen()
        if ecran is None:
            return
        geo = ecran.availableGeometry()
        self.move(
            geo.x() + (geo.width() - self.width()) // 2,
            geo.y() + (geo.height() - self.height()) // 2,
        )

    def mousePressEvent(self, event):
        # Referme au premier clic, où qu'il tombe dans la fenêtre -- geste
        # naturel pour une popup de zoom "juste pour regarder" (cf. docstring).
        self.close()
        super().mousePressEvent(event)

    def keyPressEvent(self, event):
        if event.key() == Qt.Key_Escape:
            self.close()
            return
        super().keyPressEvent(event)


class ComposantTuile(QFrame):
    """Vignette d'un Composant dans la grille de l'onglet Composants (point 18 :
    grille de vignettes, clic -> panneau latéral coulissant). Affiche l'image,
    le nom, et un badge si le composant vient d'être créé et attend d'être
    nommé/configuré.

    PATCH (groupes de composants, drag & drop) : draggable vers une
    GroupeSection pour (ré)assigner composant.groupe -- même pattern de seuil
    anti-clic-accidentel que NotebookDragHandle (mousePressEvent mémorise la
    position, mouseMoveEvent déclenche le QDrag une fois
    QApplication.startDragDistance() dépassé), mais ICI le clic simple garde
    son rôle existant (sélection -> panneau de réglages, cf. self.clique) :
    le drag ne se déclenche qu'au-delà du seuil, donc jamais sur un simple
    clic. Le QMimeData transporte le nom complet du composant sous un type
    MIME custom (application/x-autoniax-composant) plutôt qu'un chemin de
    fichier (cf. NotebookDragHandle) : ce drag reste INTERNE à l'app, aucun
    intérêt à écrire un fichier temporaire sur disque pour ça."""

    MIME_TYPE = "application/x-autoniax-composant"

    clique = Signal(str)  # émet le nom complet du composant
    # PATCH (sélection multiple, demande explicite utilisateur : "modifie
    # linterface des cmposant de tels sote que on puise selectionner
    # plusierr a la fois et suprimer dun coup") -- second signal, émis EN
    # PLUS de `clique` ci-dessus (jamais à la place) à chaque clic gauche,
    # transportant les modificateurs clavier actifs (Qt.KeyboardModifiers)
    # au moment du clic. ComposantsScreen s'en sert pour distinguer un clic
    # simple (comportement existant inchangé -- ouvre le panneau de
    # réglages) d'un Ctrl+clic/Shift+clic (multi-sélection façon explorateur
    # de fichiers) -- cf. ComposantsScreen._on_tuile_cliquee_avec_modifiers.
    # Cette tuile elle-même ne sait PAS ce que "sélection multiple" veut
    # dire (aucun état interne ajouté ici pour ça) : c'est ComposantsScreen
    # qui décide et rappelle set_selectionnee_multi en retour.
    clique_avec_modifiers = Signal(str, object)  # (nom complet, Qt.KeyboardModifiers)

    def __init__(self, composant: Composant, image_absolue: Path, parent=None):
        super().__init__(parent)
        self.composant_nom = composant.nom
        # Mémorisés pour le double-clic (zoom, cf. mouseDoubleClickEvent) --
        # rafraichir() les remet à jour si l'image change (ex: "Mettre à jour
        # l'image") ou si la tuile est réutilisée pour un autre composant.
        self._image_absolue = image_absolue
        self._nom_affiche = self._nom_court(composant.nom, composant.service_api_nom)
        self._fenetre_zoom: Optional[DialogueZoomImage] = None  # référence forte, sinon GC immédiat (top-level QWidget)
        self.setObjectName("ComposantTuile")
        self.setProperty("selectionnee", "false")
        # PATCH (sélection multiple) -- propriété CSS DISTINCTE de
        # "selectionnee" ci-dessus (qui reste la sélection simple -> panneau
        # de réglages, bordure mauve inchangée) : une tuile peut être
        # multi-sélectionnée (bordure rouge, cf. set_selectionnee_multi)
        # indépendamment d'être la tuile actuellement ouverte dans le
        # panneau de réglages -- les deux états ne s'excluent pas visuellement
        # dans le CSS (deux propriétés Qt distinctes), même si en pratique
        # ComposantsScreen ferme le panneau dès qu'une multi-sélection démarre
        # (cf. sa docstring de section).
        self.setProperty("selectionnee_multi", "false")
        self.setFixedWidth(160)
        self.setCursor(Qt.PointingHandCursor)

        layout = QVBoxLayout(self)
        layout.setContentsMargins(10, 10, 10, 10)
        layout.setSpacing(8)

        image_frame = QFrame(self)
        image_frame.setObjectName("ComposantTuileImageFrame")
        image_frame.setFixedSize(140, 100)
        image_layout = QVBoxLayout(image_frame)
        image_layout.setContentsMargins(0, 0, 0, 0)

        self.image_label = QLabel(image_frame)
        self.image_label.setAlignment(Qt.AlignCenter)
        if image_absolue.exists():
            pixmap = QPixmap(str(image_absolue))
            if not pixmap.isNull():
                pixmap = pixmap.scaled(140, 100, Qt.KeepAspectRatio, Qt.SmoothTransformation)
                self.image_label.setPixmap(pixmap)
        image_layout.addWidget(self.image_label)
        layout.addWidget(image_frame, alignment=Qt.AlignCenter)

        self.nom_label = QLabel(self._nom_court(composant.nom, composant.service_api_nom), self)
        self.nom_label.setObjectName("ComposantTuileNom")
        self.nom_label.setAlignment(Qt.AlignCenter)
        self.nom_label.setWordWrap(True)
        layout.addWidget(self.nom_label)

    @staticmethod
    def _nom_court(nom_complet: str, service_api_nom: str) -> str:
        prefixe = f"{service_api_nom}-"
        return nom_complet[len(prefixe):] if nom_complet.startswith(prefixe) else nom_complet

    def set_selectionnee(self, selectionnee: bool):
        self.setProperty("selectionnee", "true" if selectionnee else "false")
        self.style().unpolish(self)
        self.style().polish(self)

    def set_selectionnee_multi(self, selectionnee: bool):
        """PATCH (sélection multiple) -- pendant de set_selectionnee ci-
        dessus pour la propriété CSS "selectionnee_multi" (bordure rouge,
        cf. feuille de style). Purement visuel, ne touche à aucun état
        interne de la tuile -- ComposantsScreen reste seule responsable de
        savoir QUELLES tuiles sont dans self._selection_multi."""
        self.setProperty("selectionnee_multi", "true" if selectionnee else "false")
        self.style().unpolish(self)
        self.style().polish(self)

    def rafraichir(self, composant: Composant, image_absolue: Path):
        self._image_absolue = image_absolue
        self._nom_affiche = self._nom_court(composant.nom, composant.service_api_nom)
        self.nom_label.setText(self._nom_affiche)
        if image_absolue.exists():
            pixmap = QPixmap(str(image_absolue))
            if not pixmap.isNull():
                pixmap = pixmap.scaled(140, 100, Qt.KeepAspectRatio, Qt.SmoothTransformation)
                self.image_label.setPixmap(pixmap)

    def mousePressEvent(self, event):
        if event.button() == Qt.LeftButton:
            self._pos_depart = event.pos()
            self.clique.emit(self.composant_nom)
            # PATCH (sélection multiple) -- émis EN PLUS de clique
            # ci-dessus, jamais à la place (cf. docstring du signal) :
            # ComposantsScreen ignore ce second signal quand aucun
            # modificateur n'est actif (le clic simple ci-dessus a déjà
            # tout géré via _on_tuile_cliquee).
            self.clique_avec_modifiers.emit(self.composant_nom, event.modifiers())
        super().mousePressEvent(event)

    def mouseMoveEvent(self, event):
        if not (event.buttons() & Qt.LeftButton) or not hasattr(self, "_pos_depart"):
            return super().mouseMoveEvent(event)
        if (event.pos() - self._pos_depart).manhattanLength() < QApplication.startDragDistance():
            return super().mouseMoveEvent(event)

        mime = QMimeData()
        mime.setData(self.MIME_TYPE, self.composant_nom.encode("utf-8"))

        # PATCH (demande explicite utilisateur : "je veux faire une copie
        # de l'image du composant en faisant le drop, donc je le glisse
        # vers une interface externe") -- en plus du MIME interne
        # ci-dessus (qui reste inchangé, cf. GroupeSection.dropEvent),
        # on ajoute une URL de fichier local (mime.setUrls) : c'est CE
        # type MIME standard (text/uri-list) que l'Explorateur Windows,
        # un client mail, etc. savent lire pour un drop de fichier --
        # le MIME custom application/x-autoniax-composant seul n'a
        # aucun sens hors d'AutoniaX, d'où l'absence de drop possible
        # avant ce patch.
        #
        # Fichier COPIÉ (pas glissé directement depuis son emplacement
        # d'origine) dans un dossier temporaire dédié, sous le NOM DU
        # COMPOSANT (demande explicite utilisateur : "rassure toi de le
        # nommer avec le nom du composant") plutôt que le nom de fichier
        # d'origine sur disque (souvent un hash/UUID, cf. get_composants_
        # images_dir) -- extension d'origine préservée (.png/.jpg/...)
        # via image_absolue.suffix. Même pattern que NotebookDragHandle.
        # mouseMoveEvent (fichier généré à la volée dans un dossier
        # temporaire dédié, jamais dans Téléchargements) : un drag
        # annulé ou déposé dans une appli qui ne fait que lire le
        # fichier ne doit pas polluer les Téléchargements de
        # l'utilisateur à chaque tentative.
        if self._image_absolue.exists():
            nom_suggere = re.sub(r'[<>:"/\\|?*]', "_", self.composant_nom).strip() or "composant"
            dossier_tmp = Path(tempfile.gettempdir()) / "AutoniaX_drag"
            try:
                dossier_tmp.mkdir(parents=True, exist_ok=True)
                chemin = dossier_tmp / f"{nom_suggere}{self._image_absolue.suffix}"
                shutil.copyfile(self._image_absolue, chemin)
                mime.setUrls([QUrl.fromLocalFile(str(chemin))])
            except OSError:
                pass  # drop externe silencieusement indisponible -- le drag interne (MIME custom ci-dessus) reste, lui, fonctionnel

        drag = QDrag(self)
        drag.setMimeData(mime)
        apercu = self.grab().scaled(80, 60, Qt.KeepAspectRatio, Qt.SmoothTransformation)
        drag.setPixmap(apercu)
        drag.setHotSpot(QPoint(apercu.width() // 2, apercu.height() // 2))
        # DÉSACTIVÉ (retour explicite utilisateur : "désactive le fait que
        # l'interface doit se réduire, ça a disparu quand j'ai essayé de
        # faire un drag") -- l'ancien fenetre.hide()/show() ci-dessous (qui
        # masquait la fenêtre principale AutoniaX pendant le drag pour
        # dégager la vue vers l'application cible) est retiré : le drag
        # s'exécute maintenant SANS cacher la fenêtre. Le MIME interne
        # (GroupeSection.dropEvent) et le MIME externe (text/uri-list,
        # ci-dessus) restent inchangés -- seul l'effet de masquage de la
        # fenêtre pendant drag.exec() est désactivé.
        drag.exec(Qt.CopyAction | Qt.MoveAction)

    def mouseDoubleClickEvent(self, event):
        # Double-clic sur la vignette (image ou nom, toute la surface de la
        # tuile -- "zone de clic" personnalisée au sens UI du terme, pas au
        # sens Composant.zone_clic_rect du modèle) -> zoom de l'image
        # d'origine dans une fenêtre séparée (cf. DialogueZoomImage). Ne
        # PAS appeler super().mouseDoubleClickEvent(event) après le premier
        # mousePressEvent déjà émis par le clic précédent : le double-clic
        # Qt émet de toute façon mousePress puis mouseDoubleClick, donc
        # self.clique a déjà été émis une fois par le premier clic -- normal
        # et sans effet de bord (sélectionne la tuile avant l'ouverture du
        # zoom, comme un simple clic l'aurait fait).
        if event.button() == Qt.LeftButton:
            self._fenetre_zoom = DialogueZoomImage(self._image_absolue, self._nom_affiche, self)
            self._fenetre_zoom.show()
        super().mouseDoubleClickEvent(event)


class VarianteVignette(QFrame):
    """Petite miniature d'une variante d'image dans la galerie du panneau de
    réglages (voir ComposantReglagesPanel). Affiche l'image en 60x60 avec un
    petit bouton "x" en coin pour la retirer. Cliquer sur la vignette
    (en dehors du bouton "x") sélectionne cette variante pour l'affichage
    dans l'aperçu principal du panneau — effet purement visuel, ne change
    rien au modèle ni à quelle variante est "principale" pour les autres
    usages (vignette de grille, template de test rapide en secours)."""

    demande_suppression = Signal(str)  # chemin relatif de la variante
    clique = Signal(str)  # chemin relatif de la variante

    def __init__(self, variant_path: str, image_absolue: Path, parent=None):
        super().__init__(parent)
        self.variant_path = variant_path
        self.setObjectName("VarianteVignette")
        self.setProperty("selectionnee", "false")
        self.setFixedSize(60, 60)
        self.setCursor(Qt.PointingHandCursor)
        self._suppression_autorisee = True  # règle métier (voir set_suppression_visible)
        self._survolee = False

        layout = QVBoxLayout(self)
        layout.setContentsMargins(0, 0, 0, 0)

        self.image_label = QLabel(self)
        self.image_label.setAlignment(Qt.AlignCenter)
        if image_absolue.exists():
            pixmap = QPixmap(str(image_absolue))
            if not pixmap.isNull():
                pixmap = pixmap.scaled(60, 60, Qt.KeepAspectRatio, Qt.SmoothTransformation)
                self.image_label.setPixmap(pixmap)
        layout.addWidget(self.image_label)

        self.suppr_button = QToolButton(self)
        self.suppr_button.setObjectName("VarianteSupprButton")
        self.suppr_button.setIcon(qta.icon("mdi6.close", color=Mocha.crust))
        self.suppr_button.setIconSize(QSize(10, 10))
        self.suppr_button.setFixedSize(16, 16)
        self.suppr_button.setCursor(Qt.PointingHandCursor)
        self.suppr_button.setToolTip("Retirer cette variante")
        self.suppr_button.clicked.connect(self._on_suppr_clicked)
        self.suppr_button.move(42, 2)
        self.suppr_button.raise_()
        self.suppr_button.setVisible(False)  # caché tant que la souris n'a pas survolé

    def _on_suppr_clicked(self):
        # Empêche le clic sur le bouton "x" de aussi déclencher la
        # sélection de la vignette (mousePressEvent du QFrame parent) :
        # le bouton consomme l'événement, mais on coupe court explicitement
        # pour ne pas dépendre du seul ordre de propagation Qt.
        self.demande_suppression.emit(self.variant_path)

    def set_suppression_visible(self, visible: bool):
        """Règle métier (pas le hover) : autorise ou non le retrait de
        cette variante (ex. dernière variante restante = non autorisé).
        L'affichage réel du bouton reste conditionné au survol (voir
        enterEvent/leaveEvent) — ce booléen n'agit qu'en combinaison."""
        self._suppression_autorisee = visible
        self.suppr_button.setVisible(visible and self._survolee)

    def set_selectionnee(self, selectionnee: bool):
        self.setProperty("selectionnee", "true" if selectionnee else "false")
        self.style().unpolish(self)
        self.style().polish(self)

    def enterEvent(self, event):
        self._survolee = True
        self.suppr_button.setVisible(self._suppression_autorisee)
        super().enterEvent(event)

    def leaveEvent(self, event):
        self._survolee = False
        self.suppr_button.setVisible(False)
        super().leaveEvent(event)

    def mousePressEvent(self, event):
        if event.button() == Qt.LeftButton:
            self.clique.emit(self.variant_path)
        super().mousePressEvent(event)


class PlainTextEditAvecEditingFinished(QPlainTextEdit):
    """QPlainTextEdit doté d'un signal editingFinished (perte de focus),
    pour rester cohérent avec les autres champs du panneau de réglages
    (QLineEdit.editingFinished) : la sauvegarde se déclenche à la perte de
    focus, pas à chaque caractère tapé (évite une I/O disque par frappe,
    cf. point 17 de la spec — zéro surcharge inutile)."""

    editingFinished = Signal()

    def focusOutEvent(self, event):
        super().focusOutEvent(event)
        self.editingFinished.emit()


class ComposantReglagesPanel(QWidget):
    """Panneau latéral coulissant (non-modal, point 18) affichant les réglages
    d'un Composant sélectionné dans la grille : nom (édition inline), priorité
    de sélection, seuil de confiance, bouton Update (re-capture) et bouton
    supprimer. Le composant est déjà créé dans le modèle au moment où ce
    panneau s'affiche — il n'y a plus d'étape de nommage séparée : l'utilisateur
    remplit ses champs directement ici."""

    demande_update_image = Signal(str)  # nom complet du composant
    demande_suppression = Signal(str)
    demande_fermeture = Signal()
    nom_modifie = Signal(str, str)  # (ancien_nom_complet, nouveau_nom_complet)
    demande_definir_zone_clic = Signal(str)  # nom complet du composant
    demande_tester_composant = Signal(str)  # nom complet du composant
    demande_ajouter_variante = Signal(str)  # nom complet du composant
    demande_supprimer_variante = Signal(str, str)  # (nom complet du composant, chemin relatif de la variante)

    LABELS_PRIORITE = {
        "mostTop": "Plus haut (mostTop)",
        "mostBottom": "Plus bas (mostBottom)",
        "mostLeft": "Plus à gauche (mostLeft)",
        "mostRight": "Plus à droite (mostRight)",
    }

    LABELS_CATEGORIE = {
        "normal": "Normal",
        "intrusif": "Intrusif",
    }

    # AJOUT (cf. commentaire module-level juste avant la constante globale
    # LABELS_ZONE_CLIC, définie près de MODES_ZONE_CLIC) : attribut de
    # classe conservé pour ne rien casser du code existant qui référait le
    # dict via self.LABELS_ZONE_CLIC (cf. addItem(self.LABELS_ZONE_CLIC[
    # ...]) plus bas) -- pointe vers la même instance de dict que la
    # constante globale (désormais aussi utilisée telle quelle, sans
    # self., par ComposantLayoutConfigScreen._construire_panneau_zone),
    # donc un seul dict à maintenir en cas de changement de libellé.
    LABELS_ZONE_CLIC = dict(LABELS_ZONE_CLIC)

    def __init__(self, parent=None):
        super().__init__(parent)
        self.setObjectName("ReglagesPanel")
        self.setFixedWidth(300)
        self._composant_nom: Optional[str] = None
        self._service_api_nom: Optional[str] = None
        self._composant_courant: Optional[Composant] = None
        self._image_absolue_courante: Optional[Path] = None
        self._variante_selectionnee: Optional[str] = None  # chemin relatif de la variante affichée en grand

        # Layout externe : titre fixe (toujours visible) + zone scrollable
        # en dessous pour tout le reste. Ça évite que le panneau se fasse
        # compresser/chevaucher quand la fenêtre est redimensionnée en
        # hauteur (les widgets défilent au lieu de se superposer).
        outer_layout = QVBoxLayout(self)
        outer_layout.setContentsMargins(0, 0, 0, 0)
        outer_layout.setSpacing(0)

        header_row = QHBoxLayout()
        header_row.setContentsMargins(18, 16, 18, 8)
        header_label = QLabel("RÉGLAGES DU COMPOSANT", self)
        header_label.setObjectName("ReglagesPanelTitle")
        header_row.addWidget(header_label)
        header_row.addStretch(1)
        close_button = QToolButton(self)
        close_button.setObjectName("ClosePanelButton")
        close_button.setIcon(qta.icon("mdi6.close", color=Mocha.subtext0))
        close_button.setCursor(Qt.PointingHandCursor)
        close_button.clicked.connect(self.demande_fermeture.emit)
        header_row.addWidget(close_button)
        outer_layout.addLayout(header_row)

        scroll_area = QScrollArea(self)
        scroll_area.setObjectName("ReglagesPanelScroll")
        scroll_area.setWidgetResizable(True)
        scroll_area.setFrameShape(QFrame.NoFrame)
        scroll_area.setHorizontalScrollBarPolicy(Qt.ScrollBarAlwaysOff)
        scroll_area.setVerticalScrollBarPolicy(Qt.ScrollBarAlwaysOff)
        outer_layout.addWidget(scroll_area, 1)

        content = QWidget(scroll_area)
        content.setObjectName("ReglagesPanelContent")
        scroll_area.setWidget(content)

        layout = QVBoxLayout(content)
        layout.setContentsMargins(18, 0, 18, 18)
        layout.setSpacing(14)

        apercu_frame = QFrame(content)
        apercu_frame.setObjectName("ComposantTuileImageFrame")
        apercu_frame.setFixedHeight(140)
        apercu_layout = QVBoxLayout(apercu_frame)
        apercu_layout.setContentsMargins(0, 0, 0, 0)
        self.apercu_label = QLabel(apercu_frame)
        self.apercu_label.setAlignment(Qt.AlignCenter)
        apercu_layout.addWidget(self.apercu_label)
        layout.addWidget(apercu_frame)

        # --- Variantes : plusieurs images possibles pour le même composant.
        # Une seule variante doit matcher à la reconnaissance pour que le
        # composant soit considéré comme détecté (voir Composant.variantes). ---
        variantes_header = QHBoxLayout()
        variantes_titre = QLabel("Variantes", content)
        variantes_titre.setObjectName("ReglagesLabel")
        variantes_header.addWidget(variantes_titre)
        variantes_header.addStretch(1)
        self.ajouter_variante_button = QToolButton(content)
        self.ajouter_variante_button.setObjectName("AddVarianteButton")
        self.ajouter_variante_button.setIcon(qta.icon("mdi6.plus", color=Mocha.subtext0))
        self.ajouter_variante_button.setIconSize(QSize(16, 16))
        self.ajouter_variante_button.setCursor(Qt.PointingHandCursor)
        self.ajouter_variante_button.setToolTip("Ajouter une variante (autre image pour ce composant)")
