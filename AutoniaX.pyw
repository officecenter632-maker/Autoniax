    cas de succès, cf. InstanceExecutable.new_tab :
        r = Instance.new_tab("https://exemple.com")
        if r:
            tab_id = r.tab_id

    AJOUT (click(copier_presse_papier=True), cf. ComposantExecutable.click) :
    texte_presse_papier, optionnel (None par défaut -- absent/non pertinent
    pour tout appel n'ayant pas demandé copier_presse_papier=True). Rempli
    UNIQUEMENT par click(copier_presse_papier=True) en cas de succès, avec
    le contenu du presse-papier VIRTUEL de l'instance (isolé, jamais le
    presse-papier Windows réel -- cf. docstring click) juste après le clic :
        r = bouton.click(copier_presse_papier=True)
        if r:
            texte = r.texte_presse_papier"""

    __slots__ = ("statut", "message", "tab_id", "texte_presse_papier")

    def __init__(self, statut: bool, message: Optional[str] = None, tab_id: Optional[str] = None,
                 texte_presse_papier: Optional[str] = None):
        self.statut = statut
        self.message = message
        self.tab_id = tab_id
        self.texte_presse_papier = texte_presse_papier

    def __bool__(self) -> bool:
        return self.statut

    def __repr__(self) -> str:
        if self.statut:
            if self.tab_id is not None:
                return f"ResultatAction(statut=True, tab_id={self.tab_id!r})"
            if self.texte_presse_papier is not None:
                return f"ResultatAction(statut=True, texte_presse_papier={self.texte_presse_papier!r})"
            return "ResultatAction(statut=True)"
        return f"ResultatAction(statut=False, message={self.message!r})"


# ---------------------------------------------------------------------------
# AJOUT (demande explicite utilisateur : détection de mouvement/animation
# ET OCR comme méthodes propres sur les objets qui ont une "surface" --
# ComposantSingleExecutable (rectangle connu via une détection) et
# ZoneDetectee (rectangle déjà connu, coords écran) -- ".detecter_mouvement
# (duree)" et ".lire_texte()" sur les deux classes, cf. discussion : "je
# crois que cest mieux de en faire une fois ocr une methode aussi car sa
# vas sappliquer sur une surface comme pour la detection danimations".
#
# Logique commune FACTORISÉE ICI (fonctions module-level privées, appelées
# en interne par les deux méthodes de chaque classe -- même schéma que le
# reste du fichier pour toute logique partagée entre ComposantSingleExecutable
# et ZoneDetectee, ex: charger_templates_bgr/rechercher_composant_multi_
# variantes déjà communes à plusieurs call sites) : chaque fonction prend
# le moteur/instance_id (pour l'appel réseau "capture_propre") et un
# rect_ecran (x, y, largeur, hauteur) déjà connu -- IDENTIQUE que
# l'appelant soit un Composant (rectangle recalculé à CHAQUE appel par
# _detecter_ou_lever, cf. ses méthodes) ou une Zone (rectangle FIGÉ au
# moment de sa détection, cf. docstring ZoneDetectee) : aucune des deux
# fonctions ci-dessous n'a besoin de le savoir, elle reçoit juste un
# rectangle prêt à l'emploi.
# ---------------------------------------------------------------------------

def _capturer_rect_ecran_bgr(moteur, instance_id: str, rect_ecran: tuple, timeout: Optional[float], libelle: str):
    """Capture_propre PLEINE PAGE puis recadrage sur rect_ecran (x, y,
    largeur, hauteur) -- factorisation du bloc déjà dupliqué entre
    ComposantSingleExecutable.screenshot()/ZoneDetectee.screenshot() avant
    ce patch (repris ici tel quel, chacune des deux méthodes de screenshot
    continue cependant d'écrire elle-même son PNG sur disque -- seule la
    partie "obtenir l'image BGR recadrée" est commune à screenshot(),
    detecter_mouvement() et lire_texte()). Lève RuntimeError si la capture
    échoue ou est invalide (même convention que le reste du fichier)."""
    params = {"timeout_action_s": timeout} if timeout is not None else {}
    reponse = moteur._appeler(instance_id, "capture_propre", params, timeout=timeout)
    if not reponse.get("ok"):
        raise RuntimeError(f"Échec de capture pour « {libelle} » : {reponse.get('error')}")
    image_b64 = reponse.get("result", {}).get("image_b64")
    image = decoder_image_b64(image_b64) if image_b64 else None
    if image is None:
        raise RuntimeError(f"Capture invalide reçue pour « {libelle} ».")
    image_bgr = qimage_vers_bgr(image)
    x, y, l, h = rect_ecran
    h_img, w_img = image_bgr.shape[:2]
    x0, y0 = max(0, min(x, w_img - 1)), max(0, min(y, h_img - 1))
    x1, y1 = max(x0 + 1, min(x + l, w_img)), max(y0 + 1, min(y + h, h_img))
    return image_bgr[y0:y1, x0:x1]


# Seuil de différence pixel-à-pixel (niveaux de gris, 0-255) en dessous
# duquel un pixel est considéré comme INCHANGÉ entre deux captures -- filtre
# le bruit de compression/capture (jamais deux captures consécutives
# n'affichent des pixels PARFAITEMENT identiques même sur une surface
# totalement statique, cf. bruit de compression JPEG/WebP déjà en jeu
# ailleurs dans ce fichier pour les captures streamées). Valeur modérée
# (pas 0, pas trop élevée) choisie pour ignorer ce bruit résiduel sans
# ignorer un vrai changement visuel.
SEUIL_DIFF_PIXEL_MOUVEMENT = 15
# Proportion de pixels devant dépasser SEUIL_DIFF_PIXEL_MOUVEMENT pour que
# la surface soit jugée "en mouvement" plutôt que "statique" -- évite
# qu'un unique pixel de bruit isolé (antialiasing, compression) déclenche
# un faux positif ; une VRAIE animation (vidéo, transition CSS, contenu
# défilant) modifie une portion significative de la surface, pas un pixel
# isolé.
PROPORTION_PIXELS_MOUVEMENT = 0.02


def _detecter_mouvement_sur_rect(moteur, instance_id: str, rect_ecran: tuple, duree: float,
                                  timeout: Optional[float], libelle: str) -> bool:
    """Détecte s'il y a variation visuelle sur rect_ecran pendant `duree`
    secondes : DEUX captures_propre espacées de `duree` (début et fin de
    la fenêtre d'observation -- pas un échantillonnage continu, une
    animation/vidéo en lecture modifie de toute façon l'image de façon
    quasi certaine entre deux instants espacés d'une fraction de seconde
    ou plus, donc deux points suffisent à trancher statique/en mouvement
    sans multiplier les appels réseau). Renvoie un booléen simple (True =
    mouvement détecté, False = statique) -- décision utilisateur explicite
    ("Un booléen simple").

    Comparaison en niveaux de gris (cv2.absdiff), pas sur les 3 canaux BGR
    séparément : suffisant pour détecter un changement visuel générique
    (couleur ET luminosité changent presque toujours ensemble sur un
    contenu vidéo/animé réel), et évite un faux positif lié à un artefact
    de compression sur un seul canal de couleur. Les deux captures sont
    recadrées identiquement sur rect_ecran AVANT comparaison -- si leurs
    dimensions diffèrent malgré tout (écran redimensionné entre les deux
    captures, cas limite), la plus grande est rognée à la taille de la
    plus petite plutôt que de lever une exception (une comparaison
    partielle reste plus utile qu'un crash pour cette fonction de
    diagnostic visuel)."""
    image_debut = _capturer_rect_ecran_bgr(moteur, instance_id, rect_ecran, timeout, libelle)
    if duree > 0:
        time.sleep(duree)
    image_fin = _capturer_rect_ecran_bgr(moteur, instance_id, rect_ecran, timeout, libelle)
    h = min(image_debut.shape[0], image_fin.shape[0])
    l = min(image_debut.shape[1], image_fin.shape[1])
    if h <= 0 or l <= 0:
        return False  # surface vide des deux côtés -- rien à comparer, considéré statique
    gris_debut = cv2.cvtColor(image_debut[:h, :l], cv2.COLOR_BGR2GRAY)
    gris_fin = cv2.cvtColor(image_fin[:h, :l], cv2.COLOR_BGR2GRAY)
    diff = cv2.absdiff(gris_debut, gris_fin)
    nb_pixels_changes = int(np.count_nonzero(diff > SEUIL_DIFF_PIXEL_MOUVEMENT))
    proportion = nb_pixels_changes / float(h * l)
    return proportion > PROPORTION_PIXELS_MOUVEMENT


def _lire_texte_sur_rect(moteur, instance_id: str, rect_ecran: tuple, timeout: Optional[float], libelle: str) -> str:
    """OCR sur rect_ecran : UNE capture_propre, recadrage, puis
    pytesseract.image_to_string. Renvoie le texte brut reconnu (str,
    éventuellement vide si aucun texte détecté) -- décision utilisateur
    explicite ("OCR : renvoie du texte brut (str)"). Lève RuntimeError si
    pytesseract (ou le binaire Tesseract sous-jacent) n'est pas
    disponible, avec un message explicite plutôt qu'un crash silencieux
    -- même convention défensive que VISION_DISPONIBLE pour cv2/numpy."""
    if not OCR_DISPONIBLE:
        raise RuntimeError(
            "OCR indisponible (pytesseract non installé, ou le binaire Tesseract "
            "sous-jacent est absent de la machine)."
        )
    image_bgr = _capturer_rect_ecran_bgr(moteur, instance_id, rect_ecran, timeout, libelle)
    if image_bgr.size == 0:
        return ""
    image_rgb = cv2.cvtColor(image_bgr, cv2.COLOR_BGR2RGB)
    try:
        texte = pytesseract.image_to_string(image_rgb)
    except Exception as e:
        raise RuntimeError(f"Échec de l'OCR sur « {libelle} » : {e!r}")
    return texte.strip()


class ComposantSingleExecutable:
    """RENOMMAGE (cf. docstring de ComposantSingle et SPEC_composantLayout.md
    section 2) : cette classe s'appelait `ComposantExecutable` -- un alias
    `ComposantExecutable = ComposantSingleExecutable` est posé juste après
    pour que le reste du fichier continue de fonctionner sans changement.

    Wrapper d'exécution autour d'un Composant du modèle, exposé à un
    script Task comme une variable portant son nom (cf. nom_variable_python).
    Une seule instance par Composant importé dans un Task, construite au
    moment de préparer l'espace de noms d'exécution du script (cf.
    TaskConfigScreen._executer_cellule).

    Ne PORTE aucune donnée de configuration propre (pas de bouton/durée par
    défaut mémorisés ici) : tous les réglages significatifs sont passés en
    argument à chaque appel de méthode, avec des valeurs par défaut
    raisonnables -- cohérent avec la décision explicite utilisateur que ces
    méthodes sont propres au Composant, indépendantes de toute Action déjà
    configurée dans Project.bibliotheque_actions.

    Branché sur l'exécution réelle via MoteurExecutionCellule (cf. plus
    loin dans ce fichier) : instance_id (résolu par TaskConfigScreen depuis
    Task.services_api_importes[composant.service_api_nom]) ET le moteur
    lui-même sont injectés à la construction -- chaque appel de méthode
    bloque LE THREAD D'EXÉCUTION DE LA CELLULE (jamais le thread Qt
    principal, cf. docstring de MoteurExecutionCellule) jusqu'à la
    réponse réseau."""

    def __init__(self, composant: Composant, instance_id: str, moteur: "MoteurExecutionCellule",
                 namespace: Optional[dict] = None, dossier_racine_images: Optional[Path] = None,
                 _contexte_reseau: Optional[dict] = None):
        self.composant = composant
        self.nom = composant.nom
        self.instance_id = instance_id
        self._moteur = moteur
        # AJOUT (demande explicite utilisateur : "je veux que le terminal
        # affiche aussi les images" -- Image.view()) -- {"client_t":
        # ClientServeurT, "session_id": str, "id_pilote": str} injecté
        # UNIQUEMENT côté sAutoniax exécutant en mode réseau (cf.
        # _construire_composants_direct), None partout ailleurs (mode
        # local -- seul appelant historique). Transmis tel quel à chaque
        # Image renvoyée par .screenshot() (cf. plus bas), même canal de
        # propagation que self._namespace ci-dessous."""
        self._contexte_reseau = _contexte_reseau
        # CORRECTIF (cf. docstring de charger_templates_bgr -- "le resultat
        # de test est toujours false") : racine à partir de laquelle
        # composant.variantes doit être résolu. None (défaut, mode local/
        # pilote -- seul appelant historique) -> comportement inchangé,
        # charger_templates_bgr retombe elle-même sur get_app_data_dir().
        # En mode réseau (sAutoniax), _construire_composants_direct passe
        # explicitement get_service_api_dir(), là où service_api.zip a
        # réellement été extrait.
        self._dossier_racine_images = dossier_racine_images
        # AJOUT (demande explicite utilisateur : "les variable seront deja
        # predefinit dans les cellules statique" -- RETRY/TIMEOUT/
        # LATENCE_AVANT/LATENCE_APRES) : référence vers le namespace
        # PARTAGÉ du Task (même dict passé à exec() pour TOUTES les
        # cellules, cf. TaskConfigScreen._namespace_task / MoteurHeadless.
        # _namespace) -- permet à chaque méthode de lire la valeur ACTUELLE
        # de ces variables au moment de l'appel (pas une valeur figée à la
        # construction), donc une modification faite par l'utilisateur
        # dans la cellule statique puis « Tout exécuter » à nouveau est
        # bien prise en compte. None accepté (usages hors notebook réel,
        # ex. tests) -- _global_defaut() retombe alors sur le défaut du
        # système.
        self._namespace = namespace

    def __repr__(self) -> str:
        return f"ComposantExecutable({self.nom!r})"

    # ------------------------------------------------------------------
    # AJOUT (demande explicite utilisateur : RETRY/TIMEOUT/LATENCE_AVANT/
    # LATENCE_APRES prédéfinies automatiquement dans la cellule statique
    # du notebook -- "les variable seront deja predefinit dans les
    # cellules statique" -- utilisées comme défaut par CHAQUE méthode de
    # ComposantExecutable SANS que l'utilisateur ait à les répéter à
    # chaque appel. "Si jamais je veux personnaliser, moi-même je vais
    # effacer l'affectation et mettre une valeur" -- donc une valeur
    # explicitement passée à la méthode (ex: click(retry=5)) prime
    # TOUJOURS sur la globale (cf. décision utilisateur explicite).
    #
    # Résolue à CHAQUE appel (pas mise en cache) : lit self._namespace,
    # le dict PARTAGÉ passé à exec() pour toutes les cellules du Task --
    # si la cellule statique n'a pas encore été exécutée, ou si son nom
    # a été supprimé/renommé par l'utilisateur, ou si self._namespace est
    # None (construction hors notebook), on retombe silencieusement sur
    # valeur_systeme (l'ancien défaut historique de chaque paramètre).
    # ------------------------------------------------------------------
    def _global_defaut(self, nom_variable: str, valeur_systeme):
        if self._namespace is None:
            return valeur_systeme
        return self._namespace.get(nom_variable, valeur_systeme)

    # ------------------------------------------------------------------
    # Détection -- capture_propre (SANS le curseur virtuel, cf. décision
    # utilisateur/action_capture_propre côté instance_nodriver.py) PUIS
    # matchTemplate/ORB/SSIM (rechercher_composant_multi_variantes),
    # jamais la frame de streaming continu (qui n'existe d'ailleurs pas
    # ici -- pas de flux poussé pendant l'exécution d'un Task, cf.
    # décision utilisateur "on neauras pas de stream en continu").
    # ------------------------------------------------------------------
    def _detecter(self, timeout: Optional[float] = None) -> Optional[dict]:
        """AJOUT (demande explicite utilisateur -- "detecter doit prendre
        le timeout de celui qui l'appelle") : timeout n'est PAS résolu
        ici (pas de _global_defaut("TIMEOUT", ...) séparé) -- reçu tel
        quel de l'appelant (visible(timeout=...), ou _executer_avec_retry
        qui transmet EXACTEMENT le même timeout déjà résolu pour l'action
        réseau qui suit, cf. son commentaire). None -> comportement
        historique inchangé (timeout_action_s absent des params, 5.0s
        fixe côté instance pour "capture_propre").

        BUG CORRIGÉ (demande explicite utilisateur -- traceback
        "RuntimeError: Échec de capture ... timeout interne instance :
        CDP ne répond pas (>5.0s)" malgré TIMEOUT=10 dans la cellule
        dynamique et timeout=TIMEOUT explicitement passé à click()) :
        _detecter() (appelée par visible() ET par _executer_avec_retry
        avant CHAQUE action) faisait son propre appel réseau
        "capture_propre" SANS AUCUN timeout, ni résolu ni transmis --
        contrairement à l'action elle-même (click/saisir/...), la
        DÉTECTION qui la précède systématiquement n'était touchée par
        AUCUN patch précédent (ni celui de saisir/new_tab, ni la
        généralisation de _executer_avec_retry, puisque cette dernière
        n'ajoute timeout_action_s qu'aux params de l'action, pas à ceux
        de la détection qui a lieu avant, dans un appel réseau séparé)."""
        if not VISION_DISPONIBLE:
            raise RuntimeError("Détection visuelle indisponible (numpy/cv2 non installés).")
        # PATCH (retour utilisateur : latence inexpliquée entre deux actions
        # -- cf. docstring de log_detection ci-dessus pour le contexte
        # complet) -- _horloge() réutilisée telle quelle (time.monotonic(),
        # définie plus bas dans ce fichier mais résolue à l'appel, pas à la
        # définition -- même schéma que son usage existant côté
        # action_camoufox_scroll/mousemove).
        debut_total = _horloge()
        params = {"timeout_action_s": timeout} if timeout is not None else {}
        debut_reseau = _horloge()
        reponse = self._moteur._appeler(self.instance_id, "capture_propre", params, timeout=timeout)
        duree_reseau = _horloge() - debut_reseau
        if not reponse.get("ok"):
            log_detection.info(
                f"[{self.nom}] _detecter() : échec capture_propre après {duree_reseau:.3f}s -- {reponse.get('error')}"
            )
            raise RuntimeError(f"Échec de capture pour « {self.nom} » : {reponse.get('error')}")
        image_b64 = reponse.get("result", {}).get("image_b64")
        image = decoder_image_b64(image_b64) if image_b64 else None
        if image is None:
            raise RuntimeError(f"Capture invalide reçue pour « {self.nom} ».")
        debut_decodage = _horloge()
        image_bgr = qimage_vers_bgr(image)
        templates_bgr = charger_templates_bgr(self.composant, self._dossier_racine_images)
        duree_decodage = _horloge() - debut_decodage
        if not templates_bgr:
            # LOG CIBLÉ (diagnostic) : niveau WARNING (pas INFO) -- ce cas
            # précis (composant sans AUCUNE variante/image de référence
            # chargée) fait échouer TOUTE détection pour ce composant, de
            # façon indiscernable d'un composant simplement absent de
            # l'écran : visible() renverra False, click() lèvera son
            # erreur "introuvable", dans les deux cas SANS jamais indiquer
            # que la cause réelle est l'absence de variante chargée plutôt
            # qu'un vrai échec de détection visuelle sur une page correcte.
            log_detection.warning(
                f"[{self.nom}] _detecter() : AUCUNE VARIANTE CHARGÉE pour ce composant -- "
                f"détection impossible par construction (retournera toujours 'non trouvé'), "
                f"indépendamment de ce qui est réellement affiché à l'écran. "
                f"Vérifier que ce composant a bien au moins une image de référence enregistrée. "
                f"réseau={duree_reseau:.3f}s décodage={duree_decodage:.3f}s (recherche non lancée)"
            )
            return None  # aucune variante utilisable -> jamais détecté, cf. charger_templates_bgr
        debut_recherche = _horloge()
        try:
            # PATCH (SPEC_GLOBALE_AutoniaX.md, Partie A §3.5) -- plus
            # d'arguments composant.seuil_confiance/priorite_selection/
            # flou_noyau/delta_conflit/code_filtre ici : templates_bgr
            # contient désormais des tuples (image_bgr, Variante) (cf.
            # charger_templates_bgr), et rechercher_composant_multi_variantes
            # lit les réglages PROPRES À CHAQUE variante directement dessus.
            # Les anciens arguments composant.<champ> ne servaient que de
            # repli rétrocompatible pour un appelant non migré -- ce n'est
            # plus le cas ici, les retirer évite de laisser croire que ce
            # sont encore ces valeurs qui pilotent la détection.
            resultat, _score_brut = rechercher_composant_multi_variantes(image_bgr, templates_bgr)
        except DetectionFiltreComposantSingleError as e:
            duree_recherche = _horloge() - debut_recherche
            log_detection.info(
                f"[{self.nom}] _detecter() : erreur de filtre (code_filtre) après réseau={duree_reseau:.3f}s "
                f"décodage={duree_decodage:.3f}s recherche={duree_recherche:.3f}s -- {e}"
            )
            raise RuntimeError(f"Erreur du filtre de détection pour « {self.nom} » : {e}")
        except DetectionAmbigueError as e:
            duree_recherche = _horloge() - debut_recherche
            log_detection.info(
                f"[{self.nom}] _detecter() : DetectionAmbigueError après réseau={duree_reseau:.3f}s "
                f"décodage={duree_decodage:.3f}s recherche={duree_recherche:.3f}s "
                f"({len(templates_bgr)} variante(s) testée(s)) -- {e}"
            )
            raise RuntimeError(f"Détection ambiguë pour « {self.nom} » : {e}")
        duree_recherche = _horloge() - debut_recherche
        duree_totale = _horloge() - debut_total
        # AJOUT (demande explicite utilisateur) -- seul log qui permet de
        # répondre à "pourquoi ça ne s'enchaîne pas directement" : la somme
        # réseau+décodage+recherche EST le temps total de _detecter(), lui-
        # même appelé avant CHAQUE action (click/saisir/visible/...) -- si
        # recherche >> réseau, le goulot est le matchTemplate/ORB/SSIM
        # local (nombre de variantes/paliers), pas le réseau ni Camoufox.
        # DÉSACTIVÉ (demande explicite utilisateur : "logs les plus
        # bruyants" -- cf. analyse logs.txt, ~415 occurrences cumulées
        # trouvé+absent, appelé avant CHAQUE action) -- passé en debug
        # plutôt que supprimé : reste le seul moyen de diagnostiquer un
        # goulot réseau/décodage/recherche, réactivable via la config du
        # logger le jour où ce diagnostic redevient nécessaire.
        # LOG CIBLÉ (diagnostic) : le cas "absent" passe désormais en INFO
        # (visible sans activer tout le logging debug, très bruyant, cf.
        # commentaire ci-dessus) -- c'est la seule ligne qui distingue
        # clairement "composant cherché sur N variantes mais non trouvé à
        # l'écran" (page probablement correcte, composant mal calibré ou
        # simplement pas présent) d'un échec réseau ou d'un défaut de
        # variantes chargées (cf. logs juste au-dessus, cas templates_bgr
        # vide). Le cas "trouvé" reste en debug (bruyant, appelé avant
        # CHAQUE action réussie, sans valeur de diagnostic une fois que ça
        # marche).
        if resultat:
            log_detection.debug(
                f"[{self.nom}] _detecter() : trouvé -- total={duree_totale:.3f}s "
                f"(réseau={duree_reseau:.3f}s décodage={duree_decodage:.3f}s "
                f"recherche={duree_recherche:.3f}s sur {len(templates_bgr)} variante(s))"
            )
        else:
            log_detection.info(
                f"[{self.nom}] _detecter() : ABSENT -- testé sur {len(templates_bgr)} variante(s), "
                f"aucune ne matche l'écran actuel -- total={duree_totale:.3f}s "
                f"(réseau={duree_reseau:.3f}s décodage={duree_decodage:.3f}s recherche={duree_recherche:.3f}s)"
            )
        return resultat

    def _detecter_ou_lever(self, timeout: Optional[float] = None) -> dict:
        resultat = self._detecter(timeout=timeout)
        if resultat is None:
            raise ComposantIntrouvableError(f"« {self.nom} » introuvable à l'écran (instance « {self.instance_id} »).")
        return resultat

    # ------------------------------------------------------------------
    # AJOUT (demande explicite utilisateur : "il faut que un composant
    # lors de l'exécution d'une méthode prend 2 paramètre de plus : le
    # nombre de retry en cas d'échec, et timeout d'une exécution") --
    # factorise la boucle commune à click/mousemove/move_cursor/scroll/
    # paste/clear/saisir/drag : tentative -> échec -> nouvelle capture
    # d'écran ("on doit refaire une nouvelle capture actuelle avant de
    # effectuer encore la recherche", décision utilisateur) -> nouvelle
    # tentative, jusqu'à retry+1 essais au total ou succès.
    #
    # action_reseau : nom de l'action envoyée à l'instance (ex:
    # "click", "type_text", ...).
    # construire_params(resultat_detection) : callable qui reçoit le
    # dict de détection FRAIS de cette tentative et renvoie le dict
    # params à passer à _moteur._appeler (permet à chaque méthode de
    # recalculer cx/cy à partir de la détection propre à la tentative
    # en cours).
    # libelle : texte utilisé dans le message d'erreur final
    # ("Échec du clic sur...", etc.), inchangé par rapport aux messages
    # d'origine.
    #
    # Retourne un ResultatAction -- ne lève plus RuntimeError sur échec
    # (décision utilisateur explicite : "Retourner False. mais en
    # renvoyant aussi le message d'erreur : dans une variable e") --
    # ComposantIntrouvableError reste levée telle quelle si la détection
    # elle-même échoue à CHAQUE tentative (cf. _detecter_ou_lever),
    # cohérent avec le comportement pré-existant de cette exception.
    # ------------------------------------------------------------------
    # AJOUT (demande explicite utilisateur : "sa concerne les deux sens
    # une temps de latence avant et après execution") : latence_avant
    # attend AVANT l'envoi de la commande réseau (une fois le Composant
    # détecté, position connue), latence_apres attend APRÈS la réponse
    # (succès ou échec) -- appliquées à CHAQUE tentative, pas une seule
    # fois globalement (cohérent avec retry/timeout, déjà par-tentative).
    #
    # AJOUT (demande explicite utilisateur : "les variable seront deja
    # predefinit dans les cellules statique" -- RETRY/TIMEOUT/
    # LATENCE_AVANT/LATENCE_APRES) : retry/timeout/latence_avant/
    # latence_apres valent None PAR DÉFAUT dans la signature de CHAQUE
    # méthode publique (click, saisir, ...) -- None signifie "non précisé
    # par le script" et déclenche la lecture de la variable globale
    # correspondante dans le namespace du Task (cf. _global_defaut) ;
    # une valeur EXPLICITEMENT passée par le script (y compris retry=0)
    # prime TOUJOURS sur la globale (décision utilisateur explicite :
    # "si jamais je veux personnaliser, moi-même je vais effacer
    # l'affectation et mettre une valeur").
    def _executer_avec_retry(self, action_reseau: str, construire_params, libelle: str,
                              retry: Optional[int] = None, timeout: Optional[float] = None,
                              latence_avant: Optional[float] = None, latence_apres: Optional[float] = None,
                              retourner_result: bool = False) -> "ResultatAction":
        """retourner_result (AJOUT click(copier_presse_papier=True), défaut
        False) : si True, injecte reponse.get("result") (le texte du
        presse-papier Windows lu côté serveur, cf. srv_gerer_command_result)
        dans ResultatAction.texte_presse_papier en cas de succès. N'affecte
        aucun appelant existant (mousemove, scroll, paste, clear...) --
        tous continuent à passer False implicitement (valeur par défaut),
        donc ResultatAction(True) inchangé pour eux."""
        retry = retry if retry is not None else self._global_defaut("RETRY", 0)
        timeout = timeout if timeout is not None else self._global_defaut("TIMEOUT", None)
        latence_avant = latence_avant if latence_avant is not None else self._global_defaut("LATENCE_AVANT", 0.0)
        latence_apres = latence_apres if latence_apres is not None else self._global_defaut("LATENCE_APRES", 0.0)
        essais_total = max(1, retry + 1)
        derniere_erreur: Optional[str] = None
        for tentative in range(essais_total):
            try:
                # AJOUT (demande explicite utilisateur -- "detecter doit
                # prendre le timeout de celui qui l'appelle") : transmet
                # le MÊME timeout déjà résolu ci-dessus (ligne précédente)
                # -- celui qui va gouverner l'action réseau elle-même --
                # à l'étape de détection qui la précède. Avant ce patch,
                # _detecter_ou_lever() n'avait aucun moyen de recevoir de
                # timeout : la capture d'écran qui précède CHAQUE
                # tentative de click/saisir/etc. restait bloquée à 5.0s
                # fixe côté instance peu importe ce que l'utilisateur
                # précisait sur l'action elle-même (cf. docstring
                # _detecter, "BUG CORRIGÉ").
                resultat_detection = self._detecter_ou_lever(timeout=timeout)
            except ComposantIntrouvableError as e:
                derniere_erreur = str(e)
                if tentative < essais_total - 1:
                    continue  # nouvelle capture + nouvelle recherche à la tentative suivante
                raise  # dernière tentative : comportement inchangé, on laisse remonter
            params = construire_params(resultat_detection)
            # AJOUT (demande explicite utilisateur -- "je veux juste que ce
            # soit le comportement par defaut mais des que je specifie
            # quelque chose sa doit etre respecter") : le timeout interne
            # côté instance (_boucle_traitement_commandes) reste 5.0s FIXE
            # par défaut quand rien n'est précisé (timeout=None après
            # résolution ci-dessus -- COMPORTEMENT INCHANGÉ), mais dès
            # qu'un timeout est explicitement fourni (par l'appel ou via
            # TIMEOUT dans la cellule "Variable dynamique"), il est
            # transmis à l'instance sous "timeout_action_s" -- lu par la
            # boucle de traitement pour TOUTE action générique (click,
            # mousemove, moveCursor, scroll, paste, clear, drag/drop),
            # même schéma que timeout_saisie_s pour type_text et
            # timeout_attente_page_s pour newTab (cf. leurs docstrings) --
            # pour que le timeout choisi soit VRAIMENT respecté de bout en
            # bout, pas seulement côté réseau moteur.
            timeout_appel_pilote = timeout
            if timeout is not None:
                params["timeout_action_s"] = timeout
                timeout_appel_pilote = timeout + MARGE_RESEAU_ATTENTE_CHARGEMENT_S
            if latence_avant:
                time.sleep(latence_avant)
            reponse = self._moteur._appeler(self.instance_id, action_reseau, params, timeout=timeout_appel_pilote)
            if latence_apres:
                time.sleep(latence_apres)
            if reponse.get("ok"):
                if retourner_result:
                    # PATCH (robustesse capture de copie) : l'instance
                    # signale désormais explicitement, via
                    # presse_papier_frais=False, qu'AUCUNE copie imputable
                    # à CE clic n'a été observée dans le délai imparti (cf.
                    # _attendre_copie_presse_papier_fraiche). Avant ce
                    # patch, ce cas était indistinguable d'un succès : le
                    # script recevait statut=True avec un texte_presse_
                    # papier potentiellement PÉRIMÉ (copie d'un clic
                    # antérieur sans rapport), sans le moindre signal.
                    #
                    # Décision explicite : PAS de nouvelle tentative dans
                    # ce cas, on sort immédiatement de la boucle de retry.
                    # Le clic, lui, a bel et bien RÉUSSI -- rejouer les
                    # tentatives restantes recliquerait sur le bouton, ce
                    # qui n'est jamais anodin (double envoi, double copie,
                    # action destructrice sur un autre bouton mal
                    # configuré). Seule la CAPTURE a échoué, et la
                    # recommencer n'a de sens qu'à l'initiative du script.
                    #
                    # Aucune exception levée ici : cohérent avec la
                    # docstring de click(), "ne lève PLUS de RuntimeError
                    # sur échec réseau/CDP" -- seule
                    # ComposantIntrouvableError continue de remonter.
                    if reponse.get("presse_papier_frais") is False:
                        return ResultatAction(
                            False,
                            f"Clic réussi sur « {self.nom} » mais "
                            + (reponse.get("presse_papier_message")
                               or "aucune copie presse-papier détectée après le clic")
                            + ".",
                        )
                    return ResultatAction(True, texte_presse_papier=reponse.get("result"))
                return ResultatAction(True)
            derniere_erreur = reponse.get("error")
        return ResultatAction(False, f"Échec {libelle} sur « {self.nom} » (après {essais_total} tentative(s)) : {derniere_erreur}")

    # --- Détection / état ---
    def visible(self, timeout: Optional[float] = None, freq: Optional[float] = None, click: bool = False) -> bool:
        """visible() -- détecte si ce Composant est actuellement présent à
        l'écran (reconnaissance visuelle, matchTemplate sur les variantes du
        Composant). Capture dédiée (capture_propre) à chaque appel -- pas de
        cache, reflète toujours l'état actuel de l'instance.

        timeout (défaut None -> lit TIMEOUT de la cellule "Variable
        dynamique", comportement historique 5.0s fixe côté instance si
        absente/None -- EN SECONDES) : délai maximum accordé à cette
        capture d'écran. AJOUT (demande explicite utilisateur -- même bug
        que click()/saisir() : "detecter doit prendre le timeout de celui
        qui l'appelle" -- visible() n'avait auparavant AUCUN moyen de
        dépasser le timeout interne fixe de 5.0s côté instance, cf.
        docstring _detecter).

        freq (défaut None -- AJOUT, demande explicite utilisateur :
        "visible doit maintenant prendre un timeout, et un freq, ça doit
        vérifier sur une période de 10 sec maximale et tous les 2 sec si
        le composant en question est visible, si ça échoue ça retourne
        juste False") : quand freq est fourni (freq > 0), `timeout` change
        de sens et devient la DURÉE TOTALE de polling (en secondes,
        horloge murale) -- une nouvelle détection est retentée toutes les
        `freq` secondes jusqu'à ce que le Composant soit détecté (retourne
        True immédiatement, sans attendre le reste de la période) ou que
        `timeout` secondes se soient écoulées (retourne False). CHAQUE
        détection individuelle de cette boucle utilise son propre timeout
        réseau COURT (`freq`, borné à `timeout` restant) plutôt que la
        durée totale -- une capture bloquée en réseau ne doit jamais, à
        elle seule, consommer tout le budget de polling.

        Sans freq (comportement historique, INCHANGÉ) : une seule
        détection, timeout = délai réseau de CETTE capture unique, comme
        avant cet ajout.

        click (défaut False -- AJOUT, demande explicite utilisateur :
        "on met click, par défaut sa seras à false, mais si on met true
        sa veux dire qui si cest visible et bien sa clic directement") :
        quand True ET que le Composant est détecté (peu importe le mode,
        avec ou sans freq), déclenche immédiatement self.click() -- clic
        SIMPLE (aucun paramètre exposé ici, demande explicite : "je sais
        pas si cest une bonne idee de mettre les parametre retry tout
        sa"). Ce click() interne est volontairement ISOLÉ de RETRY/
        TIMEOUT/LATENCE_AVANT/LATENCE_APRES de la cellule "Variable
        dynamique" (demande explicite utilisateur) -- valeurs forcées en
        dur : retry=0 (1 seul essai), timeout=None (5.0s fixe côté
        instance, comportement historique), latence_avant=0,
        latence_apres=0 -- CHANGER RETRY/TIMEOUT/etc. dans la cellule
        n'affecte JAMAIS ce clic-là. Que le clic réussisse ou échoue,
        visible() retourne True QUAND MÊME (demande explicite
        utilisateur : "True quand même (la détection a réussi, le clic
        est une best-effort en plus)") -- seule la DÉTECTION conditionne
        la valeur de retour, jamais le clic. Toute exception levée par ce
        click() est absorbée en interne (même esprit que l'absorption
        d'exception de _detecter() ci-dessous) : un aléa sur le clic ne
        doit jamais faire planter visible(click=True), ni changer son
        True en exception. Sans click (comportement par défaut,
        INCHANGÉ) : visible() ne clique jamais, comme avant cet ajout.

        Exemple : yt_view_yt_home_icon.visible(timeout=10, freq=2) ->
        jusqu'à 5 détections espacées de 2s, sur 10s maximum au total.
        yt_view_yt_link_prcr.visible(timeout=10, freq=2, click=True) ->
        même polling, ET clic automatique dès détection réussie."""
        def _clic_si_demande(resultat_detection: Optional[dict]) -> None:
            if not click:
                return
            if resultat_detection is None:
                return
            # CORRECTIF (bug confirmé : clic hors zone personnalisée sur
            # yt_view_yt_link_prcr) -- l'ancienne version appelait
            # self.click(...), qui refait sa PROPRE capture d'écran et sa
            # propre détection via _executer_avec_retry/_detecter_ou_lever,
            # totalement indépendante de la détection qui vient de
            # confirmer visible()==True juste au-dessus. Entre les deux
            # captures réseau successives, la page cible peut avoir
            # légèrement bougé (scroll, chargement différé, bannière) --
            # la zone_clic_rect personnalisée du composant (ex. un
            # rectangle étroit de quelques dizaines de pixels) est alors
            # appliquée par rapport à une position DIFFÉRENTE de celle
            # visuellement validée par la détection de visible(), ce qui
            # fait tomber le clic à côté de la cible réelle.
            #
            # Correctif : réutilise DIRECTEMENT resultat_detection (déjà
            # obtenu par CETTE détection de visible(), sans nouvel appel
            # réseau) pour calculer le point de clic -- point_clic_composant
            # respecte toujours composant.zone_clic_mode/zone_clic_rect
            # exactement comme le ferait click() sans zone explicite (cf.
            # sa docstring), seule la SOURCE de la détection change. Envoi
            # réseau direct de l'action "click", même valeurs de paramètres
            # que les défauts de ComposantSingleExecutable.click() (bouton
            # gauche, appui 60ms, un seul clic, vitesse normale) --
            # reproduites ici en dur puisque visible() n'expose aucun de
            # ces réglages. Best-effort : toute exception (réseau, instance
            # fermée...) est absorbée et journalisée, jamais propagée --
            # visible() doit continuer à retourner True (seule la
            # DÉTECTION conditionne son retour, jamais le clic, cf.
            # docstring de visible()).
            try:
                # DIAG_ZONE_CLIC (demande explicite utilisateur) -- confirme
                # que c'est bien LA détection de visible() qui est réutilisée
                # ici (pas une nouvelle capture réseau) : x/y/largeur/hauteur/
                # echelle doivent être identiques à ceux déjà loggés côté
                # _detecter() pour ce même appel de visible(). Tag recherchable
                # via le champ "Filtrer par motif" (écran Paramètres).
                log_detection.info(
                    f"[DIAG_ZONE_CLIC][{self.nom}] _clic_si_demande() : réutilise resultat_detection "
                    f"(PAS de nouvelle capture réseau) -- x={resultat_detection['x']} "
                    f"y={resultat_detection['y']} largeur={resultat_detection['largeur']} "
                    f"hauteur={resultat_detection['hauteur']} echelle={resultat_detection['echelle']}"
                )
                cx, cy = point_clic_composant(resultat_detection, self.composant)
                # CORRECTIF (bug confirmé par diagnostic ciblé -- ce clic
                # auto interne à visible(click=True) construisait ses
                # params EN DUR, SANS jamais appeler self._global_defaut(
                # "SOURIS_INSTANTANEE", False) -- contrairement au click()
                # normal (cf. _params dans ComposantSingleExecutable.click,
                # _executer_avec_retry). Résultat : un script avec
                # SOURIS_INSTANTANEE=True voyait quand même une trajectoire
                # simulée sur CE clic précis (visible(click=True)), alors que
                # tous ses .click() explicites respectaient bien le réglage.
                # "instantane" ajouté ici pour que ce clic auto se comporte
                # EXACTEMENT comme un .click() normal vis-à-vis de ce réglage
                # -- reste par ailleurs volontairement isolé de RETRY/TIMEOUT/
                # LATENCE_AVANT/LATENCE_APRES, cf. docstring de visible().
                params_clic_auto = {
                    "x": cx, "y": cy, "bouton": "gauche", "duree_appui_ms": 60,
                    "nb_clics": 1, "speedPercent": 0,
                    "instantane": self._global_defaut("SOURIS_INSTANTANEE", False),
                }
                self._moteur._appeler(self.instance_id, "click", params_clic_auto, timeout=None)
                log_detection.info(
                    f"[DIAG_ZONE_CLIC][{self.nom}] clic auto ENVOYÉ au réseau -- point=({cx},{cy})"
                )
            except Exception as e:
                log_detection.info(
                    f"[{self.nom}] visible(click=True) : exception absorbée pendant le clic auto -- {e}"
                )
        if freq is not None and freq > 0:
            duree_totale = timeout if timeout is not None else self._global_defaut("TIMEOUT", None)
            if duree_totale is None:
                # Pas de budget total connu (ni timeout explicite, ni
                # TIMEOUT global défini) -- retombe sur une détection
                # unique plutôt que d'boucler sans jamais s'arrêter.
                timeout_unique = timeout if timeout is not None else self._global_defaut("TIMEOUT", None)
                resultat_detection_unique = self._detecter(timeout=timeout_unique)
                if resultat_detection_unique is not None:
                    _clic_si_demande(resultat_detection_unique)
                return resultat_detection_unique is not None
            debut_polling = _horloge()
            while True:
                temps_restant = duree_totale - (_horloge() - debut_polling)
                if temps_restant <= 0:
                    return False
                # CORRECTIF (demande explicite utilisateur -- "freq c'est le
                # taux de fréquence de vérification, pas un timeout") :
                # AVANT, cette ligne faisait `min(freq, temps_restant)`, ce
                # qui détournait freq en timeout réseau de CHAQUE détection
                # individuelle -- avec freq=2, chaque capture n'avait que 2s
                # pour aboutir, indépendamment du budget total ou du timeout
                # réseau réel de capture_propre. freq ne doit JAMAIS raccourcir
                # le timeout d'une détection individuelle : seul le budget
                # total restant (temps_restant) le borne désormais, exactement
                # comme une détection unique sans freq. freq ne sert plus
                # qu'à calculer la pause ENTRE deux tentatives, ci-dessous.
                debut_iteration = _horloge()
                # AJOUT (demande explicite utilisateur -- "absorber l'échec
                # à chaque itération") : _detecter() peut lever RuntimeError
                # (échec réseau capture_propre, image invalide, erreur de
                # code_filtre, détection ambiguë -- cf. son docstring) --
                # un aléa TRANSITOIRE sur une seule itération de polling ne
                # doit jamais faire planter tout visible(timeout, freq) ;
                # cette itération compte comme "pas détecté" et le polling
                # continue normalement jusqu'à expiration de duree_totale.
                try:
                    resultat_detection_iter = self._detecter(timeout=temps_restant)
                except RuntimeError as e:
                    log_detection.info(
                        f"[{self.nom}] visible(freq=...) : exception absorbée pendant le polling -- {e}"
                    )
                    resultat_detection_iter = None
                if resultat_detection_iter is not None:
                    _clic_si_demande(resultat_detection_iter)
                    return True
                temps_ecoule = _horloge() - debut_polling
                if temps_ecoule >= duree_totale:
                    return False
                # CORRECTIF (même demande) : freq est le CADENCEMENT désiré
                # entre le DÉBUT de deux tentatives consécutives -- si la
                # détection qui vient de se terminer a déjà pris >= freq
                # secondes, on relance IMMÉDIATEMENT (pause=0), on ne rajoute
                # jamais une pause complète de freq par-dessus le temps déjà
                # écoulé (avant ce correctif, une détection de 1.5s avec
                # freq=2 produisait un intervalle réel de 3.5s, pas 2s).
                duree_iteration = _horloge() - debut_iteration
                pause = max(0.0, freq - duree_iteration)
                pause = min(pause, duree_totale - temps_ecoule)
                if pause > 0:
                    time.sleep(pause)
        timeout = timeout if timeout is not None else self._global_defaut("TIMEOUT", None)
        resultat_detection_simple = self._detecter(timeout=timeout)
        if resultat_detection_simple is not None:
            _clic_si_demande(resultat_detection_simple)
        return resultat_detection_simple is not None


    # --- clic / double-clic ---
    def click(self, zone: Optional[ZoneLike] = None, bouton: str = "gauche", duree_appui_ms: int = 60,
              nb_clics: int = 1, retry: Optional[int] = None, timeout: Optional[float] = None,
              latence_avant: Optional[float] = None, latence_apres: Optional[float] = None,
              copier_presse_papier: bool = False, speed_percent: float = 0,
              timeout_copie: Optional[float] = None) -> "ResultatAction":
        """click(zone=None) -- clic simulé sur ce Composant. bouton:
        gauche/droit. nb_clics=2 pour un double-clic. Équivalent haut
        niveau de action_click, ciblé automatiquement sur ce Composant
        (position déterminée par sa détection à l'écran, pas de x/y à
        fournir). zone : ZoneClicRect optionnel (même format que celui
        produit par le tracé de rectangle de CoordonneeActionScreen) --
        si fourni, remplace ponctuellement la zone_clic_rect du Composant
        pour cet appel uniquement (comportement par défaut inchangé si
        omis).

        retry (défaut 0) : nombre de tentatives SUPPLÉMENTAIRES en cas
        d'échec (retry=3 -> 4 essais au total) -- entre chaque tentative,
        nouvelle capture d'écran et nouvelle détection du Composant.
        timeout (défaut None, EN SECONDES) : timeout réseau propre à CET
        appel, remplace ponctuellement le timeout global du moteur si
        fourni.
        latence_avant / latence_apres (défaut 0.0, EN SECONDES) : pause
        respectivement juste avant l'envoi de la commande et juste après
        la réponse -- appliquées à CHAQUE tentative (donc aussi à chaque
        retry, pas une seule fois globalement).

        speed_percent (défaut 0, demande utilisateur explicite : "jamireas
        que clik et move prend en parametre la parametre speed pour que on
        puisse controler la vitesse dexecution") -- contrôle la vitesse du
        déplacement HUMAIN préalable jusqu'à la cible (cf. action_click /
        action_camoufox_click) : 0 = vitesse normale/mesurée (défaut,
        comportement inchangé), positif = plus rapide, négatif = plus
        lent. Indépendant de tout speed_percent utilisé par un mousemove()
        appelé séparément -- ce clic a son propre réglage. N'affecte que
        la cadence temporelle du geste, pas duree_appui_ms.

        copier_presse_papier (défaut False) -- à activer quand ce clic
        déclenche lui-même une copie côté site (bouton "copier" du site,
        qui écrit via navigator.clipboard.writeText(),
        navigator.clipboard.write() (ClipboardItem) ou l'événement DOM
        "copy"). Ces TROIS voies sont interceptées EN PERMANENCE côté
        navigateur, pour CHAQUE instance, dès son démarrage (cf.
        _installer_interception_presse_papier / camoufox_installer_
        interception_presse_papier) : le texte que le site croit copier
        n'atteint jamais le presse-papier Windows -- il est redirigé vers
        le presse-papier VIRTUEL, propre à cette instance (le même que
        celui utilisé par copy()/paste()/get_presse_papier()). Le texte
        copié est disponible dans le ResultatAction retourné via
        .texte_presse_papier :
            r = bouton.click(copier_presse_papier=True)
            if r:
                texte = r.texte_presse_papier

        PATCH (robustesse capture de copie) -- garantie de FRAÎCHEUR :
        après le clic, l'instance attend activement (polling) qu'une copie
        POSTÉRIEURE à ce clic précis apparaisse, au lieu de l'ancien délai
        fixe de 100 ms suivi d'une lecture aveugle. Deux conséquences
        directes pour les scripts :
          - un site lent à copier (requête réseau préalable, animation,
            traitement JS lourd) est désormais capté, là où il était
            silencieusement raté ;
          - si AUCUNE copie n'est détectée dans le délai, le résultat est
            un ÉCHEC EXPLICITE (statut=False, .message détaillé,
            .texte_presse_papier=None) au lieu d'un faux succès portant la
            valeur d'un clic ANTÉRIEUR sans rapport. Un script existant
            qui testait déjà `if r:` bénéficie donc automatiquement de la
            correction, sans modification.
        Dans ce cas d'échec, AUCUNE nouvelle tentative n'est faite même si
        retry est élevé : le clic lui-même a réussi, le rejouer
        recliquerait réellement sur le bouton.

        timeout_copie (défaut None -> DELAI_DETECTION_COPIE_PRESSE_PAPIER_S,
        EN SECONDES) : budget total accordé à cette détection de copie.
        N'a d'effet que si copier_presse_papier=True. Sans rapport avec
        `timeout` (qui gouverne la détection visuelle et le réseau) --
        paramètre distinct volontairement, pour qu'allonger l'un
        n'allonge pas l'autre. Le défaut est plus permissif que l'ancien
        comportement figé à 100 ms, donc aucun script existant ne peut
        régresser en ne le précisant pas.

        Retourne un ResultatAction (statut=False + .message si échec
        après toutes les tentatives) -- ne lève PLUS de RuntimeError sur
        échec réseau/CDP. Lève toujours ComposantIntrouvableError si le
        composant n'est pas détecté après toutes les tentatives (la
        détection, elle, reste une exception -- comportement inchangé)."""
        def _params(resultat_detection):
            cx, cy = point_clic_composant(resultat_detection, self.composant, zone_override=zone)
            params = {"x": cx, "y": cy, "bouton": bouton, "duree_appui_ms": duree_appui_ms, "nb_clics": nb_clics,
                      "speedPercent": speed_percent,
                      "instantane": self._global_defaut("SOURIS_INSTANTANEE", False)}
            if copier_presse_papier:
                params["copier_presse_papier"] = True
                # Cf. Composant.id_dom -- transmis SEULEMENT si renseigné,
                # "" (défaut) laisse le champ absent des params, comme
                # avant ce patch (comportement historique inchangé : le
                # ciblage précis est une amélioration optionnelle, pas un
                # nouveau champ requis pour chaque composant existant).
                if self.composant.id_dom:
                    params["id_dom_presse_papier"] = self.composant.id_dom
                # Même principe : absent des params si non précisé, pour
                # que l'instance applique sa propre valeur par défaut
                # (DELAI_DETECTION_COPIE_PRESSE_PAPIER_S) plutôt qu'une
                # valeur imposée depuis le pilote.
                if timeout_copie is not None:
                    params["delai_copie_presse_papier_s"] = float(timeout_copie)
            return params
        return self._executer_avec_retry("click", _params, libelle="du clic", retry=retry, timeout=timeout,
                                          latence_avant=latence_avant, latence_apres=latence_apres,
                                          retourner_result=copier_presse_papier)


    def glisser_souris(self, depart: Optional[ZoneLike] = None, arrivee=None, bouton: str = "gauche",
                       speed_percent: float = 0, retry: Optional[int] = None,
                       timeout: Optional[float] = None, latence_avant: Optional[float] = None,
                       latence_apres: Optional[float] = None) -> "ResultatAction":
        """glisser_souris(depart, arrivee) -- glisser (souris) : appui au point
        `depart`, déplacement humain bouton maintenu, relâchement au point
        `arrivee`. Distinct de drag() (dépôt de fichier).
        depart  : zone relative à CE composant (ZoneClicRect / (x, y, largeur,
                  hauteur)) ; None = sa zone de clic habituelle (comme click()).
        arrivee : un autre Composant (détecté à chaque tentative, point tiré
                  dans sa zone de clic), un point (x, y) en coordonnées écran,
                  ou une zone relative à CE composant.
        bouton/speed_percent/retry/timeout/latence_* : voir click()."""
        if arrivee is None:
            raise ValueError("glisser_souris : le paramètre 'arrivee' est obligatoire")

        def _params(resultat_detection):
            x1, y1 = point_clic_composant(resultat_detection, self.composant, zone_override=depart)
            if hasattr(arrivee, "_detecter_ou_lever") and hasattr(arrivee, "composant"):
                det2 = arrivee._detecter_ou_lever(timeout=timeout)
                x2, y2 = point_clic_composant(det2, arrivee.composant)
            elif isinstance(arrivee, (tuple, list)) and len(arrivee) == 2:
                x2, y2 = int(arrivee[0]), int(arrivee[1])
            else:
                z = _normaliser_zone(arrivee)
                if z is None or z.est_vide():
                    raise ValueError("glisser_souris : 'arrivee' doit être un Composant, un point (x, y) ou une zone")
                x2, y2 = point_clic_composant(resultat_detection, self.composant, zone_override=z)
            return {"x1": x1, "y1": y1, "x2": x2, "y2": y2, "bouton": bouton,
                    "speedPercent": speed_percent,
                    "instantane": self._global_defaut("SOURIS_INSTANTANEE", False)}
        return self._executer_avec_retry("mouse_drag", _params, libelle="du glisser (souris)", retry=retry,
                                          timeout=timeout, latence_avant=latence_avant, latence_apres=latence_apres)

    # --- déplacement du curseur ---
    def mousemove(self, zone: Optional[ZoneLike] = None, retry: Optional[int] = None, timeout: Optional[float] = None,
                  latence_avant: Optional[float] = None, latence_apres: Optional[float] = None,
                  speed_percent: float = 0) -> "ResultatAction":
        """mousemove(zone=None) -- déplace le curseur réel (sans clic)
        vers ce Composant. Équivalent haut niveau de action_mousemove.
        zone : voir click(). retry/timeout/latence_avant/latence_apres
        (secondes) : voir click().

        speed_percent (défaut 0, cf. click()) -- contrôle la vitesse du
        déplacement HUMAIN généré (0 = vitesse normale/mesurée, positif =
        plus rapide, négatif = plus lent). Indépendant du speed_percent
        d'un click() qui appellerait ce même déplacement en interne.

        Retourne un ResultatAction (voir click())."""
        def _params(resultat_detection):
            cx, cy = point_clic_composant(resultat_detection, self.composant, zone_override=zone)
            return {"x": cx, "y": cy, "speedPercent": speed_percent,
                    "instantane": self._global_defaut("SOURIS_INSTANTANEE", False)}
        return self._executer_avec_retry("mousemove", _params, libelle="de mousemove", retry=retry, timeout=timeout,
                                          latence_avant=latence_avant, latence_apres=latence_apres)

    def move_cursor(self, zone: Optional[ZoneLike] = None, retry: Optional[int] = None, timeout: Optional[float] = None,
                     latence_avant: Optional[float] = None, latence_apres: Optional[float] = None) -> "ResultatAction":
        """move_cursor(zone=None) -- déplace le curseur VIRTUEL seulement
        (aucun événement souris réel envoyé), vers ce Composant.
        Équivalent haut niveau de action_move_cursor. zone : voir
        click(). retry/timeout/latence_avant/latence_apres (secondes) :
        voir click(). Retourne un ResultatAction (voir click()).

        Pas de speed_percent ici (contrairement à click()/mousemove()) :
        ce déplacement ne concerne que le curseur virtuel visuel, envoyé
        en un seul événement moveCursor sans trajectoire intermédiaire à
        cadencer -- rien à ralentir/accélérer."""
        def _params(resultat_detection):
            cx, cy = point_clic_composant(resultat_detection, self.composant, zone_override=zone)
            return {"x": cx, "y": cy}
        return self._executer_avec_retry("moveCursor", _params, libelle="de move_cursor", retry=retry, timeout=timeout,
                                          latence_avant=latence_avant, latence_apres=latence_apres)

    # --- défilement ---
    def scroll(self, zone: Optional[ZoneLike] = None, depart=None, arrivee=None, delta_x: float = 0.0,
               delta_y: float = 0.0, retry: Optional[int] = None, timeout: Optional[float] = None,
               latence_avant: Optional[float] = None, latence_apres: Optional[float] = None,
               speed_percent: float = 0) -> "ResultatAction":
        """scroll(zone=None, depart, arrivee) -- défilement HUMANISÉ sur ce
        Composant (cf. action_scroll : bootstrap statistique sur des
        rafales de scroll réelles, ScrollBank/generate_scroll_events).
        delta_x/delta_y : quantité TOTALE à scroller (mêmes unités que
        WHEEL_DELTA*nb_crans, PAS un delta par cran individuel -- la
        rafale de crans qui réalise ce total est générée et rejouée côté
        instance). depart/arrivee : conservés dans la signature (nommage
        utilisateur) mais PAS ENCORE interprétés au-delà de
        delta_x/delta_y -- leur sens exact (points, directions nommées...)
        reste à préciser avec l'utilisateur avant d'être branché. zone :
        voir click(). retry/timeout/latence_avant/latence_apres
        (secondes) : voir click().

        AJOUT (demande explicite utilisateur : "je veux vraiment pouvoir
        controller la vitesse dexecution dun scroll", "parceque cest
        vraiment parfois trop lent") -- speed_percent (défaut 0, MÊME
        sémantique que click()/mousemove() : 0 = vitesse normale/mesurée,
        positif = plus rapide, négatif = plus lent) : transmis tel quel
        jusqu'à generate_scroll_events (cf. sa docstring -- facteur_
        vitesse = 1 + speed_percent/100, plancher 0.05), qui régit la
        CADENCE TEMPORELLE de la rafale de scroll humanisée rejouée côté
        instance (action_scroll / action_camoufox_scroll, cf. leurs
        docstrings -- "speedPercent" transmis tel quel depuis "data",
        déjà lu côté dispatcher réseau des DEUX backends -- nodriver ET
        camoufox -- avant même ce patch, seul ComposantSingleExecutable.
        scroll() n'exposait pas encore ce paramètre au script Task,
        contrairement à click()/mousemove()/move_cursor() qui l'avaient
        déjà tous les trois). N'affecte que le rythme dans le temps de
        la rafale, jamais le delta_x/delta_y total scrollé (comportement
        identique, seulement plus rapide ou plus lent à s'exécuter).

        AJOUT (demande explicite utilisateur : "je veux un scroll
        extrement rapide", "desactive le scroll humanisé... tu met le
        brut") : instantane (résolu depuis SOURIS_INSTANTANEE de la
        cellule "Variable dynamique", même mécanisme EXACT que click()/
        mousemove(), cf. leur docstring) -- quand actif, court-circuite
        TOTALEMENT la génération de rafale humanisée (ScrollBank/
        generate_scroll_events) : un seul événement mouseWheel envoyé
        avec le delta_x/delta_y TOTAL demandé, zéro délai entre crans.
        N'est PAS un paramètre exposé ici (comme pour click()/
        mousemove()) -- suit automatiquement SOURIS_INSTANTANEE, aucun
        changement de signature nécessaire côté script Task.

        Retourne un ResultatAction (voir click())."""
        def _params(resultat_detection):
            cx, cy = point_clic_composant(resultat_detection, self.composant, zone_override=zone)
            return {"x": cx, "y": cy, "targetDeltaX": delta_x, "targetDeltaY": delta_y,
                    "speedPercent": speed_percent,
                    "instantane": self._global_defaut("SOURIS_INSTANTANEE", False)}
        return self._executer_avec_retry("scroll", _params, libelle="du scroll", retry=retry, timeout=timeout,
                                          latence_avant=latence_avant, latence_apres=latence_apres)

    # --- presse-papier / saisie ---
    def paste(self, texte: Optional[str] = None, zone: Optional[ZoneLike] = None, retry: Optional[int] = None,
              timeout: Optional[float] = None, latence_avant: Optional[float] = None, latence_apres: Optional[float] = None) -> "ResultatAction":
        """paste(texte=None, zone=None) -- focus ce Composant puis colle du
        texte dedans, caractère par caractère (cf. action_paste). Deux
        modes :
          - texte fourni : colle EXACTEMENT ce texte, sans toucher au
            presse-papier virtuel de l'instance (ni le lire, ni l'écraser).
          - texte omis (None, par défaut) : colle le contenu du
            PRESSE-PAPIER VIRTUEL de cette instance (rempli par le dernier
            copy() fait sur CETTE MÊME instance) -- comportement identique
            à avant l'ajout de ce paramètre.
        Jamais le presse-papier Windows dans les deux cas (cf. docstring
        action_paste : isolation par instance demandée par l'utilisateur).
        zone : voir click(). retry/timeout/latence_avant/latence_apres
        (secondes) : voir click(). Retourne un ResultatAction (voir
        click())."""
        def _params(resultat_detection):
            cx, cy = point_clic_composant(resultat_detection, self.composant, zone_override=zone)
            params = {"x": cx, "y": cy}
            if texte is not None:
                params["texte"] = texte
            log_cellule.info(f"[DIAG paste] ComposantExecutable.paste() -- texte reçu en paramètre={texte!r} -- params envoyés={params!r}")
            return params
        return self._executer_avec_retry("paste", _params, libelle="du paste", retry=retry, timeout=timeout,
                                          latence_avant=latence_avant, latence_apres=latence_apres)

    def clear(self, zone: Optional[ZoneLike] = None, retry: Optional[int] = None, timeout: Optional[float] = None,
              latence_avant: Optional[float] = None, latence_apres: Optional[float] = None) -> "ResultatAction":
        """clear(zone=None) -- focus ce Composant, sélectionne tout son
        contenu (Ctrl+A) puis l'efface (Delete). Équivalent haut niveau de
        action_clear. zone : voir click(). retry/timeout/latence_avant/
        latence_apres (secondes) : voir click(). Retourne un
        ResultatAction (voir click())."""
        def _params(resultat_detection):
            cx, cy = point_clic_composant(resultat_detection, self.composant, zone_override=zone)
            return {"x": cx, "y": cy}
        return self._executer_avec_retry("clear", _params, libelle="du clear", retry=retry, timeout=timeout,
                                          latence_avant=latence_avant, latence_apres=latence_apres)

    # ------------------------------------------------------------------
    # dom_paste / dom_clear -- PATCH (demande explicite utilisateur :
    # généraliser Composant.id_dom, "composant.id_dom.paste(), et clear()"
    # -> composant.dom_paste()/dom_clear(), préfixe "dom" choisi pour ne
    # pas entrer en collision avec paste()/clear() juste au-dessus, qui
    # ciblent le composant par CLIC à des coordonnées x,y issues de la
    # détection visuelle -- cf. leurs docstrings). dom_paste/dom_clear ne
    # font AUCUNE détection visuelle et n'ont besoin d'AUCUNE coordonnée :
    # self.composant.id_dom est envoyé tel quel à l'instance comme
    # sélecteur CSS (document.querySelector), cf. action_dom_paste/
    # action_dom_clear côté CDP (moteur Chrome/nodriver) et
    # action_camoufox_dom_paste/action_camoufox_dom_clear côté Camoufox
    # (moteur Firefox) -- les deux moteurs sont câblés, même sélecteur CSS
    # transmis à l'identique quel que soit celui utilisé par l'instance.
    # PAS de paramètre `zone` : un sélecteur DOM ne se restreint
    # pas à une sous-zone d'image comme le fait zone_override sur un clic.
    #
    # Boucle de retry manuelle sur self._moteur._appeler, PAS
    # _executer_avec_retry (qui appelle TOUJOURS _detecter_ou_lever en
    # premier pour obtenir des coordonnées) -- même schéma que
    # ZoneDetectee.paste/.clear un peu plus haut dans ce fichier, pour la
    # même raison : rien à re-détecter visuellement ici, une nouvelle
    # tentative retente exactement le même sélecteur.
    # ------------------------------------------------------------------
    def dom_paste(self, texte: str, selecteur: Optional[str] = None, retry: Optional[int] = None, timeout: Optional[float] = None,
                  latence_avant: Optional[float] = None, latence_apres: Optional[float] = None) -> "ResultatAction":
        """dom_paste(texte, selecteur=None) -- colle EXACTEMENT `texte`
        dans l'élément DOM ciblé, SANS détection visuelle ni clic --
        document.querySelector(...) retrouve l'élément directement dans
        la page, y insère `texte` via le setter natif (compatible champ
        contrôlé React/Vue) puis déclenche input/change. Aucun contact
        avec le presse-papier (ni virtuel ni système), contrairement à
        paste() -- le texte est TOUJOURS fourni explicitement ici, jamais
        de repli implicite sur un copy() précédent.

        selecteur (AJOUT, optionnel, défaut None -- demande explicite
        utilisateur : pouvoir tenter librement plusieurs variantes de
        sélecteur DIRECTEMENT depuis le code de la cellule, sans repasser
        par le panneau de réglages du Composant à chaque essai) : si
        fourni (str non vide), utilisé tel quel à la place de
        self.composant.id_dom pour CET appel uniquement -- accepte le
        même format que id_dom (sélecteur CSS unique, id brut historique,
        ou plusieurs candidats séparés par "||", essayés dans l'ordre par
        _JS_DOM_RESOUDRE_SELECTEUR, cf. action_dom_paste). N'écrit jamais
        dans self.composant.id_dom (ne modifie pas le réglage du
        Composant, valable pour cet appel seulement). Si omis/None/vide,
        comportement inchangé : self.composant.id_dom est utilisé, comme
        avant cet ajout.

        Échec explicite ResultatAction(False, ...) si le sélecteur
        effectif (paramètre ou id_dom) est vide (rien à cibler), si aucun
        élément ne correspond, ou si l'élément trouvé n'est ni un champ
        value (input/textarea) ni contentEditable -- jamais d'exception.
        retry/timeout/latence_avant/latence_apres (secondes) : voir
        click(). Disponible pour une instance Chrome/CDP ET Camoufox (cf.
        action_dom_paste côté CDP, action_camoufox_dom_paste côté
        Camoufox -- même résolution de sélecteur, même contrat de retour,
        sur les deux moteurs)."""
        selecteur_fourni = (selecteur or "").strip()
        id_dom = selecteur_fourni if selecteur_fourni else (self.composant.id_dom or "").strip()
        if not id_dom:
            return ResultatAction(False, f"dom_paste sur « {self.nom} » impossible : ni selecteur fourni en paramètre, ni id_dom renseigné pour ce composant.")
        retry_resolu = retry if retry is not None else self._global_defaut("RETRY", 0)
        timeout_resolu = timeout if timeout is not None else self._global_defaut("TIMEOUT", None)
        latence_avant_resolue = latence_avant if latence_avant is not None else self._global_defaut("LATENCE_AVANT", 0.0)
        latence_apres_resolue = latence_apres if latence_apres is not None else self._global_defaut("LATENCE_APRES", 0.0)
        essais_total = 1 + max(0, retry_resolu)
        derniere_erreur = None
        for _ in range(essais_total):
            params = {"selecteur": id_dom, "texte": texte}
            if latence_avant_resolue:
                time.sleep(latence_avant_resolue)
            reponse = self._moteur._appeler(self.instance_id, "dom_paste", params, timeout=timeout_resolu)
            if latence_apres_resolue:
                time.sleep(latence_apres_resolue)
            if reponse.get("ok"):
                return ResultatAction(True)
            derniere_erreur = reponse.get("error")
        return ResultatAction(False, f"Échec du dom_paste sur « {self.nom} » (id_dom={id_dom!r}, après {essais_total} tentative(s)) : {derniere_erreur}")

    def dom_clear(self, selecteur: Optional[str] = None, retry: Optional[int] = None, timeout: Optional[float] = None,
                  latence_avant: Optional[float] = None, latence_apres: Optional[float] = None) -> "ResultatAction":
        """dom_clear(selecteur=None) -- vide l'élément DOM ciblé, SANS
        détection visuelle ni clic (même résolution de sélecteur que
        dom_paste, cf. sa docstring pour le détail du paramètre
        `selecteur`, AJOUT identique ici : passé tel quel à la place de
        self.composant.id_dom pour CET appel uniquement si fourni,
        accepte un ou plusieurs candidats séparés par "||", n'écrit
        jamais dans id_dom, comportement inchangé si omis/None/vide).

        Échec explicite si le sélecteur effectif (paramètre ou id_dom)
        est vide ou si l'élément est introuvable/non éditable -- jamais
        d'exception. retry/timeout/latence_avant/latence_apres (secondes) :
        voir click(). Chrome/CDP ET Camoufox, comme dom_paste."""
        selecteur_fourni = (selecteur or "").strip()
        id_dom = selecteur_fourni if selecteur_fourni else (self.composant.id_dom or "").strip()
        if not id_dom:
            return ResultatAction(False, f"dom_clear sur « {self.nom} » impossible : ni selecteur fourni en paramètre, ni id_dom renseigné pour ce composant.")
        retry_resolu = retry if retry is not None else self._global_defaut("RETRY", 0)
        timeout_resolu = timeout if timeout is not None else self._global_defaut("TIMEOUT", None)
        latence_avant_resolue = latence_avant if latence_avant is not None else self._global_defaut("LATENCE_AVANT", 0.0)
        latence_apres_resolue = latence_apres if latence_apres is not None else self._global_defaut("LATENCE_APRES", 0.0)
        essais_total = 1 + max(0, retry_resolu)
        derniere_erreur = None
        for _ in range(essais_total):
            params = {"selecteur": id_dom}
            if latence_avant_resolue:
                time.sleep(latence_avant_resolue)
            reponse = self._moteur._appeler(self.instance_id, "dom_clear", params, timeout=timeout_resolu)
            if latence_apres_resolue:
                time.sleep(latence_apres_resolue)
            if reponse.get("ok"):
                return ResultatAction(True)
            derniere_erreur = reponse.get("error")
        return ResultatAction(False, f"Échec du dom_clear sur « {self.nom} » (id_dom={id_dom!r}, après {essais_total} tentative(s)) : {derniere_erreur}")

    def press_key(self, touche: str, zone: Optional[ZoneLike] = None, retry: Optional[int] = None,
                   timeout: Optional[float] = None, latence_avant: Optional[float] = None,
                   latence_apres: Optional[float] = None) -> "ResultatAction":
        """press_key(touche, zone=None) -- focus ce Composant puis envoie
        UNE touche isolée (reclique d'abord à (x, y) côté instance pour
        poser le focus, cf. action_press_key/action_camoufox_press_key,
        même comportement que le canal de pilotage manuel à distance
        _sur_touche_controle_distance -- seule la provenance de la
        commande change, le traitement côté instance est identique).

        touche : une des valeurs autorisées (cf. _TOUCHES_CAMOUFOX_
        AUTORISEES / _TOUCHES_CDP_PAR_NOM) -- "Enter", "Backspace",
        "Control+a". Toute autre valeur est rejetée côté instance
        (ValueError levée par action_press_key/action_camoufox_press_key
        -- remonte comme un échec de ResultatAction, pas une exception
        Python).

        zone : voir click(). retry/timeout/latence_avant/latence_apres
        (secondes) : voir click(). Retourne un ResultatAction (voir
        click()).

        Équivalent haut niveau de action_press_key -- contrairement à
        clear() (toujours Ctrl+A puis Delete, non paramétrable), ici
        c'est une touche unique au choix parmi la liste blanche."""
        def _params(resultat_detection):
            cx, cy = point_clic_composant(resultat_detection, self.composant, zone_override=zone)
            return {"x": cx, "y": cy, "touche": touche}
        return self._executer_avec_retry("press_key", _params, libelle="du press_key", retry=retry, timeout=timeout,
                                          latence_avant=latence_avant, latence_apres=latence_apres)

    def saisir(self, texte: str, zone: Optional[ZoneLike] = None, delai_min_ms: int = 60, delai_max_ms: int = 180,
               retry: Optional[int] = None, timeout: Optional[float] = None,
               latence_avant: Optional[float] = None, latence_apres: Optional[float] = None) -> "ResultatAction":
        """saisir(texte, zone=None) -- saisit le texte caractère par
        caractère sur ce Composant, avec un délai aléatoire entre chaque
        frappe (frappe simulée, pas un collage). Équivalent haut niveau de
        action_type_text (nom d'action réseau inchangé, "type_text" --
        seul le nom exposé côté script Python a changé). zone : voir
        click().

        retry (défaut 0) : nombre de tentatives SUPPLÉMENTAIRES en cas
        d'échec (ex : timeout CDP côté instance) -- entre chaque
        tentative, nouvelle capture d'écran et nouvelle détection du
        Composant. ATTENTION : chaque nouvelle tentative retape le texte
        ENTIER depuis le début sur le même champ (pas de nettoyage
        automatique avant retry) -- si un échec survient après qu'une
        partie du texte a déjà été tapée (ex: timeout dépassé en cours de
        frappe), le texte retapé s'ajoute à la suite du texte déjà
        présent. Avec un texte long et un retry > 0, préférer clear()
        avant chaque tentative si ce risque de duplication est
        problématique pour le champ ciblé.
        timeout (défaut None, EN SECONDES) : délai maximum accordé à
        CETTE tentative pour que la saisie du texte ENTIER se termine
        (transmis à l'instance -- cf. BUG CORRIGÉ ci-dessous -- et utilisé
        aussi pour le timeout réseau côté moteur, avec une marge
        supplémentaire). Si None, calculé automatiquement à partir de la
        longueur du texte et de delai_max_ms (nombre de caractères ×
        delai_max_ms, plus une marge fixe) -- pour qu'un texte long ne
        se fasse jamais couper avant la fin par défaut.
        latence_avant / latence_apres (défaut 0.0, EN SECONDES) : pause
        respectivement juste avant l'envoi de la commande et juste après
        la réponse -- appliquées à CHAQUE tentative.

        Retourne un ResultatAction : r = champ.saisir("texte", retry=3)
        -- if not r: print(r.message) (voir ComposantExecutable.click()
        pour le détail du comportement retry/ResultatAction).

        BUG CORRIGÉ (demande explicite utilisateur -- "je viens de mettre
        a 100 le timeout et sa coupe toujours ... regarde si quand je
        modifie le parametre moi meme sans utiliser la variable sa
        smodifie vraiment, je suis sur que il y a un bug") : saisir()
        résolvait bien son paramètre timeout (pour le délai réseau côté
        moteur, cf. _executer_avec_retry/_appeler), mais ne le
        transmettait JAMAIS à l'instance -- côté instance
        (_boucle_traitement_commandes), TOUTES les actions autres que
        "newTab" utilisaient un timeout interne FIXE de 5.0s, codé en
        dur, complètement indépendant de la valeur passée par
        l'utilisateur à saisir(timeout=...). Un texte assez long pour
        prendre plus de 5s à taper (caractère par caractère, cf.
        delai_min_ms/delai_max_ms) se faisait donc TOUJOURS couper en
        plein milieu par ce timeout interne, peu importe la valeur de
        "timeout" passée par le script -- ce qui déclenchait un retry qui
        RETAPAIT LE TEXTE ENTIER depuis le début SUR LE CHAMP DÉJÀ
        PARTIELLEMENT REMPLI (texte dupliqué en boucle jusqu'à épuisement
        des tentatives). Corrigé en transmettant timeout à l'instance
        sous la clé "timeout_saisie_s" (même schéma que
        "timeout_attente_page_s" pour new_tab, cf. sa docstring), lue par
        la boucle de traitement des commandes au lieu du 5.0 fixe -- cf.
        action == "type_text" dans cette boucle.

        BUG CORRIGÉ (demande explicite utilisateur antérieure :
        "pourquoi je vois saisir ET type_text dans les méthodes, doublon
        inutile, conserve uniquement saisir") : type_text() et saisir()
        coexistaient comme deux méthodes séparées (la seconde n'étant
        qu'un alias direct de la première) -- fusionnées en une seule,
        saisir()."""
        timeout_resolu = timeout if timeout is not None else self._global_defaut("TIMEOUT", None)
        if timeout_resolu is None:
            # Pas de timeout explicite ET pas de TIMEOUT global défini :
            # calcule un délai suffisant pour taper le texte ENTIER même
            # dans le pire cas (chaque caractère au délai max), plus une
            # marge fixe pour l'aller-retour réseau/CDP -- pour que le
            # comportement PAR DÉFAUT (sans rien préciser) ne coupe jamais
            # un texte long à mi-chemin. Cohérent avec le calcul déjà fait
            # pour new_tab (MARGE_RESEAU_ATTENTE_CHARGEMENT_S).
            timeout_resolu = (len(texte) * delai_max_ms / 1000.0) + MARGE_RESEAU_ATTENTE_CHARGEMENT_S
        timeout_appel_pilote_s = timeout_resolu + MARGE_RESEAU_ATTENTE_CHARGEMENT_S

        def _params(resultat_detection):
            cx, cy = point_clic_composant(resultat_detection, self.composant, zone_override=zone)
            return {
                "x": cx, "y": cy, "texte": texte,
                "delai_min_ms": delai_min_ms, "delai_max_ms": delai_max_ms,
                "timeout_saisie_s": timeout_resolu,
            }
        return self._executer_avec_retry("type_text", _params, libelle="de la saisie", retry=retry,
                                          timeout=timeout_appel_pilote_s,
                                          latence_avant=latence_avant, latence_apres=latence_apres)

    # --- glisser-déposer de fichier ---
    def drag(self, chemin_fichier: str, zone: Optional[ZoneLike] = None, retry: Optional[int] = None,
              timeout: Optional[float] = None, latence_avant: Optional[float] = None, latence_apres: Optional[float] = None) -> "ResultatAction":
        """drag(chemin_fichier, zone=None) -- dépose un fichier local (ou
        tout le contenu fichier d'un dossier local) sur ce Composant, via
        DOM.setFileInputFiles côté instance. Équivalent haut niveau de
        action_drag. Alias : drop() (nommage demandé par l'utilisateur).
        zone : voir click(). retry/timeout/latence_avant/latence_apres
        (secondes) : voir click(). Retourne un ResultatAction (voir
        click())."""
        def _params(resultat_detection):
            cx, cy = point_clic_composant(resultat_detection, self.composant, zone_override=zone)
            return {"x": cx, "y": cy, "chemin_fichier": chemin_fichier}
        return self._executer_avec_retry("drag", _params, libelle="du drag", retry=retry, timeout=timeout,
                                          latence_avant=latence_avant, latence_apres=latence_apres)

    def drop(self, chemin_fichier: str, zone: Optional[ZoneLike] = None, retry: Optional[int] = None,
              timeout: Optional[float] = None, latence_avant: Optional[float] = None, latence_apres: Optional[float] = None) -> "ResultatAction":
        """Alias de drag() (nommage utilisé par l'utilisateur dans ses
        exemples de script Task)."""
        return self.drag(chemin_fichier, zone=zone, retry=retry, timeout=timeout,
                          latence_avant=latence_avant, latence_apres=latence_apres)

    # --- capture d'écran de la surface détectée ---
    # AJOUT (demande explicite utilisateur : "je veux aussi que tu
    # rajoute les methode screenshot sil ne sont pas la, qui vaas faire
    # une capture decran de la zone") -- manquait sur
    # ComposantSingleExecutable alors que ZoneDetectee l'avait déjà
    # (asymétrie corrigée ici). Contrairement à ZoneDetectee.screenshot()
    # (rectangle déjà connu, figé au moment de la détection qui a produit
    # l'objet), un Composant doit d'abord être RE-détecté (comme
    # click()/mousemove()/etc. -- sa position peut avoir changé depuis le
    # dernier appel), d'où l'appel à _detecter_ou_lever() ci-dessous
    # (lève ComposantIntrouvableError si absent, même comportement que
    # click()/mousemove() sur composant introuvable -- cohérent, pas de
    # capture "vide" silencieuse).
    def screenshot(self, timeout: Optional[float] = None) -> "Image":
        """screenshot() -- détecte ce Composant puis capture UNIQUEMENT le
        rectangle de sa surface détectée (recadrage après capture_propre
        pleine page, même pattern que ZoneDetectee.screenshot()/
        InstanceExecutable.capture() pour l'écriture disque). Retourne un
        objet Image (cf. sa classe -- porte `.chemin` du PNG déjà écrit ET
        `.image_bgr` déjà en mémoire, `.view()` envoie au terminal réseau)
        -- CHANGEMENT (demande explicite utilisateur : "quand on fait
        screenshot cest cese renvoyer un objet mage qui stoke le path et
        bon limage") : remplace l'ancien retour `str` nu, mais reste
        utilisable comme un chemin par du code existant (cf. __str__/
        __fspath__ d'Image). Lève ComposantIntrouvableError si le
        Composant n'est pas détecté à l'écran."""
        resultat_detection = self._detecter_ou_lever(timeout=timeout)
        timeout_resolu = timeout if timeout is not None else self._global_defaut("TIMEOUT", None)
        params = {"timeout_action_s": timeout_resolu} if timeout_resolu is not None else {}
        reponse = self._moteur._appeler(self.instance_id, "capture_propre", params, timeout=timeout_resolu)
        if not reponse.get("ok"):
            raise RuntimeError(f"Échec de capture pour « {self.nom} » : {reponse.get('error')}")
        image_b64 = reponse.get("result", {}).get("image_b64")
        image = decoder_image_b64(image_b64) if image_b64 else None
        if image is None:
            raise RuntimeError(f"Capture invalide reçue pour « {self.nom} ».")
        image_bgr = qimage_vers_bgr(image)
        x, y = resultat_detection["x"], resultat_detection["y"]
        l, h = resultat_detection["largeur"], resultat_detection["hauteur"]
        h_img, w_img = image_bgr.shape[:2]
        # défensif : recadre le rectangle détecté aux bornes réelles de
        # CETTE capture (même garde que ZoneDetectee.screenshot() -- entre
        # la détection ci-dessus et cette nouvelle capture_propre,
        # l'écran a en théorie pu changer de taille).
        x0, y0 = max(0, min(x, w_img - 1)), max(0, min(y, h_img - 1))
        x1, y1 = max(x0 + 1, min(x + l, w_img)), max(y0 + 1, min(y + h, h_img))
        recadree_bgr = image_bgr[y0:y1, x0:x1]
        nom_fichier = f"{self.instance_id}_{self.nom}_{uuid.uuid4().hex[:8]}.png"
        chemin = get_captures_dir() / nom_fichier
        ok = cv2.imwrite(str(chemin), recadree_bgr)
        if not ok:
            raise RuntimeError(f"Échec d'écriture de la capture sur disque : {chemin}")
        return Image(str(chemin), recadree_bgr, _contexte_reseau=self._contexte_reseau)

    # --- détection de mouvement / OCR sur la surface détectée ---
    # AJOUT (demande explicite utilisateur, cf. _detecter_mouvement_sur_rect/
    # _lire_texte_sur_rect juste au-dessus pour la logique commune) --
    # comme screenshot(), ce Composant doit d'abord être RE-détecté (sa
    # position peut avoir changé depuis le dernier appel).
    def detecter_mouvement(self, duree: float = 1.0, timeout: Optional[float] = None) -> bool:
        """detecter_mouvement(duree=1.0) -- détecte ce Composant puis
        observe sa surface pendant `duree` secondes (EN SECONDES) pour
        savoir si elle est en animation (vidéo en lecture, transition,
        contenu qui défile...). Renvoie un booléen simple : True =
        mouvement détecté, False = surface statique. Lève
        ComposantIntrouvableError si le Composant n'est pas détecté à
        l'écran."""
        if not VISION_DISPONIBLE:
            raise RuntimeError("Détection visuelle indisponible (numpy/cv2 non installés).")
        resultat_detection = self._detecter_ou_lever(timeout=timeout)
        rect_ecran = (resultat_detection["x"], resultat_detection["y"],
                      resultat_detection["largeur"], resultat_detection["hauteur"])
        return _detecter_mouvement_sur_rect(self._moteur, self.instance_id, rect_ecran, duree, timeout, self.nom)

    def lire_texte(self, timeout: Optional[float] = None) -> str:
        """lire_texte() -- détecte ce Composant puis effectue un OCR sur
        sa surface détectée. Renvoie le texte brut reconnu (str, peut être
        vide). Lève ComposantIntrouvableError si le Composant n'est pas
        détecté à l'écran, ou RuntimeError si l'OCR échoue/est
        indisponible (cf. _lire_texte_sur_rect)."""
        resultat_detection = self._detecter_ou_lever(timeout=timeout)
        rect_ecran = (resultat_detection["x"], resultat_detection["y"],
                      resultat_detection["largeur"], resultat_detection["hauteur"])
        return _lire_texte_sur_rect(self._moteur, self.instance_id, rect_ecran, timeout, self.nom)


# ALIAS DE COMPATIBILITÉ -- cf. docstring de ComposantSingleExecutable et
# celui de l'alias Composant = ComposantSingle plus haut dans ce fichier.
ComposantExecutable = ComposantSingleExecutable


# ---------------------------------------------------------------------------
# API Python exposée au script Task pour ComposantLayout (cL) -- SPEC
# section 6. Construite et injectée dans le namespace du Task de la même
# façon que ComposantExecutable (cf. TaskConfigScreen._executer_cellule),
# sous le nom du ComposantLayout (ex: videoTemplateItems).
# ---------------------------------------------------------------------------

class ZoneDetectee:
    """Une Zone nommée, sur une instance de cL déjà détectée à l'écran
    (ex: videoTemplateItems.nom_zone, plat -- SPEC section 6, cf.
    docstring de la dataclass Zone). Rectangle déjà connu (calculé depuis
    englobant_ecran de l'instance + fractions Zone.rect au moment de la
    détection, cf. InstanceLayoutDetectee.__getattr__) : contrairement à
    ComposantSingleExecutable, aucune re-détection réseau à chaque appel,
    juste un calcul de coordonnées écran + appel direct au moteur."""

    def __init__(self, moteur, instance_id: str, rect_ecran: tuple, nom: str, namespace: Optional[dict] = None,
                 _contexte_reseau: Optional[dict] = None):
        # rect_ecran : (x, y, largeur, hauteur) en pixels ÉCRAN ABSOLUS,
        # déjà recadré sur cette Zone précise (cf. InstanceLayoutDetectee.__getattr__).
        self._moteur = moteur
        self.instance_id = instance_id
        self._rect_ecran = rect_ecran
        self.nom = nom
        self._namespace = namespace
        # AJOUT (cf. docstring de ComposantSingleExecutable._contexte_reseau,
        # même mécanisme EXACT) -- propagé depuis InstanceLayoutDetectee.
        # __getattr__ (cf. plus bas), lui-même reçu de
        # ComposantLayoutExecutable.visible()/choose(), même chaîne de
        # propagation que _namespace ci-dessus.
        self._contexte_reseau = _contexte_reseau

    def __repr__(self) -> str:
        return f"ZoneDetectee({self.nom!r})"

    def _global_defaut(self, nom_variable: str, valeur_systeme):
        if self._namespace is None:
            return valeur_systeme
        return self._namespace.get(nom_variable, valeur_systeme)

    def _point_aleatoire(self) -> tuple:
        x, y, l, h = self._rect_ecran
        l, h = max(1, l), max(1, h)
        return x + random.randint(0, l - 1), y + random.randint(0, h - 1)

    def clic(self, bouton: str = "gauche", duree_appui_ms: int = 60, nb_clics: int = 1,
              retry: Optional[int] = None, timeout: Optional[float] = None,
              latence_avant: Optional[float] = None, latence_apres: Optional[float] = None,
              speed_percent: float = 0) -> "ResultatAction":
        """clic() -- même sémantique que ComposantSingleExecutable.click(),
        nommage français conservé tel quel (SPEC section 6 -- décision
        assumée : l'utilisateur écrit explicitement .clic() pour cL, pas
        .click() comme sur cS, choix délibéré à ne pas uniformiser).
        Rectangle FIXE (celui de cette Zone au moment de la détection
        qui a produit cet objet) : aucune re-détection entre deux appels
        successifs sur le même objet -- si l'écran a changé depuis,
        redemander une InstanceLayoutDetectee fraîche via .choose()/.visible()."""
        retry_resolu = retry if retry is not None else self._global_defaut("RETRY", 0)
        timeout_resolu = timeout if timeout is not None else self._global_defaut("TIMEOUT", None)
        latence_avant_resolue = latence_avant if latence_avant is not None else self._global_defaut("LATENCE_AVANT", 0.0)
        latence_apres_resolue = latence_apres if latence_apres is not None else self._global_defaut("LATENCE_APRES", 0.0)
        essais_total = 1 + max(0, retry_resolu)
        derniere_erreur = None
        for _ in range(essais_total):
            cx, cy = self._point_aleatoire()
            params = {"x": cx, "y": cy, "bouton": bouton, "duree_appui_ms": duree_appui_ms,
                      "nb_clics": nb_clics, "speedPercent": speed_percent,
                      "instantane": self._global_defaut("SOURIS_INSTANTANEE", False)}
            if latence_avant_resolue:
                time.sleep(latence_avant_resolue)
            reponse = self._moteur._appeler(self.instance_id, "click", params, timeout=timeout_resolu)
            if latence_apres_resolue:
                time.sleep(latence_apres_resolue)
            if reponse.get("ok"):
                return ResultatAction(True)
            derniere_erreur = reponse.get("error")
        return ResultatAction(False, f"Échec du clic sur « {self.nom} » (après {essais_total} tentative(s)) : {derniere_erreur}")

    def move_mouse(self, retry: Optional[int] = None, timeout: Optional[float] = None,
                    latence_avant: Optional[float] = None, latence_apres: Optional[float] = None,
                    speed_percent: float = 0) -> "ResultatAction":
        """move_mouse() -- équivalent de ComposantSingleExecutable.mousemove,
        déplace le curseur (mouvement humain simulé) jusqu'à un point
        aléatoire du rectangle de cette Zone, sans cliquer."""
        retry_resolu = retry if retry is not None else self._global_defaut("RETRY", 0)
        timeout_resolu = timeout if timeout is not None else self._global_defaut("TIMEOUT", None)
        latence_avant_resolue = latence_avant if latence_avant is not None else self._global_defaut("LATENCE_AVANT", 0.0)
        latence_apres_resolue = latence_apres if latence_apres is not None else self._global_defaut("LATENCE_APRES", 0.0)
        essais_total = 1 + max(0, retry_resolu)
        derniere_erreur = None
        for _ in range(essais_total):
            cx, cy = self._point_aleatoire()
            params = {"x": cx, "y": cy, "speedPercent": speed_percent,
                      "instantane": self._global_defaut("SOURIS_INSTANTANEE", False)}
            if latence_avant_resolue:
                time.sleep(latence_avant_resolue)
            reponse = self._moteur._appeler(self.instance_id, "mousemove", params, timeout=timeout_resolu)
            if latence_apres_resolue:
                time.sleep(latence_apres_resolue)
            if reponse.get("ok"):
                return ResultatAction(True)
            derniere_erreur = reponse.get("error")
        return ResultatAction(False, f"Échec du déplacement sur « {self.nom} » (après {essais_total} tentative(s)) : {derniere_erreur}")

    def screenshot(self, timeout: Optional[float] = None) -> "Image":
        """screenshot() -- capture UNIQUEMENT le rectangle de cette
        Zone (recadrage après capture_propre pleine page, même
        pattern que InstanceExecutable.capture() pour l'écriture disque).
        Retourne un objet Image (cf. sa classe et docstring de
        ComposantSingleExecutable.screenshot() pour le détail du
        changement -- même contrat exact ici)."""
        timeout_resolu = timeout if timeout is not None else self._global_defaut("TIMEOUT", None)
        params = {"timeout_action_s": timeout_resolu} if timeout_resolu is not None else {}
        reponse = self._moteur._appeler(self.instance_id, "capture_propre", params, timeout=timeout_resolu)
        if not reponse.get("ok"):
            raise RuntimeError(f"Échec de capture pour « {self.nom} » : {reponse.get('error')}")
        image_b64 = reponse.get("result", {}).get("image_b64")
        image = decoder_image_b64(image_b64) if image_b64 else None
        if image is None:
            raise RuntimeError(f"Capture invalide reçue pour « {self.nom} ».")
        image_bgr = qimage_vers_bgr(image)
        x, y, l, h = self._rect_ecran
        h_img, w_img = image_bgr.shape[:2]
        # défensif : recadre le rectangle demandé aux bornes réelles de
        # l'image capturée (l'écran peut avoir changé de taille depuis la
        # détection qui a produit ce rectangle -- éviter un crash cv2/numpy
        # plutôt qu'une capture pertinente dans ce cas limite).
        x0, y0 = max(0, min(x, w_img - 1)), max(0, min(y, h_img - 1))
        x1, y1 = max(x0 + 1, min(x + l, w_img)), max(y0 + 1, min(y + h, h_img))
        recadree_bgr = image_bgr[y0:y1, x0:x1]
        nom_fichier = f"{self.instance_id}_{self.nom}_{uuid.uuid4().hex[:8]}.png"
        chemin = get_captures_dir() / nom_fichier
        ok = cv2.imwrite(str(chemin), recadree_bgr)
        if not ok:
            raise RuntimeError(f"Échec d'écriture de la capture sur disque : {chemin}")
        return Image(str(chemin), recadree_bgr, _contexte_reseau=self._contexte_reseau)

    # ------------------------------------------------------------------
    # PARITÉ AVEC ComposantSingleExecutable (demande explicite
    # utilisateur : "chaque zone doit avoir les meme methode que un
    # composantSingle") -- move_cursor/scroll/paste/clear/saisir/drag/drop
    # manquaient encore sur ZoneDetectee (seuls clic/move_mouse/screenshot
    # existaient). Même schéma retry/timeout/latence_avant/latence_apres
    # que clic()/move_mouse() ci-dessus (boucle manuelle sur
    # self._moteur._appeler, PAS _executer_avec_retry qui appartient à
    # ComposantSingleExecutable et re-détecte via _detecter_ou_lever à
    # chaque tentative -- une Zone n'a rien à re-détecter, son rectangle
    # est déjà figé au moment de la détection qui a produit cet objet,
    # cf. docstring de la classe) -- nouvelle capture d'écran donc
    # SANS OBJET ici, contrairement à ComposantSingleExecutable : chaque
    # tentative retente exactement le même point (self._point_aleatoire()
    # à chaque essai, comme clic()/move_mouse()), pas une nouvelle
    # recherche visuelle.
    # ------------------------------------------------------------------
    def move_cursor(self, retry: Optional[int] = None, timeout: Optional[float] = None,
                     latence_avant: Optional[float] = None, latence_apres: Optional[float] = None) -> "ResultatAction":
        """move_cursor() -- équivalent de ComposantSingleExecutable.
        move_cursor : déplace le curseur VIRTUEL seulement (aucun
        événement souris réel envoyé) jusqu'à un point aléatoire du
        rectangle de cette Zone. Pas de speed_percent (même raison que
        ComposantSingleExecutable.move_cursor : un seul événement
        moveCursor sans trajectoire à cadencer)."""
        retry_resolu = retry if retry is not None else self._global_defaut("RETRY", 0)
        timeout_resolu = timeout if timeout is not None else self._global_defaut("TIMEOUT", None)
        latence_avant_resolue = latence_avant if latence_avant is not None else self._global_defaut("LATENCE_AVANT", 0.0)
        latence_apres_resolue = latence_apres if latence_apres is not None else self._global_defaut("LATENCE_APRES", 0.0)
        essais_total = 1 + max(0, retry_resolu)
        derniere_erreur = None
        for _ in range(essais_total):
            cx, cy = self._point_aleatoire()
            params = {"x": cx, "y": cy}
            if latence_avant_resolue:
                time.sleep(latence_avant_resolue)
            reponse = self._moteur._appeler(self.instance_id, "moveCursor", params, timeout=timeout_resolu)
            if latence_apres_resolue:
                time.sleep(latence_apres_resolue)
            if reponse.get("ok"):
                return ResultatAction(True)
            derniere_erreur = reponse.get("error")
        return ResultatAction(False, f"Échec de move_cursor sur « {self.nom} » (après {essais_total} tentative(s)) : {derniere_erreur}")

    def scroll(self, delta_x: float = 0.0, delta_y: float = 0.0, retry: Optional[int] = None,
               timeout: Optional[float] = None, latence_avant: Optional[float] = None,
               latence_apres: Optional[float] = None, speed_percent: float = 0) -> "ResultatAction":
        """scroll() -- équivalent de ComposantSingleExecutable.scroll :
        défilement HUMANISÉ depuis un point aléatoire de cette Zone.
        delta_x/delta_y : quantité TOTALE à scroller (voir
        ComposantSingleExecutable.scroll). speed_percent (même sémantique
        que partout ailleurs dans ce fichier -- AJOUT demande explicite
        utilisateur "je veux vraiment pouvoir controller la vitteessse
        dexecution dun scroll") : 0 = vitesse normale, positif = plus
        rapide, négatif = plus lent."""
        retry_resolu = retry if retry is not None else self._global_defaut("RETRY", 0)
        timeout_resolu = timeout if timeout is not None else self._global_defaut("TIMEOUT", None)
        latence_avant_resolue = latence_avant if latence_avant is not None else self._global_defaut("LATENCE_AVANT", 0.0)
        latence_apres_resolue = latence_apres if latence_apres is not None else self._global_defaut("LATENCE_APRES", 0.0)
        essais_total = 1 + max(0, retry_resolu)
        derniere_erreur = None
        for _ in range(essais_total):
            cx, cy = self._point_aleatoire()
            params = {"x": cx, "y": cy, "targetDeltaX": delta_x, "targetDeltaY": delta_y, "speedPercent": speed_percent}
            if latence_avant_resolue:
                time.sleep(latence_avant_resolue)
            reponse = self._moteur._appeler(self.instance_id, "scroll", params, timeout=timeout_resolu)
            if latence_apres_resolue:
                time.sleep(latence_apres_resolue)
            if reponse.get("ok"):
                return ResultatAction(True)
            derniere_erreur = reponse.get("error")
        return ResultatAction(False, f"Échec du scroll sur « {self.nom} » (après {essais_total} tentative(s)) : {derniere_erreur}")

    def paste(self, texte: Optional[str] = None, retry: Optional[int] = None, timeout: Optional[float] = None,
              latence_avant: Optional[float] = None, latence_apres: Optional[float] = None) -> "ResultatAction":
        """paste(texte=None) -- équivalent de ComposantSingleExecutable.
        paste : focus cette Zone puis colle du texte dedans. texte fourni
        = colle exactement ce texte ; omis = colle le presse-papier
        virtuel de l'instance (voir ComposantSingleExecutable.paste)."""
        retry_resolu = retry if retry is not None else self._global_defaut("RETRY", 0)
        timeout_resolu = timeout if timeout is not None else self._global_defaut("TIMEOUT", None)
        latence_avant_resolue = latence_avant if latence_avant is not None else self._global_defaut("LATENCE_AVANT", 0.0)
        latence_apres_resolue = latence_apres if latence_apres is not None else self._global_defaut("LATENCE_APRES", 0.0)
        essais_total = 1 + max(0, retry_resolu)
        derniere_erreur = None
        for _ in range(essais_total):
            cx, cy = self._point_aleatoire()
            params = {"x": cx, "y": cy}
            if texte is not None:
                params["texte"] = texte
            if latence_avant_resolue:
                time.sleep(latence_avant_resolue)
            reponse = self._moteur._appeler(self.instance_id, "paste", params, timeout=timeout_resolu)
            if latence_apres_resolue:
                time.sleep(latence_apres_resolue)
            if reponse.get("ok"):
                return ResultatAction(True)
            derniere_erreur = reponse.get("error")
        return ResultatAction(False, f"Échec du paste sur « {self.nom} » (après {essais_total} tentative(s)) : {derniere_erreur}")

    def clear(self, retry: Optional[int] = None, timeout: Optional[float] = None,
              latence_avant: Optional[float] = None, latence_apres: Optional[float] = None) -> "ResultatAction":
        """clear() -- équivalent de ComposantSingleExecutable.clear :
        focus cette Zone, sélectionne tout (Ctrl+A) puis efface (Delete)."""
        retry_resolu = retry if retry is not None else self._global_defaut("RETRY", 0)
        timeout_resolu = timeout if timeout is not None else self._global_defaut("TIMEOUT", None)
        latence_avant_resolue = latence_avant if latence_avant is not None else self._global_defaut("LATENCE_AVANT", 0.0)
        latence_apres_resolue = latence_apres if latence_apres is not None else self._global_defaut("LATENCE_APRES", 0.0)
        essais_total = 1 + max(0, retry_resolu)
        derniere_erreur = None
        for _ in range(essais_total):
            cx, cy = self._point_aleatoire()
            params = {"x": cx, "y": cy}
            if latence_avant_resolue:
                time.sleep(latence_avant_resolue)
            reponse = self._moteur._appeler(self.instance_id, "clear", params, timeout=timeout_resolu)
            if latence_apres_resolue:
                time.sleep(latence_apres_resolue)
            if reponse.get("ok"):
                return ResultatAction(True)
            derniere_erreur = reponse.get("error")
        return ResultatAction(False, f"Échec du clear sur « {self.nom} » (après {essais_total} tentative(s)) : {derniere_erreur}")

    def press_key(self, touche: str, retry: Optional[int] = None, timeout: Optional[float] = None,
                   latence_avant: Optional[float] = None, latence_apres: Optional[float] = None) -> "ResultatAction":
        """press_key(touche) -- équivalent de ComposantSingleExecutable.
        press_key : focus cette Zone puis envoie UNE touche isolée parmi
        la liste blanche ("Enter", "Backspace", "Control+a" -- cf.
        _TOUCHES_CAMOUFOX_AUTORISEES/_TOUCHES_CDP_PAR_NOM). Toute autre
        valeur est rejetée côté instance (remonte comme un échec de
        ResultatAction)."""
        retry_resolu = retry if retry is not None else self._global_defaut("RETRY", 0)
        timeout_resolu = timeout if timeout is not None else self._global_defaut("TIMEOUT", None)
        latence_avant_resolue = latence_avant if latence_avant is not None else self._global_defaut("LATENCE_AVANT", 0.0)
        latence_apres_resolue = latence_apres if latence_apres is not None else self._global_defaut("LATENCE_APRES", 0.0)
        essais_total = 1 + max(0, retry_resolu)
        derniere_erreur = None
        for _ in range(essais_total):
            cx, cy = self._point_aleatoire()
            params = {"x": cx, "y": cy, "touche": touche}
            if latence_avant_resolue:
                time.sleep(latence_avant_resolue)
            reponse = self._moteur._appeler(self.instance_id, "press_key", params, timeout=timeout_resolu)
            if latence_apres_resolue:
                time.sleep(latence_apres_resolue)
            if reponse.get("ok"):
                return ResultatAction(True)
            derniere_erreur = reponse.get("error")
        return ResultatAction(False, f"Échec du press_key sur « {self.nom} » (après {essais_total} tentative(s)) : {derniere_erreur}")

    def saisir(self, texte: str, delai_min_ms: int = 60, delai_max_ms: int = 180, retry: Optional[int] = None,
               timeout: Optional[float] = None, latence_avant: Optional[float] = None,
               latence_apres: Optional[float] = None) -> "ResultatAction":
        """saisir(texte) -- équivalent de ComposantSingleExecutable.saisir :
        saisit le texte caractère par caractère sur cette Zone, avec un
        délai aléatoire entre chaque frappe (voir
        ComposantSingleExecutable.saisir pour le détail du calcul de
        timeout par défaut)."""
        retry_resolu = retry if retry is not None else self._global_defaut("RETRY", 0)
        timeout_resolu = timeout if timeout is not None else self._global_defaut("TIMEOUT", None)
        if timeout_resolu is None:
            timeout_resolu = (len(texte) * delai_max_ms / 1000.0) + MARGE_RESEAU_ATTENTE_CHARGEMENT_S
        timeout_appel_pilote_s = timeout_resolu + MARGE_RESEAU_ATTENTE_CHARGEMENT_S
        latence_avant_resolue = latence_avant if latence_avant is not None else self._global_defaut("LATENCE_AVANT", 0.0)
        latence_apres_resolue = latence_apres if latence_apres is not None else self._global_defaut("LATENCE_APRES", 0.0)
        essais_total = 1 + max(0, retry_resolu)
        derniere_erreur = None
        for _ in range(essais_total):
            cx, cy = self._point_aleatoire()
            params = {"x": cx, "y": cy, "texte": texte, "delai_min_ms": delai_min_ms,
                      "delai_max_ms": delai_max_ms, "timeout_saisie_s": timeout_resolu}
            if latence_avant_resolue:
                time.sleep(latence_avant_resolue)
            reponse = self._moteur._appeler(self.instance_id, "type_text", params, timeout=timeout_appel_pilote_s)
            if latence_apres_resolue:
                time.sleep(latence_apres_resolue)
            if reponse.get("ok"):
                return ResultatAction(True)
            derniere_erreur = reponse.get("error")
        return ResultatAction(False, f"Échec de la saisie sur « {self.nom} » (après {essais_total} tentative(s)) : {derniere_erreur}")

    def drag(self, chemin_fichier: str, retry: Optional[int] = None, timeout: Optional[float] = None,
              latence_avant: Optional[float] = None, latence_apres: Optional[float] = None) -> "ResultatAction":
        """drag(chemin_fichier) -- équivalent de
        ComposantSingleExecutable.drag : dépose un fichier local sur
        cette Zone. Alias : drop()."""
        retry_resolu = retry if retry is not None else self._global_defaut("RETRY", 0)
        timeout_resolu = timeout if timeout is not None else self._global_defaut("TIMEOUT", None)
        latence_avant_resolue = latence_avant if latence_avant is not None else self._global_defaut("LATENCE_AVANT", 0.0)
        latence_apres_resolue = latence_apres if latence_apres is not None else self._global_defaut("LATENCE_APRES", 0.0)
        essais_total = 1 + max(0, retry_resolu)
        derniere_erreur = None
        for _ in range(essais_total):
            cx, cy = self._point_aleatoire()
            params = {"x": cx, "y": cy, "chemin_fichier": chemin_fichier}
            if latence_avant_resolue:
                time.sleep(latence_avant_resolue)
            reponse = self._moteur._appeler(self.instance_id, "drag", params, timeout=timeout_resolu)
            if latence_apres_resolue:
                time.sleep(latence_apres_resolue)
            if reponse.get("ok"):
                return ResultatAction(True)
            derniere_erreur = reponse.get("error")
        return ResultatAction(False, f"Échec du drag sur « {self.nom} » (après {essais_total} tentative(s)) : {derniere_erreur}")

    def drop(self, chemin_fichier: str, retry: Optional[int] = None, timeout: Optional[float] = None,
              latence_avant: Optional[float] = None, latence_apres: Optional[float] = None) -> "ResultatAction":
        """Alias de drag() (même convention que ComposantSingleExecutable.drop)."""
        return self.drag(chemin_fichier, retry=retry, timeout=timeout,
                          latence_avant=latence_avant, latence_apres=latence_apres)

    # --- détection de mouvement / OCR sur la surface de cette Zone ---
    # AJOUT (demande explicite utilisateur, cf. _detecter_mouvement_sur_rect/
    # _lire_texte_sur_rect définies plus haut dans ce fichier, juste avant
    # ComposantSingleExecutable, pour la logique commune factorisée) --
    # contrairement à ComposantSingleExecutable, PAS de re-détection ici :
    # self._rect_ecran est déjà figé au moment de la détection qui a
    # produit cet objet (même raisonnement que clic()/move_mouse()/
    # screenshot() ci-dessus sur cette même classe).
    def detecter_mouvement(self, duree: float = 1.0, timeout: Optional[float] = None) -> bool:
        """detecter_mouvement(duree=1.0) -- observe la surface de cette
        Zone pendant `duree` secondes (EN SECONDES) pour savoir si elle
        est en animation. Renvoie un booléen simple : True = mouvement
        détecté, False = surface statique."""
        if not VISION_DISPONIBLE:
            raise RuntimeError("Détection visuelle indisponible (numpy/cv2 non installés).")
        timeout_resolu = timeout if timeout is not None else self._global_defaut("TIMEOUT", None)
        return _detecter_mouvement_sur_rect(self._moteur, self.instance_id, self._rect_ecran, duree,
                                             timeout_resolu, self.nom)

    def lire_texte(self, timeout: Optional[float] = None) -> str:
        """lire_texte() -- OCR sur la surface de cette Zone. Renvoie le
        texte brut reconnu (str, peut être vide)."""
        timeout_resolu = timeout if timeout is not None else self._global_defaut("TIMEOUT", None)
        return _lire_texte_sur_rect(self._moteur, self.instance_id, self._rect_ecran, timeout_resolu, self.nom)


class InstanceLayoutDetectee:
    """Résultat d'une détection de ComposantLayout à un instant donné
    (SPEC section 6) -- objet NON réutilisable après une nouvelle
    détection (même principe que le reste du fichier : _detecter() de cS
    ne cache jamais rien, chaque appel reflète l'état actuel de l'écran).

    FUSION (demande explicite : "forme et zone sont en fait la même
    chose ... on va éliminer la notion de forme, et conserver zone") --
    expose un attribut dynamique PLAT par zone nommée renvoyée par
    code_filtre (ex: videoTemplateItems.nom_zone) -- REFONTE (cf.
    SPEC_refonte_filtre_zones_dynamiques.md) : ces zones sont désormais
    exclusivement les zones DYNAMIQUES nommées par le filtre lui-même
    (variable `zones` en sortie de executer_filtre_layout), plus aucun
    matching structurel contre un gabarit de Zone statiques figées."""

    def __init__(self, moteur, instance_id: str, englobant_ecran: tuple, zones_detectees: dict,
                 namespace: Optional[dict] = None, _contexte_reseau: Optional[dict] = None):
        # englobant_ecran : rectangle (x,y,l,h) écran absolu de l'instance
        # entière détectée. zones_detectees : {nom_zone: (x,y,l,h) écran
        # absolu} -- rectangle de CHAQUE zone nommée par code_filtre,
        # calculé une seule fois par ComposantLayoutExecutable.visible()
        # (rect relatif à la carte renvoyé par le filtre, repositionné en
        # absolu -- cf. detecter_toutes_instances_composant_layout_sur_page).
        self._moteur = moteur
        self.instance_id = instance_id
        self.englobant_ecran = englobant_ecran
        self._zones_detectees = zones_detectees
        self._namespace = namespace
        # AJOUT (cf. docstring de ComposantSingleExecutable._contexte_reseau)
        # -- reçu de ComposantLayoutExecutable.visible(), retransmis à
        # chaque ZoneDetectee construite par __getattr__ ci-dessous, même
        # chaîne de propagation que _namespace.
        self._contexte_reseau = _contexte_reseau

    def __repr__(self) -> str:
        return f"InstanceLayoutDetectee(zones={sorted(self._zones_detectees.keys())})"

    def __getattr__(self, nom_attr: str):
        rect_ecran = self._zones_detectees.get(nom_attr)
        if rect_ecran is not None:
            return ZoneDetectee(
                self._moteur, self.instance_id, rect_ecran, nom_attr,
                namespace=self._namespace, _contexte_reseau=self._contexte_reseau,
            )
        raise AttributeError(
            f"« {nom_attr} » n'est pas une Zone détectée sur cette instance "
            f"(zones disponibles : {sorted(self._zones_detectees.keys())})."
        )


class ComposantLayoutExecutable:
    """Wrapper d'exécution autour d'un ComposantLayout, injecté dans le
    namespace du Task sous le nom du ComposantLayout (ex:
    videoTemplateItems) -- SPEC section 6, symétrique de
    ComposantSingleExecutable pour ComposantSingle."""

    def __init__(self, composant_layout: "ComposantLayout", moteur, instance_id: str, namespace: Optional[dict] = None,
                 _contexte_reseau: Optional[dict] = None):
        self.composant_layout = composant_layout
        self._moteur = moteur
        self.instance_id = instance_id
        self._namespace = namespace
        # AJOUT (cf. docstring de ComposantSingleExecutable._contexte_reseau)
        # -- reçu de _construire_composants_direct à la construction,
        # retransmis à chaque InstanceLayoutDetectee par visible()
        # ci-dessous, même chaîne de propagation que _namespace.
        self._contexte_reseau = _contexte_reseau

    def __repr__(self) -> str:
        return f"ComposantLayoutExecutable({self.composant_layout.nom!r})"

    def _global_defaut(self, nom_variable: str, valeur_systeme):
        if self._namespace is None:
            return valeur_systeme
        return self._namespace.get(nom_variable, valeur_systeme)

    def visible(self, timeout: Optional[float] = None, freq: Optional[float] = None,
                stabilite: float = 0.0) -> list:
        """visible() -- retourne la liste des InstanceLayoutDetectee
        actuellement présentes à l'écran (peut être vide). Contrairement à
        ComposantSingleExecutable.visible() -> bool, un cL peut apparaître
        plusieurs fois simultanément (ex: grille de vidéos, SPEC section 6).
        Capture dédiée à chaque appel, aucun cache.

        freq (défaut None -- AJOUT, demande explicite utilisateur, même
        principe que ComposantSingleExecutable.visible(timeout, freq) mais
        adapté à une LISTE plutôt qu'un bool) : quand freq est fourni
        (freq > 0), `timeout` devient la DURÉE TOTALE de polling -- une
        nouvelle détection est retentée toutes les `freq` secondes.
        DIFFÉRENCE avec le Composant simple (demande explicite
        utilisateur : "comme il yen a potentiellement plusieurs à
        l'écran, ça peut continuer à se charger" -- ex: une grille de
        vidéos qui charge ses cartes progressivement) : on ne s'arrête
        PAS dès la première liste non vide, on attend que le NOMBRE
        d'occurrences détectées SE STABILISE avant de retourner --
        capture la liste complète une fois le chargement terminé, pas un
        instantané partiel pris en plein chargement. Si le timeout
        expire avant toute stabilisation, retourne la DERNIÈRE liste
        obtenue (peut être vide, ou une liste jamais confirmée stable --
        mieux que de perdre ce qui a été détecté). CHAQUE détection
        individuelle de cette boucle utilise son propre timeout réseau
        COURT (`freq`, borné au temps restant), même principe que le
        Composant simple. Toute exception levée par une détection
        individuelle (échec réseau, scindement, filtre -- cf. plus bas)
        est absorbée : cette itération compte comme "liste vide" et le
        polling continue, jamais de plantage sur un aléa transitoire.

        stabilite (défaut 0.0, EN SECONDES -- AJOUT, demande explicite
        utilisateur : "spécifier nous même la durée [pendant laquelle]
        2 moment de vérification [ont] le résultat identique avant
        d'avancer" -- précisée ensuite comme une DURÉE d'horloge murale,
        pas un nombre d'itérations : "il faut que ça n'ait pas changé
        depuis au moins X secondes, quel que soit le nombre d'itérations
        que ça représente vu freq") : le nombre d'occurrences détecté
        doit être resté IDENTIQUE pendant au moins `stabilite` secondes
        consécutives (compté depuis la PREMIÈRE détection ayant donné ce
        nombre, pas depuis la dernière) avant que visible() ne retourne.
        Défaut 0.0 (INCHANGÉ par rapport au comportement introduit
        juste avant cet ajout) : la toute première confirmation
        identique (deux détections consécutives au même nombre non-nul,
        peu importe l'écart de temps entre elles vu freq) suffit à
        considérer que c'est stable. stabilite=4 avec freq=1, par
        exemple, exige que le nombre n'ait pas bougé pendant 4 secondes
        pleines (donc ~4-5 détections consécutives identiques), pas
        seulement 2 -- utile si le chargement de la page est lent/
        irrégulier et que 2 détections rapprochées ne suffisent pas à
        garantir que tout est vraiment arrivé. N'a aucun effet sans freq
        (mode sans freq : une seule détection, rien à stabiliser).

        Sans freq (comportement historique, INCHANGÉ) : une seule
        détection, timeout = délai réseau de CETTE capture unique."""
        def _detecter_liste(timeout_detection: Optional[float]) -> list:
            if not VISION_DISPONIBLE:
                raise RuntimeError("Détection visuelle indisponible (numpy/cv2 non installés).")
            cl = self.composant_layout
            params = {"timeout_action_s": timeout_detection} if timeout_detection is not None else {}
            reponse = self._moteur._appeler(self.instance_id, "capture_propre", params, timeout=timeout_detection)
            if not reponse.get("ok"):
                raise RuntimeError(f"Échec de capture pour « {cl.nom} » : {reponse.get('error')}")
            image_b64 = reponse.get("result", {}).get("image_b64")
            image = decoder_image_b64(image_b64) if image_b64 else None
            if image is None:
                raise RuntimeError(f"Capture invalide reçue pour « {cl.nom} ».")
            image_bgr = qimage_vers_bgr(image)

            # MODIFIÉ (demande explicite utilisateur : code_scindement +
            # code_filtre sont TOUS LES DEUX utilisés en production, pas
            # seulement le filtre seul) -- la capture reçue ici (image_bgr)
            # est désormais la PAGE ENTIÈRE, jamais une carte déjà cadrée :
            # detecter_toutes_instances_composant_layout_sur_page se charge
            # d'abord du scindement (code_scindement, propre à ce cL) puis,
            # pour chaque carte candidate trouvée, du filtre (code_filtre) --
            # REFONTE (cf. SPEC_refonte_filtre_zones_dynamiques.md) : plus de
            # zones_gabarit/seuil_confiance/delta_conflit/distance_max_
            # regroupement_px à transmettre, le filtre nomme et valide
            # lui-même chaque zone, il n'y a plus de gabarit statique à
            # matcher côté système.
            try:
                instances_brutes = detecter_toutes_instances_composant_layout_sur_page(
                    image_bgr, cl.code_scindement, cl.code_filtre,
                )
            except DetectionScindementError as e:
                raise RuntimeError(f"Erreur du scindement de page pour « {cl.nom} » : {e}")
            except DetectionLayoutError as e:
                raise RuntimeError(f"Erreur du filtre de détection pour « {cl.nom} » : {e}")

            resultats = []
            for inst in instances_brutes:
                zones_detectees = {nom: rect for nom, rect in inst["zones"].items()}
                resultats.append(InstanceLayoutDetectee(
                    self._moteur, self.instance_id, inst["englobant"], zones_detectees,
                    namespace=self._namespace, _contexte_reseau=self._contexte_reseau,
                ))
            return resultats

        if freq is not None and freq > 0:
            duree_totale = timeout if timeout is not None else self._global_defaut("TIMEOUT", None)
            if duree_totale is None:
                # Pas de budget total connu -- retombe sur une détection
                # unique plutôt que d'boucler sans jamais s'arrêter (même
                # principe que ComposantSingleExecutable.visible()).
                timeout_unique = timeout if timeout is not None else self._global_defaut("TIMEOUT", None)
                return _detecter_liste(timeout_unique)
            debut_polling = _horloge()
            derniere_liste: list = []
            nb_precedent: Optional[int] = None
            # AJOUT (stabilite) -- horodatage de la PREMIÈRE détection ayant
            # donné le nombre d'occurrences actuellement "en cours de
            # stabilisation" (nb_precedent) ; réinitialisé à chaque fois que
            # ce nombre change. None tant qu'aucun nombre non-nul n'a encore
            # été vu.
            debut_stabilite: Optional[float] = None
            while True:
                temps_restant = duree_totale - (_horloge() - debut_polling)
                if temps_restant <= 0:
                    return derniere_liste
                # CORRECTIF (même demande explicite utilisateur que
                # ComposantSingleExecutable.visible() ci-dessus -- "freq ne
                # sert qu'à compter le temps entre une détection et la
                # prochaine détection", PAS un timeout réseau) : la détection
                # utilise désormais tout temps_restant, jamais borné par
                # freq -- freq ne sert plus qu'au calcul de la pause
                # ci-dessous, entre le DÉBUT de cette itération et le DÉBUT
                # de la suivante.
                debut_iteration = _horloge()
                try:
                    liste_courante = _detecter_liste(temps_restant)
                except RuntimeError as e:
                    log_detection.info(
                        f"[{self.composant_layout.nom}] visible(freq=...) : exception absorbée "
                        f"pendant le polling -- {e}"
                    )
                    liste_courante = []
                derniere_liste = liste_courante
                nb_courant = len(liste_courante)
                maintenant = _horloge()
                if nb_courant > 0 and nb_courant == nb_precedent:
                    # Toujours le même nombre non-nul qu'à l'itération
                    # précédente -- debut_stabilite reste celui posé à la
                    # PREMIÈRE détection de ce nombre (pas remis à jour ici),
                    # pour mesurer la durée TOTALE de stabilité, pas juste
                    # l'écart entre les deux dernières détections.
                    if maintenant - debut_stabilite >= stabilite:
                        return liste_courante
                else:
                    # Nombre différent de l'itération précédente (ou premier
                    # nombre non-nul rencontré) -- redémarre le chronomètre
                    # de stabilité à partir de MAINTENANT.
                    nb_precedent = nb_courant
                    debut_stabilite = maintenant if nb_courant > 0 else None
                temps_ecoule = _horloge() - debut_polling
                if temps_ecoule >= duree_totale:
                    return derniere_liste
                # CORRECTIF (même demande) : pause = temps RESTANT jusqu'à la
                # prochaine échéance de fréquence désirée -- jamais une pause
                # complète de freq rajoutée par-dessus une itération qui a
                # déjà duré >= freq (pause=0 dans ce cas, relance immédiate).
                duree_iteration = _horloge() - debut_iteration
                pause = max(0.0, freq - duree_iteration)
                pause = min(pause, duree_totale - temps_ecoule)
                if pause > 0:
                    time.sleep(pause)
        timeout_resolu = timeout if timeout is not None else self._global_defaut("TIMEOUT", None)
        return _detecter_liste(timeout_resolu)

    def choose(self, mode: str = "random", timeout: Optional[float] = None) -> Optional["InstanceLayoutDetectee"]:
        """choose(mode="random") -- appelle visible() puis choisit une
        instance parmi celles détectées. SEUL mode="random" est implémenté
        (SPEC section 6 -- décision assumée : signature acceptant mode pour
        rester extensible sans casser l'API plus tard, mais ne PAS
        construire d'autres modes par anticipation). None si aucune
        instance détectée."""
        instances = self.visible(timeout=timeout)
        if not instances:
            return None
        if mode != "random":
            raise NotImplementedError(f"choose(mode={mode!r}) : seul mode='random' est implémenté actuellement.")
        return random.choice(instances)


def get_captures_dir() -> Path:
    """Dossier des images produites par InstanceExecutable.capture()
    (créé si absent) : D:\\ScaleTube\\...\\Data\\projet\\captures\\ -- séparé
    de components\\ (cf. get_components_dir), qui lui ne contient que les
    images de référence des Composants, jamais des captures ponctuelles
    prises en cours d'exécution d'un Task."""
    d = get_app_data_dir() / "captures"
    d.mkdir(parents=True, exist_ok=True)
    return d


def get_captures_clone_dir() -> Path:
    """SPEC_mode_execution_clone.md, section 5.3 -- dossier racine des
    jeux de captures "capturer tout" du mode clone :
    D:\\ScaleTube\\...\\Data\\projet\\captures_clone\\ -- DÉLIBÉRÉMENT séparé
    de get_captures_dir() (captures\\), qui lui est vidé automatiquement
    au démarrage par vider_captures_dir() : les captures clone sont une
    collecte de données volontaire de l'utilisateur (cf. spec section
    5.5, "collecte de données à grande échelle"), jamais du jetable --
    vider_captures_dir() ne doit JAMAIS toucher ce dossier."""
    d = get_app_data_dir() / "captures_clone"
    d.mkdir(parents=True, exist_ok=True)
    return d


def vider_captures_dir() -> None:
    """PATCH demandé par l'utilisateur : vide le contenu de
    D:\\ScaleTube\\...\\Data\\projet\\captures\\ (cf. get_captures_dir) --
    appelé une seule fois, au démarrage de l'application (cf. main()), pour
    éviter une saturation disque au fil des sessions : capture() (cf.
    InstanceExecutable.capture()) écrit un nouveau PNG à CHAQUE appel,
    horodaté par un uuid4 -- rien ne les supprime jamais spontanément
    côté script, ils s'accumulent indéfiniment sans ce nettoyage.

    Relatif au compte utilisateur courant (cf. get_app_data_dir ->
    Path.home(), qui résout le profil via les variables d'environnement
    OS -- USERPROFILE sur Windows, HOME sur Linux/macOS) : rien n'est
    codé en dur ici, comme pour le reste des chemins de ce fichier.

    Ne vide QUE captures\\ -- ne touche jamais components\\ (images de
    référence des Composants, cf. get_components_dir/remove_service_api),
    ni project.json/reglages.json au niveau du dossier parent. Supprime le
    CONTENU du dossier (fichiers et sous-dossiers éventuels), pas le
    dossier captures\\ lui-même -- évite d'avoir à le recréer juste après
    (get_captures_dir le fait de toute façon via mkdir(exist_ok=True), un
    rmtree+mkdir serait équivalent mais moins direct).

    Défensif par construction (comme _fermer_onglet_arriere_plan,
    shutil.rmtree(..., ignore_errors=False) ailleurs dans ce fichier
    n'étant utilisé que dans un contexte où l'échec doit remonter) : une
    erreur sur un fichier précis (verrouillé par un antivirus, permissions
    refusées) est journalisée et n'interrompt jamais le démarrage de
    l'application -- un dossier captures\\ non vidé (ou partiellement) ne
    doit jamais empêcher AutoniaX de démarrer."""
    dossier = get_captures_dir()
    for entree in dossier.iterdir():
        try:
            if entree.is_dir():
                shutil.rmtree(entree, ignore_errors=True)
            else:
                entree.unlink()
        except Exception as e:
            log_captures.warning(f"vider_captures_dir() : échec de suppression de {entree!r} (ignoré) -- {e!r}")


def _point_dans_element(el: dict) -> tuple:
    """Point de clic réaliste dans un élément décrit par find_elements : proche
    du centre (loi normale bornée au coeur de l'élément), jamais sur le bord."""
    w = max(1, int(el.get("largeur", 1))); h = max(1, int(el.get("hauteur", 1)))
    dx = max(-0.3 * w, min(0.3 * w, random.gauss(0, 0.12 * w)))
    dy = max(-0.3 * h, min(0.3 * h, random.gauss(0, 0.12 * h)))
    return int(round(el["x"] + dx)), int(round(el["y"] + dy))



