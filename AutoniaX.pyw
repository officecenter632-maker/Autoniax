    /* --- Notebook en lecture seule (onglet "Aperçu d'exécution" de
       ProjetBatchScreen, cf. NotebookExecutionLectureSeule) -- réutilise
       #CelluleTitreLabel/#CelluleSortie ci-dessus tels quels, seuls les
       objectNames propres à ce widget sont définis ici. --- */
    #NotebookExecutionBloc {{
        background-color: {m.surface0};
        border: 1px solid {m.surface1};
        border-radius: {RADIUS}px;
    }}

    /* Cellule jamais atteinte (échec avant la fin, ou pas encore
       démarrée en mode LIVE) -- grisée, sans essayer de faire croire
       qu'il y a du contenu à regarder. */
    #NotebookExecutionBloc[etat="non_atteinte"] {{
        background-color: {m.mantle};
        border: 1px solid {m.surface0};
    }}

    #NotebookExecutionBloc[etat="non_atteinte"] #CelluleTitreLabel,
    #NotebookExecutionBloc[etat="non_atteinte"] #NotebookExecutionBadge {{
        color: {m.overlay0};
    }}

    #NotebookExecutionBloc[etat="en_cours"] {{
        border: 1px solid {m.yellow};
    }}

    #NotebookExecutionBloc[etat="terminee_erreur"] {{
        border: 1px solid {m.red};
    }}

    #NotebookExecutionBadge {{
        color: {m.subtext0};
        font-family: Consolas, monospace;
        font-size: 11px;
    }}

    #NotebookExecutionLabelVide {{
        color: {m.subtext0};
        font-style: italic;
        padding: 24px;
    }}

    /* Bouton chevron plier/déplier le code d'une cellule (cf. RE-PATCH
       "les cellcule doivent etre plier", NotebookExecutionLectureSeule.
       _construire_bloc) -- discret au repos, léger surlignage au survol
       pour rester cliquable sans attirer l'œil plus que le titre. */
    #NotebookExecutionToggleCode {{
        border: none;
        background-color: transparent;
        padding: 2px;
    }}

    #NotebookExecutionToggleCode:hover {{
        background-color: {m.surface1};
        border-radius: {RADIUS}px;
    }}

    /* Capture d'écran de l'instance au moment d'une erreur de cellule
       (cf. _afficher_image_bug) -- cadre léger pour la détacher de la
       zone de sortie texte juste au-dessus, jamais affiché tant qu'il
       n'y a pas d'image (widget caché par défaut, cf. sa docstring). */
    #NotebookExecutionImageBug {{
        border: 1px solid {m.surface1};
        border-radius: {RADIUS}px;
        padding: 4px;
        background-color: {m.mantle};
    }}

    /* --- Popup d'auto-complétion de l'éditeur de script Task --- */
    #AutoCompletionPopup {{
        background-color: {DarculaTheme.fond};
        color: {DarculaTheme.texte};
        border: 1px solid {DarculaTheme.violet};
        border-radius: {RADIUS}px;
        outline: none;
        padding: 4px;
        font-family: "Consolas";
    }}

    #AutoCompletionPopup::item {{
        padding: 5px 8px;
        border-radius: {RADIUS - 2}px;
        color: {DarculaTheme.texte};
    }}

    #AutoCompletionPopup::item:selected {{
        background-color: {DarculaTheme.violet};
        color: #FFFFFF;
    }}

    #AutoCompletionPopup::item:hover {{
        background-color: {DarculaTheme.fond_ligne_courante};
