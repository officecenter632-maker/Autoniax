class AutoniaXTitleBar(QWidget):
    """Barre de titre personnalisée de MainWindow -- sombre + accent violet,
    cohérente avec la palette Mocha du reste de l'app (mauve/lavender sur
    fond mantle/crust). Remplace la barre de titre native Windows via
    Qt.FramelessWindowHint (cf. MainWindow.__init__) : icône + titre à
    gauche, boutons minimiser/agrandir/fermer à droite, drag de la fenêtre
    en cliquant n'importe où sur la barre, double-clic pour agrandir/
    restaurer -- comportement standard attendu d'une barre de titre."""

    HEIGHT = 36

    def __init__(self, parent=None):
        super().__init__(parent)
        self.setObjectName("AutoniaXTitleBar")
        self.setFixedHeight(self.HEIGHT)
        self._drag_pos = None
        self._maximized = False
        self._setup()

    def _setup(self):
        m = Mocha
        lay = QHBoxLayout(self)
        lay.setContentsMargins(10, 0, 6, 0)
        lay.setSpacing(8)

        # Icône
        self._icon_lbl = QLabel(self)
        self._icon_lbl.setFixedSize(20, 20)
        self._icon_lbl.setAlignment(Qt.AlignmentFlag.AlignCenter)
        self._icon_lbl.setPixmap(
            _generate_icon_pixmap_autoniax(40).scaled(
                20, 20,
                Qt.AspectRatioMode.KeepAspectRatio,
                Qt.TransformationMode.SmoothTransformation,
            )
        )
        lay.addWidget(self._icon_lbl)

        # Titre
        self._title_lbl = QLabel("AutoniaX", self)
        self._title_lbl.setObjectName("AutoniaXTitleBarTexte")
        self._title_lbl.setStyleSheet(
            f"color:{m.text}; font-size:12px; font-weight:600; "
            f"letter-spacing:0.4px; background:transparent;"
        )
        lay.addWidget(self._title_lbl, 1)

        # Boutons de contrôle -- minimiser / agrandir-restaurer / fermer.
        # Pas de "always on top"/"always bottom" ici (fonctionnalités
        # spécifiques à un autre outil, non pertinentes pour AutoniaX) --
        # on reste sur les trois boutons standards attendus.
        _btn_defs = [
            ("min",   "mdi6.window-minimize", "Minimiser",           self._minimize),
            ("max",   "mdi6.window-maximize",  "Agrandir",           self._toggle_max),
            ("close", "mdi6.close",            "Fermer",             self._close),
        ]
        for name, icon_name, tip, slot in _btn_defs:
            btn = QPushButton(self)
            btn.setObjectName(f"AutoniaXTitleBarBtn_{name}")
            btn.setFixedSize(32, 28)
            btn.setToolTip(tip)
            btn.setCursor(Qt.CursorShape.PointingHandCursor)
            btn.setIcon(qta.icon(icon_name, color=m.subtext0))
            btn.setIconSize(QSize(14, 14))
            btn.clicked.connect(slot)
            setattr(self, f"_btn_{name}", btn)
            lay.addWidget(btn)

    # -- API publique (utilisée par MainWindow) --------------------------
    def set_title(self, text: str):
        self._title_lbl.setText(text)

    def sync_maximized_state(self, is_maximized: bool):
        """Aligne l'icône du bouton agrandir/restaurer sur l'état réel de la
        fenêtre -- utilisé quand la fenêtre change d'état par un autre biais
        que le double-clic/bouton (ex: restauration de layout au démarrage)."""
        self._maximized = is_maximized
        icon_name = "mdi6.window-restore" if is_maximized else "mdi6.window-maximize"
        self._btn_max.setIcon(qta.icon(icon_name, color=Mocha.subtext0))
        self._btn_max.setToolTip("Restaurer" if is_maximized else "Agrandir")

    # -- Actions -----------------------------------------------------------
    def _minimize(self):
        self.window().showMinimized()

    def _toggle_max(self):
        w = self.window()
        # CORRECTIF (fenêtre maximisée au démarrage) -- l'ancienne version
        # inversait à la main l'état mémorisé APRÈS l'appel :
        #     sync_maximized_state(not self._maximized)
        # Or MainWindow.changeEvent resynchronise désormais cette barre
        # PENDANT showNormal()/showMaximized() (QEvent.WindowStateChange est
        # émis de façon synchrone). Le `not self._maximized` relisait alors
        # une valeur DÉJÀ mise à jour et l'inversait une seconde fois, ce qui
        # annulait la synchro : après un clic "Restaurer", la fenêtre était
        # bien restaurée mais la barre restait sur "maximisée" -> le clic
        # suivant appelait showNormal() sans effet, et la fenêtre ne pouvait
        # plus jamais être re-maximisée par le bouton (reproduit). On lit
        # donc l'état RÉEL de la fenêtre, seule source de vérité, plutôt que
        # de le déduire par inversion.
        # PATCH12 : état RÉEL de la fenêtre, pas le drapeau interne.
        if hasattr(w, "_basculer_agrandir"):   # PATCH14
            w._basculer_agrandir()
        elif w.isMaximized():
            w.showNormal()
        else:
            w.showMaximized()
        self.sync_maximized_state(w._est_agrandie() if hasattr(w, "_est_agrandie") else w.isMaximized())   # PATCH18

    def _close(self):
        self.window().close()

    # -- Drag de la fenêtre depuis la barre --------------------------------
    def mousePressEvent(self, e):
        if e.button() == Qt.MouseButton.LeftButton:
            self._drag_pos = e.globalPosition().toPoint() - self.window().frameGeometry().topLeft()
        super().mousePressEvent(e)

    def mouseDoubleClickEvent(self, e):
        if e.button() == Qt.MouseButton.LeftButton:
            self._toggle_max()
        super().mouseDoubleClickEvent(e)

    def mouseMoveEvent(self, e):
        if e.buttons() & Qt.MouseButton.LeftButton and self._drag_pos is not None:
            _w = self.window()
            if (_w._est_agrandie() if hasattr(_w, "_est_agrandie") else _w.isMaximized()):   # PATCH12/18 : état réel
                # Restaure avant de suivre la souris, sinon la fenêtre reste
                # "collée" en plein écran pendant le drag (comportement Qt
                # habituel attendu quand on tire une fenêtre maximisée).
                self._toggle_max()
                self._drag_pos = QPoint(self.window().width() // 2, self.HEIGHT // 2)
            self.window().move(e.globalPosition().toPoint() - self._drag_pos)
        super().mouseMoveEvent(e)

    def mouseReleaseEvent(self, e):
        self._drag_pos = None
        super().mouseReleaseEvent(e)

    # -- Rendu : fond dégradé sombre + liseré violet en bas -----------------
    def paintEvent(self, event):
        p = QPainter(self)
        p.setRenderHint(QPainter.RenderHint.Antialiasing)

        grad = QLinearGradient(0, 0, self.width(), 0)
        grad.setColorAt(0.0, QColor(Mocha.crust))
        grad.setColorAt(0.5, QColor(Mocha.mantle))
        grad.setColorAt(1.0, QColor(Mocha.crust))
        p.fillRect(self.rect(), grad)

        pen = QPen(QColor(Mocha.mauve))
        pen.setWidthF(1.4)
        p.setPen(pen)
        p.drawLine(0, self.height() - 1, self.width(), self.height() - 1)
        p.end()


class DialogueTitleBar(QWidget):
    """AJOUT (SPEC_lot_corrections_2026-09.md section 6, cohérence de
    thème des boîtes de dialogue) -- barre de titre custom pour les
    boîtes de dialogue maison (DialogueAutoniaXBase et ses sous-classes),
    MÊME patron que AutoniaXTitleBar (palette, drag manuel, croix stylée)
    mais volontairement PLUS LÉGÈRE : une boîte de dialogue n'a pas
    besoin de minimiser/agrandir (elle n'est de toute façon pas
    redimensionnable dans le cas général, cf. DialogueAutoniaXBase),
    seulement un titre et une croix de fermeture. Le double-clic n'agrandit
    donc rien ici (pas de _toggle_max), contrairement à AutoniaXTitleBar."""

    HEIGHT = 32

    demande_fermer = Signal()

    def __init__(self, titre: str, parent=None):
        super().__init__(parent)
        self.setObjectName("DialogueTitleBar")
        self.setFixedHeight(self.HEIGHT)
        self._drag_pos = None
        self._setup(titre)

    def _setup(self, titre: str):
        m = Mocha
        lay = QHBoxLayout(self)
        lay.setContentsMargins(12, 0, 6, 0)
        lay.setSpacing(8)

        self._title_lbl = QLabel(titre, self)
        self._title_lbl.setObjectName("DialogueTitleBarTexte")
        self._title_lbl.setStyleSheet(
            f"color:{m.text}; font-size:12px; font-weight:600; "
            f"letter-spacing:0.3px; background:transparent;"
        )
        lay.addWidget(self._title_lbl, 1)

        self._btn_close = QPushButton(self)
        self._btn_close.setObjectName("DialogueTitleBarBtn_close")
        self._btn_close.setFixedSize(28, 24)
        self._btn_close.setToolTip("Fermer")
        self._btn_close.setCursor(Qt.CursorShape.PointingHandCursor)
        self._btn_close.setIcon(qta.icon("mdi6.close", color=m.subtext0))
        self._btn_close.setIconSize(QSize(13, 13))
        self._btn_close.clicked.connect(self.demande_fermer.emit)
        lay.addWidget(self._btn_close)

    def set_title(self, text: str):
        self._title_lbl.setText(text)

    # -- Drag de la fenêtre depuis la barre -- MÊME logique que
    # AutoniaXTitleBar, sans la gestion d'état maximisé (non applicable
    # ici : DialogueAutoniaXBase n'expose pas de bouton agrandir). ------
    def mousePressEvent(self, e):
        if e.button() == Qt.MouseButton.LeftButton:
            self._drag_pos = e.globalPosition().toPoint() - self.window().frameGeometry().topLeft()
        super().mousePressEvent(e)

    def mouseMoveEvent(self, e):
        if e.buttons() & Qt.MouseButton.LeftButton and self._drag_pos is not None:
            self.window().move(e.globalPosition().toPoint() - self._drag_pos)
        super().mouseMoveEvent(e)

    def mouseReleaseEvent(self, e):
        self._drag_pos = None
        super().mouseReleaseEvent(e)

    # -- Rendu : MÊME dégradé + liseré violet que AutoniaXTitleBar, pour
    # qu'une boîte de dialogue se lise immédiatement comme appartenant à
    # la même famille visuelle que la fenêtre principale. ------------------
    def paintEvent(self, event):
        p = QPainter(self)
        p.setRenderHint(QPainter.RenderHint.Antialiasing)

        grad = QLinearGradient(0, 0, self.width(), 0)
        grad.setColorAt(0.0, QColor(Mocha.crust))
        grad.setColorAt(0.5, QColor(Mocha.mantle))
        grad.setColorAt(1.0, QColor(Mocha.crust))
        p.fillRect(self.rect(), grad)

        pen = QPen(QColor(Mocha.mauve))
        pen.setWidthF(1.2)
        p.setPen(pen)
        p.drawLine(0, self.height() - 1, self.width(), self.height() - 1)
        p.end()


class DialogueAutoniaXBase(QDialog):
    """AJOUT (section 6) -- classe de base réutilisable pour TOUTES les
    boîtes de dialogue maison de l'app -- remplace désormais les usages de
    QMessageBox/QFileDialog/QInputDialog/QColorDialog natifs ET les 3
    anciennes sous-classes QDialog (DialogueLogsSautoniax,
    RaccourciCaptureDialog, DialogueEnvoiSautoniax, toutes trois migrées
    pour hériter de DialogueAutoniaXBase -- cf. section 6 de la spec pour
    le diagnostic complet et la décision "API unifiée").

    Fenêtre frameless (Qt.FramelessWindowHint) avec DialogueTitleBar en
    haut (titre + croix, drag manuel) et une zone de contenu libre en
    dessous (self.zone_contenu, QVBoxLayout) où chaque sous-classe/
    fonction-façade insère ses propres widgets (message, boutons de
    réponse, champ de saisie, etc.).

    Volontairement SANS bouton minimiser/agrandir (cf. docstring de
    DialogueTitleBar) : une boîte de dialogue modale n'a pas vocation à
    être maximisée. Reste déplaçable (drag depuis la barre) mais pas
    redimensionnable par défaut -- une sous-classe/appelant qui a
    réellement besoin du redimensionnement (ex: futur navigateur de
    fichiers maison, cf. point technique encore ouvert pour QFileDialog)
    peut poser setSizeGripEnabled(True) sur la zone de contenu si besoin,
    ce n'est pas empêché ici, juste pas actif par défaut."""

    def __init__(self, titre: str, parent=None, largeur_min: int = 360, modal: bool = True):
        super().__init__(parent)
        self.setObjectName("DialogueAutoniaXBase")
        self.setWindowFlags(Qt.WindowType.Dialog | Qt.WindowType.FramelessWindowHint)
        # AJOUT (migration DialogueLogsSautoniax, section 6) -- modal=False
        # pour les rares dialogues affichés via .show() plutôt que .exec()
        # (ex. logs d'un sAutoniax : non-bloquant, l'utilisateur doit
        # pouvoir continuer à utiliser le reste de l'app pendant que la
        # réponse réseau arrive). True par défaut (cas très largement
        # majoritaire : question/information/warning/critical/saisie_texte,
        # tous bloquants via .exec()).
        self.setModal(modal)
        self.setMinimumWidth(largeur_min)

        root = QVBoxLayout(self)
        root.setContentsMargins(0, 0, 0, 0)
        root.setSpacing(0)

        self.title_bar = DialogueTitleBar(titre, self)
        self.title_bar.demande_fermer.connect(self.reject)
        root.addWidget(self.title_bar)

        self.zone_contenu = QWidget(self)
        self.zone_contenu.setObjectName("DialogueAutoniaXZoneContenu")
        self._zone_contenu_layout = QVBoxLayout(self.zone_contenu)
        self._zone_contenu_layout.setContentsMargins(20, 16, 20, 16)
        self._zone_contenu_layout.setSpacing(14)
        root.addWidget(self.zone_contenu, 1)

    # -- API protégée pour les sous-classes/fonctions-façade ---------------
    def ajouter_widget(self, widget: QWidget):
        self._zone_contenu_layout.addWidget(widget)

    def ajouter_layout(self, layout):
        self._zone_contenu_layout.addLayout(layout)

    def definir_titre(self, texte: str):
        self.title_bar.set_title(texte)
        self.setWindowTitle(texte)


def _creer_bouton_dialogue(texte: str, primaire: bool = False, parent=None) -> QPushButton:
    """AJOUT (section 6) -- fabrique un QPushButton stylé pour les
    boîtes de dialogue maison (mêmes deux variantes que le reste de
    l'app : "primaire" en accent mauve pour l'action par défaut/positive,
    "secondaire" en gris surface pour Annuler/Non/etc.). Objet nommé
    explicitement (DialogueBoutonPrimaire/DialogueBoutonSecondaire) pour
    être ciblé par le QSS ajouté à build_stylesheet."""
    btn = QPushButton(texte, parent)
    btn.setObjectName("DialogueBoutonPrimaire" if primaire else "DialogueBoutonSecondaire")
    btn.setCursor(Qt.CursorShape.PointingHandCursor)
    btn.setMinimumWidth(84)
    btn.setMinimumHeight(30)
    return btn


class BoiteDialogueAutoniaX:
    """AJOUT (SPEC_lot_corrections_2026-09.md section 6) -- façade
    STATIQUE unique couvrant tous les besoins auparavant remplis par
    QMessageBox/QFileDialog/QInputDialog/QColorDialog natifs (décision
    explicite : "une seule classe/façade" plutôt qu'une classe par type
    de dialogue d'origine, cf. section 6). Chaque méthode construit un
    DialogueAutoniaXBase, y ajoute le contenu propre à son cas d'usage,
    et renvoie EXACTEMENT le même contrat que la fonction native qu'elle
    remplace -- pour que les ~92+ sites d'appel existants n'aient qu'à
    changer le nom de la fonction appelée, pas leur logique.

    État de la migration (à tenir à jour au fil de l'implémentation,
    cf. SPEC section 6) :
    - question/information/warning/critical (remplace QMessageBox) : ✅ implémentées.
    - saisie_texte, couleur, ouvrir_fichier/ouvrir_dossier (remplace
      QInputDialog.getText/QColorDialog.getColor/QFileDialog.get*) :
      ✅ implémentées. Décision tranchée pour couleur/ouvrir_fichier/
      ouvrir_dossier : simple habillage du contrat, le sélecteur/
      explorateur NATIF Qt reste utilisé tel quel en interne (fiabilité,
      raccourcis système, complexité de réimplémentation disproportionnée
      par rapport au gain visuel) -- seule la façade est unifiée, pas le
      widget de sélection lui-même.
    - Migration effective des ~92 sites QMessageBox.*/5 QInputDialog/
      1 QColorDialog/4 QFileDialog vers cette façade : ✅ terminée
      (cf. SPEC section 6 pour le décompte final).
    - Conversion des 3 sous-classes QDialog existantes (DialogueLogs
      Sautoniax, RaccourciCaptureDialog, DialogueEnvoiSautoniax) et des
      2 QDialog() inline vers DialogueAutoniaXBase : ✅ terminée.
    """

    # ------------------------------------------------------------------
    # Remplace QMessageBox.question(parent, titre, texte, boutons...) ->
    # bool. Contrat simplifié volontairement au binaire Oui/Non (repli le
    # plus courant sur les ~92 sites, cf. diagnostic section 6) : renvoie
    # True si l'utilisateur a validé (Oui/OK), False sinon (Non/Annuler/
    # croix/Échap). Les rares sites ayant besoin d'un troisième choix
    # (Annuler distinct de Non) seront traités au cas par cas lors de la
    # migration effective (cf. état de migration dans la docstring de
    # classe), pas couverts par cette signature simple.
    # ------------------------------------------------------------------
    @staticmethod
    def question(
        parent,
        titre: str,
        texte: str,
        texte_oui: str = "Oui",
        texte_non: str = "Non",
        texte_informatif: Optional[str] = None,
    ) -> bool:
        dlg = DialogueAutoniaXBase(titre, parent)
        label = QLabel(texte, dlg.zone_contenu)
        label.setWordWrap(True)
        label.setStyleSheet(f"color:{Mocha.text}; font-size:13px;")
        dlg.ajouter_widget(label)

        # AJOUT (migration des sites QMessageBox utilisant setInformativeText
        # en plus de setText, cf. ex. _on_clic_supprimer_tous_profils) :
        # second label optionnel, texte secondaire/atténué -- même
        # contenu informatif qu'avant, juste rendu en dessous du message
        # principal plutôt que dans un champ QMessageBox dédié inexistant
        # ici (DialogueAutoniaXBase n'a qu'une seule zone de contenu libre).
        if texte_informatif:
            label_info = QLabel(texte_informatif, dlg.zone_contenu)
            label_info.setWordWrap(True)
            label_info.setStyleSheet(f"color:{Mocha.subtext0}; font-size:12px;")
            dlg.ajouter_widget(label_info)

        ligne_boutons = QHBoxLayout()
        ligne_boutons.addStretch(1)
        btn_non = _creer_bouton_dialogue(texte_non, primaire=False, parent=dlg.zone_contenu)
        btn_oui = _creer_bouton_dialogue(texte_oui, primaire=True, parent=dlg.zone_contenu)
        btn_non.clicked.connect(dlg.reject)
        btn_oui.clicked.connect(dlg.accept)
        ligne_boutons.addWidget(btn_non)
        ligne_boutons.addWidget(btn_oui)
        dlg.ajouter_layout(ligne_boutons)

        return dlg.exec() == QDialog.DialogCode.Accepted

    # ------------------------------------------------------------------
    # Remplace QMessageBox.information/warning/critical(parent, titre,
    # texte) -> None. Les trois variantes ne diffèrent QUE par l'icône/
    # la couleur d'accent du bandeau (aucun des trois ne renvoie de
    # valeur exploitée par l'appelant dans le code actuel, cf. usages
    # QMessageBox.information/warning/critical existants -- simple
    # accusé de réception, un seul bouton OK). Implémentées via un
    # unique helper privé _notification pour éviter la triplication.
    # ------------------------------------------------------------------
    @staticmethod
    def information(parent, titre: str, texte: str) -> None:
        BoiteDialogueAutoniaX._notification(parent, titre, texte, "mdi6.information", Mocha.blue)

    @staticmethod
    def warning(parent, titre: str, texte: str) -> None:
        BoiteDialogueAutoniaX._notification(parent, titre, texte, "mdi6.alert", Mocha.peach)

    @staticmethod
    def critical(parent, titre: str, texte: str) -> None:
        BoiteDialogueAutoniaX._notification(parent, titre, texte, "mdi6.alert-octagon", Mocha.red)

    @staticmethod
    def _notification(parent, titre: str, texte: str, icon_name: str, couleur: str) -> None:
        dlg = DialogueAutoniaXBase(titre, parent)

        ligne_haut = QHBoxLayout()
        icone_lbl = QLabel(dlg.zone_contenu)
        icone_lbl.setPixmap(qta.icon(icon_name, color=couleur).pixmap(22, 22))
        icone_lbl.setFixedWidth(28)
        icone_lbl.setAlignment(Qt.AlignmentFlag.AlignTop)
        ligne_haut.addWidget(icone_lbl)

        label = QLabel(texte, dlg.zone_contenu)
        label.setWordWrap(True)
        label.setStyleSheet(f"color:{Mocha.text}; font-size:13px;")
        ligne_haut.addWidget(label, 1)
        dlg.ajouter_layout(ligne_haut)

        ligne_boutons = QHBoxLayout()
        ligne_boutons.addStretch(1)
        btn_ok = _creer_bouton_dialogue("OK", primaire=True, parent=dlg.zone_contenu)
        btn_ok.clicked.connect(dlg.accept)
        ligne_boutons.addWidget(btn_ok)
        dlg.ajouter_layout(ligne_boutons)

        dlg.exec()

    # ------------------------------------------------------------------
    # Remplace QInputDialog.getText(parent, titre, label, mode_echo,
    # texte_initial) -> (str, bool). AJOUT (section 6) -- même contrat
    # exact que la fonction native (les 5 sites d'appel existants n'ont
    # tous besoin que du mode d'écho "Normal", cf. diagnostic section 6 :
    # aucun champ mot de passe parmi eux -- mode_echo gardé en paramètre
    # pour ne pas fermer la porte à un futur site qui en aurait besoin,
    # mais transmis tel quel à QLineEdit.setEchoMode ci-dessous, pas
    # réinterprété). Deuxième valeur du tuple : True si validé (Entrée/
    # bouton OK), False si annulé (croix/Échap/bouton Annuler) --
    # identique au comportement QInputDialog.
    # ------------------------------------------------------------------
    @staticmethod
    def saisie_texte(
        parent,
        titre: str,
        label: str,
        mode_echo=QLineEdit.EchoMode.Normal,
        texte_initial: str = "",
    ):
        dlg = DialogueAutoniaXBase(titre, parent)

        label_lbl = QLabel(label, dlg.zone_contenu)
        label_lbl.setWordWrap(True)
        label_lbl.setStyleSheet(f"color:{Mocha.text}; font-size:13px;")
        dlg.ajouter_widget(label_lbl)

        champ = QLineEdit(texte_initial, dlg.zone_contenu)
        champ.setEchoMode(mode_echo)
        champ.selectAll()
        dlg.ajouter_widget(champ)

        ligne_boutons = QHBoxLayout()
        ligne_boutons.addStretch(1)
        btn_annuler = _creer_bouton_dialogue("Annuler", primaire=False, parent=dlg.zone_contenu)
        btn_ok = _creer_bouton_dialogue("OK", primaire=True, parent=dlg.zone_contenu)
        btn_annuler.clicked.connect(dlg.reject)
        btn_ok.clicked.connect(dlg.accept)
        # Entrée dans le champ valide directement, comme QInputDialog natif.
        champ.returnPressed.connect(dlg.accept)
        ligne_boutons.addWidget(btn_annuler)
        ligne_boutons.addWidget(btn_ok)
        dlg.ajouter_layout(ligne_boutons)

        champ.setFocus()
        ok = dlg.exec() == QDialog.DialogCode.Accepted
        return champ.text(), ok

    # ------------------------------------------------------------------
    # Remplace QColorDialog.getColor(couleur_initiale, parent, titre) ->
    # QColor.
    # CHANGEMENT (retour utilisateur explicite : "tu voir la boite de
    # dialogue qui apparait quand on veut redemarer le logiciel ? cest
    # exactement ce theme que je veux" -- en réaction à "pourquoi es ce
    # que sa fenetre est blanche") -- la décision d'origine (section 6 :
    # "sélecteur natif inchangé") ne tenait pas compte d'un point Qt
    # fondamental découvert depuis : la BARRE DE TITRE d'un QColorDialog
    # affiché via .getColor() est dessinée par le gestionnaire de
    # fenêtres de l'OS lui-même (ce n'est pas un QWidget) -- AUCUNE
    # feuille de style Qt, quel que soit le sélecteur CSS utilisé, ne
    # peut jamais la repeindre. Un correctif QSS ciblé sur QColorDialog
    # (tenté juste avant ce changement) ne pouvait donc agir que sur
    # l'INTÉRIEUR du dialogue, jamais sur cette barre -- d'où le retour
    # "la barre de fenêtre est toujours blanche" malgré ce correctif.
    #
    # Le dialogue est donc maintenant INTÉGRALEMENT maison, sur EXACTEMENT
    # le même patron que question()/saisie_texte() ci-dessus (et donc la
    # même boîte "redémarrer le logiciel" citée par l'utilisateur comme
    # référence visuelle) : DialogueAutoniaXBase fournit la fenêtre
    # frameless + sa propre DialogueTitleBar custom (dégradé mauve/crust,
    # entièrement un QWidget Qt cette fois, donc stylable et cohérente
    # avec le thème Mocha) -- et un QColorDialog est intégré DEDANS, en
    # tant que simple WIDGET enfant (Qt.WindowType.Widget, pas Qt.Dialog)
    # plutôt qu'en fenêtre séparée -- c'est un usage Qt standard et
    # documenté (QColorDialog hérite de QDialog, qui hérite de QWidget,
    # rien n'empêche de le reparenter comme n'importe quel widget dès que
    # ses drapeaux de fenêtre sont réinitialisés). NoButtons retire ses
    # boutons OK/Annuler internes -- remplacés par _creer_bouton_dialogue,
    # pour que même les boutons soient cohérents avec le reste de l'app
    # (au lieu des boutons natifs de l'OS qu'avait .getColor()).
    #
    # Reste du contrat IDENTIQUE à avant (et à QColorDialog.getColor) :
    # renvoie une QColor invalide (isValid() == False) si l'utilisateur
    # annule/ferme via la croix -- même connexion dlg.reject que les
    # autres façades ci-dessus.
    #
    # Risque assumé, documenté pour référence future : la roue
    # chromatique elle-même (widget QColorDialog interne à Qt) garde le
    # rendu standard de Qt Fusion, pas un habillage Mocha poussé jusqu'à
    # ses moindres pixels -- réimplémenter cette roue à la main resterait
    # disproportionné (cf. raisonnement d'origine section 6), seule la
    # coquille (barre de titre + fond + boutons) est désormais maison.
    # ------------------------------------------------------------------
    @staticmethod
    def couleur(couleur_initiale: QColor, parent, titre: str = "Choisir une couleur") -> QColor:
        dlg = DialogueAutoniaXBase(titre, parent, largeur_min=560)

        selecteur = QColorDialog(couleur_initiale, dlg.zone_contenu)
        selecteur.setWindowFlags(Qt.WindowType.Widget)
        selecteur.setOption(QColorDialog.ColorDialogOption.NoButtons, True)
        selecteur.setOption(QColorDialog.ColorDialogOption.DontUseNativeDialog, True)
        dlg.ajouter_widget(selecteur)

        ligne_boutons = QHBoxLayout()
        ligne_boutons.addStretch(1)
        btn_annuler = _creer_bouton_dialogue("Annuler", primaire=False, parent=dlg.zone_contenu)
        btn_ok = _creer_bouton_dialogue("OK", primaire=True, parent=dlg.zone_contenu)
        btn_annuler.clicked.connect(dlg.reject)
        btn_ok.clicked.connect(dlg.accept)
        # Double-clic sur une couleur (comportement natif QColorDialog)
        # valide directement, comme .getColor() natif le permettait déjà.
        selecteur.colorSelected.connect(lambda _c: dlg.accept())
        ligne_boutons.addWidget(btn_annuler)
        ligne_boutons.addWidget(btn_ok)
        dlg.ajouter_layout(ligne_boutons)

        if dlg.exec() == QDialog.DialogCode.Accepted:
            return selecteur.currentColor()
        return QColor()  # invalide (isValid() == False), même contrat qu'avant sur annulation

    # ------------------------------------------------------------------
    # Remplace QFileDialog.getOpenFileName(parent, titre, dossier_initial,
    # filtre) -> (str, str). AJOUT (section 6) -- même décision pragmatique
    # que pour couleur() ci-dessus : l'explorateur de fichiers NATIF reste
    # utilisé (fiabilité, raccourcis système/favoris/recherche déjà
    # présents nativement, réimplémentation disproportionnée pour 3 sites
    # d'appel, cf. diagnostic section 6). Contrat identique à la fonction
    # native : renvoie (chemin, filtre_selectionne) avec chemin == "" si
    # l'utilisateur annule.
    # ------------------------------------------------------------------
    @staticmethod
    def ouvrir_fichier(parent, titre: str, dossier_initial: str = "", filtre: str = ""):
        return QFileDialog.getOpenFileName(parent, titre, dossier_initial, filtre)

    # ------------------------------------------------------------------
    # Remplace QFileDialog.getExistingDirectory(parent, titre, dossier_
    # initial) -> str. AJOUT (section 6) -- même décision pragmatique
    # (explorateur natif conservé). Renvoie "" si l'utilisateur annule,
    # identique au comportement natif.
    # ------------------------------------------------------------------
    @staticmethod
    def ouvrir_dossier(parent, titre: str, dossier_initial: str = "") -> str:
        return QFileDialog.getExistingDirectory(parent, titre, dossier_initial)


class ServeurTDragHandle(QToolButton):
    """PATCH (demande explicite utilisateur : "un bouon de drag, pour
    dragguer le fichier python vers une autre app en fichier direct ...
    regarde dans la section pliable depliage du panneau droit dans
    taskeditor comment il ya ce genere de bouton labas") -- même geste
    EXACTEMENT que NotebookDragHandleCompact (glisser-déposer d'un vrai
    fichier hors d'AutoniaX vers une autre application, via
    QMimeData.setUrls/QUrl.fromLocalFile), mais PLUS SIMPLE : serveur.py
    existe déjà en permanence sur disque (cf. GitScreen._sur_code_modifie,
    qui le réécrit à chaque frappe), donc pas besoin de le régénérer à la
    volée dans un dossier temporaire comme le fait NotebookDragHandleCompact
    pour un Task -- on fait glisser directement le fichier réel, "une
    copie" (décision explicite utilisateur), CopyAction ci-dessous.

    chemin_factory : callable() -> Path, réévalué à chaque drag (et non
    figé à la construction) pour rester correct même si le nom de
    fichier venait à changer un jour.

    texte_tooltip (PATCH -- Patch 4.8, réutilisation DIRECTE de cette
    même classe pour le notebook d'exécution sAutoniax/Kaggle, cf.
    GitScreen.bouton_drag_notebook -- PAS de sous-classe dédiée, ce
    widget est déjà totalement générique, rien de spécifique à
    serveur.py dans son comportement, seul le tooltip fixe le
    mentionnait en dur) : paramétrable, défaut inchangé pour l'appel
    existant (GitScreen/serveur.py) -- pas de raison de dupliquer 45
    lignes identiques pour un simple besoin de tooltip différent."""

    def __init__(self, chemin_factory, parent=None,
                 texte_tooltip: str = "Glisser pour copier serveur.py hors d'AutoniaX"):
        super().__init__(parent)
        self._chemin_factory = chemin_factory
        self.setObjectName("APIFeaturesMenuButton")
        self.setIcon(qta.icon("mdi6.file-move-outline", color=Mocha.subtext0))
        self.setIconSize(QSize(18, 18))
        self.setCursor(Qt.OpenHandCursor)
        self.setToolTip(texte_tooltip)

    def mousePressEvent(self, event):
        if event.button() == Qt.LeftButton:
            self._pos_depart = event.pos()
        super().mousePressEvent(event)

    def mouseMoveEvent(self, event):
        if not (event.buttons() & Qt.LeftButton) or not hasattr(self, "_pos_depart"):
            return super().mouseMoveEvent(event)
        if (event.pos() - self._pos_depart).manhattanLength() < QApplication.startDragDistance():
            return super().mouseMoveEvent(event)

        chemin = self._chemin_factory()
        if chemin is None or not chemin.exists():
            return  # rien à glisser tant que le fichier n'a jamais été écrit sur disque

        mime = QMimeData()
        mime.setUrls([QUrl.fromLocalFile(str(chemin))])

        drag = QDrag(self)
        drag.setMimeData(mime)
        drag.setPixmap(qta.icon("mdi6.file-move-outline", color=Mocha.lavender).pixmap(32, 32))
        # CORRECTIF (demande explicite utilisateur : "je ne comprend pas
        # le pourquoi le drag de fichier de mes notebook Manager dans
        # l'onglet code ne parvient pas a etre dragger vers" une zone de
        # dépôt de fichier dans un NAVIGATEUR, ex. Colab) -- Qt.CopyAction
        # SEUL restreint l'ensemble d'actions proposées au récepteur ;
        # l'exemple de référence de la documentation Qt (Drag and Drop)
        # utilise systématiquement Qt.CopyAction | Qt.MoveAction, et
        # plusieurs zones de dépôt HTML5 (dont certaines intégrations
        # Chrome/Chromium négociant l'action au niveau OS, cf. retours
        # d'expérience Qt sur le drop vers un navigateur) rejettent
        # silencieusement le drop si aucune action compatible n'est
        # trouvée dans un ensemble trop restreint -- élargi ici sans
        # changer le comportement CÔTÉ AutoniaX (le fichier source n'est
        # jamais supprimé après un drag, cf. dropEvent du récepteur qui
        # ne fait qu'écrire une COPIE ; MoveAction resterait donc sans
        # effet réel même si le navigateur cible la choisissait).
        drag.exec(Qt.CopyAction | Qt.MoveAction)


# BUGFIX (NameError: name 'log_git' is not defined, planté dans
