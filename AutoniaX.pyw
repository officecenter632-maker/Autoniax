    "HU": "Hongrie", "UA": "Ukraine", "RU": "Russie", "TR": "Turquie",
    "CA": "Canada", "MX": "Mexique", "BR": "Brésil", "AR": "Argentine",
    "CL": "Chili", "CO": "Colombie", "JP": "Japon", "CN": "Chine",
    "KR": "Corée du Sud", "IN": "Inde", "SG": "Singapour", "HK": "Hong Kong",
    "TW": "Taïwan", "TH": "Thaïlande", "VN": "Vietnam", "ID": "Indonésie",
    "MY": "Malaisie", "PH": "Philippines", "AU": "Australie", "NZ": "Nouvelle-Zélande",
    "ZA": "Afrique du Sud", "EG": "Égypte", "MA": "Maroc", "NG": "Nigeria",
    "AE": "Émirats arabes unis", "SA": "Arabie saoudite", "IL": "Israël",
    "CM": "Cameroun", "CI": "Côte d'Ivoire", "SN": "Sénégal", "TN": "Tunisie",
    "DZ": "Algérie", "LU": "Luxembourg", "IS": "Islande", "EE": "Estonie",
    "LV": "Lettonie", "LT": "Lituanie", "BG": "Bulgarie", "HR": "Croatie",
    "RS": "Serbie", "SK": "Slovaquie", "SI": "Slovénie", "MD": "Moldavie",
    "GE": "Géorgie", "KZ": "Kazakhstan", "PK": "Pakistan", "BD": "Bangladesh",
}


def _nom_pays_depuis_code(code_pays: Optional[str]) -> str:
    """Retourne le nom complet (français) d'un code pays ISO 3166-1
    alpha-2. Ordre de résolution, chacun servant de repli au précédent :
    1. babel (Locale('fr').territories, cf. _LOCALE_PAYS_FR en tête de
       fichier) -- couvre ~250 codes, y compris des codes hors ISO strict
       mais utilisés en pratique par les géo-IP (ex: "XK" Kosovo).
    2. _NOMS_PAYS_ISO_ALPHA2 ci-dessus -- si babel est absent de la
       machine cible, ou si babel lui-même ne reconnaît pas ce code
       précis (very peu probable, mais un .get() peut renvoyer None).
    3. Le code brut en majuscules -- dernier repli si le pays est
       vraiment inconnu partout, jamais d'exception pour un champ de
       présentation."""
    if not code_pays:
        return ""
    code = code_pays.upper()
    if NOMS_PAYS_BABEL_DISPONIBLE:
        nom_babel = _LOCALE_PAYS_FR.territories.get(code)
        if nom_babel:
            return nom_babel
    return _NOMS_PAYS_ISO_ALPHA2.get(code, code)


def _pays_vers_drapeau_emoji(code_pays: Optional[str]) -> str:
    """Convertit un code pays ISO 3166-1 alpha-2 (ex: "GB", "FR") en
    drapeau emoji -- chaque lettre A-Z se mappe sur un "regional
    indicator symbol" Unicode (U+1F1E6 = 'A', consécutifs jusqu'à 'Z'),
    et un couple de 2 lettres s'affiche comme un seul drapeau composé
    dans la quasi-totalité des polices/rendus modernes (Windows/Qt inclus
    depuis Segoe UI Emoji). Défensif : chaîne vide si code_pays absent ou
    de longueur inattendue (jamais d'exception pour un champ de
    présentation)."""
    if not code_pays or len(code_pays) != 2 or not code_pays.isalpha():
        return ""
    base = ord("🇦") - ord("A")
    return "".join(chr(ord(c.upper()) + base) for c in code_pays)


def _telecharger_drapeau_pays(code_pays: Optional[str], timeout_s: float = 4.0) -> Optional[Path]:
    """Retourne le chemin local d'un PNG de drapeau pour ce code pays ISO
    3166-1 alpha-2 (ex: "GB", "JP"), en le téléchargeant UNE SEULE FOIS via
    flagcdn.com (service gratuit, sans clé API -- cf. https://flagcdn.com,
    convention d'URL documentée : https://flagcdn.com/{taille}/{code}.png
    en minuscules) puis en le mettant en cache dans DOSSIER_CACHE_DRAPEAUX.

    PATCH (demande utilisateur explicite : "je veux le drapeau, meme si il
    faut se connecter a un service externe automatiquement pour l'obtenir")
    -- remplace le drapeau emoji (_pays_vers_drapeau_emoji), qui s'est
    révélé non fiable : son rendu dépend d'une police système avec bon
    support des séquences d'emoji composées, absente/mal gérée sur la
    machine de l'utilisateur (constaté en pratique -- "GB"/"US" affichés
    en 2 lettres brutes). Un vrai fichier PNG affiché via QPixmap ne
    dépend d'AUCUNE police -- fiable sur toute machine.

    Défensif à chaque étape (jamais d'exception qui remonterait jusqu'à
    l'UI, pour un champ de présentation) :
    - code_pays invalide (absent, pas 2 lettres) -> None immédiatement,
      pas de tentative réseau.
    - déjà en cache sur disque (téléchargé lors d'un appel précédent, y
      compris une session précédente de l'app) -> retourné directement,
      AUCUNE requête réseau -- le cache est permanent (un drapeau ne
      change jamais pour un code pays donné).
    - échec réseau (offline, flagcdn.com indisponible, timeout) -> None,
      journalisé en avertissement -- l'appelant retombe alors sur
      _pays_vers_drapeau_emoji (cf. _camoufox_extraire_proprietes_fingerprint)
      plutôt que de laisser le champ Pays totalement vide."""
    if not code_pays or len(code_pays) != 2 or not code_pays.isalpha():
        return None

    code_pays = code_pays.lower()
    try:
        DOSSIER_CACHE_DRAPEAUX.mkdir(parents=True, exist_ok=True)
    except OSError as exc:
        log.warning(f"[drapeau] impossible de créer le dossier de cache ({exc!r}).")
        return None

    chemin_local = DOSSIER_CACHE_DRAPEAUX / f"{code_pays}.png"
    if chemin_local.exists() and chemin_local.stat().st_size > 0:
        return chemin_local

    # 24x18 -- petit format prévu par flagcdn.com pour un usage "icône
    # inline" (cf. leur doc), largement suffisant pour un QLabel de texte
    # à 12px, pas besoin d'une résolution plus grande ici.
    url = f"https://flagcdn.com/24x18/{code_pays}.png"
    try:
        requete = urllib.request.Request(url, headers={"User-Agent": "AutoniaX/1.0"})
        with urllib.request.urlopen(requete, timeout=timeout_s) as reponse:
            donnees = reponse.read()
        if not donnees:
            raise ValueError("réponse vide")
        chemin_tmp = chemin_local.with_suffix(".png.tmp")
        chemin_tmp.write_bytes(donnees)
        chemin_tmp.replace(chemin_local)  # écriture atomique -- jamais de PNG tronqué en cache
        return chemin_local
    except (urllib.error.URLError, TimeoutError, OSError, ValueError) as exc:
        log.warning(
            f"[drapeau] téléchargement échoué pour le pays '{code_pays.upper()}' "
            f"({exc!r}) -- repli sur le drapeau emoji."
        )
        return None


def _formater_langues(valeur) -> str:
    """Normalise le champ "Langues (Accept-Language)" en chaîne lisible.

    CORRECTIF : navigator.languages (pluriel), quand elle existe dans le
    config Camoufox, est une LISTE (ex: ["en-GB", "en"]) -- mais le repli
    locale.language (cf. _camoufox_extraire_proprietes_fingerprint) est une
    STRING unique. Sans cette normalisation, le champ affichait tantôt une
    vraie liste de langues, tantôt une liste Python brute affichée telle
    quelle côté UI (ex: "['en-GB', 'en']"), selon que navigator.languages
    était renseignée ou non. Ici, une liste/tuple est toujours rejointe par
    ", " ; toute autre valeur (string, None, "-") est simplement convertie
    en str."""
    if valeur is None:
        return "-"
    if isinstance(valeur, (list, tuple)):
        elements = [str(e) for e in valeur if e not in (None, "")]
        return ", ".join(elements) if elements else "-"
    return str(valeur)


def _camoufox_extraire_proprietes_fingerprint(opts_from_options: dict) -> dict:
    """Traduit le dict brut (cf. _camoufox_extraire_config_brute) en une
    poignée de propriétés LISIBLES, pour l'onglet Propriétés du Dashboard
    -- pas le dict technique complet (des dizaines de clés BrowserForge
    peu parlantes pour un humain), juste ce qui identifie concrètement
    "à quoi ressemble ce navigateur vu de l'extérieur" : OS/UA, écran,
    matériel, langue, fuseau horaire/géolocalisation (si geoip actif),
    proxy (sans le mot de passe), WebGL.

    Chaque valeur est lue défensivement (clé absente -> "-" plutôt qu'une
    KeyError) : la structure exacte du config BrowserForge n'est pas
    contractuelle d'une version de camoufox à l'autre, cf. docstring de
    _camoufox_extraire_config_brute.

    CORRECTIF (demande utilisateur explicite : "pourquoi la langue du
    navigateur ne s'affiche pas ?") -- vérifié par lecture directe du
    code source de camoufox/utils.py (bloc "Set geolocation") : quand
    geoip=True (cf. _camoufox_construire_config_lancement), Camoufox
    peuple déjà AUTOMATIQUEMENT une langue/région déduites de l'IP du
    proxy -- mais sous les clés 'locale:language'/'locale:region'
    (cf. camoufox/locales.py, Geolocation.as_config()), PAS sous
    'navigator.language'/'navigator.languages'. ORIGINE DE CETTE
    DERNIÈRE : le mapping BrowserForge->Camoufox (camoufox/browserforge.yml)
    exclut EXPLICITEMENT language/languages de la génération BrowserForge
    ("Locale is now implemented separately") -- 'navigator.language'
    n'est écrite QUE si un paramètre `locale` (string) est fourni
    explicitement à launch_options(), ce que ce fichier ne fait pas
    encore (cf. _camoufox_construire_config_lancement, TODO séparé :
    "je veux automatiquement" -- dérivation depuis le pays du proxy, pas
    encore branchée à ce stade). En attendant ce second patch, la donnée
    géoip existe déjà et est ici exposée en repli.
    Idem pour "Pays (geoip)" : 'geolocation:country' n'existe
    STRUCTURELLEMENT JAMAIS côté Camoufox (vérifié : Geolocation.as_config()
    ne produit que longitude/latitude/timezone/locale:region/locale:language,
    aucun champ pays explicite) -- 'locale:region' (code ISO 3166-1
    alpha-2, ex: "GB") en est l'équivalent le plus proche disponible.

    "Mémoire déclarée (deviceMemory)" reste volontairement "-" : Firefox
    n'implémente pas navigator.deviceMemory (propriété spécifique à
    Chrome/Chromium, cf. commentaire "deviceMemory not in Firefox" dans
    camoufox/browserforge.yml) -- ce champ ne sera donc JAMAIS rempli
    pour un profil Camoufox, quel que soit le patch appliqué ici."""
    config = _camoufox_extraire_config_brute(opts_from_options)

    def _get(*cles, defaut="-"):
        # Les clés BrowserForge/Camoufox apparaissent tantôt à plat avec
        # un point ("navigator.userAgent"), tantôt avec un deux-points
        # séparateur de domaine ("webGl:vendor") selon la brique d'origine
        # (BrowserForge vs Camoufox lui-même, cf. is_domain_set/set_into
        # dans camoufox/utils.py) -- on essaie les deux séparateurs pour
        # chaque chemin demandé plutôt que de figer un seul format.
        for chemin in cles:
            for separateur in (".", ":"):
                variante = chemin.replace(".", separateur)
                if variante in config and config[variante] not in (None, ""):
                    return config[variante]
        return defaut

    code_pays = _get("locale.region", "locale:region", defaut=None)
    drapeau = _pays_vers_drapeau_emoji(code_pays)

    proprietes = {
        "Système d'exploitation": _get("navigator.oscpu", "navigator.platform"),
        "User-Agent": _get("navigator.userAgent"),
        "Plateforme (navigator.platform)": _get("navigator.platform"),
        "Résolution d'écran": (
            f"{_get('screen.width', defaut='?')} x {_get('screen.height', defaut='?')}"
            if _get("screen.width", defaut=None) is not None else "-"
        ),
        "Cœurs CPU (hardwareConcurrency)": _get("navigator.hardwareConcurrency"),
        "Mémoire déclarée (deviceMemory)": _get("navigator.deviceMemory"),
        # Repli locale.language -- cf. docstring ci-dessus : navigator.language
        # reste prioritaire (si un jour renseignée explicitement), locale.language
        # (déjà peuplée par geoip=True) sert de repli plutôt que "-". _get()
        # teste déjà les deux séparateurs (. et :) en interne pour CHAQUE
        # chemin fourni -- inutile de lister "locale.language" ET
        # "locale:language" séparément, c'était redondant dans la version
        # précédente de ce patch.
        "Langue": _get("navigator.language", "locale.language"),
        # CORRECTIF : navigator.languages (pluriel) est une LISTE quand
        # elle existe (ex: ["en-GB", "en"]), alors que le repli
        # locale.language est une STRING unique -- sans normalisation, ce
        # champ pouvait afficher une liste Python brute côté UI
        # ("['en-GB', 'en']"). _formater_langues() force toujours une
        # chaîne lisible, jointe par virgule si la valeur lue est une liste.
        "Langues (Accept-Language)": _formater_langues(
            _get("navigator.languages", "locale.language", defaut=None)
        ),
        "Fuseau horaire": _get("timezone"),
        "Pays (geoip)": f"{drapeau} {code_pays}".strip() if code_pays else "-",
        "Latitude / Longitude (geoip)": (
            f"{_get('geolocation:latitude', 'geolocation.latitude', defaut='?')}, "
            f"{_get('geolocation:longitude', 'geolocation.longitude', defaut='?')}"
            if _get("geolocation:latitude", "geolocation.latitude", defaut=None) is not None else "-"
        ),
        "WebGL vendor": _get("webGl:vendor", "webGl.vendor"),
        "WebGL renderer": _get("webGl:renderer", "webGl.renderer"),
        "Adresse du proxy": (
            (opts_from_options.get("proxy") or {}).get("server", "-")
            if opts_from_options.get("proxy") else "Aucun (connexion directe)"
        ),
    }
    return proprietes


# ---------------------------------------------------------------------------
# Propriétés RÉELLES de la machine hôte -- PATCH (demande utilisateur
# explicite : "je veux que tu mets aussi un onglet qui vont afficher les
# parametre reel du navigateur, adresse ip, autre donnee reelle pour qu'on
# fasse la comparaison ... dans l'onglet des propriétés tu dois mettre 2
# onglet encore, original et fictifs").
#
# Symétrique de _camoufox_extraire_proprietes_fingerprint (mêmes libellés
# de clé dans la mesure du possible, pour un alignement visuel ligne à
# ligne entre les 2 sous-onglets côté UI) mais lit des valeurs RÉELLES de
# la machine (stdlib platform/locale/os) et une adresse IP publique
# obtenue par requête HTTP DIRECTE (urllib, PAS playwright/camoufox) --
# c'est précisément ce contournement du proxy configuré sur le profil qui
# rend la comparaison utile : "fictif" reflète l'IP/geoip DERRIÈRE le
# proxy, "réel" reflète la machine elle-même.
#
# Exécutée côté process INSTANCE (cf. action "get_fingerprint" dans
# _session_camoufox_minimale, même canal que le fictif) -- pas côté
# process GUI/Dashboard : la requête IP doit sortir par la connexion
# réseau réelle de la machine qui fait tourner Camoufox, cohérent avec ce
# que "réel" est censé représenter.
# ---------------------------------------------------------------------------

def _reel_obtenir_ip_publique(timeout_s: float = 4.0) -> Optional[str]:
    """Requête HTTP directe (urllib.request, hors proxy Playwright/
    Camoufox -- ce module ne configure aucun proxy système lui-même) vers
    un service minimal de retour d'IP. Défensif : None si le réseau
    échoue/timeout, jamais d'exception remontée (une IP indisponible ne
    doit pas empêcher l'affichage du reste des propriétés réelles)."""
    try:
        with urllib.request.urlopen("https://api.ipify.org", timeout=timeout_s) as reponse:
            ip = reponse.read().decode("utf-8", errors="ignore").strip()
            return ip or None
    except (urllib.error.URLError, OSError, ValueError):
        return None


async def _camoufox_obtenir_ip_publique_via_page(page, timeout_s: float = 6.0) -> Optional[str]:
    """Symétrique CÔTÉ NAVIGATEUR de _reel_obtenir_ip_publique -- PATCH
    (demande utilisateur explicite : "pourquoi on ne montre pas l'adresse
    ip que j'utilise ? c'est ça l'adresse du proxy ?") : "Adresse du
    proxy" (cf. _camoufox_extraire_proprietes_fingerprint) n'est QUE le
    serveur auquel Camoufox se connecte -- PAS forcément l'IP de sortie
    que les sites voient réellement (fréquent avec un proxy résidentiel/
    rotatif : IP d'entrée != IP de sortie, parfois différente à chaque
    requête). La seule façon fiable de connaître cette IP de sortie
    réelle est de la demander DEPUIS la page Camoufox elle-même (fetch()
    exécuté par le moteur de rendu, donc au travers du proxy configuré
    sur ce contexte) -- PAS via urllib côté process Python comme le fait
    _reel_obtenir_ip_publique, qui contournerait totalement le proxy et
    donnerait l'IP de la machine hôte, pas celle vue par les sites.

    Défensif comme le reste du module : retourne None sur tout échec
    (page pas prête, proxy injoignable, timeout, JSON inattendu) -- une
    IP indisponible ne doit jamais faire échouer tout l'affichage des
    propriétés fictives, seulement laisser ce champ à "-" côté appelant."""
    try:
        resultat = await asyncio.wait_for(
            page.evaluate(
                "() => fetch('https://api.ipify.org?format=json', {cache: 'no-store'})"
                ".then(r => r.json()).then(j => j.ip)"
            ),
            timeout=timeout_s,
        )
        resultat = (resultat or "").strip()
        return resultat or None
    except Exception as exc:
        log.debug(f"[camoufox] IP publique via page (au travers du proxy) indisponible : {exc!r}")
        return None


def _reel_extraire_proprietes_machine() -> dict:
    """Construit le dict {libellé: valeur} des propriétés RÉELLES de la
    machine hôte, mêmes clés que _camoufox_extraire_proprietes_fingerprint
    quand un équivalent réel existe (ex: "Cœurs CPU"), "-" pour celles
    sans équivalent côté machine (ex: WebGL, propriété du NAVIGATEUR
    piloté, pas de la machine physique).

    Défensif par construction, comme sa contrepartie fictive : chaque
    valeur est lue individuellement, jamais d'exception qui ferait
    échouer tout l'affichage pour un seul champ indisponible."""
    try:
        uname = platform.uname()
        os_reel = f"{uname.system} {uname.release} ({uname.version})"
    except OSError:
        os_reel = "-"

    try:
        langue_reelle = locale.getlocale()[0] or "-"
    except (ValueError, TypeError):
        langue_reelle = "-"

    try:
        fuseau_reel = time.strftime("%Z") or "-"
    except OSError:
        fuseau_reel = "-"

    ip_publique = _reel_obtenir_ip_publique()

    return {
        "Système d'exploitation": os_reel,
        "User-Agent": "-",  # pas de navigateur système -- non applicable
        "Plateforme (navigator.platform)": platform.machine() or "-",
        "Résolution d'écran": "-",  # non mesurée côté process instance (pas de session GUI)
        "Cœurs CPU (hardwareConcurrency)": os.cpu_count() or "-",
        "Mémoire déclarée (deviceMemory)": "-",  # nécessiterait psutil, dépendance non garantie
        "Langue": langue_reelle,
        "Langues (Accept-Language)": langue_reelle,
        "Fuseau horaire": fuseau_reel,
        "Pays (geoip)": "-",  # nécessiterait un service de géolocalisation IP dédié
        "Latitude / Longitude (geoip)": "-",
        "WebGL vendor": "-",  # propriété du navigateur piloté, pas de la machine hôte
        "WebGL renderer": "-",
        "Adresse du proxy": "-",  # non applicable -- "réel" = SANS proxy, par définition
        "Adresse IP publique réelle": ip_publique or "Indisponible (requête réseau échouée)",
    }


def _camoufox_reencoder_config_en_env(opts_from_options: dict, config: dict) -> dict:
    """Symétrique de _camoufox_extraire_config_brute -- réencode un dict de
    config MODIFIÉ dans les mêmes variables d'environnement CAMOU_CONFIG_N
    que camoufox.utils.get_env_vars() utilise pour le sérialiser à
    l'origine (cf. son code source, vérifié par lecture directe : la
    config est json.dumps'ée puis découpée en morceaux de chunk_size
    caractères -- 2047 sous Windows, 32767 ailleurs -- à cause de la
    limite de taille des variables d'environnement Windows). Remplace
    TOUTES les anciennes clés CAMOU_CONFIG_* par les nouveaux morceaux
    (le nombre de morceaux peut changer si la taille du JSON change après
    modification), plutôt que d'écraser seulement les premières -- un
    reliquat de l'ancien découpage laisserait un JSON invalide en fin de
    chaîne.

    DIAGNOSTIC (retour utilisateur : "je narrive pas a surfer aec un
    profisl demaerer, je pense que le prxy cest mal connecter") -- logs
    ajoutés à chaque étape pour tracer précisément où un éventuel problème
    apparaît, plutôt que de deviner. Défensif : si la réencodage échoue
    pour une raison quelconque (config contient un type non sérialisable
    par json.dumps -- le vrai code Camoufox utilise orjson, potentiellement
    plus permissif sur certains types -- cf. TODO ci-dessous, écart non
    encore confirmé), retombe sur opts_from_options INCHANGÉ plutôt que de
    risquer un fingerprint corrompu qui empêcherait le navigateur de se
    lancer/se connecter correctement."""
    env_avant = opts_from_options.get("env") or {}
    cles_config_avant = sorted(c for c in env_avant if c.startswith("CAMOU_CONFIG_"))
    log.info(
        f"[camoufox][diag-langue] _camoufox_reencoder_config_en_env : AVANT -- "
        f"{len(cles_config_avant)} chunk(s) CAMOU_CONFIG_* existant(s), "
        f"clés env totales={list(env_avant.keys())}, "
        f"proxy présent dans opts_from_options={'proxy' in opts_from_options}."
    )
    try:
        env_vars = dict(env_avant)
        for cle in cles_config_avant:
            del env_vars[cle]

        config_str = json.dumps(config)
        # cf. camoufox/utils.py:get_env_vars -- même détection d'OS que
        # l'original (limite Windows nettement plus basse que Linux/macOS).
        chunk_size = 2047 if platform.system().lower().startswith("win") else 32767
        for i in range(0, len(config_str), chunk_size):
            morceau = config_str[i : i + chunk_size]
            env_vars[f"CAMOU_CONFIG_{(i // chunk_size) + 1}"] = morceau

        nb_chunks_apres = len([c for c in env_vars if c.startswith("CAMOU_CONFIG_")])
        log.info(
            f"[camoufox][diag-langue] _camoufox_reencoder_config_en_env : APRÈS -- "
            f"config_str={len(config_str)} caractère(s), chunk_size={chunk_size}, "
            f"{nb_chunks_apres} chunk(s) écrits, clés config finales={sorted(config.keys())}."
        )

        # Vérification de cohérence AVANT de committer -- reparse
        # immédiatement les chunks qu'on vient d'écrire (même mécanisme
        # que _camoufox_extraire_config_brute) pour détecter tout de
        # suite un découpage cassé plutôt qu'au lancement du navigateur.
        verif_str = "".join(
            env_vars[f"CAMOU_CONFIG_{n}"]
            for n in range(1, nb_chunks_apres + 1)
        )
        config_reparse = json.loads(verif_str)
        if config_reparse != config:
            raise ValueError(
                "le config reparsé après découpage/recollage ne correspond "
                "pas au config original -- découpage corrompu"
            )
        log.info(
            "[camoufox][diag-langue] _camoufox_reencoder_config_en_env : "
            "vérification round-trip OK (reparse identique au config source)."
        )

        opts_from_options["env"] = env_vars
        return opts_from_options
    except Exception as exc:
        log.warning(
            f"[camoufox][diag-langue] _camoufox_reencoder_config_en_env : ÉCHEC "
            f"({exc!r}) -- repli sur opts_from_options INCHANGÉ (fingerprint "
            f"original conservé, navigator.language/languages NON forcées cette "
            f"fois -- mieux vaut ça qu'un fingerprint corrompu empêchant le "
            f"navigateur de démarrer)."
        )
        return opts_from_options


def _camoufox_forcer_langue_navigateur(opts_from_options: dict) -> dict:
    """Force navigator.language/navigator.languages dans le config Camoufox,
    dérivés AUTOMATIQUEMENT de locale:language/locale:region (déjà peuplés
    par geoip=True à partir de l'IP du proxy, cf. _camoufox_construire_
    config_lancement) -- sans ça, la langue déclarée du navigateur ne suit
    JAMAIS le pays du proxy, quel que soit le paramètre `locale` passé à
    launch_options().

    CAUSE RACINE DU COMPORTEMENT CAMOUFOX (vérifiée en lisant le code
    source du package camoufox installé, pas deviné) : camoufox.utils.
    launch_options() n'écrit navigator.language QUE via camoufox.
    fingerprints.generate_fingerprint() (fingerprints.py, bloc "Inject
    explicit timezone/locale into config"), mais CETTE fonction est
    appelée par launch_options() SANS jamais lui passer `locale=` (elle
    ne reçoit que screen/window/os, cf. utils.py). Le kwarg `locale=`
    top-level de launch_options(), lui, ne fait QU'appeler locales.
    handle_locales(), qui écrit uniquement locale:language/locale:region/
    locale:script/locale:all -- JAMAIS navigator.language. Autrement dit :
    geoip=True peuple bien locale:* à partir du proxy, mais rien dans
    l'API publique de camoufox ne recopie ensuite ça vers
    navigator.language. C'est une limitation du package lui-même,
    contournée ici en écrivant directement dans le config avant
    sauvegarde du fingerprint sur disque.

    BUG CORRIGÉ (patch précédent) : cette fonction cherchait
    opts_from_options["config"], une clé de premier niveau qui n'existe
    PAS dans le dict retourné par launch_options() -- le vrai config est
    encodé dans des morceaux opts["env"]["CAMOU_CONFIG_N"] (cf.
    _camoufox_extraire_config_brute, qui le documentait déjà AVANT ce
    patch -- j'aurais dû la réutiliser dès le début plutôt que de
    supposer une structure sans la vérifier). Le bug était silencieux :
    isinstance(config, dict) valait toujours False, donc la fonction
    retournait le dict tel quel sans la moindre erreur -- d'où
    l'impression que rien n'avait changé, y compris pour un profil
    fraîchement créé après le patch (cf. profil "camoufox2" -- pas un
    problème d'ancien profil, c'était bien ce bug-ci). Utilise maintenant
    _camoufox_extraire_config_brute pour LIRE (mêmes morceaux CAMOU_CONFIG_N,
    déjà correctement décodés) et _camoufox_reencoder_config_en_env pour
    RÉÉCRIRE ces mêmes morceaux une fois navigator.language/languages
    ajoutées.

    Idempotent et défensif : si locale:language est absent (pas de proxy,
    geoip=False), ne touche à rien -- le comportement par défaut de
    Camoufox (langue du profil/OS hôte) reste inchangé, exactement comme
    avant ce patch."""
    config = _camoufox_extraire_config_brute(opts_from_options)
    if not config:
        log.info(
            "[camoufox][diag-langue] _camoufox_forcer_langue_navigateur : "
            "config brute VIDE (extraction échouée ou aucun CAMOU_CONFIG_* "
            "trouvé) -- aucune modification, opts_from_options retourné tel quel."
        )
        return opts_from_options

    langue = config.get("locale:language") or config.get("locale.language")
    region = config.get("locale:region") or config.get("locale.region")
    log.info(
        f"[camoufox][diag-langue] _camoufox_forcer_langue_navigateur : config "
        f"brute extraite ({len(config)} clé(s)), locale:language={langue!r}, "
        f"locale:region={region!r}, navigator.language déjà présent="
        f"{config.get('navigator.language')!r}."
    )
    if not langue:
        log.info(
            "[camoufox][diag-langue] _camoufox_forcer_langue_navigateur : "
            "locale:language absent (pas de proxy/geoip=False probablement) "
            "-- aucune modification."
        )
        return opts_from_options

    tag_langue = f"{langue}-{region}" if region else langue
    log.info(f"[camoufox][diag-langue] _camoufox_forcer_langue_navigateur : tag_langue calculé={tag_langue!r}.")

    # navigator.language : UNE seule valeur, le tag complet (ex: "en-GB").
    # navigator.languages : liste ordonnée pour l'en-tête Accept-Language --
    # le tag complet en premier (priorité), puis la langue seule en repli
    # (ex: ["en-GB", "en"]), pratique standard des vrais navigateurs Firefox.
    config["navigator.language"] = tag_langue
    if region and tag_langue != langue:
        config["navigator.languages"] = [tag_langue, langue]
    else:
        config["navigator.languages"] = [tag_langue]

    return _camoufox_reencoder_config_en_env(opts_from_options, config)


# DIAGNOSTIC (suite TEST DIAG 5 -- demande explicite utilisateur : "je veux
# que toi meme tu met humanize a false et true drectement dans le code") --
# interrupteur en dur, à modifier ICI directement pour retester : True
# reproduit le comportement actuel (Camoufox humanise lui-même CHAQUE
# page.mouse.move(), en plus de generate_mouse_path côté Python -- double
# humanisation soupçonnée d'être la cause des ~250-300ms/point observés),
# False désactive l'humanisation native de Camoufox pour ne garder QUE
# celle de generate_mouse_path (plus de trajet natif de son côté -- donc en
# théorie plus de coût caché dans page.mouse.move() lui-même).
CAMOUFOX_HUMANIZE_ACTIF = False


def _camoufox_forcer_humanize(opts_from_options: dict, actif: bool = CAMOUFOX_HUMANIZE_ACTIF) -> dict:
    """Force la clé 'humanize' du config Camoufox à la valeur `actif`,
    y compris sur un fingerprint DÉJÀ sauvegardé sur disque et rechargé
    tel quel (cf. docstring de camoufox_demarrer_navigateur : "même profil
    => mêmes valeurs concrètes à chaque relance" -- sans cette fonction,
    changer CAMOUFOX_HUMANIZE_ACTIF ci-dessus n'aurait AUCUN effet sur un
    profil déjà fingerprinté, exactement le même piège que celui déjà
    documenté et corrigé pour navigator.language dans
    _camoufox_forcer_langue_navigateur -- même mécanisme réutilisé ici à
    l'identique : lecture via _camoufox_extraire_config_brute (les
    morceaux CAMOU_CONFIG_N ne sont PAS une clé de premier niveau du dict,
    cf. sa docstring), écriture via _camoufox_reencoder_config_en_env.

    RAISON D'ÊTRE (cf. TEST DIAG 5) : 'humanize' est une option NATIVE de
    Camoufox (patchée côté navigateur en C++/Rust, PAS côté Python) --
    d'après sa docstring dans camoufox.utils.launch_options :
    "Humanize the cursor movement... The cursor typically takes up to 1.5
    seconds to move across the window." Cette instance utilise DÉJÀ
    generate_mouse_path côté Python (cf. action_camoufox_mousemove) pour
    produire un trajet humanisé point par point -- avec humanize=True
    ÉGALEMENT actif côté Camoufox, CHAQUE appel page.mouse.move() du
    trajet déclenche EN PLUS son propre mécanisme d'humanisation interne
    au navigateur, ce qui expliquerait les ~250-300ms/point observés dans
    TEST DIAG 5/TEST SIMPLE (position variable) alors que DIAG 3/4
    (position fixe, donc rien à humaniser côté Camoufox) restaient
    rapides. Idempotent : si 'humanize' vaut déjà `actif` dans le config,
    ne réécrit rien (retourne opts_from_options tel quel après
    vérification)."""
    config = _camoufox_extraire_config_brute(opts_from_options)
    if not config:
        log.info(
            "[camoufox][diag-humanize] _camoufox_forcer_humanize : config "
            "brute VIDE (extraction échouée ou aucun CAMOU_CONFIG_* trouvé) "
            "-- aucune modification, opts_from_options retourné tel quel."
        )
        return opts_from_options

    humanize_avant = config.get("humanize")
    max_time_avant = config.get("humanize:maxTime")
    log.info(
        f"[camoufox][diag-humanize] _camoufox_forcer_humanize : config brute "
        f"extraite ({len(config)} clé(s)), humanize actuel={humanize_avant!r}, "
        f"humanize:maxTime actuel={max_time_avant!r}, valeur cible={actif!r}."
    )

    if bool(humanize_avant) == bool(actif):
        log.info(
            f"[camoufox][diag-humanize] _camoufox_forcer_humanize : "
            f"humanize={actif!r} déjà en place -- aucune modification."
        )
        return opts_from_options

    if actif:
        config["humanize"] = True
    else:
        # Retire aussi humanize:maxTime -- une clé orpheline sans
        # 'humanize' actif n'a aucun effet côté Camoufox, mais autant
        # nettoyer pour que le fingerprint sauvegardé reste cohérent avec
        # ce qu'il décrit réellement.
        config.pop("humanize", None)
        config.pop("humanize:maxTime", None)

    log.info(
        f"[camoufox][diag-humanize] _camoufox_forcer_humanize : humanize "
        f"changé {humanize_avant!r} -> {actif!r}."
    )
    return _camoufox_reencoder_config_en_env(opts_from_options, config)


# PATCH (demande utilisateur : contrôler la taille de fenêtre/viewport des
# navigateurs Camoufox) -- interrupteur en dur, à modifier ICI directement :
# (largeur, hauteur) de la fenêtre EXTERNE (outer) en pixels CSS, transmise à
# camoufox.utils.launch_options(window=...) (cf. sa docstring : "Set a fixed
# window size instead of generating a random one"). Camoufox en déduit
# lui-même window.innerWidth/innerHeight (même décalage chrome que le
# fingerprint généré) et centre la fenêtre sur l'écran simulé. None = comportement
# d'avant ce patch (taille tirée aléatoirement par BrowserForge).
# Choisir une taille <= screen.availWidth/availHeight du fingerprint (sinon
# Camoufox la rabat lui-même, cf. clamp_window_dimensions) -- 1280x900 tient
# dans toutes les résolutions de bureau courantes (>= 1366x768 en largeur ;
# en hauteur, _camoufox_forcer_taille_fenetre rabat si l'écran est plus bas).
# >>> RÉGLAGE ACTUEL : None -> Camoufox/BrowserForge décide lui-même de la taille
# de fenêtre ET de l'écran simulé (plus rien n'est forcé).
CAMOUFOX_TAILLE_FENETRE = None

# PATCH (demande utilisateur : "je ne veux jamais avoir d'écran Camoufox dont
# la hauteur est inférieure à 1000, sinon on régénère") -- hauteur MINIMALE
# (screen.height, en pixels) acceptée pour un profil Camoufox. Appliquée :
#  - à la génération d'un nouveau fingerprint (min_height transmis à BrowserForge
#    + vérification a posteriori + régénération, cf. boucle dans
#    _camoufox_creer_contexte) ;
#  - au rechargement d'un fingerprint déjà sauvegardé : s'il est trop bas, il
#    est jeté et régénéré (écrasé sur disque). None/0 = désactivé.
CAMOUFOX_HAUTEUR_ECRAN_MIN = 1000


def _camoufox_hauteur_ecran_ok(opts_from_options: dict):
    """Retourne (ok, hauteur). ok=True si CAMOUFOX_HAUTEUR_ECRAN_MIN est
    désactivé, si la hauteur est introuvable (on ne régénère pas dans le doute)
    ou si screen.height >= CAMOUFOX_HAUTEUR_ECRAN_MIN."""
    if not CAMOUFOX_HAUTEUR_ECRAN_MIN:
        return True, None
    try:
        config = _camoufox_extraire_config_brute(opts_from_options) or {}
        haut = config.get("screen.height")
        if haut is None:
            return True, None
        haut = int(haut)
    except Exception:
        return True, None
    return haut >= int(CAMOUFOX_HAUTEUR_ECRAN_MIN), haut


def _camoufox_forcer_taille_fenetre(opts_from_options: dict, taille=None) -> dict:
    """Force la taille de fenêtre `taille` = (largeur_outer, hauteur_outer)
    dans un fingerprint DÉJÀ sauvegardé sur disque et rechargé tel quel --
    même piège que _camoufox_forcer_humanize/_camoufox_forcer_langue_navigateur :
    sans cette fonction, changer CAMOUFOX_TAILLE_FENETRE n'aurait aucun effet
    sur un profil déjà fingerprinté (launch_options(window=...) n'est
    appelée qu'à la génération). Reproduit camoufox.fingerprints.
    handle_window_size : outer = taille demandée (rabattue à screen.avail*
    si elle dépasse), inner = inner_actuel + (outer_nouveau - outer_actuel)
    (le décalage « chrome » du fingerprint est conservé), fenêtre centrée
    (window.screenX/screenY). Idempotent : ne réécrit rien si déjà en place.
    `taille` None/invalide -> opts_from_options retourné tel quel."""
    if not taille:
        return opts_from_options
    try:
        larg_voulue, haut_voulue = int(taille[0]), int(taille[1])
    except (TypeError, ValueError, IndexError):
        return opts_from_options
    if larg_voulue < 200 or haut_voulue < 200:
        return opts_from_options
    config = _camoufox_extraire_config_brute(opts_from_options)
    if not config:
        return opts_from_options

    ecran_l = config.get("screen.width")
    ecran_h = config.get("screen.height")
    dispo_l = config.get("screen.availWidth") or ecran_l
    dispo_h = config.get("screen.availHeight") or ecran_h
    if dispo_l:
        larg_voulue = min(larg_voulue, int(dispo_l))
    if dispo_h:
        haut_voulue = min(haut_voulue, int(dispo_h))

    if (config.get("window.outerWidth") == larg_voulue
            and config.get("window.outerHeight") == haut_voulue):
        return opts_from_options

    for axe, voulu in (("Width", larg_voulue), ("Height", haut_voulue)):
        outer_actuel = config.get(f"window.outer{axe}") or 0
        inner_actuel = config.get(f"window.inner{axe}")
        if inner_actuel:
            config[f"window.inner{axe}"] = max(int(inner_actuel) - int(outer_actuel) + voulu, 1)
        config[f"window.outer{axe}"] = voulu
    if ecran_l:
        config["window.screenX"] = max((int(ecran_l) - larg_voulue) // 2, 0)
    if ecran_h:
        config["window.screenY"] = max((int(ecran_h) - haut_voulue) // 2, 0)

    log.info(
        f"[camoufox] taille de fenêtre forcée : outer {larg_voulue}x{haut_voulue} "
        f"(inner {config.get('window.innerWidth')}x{config.get('window.innerHeight')}, "
        f"écran {ecran_l}x{ecran_h})."
    )
    return _camoufox_reencoder_config_en_env(opts_from_options, config)


def _camoufox_construire_config_lancement(profil, proxy=None):
    """Construit les kwargs à passer à camoufox.utils.launch_options(...)
    (PAS directement à AsyncCamoufox -- cf. camoufox_demarrer_navigateur)
    pour un fingerprint robuste et cohérent -- centralise TOUTE la
    logique anti-détection en un seul endroit (plutôt que dispersée dans
    camoufox_demarrer_navigateur) pour rester testable/ajustable
    séparément.

    CORRECTIF (le patch précédent passait `seed` et `slim` en kwargs
    top-level à AsyncCamoufox -- AUCUN des deux n'est un paramètre réel de
    l'API : `TypeError: BrowserType.launch_persistent_context() got an
    unexpected keyword argument 'seed'` en pratique, cf. logs. Vérifié
    via la doc/le code source du projet : les seuls leviers publics de
    contrôle du fingerprint sont `os`, `screen`, `fonts`, `locale`,
    `config` -- PAS de `seed` direct, et la persistance recommandée passe
    par `launch_options()` + `from_options` (cf. discussions daijro/
    camoufox #40, #151, #332), pas par un seed qu'on fournirait nous-même.
    `slim` n'existe pas non plus dans l'API publique -- retiré, sans
    remplacement, faute d'équivalent documenté.)

    Persistance du fingerprint PAR PROFIL : au premier lancement d'un
    profil donné, camoufox.utils.launch_options(...) est appelée une
    fois avec la config voulue (os multiple, proxy, geoip, humanize) et
    le dict résultant COMPLET (déjà résolu par BrowserForge : device,
    police, WebGL, etc. concrets, pas juste des préférences) est
    sauvegardé en JSON à côté du profil (cf.
    _camoufox_chemin_fingerprint). Aux lancements suivants, ce JSON est
    relu tel quel -- même profil => mêmes valeurs concrètes à chaque
    relance, cf. camoufox_demarrer_navigateur qui applique from_options.
    Cette fonction ne fait QUE construire la config de génération (utile
    seulement si aucun fingerprint n'est encore sauvegardé) ; c'est
    camoufox_demarrer_navigateur qui décide de générer vs recharger.

    Défensif par construction : chaque option est ajoutée
    individuellement dans un dict plutôt que passée en dur dans l'appel
    launch_options(...) -- si une version de camoufox installée chez
    l'utilisateur ne connaît pas un paramètre donné, l'appelant peut
    filtrer avant l'appel (cf. camoufox_demarrer_navigateur) sans devoir
    toucher à cette fonction."""
    config: dict = {
        # OS multiple plutôt qu'un seul figé : BrowserForge choisit PARMI
        # ceux-ci en respectant leurs parts de marché réelles (cf. doc :
        # "Linux 5% du temps") -- un seul OS fixé pour TOUS les profils
        # serait lui-même un signal (une flotte de bots partage rarement
        # le même OS exact). Le choix réel n'est plus déterminé par un
        # seed qu'on fournirait (cf. docstring ci-dessus) mais par le
        # tirage BrowserForge fait UNE SEULE FOIS à la génération, puis
        # figé dans le fichier de fingerprint persistant.
        "os": ("windows", "macos", "linux"),
        # Mouvement de curseur non linéaire (cf. doc Camoufox : "Anti-bot
        # systems analyze mouse movement patterns extensively... The
        # humanize feature generates natural cursor trajectories") --
        # indépendant du fingerprint statique, cible la détection
        # comportementale plutôt que déclarative.
        # DIAGNOSTIC (TEST DIAG 5) : piloté par CAMOUFOX_HUMANIZE_ACTIF
        # (cf. sa docstring/_camoufox_forcer_humanize) plutôt que codé en
        # dur à True -- ce n'est qu'un point d'entrée pour un profil
        # FRAÎCHEMENT généré ; camoufox_demarrer_navigateur appelle en
        # plus _camoufox_forcer_humanize sur la branche "recharge" pour
        # que le changement s'applique aussi aux profils déjà
        # fingerprintés (cf. sa docstring).
        "humanize": CAMOUFOX_HUMANIZE_ACTIF,
    }

    # DIAGNOSTIC (retour utilisateur : le navigateur camoufox ne se
    # connecte pas à internet) -- log de ce qui arrive réellement en entrée
    # de cette fonction, AVANT toute décision. Mot de passe jamais loggé en
    # clair (seulement sa présence/longueur), tout le reste si.
    log.info(
        f"[camoufox][diag-proxy] _camoufox_construire_config_lancement : "
        f"profil={profil!r}, proxy reçu={ {k: (v if k != 'password' else (f'<{len(v)} caractère(s)>' if v else v)) for k, v in (proxy or {}).items()} if proxy else None }."
    )

    if proxy and proxy.get("host"):
        port = proxy.get("port") or 8080
        proxy_playwright = {
            "server": f"{proxy.get('protocole') or 'http'}://{proxy['host']}:{port}",
        }
        if proxy.get("user"):
            proxy_playwright["username"] = proxy["user"]
            proxy_playwright["password"] = proxy.get("password") or ""
        config["proxy"] = proxy_playwright
        # cf. doc GeoIP & Proxy Support -- calcule longitude/latitude/
        # timezone/pays/locale à partir de l'IP RÉELLE DU PROXY (une
        # requête de résolution est faite à travers ce même proxy) et
        # usurpe l'IP WebRTC en conséquence -- LE point qui évite
        # l'incohérence la plus flagrante (proxy à l'étranger + fuseau
        # horaire/langue restés locaux). Nécessite l'extra
        # `camoufox[geoip]` (cf. message d'erreur plus bas si l'import
        # échoue) -- sans quoi Camoufox lève une erreur explicite au
        # lancement plutôt que de silencieusement ignorer geoip (préféré
        # à un faux sentiment de protection).
        config["geoip"] = True
        log.info(
            f"[camoufox][diag-proxy] _camoufox_construire_config_lancement : "
            f"proxy retenu -- server={proxy_playwright['server']!r}, "
            f"username={proxy_playwright.get('username')!r}, "
            f"password_fournie={'oui' if proxy_playwright.get('password') else 'non'}, "
            f"geoip=True."
        )
    else:
        # Pas de proxy = pas d'IP externe sur laquelle aligner quoi que
        # ce soit -- geoip resterait sans effet utile (il alignerait sur
        # l'IP réelle de la machine, déjà cohérente par définition).
        config["geoip"] = False
        log.info(
            f"[camoufox][diag-proxy] _camoufox_construire_config_lancement : "
            f"AUCUN proxy retenu (proxy={proxy!r}) -- l'instance sortira par "
            f"l'IP réelle de la machine, geoip=False."
        )

    # AJOUT (spec A.4 -- JSON de contraintes de résolution d'écran) --
    # lu depuis profils_config.json (cf. enregistrer_config_profil,
    # champ "contraintes_ecran" écrit UNE FOIS à la création du profil)
    # plutôt que reçu en paramètre : cette fonction n'est appelée QUE
    # depuis camoufox_demarrer_navigateur, qui connaît déjà `profil` et
    # peut donc résoudre lui-même sa config persistée, sans avoir besoin
    # d'étendre la signature de cette fonction ni celle de ses propres
    # appelants. N'a d'effet QUE la toute première fois qu'un profil est
    # lancé (cf. docstring de classe : cette fonction n'est consultée que
    # si aucun fingerprint.json n'existe encore pour ce profil) -- une
    # contrainte enregistrée après coup sur un profil déjà fingerprinté
    # n'a donc aucun effet rétroactif, cohérent avec "au moment de la
    # création du profil" (cf. décision tranchée de la spec).
    ecran = _construire_screen_camoufox_depuis_contraintes(
        obtenir_config_profil(profil).get("contraintes_ecran") if profil else None
    )
    if ecran is not None:
        config["screen"] = ecran
        log.info(f"[camoufox] contrainte de résolution appliquée pour le profil '{profil}' : {ecran!r}.")

    # PATCH (hauteur d'écran minimale, cf. CAMOUFOX_HAUTEUR_ECRAN_MIN) --
    # transmet min_height à BrowserForge pour que la grande majorité des
    # tirages soient déjà conformes (la boucle de vérification/régénération
    # plus bas rattrape le reste). Une contrainte explicite du profil dont
    # max_height est < au plancher est respectée telle quelle (choix utilisateur).
    if CAMOUFOX_HAUTEUR_ECRAN_MIN and _CamoufoxScreen is not None:
        try:
            if ecran is None:
                config["screen"] = _CamoufoxScreen(min_height=int(CAMOUFOX_HAUTEUR_ECRAN_MIN))
            else:
                import dataclasses as _dc
                min_actuel = getattr(ecran, "min_height", None) or 0
                max_actuel = getattr(ecran, "max_height", None)
                if min_actuel < CAMOUFOX_HAUTEUR_ECRAN_MIN and (
                        not max_actuel or max_actuel >= CAMOUFOX_HAUTEUR_ECRAN_MIN):
                    config["screen"] = _dc.replace(
                        ecran, min_height=int(CAMOUFOX_HAUTEUR_ECRAN_MIN))
        except Exception as exc_min:
            log.warning(f"[camoufox] plancher de hauteur d'écran non transmis ({exc_min!r}) -- "
                        f"la vérification a posteriori reste active.")

    # PATCH (taille de fenêtre, cf. CAMOUFOX_TAILLE_FENETRE) -- paramètre
    # officiel `window` de launch_options (taille OUTER fixe au lieu d'une
    # taille aléatoire). Ne concerne que la génération d'un nouveau
    # fingerprint ; les profils déjà générés sont corrigés au rechargement
    # par _camoufox_forcer_taille_fenetre.
    if CAMOUFOX_TAILLE_FENETRE:
        config["window"] = tuple(CAMOUFOX_TAILLE_FENETRE)
        log.info(f"[camoufox] taille de fenêtre demandée : {config['window']!r}.")

    return config


# ---------------------------------------------------------------------------
# Démarrage du navigateur -- équivalent demarrer_navigateur (client
# nodriver). Retourne un tuple explicite plutôt qu'un objet unique pour
# rester lisible à l'appel, même choix que le script standalone de
# validation (camoufox_instance_standalone.py).
# ---------------------------------------------------------------------------

# =====================================================================================
# PATCH DIAGNOSTIC PROFIL (sauvegarde / restauration / démarrage) -- demande utilisateur : "mettre les logs
# massivement au moment de la sauvegarde et du démarrage d'un profil pour voir les incohérences".
# Tout est tracé avec un préfixe fixe ET dans <profil>/autoniax_diag.log (ce journal voyage DANS le zip :
# après un téléchargement on retrouve l'historique des machines par lesquelles le profil est passé).
#   [PROFIL-SAUVEGARDE]   -- avant le zip : inventaire (taille, âge, sha256), cookies réellement sur disque,
#                            fingerprint, verrou navigateur ; écrit autoniax_manifest.json (dans le zip).
#   [PROFIL-RESTAURATION] -- après extraction : compare le dossier au manifeste (manquants / modifiés / en trop,
#                            machine d'origine vs actuelle, fingerprint avant/après).
#   [PROFIL-DEMARRAGE]    -- au lancement : décision fingerprint, fingerprint EFFECTIF, puis valeurs RÉELLES lues
#                            dans le navigateur (viewport, écran, UA, WebGL...) comparées à l'attendu et au dernier
#                            démarrage (autre machine ? headless différent ?).
# =====================================================================================
import socket as _diag_socket

NOM_MANIFESTE_PROFIL = "autoniax_manifest.json"
NOM_SNAPSHOT_RUNTIME = "autoniax_runtime_snapshot.json"
NOM_JOURNAL_DIAG_PROFIL = "autoniax_diag.log"
_DIAG_SEUIL_SHA256 = 2 * 1024 * 1024
_DIAG_PREFIXES_RESUME = ("screen", "window", "navigator", "webgl", "timezone", "locale", "geolocation",
                         "humanize", "fonts", "voices", "battery", "audio", "canvas")
_DIAG_DOSSIERS_IGNORES = {"cache2", "startupCache", "thumbnails", "shader-cache", "safebrowsing", "crashes",
                          "minidumps", "datareporting", "gmp-gmpopenh264", "saved-telemetry-pings",
                          "Cache", "Code Cache", "GPUCache", "DawnGraphiteCache", "DawnWebGPUCache", "GrShaderCache",
                          "ShaderCache", "component_crx_cache", "extensions_crx_cache"}
_DIAG_FICHIERS_VOLATILS = {NOM_MANIFESTE_PROFIL, NOM_SNAPSHOT_RUNTIME, NOM_JOURNAL_DIAG_PROFIL,
                           "lock", ".parentlock", "parent.lock"}
_DIAG_FICHIERS_CLES = ("camoufox_fingerprint.json", "autoniax_cookies.json", "cookies.sqlite", "cookies.sqlite-wal",
                       "cookies.sqlite-shm", "prefs.js", "user.js", "places.sqlite", "places.sqlite-wal", "key4.db",
                       "logins.json", "sessionstore.jsonlz4", "sessionstore-backups/recovery.jsonlz4",
                       "storage.sqlite", "permissions.sqlite", "webappsstore.sqlite")
_DIAG_ATTENDUS = (
    ("screenWidth", ("screen.width",)), ("screenHeight", ("screen.height",)),
    ("availWidth", ("screen.availWidth",)), ("availHeight", ("screen.availHeight",)),
    ("outerWidth", ("window.outerWidth",)), ("outerHeight", ("window.outerHeight",)),
    ("innerWidth", ("window.innerWidth",)), ("innerHeight", ("window.innerHeight",)),
    ("devicePixelRatio", ("window.devicePixelRatio",)),
    ("userAgent", ("navigator.userAgent",)), ("platform", ("navigator.platform",)),
    ("hardwareConcurrency", ("navigator.hardwareConcurrency",)), ("language", ("navigator.language",)),
    ("timeZone", ("timezone",)),
    ("webglRenderer", ("webGl:renderer", "webgl:renderer")), ("webglVendor", ("webGl:vendor", "webgl:vendor")),
)
_DIAG_JS_SNAPSHOT = """(() => {
  const r = {};
  r.innerWidth = window.innerWidth; r.innerHeight = window.innerHeight;
  r.outerWidth = window.outerWidth; r.outerHeight = window.outerHeight;
  r.screenWidth = screen.width; r.screenHeight = screen.height;
  r.availWidth = screen.availWidth; r.availHeight = screen.availHeight;
  r.colorDepth = screen.colorDepth; r.devicePixelRatio = window.devicePixelRatio;
  r.screenX = window.screenX; r.screenY = window.screenY;
  r.userAgent = navigator.userAgent; r.platform = navigator.platform;
  r.language = navigator.language; r.languages = (navigator.languages || []).join(',');
  r.hardwareConcurrency = navigator.hardwareConcurrency; r.maxTouchPoints = navigator.maxTouchPoints;
  try { r.timeZone = Intl.DateTimeFormat().resolvedOptions().timeZone; r.tzOffset = new Date().getTimezoneOffset(); } catch (e) {}
  try {
    const c = document.createElement('canvas');
    const gl = c.getContext('webgl') || c.getContext('experimental-webgl');
    r.webgl = gl ? 'ok' : 'AUCUN_CONTEXTE';
    try { r.webgl2 = document.createElement('canvas').getContext('webgl2') ? 'ok' : 'AUCUN_CONTEXTE'; } catch (e2) { r.webgl2 = 'erreur'; }
    if (gl) {
      const e = gl.getExtension('WEBGL_debug_renderer_info');
      r.webglVendor = e ? gl.getParameter(e.UNMASKED_VENDOR_WEBGL) : gl.getParameter(gl.VENDOR);
      r.webglRenderer = e ? gl.getParameter(e.UNMASKED_RENDERER_WEBGL) : gl.getParameter(gl.RENDERER);
    }
  } catch (e) { r.webglErr = String(e); }
  return r;
})()"""
_DIAG_DEMARRAGE: dict = {}  # profil -> {"source": ..., "resume": {...}} -- posé par _camoufox_creer_contexte


def _diag_info_machine() -> dict:
    import platform as _platform
    info = {"hote": _diag_socket.gethostname(), "os": _platform.platform(), "python": _platform.python_version(),
            "display": os.environ.get("DISPLAY") or None, "data_dir": os.environ.get("AUTONIAX_DATA_DIR") or None}
    try:
        import importlib.metadata as _md
        for nom in ("camoufox", "playwright", "browserforge"):
            try:
                info[nom] = _md.version(nom)
            except Exception:
                info[nom] = None
    except Exception:
        pass
    return info


def _diag_log(dossier, niveau: str, message: str) -> None:
    """Log normal + copie dans <profil>/autoniax_diag.log (plafonné ~300 Ko, garde les 150 derniers Ko)."""
    try:
        getattr(log, niveau)(message)
    except Exception:
        pass
    if not dossier:
        return
    try:
        chemin = os.path.join(str(dossier), NOM_JOURNAL_DIAG_PROFIL)
        if os.path.isfile(chemin) and os.path.getsize(chemin) > 300_000:
            with open(chemin, "rb") as f:
                f.seek(-150_000, 2)
                reste = f.read()
            with open(chemin, "wb") as f:
                f.write(reste)
        with open(chemin, "a", encoding="utf-8") as f:
            f.write(f"{time.strftime('%Y-%m-%d %H:%M:%S')} [{_diag_socket.gethostname()}] {niveau.upper()} {message}\n")
    except Exception:
        pass


def _diag_sha256(chemin) -> Optional[str]:
    import hashlib
    try:
        h = hashlib.sha256()
        with open(chemin, "rb") as f:
            for bloc in iter(lambda: f.read(1024 * 1024), b""):
                h.update(bloc)
        return h.hexdigest()
    except OSError:
        return None


def _diag_resume_fingerprint(opts, inclure_machine: bool = False) -> dict:
    """Résumé lisible/comparable d'un fingerprint (dict from_options Camoufox). Clés machine-spécifiques (headless)
    incluses seulement si inclure_machine=True (elles sont retirées du zip à l'envoi)."""
    res: dict = {}
    if not isinstance(opts, dict):
        return res
    try:
        cfg = _camoufox_extraire_config_brute(opts) or {}
    except Exception:
        cfg = {}
    for k in sorted(cfg):
        if str(k).lower().startswith(_DIAG_PREFIXES_RESUME):
            v = cfg[k]
            if isinstance(v, (list, tuple, dict)):
                res[k] = f"<{type(v).__name__}:{len(v)}>"
            else:
                sv = str(v)
                res[k] = v if len(sv) <= 120 else sv[:117] + "..."
    proxy = opts.get("proxy") or {}
    res["_proxy_server"] = proxy.get("server")
    res["_proxy_user"] = proxy.get("username")
    res["_nb_cles_config"] = len(cfg)
    if inclure_machine:
        res["_headless"] = opts.get("headless")
    return res


def _diag_diff(avant: dict, apres: dict) -> list:
    return [f"{k}: {avant.get(k)!r} -> {apres.get(k)!r}"
            for k in sorted(set(avant) | set(apres), key=str) if avant.get(k) != apres.get(k)]


def _diag_lire_fingerprint(dossier) -> Optional[dict]:
    try:
        with open(os.path.join(str(dossier), "camoufox_fingerprint.json"), "r", encoding="utf-8") as f:
            data = json.load(f)
        return data if isinstance(data, dict) else None
    except Exception:
        return None


def _diag_scanner_profil(dossier) -> dict:
    racine = os.path.abspath(str(dossier))
    fichiers: dict = {}
    ignores_nb = ignores_taille = 0
    for rep, _sous, noms in os.walk(racine):
        rel_rep = os.path.relpath(rep, racine).replace(os.sep, "/")
        parties = [] if rel_rep == "." else rel_rep.split("/")
        ignore = any(p in _DIAG_DOSSIERS_IGNORES for p in parties)
        for nom in noms:
            chemin = os.path.join(rep, nom)
            try:
                st = os.stat(chemin)
            except OSError:
                continue
            if ignore:
                ignores_nb += 1
                ignores_taille += st.st_size
                continue
            rel = nom if not parties else "/".join(parties) + "/" + nom
            if rel in _DIAG_FICHIERS_VOLATILS or nom in _DIAG_FICHIERS_VOLATILS:
                continue
            sha = _diag_sha256(chemin) if st.st_size <= _DIAG_SEUIL_SHA256 else None
            fichiers[rel] = {"t": st.st_size, "m": int(st.st_mtime), "h": sha}
    total = sum(v["t"] for v in fichiers.values()) + ignores_taille
    return {"fichiers": fichiers, "nb": len(fichiers), "total": total,
            "ignores_nb": ignores_nb, "ignores_taille": ignores_taille}


def _diag_compter_cookies_sqlite(dossier) -> Optional[dict]:
    """Ouvre une COPIE de cookies.sqlite (+wal/shm) et compte ce qui est RÉELLEMENT écrit sur disque."""
    import shutil as _sh, sqlite3 as _sq, tempfile as _tf
    src = os.path.join(str(dossier), "cookies.sqlite")
    if not os.path.isfile(src):
        return None
    tmp = _tf.mkdtemp(prefix="autoniax_diag_ck_")
    try:
        for suffixe in ("", "-wal", "-shm"):
            if os.path.isfile(src + suffixe):
                _sh.copy2(src + suffixe, os.path.join(tmp, "cookies.sqlite" + suffixe))
        con = _sq.connect(os.path.join(tmp, "cookies.sqlite"))
        try:
            lignes = con.execute("SELECT host, expiry FROM moz_cookies").fetchall()
        finally:
            con.close()
        maintenant = time.time()
        valides = 0
        for _h, exp in lignes:
            e = float(exp or 0)
            e = e / 1000.0 if e > 1e11 else e
            if e > maintenant:
                valides += 1
        hotes = {}
        for h, _e in lignes:
            hotes[h] = hotes.get(h, 0) + 1
        return {"total": len(lignes), "non_expires": valides, "nb_hotes": len(hotes),
                "top_hotes": sorted(hotes.items(), key=lambda t: -t[1])[:6]}
    except Exception as exc:
        return {"erreur": repr(exc)}
    finally:
        _sh.rmtree(tmp, ignore_errors=True)


def _diag_resume_cookies_json(dossier) -> Optional[dict]:
    chemin = os.path.join(str(dossier), NOM_FICHIER_COOKIES_PROFIL)
    try:
        with open(chemin, "r", encoding="utf-8") as f:
            cookies = json.load(f)
        session = sum(1 for c in cookies if isinstance(c, dict) and (c.get("expires") in (None, -1) or c.get("expires", 0) <= 0))
        return {"total": len(cookies), "session": session,
                "domaines": len({c.get("domain") for c in cookies if isinstance(c, dict)}),
                "age_s": int(time.time() - os.path.getmtime(chemin))}
    except FileNotFoundError:
        return None
    except Exception as exc:
        return {"erreur": repr(exc)}


def diag_ecrire_manifeste_profil(dossier, nom: str = "") -> None:
    """[PROFIL-SAUVEGARDE] -- AVANT le zip : inventaire + logs massifs + écriture de autoniax_manifest.json."""
    dossier = str(dossier)
    P = "[PROFIL-SAUVEGARDE]"
    nom = nom or os.path.basename(os.path.normpath(dossier))
    scan = _diag_scanner_profil(dossier)
    machine = _diag_info_machine()
    _diag_log(dossier, "info", f"{P} '{nom}' : {scan['nb']} fichier(s) suivi(s) + {scan['ignores_nb']} de cache ignoré(s) "
                               f"({scan['ignores_taille'] / 1048576:.1f} Mo), total {scan['total'] / 1048576:.1f} Mo -- {dossier}")
    _diag_log(dossier, "info", f"{P} machine : {machine}")
    for rel, v in sorted(scan["fichiers"].items(), key=lambda t: -t[1]["t"])[:8]:
        _diag_log(dossier, "info", f"{P} gros fichier : {rel} = {v['t'] / 1024:.0f} Ko")
    maintenant = time.time()
    for cle in _DIAG_FICHIERS_CLES:
        v = scan["fichiers"].get(cle)
        if v is None:
            _diag_log(dossier, "info", f"{P} fichier clé {cle} : ABSENT")
        else:
            _diag_log(dossier, "info", f"{P} fichier clé {cle} : {v['t']} o, modifié il y a {int(maintenant - v['m'])}s, "
                                       f"sha256={(v['h'] or 'non calculé (gros)')[:16]}")
    verrous = [n for n in ("lock", ".parentlock", "parent.lock") if os.path.lexists(os.path.join(dossier, n))]
    if verrous:
        _diag_log(dossier, "warning", f"{P} NAVIGATEUR PROBABLEMENT ACTIF (verrou {verrous} présent) : zip pris À CHAUD -- "
                                      f"cookies de session absents de cookies.sqlite, fichiers possiblement incohérents.")
    ck_sql = _diag_compter_cookies_sqlite(dossier)
    _diag_log(dossier, "info", f"{P} cookies.sqlite (sur disque) : {ck_sql if ck_sql is not None else 'absent'}")
    ck_json = _diag_resume_cookies_json(dossier)
    _diag_log(dossier, "info", f"{P} {NOM_FICHIER_COOKIES_PROFIL} (cookies vivants, session comprise) : "
                               f"{ck_json if ck_json is not None else 'absent'}")
    opts = _diag_lire_fingerprint(dossier)
    resume = _diag_resume_fingerprint(opts)
    if opts is None:
        _diag_log(dossier, "warning", f"{P} AUCUN camoufox_fingerprint.json lisible dans ce profil.")
    for k, v in resume.items():
        _diag_log(dossier, "info", f"{P} fingerprint {k} = {v!r}")
    manifeste = {"version": 1, "nom": nom, "date": time.strftime("%Y-%m-%d %H:%M:%S"), "machine": machine,
                 "resume_fingerprint": resume, "cookies_sqlite": ck_sql, "cookies_json": ck_json,
                 "nb": scan["nb"], "total": scan["total"], "fichiers": scan["fichiers"]}
    chemin = os.path.join(dossier, NOM_MANIFESTE_PROFIL)
    with open(chemin + ".tmp", "w", encoding="utf-8") as f:
        json.dump(manifeste, f, ensure_ascii=False)
    os.replace(chemin + ".tmp", chemin)
    _diag_log(dossier, "info", f"{P} manifeste écrit ({NOM_MANIFESTE_PROFIL}, {scan['nb']} fichiers) -- part dans le zip.")


def diag_verifier_profil_extrait(dossier, nom: str = "", contexte: str = "") -> None:
    """[PROFIL-RESTAURATION] -- APRÈS extraction : compare au manifeste. Ne lève jamais."""
    try:
        dossier = str(dossier)
        P = f"[PROFIL-RESTAURATION]{'[' + contexte + ']' if contexte else ''}"
        nom = nom or os.path.basename(os.path.normpath(dossier))
        machine = _diag_info_machine()
        _diag_log(dossier, "info", f"{P} '{nom}' extrait dans {dossier} ; machine actuelle : {machine}")
        try:
            with open(os.path.join(dossier, NOM_MANIFESTE_PROFIL), "r", encoding="utf-8") as f:
                man = json.load(f)
        except Exception:
            man = None
        scan = _diag_scanner_profil(dossier)
        _diag_log(dossier, "info", f"{P} dossier extrait : {scan['nb']} fichier(s) suivi(s) + {scan['ignores_nb']} de cache, "
                                   f"{scan['total'] / 1048576:.1f} Mo")
        ck_avant = None
        if man is None:
            _diag_log(dossier, "warning", f"{P} AUCUN manifeste ({NOM_MANIFESTE_PROFIL}) dans le profil reçu : envoyé AVANT ce "
                                          f"patch, impossible de vérifier l'intégrité.")
        else:
            attendus = man.get("fichiers") or {}
            manquants = [r for r in attendus if r not in scan["fichiers"]]
            en_trop = [r for r in scan["fichiers"] if r not in attendus]
            taille_diff, sha_diff = [], []
            for rel, v in attendus.items():
                actuel = scan["fichiers"].get(rel)
                if actuel is None or rel == "camoufox_fingerprint.json":  # nettoyé volontairement dans le zip
                    continue
                if actuel["t"] != v.get("t"):
                    taille_diff.append(f"{rel} ({v.get('t')} -> {actuel['t']} o)")
                elif v.get("h") and actuel["h"] and v["h"] != actuel["h"]:
                    sha_diff.append(rel)
            src_m = man.get("machine") or {}
            _diag_log(dossier, "info", f"{P} manifeste : envoyé le {man.get('date')} depuis {src_m.get('hote')} "
                                       f"({src_m.get('os')}), {man.get('nb')} fichiers, camoufox={src_m.get('camoufox')}")
            niveau = "info" if not (manquants or taille_diff or sha_diff) else "warning"
            _diag_log(dossier, niveau, f"{P} intégrité : manquants={len(manquants)} taille_différente={len(taille_diff)} "
                                       f"contenu_différent={len(sha_diff)} en_trop(anciens fichiers restés)={len(en_trop)}")
            for titre, liste in (("MANQUANT", manquants), ("TAILLE DIFFÉRENTE (modifié pendant le zip ?)", taille_diff),
                                 ("CONTENU DIFFÉRENT", sha_diff), ("EN TROP", en_trop)):
                for item in liste[:25]:
                    _diag_log(dossier, "warning", f"{P} {titre} : {item}")
            for cle in ("os", "python", "camoufox", "playwright", "browserforge"):
                if src_m.get(cle) != machine.get(cle):
                    _diag_log(dossier, "warning", f"{P} DIFFÉRENCE machine {cle} : origine={src_m.get(cle)!r} actuelle={machine.get(cle)!r}")
            diff_fp = _diag_diff(man.get("resume_fingerprint") or {}, _diag_resume_fingerprint(_diag_lire_fingerprint(dossier)))
            if diff_fp:
                for d in diff_fp:
                    _diag_log(dossier, "warning", f"{P} FINGERPRINT différent de celui envoyé -- {d}")
            else:
                _diag_log(dossier, "info", f"{P} fingerprint identique à celui du manifeste.")
            ck_avant = man.get("cookies_sqlite")
        ck_sql = _diag_compter_cookies_sqlite(dossier)
        _diag_log(dossier, "info", f"{P} cookies.sqlite après extraction : {ck_sql if ck_sql is not None else 'absent'}")
        _diag_log(dossier, "info", f"{P} {NOM_FICHIER_COOKIES_PROFIL} après extraction : {_diag_resume_cookies_json(dossier)}")
        if isinstance(ck_avant, dict) and isinstance(ck_sql, dict) and ck_avant.get("total") != ck_sql.get("total"):
            _diag_log(dossier, "warning", f"{P} cookies.sqlite : {ck_avant.get('total')} cookie(s) à l'envoi -> {ck_sql.get('total')} maintenant.")
    except Exception as exc:
        log.warning(f"[PROFIL-RESTAURATION] vérification impossible ({exc!r})")


def _zipper_dossier_profil_diag(chemin_dossier: str) -> Path:
    """Enveloppe de _zipper_dossier_profil POUR LES PROFILS UNIQUEMENT (le zip du dossier service API et des
    projets, qui appelle aussi _zipper_dossier_profil, reste inchangé) : inventaire/manifeste AVANT, stats du zip APRÈS."""
    nom = os.path.basename(os.path.normpath(str(chemin_dossier)))
    try:
        diag_ecrire_manifeste_profil(chemin_dossier, nom)
    except Exception as exc:
        log.warning(f"[PROFIL-SAUVEGARDE] diagnostic avant zip impossible ({exc!r}) -- le zip continue.")
    chemin_zip = _zipper_dossier_profil(chemin_dossier)
    try:
        with zipfile.ZipFile(chemin_zip, "r") as z:
            noms = [i.filename for i in z.infolist() if not i.filename.endswith("/")]
        _diag_log(chemin_dossier, "info", f"[PROFIL-SAUVEGARDE] zip créé : {Path(chemin_zip).stat().st_size / 1048576:.1f} Mo, "
                                          f"{len(noms)} entrée(s), manifeste dans le zip={NOM_MANIFESTE_PROFIL in noms}, "
                                          f"fingerprint dans le zip={'camoufox_fingerprint.json' in noms}, "
                                          f"cookies json dans le zip={NOM_FICHIER_COOKIES_PROFIL in noms}")
    except Exception as exc:
        log.warning(f"[PROFIL-SAUVEGARDE] statistiques du zip impossibles ({exc!r})")
    return chemin_zip


