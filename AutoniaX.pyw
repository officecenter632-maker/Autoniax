class EditeurCodeMonokai(QPlainTextEdit):
    """Zone de code style Sublime Text : fond Monokai, numéros de ligne, ligne courante surlignée, coloration Python."""
    FOND = "#272822"
    TEXTE = "#F8F8F2"
    LIGNE_COURANTE = "#3E3D32"
    SELECTION = "#49483E"
    FOND_NUMEROS = "#1E1F1C"
    NUMEROS = "#90908A"

    def __init__(self, parent=None):
        super().__init__(parent)
        police = QFont("Consolas")
        police.setStyleHint(QFont.Monospace)
        police.setFixedPitch(True)
        police.setPointSize(11)
        self.setFont(police)
        self.setLineWrapMode(QPlainTextEdit.NoWrap)
        self.setTabStopDistance(4 * QFontMetrics(police).horizontalAdvance(" "))
        self.setFrameShape(QFrame.NoFrame)
        self.setStyleSheet(
            f"QPlainTextEdit {{ background:{self.FOND}; color:{self.TEXTE}; selection-background-color:{self.SELECTION}; }}"
        )
        self._zone_numeros = _ZoneNumerosLignes(self)
        self.blockCountChanged.connect(self._maj_marge)
        self.updateRequest.connect(self._maj_zone_numeros)
        self.cursorPositionChanged.connect(self._surligner_ligne)
        self._maj_marge()
        self._surligner_ligne()
        self.coloration = ColorationMonokai(self.document())

    def largeur_numeros(self):
        chiffres = max(3, len(str(max(1, self.blockCount()))))
        return 18 + self.fontMetrics().horizontalAdvance("9") * chiffres

    def _maj_marge(self, _=0):
        self.setViewportMargins(self.largeur_numeros(), 0, 0, 0)

    def _maj_zone_numeros(self, rect, dy):
        if dy:
            self._zone_numeros.scroll(0, dy)
        else:
            self._zone_numeros.update(0, rect.y(), self._zone_numeros.width(), rect.height())
        if rect.contains(self.viewport().rect()):
            self._maj_marge()

    def resizeEvent(self, event):
        super().resizeEvent(event)
        cr = self.contentsRect()
        self._zone_numeros.setGeometry(QRect(cr.left(), cr.top(), self.largeur_numeros(), cr.height()))

    def peindre_numeros(self, event):
        p = QPainter(self._zone_numeros)
        p.fillRect(event.rect(), QColor(self.FOND_NUMEROS))
        bloc = self.firstVisibleBlock()
        n = bloc.blockNumber()
        haut = round(self.blockBoundingGeometry(bloc).translated(self.contentOffset()).top())
        bas = haut + round(self.blockBoundingRect(bloc).height())
        courante = self.textCursor().blockNumber()
        while bloc.isValid() and haut <= event.rect().bottom():
            if bloc.isVisible() and bas >= event.rect().top():
                p.setPen(QColor(self.TEXTE if n == courante else self.NUMEROS))
                p.drawText(0, haut, self._zone_numeros.width() - 8, self.fontMetrics().height(), Qt.AlignRight, str(n + 1))
            bloc = bloc.next()
            haut = bas
            bas = haut + round(self.blockBoundingRect(bloc).height())
            n += 1
        p.end()

    def _surligner_ligne(self):
        sel = QTextEdit.ExtraSelection()
        sel.format.setBackground(QColor(self.LIGNE_COURANTE))
        sel.format.setProperty(QTextFormat.FullWidthSelection, True)
        sel.cursor = self.textCursor()
        sel.cursor.clearSelection()
        self.setExtraSelections([sel])
        self._zone_numeros.update()

    def keyPressEvent(self, event):
        if not self.isReadOnly() and event.key() == Qt.Key_Tab and not event.modifiers():
            self.insertPlainText("    ")
            return
        super().keyPressEvent(event)


class VisionneuseLibCode(QDialog):
    """Fenêtre secondaire (non modale) qui montre le code d'une lib avec coloration Monokai. Boutons : Éditer (puis
    Enregistrer / Annuler), Mettre à jour depuis le presse-papiers, Supprimer, Copier le fichier. S'ouvre par double-clic
    sur une lib du panneau Lib ; se met à jour toute seule quand la lib change, et se ferme si elle est supprimée.
    Barre de titre native sombre (Windows) pour rester dans le thème Monokai."""

    _STYLE_BOUTON = (
        "QToolButton { background:#3E3D32; color:#F8F8F2; border:1px solid #49483E; border-radius:5px; padding:5px 10px; }"
        "QToolButton:hover { background:#49483E; }"
        "QToolButton:disabled { color:#75715E; background:#2D2E27; }"
    )

    def __init__(self, ecran, lib_id: str, parent=None):
        super().__init__(parent)
        self._ecran = ecran
        self._lib_id = lib_id
        self._edition = False
        self.setAttribute(Qt.WA_DeleteOnClose, True)
        self.resize(940, 660)
        self.setStyleSheet("QDialog { background:#1E1F1C; }")
        lay = QVBoxLayout(self)
        lay.setContentsMargins(0, 0, 0, 0)
        lay.setSpacing(0)

        barre = QWidget(self)
        barre.setStyleSheet("background:#1E1F1C;")
        bl = QHBoxLayout(barre)
        bl.setContentsMargins(10, 8, 10, 8)
        bl.setSpacing(8)
        self.bouton_editer = self._bouton("mdi6.pencil-outline", "Éditer", self._basculer_edition, "Modifier le code ici (Ctrl+S pour enregistrer)")
        self.bouton_annuler = self._bouton("mdi6.close", "Annuler", self._annuler_edition, "Abandonner les modifications (Échap)")
        self.bouton_annuler.setVisible(False)
        self.bouton_maj = self._bouton("mdi6.clipboard-arrow-down-outline", "Mettre à jour depuis le presse-papiers", self._maj_presse_papiers,
                                       "Remplace le code de la lib par le contenu du presse-papiers")
        self.bouton_supprimer = self._bouton("mdi6.trash-can-outline", "Supprimer", self._supprimer, "Supprimer cette lib")
        self.bouton_copier = self._bouton("mdi6.content-copy", "Copier le fichier", self._copier_fichier, "Copier le fichier .py (collable dans l'Explorateur)")
        for b in (self.bouton_editer, self.bouton_annuler, self.bouton_maj, self.bouton_supprimer, self.bouton_copier):
            bl.addWidget(b)
        bl.addStretch(1)
        lay.addWidget(barre)

        self.editeur = EditeurCodeMonokai(self)
        self.editeur.setReadOnly(True)
        lay.addWidget(self.editeur, 1)

        self.label_statut = QLabel(self)
        self.label_statut.setStyleSheet("background:#1E1F1C; color:#90908A; font-size:12px; padding:4px 12px;")
        lay.addWidget(self.label_statut)

        QShortcut(QKeySequence("Ctrl+S"), self, activated=self._enregistrer_si_edition)
        self.rafraichir()

    def showEvent(self, event):
        super().showEvent(event)
        _appliquer_barre_titre_sombre(self)
        QTimer.singleShot(0, lambda: _appliquer_barre_titre_sombre(self))

    def _bouton(self, icone, texte, action, tip):
        b = QToolButton(self)
        b.setIcon(qta.icon(icone, color="#F8F8F2"))
        b.setText(texte)
        b.setToolTip(tip)
        b.setToolButtonStyle(Qt.ToolButtonTextBesideIcon)
        b.setCursor(Qt.PointingHandCursor)
        b.setStyleSheet(self._STYLE_BOUTON)
        b.clicked.connect(lambda _=False: action())
        return b

    def _lib(self):
        return self._ecran.project.find_lib(self._lib_id)

    def rafraichir(self):
        lib = self._lib()
        if lib is None:
            self.close()
            return
        self.setWindowTitle(f"{lib['nom']}.py")
        if not self._edition:
            barre_v = self.editeur.verticalScrollBar().value()
            self.editeur.setPlainText(lib["code"])
            self.editeur.verticalScrollBar().setValue(barre_v)
        nb = len(lib["code"].splitlines())
        self.label_statut.setText(f"{lib['nom']}.py  ·  {nb} lignes  ·  Python  ·  UTF-8  ·  modifiée le {lib.get('modifie_le') or '—'}"
                                  + ("  ·  ÉDITION" if self._edition else "  ·  lecture seule"))

    def _regler_mode_edition(self, actif: bool):
        self._edition = actif
        self.editeur.setReadOnly(not actif)
        self.bouton_annuler.setVisible(actif)
        for b in (self.bouton_maj, self.bouton_supprimer, self.bouton_copier):
            b.setEnabled(not actif)
        self.bouton_editer.setText("Enregistrer" if actif else "Éditer")
        self.bouton_editer.setIcon(qta.icon("mdi6.content-save-outline" if actif else "mdi6.pencil-outline", color="#F8F8F2"))
        if actif:
            self.editeur.setFocus()

    def _basculer_edition(self):
        if not self._edition:
            self._regler_mode_edition(True)
            self.rafraichir()
        else:
            self._enregistrer_si_edition()

    def _enregistrer_si_edition(self):
        if not self._edition:
            return
        if self._ecran._enregistrer_code_lib(self._lib_id, self.editeur.toPlainText(), parent=self):
            self._regler_mode_edition(False)
            self.rafraichir()

    def _annuler_edition(self):
        if self._edition:
            self._regler_mode_edition(False)
            self.rafraichir()

    def reject(self):
        if self._edition:
            self._annuler_edition()
        else:
            super().reject()

    def _maj_presse_papiers(self):
        self._ecran._maj_lib_depuis_presse_papiers(self._lib_id)

    def _supprimer(self):
        self._ecran._supprimer_lib(self._lib_id)

    def _copier_fichier(self):
        self._ecran._copier_code_lib(self._lib_id)


class TaskConfigScreen(QWidget):
    """
    Écran TaskConfig (section sidebar) : scripts d'automatisation en pur
    Python (décision explicite utilisateur).

    - Vue par défaut : grille de cards des Tasks sauvegardés (même pattern
      que ServiceAPIScreen), + bouton flottant "+ Nouveau Task".
    - Clic sur une card -> ouvre l'éditeur du Task : panneau gauche des
      composants importés (groupés par ServiceAPI, clic = copie le nom),
      éditeur de script Python à droite (coloration syntaxique).
    - Bouton "+" du panneau gauche -> sélection d'un ServiceAPI parmi ceux
      du Project pas encore importés dans ce Task, PUIS sélection de
      l'instance nodriver (cf. discussion "screen") sur laquelle TOUS les
      composants de ce ServiceAPI seront recherchés dans CE Task -- tous
      ses composants arrivent d'un coup (décision explicite utilisateur :
      import par ServiceAPI entier, jamais composant par composant). Ce
      lien ServiceAPI -> instance_id est stocké dans
      Task.services_api_importes (dict), propre à ce Task -- le même
      ServiceAPI importé dans un autre Task peut être lié à une instance
      différente, cf. docstring de Task.
    - Éditeur de script : thème "Claude" (coloration syntaxique + popup
      d'auto-complétion des méthodes de ComposantExecutable après un ".",
      cf. TaskScriptEditor), taille de police configurable (ReglagesApp).

    Client réseau dédié (pattern identique à DashboardScreen/
    TestComposantScreen -- id_client uuid propre, cf. avertissement
    critique dans ClientReseauAutoniaX : jamais d'id_client partagé entre
    deux connexions, sous peine de collision silencieuse côté serveur) :
    UNIQUEMENT utilisé ici pour connaître la liste des instances
    actuellement actives (list_instances), afin de peupler le menu de
    sélection d'instance au moment d'importer un ServiceAPI -- pas de
    streaming, pas de liaison/link, pas d'envoi de commande d'action
    depuis cet écran (cf. décision utilisateur : "pas de stream en
    continu" -- l'exécution réelle d'un Task capture à la demande via
    capture_propre, jamais un flux poussé en continu comme l'aperçu
    Dashboard/TestComposant)."""

    demande_ouvrir_coordonnee_action = Signal(str)  # relais depuis le panneau composants (nom complet du composant)

    # PATCH B.5 (cf. cahier des charges patchs.md -- "ouvrir par défaut
    # dans la zone d'application ... pouvoir la détacher") -- même patron
    # que demande_ouvrir_coordonnee_action juste au-dessus : ce Screen
    # n'accède jamais directement à ApplicationsScreen/MainWindow, il émet
    # et laisse MainWindow router (cf. _ouvrir_rendu_task_reseau côté
    # MainWindow). widget est TOUJOURS self._fenetre_rendu_reseau (déjà
    # construite, jamais reconstruite par le récepteur -- cf. docstring de
    # ApplicationsScreen.ouvrir_rendu_task_reseau).
    demande_ouvrir_rendu_reseau = Signal(object, str)  # (widget FenetreRenduTaskReseau, titre)

    # ------------------------------------------------------------------
    # AJOUT (mode réseau, fusion de l'ancien écran "Notebook Distant" --
    # cf. Task.mode_execution) : signaux sortants, branchés par MainWindow
    # sur ClientServeurT (même patron que demande_ouvrir_coordonnee_action
    # ci-dessus -- ce Screen n'appelle jamais ClientServeurT directement,
    # sauf pour definir_client_reseau_t qui ne fait qu'émettre des
    # commandes, cf. sa docstring).
    # ------------------------------------------------------------------
    demande_liste_stockage = Signal()  # -> ClientServeurT.demander_liste_stockage
    # PATCH (demande explicite utilisateur : lister les profils PRÉSENTS
    # SUR LE sAutoniax sélectionné, pas tous les profils du cloud) --
    # (id_executant) -> ClientServeurT.demander_liste_profils_locaux_
    # sautoniax. Réponse via liste_profils_locaux_sautoniax_resultat_recu,
    # câblée par MainWindow sur sur_resultat_liste_profils_locaux_
    # sautoniax ci-dessous.
    demande_liste_profils_locaux_sautoniax = Signal(str)
    # (id_executant, profil_nom, session_id) -- session_id généré ICI (pas
    # par ClientServeurT.initialiser_notebook_distant) pour pouvoir
    # l'enregistrer dans self._sessions_initialisation_reseau AVANT que
    # MainWindow ne fasse l'appel réseau, sans risque de rater un log/
    # résultat arrivant plus vite que le retour de cet appel (Option A,
    # même raisonnement que l'ancien couple demande_execution_notebook_
    # distant/sur_session_execution_demarree).
    demande_initialisation_notebook_distant = Signal(str, str, str)
    # PATCH (bouton "Fermer") -- (id_executant, session_id), même
    # raisonnement EXACT que demande_initialisation_notebook_distant
    # ci-dessus (session_id généré ICI pour l'enregistrer dans self.
    # _sessions_fermeture_reseau AVANT l'appel réseau) -- pas de
    # profil_nom ici, la fermeture ne cible aucun profil précis.
    demande_fermeture_notebook_distant = Signal(str, str)
    demande_capture_ponctuelle_notebook_distant = Signal(str, str)  # (id_executant, instance_id) -- bouton "Rafraîchir" de PanneauRenduInstance, mode réseau
    demande_taux_capture_notebook_distant = Signal(str, str, float)  # (id_executant, instance_id, fps) -- case "Automatique"/spin FPS de PanneauRenduInstance, mode réseau
    # --- Mode clone (SPEC_mode_execution_clone.md, section 4.3/4.7) ---
    # (id_executant) -> ClientServeurT.demander_profils_sautoniax, MÊME
    # méthode réseau que l'existant -- signal dédié plutôt que de
    # réutiliser un signal existant, pour distinguer sans ambiguïté une
    # réponse profils_sautoniax_recu destinée au panneau clone de toute
    # autre demande de profils sur cet écran (cf. spec §4.3, dernier
    # paragraphe : solution retenue = signal dédié plutôt que flag de
    # contexte, pour éviter les races si plusieurs demandes coexistent).
    demande_profils_sautoniax_clone = Signal(str)
    # (id_executant, instance_id) -> ClientServeurT.demander_capture_
    # ponctuelle_instance -- PAS demande_capture_ponctuelle_notebook_
    # distant (celui-ci suppose instance_id == id_executant, convention
    # mono-profil qui ne tient plus pour un profil clone, cf. spec §0/§4.7).
    # Réponse générique via capture_recue, déjà routée par
    # sur_capture_reseau_recue (cf. section 5.2 de la spec).
    demande_capture_ponctuelle_instance_clone = Signal(str, str)
    # PATCH (mode local dans le panneau clone -- cf. SPEC_mode_clone_
    # local.md, section 3.9) : "Kill" (ferme le navigateur entier) pour un
    # profil LOCAL du panneau clone. MÊME patron que Api2ApiScreen.
    # demande_demarrer_profil_local (cf. sa docstring : "jamais d'appel
    # direct entre deux écrans-frères") -- ce Screen n'accède jamais
    # directement à ProfilsInstancesScreen, il émet et laisse MainWindow
    # router vers dashboard_screen.profils_instances_screen._arreter_
    # instance_pour_profil (méthode déjà existante et autonome, cf. sa
    # docstring -- rien à dupliquer ici).
    demande_kill_profil_local = Signal(str)  # nom_profil
    # PATCH (mode local dans le panneau clone, "Capturer tout" -- cf.
    # SPEC_mode_clone_local.md section 2.4/3.5 de ce patch) : réinjection
    # Qt-safe du résultat d'une capture locale, prise depuis un
    # threading.Thread dédié (jamais depuis le thread Qt principal, cf.
    # docstring de _sur_demande_capturer_tout_local -- InstanceExecutable.
    # capture() est bloquante réseau via MoteurExecutionCellule._appeler).
    # Signal interne (jamais émis par un widget externe) : (instance_id,
    # image_b64 ou "" si échec, message_erreur ou "" si succès), MÊME
    # convention de payload que sur_capture_reseau_recue/_traiter_
    # reception_capture_masse pour pouvoir réutiliser cette dernière
    # inchangée avec id_executant=ID_EXECUTANT_LOCAL.
    _capture_locale_ponctuelle_recue = Signal(str, str, str)

    def __init__(self, project: Project, reglages: Optional["ReglagesApp"] = None, parent=None):
        super().__init__(parent)
        self.project = project
        self.reglages = reglages
        self._task_courant: Optional[str] = None  # id du Task ouvert, None = vue grille
        self._task_cartes: dict = {}  # id Task -> TaskCarte
        self._instances_actives: list = []  # dernière liste connue, cf. _sur_liste_instances_recue
        # AJOUT (SPEC_mode_clone_local.md section 5 point 4) : distingue
        # "jamais reçu la moindre liste depuis la connexion websocket
        # locale" de "reçu une liste, qui se trouve être vide" -- sans ce
        # flag, le tout premier rendu du panneau clone local (avant que
        # self.client_reseau n'ait eu le temps d'établir sa connexion et
        # de recevoir son premier instances_list, quasi instantané en
        # pratique mais pas garanti à 0ms, cf. spec) afficherait à tort
        # "Aucun profil disponible" -- message indiscernable d'un état
        # stable "vraiment aucune instance active", alors que la liste
        # n'a simplement pas encore pu être établie une seule fois. Passe
        # à True à la première réception (cf. _sur_liste_instances_recue),
        # jamais remis à False ensuite (une reconnexion réseau plus tard
        # ne redevient pas un "premier chargement").
        self._premiere_liste_instances_recue: bool = False
        # Registre LOCAL (ce process UI uniquement) des instances actuellement
        # liées par NOTRE PROPRE pilote d'exécution de Tasks (cf. futur
        # MoteurExecutionCellule, id_client partagé unique pour tout le
        # moteur) -- {instance_id: (task_id, task_nom, cellule_id)}.
        # Nécessaire car le champ "libre" renvoyé par le serveur (cf.
        # srv_liste_instances_message) reflète l'état de liaison PAR PILOTE
        # (liee_a == notre id_client de pilote unique, cf. décision
        # utilisateur) -- il ne permet pas à lui seul de distinguer "libre
        # pour de vrai" de "actuellement utilisée par UN AUTRE Task que
        # notre propre moteur exécute déjà" : les deux auraient liee_a ==
        # notre id_client de moteur. C'est CE dict qui fait la différence,
        # câblé par MoteurExecutionCellule au lancement/à la fin de chaque
        # exécution de cellule (cf. plan de changement, point 3).
        self._instances_occupees_par_nos_tasks: dict[str, tuple[str, str, str]] = {}

        # Namespace Python PERSISTANT par Task (id Task -> dict), partagé
        # entre toutes les cellules d'un même Task tant qu'il reste ouvert
        # (cf. docstring de Task : "comme un vrai notebook Jupyter" -- une
        # variable définie dans une cellule reste disponible aux suivantes).
        # Reconstruit (composants réinjectés) à chaque exécution de cellule
        # via _namespace_task, sans effacer les variables déjà définies par
        # l'utilisateur -- cf. _namespace_task.
        self._namespaces_tasks: dict[str, dict] = {}
        # PATCH (mode local dans le panneau clone -- cf. SPEC_mode_clone_
        # local.md, section 3.7) : namespace Python dédié PAR PROFIL clone
        # local (cle_profil composite -> dict), DISTINCT de self._
        # namespaces_tasks ci-dessus (indexé par task.id, un seul jeu de
        # variables PARTAGÉ par TOUT le Task -- incompatible avec
        # plusieurs profils exécutant la même séquence en parallèle sur
        # le même Task, cf. docstring de _lancer_sequence_clone_profil_
        # local). Créé au premier lancement d'un profil, jamais vidé
        # entre deux cellules de la même séquence (persiste comme un
        # mini-notebook propre à ce profil pour la durée du lancement),
        # mais PAS conservé entre deux LANCEMENTS distincts du même
        # profil -- cf. _sur_demande_lancer_clones_local, qui ne le purge
        # pas explicitement : un profil relancé retrouve un namespace
        # déjà existant (variables de son run précédent encore visibles),
        # cohérent avec le choix déjà fait côté réseau où aucune
        # réinitialisation de variables n'a jamais été demandée/implémentée
        # non plus entre deux lancements d'un même profil clone.
        self._namespaces_clone_locaux: dict[str, dict] = {}
        # BUGFIX (variable InstanceExecutable réutilisée d'une cellule à
        # l'autre, cf. docstring de InstanceExecutable/_resoudre_moteur_
        # courant ci-dessous) : moteur de la DERNIÈRE exécution de cellule
        # en cours pour CE Task (task.id) -- namespace partagé oblige, un
        # script peut faire "Instance = Word.instance()" dans une cellule
        # puis réutiliser cette variable "Instance" dans une AUTRE
        # cellule, exécutée bien plus tard avec un MoteurExecutionCellule
        # tout neuf (l'ancien étant déjà déconnecté de ses signaux réseau,
        # cf. MoteurExecutionCellule._terminer). Indexé par task.id (pas
        # un simple attribut unique) : plusieurs Tasks peuvent avoir une
        # cellule en cours d'exécution simultanément dans cet écran.
        self._moteur_courant_par_task: dict[str, "MoteurExecutionCellule"] = {}
        # MoteurExecutionCellule en cours, par cellule_id -- empêche un
        # second lancement de la MÊME cellule pendant qu'elle tourne déjà
        # (cf. _executer_cellule).
        self._moteurs_en_cours: dict[str, "MoteurExecutionCellule"] = {}
        # PATCH logs en direct (local) : texte déjà imprimé par chaque cellule en cours + rafraîchissements planifiés.
        self._sortie_live_buf: dict[str, str] = {}
        self._sortie_live_planifie: set = set()

        # --- Mode "Exécution Clone" (cf. SPEC_mode_execution_clone.md,
        # section 2) -- état EN MÉMOIRE uniquement, jamais sérialisé dans
        # Task/project.save() (comportement "preview", cf. section 1
        # point 6 de la spec). Indexé par task.id : plusieurs Tasks
        # peuvent chacun avoir leur propre panneau clone ouvert/fermé et
        # leur propre lot en cours, indépendamment les uns des autres.
        self._executions_clone: dict[str, "ExecutionCloneEtat"] = {}

        # AJOUT (point 3 -- ImportTaskWorker, cf. _demande_import_task /
        # _demande_nouvelle_version_task) : références du QThread/worker
        # en cours pour l'import d'un .autoniaxtask, même patron que
        # self._thread_copie_logs_serveur/_worker_copie_logs_serveur
        # (initialisées à None, peuplées au lancement, remises à None
        # dans le callback de fin -- cf. _sur_import_task_termine /
        # _sur_nouvelle_version_task_termine). task_actuel/chemin
        # spécifiques à _demande_nouvelle_version_task (à conserver le
        # temps du worker, puisque le même ImportTaskWorker/thread est
        # réutilisé pour les deux points d'entrée, un seul à la fois).
        self._thread_import_task: Optional[QThread] = None
        self._worker_import_task: Optional["ImportTaskWorker"] = None
        self._nouvelle_version_task_actuel: Optional["Task"] = None
        self._nouvelle_version_chemin: Optional[str] = None
        # CORRECTIF (bug confirmé en prod : spinner du panneau clone
        # bloqué en permanence, PAS une race condition ici mais un
        # enregistrement manquant -- _lancer_sequence_clone_profil
        # construisait un MoteurExecutionCelluleReseau et appelait
        # moteur.lancer() SANS JAMAIS enregistrer moteur._session_id
        # nulle part : sur_resultat_execution_reseau_recu ne pouvait donc
        # jamais retrouver ce moteur, moteur.sur_resultat_recu n'était
        # jamais appelé, callback_termine jamais rappelé). PAS de
        # réutilisation de self._sessions_execution_reseau/_moteurs_en_
        # cours ici : ces deux registres sont indexés par cellule_id, en
        # supposant UN SEUL moteur actif par cellule -- faux en mode
        # clone, où plusieurs profils (iaX1/iaX2/iaX3...) exécutent
        # potentiellement la MÊME cellule_id EN PARALLÈLE, ce qui les
        # ferait s'écraser mutuellement dans _moteurs_en_cours[cellule_id].
        # Ce registre-ci est donc indexé DIRECTEMENT par session_id ->
        # moteur (le moteur est déjà retrouvable sans passer par
        # cellule_id, cf. profil_etat.moteur_courant), sans dépendre de
        # task_id/cellule_id pour le routage.
        self._sessions_execution_reseau_clone: dict[str, "MoteurExecutionCelluleReseau"] = {}
        # SPEC_profils_environnements.md section 2.1/section 12 : plus de
        # fenêtres de rendu par profil -- self._fenetre_rendu_reseau
        # (unique, existant) route désormais sur le profil actif s'il y
        # en a un (section 5), aucune nouvelle fenêtre à gérer.
        # Capture en masse (§5) : id de batch (horodatage ISO) -> dict
        # avec les (id_executant, instance_id) encore attendus, le
        # mapping (id_executant, instance_id) -> nom_profil du batch
        # (REFONTE MULTI-SAUTONIAX -- clé composite plutôt qu'instance_id
        # seul, cf. docstring de _sur_demande_capturer_tout), et le
        # dossier de destination -- cf. _sur_demande_capturer_tout/
        # _traiter_reception_capture_masse.
        self._captures_masse_en_attente: dict[str, dict] = {}

        # --- État de la séquence globale "Tout exécuter" (cf.
        # _executer_toutes_cellules/_arreter_sequence/_rafraichir_bouton_global) ---
        # File des ids de cellule PAS ENCORE traités par la séquence en
        # cours (vidée une par une au fur et à mesure) -- None si aucune
        # séquence globale n'est en cours.
        self._sequence_file: Optional[list] = None
        # id de la cellule ACTUELLEMENT exécutée par la séquence (celle
        # qu'"Tout arrêter" doit couper précisément) -- None si aucune
        # séquence en cours, ou entre deux cellules de la séquence.
        self._sequence_cellule_courante: Optional[str] = None
        # True pendant toute la durée d'une séquence "Tout exécuter", du
        # clic initial jusqu'à la dernière cellule (succès/erreur) ou un
        # "Tout arrêter" -- distinct de (self._sequence_file is not None)
        # seulement pour la lisibilité du code appelant.
        self._sequence_active: bool = False

        # ------------------------------------------------------------
        # AJOUT (fusion de l'ancien écran "Notebook Distant" séparé dans
        # TaskConfig, décision explicite utilisateur : "cest miex de juste
        # etendre le mode du task actuel, en mettant le mode reseau") --
        # un Task en mode task.mode_execution == "reseau" exécute ses
        # cellules sur un sAutoniax distant plutôt qu'une instance nodriver
        # locale (cf. MoteurExecutionCelluleReseau, symétrique fonctionnel
        # de MoteurExecutionCellule mais parlant au protocole serveurT). ---
        #
        # Client serveurT PARTAGÉ (injecté après coup par MainWindow, cf.
        # definir_client_reseau_t -- self.client_serveur_t est construit
        # APRÈS taskconfig_screen dans MainWindow._build_ui, donc jamais
        # passé au constructeur) -- même client que ReseauScreen/
        # InstancesConnecteesScreen, jamais une connexion séparée
        # (id_client déjà unique et partagé pour ClientServeurT, cf. sa
        # docstring -- contrairement à ClientReseauAutoniaX qui exige un
        # id_client PROPRE par écran).
        self._client_serveur_t: Optional["ClientServeurT"] = None
        # id_executant -> nom affiché (cf. definir_executants_reseau_connus,
        # câblé par MainWindow sur ClientServeurT.executants_detail_change
        # -- même source que InstancesConnecteesScreen/ProjetsDistribuesScreen).
        self._noms_executants_reseau: dict[str, str] = {}
        # REFONTE MULTI-SAUTONIAX (demande explicite utilisateur : "affiche
        # pour tout les sautoniax, actuellement c'est seulement 1
        # sautoniax") -- nom_profil -> id_executant D'ORIGINE, agrégé
        # depuis TOUS les sAutoniax connus de _noms_executants_reseau (pas
        # seulement un sAutoniax unique, cf.
        # docstring de PanneauExecutionClone). Reconstruit intégralement à
        # chaque cycle de rafraîchissement (cf. _demander_profils_tous_
        # sautoniax / _sur_profils_multi_sautoniax_recus) -- source de
        # vérité consultée par _sur_demande_lancer_clones pour savoir vers
        # quel sAutoniax router CHAQUE profil coché, puisque le lot n'est
        # plus rattaché à un id_executant unique (cf. l'ancien
        # ExecutionCloneEtat.id_executant_sautoniax, retiré). En cas
        # d'ambiguïté (même nom_profil présent sur deux sAutoniax
        # distincts -- cas limite mais possible si deux sAutoniax
        # partagent une convention de nommage), le dernier sAutoniax
        # traité dans _sur_profils_multi_sautoniax_recus l'emporte
        # silencieusement (cf. sa docstring pour la justification).
        self._id_executant_par_profil_clone: dict[str, str] = {}
        # id_executant -> liste brute de profils (telle que reçue de
        # profils_sautoniax_recu, cf. sur_profils_sautoniax_clone_recus)
        # -- accumulée réponse par réponse pendant qu'on interroge TOUS
        # les sAutoniax connus (cf. _sur_demande_rafraichir_profils_clone),
        # puis fusionnée en une seule liste affichée par le panneau clone
        # (cf. _reconstruire_agregat_profils_clone). Réinitialisé à
        # chaque nouveau cycle de rafraîchissement explicite.
        self._profils_bruts_par_sautoniax_clone: dict[str, list] = {}
        # État d'initialisation PAR (task.id, id_executant) -- un sAutoniax
        # doit avoir chargé un des profils_cloud_reseau du Task via "Initialiser"
        # avant qu'aucune cellule de ce Task ne puisse s'exécuter en mode
        # réseau (cf. _rafraichir_disponibilite_execution_reseau).
        # (task_id, id_executant) -> bool (prêt ou non).
        self._executants_reseau_prets: dict[tuple, bool] = {}
        # (task_id, id_executant) -> nom du profil RÉELLEMENT chargé lors
        # de la dernière initialisation réussie (parmi task.profils_
        # cloud_reseau -- plusieurs peuvent être cochés, un seul est
        # chargé à la fois, cf. _sur_clic_initialiser_reseau). Affiché
        # dans le statut (cf. _rafraichir_statut_reseau) pour rappeler
        # QUEL profil coché est effectivement actif sur ce sAutoniax.
        self._profils_reseau_actifs: dict[tuple, str] = {}
        # session_id (initialisation en cours) -> (task_id, id_executant,
        # profil_nom),
        # pour router sur_resultat_initialisation_reseau_recu vers le bon
        # Task/sAutoniax si plusieurs Tasks réseau sont ouverts/initialisés
        # à des moments différents (l'éditeur n'affiche qu'un Task à la
        # fois, mais l'init peut continuer en tâche de fond après avoir
        # changé d'écran, cf. _sur_clic_initialiser).
        self._sessions_initialisation_reseau: dict[str, tuple] = {}
        # PATCH (bouton "Fermer") -- session_id (fermeture en cours) ->
        # (task_id, id_executant), même rôle EXACT que _sessions_
        # initialisation_reseau juste au-dessus, pour router sur_resultat_
        # fermeture_reseau_recu vers le bon Task/sAutoniax. Pas de
        # profil_nom ici (contrairement à l'initialisation) : la fermeture
        # ne cible aucun profil précis, elle ferme "ce qui est actuellement
        # chargé" sur le sAutoniax visé (cf. docstring de
        # _sautoniax_fermer_notebook_distant côté exécutant).
        self._sessions_fermeture_reseau: dict[str, tuple] = {}
        # session_id (exécution de cellule en mode réseau, PAS initialisation
        # -- ci-dessus) -> (task_id, cellule_id). Même Option A "inversée"
        # que _sessions_initialisation_reseau (cf. docstring de
        # MoteurExecutionCelluleReseau.lancer) : ici le session_id est celui
        # retourné par ClientServeurT.executer_notebook_distant (généré CÔTÉ
        # ClientServeurT, PAS par ce Screen -- contrairement à
        # l'initialisation, qui le génère à l'avance). task_id conservé (pas
        # seulement cellule_id) pour retrouver la bonne TaskCellule même si
        # l'utilisateur a changé de Task ouvert entre-temps (même raison que
        # task_id dans _sessions_initialisation_reseau ci-dessus). Permet à
        # sur_log_execution_reseau_recu/sur_resultat_execution_reseau_recu de
        # router vers le bon MoteurExecutionCelluleReseau (self._moteurs_en_
        # cours[cellule_id]) parmi potentiellement plusieurs cellules en
        # cours (plusieurs Tasks réseau, ou plusieurs cellules d'un même
        # Task exécutées en parallèle).
        self._sessions_execution_reseau: dict[str, tuple] = {}
        # id_executant -> image_b64 de la dernière capture reçue (cf.
        # sur_capture_reseau_recue) -- poussée à PanneauRenduInstance de la
        # fenêtre de rendu si elle est ouverte ET que c'est le sAutoniax
        # actuellement ciblé par le Task ouvert.
        self._dernieres_captures_reseau: dict[str, str] = {}
        # PATCH (demande explicite utilisateur : lister les profils
        # PRÉSENTS SUR LE sAutoniax sélectionné, pas tous les profils du
        # cloud) -- remplace l'ancien self._profils_cloud (dict plat nom
        # -> clé zip B2, alimenté par demande_liste_stockage/sur_resultat_
        # liste_profils_cloud) : désormais un cache PAR sAutoniax
        # (id_executant -> liste de noms de profils PRÉSENTS localement
        # sur CE sAutoniax précis), alimenté par demander_liste_profils_
        # locaux_sautoniax/sur_resultat_liste_profils_locaux_sautoniax --
        # un même profil peut être présent sur certains sAutoniax et pas
        # d'autres, ça n'a donc plus de sens d'avoir une seule liste
        # globale.
        self._profils_locaux_par_executant: dict[str, list[str]] = {}
        # (id_executant, QMenu) du menu de liaison ServiceAPI actuellement
        # ouvert, ou None -- cf. docstring de _demande_selection_executant_
        # reseau : permet à sur_resultat_liste_profils_locaux_sautoniax de
        # repeupler ce menu EN PLACE si la réponse réseau arrive pendant
        # qu'il est encore ouvert (menu.exec() est bloquant), au lieu de
        # le laisser figé sur "(actualisation...)" jusqu'à la PROCHAINE
        # ouverture.
        self._menu_liaison_reseau_ouvert: Optional[tuple] = None
        # AJOUT (bouton "Sync API" -- cf. _sur_clic_sync_api_reseau) :
        # (task_id, id_executant, chainer) tant que la mise à jour de
        # service_api ET/OU de project.json est en cours pour ce couple
        # -- les deux sont normalement poussés à la suite l'un de
        # l'autre (fichiers liés, cf. commentaire de bouton_sync_api_
        # reseau), mais mise_a_jour_service_api_resultat/mise_a_jour_
        # project_json_resultat sont deux signaux SANS session_id
        # (contrairement à Initialiser/Fermer ci-dessus) -- ce tuple sert
        # donc à la fois de garde anti-double-clic (bouton désactivé
        # pendant ce temps) et de mémoire de "quelle étape en cours" pour
        # sur_resultat_maj_service_api_reseau/sur_resultat_maj_project_
        # json_reseau : None = rien en cours, (task_id, id_executant,
        # chainer) = service_api envoyé, project.json pas encore confirmé.
        #
        # AJOUT (demande explicite utilisateur : "je veux que tu creer la
        # possibiliter de mettre un raccourci clavier pour mettre a jour
        # projet.json seule, et service api seule -- un peu comme dans
        # mise a jour systeme il ya chaque bouton pour chque mise a
        # jour") -- `chainer` (bool) distingue désormais les DEUX modes
        # possibles : True (comportement historique du bouton "Sync API"
        # et du raccourci sync_api_toggle -- cf. leurs docstrings) =
        # service_api ET project.json poussés à la suite, PUIS étape
        # cloud ; False (nouveaux raccourcis sync_service_api_seul_
        # toggle/sync_project_json_seul_toggle, cf. leurs docstrings) =
        # UN SEUL des deux fichiers poussé, jamais d'enchaînement sur
        # l'autre ni sur le cloud -- cf. _sur_clic_sync_service_api_seul/
        # _sur_clic_sync_project_json_seul plus bas.
        #
        # REFONTE MULTI-SAUTONIAX (demande explicite utilisateur : "repare
        # ... a tout les sautoniax" -- Sync API ne poussait QUE vers le
        # sAutoniax choisi dans combo_executant_reseau, alors que
        # l'exécution de profils est désormais répartie sur PLUSIEURS
        # sAutoniax en parallèle, cf. tout le refactor CloneProfilEtat.
        # id_executant_sautoniax : un sAutoniax non sélectionné dans le
        # combo pouvait tourner des profils clone avec un service_api/
        # project.json périmé, sans aucun moyen de le mettre à jour sans
        # re-sélectionner manuellement CHAQUE sAutoniax un par un dans le
        # combo puis répéter Sync API autant de fois qu'il y a de
        # sAutoniax connus). Dict keyé par id_executant plutôt qu'un
        # tuple unique : une opération Sync API cible désormais TOUS les
        # sAutoniax de self._noms_executants_reseau simultanément, chacun
        # suivant sa propre progression indépendamment des autres (un
        # échec sur l'un n'empêche jamais les autres d'aboutir, même
        # principe d'agrégation best-effort que _copie_logs_en_cours/
        # _captures_masse_en_attente ailleurs dans ce fichier). Valeur
        # par entrée : (task_id, chainer) -- identique au tuple d'avant,
        # id_executant en moins puisqu'il est désormais la clé du dict.
        self._sync_api_en_cours: dict[str, tuple] = {}
        # Nombre de cibles encore attendues pour la séquence EN COURS
        # (toutes confondues) -- décrémenté à chaque résultat TERMINAL
        # (succès, ou échec qui clôt la séquence pour cette cible) reçu ;
        # bouton_sync_api_reseau ne se réactive qu'une fois ce compteur à
        # zéro, pas au premier résultat individuel (sinon un clic
        # prématuré pendant que d'autres sAutoniax sont encore en vol
        # relancerait une seconde vague sur les cibles déjà lancées).
        self._sync_api_cibles_restantes: int = 0
        # RETRAIT (cf. docstring Connexion.upload_service_api côté
        # serveur.py -- "il ya aussi mise a jour sur le cloud avec ces
        # deux fontion" + "surtout pour le bouton sync api direct
        # present dans linterface taskscripeditor et les raccourir") :
        # _sync_api_cloud_en_cours (état de l'ancienne étape 3/3 cloud,
        # qui renvoyait service_api.zip/project.json une seconde fois via
        # envoyer_mise_a_jour_app après le direct) est supprimé. Le
        # serveur (ServeurT) fait maintenant lui-même cet upload cloud
        # dans ses handlers mettre_a_jour_service_api_fin/mettre_a_jour_
        # project_json_fin, à partir des octets déjà transmis pour le
        # direct -- plus aucun état client à suivre pour cette étape,
        # qui n'existe simplement plus côté client.
        self._fenetre_rendu_reseau: Optional["FenetreRenduTaskReseau"] = None
        # PATCH (demande utilisateur explicite : indicateur visuel sur
        # l'icône bouton_voir_rendu_reseau -- "si le rendu est auto alors
        # ça peut consommer de la data") -- suit l'état RÉEL du mode
        # Automatique côté sAutoniax (dernier fps>0 envoyé via
        # _sur_taux_capture_reseau_change), PAS l'état de la case à
        # cocher du panneau (qui peut être fermé/détruit -- cf.
        # _sur_fermeture_rendu_reseau : fermer la fenêtre ne désactive
        # PAS la capture auto côté sAutoniax, elle continue en arrière-
        # plan). Reste donc correct même quand self._fenetre_rendu_reseau
        # est None.
        self._rendu_auto_actif: bool = False
        root_layout = QVBoxLayout(self)
        root_layout.setContentsMargins(0, 0, 0, 0)
        root_layout.setSpacing(0)

        self.stack = QStackedWidget(self)
        root_layout.addWidget(self.stack, 1)

        self._build_grille()
        self._build_editeur()

        self.stack.addWidget(self.grille_page)
        self.stack.addWidget(self.editeur_page)
        self.stack.setCurrentWidget(self.grille_page)

        # AJOUT : barre de chargement RÉELLE d'ouverture de Task, enfant de
        # la page grille (c'est elle qui reste affichée pendant tout le
        # travail de _ouvrir_task, jusqu'au setCurrentWidget final).
        self.overlay_chargement_task = OverlayChargementTask(self.grille_page)

        # Peuple la grille avec les Tasks déjà présents dans le Project dès
        # la construction de l'écran -- sans cet appel, self.project.tasks
        # pouvait déjà contenir des Tasks sauvegardés (project.json) mais
        # la grille restait vide (placeholder "Aucun Task pour l'instant"
        # affiché à tort) jusqu'au premier _reload_grille() déclenché
        # ailleurs (création d'un Task, ou retour depuis l'éditeur) -- bug
        # : "revenir en arrière" les faisait alors apparaître normalement.
        self._reload_grille()

        # Client réseau dédié -- seulement pour list_instances (cf.
        # docstring de la classe). Même garde défensive que DashboardScreen
        # si le module 'websockets' est absent (RESEAU_DASHBOARD_DISPONIBLE).
        # role="observateur" (et non "pilote") : ce client ne fait jamais de
        # link/command réel, seulement list_instances -- cf. décision utilisateur,
        # un pur observateur ne doit jamais compter dans l'exclusivité pilote d'une
        # instance ni pouvoir en évincer un autre.
        self.client_reseau: Optional["ClientReseauAutoniaX"] = None
        if RESEAU_DASHBOARD_DISPONIBLE:
            self.client_reseau = ClientReseauAutoniaX(
                SERVER_URL_DASHBOARD, role="observateur", id_client=f"taskconfig-{uuid.uuid4().hex[:8]}",
            )
            self.client_reseau.liste_instances_recue.connect(self._sur_liste_instances_recue)
            self.client_reseau.demarrer()

        # Second client réseau, DÉDIÉ au pilotage réel des Tasks (link/
        # unlink/command) -- distinct de self.client_reseau ci-dessus (qui
        # reste purement en lecture, list_instances uniquement, cf.
        # docstring de la classe). UN SEUL id_client pour TOUTES les
        # exécutions de cellule, quel que soit le Task (cf. docstring de
        # MoteurExecutionCellule : "un seul pilote logique") -- jamais
        # recréé par exécution, construit une fois ici et réutilisé.
        self._client_reseau_execution: Optional["ClientReseauAutoniaX"] = None
        if RESEAU_DASHBOARD_DISPONIBLE:
            self._client_reseau_execution = ClientReseauAutoniaX(
                SERVER_URL_DASHBOARD, role="pilote", id_client=f"taskexec-{uuid.uuid4().hex[:8]}",
            )
            self._client_reseau_execution.demarrer()

        # PATCH (mode local dans le panneau clone -- cf. SPEC_mode_clone_
        # local.md, section 3.2) : {nom_profil: chemin_dossier}, rafraîchi
        # depuis charger_registre_profils() à chaque passage en mode local
        # ou clic Rafraîchir -- même source que ProfilsInstancesScreen,
        # jamais un dossier séparé (décision explicite : "Réutiliser les
        # profils existants").
        self._profils_locaux_connus: dict[str, str] = {}
        # {nom_profil: instance_id} pour les profils locaux ACTIFS
        # seulement (absents sinon) -- reconstruit par _associer_profils_
        # actifs_locaux à chaque instances_list reçu (self.client_reseau
        # tourne déjà en permanence, cf. juste au-dessus) ET à chaque
        # rafraîchissement explicite du panneau clone en mode local. Objet
        # persistant (pas recréé vide à chaque appel) : passé lui-même en
        # `associations_precedentes` à _associer_profils_actifs_locaux,
        # pour stabiliser les associations déjà connues d'un appel à
        # l'autre (cf. docstring de cette fonction).
        self._instance_id_par_profil_local: dict[str, str] = {}

    def _sur_liste_instances_recue(self, instances: list):
        self._instances_actives = instances
        self._premiere_liste_instances_recue = True
        self._invalider_liaisons_instances_disparues(instances)
        # PATCH (mode local dans le panneau clone) : ce signal arrive en
        # PUSH dès qu'une instance locale se (dé)connecte, quel que soit
        # le Task actuellement affiché (self.client_reseau, role
        # observateur, tourne en permanence depuis __init__, cf. sa
        # docstring) -- un profil lancé/fermé depuis un AUTRE écran
        # (Profils & Instances) doit donc apparaître/disparaître du
        # panneau clone SANS clic sur Rafraîchir, exactement la même
        # exigence déjà satisfaite côté réseau par sur_profil_isole_
        # change_ailleurs (cf. sa docstring). Sans effet si le Task
        # affiché n'est pas en mode local ou si son panneau clone n'a
        # jamais été activé (etat.actif) -- pas de travail inutile pour
        # un panneau que personne ne regarde.
        task = self._task_courant_obj()
        if task is not None and task.mode_execution == "local":
            etat = self._executions_clone.get(task.id)
            if etat is not None and etat.actif:
                self._rafraichir_agregat_profils_clone_local(task)


    def _invalider_liaisons_instances_disparues(self, instances: list):
        """BUGFIX (retour utilisateur : \"lorsque on arrete une instance
        qui etait deja lie a un serviceapi, ce serviceapi continue
        d'afficher le message vers quel est toujours lié à cette
        instance\") -- task.services_api_importes[nom_service] gardait
        l'instance_id d'une instance ARRÊTÉE indéfiniment : rien ne le
        remettait jamais à "" (état "pas encore lié", cf. docstring du
        champ), donc EnteteServiceAPITask (panneau_composants.rafraichir)
        continuait d'afficher "lié à « auto-1 »" en vert alors que
        l'instance n'existe plus côté serveur.

        Appelé à CHAQUE instances_list reçu (cf. _sur_liste_instances_recue
        ci-dessus) -- ce message arrive déjà en push dès qu'une instance
        se (dé)connecte (cf. srv_retirer_connexion -> srv_diffuser_liste_
        instances_a_tous côté serveur), donc pas besoin d'un mécanisme de
        polling séparé : ce client "observateur" (self.client_reseau) le
        reçoit automatiquement pendant toute la durée de vie de cet écran,
        que le Task concerné soit actuellement ouvert ou non.

        Ne touche QUE le Task actuellement ouvert dans l'éditeur (les
        autres Tasks du Project seront revérifiés à leur propre ouverture
        via ce même mécanisme, cf. _ouvrir_task -> rafraîchissements
        habituels) -- inutile de parcourir tout le Project à chaque
        instances_list, l'affichage périmé ne concerne de toute façon que
        l'écran actuellement visible."""
        task = self._task_courant_obj()
        if task is None:
            return
        ids_actifs = {i.get("id") for i in instances}
        liaisons_perdues = [
            nom_service
            for nom_service, instance_id in task.services_api_importes.items()
            if instance_id and instance_id not in ids_actifs
        ]
        if not liaisons_perdues:
            return
        for nom_service in liaisons_perdues:
            ancienne_instance = task.services_api_importes[nom_service]
            task.services_api_importes[nom_service] = ""
            log.info(
                f"TaskConfigScreen : ServiceAPI « {nom_service} » délié automatiquement "
                f"(instance « {ancienne_instance} » disparue de instances_list)."
            )
        self.project.save()
        self.panneau_composants.rafraichir(task)
        self._notify_status(
            "Instance arrêtée : "
            + ", ".join(f"« {n} »" for n in liaisons_perdues)
            + " n'est/ne sont plus lié(s) à une instance."
        )

    def _demander_liste_instances_fraiche(self):
        """Redemande explicitement la liste au serveur (pas de flux
        continu, cf. docstring de la classe) -- appelé juste avant
        d'ouvrir le menu de sélection d'instance, pour que la liste
        proposée à l'utilisateur soit la plus à jour possible sans pour
        autant maintenir un abonnement permanent."""
        if self.client_reseau is not None:
            self.client_reseau.envoyer_commande({"type": "list_instances"})

    # ------------------------------------------------------------------
    # Vue grille (par défaut) -- même structure que ServiceAPIScreen._build_grille.
    # ------------------------------------------------------------------
    def _build_grille(self):
        self.grille_page = QWidget(self)
        outer_layout = QVBoxLayout(self.grille_page)
        outer_layout.setContentsMargins(28, 24, 28, 24)
        outer_layout.setSpacing(4)

        titre_label = QLabel("TaskConfig", self.grille_page)
        titre_label.setObjectName("PlaceholderTitle")
        outer_layout.addWidget(titre_label)

        sous_titre_label = QLabel(
            "Cliquez sur un Task pour l'ouvrir, ou créez-en un nouveau.",
            self.grille_page,
        )
        sous_titre_label.setObjectName("PlaceholderSubtitle")
        outer_layout.addWidget(sous_titre_label)

        # (Ancienne barre indéterminée barre_progression_import_task
        # SUPPRIMÉE -- remplacée par la barre UNIQUE et déterminée
        # OverlayChargementTask, qui couvre à la fois l'import et
        # l'ouverture d'un Task, cf. TaskConfigScreen._ouvrir_task.)

        outer_layout.addSpacing(16)

        self.zone_contenu = QWidget(self.grille_page)
        zone_layout = QVBoxLayout(self.zone_contenu)
        zone_layout.setContentsMargins(0, 0, 0, 0)
        zone_layout.setSpacing(0)
        # PATCH (section « Lib ») : la page est scindée en deux parties redimensionnables -- Tasks en haut (inchangé),
        # fichiers de bibliothèque Python en bas.
        self.splitter_grille_lib = QSplitter(Qt.Vertical, self.grille_page)
        self.splitter_grille_lib.setChildrenCollapsible(False)
        self.splitter_grille_lib.addWidget(self.zone_contenu)
        self.panneau_lib = self._build_panneau_lib()
        self.splitter_grille_lib.addWidget(self.panneau_lib)
        self.splitter_grille_lib.setStretchFactor(0, 3)
        self.splitter_grille_lib.setStretchFactor(1, 1)
        self.splitter_grille_lib.setSizes([520, 220])
        self.splitter_grille_lib.splitterMoved.connect(lambda *_: self._repositionner_bouton_flottant())
        outer_layout.addWidget(self.splitter_grille_lib, 1)

        self.placeholder_widget = QWidget(self.zone_contenu)
        placeholder_layout = QVBoxLayout(self.placeholder_widget)
        placeholder_layout.setAlignment(Qt.AlignCenter)
        placeholder_layout.setSpacing(16)
        placeholder_icon = QLabel(self.placeholder_widget)
        placeholder_icon.setPixmap(qta.icon("mdi6.script-text-outline", color=Mocha.surface2).pixmap(40, 40))
        placeholder_icon.setAlignment(Qt.AlignCenter)
        placeholder_layout.addWidget(placeholder_icon)
        placeholder_texte = QLabel(
            "Aucun Task pour l'instant. Cliquez sur « + » pour en créer un.",
            self.placeholder_widget,
        )
        placeholder_texte.setObjectName("PlaceholderSubtitle")
        placeholder_texte.setAlignment(Qt.AlignCenter)
        placeholder_layout.addWidget(placeholder_texte)
        zone_layout.addWidget(self.placeholder_widget, 1)

        self.grid_scroll = QScrollArea(self.zone_contenu)
        self.grid_scroll.setObjectName("FlowGridViewport")
        self.grid_scroll.setWidgetResizable(True)
        self.grid_scroll.setFrameShape(QFrame.NoFrame)
        self.grid_scroll.setHorizontalScrollBarPolicy(Qt.ScrollBarAlwaysOff)
        self.grid_scroll.setVerticalScrollBarPolicy(Qt.ScrollBarAlwaysOff)

        # PATCH (point 5) : "tu a fait ça comme si c'était des services" --
        # la grille de Tasks empruntait exactement le pattern de
        # ServiceAPIScreen (center=True + un addStretch(1) de part et
        # d'autre du flow_grid dans grid_wrapper_layout, qui centre TOUTE
        # la grille verticalement dans le viewport). Une vraie "liste de
        # fichiers" s'aligne en haut-gauche et grandit vers le bas au fur
        # et à mesure des ajouts, elle ne reste pas centrée au milieu de
        # l'écran -- donc center=False (cf. FlowGrid, déjà utilisé ainsi
        # pour ComposantsScreen/sous-projets) ET suppression du stretch du
        # haut (seul celui du bas est gardé, pour que la grille parte du
        # haut et que l'espace résiduel reste en dessous, pas au-dessus).
        grid_wrapper = QWidget(self.grid_scroll)
        grid_wrapper_layout = QVBoxLayout(grid_wrapper)
        grid_wrapper_layout.setContentsMargins(0, 0, 0, 0)
        grid_wrapper_layout.setSpacing(0)
        self.flow_grid = FlowGrid(item_width=200, spacing=14, center=False)
        grid_wrapper_layout.addWidget(self.flow_grid)
        grid_wrapper_layout.addStretch(1)
