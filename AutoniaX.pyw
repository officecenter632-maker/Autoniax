# PATCH (bouton "Copier tous les logs", 3 sources -- demande explicite
# utilisateur : "sa doit copier tout les logs depuis le demarage, pas
# juste les n dernier ligne"). Buffer EN MÉMOIRE, SANS PLAFOND (pas de
# deque(maxlen=...)) -- toute ligne loguée depuis le tout début du
# process est gardée. CE FICHIER sert À LA FOIS de sAutoniax (exécutant)
# et de mAutoniax (pilote) selon le mode de lancement (cf. main_sautoniax
# vs le reste de l'appli Qt plus bas) -- attaché ici, juste après la
# config logging.basicConfig ci-dessus, ce tampon capture donc TOUJOURS
# tout depuis le début du process, quel que soit le mode. Même patron de
# handler que TamponJournalMemoire côté serveur.py (PAS de code partagé
# entre les deux fichiers -- cf. serveur.py, "projet à part, aucune
# dépendance au reste du code AutoniaX" -- simple duplication volontaire
# du même petit bloc).
class TamponJournalMemoire(logging.Handler):
    """Accumule chaque ligne formatée dans une liste Python simple.
    Côté sAutoniax : lue par le gestionnaire du message WS
    "demander_logs_executant" pour répondre "logs_executant" au pilote
    (cf. _main_async_sautoniax plus bas). Côté mAutoniax : lue
    directement par le bouton "Copier tous les logs" des paramètres pour
    la source locale, en plus des logs serveurT (HTTP) et sAutoniax
    (WebSocket) récupérés séparément.

    AJOUT (bouton "Copier les logs de cette exécution" du panneau clone
    -- demande explicite utilisateur : "copier les logs entier juste sur
    cette intervalle de temps, entre le démarrage et la fin d'exécution")
    -- `horodatages` garde, EN PARALLÈLE de `lignes` (même index, jamais
    désynchronisé -- un seul point d'écriture, emit() ci-dessous), le
    timestamp Unix RÉEL (record.created, résolution sub-seconde) de
    chaque ligne. Nécessaire car la ligne formatée elle-même ne contient
    que "%H:%M:%S" (cf. datefmt plus bas) -- ni date, ni sous-seconde,
    ambigu autour de minuit et insuffisant pour isoler fiablement une
    fenêtre temporelle précise. `lignes_horodatees()` expose les deux
    ensemble pour le filtrage par plage (cf. _filtrer_lignes_par_plage)."""

    def __init__(self):
        super().__init__()
        self.lignes: list[str] = []
        self.horodatages: list[float] = []

    def emit(self, record: logging.LogRecord):
        try:
            ligne = self.format(record)
            self.lignes.append(ligne)
            self.horodatages.append(record.created)
        except Exception:
            pass

    def lignes_horodatees(self) -> list[tuple[float, str]]:
        """Retourne [(timestamp_unix, ligne_formatée), ...] -- copie
        défensive (zip sur les listes actuelles) pour que l'appelant
        puisse itérer sans risque si emit() est appelé depuis un autre
        thread pendant l'itération (append() est atomique côté GIL, mais
        une liste qui grandit pendant un zip() sur l'ancienne référence
        ne pose aucun souci ici car zip s'arrête à la plus courte)."""
        return list(zip(self.horodatages, self.lignes))


