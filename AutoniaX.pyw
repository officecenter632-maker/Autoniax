class ReceptionScreen(QWidget):
    """Onglet "Réception" de ReseauScreen (PATCH mode sAutoniax --
    demande explicite utilisateur : "la capture envoyer au serveurT, le
    serveurT evoie directement a mautoniax sur forme de messae de
    reception, donc on vas rajouter un oglet reception"). Affiche les
    captures d'écran envoyées par les exécutants (sAutoniax) connectés,
    relayées en temps réel par le serveurT (cf. ClientServeurT.
    capture_recue, serveur.py handler "envoyer_capture").

    Structure : une liste à gauche (un exécutant = une entrée, avec son
    nom et l'heure de la dernière capture reçue), un aperçu de la
    dernière capture reçue pour l'exécutant sélectionné à droite --
    même esprit que StockageCloudScreen (aperçu en lecture seule),
    mais pour des images plutôt que du texte.

    AUCUNE persistance disque des captures ici (choix cohérent avec le
    serveurT lui-même, cf. serveur.py "relais temps réel uniquement,
    PAS de stockage B2 pour les captures") -- seule la DERNIÈRE capture
    de chaque exécutant est gardée en mémoire (remplace la précédente),
    pas d'historique. Un exécutant qui se déconnecte reste affiché dans
    la liste avec sa dernière capture connue (aucun signal de
    déconnexion d'exécutant individuel n'existe côté protocole pour
    l'instant, cf. capture_recue -- seul le NOMBRE total d'exécutants
    connectés est connu via nombre_executants_change, pas leur
    identité) : purger une entrée précise n'est donc pas possible de
    façon fiable ici, laissée volontairement affichée plutôt que
    supprimée à tort."""

    def __init__(self, parent=None):
        super().__init__(parent)
        # id_executant -> {"nom": str, "instance_id": str, "image_b64": str,
        # "recu_le": str}. Une seule entrée par exécutant (id_connexion
        # du serveurT, cf. capture_recue) -- une nouvelle capture du
        # même exécutant remplace la précédente plutôt que de s'accumuler.
        self._captures_par_executant: dict[str, dict] = {}

        layout_racine = QHBoxLayout(self)
        layout_racine.setContentsMargins(24, 20, 24, 20)
        layout_racine.setSpacing(16)

        # --- Colonne gauche : liste des exécutants ayant envoyé au moins
        # une capture ---
        colonne_gauche = QVBoxLayout()
        colonne_gauche.setSpacing(8)
        label_liste = QLabel("Exécutants (sAutoniax) ayant envoyé une capture :", self)
        label_liste.setObjectName("ReglagesLabel")
        label_liste.setWordWrap(True)
        colonne_gauche.addWidget(label_liste)

        self.liste_executants = QListWidget(self)
        self.liste_executants.setObjectName("ReceptionListeExecutants")
        self.liste_executants.setFixedWidth(280)
        self.liste_executants.currentItemChanged.connect(self._sur_selection_changee)
        colonne_gauche.addWidget(self.liste_executants, stretch=1)

        layout_racine.addLayout(colonne_gauche)

        # --- Colonne droite : aperçu de la capture sélectionnée ---
        colonne_droite = QVBoxLayout()
        colonne_droite.setSpacing(8)

        self.label_titre_apercu = QLabel("(sélectionne un exécutant à gauche)", self)
        self.label_titre_apercu.setObjectName("ReglagesLabel")
        self.label_titre_apercu.setWordWrap(True)
        colonne_droite.addWidget(self.label_titre_apercu)

        # QScrollArea englobant le QLabel d'aperçu -- une capture plein
        # écran peut dépasser largement la taille du panneau, cf. même
        # patron que les aperçus d'image existants ailleurs dans le
        # fichier (QScrollArea + QLabel(pixmap), pas de redimensionnement
        # forcé qui dégraderait la lisibilité de la capture).
        self.zone_defilement_apercu = QScrollArea(self)
        self.zone_defilement_apercu.setWidgetResizable(True)
        self.zone_defilement_apercu.setObjectName("ReceptionApercuScroll")

        self.label_apercu = QLabel(self)
        self.label_apercu.setAlignment(Qt.AlignCenter)
        self.label_apercu.setText("Aucune capture reçue pour l'instant.")
        self.zone_defilement_apercu.setWidget(self.label_apercu)
        colonne_droite.addWidget(self.zone_defilement_apercu, stretch=1)

        layout_racine.addLayout(colonne_droite, stretch=1)

    def sur_capture_recue(self, id_executant: str, nom_executant: str, instance_id: str, image_b64: str):
        """Connecté par MainWindow à ClientServeurT.capture_recue --
        met à jour (ou crée) l'entrée de liste pour cet exécutant, et
        rafraîchit l'aperçu si c'est l'exécutant actuellement
        sélectionné (ou si aucune sélection n'existe encore, cf.
        premier appel : sélectionne automatiquement la toute première
        entrée créée, pour ne pas laisser l'aperçu vide alors qu'une
        capture vient d'arriver)."""
        premiere_entree = id_executant not in self._captures_par_executant
        heure = datetime.now().strftime("%H:%M:%S")
        self._captures_par_executant[id_executant] = {
            "nom": nom_executant,
            "instance_id": instance_id,
            "image_b64": image_b64,
            "recu_le": heure,
        }

        libelle = f"{nom_executant or id_executant}  ·  {heure}"
        if premiere_entree:
            item = QListWidgetItem(libelle)
            item.setData(Qt.UserRole, id_executant)
            self.liste_executants.addItem(item)
            # Première capture jamais reçue (liste vide avant cet ajout) :
            # sélectionne automatiquement cette entrée pour afficher
            # l'aperçu tout de suite, sans action de l'utilisateur.
            if self.liste_executants.count() == 1:
                self.liste_executants.setCurrentItem(item)
        else:
            # Met à jour le libellé (nouvelle heure) de l'entrée existante,
            # sans changer sa position dans la liste.
            for i in range(self.liste_executants.count()):
                item = self.liste_executants.item(i)
                if item.data(Qt.UserRole) == id_executant:
                    item.setText(libelle)
                    break

        item_courant = self.liste_executants.currentItem()
        if item_courant is not None and item_courant.data(Qt.UserRole) == id_executant:
            self._afficher_apercu(id_executant)

    def _sur_selection_changee(self, item_courant, _item_precedent):
        if item_courant is None:
            return
        id_executant = item_courant.data(Qt.UserRole)
        self._afficher_apercu(id_executant)

    def _afficher_apercu(self, id_executant: str):
        """Décode l'image_b64 (WebP, cf. _compresser_capture_webp côté
        exécutant -- qualité 100 à la source depuis le patch de
        recompression par pilote, cf. ClientServeurT._envoyer_capture)
        en QImage pour l'afficher dans label_apercu.

        Tente d'abord decoder_image_b64 (QImage.loadFromData -- rapide,
        mais dépend du plugin Qt WebP, PAS garanti présent sur toutes
        les machines, cf. docstring _compresser_capture_webp/PILLOW_
        DISPONIBLE : c'est exactement pour cette raison que la
        COMPRESSION passe par Pillow plutôt que Qt). Si ça échoue ET
        que Pillow est disponible (déjà utilisé pour la compression
        côté exécutant, donc déjà une dépendance du projet), repli sur
        un décodage Pillow -> PNG -> QImage, pour rester utilisable
        même sur une machine pilote sans plugin Qt WebP installé."""
        donnees = self._captures_par_executant.get(id_executant)
        if donnees is None:
            return
        image = decoder_image_b64(donnees["image_b64"])
        if (image is None or image.isNull()) and PILLOW_DISPONIBLE:
            try:
                brut = base64.b64decode(donnees["image_b64"])
                with PILImage.open(io.BytesIO(brut)) as img_pil:
                    tampon_png = io.BytesIO()
                    img_pil.convert("RGB").save(tampon_png, format="PNG")
                image_secours = QImage()
                if image_secours.loadFromData(QByteArray(tampon_png.getvalue())) and not image_secours.isNull():
                    image = image_secours
            except Exception as e:
                log_reseau_t.debug(f"[Réception] repli Pillow de décodage WebP échoué : {e!r}")
        if image is None or image.isNull():
            self.label_apercu.setText("Capture reçue mais illisible (décodage échoué).")
            self.label_apercu.setPixmap(QPixmap())
            self.label_titre_apercu.setText(
                f"{donnees['nom'] or id_executant}  ·  instance {donnees['instance_id']!r}  ·  {donnees['recu_le']}"
            )
            return
        self.label_apercu.setPixmap(QPixmap.fromImage(image))
        self.label_apercu.setText("")
        self.label_titre_apercu.setText(
            f"{donnees['nom'] or id_executant}  ·  instance {donnees['instance_id']!r}  ·  dernière capture reçue à {donnees['recu_le']}"
        )


class BatchTraiteScreen(QWidget):
    """Onglet "Batch Traité" de ReseauScreen (PATCH E.2 -- cf. cahier des
    charges patchs.md, section E.2 : "quand un batch termine son
    exécution, le serveurT le stocke dans un dossier cloud dédié...
    [RENOMMÉ] ce dossier s'appelle 'Batch Traité'... Un bouton
    'Télécharger' par entrée terminée : télécharge les données traitées
    et écrase les données locales de l'ancien batch non traité").

    Réutilise le protocole stockage EXISTANT plutôt que d'en créer un
    nouveau (aucune logique métier dédiée côté serveur, cf. handler
    retour_projet_execute_fin dans serveur.py qui se contente d'uploader
    sous le préfixe "Batch Traité/{nom} — {horodatage} — {session_id}/"
    -- {resultat.zip, meta.json}) :
    - demande_liste_stockage() -> même signal que StockageCloudScreen/
      ProfilsCloudScreen, MainWindow appelle ClientServeurT.demander_
      liste_stockage() UNE FOIS, le résultat brut (toutes les clés du
      bucket) est distribué à TOUS les écrans qui l'écoutent (cf.
      ReseauScreen.demande_liste_stockage, déjà un signal partagé à
      plusieurs abonnés). Cet écran filtre lui-même les clés qui
      commencent par "Batch Traité/" -- aucun nouveau message serveur.
    - demande_telechargement_batch_traite(str, str) -- (préfixe du
      dossier B2, chemin_racine local à écraser) : émis au clic sur
      "Télécharger". Contrairement à demande_telechargement_meta
      (ProfilsCloudScreen, un seul fichier meta.json), CET écran doit
      déclencher DEUX téléchargements successifs (meta.json d'abord
      pour confirmer le nom projet, puis resultat.zip) suivis d'un
      dézippage qui ÉCRASE chemin_racine -- trop de logique séquentielle
      pour rester un simple relais, donc géré directement par MainWindow
      (cf. _sur_demande_telechargement_batch_traite), pas ici.

    Résolution du ProjetBatch LOCAL à écraser (chemin_racine) : cet
    écran ne connaît PAS les ProjetBatch du Project courant (pas de
    référence à Project ici, cohérent avec le reste de ReseauScreen qui
    ignore délibérément le contenu métier). definir_projets_batch_locaux
    (appelée par MainWindow après chargement du Project, même patron que
    definir_executants_disponibles ailleurs) fournit la liste
    {id, nom, chemin_racine} pour peupler un menu déroulant de
    résolution PAR NOM (le nom du dossier B2 commence par le nom du
    projet au moment de l'envoi, cf. nom_projet_meta côté serveur) --
    l'utilisateur choisit explicitement la cible locale avant de
    confirmer l'écrasement, jamais une résolution automatique risquée."""

    demande_liste_stockage = Signal()
    demande_telechargement_batch_traite = Signal(str, str)  # (prefixe_b2, chemin_racine_local)

    def __init__(self, parent=None):
        super().__init__(parent)
        self._deja_charge_une_fois = False
        self._entrees: list[dict] = []  # [{"prefixe": str, "nom_affiche": str, "taille_octets": int, "a_meta": bool}]
        self._projets_batch_locaux: list[dict] = []  # [{"id", "nom", "chemin_racine"}]

        layout = QVBoxLayout(self)
        layout.setContentsMargins(24, 20, 24, 20)
        layout.setSpacing(8)

        ligne_haut = QHBoxLayout()
        label_intro = QLabel(
            "Batchs dont l'exécution est terminée, archivés côté serveurT "
            "(survit à une déconnexion) :", self)
        label_intro.setObjectName("ReglagesLabel")
        label_intro.setWordWrap(True)
        ligne_haut.addWidget(label_intro, stretch=1)

        self.bouton_actualiser = QPushButton("Actualiser", self)
        self.bouton_actualiser.setCursor(Qt.PointingHandCursor)
        self.bouton_actualiser.clicked.connect(self.demande_liste_stockage)
        ligne_haut.addWidget(self.bouton_actualiser, stretch=0)
        layout.addLayout(ligne_haut)

        # QTreeWidget en mode "table plate" -- même composant déjà
        # utilisé partout ailleurs dans ce fichier pour ce genre de
        # tableau (cf. ProfilsCloudScreen.table_profils), pas de nouveau
        # widget QTableWidget à importer juste pour cet écran.
        self.table = QTreeWidget(self)
        self.table.setObjectName("BatchTraiteTable")
        self.table.setRootIsDecorated(False)
        self.table.setUniformRowHeights(True)
        self.table.setSelectionMode(QAbstractItemView.NoSelection)
        self.table.setHeaderLabels(["Batch", "Reçu le", "Taille", ""])
        self.table.header().setSectionResizeMode(0, QHeaderView.Stretch)
        self.table.header().setSectionResizeMode(1, QHeaderView.ResizeToContents)
        self.table.header().setSectionResizeMode(2, QHeaderView.ResizeToContents)
        self.table.header().setSectionResizeMode(3, QHeaderView.ResizeToContents)
        layout.addWidget(self.table, stretch=1)

        self.label_statut = QLabel(
            "(clique sur Actualiser pour charger la liste)", self)
        self.label_statut.setWordWrap(True)
        self.label_statut.setObjectName("PlaceholderSubtitle")
        layout.addWidget(self.label_statut)

    # PATCH (retour utilisateur explicite : "jespere queil yaplus ce
    # genre bugs visuesls dansle code") -- même correctif que
    # PanneauProprietesSautoniax._afficher_statut_temporaire (cf. sa
    # docstring pour le détail complet), appliqué UNIQUEMENT au résultat
    # ponctuel de sur_resultat_telechargement_batch_traite -- PAS aux
    # décomptes "N batch(s) traité(s)."/"Aucun batch..."
    # (sur_resultat_liste_stockage), qui restent des états permanents
    # tant que la liste n'a pas changé, ni à "Échec du chargement"
    # (erreur de chargement de LISTE, qui doit rester visible tant
    # qu'aucun rechargement réussi ne l'a remplacée), ni à "...
    # en cours..." (état intermédiaire).
    DUREE_AFFICHAGE_STATUT_MS = 4000

    def _afficher_statut_temporaire(self, texte: str):
        self.label_statut.setText(texte)
        QTimer.singleShot(
            self.DUREE_AFFICHAGE_STATUT_MS,
            lambda: self.label_statut.setText("") if self.label_statut.text() == texte else None,
        )

    def showEvent(self, event):
        """Même patron que StockageCloudScreen -- charge automatiquement
        au premier affichage, pas à chaque va-et-vient entre onglets."""
        super().showEvent(event)
        if not self._deja_charge_une_fois:
            self._deja_charge_une_fois = True
            self.demande_liste_stockage.emit()

    def definir_projets_batch_locaux(self, projets: list[dict]):
        """Appelé par MainWindow (cf. docstring de classe) à chaque
        rechargement du Project courant -- alimente la résolution
        nom -> chemin_racine local proposée au clic sur "Télécharger"."""
        self._projets_batch_locaux = list(projets)

    def sur_resultat_liste_stockage(self, ok: bool, objets: list, message: str):
        """Connecté par MainWindow (même signal partagé que Stockage
        Cloud/Profils Cloud, cf. docstring de classe) -- filtre
        uniquement les clés sous "Batch Traité/" et reconstruit une
        entrée par dossier (regroupe resultat.zip + meta.json d'un même
        envoi, identifiés par leur préfixe commun)."""
        if not ok:
            self.label_statut.setText(f"Échec du chargement : {message}")
            return
        PREFIXE = "Batch Traité/"
        par_dossier: dict[str, dict] = {}
        for obj in objets:
            cle = obj.get("cle") if isinstance(obj, dict) else obj
            taille = obj.get("taille_octets") if isinstance(obj, dict) else None
            if not isinstance(cle, str) or not cle.startswith(PREFIXE):
                continue
            reste = cle[len(PREFIXE):]
            if "/" not in reste:
                continue
            nom_dossier, nom_fichier = reste.split("/", 1)
            entree = par_dossier.setdefault(nom_dossier, {
                "prefixe": f"{PREFIXE}{nom_dossier}",
                "nom_affiche": nom_dossier,
                "taille_octets": 0,
                "a_meta": False,
                "a_zip": False,
            })
            if nom_fichier == "resultat.zip":
                entree["a_zip"] = True
                entree["taille_octets"] = taille or 0
            elif nom_fichier == "meta.json":
                entree["a_meta"] = True
        # Trié du plus récent au plus ancien -- l'horodatage (format
        # YYYYMMDDTHHMMSSZ) fait partie du nom de dossier lui-même
        # (cf. serveur.py, prefixe = f"...{horodatage}...") donc un tri
        # alphabétique inverse du nom suffit, pas besoin de re-parser.
        self._entrees = sorted(par_dossier.values(), key=lambda e: e["nom_affiche"], reverse=True)
        self._reconstruire_table()
        if not self._entrees:
            self.label_statut.setText("Aucun batch traité archivé pour l'instant.")
        else:
            self.label_statut.setText(f"{len(self._entrees)} batch(s) traité(s).")

    def _reconstruire_table(self):
        self.table.clear()
        for entree in self._entrees:
            # Le nom de dossier est "{nom_projet} — {horodatage} — {session_id}"
            # (cf. serveur.py) -- on isole nom + horodatage pour un
            # affichage plus lisible que la clé brute complète.
            morceaux = entree["nom_affiche"].split(" — ")
            nom_lisible = morceaux[0] if morceaux else entree["nom_affiche"]
            horodatage_lisible = morceaux[1] if len(morceaux) > 1 else ""

            taille_mo = entree["taille_octets"] / (1024 * 1024)
            texte_taille = f"{taille_mo:.1f} Mo" if taille_mo >= 1 else f"{entree['taille_octets']} o"

            item = QTreeWidgetItem(self.table, [nom_lisible, horodatage_lisible, texte_taille, ""])
            item.setToolTip(0, entree["nom_affiche"])
            self.table.addTopLevelItem(item)

            bouton_telecharger = QPushButton("Télécharger", self.table)
            bouton_telecharger.setCursor(Qt.PointingHandCursor)
            bouton_telecharger.setEnabled(entree["a_zip"])
            bouton_telecharger.clicked.connect(
                lambda checked=False, e=entree, n=nom_lisible: self._sur_clic_telecharger(e, n)
            )
            self.table.setItemWidget(item, 3, bouton_telecharger)

    def _sur_clic_telecharger(self, entree: dict, nom_lisible: str):
        """Résout le ProjetBatch local visé PAR NOM (cf. docstring de
        classe) -- si aucun ou plusieurs ProjetBatch locaux partagent ce
        nom, demande confirmation/choix explicite plutôt que de deviner,
        l'action étant destructive (écrase chemin_racine)."""
        candidats = [p for p in self._projets_batch_locaux if p.get("nom") == nom_lisible]
        if not candidats:
            BoiteDialogueAutoniaX.warning(
                self, "Batch local introuvable",
                f"Aucun Projet Batch local nommé « {nom_lisible} » n'a été "
                f"trouvé pour recevoir ce téléchargement. Vérifie que le "
                f"batch d'origine existe toujours dans ce Project (le "
                f"nom doit correspondre exactement).",
            )
            return
        if len(candidats) > 1:
            noms_ids = "\n".join(f"- {c['nom']} (id={c['id']})" for c in candidats)
            BoiteDialogueAutoniaX.warning(
                self, "Ambiguïté",
                f"Plusieurs Projets Batch locaux portent le nom « {nom_lisible} » "
                f"-- résolution automatique impossible :\n{noms_ids}\n\n"
                f"Renomme-les pour lever l'ambiguïté avant de télécharger.",
            )
            return
        cible = candidats[0]
        confirme = BoiteDialogueAutoniaX.question(
            self, "Écraser les données locales ?",
            f"Le contenu téléchargé va ÉCRASER le dossier local de « {cible['nom']} » "
            f"({cible['chemin_racine']}). Cette action est irréversible. Continuer ?",
        )
        if not confirme:
            return
        self.label_statut.setText(f"Téléchargement de « {nom_lisible} » en cours...")
        self.demande_telechargement_batch_traite.emit(entree["prefixe"], cible["chemin_racine"])

    def sur_resultat_telechargement_batch_traite(self, ok: bool, nom_lisible: str, message: str):
        """Connecté par MainWindow après dézippage+écrasement effectifs
        (cf. _sur_demande_telechargement_batch_traite)."""
        if ok:
            self._afficher_statut_temporaire(f"« {nom_lisible} » téléchargé et données locales écrasées avec succès.")
        else:
            self._afficher_statut_temporaire(f"Échec du téléchargement de « {nom_lisible} » : {message}")


class StockageScreen(QWidget):
    """Onglet "Stockage" de ReseauScreen (PATCH -- demande explicite
    utilisateur : "je veux que on connecte deja notre stokage cloudflare
    avec notre serveur, parceque on vas envoyer certains fichier sur le
    stoakge persistant", cf. cahier réseau section 2 "Stockage cloud" et
    Étape 9). Fournisseur : Backblaze B2 (PATCH -- bascule depuis R2,
    demande explicite utilisateur : "je nes pas de carte de credit" ->
    "Basculer sur Backblaze B2 (pas de carte)", cf. ReglagesApp pour le
