# ZoneCarte -- mini-card cliquable d'une Zone, utilisée dans la grille du
# sous-onglet "Zone" de ComposantLayoutConfigScreen (cf.
# _construire_sous_onglet_zones). Simple, juste le nom affiché dessus --
# cliquer dessus ouvre ses propriétés dans le panneau de droite (nom,
# rectangle, bouton Tracer/Mettre à jour), même principe que
# ServiceAPICarte (grille de ServiceAPIScreen) mais sans badge ni info
# secondaire, une Zone n'a que son nom comme identité visuelle utile ici.
# ---------------------------------------------------------------------------
class ZoneCarte(QFrame):
    """Mini-card d'une Zone dans la grille du sous-onglet "Zone" -- cliquer
    dessus peuple le panneau de droite avec ses propriétés (cf.
    ComposantLayoutConfigScreen._sur_carte_zone_cliquee).

    DESIGN (retour utilisateur : "sa reseemble trop au card de serviceAPI,
    le super patron, ce qui est scandaleux ... licone me plait mais change
    le design d'effet du card") -- rompt délibérément avec le langage
    #ServiceAPICarteV2 (carte carrée, dégradé de fond, badge en dégradé,
    bordure gauche accentuée) : icône CONSERVÉE mais réduite à une pastille
    plate de couleur unie, carte HORIZONTALE compacte (icône à gauche, nom
    + statut empilés à droite) plutôt que verticale, fond plat sans
    dégradé, pas de bordure gauche colorée. Le statut devient un simple
    point coloré + texte (comme un indicateur de connexion) plutôt qu'une
    pilule pleine.
    - Pastille icône (vector-rectangle) plate, coin gauche.
    - Nom de la Zone en gras + point de statut coloré (vert "Tracée" /
      ambre "Non tracée") en dessous, dans la même colonne texte.
      rafraichir_statut() (appelé par _rafraichir_grille_zones et après un
      tracé, cf. _sur_zone_tracee / _sur_nom_zone_rect_change) met ce point
      à jour sans reconstruire toute la grille.
    - État sélectionné (definir_selectionnee) : contour plein couleur
      accent (cf. QSS #ZoneCarte[selectionnee="true"]), seul élément qui
      reste esthétiquement proche du reste de l'app -- nécessaire pour que
      la sélection reste lisible."""

    clique = Signal(str)  # nom de la Zone

    def __init__(self, zone: "Zone", parent=None):
        super().__init__(parent)
        self.nom_zone = zone.nom
        self.setObjectName("ZoneCarte")
        self.setFixedSize(168, 60)
        self.setCursor(Qt.PointingHandCursor)

        layout = QHBoxLayout(self)
        layout.setContentsMargins(12, 10, 12, 10)
        layout.setSpacing(10)

        self.icon_badge = QFrame(self)
        self.icon_badge.setObjectName("ZoneCarteIconBadge")
        self.icon_badge.setFixedSize(32, 32)
        icon_badge_layout = QVBoxLayout(self.icon_badge)
        icon_badge_layout.setContentsMargins(0, 0, 0, 0)
        icon_label = QLabel(self.icon_badge)
        icon_label.setObjectName("ZoneCarteIconBadgeIcon")
        icon_label.setAlignment(Qt.AlignCenter)
        icon_label.setPixmap(qta.icon("mdi6.vector-rectangle", color=Mocha.lavender).pixmap(17, 17))
        icon_badge_layout.addWidget(icon_label)
        layout.addWidget(self.icon_badge)

        colonne_texte = QVBoxLayout()
        colonne_texte.setContentsMargins(0, 0, 0, 0)
        colonne_texte.setSpacing(4)

        self.nom_label = QLabel(zone.nom, self)
        self.nom_label.setObjectName("ZoneCarteNom")
        self.nom_label.setWordWrap(False)
        colonne_texte.addWidget(self.nom_label)

        statut_row = QHBoxLayout()
        statut_row.setContentsMargins(0, 0, 0, 0)
        statut_row.setSpacing(5)
        self.statut_point = QLabel(self)
        self.statut_point.setObjectName("ZoneCartePoint")
        self.statut_point.setFixedSize(7, 7)
        statut_row.addWidget(self.statut_point, 0, Qt.AlignVCenter)
        self.statut_label = QLabel(self)
        self.statut_label.setObjectName("ZoneCarteStatut")
        statut_row.addWidget(self.statut_label, 0, Qt.AlignVCenter)
        statut_row.addStretch(1)
        colonne_texte.addLayout(statut_row)

        layout.addLayout(colonne_texte, 1)

        self._selectionnee = False
        self.rafraichir_statut(zone)

    def rafraichir_statut(self, zone: "Zone"):
        """Met à jour le point + texte "Tracée"/"Non tracée" -- appelé à la
        construction puis après chaque tracé/mise à jour du rect depuis le
        panneau de droite, pour que la grille reflète l'état réel sans
        nécessiter une reconstruction complète de toutes les cards."""
        tracee = not zone.rect.est_vide()
        self.statut_label.setText("Tracée" if tracee else "Non tracée")
        for w in (self.statut_point, self.statut_label):
            w.setProperty("tracee", "true" if tracee else "false")
            w.style().unpolish(w)
            w.style().polish(w)

    def definir_selectionnee(self, selectionnee: bool):
        self._selectionnee = selectionnee
        self.setProperty("selectionnee", "true" if selectionnee else "false")
        self.style().unpolish(self)
        self.style().polish(self)

    def renommer(self, nouveau_nom: str):
        self.nom_zone = nouveau_nom
        self.nom_label.setText(nouveau_nom)

    def mousePressEvent(self, event):
        if event.button() == Qt.LeftButton:
            self.clique.emit(self.nom_zone)
        super().mousePressEvent(event)


class ZoneDynamiqueCarte(QFrame):
    """AJOUT -- mini-card d'une zone DYNAMIQUE (résultat du dernier filtre
    exécuté, cf. ComposantLayoutConfigScreen._dernieres_zones_filtre) dans
    la même grille que les ZoneCarte (Zone statiques), pour permettre de
    personnaliser sa zone de clic (cf. ZoneDynamiqueClicConfig) au même
    endroit, sans dupliquer un onglet séparé.

    Délibérément DISTINCTE de ZoneCarte dans son code (pas juste une
    sous-classe) : une zone dynamique n'a ni rect persistant (recalculé à
    chaque exécution du filtre), ni nom éditable, ni suppression manuelle
    -- son statut affiché n'est donc jamais "Tracée/Non tracée" mais
    "Personnalisée/Zone entière" (reflète zone_clic_mode plutôt que
    rect.est_vide()). Style visuel proche (même taille, même agencement)
    pour rester cohérente dans la grille, mais icône différente (mdi6.
    auto-fix, évoque "détectée automatiquement" plutôt que "tracée à la
    main") pour qu'on distingue les deux catégories d'un coup d'œil."""

    clique = Signal(str)  # nom de la zone dynamique

    def __init__(self, nom_zone: str, mode_clic: str, parent=None):
        super().__init__(parent)
        self.nom_zone = nom_zone
