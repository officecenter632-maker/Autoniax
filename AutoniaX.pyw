    def sizeHint(self, option: QStyleOptionViewItem, index: QModelIndex) -> QSize:
        taille = super().sizeHint(option, index)
        # PATCH (cf. docstring de self.hauteur_cible_px dans __init__) --
        # hauteur_cible_px (posée par _recalculer_grille_profils, MÊME
        # source de vérité que hauteur_item/gridSize) prime sur l'ancienne
        # formule recalculée ici -- qui divergeait de gridSize et
        # produisait des cartes visuellement écrasées (74px peints pour
        # une cellule de 116px). 0 -> pas encore mesuré, repli sur
        # l'ancien calcul (jamais 0 après le premier recalcul réel).
        if self.hauteur_cible_px > 0:
            hauteur = self.hauteur_cible_px
        else:
            hauteur = taille.height() + self.EXTRA_HAUTEUR_BOUTONS + self.EXTRA_HAUTEUR_BADGES
            if index.data(DELEGATE_ROLE_ACTIF) and index.data(DELEGATE_ROLE_DUREE):
                hauteur += self.EXTRA_HAUTEUR_DUREE
        # PATCH (cf. docstring de self.largeur_cible_px dans __init__) --
        # largeur_cible_px (posée par _recalculer_grille_profils) prime
        # sur la largeur native du texte : c'est CE sizeHint(), pas
        # gridSize, qui détermine la largeur RÉELLEMENT PEINTE de l'item
        # (gridSize ne fait qu'espacer les cellules). 0 -> pas encore
        # mesuré, repli sur le comportement natif (cf. son garde-fou).
        largeur = self.largeur_cible_px if self.largeur_cible_px > 0 else taille.width()
        return QSize(largeur, hauteur)

    def initStyleOption(self, option: QStyleOptionViewItem, index: QModelIndex) -> None:
        # CORRECTIF (bug : "la checkbox ne se met pas à jour visuellement
        # au clic") -- cause réelle trouvée : paint() ci-dessous ajoute
        # HasCheckIndicator + le bon checkState sur une COPIE LOCALE de
        # l'option (option_indicateur), rien que pour dessiner. Mais le
        # clic sur la case à cocher n'est PAS géré dans
        # ProfilsInstancesScreen.eventFilter() (qui ne s'occupe que des
        # boutons lancer/arrêter et Free, cf. rect_bouton/rect_bouton_free)
        # -- il retombe donc sur editorEvent() de QStyledItemDelegate,
        # jamais surchargé ici, qui utilise l'option que LA VUE construit
        # elle-même en interne pour CHAQUE item avant d'appeler paint()
        # (juste après avoir appelé initStyleOption(), le point d'entrée
        # standard Qt pour enrichir cette option -- non surchargé jusqu'ici,
        # donc réduit à son comportement par défaut de QStyledItemDelegate,
        # qui NE fixe PAS HasCheckIndicator tout seul).
        #
        # Conséquence vérifiée par test direct (Qt offscreen) : sans
        # HasCheckIndicator sur cette option-là, style().subElementRect(
        # SE_ItemViewItemCheckIndicator, ...) renvoie un QRect(0, 0, 0, 0)
        # -- une zone de clic totalement vide. editorEvent() teste alors
        # "le clic tombe-t-il dans cette zone ?", la réponse est toujours
        # non (rect vide), donc Qt.CheckStateRole n'est jamais basculé,
        # itemChanged n'est jamais émis, et le prochain repaint réaffiche
        # donc exactement le même état qu'avant -- d'où l'impression que
        # rien ne se passe au clic.
        #
        # Correction : appliquer ICI, sur l'option RÉELLEMENT utilisée par
        # la vue (dessin ET hit-test interne, pas une copie locale), le
        # même traitement que paint() fait déjà pour option_indicateur.
        # Après ce correctif, subElementRect() renvoie une vraie zone
        # (confirmé (3, 0, 14, 14) en test) aussi bien pour le hit-test
        # natif que pour le rect_natif recalculé dans paint() -- les deux
        # utilisent désormais la même donnée de départ, donc restent
        # cohérents entre eux.
        # CORRECTIF RÉEL, v3 -- v1 ET v2 avaient toutes les deux le même
        # bug de fond, confirmé par test répété d'appels successifs sur
        # le même objet QStyleOptionViewItem (Qt réutilise cet objet
        # d'un item à l'autre) :
        #   v1 : rétrécissait option.rect APRÈS super().initStyleOption(),
        #        en soustrayant hauteur_extra directement -- cumulatif à
        #        chaque appel, hauteur négative en quelques passages.
        #   v2 : tentait de repartir de gridSize().height() (une valeur
        #        fixe) -- mais le VRAI souci n'était même pas notre
        #        calcul : c'est super().initStyleOption() elle-même qui
        #        n'est PAS idempotente si on lui donne un option.rect
        #        déjà rétréci en entrée. Elle applique son propre travail
        #        interne (marges, padding QSS...) EN PLUS de la valeur
        #        déjà présente dans option.rect -- donc si option.rect
        #        arrive déjà réduit d'un appel précédent, super() le
        #        réduit ENCORE, d'où la même hauteur négative en cascade.
        #
        # v3 : on ne laisse JAMAIS option.rect entrer dans
        # super().initStyleOption() avec une valeur potentiellement déjà
        # modifiée par un appel précédent sur ce même objet partagé. On
        # repart explicitement de la géométrie native de la vue --
        # visualRect(index), jamais touchée par ce delegate -- AVANT
        # d'appeler super(). Résultat : peu importe combien de fois Qt
        # rappelle cette méthode sur le même objet, chaque appel repart
        # de zéro et produit exactement le même résultat (idempotent).
        liste_instances = self.parent()
        if liste_instances is not None and hasattr(liste_instances, "visualRect"):
            option.rect = liste_instances.visualRect(index)

        super().initStyleOption(option, index)
        option.features |= QStyleOptionViewItem.HasCheckIndicator
        valeur_coche_brute = index.data(Qt.CheckStateRole)
        option.checkState = (
            Qt.CheckState(valeur_coche_brute) if valeur_coche_brute is not None else Qt.Unchecked
        )
        actif = index.data(DELEGATE_ROLE_ACTIF)
        duree = index.data(DELEGATE_ROLE_DUREE)
        # PATCH (badges proxy/pays/YouTube) -- EXTRA_HAUTEUR_BADGES
        # ajouté ICI, TOUJOURS (pas conditionnel comme EXTRA_HAUTEUR_DUREE
        # juste en dessous) : la ligne badges est présente sur CHAQUE
        # carte, y compris un profil inactif sans proxy (le badge YouTube,
        # lui, doit rester togglable indépendamment de ces deux états).
        hauteur_extra = self.EXTRA_HAUTEUR_BOUTONS + self.EXTRA_HAUTEUR_BADGES
        if actif and duree:
            hauteur_extra += self.EXTRA_HAUTEUR_DUREE
        # PATCH (retour utilisateur explicite : "il faut doubler leur
        # hautuer") -- une fois gridSize/sizeHint corrigés (cf.
        # hauteur_cible_px), la carte reçoit deux fois plus de hauteur
        # totale -- mais la zone "nom" ci-dessous prenait TOUT le reste
        # (option.rect.height() - hauteur_extra, sans plafond), et
        # super().paint() centre le texte VERTICALEMENT dans cette zone
        # (cf. paint() ci-dessous, qui applique la même geometrie à
        # option_nom) : résultat vérifié par rendu Qt réel -- le nom se
        # retrouvait centré au milieu d'un grand vide, au lieu de rester
        # une ligne compacte en haut de carte suivie d'un espacement
        # ajouté en bas (redistribué, cf. HAUTEUR_ZONE_NOM_MAX ci-dessous).
        # HAUTEUR_ZONE_NOM_MAX plafonne cette zone à une hauteur de ligne
        # de texte raisonnable (cohérente avec hauteur_ligne_nom=24 déjà
        # utilisé côté _recalculer_grille_profils pour dimensionner
        # gridSize) : l'espace excédentaire de la carte agrandie reste
        # donc VIDE en bas de la zone nom plutôt qu'au milieu du texte
        # lui-même -- un espacement neutre, pas un défaut visuel.
        HAUTEUR_ZONE_NOM_MAX = 28
        hauteur_disponible_nom = option.rect.height() - hauteur_extra
        option.rect = QRect(
            option.rect.x(), option.rect.y(),
            option.rect.width(), min(hauteur_disponible_nom, HAUTEUR_ZONE_NOM_MAX),
        )

    def paint(self, painter: QPainter, option: QStyleOptionViewItem, index: QModelIndex):
        actif = index.data(DELEGATE_ROLE_ACTIF)
        duree = index.data(DELEGATE_ROLE_DUREE)
        # PATCH (retour utilisateur : "je veux que tu met ces bouon sur
        # une seule ligne de chauqe prilfs en bas") -- la ligne de
        # boutons occupe désormais EXTRA_HAUTEUR_BOUTONS en bas de CHAQUE
        # carte (actif ou non, cf. bloc plus bas), en plus de
        # EXTRA_HAUTEUR_DUREE quand un profil actif affiche sa durée. Le
        # texte natif (nom + badge) doit donc toujours être rétréci en
        # haut, pas seulement quand actif+durée comme avant.
        # PATCH (badges proxy/pays/YouTube) -- EXTRA_HAUTEUR_BADGES
        # ajouté ICI aussi, TOUJOURS (même raisonnement qu'initStyleOption
        # ci-dessus -- les deux DOIVENT rester synchronisés, sinon le
        # texte natif peint par super().paint() ci-dessous chevaucherait
        # la ligne badges peinte plus loin dans cette méthode).
        hauteur_extra = self.EXTRA_HAUTEUR_BOUTONS + self.EXTRA_HAUTEUR_BADGES
        if actif and duree:
            hauteur_extra += self.EXTRA_HAUTEUR_DUREE

        # PATCH (retour utilisateur explicite : "le noms du compte doit
        # etre sur sa ligne seul") -- AVANT ce patch, option_nom.rect
        # gardait toute la largeur de la carte pour le texte natif
        # (nom du profil), alors que le point actif (peint plus bas,
        # ANCRÉ à droite par-dessus) occupe déjà TAILLE_POINT_ACTIF+MARGE_H
        # de cette même largeur, à droite -- Qt, qui ignore totalement ce
        # point custom peint après coup, pouvait donc peindre un nom long
        # jusqu'à chevaucher visuellement ce point (confirmé par rendu Qt
        # réel : le texte tronqué par Qt touchait/passait sous le point
        # au lieu de s'arrêter avant). La largeur réservée au point est
        # donc retirée ICI de option_nom.rect, avant l'appel à
        # super().paint() -- Qt tronque alors le texte (ellipsis "…")
        # avant cette zone réservée, jamais en dessous : le nom reste
        # seul sur sa ligne, le point toujours visible et jamais chevauché,
        # quelle que soit la longueur du nom.
        TAILLE_POINT_ACTIF = 8
        LARGEUR_RESERVEE_POINT_ACTIF = TAILLE_POINT_ACTIF + self.MARGE_H + 4  # +4 : petit espace de respiration avant le point
        HAUTEUR_ZONE_NOM_MAX = 28
        hauteur_disponible_nom = option.rect.height() - hauteur_extra
        option_nom = QStyleOptionViewItem(option)
        option_nom.rect = QRect(
            option.rect.x(), option.rect.y(),
            option.rect.width(), min(hauteur_disponible_nom, HAUTEUR_ZONE_NOM_MAX),
        )
        # Rect DÉDIÉ au texte natif, réduit de LARGEUR_RESERVEE_POINT_ACTIF
        # -- option_nom lui-même (hauteur incluse) reste la référence pour
        # le reste de paint() (rect_coche, point actif) ci-dessous, seule
        # sa largeur de PEINTURE DU TEXTE est concernée par cette réserve.
        option_texte_nom = QStyleOptionViewItem(option_nom)
        option_texte_nom.rect = QRect(
            option_nom.rect.x(), option_nom.rect.y(),
            max(option_nom.rect.width() - LARGEUR_RESERVEE_POINT_ACTIF, 0),
            option_nom.rect.height(),
        )
        super().paint(painter, option_texte_nom, index)

        # PATCH (retour utilisateur : "juste le point de actifs de vient
        # vert quand le profils est actifs") -- le texte natif est
        # maintenant "nom  actif"/"nom  inactif" SANS symbole (cf.
        # _rafraichir_liste_profils, le "●"/"○" a été retiré de la
        # chaîne) : Qt peint ce texte en une seule couleur uniforme, donc
        # impossible d'y colorer un symbole indépendamment du mot à côté
        # en restant dans le texte natif. Le point est donc peint ICI à
        # la main.
        #
        # POSITION (choix après plusieurs essais ratés, cf. historique) :
        # tenter de le placer PIXEL-PERFECT juste devant le mot
        # "actif"/"inactif" en mesurant la largeur du texte qui précède
        # s'est révélé peu fiable -- la largeur mesurée via
        # QFontMetrics.horizontalAdvance() ne correspondait pas à la
        # largeur réellement peinte par Qt à l'écran (écart constaté par
        # comparaison de captures, cause exacte non identifiée avec
        # certitude -- possiblement liée à la façon dont le style peint
        # le texte natif en interne, indépendante de l'API publique
        # utilisée pour la mesure). Plutôt que d'empiler une nouvelle
        # hypothèse non vérifiable, le point est ancré à DROITE de la
        # carte (MARGE_H, la même marge que le texte et les boutons du
        # bas -- cohérente avec le reste de la carte), sur toute la
        # largeur de option_nom.rect : position fixe, indépendante de la
        # longueur du nom du profil ou d'une mesure de texte, donc fiable
        # à 100% quelle que soit la police/le style/la plateforme. Depuis
        # le patch ci-dessus, cette position tombe maintenant TOUJOURS
        # dans la largeur réservée (jamais peinte par le texte natif).
        painter.save()
        try:
            painter.setRenderHint(QPainter.Antialiasing, True)
            rect_point_actif = QRect(0, 0, TAILLE_POINT_ACTIF, TAILLE_POINT_ACTIF)
            rect_point_actif.moveRight(option_nom.rect.right() - self.MARGE_H)
            rect_point_actif.moveTop(option_nom.rect.top() + (option_nom.rect.height() - TAILLE_POINT_ACTIF) // 2)
            painter.setPen(Qt.NoPen)
            painter.setBrush(QColor(Mocha.green) if actif else QColor(Mocha.overlay0))
            painter.drawEllipse(rect_point_actif)
        finally:
            painter.restore()

        # PATCH (retour utilisateur : "cest pas pro, cest pas bien
        # diposer") -- l'indicateur de case à cocher NATIF peint par
        # QStyledItemDelegate ci-dessus s'affichait disproportionné par
        # rapport au texte selon la plateforme/le style Qt actif (aucun
        # contrôle fiable ni via QSS ::indicator, qui ignore partiellement
        # width/height selon les styles, ni via option.features -- Qt
        # continue de le peindre tant que l'item porte
        # Qt.ItemIsUserCheckable, indépendamment de HasCheckIndicator).
        # Solution robuste : le mécanisme NATIF reste intact (case
        # toujours cliquable, itemChanged toujours émis, cf.
        # _sur_case_profil_changee) -- on RECOUVRE juste sa zone exacte
        # (subElementRect, l'API Qt officielle pour la connaître, pas une
        # estimation) avec la couleur de fond de la carte, puis on peint
        # PAR-DESSUS un petit rond custom, cohérent en taille avec le
        # texte et les boutons du bas.
        painter.save()
        try:
            painter.setRenderHint(QPainter.Antialiasing, True)
            option_indicateur = QStyleOptionViewItem(option_nom)
            option_indicateur.features |= QStyleOptionViewItem.HasCheckIndicator
            # Qt.CheckState(...) explicite : sur certaines versions de
            # PySide6, index.data(Qt.CheckStateRole) renvoie un int brut
            # (ex. 2) plutôt qu'un Qt.CheckState -- l'assignation directe
            # lève alors un TypeError ("wrong type attributed to
            # 'checkState'"), révélé en testant ce delegate hors écran.
            valeur_coche_brute = index.data(Qt.CheckStateRole)
            option_indicateur.checkState = (
                Qt.CheckState(valeur_coche_brute) if valeur_coche_brute is not None else Qt.Unchecked
            )
            style_widget = option.widget
            rect_natif = (style_widget.style() if style_widget is not None else QApplication.style()).subElementRect(
                QStyle.SE_ItemViewItemCheckIndicator, option_indicateur, style_widget,
            )
            if rect_natif.isValid():
                couleur_survol = option.state & QStyle.State_Selected or option.state & QStyle.State_MouseOver
                painter.fillRect(
                    rect_natif,
                    QColor(Mocha.surface1) if couleur_survol else QColor(Mocha.surface0),
                )

            coche = index.data(Qt.CheckStateRole)
            # CORRECTIF (bug : "ça coche mais visuellement rien ne change,
            # devrait passer en bleu/mauve") -- cause : sur cette version
            # de PySide6, index.data(Qt.CheckStateRole) renvoie un int
            # brut (2 pour Checked, cf. logs "CheckStateRole change:
            # 0 -> 2"), pas un membre de l'enum Qt.CheckState. Or
            # `coche == Qt.Checked` compare un int brut à un membre
            # d'enum -- Python/PySide6 renvoie False dans ce cas (testé :
            # 2 == Qt.Checked -> False), alors que Qt.CheckState(2) ==
            # Qt.Checked -> True. Le même souci avait déjà été identifié
            # et corrigé un peu plus haut pour option_indicateur.checkState
            # (cf. commentaire juste au-dessus), mais pas ici -- donc la
            # comparaison échouait silencieusement (aucune exception,
            # juste toujours la branche "non coché") et le rond restait
            # gris quel que soit l'état réel du modèle.
            coche = Qt.CheckState(coche) if coche is not None else Qt.Unchecked
            # PATCH (retour utilisateur : "la checkbox ne fonctionne pas ,
            # et elle est trop petite") -- deux corrections :
            # 1) Repositionné sur rect_natif (zone REELLE où Qt écoute le
            #    clic natif de la case à cocher, cf. subElementRect
            #    ci-dessus) au lieu d'un MARGE_H en dur déconnecté de
            #    cette zone -- c'est ce décalage qui faisait qu'un clic
            #    sur le rond visible ne tombait pas forcément sur la zone
            #    où Qt traite réellement le clic (mécanisme natif
            #    inchangé, cf. commentaire plus haut). Si rect_natif
            #    n'est pas valide (cas limite), on retombe sur l'ancien
            #    calcul par MARGE_H pour ne jamais laisser un rect nul.
            # 2) Agrandi de 10 à 14px -- 10px avait été jugé trop petit ;
            #    14px reste discret sans dominer le texte à côté (cf.
            #    comparaison faite plus tôt entre taille de police et
            #    taille du rond).
            taille_coche = 14
            rect_coche = QRect(0, 0, taille_coche, taille_coche)
            if rect_natif.isValid():
                rect_coche.moveCenter(rect_natif.center())
            else:
                rect_coche.moveLeft(option.rect.left() + self.MARGE_H)
                rect_coche.moveTop(option_nom.rect.top() + (option_nom.rect.height() - taille_coche) // 2)

            if coche == Qt.Checked:
                painter.setPen(Qt.NoPen)
                painter.setBrush(QColor(Mocha.blue))
            else:
                painter.setPen(QPen(QColor(Mocha.overlay0), 1.2))
                painter.setBrush(QColor(Mocha.surface1))
            painter.drawEllipse(rect_coche)
        finally:
            painter.restore()

        # PATCH (demande utilisateur explicite : "je veux que on rajoute
        # certains truc : le signe de proxy, le pays, et un badge
        # youtube" + "non diiot , je vuex les deux" [icône proxy ET
        # drapeau+pays]) -- ligne badges, TOUJOURS peinte (cf.
        # EXTRA_HAUTEUR_BADGES, non conditionnelle) : icône proxy + drapeau
        # + code pays à GAUCHE (dans cet ordre, seulement les éléments
        # dont la donnée est disponible -- un profil sans proxy n'affiche
        # ni l'un ni l'autre), badge YouTube ANCRÉ À DROITE (cf.
        # rect_bouton_youtube, toujours peint, togglable indépendamment du
        # proxy/pays).
        # PATCH (retour utilisateur explicite : "on met ladresse proxy,
        # ladress ip" + "au debut tu ecrit dabord : connectee..." + point
        # vert à côté de "Connecté") -- remplace l'ancienne ligne badges
        # unique (rect_ligne_badges, centrée avec du vide) par le bloc
        # compact 3 lignes (rect_bloc_infos, cf. sa docstring) : ligne
        # pays (point vert + "Connecté • Pays" + drapeau + YouTube),
        # ligne IP seule, ligne IP+host:port dupliquée juste en dessous.
        painter.save()
        try:
            painter.setRenderHint(QPainter.Antialiasing, True)
            rects_infos = self.rect_bloc_infos(option)
            ligne_pays = rects_infos["pays"]
            x_curseur = ligne_pays.left()

            proxy_actif = index.data(DELEGATE_ROLE_PROXY_ACTIF)
            code_pays = index.data(DELEGATE_ROLE_PAYS)

            if proxy_actif:
                icone_proxy = qta.icon("mdi6.server-network-outline", color=Mocha.subtext0)
                taille_icone_proxy = 14
                pixmap_proxy = icone_proxy.pixmap(QSize(taille_icone_proxy, taille_icone_proxy))
                rect_icone_proxy = QRect(0, 0, taille_icone_proxy, taille_icone_proxy)
                rect_icone_proxy.moveLeft(x_curseur)
                rect_icone_proxy.moveTop(ligne_pays.top() + (ligne_pays.height() - taille_icone_proxy) // 2)
                painter.drawPixmap(rect_icone_proxy, pixmap_proxy)
                x_curseur = rect_icone_proxy.right() + 6

            # PATCH (retour utilisateur explicite : "je veux que si il
            # nont pas de proxy a la place de drapeua et noms de pays tu
            # le dit") -- zone pays TOUJOURS peinte avec un contenu
            # explicite, dans TOUS les cas (jamais silencieusement vide,
            # c'est justement ce vide -- ou ce texte manquant pour un
            # proxy sans pays testé, cf. juste en dessous -- que
            # l'utilisateur signalait sur sa capture d'écran) :
            # - code_pays présent : point vert (connecté) + drapeau +
            #   "Connecté • {Pays}" (via _nom_pays_depuis_code, pas le
            #   seul code ISO 2 lettres -- trop peu lisible une fois la
            #   zone agrandie).
            # - proxy_actif mais code_pays absent : proxy configuré, mais
            #   jamais testé avec succès (cf. docstring DELEGATE_ROLE_PAYS
            #   plus haut) -- texte de repli DISTINCT de "Aucun proxy",
            #   pour ne pas laisser croire qu'il n'y a pas de proxy du
            #   tout alors qu'il y en a un.
            # - ni proxy_actif ni code_pays : vraiment aucun proxy
            #   configuré sur ce profil -- "Aucun proxy".
            # PATCH (retour utilisateur explicite : "connecte aparait si
            # on a reelement effectuer la coneection, dans le cas
            # contraire cest deconnecte et le point nest pas vert") --
            # code_pays SEUL ne suffit plus à afficher "Connecté" : ce
            # champ est PERSISTÉ sur disque (cf. definir_pays_config_profil,
            # docstring DELEGATE_ROLE_PAYS) donc il survit à l'arrêt du
            # profil, à un redémarrage de l'app, ou à un nouveau lancement
            # dont le test a échoué -- afficher "Connecté" dans ces cas
            # mentait sur l'état réel. `actif` (DELEGATE_ROLE_ACTIF, déjà
            # lu en tout début de paint()) est la SEULE source de vérité
            # sur une connexion active EN CE MOMENT : le pays reste
            # affiché (dernier connu, utile) mais préfixé "Déconnecté"
            # avec un point gris dès que le profil n'est pas actif --
            # jamais vert dans ce cas, même avec un code_pays présent.
            if code_pays:
                connecte = bool(actif)
                # PATCH (retour utilisateur explicite : "le point qui est
                # a coter de connecte doit etre vert") -- vert UNIQUEMENT
                # si réellement connecté maintenant (actif), gris sinon --
                # même principe que rect_coche plus haut dans paint() mais
                # couleur conditionnelle ici.
                diametre_point = 8
                rect_point = QRect(0, 0, diametre_point, diametre_point)
                rect_point.moveLeft(x_curseur)
                rect_point.moveTop(ligne_pays.top() + (ligne_pays.height() - diametre_point) // 2)
                painter.setPen(Qt.NoPen)
                painter.setBrush(QColor(Mocha.green if connecte else Mocha.overlay0))
                painter.drawEllipse(rect_point)
                x_curseur = rect_point.right() + 6

                # Cache mémoire lu sur l'écran propriétaire (cf.
                # ProfilsInstancesScreen._pixmaps_drapeaux_grille) --
                # aucune requête réseau ici même en cas d'absence du cache
                # (déléguée à _demander_drapeau_grille, asynchrone, cf. son
                # docstring) : paint() ne doit JAMAIS bloquer le thread GUI.
                # self.parent() est la QListWidget (cf. ProfilsGridItemDelegate(liste)
                # à l'instanciation), PAS l'écran -- la référence Python
                # posée sur liste._ecran_profils_instances (cf.
                # _construire_bloc_onglet_profils) est le seul chemin
                # fiable jusqu'à ProfilsInstancesScreen depuis ici.
                liste_instances = self.parent()
                ecran = getattr(liste_instances, "_ecran_profils_instances", None) if liste_instances is not None else None
                pixmap_drapeau = None
                if ecran is not None and hasattr(ecran, "_pixmaps_drapeaux_grille"):
                    pixmap_drapeau = ecran._pixmaps_drapeaux_grille.get(code_pays)
                    if code_pays not in ecran._pixmaps_drapeaux_grille:
                        ecran._demander_drapeau_grille(code_pays)

                if pixmap_drapeau:
                    rect_drapeau = QRect(0, 0, self.TAILLE_DRAPEAU_LARGEUR, self.TAILLE_DRAPEAU_HAUTEUR)
                    rect_drapeau.moveLeft(x_curseur)
                    rect_drapeau.moveTop(ligne_pays.top() + (ligne_pays.height() - self.TAILLE_DRAPEAU_HAUTEUR) // 2)
                    painter.drawPixmap(rect_drapeau, pixmap_drapeau)
                    x_curseur = rect_drapeau.right() + 6

                police_pays = QFont(option.font)
                painter.setFont(police_pays)
                painter.setPen(QPen(QColor(Mocha.text if connecte else Mocha.subtext0)))
                # PATCH (retour utilisateur explicite : "enlève le badge
                # youtube, tu le mets sur une autre ligne en bas") -- ne
                # réserve plus d'espace pour un badge à droite : le badge
                # YouTube n'est plus peint sur cette ligne (cf. plus bas,
                # ligne "badges" dédiée), le texte pays peut utiliser
                # toute la largeur utile.
                rect_texte_pays = QRect(
                    x_curseur, ligne_pays.top(),
                    max(ligne_pays.right() - x_curseur, 0),
                    ligne_pays.height(),
                )
                # PATCH (retour utilisateur explicite : "que sur la ligne
                # de drapeau qu'au debut tu ecrit dabord : connectee...")
                # -- préfixe "Connecté • " / "Déconnecté • " selon `actif`
                # réel (cf. ci-dessus), pas seulement selon code_pays.
                prefixe = "Connecté" if connecte else "Déconnecté"
                painter.drawText(
                    rect_texte_pays, Qt.AlignLeft | Qt.AlignVCenter,
                    f"{prefixe} • {_nom_pays_depuis_code(code_pays)}",
                )
            else:
                # PATCH (retour utilisateur explicite : "quand on lance
                # une instance, sa teste directement ... on doit
                # nettement voir le statut du proxy") -- DELEGATE_ROLE_STATUT_PROXY
                # (cf. sa docstring, alimenté par _lancer_instance_pour_profil
                # au lancement) prime sur le texte de repli générique
                # "Proxy non testé"/"Aucun proxy" : un profil dont le test
                # vient de démarrer ou vient d'échouer doit afficher CE
                # statut précis, pas un texte statique qui ne refléterait
                # pas ce qui se passe réellement à l'instant du lancement.
                statut_proxy = index.data(DELEGATE_ROLE_STATUT_PROXY)
                if statut_proxy == "en_cours":
                    texte_repli, couleur_repli = "Test en cours…", Mocha.yellow
                elif statut_proxy == "echec":
                    texte_repli, couleur_repli = "Échec proxy", Mocha.red
                elif proxy_actif:
                    texte_repli, couleur_repli = "Proxy non testé", Mocha.overlay0
                else:
                    texte_repli, couleur_repli = "Aucun proxy", Mocha.overlay0

                police_repli = QFont(option.font)
                police_repli.setItalic(True)
                painter.setFont(police_repli)
                painter.setPen(QPen(QColor(couleur_repli)))
                # PATCH (retour utilisateur explicite : "enlève le badge
                # youtube, tu le mets sur une autre ligne en bas") -- cf.
                # même remarque que rect_texte_pays ci-dessus, plus de
                # réservation d'espace pour un badge sur cette ligne.
                rect_texte_repli = QRect(
                    x_curseur, ligne_pays.top(),
                    max(ligne_pays.right() - x_curseur, 0),
                    ligne_pays.height(),
                )
                painter.drawText(rect_texte_repli, Qt.AlignLeft | Qt.AlignVCenter, texte_repli)

            # PATCH (retour utilisateur explicite : "juse en bas de la
            # ligne de drapeau on met ladresse proxy, ladress ip" +
            # "lapdree ip publique detectee, et en bas une autre ligne
            # pour tout les donne" + "oui dupliquer" [IP seule, PUIS
            # IP+host:port]) -- 2 lignes de texte compactes sous la ligne
            # pays, alimentées par DELEGATE_ROLE_IP (str|None, persisté
            # cf. definir_pays_config_profil) et DELEGATE_ROLE_PROXY
            # (dict|None, tel que configuré -- cf. sa docstring). Rien
            # peint si l'IP n'est pas encore connue (profil jamais testé
            # avec succès) : pas de ligne "None" ou vide qui laisserait
            # un texte incohérent.
            ip_detectee = index.data(DELEGATE_ROLE_IP)
            if ip_detectee:
                police_info = QFont(option.font)
                police_info.setPointSize(max(police_info.pointSize() - 2, 7))
                painter.setFont(police_info)

                ligne_ip = rects_infos["ip"]
                painter.setPen(QPen(QColor(Mocha.subtext0)))
                painter.drawText(ligne_ip, Qt.AlignLeft | Qt.AlignVCenter, ip_detectee)

                proxy_config = index.data(DELEGATE_ROLE_PROXY)
                ligne_proxy = rects_infos["proxy"]
                if proxy_config and proxy_config.get("host"):
                    port = proxy_config.get("port")
                    hote_port = f"{proxy_config['host']}:{port}" if port else proxy_config["host"]
                    texte_proxy = f"{ip_detectee} • {hote_port}"
                else:
                    texte_proxy = ip_detectee
                painter.setPen(QPen(QColor(Mocha.subtext0)))
                painter.drawText(ligne_proxy, Qt.AlignLeft | Qt.AlignVCenter, texte_proxy)

            # PATCH (retour utilisateur explicite : "enlève le badge
            # youtube, tu le mets sur une autre ligne en bas, en bas des
            # données de l'adresse ip, tu vas mettre 3 badges : youtube,
            # tiktok, et un symbole de ia") -- 4e ligne dédiée, sous la
            # ligne proxy : 3 badges togglables côte à côte (cf.
            # rect_badges_reseaux), même logique de couleur que l'ancien
            # badge YouTube seul (vert si actif, gris sinon -- cf. PATCH
            # "au lieu de mettre la couleur rouge comme actifs, tu peux
            # plutôt mettre du vert" plus haut dans l'historique). Chaque
            # badge peint indépendamment de la présence des autres --
            # aucune donnée (index.data(...) is None) n'empêche les deux
            # autres de s'afficher normalement.
            rects_badges = self.rect_badges_reseaux(option)
            cote_badge = self.TAILLE_BADGE_RESEAU

            youtube_actif = index.data(DELEGATE_ROLE_YOUTUBE)
            if youtube_actif is not None:
                icone_youtube = qta.icon(
                    "mdi6.youtube",
                    color=Mocha.green if youtube_actif else Mocha.overlay0,
                )
                pixmap_youtube = icone_youtube.pixmap(QSize(cote_badge, cote_badge))
                painter.drawPixmap(rects_badges["youtube"], pixmap_youtube)

            tiktok_actif = index.data(DELEGATE_ROLE_TIKTOK)
            if tiktok_actif is not None:
                icone_tiktok = qta.icon(
                    "fa5b.tiktok",
                    color=Mocha.green if tiktok_actif else Mocha.overlay0,
                )
                pixmap_tiktok = icone_tiktok.pixmap(QSize(cote_badge, cote_badge))
                painter.drawPixmap(rects_badges["tiktok"], pixmap_tiktok)

            ia_actif = index.data(DELEGATE_ROLE_IA)
            if ia_actif is not None:
                icone_ia = qta.icon(
                    "mdi6.robot-outline",
                    color=Mocha.green if ia_actif else Mocha.overlay0,
                )
                pixmap_ia = icone_ia.pixmap(QSize(cote_badge, cote_badge))
                painter.drawPixmap(rects_badges["ia"], pixmap_ia)

            # PATCH (demande utilisateur explicite : "je veux que on peu
            # mettre un statut de favoris pour un profils, donc dans les
            # card des profils tu vas mettre un onglet : favoris") -- 4e
            # badge, même principe exact que youtube/tiktok/ia ci-dessus
            # (icône seule, colorée selon l'état). Étoile pleine en jaune
            # (couleur distincte du vert des 3 autres badges -- un favori
            # n'est pas un "réseau activé", c'est un statut différent,
            # mieux distingué visuellement par une couleur différente)
            # quand actif, contour gris (comme les autres badges inactifs)
            # sinon.
            favori_actif = index.data(DELEGATE_ROLE_FAVORI)
            if favori_actif is not None:
                icone_favori = qta.icon(
                    "mdi6.star" if favori_actif else "mdi6.star-outline",
                    color=Mocha.yellow if favori_actif else Mocha.overlay0,
                )
                pixmap_favori = icone_favori.pixmap(QSize(cote_badge, cote_badge))
                painter.drawPixmap(rects_badges["favori"], pixmap_favori)

            # PATCH (demande utilisateur explicite : "tu vas rajouter le
            # badge Test, comme il y a le badge youtube, tiktok") -- 5e
            # badge, même principe exact que youtube/tiktok/ia ci-dessus
            # (icône seule, verte si actif, gris sinon).
            test_actif = index.data(DELEGATE_ROLE_TEST)
            if test_actif is not None:
                icone_test = qta.icon(
                    "mdi6.bug",
                    color=Mocha.green if test_actif else Mocha.overlay0,
                )
                pixmap_test = icone_test.pixmap(QSize(cote_badge, cote_badge))
                painter.drawPixmap(rects_badges["test"], pixmap_test)
        finally:
            painter.restore()

        # PATCH (retour utilisateur : "cest pas pro, arrage bien") --
        # séparateur fin entre la zone texte/infos et la zone d'actions,
        # pour structurer visuellement la carte en deux zones nettes
        # plutôt que des boutons qui semblent flotter en bas sans lien
        # avec le reste. Peint sur toute la largeur utile de la carte
        # (mêmes marges que le texte), juste au-dessus de la ligne de
        # boutons.
        painter.save()
        try:
            # PATCH (retour utilisateur explicite : "les agrandir et les
            # centrer dans le grand espace vide du milieu") -- la zone
            # badges/pays (cf. rect_ligne_badges) est désormais CENTRÉE
            # dans l'espace libre entre le nom et le bloc boutons, elle ne
            # pousse plus le séparateur en le remontant : celui-ci reste
            # simplement juste au-dessus du bloc boutons, position fixe
            # indépendante de l'espace libre disponible au-dessus de lui.
            y_separateur = option.rect.bottom() - self.EXTRA_HAUTEUR_BOUTONS + 2
            stylo_separateur = QPen(QColor(Mocha.surface2))
            stylo_separateur.setWidth(1)
            painter.setPen(stylo_separateur)
            painter.drawLine(
                option.rect.left() + self.MARGE_H, y_separateur,
                option.rect.right() - self.MARGE_H, y_separateur,
            )
        finally:
            painter.restore()

        # PATCH (bouton lancer/arrêter par profil, demande utilisateur) --
        # peint pour TOUS les items (actifs ou non) : c'est justement ce
        # bouton qui permet de lancer un profil encore inactif directement
        # depuis la grille, sans passer par une sélection préalable +
        # bouton_lancer_arreter global (supprimé). Bloc séparé (save/
        # restore dédié) pour ne dépendre d'aucun état laissé par un autre
        # bloc.
        etat_bouton = index.data(DELEGATE_ROLE_ETAT_BOUTON)
        if etat_bouton is not None:
            painter.save()
            try:
                painter.setRenderHint(QPainter.Antialiasing, True)
                rect_bouton = self.rect_bouton(option, actif, duree)

                if etat_bouton == "arret_en_cours":
                    couleur_fond = QColor(Mocha.surface2)
                    nom_icone = "mdi6.timer-sand"
                    couleur_icone = Mocha.subtext0
                elif etat_bouton == "lancement_en_cours":
                    # PATCH (retour utilisateur : feedback visuel pendant
                    # les 30-50s de démarrage réel, avant confirmation
                    # serveur) -- même icône sablier que "arret_en_cours"
                    # (cohérence visuelle : sablier = "action en cours,
                    # patiente"), mais fond bleu (cf. couleur "inactif"
                    # ci-dessous) plutôt que gris neutre, pour rester
                    # dans la famille de couleur du bouton "lancer" et ne
                    # pas se confondre avec l'arrêt (fond gris) ni avec
                    # l'actif (fond rouge).
                    couleur_fond = QColor(Mocha.blue)
                    nom_icone = "mdi6.timer-sand"
                    couleur_icone = Mocha.crust
                elif etat_bouton == "actif":
                    couleur_fond = QColor(Mocha.red)
                    nom_icone = "mdi6.stop"
                    couleur_icone = Mocha.crust
                else:  # "inactif"
                    # PATCH (retour utilisateur : "je veux que les bouton
                    # de lancemant ne soit lus vert, cest pas adapter a la
                    # couleur de linterface") -- Mocha.green détonnait à
                    # côté du reste de l'UI, construite sur la famille
                    # mauve/lavender/blue (cf. logo, bordures, accents
                    # ailleurs dans ce fichier). Mocha.blue s'intègre à
                    # cette palette tout en restant clairement distinct du
                    # rouge d'arrêt ci-dessus.
                    couleur_fond = QColor(Mocha.blue)
                    nom_icone = "mdi6.play"
                    couleur_icone = Mocha.crust

                painter.setPen(Qt.NoPen)
                painter.setBrush(couleur_fond)
                painter.drawEllipse(rect_bouton)

                icone = qta.icon(nom_icone, color=couleur_icone)
                taille_icone = max(self.TAILLE_BOUTON - 8, 8)
                pixmap_icone = icone.pixmap(QSize(taille_icone, taille_icone))
                rect_icone = QRect(0, 0, taille_icone, taille_icone)
                rect_icone.moveCenter(rect_bouton.center())
                painter.drawPixmap(rect_icone, pixmap_icone)
            finally:
                painter.restore()

        # PATCH (bouton Free par carte, demande utilisateur : "il ya
        # aussi le botuon free qui permet de librere rune instance, tu le
        # met aussi") -- même principe que le bouton lancer/arrêter
        # ci-dessus, mais seulement peint si le profil est actif (None ==
        # rien à libérer, cf. DELEGATE_ROLE_ETAT_FREE) : pas de bouton
        # Free "grisé" sur un profil inactif, il disparaît complètement
        # plutôt que d'occuper de l'espace pour une action qui n'aurait
        # aucun sens.
        etat_free = index.data(DELEGATE_ROLE_ETAT_FREE)
        if etat_free is not None:
            painter.save()
            try:
                painter.setRenderHint(QPainter.Antialiasing, True)
                rect_free = self.rect_bouton_free(option, actif, duree)

                if etat_free == "free_en_cours":
                    couleur_fond = QColor(Mocha.surface2)
                    couleur_icone = Mocha.subtext0
                else:  # "actif"
                    couleur_fond = QColor(Mocha.surface1)
                    couleur_icone = Mocha.red

                painter.setPen(Qt.NoPen)
                painter.setBrush(couleur_fond)
                painter.drawEllipse(rect_free)

                icone = qta.icon(
                    "mdi6.timer-sand" if etat_free == "free_en_cours" else "mdi6.link-off",
                    color=couleur_icone,
                )
                taille_icone = max(self.TAILLE_BOUTON - 8, 8)
                pixmap_icone = icone.pixmap(QSize(taille_icone, taille_icone))
                rect_icone = QRect(0, 0, taille_icone, taille_icone)
                rect_icone.moveCenter(rect_free.center())
                painter.drawPixmap(rect_icone, pixmap_icone)
            finally:
                painter.restore()

        # PATCH (demande utilisateur explicite : toggle "bloquer médias"
        # par profil, "sur la ligen du bouon de demarage") -- 3e bouton
        # de la ligne du bas, peint pour TOUS les items (comme rect_bouton
        # ci-dessus -- togglable même si le profil est inactif, contrairement
        # au bouton Free qui n'existe que pour un profil actif). Icône
        # "image barrée" verte quand le blocage est actif, grise sinon --
        # même code couleur (Mocha.green actif / Mocha.overlay0 inactif)
        # que les badges YouTube/TikTok/IA/Test ci-dessus.
        bloquer_media_actif = index.data(DELEGATE_ROLE_BLOQUER_MEDIA)
        if bloquer_media_actif is not None:
            painter.save()
            try:
                painter.setRenderHint(QPainter.Antialiasing, True)
                rect_bloquer_media = self.rect_bouton_bloquer_media(option, actif, duree)

                # CORRECTIF (retour utilisateur : "sa ne fontionne pas") --
                # AVANT : fond toujours gris (surface1), SEULE la couleur
                # du glyphe changeait (vert/gris) entre les deux états. Sur
                # une icône de 16px, la différence était à peine visible,
                # donc un clic qui marchait pouvait passer pour un clic
                # sans effet. Le fond bascule maintenant en entier, comme
                # le bouton lancer/arrêter juste à gauche (bleu/rouge) :
                # vert plein = médias bloqués, pastille grise = blocage
                # inactif, lisible d'un coup d'œil sur toute la grille.
                if bloquer_media_actif:
                    couleur_fond = QColor(Mocha.green)
                    couleur_icone = Mocha.crust
                else:
                    couleur_fond = QColor(Mocha.surface1)
                    couleur_icone = Mocha.overlay0

                painter.setPen(Qt.NoPen)
                painter.setBrush(couleur_fond)
                painter.drawEllipse(rect_bloquer_media)

                # CORRECTIF -- cf. _icone_qta_premiere_disponible : le nom
                # "mdi6.image-off-outline" n'existe pas dans toutes les
                # versions de qtawesome, et un qta.icon() qui lève depuis
                # paint() interrompt le rendu de la carte en plein milieu
                # (tout ce qui suit -- texte de durée compris -- disparaît
                # alors silencieusement). Noms de repli du plus précis au
                # plus universel ; None -> pastille seule, sans glyphe.
                icone = _icone_qta_premiere_disponible(
                    ["mdi6.image-off-outline", "mdi6.image-off", "mdi6.eye-off-outline", "mdi6.image"],
                    couleur_icone,
                )
                if icone is not None:
                    taille_icone = max(self.TAILLE_BOUTON - 8, 8)
                    pixmap_icone = icone.pixmap(QSize(taille_icone, taille_icone))
                    rect_icone = QRect(0, 0, taille_icone, taille_icone)
                    rect_icone.moveCenter(rect_bloquer_media.center())
                    painter.drawPixmap(rect_icone, pixmap_icone)
            finally:
                painter.restore()

        # PATCH (retour utilisateur : "tu vas aussi enlever la bordure
        # vert, le bouton darret symbolise deja lactivier") -- l'ancienne
        # bordure verte (drawRoundedRect) redondait avec le bouton
        # lancer/arrêter ci-dessus : rouge + icône stop suffit à signaler
        # qu'un profil est actif, sans un second signal visuel. Il ne
        # reste donc plus, pour un profil actif, que le texte de durée à
        # peindre -- juste au-dessus de la ligne de boutons.
        if not (actif and duree):
            return

        painter.save()
        try:
            painter.setRenderHint(QPainter.Antialiasing, True)
            police_duree = QFont(option.font)
            police_duree.setPointSize(max(7, option.font.pointSize() - 2))
            painter.setFont(police_duree)
            painter.setPen(QPen(QColor(Mocha.subtext0)))
            # PATCH (retour utilisateur : "cest pas bien diposer, arrage
            # bien") -- même marge gauche (MARGE_H) que le nom du profil
            # et les boutons ci-dessus/ci-dessous, au lieu d'un retrait de
            # 8px arbitraire, différent du reste de la carte -- tout
            # s'aligne désormais sur une seule et même colonne verticale.
            rect_duree = QRect(
                option.rect.x() + self.MARGE_H,
                option.rect.bottom() - self.EXTRA_HAUTEUR_BOUTONS - self.EXTRA_HAUTEUR_DUREE,
                option.rect.width() - 2 * self.MARGE_H,
                self.EXTRA_HAUTEUR_DUREE,
            )
            icone_horloge = qta.icon("mdi6.clock-outline", color=Mocha.subtext0)
            taille_icone_horloge = 11
            pixmap_horloge = icone_horloge.pixmap(QSize(taille_icone_horloge, taille_icone_horloge))
            rect_icone_horloge = QRect(0, 0, taille_icone_horloge, taille_icone_horloge)
            rect_icone_horloge.moveLeft(rect_duree.left())
            rect_icone_horloge.moveTop(rect_duree.top() + (rect_duree.height() - taille_icone_horloge) // 2)
            painter.drawPixmap(rect_icone_horloge, pixmap_horloge)
            rect_texte_duree = rect_duree.adjusted(taille_icone_horloge + 4, 0, 0, 0)
            painter.drawText(rect_texte_duree, Qt.AlignLeft | Qt.AlignVCenter, duree)
        finally:
            painter.restore()

class DrapeauWorker(QObject):
    """Télécharge le PNG d'un drapeau pays dans un QThread séparé, JAMAIS
    sur le thread GUI (même principe que TestProxyWorker juste en dessous
    -- une requête HTTP vers flagcdn.com peut être lente/indisponible,
    inacceptable sur le thread GUI qui gèlerait l'appli entière).

    PATCH (demande utilisateur explicite : "je veux le drapeau, meme si il
    faut se connecter a un service externe automatiquement pour l'obtenir")
    -- remplace le drapeau emoji (_pays_vers_drapeau_emoji, cf. son
    docstring), dont le rendu QLabel s'est révélé dépendant d'une police
    système absente/mal supportée sur la machine de l'utilisateur.

    Délègue tout le travail réseau/cache à _telecharger_drapeau_pays
    (fonction pure, sans dépendance Qt -- thread-safe par construction,
    ne touche que le système de fichiers et le réseau)."""

    demande_drapeau = Signal(str, str)  # (id_requete, code_pays) -- émis depuis le thread GUI
    resultat_pret = Signal(str, object)  # (id_requete, chemin_local_ou_None)

    def __init__(self):
        super().__init__()
        self.demande_drapeau.connect(self._executer)

    def _executer(self, id_requete: str, code_pays: str):
        chemin = _telecharger_drapeau_pays(code_pays)
        self.resultat_pret.emit(id_requete, chemin)


