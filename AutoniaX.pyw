    async def _envoyer_preference_capture(self):
        """Envoie (ou ré-envoie) la préférence résolution/qualité au
        serveurT -- même patron que _envoyer_config_stockage : no-op
        silencieux si rien n'a encore été réglé (self._preference_
        capture est None tant que definir_preference_capture n'a jamais
        été appelée), pour ne pas spammer un réglage par défaut à
        chaque connexion tant que le pilote n'a rien changé -- le
        serveurT garde alors ses propres défauts (cf. Connexion.
        preference_capture)."""
        if not self._preference_capture:
            return
        if self._ws is None:
            return
        try:
            await self._ws.send(json.dumps({
                "type": "definir_preference_capture",
                **self._preference_capture,
            }))
            log_reseau_t.info(f"-> definir_preference_capture envoyé au serveurT ({self._preference_capture!r})")
        except Exception as e:
            log_reseau_t.warning(f"Échec envoi definir_preference_capture : {e!r}")

    async def _envoyer_projet_vers_sautoniax(
        self, id_executant: str, nom_projet: str, profils: list, chemin_dossier_projet: str, session_id: str,
    ):
        """Zippe le dossier de ProjetBatch puis le transfère EN CHUNKS,
        relayé en direct par le serveurT vers id_executant (jamais stocké
        sur B2 -- cf. docstring serveur.py envoyer_projet_vers_sautoniax_
        debut). Réutilise _zipper_dossier_profil telle quelle (compression
        générique d'un dossier, pas spécifique aux profils malgré son
        nom) pour ne pas dupliquer la logique de compression. session_id
        généré par l'appelant synchrone (cf. envoyer_projet_vers_sautoniax)
        -- pas ici, cf. BUGFIX de sa docstring."""
        self.envoi_projet_sautoniax_progression.emit(session_id, -1)
        try:
            loop = asyncio.get_running_loop()
            chemin_zip = await loop.run_in_executor(None, _zipper_dossier_profil, chemin_dossier_projet)
        except Exception as e:
            log_reseau_t.warning(f"Échec compression projet '{nom_projet}' : {e!r}")
            self.envoi_projet_sautoniax_resultat.emit(False, session_id, f"Échec de la compression : {e}")
            return

        try:
            taille_totale = chemin_zip.stat().st_size
            nb_chunks = max(1, -(-taille_totale // self.TAILLE_CHUNK_RELAIS_OCTETS))

            log_reseau_t.info(
                f"-> envoyer_projet_vers_sautoniax_debut envoyé au serveurT "
                f"('{nom_projet}' -> id_executant={id_executant!r}, {taille_totale} octets, {nb_chunks} chunk(s))"
            )
            await self._ws.send(json.dumps({
                "type": "envoyer_projet_vers_sautoniax_debut",
                "id_executant": id_executant, "session_id": session_id, "nom_projet": nom_projet,
                "profils": profils, "nb_chunks": nb_chunks,
            }))
            ack_debut = await self._attendre_ack_session(session_id)
            if not ack_debut.get("ok", False):
                erreur = ack_debut.get("erreur", "Erreur inconnue")
                log_reseau_t.warning(f"<- envoyer_projet_vers_sautoniax_debut_ack (ok=False) : {erreur}")
                self.envoi_projet_sautoniax_resultat.emit(False, session_id, erreur)
                return

            with open(chemin_zip, "rb") as f:
                for index in range(nb_chunks):
                    morceau = f.read(self.TAILLE_CHUNK_RELAIS_OCTETS)
                    await self._ws.send(json.dumps({
                        "type": "envoyer_projet_vers_sautoniax_chunk",
                        "id_executant": id_executant, "session_id": session_id, "index": index,
                        "contenu_b64": base64.b64encode(morceau).decode("ascii"),
                    }))
                    ack_chunk = await self._attendre_ack_session(session_id)
                    if not ack_chunk.get("ok", False):
                        erreur = ack_chunk.get("erreur", "Erreur inconnue")
                        log_reseau_t.warning(f"<- envoyer_projet_vers_sautoniax_chunk_ack (ok=False, index={index}) : {erreur}")
                        self.envoi_projet_sautoniax_resultat.emit(False, session_id, erreur)
                        return
                    self.envoi_projet_sautoniax_progression.emit(session_id, round((index + 1) / nb_chunks * 100))

            await self._ws.send(json.dumps({
                "type": "envoyer_projet_vers_sautoniax_fin", "id_executant": id_executant, "session_id": session_id,
            }))
            log_reseau_t.info(f"<- envoi projet terminé ('{nom_projet}', session={session_id})")
            self.envoi_projet_sautoniax_resultat.emit(True, session_id, "")
        except Exception as e:
            log_reseau_t.warning(f"Échec envoi projet '{nom_projet}' vers '{id_executant}' : {e!r}")
            self.envoi_projet_sautoniax_resultat.emit(False, session_id, str(e))
        finally:
            chemin_zip.unlink(missing_ok=True)

    async def _mettre_a_jour_service_api(self, id_executant: str, chemin_dossier_service_api: str):
        """MIGRÉ vers Drive direct (cf. docstring mettre_a_jour_service_api
        ci-dessus) : zippe D'ABORD (déporté via run_in_executor, même
        raison que _zipper_dossier_profil ailleurs : peut prendre
        plusieurs secondes sur un gros dossier, ne doit jamais bloquer la
        boucle asyncio du thread réseau), PUIS uploade DIRECTEMENT sur
        Drive (clé DRIVE_CLE_SERVICE_API_ZIP, partagée avec le Flux A --
        point ouvert 2 de la spec, tranché) via
        GestionnaireStockageDriveDirect.envoyer_fichier_vers_cloud
        (également déporté via run_in_executor -- appel bloquant
        googleapiclient, jamais direct sur la boucle asyncio, même
        précaution que _telecharger_fichier ; retry avec backoff
        exponentiel déjà géré à l'intérieur, cf.
        _put_object_avec_retry). Si l'upload échoue, émet directement
        mise_a_jour_service_api_resultat en échec SANS solliciter le
        serveur. Si l'upload réussit, envoie au serveur un message LÉGER
        de signal ("demander_retelechargement_service_api", sans aucun
        octet de fichier dedans) qu'il relaie à l'exécutant ciblé -- pas
        besoin d'y porter id_pilote, le serveur l'ajoute lui-même à
        partir de la connexion pilote émettrice (cf. docstring serveur.py
        du handler, point ouvert 4 de la spec). Le VRAI résultat
        (application locale réussie ou non côté sAutoniax) arrive
        séparément et de façon asynchrone via le message
        "mettre_a_jour_service_api_resultat" reçu de l'exécutant (cf.
        _traiter_message plus bas) -- cette coroutine ne l'attend pas."""
        try:
            loop = asyncio.get_running_loop()
            chemin_zip = await loop.run_in_executor(None, _zipper_dossier_profil, chemin_dossier_service_api)
        except Exception as e:
            log_reseau_t.warning(f"Échec compression service API : {e!r}")
            self.mise_a_jour_service_api_resultat.emit(False, id_executant, f"Échec de la compression : {e}")
            return

        try:
