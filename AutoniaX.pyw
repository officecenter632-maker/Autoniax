_JS_FRAGMENT_COMMUN_PRESSE_PAPIER = """
  // CORRECTIF copie presse-papier : repli execCommand("copy") via un
  // textarea temporaire, utilisé quand l'API native (clipboard.writeText)
  // est refusée ou absente pour une copie HUMAINE. Le drapeau
  // __autoniax_secours_copie__ évite que l'événement "copy" provoqué par
  // ce repli ne réécrase le presse-papier virtuel avec une sélection vide.
  function copieSecoursExecCommand(texte) {
