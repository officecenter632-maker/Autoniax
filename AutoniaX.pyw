        # PATCH (Patch 4.4.a/b -- envoi d'un projet vers un sAutoniax +
        # suivi temps réel). Option A validée avec l'utilisateur : un seul
        # bouton d'envoi (ProjetBatchScreen), le suivi apparaît
        # automatiquement dans l'onglet "Projets Distribués" -- ce bloc
        # fait le pont entre les deux écrans, aucun des deux ne connaissant
        # directement l'autre (même séparation de responsabilités que le
        # reste de MainWindow).
        # ------------------------------------------------------------------

        def _sur_demande_envoi_projet_sautoniax(
            id_executant: str, id_projet_batch: str, chemin_racine: str, nom_projet: str, profils: list,
        ):
            # Construit un project.json MINIMAL à la racine du ProjetBatch
            # (juste CE ProjetBatch + le Task qu'il référence, pas tout le
            # Project -- cf. docstring de _sautoniax_traiter_projet_recu :
            # "la SEULE façon pour le sAutoniax de connaître le Task et le
            # ProjetBatch à exécuter", aucune donnée d'autres Tasks/
            # ServiceAPI n'a besoin de transiter ni d'être exposée à un
            # sAutoniax distant). Écrasé à chaque envoi -- un seul
            # ProjetBatch à la fois peut être envoyé depuis ce dossier
            # racine (cohérent avec chemin_racine = 1 ProjetBatch = 1
            # dossier, cf. ProjetBatch.chemin_racine).
            projet_batch = next(
                (p for p in self.project.projets_batch if p.id == id_projet_batch), None,
            )
            if projet_batch is None:
                reseau_screen.projets_distribues_screen.sur_resultat_envoi(
                    False, "", "ProjetBatch introuvable (a-t-il été supprimé ?).",
                )
                return
            task = self.project.find_task(projet_batch.task_id)
            if task is None:
                reseau_screen.projets_distribues_screen.sur_resultat_envoi(
                    False, "", "Task introuvable pour ce ProjetBatch.",
                )
                return
            project_minimal = Project(tasks=[task], projets_batch=[projet_batch])
            try:
                (Path(chemin_racine) / "project.json").write_text(
                    json.dumps(project_minimal.to_dict(), ensure_ascii=False, indent=2), encoding="utf-8",
                )
            except OSError as e:
                reseau_screen.projets_distribues_screen.sur_resultat_envoi(
                    False, "", f"Échec d'écriture de project.json : {e}",
                )
                return
            session_id = self.client_serveur_t.envoyer_projet_vers_sautoniax(
                id_executant, nom_projet, profils, chemin_racine,
            )
            reseau_screen.projets_distribues_screen.sur_envoi_demande(
                id_executant, id_projet_batch, chemin_racine, nom_projet, session_id,
            )

        dashboard_screen.projets_batch_screen.demande_envoi_projet_sautoniax.connect(
            _sur_demande_envoi_projet_sautoniax
        )

        # ------------------------------------------------------------------
        # PATCH E.5 (cf. cahier des charges patchs.md, section E.5 --
        # "Traiter les échecs" / "Retraiter"). Variante FILTRÉE du bloc
        # juste au-dessus : au lieu d'envoyer chemin_racine tel quel (tout
        # le ProjetBatch, comportement voulu pour un premier envoi, cf.
        # E.4), construit un dossier TEMPORAIRE ne contenant QUE les
        # sous-dossiers numérotés demandés (copiés, jamais déplacés --
        # les données locales d'origine ne sont jamais touchées par cet
        # envoi) + un project.json identique à l'envoi normal. Aucun
        # changement de protocole/serveurT/sAutoniax nécessaire : cf.
        # ProjetBatch.lister_sous_projets/_sautoniax_traiter_projet_recu,
        # les sous-dossiers numérotés d'un projet reçu sont TOUJOURS
        # découverts dynamiquement depuis ce qui est physiquement présent
        # sur disque au moment du traitement, jamais depuis une liste
        # figée dans project.json -- envoyer un sous-ensemble fonctionne
        # donc nativement.
        #
        # Le dossier temporaire est nettoyé (rmtree) une fois l'ENVOI
        # terminé (succès ou échec de la TRANSMISSION réseau, cf.
        # envoi_projet_sautoniax_resultat) -- pas avant, l'envoi est
        # asynchrone par chunks (cf. _envoyer_projet_vers_sautoniax) et
        # lit le contenu du dossier progressivement via le zip déjà
        # produit en amont ; le zip lui-même est nettoyé séparément côté
        # ClientServeurT (finally de _envoyer_projet_vers_sautoniax),
        # donc supprimer le dossier source ICI dès que le résultat arrive
        # ne risque jamais de couper un envoi encore en cours.
        # ------------------------------------------------------------------

        self._dossiers_temp_envoi_filtre: dict[str, str] = {}  # session_id -> chemin dossier temporaire à nettoyer

        def _sur_demande_envoi_projet_sautoniax_filtre(
            id_executant: str, id_projet_batch: str, chemin_racine: str, nom_projet: str,
            profils: list, numeros_sous_projets: list,
        ):
            projet_batch = next(
                (p for p in self.project.projets_batch if p.id == id_projet_batch), None,
            )
            if projet_batch is None:
                reseau_screen.projets_distribues_screen.sur_resultat_envoi(
                    False, "", "ProjetBatch introuvable (a-t-il été supprimé ?).",
                )
                return
            task = self.project.find_task(projet_batch.task_id)
            if task is None:
                reseau_screen.projets_distribues_screen.sur_resultat_envoi(
                    False, "", "Task introuvable pour ce ProjetBatch.",
                )
                return

            dossier_temp = Path(tempfile.gettempdir()) / f"autoniax_envoi_filtre_{uuid.uuid4().hex}"
            try:
                dossier_temp.mkdir(parents=True, exist_ok=False)
                for numero in numeros_sous_projets:
                    source = Path(chemin_racine) / str(numero)
                    if not source.is_dir():
                        # Sous-projet disparu entre le clic et l'envoi (ex.
                        # dossier supprimé manuellement) -- ignoré plutôt
                        # que d'échouer tout l'envoi pour un seul manquant,
                        # même philosophie tolérante que le reste du fichier.
                        continue
                    shutil.copytree(source, dossier_temp / str(numero))
                # Même project.json minimal que l'envoi normal (cf. bloc
                # ci-dessus) -- chemin_racine du ProjetBatch sérialisé ici
                # est encore l'ORIGINAL (jamais lu côté sAutoniax de toute
                # façon : réécrit avec le dossier réellement reçu, cf.
                # _sautoniax_traiter_projet_recu).
                project_minimal = Project(tasks=[task], projets_batch=[projet_batch])
                (dossier_temp / "project.json").write_text(
                    json.dumps(project_minimal.to_dict(), ensure_ascii=False, indent=2), encoding="utf-8",
                )
            except OSError as e:
                shutil.rmtree(dossier_temp, ignore_errors=True)
                reseau_screen.projets_distribues_screen.sur_resultat_envoi(
                    False, "", f"Échec de préparation de l'envoi filtré : {e}",
                )
                return

            session_id = self.client_serveur_t.envoyer_projet_vers_sautoniax(
                id_executant, nom_projet, profils, str(dossier_temp),
            )
            self._dossiers_temp_envoi_filtre[session_id] = str(dossier_temp)
            # id_projet_batch/chemin_racine transmis tels quels (l'ORIGINAL,
            # pas dossier_temp) à sur_envoi_demande : la ligne affichée dans
            # "Projets Distribués" doit rester rattachée au VRAI ProjetBatch
            # local (ex. pour "Récupérer en local", qui ouvre chemin_racine),
            # le dossier temporaire n'est qu'un détail de transport, jamais
            # exposé à l'utilisateur.
            reseau_screen.projets_distribues_screen.sur_envoi_demande(
                id_executant, id_projet_batch, chemin_racine, nom_projet, session_id,
            )

        dashboard_screen.projets_batch_screen.demande_envoi_projet_sautoniax_filtre.connect(
            _sur_demande_envoi_projet_sautoniax_filtre
        )

        def _sur_resultat_envoi_nettoyer_dossier_temp(ok: bool, session_id: str, message: str):
            # Best-effort, jamais bloquant -- connecté EN PLUS du câblage
            # existant vers sur_resultat_envoi (Qt appelle tous les slots
            # connectés à un signal, l'un n'empêche jamais l'autre). Un
            # session_id absent de _dossiers_temp_envoi_filtre (cas normal
            # -- un envoi NON filtré ne passe jamais par ce dict) est
            # simplement ignoré, pop(..., None).
            dossier_temp = self._dossiers_temp_envoi_filtre.pop(session_id, None)
            if dossier_temp:
                shutil.rmtree(dossier_temp, ignore_errors=True)

        self.client_serveur_t.envoi_projet_sautoniax_resultat.connect(_sur_resultat_envoi_nettoyer_dossier_temp)

        self.client_serveur_t.envoi_projet_sautoniax_resultat.connect(
