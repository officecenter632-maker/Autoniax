class ReseauScreen(QWidget):
    """Écran de la section "reseau" de la Sidebar (PATCH -- demande
    explicite utilisateur : "remlacer liconde de sidebare git par licone
    resau, git ne doit etre que on onglet de reseau"). Conteneur
    QTabWidget : "Git" (déploiement du code du serveurT vers
    GitHub/Render), "Instances sAutoniax" (sAutoniax connectés, cf.
    InstancesConnecteesScreen -- PATCH, demande explicite utilisateur :
    "dans les onglet aussi modifie Instance en Instance sAutoniax" --
    libellé d'onglet uniquement, la classe InstancesConnecteesScreen et
    ses attributs/méthodes gardent leur nom historique inchangé),
    "Profils" (§4.3, cf. ProfilsScreen -- sous-onglets "Profils Cloud"
    et "Profils Local"), "Projets Distribués"
    (Patch 4.4.b, cf. ProjetsDistribuesScreen) et "Stockage"
    (identifiants Cloudflare R2, cf. StockageScreen).

    PATCH (demande explicite utilisateur : "enleve les onglet reception
    et notebook distant de resau") -- les onglets "Réception"
    (ReceptionScreen) et "Notebook Distant" (NotebookDistantScreen,
    Patch 4.5) ont été RETIRÉS de cet écran. "Notebook Distant" était de
    toute façon en cours de fusion progressive dans TaskConfigScreen
    (cf. sa docstring et FenetreRenduTaskReseau -- mode Task.mode_
    execution == "reseau", bouton "Initialiser" par profil) : ce retrait
    achève cette transition côté UI top-level, TaskConfigScreen restant
    l'unique point d'entrée pour l'exécution/initialisation de notebook
    à distance. Les classes ReceptionScreen et NotebookDistantScreen
    elles-mêmes ne sont pas supprimées du fichier (juste plus
    instanciées ici) -- cf. inventaire des chantiers restants.

    PATCH (migration Render -> Colab+tunnel Cloudflare) -- deux onglets
    supplémentaires juste après "Code" : "ServeurT Manager" (cf.
    ServeurTManagerScreen) et "sAutoniax Manager" (cf.
    SAutoniaxManagerScreen, qui récupère le bouton de glisser-déposer du
    notebook sAutoniax auparavant dans "Code"). Structure d'onglets
    actuelle : Code | ServeurT Manager | sAutoniax Manager | Instances
    sAutoniax | Profils | Projets Distribués | Batch Traité | Stockage."""

    stockage_modifie = Signal(dict)
    # PATCH A -- relais tel quel (cf. StockageScreen.resultat_confirme).
    resultat_confirme = Signal(bool, str)
    # PATCH D -- même changement que StockageScreen (relais tel quel,
    # cf. sa docstring de signal).
    demande_mise_a_jour_app = Signal(str)
    # CORRECTIF -- demande_pousser_vers_bb SUPPRIMÉ : GitScreen envoie
    # maintenant directement vers Drive (appel _ClientDriveMinimal
    # local, cf. _pousser_vers_drive), plus aucun relais nécessaire
    # jusqu'à MainWindow.
    # PATCH (upload fiabilisé) -- relais tel quel, même patron que
    # demande_mise_a_jour_app juste au-dessus (cf. StockageScreen.
    # demande_reprise_mise_a_jour_app).
    demande_reprise_mise_a_jour_app = Signal()
    demande_liste_stockage = Signal()
    # PATCH (clic-droit "Supprimer" dans Stockage cloud) -- relais tel
    # quel, même patron que demande_liste_stockage juste au-dessus.
    demande_suppression_stockage = Signal(list)
    # PATCH (Patch 4.3 -- onglet Profils Cloud) : ces 3 signaux étaient
    # auparavant relayés via StockageScreen (bloc "Envoyer un profil" de
    # MiseAJourStockageScreen) -- ProfilsCloudScreen étant désormais un
    # onglet top-level au même niveau que Stockage (pas un sous-onglet),
    # ils sont relayés directement ici, sans passer par stockage_screen.
    demande_liste_profils_locaux = Signal()
    demande_envoi_profil = Signal(str)
    demande_telechargement_meta = Signal(str)
    # PATCH (colonne "Badges" cliquable de Profils Cloud, demande
    # explicite utilisateur : "en cloud ça persiste sur le cloud") --
    # même patron de relais direct que demande_telechargement_meta
    # juste au-dessus.
    demande_maj_meta_profil = Signal(str, str, bool)
    # PATCH (boutons "Renommer"/"Supprimer" + colonne "Type" de Profils
    # Cloud, demande explicite utilisateur) -- même patron de relais
    # direct que demande_maj_meta_profil juste au-dessus. La suppression
    # réutilise volontairement un nom DIFFÉRENT de demande_suppression_
    # stockage (déjà pris par StockageCloudScreen/StockageScreen, cf.
    # docstring de ce dernier signal) pour ne pas mélanger les deux
    # résultats -- les deux pointent vers la même méthode générique
    # côté ClientServeurT (demander_suppression_stockage), câblés
    # séparément dans MainWindow.
    demande_renommer_profil_cloud = Signal(str, str)
    demande_suppression_profil_cloud = Signal(list)
    # PATCH (extension "Envoyer vers un sAutoniax" de ProfilsCloudScreen,
    # demande explicite utilisateur) -- même patron de relais direct que
    # les 3 signaux ci-dessus.
    demande_liste_sautoniax_disponibles = Signal()
    demande_envoi_profil_vers_sautoniax = Signal(str, str)  # (id_executant, nom_profil)
    # PATCH (bouton "Télécharger en local" de l'onglet "Transfert de
    # profils", demande explicite utilisateur) -- même patron de relais
    # direct que demande_envoi_profil_vers_sautoniax juste au-dessus.
    demande_telechargement_local_profil = Signal(str)  # nom_profil
    # PATCH (Patch 4.4.b) -- relayé tel quel depuis ProjetsDistribuesScreen
    # (cf. sa docstring) : (session_id, id_projet_batch, chemin_dossier_recu).
    demande_recuperation_locale = Signal(str, str, str)
    # PATCH E.2 -- relayé tel quel depuis BatchTraiteScreen (cf. sa
    # docstring) : (prefixe_b2, chemin_racine_local).
    demande_telechargement_batch_traite = Signal(str, str)
    # PATCH (retrait de l'onglet "Notebook Distant" de cet écran, cf.
    # docstring de la classe) : demande_execution_notebook_distant et
    # demande_initialisation_notebook_distant (ex-relais de
    # NotebookDistantScreen) ont été retirés -- plus aucun émetteur
    # depuis que cet onglet n'existe plus ici. Le mécanisme équivalent
    # vit désormais uniquement dans TaskConfigScreen (ses propres
    # signaux du même nom, cf. sa docstring), câblé indépendamment.

    def __init__(self, reglages: "ReglagesApp", parent=None):
        super().__init__(parent)

        layout = QVBoxLayout(self)
        layout.setContentsMargins(0, 0, 0, 0)
        layout.setSpacing(0)

        self.onglets = QTabWidget(self)
        self.onglets.setObjectName("ReseauOnglets")
        self.git_screen = GitScreen(reglages, self.onglets)
        # CORRECTIF -- plus de relais demande_pousser_vers_bb : GitScreen
        # envoie directement vers Drive en interne (appel
        # _ClientDriveMinimal local).
        # CORRECTIF -- ServeurT Manager et sAutoniax Manager ne sont plus
        # des onglets de PREMIER NIVEAU ici : ils sont désormais des
        # SOUS-onglets de GitScreen lui-même (self.git_screen.sous_
        # onglets, cf. GitScreen.__init__), aux côtés de "serveur.py".
        self.onglets.addTab(self.git_screen, "Code")
        self.instances_screen = InstancesConnecteesScreen(self.onglets)
        self.onglets.addTab(self.instances_screen, "Instances sAutoniax")
        # PATCH (Patch 4.3) : onglet "Profils", inséré juste après
        # "Instances" (cf. spec §4.3/structure cible à 6 onglets).
        # PATCH (demande explicite utilisateur : "je veux que tu renomme
        # Profils Cloud en Profils tout simplement ... je veux que il y
        # ait deux onglets : Profils Cloud et profils local") --
        # ProfilsCloudScreen remplacée par ProfilsScreen (conteneur à
        # deux sous-onglets, cf. sa docstring) -- profils_cloud_screen
        # renommé profils_screen, mais expose exactement les mêmes
        # signaux/méthodes que l'ancien ProfilsCloudScreen (délégation
        # transparente vers profils_screen.cloud_screen), donc AUCUN des
        # câblages ci-dessous n'a besoin de changer au-delà du nom de
        # l'attribut lui-même.
        self.profils_screen = ProfilsScreen(self.onglets)
        self.profils_screen.demande_liste_stockage.connect(self.demande_liste_stockage)
        self.profils_screen.demande_liste_profils_locaux.connect(self.demande_liste_profils_locaux)
        self.profils_screen.demande_envoi_profil.connect(self.demande_envoi_profil)
        self.profils_screen.demande_telechargement_meta.connect(self.demande_telechargement_meta)
        self.profils_screen.demande_maj_meta_profil.connect(self.demande_maj_meta_profil)
        self.profils_screen.demande_renommer_profil_cloud.connect(self.demande_renommer_profil_cloud)
        self.profils_screen.demande_suppression_profil_cloud.connect(self.demande_suppression_profil_cloud)
        self.profils_screen.demande_liste_sautoniax_disponibles.connect(self.demande_liste_sautoniax_disponibles)
        self.profils_screen.demande_envoi_profil_vers_sautoniax.connect(self.demande_envoi_profil_vers_sautoniax)
        self.profils_screen.demande_telechargement_local_profil.connect(self.demande_telechargement_local_profil)
        self.onglets.addTab(self.profils_screen, "Profils")
        # PATCH (Patch 4.4.b) : onglet "Projets Distribués", inséré juste
        # après "Profils" (cf. spec §4/structure cible à 6 onglets :
        # "Git | Instances | Profils | Projets Distribués | Notebook
        # Distant | Stockage").
        self.projets_distribues_screen = ProjetsDistribuesScreen(self.onglets)
        self.projets_distribues_screen.demande_recuperation_locale.connect(self.demande_recuperation_locale)
        # PATCH A -- réutilise le même resultat_confirme générique que
        # StockageScreen (cf. sa déclaration plus haut dans cette
        # classe) : porte déjà (bool, str), pas besoin d'un troisième
        # signal dédié rien que pour ce cas.
        self.projets_distribues_screen.resultat_envoi_confirme.connect(self.resultat_confirme)
        self.onglets.addTab(self.projets_distribues_screen, "Projets Distribués")
        # PATCH E.2 -- onglet "Batch Traité", inséré juste après "Projets
        # Distribués" (fil logique : un batch distribué en cours finit
        # par apparaître ici une fois son exécution terminée, cf.
        # BatchTraiteScreen).
        self.batch_traite_screen = BatchTraiteScreen(self.onglets)
        self.batch_traite_screen.demande_liste_stockage.connect(self.demande_liste_stockage)
        self.batch_traite_screen.demande_telechargement_batch_traite.connect(self.demande_telechargement_batch_traite)
        self.onglets.addTab(self.batch_traite_screen, "Batch Traité")
        self.stockage_screen = StockageScreen(reglages, self.onglets)
        self.stockage_screen.stockage_modifie.connect(self.stockage_modifie)
        self.stockage_screen.resultat_confirme.connect(self.resultat_confirme)
        self.stockage_screen.demande_mise_a_jour_app.connect(self.demande_mise_a_jour_app)
        self.stockage_screen.demande_reprise_mise_a_jour_app.connect(self.demande_reprise_mise_a_jour_app)
        # PATCH -- demande_liste_stockage est émis par DEUX sous-écrans
        # distincts qui en ont chacun besoin (StockageCloudScreen ET,
        # depuis ce patch, ProfilsCloudScreen ci-dessus) : les deux sont
        # connectés au MÊME signal ReseauScreen.demande_liste_stockage,
        # côté MainWindow un seul appel à ClientServeurT.demander_liste_
        # stockage reste nécessaire, son résultat (stockage_liste_
        # resultat) est ensuite distribué aux DEUX écrans (cf. MainWindow).
        self.stockage_screen.demande_liste_stockage.connect(self.demande_liste_stockage)
        self.stockage_screen.demande_suppression_stockage.connect(self.demande_suppression_stockage)
        self.onglets.addTab(self.stockage_screen, "Stockage")
        # PATCH (demande explicite utilisateur : "lorsque je clic sur
        # longlt de sautonix dans la sidebar reseau sa doit
        # automaquement tout actuelaiser ... lorque je clic sur
        # lognlt, automatiquement le sautonix selectionner odit
        # actualiser ses statut") -- jusqu'ici, revenir sur l'onglet
        # "Instances sAutoniax" (ex. après être passé sur "Profils" ou
        # "Stockage" puis revenu) n'actualisait RIEN automatiquement :
        # seul un changement RÉEL de ligne sélectionnée dans la table
        # déclenchait une demande de rafraîchissement (cf.
        # InstancesConnecteesScreen._sur_selection_changee), jamais le
        # simple fait de rendre l'onglet à nouveau visible avec la MÊME
        # sélection qu'avant. self.onglets.currentChanged (émis à
        # chaque changement d'onglet ACTIF, y compris un retour vers un
        # onglet déjà visité) déclenche donc maintenant explicitement
        # InstancesConnecteesScreen.actualiser_selection_courante dès
        # que cet onglet précis redevient actif -- aucun effet sur les
        # autres onglets (Git/Profils/Projets Distribués/Batch/Stockage,
        # gèrent déjà leur propre rafraîchissement via leurs showEvent
        # respectifs, inchangés).
        self.onglets.currentChanged.connect(self._sur_changement_onglet_reseau)
        layout.addWidget(self.onglets)

    def _sur_changement_onglet_reseau(self, index: int):
        if self.onglets.widget(index) is self.instances_screen:
            self.instances_screen.actualiser_selection_courante()


class Sidebar(QWidget):
    """Barre de navigation latérale — icônes mdi6 exclusivement.
    (Le point 18 de la spec en prévoit 4 exactement. Une 5ème section
    "Applications" avait été ajoutée à la demande explicite de l'utilisateur
    — d'abord une icône "Test de composant" fixe, puis généralisée en
    conteneur générique à onglets façon navigateur, cf. ApplicationsScreen —
    mais la fusion de la Phase B a ramené le total à 4 en absorbant l'ancienne
    section séparée "Composants" DANS "API" : ServiceAPIScreen est désormais
    un écran unique à 2 onglets internes (Composants | Features) par
    ServiceAPI, il n'y a donc plus besoin d'une icône de section dédiée.
    Une 5ème section "TaskConfig" a ensuite été ajoutée, juste après "API",
    à la demande explicite de l'utilisateur — placeholder vide pour
    l'instant, cf. PlaceholderScreen dans _build_screens.

    PATCH (demande utilisateur explicite : corbeille -- "tu met licone de
    corbeille en dernier bas de classement") : 6ème section "corbeille",
    positionnée délibérément APRÈS "parametres" (dernière position de la
    liste) plutôt qu'à côté des sections de contenu (Dashboard/TaskConfig/
    API/Applications) -- cf. CorbeilleScreen pour l'écran associé.

    PATCH (demande explicite utilisateur : "remlacer liconde de sidebare
    git par licone resau, git ne doit etre que on onglet de reseau") :
    la section "git" est renommée "reseau" -- l'écran associé
    (ReseauScreen) contient désormais un QTabWidget interne dont "Git"
    n'est que le premier onglet, extensible pour les futurs écrans
    réseau (sAutoniax connectés, tâches distribuées, etc., cf. cahier
    réseau section 6, Étapes 3-9)."""

    SECTIONS = [
        ("dashboard", "mdi6.view-dashboard-outline", "Dashboard"),
        ("taskconfig", "mdi6.clipboard-text-outline", "TaskConfig"),
        ("api", "mdi6.format-list-checks", "API"),
        # 8ème section (cf. Api2Api_ecran_specification.md, section 5) --
        # juste après "api", avant "applications", comme indiqué dans la
        # spec. Icône mdi6.transit-connection-variant : symbolise deux
        # points reliés par une liaison directe, cohérent avec le rôle de
        # l'écran (Task <-> profil, appels API pair-à-pair entre Tasks).
        ("api2api", "mdi6.transit-connection-variant", "Api2Api"),
        ("applications", "mdi6.apps", "Applications"),
        ("reseau", "mdi6.lan", "Réseau"),
        ("parametres", "mdi6.cog-outline", "Paramètres"),
        ("corbeille", "mdi6.trash-can-outline", "Corbeille"),
    ]

    def __init__(self, parent=None):
        super().__init__(parent)
        self.setObjectName("Sidebar")
        self.setFixedWidth(72)

        layout = QVBoxLayout(self)
        layout.setContentsMargins(8, 16, 8, 16)
        layout.setSpacing(8)
        layout.setAlignment(Qt.AlignTop)

        # PATCH (retour utilisateur : "ameliorer nettement son design pour
        # la rendre plus moderne") -- fine ligne de séparation horizontale
        # sous une petite marge, juste avant les icônes de navigation :
        # marque le début de la zone "navigation" sans dupliquer le logo
        # déjà présent dans AutoniaXTitleBar juste au-dessus (redondant
        # sinon), tout en donnant à la sidebar un peu plus de structure
        # que des icônes qui flottent directement en haut du panneau.
        separateur = QFrame(self)
        separateur.setObjectName("SidebarSeparateur")
        separateur.setFixedHeight(1)
        layout.addWidget(separateur)
        layout.addSpacing(8)

        self.button_group = QButtonGroup(self)
        self.button_group.setExclusive(True)
        self.buttons = {}

        for key, icon_name, tooltip in self.SECTIONS:
            # PATCH (même retour utilisateur) : chaque bouton est désormais
            # un petit conteneur (QFrame) avec un indicateur de sélection
            # dédié (bande verticale gauche, cf. #SidebarIndicateur) plutôt
            # qu'un simple changement de fond -- signature visuelle reprise
            # de la bordure gauche accentuée des cartes ServiceAPI (cf.
            # #ServiceAPICarteV2), pour une cohérence de langage visuel
            # entre les deux refontes plutôt que deux idées disjointes.
            item = QFrame(self)
            item.setObjectName("SidebarItem")
            item.setFixedSize(56, 52)
            item_layout = QHBoxLayout(item)
            item_layout.setContentsMargins(0, 0, 0, 0)
            item_layout.setSpacing(0)

            indicateur = QFrame(item)
            indicateur.setObjectName("SidebarIndicateur")
            indicateur.setFixedWidth(3)
            indicateur.setProperty("actif", "false")
            item_layout.addWidget(indicateur)

            btn = QToolButton(item)
            btn.setObjectName("SidebarButton")
            btn.setCheckable(True)
            btn.setToolTip(tooltip)
            btn.setIconSize(QSize(22, 22))
            # CORRECTIF (retour utilisateur : icône en mauve pour la
            # section active) -- color_active seul ne suffit pas : cette
            # clé qtawesome pilote QIcon.Active, un état Qt qui ne dure
            # que pendant l'interaction souris en cours (survol/clic),
            # pas un état persistant. Le bouton reste "checked" une fois
            # l'interaction terminée, mais QIcon.Active retombe alors à
            # QIcon.Normal -- d'où l'icône qui redevenait grise dès que
            # la souris quittait le bouton, malgré la bande latérale
            # restée mauve (elle, pilotée par une propriété QSS distincte
            # via _maj_indicateur, donc pas concernée par ce problème).
            # color_on est la clé qtawesome pilotée par QIcon.On/Off, lui
            # bien réellement synchronisé avec QToolButton.setChecked()
            # (état persistant) -- c'est la bonne clé pour "cette icône
            # reste mauve tant que sa section est active".
            btn.setIcon(qta.icon(
                icon_name,
                color=Mocha.subtext0,
                color_active=Mocha.lavender,
                color_on=Mocha.lavender,
            ))
            btn.setCursor(Qt.PointingHandCursor)
            btn.toggled.connect(lambda checked, ind=indicateur: self._maj_indicateur(ind, checked))
            item_layout.addWidget(btn, stretch=1)

            layout.addWidget(item)
            self.button_group.addButton(btn)
            self.buttons[key] = btn

            # PATCH (demande explicite utilisateur : "meme grapihiquement
            # je veux que le symoblise, par exemple une petite icione
            # vert sur licone de resau pour symboliser que il ya toujour
            # conexions entre le serveurT et linstance, donc un pint gris
            # si ce nes pas connecter, et vert si sa lest, donc un petit
            # cervle sur licone resau de la side bar") -- petite pastille
            # ronde en overlay sur l'icône "reseau" uniquement, positionnée
            # en coin haut-droit du bouton. Enfant direct de `item` (pas
            # de `btn`) pour rester au-dessus visuellement sans interférer
            # avec les états checked/hover du QToolButton lui-même.
            if key == "reseau":
                pastille = QFrame(item)
                pastille.setObjectName("SidebarPastilleStatut")
                pastille.setFixedSize(9, 9)
                pastille.setProperty("connecte", "false")
                pastille.move(38, 4)
                pastille.raise_()
                self._pastille_reseau = pastille

            # PATCH (demande explicite utilisateur : "mettre en indice sur
            # l'icone de la sidebar le nombre de taskapi2api en cours")
            # -- badge numérique en overlay sur l'icône "api2api", même
            # principe de positionnement que #SidebarPastilleStatut
            # ci-dessus (coin haut-droit, enfant direct de `item`) mais un
            # QLabel plutôt qu'un QFrame vide, pour afficher un chiffre.
            # Caché par défaut (pas de "0" qui traînerait visuellement
            # tant qu'aucun Task Api2Api ne tourne) -- cf. Sidebar.
            # definir_nombre_api2api_en_cours, appelée par MainWindow à
            # chaque Api2ApiScreen.nombre_taches_en_cours_change (compte
            # LOCAL à ce client, cf. docstring du signal).
            if key == "api2api":
                badge = QLabel(item)
                badge.setObjectName("SidebarBadgeCompteur")
                badge.setAlignment(Qt.AlignCenter)
                badge.setFixedSize(16, 16)
                badge.move(34, 2)
                badge.raise_()
                badge.hide()
                self._badge_api2api = badge

        layout.addStretch(1)

        # Section par défaut
        self.buttons["dashboard"].setChecked(True)

    @staticmethod
    def _maj_indicateur(indicateur: QFrame, checked: bool):
        indicateur.setProperty("actif", "true" if checked else "false")
        indicateur.style().unpolish(indicateur)
        indicateur.style().polish(indicateur)

    def definir_statut_serveur_t(self, connecte: bool):
        """Met à jour la couleur de la pastille sur l'icône "reseau" --
        vert si ClientServeurT est actuellement connecté au serveurT,
        gris sinon (déconnecté ou en attente de reconnexion). Appelé
        depuis MainWindow, branché sur les signaux connecte/deconnecte
        de ClientServeurT (cf. MainWindow.__init__)."""
        pastille = getattr(self, "_pastille_reseau", None)
        if pastille is None:
            return
        pastille.setProperty("connecte", "true" if connecte else "false")
        pastille.style().unpolish(pastille)
        pastille.style().polish(pastille)

    def definir_nombre_api2api_en_cours(self, nombre: int):
        """Met à jour (et affiche/cache) le badge numérique sur l'icône
        "api2api" -- appelée depuis MainWindow, branchée sur Api2ApiScreen.
        nombre_taches_en_cours_change (cf. sa docstring : compte LOCAL,
        associations démarrées depuis l'écran Api2Api de CE client
        uniquement). Caché quand nombre <= 0 (rien en cours -- évite un
        badge "0" qui traînerait en permanence). Plafonné à l'affichage
        "9+" au-delà de 9 pour ne jamais faire déborder le petit cercle
        de 16px (même esprit que les badges de notification habituels),
        SANS jamais tronquer la valeur réelle transmise par le signal --
        seul l'AFFICHAGE est plafonné ici."""
        badge = getattr(self, "_badge_api2api", None)
        if badge is None:
            return
        if nombre <= 0:
            badge.hide()
            return
        badge.setText("9+" if nombre > 9 else str(nombre))
        badge.show()



