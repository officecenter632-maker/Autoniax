          try { promesseNative = natifWrite(donnees); } catch (e) { promesseNative = null; }
        }
        var promesseVirtuelle = ecritureVirtuelle.call(navigator.clipboard, donnees);
        return promesseNative || promesseVirtuelle;
      };
    }
  } catch (e) { /* rien */ }

  // 3) Événement DOM "copy" -- déclenché par document.execCommand('copy')
  // (ancienne API, encore largement utilisée) ET par un vrai Ctrl+C.
  // capture=true : intercepté avant tout gestionnaire posé par la page
  // elle-même, preventDefault() empêche Chrome d'écrire dans le
  // presse-papier système après nous.
  // CORRECTIF Ctrl+C humain : un vrai Ctrl+C (ou Ctrl+X / Ctrl+Insert / Cmd+C)
  // doit continuer d'écrire dans le presse-papier WINDOWS. On repère le
  // raccourci clavier réel (keydown de confiance) et on mémorise son
  // horodatage ; l'événement "copy" qui suit dans la seconde n'est alors
  // PAS bloqué (pas de preventDefault) -- il reste copié AUSSI dans le
  // presse-papier virtuel. Les copies déclenchées par la page (bouton
  // "Copier" -> execCommand/writeText) n'ont pas de keydown préalable :
  // elles restent isolées comme avant.
  // PATCH copie (Firefox/Camoufox) : window.getSelection().toString() renvoie
  // "" quand le texte est sélectionné DANS un <input>/<textarea> (comportement
  // Firefox, contrairement à Chrome) -> la copie partait avec un texte vide
  // ("Rien à copier"). On lit donc d'abord la sélection de l'élément actif.
  window.__autoniax_texte_selection__ = function () {
    try {
      var el = document.activeElement;
      if (el && (el.tagName === "TEXTAREA" || (el.tagName === "INPUT" && typeof el.selectionStart === "number"))
          && el.selectionStart !== el.selectionEnd) {
        return String(el.value).substring(el.selectionStart, el.selectionEnd);
      }
    } catch (e) { /* rien */ }
    try { return String(window.getSelection().toString()); } catch (e) { return ""; }
  };
  window.__autoniax_dernier_raccourci_copie__ = 0;
  document.addEventListener("keydown", function (e) {
    try {
      if (!e.isTrusted) { return; }
      var k = String(e.key || "").toLowerCase();
      if ((e.ctrlKey || e.metaKey) && (k === "c" || k === "x" || k === "insert")) {
        window.__autoniax_dernier_raccourci_copie__ = Date.now();
      }
    } catch (err) { /* rien */ }
  }, true);

  document.addEventListener("copy", function (evenement) {
    if (window.__autoniax_secours_copie__) { return; }
    var texte = window.__autoniax_texte_selection__();
    var raccourciHumain = (Date.now() - (window.__autoniax_dernier_raccourci_copie__ || 0)) < 1000;
    // PATCH (clic HUMAIN sur un bouton "Copier") : un execCommand('copy')
    // déclenché par un vrai clic humain n'est pas bloqué non plus.
    if (!raccourciHumain && !copieHumaine()) { evenement.preventDefault(); }
    envoyerAuPressePapierVirtuel(texte, idDeLElement(evenement.target));
  }, true);
})();
"""


def _ecrire_presse_papier_windows(texte: str) -> bool:
    """Écrit `texte` DIRECTEMENT dans le presse-papier Windows (CF_UNICODETEXT)
    via l'API Win32 -- garantit qu'une copie HUMAINE faite dans CloakBrowser
    arrive dans Windows même si clipboard.writeText natif est refusé."""
    if sys.platform != "win32" or not texte:
        return False
    try:
        from ctypes import wintypes
        k32 = ctypes.WinDLL("kernel32", use_last_error=True)
        u32 = ctypes.WinDLL("user32", use_last_error=True)
        k32.GlobalAlloc.argtypes = [wintypes.UINT, ctypes.c_size_t]
        k32.GlobalAlloc.restype = wintypes.HGLOBAL
        k32.GlobalLock.argtypes = [wintypes.HGLOBAL]
        k32.GlobalLock.restype = ctypes.c_void_p
        k32.GlobalUnlock.argtypes = [wintypes.HGLOBAL]
        k32.GlobalFree.argtypes = [wintypes.HGLOBAL]
        u32.OpenClipboard.argtypes = [wintypes.HWND]
        u32.OpenClipboard.restype = wintypes.BOOL
        u32.EmptyClipboard.restype = wintypes.BOOL
        u32.SetClipboardData.argtypes = [wintypes.UINT, wintypes.HANDLE]
        u32.SetClipboardData.restype = wintypes.HANDLE
        u32.CloseClipboard.restype = wintypes.BOOL
        donnees = (texte + "\0").encode("utf-16-le")
        ouvert = False
        for _ in range(20):
            if u32.OpenClipboard(None):
                ouvert = True
                break
            time.sleep(0.05)
        if not ouvert:
            log.warning("[presse-papier] OpenClipboard impossible (presse-papier verrouillé par un autre programme)")
            return False
        try:
            u32.EmptyClipboard()
            h = k32.GlobalAlloc(0x0002, len(donnees))
            if not h:
                return False
            ptr = k32.GlobalLock(h)
            if not ptr:
                k32.GlobalFree(h)
                return False
            ctypes.memmove(ptr, donnees, len(donnees))
            k32.GlobalUnlock(h)
            if not u32.SetClipboardData(13, h):
                k32.GlobalFree(h)
                return False
            return True
        finally:
            u32.CloseClipboard()
    except Exception as e:
        log.warning(f"[presse-papier] écriture Windows directe échouée : {e!r}")
        return False


async def _installer_interception_presse_papier(page, etat_navigateur: dict):
    """Installe, sur `page` (un onglet précis), le binding CDP + le script
    d'interception ci-dessus -- rend cet onglet capable de rediriger toute
    copie native (bouton de la page ou Ctrl+C) vers
    etat_navigateur["presse_papier_virtuel"] au lieu du presse-papier
    Windows. À appeler UNE FOIS PAR ONGLET (le premier onglet de
    l'instance dans demarrer_navigateur, PUIS chaque onglet créé en cours
    de route -- cf. action_new_tab, qui appelle cette fonction sur le
    nouvel onglet avant de le retourner) : Page.addScriptToEvaluateOnNewDocument
    et Runtime.addBinding sont tous deux posés PAR SESSION CDP (donc par
    onglet), jamais globalement pour toute l'instance.

    Idempotent : add_script_to_evaluate_on_new_document peut être appelé
    plusieurs fois sans effet de bord (chaque appel ajoute son propre
    script, mais le garde __autoniax_presse_papier_installe__ dans le JS
    ci-dessus empêche toute double-installation des écouteurs si jamais
    cette fonction était rappelée par erreur sur le même onglet).

    PATCH (retour utilisateur explicite -- id DOM en propriété du
    composant, cf. Composant.id_dom) : en plus de etat_navigateur[
    "presse_papier_virtuel"] (filet de sécurité global, comportement
    historique 100% inchangé), etat_navigateur["presse_papier_virtuel_par_id"]
    accumule la DERNIÈRE copie propre à chaque id d'élément déclencheur
    rencontré -- {id_dom: {"texte": ..., "ts": ...}} depuis le PATCH
    robustesse (horodatage monotone obligatoire pour la vérification de
    fraîcheur, cf. _memoriser_copie_presse_papier), cf. _executer_commande qui y pioche
    quand id_dom_presse_papier est fourni dans les params (même mécanique
    que côté Camoufox, cf. camoufox_installer_interception_presse_papier).
    Jamais vidé/réinitialisé automatiquement : une entrée absente signifie
    simplement "cet id n'a encore jamais déclenché de copie observée sur
    cet onglet"."""
    def _sur_binding_appele(event, *_):
        # event : cdp.runtime.BindingCalled -- name/payload/execution_context_id.
        # Filtré par nom pour ignorer un binding sans rapport si jamais
        # d'autres bindings sont ajoutés ailleurs un jour dans ce fichier.
        if getattr(event, "name", None) != "__autoniax_copie__":
            return
        # PATCH (retour utilisateur explicite -- id DOM en propriété du
        # composant, cf. Composant.id_dom) : le binding CDP n'accepte qu'un
        # seul argument string (contrairement à expose_function côté
        # Camoufox), donc _JS_INTERCEPTION_PRESSE_PAPIER encode
        # {texte, id} en JSON -- on décode ici. Repli sur payload brut tel
        # quel si le JSON est invalide (ancien script encore en cache /
        # document déjà chargé avant la mise à jour) : comportement
        # historique 100% conservé dans ce cas, juste sans ciblage par id.
        try:
            charge = json.loads(event.payload)
            texte = str(charge.get("texte", ""))
            id_declencheur = str(charge.get("id", ""))
            copie_humaine = bool(charge.get("humain", False))
        except (ValueError, TypeError, AttributeError):
            texte = str(event.payload)
            id_declencheur = ""
            copie_humaine = False
        if texte:  # TOUTE copie est aussi écrite dans le presse-papier Windows
            threading.Thread(target=_ecrire_presse_papier_windows, args=(texte,), daemon=True).start()
        # PATCH (robustesse capture de copie) : passage par le point
        # d'écriture unique _memoriser_copie_presse_papier, qui horodate
        # (time.monotonic) global ET entrée par id -- indispensable pour
        # que le polling de fraîcheur côté click(copier_presse_papier=True)
        # puisse distinguer CETTE copie d'une copie antérieure sur le même
        # id. Cf. sa docstring pour le détail du format de stockage.
        _memoriser_copie_presse_papier(etat_navigateur, texte, id_declencheur)
        log.info(
            f"[presse-papier virtuel] copie interceptée depuis la page "
            f"(longueur={len(texte)}), redirigée hors du presse-papier système."
            + (f" (id={id_declencheur!r})" if id_declencheur else "")
        )

    try:
        await page.send(cdp.runtime.add_binding(name="__autoniax_copie__"))
        page.add_handler(cdp.runtime.BindingCalled, _sur_binding_appele)
        await page.send(cdp.page.add_script_to_evaluate_on_new_document(
            source=_JS_INTERCEPTION_PRESSE_PAPIER,
        ))
        # Le script ci-dessus ne s'applique qu'aux PROCHAINS chargements de
        # document (addScriptToEvaluateOnNewDocument) -- si `page` a déjà
        # fini de charger AVANT cet appel (cas du tout premier onglet,
        # cf. demarrer_navigateur), on l'injecte aussi immédiatement dans
        # le document courant pour ne pas rater ce premier chargement.
        await page.send(cdp.runtime.evaluate(_JS_INTERCEPTION_PRESSE_PAPIER))
    except Exception as e:
        log.warning(f"Installation de l'interception presse-papier échouée (copie native non isolée pour cet onglet) : {e!r}")


async def action_copy(page) -> str:
    """copy() -- copie la sélection courante de la page vers le
    PRESSE-PAPIER VIRTUEL de cette instance (stocké en mémoire dans
    etat_navigateur["presse_papier_virtuel"], cf. _executer_commande),
    PAS le presse-papier Windows (demande explicite utilisateur : chaque
    instance doit avoir son propre presse-papier, isolé des autres
    instances ET du système -- plusieurs instances tournant en parallèle
    ne doivent plus jamais se marcher dessus sur un presse-papier
    partagé). Lit la sélection texte actuelle via window.getSelection()
    (JS pur, aucun événement presse-papier système déclenché -- ni
    execCommand('copy') ni navigator.clipboard, contrairement à l'ancienne
    version). Retourne le texte copié (chaîne vide si rien n'était
    sélectionné) -- le stockage dans etat_navigateur est fait par
    l'appelant (_executer_commande), cette fonction reste pure (lecture
    JS + retour), cohérent avec action_get_clipboard juste en dessous."""
    resultat, exception_details = await page.send(cdp.runtime.evaluate(
        "window.getSelection().toString()", return_by_value=True,
    ))
    if exception_details is not None:
        log.warning(f"copy : lecture de la sélection échouée : {exception_details}")
        return ""
    valeur = resultat.value if resultat is not None else None
    return valeur if isinstance(valeur, str) else ""


def action_get_clipboard(etat_navigateur: dict) -> str:
    """get_clipboard() -- lit le contenu ACTUEL du PRESSE-PAPIER VIRTUEL de
    cette instance (etat_navigateur["presse_papier_virtuel"], rempli par
    action_copy ou par la valeur donnée à la dernière action_paste), PAS
    le presse-papier Windows (demande explicite utilisateur : isolation
    par instance -- cf. docstring action_copy pour le contexte complet).
    Ne déclenche aucun appel CDP -- simple lecture en mémoire, donc
    fonction synchrone (plus besoin d'await, contrairement à l'ancienne
    version qui lisait navigator.clipboard.readText() côté page). Chaîne
    vide si rien n'a encore été copié dans cette instance."""
    valeur = etat_navigateur.get("presse_papier_virtuel", "")
    return valeur if isinstance(valeur, str) else ""


async def action_list_tabs(browser, page_active) -> list[dict]:
    """listTabs() -- liste des onglets ouverts du profil (id, titre, url,
    actif), via browser.tabs (liste d'objets Tab déjà filtrée par nodriver
    sur les targets de type 'page' -- exclut nativement les workers/
    extensions/iframes qui apparaissent, eux, dans get_targets()).

    BUG CORRIGÉ (listTabs échouait systématiquement en pratique, cf. log
    utilisateur : "command_result ok=False error=\"'NoneType' object has
    no attribute 'send'\"") -- cette fonction appelait auparavant
    `browser.connection.send(cdp.target.get_targets())`, un appel CDP BAS
    NIVEAU sur browser.connection. Or browser.connection peut valoir None
    à ce stade (aucune garantie de nodriver que cet attribut soit peuplé
    au moment où une commande listTabs arrive -- confirmé par un bug
    identique et documenté côté lib elle-même, cf. update_targets() qui
    peut lever exactement la même AttributeError). action_switch_tab
    (juste en dessous) n'avait PAS ce problème : sa docstring explique
    déjà pourquoi elle utilise browser.tabs (API haut niveau de nodriver)
    plutôt que browser.connection -- listTabs suit maintenant exactement
    le même principe, pour la même raison, au lieu des deux fonctions
    ayant chacune leur propre façon (fiable vs non fiable) d'atteindre la
    même information.

    Le champ CDP `attached` (utilisé dans un premier jet) ne convient PAS
    pour 'actif' : il signifie "une session DevTools est attachée à ce
    target", pas "cet onglet est visuellement au premier plan" (confirmé
    par la définition de TargetInfo dans la lib installée -- attached
    reste souvent vrai simultanément sur plusieurs onglets que nodriver
    suit). CDP n'expose pas de champ natif pour l'onglet visuellement
    actif ; on le déduit donc en comparant chaque target_id à celui de
    `page_active` (etat_navigateur["page"], mis à jour par switchTab).

    CORRECTIF (tabId périmés renvoyés à l'UI -- switchTab échouait ensuite
    avec 'No target with given id found') : browser.tabs reflète
    browser._targets, qui n'est PAS rafraîchi en continu -- seulement via
    les événements CDP TargetCreated/TargetDestroyed (peu fiables en
    timing sur Vivaldi, cf. commentaire sur update_targets() plus haut
    dans ce fichier, section lancement du navigateur) ou via un appel
    explicite à update_targets(). Un onglet fermé côté navigateur restait
    donc visible dans listTabs tant qu'aucun de ces deux événements
    n'était encore arrivé. On force donc le rafraîchissement ici, juste
    avant de lire browser.tabs, exactement comme déjà fait par ailleurs
    au démarrage du navigateur."""
    await browser.update_targets()
    id_actif = str(page_active.target.target_id) if page_active is not None else None
    onglets = []
    for onglet in browser.tabs:
        if onglet.target is None or onglet.target.type_ != "page":
            continue
        onglets.append({
            "id": str(onglet.target.target_id),
            "titre": onglet.target.title,
            "url": onglet.target.url,
            "actif": str(onglet.target.target_id) == id_actif,
        })
    return onglets


async def action_switch_tab(browser, tab_id: str):
    """switchTab(tabId) -- bascule l'onglet actif du profil vers le
    target précis identifié par tab_id (cf. 4.5 : décision prise en amont,
    côté programme de pilotage, à partir de listTabs() ; ici on ne fait
    qu'exécuter le switch demandé).

    Passe par l'objet Tab natif de nodriver (browser.tabs) plutôt que par
    un appel CDP brut sur browser.connection, pour pouvoir renvoyer
    directement un objet Tab utilisable pour les commandes suivantes
    (page.send(...)), qu'on peut affecter à etat_navigateur["page"] côté
    appelant -- cf. 4.6, toute action ultérieure (hors switchTab) doit
    cibler l'onglet désormais actif, y compris le streaming de capture().

    RÉINTRODUIT (demande utilisateur -- switchTab doit rendre l'onglet
    visuellement actif dans le tab-strip du navigateur, pas juste changer
    la cible CDP interne) : Target.activateTarget, envoyé ici via
    browser.send(cdp.target.activate_target(...)) sur le target_id de
    l'onglet trouvé.

    HISTORIQUE -- pourquoi ça avait été retiré une première fois : sur
    Vivaldi, Tab.activate()/Target.activateTarget pouvait faire remonter
    la fenêtre du navigateur au premier plan sur le bureau (vol de
    focus), cf. l'ancien commentaire ci-dessus dans ce fichier et le bug
    Vivaldi documenté dans action_new_tab (onglets d'arrière-plan qui ne
    rendent jamais). AutoniaX cible maintenant Chrome par défaut (cf.
    PATCH dans action_new_tab, CONFIG_INSTANCE_PAR_DEFAUT) -- le bug
    Vivaldi ne s'applique pas.

    VÉRIFIÉ EN USAGE RÉEL SUR CHROME (retour utilisateur, log
    _executer_commande action='switchTab' ok=True à l'appui) : aucun vol
    de focus fenêtre observé -- l'onglet devient bien visuellement actif
    dans le tab-strip de Chrome sans faire remonter la fenêtre au premier
    plan du bureau. Le point de vigilance qui restait ouvert après la
    réintroduction de cet appel est donc levé pour Chrome. Si un vol de
    focus apparaissait malgré tout dans un contexte différent (autre
    version de Chrome, autre OS), retirer l'appel activate_target
    ci-dessous et revenir à l'ancien comportement (onglet retourné sans
    être activé côté navigateur) -- cf. historique de cette docstring
    pour le detail complet du choix initial et de sa réintroduction.

    Si l'appel activate_target échoue (ex. target déjà fermé entre temps),
    on ne fait pas échouer tout switchTab pour autant : le switch de
    cible CDP (ce que retourne cette fonction) reste la partie
    essentielle pour les commandes suivantes (capture, etc.) -- l'échec
    de l'activation visuelle est juste loggé."""
    for onglet in browser.tabs:
        if str(onglet.target.target_id) == str(tab_id):
            try:
                await browser.send(cdp.target.activate_target(onglet.target.target_id))
            except Exception as e:
                log.warning(f"action_switch_tab({tab_id!r}) : activate_target a échoué (switch CDP interne conservé malgré tout) -- {e!r}")
            if _PROCESSUS_FEATHER:
                # PATCH Feather : activate_target ne change rien a l'ecran dans Feather ; on prévient donc
                # Feather depuis la page elle-meme (message lu par OngletsFeather._message, action "activate").
                try:
                    await asyncio.wait_for(
                        onglet.send(cdp.runtime.evaluate(
                            "try{window.chrome.webview.postMessage(['feather_tab',JSON.stringify('activate'),'0'])}catch(e){}; 0",
                            return_by_value=True)),
                        timeout=3.0,
                    )
                except Exception as e:
                    log.warning(f"action_switch_tab({tab_id!r}) : Feather n'a pas pu etre prevenu ({e!r})")
            return onglet
    raise ValueError(f"onglet introuvable pour tab_id={tab_id!r}")


# ---------------------------------------------------------------------------
# PATCH (retour utilisateur : « ça ne remonte pas, mais la barre des tâches
# clignote ») -- bringToFront() ne faisait que Target.activateTarget (CDP) :
# ça active l'onglet DANS le navigateur, mais Windows interdit à un process
# qui n'a pas le focus de voler le premier plan (« foreground lock ») : la
# fenêtre ne remonte pas, son bouton clignote dans la barre des tâches.
# On retrouve donc la vraie fenêtre du navigateur de CETTE instance (par PID :
# le process de l'instance + tous ses descendants, sinon par titre de page)
# et on la force au premier plan avec les techniques Win32 usuelles, de la
# moins intrusive à la plus intrusive, en s'arrêtant dès que ça a marché :
#   1) SetForegroundWindow ; 2) AttachThreadInput sur le thread de la fenêtre
#   au premier plan ; 3) tapotement de la touche Alt (même astuce que
#   _forcer_premier_plan_windows) ; 4) en dernier recours, passage TOPMOST puis
#   retour à la normale (visible au-dessus de tout, mais sans le focus).
# Fonction AUTONOME (rien d'autre du fichier requis) et DLL ctypes PRIVÉES
# (WinDLL) : on ne touche pas aux argtypes partagés de ctypes.windll.
# Appelée aussi par un clic droit « voir ce profil » et par
# Instance.bring_to_front() d'un script de Task (même commande réseau).
# ---------------------------------------------------------------------------
PREMIER_PLAN_PREND_LE_FOCUS = True   # False = la fenêtre passe AU-DESSUS des autres SANS prendre le focus clavier


def _forcer_fenetre_navigateur_premier_plan(pids_racines, titre_page="", classes=None, prend_le_focus=True) -> str:
    """Remonte la fenêtre du navigateur au premier plan (Windows). Retourne une
    ligne de diagnostic ('' hors Windows). Ne lève jamais."""
    if sys.platform != "win32":
        return ""
    try:
        import time as _t
        from ctypes import wintypes
        user32 = ctypes.WinDLL("user32", use_last_error=True)
        kernel32 = ctypes.WinDLL("kernel32", use_last_error=True)
        HWND, DWORD, BOOL, UINT, LPARAM = wintypes.HWND, wintypes.DWORD, wintypes.BOOL, wintypes.UINT, wintypes.LPARAM

        def _sig(fn, args, res):
            fn.argtypes, fn.restype = args, res

        class _RECT(ctypes.Structure):
            _fields_ = [("left", ctypes.c_long), ("top", ctypes.c_long), ("right", ctypes.c_long), ("bottom", ctypes.c_long)]

        class _PE32(ctypes.Structure):
            _fields_ = [("dwSize", DWORD), ("cntUsage", DWORD), ("th32ProcessID", DWORD),
                        ("th32DefaultHeapID", ctypes.c_size_t), ("th32ModuleID", DWORD), ("cntThreads", DWORD),
                        ("th32ParentProcessID", DWORD), ("pcPriClassBase", ctypes.c_long), ("dwFlags", DWORD),
                        ("szExeFile", ctypes.c_wchar * 260)]

        enum_proc = ctypes.WINFUNCTYPE(BOOL, HWND, LPARAM)
        _sig(user32.EnumWindows, [enum_proc, LPARAM], BOOL)
        _sig(user32.IsWindowVisible, [HWND], BOOL)
        _sig(user32.IsIconic, [HWND], BOOL)
        _sig(user32.GetWindow, [HWND, UINT], HWND)
        _sig(user32.GetWindowTextLengthW, [HWND], ctypes.c_int)
        _sig(user32.GetWindowTextW, [HWND, wintypes.LPWSTR, ctypes.c_int], ctypes.c_int)
        _sig(user32.GetClassNameW, [HWND, wintypes.LPWSTR, ctypes.c_int], ctypes.c_int)
        _sig(user32.GetWindowThreadProcessId, [HWND, ctypes.POINTER(DWORD)], DWORD)
        _sig(user32.GetWindowLongW, [HWND, ctypes.c_int], ctypes.c_long)
        _sig(user32.GetWindowRect, [HWND, ctypes.POINTER(_RECT)], BOOL)
        _sig(user32.ShowWindow, [HWND, ctypes.c_int], BOOL)
        _sig(user32.SetForegroundWindow, [HWND], BOOL)
        _sig(user32.BringWindowToTop, [HWND], BOOL)
        _sig(user32.GetForegroundWindow, [], HWND)
        _sig(user32.AttachThreadInput, [DWORD, DWORD, BOOL], BOOL)
        _sig(user32.SetWindowPos, [HWND, HWND, ctypes.c_int, ctypes.c_int, ctypes.c_int, ctypes.c_int, UINT], BOOL)
        _sig(user32.keybd_event, [wintypes.BYTE, wintypes.BYTE, DWORD, ctypes.c_size_t], None)
        _sig(kernel32.GetCurrentThreadId, [], DWORD)
        _sig(kernel32.CreateToolhelp32Snapshot, [DWORD, DWORD], ctypes.c_void_p)
        _sig(kernel32.Process32FirstW, [ctypes.c_void_p, ctypes.POINTER(_PE32)], BOOL)
        _sig(kernel32.Process32NextW, [ctypes.c_void_p, ctypes.POINTER(_PE32)], BOOL)
        _sig(kernel32.CloseHandle, [ctypes.c_void_p], BOOL)

        # 1) PID de l'instance + tous ses descendants (le navigateur en fait partie)
        pids = {int(x) for x in (pids_racines or ()) if x}
        snap = kernel32.CreateToolhelp32Snapshot(0x2, 0)
        if snap is not None and snap != ctypes.c_void_p(-1).value:
            try:
                enfants = {}
                pe = _PE32()
                pe.dwSize = ctypes.sizeof(_PE32)
                ok = kernel32.Process32FirstW(snap, ctypes.byref(pe))
                while ok:
                    enfants.setdefault(int(pe.th32ParentProcessID), []).append(int(pe.th32ProcessID))
                    ok = kernel32.Process32NextW(snap, ctypes.byref(pe))
            finally:
                kernel32.CloseHandle(snap)
            pile = list(pids)
            while pile:
                for enfant in enfants.get(pile.pop(), []):
                    if enfant not in pids:
                        pids.add(enfant)
                        pile.append(enfant)

        # 2) fenêtres de premier niveau visibles, sans propriétaire, avec un titre
        titre_min = (titre_page or "").strip().lower()
        par_pid, par_titre = [], []

        def _cb(hwnd, _lp):
            try:
                if not user32.IsWindowVisible(hwnd) or user32.GetWindow(hwnd, 4):    # GW_OWNER
                    return True
                if user32.GetWindowLongW(hwnd, -20) & 0x80:                           # WS_EX_TOOLWINDOW
                    return True
                n = user32.GetWindowTextLengthW(hwnd)
                if n <= 0:
                    return True
                titre = ctypes.create_unicode_buffer(n + 1)
                user32.GetWindowTextW(hwnd, titre, n + 1)
                classe = ctypes.create_unicode_buffer(256)
                user32.GetClassNameW(hwnd, classe, 256)
                r = _RECT()
                user32.GetWindowRect(hwnd, ctypes.byref(r))
                aire = max(0, r.right - r.left) * max(0, r.bottom - r.top)
                pid = DWORD(0)
                user32.GetWindowThreadProcessId(hwnd, ctypes.byref(pid))
                info = (aire, hwnd, classe.value, titre.value)
                if int(pid.value) in pids and (not classes or classe.value in classes):
                    par_pid.append(info)
                elif len(titre_min) >= 3 and titre_min in titre.value.lower():
                    par_titre.append(info)
            except Exception:
                pass
            return True

        cb = enum_proc(_cb)
        user32.EnumWindows(cb, 0)
        if par_pid:
            via, (aire, hwnd, classe, titre) = "pid", max(par_pid, key=lambda x: x[0])
        elif par_titre:
            via, (aire, hwnd, classe, titre) = "titre", max(par_titre, key=lambda x: x[0])
        else:
            return "aucune fenetre trouvee (pids=%d, titre=%r)" % (len(pids), titre_page)
        diag = "fenetre %s classe=%s via=%s" % (hex(hwnd or 0), classe, via)

        # 3) remontée
        if user32.IsIconic(hwnd):
            user32.ShowWindow(hwnd, 9)                                               # SW_RESTORE

        def _devant():
            return user32.GetForegroundWindow() == hwnd

        def _topmost_flash():
            flags = 0x0001 | 0x0002 | 0x0010 | 0x0040                                # NOSIZE | NOMOVE | NOACTIVATE | SHOWWINDOW
            user32.SetWindowPos(hwnd, -1, 0, 0, 0, 0, flags)                         # HWND_TOPMOST
            user32.SetWindowPos(hwnd, -2, 0, 0, 0, 0, flags & ~0x0040)               # HWND_NOTOPMOST

        if not prend_le_focus:
            _topmost_flash()
            return diag + " | au-dessus sans focus"
        user32.SetForegroundWindow(hwnd)
        methode = "SetForegroundWindow"
        if not _devant():
            methode = "AttachThreadInput"
            fg = user32.GetForegroundWindow()
            t_fg = user32.GetWindowThreadProcessId(fg, None) if fg else 0
            t_moi = kernel32.GetCurrentThreadId()
            if t_fg and t_fg != t_moi:
                user32.AttachThreadInput(t_moi, t_fg, True)
                try:
                    user32.BringWindowToTop(hwnd)
                    user32.SetForegroundWindow(hwnd)
                finally:
                    user32.AttachThreadInput(t_moi, t_fg, False)
            _t.sleep(0.03)
        if not _devant():
            methode = "Alt"
            user32.keybd_event(0x12, 0, 0, 0)                                        # VK_MENU
            user32.keybd_event(0x12, 0, 0x0002, 0)                                   # KEYEVENTF_KEYUP
            user32.SetForegroundWindow(hwnd)
            _t.sleep(0.03)
        user32.BringWindowToTop(hwnd)
        if not _devant():
            methode = "topmost"
            _topmost_flash()
        return diag + " | methode=%s premier_plan=%s" % (methode, _devant())
    except Exception as exc:
        return "erreur : %r" % (exc,)


async def action_bring_to_front(browser, page_active) -> None:
    """bringToFront() -- AJOUT (demande explicite utilisateur : "je veux
    que quand on fait un clic droit sur un profils clone dans le panneau
    de clone... sa affiche sont navigatuer au premier plan", ponctuel --
    "pas au premier plan de facon permanent") : remonte la fenêtre du
    navigateur de CETTE instance au premier plan du bureau, SANS changer
    l'onglet visuellement actif (contrairement à switchTab ci-dessus, qui
    change aussi la cible CDP interne -- ici page_active reste l'onglet
    actif avant ET après l'appel, seul le focus fenêtre change).

    Réutilise le même mécanisme CDP que switchTab (Target.activateTarget,
    cf. sa docstring pour l'historique complet du choix -- vérifié en
    usage réel sur Chrome sans effet de bord), appliqué ici à l'onglet
    DÉJÀ actif (page_active) plutôt qu'à un onglet cible différent --
    c'est justement ce vol de focus, jugé acceptable pour switchTab, qui
    est le comportement RECHERCHÉ ici (l'utilisateur clique explicitement
    pour voir ce profil, une seule fois, pas pour y rester en permanence
    -- rien dans cette fonction ne modifie l'état de la fenêtre au-delà
    de cet instant : aucun "toujours au premier plan", aucun changement
    de taille/position, un simple focus ponctuel comme un clic sur la
    barre des tâches).

    Lève ValueError si page_active est None (aucune page active connue
    pour cette instance, cf. etat_navigateur["page"] -- ne devrait pas
    arriver en usage normal, une instance liée a toujours une page)."""
    if page_active is None:
        raise ValueError("aucune page active connue pour cette instance -- impossible de la mettre au premier plan")
    await browser.send(cdp.target.activate_target(page_active.target.target_id))
    # PATCH (« ça ne remonte pas, la barre des tâches clignote ») -- cf. bloc
    # _forcer_fenetre_navigateur_premier_plan : activer l'onglet ne suffit pas
    # sous Windows, on force aussi la fenêtre native au premier plan.
    if sys.platform == "win32":
        try:
            titre = str(getattr(getattr(page_active, "target", None), "title", "") or "")
            racines = {os.getpid(), int(getattr(browser, "_process_pid", 0) or 0)}
            await asyncio.sleep(0.1)
            diag = await asyncio.get_running_loop().run_in_executor(
                None, lambda: _forcer_fenetre_navigateur_premier_plan(
                    racines, titre, {"Chrome_WidgetWin_1"}, PREMIER_PLAN_PREND_LE_FOCUS))
            log.info(f"[bringToFront] {diag}")
        except Exception as exc:
            log.warning(f"[bringToFront] forçage Windows impossible : {exc!r}")


def _ro_remplacements_actifs(etat_navigateur) -> bool:
    """Vrai si des règles de remplacement de ressources sont définies pour cette instance."""
    return bool(etat_navigateur and etat_navigateur.get("remplacements"))


async def _feather_ouvrir_onglet_window_open(browser, etat_navigateur, delai_s: float = 6.0):
    """PATCH Feather -- ouvre un onglet via window.open() (et non Target.createTarget).

    Target.createTarget (CDP) crée une fenêtre WebView2 séparée sans passer par
    l'événement NewWindowRequested : Feather ne peut pas l'intercepter, d'où deux
    fenêtres. window.open() déclenche NewWindowRequested, que featherBrowser.pyw
    transforme en vrai onglet dans la MÊME fenêtre. On détecte le nouveau target
    par différence avant/après. Renvoie son target_id, ou None (-> repli createTarget)."""
    try:
        await browser.update_targets()
        avant = {str(t.target.target_id) for t in browser.targets}
        source = (etat_navigateur or {}).get("page")
        if source is None:
            source = next((t for t in browser.tabs if t.target is not None and t.target.type_ == "page"), None)
        if source is None:
            return None
        await asyncio.wait_for(
            source.send(cdp.runtime.evaluate("window.open('about:blank','_blank','noopener'); 0",
                                             user_gesture=True, return_by_value=True)),
            timeout=5.0,
        )
        boucle = asyncio.get_event_loop()
        debut = boucle.time()
        while boucle.time() - debut < delai_s:
            await browser.update_targets()
            for t in browser.targets:
                if t.target.type_ == "page" and str(t.target.target_id) not in avant:
                    return t.target.target_id
            await asyncio.sleep(0.1)
        log.warning("Feather : window.open() n'a créé aucun nouvel onglet dans le délai -- repli sur createTarget.")
    except Exception as e:
        log.warning(f"Feather : ouverture d'onglet par window.open() impossible ({e!r}) -- repli sur createTarget.")
    return None


async def action_new_tab(browser, url: str, timeout_attente_page_s: float = DELAI_ATTENTE_CHARGEMENT_PAGE_DEFAUT_S,
                          bloquer_media: bool = False, etat_navigateur: Optional[dict] = None):
    """newTab(url) -- ouvre un nouvel onglet sur le profil, navigue vers
    url, et le retourne (devient l'onglet actif côté appelant, cf.
    _executer_commande qui écrit etat_navigateur["page"] = résultat,
    même principe que switchTab).

    ============================================================
    BUG CONNU -- ONGLET CRÉÉ EN ARRIÈRE-PLAN SUR VIVALDI (fix confirmé,
    à surveiller en usage réel -- cf. "Point de vigilance" plus bas)
    ============================================================
    Quand cette fonction est appelée alors qu'un AUTRE onglet est déjà
    ouvert et affiché (donc que le nouvel onglet reste en arrière-plan
    dans le tab-strip de Vivaldi, sans jamais devenir l'onglet
    visuellement actif), le domaine CDP Runtime (Runtime.enable,
    Runtime.evaluate) ne répond JAMAIS sur ce target -- aucune erreur,
    aucune exception, juste un blocage indéfini. Le domaine Page/Target,
    lui, répond normalement (create_target, attach, navigate,
    setWebLifecycleState : tous instantanés). Symptôme côté appelant :
    _masquer_curseur_virtuel() (dans action_capture_propre) ou tout autre
    Runtime.evaluate reste bloqué jusqu'au timeout externe (5s, posé dans
    _consommer_file_commandes), sans log ni exception avant ça.

    CAUSE ISOLÉE ET CONFIRMÉE (script de repro CDP brut, SANS nodriver ni
    AutoniaX -- cf. repro_cdp_brut.py) : le blocage se reproduit à
    l'identique en websocket CDP pure, aussi bien via une connexion
    page-level dédiée que via Target.attachToTarget(flatten=True)
    (le mécanisme utilisé par nodriver). Ce n'est donc PAS un bug
    nodriver, PAS un bug de séquence côté AutoniaX (Page.navigate
    explicite testé sans effet, setWebLifecycleState('active') répond
    toujours vite mais ne débloque rien, enable_begin_frame_control=False
    sans effet) -- c'est un comportement de Vivaldi lui-même : le
    renderer d'un onglet jamais rendu visuellement actif reste dans un
    état où le domaine Runtime n'est jamais honoré. Cohérent avec les
    retours utilisateurs connus sur le forum Vivaldi au sujet des onglets
    d'arrière-plan qui ne chargent/rendent jamais tant qu'ils ne
    deviennent pas l'onglet visible.

    FIX APPLIQUÉ ET CONFIRMÉ (repro_cdp_brut.py, bloc "TEST FOCUS
    EXPLICITE") : Target.createTarget avec background=False ET focus=True
    explicites au moment de la création débloque Runtime.enable
    instantanément (0.002s), alors que le même onglet créé sans ces deux
    paramètres explicites bloque systématiquement ~6s. Reproductible,
    testé sur une base propre (ancien témoin piégé écarté, cf. logique de
    recherche de témoin dans repro_cdp_brut.py).

    Point de vigilance qui reste ouvert (PAS encore vérifié en usage réel,
    seulement en test manuel fenêtre visible) : d'après la doc CDP
    officielle, le comportement de focus dépend de background :
      - background=False + focus omis (défaut)      -> focus + fenêtre
        ramenée au premier plan
      - background=False + focus=False               -> pas de changement
        de focus fenêtre (reste en arrière-plan si elle y était déjà)
      - background=False + focus=True (notre fix)     -> target focus
        explicitement -- comportement fenêtre non garanti identique au cas
        "focus omis" selon les versions (cf. bug CDP connu,
        ChromeDevTools/devtools-protocol#178)
    Lors du test manuel, aucun mouvement de fenêtre n'a été observé --
    mais la fenêtre Vivaldi de debug était déjà au premier plan à l'écran
    pendant ce test, donc il n'y avait rien de visible à faire remonter.
    Le cas réel visé (Vivaldi minimisé/arrière-plan pendant que
    l'utilisateur travaille ailleurs) n'a pas encore été testé avec ce
    fix précis -- à surveiller au premier déploiement en usage réel.
    Si un vol de focus apparaît malgré tout dans ce cas, tester en premier
    lieu focus=True SANS toucher background (garder background=False),
    car c'est la combinaison qui a été validée ; ne pas réintroduire
    Target.activateTarget / Tab.activate() après coup, déjà écarté pour
    vol de focus systématique et confirmé.
    ============================================================

    RE-PATCH (log réel, cf. session AutoniaX 2026-08-07 09:02-09:17) :
    l'hypothèse "confirmé... ABSENT sur Chrome" ci-dessus (repro_chrome.py)
    est CONTREDITE par un run réel sur Chrome (executable=chrome.exe,
    confirmé dans les logs de démarrage) : après un newTab() ouvrant la
    page de test en arrière-plan (welcome page restée affichée), la boucle
    de streaming CDP s'est mise à geler périodiquement (log "BLOQUÉE plus
    de 5s sur capturer_frame_reelle (CDP probablement figé)", plusieurs
    occurrences sur ~5 minutes), et une commande capture_propre a carrément
    échoué en timeout (>5s, aucune réponse CDP). Signature identique au bug
    Vivaldi documenté plus haut -- soit repro_chrome.py testait un contexte
    qui ne reproduit pas le bug réel (version Chrome différente, ou délai/
    ordre d'appels différent de l'usage réel via ce fichier), soit le bug
    existe aussi sur Chrome mais plus intermittent (pas systématique comme
    sur Vivaldi, d'où repro_chrome.py "propre" en test isolé mais un vrai
    run plus long/chargé le fait ressortir).

    On réapplique donc background=False/focus=True inconditionnellement
    (plus de branchement par navigateur -- le risque de vol de focus
    documenté ci-dessus reste next, mais un onglet qui gèle silencieusement
    des minutes durant est pire qu'un vol de focus ponctuel). Si un vol de
    focus gênant est confirmé en usage réel avec ce fix, cf. "Point de
    vigilance" ci-dessus avant de le retirer -- ne pas repasser à
    background=True sans un nouveau repro qui exclue explicitement le
    scénario "onglet déjà ouvert et affiché avant ce newTab", qui est
    précisément le cas qui a gelé ici (cellule 1 du Task : la welcome page
    reste ouverte pendant que la page de test s'ouvre dans un nouvel
    onglet).

    ============================================================
    PATCH (demande explicite utilisateur -- "idiot que sa finit de
    souvir" : new_tab() doit attendre que la page ait RÉELLEMENT fini de
    charger, pas seulement que l'onglet ait été créé/attaché) :
    ============================================================
    Après attach(), on interroge document.readyState en boucle courte
    (polling léger via Runtime.evaluate, PAS un unique Page.loadEventFired
    -- volontairement, cf. bug Vivaldi/Runtime documenté ci-dessus : un
    seul point d'attente qui reste bloqué indéfiniment si Runtime ne
    répond jamais sur ce target serait pire qu'un polling qui peut au
    moins être borné proprement) jusqu'à "complete", ou jusqu'à
    timeout_attente_page_s écoulées.

    Décision utilisateur explicite sur le comportement en cas de
    dépassement : "Attendre un timeout dédié puis échouer proprement
    (ResultatAction/erreur, pas de RuntimeError qui plante tout)" -- donc
    AUCUNE exception levée ici sur timeout : on retourne quand même la
    page (l'onglet existe bel et bien, potentiellement encore en train de
    charger) accompagnée d'un flag charge=False, à charge de l'appelant
    (_executer_commande) de traduire ça en command_result ok=False propre,
    cohérent avec la convention déjà en place pour action_drag (retour
    structuré plutôt qu'exception pour un échec "métier" attendu, cf. son
    docstring)."""
    # PATCH (demande explicite utilisateur -- blocage médias) : quand
    # bloquer_media=True, on NE PEUT PAS poser le filtre CDP sur `page`
    # avant qu'elle n'existe -- or create_target(url, ...) navigue déjà
    # vers `url` immédiatement à la création du target, donc la page
    # commencerait à charger ses ressources AVANT que le filtre ne soit
    # posé. Pour cette raison uniquement, l'ordre change : on crée le
    # target sur "about:blank" (jamais de requête réseau propre à
    # about:blank), on attache, on installe le filtre, PUIS on navigue
    # réellement vers `url` via action_navigate (cf. sa docstring) --
    # même mécanique d'attente de chargement, aucune duplication de
    # logique. Quand bloquer_media=False (comportement historique,
    # inchangé) : create_target navigue directement vers `url`, comme
    # avant ce patch.
    _feather = bool(_PROCESSUS_FEATHER)   # PATCH Feather : onglet via window.open (même fenêtre), puis navigation
    target_id = None
    if _feather:
        target_id = await _feather_ouvrir_onglet_window_open(browser, etat_navigateur)
    if target_id is None and _feather:
        # Pas de repli createTarget sur Feather : il ouvre des fenetres WebView2 separees.
        raise RuntimeError("Feather : le nouvel onglet n'a pas ete cree (window.open sans resultat) -- voir onglets.log a cote de featherBrowser.pyw")
    if target_id is None:
        target_id = await browser.send(
            cdp.target.create_target(
                "about:blank" if (bloquer_media or _feather or _ro_remplacements_actifs(etat_navigateur)) else (url or "about:blank"),
                enable_begin_frame_control=False,
                background=False,
                focus=True,
            )
        )
    await browser.update_targets()
    page = next(t for t in browser.targets if t.target.target_id == target_id)
    await page.attach()

    # PATCH (remplacement de ressources) : si des règles sont actives, l'interception est posée sur ce nouvel onglet
    # AVANT la navigation réelle (le target a été créé sur about:blank pour cette raison, comme pour bloquer_media).
    _avec_remplacements = _ro_remplacements_actifs(etat_navigateur)
    if _avec_remplacements:
        await _ro_synchroniser_page(page, etat_navigateur)

    if (bloquer_media or _avec_remplacements or _feather) and url:
        # CORRECTION (SPEC §3.2/§5.4) : le gardien a déjà suspendu ce target
        # à sa création (waitForDebuggerOnStart) et l'a équipé AVANT de le
        # reprendre -- aucune requête n'a pu partir. On se contente donc de
        # confirmer l'état voulu, puis de naviguer. Le détour par
        # about:blank est conservé : sans gardien (repli couche 1b) il reste
        # la seule façon de poser un filtre avant la première requête.
        if bloquer_media:
            await _synchroniser_blocage_media_profil(page, None, True)
        charge_nav, erreur_nav = await action_navigate(page, url, timeout_attente_page_s, bloquer_media=False)
        # bloquer_media=False ci-dessus : le filtre est déjà posé sur cet
        # onglet à l'instant (idempotent de toute façon, cf. docstring
        # _installer_blocage_media), inutile de le réinstaller une 2e fois.
        return page, charge_nav, erreur_nav

    # PATCH (factorisation -- cf. docstring de _attendre_chargement_page
    # juste plus bas, extraite de cette boucle telle quelle pour être
    # réutilisée par action_navigate) : MÊME pattern CDP que le reste de
    # ce fichier (cf. action_copy, action_get_clipboard,
    # _localiser_input_file juste au-dessus) -- page.evaluate() n'existe
    # pas sur l'objet Tab de cette version de nodriver, seul
    # page.send(cdp.runtime.evaluate(...)) est utilisé partout ailleurs
    # ici. Un Runtime.evaluate isolé qui échoue (cf. bug Vivaldi/Runtime
    # documenté plus haut) ne fait JAMAIS planter cette attente, ni
    # remonter d'exception (décision utilisateur "pas de RuntimeError
    # qui plante tout") -- seul le timeout global tranche.
    charge, erreur_attente = await _attendre_chargement_page(page, timeout_attente_page_s)

    return page, charge, erreur_attente


async def _attendre_chargement_page(page, timeout_attente_page_s: float) -> Tuple[bool, Optional[str]]:
    """AJOUT (demande explicite utilisateur : "je veux que on puisse
    rester sur l'onglet actif et naviguer vers un lien précis, et
    vérifier si la page a été chargée avec succès ou pas") -- factorise
    EXACTEMENT le polling document.readyState déjà présent dans
    action_new_tab ci-dessus (même boucle, même philosophie -- un
    Runtime.evaluate isolé qui échoue ne fait jamais planter l'attente,
    cf. bug Vivaldi/Runtime documenté dans action_new_tab, seul le
    timeout global tranche), extrait dans sa propre fonction pour être
    réutilisé À L'IDENTIQUE par action_navigate (navigation sur un
    onglet DÉJÀ ouvert, contrairement à action_new_tab qui en crée un).

    Retourne (charge: bool, erreur: Optional[str]) -- même contrat que
    le triplet (page, charge, erreur_attente) de action_new_tab, sans le
    premier élément puisqu'ici `page` est déjà connue de l'appelant
    (jamais créée ici)."""
    charge = False
    erreur_attente: Optional[str] = None
    boucle = asyncio.get_event_loop()
    debut = boucle.time()
    try:
        while True:
            try:
                resultat_eval, exception_details = await page.send(
                    cdp.runtime.evaluate("document.readyState", return_by_value=True)
                )
                ready_state = resultat_eval.value if (exception_details is None and resultat_eval is not None) else None
            except Exception:
                ready_state = None
            if ready_state == "complete":
                charge = True
                break
            if boucle.time() - debut >= timeout_attente_page_s:
                erreur_attente = (
                    f"la page n'a pas fini de charger dans le délai imparti ({timeout_attente_page_s}s)"
                )
                break
            await asyncio.sleep(0.1)
    except Exception as e:
        erreur_attente = f"erreur pendant l'attente de chargement : {e}"
    return charge, erreur_attente


