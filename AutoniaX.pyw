    # d'un délai court, indépendamment du ping/pong natif du protocole
    # WebSocket (pas fiable à travers tous les proxys intermédiaires).
    # 15s < tout délai d'inactivité observé (coupure constatée après 15s
    # de silence, cf. logs) -- garde une marge confortable sans spammer
    # inutilement. cf. _tache_heartbeat.
    DELAI_HEARTBEAT_SECONDES = 15.0
    # BUGFIX (demande explicite utilisateur, suite à un redémarrage manuel
    # du serveurT en ligne -- cf. bouton "Redémarrer le serveurT" dans
    # Paramètres -- qui laissait mAutoniax bloqué sur une connexion morte
    # jusqu'à fermeture manuelle de l'app) : AVANT ce correctif,
    # _tache_heartbeat envoyait un "ping" toutes les DELAI_HEARTBEAT_
    # SECONDES mais ne vérifiait JAMAIS qu'un "pong" revenait -- self._ws.
    # send(...) peut réussir SANS exception même quand plus personne
    # n'écoute réellement côté serveur (ex. l'ancien process serveur.py
    # vient d'être tué pour redémarrage, mais le tunnel Cloudflare Quick
    # Tunnel, lui, reste ouvert et accepte encore l'écriture localement le
    # temps que la coupure se propage) : le client restait alors persuadé
    # d'être connecté indéfiniment, sans jamais redéclencher le retry de
    # _boucle_async. DELAI_TIMEOUT_PONG_SECONDES borne l'attente d'un pong
    # après CHAQUE ping -- absence de réponse dans ce délai = connexion
    # traitée comme morte, fermeture forcée de self._ws (cf. _tache_
    # heartbeat), ce qui fait lever ConnectionClosed dans la boucle
    # `async for brut in self._ws` (_boucle_async) et relance le cycle de
    # retry déjà existant, exactement comme une vraie coupure réseau.
    # CORRECTIF (retour utilisateur : "75 seconde cest quoi sa" -- valeur
    # initiale bien trop conservatrice, sans rapport avec les autres
    # délais réseau de cette même classe) -- alignée sur DELAI_TIMEOUT_
    # REGISTER_SECONDES (10s, déjà le délai retenu pour un aller-retour
    # avec ce même serveurT) avec une petite marge : un aller-retour
    # applicatif (pas juste TCP) via Colab+tunnel Cloudflare reste de
    # l'ordre de la seconde en pratique, pas des dizaines de secondes --
    # ce timeout n'est de toute façon qu'un FILET DE SÉCURITÉ générique
    # pour toute coupure silencieuse (crash Colab, coupure réseau...) :
    # le cas précis "redémarrage déclenché DEPUIS l'app" (bouton
    # "Redémarrer le serveurT") n'attend même pas ce délai du tout, cf.
    # forcer_reconnexion() plus bas, appelée directement par ce bouton.
    # BUGFIX (retour utilisateur : téléchargement mouseData.sqlite3 coupé
    # en plein milieu par "Aucun pong reçu du serveurT depuis 15s" alors
    # que la connexion n'était PAS morte -- juste occupée à transférer un
    # chunk de TAILLE_CHUNK_PROFIL_OCTETS=5 Mo, cf. son propre
    # commentaire) -- 15s suffisait pour un aller-retour applicatif
    # normal (ping/pong, quelques octets), mais un chunk de 5 Mo
    # (~6,7 Mo encodés en base64 sur le fil) peut à lui seul dépasser ce
    # délai sur un tunnel Cloudflare gratuit lent/congestionné : le pong
    # arrive alors RÉELLEMENT en retard (congestion sur cette même
    # connexion), pas absent -- _tache_heartbeat le traitait à tort comme
    # une connexion zombie et la fermait de force EN PLEIN téléchargement,
    # provoquant le TimeoutError()/ConnectionClosedError observés.
    # 60s laisse une marge large pour un chunk de cette taille sur ce
    # type de tunnel, tout en restant un filet de sécurité réel pour une
    # vraie coupure silencieuse (le cas qui a motivé ce mécanisme à
    # l'origine, cf. sa docstring plus haut).
    DELAI_TIMEOUT_PONG_SECONDES = 60.0
    # PATCH (demande explicite utilisateur : "remet le logs des cpature
    # et compresion dimage ... mais je veu que leur frequece daffichage
    # chute aussi drastiquement" + "fait le tout les 10 seconde") --
    # remonte log_reseau_t (envoi capture) et log_captures (compression
    # webp) de .debug à .info (donc de nouveau visibles au niveau INFO
    # par défaut, cf. leur retrait précédent), mais THROTTLÉS : au lieu
    # d'une ligne par frame (plusieurs/seconde en capture continue), une
    # seule ligne résumée au maximum toutes les DELAI_THROTTLE_LOGS_
    # CAPTURE_SECONDES -- même intervalle que le futur "point périodique"
    # du watchdog exécutants, pour un rythme de logs cohérent partout.
    # Throttle PAR instance_id (cf. self._dernier_log_capture_par_instance
    # dans __init__) : l'activité d'une instance ne doit jamais masquer
    # les logs d'une autre qui tournerait en parallèle.
    DELAI_THROTTLE_LOGS_CAPTURE_SECONDES = DELAI_THROTTLE_LOG_COMPRESSION_SECONDES
    # PATCH (Patch 4.4.a/4.6 -- transferts point-à-point relayés en
    # direct par le serveurT, jamais stockés sur B2) -- même valeur que
    # TAILLE_CHUNK_PROFIL_OCTETS pour rester cohérent, cf. sa docstring.
    TAILLE_CHUNK_RELAIS_OCTETS = 512 * 1024

    def __init__(self, server_url: str = "", nom: str = "mAutoniax",
                 config_stockage: Optional[dict] = None, role: str = "pilote"):
        super().__init__()
        # PATCH (plus de repli Render -- SERVEUR_T_URL supprimée) --
        # server_url par défaut vide : de toute façon réécrite par
        # resoudre_url_serveurt() à CHAQUE tentative de connexion (cf.
        # _boucle_async), cette valeur initiale n'est qu'un placeholder
        # avant la toute première tentative, jamais utilisée pour se
        # connecter réellement.
        self.server_url = server_url
        self.nom = nom
        # PATCH (mode sAutoniax -- demande explicite utilisateur : cette
        # classe était figée sur role="pilote" en dur (cf. _boucle_async),
        # alors que les handlers envoyer_capture/telecharger_fichier
        # existent déjà côté client pour le rôle "executant" -- role
        # paramétrable pour que main_sautoniax() puisse s'enregistrer
        # en "executant" avec CETTE MÊME classe, sans dupliquer toute
        # la logique de connexion/retry/thread pour un client distinct.
        # "pilote" reste la valeur par défaut : tout code existant
        # (mAutoniax) qui instancie ClientServeurT() sans préciser role
        # continue de s'enregistrer comme "pilote", comportement inchangé.
        if role not in ("pilote", "executant"):
            raise ValueError(f"role invalide pour ClientServeurT : {role!r} (attendu 'pilote' ou 'executant')")
        self.role = role
        # AJOUT (bug confirmé : badge/spinner de cellule bloqué "en cours"
        # indéfiniment malgré une exécution réellement terminée côté
        # sAutoniax, alors que les lignes de print() arrivent bien) --
        # cause racine : le serveurT (cf. serveur.py, handler "executer_
        # notebook_distant") pose id_pilote=id_connexion (str(id(websocket)),
        # cf. Registre/docstring "identité stable par nom") dans le message
        # transmis au sAutoniax -- valeur qui change à CHAQUE reconnexion
        # WebSocket de ce client. Le sAutoniax garde cet id_pilote en
        # mémoire pendant toute la durée (potentiellement longue) de
        # l'exécution, puis renvoie son résultat final (notebook_distant_
        # resultat) en ciblant ce MÊME id_pilote. Si la connexion s'est
        # rompue et reconnectée entre-temps (coupure réseau, veille...),
        # l'ancien id_pilote ne correspond plus à rien dans registre.
        # connexions côté serveur -- le message est alors SILENCIEUSEMENT
        # perdu (logger.warning côté serveur seulement), et le badge ne se
        # débloque jamais alors que les notebook_distant_log (les print(),
        # envoyés AVANT la coupure) sont bien arrivés -- exactement le
        # symptôme observé.
        #
        # self.nom (ci-dessus, "mAutoniax" par défaut) N'EST PAS une
        # identité stable UTILISABLE ici : c'est une valeur PARTAGÉE par
        # toute installation AutoniaX qui ne la modifie pas explicitement
        # -- deux machines connectées en même temps au même serveurT
        # porteraient le même nom, ce qui romprait la résolution par nom
        # (contrairement à un exécutant, dont le nom est déjà garanti
        # unique par Registre.ajouter). self._id_pilote_stable, lui, est
        # généré UNE SEULE FOIS ici, à la CONSTRUCTION de ce client (pas à
        # chaque connexion/reconnexion, cf. _boucle_async qui l'envoie tel
        # quel à chaque register) -- une valeur véritablement unique et
        # stable pour toute la durée de vie de ce process, quel que soit
        # le nombre de coupures/reconnexions WebSocket entre-temps. Cf.
        # Registre.pilote_par_id (serveur.py), symétrique de executant_
        # par_id, qui résout désormais id_pilote par CETTE valeur plutôt
        # que par id_connexion.
        self._id_pilote_stable = f"pilote-{uuid.uuid4().hex[:16]}"
        # PATCH (demande explicite utilisateur : "je veux que on connecte
        # deja notre stokage cloudflare avec notre serveur, parceque on
        # vas envoyer certains fichier sur le stoakge persistant") --
        # identifiants R2 (cf. ReglagesApp.r2_*), envoyés au serveurT
        # juste après le register réussi (cf. _boucle_async), et à
        # nouveau à chaque reconnexion puisque le serveurT ne persiste
        # rien sur disque pour l'Étape 0/1 (mémoire simple, cf. cahier
        # section 5.4). None/vide = pas encore configuré, rien n'est
        # envoyé (le serveurT tourne alors sans capacité de stockage).
        self._config_stockage = config_stockage or {}
        # PATCH (throttle logs capture/compression, cf. docstring de
        # DELAI_THROTTLE_LOGS_CAPTURE_SECONDES) -- instance_id -> (timestamp
        # du dernier log affiché, nb de captures envoyées depuis ce log).
        # Alimenté par _envoyer_capture/_compresser_capture_webp, jamais
        # remis à zéro ailleurs (une instance qui se déconnecte puis
        # revient reprend simplement son throttle là où il en était,
        # aucune conséquence -- au pire un premier résumé affiché un peu
        # avant les 10s pleines après une reconnexion).
        self._dernier_log_capture_par_instance: dict[str, tuple[float, int]] = {}
        # PATCH (recompression par pilote -- demande explicite
        # utilisateur : "le serveurT pour renvoyer chez nous on va nous
        # même modifier les paramètres"). Même raison que _config_
        # stockage ci-dessus : le serveurT garde cette préférence sur
        # l'objet Connexion (cf. Connexion.preference_capture côté
        # serveur.py), recréé à CHAQUE nouvelle connexion WebSocket --
        # sans ce ré-envoi à la reconnexion, un pilote qui avait choisi
        # "Économie" perdrait ce réglage (retour silencieux au défaut
        # "full"/80) à la moindre coupure réseau, alors que c'est
        # précisément le scénario ("j'ai souvent des soucis de connexion
        # internet") que ce réglage vise à accommoder. Défauts alignés
        # sur ceux du serveur (cf. Connexion.preference_capture) --
        # un pilote qui ne touche jamais ce réglage n'envoie jamais ce
        # message, le serveur garde alors ses propres défauts.
        self._preference_capture: Optional[dict] = None
        # CORRECTIF (cf. docstring du signal id_serveur_recu ci-dessus) :
        # identifiant de connexion attribué par le serveurT au "register"
        # (message "register_ok"), inconnu tant que la première connexion
        # n'a pas abouti -- None jusque-là.
        self._id_serveur: Optional[str] = None
        # Api2Api -- corrélation requete_id -> concurrent.futures.Future,
        # UN SEUL dict réutilisé pour les trois allers-retours bloquants
        # du protocole (verrouillage, requête/réponse, attente d'une
        # requête entrante côté fournisseur -- cf. Api2Api/attendre_requete
        # plus bas dans ce fichier) : chacun génère son propre requete_id
        # unique, donc aucune confusion possible malgré le partage du
        # même dict. Même esprit EXACT que COMMANDES_INSTANCE_EN_ATTENTE
        # côté serveurT (posé à l'envoi, résolu/purgé à la réception dans
        # _traiter_message plus bas) mais ICI, côté CLIENT : c'est ce qui
        # permet à Api2Api()/.request()/attendre_requete() de bloquer le
        # thread du script utilisateur (future.result(timeout=...), même
        # patron que InstanceExecutableDirecteCamoufox._appeler) jusqu'à
        # ce que la réponse corrélée arrive sur le WebSocket -- résolue
        # depuis la boucle asyncio (_traiter_message), jamais depuis le
        # thread du script lui-même.
        self._api2api_futures: dict[str, "concurrent.futures.Future"] = {}
        # BUGFIX (log observé : "api2api_requete_recue reçue sans
        # attendre_requete() en cours ... requête perdue") -- course
        # structurelle : entre le moment où le script fournisseur finit
        # de traiter une requête (req.repondre(...), le Task redevient
        # "libre" côté serveurT) et le moment où le thread Python local a
        # fini de repasser en haut de sa boucle while True: pour rappeler
        # attendre_requete() -> api2api_attendre_requete_bloquant() ->
        # POSE la future sous cle_future (cf. cette méthode plus bas), il
        # s'écoule un délai Python réel non nul. Un nouveau client peut
        # verrouiller ce Task ET envoyer sa requête pendant cette fenêtre
        # précise : le message api2api_requete_recue arrive alors AVANT
        # que la future correspondante n'existe -> perdu silencieusement
        # (cf. ancien comportement de _traiter_message), et le fournisseur
        # reste bloqué pour toujours sur une future qui ne sera jamais
        # résolue (le client, lui, finira par timeout côté api2api_
        # requete_bloquant, mais seulement après TIMEOUT_REQUETE_S_DEFAUT).
        # Correctif : mémoriser ICI toute requête arrivée en avance (clé =
        # cle_future = f"attente_requete:{id_api2api}", MÊME clé que la
        # future elle-même, donc same site des deux côtés), et la
        # consommer immédiatement dès que api2api_attendre_requete_
        # bloquant est rappelée pour ce id_api2api, plutôt que de reposer
        # une future qui attendrait un message déjà arrivé.
        self._api2api_requetes_en_avance: dict[str, dict] = {}
        # AJOUT (cf. RelaisProxyLocal.obtenir_horloge_mautoniax plus loin
        # dans ce fichier, migration depuis /ws_tunnel vers /ws JSON
        # standard) -- côté EXÉCUTANT uniquement : au plus UNE demande
        # d'horloge en vol à la fois pour ce client (obtenir_horloge_
        # mautoniax n'est appelée qu'au toggle proxy natif, jamais en
        # parallèle avec elle-même pour ce même sAutoniax). concurrent.
        # futures.Future (PAS asyncio.Future) -- ClientServeurT tourne
        # sur SA PROPRE boucle (self._loop), alors que l'appelant
        # (RelaisProxyLocal) tourne sur la boucle asyncio DÉDIÉE du
        # sAutoniax (_main_async_sautoniax, cf. docstring de RelaisProxy
        # Local) -- une asyncio.Future créée sur une boucle ne peut pas
        # être attendue correctement depuis une autre. concurrent.
        # futures.Future est thread-safe et boucle-agnostique, exactement
        # comme _api2api_futures ci-dessus pour la même raison. Posée
        # juste avant l'envoi, résolue par _traiter_message dès que
        # horloge_mautoniax_resultat arrive, jamais utilisée côté PILOTE
        # (qui répond directement, sans attente -- cf. _traiter_message,
        # bloc demander_horloge_mautoniax).
        self._attente_horloge_mautoniax: Optional["concurrent.futures.Future"] = None
        self._thread: Optional[threading.Thread] = None
        self._loop: Optional[asyncio.AbstractEventLoop] = None
        self._ws = None
        self._tache_boucle: Optional[asyncio.Task] = None
        self._arret_demande = threading.Event()
        # AJOUT (livraison garantie, cf. _garantie_enregistrer) -- survit aux reconnexions (même objet client).
        self._file_garantie: "collections.OrderedDict[str, dict]" = collections.OrderedDict()   # exécutant : uid -> message à livrer
        self._verrou_garantie = threading.Lock()
        self._sessions_actives: dict = {}          # exécutant : session_id -> id_pilote (exécutions en cours)
        self._uids_vus: "collections.OrderedDict[str, float]" = collections.OrderedDict()      # pilote : uid déjà appliqués
        self._sessions_attendues: dict = {}        # pilote : session_id -> {id_executant, t_envoi, t_vie, absences, alerte}
        self._executants_vivantes: set = set()     # pilote : exécutants ayant déjà envoyé « sessions_vivantes »
        self._tache_rejeu = None
        # BUGFIX (cf. DELAI_TIMEOUT_PONG_SECONDES) -- timestamp
        # (time.monotonic()) du dernier "pong" reçu du serveurT, mis à
        # jour par _traiter_message. None tant qu'aucun pong n'est encore
        # arrivé sur la connexion COURANTE -- remis à None à CHAQUE
        # nouvelle connexion établie (cf. _boucle_async, juste après le
        # register réussi, AVANT de lancer _tache_heartbeat) pour ne
        # jamais réutiliser par erreur le timestamp d'une connexion
        # précédente déjà morte.
        self._dernier_pong_recu: Optional[float] = None
        # CORRECTIF RADICAL (retour utilisateur explicite : le heartbeat
        # tuait la connexion EN PLEIN téléchargement d'un gros chunk --
        # cf. docstring complète de _tache_heartbeat pour le mécanisme
        # exact : un gros message (chunk de plusieurs Mo encodé en
        # base64) peut mettre plus de DELAI_TIMEOUT_PONG_SECONDES à
        # transiter sur un tunnel Cloudflare gratuit congestionné, ce qui
        # retarde d'autant le pong suivant sur cette MÊME connexion
        # (ordre garanti par le protocole WebSocket) -- _tache_heartbeat
        # le traitait alors à tort comme une connexion zombie et la
        # fermait de force, quelle que soit la taille de chunk retenue
        # (augmenter DELAI_TIMEOUT_PONG_SECONDES ne fait que repousser le
        # seuil, jamais l'éliminer). Solution radicale : _tache_heartbeat
        # ne ping/vérifie PLUS DU TOUT tant qu'un transfert en chunks est
        # activement en cours sur cette connexion (compteur plutôt que
        # booléen : plusieurs transferts, ex. un download ET un upload,
        # pourraient en théorie se chevaucher sur cette même connexion,
        # cf. leurs Future dédiées respectives -- le heartbeat ne doit se
        # remettre en veille QUE quand le dernier transfert actif se
        # termine). Incrémenté/décrémenté explicitement par chaque bloc
        # de transfert en chunks (_telecharger_fichier, _envoyer_profil,
        # _envoyer_mise_a_jour_app_chunks, etc.) autour de leur boucle de
        # chunks -- jamais autour de la seule attente de l'ack de
        # début/fin, qui reste rapide et ne justifie pas de suspendre le
        # heartbeat.
        self._transferts_chunk_actifs: int = 0

        # PATCH (bloc "Envoyer un profil" -- protocole en chunks, demande
        # explicite utilisateur : "vraie progression par chunks"). Future
        # résolue par _traiter_message dès qu'un accusé de réception
        # (envoi_profil_debut_ack / envoi_profil_chunk_ack / envoi_profil_
        # resultat) arrive -- permet à _envoyer_profil d'ATTENDRE la
        # confirmation serveur avant d'envoyer le chunk suivant (donc une
        # progression basée sur des accusés réels, pas juste "poussé dans
        # le buffer TCP local"). Un seul envoi de profil actif à la fois
        # (cf. envoyer_profil, pas de file d'attente), donc une seule
        # Future suffit -- pas besoin de les indexer par nom_profil.
        self._future_ack_profil: Optional[asyncio.Future] = None
        # PATCH (protocole de téléchargement générique, sens inverse de
        # l'envoi -- demande explicite utilisateur : "sAutoniax vas
        # directement demander la requette au serveur et telecharger").
        # Même rôle que _future_ack_profil ci-dessus, mais pour les 3
        # accusés du téléchargement (telechargement_fichier_debut_ack /
        # _chunk_ack) -- Future séparée plutôt que réutiliser
        # _future_ack_profil : un upload et un téléchargement pourraient
        # en théorie être en cours en même temps sur la même connexion
        # (ex. sAutoniax qui télécharge son profil pendant qu'un envoi de
        # profil déclenché ailleurs est encore actif), les mélanger sur
        # une seule Future casserait la corrélation de l'un ou l'autre.
        self._future_ack_telechargement: Optional[asyncio.Future] = None
        # BUGFIX (corrélation ack/requête -- logs utilisateur à l'appui :
        # plusieurs runs où project.json échouait juste après un timeout
        # de mouseData.sqlite3, avec "nb_chunks invalide (0)" alors que
        # project.json existe bel et bien sur B2) -- _future_ack_
        # telechargement ci-dessus est UNE Future PARTAGÉE pour toute la
        # séquence telecharger_fichier_debut/_chunk d'un même fichier ET
        # entre fichiers successifs (mouseData puis project.json puis
        # service_api, l'un après l'autre sur cette même Future). Rien
        # ne garantissait jusqu'ici qu'un ack reçu correspondait bien à
        # la requête EN COURS : un ack arrivé en retard (après un
        # _attendre_ack_telechargement qui a déjà timeout à 120s et
        # rendu la main à l'appelant, qui est alors passé au fichier
        # suivant) était quand même résolu sur cette Future -- confondant
        # par exemple un chunk_ack tardif de mouseData (qui n'a jamais eu
        # de champ nb_chunks) avec le debut_ack attendu pour project.json
        # (d'où le nb_chunks=0 lu via .get(..., 0)). Ces deux attributs
        # mémorisent la clé et (pour un chunk) l'index EXACTEMENT
        # attendus par le prochain _attendre_ack_telechargement -- posés
        # juste avant chaque envoi, lus dans le handler générique
        # (data.get("type") in (...) plus bas) pour ignorer silencieusement
        # tout ack qui ne correspond pas, plutôt que de le confondre avec
        # la réponse attendue. Symétrique du correctif serveur.py qui
        # ajoute désormais "cle" à CHAQUE ack (les deux étaient
        # nécessaires : le serveur ne l'envoyait pas avant, et même en
        # l'envoyant, rien ne le vérifiait ici).
        self._attente_cle_telechargement: Optional[str] = None
        self._attente_index_chunk_telechargement: Optional[int] = None
        # PATCH (Patch 4.9) -- même patron que _future_ack_profil/
        # _future_ack_telechargement, une Future dédiée par famille de
        # message pour ne jamais mélanger la corrélation de deux
        # transferts distincts qui pourraient être en vol simultanément
        # (ex. un envoi de projet ET une mise à jour service API en
        # parallèle sur le même sAutoniax, ou plusieurs sAutoniax gérés
        # par le même pilote -- cf. _future_ack_par_session ci-dessous,
        # indexée par session_id plutôt qu'une seule Future globale,
        # nécessaire ici car PLUSIEURS sessions peuvent être en vol EN
        # PARALLÈLE sur cette même connexion pilote, contrairement à
        # l'upload de profil/téléchargement qui restent un seul à la
        # fois par connexion (cf. docstring UploadProfilEnCours côté
        # serveurT).
        self._future_ack_par_session: dict[str, asyncio.Future] = {}
        # RETRAIT (migration "Mettre à jour" vers Drive direct) : les
        # anciens attributs _future_ack_mise_a_jour (corrélation des
        # accusés du protocole en chunks mettre_a_jour_app_debut/_chunk/
        # _fin) et _transfert_maj_en_cours (état du transfert EN COURS ou
        # EN PAUSE, cf. ex-classe TransfertMiseAJourEnCours) ont été
        # entièrement retirés -- _envoyer_mise_a_jour_app uploade
        # désormais directement vers Drive via un seul appel bloquant,
        # plus aucun accusé réseau ni état de transfert à corréler ici.
        # PATCH E (E.4 -- séquencement d'un BatchDistribue, cf.
        # _sequencer_batch) -- même patron que _future_ack_par_session
        # ci-dessus, mais résolue par retour_projet_execute_recu (fin
        # RÉELLE de l'exécution distante) plutôt que par un simple ack
        # réseau : _sequencer_batch a besoin d'attendre que CE
        # ProjetBatch précis ait fini de s'exécuter côté sAutoniax avant
        # d'envoyer le suivant du même batch, pas seulement que l'envoi
        # ait réussi (cf. docstring d'envoyer_batch_vers_sautoniax).
        # Indexée par session_id, jamais par id_batch_distribue -- un
        # batch n'a qu'UN SEUL ProjetBatch réellement "en vol" à la fois
        # (exécution séquentielle, cf. E.4), donc une seule entrée
        # active ici par batch à tout instant, mais garder l'indexation
        # par session_id évite toute ambiguïté si deux batchs distincts
        # tournaient en parallèle sur deux sAutoniax différents.
        self._future_fin_projet_par_session: dict[str, asyncio.Future] = {}
        # Dossiers temporaires d'assemblage des transferts en chunks
        # reçus côté EXÉCUTANT (projet distribué / service API), indexés
        # par session_id -- cf. _traiter_message, blocs
        # envoyer_projet_vers_sautoniax_chunk / mettre_a_jour_service_
        # api_chunk. Écriture incrémentale au fil des chunks (même
        # principe que _telecharger_fichier), jamais accumulé en mémoire.
        self._reception_chunks_par_session: dict[str, dict] = {}
        # CORRECTIF (retour utilisateur explicite : "sa ligne est resté
        # grisée et pourtant il avait déjà téléchargé ses dépendances")
        # -- côté EXÉCUTANT uniquement (reste toujours False, jamais lu,
        # pour un pilote) : mémorise si envoyer_sautoniax_pret() a déjà
        # été appelée au moins une fois avec succès pour ce process
        # sAutoniax, afin de la renvoyer automatiquement à CHAQUE
        # reconnexion suivante (cf. _boucle_async, même raisonnement
        # EXACT que _envoyer_config_stockage/_envoyer_preference_capture
        # pour le rôle "pilote" juste au-dessus) -- sans ça, un serveurT
        # qui ne persiste rien (registre en mémoire simple) oublie que
        # cet exécutant est prêt dès qu'il redémarre ou qu'un nouveau
        # pilote se connecte après coup, et sa ligne reste grisée pour
        # toujours côté UI malgré des dépendances déjà bien téléchargées.
        self._sautoniax_deja_pret: bool = False

    # --- Cycle de vie (appelé depuis le thread Qt principal) ---

    def demarrer(self):
        if self._thread is not None:
            log_reseau_t.warning("demarrer() appelé alors qu'un thread réseau serveurT existe déjà -- ignoré")
            return
        log_reseau_t.info(f"Démarrage du client serveurT (url={self.server_url})")
        self._arret_demande.clear()
        self._thread = threading.Thread(target=self._thread_principal, daemon=True)
        self._thread.start()

    def arreter(self, timeout: float = 3.0):
        """Même logique d'annulation de tâche que ClientReseauAutoniaX.
        arreter() (cf. sa docstring pour le détail du deadlock évité) --
        interrompt immédiatement la boucle en cours (connexion active OU
        attente de retry) plutôt que de laisser le sleep de 10s expirer."""
        if self._thread is None:
            return
        log_reseau_t.info("arreter() : demande d'arrêt du thread réseau serveurT")
        self._arret_demande.set()
        if self._loop is not None and self._loop.is_running() and self._tache_boucle is not None:
            self._loop.call_soon_threadsafe(self._tache_boucle.cancel)
        self._thread.join(timeout=timeout)
        if self._thread.is_alive():
            log_reseau_t.warning(f"Le thread réseau serveurT ne s'est pas arrêté sous {timeout}s")
        self._thread = None

    def forcer_reconnexion(self):
        """AJOUT (cf. docstring de DELAI_TIMEOUT_PONG_SECONDES -- retour
        utilisateur : "pourquoi pas une fois lie avec la logique de ping
        puisque la comande vient de lapp elle meme") -- appelée
        directement par ParametresScreen (bouton "Redémarrer le
        serveurT", via MainWindow, cf. signal demande_redemarrer_
        serveurt) juste après confirmation que le signal de redémarrage
        a bien été écrit sur B2 (ServeurT/stat.json). Contrairement au
        filet de sécurité générique DELAI_TIMEOUT_PONG_SECONDES (qui
        attend un pong manquant pour DÉDUIRE que la connexion est morte),
        ce cas précis N'A PAS besoin de déduire quoi que ce soit : on
        SAIT avec certitude, au moment même du clic, que la connexion
        actuelle va bientôt mourir (le notebook "ServeurT Manager" va
        tuer le process serveur.py sous peu). Fermer immédiatement
        évite d'attendre inutilement les DELAI_TIMEOUT_PONG_SECONDES du
        filet de sécurité générique avant que la reconnexion ne démarre.

        Thread-safe via call_soon_threadsafe, même patron que arreter()
        ci-dessus (self._loop tourne dans le thread réseau dédié, cet
        appel arrive lui du thread Qt principal). Ne fait RIEN si aucune
        connexion n'est active pour l'instant (self._ws is None) : rien
        à fermer, la boucle de retry de _boucle_async se chargera de
        toute façon de la prochaine tentative dès que le nouveau tunnel
        sera prêt, exactement comme pour tout premier démarrage.

        Ferme uniquement self._ws, jamais tache_heartbeat directement --
        la fermeture du websocket suffit : elle fait lever
        ConnectionClosed dans le `async for brut in self._ws` de
        _boucle_async, dont le `finally` annule déjà proprement la tâche
        heartbeat associée (cf. docstring de _boucle_async) -- pas besoin
        de dupliquer cette logique ici."""
        if self._loop is None or not self._loop.is_running() or self._ws is None:
            log_reseau_t.info("forcer_reconnexion() : aucune connexion active, rien à faire.")
            return
        log_reseau_t.info("forcer_reconnexion() : fermeture forcée de la connexion serveurT (redémarrage demandé depuis l'app).")

        async def _fermer():
            with contextlib.suppress(Exception):
                await self._ws.close()

        asyncio.run_coroutine_threadsafe(_fermer(), self._loop)

    def definir_config_stockage(self, config_stockage: dict):
        """Appelé depuis le thread Qt principal (ex : ParametresScreen
        après modification des champs R2 dans les Réglages) -- met à
        jour la config mémorisée ET la renvoie immédiatement au serveurT
        si une connexion est active, sans attendre la prochaine
        reconnexion. Thread-safe via call_soon_threadsafe (cf. arreter()
        pour le même patron)."""
        self._config_stockage = config_stockage or {}
        if self._loop is not None and self._loop.is_running() and self._ws is not None:
            asyncio.run_coroutine_threadsafe(self._envoyer_config_stockage(), self._loop)

