def get_dashboard_html_path() -> Path:
    """AJOUT (demande utilisateur : "je veux creer une page de dashboard a
    part qui sera chargee au demarrage d'un profil, et non la documentation")
    -- chemin du fichier HTML du Dashboard, affiche au demarrage d'une
    instance et apres resetInterface (cf. contenu_page_accueil). Fichier
    PLAT dans get_app_data_dir(), meme niveau que documentation.html.

    DECISION EXPLICITE UTILISATEUR : "surtout n'embarque rien" -- le
    Dashboard N'EST PAS code en dur dans ce script. C'est un fichier que
    l'utilisateur depose lui-meme sur le disque ; le code ne fait que le
    LIRE (cf. lire_dashboard_disque). Pour changer de dashboard, il suffit
    de remplacer ce fichier, sans jamais toucher au code Python."""
    return get_app_data_dir() / "dashboard.html"


def lire_dashboard_disque() -> str:
    """AJOUT (meme demande, cf. get_dashboard_html_path) -- lit le contenu
    de dashboard.html. Retourne une chaine VIDE si le fichier n'existe
    pas, est vide, ou n'a pas pu etre lu (encodage invalide, erreur
    disque) -- meme convention que lire_documentation_disque. C'est a
    l'appelant (contenu_page_accueil) de decider quoi afficher dans ce
    cas : il affiche un court message d'aide (cf.
    _html_dashboard_introuvable), PAS un dashboard de secours code en dur.
    """
    chemin = get_dashboard_html_path()
    if not chemin.exists():
        return ""
    try:
        return chemin.read_text(encoding="utf-8")
    except Exception:
        return ""


def copier_fichier_documentation_presse_papier() -> bool:
    """CORRECTIF (demande explicite utilisateur : "je veux aussi que tu
    modifie la facon dont la documentation est copiee, sa doit copier
    directement le fichier et non le contenue") -- remplace l'ancien
    QGuiApplication.clipboard().setText(lire_documentation_disque())
    (copie du TEXTE du fichier) par une copie du FICHIER lui-même
    (documentation.html, CF_HDROP sous Windows via QMimeData.setUrls) --
    même mécanisme EXACT que NotebookDragHandleCompact._sur_clic/
    ApercuDragHandle._sur_clic (cf. leurs docstrings) : un Ctrl+V colle
    désormais le fichier .html tel quel (dans l'Explorateur, un éditeur,
    ou glissé à une IA acceptant un fichier), plutôt que son contenu
    textuel brut collé comme texte.

    Repli sur l'ancien comportement (copie du TEXTE, éventuellement vide)
    si le fichier n'existe pas encore sur cette machine (aucune
    documentation jamais collée via le bouton "Coller" des Paramètres) ou
    si la copie de fichier échoue pour une raison quelconque (ex. erreur
    disque) -- ne jamais laisser le presse-papier totalement vide/inchangé
    sur un clic "Copier docs", cohérent avec le comportement historique
    "copié" même quand la doc est vide.

    Retourne True si un FICHIER a bien été copié (CF_HDROP), False si le
    repli texte a été utilisé à la place -- purement informatif pour
    l'appelant (le retour visuel "Copié !" reste identique dans les deux
    cas, cf. DocIACopyButton.mousePressEvent/MainWindow._sur_raccourci_
    copier_doc_ia)."""
    chemin = get_documentation_html_path()
    if chemin.exists():
        try:
            mime = QMimeData()
            mime.setUrls([QUrl.fromLocalFile(str(chemin))])
            QGuiApplication.clipboard().setMimeData(mime)
            return True
        except Exception:
            pass
    # Repli (fichier absent ou copie de fichier impossible) -- ancien
    # comportement, jamais un presse-papier laissé dans un état imprévisible.
    QGuiApplication.clipboard().setText(lire_documentation_disque())
    return False


