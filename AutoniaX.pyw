    transition: transform 0.25s ease, box-shadow 0.25s ease, border-color 0.25s ease;
  }
  .carte:hover {
    transform: translateY(-3px);
    border-color: rgba(204,120,92,0.4);
    box-shadow: 0 10px 24px rgba(46,42,38,0.06);
  }
  .carte .icone {
    width: 34px; height: 34px;
    border-radius: 9px;
    background: rgba(204,120,92,0.12);
    color: var(--terracotta-fonce);
    display: flex; align-items: center; justify-content: center;
    font-size: 17px;
    margin-bottom: 14px;
  }
  .carte h3 {
    margin: 0 0 6px;
    font-size: 14.5px;
    font-weight: 600;
    color: var(--encre);
  }
  .carte p {
    margin: 0;
    font-size: 13px;
    line-height: 1.55;
    color: var(--encre-douce);
  }
  .pied {
    display: flex; align-items: center; justify-content: center; gap: 10px;
    font-size: 12.5px;
    color: var(--encre-douce);
    padding-top: 28px;
    border-top: 1px solid var(--trait);
  }
  .pied .etat {
    display: inline-flex; align-items: center; gap: 6px;
  }
  .pied .puce-vivante {
    width: 6px; height: 6px; border-radius: 50%;
    background: #6FA287;
    animation: respirer 2.2s ease-in-out infinite;
  }
  @keyframes respirer {
    0%, 100% { opacity: 1; }
    50% { opacity: 0.35; }
  }
  .id-instance {
    font-family: "Cascadia Code", "Consolas", monospace;
    font-size: 11.5px;
    color: var(--encre-douce);
    opacity: 0.75;
  }
  @media (max-width: 720px) {
    .grille-fonctions { grid-template-columns: 1fr; }
    h1 { font-size: 38px; }
  }

  /* --- Documentation rapide (menu injecté, cf. _generer_html_doc_rapide) --- */
  .lien-doc {
    appearance: none;
    border: none;
    background: none;
    padding: 0;
    font: inherit;
    font-size: 12.5px;
    color: var(--terracotta-fonce);
    text-decoration: underline;
    text-underline-offset: 2px;
    cursor: pointer;
  }
  .lien-doc:hover { color: var(--terracotta); }

  .doc-fond {
    display: none;
    position: fixed; inset: 0;
    background: rgba(46,42,38,0.45);
    z-index: 1000;
    align-items: center; justify-content: center;
    padding: 40px 20px;
  }
  .doc-fond.ouvert { display: flex; }

  .doc-panneau {
    background: var(--creme-carte);
    border: 1px solid var(--trait);
    border-radius: 16px;
    width: 100%; max-width: 860px;
    max-height: 84vh;
    display: flex;
    overflow: hidden;
    box-shadow: 0 24px 60px rgba(46,42,38,0.25);
  }
  /* PATCH (SPEC_GLOBALE_AutoniaX.md, Partie B §3.5/§3.6) -- .doc-nav,
     .doc-nav-titre, .doc-nav button(:hover/.actif), .doc-contenu et
     .doc-contenu-section(.actif) sont RETIRÉS : la navigation à
     sections (Notions/Composants/Instances/Services API/Fonctions/IA)
     n'existe plus, le document HTML collé par l'utilisateur (cf.
     documentation.html, Partie B §2) s'affiche désormais tel quel, en
     un seul bloc scrollable, plutôt qu'en panneaux à onglets internes.
     .doc-panneau-libre/.doc-contenu-libre ci-dessous remplacent ce
     rôle : plus de colonne de nav latérale, le contenu autonome prend
     toute la largeur disponible de .doc-panneau. */
  .doc-panneau-libre {
    display: block;
    overflow-y: auto;
    padding: 26px 30px;
  }
  .doc-contenu-libre {
    /* Le document HTML collé est autonome et gère sa propre mise en
       page -- ce conteneur ne fait que fournir le défilement et la
       marge par rapport au bouton de fermeture (cf. .doc-fermer,
       position absolute par-dessus ce bloc). */
    padding-top: 6px;
  }
  .doc-fermer {
    position: absolute;
    top: 22px;
    right: 24px;
    appearance: none;
    border: 1px solid var(--trait);
    background: var(--creme-carte);
    border-radius: 8px;
    width: 30px; height: 30px;
    font-size: 15px;
    line-height: 1;
    color: var(--encre-douce);
    cursor: pointer;
    flex: none;
    z-index: 1;
  }
  .doc-fermer:hover { border-color: var(--terracotta); color: var(--terracotta-fonce); }
  .doc-intro {
    font-size: 13.5px;
    line-height: 1.6;
    color: var(--encre-douce);
    margin: 0 0 20px;
  }
  .doc-exemple {
    background: var(--encre);
    color: #F5F1EC;
    border-radius: 10px;
    padding: 14px 16px;
    font-family: "Cascadia Code", "Consolas", monospace;
    font-size: 12.5px;
    line-height: 1.6;
    white-space: pre;
    overflow-x: auto;
    margin: 0 0 22px;
  }
  .doc-exemple .com { color: #A9A296; }
  .doc-methode {
    border: 1px solid var(--trait);
    border-radius: 10px;
    padding: 14px 16px;
    margin-bottom: 10px;
    background: #FFFFFF;
  }
  .doc-methode code {
    font-family: "Cascadia Code", "Consolas", monospace;
    font-size: 13px;
    color: var(--terracotta-fonce);
    font-weight: 600;
