        # s'en passe silencieusement dans ce cas (retombe sur l'ancien
        # comportement : ensemble vide par défaut).
        self._orchestrateur_actions_globales: Optional["OrchestrateurActionsGlobalesInstances"] = None

        # AJOUT (spec A.2, bouton "Copier" en masse) -- même patron
        # SÉQUENTIEL EXACT que _file_generation_masse/_file_suppression_
        # masse : un seul get_fingerprint à la fois (requête suivante
        # émise seulement après la réponse réelle -- via _requetes_copie_
        # proprietes, réutilisé tel quel, cf. sa docstring -- de la
        # précédente). _file_copie_masse : (nom_profil, instance_id) --
        # instance_id résolu UNE FOIS au lancement du lot (copié depuis
        # self._profils au moment du clic), jamais relu depuis self.
        # _profils en cours de lot -- si un profil coché change d'état
        # PENDANT le lot (ex. kill manuel entre-temps), la requête déjà
        # en vol pour lui aboutira quand même sur le bon instance_id
        # d'origine (même raisonnement EXACT que id_executant_generation_
        # masse pour la génération en masse).
        self._file_copie_masse: list[tuple[str, str]] = []
        # nom_profil -> texte déjà formaté ("Profil : xxx\n<props>") pour
        # chaque profil déjà traité (succès) dans le lot EN COURS, dans
        # l'ordre d'achèvement -- concaténé en un seul texte au moment
        # de _terminer_copie_masse (UN SEUL setText final, jamais un par
        # profil, cf. décision explicite de la spec).
        self._textes_copie_masse: dict[str, str] = {}
        self._nb_ignores_copie_masse: int = 0
        # Nombre d'échecs get_fingerprint dans le lot EN COURS (distinct
        # des ignorés -- un ignoré est un profil coché mais inactif,
        # jamais interrogé ; un échec est un profil actif interrogé dont
        # la réponse réseau est négative), et nombre total déjà traité
        # (succès + échecs) pour la progression affichée, cf.
        # _sur_resultat_copie_masse/_terminer_copie_masse.
        self._nb_echecs_copie_masse: int = 0
        self._nb_traites_copie_masse: int = 0

        layout = QVBoxLayout(self)
        layout.setContentsMargins(16, 20, 16, 20)
        layout.setSpacing(10)
        layout.setAlignment(Qt.AlignTop)

        # --- En-tête : nom du sAutoniax sélectionné + bouton Rafraîchir ---
        ligne_entete = QHBoxLayout()
        self.label_titre = QLabel("Sélectionnez un sAutoniax à gauche", self)
        self.label_titre.setObjectName("ReglagesTitre")
        self.label_titre.setWordWrap(True)
        ligne_entete.addWidget(self.label_titre, stretch=1)

        self.bouton_rafraichir = QPushButton(self)
        self.bouton_rafraichir.setIcon(qta.icon("mdi6.refresh", color=Mocha.text))
        self.bouton_rafraichir.setText("Rafraîchir")
        self.bouton_rafraichir.setCursor(Qt.PointingHandCursor)
        self.bouton_rafraichir.setEnabled(False)
        self.bouton_rafraichir.clicked.connect(self._sur_clic_rafraichir)
        ligne_entete.addWidget(self.bouton_rafraichir, stretch=0)
        layout.addLayout(ligne_entete)

        self.label_sous_titre = QLabel("", self)
        self.label_sous_titre.setObjectName("PlaceholderSubtitle")
        self.label_sous_titre.setWordWrap(True)
        layout.addWidget(self.label_sous_titre)

        separateur = QFrame(self)
        separateur.setObjectName("ReglagesSeparateur")
        separateur.setFixedHeight(1)
        layout.addWidget(separateur)

        # --- Placeholder (aucun sAutoniax sélectionné) ---
        self.label_placeholder = QLabel(
            "Sélectionnez un sAutoniax dans la liste de gauche pour voir "
            "ses profils (actifs et inactifs) et agir dessus.", self
        )
        self.label_placeholder.setObjectName("PlaceholderSubtitle")
        self.label_placeholder.setWordWrap(True)
        self.label_placeholder.setAlignment(Qt.AlignCenter)
        layout.addWidget(self.label_placeholder, stretch=1)

        # --- REFONTE (retour explicite utilisateur : "tu ne peut pas
        # reflechir comme un designer?" -- la version précédente alignait
        # 5 boutons-texte à plat, chrome identique répété différencié
        # uniquement par la longueur du libellé -- passait à la ligne dès
        # que le panneau se rétrécissait un peu, ou dès que 4+ profils
        # étaient affichés au-dessus) -- un SEUL bouton icône "Sélection"
        # ouvrant un menu (mêmes 4 choix, même patron QMenu/qta.icon que
        # InstancesConnecteesScreen._afficher_menu_executants juste à
        # côté dans ce fichier) + le bouton "Copier" gardé séparé (action
        # distincte, pas un mode de sélection). Largeur FIXE quel que
        # soit le nombre de profils affichés au-dessus -- ne peut plus
        # jamais passer à la ligne. Handlers réutilisés tels quels
        # (_sur_clic_tout_selectionner_profils etc.) -- seule la
        # présentation change, aucune logique de sélection modifiée.
        self._bloc_selection_masse = QWidget(self)
        layout_selection = QHBoxLayout(self._bloc_selection_masse)
        layout_selection.setContentsMargins(0, 0, 0, 0)
        layout_selection.setSpacing(6)
        layout_selection.addStretch(1)

        # REMPLACÉ (retour explicite utilisateur : "sur la mme ligne que le
        # bouton de deroulenemetn atuels" -- le bouton icône unique +
        # QMenu ci-dessus cachait les 4 actions derrière un clic
        # supplémentaire ; remis en 4 boutons-icônes séparés, VISIBLES
        # directement sur cette même ligne horizontale (layout_selection),
        # à côté du bouton "Copier" juste en dessous -- même genre de
        # QToolButton icône-seule + tooltip que "Copier", pas de QMenu.
        # Handlers INCHANGÉS (_sur_clic_tout_selectionner_profils etc.),
        # seule la présentation change, comme pour le menu qu'ils
        # remplacent.
        self.bouton_tout_selectionner_profils = QToolButton(self._bloc_selection_masse)
        self.bouton_tout_selectionner_profils.setIcon(
            qta.icon("mdi6.checkbox-multiple-marked-outline", color=Mocha.subtext0)
        )
        self.bouton_tout_selectionner_profils.setToolTip("Tout sélectionner")
        self.bouton_tout_selectionner_profils.setObjectName("ProfilMenuButton")
        self.bouton_tout_selectionner_profils.setCursor(Qt.PointingHandCursor)
        self.bouton_tout_selectionner_profils.clicked.connect(self._sur_clic_tout_selectionner_profils)
        layout_selection.addWidget(self.bouton_tout_selectionner_profils)

        self.bouton_tout_deselectionner_profils = QToolButton(self._bloc_selection_masse)
        self.bouton_tout_deselectionner_profils.setIcon(
            qta.icon("mdi6.checkbox-multiple-blank-outline", color=Mocha.subtext0)
        )
        self.bouton_tout_deselectionner_profils.setToolTip("Tout désélectionner")
        self.bouton_tout_deselectionner_profils.setObjectName("ProfilMenuButton")
        self.bouton_tout_deselectionner_profils.setCursor(Qt.PointingHandCursor)
        self.bouton_tout_deselectionner_profils.clicked.connect(self._sur_clic_tout_deselectionner_profils)
        layout_selection.addWidget(self.bouton_tout_deselectionner_profils)

        # AJOUT (demande explicite utilisateur : "je veux que tu ajoute
        # parmie les bouton de selection: selectionner les actifs, non
        # actifs") -- filtré sur l'état RÉEL du profil (infos.get("actif"),
        # même source que la colonne "État" de la table, cf. _reconstruire_
        # table), pas sur toutes les lignes sans distinction.
        self.bouton_selectionner_actifs_profils = QToolButton(self._bloc_selection_masse)
        self.bouton_selectionner_actifs_profils.setIcon(qta.icon("mdi6.circle-slice-8", color=Mocha.green))
        self.bouton_selectionner_actifs_profils.setToolTip(
            "Sélectionner les actifs -- coche uniquement les profils actuellement "
            "actifs (état « Actif » de la colonne ci-dessous) -- les profils "
