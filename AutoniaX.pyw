    /* --- Écran TaskConfig : grille de cards des Tasks (Patch demandé :
    "tu a fait ça comme si c'était des services" -- style dédié, distinct
    de #ServiceAPICarte).

    RE-PATCH (retour utilisateur explicite : "unseule gros icone et le
    noms en bas", "pourquoi tu met des contour bizare") -- AUCUN cadre ni
    fond visible au repos : pas de border, pas de background-color. La
    card doit ressembler à une icône de fichier posée sur un bureau, pas
    à une case/carte délimitée. Seul un très léger fond apparaît au
    survol, pour donner un repère visuel de clic sans dessiner de boîte
    en permanence. --- */
    #TaskCarte {{
        background-color: transparent;
        border: none;
        border-radius: {RADIUS}px;
    }}

    #TaskCarte:hover {{
        background-color: {m.surface0};
    }}

    #TaskCarteNom {{
        color: {m.text};
        font-size: 13px;
        font-weight: 600;
    }}

    #TaskCarteMenuButton {{
        background-color: transparent;
        border: none;
        border-radius: {RADIUS}px;
    }}

    #TaskCarteMenuButton:hover {{
        background-color: {m.surface2};
    }}

    /* --- Éditeur de script Task (TaskConfig) : thème Darcula (couleurs
    officielles PyCharm/IntelliJ), fond SOMBRE comme il se doit pour un éditeur de code --
    volontairement distinct du reste de l'app (Mocha), mais jamais de fond
    clair/lumineux pour du texte de code. --- */
    #TaskScriptEditor {{
        background-color: {DarculaTheme.fond};
        color: {DarculaTheme.texte};
        border: 1px solid {DarculaTheme.bordure};
        border-radius: {RADIUS}px;
        padding: 10px;
        selection-background-color: {DarculaTheme.selection};
        selection-color: {DarculaTheme.texte};
    }}

    #TaskScriptEditor:focus {{
        border: 1px solid {DarculaTheme.violet};
    }}

    /* --- Éditeur de code du filtre ComposantLayout (onglet Filtre) --
    AJOUT (demande explicite : "met la coloration qui est utilisée dans
    TaskScriptEditor") : même thème Darcula, même principe (fond sombre
    dédié au code, distinct du reste de l'app Mocha) que #TaskScriptEditor
    ci-dessus -- dupliqué à l'identique plutôt que partagé via une classe
    CSS commune, pour ne rien risquer de casser sur TaskScriptEditor en
    cas de modification future de l'un des deux. --- */
    #CodeFiltreEdit {{
        background-color: {DarculaTheme.fond};
        color: {DarculaTheme.texte};
        border: 1px solid {DarculaTheme.bordure};
        border-radius: {RADIUS}px;
        padding: 10px;
        selection-background-color: {DarculaTheme.selection};
        selection-color: {DarculaTheme.texte};
    }}

    #CodeFiltreEdit:focus {{
        border: 1px solid {DarculaTheme.violet};
    }}

    /* --- Cellules de notebook (TaskConfig, mode notebook) --- */
    #TaskCelluleWidget {{
        background-color: transparent;
        border: none;
    }}

    /* Cellule 0 étiquetée (badge visuel "cellule d'initialisation",
       togglable via CelluleBoutonEtiquette, actif par défaut). */
    #TaskCelluleWidget[epinglee="true"] {{
        background-color: {m.surface0};
        border: 1px solid {m.lavender};
        border-radius: {RADIUS}px;
    }}

    /* Bref surlignage temporaire après un clic dans la colonne "Accès
       rapide" (cf. TaskConfigScreen._sur_clic_acces_rapide) -- signale
       visuellement la cellule visée après le slide, retiré après un court
       délai par un QTimer.singleShot. Prioritaire sur [epinglee="true"]
       (même s'il s'agit de la row 0) grâce à l'ordre de déclaration QSS
       (cette règle vient après). */
    #TaskCelluleWidget[surlignee="true"] {{
        background-color: {m.surface1};
        border: 1px solid {m.yellow};
        border-radius: {RADIUS}px;
    }}

    /* Cellule désactivée (clic droit sur ▶, cf. TaskCellule.active) --
       fond légèrement teinté et bordure discrète en pointillé pour bien
       distinguer visuellement une cellule qui ne s'exécutera plus, sans
       masquer complètement son code (l'utilisateur doit pouvoir le lire
       et le réactiver facilement). */
    #TaskCelluleWidget[celluleDesactivee="true"] {{
        background-color: {m.mantle};
        border: 1px dashed {m.overlay0};
        border-radius: {RADIUS}px;
    }}

    #CelluleBoutonExecuter {{
        background-color: transparent;
        border: none;
