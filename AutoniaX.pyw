            nom_profil = data.get("nom_profil", "")
            type_instance = data.get("type_instance", "")
            proxy_texte = data.get("proxy_texte", "")
            id_pilote = data.get("id_pilote", "")
            contraintes = data.get("contraintes") or {}
            log_reseau_t.info(f"<- demander_creer_profil_sautoniax reçu du pilote (nom_profil={nom_profil!r}, type_instance={type_instance!r})")
            self.creer_profil_sautoniax_demande.emit(nom_profil, type_instance, proxy_texte, id_pilote, contraintes)

        elif data.get("type") == "creer_profil_sautoniax_resultat":
            # Côté PILOTE -- résultat RÉEL de la création (cf. docstring
            # du signal creer_profil_sautoniax_resultat_recu), DIFFUSÉ
            # par le serveur à tous les pilotes (id_executant ajouté) --
            # même raisonnement que demarrer_profil_isole_resultat.
            id_executant = data.get("id_executant", "")
            nom_profil = data.get("nom_profil", "")
            ok = data.get("ok", False)
            message = data.get("message", "")
            if ok:
                log_reseau_t.info(f"<- creer_profil_sautoniax_resultat (ok=True, id_executant={id_executant!r}, nom_profil={nom_profil!r})")
            else:
                log_reseau_t.warning(f"<- creer_profil_sautoniax_resultat (ok=False, id_executant={id_executant!r}, nom_profil={nom_profil!r}) : {message}")
            self.creer_profil_sautoniax_resultat_recu.emit(id_executant, nom_profil, ok, message)

        elif data.get("type") == "sautoniax_pret":
            # AJOUT (spec A.3) -- Côté PILOTE -- DIFFUSÉ par le serveurT à
            # tous les pilotes connectés dès qu'un exécutant a terminé sa
            # connexion/enregistrement (cf. ClientServeurT.envoyer_
            # sautoniax_pret côté exécutant, appelé une seule fois par
            # main_sautoniax juste après la connexion). Consommé par
            # PanneauProprietesSautoniax.sur_sautoniax_pret pour débloquer
            # bouton_generer_profils.
            id_executant = data.get("id_executant", "")
            log_reseau_t.info(f"<- sautoniax_pret (id_executant={id_executant!r})")
            self.sautoniax_pret_recu.emit(id_executant)

        elif data.get("type") == "demander_dupliquer_profil_sautoniax_ack":
            # Côté PILOTE -- réponse à demander_dupliquer_profil_sautoniax().
            # Même contrat que les autres _ack (ok=True = transmission seule).
            ok = data.get("ok", False)
            id_executant = data.get("id_executant", "")
            nom_source = data.get("nom_source", "")
            erreur = data.get("erreur", "")
            if ok:
                log_reseau_t.info(f"<- demander_dupliquer_profil_sautoniax_ack (ok=True, id_executant={id_executant!r}, nom_source={nom_source!r})")
            else:
                log_reseau_t.warning(f"<- demander_dupliquer_profil_sautoniax_ack (ok=False, id_executant={id_executant!r}, nom_source={nom_source!r}) : {erreur}")
            self.demander_dupliquer_profil_sautoniax_resultat.emit(ok, id_executant, nom_source, erreur)

        elif data.get("type") == "demander_supprimer_profil_sautoniax_ack":
            # Côté PILOTE -- réponse à demander_supprimer_profil_
            # sautoniax(). Même contrat que les autres _ack ci-dessus
            # (ok=True confirme seulement la TRANSMISSION).
            ok = data.get("ok", False)
            id_executant = data.get("id_executant", "")
            nom_profil = data.get("nom_profil", "")
            erreur = data.get("erreur", "")
            if ok:
                log_reseau_t.info(f"<- demander_supprimer_profil_sautoniax_ack (ok=True, id_executant={id_executant!r}, nom_profil={nom_profil!r})")
            else:
                log_reseau_t.warning(f"<- demander_supprimer_profil_sautoniax_ack (ok=False, id_executant={id_executant!r}, nom_profil={nom_profil!r}) : {erreur}")
            self.demander_supprimer_profil_resultat.emit(ok, id_executant, nom_profil, erreur)

        elif data.get("type") == "demander_dupliquer_profil_sautoniax":
            # Côté EXÉCUTANT -- ordre reçu du pilote (relayé par serveur.py
            # avec id_pilote). main_sautoniax (_sur_dupliquer_profil_demande)
            # copie le dossier du profil source vers chaque nom cible.
            nom_source = data.get("nom_source", "")
            noms_cibles = data.get("noms_cibles") or []
            id_pilote = data.get("id_pilote", "")
            log_reseau_t.info(f"<- demander_dupliquer_profil_sautoniax reçu du pilote (nom_source={nom_source!r}, n_cibles={len(noms_cibles)})")
            self.dupliquer_profil_sautoniax_demande.emit(nom_source, list(noms_cibles), id_pilote)

        elif data.get("type") == "demander_supprimer_profil_sautoniax":
            # Côté EXÉCUTANT -- ordre reçu du pilote (relayé tel quel par
            # le serveurT, avec id_pilote ajouté -- cf. handler côté
            # serveur.py). main_sautoniax (_sur_supprimer_profil_demande)
            # supprime le dossier sous sautoniax_profils/<nom> + son
            # entrée de config (cf. _sautoniax_supprimer_profil), refuse
            # si le profil est actuellement actif.
            nom_profil = data.get("nom_profil", "")
            id_pilote = data.get("id_pilote", "")
            log_reseau_t.info(f"<- demander_supprimer_profil_sautoniax reçu du pilote (nom_profil={nom_profil!r})")
            self.supprimer_profil_sautoniax_demande.emit(nom_profil, id_pilote)

        elif data.get("type") == "dupliquer_profil_sautoniax_resultat":
            # Côté PILOTE -- résultat RÉEL de la duplication, DIFFUSÉ par le
            # serveur à tous les pilotes (id_executant ajouté).
            id_executant = data.get("id_executant", "")
            nom_source = data.get("nom_source", "")
            ok = data.get("ok", False)
            message = data.get("message", "")
            if ok:
                log_reseau_t.info(f"<- dupliquer_profil_sautoniax_resultat (ok=True, id_executant={id_executant!r}, nom_source={nom_source!r})")
            else:
                log_reseau_t.warning(f"<- dupliquer_profil_sautoniax_resultat (ok=False, id_executant={id_executant!r}, nom_source={nom_source!r}) : {message}")
            self.dupliquer_profil_sautoniax_resultat_recu.emit(id_executant, nom_source, ok, message)

        elif data.get("type") == "supprimer_profil_sautoniax_resultat":
            # Côté PILOTE -- résultat RÉEL de la suppression (cf.
            # docstring du signal supprimer_profil_sautoniax_resultat_
            # recu), DIFFUSÉ par le serveur à tous les pilotes
            # (id_executant ajouté) -- même raisonnement que creer_
            # profil_sautoniax_resultat.
            id_executant = data.get("id_executant", "")
            nom_profil = data.get("nom_profil", "")
            ok = data.get("ok", False)
            message = data.get("message", "")
            if ok:
                log_reseau_t.info(f"<- supprimer_profil_sautoniax_resultat (ok=True, id_executant={id_executant!r}, nom_profil={nom_profil!r})")
            else:
                log_reseau_t.warning(f"<- supprimer_profil_sautoniax_resultat (ok=False, id_executant={id_executant!r}, nom_profil={nom_profil!r}) : {message}")
            self.supprimer_profil_sautoniax_resultat_recu.emit(id_executant, nom_profil, ok, message)

        elif data.get("type") == "demander_regenerer_profil_sautoniax_ack":
            # Côté PILOTE -- ok=True confirme seulement la TRANSMISSION.
            ok = data.get("ok", False)
            id_executant = data.get("id_executant", "")
            nom_profil = data.get("nom_profil", "")
            erreur = data.get("erreur", "")
            if ok:
                log_reseau_t.info(f"<- demander_regenerer_profil_sautoniax_ack (ok=True, id_executant={id_executant!r}, nom_profil={nom_profil!r})")
            else:
                log_reseau_t.warning(f"<- demander_regenerer_profil_sautoniax_ack (ok=False, id_executant={id_executant!r}, nom_profil={nom_profil!r}) : {erreur}")
            self.demander_regenerer_profil_resultat.emit(ok, id_executant, nom_profil, erreur)

        elif data.get("type") == "demander_regenerer_profil_sautoniax":
            # Côté EXÉCUTANT -- ordre relayé par serveur.py (id_pilote ajouté).
            nom_profil = data.get("nom_profil", "")
            id_pilote = data.get("id_pilote", "")
            log_reseau_t.info(f"<- demander_regenerer_profil_sautoniax reçu du pilote (nom_profil={nom_profil!r})")
            self.regenerer_profil_sautoniax_demande.emit(
                nom_profil, bool(data.get("garder_donnees", False)), bool(data.get("relancer", True)), id_pilote,
            )

        elif data.get("type") == "regenerer_profil_sautoniax_resultat":
            # Côté PILOTE -- résultat RÉEL, DIFFUSÉ par le serveur (id_executant ajouté).
            id_executant = data.get("id_executant", "")
            nom_profil = data.get("nom_profil", "")
            ok = data.get("ok", False)
            message = data.get("message", "")
            instance_id = data.get("instance_id", "")
            if ok:
                log_reseau_t.info(f"<- regenerer_profil_sautoniax_resultat (ok=True, id_executant={id_executant!r}, nom_profil={nom_profil!r}, instance_id={instance_id!r})")
            else:
                log_reseau_t.warning(f"<- regenerer_profil_sautoniax_resultat (ok=False, id_executant={id_executant!r}, nom_profil={nom_profil!r}) : {message}")
            self.regenerer_profil_sautoniax_resultat_recu.emit(id_executant, nom_profil, ok, message, instance_id)

        elif data.get("type") == "demander_telecharger_profil_vers_sautoniax_ack":
            # Côté PILOTE -- réponse à demander_telecharger_profil_vers_
            # sautoniax(). Même contrat que les autres _ack ci-dessus
            # (ok=True confirme seulement la TRANSMISSION).
            ok = data.get("ok", False)
            id_executant = data.get("id_executant", "")
            nom_profil = data.get("nom_profil", "")
            erreur = data.get("erreur", "")
            if ok:
                log_reseau_t.info(f"<- demander_telecharger_profil_vers_sautoniax_ack (ok=True, id_executant={id_executant!r}, nom_profil={nom_profil!r})")
            else:
                log_reseau_t.warning(f"<- demander_telecharger_profil_vers_sautoniax_ack (ok=False, id_executant={id_executant!r}, nom_profil={nom_profil!r}) : {erreur}")
            self.demander_telecharger_profil_vers_sautoniax_resultat.emit(ok, id_executant, nom_profil, erreur)

        elif data.get("type") == "demander_telecharger_profil_vers_sautoniax":
            # Côté EXÉCUTANT -- ordre reçu du pilote (relayé tel quel par
            # le serveurT, avec id_pilote ajouté -- cf. handler côté
            # serveur.py). main_sautoniax (_sur_telecharger_profil_vers_
            # sautoniax_demande) appelle _sautoniax_assurer_profil_local
            # pour ce profil, réutilisée telle quelle.
            nom_profil = data.get("nom_profil", "")
            id_pilote = data.get("id_pilote", "")
            log_reseau_t.info(f"<- demander_telecharger_profil_vers_sautoniax reçu du pilote (nom_profil={nom_profil!r})")
            self.telecharger_profil_vers_sautoniax_demande.emit(nom_profil, id_pilote)

        elif data.get("type") == "demander_liste_profils_locaux_sautoniax":
            # Côté EXÉCUTANT -- ordre reçu du pilote (relayé tel quel par
            # le serveurT, avec id_pilote ajouté). Liste le contenu du
            # dossier local sautoniax_profils (même dossier que _sautoniax_
            # assurer_profil_local, cf. sa docstring) -- un sous-dossier
            # non vide = un profil "présent" sur ce sAutoniax. Fait
            # directement ici (lecture disque quasi instantanée, pas
            # besoin de déporter via run_in_executor comme un
            # téléchargement réseau) plutôt que via un signal Qt vers
            # main_sautoniax -- rien d'autre à orchestrer pour cette
            # opération, contrairement à telecharger_profil_vers_
            # sautoniax_demande (téléchargement réseau + extraction zip).
            id_pilote = data.get("id_pilote", "")
            try:
                dossier_profils_sautoniax = _chemin_donnees("sautoniax_profils")
                if dossier_profils_sautoniax.exists():
                    profils = sorted(
                        p.name for p in dossier_profils_sautoniax.iterdir()
                        if p.is_dir() and any(p.iterdir())
                    )
                else:
                    profils = []
                log_reseau_t.info(f"<- demander_liste_profils_locaux_sautoniax reçu du pilote -- {len(profils)} profil(s) local/locaux")
                self.envoyer_liste_profils_locaux_sautoniax_resultat(id_pilote, True, profils)
            except Exception as e:
                log_reseau_t.warning(f"Échec listage profils locaux sAutoniax : {e!r}")
                self.envoyer_liste_profils_locaux_sautoniax_resultat(id_pilote, False, [], str(e))

        elif data.get("type") == "liste_profils_locaux_sautoniax_resultat":
            # Côté PILOTE -- résultat RÉEL (cf. docstring du signal
            # liste_profils_locaux_sautoniax_resultat_recu), relayé
            # DIRECTEMENT par le serveur au pilote demandeur (id_executant
            # ajouté, PAS une diffusion).
            id_executant = data.get("id_executant", "")
            ok = data.get("ok", False)
            profils = data.get("profils", [])
            erreur = data.get("erreur", "")
            self.liste_profils_locaux_sautoniax_resultat_recu.emit(id_executant, ok, profils, erreur)

        elif data.get("type") == "telecharger_profil_vers_sautoniax_progression":
            # Côté PILOTE -- progression RÉELLE du téléchargement en
            # cours sur le sAutoniax visé (cf. docstring du signal
            # telecharger_profil_vers_sautoniax_progression_recu),
            # relayée DIRECTEMENT par le serveur (id_executant ajouté).
            id_executant = data.get("id_executant", "")
            nom_profil = data.get("nom_profil", "")
            pourcentage = data.get("pourcentage", -1)
            self.telecharger_profil_vers_sautoniax_progression_recu.emit(id_executant, nom_profil, pourcentage)

        elif data.get("type") == "telecharger_profil_vers_sautoniax_resultat":
            # Côté PILOTE -- résultat RÉEL du téléchargement (cf. docstring
            # du signal telecharger_profil_vers_sautoniax_resultat_recu),
            # relayé DIRECTEMENT par le serveur au pilote demandeur
            # (id_executant ajouté, PAS une diffusion).
            id_executant = data.get("id_executant", "")
            nom_profil = data.get("nom_profil", "")
            ok = data.get("ok", False)
            message = data.get("message", "")
            if ok:
                log_reseau_t.info(f"<- telecharger_profil_vers_sautoniax_resultat (ok=True, id_executant={id_executant!r}, nom_profil={nom_profil!r})")
            else:
                log_reseau_t.warning(f"<- telecharger_profil_vers_sautoniax_resultat (ok=False, id_executant={id_executant!r}, nom_profil={nom_profil!r}) : {message}")
            self.telecharger_profil_vers_sautoniax_resultat_recu.emit(id_executant, nom_profil, ok, message)

        elif data.get("type") in (
            "envoyer_projet_vers_sautoniax_debut_ack",
            "envoyer_projet_vers_sautoniax_chunk_ack",
            "mettre_a_jour_service_api_debut_ack",
            "mettre_a_jour_service_api_chunk_ack",
            "mettre_a_jour_project_json_debut_ack",
            "mettre_a_jour_project_json_chunk_ack",
        ):
            # Côté PILOTE -- _envoyer_projet_vers_sautoniax,
            # _mettre_a_jour_service_api ET _mettre_a_jour_project_json
            # ATTENDENT chacun de ces accusés (via _attendre_ack_session)
            # avant de continuer, même patron que _future_ack_profil pour
            # l'envoi de profil -- on résout juste la Future
            # correspondante, toute l'interprétation reste dans
            # _envoyer_projet_vers_sautoniax / _mettre_a_jour_service_api /
            # _mettre_a_jour_project_json.
            # CORRECTIF (bug identifié : "Échec mise à jour service API
            # vers '<id>' : TimeoutError()" systématique après 30s) --
            # avant ce patch, seuls les deux types
            # envoyer_projet_vers_sautoniax_*_ack étaient routés ici ;
            # les acks mettre_a_jour_service_api_debut_ack/_chunk_ack
            # envoyés par serveur.py (cf. mettre_a_jour_service_api_debut/
            # _chunk côté serveur) n'étaient traités par AUCUNE branche de
            # cette chaîne if/elif, donc silencieusement ignorés : la
            # Future créée par _attendre_ack_session n'était jamais
            # résolue et expirait systématiquement au bout des 30s de
            # timeout, quel que soit l'état réel du transfert côté
            # sAutoniax.
            session_id = data.get("session_id", "")
            future = self._future_ack_par_session.get(session_id)
            if future is not None and not future.done():
                future.set_result(data)
            else:
                log_reseau_t.warning(f"Ack de session sans Future en attente (perdu) : session={session_id!r} type={data.get('type')!r}")

        elif data.get("type") == "envoyer_projet_vers_sautoniax_debut":
            # Côté EXÉCUTANT -- début d'un transfert de projet reçu d'un
            # pilote (relayé par le serveurT, qui y ajoute id_pilote --
            # cf. handler serveur.py). On initialise juste l'état
            # d'assemblage indexé par session_id ; l'écriture réelle des
            # chunks a lieu dans le bloc _chunk ci-dessous, l'assemblage
            # final (dézippage) dans le bloc _fin. Écriture incrémentale
            # sur disque au fil des chunks (même principe que
            # _telecharger_fichier), jamais accumulé en mémoire.
            session_id = data.get("session_id", "")
            chemin_zip = Path(tempfile.gettempdir()) / f"autoniax_projet_recu_{session_id}.zip"
            try:
                chemin_zip.parent.mkdir(parents=True, exist_ok=True)
                f = open(chemin_zip, "wb")
            except Exception as e:
                log_reseau_t.warning(f"Échec ouverture fichier de réception projet (session={session_id}) : {e!r}")
                return
            self._reception_chunks_par_session[session_id] = {
                "type": "projet", "fichier": f, "chemin_zip": chemin_zip,
                "nom_projet": data.get("nom_projet", ""),
                "profils": data.get("profils", []),
                "nb_chunks": data.get("nb_chunks", 0),
                "id_pilote": data.get("id_pilote", ""),
            }
            log_reseau_t.info(
                f"<- envoyer_projet_vers_sautoniax_debut reçu ('{data.get('nom_projet', '')}', "
                f"session={session_id}, {data.get('nb_chunks', 0)} chunk(s) attendu(s))"
            )

        elif data.get("type") == "demander_retelechargement_service_api":
            # AJOUT (migration "Mettre à jour" vers Drive direct --
            # demande explicite utilisateur : "le serveur envoie juste un
            # message de retélarchement au sautoniax, il le retélécharge
            # eux même directement sur le cloud. plus de envoie autonome
            # de fichier du serveur vers les sautoniax"). REMPLACE
            # ENTIÈREMENT l'ancien protocole en chunks
            # mettre_a_jour_service_api_debut/_chunk/_fin : plus aucun
            # octet de fichier n'est reçu ici, juste ce signal léger
            # (relayé par le serveur, qui y ajoute id_pilote -- cf.
            # handler serveur.py, point ouvert 4 de la spec). Le
            # téléchargement + l'application (dézippage + remplacement
            # atomique, EXACTEMENT la même logique qu'avant, cf.
            # _sautoniax_appliquer_service_api_recu) sont délégués à une
            # tâche de fond (create_task, pas d'await ici : _traiter_
            # message est synchrone, ne doit jamais bloquer sur un
            # téléchargement qui peut prendre plusieurs secondes).
            id_pilote = data.get("id_pilote", "")
            log_reseau_t.info(f"<- demander_retelechargement_service_api reçu (id_pilote={id_pilote!r})")
            asyncio.create_task(
                _sautoniax_retelecharger_et_appliquer_service_api(self, self._loop, id_pilote)
            )

        elif data.get("type") == "demander_retelechargement_project_json":
            # AJOUT -- miroir EXACT de demander_retelechargement_service_api
            # ci-dessus, pour project.json. Remplace ENTIÈREMENT l'ancien
            # protocole en chunks mettre_a_jour_project_json_debut/_chunk/
            # _fin.
            id_pilote = data.get("id_pilote", "")
            log_reseau_t.info(f"<- demander_retelechargement_project_json reçu (id_pilote={id_pilote!r})")
            asyncio.create_task(
                _sautoniax_retelecharger_et_appliquer_project_json(self, self._loop, id_pilote)
            )

        elif data.get("type") == "envoyer_projet_vers_sautoniax_chunk":
            # Côté EXÉCUTANT -- écrit CE chunk directement sur disque
            # (jamais accumulé en mémoire, cf. docstring _debut ci-dessus)
            # dans le fichier ouvert par le bloc _debut correspondant.
            # Aucun accusé renvoyé au serveurT ici (contrairement au sens
            # pilote->serveur, cf. serveur.py : c'est le PILOTE qui
            # attend un accusé du serveur à chaque chunk envoyé, pas
            # l'exécutant qui reçoit -- rien à confirmer de ce côté-ci,
            # le relais WebSocket réussi suffit).
            session_id = data.get("session_id", "")
            reception = self._reception_chunks_par_session.get(session_id)
            if reception is None:
                log_reseau_t.warning(f"Chunk reçu pour une session inconnue/expirée (session={session_id}) -- ignoré")
                return
            try:
                reception["fichier"].write(base64.b64decode(data.get("contenu_b64", "")))
            except Exception as e:
                log_reseau_t.warning(f"Échec écriture chunk (session={session_id}, index={data.get('index')}) : {e!r}")

        elif data.get("type") == "envoyer_projet_vers_sautoniax_fin":
            # Côté EXÉCUTANT -- ferme le fichier assemblé, le dézippe dans
            # un dossier de travail dédié à la session, puis émet
            # projet_sautoniax_recu avec le chemin assemblé -- à charge de
            # main_sautoniax (Patch 4.4.c) de démarrer les profils requis
            # et de lancer le traitement.
            session_id = data.get("session_id", "")
            reception = self._reception_chunks_par_session.pop(session_id, None)
            if reception is None:
                log_reseau_t.warning(f"envoyer_projet_vers_sautoniax_fin pour une session inconnue (session={session_id}) -- ignoré")
                return
            reception["fichier"].close()
            chemin_zip = reception["chemin_zip"]
            chemin_extrait = Path(tempfile.gettempdir()) / f"autoniax_projet_assemble_{session_id}"
            try:
                shutil.unpack_archive(str(chemin_zip), str(chemin_extrait), "zip")
                log_reseau_t.info(
                    f"<- projet '{reception['nom_projet']}' assemblé (session={session_id}) -> {chemin_extrait}"
                )
                self.projet_sautoniax_recu.emit(
                    session_id, reception["nom_projet"], reception["profils"],
                    str(chemin_extrait), reception["id_pilote"],
                )
            except Exception as e:
                log_reseau_t.warning(f"Échec assemblage projet reçu (session={session_id}) : {e!r}")
            finally:
                chemin_zip.unlink(missing_ok=True)

        elif data.get("type") == "mettre_a_jour_project_json_resultat":
            # Côté PILOTE -- résultat final (succès/échec de l'application
            # LOCALE côté sAutoniax), même patron EXACT que
            # mettre_a_jour_service_api_resultat ci-dessous.
            ok = data.get("ok", False)
            id_executant = data.get("id_executant", "")
            message_txt = data.get("message", "")
            if ok:
                log_reseau_t.info(f"<- mettre_a_jour_project_json_resultat (ok=True, id_executant={id_executant!r})")
            else:
                log_reseau_t.warning(f"<- mettre_a_jour_project_json_resultat (ok=False, id_executant={id_executant!r}) : {message_txt}")
            self.mise_a_jour_project_json_resultat.emit(ok, id_executant, message_txt)

        elif data.get("type") == "mettre_a_jour_service_api_resultat":
            # Côté PILOTE -- résultat final (succès/échec de l'application
            # LOCALE côté sAutoniax, cf. _sautoniax_appliquer_service_api_
            # recu et _sautoniax_retelecharger_et_appliquer_service_api,
            # sens exécutant) : (ok, id_executant, message). Handler
            # inchangé par la migration Drive direct -- seule la manière
            # dont l'exécutant obtient le fichier a changé, ce message de
            # retour reste identique.
            ok = data.get("ok", False)
            id_executant = data.get("id_executant", "")
            message_txt = data.get("message", "")
            if ok:
                log_reseau_t.info(f"<- mettre_a_jour_service_api_resultat (ok=True, id_executant={id_executant!r})")
            else:
                log_reseau_t.warning(f"<- mettre_a_jour_service_api_resultat (ok=False, id_executant={id_executant!r}) : {message_txt}")
            self.mise_a_jour_service_api_resultat.emit(ok, id_executant, message_txt)

        elif data.get("type") in ("retour_projet_execute_debut", "retour_projet_execute_chunk", "retour_projet_execute_fin"):
            # Côté PILOTE -- retour du projet exécuté, sens EXÉCUTANT ->
            # pilote (Patch 4.4.d). Même patron d'assemblage par chunks
            # que la réception côté exécutant ci-dessus, indexé par
            # session_id (le serveurT y ajoute id_executant, cf. handler
            # serveur.py). Best-effort côté envoi (pas d'accusé attendu
            # par l'exécutant, cf. _envoyer_retour_projet_execute) --
            # cette réception-ci reste néanmoins robuste à une session
            # inconnue/déjà nettoyée.
            type_msg = data["type"]
            session_id = data.get("session_id", "")
            id_executant = data.get("id_executant", "")
            if type_msg == "retour_projet_execute_debut":
                chemin_zip = Path(tempfile.gettempdir()) / f"autoniax_retour_projet_{session_id}.zip"
                try:
                    chemin_zip.parent.mkdir(parents=True, exist_ok=True)
                    f = open(chemin_zip, "wb")
                except Exception as e:
                    log_reseau_t.warning(f"Échec ouverture fichier de retour projet (session={session_id}) : {e!r}")
                    return
                self._reception_chunks_par_session[session_id] = {
                    "type": "retour_projet", "fichier": f, "chemin_zip": chemin_zip,
                    "id_executant": id_executant, "nb_chunks": data.get("nb_chunks", 0),
                }
                self.retour_projet_execute_progression.emit(session_id, 0)
                log_reseau_t.info(f"<- retour_projet_execute_debut reçu (session={session_id}, id_executant={id_executant!r})")
            elif type_msg == "retour_projet_execute_chunk":
                reception = self._reception_chunks_par_session.get(session_id)
                if reception is None:
                    log_reseau_t.warning(f"retour_projet_execute_chunk pour une session inconnue (session={session_id}) -- ignoré")
                    return
                try:
                    reception["fichier"].write(base64.b64decode(data.get("contenu_b64", "")))
                    nb_chunks = reception.get("nb_chunks", 0)
                    index = data.get("index")
                    if isinstance(index, int) and nb_chunks:
                        self.retour_projet_execute_progression.emit(session_id, round((index + 1) / nb_chunks * 100))
                except Exception as e:
                    log_reseau_t.warning(f"Échec écriture chunk retour projet (session={session_id}) : {e!r}")
            elif type_msg == "retour_projet_execute_fin":
                reception = self._reception_chunks_par_session.pop(session_id, None)
                if reception is None:
                    log_reseau_t.warning(f"retour_projet_execute_fin pour une session inconnue (session={session_id}) -- ignoré")
                    return
                reception["fichier"].close()
                chemin_zip = reception["chemin_zip"]
                chemin_extrait = Path(tempfile.gettempdir()) / f"autoniax_retour_projet_assemble_{session_id}"
                try:
                    shutil.unpack_archive(str(chemin_zip), str(chemin_extrait), "zip")
                    log_reseau_t.info(f"<- retour projet assemblé (session={session_id}) -> {chemin_extrait}")
                    self.retour_projet_execute_recu.emit(session_id, reception["id_executant"], str(chemin_extrait))
                except Exception as e:
                    log_reseau_t.warning(f"Échec assemblage retour projet (session={session_id}) : {e!r}")
                finally:
                    chemin_zip.unlink(missing_ok=True)
                    # PATCH E -- débloque _sequencer_batch s'il attendait
                    # la fin de CE ProjetBatch précis pour envoyer le
                    # suivant du même batch (cf. _future_fin_projet_par_
                    # session dans __init__). Résolu même en cas
                    # d'exception ci-dessus (finally) : un assemblage
                    # raté ne doit jamais bloquer le séquenceur
                    # indéfiniment -- le batch continue avec le
                    # ProjetBatch suivant plutôt que de rester figé sur
                    # une erreur locale d'assemblage, distincte d'un
                    # échec d'exécution côté sAutoniax.
                    future = self._future_fin_projet_par_session.pop(session_id, None)
                    if future is not None and not future.done():
                        future.set_result(True)

        elif data.get("type") == "projet_distant_progression":
            # Côté PILOTE -- suivi temps réel d'un projet en cours de
            # traitement à distance (Patch 4.4.b). Message UNIQUE (pas en
            # chunks, contrairement à retour_projet_execute_* -- des
            # compteurs + une petite liste (numero, statut), jamais un
            # fichier volumineux), relayé tel quel par le serveurT avec
            # id_executant ajouté (même patron que notebook_distant_
            # resultat/mettre_a_jour_service_api_resultat). Best-effort :
            # aucune erreur ne doit interrompre la boucle de réception si
            # le message est malformé.
            self.projet_distant_progression_recu.emit(
                data.get("session_id", ""),
                data.get("id_executant", ""),
                data.get("total", 0),
                data.get("traites", 0),
                data.get("en_echec", 0),
                data.get("restants", 0),
                [tuple(x) for x in data.get("statuts_sous_projets", [])],
            )

        elif data.get("type") == "instances_projet":
            # PATCH E.1 -- côté PILOTE, cf. envoyer_instances_projet côté
            # sAutoniax pour le pourquoi de ce message dédié. Message
            # UNIQUE (comme projet_distant_progression, pas de chunking --
            # un dict nom_profil -> instance_id de quelques dizaines
            # d'entrées au plus reste minuscule). Relayé tel quel par le
            # serveurT avec id_executant ajouté, même patron exact que
            # projet_distant_progression ci-dessus.
            self.instances_projet_recu.emit(
                data.get("session_id", ""),
                data.get("id_executant", ""),
                dict(data.get("instances", {})),
            )

        elif data.get("type") == "executer_notebook_distant_ack":
            # Côté PILOTE -- accusé de transmission (pas d'exécution --
            # cf. notebook_distant_log_recu/notebook_distant_resultat_recu
            # pour le vrai retour). Un ok=False ici (ex. exécutant
            # introuvable) est traité comme un résultat final d'échec
            # immédiat, puisqu'aucun notebook_distant_resultat ne
            # viendra jamais dans ce cas.
            ok = data.get("ok", False)
            id_executant = data.get("id_executant", "")
            session_id = data.get("session_id", "")
            if ok:
                log_reseau_t.info(f"<- executer_notebook_distant_ack (ok=True, session={session_id})")
            else:
                erreur = data.get("erreur", "Erreur inconnue")
                log_reseau_t.warning(f"<- executer_notebook_distant_ack (ok=False, session={session_id}) : {erreur}")
                # AJOUT (spec B.2) -- ack négatif = aucune exécution n'aura
                # jamais lieu (cf. docstring ci-dessus), pas d'horodatage réel.
                self.notebook_distant_resultat_recu.emit(session_id, id_executant, False, erreur, None, None, None, None)

        elif data.get("type") == "executer_notebook_distant":
            # Côté EXÉCUTANT -- demande d'exécution reçue (relayée par le
            # serveurT, qui y ajoute id_pilote, cf. handler serveur.py) :
            # à charge de main_sautoniax (connecté à ce signal) d'exécuter
            # `code` sur `profil_nom` et d'appeler envoyer_notebook_distant_
            # log/_resultat au fil de l'exécution.
            session_id = data.get("session_id", "")
            profil_nom = data.get("profil_nom", "")
            code = data.get("code", "")
            id_pilote = data.get("id_pilote", "")
            # CORRECTIF (retour explicite utilisateur -- "je veux le
            # filtrage precis comme en local") : {nom_service_api:
            # instance_id/id_executant} des ServiceAPI RÉELLEMENT liés
            # pour CE Task précis (même forme et même filtre que
            # Task.services_api_importes côté mode local, cf. docstring
            # de _construire_composants_direct) -- {} par défaut (message
            # envoyé par un ancien mAutoniax pas encore mis à jour, ou
            # notebook distant manuel sans aucun Task/ServiceAPI associé)
            # -- {} = aucun Composant chargé côté sAutoniax (jamais "tous
            # par défaut", cf. docstring de _construire_composants_direct).
            services_api_lies = data.get("services_api_lies") or {}
            log_reseau_t.info(
                f"<- executer_notebook_distant reçu (session={session_id}, profil={profil_nom!r})"
            )
            # LOG CIBLÉ (diagnostic .visible()/AttributeError) -- contenu
            # RÉEL reçu par le websocket côté sAutoniax, avant tout
            # traitement : si différent de ce qui a été loggé côté
            # mAutoniax au moment de l'envoi, le problème est dans le
            # transport réseau/serveurT (relais). S'il est identique mais
            # vide ici alors qu'il ne l'était pas côté mAutoniax, le
            # problème est côté serveurT (relais qui perd le champ).
            log_reseau_t.info(
                f"<- executer_notebook_distant (session={session_id}) : services_api_lies reçu = {services_api_lies!r} "
                f"(brut data.get('services_api_lies') = {data.get('services_api_lies')!r})"
            )
            # AJOUT (SPEC_lot_corrections_2026-09.md section 11) -- .get(
            # ..., False) : reste False (comportement inchangé, aucune
            # réinitialisation/lecture de result_color) si un ancien
            # mAutoniax pas encore mis à jour n'envoie pas ces champs
            # (JSON absent, pas seulement False explicite).
            reinitialiser_result_color = data.get("reinitialiser_result_color", False)
            lire_result_color_finale = data.get("lire_result_color_finale", False)
            self._sessions_actives[session_id] = id_pilote   # signalée au pilote par « sessions_vivantes »
            self.executer_notebook_distant_demande.emit(
                session_id, profil_nom, code, id_pilote, services_api_lies,
                reinitialiser_result_color, lire_result_color_finale,
            )

        elif data.get("type") == "notebook_distant_log":
            # Côté PILOTE -- une ligne de stdout/stderr au fil de l'eau
            # (cf. §4.5 : "indicateurs de statut en temps réel"), le
            # serveurT y ajoute id_executant.
            session_id = data.get("session_id", "")
            id_executant = data.get("id_executant", "")
            ligne = data.get("ligne", "")
            self.notebook_distant_log_recu.emit(session_id, id_executant, ligne)

        elif data.get("type") == "pont_pilote_reponse":
            # AJOUT (pont fichiers pilote <-> clone) -- côté EXÉCUTANT : réponse du pilote (relayée par le serveurT).
            if data.get("ack_uid"):
                self._garantie_acquitter(str(data["ack_uid"]))   # accusé d'un message à livraison garantie
            else:
                _pont_diag_detail(f"[PONT-DIAG] (clone) réponse reçue rid={str(data.get('rid'))[:8]} ok={data.get('ok')} -> signal Qt vers le thread principal")
                self.pont_reponse_recue.emit(data)

        elif data.get("type") == "notebook_distant_image":
            # AJOUT (demande explicite utilisateur : "je veux que le
            # terminal affiche aussi les images") -- côté PILOTE, même
            # patron EXACT que notebook_distant_log ci-dessus, mais
            # image_b64 au lieu de ligne (cf. Image.view()/
            # envoyer_notebook_distant_image).
            if self._pilote_acquitter(data):
                return   # doublon d'un message à livraison garantie : déjà appliqué
            session_id = data.get("session_id", "")
            id_executant = data.get("id_executant", "")
            image_b64 = data.get("image_b64", "")
            if isinstance(image_b64, str) and image_b64.startswith(MARQUEUR_PONT_REQUETE):
                _diag_pont_ws(image_b64[len(MARQUEUR_PONT_REQUETE):])
            self.notebook_distant_image_recu.emit(session_id, id_executant, image_b64)

        elif data.get("type") == "notebook_distant_resultat":
            # Côté PILOTE -- résultat final (unique) de l'exécution.
            if self._pilote_acquitter(data):
                return   # doublon (renvoi après coupure) : déjà appliqué
            session_id = data.get("session_id", "")
            self._sessions_attendues.pop(session_id, None)
            id_executant = data.get("id_executant", "")
            ok = data.get("ok", False)
            message_txt = data.get("message", "")
            # AJOUT (spec B.2, colonne "Temps") -- timestamps Unix RÉELS,
            # mesurés côté sAutoniax autour de l'exécution réelle de la
            # cellule uniquement (cf. envoyer_notebook_distant_resultat/
            # _sautoniax_executer_notebook_distant_sur_instance_isolee).
            # .get(...) plutôt qu'un accès direct : reste None (valeur par
            # défaut du signal, cf. sa déclaration) pour un ancien
            # sAutoniax pas encore mis à jour qui n'enverrait pas ces
            # champs -- JSON absent, pas seulement null.
            horodatage_debut = data.get("horodatage_debut")
            horodatage_fin = data.get("horodatage_fin")
            # AJOUT (SPEC_lot_corrections_2026-09.md section 11) -- même
            # patron EXACT que horodatage_debut/fin ci-dessus : .get(...)
            # reste None (valeur par défaut du signal) pour un ancien
            # sAutoniax pas encore mis à jour, ou pour le résultat d'une
            # cellule qui n'était pas la dernière du lot (cf. envoyer_
            # notebook_distant_resultat, result_color=None dans ces cas).
            result_color = data.get("result_color")
            # AJOUT (transfert RESULT_OUTPUT) -- None pour un ancien sAutoniax.
            result_output = data.get("result_output")
            _sync_diag_reception(session_id, ok, _sync_diag_t_entree, data)  # [SYNC-DIAG]
            if ok:
                log_reseau_t.info(f"<- notebook_distant_resultat (ok=True, session={session_id})")
            else:
                log_reseau_t.warning(f"<- notebook_distant_resultat (ok=False, session={session_id}) : {message_txt}")
            self.notebook_distant_resultat_recu.emit(
                session_id, id_executant, ok, message_txt, horodatage_debut, horodatage_fin,
                result_color, result_output,
            )

        elif data.get("type") == "initialiser_notebook_distant_ack":
            # PATCH (bouton "Initialiser") -- côté PILOTE, même patron
            # EXACT que executer_notebook_distant_ack ci-dessus : accusé de
            # TRANSMISSION seulement (pas de chargement effectif -- cf.
            # initialiser_notebook_distant_log_recu/_resultat_recu pour le
            # vrai retour). ok=False ici = échec immédiat définitif,
            # puisqu'aucun initialiser_notebook_distant_resultat ne
            # viendra jamais dans ce cas (ex. sAutoniax introuvable).
            ok = data.get("ok", False)
            id_executant = data.get("id_executant", "")
            session_id = data.get("session_id", "")
            if ok:
                log_reseau_t.info(f"<- initialiser_notebook_distant_ack (ok=True, session={session_id})")
            else:
                erreur = data.get("erreur", "Erreur inconnue")
                log_reseau_t.warning(f"<- initialiser_notebook_distant_ack (ok=False, session={session_id}) : {erreur}")
                self.initialiser_notebook_distant_resultat_recu.emit(session_id, id_executant, False, erreur)

        elif data.get("type") == "initialiser_notebook_distant":
            # PATCH (bouton "Initialiser") -- côté EXÉCUTANT, demande de
            # chargement de profil reçue (relayée par le serveurT, qui y
            # ajoute id_pilote) : à charge de main_sautoniax (connecté à ce
            # signal) de télécharger/charger `profil_nom` (cf. _sautoniax_
            # initialiser_notebook_distant) et d'appeler envoyer_
            # initialiser_notebook_distant_log/_resultat au fil de l'opération.
            session_id = data.get("session_id", "")
            profil_nom = data.get("profil_nom", "")
            id_pilote = data.get("id_pilote", "")
            log_reseau_t.info(
                f"<- initialiser_notebook_distant reçu (session={session_id}, profil={profil_nom!r})"
            )
            self.initialiser_notebook_distant_demande.emit(session_id, profil_nom, id_pilote)

        elif data.get("type") == "initialiser_notebook_distant_log":
            # PATCH (bouton "Initialiser") -- côté PILOTE, une ligne de
            # progression au fil de l'eau (téléchargement du profil,
            # lancement de Camoufox), même patron que notebook_distant_log.
            session_id = data.get("session_id", "")
            id_executant = data.get("id_executant", "")
            ligne = data.get("ligne", "")
            self.initialiser_notebook_distant_log_recu.emit(session_id, id_executant, ligne)

        elif data.get("type") == "initialiser_notebook_distant_resultat":
            # PATCH (bouton "Initialiser") -- côté PILOTE, résultat final
            # (unique) du chargement du profil : ok=True signifie que la
            # page Camoufox est prête côté sAutoniax et que le bouton
            # "Exécuter" peut être débloqué.
            session_id = data.get("session_id", "")
            id_executant = data.get("id_executant", "")
            ok = data.get("ok", False)
            message_txt = data.get("message", "")
            if ok:
                log_reseau_t.info(f"<- initialiser_notebook_distant_resultat (ok=True, session={session_id})")
            else:
                log_reseau_t.warning(f"<- initialiser_notebook_distant_resultat (ok=False, session={session_id}) : {message_txt}")
            self.initialiser_notebook_distant_resultat_recu.emit(session_id, id_executant, ok, message_txt)

        elif data.get("type") == "fermer_notebook_distant_ack":
            # PATCH (bouton "Fermer") -- côté PILOTE, même patron EXACT que
            # initialiser_notebook_distant_ack ci-dessus : accusé de
            # TRANSMISSION seulement. ok=False ici = échec immédiat
            # définitif (ex. sAutoniax introuvable) -- aucun fermer_
            # notebook_distant_resultat ne viendra jamais dans ce cas.
            ok = data.get("ok", False)
            id_executant = data.get("id_executant", "")
            session_id = data.get("session_id", "")
            if ok:
                log_reseau_t.info(f"<- fermer_notebook_distant_ack (ok=True, session={session_id})")
            else:
                erreur = data.get("erreur", "Erreur inconnue")
                log_reseau_t.warning(f"<- fermer_notebook_distant_ack (ok=False, session={session_id}) : {erreur}")
                self.fermer_notebook_distant_resultat_recu.emit(session_id, id_executant, False, erreur)

        elif data.get("type") == "fermer_notebook_distant":
            # PATCH (bouton "Fermer") -- côté EXÉCUTANT, demande de
            # fermeture reçue (relayée par le serveurT, qui y ajoute
            # id_pilote) : à charge de main_sautoniax (connecté à ce
            # signal) de fermer le profil actuellement chargé (cf.
            # _sautoniax_fermer_notebook_distant) et d'appeler envoyer_
            # fermer_notebook_distant_resultat.
            session_id = data.get("session_id", "")
            id_pilote = data.get("id_pilote", "")
            log_reseau_t.info(f"<- fermer_notebook_distant reçu (session={session_id})")
            self.fermer_notebook_distant_demande.emit(session_id, id_pilote)

        elif data.get("type") == "fermer_notebook_distant_resultat":
            # PATCH (bouton "Fermer") -- côté PILOTE, résultat final
            # (unique) de la fermeture : ok=True signifie que le profil a
            # bien été fermé (ou qu'il n'y avait rien à fermer, cf.
            # _sautoniax_fermer_notebook_distant -- ce cas est traité comme
            # un succès, pas une erreur) côté sAutoniax.
            session_id = data.get("session_id", "")
            id_executant = data.get("id_executant", "")
            ok = data.get("ok", False)
            message_txt = data.get("message", "")
            if ok:
                log_reseau_t.info(f"<- fermer_notebook_distant_resultat (ok=True, session={session_id})")
            else:
                log_reseau_t.warning(f"<- fermer_notebook_distant_resultat (ok=False, session={session_id}) : {message_txt}")
            self.fermer_notebook_distant_resultat_recu.emit(session_id, id_executant, ok, message_txt)

        elif data.get("type") == "regler_capture_instance":
            # Côté EXÉCUTANT -- demande de réglage de capture reçue
            # (relayée par le serveurT, qui y ajoute id_pilote) : à
            # charge de main_sautoniax (mono-profil) ou du relais
            # multi-profils (Projets Distribués, connecté à ce même
            # signal) de traduire cette demande en commande locale vers
            # l'instance concernée -- cf. docstring de regler_capture_
            # instance_demande pour le contrat complet.
            instance_id = data.get("instance_id", "")
            action = data.get("action", "")
            fps = data.get("fps", 0.0)
            log_reseau_t.info(
                f"<- regler_capture_instance reçu (instance={instance_id!r}, action={action!r}, fps={fps})"
            )
            self.regler_capture_instance_demande.emit(instance_id, action, fps)

        elif data.get("type") == "command":
            # CORRECTIF (contrôle à distance ne fonctionnait jamais en
            # mode sAutoniax -- cf. docstring de commande_instance_recue
            # ci-dessus pour le diagnostic complet). Ce message est
            # envoyé par serveur.py (handler "commande_instance") tel
            # quel -- "instance_id"/"requete_id"/"action"/params propres
            # à l'action (x/y/bouton/etc., cf. _executer_commande_
            # camoufox pour le détail par action). Simple relais vers
            # main_sautoniax via le signal, aucune interprétation ici,
            # même esprit que regler_capture_instance juste au-dessus.
            action_recue = data.get("action")
            log_reseau_t.info(
                f"<- command reçu (action={action_recue!r}, instance={data.get('instance_id')!r}, "
                f"requete_id={data.get('requete_id')!r})"
            )
            self.commande_instance_recue.emit(data)

        elif data.get("type") == "regler_capture_instance_ack":
            # Côté PILOTE -- accusé de transmission (pas de résultat --
            # la réponse, s'il y en a une, arrive comme une capture
            # normale via capture_recue, cf. docstring de demander_
            # capture_ponctuelle_instance). Un ok=False signale juste
            # que le message n'a jamais atteint le sAutoniax visé (ex.
            # déconnecté entre-temps) -- simple log, rien à corréler
            # côté appelant puisqu'aucun session_id n'existe pour cette
            # commande fire-and-forget.
            if data.get("ok", False):
                log_reseau_t.info(f"<- regler_capture_instance_ack (ok=True, instance={data.get('instance_id')})")
            else:
                message_erreur = data.get("erreur", "Erreur inconnue")
                log_reseau_t.warning(
                    f"<- regler_capture_instance_ack (ok=False, instance={data.get('instance_id')}) : "
                    f"{message_erreur}"
                )
                self.regler_capture_instance_echec.emit(data.get("instance_id", ""), message_erreur)

        elif data.get("type") == "commande_instance_ack":
            # PATCH B.4 (contrôle à distance réel) -- côté PILOTE, accusé
            # de TRANSMISSION seulement (même contrat que regler_capture_
            # instance_ack juste au-dessus) -- le RÉSULTAT d'exécution
            # (succès/échec réel de l'action sur la page) arrive séparément
            # via "command_result", cf. bloc suivant. Un ok=False ici
            # signifie que la commande n'a même pas atteint le sAutoniax
            # (déconnecté, instance introuvable) : fire-and-forget côté
            # UI (le pilote continue de bouger sa souris sans attendre
            # cette confirmation), donc simple log au lieu d'un signal
            # dédié -- un échec isolé de mousemove/scroll parmi des
            # dizaines par seconde n'a pas besoin de remonter jusqu'à
            # l'écran, contrairement à regler_capture_instance (rare,
            # déclenché par un vrai clic utilisateur sur un contrôle).
            if data.get("ok", False):
                log_reseau_t.debug(
                    f"<- commande_instance_ack (ok=True, requete_id={data.get('requete_id')!r})"
                )
            else:
                log_reseau_t.debug(
                    f"<- commande_instance_ack (ok=False, requete_id={data.get('requete_id')!r}) : "
                    f"{data.get('erreur')}"
                )

        elif data.get("type") == "command_result":
            # PATCH B.4 (contrôle à distance réel) -- côté PILOTE,
            # résultat d'exécution RÉEL de la commande (relayé par le
            # serveurT via la corrélation requete_id -> id_pilote, cf.
            # serveur.py handler "command_result"). Émis tel quel via
            # commande_controle_distance_resultat_recu -- même niveau
            # DEBUG que l'ack ci-dessus et pour la même raison (volume :
            # potentiellement plusieurs par seconde en usage normal).
            log_reseau_t.debug(
                f"<- command_result (ok={data.get('ok')!r}, requete_id={data.get('requete_id')!r}, "
                f"action={data.get('action')!r})"
            )
            self.commande_controle_distance_resultat_recu.emit(data)

        elif data.get("type") == "demander_logs_executant":
            # Côté EXÉCUTANT -- demande reçue (relayée par le serveurT,
            # qui y ajoute id_pilote) : à charge de main_sautoniax
            # (connecté à ce signal) de répondre via
            # envoyer_logs_executant(id_pilote, ...) avec le contenu de
            # son propre TamponJournalMemoire local.
            id_pilote = data.get("id_pilote", "")
            log_reseau_t.info("<- demander_logs_executant reçu")
            self.logs_executant_demande.emit(id_pilote)

        elif data.get("type") == "logs_executant":
            # Côté PILOTE -- réponse d'UN sAutoniax précis (id_executant
            # ajouté par le serveurT lors du relais, cf. serveur.py).
            # ok=False signifie que le serveurT n'a pas pu joindre ce
            # sAutoniax (déconnecté entre-temps) -- lignes vide dans ce
            # cas, log seul, rien de plus à faire côté appelant.
            id_executant = data.get("id_executant", "")
            if data.get("ok", False):
                lignes = data.get("lignes", [])
                # BUGFIX (fenêtre temporelle sAutoniax toujours vide) --
                # offset_utc_secondes absent (sAutoniax pas encore mis à
                # jour) -> 0.0, cf. docstring du signal ci-dessus.
                offset_utc_secondes = float(data.get("offset_utc_secondes", 0.0) or 0.0)
                log_reseau_t.info(f"<- logs_executant reçu ({len(lignes)} ligne(s), id_executant={id_executant!r})")
                self.logs_executant_recu.emit(id_executant, lignes, offset_utc_secondes)
            else:
                log_reseau_t.warning(f"<- logs_executant (ok=False, id_executant={id_executant!r}) : {data.get('erreur', 'Erreur inconnue')}")
                self.logs_executant_recu.emit(id_executant, [], 0.0)

        elif data.get("type") == "api2api_enregistrer_ack":
            # cf. api2api_enregistrer_bloquant -- résout la future en
            # attente pour CE requete_id précis si présente, sinon (cas
            # rare : réponse tardive après un timeout déjà expiré côté
            # appelant, future déjà purgée) ignore silencieusement,
            # même logique que command_result côté serveurT pour une
            # corrélation manquante.
            requete_id = data.get("requete_id", "")
            future = self._api2api_futures.get(requete_id)
            log_reseau_t.info(f"<- api2api_enregistrer_ack (ok={data.get('ok')!r}, id_api2api={data.get('id_api2api')!r})")
            if future is not None and not future.done():
                future.set_result(data)

        elif data.get("type") == "api2api_verrouiller_ack":
            # cf. api2api_verrouiller_bloquant -- même mécanisme.
            requete_id = data.get("requete_id", "")
            future = self._api2api_futures.get(requete_id)
            log_reseau_t.info(f"<- api2api_verrouiller_ack (ok={data.get('ok')!r}, id_api2api={data.get('id_api2api')!r})")
            if future is not None and not future.done():
                future.set_result(data)

        elif data.get("type") == "api2api_liberer_ack":
            requete_id = data.get("requete_id", "")
            future = self._api2api_futures.get(requete_id)
            log_reseau_t.info(f"<- api2api_liberer_ack (ok={data.get('ok')!r})")
            if future is not None and not future.done():
                future.set_result(data)

        elif data.get("type") == "api2api_reset_admin_ack":
            # cf. api2api_reset_admin_bloquant -- même mécanisme que
            # api2api_liberer_ack juste au-dessus.
            requete_id = data.get("requete_id", "")
            future = self._api2api_futures.get(requete_id)
            log_reseau_t.warning(f"<- api2api_reset_admin_ack (ok={data.get('ok')!r}, nombre_retires={data.get('nombre_retires')!r})")
            if future is not None and not future.done():
                future.set_result(data)

        elif data.get("type") == "api2api_requete_ack":
            # Accusé de transmission de la requête (PAS la réponse du
            # fournisseur elle-même, cf. api2api_reponse ci-dessous) --
            # ok=False ici signifie que le serveurT n'a même pas pu
            # relayer la requête (Api2Api introuvable/déconnecté) : dans
            # ce cas, résout DÉJÀ la future avec cet échec, aucune
            # api2api_reponse ne suivra jamais pour ce requete_id.
            # ok=True : ne résout PAS la future -- la vraie réponse
            # arrivera plus tard via api2api_reponse (bloc suivant),
            # laisse future.result() continuer d'attendre.
            requete_id = data.get("requete_id", "")
            if not data.get("ok", False):
                future = self._api2api_futures.get(requete_id)
                log_reseau_t.warning(f"<- api2api_requete_ack (ok=False) : {data.get('erreur')!r}")
                if future is not None and not future.done():
                    future.set_result(data)
            else:
                log_reseau_t.debug(f"<- api2api_requete_ack (ok=True, requete_id={requete_id!r})")

        elif data.get("type") == "api2api_reponse":
            # cf. api2api_requete_bloquant -- LA réponse effective du
            # fournisseur (req.repondre(...) côté script), routée par le
            # serveurT via REQUETES_API2API_EN_ATTENTE. Même requete_id
            # que la requête d'origine (posé par api2api_requete_bloquant
            # avant l'envoi), donc résout directement la bonne future.
            requete_id = data.get("requete_id", "")
            future = self._api2api_futures.get(requete_id)
            log_reseau_t.info(f"<- api2api_reponse (ok={data.get('ok')!r}, requete_id={requete_id!r})")
            if future is not None and not future.done():
                future.set_result(data)

        elif data.get("type") == "api2api_requete_recue":
            # Côté FOURNISSEUR -- une requête vient d'arriver pour le
            # Task Api2Api actuellement verrouillé par un client (cf.
            # api2api_attendre_requete_bloquant, bloqué en attente sur la
            # clé f"attente_requete:{id_api2api}"). requete_id transporté
            # dans le payload : c'est CE requete_id que req.repondre(...)
            # (côté script fournisseur) devra réutiliser pour que
            # api2api_repondre route correctement la réponse vers le bon
            # client (cf. REQUETES_API2API_EN_ATTENTE côté serveurT).
            id_api2api = data.get("id_api2api", "")
            cle_attente = f"attente_requete:{id_api2api}"
            future = self._api2api_futures.get(cle_attente)
            log_reseau_t.info(f"<- api2api_requete_recue (id_api2api={id_api2api!r}, requete_id={data.get('requete_id')!r})")
            if future is not None and not future.done():
                future.set_result(data)
            else:
                # BUGFIX (course structurelle, cf. docstring de
                # api2api_attendre_requete_bloquant et de
                # _api2api_requetes_en_avance) -- aucune future en attente
                # pour ce Task À CET INSTANT PRÉCIS ne signifie PAS que le
                # fournisseur a disparu : le cas le plus courant est qu'il
                # vient de finir de traiter sa requête précédente
                # (req.repondre(...)) et n'a pas encore fini de repasser
                # en haut de sa boucle while True: pour rappeler
                # attendre_requete() et reposer sa future. Avant ce
                # correctif, ce message était perdu silencieusement
                # (log WARNING seul) et le fournisseur restait bloqué pour
                # toujours sur une future qui n'aurait jamais pu être
                # résolue. Correctif : mémoriser ce message pour que le
                # PROCHAIN appel à api2api_attendre_requete_bloquant pour
                # ce même id_api2api le consomme immédiatement au lieu de
                # reposer une future condamnée à attendre indéfiniment.
                # Écrase toute entrée précédente non consommée (ne
                # devrait normalement jamais arriver -- un fournisseur ne
                # traite qu'une requête à la fois -- mais garde la PLUS
                # RÉCENTE plutôt que la plus ancienne en cas de doute).
                self._api2api_requetes_en_avance[cle_attente] = data
                log_reseau_t.info(
                    f"api2api_requete_recue (id_api2api={id_api2api!r}) arrivée avant attendre_requete() -- "
                    f"mémorisée pour être consommée dès le prochain appel."
                )

        elif data.get("type") == "erreur":
            log_reseau_t.warning(f"<- erreur du serveurT : {data.get('message')!r}")


class ServiceSortieProxy:
    """PATCH (SPEC_proxy_natif_tunnel.md, section 7) -- symétrique de
    RelaisProxyLocal (cf. AutoniaX.py, côté sAutoniaX, juste avant
    _main_async_sautoniax), côté mAutoniaX (pilote) cette fois. Un seul
    par process mAutoniaX (créé dans MainWindow, à côté de
    self.client_serveur_t, cf. son instanciation) : ouvre RÉELLEMENT les
    connexions TCP demandées par n'importe quel sAutoniaX de ce pilote,
    avec LA connexion internet de cette machine (celle du pilote).

    Porte :
    - la connexion /ws_tunnel elle-même (une seule, partagée par TOUS
      les sAutoniaX de ce pilote -- section 4 : "le mAutoniaX
      correspondant ouvre lui aussi une connexion /ws_tunnel" ; le
      remappage de stream_id par exécutant est un problème du
      serveurT, pas de ce composant, cf. section 8) -- ouverte
      paresseusement à la première activation du proxy natif sur
      N'IMPORTE QUEL profil de N'IMPORTE QUEL sAutoniaX de ce pilote,
      fermée quand plus aucun ne l'utilise (cf. section 7, dernier
      paragraphe) ;
    - un dict stream_id -> StreamWriter (connexion TCP réelle vers la
      destination demandée), nettoyé à la fermeture de chaque flux.

    IMPORTANT (contrairement à RelaisProxyLocal, qui a sa PROPRE boucle
    asyncio dédiée dans _main_async_sautoniax) : ce composant tourne
    sur asyncio, mais le process mAutoniaX (Qt) n'a pas de boucle
    asyncio de ce type qui tourne en continu -- cf. ClientServeurT.
    _thread_principal, qui EN A une (son propre thread réseau dédié,
    self._loop). Ce service réutilise CETTE MÊME boucle (transmise via
    `boucle` au constructeur, cf. son usage dans MainWindow -- passée
    UNE FOIS l'objet `client_serveur_t` créé, donc après son premier
    `demarrer()`) plutôt que d'en ouvrir une troisième pour le process
    -- toutes les méthodes publiques ci-dessous sont donc appelables
    DEPUIS LE THREAD QT PRINCIPAL (elles postent sur `boucle` via
    asyncio.run_coroutine_threadsafe, jamais d'await direct).

    NOTE placement dans le fichier : cette classe référence TAILLE_
    ENTETE_TRAME_TUNNEL/TYPE_TRAME_*/_construire_trame_tunnel/_lire_
    entete_trame_tunnel, tous définis PLUS LOIN dans ce fichier (juste
    avant RelaisProxyLocal, section 5 -- format de trame commun aux
    deux côtés). Volontaire : Python résout les noms globaux au moment
    de l'APPEL de chaque méthode, jamais à la définition de la classe
    elle-même -- aucun de ces noms n'est utilisé au niveau du corps de
    classe (seulement à l'intérieur de méthodes), donc aucun
    NameError possible à l'exécution. Choix fait pour garder
    ServiceSortieProxy juste à côté de ClientServeurT (dont elle
    dépend directement, cf. son constructeur) plutôt que de la
    déplacer à côté du format de trame, plus loin, où le lien avec
    ClientServeurT serait moins visible à la lecture."""

    def __init__(self, id_pilote_stable: str, boucle_fournisseur: Callable[[], Optional[asyncio.AbstractEventLoop]]):
        # PATCH (le thread réseau de ClientServeurT peut ne pas encore
        # tourner -- ou être en cours de reconnexion, cf. _thread_
        # principal qui recrée self._loop à CHAQUE (re)connexion -- au
        # moment où ServiceSortieProxy est instancié) : `boucle_
        # fournisseur` est un callable (ex. `lambda: client_serveur_t.
        # _loop`) plutôt qu'une référence figée, pour toujours lire la
        # boucle ACTUELLEMENT vivante au moment de chaque appel, jamais
        # une boucle fermée d'une connexion précédente.
        self._id_pilote_stable = id_pilote_stable
        self._boucle_fournisseur = boucle_fournisseur
        self._ws_tunnel: Optional["websockets.WebSocketClientProtocol"] = None
        self._tache_connexion: Optional[asyncio.Task] = None
        # AJOUT (revue de bout en bout -- cf. docstring de TYPE_TRAME_PING,
        # AutoniaX.py section RelaisProxyLocal) : même raisonnement EXACT
        # que côté sAutoniaX -- le ping natif websockets est désactivé des
        # deux côtés, ce composant doit donc émettre son propre heartbeat
        # binaire pour que le serveur sache que cette connexion pilote
        # est encore vivante.
        self._tache_heartbeat_tunnel: Optional[asyncio.Task] = None
        self._writers_par_stream: dict[int, asyncio.StreamWriter] = {}
        # Compteur de références -- nombre de sAutoniaX/profils ayant
        # actuellement demandé le proxy natif (cf. section 7, dernier
        # paragraphe : "ouverte à la première activation... fermée
        # quand plus aucun sAutoniaX ne l'utilise"). Incrémenté/
        # décrémenté par signaler_profil_actif/signaler_profil_inactif
        # ci-dessous -- PAS un booléen simple, plusieurs profils sur
        # plusieurs sAutoniaX peuvent utiliser le proxy natif en même
        # temps, cf. section 3 : "un mAutoniaX qui a au moins un clone
        # en proxy natif activé".
        self._nb_profils_actifs = 0
        self._verrou_compteur = threading.Lock()

    def signaler_profil_actif(self):
        """Appelée DEPUIS LE THREAD QT (cf. MainWindow, câblage sur
        toggle_proxy_natif_resultat_recu avec ok=True et actif=True) --
        incrémente le compteur de références et programme l'ouverture
        du tunnel si c'est la toute première activation connue."""
        with self._verrou_compteur:
            self._nb_profils_actifs += 1
            premiere_activation = self._nb_profils_actifs == 1
        if premiere_activation:
            self._programmer(self._assurer_connexion_tunnel())

    def signaler_profil_inactif(self):
        """Symétrique -- appelée quand un toggle_proxy_natif_resultat_
        recu(actif=False) arrive, ou qu'un sAutoniaX propriétaire de
        profils en proxy natif se déconnecte (cf. MainWindow, à
        rapprocher de la logique déjà existante pour nombre_executants_
        change). Ferme le tunnel dès que plus personne ne l'utilise --
        jamais en dessous de zéro (un signal désynchronisé ne doit
        jamais faire lever cette classe)."""
        with self._verrou_compteur:
            self._nb_profils_actifs = max(0, self._nb_profils_actifs - 1)
            derniere_desactivation = self._nb_profils_actifs == 0
        if derniere_desactivation:
            self._programmer(self._fermer_connexion_tunnel())

    def arreter(self):
        """Fermeture inconditionnelle -- appelée à la fermeture de
        l'application (cf. MainWindow.closeEvent, à rapprocher de
        self.client_serveur_t.arreter() déjà présent), sans passer par
        le compteur de références (peu importe combien de profils
        étaient encore actifs, le process entier se termine)."""
        with self._verrou_compteur:
            self._nb_profils_actifs = 0
        self._programmer(self._fermer_connexion_tunnel())

    def _programmer(self, coro) -> None:
        boucle = self._boucle_fournisseur()
        if boucle is None or not boucle.is_running():
            log_reseau_t.warning(
                "[mAutoniax] ServiceSortieProxy : boucle réseau serveurT indisponible -- "
                "action ignorée (probablement déconnecté au moment de l'appel)."
            )
            return
        asyncio.run_coroutine_threadsafe(coro, boucle)

    async def _assurer_connexion_tunnel(self):
        if self._ws_tunnel is not None:
            return
        if websockets is None:
            log_reseau_t.error("[mAutoniax] ServiceSortieProxy : paquet 'websockets' non installé -- proxy natif indisponible côté pilote.")
            return
        url_ws = resoudre_url_serveurt()
        if url_ws.endswith("/ws"):
            url_tunnel = url_ws[: -len("/ws")] + "/ws_tunnel"
        else:
            url_tunnel = url_ws.rstrip("/") + "/ws_tunnel"
        try:
            self._ws_tunnel = await websockets.connect(url_tunnel, max_size=None, ping_interval=None)
            await self._ws_tunnel.send(json.dumps({
                "role": "pilote",
                "id_pilote_stable": self._id_pilote_stable,
            }))
        except Exception as e:
            log_reseau_t.warning(f"[mAutoniax] ServiceSortieProxy : échec de connexion /ws_tunnel ({e!r}).")
            self._ws_tunnel = None
            return
        log_reseau_t.info(f"[mAutoniax] ServiceSortieProxy : /ws_tunnel connecté ({url_tunnel}).")
        self._tache_connexion = asyncio.get_running_loop().create_task(self._boucle_reception_tunnel())
        self._tache_heartbeat_tunnel = asyncio.get_running_loop().create_task(self._boucle_heartbeat_tunnel())

    async def _fermer_connexion_tunnel(self):
        if self._tache_connexion is not None:
            self._tache_connexion.cancel()
            self._tache_connexion = None
        if self._tache_heartbeat_tunnel is not None:
            self._tache_heartbeat_tunnel.cancel()
            self._tache_heartbeat_tunnel = None
        for writer in list(self._writers_par_stream.values()):
            try:
                writer.close()
            except Exception:
                pass
        self._writers_par_stream.clear()
        if self._ws_tunnel is not None:
            try:
                await self._ws_tunnel.close()
            except Exception:
                pass
            self._ws_tunnel = None
            log_reseau_t.info("[mAutoniax] ServiceSortieProxy : /ws_tunnel fermé (plus aucun profil en proxy natif).")

    async def _boucle_heartbeat_tunnel(self):
        """AJOUT (cf. docstring de TYPE_TRAME_PING, AutoniaX.py section
        RelaisProxyLocal) -- symétrique EXACT de RelaisProxyLocal._boucle_
        heartbeat_tunnel, côté pilote cette fois. Cf. son docstring pour
        le raisonnement complet."""
        try:
            while True:
                await asyncio.sleep(DELAI_HEARTBEAT_TUNNEL_SECONDES)
                if self._ws_tunnel is None:
                    return
                try:
                    await self._ws_tunnel.send(_construire_trame_tunnel(TYPE_TRAME_PING, STREAM_ID_HEARTBEAT_TUNNEL))
                except Exception:
                    return
        except asyncio.CancelledError:
            pass

    async def _boucle_reception_tunnel(self):
        """Tâche de fond, symétrique de RelaisProxyLocal._boucle_
        reception_tunnel côté sAutoniaX -- lit OPEN/DATA/CLOSE en
        provenance de N'IMPORTE QUEL sAutoniaX de ce pilote (le
        serveurT s'occupe déjà du routage par id_pilote_stable, cf.
        section 8 -- ce composant ne voit qu'UN SEUL flux entrant, déjà
        filtré) et y répond réellement (section 7, points 1-2)."""
        try:
            while True:
                trame = await self._ws_tunnel.recv()
                if isinstance(trame, str) or len(trame) < TAILLE_ENTETE_TRAME_TUNNEL:
                    continue
                type_trame, stream_id, payload = _lire_entete_trame_tunnel(trame)
                if type_trame == TYPE_TRAME_OPEN:
                    asyncio.get_running_loop().create_task(self._ouvrir_connexion_reelle(stream_id, payload))
                elif type_trame == TYPE_TRAME_DATA:
                    writer = self._writers_par_stream.get(stream_id)
                    if writer is not None:
                        try:
                            writer.write(payload)
                            await writer.drain()
                        except Exception:
                            await self._fermer_stream(stream_id, prevenir_distant=True)
                elif type_trame == TYPE_TRAME_CLOSE:
                    await self._fermer_stream(stream_id, prevenir_distant=False)
                elif type_trame == TYPE_TRAME_PONG:
                    # Réponse du serveur à notre propre PING (cf. _boucle_
                    # heartbeat_tunnel) -- symétrique EXACT de RelaisProxy
                    # Local._boucle_reception_tunnel : rien à faire, la
                    # seule preuve de vie utile est déjà le fait d'avoir
                    # reçu N'IMPORTE QUELLE trame ici (.recv() débloqué).
                    pass
                # TYPE_TRAME_PING volontairement absent : le serveur ne
                # PING jamais lui-même (cf. serveur.py, docstring de
                # route_websocket_tunnel) -- seuls les clients initient.
        except Exception as e:
            log_reseau_t.warning(f"[mAutoniax] ServiceSortieProxy : connexion /ws_tunnel perdue ({e!r}).")
        finally:
            for writer in list(self._writers_par_stream.values()):
                try:
                    writer.close()
                except Exception:
                    pass
            self._writers_par_stream.clear()
            self._ws_tunnel = None

    async def _ouvrir_connexion_reelle(self, stream_id: int, payload: bytes):
        """Section 7, point 1 -- OPEN(stream_id, host, port) reçu :
        ouvre RÉELLEMENT la connexion TCP demandée depuis CETTE machine
        (le pilote), avec sa propre IP publique. Répond OPEN_OK/
        OPEN_FAIL, puis relaie DATA vers le tunnel jusqu'à CLOSE/
        coupure -- symétrique du sens navigateur -> tunnel déjà géré
        par RelaisProxyLocal._gerer_connexion_navigateur, mais ici dans
        l'autre sens (tunnel -> vraie connexion internet)."""
        try:
            longueur_host = payload[0]
            host = payload[1:1 + longueur_host].decode("utf-8", errors="replace")
            port = int.from_bytes(payload[1 + longueur_host:3 + longueur_host], "big")
        except Exception as e:
            log_reseau_t.warning(f"[mAutoniax] ServiceSortieProxy : trame OPEN malformée (stream {stream_id}) : {e!r}")
            await self._envoyer_trame_securise(_construire_trame_tunnel(TYPE_TRAME_OPEN_FAIL, stream_id, b"trame OPEN malformee"))
            return

        try:
            reader, writer = await asyncio.wait_for(asyncio.open_connection(host, port), timeout=8.0)
        except Exception as e:
            log_reseau_t.info(f"[mAutoniax] ServiceSortieProxy : échec de connexion réelle vers {host}:{port} (stream {stream_id}) : {e!r}")
            await self._envoyer_trame_securise(_construire_trame_tunnel(TYPE_TRAME_OPEN_FAIL, stream_id, str(e).encode("utf-8", errors="replace")))
            return

        self._writers_par_stream[stream_id] = writer
        await self._envoyer_trame_securise(_construire_trame_tunnel(TYPE_TRAME_OPEN_OK, stream_id))

        # Relais pur, sens connexion réelle -> tunnel (section 7, point
        # 2) -- symétrique de la boucle "navigateur -> tunnel" de
        # RelaisProxyLocal._gerer_connexion_navigateur.
        try:
            while True:
                donnees = await reader.read(65536)
                if not donnees:
                    break
                await self._envoyer_trame_securise(_construire_trame_tunnel(TYPE_TRAME_DATA, stream_id, donnees))
        except Exception:
            pass
        finally:
            if stream_id in self._writers_par_stream:
                await self._envoyer_trame_securise(_construire_trame_tunnel(TYPE_TRAME_CLOSE, stream_id))
            await self._fermer_stream(stream_id, prevenir_distant=False)

    async def _fermer_stream(self, stream_id: int, prevenir_distant: bool):
        writer = self._writers_par_stream.pop(stream_id, None)
        if writer is not None:
            try:
                writer.close()
            except Exception:
                pass
        if prevenir_distant:
            await self._envoyer_trame_securise(_construire_trame_tunnel(TYPE_TRAME_CLOSE, stream_id))

    async def _envoyer_trame_securise(self, trame: bytes):
        """Petite garde commune (cf. les 5 sites d'appel ci-dessus) --
        le tunnel peut avoir été fermé (déconnexion, ou dernier profil
        désactivé) entre le moment où une tâche a été programmée et
        celui où elle tente réellement d'émettre -- ne jamais laisser
        une exception WebSocket remonter et faire planter une tâche de
        fond silencieusement."""
        if self._ws_tunnel is None:
            return
        try:
            await self._ws_tunnel.send(trame)
        except Exception as e:
            log_reseau_t.debug(f"[mAutoniax] ServiceSortieProxy : envoi de trame échoué (tunnel probablement fermé) : {e!r}")


class ClientReseauAutoniaX(QObject):
    """Client réseau générique vers le serveur central -- utilisé aussi
    bien par DashboardScreen (role="observateur", ex-"dashboard" renommé --
    cf. décision utilisateur : plusieurs observateurs peuvent partager la
    même instance sans conflit, aucun ne peut envoyer de commande) que par
    chaque onglet TestComposantScreen (role="pilote", exclusif -- envoie de
    vraies commandes de test, cf. 11.2 : "Depuis un écran de test,
    l'utilisateur consulte directement la liste des instances... ce choix
    déclenche la création de la liaison correspondante côté serveur, sans
    passer par une interface dashboard séparée"). Le
    serveur (cf. serveur.py, gerer_register) traite "pilote" et
    "dashboard" de façon strictement identique -- seule la valeur du
    champ "role" envoyée diffère.

    IMPORTANT -- id_client DOIT être unique par connexion : serveur.py
    n'a aucune déduplication de pilote_id (gerer_register fait
    registre.pilotes[id_] = PiloteInfo(...) sans vérifier une collision).
    Si deux onglets TestComposantScreen se connectaient avec le MÊME
    id_client, la seconde connexion écraserait silencieusement le .ws du
    premier dans le registre serveur -- tout command_result destiné au
    premier onglet partirait alors vers le second à la place (cf.
    gerer_command_result, qui route via registre.pilotes.get(pilote_id)
    -- un seul .ws par pilote_id). Chaque appelant doit donc générer un
    id_client réellement unique (cf. TestComposantScreen.__init__, qui
    utilise uuid4 pour ça), jamais une constante partagée entre onglets.

    Anciennement ClientReseauDashboard (renommé -- reste utilisé par
    DashboardScreen ET les onglets de test désormais, cf. alias
    ClientReseauDashboard ci-dessous pour ne rien casser ailleurs si le
    nom était référencé)."""

    connecte = Signal()
    echec_connexion = Signal(str)
    deconnecte = Signal()
    liste_instances_recue = Signal(list)
    frame_recue = Signal(str, str, int)  # instance_id, image_b64, seq
    erreur_recue = Signal(str)
    liaison_echouee = Signal(str, str)  # instance_id, message -- cf. gerer_link (serveur.py), qui renvoie
    # désormais instance_id structuré dans son message d'erreur plutôt que de laisser le
    # client deviner via un parsing de texte (FIX : avant ce patch, un échec de link
    # -- ex: instance déjà liée à un AUTRE pilote -- n'était visible que via erreur_recue,
    # jamais vérifié par _on_instance_changed, qui continuait comme si la liaison avait
    # réussi -- le test tournait alors dans le vide, chaque commande étant rejetée par
    # le serveur en silence).
    link_ok_recu = Signal(str)  # instance_id -- confirmation explicite de liaison (cf. srv_gerer_link,
    # message "link_ok"), jusqu'ici seulement logué (cf. _traiter_message) : aucun appelant existant
    # n'en avait besoin (InstanceApercuScreen envoie "link" de façon optimiste, sans attendre de
    # confirmation avant d'agir). MoteurExecutionCellule, lui, DOIT être certain que la liaison est
    # bien établie avant d'envoyer la moindre commande -- le serveur rejette sinon toute commande
    # avec "instance non liée à ce pilote" (cf. srv_gerer_command). Ajout pur, ne change rien au
    # comportement des appelants existants qui n'écoutent pas ce signal.
    command_result_recu = Signal(dict)  # message command_result complet -- cf. SequenceurActionReseau
    # AJOUT (Section 8 -- "Arrêter" interrompt le CODE, pas le profil, cf.
    # PLAN_section_8_arreter.md §5/§7 étapes 1-2) -- ces deux signaux sont
    # utilisés dans les DEUX sens selon le role de CETTE connexion :
    #   - role="pilote" (process principal du sAutoniax) : envoie
    #     executer_code (cf. envoyer_executer_code ci-dessous) puis
    #     ÉCOUTE executer_code_resultat_recu pour récupérer la réponse.
    #   - role="executeur" (nouveau sous-processus, cf. main_executeur_
    #     sautoniax) : ÉCOUTE executer_code_recu pour recevoir le code à
    #     exécuter, envoie sa réponse via envoyer_executer_code_resultat.
    # Même patron que command_result_recu (un seul signal, filtré par
    # requete_id côté appelant) plutôt que deux classes de client
    # séparées -- cohérent avec le reste de cette classe, déjà partagée
    # entre plusieurs rôles distincts (pilote/observateur/instance).
    executer_code_recu = Signal(dict)  # côté exécuteur : message executer_code complet reçu
    executer_code_resultat_recu = Signal(dict)  # côté pilote (process principal) : message executer_code_resultat complet reçu
    # AJOUT (Section 8 -- Image.view() depuis le process exécuteur, cf.
    # échange utilisateur : option "la plus propre et robuste" retenue,
    # PAS de connexion ClientServeurT distante supplémentaire ouverte par
    # l'exécuteur) : reçu côté process principal (role="pilote")
    # uniquement, un signal par appel .view() du code utilisateur dans
    # l'exécuteur -- jamais groupé avec executer_code_resultat_recu (cf.
    # docstring de Image.view(), "au fil de l'eau à côté des lignes de
    # log existantes" -- un envoi différé à la fin de la cellule
    # casserait ce comportement déjà en place pour tout profil non-
    # isolé). Le process principal relaie ce signal vers client_t.
    # envoyer_notebook_distant_image(session_id, id_pilote, image_b64)
    # -- cf. site de connect() dans _main_async_sautoniax.
    executer_code_image_recu = Signal(dict)
    # AJOUT (pont fichiers pilote <-> clone) -- côté EXÉCUTEUR : réponse du pilote à une demande de fichier.
    pont_reponse_recue = Signal(dict)
    # AJOUT (regenerer_navigateur() sans argument depuis une cellule) -- message de
    # l'exécuteur vers le process principal (via le serveur local) : « régénère le
    # navigateur de MON instance ». Reçu côté process principal uniquement.
    regenerer_navigateur_recu = Signal(dict)
    # AJOUT (régénération SANS interrompre la cellule) -- réponse du process principal vers
    # l'exécuteur (via le serveur local) : « le nouveau navigateur de l'instance X est prêt
    # (ou a échoué) ». Reçu côté exécuteur par son client pilote compagnon.
    regenerer_navigateur_resultat_recu = Signal(dict)
    instance_deliee = Signal(str, str)  # instance_id, raison -- cf. gerer_link (serveur.py) : émis quand LE
    # SERVEUR envoie "unlinked" à ce client parce qu'un AUTRE pilote vient de reprendre une instance que ce
    # client avait lui-même en liaison (cas concret : le Dashboard avait lié auto-1, un écran de test la
    # redemande -- le serveur délie alors le Dashboard automatiquement au lieu de refuser, cf. décision
    # produit "le Dashboard ne réserve pas une instance, il ne fait que la superviser"). Sans ce signal,
    # l'UI du client délié (ex: DashboardScreen) continuerait d'afficher l'instance comme sélectionnée et
    # ses contrôles (pause/fps/arrêter) resteraient actifs pour une instance qu'il ne contrôle plus.
    force_unlink_ok_recu = Signal(str, str)  # instance_id, ancien_pilote_id (peut être "") -- confirmation
    # EXPLICITE du serveur suite à un message "force_unlink" (cf. srv_gerer_force_unlink, bouton "Free" du
    # Dashboard) : contrairement à un unlink normal (jamais confirmé, cf. srv_gerer_unlink), ce bouton DOIT
    # attendre cette confirmation avant d'annoncer le succès à l'utilisateur (retour utilisateur explicite :
    # "sa doit etre confirmer par le serveur").

    def __init__(self, server_url: str, role: str = "observateur", id_client: str = "dashboard-autoniax"):
        super().__init__()
        self.server_url = server_url
        self.role = role
        self.id_client = id_client
        self._thread: threading.Thread | None = None
        self._loop: asyncio.AbstractEventLoop | None = None
        self._ws = None
        self._tache_boucle: asyncio.Task | None = None
        self._arret_demande = threading.Event()
        self._pret = threading.Event()  # signale que self._loop est utilisable depuis le thread appelant
        # PATCH (nettoyage des logs -- problème #3 : "à chaque changement
        # d'état d'une instance, le serveur envoie la liste complète des
        # instances à TOUS les pilotes... ne loguez pas la liste entière à
        # chaque événement") -- hash du dernier contenu instances_list
        # LOGUÉ en DEBUG (cf. _traiter_message ci-dessous), pour ne
        # reloguer la liste complète que si elle a réellement changé
        # depuis la dernière fois, même si le serveur renvoie la même
        # liste à chaque petit événement (comportement serveur inchangé,
        # seul le LOG client devient sélectif).
        self._hash_derniere_liste_instances: Optional[str] = None

    # --- Cycle de vie (appelé depuis le thread Qt principal) ---

    def demarrer(self):
        if self._thread is not None:
            log_dashboard_reseau.warning(f"[{self.id_client}] demarrer() appelé alors qu'un thread réseau existe déjà -- ignoré")
            return
        log_dashboard_reseau.info(f"[{self.id_client}] demarrer() : lancement du thread réseau (role={self.role}, url={self.server_url})")
        self._arret_demande.clear()
        self._pret.clear()
        self._thread = threading.Thread(target=self._thread_principal, daemon=True)
        self._thread.start()

    def arreter(self, timeout: float = 3.0):
        """Bloquant : annule la tâche réseau (ce qui ferme le websocket via
        le `finally` de _boucle_async) puis attend la fin du thread. À
        appeler depuis closeEvent AVANT de tuer les subprocess serveur/
        instances (cf. diagnostic terminate()).

        Note technique : on annule la Task plutôt que de poster un
        _fermer_websocket() séparé via run_coroutine_threadsafe -- ce
        dernier pattern provoque un deadlock avec websockets 17 quand la
        boucle est bloquée dans `async for brut in self._ws` : close()
        attend que la tâche de réception interne se termine, qui elle-même
        ne peut se terminer que si quelque chose débloque l'attente sur la
        même boucle -- jamais résolu en pratique (TimeoutError après 3s).
        L'annulation de tâche, elle, interrompt immédiatement le `async for`
        (CancelledError), après quoi le `finally` ferme le websocket sur la
        même coroutine, sans concurrence entre deux tâches distinctes."""
        if self._thread is None:
            return
        log_dashboard_reseau.info(f"[{self.id_client}] arreter() : demande d'arrêt du thread réseau")
        self._arret_demande.set()
        if self._loop is not None and self._loop.is_running() and self._tache_boucle is not None:
            self._loop.call_soon_threadsafe(self._tache_boucle.cancel)
        self._thread.join(timeout=timeout)
        if self._thread.is_alive():
            log_dashboard_reseau.warning(f"[{self.id_client}] Le thread réseau ne s'est pas arrêté sous {timeout}s")
        else:
            log_dashboard_reseau.info(f"[{self.id_client}] Thread réseau arrêté proprement")
        self._thread = None

    def envoyer_commande(self, message: dict):
        """Thread-safe : peut être appelée depuis le thread Qt principal
        (ex: clic sur un bouton) pendant que la boucle réseau tourne."""
        if self._loop is None or not self._loop.is_running():
            log_dashboard_reseau.warning(f"envoyer_commande({message.get('type')}) ignorée : pas de boucle réseau active")
            return
        # LOG DIAGNOSTIC (bug "2e test qui bloque") : trace CHAQUE commande
        # sortante avec action/instance_id/requete_id. Permet de voir dans
        # le prochain run si des commandes s'accumulent en rafale (ex:
        # rappels de set_streaming) juste avant la coupure de connexion.
        #
        # CORRECTIF (retour utilisateur explicite : "trop de logs
        # redondants") -- passé en debug pour set_fps/set_streaming :
        # commandes de routine relayées à chaque clic Rafraîchir/
        # Automatique (déjà dédupliquées côté appelant, cf.
        # _sur_regler_capture_instance_demande, mais restent plus
        # fréquentes que le pilotage réel) -- gardé en info pour tout le
        # reste (click/type_text/scroll_simple/listTabs/switchTab...),
        # qui sont les événements qu'on veut voir passer d'un coup d'œil.
        action_msg = message.get("action")
        if action_msg in ("set_fps", "set_streaming"):
            log_dashboard_reseau.debug(
                f"[{self.id_client}] -> ENVOI commande : action={action_msg!r} "
                f"type={message.get('type')!r} instance_id={message.get('instance_id')!r} "
                f"requete_id={message.get('requete_id')!r}"
            )
        else:
            # DÉSACTIVÉ (demande explicite utilisateur : "logs les plus
            # bruyants" -- cf. analyse logs.txt, ~605 occurrences) --
            # passé en debug, réactivable via la config du logger. Le
            # commentaire ci-dessus visait le "pilotage réel ponctuel"
            # mais capture_propre et les autres commandes caméra,
            # envoyées en rafale, tombaient aussi dans cette branche.
            log_dashboard_reseau.debug(
                f"[{self.id_client}] -> ENVOI commande : action={action_msg!r} "
                f"type={message.get('type')!r} instance_id={message.get('instance_id')!r} "
                f"requete_id={message.get('requete_id')!r}"
            )
        asyncio.run_coroutine_threadsafe(self._envoyer_async(message), self._loop)

    def envoyer_executer_code(self, instance_id: str, requete_id: str, code: str,
                                session_id: str = "", id_pilote: str = "",
                                services_api_lies: Optional[dict] = None,
                                reinitialiser_result_color: bool = False,
                                lire_result_color_finale: bool = False):
        """AJOUT (Section 8, cf. docstring de executer_code_recu) -- envoyé
        côté process principal (role="pilote") vers l'exécuteur ciblé par
        instance_id, via le serveur local (cf. srv_gerer_executer_code).
        Thread-safe, même garde que envoyer_commande ci-dessus.

        session_id/id_pilote/services_api_lies (AJOUT -- construction des
        Composants/ServiceAPI DÉPLACÉE dans l'exécuteur, cf. §3 du plan et
        échange utilisateur sur Image.view() : ce que _construire_
        composants_direct/_contexte_reseau recevaient auparavant du
        process principal directement doit désormais transiter par ce
        message, une cellule pouvant changer de session_id/id_pilote/
        services_api_lies d'un appel à l'autre sur le MÊME exécuteur déjà
        connecté)."""
        if self._loop is None or not self._loop.is_running():
            log_dashboard_reseau.warning(f"envoyer_executer_code ignoré : pas de boucle réseau active (instance_id={instance_id!r})")
            return
        log_dashboard_reseau.info(
            f"[{self.id_client}] -> ENVOI executer_code : instance_id={instance_id!r} requete_id={requete_id!r}"
        )
        message = {
            "type": "executer_code", "instance_id": instance_id, "requete_id": requete_id, "code": code,
            "session_id": session_id, "id_pilote": id_pilote,
            "services_api_lies": services_api_lies if services_api_lies is not None else {},
            "reinitialiser_result_color": reinitialiser_result_color,
            "lire_result_color_finale": lire_result_color_finale,
        }
        asyncio.run_coroutine_threadsafe(self._envoyer_async(message), self._loop)

    def envoyer_executer_code_resultat(self, instance_id: str, requete_id: str, ok: bool,
                                         erreur: str = "", sortie: str = "", result_color: Optional[str] = None,
                                         result_output: Optional[dict] = None):
        """AJOUT (Section 8, cf. docstring de executer_code_resultat_recu)
        -- envoyé côté exécuteur, réponse à un executer_code reçu, relayée
        par le serveur local vers le process principal (cf. srv_gerer_
        executer_code_resultat). Thread-safe, même garde que envoyer_
        commande ci-dessus."""
        if self._loop is None or not self._loop.is_running():
            log_dashboard_reseau.warning(f"envoyer_executer_code_resultat ignoré : pas de boucle réseau active (instance_id={instance_id!r})")
            return
        log_dashboard_reseau.info(
            f"[{self.id_client}] -> ENVOI executer_code_resultat : instance_id={instance_id!r} "
            f"requete_id={requete_id!r} ok={ok!r}"
        )
        message = {
            "type": "executer_code_resultat", "instance_id": instance_id, "requete_id": requete_id,
            "ok": ok, "erreur": erreur, "sortie": sortie,
        }
        if result_color is not None:
            message["result_color"] = result_color
        # AJOUT (transfert RESULT_OUTPUT) -- champ absent (pas null) quand
        # il n'y a rien à renvoyer : message identique à l'ancien format.
        if result_output is not None:
            message["result_output"] = result_output
        asyncio.run_coroutine_threadsafe(self._envoyer_async(message), self._loop)

    def envoyer_executer_code_image(self, instance_id: str, session_id: str, id_pilote: str, image_b64: str, ligne: Optional[str] = None):
        """AJOUT (Section 8 -- Image.view() depuis le process exécuteur,
        cf. échange utilisateur : "la plus propre et robuste" -- option
        retenue, PAS de connexion ClientServeurT distante supplémentaire
        dans l'exécuteur). Envoyé côté exécuteur à CHAQUE appel .view()
        du code utilisateur (fire-and-forget, un message par appel,
        jamais groupé -- cf. docstring de Image.view(), "au fil de
        l'eau"), relayé par le serveur local (cf. srv_gerer_executer_
        code_image) vers le process principal, qui le retransmet lui-
        même au pilote distant via SA connexion client_t existante (cf.
        _ExecuteurClientTAdaptateur/_sur_executer_code_image_recu) --
        aucune connexion serveurT distante supplémentaire n'est ouverte
        par l'exécuteur lui-même. Thread-safe, même garde que envoyer_
        commande ci-dessus."""
        if self._loop is None or not self._loop.is_running():
            log_dashboard_reseau.warning(f"envoyer_executer_code_image ignoré : pas de boucle réseau active (instance_id={instance_id!r})")
            return
        message = {
            "type": "executer_code_image", "instance_id": instance_id,
            "session_id": session_id, "id_pilote": id_pilote, "image_b64": image_b64,
        }
        if ligne is not None:
            # PATCH sortie en direct (profil isolé) : même canal que Image.view(), mais porte une LIGNE de stdout/stderr.
            message["ligne"] = ligne
        asyncio.run_coroutine_threadsafe(self._envoyer_async(message), self._loop)

    def envoyer_pont_reponse(self, instance_id: str, reponse: dict):
        """AJOUT (pont fichiers pilote <-> clone) -- côté PROCESS PRINCIPAL : transmet à l'exécuteur de `instance_id` la
        réponse du pilote à sa demande de fichier (le serveur local la cible, cf. srv_gerer_pont_reponse)."""
        if self._loop is None or not self._loop.is_running():
            log_dashboard_reseau.warning(f"envoyer_pont_reponse ignoré : pas de boucle réseau active (instance_id={instance_id!r})")
            return
        message = dict(reponse)
        message["type"] = "pont_reponse_executeur"
        message["instance_id"] = instance_id
        asyncio.run_coroutine_threadsafe(self._envoyer_async(message), self._loop)

    def envoyer_regenerer_navigateur_resultat(self, instance_id: str, ok: bool, message: str):
        """AJOUT -- côté PROCESS PRINCIPAL : signale à l'exécuteur de `instance_id` que la
        régénération est terminée (ok=True : le nouveau navigateur est démarré sous le MÊME
        instance_id) ou a échoué. Diffusé par le serveur local à tous les pilotes ; chaque
        exécuteur filtre sur son instance_id."""
        if self._loop is None or not self._loop.is_running():
            log_dashboard_reseau.warning(f"envoyer_regenerer_navigateur_resultat ignoré : pas de boucle réseau active (instance_id={instance_id!r})")
            return
        message_reseau = {
            "type": "regenerer_navigateur_resultat_executeur", "instance_id": instance_id,
            "ok": bool(ok), "message": message,
        }
        asyncio.run_coroutine_threadsafe(self._envoyer_async(message_reseau), self._loop)

    def envoyer_regenerer_navigateur(self, instance_id: str, session_id: str, id_pilote: str,
                                     garder_donnees: bool, relancer: bool):
        """AJOUT -- côté EXÉCUTEUR : demande au process principal de régénérer le
        navigateur de l'instance `instance_id` (fire-and-forget : l'exécuteur sera
        arrêté par le process principal pendant l'opération)."""
        if self._loop is None or not self._loop.is_running():
            log_dashboard_reseau.warning(f"envoyer_regenerer_navigateur ignoré : pas de boucle réseau active (instance_id={instance_id!r})")
            return
        message = {
            "type": "regenerer_navigateur_executeur", "instance_id": instance_id,
            "session_id": session_id, "id_pilote": id_pilote,
            "garder_donnees": bool(garder_donnees), "relancer": bool(relancer),
        }
        asyncio.run_coroutine_threadsafe(self._envoyer_async(message), self._loop)

    # --- Implémentation interne (tourne dans le thread réseau) ---

    def _thread_principal(self):
        self._loop = asyncio.new_event_loop()
        asyncio.set_event_loop(self._loop)
        try:
            self._tache_boucle = self._loop.create_task(self._boucle_async())
            self._loop.run_until_complete(self._tache_boucle)
        except asyncio.CancelledError:
            log_dashboard_reseau.debug("Boucle réseau annulée proprement (arreter())")
        except Exception as e:
            log_dashboard_reseau.error(f"Erreur fatale dans le thread réseau : {e!r}")
            self.echec_connexion.emit(str(e))
        finally:
            self._tache_boucle = None
            self._loop.close()
            self._loop = None

    async def _envoyer_async(self, message: dict):
        # LOG DIAGNOSTIC (demande utilisateur explicite : "enrichir les
        # logs... pour que a tout les niveau on a vraiment une vue
        # densemble") -- comble un trou de visibilité identifié : le log
        # "-> ENVOI commande" (envoyer_commande, thread Qt) confirme
        # seulement que l'envoi a été PLANIFIÉ sur la boucle asyncio du
        # thread réseau (run_coroutine_threadsafe), PAS que ws.send() a
        # réellement eu lieu -- si self._ws est None à cet instant (ex:
        # connexion pas encore établie, ou déjà retombée en reconnexion),
        # le message était perdu EN SILENCE, sans aucune trace dans les
        # logs -- symptôme exact d'une commande visible en "-> ENVOI" côté
        # pilote mais jamais suivie d'un "reçu" côté serveur.
        requete_id = message.get("requete_id")
        action = message.get("action")
        if self._ws is None:
            log_dashboard_reseau.error(
                f"[{self.id_client}] _envoyer_async(action={action!r} requete_id={requete_id!r}) : "
                f"ÉCHEC -- self._ws est None (pas connecté / connexion pas encore établie) -- "
                f"message PERDU, aucun envoi réseau n'a eu lieu"
            )
            return
        debut = _horloge()
        try:
            await self._ws.send(json.dumps(message))
            log_dashboard_reseau.debug(
                f"[{self.id_client}] _envoyer_async(action={action!r} requete_id={requete_id!r}) : "
                f"ws.send() confirmé en {(_horloge() - debut) * 1000:.1f}ms"
            )
        except websockets.exceptions.ConnectionClosed as e:
            log_dashboard_reseau.warning(
                f"[{self.id_client}] Envoi de '{message.get('type')}' (action={action!r} "
                f"requete_id={requete_id!r}) impossible : connexion déjà fermée ({e!r}) -- message PERDU"
            )
        except Exception as e:
            # LOG DIAGNOSTIC : filet de sécurité -- avant ce patch, toute
            # exception AUTRE que ConnectionClosed (ex: erreur de
            # sérialisation JSON, erreur interne à websockets) remontait
            # silencieusement jusqu'à _boucle_async sans log explicite au
            # niveau de CET envoi précis, rendant le diagnostic quasi
            # impossible a posteriori.
            log_dashboard_reseau.error(
                f"[{self.id_client}] _envoyer_async(action={action!r} requete_id={requete_id!r}) : "
                f"exception inattendue -- {e!r} -- message probablement PERDU"
            )

    async def _boucle_async(self):
        # Boucle de retry (pattern repris du prototype validé) : serveur.py
        # est lancé juste avant en subprocess.Popen depuis MainWindow, mais
        # a besoin d'un court instant pour importer websockets/asyncio et
        # ouvrir sa socket -- sans retry, la toute première tentative de
        # connexion échoue quasi systématiquement (ConnectionRefusedError)
        # avant que le serveur soit prêt. 50 tentatives x 0.2s = 10s max,
        # largement suffisant (le serveur est prêt en pratique en ~0.3s).
        for tentative in range(50):
            if self._arret_demande.is_set():
                return
            try:
                self._ws = await websockets.connect(self.server_url, max_size=None)
                break
            except OSError as e:
                if tentative == 0:
                    log_dashboard_reseau.debug(f"Serveur pas encore prêt ({e!r}), nouvel essai...")
                await asyncio.sleep(0.2)
        else:
            log_dashboard_reseau.error(f"Connexion au serveur impossible après 10s ({self.server_url})")
            self.echec_connexion.emit("Impossible de joindre le serveur (délai dépassé)")
            return

        await self._ws.send(json.dumps({"type": "register", "role": self.role, "id": self.id_client}))
        self.connecte.emit()
        log_dashboard_reseau.info(f"Client réseau ({self.role} '{self.id_client}') connecté au serveur ({self.server_url})")

        try:
            async for brut in self._ws:
                self._traiter_message(brut)
        except websockets.exceptions.ConnectionClosed as e:
            # LOG DIAGNOSTIC (bug "2e test qui bloque") : le code/raison de
            # fermeture tranche immédiatement entre les hypothèses :
            #   - code 1000/1001 : fermeture "propre" (côté serveur ou
            #     réseau), pas une exception Python de notre côté ;
            #   - code 1011 : erreur interne serveur (ex: exception non
            #     catchée dans gerer_connexion côté serveur.py) ;
            #   - code 1006 (ou rcvd/sent = None) : coupure anormale, très
            #     probablement un ping_timeout de la lib websockets (pas de
            #     pong reçu à temps) -- confirme l'hypothèse "boucle réseau
            #     bloquée" si elle se reproduit systématiquement au même
            #     intervalle (~ping_interval + ping_timeout).
            log_dashboard_reseau.warning(
                f"[{self.id_client}] Connexion au serveur fermée -- "
                f"code_recu={getattr(e.rcvd, 'code', None)} raison_recue={getattr(e.rcvd, 'reason', None)!r} "
                f"code_envoye={getattr(e.sent, 'code', None)} raison_envoyee={getattr(e.sent, 'reason', None)!r}"
            )
        except asyncio.CancelledError:
            # arreter() annule cette tâche -- fermeture explicite du
            # websocket ici (même coroutine, pas de tâche concurrente ==
            # pas de deadlock, cf. diagnostic dans arreter()) avant de
            # laisser l'annulation se propager normalement.
            log_dashboard_reseau.info(f"[{self.id_client}] Boucle réseau annulée (arreter() demandé)")
            if self._ws is not None:
                await self._ws.close()
            raise
        finally:
            log_dashboard_reseau.info(f"[{self.id_client}] Émission du signal deconnecte()")
            self.deconnecte.emit()

    def _traiter_message(self, brut: str):
        try:
            data = json.loads(brut)
        except json.JSONDecodeError:
            log_dashboard_reseau.warning(f"Message non-JSON reçu du serveur : {brut[:100]!r}")
            return
        type_message = data.get("type")
        if type_message == "instances_list":
            instances = data.get("instances", [])
            # PATCH (nettoyage des logs -- problème #3) -- en INFO, on ne
            # logue plus QUE l'événement déclencheur et le nombre
            # d'instances (jamais le contenu complet, qui peut arriver
            # très fréquemment y compris pour des pilotes temporaires qui
            # se connectent/déconnectent aussitôt). Le détail complet
            # (liste entière) reste disponible en DEBUG, et seulement
            # lorsque son CONTENU a changé depuis le dernier reçu (hash
            # comparé ci-dessous) -- pas à chaque réception identique.
            log_dashboard_reseau.info(f"[{self.id_client}] <- instances_list ({len(instances)} instance(s))")
            if log_dashboard_reseau.isEnabledFor(logging.DEBUG):
                hash_liste = hashlib.sha256(
                    json.dumps(instances, sort_keys=True, default=str).encode("utf-8")
                ).hexdigest()
                if hash_liste != self._hash_derniere_liste_instances:
                    self._hash_derniere_liste_instances = hash_liste
                    log_dashboard_reseau.debug(f"[{self.id_client}] <- instances_list (contenu modifié) : {instances}")
            self.liste_instances_recue.emit(instances)
        elif type_message == "frame":
            # DEBUG (pas INFO) : le streaming tourne à ~10 FPS par défaut
            # (cf. instance_nodriver.py, FPS_DEFAUT) -- en INFO, ça
            # inonderait le log. Activer DEBUG si besoin de confirmer que
            # les frames continuent bien d'arriver juste avant la coupure.
            log_dashboard_reseau.debug(
                f"[{self.id_client}] <- frame (instance={data.get('instance_id')} seq={data.get('seq')})"
            )
            self.frame_recue.emit(data.get("instance_id", ""), data.get("image_b64", ""), data.get("seq", 0))
        elif type_message == "command_result":
            # DÉSACTIVÉ (demande explicite utilisateur : "logs les plus
            # bruyants" -- cf. analyse logs.txt, ~605 occurrences) --
            # passé en debug, réactivable via la config du logger.
            log_dashboard_reseau.debug(
                f"[{self.id_client}] <- command_result : requete_id={data.get('requete_id')!r} "
                f"ok={data.get('ok')!r} error={data.get('error')!r}"
            )
            self.command_result_recu.emit(data)
        elif type_message == "executer_code":
            # AJOUT (cf. docstring de executer_code_recu) -- reçu côté
            # exécuteur uniquement (le serveur local ne relaie jamais ce
            # type vers un pilote, cf. srv_gerer_executer_code).
            log_dashboard_reseau.info(
                f"[{self.id_client}] <- executer_code (instance_id={data.get('instance_id')!r}, "
                f"requete_id={data.get('requete_id')!r})"
            )
            self.executer_code_recu.emit(data)
        elif type_message == "executer_code_resultat":
            # AJOUT (cf. docstring de executer_code_resultat_recu) -- reçu
            # côté process principal (pilote) uniquement (cf. srv_gerer_
            # executer_code_resultat, qui ne relaie jamais ce type vers un
            # exécuteur).
            log_dashboard_reseau.info(
                f"[{self.id_client}] <- executer_code_resultat (instance_id={data.get('instance_id')!r}, "
                f"requete_id={data.get('requete_id')!r}, ok={data.get('ok')!r})"
            )
            self.executer_code_resultat_recu.emit(data)
        elif type_message == "executer_code_image":
            # AJOUT (Section 8 -- Image.view() depuis le process
            # exécuteur, cf. docstring de executer_code_image_recu) --
            # reçu côté process principal (pilote) uniquement, un
            # message par appel .view() du code utilisateur (jamais
            # groupé avec executer_code_resultat, cf. srv_gerer_
            # executer_code_image).
            log_dashboard_reseau.debug(
                f"[{self.id_client}] <- executer_code_image (instance_id={data.get('instance_id')!r}, "
                f"{len(data.get('image_b64', ''))} caractère(s) b64)"
            )
            self.executer_code_image_recu.emit(data)
        elif type_message == "pont_reponse_executeur":
            # AJOUT (pont fichiers pilote <-> clone) -- reçu côté exécuteur uniquement.
            self.pont_reponse_recue.emit(data)
        elif type_message == "regenerer_navigateur_executeur":
            # AJOUT (regenerer_navigateur() depuis une cellule) -- reçu côté process principal.
            log_dashboard_reseau.info(
                f"[{self.id_client}] <- regenerer_navigateur_executeur (instance_id={data.get('instance_id')!r})"
            )
            self.regenerer_navigateur_recu.emit(data)
        elif type_message == "regenerer_navigateur_resultat_executeur":
            # AJOUT -- reçu côté exécuteur (client pilote compagnon) : débloque regenerer_navigateur().
            log_dashboard_reseau.info(
                f"[{self.id_client}] <- regenerer_navigateur_resultat_executeur (instance_id={data.get('instance_id')!r}, ok={data.get('ok')})"
            )
            self.regenerer_navigateur_resultat_recu.emit(data)
        elif type_message == "error":
            log_dashboard_reseau.warning(f"[{self.id_client}] <- error : {data.get('message')!r}")
            # FIX : les erreurs de link (gerer_link, serveur.py) portent
            # maintenant instance_id -- routées en plus vers liaison_echouee,
            # que InstanceApercuScreen._on_instance_changed écoute désormais
            # pour ne pas continuer comme si la liaison avait réussi.
            instance_id_erreur = data.get("instance_id")
            if instance_id_erreur is not None:
                self.liaison_echouee.emit(instance_id_erreur, data.get("message", "(erreur sans message)"))
            self.erreur_recue.emit(data.get("message", "(erreur sans message)"))
        elif type_message == "unlinked":
            log_dashboard_reseau.info(
                f"[{self.id_client}] <- unlinked : instance_id={data.get('instance_id')!r} raison={data.get('raison')!r}"
            )
            self.instance_deliee.emit(data.get("instance_id", ""), data.get("raison", ""))
        elif type_message == "force_unlink_ok":
            log_dashboard_reseau.info(
                f"[{self.id_client}] <- force_unlink_ok : instance_id={data.get('instance_id')!r} "
                f"ancien_pilote_id={data.get('ancien_pilote_id')!r}"
            )
            self.force_unlink_ok_recu.emit(data.get("instance_id", ""), data.get("ancien_pilote_id") or "")
        elif type_message in ("registered", "link_ok"):
            log_dashboard_reseau.info(f"[{self.id_client}] <- {type_message} : {data}")
            if type_message == "link_ok":
                self.link_ok_recu.emit(data.get("instance_id", ""))
        else:
            log_dashboard_reseau.debug(f"[{self.id_client}] Message non traité : {type_message}")


# Alias de rétrocompatibilité -- ClientReseauDashboard était le nom
# original de la classe, avant sa généralisation pour être réutilisée par
# les onglets TestComposantScreen (role="pilote") en plus de DashboardScreen.
ClientReseauDashboard = ClientReseauAutoniaX


# ---------------------------------------------------------------------------
# Moteur d'exécution des cellules de Task (cf. plan de changement, point 5) :
# pont entre un script Python SYNCHRONE (exécuté ligne par ligne, comme
# n'importe quel code -- ex: "if claude_call.visible(): print(...)") et le
# réseau ASYNCHRONE (ClientReseauAutoniaX, WebSocket, command_result
# corrélés par requete_id) qui pilote réellement les instances nodriver.
#
# Décisions explicites utilisateur (cf. discussion) :
#   - Le script tourne dans un THREAD DÉDIÉ à cette exécution de cellule
#     (pas le thread Qt principal) -- pour permettre PLUSIEURS Tasks en
#     parallèle sur plusieurs instances sans qu'un script qui bloque/plante
#     gèle toute l'interface graphique.
#   - UN SEUL pilote logique (id_client unique, partagé par TOUTES les
#     exécutions de cellule, quel que soit le Task) pilote effectivement
#     les instances -- jamais de pilotage multiple/concurrent d'une même
#     instance par deux connexions distinctes de notre propre moteur.
#   - Une instance déjà utilisée par un autre Task EN COURS D'EXÉCUTION
#     (cf. registre local TaskConfigScreen._instances_occupees_par_nos_tasks)
#     est refusée AVANT même d'envoyer un "link" -- jamais de vol de
#     liaison entre deux de nos propres Tasks (contrairement au
#     comportement par défaut du serveur, qui ferait une reprise
#     automatique et silencieuse, cf. srv_gerer_link -- ce filet de
#     sécurité est donc côté client, pas délégué au serveur).
#   - Chaque appel de méthode sur un ComposantExecutable (visible/click/...)
#     bloque UNIQUEMENT le thread de cette exécution de cellule (via
#     threading.Event), jamais le thread Qt principal -- celui-ci continue
#     de tourner normalement (réseau, interface, autres Tasks) pendant
#     l'attente.
# ---------------------------------------------------------------------------
class InstanceOccupeeError(Exception):
    """Levée quand une instance nécessaire à cette cellule est déjà
    occupée par un AUTRE de nos propres Tasks en cours d'exécution (cf.
    TaskConfigScreen._instances_occupees_par_nos_tasks) -- distincte d'un
    échec réseau générique, pour que l'appelant puisse afficher un message
    clair nommant le Task fautif plutôt qu'une erreur réseau opaque."""
    pass


class ServiceAPINonLieError(Exception):
    """Levée AVANT tout lancement de thread si un ServiceAPI importé dans
    le Task n'a pas encore d'instance_id choisi (cf. Task.
    services_api_importes, instance_id == "") -- vérifié pour TOUS les
    ServiceAPI importés du Task, pas seulement ceux utilisés par la
    cellule (décision explicite utilisateur), avant de démarrer quoi que
    ce soit."""
    pass


# PATCH (bug signalé : "TabError: inconsistent use of tabs and spaces in
# indentation" à l'exécution d'une cellule/du notebook, alors que le code
# semble visuellement correct dans l'éditeur -- cf. discussion utilisateur).
#
# CAUSE : l'éditeur de script (TaskScriptEditor) autorise, selon la façon
# dont chaque ligne a été tapée/collée/générée par l'auto-complétion, un
# mélange de tabulations et d'espaces en début de ligne. Une tabulation
# s'affiche avec la même largeur visuelle que plusieurs espaces dans
# l'éditeur -- le mélange est donc invisible à l'œil -- mais reste un
# caractère différent pour l'interpréteur Python, qui refuse ce mélange
# DANS UN MÊME BLOC (TabError), même quand l'alignement affiché est
# cohérent.
#
# FIX (demande explicite utilisateur : "je veux que a l'execution d'une
# cellule ou du notebook ca se repare seul") : normalise l'indentation de
# TOUT le code juste avant chaque exec() (cf. _thread_execution plus bas),
# en convertissant les tabulations d'indentation en espaces -- de façon à
# ce qu'un TabError dû à un mélange tab/espaces ne puisse plus jamais se
# produire, quelle que soit la façon dont le code a été tapé. Fait AUTOMATIQUEMENT
# et SILENCIEUSEMENT (pas de dialogue, pas de confirmation) à chaque
# exécution -- décision explicite utilisateur, pour ne jamais bloquer une
# exécution sur ce problème.
def _normaliser_indentation_tabs_espaces(code: str, largeur_tab: int = 4) -> str:
    """Convertit les tabulations D'INDENTATION (début de ligne uniquement)
    en espaces, ligne par ligne, sans toucher au reste de la ligne --
    important pour ne jamais altérer une tabulation qui apparaîtrait à
    l'intérieur d'une chaîne de caractères en plein milieu de ligne (ex:
    "texte\\tautre_texte" tapé littéralement dans un paste()/saisir()).

    Utilise str.expandtabs(largeur_tab), mais appliqué UNIQUEMENT au
    préfixe d'espacement de chaque ligne (tout caractère non-espace/tab
    stoppe le remplacement) -- volontairement pas un simple
    code.expandtabs(4) sur le texte entier, qui aurait aussi décalé des
    tabulations légitimes ailleurs sur la ligne (ex: dans un commentaire
    ou une chaîne alignant du texte en colonnes).

    Idempotent : ré-appliqué sur du code déjà propre (tout en espaces),
    ne change rien.

    LIMITE CONNUE : corrige spécifiquement le cas rencontré (une tab
    représentant la MÊME profondeur logique que les espaces des lignes
    voisines, juste invisible à l'œil -- le cas de très loin le plus
    fréquent, notamment via l'auto-complétion de l'éditeur). Si une tab
    et les espaces voisins ne correspondent PAS à la même profondeur
    visuelle (un vrai mélange incohérent, pas juste "tab au lieu
    d'espaces au même endroit"), la normalisation supprime bien le
    TabError mais peut laisser un IndentationError -- à ce stade, c'est
    un vrai problème de structure du script à corriger côté utilisateur,
    plus un simple artefact tab/espace."""
    lignes_normalisees = []
    for ligne in code.split("\n"):
        i = 0
        while i < len(ligne) and ligne[i] in (" ", "\t"):
            i += 1
        prefixe, reste = ligne[:i], ligne[i:]
        lignes_normalisees.append(prefixe.expandtabs(largeur_tab) + reste)
    return "\n".join(lignes_normalisees)


# PATCH (demande explicite utilisateur, suite au TabError ci-dessus : "je
# veux que tu met ce bouton donc de auto-correction parmi les bouton de
# option de cellule [...] c'est le user qui doit declencher cela, pas
# toujours automatique") -- réparation plus poussée que la simple
# normalisation tab/espaces ci-dessus : corrige aussi les IndentationError
# ("unexpected indent" / "expected an indented block" / "unindent does not
# match any outer indentation level"), qui peuvent survenir même sur du
# code déjà tout en espaces (ex: une ligne collée avec 2 espaces de trop,
# une ligne oubliée en dehors d'un bloc if/while). Contrairement à
# _normaliser_indentation_tabs_espaces (aucune ambiguïté possible : une
# tabulation EST un nombre d'espaces fixe), reconstruire la bonne
# profondeur d'une ligne mal indentée revient à DEVINER l'imbrication de
# blocs voulue -- décision explicite utilisateur de ne JAMAIS faire ça
# automatiquement à l'exécution (contrairement au fix tab/espaces
# ci-dessus, sans ambiguïté) : ce fix est exposé comme une action
# explicite déclenchée par bouton dans le bandeau de la cellule (cf.
# TaskCelluleWidget.bouton_reparer_indentation), jamais appelée depuis
# _thread_execution.
def reparer_structure_indentation(code: str, largeur_tab: int = 4) -> str:
    """Reconstruit une indentation cohérente ligne par ligne, en "snappant"
    chaque ligne sur un niveau de bloc VALIDE plutôt que de conserver son
    indentation brute (potentiellement fautive) :
      - Une ligne suivant directement une ligne ouvrant un bloc (qui se
        termine par ":", hors commentaire) est toujours replacée à
        pile_niveaux[-1] + largeur_tab, quelle que soit sa propre
        indentation brute -- évite qu'une sur-indentation accidentelle de
        LA PREMIÈRE ligne d'un bloc ne se propage aux lignes suivantes du
        même bloc (cf. tests : "if x:\\n        y = 1" à 8 espaces
        devient bien 4, pas 8).
      - Toute autre ligne est dépilée jusqu'au premier niveau connu
        <= son indentation brute, puis alignée exactement sur ce niveau
        (jamais un niveau inventé hors contexte d'ouverture de bloc) --
        c'est ce qui répare un "unexpected indent" (ligne trop indentée
        sans qu'aucun bloc ne l'ait ouverte) aussi bien qu'un dedent qui
        ne correspondait à aucun niveau connu.
      - Lignes vides/commentaires : indentation simplement normalisée
        (tabs -> espaces), jamais utilisées pour raisonner sur la pile de
        blocs (un commentaire mal indenté ne doit pas fausser la
        détection du niveau réel du code qui l'entoure).

    Applique D'ABORD _normaliser_indentation_tabs_espaces (cf. ci-dessus)
    pour que la pile de niveaux raisonne sur des espaces uniquement,
    jamais sur un mélange tab/espaces.

    Idempotent sur du code déjà correctement indenté (aucun changement,
    cf. tests) -- une réparation "en trop" sur du code déjà propre serait
    un bug, pas juste une réparation inutile.

    NE GARANTIT PAS un code syntaxiquement valide dans tous les cas : une
    IndentationError peut avoir une cause plus profonde qu'un simple
    décalage de profondeur (ex: bloc composé de deux morceaux disjoints
    qu'aucun réagencement d'indentation seul ne peut réconcilier sans
    changer le sens du script), et une réparation ne peut évidemment rien
    pour un tout autre type d'erreur de syntaxe (parenthèse non fermée,
    etc.) -- l'appelant doit retenter la compilation après coup et
    afficher un message clair si l'erreur persiste plutôt que de supposer
    un succès."""
    code = _normaliser_indentation_tabs_espaces(code, largeur_tab)
    lignes = code.split("\n")
    resultat: list[str] = []
    pile_niveaux = [0]
    attend_nouveau_bloc = False

    for ligne in lignes:
        i = 0
        while i < len(ligne) and ligne[i] == " ":
            i += 1
        prefixe, contenu = ligne[:i], ligne[i:]
        indent_brut = len(prefixe)

        if contenu.strip() == "" or contenu.lstrip().startswith("#"):
            # Ligne vide/commentaire : recopiée telle quelle, ne
            # participe jamais au calcul de la pile de blocs.
            resultat.append(ligne)
            continue

        if attend_nouveau_bloc:
            indent_final = pile_niveaux[-1] + largeur_tab
            pile_niveaux.append(indent_final)
        else:
            while len(pile_niveaux) > 1 and indent_brut < pile_niveaux[-1]:
                pile_niveaux.pop()
            indent_final = pile_niveaux[-1]

        resultat.append((" " * indent_final) + contenu)
        contenu_sans_fin = contenu.rstrip()
        attend_nouveau_bloc = contenu_sans_fin.endswith(":") and not contenu_sans_fin.startswith("#")

    return "\n".join(resultat)


# AJOUT (demande explicite utilisateur, suite aux erreurs SyntaxError/
# IndentationError rencontrées : "es ce que on peu modifier le code de
# tels sorte que la ligne specifique en question apprait avec la ligne
# rouge" -- surligner dans l'ÉDITEUR la ligne exacte qui a fait échouer
# l'exécution) -- extrait le numéro de ligne fautif (1-based, comme
# affiché dans l'éditeur) depuis une exception levée par exec(code,
# namespace), cf. appelant dans _thread_execution.
#
# Deux cas bien distincts, cf. tests avant intégration :
#   - SyntaxError (et ses sous-classes IndentationError/TabError) : lève
#     à la COMPILATION, avant toute exécution -- le numéro de ligne est
#     porté directement par l'exception (e.lineno), il n'y a pas de
#     __traceback__ exploitable de la même façon.
#   - Toute autre exception (runtime, levée PENDANT l'exécution du code
#     utilisateur) : le numéro de ligne pertinent est celui de la
#     DERNIÈRE frame du traceback dont filename == "<string>" (le nom
#     donné au code utilisateur par exec(), cf. compile(code, "<string>",
#     "exec") plus bas) -- c'est le point d'échec réel le plus profond
#     dans le script de la cellule, jamais le point d'appel initial
#     (cohérent avec la flèche "^^^^" du traceback standard affiché par
#     Python, qui pointe toujours sur cette frame la plus profonde).
#     Les frames dont filename != "<string>" (code interne d'AutoniaX,
#     ex: ComposantExecutable.click) sont ignorées : inutiles à
#     surligner dans l'éditeur de script, qui n'affiche que le code de
#     la cellule.
def _extraire_ligne_erreur(exc: BaseException) -> Optional[int]:
    """Retourne le numéro de ligne (1-based) à surligner dans
    TaskScriptEditor pour cette exception, ou None si indéterminable
    (aucune frame <string> dans le traceback -- ne devrait normalement
    pas arriver pour une exception levée par exec(code, namespace), mais
    on ne présume jamais et on renvoie None plutôt qu'un mauvais numéro
    qui surlignerait la mauvaise ligne)."""
    if isinstance(exc, SyntaxError):
        return exc.lineno
    frames_code_utilisateur = [
        frame for frame in traceback.extract_tb(exc.__traceback__)
        if frame.filename == "<string>"
    ]
    if not frames_code_utilisateur:
        return None
    return frames_code_utilisateur[-1].lineno


class _TamponStdoutLive(io.StringIO):
    """PATCH logs en direct (local) : io.StringIO identique à l'original (getvalue() inchangé) qui transmet en plus
    chaque morceau écrit à `sur_ecriture(texte)` au moment même de l'écriture. Appelé depuis le thread d'exécution :
    `sur_ecriture` ne doit qu'émettre un signal Qt."""

    def __init__(self, sur_ecriture):
        super().__init__()
        self._sur_ecriture = sur_ecriture

    def write(self, s):
        n = super().write(s)
        if s and self._sur_ecriture is not None:
            try:
                self._sur_ecriture(s)
            except Exception:
                pass   # l'affichage live ne doit jamais faire échouer le script utilisateur
        return n


class MoteurExecutionCellule(QObject):
    """Pont thread <-> réseau pour UNE exécution de cellule de Task.

    Cycle de vie complet, du clic ▶ jusqu'au résultat affiché :
      1) __init__ : vérifie que tous les ServiceAPI importés du Task ont
         une instance_id non vide (cf. ServiceAPINonLieError), puis que
         chaque instance nécessaire n'est pas déjà occupée par un AUTRE de
         nos Tasks (cf. InstanceOccupeeError) -- tout ceci AVANT de
         démarrer le moindre thread.
      2) lancer(namespace, code) : démarre le thread dédié, qui lie
         (link) chaque instance nécessaire une par une (bloquant, mais
         seulement CE thread), puis exec() le code utilisateur dans le
         namespace fourni (contenant les ComposantExecutable + tout
         builtin normal), en capturant stdout et toute exception.
      3) À la fin (succès, erreur, exception Python) : délie (unlink)
         toutes les instances qu'IL a lui-même liées pour cette exécution,
         retire l'entrée du registre local, puis appelle
         callback_termine(dict resultat) -- CE callback est réinjecté sur
         le thread Qt principal via QTimer.singleShot(0, ...) depuis le
         thread d'exécution (jamais d'appel direct à du code Qt/widget
         depuis le thread dédié, cf. contrainte Qt standard : les widgets
         ne doivent être touchés que depuis le thread qui les possède).

    UN SEUL client_reseau (ClientReseauAutoniaX, id_client partagé, cf.
    docstring de la classe et TaskConfigScreen._client_reseau_execution)
    est réutilisé par TOUTES les instances de MoteurExecutionCellule --
    passé en argument, jamais recréé ici : recréer un client par exécution
    recréerait un id_client différent à chaque fois, et donc autant de
    pilotes distincts que d'exécutions, cassant la garantie "un seul
    pilote logique" qui permet au registre local seul de suffire à éviter
    les conflits (cf. discussion utilisateur : sans ça, il faudrait
    re-gérer la reprise automatique/silencieuse du serveur, qu'on veut
    justement éviter)."""

    TIMEOUT_LINK_MS = 8000
    TIMEOUT_COMMANDE_MS = 15000  # plus long que SequenceurActionReseau (8s) : inclut le temps
    # de detection OpenCV (capture_propre + matchTemplate/ORB/SSIM), pas seulement l'aller-retour réseau.

    # BUGFIX : remplace l'ancien QTimer.singleShot(0, ...) utilisé pour
    # réinjecter callback_termine sur le thread Qt principal depuis le
    # thread d'exécution -- QTimer.singleShot lie le timer au thread qui
    # l'appelle (cf. doc Qt : "Qt uses the timer's thread affinity to
    # determine which thread will emit the timeout() signal ... it is not
    # possible to start a timer from another thread"). Appelé depuis un
    # threading.Thread SANS event loop Qt, ce timer n'a jamais de thread
    # capable de le faire expirer -- le callback n'était donc JAMAIS
    # exécuté, silencieusement (pas d'exception), laissant la cellule
    # bloquée pour toujours dans _moteurs_en_cours et aucune sortie
    # affichée. Un signal Qt classique + Qt.QueuedConnection (même pattern
    # que command_result_recu/link_ok_recu ci-dessous, qui eux fonctionnent
    # bien) traverse les threads de façon fiable, contrairement à
    # QTimer.singleShot.
    # Même correctif que _resultat_pret ci-dessus, pour le callback
    # optionnel sur_instance_liberee (déclenché depuis _delier_instance,
    # lui aussi appelé depuis le thread d'exécution).
    _instance_liberee_signal = Signal(str)
    _resultat_pret = Signal(dict)
    # PATCH logs en direct (local) : (cellule_id, morceau de stdout), émis depuis le thread d'exécution.
    sortie_live = Signal(str, str)

    def __init__(
        self,
        client_reseau: "ClientReseauAutoniaX",
        task: "Task",
        cellule_id: str,
        instances_occupees_registre: dict,
        services_api_utilises: Optional[set] = None,
        sur_instance_liberee: Optional[callable] = None,
    ):
        """instances_occupees_registre : LE MÊME dict que
        TaskConfigScreen._instances_occupees_par_nos_tasks (passé par
        référence, jamais copié) -- lu pour détecter un conflit AVANT
        démarrage, puis écrit (ajout à lancer(), retrait à la fin) pour
        que le PROCHAIN menu de sélection d'instance (cf.
        _demande_selection_instance) voie l'état à jour.

        services_api_utilises : noms des ServiceAPI dont au moins un
        composant est RÉELLEMENT référencé dans le code de cette cellule
        précise (cf. TaskConfigScreen._services_api_utilises_dans_code) --
        décision révisée : seuls CEUX-LÀ doivent avoir une instance liée
        pour que l'exécution démarre, pas la totalité de
        task.services_api_importes. Un Task peut légitimement importer
        plusieurs ServiceAPI (dont certains pas encore liés à une
        instance) sans que ça bloque l'exécution d'une cellule qui n'en
        utilise qu'un seul. None = comportement le plus restrictif (tous
        les ServiceAPI importés sont considérés utilisés) -- utilisé
        seulement si l'appelant ne peut pas analyser le code (ne devrait
        pas arriver en usage normal, cf. _executer_cellule).

        sur_instance_liberee(instance_id) : callback optionnel, appelé
        (sur le thread Qt principal, cf. docstring de la classe) chaque
        fois qu'une instance est déliée en fin d'exécution -- utile pour
        rafraîchir un affichage de statut sans attendre le prochain
        rafraîchissement explicite de la liste."""
        super().__init__()
        self.client_reseau = client_reseau
        self.task = task
        self.cellule_id = cellule_id
        self._registre = instances_occupees_registre
        self._sur_instance_liberee = sur_instance_liberee
        self._callback_termine_courant: Optional[callable] = None
        # QueuedConnection explicite (comme les 3 autres connexions
        # ci-dessous) : garantit que le slot s'exécute sur le thread
        # propriétaire de CET objet (thread Qt principal, puisque
        # MoteurExecutionCellule est créé depuis _executer_cellule sur ce
        # thread-là), peu importe le thread depuis lequel .emit() est
        # appelé (ici : le thread d'exécution de la cellule).
        self._resultat_pret.connect(self._sur_resultat_pret, Qt.QueuedConnection)
        if self._sur_instance_liberee is not None:
            self._instance_liberee_signal.connect(self._sur_instance_liberee, Qt.QueuedConnection)

        noms_a_verifier = (
            services_api_utilises if services_api_utilises is not None
            else set(task.services_api_importes)
        )

        # --- Vérification service_api_importes AVANT tout -- SEULEMENT
        # pour les ServiceAPI réellement utilisés dans le code de cette
        # cellule (cf. services_api_utilises ci-dessus) ---
        manquants = [
            nom for nom in noms_a_verifier
            if not task.services_api_importes.get(nom, "")
        ]
        if manquants:
            raise ServiceAPINonLieError(
                f"ServiceAPI sans instance liée : {', '.join(manquants)} -- "
                f"choisissez une instance pour chacun avant d'exécuter ce Task."
            )

        # --- Détection de conflit AVANT tout lancement de thread (cf.
        # décision utilisateur : refus explicite, jamais de vol de
        # liaison entre deux de nos propres Tasks) -- limitée elle aussi
        # aux seules instances des ServiceAPI utilisés dans cette cellule ---
        instances_necessaires = {
            task.services_api_importes[nom] for nom in noms_a_verifier
            if task.services_api_importes.get(nom, "")
        }
        for instance_id in instances_necessaires:
            occupation = self._registre.get(instance_id)
            if occupation is not None:
                occ_task_id, occ_task_nom, _occ_cellule_id = occupation
                if occ_task_id != task.id:
                    raise InstanceOccupeeError(
                        f"Instance « {instance_id} » déjà utilisée par le Task « {occ_task_nom} » "
                        f"(en cours d'exécution) -- arrêtez-le avant de relancer ce Task."
                    )
        self._instances_necessaires = instances_necessaires

        # BUGFIX (diagnostic double-exécution -- cf. SPEC vérification
        # double-exécution) : identifiant UNIQUE par exécution (donc par
        # objet MoteurExecutionCellule, puisqu'un nouvel objet est créé à
        # chaque relance), distinct de self.cellule_id qui, lui, identifie
        # la CELLULE et reste donc IDENTIQUE entre deux exécutions
        # successives de la même cellule (relance après arrêt,
        # notamment). Jusqu'ici, impossible de savoir depuis les seuls
        # logs si une commande réseau donnée provient de l'exécution EN
        # COURS ou d'un thread zombie abandonné par un arreter()
        # précédent sur cette même cellule, les deux logguant sous le
        # même préfixe [cellule_id]. Loggué dans lancer(), arreter() et
        # chaque commande de _appeler() (cf. leurs sites respectifs).
        self._execution_id = uuid.uuid4().hex[:8]

        self._thread: Optional[threading.Thread] = None
        # Levé par arreter() (thread Qt principal, cf. docstring de la
        # méthode) -- threading.Event, donc lecture/écriture thread-safe
        # depuis le thread d'exécution (_terminer) comme depuis le thread
        # Qt principal. Une fois levé, _terminer ignore tout résultat qui
        # arriverait quand même plus tard du thread daemon abandonné : on
        # ne peut pas tuer un threading.Thread de force sans danger de
        # corruption (cf. discussion utilisateur), donc on le laisse
        # mourir seul en arrière-plan (daemon=True, cf. lancer()) plutôt
        # que d'attendre ou de le couper brutalement.
        self._arrete = threading.Event()
        # BUGFIX (retour utilisateur explicite : "je stoppe l'exécution,
        # sa naffiche pas de sortie") -- référence vers le io.StringIO()
        # de CETTE exécution, posée par _thread_execution juste avant
        # exec() (cf. plus bas). Avant cet ajout, tampon_stdout était une
        # simple variable LOCALE à _thread_execution, invisible depuis
        # arreter() (appelée sur le thread Qt principal, sur ce même
        # objet mais un thread différent) : tout ce que le script avait
        # déjà imprimé au moment du clic "Tout arrêter" était donc
        # définitivement perdu pour l'affichage (seul log_cellule, cf.
        # _terminer, en gardait une trace tronquée à 500 caractères).
        # None tant qu'aucune exécution n'a démarré -- lecture en
        # best-effort depuis arreter() (StringIO.getvalue() est une
        # simple lecture, pas d'écriture concurrente à protéger ici,
        # même esprit "best effort, jamais bloquant" que le reste de
        # cette classe, cf. docstring de arreter()).
        self._tampon_stdout: Optional[io.StringIO] = None
        # {requete_id: (threading.Event, dict résultat rempli au réveil)}
        self._callbacks_en_attente: dict[str, dict] = {}
        self._callbacks_lock = threading.Lock()
        self.client_reseau.command_result_recu.connect(self._sur_command_result, Qt.QueuedConnection)
        self.client_reseau.link_ok_recu.connect(self._sur_link_ok, Qt.QueuedConnection)
        self.client_reseau.liaison_echouee.connect(self._sur_liaison_echouee, Qt.QueuedConnection)
        # {instance_id: threading.Event} -- posé juste avant l'envoi du
        # "link", levé par _sur_link_ok/_sur_liaison_echouee (thread Qt
        # principal, via les connexions ci-dessus) pour réveiller le
        # thread d'exécution qui attend cette liaison précise.
        self._events_link: dict[str, threading.Event] = {}
        self._resultats_link: dict[str, bool] = {}  # instance_id -> succès (rempli avant l'event.set())

    # ------------------------------------------------------------------
    # Slots Qt (tournent sur le thread Qt principal, cf. Qt.QueuedConnection
    # ci-dessus -- garantit qu'ils s'exécutent bien là où le signal a été
    # émis à l'origine, jamais sur le thread d'exécution de la cellule)
    # ------------------------------------------------------------------
    def _sur_command_result(self, data: dict):
        requete_id = data.get("requete_id")
        with self._callbacks_lock:
            entree = self._callbacks_en_attente.get(requete_id)
        if entree is None:
            return  # pas pour nous (autre exécution, ou déjà expiré par timeout)
        event, boite_resultat = entree
        boite_resultat["data"] = data
        event.set()

    def _sur_link_ok(self, instance_id: str):
        event = self._events_link.get(instance_id)
        if event is None:
            return
        self._resultats_link[instance_id] = True
        event.set()

    def _sur_liaison_echouee(self, instance_id: str, message: str):
        event = self._events_link.get(instance_id)
        if event is None:
            return
        self._resultats_link[instance_id] = False
        event.set()

    # ------------------------------------------------------------------
    # API bloquante, appelée UNIQUEMENT depuis le thread d'exécution dédié
    # (jamais depuis le thread Qt principal -- bloquerait l'UI entière,
    # exactement ce qu'on cherche à éviter).
    # ------------------------------------------------------------------
    def _lier_instance_si_besoin(self, instance_id: str) -> bool:
        """Envoie "link" et attend la confirmation (link_ok) ou l'échec
        (liaison_echouee), avec timeout. Retourne True si la liaison est
        établie (ou l'était déjà pour CETTE exécution), False sinon.

        PATCH (bug vol de liaison confirmé en usage réel, cf. log
        2026-08-07 09:17:20 -- ce même moteur délié en plein click() par
        un widget de test manuel qui a renvoyé son propre link de routine
        entre-temps, cf. srv_gerer_link) : verrou=True demande au serveur
        un verrou temporaire non-évincable pour toute la durée de cette
        cellule -- un autre pilote qui tente un link sur la même instance
        pendant ce temps se voit refuser la reprise (erreur explicite)
        plutôt que de déloger silencieusement ce moteur en plein milieu
        d'une séquence de commandes. Le verrou est levé par le unlink
        envoyé dans _delier_instance (cf. finally de _thread_execution),
        ou expire seul côté serveur si jamais ce unlink n'arrivait pas
        (cf. SRV_VERROU_TIMEOUT_S).

        BUGFIX (même raison que le garde ajouté dans _appeler, cf. son
        docstring) : un thread zombie abandonné par arreter() ne doit
        pas non plus pouvoir (re)lier une instance après coup -- même
        s'il ne peut normalement plus atteindre ce point pour une
        instance DÉJÀ liée par lui (le raccourci ligne suivante renvoie
        True direct sans repasser par le réseau), un script qui lie une
        NOUVELLE instance en cours de route (rare mais permis) pourrait
        sinon relier une instance fraîchement libérée alors que
        l'exécution est censée être terminée."""
        if self._arrete.is_set():
            log_cellule.info(
                f"[{self.cellule_id}][exec={self._execution_id}] _lier_instance_si_besoin({instance_id!r}) : IGNORÉ -- "
                f"moteur déjà arrêté (thread zombie détecté avant liaison réseau)"
            )
            return False
        if instance_id in self._registre and self._registre[instance_id][2] == self.cellule_id:
            return True  # déjà lié par cette exécution même (relancement rare, idempotent)

        event = threading.Event()
        self._events_link[instance_id] = event
        self.client_reseau.envoyer_commande({
            "type": "link", "pilote_id": self.client_reseau.id_client, "instance_id": instance_id,
            "verrou": True,
        })
        obtenu = event.wait(timeout=self.TIMEOUT_LINK_MS / 1000)
        self._events_link.pop(instance_id, None)
        if not obtenu:
            log_dashboard_reseau.warning(
                f"MoteurExecutionCellule : timeout en attendant link_ok pour {instance_id!r}"
            )
            return False
        return self._resultats_link.pop(instance_id, False)

    def _appeler(self, instance_id: str, action: str, params: dict, timeout: Optional[float] = None) -> dict:
        """Envoie UNE commande vers instance_id et BLOQUE (ce thread
        seulement) jusqu'à la réponse ou le timeout. Retourne toujours un
        dict {"ok": bool, ...} -- jamais d'exception réseau laissée
        remonter telle quelle (cohérent avec _executer_commande côté
        instance_nodriver.py, qui a la même convention).

        timeout (AJOUT demande explicite utilisateur -- "un composant
        lors de l'exécution d'une méthode prend 2 paramètres de plus : le
        nombre de retry en cas d'échec, et timeout d'une exécution" --
        EN SECONDES, PAS en millisecondes, cf. correction utilisateur) :
        remplace ponctuellement self.TIMEOUT_COMMANDE_MS pour CET appel
        uniquement si fourni (None -> comportement par défaut inchangé,
        le timeout global du moteur).

        BUGFIX (dom_paste concurrent après "Tout arrêter" -- cf. SPEC
        vérification double-exécution) : exec(code, namespace) dans
        _thread_execution ne revérifie JAMAIS self._arrete pendant que
        le script utilisateur tourne -- seulement avant/après. Un thread
        abandonné par arreter() (qui NE joint PAS le thread, cf. son
        docstring) peut donc continuer, pendant plusieurs dizaines de
        secondes, à traverser _appeler() à chaque nouvelle commande
        (dom_paste, click, attendre_fin_generation...) du script encore
        en exec(). Comme ce thread zombie partage le MÊME pilote_id
        réseau qu'une exécution relancée juste après sur la même
        cellule/instance (cf. docstring de la classe : id_client
        partagé, jamais recréé par exécution), le serveur ne peut pas
        distinguer les deux -- les deux passent la vérification
        `instance.liee_a == pilote_id` (cf. srv_gerer_command) et leurs
        commandes s'entremêlent.
        Ce garde ne corrige pas la cause structurelle (identité pilote
        partagée) mais coupe le thread zombie au prochain point d'entrée
        réseau possible, au lieu d'attendre son prochain exec() de haut
        niveau -- réduit la fenêtre de chevauchement de "jusqu'à la fin
        du script" à "jusqu'à la prochaine commande tentée", sans
        changer le comportement normal (aucun effet si arreter() n'a
        jamais été appelé)."""
        if self._arrete.is_set():
            log_cellule.info(
                f"[{self.cellule_id}][exec={self._execution_id}] _appeler({action!r}) : IGNORÉ -- moteur déjà arrêté "
                f"(thread zombie détecté avant envoi réseau, cf. BUGFIX ci-dessus)"
            )
            return {"ok": False, "error": "exécution arrêtée (Tout arrêter) -- commande non envoyée"}
        requete_id = uuid.uuid4().hex[:12]
        event = threading.Event()
        boite_resultat: dict = {}
        with self._callbacks_lock:
            self._callbacks_en_attente[requete_id] = (event, boite_resultat)
        message = {
            "type": "command", "instance_id": instance_id,
            "action": action, "requete_id": requete_id, **params,
        }
        log_cellule.info(
            f"[{self.cellule_id}][exec={self._execution_id}] _appeler({action!r}) -- envoi commande "
            f"requete_id={requete_id!r} instance_id={instance_id!r}"
        )
        self.client_reseau.envoyer_commande(message)
        delai_s = timeout if timeout is not None else (self.TIMEOUT_COMMANDE_MS / 1000)
        obtenu = event.wait(timeout=delai_s)
        with self._callbacks_lock:
            self._callbacks_en_attente.pop(requete_id, None)
        if not obtenu:
            return {"ok": False, "error": f"timeout : aucune réponse de l'instance pour '{action}'"}
        return boite_resultat.get("data", {"ok": False, "error": "réponse vide"})

    # ------------------------------------------------------------------
    # Démarrage / arrêt
    # ------------------------------------------------------------------
    def lancer(self, namespace: dict, code: str, callback_termine: callable):
        """Démarre le thread d'exécution. callback_termine(resultat: dict)
        est appelé -- réinjecté sur le thread Qt principal via
        QTimer.singleShot(0, ...) -- avec resultat = {"ok": bool,
        "sortie": str, "erreur": str | None}."""
        code = embarquer_bibliotheques_dans_code(code, libs_supplementaires=getattr(self.task, "libs_importees", None))   # PATCH bibliothèques externes + libs du Task
        log_cellule.info(f"[{self.cellule_id}][exec={self._execution_id}] MoteurExecutionCellule.lancer() -- création du threading.Thread")
        self._thread = threading.Thread(
            target=self._thread_execution, args=(namespace, code, callback_termine), daemon=True,
        )
        self._thread.start()
        log_cellule.info(f"[{self.cellule_id}][exec={self._execution_id}] thread.start() appelé (thread daemon={self._thread.daemon}, is_alive juste après start={self._thread.is_alive()})")

    def arreter(self):
        """Détache proprement cette exécution SANS attendre la fin du
        thread (cf. discussion utilisateur : on ne peut pas tuer un
        threading.Thread de force sans risquer une corruption). Appelée
        par TaskConfigScreen._arreter_sequence (bouton global "Tout
        arrêter") -- jamais depuis l'arrêt individuel d'une cellule
        (décision explicite utilisateur : l'exécution individuelle reste
        séparée de ça, pas de bouton ⏹ par cellule).

        Ce que ça fait, honnêtement (cf. discussion) :
          1) Lève self._arrete -- tout résultat qui arriverait quand
             même plus tard du thread abandonné sera ignoré par
             _terminer, pour ne jamais écraser l'état "interrompu"
             déjà affiché par un succès/erreur tardif et déroutant.
          2) Force l'unlink IMMÉDIAT (registre local + commande réseau)
             de toutes les instances que CETTE exécution tenait, pour
             qu'elles redeviennent utilisables sans attendre que le
             thread zombie finisse (ou reste bloqué indéfiniment).
          3) Le thread daemon lui-même continue seul en arrière-plan --
             isolé, il ne bloque plus rien côté UI -- jusqu'à sa fin
             naturelle ou jusqu'à ce que Python le tue au prochain
             redémarrage de l'app (daemon=True, cf. lancer()).

        LIMITE CONNUE ET ACCEPTÉE (cf. discussion utilisateur -- "le seul
        moyen honnête de couper en Python sans risquer une corruption") :
        le thread abandonné peut, dans une fenêtre de temps très courte,
        être en train de lier une instance (_lier_instance_si_besoin) au
        moment même où arreter() unlink tout depuis le thread Qt -- une
        race condition théorique sur self._registre. Accepté sciemment :
        le thread est de toute façon abandonné à lui-même juste après, et
        ajouter un verrou pour ce cas rare irait à l'encontre du principe
        "best effort, jamais bloquant" voulu ici.

        BUGFIX (retour utilisateur explicite : "je stoppe l'exécution, sa
        naffiche pas de sortie") -- ne modifie PAS le comportement ci-
        dessus (self._arrete reste levé ici, exactement comme avant --
        _terminer continue d'ignorer tout résultat tardif du thread
        abandonné, cf. son docstring, inchangé). Le SEUL ajout : la
        sortie déjà imprimée par le script jusqu'à cet instant précis
        (self._tampon_stdout, cf. son docstring dans __init__) est lue et
        retournée ICI, pendant que ce thread Qt tient encore la main --
        c'est le dernier moment où quelqu'un peut la récupérer, puisque
        tout résultat futur du thread abandonné sera de toute façon jeté
        par _terminer. L'appelant (TaskConfigScreen._arreter_sequence)
        s'en sert pour poser cellule.sortie AVANT indiquer_interrompu,
        qui jusqu'ici recevait toujours une cellule.sortie inchangée
        (celle de la PRÉCÉDENTE exécution, ou vide) -- d'où l'impression
        qu'arrêter n'affichait jamais rien, alors que le script avait
        parfois déjà produit une sortie complète juste avant la coupure."""
        if self._arrete.is_set():
            return ""  # déjà arrêté, idempotent -- rien de nouveau à lire
        log_cellule.info(f"[{self.cellule_id}][exec={self._execution_id}] arreter() : détachement -- unlink forcé immédiat, thread daemon abandonné en arrière-plan")
        self._arrete.set()
        for instance_id in list(self._instances_necessaires):
            occupation = self._registre.get(instance_id)
            if occupation is not None and occupation[2] == self.cellule_id:
                self._registre.pop(instance_id, None)
            try:
                self.client_reseau.envoyer_commande({
                    "type": "unlink", "instance_id": instance_id,
                })
            except Exception as e:
                log_cellule.warning(f"[{self.cellule_id}] arreter() : échec de l'envoi unlink pour {instance_id!r} : {e!r}")
            if self._sur_instance_liberee is not None:
                self._instance_liberee_signal.emit(instance_id)
        try:
            self.client_reseau.command_result_recu.disconnect(self._sur_command_result)
            self.client_reseau.link_ok_recu.disconnect(self._sur_link_ok)
            self.client_reseau.liaison_echouee.disconnect(self._sur_liaison_echouee)
        except (RuntimeError, TypeError):
            pass

        # BUGFIX (cf. docstring ci-dessus) -- lecture best-effort de ce
        # que le script a déjà imprimé, pendant que ce thread Qt tient
        # encore la main. self._tampon_stdout peut être None si arreter()
        # est appelée avant que _thread_execution n'ait atteint exec()
        # (encore en train de lier les instances nécessaires, cf. le
        # début de _thread_execution) -- "" dans ce cas, rien n'a encore
        # pu être imprimé de toute façon.
        try:
            sortie_partielle = self._tampon_stdout.getvalue() if self._tampon_stdout is not None else ""
        except Exception:
            # Défensif : getvalue() sur un StringIO déjà fermé ailleurs
            # (ne devrait pas arriver, rien ne le ferme explicitement dans
            # cette classe) ne doit jamais faire planter l'arrêt lui-même.
            sortie_partielle = ""
        log_cellule.info(
            f"[{self.cellule_id}][exec={self._execution_id}] arreter() : sortie partielle récupérée ({len(sortie_partielle)} caractère(s))"
        )
        return sortie_partielle

    def attendre_fin_courte(self, timeout_s: float = 0.15) -> bool:
        """BUGFIX (dom_paste concurrent après "Tout arrêter" -- cf. SPEC
        vérification double-exécution) : à appeler par l'UI JUSTE APRÈS
        arreter(), avant de considérer la cellule comme libre pour une
        relance (cf. TaskConfigScreen._arreter_sequence). Ne remplace PAS
        arreter() ni son principe "best effort, jamais bloquant" -- ne
        fait qu'attraper, avec un timeout volontairement très court (150
        ms par défaut, imperceptible sur le thread Qt principal), le cas
        fréquent où le thread réagit au flag self._arrete quasi
        immédiatement (ex. il était déjà entre deux commandes réseau, ou
        dans un sleep court) plutôt que d'être bloqué en plein milieu
        d'un appel réseau de plusieurs secondes.

        Ne garantit PAS l'absence de thread zombie -- si le thread est
        bloqué plus longtemps que timeout_s (ex. en plein _appeler(),
        attendant une réponse), cette méthode retourne False et le
        thread continue effectivement en arrière-plan EXACTEMENT comme
        avant ce correctif. La protection réelle contre ses commandes
        tardives reste le garde self._arrete.is_set() posé dans
        _appeler()/_lier_instance_si_besoin (cf. leurs docstrings) : ce
        court join() est un filet supplémentaire, pas la protection
        principale.

        Retourne True si le thread est bien terminé au bout de
        timeout_s (ou n'a jamais démarré), False s'il tourne encore."""
        if self._thread is None:
            return True
        if not self._thread.is_alive():
            return True
        self._thread.join(timeout=timeout_s)
        toujours_vivant = self._thread.is_alive()
        if toujours_vivant:
            log_cellule.info(
                f"[{self.cellule_id}][exec={self._execution_id}] attendre_fin_courte() : thread "
                f"{self._thread.name} toujours vivant après {timeout_s}s -- reste abandonné en "
                f"arrière-plan (cf. garde self._arrete dans _appeler/_lier_instance_si_besoin pour "
                f"la protection contre ses commandes tardives)."
            )
        else:
            log_cellule.info(
                f"[{self.cellule_id}][exec={self._execution_id}] attendre_fin_courte() : thread "
                f"{self._thread.name} terminé dans le délai -- aucun risque de chevauchement pour "
                f"cette exécution."
            )
        return not toujours_vivant

    def _thread_execution(self, namespace: dict, code: str, callback_termine: callable):
        log_cellule.info(f"[{self.cellule_id}] _thread_execution DÉMARRE (sur thread {threading.current_thread().name}) -- instances_necessaires={self._instances_necessaires!r}")
        # --- Liaison de toutes les instances nécessaires, une par une ---
        # BUGFIX : si une instance est liée avec succès (donc inscrite
        # dans self._registre juste en dessous) puis qu'une instance
        # SUIVANTE échoue sa propre liaison, l'ancien code retournait
        # directement (cf. `return` ci-dessous) SANS jamais délier les
        # instances déjà liées plus tôt dans cette même boucle -- leur
        # entrée restait alors piégée pour toujours dans self._registre
        # (aucun `finally`/`_delier_instance` ne les couvrait, ce bloc
        # étant entièrement AVANT le try/finally de exec() plus bas).
        # Symptôme observé : une instance signalée "déjà occupée" par un
        # Task qui, en réalité, ne l'utilise plus du tout -- jusqu'au
        # redémarrage de l'app (registre en mémoire, jamais persisté).
        # Particulièrement probable juste après le démarrage d'une
        # instance : sa toute première liaison réseau peut échouer
        # (pas encore complètement prête côté serveur) alors qu'une
        # AUTRE instance de la même cellule, elle, avait déjà réussi.
        # Correctif : délie explicitement toute instance déjà liée par
        # CETTE exécution avant de sortir en échec (réutilise
        # _delier_instance, qui gère retrait du registre + commande
        # unlink réseau + signal de libération -- même mécanisme que la
        # fin normale d'exécution ci-dessous).
        instances_deja_liees: list = []
        for instance_id in self._instances_necessaires:
            log_cellule.info(f"[{self.cellule_id}] liaison de l'instance {instance_id!r} en cours...")
            if not self._lier_instance_si_besoin(instance_id):
                log_cellule.warning(f"[{self.cellule_id}] ARRÊT : échec de liaison pour {instance_id!r} (timeout ou refus serveur)")
                for instance_deja_liee in instances_deja_liees:
                    self._delier_instance(instance_deja_liee)
                self._terminer(
                    callback_termine, ok=False,
                    sortie="", erreur=f"Impossible de lier l'instance « {instance_id} » (timeout ou refus du serveur).",
                )
                return
            self._registre[instance_id] = (self.task.id, self.task.nom, self.cellule_id)
            instances_deja_liees.append(instance_id)
            log_cellule.info(f"[{self.cellule_id}] instance {instance_id!r} liée avec succès")

        # PATCH (cf. _normaliser_indentation_tabs_espaces plus haut dans ce
        # fichier) : auto-répare un éventuel mélange tabs/espaces dans
        # l'indentation AVANT exec(), pour qu'un TabError ne puisse plus
        # jamais interrompre une exécution -- fait à chaque exécution,
        # silencieusement, quelle que soit la cellule ou le Task. Idempotent
        # sur du code déjà propre (aucun effet), donc sans risque de
        # régression sur les Tasks qui n'étaient de toute façon pas
        # affectés par ce bug.
        code = _normaliser_indentation_tabs_espaces(code)

        log_cellule.info(f"[{self.cellule_id}] juste avant exec() -- code={code!r}")
        # --- Exécution du code utilisateur, stdout capturé ---
        tampon_stdout = _TamponStdoutLive(lambda morceau: self.sortie_live.emit(self.cellule_id, morceau))   # PATCH logs en direct
        # BUGFIX (cf. docstring de self._tampon_stdout dans __init__) --
        # posé sur self AVANT exec(), pour qu'arreter() (thread Qt
        # principal, appelée à tout moment PENDANT que exec() tourne
        # encore ici) puisse lire ce que le script a déjà imprimé jusque-
        # là, plutôt que de la perdre silencieusement au clic "Tout
        # arrêter".
        self._tampon_stdout = tampon_stdout
        erreur: Optional[str] = None
        ligne_erreur: Optional[int] = None
        try:
            # CORRECTIF (cf. docstring de _FluxStdoutParThread/
            # _capturer_stdout_stderr_thread_courant, tout en haut du
            # fichier) : routage par thread au lieu du verrou global
            # d'origine -- restaure le vrai parallélisme entre cellules
            # locales exécutées simultanément (mode batch) sans
            # réintroduire le mélange de sorties que le verrou visait à
            # éviter. capturer_stderr=False : ce site ne capturait QUE
            # stdout avant ce correctif, comportement inchangé.
            with _capturer_stdout_stderr_thread_courant(tampon_stdout, capturer_stderr=False):
                exec(code, namespace)
        except Exception as exc:
            erreur = traceback.format_exc()
            # cf. _extraire_ligne_erreur : distingue SyntaxError (lève à
            # la compilation, numéro de ligne porté par exc.lineno) des
            # exceptions runtime (numéro de ligne pris sur la frame
            # <string> la plus profonde du traceback) -- utilisé pour
            # surligner la ligne fautive dans TaskScriptEditor, cf.
            # callback_termine dans _executer_cellule.
            ligne_erreur = _extraire_ligne_erreur(exc)
            log_cellule.warning(f"[{self.cellule_id}] exec() a levé une exception (ligne_erreur={ligne_erreur!r}) :\n{erreur}")
            # BUGFIX (retour utilisateur : "je veux qu'une erreur soit
            # retransmise, pas que la Task cliente tourne indéfiniment") --
            # si ce script était un fournisseur Api2Api (attendre_requete())
            # et qu'il plante APRÈS avoir reçu une requête mais AVANT
            # d'appeler req.repondre() dessus, le client bloqué sur
            # Api2Api.request() ne doit pas attendre son propre timeout en
            # silence : envoie un échec explicite en son nom (no-op si ce
            # script n'utilisait pas Api2Api du tout, cf. docstring de
            # _repondre_echec_si_besoin).
            _repondre_echec_si_besoin(namespace, str(exc))
        finally:
            for instance_id in self._instances_necessaires:
                self._delier_instance(instance_id)
        log_cellule.info(f"[{self.cellule_id}] exec() terminé -- ok={erreur is None} sortie_capturee={tampon_stdout.getvalue()!r}")

        self._terminer(
            callback_termine, ok=(erreur is None),
            sortie=tampon_stdout.getvalue(), erreur=erreur,
            ligne_erreur=ligne_erreur,
        )

    def _delier_instance(self, instance_id: str):
        occupation = self._registre.get(instance_id)
        if occupation is not None and occupation[2] == self.cellule_id:
            self._registre.pop(instance_id, None)
        self.client_reseau.envoyer_commande({
            "type": "unlink", "instance_id": instance_id,
        })
        if self._sur_instance_liberee is not None:
            self._instance_liberee_signal.emit(instance_id)

    def _terminer(self, callback_termine: callable, ok: bool, sortie: str, erreur: Optional[str], ligne_erreur: Optional[int] = None):
        if self._arrete.is_set():
            # arreter() a déjà été appelé (cf. docstring) -- ce thread
            # daemon continue seul en arrière-plan mais son résultat, s'il
            # arrive quand même, ne doit plus toucher l'UI : la cellule
            # affiche déjà "interrompu" et un succès/erreur tardif juste
            # après serait déroutant et écraserait cet état sans raison.
            # LOG CIBLÉ (diagnostic) : affiche la sortie/erreur RÉELLES que
            # ce thread a produites avant d'être jetées -- pour trancher si
            # le script avait fini son travail (sortie non vide, ok=True)
            # ou était encore bloqué (sortie vide/partielle) au moment de
            # l'arrêt, sans quoi ce cas est indiscernable dans les logs.
            _sortie_jetee = (sortie or "")[:500]
            _erreur_jetee = (erreur or "")[:500]
            log_cellule.info(
                f"[{self.cellule_id}] _terminer() : moteur déjà détaché (arreter()) -- "
                f"RÉSULTAT JETÉ ok={ok} sortie_jetee={_sortie_jetee!r} erreur_jetee={_erreur_jetee!r}"
            )
            return
        log_cellule.info(f"[{self.cellule_id}] _terminer() appelé (sur thread {threading.current_thread().name}) -- ok={ok} -- émission de _resultat_pret (signal Qt, QueuedConnection)")
        try:
            self.client_reseau.command_result_recu.disconnect(self._sur_command_result)
            self.client_reseau.link_ok_recu.disconnect(self._sur_link_ok)
            self.client_reseau.liaison_echouee.disconnect(self._sur_liaison_echouee)
        except (RuntimeError, TypeError):
            pass
        resultat = {"ok": ok, "sortie": sortie, "erreur": erreur, "ligne_erreur": ligne_erreur}
        # BUGFIX (cf. docstring de _resultat_pret) : callback_termine est
        # stocké sur self, PAS capturé dans un lambda passé à un
        # QTimer.singleShot cassé -- le signal Qt lui-même transporte
        # resultat de façon fiable inter-thread ; le slot _sur_resultat_pret
        # (exécuté sur le thread Qt principal grâce à Qt.QueuedConnection)
        # appelle ensuite callback_termine avec ce resultat.
        self._callback_termine_courant = callback_termine
        self._resultat_pret.emit(resultat)

    def _sur_resultat_pret(self, resultat: dict):
        """Slot Qt (thread principal, cf. Qt.QueuedConnection sur
        _resultat_pret.connect ci-dessus) -- exécute enfin le
        callback_termine fourni à lancer(), désormais garanti de
        s'exécuter, contrairement à l'ancien QTimer.singleShot(0, ...)
        qui restait bloqué indéfiniment sans jamais s'exécuter ni lever
        d'erreur quand il était démarré depuis le thread d'exécution
        (sans event loop Qt)."""
        callback = self._callback_termine_courant
        self._callback_termine_courant = None
        if callback is not None:
            callback(resultat)



# ---------------------------------------------------------------------------
# PATCH "Projet Batch" -- brique 3 : lancement d'une instance nodriver
# FRAÎCHE, dédiée à un sous-projet précis, avec son download_dir propre
# (cf. PATCH_projet_batch.md, section 6). Fonction LIBRE, volontairement
# distincte de DashboardScreen._lancer_instance_pour_profil (couplée à
# l'UI profils : registre self._instance_id_par_profil, self._processus_
# instances, widgets de la liste de profils) -- le moteur d'orchestration
# batch (MoteurExecutionBatch, pas encore écrit) n'a besoin d'aucune de
# ces dépendances Qt, seulement de lancer un process instance et de savoir
# quand il est prêt à recevoir des commandes (cf. le "registered" reçu par
# le pilote, pas géré ici -- cf. docstring de la fonction).
# ---------------------------------------------------------------------------

def lancer_instance_headless_pour_batch(
    instance_id: str,
    download_dir: str,
    port: int = PORT_SERVEUR_DASHBOARD,
    navigateur: Optional[str] = None,
    executable: Optional[str] = None,
    profil: Optional[str] = None,
    url_ouverture: Optional[str] = None,
) -> subprocess.Popen:
    """Lance un process instance nodriver FRAÎCHE (subprocess séparé, même
    mécanisme que DashboardScreen._lancer_instance_pour_profil : ce fichier
    lui-même relancé avec --instance-id) avec son download_dir propre
    (--download-dir, cf. demarrer_navigateur) pointant vers le download/ du
    sous-projet en cours de traitement.

    navigateur/executable/profil/url_ouverture : None -> retombent sur
    CONFIG_INSTANCE_PAR_DEFAUT, exactement comme _lancer_instance_pour_profil
    (mêmes réglages globaux de lancement, pas de config par sous-projet --
    cohérent avec la section 1 du patch : le ProjetBatch ne configure ni le
    navigateur ni l'exécutable par sous-projet, seulement task_id/mapping/
    chemin_racine).

    profil=None laisse Chrome créer un user_data_dir TEMPORAIRE propre à ce
    process (pas de --profil passé du tout) plutôt que de retomber sur le
    profil nommé "défaut" comme le fait _main_async pour un lancement manuel
    sans --profil : contrairement à l'usage "profil persistant" du Dashboard
    (cookies/connexions à conserver d'un lancement à l'autre), une exécution
    headless de batch est jetable par construction (nouvelle instance à
    chaque sous-projet, cf. docstring de MoteurExecutionTaskHeadless) --
    partager le même profil "défaut" entre N exécutions headless EN
    PARALLÈLE créerait un conflit Chrome sur --user-data-dir (même
    diagnostic que celui déjà documenté dans _lancer_instance_pour_profil
    pour le cas manuel : "conflit Chrome garanti sur un même dossier").
    Si un profil précis est explicitement voulu pour un batch donné
    (cas non couvert par la spécification actuelle), l'appelant peut
    toujours le fournir via `profil`.

    Ne gère PAS l'attente du message "registered" côté serveur ni la
    liaison des ServiceAPI -- cf. MoteurExecutionBatch (orchestration,
    pas encore écrite), qui doit attendre que cette instance soit visible
    côté serveur avant de construire un MoteurExecutionTaskHeadless dessus
    (même ordre que le flux manuel existant : le process instance doit
    avoir fini son register avant qu'un pilote puisse lui envoyer un
    link/command, cf. srv_gerer_link -- protocole déjà en place, inchangé
    par cette fonction).

    Retourne le Popen tel quel (pas de wrapping) -- l'appelant (orchestration
    batch) décide lui-même de la stratégie de suivi (lecture stdout,
    terminate(), etc.), cette fonction ne fait que construire et lancer la
    commande, sans effet de bord au-delà du démarrage du process."""
    config = CONFIG_INSTANCE_PAR_DEFAUT
    commande = [
        sys.executable, str(script_instance_pour_profil()),
        "--instance-id", instance_id,
        "--port", str(port),
        "--navigateur", navigateur or config["navigateur"],
        "--download-dir", download_dir,
    ]
    executable = executable or config["executable"]
    if executable:
        commande += ["--executable", executable]
    if profil:
        commande += ["--profil", profil]
    url_ouverture = url_ouverture or config["url_ouverture"]
    if url_ouverture:
        commande += ["--url", url_ouverture]
    return subprocess.Popen(
        commande,
        stdout=subprocess.PIPE, stderr=subprocess.STDOUT, text=True,
        creationflags=FLAGS_DETACHEMENT_PROCESS_WINDOWS,
    )


# ---------------------------------------------------------------------------
# PATCH (Task.mode_execution == "reseau") -- équivalent de
# MoteurExecutionCellule ci-dessus, mais pour une cellule exécutée sur un
# sAutoniax DISTANT plutôt que via une instance Camoufox pilotée localement.
#
# DIFFÉRENCES DE FOND avec MoteurExecutionCellule (pas une simple variante
# -- une architecture différente, cf. discussion utilisateur "dont sa veut
# dire que tu vas gerer le resau ? / Oui") :
#   - Aucun thread Python local, aucun ClientReseauAutoniaX (protocole
#     link/unlink/command bas niveau, propre au pilotage D'UNE INSTANCE) --
#     le CODE ENTIER de la cellule est envoyé tel quel au sAutoniax cible
#     via ClientServeurT.executer_notebook_distant, qui l'exécute lui-même
#     dans SON PROPRE environnement Camoufox headless local à lui. Ce
#     moteur-ci ne fait qu'attendre les logs/résultat en retour -- aucun
#     exec() Python ne tourne dans CE process (AutoniaX pilote), tout se
#     passe côté sAutoniax (cf. main_sautoniax).
#   - Pas de notion de ServiceAPI/instance liée à vérifier avant lancement
#     (ServiceAPINonLieError/InstanceOccupeeError n'ont pas de sens ici --
#     le sAutoniax et son profil cloud, PAS une instance_id locale, sont
#     déjà choisis et validés en amont par TaskConfigScreen._sur_clic_
#     initialiser_reseau AVANT que ce moteur ne soit même créé, cf.
#     _executants_reseau_prets). Si le sAutoniax choisi n'est pas prêt,
#     TaskConfigScreen._executer_cellule refuse de créer ce moteur du tout
#     (même esprit que la vérification faite en amont côté local, mais la
#     vérification elle-même vit dans TaskConfigScreen ici, pas dans le
#     moteur -- cf. sa docstring).
#   - `namespace` (paramètre de lancer(), conservé pour un contrat IDENTIQUE
#     à MoteurExecutionCellule.lancer -- TaskConfigScreen._executer_cellule
#     appelle moteur.lancer(namespace, cellule.code, callback_termine) sans
#     savoir quel type de moteur elle tient) est accepté mais IGNORÉ : les
#     ComposantExecutable/ServiceAPIExecutable qu'il contient pointent sur
#     CE process (fonctions Python qui parlent à ClientReseauAutoniaX) --
#     aucun sens de les envoyer sur le réseau (non sérialisables, et de
#     toute façon le sAutoniax distant n'a pas la moindre notion de "cette
#     instance précise pilotée par ce pilote-ci"). Un Task en mode réseau
#     ne peut donc PAS utiliser de composants ServiceAPI dans son code --
#     limitation actuelle assumée (cf. inventaire des chantiers, pas
#     encore résolue : il faudrait un vrai protocole d'appel de composant
#     à distance pour lever cette limite, hors scope de ce patch).
#   - "Arrêter" une cellule réseau (arreter()) ne peut PAS interrompre
#     l'exécution déjà en cours côté sAutoniax (aucun message protocole
#     "annuler" n'existe -- cf. inventaire des chantiers) : ce moteur se
#     contente donc de cesser d'ÉCOUTER les logs/résultat à venir pour
#     cette session_id (même esprit "best effort, jamais bloquant" que
#     MoteurExecutionCellule.arreter, juste sans l'étape unlink qui n'a
#     pas d'équivalent réseau ici) -- la cellule distante continue de
#     tourner en arrière-plan côté sAutoniax jusqu'à sa fin naturelle,
#     simplement ignorée de ce côté-ci une fois arreter() appelé.
# ---------------------------------------------------------------------------


def _composer_sortie_affichage_html(entrees: list) -> str:
    """Compose le HTML affiché dans zone_sortie à partir d'une liste
    d'entrées mélangeant lignes de texte brut (str) et tuples
    ("image", b64) -- extrait de MoteurExecutionCelluleReseau.
    _construire_sortie_affichage (cf. sa docstring pour le détail des
    choix : échappement HTML du texte, width/height explicites sur
    chaque <img> pour empêcher le redimensionnement automatique de Qt
    Rich Text). Fonction libre plutôt que méthode : appelée à la fois
    avec moteur._sortie_accumulee (moteur vivant) ET avec une liste
    reconstruite à la volée depuis TaskCellule.sortie/derniere_image_b64
    (profil clone déjà terminé, moteur disparu -- cf. TaskConfigScreen.
    _definir_profil_actif)."""
    morceaux = []
    for entree in entrees:
        if isinstance(entree, tuple) and entree[0] == "image":
            _b64 = entree[1]
            _dim_attrs = ""
            try:
                _octets = base64.b64decode(_b64)
                _qimg = QImage.fromData(_octets)
                if not _qimg.isNull():
                    _dim_attrs = f' width="{_qimg.width()}" height="{_qimg.height()}"'
            except Exception:
                _dim_attrs = ""
            morceaux.append(f'<br><img src="data:image/png;base64,{_b64}"{_dim_attrs}><br>')
        else:
            morceaux.append(html.escape(entree).replace("\n", "<br>"))
    return "<br>".join(m for m in morceaux if m)


class MoteurExecutionCelluleReseau(QObject):
    """Pont Task-réseau <-> UI pour UNE exécution de cellule en mode
    task.mode_execution == "reseau" (cf. docstring de section ci-dessus
    pour les différences de fond avec MoteurExecutionCellule).

    Contrat public IDENTIQUE à MoteurExecutionCellule (même signature de
    lancer()/arreter()) -- TaskConfigScreen._executer_cellule construit
    l'UN OU L'AUTRE selon task.mode_execution SANS changer sa propre
    logique par ailleurs (callback_termine, self._moteurs_en_cours,
    self._moteur_courant_par_task, etc. restent exactement les mêmes,
    cf. bifurcation dans _executer_cellule)."""

    _resultat_pret = Signal(dict)

    def __init__(
        self,
        client_serveur_t: "ClientServeurT",
        task: "Task",
        cellule_id: str,
        id_executant: str,
        profil_nom: str,
        services_api_lies_override: Optional[dict] = None,
        # AJOUT (SPEC_lot_corrections_2026-09.md section 11) : transportés
        # jusqu'au sAutoniax via ClientServeurT.executer_notebook_distant
        # (cf. lancer() plus bas) -- reinitialiser_result_color=True sur
        # la PREMIÈRE cellule d'une séquence clone (calculé par l'appelant,
        # cf. _lancer_sequence_clone_profil) demande au sAutoniax
        # d'injecter result_color='white' dans le namespace AVANT
        # d'exécuter le code de cette cellule ; lire_result_color_finale
        # =True sur la DERNIÈRE demande au sAutoniax de lire la valeur
        # finale de result_color APRÈS exécution et de la transmettre
        # dans son résultat. False par défaut pour les deux : le seul
        # appelant qui les passe explicitement est _lancer_sequence_
        # clone_profil (séquences clone) -- _executer_cellule (mode
        # réseau non-clone, un seul profil actif à la fois) n'a pas
        # cette notion de "lot" et n'active jamais ce mécanisme.
        reinitialiser_result_color: bool = False,
        lire_result_color_finale: bool = False,
    ):
        """client_serveur_t : LE MÊME ClientServeurT que TaskConfigScreen.
        _client_serveur_t (injecté via definir_client_reseau_t, cf.
        MainWindow) -- jamais recréé ici, même principe que client_reseau
        partagé côté MoteurExecutionCellule.

        id_executant/profil_nom : déjà choisis et validés PRÊTS (cf.
        TaskConfigScreen._executants_reseau_prets) par l'appelant AVANT
        la création de ce moteur -- ce moteur ne revalide rien, il
        suppose que _executer_cellule a déjà refusé de le construire si
        ce n'était pas le cas (même répartition de responsabilités que
        ServiceAPINonLieError/InstanceOccupeeError levées par __init__
        de MoteurExecutionCellule, mais faite en AMONT ici plutôt que
        dans ce constructeur -- cf. docstring de section).

        services_api_lies_override (CORRECTIF bug confirmé en prod :
        NameError sur un Composant en mode clone -- "yt_view" absent du
        namespace côté sAutoniax alors qu'il avait fonctionné à
        l'exécution précédente sur le MÊME profil) -- cause : lancer()
        calculait jusqu'ici services_api_lies à partir de self.task.
        services_api_importes, qui est une liaison GLOBALE À TOUT LE
        TASK vers l'unique "profil actif" de l'éditeur (cf. _definir_
        profil_actif, seul point d'écriture de ce dict -- il écrase
        TOUJOURS la même clé pour TOUS les ServiceAPI, quel que soit le
        profil qui exécute réellement la cellule). En mode clone
        (_lancer_sequence_clone_profil), plusieurs profils (iaX1, iaX2,
        iaX3...) exécutent des cellules EN PARALLÈLE sur le MÊME objet
        task, donc le MÊME task.services_api_importes -- une exécution
        sur iaX1 pouvait lire une liaison déjà écrasée par un changement
        de profil actif dans l'UI, ou vidée par _definir_profil_actif/
        la disparition du profil actif (cf. docstring de la boucle qui
        vide task.services_api_importes), sans rapport avec le profil
        RÉELLEMENT ciblé par CE moteur.

        Ce paramètre, quand fourni (non None), REMPLACE entièrement le
        calcul par défaut dans lancer() : l'appelant (_lancer_sequence_
        clone_profil) construit alors {nom_service_api: nom_profil} pour
        SON PROPRE profil_nom, indépendamment de l'état actuel de
        l'éditeur. Reste None pour _executer_cellule (comportement
        inchangé -- un seul profil actif à la fois dans ce chemin, pas
        de risque de collision)."""
        super().__init__()
        self.client_serveur_t = client_serveur_t
        self.task = task
        self.cellule_id = cellule_id
        self.id_executant = id_executant
        self.profil_nom = profil_nom
        self._services_api_lies_override = services_api_lies_override
        # AJOUT (SPEC_lot_corrections_2026-09.md section 11) -- cf.
        # docstring des paramètres ci-dessus, transmis tels quels à
        # ClientServeurT.executer_notebook_distant dans lancer().
        self._reinitialiser_result_color = reinitialiser_result_color
        self._lire_result_color_finale = lire_result_color_finale
        # CORRECTIF (bug race condition "spinner bloqué après succès
        # instantané", cf. docstring de _sessions_execution_reseau et de
        # ClientServeurT.executer_notebook_distant) -- session_id généré
        # ICI, dans __init__, DONC disponible pour l'appelant
        # (_executer_cellule) AVANT même l'appel à lancer(). Auparavant
        # ce champ restait None jusqu'à ce que lancer() obtienne un
        # session_id EN RETOUR de executer_notebook_distant -- trop tard
        # si le sAutoniax répond assez vite pour que la coroutine réseau
        # émette notebook_distant_resultat_recu avant que le thread Qt
        # appelant n'ait fini d'enregistrer ce session_id dans
        # _sessions_execution_reseau. Même patron EXACT que le couple
        # demande_initialisation_notebook_distant/_sessions_
        # initialisation_reseau (Option A, déjà en place ailleurs).
        self._session_id: str = uuid.uuid4().hex[:12]
        self._arrete = False
        self._callback_termine: Optional[callable] = None
        self._sortie_accumulee: list[str] = []
        # QueuedConnection explicite -- même raison que MoteurExecutionCellule
        # ._resultat_pret (garantit l'exécution sur le thread Qt principal,
        # bien qu'ici tout parte déjà du thread Qt principal puisqu'aucun
        # thread Python dédié n'est utilisé côté réseau -- gardé quand même
        # pour un contrat de connexion strictement identique, sans supposer
        # que l'émetteur sera toujours le thread Qt principal si ce moteur
        # évoluait plus tard).
        self._resultat_pret.connect(self._sur_resultat_pret, Qt.QueuedConnection)

    # ------------------------------------------------------------------
    # Démarrage / arrêt -- API publique, contrat identique à
    # MoteurExecutionCellule (cf. docstring de classe).
    # ------------------------------------------------------------------
    def lancer(self, namespace: dict, code: str, callback_termine: callable):
        """namespace : accepté mais IGNORÉ (cf. docstring de section --
        non pertinent en mode réseau, le code s'exécute côté sAutoniax
        distant, pas ici). callback_termine(resultat: dict) est appelé
        avec resultat = {"ok": bool, "sortie": str, "erreur": str | None}
        -- MÊME FORME que MoteurExecutionCellule.lancer, pour que
        TaskConfigScreen._executer_cellule n'ait besoin d'aucune
        distinction dans son propre callback_termine local (cf.
        bifurcation dans _executer_cellule, qui ne change QUE la
        construction du moteur, pas ce qui consomme son résultat).

        CORRECTIF (Composants en notebook distant, retour explicite
        utilisateur -- "je veux le filtrage precis comme en local") :
        calcule {nom_service_api: instance_id/id_executant} des
        ServiceAPI RÉELLEMENT liés pour self.task -- MÊME FILTRE EXACT
        que Project.composants_importes_task côté mode local (qui ignore
        déjà les entrées non liées, cf. sa docstring : "un composant d'un
        ServiceAPI importé mais pas encore lié reste simplement absent"),
        reproduit ici sans avoir besoin de self.project (non disponible
        sur ce moteur) puisque task.services_api_importes porte déjà
        directement la paire (nom, lien) -- pas besoin des objets
        Composant eux-mêmes ici, cf. docstring de _construire_composants_
        direct côté sAutoniax : les images sont déjà présentes là-bas
        (service_api.zip, UN SEUL zip partagé pour tout le projet), seul
        le FILTRE (quels ServiceAPI sont liés) a besoin de transiter."""
        code = embarquer_bibliotheques_dans_code(code, libs_supplementaires=getattr(self.task, "libs_importees", None))   # PATCH bibliothèques externes + libs du Task
        log_cellule.info(
            f"[{self.cellule_id}] MoteurExecutionCelluleReseau.lancer() -- "
            f"envoi vers sAutoniax {self.id_executant!r} (profil {self.profil_nom!r})"
        )
        self._callback_termine = callback_termine
        if self._services_api_lies_override is not None:
            # CORRECTIF (cf. docstring de __init__/services_api_lies_
            # override) : mode clone -- utilise la liaison RÉSOLUE POUR
            # CE PROFIL précis, fournie explicitement par l'appelant,
            # plutôt que de lire task.services_api_importes (liaison
            # globale au profil actif unique de l'éditeur, non fiable
            # ici puisque plusieurs profils exécutent des cellules en
            # parallèle sur le même objet task).
            services_api_lies = dict(self._services_api_lies_override)
            log_cellule.info(
                f"[{self.cellule_id}] services_api_lies : override clone fourni par l'appelant "
                f"(profil {self.profil_nom!r}) = {services_api_lies!r} -- task.services_api_importes "
                f"IGNORÉ pour ce calcul (brut = {dict(self.task.services_api_importes)!r})"
            )
        else:
            # BUGFIX (audit clé composite) : task.services_api_importes
            # contient, en mode réseau, une CLÉ COMPOSITE (id_executant::
            # nom_profil, cf. _cle_profil_clone) depuis que _definir_
            # profil_actif y écrit etat.profil_actif tel quel (REFONTE
            # MULTI-SAUTONIAX) -- ce dict est envoyé TEL QUEL au sAutoniax
            # (cf. logs juste en dessous, "envoyé au sAutoniax") comme la
            # liaison ServiceAPI -> profil : lui transmettre la clé
            # technique brute au lieu du nom nu réel aurait fait échouer
            # la résolution de CHAQUE ServiceAPI importé côté sAutoniax
            # pour toute exécution non-clone (bouton ▶ individuel en mode
            # réseau avec un profil actif, cf. l'appelant de ce moteur
            # sans services_api_lies_override). Extraction explicite du
            # nom nu pour chaque valeur avant l'envoi -- en mode "local"
            # historique (services_api_importes contenant déjà des
            # instance_id nodriver, jamais des clés composites, cf.
            # docstring de Task.services_api_importes), _nom_depuis_cle_
            # profil_clone est un no-op transparent (aucun "::" présent).
            services_api_lies = {
                nom: _nom_depuis_cle_profil_clone(instance_id)
                for nom, instance_id in self.task.services_api_importes.items() if instance_id
            }
            # LOG CIBLÉ (diagnostic .visible()/AttributeError) -- contenu
            # RÉEL envoyé, avant même l'appel réseau : si ce dict est vide ou
            # ne contient pas le ServiceAPI attendu ICI, le bug est côté
            # mAutoniax (task.services_api_importes pas à jour/pas lié),
            # inutile de chercher plus loin côté sAutoniax.
            log_cellule.info(
                f"[{self.cellule_id}] services_api_lies calculé (envoyé au sAutoniax) = {services_api_lies!r} "
                f"(task.services_api_importes brut = {dict(self.task.services_api_importes)!r})"
            )
        # CORRECTIF (cf. docstring de __init__) : self._session_id existe
        # déjà (généré dans __init__, potentiellement déjà enregistré par
        # l'appelant dans _sessions_execution_reseau AVANT ce point) --
        # on le TRANSMET à executer_notebook_distant au lieu d'en
        # récupérer un nouveau en retour, pour que le sAutoniax et le
        # routage local utilisent la même valeur dès le départ.
        session_id_confirme = self.client_serveur_t.executer_notebook_distant(
            self.id_executant, self.profil_nom, code, services_api_lies,
            session_id=self._session_id,
            # AJOUT (SPEC_lot_corrections_2026-09.md section 11) -- cf.
            # docstring de __init__ pour le détail complet.
            reinitialiser_result_color=self._reinitialiser_result_color,
            lire_result_color_finale=self._lire_result_color_finale,
        )
        assert session_id_confirme == self._session_id, (
            f"executer_notebook_distant a retourné un session_id différent de celui fourni "
            f"({session_id_confirme!r} != {self._session_id!r}) -- ne devrait jamais arriver."
        )
        log_cellule.info(f"[{self.cellule_id}] session_id réseau utilisé = {self._session_id}")

    def arreter(self):
        """Cesse d'écouter les logs/résultat pour cette session_id (cf.
        docstring de section : aucun message protocole d'annulation
        n'existe côté réseau -- la cellule continue de tourner côté
        sAutoniax jusqu'à sa fin naturelle, ce moteur-ci ignore juste ce
        qui arriverait encore). Idempotent, même principe que
        MoteurExecutionCellule.arreter."""
        if self._arrete:
            return ""
        # PATCH (retour utilisateur : "les logs ne s'affichent pas quand
        # j'arrête") -- lit la sortie TEXTE déjà reçue AVANT de lever
        # self._arrete (après, sur_log_recu ignore tout). Retournée à
        # l'appelant, comme MoteurExecutionCellule.arreter(). Avant ce
        # patch, cette méthode retournait None : la sortie accumulée était
        # perdue à chaque arrêt d'une cellule réseau.
        try:
            _sortie_partielle_reseau = "\n".join(e for e in self._sortie_accumulee if isinstance(e, str))
        except Exception:
            _sortie_partielle_reseau = ""
        # LOG DIAGNOSTIC (retour utilisateur : bouton Run qui tourne sans
        # jamais s'arrêter en mode réseau) -- pile d'appel COMPLÈTE pour
        # identifier sans ambiguïté QUI déclenche cet arrêt (clic
        # utilisateur explicite sur ⏹/"Arrêter", ou un chemin automatique
        # non identifié) : une fois self._arrete=True posé ici, AUCUN
        # résultat réseau arrivant ensuite (cf. sur_resultat_recu) ne
        # pourra plus jamais débloquer le spinner de cette cellule.
        _pile = "".join(traceback.format_stack(limit=8))
        log_cellule.info(
            f"[{self.cellule_id}] MoteurExecutionCelluleReseau.arreter() -- "
            f"détachement de la session {self._session_id!r} (le sAutoniax continue seul) -- "
            f"PILE D'APPEL (qui a déclenché cet arrêt) :\n{_pile}"
        )
        self._arrete = True
        self._callback_termine = None
        return _sortie_partielle_reseau

    # ------------------------------------------------------------------
    # Appelés par TaskConfigScreen (routage par session_id, cf.
    # demande_execution_reseau_emettre/sur_session_execution_reseau_
    # demarree) -- PAS directement connectés aux signaux ClientServeurT
    # (qui transportent tous les session_id en vol, pas seulement le
    # nôtre) : TaskConfigScreen reste le seul point de routage par
    # session_id -> moteur, même séparation de responsabilités que le
    # routage session_id -> cellule_id déjà en place pour l'initialisation
    # (cf. _sessions_initialisation_reseau).
    # ------------------------------------------------------------------
    def sur_log_recu(self, ligne: str):
        if self._arrete:
            return
        self._sortie_accumulee.append(ligne)

    def sur_image_recue(self, image_b64: str):
        """PATCH (demande explicite utilisateur : "pourquoi tu na pas
        affhcer plutot dans la sortie de la cellule du notebbok" -- PAS le
        terminal séparé de FenetreRenduTaskReseau, revert de cette
        décision précédente) -- même point d'entrée que sur_log_recu
        ci-dessus (ajouté à la même liste _sortie_accumulee, dans l'ordre
        chronologique d'arrivée), mais pousse une balise <img> HTML
        inline plutôt qu'une ligne de texte : self.zone_sortie est un
        QLabel (cf. TaskCelluleWidget), qui interprète nativement du HTML
        en Qt.AutoText (pas de setTextFormat forcé ailleurs sur ce widget)
        -- une simple balise <img src="data:image/png;base64,...">
        suffit, aucune conversion QImage/QTextCursor nécessaire
        contrairement à un QTextEdit.

        Chaque ligne de texte déjà accumulée est en clair, potentiellement
        avec des caractères '<'/'&' -- pour que l'ajout de cette balise ne
        fasse pas basculer TOUT le bloc en interprétation HTML de façon
        incontrôlée (un log contenant "<div>" serait alors avalé comme une
        balise), la liste _sortie_accumulee elle-même reste du texte brut
        (contrat inchangé pour sur_resultat_recu ci-dessous, qui l'utilise
        pour resultat["sortie"] -- une balise <img> littérale insérée là
        romprait ce contrat pour tout code qui logue/persiste cette
        sortie) ; c'est build_sortie_affichage ci-dessous, appelée
        uniquement pour l'AFFICHAGE (cf. TaskConfigScreen.sur_image_
        execution_reseau_recu), qui échappe le texte et compose le HTML
        final -- cellule.sortie reste TEL QUEL (texte brut, image absente)
        pour la persistance."""
        if self._arrete:
            return
        self._sortie_accumulee.append(("image", image_b64))

    def _construire_sortie_affichage(self) -> str:
        """Compose le HTML affiché par zone_sortie à partir de
        _sortie_accumulee (mélange de lignes de texte brut et de tuples
        ("image", b64), cf. sur_log_recu/sur_image_recue) -- chaque ligne
        de texte est échappée (html.escape) avant d'être jointe, pour que
        la présence d'une image dans le flux ne fasse pas interpréter par
        erreur un caractère '<'/'&' d'une ligne de log comme du HTML.
        Utilisée pour l'AFFICHAGE seulement (cf. TaskConfigScreen.sur_
        image_execution_reseau_recu/sur_log_execution_reseau_recu) --
        jamais pour resultat["sortie"]/cellule.sortie (cf. sur_resultat_
        recu ci-dessous, qui continue de joindre le texte brut sans
        l'image, cf. docstring de sur_image_recue).

        PATCH (demande explicite utilisateur : "je veux que la taille de
        l'image s'affiche a taille reelle dans la sortie, pas
        reajustee") -- width/height EXPLICITES posés sur la balise <img>
        (lus directement sur les données décodées via QImage, pas
        supposés) : SANS ces attributs, Qt Rich Text (moteur HTML interne
        utilisé par QLabel, cf. self.zone_sortie.setWordWrap(True) dans
        TaskCelluleWidget) réduit automatiquement une image plus large
        que le label pour qu'elle y tienne, quelle que soit sa taille
        réelle -- poser width/height figés à la taille réelle du PNG
        décodé empêche ce redimensionnement automatique (l'image déborde
        alors horizontalement si elle est plus large que zone_sortie,
        au lieu d'être mise à l'échelle, ce qui est le comportement
        explicitement demandé).

        REFACTOR (retour utilisateur : les images .view() d'un profil
        clone non-actif étaient perdues dès que sa cellule se terminait,
        car seul cet objet moteur -- détruit à la fin de la cellule --
        savait composer ce HTML) -- le corps a été extrait tel quel dans
        _composer_sortie_affichage_html (fonction libre, sans dépendance
        à self), pour que TaskConfigScreen._definir_profil_actif puisse
        réafficher la sortie d'un profil déjà terminé, moteur disparu,
        à partir d'une simple liste stockée sur le TaskCellule temporaire
        (cf. TaskCellule.derniere_image_b64). Comportement de CETTE
        méthode inchangé : simple délégation, aucune différence
        observable pour l'appelant existant."""
        return _composer_sortie_affichage_html(self._sortie_accumulee)

    def sur_resultat_recu(self, ok: bool, message: str,
                           horodatage_debut: Optional[float] = None,
                           horodatage_fin: Optional[float] = None,
                           result_color: Optional[str] = None,
                           result_output: Optional[dict] = None):
        log_cellule.info(
            f"[{self.cellule_id}] [reseau][moteur] sur_resultat_recu ENTRÉE -- ok={ok!r} message={message!r} "
            f"self._arrete={self._arrete!r} self._callback_termine={'défini' if self._callback_termine else None!r}"
        )
        if self._arrete:
            log_cellule.warning(
                f"[{self.cellule_id}] [reseau][moteur] ARRÊT sur_resultat_recu -- self._arrete=True "
                f"(arreter() a déjà été appelé, cf. MoteurExecutionCelluleReseau.arreter) -- résultat "
                f"réseau reçu mais IGNORÉ, aucune émission de _resultat_pret, callback_termine jamais "
                f"rappelé -- si arreter() a été déclenché par autre chose qu'une vraie annulation "
                f"utilisateur (ex. timeout ailleurs), le spinner restera bloqué indéfiniment"
            )
            return
        # PATCH -- _sortie_accumulee peut désormais contenir des tuples
        # ("image", b64) parmi les lignes de texte (cf. sur_image_recue) :
        # resultat["sortie"]/cellule.sortie restent DU TEXTE BRUT SEUL
        # (une image y romprait le contrat existant pour tout code qui
        # persiste/relit cette sortie, cf. docstring de sur_image_recue)
        # -- les entrées image sont donc filtrées ici, pas jointes.
        sortie = "\n".join(e for e in self._sortie_accumulee if isinstance(e, str))
        # AJOUT (spec B.2, colonne "Temps") -- horodatage_debut/fin
        # ajoutés au dict `resultat` transmis à callback_termine (cf.
        # _lancer_sequence_clone_profil._callback_termine, seul
        # consommateur de ces clés pour l'instant -- None si le
        # sAutoniax n'a pas fourni ces valeurs, cf. docstring de
        # sur_resultat_execution_reseau_recu. result_color (AJOUT SPEC_
        # lot_corrections_2026-09.md section 11) suit le même patron --
        # None sauf sur le résultat de la dernière cellule d'un lot
        # clone, cf. resultat.get("result_color") dans _callback_termine.
        if ok:
            resultat = {"ok": True, "sortie": sortie, "erreur": None,
                        "horodatage_debut": horodatage_debut, "horodatage_fin": horodatage_fin,
                        "result_color": result_color, "result_output": result_output}
        else:
            resultat = {"ok": False, "sortie": sortie, "erreur": message,
                        "horodatage_debut": horodatage_debut, "horodatage_fin": horodatage_fin,
                        "result_color": result_color, "result_output": result_output}
        # Signal + QueuedConnection plutôt qu'un appel direct à
        # self._callback_termine ici : ce slot est déjà invoqué depuis le
        # thread Qt principal (aucun thread dédié côté réseau), mais on
        # garde le même mécanisme de va-et-vient par signal que
        # MoteurExecutionCellule pour un comportement observable
        # identique (callback_termine jamais appelé en réentrance directe
        # depuis l'intérieur d'un slot Qt) -- évite tout risque subtil si
        # callback_termine lui-même déclenche une nouvelle exécution
        # synchrone (cf. _executer_toutes_cellules, séquence globale).
        log_cellule.info(f"[{self.cellule_id}] [reseau][moteur] émission _resultat_pret.emit(resultat) -- resultat={resultat!r}")
        self._resultat_pret.emit(resultat)

    def _sur_resultat_pret(self, resultat: dict):
        log_cellule.info(
            f"[{self.cellule_id}] [reseau][moteur] _sur_resultat_pret ENTRÉE -- self._arrete={self._arrete!r} "
            f"self._callback_termine={'défini' if self._callback_termine else None!r}"
        )
        if self._arrete or self._callback_termine is None:
            log_cellule.warning(
                f"[{self.cellule_id}] [reseau][moteur] ARRÊT _sur_resultat_pret -- self._arrete={self._arrete!r}, "
                f"self._callback_termine={'défini' if self._callback_termine else None!r} -- callback_termine "
                f"JAMAIS appelé pour ce résultat, spinner potentiellement bloqué indéfiniment si aucun autre "
                f"résultat n'est attendu pour cette cellule"
            )
            return
        callback = self._callback_termine
        self._callback_termine = None
        log_cellule.info(f"[{self.cellule_id}] [reseau][moteur] appel callback_termine(resultat) -- ceci doit débloquer le spinner")
        callback(resultat)


# ---------------------------------------------------------------------------
# PATCH "Projet Batch" -- brique 2 : moteur d'exécution headless d'un Task
# (cf. PATCH_projet_batch.md, section 5). Réutilise MoteurExecutionCellule
# tel quel (aucune modification de cette classe), sans dépendre de
# TaskConfigScreen ni d'aucun widget d'affichage.
# ---------------------------------------------------------------------------

class MoteurExecutionTaskHeadless(QObject):
    """Exécute la séquence complète d'UN Task (cellule_variables PUIS
    task.cellules, dans cet ordre -- même logique que TaskConfigScreen.
    _executer_toutes_cellules) SANS dépendre d'aucun widget Qt d'affichage
    (TaskCelluleWidget, _cellule_widgets) -- cf. PATCH_projet_batch.md,
    section 5 : "l'orchestration doit pouvoir tourner SANS que l'éditeur
    de Task soit ouvert à l'écran".

    Une instance de cette classe = UNE exécution complète d'un Task sur
    UN sous-projet précis :
      - namespace Python NEUF et ISOLÉ à chaque exécution (PAS le
        namespace persistant partagé de TaskConfigScreen._namespaces_tasks
        -- plusieurs sous-projets tournent en parallèle sur le MÊME Task,
        chacun avec ses propres données/variables, un namespace partagé
        entre eux mélangerait leurs exécutions).
      - une instance nodriver dédiée (instance_id fourni par l'appelant,
        cf. MoteurExecutionBatch -- déjà démarrée avec son download_dir
        propre AVANT que ce moteur ne soit construit, cf. section 6 du
        patch). TOUS les ServiceAPI utilisés par le Task sont liés à
        CETTE instance, quelle que soit la valeur de
        task.services_api_importes (décision explicite utilisateur :
        "les instance dans lediteur ne compte pas, cest pas sauvrgarder,
        on specifie toujours l'instance au demarrage d'une task et la ca
        sera automatique" -- même principe que la migration
        Task.from_dict, qui remet déjà instance_id à "" au chargement ;
        ici l'attribution est automatique plutôt que manuelle, mais
        jamais lue depuis task.services_api_importes).
      - un client réseau DÉDIÉ (ClientReseauAutoniaX role="pilote", id
        unique) -- pas celui de TaskConfigScreen (qui peut ne même pas
        exister, cf. contrainte "sans éditeur ouvert"), et surtout pas
        partagé entre exécutions parallèles (cf. docstring de
        ClientReseauAutoniaX : id_client DOIT être unique par connexion).
      - un registre d'instances occupées DÉDIÉ (dict neuf, pas
        TaskConfigScreen._instances_occupees_par_nos_tasks) -- chaque
        exécution headless a sa propre instance, jamais partagée avec une
        autre, donc aucun conflit possible entre exécutions headless
        elles-mêmes ; reste nécessaire uniquement parce que
        MoteurExecutionCellule l'exige en paramètre.

    callback_termine(ok: bool, message_erreur: str | None) est appelé
    (sur le thread Qt principal, comme tout callback de
    MoteurExecutionCellule) une fois TOUTES les cellules passées --
    succès si aucune cellule n'a fini en erreur, échec sinon (message_erreur
    = sortie/erreur concaténée de la ou des cellules en échec, pour
    écriture dans statut.json, cf. section 1 du patch)."""

    # Registre de classe (partagé par toutes les instances) -- garde une
    # référence forte à chaque ClientReseauAutoniaX pendant son arrêt
    # asynchrone (cf. _terminer) pour empêcher sa collecte prématurée par
    # le garbage collector pendant que son thread réseau interne est
    # encore en train de se terminer proprement.
    _CLIENTS_RESEAU_EN_ARRET: set = set()

    # Signaux de progression (cf. onglet "Aperçu d'exécution" de
    # ProjetBatchScreen, Brique C du plan de patch) -- émis sur le thread
    # Qt principal, comme callback_termine et tout le reste de cette
    # classe (_lancer_prochaine_cellule/_callback_cellule tournent déjà
    # sur ce thread via Qt.QueuedConnection, cf. MoteurExecutionCellule.
    # lancer -- aucune connexion supplémentaire ni changement de thread
    # nécessaire pour ces deux signaux).
    cellule_demarree = Signal(str, str)  # (cellule_id, titre) -- juste avant moteur.lancer(...)
    cellule_terminee = Signal(str, bool, str)  # (cellule_id, ok, sortie_ou_erreur) -- juste avant _lancer_prochaine_cellule()

    def __init__(
        self,
        project: "Project",
        task: "Task",
        instance_id: str,
        variables_supplementaires: dict,
        server_url: str = "",
        client_serveur_t: Optional["ClientServeurT"] = None,
    ):
        """variables_supplementaires : {nom_variable: chemin_absolu_fichier}
        -- le mapping résolu pour CE sous-projet précis (cf.
        MoteurExecutionBatch, section 3 du patch : construit à partir de
        ProjetBatch.mapping_variables + SousProjet.dossier_data), injecté
        DIRECTEMENT dans le namespace avant toute exécution, sans toucher
        au code affiché de cellule_variables (donc présent même si son
        code est vide/absent).

        server_url : URL du serveur WebSocket -- SERVER_URL_DASHBOARD par
        défaut (cf. lancer()), paramétrable seulement pour les tests.

        client_serveur_t (AJOUT -- cf. Api2Api_ecran_specification.md,
        section 2.2/4.2) : optionnel, None par défaut -- comportement
        RIGOUREUSEMENT INCHANGÉ pour tout appelant existant (ProjetBatch/
        MoteurExecutionBatch, qui ne le fournissent jamais) : sans lui,
        Api2Api()/attendre_requete()/textFile() sont simplement absents du
        namespace, exactement comme avant cet ajout. Si fourni (cf.
        Api2ApiScreen, seul appelant à le passer pour l'instant), permet à
        un Task exécuté ici (hors éditeur) d'utiliser Api2Api/attendre_
        requete/textFile -- MÊME injection que TaskConfigScreen._namespace_
        task pour le mode local/édition, cf. sa docstring pour le détail
        du couple Api2Api/attendre_requete lié à ce client_serveur_t."""
        super().__init__()
        self.project = project
        self.task = task
        self.instance_id = instance_id
        self._variables_supplementaires = dict(variables_supplementaires)
        self._server_url = server_url or SERVER_URL_DASHBOARD

        # Namespace neuf, isolé (cf. docstring de classe) -- même contenu
        # de départ que TaskConfigScreen._namespace_task, construit ici
        # directement plutôt que par délégation (cette dernière écrit
        # dans self._namespaces_tasks, propre à TaskConfigScreen).
        self._namespace: dict = {
            "__builtins__": __builtins__,
            "ZoneClicRect": ZoneClicRect,
            "InstanceExecutable": InstanceExecutable,
            "extraire_texte_fichier": extraire_texte_fichier,
            "ecrire_texte_fichier": ecrire_texte_fichier,
        }
        # BUGFIX -- gardé en attribut (pas seulement utilisé localement ci-
        # dessus pour construire le namespace) : nécessaire à _terminer()
        # pour désenregistrer ce Task du serveurT s'il tournait comme
        # fournisseur Api2Api (cf. _desenregistrer_api2api_si_besoin).
        self.client_serveur_t = client_serveur_t
        if client_serveur_t is not None:
            self._namespace["textFile"] = textFile
            self._namespace["TextFile"] = TextFile
            self._namespace.update(_construire_espace_noms_api2api(client_serveur_t))
        self._namespace.update(self._variables_supplementaires)

        # Copie LÉGÈRE de task (dataclasses.replace, déjà utilisé ailleurs
        # dans ce fichier) avec services_api_importes entièrement réécrit
        # pour pointer TOUS ses ServiceAPI vers self.instance_id -- décision
        # explicite utilisateur : "les instance dans l'éditeur ne comptent
        # pas, c'est pas sauvegardé, on spécifie toujours l'instance au
        # démarrage d'une task et là ça sera automatique". Une COPIE est
        # indispensable ici (jamais une mutation de self.task directement) :
        # plusieurs MoteurExecutionTaskHeadless tournent EN PARALLÈLE sur
        # LE MÊME objet Task en mémoire (un seul Task fixe par ProjetBatch,
        # cf. section 1 du patch) -- muter task.services_api_importes en
        # place ferait courir après le même dict entre exécutions
        # concurrentes, chacune écrasant l'instance_id de l'autre. cellules/
        # cellule_variables restent PARTAGÉES avec self.task volontairement
        # (copy superficielle -- replace() ne copie pas les listes/objets
        # imbriqués) : ce moteur ne les modifie jamais (il ne fait que lire
        # cellule.code), donc aucun risque à les partager en lecture entre
        # exécutions parallèles.
        self._task_pour_moteurs = replace(
            self.task,
            services_api_importes={nom: self.instance_id for nom in self.task.services_api_importes},
        )

        # Registre d'instances occupées DÉDIÉ à cette seule exécution (cf.
        # docstring de classe) -- MoteurExecutionCellule l'exige, mais
        # aucun autre moteur (headless ou non) n'a besoin d'y lire quoi
        # que ce soit ici : une instance headless ne partage jamais son
        # instance_id avec une autre exécution.
        self._registre_instances_occupees: dict = {}

        self._client_reseau: Optional["ClientReseauAutoniaX"] = None
        self._moteur_cellule_courant: Optional["MoteurExecutionCellule"] = None
        self._file_cellules: list = []  # list[TaskCellule], PAS des ids -- pas de widget à retrouver derrière
        self._erreurs_rencontrees: list = []  # sorties/erreurs des cellules en échec, cf. _callback_cellule dans _lancer_prochaine_cellule
        self._callback_termine: Optional[callable] = None

        # Séquence ORDONNÉE et INTACTE des cellules que ce moteur va
        # exécuter (cellule_variables + task.cellules, cf. lancer()) --
        # exposée publiquement dès la construction (avant même lancer())
        # pour que l'appelant (MoteurExecutionBatch) puisse construire le
        # notebook en lecture seule AVANT que la première cellule ne
        # démarre, cf. Brique C du plan de patch. Contrairement à
        # self._file_cellules (vidée au fur et à mesure par .pop(0) dans
        # _lancer_prochaine_cellule), sequence_cellules garde TOUJOURS son
        # contenu complet -- même liste d'objets TaskCellule, jamais
        # modifiée après ce point.
        self.sequence_cellules: list = []
        if self.task.cellule_variables is not None:
            self.sequence_cellules.append(self.task.cellule_variables)
        self.sequence_cellules.extend(self.task.cellules)

    def lancer(self, callback_termine: callable):
        """Démarre la séquence complète (cellule_variables PUIS
        task.cellules, dans cet ordre -- cf. docstring de classe).
        callback_termine(ok: bool, message_erreur: str | None) est appelé
        une seule fois, à la toute fin de la séquence."""
        self._callback_termine = callback_termine

        if not RESEAU_DASHBOARD_DISPONIBLE:
            self._terminer(False, "Réseau indisponible (module 'websockets' manquant) -- exécution impossible.")
            return

        self._client_reseau = ClientReseauAutoniaX(
            self._server_url, role="pilote", id_client=f"batch-{self.instance_id}-{uuid.uuid4().hex[:8]}",
        )
        self._client_reseau.demarrer()

        # Copie de self.sequence_cellules (déjà construite dans __init__,
        # cf. sa docstring) -- self._file_cellules est la file de travail
        # vidée au fur et à mesure par .pop(0), self.sequence_cellules
        # reste intacte pour l'appelant externe.
        self._file_cellules = list(self.sequence_cellules)

        self._lancer_prochaine_cellule()

    def _lancer_prochaine_cellule(self):
        if not self._file_cellules:
            self._terminer_normalement()
            return

        cellule = self._file_cellules.pop(0)
        services_utilises = _services_api_utilises_dans_code(self.project, self.task, cellule.code)

        try:
            moteur = MoteurExecutionCellule(
                client_reseau=self._client_reseau,
                task=self._task_pour_moteurs,
                cellule_id=cellule.id,
                instances_occupees_registre=self._registre_instances_occupees,
                # Force TOUJOURS self.instance_id pour tout ServiceAPI
                # réellement utilisé par cette cellule (cf. réécriture du
                # namespace juste après) -- un ensemble vide (cellule sans
                # ServiceAPI, ex. cellule_variables typique) est un cas
                # normal, pas une erreur : MoteurExecutionCellule.__init__
                # ne vérifie/lie QUE les instances des ServiceAPI listés
                # dans services_api_utilises, donc un ensemble vide ne lie
                # rien -- correct, rien à lier pour une cellule qui
                # n'utilise aucun ServiceAPI.
                services_api_utilises=services_utilises,
            )
        except (ServiceAPINonLieError, InstanceOccupeeError) as e:
            # Ne devrait normalement jamais arriver ici : self.instance_id
            # est toujours non vide (assigné par MoteurExecutionBatch avant
            # de construire ce moteur, cf. sa docstring) et le registre est
            # dédié à cette seule exécution (jamais occupé par un autre
            # Task). Gardé par prudence -- traité comme un échec de cette
            # cellule précise, la séquence continue quand même sur la
            # suivante (même comportement qu'une erreur d'exécution
            # normale, cf. docstring _executer_toutes_cellules : "Tout
            # exécuter" continue même après une erreur).
            self._erreurs_rencontrees.append(f"[{cellule.titre or cellule.id}] {e}")
            self._lancer_prochaine_cellule()
            return

        # Réécrit le namespace pour que les ComposantExecutable/
        # ServiceAPIExecutable de ce Task pointent sur LE MOTEUR DE CETTE
        # CELLULE PRÉCISE (créé ci-dessus) -- même principe que
        # TaskConfigScreen._executer_cellule (cf. son commentaire :
        # "_namespace_task seule ne peut pas le savoir à l'avance"). TOUS
        # les ComposantExecutable pointent vers self.instance_id, quels
        # que soient les ServiceAPI RÉELLEMENT utilisés par cette cellule
        # précise -- volontairement plus large que
        # TaskConfigScreen._executer_cellule (qui filtre sur instance_id
        # non vide par ServiceAPI) : ici il n'y a qu'une seule instance
        # possible pour tout le Task (cf. docstring de classe), donc
        # aucune raison de restreindre l'exposition dans le namespace.
        #
        # BUGFIX (même bug que TaskConfigScreen._executer_cellule, cf.
        # docstring de InstanceExecutable) : ServiceAPIExecutable reçoit
        # un RÉSOLVEUR (lambda sur self._moteur_cellule_courant, mis à
        # jour juste en dessous puis remis à None en fin de cellule dans
        # _callback_cellule) plutôt que `moteur` directement -- une
        # variable "Instance = Word.instance()" affectée ici et réutilisée
        # dans une cellule suivante doit retrouver LE moteur de cette
        # cellule suivante, pas celui (mort) de la cellule où elle a été
        # créée.
        resolveur_moteur = lambda: self._moteur_cellule_courant
        groupes = self.project.composants_importes_task(self.task)
        for nom_service, composants in groupes.items():
            for composant in composants:
                self._namespace[nom_variable_python(composant.nom)] = ComposantExecutable(
                    composant, self.instance_id, moteur, self._namespace,
                )
            self._namespace[nom_variable_python(nom_service)] = ServiceAPIExecutable(
                nom_service, self.instance_id, resolveur_moteur, self._namespace,
            )

        self._moteur_cellule_courant = moteur

        def _callback_cellule(resultat: dict):
            self._moteur_cellule_courant = None
            if not resultat["ok"]:
                message = resultat["erreur"] or resultat["sortie"] or "erreur inconnue"
                self._erreurs_rencontrees.append(f"[{cellule.titre or cellule.id}] {message}")
            # Émis AVANT _lancer_prochaine_cellule() (cf. docstring du
            # signal cellule_terminee) -- sortie_ou_erreur : message
            # d'erreur si échec, sinon la sortie normale de la cellule
            # (resultat["sortie"], jamais None ici puisque ok est True
            # dans ce cas).
            self.cellule_terminee.emit(
                cellule.id, resultat["ok"],
                (resultat["erreur"] or resultat["sortie"] or "") if not resultat["ok"] else (resultat["sortie"] or ""),
            )
            # Cf. _reimposer_variables_mappees -- réimpose le mapping
            # AVANT de lancer la cellule suivante, pour que la valeur
            # mappée (ex: RESPONSE_DIR -> data/Response_dir) ne reste
            # jamais écrasée par une réaffectation faite dans le code de
            # la cellule qui vient de se terminer (typiquement
            # cellule_variables).
            self._reimposer_variables_mappees()
            self._lancer_prochaine_cellule()

        # Émis juste avant moteur.lancer(...), cf. docstring du signal
        # cellule_demarree -- au moment où cette cellule précise commence
        # réellement à s'exécuter (pas au moment où elle est retirée de
        # la file quelques lignes plus haut, pour rester cohérent avec le
        # nom du signal si un jour une étape intermédiaire est ajoutée
        # entre les deux).
        self.cellule_demarree.emit(cellule.id, cellule.titre)
        moteur.lancer(self._namespace, cellule.code, _callback_cellule)

    def _reimposer_variables_mappees(self):
        """BUGFIX (constaté sur ProjetBatch -- variable RESPONSE_DIR
        mappée vers <sous_projet>/data/... mais écrasée dès la cellule
        "Variable dynamique", qui réaffecte RESPONSE_DIR en dur dans son
        propre code) : self._variables_supplementaires n'est injecté
        qu'UNE SEULE FOIS, dans __init__, AVANT toute exécution -- si le
        code d'une cellule (typiquement cellule_variables) réaffecte
        ensuite le MÊME nom de variable, exec(code, namespace) écrase
        purement et simplement cette entrée du dict namespace, sans
        distinction possible entre "variable normale du script" et
        "variable injectée par le mapping du batch". Le mapping perdait
        alors silencieusement la main pour le reste de l'exécution,
        malgré valider_conformite_projet_batch qui avait pourtant garanti
        que le fichier/dossier mappé existe bien.

        Correctif : réimpose la valeur du mapping dans self._namespace
        après CHAQUE cellule (appelé depuis _callback_cellule, cf.
        appel ci-dessous) -- pas seulement après cellule_variables, pour
        couvrir aussi le cas (plus rare) où une cellule ultérieure du
        Task réaffecterait elle-même une variable mappée. Idempotent et
        sans effet si aucune cellule ne réaffecte de variable mappée."""
        self._namespace.update(self._variables_supplementaires)

    def _terminer_normalement(self):
        """Toutes les cellules sont passées (avec ou sans erreur
        individuelle -- une erreur de cellule n'interrompt pas la
        séquence, cf. docstring de classe, même comportement que "Tout
        exécuter"). Succès global seulement si AUCUNE cellule n'a échoué."""
        if self._erreurs_rencontrees:
            self._terminer(False, "\n".join(self._erreurs_rencontrees))
        else:
            self._terminer(True, None)

    def _terminer(self, ok: bool, message_erreur: Optional[str]):
        # BUGFIX -- désenregistre ce Task du serveurT s'il tournait comme
        # fournisseur Api2Api (while True: attendre_requete()), que la fin
        # soit normale (_terminer_normalement) ou un arrêt manuel
        # (arreter(), ex. clic "Arrêter" dans la sidebar Api2Api) : dans
        # les deux cas, plus personne ne va relire attendre_requete()
        # après ce point, donc plus aucune raison de rester enregistré
        # comme fournisseur disponible (cf. _desenregistrer_api2api_si_
        # besoin pour le détail du problème corrigé).
        # BUGFIX 2 -- self._namespace (propre à CETTE instance/exécution),
        # pas self.client_serveur_t (partagé par tous les Tasks/moteurs du
        # même process côté mAutoniax) : cf. docstring de
        # _desenregistrer_api2api_si_besoin pour la raison de ce changement
        # de signature.
        _desenregistrer_api2api_si_besoin(self._namespace)
        if self._client_reseau is not None:
            # ClientReseauAutoniaX.arreter() est BLOQUANT (thread.join
            # jusqu'à 3s, cf. sa docstring) -- _terminer() est appelé
            # depuis callback_termine de MoteurExecutionCellule, qui
            # tourne sur le THREAD QT PRINCIPAL (Qt.QueuedConnection).
            # Avec N exécutions headless en parallèle (cf. section 4 du
            # patch), bloquer ce thread 3s à CHAQUE fin de sous-projet
            # gèlerait l'UI entière -- l'arrêt est donc délégué à un
            # thread daemon dédié, fire-and-forget (aucun résultat à
            # attendre : cette exécution est de toute façon terminée,
            # rien ne dépend plus de ce client réseau après cet appel).
            #
            # BUGFIX (constaté aux tests d'intégration -- "RuntimeError:
            # Signal source has been deleted") : self._client_reseau = None
            # juste après le démarrage du thread laissait ClientReseauAutoniaX
            # (un QObject) sans plus AUCUNE référence Python forte tant que
            # son thread d'arrêt tournait encore -- le garbage collector
            # pouvait le libérer AVANT que _boucle_async (thread réseau
            # interne) n'ait fini d'émettre self.deconnecte.emit() dans son
            # bloc finally, d'où le signal Qt sous-jacent déjà détruit.
            # _CLIENTS_RESEAU_EN_ARRET_HEADLESS le garde vivant (registre de
            # classe, jamais explicitement vidé un par un -- discard() en
            # fin de thread, cf. _finir_arret ci-dessous) le temps que
            # l'arrêt se termine réellement.
            client_a_fermer = self._client_reseau
            MoteurExecutionTaskHeadless._CLIENTS_RESEAU_EN_ARRET.add(client_a_fermer)

            def _finir_arret():
                client_a_fermer.arreter()
                MoteurExecutionTaskHeadless._CLIENTS_RESEAU_EN_ARRET.discard(client_a_fermer)

            threading.Thread(target=_finir_arret, daemon=True).start()
            self._client_reseau = None
        callback = self._callback_termine
        self._callback_termine = None
        if callback is not None:
            callback(ok, message_erreur)

    def arreter(self):
        """Coupe la séquence en cours (cf. MoteurExecutionBatch, arrêt
        d'un batch en cours de route) -- même principe que
        TaskConfigScreen._arreter_sequence : détache la cellule en cours
        sans attendre la fin de son thread, vide la file restante, et
        termine cette exécution en échec (message explicite, pour que
        statut.json reflète clairement une interruption plutôt qu'un vrai
        échec d'exécution)."""
        self._file_cellules = []
        if self._moteur_cellule_courant is not None:
            self._moteur_cellule_courant.arreter()
            self._moteur_cellule_courant = None
        self._terminer(False, "Exécution interrompue (arrêt du batch demandé).")


# ---------------------------------------------------------------------------
# PATCH "Projet Batch" -- brique 5 (RÉVISÉE) : orchestration d'un ProjetBatch
# par RÉUTILISATION d'instances déjà lancées et connectées (cf.
# PATCH_projet_batch.md, section 4, + décision explicite utilisateur qui
# révise cette section : "on doit juste cocher les instances qui sont déjà
# lancées, c'est eux qui seront utilisés, donc au démarrage on s'assure que
# la connexion est bien établie pour chaque instance, au lieu de spécifier
# juste un chiffre banal"). Remplace intégralement la version d'origine, qui
# lançait un subprocess nodriver FRAIS par sous-projet (cf. git blame /
# JOURNAL pour l'ancienne mouture, mode "round" compris) -- ne lance plus
# AUCUN process : consomme uniquement des instances déjà visibles et libres
# côté serveur (cf. srv_liste_instances_message, champ "libre").
#
# Mode "round" retiré (décision explicite utilisateur : perd son sens avec
# des instances réelles potentiellement instables -- une instance qui meurt
# en cours de lot n'a plus vraiment de "lot" cohérent à attendre). Seul le
# mode "pool" subsiste, implicitement -- pas de champ mode_orchestration.
#
# Sélection des sous-projets à traiter : révise aussi la section 4 du patch
# ("tous les sous-projets non 'succes' sont repris automatiquement") --
# décision explicite utilisateur : chaque sous-projet est individuellement
# sélectionnable (cf. SousProjet.selectionne, jamais persisté), la file ne
# contient plus TOUS les non-"succes" mais UNIQUEMENT ceux cochés au moment
# de lancer() (cf. ProjetBatchScreen, qui construit cette liste depuis l'état
# des cases à cocher affichées, PAS depuis un recalcul interne à ce moteur).
# ---------------------------------------------------------------------------

# Taille maximale (en caractères) conservée pour "sortie"/"erreur" d'une
# cellule au moment d'écrire une tentative dans notebook_execution.json
# (cf. SousProjet.ajouter_tentative_execution) -- décision explicite
# utilisateur suite au constat qu'une cellule produisant une sortie
# anormalement volumineuse (dump de données, log verbeux), combinée à de
# nombreuses relances d'un même sous-projet, peut faire grossir ce fichier
# jusqu'à des dizaines/centaines de Mo (mesuré : ~119 Mo pour 50 tentatives
# à 500 Ko/cellule sur 5 cellules), avec un impact direct sur la fluidité
# de l'UI (écriture synchrone dans le thread principal Qt à chaque fin de
# sous-projet, ET relecture complète à chaque clic précédent/suivant dans
# l'onglet Aperçu). Ne s'applique qu'À L'ÉCRITURE de l'historique persistant
# -- n'affecte jamais l'affichage LIVE (NotebookExecutionLectureSeule.
# marquer_cellule_terminee), qui reste toujours la sortie complète telle
# que produite pendant l'exécution en cours.
TAILLE_MAX_SORTIE_HISTORIQUE = 20_000


def _tronquer_pour_historique(texte: Optional[str]) -> Optional[str]:
    """Tronque `texte` à TAILLE_MAX_SORTIE_HISTORIQUE caractères pour son
    écriture dans notebook_execution.json, avec une mention explicite de
    troncature ajoutée à la fin (jamais silencieuse -- l'utilisateur doit
    pouvoir comprendre que ce qu'il voit dans l'historique n'est pas
    l'intégralité de la sortie réelle produite par la cellule). None reste
    None tel quel (pas de sortie/erreur à tronquer)."""
    if texte is None or len(texte) <= TAILLE_MAX_SORTIE_HISTORIQUE:
        return texte
    taille_originale = len(texte)
    return (
        texte[:TAILLE_MAX_SORTIE_HISTORIQUE]
        + f"\n\n[... tronqué pour l'historique -- {taille_originale:,} caractères au total, "
        f"seuls les {TAILLE_MAX_SORTIE_HISTORIQUE:,} premiers sont conservés ...]"
    )


def valider_conformite_projet_batch(projet_batch: "ProjetBatch") -> list:
    """Brique 1 (cf. docstring de MoteurExecutionBatch) : vérifie que
    CHAQUE sous-projet (dossier numéroté sous projet_batch.chemin_racine)
    est conforme avant tout démarrage -- décision explicite utilisateur :
    UN SEUL sous-projet non conforme bloque tout le batch, aucun
    démarrage partiel (cf. NonConformiteSousProjetError, _demarrer_batch).

    Un sous-projet est conforme si, pour CHAQUE entrée de
    projet_batch.mapping_variables ({nom_variable: nom_fichier_attendu},
    variables de type "path" uniquement), le fichier ou dossier
    correspondant existe bien dans <sous_projet>/data/ -- fichier ET
    dossier acceptés indifféremment (cf. _construire_variables_pour_
    sous_projet et le commentaire sur liste_fichiers : "les elements que
    lon peu lier a un path nes pas seulement des fichier mais aussi un
    dossier"), re-détecté sur le disque à chaque appel plutôt que
    mémorisé.

    Effet de bord volontaire ET documenté (cf. _appliquer_download_dir) :
    pour chaque sous-projet conforme, le dossier download/ est créé s'il
    n'existe pas encore (mkdir défensif, avant même le premier
    set_download_dir envoyé à chaud à l'instance qui le traitera).

    Retourne la liste des problèmes rencontrés : list[dict] avec les clés
    'numero' (int, numéro du sous-projet) et 'raison' (str, message
    explicite) -- [] si tous les sous-projets sont conformes. Ne lève
    jamais elle-même NonConformiteSousProjetError -- c'est à l'appelant
    (MoteurExecutionBatch.lancer(), ProjetBatchScreen._demarrer_batch) de
    décider quoi faire de cette liste (lever/afficher)."""
    problemes: list = []
    for sous_projet_dossier in projet_batch.lister_sous_projets():
        numero = int(sous_projet_dossier.name)
        dossier_data = sous_projet_dossier / "data"

        if not dossier_data.is_dir():
            problemes.append({
                "numero": numero,
                "raison": f"dossier data/ manquant ({dossier_data})",
            })
            continue

        manquants = []
        for nom_variable, nom_fichier_attendu in projet_batch.mapping_variables.items():
            if not nom_fichier_attendu:
                continue
            if not (dossier_data / nom_fichier_attendu).exists():
                manquants.append(f"'{nom_fichier_attendu}' (variable {nom_variable})")

        if manquants:
            problemes.append({
                "numero": numero,
                "raison": "élément(s) manquant(s) dans data/ : " + ", ".join(manquants),
            })
            continue

        # Conforme -- mkdir défensif du dossier download/, cf. docstring.
        try:
            (sous_projet_dossier / "download").mkdir(parents=True, exist_ok=True)
        except OSError as e:
            problemes.append({
                "numero": numero,
                "raison": f"impossible de créer le dossier download/ ({e})",
            })

    return problemes


class MoteurExecutionBatch(QObject):
    """Orchestre le traitement des sous-projets SÉLECTIONNÉS (cf. paramètre
    `sous_projets_a_traiter` de lancer() -- ce moteur ne décide plus
    lui-même quels sous-projets traiter, il exécute la liste qu'on lui
    donne) d'UN ProjetBatch, en réutilisant les instances déjà lancées et
    connectées dont l'instance_id figure dans
    projet_batch.instances_selectionnees.

    Avant tout démarrage (cf. lancer()) :
      1. valider_conformite_projet_batch (brique 1, inchangée) -- UN SEUL
         sous-projet non conforme bloque tout, cf. section 2 du patch.
      2. VÉRIFICATION DES INSTANCES (nouveau, remplace l'ancien lancement
         de subprocess) : chaque instance_id de instances_selectionnees
         doit apparaître CONNECTÉE ET LIBRE dans le prochain instances_list
         reçu du serveur, avec un court délai d'attente (le temps qu'un
         premier instances_list arrive après connexion de CE moteur) --
         si une seule est absente ou non libre, le démarrage est bloqué
         avec un message clair (même sévérité que la non-conformité des
         dossiers, décision explicite utilisateur), AUCUNE instance n'est
         sollicitée.

    Cycle de vie d'UN sous-projet, mode pool implicite (dès qu'une instance
    se libère, elle reprend immédiatement le sous-projet suivant de la
    file, sans attendre les autres) :
      1. set_download_dir envoyé À CHAUD sur l'instance (déjà connectée,
         PAS de nouveau subprocess) pour pointer vers le download/ de CE
         sous-projet précis -- cf. action réseau "set_download_dir",
         _appliquer_download_dir. Bloquant (link + command + unlink),
         cf. _appliquer_download_dir_bloquant.
      2. construction du mapping_variables résolu pour CE sous-projet et
         lancement d'un MoteurExecutionTaskHeadless dessus (brique 2,
         inchangée) -- gère lui-même son propre link/unlink par cellule.
      3. à la fin (succès ou échec) : statut.json écrit, PUIS --
         différence majeure avec l'ancienne version -- L'INSTANCE N'EST
         JAMAIS FERMÉE ni jetée : elle est immédiatement REPRISE pour le
         sous-projet suivant de la file (ou laissée libre/inactive si la
         file est vide, cf. _sur_sous_projet_termine).

    Si une instance sélectionnée se déconnecte EN COURS DE TRAITEMENT
    (détecté via liste_instances_recue qui ne la contient plus) : décision
    explicite utilisateur -- "le statut de la tâche est un échec mais pas
    pour le batch entier". Le sous-projet qu'elle traitait est marqué
    "echec", cette instance est retirée du pool actif (jamais reconsidérée
    pour cette exécution du batch, même si elle réapparaît plus tard), et
    le batch continue avec les instances restantes. Le batch entier ne
    s'arrête que quand la file est vide ET plus aucune instance active n'a
    de sous-projet en cours (cf. _verifier_fin_globale) -- y compris si
    TOUTES les instances finissent par se déconnecter : la file peut alors
    rester non vide indéfiniment, cf. _verifier_fin_globale qui détecte ce
    cas précis (aucune instance active restante ALORS QUE la file n'est pas
    vide) et termine le batch en échec plutôt que de rester bloqué
    silencieusement pour toujours.

    Un seul ClientReseauAutoniaX PARTAGÉ pour tout le moteur (role="pilote",
    id unique) -- reçoit liste_instances_recue en continu pour surveiller
    la connexion des instances sélectionnées, et sert aussi à l'envoi
    bloquant de set_download_dir (link/unlink ponctuels, cf.
    _appliquer_download_dir_bloquant) avant chaque sous-projet."""

    # Émis à chaque changement d'état d'un sous-projet (numero, nouveau
    # statut) -- pour que ProjetBatchScreen rafraîchisse sa grille de
    # statuts sans repasser par le disque.
    sous_projet_maj = Signal(int, str)  # numero, statut
    batch_termine = Signal()

    # BUGFIX (même cause que MoteurExecutionCellule._resultat_pret, cf. son
    # commentaire détaillé) : le thread dédié à l'attente/l'application du
    # download_dir tourne SANS event loop Qt -- un QTimer.singleShot(0, ...)
    # démarré depuis un tel thread n'expire jamais (Qt lie le timer au
    # thread appelant). Un signal Qt + Qt.QueuedConnection (connexion
    # implicite par défaut ici, cross-thread) traverse les threads de façon
    # fiable.
    _instance_prete_signal = Signal(str, bool, str)  # instance_id, ok, message_erreur (vide si ok)
    # Cf. _capturer_image_bug_cellule -- même raisonnement que
    # _instance_prete_signal ci-dessus (retour depuis un thread daemon
    # dédié SANS event loop Qt).
    _image_bug_recue_signal = Signal(str, str, str)  # instance_id, cellule_id, chemin_image ("" si échec)

    # Relais de la progression cellule par cellule (cf. onglet "Aperçu
    # d'exécution" de ProjetBatchScreen, Brique D du plan de patch) --
    # simple retransmission des signaux cellule_demarree/cellule_terminee
    # de CHAQUE MoteurExecutionTaskHeadless en cours (cf. _sur_instance_
    # prete, qui les connecte), avec l'instance_id en plus en tête pour
    # que l'écran sache à quelle instance/sous-projet ça correspond
    # (plusieurs sous-projets tournent en parallèle, cf. docstring de
    # classe -- indispensable pour ne mettre à jour QUE le notebook de
    # l'instance actuellement affichée).
    sous_projet_cellule_demarree = Signal(str, str, str)  # instance_id, cellule_id, titre
    sous_projet_cellule_terminee = Signal(str, str, bool, str)  # instance_id, cellule_id, ok, sortie_ou_erreur

    # Émis APRÈS sous_projet_cellule_terminee, uniquement pour une cellule
    # en erreur dont la capture_propre a abouti (cf. _capturer_image_bug_
    # cellule) -- toujours en retard sur cellule_terminee (aller-retour
    # réseau asynchrone), jamais émis du tout si la capture échoue/timeout
    # (pas de tentative de "chemin vide" envoyée : silence pur, cf.
    # décision utilisateur "sil ya pas diamage alors on lnaffiche pas").
    sous_projet_cellule_image_bug = Signal(str, str, str)  # instance_id, cellule_id, chemin_image

    TIMEOUT_VERIF_INSTANCES_S = 8.0  # attente du premier instances_list après connexion de CE moteur
    TIMEOUT_DOWNLOAD_DIR_S = 10.0  # link + set_download_dir + unlink, avant d'abandonner ce sous-projet
    TIMEOUT_CAPTURE_BUG_S = 8.0  # capture_propre demandée à l'instance après une cellule en erreur

    def __init__(self, project: "Project", projet_batch: "ProjetBatch", server_url: str = ""):
        super().__init__()
        self.project = project
        self.projet_batch = projet_batch
        self._server_url = server_url or SERVER_URL_DASHBOARD
        self.task = project.find_task(projet_batch.task_id)

        self._file_sous_projets: list = []  # list[SousProjet] restant à traiter
        self._en_cours: dict = {}  # instance_id -> SousProjet en cours de traitement
        self._instances_actives: list = []  # instance_id des instances RÉUTILISABLES pour ce batch (retrait définitif si déconnexion, cf. docstring)
        self._arret_demande = False
        self._callback_termine: Optional[callable] = None
        # PATCH (point 3 -- contrôle à distance réel sur les instances
        # démarrées par un ProjetBatch côté sAutoniax) : callback optionnel
        # (instance_id: str) -> None, appelé juste après qu'une instance
        # a été effectivement démarrée et enregistrée dans
        # _instances_par_profil (cf. _traiter_un_sous_projet ci-dessous).
        # None par défaut -- jamais assigné côté mAutoniax desktop
        # (ProfilsInstancesScreen n'en a pas besoin, ses instances sont
        # déjà pilotables localement sans passer par ce détour), assigné
        # UNIQUEMENT côté _main_async_sautoniax pour lier (link) chaque
        # nouvelle instance à client_pilote_instances.
        self._callback_instance_demarree: Optional[Callable[[str], None]] = None

        self._client_reseau: Optional["ClientReseauAutoniaX"] = None
        self._instances_connues: dict = {}  # instance_id -> libre (bool), mis à jour en continu depuis liste_instances_recue

        # Cf. Brique D du plan de patch (onglet "Aperçu d'exécution") --
        # AVANT ce patch, le MoteurExecutionTaskHeadless construit dans
        # _sur_instance_prete était une variable locale `moteur`, jetée
        # après usage (aucune référence conservée une fois lancer() lancé,
        # le callback suffisait jusqu'ici). Il faut désormais le garder
        # vivant le temps de l'exécution pour pouvoir lire sequence_
        # cellules depuis l'extérieur (cf. sequence_cellules_pour_instance
        # ci-dessous) et pour que ses signaux cellule_demarree/cellule_
        # terminee restent connectés.
        self._moteurs_task_en_cours: dict = {}  # instance_id -> MoteurExecutionTaskHeadless actif
        # Accumulateur des cellules déjà terminées pendant l'exécution en
        # cours, par instance -- alimenté à chaque sous_projet_cellule_
        # terminee (cf. _sur_instance_prete), vidé et transformé en
        # tentative complète (cf. Brique B) dans _finir_sous_projet.
        # list[dict] au format "cellule" de la structure Brique B (id/
        # titre/code/sortie/erreur/atteinte), un dict par cellule déjà
        # passée, dans l'ordre où elles se sont terminées (== l'ordre de
        # sequence_cellules, l'exécution est strictement séquentielle par
        # instance, cf. MoteurExecutionTaskHeadless).
        self._sorties_cellules_en_cours: dict = {}  # instance_id -> list[dict]
        # Chemins des captures d'écran de bug déjà obtenues pendant la
        # tentative en cours, par instance -- alimenté par _capturer_
        # image_bug_cellule (thread dédié) avant _finir_sous_projet, pour
        # être injecté dans la tentative complète (cf. Brique B) au même
        # titre que les sorties/erreurs. {instance_id: {cellule_id: chemin}}
        self._images_bug_en_cours: dict = {}
        # Dernier SousProjet traité par chaque instance, y compris une
        # fois _finir_sous_projet passé -- cf. _sur_image_bug_recue,
        # nécessaire pour corriger a posteriori l'historique quand une
        # capture_propre arrive en retard sur _finir_sous_projet (l'
        # instance a alors déjà pu enchaîner sur un sous-projet suivant,
        # ce registre garde la trace du bon SousProjet à corriger).
        self._dernier_sous_projet_par_instance: dict = {}

        self._instance_prete_signal.connect(self._sur_instance_prete)
        # Même bugfix/raisonnement que _instance_prete_signal (cf. son
        # commentaire) : _capturer_image_bug_cellule tourne sur un thread
        # daemon dédié sans event loop Qt -- ce signal + Qt.QueuedConnection
        # (implicite, cross-thread) fait revenir le résultat proprement sur
        # le thread Qt principal.
        self._image_bug_recue_signal.connect(self._sur_image_bug_recue)
        # Cf. _finir_sous_projet/_sauvegarder_debug_echec_sous_projet
        # (Patch 2) -- même raisonnement, ramène la VRAIE finalisation sur
        # le thread Qt principal une fois la capture debug bloquante
        # revenue depuis son thread daemon dédié.
        self._finir_sous_projet_signal.connect(
            lambda instance_id, sous_projet, ok, message_erreur: self._finir_sous_projet_apres_debug(
                instance_id, sous_projet, ok, message_erreur or None,
            )
        )

    # ------------------------------------------------------------------
    # Démarrage
    # ------------------------------------------------------------------
    def lancer(self, sous_projets_a_traiter: list, callback_termine: callable):
        """sous_projets_a_traiter : list[SousProjet] déjà filtrée par
        l'appelant (cf. ProjetBatchScreen, état des cases à cocher affichées
        -- ce moteur ne recalcule plus lui-même "tout ce qui n'est pas
        succes", cf. docstring de classe). callback_termine() appelé une
        seule fois, sur le thread Qt principal, quand la file est épuisée
        (ou après arreter()). Lève NonConformiteSousProjetError SANS rien
        lancer si la validation de conformité (brique 1) trouve un problème,
        et InstancesIndisponiblesError SANS rien lancer si une ou plusieurs
        instances sélectionnées ne sont pas connectées/libres -- aucun
        démarrage partiel dans les deux cas (décision explicite
        utilisateur, cf. docstring de classe)."""
        self._callback_termine = callback_termine

        if self.task is None:
            self._terminer_avec_erreur(f"Task '{self.projet_batch.task_id}' introuvable dans le Project -- ProjetBatch mal configuré.")
            return
        if not RESEAU_DASHBOARD_DISPONIBLE:
            self._terminer_avec_erreur("Réseau indisponible (module 'websockets' manquant) -- exécution impossible.")
            return

        problemes = valider_conformite_projet_batch(self.projet_batch)
        if problemes:
            raise NonConformiteSousProjetError(problemes)

        instances_visees = list(dict.fromkeys(self.projet_batch.instances_selectionnees))  # dédoublonné, ordre conservé
        if not instances_visees:
            self._terminer_avec_erreur("Aucune instance sélectionnée -- cochez au moins une instance déjà lancée avant de démarrer.")
            return

        self._file_sous_projets = list(sous_projets_a_traiter)
        if not self._file_sous_projets:
            log.info(f"ProjetBatch '{self.projet_batch.nom}' : aucun sous-projet sélectionné à traiter.")
            self._terminer_normalement()
            return

        # --- Vérification des instances : CONNECTÉES ET LIBRES, cf.
        # docstring de classe -- bloquant, avec délai d'attente court pour
        # laisser arriver le premier instances_list après connexion de ce
        # moteur (le serveur diffuse la liste à chaque changement, mais ce
        # moteur vient tout juste de se connecter -- rien à comparer avant
        # ce premier message, cf. _sur_liste_instances_recue). ---
        ok_verif, message_verif = self._verifier_instances_bloquant(instances_visees)
        if not ok_verif:
            raise InstancesIndisponiblesError(message_verif)

        self._instances_actives = list(instances_visees)

        # Le client réseau reste connecté pour toute la durée du batch --
        # surveille en continu la présence/liberté des instances actives
        # (cf. _sur_liste_instances_recue) et sert aux envois bloquants de
        # set_download_dir (cf. _appliquer_download_dir_bloquant, qui
        # RÉUTILISE ce même client, jamais un client jetable).
        self._client_reseau = ClientReseauAutoniaX(
            self._server_url, role="pilote", id_client=f"orchestrateur-batch-{self.projet_batch.id}-{uuid.uuid4().hex[:8]}",
        )
        self._client_reseau.liste_instances_recue.connect(self._sur_liste_instances_recue)

        # BUGFIX (symptôme observé : "Timeout en attendant la liaison à
        # l'instance" -- systématiquement sur le PREMIER sous-projet
        # démarré, jamais les suivants) : demarrer() lance le thread réseau
        # et retourne IMMÉDIATEMENT, sans attendre que la connexion
        # websocket soit établie ni que "register" soit envoyé (cf.
        # ClientReseauAutoniaX._boucle_async : jusqu'à 10s de retry avant
        # même la première tentative de connexion, cf. sa docstring). Or
        # envoyer_commande() ne vérifie que self._loop.is_running() --
        # déjà vrai dès l'entrée dans _boucle_async, AVANT que self._ws ne
        # soit assigné -- donc un envoi de "link" pendant cette fenêtre
        # part dans le vide (_envoyer_async ignore silencieusement si
        # self._ws est None). Le PREMIER _demarrer_sous_projet_sur_instance
        # (appelé juste en dessous, tout de suite après demarrer()) tombait
        # régulièrement dans cette fenêtre ; les suivants (déclenchés plus
        # tard par _sur_sous_projet_termine, une fois un vrai traitement
        # déjà écoulé) ne l'ont jamais rencontrée, d'où le symptôme "un seul
        # sous-projet échoue, toujours le premier". Correctif : attendre
        # explicitement le signal connecte() (bloquant, comme
        # _verifier_instances_bloquant le fait déjà pour instances_list)
        # avant de démarrer le moindre sous-projet.
        event_connecte = threading.Event()
        self._client_reseau.connecte.connect(lambda: event_connecte.set(), Qt.DirectConnection)
        self._client_reseau.demarrer()
        if not event_connecte.wait(timeout=self.TIMEOUT_VERIF_INSTANCES_S):
            self._terminer_avec_erreur(
                "Connexion au serveur impossible pour l'orchestrateur du batch (délai dépassé) -- "
                "vérifiez que le serveur est bien démarré."
            )
            return

        # Mode pool implicite (cf. docstring de classe) : CHAQUE instance
        # active démarre immédiatement sur un sous-projet de la file, puis
        # _sur_sous_projet_termine relance la suivante dès qu'une instance
        # se libère -- aucune notion de "lot" à proprement parler.
        for instance_id in list(self._instances_actives):
            self._demarrer_sous_projet_sur_instance(instance_id)

    def _verifier_instances_bloquant(self, instances_visees: list) -> tuple:
        """Bloquant (appelé depuis lancer(), donc le thread Qt principal --
        acceptable ici : attente courte et unique, une seule fois par
        lancement de batch, même compromis qu'ailleurs dans ce fichier pour
        des attentes ponctuelles brèves). Connecte un client réseau
        JETABLE (pas celui du moteur -- ce client-ci n'existe QUE pour
        cette vérification, fermé juste après qu'elle se termine), attend
        le premier instances_list, et vérifie que chaque instance visée y
        apparaît avec libre=True.

        Retourne (True, "") si toutes les instances sont connectées et
        libres ; (False, message_detaille) sinon -- jamais d'exception ici,
        c'est lancer() qui décide de la transformer en
        InstancesIndisponiblesError (cohérent avec valider_conformite_
        projet_batch, qui retourne aussi une liste plutôt que de lever)."""
        resultat: dict = {"recu": False, "instances": []}
        event = threading.Event()

        client_verif = ClientReseauAutoniaX(
            self._server_url, role="pilote", id_client=f"verif-batch-{self.projet_batch.id}-{uuid.uuid4().hex[:8]}",
        )

        def _sur_liste(instances: list):
            resultat["recu"] = True
            resultat["instances"] = instances
            event.set()

        client_verif.liste_instances_recue.connect(_sur_liste, Qt.DirectConnection)
        client_verif.demarrer()
        try:
            obtenu = event.wait(timeout=self.TIMEOUT_VERIF_INSTANCES_S)
        finally:
            client_verif.liste_instances_recue.disconnect(_sur_liste)
            # Fermeture fire-and-forget -- même raisonnement que
            # _fermer_client_reseau_orchestrateur (thread daemon dédié, ce
            # client n'a plus aucun usage après cette vérification).
            MoteurExecutionTaskHeadless._CLIENTS_RESEAU_EN_ARRET.add(client_verif)

            def _finir_arret():
                client_verif.arreter()
                MoteurExecutionTaskHeadless._CLIENTS_RESEAU_EN_ARRET.discard(client_verif)
            threading.Thread(target=_finir_arret, daemon=True).start()

        if not obtenu or not resultat["recu"]:
            return False, (
                "Impossible de vérifier l'état des instances (aucune réponse du serveur) -- "
                "vérifiez que le serveur est bien démarré et réessayez."
            )

        par_id = {i["id"]: i for i in resultat["instances"]}
        problemes = []
        for instance_id in instances_visees:
            info = par_id.get(instance_id)
            if info is None:
                problemes.append(f"« {instance_id} » : non connectée")
            elif not info.get("libre", False):
                problemes.append(f"« {instance_id} » : déjà occupée par un autre pilote")
        if problemes:
            detail = "\n".join(f"  - {p}" for p in problemes)
            return False, f"{len(problemes)} instance(s) indisponible(s) -- démarrage bloqué :\n{detail}"
        return True, ""

    # ------------------------------------------------------------------
    # Cycle de vie d'UN sous-projet sur UNE instance déjà active
    # ------------------------------------------------------------------
    def _demarrer_sous_projet_sur_instance(self, instance_id: str):
        if self._arret_demande or not self._file_sous_projets:
            self._verifier_fin_globale()
            return
        if instance_id not in self._instances_actives:
            return  # retirée entre-temps (déconnexion, cf. _sur_liste_instances_recue) -- ne prend plus de travail

        sous_projet = self._file_sous_projets.pop(0)
        self._en_cours[instance_id] = sous_projet
        self.sous_projet_maj.emit(sous_projet.numero, "en_cours")

        def _travail():
            ok, message = self._appliquer_download_dir_bloquant(instance_id, str(sous_projet.dossier_download))
            self._instance_prete_signal.emit(instance_id, ok, message)
        threading.Thread(target=_travail, daemon=True).start()

    def _appliquer_download_dir_bloquant(self, instance_id: str, download_dir: str) -> tuple:
        """Envoie link, PUIS action="set_download_dir", PUIS unlink -- même
        protocole/pattern que MoteurExecutionCellule._lier_instance_si_besoin
        + _appeler + _delier_instance, mais rejoué ici manuellement (via des
        Event()/callbacks locaux à CET appel, jamais posés sur self --
        plusieurs sous-projets peuvent demander ceci EN PARALLÈLE, mode pool
        sur plusieurs instances à la fois) puisque ce moteur ne passe pas
        par MoteurExecutionCellule pour cette étape précise (elle a lieu
        AVANT de construire le MoteurExecutionTaskHeadless du sous-projet,
        cf. _demarrer_sous_projet_sur_instance).

        Tourne sur un thread dédié (jamais le thread Qt principal) --
        appelé depuis _demarrer_sous_projet_sur_instance. Retourne
        (True, "") si le download_dir a bien été appliqué ; (False,
        message) sinon (timeout de liaison, refus serveur, ou échec CDP
        signalé par command_result ok=False)."""
        client = self._client_reseau
        if client is None:
            return False, "Client réseau de l'orchestrateur indisponible."

        event_link = threading.Event()
        resultat_link: dict = {"ok": False, "message": ""}
        event_command = threading.Event()
        resultat_command: dict = {"ok": False, "message": ""}

        def _sur_link_ok(iid: str):
            if iid == instance_id:
                resultat_link["ok"] = True
                event_link.set()

        def _sur_liaison_echouee(iid: str, msg: str):
            if iid == instance_id:
                resultat_link["ok"] = False
                resultat_link["message"] = msg
                event_link.set()

        def _sur_command_result(data: dict):
            if data.get("instance_id") == instance_id:
                resultat_command["ok"] = bool(data.get("ok"))
                resultat_command["message"] = str(data.get("error") or "")
                event_command.set()

        # Qt.DirectConnection : ces callbacks tournent sur le thread RÉSEAU
        # du client partagé, jamais sur le thread Qt principal --
        # indispensable puisque ce thread-ci (dédié à CET appel précis)
        # bloque sur des Event().wait(), même raisonnement que
        # l'ancien _fermer_instance_bloquant.
        client.link_ok_recu.connect(_sur_link_ok, Qt.DirectConnection)
        client.liaison_echouee.connect(_sur_liaison_echouee, Qt.DirectConnection)
        client.command_result_recu.connect(_sur_command_result, Qt.DirectConnection)
        try:
            client.envoyer_commande({"type": "link", "pilote_id": client.id_client, "instance_id": instance_id})
            if not event_link.wait(timeout=self.TIMEOUT_DOWNLOAD_DIR_S / 2):
                return False, f"Timeout en attendant la liaison à l'instance « {instance_id} »."
            if not resultat_link.get("ok"):
                return False, f"Liaison à l'instance « {instance_id} » refusée : {resultat_link.get('message')}"

            requete_id = uuid.uuid4().hex[:12]
            client.envoyer_commande({
                "type": "command", "instance_id": instance_id, "requete_id": requete_id,
                "action": "set_download_dir", "download_dir": download_dir,
            })
            if not event_command.wait(timeout=self.TIMEOUT_DOWNLOAD_DIR_S / 2):
                return False, f"Timeout en attendant la confirmation de set_download_dir sur « {instance_id} »."
            if not resultat_command.get("ok"):
                return False, f"Échec de set_download_dir sur « {instance_id} » : {resultat_command.get('message')}"
            return True, ""
        finally:
            client.link_ok_recu.disconnect(_sur_link_ok)
            client.liaison_echouee.disconnect(_sur_liaison_echouee)
            client.command_result_recu.disconnect(_sur_command_result)
            # unlink -- CETTE liaison n'était que pour set_download_dir ;
            # MoteurExecutionTaskHeadless (juste après, cf.
            # _sur_instance_prete) refait son propre link avec SON PROPRE
            # client réseau, indépendamment de celui-ci.
            try:
                client.envoyer_commande({"type": "unlink", "instance_id": instance_id})
            except Exception:
                pass

    # ------------------------------------------------------------------
    # Capture d'écran automatique sur erreur de cellule (retour
    # utilisateur explicite : "je veux aussi que on gere laffihcage de
    # bugs qui on ete sauvregarder avec leur image") -- réutilise l'action
    # réseau "capture_propre" déjà existante (cf. InstanceApercuScreen.
    # _demander_capture_propre, même action côté instance_nodriver.py),
    # ici rejouée en bloquant (même pattern que _appliquer_download_dir_
    # bloquant juste au-dessus) sur un thread daemon dédié -- jamais le
    # thread Qt principal, et jamais le _client_reseau d'un autre appel en
    # cours puisque plusieurs sous-projets/cellules peuvent échouer en
    # parallèle sur des instances différentes.
    # ------------------------------------------------------------------
    def _capturer_image_bug_cellule(self, instance_id: str, cellule_id: str):
        """Envoie link + capture_propre à l'instance, sauvegarde l'image
        décodée sous SousProjet.dossier_debug/{cellule_id}.jpg si elle
        arrive à temps, puis émet _image_bug_recue_signal (chemin vide
        "" en cas d'échec/timeout -- jamais d'exception propagée hors de
        ce thread). Tourne entièrement sur ce thread daemon ; le retour
        vers le thread Qt principal se fait uniquement via le signal, cf.
        docstring de _image_bug_recue_signal."""
        chemin_image = ""
        try:
            client = self._client_reseau
            sous_projet = self._en_cours.get(instance_id)
            if client is None or sous_projet is None:
                return

            event_link = threading.Event()
            resultat_link: dict = {"ok": False}
            event_command = threading.Event()
            resultat_command: dict = {"ok": False, "image_b64": None}

            def _sur_link_ok(iid: str):
                if iid == instance_id:
                    resultat_link["ok"] = True
                    event_link.set()

            def _sur_liaison_echouee(iid: str, msg: str):
                if iid == instance_id:
                    resultat_link["ok"] = False
                    event_link.set()

            requete_id = uuid.uuid4().hex[:12]

            def _sur_command_result(data: dict):
                if data.get("requete_id") != requete_id:
                    return
                resultat_command["ok"] = bool(data.get("ok"))
                resultat_command["image_b64"] = (data.get("result") or {}).get("image_b64")
                event_command.set()

            # Qt.DirectConnection -- même raisonnement que
            # _appliquer_download_dir_bloquant : ce thread bloque sur des
            # Event().wait(), ces callbacks doivent tourner sur le thread
            # réseau du client partagé, pas sur le thread Qt principal.
            client.link_ok_recu.connect(_sur_link_ok, Qt.DirectConnection)
            client.liaison_echouee.connect(_sur_liaison_echouee, Qt.DirectConnection)
            client.command_result_recu.connect(_sur_command_result, Qt.DirectConnection)
            try:
                client.envoyer_commande({"type": "link", "pilote_id": client.id_client, "instance_id": instance_id})
                if not event_link.wait(timeout=self.TIMEOUT_CAPTURE_BUG_S / 2):
                    return
                if not resultat_link.get("ok"):
                    return

                client.envoyer_commande({
                    "type": "command", "instance_id": instance_id, "requete_id": requete_id,
                    "action": "capture_propre",
                })
                if not event_command.wait(timeout=self.TIMEOUT_CAPTURE_BUG_S / 2):
                    return
                if not resultat_command.get("ok"):
                    return
                image_b64 = resultat_command.get("image_b64")
                if not image_b64:
                    return

                # Décodage + écriture disque -- toute erreur ici (base64
                # invalide, dossier non accessible) ne doit jamais faire
                # planter ce thread : chemin_image reste "" (comme si la
                # capture avait simplement échoué), _sur_image_bug_recue
                # n'affiche alors rien (cf. décision utilisateur "sil ya
                # pas diamage alors on lnaffiche pas").
                try:
                    donnees_image = base64.b64decode(image_b64)
                    sous_projet.dossier_debug.mkdir(parents=True, exist_ok=True)
                    fichier = sous_projet.dossier_debug / f"{cellule_id}.jpg"
                    fichier.write_bytes(donnees_image)
                    chemin_image = str(fichier)
                except Exception as exc:
                    log.warning(f"[{instance_id}] écriture de l'image de bug de la cellule '{cellule_id}' échouée : {exc!r}")
                    chemin_image = ""
            finally:
                client.link_ok_recu.disconnect(_sur_link_ok)
                client.liaison_echouee.disconnect(_sur_liaison_echouee)
                client.command_result_recu.disconnect(_sur_command_result)
                try:
                    client.envoyer_commande({"type": "unlink", "instance_id": instance_id})
                except Exception:
                    pass
        except Exception as exc:
            log.warning(f"[{instance_id}] capture de l'image de bug de la cellule '{cellule_id}' échouée : {exc!r}")
            chemin_image = ""
        finally:
            self._image_bug_recue_signal.emit(instance_id, cellule_id, chemin_image)

    def _sur_image_bug_recue(self, instance_id: str, cellule_id: str, chemin_image: str):
        """Slot connecté à _image_bug_recue_signal (cf. son commentaire :
        retour cross-thread depuis _capturer_image_bug_cellule) -- tourne
        sur le thread Qt principal. N'enregistre/ne relaie RIEN si
        chemin_image est vide (capture échouée ou timeout) : ni dans
        l'accumulateur destiné à l'historique (Brique B), ni vers l'écran
        -- cohérent avec _afficher_image_bug côté NotebookExecutionLecture
        Seule, qui de toute façon n'affiche rien sans chemin."""
        if not chemin_image:
            return
        if instance_id in self._en_cours:
            # Sous-projet toujours en cours sur cette instance : la
            # capture est arrivée à temps, _finir_sous_projet (pas encore
            # passé) la lira depuis cet accumulateur pour construire la
            # tentative -- cf. son commentaire "images_bug_par_cellule_id".
            self._images_bug_en_cours.setdefault(instance_id, {})[cellule_id] = chemin_image
        else:
            # _finir_sous_projet est déjà passé (capture arrivée en
            # retard, aller-retour réseau) : la tentative est déjà écrite
            # dans l'historique sans cette image -- corrigée a posteriori
            # sur le SousProjet qui était en cours au moment de la
            # capture, cf. _dernier_sous_projet_par_instance. Ignoré
            # silencieusement si cette instance n'a encore jamais terminé
            # aucun sous-projet (ne devrait pas arriver : une capture ne
            # peut être demandée qu'après une cellule_terminee, donc au
            # moins UN sous-projet est déjà passé par _sur_instance_prete
            # pour cette instance).
            sous_projet = self._dernier_sous_projet_par_instance.get(instance_id)
            if sous_projet is not None:
                sous_projet.corriger_image_bug_derniere_tentative(cellule_id, chemin_image)
        self.sous_projet_cellule_image_bug.emit(instance_id, cellule_id, chemin_image)

    def _sur_liste_instances_recue(self, instances: list):
        # QueuedConnection (connexion par défaut d'un signal Qt cross-
        # thread) : ce slot tourne bien sur le thread Qt principal, jamais
        # concurremment avec lui-même.
        self._instances_connues = {i["id"]: i.get("libre", False) for i in instances}

        # Détecte une instance ACTIVE qui vient de disparaître (cf.
        # docstring de classe : décision explicite utilisateur -- son
        # sous-projet en cours passe en "echec", le batch continue avec
        # les instances restantes, cette instance n'est plus jamais
        # sollicitée pour cette exécution du batch même si elle
        # réapparaît).
        for instance_id in list(self._instances_actives):
            if instance_id not in self._instances_connues:
                self._instances_actives.remove(instance_id)
                sous_projet = self._en_cours.pop(instance_id, None)
                if sous_projet is not None:
                    log.warning(f"ProjetBatch '{self.projet_batch.nom}', sous-projet {sous_projet.numero} : instance '{instance_id}' déconnectée en cours de traitement -- marqué en échec, batch non interrompu.")
                    message_erreur = f"Instance « {instance_id} » déconnectée pendant le traitement."
                    # PATCH (Patch 2) -- logs.txt seul ici (pas de tentative
                    # de screenshot.png : l'instance vient de se
                    # déconnecter, un capture_propre échouerait
                    # immédiatement au link, cf. _sauvegarder_debug_echec_
                    # sous_projet). Écrit en direct (pas de thread daemon
                    # nécessaire, aucun aller-retour réseau ici).
                    try:
                        sous_projet.dossier_debug.mkdir(parents=True, exist_ok=True)
                        (sous_projet.dossier_debug / "logs.txt").write_text(message_erreur, encoding="utf-8")
                    except Exception as exc:
                        log.warning(f"[{instance_id}] écriture de debug/logs.txt échouée pour le sous-projet {sous_projet.numero} : {exc!r}")
                    sous_projet.ecrire_statut("echec", message_erreur)
                    self.sous_projet_maj.emit(sous_projet.numero, "echec")
                self._verifier_fin_globale()

    def _sur_instance_prete(self, instance_id: str, ok: bool, message_erreur: str):
        sous_projet = self._en_cours.get(instance_id)
        if sous_projet is None:
            return  # arreter() ou une déconnexion est passée entre-temps et a déjà nettoyé -- rien à faire
        if not ok:
            log.warning(f"ProjetBatch '{self.projet_batch.nom}', sous-projet {sous_projet.numero} : échec de préparation de l'instance '{instance_id}' -- {message_erreur}")
            self._finir_sous_projet(instance_id, sous_projet, False, message_erreur)
            return

        variables = self._construire_variables_pour_sous_projet(sous_projet)
        moteur = MoteurExecutionTaskHeadless(
            project=self.project, task=self.task, instance_id=instance_id,
            variables_supplementaires=variables, server_url=self._server_url,
        )

        # Cf. Brique D du plan de patch -- gardé vivant pour toute la
        # durée de l'exécution (retiré dans _finir_sous_projet), et son
        # accumulateur de sorties de cellules réinitialisé pour CETTE
        # tentative précise (un sous-projet peut être retraité plusieurs
        # fois sur des instances différentes au fil du batch, chaque
        # passage repart d'une liste vide).
        self._moteurs_task_en_cours[instance_id] = moteur
        self._sorties_cellules_en_cours[instance_id] = []
        self._images_bug_en_cours[instance_id] = {}

        def _relayer_cellule_demarree(cellule_id: str, titre: str, _instance_id=instance_id):
            self.sous_projet_cellule_demarree.emit(_instance_id, cellule_id, titre)

        def _relayer_cellule_terminee(cellule_id: str, ok: bool, sortie_ou_erreur: str, _instance_id=instance_id):
            self._sorties_cellules_en_cours.setdefault(_instance_id, []).append({
                "cellule_id": cellule_id,
                "atteinte": True,
                "sortie": sortie_ou_erreur if ok else None,
                "erreur": None if ok else sortie_ou_erreur,
            })
            self.sous_projet_cellule_terminee.emit(_instance_id, cellule_id, ok, sortie_ou_erreur)
            # Capture d'écran automatique sur erreur (cf. décision
            # utilisateur explicite) -- déclenchée ICI, après l'émission
            # de cellule_terminee (l'écran affiche déjà la sortie/erreur
            # immédiatement, l'image suit dès qu'elle arrive, cf.
            # sous_projet_cellule_image_bug/_sur_image_bug_recue). Jamais
            # bloquant sur ce thread Qt : la capture réseau tourne sur son
            # propre thread daemon, même pattern que _appliquer_download_
            # dir_bloquant.
            if not ok:
                threading.Thread(
                    target=self._capturer_image_bug_cellule,
                    args=(_instance_id, cellule_id),
                    daemon=True,
                ).start()

        moteur.cellule_demarree.connect(_relayer_cellule_demarree)
        moteur.cellule_terminee.connect(_relayer_cellule_terminee)

        def _callback_task(task_ok: bool, task_message_erreur: Optional[str]):
            self._finir_sous_projet(instance_id, sous_projet, task_ok, task_message_erreur)

        moteur.lancer(_callback_task)

    def sequence_cellules_pour_instance(self, instance_id: str) -> list:
        """Séquence ORDONNÉE et complète des cellules (cellule_variables +
        task.cellules) du MoteurExecutionTaskHeadless actuellement en
        cours pour instance_id -- cf. Brique D/F du plan de patch,
        utilisée par ProjetBatchScreen pour construire le notebook en
        lecture seule (demarrer_sequence) dès qu'un sous-projet démarre
        sur cette instance, AVANT même que la première cellule n'ait
        démarré. [] si aucune exécution n'est en cours pour cette
        instance (pas encore démarrée, ou déjà terminée -- l'appelant
        n'a normalement aucune raison d'appeler ceci hors de ce cas)."""
        moteur = self._moteurs_task_en_cours.get(instance_id)
        if moteur is None:
            return []
        return list(moteur.sequence_cellules)

    def _construire_variables_pour_sous_projet(self, sous_projet: "SousProjet") -> dict:
        """{nom_variable: chemin_absolu} -- cf. section 3 du patch : LE
        CHEMIN du fichier OU du dossier (les deux sont acceptés, cf.
        valider_conformite_projet_batch), jamais son contenu.
        valider_conformite_projet_batch (brique 1) a déjà garanti, avant
        tout démarrage, que chaque élément de mapping_variables.values()
        existe bien dans sous_projet/data/ -- pas de re-vérification
        défensive ici, la garantie vient d'être établie par lancer()
        juste avant.

        BUGFIX (constaté après le correctif de _reimposer_variables_
        mappees, cf. MoteurExecutionTaskHeadless._lancer_prochaine_
        cellule -- "AttributeError: 'str' object has no attribute
        'mkdir'") : cette valeur était auparavant convertie en str()
        avant injection. Tant que le mapping restait écrasé par la
        réaffectation de cellule_variables (bug corrigé séparément),
        cette conversion en str() ne posait jamais de problème visible
        -- le code métier ne voyait jamais la valeur injectée. Une fois
        le mapping réellement appliqué, le code des Tasks (écrit en
        attendant un pathlib.Path, comme la valeur par défaut de
        cellule_variables : Path.home() / "Documents" / "AutoniaxDemo")
        plante dès qu'il appelle .mkdir(), .iterdir(), ou / sur cette
        chaîne. Un objet Path, pas un str, est donc désormais injecté --
        cohérent avec le type que produit le code par défaut du Task, et
        toujours utilisable comme chaîne partout où un str est attendu
        (Path implémente __fspath__ / __str__)."""
        variables = {
            nom_variable: (sous_projet.dossier_data / nom_fichier).resolve()
            for nom_variable, nom_fichier in self.projet_batch.mapping_variables.items()
        }
        # PATCH -- variables "valeur" (int/float/bool, cf.
        # detecter_type_variable_dynamique) cochées "à personnaliser" :
        # même valeur Python injectée pour TOUS les sous-projets (pas de
        # variation par sous-projet, contrairement aux chemins ci-dessus
        # qui pointent chacun vers le data/ du sous-projet concerné --
        # cohérent avec la décision utilisateur : une valeur numérique
        # n'a pas de sens à varier par dossier, seul un chemin en a).
        # variables_personnalisees peut légitimement ne pas contenir TOUTE
        # entrée de variables_a_personnaliser (ex: décochée puis état
        # incohérent restauré depuis un ancien project.json) -- .get()
        # ignore silencieusement ce cas plutôt que de planter l'exécution,
        # la variable garde alors juste sa valeur par défaut du code.
        for nom_variable in self.projet_batch.variables_a_personnaliser:
            if nom_variable in self.projet_batch.variables_personnalisees:
                variables[nom_variable] = self.projet_batch.variables_personnalisees[nom_variable]
        return variables

    # ------------------------------------------------------------------
    # Sauvegarde de debug en cas d'erreur (Patch 2 -- retour utilisateur
    # explicite : "avant qu'une tache en echec ne stoppe le programme,
    # capturer un instantane de la situation pour permettre un diagnostic
    # apres coup"). Structure disque : SousProjet.dossier_debug/logs.txt
    # (message d'erreur complet) + screenshot.png (capture du profil au
    # moment précis de l'échec) -- créé UNIQUEMENT en cas d'échec, jamais
    # en cas de succès (cf. docstring dossier_debug : "créé à la demande
    # seulement"). Une seule capture par sous-projet : ÉCRASÉE à chaque
    # nouvelle tentative en échec (logs.txt/screenshot.png toujours
    # réécrits, jamais suffixés/historisés) -- contrairement à
    # notebook_execution.json qui accumule TOUTES les tentatives, ce
    # snapshot debug ne sert qu'au diagnostic de la DERNIÈRE erreur
    # connue, une historisation par tentative n'apporterait rien de plus
    # que ce que notebook_execution.json fournit déjà.
    #
    # DOIT s'exécuter AVANT que sous_projet.ecrire_statut("echec", ...)
    # ne soit appelé ET avant que l'instance ne soit reprise pour le
    # sous-projet suivant (cf. _demarrer_sous_projet_sur_instance en fin
    # de _finir_sous_projet) -- sinon le screenshot capturerait un autre
    # sous-projet déjà en cours sur cette même instance. D'où le
    # découpage en deux temps ci-dessous : _finir_sous_projet lance cette
    # capture bloquante sur un thread daemon dédié (jamais le thread Qt
    # principal, même pattern que _appliquer_download_dir_bloquant/
    # _capturer_image_bug_cellule) PUIS termine réellement la
    # finalisation (écriture statut, historique, reprise de l'instance)
    # une fois cette capture revenue -- cf. _finir_sous_projet_signal.
    # ------------------------------------------------------------------
    _finir_sous_projet_signal = Signal(str, object, bool, str)  # instance_id, sous_projet, ok, message_erreur

    def _sauvegarder_debug_echec_sous_projet(self, instance_id: str, sous_projet: "SousProjet", message_erreur: Optional[str]):
        """Écrit logs.txt (toujours, dès qu'un message_erreur existe) et
        tente screenshot.png (capture_propre réseau, best-effort -- une
        capture échouée/en timeout ne doit jamais empêcher l'écriture de
        logs.txt ni bloquer la finalisation au-delà de TIMEOUT_CAPTURE_
        BUG_S). Tourne entièrement sur un thread daemon dédié, bloquant
        CE thread (pas le thread Qt) le temps de l'aller-retour réseau --
        cf. commentaire de classe ci-dessus pour la raison du blocage."""
        try:
            sous_projet.dossier_debug.mkdir(parents=True, exist_ok=True)
            (sous_projet.dossier_debug / "logs.txt").write_text(
                message_erreur or "(aucun message d'erreur fourni)", encoding="utf-8",
            )
        except Exception as exc:
            log.warning(f"[{instance_id}] écriture de debug/logs.txt échouée pour le sous-projet {sous_projet.numero} : {exc!r}")

        try:
            client = self._client_reseau
            if client is None:
                return

            event_link = threading.Event()
            resultat_link: dict = {"ok": False}
            event_command = threading.Event()
            resultat_command: dict = {"ok": False, "image_b64": None}

            def _sur_link_ok(iid: str):
                if iid == instance_id:
                    resultat_link["ok"] = True
                    event_link.set()

            def _sur_liaison_echouee(iid: str, msg: str):
                if iid == instance_id:
                    resultat_link["ok"] = False
                    event_link.set()

            requete_id = uuid.uuid4().hex[:12]

            def _sur_command_result(data: dict):
                if data.get("requete_id") != requete_id:
                    return
                resultat_command["ok"] = bool(data.get("ok"))
                resultat_command["image_b64"] = (data.get("result") or {}).get("image_b64")
                event_command.set()

            # Qt.DirectConnection -- même raisonnement que
            # _appliquer_download_dir_bloquant/_capturer_image_bug_cellule :
            # ce thread bloque sur des Event().wait(), ces callbacks
            # doivent tourner sur le thread réseau du client partagé.
            client.link_ok_recu.connect(_sur_link_ok, Qt.DirectConnection)
            client.liaison_echouee.connect(_sur_liaison_echouee, Qt.DirectConnection)
            client.command_result_recu.connect(_sur_command_result, Qt.DirectConnection)
            try:
                client.envoyer_commande({"type": "link", "pilote_id": client.id_client, "instance_id": instance_id})
                if not event_link.wait(timeout=self.TIMEOUT_CAPTURE_BUG_S / 2):
                    return
                if not resultat_link.get("ok"):
                    return

                client.envoyer_commande({
                    "type": "command", "instance_id": instance_id, "requete_id": requete_id,
                    "action": "capture_propre",
                })
                if not event_command.wait(timeout=self.TIMEOUT_CAPTURE_BUG_S / 2):
                    return
                if not resultat_command.get("ok"):
                    return
                image_b64 = resultat_command.get("image_b64")
                if not image_b64:
                    return

                try:
                    donnees_image = base64.b64decode(image_b64)
                    sous_projet.dossier_debug.mkdir(parents=True, exist_ok=True)
                    (sous_projet.dossier_debug / "screenshot.png").write_bytes(donnees_image)
                except Exception as exc:
                    log.warning(f"[{instance_id}] écriture de debug/screenshot.png échouée pour le sous-projet {sous_projet.numero} : {exc!r}")
            finally:
                client.link_ok_recu.disconnect(_sur_link_ok)
                client.liaison_echouee.disconnect(_sur_liaison_echouee)
                client.command_result_recu.disconnect(_sur_command_result)
                try:
                    client.envoyer_commande({"type": "unlink", "instance_id": instance_id})
                except Exception:
                    pass
        except Exception as exc:
            log.warning(f"[{instance_id}] capture de debug/screenshot.png échouée pour le sous-projet {sous_projet.numero} : {exc!r}")

    def _finir_sous_projet(self, instance_id: str, sous_projet: "SousProjet", ok: bool, message_erreur: Optional[str]):
        # PATCH (Patch 2) : en cas d'échec, la sauvegarde de debug doit
        # être capturée AVANT ecrire_statut("echec", ...) et avant que
        # cette instance ne soit reprise pour un autre sous-projet (cf.
        # commentaire de classe sur _sauvegarder_debug_echec_sous_projet)
        # -- délègue donc sur un thread daemon bloquant, puis revient sur
        # le thread Qt principal via _finir_sous_projet_signal pour
        # exécuter la VRAIE finalisation (_finir_sous_projet_apres_debug
        # ci-dessous). Chemin de succès inchangé : aucun détour, aucun
        # thread supplémentaire.
        if not ok:
            def _travail():
                self._sauvegarder_debug_echec_sous_projet(instance_id, sous_projet, message_erreur)
                self._finir_sous_projet_signal.emit(instance_id, sous_projet, ok, message_erreur or "")
            threading.Thread(target=_travail, daemon=True).start()
            return
        self._finir_sous_projet_apres_debug(instance_id, sous_projet, ok, message_erreur)

    def _finir_sous_projet_apres_debug(self, instance_id: str, sous_projet: "SousProjet", ok: bool, message_erreur: Optional[str]):
        self._en_cours.pop(instance_id, None)
        self._dernier_sous_projet_par_instance[instance_id] = sous_projet
        statut = "succes" if ok else "echec"
        sous_projet.ecrire_statut(statut, message_erreur)
        self.sous_projet_maj.emit(sous_projet.numero, statut)
        log.info(f"ProjetBatch '{self.projet_batch.nom}', sous-projet {sous_projet.numero} : {statut}" + (f" -- {message_erreur}" if message_erreur else ""))

        # Cf. Brique D du plan de patch -- construit la tentative complète
        # (structure Brique B) à partir de ce qui a été accumulé pendant
        # l'exécution, PUIS écrit l'historique et nettoie les registres.
        # Fait AVANT _demarrer_sous_projet_sur_instance juste en dessous :
        # si cette instance reprend immédiatement un autre sous-projet,
        # _sur_instance_prete réinitialisera _moteurs_task_en_cours[instance_id]
        # et _sorties_cellules_en_cours[instance_id] pour la nouvelle
        # tentative -- il faut donc avoir fini de lire/écrire celles de la
        # tentative qui vient de se terminer avant ça.
        moteur = self._moteurs_task_en_cours.pop(instance_id, None)
        sorties_par_cellule_id = {
            entree["cellule_id"]: entree
            for entree in self._sorties_cellules_en_cours.pop(instance_id, [])
        }
        # Images de bug déjà reçues pour cette tentative (cf. _sur_image_
        # bug_recue) -- une capture_propre encore en vol au moment précis
        # de cet appel (rare mais possible : aller-retour réseau) n'est
        # PAS attendue ici, pour ne jamais retarder l'écriture de
        # l'historique/la reprise de l'instance sur le sous-projet
        # suivant. Une capture arrivant après coup pour une cellule de
        # CETTE tentative met alors à jour l'historique déjà écrit, cf.
        # tout en bas de cette méthode.
        images_bug_par_cellule_id = self._images_bug_en_cours.pop(instance_id, {})
        if moteur is not None:
            variables_injectees = {
                nom: chemin for nom, chemin in moteur._variables_supplementaires.items()
            }
            cellules_tentative = []
            for cellule in moteur.sequence_cellules:
                entree = sorties_par_cellule_id.get(cellule.id)
                est_cellule_variables = (
                    moteur.task.cellule_variables is not None
                    and cellule.id == moteur.task.cellule_variables.id
                )
                if entree is not None:
                    cellules_tentative.append({
                        "cellule_id": cellule.id,
                        "titre": cellule.titre,
                        "code": cellule.code,
                        "est_cellule_variables": est_cellule_variables,
                        "atteinte": True,
                        "sortie": _tronquer_pour_historique(entree["sortie"]),
                        "erreur": _tronquer_pour_historique(entree["erreur"]),
                        "image_bug": images_bug_par_cellule_id.get(cellule.id),
                    })
                else:
                    # Jamais atteinte -- la séquence s'est arrêtée avant
                    # (une exécution headless continue même après une
                    # erreur de cellule, cf. MoteurExecutionTaskHeadless,
                    # donc ce cas ne survient normalement qu'en cas
                    # d'arrêt externe du batch en cours de route, cf.
                    # arreter()).
                    cellules_tentative.append({
                        "cellule_id": cellule.id,
                        "titre": cellule.titre,
                        "code": cellule.code,
                        "est_cellule_variables": est_cellule_variables,
                        "atteinte": False,
                        "sortie": None,
                        "erreur": None,
                        "image_bug": None,
                    })
            sous_projet.ajouter_tentative_execution({
                "horodatage": _horloge_iso(),
                "instance_id": instance_id,
                "statut_final": statut,
                "variables_injectees": variables_injectees,
                "cellules": cellules_tentative,
            })

        # Mode pool implicite (cf. docstring de classe) : cette instance se
        # libère immédiatement -- reprend le prochain sous-projet de la
        # file tout de suite si elle est toujours active (pas déconnectée
        # entre-temps, cf. _sur_liste_instances_recue), sans jamais être
        # fermée/jetée (contrairement à l'ancienne version qui lançait un
        # subprocess dédié par sous-projet).
        self._demarrer_sous_projet_sur_instance(instance_id)

    def _verifier_fin_globale(self):
        if not self._file_sous_projets and not self._en_cours:
            self._terminer_normalement()
        elif not self._instances_actives and self._file_sous_projets:
            # Plus AUCUNE instance active mais des sous-projets restent
            # dans la file (toutes les instances sélectionnées se sont
            # déconnectées en cours de route, cf. _sur_liste_instances_
            # recue) -- termine le batch plutôt que de rester bloqué
            # silencieusement pour toujours en attendant une instance qui
            # ne reviendra jamais reprendre du travail (cf. docstring de
            # classe). Les sous-projets restants gardent leur statut
            # "non_traite"/"echec" antérieur, naturellement repris au
            # prochain lancement (comme pour arreter(), même traitement).
            log.warning(f"ProjetBatch '{self.projet_batch.nom}' : plus aucune instance active, {len(self._file_sous_projets)} sous-projet(s) restent non traités -- batch terminé.")
            self._file_sous_projets = []
            self._terminer_normalement()

    # ------------------------------------------------------------------
    # Fin / arrêt
    # ------------------------------------------------------------------
    def _terminer_normalement(self):
        self._fermer_client_reseau_orchestrateur()
        callback = self._callback_termine
        self._callback_termine = None
        self.batch_termine.emit()
        if callback is not None:
            callback()

    def _terminer_avec_erreur(self, message: str):
        log.error(f"MoteurExecutionBatch : {message}")
        self._terminer_normalement()

    def _fermer_client_reseau_orchestrateur(self):
        """Même bugfix que MoteurExecutionTaskHeadless._terminer (cf. son
        commentaire détaillé, "RuntimeError: Signal source has been
        deleted") : arrêt du client réseau dans un thread daemon dédié,
        avec référence forte gardée jusqu'à la fin réelle -- réutilise
        directement le même registre de classe plutôt que d'en dupliquer
        un second identique."""
        if self._client_reseau is None:
            return
        client_a_fermer = self._client_reseau
        self._client_reseau = None
        MoteurExecutionTaskHeadless._CLIENTS_RESEAU_EN_ARRET.add(client_a_fermer)

        def _finir_arret():
            client_a_fermer.arreter()
            MoteurExecutionTaskHeadless._CLIENTS_RESEAU_EN_ARRET.discard(client_a_fermer)
        threading.Thread(target=_finir_arret, daemon=True).start()

    def arreter(self):
        """Arrête le batch en cours de route (bouton "arrêter" de
        ProjetBatchScreen). Les sous-projets déjà EN COURS sont chacun
        interrompus (MoteurExecutionTaskHeadless.arreter() n'est PAS
        appelé directement ici -- ce moteur ne garde pas de référence vers
        ses MoteurExecutionTaskHeadless internes, volontairement, cf.
        _sur_instance_prete où il est local à la fonction : la perte de la
        liaison réseau suffit, la cellule en cours d'exécution échouera
        d'elle-même, exactement comme n'importe quelle perte de connexion
        pendant une commande, cf. MoteurExecutionCellule._appeler) ; leur
        statut.json ne sera PAS écrit pour ce cycle (ni "succes" ni
        "echec" -- ils resteront tels quels, naturellement repris/
        resélectionnables au prochain lancement). Les instances elles-
        mêmes restent CONNECTÉES et disponibles après arreter() -- ce
        moteur ne les ferme jamais, contrairement à l'ancienne version
        (cf. docstring de classe : instances réutilisées, pas jetables)."""
        self._arret_demande = True
        self._en_cours.clear()
        self._file_sous_projets = []
        self._instances_actives = []
        # Cf. Brique D du plan de patch -- aucune tentative n'est écrite
        # pour les sous-projets interrompus ici (cohérent avec statut.json
        # non plus écrit non plus pour eux, cf. docstring ci-dessus) :
        # juste nettoyage des registres pour ne rien laisser d'orphelin
        # (ce moteur est de toute façon jeté juste après un arreter(),
        # mais les MoteurExecutionTaskHeadless encore référencés ici
        # continueraient sinon à recevoir des signaux cellule_terminee
        # tardifs d'une cellule déjà en vol au moment de l'arrêt).
        self._moteurs_task_en_cours.clear()
        self._sorties_cellules_en_cours.clear()
        self._terminer_normalement()


# ---------------------------------------------------------------------------
# PATCH "Projet Batch" -- briques 4+6 : UI (écran de config d'un ProjetBatch,
# avec panneau de mapping variable <-> fichier intégré, et grille/écran
# Dashboard final). Aucune brique moteur ici -- tout ce qui suit ne fait que
# PILOTER ProjetBatch/SousProjet/MoteurExecutionBatch (briques 1, 2, 3, 5,
# toutes déjà faites et testées ci-dessus), jamais dupliquer leur logique.
# ---------------------------------------------------------------------------


def extraire_variables_dynamiques_task(task: "Task") -> list:
    """Détecte les variables dynamiques d'un Task en parsant UNIQUEMENT
    task.cellule_variables.code (cf. PATCH_projet_batch.md, section 3 :
    "les variables dynamiques du Task choisi sont détectées automatiquement
    en parsant cellule_variables.code" -- périmètre volontairement plus
    restreint que TaskConfigScreen._rafraichir_variables_globales_editeur,
    qui scanne TOUT le notebook pour l'auto-complétion ; ici on ne veut que
    les variables que l'utilisateur a explicitement déclarées comme
    "dynamiques" pour CE Task, pas toute variable locale d'une cellule de
    logique interne).

    Réutilise TELLE QUELLE la regex déjà existante
    TaskScriptEditor._REGEX_DECLARATION_VARIABLE (attribut de CLASSE,
    accessible sans instancier de widget -- cf. décision du patch : "ne PAS
    réinventer un second parseur") et la même logique d'extraction des 4
    groupes (affectation, for...in, ...as..., paramètre de def) que
    _rafraichir_variables_globales_editeur, réduite au seul texte de
    cellule_variables.code.

    Retourne une liste de noms de variables, triée alphabétiquement et
    dédoublonnée (l'ordre d'apparition dans le code n'a pas de sens
    particulier pour l'utilisateur qui les associe ensuite à des fichiers,
    cf. écran de mapping -- un ordre stable et lisible est préférable)."""
    if task is None or task.cellule_variables is None:
        return []
    # AJOUT (SPEC_result_output_handler.md) : le bloc `def RESULT_OUTPUT_
    # HANDLER(valeur): ...` est retiré du texte scanné -- son paramètre et
    # ses variables locales ne sont PAS des variables dynamiques du Task.
    texte = retirer_result_output_handler_du_code(task.cellule_variables.code or "")
    regex = TaskScriptEditor._REGEX_DECLARATION_VARIABLE
    variables: set = set()
    # 5 groupes depuis le bugfix auto-complétion des noms de fonction (cf.
    # TaskScriptEditor._REGEX_DECLARATION_VARIABLE) -- groupe_nom_def
    # (groupe 4 de la regex) volontairement IGNORÉ ici : le nom d'une
    # fonction déclarée dans cellule_variables.code n'est pas une
    # "variable dynamique" mappable à un fichier (périmètre de cette
    # fonction, cf. docstring ci-dessus), contrairement aux 4 autres
    # groupes déjà utilisés avant ce patch -- dont groupe_params_def
    # (groupe 5, les paramètres de la fonction), qui reste extrait.
    #
    # CORRECTIF : la première version de ce patch nommait ces deux
    # dernières variables dans le mauvais ordre (groupe_def récupérait en
    # réalité le NOM de la fonction, groupe_nom_def récupérait les
    # PARAMÈTRES) -- si bien que le nom de la fonction était parsé comme
    # une liste de paramètres (donnant une "variable" bugguée = le nom de
    # la fonction) et les vrais paramètres étaient silencieusement perdus.
    # Noms alignés ici sur l'ordre réel des groupes de la regex, comme
    # dans _rescanner_variables_connues et
    # _rafraichir_variables_globales_editeur.
    for groupe_egal, groupe_for, groupe_as, groupe_nom_def, groupe_params_def in regex.findall(texte):
        if groupe_egal:
            for segment in groupe_egal.split("=")[:-1]:
                variables.update(n.strip() for n in segment.split(",") if n.strip())
        if groupe_for:
            variables.update(n.strip() for n in groupe_for.split(","))
        if groupe_as:
            variables.add(groupe_as.strip())
        if groupe_params_def:
            for param in groupe_params_def.split(","):
                m_param = TaskScriptEditor._REGEX_NOM_PARAMETRE.match(param.strip())
                if m_param:
                    variables.add(m_param.group(1))
    variables.discard("_")
    return sorted(variables)


def detecter_type_variable_dynamique(task: "Task", nom_variable: str) -> str:
    """PATCH (retour utilisateur -- "le probleme est que les type int ne
    doivent pas faire partir du matching de fichier, puisque sa seras des
    valeurs que lon vas entrer") : détermine si `nom_variable` doit être
    proposée comme un CHEMIN (mapping vers un fichier/dossier de data/,
    comportement déjà existant) ou comme une VALEUR (nombre/booléen/texte
    court saisi directement dans l'écran de mapping, ex: RETRY=3,
    TIMEOUT=20, LATENCE_AVANT=0.2).

    Cherche dans task.cellule_variables.code la toute première affectation
    directe "nom_variable = <expression>" (avant tout commentaire) et
    tente de l'évaluer avec ast.literal_eval : si l'expression est un
    littéral simple (int/float/bool/str/None), c'est une "valeur" ;
    n'importe quoi d'autre (appel de fonction, Path.home()/..., f-string,
    expression composée...) reste un "path" -- comportement PAR DÉFAUT
    volontairement permissif : une variable qu'on ne sait pas classer
    reste traitée comme avant ce patch (mapping fichier), jamais bloquée.

    Ne gère PAS les variables issues d'un for/as/paramètre de def (seules
    les affectations directes ont une "valeur par défaut" qui a un sens à
    afficher/personnaliser) -- ces cas retournent aussi "path" par
    défaut, cohérent avec le comportement historique."""
    if task is None or task.cellule_variables is None:
        return "path"
    texte = task.cellule_variables.code or ""
    motif = re.compile(
        rf"^\s*{re.escape(nom_variable)}\s*=\s*([^#\n]+)", re.MULTILINE,
    )
    m = motif.search(texte)
    if not m:
        return "path"
    expression = m.group(1).strip()
    try:
        ast.literal_eval(expression)
    except (ValueError, SyntaxError):
        return "path"
    return "valeur"


def valeur_par_defaut_variable_dynamique(task: "Task", nom_variable: str):
    """Complément de detecter_type_variable_dynamique -- ne l'appeler que
    si son retour est "valeur" (sinon None). Renvoie la valeur Python déjà
    évaluée (ex: 3, 20, 0.2), utile pour préremplir le champ de saisie
    avec la valeur actuellement codée en dur, plutôt qu'un champ vide."""
    if task is None or task.cellule_variables is None:
        return None
    texte = task.cellule_variables.code or ""
    motif = re.compile(
        rf"^\s*{re.escape(nom_variable)}\s*=\s*([^#\n]+)", re.MULTILINE,
    )
    m = motif.search(texte)
    if not m:
        return None
    try:
        return ast.literal_eval(m.group(1).strip())
    except (ValueError, SyntaxError):
        return None


class ProjetBatchCarte(QFrame):
    """Mini-card d'un ProjetBatch dans la grille du Dashboard (même pattern
    que TaskCarte/ServiceAPICarte). Cliquer dessus OUVRE l'écran d'édition/
    suivi de ce ProjetBatch (section unique réunissant config ET statuts,
    cf. décision utilisateur : "un seul écran intégré, pas de dialogue
    modal séparé").

    PATCH E (E.4 -- "Interface Projets à envoyer à sAutoniax : panneau
    gauche montre la liste des batchs [...] plusieurs projets déjà
    configurés"). MODE SÉLECTION MULTIPLE, même pattern exact que
    ComposantMiniTuile.set_mode_selection (cf. sa docstring) : hors mode
    sélection, un clic OUVRE la carte comme aujourd'hui (comportement
    par défaut, inchangé) ; en mode sélection (activé depuis l'en-tête
    de la grille, cf. ProjetBatchScreen._basculer_mode_selection_batch),
    un clic COCHE/DÉCOCHE la carte à la place (même signal `clique`
    réutilisé pour les deux usages selon le mode -- l'appelant sait
    déjà, via set_mode_selection, comment interpréter chaque émission)."""

    clique = Signal(str)  # id du ProjetBatch

    def __init__(self, projet_batch: "ProjetBatch", project: "Project", parent=None):
        super().__init__(parent)
        self.projet_batch_id = projet_batch.id
        self.setObjectName("ServiceAPICarte")
        self.setProperty("selectionnee", "false")
        self.setFixedSize(200, 100)
        self.setCursor(Qt.PointingHandCursor)
        self._mode_selection = False

        layout = QVBoxLayout(self)
        layout.setContentsMargins(14, 12, 14, 12)
        layout.setSpacing(6)

        header_row = QHBoxLayout()
        icon_label = QLabel(self)
        icon_label.setPixmap(qta.icon("mdi6.folder-multiple-outline", color=Mocha.lavender).pixmap(18, 18))
        header_row.addWidget(icon_label)
        header_row.addStretch(1)
        layout.addLayout(header_row)

        self.nom_label = QLabel(projet_batch.nom, self)
        self.nom_label.setObjectName("ServiceAPICarteNom")
        self.nom_label.setWordWrap(True)
        layout.addWidget(self.nom_label)

        layout.addStretch(1)

        self.info_label = QLabel(self)
        self.info_label.setObjectName("ServiceAPICarteInfo")
        layout.addWidget(self.info_label)
        self._rafraichir_info(projet_batch, project)

        # Coche visuelle de sélection -- même pattern que ComposantMiniTuile.coche_icon,
        # cachée hors mode sélection, placée en coin haut-droit par-dessus l'icône dossier.
        self.coche_icon = QLabel(self)
        self.coche_icon.setPixmap(qta.icon("mdi6.check-circle", color=Mocha.green).pixmap(18, 18))
        self.coche_icon.setFixedSize(18, 18)
        self.coche_icon.setVisible(False)
        self.coche_icon.move(self.width() - 14 - 18, 12)
        self.coche_icon.raise_()

    def _rafraichir_info(self, projet_batch: "ProjetBatch", project: "Project"):
        task = project.find_task(projet_batch.task_id)
        nom_task = task.nom if task is not None else "(Task non défini)"
        nb_instances = len(projet_batch.instances_selectionnees)
        suffixe_instances = f"{nb_instances} instance(s)" if nb_instances else "aucune instance sélectionnée"
        self.info_label.setText(f"{nom_task} · {suffixe_instances}")

    def rafraichir(self, projet_batch: "ProjetBatch", project: "Project"):
        self.nom_label.setText(projet_batch.nom)
        self._rafraichir_info(projet_batch, project)

    def set_mode_selection(self, actif: bool):
        """PATCH E -- cf. docstring de classe. Décoche automatiquement en
        sortant du mode sélection (même choix que ComposantMiniTuile :
        pas d'état "sélectionné" qui traînerait invisible une fois
        revenu au clic d'ouverture normal)."""
        self._mode_selection = actif
        if not actif:
            self.set_selectionnee(False)

    def set_selectionnee(self, selectionnee: bool):
        self.setProperty("selectionnee", "true" if selectionnee else "false")
        self.style().unpolish(self)
        self.style().polish(self)
        self.coche_icon.setVisible(selectionnee)

    def mousePressEvent(self, event):
        if event.button() == Qt.LeftButton:
            self.clique.emit(self.projet_batch_id)
        super().mousePressEvent(event)


# Libellés d'affichage du statut d'un sous-projet (cf. SousProjet.statut) --
# "en_cours" n'existe pas comme valeur PERSISTÉE sur disque (statut.json ne
# connaît que non_traite/succes/echec, cf. brique 1) mais EST émis par
# MoteurExecutionBatch.sous_projet_maj pendant l'exécution (cf.
# _demarrer_sous_projet_suivant) -- géré ici comme un 4e état purement
# transitoire/UI, jamais écrit sur disque.
_LIBELLES_STATUT_SOUS_PROJET = {
    "non_traite": "Non traité",
    "en_cours": "En cours",
    "succes": "Succès",
    "echec": "Échec",
}
_ICONES_STATUT_SOUS_PROJET = {
    "non_traite": ("mdi6.circle-outline", Mocha.subtext0),
    "en_cours": ("mdi6.loading", Mocha.blue),
    "succes": ("mdi6.check-circle", Mocha.green),
    "echec": ("mdi6.close-circle", Mocha.red),
}


class SousProjetCarte(QFrame):
    """Mini-card d'un sous-projet dans la grille de statuts (vue "suivi"
    de l'écran d'édition d'un ProjetBatch, cf. section 8 du patch : "grille/
    liste des sous-projets avec leur statut"). Sélectionnable (case à
    cocher, décision explicite utilisateur : chaque sous-projet doit
    pouvoir être inclus/exclu individuellement du prochain lancement,
    peu importe son statut -- cf. SousProjet.selectionne) -- reste NON
    cliquable pour le reste de la card, contrairement à TaskCarte/
    ProjetBatchCarte, seule la case répond aux clics.

    Émet selection_changee(numero, coche) à chaque bascule de la case --
    ProjetBatchScreen y écoute pour tenir sa propre vue d'ensemble
    (_sous_projets_coches) à jour, ex: pour les boutons raccourcis."""

    selection_changee = Signal(int, bool)

    @staticmethod
    def creer_lecture_seule(numero: int, statut: str, parent=None) -> "SousProjetCarte":
        """PATCH (Patch 4.4.b -- vue détail "Projets Distribués", spec :
        "réutilisation de la grille SousProjetCarte déjà existante en
        local, en lecture seule"). Construit une carte à partir d'un
        SousProjet minimal transitoire (chemin factice -- cette instance
        ne sert qu'à l'affichage, jamais lue/écrite sur disque, cf.
        docstring de SousProjet : "AUCUNE opération disque à la
        construction"), puis masque la case à cocher : un projet DISTANT
        n'a pas de sélection locale pour le prochain lancement, cocher/
        décocher n'a aucun sens ici."""
        carte = SousProjetCarte(SousProjet(chemin=Path("."), numero=numero, statut=statut, selectionne=False), parent)
        carte.case_selection.setVisible(False)
        return carte

    def __init__(self, sous_projet: "SousProjet", parent=None):
        super().__init__(parent)
        self.numero = sous_projet.numero
        self.statut_actuel = sous_projet.statut  # cf. rafraichir(), lu par ProjetBatchScreen._appliquer_selection_sous_projets
        self.setObjectName("ServiceAPICarte")
        self.setFixedSize(160, 90)

        layout = QVBoxLayout(self)
        layout.setContentsMargins(12, 10, 12, 10)
        layout.setSpacing(6)

        header_row = QHBoxLayout()
        self.case_selection = QCheckBox(self)
        self.case_selection.setChecked(sous_projet.selectionne)
        self.case_selection.toggled.connect(lambda coche: self.selection_changee.emit(self.numero, coche))
        header_row.addWidget(self.case_selection)
        self.numero_label = QLabel(f"Dossier {sous_projet.numero}", self)
        self.numero_label.setObjectName("ServiceAPICarteNom")
        header_row.addWidget(self.numero_label)
        header_row.addStretch(1)
        self.icone_label = QLabel(self)
        header_row.addWidget(self.icone_label)
        layout.addLayout(header_row)

        layout.addStretch(1)

        self.statut_label = QLabel(self)
        self.statut_label.setObjectName("ServiceAPICarteInfo")
        self.statut_label.setWordWrap(True)
        layout.addWidget(self.statut_label)

        self.rafraichir(sous_projet.statut, sous_projet.message_erreur)

    def est_coche(self) -> bool:
        return self.case_selection.isChecked()

    def set_coche(self, coche: bool):
        # blockSignals : évite de redéclencher selection_changee lors d'une
        # bascule PROGRAMMATIQUE (ex: boutons raccourcis "tout cocher") --
        # ProjetBatchScreen met déjà à jour son propre état dans ce cas,
        # avant d'appeler set_coche sur chaque carte ; réémettre le signal
        # ici serait une boucle inutile (pas infinie, mais redondante).
        self.case_selection.blockSignals(True)
        self.case_selection.setChecked(coche)
        self.case_selection.blockSignals(False)

    def rafraichir(self, statut: str, message_erreur: Optional[str] = None):
        self.statut_actuel = statut
        nom_icone, couleur = _ICONES_STATUT_SOUS_PROJET.get(statut, _ICONES_STATUT_SOUS_PROJET["non_traite"])
        self.icone_label.setPixmap(qta.icon(nom_icone, color=couleur).pixmap(16, 16))
        libelle = _LIBELLES_STATUT_SOUS_PROJET.get(statut, statut)
        if statut == "echec" and message_erreur:
            # Message d'erreur tronqué -- l'espace d'une petite card ne
            # permet pas d'afficher une trace complète ; suffisant pour
            # repérer le problème au survol de la grille, le détail complet
            # reste de toute façon dans statut.json sur disque si besoin.
            court = message_erreur if len(message_erreur) <= 60 else message_erreur[:57] + "..."
            self.statut_label.setText(f"{libelle}\n{court}")
            self.statut_label.setToolTip(message_erreur)
        else:
            self.statut_label.setText(libelle)
            self.statut_label.setToolTip("")


class LigneVariableValeur(QWidget):
    """Une ligne de la colonne "Valeurs (int/float/bool)" du bloc mapping
    (cf. ProjetBatchScreen._build_bloc_mapping) -- PATCH (retour
    utilisateur : "les variable int/float/bool ne doivent plus avoir de
    checkbox, ça doit directement avoir leur entrybox avec la valeur par
    défaut du script avant, que l'on peut maintenant éditer, et laisse un
    bouton de réinitialise (un bouton de flèche circulaire) pour remettre
    à la valeur par défaut"). Remplace le pattern coché+QInputDialog par
    un QLineEdit toujours actif, déjà rempli avec la valeur courante
    (personnalisée si déjà définie côté ProjetBatch, sinon la valeur par
    défaut codée dans le script) -- éditable directement, sans dialogue
    intermédiaire. Le bouton flèche circulaire réinitialise juste le
    CHAMP à la valeur par défaut du script (celle passée à __init__,
    jamais recalculée depuis un état déjà modifié) ; ne sauvegarde rien
    par lui-même -- comme une frappe clavier normale, c'est valeur_
    modifiee (connecté à editingFinished côté ProjetBatchScreen) qui
    valide et persiste, pour rester cohérent avec un seul point d'écriture."""

    valeur_modifiee = Signal(str, str)  # nom_variable, texte_saisi (à convertir par l'appelant)

    def __init__(self, nom_variable: str, valeur_actuelle, valeur_par_defaut, parent=None):
        super().__init__(parent)
        self.nom_variable = nom_variable
        self._texte_valeur_defaut = repr(valeur_par_defaut)

        layout = QHBoxLayout(self)
        layout.setContentsMargins(0, 0, 0, 0)
        layout.setSpacing(6)

        label = QLabel(nom_variable, self)
        label.setObjectName("ReglagesLabel")
        label.setToolTip(f"Valeur par défaut du script : {self._texte_valeur_defaut}")
        layout.addWidget(label, 1)

        self.champ_valeur = QLineEdit(self)
        self.champ_valeur.setObjectName("APIFeaturesNomEdit")
        self.champ_valeur.setText(repr(valeur_actuelle))
        self.champ_valeur.setFixedWidth(90)
        self.champ_valeur.editingFinished.connect(
            lambda: self.valeur_modifiee.emit(self.nom_variable, self.champ_valeur.text())
        )
        layout.addWidget(self.champ_valeur)

        self.bouton_reinitialiser = QToolButton(self)
        self.bouton_reinitialiser.setObjectName("RetourButton")
        self.bouton_reinitialiser.setIcon(qta.icon("mdi6.restore", color=Mocha.subtext0))
        self.bouton_reinitialiser.setToolTip(f"Réinitialiser à la valeur par défaut ({self._texte_valeur_defaut})")
        self.bouton_reinitialiser.setCursor(Qt.PointingHandCursor)
        self.bouton_reinitialiser.clicked.connect(self._reinitialiser)
        layout.addWidget(self.bouton_reinitialiser)

    def _reinitialiser(self):
        self.champ_valeur.setText(self._texte_valeur_defaut)
        self.valeur_modifiee.emit(self.nom_variable, self._texte_valeur_defaut)


class DialogueEnvoiSautoniax(DialogueAutoniaXBase):
    """PATCH (Patch 4.4.a -- "Envoi d'un projet vers un sAutoniax", spec :
    "1. Choix du sAutoniax cible ... 2. Sélection des profils à utiliser
    ..., cochés depuis la liste Profils Cloud"). Dialogue modal simple :
    un combo pour la cible (parmi les sAutoniax connectés, fournis par
    l'appelant -- cf. ProjetBatchScreen.definir_executants_disponibles)
    et une liste à cocher pour les profils cloud (fournis par
    ProjetBatchScreen.definir_profils_cloud_disponibles). Ne fait AUCUN
    appel réseau lui-même -- purement une collecte de choix utilisateur,
    restituée via id_executant_choisi()/profils_coches() une fois accepté."""

    def __init__(self, executants: dict, profils_cloud: list, parent=None):
        super().__init__("Envoyer vers un sAutoniax", parent, largeur_min=360)

        label_cible = QLabel("sAutoniax cible :", self.zone_contenu)
        label_cible.setObjectName("ReglagesLabel")
        self.ajouter_widget(label_cible)

        self.combo_cible = QComboBox(self.zone_contenu)
        self.combo_cible.setObjectName("ReglagesCombo")
        for id_executant, nom in sorted(executants.items(), key=lambda kv: kv[1]):
            self.combo_cible.addItem(nom, id_executant)
        self.ajouter_widget(self.combo_cible)

        label_profils = QLabel("Profils cloud à utiliser :", self.zone_contenu)
        label_profils.setObjectName("ReglagesLabel")
        self.ajouter_widget(label_profils)

        self.liste_profils = QListWidget(self.zone_contenu)
        self.liste_profils.setObjectName("ServiceAPIList")
        self.liste_profils.setFixedHeight(180)
        for nom_profil in profils_cloud:
            item = QListWidgetItem(nom_profil, self.liste_profils)
            item.setFlags(item.flags() | Qt.ItemIsUserCheckable)
            item.setCheckState(Qt.Unchecked)
        self.ajouter_widget(self.liste_profils)

        if not executants:
            label_cible.setText("Aucun sAutoniax connecté -- réessayez plus tard.")
            self.combo_cible.setEnabled(False)
        if not profils_cloud:
            label_profils.setText("Aucun profil disponible dans Profils Cloud.")

        ligne_boutons = QHBoxLayout()
        ligne_boutons.addStretch(1)
        bouton_annuler = _creer_bouton_dialogue("Annuler", primaire=False, parent=self.zone_contenu)
        bouton_ok = _creer_bouton_dialogue("OK", primaire=True, parent=self.zone_contenu)
        bouton_annuler.clicked.connect(self.reject)
        bouton_ok.clicked.connect(self.accept)
        ligne_boutons.addWidget(bouton_annuler)
        ligne_boutons.addWidget(bouton_ok)
        self.ajouter_layout(ligne_boutons)

    def id_executant_choisi(self) -> str:
        return self.combo_cible.currentData() or ""

    def profils_coches(self) -> list:
        return [
            self.liste_profils.item(i).text()
            for i in range(self.liste_profils.count())
            if self.liste_profils.item(i).checkState() == Qt.Checked
        ]


class PanneauRecentsEscamotable(QWidget):
    """CORRECTIF (retour utilisateur : le mini-gestionnaire "Récents"
    avait été codé comme un bloc FIXE, toujours visible, empilé dans le
    layout vertical de DialogueWorkspaceConfig -- demande explicite,
    reformulée après incompréhension : "je dit une pannau flotant qui
    apparait quand on met le cursuer alextremient gauche" [de la boîte
    Workspace Config elle-même]). Repris du MÊME patron exact que
    PanneauOutilsEscamotable (ApplicationsScreen, cf. sa docstring pour
    le diagnostic complet du mécanisme -- languette repliée contre le
    bord gauche, dépli/repli animés au survol, QTimer de surveillance
    souris en repère GLOBAL plutôt qu'enterEvent/leaveEvent, peu fiables
    pour un widget flottant masqué la plupart du temps) : SEULE
    différence, l'ancrage. PanneauOutilsEscamotable se plaque contre
    colonne_droite (ApplicationsScreen, fenêtre principale) ; celui-ci
    se plaque contre self.zone_contenu de la boîte DialogueWorkspaceConfig
    elle-même (QDialog -- un widget top-level convient tout aussi bien
    comme parent_ancrage, le mécanisme ne suppose rien de plus qu'un
    QWidget avec une geometry() stable et un eventFilter pour son
    redimensionnement).

    Contenu : titre "Récents" + une QListWidget (liste_recents),
    remplie/vidée par DialogueWorkspaceConfig._rafraichir_liste_recents
    exactement comme avant ce correctif -- seul le CONTENANT change,
    pas la logique de remplissage/clic (_sur_clic_ouvrir_recent reste
    inchangée, toujours connectée à liste_recents.itemClicked)."""

    _LARGEUR_DEPLIEE = 240
    _LARGEUR_REPLIEE = 28
    _DUREE_ANIMATION_MS = 220
    _INTERVALLE_SURVEILLANCE_SOURIS_MS = 60

    def __init__(self, parent_ancrage: QWidget, parent=None):
        super().__init__(parent)
        self._parent_ancrage = parent_ancrage
        self._largeur_courante = float(self._LARGEUR_REPLIEE)
        self._animation: Optional[QPropertyAnimation] = None
        self._deplie = False

        ombre = QGraphicsDropShadowEffect(self)
        ombre.setBlurRadius(24)
        ombre.setXOffset(2)
        ombre.setYOffset(0)
        ombre.setColor(QColor(0, 0, 0, 140))
        self.setGraphicsEffect(ombre)

        # Fond opaque forcé directement sur ce widget (cf. docstring
        # BUGFIX de PanneauOutilsEscamotable pour pourquoi
        # setAutoFillBackground seul ne suffit pas ici).
        self.setAttribute(Qt.WA_StyledBackground, True)
        self.setStyleSheet(
            f"PanneauRecentsEscamotable {{ background-color: {Mocha.base}; "
            f"border-right: 1px solid {Mocha.surface1}; }}"
        )

        layout = QVBoxLayout(self)
        layout.setContentsMargins(12, 16, 12, 16)
        layout.setSpacing(8)
        self.titre_label = QLabel("Récents", self)
        self.titre_label.setObjectName("ReglagesLabel")
        layout.addWidget(self.titre_label)
        self.liste_recents = QListWidget(self)
        self.liste_recents.setObjectName("ServiceAPIList")
        self.liste_recents.setCursor(Qt.CursorShape.PointingHandCursor)
        layout.addWidget(self.liste_recents, 1)

        parent_ancrage.installEventFilter(self)

        self._minuteur_survol = QTimer(self)
        self._minuteur_survol.setInterval(self._INTERVALLE_SURVEILLANCE_SOURIS_MS)
        self._minuteur_survol.timeout.connect(self._verifier_survol)
        self._minuteur_survol.start()

        self._repositionner()
        self.raise_()

    def _repositionner(self):
        hauteur = self._parent_ancrage.height() or self._parent_ancrage.sizeHint().height()
        self.setGeometry(0, 0, round(self._largeur_courante), hauteur)
        self.raise_()

    def _definir_largeur_courante(self, largeur):
        self._largeur_courante = largeur
        self._repositionner()

    def _lire_largeur_courante(self):
        return self._largeur_courante

    largeurAnimee = Property(float, _lire_largeur_courante, _definir_largeur_courante)

    def _animer_vers(self, largeur_cible: float):
        if self._animation is not None:
            self._animation.stop()
        animation = QPropertyAnimation(self, b"largeurAnimee", self)
        animation.setDuration(self._DUREE_ANIMATION_MS)
        animation.setStartValue(self._largeur_courante)
        animation.setEndValue(largeur_cible)
        animation.setEasingCurve(QEasingCurve.OutCubic)
        self._animation = animation
        animation.start()

    def _verifier_survol(self):
        if not self._parent_ancrage.isVisible():
            return
        pos_globale = QCursor.pos()
        origine_ancrage = self._parent_ancrage.mapToGlobal(QPoint(0, 0))
        rect_zone_sensible = QRect(
            origine_ancrage.x(), origine_ancrage.y(),
            self._LARGEUR_REPLIEE, self._parent_ancrage.height(),
        )
        origine_self = self.mapToGlobal(QPoint(0, 0))
        rect_self_global = QRect(origine_self, self.size())
        dans_zone_sensible = rect_zone_sensible.contains(pos_globale)
        dans_panneau_deja_deplie = self._deplie and rect_self_global.contains(pos_globale)
        doit_etre_deplie = dans_zone_sensible or dans_panneau_deja_deplie
        if doit_etre_deplie != self._deplie:
            self._deplie = doit_etre_deplie
            self._animer_vers(self._LARGEUR_DEPLIEE if doit_etre_deplie else self._LARGEUR_REPLIEE)

    def eventFilter(self, obj, event):
        if obj is self._parent_ancrage and event.type() == QEvent.Resize:
            self._repositionner()
        return super().eventFilter(obj, event)


class DialogueWorkspaceConfig(DialogueAutoniaXBase):
    """SPEC_workspace_attribution.md, section 5 -- boîte complète ouverte
    au clic DROIT sur bouton_attribuer_workspace UNE FOIS un fichier
    WORKSPACE déjà configuré (cf. TaskConfigScreen._sur_demande_
    attribuer_workspace_dialogue). Hérite de DialogueAutoniaXBase comme
    TOUTE boîte de dialogue maison de l'app (exigence ferme, spec section
    5 -- même patron exact que DialogueEnvoiSautoniax ci-dessus) : aucun
    QMessageBox/QFileDialog natif ici, le QFileDialog du système reste
    réservé au choix du fichier lui-même (spec section 4, géré par
    TaskConfigScreen -- pas par cette boîte).

    RÉÉCRITURE (PATCH v2, SPEC_patch_tasks_json.md -- "on abandonne
    complètement la notion de dossier WORKSPACE contenant des fichiers de
    tâches : le WORKSPACE devient littéralement ce fichier JSON unique") :
    Task ne porte plus une LISTE de dossiers WORKSPACE chaînés
    (Task.workspaces, v1) mais un SEUL chemin de fichier
    (Task.workspace_fichier). L'ancien panneau flottant multi-workspace
    ancré à gauche (PanneauWorkspacesFlottant/LigneWorkspacePanneau,
    liste cochable, bouton "+", import de liste, ordre de chaînage) reste
    ENTIÈREMENT SUPPRIMÉ -- il n'y a plus qu'UN SEUL WORKSPACE actif par
    Task, pas de sélection multiple, pas de chaînage.

    RENOMMAGE (demande explicite utilisateur) : "Attribution WORKSPACE"
    -> "Workspace Config" (titre de boîte, tooltip du bouton, nom de
    cette classe elle-même) -- cosmétique, aucun changement de
    comportement associé.

    AJOUT (demande explicite utilisateur : "un mini gestionnaire qui
    affiche les workspaces récents que l'on clique pour ouvrir [...] il
    doit aussi y avoir le bouton de sélection d'un workspace") : cette
    boîte n'est plus limitée à agir sur LE fichier déjà configuré --
    elle permet maintenant aussi d'en changer, via deux ajouts dans son
    en-tête : un bouton "Choisir un fichier..." (ouvre le même sélecteur
    de fichier que TaskConfigScreen, cf. _sur_clic_choisir_fichier) et
    une mini-liste "Récents" (ReglagesApp.workspace_fichiers_recents,
    persistée globalement dans reglages.json -- PARTAGÉE par tous les
    Task/Project, correction utilisateur explicite : "ça doit persister
    en global, pas sur le fichier" -- liste MRU simple, PAS de case à
    cocher, PAS de sélection multiple, PAS de chaînage, cf. enregistrer_
    workspace_recent) où un clic sur une ligne
    bascule IMMÉDIATEMENT dessus (cf. _sur_clic_ouvrir_recent) : scan +
    attribution suivent aussitôt, exactement comme un tout premier choix
    de fichier. Cette boîte reste donc le point d'entrée unique pour
    tout ce qui touche à CE Task et son WORKSPACE : liste des tâches,
    stats, marquage manuel, mode de répartition, bouton "Attribuer", ET
    désormais le choix du fichier lui-même.

    Lecture/écriture directe du fichier WORKSPACE sur disque (scanner_
    taches_workspace/ecrire_statut_tache_workspace, cf. section 2/4 côté
    module) : cette boîte ne maintient PAS son propre état "brouillon"
    des statuts -- chaque marquage manuel (section 5.3) réécrit
    immédiatement le fichier et rafraîchit la liste/le résumé depuis un
    nouveau scan, cohérent avec le fait qu'aucun "Annuler" ne doit
    pouvoir défaire un marquage déjà écrit sur disque (spec section 5.3 :
    "réécriture disque immédiate").

    Le mode de répartition et le N du mode "fixe" restent lus/écrits
    directement sur `task` (task.workspace_mode_repartition/
    workspace_nombre_fixe) -- à chaque changement de contrôle, PAS
    seulement à la validation -- pour qu'un changement de mode survive
    même si l'utilisateur ferme la boîte sans cliquer "Attribuer" (cf.
    TaskConfigScreen._sur_demande_attribuer_workspace_dialogue, qui
    sauvegarde le projet après tout appel exec() de cette boîte, que
    l'attribution ait eu lieu ou non).

    Résultat de l'attribution exposé via self.derniere_attribution (dict
    cle_profil -> [tâches...], chaque tâche directement un dict de champs
    métier -- PATCH v4, cf. repartir_taches_workspace) et self.
    attribution_effectuee (bool), lus par l'appelant APRÈS exec() -- cf.
    docstring de TaskConfigScreen._sur_demande_attribuer_workspace_
    dialogue pour pourquoi (fermeture sans "Attribuer" == aucune
    attribution ne doit être propagée)."""

    COLONNE_NOM = 0
    COLONNE_STATUT = 1

    def __init__(self, task: "Task", panneau_clone: "PanneauExecutionClone", parent=None):
        super().__init__("Workspace Config", parent, largeur_min=560)
        self._task = task
        self._panneau_clone = panneau_clone
        self.derniere_attribution: dict = {}
        self.attribution_effectuee = False
        self._taches: list = []

        self.setMinimumHeight(480)

        conteneur = QWidget(self.zone_contenu)
        self.ajouter_widget(conteneur)
        conteneur_layout = QVBoxLayout(conteneur)
        # CORRECTIF (retour utilisateur : le panneau "Récents" escamotable
        # -- cf. PanneauRecentsEscamotable, enfant DIRECT de zone_contenu,
        # setGeometry(0, 0, ...) -- reste posé PAR-DESSUS le tout début du
        # contenu MÊME REPLIÉ (languette de 28px, cf. _LARGEUR_REPLIEE),
        # sans qu'aucune marge ne soit réservée côté contenu pour cette
        # languette.
        #
        # RÉVISION (bug confirmé après audit -- ancien correctif
        # insuffisant) : un premier jet ici posait une marge de 5px
        # ("pas une marge grande, juste quelques pixels, environ 5"),
        # mais PanneauRecentsEscamotable est EXPLICITEMENT "repris du
        # MÊME patron exact que PanneauOutilsEscamotable" (cf. sa
        # docstring) -- lui-même ancré à x=0 avec cette même largeur
        # repliée de 28px. Le patron d'origine (ApplicationsScreen,
        # colonne_droite ci-dessus) a justement été patché un jour pour
        # la RAISON INVERSE : un premier jet à marge partielle laissait
        # encore "le panneau même replié cach[er] légèrement l'interface"
        # (cf. son propre commentaire FIX), corrigé en réservant la
        # LARGEUR REPLIÉE COMPLÈTE (PanneauOutilsEscamotable.
        # _LARGEUR_REPLIEE, pas une valeur arbitraire) -- jamais une
        # fraction de celle-ci. Une marge de 5px sur une languette de
        # 28px laisse donc mécaniquement 23px de chevauchement résiduel,
        # AUCUNE vérification visuelle n'avait confirmé que 5px
        # suffisaient (cf. retour explicite : "tu screenshot la boite de
        # dialogue avant de conclure que c'est terminé"). Remplacé ici
        # par PanneauRecentsEscamotable._LARGEUR_REPLIEE en dur (28px),
        # le même patron exact que colonne_droite plus haut dans ce
        # fichier, pour la même raison : dégager COMPLÈTEMENT la zone
        # qu'occupe la languette au repos, jamais partiellement.
        conteneur_layout.setContentsMargins(PanneauRecentsEscamotable._LARGEUR_REPLIEE, 0, 0, 0)
        conteneur_layout.setSpacing(14)

        # --- En-tête : nom du fichier WORKSPACE configuré + bouton de
        # sélection (AJOUT, demande explicite utilisateur : "il doit
        # aussi y avoir le bouton de sélection d'un workspace") -- ligne
        # horizontale, label à gauche (extensible), bouton compact à
        # droite. Même sélecteur que TaskConfigScreen (BoiteDialogueAutoniaX.
        # ouvrir_fichier, filtré .json) -- cette boîte n'est donc plus
        # limitée à agir sur le fichier déjà configuré, cf. docstring de
        # classe.
        ligne_fichier = QHBoxLayout()
        nom_fichier = Path(task.workspace_fichier).name if task.workspace_fichier else ""
        self.label_workspace_actif = QLabel(nom_fichier or "Aucun fichier WORKSPACE configuré", conteneur)
        self.label_workspace_actif.setObjectName("DialogueSousTitre")
        self.label_workspace_actif.setStyleSheet(
            f"color:{Mocha.lavender}; font-size:13px; font-weight:700;"
        )
        self.label_workspace_actif.setToolTip(task.workspace_fichier)
        ligne_fichier.addWidget(self.label_workspace_actif, 1)
        self.bouton_choisir_fichier = _creer_bouton_dialogue(
            "Choisir un fichier...", parent=conteneur,
        )
        self.bouton_choisir_fichier.clicked.connect(self._sur_clic_choisir_fichier)
        ligne_fichier.addWidget(self.bouton_choisir_fichier)
        conteneur_layout.addLayout(ligne_fichier)

        # --- Mini-gestionnaire "Récents" (AJOUT, demande explicite
        # utilisateur : "un mini gestionnaire qui affiche les workspaces
        # récents que l'on clique pour ouvrir") -- PAS de case à cocher,
        # PAS de sélection multiple, PAS de chaînage (cf. docstring de
        # classe) : une simple liste MRU, un CLIC sur une ligne bascule
        # immédiatement dessus (cf. _sur_clic_ouvrir_recent).
        #
        # CORRECTIF (retour utilisateur, reformulé après un premier
        # essai raté en bloc fixe empilé dans le layout : "je dit une
        # pannau flotant qui apparait quand on met le cursuer
        # alextremient gauche" [de cette boîte]) -- PanneauRecentsEscamotable
        # (cf. sa classe juste au-dessus, MÊME patron exact que
        # PanneauOutilsEscamotable) : languette repliée (28px) contre le
        # bord gauche de self.zone_contenu, dépliée automatiquement au
        # survol, repliée quand le curseur sort. Enfant DIRECT de
        # zone_contenu (pas de self/la boîte entière) pour que raise_()
        # le place bien au-dessus du contenu normal de la boîte sans
        # dépendre de l'ordre d'empilement au niveau de la fenêtre.
        # liste_recents reste le même widget qu'avant ce correctif --
        # seul son CONTENANT change, _rafraichir_liste_recents/_sur_clic_
        # ouvrir_recent n'ont pas besoin d'être adaptées au-delà de la
        # référence self.liste_recents/self.label_recents ci-dessous.
        self.panneau_recents = PanneauRecentsEscamotable(self.zone_contenu, self.zone_contenu)
        self.label_recents = self.panneau_recents.titre_label
        self.liste_recents = self.panneau_recents.liste_recents
        self.liste_recents.itemClicked.connect(self._sur_clic_ouvrir_recent)
        self._rafraichir_liste_recents()

        self.label_stats = QLabel("", conteneur)
        self.label_stats.setObjectName("ReglagesLabel")
        self.label_stats.setTextFormat(Qt.TextFormat.RichText)
        conteneur_layout.addWidget(self.label_stats)

        # --- Boutons de sélection en masse (spec 5.2) -- même patron que
        # bouton_tout_selectionner/bouton_selectionner_echecs du panneau
        # clone, mais en QPushButton stylés dialogue (_creer_bouton_
        # dialogue) plutôt qu'en QToolButton icône : cette boîte n'a pas
        # la contrainte de largeur compacte du panneau latéral.
        # PATCH v3 (ajout du statut "abandonnee") : ligne_selection2
        # accueille désormais 3 boutons (terminées/en attente/abandonnées)
        # au lieu de 2 -- toujours sur sa propre ligne, sous la première
        # (tout sélectionner/désélectionner), pour ne pas surcharger une
        # unique rangée.
        ligne_selection = QHBoxLayout()
        ligne_selection2 = QHBoxLayout()
        self.bouton_tout_selectionner_tache = _creer_bouton_dialogue(
            "Tout sélectionner", parent=conteneur,
        )
        self.bouton_tout_deselectionner_tache = _creer_bouton_dialogue(
            "Tout désélectionner", parent=conteneur,
        )
        self.bouton_selectionner_terminees = _creer_bouton_dialogue(
            "Sélect. terminées", parent=conteneur,
        )
        self.bouton_selectionner_en_attente = _creer_bouton_dialogue(
            "Sélect. en attente", parent=conteneur,
        )
        self.bouton_selectionner_abandonnees = _creer_bouton_dialogue(
            "Sélect. abandonnées", parent=conteneur,
        )
        for bouton in (
            self.bouton_tout_selectionner_tache, self.bouton_tout_deselectionner_tache,
            self.bouton_selectionner_terminees, self.bouton_selectionner_en_attente,
            self.bouton_selectionner_abandonnees,
        ):
            largeur_texte = bouton.fontMetrics().horizontalAdvance(bouton.text())
            bouton.setMinimumWidth(largeur_texte + 32)
        ligne_selection.addWidget(self.bouton_tout_selectionner_tache)
        ligne_selection.addWidget(self.bouton_tout_deselectionner_tache)
        ligne_selection2.addWidget(self.bouton_selectionner_terminees)
        ligne_selection2.addWidget(self.bouton_selectionner_en_attente)
        ligne_selection2.addWidget(self.bouton_selectionner_abandonnees)
        conteneur_layout.addLayout(ligne_selection)
        conteneur_layout.addLayout(ligne_selection2)
        self.bouton_tout_selectionner_tache.clicked.connect(
            lambda: self._cocher_toutes(True)
        )
        self.bouton_tout_deselectionner_tache.clicked.connect(
            lambda: self._cocher_toutes(False)
        )
        self.bouton_selectionner_terminees.clicked.connect(
            lambda: self._cocher_selon(lambda t: t.statut == "termine")
        )
        self.bouton_selectionner_en_attente.clicked.connect(
            lambda: self._cocher_selon(lambda t: t.en_attente)
        )
        self.bouton_selectionner_abandonnees.clicked.connect(
            lambda: self._cocher_selon(lambda t: t.abandonnee)
        )

        # --- Liste des tâches (spec 5.2) --------------------------------
        self.arbre_taches = QTreeWidget(conteneur)
        self.arbre_taches.setObjectName("WorkspaceArbreTaches")  # CORRECTIF (cf. bloc QSS dédié) -- plus "ServiceAPIList" : sa règle ::item { color } écrasait le setForeground() mauve/jaune ci-dessous
        self.arbre_taches.setHeaderLabels(["Tâche", "Statut"])
        self.arbre_taches.setRootIsDecorated(False)
        self.arbre_taches.setFixedHeight(260)
        # PATCH -- sans setSectionResizeMode explicite, Qt réduisait la
        # colonne "Tâche" au premier layout (setColumnWidth seul ne
        # suffit pas : cf. patron déjà utilisé ailleurs dans le fichier,
        # p.ex. table_profils ligne ~53777 ou self.table ligne ~24426).
        # Colonne "Tâche" interactive à largeur fixée, colonne "Statut"
        # s'étire pour occuper le reste (stretchLastSection déjà actif
        # par défaut sur QTreeWidget, mais on le fixe explicitement).
        self.arbre_taches.header().setStretchLastSection(False)
        self.arbre_taches.header().setSectionResizeMode(self.COLONNE_NOM, QHeaderView.Interactive)
        self.arbre_taches.header().setSectionResizeMode(self.COLONNE_STATUT, QHeaderView.Stretch)
        self.arbre_taches.setColumnWidth(self.COLONNE_NOM, 260)
        conteneur_layout.addWidget(self.arbre_taches)

        # --- Marquage manuel (spec 5.3 ; PATCH v3 -- 3e bouton "abandonnée") ----
        ligne_marquage = QHBoxLayout()
        self.bouton_marquer_termine = _creer_bouton_dialogue(
            "Marquer \u00abterminé\u00bb", parent=conteneur,
        )
        self.bouton_marquer_en_attente = _creer_bouton_dialogue(
            "Marquer \u00aben attente\u00bb", parent=conteneur,
        )
        self.bouton_marquer_abandonnee = _creer_bouton_dialogue(
            "Marquer \u00ababandonnée\u00bb", parent=conteneur,
        )
        ligne_marquage.addWidget(self.bouton_marquer_termine)
        ligne_marquage.addWidget(self.bouton_marquer_en_attente)
        ligne_marquage.addWidget(self.bouton_marquer_abandonnee)
        conteneur_layout.addLayout(ligne_marquage)
        # PATCH v3 -- _marquer_selection prenait un bool (True/False,
        # seulement 2 statuts possibles) ; accepte désormais aussi
        # directement la chaîne de statut cible (cf. sa docstring),
        # nécessaire pour "abandonnee" qu'un bool ne peut pas représenter.
        self.bouton_marquer_termine.clicked.connect(lambda: self._marquer_selection("termine"))
        self.bouton_marquer_en_attente.clicked.connect(lambda: self._marquer_selection("en_attente"))
        self.bouton_marquer_abandonnee.clicked.connect(lambda: self._marquer_selection("abandonnee"))

        # --- Mode de répartition (spec 5.4) -------------------------------
        label_mode = QLabel("Mode de répartition :", conteneur)
        label_mode.setObjectName("ReglagesLabel")
        conteneur_layout.addWidget(label_mode)

        ligne_mode = QHBoxLayout()
        self.radio_mode_fixe = QRadioButton("Nombre fixe", conteneur)
        self.radio_mode_relatif = QRadioButton("Relatif", conteneur)
        self._groupe_mode = QButtonGroup(self)
        self._groupe_mode.addButton(self.radio_mode_fixe)
        self._groupe_mode.addButton(self.radio_mode_relatif)
        self.spin_nombre_fixe = QSpinBox(conteneur)
        self.spin_nombre_fixe.setMinimum(1)
        self.spin_nombre_fixe.setMaximum(999999)
        # Molette ignorée automatiquement (cf. QSpinBox.wheelEvent = 
        # _ignorer_molette, monkey-patché globalement tout en haut du
        # fichier) -- rien à faire ici.

        ligne_mode.addWidget(self.radio_mode_fixe)
        ligne_mode.addWidget(self.spin_nombre_fixe)
        ligne_mode.addWidget(self.radio_mode_relatif)
        ligne_mode.addStretch(1)
        conteneur_layout.addLayout(ligne_mode)

        # Dernier choix mémorisé sur le Task pré-sélectionné (spec 5.4 :
        # "dernier choix pré-sélectionné à l'ouverture").
        if task.workspace_mode_repartition == "relatif":
            self.radio_mode_relatif.setChecked(True)
        else:
            self.radio_mode_fixe.setChecked(True)
        self.spin_nombre_fixe.setValue(max(1, int(task.workspace_nombre_fixe)))
        self._rafraichir_visibilite_spin()

        self.radio_mode_fixe.toggled.connect(self._sur_changement_mode)
        self.radio_mode_relatif.toggled.connect(self._sur_changement_mode)
        self.spin_nombre_fixe.valueChanged.connect(self._sur_changement_nombre_fixe)

        # --- Champs exclus (AJOUT, demande explicite utilisateur : "lors de
        # l'attribution de task dans les notebook on puisse exclure
        # certains champs") -------------------------------------------------
        label_exclus = QLabel("Champs à exclure de LIST_TASKS :", conteneur)
        label_exclus.setObjectName("ReglagesLabel")
        conteneur_layout.addWidget(label_exclus)

        self.champ_champs_exclus = QLineEdit(conteneur)
        self.champ_champs_exclus.setPlaceholderText("ex : desc_a, chemin_image  (séparés par des virgules)")
        self.champ_champs_exclus.setToolTip(
            "Noms des champs retirés de chaque tâche avant son envoi au script "
            "(LIST_TASKS). Le fichier WORKSPACE, lui, n'est jamais modifié par "
            "cette exclusion. 'numero' et 'statut' ne peuvent pas être exclus."
        )
        # Dernier choix mémorisé sur le Task, comme le mode de répartition.
        self.champ_champs_exclus.setText(", ".join(task.workspace_champs_exclus))
        conteneur_layout.addWidget(self.champ_champs_exclus)

        self.label_champs_exclus_info = QLabel("", conteneur)
        self.label_champs_exclus_info.setObjectName("ReglagesLabel")
        self.label_champs_exclus_info.setWordWrap(True)
        conteneur_layout.addWidget(self.label_champs_exclus_info)
        self.champ_champs_exclus.textChanged.connect(self._sur_changement_champs_exclus)
        self._sur_changement_champs_exclus(self.champ_champs_exclus.text())

        conteneur_layout.addStretch(1)

        # --- Attribuer / Fermer (spec 5.4) --------------------------------
        ligne_boutons = QHBoxLayout()
        ligne_boutons.addStretch(1)
        bouton_fermer = _creer_bouton_dialogue("Fermer", primaire=False, parent=conteneur)
        bouton_attribuer = _creer_bouton_dialogue("Attribuer", primaire=True, parent=conteneur)
        bouton_fermer.clicked.connect(self.reject)
        bouton_attribuer.clicked.connect(self._sur_clic_attribuer)
        ligne_boutons.addWidget(bouton_fermer)
        ligne_boutons.addWidget(bouton_attribuer)
        conteneur_layout.addLayout(ligne_boutons)

        self._rafraichir_liste_taches()

    # ------------------------------------------------------------------
    # Récents (AJOUT, demande explicite utilisateur : "un mini
    # gestionnaire qui affiche les workspaces récents que l'on clique
    # pour ouvrir" + "bouton de sélection d'un workspace") -- liste MRU
    # globale sur ReglagesApp (reglages.json), PAS sur Task (cf. docstring
    # de classe et de enregistrer_workspace_recent). Cette boîte n'écrit
    # jamais directement dans ReglagesApp.workspace_fichiers_recents --
    # toujours via enregistrer_workspace_recent (module-niveau), pour ne
    # pas dupliquer la logique de déduplication/troncature.
    # ------------------------------------------------------------------

    def _reglages_app(self) -> Optional["ReglagesApp"]:
        """Accès à l'instance ReglagesApp partagée, via self._panneau_
        clone._reglages (cf. PanneauExecutionClone.definir_reglages,
        appelée une fois par TaskConfigScreen à la construction) --
        cette boîte ne recharge jamais ReglagesApp.load() elle-même,
        pour ne pas écraser une mutation en mémoire pas encore
        sauvegardée ailleurs (même esprit que definir_reglages : "ce
        panneau ne va jamais chercher l'objet ReglagesApp lui-même").
        Peut retourner None si le panneau clone n'a pas encore reçu ses
        réglages (ne devrait pas arriver en pratique -- definir_reglages
        est appelée juste après construction de PanneauExecutionClone --
        mais tous les appelants restent défensifs vis-à-vis de ce cas,
        cohérent avec le patron self.reglages is not None de
        TaskConfigScreen)."""
        return getattr(self._panneau_clone, "_reglages", None)

    def _rafraichir_liste_recents(self):
        """Repeuple self.liste_recents depuis ReglagesApp.workspace_
        fichiers_recents (le plus récent en premier, déjà dans cet ordre
        côté source -- cf. enregistrer_workspace_recent). Affiche le nom
        de fichier seul (cohérent avec self.label_workspace_actif un peu
        plus haut), le chemin complet en tooltip et en UserRole (repris
        tel quel par _sur_clic_ouvrir_recent).

        CORRECTIF (le panneau vit maintenant dans PanneauRecentsEscamotable,
        une languette flottante contre le bord gauche de la boîte, cf.
        cette classe) -- ne masque plus label_recents/liste_recents même
        si la liste est vide (l'ancien comportement "masquer si vide"
        n'a plus de sens ici : ce panneau doit rester une languette
        survolable en permanence, sinon plus rien à survoler pour le
        déplier -- une liste simplement vide à l'intérieur suffit à
        indiquer "aucun récent" une fois déplié)."""
        reglages = self._reglages_app()
        recents = list(reglages.workspace_fichiers_recents) if reglages is not None else []
        self.liste_recents.clear()
        for chemin in recents:
            item = QListWidgetItem(Path(chemin).name or chemin)
            item.setToolTip(chemin)
            item.setData(Qt.UserRole, chemin)
            self.liste_recents.addItem(item)

    def _sur_clic_choisir_fichier(self):
        """Handler du bouton "Choisir un fichier..." de l'en-tête (AJOUT,
        demande explicite utilisateur) -- même sélecteur que
        TaskConfigScreen._sur_demande_attribuer_workspace_silencieux/
        _dialogue (BoiteDialogueAutoniaX.ouvrir_fichier, filtré .json).
        Une fois un fichier choisi : bascule task.workspace_fichier
        dessus (PAS de project.save() ici -- cf. docstring de classe,
        même patron que le mode de répartition : c'est TaskConfigScreen
        qui sauvegarde le projet après tout exec() de cette boîte, que
        l'usager clique "Attribuer" ou ferme directement), enregistre le
        chemin dans les récents globaux et persiste IMMÉDIATEMENT
        reglages.save() (contrairement au projet, ReglagesApp n'est
        sauvegardée nulle part après exec() par l'appelant -- il faut
        donc la persister ici, sous peine de perdre l'entrée si l'usager
        ferme sans "Attribuer" ou si l'app plante ensuite). Rafraîchit
        l'en-tête, la liste des récents ET la liste des tâches (nouveau
        fichier = tout le contenu affiché doit changer), exactement
        comme un tout premier choix de fichier depuis TaskConfigScreen."""
        fichier, _filtre = BoiteDialogueAutoniaX.ouvrir_fichier(
            self, "Choisir le fichier WORKSPACE", "", "Fichiers JSON (*.json)",
        )
        if not fichier:
            return
        self._task.workspace_fichier = fichier
        reglages = self._reglages_app()
        if reglages is not None:
            enregistrer_workspace_recent(reglages, fichier)
            reglages.save()
        self.label_workspace_actif.setText(Path(fichier).name)
        self.label_workspace_actif.setToolTip(fichier)
        self._rafraichir_liste_recents()
        self._rafraichir_liste_taches()

    def _sur_clic_ouvrir_recent(self, item: QListWidgetItem):
        """Handler du clic sur une ligne de la liste "Récents" (AJOUT,
        demande explicite utilisateur : "que l'on clique pour ouvrir") --
        bascule IMMÉDIATEMENT task.workspace_fichier sur le chemin
        cliqué (UserRole de `item`, cf. _rafraichir_liste_recents), sans
        confirmation supplémentaire (spec du mini-gestionnaire : un clic
        = une ouverture directe, pas de case à cocher/sélection
        multiple). PAS de project.save() ici, même raisonnement que
        _sur_clic_choisir_fichier ci-dessus (à la charge de
        TaskConfigScreen après exec()). Remonte aussi ce chemin en tête
        des récents et persiste reglages.save() immédiatement (même
        raisonnement que ci-dessus : ReglagesApp n'est jamais sauvegardée
        par l'appelant)."""
        chemin = item.data(Qt.UserRole)
        if not chemin:
            return
        self._task.workspace_fichier = chemin
        reglages = self._reglages_app()
        if reglages is not None:
            enregistrer_workspace_recent(reglages, chemin)
            reglages.save()
        self.label_workspace_actif.setText(Path(chemin).name)
        self.label_workspace_actif.setToolTip(chemin)
        self._rafraichir_liste_recents()
        self._rafraichir_liste_taches()

    # ------------------------------------------------------------------
    # Liste des tâches (fichier WORKSPACE unique du Task)
    # ------------------------------------------------------------------

    def _rafraichir_liste_taches(self):
        """Rescanne le fichier WORKSPACE de `self._task`
        (task.workspace_fichier -- PATCH v2, un seul fichier désormais,
        plus une liste de dossiers chaînés) et repeuple l'arbre + le
        résumé statistique (spec 5.1 : "recalculé à chaque ouverture et
        après chaque action de cette boîte"). La sélection (cases
        cochées) est volontairement PERDUE à chaque rafraîchissement --
        ces cases ne servent qu'à cibler une action ponctuelle de
        marquage (spec 5.2 : "servent uniquement à sélectionner des
        tâches pour les deux actions de la section 5.3"), pas un état à
        préserver entre deux actions successives.

        Aucune purge de dossier introuvable ici (PATCH v2 -- l'ancienne
        _purger_workspaces_introuvables n'a plus de sens avec un fichier
        unique) : si le fichier est absent/illisible/invalide,
        scanner_taches_workspace retourne déjà une liste vide (repli sûr,
        cf. sa docstring), affichée telle quelle (arbre vide, "0 terminée
        · 0 en attente · 0 au total") sans avertissement bloquant -- le
        fichier a pu être renommé/déplacé temporairement, ou pas encore
        créé par le script qui le génère."""
        self._taches = scanner_taches_workspace(self._task.workspace_fichier)
        self.arbre_taches.clear()
        # PATCH v3 (ajout du statut "abandonnee") : libellé + couleur
        # dérivés de tache.statut plutôt que du seul booléen tache.termine.
        # Coloration MAUVE pour "Terminé" (demande explicite utilisateur :
        # "je veux que le mot terminé ait une coloration mauve") -- "En
        # attente" garde le jaune existant ; "Abandonnée" en rouge
        # (Mocha.red), pour la distinguer visuellement des deux autres
        # comme un état volontairement écarté, ni un succès ni une
        # tâche encore à traiter.
        libelles_statut = {
            "termine": "Terminé",
            "en_attente": "En attente",
            "abandonnee": "Abandonnée",
        }
        couleurs_statut = {
            "termine": Mocha.mauve,
            "en_attente": Mocha.yellow,
            "abandonnee": Mocha.red,
        }
        for tache in self._taches:
            item = QTreeWidgetItem()
            item.setFlags(item.flags() | Qt.ItemIsUserCheckable)
            item.setCheckState(0, Qt.Unchecked)
            item.setText(self.COLONNE_NOM, tache.nom_affiche)
            item.setText(self.COLONNE_STATUT, libelles_statut[tache.statut])
            item.setForeground(
                self.COLONNE_STATUT,
                QBrush(QColor(couleurs_statut[tache.statut])),
            )
            item.setData(0, Qt.UserRole, tache.numero)
            self.arbre_taches.addTopLevelItem(item)

        nb_termine = sum(1 for t in self._taches if t.statut == "termine")
        nb_abandonnee = sum(1 for t in self._taches if t.abandonnee)
        nb_attente = len(self._taches) - nb_termine - nb_abandonnee
        # "tout traité" : plus aucune tâche en attente (terminée ou
        # abandonnée, peu importe laquelle des deux) -- cf. comportement
        # équivalent d'origine, étendu au nouveau statut.
        tout_traite = len(self._taches) > 0 and nb_attente == 0
        coche = "\u2713 " if tout_traite else ""
        self.label_stats.setText(
            f'<span style="color:{Mocha.mauve}; font-weight:600;">{coche}{nb_termine} terminée(s)</span>'
            f'<span style="color:{Mocha.overlay1};"> \u00b7 </span>'
            f'<span style="color:{Mocha.text};">{nb_attente} en attente</span>'
            f'<span style="color:{Mocha.overlay1};"> \u00b7 </span>'
            f'<span style="color:{Mocha.red};">{nb_abandonnee} abandonnée(s)</span>'
            f'<span style="color:{Mocha.overlay1};"> \u00b7 {len(self._taches)} au total</span>'
        )

    def _item_vers_tache(self, item: QTreeWidgetItem) -> Optional["TacheWorkspace"]:
        numero = item.data(0, Qt.UserRole)
        for tache in self._taches:
            if tache.numero == numero:
                return tache
        return None

    # ------------------------------------------------------------------
    # Sélection en masse (spec 5.2)
    # ------------------------------------------------------------------

    def _cocher_toutes(self, coche: bool):
        etat = Qt.Checked if coche else Qt.Unchecked
        for i in range(self.arbre_taches.topLevelItemCount()):
            self.arbre_taches.topLevelItem(i).setCheckState(0, etat)

    def _cocher_selon(self, predicat):
        for i in range(self.arbre_taches.topLevelItemCount()):
            item = self.arbre_taches.topLevelItem(i)
            tache = self._item_vers_tache(item)
            coche = tache is not None and predicat(tache)
            item.setCheckState(0, Qt.Checked if coche else Qt.Unchecked)

    # ------------------------------------------------------------------
    # Marquage manuel (spec 5.3)
    # ------------------------------------------------------------------

    def _marquer_selection(self, statut):
        """PATCH v3 -- `statut` acceptait auparavant seulement un `bool`
        (True/False, 2 statuts possibles) ; accepte désormais directement
        une chaîne parmi STATUTS_TACHE_WORKSPACE ("termine" / "en_attente"
        / "abandonnee") pour pouvoir cibler le 3e statut. ecrire_statut_
        tache_workspace reste rétrocompatible avec un bool (cf. sa
        docstring) si un appelant externe en passait encore un."""
        taches_cochees = []
        for i in range(self.arbre_taches.topLevelItemCount()):
            item = self.arbre_taches.topLevelItem(i)
            if item.checkState(0) == Qt.Checked:
                tache = self._item_vers_tache(item)
                if tache is not None:
                    taches_cochees.append(tache)
        if not taches_cochees:
            return
        nb_echecs = 0
        for tache in taches_cochees:
            if not ecrire_statut_tache_workspace(tache, statut):
                nb_echecs += 1
        self._rafraichir_liste_taches()
        if nb_echecs:
            BoiteDialogueAutoniaX.warning(
                self, "Écriture partielle",
                f"{nb_echecs} tâche(s) n'ont pas pu être mises à jour sur disque "
                "(fichier supprimé entretemps, permissions, etc.).",
            )

    # ------------------------------------------------------------------
    # Mode de répartition (spec 5.4)
    # ------------------------------------------------------------------

    def _rafraichir_visibilite_spin(self):
        self.spin_nombre_fixe.setVisible(self.radio_mode_fixe.isChecked())

    def _sur_changement_mode(self):
        # AJOUT : persisté sur le Task à CHAQUE changement, pas seulement
        # à la validation -- cf. docstring de classe pour le raisonnement.
        self._task.workspace_mode_repartition = (
            "fixe" if self.radio_mode_fixe.isChecked() else "relatif"
        )
        self._rafraichir_visibilite_spin()

    def _sur_changement_nombre_fixe(self, valeur: int):
        self._task.workspace_nombre_fixe = max(1, int(valeur))

    def _sur_changement_champs_exclus(self, texte: str):
        """Persiste sur le Task, à CHAQUE modification (même règle que
        _sur_changement_mode), la liste nettoyée des champs à exclure. Signale
        dans un libellé les noms ignorés ("numero"/"statut" ne sont jamais
        excluables) pour que l'utilisateur ne croie pas les avoir exclus."""
        brut = [m.strip() for m in re.split(r"[,;\n]", texte or "") if m.strip()]
        propres = normaliser_champs_exclus(texte)
        self._task.workspace_champs_exclus = propres
        refuses = [m for m in brut if m in CHAMPS_WORKSPACE_NON_EXCLUABLES]
        if refuses:
            self.label_champs_exclus_info.setText(
                "⚠ Non excluable(s), ignoré(s) : " + ", ".join(dict.fromkeys(refuses))
                + " (nécessaires pour retrouver et mettre à jour la tâche)."
            )
        elif propres:
            self.label_champs_exclus_info.setText(
                f"{len(propres)} champ(s) exclu(s) au prochain « Attribuer »."
            )
        else:
            self.label_champs_exclus_info.setText("Aucune exclusion : les tâches sont envoyées en entier.")

    # ------------------------------------------------------------------
    # Validation (spec 5.4 : "déclenche la répartition sur l'état ACTUEL
    # des statuts (pas sur la sélection cochée), puis ferme la boîte")
    # ------------------------------------------------------------------

    def _sur_clic_attribuer(self):
        cles_profils = self._panneau_clone.ordre_affichage_cles_profils()
        if not cles_profils:
            BoiteDialogueAutoniaX.warning(
                self, "Aucun profil",
                "Aucun profil dans le panneau clone -- rien à attribuer.",
            )
            return
        # GARDE-FOU (AJOUT, conséquence directe du correctif de
        # TaskConfigScreen._sur_demande_attribuer_workspace_dialogue --
        # cf. son commentaire détaillé : cette boîte s'ouvre désormais
        # TOUJOURS au clic droit, même si CE Task n'a encore AUCUN
        # workspace_fichier configuré) : avant ce correctif, ce chemin
        # était inatteignable sans fichier déjà choisi (le clic droit
        # n'ouvrait alors jamais cette boîte). scanner_taches_workspace(
        # "") retombe silencieusement sur une liste vide (repli sûr,
        # cf. sa docstring) -- sans ce garde-fou, cliquer "Attribuer"
        # sans avoir choisi de fichier fermerait donc la boîte sans
        # rien attribuer ET sans que l'utilisateur comprenne pourquoi
        # (attribution_effectuee resterait mis à True avec un résultat
        # vide). Message explicite à la place, boîte laissée ouverte
        # pour que l'utilisateur choisisse un fichier (bouton "Choisir
        # un fichier..." ou panneau "Récents") avant de réessayer.
        if not self._task.workspace_fichier:
            BoiteDialogueAutoniaX.warning(
                self, "Aucun fichier WORKSPACE",
                "Choisis d'abord un fichier WORKSPACE (bouton \"Choisir un "
                "fichier...\" ou panneau \"Récents\") avant d'attribuer.",
            )
            return
        # PATCH v2 (SPEC_patch_tasks_json.md) : la file de tâches vient
        # désormais du SEUL fichier WORKSPACE de ce Task (plus de
        # chaînage entre plusieurs dossiers cochés).
        # PATCH v3 : `t.en_attente` exclut aussi les tâches abandonnées
        # (cf. commentaire équivalent de _effectuer_attribution_workspace).
        taches_actuelles = scanner_taches_workspace(self._task.workspace_fichier)
        taches_en_attente = [t for t in taches_actuelles if t.en_attente]
        self.derniere_attribution = repartir_taches_workspace(
            taches_en_attente, cles_profils,
            self._task.workspace_mode_repartition, self._task.workspace_nombre_fixe,
            champs_exclus=self._task.workspace_champs_exclus,
        )
        self.attribution_effectuee = True
        self._rafraichir_liste_taches()  # les statuts n'ont pas changé mais les stats affichées, si l'utilisateur enchaîne
        self.accept()


# ---------------------------------------------------------------------------
# PATCH E.7 (cf. cahier des charges patchs.md, section E.7 -- "Assignation
# des profils : un profil par sous-projet"). Mini-app ouverte DANS la zone
# d'application (cf. B.5, même mécanisme générique que FenetreRenduTaskReseau
# -- ApplicationsScreen.ouvrir_rendu_task_reseau accepte n'importe quel
# QWidget déjà construit, pas seulement le panneau de rendu réseau malgré
# son nom), via le bouton "Attribuer les profils" de ProjetBatchScreen.
#
# DÉCISIONS TRANCHÉES ICI (cf. cahier des charges, points [À CONFIRMER]
# levés faute de notion existante dans le code -- même philosophie que
# E.1/E.5 : trancher avec la lecture la plus raisonnable, documentée, plutôt
# que redemander) :
#   - "Badge" = proxy_configure + pays (les deux SEULS attributs qualitatifs
#     réellement stockés par profil cloud, cf. ProfilsCloudScreen/meta.json
#     -- aucune notion de tag/étiquette assignable n'existe ailleurs dans
#     tout le fichier).
#   - "Date de dernière utilisation" = date_envoi_iso (dernier ENVOI du
#     profil vers le cloud) -- PAS une vraie date de dernière EXÉCUTION
#     (cf. docstring de ProfilsCloudScreen : "Dernière exécution connue :
#     PAS câblée dans ce patch, aucune source de cette information
#     n'existe encore côté protocole"). C'est la seule donnée temporelle
#     réellement disponible par profil -- nommée honnêtement "Dernier
#     envoi" dans l'UI ci-dessous plutôt que de prétendre le contraire.
#
# CONTRAINTE D'UNICITÉ (cf. E.7) : un profil déjà assigné à un AUTRE
# sous-projet DANS CE MÊME ProjetBatch n'est jamais proposable une seconde
# fois (cf. _profils_libres). Aucune contrainte inter-batch (cf. E.7 : "un
# profil déjà utilisé dans un autre batch [...] reste disponible
# normalement") -- ce mini-app ne regarde JAMAIS project.projets_batch des
# AUTRES ProjetBatch, uniquement mapping_profils_sous_projets de CELUI
# ouvert.
# ---------------------------------------------------------------------------
class AttributionProfilsScreen(QWidget):
    """Mini-app "Attribuer les profils" (cf. E.7) -- assigne individuellement
    UN profil par sous-projet d'UN ProjetBatch donné, remplaçant le pool
    global partagé pour ce ProjetBatch précis (cf. ProjetBatch.mapping_
    profils_sous_projets, consommé par ProjetBatchScreen._resoudre_profils_
    envoi au moment de l'envoi réseau -- additif, un ProjetBatch qui n'ouvre
    jamais cette mini-app garde l'ancien comportement pool inchangé).

    Construite À LA DEMANDE par ProjetBatchScreen._on_clic_attribuer_
    profils (jamais réutilisée d'un ProjetBatch à l'autre, contrairement à
    FenetreRenduTaskReseau -- un nouvel onglet à chaque clic, cohérent avec
    ouvrir_test_composant/ouvrir_coordonnee_action qui font de même pour un
    contexte différent à chaque fois). Ne fait AUCUN appel réseau : reçoit
    tout son contexte (sous-projets, profils cloud + métadonnées, mapping
    déjà existant) en une fois à la construction, et REND la main via
    mapping_enregistre (dict complet, jamais un delta) -- c'est
    ProjetBatchScreen qui écrit réellement dans projet_batch.mapping_
    profils_sous_projets et sauvegarde le Project (même séparation de
    responsabilités que le reste du fichier : cet écran ne connaît ni
    Project ni la persistance disque)."""

    fermeture_demandee = Signal()
    # dict {numero_sous_projet (str): nom_profil} -- toujours le mapping
    # COMPLET au moment du clic sur "Enregistrer", jamais un delta (cf.
    # docstring de classe).
    mapping_enregistre = Signal(dict)

    def __init__(
        self, nom_projet_batch: str, numeros_sous_projets: list,
        mapping_existant: dict, infos_profils_cloud: dict, parent=None,
    ):
        """numeros_sous_projets : list[int], déjà résolue par l'appelant
        (cf. ProjetBatch.lister_sous_projets(), tous les sous-projets du
        ProjetBatch -- PAS seulement ceux actuellement cochés dans la
        grille de suivi, l'assignation de profil est indépendante de la
        sélection de lancement). mapping_existant : dict {str: str} déjà
        en place (peut être vide) -- PRÉ-REMPLIT l'état initial, permet de
        rouvrir cette mini-app pour corriger une assignation déjà faite
        sans tout reperdre. infos_profils_cloud : cf. ProfilsCloudScreen.
        infos_profils_cloud(), {nom: {"proxy_configure", "pays",
        "date_envoi_iso"}}."""
        super().__init__(parent)
        self.setObjectName("AttributionProfilsScreen")
        self._numeros_sous_projets = list(numeros_sous_projets)
        self._infos_profils_cloud = dict(infos_profils_cloud)
        # {numero (int): nom_profil (str)} -- état de travail EN MÉMOIRE,
        # modifié au fil des clics, RIEN n'est écrit dans le ProjetBatch
        # tant que "Enregistrer" n'est pas cliqué (cf. mapping_enregistre).
        self._mapping: dict = {}
        for numero_str, nom_profil in (mapping_existant or {}).items():
            try:
                numero = int(numero_str)
            except (TypeError, ValueError):
                continue
            if numero in self._numeros_sous_projets and nom_profil in self._infos_profils_cloud:
                self._mapping[numero] = nom_profil

        layout_racine = QVBoxLayout(self)
        layout_racine.setContentsMargins(0, 0, 0, 0)
        layout_racine.setSpacing(0)

        # --- Barre du haut : retour + titre (même pattern que TestComposantScreen.retour_bar) ---
        barre_haut = QWidget(self)
        barre_haut_layout = QHBoxLayout(barre_haut)
        barre_haut_layout.setContentsMargins(16, 12, 16, 12)
        bouton_retour = QPushButton(qta.icon("mdi6.arrow-left", color=Mocha.text), " Fermer", barre_haut)
        bouton_retour.setCursor(Qt.PointingHandCursor)
        bouton_retour.clicked.connect(self.fermeture_demandee.emit)
        barre_haut_layout.addWidget(bouton_retour)
        label_titre = QLabel(f"Attribuer les profils -- {nom_projet_batch}", barre_haut)
        label_titre.setObjectName("ReglagesTitre")
        barre_haut_layout.addWidget(label_titre, stretch=1)
        layout_racine.addWidget(barre_haut)

        corps = QWidget(self)
        layout = QVBoxLayout(corps)
        layout.setContentsMargins(20, 8, 20, 20)
        layout.setSpacing(12)
        layout_racine.addWidget(corps, stretch=1)

        label_intro = QLabel(
            f"{len(self._numeros_sous_projets)} sous-projet(s) dans ce batch. "
            "Chaque sous-projet doit avoir SON PROPRE profil -- un profil "
            "déjà assigné ici à un autre sous-projet n'est plus proposable.",
            corps,
        )
        label_intro.setObjectName("ReglagesLabel")
        label_intro.setWordWrap(True)
        layout.addWidget(label_intro)

        # PATCH E.7 -- avertissement VISIBLE (pas seulement en commentaire
        # de code) : l'exécution (locale ou sur sAutoniax distant) ne
        # respecte pas encore cette attribution individuelle, cf.
        # docstring de ProjetBatch.mapping_profils_sous_projets pour le
        # détail. Enregistrer ici prépare/documente l'attribution voulue,
        # mais l'envoi utilise toujours le pool de profils cochés dans le
        # dialogue "Envoyer vers un sAutoniax" -- pas encore ce mapping.
        label_avertissement = QLabel(
            "⚠ Attribution PAS ENCORE appliquée à l'exécution : l'envoi utilise "
            "toujours le pool de profils cochés dans le dialogue d'envoi, pas "
            "encore ce mapping individuel. Fonctionnalité en cours d'intégration.",
            corps,
        )
        label_avertissement.setObjectName("PlaceholderSubtitle")
        label_avertissement.setWordWrap(True)
        layout.addWidget(label_avertissement)

        # --- Bloc sélection semi-automatique ---
        bloc_auto = QFrame(corps)
        bloc_auto.setObjectName("ReglagesSeparateur")  # simple cadre visuel, réutilise un style existant
        layout_auto = QHBoxLayout(bloc_auto)
        layout_auto.setContentsMargins(12, 10, 12, 10)
        layout_auto.setSpacing(10)

        label_n = QLabel("Assigner automatiquement", bloc_auto)
        layout_auto.addWidget(label_n)
        self.spin_n = QSpinBox(bloc_auto)
        self.spin_n.setRange(1, max(1, len(self._numeros_sous_projets)))
        self.spin_n.setValue(len(self._numeros_sous_projets))
        layout_auto.addWidget(self.spin_n)
        label_n2 = QLabel("profil(s), critère :", bloc_auto)
        layout_auto.addWidget(label_n2)

        self.combo_critere = QComboBox(bloc_auto)
        self.combo_critere.setObjectName("ReglagesCombo")
        self.combo_critere.addItem("Dernier envoi le plus ancien d'abord", "date_asc")
        self.combo_critere.addItem("Avec proxy en priorité", "proxy_dabord")
        self.combo_critere.addItem("Sans proxy en priorité", "sans_proxy_dabord")
        layout_auto.addWidget(self.combo_critere, stretch=1)

        self.bouton_auto = QPushButton("Attribuer automatiquement", bloc_auto)
        self.bouton_auto.setCursor(Qt.PointingHandCursor)
        self.bouton_auto.clicked.connect(self._sur_clic_assignation_auto)
        layout_auto.addWidget(self.bouton_auto)
        layout.addWidget(bloc_auto)

        # --- Table d'assignation manuelle : une ligne par sous-projet ---
        self.table = QTreeWidget(corps)
        self.table.setObjectName("ProfilsCloudTable")
        self.table.setRootIsDecorated(False)
        self.table.setUniformRowHeights(True)
        self.table.setHeaderLabels(["Sous-projet", "Profil assigné", "Proxy", "Pays", "Dernier envoi"])
        self.table.header().setStretchLastSection(True)
        layout.addWidget(self.table, stretch=1)

        self.label_statut = QLabel("", corps)
        self.label_statut.setObjectName("PlaceholderSubtitle")
        self.label_statut.setWordWrap(True)
        layout.addWidget(self.label_statut)

        ligne_bas = QHBoxLayout()
        ligne_bas.addStretch(1)
        self.bouton_tout_effacer = QPushButton("Tout effacer", corps)
        self.bouton_tout_effacer.setCursor(Qt.PointingHandCursor)
        self.bouton_tout_effacer.clicked.connect(self._sur_clic_tout_effacer)
        ligne_bas.addWidget(self.bouton_tout_effacer)
        self.bouton_enregistrer = QPushButton("Enregistrer l'attribution", corps)
        self.bouton_enregistrer.setCursor(Qt.PointingHandCursor)
        self.bouton_enregistrer.clicked.connect(self._sur_clic_enregistrer)
        ligne_bas.addWidget(self.bouton_enregistrer)
        layout.addLayout(ligne_bas)

        self._reconstruire_table()

    # ------------------------------------------------------------------
    def _profils_libres(self, numero_exclu: Optional[int] = None) -> list:
        """Noms de profils cloud PAS encore assignés à un AUTRE sous-projet
        de CE ProjetBatch (cf. contrainte d'unicité E.7, docstring de
        module) -- `numero_exclu` : le sous-projet pour lequel on construit
        la liste (son PROPRE profil actuel, s'il en a un, reste inclus --
        sinon on ne pourrait jamais le laisser tel quel dans son propre
        combo)."""
        deja_pris = {
            nom_profil for numero, nom_profil in self._mapping.items()
            if numero != numero_exclu
        }
        return sorted(n for n in self._infos_profils_cloud.keys() if n not in deja_pris)

    def _reconstruire_table(self):
        self.table.setSortingEnabled(False)
        self.table.clear()
        for numero in sorted(self._numeros_sous_projets):
            item = QTreeWidgetItem()
            item.setText(0, str(numero))
            self.table.addTopLevelItem(item)

            combo = QComboBox()
            combo.setObjectName("ReglagesCombo")
            combo.addItem("-- aucun --", None)
            profil_actuel = self._mapping.get(numero)
            for nom_profil in self._profils_libres(numero_exclu=numero):
                combo.addItem(nom_profil, nom_profil)
            if profil_actuel:
                index = combo.findData(profil_actuel)
                if index >= 0:
                    combo.setCurrentIndex(index)
            combo.currentIndexChanged.connect(
                lambda _idx, c=combo, n=numero: self._sur_changement_combo(n, c.currentData())
            )
            self.table.setItemWidget(item, 1, combo)

            meta = self._infos_profils_cloud.get(profil_actuel, {}) if profil_actuel else {}
            proxy = meta.get("proxy_configure")
            item.setText(2, "Oui" if proxy else ("Non" if proxy is not None else "?"))
            item.setText(3, meta.get("pays") or "?")
            item.setText(4, self._formater_date(meta.get("date_envoi_iso")))

        nb_assignes = len(self._mapping)
        self.label_statut.setText(
            f"{nb_assignes}/{len(self._numeros_sous_projets)} sous-projet(s) avec un profil assigné."
        )

    @staticmethod
    def _formater_date(date_iso: Optional[str]) -> str:
        if not date_iso:
            return "--"
        try:
            return datetime.fromisoformat(date_iso).strftime("%d/%m/%Y %H:%M")
        except (ValueError, TypeError):
            return "--"

    # PATCH (retour utilisateur explicite : "jespere queil yaplus ce
    # genre bugs visuesls dansle code") -- même correctif que
    # PanneauProprietesSautoniax._afficher_statut_temporaire (cf. sa
    # docstring pour le détail complet), appliqué UNIQUEMENT aux
    # messages ponctuels ci-dessous ("Tous les sous-projets ont déjà un
    # profil assigné.", "Attribution enregistrée.") -- PAS au compteur
    # "N/M sous-projet(s) avec un profil assigné." de _reconstruire_
    # table, qui reste un état permanent reflétant la table tant
    # qu'aucun changement de mapping n'a eu lieu.
    DUREE_AFFICHAGE_STATUT_MS = 4000

    def _afficher_statut_temporaire(self, texte: str):
        self.label_statut.setText(texte)
        QTimer.singleShot(
            self.DUREE_AFFICHAGE_STATUT_MS,
            lambda: self.label_statut.setText("") if self.label_statut.text() == texte else None,
        )

    def _sur_changement_combo(self, numero: int, nom_profil: Optional[str]):
        if nom_profil:
            self._mapping[numero] = nom_profil
        else:
            self._mapping.pop(numero, None)
        # Un profil qui vient d'être choisi ici n'est plus "libre" pour les
        # AUTRES lignes -- reconstruction complète pour retirer cette
        # option de leurs combos respectifs (table petite par nature, un
        # ProjetBatch a rarement plus de quelques dizaines de sous-projets
        # -- pas besoin d'optimiser en mise à jour partielle).
        self._reconstruire_table()

    def _sur_clic_tout_effacer(self):
        self._mapping = {}
        self._reconstruire_table()

    def _sur_clic_assignation_auto(self):
        """Assigne automatiquement jusqu'à N profils LIBRES (cf. _profils_
        libres) aux N premiers sous-projets NON DÉJÀ ASSIGNÉS, dans l'ordre
        croissant de numéro -- ne touche JAMAIS un sous-projet déjà assigné
        manuellement (décision : l'automatique COMPLÈTE, ne réassigne
        jamais ce qui est déjà fait -- cohérent avec "Tout effacer" comme
        seule façon explicite de tout remettre à zéro).

        Critère de tri des profils candidats (cf. combo_critere) :
        "date_asc" (par défaut) = date_envoi_iso la plus ancienne d'abord
        (rotation équitable -- évite de toujours proposer les mêmes
        profils récemment envoyés) ; "proxy_dabord"/"sans_proxy_dabord" =
        priorité au badge proxy demandé, puis date_asc en critère
        secondaire pour les ex-aequo. Un profil sans date_envoi_iso
        connue est traité comme le PLUS ANCIEN (chaîne vide trie en
        premier) -- décision : mieux vaut proposer un profil dont on ne
        connaît pas la date plutôt que de le reléguer systématiquement en
        dernier sans raison métier."""
        n = self.spin_n.value()
        critere = self.combo_critere.currentData()

        def cle_tri(nom_profil: str):
            meta = self._infos_profils_cloud.get(nom_profil, {})
            date_cle = meta.get("date_envoi_iso") or ""
            proxy = bool(meta.get("proxy_configure"))
            if critere == "proxy_dabord":
                return (0 if proxy else 1, date_cle)
            if critere == "sans_proxy_dabord":
                return (0 if not proxy else 1, date_cle)
            return (date_cle,)

        numeros_a_completer = sorted(
            numero for numero in self._numeros_sous_projets if numero not in self._mapping
        )
        if not numeros_a_completer:
            self._afficher_statut_temporaire("Tous les sous-projets ont déjà un profil assigné.")
            return

        for numero in numeros_a_completer[:n]:
            candidats = sorted(self._profils_libres(numero_exclu=numero), key=cle_tri)
            if not candidats:
                break  # plus aucun profil disponible -- arrêt propre, pas d'erreur
            self._mapping[numero] = candidats[0]

        self._reconstruire_table()

    def _sur_clic_enregistrer(self):
        # {str(numero): nom_profil} -- cf. ProjetBatch.mapping_profils_
        # sous_projets, clés en str pour rester cohérent avec JSON.
        self.mapping_enregistre.emit({str(numero): nom for numero, nom in self._mapping.items()})
        self._afficher_statut_temporaire("Attribution enregistrée.")


class ProjetBatchScreen(QWidget):
    """Écran unique d'édition ET de suivi d'un ProjetBatch (cf. décision
    utilisateur : "un seul écran intégré, pas de dialogue modal séparé pour
    le mapping") -- réunit dans le même panneau : sélection du Task,
    sélection des instances déjà lancées à réutiliser, dossier racine,
    panneau de mapping variable <-> fichier (section 3 et 7 du patch), ET
    la grille de statuts des sous-projets (chacun individuellement
    sélectionnable pour le prochain lancement) + bouton Démarrer/Arrêter
    (section 4 et 8).

    Vue par défaut : grille de ProjetBatchCarte (même pattern que
    TaskConfigScreen._build_grille). Clic sur une card -> ouvre cet écran
    d'édition à un seul niveau pour CE ProjetBatch précis.

    Toute la logique de traitement en masse (validation de conformité,
    orchestration en mode pool par réutilisation d'instances, exécution
    headless) est déléguée à MoteurExecutionBatch (brique 5) -- cet écran
    ne fait QUE construire un ProjetBatch/MoteurExecutionBatch et réagir à
    ses signaux, jamais dupliquer sa logique.

    Un client réseau OBSERVATEUR dédié (self._client_reseau_instances,
    même role="observateur" que ProfilsInstancesScreen -- ne compte jamais
    comme "occupée" pour les autres, cf. srv_liste_instances_message) reste
    connecté PENDANT TOUTE LA VIE de cet écran (pas seulement pendant
    l'édition d'un ProjetBatch précis) pour peupler liste_instances_batch
    en continu -- l'utilisateur doit voir apparaître une instance qu'il
    vient de lancer depuis l'autre onglet sans avoir à rouvrir l'écran.

    PATCH (Patch 4.4.a -- envoi vers un sAutoniax) : demande_envoi_projet_
    sautoniax est émis quand l'utilisateur valide le dialogue "Envoyer
    vers un sAutoniax" (cf. DialogueEnvoiSautoniax, bouton dans le bloc
    suivi) -- porte (id_executant, id_projet_batch, chemin_racine,
    nom_projet, profils_coches). Cet écran ne connaît ni ClientServeurT
    ni la liste des sAutoniax/profils cloud disponibles (mêmes séparations
    de responsabilités que le reste du fichier -- fournies depuis
    l'extérieur via definir_executants_disponibles/definir_profils_cloud_
    disponibles, alimentées par MainWindow)."""

    demande_envoi_projet_sautoniax = Signal(str, str, str, str, list)
    # PATCH E (E.4 -- "Notion de Batch") -- pendant multi-projets du
    # signal ci-dessus. Porte (id_executant, ids_projets_batch [dans
    # l'ordre d'exécution souhaité], profils_coches) -- PAS de
    # chemin_racine/nom_projet ici (contrairement au signal mono-projet) :
    # MainWindow._sur_demande_envoi_batch_sautoniax résout chaque
    # id_projet_batch lui-même (cf. sa docstring), cet écran-ci n'a plus
    # besoin de les extraire un par un puisqu'il y en a potentiellement
    # plusieurs.
    demande_envoi_batch_sautoniax = Signal(str, list, list)
    # PATCH E.5 (cf. cahier des charges patchs.md, section E.5) --
    # variante FILTRÉE de demande_envoi_projet_sautoniax ci-dessus : porte
    # en plus `numeros_sous_projets` (liste d'int, JAMAIS vide -- cf.
    # garde dans _on_clic_traiter_echecs/_on_clic_retraiter_tout) --
    # MainWindow ne doit zipper/envoyer QUE ces sous-dossiers numérotés
    # précis, au lieu du dossier chemin_racine entier (cf. docstring de
    # _on_demande_envoi_projet_sautoniax_filtre côté MainWindow pour le
    # comment). Porte (id_executant, id_projet_batch, chemin_racine,
    # nom_projet, profils_coches, numeros_sous_projets).
    demande_envoi_projet_sautoniax_filtre = Signal(str, str, str, str, list, list)
    # PATCH E.7 -- même route générique que TaskConfigScreen.demande_
    # ouvrir_rendu_reseau (cf. MainWindow._ouvrir_rendu_task_reseau /
    # ApplicationsScreen.ouvrir_rendu_task_reseau, qui accepte n'importe
    # quel QWidget déjà construit malgré son nom). Porte (widget
    # AttributionProfilsScreen déjà construit, titre) -- cet écran ne
    # connaît pas ApplicationsScreen, seulement MainWindow qui relaie.
    demande_ouvrir_attribution_profils = Signal(object, str)

    def __init__(self, project: "Project", parent=None):
        super().__init__(parent)
        self.project = project
        self._executants_disponibles: dict[str, str] = {}  # id_executant -> nom, cf. definir_executants_disponibles
        self._profils_cloud_disponibles: list = []  # cf. definir_profils_cloud_disponibles
        self._infos_profils_cloud: dict = {}  # cf. definir_infos_profils_cloud (PATCH E.7)
        self._projet_batch_courant: Optional[str] = None  # id du ProjetBatch ouvert, None = vue grille
        self._projet_batch_cartes: dict = {}  # id ProjetBatch -> ProjetBatchCarte
        self._sous_projet_cartes: dict = {}  # numero -> SousProjetCarte (vue suivi de l'écran ouvert)
        self._sous_projets_coches: set = set()  # numeros cochés pour le prochain lancement, cf. _reload_sous_projets/_sous_projets_selectionnes
        self._moteur_batch: Optional["MoteurExecutionBatch"] = None  # non-None seulement pendant une exécution
        self._instances_connues: dict = {}  # instance_id -> libre (bool), cf. _sur_liste_instances_recue_batch
        self._instances_cochees: set = set()  # instance_id cochés dans liste_instances_batch, préservé entre deux _rafraichir_liste_instances_batch
        # PATCH E (E.4 -- "Notion de Batch") -- ids de ProjetBatchCarte
        # actuellement cochés dans la vue grille, UNIQUEMENT pertinent
        # pendant le mode sélection (cf. _basculer_mode_selection_batch) --
        # toujours vidé en quittant ce mode, jamais préservé d'une
        # session de sélection à l'autre (contraste délibéré avec
        # _sous_projets_coches/_instances_cochees ci-dessus, qui eux
        # persistent : une sélection de batch est une action ponctuelle
        # "je choisis maintenant qui envoyer", pas un état de travail
        # durable comme le mapping de sous-projets).
        self._mode_selection_batch = False
        # PATCH E (E.4) -- liste (PAS un set) : préserve l'ordre réel dans
        # lequel l'utilisateur a coché chaque carte, qui devient l'ordre
        # d'exécution séquentielle du batch envoyé (cf. _on_clic_envoyer_
        # batch_selection : "j'ai cliqué sur A puis B" = "A s'exécute
        # avant B" sur le sAutoniax cible -- le plus prévisible du point
        # de vue utilisateur, plutôt que l'ordre d'affichage de la grille).
        self._ids_projets_batch_coches: list = []

        root_layout = QVBoxLayout(self)
        root_layout.setContentsMargins(0, 0, 0, 0)
        root_layout.setSpacing(0)

        self.stack = QStackedWidget(self)
        root_layout.addWidget(self.stack, 1)

        self._build_grille()
        self._build_editeur()

        self.stack.addWidget(self.grille_page)
        self.stack.addWidget(self.editeur_page)
        self.stack.setCurrentWidget(self.grille_page)

        # Client réseau observateur dédié à LA LISTE D'INSTANCES (distinct
        # du client jetable de MoteurExecutionBatch._verifier_instances_
        # bloquant, et distinct de celui de ProfilsInstancesScreen -- id
        # unique, cf. docstring de ClientReseauAutoniaX : jamais deux
        # connexions actives avec le même id_client).
        self._client_reseau_instances: Optional["ClientReseauAutoniaX"] = None
        if RESEAU_DASHBOARD_DISPONIBLE:
            self._client_reseau_instances = ClientReseauAutoniaX(
                SERVER_URL_DASHBOARD, role="observateur", id_client=f"projetbatch-instances-{uuid.uuid4().hex[:8]}",
            )
            self._client_reseau_instances.liste_instances_recue.connect(self._sur_liste_instances_recue_batch)
            self._client_reseau_instances.demarrer()

        self._reload_grille()

    # --- Cycle de vie ---

    def arreter_tout(self):
        """À appeler depuis DashboardScreen.arreter_tout() (elle-même
        appelée par MainWindow.closeEvent). Ferme UNIQUEMENT le client
        réseau observateur self._client_reseau_instances -- distinct de
        ProfilsInstancesScreen.arreter_tout() qui, lui, tue aussi les
        process instance nodriver eux-mêmes (cf. réglage
        fermer_instances_a_fermeture). Ici il n'y a jamais de process à
        tuer : cet écran ne fait qu'OBSERVER la liste d'instances déjà
        gérées ailleurs (ProfilsInstancesScreen), jamais n'en lance ni
        n'en ferme directement.

        Ne touche PAS à self._moteur_batch : un batch en cours doit
        continuer à tourner après la fermeture de la fenêtre (cf.
        docstring de DashboardScreen.arreter_tout, même philosophie que
        le réglage "Fermer les instances à la fermeture de l'app",
        désactivé par défaut -- un traitement de masse est un travail de
        fond, pas quelque chose que fermer la fenêtre doit interrompre)."""
        if self._client_reseau_instances is not None:
            self._client_reseau_instances.arreter(timeout=3.0)
            self._client_reseau_instances = None
        # instance_apercu_batch a son PROPRE client_reseau indépendant
        # (cf. InstanceApercuScreen.__init__), jamais fermé par ce qui
        # précède -- à couper explicitement ici. PATCH (suppression du
        # rendu visuel de l'onglet "Aperçu d'exécution", cf. docstring de
        # _build_apercu_execution) : cette instance d'InstanceApercuScreen
        # ne sert plus qu'à porter la connexion réseau "pilote exclusif"
        # utilisée par le BUGFIX de _demarrer_batch (aucun streaming n'est
        # jamais démarré dessus désormais, suspendre_streaming() reste un
        # no-op inoffensif ici, gardé par simple prudence).
        if hasattr(self, "instance_apercu_batch"):
            self.instance_apercu_batch.suspendre_streaming()
            if self.instance_apercu_batch.client_reseau is not None:
                self.instance_apercu_batch.client_reseau.arreter(timeout=3.0)

    # ------------------------------------------------------------------
    # Vue grille (par défaut) -- même structure que TaskConfigScreen._build_grille.
    # ------------------------------------------------------------------
    def _build_grille(self):
        self.grille_page = QWidget(self)
        outer_layout = QVBoxLayout(self.grille_page)
        outer_layout.setContentsMargins(28, 24, 28, 24)
        outer_layout.setSpacing(4)

        # --- En-tête : titre/sous-titre à gauche, bouton signature de
        # création à droite (PATCH -- retour utilisateur : "le bouton de
        # création est trop générique, ce style est trop utilisé dans le
        # code, je voulais un design beaucoup plus spécial pour la
        # création de projet"). Remplace le rond flottant FloatingAddButton
        # (identique à Composants/ServiceAPI/Tasks) par une pilule dédiée,
        # en dégradé mauve->bleu -- les deux couleurs de l'anneau de
        # pilotage de l'app (cf. SplashScreen/_ICON_SVG_AUTONIAX), pour
        # que CE bouton précis (celui qui démarre un nouveau Projet Batch,
        # l'action la plus structurante de cet écran) porte visuellement
        # cette identité plutôt qu'un style neutre repris ailleurs. Ancré
        # dans l'en-tête (pas flottant par-dessus la grille) : toujours
        # visible sans recouvrir une carte en bas de grille.
        entete_layout = QHBoxLayout()
        entete_layout.setSpacing(16)

        colonne_titre = QVBoxLayout()
        colonne_titre.setSpacing(4)
        titre_label = QLabel("Projets Batch", self.grille_page)
        titre_label.setObjectName("PlaceholderTitle")
        colonne_titre.addWidget(titre_label)

        sous_titre_label = QLabel(
            "Traitez un même Task sur un grand nombre de dossiers de données, "
            "avec plusieurs instances en parallèle. Cliquez sur un projet pour "
            "l'ouvrir, ou créez-en un nouveau.",
            self.grille_page,
        )
        sous_titre_label.setObjectName("PlaceholderSubtitle")
        sous_titre_label.setWordWrap(True)
        colonne_titre.addWidget(sous_titre_label)
        entete_layout.addLayout(colonne_titre, 1)

        self.bouton_nouveau_batch = QPushButton(self.grille_page)
        self.bouton_nouveau_batch.setObjectName("NouveauProjetBatchButton")
        self.bouton_nouveau_batch.setIcon(qta.icon("mdi6.layers-plus", color=Mocha.crust))
        self.bouton_nouveau_batch.setIconSize(QSize(20, 20))
        self.bouton_nouveau_batch.setText(" Nouveau Projet Batch")
        self.bouton_nouveau_batch.setCursor(Qt.PointingHandCursor)
        self.bouton_nouveau_batch.setFixedHeight(42)
        self.bouton_nouveau_batch.clicked.connect(self._creer_projet_batch)
        entete_layout.addWidget(self.bouton_nouveau_batch, 0, Qt.AlignTop)

        # PATCH E (E.4 -- "Notion de Batch" : plusieurs ProjetBatch
        # assignés à un seul sAutoniax, exécutés séquentiellement). Bouton
        # bascule qui active le mode sélection multiple sur la grille (cf.
        # ProjetBatchCarte.set_mode_selection) -- son libellé/icône change
        # selon l'état courant (cf. _basculer_mode_selection_batch),
        # même pattern qu'un bouton "Modifier/Terminer" classique plutôt
        # que deux boutons distincts qui se substitueraient l'un à
        # l'autre. Désactivé tant qu'aucun ProjetBatch n'existe (rien à
        # sélectionner) -- cf. _reload_grille.
        self.bouton_mode_selection_batch = QPushButton(self.grille_page)
        self.bouton_mode_selection_batch.setObjectName("CaptureButton")
        self.bouton_mode_selection_batch.setIcon(qta.icon("mdi6.send-outline", color=Mocha.crust))
        self.bouton_mode_selection_batch.setIconSize(QSize(18, 18))
        self.bouton_mode_selection_batch.setText(" Envoyer un batch")
        self.bouton_mode_selection_batch.setCursor(Qt.PointingHandCursor)
        self.bouton_mode_selection_batch.setFixedHeight(42)
        self.bouton_mode_selection_batch.clicked.connect(self._basculer_mode_selection_batch)
        entete_layout.addWidget(self.bouton_mode_selection_batch, 0, Qt.AlignTop)

        outer_layout.addLayout(entete_layout)
        outer_layout.addSpacing(16)

        # PATCH E (E.4) -- barre secondaire, cachée hors mode sélection
        # (cf. _basculer_mode_selection_batch). Affiche le nombre de
        # ProjetBatch actuellement cochés + le bouton de validation
        # ("Envoyer (N)"), désactivé tant qu'aucune carte n'est cochée --
        # un batch vide n'a pas de sens (cf. E.4 : "plusieurs projets").
        self.barre_selection_batch = QWidget(self.grille_page)
        barre_layout = QHBoxLayout(self.barre_selection_batch)
        barre_layout.setContentsMargins(0, 0, 0, 12)
        barre_layout.setSpacing(12)
        self.label_selection_batch = QLabel("Aucun projet sélectionné", self.barre_selection_batch)
        self.label_selection_batch.setObjectName("ReglagesLabel")
        barre_layout.addWidget(self.label_selection_batch)
        barre_layout.addStretch(1)
        self.bouton_envoyer_batch_selection = QPushButton("Envoyer (0)", self.barre_selection_batch)
        self.bouton_envoyer_batch_selection.setObjectName("CaptureButton")
        self.bouton_envoyer_batch_selection.setCursor(Qt.PointingHandCursor)
        self.bouton_envoyer_batch_selection.setEnabled(False)
        self.bouton_envoyer_batch_selection.clicked.connect(self._on_clic_envoyer_batch_selection)
        barre_layout.addWidget(self.bouton_envoyer_batch_selection)
        self.barre_selection_batch.setVisible(False)
        outer_layout.addWidget(self.barre_selection_batch)

        self.zone_contenu = QWidget(self.grille_page)
        zone_layout = QVBoxLayout(self.zone_contenu)
        zone_layout.setContentsMargins(0, 0, 0, 0)
        zone_layout.setSpacing(0)
        outer_layout.addWidget(self.zone_contenu, 1)

        self.placeholder_widget = QWidget(self.zone_contenu)
        placeholder_layout = QVBoxLayout(self.placeholder_widget)
        placeholder_layout.setAlignment(Qt.AlignCenter)
        placeholder_layout.setSpacing(16)
        placeholder_icon = QLabel(self.placeholder_widget)
        placeholder_icon.setPixmap(qta.icon("mdi6.folder-multiple-outline", color=Mocha.surface2).pixmap(40, 40))
        placeholder_icon.setAlignment(Qt.AlignCenter)
        placeholder_layout.addWidget(placeholder_icon)
        placeholder_texte = QLabel(
            "Aucun Projet Batch pour l'instant. Cliquez sur « + » pour en créer un.",
            self.placeholder_widget,
        )
        placeholder_texte.setObjectName("PlaceholderSubtitle")
        placeholder_texte.setAlignment(Qt.AlignCenter)
        placeholder_layout.addWidget(placeholder_texte)
        zone_layout.addWidget(self.placeholder_widget, 1)

        self.grid_scroll = QScrollArea(self.zone_contenu)
        self.grid_scroll.setObjectName("FlowGridViewport")
        self.grid_scroll.setWidgetResizable(True)
        self.grid_scroll.setFrameShape(QFrame.NoFrame)
        self.grid_scroll.setHorizontalScrollBarPolicy(Qt.ScrollBarAlwaysOff)
        self.grid_scroll.setVerticalScrollBarPolicy(Qt.ScrollBarAlwaysOff)

        grid_wrapper = QWidget(self.grid_scroll)
        grid_wrapper_layout = QVBoxLayout(grid_wrapper)
        grid_wrapper_layout.setContentsMargins(0, 0, 0, 0)
        grid_wrapper_layout.setSpacing(0)
        grid_wrapper_layout.addStretch(1)
        self.flow_grid = FlowGrid(item_width=200, spacing=14, center=True)
        grid_wrapper_layout.addWidget(self.flow_grid)
        grid_wrapper_layout.addStretch(1)
        self.grid_scroll.setWidget(grid_wrapper)
        self.grid_scroll.setVisible(False)
        zone_layout.addWidget(self.grid_scroll, 1)

        # PATCH E (E.4 -- "Interface Projets à envoyer à sAutoniax : panneau
        # gauche montre la liste des batchs [...] chaque batch a un nom
        # (potentiellement long) -> QSplitter pour élargir la colonne des
        # noms"). Vue alternative à la grille de cartes, visible UNIQUEMENT
        # en mode sélection (cf. _basculer_mode_selection_batch) : la
        # ProjetBatchCarte (200x100 fixe) tronque les noms longs, ce qui
        # est acceptable pour "parcourir/ouvrir" mais pas pour "choisir
        # précisément lesquels envoyer et dans quel ordre" -- d'où une
        # vraie liste ici, avec une colonne Nom redimensionnable par
        # l'utilisateur (le rôle du QSplitter), plutôt que d'agrandir
        # uniformément toutes les cartes de la grille (qui gênerait la
        # navigation normale hors mode sélection, cf. E.4 : le panneau
        # gauche liste les batchs -- c'est CETTE vue-ci qui en tient lieu
        # pendant la composition d'un envoi, la grille restant la vue
        # "parcourir" par défaut).
        self.splitter_selection_batch = QSplitter(Qt.Horizontal, self.zone_contenu)
        self.splitter_selection_batch.setObjectName("ProjetsBatchSelectionSplitter")
        self.splitter_selection_batch.setChildrenCollapsible(False)

        self.liste_selection_batch = QTreeWidget(self.splitter_selection_batch)
        self.liste_selection_batch.setObjectName("ProjetsBatchSelectionListe")
        self.liste_selection_batch.setRootIsDecorated(False)
        self.liste_selection_batch.setUniformRowHeights(True)
        self.liste_selection_batch.setSelectionMode(QAbstractItemView.NoSelection)
        # Colonne "Nom" élargissable par l'utilisateur via le QSplitter
        # englobant (self.splitter_selection_batch) -- la colonne "Infos"
        # complète la ligne (Task + instances, même contenu que le
        # info_label de ProjetBatchCarte) sans avoir besoin d'être
        # redimensionnée séparément (stretchLastSection s'en charge).
        self.liste_selection_batch.setHeaderLabels(["Nom du batch", "Infos"])
        self.liste_selection_batch.header().setStretchLastSection(True)
        self.liste_selection_batch.itemChanged.connect(self._sur_coche_item_liste_selection_batch)
        self.splitter_selection_batch.addWidget(self.liste_selection_batch)

        # Second panneau (droite) : petit récapitulatif de la sélection en
