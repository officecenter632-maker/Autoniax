    def definir_executants_connus(self, executants: list):
        id_selectionne_avant = self.combo_executant.currentData()
        self._noms_executants = {e.get("id", ""): e.get("nom") or e.get("id", "") for e in executants if e.get("id")}

        self.combo_executant.blockSignals(True)
        self.combo_executant.clear()
        for id_executant, nom in sorted(self._noms_executants.items(), key=lambda kv: kv[1]):
            self.combo_executant.addItem(nom, id_executant)
        index_a_restaurer = self.combo_executant.findData(id_selectionne_avant)
        if index_a_restaurer >= 0:
            self.combo_executant.setCurrentIndex(index_a_restaurer)
        self.combo_executant.blockSignals(False)
        self._sur_executant_change(self.combo_executant.currentIndex())

    def _id_executant_selectionne(self) -> Optional[str]:
        return self.combo_executant.currentData()

    def _sur_executant_change(self, _index: int):
        id_executant = self._id_executant_selectionne()
        if self._fenetre_rendu is not None:
            self._fenetre_rendu.definir_titre_executant(
                self._noms_executants.get(id_executant, "") if id_executant else ""
            )
            self._fenetre_rendu.definir_image(
                self._dernieres_captures.get(id_executant) if id_executant else None
            )
        self._rafraichir_statut_init()
        self._rafraichir_disponibilite_execution()

    # ------------------------------------------------------------------
    # Profils cloud -- résultat de demande_liste_stockage, même filtrage
    # que ProfilsCloudScreen.sur_resultat_liste_stockage (version
    # minimale : seuls les noms de .zip sous Profils/ nous
    # intéressent ici, pas les badges proxy/pays/meta).
    # ------------------------------------------------------------------

    def sur_resultat_liste_stockage(self, ok: bool, objets: list, message: str):
        if not ok:
            self.label_statut_init.setText(f"Échec du chargement des profils cloud : {message}")
            return
        objets_normalises = [
            {"cle": o} if isinstance(o, str) else o for o in objets
        ]
        nouveaux_profils: dict[str, str] = {}
        for objet in objets_normalises:
            cle = objet.get("cle", "")
            if not cle.startswith(self.PREFIXE_CLOUD):
                continue
            reste = cle[len(self.PREFIXE_CLOUD):]
            if "/" in reste or not reste.endswith(".zip"):
                continue
            nom_profil = reste[:-len(".zip")]
            nouveaux_profils[nom_profil] = cle
        self._profils_cloud = nouveaux_profils

        profil_avant = self.combo_profil.currentText()
        self.combo_profil.blockSignals(True)
        self.combo_profil.clear()
        for nom_profil in sorted(self._profils_cloud.keys()):
            self.combo_profil.addItem(nom_profil)
        index_a_restaurer = self.combo_profil.findText(profil_avant)
        if index_a_restaurer >= 0:
            self.combo_profil.setCurrentIndex(index_a_restaurer)
        self.combo_profil.blockSignals(False)
        self._rafraichir_disponibilite_execution()

    def showEvent(self, event):
        # BUGFIX (même correction que ProfilsCloudScreen, cf. audit
        # patchs -- un emit() en fin de __init__ part dans le vide tant
        # que MainWindow n'a pas eu la chance de connecter le signal) :
        # demande la liste des profils cloud au premier affichage réel de
        # l'écran plutôt qu'à la construction.
        super().showEvent(event)
        if not getattr(self, "_deja_demande_liste_une_fois", False):
            self._deja_demande_liste_une_fois = True
            self.demande_liste_stockage.emit()

    # ------------------------------------------------------------------
    # Initialisation ("Initialiser" -- charge le profil sur le sAutoniax)
    # ------------------------------------------------------------------

    def _sur_clic_initialiser(self):
        id_executant = self._id_executant_selectionne()
        if not id_executant:
            self.label_statut_init.setText("Aucun sAutoniax sélectionné.")
            return
        profil = self.combo_profil.currentText().strip()
        if not profil:
            self.label_statut_init.setText("Aucun profil cloud sélectionné.")
            return
        self.bouton_initialiser.setEnabled(False)
        self.label_statut_init.setText(f"Initialisation en cours -- chargement de '{profil}'...")
        self._etats_initialisation[id_executant] = {"profil": profil, "pret": False}
        self._rafraichir_disponibilite_execution()
        self.demande_initialisation.emit(id_executant, profil)

    def sur_session_initialisation_demarree(self, id_executant: str, session_id: str):
        """Appelé par MainWindow juste après ClientServeurT.
        initialiser_notebook_distant, avec le session_id retourné --
        permet de filtrer les logs/résultat entrants sur CETTE demande
        précise (même Option A que le reste du fichier)."""
        self._session_init_courante[id_executant] = session_id

    def sur_log_initialisation_recu(self, session_id: str, id_executant: str, ligne: str):
        if self._session_init_courante.get(id_executant) != session_id:
            return
        if id_executant == self._id_executant_selectionne():
            self.label_statut_init.setText(ligne)

    def sur_resultat_initialisation_recu(self, session_id: str, id_executant: str, ok: bool, message: str):
        if self._session_init_courante.get(id_executant) != session_id:
            return
        etat = self._etats_initialisation.get(id_executant)
        if etat is not None:
            etat["pret"] = ok
        if id_executant == self._id_executant_selectionne():
            self.bouton_initialiser.setEnabled(True)
            if ok:
                profil = etat.get("profil", "") if etat else ""
                self.label_statut_init.setText(f"Prêt -- profil '{profil}' chargé sur ce sAutoniax.")
            else:
                self.label_statut_init.setText(f"Échec de l'initialisation : {message}" if message else "Échec de l'initialisation.")
            self._rafraichir_disponibilite_execution()

    def _rafraichir_statut_init(self):
        id_executant = self._id_executant_selectionne()
        etat = self._etats_initialisation.get(id_executant) if id_executant else None
        if etat is None:
            self.label_statut_init.setText("Ce sAutoniax n'a pas encore été initialisé.")
        elif etat.get("pret"):
            self.label_statut_init.setText(f"Prêt -- profil '{etat.get('profil', '')}' chargé sur ce sAutoniax.")
        else:
            self.label_statut_init.setText(f"Initialisation en cours -- chargement de '{etat.get('profil', '')}'...")

    def _sautoniax_selectionne_est_pret(self) -> bool:
        id_executant = self._id_executant_selectionne()
        if not id_executant:
            return False
        etat = self._etats_initialisation.get(id_executant)
        return bool(etat and etat.get("pret"))

    def _rafraichir_disponibilite_execution(self, *_args):
        """Tant que le sAutoniax sélectionné n'a pas terminé son
        initialisation (cf. docstring de classe, point 1 : "tant que ça
        n'a pas réussi, aucune cellule ne peut s'exécuter"), chaque
        bouton ▶ de cellule reste désactivé -- même mécanisme que
        TaskCelluleWidget.definir_active, détourné ici pour représenter
        "exécutable maintenant" plutôt que "cellule active/désactivée"
        (les deux états sont orthogonaux : une cellule peut être active
        au sens TaskCellule.active tout en restant temporairement non
        exécutable faute d'initialisation)."""
        pret = self._sautoniax_selectionne_est_pret()
        for widget in self._cellule_widgets.values():
            widget.bouton_executer.setEnabled(pret and widget.est_active())
            if not pret:
                widget.bouton_executer.setToolTip(
                    "Initialise d'abord le sAutoniax sélectionné avec un profil (bouton \"Initialiser\" ci-dessus)."
                )
            else:
                widget.bouton_executer.setToolTip("Exécuter cette cellule")

    # ------------------------------------------------------------------
    # Rendu -- bouton + fenêtre flottante non-modale (cf. docstring de
    # classe, point 3).
    # ------------------------------------------------------------------

    def _sur_clic_voir_rendu(self):
        if self._fenetre_rendu is None:
            self._fenetre_rendu = FenetreRenduNotebookDistant(self)
            self._fenetre_rendu.fermeture_demandee.connect(self._sur_fermeture_fenetre_rendu)
        id_executant = self._id_executant_selectionne()
        self._fenetre_rendu.definir_titre_executant(
            self._noms_executants.get(id_executant, "") if id_executant else ""
        )
        self._fenetre_rendu.definir_image(
            self._dernieres_captures.get(id_executant) if id_executant else None
        )
        self._fenetre_rendu.show()
        self._fenetre_rendu.raise_()
        self._fenetre_rendu.activateWindow()

    def _sur_fermeture_fenetre_rendu(self):
        # La fenêtre se ferme elle-même (close()) -- gardée en mémoire
        # (jamais deleteLater()) pour pouvoir la ré-afficher instantanément
        # au prochain clic sur "Voir le rendu" sans reconstruire le widget.
        pass

    def sur_capture_recue(self, id_executant: str, _nom_executant: str, _instance_id: str, image_b64: str):
        """Connecté par MainWindow au même signal ClientServeurT.
        capture_recue que ReceptionScreen (cf. docstring de classe) --
        garde la dernière capture par sAutoniax, pousse à la fenêtre de
        rendu si elle est ouverte ET que c'est le sAutoniax sélectionné."""
        self._dernieres_captures[id_executant] = image_b64
        if id_executant == self._id_executant_selectionne() and self._fenetre_rendu is not None and self._fenetre_rendu.isVisible():
            self._fenetre_rendu.definir_image(image_b64)

    # ------------------------------------------------------------------
    # Toolbar secondaire -- taille de police / retour à la ligne,
    # appliqués à TOUTES les cellules d'un coup (même esprit que
    # TaskConfigScreen, version simplifiée sans persistance ReglagesApp
    # -- écran de code jetable, pas de Task sauvegardé).
    # ------------------------------------------------------------------

    def _sur_taille_police_changee(self, valeur: int):
        police = QFont("Consolas", valeur)
        for widget in self._cellule_widgets.values():
            widget.editeur.setFont(police)

    def _sur_bascule_retour_ligne(self, actif: bool):
        self.bouton_retour_ligne.setIcon(self._icone_retour_ligne_on if actif else self._icone_retour_ligne_off)
        mode = QPlainTextEdit.WidgetWidth if actif else QPlainTextEdit.NoWrap
        for widget in self._cellule_widgets.values():
            widget.editeur.setLineWrapMode(mode)

    # ------------------------------------------------------------------
    # Notebook -- gestion des cellules (ajout/suppression/exécution),
    # même patron que TaskConfigScreen mais sans Task/persistance projet
    # (cf. docstring de classe, point 2).
    # ------------------------------------------------------------------

    def _inserer_widget_cellule(self, cellule: "TaskCellule", est_premiere: bool = False) -> "TaskCelluleWidget":
        widget = TaskCelluleWidget(
            cellule, None, self.notebook_contenu, est_premiere=est_premiere,
            afficher_bouton_etiquette=False, active=getattr(cellule, "active", True),
        )
        widget.demande_execution.connect(self._executer_cellule)
        widget.demande_suppression.connect(self._supprimer_cellule)
        widget.demande_ajout_apres.connect(self._ajouter_cellule)
        widget.demande_vider.connect(self._vider_cellule)
        widget.code_modifie.connect(self._sur_code_cellule_modifie)
        widget.demande_toggle_active.connect(self._sur_toggle_active_cellule)
        index_insertion = self.notebook_layout.count() - 1
        self.notebook_layout.insertWidget(max(index_insertion, 0), widget)
        self._cellule_widgets[widget.cellule_id] = widget
        return widget

    def _trouver_cellule(self, cellule_id: str) -> Optional["TaskCellule"]:
        for cellule in self._cellules:
            if cellule.id == cellule_id:
                return cellule
        return None

    def _rafraichir_index_cellules(self):
        for numero, cellule in enumerate(self._cellules):
            widget = self._cellule_widgets.get(cellule.id)
            if widget is not None:
                widget.definir_index(numero)

    def _ajouter_cellule(self, apres_id: Optional[str], avant: bool = False):
        nouvelle = TaskCellule()
        if apres_id is None:
            self._cellules.append(nouvelle)
        else:
            index_ref = next((i for i, c in enumerate(self._cellules) if c.id == apres_id), len(self._cellules) - 1)
            position = index_ref if avant else index_ref + 1
            self._cellules.insert(position, nouvelle)

        widget = self._inserer_widget_cellule(nouvelle)
        self.notebook_layout.removeWidget(widget)
        index_nouvelle = self._cellules.index(nouvelle)
        widget_avant = self._cellule_widgets.get(self._cellules[index_nouvelle - 1].id) if index_nouvelle > 0 else None
        if widget_avant is not None:
            pos = self.notebook_layout.indexOf(widget_avant)
            self.notebook_layout.insertWidget(pos + 1 if pos >= 0 else 0, widget)
        else:
            self.notebook_layout.insertWidget(0, widget)

        self._rafraichir_index_cellules()
        self._rafraichir_disponibilite_execution()
        widget.editeur.setFocus()

    def _supprimer_cellule(self, cellule_id: str):
        if len(self._cellules) <= 1:
            self.label_statut_init.setText("Impossible de supprimer la dernière cellule du notebook.")
            return
        if self._cellules[0].id == cellule_id:
            self.label_statut_init.setText("La première cellule ne peut pas être supprimée.")
            return
        self._cellules = [c for c in self._cellules if c.id != cellule_id]
        widget = self._cellule_widgets.pop(cellule_id, None)
        if widget is not None:
            self.notebook_layout.removeWidget(widget)
            widget.deleteLater()
        self._sessions_execution = {sid: cid for sid, cid in self._sessions_execution.items() if cid != cellule_id}
        self._rafraichir_index_cellules()

    def _vider_cellule(self, cellule_id: str):
        cellule = self._trouver_cellule(cellule_id)
        widget = self._cellule_widgets.get(cellule_id)
        if cellule is None or widget is None:
            return
        cellule.sortie = ""
        cellule.statut = "inedit"
        cellule.numero_execution = None
        widget.afficher_resultat(cellule)

    def _sur_code_cellule_modifie(self, cellule_id: str):
        widget = self._cellule_widgets.get(cellule_id)
        cellule = self._trouver_cellule(cellule_id)
        if widget is not None and cellule is not None:
            cellule.code = widget.code_actuel()

    def _sur_toggle_active_cellule(self, cellule_id: str):
        cellule = self._trouver_cellule(cellule_id)
        widget = self._cellule_widgets.get(cellule_id)
        if cellule is None or widget is None:
            return
        if cellule_id in self._sessions_execution.values():
            self.label_statut_init.setText("Impossible de désactiver une cellule en cours d'exécution.")
            return
        cellule.active = not getattr(cellule, "active", True)
        widget.definir_active(cellule.active)
        self._rafraichir_disponibilite_execution()

    def _executer_cellule(self, cellule_id: str):
        cellule = self._trouver_cellule(cellule_id)
        widget = self._cellule_widgets.get(cellule_id)
        if cellule is None or widget is None:
            return
        if not getattr(cellule, "active", True):
            self.label_statut_init.setText("Cette cellule est désactivée.")
            return
        if cellule_id in self._sessions_execution.values():
            self.label_statut_init.setText("Cette cellule est déjà en cours d'exécution.")
            return
        id_executant = self._id_executant_selectionne()
        if not id_executant:
            self.label_statut_init.setText("Aucun sAutoniax sélectionné.")
            return
        if not self._sautoniax_selectionne_est_pret():
            self.label_statut_init.setText("Initialise d'abord ce sAutoniax (bouton \"Initialiser\" ci-dessus).")
            return
        profil = self._etats_initialisation.get(id_executant, {}).get("profil", "")
        code = widget.code_actuel()
        cellule.code = code
        widget.indiquer_en_cours()
        self.demande_execution_cellule.emit(id_executant, profil, code, cellule_id)

    def sur_session_execution_demarree(self, session_id: str, cellule_id: str):
        """Appelé par MainWindow juste après ClientServeurT.
        executer_notebook_distant, avec le session_id résultant --
        permet de router logs/résultat vers LA bonne cellule."""
        self._sessions_execution[session_id] = cellule_id

    def sur_log_execution_recu(self, session_id: str, _id_executant: str, ligne: str):
        cellule_id = self._sessions_execution.get(session_id)
        if cellule_id is None:
            return
        cellule = self._trouver_cellule(cellule_id)
        if cellule is not None:
            cellule.sortie = (cellule.sortie + "\n" + ligne) if cellule.sortie else ligne
            widget = self._cellule_widgets.get(cellule_id)
            if widget is not None:
                widget.afficher_resultat(cellule)

    def sur_resultat_execution_recu(self, session_id: str, _id_executant: str, ok: bool, message: str):
        cellule_id = self._sessions_execution.pop(session_id, None)
        if cellule_id is None:
            return
        cellule = self._trouver_cellule(cellule_id)
        widget = self._cellule_widgets.get(cellule_id)
        if cellule is None or widget is None:
            return
        cellule.statut = "succes" if ok else "erreur"
        cellule.numero_execution = (cellule.numero_execution or 0) + 1
        if not ok and message:
            cellule.sortie = (cellule.sortie + "\n" + message) if cellule.sortie else message
        widget.afficher_resultat(cellule)


class IdentifiantStockageScreen(QWidget):
    """Sous-onglet "Identifiant" de StockageScreen.

    MIGRATION TOTALE Backblaze B2 -> Google Drive (décision explicite
    utilisateur : "je ne veux plus que tu utilise blackbaze ... migration
    total vers le drive"). Remplace l'ancien formulaire multi-comptes B2
    (sélecteur + Nouveau/Supprimer + 4 champs par compte) par UN SEUL
    formulaire à 2 champs (décision explicite utilisateur : "simplifier
    -- un seul compte Drive... plus de multi-comptes") :
      - chemin de la clé de service JSON (repli automatique sur
        get_app_data_dir()/"drive_service_account.json" si laissé vide,
        cf. ReglagesApp.drive_chemin_cle_json_resolu -- jamais un chemin
        arbitraire ailleurs sur le disque, décision explicite
        utilisateur : "regarde bien, il y a un dossier qui sauvegarde
        les données de l'app, ne parpille pas les données sur ma
        machine").
      - ID du dossier Drive racine (doit déjà exister et avoir été
        partagé en Éditeur avec l'adresse e-mail du compte de service,
        cf. DriveStockage -- contrainte de sécurité Google, pas une
        limite de ce formulaire).

    Émet stockage_modifie(dict) à chaque sauvegarde réussie -- StockageScreen
    relaie ce signal vers MainWindow, qui le connecte à ClientServeurT.
    definir_config_stockage pour propager le changement au serveurT sans
    attendre un redémarrage de l'app (cf. _config_stockage_depuis_reglages)."""

    stockage_modifie = Signal(dict)
    # PATCH A (cf. cahier des charges patchs.md) -- émis UNIQUEMENT quand
    # sur_resultat_configuration_stockage laisse passer un accusé (donc
    # jamais pour une reconnexion automatique sans action utilisateur,
    # cf. _attente_confirmation_serveur ci-dessous) -- MainWindow s'y
    # connecte pour relayer vers la statusBar globale sans risquer
    # d'afficher un message hors contexte à chaque reconnexion.
    resultat_confirme = Signal(bool, str)

    def __init__(self, reglages: "ReglagesApp", parent=None):
        super().__init__(parent)
        self.reglages = reglages
        # PATCH (feedback réseau) : True entre le clic "Enregistrer" (si
        # un config non-vide a été émise) et la réception du VRAI
        # résultat serveur -- cf. sur_resultat_configuration_stockage,
        # qui ignore silencieusement tout accusé reçu hors de cette
        # fenêtre (ex. accusé lié à une reconnexion automatique
        # survenant sans action de l'utilisateur sur ce formulaire).
        self._attente_confirmation_serveur = False

        layout = QVBoxLayout(self)
        layout.setContentsMargins(24, 20, 24, 20)
        layout.setSpacing(8)
        layout.setAlignment(Qt.AlignTop)

        label_intro = QLabel(
            "Compte Google Drive (stockage persistant des fichiers "
            "envoyés via le serveurT) :", self)
        label_intro.setObjectName("ReglagesLabel")
        label_intro.setWordWrap(True)
        layout.addWidget(label_intro)

        label_cle = QLabel("Chemin de la clé de service JSON (laisser vide pour utiliser le dossier de données de l'app) :", self)
        label_cle.setObjectName("ReglagesLabel")
        label_cle.setWordWrap(True)
        layout.addWidget(label_cle)
        self.champ_cle_json = QLineEdit(self)
        self.champ_cle_json.setPlaceholderText(str(get_app_data_dir() / "drive_service_account.json"))
        layout.addWidget(self.champ_cle_json)

        label_dossier = QLabel("ID du dossier Drive racine (partagé en Éditeur avec le compte de service) :", self)
        label_dossier.setObjectName("ReglagesLabel")
        label_dossier.setWordWrap(True)
        layout.addWidget(label_dossier)
        self.champ_dossier_racine_id = QLineEdit(self)
        self.champ_dossier_racine_id.setPlaceholderText("ex. 1mOSb2L3N1ebkgCb5S5d7fjBUJRLVggGJ")
        layout.addWidget(self.champ_dossier_racine_id)

        self.bouton_enregistrer = QPushButton("Enregistrer et envoyer au serveurT", self)
        self.bouton_enregistrer.setCursor(Qt.PointingHandCursor)
        self.bouton_enregistrer.clicked.connect(self._enregistrer)
        layout.addWidget(self.bouton_enregistrer)

        self.label_statut = QLabel("", self)
        self.label_statut.setWordWrap(True)
        self.label_statut.setObjectName("PlaceholderSubtitle")
        layout.addWidget(self.label_statut)

        layout.addStretch(1)

        self._charger_depuis_reglages()

    # PATCH (retour utilisateur explicite : "jespere queil yaplus ce
    # genre bugs visuesls dansle code") -- même correctif que
    # PanneauProprietesSautoniax._afficher_statut_temporaire (cf. sa
    # docstring pour le détail complet) : les messages terminaux
    # ci-dessous ne s'effaçaient jamais tout seuls.
    DUREE_AFFICHAGE_STATUT_MS = 4000

    def _afficher_statut_temporaire(self, texte: str):
        self.label_statut.setText(texte)
        QTimer.singleShot(
            self.DUREE_AFFICHAGE_STATUT_MS,
            lambda: self.label_statut.setText("") if self.label_statut.text() == texte else None,
        )

    def _charger_depuis_reglages(self):
        self.champ_cle_json.setText(self.reglages.drive_chemin_cle_json or "")
        self.champ_dossier_racine_id.setText(self.reglages.drive_dossier_racine_id or "")
        self.label_statut.setText("")

    def _enregistrer(self):
        dossier_racine_id = self.champ_dossier_racine_id.text().strip()
        if not dossier_racine_id:
            self._afficher_statut_temporaire("L'ID du dossier Drive racine est obligatoire.")
            return

        self.reglages.drive_chemin_cle_json = self.champ_cle_json.text().strip() or None
        self.reglages.drive_dossier_racine_id = dossier_racine_id
        self.reglages.save()

        config = _config_stockage_depuis_reglages(self.reglages)
        self.stockage_modifie.emit(config)

        if config:
            self._attente_confirmation_serveur = True
            self.label_statut.setText("Configuration enregistrée -- envoi au serveurT en cours...")
        else:
            self._attente_confirmation_serveur = False
            self._afficher_statut_temporaire("Configuration enregistrée (dossier racine vide -- rien n'est envoyé au serveurT).")

    def sur_resultat_configuration_stockage(self, ok: bool, message: str):
        """Connecté par MainWindow à ClientServeurT.stockage_configure_
        resultat -- PATCH (demande explicite utilisateur : "lorsque on
        effectue une action reseau ... il ya aucune confirmation dans le
        status bar"). Ce message part aussi automatiquement à CHAQUE
        (re)connexion au serveurT (cf. ClientServeurT._envoyer_config_
        stockage), pas seulement après un clic "Enregistrer" -- on
        n'écrase donc le label que si un enregistrement est
        effectivement en attente de confirmation (_attente_confirmation_
        serveur), pour ne jamais faire clignoter un message de succès/
        échec sans rapport avec ce que l'utilisateur vient de faire à
        l'instant, par exemple lors d'une reconnexion automatique
        survenant pendant qu'il consulte un autre onglet."""
        if not self._attente_confirmation_serveur:
            return
        self._attente_confirmation_serveur = False
        if ok:
            self._afficher_statut_temporaire("Configuration acceptée par le serveurT.")
            self.resultat_confirme.emit(True, "Configuration du stockage acceptée par le serveurT.")
        else:
            self._afficher_statut_temporaire(f"Configuration refusée par le serveurT : {message}")
            self.resultat_confirme.emit(False, f"Configuration du stockage refusée : {message}")


def _formater_duree_depuis_iso(horodatage_iso: str) -> str:
    """PATCH C (cf. cahier des charges patchs.md -- "durée de démarrage
    (depuis quand connecté / uptime)"). Parse un horodatage ISO 8601 UTC
    (cf. Connexion.connecte_le côté serveur.py, datetime.now(timezone.
    utc).isoformat()) et retourne la durée écoulée depuis, au même format
    compact que _formater_duree_activite (ProfilsInstancesScreen) --
    "12 min", "1 h 05" -- pour rester cohérent avec l'affichage de durée
    déjà existant ailleurs dans l'app, plutôt qu'inventer un second
    format. "--" si l'horodatage est absent/invalide (ex. ancien serveurT
    sans ce champ, ou format inattendu) -- ne doit jamais lever d'exception
    et casser l'affichage de la table pour autant."""
    if not horodatage_iso:
        return "--"
    try:
        instant = datetime.fromisoformat(horodatage_iso)
    except (ValueError, TypeError):
        return "--"
    if instant.tzinfo is None:
        instant = instant.replace(tzinfo=timezone.utc)
    secondes = max(0, int((datetime.now(timezone.utc) - instant).total_seconds()))
    if secondes < 60:
        return f"{secondes} s"
    minutes, secondes = divmod(secondes, 60)
    if minutes < 60:
        return f"{minutes} min"
    heures, minutes = divmod(minutes, 60)
    if heures < 24:
        return f"{heures} h {minutes:02d}"
    jours, heures = divmod(heures, 24)
    return f"{jours} j {heures:02d} h"


def _formater_taille_octets_mo(taille_octets: int) -> str:
    """Formatage en Mo avec 3 décimales (PATCH -- demande explicite
    utilisateur : "la taille nes pas assez preics" puis "3 decimal",
    après un premier essai en Ko/Mo/Go à 1 décimale jugé pas assez
    précis), pour l'affichage à côté des fichiers .py dans
    l'arborescence de l'onglet Stockage cloud. Toujours en Mo, même
    pour un fichier de quelques Ko (ex. "0.045 Mo") -- une seule unité
    fixe est plus simple à comparer visuellement entre fichiers qu'une
    unité qui change selon la taille (cf. l'ancienne version Ko/Mo/Go).

    Renommée depuis _formater_taille_octets (nom qui entrait en
    collision avec une fonction totalement différente plus bas dans le
    fichier, pour la taille sérialisée d'un Task -- même nom, deux
    définitions, la seconde écrasait silencieusement la première ;
    celle-ci a son propre nom pour lever toute ambiguïté)."""
    return f"{taille_octets / (1024 * 1024):.3f} Mo"


def _calculer_taille_dossier_octets(chemin_dossier: str) -> Optional[int]:
    """Somme récursive de la taille (en octets) de tous les fichiers d'un
    dossier -- PATCH (onglet "Profils Local", demande explicite
    utilisateur : "affihcer aussi la taille en mo des profils dans les
    deux table") -- utilisée pour afficher une colonne "Taille" côté
    Profils Local équivalente à `taille_octets` déjà stocké côté cloud
    (cf. ProfilsCloudScreen._profils_cloud), qui elle vient directement
    de la taille du zip B2 sans calcul (pas de dossier local à parcourir).

    Utilise os.scandir plutôt que Path.rglob : sensiblement plus rapide
    sur de gros arbres de fichiers (moins d'objets Python créés par
    entrée), important ici car potentiellement appelé une fois par
    profil local à chaque `demande_liste_profils_locaux` (showEvent +
    bouton "Actualiser").

    Retourne None si le dossier n'existe pas ou n'est pas listable
    (registre profils.json désynchronisé du disque, profil supprimé
    manuellement, permissions) -- jamais d'exception propagée : un profil
    dont la taille est illisible ne doit pas empêcher l'affichage des
    autres colonnes (même esprit que `taille_octets` optionnel côté
    cloud, cf. ProfilsCloudScreen._reconstruire_table :
    `_formater_taille_octets_mo(taille_octets) if taille_octets is not
    None else "?"`)."""
    total = 0
    try:
        with os.scandir(chemin_dossier) as it:
            for entree in it:
                try:
                    if entree.is_dir(follow_symlinks=False):
                        sous_total = _calculer_taille_dossier_octets(entree.path)
                        if sous_total is not None:
                            total += sous_total
                    elif entree.is_file(follow_symlinks=False):
                        total += entree.stat(follow_symlinks=False).st_size
                except OSError:
                    # Une entrée précise illisible (permissions, lien
                    # symbolique cassé) ne doit pas faire échouer tout le
                    # calcul -- elle est simplement ignorée, comme un
                    # fichier de taille nulle.
                    continue
    except OSError as e:
        log.warning(f"_calculer_taille_dossier_octets('{chemin_dossier}') : dossier illisible ({e!r}).")
        return None
    return total


def _construire_arborescence_stockage(objets: list) -> str:
    """Reconstruit un affichage d'arborescence textuelle (├──/└──) à
    partir d'une liste PLATE d'objets S3/B2 (ex. {"cle": "App/AutoniaX.py",
    "taille_octets": 2701399}) -- PATCH (demande explicite utilisateur :
    "l'affichage de l'arborescence du cloud", avec un exemple précis de
    format fourni : "├── inpainting/", "└── .lama_preview/", etc.), puis
    PATCH ultérieur (demande explicite utilisateur : "affiche la taille
    des fichier py a cote de eu" -- affichage réservé aux ".py",
    pas à tous les fichiers, pour ne pas surcharger l'arborescence avec
    des tailles peu utiles sur les captures/profils).

    Accepte aussi une liste de simples chaînes (rétrocompatibilité --
    ancien format "cles" d'un serveurT sans le PATCH taille, ou tout
    appelant existant qui passerait encore des str) : chaque chaîne est
    alors traitée comme {"cle": chaîne, "taille_octets": None}.

    B2 (comme tout stockage S3-compatible, cf. GestionnaireStockage.
    lister()) n'a PAS de vrais dossiers : une clé comme
    "App/sous_dossier/fichier.png" est une seule chaîne opaque, le
    serveurT ne renvoie que la liste plate (cf. serveur.py,
    "lister_stockage"). Cette fonction regroupe les clés par préfixes
    communs (tout ce qui précède chaque "/") pour reconstruire l'arbre
    -- uniquement une reconstruction d'AFFICHAGE, aucune notion de
    dossier n'existe réellement côté bucket.

    Regroupement des longues séries de fichiers "numérotés" similaires
    (cf. l'exemple utilisateur : "001_00-00-00_000ms.png … x381") --
    reconnu ici par un préfixe commun avant le premier "_" ou chiffre
    suivi d'un nom de fichier très répété au même niveau : au-delà de
    SEUIL_REGROUPEMENT fichiers consécutifs au même niveau partageant la
    même extension, seul le premier est affiché suivi de "… x<N>". Une
    série n'affiche jamais de taille individuelle (regroupée par
    nature), y compris pour une éventuelle série de ".py"."""
    SEUIL_REGROUPEMENT = 4

    if not objets:
        return "(bucket vide)"

    # Normalisation -- accepte des str (ancien format) ou des dicts
    # {"cle": ..., "taille_octets": ...} indifféremment.
    objets_normalises = [
        {"cle": o, "taille_octets": None} if isinstance(o, str) else o
        for o in objets
    ]

    # Construction d'un arbre {nom: {enfants...}} à partir des chemins
    # "a/b/c" -- une feuille (fichier) est un enfant dont la valeur est
    # sa taille_octets (int) ou None si inconnue, un noeud (dossier
    # reconstruit) a un dict comme valeur.
    racine: dict = {}
    for objet in sorted(objets_normalises, key=lambda o: o["cle"]):
        segments = [s for s in objet["cle"].split("/") if s]
        noeud = racine
        for i, segment in enumerate(segments):
            est_feuille = (i == len(segments) - 1)
            if est_feuille:
                noeud[segment] = ("__feuille__", objet.get("taille_octets"))
            else:
                noeud = noeud.setdefault(segment, {})

    def _est_feuille(contenu) -> bool:
        return isinstance(contenu, tuple) and contenu[0] == "__feuille__"

    def _extension(nom: str) -> str:
        return nom.rsplit(".", 1)[-1] if "." in nom else ""

    def _rendre(noeud: dict, prefixe: str, lignes: list):
        items = sorted(noeud.items(), key=lambda kv: (not _est_feuille(kv[1]), kv[0]))
        i = 0
        while i < len(items):
            nom, contenu = items[i]
            est_dernier_a_ce_niveau = (i == len(items) - 1)
            branche = "└── " if est_dernier_a_ce_niveau else "├── "

            if not _est_feuille(contenu):
                # Dossier reconstruit -- descend récursivement.
                lignes.append(f"{prefixe}{branche}{nom}/")
                sous_prefixe = prefixe + ("    " if est_dernier_a_ce_niveau else "│   ")
                _rendre(contenu, sous_prefixe, lignes)
                i += 1
                continue

            # Fichier -- regroupe une éventuelle série de fichiers
            # consécutifs partageant la même extension (cf. docstring,
            # "x381" dans l'exemple utilisateur).
            ext = _extension(nom)
            j = i
            while j < len(items) and _est_feuille(items[j][1]) and _extension(items[j][0]) == ext:
                j += 1
            taille_serie = j - i

            if taille_serie >= SEUIL_REGROUPEMENT:
                dernier_nom = items[j - 1][0]
                est_dernier_a_ce_niveau = (j == len(items))
                branche = "└── " if est_dernier_a_ce_niveau else "├── "
                lignes.append(f"{prefixe}{branche}{nom} … {dernier_nom}  x{taille_serie}")
                i = j
            else:
                # PATCH taille -- uniquement pour les .py, et seulement
                # si le serveurT a bien renvoyé une taille (repli
                # rétrocompatible sinon, cf. docstring).
                taille_octets = contenu[1]
                if ext == "py" and taille_octets is not None:
                    lignes.append(f"{prefixe}{branche}{nom}  ({_formater_taille_octets_mo(taille_octets)})")
                else:
                    lignes.append(f"{prefixe}{branche}{nom}")
                i += 1

    lignes: list = []
    _rendre(racine, "", lignes)
    return "\n".join(lignes)


def _construire_noeuds_arborescence_stockage(objets: list) -> list:
    """Sœur structurée de _construire_arborescence_stockage (PATCH --
    demande explicite utilisateur : "dans le sous-onglet stockage
    cloud ... on puisse désormais supprimer un élément directement,
    clic droit et supprimer", PUIS PATCH (demande explicite
    utilisateur : "je veux aussi que même les dossiers puissent
    supprimer") -- un dossier reconstruit ou une série groupée
    représentent PLUSIEURS clés S3, pas une seule, d'où "cles" (liste,
    jamais vide pour un noeud réellement présent dans l'arbre) plutôt
    que l'ancien "cle" singulier). Reconstruit le MÊME arbre à partir
    de la liste plate d'objets S3/B2, avec le MÊME regroupement de
    séries de fichiers numérotés (cf. docstring de _construire_
    arborescence_stockage pour le détail), mais renvoie une structure
    de noeuds exploitable pour peupler un QTreeWidget plutôt que du
    texte brut -- nécessaire pour qu'un clic droit sur UNE ligne
    (fichier, série groupée OU dossier) puisse retrouver TOUTES les
    clés S3 à supprimer pour cette ligne (le texte brut ├──/└── n'offre
    aucun moyen fiable de retrouver la/les clé(s) d'origine depuis une
    ligne affichée).

    Renvoie une liste de dicts récursifs :
    {"libelle": str,           # texte affiché sur cette ligne
     "cles": list[str],        # TOUTES les clés S3 supprimées par un
                                #   "Supprimer" sur cette ligne -- une
                                #   seule pour un fichier individuel,
                                #   plusieurs pour un dossier reconstruit
                                #   ou une série groupée (toujours non
                                #   vide pour un noeud produit ici)
     "enfants": list}          # sous-noeuds (vide pour une feuille)
    """
    SEUIL_REGROUPEMENT = 4

    if not objets:
        return []

    objets_normalises = [
        {"cle": o, "taille_octets": None} if isinstance(o, str) else o
        for o in objets
    ]

    # Même construction d'arbre intermédiaire que _construire_
    # arborescence_stockage, mais la feuille porte ici la clé S3
    # complète EN PLUS de la taille (nécessaire pour la suppression).
    racine: dict = {}
    for objet in sorted(objets_normalises, key=lambda o: o["cle"]):
        segments = [s for s in objet["cle"].split("/") if s]
        noeud = racine
        for i, segment in enumerate(segments):
            est_feuille = (i == len(segments) - 1)
            if est_feuille:
                noeud[segment] = ("__feuille__", objet.get("taille_octets"), objet["cle"])
            else:
                noeud = noeud.setdefault(segment, {})

    def _est_feuille(contenu) -> bool:
        return isinstance(contenu, tuple) and contenu[0] == "__feuille__"

    def _extension(nom: str) -> str:
        return nom.rsplit(".", 1)[-1] if "." in nom else ""

    def _toutes_les_cles(contenu) -> list:
        """Collecte récursivement TOUTES les clés S3 sous un noeud
        (feuille -> une seule clé, dossier -> toutes ses feuilles
        descendantes) -- utilisé pour qu'un dossier reconstruit porte
        la liste complète de ce qu'un "Supprimer" sur lui doit
        effacer."""
        if _est_feuille(contenu):
            return [contenu[2]]
        cles = []
        for sous_contenu in contenu.values():
            cles.extend(_toutes_les_cles(sous_contenu))
        return cles

    def _rendre(noeud: dict) -> list:
        items = sorted(noeud.items(), key=lambda kv: (not _est_feuille(kv[1]), kv[0]))
        resultats = []
        i = 0
        while i < len(items):
            nom, contenu = items[i]

            if not _est_feuille(contenu):
                resultats.append({
                    "libelle": f"{nom}/",
                    "cles": _toutes_les_cles(contenu),
                    "enfants": _rendre(contenu),
                })
                i += 1
                continue

            ext = _extension(nom)
            j = i
            while j < len(items) and _est_feuille(items[j][1]) and _extension(items[j][0]) == ext:
                j += 1
            taille_serie = j - i

            if taille_serie >= SEUIL_REGROUPEMENT:
                dernier_nom = items[j - 1][0]
                cles_serie = [items[k][1][2] for k in range(i, j)]
                resultats.append({
                    "libelle": f"{nom} … {dernier_nom}  x{taille_serie}",
                    "cles": cles_serie,
                    "enfants": [],
                })
                i = j
            else:
                taille_octets = contenu[1]
                cle_s3 = contenu[2]
                if ext == "py" and taille_octets is not None:
                    libelle = f"{nom}  ({_formater_taille_octets_mo(taille_octets)})"
                else:
                    libelle = nom
                resultats.append({"libelle": libelle, "cles": [cle_s3], "enfants": []})
                i += 1
        return resultats

    return _rendre(racine)


class MiseAJourStockageScreen(QWidget):
    """Sous-onglet "Mise à jour Système" de StockageScreen (PATCH D --
    cf. cahier des charges patchs.md, section D : renommage "Mise à
    jour" -> "Mise à jour Système", ET remplacement du bouton global +
    cases à cocher par TROIS boutons indépendants, un par élément
    (AutoniaX.py / mouseData.sqlite3 / service_api.zip) -- chaque
    élément part maintenant séparément, sur son propre clic, plus de
    combinaison possible entre eux.

    Émet demande_mise_a_jour_app(str) quand l'utilisateur clique sur
    l'un des trois boutons -- la chaîne vaut "autoniax", "mouse_data" ou
    "service_api" (cf. ClientServeurT.envoyer_mise_a_jour_app, qui
    n'accepte plus qu'UN SEUL élément par appel depuis ce patch).
    StockageScreen relaie ce signal tel quel vers MainWindow, qui le
    connecte à ClientServeurT.envoyer_mise_a_jour_app (les chemins des
    3 éléments étant résolus côté MainWindow, cet écran ne connaît
    aucun chemin réel -- get_mouse_data_path()/get_service_api_dir()).

    PATCH (upload fiabilisé -- protocole en chunks avec retry+pause,
    cf. TransfertMiseAJourEnCours côté ClientServeurT) : ajout d'une
    vraie barre de progression (même patron que ProfilsCloudScreen.
    barre_progression_profil) et d'un bouton "Reprendre" qui n'apparaît
    QUE lorsqu'un transfert est en pause (cf. sur_pause_mise_a_jour_app)
    -- émet demande_reprise_mise_a_jour_app() sur clic, relayé jusqu'à
    ClientServeurT.reprendre_mise_a_jour_app."""

    demande_mise_a_jour_app = Signal(str)
    # PATCH (upload fiabilisé) -- émis sur clic du bouton "Reprendre",
    # aucun paramètre : un seul transfert peut être en pause à la fois
    # (cf. docstring TransfertMiseAJourEnCours, "un seul à la fois"),
    # inutile de préciser lequel.
    demande_reprise_mise_a_jour_app = Signal()

    def __init__(self, parent=None):
        super().__init__(parent)

        layout = QVBoxLayout(self)
        layout.setContentsMargins(24, 20, 24, 20)
        layout.setSpacing(8)
        layout.setAlignment(Qt.AlignTop)

        label_maj = QLabel(
            "Envoie individuellement chaque élément vers le dossier "
            "App/ du bucket configuré dans l'onglet Identifiant :", self)
        label_maj.setObjectName("ReglagesLabel")
        label_maj.setWordWrap(True)
        layout.addWidget(label_maj)

        # PATCH D -- trois boutons indépendants, un par élément, au lieu
        # de l'ancien bouton unique + deux cases à cocher (AutoniaX.py
        # partait toujours, mouseData/service API étaient optionnels et
        # combinables). Même style que l'ancien bouton_maj_app, aucune
        # règle QSS nouvelle.
        self.bouton_maj_autoniax = QPushButton("Mettre à jour AutoniaX.py", self)
        self.bouton_maj_autoniax.setCursor(Qt.PointingHandCursor)
        self.bouton_maj_autoniax.clicked.connect(
            lambda: self.demande_mise_a_jour_app.emit("autoniax")
        )
        layout.addWidget(self.bouton_maj_autoniax)

        self.bouton_maj_mouse_data = QPushButton("Mettre à jour mouseData.sqlite3", self)
        self.bouton_maj_mouse_data.setCursor(Qt.PointingHandCursor)
        self.bouton_maj_mouse_data.clicked.connect(
            lambda: self.demande_mise_a_jour_app.emit("mouse_data")
        )
        layout.addWidget(self.bouton_maj_mouse_data)

        self.bouton_maj_service_api = QPushButton("Mettre à jour le dossier service API", self)
        self.bouton_maj_service_api.setCursor(Qt.PointingHandCursor)
        self.bouton_maj_service_api.clicked.connect(
            lambda: self.demande_mise_a_jour_app.emit("service_api")
        )
        layout.addWidget(self.bouton_maj_service_api)

        # AJOUT (project.json sur B2 -- retour explicite utilisateur :
        # "je coris uqe projetjson doit donc faire partir des ficher a
        # stocker sur le cloud", suite au bug .visible()/AttributeError où
        # sAutoniax n'avait jamais accès aux métadonnées Composant --
        # nom, seuil de confiance, zone de clic... -- qui vivent
        # exclusivement dans project.json, cf. docstring de la classe
        # Project) -- MÊME PATRON EXACT que les 3 boutons ci-dessus, un
        # 4e élément indépendant "project", résolu côté MainWindow via
        # get_project_json_path().
        self.bouton_maj_project = QPushButton("Mettre à jour project.json", self)
        self.bouton_maj_project.setCursor(Qt.PointingHandCursor)
        self.bouton_maj_project.clicked.connect(
            lambda: self.demande_mise_a_jour_app.emit("project")
        )
        layout.addWidget(self.bouton_maj_project)

        # PATCH (upload fiabilisé) -- même patron exact que
        # ProfilsCloudScreen.barre_progression_profil : masquée par
        # défaut, mode indéterminé (setRange(0, 0)) pendant l'attente de
        # l'accusé mettre_a_jour_app_debut, puis 0-100 réel chunk par
        # chunk (cf. sur_progression_mise_a_jour_app).
        self.barre_progression_maj = QProgressBar(self)
        self.barre_progression_maj.setObjectName("MiseAJourAppProgress")
        self.barre_progression_maj.setRange(0, 100)
        self.barre_progression_maj.setValue(0)
        self.barre_progression_maj.setTextVisible(True)
        self.barre_progression_maj.setVisible(False)
        layout.addWidget(self.barre_progression_maj)

        self.label_statut_maj = QLabel("", self)
        self.label_statut_maj.setWordWrap(True)
        self.label_statut_maj.setObjectName("PlaceholderSubtitle")
        layout.addWidget(self.label_statut_maj)

        # PATCH (upload fiabilisé) -- caché tant qu'aucun transfert
        # n'est en pause (cf. sur_pause_mise_a_jour_app qui le révèle,
        # et sur_resultat_mise_a_jour_app/sur_progression_mise_a_jour_app
        # qui le recachent dès qu'un nouveau transfert progresse ou
        # aboutit). "pause d'abord" -- ce bouton est le SEUL moyen de
        # relancer un transfert en pause, jamais automatique.
        self.bouton_reprendre_maj = QPushButton("Reprendre l'envoi interrompu", self)
        self.bouton_reprendre_maj.setCursor(Qt.PointingHandCursor)
        self.bouton_reprendre_maj.clicked.connect(self._sur_clic_reprendre)
        self.bouton_reprendre_maj.setVisible(False)
        layout.addWidget(self.bouton_reprendre_maj)

        layout.addStretch(1)

        # PATCH (Patch 4.3 -- onglet Profils Cloud) : le second bloc
        # "Envoyer un profil" (menu déroulant + bouton + barre de
        # progression) qui vivait ici a été DÉPLACÉ vers ProfilsCloud
        # Screen (cf. sa docstring de classe) -- c'est sa vraie place
        # fonctionnelle. Cet écran ne garde donc que les 3 boutons
        # ci-dessus (+ barre de progression et bouton Reprendre, ajoutés
        # par le patch upload fiabilisé).

    def _sur_clic_reprendre(self):
        self.bouton_reprendre_maj.setVisible(False)
        self.label_statut_maj.setText("Reprise de l'envoi...")
        self.demande_reprise_mise_a_jour_app.emit()

    def sur_resultat_mise_a_jour_app(self, ok: bool, nom_fichier: str, message: str):
        """Connecté par MainWindow à ClientServeurT.mise_a_jour_app_
        resultat -- appelé une fois par élément envoyé, à la toute fin
        du transfert (succès ou échec DÉFINITIF, cf. distinction avec
        sur_pause_mise_a_jour_app ci-dessous qui gère le cas
        intermédiaire "en pause, pas encore résolu"). Écrase le texte
        précédent plutôt que de l'accumuler : seul le tout dernier
        résultat reçu reste visible, avec le nom du fichier concerné
        pour lever toute ambiguïté sur lequel des trois boutons a
        réussi ou échoué en dernier (inchangé depuis avant le patch D,
        toujours valable maintenant que les 3 envois sont déclenchés
        indépendamment plutôt qu'enchaînés)."""
        self.barre_progression_maj.setVisible(False)
        self.bouton_reprendre_maj.setVisible(False)
        if ok:
            self.label_statut_maj.setText(f"{nom_fichier} envoyé avec succès.")
        else:
            self.label_statut_maj.setText(f"Échec pour {nom_fichier} : {message}")

    def sur_progression_mise_a_jour_app(self, nom_fichier: str, pourcentage: int):
        """Connecté par MainWindow à ClientServeurT.mise_a_jour_app_
        progression -- même patron exact que ProfilsCloudScreen.
        sur_progression_envoi_profil. pourcentage=-1 (convention
        "indéterminé") le temps de l'accusé mettre_a_jour_app_debut,
        puis 0-100 réel après chaque chunk confirmé."""
        self.bouton_reprendre_maj.setVisible(False)
        self.barre_progression_maj.setVisible(True)
        if pourcentage < 0:
            self.barre_progression_maj.setRange(0, 0)
        else:
            self.barre_progression_maj.setRange(0, 100)
            self.barre_progression_maj.setValue(pourcentage)
        self.label_statut_maj.setText(f"Envoi de {nom_fichier} en cours...")

    def sur_pause_mise_a_jour_app(self, nom_fichier: str, raison: str):
        """Connecté par MainWindow à ClientServeurT.mise_a_jour_app_
        pause -- cf. docstring du signal (pause après 3 tentatives
        épuisées sur un chunk, ou coupure de connexion en plein
        transfert). Contrairement à sur_resultat_mise_a_jour_app(False,
        ...), CE N'EST PAS un échec définitif : la progression déjà
        faite reste visible (barre non masquée) et le bouton "Reprendre"
        apparaît pour relancer explicitement depuis le chunk mémorisé
        (cf. ClientServeurT.reprendre_mise_a_jour_app)."""
        self.label_statut_maj.setText(f"Envoi de {nom_fichier} en pause : {raison}")
        self.bouton_reprendre_maj.setVisible(True)


class StockageCloudScreen(QWidget):
    """Sous-onglet "Stockage cloud" de StockageScreen (PATCH -- demande
    explicite utilisateur : "je veux que dans l'onglet de stockage tu
    vas rajouter un autre sous onglet: stokage cloud, et il yaura
    l'affichage de l'arborescence du cloud ... tu vas mettre un bouton
    update pour rafraîchir cette arborescence").

    PATCH (demande explicite utilisateur : "dans le sous-onglet
    stockage cloud, je veux que on puisse désormais supprimer un
    élément directement, clic droit et supprimer, dans l'avenir je
    vais rajouter d'autres opérations manuels") -- l'arborescence, à
    l'origine un simple texte brut en lecture seule (choix initial
    utilisateur : "texte simple, comme ton exemple avec ├── etc."),
    est reconstruite ici en QTreeWidget : chaque ligne reste un noeud
    cliquable (dossier reconstruit, série groupée, ou fichier
    individuel). L'apparence visuelle (indentation ├──/└──, police à
    chasse fixe, taille des .py) est conservée à l'identique malgré le
    changement de widget -- seul le mécanisme d'affichage change, pas
    le rendu. Entièrement dépliée dès le chargement (expandAll, cf.
    _peupler_item) -- PATCH (demande explicite utilisateur : "je veux
    que sa affiche directement tout deplier, je ne veux pas redeplier
    moi meme").

    PATCH (demande explicite utilisateur : "je veux aussi que même les
    dossiers puissent supprimer") -- clic droit sur N'IMPORTE QUEL
    noeud (fichier individuel, série groupée, OU dossier reconstruit)
    propose "Supprimer", qui efface TOUTES les clés S3 sous ce noeud
    d'un coup (cf. _construire_noeuds_arborescence_stockage, "cles").

    Émet demande_liste_stockage() au clic sur "Actualiser" ET à la
    première apparition du widget (showEvent, cf. plus bas) -- une
    apparition automatique évite d'atterrir sur une zone vide tant que
    l'utilisateur n'a pas pensé à cliquer sur Actualiser. Émet
    demande_suppression_stockage(list) au clic sur "Supprimer" du menu
    contextuel, après confirmation utilisateur (cf. _sur_clic_
    supprimer) -- TOUJOURS une liste de clés, même pour un seul
    fichier (une seule clé dans la liste), pour ne pas dupliquer le
    protocole réseau entre "un élément" et "plusieurs éléments".
    StockageScreen relaie ces deux signaux vers MainWindow, qui les
    connecte à ClientServeurT.demander_liste_stockage /
    demander_suppression_stockage."""

    demande_liste_stockage = Signal()
    demande_suppression_stockage = Signal(list)  # liste de clés S3 complètes

    def __init__(self, parent=None):
        super().__init__(parent)
        self._deja_charge_une_fois = False
        # Dernière liste brute reçue (cf. sur_resultat_liste_stockage)
        # -- gardée pour reconstruire le texte du bouton "Copier" sans
        # dépendre du contenu du widget, et pour retirer localement une
        # ligne supprimée sans re-solliciter le serveurT (cf.
        # sur_resultat_suppression_stockage).
        self._derniers_objets: list = []

        layout = QVBoxLayout(self)
        layout.setContentsMargins(24, 20, 24, 20)
        layout.setSpacing(8)

        ligne_haut = QHBoxLayout()
        label_intro = QLabel(
            "Arborescence actuelle du bucket (reconstruite à partir des "
            "clés stockées -- B2 n'a pas de vrais dossiers). Clic droit "
            "sur un fichier pour le supprimer :", self)
        label_intro.setObjectName("ReglagesLabel")
        label_intro.setWordWrap(True)
        ligne_haut.addWidget(label_intro, stretch=1)

        self.bouton_actualiser = QPushButton("Actualiser", self)
        self.bouton_actualiser.setCursor(Qt.PointingHandCursor)
        self.bouton_actualiser.clicked.connect(self.demande_liste_stockage)
        ligne_haut.addWidget(self.bouton_actualiser, stretch=0)

        # PATCH -- bouton "Copier" à côté d'"Actualiser" : copie le texte
        # brut de l'arborescence (reconstruit depuis _derniers_objets,
        # même rendu que _construire_arborescence_stockage) dans le
        # presse-papier système (QGuiApplication.clipboard(), même
        # pattern que partout ailleurs dans le fichier), pour pouvoir la
        # coller ailleurs (ex. un rapport, un message).
        self.bouton_copier_arborescence = QPushButton("Copier", self)
        self.bouton_copier_arborescence.setCursor(Qt.PointingHandCursor)
        self.bouton_copier_arborescence.clicked.connect(self._sur_clic_copier_arborescence)
        ligne_haut.addWidget(self.bouton_copier_arborescence, stretch=0)

        layout.addLayout(ligne_haut)

        # PATCH -- QTreeWidget remplace l'ancien QPlainTextEdit en
        # lecture seule : nécessaire pour qu'une ligne soit cliquable
        # individuellement (clic droit -> Supprimer). Une seule colonne
        # sans en-tête, l'indentation native de QTreeWidget (flèches
        # d'expansion) remplace visuellement les caractères ├──/└── du
        # rendu texte -- même lisibilité de la hiérarchie, en plus
        # interactif (pliable/dépliable).
        self.arbre = QTreeWidget(self)
        self.arbre.setObjectName("StockageArborescence")
        self.arbre.setHeaderHidden(True)
        self.arbre.setColumnCount(1)
        self.arbre.setContextMenuPolicy(Qt.CustomContextMenu)
        self.arbre.customContextMenuRequested.connect(self._afficher_menu_arborescence)
        # Police à chasse fixe -- conservée du rendu texte d'origine,
        # cohérence visuelle avec le reste de l'app pour ce type de
        # contenu technique (chemins, noms de fichiers).
        police_fixe = QFont("Consolas")
        police_fixe.setStyleHint(QFont.Monospace)
        police_fixe.setPointSize(10)
        self.arbre.setFont(police_fixe)
        layout.addWidget(self.arbre, stretch=1)

        self._item_placeholder = QTreeWidgetItem(["(clique sur Actualiser pour charger l'arborescence)"])
        self._item_placeholder.setFlags(Qt.ItemIsEnabled)
        self.arbre.addTopLevelItem(self._item_placeholder)

        self.label_statut = QLabel("", self)
        self.label_statut.setWordWrap(True)
        self.label_statut.setObjectName("PlaceholderSubtitle")
        layout.addWidget(self.label_statut)

    # PATCH (retour utilisateur explicite : "jespere queil yaplus ce
    # genre bugs visuesls dansle code") -- même correctif que
    # PanneauProprietesSautoniax._afficher_statut_temporaire (cf. sa
    # docstring pour le détail complet), appliqué UNIQUEMENT aux
    # messages ponctuels de confirmation/échec ci-dessous -- PAS au
    # décompte "N élément(s) au total." (sur_resultat_liste_stockage,
    # succès), qui reste un état permanent tant que l'arborescence n'a
    # pas changé, ni à "... en cours..." (état intermédiaire).
    DUREE_AFFICHAGE_STATUT_MS = 4000

    def _afficher_statut_temporaire(self, texte: str):
        self.label_statut.setText(texte)
        QTimer.singleShot(
            self.DUREE_AFFICHAGE_STATUT_MS,
            lambda: self.label_statut.setText("") if self.label_statut.text() == texte else None,
        )

    def showEvent(self, event):
        """Charge automatiquement l'arborescence la toute première fois
        que cet onglet devient visible (premier clic sur "Stockage
        cloud"), pour éviter d'atterrir sur un texte de placeholder tant
        que l'utilisateur n'a pas pensé à cliquer sur Actualiser --
        seulement la première fois, pour ne pas re-solliciter le
        serveurT à chaque va-et-vient entre onglets."""
        super().showEvent(event)
        if not self._deja_charge_une_fois:
            self._deja_charge_une_fois = True
            self.demande_liste_stockage.emit()

    def _peupler_item(self, item_parent, noeuds: list):
        """Remplit récursivement item_parent (un QTreeWidgetItem ou
        self.arbre lui-même pour la racine) à partir de la structure
        renvoyée par _construire_noeuds_arborescence_stockage. La liste
        de clés S3 du noeud est stockée sur Qt.UserRole de chaque item
        -- c'est elle que _afficher_menu_arborescence relit pour savoir
        quoi supprimer (une seule clé pour un fichier, plusieurs pour
        un dossier ou une série groupée)."""
        for noeud in noeuds:
            item = QTreeWidgetItem([noeud["libelle"]])
            item.setData(0, Qt.UserRole, noeud["cles"])
            if isinstance(item_parent, QTreeWidget):
                item_parent.addTopLevelItem(item)
            else:
                item_parent.addChild(item)
            if noeud["enfants"]:
                self._peupler_item(item, noeud["enfants"])

    def _rafraichir_arbre(self, objets: list):
        """Vide et repeuple entièrement self.arbre à partir d'une liste
        d'objets S3/B2, puis déplie tout (PATCH -- demande explicite
        utilisateur : "je veux que sa affiche directement tout deplier,
        je ne veux pas redeplier moi meme"). Factorisé ici -- appelé à
        la fois par sur_resultat_liste_stockage (chargement complet) et
        sur_resultat_suppression_stockage (retrait local après succès),
        qui faisaient auparavant chacun leur propre clear()+peuplement
        dupliqué sans expandAll()."""
        self.arbre.clear()
        noeuds = _construire_noeuds_arborescence_stockage(objets)
        if noeuds:
            self._peupler_item(self.arbre, noeuds)
            self.arbre.expandAll()
        else:
            item_vide = QTreeWidgetItem(["(bucket vide)"])
            item_vide.setFlags(Qt.ItemIsEnabled)
            self.arbre.addTopLevelItem(item_vide)

    def sur_resultat_liste_stockage(self, ok: bool, objets: list, message: str):
        """Connecté par MainWindow à ClientServeurT.stockage_liste_
        resultat -- reconstruit et affiche l'arborescence si ok=True,
        sinon affiche l'erreur (ex. stockage non configuré, pas
        connecté). "objets" : liste de {"cle": ..., "taille_octets": ...}
        (PATCH taille -- cf. _construire_noeuds_arborescence_stockage,
        qui affiche la taille à côté de chaque .py, même logique que
        l'ancien rendu texte)."""
        if ok:
            self._derniers_objets = objets
            self._rafraichir_arbre(objets)
            self.label_statut.setText(f"{len(objets)} élément(s) au total.")
        else:
            self._afficher_statut_temporaire(f"Échec du chargement : {message}")

    def _afficher_menu_arborescence(self, position):
        """Menu contextuel clic droit sur l'arbre -- PATCH (demande
        explicite utilisateur : "clic droit et supprimer", PUIS "je
        veux aussi que même les dossiers puissent supprimer"). Propose
        "Supprimer" sur N'IMPORTE QUEL noeud (fichier individuel,
        série groupée, OU dossier reconstruit) -- chaque noeud porte
        désormais la liste complète de ses clés S3 descendantes (cf.
        _construire_noeuds_arborescence_stockage), donc "Supprimer" sur
        un dossier efface tout son contenu d'un coup. Structure du menu
        prête à accueillir d'autres actions plus tard (cf. demande
        utilisateur : "dans l'avenir je vais rajouter d'autres
        opérations manuels")."""
        item = self.arbre.itemAt(position)
        if item is None:
            return
        cles = item.data(0, Qt.UserRole) or []
        if not cles:
            return
        self.arbre.setCurrentItem(item)

        libelle_action = "Supprimer" if len(cles) == 1 else f"Supprimer ({len(cles)} éléments)"
        menu = QMenu(self)
        action_supprimer = menu.addAction(
            qta.icon("mdi6.trash-can-outline", color=Mocha.red), libelle_action
        )
        action_supprimer.triggered.connect(lambda: self._sur_clic_supprimer(cles, item.text(0)))
        menu.exec(self.arbre.viewport().mapToGlobal(position))

    def _sur_clic_supprimer(self, cles: list, libelle_affiche: str):
        """Suite du clic sur "Supprimer" du menu contextuel -- demande
        confirmation (action destructrice et irréversible sur le
        bucket, même prudence que _on_clic_supprimer_profil pour les
        profils locaux) avant d'émettre demande_suppression_stockage.
        Le texte de confirmation distingue explicitement le cas "un
        seul fichier" du cas "dossier/série -> N fichiers" pour que la
        portée réelle de l'action soit claire avant de valider."""
        box = BoiteDialogueAutoniaX.question(
            self,
            "Supprimer du stockage cloud",
            (
                f"Supprimer définitivement « {libelle_affiche} » du bucket ?"
                if len(cles) == 1
                else f"Supprimer définitivement « {libelle_affiche} » du bucket, "
                f"soit {len(cles)} élément(s) ?"
            ),
            texte_oui="Oui",
            texte_non="Annuler",
            texte_informatif="Cette action est irréversible.",
        )
        if not box:
            return
        self.label_statut.setText(f"Suppression de « {libelle_affiche} » en cours...")
        self.demande_suppression_stockage.emit(cles)

    def sur_resultat_suppression_stockage(self, ok: bool, cles: list, message: str):
        """Connecté par MainWindow à ClientServeurT.stockage_supprimer_
        resultat. Sur succès, retire TOUTES les clés supprimées de
        _derniers_objets et recharge l'arbre à partir de cette liste en
        mémoire -- pas de nouvel appel demande_liste_stockage (les
        éléments viennent déjà d'être retirés côté serveur avec
        certitude, inutile de re-solliciter le serveurT juste pour
        rafraîchir l'affichage)."""
        if ok:
            cles_supprimees = set(cles)
            self._derniers_objets = [
                o for o in self._derniers_objets if o.get("cle") not in cles_supprimees
            ]
            self._rafraichir_arbre(self._derniers_objets)
            if len(cles) == 1:
                self._afficher_statut_temporaire(
                    f"« {cles[0]} » supprimé. {len(self._derniers_objets)} élément(s) restant(s)."
                )
            else:
                self._afficher_statut_temporaire(
                    f"{len(cles)} élément(s) supprimé(s). {len(self._derniers_objets)} élément(s) restant(s)."
                )
        else:
            self._afficher_statut_temporaire(f"Échec de la suppression : {message}")

    def _sur_clic_copier_arborescence(self):
        """Bouton "Copier" -- reconstruit le texte brut de l'arborescence
        (même rendu que _construire_arborescence_stockage) à partir de
        _derniers_objets et le copie dans le presse-papier système.
        Refuse silencieusement (juste un message de statut) si aucune
        liste n'a encore été chargée, plutôt que de copier du texte
        inutile."""
        if not self._derniers_objets:
            self._afficher_statut_temporaire("Rien à copier -- actualise d'abord l'arborescence.")
            return
        texte = _construire_arborescence_stockage(self._derniers_objets)
        QGuiApplication.clipboard().setText(texte)
        self._afficher_statut_temporaire("Arborescence copiée dans le presse-papier.")


class ProfilsCloudScreen(QWidget):
    """Onglet "Profils Cloud" de ReseauScreen (PATCH -- Patch 4.3 de la
    spec réseau). Absorbe/remplace le second bloc "Envoyer un profil"
    qui vivait auparavant dans MiseAJourStockageScreen (sous-onglet
    "Mise à jour" de "Stockage") -- déplacé ici car c'est sa vraie place
    fonctionnelle (cf. spec §4.3 : "ce bloc est déplacé ici car c'est sa
    vraie place fonctionnelle").

    Contenu :
    - Table des profils présents dans Profils/ du cloud (nom, date
      de dernière mise à jour, badges proxy/pays, dernière exécution
      connue), construite à partir de deux sources combinées :
      1. demander_liste_stockage (même signal que StockageCloudScreen,
         réutilisé tel quel -- PAS de nouveau message serveur dédié,
         cf. décision actée : le serveurT ne fait "aucune logique
         métier AutoniaX", cf. serveur.py) : liste brute des clés,
         filtrée ici côté client sur le préfixe "Profils/".
      2. Pour chaque "<nom>.meta.json" présent dans cette même liste
         (PATCH -- écrit par le serveur au moment de l'envoi, cf.
         ClientServeurT._envoyer_profil/serveur.py envoyer_profil_fin),
         son contenu est téléchargé (telecharger_fichier, protocole
         générique déjà existant) et parsé pour peupler les badges
         (proxy configuré, pays) -- absent ou invalide pour un profil
         envoyé AVANT ce patch : la ligne reste affichée avec des
         badges "inconnu", jamais une ligne manquante ou une erreur qui
         bloquerait tout le tableau.
    - NOTE : le bouton "Envoyer un profil local vers le cloud" qui
      vivait ici a été RETIRÉ (demande explicite utilisateur, capture
      d'écran à l'appui) -- il fait désormais doublon avec le bloc
      identique déjà présent dans l'onglet "Profils Local"
      (ProfilsLocalScreen), seul endroit où cet envoi doit apparaître.
    - Bouton "Actualiser" : réémet demande_liste_stockage, même esprit
      que StockageCloudScreen.demande_liste_stockage.

    Dernière exécution connue : PAS câblée dans ce patch (aucune source
    de cette information n'existe encore côté protocole avant le Patch
    4.4 -- retour_projet_execute, cf. spec §4.9) -- colonne affichée
    dès maintenant ("--" par défaut) pour que la table n'ait pas besoin
    d'être restructurée plus tard, mais son contenu réel arrivera avec
    le patch qui introduit le suivi des projets distribués."""

    demande_liste_stockage = Signal()
    demande_liste_profils_locaux = Signal()
    # NOTE : demande_envoi_profil a été RETIRÉ d'ici -- ce signal
    # n'était émis que par le bloc "Envoyer un profil" désormais
    # supprimé de cet écran (cf. __init__ et docstring de classe
    # ci-dessus). ProfilsLocalScreen porte sa propre copie de ce
    # signal, inchangée -- c'est elle qui reste connectée à MainWindow.
    # Émis quand l'utilisateur clique sur "Actualiser" ou à la première
    # apparition -- MainWindow résout le contenu de chaque .meta.json
    # via telecharger_fichier (cet écran ne connaît pas ClientServeurT
    # directement, même séparation de responsabilités que le reste du
    # fichier : StockageScreen/ReseauScreen ne font que relayer des
    # signaux, jamais d'appel direct au client réseau).
    demande_telechargement_meta = Signal(str)  # cle B2 du .meta.json
    # PATCH (colonne "Badges", demande explicite utilisateur : "en cloud
    # ça persiste sur le cloud") -- (nom_profil, champ, valeur), émis au
    # clic sur un badge. MainWindow relaie tel quel à ClientServeurT.
    # demander_maj_meta_profil -- cet écran ne connaît pas ClientServeurT
    # directement, même séparation de responsabilités que demande_
    # telechargement_meta juste au-dessus.
    demande_maj_meta_profil = Signal(str, str, bool)
    # PATCH (extension "Envoyer vers un sAutoniax", demande explicite
    # utilisateur) -- (id_executant, nom_profil) : demande le
    # téléchargement d'UN profil cloud précis vers CE sAutoniax. Émis une
    # fois par profil coché, séquentiellement (cf. _sur_clic_envoyer_
    # vers_sautoniax / _envoyer_prochain_profil_sautoniax), jamais tous
    # d'un coup -- MainWindow relaie chaque appel à ClientServeurT.
    # demander_telecharger_profil_vers_sautoniax tel quel.
    demande_envoi_profil_vers_sautoniax = Signal(str, str)
    # Émis à la première apparition (même patron que demande_liste_
    # stockage/demande_liste_profils_locaux, cf. showEvent) : MainWindow
    # peuple immédiatement le combo avec les sAutoniax déjà connus (pas
    # de nouvel appel réseau, cf. InstancesConnecteesScreen.tous_ids_
    # executants_connectes déjà existant) -- reste ensuite à jour en
    # continu via definir_sautoniax_disponibles (cf. MainWindow, relayé
    # à chaque executants_detail_change, même liste que l'onglet
    # Instances).
    demande_liste_sautoniax_disponibles = Signal()
    # PATCH (boutons Renommer/Supprimer par ligne, demande explicite
    # utilisateur : "je veux que pour chaque profils tu met un bouton
    # de renommage, de suppression ... ce n'est qu'en appuyant sur le
    # bouton de mise à jour que les données sont sauvegardées et
    # appliquées sur le cloud") -- MÊME validation groupée que les
    # badges (cf. _modifications_en_attente) : renommer/supprimer ne
    # font QUE marquer une intention en mémoire locale, jamais d'envoi
    # immédiat -- seul le clic sur "Valider les modifications" les
    # applique réellement, cf. _sur_clic_valider_modifications.
    # (ancien_nom, nouveau_nom) : émis au clic sur "Valider" pour
    # chaque renommage en attente.
    demande_renommer_profil_cloud = Signal(str, str)
    # (liste de clés B2 : zip + meta.json) : émis au clic sur "Valider"
    # pour chaque suppression en attente -- réutilise TEL QUEL le
    # protocole générique demander_suppression_stockage déjà utilisé
    # par StockageCloudScreen (cf. serveur.py, handler supprimer_
    # stockage qui accepte déjà une liste de clés), aucun nouveau
    # message serveur nécessaire pour la suppression.
    demande_suppression_profil_cloud = Signal(list)
    # PATCH (pied de page réorganisé en onglets, demande explicite
    # utilisateur : "je veux aussi que on puisse telechargez en local
    # des profils qui sont sur le could") -- (nom_profil) : demande le
    # téléchargement d'UN profil cloud précis vers LE DISQUE LOCAL du
    # pilote (contrairement à demande_envoi_profil_vers_sautoniax
    # au-dessus, pas de destination à préciser -- toujours DOSSIER_
    # RACINE_PROFILS). Émis une fois par profil coché, séquentiellement
    # (même patron file d'attente que _envoyer_prochain_profil_
    # sautoniax) -- MainWindow télécharge le .zip via ClientServeurT.
    # telecharger_fichier (déjà générique, aucun nouveau message
    # serveur) puis le dézippe lui-même (shutil.unpack_archive), cet
    # écran ne fait ni accès disque ni accès réseau directement.
    demande_telechargement_local_profil = Signal(str)

    PREFIXE_CLOUD = "Profils/"

    def __init__(self, parent=None):
        super().__init__(parent)
        self._deja_charge_une_fois = False
        # nom_profil -> {"cle_zip", "taille_octets", "meta": dict|None,
        # "meta_en_attente": bool} -- reconstruit à CHAQUE résultat de
        # sur_resultat_liste_stockage (pas de fusion incrémentale : le
        # listing du bucket est toujours la source de vérité complète).
        self._profils_cloud: dict[str, dict] = {}
        self._filtre_badge = "tous"  # cf. combo_filtre : "tous"/"avec_proxy"/"sans_proxy"

        # PATCH (validation groupée des badges, demande explicite
        # utilisateur : "si je modifie un badges dasn linterface de
        # profils cloud, sa doit dabord modifier juste la stcuture en
        # local, apres il yauras un bouton mise a jour pour vraiment
        # modifie sur le cloud ... valider une mise a jour, global pour
        # tout les modifactions") -- {nom_profil: {champ: valeur}},
        # modifications cochées en attente de validation, PAS encore
        # envoyées au serveurT. Vidé profil par profil au fur et à mesure
        # que la file d'envoi (_file_validation_en_cours ci-dessous)
        # traite chaque changement avec succès -- cf. _sur_clic_valider_
        # modifications / sur_resultat_maj_meta_profil.
        self._modifications_en_attente: dict[str, dict[str, bool]] = {}
        # File d'attente séquentielle d'envoi de la validation groupée --
        # liste de tuples (nom_profil, champ, valeur), même patron que
        # ProfilsLocalScreen._file_profils_a_envoyer (un seul message
        # mettre_a_jour_meta_profil à la fois, réutilisé tel quel --
        # AUCUN nouveau message serveur nécessaire, cf. serveur.py qui
        # traite déjà ce message un champ à la fois).
        self._file_validation_en_cours: list = []
        self._nb_modifs_total_validation = 0
        self._nb_modifs_traitees_validation = 0

        # PATCH (boutons Renommer/Supprimer par ligne, demande explicite
        # utilisateur : "ce n'est qu'en appuyant sur le bouton de mise à
        # jour que les données sont sauvegardées") -- même principe que
        # _modifications_en_attente ci-dessus (mémoire locale seulement
        # jusqu'à validation), mais dans deux dicts séparés : un
        # renommage porte une VALEUR str (le nouveau nom), une
        # suppression un simple bool -- types différents de
        # _modifications_en_attente (qui ne porte que des bool de
        # badges), donc pas fusionnables dans le même dict sans
        # complexifier son typage. {nom_profil: nouveau_nom}.
        self._renommages_en_attente: dict[str, str] = {}
        # {nom_profil} -- ensemble des profils marqués pour suppression.
        self._suppressions_en_attente: set[str] = set()

        # PATCH (pied de page réorganisé en onglets -- bouton
        # "Télécharger en local") -- file d'attente séquentielle, MÊME
        # patron exact que self._sautoniax_file_profils_a_envoyer plus
        # bas (un seul téléchargement à la fois, cf. contrainte Future
        # partagée de ClientServeurT._telecharger_fichier).
        self._file_profils_a_telecharger_local: list = []
        self._telechargement_local_en_cours = False
        self._nb_profils_total_telechargement_local = 0
        self._nb_profils_traites_telechargement_local = 0

        # --- Cache drapeaux, même patron EXACT que ProfilsInstancesScreen
