def _url_fichier_documentation() -> str:
    """URL file:// de documentation.html, pour le lien "Documentation" du
    Dashboard (cf. contenu_page_accueil). La documentation s'ouvre ainsi
    dans SON PROPRE onglet, par un vrai clic sur un <a href> natif -- meme
    mecanisme que la Page de test (_ecrire_page_test_disque), donc hors du
    champ de la restriction Chrome sur les navigations JS vers data:.

    Le fichier n'est ECRIT ni modifie ici : documentation.html appartient
    a l'utilisateur (colle via Parametres, cf. ecrire_documentation_disque)
    et ne doit JAMAIS etre ecrase par le demarrage d'une instance. Si le
    fichier n'existe pas encore, le lien pointe quand meme vers son
    emplacement futur (le navigateur affichera alors sa propre erreur
    'fichier introuvable' au clic, ce qui est explicite) -- comportement
    voulu, coherent avec la decision utilisateur 'absent = vide'."""
    return get_documentation_html_path().as_uri()


def contenu_page_accueil(instance_id: str = "") -> str:
    """Rend WELCOME_PAGE_HTML_TEMPLATE en mémoire (aucune écriture disque)
