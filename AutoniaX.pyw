# échouerait avec un message clair, jamais l'import du fichier entier.
try:
    from camoufox.async_api import AsyncCamoufox
    # cf. _camoufox_construire_config_lancement / camoufox_demarrer_navigateur
    # -- launch_options() est le mécanisme officiel de persistance de
    # fingerprint (génère le dict complet résolu par BrowserForge une
    # seule fois, à sauvegarder en JSON et recharger via from_options),
    # PAS un paramètre `seed` qui n'existe pas dans l'API publique.
    from camoufox.utils import launch_options as camoufox_launch_options
    # AJOUT (spec A.4 -- JSON de contraintes de résolution d'écran pour la
    # génération en masse) : Screen est l'objet officiel de camoufox.utils
    # acceptant des bornes min_width/max_width/min_height/max_height,
    # transmis à launch_options(screen=...) pour restreindre le tirage
    # BrowserForge à une plage de résolutions -- cf. _camoufox_construire_
