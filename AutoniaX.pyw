# AJOUT -- remontée en constante de MODULE (était un attribut de classe
# isolé sur TestComposantScreen, cf. son eventFilter) pour être réutilisée
# aussi par ComposantLayoutConfigScreen (sous-onglet "Données de test",
# même filtrage d'extension pour le drag & drop d'images) sans dupliquer
# le tuple à deux endroits qui pourraient diverger silencieusement.
EXTENSIONS_IMAGE_ACCEPTEES = (".png", ".jpg", ".jpeg", ".bmp", ".webp", ".gif")


# AJOUT -- même remontée que EXTENSIONS_IMAGE_ACCEPTEES ci-dessus, mais
# pour les DEUX helpers de drag & drop qui l'utilisaient (étaient des
# méthodes de TestComposantScreen, cf. son eventFilter : "réutiliser ces
# mêmes helpers, ils sont déjà génériques, indépendants d'un widget
# précis"). Signature inchangée à un détail près : prennent maintenant
# le tuple d'extensions en paramètre (extensions=EXTENSIONS_IMAGE_ACCEPTEES
# par défaut) plutôt qu'un self.EXTENSIONS_IMAGE_ACCEPTEES implicite --
# permet à ComposantLayoutConfigScreen de les appeler directement, sans
# dépendre de l'attribut de classe posé côté TestComposantScreen.
# TestComposantScreen n'est PAS touché par ce changement : ses deux
# méthodes du même nom sont conservées telles quelles (cf. plus bas dans
# cette classe) et continuent de fonctionner à l'identique -- pas de
# risque de régression sur le comportement déjà validé côté test.
def mime_data_contient_image(mime_data, extensions=EXTENSIONS_IMAGE_ACCEPTEES) -> bool:
    """Vérifie SANS lire le fichier (appelé à CHAQUE DragEnter/DragMove,
    doit rester léger) qu'au moins une URL locale du drag a une extension
    d'image reconnue -- même liste que chemin_image_depuis_mime_data
    ci-dessous, qui refait la même vérification au moment du Drop réel
    (mime_data peut différer entre les deux événements selon la
    plateforme, jamais supposé identique)."""
    if mime_data is None or not mime_data.hasUrls():
        return False
    for url in mime_data.urls():
        if url.isLocalFile() and Path(url.toLocalFile()).suffix.lower() in extensions:
            return True
    return False


def chemin_image_depuis_mime_data(mime_data, extensions=EXTENSIONS_IMAGE_ACCEPTEES) -> Optional[Path]:
    """Retourne le chemin LOCAL de la première image valide du drag, ou
    None. Un drag contient parfois plusieurs URLs (sélection multiple
    dans l'explorateur) -- seule la première image reconnue est retenue."""
    if mime_data is None or not mime_data.hasUrls():
        return None
    for url in mime_data.urls():
        if not url.isLocalFile():
            continue
        chemin = Path(url.toLocalFile())
        if chemin.suffix.lower() in extensions and chemin.is_file():
            return chemin
    return None


