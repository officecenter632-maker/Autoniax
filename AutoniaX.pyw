        self.bouton_supprimer.clicked.connect(self._sur_clic_supprimer)
        ligne_actions.addWidget(self.bouton_supprimer)

        # AJOUT (cf. docstring de classe, retrait de l'onglet Test intégré)
        # -- MÊME patron que bouton_modifier ci-dessous, icône alignée sur
        # ComposantReglagesPanel.tester_button (mdi6.test-tube) pour rester
