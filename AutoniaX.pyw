def definir_proxy_natif_config_profil(nom: str, actif: bool) -> bool:
    """Bascule/écrit l'état "proxy natif" d'un profil -- PATCH
    (SPEC_proxy_natif_tunnel.md, section 13.1). Même principe exact que
    definir_test_config_profil/definir_youtube_config_profil ci-dessus
    (repli sur CONFIG_PROFIL_PAR_DEFAUT si le profil n'a pas encore
    d'entrée, `nom` forcé en str() -- cf. CORRECTIF "clé fantôme" décrit
    dans definir_test_config_profil, la même prudence s'applique ici),
    retourne le succès RÉEL de l'écriture disque.

    DIFFÉRENCE avec les autres badges (youtube/tiktok/ia/favori/test) :
    ceux-ci sont togglés LOCALEMENT par un clic sur la carte du
    sAutoniax lui-même. Celui-ci est togglé À DISTANCE, depuis le
    pilote, via le protocole réseau (cf. handler "demander_toggle_
    proxy_natif" côté _traiter_message/main_sautoniax) -- cette
    fonction reste néanmoins un simple accès disque local, appelée par
    ce handler réseau, symétrique en tout point des fonctions
    definir_<badge>_config_profil existantes.

    L'APPELANT (pas cette fonction) est responsable de vérifier que le
    profil n'est pas actuellement actif avant d'appeler cette fonction
    -- cf. SPEC section 13.5, "le toggle est interdit tant que le
    profil est actif" : un changement de --proxy-server ne peut de
    toute façon pas s'appliquer à un navigateur déjà lancé, donc écrire
    ce champ pendant que le profil tourne ne ferait qu'illustrer un état
    qui ne deviendra réel qu'au prochain démarrage -- source de
    confusion à éviter en amont, pas ici."""
    nom = str(nom)
    configs = charger_registre_profils_config()
    config_existante = configs.get(nom) or dict(CONFIG_PROFIL_PAR_DEFAUT)
    config_existante["proxy_natif"] = bool(actif)
    configs[nom] = config_existante
    return sauvegarder_registre_profils_config(configs)


def renommer_config_profil(ancien_nom: str, nouveau_nom: str) -> None:
    """Suit renommer_profil() (registre profils.json) pour garder
    profils_config.json synchronisé -- appelée juste après un
    renommer_profil() réussi (cf. ProfilsInstancesScreen.
    _on_clic_renommer_profil). Ne fait rien si l'ancien nom n'a pas
    d'entrée (profil créé avant ce patch, jamais eu de config explicite) :
    obtenir_config_profil retombera alors sur CONFIG_PROFIL_PAR_DEFAUT
    sous le nouveau nom, ce qui est le même comportement qu'avant le
    renommage -- rien à migrer dans ce cas."""
    configs = charger_registre_profils_config()
    if ancien_nom not in configs:
        return
    configs[nouveau_nom] = configs.pop(ancien_nom)
    sauvegarder_registre_profils_config(configs)


def supprimer_config_profil(nom: str) -> None:
    """Suit supprimer_profil() (registre profils.json) pour retirer
    l'entrée correspondante de profils_config.json -- appelée juste après
    un supprimer_profil() réussi (cf. ProfilsInstancesScreen.
    _supprimer_profil_confirme). Ne fait rien si le profil n'avait pas de
    config explicite (même cas que renommer_config_profil ci-dessus)."""
    configs = charger_registre_profils_config()
    if nom in configs:
        configs.pop(nom)
        sauvegarder_registre_profils_config(configs)


# --- Parsing d'une URL de proxy en composants -------------------------------
# PATCH (demande utilisateur : "avec entrer pour donnee proxy", clarifié en
# dialogue -- champ libre unique, ex: "http://user:pass@host:port", parsé
# automatiquement). Regex plutôt qu'un urllib.parse.urlsplit "nu" : un
# proxy sans user/password ("http://host:port") ou même sans protocole
# ("host:port") sont des formats couramment collés par un utilisateur
# depuis un fournisseur de proxy, urlsplit seul ne gère pas le second cas
# proprement (host:port sans "//" est interprété comme le chemin, pas le
# netloc).
_RE_PROXY = re.compile(
    r"^(?:(?P<protocole>https?|socks5|socks4)://)?"
    r"(?:(?P<user>[^:@/\s]+)(?::(?P<password>[^@/\s]*))?@)?"
    r"(?P<host>[A-Za-z0-9._-]+)"
    r"(?::(?P<port>\d{1,5}))?$"
)

# PATCH (retour utilisateur explicite : "sa ne prend pas ce format de proxy :
# 31.59.20.176:6754:ucfjegbz:tyhtqc1ri47p") -- second format très répandu
# chez les fournisseurs de proxy (Webshare, IPRoyal, etc.), à 4 segments
# séparés par ":" SANS "@" : host:port:user:password. Regex dédiée plutôt
# que d'essayer de complexifier _RE_PROXY ci-dessus : les deux formats sont
# ambigus l'un envers l'autre si fusionnés dans une seule expression (un
# host:port:user:password a la même forme générale qu'un
# protocole-implicite avec des ":" en trop), donc parser_proxy tente
# d'abord CE format-ci (4 segments stricts), puis retombe sur _RE_PROXY
# si ça ne matche pas. Port toujours numérique ici (contrairement à
# _RE_PROXY) : ce format n'existe que sous cette forme précise chez les
# fournisseurs qui l'utilisent, jamais avec un port omis.
_RE_PROXY_4_SEGMENTS = re.compile(
    r"^(?P<host>[A-Za-z0-9._-]+):(?P<port>\d{1,5}):(?P<user>[^:@/\s]+):(?P<password>[^@/\s]*)$"
)


def parser_proxy(chaine: str) -> Optional[dict]:
    """Parse une chaîne de proxy libre en composants {"protocole", "host",
    "port", "user", "password"}. Deux formats reconnus :
    - "host:port:user:password" (cf. _RE_PROXY_4_SEGMENTS, format courant
      chez plusieurs fournisseurs de proxy, essayé EN PREMIER)
    - "[protocole://][user[:password]@]host[:port]" (cf. _RE_PROXY,
      format classique avec "@", utilisé si le premier ne matche pas)

    Retourne None si `chaine` est vide/blanche (= pas de proxy configuré,
    cas normal) ou si aucun des deux formats ne peut être reconnu (host
    manquant) -- l'appelant doit alors afficher une erreur plutôt que
    d'enregistrer une config inutilisable silencieusement.

    "protocole" retombe sur "http" si absent (convention la plus courante
    pour un proxy collé sans schéma). "port" est converti en int quand
    présent, None sinon (certains proxies SOCKS n'exigent pas de port
    explicite si le service tourne sur le port par défaut -- rare, mais
    on ne force pas une valeur inventée)."""
    chaine = chaine.strip()
    if not chaine:
        return None

    m4 = _RE_PROXY_4_SEGMENTS.match(chaine)
    if m4:
        return {
            "protocole": "http",
            "host": m4.group("host"),
            "port": int(m4.group("port")),
            "user": m4.group("user"),
            "password": m4.group("password") or None,
        }

    m = _RE_PROXY.match(chaine)
    if not m or not m.group("host"):
        return None
    return {
        "protocole": m.group("protocole") or "http",
        "host": m.group("host"),
        "port": int(m.group("port")) if m.group("port") else None,
        "user": m.group("user"),
        "password": m.group("password"),
    }


def formater_proxy(proxy: Optional[dict]) -> str:
    """Inverse de parser_proxy -- reconstruit une chaîne affichable/
    ré-éditable (ex: dans le champ texte du dialogue quand on pré-remplit
    depuis une config existante). Retourne "" si `proxy` est None."""
    if not proxy:
        return ""
    protocole = proxy.get("protocole") or "http"
    host = proxy.get("host") or ""
    port = proxy.get("port")
    user = proxy.get("user")
    password = proxy.get("password")
    auth = ""
    if user:
        auth = user + (f":{password}" if password else "") + "@"
    port_str = f":{port}" if port else ""
    return f"{protocole}://{auth}{host}{port_str}"


def _nom_dossier_valide(nom: str) -> str:
    """Assainit un nom de profil fourni par l'utilisateur pour en faire un
    nom de dossier Windows valide -- garde uniquement lettres/chiffres/
    espaces/tirets/underscores (remplace le reste par '_'), pour éviter
    qu'un caractère comme '/' ou ':' dans le nom ne casse la création du
    dossier ou ne soit interprété comme un chemin."""
    nettoye = "".join(c if c.isalnum() or c in " -_" else "_" for c in nom).strip()
    return nettoye or "profil"


def charger_registre_profils() -> dict[str, str]:
    """Charge le registre {nom_profil: chemin_dossier} depuis
    FICHIER_REGISTRE_PROFILS -- source de vérité de la liste des profils
    créés, cf. DashboardScreen (qui doit les afficher par leur nom, qu'une
    instance tourne dessus ou non). Retourne un dict vide si le fichier
    n'existe pas encore (premier lancement) ou est illisible/corrompu
    (plutôt que planter l'ouverture du Dashboard pour ça)."""
    if not FICHIER_REGISTRE_PROFILS.is_file():
        return {}
    try:
        with open(FICHIER_REGISTRE_PROFILS, "r", encoding="utf-8") as f:
            donnees = json.load(f)
        if not isinstance(donnees, dict):
            return {}
        return {str(k): str(v) for k, v in donnees.items()}
    except (OSError, ValueError) as e:
        log.warning(f"charger_registre_profils() : lecture impossible ({e!r}) -- registre traité comme vide.")
        return {}


def sauvegarder_registre_profils(profils: dict[str, str]) -> None:
    """Écrit le registre {nom_profil: chemin_dossier} sur disque -- appelé
    à chaque création de profil (cf. DashboardScreen._on_clic_nouveau_profil).
    N'échoue jamais bruyamment : un échec d'écriture (disque plein,
    permissions) est journalisé mais ne bloque pas l'utilisation du profil
    en mémoire pour la session en cours."""
    try:
        DOSSIER_RACINE_PROFILS.mkdir(parents=True, exist_ok=True)
        with open(FICHIER_REGISTRE_PROFILS, "w", encoding="utf-8") as f:
            json.dump(profils, f, ensure_ascii=False, indent=2)
    except OSError as e:
        log.warning(f"sauvegarder_registre_profils() : écriture impossible ({e!r}) -- registre non persisté sur disque.")


# PATCH (mode local dans le panneau clone -- cf. SPEC_mode_clone_local.md,
# section 3.1) : réassocie {nom_profil: instance_id} pour les profils
# ACTIFS localement, à partir de instances_list (protocole serveur local,
# qui ne connaît que des instance_id bruts, jamais de "profil"). Reprend
# le MÊME algorithme que ProfilsInstancesScreen._sur_liste_instances_recue
# (association par préfixe "{nom_dossier_valide(profil)}-N", cf. cette
# méthode pour le raisonnement complet) -- extrait ici en fonction PURE
# (aucun effet de bord sur un quelconque état de ProfilsInstancesScreen,
# ex. _pid_par_instance/_heure_debut_par_profil, qui n'ont pas de sens
# pour l'appelant ici, TaskConfigScreen) plutôt que d'appeler une méthode
# privée de ProfilsInstancesScreen -- cohérent avec la règle déjà en place
# partout dans ce fichier ("jamais d'appel direct entre deux écrans-
# frères"), et évite de coupler ce nouveau code à l'implémentation interne
# (potentiellement changeante) de ProfilsInstancesScreen.
#
# ProfilsInstancesScreen elle-même N'EST PAS modifiée par ce patch : sa
# propre méthode _sur_liste_instances_recue garde son implémentation
# actuelle telle quelle (déjà éprouvée, gère en plus des besoins qui lui
# sont propres) -- dupliquer ce court algorithme d'association est un
# compromis délibéré pour ne prendre AUCUN risque de régression sur du
# code déjà en production, au prix d'une petite duplication de logique.
def _associer_profils_actifs_locaux(
    instances: list[dict],
    noms_profils_connus: list[str],
    associations_precedentes: dict[str, str],
) -> dict[str, str]:
    """Retourne {nom_profil: instance_id} pour les profils LOCAUX
    actuellement actifs (instance visible dans `instances`), à partir de :
      - `instances` : dernière liste reçue du serveur local (instances_list,
        cf. ClientReseauAutoniaX.liste_instances_recue) -- chaque entrée a
        au moins une clé "id".
      - `noms_profils_connus` : noms de TOUS les profils enregistrés sur
        disque (cf. charger_registre_profils()), actifs ou non -- un profil
        jamais lancé n'a simplement aucune entrée dans le résultat.
      - `associations_precedentes` : résultat du dernier appel (ou {} au
        tout premier) -- une association déjà connue et toujours vivante
        est CONSERVÉE telle quelle plutôt que redevinée par préfixe à
        chaque appel (évite qu'un nom de profil qui serait préfixe d'un
        autre, ex. "iaX1" vs "iaX10", change d'avis d'un rafraîchissement
        à l'autre selon l'ordre d'itération -- même précaution que
        ProfilsInstancesScreen._sur_liste_instances_recue).

    Un instance_id est de la forme "{nom_dossier_valide(nom_profil)}-{n}"
    (convention fixée par ProfilsInstancesScreen._lancer_instance_pour_profil,
    seul point de lancement d'une instance locale) -- aucune autre source
    ne permet de retrouver le nom de profil : le serveur local ne connaît
    que des instance_id bruts, jamais de nom de profil (cf. docstring de
    ClientReseauAutoniaX)."""
    ids_connus = {i.get("id") for i in instances if i.get("id")}

    resultat = {
        nom_profil: instance_id
        for nom_profil, instance_id in associations_precedentes.items()
        if instance_id in ids_connus
    }

    ids_deja_associes = set(resultat.values())
    for nom_profil in noms_profils_connus:
        if nom_profil in resultat:
            continue
        prefixe = f"{_nom_dossier_valide(nom_profil)}-"
        for instance_id in ids_connus:
            if instance_id in ids_deja_associes:
                continue
            suffixe = instance_id[len(prefixe):]
            if instance_id.startswith(prefixe) and suffixe.isdigit():
                resultat[nom_profil] = instance_id
                ids_deja_associes.add(instance_id)
                break
    return resultat


# --- Écran Api2Api (sidebar dédiée) -- persistance des lignes ---------------
# Cf. Api2Api_ecran_specification.md, section 3.2 : fichier SÉPARÉ, MÊME
# dossier data que le registre de profils (PAS dans project.json -- une
# association Task+profil est un réglage de LANCEMENT local à la machine,
# pas une donnée de Project partageable/synchronisable, cohérent avec le
# fait que profils.json/profils_config.json ne sont pas non plus dans
# project.json).
FICHIER_REGISTRE_API2API_ASSOCIATIONS = DOSSIER_RACINE_PROFILS / "api2api_associations.json"


def charger_associations_api2api() -> list["AssociationApi2Api"]:
    """Charge la liste des lignes de l'écran Api2Api depuis
    FICHIER_REGISTRE_API2API_ASSOCIATIONS -- même patron exact que
    charger_registre_profils() : liste vide si le fichier n'existe pas
    encore (premier lancement) ou est illisible/corrompu, jamais
    d'exception qui empêcherait l'ouverture de l'écran."""
    if not FICHIER_REGISTRE_API2API_ASSOCIATIONS.is_file():
        return []
    try:
        with open(FICHIER_REGISTRE_API2API_ASSOCIATIONS, "r", encoding="utf-8") as f:
            donnees = json.load(f)
        if not isinstance(donnees, list):
            return []
        return [AssociationApi2Api.from_dict(d) for d in donnees if isinstance(d, dict)]
    except (OSError, ValueError) as e:
        log.warning(f"charger_associations_api2api() : lecture impossible ({e!r}) -- registre traité comme vide.")
        return []


def sauvegarder_associations_api2api(associations: list["AssociationApi2Api"]) -> None:
    """Écrit la liste des lignes de l'écran Api2Api sur disque -- appelé à
    chaque ajout/suppression de ligne (cf. Api2ApiScreen). N'échoue jamais
    bruyamment : un échec d'écriture (disque plein, permissions) est
    journalisé mais ne bloque pas l'utilisation en mémoire pour la session
    en cours -- même garantie que sauvegarder_registre_profils()."""
    try:
        DOSSIER_RACINE_PROFILS.mkdir(parents=True, exist_ok=True)
        with open(FICHIER_REGISTRE_API2API_ASSOCIATIONS, "w", encoding="utf-8") as f:
            json.dump([a.to_dict() for a in associations], f, ensure_ascii=False, indent=2)
    except OSError as e:
        log.warning(f"sauvegarder_associations_api2api() : écriture impossible ({e!r}) -- registre non persisté sur disque.")


def _migrer_dossier_profil_si_ancien_emplacement(nom: str, chemin_enregistre: str) -> str:
    """PATCH (retour utilisateur explicite : "le probleme est que j'ai
    deja creer ces profils, tu peux faire à ce qu'à leur prochain
    demarrage il pointe vers le bon dossier") -- migration AUTOMATIQUE et
    À LA VOLÉE, appelée depuis creer_ou_obtenir_profil AVANT même de
    vérifier si `nom` est déjà dans le registre.

    Contexte (cf. commentaire historique au-dessus de
    FICHIER_REGISTRE_PROFILS, "PATCH -- pointer vers le dossier migré sur
    D:\\, malgré la mise en garde") : DOSSIER_RACINE_PROFILS a changé
    d'emplacement (ancien : %LOCALAPPDATA%\\AutoniaX\\profils ; nouveau :
    celui résolu par _chemin_donnees("profils"), D:\\ScaleTube\\...\\Data\\
    profils en dur si AUTONIAX_DATA_DIR n'est pas définie). Ce changement
    ne touchait QUE les nouveaux profils : tout profil créé AVANT continue
    de pointer, via son entrée déjà écrite dans profils.json, vers
    l'ancien dossier -- cf. logs de lancement fournis par l'utilisateur
    ("--user-data-dir=C:\\Users\\Office\\AppData\\Local\\AutoniaX\\profils\\
    fudev100" alors que DOSSIER_RACINE_PROFILS pointe désormais ailleurs).

    Ne fait RIEN (retourne chemin_enregistre tel quel) si :
    - le chemin enregistré est déjà sous DOSSIER_RACINE_PROFILS (profil
      créé après la migration, ou déjà migré par un appel précédent) ;
    - le dossier enregistré n'existe plus sur disque (rien à migrer --
      creer_ou_obtenir_profil recréera un dossier vide au bon endroit,
      comportement normal pour un registre pointant vers du vide).

    Si un dossier existe DÉJÀ à l'emplacement cible : s'il est VIDE, il
    est supprimé avant migration (rien à perdre) ; s'il contient déjà des
    données, il est mis de côté (renommé avec un suffixe horodaté
    ".conflit_AAAAMMJJ_HHMMSS", jamais supprimé) pour libérer la place et
    permettre à la migration de se faire quand même -- jamais
    d'écrasement silencieux, mais jamais non plus de blocage
    indéfini : cf. bloc ci-dessous pour le détail des deux sous-cas.

    Sinon, déplace le dossier COMPLET (cookies/sessions/cache -- shutil.
    move, pas une copie : rien ne doit rester à double sur le disque) de
    l'ancien vers le nouvel emplacement, réécrit immédiatement le
    registre avec le nouveau chemin (pour que la migration ne soit
    tentée qu'UNE seule fois par profil, pas à chaque lancement), et
    retourne ce nouveau chemin.

    Ne lève jamais d'exception : un échec de migration (dossier verrouillé
    par un Chrome pas encore totalement fermé, permissions, disque plein)
    est journalisé et on retombe sur l'ANCIEN chemin (chemin_enregistre),
    pour ne jamais empêcher le profil de démarrer -- juste retenter la
    migration au lancement suivant."""
    try:
        chemin_actuel = Path(chemin_enregistre)
        chemin_cible = DOSSIER_RACINE_PROFILS / _nom_dossier_valide(nom)
        if chemin_actuel.resolve() == chemin_cible.resolve():
            return chemin_enregistre  # Déjà au bon endroit -- rien à faire.
        if not chemin_actuel.is_dir():
            return chemin_enregistre  # Rien sur disque à migrer.
        if chemin_cible.exists():
            # PATCH (retour utilisateur, cf. log réel : "Migration du
            # profil 'fudev100' ignorée : un dossier existe déjà à
            # l'emplacement cible") -- CAS RÉEL rencontré : un dossier
            # cible existe déjà mais est VIDE (jamais utilisé par Chrome
            # -- ex. créé par un dossier.mkdir() d'un lancement
            # antérieur qui avait échoué avant même d'ouvrir le
            # navigateur dessus, ou par un ancien test). Bloquer la
            # migration pour ça reviendrait à laisser indéfiniment le
            # profil sur l'ancien emplacement pour rien : un dossier VIDE
            # ne contient par définition aucune donnée à perdre, donc on
            # le supprime et on migre normalement par-dessus.
            if not any(chemin_cible.iterdir()):
                log.info(
                    f"Migration du profil '{nom}' : le dossier cible ({chemin_cible}) existe mais est "
                    f"vide -- suppression avant migration, aucune donnée à perdre."
                )
                chemin_cible.rmdir()
            else:
                # Le dossier cible contient déjà de VRAIES données (pas
                # vide) : on ne les écrase JAMAIS silencieusement (cf.
                # docstring -- "jamais d'écrasement silencieux d'un
                # dossier existant"). On met plutôt cet ancien contenu de
                # côté (renommé avec un suffixe horodaté) pour libérer
                # l'emplacement cible et pouvoir quand même y migrer
                # chemin_actuel -- rien n'est supprimé, tout reste
                # récupérable manuellement sur disque si besoin
                # (contrairement à l'ancien comportement qui bloquait la
                # migration indéfiniment sans jamais la débloquer seul).
                suffixe_conflit = datetime.now().strftime("%Y%m%d_%H%M%S")
                chemin_conflit_sauvegarde = chemin_cible.with_name(f"{chemin_cible.name}.conflit_{suffixe_conflit}")
                log.warning(
                    f"Migration du profil '{nom}' : le dossier cible ({chemin_cible}) existe déjà et "
                    f"contient des données -- mis de côté sans suppression sous "
                    f"{chemin_conflit_sauvegarde} avant de migrer l'ancien profil à sa place. "
                    f"Vérifiez manuellement si ce dossier mis de côté doit être conservé/fusionné."
                )
                chemin_cible.rename(chemin_conflit_sauvegarde)

        chemin_cible.parent.mkdir(parents=True, exist_ok=True)
        log.info(
            f"Migration du profil '{nom}' vers le nouvel emplacement de données : "
            f"{chemin_actuel} -> {chemin_cible}"
        )
        shutil.move(str(chemin_actuel), str(chemin_cible))

        profils = charger_registre_profils()
        profils[nom] = str(chemin_cible)
        sauvegarder_registre_profils(profils)
        log.info(f"Profil '{nom}' migré avec succès -- registre mis à jour ({chemin_cible}).")
        return str(chemin_cible)
    except OSError as e:
        log.warning(
            f"Migration du profil '{nom}' ({chemin_enregistre}) impossible pour l'instant ({e!r}) -- "
            f"lancement avec l'ancien chemin, nouvelle tentative au prochain démarrage."
        )
        return chemin_enregistre



def creer_ou_obtenir_profil(nom: str) -> tuple[str, str]:
    """Crée le dossier persistant d'un profil nommé s'il n'existe pas
    encore, l'ajoute au registre sur disque, et retourne (nom_normalisé,
    chemin_dossier). Si un profil de ce nom existe déjà, retourne son
    chemin existant -- éventuellement migré au passage (cf.
    _migrer_dossier_profil_si_ancien_emplacement, PATCH retour
    utilisateur : les profils créés avant un changement d'emplacement de
    DOSSIER_RACINE_PROFILS doivent être rapatriés automatiquement, sans
    perdre leurs cookies/sessions) -- jamais de recréation qui
    écraserait un profil déjà connecté (cf. décision utilisateur : les
    profils doivent persister, un nouveau profil ne doit jamais
    remplacer un profil existant du même nom)."""
    profils = charger_registre_profils()
    if nom in profils:
        chemin_migre = _migrer_dossier_profil_si_ancien_emplacement(nom, profils[nom])
        return nom, chemin_migre
    dossier = DOSSIER_RACINE_PROFILS / _nom_dossier_valide(nom)
    dossier.mkdir(parents=True, exist_ok=True)
    profils[nom] = str(dossier)
    sauvegarder_registre_profils(profils)
    return nom, str(dossier)


def renommer_profil(ancien_nom: str, nouveau_nom: str) -> bool:
    """PATCH (demande utilisateur : pouvoir renommer un profil, jusqu'ici
    impossible depuis l'écran Profils). Renomme UNIQUEMENT la clé du
    registre {nom_profil: chemin_dossier} -- le dossier disque lui-même
    (déjà assaini via _nom_dossier_valide au moment de la création,
    potentiellement différent du nom affiché) N'EST PAS renommé : rien
    n'exige que nom affiché et nom de dossier coïncident (cf.
    creer_ou_obtenir_profil, qui les dissocie déjà), et ne pas toucher au
    dossier évite tout risque sur les cookies/sessions déjà écrits dedans.

    Refuse si `ancien_nom` est introuvable, si `nouveau_nom` est vide
    après nettoyage, ou si `nouveau_nom` est déjà pris par un AUTRE
    profil (jamais d'écrasement silencieux d'un profil existant -- même
    prudence que creer_ou_obtenir_profil pour un nom dupliqué à la
    création). Retourne True si le renommage a bien eu lieu.

    Ne touche à AUCUNE instance en cours -- l'appelant (cf.
    ProfilsInstancesScreen._on_clic_renommer_profil) doit s'assurer que
    le profil n'a pas d'instance active avant d'appeler cette fonction :
    instance_id est dérivé du nom du profil au lancement (cf.
    _lancer_instance_pour_profil), donc renommer un profil actif
    désynchroniserait le nom affiché de l'instance déjà en cours."""
    nouveau_nom = nouveau_nom.strip()
    if not nouveau_nom:
        return False
    profils = charger_registre_profils()
    if ancien_nom not in profils:
        return False
    if nouveau_nom != ancien_nom and nouveau_nom in profils:
        return False
    if nouveau_nom == ancien_nom:
        return True
    profils[nouveau_nom] = profils.pop(ancien_nom)
    sauvegarder_registre_profils(profils)
    return True


def supprimer_profil(nom: str) -> bool:
    """Supprime définitivement un profil PERSISTANT : le retire du
    registre sur disque ET supprime son dossier de données (cookies/
    sessions) -- action explicitement demandée par l'utilisateur (l'ancien
    commentaire "jamais recopié ni supprimé" sur DOSSIER_RACINE_PROFILS
    ne visait que la suppression IMPLICITE/automatique lors d'un
    relancement, cf. creer_ou_obtenir_profil : ça n'exclut pas une
    suppression manuelle et volontaire depuis l'écran Profils).

    Ne touche à AUCUNE instance en cours -- l'appelant (cf.
    ProfilsInstancesScreen._supprimer_profil_confirme) doit s'être assuré
    que l'instance associée est déjà arrêtée avant d'appeler cette
    fonction, pour ne jamais supprimer le dossier --user-data-dir d'un
    Chrome encore ouvert dessus.

    Retourne True si le profil a été retiré du registre (même si la
    suppression physique du dossier a partiellement échoué -- un échec de
    shutil.rmtree, ex. fichier verrouillé, est journalisé mais ne doit pas
    laisser le profil "fantôme" dans la liste affichée). Retourne False si
    le profil n'existait pas dans le registre."""
    profils = charger_registre_profils()
    if nom not in profils:
        return False
    dossier = profils.pop(nom)
    sauvegarder_registre_profils(profils)
    try:
        shutil.rmtree(dossier, ignore_errors=False)
    except OSError as e:
        log.warning(
            f"supprimer_profil('{nom}') : suppression du dossier '{dossier}' incomplète ({e!r}) -- "
            f"le profil reste néanmoins retiré du registre."
        )
    return True


