    # ------------------------------------------------------------------
    # Api2Api -- cf. spécification complète (résumé utilisateur) :
    # n'importe quel Task ordinaire peut envoyer une requête synchrone à
    # n'importe quel Task de type Api2Api ailleurs sur le réseau, le
    # serveurT étant le seul point de routage. Les méthodes BLOQUANTES
    # ci-dessous suivent EXACTEMENT le même patron que InstanceExecutable
    # DirecteCamoufox._appeler : appelées depuis le THREAD du script
    # utilisateur (jamais depuis self._loop elle-même), elles postent
    # l'envoi sur self._loop via run_coroutine_threadsafe puis bloquent
    # sur future.result(timeout=...) -- la future est résolue depuis
    # _traiter_message (qui tourne sur self._loop) dès que la réponse
    # corrélée arrive sur le WebSocket, cf. son propre bloc "api2api_*"
    # plus loin dans cette méthode.
    #
    # Utilisées par les classes Api2Api/RequeteApi2Api (exposées aux
    # scripts Task, cf. leur définition module-niveau plus bas dans ce
    # fichier) -- jamais appelées directement par du code utilisateur.
    # ------------------------------------------------------------------

    _TIMEOUT_RESEAU_API2API_S_DEFAUT = 15.0  # marge réseau pure (ack), PAS le timeout d'attente d'un Api2Api libre (paramètre explicite de l'appelant, cf. api2api_verrouiller_bloquant)

    def _api2api_attendre_future(self, requete_id: str, timeout_s: float) -> dict:
        """Factorise le blocage commun aux méthodes ci-dessous : crée la
        Future corrélée à `requete_id`, attend son résultat, purge
        systématiquement l'entrée (succès, erreur, OU timeout -- une
        future orpheline dans self._api2api_futures ne serait jamais
        résolue ensuite). Ne lève jamais : {"ok": False, "erreur":...}
        même en cas de timeout, cohérent avec le contrat déjà établi par
        InstanceExecutableDirecteCamoufox._appeler."""
        future: concurrent.futures.Future = concurrent.futures.Future()
        self._api2api_futures[requete_id] = future
        try:
            return future.result(timeout=timeout_s)
        except concurrent.futures.TimeoutError:
            return {"ok": False, "erreur": f"timeout ({timeout_s}s) : aucune réponse du serveurT (requete_id={requete_id})"}
        finally:
            self._api2api_futures.pop(requete_id, None)

    def api2api_enregistrer_bloquant(self, timeout_s: Optional[float] = None) -> dict:
        """Enregistre CE Task comme fournisseur Api2Api disponible.
        Retourne {"ok": True, "id_api2api": str} en cas de succès, ou
        {"ok": False, "erreur": str}. Bloquant (aller-retour réseau
        simple, PAS l'attente d'un client -- cf. api2api_verrouiller_
        bloquant pour ce cas-là), timeout par défaut court (ack pur)."""
        if self._loop is None or not self._loop.is_running() or self._ws is None:
            return {"ok": False, "erreur": "Non connecté au serveurT."}
        requete_id = uuid.uuid4().hex[:12]
        asyncio.run_coroutine_threadsafe(
            self._ws.send(json.dumps({"type": "api2api_enregistrer", "requete_id": requete_id})), self._loop,
        )
        return self._api2api_attendre_future(requete_id, timeout_s or self._TIMEOUT_RESEAU_API2API_S_DEFAUT)

    def api2api_desenregistrer(self, id_api2api: str):
        """Fire-and-forget (pas besoin d'attendre l'ack -- arrêt d'un
        Task Api2Api, best-effort : si le message se perd, le nettoyage
        à la déconnexion côté serveurT rattrapera de toute façon la
        situation, cf. _api2api_desenregistrer_fournisseur)."""
        if self._loop is None or not self._loop.is_running() or self._ws is None:
            return
        asyncio.run_coroutine_threadsafe(
            self._ws.send(json.dumps({"type": "api2api_desenregistrer", "id_api2api": id_api2api})), self._loop,
        )

    def api2api_verrouiller_bloquant(self, timeout_attente_s: float) -> dict:
        """Cherche un Task Api2Api libre sur le réseau et le verrouille
        pour ce client -- BLOQUE jusqu'à succès ou jusqu'à ce que
        `timeout_attente_s` expire (cf. décision explicite utilisateur :
        "Attendre (bloquant) qu'un devienne libre, avec un timeout").
        Le timeout d'ATTENTE (potentiellement long, ex. 30s/60s -- le
        temps qu'un Api2Api existant se libère) est géré côté SERVEURT
        lui-même (cf. serveur.py, handler api2api_verrouiller -- boucle
        avec asyncio.wait_for interne) : ce timeout_attente_s est
        transmis tel quel dans le message, PAS utilisé comme timeout de
        future.result() ici -- celui-ci utilise une marge fixe
        généreuse en plus (cf. plus bas), pour laisser au serveurT le
        temps de répondre lui-même APRÈS avoir épuisé son propre délai
        interne, plutôt que de couper la connexion au client avant que
        le serveurT n'ait fini d'attendre pour son compte."""
        if self._loop is None or not self._loop.is_running() or self._ws is None:
            return {"ok": False, "erreur": "Non connecté au serveurT."}
        requete_id = uuid.uuid4().hex[:12]
        asyncio.run_coroutine_threadsafe(
            self._ws.send(json.dumps({
                "type": "api2api_verrouiller", "requete_id": requete_id, "timeout_s": timeout_attente_s,
            })), self._loop,
        )
        # Marge de 10s au-delà du timeout d'attente demandé -- laisse au
        # serveurT le temps d'envoyer sa propre réponse ok=False après
        # avoir lui-même épuisé timeout_attente_s en interne, plutôt que
        # de timeout côté client une fraction de seconde trop tôt.
        return self._api2api_attendre_future(requete_id, timeout_attente_s + 10.0)

    def api2api_liberer(self, id_api2api: str) -> dict:
        """Libère EXPLICITEMENT un verrou Api2Api (Api2ApiTask.free()
        côté script) -- bloquant sur l'ack (aller-retour réseau simple),
        pas d'attente d'un état particulier contrairement à
        api2api_verrouiller_bloquant."""
        if self._loop is None or not self._loop.is_running() or self._ws is None:
            return {"ok": False, "erreur": "Non connecté au serveurT."}
        requete_id = uuid.uuid4().hex[:12]
        asyncio.run_coroutine_threadsafe(
            self._ws.send(json.dumps({
                "type": "api2api_liberer", "id_api2api": id_api2api, "requete_id": requete_id,
            })), self._loop,
        )
        return self._api2api_attendre_future(requete_id, self._TIMEOUT_RESEAU_API2API_S_DEFAUT)

    def api2api_reset_admin_bloquant(self) -> dict:
        """OUTIL DE DÉVELOPPEMENT (cf. reinitialiser_registre_api2api()
        exposée au script, plus bas dans ce fichier) -- VIDE ENTIÈREMENT
        le registre Api2Api du serveurT (cf. _api2api_reset_admin côté
        serveur.py) : tout fournisseur Api2Api actuellement enregistré,
        même verrouillé, en disparaît d'un coup -- pas une simple
        libération de verrou (cf. api2api_liberer ci-dessus pour ce cas-
        là, bien plus ciblé). Bloquant sur l'ack, même patron que api2api_
        liberer (aller-retour réseau simple, pas d'attente d'un état
        particulier)."""
        if self._loop is None or not self._loop.is_running() or self._ws is None:
            return {"ok": False, "erreur": "Non connecté au serveurT."}
        requete_id = uuid.uuid4().hex[:12]
        asyncio.run_coroutine_threadsafe(
            self._ws.send(json.dumps({
                "type": "api2api_reset_admin", "requete_id": requete_id,
            })), self._loop,
        )
