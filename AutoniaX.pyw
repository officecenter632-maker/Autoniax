        '.b{max-width:560px;text-align:center}'
        'h1{font-size:20px;font-weight:600;color:#cba6f7;margin:0 0 10px}'
        'p{font-size:14px;line-height:1.6;color:#a6adc8;margin:0 0 14px}'
