    # ------------------------------------------------------------------
    # Slots -- même patron que ComposantReglagesNumeriquesPanel ci-dessus :
    # retrouve le ComposantLayout par nom dans self.project, modifie
    # l'objet du modèle partagé directement, puis sauvegarde.
    # ------------------------------------------------------------------

    def _on_couleur_zone_changed(self, couleur: str):
