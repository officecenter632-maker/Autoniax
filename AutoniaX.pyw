    def envoyer_commande_instance(self, id_executant: str, instance_id: str, requete_id: str, commande: dict):
        """PATCH B.4 (contrôle à distance réel, cf. cahier des charges
        patchs.md) -- relaie UNE commande de pilotage (clic/scroll/
        mousemove/type_text, cf. commande_controle_distance de
        FenetreRenduTaskReseau) vers le sAutoniax ciblé, via le handler
        "commande_instance" de serveur.py (relais tel quel vers
        _executer_commande_camoufox côté sAutoniax). Même patron
        fire-and-forget que demander_capture_ponctuelle_instance/
        definir_taux_capture_instance ci-dessus -- l'accusé de
        transmission (commande_instance_ack) et le résultat d'exécution
        réel (command_result) arrivent tous deux de façon asynchrone,
        cf. leur traitement dans _traiter_message.

        `commande` est le sous-dict {"action": ..., **params} déjà prêt
        tel qu'attendu par _executer_commande_camoufox (ex. {"action":
        "click", "x": 120, "y": 340, "bouton": "gauche"}) -- transmis
        tel quel, aucune validation de son contenu ici (déléguée au
        sAutoniax, comme documenté côté serveur.py)."""
        if self._loop is None or not self._loop.is_running() or self._ws is None:
            log_reseau_t.debug("envoyer_commande_instance : non connecté au serveurT -- ignoré.")
            return
        asyncio.run_coroutine_threadsafe(
            self._ws.send(json.dumps({
                "type": "commande_instance",
                "id_executant": id_executant,
                "instance_id": instance_id,
                "requete_id": requete_id,
                "commande": commande,
            })),
            self._loop,
        )

