                # qu'aucune entrée ne corresponde à cet id : cf.
                # GRACE_COPIE_GLOBALE_S -- on laisse un court sursis, pas
                # tout le budget, puis on se rabat sur le global.
                if echeance_grace_globale is None:
                    echeance_grace_globale = time.monotonic() + GRACE_COPIE_GLOBALE_S
            maintenant = time.monotonic()
            if echeance_grace_globale is not None and maintenant >= echeance_grace_globale:
                break
            if maintenant >= echeance:
                break
            await asyncio.sleep(INTERVALLE_POLL_COPIE_PRESSE_PAPIER_S)

        if texte_global_frais is not None:
            # Repli AUTORISÉ car le global est lui-même FRAIS : une copie
            # a bien eu lieu après ce clic, seul son id n'a pas pu être
            # rattaché (élément sans id ni data-testid exploitable, copie
            # déclenchée depuis un iframe, etc.).
            log.warning(
                f"{prefixe_log}copier_presse_papier : id_dom_presse_papier={id_dom_cible!r} "
                f"demandé mais aucune copie fraîche pour cet id -- repli sur le presse-papier "
                f"virtuel global, qui est bien frais (une copie a eu lieu après le clic, mais "
                f"sans id rattachable). Vérifie la valeur de Composant.id_dom."
