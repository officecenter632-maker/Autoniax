        self.bouton_precedent.setIcon(qta.icon("mdi6.arrow-left", color=Mocha.subtext0))
        self.bouton_precedent.setIconSize(QSize(14, 14))
        self.bouton_precedent.setCursor(Qt.PointingHandCursor)
        self.bouton_precedent.setToolTip("Page précédente")
        self.bouton_precedent.clicked.connect(lambda: self._emettre_commande("goBack"))

        self.bouton_suivant = QToolButton(self.panneau.colonne_image)
        self.bouton_suivant.setObjectName("APIFeaturesMenuButton")
        self.bouton_suivant.setIcon(qta.icon("mdi6.arrow-right", color=Mocha.subtext0))
        self.bouton_suivant.setIconSize(QSize(14, 14))
        self.bouton_suivant.setCursor(Qt.PointingHandCursor)
        self.bouton_suivant.setToolTip("Page suivante")
        self.bouton_suivant.clicked.connect(lambda: self._emettre_commande("goForward"))

        # AJOUT (demande explicite utilisateur : "un petit bouton aussi pour
        # le nouvel onglet") -- même rangée flottante, même patron que
        # bouton_precedent/bouton_suivant. Émet "newTab" (déjà supportée par le
        # serveur et par les deux moteurs, nodriver et Camoufox) vers about:blank ;
        # le nouvel onglet devient l'onglet actif côté sAutoniax, donc le rendu
        # le suit. La liste d'onglets du panneau se met à jour à l'ouverture
        # de la liste déroulante ou via son bouton Rafraîchir.
        self.bouton_nouvel_onglet = QToolButton(self.panneau.colonne_image)
        self.bouton_nouvel_onglet.setObjectName("APIFeaturesMenuButton")
        self.bouton_nouvel_onglet.setIcon(qta.icon("mdi6.tab-plus", color=Mocha.subtext0))
        self.bouton_nouvel_onglet.setIconSize(QSize(14, 14))
        self.bouton_nouvel_onglet.setCursor(Qt.PointingHandCursor)
        self.bouton_nouvel_onglet.setToolTip("Nouvel onglet (page d'ouverture par défaut)")
        self.bouton_nouvel_onglet.clicked.connect(
            lambda: self._emettre_commande("newTab", url="autoniax:accueil")   # résolu côté instance (_url_nouvel_onglet)
        )

        # --- PATCH (mode sélection multiple sur le rendu réseau, demande
        # explicite utilisateur) -- bouton ciseau, MÊME rangée flottante
        # nord-ouest que les points de statut/boutons de navigation
        # ci-dessus (même patron QToolButton/APIFeaturesMenuButton/
        # qta.icon/PointingHandCursor). Clic gauche = démarre une
        # sélection de zone sur self._derniere_image (cf.
        # _demarrer_selection_zone) ; clic droit = ouvre une galerie de
        # tout ce qui a déjà été sélectionné (cf. _afficher_galerie_
        # captures_selectionnees, demande explicite utilisateur : "si on
        # fait un clic droit sur le bouton en question sa affiche tout
        # ce qui a deja ete capturer").
        self.bouton_selection_zone = QToolButton(self.panneau.colonne_image)
        self.bouton_selection_zone.setObjectName("APIFeaturesMenuButton")
        self.bouton_selection_zone.setIcon(qta.icon("mdi6.content-cut", color=Mocha.subtext0))
        self.bouton_selection_zone.setIconSize(QSize(14, 14))
        self.bouton_selection_zone.setCursor(Qt.PointingHandCursor)
        self.bouton_selection_zone.setToolTip(
            "Sélectionner une zone de l'image (Espace valide, Échap quitte) --\n"
            "clic droit : voir tout ce qui a déjà été sélectionné."
        )
        self.bouton_selection_zone.clicked.connect(self._demarrer_selection_zone)
        self.bouton_selection_zone.setContextMenuPolicy(Qt.CustomContextMenu)
        self.bouton_selection_zone.customContextMenuRequested.connect(
            lambda pos: self._afficher_galerie_captures_selectionnees()
        )

        # --- Bouton poubelle, juste à côté -- vide _captures_selectionnees
        # (demande explicite utilisateur : "a coter de licone de ciseau
        # [...] tu met une [...] icone [...] qui vas permettre de
        # suprimer tout cequi a ete selectionner"). Pas de confirmation
        # (même esprit que le reste de l'app pour les actions réversibles
        # à faible coût -- rien n'est encore importé tant que le bouton
        # de ComposantsScreen n'a pas été cliqué, cf. sa docstring).
        self.bouton_vider_selection = QToolButton(self.panneau.colonne_image)
        self.bouton_vider_selection.setObjectName("APIFeaturesMenuButton")
        self.bouton_vider_selection.setIcon(qta.icon("mdi6.trash-can-outline", color=Mocha.subtext0))
        self.bouton_vider_selection.setIconSize(QSize(14, 14))
        self.bouton_vider_selection.setCursor(Qt.PointingHandCursor)
        self.bouton_vider_selection.setToolTip("Supprimer toutes les sélections en attente")
        self.bouton_vider_selection.clicked.connect(self._vider_captures_selectionnees)

        # --- AJOUT (demande explicite utilisateur : "une barre d'adresse dans
        # l'interface de pilotage distant, on colle un lien là-bas, on valide,
        # ça navigue directement vers là") -- champ de saisie dans la MÊME
        # rangée flottante nord-ouest, à droite de bouton_vider_selection
        # (même patron : enfant direct de colonne_image, geometry() posée à la
        # main dans _repositionner_point_statut_connexion). Entrée émet
        # "navigate" (action déjà supportée par le serveur et par les deux
        # moteurs, nodriver et Camoufox) : navigue l'onglet ACTIF sur place,
        # sans en ouvrir un nouveau (cf. _sur_validation_adresse).
        self.champ_adresse = QLineEdit(self.panneau.colonne_image)
        self.champ_adresse.setFixedHeight(self._BOUTON_NAV_TAILLE)
        self.champ_adresse.setPlaceholderText("Coller un lien puis Entrée…")
        self.champ_adresse.setClearButtonEnabled(True)
        self.champ_adresse.setToolTip("Adresse : colle un lien puis Entrée pour naviguer sur l'onglet actif.")
        self.champ_adresse.setStyleSheet(
            f"QLineEdit {{ background-color: {Mocha.mantle}; color: {Mocha.text}; "
            f"border: 1px solid {Mocha.surface1}; border-radius: 4px; padding: 0px 6px; font-size: 11px; }}"
            f"QLineEdit:focus {{ border: 1px solid {Mocha.blue}; }}"
        )
        self.champ_adresse.returnPressed.connect(self._sur_validation_adresse)

        # --- AJOUT (demande explicite utilisateur : \"un petit bouton icône à
        # côté de la barre d'adresse qui permet de copier l'adresse de
        # l'onglet actuel\") -- même patron que les autres boutons de la
        # rangée nord-ouest (enfant direct de colonne_image, geometry() posée
        # à la main dans _repositionner_point_statut_connexion). Le clic
        # demande listTabs au sAutoniax (url + drapeau \"actif\" par onglet) ;
        # la réponse est traitée dans traiter_resultat_copie_distante.
        self.bouton_copier_adresse = QToolButton(self.panneau.colonne_image)
        self.bouton_copier_adresse.setObjectName("APIFeaturesMenuButton")
        self.bouton_copier_adresse.setIcon(qta.icon("mdi6.content-copy", color=Mocha.subtext0))
        self.bouton_copier_adresse.setIconSize(QSize(14, 14))
        self.bouton_copier_adresse.setCursor(Qt.PointingHandCursor)
        self.bouton_copier_adresse.setFocusPolicy(Qt.NoFocus)  # sinon Espace (raccourci Auto/Manuel) l'activerait
        self.bouton_copier_adresse.setToolTip("Copier l'adresse de l'onglet actif")
        self.bouton_copier_adresse.clicked.connect(self._sur_clic_copier_adresse)

        # --- PATCH -- badge texte AUTO/MANUEL, TOUJOURS visible (demande
        # explicite utilisateur : "je veux que tu met a un indicatuer
        # visuels toujour en idicie qui vas directement dit si le
        # rafraicheasment automaiqure est actier ou pas") -- contrairement
        # à self.panneau.label_statut_rafraichissement (existant, texte
        # long "Automatique -- X im/s"/"Manuel -- ...", mais vit DANS
        # colonne_reglages -- le panneau flottant qui ne s'affiche qu'au
        # survol du bord droit, cf. _verifier_survol_panneau_flottant),
        # CE badge est un simple QLabel posé en overlay direct sur
        # colonne_image (même patron que point_statut_connexion/
        # point_statut_execution/boutons de navigation ci-dessus),
        # visible en permanence quel que soit l'état du panneau flottant.
        #
        # Positionnement demandé explicitement : "je veux que tu met
        # maintenant sur la collen, pas sur la ligne denhaut" -- PAS sur
        # la même rangée horizontale que les points de statut/boutons de
        # navigation/ciseau/poubelle, mais juste EN DESSOUS, en colonne,
        # toujours dans ce même coin nord-ouest (cf. _repositionner_
        # point_statut_connexion pour la géométrie exacte).
        self.badge_mode_rafraichissement = QLabel(self.panneau.colonne_image)
        self.badge_mode_rafraichissement.setAlignment(Qt.AlignCenter)
        self.badge_mode_rafraichissement.setFixedHeight(18)
        # setToolTip posé dans _rafraichir_badge_mode_rafraichissement
        # (texte variable selon l'état, cf. cette méthode) -- inutile de
        # dupliquer un texte ici qui serait de toute façon écrasé au
        # premier appel (fait juste après, en fin de __init__).

        # colonne_image.installEventFilter(self) est déjà posé par
        # _preparer_mode_overlay (cf. plus bas) au moment où le mode
        # overlay démarre réellement -- réinstallé ici aussi, sans effet
        # de doublon néfaste : Qt redistribue simplement CHAQUE event à
        # eventFilter autant de fois que installEventFilter a été
        # appelé pour ce (watched, filtre) donné, donc AU PIRE le
        # QEvent.Resize appellerait _repositionner_panneau_flottant()
        # deux fois d'affilée une fois l'overlay actif -- idempotent
        # (juste un recalcul de geometry identique), sans conséquence
        # visible. Nécessaire ICI pour que ce point soit repositionné
        # correctement dès les tout premiers redimensionnements, avant
        # même que _preparer_mode_overlay ait pu tourner.
        self.panneau.colonne_image.installEventFilter(self)
        self._repositionner_point_statut_connexion()
        self.point_statut_connexion.raise_()
        self.point_statut_execution.raise_()
        self.bouton_precedent.raise_()
        self.bouton_suivant.raise_()
        self.bouton_nouvel_onglet.raise_()
        self.bouton_selection_zone.raise_()
        self.bouton_vider_selection.raise_()
        self.champ_adresse.raise_()
        self.badge_mode_rafraichissement.raise_()
        self._rafraichir_badge_mode_rafraichissement()

    def _repositionner_point_statut_connexion(self):
        """Replaque point_statut_connexion ET point_statut_execution dans
        le coin NORD-OUEST de colonne_image, l'un à côté de l'autre
        (petite marge constante entre les deux, cf. _POINT_STATUT_
        ESPACEMENT) -- appelé à la construction et à chaque
        redimensionnement de colonne_image (cf. eventFilter, QEvent.
        Resize, même déclencheur que _repositionner_panneau_flottant).

        PATCH -- bouton_precedent/bouton_suivant (cf. leur commentaire
        dans __init__) enchaînés juste après point_statut_execution, même
        ligne, même espacement constant -- toujours dans ce même coin
        flottant, jamais dans l'entête (colonne_reglages) où vivent les
        toggles case_auto_a_ouverture/case_ajuster_a_la_fenetre."""
        self.point_statut_connexion.setGeometry(
            self._POINT_STATUT_MARGE, self._POINT_STATUT_MARGE,
            self._POINT_STATUT_DIAMETRE, self._POINT_STATUT_DIAMETRE,
        )
        self.point_statut_connexion.raise_()
        self.point_statut_execution.setGeometry(
            self._POINT_STATUT_MARGE + self._POINT_STATUT_DIAMETRE + self._POINT_STATUT_ESPACEMENT,
            self._POINT_STATUT_MARGE,
            self._POINT_STATUT_DIAMETRE, self._POINT_STATUT_DIAMETRE,
        )
        self.point_statut_execution.raise_()
        x_apres_points = (
            self._POINT_STATUT_MARGE + 2 * self._POINT_STATUT_DIAMETRE + self._POINT_STATUT_ESPACEMENT
            + self._POINT_STATUT_ESPACEMENT
        )
        # Centré verticalement sur les points de statut (10px) plutôt
        # qu'aligné en haut -- les boutons (20px) sont plus grands que les
        # points, un simple alignement sur la marge commune les ferait
        # paraître décalés vers le bas par rapport aux points.
        y_boutons = self._POINT_STATUT_MARGE - (self._BOUTON_NAV_TAILLE - self._POINT_STATUT_DIAMETRE) // 2
        self.bouton_precedent.setGeometry(
            x_apres_points, y_boutons, self._BOUTON_NAV_TAILLE, self._BOUTON_NAV_TAILLE,
        )
        self.bouton_precedent.raise_()
        self.bouton_suivant.setGeometry(
            x_apres_points + self._BOUTON_NAV_TAILLE + self._POINT_STATUT_ESPACEMENT,
            y_boutons, self._BOUTON_NAV_TAILLE, self._BOUTON_NAV_TAILLE,
        )
        self.bouton_suivant.raise_()
        # PATCH (mode sélection multiple) -- bouton_selection_zone/
        # bouton_vider_selection enchaînés juste après bouton_suivant,
        # même ligne, même espacement constant que le reste de cette
        # rangée flottante nord-ouest.
        self.bouton_nouvel_onglet.setGeometry(
            x_apres_points + 2 * (self._BOUTON_NAV_TAILLE + self._POINT_STATUT_ESPACEMENT),
            y_boutons, self._BOUTON_NAV_TAILLE, self._BOUTON_NAV_TAILLE,
        )
        self.bouton_nouvel_onglet.raise_()
        x_ciseau = x_apres_points + 3 * (self._BOUTON_NAV_TAILLE + self._POINT_STATUT_ESPACEMENT)
        self.bouton_selection_zone.setGeometry(
            x_ciseau, y_boutons, self._BOUTON_NAV_TAILLE, self._BOUTON_NAV_TAILLE,
        )
        self.bouton_selection_zone.raise_()
        self.bouton_vider_selection.setGeometry(
            x_ciseau + self._BOUTON_NAV_TAILLE + self._POINT_STATUT_ESPACEMENT,
            y_boutons, self._BOUTON_NAV_TAILLE, self._BOUTON_NAV_TAILLE,
        )
        self.bouton_vider_selection.raise_()
        # AJOUT (barre d'adresse) -- à droite de la poubelle, même ligne,
        # étirée jusqu'au bord droit de colonne_image (plafonnée à 520 px
        # pour rester discrète) ; masquée si la place restante est trop
        # étroite pour être utilisable. Le badge ci-dessous reste calé sur
        # la rangée d'icônes seule (largeur_rangee ne dépend pas du champ).
        x_adresse = (
            self.bouton_vider_selection.x() + self.bouton_vider_selection.width()
            + self._POINT_STATUT_ESPACEMENT
        )
        # PATCH : le bouton \"copier l'adresse\" réserve sa place à droite du champ.
        largeur_adresse = min(
            520,
            self.panneau.colonne_image.width() - x_adresse - self._POINT_STATUT_MARGE
            - self._BOUTON_NAV_TAILLE - self._POINT_STATUT_ESPACEMENT,
        )
        if largeur_adresse >= 120:
            self.champ_adresse.setGeometry(x_adresse, y_boutons, largeur_adresse, self._BOUTON_NAV_TAILLE)
            self.champ_adresse.setVisible(True)
            self.champ_adresse.raise_()
            self.bouton_copier_adresse.setGeometry(
                x_adresse + largeur_adresse + self._POINT_STATUT_ESPACEMENT,
                y_boutons, self._BOUTON_NAV_TAILLE, self._BOUTON_NAV_TAILLE,
            )
            self.bouton_copier_adresse.setVisible(True)
            self.bouton_copier_adresse.raise_()
        else:
            self.champ_adresse.setVisible(False)
            self.bouton_copier_adresse.setVisible(False)
        # PATCH (badge AUTO/MANUEL, demande explicite utilisateur : "je
        # veux que tu met maintenant sur la collen, pas sur la ligne
        # denhaut") -- EN DESSOUS de la rangée d'icônes ci-dessus (pas à
        # sa suite horizontale), aligné à gauche sur point_statut_
        # connexion (même marge X que le tout premier point de statut),
        # largeur étirée jusqu'à couvrir toute la rangée du dessus pour
        # rester lisible quel que soit le texte ("Automatique"/"Manuel").
        largeur_rangee = (
            self.bouton_vider_selection.x() + self.bouton_vider_selection.width()
            - self._POINT_STATUT_MARGE
        )
        y_badge = y_boutons + self._BOUTON_NAV_TAILLE + self._POINT_STATUT_ESPACEMENT
        self.badge_mode_rafraichissement.setGeometry(
            self._POINT_STATUT_MARGE, y_badge, largeur_rangee, self.badge_mode_rafraichissement.height(),
        )
        self.badge_mode_rafraichissement.raise_()

    def definir_statut_derniere_execution(self, couleur_hex: str, tooltip: str):
        """PATCH -- point d'entrée unique pour piloter point_statut_
        execution depuis l'extérieur (cf. TaskConfigScreen._rafraichir_
        bouton_global, même palette que BadgeStatutNotebook.definir_
        statut). Ne fait rien de plus qu'appliquer la couleur/tooltip --
        AUCUNE logique de décision ici (contrairement à _definir_point_
        statut_connexion, qui décide lui-même connecté/non à partir de
        definir_image) : c'est TaskConfigScreen qui sait déjà quel est le
        dernier statut de séquence, ce widget ne fait qu'afficher ce
        qu'on lui donne, exactement comme BadgeStatutNotebook.definir_
        statut()."""
        self.point_statut_execution.setStyleSheet(
            f"background-color: {couleur_hex}; border-radius: {self._POINT_STATUT_DIAMETRE // 2}px;"
        )
        self.point_statut_execution.setToolTip(tooltip)

    # ------------------------------------------------------------------
    # Mode sélection multiple sur le rendu réseau (PATCH -- demande
    # explicite utilisateur : plutôt que d'obliger à recliquer sur
    # "capturer depuis le rendu réseau" (ComposantsScreen) juste avant
    # CHAQUE création de composant, on peut désormais découper autant de
    # zones que voulu directement dans CE panneau, à tête reposée -- ces
    # découpes s'accumulent dans self._captures_selectionnees jusqu'à
    # leur import effectif (ou suppression manuelle via bouton_vider_
    # selection), cf. _start_capture_composant_depuis_rendu_reseau côté
    # ComposantsScreen qui consomme cette liste.
    # ------------------------------------------------------------------
    def _demarrer_selection_zone(self):
        """Clic sur bouton_selection_zone -- ouvre SelectionZoneOverlay
        SUR self._derniere_image (même widget/mécanisme de tracé libre/
        Espace-valide/Échap-annule que la capture bureau classique de
        ComposantsScreen, cf. sa docstring de classe), PAS sur le
        bureau réel : l'image de base est déjà en mémoire (dernière
        frame reçue du sAutoniax distant), inutile de masquer quoi que
        ce soit ni de capturer l'écran physique.

        Décision explicite utilisateur : une seule zone par ouverture de
        l'overlay -- Espace valide ET ferme (contrairement à
        ComposantsScreen._capturer_bureau_et_afficher_overlay où
        l'overlay reste, ici c'est CE bouton qu'on reclique pour
        enchaîner une nouvelle sélection).

        CORRECTIF (bug rapporté -- image plus grande que l'écran :
        "quand je slide dabrord vers le bas [...] apres le clic sur le
        bouton de ciseau [...] le slide se reinitialise" / "cest un
        probleme daffihcage, si les dimeniond elimasont plus grand que
        lecran actuels cest nromal que sa affihce la zonne pardefut, il
        faut que tu change sa") -- SelectionZoneOverlay gère désormais
        son propre défilement interne pour une image plus grande que
        l'écran (cf. sa docstring de classe complète), à condition de
        recevoir un offset_initial : ici, la position ACTUELLE des
        barres de défilement d'apercu_scroll, pour que l'overlay s'ouvre
        en affichant exactement la même portion de l'image que ce que
        l'utilisateur regardait juste avant de cliquer sur le ciseau. En
        mode échelle réelle (self._ajuster_a_la_fenetre == False, cf.
        _appliquer_pixmap_a_l_echelle) la conversion est directe -- 1
        pixel de scroll widget = 1 pixel d'image, aucun facteur d'échelle
        à appliquer. En mode "Ajusté à la fenêtre" (image redimensionnée
        pour tenir dans le panneau, jamais de scrollbars dans ce mode,
        cf. sa docstring), les deux valeurs valent toujours 0 -- l'offset
        transmis est alors simplement (0, 0), sans changement de
        comportement par rapport à avant ce correctif."""
        if self._derniere_image is None or self._derniere_image.isNull():
            self._notify_status_selection("Aucune image de rendu disponible pour le moment.")
            return
        # Image de référence mémorisée à PART (self._image_en_cours_de_
        # selection), indépendamment de l'attribut privé de l'overlay :
        # _sur_zone_selection_validee doit pouvoir la retrouver même si
        # self._derniere_image a déjà changé (nouvelle frame reçue)
        # pendant que l'overlay était ouvert -- la découpe doit porter
        # sur l'image TELLE QU'AFFICHÉE au moment du clic sur le ciseau,
        # pas sur une frame plus récente arrivée entre-temps.
        self._image_en_cours_de_selection = self._derniere_image
        offset_initial = QPoint(
            self.panneau.apercu_scroll.horizontalScrollBar().value(),
            self.panneau.apercu_scroll.verticalScrollBar().value(),
        )
        # CORRECTIF (bug rapporté -- défilement horizontal bloqué en
        # multi-écrans, cf. docstring de SelectionZoneOverlay.__init__
        # pour le diagnostic complet) -- self.window().screen() donne
        # l'écran RÉEL où cette fenêtre (déjà affichée à ce stade) se
        # trouve concrètement, fiable même en multi-moniteurs -- à
        # l'inverse de self.screen() appelé côté SelectionZoneOverlay
        # avant son tout premier affichage, qui pouvait retomber sur le
        # mauvais écran (primaire par défaut).
        ecran_reel = self.window().screen()
        # Référence forte conservée le temps de la sélection (même
        # raison que ComposantsScreen._overlay_capture : éviter le
        # garbage-collect prématuré).
        self._overlay_selection_zone = SelectionZoneOverlay(
            self._image_en_cours_de_selection, offset_initial=offset_initial, ecran=ecran_reel,
        )
        self._overlay_selection_zone.zone_selectionnee.connect(self._sur_zone_selection_validee)
        self._overlay_selection_zone.annulee.connect(self._sur_selection_annulee)
        self._overlay_selection_zone.showFullScreen()
        self._overlay_selection_zone.activateWindow()


    def _sur_zone_selection_validee(self, rect: QRect):
        """Espace dans SelectionZoneOverlay -- découpe la zone choisie
        dans l'image d'origine et l'AJOUTE à _captures_selectionnees
        (jamais un remplacement : demande explicite utilisateur, "les
        image en selction odit etre coserver et non suppromimer").
        L'overlay s'est déjà fermé de lui-même (cf. SelectionZoneOverlay.
        keyPressEvent) -- on relâche juste la référence forte ici."""
        image_source = self._image_en_cours_de_selection
        self._overlay_selection_zone = None
        self._image_en_cours_de_selection = None
        if image_source is None or image_source.isNull():
            return
        image_decoupee = image_source.copy(rect)
        self._captures_selectionnees.append(image_decoupee)
        self._notify_status_selection(
            f"Zone ajoutée à la sélection ({len(self._captures_selectionnees)} en attente)."
        )

    def _sur_selection_annulee(self):
        """Échap dans SelectionZoneOverlay -- quitte le mode sélection
        SANS RIEN PERDRE de ce qui est déjà dans _captures_selectionnees
        (demande explicite utilisateur, cf. docstring de classe)."""
        self._overlay_selection_zone = None
        self._image_en_cours_de_selection = None

    def _vider_captures_selectionnees(self):
        """Bouton poubelle -- vide entièrement _captures_selectionnees."""
        if not self._captures_selectionnees:
            return
        self._captures_selectionnees = []
        self._notify_status_selection("Sélections en attente supprimées.")
        if self._galerie_captures is not None:
            self._galerie_captures.close()

    def _notify_status_selection(self, message: str):
        """Petit relais texte -- ce widget n'a pas de barre de statut
        propre (contrairement à ComposantsScreen._notify_status),
        affiché uniquement via le tooltip du bouton ciseau, glanceable
        sans ouvrir la galerie complète."""
        self.bouton_selection_zone.setToolTip(
            f"{message}\n\n"
            "Sélectionner une zone de l'image (Espace valide, Échap quitte) --\n"
            "clic droit : voir tout ce qui a déjà été sélectionné."
        )

    def _afficher_galerie_captures_selectionnees(self):
        """Clic droit sur bouton_selection_zone -- demande explicite
        utilisateur : "si on fait un clic droit sur le bouton en
        question sa affiche tout ce qui a deja ete capturer". Ouvre une
        petite popup galerie (cf. GaleriePopupCapturesReseau) avec une
        miniature par capture déjà accumulée, chacune supprimable
        individuellement.

        WA_DeleteOnClose (même patron que les autres popups top-level de
        ce fichier, cf. DialogueAjoutCle/etc.) : l'objet Python/Qt est
        détruit dès la fermeture (croix, Échap, ou fermeture programmatique
        via _vider_captures_selectionnees) -- self._galerie_captures est
        remis à None via le signal destroyed plutôt que de risquer un
        appel ultérieur sur un widget C++ déjà détruit."""
        if self._galerie_captures is not None:
            self._galerie_captures.close()
        self._galerie_captures = GaleriePopupCapturesReseau(self._captures_selectionnees, self)
        self._galerie_captures.setAttribute(Qt.WA_DeleteOnClose)
        self._galerie_captures.destroyed.connect(self._sur_galerie_captures_detruite)
        self._galerie_captures.demande_suppression_index.connect(self._supprimer_capture_selectionnee)
        self._galerie_captures.show()
        self._galerie_captures.activateWindow()

    def _sur_galerie_captures_detruite(self):
        self._galerie_captures = None

    def _supprimer_capture_selectionnee(self, index: int):
        """Suppression individuelle depuis la galerie (bouton "x" sur
        une vignette) -- retire uniquement l'entrée visée, conserve les
        autres et leur ordre."""
        if 0 <= index < len(self._captures_selectionnees):
            del self._captures_selectionnees[index]
            self._notify_status_selection(
                f"Zone retirée de la sélection ({len(self._captures_selectionnees)} en attente)."
            )

    def _sur_redimensionnement_apercu(self):
        # Mode "échelle réelle" (par défaut, self._ajuster_a_la_fenetre
        # == False) : rien à recalculer, cf. commentaire historique
        # ci-dessous -- redimensionner apercu_scroll ne change alors que
        # l'apparition/disparition des scrollbars, déjà géré par
        # QScrollArea. Mode "Ajuster à la fenêtre" (PATCH, cf. docstring
        # de case_ajuster_a_la_fenetre) : le pixmap affiché doit au
        # contraire être RECALCULÉ à chaque redimensionnement du panneau
        # -- sans ça, l'image resterait à l'ancienne taille jusqu'à la
        # prochaine frame reçue, un décalage visible pendant qu'on
        # redimensionne la fenêtre.
        if self._ajuster_a_la_fenetre and self._derniere_image is not None:
            self._appliquer_pixmap_a_l_echelle(self._derniere_image)

    def _sur_bascule_ajuster_a_la_fenetre(self, actif: bool):
        """PATCH (toggle "Ajuster à la fenêtre", cf. docstring de
        case_ajuster_a_la_fenetre dans __init__) -- bascule apercu_scroll
        entre les deux modes d'affichage :
        - Décoché (échelle réelle, comportement par défaut inchangé) :
          setWidgetResizable(False), apercu_label garde le pixmap à sa
          taille réelle en pixels, scrollbars si besoin (cf. docstring
          de _appliquer_pixmap_a_l_echelle).
        - Coché (ajusté à la fenêtre) : setWidgetResizable(True) --
          apercu_scroll impose alors sa propre taille à apercu_label
          (plus de scrollbars, plus besoin de resize() manuel dessus),
          et le pixmap posé est redimensionné (ratio conservé, cf.
          _appliquer_pixmap_a_l_echelle) à la taille ACTUELLE du label
          à chaque frame.
        Réapplique immédiatement la dernière image reçue (si une frame
        est déjà là) pour un basculement instantané, sans attendre la
        prochaine capture."""
        self._ajuster_a_la_fenetre = actif
        self.panneau.apercu_scroll.setWidgetResizable(actif)
        if self._derniere_image is not None:
            self._appliquer_pixmap_a_l_echelle(self._derniere_image)

    def _appliquer_pixmap_a_l_echelle(self, image: QImage):
        """Pose le pixmap sur apercu_label -- deux modes, cf. docstring de
        _sur_bascule_ajuster_a_la_fenetre :

        - Échelle réelle (self._ajuster_a_la_fenetre == False, par défaut
          -- demande explicite utilisateur d'origine : "lechelle a
          linterireru de limage doit etre reel") : jamais mis à l'échelle,
          apercu_label vit dans apercu_scroll (QScrollArea, setWidget
          Resizable(False), cf. PanneauRenduInstance.__init__). Si
          l'image est plus grande que la zone visible du panneau, des
          barres de défilement horizontale ET verticale apparaissent
          automatiquement, au lieu de réduire l'image.
        - Ajusté à la fenêtre (self._ajuster_a_la_fenetre == True, PATCH
          -- demande explicite utilisateur : "es ce que sa affiche
          limage avec les dimesion rell du navigatuer, le problme es
          t que sa varie en fontion du fongerprinting" -- résolu en
          laissant le choix, pas en imposant un seul comportement) :
          redimensionné (Qt.KeepAspectRatio, jamais déformé) à la taille
          ACTUELLE de la zone visible d'apercu_scroll, quelle que soit
          la résolution réelle envoyée par le fingerprint du profil --
          plus jamais de scrollbars ni de variation visible de taille
          d'un profil à l'autre, au prix d'un éventuel flou si l'image
          source est plus petite que le panneau."""
        pixmap = QPixmap.fromImage(image)
        self.panneau.apercu_label.setText("")
        if self._ajuster_a_la_fenetre:
            taille_cible = self.panneau.apercu_scroll.viewport().size()
            if taille_cible.width() > 0 and taille_cible.height() > 0:
                pixmap = pixmap.scaled(taille_cible, Qt.KeepAspectRatio, Qt.SmoothTransformation)
            self.panneau.apercu_label.setPixmap(pixmap)
            # setWidgetResizable(True) fait déjà suivre apercu_label à la
            # taille du viewport -- pas de resize() manuel ici (cf. mode
            # échelle réelle juste en dessous, où il reste nécessaire).
            return
        # CORRECTIF (bug rapporté : "quand jessaie de faire le scroll sa
        # ne fonctionne pas [...] le slide se reinitilaise" -- ici plus
        # précisément : "quand je slide dabrord vers le bas [...] apres
        # le clic sur le bouton de ciseau [...] le slide se reinitialise,
        # ce nes plus en bas cest en haut") -- en mode échelle réelle,
        # CHAQUE nouvelle frame reçue (definir_image, y compris celles
        # arrivées pendant/juste après le clic sur le ciseau, en mode
        # Auto notamment) repose ici un pixmap et appelle resize() sur
        # apercu_label. Qt réinitialise alors la position de défilement
        # du QScrollArea parent (apercu_scroll) au coin haut-gauche dès
        # que son widget interne est redimensionné, MÊME quand la
        # nouvelle taille est identique à l'ancienne -- l'utilisateur
        # perd donc son scroll vertical/horizontal à chaque frame, pas
        # seulement au clic sur le ciseau (le ciseau ne faisait que
        # rendre le problème visible, en déclenchant/coïncidant avec une
        # frame). Fix : mémoriser la position AVANT resize() et la
        # restaurer juste après -- un no-op si la taille de l'image n'a
        # pas changé (cas normal, flux vidéo à résolution fixe), mais qui
        # laisse aussi le comportement correct si la taille a réellement
        # changé (la restauration est simplement bornée par Qt lui-même
        # via setValue, qui clamp à la nouvelle plage valide).
        barre_h = self.panneau.apercu_scroll.horizontalScrollBar()
        barre_v = self.panneau.apercu_scroll.verticalScrollBar()
        position_h = barre_h.value()
        position_v = barre_v.value()
        self.panneau.apercu_label.setPixmap(pixmap)
        # Nécessaire car apercu_scroll a setWidgetResizable(False) :
        # apercu_label ne suit plus automatiquement la taille du pixmap
        # posé, il faut l'imposer explicitement pour que le QScrollArea
        # calcule les bonnes plages/barres de défilement.
        self.panneau.apercu_label.resize(pixmap.size())
        barre_h.setValue(position_h)
        barre_v.setValue(position_v)

    def _sur_bascule_mode_auto(self, actif: bool):
        self._rafraichir_statut_local()
        if actif:
            self.taux_capture_change.emit(self.panneau.fps_auto_spin.value())
        else:
            # 0.0 = "désactive le flux continu" côté TaskConfigScreen/
            # sAutoniax (cf. _sur_taux_capture_reseau_change) -- pas de
            # valeur négative/sentinelle ad hoc, 0 est déjà hors de la
            # plage utile (fps_auto_spin.setRange(0.2, 30.0)) donc sans
            # ambiguïté avec un taux réel choisi par l'utilisateur.
            self.taux_capture_change.emit(0.0)

    def _sur_bascule_auto_a_ouverture(self, actif: bool):
        """Toggle de l'entête (cf. self.case_auto_a_ouverture) -- ne
        pilote QUE self._auto_a_ouverture, jamais case_auto directement :
        décocher ce toggle laisse le mode Auto/Manuel EN L'ÉTAT (que ce
        soit actif ou non au moment du clic), il désactive seulement le
        comportement automatique futur (ouverture -> auto, Échap ->
        manuel), cf. afficher_par_dessus_tout et keyPressEvent."""
        self._auto_a_ouverture = actif

    def _sur_changement_taux(self, valeur: float):
        if self.panneau.case_auto.isChecked():
            self.taux_capture_change.emit(valeur)

    def _rafraichir_statut_local(self):
        if self.panneau.case_auto.isChecked():
            self.panneau.label_statut_rafraichissement.setText(
                f"Automatique -- {self.panneau.fps_auto_spin.value():.1f} im/s (sAutoniax distant)."
            )
        else:
            self.panneau.label_statut_rafraichissement.setText(
                "Manuel -- utilisez \"Rafraîchir\" pour une capture ponctuelle."
            )
        # PATCH (badge AUTO/MANUEL toujours visible, demande explicite
        # utilisateur) -- même point d'entrée central que label_statut_
        # rafraichissement ci-dessus : _rafraichir_statut_local est déjà
        # appelée à CHAQUE changement de mode, quelle qu'en soit la
        # source (case_auto cliquée directement, Espace via keyPressEvent,
        # bascule automatique à l'ouverture/Échap) -- cf. _sur_bascule_
        # mode_auto, seul appelant de cette méthode. Se contente d'un
        # getattr défensif : cette méthode peut être appelée AVANT que
        # badge_mode_rafraichissement n'existe (aucun cas connu
        # aujourd'hui, mais _rafraichir_statut_local est déjà tolérante
        # par nature -- mieux vaut ne rien afficher qu'un AttributeError).
        if hasattr(self, "badge_mode_rafraichissement"):
            self._rafraichir_badge_mode_rafraichissement()

    def _rafraichir_badge_mode_rafraichissement(self):
        """Met à jour texte/couleur/tooltip de badge_mode_rafraichissement
        (PATCH -- indicateur permanent, demande explicite utilisateur :
        "je veux que tu met a un indicatuer visuels toujour en idicie qui
        vas directement dit si le rafraicheasment automaiqure est actier
        ou pas") à partir de l'état RÉEL de self.panneau.case_auto --
        aucune logique de décision propre, simple reflet (même esprit que
        _definir_point_statut_connexion juste en dessous)."""
        actif = self.panneau.case_auto.isChecked()
        if actif:
            self.badge_mode_rafraichissement.setText("AUTO")
            self.badge_mode_rafraichissement.setStyleSheet(
                f"background-color: {Mocha.green}; color: {Mocha.crust};"
                f"border-radius: 4px; font-size: 10px; font-weight: 600; padding: 1px 6px;"
            )
            self.badge_mode_rafraichissement.setToolTip(
                "Rafraîchissement automatique actif -- appuyez sur Espace pour repasser en manuel."
            )
        else:
            self.badge_mode_rafraichissement.setText("MANUEL")
            self.badge_mode_rafraichissement.setStyleSheet(
                f"background-color: {Mocha.overlay0}; color: {Mocha.crust};"
                f"border-radius: 4px; font-size: 10px; font-weight: 600; padding: 1px 6px;"
            )
            self.badge_mode_rafraichissement.setToolTip(
                "Rafraîchissement manuel -- appuyez sur Espace pour passer en automatique."
            )

    def _definir_point_statut_connexion(self, connecte: bool, tooltip: str):
        """PATCH -- point de statut nord-ouest (cf. __init__ pour le
        détail complet). Un seul point d'entrée pour les 3 branches de
        definir_image ci-dessous, pour ne jamais dupliquer la couleur
        hex/le style entre elles."""
        couleur = Mocha.green if connecte else Mocha.overlay0
        self.point_statut_connexion.setStyleSheet(
            f"background-color: {couleur}; border-radius: {self._POINT_STATUT_DIAMETRE // 2}px;"
        )
        self.point_statut_connexion.setToolTip(tooltip)

    def definir_image(self, image_b64: Optional[str]):
        """Décode et affiche `image_b64` (WebP, cf. ClientServeurT.
        capture_recue) -- même logique EXACTE que l'ancienne
        FenetreRenduNotebookDistant.definir_image (repli Pillow inclus),
        adaptée pour cibler apercu_label DE PanneauRenduInstance plutôt
        qu'un QLabel dédié."""
        if not image_b64:
            self._derniere_image = None
            self.panneau.apercu_label.setText("Aucune capture reçue pour l'instant.")
            self.panneau.apercu_label.setPixmap(QPixmap())
            self._definir_point_statut_connexion(False, "Connexion à l'instance : aucune capture reçue pour l'instant.")
            return
        image = decoder_image_b64(image_b64)
        if (image is None or image.isNull()) and PILLOW_DISPONIBLE:
            try:
                brut = base64.b64decode(image_b64)
                with PILImage.open(io.BytesIO(brut)) as img_pil:
                    tampon_png = io.BytesIO()
                    img_pil.convert("RGB").save(tampon_png, format="PNG")
                image_secours = QImage()
                if image_secours.loadFromData(QByteArray(tampon_png.getvalue())) and not image_secours.isNull():
                    image = image_secours
            except Exception as e:
                log_reseau_t.debug(f"[TaskReseau/Rendu] repli Pillow de décodage WebP échoué : {e!r}")
        if image is None or image.isNull():
            self._derniere_image = None
            self.panneau.apercu_label.setText("Capture reçue mais illisible (décodage échoué).")
            self.panneau.apercu_label.setPixmap(QPixmap())
            self._definir_point_statut_connexion(False, "Connexion à l'instance : dernière capture reçue illisible.")
            return
        # Redimensionnée à la taille ACTUELLE du panneau, ratio conservé
        # (cf. docstring de _appliquer_pixmap_a_l_echelle) -- plus jamais
        # affichée à sa taille brute en pixels, quelle que soit la
        # résolution demandée côté serveurT (Full/Medium/Économie, B.3).
        self._derniere_image = image
        self._appliquer_pixmap_a_l_echelle(image)
        self._definir_point_statut_connexion(True, "Connexion à l'instance : capture reçue, tout va bien.")

    # -----------------------------------------------------------------
    # PATCH B.4 -- contrôle à distance réel (cf. cahier des charges
    # patchs.md, section B.4). Tout ce qui suit jusqu'à closeEvent capte
    # les événements souris/clavier sur apercu_label (via eventFilter,
    # cf. __init__) quand le toggle "Contrôle à distance" est coché, les
    # convertit en coordonnées RÉELLES de l'image (pas du widget, pas de
    # la résolution affichée/compressée -- cf. _widget_vers_image_xy),
    # et les émet via commande_controle_distance pour que TaskConfigScreen
    # les relaie au sAutoniax ciblé.
    # -----------------------------------------------------------------

    def _sur_bascule_controle_distance(self, actif: bool):
        self._controle_distance_actif = actif
        if not actif:
            self.panneau.bouton_glisser_souris.setChecked(False)
            # Coupure immédiate : annule tout debounce de texte en
            # attente plutôt que de l'envoyer en retard vers une session
            # de contrôle qui vient d'être désactivée délibérément par
            # l'utilisateur -- le texte déjà tapé mais pas encore envoyé
            # est perdu, comportement jugé plus sûr qu'un envoi surprise
            # après coup.
            self._minuteur_debounce_texte.stop()
            self._texte_clavier_en_attente = ""
            # PATCH (cf. docstring de _clic_a_consommer_pour_type_text côté
            # __init__) -- une coupure du contrôle à distance rend obsolète
            # toute hypothèse sur la position du curseur côté page : si le
            # contrôle est réactivé plus tard, le premier type_text doit à
            # nouveau re-cliquer plutôt que de supposer que le curseur est
            # resté où l'avait laissé un type_text d'avant la coupure.
            self._clic_a_consommer_pour_type_text = True
            # PATCH -- même précaution pour le scroll accumulé en attente
            # (cf. _annuler_scroll_en_attente) : pas d'envoi surprise
            # après coupure délibérée du contrôle à distance.
            self._annuler_scroll_en_attente()
        self.panneau.apercu_label.setCursor(Qt.CrossCursor if actif else Qt.ArrowCursor)
        if actif:
            self.panneau.apercu_label.setFocus(Qt.OtherFocusReason)

    def _sur_bascule_glisser_souris(self, actif: bool):
        """Mode Glisser (souris) manuel : le prochain clic gauche sur l'aperçu
        = point de départ, le suivant = point d'arrivée, puis mouse_drag est
        envoyé au sAutoniax et le mode se désactive (une seule fois)."""
        self._glisser_souris_actif = actif
        self._glisser_point_depart = None
        bouton = self.panneau.bouton_glisser_souris
        if actif:
            if not self._controle_distance_actif:
                self.panneau.case_controle_distance.setChecked(True)
            bouton.setText("Glisser : clique le départ")
        else:
            bouton.setText("Glisser")

    def _prochain_requete_id(self) -> str:
        self._compteur_requete_controle += 1
        return f"ctrl-{self._prefixe_requete_controle}-{self._compteur_requete_controle}"

    def _widget_vers_image_xy(self, pos_widget: QPoint) -> Optional[tuple[int, int]]:
        """Convertit une position en coordonnées WIDGET (apercu_label) vers
        des coordonnées de l'image RÉELLE affichée -- même formule que
        ApercuTraceableLabel._rect_pixmap_affiche/_widget_vers_image plus
        haut dans ce fichier (pixmap centré, Qt.KeepAspectRatio) : le
        pixmap ne remplit pas forcément tout le label (bandes vides sur
        les côtés ou en haut/bas selon le ratio), donc une simple règle
        de trois sur la taille du label serait fausse près des bords.

        Retourne None si le point tombe HORS du pixmap affiché (dans une
        bande vide) ou si aucune image n'a encore été reçue -- dans ce
        cas l'appelant doit ignorer l'événement plutôt que d'envoyer une
        coordonnée absurde au sAutoniax."""
        if self._derniere_image is None or self._derniere_image.isNull():
            return None
        label = self.panneau.apercu_label
        taille_image = self._derniere_image.size()
        if taille_image.width() <= 0 or taille_image.height() <= 0:
            return None
        pixmap_mis_echelle_taille = self._derniere_image.size().scaled(
            label.width(), label.height(), Qt.KeepAspectRatio,
        )
        if pixmap_mis_echelle_taille.width() <= 0 or pixmap_mis_echelle_taille.height() <= 0:
            return None
        offset_x = (label.width() - pixmap_mis_echelle_taille.width()) // 2
        offset_y = (label.height() - pixmap_mis_echelle_taille.height()) // 2
        x_dans_pixmap = pos_widget.x() - offset_x
        y_dans_pixmap = pos_widget.y() - offset_y
        if not (0 <= x_dans_pixmap < pixmap_mis_echelle_taille.width()
                and 0 <= y_dans_pixmap < pixmap_mis_echelle_taille.height()):
            return None
        echelle_x = taille_image.width() / pixmap_mis_echelle_taille.width()
        echelle_y = taille_image.height() / pixmap_mis_echelle_taille.height()
        return (
            max(0, min(taille_image.width() - 1, round(x_dans_pixmap * echelle_x))),
            max(0, min(taille_image.height() - 1, round(y_dans_pixmap * echelle_y))),
        )

    def _sur_validation_adresse(self):
        """Entrée dans champ_adresse : navigue l'onglet ACTIF de l'instance
        vers le lien saisi (action réseau "navigate", cf. action_navigate /
        action_camoufox_navigate) -- ne crée jamais de nouvel onglet.
        Un lien sans schéma ("exemple.com/page") reçoit "https://" ; un
        schéma déjà présent (http://, https://, file://, about:, data:...)
        est laissé tel quel."""
        texte = self.champ_adresse.text().strip()
        if not texte:
            return
        if "://" not in texte and not texte.lower().startswith(("about:", "data:", "javascript:", "view-source:")):
            texte = "https://" + texte
        if texte.lower().startswith("javascript:"):
            return  # jamais d'exécution de script via la barre d'adresse
        self.champ_adresse.setText(texte)
        self._emettre_commande("navigate", url=texte)
        self.champ_adresse.clearFocus()

    def _emettre_commande(self, action: str, **params):
        commande = {"action": action, **params}
        self.commande_controle_distance.emit({
            "requete_id": self._prochain_requete_id(),
            "commande": commande,
        })

    def eventFilter(self, obj, event):
        # BUG CORRIGÉ (retour utilisateur : "es ce que tu voir le
        # pourquoi le mode contol distnt ne fontinne toujour pas memem
        # quand je lactive dans lle panneau de rendu") -- cette classe
        # avait DÉJÀ un eventFilter (contrôle à distance sur apercu_label,
        # cf. bloc ci-dessous, présent depuis le PATCH B.4) AVANT l'ajout
        # du mode overlay. Le mode overlay (cf. _preparer_mode_overlay)
        # a introduit une SECONDE définition `def eventFilter` plus bas
        # dans la classe -- en Python, la deuxième définition d'une
        # méthode dans le corps d'une classe REMPLACE entièrement la
        # première (rien à voir avec une surcharge/override normal :
        # c'est la MÊME classe, le nom est juste réassigné deux fois
        # dans son __dict__) -- donc plus aucun événement souris/clavier
        # du contrôle à distance n'était jamais traité, silencieusement,
        # même case_controle_distance coché. Fixé en fusionnant les deux
        # blocs dans une seule et unique méthode ici : contrôle à
        # distance sur apercu_label, PUIS repositionnement de l'overlay
        # sur resize de colonne_image -- les deux widgets surveillés
        # (apercu_label, colonne_image) sont différents, aucun conflit
        # entre les deux blocs.
        if obj is self.panneau.apercu_label and self._controle_distance_actif:
            type_evt = event.type()
            if type_evt == QEvent.MouseButtonPress:
                self._sur_clic_controle_distance(event, double=False)
            elif type_evt == QEvent.MouseButtonDblClick:
                self._sur_clic_controle_distance(event, double=True)
            elif type_evt == QEvent.Wheel:
                self._sur_scroll_controle_distance(event)
                return True  # n'entre jamais en conflit avec un éventuel scroll local du label
            elif type_evt == QEvent.KeyPress:
                if self._sur_touche_controle_distance(event):
                    return True
        # CORRECTIF (bug rapporté : le scroll ne fonctionnait pas) -- cf.
        # __init__ pour le diagnostic complet : dans un QScrollArea réel
        # (self.panneau.apercu_scroll), c'est le VIEWPORT qui reçoit les
        # QEvent.Wheel, pas apercu_label lui-même -- le bloc ci-dessus ne
        # les voyait donc jamais, et Qt scrollait le cadre d'aperçu
        # LOCALEMENT à la place. event.position() est ici relative au
        # VIEWPORT, pas au label (qui peut être décalé si déjà scrollé) --
        # mapTo() traduit vers le repère d'apercu_label AVANT conversion
        # en coordonnées image, pour que _widget_vers_image_xy reste
        # correcte quel que soit l'état de scroll actuel du cadre.
        elif obj is self.panneau.apercu_scroll.viewport() and self._controle_distance_actif:
            if event.type() == QEvent.Wheel:
                point_dans_label = self.panneau.apercu_label.mapFrom(obj, event.position().toPoint())
                self._sur_scroll_controle_distance(event, point_widget_override=point_dans_label)
                return True  # absorbe l'événement : jamais de scroll local du cadre pendant le contrôle à distance
        if obj is self.panneau.colonne_image and event.type() == QEvent.Resize:
            self._repositionner_panneau_flottant()
            self._repositionner_point_statut_connexion()
        return super().eventFilter(obj, event)

    def _sur_clic_controle_distance(self, event, double: bool):
        if event.button() != Qt.LeftButton and event.button() != Qt.RightButton:
            return
        coords = self._widget_vers_image_xy(event.position().toPoint())
        if coords is None:
            return
        x, y = coords
        if self._glisser_souris_actif:
            if event.button() == Qt.RightButton:
                self.panneau.bouton_glisser_souris.setChecked(False)  # annule le glisser en cours
                return
            if self._glisser_point_depart is None:
                self._glisser_point_depart = (x, y)
                self.panneau.bouton_glisser_souris.setText("Glisser : clique l'arrivée")
                return
            x1, y1 = self._glisser_point_depart
            self._clic_a_consommer_pour_type_text = True
            self._derniere_position_clic = (x, y)  # PATCH copie : point d'arrivée = dernière position connue
            self._emettre_commande("mouse_drag", x1=x1, y1=y1, x2=x, y2=y, bouton="gauche", speedPercent=300)
            self.panneau.bouton_glisser_souris.setChecked(False)
            return
        self._derniere_position_clic = (x, y)
        # PATCH (cf. docstring de _clic_a_consommer_pour_type_text côté
        # __init__) -- un vrai clic souris repositionne le curseur côté
        # page : le prochain type_text doit donc re-cliquer normalement,
        # même si un morceau de saisie avait déjà consommé ce flag juste
        # avant (nouvelle saisie qui commence par un nouveau clic manuel
        # sur un AUTRE champ, par exemple).
        self._clic_a_consommer_pour_type_text = True
        bouton = "gauche" if event.button() == Qt.LeftButton else "droite"
        self._emettre_commande(
            "click", x=x, y=y, bouton=bouton, nb_clics=2 if double else 1, speedPercent=900,
        )

    def _sur_scroll_controle_distance(self, event, point_widget_override: Optional[QPoint] = None):
        """point_widget_override (AJOUT -- cf. eventFilter, cas
        apercu_scroll.viewport()) : quand fourni, utilisé À LA PLACE de
        event.position() pour la conversion en coordonnées image --
        nécessaire quand l'événement Wheel provient du VIEWPORT du
        QScrollArea plutôt que d'apercu_label directement (event.position()
        serait alors relative au viewport, pas au label, potentiellement
        décalée si le cadre est déjà scrollé -- cf. mapFrom() côté
        eventFilter, qui produit ce point déjà dans le bon repère avant
        d'appeler ici).

        PATCH (retour utilisateur explicite -- cf. __init__, docstring
        complète sur _CONTROLE_DISTANCE_DEBOUNCE_SCROLL_MS) : ACCUMULE
        au lieu d'émettre directement -- un même geste de molette génère
        plusieurs QEvent.Wheel rapprochés (venant d'apercu_label OU du
        viewport, les deux chemins de eventFilter appellent cette même
        méthode), dont les deltas s'additionnent ici plutôt que de
        partir chacun comme commande séparée. La position retenue est
        celle du DERNIER cran de la rafale (écrase la précédente à
        chaque appel) : la souris ne se déplace normalement pas pendant
        un scroll, mais si elle l'a fait, c'est la position la plus
        récente qui est la plus pertinente pour l'exécution groupée à
        venir."""
        point_widget = point_widget_override if point_widget_override is not None else event.position().toPoint()
        coords = self._widget_vers_image_xy(point_widget)
        if coords is None:
            return
        x, y = coords
        delta = event.angleDelta()
        self._delta_scroll_x_en_attente += float(delta.x())
        self._delta_scroll_y_en_attente += float(delta.y())
        self._derniere_position_scroll = (x, y)
        self._minuteur_debounce_scroll.start()  # redémarre le délai à chaque cran (debounce, pas throttle) -- détecte l'arrêt du geste, pas un simple espacement

    def _sur_debounce_scroll(self):
        """Déclenché après _CONTROLE_DISTANCE_DEBOUNCE_SCROLL_MS de
        silence sur la molette (cf. _sur_scroll_controle_distance).

        CHANGEMENT (demande utilisateur explicite -- "je m'en fous de la
        valeur du scroll réel, simule juste le scroll" / "tout ce que
        l'événement doit transmettre c'est le sens, du haut ou vers le
        bas" / "Remplacer : la molette envoie désormais scroll_simple") --
        n'envoie plus l'action "scroll" (humanisée, delta réel accumulé,
        cf. action_camoufox_scroll, laissée intacte mais plus appelée
        depuis ici). Envoie désormais "scroll_simple" : le sens dominant
        de la rafale accumulée ("haut"/"bas") et l'amplitude réglée dans
        le panneau (self.panneau.spin_amplitude_scroll, cf.
        action_camoufox_scroll_simple côté sAutoniax -- un seul
        page.mouse.wheel() par commande, sans coordonnées côté Playwright
        qui scrolle sous la position ACTUELLE de la souris native).

        PATCH (retour utilisateur : "le scroll [...] sont géré pour
        chrome, je ne pense pas") -- x/y (self._derniere_position_scroll,
        déjà disponible ici, inchangé pour Camoufox qui l'ignore
        simplement) ajoutés à la commande : contrairement à Playwright,
        cdp.input_.dispatch_mouse_event(type_="mouseWheel") EXIGE des
        coordonnées explicites (pas de notion de "position actuelle de
        la souris" côté CDP bas niveau) -- cf. action_scroll_simple côté
        sAutoniax, chemin Chrome/nodriver."""
        delta_x = self._delta_scroll_x_en_attente
        delta_y = self._delta_scroll_y_en_attente
        self._delta_scroll_x_en_attente = 0.0
        self._delta_scroll_y_en_attente = 0.0
        if (delta_x == 0.0 and delta_y == 0.0) or self._derniere_position_scroll is None:
            return
        # Convention Qt (angleDelta) : deltaY positif = molette vers le
        # haut du contenu (scroll vers le HAUT) -- donc sens="haut" quand
        # delta_y > 0, "bas" sinon. Seul le signe compte, pas l'amplitude.
        sens = "haut" if delta_y > 0 else "bas"
        amplitude = self.panneau.spin_amplitude_scroll.value()
        x, y = self._derniere_position_scroll
        self._emettre_commande("scroll_simple", sens=sens, amplitude=amplitude, x=x, y=y)

    def _sur_debounce_scroll_ancien_humanise(self):
        """Ancienne version de _sur_debounce_scroll, conservée ici SANS
        être appelée nulle part (cf. remplacement ci-dessus) -- au cas où
        un retour à l'action "scroll" humanisée serait redemandé plus
        tard, pour ne pas avoir à la réécrire depuis zéro."""
        delta_x = self._delta_scroll_x_en_attente
        delta_y = self._delta_scroll_y_en_attente
        self._delta_scroll_x_en_attente = 0.0
        self._delta_scroll_y_en_attente = 0.0
        if (delta_x == 0.0 and delta_y == 0.0) or self._derniere_position_scroll is None:
            return
        x, y = self._derniere_position_scroll
        self._emettre_commande(
            "scroll", x=x, y=y, deltaX=delta_x, deltaY=delta_y, rapide=True,
        )

    def _annuler_scroll_en_attente(self):
        """Appelée quand le contrôle à distance est désactivé (cf.
        _sur_bascule_controle_distance) -- même précaution que pour le
        texte clavier en attente : un scroll accumulé mais pas encore
        expiré ne doit pas être envoyé en retard vers une session de
        contrôle qui vient d'être désactivée délibérément."""
        self._minuteur_debounce_scroll.stop()
        self._delta_scroll_x_en_attente = 0.0
        self._delta_scroll_y_en_attente = 0.0
        self._derniere_position_scroll = None

    def _sur_touche_controle_distance(self, event) -> bool:
        """Retourne True si l'événement a été consommé (ne doit pas
        remonter plus haut dans Qt). Accumule le texte tapé et relance le
        debounce (cf. __init__, _sur_debounce_texte_clavier) -- pour les
        touches non-imprimables, Entrée, Retour arrière (Backspace) et
        Ctrl+A (sélection tout) sont relayées (PATCH -- demande explicite
        utilisateur : "je veux aussi que les touche entrer soit relayer",
        puis "modifie aussi pour que la touche backspace soit pris en
        compte comme enter", puis "je veux que le combo ctrl+a la
        selection de texte soit aussi géré comme entrer et backspace",
        cf. action_camoufox_press_key/_TOUCHES_CAMOUFOX_AUTORISEES côté
        serveur.py : liste blanche fixe, pas question de relayer une
        touche/un combo arbitraire). Les flèches restent hors périmètre
        de ce patch, limite connue de cette V1.

        Backspace a un traitement légèrement différent d'Entrée : si du
        texte est encore accumulé localement (pas encore flush par le
        debounce, cf. _texte_clavier_en_attente), Backspace en retire
        simplement le DERNIER caractère plutôt que de flush ce texte
        PUIS envoyer un vrai Backspace côté page -- sinon "bonjour" +
        Backspace afficherait d'abord "bonjour" en entier côté page,
        PUIS effacerait son dernier caractère dans un second aller-retour,
        au lieu du résultat attendu ("bonjou" envoyé directement). Un vrai
        press_key("Backspace") n'est envoyé que si rien n'est en attente
        localement -- typiquement pour effacer un caractère déjà présent
        côté page AVANT le début de cette frappe (un champ pré-rempli,
        par exemple).

        Ctrl+A n'a PAS ce même traitement local : contrairement à
        Backspace, sélectionner tout n'a pas de sens à appliquer sur le
        texte accumulé localement (pas encore visible côté page) -- flush
        d'abord (même raison que pour Entrée : l'ordre des commandes
        émises doit correspondre à l'ordre du geste utilisateur), PUIS
        relaie toujours un vrai press_key("Control+a") côté page.

        PATCH (demande explicite utilisateur : "les lettres se mélangent,
        l'ordre décrit n'est pas ce que j'ai saisi" en frappe rapide) --
        event.isAutoRepeat() ignoré EN PREMIER, avant tout traitement.
        Cause identifiée : en frappe rapide, l'OS peut déclencher sa
        répétition clavier native sur une touche à peine relâchée avant
        qu'une autre soit pressée (chevauchement physique normal en
        frappe rapide) -- Qt livre alors PLUSIEURS keyPressEvent pour la
        MÊME touche, coup sur coup, avec isAutoRepeat()=True sur tous
        sauf le tout premier. Cette accumulation (_texte_clavier_en_attente
        += texte) ne filtrait aucun de ces événements : une touche
        pouvait donc s'insérer en double ou intercaler sa répétition au
        milieu de la frappe des touches suivantes déjà en cours de
        traitement par l'OS, produisant exactement le symptôme décrit
        (ordre des lettres différent de la saisie réelle) -- à ne pas
        confondre avec le bug de re-clic (avec_clic) corrigé plus tôt,
        qui lui ne mélangeait pas les lettres mais repositionnait le
        curseur entre deux morceaux. Retourne True (événement consommé,
        ne remonte pas plus haut dans Qt) sans rien accumuler ni relayer
        -- la touche a déjà été prise en compte une première fois par
        l'événement non-répété qui précède celui-ci."""
        if event.isAutoRepeat():
            return True
        # PATCH Ctrl+C -- relaie Ctrl+C à la page distante ; la réponse (texte
        # copié côté instance) est placée dans le presse-papier LOCAL par
        # traiter_resultat_copie_distante(). Ctrl+Inser accepté aussi.
        ctrl_c = (
            event.key() == Qt.Key_C and bool(event.modifiers() & Qt.ControlModifier)
        ) or (
            event.key() == Qt.Key_Insert and bool(event.modifiers() & Qt.ControlModifier)
        )
        if ctrl_c:
            if self._minuteur_debounce_texte.isActive():
                self._minuteur_debounce_texte.stop()
                self._sur_debounce_texte_clavier()
            # PATCH copie : Ctrl+C n'a pas besoin d'un clic préalable (aucune
            # coordonnée utile côté page). Avant : sans clic connu -- ex. texte
            # sélectionné par \"Glisser\" ou Ctrl+A -- la touche était avalée
            # SANS aucun message. On envoie désormais, au centre de l'image à défaut.
            pos_copie = self._derniere_position_clic
            if pos_copie is None:
                img = getattr(self, "_derniere_image", None)
                pos_copie = (img.width() // 2, img.height() // 2) if (img is not None and not img.isNull()) else (0, 0)
            x, y = pos_copie
            requete_id = self._prochain_requete_id()
            self.__dict__.setdefault("_requetes_copie_distante", set()).add(requete_id)
            self.commande_controle_distance.emit({
                "requete_id": requete_id,
                "commande": {"action": "press_key", "x": x, "y": y, "touche": "Control+c"},
            })
            return True
        # PATCH Ctrl+V -- colle le presse-papier LOCAL (celui du PC qui pilote)
        # dans la page distante. Avant : Qt renvoie un event.text() non
        # imprimable ("\x16") pour Ctrl+V, donc le filtre plus bas l'ignorait
        # silencieusement. On relaie l'action "paste" avec le texte explicite
        # (déjà supportée côté instance Chrome ET Camoufox/CloakBrowser, et
        # autorisée par le serveur). Shift+Insert accepté aussi.
        ctrl_v = (
            event.key() == Qt.Key_V and bool(event.modifiers() & Qt.ControlModifier)
        ) or (
            event.key() == Qt.Key_Insert and bool(event.modifiers() & Qt.ShiftModifier)
        )
        if ctrl_v:
            # Flush d'abord le texte tapé juste avant, pour garder l'ordre du geste.
            if self._minuteur_debounce_texte.isActive():
                self._minuteur_debounce_texte.stop()
                self._sur_debounce_texte_clavier()
            if self._derniere_position_clic is None:
                return True
            texte_presse_papier = QGuiApplication.clipboard().text()
            if not texte_presse_papier:
                return True  # presse-papier vide ou non textuel (image, fichier) : rien à coller
            x, y = self._derniere_position_clic
            self._emettre_commande("paste", x=x, y=y, texte=texte_presse_papier)
            # paste reclique à (x, y) côté instance : le prochain type_text doit re-cliquer.
            self._clic_a_consommer_pour_type_text = True
            return True
        ctrl_a = (
            event.key() == Qt.Key_A
            and bool(event.modifiers() & Qt.ControlModifier)
        )
        if event.key() in (Qt.Key_Return, Qt.Key_Enter) or ctrl_a:
            # Flush D'ABORD le texte imprimable déjà accumulé mais pas
            # encore envoyé (cf. _minuteur_debounce_texte) -- sinon
            # Enter/Ctrl+A partirait AVANT le texte tapé juste avant lui
            # dans le même geste utilisateur (ex. "bonjour" + Entrée), un
            # pur problème d'ordre puisque les deux commandes sont émises
            # indépendamment l'une de l'autre.
            if self._minuteur_debounce_texte.isActive():
                self._minuteur_debounce_texte.stop()
                self._sur_debounce_texte_clavier()
            if self._derniere_position_clic is None:
                return True
            x, y = self._derniere_position_clic
            self._emettre_commande("press_key", x=x, y=y, touche="Control+a" if ctrl_a else "Enter")
            # PATCH (cf. docstring de _clic_a_consommer_pour_type_text côté
            # __init__) -- press_key reclique lui-même à (x, y) côté
            # sAutoniax (cf. action_camoufox_press_key), donc le curseur y
            # est repositionné par CE clic : le prochain type_text doit de
            # nouveau re-cliquer, pas supposer que le curseur est resté où
            # l'avait laissé un type_text antérieur.
            self._clic_a_consommer_pour_type_text = True
            return True
        if event.key() == Qt.Key_Backspace:
            # Cf. docstring ci-dessus -- deux cas selon qu'il y a du texte
            # en attente localement ou non.
            if self._texte_clavier_en_attente:
                self._texte_clavier_en_attente = self._texte_clavier_en_attente[:-1]
                self._minuteur_debounce_texte.start()  # relance le debounce (le caractère retiré compte comme une frappe)
                return True
            if self._derniere_position_clic is None:
                return True
            x, y = self._derniere_position_clic
            self._emettre_commande("press_key", x=x, y=y, touche="Backspace")
            self._clic_a_consommer_pour_type_text = True  # cf. commentaire ci-dessus (Enter/Ctrl+A)
            return True
        texte = event.text()
        if not texte or not texte.isprintable():
            return False
        if self._derniere_position_clic is None:
            # Aucun clic connu dans cette session de contrôle -- "type_text"
            # a besoin d'une position (il reclique dessus avant de taper,
            # cf. _camoufox_clic_simple_focus) : sans ça, rien de fiable à
            # envoyer, mieux vaut ignorer que d'envoyer (0, 0).
            return True
        self._texte_clavier_en_attente += texte
        self._minuteur_debounce_texte.start()  # redémarre le délai à chaque touche (debounce, pas throttle)
        return True

    def _sur_clic_copier_adresse(self):
        """Demande la liste des onglets (listTabs : url + onglet actif) ; la
        réponse arrive dans traiter_resultat_copie_distante (branche adresse)."""
        requete_id = self._prochain_requete_id()
        self.__dict__.setdefault("_requetes_copie_adresse", set()).add(requete_id)
        self.commande_controle_distance.emit({
            "requete_id": requete_id,
            "commande": {"action": "listTabs"},
        })

    def _signaler_adresse_copiee(self):
        """Retour visuel discret : l'icône passe en coche verte ~1,2 s."""
        self.bouton_copier_adresse.setIcon(qta.icon("mdi6.check", color=Mocha.green))
        QTimer.singleShot(
            1200,
            lambda: self.bouton_copier_adresse.setIcon(qta.icon("mdi6.content-copy", color=Mocha.subtext0)),
        )

    def _traiter_resultat_copie_adresse(self, data: dict) -> bool:
        requetes = getattr(self, "_requetes_copie_adresse", None)
        requete_id = data.get("requete_id")
        if not requetes or requete_id not in requetes:
            return False
        requetes.discard(requete_id)
        from PySide6.QtWidgets import QToolTip
        if not data.get("ok", False):
            QToolTip.showText(QCursor.pos(), f"Adresse non copiée : {data.get('error', 'erreur inconnue')}")
            return True
        onglets = [o for o in (data.get("result") or []) if isinstance(o, dict)]
        actif = next((o for o in onglets if o.get("actif")), None)
        if actif is None and len(onglets) == 1:
            actif = onglets[0]
        adresse = str((actif or {}).get("url") or "").strip()
        if not adresse:
            QToolTip.showText(QCursor.pos(), "Adresse de l'onglet actif introuvable.")
            return True
        QGuiApplication.clipboard().setText(adresse)
        self._signaler_adresse_copiee()
        affichee = adresse if len(adresse) <= 80 else adresse[:77] + "…"
        QToolTip.showText(QCursor.pos(), f"Adresse copiée : {affichee}")
        return True

    def traiter_resultat_copie_distante(self, data: dict) -> bool:
        """PATCH Ctrl+C -- appelé par l'hôte (3 écrans) pour chaque command_result.
        Retourne True si la réponse concernait un Ctrl+C de cette vue."""
        if self._traiter_resultat_copie_adresse(data):
            return True
        requetes = getattr(self, "_requetes_copie_distante", None)
        requete_id = data.get("requete_id")
        if not requetes or requete_id not in requetes:
            return False
        requetes.discard(requete_id)
        from PySide6.QtWidgets import QToolTip
        if not data.get("ok", False):
            QToolTip.showText(QCursor.pos(), f"Copie distante échouée : {data.get('error', 'erreur inconnue')}")
            return True
        resultat = data.get("result")
        texte = resultat.get("copie") if isinstance(resultat, dict) else None
        if texte:
            QGuiApplication.clipboard().setText(texte)
            QToolTip.showText(QCursor.pos(), f"Copié depuis l'instance ({len(texte)} caractères)")
        else:
            QToolTip.showText(QCursor.pos(), "Rien à copier (aucune sélection dans la page).")
        return True

    def _sur_debounce_texte_clavier(self):
        if not self._texte_clavier_en_attente or self._derniere_position_clic is None:
            self._texte_clavier_en_attente = ""
            return
        x, y = self._derniere_position_clic
        # PATCH (cf. docstring de _clic_a_consommer_pour_type_text côté
        # __init__, et de action_camoufox_type_text/avec_clic côté
        # exécutant) -- seul le PREMIER morceau d'une saisie continue
        # re-clique (avec_clic=True) ; tout morceau suivant, coupé par le
        # débounce lors d'une frappe rapide sans nouveau clic manuel
        # entre-temps, tape directement à la position courante du
        # curseur côté page plutôt que de risquer de le redéplacer au
        # milieu du texte déjà inséré.
        avec_clic = self._clic_a_consommer_pour_type_text
        self._clic_a_consommer_pour_type_text = False
        self._emettre_commande(
            "type_text", x=x, y=y, texte=self._texte_clavier_en_attente, avec_clic=avec_clic,
            facteur_vitesse=self._FACTEUR_VITESSE_SAISIE_PILOTAGE_DIRECT,
        )
        self._texte_clavier_en_attente = ""

    def _rafraichir_bouton_detacher(self):
        """Icône/tooltip du bouton unique Détacher<->Réattacher selon
        self.detache -- cf. docstring de classe pour le choix d'un seul
        bouton plutôt que deux."""
        if self.detache:
            self.bouton_detacher.setIcon(qta.icon("mdi6.dock-window", color=Mocha.subtext0))
            self.bouton_detacher.setToolTip("Réattacher dans la zone d'application")
        else:
            self.bouton_detacher.setIcon(qta.icon("mdi6.open-in-new", color=Mocha.subtext0))
            self.bouton_detacher.setToolTip("Détacher dans une fenêtre flottante")

    def definir_bouton_detacher_visible(self, visible: bool):
        """Appelée par TaskConfigScreen dès la construction du widget (cf.
        _sur_clic_voir_rendu_reseau) une fois detacher_demande connecté --
        établit le contrat évoqué dans le commentaire du constructeur.
        Reste masqué si jamais ce widget est utilisé hors de ce contexte
        (aucun autre appelant aujourd'hui, mais évite un bouton mort si
        jamais réutilisé ailleurs sans câblage)."""
        self.bouton_detacher.setVisible(visible)

    def _sur_clic_bouton_detacher(self):
        # N'inverse PAS self.detache ici : c'est definir_detache() qui le
        # fait, appelée EN RETOUR par TaskConfigScreen une fois le
        # déplacement réel effectué (cf. docstring de classe -- ce widget
        # ne connaît pas ApplicationsScreen, il ne peut pas garantir que
        # la demande aboutit avant que l'état ne change réellement).
        self.detacher_demande.emit(not self.detache)

    def definir_detache(self, detache: bool):
        """Appelée par TaskConfigScreen APRÈS avoir réellement déplacé ce
        widget (retiré du QTabWidget d'ApplicationsScreen et posé en
        top-level, ou l'inverse) -- pose/retire Qt.Window en conséquence
        et met à jour l'icône du bouton. setWindowFlag (pas un nouveau
        setParent(None, Qt.Window) qui recréerait le widget natif et
        perdrait le focus/état de rendu Qt en cours) : suffisant ici car
        TaskConfigScreen a déjà géré le changement de parent AVANT cet
        appel (cf. son _sur_detacher_demande)."""
        self.detache = detache
        self.setWindowFlag(Qt.Window, detache)
        self._rafraichir_bouton_detacher()
        if detache:
            self.show()  # setWindowFlag masque le widget -- doit être réaffiché explicitement (comportement Qt documenté)

    def closeEvent(self, event):
        self.fermeture_demandee.emit()
        super().closeEvent(event)

    # -----------------------------------------------------------------
    # REFONTE (demande explicite utilisateur : "je veux que lorsque on
    # clic sur le bouton de rendeu, sa ne par plus souvir dans les app
    # [= ça ne parte plus dans les onglets], je veux que sa apparit
    # directement en plein ecran ... non dans la taille reel, je ne
    # veux aucune bordure ... et le pasnneau de droit qui contine les
    # parametre doit etre flottant ... sa doit disparaitre si la souris
    # nes pas a lextreminter droit du wigdet de rendeu" + précision :
    # "oublie plein ecran, juste affihcer pardessus tout , et on aopui
    # sur esc pour la reduire , et si je reouvre sa doit reouvir avac
    # les meme parametre que quand cetait ferme") -- remplace le mode
    # "onglet dans ApplicationsScreen / détaché en fenêtre flottante de
    # taille fixe" par un unique mode : fenêtre TOP-LEVEL sans bordure,
    # posée par-dessus tout, à la taille réelle de l'écran courant (PAS
    # un vrai Qt.WindowFullScreen -- juste une geometry() qui couvre
    # tout l'écran, cf. demande "non dans la taille reel"). Échap
    # masque (hide()) au lieu de fermer/détruire, pour que rouvrir via
    # "Voir le rendu" retrouve exactement le même widget (mêmes
    # réglages Mode/Taux/Qualité/Contrôle à distance, cf. self.panneau
    # jamais reconstruit) -- même esprit que l'ancien mode "détaché"
    # qui réutilisait déjà le widget d'un clic à l'autre.
    #
    # Bouton Détacher/Réattacher (self.bouton_detacher) devient sans
    # objet dans ce nouveau mode unique (plus de zone "embarquée" vers
    # laquelle réattacher) -- masqué par définir_bouton_detacher_visible
    # (les deux appelants, TaskConfigScreen et ProjetsDistribuesScreen,
    # n'appellent plus cette méthode avec True).
    #
    # Panneau de réglages flottant (self.panneau.colonne_reglages) :
    # posé en OVERLAY par-dessus l'image (pas dans le layout normal,
    # qui lui réserverait 260px de largeur en permanence) -- sa
    # position/visibilité est recalculée par un QTimer léger qui
    # compare la position courante de la souris (QCursor.pos()) à la
    # largeur du widget, plutôt qu'un enterEvent/leaveEvent classique
    # (qui ne se déclencherait jamais correctement sur un widget cible
    # masqué la plupart du temps).
    # -----------------------------------------------------------------

    # Largeur de la bande sensible, en pixels depuis le bord droit du
    # widget, qui fait réapparaître le panneau de réglages flottant.
    _LARGEUR_ZONE_SENSIBLE_PANNEAU_FLOTTANT = 24
    # Intervalle du QTimer de surveillance souris -- assez court pour
    # une réaction perçue comme immédiate, assez long pour ne pas
    # solliciter inutilement l'event loop en continu.
    _INTERVALLE_SURVEILLANCE_SOURIS_MS = 60

    def _preparer_mode_overlay(self):
        """Bascule ce widget en mode overlay flottant (appelé une seule
        fois, à la première ouverture -- idempotent via self._overlay_
        pret). Détache colonne_reglages de layout_colonne_reglages/
        _corps_layout (où elle occupait une place fixe à droite de
        l'image) pour la reposer en enfant flottant de colonne_image,
        alignée sur son bord droit -- même widget Qt, même contenu,
        seule sa PLACE dans la hiérarchie de layout change.

        BUG CORRIGÉ ("transient parent ... cannot be same as window",
        crash au DEUXIÈME clic sur "Voir le rendu") -- afficher_par_
        dessus_tout() faisait self.setParent(self.window()) à CHAQUE
        appel : une fois Qt.Window déjà posé (1er appel), self.window()
        renvoie CE widget lui-même (il est devenu son propre top-level),
        donc le 2e appel tentait self.setParent(self) -- Qt refuse et
        plante. Le reparentage sous MainWindow est maintenant fait ICI,
        une seule fois, AVANT que Qt.Window ne soit jamais posé --
        afficher_par_dessus_tout() ne touche plus au parent ensuite."""
        if getattr(self, "_overlay_pret", False):
            return
        self._overlay_pret = True

        # Reparentage sous MainWindow -- une seule fois, avant tout
        # Qt.Window (cf. docstring ci-dessus). self.parent() est encore
        # le TaskConfigScreen/ProjetsDistribuesScreen d'origine à ce
        # stade (jamais None ici, ce widget est toujours construit avec
        # `self` comme parent), donc self.window() est encore fiable.
        parent_actuel = self.parent()
        if parent_actuel is not None:
            self.setParent(parent_actuel.window())

        colonne_reglages = self.panneau.colonne_reglages
        colonne_image = self.panneau.colonne_image

        # Retrait du layout normal (_corps_layout, cf. PanneauRenduInstance
        # .__init__) SANS détruire le widget -- il reste possédé par
        # self.panneau, seul son PARENT/positionnement visuel change.
        self.panneau._corps_layout.removeWidget(colonne_reglages)
        colonne_reglages.setParent(colonne_image)
        # Fond opaque (pas transparent) : ce panneau se pose PAR-DESSUS
        # l'image, il doit rester lisible quel que soit ce qu'il y a
        # derrière -- la feuille QSS globale s'applique déjà normalement
        # à ce widget, seul autoFillBackground manquait puisqu'il n'était
        # jamais posé en overlay avant.
        colonne_reglages.setAutoFillBackground(True)
        colonne_reglages.raise_()
        colonne_reglages.setVisible(False)
        colonne_reglages.installEventFilter(self)

        colonne_image.installEventFilter(self)  # pour resizeEvent -> repositionner l'overlay

        self._construire_entete_panneau_flottant(colonne_reglages)

        self._minuteur_survol_panneau = QTimer(self)
        self._minuteur_survol_panneau.setInterval(self._INTERVALLE_SURVEILLANCE_SOURIS_MS)
        self._minuteur_survol_panneau.timeout.connect(self._verifier_survol_panneau_flottant)

        self._repositionner_panneau_flottant()

    def _construire_entete_panneau_flottant(self, colonne_reglages: QWidget):
        """Insère self.titre_label (nom du sAutoniax/profil ciblé, déjà
        créé dans __init__ -- cf. sa docstring pour le pourquoi) et
        self.bouton_fermer TOUT EN HAUT de colonne_reglages (le panneau
        flottant) -- demande explicite utilisateur : "je veux que tu
        enleve le lables qui est en haut de limage ... je ne veux rien
        daure que limage, cest dans le [pan]neau flottant que tu doit
        donner le nons du sautoniax et du profils". Ancien emplacement
        (barre au-dessus de self.panneau) supprimé, cf. __init__.

        colonne_reglages.layout() EST layout_colonne_reglages (posé par
        PanneauRenduInstance.__init__ via QVBoxLayout(self.colonne_
        reglages)) -- insertWidget(0, ...) plutôt qu'addWidget pour que
        cette entête reste TOUJOURS la toute première ligne, au-dessus
        de Rafraîchir/Mode/Taux, même si un futur ajout à
        PanneauRenduInstance grossit cette colonne."""
        entete = QWidget(colonne_reglages)
        entete_layout = QHBoxLayout(entete)
        entete_layout.setContentsMargins(0, 0, 0, 0)
        entete_layout.setSpacing(8)
        self.titre_label.setParent(entete)
        entete_layout.addWidget(self.titre_label, stretch=1)
        # PATCH (toggle "auto à l'ouverture / manuel à Échap") -- placé
        # entre le titre et le bouton fermer, même ligne, pour rester
        # accessible sans encombrer une ligne à part dans un panneau déjà
        # dense (Rafraîchir/Mode/Taux/Statut en dessous).
        self.case_auto_a_ouverture.setParent(entete)
        entete_layout.addWidget(self.case_auto_a_ouverture)
        # PATCH (toggle "Ajuster à la fenêtre") -- même emplacement,
        # juste à côté du toggle "auto à l'ouverture" déjà en place.
        self.case_ajuster_a_la_fenetre.setParent(entete)
        entete_layout.addWidget(self.case_ajuster_a_la_fenetre)
        self.bouton_fermer.setParent(entete)
        entete_layout.addWidget(self.bouton_fermer)

        colonne_reglages.layout().insertWidget(0, entete)

    def _repositionner_panneau_flottant(self):
        """Replaque colonne_reglages contre le bord droit de colonne_image,
        pleine hauteur -- appelé à la préparation initiale et à chaque
        redimensionnement de colonne_image (cf. eventFilter, QEvent.Resize)."""
        colonne_reglages = self.panneau.colonne_reglages
        colonne_image = self.panneau.colonne_image
        largeur = colonne_reglages.width() or colonne_reglages.sizeHint().width()
        colonne_reglages.setGeometry(
            colonne_image.width() - largeur, 0, largeur, colonne_image.height()
        )
        colonne_reglages.raise_()

    def _verifier_survol_panneau_flottant(self):
        """Appelée périodiquement (self._minuteur_survol_panneau) tant que
        ce widget est visible en mode overlay -- affiche colonne_reglages
        si la souris est dans la bande sensible du bord droit DE
        colonne_image, OU déjà au-dessus du panneau lui-même une fois
        visible (pour ne pas le faire disparaître sous le curseur pendant
        qu'on l'utilise) ; le masque sinon."""
        self._verifier_survol_barre_onglets()
        colonne_reglages = self.panneau.colonne_reglages
        colonne_image = self.panneau.colonne_image
        if not colonne_image.isVisible():
            return
        pos_globale = QCursor.pos()
        pos_dans_colonne = colonne_image.mapFromGlobal(pos_globale)
        dans_zone_sensible = (
            colonne_image.rect().contains(pos_dans_colonne)
            and pos_dans_colonne.x() >= colonne_image.width() - self._LARGEUR_ZONE_SENSIBLE_PANNEAU_FLOTTANT
        )
        # CORRECTIF (bug rapporté : le panneau de réglages reste
        # TOUJOURS visible, en bande fixe, au lieu de se masquer quand
        # la souris le quitte) -- l'ancien calcul (colonne_reglages.
        # rect().contains(colonne_reglages.mapFromGlobal(pos_globale)))
        # dépend de l'état interne Qt du repère local de colonne_reglages
        # pour convertir une position globale -- ce widget est reparenté
        # et positionné à la main (setParent + setGeometry manuel dans
        # _preparer_mode_overlay/_repositionner_panneau_flottant, HORS
        # de tout layout géré), donc rien ne garantit que ce repère local
        # reste synchronisé avec sa géométrie réelle à l'écran à chaque
        # tick du timer -- en pratique cela pouvait faire retomber
        # mapFromGlobal(pos_globale) dans rect() quasi en permanence,
        # rendant dans_panneau_deja_visible presque toujours vrai une
        # fois colonne_reglages affichée ne serait-ce qu'un instant
        # (boucle qui s'auto-entretient, cf. setVisible ci-dessous).
        # Fixé en comparant deux points GLOBAUX (mapToGlobal du widget
        # vers l'écran, jamais l'inverse) -- indépendant de tout état de
        # repère local, fiable même hors layout.
        origine_globale = colonne_reglages.mapToGlobal(colonne_reglages.rect().topLeft())
        rect_global = QRect(origine_globale, colonne_reglages.size())
        dans_panneau_deja_visible = (
            colonne_reglages.isVisible()
            and rect_global.contains(pos_globale)
        )
        colonne_reglages.setVisible(dans_zone_sensible or dans_panneau_deja_visible)

    def _sur_drag_capture_demarre(self):
        """PATCH -- cf. câblage dans __init__ (bouton_drag_capture.
        drag_demarre) et docstring de ApercuDragHandle pour le contexte
        complet. Masque IMMÉDIATEMENT colonne_reglages (sinon il reste
        visible, couvrant l'image, pendant tout le glisser) et SUSPEND
        _minuteur_survol_panneau -- sans ça, dès que la souris quitte le
        bouton pour amorcer le drag, elle traverse forcément la bande
        sensible du bord droit (le bouton y vit) : le timer le
        rafficherait aussitôt malgré le setVisible(False) ci-dessous, le
        prochain tick (60 ms) l'ayant à peine masqué.

        self._minuteur_survol_panneau peut ne pas encore exister si le
        mode overlay n'a jamais été activé (_preparer_mode_overlay
        appelée seulement à la première ouverture réelle, cf. sa
        docstring) -- mais bouton_drag_capture ne peut alors pas non plus
        avoir été cliqué (colonne_reglages n'est visible qu'une fois ce
        mode actif), donc ce cas ne devrait jamais se produire en
        pratique ; getattr défensif plutôt qu'une supposition.

        PATCH (demande explicite utilisateur : "je veux que sa fait comme
        si on avait appuyer sur esch" -- reformulé après une première
        tentative "reduire" qui visait à tort showMinimized()) : au lieu
        de simplement masquer colonne_reglages, on reproduit EXACTEMENT
        le comportement d'Échap (cf. _masquer_comme_echap, factorisé avec
        keyPressEvent) -- la fenêtre entière disparaît donc dès le début
        du drag, pas seulement le panneau flottant, ET repasse en mode
        manuel si self._auto_a_ouverture est actif, exactement comme
        Échap. self.panneau (réglages, dernière image reçue, état Mode/
        Taux/Qualité/Contrôle à distance) reste intact par ailleurs :
        rouvrir "Voir le rendu" retrouve cet état tel quel. On masque
        quand même colonne_reglages avant _masquer_comme_echap() (ne
        coûte rien, évite un flash visible du panneau flottant)."""
        minuteur = getattr(self, "_minuteur_survol_panneau", None)
        if minuteur is not None:
            minuteur.stop()
        self.panneau.colonne_reglages.setVisible(False)
        self._masquer_comme_echap()

    def _sur_drag_capture_termine(self):
        """Contrepartie de _sur_drag_capture_demarre.

        PATCH (même demande que ci-dessus) : _sur_drag_capture_demarre
        cache maintenant la fenêtre entière (self.hide(), comme Échap)
        plutôt que de simplement masquer colonne_reglages -- on ne la
        rouvre PAS automatiquement ici pour rester fidèle au comportement
        d'Échap, qui ne réaffiche jamais tout seul non plus (l'utilisateur
        rouvre via "Voir le rendu" quand il le souhaite, cf. docstring de
        keyPressEvent). hideEvent (déclenché par ce hide()) coupe déjà
        _minuteur_survol_panneau -- on ne le relance donc PAS ici : le
        relancer inconditionnellement le ferait tourner à vide sur une
        fenêtre cachée jusqu'à sa prochaine ouverture, où showEvent s'en
        charge de toute façon. On ne touche plus au minuteur du tout dans
        cette méthode : hideEvent/showEvent gèrent désormais son cycle de
        vie complet autour de ce hide()."""
        pass

    def _masquer_comme_echap(self):
        """Point d'entrée UNIQUE pour "masquer ce panneau exactement
        comme Échap" -- utilisé par keyPressEvent (Échap réel) ET par
        _sur_drag_capture_demarre (qui reproduit délibérément ce même
        comportement, cf. sa docstring "je veux que sa fait comme si on
        avait appuyer sur esch"). Centralisé ICI pour que les deux
        chemins restent TOUJOURS identiques, y compris pour le repli en
        mode manuel (cf. self._auto_a_ouverture) -- avant ce refactor,
        seul keyPressEvent repassait en manuel, pas le raccourci du
        drag, ce qui aurait laissé le flux auto tourner en arrière-plan
        après un masquage par glisser alors que l'utilisateur s'attend
        au même résultat qu'Échap dans les deux cas."""
        if self._auto_a_ouverture and self.panneau.case_auto.isChecked():
            self.panneau.case_auto.setChecked(False)
        self.hide()

    def keyPressEvent(self, event):
        # Échap : masque la fenêtre sans la détruire (cf. docstring de
        # section -- "on aopui sur esc pour la reduire", contrairement au
        # (x)/bouton_fermer qui, lui, ferme définitivement via closeEvent
        # -> fermeture_demandee). self.panneau (réglages, dernière image
        # reçue, état Mode/Taux/Qualité/Contrôle à distance) reste
        # intact : rouvrir "Voir le rendu" retrouve exactement cet état
        # -- SAUF le mode Auto/Manuel lui-même si self._auto_a_ouverture
        # est actif (cf. _masquer_comme_echap et afficher_par_dessus_
        # tout, qui fait le pendant inverse à l'ouverture).
        if event.key() == Qt.Key_Escape:
            self._masquer_comme_echap()
            return
        # PATCH (demande explicite utilisateur : "je veux que lorsqu eon
        # appui sur la touche espae sa met directmeent le mode de
        # rarfraichiemet a manuel et non automaiquer, je toruve sa
        # penible de toujour aller sur le paneau de reglage qpour mettre
        # l e rarfauihemeent avec le cilc" -- PUIS complété : "la touche
        # espace doit aussi basculer vers le rafraichesiement
        # automqitque si cetait deja en maneusl") -- BASCULE (toggle)
        # dans les deux sens, sans passer par case_auto dans la colonne
        # de réglages : Auto -> Manuel si actuellement auto, Manuel ->
        # Auto si actuellement manuel. N'affecte QUE case_auto elle-même :
        # contrairement à Échap (_masquer_comme_echap), Espace ici ne
        # masque PAS la fenêtre et ne touche pas à self._auto_a_ouverture
        # -- rouvrir ce panneau plus tard rebasculera en auto si ce
        # toggle est actif, exactement comme si Espace n'avait jamais
        # été pressé entre-temps.
        #
        # NE S'APPLIQUE PAS quand le contrôle à distance est actif ET le
        # focus est sur apercu_label (cf. eventFilter/_sur_touche_
        # controle_distance) : dans ce cas, Espace est intercepté PLUS
        # HAUT (eventFilter retourne True) et relayé comme un vrai
        # caractère espace tapé côté page distante -- ce keyPressEvent-ci
        # ne le voit alors jamais, ce qui est le comportement voulu
        # (taper un espace dans un champ de la page ne doit pas changer
        # le mode de rafraîchissement).
        #
        # PATCH (onglet "Raccourcis" de ParametresScreen) -- la touche en
        # dur (Qt.Key_Space) est remplacée par une lecture du combo
        # configuré via _touche_correspond_au_raccourci (cf. sa docstring
        # et DEFAULT_RACCOURCIS_APP["rafraichissement_toggle"]) : le
        # comportement par défaut reste identique (Espace), mais
        # l'utilisateur peut désormais le réassigner depuis Paramètres ->
        # Raccourcis. charger_raccourcis_app() relit le fichier JSON à
        # chaque frappe (pas de cache en mémoire ici) -- un changement de
        # combo est donc déjà pris en compte immédiatement, y compris sur
        # une FenetreRenduTaskReseau déjà ouverte, sans écouter
        # raccourcis_app_changes ni redémarrer l'app.
        if _touche_correspond_au_raccourci(event, "rafraichissement_toggle"):
            self.panneau.case_auto.setChecked(not self.panneau.case_auto.isChecked())
            return
        # PATCH (demande explicite utilisateur : "je veux maitenant que
        # dans le panneau la toouche shift sert a executer le bouon de
        # ciseau") -- Shift déclenche EXACTEMENT ce qu'un clic gauche sur
        # bouton_selection_zone déclenche (_demarrer_selection_zone), pas
        # une réimplémentation séparée -- même overlay SelectionZoneOverlay,
        # même comportement Espace-valide/Échap-annule une fois ouvert. Le
        # clic DROIT du ciseau (galerie des sélections en attente) n'a pas
        # d'équivalent clavier ici, seul le clic GAUCHE (démarrage d'une
        # nouvelle sélection) est concerné -- demande explicite portait
        # uniquement sur "le bouton", au sens de son action principale.
        #
        # Ne redéclenche pas une nouvelle sélection si une est déjà
        # ouverte (l'overlay est alors une fenêtre top-level séparée qui a
        # elle-même le focus clavier -- Shift n'atteint normalement même
        # plus ce keyPressEvent-ci tant qu'elle est affichée, mais on
        # reste défensif si jamais le focus revenait entre-temps).
        #
        # Même exclusion IMPLICITE que Espace ci-dessus en contrôle à
        # distance actif : quand le focus est sur apercu_label, ce
        # KeyPress est déjà intercepté plus haut par eventFilter (cf.
        # _sur_touche_controle_distance) et ne parvient jamais jusqu'ici
        # -- rien à ajouter de spécial pour ce cas.
        #
        # PATCH (onglet "Raccourcis") -- même remplacement que ci-dessus,
        # via DEFAULT_RACCOURCIS_APP["selection_capture_toggle"] (Shift
        # par défaut, réassignable), même lecture live sans cache.
        if (
            _touche_correspond_au_raccourci(event, "selection_capture_toggle")
            and self._overlay_selection_zone is None
        ):
            self._demarrer_selection_zone()
            return
        super().keyPressEvent(event)

    def afficher_par_dessus_tout(self):
        """Point d'entrée UNIQUE pour les deux appelants (TaskConfigScreen.
        _sur_clic_voir_rendu_reseau, ProjetsDistribuesScreen._sur_clic_
        apercu_execution) -- remplace l'ancien double mode onglet/détaché.
        Pose ce widget en fenêtre top-level SANS bordure, par-dessus tout
        (Qt.WindowStaysOnTopHint), à la geometry EXACTE de l'écran courant
        (PAS Qt.WindowFullScreen -- demande explicite : "non dans la
        taille reel" i.e. pas un vrai plein-écran système, juste occuper
        visuellement tout l'écran sans bordure ni barre de titre).

        Le reparentage sous MainWindow ne se fait plus ici (cf. bug
        "transient parent ... cannot be same as window" -- corrigé,
        déplacé dans _preparer_mode_overlay, appelée une seule fois)."""
        self._preparer_mode_overlay()
        self.setWindowFlags(Qt.Window | Qt.FramelessWindowHint | Qt.WindowStaysOnTopHint)
        ecran = self.screen() or QGuiApplication.primaryScreen()
        if ecran is not None:
            self.setGeometry(ecran.geometry())
        self.show()
        self.raise_()
        self.activateWindow()
        self.setFocus(Qt.OtherFocusReason)
        self._minuteur_survol_panneau.start()
        # PATCH (demande explicite utilisateur : "lorsque je clic sur le
        # bouton qui permet le rendu panneau alors ça active directement
        # le mode rafraîchissement automatique") -- coche case_auto SI ce
        # n'est pas déjà le cas ET si le toggle self._auto_a_ouverture
        # est actif (comportement par défaut, cf. sa docstring). setChecked
        # ne redéclenche toggled QUE si l'état change réellement (Qt ne
        # ré-émet pas un signal déjà à sa valeur cible) -- rouvrir un
        # panneau déjà en mode auto ne relance donc pas inutilement
        # taux_capture_change.emit() une seconde fois.
        #
        # CHANGEMENT (demande explicite utilisateur : "lorsque la qualité
        # de FenetreRenduTaskReseau est à 100 et bien quand on ouvre le
        # panneau de rendu ça ne doit plus être automatiquement sur
        # automatique mais manuel") -- à qualité 100 (images non
        # compressées, cf. QUALITES_CAPTURE_AFFICHEES index 0, les plus
        # lourdes), un rafraîchissement automatique en continu coûterait
        # une bande passante bien plus importante qu'aux qualités
        # inférieures : l'ouverture force donc Manuel dans ce cas
        # précis, MÊME SI self._auto_a_ouverture est actif -- ce toggle
        # ne garde son effet que pour les qualités < 100. Si case_auto
        # était déjà coché (panneau réglé en Auto puis qualité remontée à
        # 100 entre-temps, ou rouvert alors qu'il l'était déjà), on le
        # décoche aussi pour rester cohérent avec cette même règle,
        # plutôt que de ne l'appliquer qu'à la case non cochée.
        _qualite_actuelle = self.panneau.QUALITES_CAPTURE_AFFICHEES[
            self.panneau.combo_qualite_capture.currentIndex()
        ][1]
        if _qualite_actuelle == 100:
            if self.panneau.case_auto.isChecked():
                self.panneau.case_auto.setChecked(False)
        elif self._auto_a_ouverture and not self.panneau.case_auto.isChecked():
            self.panneau.case_auto.setChecked(True)

    def hideEvent(self, event):
        # Coupe la surveillance souris pendant que la fenêtre est cachée
        # (Échap, ou masquage programmatique) -- inutile de continuer à
        # interroger QCursor.pos() toutes les 60ms pour un widget invisible.
        if hasattr(self, "_minuteur_survol_panneau"):
            self._minuteur_survol_panneau.stop()
        if hasattr(self, "barre_onglets"):
            self.barre_onglets.definir_survol(False)
        super().hideEvent(event)

    _LARGEUR_RELATIVE_BARRE_ONGLETS = 0.6   # part de la largeur de la fenêtre, centrée
    _HAUTEUR_ZONE_SENSIBLE_BARRE_ONGLETS = 6  # px du bord haut qui déclenchent l'apparition

    def _geometrie_barre_onglets(self) -> QRect:
        largeur = int(self.width() * self._LARGEUR_RELATIVE_BARRE_ONGLETS)
        x = (self.width() - largeur) // 2
        return QRect(x, 0, largeur, self.barre_onglets.height())

    def _verifier_survol_barre_onglets(self):
        '''Appelée par le minuteur de survol existant (60 ms). Zone sensible :
        fine bande en haut, CENTRÉE (les boutons ciseau/poubelle du coin
        nord-ouest restent donc accessibles). La barre reste affichée tant
        que le curseur est dessus, et déclenche UNE actualisation (listTabs)
        à chaque apparition.'''
        barre = getattr(self, "barre_onglets", None)
        if barre is None or not self.isVisible():
            return
        pos = QCursor.pos() - self.mapToGlobal(QPoint(0, 0))
        geo = self._geometrie_barre_onglets()
        zone = QRect(geo.x(), 0, geo.width(), self._HAUTEUR_ZONE_SENSIBLE_BARRE_ONGLETS)
        survol = zone.contains(pos) or (barre.isVisible() and geo.contains(pos))
        if survol:
            barre.setGeometry(geo)
            barre.raise_()
        if barre.definir_survol(survol):
            self._rafraichir_onglets_auto()

    def _rafraichir_onglets_auto(self):
        bouton = self.panneau.rafraichir_onglets_button
        if bouton.isEnabled():
            bouton.click()

    def showEvent(self, event):
        if hasattr(self, "_minuteur_survol_panneau") and self.isVisible():
            self._minuteur_survol_panneau.start()
        super().showEvent(event)


# --- Mode "Exécution Clone" (TaskConfigScreen) -- demande explicite
# utilisateur : lancer le même Task sur plusieurs profils sAutoniax en
# parallèle, cf. SPEC_mode_execution_clone.md section 2. Ces deux
# dataclasses vivent EN MÉMOIRE uniquement (jamais dans Task/
# project.save(), cf. section 1 point 6 de la spec : "comportement
# preview, jamais persisté") -- TaskConfigScreen les indexe par task.id
# dans self._executions_clone (cf. son __init__). ---

@dataclass
class CloneProfilEtat:
    """État d'UN profil clone pour l'exécution en cours (ou la dernière
    terminée) d'un Task donné -- une entrée par nom de profil coché au
    moment du lancement, cf. TaskConfigScreen._sur_demande_lancer_clones."""
    nom_profil: str
    # Rempli quand connu (profils_sautoniax_recu, ou dès que le premier
    # MoteurExecutionCelluleReseau de ce profil a démarré) -- nécessaire
    # pour cibler le rendu vidéo (bouton œil) ET la capture ponctuelle
    # (capture en masse, section 5) sur LA bonne instance, jamais
    # id_executant seul (qui désigne le sAutoniax, pas une instance
    # précise dès qu'il y a plusieurs profils actifs dessus -- cf. section
    # 0 de la spec, convention instance_id == id_executant caduque en
    # multi-profils).
    instance_id: str = ""
    # REFONTE MULTI-SAUTONIAX (demande explicite utilisateur : "je veux
    # vraiment du parallelisme" + "affiche pour tout les sautoniax") --
    # sAutoniax D'ORIGINE de CE profil précis, plutôt qu'un seul
    # id_executant partagé par tout le lot (cf. l'ancien ExecutionCloneEtat.
    # id_executant_sautoniax, devenu insuffisant dès que le panneau liste
    # des profils venant de PLUSIEURS sAutoniax simultanément). Rempli au
    # moment où ce profil est ajouté à la liste agrégée (cf.
    # PanneauExecutionClone.rafraichir_liste / TaskConfigScreen._sur_
    # profils_multi_sautoniax_recus), puis figé au lancement (même
    # principe que l'ancien champ : un changement de sélection en cours
    # de route ne doit pas faire dévier un lot déjà parti).
    id_executant_sautoniax: str = ""
    coche: bool = False  # état de la checkbox dans le panneau clone
    statut: str = "inactif"  # "inactif" | "en_attente" | "en_cours" | "succes" | "erreur" | "arrete"
    cellule_courante_id: Optional[str] = None
    # id de cellule (task.cellule_variables.id ou task.cellules[i].id) ->
    # TaskCellule TEMPORAIRE portant la sortie de CE profil pour CETTE
    # cellule -- jamais l'objet réel de task.cellules/task.cellule_
    # variables (cf. section 1 point 6 : le notebook principal reste
    # silencieux pendant un run clone). Reconstruite à chaque lancement
    # (comme _executer_toutes_cellules vide les sorties réelles au
    # lancement, même principe appliqué ici à ce dict).
    cellules_resultats: dict = field(default_factory=dict)
    # Moteur de la cellule EN COURS pour ce profil précis (None entre deux
    # cellules, ou une fois la séquence de ce profil terminée) -- consulté
    # par l'arrêt global (section 4.5) pour détacher proprement chaque
    # séquence de profil encore active.
    moteur_courant: Optional["MoteurExecutionCelluleReseau"] = None
    derniere_image_b64: Optional[str] = None  # dernière capture reçue pour ce profil (rendu œil)
    # AJOUT (spec B.2, colonne "Temps" du panneau clone) -- timestamps Unix
    # (time.time(), cohérent avec le reste de ce fichier qui utilise déjà
    # ce type d'horodatage pour ce genre de mesure). Remplis par valeurs
    # RÉELLES rapportées par le sAutoniax si le protocole réseau les
    # fournit (cf. executer_notebook_distant/notebook_distant_resultat_recu
    # -- champs horodatage_debut/horodatage_fin ajoutés au message JSON),
    # sinon (repli) par les timestamps locaux du pilote au moment de
    # l'émission/réception -- ce repli inclut alors la latence réseau
    # aller-retour, documenté à chaque site d'écriture concerné.
    # Réinitialisés à None au moment où profil_etat.statut repasse à
    # "en_attente" (relancement d'un profil), pour que le compteur reparte
    # de zéro.
    horodatage_debut: Optional[float] = None
    horodatage_fin: Optional[float] = None
    # AJOUT (SPEC_lot_corrections_2026-09.md section 11) : couleur
    # métier définie par l'utilisateur dans son code via la variable
    # `result_color` du namespace d'exécution.
    # CHANGEMENT (retour utilisateur explicite : "on fonctionne
    # maintenant avec le code hexadécimal" -- ajout d'un color picker
    # dans le panneau clone) : le format accepté bascule de noms Qt/CSS
    # ("red"/"green"/"yellow") à un code hexadécimal "#rrggbb" (ou "#rgb"
    # court accepté aussi, cf. QColor -- même format que BoutonCouleur.
    # couleur_changee ailleurs dans ce fichier, pour rester cohérent avec
    # le reste de l'app). Valeur par défaut = COULEUR_RESULT_COLOR_DEFAUT
    # (vert foncé, "#006400") -- cohérente avec la réinitialisation
    # systématique injectée côté sAutoniax au début de chaque lot (cf.
    # _sautoniax_executer_notebook_distant/_sur_instance_isolee) --
    # reflète donc soit cette valeur par défaut si le lot n'a pas encore
    # terminé/n'a jamais tourné, soit la valeur FINALE transmise par
    # envoyer_notebook_distant_resultat une fois toutes les cellules du
    # lot terminées pour ce profil (une seule pastille par lot complet,
    # pas par cellule -- cf. décisions section 11).
    # Déjà validée (format hex, cf. _hex_couleur_valide) côté sAutoniax
    # avant envoi (cf. _sautoniax_executer_notebook_distant) -- ce champ
    # ne reçoit donc jamais de valeur invalide, aucune revalidation
    # nécessaire ici.
    result_color: str = COULEUR_RESULT_COLOR_DEFAUT
    # PATCH H (indicateur « en cours » après coupure) : True = ce profil a été RESTAURÉ en « en_cours » à partir de ce que son
    # sAutoniax rapporte (une cellule tourne encore dessus) alors que ce pilote n'a plus de moteur pour la suivre. Aucune
    # relance : c'est un simple affichage de l'état réel, rafraîchi par sondage tant que le drapeau est levé.
    reprise_apres_coupure: bool = False


@dataclass
class ExecutionCloneEtat:
    """État du panneau clone pour UN Task précis -- une entrée dans
    TaskConfigScreen._executions_clone, keyée par task.id."""
    actif: bool = False  # le panneau clone est-il actuellement ouvert pour ce Task
    # REFONTE MULTI-SAUTONIAX (correctif collision de noms, cf. docstring de
    # _cle_profil_clone) : keyé par CLÉ COMPOSITE (id_executant::nom_profil),
    # PAS par nom_profil nu -- deux sAutoniax différents peuvent avoir chacun
    # un profil du même nom (ex. "iaX1"), le nom nu seul les confondrait.
    profils: dict = field(default_factory=dict)  # cle_profil (id_executant::nom_profil) -> CloneProfilEtat
    sequence_en_cours: bool = False  # au moins un clone en cours d'exécution
    # Profil dont la sortie est actuellement affichée dans les VRAIS
    # TaskCelluleWidget du notebook principal (bouton "logs", section 4.6)
    # -- None si le notebook affiche son propre contenu réel.
    profil_actif: Optional[str] = None
    # REFONTE MULTI-SAUTONIAX -- l'ancien champ unique id_executant_
    # sautoniax (un seul sAutoniax pour TOUT le lot) est retiré d'ici :
    # le panneau clone liste désormais des profils venant de PLUSIEURS
    # sAutoniax en même temps (cf. docstring de PanneauExecutionClone),
    # donc "le" sAutoniax du lot n'a plus de sens au niveau du lot entier.
    # Chaque CloneProfilEtat porte maintenant SON PROPRE id_executant_
    # sautoniax (cf. sa docstring) -- tous les anciens lecteurs de
    # etat.id_executant_sautoniax lisent désormais profil_etat.
    # id_executant_sautoniax à la place (cf. grep du même nom dans ce
    # fichier pour la liste des sites mis à jour par ce même patch).
    # AJOUT (bouton "Copier les logs de cette exécution" -- demande
    # explicite utilisateur : "si je lance des exécutions de clone, tout
    # leur logs commence à être sauvegardé, ainsi je vais pouvoir copier
    # les logs de tout le monde à partir de ce temps là, jusqu'à la fin
    # de l'exécution") -- posé UNE FOIS au clic "Lancer les clones" (cf.
    # _sur_demande_lancer_clones), jamais réinitialisé par profil
    # individuel (contrairement à CloneProfilEtat.horodatage_debut/fin,
    # propres à CHAQUE profil et remis à None à chaque relance de CE
    # profil) -- c'est la fenêtre du LOT entier qui nous intéresse ici,
    # pas celle d'un profil isolé : le premier profil du lot peut démarrer
    # une poignée de secondes avant le dernier (envois réseau successifs,
    # cf. la boucle for de _sur_demande_lancer_clones), et on veut que
    # cette petite marge de démarrage soit incluse dans la copie plutôt
    # que coupée. Conservé APRÈS la fin du lot (jamais remis à None tant
    # qu'un nouveau lot n'est pas relancé) pour que le bouton reste
    # utilisable un moment après coup, le temps de constater un problème
    # et de vouloir en récupérer les logs.
    horodatage_lancement_lot: Optional[float] = None
    # Posé dès que sequence_en_cours repasse à False (cf.
    # _rafraichir_apres_transition_clone et les deux autres points
    # d'écriture de sequence_en_cours=False -- arrêt manuel/erreur
    # globale) -- None tant que le lot tourne encore, auquel cas le
    # bouton utilise l'instant présent (time.time()) comme borne de fin
    # plutôt que d'attendre une valeur qui n'existe pas encore (permet de
    # copier les logs SANS attendre la fin, cf. demande explicite
    # utilisateur : "pendant OU après une exécution").
    horodatage_fin_lot: Optional[float] = None
    # AJOUT (SPEC_workspace_attribution.md, section 7 ; PATCH v2,
    # SPEC_patch_tasks_json.md section 5 ; PATCH v4, demande explicite
    # utilisateur : plus de path du WORKSPACE en fin de liste) : résultat
    # de la DERNIÈRE attribution WORKSPACE effectuée pour ce Task --
    # cle_profil (même clé composite que `profils` ci-dessus) -> liste de
    # tâches attribuées à ce profil, chacune DIRECTEMENT un dict de champs
    # métier (avant le PATCH v4 : un dict {"donnees": dict,
    # "fichier_source": str} ; avant le PATCH v2 : une liste de chemins
    # absolus str, un par fichier Task_N.json). C'est directement la
    # forme injectée dans LIST_TASKS (renommée depuis WORKSPACE) côté
    # script du Task. PAS persisté sur disque (contrairement à
    # Task.workspace_fichier/workspace_mode_repartition/
    # workspace_nombre_fixe) : recalculable à tout moment depuis l'état
    # réel du fichier WORKSPACE sur disque, donc aucune raison de le
    # dupliquer dans project.json (cf. spec : "pas persisté sur disque
    # au-delà de la session"). Écrasé en ENTIER à chaque nouvelle
    # attribution (clic gauche silencieux OU validation de la boîte de
    # dialogue, spec section 4) -- jamais fusionné avec l'ancien contenu :
    # un profil absent de la nouvelle répartition (ex. plus assez de
    # tâches en attente pour tout le monde, mode Nombre fixe) n'a alors
    # PLUS d'entrée ici, ce qui doit être interprété comme LIST_TASKS = []
    # au moment de l'injection (cf. _workspace_pour_profil plus bas),
    # PAS comme "conserver son ancienne attribution".
    workspace_attribution: dict = field(default_factory=dict)  # cle_profil -> list[dict de champs métier]


class PanneauExecutionClone(QWidget):
    """Panneau de droite de TaskConfigScreen (mode réseau uniquement) --
    cf. SPEC_profils_environnements.md, section 4. Affiché en PERMANENCE
    dès que task.mode_execution == "reseau" (section 4.1) -- plus de
    toggle toolbar (l'ancien self.bouton_mode_clone/_sur_toggle_mode_clone
    de SPEC_mode_execution_clone.md a été entièrement supprimé). Liste
    TOUS les profils de TOUS les sAutoniax connus (REFONTE MULTI-
    SAUTONIAX -- plus de notion de sAutoniax "ciblé" unique, ni de
    "profil principal" exclu de la liste, section 4.2 point 3), cochables individuellement pour
    lancer EN PARALLÈLE la même séquence de cellules (cellule_variables +
    task.cellules actives, même filtre que "Tout exécuter") sur chacun --
    même patron visuel EXACT que PanneauProprietesSautoniax (colonne 0 :
    checkbox + nom, colonne 1 : statut texte coloré, colonne 2 : boutons
    d'action par ligne), copié ici sur demande explicite utilisateur (cf.
    docstring de section 0 de la spec : "référence visuelle explicitement
    demandée... pour la liste de profils du panneau clone"). Une ligne
    peut aussi être cliquée (hors checkbox) pour en faire le profil ACTIF
    -- l'environnement d'exécution courant du Task entier (section 4.3).

    Ce panneau ne connaît ni ClientServeurT ni le reste de l'app
    directement (même séparation de responsabilités que tout le
    fichier) -- il émet des signaux, TaskConfigScreen résout le réseau
    et lui renvoie l'état à afficher via rafraichir_liste()."""

    demande_rafraichir_profils = Signal()          # -> TaskConfigScreen -> ClientServeurT.demander_profils_sautoniax
    # REFONTE MULTI-SAUTONIAX (correctif collision de noms, cf. docstring
    # de _cle_profil_clone) : transporte désormais des CLÉS COMPOSITES
    # (id_executant::nom_profil), plus des noms nus -- deux sAutoniax
    # distincts peuvent avoir chacun un profil "iaX1", un nom nu seul ne
    # permettrait pas de les distinguer au moment de lancer/arrêter.
    demande_lancer_clones = Signal(list)           # liste de clés composites de profils cochés
    demande_arreter_clones = Signal()
    demande_capturer_tout = Signal()               # cf. section 5
    # AJOUT (demande explicite utilisateur : "un bouton de copie de logs
    # pendant ou après une exécution de clone ... copier les logs entier
    # juste sur cette intervalle de temps, entre le démarrage et la fin
    # d'exécution") -- aucun paramètre : TaskConfigScreen connaît déjà
    # l'ExecutionCloneEtat courant (horodatage_lancement_lot/fin_lot) au
    # moment de recevoir ce signal, pas besoin de les transporter ici
    # (même patron que demande_capturer_tout/demande_arreter_clones
    # juste au-dessus, tous sans paramètre pour la même raison).
    demande_copier_logs_execution_clone = Signal()
    # BUGFIX/AJOUT (retour utilisateur : "je veux que tu ajoute un bouton
    # qui vas permetre de vider toute les sortie de clone quelque part
    # ici") -- vide en masse CloneProfilEtat.cellules_resultats de TOUS
    # les profils connus de ce Task, symétrique à _vider_toutes_cellules
    # (notebook réel, mode local) mais côté clone -- cf. TaskConfigScreen.
    # _sur_demande_vider_sorties_clones.
    demande_vider_sorties_clones = Signal()
    # AJOUT (demande explicite utilisateur : "un bouton en bas du panneau,
    # sa vas copier les sorties de tout les profils sous forme de logs,
    # donc nom du sAutoniax, nom du profil, log renvoyé") -- distinct de
    # demande_copier_logs_execution_clone ci-dessus (celui-là copie les
    # journaux SYSTÈME bruts -- Serveur/mAutoniax/sAutoniax -- filtrés
    # par plage temporelle, via une requête réseau asynchrone). Celui-ci
    # copie la SORTIE DE CODE déjà connue localement de chaque profil
    # (CloneProfilEtat.cellules_resultats, alimentée au fil des
    # exécutions -- cf. TaskConfigScreen._callback_termine), donc aucun
    # aller-retour réseau n'est nécessaire : sans paramètre, comme
    # demande_vider_sorties_clones juste au-dessus, pour la même raison
    # (TaskConfigScreen connaît déjà l'ExecutionCloneEtat courant).
    demande_copier_logs_par_profil = Signal()
    # PATCH : « forcer l'affichage de la sortie » des clones COCHÉS en cours d'exécution (sans les arrêter).
    demande_forcer_sortie_clones = Signal()
    # AJOUT (SPEC_workspace_attribution.md, section 4 ; comportement des
    # deux clics mis à jour par PATCH v2, SPEC_patch_tasks_json.md section
    # 1.2 -- un WORKSPACE est désormais UN SEUL fichier JSON, plus un
    # dossier ni une liste chaînée) : bouton "Attribuer WORKSPACE" du
    # panneau clone -- DEUX signaux distincts plutôt qu'un seul avec un
    # paramètre "bouton utilisé", même esprit que le clic droit déjà géré
    # nativement par Qt sur bouton_tout_selectionner/bouton_
    # tout_deselectionner ci-dessus (CustomContextMenu, cf. __init__) : ce
    # panneau ne connaît ni Task ni le système de fichiers (cf. docstring
    # de classe -- "il émet des signaux, TaskConfigScreen résout"), donc
    # TOUTE la logique (fichier déjà configuré ou non, scan du JSON,
    # algorithme de répartition, sélecteur de fichier) vit côté
    # TaskConfigScreen, ce panneau se contente de dire LEQUEL des deux
    # clics a eu lieu.
    #
    # - demande_attribuer_workspace_silencieux (clic gauche) : si aucun
    #   fichier configuré -> ouvre le sélecteur de FICHIER JSON puis
    #   attribue aussitôt ; si déjà configuré -> ré-attribution immédiate
    #   sans boîte (spec section 4, cas "Un fichier WORKSPACE est déjà
    #   configuré"), cf. TaskConfigScreen._sur_demande_attribuer_
    #   workspace_silencieux.
    # - demande_attribuer_workspace_dialogue (clic droit) : si aucun
    #   fichier configuré -> même comportement que le clic gauche (spec :
    #   "clic gauche OU clic droit" tant qu'aucun fichier n'existe
    #   encore) ; si déjà configuré -> PATCH v2, réouvre directement le
    #   sélecteur de FICHIER JSON pour en choisir un autre (plus de
    #   DialogueWorkspaceConfig à ce clic -- ce dialogue reste
    #   disponible ailleurs dans l'app pour la gestion fine des tâches
    #   d'un fichier déjà choisi, cf. TaskConfigScreen._sur_demande_
    #   attribuer_workspace_dialogue).
    demande_attribuer_workspace_silencieux = Signal()
    demande_attribuer_workspace_dialogue = Signal()
    # SPEC_profils_environnements.md section 4.3 : clic sur une ligne
    # (hors checkbox) -- CLÉ COMPOSITE (id_executant::nom_profil, cf.
    # REFONTE MULTI-SAUTONIAX ci-dessus), ou "" pour désélectionner si la
    # ligne cliquée est déjà celle du profil actif.
    demande_definir_profil_actif = Signal(str)
    # Section 4.5 : bouton unique démarrer/arrêter individuel par ligne
    # (ajoutés par ce patch, cf. section 2.2 -- absents du fichier
    # avant, la spec les référence comme "déjà implémentées").
    # BUGFIX (bouton ⊙ individuel par ligne de profil, colonne Actions) :
    # ce signal portait uniquement nom_profil, donc le slot connecté
    # (TaskConfigScreen._sur_demande_lancer_clone_profil) recevait
    # toujours son défaut ouvrir_rendu_reseau=True -- alors que CE
    # bouton (distinct du bouton global "Tout exécuter") ne doit JAMAIS
    # ouvrir le panneau de rendu, quel que soit le clic. Signal étendu
    # à (str, bool) ; seul point d'émission (_construire_widget_actions_
    # profil ci-dessous) transmet désormais explicitement False.
    # REFONTE MULTI-SAUTONIAX -- le premier paramètre str des deux
    # signaux ci-dessous transporte désormais une CLÉ COMPOSITE
    # (id_executant::nom_profil), même raisonnement que demande_lancer_
    # clones ci-dessus.
    demande_lancer_clone_profil = Signal(str, bool)
    demande_arreter_clone_profil = Signal(str)
    # AJOUT (SPEC_lot_corrections_2026-09.md section 9) : nouveau bouton
    # "Kill" par ligne de profil, distinct et complémentaire du bouton
    # Arrêter/Démarrer existant juste au-dessus -- Kill reprend l'ANCIEN
    # comportement de "Arrêter" (kill_profil, tue le sous-processus
    # navigateur entier, cf. TaskConfigScreen._sur_demande_kill_clone_
    # profil), tandis que "Arrêter" est retravaillé en section 8 pour
    # n'interrompre QUE le code utilisateur sans toucher au profil.
    # Même CLÉ COMPOSITE (id_executant::nom_profil) que demande_arreter_
    # clone_profil ci-dessus, pour la même raison (cible sans ambiguïté
    # le bon profil même en cas d'homonymie entre sAutoniax).
    demande_kill_clone_profil = Signal(str)
    # AJOUT (demande explicite utilisateur : "quand on fait un clic droit
    # sur un profils clone dans le panneau de clone... sa affiche sont
    # navigatuer au premier plan") -- LOCAL SEULEMENT (confirmé
    # explicitement par l'utilisateur : pas besoin de router vers un
    # sAutoniax distant, cf. docstring de _sur_demande_premier_plan_
    # clone_profil côté TaskConfigScreen pour le garde-fou correspondant).
    # Même CLÉ COMPOSITE que demande_kill_clone_profil ci-dessus.
    demande_premier_plan_clone_profil = Signal(str)
    # SUPPRIMÉ (SPEC_lot_corrections_2026-09.md section 2) : signal
    # demande_rafraichir_connexion_profil et le statut "deconnecte" qui
    # le motivait -- un profil dont le sAutoniax disparaît est désormais
    # retiré directement de la liste au prochain rafraîchissement (cf.
    # TaskConfigScreen._invalider_executions_clone_disparues), plus
    # besoin de redemander explicitement une revérification de connexion.

    def __init__(self, parent=None):
        super().__init__(parent)
        # CLÉ COMPOSITE (id_executant::nom_profil, cf. _cle_profil_clone
        # -- REFONTE MULTI-SAUTONIAX, correctif collision de noms entre
        # sAutoniax homonymes) -> CloneProfilEtat -- dernier état connu,
        # reflet direct de ExecutionCloneEtat.profils du Task actuellement
        # affiché (cf. rafraichir_liste, seul point d'écriture de ce
        # dict -- ce panneau ne modifie jamais l'état lui-même, il
        # affiche ce que TaskConfigScreen lui pousse).
        self._profils: dict = {}
        # AJOUT (SPEC_lot_corrections_2026-09.md section 5) : référence
        # vers ReglagesApp, injectée après construction via definir_
        # reglages() (cf. plus bas) -- ce panneau ne construit ni ne
        # possède cet objet lui-même (même séparation de responsabilités
        # que le reste de la classe, cf. docstring de tête), il a
        # seulement besoin d'y LIRE pourcentage_selection_aleatoire_clone
        # au moment du clic sur bouton_selectionner_aleatoire. None tant
        # que definir_reglages() n'a pas encore été appelée (repli 50%
        # dans ce cas, cf. _sur_clic_selectionner_aleatoire).
        self._reglages = None
        # REFONTE ROBUSTESSE AFFICHAGE (retour utilisateur : "je veux que
        # tu refasses clairement la logique de mise à jour visuelle...
        # extrêmement robuste, je ne veux plus d'erreur" -- bug diagnostiqué
        # : iaX1 restait affiché "En cours" plusieurs secondes après que
        # les logs confirment profil_etat.statut == "succes", cf. logs
        # BADGE-TRACE) -- CAUSE RACINE CONFIRMÉE en lisant le code (pas
        # supposée) : _reconstruire_table faisait table_profils.clear() +
        # reconstruction INTÉGRALE des N lignes (texte + widget d'actions,
        # ce dernier coûteux : badge animé avec son propre QTimer ~60fps
        # tant qu'"en_cours", boutons avec icônes qtawesome) à CHAQUE
        # appel -- donc à CHAQUE transition de statut d'UN SEUL profil
        # parmi N. Avec N profils qui terminent dans une fenêtre de temps
        # rapprochée (le cas normal d'un lancement "clones" -- justement
        # N séquences EN PARALLÈLE), chaque transition déclenchait sa
        # PROPRE reconstruction complète des N lignes -- jusqu'à N
        # reconstructions complètes en rafale sur le thread Qt principal,
        # chacune recréant N widgets d'actions. Le texte correct d'iaX1
        # ("Succès") était donc bien écrit À TEMPS, mais aussitôt noyé
        # sous le travail GUI des N-1 AUTRES reconstructions complètes
        # déclenchées par les transitions des autres profils qui suivent
        # de près -- d'où le décalage visuel observé (jamais un vrai
        # blocage permanent, cf. retour utilisateur : "oui après, mais je
        # m'attendais à immédiatement").
        #
        # CLÉ COMPOSITE (cf. self._profils ci-dessus) -> QTreeWidgetItem
        # DÉJÀ inséré dans table_profils -- index persistant qui permet à
        # _reconstruire_table de ne toucher QUE ce qui a réellement
        # changé (cf. sa docstring pour le détail de la nouvelle
        # logique), au lieu de tout détruire/recréer à chaque appel.
        # Reconstruit intégralement UNIQUEMENT par _reconstruire_table_
        # completement (ensemble de profils modifié, ou auto-réparation).
        # Chaque QTreeWidgetItem porte AUSSI cette même clé composite en
        # Qt.UserRole (colonne 0, cf. _reconstruire_table_completement)
        # -- nécessaire car item.text(0) n'affiche que le nom NU.
        self._items: dict[str, "QTreeWidgetItem"] = {}
        # CLÉ COMPOSITE (cf. self._profils ci-dessus) -> statut au moment
        # où son widget d'actions (colonne 3 -- badge + boutons, cf.
        # _construire_widget_actions_profil) a été construit pour la
        # DERNIÈRE fois. _reconstruire_table ne reconstruit ce widget
        # précis que si etat_profil.statut a RÉELLEMENT changé depuis --
        # jamais pour les N-1 autres lignes non concernées par un appel
        # donné (contrairement au badge/boutons, le texte statut/temps et
        # le fond de ligne active restent réécrits systématiquement pour
        # toutes les lignes à chaque appel : de simples setText/
        # setForeground sur un item déjà affiché, sans coût de
        # reconstruction, donc aucune raison de s'en priver même quand
        # rien n'a changé pour cette ligne).
        self._dernier_statut_widget_actions: dict[str, str] = {}
        # CORRECTIF (déplacement de la pastille result_color, colonne
        # Actions -> colonne Statut, cf. _construire_widget_statut_profil)
        # : même esprit de cache que _dernier_statut_widget_actions
        # ci-dessus, mais clé sur (statut, result_color, est_actif) --
        # cf. docstring du site d'usage dans _reconstruire_table pour le
        # détail de pourquoi ces 3 valeurs précisément.
        self._dernier_cache_widget_statut: dict[str, tuple] = {}
        # REFONTE MULTI-SAUTONIAX -- remplace self._nom_sautoniax_cible
        # (ancien sous-titre unique "sAutoniax : X" pour tout le panneau).
        # Repeuplés à CHAQUE appel de rafraichir_liste (cf. ses paramètres
        # id_executant_par_profil/noms_par_id_executant et sa docstring
        # pour le raisonnement complet) -- initialisés vides ici
        # seulement pour que _reconstruire_table/_reconstruire_table_
        # completement (via _resoudre_id_executant_profil/_nom_executant)
        # ne plantent pas si jamais appelées avant le tout premier
        # rafraichir_liste (ne devrait pas arriver en usage normal,
        # aucune ligne n'existe encore dans table_profils à ce stade,
        # mais coûte rien de s'en prémunir).
        self._id_executant_par_profil: dict = {}
        self._noms_par_id_executant: dict = {}
        self._sequence_en_cours: bool = False
        # SPEC_profils_environnements.md section 4.4 : nom du profil actif
        # (ou None), pour teinter la ligne correspondante dans la table.
        self._profil_actif: Optional[str] = None
        # AJOUT (demande explicite utilisateur : surbrillance de la ligne
        # dont le navigateur local a le focus OS, cf. ProfilsInstancesScreen.
        # focus_navigateur_local_change/_sur_tick_focus_navigateur) -- clé
        # composite (cf. _cle_profil_clone) de la ligne à teinter pour le
        # focus, INDÉPENDANTE de self._profil_actif (qui pilote le rendu
        # vidéo/pilotage, pas juste une couleur -- cf. docstring de
        # _definir_profil_actif). None si aucun navigateur connu n'a
        # actuellement le focus. Alimentée uniquement par
        # _sur_focus_navigateur_local_change, relayée depuis
        # ProfilsInstancesScreen via MainWindow (jamais d'appel direct
        # entre écrans-frères, même patron que les autres signaux relayés
        # là-bas).
        self._profil_focus_os: Optional[str] = None
        # AJOUT (spec B.2, colonne "Temps") -- QTimer d'affichage LIVE,
        # tourne UNIQUEMENT tant qu'au moins un profil est "en_cours"
        # (démarré/arrêté par _synchroniser_timer_temps, jamais laissé
        # tourner en permanence -- inutile de recalculer une colonne
        # figée pour des profils déjà terminés). Intervalle 1s (cf. spec,
        # "par exemple") : suffisant pour un chrono lisible à l'oeil,
        # sans recalculer/rafraîchir la table trop souvent.
        self._timer_temps = QTimer(self)
        self._timer_temps.setInterval(1000)
        self._timer_temps.timeout.connect(self._sur_tick_timer_temps)

        layout = QVBoxLayout(self)
        # NOTE : layout construit juste après (voir suite de __init__
        # inchangée ci-dessous) -- showEvent() est défini plus bas dans
        # cette classe (cf. juste après _sur_tick_timer_temps), pas ici,
        # simplement documenté à cet endroit pour rester à côté de
        # self._timer_temps qu'il synchronise.
        # CORRECTIF (retour utilisateur explicite, capture d'écran :
        # "sa occupe trop lespace en huteur, comprime en bas, je veux
        # vraiment une vue max pour les clone") -- marges et espacement
        # resserrés (étaient 16/20/16/20 et 10) : ce panneau est à
        # largeur FIXE (self.setFixedWidth(340) côté TaskConfigScreen) et
        # sa hauteur restante après en-tête/sous-titre/séparateur/statut/
        # grille de boutons revient ENTIÈREMENT à table_profils (stretch=1
        # ci-dessous, cf. son addWidget) -- toute marge/espacement ici est
        # donc de la hauteur retirée directement à la liste des profils,
        # l'élément que la personne veut voir en priorité ("vue max pour
        # les clones"). Aucune information supprimée, juste resserrée.
        layout.setContentsMargins(12, 12, 12, 10)
        layout.setSpacing(6)
        layout.setAlignment(Qt.AlignTop)

        # --- En-tête : titre + sAutoniax ciblé + bouton Rafraîchir ---
        ligne_entete = QHBoxLayout()
        self.label_titre = QLabel("Exécutions clone", self)
        self.label_titre.setObjectName("ReglagesTitre")
        self.label_titre.setWordWrap(True)
        ligne_entete.addWidget(self.label_titre, stretch=1)

        self.bouton_rafraichir = QPushButton(self)
        self.bouton_rafraichir.setIcon(qta.icon("mdi6.refresh", color=Mocha.text))
        self.bouton_rafraichir.setText("Rafraîchir")
        self.bouton_rafraichir.setCursor(Qt.PointingHandCursor)
        self.bouton_rafraichir.clicked.connect(self.demande_rafraichir_profils.emit)
        ligne_entete.addWidget(self.bouton_rafraichir, stretch=0)
        layout.addLayout(ligne_entete)

        self.label_sous_titre = QLabel("", self)
        self.label_sous_titre.setObjectName("PlaceholderSubtitle")
        self.label_sous_titre.setWordWrap(True)
        layout.addWidget(self.label_sous_titre)

        separateur = QFrame(self)
        separateur.setObjectName("ReglagesSeparateur")
        separateur.setFixedHeight(1)
        layout.addWidget(separateur)

        # --- Zone de statut texte (§4.2 point 2) ---
        self.label_statut = QLabel("", self)
        self.label_statut.setObjectName("PlaceholderSubtitle")
        self.label_statut.setWordWrap(True)
        layout.addWidget(self.label_statut)

        # SPEC_profils_environnements.md section 2.1 : plus de bandeau
        # "affichage clone" ni de bouton "revenir au notebook réel" --
        # il n'existe plus de notion de "notebook réel" séparée d'un
        # profil actif (section 1 point 11). Le retour à "aucun profil
        # actif" se fait en recliquant la ligne déjà active (section 4.3).

        # --- Liste des profils (§4.2 point 3) ---
        self.table_profils = QTreeWidget(self)
        self.table_profils.setObjectName("PanneauExecutionCloneTable")
        self.table_profils.setRootIsDecorated(False)
        self.table_profils.setUniformRowHeights(False)
        self.table_profils.setSelectionMode(QAbstractItemView.NoSelection)
        self.table_profils.setHeaderLabels(["Profil", "sAutoniax", "Actions", "Statut", "Temps"])
        # SPEC_lot_corrections_2026-09.md section 10 (HISTORIQUE) : la
        # colonne Profil ne pouvait plus rester en mode Stretch une fois
        # le panneau réduit à 227px total (largeur FIXE du panneau à
        # l'époque) -- passée en Fixed à 46px (~5 caractères, ex. "iaX12")
        # avec troncature + tooltip pour le reste.
        #
        # CORRECTIF (retour utilisateur : "le noms complet de profils
        # doit etre visible" + "je veux que tu met ce panneau sur forme
        # de QSPlitter... sa alonge ou retrecir lespace du notebbok") --
        # Fixed à 46px empêchait le nom de profiter de l'espace regagné
        # en élargissant le panneau via le nouveau splitter (une largeur
        # de COLONNE fixe ne bouge jamais, quelle que soit la largeur du
        # PANNEAU qui la contient). Repassée en Interactive : Qt lui
        # donne une largeur de départ raisonnable pour le contenu actuel
        # (ajustée juste en dessous via resizeColumnToContents, posé
        # après le premier peuplement de la table -- cf. _reconstruire_
        # table_completement) ET l'utilisateur peut désormais aussi la
        # redimensionner à la main par glisser-déposer sur l'en-tête,
        # indépendamment du splitter. Troncature + tooltip (posés plus
        # bas) restent en place comme filet de sécurité si le panneau est
        # laissé à sa largeur initiale étroite.
        self.table_profils.header().setSectionResizeMode(0, QHeaderView.Interactive)
        # CORRECTIF (retour utilisateur : "je voir un vide dans la colone
        # de noms de profils") -- le commentaire ci-dessus affirmait qu'un
        # resizeColumnToContents() suivait "après le premier peuplement",
        # mais cet appel a en réalité été retiré (cf. commentaire dans
        # _reconstruire_table_completement : "SUPPRIMÉ ... l'appel
        # resizeColumnToContents(1, 3, 4)") -- la colonne 0 n'a JAMAIS été
        # concernée par cet appel même à l'origine, et rien d'autre dans le
        # fichier n'appelle resizeColumnToContents sur cette table. 90px
        # restait donc figé tel quel, trop étroit pour un nom de profil
        # réel à la taille de police courante, d'où l'impression de "vide"/
        # texte coupé sur la capture utilisateur.
        # CORRECTIF 2 (retour utilisateur : "cest grand inutilsement" --
        # 130px posé au premier correctif ci-dessus visait un pire cas
        # hypothétique ("iaBoost12") jamais observé en pratique -- les
        # captures fournies montrent systématiquement des noms "iaX1" à
        # "iaX20" (4-5 caractères). Resserrée à 62px, mesurée sur ce
        # contenu réel avec une marge modeste plutôt qu'un pire cas
        # imaginé ; reste Interactive, donc ajustable à la main si un nom
        # de profil plus long apparaît un jour (tooltip déjà posé en
        # filet de sécurité, cf. item.setToolTip(0, ...) plus bas).
        self.table_profils.setColumnWidth(0, 62)
        # CORRECTIF (retour utilisateur : "et tu as élargi pour le temps ?")
        # -- QTreeWidget active stretchLastSection=True par défaut, qui
        # étire la DERNIÈRE colonne du header pour combler tout l'espace
        # restant du tableau. Avant le réordonnancement, la dernière
        # colonne était Actions (déjà gérée par son propre stretch
        # interne, cf. plus bas) ; Temps est désormais la dernière
        # colonne (cf. setHeaderLabels ci-dessus), donc SANS cette
        # désactivation, Qt l'aurait étirée bien au-delà des 70px voulus
        # pour "99m 59s" -- exactement le même symptôme ("espace
        # étrange") que celui corrigé juste en dessous pour Actions,
        # mais cette fois sur Temps. setColumnWidth(4, ...) plus bas
        # resterait sans effet si ce stretch automatique restait actif.
        self.table_profils.header().setStretchLastSection(False)
        # CORRECTIF (retour utilisateur : "je vois un espace étrange dans
        # la colonne Actions, c'est trop long") -- la colonne Actions
        # (index 2 depuis le réordonnancement ci-dessus) contient un
        # widget (cf. _construire_widget_actions_profil, posé via
        # setItemWidget) qui se termine par un ligne.addStretch(1) --
        # ce stretch existait déjà avant le réordonnancement, mais ne se
        # voyait pas car la colonne Actions était alors en DERNIÈRE
        # position (4), sans aucune colonne large après elle sur
        # laquelle "déborder" visuellement. Maintenant en position 2
        # (encadrée par sAutoniax et Statut), et sans largeur imposée,
        # Qt lui attribue sa largeur "interactive" par défaut (souvent
        # ~130-150px) -- bien plus que ce dont badge + boutons ont
        # besoin -- et le stretch interne du widget remplit tout cet
        # excédent de vide, d'où l'espace visible sur la capture.
        # setSectionResizeMode(..., Fixed) + setColumnWidth ci-dessous
        # fige une largeur juste suffisante pour badge + 1-2 boutons,
        # et empêche Qt de la réélargir automatiquement par la suite
        # (contrairement à une colonne en mode interactif par défaut).
        # 130px mesuré avec une marge confortable au-dessus du pire cas
        # réel (badge 18px + 2 QToolButton, statut "deconnecte" -- cf.
        # docstring de _construire_widget_actions_profil -- mesure à
        # ~86px de large minimum avec les marges/spacing du layout), pour
        # rester lisible même avec un thème/police/DPI légèrement
        # différent de l'environnement de mesure.
        # CORRECTIF (retour utilisateur : "je ne voir pas la pastille de
        # etat de execution") -- les 80px ci-dessous (setColumnWidth(2,
        # 80) un peu plus bas) ont été mesurés pour badge + 2 boutons
        # SEULEMENT (cf. commentaire d'origine juste plus bas) -- la
        # pastille result_color (SPEC section 11, ajoutée après ce calcul)
        # n'entre dans ce budget que quand un profil termine en succès
        # avec une result_color non blanche (cf. _construire_widget_
        # actions_profil) : marges 8 + badge 18 + spacing 6 + pastille 10
        # + spacing 6 + bouton 20 + spacing 6 + bouton 20 = 94px, débordant
        # des 80px déjà pile ajustés -- la pastille était donc rognée/
        # invisible dès qu'elle apparaissait, exactement le symptôme
        # rapporté. setColumnWidth(2, ...) élargi ci-dessous à 96px.
        self.table_profils.header().setSectionResizeMode(2, QHeaderView.Fixed)
        # SPEC_lot_corrections_2026-09.md section 10 (+ section 9) :
        # cette colonne contient désormais badge + 2 boutons (Arrêter +
        # Kill, cf. _construire_widget_actions_profil) au lieu de badge +
        # 1 seul bouton -- élargie au STRICT nécessaire pour ce nouveau
        # contenu plutôt que reconduire la marge confortable de 130px
        # mesurée à l'origine pour 1 seul bouton (cf. commentaire
        # d'origine ci-dessus, conservé pour l'historique du calcul).
        # Estimation (aucun affichage Qt réel disponible dans cet
        # environnement pour mesurer au pixel près, même limite déjà
        # documentée section 6 -- vérification manuelle recommandée) :
        # marges layout 4+4=8, badge 18, spacing 6, bouton Arrêter/
        # Démarrer ~20, spacing 6, bouton Kill ~20, ~2px de marge de
        # sécurité = 80px. Sans le ligne.addStretch(1) final de
        # _construire_widget_actions_profil, ce stretch comblerait tout
        # excédent au-delà du nécessaire si cette estimation était trop
        # large -- pas de risque de débordement si elle est légèrement
        # trop courte non plus, Qt tronquera au pire le stretch, jamais
        # les boutons eux-mêmes (layout QHBoxLayout standard).
        self.table_profils.setColumnWidth(2, 96)
        # CORRECTIF (retour utilisateur : "je n'arrive pas à bien voir les
        # données de temps complet quand ça dépasse les secondes") -- la
        # colonne Temps (désormais colonne 4, cf. réordonnancement des
        # en-têtes ci-dessus -- Actions avant Statut, Temps en dernier)
        # n'avait AUCUNE largeur minimale garantie :
        # resizeColumnToContents(4) (cf. _reconstruire_table_completement)
        # n'est appelé qu'UNE FOIS, juste après la reconstruction, sur le
        # texte affiché À CE MOMENT-LÀ -- souvent "1s" ou même "" pour un
        # profil qui vient de démarrer (cf. _texte_temps). Qt calcule donc
        # la largeur de colonne sur ce texte court initial et ne la
        # recalcule PLUS ensuite (ni au fil des ticks de _sur_tick_timer_
        # temps, ni quand le profil se termine) -- dès que la durée
        # dépasse une minute ("1m 3s", plus large que "1s"), le texte est
        # tronqué dans une colonne restée trop étroite.
        # setMinimumSectionSize fixait auparavant un plancher GLOBAL,
        # appliqué à TOUTES les colonnes interactives (1 à 4) -- pensé
        # pour rester défensif si sAutoniax/Actions/Statut subissaient un
        # jour le même genre de contenu variable que Temps. Incompatible
        # avec le budget total de 227px (SPEC_lot_corrections_2026-09.md
        # section 10) : un plancher de 70px sur sAutoniax(1)/Statut(3) en
        # plus des 46+80px déjà posés sur Profil/Actions dépasserait déjà
        # le total avant même d'attribuer quoi que ce soit à Temps.
        # Remplacé par un plancher ciblé UNIQUEMENT sur la colonne Temps
        # (toujours seule concernée en pratique par un contenu qui
        # s'allonge après le premier affichage, cf. docstring ci-dessus)
        # via setColumnWidth directement, sans toucher au comportement
        # des 3 autres colonnes interactives.
        #
        # sAutoniax(1) et Statut(3) : largeurs fixes resserrées pour
        # tenir dans le budget de 227px -- texte tronqué avec ellipsis
        # natif si plus long, tooltip complet posé sur l'item pour rester
        # lisible au survol (cf. _reconstruire_table_completement/
        # _reconstruire_table, qui posent désormais setToolTip en plus de
        # setText sur ces deux colonnes).
        #
        # CORRECTIF (retour utilisateur : "je veux que tu abrege
        # sAutoniac en sAuto1, sAuto2") -- colonne(1) repassée en
        # Interactive pour la même raison que Profil(0) juste au-dessus
        # (une largeur Fixed ne profite jamais de l'espace regagné via le
        # nouveau splitter) ; largeur de départ resserrée à 48px, mesurée
        # pour l'abréviation courte ("sAuto12" tient largement dedans,
        # contre "sAutoniax-12" qui aurait débordé) -- cf. _nom_executant
        # pour la résolution id -> "sAutoN" désormais appliquée. Statut(3)
        # reste Fixed/42 : pas concerné par cette demande, ses libellés
        # ("Succès", "Échec"...) restent de longueur fixe et connue.
        self.table_profils.header().setSectionResizeMode(1, QHeaderView.Interactive)
        self.table_profils.setColumnWidth(1, 48)
        # CORRECTIF (retour utilisateur : "je veux que le message de
        # statut soit completement affiché, succes est coupé") -- 42px
        # (hérité de la section 10, pensé à l'époque pour un panneau à
        # largeur FIXE de 227px) tronquait déjà "Succès" en "Succ..." --
        # confirmé sur capture d'écran. Pire cas réel parmi _libelle_statut
        # : "En attente" (10 caractères), largement au-delà de 42px.
        # Élargie à 72px (marge confortable pour "En attente" en 15pt) --
        # le panneau n'est plus contraint à 227px fixes depuis le passage
        # au QSplitter, ce budget serré n'a donc plus lieu d'être aussi
        # strict ici non plus.
        # CORRECTIF (retour utilisateur, capture d'écran à l'appui : "la
        # pastille n'est pas assez grosse") -- 72px ne laissait quasiment
        # aucune marge à droite de "En attente" pour une pastille lisible
        # (cf. _construire_widget_statut_profil, pastille passée de 8px à
        # 12px en même temps que ce changement). Élargie à 96px : "En
        # attente" (pire cas texte) + spacing(4) + pastille 12px + marge
        # droite(4) tiennent confortablement, sans troncature ni pastille
        # collée au bord.
        self.table_profils.header().setSectionResizeMode(3, QHeaderView.Fixed)
        self.table_profils.setColumnWidth(3, 96)
        # Temps(4) : pire cas plausible "99m 59s" (format _formater_duree)
        # -- réduit par rapport aux 70px d'origine (mesurés avec une marge
        # confortable quand le panneau faisait 340px) mais toujours
        # dimensionné pour ce texte au complet, sans troncature : c'est
        # une valeur numérique que l'utilisateur doit pouvoir lire sans
        # avoir à survoler pour un tooltip.
        self.table_profils.header().setSectionResizeMode(4, QHeaderView.Fixed)
        self.table_profils.setColumnWidth(4, 55)
        # Budget total (HISTORIQUE, panneau à largeur FIXE 227px à
        # l'époque) : Profil 46 + sAutoniax 42 + Actions 80 + Statut 42 +
        # Temps 55 = 265px de contenu de colonnes pour 227px de panneau,
        # léger défilement horizontal accepté.
        #
        # CORRECTIF (cf. commentaires Profil(0)/sAutoniax(1) ci-dessus) --
        # ce budget fixe n'a plus cours : Profil et sAutoniax sont
        # désormais Interactive, dimensionnées pour leur contenu réel
        # ("sAutoN" abrégé + nom de profil complet) plutôt que contraintes
        # à tenir dans 227px coûte que coûte -- le panneau lui-même n'a
        # plus de largeur fixe non plus (cf. TaskConfigScreen.splitter_
        # notebook_clone). 227px reste seulement la largeur INITIALE du
        # panneau au premier affichage (cf. setSizes du splitter) ; un
        # défilement horizontal à cette largeur de départ reste possible
        # et acceptable exactement comme avant, résorbé dès que
        # l'utilisateur élargit le panneau via la poignée du splitter.

        # SPEC_profils_environnements.md section 4.3 : clic sur une
        # ligne (n'importe quelle colonne, filtré dans le handler pour
        # ignorer la colonne 0/checkbox) définit le profil actif.
        self.table_profils.itemClicked.connect(self._sur_clic_ligne_profil)
        # BUGFIX (connexion dupliquée à chaque reconstruction) -- cette
        # connexion vivait auparavant DANS _reconstruire_table, appelée à
        # chaque rafraichir_liste (donc à chaque transition de statut d'un
        # profil clone : démarrage, cellule suivante, succès, erreur,
        # arrêt -- potentiellement très fréquent pendant une séquence
        # active). table_profils n'est JAMAIS recréé (seulement vidé via
        # .clear() dans _reconstruire_table), donc chaque appel empilait
        # une connexion supplémentaire sur le MÊME signal sans jamais la
        # retirer -- après N reconstructions, une seule coche/décoche
        # déclenchait _sur_item_changed N fois (effet indirectement
        # visible : label_statut/bouton_lancer_clones recalculés en
        # boucle pour rien, dégradation progressive des performances sur
        # une session longue). Posée ICI, une seule fois, même patron
        # EXACT que PanneauProprietesSautoniax.__init__ (itemChanged
        # connecté une seule fois à la construction, jamais dans son
        # équivalent de _reconstruire_table) -- référence visuelle déjà
        # suivie pour la checkbox elle-même (cf. spec A.1), maintenant
        # suivie aussi pour son câblage.
        self.table_profils.itemChanged.connect(self._sur_item_changed)
        self.table_profils.setCursor(Qt.PointingHandCursor)
        # AJOUT (demande explicite utilisateur : clic droit sur un profil
        # clone -> premier plan ponctuel, LOCAL SEULEMENT -- "directement,
        # je ne veux pas de menue") -- setContextMenuPolicy(CustomContextMenu)
        # + customContextMenuRequested reste le mécanisme Qt utilisé (c'est
        # la façon standard de capter un clic droit sur un QTreeWidget,
        # cf. les autres usages de ce couple dans le fichier), MAIS le
        # handler ci-dessous n'ouvre AUCUN QMenu : il résout la ligne sous
        # le curseur et émet directement demande_premier_plan_clone_profil,
        # sans étape intermédiaire -- un seul clic droit, une seule action.
        self.table_profils.setContextMenuPolicy(Qt.CustomContextMenu)
        self.table_profils.customContextMenuRequested.connect(self._sur_clic_droit_ligne_profil)
        layout.addWidget(self.table_profils, stretch=1)

        # --- Bas du panneau : actions groupées, icône seule (§4.2 point 4)
        # CORRECTIF (retour utilisateur explicite, capture d'écran annotée :
        # "regarde comment cette idiote de Claude a mis les boutons, j'ai
        # pourtant dit que tout les boutons sans texte, et que les 3
        # dernier bouton en bas doivent etre sans texte, et que tout les 3
        # bouton qu'il a mis en haut doivent etre aussi en bas avec eux") --
        # DEUX corrections par rapport à la version précédente :
        #   1. Les 3 boutons de sélection en masse (tout sélectionner/
        #      désélectionner/sélectionner les échecs), placés par erreur
        #      en haut du panneau (entre le sous-titre et le tableau),
        #      sont déplacés ICI, groupés avec le reste des actions.
        #   2. Les 4 boutons déjà présents ici (Lancer les clones/Arrêter/
        #      Vider les sorties/Capturer tout) portaient encore du texte
        #      visible à côté de leur icône -- convertis en QToolButton
        #      icône-seule (AutoRaise, même style que les 3 de sélection),
        #      le texte explicatif reste disponible au survol via
        #      setToolTip plutôt qu'affiché en permanence.
        # Disposées en rangées de 2 (QHBoxLayout + stretch final) plutôt
        # qu'une par ligne comme l'ancien bloc de sélection : 7 boutons
        # icône-seule empilés un par un occuperaient une hauteur inutile,
        # alors que côte à côte ils restent lisibles sur les 340px fixes
        # du panneau (cf. self.setFixedWidth(340) côté TaskConfigScreen).

        def _creer_bouton_icone(nom_icone: str, tooltip: str, couleur=Mocha.text) -> QToolButton:
            bouton = QToolButton(self)
            bouton.setAutoRaise(True)
            bouton.setIcon(qta.icon(nom_icone, color=couleur))
            # CORRECTIF (retour utilisateur explicite, capture d'écran :
            # "sa occupe trop lespace en huteur ... je veux vraiment une
            # vue max pour les clone") -- icône réduite (était 20x20) et
            # hauteur du bouton contrainte explicitement : sans
            # setFixedHeight, QToolButton ajoute son propre padding
            # interne (Qt Fusion) au-dessus de la taille d'icône, non
            # compressible autrement -- avec 11 boutons répétés sur 4
            # rangées, ce padding cumulé pèse significativement sur la
            # hauteur totale que table_profils (stretch=1) ne peut alors
            # plus récupérer. Reste largement cliquable (28px) et lisible.
            bouton.setIconSize(QSize(17, 17))
            bouton.setFixedSize(28, 28)
            bouton.setCursor(Qt.PointingHandCursor)
            bouton.setToolTip(tooltip)
            return bouton

        self.bouton_lancer_clones = _creer_bouton_icone(
            "mdi6.play-box-multiple-outline", "Lancer les clones", couleur=Mocha.green,
        )
        self.bouton_lancer_clones.setEnabled(False)  # activé dès qu'au moins une case est cochée
        self.bouton_lancer_clones.clicked.connect(self._sur_clic_lancer_clones)

        self.bouton_arreter_clones = _creer_bouton_icone(
            "mdi6.stop-circle-outline", "Arrêter", couleur=Mocha.red,
        )
        self.bouton_arreter_clones.setVisible(False)  # visible seulement si sequence_en_cours
        self.bouton_arreter_clones.clicked.connect(self.demande_arreter_clones.emit)

        self.bouton_vider_sorties_clones = _creer_bouton_icone(
            "mdi6.eraser",
            "Réinitialiser le panneau -- vide la sortie connue de TOUS les profils clone pour "
            "ce Task, ET remet leur statut/badge de couleur/horodatages à l'état neutre "
            "(comme si aucun lot n'avait encore été lancé) ; n'affecte pas le notebook réel "
            "(cf. icône gomme de la toolbar principale), ne touche pas à la sélection (cases "
            "cochées).",
        )
        self.bouton_vider_sorties_clones.setEnabled(False)  # actif seulement si au moins un profil a un résultat connu
        self.bouton_vider_sorties_clones.clicked.connect(self.demande_vider_sorties_clones.emit)

        self.bouton_capturer_tout = _creer_bouton_icone(
            "mdi6.camera-burst",
            "Capturer tout -- capture ponctuelle du rendu de toutes les instances clone "
            "actives, sauvegardée sur disque (jeu de données visuelles horodaté).",
        )
        self.bouton_capturer_tout.setEnabled(False)  # actif seulement si au moins un clone a un instance_id connu
        self.bouton_capturer_tout.clicked.connect(self.demande_capturer_tout.emit)

        # CORRECTIF (AttributeError au démarrage : "'PanneauExecutionClone'
        # object has no attribute 'bouton_tout_selectionner'") -- ces 3
        # boutons avaient été retirés de leur ancien emplacement (haut du
        # panneau) lors de leur déplacement ici, en bas, mais leur création
        # elle-même avait été oubliée par erreur : seule leur RÉFÉRENCE
        # subsistait dans boutons_actions_ordonnes juste plus bas. Recréés
        # ici, au même endroit logique que les 4 boutons ci-dessus, AVANT
        # la liste qui les assemble tous dans la grille.
        self.bouton_tout_selectionner = _creer_bouton_icone(
            "mdi6.checkbox-multiple-marked-outline", "Tout sélectionner",
        )
        self.bouton_tout_selectionner.clicked.connect(self._sur_clic_tout_selectionner)

        self.bouton_tout_deselectionner = _creer_bouton_icone(
            "mdi6.checkbox-multiple-blank-outline", "Tout désélectionner",
        )
        self.bouton_tout_deselectionner.clicked.connect(self._sur_clic_tout_deselectionner)

        # AJOUT (SPEC_lot_corrections_2026-09.md section 12) : clic droit
        # sur CHACUN de ces deux boutons -- indépendant du clic gauche
        # existant (clicked, ci-dessus) -- ouvre le menu de sélection par
        # result_color (cf. _afficher_menu_couleurs_result_color). Même
        # patron EXACT que les autres menus contextuels du fichier (ex.
        # table_executants/arbre : setContextMenuPolicy(CustomContextMenu)
        # + customContextMenuRequested, jamais un simple clic droit brut
        # -- Qt distingue nativement les deux, aucun risque de conflit
        # avec .clicked qui ne réagit qu'au bouton gauche).
        self.bouton_tout_selectionner.setContextMenuPolicy(Qt.CustomContextMenu)
        self.bouton_tout_selectionner.customContextMenuRequested.connect(
            lambda position: self._afficher_menu_couleurs_result_color(
                self.bouton_tout_selectionner, position
            )
        )
        self.bouton_tout_deselectionner.setContextMenuPolicy(Qt.CustomContextMenu)
        self.bouton_tout_deselectionner.customContextMenuRequested.connect(
            lambda position: self._afficher_menu_couleurs_result_color(
                self.bouton_tout_deselectionner, position
            )
        )

        self.bouton_selectionner_echecs = _creer_bouton_icone(
            "mdi6.alert-circle-check-outline", "Sélectionner les échecs", couleur=Mocha.red,
        )
        self.bouton_selectionner_echecs.clicked.connect(self._sur_clic_selectionner_echecs)

        # AJOUT (SPEC_lot_corrections_2026-09.md section 5) : coche
        # ALÉATOIREMENT un pourcentage des profils listés (décoche tous
        # les autres), MÊME patron que bouton_tout_selectionner/bouton_
        # selectionner_echecs ci-dessus. Le pourcentage est configurable
        # dans ParametresScreen (ReglagesApp.pourcentage_selection_
        # aleatoire_clone) -- lu depuis ce réglage à CHAQUE clic, jamais
        # redemandé sur place (cf. _sur_clic_selectionner_aleatoire).
        self.bouton_selectionner_aleatoire = _creer_bouton_icone(
            "mdi6.dice-multiple-outline", "Sélectionner aléatoirement",
        )
        self.bouton_selectionner_aleatoire.clicked.connect(self._sur_clic_selectionner_aleatoire)

        # AJOUT (demande explicite utilisateur : "tu met le bouton en bas
        # du panneau des clone, et non dans les paramètres" -- bouton de
        # copie des logs bornée à la fenêtre temporelle de CETTE
        # exécution, cf. docstring de demande_copier_logs_execution_clone
        # et de ExecutionCloneEtat.horodatage_lancement_lot/fin_lot).
        # Activé/désactivé par rafraichir_liste() ci-dessous (actif dès
        # qu'un lancement a eu lieu au moins une fois pour ce Task --
        # horodatage_lancement_lot non None -- même après la fin du lot,
        # pour rester utilisable un moment après coup).
        self.bouton_copier_logs_execution = _creer_bouton_icone(
            "mdi6.clipboard-text-clock-outline",
            "Copier les logs de cette exécution -- copie dans le presse-papier les logs "
            "(Serveur + mAutoniax + sAutoniax) de TOUS les clones, mais UNIQUEMENT ceux "
            "produits entre le lancement de ce lot et sa fin (ou l'instant présent si le "
            "lot tourne encore) -- utilisable pendant ou après l'exécution.",
        )
        self.bouton_copier_logs_execution.setEnabled(False)  # actif seulement si un lot a déjà été lancé pour ce Task
        self.bouton_copier_logs_execution.clicked.connect(self.demande_copier_logs_execution_clone.emit)

        # AJOUT (demande explicite utilisateur : "un bouton en bas du
        # panneau, sa vas copier les sortir de tout les profils sur
        # forme de logs, donc noms du sautoniax, noms du profils, log
        # renvoyer") -- cf. docstring de demande_copier_logs_par_profil
        # ci-dessus pour la distinction avec bouton_copier_logs_execution
        # (celui-ci : sortie de code par profil, déjà en mémoire, aucune
        # requête réseau). Activé/désactivé par rafraichir_liste() ci-
        # dessous avec le même critère que bouton_vider_sorties_clones
        # (nb_avec_resultats > 0) -- rien à copier tant qu'aucun profil
        # n'a de résultat connu, mais contrairement à bouton_vider_
        # sorties_clones, reste actif MÊME pendant sequence_en_cours :
        # copier un instantané des sorties déjà arrivées pendant qu'une
        # séquence tourne encore reste un usage valide (même raisonnement
        # que bouton_copier_logs_execution, cf. sa docstring).
        self.bouton_copier_logs_par_profil = _creer_bouton_icone(
            "mdi6.clipboard-text-multiple-outline",
            "Copier les sorties par profil -- copie dans le presse-papier, pour chaque "
            "profil ayant déjà produit un résultat, son sAutoniax, son nom, et la sortie "
            "de chacune de ses cellules exécutées (format logs, une section par profil).",
        )
        self.bouton_copier_logs_par_profil.setEnabled(False)  # actif seulement si au moins un profil a un résultat connu
        self.bouton_copier_logs_par_profil.clicked.connect(self.demande_copier_logs_par_profil.emit)

        # PATCH : force la sortie de logs des clones cochés qui tournent, sans les arrêter ni les relancer.
        self.bouton_forcer_sortie_clones = _creer_bouton_icone(
            "mdi6.text-box-check-outline",
            "Forcer l'affichage de la sortie -- réactive la sortie de logs des clones COCHÉS actuellement en "
            "exécution, sans les arrêter. Ce qui avait été retenu pendant la coupure est renvoyé à la ligne "
            "suivante écrite par le clone.",
            couleur=Mocha.sapphire,
        )
        self.bouton_forcer_sortie_clones.setEnabled(False)  # actif si au moins un clone coché tourne
        self.bouton_forcer_sortie_clones.clicked.connect(self.demande_forcer_sortie_clones.emit)

        # AJOUT (demande explicite utilisateur : "tu met le bouton de
        # picker color directement en bas du panneau des clone") : ouvre
        # le sélecteur de couleur NATIF de l'OS via la façade unifiée
        # BoiteDialogueAutoniaX.couleur(...) (cf. SPEC_lot_corrections_
        # 2026-09.md section 6 -- décision tranchée : la façade d'appel
        # est unifiée/custom, mais le sélecteur natif lui-même n'est PAS
        # réimplémenté), puis appelle _sur_choix_couleur_result_color
        # avec le hex choisi -- MÊME fonction déjà câblée pour le clic
        # sur une entrée du menu contextuel (section 12), donc coche tous
        # les profils dont result_color correspond à cette couleur et
        # décoche tous les autres. Contrairement au menu contextuel
        # (couleurs déjà OBSERVÉES uniquement), ce bouton permet de
        # choisir n'importe quelle couleur, y compris une jamais encore
        # vue parmi les profils affichés (aucun profil ne matchera alors
        # -- tout est décoché, comportement cohérent avec _sur_choix_
        # couleur_result_color, pas de cas particulier à gérer ici).
        self.bouton_choisir_couleur_result_color = _creer_bouton_icone(
            "mdi6.palette-outline",
            "Sélectionner par couleur -- ouvre un sélecteur de couleur et coche tous les "
            "profils dont le result_color (section 11) correspond exactement à la couleur "
            "choisie, décoche tous les autres.",
        )
        self.bouton_choisir_couleur_result_color.clicked.connect(
            self._sur_clic_choisir_couleur_result_color
        )

        # AJOUT (SPEC_workspace_attribution.md, section 4) : bouton
        # "Attribuer WORKSPACE" -- clic gauche = attribution silencieuse
        # (ou premier choix de dossier si aucun n'est encore configuré),
        # clic droit = boîte de dialogue complète (ou ce même premier
        # choix de dossier tant qu'aucun n'existe encore -- spec : "clic
        # gauche OU clic droit" dans ce cas précis). Ce panneau ne sait PAS
        # lui-même si un dossier est déjà configuré pour ce Task (aucun
        # accès à Task d'ici, cf. docstring de classe) -- les deux cas
        # sont entièrement démêlés côté TaskConfigScreen (_sur_demande_
        # attribuer_workspace_silencieux/_dialogue), ce bouton se contente
        # d'émettre lequel des deux clics a eu lieu, même patron EXACT que
        # bouton_tout_selectionner/bouton_tout_deselectionner ci-dessus
        # (CustomContextMenu + customContextMenuRequested pour le clic
        # droit, .clicked pour le clic gauche -- Qt distingue nativement
        # les deux boutons de la souris, aucun risque de double-
        # déclenchement).
        self.bouton_attribuer_workspace = _creer_bouton_icone(
            "mdi6.folder-network-outline",
            "Attribuer WORKSPACE -- clic gauche : attribue (ou choisit le fichier WORKSPACE "
            "si ce n'est pas encore fait) silencieusement, sans boîte de dialogue. Clic "
            "droit : ouvre la boîte Workspace Config (liste des tâches, marquage "
            "manuel, choix du mode de répartition).",
        )
        self.bouton_attribuer_workspace.clicked.connect(
            self.demande_attribuer_workspace_silencieux.emit
        )
        self.bouton_attribuer_workspace.setContextMenuPolicy(Qt.CustomContextMenu)
        self.bouton_attribuer_workspace.customContextMenuRequested.connect(
            lambda position: self.demande_attribuer_workspace_dialogue.emit()
        )

        # CORRECTIF (retour utilisateur explicite, capture d'écran :
        # "sa occupe trop lespace en huteur, comprime en bas, je veux
        # vraiment une vue max pour les clone") -- la réorganisation en 4
        # grilles séparées (une par groupe fonctionnel) + un addSpacing(8)
        # entre chacune ajoutait de la hauteur FIXE non compressible en
        # plus de la hauteur des boutons eux-mêmes (3 espacements de 8px
        # + les marges internes de 4 QGridLayout au lieu d'un seul) : sur
        # un panneau à largeur fixe (self.setFixedWidth(340) côté
        # TaskConfigScreen) où toute la hauteur restante revient au
        # tableau (stretch=1 ci-dessus), chaque pixel dépensé ici est un
        # pixel perdu pour lister les profils -- exactement ce que la
        # capture montre (table_profils visiblement écrasé en hauteur).
        # Retour à UNE SEULE grille compacte (comme avant l'ajout des
        # espacements), mais l'ORDRE logique par groupe fonctionnel
        # introduit par la réorganisation précédente est conservé (plus
        # lisible que l'ordre chronologique d'origine) :
        #   Exécution (Lancer, Arrêter) -> Sélection (Tout sélectionner,
        #   Tout désélectionner, Sélectionner les échecs, Sélectionner
        #   aléatoirement, Choisir par couleur) -> Sorties (Réinitialiser,
        #   Capturer tout) -> Copie de logs (Copier logs d'exécution,
        #   Copier sorties par profil).
        # Le regroupement reste lisible par la simple continuité de
        # lecture gauche->droite/haut->bas d'une grille (Exécution occupe
        # le début, etc.), sans dépenser de hauteur dédiée à le
        # matérialiser visuellement.
        #
        # CORRECTIF (retour utilisateur explicite : "je veux que tu range
        # les boutons sur lhorizontal, set non a la vertical ... sa vas
        # pouvoir sadapter en fontion de la taille, car le Qsplitter peu
        # modifier le widht") -- l'ancienne grille à 3 COLONNES FIXES,
        # remplie ligne par ligne (indice // 3, indice % 3), ne réagissait
        # jamais à une largeur de panneau différente : depuis le passage
        # de ce panneau en second enfant d'un QSplitter redimensionnable
        # (cf. TaskConfigScreen.splitter_notebook_clone, "on peu glisser
        # comme on veux, sa alonge ou retrecir lespace"), rétrécir le
        # splitter compressait les 3 colonnes au lieu de réorganiser les
        # boutons. Le remplissage reste LIGNE PAR LIGNE (horizontal,
        # demande explicite) mais le NOMBRE de colonnes est désormais
        # recalculé à chaque redimensionnement (cf. resizeEvent/
        # _reorganiser_grille_actions plus bas) à partir de la largeur
        # réelle disponible -- un panneau étroit affiche peu de colonnes
        # larges (donc plus de lignes), un panneau élargi en affiche
        # davantage (donc moins de lignes), toujours remplies de gauche à
        # droite avant de passer à la ligne suivante.
        self._grille_actions = QGridLayout()
        self._grille_actions.setSpacing(3)  # resserré (était 4) -- gain marginal mais chaque px compte ici
        self._boutons_actions_ordonnes = [
            self.bouton_lancer_clones,
            self.bouton_arreter_clones,
            self.bouton_tout_selectionner,
            self.bouton_tout_deselectionner,
            self.bouton_selectionner_echecs,
            self.bouton_selectionner_aleatoire,
            self.bouton_choisir_couleur_result_color,
            self.bouton_vider_sorties_clones,
            self.bouton_capturer_tout,
            self.bouton_copier_logs_execution,
            self.bouton_copier_logs_par_profil,
            self.bouton_forcer_sortie_clones,
            self.bouton_attribuer_workspace,
        ]
        # Largeur EXACTE d'un bouton (cf. _creer_bouton_icone.setFixedSize
        # (28, 28) ci-dessus) : sert de pas fixe au calcul du nombre de
        # colonnes dans _reorganiser_grille_actions, plus fiable qu'un
        # sizeHint() dont la valeur peut légèrement varier selon le style
        # Qt actif.
        self._largeur_bouton_action = 28
        self._nb_colonnes_grille_actions = -1  # force un premier agencement (cf. plus bas)
        # self.width() n'est pas encore fiable ici (widget pas encore
        # layouté par le QSplitter parent, cf. TaskConfigScreen -- valeur
        # par défaut Qt transitoire) : 227 reprend la largeur INITIALE
        # connue posée par TaskConfigScreen.setSizes pour ce panneau. Le
        # vrai resizeEvent prendra le relais avec la largeur réelle dès
        # le premier affichage/redimensionnement du panneau.
        self._reorganiser_grille_actions(227)
        layout.addLayout(self._grille_actions)

    # --- Rafraîchissement de la liste (poussé par TaskConfigScreen) ---

    def rafraichir_liste(
        self, profils: dict,
        sequence_en_cours: bool, profil_actif: Optional[str] = None,
        id_executant_par_profil: Optional[dict] = None,
        noms_par_id_executant: Optional[dict] = None,
        lot_deja_lance: bool = False,
        message_indisponible: str = "",
    ):
        """Point d'entrée UNIQUE de mise à jour visuelle -- appelé par
        TaskConfigScreen après chaque changement d'état (réception de
        profils_sautoniax_recu, changement de profil actif, changement
        de statut d'un profil, arrêt). `profils` : dict CLÉ COMPOSITE
        (id_executant::nom_profil, cf. REFONTE MULTI-SAUTONIAX plus bas)
        -> CloneProfilEtat -- SPEC_profils_environnements.md section 4.2
        point 3 : TOUS les profils reçus du sAutoniax apparaissent
        désormais ici, plus de filtrage du profil principal (cette
        notion n'existe plus).

        REFONTE MULTI-SAUTONIAX -- l'ancien paramètre nom_sautoniax_
        cible (un seul sAutoniax pour TOUT le panneau, affiché comme
        sous-titre "sAutoniax : X") est retiré : `profils` peut
        désormais mélanger des CloneProfilEtat venant de PLUSIEURS
        sAutoniax en même temps, donc "le" sAutoniax du panneau n'a
        plus de sens au niveau du panneau entier -- le sAutoniax
        d'origine de chaque profil est désormais affiché PAR LIGNE
        (colonne dédiée, cf. _reconstruire_table/_reconstruire_table_
        completement -- décision explicite utilisateur, "avec le nom du
        sAutoniax en colonne/tag par ligne"). label_sous_titre affiche à
        la place un simple décompte de sAutoniax distincts représentés.

        REFONTE MULTI-SAUTONIAX (correctif collision de noms, cf.
        docstring de _cle_profil_clone) : `profils` est désormais keyé
        par CLÉ COMPOSITE (id_executant::nom_profil), plus par nom_
        profil seul -- deux sAutoniax distincts ayant chacun un profil
        "iaX1" produisent maintenant deux entrées distinctes au lieu que
        la seconde écrase la première. `profil_actif` et les clés de
        `id_executant_par_profil` suivent le même format composite (cf.
        TaskConfigScreen._id_executant_par_profil_clone, reconstruit
        avec ce même format).

        `id_executant_par_profil` (clé composite -> id_executant) /
        `noms_par_id_executant` (id_executant -> nom lisible) :
        résolvent le TAG de sAutoniax à afficher par ligne (cf. TaskConfig
        Screen._id_executant_par_profil_clone et self._noms_executants_
        reseau). Utilisés en PRIORITÉ pour un profil dont profil_etat.
        id_executant_sautoniax est encore vide (profil jamais lancé --
        cf. docstring de CloneProfilEtat.id_executant_sautoniax, rempli
        seulement "au moment où ce profil est ajouté à la liste agrégée
        ... puis figé au lancement") : sans ce repli, un profil jamais
        encore lancé afficherait une colonne sAutoniax vide alors que son
        sAutoniax d'origine est déjà connu via la liste agrégée. Une fois
        profil_etat.id_executant_sautoniax figé (profil déjà lancé au
        moins une fois), CETTE valeur prime : elle reste stable pour la
        durée du lot même si le profil change ensuite de sAutoniax dans
        une liste rafraîchie entre-temps (cf. même docstring), alors que
        id_executant_par_profil, lui, reflète toujours le dernier état
        CONNU plutôt que celui réellement lancé. En pratique, avec la clé
        composite, ce repli n'est presque plus jamais sollicité (l'id_
        executant est déjà encodé DANS la clé elle-même) -- conservé tel
        quel pour le cas où profil_etat.id_executant_sautoniax et le
        préfixe de la clé divergeraient (ne devrait pas arriver, mais
        _resoudre_id_executant_profil reste défensif plutôt que de
        supposer cette cohérence).

        `profil_actif` : CLÉ COMPOSITE du profil actuellement sélectionné
        comme environnement d'exécution courant (ExecutionCloneEtat.
        profil_actif), utilisé UNIQUEMENT pour le marquage visuel de la
        ligne active (section 4.4) -- plus de bandeau (supprimé,
        section 2.1).

        `lot_deja_lance` (AJOUT, bouton "Copier les logs de cette
        exécution") : True dès que ExecutionCloneEtat.horodatage_
        lancement_lot n'est pas None pour ce Task -- active
        bouton_copier_logs_execution (cf. plus bas), qu'un lot soit
        encore en cours OU déjà terminé -- seul un Task JAMAIS lancé
        (aucune fenêtre temporelle connue) désactive ce bouton.

        `message_indisponible` (AJOUT -- SPEC_mode_clone_local.md section
        5 point 3) : message prioritaire affiché à la place du texte de
        statut habituel quand le panneau ne peut structurellement pas
        fonctionner (ex. mode local sans module 'websockets' installé,
        cf. TaskConfigScreen._rafraichir_panneau_clone_si_ouvert) --
        chaîne vide (défaut) = comportement inchangé, le texte habituel
        ("N profil(s) coché(s)..." ou "Aucun profil disponible...") est
        utilisé normalement. Le panneau reste visible et les boutons
        gardent leur état normal (pas de désactivation forcée ici -- la
        liste étant de toute façon vide dans ce cas, nb_coches==0 suffit
        déjà à désactiver "Lancer les clones" naturellement)."""
        self._profils = profils
        self._sequence_en_cours = sequence_en_cours
        self._profil_actif = profil_actif
        self._id_executant_par_profil = id_executant_par_profil or {}
        self._noms_par_id_executant = noms_par_id_executant or {}
        ids_executants_representes = {
            self._resoudre_id_executant_profil(cle_profil, p)
            for cle_profil, p in profils.items()
        }
        ids_executants_representes.discard("")
        if not ids_executants_representes:
            self.label_sous_titre.setText("")
        elif len(ids_executants_representes) == 1:
            (seul_id,) = ids_executants_representes
            self.label_sous_titre.setText(f"sAutoniax : {self._nom_executant(seul_id)}")
        else:
            self.label_sous_titre.setText(f"{len(ids_executants_representes)} sAutoniax représentés")
        nb_coches = sum(1 for p in profils.values() if p.coche)
        if message_indisponible:
            self.label_statut.setText(message_indisponible)
        elif not profils:
            self.label_statut.setText("Aucun profil disponible sur les sAutoniax connectés.")
        else:
            self.label_statut.setText(f"{nb_coches} profil(s) coché(s) sur {len(profils)} disponible(s).")
        self._reconstruire_table()
        self.bouton_lancer_clones.setEnabled(nb_coches > 0 and not sequence_en_cours)
        self.bouton_arreter_clones.setVisible(sequence_en_cours)
        # CORRECTIF (même correctif que _sur_demande_capturer_tout, cf. sa
        # docstring) -- ce compte ignorait `coche`, donc le bouton restait
        # actif même si aucun profil COCHÉ n'avait d'instance active
        # (seul un profil non coché en avait une) : un clic n'aurait alors
        # fait qu'afficher le message d'erreur "Aucune instance clone
        # cochée et active à capturer." au lieu de désactiver le bouton
        # en amont, comme bouton_lancer_clones le fait déjà pour nb_coches.
        nb_coches_avec_instance = sum(1 for p in profils.values() if p.instance_id and p.coche)
        self.bouton_capturer_tout.setEnabled(nb_coches_avec_instance > 0)
        nb_avec_resultats = sum(1 for p in profils.values() if p.cellules_resultats)
        # ÉLARGI (bouton_vider_sorties_clones réinitialise désormais AUSSI
        # statut/badge de couleur/horodatages, pas seulement cellules_
        # resultats, cf. docstring de _sur_demande_vider_sorties_clones)
        # -- le bouton doit donc rester actif dès qu'AU MOINS un profil a
        # quelque chose à réinitialiser, même un profil qui serait passé
        # en "erreur" sans avoir produit le moindre cellules_resultats
        # (ex. échec avant la première cellule) : nb_avec_resultats seul
        # aurait laissé le bouton désactivé dans ce cas précis, alors
        # qu'un badge/statut non neutre resterait affiché sans aucun
        # moyen de le réinitialiser depuis ce bouton.
        nb_a_reinitialiser = sum(
            1 for p in profils.values()
            if p.cellules_resultats or p.statut != "inactif" or p.result_color != COULEUR_RESULT_COLOR_DEFAUT
        )
        self.bouton_vider_sorties_clones.setEnabled(nb_a_reinitialiser > 0 and not sequence_en_cours)
        # AJOUT (bouton "Copier les sorties par profil", cf. sa docstring
        # de création ci-dessus) -- délibérément PAS conditionné par
        # `sequence_en_cours` (contrairement à bouton_vider_sorties_
        # clones juste au-dessus), même raisonnement que bouton_copier_
        # logs_execution un peu plus bas : copier un instantané reste
        # utile pendant qu'une séquence tourne encore.
        # PATCH : un clone qui tourne a déjà une sortie en direct copiable, même sans cellule terminée.
        nb_en_direct = sum(1 for p in profils.values() if getattr(p, "moteur_courant", None) is not None)
        self.bouton_copier_logs_par_profil.setEnabled(nb_avec_resultats > 0 or nb_en_direct > 0)
        self.bouton_forcer_sortie_clones.setEnabled(any(
            p.coche and p.instance_id and (p.statut == "en_cours" or getattr(p, "moteur_courant", None) is not None)
            for p in profils.values()
        ))
        # AJOUT (bouton "Copier les logs de cette exécution", cf. sa
        # docstring de paramètre ci-dessus) -- délibérément PAS
        # conditionné par `sequence_en_cours` (contrairement à
        # bouton_vider_sorties_clones juste au-dessus) : la copie doit
        # rester possible pendant ET après l'exécution (demande explicite
        # utilisateur), donc seule l'existence d'une fenêtre connue
        # compte ici.
        self.bouton_copier_logs_execution.setEnabled(lot_deja_lance)

    def _sur_focus_navigateur_local_change(self, nom_profil_focus: str):
        """AJOUT (demande explicite utilisateur : "quand je clic sur sont
        naviatuer, quand sa prend le focus, sont profils dans le panneau
        de clone est en surbrillance") -- slot connecté par MainWindow à
        ProfilsInstancesScreen.focus_navigateur_local_change (jamais
        d'appel direct entre écrans-frères, même patron que les autres
        signaux relayés là-bas).

        `nom_profil_focus` est un nom NU (ex. "iaX1"), pas une clé
        composite -- le Dashboard ne connaît que ses propres profils
        locaux, qui vivent TOUJOURS sous ID_EXECUTANT_LOCAL dans ce
        panneau (cf. _rafraichir_agregat_profils_clone_local). "" signifie
        "aucun navigateur connu n'a le focus" (cf. docstring du signal
        côté ProfilsInstancesScreen) -> self._profil_focus_os devient
        None dans ce cas plutôt qu'une clé composite vide.

        Ne déclenche une reconstruction QUE si la clé résultante diffère
        de la précédente (même précaution que self._profil_actif ailleurs
        dans ce panneau) -- un simple aller-retour de focus hors d'AutoniaX
        puis retour sur le même profil ne doit pas re-teindre la table
        pour rien."""
        nouvelle_cle_focus = (
            _cle_profil_clone(ID_EXECUTANT_LOCAL, nom_profil_focus)
            if nom_profil_focus
            else None
        )
        if nouvelle_cle_focus == self._profil_focus_os:
            return
        # LOG DIAGNOSTIC (suite du [FOCUS-NAVIGATEUR] émis côté Dashboard) :
        # si ce log N'APPARAÎT JAMAIS alors que le Dashboard log bien une
        # émission -> le relais MainWindow n'est pas câblé (vérifier la
        # connexion focus_navigateur_local_change.connect(...) dans
        # MainWindow._construire_ecrans, ou son ordre de construction).
        # Si ce log apparaît mais qu'AUCUNE surbrillance n'est visible ->
        # comparer `nouvelle_cle_focus` ci-dessous avec les clés réellement
        # présentes dans self._profils (cle_profil == cette valeur exacte,
        # cf. _cle_profil_clone) : le nom de profil transmis ne correspond
        # peut-être à aucune ligne actuellement affichée dans CE panneau
        # (mauvais Task ouvert, ou profil pas encore coché/visible ici).
        log_ouverture_task.info(
            f"[FOCUS-NAVIGATEUR] PanneauExecutionClone reçoit "
            f"nom_profil_focus={nom_profil_focus!r} -> "
            f"nouvelle_cle_focus={nouvelle_cle_focus!r} "
            f"(ancienne={self._profil_focus_os!r}, "
            f"cles_profils_connues={list(self._profils.keys())!r})"
        )
        self._profil_focus_os = nouvelle_cle_focus
        if self._profils:
            self._reconstruire_table_completement()

    def _resoudre_id_executant_profil(self, cle_profil: str, profil_etat: "CloneProfilEtat") -> str:
        """Résout l'id_executant à afficher/utiliser pour CE profil --
        cf. docstring de rafraichir_liste (paramètres id_executant_par_
        profil/noms_par_id_executant) pour le raisonnement complet du
        repli : profil_etat.id_executant_sautoniax (figé, prioritaire)
        sinon self._id_executant_par_profil (dernier connu, profil pas
        encore lancé) sinon l'id_executant encodé DANS la clé composite
        elle-même (cf. _cle_profil_clone -- toujours présent et fiable,
        c'est la source de vérité depuis la REFONTE MULTI-SAUTONIAX)."""
        return (
            profil_etat.id_executant_sautoniax
            or self._id_executant_par_profil.get(cle_profil, "")
            or _id_executant_depuis_cle_profil_clone(cle_profil)
        )

    def ordre_affichage_cles_profils(self) -> list:
        """AJOUT (SPEC_workspace_attribution.md, section 6 : "profils dans
        l'ordre d'affichage du panneau") -- expose l'ordre de tri déjà
        utilisé pour peupler table_profils (même clé à deux niveaux, cf.
        _cle_tri_ligne_profil dans _reconstruire_table_completement :
        sAutoniax d'abord numériquement, puis nom de profil numériquement)
        SANS dupliquer cette logique de tri côté TaskConfigScreen, qui
        n'a par ailleurs aucun accès à self._resoudre_id_executant_profil/
        self._id_executant_par_profil (privés à ce panneau, cf. docstring
        de classe -- "il émet des signaux, TaskConfigScreen résout").
        Retourne la liste des cle_profil (clés composites), triée, prête
        à être passée telle quelle à repartir_taches_workspace."""
        def _cle_tri(paire):
            cle_profil, etat_profil = paire
            id_executant = self._resoudre_id_executant_profil(cle_profil, etat_profil)
            return (
                _cle_tri_numerique_generique(id_executant),
                _cle_tri_numerique_profil(cle_profil),
            )
        return [
            cle_profil
            for cle_profil, _ in sorted(self._profils.items(), key=_cle_tri)
        ]

    def _nom_executant(self, id_executant: str) -> str:
        """Résout id_executant -> nom lisible via self._noms_par_id_
        executant (transmis à chaque rafraichir_liste, cf. sa docstring)
        -- id_executant brut en repli si le nom n'est pas (encore) connu,
        plutôt qu'une chaîne vide qui laisserait la ligne sans indice.

        CORRECTIF (retour utilisateur : "je veux que tu abrege sAutoniac
        en sAuto1, sAuto2") -- le nom résolu ("sAutoniax-1", format
        transmis par InstancesConnecteesScreen, cf. capture_001.png) est
        abrégé en "sAuto1" juste avant retour : préfixe "sAutoniax-"
        (ou "sAutoniax" sans tiret, au cas où) remplacé par "sAuto",
        SUFFIXE (numéro ou tout autre identifiant) conservé tel quel --
        seule cette colonne resserrée (42->48px, cf. sa construction) en
        bénéficie, l'id_executant RÉEL (clé technique, jamais affiché
        directement) n'est en rien modifié par cette méthode, purement
        cosmétique. Un nom qui ne suit pas ce motif exact (ex. id brut
        en repli ci-dessus si jamais résolu) est retourné inchangé --
        pas de troncature hasardeuse sur un format inattendu."""
        nom = self._noms_par_id_executant.get(id_executant, id_executant) if id_executant else ""
        return re.sub(r"(?i)^sAutoniax-?", "sAuto", nom) if nom else nom

    def _reconstruire_table(self):
        """Point d'entrée UNIQUE de synchronisation visuelle entre
        self._profils (état à afficher, poussé par rafraichir_liste) et
        table_profils (ce que l'utilisateur voit réellement à l'écran) --
        appelée à CHAQUE transition de statut d'UN SEUL profil parmi N
        pendant qu'une séquence clone tourne (cf. TaskConfigScreen.
        _rafraichir_apres_transition_clone), donc potentiellement
        plusieurs fois par seconde.

        REFONTE (retour utilisateur explicite : "je veux que tu refasses
        clairement la logique de mise à jour visuelle... extrêmement
        robuste, je ne veux plus d'erreur") suite au bug constaté : iaX1
        restait affiché "En cours" plusieurs secondes après que les logs
        BADGE-TRACE confirment noir sur blanc que profil_etat.statut est
        déjà passé à "succes".

        CAUSE RACINE (confirmée en lisant le code, cf. self._items dans
        __init__ pour le détail complet) : l'ancienne version de cette
        méthode faisait table_profils.clear() PUIS reconstruisait les N
        lignes EN ENTIER (texte + widget d'actions -- badge animé à son
        propre QTimer ~60fps tant qu'"en_cours", boutons à icônes
        qtawesome) à CHAQUE appel. Avec N profils qui se terminent dans
        une fenêtre de temps rapprochée -- le cas NORMAL d'un lancement
        "clones", qui démarre justement N séquences EN PARALLÈLE --
        chaque transition individuelle déclenchait sa propre
        reconstruction complète des N lignes, en rafale sur le thread Qt
        principal. Le texte correct d'un profil donné était donc bien
        écrit à temps, mais aussitôt recouvert par le travail GUI des
        N-1 AUTRES reconstructions complètes déclenchées à la suite par
        les transitions des autres profils -- d'où le décalage visuel
        observé (jamais un vrai blocage permanent : le badge global
        comptait déjà juste, cf. retour utilisateur "ça compte bien le
        nombre de succès mais ça ne met pas bien à jour le visuel").

        NOUVELLE LOGIQUE :
          - Si l'ENSEMBLE des noms de profils a changé depuis le dernier
            appel (ajout/retrait, première population, changement de
            sAutoniax ciblé) : délègue à _reconstruire_table_completement
            (reconstruction intégrale). Cas RARE -- ne se produit jamais
            pendant qu'une séquence tourne, seuls les STATUTS changent
            alors -- son coût O(N) n'a donc pas besoin d'être évité.
          - Sinon (cas courant, y compris PENDANT une séquence de N
            profils en parallèle) : réécrit texte/couleur/fond de TOUTES
            les lignes (coût négligeable -- simples setText/setForeground
            sur des items déjà affichés, AUCUNE reconstruction de widget),
            et ne recrée le widget d'actions (colonne 3, coûteux) QUE
            pour la ou les lignes dont le statut a RÉELLEMENT changé
            depuis son dernier rendu (cf. self._dernier_statut_widget_
            actions). Coût par appel : O(N) écritures de texte bon
            marché, jamais plus qu'O(1 à quelques lignes) en
            reconstruction de widget -- jamais O(N) reconstructions
            complètes pour UNE SEULE transition, quel que soit N.

        AUTO-RÉPARATION : si self._items contient une référence vers un
        QTreeWidgetItem déjà détruit côté C++ (ne devrait jamais arriver
        en usage normal -- aucune autre méthode de cette classe ne
        retire/vide d'item de table_profils, cf. leur inventaire complet
        -- mais resterait possible si une évolution future de ce fichier
        ajoutait un tel appel ailleurs), le RuntimeError levé par Qt est
        intercepté et déclenche une reconstruction complète plutôt qu'un
        crash de tout le panneau."""
        # REFONTE MULTI-SAUTONIAX : self._profils/self._items sont
        # désormais keyés par CLÉ COMPOSITE (id_executant::nom_profil,
        # cf. _cle_profil_clone), pas par nom_profil seul -- la
        # comparaison d'ensembles ci-dessous continue de fonctionner
        # inchangée puisqu'elle ne se soucie que de l'égalité des clés,
        # quel que soit leur format.
        cles_voulues = set(self._profils.keys())
        cles_actuelles = set(self._items.keys())
        if cles_voulues != cles_actuelles:
            self._reconstruire_table_completement()
            return

        # Fond légèrement teinté sur toutes les colonnes de la ligne
        # active (cf. SPEC_profils_environnements.md section 4.4) ;
        # brosse_normale (Qt.NoBrush) retire cette teinte d'une ligne qui
        # ÉTAIT active et ne l'est plus -- nécessaire ici puisque les
        # items sont désormais RÉUTILISÉS d'un appel à l'autre (contraire-
        # ment à l'ancienne version, où un item jamais teinté sortait
        # déjà "propre" de sa construction).
        brosse_active = QBrush(QColor(Mocha.surface1))
        brosse_focus_os = QBrush(QColor(Mocha.surface2))
        brosse_normale = QBrush()
        for cle_profil, etat_profil in self._profils.items():
            item = self._items.get(cle_profil)
            if item is None:
                # Ne devrait jamais arriver : cles_voulues == cles_actuelles
                # vient d'être vérifié ci-dessus -- filet de sécurité si
                # self._items et self._profils se désynchronisent malgré
                # tout, plutôt qu'une KeyError qui planterait le panneau.
                self._reconstruire_table_completement()
                return
            try:
                est_actif = cle_profil == self._profil_actif
                est_focus_os = (not est_actif) and cle_profil == self._profil_focus_os
                nouvel_etat_coche = Qt.Checked if etat_profil.coche else Qt.Unchecked
                if item.checkState(0) != nouvel_etat_coche:
                    item.setCheckState(0, nouvel_etat_coche)
                # REFONTE MULTI-SAUTONIAX -- colonne 1, sAutoniax d'ORIGINE
                # de cette ligne précise, résolu via _resoudre_id_executant
                # _profil (repli profil_etat.id_executant_sautoniax figé
                # puis _id_executant_par_profil "dernier connu", cf. sa
                # docstring) puis _nom_executant (id -> nom lisible) :
                # chaque ligne peut désormais venir d'un sAutoniax
                # différent des autres, d'où cette colonne plutôt que
                # l'ancien sous-titre unique du panneau entier.
                # SPEC_lot_corrections_2026-09.md section 10 : mêmes
                # tooltips que _reconstruire_table_completement ci-dessous
                # (colonnes 0/1/3 resserrées, texte potentiellement
                # tronqué) -- posés ici aussi puisque ce chemin
                # incrémental réécrit ces mêmes colonnes à chaque appel
                # sans jamais repasser par la reconstruction complète.
                nom_profil_ligne = _nom_depuis_cle_profil_clone(cle_profil)
                item.setToolTip(0, nom_profil_ligne)
                nom_executant_ligne = self._nom_executant(
                    self._resoudre_id_executant_profil(cle_profil, etat_profil)
                )
                item.setText(1, nom_executant_ligne)
                item.setToolTip(1, nom_executant_ligne)
                # CORRECTIF (retour utilisateur, capture d'écran à
                # l'appui : pastille result_color affichée dans la
                # colonne "Actions" au lieu de "Statut", cf. SPEC_lot_
                # corrections_2026-09.md section 11 "à côté du message
                # Succès existant") : colonne 3 posée désormais via
                # setItemWidget (texte + pastille, cf. _construire_
                # widget_statut_profil) plutôt qu'un simple item.setText
                # -- item.setForeground/setText(3, ...) n'ont donc plus
                # d'effet visuel sur cette colonne et sont retirés ici.
                item.setText(4, self._texte_temps(etat_profil))
                if est_actif:
                    for colonne in range(5):
                        item.setBackground(colonne, brosse_active)
                elif est_focus_os:
                    for colonne in range(5):
                        item.setBackground(colonne, brosse_focus_os)
                else:
                    for colonne in range(5):
                        item.setBackground(colonne, brosse_normale)
                if self._dernier_statut_widget_actions.get(cle_profil) != etat_profil.statut:
                    self.table_profils.setItemWidget(
                        item, 2, self._construire_widget_actions_profil(cle_profil, etat_profil)
                    )
                    self._dernier_statut_widget_actions[cle_profil] = etat_profil.statut
                # Clé de cache DISTINCTE de _dernier_statut_widget_actions
                # ci-dessus : la colonne Statut doit aussi se reconstruire
                # si result_color change alors que etat_profil.statut
                # reste "succes" (ex. relancement d'un profil déjà en
                # "succes" -- rare mais possible si l'utilisateur relance
                # avant rafraîchissement complet), ou si le profil devient/
                # cesse d'être actif (couleur du texte concernée aussi).
                cle_cache_statut = (etat_profil.statut, etat_profil.result_color, est_actif)
                if self._dernier_cache_widget_statut.get(cle_profil) != cle_cache_statut:
                    self.table_profils.setItemWidget(
                        item, 3, self._construire_widget_statut_profil(cle_profil, etat_profil)
                    )
                    self._dernier_cache_widget_statut[cle_profil] = cle_cache_statut
            except RuntimeError:
                # AUTO-RÉPARATION -- cf. docstring ci-dessus.
                self._reconstruire_table_completement()
                return

        # AJOUT (spec B.2, colonne "Temps") -- (re)démarre le QTimer
        # d'affichage live si au moins un profil est "en_cours" après
        # cette synchronisation, l'arrête sinon (cf. sa docstring).
        self._synchroniser_timer_temps()

    def _reconstruire_table_completement(self):
        """Reconstruction INTÉGRALE de table_profils (table_profils.
        clear() + recréation des N lignes, widgets d'actions compris) --
        ANCIEN comportement de _reconstruire_table, conservé tel quel
        (même ordre de tri, mêmes couleurs, même widget d'actions par
        ligne) mais désormais réservé aux seuls cas où il est réellement
        nécessaire :
          - premier appel (self._items encore vide) ;
          - l'ensemble des noms de profils a changé depuis le dernier
            appel (ajout/retrait, changement de sAutoniax ciblé) ;
          - auto-réparation (cf. docstring de _reconstruire_table).

        Ces cas sont RARES -- en particulier, plus jamais déclenchés par
        une simple transition de statut pendant qu'une séquence de N
        profils tourne en parallèle (seule _reconstruire_table,
        incrémentale, est appelée dans ce cas, cf. sa docstring) -- le
        coût O(N) d'une reconstruction complète, widgets d'actions
        compris, n'a donc pas besoin d'être évité ici."""
        self.table_profils.clear()
        self._items = {}
        self._dernier_statut_widget_actions = {}
        self._dernier_cache_widget_statut = {}
        # SPEC_profils_environnements.md section 4.4 : fond légèrement
        # teinté sur toutes les colonnes de la ligne active (bordure non
        # supportée facilement par item sur QTreeWidget). En plus,
        # colonne Statut en VERT quand le profil est actif (pas de texte
        # additionnel -- juste la couleur, cf. retour utilisateur) --
        # priorité sur la couleur de statut d'exécution habituelle tant
        # que ce profil reste actif.
        # REFONTE MULTI-SAUTONIAX -- self._profils est keyé par CLÉ
        # COMPOSITE (id_executant::nom_profil, cf. _cle_profil_clone) :
        # le tri numérique (_cle_tri_numerique_profil) extrait déjà le
        # nom nu en interne avant d'appliquer son regex ^iaX(\d+)$ (cf.
        # sa docstring REFONTE MULTI-SAUTONIAX), donc trier directement
        # sur la clé composite ci-dessous reste correct. La colonne 0
        # affichée, elle, doit rester le nom NU (pas la clé technique) --
        # extrait explicitement via _nom_depuis_cle_profil_clone.
        #
        # CORRECTIF (retour utilisateur : "les profils soient rangés par
        # ordre croissant et non en désordre... trié croissant numérique
        # 1, 2... 10, pas 1, 10") -- _cle_tri_numerique_profil seule ne
        # trie QUE sur le nom nu ("iaX1", "iaX2"...), SANS tenir compte du
        # sAutoniax d'origine. Avec plusieurs sAutoniax représentés (cas
        # NORMAL du panneau depuis la REFONTE MULTI-SAUTONIAX), plusieurs
        # profils partagent le MÊME nom nu ("iaX1" sur sAutoniax-1,
        # sAutoniax-2, sAutoniax-3...) -- _cle_tri_numerique_profil leur
        # attribue alors une clé de tri IDENTIQUE. Le tri Python étant
        # STABLE, l'ordre relatif entre ces profils à égalité restait
        # celui d'arrivée dans self._profils.items() -- lui-même
        # dépendant de l'ordre RÉSEAU (asynchrone, non déterministe,
        # cf. sur_profils_sautoniax_clone_recus) des réponses des
        # différents sAutoniax. D'où l'ordre visuel qui semblait
        # "aléatoire" à chaque rafraîchissement : les groupes iaX1,
        # iaX2... étaient bien numériques et groupés, mais L'ORDRE DES
        # SAUTONIAX à l'intérieur de chaque groupe variait selon qui
        # avait répondu en premier ce cycle-là.
        #
        # Correctif : clé de tri à DEUX niveaux -- d'abord le sAutoniax
        # d'origine (résolu via _resoudre_id_executant_profil, même
        # source que la colonne affichée à l'écran, cf. juste plus bas
        # item.setText(1, ...)) comparé NUMÉRIQUEMENT via _cle_tri_
        # numerique_generique (déjà utilisée ailleurs dans ce fichier
        # pour ce même besoin -- "sAutoniax-2" < "sAutoniax-10"), PUIS
        # le nom du profil, numériquement, via _cle_tri_numerique_profil
        # comme avant. Résultat stable et déterministe, peu importe
        # l'ordre d'arrivée réseau : sAutoniax-1/iaX1, sAutoniax-1/iaX2,
        # ..., sAutoniax-2/iaX1, sAutoniax-2/iaX2, ...
        def _cle_tri_ligne_profil(paire):
            cle_profil, etat_profil = paire
            id_executant = self._resoudre_id_executant_profil(cle_profil, etat_profil)
            return (
                _cle_tri_numerique_generique(id_executant),
                _cle_tri_numerique_profil(cle_profil),
            )
        brosse_active = QBrush(QColor(Mocha.surface1))
        brosse_focus_os = QBrush(QColor(Mocha.surface2))
        for cle_profil, etat_profil in sorted(
            self._profils.items(), key=_cle_tri_ligne_profil
        ):
            nom_profil = _nom_depuis_cle_profil_clone(cle_profil)
            item = QTreeWidgetItem()
            item.setFlags(item.flags() | Qt.ItemIsUserCheckable)
            item.setCheckState(0, Qt.Checked if etat_profil.coche else Qt.Unchecked)
            item.setText(0, nom_profil)
            # REFONTE MULTI-SAUTONIAX (correctif collision de noms) --
            # item.text(0) n'affiche plus que le nom NU (ex. "iaX1"),
            # ambigu dès que plusieurs sAutoniax partagent ce nom. La
            # CLÉ COMPOSITE (id_executant::nom_profil, seule identité
            # fiable de cette ligne) est donc stockée à part sur l'item
            # lui-même (Qt.UserRole, colonne 0) -- tous les handlers ci-
            # dessous (_sur_item_changed, _sur_clic_ligne_profil, _sur_
            # clic_selectionner_echecs, _sur_tick_timer_temps) LA lisent
            # désormais au lieu de item.text(0), pour ne plus jamais
            # confondre deux profils homonymes de sAutoniax différents.
            item.setData(0, Qt.UserRole, cle_profil)
            # SPEC_lot_corrections_2026-09.md section 10 : colonnes 0
            # (Profil, 46px), 1 (sAutoniax, 42px) et 3 (Statut, 42px)
            # sont désormais assez étroites pour tronquer un texte plus
            # long (ellipsis natif de QTreeWidgetItem) -- tooltip complet
            # posé systématiquement pour rester lisible au survol, même
            # quand le texte ne dépasse pas en pratique (pas de condition
            # sur la longueur : plus simple et sans risque d'oubli si un
            # nom/libellé plus long apparaît plus tard).
            item.setToolTip(0, nom_profil)
            est_actif = cle_profil == self._profil_actif
            est_focus_os = (not est_actif) and cle_profil == self._profil_focus_os
            # REFONTE MULTI-SAUTONIAX -- colonne 1, cf. docstring du même
            # ajout dans _reconstruire_table ci-dessus.
            nom_executant_ligne = self._nom_executant(
                self._resoudre_id_executant_profil(cle_profil, etat_profil)
            )
            item.setText(1, nom_executant_ligne)
            item.setToolTip(1, nom_executant_ligne)
            # CORRECTIF (retour utilisateur, capture d'écran à l'appui :
            # pastille result_color affichée dans la colonne "Actions" au
            # lieu de "Statut", cf. SPEC_lot_corrections_2026-09.md
            # section 11 "à côté du message Succès existant") : colonne 3
            # posée désormais via setItemWidget (texte + pastille, cf.
            # _construire_widget_statut_profil), MÊME PATRON que le site
            # incrémental dans _reconstruire_table ci-dessus -- plus de
            # item.setText/setToolTip/setForeground(3, ...) ici, sans
            # effet visuel une fois le widget posé.
            item.setText(4, self._texte_temps(etat_profil))
            if est_actif:
                for colonne in range(5):
                    item.setBackground(colonne, brosse_active)
            elif est_focus_os:
                for colonne in range(5):
                    item.setBackground(colonne, brosse_focus_os)
            self.table_profils.addTopLevelItem(item)
            self.table_profils.setItemWidget(
                item, 2, self._construire_widget_actions_profil(cle_profil, etat_profil)
            )
            self.table_profils.setItemWidget(
                item, 3, self._construire_widget_statut_profil(cle_profil, etat_profil)
            )
            self._items[cle_profil] = item
            self._dernier_statut_widget_actions[cle_profil] = etat_profil.statut
            self._dernier_cache_widget_statut[cle_profil] = (
                etat_profil.statut, etat_profil.result_color, est_actif,
            )
        # BUGFIX -- connexion itemChanged posée une seule fois dans
        # __init__ (jamais ici) : la reposer à chaque reconstruction
        # empilerait les connexions sur le même widget persistant
        # table_profils, jamais recréé par .clear() ci-dessus.
        # RÉORDONNANCEMENT COLONNES (retour utilisateur : "Actions avant
        # Statut, Temps en dernier position") -- la colonne 2 contient
        # désormais le widget Actions (posé via setItemWidget juste au-
        # dessus, pas du texte), donc resizeColumnToContents n'a jamais eu
        # de sens dessus.
        #
        # SUPPRIMÉ (SPEC_lot_corrections_2026-09.md section 10) : l'appel
        # resizeColumnToContents(1, 3, 4) qui suivait ici -- ces 3
        # colonnes sont désormais en mode Fixed avec une largeur posée
        # explicitement une fois pour toutes dans __init__ (42/42/55px,
        # cf. ses commentaires) pour tenir dans le budget total de 227px.
        # resizeColumnToContents les aurait immédiatement ré-élargies au
        # contenu réel (ex. "sAutoniax-12" ou "En attente", plus larges
        # que 42px), annulant le resserrement voulu -- c'est exactement
        # pour ça que ces colonnes reçoivent désormais un tooltip
        # (cf. juste au-dessus) plutôt qu'une largeur qui s'adapte à leur
        # texte.
        #
        # CORRECTIF (retour utilisateur : "je veux que le noms des profls
        # soit affiher au complet parfois cest couper") -- contrairement
        # aux 3 colonnes ci-dessus, la colonne Profil (index 0) est restée
        # en mode Interactive (cf. __init__, setColumnWidth(0, 62)) mais
        # ce 62px de départ avait été calibré sur des noms courts "iaX1"
        # à "iaX20" (cf. commentaire CORRECTIF 2 dans __init__) -- un nom
        # "manuel" plus long (ex. profil renommé "beauty" et au-delà) se
        # fait tronquer par l'ellipsis natif dès qu'il dépasse ces 62px de
        # départ, tant que l'utilisateur n'a pas lui-même élargi la
        # colonne à la main. resizeColumnToContents(0) réajuste cette
        # largeur de départ au nom RÉELLEMENT le plus long affiché à
        # chaque reconstruction (donc après tout renommage/rafraîchissement
        # aussi, pas seulement au premier peuplement) -- max(..., 62)
        # évite seulement qu'une table vide ou aux noms très courts ne
        # revienne à une colonne ridiculement étroite. Reste Interactive
        # ensuite : l'utilisateur peut toujours la redimensionner à la
        # main par-dessus cet ajustement automatique, et le tooltip posé
        # plus haut (item.setToolTip(0, ...)) reste un filet de sécurité
        # si jamais un nom dépasse même la largeur du panneau.
        largeur_contenu = self.table_profils.sizeHintForColumn(0)
        self.table_profils.setColumnWidth(0, max(largeur_contenu, 62))
        # AJOUT (spec B.2, colonne "Temps") -- (re)démarre le QTimer
        # d'affichage live si au moins un profil est "en_cours" après
        # cette reconstruction, l'arrête sinon (cf. sa docstring).
        self._synchroniser_timer_temps()

    @staticmethod
    def _libelle_statut(statut: str) -> str:
        # SUPPRIMÉ (SPEC_lot_corrections_2026-09.md section 2) : entrée
        # "deconnecte" -- ce statut n'existe plus, un profil dont le
        # sAutoniax disparaît est retiré directement de la liste (cf.
        # _invalider_executions_clone_disparues côté TaskConfigScreen).
        return {
            "inactif": "Inactif", "en_attente": "En attente", "en_cours": "En cours",
            "succes": "Succès", "erreur": "Erreur", "arrete": "Arrêté",
        }.get(statut, statut)

    @staticmethod
    def _couleur_statut(statut: str) -> QColor:
        # BUGFIX : Mocha.* sont des chaînes hex ("#..."), pas des QColor
        # (cf. class Mocha) -- setForeground() exige un QBrush/QColor,
        # pas un str (TypeError sinon). Enveloppe explicitement dans
        # QColor(...) pour respecter l'annotation de retour de cette
        # fonction et son usage réel (item.setForeground ci-dessous,
        # ET badge.definir_statut(couleur.name(), ...) juste plus bas
        # dans _construire_widget_actions_profil, qui suppose lui aussi
        # un vrai QColor pour appeler .name() dessus).
        # SUPPRIMÉ (SPEC_lot_corrections_2026-09.md section 2) : entrée
        # "deconnecte" -- ce statut n'existe plus (cf. _libelle_statut
        # ci-dessus et _invalider_executions_clone_disparues).
        couleur_hex = {
            "inactif": Mocha.subtext0, "en_attente": Mocha.subtext0, "en_cours": Mocha.blue,
            "succes": Mocha.green, "erreur": Mocha.red, "arrete": Mocha.peach,
        }.get(statut, Mocha.subtext0)
        return QColor(couleur_hex)

    @staticmethod
    def _formater_duree(secondes: float) -> str:
        """AJOUT (spec B.2, colonne "Temps") -- format "Xs" en dessous de
        60s, "Xm Ys" au-delà (arrondi à la seconde -- une horloge de
        chrono n'a pas besoin de plus de précision à l'affichage, même si
        les horodatages stockés sont eux des float time.time() complets).
        secondes négatif (horloge locale légèrement en retard sur celle
        du sAutoniax, cf. repli documenté sur CloneProfilEtat) est
        ramené à 0 plutôt que d'afficher un temps négatif absurde."""
        secondes = max(0, int(secondes))
        if secondes < 60:
            return f"{secondes}s"
        minutes, reste = divmod(secondes, 60)
        return f"{minutes}m {reste}s"

    @classmethod
    def _texte_temps(cls, etat_profil: "CloneProfilEtat") -> str:
        """AJOUT (spec B.2, colonne "Temps") -- calcule le texte à
        afficher dans la colonne "Temps" pour un profil donné, à partir
        de CloneProfilEtat.horodatage_debut/horodatage_fin :
        - "en_cours" (horodatage_debut posé, horodatage_fin encore None) :
          LIVE, time.time() - horodatage_debut -- rappelé par le QTimer
          (cf. _synchroniser_timer_temps/_sur_tick_timer_temps) à chaque
          tick tant que ce statut tient.
        - terminé (succes/erreur/arrete, horodatage_fin posé) : FIGÉ sur
          horodatage_fin - horodatage_debut, ne bouge plus une fois écrit.
        - jamais lancé, ou horodatage_debut absent pour toute autre
          raison (ancien profil jamais exécuté depuis l'ajout de ce
          champ) : chaîne vide, pas de "0s" trompeur."""
        if etat_profil.horodatage_debut is None:
            return ""
        if etat_profil.horodatage_fin is not None:
            return cls._formater_duree(etat_profil.horodatage_fin - etat_profil.horodatage_debut)
        if etat_profil.statut == "en_cours":
            return cls._formater_duree(time.time() - etat_profil.horodatage_debut)
        # Cas résiduel (ex. "en_attente" avec un horodatage_debut hérité
        # d'une exécution précédente non encore réinitialisé -- ne
        # devrait plus se produire depuis le reset explicite dans
        # _sur_demande_lancer_clones, mais reste défensif) : rien
        # d'affichable de fiable, préférer vide à un chiffre trompeur.
        return ""

    def _synchroniser_timer_temps(self):
        """AJOUT (spec B.2, colonne "Temps") -- démarre self._timer_temps
        si au moins un profil connu est actuellement "en_cours" (donc au
        moins une colonne Temps a besoin d'un rafraîchissement LIVE),
        l'arrête sinon. Appelée à chaque reconstruction complète de la
        table (_reconstruire_table, donc à chaque rafraichir_liste --
        cf. TaskConfigScreen._rafraichir_panneau_clone_si_ouvert, elle-
        même appelée à chaque transition de statut via _rafraichir_
        apres_transition_clone) : le timer démarre donc dès qu'un profil
        passe "en_cours" et s'arrête dès qu'il n'en reste plus aucun,
        sans jamais tourner à vide entre deux séquences."""
        if any(p.statut == "en_cours" for p in self._profils.values()):
            if not self._timer_temps.isActive():
                self._timer_temps.start()
        else:
            self._timer_temps.stop()

    def _sur_tick_timer_temps(self):
        """AJOUT (spec B.2, colonne "Temps") -- réécrit UNIQUEMENT la
        colonne Temps (colonne 4, cf. RÉORDONNANCEMENT COLONNES dans
        __init__) de chaque ligne "en_cours", sans reconstruire la table
        (contrairement à _reconstruire_table) : ni le fond actif, ni la
        couleur de statut, ni le widget d'actions ne changent au fil des
        ticks, seul le chiffre affiché doit bouger. Un profil déjà
        terminé (succes/erreur/arrete) est figé (cf. _texte_temps) --
        inutile de le réécrire à chaque tick, mais inoffensif de le
        faire (même valeur) ; on se limite quand même strictement aux
        lignes "en_cours" pour éviter tout travail superflu sur une
        table qui peut compter plusieurs dizaines de profils."""
        for i in range(self.table_profils.topLevelItemCount()):
            item = self.table_profils.topLevelItem(i)
            # REFONTE MULTI-SAUTONIAX -- cf. docstring du item.setData
            # dans _reconstruire_table_completement : item.text(0) est
            # le nom NU (ambigu en cas d'homonymie entre sAutoniax), la
            # clé composite fiable est stockée à part.
            etat_profil = self._profils.get(item.data(0, Qt.UserRole))
            if etat_profil is not None and etat_profil.statut == "en_cours":
                # CORRECTIF (BUG RAPPORTÉ -- "le statut et le temps se
                # permutent quand le premier succès arrive avant que les
                # données de temps reviennent dans sa colonne") : ce tick
                # écrivait le texte du CHRONO dans la colonne Statut (cf.
                # _reconstruire_table -- item.setText(..., _libelle_
                # statut(...))) au lieu de la colonne Temps (cf. la ligne
                # juste en dessous dans _reconstruire_table --
                # item.setText(..., _texte_temps(...))). Chaque tick du
                # timer (déclenché en continu tant qu'au moins un profil
                # est "en_cours", cf. _synchroniser_timer_temps)
                # écrasait donc le libellé de statut d'une ligne encore
                # active avec sa durée écoulée ("12s" affiché là où
                # "En cours" devrait rester) -- visible dès qu'une AUTRE
                # ligne du même lot passait "succès" pendant qu'au moins
                # une ligne restait "en_cours" : _reconstruire_table
                # remettait la colonne Statut en place pour un instant,
                # puis le tick suivant du timer (toujours actif tant
                # qu'une ligne tourne encore) la re-corrompait aussitôt.
                # RÉORDONNANCEMENT COLONNES (retour utilisateur : "Actions
                # avant Statut, Temps en dernier position") -- Temps est
                # désormais la colonne 4 (Statut est passée en 3, Actions
                # en 2 ; cf. setHeaderLabels dans __init__).
                item.setText(4, self._texte_temps(etat_profil))

    def _reorganiser_grille_actions(self, largeur_disponible: int):
        """Recalcule le nombre de colonnes de self._grille_actions à
        partir de `largeur_disponible` (largeur actuelle du panneau,
        cf. resizeEvent) et replace tous les boutons de self._boutons_
        actions_ordonnes LIGNE PAR LIGNE (horizontalement, demande
        explicite utilisateur) -- seul le nombre de colonnes s'adapte,
        cf. docstring du bloc de construction dans __init__ pour le
        contexte complet de ce correctif.

        Ne fait rien si le nombre de colonnes obtenu est inchangé depuis
        le dernier appel (self._nb_colonnes_grille_actions) : resizeEvent
        peut être émis très fréquemment pendant un glisser de splitter,
        retirer/replacer 11 QToolButton à chaque pixel de mouvement serait
        un travail inutile tant que la largeur ne fait pas franchir un
        seuil de colonne entière.
        """
        # Au moins 1 colonne même sur un panneau extrêmement rétréci --
        # une grille à 0 colonne masquerait silencieusement tous les
        # boutons (division par zéro plus bas, en plus). Le spacing (3px,
        # cf. self._grille_actions.setSpacing plus haut) compte pour
        # (nb_colonnes - 1) fois dans la largeur réellement occupée :
        # largeur_disponible = nb_colonnes * largeur_bouton + (nb_colonnes
        # - 1) * spacing, résolu ici pour nb_colonnes -- sans ce +spacing
        # au numérateur, une division entière brute surestimerait
        # légèrement le nombre de colonnes qui tiennent réellement (ex.
        # 8 colonnes de 28px avec 7 espacements de 3px occupent 245px,
        # pas 224px).
        pas_colonne = self._largeur_bouton_action + self._grille_actions.spacing()
        nb_colonnes = max(1, (largeur_disponible + self._grille_actions.spacing()) // pas_colonne)
        nb_colonnes = min(nb_colonnes, len(self._boutons_actions_ordonnes))
        if nb_colonnes == self._nb_colonnes_grille_actions:
            return
        self._nb_colonnes_grille_actions = nb_colonnes
        for bouton in self._boutons_actions_ordonnes:
            self._grille_actions.removeWidget(bouton)
        # Ligne par ligne (indice // nb_colonnes, indice % nb_colonnes) --
        # remplit toute une ligne de gauche à droite avant de passer à la
        # suivante (horizontal, demande explicite utilisateur), seul le
        # NOMBRE de colonnes change désormais dynamiquement selon la
        # largeur disponible -- contrairement à l'ancien indice // 3,
        # indice % 3 qui figeait ce nombre à 3 quelle que soit la largeur
        # réelle du panneau.
        for indice, bouton in enumerate(self._boutons_actions_ordonnes):
            self._grille_actions.addWidget(bouton, indice // nb_colonnes, indice % nb_colonnes)
        for colonne in range(nb_colonnes):
            self._grille_actions.setColumnStretch(colonne, 1)

    def resizeEvent(self, event):
        """Redéclenche l'agencement de la grille d'actions à chaque
        redimensionnement de ce panneau -- notamment le glisser de la
        poignée de TaskConfigScreen.splitter_notebook_clone (cf. son
        commentaire d'insertion : "on peu glisser comme on veux, sa
        alonge ou retrecir lespace"), seule source réaliste de
        changement de largeur pour ce panneau en usage normal."""
        super().resizeEvent(event)
        self._reorganiser_grille_actions(event.size().width())

    def showEvent(self, event):
        """FILET DE SÉCURITÉ (retour utilisateur : badge/chrono figé
        "En cours" longtemps après la vraie fin, correction "tout d'un
        coup" spontanée bien plus tard) -- complète le correctif de
        TaskConfigScreen._rafraichir_panneau_clone_si_ouvert (qui ne
        saute plus l'appel à rafraichir_liste() quand ce panneau est
        caché, cf. sa docstring pour la cause racine complète).

        Cette méthode reste nécessaire MALGRÉ ce correctif : elle ne
        couvre que le cas où ce panneau (self._profils/table_profils)
        aurait malgré tout raté une transition -- par exemple si un
        futur appelant de rafraichir_liste ailleurs dans ce fichier
        réintroduit une garde de visibilité similaire, ou si un
        événement Qt (redimensionnement, changement d'onglet parent)
        rend ce widget temporairement invisible sans passer par le
        chemin normal. self._profils est LA MÊME référence que
        etat.profils (cf. rafraichir_liste : self._profils = profils,
        jamais une copie) -- donc dès que ce panneau redevient visible,
        _reconstruire_table() relit forcément la donnée déjà à jour et
        corrige immédiatement statut/temps/timer pour toutes les
        lignes, sans attendre un hasard de rafraîchissement externe.
        Coût négligeable : _reconstruire_table est bon marché (cf. sa
        docstring), appelée une seule fois par passage visible."""
        super().showEvent(event)
        if self._profils:
            self._reconstruire_table()

    def _sur_item_changed(self, item: QTreeWidgetItem, colonne: int):
        if colonne != 0:
            return
        # REFONTE MULTI-SAUTONIAX -- clé composite fiable (Qt.UserRole),
        # pas le nom nu affiché (item.text(0)), cf. docstring du
        # item.setData dans _reconstruire_table_completement.
        cle_profil = item.data(0, Qt.UserRole)
        etat_profil = self._profils.get(cle_profil)
        if etat_profil is None:
            return
        etat_profil.coche = item.checkState(0) == Qt.Checked
        nb_coches = sum(1 for p in self._profils.values() if p.coche)
        self.bouton_lancer_clones.setEnabled(nb_coches > 0 and not self._sequence_en_cours)
        # BUGFIX (retour utilisateur : "le bouton de capture automatique
        # ne sactive pas apres la selection aleatoire, je suis obliger
        # de cliquer manuellement sur une case avant que ca sactive") --
        # bouton_capturer_tout n'était recalculé que dans rafraichir_liste
        # (cf. son commentaire "actif seulement si au moins un clone a un
        # instance_id connu"), jamais ici alors que sa condition dépend
        # aussi de `coche`. Un clic manuel semblait "l'activer" par pure
        # coïncidence temporelle avec un rafraîchissement réseau externe
        # arrivant peu après -- la sélection aléatoire (setCheckState en
        # boucle, cf. _sur_clic_selectionner_aleatoire) déclenche bien ce
        # handler pour chaque ligne mais ne touchait jamais ce bouton,
        # d'où le blocage observé jusqu'au prochain rafraîchissement.
        # Même condition EXACTE que rafraichir_liste, recalculée ici en
        # plus pour que chaque coche/décoche individuelle la tienne à jour
        # immédiatement, sans dépendre d'un rafraîchissement externe.
        nb_coches_avec_instance = sum(1 for p in self._profils.values() if p.instance_id and p.coche)
        self.bouton_capturer_tout.setEnabled(nb_coches_avec_instance > 0)
        self.label_statut.setText(f"{nb_coches} profil(s) coché(s) sur {len(self._profils)} disponible(s).")

    def _sur_clic_tout_selectionner(self):
        """Coche la case de TOUTES les lignes -- déclenche itemChanged
        pour chacune (cf. _sur_item_changed, déjà connecté sur
        table_profils dans _reconstruire_table), qui se charge lui-même
        de synchroniser CloneProfilEtat.coche et le label de compte."""
        for i in range(self.table_profils.topLevelItemCount()):
            self.table_profils.topLevelItem(i).setCheckState(0, Qt.Checked)

    def _sur_clic_tout_deselectionner(self):
        """Symétrique de _sur_clic_tout_selectionner -- décoche tout."""
        for i in range(self.table_profils.topLevelItemCount()):
            self.table_profils.topLevelItem(i).setCheckState(0, Qt.Unchecked)

    def _sur_clic_selectionner_echecs(self):
        """Coche UNIQUEMENT les profils au statut "erreur" (lu depuis
        CloneProfilEtat.statut, pas depuis une colonne affichée -- reste
        donc correct quel que soit l'ordre des colonnes du tableau),
        décoche les autres -- pratique pour relancer en masse juste les
        échecs (cf. bouton_lancer_clones, qui lance tous les profils
        cochés) sans avoir à cocher chaque ligne en erreur à la main."""
        for i in range(self.table_profils.topLevelItemCount()):
            item = self.table_profils.topLevelItem(i)
            # REFONTE MULTI-SAUTONIAX -- clé composite fiable (Qt.UserRole),
            # cf. docstring du item.setData dans _reconstruire_table_
            # completement.
            etat_profil = self._profils.get(item.data(0, Qt.UserRole))
            en_echec = etat_profil is not None and etat_profil.statut == "erreur"
            item.setCheckState(0, Qt.Checked if en_echec else Qt.Unchecked)

    def _afficher_menu_couleurs_result_color(self, bouton: QToolButton, position):
        """AJOUT (SPEC_lot_corrections_2026-09.md section 12) : clic droit
        sur bouton_tout_selectionner OU bouton_tout_deselectionner (les
        deux partagent ce même handler, cf. leurs deux connect() dans
        __init__ -- décision section 12 : "un clic droit sur le bouton
        'Tout sélectionner' OU 'Tout désélectionner'", comportement
        identique quel que soit celui cliqué).

        Liste DYNAMIQUEMENT les result_color (section 11) réellement
        observées parmi les profils ACTUELLEMENT affichés dans ce panneau
        -- pas une liste fixe de couleurs possibles (cf. décision
        section 12) -- en lisant CloneProfilEtat.result_color de chaque
        entrée de self._profils, jamais une colonne affichée. "#FFFFFF"
        (CHANGEMENT hex, cf. CloneProfilEtat.result_color) est exclu de
        cette liste : c'est la valeur neutre par défaut (jamais
        réassignée par le code utilisateur, cf. section 11), la retenir
        ici produirait une entrée de menu qui sélectionnerait indistinc-
        tement tout profil n'ayant jamais touché à result_color -- sans
        rapport avec l'intention de ce menu (choisir une couleur MÉTIER
        parmi celles que l'utilisateur a lui-même posées dans son code).
        Un profil dont le lot n'est pas encore allé à son terme (statut
        différent de "succes") n'a par construction aucune result_color
        fiable (cf. _callback_termine, qui n'écrit ce champ que sur
        succès final) -- il garde donc la valeur par défaut "#FFFFFF" et
        est proprement exclu du regroupement par la même règle.

        Indépendant du système de couleur de STATUT TECHNIQUE
        (_couleur_statut : gris/bleu/vert/rouge/pêche/arrêté, cf. décision
        section 12) -- ce menu ne lit jamais ce champ-là.

        Menu vide (aucun profil avec une result_color non-"#FFFFFF" connue)
        -- comportement non tranché explicitement par la spec (cf.
        Récapitulatif des points encore ouverts, section 12) : choix fait
        ici de n'ouvrir AUCUN menu plutôt qu'un menu avec un seul item
        désactivé "(aucune couleur)" -- un clic droit qui ne produit rien
        de visible reste moins déroutant qu'un menu qui s'ouvre pour ne
        rien proposer de cliquable."""
        couleurs_observees = {}  # {hex_couleur: nb_profils}, ordre d'apparition préservé (dict Python 3.7+)
        for etat_profil in self._profils.values():
            couleur = etat_profil.result_color
            if couleur and couleur.upper() != COULEUR_RESULT_COLOR_DEFAUT.upper():
                couleurs_observees[couleur] = couleurs_observees.get(couleur, 0) + 1
        if not couleurs_observees:
            return
        menu = QMenu(self)
        for couleur, nb_profils in couleurs_observees.items():
            pixmap_pastille = QPixmap(12, 12)
            pixmap_pastille.fill(Qt.transparent)
            peintre = QPainter(pixmap_pastille)
            peintre.setRenderHint(QPainter.Antialiasing)
            peintre.setBrush(QColor(couleur))
            peintre.setPen(QColor(0, 0, 0, 60))
            peintre.drawEllipse(1, 1, 10, 10)
            peintre.end()
            libelle = f"{couleur} ({nb_profils})"
            action_couleur = menu.addAction(QIcon(pixmap_pastille), libelle)
            # CORRECTIF (retour utilisateur explicite : "verifie pour quoi
            # la logic de deselection des clone qui on une couleur de
            # succes precis ne fonctionne pas, sa ne deselectionne pas")
            # -- BUG CONFIRMÉ (pas un problème de câblage Qt, ni le
            # "menu vide" évoqué précédemment) : _sur_choix_couleur_
            # result_color COCHAIT SYSTÉMATIQUEMENT les profils qui
            # correspondent à la couleur choisie, peu importe si le menu
            # avait été ouvert depuis bouton_tout_selectionner OU bouton_
            # tout_deselectionner -- `bouton` n'était utilisé plus haut
            # QUE pour positionner le menu (bouton.mapToGlobal(position)),
            # jamais transmis à _sur_choix_couleur_result_color, qui
            # n'avait donc AUCUN moyen de savoir depuis quel bouton le
            # clic droit provenait. Désormais transmis explicitement :
            # bouton is self.bouton_tout_deselectionner => décoche les
            # profils qui correspondent à la couleur (laisse les autres
            # INCHANGÉS, symétrique de la sélection qui remplace
            # entièrement l'état -- cf. nouvelle docstring de la fonction
            # pour le détail des deux comportements).
            deselectionner = bouton is self.bouton_tout_deselectionner
            action_couleur.triggered.connect(
                lambda _checked=False, c=couleur, d=deselectionner: (
                    self._sur_choix_couleur_result_color(c, deselectionner=d)
                )
            )
        menu.exec(bouton.mapToGlobal(position))

    def _sur_choix_couleur_result_color(self, couleur: str, deselectionner: bool = False):
        """Applique une action de (dé)sélection en masse basée sur
        result_color -- deux comportements distincts selon `deselectionner` :

        - deselectionner=False (par défaut -- clic sur une entrée du menu
          ouvert depuis bouton_tout_selectionner, OU choix via le bouton
          picker en bas du panneau) : COCHE tous les profils dont
          result_color == `couleur`, DÉCOCHE tous les autres -- remplace
          entièrement la sélection actuelle, MÊME patron que _sur_clic_
          selectionner_echecs ci-dessus (cf. décision section 12 :
          "remplace la sélection actuelle", pas une union avec la
          sélection en cours).

        - deselectionner=True (clic sur une entrée du menu ouvert depuis
          bouton_tout_deselectionner) -- CORRECTIF (retour utilisateur
          explicite : "la logic de deselection des clone qui on une
          couleur de succes precis ne fonctionne pas, sa ne
          deselectionne pas") : DÉCOCHE uniquement les profils dont
          result_color == `couleur`, laisse tous les AUTRES profils
          INCHANGÉS (ni cochés ni décochés) -- comportement symétrique et
          conforme à l'intention du bouton "Tout désélectionner" (retirer
          spécifiquement cette couleur de la sélection en cours, pas la
          remplacer par une sélection inverse). Avant ce correctif, les
          deux chemins (bouton_tout_selectionner ET bouton_tout_
          deselectionner) appelaient cette fonction de façon identique,
          qui COCHAIT systématiquement les profils correspondants quel
          que soit le bouton d'origine -- `bouton` n'était jamais transmis
          jusqu'ici (seulement utilisé pour positionner le menu), donc
          cette fonction n'avait aucun moyen de distinguer les deux cas."""
        for i in range(self.table_profils.topLevelItemCount()):
            item = self.table_profils.topLevelItem(i)
            etat_profil = self._profils.get(item.data(0, Qt.UserRole))
            correspond = etat_profil is not None and etat_profil.result_color == couleur
            if deselectionner:
                if correspond:
                    item.setCheckState(0, Qt.Unchecked)
            else:
                item.setCheckState(0, Qt.Checked if correspond else Qt.Unchecked)

    def _sur_clic_choisir_couleur_result_color(self):
        """AJOUT (demande explicite utilisateur : "tu met le bouton de
        picker color directement en bas du panneau des clone") : ouvre le
        sélecteur de couleur NATIF via BoiteDialogueAutoniaX.couleur(...)
        (cf. section 6 -- façade unifiée, sélecteur natif inchangé), puis
        délègue à _sur_choix_couleur_result_color avec le hex choisi --
        même contrat que le clic sur une entrée du menu contextuel
        (section 12), mais ici la couleur n'est pas limitée à celles déjà
        observées parmi les profils affichés.

        Couleur initiale du dialogue : blanc (#FFFFFF, valeur neutre de
        CloneProfilEtat.result_color) -- aucune notion de "dernière
        couleur choisie" à mémoriser pour ce bouton, ce choix reste
        simple et prévisible d'un clic à l'autre.

        Annulation (couleur_choisie.isValid() == False, cf. contrat de
        BoiteDialogueAutoniaX.couleur/QColorDialog.getColor) : aucune
        action, la sélection actuelle des profils reste inchangée --
        symétrique du comportement "Annuler" de n'importe quel autre
        dialogue de ce fichier.

        AJOUT (retour utilisateur explicite : "des que je selctionne une
        couleur automatiquement sa doit copier le code hexadecimal dans
        le presse papier") : copie couleur_choisie.name() (hex minuscules,
        cf. QColor.name()) dans le presse-papier SYSTÈME juste après la
        sélection de la couleur (validée, pas annulée) -- MÊME pattern
        EXACT que _copier_sortie/bouton_copier_toutes_cellules/bouton_
        copier_racine ailleurs dans ce fichier (QGuiApplication.
        clipboard().setText(...) + icône/tooltip "Copié !" temporaires,
        restaurés après 1.2s via QTimer.singleShot) -- cohérent avec le
        seul mécanisme de copie déjà utilisé partout ailleurs dans l'app,
        pas un nouveau mécanisme ad hoc pour ce bouton précis."""
        couleur_choisie = BoiteDialogueAutoniaX.couleur(
            QColor("#FFFFFF"), self, "Sélectionner les profils par couleur"
        )
        if not couleur_choisie.isValid():
            return
        hex_choisi = couleur_choisie.name()
        QGuiApplication.clipboard().setText(hex_choisi)
        self.bouton_choisir_couleur_result_color.setIcon(qta.icon("mdi6.check", color=Mocha.green))
        self.bouton_choisir_couleur_result_color.setToolTip(f"Copié ! ({hex_choisi})")
        QTimer.singleShot(1200, self._restaurer_icone_choisir_couleur_result_color)
        self._sur_choix_couleur_result_color(hex_choisi)

    def _restaurer_icone_choisir_couleur_result_color(self):
        """Restaure l'icône/tooltip normaux du bouton picker après le
        délai de feedback "Copié !" -- cf. docstring de _sur_clic_
        choisir_couleur_result_color, même patron EXACT que _restaurer_
        icone_copier_sortie ailleurs dans ce fichier."""
        self.bouton_choisir_couleur_result_color.setIcon(qta.icon("mdi6.palette-outline", color=Mocha.text))
        self.bouton_choisir_couleur_result_color.setToolTip(
            "Sélectionner par couleur -- ouvre un sélecteur de couleur, copie le code "
            "hexadécimal choisi dans le presse-papier, et coche tous les profils dont le "
            "result_color (section 11) correspond exactement, décoche tous les autres."
        )

    def definir_reglages(self, reglages):
        """Appelée par TaskConfigScreen juste après construction (même
        esprit que rafraichir_liste : ce panneau ne va jamais chercher
        l'objet ReglagesApp lui-même, cf. docstring de tête de classe).
        Simple référence gardée pour lecture ultérieure du pourcentage
        au moment du clic (cf. _sur_clic_selectionner_aleatoire) -- ce
        panneau n'écrit jamais dans reglages, seul ParametresScreen le
        fait."""
        self._reglages = reglages

    def _sur_clic_selectionner_aleatoire(self):
        """AJOUT (SPEC_lot_corrections_2026-09.md section 5) : coche
        ALÉATOIREMENT un pourcentage des profils listés, décoche tous
        les autres -- MÊME patron que _sur_clic_selectionner_echecs ci-
        dessus pour l'application coché/décoché ligne par ligne. Le
        pourcentage est lu depuis ReglagesApp.pourcentage_selection_
        aleatoire_clone (configuré dans ParametresScreen), jamais
        redemandé ici (décision explicite utilisateur) -- repli sur 50
        si definir_reglages() n'a encore jamais été appelée (ne devrait
        pas arriver en usage normal, cf. TaskConfigScreen.__init__).

        ARRONDI : round(pourcentage/100 * nb_profils), mais au moins 1
        profil sélectionné dès que le pourcentage est > 0 et qu'il
        existe au moins un profil dans la liste -- un pourcentage bas
        (ex: 5%) sur une petite liste (ex: 3 profils) donnerait sinon
        0 profil sélectionné, ce qui reviendrait silencieusement à ne
        rien faire malgré un pourcentage explicitement non nul."""
        pourcentage = (
            self._reglages.pourcentage_selection_aleatoire_clone
            if self._reglages is not None else 50
        )
        nb_profils = self.table_profils.topLevelItemCount()
        if nb_profils == 0:
            return
        nb_a_selectionner = round(pourcentage / 100 * nb_profils)
        if pourcentage > 0:
            nb_a_selectionner = max(1, nb_a_selectionner)
        nb_a_selectionner = min(nb_profils, nb_a_selectionner)
        indices_selectionnes = set(random.sample(range(nb_profils), nb_a_selectionner))
        for i in range(nb_profils):
            item = self.table_profils.topLevelItem(i)
            item.setCheckState(0, Qt.Checked if i in indices_selectionnes else Qt.Unchecked)

    def _sur_clic_ligne_profil(self, item: QTreeWidgetItem, colonne: int):
        """Cf. section 4.3 : clic n'importe où sur la ligne émet demande_
        definir_profil_actif -- le paramètre `colonne` (signature imposée
        par Qt, itemClicked) n'est pas utilisé ici : cle_profil est lu
        depuis Qt.UserRole (colonne 0), peu importe la colonne cliquée,
        donc ce handler reste correct quel que soit l'ordre des colonnes
        du tableau (cf. RÉORDONNANCEMENT COLONNES dans __init__ -- Actions
        avant Statut, Temps en dernier -- qui n'affecte pas cette
        fonction).

        BUGFIX (retour utilisateur : cliquer sur le NOM -- colonne 0 --
        n'activait pas la ligne, seule la colonne Statut réagissait) :
        la colonne 0 n'est PLUS ignorée. Le clic sur le texte du nom
        (itemClicked, colonne=0) et le clic sur la checkbox elle-même
        (le petit carré, qui déclenche itemChanged séparément, cf.
        _sur_item_changed) sont deux événements Qt distincts -- traiter
        colonne==0 ici ne coche/décoche jamais la case par erreur.

        REFONTE MULTI-SAUTONIAX -- émet la CLÉ COMPOSITE (Qt.UserRole,
        cf. docstring du item.setData dans _reconstruire_table_
        completement), pas item.text(0) qui n'est plus que le nom NU
        (ambigu entre deux sAutoniax homonymes)."""
        cle_profil = item.data(0, Qt.UserRole)
        if not cle_profil:
            return
        # Bascule : recliquer la ligne déjà active désélectionne (section
        # 1 point 11) -- pas besoin d'item "Aucun" séparé.
        if cle_profil == self._profil_actif:
            self.demande_definir_profil_actif.emit("")
        else:
            self.demande_definir_profil_actif.emit(cle_profil)

    def _sur_clic_droit_ligne_profil(self, position):
        """AJOUT (demande explicite utilisateur : clic droit sur un profil
        clone -> premier plan ponctuel -- "directement, je ne veux pas de
        menue") -- connecté à customContextMenuRequested (cf. __init__),
        déclenché par un clic droit n'importe où sur la ligne, MÊME
        principe que _sur_clic_ligne_profil ci-dessus (n'importe quelle
        colonne) mais SANS construire de QMenu : résout directement la
        ligne sous le curseur et émet demande_premier_plan_clone_profil,
        un seul clic droit = une seule action immédiate.

        position : QPoint relatif au viewport de table_profils, fourni
        par Qt via customContextMenuRequested -- même façon de résoudre
        l'item que les menus contextuels existants du fichier (cf.
        _afficher_menu_executants, self.table_executants.itemAt(position))."""
        item = self.table_profils.itemAt(position)
        if item is None:
            return
        cle_profil = item.data(0, Qt.UserRole)
        if not cle_profil:
            return
        self.demande_premier_plan_clone_profil.emit(cle_profil)

    def _construire_widget_statut_profil(self, cle_profil: str, etat_profil: "CloneProfilEtat") -> QWidget:
        """CORRECTIF (retour utilisateur, capture d'écran à l'appui :
        la pastille `result_color` s'affichait dans la colonne "Actions"
        au lieu de la colonne "Statut") : widget composite pour la
        colonne 3 (Statut) du panneau clone -- texte de statut existant
        (_libelle_statut) + pastille `result_color` juste à sa droite,
        posé via setItemWidget(item, 3, ...) à la place d'un simple
        item.setText(3, ...), conformément à SPEC_lot_corrections_2026-
        09.md section 11 : "la pastille apparaît dans la colonne Statut
        du panneau clone, à côté du message 'Succès' existant".

        Remplace un item.setText(3, ...) : le texte n'est donc plus géré
        par QTreeWidgetItem lui-même dans ce widget, mais dessiné ici via
        un QLabel -- même police/couleur que l'ancien texte d'item pour
        rester visuellement identique (cf. _couleur_statut).

        CORRECTIF (retour utilisateur : le texte de statut passait au
        vert dès que le profil était actif, écrasant le bleu de
        "en_cours"/le rouge d'"erreur"/etc. -- cf. docstring de couleur_
        texte ci-dessous) : la couleur du texte suit désormais TOUJOURS
        _couleur_statut, sans exception pour le profil actif -- cette
        information reste visible via le fond de ligne dédié
        (brosse_active), pas via ce texte.

        Pastille affichée UNIQUEMENT sur un lot terminé avec succès ET
        une result_color différente de la valeur neutre par défaut
        "#FFFFFF" (cf. CloneProfilEtat.result_color, format hex depuis le
        retour utilisateur "on fonctionne maintenant avec le code
        hexadecimal") -- un profil jamais lancé, en cours, en erreur, ou
        dont le code n'a jamais réassigné result_color n'affiche donc
        aucune pastille superflue, même comportement qu'avant le
        déplacement."""
        conteneur = QWidget()
        ligne = QHBoxLayout(conteneur)
        ligne.setContentsMargins(4, 0, 4, 0)
        ligne.setSpacing(4)

        nom_profil = _nom_depuis_cle_profil_clone(cle_profil)
        libelle_statut = self._libelle_statut(etat_profil.statut)
        texte_statut = QLabel(libelle_statut, conteneur)
        texte_statut.setToolTip(libelle_statut)
        # CORRECTIF (retour utilisateur explicite : "quand je selctionne
        # un clone et que je lance sont execution, sont labels : en
        # cours ... est vert, alors que sa devais rester bleu") -- ce
        # texte forçait AUPARAVANT le vert dès que le profil est le
        # profil actif (cle_profil == self._profil_actif), PEU IMPORTE
        # son statut réel -- ça écrasait donc le bleu de "en_cours" (et
        # aurait pareillement écrasé le rouge d'"erreur", etc.) dès qu'un
        # profil actif changeait de statut technique. Le statut
        # ("En cours"/"Succès"/"Erreur"/...) doit toujours porter SA
        # propre couleur (_couleur_statut), sans exception pour le profil
        # actif -- l'information "ce profil est actif" reste par ailleurs
        # déjà visible ET distincte via le fond de ligne dédié
        # (brosse_active sur les 5 colonnes, cf. plus haut dans
        # _reconstruire_table/_reconstruire_table_completement), donc
        # rien n'est perdu en retirant le vert du texte lui-même --
        # seule la redondance/le conflit avec le code couleur du statut
        # technique est supprimé.
        couleur_texte = self._couleur_statut(etat_profil.statut)
        texte_statut.setStyleSheet(f"color: {couleur_texte.name()};")
        ligne.addWidget(texte_statut)

        if etat_profil.statut == "succes" and etat_profil.result_color and etat_profil.result_color.upper() != COULEUR_RESULT_COLOR_DEFAUT.upper():
            pastille_result_color = QLabel(conteneur)
            # CORRECTIF (retour utilisateur, capture d'écran à l'appui :
            # "la pastille n'est pas assez grosse") -- 8px passé à 12px
            # (cf. colonne Statut élargie à 96px en même temps, cf.
            # setColumnWidth(3, ...) ci-dessus, pour lui laisser la place
            # sans tronquer "En attente"/pousser le texte hors colonne).
            pastille_result_color.setFixedSize(12, 12)
            pastille_result_color.setToolTip(
                f"« {nom_profil} » -- result_color = {etat_profil.result_color!r}"
            )
            # QColor(...) directement sur la valeur stockée : déjà
            # validée en hex (_hex_couleur_valide) côté sAutoniax avant
            # transmission (cf. _sautoniax_executer_notebook_distant_sur_
            # instance_isolee), donc toujours un "#rgb"/"#rrggbb" valide
            # à ce stade -- repli "#FFFFFF" géré à la source, jamais ici.
            pastille_result_color.setStyleSheet(
                f"background-color: {QColor(etat_profil.result_color).name()}; "
                "border-radius: 6px; border: 1px solid rgba(0, 0, 0, 60);"
            )
            ligne.addWidget(pastille_result_color)

        ligne.addStretch(1)
        return conteneur

    def _construire_widget_actions_profil(self, cle_profil: str, etat_profil: "CloneProfilEtat") -> QWidget:
        """Cf. section 4.5 : badge de statut (BadgeStatutNotebook,
        réutilisé tel quel -- même widget que le badge global de
        TaskConfigScreen) + bouton unique démarrer/arrêter individuel
        pour CE profil. Boutons œil/logs retirés (section 2.1) --
        remplacés par la sélection de ligne (section 4.3).

        REFONTE MULTI-SAUTONIAX -- `cle_profil` est la CLÉ COMPOSITE
        (id_executant::nom_profil, cf. _cle_profil_clone) : c'est elle
        qui est ÉMISE dans les signaux (demande_arreter_clone_profil/
        demande_lancer_clone_profil), pour que TaskConfigScreen cible
        sans ambiguïté le bon profil même en cas d'homonymie entre
        sAutoniax. Seul le texte affiché (badge, tooltips) utilise le
        nom NU, extrait via _nom_depuis_cle_profil_clone."""
        nom_profil = _nom_depuis_cle_profil_clone(cle_profil)
        conteneur = QWidget()
        ligne = QHBoxLayout(conteneur)
        ligne.setContentsMargins(4, 2, 4, 2)
        ligne.setSpacing(6)

        badge = BadgeStatutNotebook(conteneur)
        if etat_profil.statut in ("en_attente", "en_cours"):
            badge.definir_en_cours(f"« {nom_profil} » -- {self._libelle_statut(etat_profil.statut).lower()}")
        else:
            badge.definir_statut(
                self._couleur_statut(etat_profil.statut).name(),
                f"« {nom_profil} » -- {self._libelle_statut(etat_profil.statut)}",
            )
        ligne.addWidget(badge)

        # DÉPLACÉ (retour utilisateur explicite, capture d'écran à
        # l'appui : la pastille `result_color` s'affichait ici, dans la
        # colonne "Actions", alors que la spec section 11 demande
        # explicitement "à côté du message Succès existant" -- donc dans
        # la colonne "Statut" texte, pas ici à côté du badge de statut
        # technique/boutons Démarrer-Arrêter/Kill. Écart entre l'intention
        # documentée et l'implémentation réelle, maintenant corrigé : la
        # pastille est construite par _construire_widget_statut_profil et
        # posée via setItemWidget(item, 3, ...) à la place d'un simple
        # item.setText(3, ...), cf. _reconstruire_table/_reconstruire_
        # table_completement. Rien à afficher ici dans la colonne Actions.
        en_cours = etat_profil.statut in ("en_attente", "en_cours")
        bouton_demarrer_arreter = QToolButton(conteneur)
        bouton_demarrer_arreter.setAutoRaise(True)
        if en_cours:
            bouton_demarrer_arreter.setIcon(qta.icon("mdi6.stop-circle-outline", color=Mocha.red))
            bouton_demarrer_arreter.setToolTip(f"Arrêter « {nom_profil} ».")
        else:
            bouton_demarrer_arreter.setIcon(qta.icon("mdi6.play-circle-outline", color=Mocha.green))
            bouton_demarrer_arreter.setToolTip(f"Lancer « {nom_profil} » seul.")
        # BUGFIX : ouvrir_rendu_reseau=False explicite -- ce bouton
        # individuel (colonne Actions, section 4.5) ne doit jamais
        # ouvrir le panneau de rendu, contrairement au bouton global
        # "Tout exécuter" (cf. docstring du signal demande_lancer_
        # clone_profil ci-dessus). Émet la CLÉ COMPOSITE, pas nom_profil
        # (cf. docstring de la REFONTE MULTI-SAUTONIAX ci-dessus).
        bouton_demarrer_arreter.clicked.connect(
            lambda: self.demande_arreter_clone_profil.emit(cle_profil) if en_cours
            else self.demande_lancer_clone_profil.emit(cle_profil, False)
        )
        ligne.addWidget(bouton_demarrer_arreter)

        # AJOUT (SPEC_lot_corrections_2026-09.md section 9) : bouton Kill
        # -- toujours affiché (contrairement à Arrêter/Démarrer ci-dessus
        # qui bascule d'icône selon en_cours), puisque tuer le profil
        # entier reste une action valide qu'il soit en cours d'exécution
        # OU inactif (ex. profil resté "ouvert" côté navigateur sans
        # séquence de cellules active -- cf. kill_profil, no-op inoffensif
        # côté sAutoniax si aucune instance n'est trouvée pour ce nom,
        # même filet de sécurité que pour Arrêter). Icône distincte
        # (croix/power) pour ne pas se confondre visuellement avec le
        # bouton Arrêter juste à gauche malgré la même couleur rouge --
        # les deux actions sont désormais réellement différentes depuis
        # la refonte de la section 8 (Arrêter = interrompt le code, garde
        # le profil vivant ; Kill = tue le profil entier).
        bouton_kill = QToolButton(conteneur)
        bouton_kill.setAutoRaise(True)
        bouton_kill.setIcon(qta.icon("mdi6.power-plug-off-outline", color=Mocha.red))
        bouton_kill.setToolTip(f"Kill « {nom_profil} » (tue le profil entier).")
        bouton_kill.clicked.connect(lambda: self.demande_kill_clone_profil.emit(cle_profil))
        ligne.addWidget(bouton_kill)

        # SUPPRIMÉ (SPEC_lot_corrections_2026-09.md section 2) : bouton
        # dédié "revérifier la connexion" pour le statut "deconnecte" --
        # ce statut n'existe plus, un profil dont le sAutoniax disparaît
        # est désormais retiré directement de la liste au prochain
        # rafraîchissement (cf. TaskConfigScreen._invalider_executions_
        # clone_disparues), plus d'état intermédiaire à afficher ni de
        # bouton pour le "revérifier".

        ligne.addStretch(1)
        return conteneur

    def _sur_clic_lancer_clones(self):
        # REFONTE MULTI-SAUTONIAX -- self._profils est keyé par CLÉ
        # COMPOSITE (cf. _cle_profil_clone) : cette liste transporte
        # donc déjà des clés composites, pas des noms nus, cohérent avec
        # la docstring de demande_lancer_clones.
        cles_cochees = [cle for cle, etat_profil in self._profils.items() if etat_profil.coche]
        if not cles_cochees:
            return
        self.demande_lancer_clones.emit(cles_cochees)


class OverlayChargementTask(QFrame):
    """Barre de chargement RÉELLE (déterminée, 0-100 %) affichée en
    superposition pendant TaskConfigScreen._ouvrir_task.

    C'est la SEULE barre de chargement d'un Task : elle couvre à la fois
    l'import d'un .autoniaxtask (phases du worker) et l'ouverture dans
    l'éditeur (_ouvrir_task), sans jamais repartir de 0 entre les deux.
    Elle remplace l'ancienne barre indéterminée (setRange(0, 0)), dont
    l'animation en boucle n'avait aucun lien avec le travail accompli.
    La valeur est poussée à chaque étape RÉELLEMENT terminée,
    proportionnellement au coût MESURÉ de cette étape (cf.
    TaskConfigScreen._poids_ouverture, calibré sur les durées réelles).

    GÉOMÉTRIE (SPEC_patch_ouverture_task.md §5.3, demande explicite
    utilisateur : "80 % de la largeur de l'interface, plus longue et plus
    fine") -- l'ancienne carte centrée `boite.setFixedWidth(420)` est
    SUPPRIMÉE : elle plafonnait la barre à 420 px moins ses marges, quelle
    que soit la taille de la fenêtre. La largeur est maintenant RECALCULÉE
    (jamais figée en pixels) à partir de celle du parent, à deux moments :
    dans demarrer() et dans resizeEvent() ci-dessous -- ce dernier reçoit
    l'événement dès que TaskConfigScreen.resizeEvent recale l'overlay sur
    self.grille_page.rect(), donc redimensionner la fenêtre PENDANT un
    chargement suit correctement (critère d'acceptation §5.5). Les marges
    horizontales de la boîte sont à 0 pour que ce soit bien `self.barre`
    elle-même qui mesure 80 % (le critère §5.5 se mesure sur
    barre.width(), pas sur celle du conteneur).

    Widget enfant de la page grille (pas une fenêtre). Il INTERCEPTE les
    événements souris (§5.3.4) : c'est un QFrame opaque aux événements
    posé au-dessus de la grille, donc aucun clic ne peut atteindre une
    carte pendant que l'ouverture travaille -- mousePressEvent/
    mouseReleaseEvent/mouseDoubleClickEvent ci-dessous les absorbent
    explicitement plutôt que de compter sur le comportement par défaut.
    Aucun QGraphicsEffect, aucune animation (§5.3.5) : pendant le travail
    l'UI est bloquée, seule la peinture synchrone de
    repeindre_immediatement() fonctionne."""

    # Part de la largeur du parent occupée par la barre (demande explicite
    # utilisateur). Recalculée, jamais convertie en constante de pixels.
    _FRACTION_LARGEUR = 0.80

    def __init__(self, parent: QWidget):
        super().__init__(parent)
        self.setObjectName("OverlayChargementTask")
        self.setAttribute(Qt.WA_StyledBackground, True)
        layout = QVBoxLayout(self)
        layout.setContentsMargins(0, 0, 0, 0)
        layout.setAlignment(Qt.AlignCenter)

        self.boite = QFrame(self)
        self.boite.setObjectName("OverlayChargementTaskBoite")
        boite_layout = QVBoxLayout(self.boite)
        # Marges horizontales NULLES (cf. docstring) : la barre fait
        # exactement la largeur de la boîte, donc exactement 80 % du
        # parent. Marges verticales conservées pour ne pas coller le
        # titre/le libellé d'étape à la barre.
        boite_layout.setContentsMargins(0, 16, 0, 16)
        boite_layout.setSpacing(10)

        self.label_titre = QLabel("Ouverture du Task…", self.boite)
        self.label_titre.setObjectName("OverlayChargementTaskTitre")
        boite_layout.addWidget(self.label_titre)

        self.barre = QProgressBar(self.boite)
        self.barre.setObjectName("OverlayChargementTaskBarre")
        self.barre.setRange(0, 1000)  # millièmes : évite les sauts visibles
        self.barre.setValue(0)
        self.barre.setTextVisible(False)
        boite_layout.addWidget(self.barre)

        # Libellé d'étape SOUS la barre, aligné à gauche, même largeur
        # qu'elle (§5.3.3).
        self.label_etape = QLabel("", self.boite)
        self.label_etape.setObjectName("OverlayChargementTaskEtape")
        self.label_etape.setAlignment(Qt.AlignLeft | Qt.AlignVCenter)
        boite_layout.addWidget(self.label_etape)

        layout.addWidget(self.boite, 0, Qt.AlignCenter)
        self.hide()

    # ------------------------------------------------------------------
    # Géométrie : 80 % de la largeur du parent, recalculée (§5.3.1)
    # ------------------------------------------------------------------
    def _recalculer_largeur(self):
        """Fixe la largeur de la boîte (donc de la barre, marges
        horizontales nulles) à _FRACTION_LARGEUR de la largeur DISPONIBLE.

        Utilise self.width() plutôt que parentWidget().width() : l'overlay
        est systématiquement posé sur parent.rect() (cf. demarrer et
        TaskConfigScreen.resizeEvent), donc les deux valent la même chose,
        mais self.width() reste juste même si un appelant futur lui donnait
        une géométrie partielle. Repli sur le parent tant que l'overlay
        n'a pas encore de taille propre (premier appel avant tout
        affichage)."""
        largeur_ref = self.width()
        if largeur_ref <= 0:
            parent = self.parentWidget()
            largeur_ref = parent.width() if parent is not None else 0
        if largeur_ref <= 0:
            return
        self.boite.setFixedWidth(int(largeur_ref * self._FRACTION_LARGEUR))

    def resizeEvent(self, event):
        """Recale la largeur à chaque redimensionnement -- c'est ce qui
        rend le 80 % réellement responsive (critère §5.5 : redimensionner
        la fenêtre pendant un chargement recale la barre)."""
        super().resizeEvent(event)
        self._recalculer_largeur()

    # ------------------------------------------------------------------
    # API appelée par _ouvrir_task_impl / _demarrer_barre_import /
    # _sur_phase_import_terminee / _abandonner_barre_import.
    # SIGNATURES FIGÉES (§5.4) -- ne pas changer.
    # ------------------------------------------------------------------
    def demarrer(self, titre: str):
        parent = self.parentWidget()
        if parent is not None:
            self.setGeometry(parent.rect())
        self._recalculer_largeur()
        self.label_titre.setText(titre)
        self.label_etape.setText("")
        self.barre.setValue(0)
        self.raise_()
        self.show()

    def mettre_a_jour(self, fraction: float, libelle_etape: str):
        """`fraction` dans [0, 1] -- part du coût total ESTIMÉ déjà
        écoulée. Bornée à 0.99 tant que terminer() n'a pas été appelé :
        la barre n'affiche jamais 100 % avant que tout soit vraiment fini,
        même si l'estimation a sous-évalué le coût restant.

        NE RECULE JAMAIS (critère d'acceptation §5.5) -- garanti ICI, dans
        le widget, plutôt que supposé chez les appelants. Le cas réel qui
        l'exige : pendant un import, _demarrer_barre_import estime les
        poids avec la taille du DERNIER Task ouvert (le fichier n'est pas
        encore lu), puis _ouvrir_task_impl les recale sur le vrai nombre
        de cellules dès qu'il est connu. Si le Task importé est plus gros
        que l'estimation, le dénominateur grossit d'un coup et la même
        quantité de travail accompli retombe à une fraction PLUS PETITE :
        la barre reculerait sous les yeux de l'utilisateur. max() avec la
        valeur déjà affichée supprime ce cas sans rien changer au
        fonctionnement normal (les appelants sont monotones par
        construction). demarrer() remet à 0 sans passer par ici, donc une
        nouvelle ouverture repart bien de zéro."""
        fraction = max(0.0, min(0.99, fraction))
        self.barre.setValue(max(self.barre.value(), int(fraction * 1000)))
        self.label_etape.setText(libelle_etape)

    def repeindre_immediatement(self):
        """Peint MAINTENANT, de façon synchrone, sans rendre la main à la
        boucle d'événements (SPEC §H3/§R5).

        Remplace les QApplication.processEvents() qui parsemaient
        _ouvrir_task_impl. processEvents() exécute du code ARBITRAIRE au
        milieu de la reconstruction des widgets : timers, slots réseau
        (ClientReseau.instances_list -> _sur_liste_instances_recue ->
        panneau_composants.rafraichir, qui DÉTRUIT et reconstruit des
        widgets), réentrance de _ouvrir_task... repaint() ne fait qu'une
        chose : peindre. Aucun événement en attente n'est délivré.

        layout().activate() d'abord : setText() sur label_etape ne fait
        qu'invalider le layout et POSTER un LayoutRequest, qui ne serait
        jamais traité puisqu'on ne retourne pas à la boucle -- sans cet
        appel, un libellé plus long que le précédent resterait tronqué.
        Le layout concerné ne contient que 3 widgets : coût négligeable,
        et surtout AUCUN rapport avec les layouts de l'éditeur (l'overlay
        est enfant de grille_page)."""
        layout = self.layout()
        if layout is not None:
            layout.activate()
        self.repaint()

    def terminer(self):
        self.barre.setValue(1000)
        self.hide()

    # ------------------------------------------------------------------
    # Blocage des clics (§5.3.4) -- le voile doit absorber la souris, pas
    # la laisser passer vers les cartes de la grille en dessous.
    # ------------------------------------------------------------------
    def mousePressEvent(self, event):
        event.accept()

    def mouseReleaseEvent(self, event):
        event.accept()

    def mouseDoubleClickEvent(self, event):
        event.accept()


class CompteurEvenementsQt(QObject):
    """DIAGNOSTIC E5 (SPEC_patch_ouverture_task.md §3) -- compte les
    événements Qt émis pendant un bloc de code donné.

    cProfile ne voit PAS le temps passé dans le C++ de Qt : un
    setCurrentWidget() de 42 s y apparaît comme un seul appel opaque. Ce
    compteur, lui, dit COMBIEN d'événements Polish / LayoutRequest /
    Resize / Show Qt a réellement traité pendant ce bloc -- c'est ce qui
    distingue "une opération lente" (compteurs normaux) d'une "cascade de
    relayout" (compteurs qui explosent, typiquement resizeEvent ->
    _ajuster_hauteur -> setFixedHeight -> resizeEvent).

    Posé sur QApplication (un seul installEventFilter, pas un par widget)
    et UNIQUEMENT quand AUTONIAX_DEBUG=1 : un filtre d'événements global
    voit passer TOUS les événements de l'application, donc il a lui-même
    un coût -- hors de question de le laisser branché en permanence."""

    _TYPES_SUIVIS = None  # initialisé paresseusement (QEvent.Type au premier usage)

    def __init__(self):
        super().__init__()
        if CompteurEvenementsQt._TYPES_SUIVIS is None:
            CompteurEvenementsQt._TYPES_SUIVIS = {
                QEvent.Type.Polish: "Polish",
                QEvent.Type.LayoutRequest: "LayoutRequest",
                QEvent.Type.Resize: "Resize",
                QEvent.Type.Show: "Show",
            }
        self.compteurs: dict = {nom: 0 for nom in CompteurEvenementsQt._TYPES_SUIVIS.values()}

    def eventFilter(self, watched, event):
        nom = CompteurEvenementsQt._TYPES_SUIVIS.get(event.type())
        if nom is not None:
            self.compteurs[nom] += 1
        return False  # jamais consommé : purement observateur

    def resume(self) -> str:
        return ", ".join(f"{nom}={n}" for nom, n in self.compteurs.items())


# PATCH (étape 3) : liste virtuelle de cadres recyclés
class _FrameMuet:
    """PATCH (étape 3, liste virtuelle) : « cadre » sans widget, renvoyé à la
    place d'un cadre quand on exécute une cellule qui n'est pas montée à
    l'écran. Toute méthode appelée dessus ne fait rien : l'état de la cellule
    (sortie, statut, numéro) vit dans les DONNÉES et réapparaît quand un
    cadre est rebranché dessus (cf. ListeVirtuelleCellules._finir_montage)."""

    @property
    def editeur(self):
        return self

    def __getattr__(self, nom):
        if nom.startswith("__"):
            raise AttributeError(nom)
        return self._noop

    @staticmethod
    def _noop(*_args, **_kwargs):
        return None


class _ConteneurListeVirtuelle(QWidget):
    """Parent des cadres montés : un seul widget de hauteur fixe égale à la
    somme des hauteurs de TOUTES les cellules. Les cadres y sont positionnés à
    la main (pas de QLayout : pas de cascade de mises en page au défilement)."""

    def __init__(self, parent, liste):
        super().__init__(parent)
        self._liste = liste
        self.setObjectName("ConteneurListeVirtuelle")
        self.setSizePolicy(QSizePolicy.Expanding, QSizePolicy.Fixed)

    def resizeEvent(self, event):
        super().resizeEvent(event)
        self._liste._sur_largeur_changee()

    def moveEvent(self, event):
        super().moveEvent(event)
        self._liste._planifier_synchro()


class ListeVirtuelleCellules(QObject):
    """PATCH (spec éditeur partagé, étape 3) : seules les cellules proches de
    la zone visible ont un cadre (TaskCelluleWidget). Les autres ne sont que
    des lignes de la table des hauteurs ; l'espace qu'elles occupent est
    représenté par la hauteur du conteneur.

    - `ids` : ordre des cellules de task.cellules (« Variable dynamique » reste
      hors liste, dans son conteneur habituel) ;
    - `hauteurs` : hauteur MESURÉE d'un cadre monté ; sinon estimation
      (lignes de code, repli, sortie) corrigée à la première mesure réelle ;
    - au défilement, les cadres sortis de la zone sont rebranchés (lier,
      étape 1) sur les cellules qui y entrent : aucun widget n'est créé tant
      que le lot existant suffit ;
    - une mesure qui change la hauteur d'une cellule AU-DESSUS de ce qu'on voit
      est compensée sur la barre de défilement : le contenu visible ne bouge pas.

    Contrainte Qt : tout ceci s'exécute sur le thread principal (aucun thread)."""

    ESPACEMENT = 14        # = notebook_layout.setSpacing(14)
    H_REPLIEE = 0          # surcoût d'une cellule repliée : même overhead, sans code

    def __init__(self, ecran):
        super().__init__(ecran)
        self.ecran = ecran
        self.conteneur = _ConteneurListeVirtuelle(ecran.notebook_contenu, self)
        self.conteneur.hide()
        self.libres: list = []          # cadres démontés, prêts à être rebranchés
        self.montes: dict = {}          # cellule_id -> cadre
        self.ids: list = []
        self.hauteurs: dict = {}
        self._cumul = [0]
        self._surcout = 47              # hauteur d'un cadre hors code (titre + description), corrigée à la mesure
        self._en_cours = False
        self._mesure_planifiee = False
        self._synchro_planifiee = False
        sb = ecran.notebook_scroll.verticalScrollBar()
        sb.valueChanged.connect(self._sur_defilement)
        ecran.notebook_scroll.viewport().installEventFilter(self)

    # ------------------------------------------------------------------
    # Données
    # ------------------------------------------------------------------
    def _task(self):
        return self.ecran._task_courant_obj()

    def _cellule(self, cid: str):
        t = self._task()
        if t is None:
            return None
        for c in t.cellules:
            if c.id == cid:
                return c
        return None

    def _partage(self):
        return self.ecran._partage_editeur_pour_cadres()

    def largeur(self) -> int:
        return max(1, self.conteneur.width())

    def hauteur_estimee(self, cellule) -> int:
        """Sans retour à la ligne la hauteur du code est exacte
        (blockCount * interligne + rembourrage, comme SessionCellule.hauteur) ;
        le reste (titre, description, sortie) est estimé puis corrigé."""
        p = self._partage()
        if p is None:
            return 200
        m = p.metriques()
        h_code = (cellule.code.count("\n") + 1) * m.interligne + m.pad_h
        if getattr(cellule, "repliee", False):
            return self._surcout
        h = h_code + self._surcout
        if cellule.sortie:
            nb = min(cellule.sortie.count("\n") + 1, 60)
            h += 40 + nb * 18
        return int(h)

    def hauteur(self, cid: str) -> int:
        h = self.hauteurs.get(cid)
        if h is not None:
            return h
        c = self._cellule(cid)
        return self.hauteur_estimee(c) if c is not None else 100

    def _recalculer(self):
        cum = [0]
        for cid in self.ids:
            cum.append(cum[-1] + self.hauteur(cid) + self.ESPACEMENT)
        self._cumul = cum
        total = max(0, cum[-1] - self.ESPACEMENT) if self.ids else 0
        if self.conteneur.height() != total:
            self.conteneur.setFixedHeight(total)

    def y_de(self, cid: str) -> int:
        """Ordonnée (dans le conteneur) du haut de la cellule."""
        try:
            return self._cumul[self.ids.index(cid)]
        except ValueError:
            return 0

    def _y_conteneur(self) -> int:
        return self.conteneur.mapTo(self.ecran.notebook_contenu, QPoint(0, 0)).y()

    # ------------------------------------------------------------------
    # Cycle de vie
    # ------------------------------------------------------------------
    def charger(self, task):
        """Ouverture d'un notebook : AUCUN widget n'est créé si le lot de cadres
        recyclés suffit (réouverture, ou deuxième notebook)."""
        self.reinitialiser()
        self.ids = [c.id for c in task.cellules]
        self.hauteurs.clear()
        lay = self.ecran.notebook_layout
        if lay.indexOf(self.conteneur) < 0:
            lay.insertWidget(max(lay.count() - 1, 0), self.conteneur)
        self.conteneur.show()
        self._recalculer()
        self.ecran.notebook_scroll.verticalScrollBar().setValue(0)
        self.synchroniser(force=True)
        self._planifier_mesure()

    def reinitialiser(self):
        for cid in list(self.montes):
            self._demonter(cid)
        self.ids = []
        self.hauteurs.clear()
        self._cumul = [0]

    # ------------------------------------------------------------------
    # Plage visible
    # ------------------------------------------------------------------
    def _plage(self, marge_facteur: float):
        import bisect
        sb = self.ecran.notebook_scroll.verticalScrollBar()
        vp_h = max(1, self.ecran.notebook_scroll.viewport().height())
        marge = int(vp_h * marge_facteur)
        haut = sb.value() - self._y_conteneur()
        n = len(self.ids)
        if n == 0:
            return 0, -1
        a = bisect.bisect_right(self._cumul, haut - marge) - 1
        b = bisect.bisect_right(self._cumul, haut + vp_h + marge) - 1
        a = min(max(a, 0), n - 1)
        b = min(max(b, a), n - 1)
        return a, b

    def synchroniser(self, force: bool = False):
        """Monte les cadres de la plage visible (plus une marge), démonte les
        autres. Rien à faire tant que la plage nécessaire est déjà couverte."""
        if self._en_cours or not self.ids:
            return
        a, b = self._plage(0.5)
        if not force and self.montes:
            idx = [self.ids.index(c) for c in self.montes if c in self.ids]
            if idx and min(idx) <= a and max(idx) >= b and \
                    set(self.montes) == {self.ids[i] for i in range(min(idx), max(idx) + 1)}:
                return
        a, b = self._plage(0.9)      # hystérésis : on monte plus large qu'on ne vérifie
        voulus = self.ids[a:b + 1]
        voulus_set = set(voulus)
        self._en_cours = True
        try:
            for cid in [c for c in self.montes if c not in voulus_set]:
                self._demonter(cid)
            for i in range(a, b + 1):
                cid = self.ids[i]
                if cid not in self.montes:
                    self._monter(cid, i)
            self._positionner()
        finally:
            self._en_cours = False
        self._planifier_mesure()

    def _planifier_synchro(self):
        if not self._synchro_planifiee:
            self._synchro_planifiee = True
            QTimer.singleShot(0, self._synchro_differee)

    def _synchro_differee(self):
        self._synchro_planifiee = False
        self.synchroniser()

    def _sur_defilement(self, _valeur):
        if self.conteneur.isVisible():
            self.synchroniser()

    # ------------------------------------------------------------------
    # Montage / démontage
    # ------------------------------------------------------------------
    def prechauffer_cadre(self):
        """PATCH (préchauffage) : crée un cadre sur une cellule factice, le
        retire du registre des cadres affichés et le range dans `libres`.
        `_monter` le rebranchera (lier) sur une vraie cellule sans rien créer."""
        factice = TaskCellule()
        cadre = self._creer_cadre(factice, 1)
        self.ecran._cellule_widgets.pop(factice.id, None)
        cadre.hide()
        # Applique la feuille de style maintenant plutôt qu'au premier affichage.
        cadre.ensurePolished()
        for enfant in cadre.findChildren(QWidget):
            enfant.ensurePolished()
        self.libres.append(cadre)

    def _creer_cadre(self, cellule, index: int):
        e = self.ecran
        cadre = TaskCelluleWidget(
            cellule, e.reglages, self.conteneur,
            active=getattr(cellule, "active", True),
            insuprimable=(index == 0),
            epinglee_visuelle=False,
            partage=self._partage(),
        )
        e._connecter_widget_cellule(cadre)      # enregistre aussi dans _cellule_widgets
        cadre.installEventFilter(self)
        return cadre

    def _monter(self, cid: str, index: int):
        cellule = self._cellule(cid)
        if cellule is None:
            return
        e = self.ecran
        if self.libres:
            cadre = self.libres.pop()
            cadre.lier(
                cellule,
                insuprimable=(index == 0),
                epinglee_visuelle=False,
                afficher_bouton_etiquette=False,
                etiquetee=True,
                index=index + 1,
            )
            if cadre.parent() is not self.conteneur:
                cadre.setParent(self.conteneur)
            e._cellule_widgets[cid] = cadre
        else:
            cadre = self._creer_cadre(cellule, index)
            cadre.definir_index(index + 1)
        self.montes[cid] = cadre
        cadre.show()
        self._finir_montage(cadre, cellule)

    def _finir_montage(self, cadre, cellule):
        """Tout ce qui, avant, était posé sur le cadre à un autre moment et
        qui doit réapparaître quand un cadre est rebranché sur la cellule."""
        e = self.ecran
        cid = cellule.id
        # état d'exécution : la source de vérité est dans l'écran, pas dans le cadre
        if cid in (getattr(e, "_moteurs_en_cours", None) or {}):
            if getattr(e, "_sequence_cellule_courante", None) == cid:
                cadre.indiquer_en_cours_sequence()
            else:
                cadre.indiquer_en_cours()
        elif getattr(e, "_sequence_file", None) and cid in e._sequence_file:
            cadre.indiquer_en_attente_sequence()
        e._appliquer_etat_global_au_cadre(cadre)

    def _demonter(self, cid: str):
        cadre = self.montes.pop(cid, None)
        if cadre is None:
            return
        cadre.liberer_editeur_partage()
        s = cadre._session
        if s is not None and s.frame is cadre:
            s.frame = None
            s.decolorer()   # PATCH (étape 4)
        cadre.hide()
        self.ecran._cellule_widgets.pop(cid, None)
        self.libres.append(cadre)

    def _positionner(self):
        """Place chaque cadre monté à (0, cumul[i]) avec sa hauteur."""
        l = self.largeur()
        for cid, cadre in self.montes.items():
            if cid not in self.ids:
                continue
            i = self.ids.index(cid)
            h = self.hauteur(cid)
            g = cadre.geometry()
            if g.x() != 0 or g.y() != self._cumul[i] or g.width() != l or g.height() != h:
                cadre.setGeometry(0, self._cumul[i], l, h)

    def _sur_largeur_changee(self):
        if self._en_cours:
            return
        self._positionner()
        self._planifier_mesure()

    # ------------------------------------------------------------------
    # Mesure réelle et compensation du défilement
    # ------------------------------------------------------------------
    @staticmethod
    def _hauteur_voulue(cadre, largeur: int) -> int:
        lay = cadre.layout()
        h = lay.totalHeightForWidth(largeur) if lay.hasHeightForWidth() else lay.sizeHint().height()
        return max(h, lay.minimumSize().height())

    def _planifier_mesure(self):
        if not self._mesure_planifiee:
            self._mesure_planifiee = True
            QTimer.singleShot(0, self._appliquer_mesures)

    def _appliquer_mesures(self):
        self._mesure_planifiee = False
        if not self.montes or self._en_cours:
            return
        l = self.largeur()
        sb = self.ecran.notebook_scroll.verticalScrollBar()
        y0 = self._y_conteneur()
        v = sb.value()
        # ancre : première cellule montée dont le bas dépasse le haut visible
        ancre = None
        for cid in sorted(self.montes, key=lambda c: self.ids.index(c) if c in self.ids else 0):
            if cid not in self.ids:
                continue
            i = self.ids.index(cid)
            if y0 + self._cumul[i] + self.hauteur(cid) > v:
                ancre = cid
                break
        decalage = (y0 + self._cumul[self.ids.index(ancre)] - v) if ancre else 0
        change = False
        for cid, cadre in self.montes.items():
            h = self._hauteur_voulue(cadre, l)
            if self.hauteurs.get(cid) != h:
                self.hauteurs[cid] = h
                change = True
                # apprend le surcoût hors code d'après un cadre sans sortie ni repli
                c = self._cellule(cid)
                p = self._partage()
                if c is not None and p is not None and not c.sortie and not getattr(c, "repliee", False):
                    m = p.metriques()
                    s = h - ((c.code.count("\n") + 1) * m.interligne + m.pad_h)
                    if 0 < s < 400:
                        self._surcout = s
        if not change:
            return
        self._en_cours = True
        try:
            self._recalculer()
            self._positionner()
        finally:
            self._en_cours = False
        if ancre is not None and ancre in self.ids:
            self.ecran.notebook_layout.activate()
            nouveau = y0 + self._cumul[self.ids.index(ancre)] - decalage
            if nouveau != sb.value():
                sb.setValue(nouveau)
        self.synchroniser()

    def invalider_hauteurs(self):
        """Police ou largeur modifiée : tout ce qui a été mesuré est périmé."""
        self.hauteurs.clear()
        self._recalculer()
        self._positionner()
        self._planifier_mesure()

    def eventFilter(self, obj, event):
        t = event.type()
        if t == QEvent.LayoutRequest and not self._en_cours:
            self._planifier_mesure()
        elif t == QEvent.Resize and obj is self.ecran.notebook_scroll.viewport():
            self._planifier_synchro()
        return False

    # ------------------------------------------------------------------
    # Navigation et modifications de structure
    # ------------------------------------------------------------------
    def reveler(self, cid: str, marge_haut: int = 80):
        """Fait défiler jusqu'à la cellule (montée ou non) et la monte."""
        if cid not in self.ids:
            return
        sb = self.ecran.notebook_scroll.verticalScrollBar()
        self._recalculer()
        self.ecran.notebook_layout.activate()
        cible = self._y_conteneur() + self.y_de(cid) - marge_haut
        sb.setValue(max(0, min(cible, sb.maximum())))
        self.synchroniser(force=True)

    def cellule_inseree(self, cellule):
        t = self._task()
        if t is None:
            return
        self.ids = [c.id for c in t.cellules]
        self._recalculer()
        # les index affichés suivent : un cadre monté garde son id, change de rang
        for cid, cadre in self.montes.items():
            if cid in self.ids:
                cadre.definir_index(self.ids.index(cid) + 1)
        self.synchroniser(force=True)

    def cellule_retiree(self, cid: str):
        p = self._partage()
        self._demonter(cid)
        self.hauteurs.pop(cid, None)
        if p is not None:
            p.oublier_session(cid)
        t = self._task()
        self.ids = [c.id for c in t.cellules] if t is not None else [i for i in self.ids if i != cid]
        self._recalculer()
        for c, cadre in self.montes.items():
            if c in self.ids:
                cadre.definir_index(self.ids.index(c) + 1)
        self.synchroniser(force=True)

    def cadres_libres(self) -> int:
        return len(self.libres)


