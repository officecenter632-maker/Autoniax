_JS_CAMOUFOX_LOCALISER_INPUT_FICHIER = """
([px, py]) => {
    function estInputFichier(el) {
        return el && el.tagName === 'INPUT' && el.type === 'file';
    }
    var direct = document.elementFromPoint(px, py);
    var candidat = direct ? (estInputFichier(direct) ? direct : direct.closest('input[type="file"]')) : null;
    if (candidat) return candidat;
    var tous = Array.prototype.slice.call(document.querySelectorAll('input[type="file"]'));
    if (tous.length === 0) return null;
    var meilleur = null, meilleureDistance = Infinity;
    for (var i = 0; i < tous.length; i++) {
        var r = tous[i].getBoundingClientRect();
        var cx = r.left + r.width / 2, cy = r.top + r.height / 2;
        var d = Math.hypot(cx - px, cy - py);
        if (d < meilleureDistance) { meilleureDistance = d; meilleur = tous[i]; }
    }
    return meilleur;
}
"""


async def action_camoufox_drag(page, x: int, y: int, chemin_fichier: str) -> dict:
    """drag(x, y, chemin_fichier) -- dépose un fichier local (ou tous les
    fichiers directs d'un dossier local) sur l'<input type="file"> repéré
    à (x, y) -- même contrat de retour que action_drag côté nodriver
    ({"trouve": bool, "erreur": str|None}), même script JS de
    localisation. ElementHandle.set_input_files(...) remplace
    cdp.dom.set_file_input_files(object_id=...)."""
    try:
        handle = await page.evaluate_handle(_JS_CAMOUFOX_LOCALISER_INPUT_FICHIER, [float(x), float(y)])
        element = handle.as_element()
    except Exception as exc:
        _camoufox_relever_si_fermeture(exc)
        return {"trouve": False, "erreur": f"échec de localisation de l'input file : {exc!r}"}

    if element is None:
        return {"trouve": False, "erreur": "aucun <input type=\"file\"> trouvé à proximité du point ciblé"}

    chemin_nettoye = chemin_fichier.strip().strip('"').strip("'")
    if not chemin_nettoye:
        return {"trouve": False, "erreur": "aucun chemin de fichier fourni pour le drag"}

    if os.path.isdir(chemin_nettoye):
        fichiers = sorted(
            os.path.join(chemin_nettoye, nom)
            for nom in os.listdir(chemin_nettoye)
            if os.path.isfile(os.path.join(chemin_nettoye, nom))
        )
        if not fichiers:
            return {"trouve": False, "erreur": f"dossier vide (aucun fichier direct) : {chemin_nettoye!r}"}
    elif os.path.isfile(chemin_nettoye):
        fichiers = [chemin_nettoye]
    else:
        return {"trouve": False, "erreur": f"fichier ou dossier introuvable : {chemin_nettoye!r}"}

    try:
        await element.set_input_files(fichiers)
    except Exception as exc:
        _camoufox_relever_si_fermeture(exc)
        return {"trouve": False, "erreur": f"échec set_input_files : {exc!r}"}

    return {"trouve": True, "erreur": None}


