    def afficher_composant(self, composant: Composant, image_absolue: Path):
        self._composant_nom = composant.nom
        self._service_api_nom = composant.service_api_nom
        self.prefixe_label.setText(f"({composant.service_api_nom}-…)")

        prefixe = f"{composant.service_api_nom}-"
        nom_court = composant.nom[len(prefixe):] if composant.nom.startswith(prefixe) else composant.nom
        self.nom_edit.setText(nom_court)
        self.erreur_nom_label.setVisible(False)

        # Référence gardée pour pouvoir redessiner le contour de la zone de
        # clic (jaune) sans recharger l'image à chaque petit changement.
        self._composant_courant = composant
        self._image_absolue_courante = image_absolue
        # Un nouveau composant affiché repart toujours sur sa variante
        # principale (variantes[0]) dans l'aperçu, jamais sur une sélection
        # laissée par le composant précédemment affiché dans ce panneau.
        self._variante_selectionnee = composant.variantes[0] if composant.variantes else None

        # PATCH (SPEC_GLOBALE_AutoniaX.md, Partie A §5.3.1) -- les 6
        # widgets de réglages de détection (priorité, seuil, flou,
        # delta_conflit, seuil_candidats, code_filtre) sont désormais
        # chargés depuis LA VARIANTE SÉLECTIONNÉE plutôt que depuis
        # composant directement : la détection réelle lit désormais
        # Variante.<champ> (cf. Partie A §3), composant.<champ> ne sert
        # plus que de gabarit pour une nouvelle variante (cf. §2.2).
        # Factorisé dans _rafraichir_widgets_reglages_detection (appelée
        # aussi par _on_variante_cliquee lors d'un changement de variante).
        self._rafraichir_widgets_reglages_detection()

        index_categorie = self.categorie_combo.findData(composant.categorie)
        self.categorie_combo.blockSignals(True)
        self.categorie_combo.setCurrentIndex(max(0, index_categorie))
        self.categorie_combo.blockSignals(False)

        self.groupe_edit.setText(composant.groupe)

        self.description_edit.blockSignals(True)
        self.description_edit.setPlainText(composant.description)
        self.description_edit.blockSignals(False)

        self.id_dom_edit.blockSignals(True)
        self.id_dom_edit.setText(composant.id_dom)
        self.id_dom_edit.blockSignals(False)

        index_zone_clic = self.zone_clic_combo.findData(composant.zone_clic_mode)
        self.zone_clic_combo.blockSignals(True)
        self.zone_clic_combo.setCurrentIndex(max(0, index_zone_clic))
        self.zone_clic_combo.blockSignals(False)
        self.definir_zone_button.setVisible(composant.zone_clic_mode == "personnalise")

        self._rafraichir_apercu_avec_zone()
        self._rafraichir_galerie_variantes()

    def _rafraichir_widgets_reglages_detection(self):
        """AJOUT (SPEC_GLOBALE_AutoniaX.md, Partie A §5.3.1/§5.3.2) --
        factorise le chargement des 6 widgets de réglages de détection
        (priorité, seuil, flou, delta_conflit, seuil_candidats,
        code_filtre) depuis self._variante_selectionnee, SANS recharger le
        reste du panneau (nom, description, catégorie, groupe, zone de
        clic...) -- appelée par afficher_composant (chargement initial) et
        par _on_variante_cliquee (changement de variante en cours de
        réglage). Repli sur composant.<champ> si _variante_selectionnee
        est None (composant sans variante, cas limite déjà géré ailleurs
        comme "aucune variante")."""
        composant = self._composant_courant
        if composant is None:
            return
        variante = None
        if self._variante_selectionnee is not None and composant.variantes:
            for v in composant.variantes:
                if v == self._variante_selectionnee:
                    variante = v
                    break

        # PATCH DÉFENSIF (bug rapporté : AttributeError 'str' object has no
        # attribute 'priorite_selection') -- `variante` ci-dessus peut être
        # une str NUE plutôt qu'une véritable Variante si composant.variantes
        # contient encore d'anciens chemins bruts (project.json créé avant le
        # patch de add_composant(), ou toute autre source qui aurait oublié
        # d'envelopper le chemin dans Variante(...)). isinstance() écarte ce
        # cas et retombe alors sur composant.<champ>, exactement comme si
        # aucune variante n'était sélectionnée, plutôt que de faire planter
        # tout le panneau de réglages.
        if variante is not None and not isinstance(variante, Variante):
            variante = None

        priorite_selection = variante.priorite_selection if variante is not None else composant.priorite_selection
        seuil_confiance = variante.seuil_confiance if variante is not None else composant.seuil_confiance
        flou_noyau = variante.flou_noyau if variante is not None else composant.flou_noyau
        delta_conflit = variante.delta_conflit if variante is not None else composant.delta_conflit
        seuil_candidats_potentiels = (
            variante.seuil_candidats_potentiels if variante is not None else composant.seuil_candidats_potentiels
        )
        code_filtre = variante.code_filtre if variante is not None else composant.code_filtre

        index_priorite = self.priorite_combo.findData(priorite_selection)
        self.priorite_combo.blockSignals(True)
        self.priorite_combo.setCurrentIndex(max(0, index_priorite))
        self.priorite_combo.blockSignals(False)

        self.seuil_spin.blockSignals(True)
        self.seuil_spin.setValue(seuil_confiance)
        self.seuil_spin.blockSignals(False)

        self.flou_spin.blockSignals(True)
        self.flou_spin.setValue(flou_noyau)
        self.flou_spin.blockSignals(False)

        self.delta_conflit_spin.blockSignals(True)
        self.delta_conflit_spin.setValue(delta_conflit)
        self.delta_conflit_spin.blockSignals(False)

        self.seuil_candidats_spin.blockSignals(True)
        self.seuil_candidats_spin.setValue(seuil_candidats_potentiels)
        self.seuil_candidats_spin.blockSignals(False)

        self.code_filtre_edit.blockSignals(True)
        self.code_filtre_edit.setPlainText(code_filtre)
        self.code_filtre_edit.blockSignals(False)

    def rafraichir_apercu(self, image_absolue: Path):
        # Utilisé après une re-capture (mise à jour de l'image) : l'image sur
        # disque a changé, on la recharge tout en conservant le contour de
        # zone de clic déjà configuré pour ce composant. La variante
        # principale redevient celle affichée (une re-capture remplace
        # justement l'image de cette variante-là).
        self._image_absolue_courante = image_absolue
        if self._composant_courant is not None and self._composant_courant.variantes:
            self._variante_selectionnee = self._composant_courant.variantes[0]
        self._rafraichir_apercu_avec_zone()
        self._rafraichir_galerie_variantes()

    def _rafraichir_galerie_variantes(self):
        """(Re)construit la mini-galerie de miniatures sous l'aperçu
        principal : une vignette par variante, avec un petit bouton "x"
        pour la retirer et un clic pour la voir en grand dans l'aperçu
        principal (visuel uniquement). Appelée à chaque affichage de
        composant et à chaque ajout/suppression de variante pour rester
        synchronisée."""
        # Vide le layout existant (sauf le stretch final qu'on retire aussi,
        # pour le réinsérer proprement à la fin, en gardant toujours le
        # stretch en dernière position).
        while self.variantes_layout.count():
            item = self.variantes_layout.takeAt(0)
            w = item.widget()
            if w is not None:
                w.deleteLater()

        composant = self._composant_courant
        if composant is not None:
            for variant_path in composant.variantes:
                vignette = VarianteVignette(variant_path, get_app_data_dir() / variant_path, self.variantes_container)
                # Un composant doit garder au moins une variante : on
                # masque le bouton de suppression sur la dernière restante
                # plutôt que de laisser l'utilisateur atteindre un état
                # invalide puis se heurter à une erreur.
                vignette.set_suppression_visible(len(composant.variantes) > 1)
                vignette.set_selectionnee(variant_path == self._variante_selectionnee)
                vignette.demande_suppression.connect(self._on_variante_suppression_demandee)
                vignette.clique.connect(self._on_variante_cliquee)
                self.variantes_layout.addWidget(vignette)

        self.variantes_layout.addStretch(1)

    def _on_variante_cliquee(self, variant_path: str):
        """Change l'affichage de l'aperçu principal SUR la variante
        cliquée et, désormais (SPEC_GLOBALE_AutoniaX.md, Partie A §5.3.2),
        recharge aussi les 6 widgets de réglages de détection pour cette
        même variante -- n'écrit toujours rien dans le modèle, ne change
        pas quelle variante est "principale" (variantes[0]) pour la
        vignette de grille ou le template de secours du test rapide."""
        if self._variante_selectionnee == variant_path:
            return
        self._variante_selectionnee = variant_path
        self._image_absolue_courante = get_app_data_dir() / variant_path
        self._rafraichir_apercu_avec_zone()
        self._rafraichir_galerie_variantes()
        self._rafraichir_widgets_reglages_detection()

    def _on_variante_suppression_demandee(self, variant_path: str):
        if self._composant_nom is not None:
            self.demande_supprimer_variante.emit(self._composant_nom, variant_path)

    def _rafraichir_apercu_avec_zone(self):
        """(Re)dessine l'aperçu de l'image du composant avec le contour
        jaune de sa zone de clic : soit le contour de toute l'image (mode
        toute_surface), soit le rectangle personnalisé stocké (mode
        personnalise). Appelé à chaque affichage et à chaque changement de
        mode/zone pour rester toujours synchronisé avec le modèle."""
        composant = self._composant_courant
        image_absolue = self._image_absolue_courante
        if composant is None or image_absolue is None or not image_absolue.exists():
            self.apercu_label.setPixmap(QPixmap())
            return

        image = QImage(str(image_absolue))
        if image.isNull():
            self.apercu_label.setPixmap(QPixmap())
            return

        # Rectangle à dessiner, en coordonnées de l'image d'origine.
        if composant.zone_clic_mode == "personnalise" and not composant.zone_clic_rect.est_vide():
            r = composant.zone_clic_rect
            rect_image = QRect(r.x, r.y, r.largeur, r.hauteur)
        else:
            # Toute la surface : le contour englobe l'image entière.
            rect_image = QRect(0, 0, image.width(), image.height())

        pixmap_source = QPixmap.fromImage(image)
        pixmap_affiche = pixmap_source.scaled(264, 140, Qt.KeepAspectRatio, Qt.SmoothTransformation)

        # Facteur d'échelle entre l'image d'origine et le pixmap affiché,
        # pour convertir le rectangle (coordonnées image) vers l'écran.
        if pixmap_source.width() > 0 and pixmap_source.height() > 0:
            echelle_x = pixmap_affiche.width() / pixmap_source.width()
            echelle_y = pixmap_affiche.height() / pixmap_source.height()
        else:
            echelle_x = echelle_y = 1.0

        painter = QPainter(pixmap_affiche)
        painter.setRenderHint(QPainter.Antialiasing, False)
        pen = QPen(QColor("#f9e2af"))  # jaune Mocha (yellow)
        pen.setWidth(2)
        painter.setPen(pen)
        rect_ecran = QRect(
            round(rect_image.x() * echelle_x),
            round(rect_image.y() * echelle_y),
            max(1, round(rect_image.width() * echelle_x)),
            max(1, round(rect_image.height() * echelle_y)),
        )
        # Le trait ne doit pas être coupé par le bord du pixmap : on le
        # rétracte d'1px quand le rectangle touche le contour de l'image.
        rect_ecran.adjust(1, 1, -1, -1)
        painter.drawRect(rect_ecran)
        painter.end()

        self.apercu_label.setPixmap(pixmap_affiche)


    def valider_nom_en_attente(self):
        """Force la validation du champ nom, comme le ferait editingFinished.
        À appeler avant toute fermeture du panneau ou changement de composant
        sélectionné, sinon un nom tapé mais non validé (Entrée jamais pressée,
        focus jamais perdu) serait silencieusement perdu."""
        if self._composant_nom is not None:
            self._on_nom_edited()

    def _on_nom_edited(self):
        if self.project is None or self._composant_nom is None:
            return
        nouveau_nom_court = self.nom_edit.text().strip()
        prefixe = f"{self._service_api_nom}-"
        ancien_nom_court = (
            self._composant_nom[len(prefixe):]
            if self._composant_nom.startswith(prefixe)
            else self._composant_nom
        )
        if not nouveau_nom_court or nouveau_nom_court == ancien_nom_court:
            self.nom_edit.setText(ancien_nom_court)
            return
        try:
            composant = self.project.rename_composant(self._composant_nom, nouveau_nom_court)
        except ValueError as e:
            self.erreur_nom_label.setText(str(e))
            self.erreur_nom_label.setVisible(True)
            self.nom_edit.setText(ancien_nom_court)
            return
        self.erreur_nom_label.setVisible(False)
        ancien_nom_complet = self._composant_nom
        self._composant_nom = composant.nom
        self.project.save()
        self.nom_modifie.emit(ancien_nom_complet, composant.nom)

    def _variante_selectionnee_objet(self, composant: Composant) -> Optional[Variante]:
        """AJOUT (SPEC_GLOBALE_AutoniaX.md, Partie A §5.3.3) -- retrouve
        l'objet Variante correspondant à self._variante_selectionnee (un
        chemin str, cf. son commentaire de déclaration) dans
        composant.variantes, ou None si composant.variantes est vide ou
        qu'aucune variante ne correspond (cas limite déjà rare, cf.
        remove_variante_composant qui refuse de descendre à 0 variante).
        Factorisé pour éviter de répéter cette recherche dans les 6
        handlers de réglages de détection ci-dessous."""
        if self._variante_selectionnee is None:
            return None
        for v in composant.variantes:
            if v == self._variante_selectionnee:
                return v
        return None

    def _on_priorite_changed(self, index: int):
        if self.project is None or self._composant_nom is None:
            return
        composant = self.project.find_composant(self._composant_nom)
        if not composant:
            return
        variante = self._variante_selectionnee_objet(composant)
        if variante is None:
            return
        variante.priorite_selection = self.priorite_combo.currentData()
        self.project.save()

    def _on_seuil_changed(self, valeur: float):
        if self.project is None or self._composant_nom is None:
            return
        composant = self.project.find_composant(self._composant_nom)
        if not composant:
            return
        variante = self._variante_selectionnee_objet(composant)
        if variante is None:
            return
        # Effet immédiat, même sur une Feature en cours d'exécution (point 2) :
        # ici on modifie directement l'objet du modèle partagé (la Variante
        # sélectionnée, cf. Partie A §5.3.3 -- même instance d'objet que
        # dans composant.variantes tant que la liste n'a pas été
        # réassignée ailleurs), aucune copie intermédiaire n'est faite,
        # donc la nouvelle valeur est visible immédiatement par tout code
        # qui relit cette même Variante.
        variante.seuil_confiance = round(valeur, 2)
        self.project.save()

    def _on_flou_changed(self, valeur: int):
        if self.project is None or self._composant_nom is None:
            return
        composant = self.project.find_composant(self._composant_nom)
        if not composant:
            return
        variante = self._variante_selectionnee_objet(composant)
        if variante is None:
            return
        # cv2.GaussianBlur exige un noyau impair -- corrigé ici (dans l'UI
        # elle-même, valeur affichée réajustée) plutôt que silencieusement
        # au moment de la détection, pour que l'utilisateur voie tout de
        # suite la valeur réellement appliquée. 0 reste 0 (aucun flou,
        # cf. Variante.flou_noyau -- jamais réinterprété comme "1").
        if valeur > 0 and valeur % 2 == 0:
            valeur += 1
            self.flou_spin.blockSignals(True)
            self.flou_spin.setValue(valeur)
            self.flou_spin.blockSignals(False)
        variante.flou_noyau = valeur
        self.project.save()

    def _on_delta_conflit_changed(self, valeur: float):
        if self.project is None or self._composant_nom is None:
            return
        composant = self.project.find_composant(self._composant_nom)
        if not composant:
            return
        variante = self._variante_selectionnee_objet(composant)
        if variante is None:
            return
        variante.delta_conflit = round(valeur, 3)
        self.project.save()

    def _on_seuil_candidats_changed(self, valeur: float):
        if self.project is None or self._composant_nom is None:
