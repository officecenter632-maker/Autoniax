# Attribution WORKSPACE par profil clone -- cf. SPEC_workspace_attribution.md
# et son PATCH v2, SPEC_patch_tasks_json.md (changement de modèle : un
# WORKSPACE n'est plus un dossier contenant des tâches, c'est désormais UN
# SEUL FICHIER JSON contenant un TABLEAU de tâches -- plus de sous-dossier,
# plus de statut.json séparé, plus de multi-WORKSPACE chaîné). Fonctions
# module-niveau (pas de méthode de classe) : ne dépendent d'aucun état de
# widget, uniquement du système de fichiers -- réutilisables tel quel
# depuis PanneauExecutionClone (construction du bouton/boîte) ET
# TaskConfigScreen (clic gauche silencieux, section 4) sans dupliquer la
# logique de scan à deux endroits.

# AJOUT (demande explicite utilisateur : "un mini gestionnaire qui affiche
# les workspaces récents que l'on clique pour ouvrir") -- plafond de la
# liste MRU ReglagesApp.workspace_fichiers_recents, au-delà duquel les
# entrées les plus anciennes tombent silencieusement (cf. enregistrer_
# workspace_recent ci-dessous). Valeur arbitraire mais raisonnable pour un
# "mini" gestionnaire -- pas un historique complet.
NB_MAX_WORKSPACES_RECENTS = 8


def enregistrer_workspace_recent(reglages: "ReglagesApp", chemin_fichier: str) -> None:
    """Insère `chemin_fichier` en tête de `reglages.workspace_fichiers_
    recents` (liste MRU, le plus récent en premier). CORRECTION (demande
    explicite utilisateur : "ça doit persister en global, pas sur le
    fichier [Task]") -- cette liste vit sur ReglagesApp (reglages.json,
    machine-locale, PARTAGÉE par tous les Task/Project), PAS sur Task :
    un chemin ouvert depuis le Task 1 apparaît donc aussi dans les
    récents du Task 2. Si ce chemin y figurait déjà (comparaison exacte
    de chaîne -- pas de normalisation de casse/slashs, cohérent avec le
    simple `str` de Task.workspace_fichier ailleurs dans ce module),
    l'ancienne occurrence est retirée avant réinsertion en tête plutôt
    que dupliquée. Tronque ensuite à NB_MAX_WORKSPACES_RECENTS entrées.
    `chemin_fichier` vide est ignoré silencieusement (rien à
    enregistrer). N'appelle PAS reglages.save() -- à la charge de
    l'appelant (cf. TaskConfigScreen._sur_demande_attribuer_workspace_
    silencieux/_dialogue et DialogueWorkspaceConfig._sur_clic_choisir_
    fichier/_sur_clic_ouvrir_recent), pour rester cohérent avec le fait
    que cette fonction ne touche pas non plus à task.workspace_fichier
    lui-même -- chaque appelant gère sa propre séquence mutation+save."""
    if not chemin_fichier:
        return
    recents = [c for c in reglages.workspace_fichiers_recents if c != chemin_fichier]
    recents.insert(0, chemin_fichier)
    reglages.workspace_fichiers_recents = recents[:NB_MAX_WORKSPACES_RECENTS]


@dataclass
class TacheWorkspace:
    """Une tâche détectée dans le fichier WORKSPACE d'un Task (PATCH v2,
    SPEC_patch_tasks_json.md section 1/2/3 ; PATCH v3 -- ajout du statut
    "abandonnee") : un ÉLÉMENT du tableau JSON contenu dans le fichier
    WORKSPACE unique (Task.workspace_fichier), identifié par son champ
    `"numero"`, portant un champ `"statut"` (`"termine"` / `"en_attente"`
    / `"abandonnee"`) et des champs métier libres. PAS persistée telle
    quelle -- objet de travail reconstruit à chaque scan (cf. scanner_
    taches_workspace), jamais sérialisée dans project.json (seul le
    chemin du fichier WORKSPACE lui-même l'est, cf. Task.workspace_fichier).

    ABANDON du multi-WORKSPACE chaîné (PATCH v2) : un Task ne référence
    plus qu'UN SEUL fichier WORKSPACE -- `racine_workspace` (qui
    permettait de savoir de quelle racine, parmi plusieurs chaînées,
    une tâche provenait) n'a donc plus lieu d'être et est remplacé par
    `fichier_source`, qui pointe simplement vers cet unique fichier
    (utile pour ecrire_statut_tache_workspace, qui doit savoir où
    relire/réécrire le tableau).

    AJOUT (PATCH v3, demande explicite utilisateur : "on vas ajouter un
    3eme : abandonee") : troisième statut `"abandonnee"`, pour une tâche
    volontairement écartée -- distincte d'"en_attente" (qui reste
    candidate à l'attribution) et de "termine" (qui a réellement été
    traitée avec succès). `statut` est désormais le champ source de
    vérité (l'une des valeurs de STATUTS_TACHE_WORKSPACE) ; `termine`
    (bool) est conservé et dérivé de `statut` uniquement pour
    compatibilité avec le code existant qui teste encore ce booléen
    (repartir_taches_workspace, filtres "en attente" partout ailleurs) --
    une tâche abandonnée a donc `termine=False` (elle n'est PAS
    terminée) mais n'est PAS pour autant redistribuable (cf. repartir_
    taches_workspace, qui filtre désormais sur `statut == "en_attente"`,
    plus sur `not termine`)."""
    numero: int  # le "numero" de la tâche dans le tableau JSON, pour un tri stable et un affichage "Tâche N"
    donnees: dict  # l'objet JSON COMPLET de cette tâche (statut et champs métier inclus, tel quel)
    statut: str  # "termine" | "en_attente" | "abandonnee" -- cf. STATUTS_TACHE_WORKSPACE, repli sûr dans scanner_taches_workspace
    termine: bool  # dérivé de statut == "termine", conservé pour compatibilité (cf. docstring ci-dessus)
    fichier_source: str = ""  # chemin absolu du fichier WORKSPACE (le méga-fichier) d'où vient cette tâche

    @property
    def nom_affiche(self) -> str:
        return f"Tâche {self.numero}"

    @property
    def abandonnee(self) -> bool:
        return self.statut == "abandonnee"

    @property
    def en_attente(self) -> bool:
        return self.statut == "en_attente"


# Valeurs valides du champ "statut" d'une TacheWorkspace (PATCH v3) --
# source unique de vérité utilisée par scanner_taches_workspace (repli
# sûr sur valeur inattendue) et ecrire_statut_tache_workspace (validation
# avant écriture disque).
STATUTS_TACHE_WORKSPACE = ("termine", "en_attente", "abandonnee")


def scanner_taches_workspace(fichier_workspace: str) -> list:
    """Scanne `fichier_workspace` -- UN SEUL fichier JSON contenant un
    TABLEAU de tâches (PATCH v2, SPEC_patch_tasks_json.md section 2) --
    et retourne la liste des TacheWorkspace correspondantes, triée par
    numéro croissant. Ne modifie jamais rien sur disque (lecture seule).

    Repli sûr à chaque étape, jamais d'exception levée ici (fichier
    potentiellement supprimé/déplacé entre deux scans, contenu
    partiellement corrompu par une écriture concurrente, etc.) :
    - fichier vide/absent/illisible/JSON invalide/racine pas une liste
      -> liste de tâches vide ;
    - élément du tableau qui n'est pas un objet -> ignoré ;
    - élément sans "numero" exploitable (absent, ou ni un int ni une
      chaîne convertible proprement en int) -> ignoré (une tâche sans
      identifiant stable ne peut pas être re-écrite individuellement
      par ecrire_statut_tache_workspace) ;
    - "numero" déjà rencontré plus tôt dans le tableau -> ignoré, on
      garde la PREMIÈRE occurrence ;
    - "statut" absent/illisible/valeur inattendue -> "en_attente" (une
      tâche dont l'état est incertain reste candidate à l'attribution
      plutôt que d'être silencieusement ignorée). PATCH v3 : "statut"
      == "abandonnee" reconnu au même titre que "termine"/"en_attente"
      (cf. STATUTS_TACHE_WORKSPACE) -- toute autre valeur retombe sur
      "en_attente", comme avant."""
    if not fichier_workspace:
        return []
    chemin = Path(fichier_workspace)
    try:
        brut = json.loads(chemin.read_text(encoding="utf-8"))
    except (OSError, json.JSONDecodeError, UnicodeDecodeError):
        return []
    if not isinstance(brut, list):
        return []

    taches = []
    numeros_vus = set()
    for element in brut:
        if not isinstance(element, dict):
            continue
        numero_brut = element.get("numero")
        numero = None
        if isinstance(numero_brut, bool):
            pass  # bool est une sous-classe d'int en Python -- exclu explicitement
        elif isinstance(numero_brut, int):
            numero = numero_brut
        elif isinstance(numero_brut, str):
            try:
                numero = int(numero_brut.strip())
            except ValueError:
                numero = None
        if numero is None:
            continue
        if numero in numeros_vus:
            continue  # doublon de "numero" -> on garde la première occurrence
        numeros_vus.add(numero)

        valeur_statut = element.get("statut")
        # PATCH v3 -- "abandonnee" reconnu au même titre que "termine" ;
        # tout le reste (absent, "en_attente", valeur inattendue) -> repli sûr sur "en_attente".
        if valeur_statut in ("termine", "abandonnee"):
            statut = valeur_statut
        else:
            statut = "en_attente"
        termine = statut == "termine"  # conservé pour compatibilité (cf. docstring TacheWorkspace)

        taches.append(TacheWorkspace(
            numero=numero, donnees=element, statut=statut, termine=termine,
            fichier_source=str(fichier_workspace),
        ))

    taches.sort(key=lambda t: t.numero)
    return taches


# ---------------------------------------------------------------------------
# ABANDON (PATCH v2, SPEC_patch_tasks_json.md section 1.2/6) : le
# multi-WORKSPACE chaîné (Task.workspaces en liste ordonnée d'entrées
# {"chemin": str, "actif": bool}, panneau flottant "Workspaces" avec
# cases à cocher/bouton "+"/import .txt) est ENTIÈREMENT SUPPRIMÉ. Un
# Task ne référence plus qu'UN SEUL fichier WORKSPACE
# (Task.workspace_fichier: str). cle_comparaison_chemin_workspace,
# dossiers_workspace_actifs et scanner_taches_workspaces_chaine
# n'ont donc plus lieu d'être et sont retirées : tout appelant qui les
# utilisait doit désormais appeler scanner_taches_workspace directement
# sur Task.workspace_fichier.
# ---------------------------------------------------------------------------

def stats_workspace(fichier_workspace: str) -> tuple:
    """Retourne (nb_termine, nb_attente, nb_abandonnee, nb_total) pour LE
    fichier WORKSPACE (PATCH v2 -- un seul fichier désormais, plus une
    liste de dossiers ; PATCH v3 -- ajout de nb_abandonnee) -- utilisé
    pour l'affichage du panneau (spec utilisateur : "on met les données
    sur le nombre de tâche traité et non traité").

    ATTENTION appelants existants : signature étendue par PATCH v3 (un
    élément de plus dans le tuple, inséré AVANT nb_total) -- tout code
    qui dépaquetait `nb_termine, nb_attente, nb_total = stats_workspace(...)`
    doit être mis à jour en `nb_termine, nb_attente, nb_abandonnee, nb_total = ...`."""
    taches = scanner_taches_workspace(fichier_workspace)
    nb_termine = sum(1 for t in taches if t.statut == "termine")
    nb_abandonnee = sum(1 for t in taches if t.statut == "abandonnee")
    nb_attente = len(taches) - nb_termine - nb_abandonnee
    return nb_termine, nb_attente, nb_abandonnee, len(taches)


def _numero_workspace_normalise(numero_brut):
    """Même règle que scanner_taches_workspace pour lire un "numero" : un
    int (jamais un bool) tel quel, une chaîne convertible proprement en
    int convertie, tout le reste -> None."""
    if isinstance(numero_brut, bool):
        return None
    if isinstance(numero_brut, int):
        return numero_brut
    if isinstance(numero_brut, str):
        try:
            return int(numero_brut.strip())
        except ValueError:
            return None
    return None


def ecrire_statut_tache_workspace(tache: "TacheWorkspace", statut) -> bool:
    """Modifie le champ `"statut"` d'UNE tâche DIRECTEMENT DANS le tableau
    JSON du fichier WORKSPACE partagé (PATCH v2, SPEC_patch_tasks_json.md
    section 4 -- spec section 5.3 d'origine, marquage manuel "Marquer
    terminé"/"Marquer en attente" ; PATCH v3 -- "Marquer abandonnée").

    PATCH v3 (demande explicite utilisateur : "on vas ajouter un 3eme :
    abandonee") -- CHANGEMENT DE SIGNATURE : le second paramètre
    s'appelait `termine: bool` (True/False -- seulement 2 statuts
    possibles) ; il accepte désormais SOIT un `bool` (rétrocompatible :
    True -> "termine", False -> "en_attente", comme avant), SOIT
    directement une `str` parmi STATUTS_TACHE_WORKSPACE ("termine" /
    "en_attente" / "abandonnee") pour choisir explicitement le nouveau
    statut. Tout appelant existant qui passait un bool continue de
    fonctionner À L'IDENTIQUE (aucune migration nécessaire) ; seul un
    appelant qui veut marquer "abandonnee" doit passer la chaîne
    explicitement, un bool ne pouvant représenter que 2 états.

    CONTRAINTE ESSENTIELLE, plus stricte qu'avant le patch v2 puisque
    TOUTES les tâches d'un même fichier WORKSPACE partagent maintenant le
    MÊME fichier physique : il faut relire le tableau entier, ne modifier
    que le "statut" de l'entrée dont "numero" correspond à `tache.numero`
    (en préservant tous ses autres champs ET tous les autres éléments du
    tableau intacts), puis réécrire le fichier entier.

    Repli défensif si la relecture échoue (fichier absent, illisible,
    JSON invalide, racine pas une liste -- cas limite puisque le fichier
    vient normalement d'être scanné avec succès juste avant, mais peut
    avoir changé sous les pieds entretemps) : repart d'une liste ne
    contenant QUE `tache.donnees` mis à jour, plutôt que de faire échouer
    l'écriture -- au prix, dans ce cas précis, de perdre potentiellement
    les AUTRES tâches du fichier si celui-ci était réellement corrompu.
    Ce risque est documenté (SPEC_patch_tasks_json.md section 4) et
    volontairement non masqué : mieux vaut préserver la tâche en cours
    que la perdre silencieusement.

    Si l'entrée `tache.numero` n'est plus retrouvée dans le tableau relu
    (supprimée entretemps par une autre écriture concurrente) : ajoutée
    en fin de tableau avec son statut à jour plutôt que d'échouer
    silencieusement (repli sûr, cohérent avec le reste du module).

    AUCUN verrou de concurrence entre profils à ce stade (cf.
    SPEC_patch_tasks_json.md section 4.1 -- deux écritures presque
    simultanées sur le même fichier peuvent se marcher dessus, "dernier
    écrivain gagne") : à ajouter séparément si des pertes de statut sont
    observées en usage réel avec plusieurs profils actifs simultanément.

    Retourne True si l'écriture a réussi, False sinon (fichier supprimé
    entretemps, disque plein, permissions, etc.) -- jamais d'exception
    levée, comme avant."""
    if isinstance(statut, bool):
        valeur = "termine" if statut else "en_attente"  # rétrocompatibilité -- cf. docstring ci-dessus
    elif statut in STATUTS_TACHE_WORKSPACE:
        valeur = statut
    else:
        valeur = "en_attente"  # repli sûr sur valeur inattendue, cohérent avec scanner_taches_workspace
    chemin = Path(tache.fichier_source)
    try:
        brut = json.loads(chemin.read_text(encoding="utf-8"))
        if not isinstance(brut, list):
            brut = []
    except (OSError, json.JSONDecodeError, UnicodeDecodeError):
        brut = []  # repli défensif -- cf. docstring ci-dessus

    donnees_a_jour = dict(tache.donnees)
    donnees_a_jour["statut"] = valeur

    trouve = False
    for i, element in enumerate(brut):
        if not isinstance(element, dict):
            continue
        # Comparaison tolérante sur le type : scanner_taches_workspace accepte
        # un "numero" écrit en chaîne ("12") et le convertit en int ; sans cette
        # normalisation, une tâche à numero-chaîne ne serait jamais retrouvée
        # ici (int != str) et serait dupliquée en fin de tableau.
        if _numero_workspace_normalise(element.get("numero")) == tache.numero:
            # FUSION au lieu de remplacement (AJOUT, exclusion de champs) :
            # `tache.donnees` peut avoir été amputé de champs exclus avant
            # injection dans LIST_TASKS. Remplacer l'entrée du fichier par
            # cette version amputée effacerait ces champs du disque. On
            # repart donc de l'entrée réelle du fichier et on n'y applique
            # que les clés effectivement présentes dans `donnees_a_jour`
            # (le statut, plus toute modification voulue du script).
            fusion = dict(element)
            fusion.update(donnees_a_jour)
            brut[i] = fusion
            trouve = True
            break
    if not trouve:
        brut.append(donnees_a_jour)

    try:
        chemin.write_text(json.dumps(brut, ensure_ascii=False), encoding="utf-8")
        return True
    except OSError:
        return False


# AJOUT (demande explicite utilisateur : "lors de l'attribution de task dans
# les notebook on puisse exclure certains champs") -- clés JAMAIS retirables
# de `donnees`, quoi que l'utilisateur saisisse : sans "numero", plus moyen
# de retrouver la tâche à réécrire ; sans "statut", marquer_tache_terminee /
# marquer_tache_en_attente n'auraient plus rien à mettre à jour de fiable.
CHAMPS_WORKSPACE_NON_EXCLUABLES = ("numero", "statut")


def normaliser_champs_exclus(valeur) -> list:
    """Nettoie une valeur quelconque en liste de noms de champs à exclure :
    accepte une liste OU une chaîne « a, b ; c » (séparateurs : virgule,
    point-virgule, retour ligne) ; ignore tout ce qui n'est pas une chaîne
    non vide, retire les espaces, supprime les doublons en gardant l'ordre,
    et écarte les champs non excluables (CHAMPS_WORKSPACE_NON_EXCLUABLES).
    Ne lève jamais d'exception -- repli sûr : liste vide (= rien exclu)."""
    if isinstance(valeur, str):
        morceaux = re.split(r"[,;\n]", valeur)
    elif isinstance(valeur, (list, tuple, set)):
        morceaux = list(valeur)
    else:
        return []
    resultat: list = []
    for m in morceaux:
        if not isinstance(m, str):
            continue
        nom = m.strip()
        if not nom or nom in CHAMPS_WORKSPACE_NON_EXCLUABLES or nom in resultat:
            continue
        resultat.append(nom)
    return resultat


def donnees_sans_champs_exclus(donnees: dict, champs_exclus) -> dict:
    """Copie de `donnees` privée des clés de `champs_exclus` (jamais
    "numero"/"statut"). Ne modifie PAS `donnees` (qui est l'objet lu du
    fichier WORKSPACE) : la copie est superficielle, suffisante puisqu'on
    ne fait que retirer des clés de premier niveau. Si rien n'est exclu,
    retourne `donnees` tel quel (aucune copie inutile)."""
    exclus = normaliser_champs_exclus(champs_exclus)
    if not exclus:
        return donnees
    return {k: v for k, v in donnees.items() if k not in exclus}


def repartir_taches_workspace(
    taches_en_attente: list, cles_profils: list, mode: str, nombre_fixe: int = 1,
    champs_exclus=None,
) -> dict:
    """Algorithme de répartition (spec section 6). `taches_en_attente` doit
    déjà être filtrée (seulement les TacheWorkspace au statut "en_attente"
    -- PATCH v3 : NI terminées NI abandonnées, cf. TacheWorkspace.
    en_attente) et triée par N croissant (cf. scanner_taches_workspace,
    qui trie déjà -- un appelant qui filtre ensuite sur `t.en_attente`
    préserve cet ordre).
    `cles_profils` est l'ordre d'affichage du panneau clone (spec section
    6 : "profils dans l'ordre d'affichage du panneau").

    Retourne un dict {cle_profil: [tache_pour_LIST_TASKS...]} -- SEULEMENT
    les profils ayant reçu au moins une tâche apparaissent dans ce dict
    (cf. docstring de ExecutionCloneEtat.workspace_attribution, absence ==
    liste vide côté injection). Une tâche donnée n'apparaît jamais dans
    deux listes différentes du résultat (spec section 6, dernier
    paragraphe).

    `mode` : "fixe" (chaque profil reçoit au plus `nombre_fixe` tâches,
    dans l'ordre, tâches excédentaires non distribuées) ou "relatif"
    (toutes les tâches en attente réparties le plus équitablement
    possible, restes distribués un par un aux premiers profils).

    PATCH v2 (SPEC_patch_tasks_json.md section 5) : chaque élément de la
    liste retournée par profil n'est plus un simple chemin (str) -- c'est
    devenu un dict {"donnees": ..., "fichier_source": ...}. PATCH v4
    (demande explicite utilisateur : plus de path du WORKSPACE en fin de
    liste, l'utilisateur le fournit lui-même dans son code) : chaque
    élément est désormais DIRECTEMENT le dict `donnees` (fichier_source
    n'est plus embarqué du tout) -- directement la forme injectée dans
    LIST_TASKS (renommée depuis WORKSPACE) côté script du Task. ABANDON du
    multi-WORKSPACE chaîné : `taches_en_attente` provient désormais d'un
    seul scanner_taches_workspace (plus de scanner_taches_workspaces_chaine,
    supprimée) -- cette fonction n'a de toute façon jamais fait de
    distinction sur l'origine des tâches qu'elle reçoit.

    AJOUT (`champs_exclus`, demande explicite utilisateur) : noms de clés
    retirées de `donnees` dans chaque élément injecté dans LIST_TASKS (le
    script ne les voit donc pas). "numero" et "statut" ne sont jamais
    retirés. Appliqué ICI, à la source unique de fabrication des éléments :
    tous les chemins qui lisent ensuite workspace_attribution (exécution
    locale, mode réseau, affichage de cellule_variables) héritent du filtre
    sans modification. Le FICHIER WORKSPACE n'est jamais touché par ce
    filtre (cf. ecrire_statut_tache_workspace, qui fusionne au lieu de
    remplacer pour ne pas effacer les champs exclus du disque)."""
    resultat: dict = {}
    # GARDE-FOU (PATCH v3, demande explicite utilisateur : "lorsque une
    # task est abandonee elle doit etre ignorer lors de la repartition
    # de tache [...] rassure toi que cest comme sa que sa fontionne dans
    # la fontion qui attribue") -- re-filtre ICI, à l'intérieur même de
    # la fonction, plutôt que de faire confiance uniquement aux deux
    # appelants (_effectuer_attribution_workspace et _sur_clic_attribuer)
    # qui filtrent déjà en amont sur `t.en_attente`. Défense en
    # profondeur : même si un appelant futur oubliait de filtrer, ou
    # passait par erreur une TacheWorkspace "termine"/"abandonnee", elle
    # ne sera JAMAIS distribuée à un profil -- une tâche abandonnée est
    # définitivement écartée de l'attribution, pas juste "non prioritaire".
    taches_en_attente = [t for t in taches_en_attente if t.en_attente]
    if not cles_profils or not taches_en_attente:
        return resultat

    # PATCH v4 (demande explicite utilisateur : "je ne veux plus que ça
    # mette le path du workspace json à la fin de la liste" -- l'utilisateur
    # fournit lui-même ce chemin dans son propre code, cf. marquer_tache_
    # terminee(tache, fichier_source) plus bas) -- chaque élément de LIST_TASKS
    # est désormais DIRECTEMENT le dict `donnees` de la tâche (plus le wrapper
    # {"donnees": ..., "fichier_source": ...} du PATCH v2). `fichier_source`
    # (t.fichier_source) n'est donc plus embarqué du tout dans les éléments
    # renvoyés par cette fonction.
    elements = [
        donnees_sans_champs_exclus(t.donnees, champs_exclus)
        for t in taches_en_attente
    ]

    if mode == "fixe":
        n = max(1, int(nombre_fixe))
        curseur = 0
        for cle_profil in cles_profils:
            part = elements[curseur:curseur + n]
            curseur += n
            if part:
                resultat[cle_profil] = part
            if curseur >= len(elements):
                break
        # Tâches restantes au-delà de n * len(cles_profils) : non
        # distribuées (spec section 6), simplement ignorées ici -- elles
        # restent "en_attente" sur disque, candidates à la prochaine
        # attribution.
    else:  # "relatif"
        nb_profils = len(cles_profils)
        base, reste = divmod(len(elements), nb_profils)
        curseur = 0
        for indice, cle_profil in enumerate(cles_profils):
            taille = base + (1 if indice < reste else 0)
            part = elements[curseur:curseur + taille]
            curseur += taille
            if part:
                resultat[cle_profil] = part

    return resultat


# PATCH (bibliothèques externes embarquées côté PILOTE) -- une cellule déclare une bibliothèque par un simple commentaire :
#     # IMPORT: D:/Dossier/ma_lib.py
# Au moment d'ENVOYER le code (moteurs MoteurExecutionCellule et MoteurExecutionCelluleReseau, point commun `lancer`), le pilote lit ce
# fichier sur SON disque et en préfixe le code envoyé par UNE ligne qui recrée le module (sys.modules). Le code part donc EN UN SEUL
# BLOC : l'exécutant (sAutoniax cloud/clone ou local) n'a rien à redemander au PC et n'a besoin d'AUCUNE mise à jour. La cellule écrit
# ensuite normalement `from ma_lib import ma_fonction` (nom du module = nom du fichier sans .py). Sans directive : code strictement
# inchangé. Fichier illisible : la cellule échoue avec une ImportError explicite (jamais en silence).
# PATCH (importer depuis un notebook enregistré) -- la directive accepte désormais, en plus d'un fichier .py, un fichier
# notebook AutoniaX exporté :
#     # IMPORT: D:/Exports/mon_notebook.autoniaxtask
# Le nom du module = nom du fichier sans extension (caractères invalides remplacés par « _ » : « Mon Notebook.autoniaxtask »
# devient `Mon_Notebook`). Pour ne PAS rejouer les effets de bord du notebook (clics, navigation...), seuls les éléments
# DÉFINISSANTS des cellules ACTIVES sont repris : import, def, async def, class, et affectations de constantes littérales.
# Toute autre instruction de haut niveau (appel de fonction, boucle, print...) est ignorée. Les directives `# IMPORT:`
# présentes dans le notebook importé sont résolues récursivement (import circulaire détecté -> ImportError explicite).
_RE_DIRECTIVE_IMPORT_BIBLIOTHEQUE = re.compile(r"^[ \t]*#[ \t]*(?:IMPORT|BIBLIOTHEQUE|LIBRAIRIE)[ \t]*:[ \t]*(.+?)[ \t]*$", re.IGNORECASE | re.MULTILINE)
_MARQUEUR_BIBLIOTHEQUE_EMBARQUEE = "# [AutoniaX] bibliotheque embarquee : "
_EXTENSION_NOTEBOOK_IMPORTABLE = ".autoniaxtask"
_EXTENSIONS_BIBLIOTHEQUE = (".py", _EXTENSION_NOTEBOOK_IMPORTABLE)


# PATCH (section « Lib » de TaskConfig) -- fichiers Python purs stockés DANS project.json (Project.libs). Registre {nom: code}
# rafraîchi à chaque chargement/sauvegarde du Project et à chaque modification d'une lib. Une cellule les importe par
#     # IMPORT: nom_de_la_lib
# (sans chemin ni extension), puis `from nom_de_la_lib import ma_fonction`. Mêmes règles que pour un .py sur disque.
_LIBS_PROJET: dict = {}

# DÉSACTIVÉ (demande utilisateur) : les imports par commentaire `# IMPORT: ...` (fichier .py, .autoniaxtask ou nom de lib) ne sont
# plus lus. Seules les libs importées via le bouton + de la bande Lib du Task (Task.libs_importees) sont embarquées.
# Remettre True pour réactiver l'ancien comportement.
_IMPORTS_PAR_COMMENTAIRE_ACTIFS = False


def _rafraichir_registre_libs(projet) -> None:
    _LIBS_PROJET.clear()
    for lib in (getattr(projet, "libs", None) or []):
        if isinstance(lib, dict) and lib.get("nom"):
            _LIBS_PROJET[lib["nom"]] = lib.get("code") or ""


def _nom_lib_projet(valeur: str):
    """Nom de la lib du projet désignée par une directive `# IMPORT:` (nom nu, « .py » toléré), sinon None."""
    if not valeur or "/" in valeur or "\\" in valeur:
        return None
    nom = valeur[:-3] if valeur.lower().endswith(".py") else valeur
    return nom if nom in _LIBS_PROJET else None


def _source_module_depuis_autoniaxtask(chemin: str) -> tuple:
    """Lit un fichier .autoniaxtask et retourne (source_module, directives_imbriquees) : le code des seules définitions
    (import/def/class/constantes littérales) des cellules actives, et les lignes `# IMPORT:` trouvées dans ces cellules.
    Lève ValueError (message explicite) si le fichier n'est pas un notebook AutoniaX valide, si une cellule active a une
    erreur de syntaxe, ou s'il ne contient rien d'importable."""
    with open(chemin, "r", encoding="utf-8-sig") as f:
        donnees = json.load(f)
    if not isinstance(donnees, dict) or donnees.get("format_fichier") != "autoniax_task":
        raise ValueError("ce fichier n'est pas un notebook AutoniaX (format non reconnu)")
    brut_task = donnees.get("task")
    if not isinstance(brut_task, dict):
        raise ValueError("section « task » manquante ou corrompue")
    morceaux = []
    directives = []
    for indice, cellule in enumerate(brut_task.get("cellules") or [], start=1):
        if not isinstance(cellule, dict) or cellule.get("active", True) is False:
            continue
        code_cellule = cellule.get("code") or ""
        if not code_cellule.strip():
            continue
        for m in _RE_DIRECTIVE_IMPORT_BIBLIOTHEQUE.finditer(code_cellule):
            ligne = m.group(0).strip()
            if ligne not in directives:
                directives.append(ligne)
        try:
            arbre = ast.parse(code_cellule)
        except SyntaxError as err:
            raise ValueError(f"cellule n°{indice} : erreur de syntaxe ligne {err.lineno} ({err.msg})")
        for noeud in arbre.body:
            garder = isinstance(noeud, (ast.Import, ast.ImportFrom, ast.FunctionDef, ast.AsyncFunctionDef, ast.ClassDef))
            if not garder and isinstance(noeud, (ast.Assign, ast.AnnAssign)) and noeud.value is not None:
                try:
                    ast.literal_eval(noeud.value)
                    garder = True
                except (ValueError, TypeError, SyntaxError, MemoryError, RecursionError):
                    pass
            if garder:
                morceaux.append(ast.unparse(noeud))
    if not morceaux:
        raise ValueError("aucune fonction, classe, import ou constante trouvé dans les cellules actives")
    return "\n\n".join(morceaux) + "\n", directives


def embarquer_bibliotheques_dans_code(code: str, _pile: tuple = (), libs_supplementaires=None) -> str:
    if not code or _MARQUEUR_BIBLIOTHEQUE_EMBARQUEE in code:
        return code
    chemins = []
    for n in (libs_supplementaires or ()):
        if _nom_lib_projet(n) and n not in chemins:
            chemins.append(n)
    for m in (_RE_DIRECTIVE_IMPORT_BIBLIOTHEQUE.finditer(code) if _IMPORTS_PAR_COMMENTAIRE_ACTIFS else ()):
        c = m.group(1).strip().strip('"').strip("'").strip()
        if (c.lower().endswith(_EXTENSIONS_BIBLIOTHEQUE) or _nom_lib_projet(c)) and c not in chemins \
                and (_nom_lib_projet(c) or c) not in chemins:
            chemins.append(c)
    if not chemins:
        return code
    prefixe = ""
    for chemin in chemins:
        nom_lib = _nom_lib_projet(chemin)
        est_notebook = nom_lib is None and chemin.lower().endswith(_EXTENSION_NOTEBOOK_IMPORTABLE)
        nom = nom_lib or os.path.splitext(os.path.basename(chemin.replace("\\", "/")))[0]
        if est_notebook:
            nom = re.sub(r"\W", "_", nom)
            if nom and nom[0].isdigit():
                nom = "_" + nom
        prefixe_imbrique = ""
        try:
            if not nom.isidentifier():
                raise ValueError(f"« {nom} » n'est pas un nom de module valide (renommez le fichier)")
            if est_notebook:
                cle = os.path.normcase(os.path.abspath(chemin))
                if cle in _pile:
                    raise ValueError("import circulaire entre notebooks")
                source, directives = _source_module_depuis_autoniaxtask(chemin)
                if directives:
                    prefixe_imbrique = embarquer_bibliotheques_dans_code("\n".join(directives) + "\n", _pile + (cle,))
                    if prefixe_imbrique.endswith("\n".join(directives) + "\n"):
                        prefixe_imbrique = prefixe_imbrique[: -len("\n".join(directives) + "\n")]
            elif nom_lib:
                cle = "lib:" + nom_lib
                if cle in _pile:
                    raise ValueError("import circulaire entre libs")
                source = _LIBS_PROJET[nom_lib]
                directives = [m.group(0).strip() for m in _RE_DIRECTIVE_IMPORT_BIBLIOTHEQUE.finditer(source)] if _IMPORTS_PAR_COMMENTAIRE_ACTIFS else []
                if directives:
                    prefixe_imbrique = embarquer_bibliotheques_dans_code("\n".join(directives) + "\n", _pile + (cle,))
                    if prefixe_imbrique.endswith("\n".join(directives) + "\n"):
                        prefixe_imbrique = prefixe_imbrique[: -len("\n".join(directives) + "\n")]
                chemin = f"<lib:{nom_lib}>"
            else:
                with open(chemin, "r", encoding="utf-8-sig") as f:
                    source = f.read()
            if len(source) > 2_000_000:
                raise ValueError("fichier trop gros (> 2 Mo)")
            compile(source, chemin, "exec")
            log_cellule.info(f"[bibliotheque] « {nom} » embarquée depuis {chemin} ({len(source)} caractères)")
        except Exception as err:
            log_cellule.warning(f"[bibliotheque] {chemin} : {err!r}")
            message = f"bibliothèque « {chemin} » illisible côté pilote : {err.__class__.__name__}: {err}"
            prefixe += _MARQUEUR_BIBLIOTHEQUE_EMBARQUEE + nom + " (ECHEC)\n" + f"raise ImportError({message!r})\n"
            continue
        prefixe += prefixe_imbrique + (
            _MARQUEUR_BIBLIOTHEQUE_EMBARQUEE + nom + "\n"
            "import sys as _s_bib, types as _t_bib; "
            f"_m_bib = _t_bib.ModuleType({nom!r}); _m_bib.__file__ = {chemin!r}; _s_bib.modules[{nom!r}] = _m_bib; "
            f"exec(compile({source!r}, {chemin!r}, 'exec'), _m_bib.__dict__); del _s_bib, _t_bib, _m_bib\n"
        )
    return prefixe + code


def prefixer_code_avec_workspace(code: str, elements: list) -> str:
    """SPEC_workspace_attribution.md, section 8.2 -- mode réseau : le code
    de cellule_variables est envoyé TEL QUEL au sAutoniax distant, qui
    l'exécute dans SON PROPRE namespace (le pilote n'a ici AUCUN
    namespace partagé avec l'exécution réseau, contrairement au mode
    local où namespace["LIST_TASKS"] suffit -- cf. _lancer_sequence_
    clone_profil_local). Seule option : réécrire le TEXTE du code
    envoyé pour CE profil précis, en le préfixant d'une ligne de
    réassignation explicite `LIST_TASKS = [...]` -- la cellule_variables
    (qui pose LIST_TASKS = [] par défaut) s'exécute ENSUITE, dans le même
    exec() côté sAutoniax, donc écraserait une valeur ajoutée en SUFFIXE
    -- le préfixe, lui, est écrasé PAR le code envoyé si celui-ci
    réaffecte LIST_TASKS lui-même... MAIS cellule_variables ne fait
    justement QUE déclarer LIST_TASKS = [] tout en HAUT de son bloc
    (CODE_VARIABLES_DYNAMIQUES_DEFAUT), donc la vraie question est
    l'ORDRE : cette fonction préfixe le code de la cellule EN COURS
    D'ENVOI (cellule_variables la première fois, puis chaque cellule
    suivante de la séquence) -- si c'est cellule_variables elle-même qui
    est envoyée, son propre `LIST_TASKS = []` viendrait APRÈS le préfixe
    et l'écraserait de nouveau. Cf. docstring de l'appelant (_lancer_
    sequence_clone_profil) pour la résolution retenue : le préfixe n'est
    PAS ajouté à cellule_variables elle-même, seulement aux cellules
    SUIVANTES de la séquence (jamais la première) -- exactement le
    symétrique du mode local (cf. _lancer_sequence_clone_profil_local :
    réimposé APRÈS cellule_variables, jamais avant).

    `elements` : liste de dicts `donnees` DIRECTEMENT (PATCH v4 -- avant
    ce patch, PATCH v2, chaque élément était enveloppé dans
    {"donnees": ..., "fichier_source": ...} ; avant le PATCH v2, une
    liste de chemins str) déjà résolue pour ce profil
    (etat.workspace_attribution.get(cle_profil, [])). Utilise
    litteral_liste_taches, qui passe chaque valeur par repr() (pas une
    simple f-string entre guillemets) pour échapper correctement tout
    caractère spécial (apostrophe, backslash Windows, etc.) -- même
    précaution que n'importe quelle génération de code source Python à
    partir de données arbitraires."""
    # AJOUT (transfert de fichiers ALLER, cf. bloc "TRANSFERT DE FICHIERS"
    # plus bas) -- SEUL endroit où les fichiers sont embarqués en base64 :
    # ce texte est celui réellement ENVOYÉ au sAutoniax. litteral_liste_
    # taches (partagée avec l'AFFICHAGE, cf. code_variables_avec_
    # workspace_affiche) reste volontairement inchangée -- l'éditeur ne
    # doit jamais montrer des mégaoctets de base64. Le bloc de décodage
    # CODE_DECODAGE_FICHIERS_LIST_TASKS suit immédiatement l'affectation,
    # AVANT le code utilisateur, pour que celui-ci voie déjà des chemins
    # locaux valides dans LIST_TASKS. Sans fichier embarqué (aucun champ
    # ne ressemble à un chemin de fichier existant) le bloc est un no-op :
    # on l'omet alors, pour que le texte envoyé reste RIGOUREUSEMENT
    # identique à l'ancien comportement dans le cas courant.
    elements_a_envoyer = embarquer_fichiers_dans_taches(
        elements, lambda msg: log_cellule.warning(f"[LIST_TASKS][fichiers] {msg}"),
    )
    prefixe = "LIST_TASKS = " + litteral_liste_taches(elements_a_envoyer) + "\n"
    if CLE_MARQUEUR_FICHIER_EMBARQUE in prefixe:
        prefixe += CODE_DECODAGE_FICHIERS_LIST_TASKS
    return prefixe + code


# AJOUT (demande explicite utilisateur, suite à SPEC_workspace_
# attribution.md) : l'attribution WORKSPACE modifiait déjà réellement
# l'exécution (namespace local injecté / code préfixé en réseau, cf.
# prefixer_code_avec_workspace ci-dessus), mais le code AFFICHÉ dans le
# widget de la cellule "# Variable dynamique" restait volontairement
# celui écrit par l'utilisateur (LIST_TASKS = [] par défaut), jamais
# modifié -- cf. cellule_temp = TaskCellule(..., code=cellule_reelle.code,
# ...) dans _callback_termine (local ET réseau), qui recopiait
# systématiquement le code SOURCE, pas le code réellement exécuté.
# Décision explicite : pour CETTE cellule précise (cellule_variables
# uniquement -- jamais les cellules suivantes, qui n'ont pas de raison
# de voir leur propre code réécrit), le code affiché après exécution
# doit montrer la vraie liste attribuée à CE profil, pour un retour
# visuel fidèle à ce qui s'est réellement passé.
#
# CORRECTIF (revue de bout en bout) : l'ancienne implémentation
# remplaçait la LIGNE ENTIÈRE via une simple regex `^([ \t]*)WORKSPACE\s*
# =.*$`, ce qui avait trois défauts réels :
#   1. le commentaire de fin de ligne de CODE_VARIABLES_DYNAMIQUES_DEFAUT
#      ("# liste des tâches attribuées à ce profil...") était purement et
#      simplement effacé de l'affichage ;
#   2. du coup, même avec une attribution VIDE, le code affiché différait
#      du code source -- impossible de détecter "rien à afficher de
#      spécial" par simple égalité, ce dont dépend le mécanisme
#      d'affichage cosmétique de TaskCelluleWidget.definir_code_affiche ;
#   3. `\s*` pouvait franchir un saut de ligne (`\s` inclut `\n`), et
#      `WORKSPACE ==` / `WORKSPACE +=` n'étaient pas exclus.
# La nouvelle version isole INDENTATION / VALEUR / COMMENTAIRE et ne
# réécrit QUE la valeur.
#
# RENOMMAGE (PATCH v2, SPEC_patch_tasks_json.md section 6) : la variable
# de script devient LIST_TASKS (WORKSPACE désignait auparavant à la fois
# la variable ET le fichier/dossier source -- ambigu depuis que le
# fichier WORKSPACE contient désormais un TABLEAU de tâches). La regex,
# la fonction de localisation et toutes les fonctions de ce bloc suivent
# ce renommage.
_REGEX_AFFECTATION_LIST_TASKS = re.compile(r"^([ \t]*)LIST_TASKS[ \t]*=(?!=)", re.MULTILINE)


def _position_debut_commentaire_python(fragment: str) -> int:
    """Retourne l'index du premier `#` de `fragment` qui démarre
    RÉELLEMENT un commentaire Python, c'est-à-dire hors de toute chaîne
    littérale -- ou -1 s'il n'y en a aucun. `fragment` est toujours une
    portion d'UNE SEULE ligne (pas de triple-quote à gérer).

    Nécessaire parce qu'une valeur de tâche (chemin de fichier_source,
    champ métier libre, etc.) peut parfaitement contenir un `#` (ex.
    `'D:\\...\\lot#2\\mega.json'`) : un simple `fragment.find("#")`
    couperait alors la valeur en plein milieu d'une chaîne et produirait
    un code affiché syntaxiquement cassé."""
    quote = ""
    i = 0
    taille = len(fragment)
    while i < taille:
        c = fragment[i]
        if quote:
            if c == "\\":
                i += 2
                continue
            if c == quote:
                quote = ""
        elif c in ("'", '"'):
            quote = c
        elif c == "#":
            return i
        i += 1
    return -1


def _localiser_affectation_list_tasks(code: str):
    """Localise la PREMIÈRE ligne de `code` qui affecte LIST_TASKS.

    Retourne None si aucune (cas explicitement prévu : l'utilisateur est
    libre de supprimer la déclaration de son propre code, cf.
    SPEC_workspace_attribution.md section 2 -- repli silencieux partout),
    sinon le tuple (debut_ligne, fin_ligne, indentation, valeur,
    commentaire) où `commentaire` inclut les blancs qui le séparaient de
    la valeur, pour que l'alignement d'origine soit conservé tel quel."""
    match = _REGEX_AFFECTATION_LIST_TASKS.search(code)
    if match is None:
        return None
    debut_ligne = match.start()
    fin_ligne = code.find("\n", match.end())
    if fin_ligne == -1:
        fin_ligne = len(code)
    reste = code[match.end():fin_ligne]
    position_diese = _position_debut_commentaire_python(reste)
    if position_diese == -1:
        return (debut_ligne, fin_ligne, match.group(1), reste.strip(), "")
    avant_diese = reste[:position_diese]
    blancs = avant_diese[len(avant_diese.rstrip()):]
    return (
        debut_ligne, fin_ligne, match.group(1),
        avant_diese.strip(), blancs + reste[position_diese:],
    )


def litteral_liste_taches(elements: list) -> str:
    """Rend une liste de tâches (PATCH v4 -- chaque élément DIRECTEMENT
    un dict de champs métier ; PATCH v2, SPEC_patch_tasks_json.md section
    5, chaque élément était un dict {"donnees": dict, "fichier_source":
    str}) sous forme de littéral Python. Utilise repr() sur le dict
    COMPLET de chaque élément (pas une construction manuelle champ par
    champ) : repr() d'un dict Python échappe correctement, récursivement,
    toute chaîne imbriquée (apostrophes, backslashes Windows, guillemets
    ou `#` dans un champ métier, etc.) -- même précaution que
    litteral_liste_chemins (v1) sur un type de données plus riche.
    Source unique partagée par prefixer_code_avec_workspace (mode
    réseau, texte réellement envoyé) et
    code_variables_avec_workspace_affiche (affichage), pour que les deux
    montrent TOUJOURS exactement la même chose."""
    return "[" + ", ".join(repr(e) for e in elements) + "]"


def remplacer_valeur_list_tasks(code: str, nouvelle_valeur: str) -> str:
    """Retourne une COPIE de `code` où la VALEUR de la première
    affectation de LIST_TASKS est remplacée par `nouvelle_valeur` (texte
    Python déjà rendu). L'indentation ET le commentaire de fin de ligne
    sont conservés à l'identique ; aucune autre ligne n'est touchée. Si
    aucune affectation n'est trouvée, `code` est retourné inchangé."""
    localisation = _localiser_affectation_list_tasks(code)
    if localisation is None:
        return code
    debut, fin, indentation, _valeur, commentaire = localisation
    return (
        code[:debut] + indentation + "LIST_TASKS = " + nouvelle_valeur
        + commentaire + code[fin:]
    )


def valeur_list_tasks_dans_code(code: str):
    """Retourne le TEXTE de la valeur affectée à LIST_TASKS (sans le
    commentaire de fin de ligne), ou None si LIST_TASKS n'est affectée
    nulle part dans `code`."""
    localisation = _localiser_affectation_list_tasks(code)
    return None if localisation is None else localisation[3]


# =====================================================================
# TRANSFERT DE FICHIERS ALLER/RETOUR pilote <-> sAutoniax (LIST_TASKS /
# RESULT_OUTPUT / RESULT_SAVE_PATH) -- demande explicite utilisateur :
#   ALLER  : les champs de chaque élément de LIST_TASKS qui contiennent un
#            ou plusieurs "/" ou "\" sont des CHEMINS DE FICHIERS ; le
#            pilote les embarque (base64) dans le LIST_TASKS envoyé au
#            sAutoniax, qui les matérialise sur SON disque avant que le
#            script utilisateur ne lise LIST_TASKS -- le script continue
#            donc à faire tache["image_path"] sans rien changer (PATCH v4 :
#            plus de wrapper "donnees", chaque élément est directement le
#            dict de champs métier).
#            FICHIERS UNIQUEMENT pour l'instant (décision explicite : "bon
#            fichier uniquement pour l'instant") -- un dossier n'est
#            jamais embarqué, la valeur reste telle quelle.
#   RETOUR : le script du sAutoniax remplit la variable dynamique
#            RESULT_OUTPUT (JSON-isable : dict/list/str/nombre, OU chemin
#            d'un fichier -- image, json...). Le sAutoniax l'encode et la
#            renvoie ; le pilote la range sous le dossier RESULT_SAVE_PATH
#            (autre variable dynamique, chemin du PILOTE, choisi par
#            l'utilisateur). RESULT_SAVE_PATH n'est JAMAIS lu côté
#            sAutoniax : ce chemin n'existe que sur le disque du pilote.
#   TRAITEMENT DU RETOUR (SPEC_result_output_handler.md) : la fonction
#            RESULT_OUTPUT_HANDLER(valeur), pré-écrite dans la même
#            cellule "Variable dynamique", décide de tout (dossier, nom,
#            format...) -- exécutée côté PILOTE à la réception du résultat.
#            Quand elle est présente, RESULT_SAVE_PATH n'est plus lue ;
#            absente ou en erreur de syntaxe -> repli sur RESULT_SAVE_PATH.
# Même patron EXACT que RESULT_COLOR (cf. plus haut) : déclarées dans
# CODE_VARIABLES_DYNAMIQUES_DEFAUT, RESULT_OUTPUT réinitialisée en début
# de lot et lue à la fin (dernière cellule du lot uniquement).
# =====================================================================

# Placeholder posé par le pilote à la place d'un chemin de fichier ; le
# sAutoniax le reconnaît à cette clé et le remplace par le chemin LOCAL
# du fichier décodé (cf. CODE_DECODAGE_FICHIERS_LIST_TASKS).
CLE_MARQUEUR_FICHIER_EMBARQUE = "__fichier_embarque__"

# Garde-fous de taille -- alignés sur la contrainte RÉELLE documentée
# dans ClientServeurT.TAILLE_CHUNK_PROFIL_OCTETS (5 Mo) : max_size=None
# lève la limite de la lib websockets, mais le tunnel Cloudflare gratuit
# impose SES PROPRES limites de frame côté infrastructure, hors de notre
# contrôle -- 5 Mo bruts (~6,7 Mo en base64) par message est la valeur
# déjà éprouvée pour le transfert de profils. Un fichier plus gros n'est
# PAS embarqué (valeur laissée telle quelle + avertissement) plutôt que de
# risquer une coupure silencieuse de TOUTE la connexion au serveurT.
TAILLE_MAX_FICHIER_EMBARQUE_OCTETS = 5 * 1024 * 1024
# AJOUT (demande utilisateur : "augmente drastiquement cette limite") -- plafond PROPRE à envoyer_resultat (envoi en direct
# exécuteur -> pilote), indépendant du plafond d'embarquement ci-dessus (qui reste à 5 Mo pour pilote -> sAutoniax).
TAILLE_MAX_ENVOYER_RESULTAT_OCTETS = 64 * 1024 * 1024
# Plafond sur le TOTAL embarqué dans UN SEUL envoi (tous fichiers/tâches
# confondus) : le LIST_TASKS complet part dans un unique message WebSocket
# (cf. prefixer_code_avec_workspace), donc la somme compte, pas seulement
# chaque fichier. Au-delà, les fichiers restants ne sont plus embarqués
# (chemins laissés tels quels + avertissement).
TAILLE_MAX_TOTAL_EMBARQUE_OCTETS = 5 * 1024 * 1024


def _ressemble_a_un_chemin(valeur) -> bool:
    """Heuristique PUREMENT SYNTAXIQUE (demande explicite utilisateur :
    "les fichier ou dossier continetrond toujour un ou plusieru slash
    dans leur path") : une string qui contient "/" ou "\\" est candidate.
    Aucune vérification d'existence ici (cf. _embarquer_fichiers_donnees_
    tache, qui la fait ensuite) -- même fonction des deux côtés.

    Exclusion minimale d'un faux positif évident : une URL (http://,
    https://, ftp://, file:// ...) contient des "/" mais n'est pas un
    fichier local à transférer."""
    if not isinstance(valeur, str) or not valeur:
        return False
    if "/" not in valeur and "\\" not in valeur:
        return False
    if re.match(r"^[A-Za-z][A-Za-z0-9+.\-]*://", valeur):
        return False
    return True


def _embarquer_valeur_fichier(valeur, log_avertissement=None, budget=None):
    """Retourne le marqueur {CLE_MARQUEUR_FICHIER_EMBARQUE: True, "nom":
    ..., "contenu_b64": ...} si `valeur` est un chemin vers un FICHIER
    existant et de taille raisonnable ; `valeur` inchangée sinon (dossier,
    chemin inexistant, trop gros, illisible, budget total épuisé) --
    jamais d'exception, jamais un plantage de tout l'envoi pour une seule
    valeur (demande explicite : "logguer un avertissement plutôt que
    planter tout l'envoi"). `budget` : dict {"restant": octets} PARTAGÉ
    entre tous les appels d'un même envoi (cf. TAILLE_MAX_TOTAL_EMBARQUE_
    OCTETS), décrémenté à chaque fichier réellement embarqué."""
    if not _ressemble_a_un_chemin(valeur):
        return valeur
    try:
        p = Path(valeur)
        if not p.is_file():
            if log_avertissement is not None:
                log_avertissement(f"chemin non embarqué (fichier introuvable ou dossier) : {valeur!r}")
            return valeur
        taille = p.stat().st_size
        if taille > TAILLE_MAX_FICHIER_EMBARQUE_OCTETS:
            if log_avertissement is not None:
                log_avertissement(
                    f"chemin non embarqué (fichier > {TAILLE_MAX_FICHIER_EMBARQUE_OCTETS} octets) : {valeur!r}"
                )
            return valeur
        if budget is not None and taille > budget.get("restant", 0):
            if log_avertissement is not None:
                log_avertissement(
                    f"chemin non embarqué (plafond total de {TAILLE_MAX_TOTAL_EMBARQUE_OCTETS} octets "
                    f"par envoi atteint) : {valeur!r}"
                )
            return valeur
        encode = _encoder_fichiers_api2api([valeur])[0]
        if budget is not None:
            budget["restant"] = budget.get("restant", 0) - taille
    except (OSError, ValueError) as e:
        if log_avertissement is not None:
            log_avertissement(f"chemin non embarqué (erreur de lecture {e!r}) : {valeur!r}")
        return valeur
    return {
        CLE_MARQUEUR_FICHIER_EMBARQUE: True,
        "nom": encode["nom"], "contenu_b64": encode["contenu_b64"],
    }


def _embarquer_fichiers_recursif(valeur, log_avertissement=None, cache=None, budget=None):
    """Parcourt récursivement dict/list/tuple de `valeur` et remplace
    chaque string-chemin (cf. _ressemble_a_un_chemin) qui désigne un vrai
    fichier par son marqueur. `cache` (dict chemin -> marqueur) évite de
    relire/réencoder plusieurs fois le MÊME fichier référencé par
    plusieurs champs/tâches d'un même envoi."""
    if cache is None:
        cache = {}
    if isinstance(valeur, str):
        if valeur not in cache:
            cache[valeur] = _embarquer_valeur_fichier(valeur, log_avertissement, budget)
        return cache[valeur]
    if isinstance(valeur, dict):
        return {k: _embarquer_fichiers_recursif(v, log_avertissement, cache, budget) for k, v in valeur.items()}
    if isinstance(valeur, list):
        return [_embarquer_fichiers_recursif(v, log_avertissement, cache, budget) for v in valeur]
    if isinstance(valeur, tuple):
        return tuple(_embarquer_fichiers_recursif(v, log_avertissement, cache, budget) for v in valeur)
    return valeur


def embarquer_fichiers_dans_taches(elements: list, log_avertissement=None) -> list:
    """Point d'entrée côté PILOTE, appelé juste avant prefixer_code_avec_
    workspace (mode réseau uniquement) : retourne une COPIE de `elements`
    où chaque chemin de fichier trouvé est remplacé par son marqueur
    base64.

    PATCH v4 : `elements` est désormais une liste de dicts `donnees`
    DIRECTEMENT (plus le wrapper {"donnees": ..., "fichier_source": ...}
    du PATCH v2 -- fichier_source n'est plus embarqué dans LIST_TASKS du
    tout, cf. repartir_taches_workspace). Chaque élément est donc embarqué
    tel quel, sans distinction de clé. Ne modifie jamais `elements` en
    place."""
    cache: dict = {}
    budget = {"restant": TAILLE_MAX_TOTAL_EMBARQUE_OCTETS}
    resultat = []
    for element in elements:
        if isinstance(element, (dict, list)):
            resultat.append(_embarquer_fichiers_recursif(element, log_avertissement, cache, budget))
        else:
            resultat.append(element)
    return resultat


# Bloc de code INJECTÉ côté sAutoniax, juste après `LIST_TASKS = [...]` et
# avant le code utilisateur (cf. prefixer_code_avec_workspace) : décode
# chaque marqueur en vrai fichier sous get_temp_api2api_dir() (même
# mécanisme que _decoder_fichiers_api2api, réutilisé tel quel -- ces deux
# fonctions sont au niveau module, donc visibles depuis l'exécuteur) et
# réécrit le champ avec le chemin LOCAL. Généré comme TEXTE plutôt que
# fonction appelée directement : le code de cellule est exécuté par exec()
# dans un process exécuteur séparé, le préfixe doit donc être
# autosuffisant. Retire aussi les noms temporaires du namespace utilisateur.
CODE_DECODAGE_FICHIERS_LIST_TASKS = (
    # __autoniax_cache_fichiers_decodes : dict PERSISTANT dans le namespace
    # de l'exécuteur (qui vit tant que le process vit, cf. son docstring)
    # -- clé = (nom, empreinte du contenu base64), valeur = chemin local
    # déjà écrit. Chaque cellule du lot re-reçoit le même LIST_TASKS
    # préfixé (cf. prefixer_code_avec_workspace) ; sans ce cache, le MÊME
    # fichier serait ré-écrit sur disque à chaque cellule (N copies).
    "if \"__autoniax_cache_fichiers_decodes\" not in globals():\n"
    "    __autoniax_cache_fichiers_decodes = {}\n"
    "def __autoniax_decoder_fichiers(_v):\n"
    "    if isinstance(_v, dict):\n"
    "        if _v.get(\"" + CLE_MARQUEUR_FICHIER_EMBARQUE + "\") is True and \"contenu_b64\" in _v:\n"
    "            _cle = (_v.get(\"nom\"), hash(_v[\"contenu_b64\"]))\n"
    "            _chemin = __autoniax_cache_fichiers_decodes.get(_cle)\n"
    "            if _chemin is None or not os.path.isfile(_chemin):\n"
    "                _chemin = _decoder_fichiers_api2api([{\"nom\": _v.get(\"nom\"), \"contenu_b64\": _v[\"contenu_b64\"]}])[0]\n"
    "                __autoniax_cache_fichiers_decodes[_cle] = _chemin\n"
    "            return _chemin\n"
    "        return {_k: __autoniax_decoder_fichiers(_x) for _k, _x in _v.items()}\n"
    "    if isinstance(_v, list):\n"
    "        return [__autoniax_decoder_fichiers(_x) for _x in _v]\n"
    "    if isinstance(_v, tuple):\n"
    "        return tuple(__autoniax_decoder_fichiers(_x) for _x in _v)\n"
    "    return _v\n"
    "LIST_TASKS = __autoniax_decoder_fichiers(LIST_TASKS)\n"
    "del __autoniax_decoder_fichiers\n"
)


def _serialiser_result_output(valeur) -> Optional[dict]:
    """Côté EXÉCUTEUR/sAutoniax (fin de lot) : transforme la valeur finale
    de RESULT_OUTPUT en un dict JSON-sérialisable transportable par le
    protocole, ou None s'il n'y a rien à renvoyer (valeur None, "", [], {}
    -- l'état neutre de la variable dynamique).

    Trois formes, dans cet ordre :
      - str contenant "/" ou "\\" ET désignant un fichier existant (image,
        json...) -> {"type": "fichier", "nom": ..., "contenu_b64": ...}
        (même heuristique que l'aller, cf. _ressemble_a_un_chemin) ;
      - bytes/bytearray -> {"type": "fichier", "nom": "resultat.bin", ...} ;
      - tout le reste JSON-isable (dict/list/str/nombre/bool) ->
        {"type": "json", "valeur": ...}.
    Un objet non JSON-isable est converti par str() plutôt que de perdre
    silencieusement le résultat -- jamais d'exception vers l'appelant."""
    if valeur is None or valeur == "" or valeur == [] or valeur == {}:
        return None
    if isinstance(valeur, (bytes, bytearray)):
        return {
            "type": "fichier", "nom": "resultat.bin",
            "contenu_b64": base64.b64encode(bytes(valeur)).decode("ascii"),
        }
    if isinstance(valeur, str) and _ressemble_a_un_chemin(valeur):
        try:
            p = Path(valeur)
            if p.is_file():
                if p.stat().st_size > TAILLE_MAX_FICHIER_EMBARQUE_OCTETS:
                    return {"type": "erreur", "message": f"fichier résultat trop volumineux (> {TAILLE_MAX_FICHIER_EMBARQUE_OCTETS} octets) : {p.name}"}
                encode = _encoder_fichiers_api2api([valeur])[0]
                return {"type": "fichier", "nom": encode["nom"], "contenu_b64": encode["contenu_b64"]}
        except OSError as e:
            return {"type": "erreur", "message": f"lecture du fichier résultat impossible : {e!r}"}
    try:
        json.dumps(valeur)
        return {"type": "json", "valeur": valeur}
    except (TypeError, ValueError):
        return {"type": "json", "valeur": str(valeur)}


MARQUEUR_RESULTAT_LIVE = "AUTONIAX_RESULTAT_LIVE:"


def _fabriquer_envoyer_resultat(emetteur):
    """AJOUT (demande explicite utilisateur : \"je ne veux plus enregistrer
    uniquement quand un resultat est recu... pas attendre la fin complete
    d'execution d'un notebook\") -- fabrique la fonction `envoyer_resultat`
    exposée dans le namespace des Tasks. `emetteur(payload: dict) -> bool`
    transporte `payload` (même forme que _serialiser_result_output) jusqu'au
    PILOTE, TOUT DE SUITE, sans attendre la fin du lot ; le pilote le passe
    alors à RESULT_OUTPUT_HANDLER (ou, à défaut, à RESULT_SAVE_PATH), comme
    pour un RESULT_OUTPUT de fin de lot.

        envoyer_resultat(valeur)            # dict/liste/texte/nombre, ou chemin d'un fichier
        envoyer_resultat(contenu, nom="page.html")   # str/bytes = CONTENU d'un fichier

    Avec `nom`, `valeur` est le CONTENU (str encodé en UTF-8, ou bytes) : le
    handler reçoit le chemin d'une copie temporaire portant ce nom.
    Lève RuntimeError si le contenu dépasse TAILLE_MAX_ENVOYER_RESULTAT_OCTETS
    (limite du transport) ou si l'envoi est impossible -- jamais silencieux."""

    def envoyer_resultat(valeur, nom=None):
        if nom is not None:
            if isinstance(valeur, str):
                contenu = valeur.encode("utf-8")
            elif isinstance(valeur, (bytes, bytearray)):
                contenu = bytes(valeur)
            else:
                raise TypeError("envoyer_resultat(valeur, nom=...) : valeur doit être un str ou des bytes (contenu du fichier).")
            if len(contenu) > TAILLE_MAX_ENVOYER_RESULTAT_OCTETS:
                raise RuntimeError(
                    f"envoyer_resultat : contenu trop volumineux ({len(contenu)} octets, max "
                    f"{TAILLE_MAX_ENVOYER_RESULTAT_OCTETS}) -- découpez-le en plusieurs envois."
                )
            payload = {"type": "fichier", "nom": str(nom), "contenu_b64": base64.b64encode(contenu).decode("ascii")}
        else:
            payload = _serialiser_result_output(valeur)
            if payload is None:
                return
            if payload.get("type") == "erreur":
                raise RuntimeError(f"envoyer_resultat : {payload.get('message')}")
            if payload.get("type") == "json" and len(json.dumps(payload, ensure_ascii=False)) > TAILLE_MAX_ENVOYER_RESULTAT_OCTETS:
                raise RuntimeError(
                    f"envoyer_resultat : valeur trop volumineuse (max {TAILLE_MAX_ENVOYER_RESULTAT_OCTETS} octets) "
                    f"-- utilisez envoyer_resultat(contenu, nom=\"fichier.ext\") ou découpez-la."
                )
        if not emetteur(payload):
            raise RuntimeError("envoyer_resultat : connexion au pilote indisponible à cet instant -- rien n'a été envoyé.")

    return envoyer_resultat


# =====================================================================================================
# PONT PILOTE <-> CLONE (accès fichiers du PC pilote depuis le code d'un clone, EN COURS D'EXÉCUTION)
# -----------------------------------------------------------------------------------------------------
# But : le notebook d'un clone (Colab/Kaggle...) continue de lire/écrire ses fichiers EXACTEMENT comme avant
# (open(), os.listdir, os.open(O_EXCL) pour son verrou, os.replace, os.path.getmtime...) avec des chemins du PC
# pilote (« D:/... », « C:\... »). Le code du notebook n'est PAS modifié : côté clone, `os` et `open` de son
# espace de noms sont remplacés par des proxys qui envoient la demande au pilote ; le pilote l'exécute SUR SON
# DISQUE et renvoie la réponse.
#
# Chemin d'une demande   : clone -> (canal « image » déjà relayé, marqué MARQUEUR_PONT_REQUETE) -> serveurT -> pilote
# Chemin de la réponse   : pilote -> serveurT (« pont_pilote_reponse ») -> sAutoniax (process principal)
#                          -> serveur local (« pont_reponse_executeur ») -> process exécuteur -> appelant bloqué
#
# Robustesse :
#   * chaque demande porte un `rid` ; le clone la RENVOIE tant qu'aucune réponse n'arrive (message perdu) ; le
#     pilote mémorise la réponse par `rid` (dédoublonnage) : une opération non idempotente (création exclusive
#     d'un verrou, renommage, écriture) n'est JAMAIS exécutée deux fois ;
#   * écritures : envoyées par morceaux dans un fichier temporaire du pilote, vérifiées (taille + SHA-256) puis
#     substituées d'un bloc (os.replace) -- jamais de fichier à moitié écrit ;
#   * le pilote n'accepte QUE les chemins sous des racines autorisées (dossiers/fichiers cités dans le code du Task,
#     PILOTE_DOSSIERS_AUTORISES, variable d'environnement AUTONIAX_PONT_DOSSIERS) ;
#   * les erreurs du pilote sont rejouées côté clone comme les VRAIES exceptions (FileExistsError, FileNotFoundError,
#     PermissionError...) : le code du notebook (ex. son verrou) réagit comme en local ;
#   * l'horloge du PC et celle du clone diffèrent : os.path.getmtime() est ramené à l'horloge du CLONE (sinon
#     « verrou vieux de plus de 10 s » serait faux).
# =====================================================================================================
import ntpath as _ntpath_pont
import posixpath as _posixpath_pont
import builtins as _builtins_pont
import types as _types_pont
import stat as _stat_pont
import glob as _glob_pont
import pathlib as _pathlib_pont

MARQUEUR_PONT_REQUETE = "AUTONIAX_PONT_REQ:"

# =====================================================================================================
# [PONT-DIAG] DIAGNOSTIC LENTEUR DU PONT (affiché dans le terminal ET dans « Copier tous les logs »)
# Chaque demande d'un clone est suivie : 1/5 réception websocket -> 2/5 thread GUI -> 3/5 début d'exécution
# -> 4/5 fin d'exécution -> 5/5 réponse envoyée. Un renvoi du clone (même rid revu) est signalé.
# [GUI-DIAG] : si le thread de l'interface reste bloqué > 0,5 s, sa pile Python est affichée (= le coupable).
# =====================================================================================================
log_pont_diag = logging.getLogger("autoniax.pont_diag")
PONT_DIAG_DETAIL = (os.environ.get("AUTONIAX_PONT_DIAG") or "").strip().lower() in ("1", "oui", "true", "on")   # v7 : une ligne par appel = trop bruyant ; les RENVOIS/lenteurs restent journalisés


def _pont_diag_detail(message):
    if PONT_DIAG_DETAIL:
        log_pont_diag.info(message)
log_pont_diag.setLevel(logging.INFO)
_DIAG_PONT: dict = {}
_DIAG_PONT_VERROU = threading.Lock()
_RE_DIAG_RID_OP = re.compile(r'^\{"rid": "([0-9a-f]+)", "op": "([a-z_]+)"')


def _diag_pont_ws(charge: str):
    """Appelé dans le thread réseau (websocket) dès qu'une demande du pont arrive. Détecte les renvois."""
    try:
        m = _RE_DIAG_RID_OP.match(charge[:200])
        if not m:
            return
        rid, op = m.group(1), m.group(2)
        maintenant = time.time()
        with _DIAG_PONT_VERROU:
            e = _DIAG_PONT.get(rid)
            if e is None:
                _DIAG_PONT[rid] = {"t_ws": maintenant, "op": op, "n": 1}
                while len(_DIAG_PONT) > 400:
                    _DIAG_PONT.pop(next(iter(_DIAG_PONT)))
                _pont_diag_detail(f"[PONT-DIAG] 1/5 reçu websocket  op={op:<14} rid={rid[:8]} taille={len(charge)//1024} Ko")
            else:
                e["n"] += 1
                log_pont_diag.warning(
                    f"[PONT-DIAG] !! RENVOI #{e['n']-1} op={op} rid={rid[:8]} : {maintenant - e['t_ws']:.1f}s après la 1re réception "
                    f"-> le clone n'avait PAS reçu la réponse à temps")
    except Exception:
        pass


def _diag_pont_etape(rid, etiquette, extra=""):
    try:
        with _DIAG_PONT_VERROU:
            e = _DIAG_PONT.get(rid)
        if e is None:
            return
        _pont_diag_detail(f"[PONT-DIAG] {etiquette} op={e['op']:<14} rid={str(rid)[:8]} +{(time.time() - e['t_ws']) * 1000:.0f} ms depuis la réception {extra}")
    except Exception:
        pass


_GUI_DIAG = {"dernier": time.perf_counter(), "actif": False}


def _installer_gui_diag(app):
    """Surveille le thread GUI : si son event loop ne tourne plus pendant > 0,5 s, affiche sa pile Python."""
    if _GUI_DIAG["actif"]:
        return
    _GUI_DIAG["actif"] = True
    id_gui = threading.get_ident()
    minuteur = QTimer(app)
    minuteur.setInterval(50)

    def _battement():
        _GUI_DIAG["dernier"] = time.perf_counter()
    minuteur.timeout.connect(_battement)
    minuteur.start()
    _GUI_DIAG["minuteur"] = minuteur

    def _garde():
        gele_depuis, dernier_affichage = None, 0.0
        while True:
            time.sleep(0.2)
            retard = time.perf_counter() - _GUI_DIAG["dernier"]
            if retard > 0.5:
                if gele_depuis is None:
                    gele_depuis = time.perf_counter() - retard
                if time.perf_counter() - dernier_affichage > 2.0:
                    dernier_affichage = time.perf_counter()
                    cadre = sys._current_frames().get(id_gui)
                    pile = "".join(traceback.format_stack(cadre, limit=14)) if cadre is not None else "(pile introuvable)"
                    log_pont_diag.warning(f"[GUI-DIAG] thread GUI BLOQUÉ depuis {retard:.1f}s -- il exécute :\n{pile}")
            elif gele_depuis is not None:
                log_pont_diag.warning(f"[GUI-DIAG] thread GUI de nouveau libre après {time.perf_counter() - gele_depuis:.1f}s de blocage")
                gele_depuis = None
    threading.Thread(target=_garde, name="GuiDiagGarde", daemon=True).start()
    log_pont_diag.info("[GUI-DIAG] surveillance du thread GUI active (blocage > 0,5 s => pile affichée)")

TAILLE_MORCEAU_PONT = 96 * 1024                  # octets BRUTS par morceau (≈128 Ko en base64)
LECTURE_MAX_PONT = 2 * 1024 * 1024 * 1024        # garde-fou mémoire seulement (2 Go)
_RE_CHEMIN_PILOTE = re.compile(r"^(?:[A-Za-z]:[\\/]|\\\\)")
_NOMS_FLAGS_PONT = ("O_WRONLY", "O_RDWR", "O_CREAT", "O_EXCL", "O_TRUNC", "O_APPEND")


def chemin_est_pilote(chemin) -> bool:
    """Vrai pour un chemin « de PC Windows » (lecteur `D:/..`, `D:\\..` ou UNC `\\\\serveur\\..`). Sur le clone (Linux),
    de tels chemins n'ont aucun sens localement : c'est le signe qu'ils désignent le PC pilote."""
    return isinstance(chemin, str) and bool(_RE_CHEMIN_PILOTE.match(chemin))


def _flags_vers_noms(flags: int) -> list:
    noms = []
    if (flags & 3) == 1:
        noms.append("O_WRONLY")
    elif (flags & 3) == 2:
        noms.append("O_RDWR")
    for n in ("O_CREAT", "O_EXCL", "O_TRUNC", "O_APPEND"):
        v = getattr(os, n, 0)
        if v and (flags & v):
            noms.append(n)
    return noms


def _noms_vers_flags(noms) -> int:
    """Les valeurs numériques de O_CREAT/O_EXCL... DIFFÈRENT entre Linux et Windows : on échange des NOMS."""
    flags = getattr(os, "O_BINARY", 0)
    for n in noms:
        if n in _NOMS_FLAGS_PONT:
            flags |= getattr(os, n, 0)
    return flags


