    def envoyer_sautoniax_pret(self):
        """AJOUT (spec A.3, signal "sAutoniax prêt") -- à appeler UNE FOIS,
        côté EXÉCUTANT uniquement, une fois que ce ClientServeurT est
        connecté au serveurT, enregistré avec role="executant" (cf.
        register_refuse) ET que TOUS les .connect() de commandes du
        pilote (création de profil, logs, kill, démarrage isolé, notebook
        distant, etc.) sont posés (cf. main_sautoniax : appelé juste après
        le DERNIER de ces .connect(), pas juste après connecte_event --
        cf. BUGFIX CRITIQUE spec A.3 à cet emplacement, qui explique
        pourquoi un appel plus précoce causait des commandes reçues mais
        jamais traitées). Relayé par le serveurT à tous les pilotes
        connectés (cf. serveur.py, même patron que creer_profil_
        sautoniax_resultat), reçu côté pilote via ClientServeurT.
        sautoniax_pret_recu -- sert à débloquer bouton_generer_profils de
        PanneauProprietesSautoniax (cf. sa docstring), qui ne peut pas se
        fier au premier sur_profils_recus pour détecter la disponibilité
        réelle (un scan peut réussir par coïncidence même sur une
        connexion pas encore stable).

        CORRECTIF (ligne grisée indéfiniment après reconnexion) -- marque
        désormais self._sautoniax_deja_pret = True dès l'envoi (avant
        même la confirmation réseau, comme le fait déjà self.nom ailleurs
        dans cette classe : un échec d'envoi ici est transitoire, cf.
        _boucle_async qui retente indéfiniment) -- c'est ce booléen que
        _boucle_async consulte à CHAQUE reconnexion suivante pour
        renvoyer ce même signal automatiquement, sans dépendre d'un
        nouvel appel explicite de main_sautoniax (qui n'appelle cette
        méthode qu'une seule fois, au tout premier démarrage du
        process)."""
        self._sautoniax_deja_pret = True
        if self._loop is None or not self._loop.is_running() or self._ws is None:
            return
        asyncio.run_coroutine_threadsafe(
            self._ws.send(json.dumps({"type": "sautoniax_pret", "id_executant": self.nom})), self._loop,
        )

