# CÔTÉ PILOTE
# =====================================================================================================
def extraire_racines_pont_depuis_code(code: str) -> list:
    """Chemins du PC cités en littéraux dans le code d'une cellule (+ liste PILOTE_DOSSIERS_AUTORISES). Jamais d'exception."""
    trouves = []
    if not code:
        return trouves

    def _candidat(s):
        s = s.strip()
        if 3 <= len(s) <= 600 and "\n" not in s and "\x00" not in s:
            if chemin_est_pilote(s) or (os.name != "nt" and s.startswith("/") and os.path.exists(s)):
                trouves.append(s)

    try:
        arbre = ast.parse(code)
    except (SyntaxError, ValueError):
        for m in re.finditer(r"""(["'])((?:[A-Za-z]:[\\/]|\\\\)[^"'\n]{1,500})\1""", code):
            _candidat(m.group(2))
        return trouves
    for noeud in ast.walk(arbre):
        if isinstance(noeud, ast.Constant) and isinstance(noeud.value, str):
            _candidat(noeud.value)
        elif isinstance(noeud, ast.Assign):
            if any(isinstance(t, ast.Name) and t.id == "PILOTE_DOSSIERS_AUTORISES" for t in noeud.targets):
                try:
                    valeur = ast.literal_eval(noeud.value)
                except (ValueError, SyntaxError):
                    continue
                for s in ([valeur] if isinstance(valeur, str) else list(valeur) if isinstance(valeur, (list, tuple)) else []):
                    if isinstance(s, str) and s.strip() and os.path.isabs(s.strip()) or chemin_est_pilote(str(s)):
                        trouves.append(str(s).strip())
    return trouves


# AJOUT (Transit Drive, étape 3 générique) -- APPELS LOGIQUES : au lieu de dizaines d'opérations de fichier par le pont,
# le clone envoie UN appel nommé (op « appel_logique ») que le pilote exécute lui-même, sur son disque. Les fonctions
# sont enregistrées côté pilote avec @appel_logique_pilote("nom") et reçoivent (service, **args) -> résultat
# sérialisable en JSON. `service` donne accès au disque et à Transit : service.transit_deposer_fichier(chemin),
# service.transit_deposer_octets(nom, octets), service.transit_recevoir_vers(chemin, ...). Le dédoublonnage par rid
# de ServicePilotePont.traiter garantit qu'un appel renvoyé n'est exécuté qu'UNE fois.
APPELS_LOGIQUES_PILOTE: dict = {}


def appel_logique_pilote(nom: str):
    def _enregistrer(fonction):
        APPELS_LOGIQUES_PILOTE[nom] = fonction
        return fonction
    return _enregistrer


# PATCH (bot CAA sur un sAutoniax distant) : un clone (Colab/Kaggle) n'a pas les variables d'environnement du PC pilote.
# Ce petit appel renvoie, côté PC, la valeur de quelques variables SANS danger (dossiers de profil Windows), pour que le
# notebook retrouve p. ex. %APPDATA% du PC et y accède ensuite par le pont de fichiers (chemins « C:\\... »).
@appel_logique_pilote("variable_environnement")
def _appel_logique_variable_environnement(service, cle="", nom=""):
    cle = cle or nom      # `cle` est le nom conseillé (« nom » percute le 1er paramètre de appel_logique sur un client ancien)
    if cle not in ("APPDATA", "LOCALAPPDATA", "USERPROFILE", "TEMP"):
        return None
    return os.environ.get(cle)


# PATCH v7 (lenteur du pont) : chaque opération de fichier d'un clone = 1 aller-retour réseau (~0,5 s). Ces appels font PLUSIEURS
# opérations d'un coup, SUR LE PC, et ne coûtent donc qu'UN aller-retour.
def _bot_ecrire_json_atomique(service, chemin, data):
    n, _t = service._autorise(chemin)
    dossier = os.path.dirname(n)
    if dossier:
        os.makedirs(dossier, exist_ok=True)
    tmp = n + ".tmp"
    with open(tmp, "w", encoding="utf-8") as f:
        f.write(json.dumps(data, ensure_ascii=False))
    os.replace(tmp, n)


@appel_logique_pilote("ecrire_json_atomique")
def _appel_logique_ecrire_json_atomique(service, chemin="", data=None):
    _bot_ecrire_json_atomique(service, chemin, data)
    return True


@appel_logique_pilote("bot_cycle")
def _appel_logique_bot_cycle(service, dossier="", inbox="", caa="", etat_chemin="", etat=None, max_octets=262144):
    """UN tour de bot CAA : (option) écrit l'état du bot, teste stop.json / premier_plan.json, lit caa.json, liste la boîte de
    messages et en renvoie le contenu. Remplace ~9 aller-retours par 1."""
    res = {}
    if etat_chemin and isinstance(etat, dict):
        _bot_ecrire_json_atomique(service, etat_chemin, etat)
        res["etat_ecrit"] = True
    if dossier:
        for nom in ("stop", "premier_plan"):
            n, _t = service._autorise(os.path.join(dossier, nom + ".json"))
            res[nom] = os.path.exists(n)
    if caa:
        n, _t = service._autorise(caa)
        info = {"dossier": os.path.isdir(os.path.dirname(n)), "fichier": os.path.isfile(n), "data": None}
        if info["fichier"]:
            try:
                with open(n, "r", encoding="utf-8") as f:
                    info["data"] = json.loads(f.read())
            except (OSError, ValueError):
                info["data"] = None
        res["caa"] = info
    if inbox:
        n, _t = service._autorise(inbox)
        contenu = {}
        if os.path.isdir(n):
            for nom in sorted(os.listdir(n)):
                if not nom.lower().endswith(".json"):
                    continue
                f = os.path.join(n, nom)
                try:
                    if os.path.getsize(f) > max_octets:
                        contenu[nom] = None
                        continue
                    with open(f, "r", encoding="utf-8") as fh:
                        contenu[nom] = fh.read()
                except OSError:
                    continue
        res["inbox"] = contenu
    return res


# PATCH « DÉCLENCHEUR » (économie de connexion) -- au lieu que chaque agent vienne regarder son dossier du pont toutes les 0,4 à 0,5 s
# (1 aller-retour réseau à chaque coup d'œil, presque toujours « rien de nouveau »), l'agent pose UNE question qui ATTEND ici, SUR LE PC
# (surveillance locale, gratuite) et ne reçoit de réponse que quand quelque chose CHANGE : ordre (stop, premier_plan, stop_gen,
# actualiser_gen, approbation) ou nouveau fichier dans la boîte de messages. `vu` = ce que l'agent connaît déjà : on répond tout de
# suite si l'état diffère, sinon on attend au plus `attente_s` (plafonné sous le délai de renvoi du relais, 10 s). Ne lit ni ne
# supprime rien : l'agent lit ensuite normalement (bot_cycle). Exécutée dans un pool SÉPARÉ (cf. _traiter_pont_live).
@appel_logique_pilote("bot_attente")
def _appel_logique_bot_attente(service, dossier="", inbox="", noms=None, vu=None, attente_s=8.0):
    noms = [n for n in (noms or ("stop", "premier_plan", "stop_gen", "actualiser_gen")) if isinstance(n, str) and re.fullmatch(r"[a-z_]+", n)]
    vu = sorted(str(x) for x in (vu or []))
    attente_s = max(0.0, min(float(attente_s), 9.0))
    rep_dossier = os.path.dirname(service._autorise(os.path.join(dossier, "x.json"))[0]) if dossier else ""
    rep_inbox = service._autorise(inbox)[0] if inbox else ""

    def _present():
        pres = []
        if rep_dossier:
            pres = [n for n in noms if os.path.exists(os.path.join(rep_dossier, n + ".json"))]
        if rep_inbox and os.path.isdir(rep_inbox):
            try:
                pres += ["inbox/" + f for f in os.listdir(rep_inbox) if f.lower().endswith(".json")]
            except OSError:
                pass
        return sorted(pres)

    fin = time.monotonic() + attente_s
    while True:
        pres = _present()
        if pres != vu:
            return {"present": pres, "change": True}
        if time.monotonic() >= fin:
            return {"present": pres, "change": False}
        time.sleep(0.25)


class ServicePilotePont:
    """Exécute, SUR LE DISQUE DU PILOTE, les demandes d'un clone. Thread-safe. Voir l'en-tête du bloc.

    traiter(requete: dict) -> dict | None
        requete = {"rid", "op", "args"} ; renvoie la réponse (toujours un dict avec "ok"), ou None si cette
        demande est DÉJÀ en cours de traitement (doublon : la vraie réponse partira à la fin du premier traitement)."""

    TAILLE_CACHE = 1024
    TTL_FD_S = 300.0

    def __init__(self, racines=(), strict=None):
        # PAR DÉFAUT : AUCUNE restriction (tous les disques du PC, C: compris) -- c'est VOTRE PC. Le mode strict
        # (liste de racines) n'existe que sur demande : AUTONIAX_PONT_STRICT=1.
        self.strict = bool(strict) if strict is not None else (
            (os.environ.get("AUTONIAX_PONT_STRICT") or "").strip().lower() in ("1", "oui", "true", "on"))
        self._verrou = threading.RLock()
        self._racines = []            # [(type "dir"|"fichier", chemin normalisé)]
        self._fd = {}                 # jeton -> [fd réel, dernier usage]
        self._cache = collections.OrderedDict()   # rid -> réponse | None (en cours)
        # MAINTIEN DES VERROUS : un verrou fichier (os.open O_CREAT|O_EXCL) posé par un clone ENCORE VIVANT est tenu à
        # jour (mtime) par le pilote. Sans cela, une section critique lente (nombreux allers-retours réseau sous le
        # verrou) dépasse le seuil « verrou abandonné » du notebook (ex. 10 s) et un autre clone VOLE le verrou.
        # Un clone planté (plus aucune demande) perd ce maintien et son verrou expire normalement.
        self._ctx_pont = threading.local()
        self._verrous_tenus = {}      # chemin réel -> {"cl": clé du clone, "t0": monotonic}
        self._activite_clone = {}     # clé du clone -> monotonic de sa dernière demande
        self._fil_verrous = None
        for r in racines:
            self.ajouter_racine(r)
        for r in (os.environ.get("AUTONIAX_PONT_DOSSIERS") or "").split(os.pathsep):
            if r.strip():
                self.ajouter_racine(r.strip())

    # ---- autorisations -------------------------------------------------------------------------
    @staticmethod
    def _norm(chemin: str) -> str:
        return os.path.normcase(os.path.realpath(os.path.abspath(chemin)))

    def ajouter_racine(self, chemin: str) -> bool:
        try:
            if not isinstance(chemin, str) or not chemin.strip() or "\x00" in chemin or not os.path.isabs(chemin.strip()):
                return False
            n = self._norm(chemin.strip())
            if os.path.isdir(n):
                typ = "dir"
            elif os.path.splitext(n)[1]:
                typ = "fichier"
            else:
                typ = "dir"
            with self._verrou:
                if (typ, n) not in self._racines:
                    self._racines.append((typ, n))
            return True
        except (OSError, ValueError):
            return False

    def racines(self) -> list:
        with self._verrou:
            return list(self._racines)

    def _autorise(self, chemin):
        """-> (chemin normalisé, type de la racine qui l'autorise). Lève PermissionError(refus) sinon."""
        if not isinstance(chemin, str) or not chemin or "\x00" in chemin:
            raise _Refus("chemin invalide")
        if not os.path.isabs(chemin):
            raise _Refus("chemin non absolu refusé : %r" % chemin)
        n = self._norm(chemin)
        if not self.strict:
            return n, "libre"
        seps = (os.sep, os.altsep) if os.altsep else (os.sep,)
        with self._verrou:
            racines = list(self._racines)
        for typ, r in racines:
            if typ == "dir":
                if n == r or n.startswith(r.rstrip(os.sep) + os.sep):
                    return n, typ
            elif n == r or (n.startswith(r) and not any(s in n[len(r):] for s in seps)):
                return n, typ      # le fichier déclaré ET ses voisins « .lock », « .tmp »... (même dossier)
        raise _Refus("chemin hors des dossiers autorisés par le pilote : %r" % chemin)

    # ---- dispatch ------------------------------------------------------------------------------
    DELAI_MAINTIEN_VERROU_S = 2.0       # fréquence de rafraîchissement
    SILENCE_CLONE_MAX_S = 45.0          # clone sans aucune demande depuis ce délai : considéré mort, verrou laissé expirer
    DUREE_MAX_MAINTIEN_S = 600.0        # filet : jamais maintenu plus de 10 min

    def _boucle_verrous(self):
        while True:
            time.sleep(self.DELAI_MAINTIEN_VERROU_S)
            maintenant = time.monotonic()
            with self._verrou:
                items = list(self._verrous_tenus.items())
            for n, info in items:
                vivant = maintenant - self._activite_clone.get(info["cl"], 0.0) < self.SILENCE_CLONE_MAX_S
                if not vivant or maintenant - info["t0"] > self.DUREE_MAX_MAINTIEN_S:
                    with self._verrou:
                        self._verrous_tenus.pop(n, None)
                    continue
                try:
                    os.utime(n, None)
                except OSError:      # verrou retiré (normal) ou illisible : on arrête de le suivre
                    with self._verrou:
                        self._verrous_tenus.pop(n, None)

    def _oublier_verrou(self, n):
        with self._verrou:
            self._verrous_tenus.pop(n, None)

    def traiter(self, requete: dict):
        rid = requete.get("rid")
        if not isinstance(rid, str) or not rid:
            return {"ok": False, "exc": "ValueError", "message": "rid manquant"}
        cle_clone = "%s|%s" % (requete.get("session_id"), requete.get("instance_id"))
        self._ctx_pont.cle = cle_clone
        with self._verrou:
            self._activite_clone[cle_clone] = time.monotonic()   # même un doublon (renvoi) prouve que le clone vit
            if len(self._activite_clone) > 2000:
                for k in sorted(self._activite_clone, key=self._activite_clone.get)[:500]:
                    self._activite_clone.pop(k, None)
            if rid in self._cache:
                precedente = self._cache[rid]
                return None if precedente is None else dict(precedente)
            self._cache[rid] = None
            self._balayer_fd()
        try:
            op = requete.get("op")
            fonction = getattr(self, "_op_" + str(op), None) if re.fullmatch(r"[a-z_]+", str(op)) else None
            if fonction is None:
                raise ValueError("opération inconnue : %r" % (op,))
            args = requete.get("args") or {}
            if not isinstance(args, dict):
                raise ValueError("args invalides")
            reponse = fonction(**args)
            reponse = dict(reponse or {})
            reponse["ok"] = True
        except _Refus as e:
            reponse = {"ok": False, "refus": True, "errno": errno.EACCES, "exc": "PermissionError", "message": str(e)}
        except TransitErreur as e:
            reponse = {"ok": False, "exc": "TransitErreur", "message": str(e)}
        except OSError as e:
            reponse = {"ok": False, "errno": e.errno, "exc": type(e).__name__, "message": e.strerror or str(e)}
        except Exception as e:
            reponse = {"ok": False, "exc": type(e).__name__, "message": "%s: %s" % (type(e).__name__, e)}
        reponse["rid"] = rid
        with self._verrou:
            self._cache[rid] = reponse
            while len(self._cache) > self.TAILLE_CACHE:
                self._cache.popitem(last=False)
        return dict(reponse)

    def fermer(self):
        with self._verrou:
            for fd, _t in self._fd.values():
                try:
                    os.close(fd)
                except OSError:
                    pass
            self._fd.clear()

    def _balayer_fd(self):
        limite = time.monotonic() - self.TTL_FD_S
        for jeton in [j for j, (_fd, t) in self._fd.items() if t < limite]:
            try:
                os.close(self._fd.pop(jeton)[0])
            except OSError:
                pass

    @staticmethod
    def _remplacer(src, dst):
        for essai in range(6):
            try:
                os.replace(src, dst)
                return
            except PermissionError:       # Windows : fichier brièvement ouvert par un autre programme
                if essai == 5:
                    raise
                time.sleep(0.3)

    @staticmethod
    def _staging(n, upload):
        if not re.fullmatch(r"[0-9a-f]{8,32}", str(upload)):
            raise ValueError("upload invalide")
        return n + ".autoniax-up-" + str(upload)

    # ---- opérations ----------------------------------------------------------------------------
    # ---- TRANSIT DRIVE + appels logiques (côté pilote) -----------------------------------------
    # Les données lourdes ne passent plus par le pont : le pilote les dépose dans / les lit depuis un zip de Transit/
    # (cf. TransitDrive), et le pont ne porte plus que de petits messages (fileId, jeton, taille, SHA-256).
    def brancher_transit(self, fabrique_drive, fabrique_client_serveur):
        """fabrique_drive() -> TransitDrive ; fabrique_client_serveur() -> ClientServeurT (ou None si déconnecté).
        Des fabriques et non des objets : le client serveurT peut changer à chaque reconnexion."""
        self._transit_fab_drive = fabrique_drive
        self._transit_fab_serveur = fabrique_client_serveur

    def _transit(self):
        fab_d = getattr(self, "_transit_fab_drive", None)
        fab_s = getattr(self, "_transit_fab_serveur", None)
        if fab_d is None or fab_s is None:
            raise TransitErreur("Transit n'est pas branché sur ce pilote.")
        serveur = fab_s()
        if serveur is None:
            raise TransitErreur("Non connecté au serveurT : impossible d'utiliser Transit.")
        return fab_d(), serveur

    def transit_deposer_octets(self, nom: str, octets: bytes) -> dict:
        """Demande un zip libre au serveurT, y écrit `octets`. -> {slot, file_id, jeton, taille, sha256, nom} à transmettre
        au clone. Le zip reste OCCUPÉ jusqu'à ce que le clone ait fini de le lire (transit_liberer) ; libéré ici seulement
        si l'écriture échoue."""
        drive, serveur = self._transit()
        t0 = time.time()
        zip_ = serveur.transit_demander_zip()
        t_demande = time.time() - t0
        try:
            r = drive.ecrire(zip_["file_id"], nom, octets)
        except BaseException:
            try:
                serveur.transit_liberer_zip(zip_["slot"], zip_["jeton"])
            except Exception:
                pass
            raise
        log_pont_diag.info(f"[PONT-DIAG] TRANSIT déposer : demande de zip au serveurT = {t_demande:.2f}s ; écriture Drive = {r.get('etapes')}")
        return {"slot": zip_["slot"], "file_id": zip_["file_id"], "jeton": zip_["jeton"],
                "taille": r["taille"], "sha256": r["sha256"], "nom": nom,
                "etapes": dict(r.get("etapes", {}), demande_zip_serveur_s=round(t_demande, 3))}

    def transit_deposer_fichier(self, chemin: str) -> dict:
        n, _t = self._autorise(chemin)
        t0 = time.time()
        # CORRECTIF PERF : f.read(LECTURE_MAX_PONT + 1) réservait ~2 Go de mémoire avant de lire (0,8 s mesuré sur un PC
        # au repos, ~4 s dans AutoniaX) même pour un fichier de 100 Ko. On lit maintenant la taille RÉELLE (+1 pour détecter
        # un fichier qui aurait grandi), le garde-fou 2 Go est conservé.
        with open(n, "rb") as f:
            taille_reelle = os.fstat(f.fileno()).st_size
            if taille_reelle > LECTURE_MAX_PONT:
                raise OSError(errno.EFBIG, "fichier trop volumineux pour Transit (max %d octets)" % LECTURE_MAX_PONT, chemin)
            octets = f.read(taille_reelle + 1)
        t_disque = time.time() - t0
        if len(octets) > LECTURE_MAX_PONT:
            raise OSError(errno.EFBIG, "fichier trop volumineux pour Transit (max %d octets)" % LECTURE_MAX_PONT, chemin)
        reponse = self.transit_deposer_octets(os.path.basename(n), octets)
        reponse["etapes"]["lecture_disque_s"] = round(t_disque, 3)
        return reponse

    def transit_recevoir_vers(self, chemin: str, file_id: str, sha256: str, taille: int, slot: str, jeton: str) -> dict:
        """Télécharge le zip déposé par le clone, vérifie SHA-256 (zip puis contenu), écrit le contenu à `chemin` d'un bloc
        (fichier temporaire + os.replace), PUIS libère le zip auprès du serveurT. Aucune écriture si une vérification échoue."""
        n, _t = self._autorise(chemin)
        drive, serveur = self._transit()
        nom, octets = drive.lire(file_id, sha256, int(taille))
        etapes = dict(drive.etapes_lecture())
        t0 = time.time()
        dossier = os.path.dirname(n)
        if dossier and not os.path.isdir(dossier):
            raise FileNotFoundError(errno.ENOENT, "dossier inexistant", dossier)
        temporaire = n + ".autoniax-transit-" + uuid.uuid4().hex[:8]
        try:
            with open(temporaire, "wb") as f:
                f.write(octets)
            self._remplacer(temporaire, n)
        except BaseException:
            try:
                os.remove(temporaire)
            except OSError:
                pass
            raise
        etapes["ecriture_disque_s"] = round(time.time() - t0, 3)
        reponse = {"taille": len(octets), "nom": nom, "etapes": etapes}
        t0 = time.time()
        try:
            serveur.transit_liberer_zip(slot, jeton)
        except Exception as e:      # le fichier EST livré ; seul le zip reste marqué occupé (repris plus tard)
            reponse["liberation_echouee"] = str(e)
            log_cellule.warning(f"[transit] fichier livré mais zip {slot} non libéré : {e!r}")
        etapes["liberation_serveur_s"] = round(time.time() - t0, 3)
        log_pont_diag.info(f"[PONT-DIAG] TRANSIT recevoir -> disque : étapes (secondes) = {etapes}")
        return reponse

    def transit_mesurer(self, taille: int = 768000) -> dict:
        """DIAGNOSTIC : latence Drive depuis le PC + débit réel (écriture et lecture de `taille` octets aléatoires dans un
        zip libre) + aller-retour du serveurT. Sépare ce qui est lent : Drive depuis le PC, ou le reste."""
        drive, serveur = self._transit()
        taille = max(1024, min(int(taille), 50 * 1024 * 1024))
        res = {"taille_octets": taille, "latence_drive": drive.latence_drive()}
        t0 = time.time()
        zip_ = serveur.transit_demander_zip()
        res["serveur_demande_zip_s"] = round(time.time() - t0, 3)
        try:
            octets = os.urandom(taille)
            t0 = time.time()
            r = drive.ecrire(zip_["file_id"], "mesure.bin", octets, nettoyer_revisions=False)
            res["ecriture_drive_s"] = round(time.time() - t0, 3)
            res["ecriture_etapes"] = r.get("etapes", {})
            t0 = time.time()
            drive.lire(zip_["file_id"], r["sha256"], r["taille"])
            res["lecture_drive_s"] = round(time.time() - t0, 3)
            res["lecture_etapes"] = drive.etapes_lecture()
            try:
                res["lecture_requests_s"] = drive.lire_requests_duree(zip_["file_id"])
            except Exception as e:
                res["lecture_requests_s"] = f"impossible : {e!r}"
        finally:
            t0 = time.time()
            try:
                serveur.transit_liberer_zip(zip_["slot"], zip_["jeton"])
            finally:
                res["serveur_liberation_s"] = round(time.time() - t0, 3)
        return res

    def _op_transit_deposer(self, chemin):
        return self.transit_deposer_fichier(chemin)

    def _op_transit_demander(self):
        return self._transit()[1].transit_demander_zip()

    def _op_transit_recevoir(self, chemin, file_id, sha256, taille, slot, jeton):
        return self.transit_recevoir_vers(chemin, file_id, sha256, taille, slot, jeton)

    def _op_transit_mesurer(self, taille=768000):
        return self.transit_mesurer(taille)

    def _op_transit_liberer(self, slot, jeton):
        self._transit()[1].transit_liberer_zip(slot, jeton)
        return {}

    def _op_appel_logique(self, nom, args=None):
        fonction = APPELS_LOGIQUES_PILOTE.get(nom)
        if fonction is None:
            raise ValueError("appel logique inconnu côté pilote : %r" % (nom,))
        if args is not None and not isinstance(args, dict):
            raise ValueError("args de l'appel logique invalides")
        return {"resultat": fonction(self, **(args or {}))}

    def _op_ping(self):
        return {"now": time.time()}

    def _op_stat(self, chemin):
        n, _t = self._autorise(chemin)
        st = os.stat(n)
        return {"isfile": _stat_pont.S_ISREG(st.st_mode), "isdir": _stat_pont.S_ISDIR(st.st_mode),
                "size": st.st_size, "mtime": st.st_mtime, "now": time.time()}

    PREFETCH_MAX_FICHIERS = 200
    PREFETCH_MAX_OCTETS_FICHIER = 64 * 1024
    PREFETCH_MAX_OCTETS_TOTAL = 2 * 1024 * 1024
    PREFETCH_AGE_MIN_S = 30.0     # un fichier modifié il y a moins de 30 s n'est JAMAIS préchargé (donnée possiblement vivante)

    def _op_listdir(self, chemin, prefetch=False):
        n, _t = self._autorise(chemin)
        noms = os.listdir(n)
        if len(noms) > 200000:
            raise OSError(errno.EFBIG, "dossier trop volumineux (%d entrées)" % len(noms))
        reponse = {"noms": noms}
        if prefetch:
            # Évite UN aller-retour réseau par petit fichier (le code du notebook liste un dossier puis lit chaque .json).
            pre, total, maintenant = {}, 0, time.time()
            for nom in noms:
                if len(pre) >= self.PREFETCH_MAX_FICHIERS or total >= self.PREFETCH_MAX_OCTETS_TOTAL:
                    break
                if not nom.lower().endswith((".json", ".txt")):
                    continue
                try:
                    f = os.path.join(n, nom)
                    st = os.stat(f)
                    if (not _stat_pont.S_ISREG(st.st_mode) or st.st_size > self.PREFETCH_MAX_OCTETS_FICHIER
                            or maintenant - st.st_mtime < self.PREFETCH_AGE_MIN_S):
                        continue
                    with open(f, "rb") as fh:
                        octets = fh.read(self.PREFETCH_MAX_OCTETS_FICHIER + 1)
                    if len(octets) != st.st_size:
                        continue
                except OSError:
                    continue
                total += len(octets)
                pre[nom] = base64.b64encode(octets).decode("ascii")
            if pre:
                reponse["prefetch"] = pre
        return reponse

    def _op_lire(self, chemin, offset=0, taille=TAILLE_MORCEAU_PONT):
        n, typ = self._autorise(chemin)
        offset = max(0, int(offset))
        taille = max(1, min(int(taille), TAILLE_MORCEAU_PONT))
        with open(n, "rb") as f:
            total = os.fstat(f.fileno()).st_size
            f.seek(offset)
            octets = f.read(taille)
        if typ == "fichier" and offset == 0 and len(octets) == total and total <= 1024 * 1024 and n.endswith(".json"):
            self._accorder_depuis_json(octets)
        return {"b64": base64.b64encode(octets).decode("ascii"), "total": total, "eof": offset + len(octets) >= total}

    def _accorder_depuis_json(self, octets: bytes):
        """Un fichier EXPLICITEMENT déclaré (ex. « campagne_candidate.json ») peut citer le chemin d'autres fichiers
        (ex. taches.json) : ces chemins-là sont autorisés à leur tour. Uniquement depuis un fichier déclaré, jamais depuis
        un fichier trouvé dans un dossier."""
        try:
            contenu = json.loads(octets.decode("utf-8-sig"))
        except (ValueError, UnicodeDecodeError):
            return
        pile, vus = [contenu], 0
        while pile and vus < 2000:
            x = pile.pop()
            vus += 1
            if isinstance(x, dict):
                pile.extend(x.values())
            elif isinstance(x, list):
                pile.extend(x)
            elif isinstance(x, str) and chemin_est_pilote(x) and len(x) < 600:
                self.ajouter_racine(x)

    def _op_ecrire_morceau(self, chemin, upload, offset, b64):
        n, _t = self._autorise(chemin)
        st = self._staging(n, upload)
        donnees = base64.b64decode(b64)
        offset = int(offset)
        with open(st, "wb" if offset == 0 else "r+b") as f:
            f.seek(offset)
            f.write(donnees)
        return {"recu": len(donnees)}

    def _op_ecrire_fin(self, chemin, upload, taille, sha256, mode="w"):
        n, _t = self._autorise(chemin)
        st = self._staging(n, upload)
        if mode not in ("w", "x", "a"):
            raise ValueError("mode invalide")
        if int(taille) == 0 and not os.path.exists(st):
            open(st, "wb").close()
        h, lu = hashlib.sha256(), 0
        with open(st, "rb") as f:
            for bloc in iter(lambda: f.read(1024 * 1024), b""):
                h.update(bloc)
                lu += len(bloc)
        if lu != int(taille) or h.hexdigest() != sha256:
            raise OSError(errno.EIO, "écriture corrompue en transit (taille/SHA-256 différents) -- rien n'a été écrit")
        dossier = os.path.dirname(n)
        if dossier and not os.path.isdir(dossier):
            raise FileNotFoundError(errno.ENOENT, "dossier inexistant", dossier)
        if mode == "w":
            self._remplacer(st, n)
        elif mode == "x":
            try:
                os.link(st, n)
            except FileExistsError:
                os.remove(st)
                raise
            except OSError:
                if os.path.exists(n):
                    os.remove(st)
                    raise FileExistsError(errno.EEXIST, "le fichier existe déjà", n)
                self._remplacer(st, n)
            else:
                os.remove(st)
        else:
            with open(n, "ab") as dst, open(st, "rb") as src:
                shutil.copyfileobj(src, dst, 1024 * 1024)
            os.remove(st)
        return {"taille": lu}

    def _op_ecrire_abandon(self, chemin, upload):
        n, _t = self._autorise(chemin)
        try:
            os.remove(self._staging(n, upload))
        except FileNotFoundError:
            pass
        return {}

    def _op_fd_ouvrir(self, chemin, flags, mode=0o666):
        n, _t = self._autorise(chemin)
        fd = os.open(n, _noms_vers_flags(flags), int(mode))
        jeton = uuid.uuid4().hex
        with self._verrou:
            self._fd[jeton] = [fd, time.monotonic()]
            if "O_EXCL" in flags and "O_CREAT" in flags:      # création exclusive réussie = verrou posé par ce clone
                self._verrous_tenus[n] = {"cl": getattr(self._ctx_pont, "cle", "?"), "t0": time.monotonic()}
                if self._fil_verrous is None:
                    self._fil_verrous = threading.Thread(target=self._boucle_verrous, name="pont-verrous", daemon=True)
                    self._fil_verrous.start()
        return {"jeton": jeton}

    def _fd_de(self, jeton):
        with self._verrou:
            entree = self._fd.get(jeton)
            if entree is None:
                raise OSError(errno.EBADF, "descripteur distant inconnu ou expiré")
            entree[1] = time.monotonic()
            return entree[0]

    def _op_fd_ecrire(self, jeton, b64):
        return {"ecrits": os.write(self._fd_de(jeton), base64.b64decode(b64))}

    def _op_fd_fermer(self, jeton):
        with self._verrou:
            entree = self._fd.pop(jeton, None)
        if entree is None:
            raise OSError(errno.EBADF, "descripteur distant inconnu ou expiré")
        os.close(entree[0])
        return {}

    def _op_supprimer(self, chemin):
        n, _t = self._autorise(chemin)
        self._oublier_verrou(n)
        os.remove(n)
        return {}

    def _op_renommer(self, source, destination):
        a, _t = self._autorise(source)
        b, _t2 = self._autorise(destination)
        self._oublier_verrou(a)      # un renommage = reprise d'un verrou abandonné par un autre clone : plus tenu par l'ancien
        os.rename(a, b)
        return {}

    def _op_remplacer(self, source, destination):
        a, _t = self._autorise(source)
        b, _t2 = self._autorise(destination)
        self._remplacer(a, b)
        return {}

    def _op_scandir(self, chemin):
        n, _t = self._autorise(chemin)
        sortie = []
        with os.scandir(n) as it:
            for e in it:
                try:
                    st = e.stat()
                    sortie.append([e.name, e.is_dir(), e.is_file(), st.st_size, st.st_mtime])
                except OSError:
                    sortie.append([e.name, False, False, 0, 0.0])
        return {"entrees": sortie, "now": time.time()}

    def _op_glob(self, motif, recursive=False):
        prefixe = re.split(r"[*?\[]", motif)[0]
        self._autorise(prefixe if prefixe.endswith(("/", "\\")) else (os.path.dirname(prefixe) or motif))
        trouves = []
        for c in _glob_pont.iglob(motif, recursive=bool(recursive)):
            if self.strict:
                try:
                    self._autorise(c)
                except _Refus:
                    continue
            trouves.append(c)
            if len(trouves) > 200000:
                raise OSError(errno.EFBIG, "glob : trop de résultats")
        return {"chemins": trouves}

    def _op_copier(self, source, destination, metadonnees=True):
        a, _t = self._autorise(source)
        b, _t2 = self._autorise(destination)
        if os.path.isdir(b):
            b = os.path.join(b, os.path.basename(a))
            self._autorise(b)
        (shutil.copy2 if metadonnees else shutil.copyfile)(a, b)
        return {"destination": b}

    def _op_deplacer(self, source, destination):
        a, _t = self._autorise(source)
        b, _t2 = self._autorise(destination)
        return {"destination": str(shutil.move(a, b))}

    def _op_rmtree(self, chemin, ignorer_erreurs=False):
        n, _t = self._autorise(chemin)
        if os.path.dirname(n) == n:
            raise OSError(errno.EPERM, "rmtree d'un lecteur entier refusé (garde-fou anti-accident)")
        shutil.rmtree(n, ignore_errors=bool(ignorer_erreurs))
        return {}

    def _op_copytree(self, source, destination, dirs_exist_ok=False):
        a, _t = self._autorise(source)
        b, _t2 = self._autorise(destination)
        shutil.copytree(a, b, dirs_exist_ok=bool(dirs_exist_ok))
        return {}

    def _op_rmdir(self, chemin):
        n, _t = self._autorise(chemin)
        os.rmdir(n)
        return {}

    def _op_chmod(self, chemin, mode):
        n, _t = self._autorise(chemin)
        os.chmod(n, int(mode))
        return {}

    def _op_utime(self, chemin, temps=None):
        n, _t = self._autorise(chemin)
        os.utime(n, None if temps is None else (float(temps[0]), float(temps[1])))
        return {}

    def _op_creer_dossiers(self, chemin, exist_ok=False):
        n, _t = self._autorise(chemin)
        os.makedirs(n, exist_ok=bool(exist_ok))
        return {}


class _Refus(Exception):
    """Refus de politique (chemin hors racines autorisées) -- distinct d'une erreur disque."""


# =====================================================================================================
# CÔTÉ CLONE (process exécuteur)
# =====================================================================================================
class ClientPontPilote:
    """Appels synchrones vers le pilote, avec renvoi automatique tant qu'aucune réponse n'arrive.

    emetteur(charge: str) -> bool : transporte un message texte déjà marqué vers le pilote (peut perdre des messages).
    Le contexte (session, instance) est lu au moment de chaque appel : il change d'une cellule à l'autre."""

    def __init__(self, emetteur, delai_total=90.0, delai_tentative=10.0):
        self._emetteur = emetteur
        self.delai_total = float(delai_total)
        self.delai_tentative = float(delai_tentative)
        self.session_id = ""
        self.id_pilote = ""
        self.instance_id = ""
        self._attentes = {}
        self._verrou = threading.Lock()
        self._decalage = 0.0                      # horloge clone − horloge pilote (secondes)
        self._prefetch = {}                       # chemin normalisé -> (monotonic, octets) : fichiers préchargés par listdir
        self._fd = {}                             # fd distant (entier local) -> jeton pilote
        self._prochain_fd = 2_000_000

    def definir_contexte(self, session_id, id_pilote, instance_id):
        self.session_id, self.id_pilote, self.instance_id = session_id, id_pilote, instance_id

    def livrer(self, reponse: dict):
        """Appelé à la réception d'une réponse du pilote (thread réseau)."""
        rid = reponse.get("rid") if isinstance(reponse, dict) else None
        with self._verrou:
            attente = self._attentes.get(rid)
        if attente is not None:
            attente[1]["rep"] = reponse
            attente[0].set()

    def appeler(self, op, delai_total=None, **args):
        if self._prefetch and op not in ("stat", "listdir", "lire", "ping"):
            self._prefetch.clear()       # toute écriture/suppression/renommage invalide les fichiers préchargés
        rid = uuid.uuid4().hex
        event, boite = threading.Event(), {}
        with self._verrou:
            self._attentes[rid] = (event, boite)
        charge = MARQUEUR_PONT_REQUETE + json.dumps(
            {"rid": rid, "op": op, "args": args, "session_id": self.session_id, "instance_id": self.instance_id},
            ensure_ascii=False,
        )
        fin = time.monotonic() + float(delai_total if delai_total is not None else self.delai_total)
        t_envoi = time.time()
        try:
            while True:
                t_envoi = time.time()
                try:
                    envoye = bool(self._emetteur(charge))
                except Exception:
                    envoye = False
                reste = fin - time.monotonic()
                if reste <= 0:
                    raise TimeoutError(errno.ETIMEDOUT, "le pilote n'a pas répondu à temps (op=%s) -- PC éteint, déconnecté ou tâche arrêtée ?" % op)
                if event.wait(min(self.delai_tentative if envoye else 0.5, reste)):
                    break
        finally:
            with self._verrou:
                self._attentes.pop(rid, None)
        rep = boite["rep"]
        if op == "stat" and isinstance(rep.get("now"), (int, float)):
            t_recu = time.time()
            if t_recu - t_envoi < 3.0:
                self._decalage = (t_envoi + t_recu) / 2.0 - rep["now"]
        return rep

    def _ok(self, rep, chemin=None):
        if rep.get("ok"):
            return rep
        message = rep.get("message") or "erreur du pilote"
        if rep.get("exc") == "TransitErreur":
            raise TransitErreur(message)
        if rep.get("refus"):
            raise PermissionError(errno.EACCES, "pont pilote : " + message, chemin)
        if rep.get("errno") is not None:
            raise OSError(rep["errno"], message, chemin)
        raise RuntimeError("pont pilote : " + message)

    # ---- opérations de haut niveau -------------------------------------------------------------
    def stat(self, chemin):
        return self._ok(self.appeler("stat", chemin=chemin), chemin)

    TTL_PREFETCH_S = 5.0

    @staticmethod
    def _cle_prefetch(chemin):
        return _ntpath_pont.normcase(_ntpath_pont.normpath(chemin))

    def listdir(self, chemin):
        rep = self._ok(self.appeler("listdir", chemin=chemin, prefetch=True), chemin)
        maintenant = time.monotonic()
        self._prefetch.clear()
        for nom, b64 in (rep.get("prefetch") or {}).items():
            self._prefetch[self._cle_prefetch(_ntpath_pont.join(chemin, nom))] = (maintenant, base64.b64decode(b64))
        return list(rep["noms"])

    def lire_tout(self, chemin) -> bytes:
        # Fichier déjà reçu avec le listdir qui vient d'avoir lieu : servi UNE SEULE FOIS, et seulement s'il est tout frais.
        entree = self._prefetch.pop(self._cle_prefetch(chemin), None) if self._prefetch else None
        if entree is not None and time.monotonic() - entree[0] < self.TTL_PREFETCH_S:
            return entree[1]
        morceaux, offset, total = [], 0, None
        while True:
            rep = self._ok(self.appeler("lire", chemin=chemin, offset=offset, taille=TAILLE_MORCEAU_PONT), chemin)
            octets = base64.b64decode(rep["b64"])
            total = rep["total"]
            if total > LECTURE_MAX_PONT:
                raise OSError(errno.EFBIG, "fichier du pilote trop volumineux (%d octets, max %d)" % (total, LECTURE_MAX_PONT), chemin)
            morceaux.append(octets)
            offset += len(octets)
            if rep.get("eof") or not octets:
                break
        data = b"".join(morceaux)
        if len(data) != total:
            raise OSError(errno.EIO, "lecture incohérente (fichier modifié pendant la lecture) : %d/%d octets" % (len(data), total), chemin)
        return data

    def ecrire(self, chemin, donnees: bytes, mode="w"):
        upload = uuid.uuid4().hex[:16]
        try:
            for offset in range(0, len(donnees), TAILLE_MORCEAU_PONT):
                self._ok(self.appeler(
                    "ecrire_morceau", chemin=chemin, upload=upload, offset=offset,
                    b64=base64.b64encode(donnees[offset:offset + TAILLE_MORCEAU_PONT]).decode("ascii"),
                ), chemin)
            self._ok(self.appeler(
                "ecrire_fin", chemin=chemin, upload=upload, taille=len(donnees),
                sha256=hashlib.sha256(donnees).hexdigest(), mode=mode,
            ), chemin)
        except BaseException:
            try:
                self.appeler("ecrire_abandon", delai_total=5.0, chemin=chemin, upload=upload)
            except BaseException:
                pass
            raise

    def fd_ouvrir(self, chemin, flags, mode=0o666) -> int:
        rep = self._ok(self.appeler("fd_ouvrir", chemin=chemin, flags=_flags_vers_noms(flags), mode=mode), chemin)
        with self._verrou:
            self._prochain_fd += 1
            local = self._prochain_fd
            self._fd[local] = rep["jeton"]
        return local

    def fd_distant(self, fd) -> bool:
        return fd in self._fd

    def fd_ecrire(self, fd, donnees) -> int:
        return self._ok(self.appeler("fd_ecrire", jeton=self._fd[fd], b64=base64.b64encode(bytes(donnees)).decode("ascii")))["ecrits"]

    def fd_fermer(self, fd):
        jeton = self._fd.pop(fd)
        self._ok(self.appeler("fd_fermer", jeton=jeton))

    # ---- TRANSIT DRIVE + appels logiques (côté clone) ------------------------------------------
    # Le clone n'envoie plus les données lourdes par le pont : il lit/écrit lui-même un zip de Transit/ sur Drive
    # (clé du compte de service : variable d'environnement AUTONIAX_DRIVE_CLE_JSON (contenu JSON) ou
    # AUTONIAX_DRIVE_CLE_JSON_CHEMIN (fichier), ou definir_transit_drive()) et le pont ne porte que de petits messages.
    # Toute erreur Transit lève TransitErreur : JAMAIS de repli sur le pont.
    def definir_transit_drive(self, drive):
        self._transit_drive = drive

    def _drive_transit(self):
        drive = getattr(self, "_transit_drive", None)
        if drive is None:
            texte = os.environ.get("AUTONIAX_DRIVE_CLE_JSON")
            chemin = os.environ.get("AUTONIAX_DRIVE_CLE_JSON_CHEMIN")
            if texte:
                drive = TransitDrive(cle_service_json=json.loads(texte))
            elif chemin and os.path.isfile(chemin):
                drive = TransitDrive(chemin_cle_json=chemin)
            else:
                raise TransitErreur("Clé du compte de service Drive introuvable côté clone : définir AUTONIAX_DRIVE_CLE_JSON "
                                    "(contenu JSON) ou AUTONIAX_DRIVE_CLE_JSON_CHEMIN avant de lancer sAutoniax.")
            self._transit_drive = drive
        return drive

    def appel_logique(self, nom, /, delai_total=None, **args):   # v7 : `nom` positionnel seul -> un argument métier nommé « nom » (ex. variable_environnement(nom='APPDATA')) ne le percute plus
        """UN aller-retour : le pilote exécute la fonction enregistrée sous `nom` (@appel_logique_pilote) et renvoie son résultat."""
        return self._ok(self.appeler("appel_logique", delai_total=delai_total, nom=nom, args=args)).get("resultat")

    def transit_liberer(self, slot, jeton):
        """Libère un zip auprès du serveurT, par le pilote (idempotent). Meilleur effort : ne lève jamais."""
        try:
            self._ok(self.appeler("transit_liberer", delai_total=30.0, slot=slot, jeton=jeton))
        except Exception:
            pass

    def _appel_mesure(self, mesure: dict, nom_etape: str, op, **args):
        """appeler() + chronométrage : durée de l'aller-retour pont ET taille des messages (preuve que seuls de petits
        messages passent par le pont, jamais les données)."""
        t0 = time.time()
        rep = self.appeler(op, **args)
        mesure.setdefault("pont", {})[nom_etape] = {
            "aller_retour_s": round(time.time() - t0, 3),
            "octets_messages": len(json.dumps(args, ensure_ascii=False)) + len(json.dumps(rep, ensure_ascii=False, default=str))}
        return rep

    def transit_lire_du_pilote(self, chemin) -> bytes:
        """Contenu d'un fichier du PC, SANS passer par le pont : le pilote le dépose dans un zip de Transit/, le clone le
        télécharge (SHA-256 vérifié) puis libère le zip. Remplace lire_tout() pour les gros fichiers.
        Chronométrage détaillé de ce transfert : self.mesure_transit (cf. transit_derniere_mesure)."""
        mesure = self.mesure_transit = {"sens": "pc -> clone"}
        t_debut = time.time()
        depot = self._ok(self._appel_mesure(mesure, "deposer (pilote : lit le fichier, écrit le zip)", "transit_deposer", chemin=chemin), chemin)
        mesure["pilote"] = depot.get("etapes", {})
        try:
            drive = self._drive_transit()
            t0 = time.time()
            _nom, octets = drive.lire(depot["file_id"], depot["sha256"], depot["taille"])
            mesure["clone_lecture_drive_s"] = round(time.time() - t0, 3)
            mesure["clone"] = drive.etapes_lecture()
        finally:
            t0 = time.time()
            self.transit_liberer(depot["slot"], depot["jeton"])      # lu OU échoué : le zip ne doit pas rester bloqué
            mesure["pont"]["liberer"] = {"aller_retour_s": round(time.time() - t0, 3)}
            mesure["total_s"] = round(time.time() - t_debut, 3)
        return octets

    def transit_mesurer(self, taille: int = 768000) -> dict:
        """DIAGNOSTIC (où part le temps ?) : aller-retour du pont (ping x3), Drive depuis le CLONE (latence + débit réel
        d'un zip de `taille` octets), Drive depuis le PILOTE (idem), aller-retours du serveurT. N'utilise qu'un zip de Transit/."""
        taille = max(1024, min(int(taille), 50 * 1024 * 1024))
        res = {"taille_octets": taille}
        pings = []
        for _ in range(3):
            t0 = time.time()
            self._ok(self.appeler("ping"))
            pings.append(round(time.time() - t0, 3))
        res["pont_ping_s"] = pings
        t0 = time.time()
        res["pilote_vers_drive"] = self._ok(self.appeler("transit_mesurer", taille=taille))
        res["pilote_vers_drive"].pop("ok", None); res["pilote_vers_drive"].pop("rid", None)
        res["pilote_total_pont_s"] = round(time.time() - t0, 3)
        drive = self._drive_transit()
        res["clone_latence_drive"] = drive.latence_drive()
        t0 = time.time()
        zip_ = self._ok(self.appeler("transit_demander"))
        res["pont_transit_demander_s"] = round(time.time() - t0, 3)
        try:
            octets = os.urandom(taille)
            t0 = time.time()
            r = drive.ecrire(zip_["file_id"], "mesure.bin", octets, nettoyer_revisions=False)
            res["clone_ecriture_drive_s"] = round(time.time() - t0, 3)
            res["clone_ecriture_etapes"] = r.get("etapes", {})
            t0 = time.time()
            drive.lire(zip_["file_id"], r["sha256"], r["taille"])
            res["clone_lecture_drive_s"] = round(time.time() - t0, 3)
            res["clone_lecture_etapes"] = drive.etapes_lecture()
        finally:
            self.transit_liberer(zip_["slot"], zip_["jeton"])
        return res

    def transit_envoyer_au_pilote(self, chemin, donnees: bytes) -> dict:
        """Écrit `donnees` au chemin `chemin` du PC, SANS passer par le pont : le clone les dépose dans un zip libre de
        Transit/, le pilote les télécharge (SHA-256 vérifié), les écrit d'un bloc puis libère le zip. Remplace ecrire()."""
        mesure = self.mesure_transit = {"sens": "clone -> pc"}
        t_debut = time.time()
        zip_ = self._ok(self._appel_mesure(mesure, "demander (serveurT : attribue un zip)", "transit_demander"), chemin)
        try:
            t0 = time.time()
            r = self._drive_transit().ecrire(zip_["file_id"], _ntpath_pont.basename(chemin), donnees)
            mesure["clone_ecriture_drive_s"] = round(time.time() - t0, 3)
            mesure["clone"] = r.get("etapes", {})
            rep = self._ok(self._appel_mesure(mesure, "recevoir (pilote : télécharge, écrit le fichier, libère)", "transit_recevoir",
                                              chemin=chemin, file_id=zip_["file_id"], sha256=r["sha256"],
                                              taille=r["taille"], slot=zip_["slot"], jeton=zip_["jeton"]), chemin)
            mesure["pilote"] = rep.get("etapes", {})
            mesure["total_s"] = round(time.time() - t_debut, 3)
            return rep
        except BaseException:
            self.transit_liberer(zip_["slot"], zip_["jeton"])         # idempotent : sans effet si le pilote l'a déjà libéré
            raise

    def heure_locale_de_mtime(self, mtime: float) -> float:
        """mtime (horloge du pilote) -> horloge du clone, pour que `time.time() - getmtime(...)` ait un sens."""
        return mtime + self._decalage


class _FichierLecturePont(io.BytesIO):
    def __init__(self, donnees, name):
        super().__init__(donnees)
        self.name = name


class _FichierEcriturePont(io.BytesIO):
    """Tampon en mémoire ; l'envoi au pilote se fait à la FERMETURE (comme un fichier : close() / sortie de `with`)."""

    def __init__(self, pont, name, mode, initial=b"", seulement_si_modifie=False):
        super().__init__(initial)
        self.name = name
        self._pont = pont
        self._mode_pont = mode
        self._sha0 = hashlib.sha256(initial).hexdigest() if seulement_si_modifie else None

    def close(self):
        if self.closed:
            return
        try:
            donnees = self.getvalue()
            if self._sha0 is None or hashlib.sha256(donnees).hexdigest() != self._sha0:
                self._pont.ecrire(self.name, donnees, self._mode_pont)
        finally:
            super().close()


class _CheminsPont:
    """Remplace `os.path` : fonctions de chemin « Windows » pour les chemins du pilote, accès disque via le pont."""

    _PURES = {"basename", "dirname", "split", "splitext", "normpath", "abspath", "realpath", "isabs", "normcase",
              "join", "relpath", "commonpath", "commonprefix", "expanduser", "expandvars", "splitdrive"}

    def __init__(self, pont, os_reel, est_pilote):
        self._pont, self._os, self._pilote = pont, os_reel, est_pilote

    def _d(self, p):
        try:
            p = self._os.fspath(p)
        except TypeError:
            return False
        return self._pilote(p)

    def __getattr__(self, nom):
        if nom in self._PURES:
            def _pure(*a, **k):
                module = _ntpath_pont if any(self._d(x) for x in a) else self._os.path
                return getattr(module, nom)(*a, **k)
            return _pure
        return getattr(self._os.path, nom)

    def _stat(self, p):
        try:
            return self._pont.stat(self._os.fspath(p))
        except FileNotFoundError:
            return None

    def exists(self, p):
        return self._stat(p) is not None if self._d(p) else self._os.path.exists(p)

    lexists = exists

    def isfile(self, p):
        if not self._d(p):
            return self._os.path.isfile(p)
        st = self._stat(p)
        return bool(st and st["isfile"])

    def isdir(self, p):
        if not self._d(p):
            return self._os.path.isdir(p)
        st = self._stat(p)
        return bool(st and st["isdir"])

    def islink(self, p):
        return False if self._d(p) else self._os.path.islink(p)

    def getmtime(self, p):
        if not self._d(p):
            return self._os.path.getmtime(p)
        return self._pont.heure_locale_de_mtime(self._pont.stat(self._os.fspath(p))["mtime"])

    getctime = getmtime
    getatime = getmtime

    def getsize(self, p):
        return self._pont.stat(self._os.fspath(p))["size"] if self._d(p) else self._os.path.getsize(p)


class _OsPont:
    """Remplace le module `os` dans l'espace de noms du clone : tout ce qui n'est PAS un chemin du pilote va au vrai `os`."""

    _NON_SUPPORTES = ("truncate", "symlink", "link", "readlink", "startfile", "chown", "mkfifo", "mknod")

    def __init__(self, pont, os_reel=None, est_pilote=chemin_est_pilote):
        self.__dict__["_pont"] = pont
        self.__dict__["_os"] = os_reel or os
        self.__dict__["_pilote"] = est_pilote
        self.__dict__["path"] = _CheminsPont(pont, self._os, est_pilote)

    def _d(self, p):
        try:
            p = self._os.fspath(p)
        except TypeError:
            return False
        return self._pilote(p)

    def __getattr__(self, nom):
        attribut = getattr(self._os, nom)
        if nom in self._NON_SUPPORTES and callable(attribut):
            def _garde(*a, **k):
                if a and self._d(a[0]):
                    raise NotImplementedError("os.%s n'est pas supporté sur un chemin du PC pilote (pont fichiers)." % nom)
                return attribut(*a, **k)
            return _garde
        return attribut

    def listdir(self, path="."):
        return self._pont.listdir(self._os.fspath(path)) if self._d(path) else self._os.listdir(path)

    def stat(self, path, *a, **k):
        if not self._d(path):
            return self._os.stat(path, *a, **k)
        st = self._pont.stat(self._os.fspath(path))
        m = self._pont.heure_locale_de_mtime(st["mtime"])
        mode = (_stat_pont.S_IFDIR | 0o755) if st["isdir"] else (_stat_pont.S_IFREG | 0o644)
        return _types_pont.SimpleNamespace(st_size=st["size"], st_mtime=m, st_atime=m, st_ctime=m,
                                           st_mtime_ns=int(m * 1e9), st_mode=mode)

    def lstat(self, path, *a, **k):
        return self.stat(path, *a, **k)

    def access(self, path, mode, *a, **k):
        if not self._d(path):
            return self._os.access(path, mode, *a, **k)
        return self.path.exists(path)

    def scandir(self, path="."):
        if not self._d(path):
            return self._os.scandir(path)
        base = self._os.fspath(path)
        rep = self._pont._ok(self._pont.appeler("scandir", chemin=base), base)
        return _ScandirPont(self._pont, base, rep["entrees"])

    def rmdir(self, path, *a, **k):
        if not self._d(path):
            return self._os.rmdir(path, *a, **k)
        self._pont._ok(self._pont.appeler("rmdir", chemin=self._os.fspath(path)), path)

    def removedirs(self, name):
        if not self._d(name):
            return self._os.removedirs(name)
        tete, queue = _ntpath_pont.split(self._os.fspath(name))
        if not queue:
            tete, queue = _ntpath_pont.split(tete)
        self.rmdir(name)
        while tete and queue:
            try:
                self.rmdir(tete)
            except OSError:
                break
            tete, queue = _ntpath_pont.split(tete)

    def chmod(self, path, mode, *a, **k):
        if not self._d(path):
            return self._os.chmod(path, mode, *a, **k)
        self._pont._ok(self._pont.appeler("chmod", chemin=self._os.fspath(path), mode=int(mode)), path)

    def utime(self, path, times=None, *a, **k):
        if not self._d(path):
            return self._os.utime(path, times, *a, **k)
        self._pont._ok(self._pont.appeler("utime", chemin=self._os.fspath(path), temps=list(times) if times else None), path)

    def remove(self, path, *a, **k):
        if not self._d(path):
            return self._os.remove(path, *a, **k)
        self._pont._ok(self._pont.appeler("supprimer", chemin=self._os.fspath(path)), path)

    unlink = remove

    def _deux(self, nom, src, dst, reel):
        ds, dd = self._d(src), self._d(dst)
        if not ds and not dd:
            return reel(src, dst)
        if ds != dd:
            raise OSError(errno.EXDEV, "os.%s entre le clone et le PC pilote n'est pas possible" % nom, src)
        self._pont._ok(self._pont.appeler(nom, source=self._os.fspath(src), destination=self._os.fspath(dst)), src)

    def rename(self, src, dst, *a, **k):
        return self._deux("renommer", src, dst, lambda s, d: self._os.rename(s, d, *a, **k))

    def replace(self, src, dst, *a, **k):
        return self._deux("remplacer", src, dst, lambda s, d: self._os.replace(s, d, *a, **k))

    def makedirs(self, name, mode=0o777, exist_ok=False):
        if not self._d(name):
            return self._os.makedirs(name, mode, exist_ok)
        self._pont._ok(self._pont.appeler("creer_dossiers", chemin=self._os.fspath(name), exist_ok=bool(exist_ok)), name)

    def mkdir(self, path, mode=0o777, *a, **k):
        if not self._d(path):
            return self._os.mkdir(path, mode, *a, **k)
        parent = _ntpath_pont.dirname(self._os.fspath(path))
        if not self.path.isdir(parent):
            raise FileNotFoundError(errno.ENOENT, "dossier parent inexistant", path)
        if self.path.exists(path):
            raise FileExistsError(errno.EEXIST, "existe déjà", path)
        self.makedirs(path)

    def open(self, path, flags, mode=0o777, *a, **k):
        if not self._d(path):
            return self._os.open(path, flags, mode, *a, **k)
        return self._pont.fd_ouvrir(self._os.fspath(path), flags, mode)

    def write(self, fd, data):
        return self._pont.fd_ecrire(fd, data) if self._pont.fd_distant(fd) else self._os.write(fd, data)

    def close(self, fd):
        return self._pont.fd_fermer(fd) if self._pont.fd_distant(fd) else self._os.close(fd)

    def fsync(self, fd):
        return None if self._pont.fd_distant(fd) else self._os.fsync(fd)

    def walk(self, top, topdown=True, onerror=None, followlinks=False):
        if not self._d(top):
            yield from self._os.walk(top, topdown, onerror, followlinks)
            return
        top = self._os.fspath(top)
        try:
            noms = self._pont.listdir(top)
        except OSError as e:
            if onerror is not None:
                onerror(e)
            return
        dirs = [n for n in noms if self.path.isdir(_ntpath_pont.join(top, n))]
        fichiers = [n for n in noms if n not in dirs]
        if topdown:
            yield top, dirs, fichiers
        for d in list(dirs):
            yield from self.walk(_ntpath_pont.join(top, d), topdown, onerror, followlinks)
        if not topdown:
            yield top, dirs, fichiers


def _fabriquer_open_pont(pont, os_reel, est_pilote):
    def open_pont(file, mode="r", buffering=-1, encoding=None, errors=None, newline=None, closefd=True, opener=None):
        try:
            chemin = os_reel.fspath(file)
        except TypeError:
            chemin = None
        if not (isinstance(chemin, str) and est_pilote(chemin)):
            return _builtins_pont.open(file, mode, buffering, encoding, errors, newline, closefd, opener)
        m = set(mode.replace("U", ""))
        if not m <= set("rwxabt+") or len(m & set("rwxa")) != 1 or ("b" in m and "t" in m):
            raise ValueError("mode de fichier invalide : %r" % mode)
        plus = "+" in m
        binaire = "b" in m
        if binaire and encoding is not None:
            raise ValueError("le mode binaire n'accepte pas d'encodage")
        if plus:
            if "r" in m:
                initial = pont.lire_tout(chemin)
            elif "a" in m:
                try:
                    initial = pont.lire_tout(chemin)
                except FileNotFoundError:
                    initial = b""
            else:
                if "x" in m and pont.appeler("stat", chemin=chemin).get("ok"):
                    raise FileExistsError(errno.EEXIST, "le fichier existe déjà", chemin)
                initial = b""
            tampon = _FichierEcriturePont(pont, chemin, "w", initial if ("r" in m or "a" in m) else b"", True)
            if "r" not in m and "w" not in m and "x" not in m:
                tampon.seek(0, 2)
        elif "r" in m:
            tampon = _FichierLecturePont(pont.lire_tout(chemin), chemin)
        else:
            ecriture = "w" if "w" in m else "x" if "x" in m else "a"
            if ecriture == "x" and pont.appeler("stat", chemin=chemin).get("ok"):
                raise FileExistsError(errno.EEXIST, "le fichier existe déjà", chemin)
            tampon = _FichierEcriturePont(pont, chemin, ecriture)
        if binaire:
            return tampon
        texte = io.TextIOWrapper(tampon, encoding=encoding or "utf-8", errors=errors or "strict", newline=newline)
        texte.mode = mode
        return texte
    return open_pont


class _EntreePont:
    def __init__(self, pont, dossier, ligne):
        self.name = ligne[0]
        self.path = _ntpath_pont.join(dossier, ligne[0])
        self._d, self._f, self._taille, self._mtime = ligne[1], ligne[2], ligne[3], ligne[4]
        self._pont = pont

    def is_dir(self, *, follow_symlinks=True):
        return self._d

    def is_file(self, *, follow_symlinks=True):
        return self._f

    def is_symlink(self):
        return False

    def stat(self, *, follow_symlinks=True):
        m = self._pont.heure_locale_de_mtime(self._mtime)
        return _types_pont.SimpleNamespace(
            st_size=self._taille, st_mtime=m, st_atime=m, st_ctime=m, st_mtime_ns=int(m * 1e9),
            st_mode=(_stat_pont.S_IFDIR | 0o755) if self._d else (_stat_pont.S_IFREG | 0o644))

    def inode(self):
        return 0

    def __fspath__(self):
        return self.path

    def __repr__(self):
        return "<EntreePont %r>" % self.name


class _ScandirPont:
    """Remplace os.scandir() pour un dossier du pilote (itérable ET gestionnaire de contexte, comme l'original)."""

    def __init__(self, pont, dossier, lignes):
        self._it = iter([_EntreePont(pont, dossier, l) for l in lignes])

    def __iter__(self):
        return self._it

    def __next__(self):
        return next(self._it)

    def __enter__(self):
        return self

    def __exit__(self, *exc):
        return False

    def close(self):
        pass


class _GlobPont:
    """Remplace le module `glob` : un motif du pilote est résolu SUR le pilote."""

    def __init__(self, pont, glob_reel, est_pilote):
        self._pont, self._reel, self._pilote = pont, glob_reel, est_pilote

    def glob(self, pathname, *args, recursive=False, **k):
        p = os.fspath(pathname)
        if not self._pilote(p):
            return self._reel.glob(pathname, *args, recursive=recursive, **k)
        return list(self._pont._ok(self._pont.appeler("glob", motif=p, recursive=bool(recursive)), p)["chemins"])

    def iglob(self, pathname, *args, **k):
        return iter(self.glob(pathname, *args, **k))

    def __getattr__(self, nom):
        return getattr(self._reel, nom)


class _ShutilPont:
    """Remplace le module `shutil` : copier/déplacer/supprimer entre le clone et le PC pilote, dans les deux sens."""

    def __init__(self, pont, proxy_os, shutil_reel, est_pilote, open_pont):
        self._pont, self._os, self._reel, self._pilote, self._open = pont, proxy_os, shutil_reel, est_pilote, open_pont

    def _d(self, p):
        try:
            return self._pilote(os.fspath(p))
        except TypeError:
            return False

    def _cible(self, src, dst):
        """Si dst est un dossier, shutil copie DANS ce dossier."""
        dst = os.fspath(dst)
        if self._os.path.isdir(dst):
            return self._os.path.join(dst, self._os.path.basename(os.fspath(src)))
        return dst

    def _copie(self, src, dst, op_pilote, **options):
        ds, dd = self._d(src), self._d(dst)
        if ds and dd:
            dst = self._cible(src, dst)
            return self._pont._ok(self._pont.appeler(op_pilote, source=os.fspath(src), destination=dst, **options), src)["destination"]
        dst = self._cible(src, dst)
        with self._open(src, "rb") as f:
            donnees = f.read()
        with self._open(dst, "wb") as g:
            g.write(donnees)
        return dst

    def copyfile(self, src, dst, *a, **k):
        if not (self._d(src) or self._d(dst)):
            return self._reel.copyfile(src, dst, *a, **k)
        ds, dd = self._d(src), self._d(dst)
        if ds and dd:
            return self._pont._ok(self._pont.appeler("copier", source=os.fspath(src), destination=os.fspath(dst), metadonnees=False), src)["destination"]
        with self._open(src, "rb") as f, self._open(dst, "wb") as g:
            g.write(f.read())
        return dst

    def copy(self, src, dst, *a, **k):
        if not (self._d(src) or self._d(dst)):
            return self._reel.copy(src, dst, *a, **k)
        return self._copie(src, dst, "copier", metadonnees=False)

    def copy2(self, src, dst, *a, **k):
        if not (self._d(src) or self._d(dst)):
            return self._reel.copy2(src, dst, *a, **k)
        return self._copie(src, dst, "copier", metadonnees=True)

    def copytree(self, src, dst, *a, dirs_exist_ok=False, **k):
        if not (self._d(src) or self._d(dst)):
            return self._reel.copytree(src, dst, *a, dirs_exist_ok=dirs_exist_ok, **k)
        if self._d(src) and self._d(dst) and not a and not k:
            self._pont._ok(self._pont.appeler("copytree", source=os.fspath(src), destination=os.fspath(dst), dirs_exist_ok=bool(dirs_exist_ok)), src)
            return dst
        src, dst = os.fspath(src), os.fspath(dst)       # sens clone <-> pilote : on parcourt et on copie fichier par fichier
        self._os.makedirs(dst, exist_ok=dirs_exist_ok)
        for racine, dossiers, fichiers in self._os.walk(src):
            rel = self._os.path.relpath(racine, src)
            cible = dst if rel in (".", "") else self._os.path.join(dst, rel)
            for d in dossiers:
                self._os.makedirs(self._os.path.join(cible, d), exist_ok=True)
            for f in fichiers:
                self.copy2(self._os.path.join(racine, f), self._os.path.join(cible, f))
        return dst

    def move(self, src, dst, *a, **k):
        if not (self._d(src) or self._d(dst)):
            return self._reel.move(src, dst, *a, **k)
        if self._d(src) and self._d(dst):
            return self._pont._ok(self._pont.appeler("deplacer", source=os.fspath(src), destination=self._cible(src, dst)), src)["destination"]
        est_dossier = self._os.path.isdir(src)
        cible = self._cible(src, dst)
        if est_dossier:
            self.copytree(src, cible)
            self.rmtree(src)
        else:
            self.copy2(src, cible)
            self._os.remove(src)
        return cible

    def rmtree(self, path, ignore_errors=False, onerror=None, *a, **k):
        if not self._d(path):
            return self._reel.rmtree(path, ignore_errors, onerror, *a, **k)
        try:
            self._pont._ok(self._pont.appeler("rmtree", chemin=os.fspath(path), ignorer_erreurs=bool(ignore_errors)), path)
        except OSError:
            if ignore_errors:
                return
            if onerror is not None:
                onerror(self._os.rmdir, path, sys.exc_info())
                return
            raise

    def __getattr__(self, nom):
        return getattr(self._reel, nom)


def _fabriquer_pathlib_pont(pont, proxy_os, open_pont, glob_pont, est_pilote, pathlib_reel):
    """Remplace `pathlib` : Path("D:/...") devient un chemin du PC pilote (syntaxe Windows) dont les méthodes de
    fichier passent par le pont ; tout autre Path reste un vrai pathlib.Path."""

    class PathPilote(pathlib_reel.PureWindowsPath):
        __slots__ = ()

        def exists(self, **k):
            return proxy_os.path.exists(str(self))

        def is_file(self):
            return proxy_os.path.isfile(str(self))

        def is_dir(self):
            return proxy_os.path.isdir(str(self))

        def is_symlink(self):
            return False

        def stat(self, **k):
            return proxy_os.stat(str(self))

        lstat = stat

        def iterdir(self):
            for nom in proxy_os.listdir(str(self)):
                yield self / nom

        def open(self, mode="r", buffering=-1, encoding=None, errors=None, newline=None):
            return open_pont(str(self), mode, buffering, encoding, errors, newline)

        def read_text(self, encoding=None, errors=None):
            with self.open("r", encoding=encoding, errors=errors) as f:
                return f.read()

        def read_bytes(self):
            return pont.lire_tout(str(self))

        def write_text(self, data, encoding=None, errors=None, newline=None):
            with self.open("w", encoding=encoding, errors=errors, newline=newline) as f:
                return f.write(data)

        def write_bytes(self, data):
            data = bytes(memoryview(data))
            pont.ecrire(str(self), data, "w")
            return len(data)

        def mkdir(self, mode=0o777, parents=False, exist_ok=False):
            if parents:
                return proxy_os.makedirs(str(self), exist_ok=exist_ok)
            try:
                proxy_os.mkdir(str(self), mode)
            except FileExistsError:
                if not (exist_ok and self.is_dir()):
                    raise

        def rmdir(self):
            proxy_os.rmdir(str(self))

        def unlink(self, missing_ok=False):
            try:
                proxy_os.remove(str(self))
            except FileNotFoundError:
                if not missing_ok:
                    raise

        def rename(self, target):
            proxy_os.rename(str(self), str(target))
            return type(self)(target)

        def replace(self, target):
            proxy_os.replace(str(self), str(target))
            return type(self)(target)

        def touch(self, mode=0o666, exist_ok=True):
            if self.exists():
                if not exist_ok:
                    raise FileExistsError(errno.EEXIST, "existe déjà", str(self))
                return
            pont.ecrire(str(self), b"", "w")

        def glob(self, pattern, **k):
            return iter([type(self)(c) for c in glob_pont.glob(str(self / pattern), recursive="**" in pattern)])

        def rglob(self, pattern, **k):
            return iter([type(self)(c) for c in glob_pont.glob(str(self / "**" / pattern), recursive=True)])

        def resolve(self, strict=False):
            return type(self)(_ntpath_pont.normpath(str(self)))

        absolute = resolve

        def expanduser(self):
            return self

    class _MetaPath(type):
        def __getattr__(cls, nom):
            return getattr(pathlib_reel.Path, nom)

        def __instancecheck__(cls, instance):
            return isinstance(instance, (pathlib_reel.Path, PathPilote))

    class Path(metaclass=_MetaPath):
        def __new__(cls, *parties):
            for p in parties:
                try:
                    if est_pilote(os.fspath(p)):
                        return PathPilote(*parties)
                except TypeError:
                    pass
            return pathlib_reel.Path(*parties)

    class _ModulePathlib:
        def __init__(self):
            self.Path = Path
            self.PathPilote = PathPilote

        def __getattr__(self, nom):
            return getattr(pathlib_reel, nom)

    return _ModulePathlib()


def pont_fichiers_actif_par_defaut() -> bool:
    """Actif sur un clone distant (hors Windows) ; AUTONIAX_PONT_FICHIERS=1/0 force."""
    v = (os.environ.get("AUTONIAX_PONT_FICHIERS") or "").strip().lower()
    if v in ("1", "oui", "true", "on"):
        return True
    if v in ("0", "non", "false", "off"):
        return False
    return sys.platform != "win32"


def installer_pont_fichiers(namespace: dict, emetteur, *, est_pilote=chemin_est_pilote, os_reel=None, delai_total=90.0):
    """Branche le pont dans l'espace de noms d'exécution du clone : `os` et `open` y deviennent des proxys, y compris
    pour `import os`, `import os.path`, `from os import ...` écrits par le notebook. Idempotent : retourne le pont déjà
    installé s'il existe. Le code du notebook n'est pas modifié."""
    deja = namespace.get("__pont_pilote__")
    if isinstance(deja, ClientPontPilote):
        return deja
    os_reel = os_reel or os
    pont = ClientPontPilote(emetteur, delai_total=delai_total)
    proxy_os = _OsPont(pont, os_reel, est_pilote)
    b = dict(vars(_builtins_pont))
    open_pont = _fabriquer_open_pont(pont, os_reel, est_pilote)
    b["open"] = open_pont
    glob_pont = _GlobPont(pont, _glob_pont, est_pilote)
    shutil_pont = _ShutilPont(pont, proxy_os, shutil, est_pilote, open_pont)
    pathlib_pont = _fabriquer_pathlib_pont(pont, proxy_os, open_pont, glob_pont, est_pilote, _pathlib_pont)
    modules_pont = {"glob": glob_pont, "shutil": shutil_pont, "pathlib": pathlib_pont}

    def _import_pont(name, globals=None, locals=None, fromlist=(), level=0):
        if level == 0:
            if name == "os":
                return proxy_os
            if name == "os.path":
                return proxy_os.path if fromlist else proxy_os
            if name in modules_pont:
                return modules_pont[name]
        return _builtins_pont.__import__(name, globals, locals, fromlist, level)

    b["__import__"] = _import_pont
    namespace["__builtins__"] = b
    namespace["os"] = proxy_os
    namespace["__pont_pilote__"] = pont
    # AJOUT (Transit Drive) -- fonctions exposées au code du notebook (Task), sans toucher à son `os`/`open`.
    namespace["transit_lire_du_pilote"] = pont.transit_lire_du_pilote
    namespace["transit_envoyer_au_pilote"] = pont.transit_envoyer_au_pilote
    namespace["appel_logique_pilote"] = pont.appel_logique
    namespace["transit_mesurer"] = pont.transit_mesurer
    namespace["transit_derniere_mesure"] = lambda: dict(getattr(pont, "mesure_transit", {}) or {})
    return pont


def lire_result_save_path_dans_code(code: str) -> str:
    """Côté PILOTE : lit statiquement la valeur de RESULT_SAVE_PATH dans le
    texte de cellule_variables, SANS l'exécuter (en mode réseau le pilote
    n'a aucun namespace partagé avec l'exécution, cf. prefixer_code_avec_
    workspace). Retourne "" si la variable est absente, non littérale ou
    vide -- l'utilisateur est libre de la supprimer (repli silencieux,
    même principe que LIST_TASKS)."""
    if not code:
        return ""
    correspondance = re.search(r"^[ \t]*RESULT_SAVE_PATH[ \t]*=(?!=)[ \t]*(.*)$", code, re.MULTILINE)
    if correspondance is None:
        return ""
    reste = correspondance.group(1)
    position_diese = _position_debut_commentaire_python(reste)
    texte_valeur = (reste if position_diese == -1 else reste[:position_diese]).strip()
    if not texte_valeur:
        return ""
    try:
        valeur = ast.literal_eval(texte_valeur)
    except (ValueError, SyntaxError):
        return ""
    return valeur.strip() if isinstance(valeur, str) else ""


NOM_FONCTION_RESULT_OUTPUT_HANDLER = "RESULT_OUTPUT_HANDLER"


def extraire_result_output_handler_du_code(code: str):
    """Côté PILOTE (SPEC_result_output_handler.md) : isole le bloc
    `def RESULT_OUTPUT_HANDLER(...)` dans le texte de cellule_variables,
    SANS exécuter le reste de la cellule (RETRY, LIST_TASKS...), puis
    exécute UNIQUEMENT ce bloc dans un namespace dédié pour en extraire
    l'objet fonction. Jamais envoyé au sAutoniax.

    Le bloc est repéré par `ast` (nœud FunctionDef de niveau module) et
    non par regex : les numéros de ligne de l'AST (lineno/end_lineno)
    délimitent exactement le `def` complet, y compris ses lignes de
    corps multi-lignes, ses chaînes entre triple-quotes et ses
    commentaires -- ce qu'une capture par indentation gérerait mal.

    Retourne un tuple (fonction, erreur) :
      - (callable, None)  : fonction extraite, prête à être appelée ;
      - (None, None)      : aucune RESULT_OUTPUT_HANDLER déclarée (code
                            vide, ancien projet non migré, fonction
                            supprimée par l'utilisateur) -> l'appelant
                            retombe silencieusement sur le comportement
                            par défaut (RESULT_SAVE_PATH), cf. spec point 4 ;
      - (None, "message") : la fonction EXISTE mais n'a pas pu être
                            extraite/exécutée (erreur de syntaxe dans le
                            code collé par l'utilisateur...) -> l'appelant
                            retombe aussi sur le comportement par défaut,
                            MAIS journalise le message (jamais silencieux).
    Jamais d'exception vers l'appelant."""
    if not code or NOM_FONCTION_RESULT_OUTPUT_HANDLER not in code:
        return None, None
    try:
        arbre = ast.parse(code)
    except SyntaxError as e:
        # Le code de la cellule entière est invalide (typiquement : une
        # erreur de syntaxe dans une AUTRE partie de la cellule). On tente
        # quand même d'isoler le bloc du handler, ligne par ligne, avant
        # de renoncer -- cf. _isoler_bloc_def_par_indentation.
        bloc = _isoler_bloc_def_par_indentation(code, NOM_FONCTION_RESULT_OUTPUT_HANDLER)
        if bloc is None:
            return None, None
        try:
            ast.parse(bloc)
        except SyntaxError as e_bloc:
            return None, f"erreur de syntaxe dans {NOM_FONCTION_RESULT_OUTPUT_HANDLER} (ligne {e_bloc.lineno}) : {e_bloc.msg}"
        texte_bloc = bloc
    else:
        noeud = None
        for candidat in arbre.body:
            if isinstance(candidat, (ast.FunctionDef, ast.AsyncFunctionDef)) and candidat.name == NOM_FONCTION_RESULT_OUTPUT_HANDLER:
                noeud = candidat  # la DERNIÈRE définition gagne, comme en Python
        if noeud is None:
            return None, None
        if isinstance(noeud, ast.AsyncFunctionDef):
            return None, f"{NOM_FONCTION_RESULT_OUTPUT_HANDLER} ne peut pas être async (fonction synchrone attendue)."
        lignes = code.splitlines()
        # Les décorateurs précèdent `lineno` : on remonte au plus haut.
        debut = min([noeud.lineno] + [d.lineno for d in noeud.decorator_list])
        texte_bloc = "\n".join(lignes[debut - 1:noeud.end_lineno]) + "\n"
    # Namespace DÉDIÉ et isolé : jamais le namespace d'exécution du notebook,
    # jamais un état interne d'AutoniaX. __builtins__ standard : les `import`
    # dans le corps de la fonction (json, pathlib, datetime...) fonctionnent
    # comme dans n'importe quel script Python.
    #
    # AJOUT (PATCH v4, demande explicite utilisateur -- "ce code la
    # s'exécute en local quand la tache se termine", RESULT_OUTPUT_HANDLER
    # doit pouvoir marquer sa propre tâche terminée) : SEULE
    # marquer_tache_terminee est ajoutée à ce namespace, explicitement PAS
    # les autres fonctions prédéfinies (marquer_tache_en_attente,
    # extraire_texte_fichier, ecrire_texte_fichier...), qui restent
    # inaccessibles ici par design (namespace isolé). L'utilisateur doit
    # toujours fournir lui-même `fichier_source` à l'appel, exactement
    # comme dans le code normal de la cellule (cf. docstring de
    # marquer_tache_terminee) -- rien n'est deviné automatiquement.
    namespace_handler: dict = {
        "__name__": "autoniax_result_output_handler",
        "marquer_tache_terminee": marquer_tache_terminee,
    }
    try:
        exec(compile(texte_bloc, f"<{NOM_FONCTION_RESULT_OUTPUT_HANDLER}>", "exec"), namespace_handler)
    except Exception as e:
        return None, f"exécution de la définition de {NOM_FONCTION_RESULT_OUTPUT_HANDLER} impossible : {e!r}"
    fonction = namespace_handler.get(NOM_FONCTION_RESULT_OUTPUT_HANDLER)
    if not callable(fonction):
        return None, f"{NOM_FONCTION_RESULT_OUTPUT_HANDLER} n'est pas une fonction appelable."
    return fonction, None


def retirer_result_output_handler_du_code(code: str) -> str:
    """Retourne une COPIE de `code` sans le bloc `def RESULT_OUTPUT_HANDLER`
    (toutes ses lignes : signature, corps, commentaires internes). Sert aux
    détecteurs de « variables dynamiques » (cf. extraire_variables_
    dynamiques_task) : leur regex est insensible à l'indentation, donc
    sans cette étape le paramètre `valeur` et les locales du corps
    (`dossier`, `horodatage`...) seraient pris à tort pour des variables
    dynamiques mappables à un fichier. `code` est retourné inchangé si la
    fonction n'y figure pas. Ne modifie jamais le code réel du Task."""
    if not code or NOM_FONCTION_RESULT_OUTPUT_HANDLER not in code:
        return code
    lignes = code.splitlines()
    resultat: list = []
    i = 0
    while i < len(lignes):
        if re.match(rf"def[ \t]+{re.escape(NOM_FONCTION_RESULT_OUTPUT_HANDLER)}[ \t]*\(", lignes[i]):
            i += 1
            # saute le corps : lignes indentées ou vides, jusqu'à la
            # première ligne non vide à indentation 0
            while i < len(lignes) and (not lignes[i].strip() or lignes[i][0].isspace()):
                i += 1
            continue
        resultat.append(lignes[i])
        i += 1
    return "\n".join(resultat) + ("\n" if code.endswith("\n") else "")


def _isoler_bloc_def_par_indentation(code: str, nom_fonction: str):
    """Repli de extraire_result_output_handler_du_code quand ast.parse()
    échoue sur la cellule ENTIÈRE (une erreur de syntaxe AILLEURS dans la
    cellule ne doit pas empêcher un handler bien écrit de s'exécuter).
    Repère la ligne `def <nom_fonction>(` à indentation 0, puis prend
    toutes les lignes suivantes tant qu'elles sont indentées ou vides
    (fin du bloc = première ligne non vide à indentation 0). Retourne le
    texte du bloc, ou None si la fonction n'est pas trouvée."""
    lignes = code.splitlines()
    debut = None
    for i, ligne in enumerate(lignes):
        if re.match(rf"def[ \t]+{re.escape(nom_fonction)}[ \t]*\(", ligne):
            debut = i
    if debut is None:
        return None
    fin = debut + 1
    while fin < len(lignes):
        ligne = lignes[fin]
        if ligne.strip() and not ligne[0].isspace():
            break
        fin += 1
    # Retire les lignes vides de queue : sans effet sur le code, plus propre.
    while fin > debut + 1 and not lignes[fin - 1].strip():
        fin -= 1
    return "\n".join(lignes[debut:fin]) + "\n"


def valeur_pour_result_output_handler(result_output: Optional[dict]) -> tuple:
    """Côté PILOTE : convertit le dict de TRANSPORT `result_output` (cf.
    _serialiser_result_output) en ce que RESULT_OUTPUT_HANDLER reçoit comme
    unique paramètre `valeur`. Retourne (ok, valeur_ou_message).

      - {"type": "json", "valeur": X}  -> X tel quel (dict/liste/str/
        nombre/bool -- le même objet que l'utilisateur avait mis dans
        RESULT_OUTPUT côté sAutoniax) ;
      - {"type": "fichier", ...}       -> le fichier reçu est écrit dans
        un dossier TEMPORAIRE du pilote et son CHEMIN (str) est passé,
        conformément à la spec ("un chemin de fichier si RESULT_OUTPUT
        était un fichier") : le handler peut le copier/déplacer où il
        veut. Le nom de base est assaini (_nom_fichier_resultat_sur) --
        le contenu vient du sAutoniax, donc non fiable ;
      - {"type": "erreur", ...}        -> (False, message) : le handler
        n'est PAS appelé, l'erreur reste rapportée telle quelle.
    Jamais d'exception vers l'appelant."""
    type_resultat = (result_output or {}).get("type")
    if type_resultat == "json":
        return True, result_output.get("valeur")
    if type_resultat == "fichier":
        try:
            contenu = base64.b64decode(result_output.get("contenu_b64", ""))
            dossier_temp = Path(tempfile.mkdtemp(prefix="autoniax_result_"))
            cible = dossier_temp / _nom_fichier_resultat_sur(result_output.get("nom", ""))
            cible.write_bytes(contenu)
            return True, str(cible)
        except (OSError, ValueError) as e:
            return False, f"réception du fichier RESULT_OUTPUT impossible : {e!r}"
    if type_resultat == "erreur":
        return False, str(result_output.get("message", "erreur inconnue côté sAutoniax"))
    return False, f"type de RESULT_OUTPUT inconnu : {type_resultat!r}"


def _nom_fichier_resultat_sur(nom: str) -> str:
    """Assainit un nom de fichier venant du sAutoniax (donc NON fiable) :
    ne garde que le nom de base -- jamais de séparateur ni de "..", pour
    qu'un résultat malveillant ou mal formé ne puisse JAMAIS écrire hors
    de RESULT_SAVE_PATH (path traversal)."""
    base = os.path.basename((nom or "").replace("\\", "/")).strip()
    nettoye = "".join(c if (c.isalnum() or c in "._- ") else "_" for c in base).strip(" .")
    return nettoye or "resultat"


def ecrire_result_output_sur_disque(result_output: Optional[dict], dossier_sauvegarde: str,
                                     nom_profil: str, horodatage: Optional[float] = None) -> tuple:
    """Côté PILOTE : range `result_output` (dict produit par _serialiser_
    result_output côté sAutoniax) sous `dossier_sauvegarde`, dans un
    sous-dossier PAR PROFIL (jamais d'écrasement entre profils : deux
    sAutoniax peuvent avoir un profil de même nom, le nom de fichier
    inclut en plus un horodatage). Retourne (ok: bool, message: str) --
    jamais d'exception. `result_output` None (rien à ranger) ->
    (True, "") sans rien écrire ; `dossier_sauvegarde` vide alors qu'il y a
    un résultat -> (False, explication) plutôt qu'un échec silencieux."""
    if not result_output:
        return True, ""
    if not dossier_sauvegarde:
        return False, "RESULT_OUTPUT reçu mais RESULT_SAVE_PATH n'est pas défini (variable dynamique vide)."
    type_resultat = result_output.get("type")
    if type_resultat == "erreur":
        return False, str(result_output.get("message", "erreur inconnue côté sAutoniax"))
    try:
        dossier = Path(dossier_sauvegarde) / _nom_dossier_valide(nom_profil)
        dossier.mkdir(parents=True, exist_ok=True)
        horodatage_txt = datetime.fromtimestamp(horodatage or time.time()).strftime("%Y%m%d_%H%M%S")
        if type_resultat == "json":
            cible = dossier / f"{horodatage_txt}_resultat.json"
            cible.write_text(
                json.dumps(result_output.get("valeur"), ensure_ascii=False, indent=2), encoding="utf-8",
            )
        elif type_resultat == "fichier":
            contenu = base64.b64decode(result_output.get("contenu_b64", ""))
            nom = _nom_fichier_resultat_sur(result_output.get("nom", ""))
            cible = dossier / f"{horodatage_txt}_{nom}"
            cible.write_bytes(contenu)
        else:
            return False, f"type de RESULT_OUTPUT inconnu : {type_resultat!r}"
    except (OSError, ValueError) as e:
        return False, f"écriture de RESULT_OUTPUT impossible : {e!r}"
    return True, str(cible)


# BUGFIX (LIST_TASKS persisté rempli dans project.json en dehors de toute
# séquence clone -- bug constaté sur données réelles, Task "ImageCaptions")
# -- demande explicite utilisateur, suite à l'échec des tentatives
# précédentes de blindage site-par-site (_code_a_persister_depuis_editeur,
# NotebookPasteHandleCompact, etc.) : plutôt que de traquer et blinder
# CHAQUE site qui écrit task.cellule_variables.code (liste non fermée --
# un futur site d'écriture, une édition manuelle du JSON, un import, un
# copier/coller d'un fichier externe déjà pollué... pourraient tous
# réintroduire le même symptôme), un DERNIER FILET est posé ici, au point
# de passage UNIQUE de toute sauvegarde (Project.save, cf. son appel
# ci-dessous) : quel que soit le chemin qui a rempli LIST_TASKS dans le
# code de cellule_variables, il ne peut JAMAIS atteindre le disque rempli.
#
# Opère sur le DICT déjà produit par Project.to_dict(), jamais sur les
# objets Task/TaskCellule en mémoire (self.tasks) -- la sérialisation est
# nettoyée, l'état vivant de l'application (widgets, namespace d'exécution
# en cours, etc.) n'est jamais touché par cette fonction, qui ne fait
# qu'écrire un texte de code légèrement différent dans le dict juste avant
# json.dumps. Un run en cours n'est donc jamais affecté : l'injection
# runtime réelle de LIST_TASKS reste namespace["LIST_TASKS"] = [...]
# (cf. _lancer_sequence_clone_profil_local / _executer_cellule), totalement
# indépendante de ce qui est écrit sur disque.
#
# N'agit QUE sur la valeur de LIST_TASKS elle-même (via
# remplacer_valeur_list_tasks, qui ne touche que cette ligne, indentation
# et commentaire de fin de ligne compris) -- jamais sur le reste du code
# de cellule_variables (RETRY, TIMEOUT, PROMPT, etc., tous laissés
# strictement intacts).
def _nettoyer_list_tasks_avant_sauvegarde(data: dict) -> dict:
    """Force LIST_TASKS = [] dans le code de cellule_variables de CHAQUE
    task du dict `data` (déjà produit par Project.to_dict()), si et
    seulement si une valeur non vide y est actuellement écrite en dur.
    Modifie `data` EN PLACE (et le retourne aussi, par confort d'appel) --
    sans effet si cellule_variables est absente, si son code ne déclare
    pas LIST_TASKS du tout (l'utilisateur a supprimé la ligne : rien à
    faire, cf. _localiser_affectation_list_tasks), ou si la valeur déjà
    présente est déjà "[]" (cas normal, écriture évitée pour ne pas
    perturber inutilement un futur diff)."""
    for task_dict in data.get("tasks", []) or []:
        cellule_variables = task_dict.get("cellule_variables")
        if not cellule_variables:
            continue
        code = cellule_variables.get("code")
        if not code:
            continue
        valeur_actuelle = valeur_list_tasks_dans_code(code)
        if valeur_actuelle is None or valeur_actuelle == "[]":
            continue
        cellule_variables["code"] = remplacer_valeur_list_tasks(code, "[]")
    return data


def code_variables_avec_workspace_affiche(code: str, elements: list) -> str:
    """Retourne une COPIE du code de `cellule_variables` (jamais modifié
    sur disque/en mémoire -- uniquement pour l'affichage, cf. docstring
    ci-dessus) où la VALEUR de `LIST_TASKS` est remplacée par la liste de
    tâches RÉELLEMENT attribuée à ce profil, avec la même construction
    textuelle que prefixer_code_avec_workspace (litteral_liste_taches).

    PROPRIÉTÉ IMPORTANTE, dont dépend tout le mécanisme d'affichage
    cosmétique : avec `elements` vide ET un code source qui déclare déjà
    `LIST_TASKS = []`, le résultat est RIGOUREUSEMENT IDENTIQUE au code
    source (commentaire compris) -- donc `code_affiche == code_reel`, et
    TaskCelluleWidget.definir_code_affiche en conclut à juste titre qu'il
    n'y a aucun affichage cosmétique en cours (cellule pleinement
    éditable, aucune réconciliation nécessaire à la frappe)."""
    return remplacer_valeur_list_tasks(code, litteral_liste_taches(elements))


def reconcilier_code_edite_avec_workspace_reel(code_edite: str, code_reel: str) -> str:
    """Le code AFFICHÉ dans l'éditeur de cellule_variables peut être une
    vue cosmétique (valeur de LIST_TASKS remplacée par l'attribution du
    profil clone actif, cf. ci-dessus). Si l'utilisateur tape dans cette
    cellule, c'est ce TEXTE AFFICHÉ que l'éditeur renvoie -- le persister
    tel quel écraserait la vraie déclaration `LIST_TASKS = []` du projet
    par une liste de tâches figée, qui n'a rien à faire dans le code
    source (l'attribution est recalculée à chaque fois depuis le fichier
    WORKSPACE, cf. spec section 7 : "PAS persisté sur disque").

    Cette fonction reconstruit donc le code à PERSISTER : tout ce que
    l'utilisateur vient de taper (`code_edite`), mais avec la valeur de
    LIST_TASKS reprise de `code_reel` (le vrai code source sous-jacent).
    Si `code_reel` ne déclare pas LIST_TASKS, `code_edite` est retourné
    inchangé."""
    valeur_reelle = valeur_list_tasks_dans_code(code_reel)
    if valeur_reelle is None:
        return code_edite
    return remplacer_valeur_list_tasks(code_edite, valeur_reelle)


# AJOUT (PATCH v2, SPEC_patch_tasks_json.md section 5.1), MODIFIÉ PATCH v4
# (demande explicite utilisateur : "je ne veux plus que ça mette le path du
# workspace json à la fin de la liste [...] on va fournir nous même le path
# dans le code") : LIST_TASKS ne contient plus le wrapper
# {"donnees": ..., "fichier_source": ...} -- chaque élément est directement
# le dict `donnees` de la tâche. `fichier_source` n'est donc plus lu depuis
# l'élément lui-même : c'est désormais un paramètre EXPLICITE, que le script
# utilisateur fournit lui-même (typiquement une constante déclarée en haut
# de son propre code). Fonction accessible SANS IMPORT dans le namespace du
# Task (même famille que extraire_texte_fichier/ecrire_texte_fichier) pour
# marquer une tâche terminée depuis le script. Reconstruit un TacheWorkspace
# minimal à partir de `tache` + `fichier_source`, puis délègue à
# ecrire_statut_tache_workspace (§4) -- jamais d'exception levée ici,
# cohérent avec le reste du module (repli sûr : entrée malformée ->
# False, pas de crash du script utilisateur).
def marquer_tache_terminee(tache: dict, fichier_source: str) -> bool:
    """Marque `tache` (un élément de LIST_TASKS, donc directement le dict
    `donnees` de la tâche -- PATCH v4, plus de clé "fichier_source" dedans)
    comme terminée dans le fichier WORKSPACE partagé situé à
    `fichier_source` (chemin que le script fournit lui-même -- c'est à
    l'utilisateur de déclarer ce chemin dans son propre code, AutoniaX ne
    l'injecte plus dans LIST_TASKS). Retourne True si l'écriture a réussi,
    False sinon (entrée malformée, fichier introuvable, erreur d'écriture,
    etc.) -- jamais d'exception propagée dans le script utilisateur.

    Usage typique côté script :
        WORKSPACE_FILE = "D:/.../FINAL_WORKSPACE.json"  # défini par l'utilisateur
        for tache in LIST_TASKS:
            images = tache["images"]
            # ... traitement ...
            marquer_tache_terminee(tache, WORKSPACE_FILE)"""
    return _marquer_statut_tache(tache, fichier_source, termine=True)


def marquer_tache_en_attente(tache: dict, fichier_source: str) -> bool:
    """Symétrique de marquer_tache_terminee : remet `tache` à
    "en_attente" dans le fichier WORKSPACE (`fichier_source`) partagé --
    utile pour un script qui détecte lui-même un échec et veut explicitement
    remettre sa tâche en file plutôt que la laisser marquée par défaut.
    Mêmes garanties (jamais d'exception, False si échec)."""
    return _marquer_statut_tache(tache, fichier_source, termine=False)


def _marquer_statut_tache(tache: dict, fichier_source: str, termine: bool) -> bool:
    """Implémentation commune de marquer_tache_terminee/
    marquer_tache_en_attente : reconstruit un TacheWorkspace minimal
    depuis `tache` (élément de LIST_TASKS, PATCH v4 : directement le dict
    donnees) + `fichier_source` (fourni explicitement par l'appelant) et
    délègue à ecrire_statut_tache_workspace. Repli sûr si les arguments
    sont malformés (`tache` pas un dict, "numero" absent/invalide,
    `fichier_source` vide/pas une chaîne) -- False plutôt qu'une exception,
    puisque cette fonction est directement appelée depuis le script
    utilisateur, hors de tout try/except système."""
    if not isinstance(tache, dict):
        return False
    donnees = tache
    numero_brut = donnees.get("numero")
    numero = None
    if isinstance(numero_brut, bool):
        pass  # bool est une sous-classe d'int en Python -- exclu explicitement
    elif isinstance(numero_brut, int):
        numero = numero_brut
    elif isinstance(numero_brut, str):
        try:
            numero = int(numero_brut.strip())
        except ValueError:
            numero = None
    if numero is None:
        return False
    if not fichier_source or not isinstance(fichier_source, str):
        return False

    # CORRECTIF (bug préexistant depuis le PATCH v3) : TacheWorkspace exige
    # désormais `statut` (champ obligatoire) et ecrire_statut_tache_workspace
    # n'a plus de paramètre `termine` mais `statut`. L'ancien appel
    # (termine=not termine / termine=termine) levait un TypeError à CHAQUE
    # appel de marquer_tache_terminee / marquer_tache_en_attente, malgré la
    # promesse « jamais d'exception ». `statut_cible` est le statut à ÉCRIRE ;
    # l'objet reconstruit porte l'état inverse (l'état "avant"), comme avant.
    statut_cible = "termine" if termine else "en_attente"
    statut_avant = "en_attente" if termine else "termine"
    tache_workspace = TacheWorkspace(
        numero=numero, donnees=donnees, statut=statut_avant,
        termine=(statut_avant == "termine"), fichier_source=fichier_source,
    )
    return ecrire_statut_tache_workspace(tache_workspace, statut_cible)


@dataclass
class Task:
    """Un Task d'automatisation (section sidebar TaskConfig, point 20+) :
    un script Python en texte libre (décision explicite utilisateur -- pas
    de langage custom "autone", finalement abandonné au profit de vrai code
    Python exécuté tel quel), manipulant des Composants importés via la
    classe ComposantExecutable (cf. plus haut dans ce fichier), exposés
    dans l'espace de noms du script sous une variable portant leur nom (cf.
    nom_variable_python).

    Mode notebook (décision explicite utilisateur) : le code n'est plus un
    bloc unique mais une liste de cellules indépendamment exécutables
    (cf. TaskCellule), avec un espace de noms Python PARTAGÉ entre toutes
    les cellules d'un même Task (comme un vrai notebook Jupyter) -- une
    variable/un composant utilisé dans une cellule reste disponible dans
    les cellules suivantes, sans réimport.

    Import de composants (décision explicite utilisateur) : PAS composant
    par composant -- on importe TOUT un ServiceAPI d'un coup (bouton "+" ->
    liste des ServiceAPI du Project pas encore importés dans ce Task ->
    sélection -> tous ses composants arrivent d'un coup). services_api_importes
    ne stocke donc QUE les noms de ServiceAPI importés (associés à
    l'instance nodriver choisie pour ce Task, cf. ci-dessous), PAS les noms
    de composants eux-mêmes : la liste de composants réellement affichée
    dans le panneau gauche de l'éditeur se recalcule à chaque ouverture du
    Task en cherchant tous les Composant du Project dont service_api_nom
    est dans cette liste (décision explicite utilisateur : "sa reimporte
    tout à la prochaine ouverture") -- reste donc toujours à jour si des
    composants sont ajoutés/supprimés côté ServiceAPI après l'import initial
    dans ce Task, sans rien à réimporter manuellement.

    L'affichage dans le panneau gauche groupe les composants PAR ServiceAPI
    (décision explicite utilisateur : "tu délimite bien lors de leur
    affichage, ne mélange pas les composants"), même si plusieurs ServiceAPI
    différents sont importés dans un même Task.

    Liaison ServiceAPI -> instance (décision explicite utilisateur, cf.
    discussion "screen" = instance nodriver) : TOUS les composants d'un
    même ServiceAPI importé dans CE Task pointent vers UNE SEULE instance
    (un navigateur nodriver précis, identifié par son instance_id, ex.
    "auto-1") -- ce choix se fait par ServiceAPI importé, pas par
    composant individuel, et est propre à ce Task (le même ServiceAPI
    importé dans un AUTRE Task peut être lié à une instance différente).
    Rien n'empêche deux ServiceAPI différents importés dans le même Task
    de pointer vers la MÊME instance (choix utilisateur, ex: "Word" et
    "Gmail" tous les deux sur "auto-1"). services_api_importes est donc un
    dict {nom_service_api: instance_id}, PAS une simple liste de noms --
    instance_id == "" signifie "importé mais pas encore lié à une
    instance" (état transitoire juste après l'import, avant que
    l'utilisateur ait choisi) : l'exécution d'une cellule doit refuser de
    démarrer tant qu'un ServiceAPI utilisé a instance_id == ""."""
    id: str = field(default_factory=_new_id)
    nom: str = "Nouveau Task"
    cellules: list = field(default_factory=lambda: [TaskCellule(titre="# Main")])  # list[TaskCellule], mode notebook
    # MODE D'EXÉCUTION (fusion de l'ancien écran "Notebook Distant" séparé
    # dans TaskConfig, décision explicite utilisateur : "cest miex de juste
    # etendre le mode du task actuel, en mettant le mode reseau" -- PLUS de
    # classe/écran séparé pour piloter du code à distance sur un sAutoniax,
    # un Task normal choisit simplement sa cible d'exécution) :
    #   "local"  -- comportement historique inchangé, cellules exécutées
    #               sur une instance nodriver locale (MoteurExecutionCellule).
    #   "reseau" -- cellules exécutées à distance sur un sAutoniax connecté
    #               (profil cloud chargé via "Initialiser", cf. protocole
    #               initialiser_notebook_distant/executer_notebook_distant) --
    #               PAS de navigateur local, utile en mode faible connexion.
    # Propre à CE Task (pas un réglage global) -- rien n'empêche d'avoir
    # certains Tasks en local et d'autres en réseau dans le même Project.
    # Un même Task ne mélange jamais les deux modes : en mode "reseau",
    # TOUTES les entrées de services_api_importes pointent vers un
    # id_executant (sAutoniax), jamais un instance_id nodriver local, et
    # vice-versa (cf. TaskConfigScreen._demande_selection_instance, qui
    # bifurque selon task.mode_execution).
    mode_execution: str = "local"  # "local" | "reseau"
    # CORRECTIF (retour explicite utilisateur -- "la liaison ServiceAPI
    # doit lister les profils du sAutoniax sélectionné en haut, pas les
    # sAutoniax eux-mêmes, et Initialiser doit charger les profils liés
    # aux ServiceAPI plutôt que de les faire cocher séparément") : en
    # mode "reseau", chaque entrée de services_api_importes est
    # désormais {nom_service_api: nom_profil} (ex. "xian1"), PLUS
    # id_executant (cf. _demande_selection_executant_reseau, qui liste
    # les profils PRÉSENTS SUR UN sAutoniax donné -- résolu depuis le
    # profil actif du panneau clone, ou choisi explicitement sinon,
    # depuis le retrait de combo_executant_reseau). "" garde le même
    # sens qu'avant
    # (pas encore lié). En mode "local", comportement historique
    # totalement inchangé (instance_id nodriver, cf. docstring plus
    # haut).
    services_api_importes: dict = field(default_factory=dict)  # {nom_service_api: instance_id (local) OU nom_profil (réseau)}, "" = pas encore lié
    # SUPPRIMÉ (retour explicite utilisateur, cf. commentaire ci-dessus) --
    # remplacé par profils_lies_reseau (propriété calculée juste en
    # dessous) : la liste des profils à initialiser n'est plus cochée à
    # la main dans un menu séparé, elle se déduit directement des
    # ServiceAPI déjà liés à un profil dans CE Task. Le champ brut reste
    # lu par Task.from_dict (cf. plus bas) pour ignorer proprement
    # d'anciens projets qui le contenaient encore, sans jamais l'écrire
    # de nouveau.

    @property
    def profils_lies_reseau(self) -> list:
        """Remplace l'ancien champ profils_cloud_reseau (coché à la main) --
        liste des noms de profils DÉDUITS des ServiceAPI actuellement liés
        dans ce Task (services_api_importes), dédupliqués, en préservant
        l'ordre de première apparition. Vide tant qu'aucun ServiceAPI
        n'est encore lié à un profil (instance_id == "", cf. docstring de
        services_api_importes) -- même état "rien à initialiser" qu'avant,
        juste calculé plutôt que coché. SANS objet pour un Task "local"
        (services_api_importes y contient des instance_id nodriver, pas
        des noms de profil -- appelant responsable de ne consulter ceci
        qu'en mode "reseau", même contrat que le reste du fichier pour ce
        genre de propriété propre au réseau)."""
        vus = []
        for nom_profil in self.services_api_importes.values():
            if nom_profil and nom_profil not in vus:
                vus.append(nom_profil)
        return vus

    # Deuxième cellule de la row 0, à côté de cellules[0] (décision
    # explicite utilisateur : "litteralement creer deux cellule sur une
    # seule row"). Destinée aux déclarations de VARIABLES DYNAMIQUES --
    # des variables dont la valeur devra être fournie par l'utilisateur à
    # chaque instanciation/exécution du Task (différente entre exécutions
    # parallèles du même Task), contrairement à cellules[0] qui reste une
    # init statique identique à chaque run. Pour l'instant (décision
    # explicite utilisateur : "je vais implementer sa plutard, pour
    # linstant en script elle doivent entre normal") c'est un code Python
    # normal exécuté comme les autres cellules -- aucun mécanisme
    # d'injection de valeur à l'exécution n'est encore branché ici, la
    # structure est juste prête à le recevoir plus tard. Séparé de la
    # liste `cellules` (plutôt que cellules[1]) pour ne pas complexifier
    # tous les index déjà utilisés par le mode notebook (ajout/suppression/
    # sticky toggle de cellules[0]) -- c'est un slot fixe, unique, toujours
    # présent, jamais réordonnable.
    #
    # DÉPLACÉ ICI (demande explicite utilisateur, cf. CODE_VARIABLES_
    # DYNAMIQUES_DEFAUT plus haut) : pré-remplie automatiquement avec
    # RETRY/TIMEOUT/LATENCE_AVANT/LATENCE_APRES/SOURIS_INSTANTANEE/
    # WORKSPACE à la création de tout nouveau Task -- les 4 premières
    # valeurs vivaient auparavant dans cellules[0] ("Main"),
    # déplacées ici car elles sont exactement le genre de réglage "propre
    # à un run" que cette cellule est censée porter (retenter plus/moins
    # de fois, attendre plus/moins longtemps, etc. peuvent légitimement
    # varier d'une exécution à l'autre) -- SOURIS_INSTANTANEE et WORKSPACE
    # ajoutées plus tard suivant exactement le même principe.
    cellule_variables: "TaskCellule" = field(default_factory=lambda: TaskCellule(code=CODE_VARIABLES_DYNAMIQUES_DEFAUT, titre="# Variable dynamique"))

    # PATCH v2 (SPEC_patch_tasks_json.md section 1.2/6) -- remplace
    # ENTIÈREMENT l'ancien `workspaces` (liste ORDONNÉE de dossiers
    # chaînés, chacun {"chemin": str, "actif": bool}) : un WORKSPACE
    # n'est plus un dossier, ni une liste de dossiers chaînés, mais UN
    # SEUL FICHIER JSON contenant un TABLEAU de tâches (cf.
    # scanner_taches_workspace). Un Task ne référence donc plus qu'UN
    # SEUL chemin de fichier -- chaîne vide = aucun WORKSPACE encore
    # configuré pour ce Task (le bouton du panneau clone ouvre alors
    # directement le sélecteur de FICHIER .json, même esprit que
    # l'ancien comportement à dossier unique v1). Plus d'ambiguïté
    # "liste vide" à lever ici (contrairement à l'ancien
    # workspace_deja_configure_une_fois) : une chaîne vide signifie
    # sans équivoque "jamais configuré", donc ce booléen disparaît
    # avec la liste qu'il désambiguïsait.
    #
    # Sérialisé tel quel dans project.json (cf. to_dict/from_dict),
    # conservé d'une session à l'autre exactement comme l'était l'ancien
    # workspace_dossier unique (v0) puis workspaces (v1).
    #
    # Le mode de répartition (Nombre fixe/Relatif, spec section 5.4) et la
    # valeur N du mode Nombre fixe restent inchangés par ce patch --
    # réglages PAR Task (dernier choix pré-sélectionné à l'ouverture du
    # panneau), PAS la répartition elle-même (le dict
    # {cle_profil: [...]} résultant reste en mémoire seulement, jamais
    # persisté sur disque, cf. spec section 7 : recalculable à tout
    # moment depuis l'état réel du fichier WORKSPACE, donc aucune raison
    # de le dupliquer dans project.json).
    workspace_fichier: str = "" 
    workspace_mode_repartition: str = "fixe"  # "fixe" | "relatif"
    workspace_nombre_fixe: int = 1  # valeur N du QSpinBox en mode "fixe", >= 1
    # AJOUT (demande explicite utilisateur : "lors de l'attribution de task
    # dans les notebook on puisse exclure certains champs") : noms des clés
    # de `donnees` RETIRÉES de chaque tâche avant son injection dans
    # LIST_TASKS (cf. repartir_taches_workspace). Réglage PAR Task, persisté
    # comme workspace_mode_repartition. "numero" et "statut" ne sont jamais
    # exclus, quoi qu'il y ait ici (cf. CHAMPS_WORKSPACE_NON_EXCLUABLES).
    workspace_champs_exclus: list = field(default_factory=list)
    # AJOUT (demande explicite utilisateur : "un mini gestionnaire qui
    # affiche les workspaces récents que l'on clique pour ouvrir") --
    # PAS un champ ici : correction utilisateur explicite ("ça doit
    # persister en global, pas sur le fichier") -- la liste MRU des
    # fichiers WORKSPACE récents vit sur ReglagesApp.workspace_fichiers_
    # recents (reglages.json, cf. get_app_data_dir -- même dossier que
    # project.json, "ne pas éparpiller les données sur la machine"),
    # PARTAGÉE par tous les Task/Project de cette machine, pas par Task
    # individuel. Cf. enregistrer_workspace_recent (module-niveau,
    # section backend workspace plus haut).


    # MAJ décision utilisateur ("afficher plus de propiete pour chque
    # fichier notebook... la date de dernier ouverture, creations...") :
    # dates ISO 8601 (str, comme le reste des champs sérialisés de ce
    # fichier -- pas de datetime brut, non JSON-sérialisable tel quel).
    # date_creation posée une seule fois à l'instanciation ; migration
    # rétrocompatible ci-dessous pour les Tasks déjà sauvegardés sans ce
    # champ (from_dict). date_derniere_ouverture mise à jour par
    # TaskConfigScreen._ouvrir_task à chaque ouverture de l'éditeur.
    date_creation: str = field(default_factory=lambda: datetime.now().isoformat())
    date_derniere_ouverture: str = field(default_factory=lambda: datetime.now().isoformat())

    # AJOUT (demande explicite utilisateur -- "au lieu de mettre mise a
    # jour qui vas ecraser... es ce que on peu faire a ce que sa cree une
    # nouvelle version, un peu comme github, je veux que il ya la version
    # 1, 2, 3... au fur a mesure que on met a jour sa vas conserver les
    # precedent, on peut facilement naviguer entre les versions") :
    # historique des instantanés de ce Task, un par mise à jour depuis un
    # fichier .autoniaxtask (cf. TaskConfigScreen._demande_nouvelle_version_task).
    # Chaque entrée est un dict {numero, date, cellules, services_api_importes,
    # cellule_variables} -- même FORME que Task.to_dict() (moins id/nom/
    # versions elles-mêmes, qui n'ont pas de sens à dupliquer dans un
    # instantané : id/nom restent uniques au Task, pas à sa version)
    # plutôt qu'une classe dédiée -- pas de ré-exécution ni d'édition
    # possible sur une ancienne version (cf. TaskConfigScreen.
    # _voir_version/_restaurer_version), donc pas besoin de la richesse
    # d'un vrai TaskCellule ici, un simple dict figé suffit.
    #
    # numero : entier croissant, jamais réutilisé même après suppression
    # d'anciennes versions (cf. _prochain_numero_version) -- contrairement
    # à un simple index de liste, reste stable comme référence si la
    # liste est un jour tronquée (limite de rétention, pas encore
    # implémentée mais numero est déjà prêt à la supporter sans
    # renumérotation).
    #
    # La toute PREMIÈRE mise à jour d'un Task archive automatiquement son
    # état ACTUEL (avant écrasement) comme version 1, avant d'appliquer le
    # contenu importé -- un Task jamais mis à jour n'a donc aucune entrée
    # ici (pas de version 1 orpheline créée à la création du Task lui-même,
    # seulement au premier remplacement de son contenu).
    versions: list = field(default_factory=list)

    # AJOUT (spec B.5, système d'épinglage des tasks) -- épinglé en tête
    # de grille (cf. TaskConfigScreen._reload_grille, tri à deux clés),
    # bascule via l'item "Épingler"/"Désépingler" du menu contextuel de
    # TaskCarte. Pas de sous-tri manuel entre tasks épinglés (profondeur
    # simple, décision tranchée) -- seul le groupe épinglé/non-épinglé
    # change, le tri par date_derniere_ouverture décroissante reste
    # inchangé À L'INTÉRIEUR de chaque groupe.
    epingle: bool = False

    # AJOUT (demande explicite utilisateur : "on doit pouvoir mettre une
    # couleur sur l'icone ... la position des etiquettes [épinglés] reste
    # statique, la seule facon de les deplacer c'est en les faisant glisser")
    # -- couleur_icone : teinte "#rrggbb" de l'icône de la TaskCarte, ""
    # = couleur par défaut (lavender). ordre_epingle : rang MANUEL au
    # sein du groupe épinglé (croissant), modifié UNIQUEMENT par
    # glisser-déposer (cf. TaskConfigScreen._deplacer_task_epingle) ou
    # attribué en fin de groupe à l'épinglage -- jamais par l'ouverture.
    couleur_icone: str = ""
    ordre_epingle: int = 0
    # PATCH (Lib) : noms des libs du projet importées dans ce Task (bouton « + » de la bande Lib). Elles sont embarquées
    # automatiquement avec CHAQUE cellule envoyée -- plus besoin de la ligne `# IMPORT:`.
    libs_importees: list = field(default_factory=list)
    # PATCH I (bouton « Copier TOUT », clic droit) : choix des fichiers copiés. Format :
    #   {"decoches": ["lib:<nom>", "notebook", "sorties"], "externes": [{"chemin": str, "coche": bool}]}
    # Par défaut (dict vide) TOUT est coché ; seuls les éléments DÉCOCHÉS sont mémorisés, donc une lib importée plus tard est cochée d'office.
    copie_tout_config: dict = field(default_factory=dict)

    def to_dict(self) -> dict:
        return {
            "libs_importees": list(self.libs_importees),
            "copie_tout_config": {"decoches": list((self.copie_tout_config or {}).get("decoches", []) or []),
                                  "externes": [dict(e) for e in ((self.copie_tout_config or {}).get("externes", []) or []) if isinstance(e, dict)]},
            "id": self.id,
            "nom": self.nom,
            "cellules": [c.to_dict() for c in self.cellules],
            "mode_execution": self.mode_execution,
            "services_api_importes": dict(self.services_api_importes),
            "cellule_variables": self.cellule_variables.to_dict(),
            "date_creation": self.date_creation,
            "date_derniere_ouverture": self.date_derniere_ouverture,
            "versions": self.versions,
            "epingle": self.epingle,
            "couleur_icone": self.couleur_icone,
            "ordre_epingle": self.ordre_epingle,
            "workspace_fichier": self.workspace_fichier,
            "workspace_mode_repartition": self.workspace_mode_repartition,
            "workspace_nombre_fixe": self.workspace_nombre_fixe,
            "workspace_champs_exclus": list(self.workspace_champs_exclus),
        }

    @staticmethod
    def from_dict(d: dict) -> "Task":
        d = dict(d)
        # NOTE (PATCH v2, SPEC_patch_tasks_json.md section 1.2) : plus
        # besoin ici d'une copie `brut_d` prise AVANT le filtrage
        # champs_valides (plus bas) -- l'ancienne migration lisait
        # l'ancien champ singulier "workspace_dossier" (retiré de la
        # dataclass Task) depuis cette copie pour ne pas le perdre avant
        # d'avoir pu le migrer. Le nouveau modèle (workspace_fichier)
        # n'a plus de migration automatique depuis les anciens formats
        # (ni "workspace_dossier" v0, ni "workspaces" v1, cf. plus bas) :
        # rien à préserver depuis le dict brut d'origine.

        # Migration rétrocompatible AVANT le filtrage des champs valides :
        # "script" n'est plus un champ de la dataclass Task depuis le passage
        # au mode notebook, donc il serait sinon silencieusement supprimé par
        # le filtre ci-dessous avant d'avoir pu être lu -- perte de données.
        if "cellules" not in d or not d.get("cellules"):
            if "script" in d:
                d["cellules"] = [TaskCellule(code=d.get("script") or "", titre="# Main")]
            else:
                d["cellules"] = [TaskCellule(titre="# Main")]

        # Migration rétrocompatible : ancien champ profils_cloud_reseau
        # (liste cochée à la main, cf. CORRECTIF plus haut dans la
        # dataclass) simplement IGNORÉ désormais -- profils_lies_reseau
        # (propriété calculée) le remplace entièrement, rien à convertir
        # (pas dans champs_valides, donc de toute façon filtré juste en
        # dessous si présent dans un ancien fichier).

        champs_valides = {f.name for f in fields(Task)}
        d = {k: v for k, v in d.items() if k in champs_valides}
        d.setdefault("id", _new_id())
        d.setdefault("mode_execution", "local")
        # Migration rétrocompatible : anciens projets sauvegardés avec
        # services_api_importes en list[str] (avant la liaison par
        # instance) -> converti en dict avec instance_id vide, à lier
        # explicitement par l'utilisateur (jamais de devinette d'instance).
        #
        # BUGFIX (décision explicite utilisateur : "la specification dune
        # instace a un task doit se faire a chque demarage de lapp, sa ne
        # doit pas etre une sauvregarde permanete") : que le fichier vienne
        # de l'ancien format (list) OU du format actuel (dict avec
        # instance_id déjà choisi lors d'une session précédente), on
        # préserve uniquement l'ENSEMBLE des ServiceAPI importés (les clés
        # -- "quels composants sont dans ce Task" reste bien persisté) mais
        # on remet TOUJOURS instance_id à "" au chargement -- UNIQUEMENT en
        # mode "local" (défaut). Une instance nodriver est un process qui ne
        # survit de toute façon jamais à un redémarrage de l'app -- une
        # ancienne liaison rechargée pointerait sur une instance morte ou,
        # pire, sur un instance_id réutilisé entretemps par un autre
        # process. L'utilisateur doit donc relier explicitement chaque
        # ServiceAPI importé à une instance à chaque démarrage, jamais une
        # reprise silencieuse d'un ancien choix.
        #
        # CORRECTIF (mode "reseau", retour explicite utilisateur -- "la
        # liaison ServiceAPI doit lister les profils, pas les sAutoniax") :
        # la NATURE de la valeur stockée change (id_executant -> nom_profil,
        # cf. docstring de services_api_importes plus haut) -- une ancienne
        # liaison réseau persistée avant ce correctif contient un
        # id_executant, qui serait sinon réinterprété à tort comme un nom
        # de profil (case_a_cocher/menu de liaison afficherait un faux
        # "profil" qui n'existe pas). Remise à "" à chaque chargement,
        # EXACTEMENT comme le mode "local" -- même filet de sécurité
        # (id_executant/profil peut de toute façon avoir disparu entre
        # deux sessions, autant forcer une reliaison explicite dans tous
        # les cas plutôt que de distinguer ancien/nouveau format ici).
        brut = d.get("services_api_importes", {})
        if isinstance(brut, list):
            d["services_api_importes"] = {nom: "" for nom in brut}
        else:
            d["services_api_importes"] = {nom: "" for nom in dict(brut)}

        if d["cellules"] and isinstance(d["cellules"][0], dict):
            d["cellules"] = [TaskCellule.from_dict(c) for c in d["cellules"]]

        # Migration rétrocompatible : cellule_variables n'existait pas
        # avant -- les projets sauvegardés sans ce champ repartent d'une
        # TaskCellule PRÉ-REMPLIE avec RETRY/TIMEOUT/LATENCE_AVANT/
        # LATENCE_APRES (DÉPLACÉ ici depuis "Main", cf.
        # CODE_VARIABLES_DYNAMIQUES_DEFAUT) plutôt que vide, cohérent avec
        # le comportement d'un Task neuf -- un vieux projet migré doit
        # bénéficier des mêmes globales par défaut qu'un Task créé après
        # ce patch, pas se retrouver avec RETRY/TIMEOUT absents et un
        # comportement système muet par _global_defaut (0/None/0.0/0.0,
        # inchangé de toute façon, mais moins visible/personnalisable
        # pour l'utilisateur).
        brut_variables = d.get("cellule_variables")
        if isinstance(brut_variables, dict):
            d["cellule_variables"] = TaskCellule.from_dict(brut_variables)
        else:
            d["cellule_variables"] = TaskCellule(code=CODE_VARIABLES_DYNAMIQUES_DEFAUT, titre="# Variable dynamique")

        # Migration rétrocompatible : Tasks sauvegardés avant l'ajout de
        # ces deux champs -- défaut "epoch" (1970) plutôt que "maintenant"
        # pour ne pas les faire remonter artificiellement en tête du tri
        # par défaut (par date d'ouverture) à chaque rechargement de
        # project.json, cf. TaskConfigScreen._reload_grille.
        d.setdefault("date_creation", EPOCH_ISO)
        d.setdefault("date_derniere_ouverture", EPOCH_ISO)

        # Migration rétrocompatible : Tasks sauvegardés avant l'ajout du
        # versionnement -- aucun historique, liste vide (comportement
        # identique à un Task jamais mis à jour depuis ce patch, cf.
        # docstring du champ versions).
        d.setdefault("versions", [])

        # Migration rétrocompatible (spec B.5) : Tasks sauvegardés avant
        # l'ajout de l'épinglage -- défaut False (non épinglé), même
        # comportement de tri qu'avant ce patch pour tout Task existant.
        d.setdefault("epingle", False)
        # Migration rétrocompatible : couleur d'icône / rang d'épinglage.
        if not isinstance(d.get("couleur_icone"), str):
            d["couleur_icone"] = ""
        if not isinstance(d.get("ordre_epingle"), int):
            d["ordre_epingle"] = 0

        # PATCH v2 (SPEC_patch_tasks_json.md section 1.2/6) : un WORKSPACE
        # n'est plus un dossier ni une liste de dossiers chaînés, mais UN
        # SEUL fichier JSON -- Task.workspace_fichier (str) remplace
        # ENTIÈREMENT l'ancien Task.workspaces (v1, liste de dicts
        # {"chemin", "actif"}) et l'encore plus ancien workspace_dossier
        # (v0, str singulier déjà). Ni l'un ni l'autre n'a de
        # correspondance directe automatique vers "un fichier JSON unique
        # contenant un tableau de tâches" (spec section 1.2 : "un dossier
        # de fichiers Task_N.json ne devient pas magiquement un tableau
        # JSON unique") -- migration automatique volontairement PAS
        # tentée, contrairement aux migrations v0->v1 précédentes.
        #
        # "workspaces" et "workspace_dossier" ne sont PAS dans
        # champs_valides (aucun des deux n'est plus un champ de la
        # dataclass Task) donc déjà filtrés par le filtre champs_valides
        # plus haut -- on ne les relit pas depuis brut_d : un ancien
        # projet retombe simplement sur workspace_fichier="" (aucun
        # WORKSPACE configuré, à reconfigurer par l'utilisateur après
        # mise à jour, cf. spec section 1.2 -- le bouton du panneau clone
        # proposera directement le sélecteur de fichier au premier clic,
        # exactement comme pour un Task neuf).
        d.setdefault("workspace_fichier", "")
        # Filet de sécurité SYSTÈME : une valeur corrompue/inattendue
        # (édition manuelle du JSON, type inattendu, etc.) retombe sur ""
        # plutôt que de propager un type invalide jusqu'à l'UI/au scan.
        if not isinstance(d.get("workspace_fichier"), str):
            d["workspace_fichier"] = ""

        d.setdefault("workspace_mode_repartition", "fixe")
        d.setdefault("workspace_nombre_fixe", 1)
        # Filet de sécurité SYSTÈME : une valeur corrompue/inattendue (édition
        # manuelle du JSON, etc.) retombe sur "fixe" plutôt que de propager
        # une chaîne invalide jusqu'à la logique de répartition (spec
        # section 6, qui ne connaît que ces deux modes).
        if d["workspace_mode_repartition"] not in ("fixe", "relatif"):
            d["workspace_mode_repartition"] = "fixe"
        try:
            d["workspace_nombre_fixe"] = max(1, int(d["workspace_nombre_fixe"]))
        except (TypeError, ValueError):
            d["workspace_nombre_fixe"] = 1

        # Ancien projet (clé absente) ou valeur corrompue -> aucune
        # exclusion (comportement identique à avant cet ajout).
        d["workspace_champs_exclus"] = normaliser_champs_exclus(
            d.get("workspace_champs_exclus")
        )

        return Task(**d)


# ---------------------------------------------------------------------------
# Import/export d'un Task en fichier -- PATCH demandé par l'utilisateur :
# "que on puisse importer un notebook, [...] telechargez un notebook". Un
# Task EST déjà un notebook au sens de ce fichier (cf. docstring TaskCellule
# : "exactement le meme mecanisme que un notebok") -- pas de nouvelle
# structure à inventer, on sérialise Task telle qu'elle existe déjà (mêmes
# to_dict/from_dict que project.json, cf. Project.save/load).
#
# FORMAT (décision explicite utilisateur, après clarification) : JSON
# fidèle à 100% à la structure Task/TaskCellule -- PAS de conversion vers
# le format .ipynb de Jupyter (cell_type code/markdown, outputs typés MIME)
# qui perdrait le parallèle titre+description Markdown collé à CHAQUE
# cellule de code (structure propre à AutoniaX, pas à Jupyter) et donnerait
# un résultat approximatif si réouvert dans un vrai Jupyter -- mieux vaut
# une extension propre et honnête sur ce qu'elle contient plutôt qu'une
# fausse compatibilité .ipynb.
#
# EXTENSION_FICHIER_TASK : ".autoniaxtask" (JSON en clair -- lisible/
# diffable comme project.json, aucune raison de compresser un fichier aussi
# petit). Constante nommée plutôt que répétée en dur à chaque QFileDialog
# (cf. _demande_export_task/_demande_import_task côté TaskConfigScreen).
EXTENSION_FICHIER_TASK = ".autoniaxtask"

# EXTENSION_FICHIER_SERVICE_API : ".autoniaxservice" -- pack d'IMPORT d'un
# ServiceAPI complet (PATCH demandé par l'utilisateur : "importer un
# service api deja creer avec tout les composant", distinct de "+ Nouveau
# ServiceAPI" qui crée un ServiceAPI VIDE à remplir ensuite manuellement
# dans l'éditeur). Contrairement à .autoniaxtask (JSON en clair), ce
# format DOIT embarquer des images PNG (les variantes de chaque
# Composant) -- une simple enveloppe JSON ne suffit donc pas ici, d'où un
# zip : un manifest.json (même esprit que project.json -- un ServiceAPI +
# ses Composants, cf. ServiceAPI.to_dict/Composant.to_dict) à la racine,
# plus les images référencées par les variantes de chaque Composant,
# stockées dans le zip sous le même chemin relatif que celui écrit dans
# variantes (donc déjà prêtes à être recopiées telles quelles sous
# get_app_data_dir(), cf. importer_service_api_depuis_zip).
EXTENSION_FICHIER_SERVICE_API = ".autoniaxservice"

# Incrémenté seulement si la structure de l'enveloppe elle-même change
# (cf. exporter_task_vers_json/importer_task_depuis_json) -- PAS à chaque
# évolution de Task/TaskCellule, déjà couvertes par leurs propres migrations
# rétrocompatibles dans from_dict (même principe que project.json, qui n'a
# jamais eu besoin d'un numéro de version global pour ça).
VERSION_FORMAT_FICHIER_TASK = 1


def exporter_task_vers_json(task: Task) -> dict:
    """Sérialise un Task en un dict prêt pour json.dump(), destiné à un
    fichier .autoniaxtask téléchargé par l'utilisateur (cf.
    TaskConfigScreen._demande_export_task).

    Enveloppe minimale autour de Task.to_dict() (format_fichier +
    version_format, cf. VERSION_FORMAT_FICHIER_TASK) plutôt qu'un simple
    dump brut -- permet à importer_task_depuis_json de distinguer un
    fichier .autoniaxtask valide d'un JSON quelconque avant même de
    tenter Task.from_dict dessus (cf. sa docstring), et de faire évoluer
    l'enveloppe elle-même plus tard sans ambiguïté sur les anciens
    fichiers déjà exportés.

    task.id N'EST PAS exclu ici (contrairement à ce qu'on pourrait
    attendre) : importer_task_depuis_json régénère de toute façon un
    nouvel id à l'import (cf. sa docstring, jamais de collision possible
    avec un Task déjà présent) -- l'exclure ici n'apporterait rien, et le
    garder rend le fichier exporté directement relisible tel quel par
    Task.from_dict si besoin (débogage, inspection manuelle)."""
    return {
        "format_fichier": "autoniax_task",
        "version_format": VERSION_FORMAT_FICHIER_TASK,
        "task": task.to_dict(),
    }


def importer_task_depuis_json(donnees: dict, noms_service_api_disponibles: set[str]) -> tuple[Task, list[str]]:
    """Reconstruit un Task à partir du contenu d'un fichier .autoniaxtask
    (cf. exporter_task_vers_json pour l'enveloppe attendue). Retourne
    (task, avertissements) -- avertissements est une liste de messages à
    afficher à l'utilisateur (jamais une exception : un import qui réussit
    partiellement doit rester un import réussi, cf. décision ci-dessous),
    vide si tout s'est importé sans accroc.

    Lève ValueError UNIQUEMENT si le fichier n'a manifestement pas la
    forme attendue (pas un dict, ou "format_fichier" absent/différent de
    "autoniax_task") -- distingue clairement "ce n'est pas un fichier
    Task AutoniaX" (erreur bloquante, message clair à l'utilisateur) de
    "c'est un fichier Task AutoniaX mais avec des champs qui ne
    correspondent plus à un ServiceAPI présent ici" (avertissement non
    bloquant, cf. ci-dessous) -- ne vérifie PAS version_format au-delà de
    sa présence : Task.from_dict est déjà tolérant aux champs manquants/en
    trop (migrations rétrocompatibles déjà en place, cf. sa docstring),
    donc un futur format_version 2 lu par cette version reste importable
    tel quel tant que l'enveloppe elle-même n'a pas changé de forme.

    id TOUJOURS régénéré (jamais celui du fichier importé) : un Task
    exporté peut être réimporté dans le MÊME Project (id déjà pris par le
    Task d'origine encore présent) ou importé plusieurs fois de suite --
    dans les deux cas, garder l'id du fichier collisionnerait avec un Task
    existant (find_task, dictionnaires clés par id ailleurs dans ce
    fichier, ex. TaskConfigScreen._task_cartes) plutôt que créer un Task
    strictement séparé, ce qu'un import doit toujours faire.

    nom : PAS de renommage automatique ici (contrairement à l'id) --
    laissé à l'appelant (cf. TaskConfigScreen._demande_import_task, même
    logique de suffixe que _creer_task) qui connaît la liste des noms de
    Tasks déjà présents dans le Project CIBLE, information que cette
    fonction pure n'a pas.

    services_api_importes : SEULES les clés (noms de ServiceAPI) dont le
    nom figure dans noms_service_api_disponibles (le Project CIBLE, pas
    forcément celui d'origine) sont conservées -- un ServiceAPI du même
    nom mais aux composants différents (Project différent, ou même
    Project mais ServiceAPI supprimé/recréé entretemps) n'a aucune raison
    de désigner les mêmes composants, donc mieux vaut un Task qui ouvre
    proprement sans cet import (l'utilisateur le réimportera lui-même
    depuis le panneau gauche si besoin, cf. _demande_import_service_api)
    qu'un Task qui référence silencieusement un ServiceAPI qui n'existe
    plus ici. Chaque ServiceAPI retiré ainsi ajoute une ligne à
    avertissements plutôt que d'échouer tout l'import (décision : perdre
    UN lien d'import ne justifie pas de perdre tout le notebook -- script
    et cellules restent le cœur de ce qu'on importe). instance_id
    toujours remis à "" comme le fait déjà Task.from_dict (aucune instance
    ne survit à un redémarrage, cf. sa docstring) -- rien de spécifique à
    ajouter ici pour ce champ."""
    if not isinstance(donnees, dict) or donnees.get("format_fichier") != "autoniax_task":
        raise ValueError(
            "Ce fichier ne correspond pas à un notebook AutoniaX "
            f"({EXTENSION_FICHIER_TASK}) -- format non reconnu."
        )

    brut_task = donnees.get("task")
    if not isinstance(brut_task, dict):
        raise ValueError(
            f"Fichier {EXTENSION_FICHIER_TASK} invalide : section « task » manquante ou corrompue."
        )

    task = Task.from_dict(brut_task)
    task.id = _new_id()

    avertissements: list[str] = []
    services_conserves = {}
    for nom_service, instance_id in task.services_api_importes.items():
        if nom_service in noms_service_api_disponibles:
            services_conserves[nom_service] = instance_id
        else:
            avertissements.append(
                f"ServiceAPI « {nom_service} » introuvable dans ce Project -- import ignoré pour ce Task "
                "(à réimporter manuellement depuis le panneau gauche si besoin)."
            )
    task.services_api_importes = services_conserves

    return task, avertissements


# ---------------------------------------------------------------------------
# PATCH "Projet Batch" (cf. PATCH_projet_batch.md) -- traitement en masse
# d'un même Task sur un grand nombre de dossiers de données ("sous-projets"),
# avec N instances nodriver travaillant en parallèle. Brique 1 : modèle de
# données (ProjetBatch, SousProjet) + validation de conformité, AUCUNE
# dépendance Qt ici (réutilisable telle quelle par le moteur d'orchestration
# headless, cf. section 5 du patch).
# ---------------------------------------------------------------------------


@dataclass
class ProjetBatch:
    """Un projet de traitement par lots (cf. PATCH_projet_batch.md, sections
    0 et 1) : exécute UN SEUL Task (décision explicite utilisateur : un
    projet = un seul Task, choisi à la création et fixe ensuite) sur un
    grand nombre de "sous-projets" -- des dossiers numérotés
    (chemin_racine/1/, chemin_racine/2/, ...) partageant tous la même
    architecture disque (cf. SousProjet.STRUCTURE_ATTENDUE).

    RÉVISION (décision explicite utilisateur, remplace le "N instances
    parallèles" saisi comme un simple chiffre) : le batch ne lance plus
    d'instances nodriver fraîches lui-même -- il RÉUTILISE des instances
    déjà lancées et connectées (cf. ProfilsInstancesScreen), que
    l'utilisateur coche explicitement dans la liste des instances
    disponibles. `instances_selectionnees` porte la liste de leurs
    instance_id ; le nombre d'instances actives en parallèle = le nombre
    d'instance_id cochés, vérifiés connectés ET libres au moment du
    démarrage (cf. MoteurExecutionBatch.lancer(), qui bloque sinon --
    même logique de blocage strict que la non-conformité des dossiers,
    cf. section 2 du patch). Le mode d'orchestration "round" a été retiré
    (décision explicite utilisateur : perd son sens avec des instances
    réelles potentiellement instables) -- seul "pool" subsiste
    implicitement, cf. MoteurExecutionBatch.

    mapping_variables associe chaque variable dynamique détectée dans
    task.cellule_variables.code (cf. TaskScriptEditor._REGEX_DECLARATION_
    VARIABLE, réutilisée telle quelle -- pas de second parseur) au nom du
    fichier, dans <sous_projet>/data/, dont le CHEMIN ABSOLU sera injecté
    comme valeur de cette variable (décision explicite utilisateur : le
    chemin, pas le contenu -- cf. extraire_texte_fichier, déjà existant,
    si le script veut le contenu texte). Configuré UNE SEULE FOIS pour
    tout le ProjetBatch (pas par sous-projet), puisque tous les
    sous-projets partagent la même architecture.

    PATCH (retour utilisateur -- distinction path/valeur, "les type int
    ne doivent pas faire partir du matching de fichier, puisque sa seras
    des valeurs que lon vas entrer") : toute variable dynamique n'est pas
    forcément un chemin. detecter_type_variable_dynamique() classe chaque
    variable en "path" (comportement historique, mapping_variables
    ci-dessus) ou "valeur" (nombre/booléen/texte simple, ex: RETRY=3).
    Pour ces dernières, l'utilisateur peut soit garder la valeur par
    défaut déjà codée dans cellule_variables.code (ne rien cocher --
    aucune injection, le script utilise sa valeur telle quelle), soit la
    COCHER dans variables_a_personnaliser pour saisir une valeur de
    remplacement dans variables_personnalisees, appliquée à TOUS les
    sous-projets de ce ProjetBatch (même philosophie "configuré une seule
    fois" que mapping_variables -- pas une valeur différente par
    sous-projet, cf. décision "un mapping pour tout le batch")."""
    id: str = field(default_factory=_new_id)
    nom: str = "Nouveau Projet Batch"
    task_id: str = ""  # référence à UN SEUL Task du Project, fixé à la création
    # instance_id des instances déjà lancées/connectées que l'utilisateur a
    # cochées pour ce batch (cf. docstring ci-dessus) -- PAS un chiffre.
    # Revérifiées connectées+libres à chaque lancer(), jamais supposées
    # encore valides simplement parce qu'elles figurent dans cette liste
    # (une instance peut avoir été fermée entre deux ouvertures de l'écran).
    instances_selectionnees: list = field(default_factory=list)
    chemin_racine: str = ""  # dossier contenant les sous-projets numérotés (1/, 2/, ...)
    mapping_variables: dict = field(default_factory=dict)  # {nom_variable: nom_fichier_attendu} -- variables de type "path" uniquement
    # {nom_variable: valeur} pour les variables de type "valeur" COCHÉES
    # pour personnalisation (cf. docstring ci-dessus) -- une variable de
    # type "valeur" absente d'ici garde sa valeur par défaut du code,
    # inchangée, aucune injection.
    variables_personnalisees: dict = field(default_factory=dict)
    # Noms des variables de type "valeur" actuellement cochées "à
    # personnaliser" dans l'écran de mapping -- décochée = valeur par
    # défaut. Distinct de variables_personnalisees.keys() pour pouvoir
    # cocher une variable AVANT d'avoir saisi sa valeur (case cochée,
    # champ encore vide) sans perdre cet état intermédiaire.
    variables_a_personnaliser: list = field(default_factory=list)

    # PATCH E.7 (cf. cahier des charges patchs.md, section E.7 --
    # "Assignation des profils : un profil par sous-projet"). {numero_
    # sous_projet (str) -> nom_profil} -- destiné à REMPLACER le pool
    # global partagé (BatchDistribue.profils, cf. sa docstring "E.7
    # assignation 1 profil/sous-projet reporté à plus tard") pour CE
    # ProjetBatch précis, une fois rempli via la mini-app "Attribuer les
    # profils" (cf. AttributionProfilsScreen). Clé en str (pas int) :
    # cohérent avec JSON (les clés dict JSON sont toujours des chaînes ;
    # éviter une conversion int<->str à chaque to_dict/from_dict qui
    # serait une source d'erreur facile).
    #
    # ÉTAT RÉEL (important, à lire avant de supposer que ce mapping est
    # appliqué) : ce champ est PERSISTÉ et ÉDITABLE via la mini-app, mais
    # N'EST PAS ENCORE CONSOMMÉ à l'exécution. MoteurExecutionBatch (cf.
    # _demarrer_sous_projet_sur_instance, `self._file_sous_projets.
    # pop(0)`) reste un pool FIFO pur : n'importe quelle instance libre
    # prend le sous-projet suivant de la file, sans regarder ce mapping
    # -- ni côté exécution LOCALE, ni côté sAutoniax DISTANT (même
    # moteur réutilisé tel quel dans _sautoniax_traiter_projet_recu).
    # Brancher réellement l'appariement "CE sous-projet DOIT tourner
    # avec CE profil" demande de modifier ce dispatch des deux côtés --
    # reporté à une session dédiée (testable), décision explicite prise
    # avec l'utilisateur plutôt que de modifier ce cœur d'exécution à
    # l'aveugle. En clair : remplir cette mini-app aujourd'hui n'a AUCUN
    # effet sur quel profil traite quel sous-projet -- seul le pool
    # coché dans DialogueEnvoiSautoniax (comportement E.4/E.5 inchangé)
    # détermine encore les instances réellement utilisées à l'envoi.
    mapping_profils_sous_projets: dict = field(default_factory=dict)

    def to_dict(self) -> dict:
        return {
            "id": self.id,
            "nom": self.nom,
            "task_id": self.task_id,
            "instances_selectionnees": list(self.instances_selectionnees),
            "chemin_racine": self.chemin_racine,
            "mapping_variables": dict(self.mapping_variables),
            "variables_personnalisees": dict(self.variables_personnalisees),
            "variables_a_personnaliser": list(self.variables_a_personnaliser),
            "mapping_profils_sous_projets": dict(self.mapping_profils_sous_projets),
        }

    @staticmethod
    def from_dict(d: dict) -> "ProjetBatch":
        d = dict(d)
        champs_valides = {f.name for f in fields(ProjetBatch)}
        d = {k: v for k, v in d.items() if k in champs_valides}
        d.setdefault("id", _new_id())
        d["mapping_variables"] = dict(d.get("mapping_variables") or {})
        d["instances_selectionnees"] = list(d.get("instances_selectionnees") or [])
        # Rétrocompatibilité : ProjetBatch sauvegardé avant ce patch n'a
        # ni l'un ni l'autre champ -- dict/liste vides par défaut, cf.
        # même pattern que mapping_variables/instances_selectionnees.
        d["variables_personnalisees"] = dict(d.get("variables_personnalisees") or {})
        d["variables_a_personnaliser"] = list(d.get("variables_a_personnaliser") or [])
        # PATCH E.7 -- rétrocompatibilité identique : un ProjetBatch
        # sauvegardé avant ce patch n'a pas ce champ, dict vide par
        # défaut (comportement "aucun profil assigné", jamais une
        # erreur de chargement).
        d["mapping_profils_sous_projets"] = dict(d.get("mapping_profils_sous_projets") or {})
        return ProjetBatch(**d)

    # --- Sous-projets (dossiers numérotés sous chemin_racine) ---
    def chemin_sous_projets(self) -> Path:
        return Path(self.chemin_racine)

    def lister_sous_projets(self) -> list:
        """Retourne les sous-dossiers numérotés directement sous
        chemin_racine, TRIÉS NUMÉRIQUEMENT (1, 2, ..., 10, 11 -- pas
        l'ordre lexicographique "1", "10", "11", "2" que donnerait un tri
        de chaînes brut). Un dossier dont le nom n'est pas un entier est
        ignoré (cf. décision par défaut ci-dessous, section 2 du patch :
        seuls les dossiers numérotés font partie du batch)."""
        racine = self.chemin_sous_projets()
        if not racine.is_dir():
            return []
        candidats = []
        for enfant in racine.iterdir():
            if enfant.is_dir() and enfant.name.isdigit():
                candidats.append(enfant)
        candidats.sort(key=lambda p: int(p.name))
        return candidats


@dataclass
class AssociationApi2Api:
    """Une ligne de l'écran Api2Api (sidebar dédiée, cf. Api2Api_ecran_
    specification.md) : associe UN Task existant du Project (n'importe
    lequel, pas de type formel "Task Api2Api" distinct -- cf. spec
    section 1) à UN profil LOCAL (profils cloud hors scope pour cette
    version, cf. spec section 6), avec un simple cycle démarrer/arrêter/
    supprimer, indépendant de ProjetBatch (pensé pour du traitement de
    masse de fichiers, pas pour une écoute permanente -- décision
    explicite utilisateur : "il faut trouver un moyen de executer les
    task api2api sans passer par le batch").

    PAS de champ d'état "en cours d'exécution" ici volontairement : cet
    état est TOUJOURS transitoire (aucun Task ne continue de tourner
    après fermeture complète de l'application), donc ne doit jamais être
    persisté comme s'il survivait -- cf. Api2ApiScreen._moteurs_par_
    association (dict en mémoire, jamais sérialisé), qui porte seul cet
    état pendant la session en cours. Au redémarrage de l'app, toute
    ligne réapparaît systématiquement à l'état "arrêté"."""
    id: str = field(default_factory=_new_id)
    task_id: str = ""       # référence à un Task existant du Project (project.tasks) -- "" = pas encore choisi
    nom_profil: str = ""    # nom de profil LOCAL (cf. charger_registre_profils()) -- "" = pas encore choisi
    date_creation: str = field(default_factory=lambda: datetime.now().isoformat())

    def to_dict(self) -> dict:
        return {
            "id": self.id,
            "task_id": self.task_id,
            "nom_profil": self.nom_profil,
            "date_creation": self.date_creation,
        }

    @staticmethod
    def from_dict(d: dict) -> "AssociationApi2Api":
        d = dict(d)
        champs_valides = {f.name for f in fields(AssociationApi2Api)}
        d = {k: v for k, v in d.items() if k in champs_valides}
        d.setdefault("id", _new_id())
        return AssociationApi2Api(**d)


@dataclass
class BatchDistribue:
    """PATCH E (cf. cahier des charges patchs.md, section E.4 --
    "Notion de Batch (remplace l'envoi de projet unique)"). ATTENTION AU
    NOM : un "Batch" ici n'a RIEN à voir avec ProjetBatch ci-dessus (déjà
    utilisé pour "un Task exécuté sur N sous-projets, pool d'instances
    partagé", terminologie fixée avant ce patch, impossible à renommer
    sans casser toute compatibilité project.json existante). Un
    BatchDistribue = PLUSIEURS ProjetBatch déjà configurés, assignés à UN
    SEUL sAutoniax, envoyés et exécutés SÉQUENTIELLEMENT (un ProjetBatch
    à la fois, jamais en parallèle -- cf. E.4 : "un projet à la fois, pas
    en parallèle" pour ce premier passage ; le retraitement parallèle
    éventuel, E.5, est un sujet séparé qui n'agit qu'APRÈS ce premier
    passage, sur un batch déjà terminé).

    DÉLIBÉRÉMENT ÉPHÉMÈRE, jamais persisté dans project.json (contraste
    avec ProjetBatch/Task/ServiceAPI ci-dessus, tous sauvegardés) --
    même philosophie que ProjetsDistribuesScreen._sessions aujourd'hui,
    qui ne survit pas non plus à la fermeture de mAutoniax : la
    continuité en cas de déconnexion/reconnexion (E.2) passe par le
    CLOUD côté serveurT ("le batch continue d'avancer côté serveur
    pendant que mAutoniax est déconnecté"), jamais par un état local à
    reconstituer -- un BatchDistribue n'est qu'une DÉFINITION D'ENVOI
    (quoi envoyer, dans quel ordre, à qui), pas un état d'avancement.
    Le suivi détaillé de l'exécution (statut par ProjetBatch, compteurs)
    reste entièrement dans ProjetsDistribuesScreen._sessions, une entrée
    par ProjetBatch du batch (session_id distinct par ProjetBatch, PAS
    un unique session_id pour tout le batch) -- id_batch_distribue sert
    UNIQUEMENT à relier ces sessions entre elles pour l'affichage groupé
    et le séquencement (cf. ClientServeurT.envoyer_batch_vers_sautoniax),
    jamais comme clé de session réseau à la place de session_id.

    PROFILS (décision explicite utilisateur -- E.7 assignation 1
    profil/sous-projet reporté à plus tard) : `profils` est ENCORE un
    pool global partagé pour tout le batch, coché une fois dans
    DialogueEnvoiSautoniax, exactement comme le modèle mono-projet
    actuel -- pas de répartition individuelle par ProjetBatch/sous-projet
    dans cette étape. Le jour où E.7 sera fait, ce champ deviendra
    probablement un mapping par ProjetBatch plutôt qu'une liste plate,
    mais ce n'est PAS ce patch-ci."""
    id: str = field(default_factory=_new_id)
    nom: str = ""  # affiché tel quel dans la table -- cf. E.4 "chaque batch a un nom (potentiellement long)"
    id_executant: str = ""
    # Ordre d'envoi = ordre d'exécution séquentielle (cf. docstring
    # ci-dessus) -- PAS un set, l'ordre de cette liste fait foi.
    ids_projets_batch: list = field(default_factory=list)
    profils: list = field(default_factory=list)  # pool global, cf. docstring PROFILS ci-dessus


@dataclass
class SousProjet:
    """Représentation en mémoire d'UN dossier numéroté (cf. ProjetBatch,
    terminologie validée : un dossier numéroté = un "sous-projet").
    Structure disque fixe à 3 éléments (décision explicite utilisateur,
    cf. section 1 du patch) :

        <numero>/
          data/         <- fichiers à mapper vers les variables dynamiques
          download/     <- dossier de téléchargement assigné à l'instance
          statut.json   <- journal de statut de CE sous-projet

    Cette classe ne fait AUCUNE opération disque à la construction --
    cf. SousProjet.depuis_dossier() pour charger un statut.json existant,
    et .ecrire_statut() pour persister un changement d'état."""
    chemin: Path
    numero: int
    statut: str = "non_traite"  # "non_traite" | "succes" | "echec"
    derniere_execution: Optional[str] = None  # timestamp ISO, cf. _horloge_iso()
    message_erreur: Optional[str] = None
    # Coché ou non pour le PROCHAIN lancement (décision explicite
    # utilisateur : sélection individuelle des sous-projets à traiter,
    # au lieu d'inclure automatiquement tout ce qui n'est pas "succes").
    # Volontairement PAS persisté dans statut.json (ni lu par
    # depuis_dossier, ni écrit par ecrire_statut) -- décision explicite
    # utilisateur : "toujours recalculée à l'ouverture, pas de mémoire"
    # -- recalculé à chaque _reload_sous_projets() de ProjetBatchScreen
    # (cf. sa docstring : True par défaut pour "non_traite"/"echec",
    # False pour "succes"), jamais lu depuis le disque.
    selectionne: bool = True

    @property
    def dossier_data(self) -> Path:
        return self.chemin / "data"

    @property
    def dossier_download(self) -> Path:
        return self.chemin / "download"

    @property
    def dossier_debug(self) -> Path:
        """Dossier des captures d'écran de bug (cf. MoteurExecutionBatch.
        _capturer_image_bug_cellule) -- une image par cellule en erreur,
        nommée par cellule_id. Créé à la demande seulement (jamais au
        chargement d'un SousProjet existant, contrairement à data/ et
        download/ qui préexistent toujours) : la plupart des sous-projets
        n'ont jamais d'erreur et n'ont donc jamais besoin de ce dossier."""
        return self.chemin / "debug"

    @property
    def fichier_statut(self) -> Path:
        return self.chemin / "statut.json"

    # ------------------------------------------------------------------
    # Historique d'exécution notebook (cf. onglet "Aperçu d'exécution" de
    # ProjetBatchScreen, Brique B du plan de patch) -- fichier séparé de
    # statut.json (jamais fusionné avec lui : statut.json ne garde que le
    # DERNIER état, alors que notebook_execution.json accumule TOUTES les
    # tentatives, décision explicite utilisateur : "garder un historique
    # de CHAQUE tentative"). Format : liste JSON de tentatives, jamais
    # écrasée -- chaque nouvelle tentative est ajoutée à la suite des
    # précédentes (cf. ajouter_tentative_execution ci-dessous).
    # ------------------------------------------------------------------
    @property
    def fichier_notebook_execution(self) -> Path:
        return self.chemin / "notebook_execution.json"

    def lire_historique_executions(self) -> list:
        """Relit l'historique complet des tentatives d'exécution de ce
        sous-projet (liste de dicts, cf. structure construite par
        MoteurExecutionBatch._finir_sous_projet). [] si le fichier est
        absent (sous-projet jamais encore exécuté depuis ce patch) ou
        corrompu/illisible -- même tolérance que depuis_dossier pour
        statut.json : un historique illisible ne doit jamais faire
        planter l'affichage, juste apparaître vide."""
        fichier = self.fichier_notebook_execution
        if not fichier.exists():
            return []
        try:
            data = json.loads(fichier.read_text(encoding="utf-8"))
        except (json.JSONDecodeError, OSError):
            return []
        if not isinstance(data, list):
            return []
        return data

    def corriger_image_bug_derniere_tentative(self, cellule_id: str, chemin_image: str):
        """Met à jour a posteriori le champ image_bug d'UNE cellule dans
        la DERNIÈRE tentative de l'historique -- utilisée quand la
        capture_propre (cf. MoteurExecutionBatch._capturer_image_bug_
        cellule) arrive APRÈS que _finir_sous_projet a déjà écrit la
        tentative (aller-retour réseau asynchrone, l'instance peut déjà
        avoir enchaîné sur un autre sous-projet entre-temps). Relit,
        modifie l'entrée correspondante si trouvée, réécrit entièrement
        -- même pattern défensif que ajouter_tentative_execution. Ne fait
        rien silencieusement si l'historique est vide/corrompu ou si la
        cellule_id n'est plus trouvée dans la dernière tentative (ex:
        SousProjet retraité entre-temps sur un TOUT autre Task/tentative)."""
        historique = self.lire_historique_executions()
        if not historique:
            return
        derniere = historique[-1]
        for cellule_dict in derniere.get("cellules") or []:
            if cellule_dict.get("cellule_id") == cellule_id:
                cellule_dict["image_bug"] = chemin_image
                break
        else:
            return
        self.chemin.mkdir(parents=True, exist_ok=True)
        self.fichier_notebook_execution.write_text(
            json.dumps(historique, ensure_ascii=False, indent=2, default=str),
            encoding="utf-8",
        )

    def ajouter_tentative_execution(self, tentative: dict):
        """Ajoute UNE tentative à la suite de l'historique existant et
        réécrit le fichier ENTIÈREMENT (même pattern que ecrire_statut :
        relire, append, réécrire au complet -- pas d'écriture incrémentale
        partielle qui risquerait de corrompre le fichier en cas de coupure
        au milieu). `tentative` : dict déjà construit par l'appelant (cf.
        structure Brique B : horodatage/instance_id/statut_final/cellules/
        variables_injectees), stocké tel quel sans validation de forme
        supplémentaire ici -- la responsabilité de la structure revient à
        l'appelant (MoteurExecutionBatch)."""
        historique = self.lire_historique_executions()
        historique.append(tentative)
        self.chemin.mkdir(parents=True, exist_ok=True)
        self.fichier_notebook_execution.write_text(
            json.dumps(historique, ensure_ascii=False, indent=2, default=str),
            encoding="utf-8",
        )

    @staticmethod
    def depuis_dossier(chemin: Path) -> "SousProjet":
        """Construit un SousProjet à partir d'un dossier numéroté existant
        sur disque, en relisant son statut.json s'il existe (sinon,
        statut "non_traite" par défaut -- un sous-projet jamais encore
        traité n'a simplement pas encore ce fichier)."""
        sous_projet = SousProjet(chemin=chemin, numero=int(chemin.name))
        fichier = sous_projet.fichier_statut
        if fichier.exists():
            try:
                data = json.loads(fichier.read_text(encoding="utf-8"))
            except (json.JSONDecodeError, OSError):
                # statut.json corrompu/illisible : traité comme
                # "non_traite" plutôt que de faire planter tout le
                # chargement du ProjetBatch pour un seul sous-projet --
                # ce sous-projet sera simplement (re)traité au prochain
                # lancement, comme s'il n'avait jamais tourné.
                data = {}
            sous_projet.statut = data.get("statut", "non_traite")
            sous_projet.derniere_execution = data.get("derniere_execution")
            sous_projet.message_erreur = data.get("message_erreur")
        return sous_projet

    def ecrire_statut(self, statut: str, message_erreur: Optional[str] = None):
        """Écrit statut.json sur disque ET met à jour l'état en mémoire.
        Toujours réécrit ENTIÈREMENT, jamais fusionné, pour ne jamais
        laisser un champ périmé d'un statut précédent (ex: message_erreur
        d'un échec antérieur qui traînerait après un succès)."""
        self.statut = statut
        self.derniere_execution = _horloge_iso()
        self.message_erreur = message_erreur
        self.chemin.mkdir(parents=True, exist_ok=True)
        self.fichier_statut.write_text(
            json.dumps(
                {
                    "statut": self.statut,
                    "derniere_execution": self.derniere_execution,
                    "message_erreur": self.message_erreur,
                },
                ensure_ascii=False, indent=2,
            ),
            encoding="utf-8",
        )


def _horloge_iso() -> str:
    """Timestamp ISO 8601 lisible pour statut.json (cf. SousProjet.
    ecrire_statut) -- format texte plutôt qu'un epoch numérique, plus
    directement lisible en ouvrant le fichier à la main pour diagnostiquer
    un batch en cours."""
    return datetime.now().isoformat(timespec="seconds")


class NonConformiteSousProjetError(Exception):
    """Levée par le moteur d'orchestration (cf. section 5 du patch) à
    partir de la liste retournée par valider_conformite_projet_batch() --
    transporte la liste complète des sous-projets non conformes pour
    affichage groupé à l'utilisateur, plutôt qu'un message d'erreur
    portant sur un seul dossier à la fois."""
    def __init__(self, problemes: list):
        self.problemes = problemes  # list[dict] -- cf. valider_conformite_projet_batch
        detail = "\n".join(
            f"  - dossier {p['numero']} : {p['raison']}" for p in problemes
        )
        super().__init__(
            f"{len(problemes)} sous-projet(s) non conforme(s) -- démarrage bloqué :\n{detail}"
        )


class InstancesIndisponiblesError(Exception):
    """Levée par MoteurExecutionBatch.lancer() (cf. _verifier_instances_
    bloquant) quand une ou plusieurs instances cochées par l'utilisateur
    (ProjetBatch.instances_selectionnees) ne sont pas connectées ou pas
    libres au moment du démarrage. Décision explicite utilisateur : même
    sévérité que NonConformiteSousProjetError -- bloque TOUT le démarrage,
    aucune instance n'est sollicitée tant que ce n'est pas résolu. Le
    message détaillé (instance par instance) est déjà construit par
    _verifier_instances_bloquant -- transporté tel quel ici plutôt que
    reconstruit, contrairement à NonConformiteSousProjetError qui, elle,
    reçoit une liste structurée (les deux approches sont utilisées ailleurs
    dans ce fichier selon le besoin de l'appelant : _verifier_instances_
    bloquant n'a pas besoin de retourner une structure exploitable
    programmatiquement au-delà de l'affichage, donc un message déjà formé
    suffit ici)."""
    def __init__(self, message: str):
        super().__init__(message)


@dataclass
class ElementDonneeFictive:
    """Un élément à générer (cf. GenerationDonneesFictivesScreen) : un nom
    de fichier/dossier et son type. `type_element` in ("image", "texte",
    "dossier") -- cf. generer_donnees_fictives, qui décide du contenu
    réellement écrit sur disque selon ce type."""
    nom: str
    type_element: str  # "image" | "texte" | "dossier"


# Racine fixe sous laquelle chaque génération de "Données fictives" crée
# son propre sous-dossier <nom_projet>/ (cf. GenerationDonneesFictivesScreen.
# _racine_effective) -- constante top-level pour que ProjetBatchScreen
# puisse lister ces mêmes dossiers de projet au moment de choisir le
# dossier racine d'un ProjetBatch (cf. PATCH -- retour utilisateur : "que
# la liste des data de projet fictifs soit proposée quand on essaie de
# sélectionner le dossier de données lors de la configuration d'un
# projet"), sans dupliquer le chemin à deux endroits.
RACINE_DONNEES_FICTIVES = _chemin_donnees("AutoniaxDemo/DonneesFictives")


def compter_sous_dossiers_numerotes(chemin: Path) -> int:
    """Nombre de sous-dossiers directement enfants de `chemin` dont le nom
    est un entier (1, 2, 3, ...) -- même définition qu'un sous-projet
    valide pour ProjetBatch (cf. ProjetBatch.lister_sous_projets), mais en
    fonction libre : utilisée pour évaluer un dossier de données fictives
    candidat AVANT qu'il ne soit attaché à un ProjetBatch (donc sans
    instance de ProjetBatch disponible à ce stade)."""
    if not chemin.is_dir():
        return 0
    return sum(1 for enfant in chemin.iterdir() if enfant.is_dir() and enfant.name.isdigit())


def lister_projets_donnees_fictives() -> list:
    """Sous-dossiers de RACINE_DONNEES_FICTIVES (chacun un jeu de données
    généré par GenerationDonneesFictivesScreen, cf. _racine_effective) --
    cf. ProjetBatchScreen._choisir_dossier_racine, qui les propose comme
    raccourcis avant de tomber sur le sélecteur de dossier natif. Triés
    par date de modification décroissante (le plus récemment généré en
    premier -- probablement celui que l'utilisateur vient de créer et
    cherche à attacher). Retourne une liste vide, jamais d'exception, si
    RACINE_DONNEES_FICTIVES n'existe pas encore (aucune génération faite)."""
    if not RACINE_DONNEES_FICTIVES.is_dir():
        return []
    candidats = [d for d in RACINE_DONNEES_FICTIVES.iterdir() if d.is_dir()]
    candidats.sort(key=lambda d: d.stat().st_mtime, reverse=True)
    return candidats


def generer_donnees_fictives(racine: Path, elements: list, nb_sous_projets: int) -> Path:
    """Outil "Données fictives" (panneau gauche d'ApplicationsScreen, cf.
    GenerationDonneesFictivesScreen) : réplique le MÊME jeu d'éléments
    (images/fichiers texte/dossiers, cf. ElementDonneeFictive) dans
    <racine>/<n>/data/ pour n allant de 1 à nb_sous_projets -- décision
    explicite utilisateur : "cette structure est identique pour tout les
    sous-projet", pas de variation de contenu entre sous-projets.

    Contenu généré (aucune dépendance externe -- PySide6 uniquement,
    déjà importé dans ce fichier) :
      - "image" : PNG (400x300) de couleur unie (variée par un cycle de
        teintes, juste pour distinguer visuellement plusieurs images
        fictives d'un coup d'oeil) avec le nom du fichier dessiné dessus.
      - "texte" : .txt avec un contenu bidon minimal identifiant le
        fichier et le numéro de sous-projet (seule variation entre
        sous-projets -- juste pour repérer facilement, en ouvrant un
        fichier, de quel sous-projet il vient).
      - "dossier" : créé vide -- pas de contenu fictif à l'intérieur.

    Retourne `racine` (déjà créée) pour que l'appelant UI puisse l'ouvrir/
    l'afficher directement après génération."""
    racine.mkdir(parents=True, exist_ok=True)
    # Palette de teintes cycliques -- juste assez pour distinguer visuellement
    # plusieurs images fictives d'un coup d'oeil, aucune signification au-delà.
    teintes = [
        QColor("#89b4fa"), QColor("#a6e3a1"), QColor("#f9e2af"),
        QColor("#f38ba8"), QColor("#cba6f7"), QColor("#94e2d5"),
    ]

    for numero in range(1, nb_sous_projets + 1):
        dossier_data = racine / str(numero) / "data"
        dossier_data.mkdir(parents=True, exist_ok=True)
        for index_element, element in enumerate(elements):
            if element.type_element == "dossier":
                (dossier_data / element.nom).mkdir(parents=True, exist_ok=True)
            elif element.type_element == "texte":
                nom_fichier = element.nom if "." in element.nom else f"{element.nom}.txt"
                (dossier_data / nom_fichier).write_text(
                    f"Fichier de test généré automatiquement.\n"
                    f"Nom : {element.nom}\n"
                    f"Sous-projet : {numero}\n",
                    encoding="utf-8",
                )
            elif element.type_element == "image":
                nom_fichier = element.nom if "." in element.nom else f"{element.nom}.png"
                image = QImage(400, 300, QImage.Format_RGB32)
                image.fill(teintes[index_element % len(teintes)])
                painter = QPainter(image)
                painter.setPen(QColor("#11111b"))
                painter.setFont(QFont("Arial", 16))
                painter.drawText(
                    image.rect(), Qt.AlignCenter,
                    f"{element.nom}\nsous-projet {numero}",
                )
                painter.end()
                image.save(str(dossier_data / nom_fichier), "PNG")
        # download/ créé également -- même architecture disque attendue
        # par SousProjet (cf. sa docstring).
        (racine / str(numero) / "download").mkdir(parents=True, exist_ok=True)

    return racine


@dataclass
class Project:
    """Racine du modèle : tout ce qui est sauvegardé dans project.json (point 13)."""
    services_api: list = field(default_factory=list)  # list[ServiceAPI]
    composants: list = field(default_factory=list)  # list[Composant]
    bibliotheque_actions: "BibliothequeActions" = field(default_factory=lambda: BibliothequeActions())  # Actions globales (décision explicite utilisateur -- plus liées à un ServiceAPI)
    tasks: list = field(default_factory=list)  # list[Task] -- scripts d'automatisation (TaskConfig)
    projets_batch: list = field(default_factory=list)  # list[ProjetBatch] -- cf. PATCH_projet_batch.md
    # PATCH (demande utilisateur explicite : "je veux mettre l'onglet de
    # corbeille dans la sidebar ... lorsque on supprime une task, un
    # composant, un service, un projet ... ces éléments de donnée
    # structurée [passent par la corbeille]") -- liste de dicts génériques
    # {"id_corbeille", "type", "nom_repere", "supprime_le", "donnees",
    # "fichiers"} : cf. Corbeille (docstring complète juste au-dessus de
    # Project.deplacer_vers_corbeille ci-dessous) pour le détail de chaque
    # clé. Volontairement PAS une dataclass dédiée par type (contrairement
    # à Task/Composant/ServiceAPI/ProjetBatch eux-mêmes) : une entrée de
    # corbeille n'a besoin de rien de plus qu'un conteneur générique
    # autour du to_dict() déjà existant de l'élément original, la
    # variation entre types reste entièrement dans "donnees" (dont la
    # forme dépend de "type") -- pas de nouvelle hiérarchie de classes
    # pour un simple sac de champs.
    corbeille: list = field(default_factory=list)
    # AJOUT (ComposantLayout/cL, SPEC_composantLayout.md section 9) :
    # stockage RÉEL des objets ComposantLayout, MÊME PATTERN que
    # `composants` ci-dessus pour ComposantSingle -- liste séparée plutôt
    # que fusionnée (cf. ServiceAPI.composants_layout, qui ne référence
    # que des NOMS ; la donnée elle-même vit ici, exactement comme
    # `composants` héberge les Composant référencés par
    # ServiceAPI.composants). Absent des anciens projets -> [] par
    # défaut, rétrocompatible sans migration.
    composants_layout: list = field(default_factory=list)  # list[ComposantLayout]
    # PATCH (section « Lib » de TaskConfig) : fichiers Python purs {"id", "nom", "code", "modifie_le"}, sauvegardés dans
    # project.json. Absent des anciens projets -> [] (aucune migration).
    libs: list = field(default_factory=list)

    def to_dict(self) -> dict:
        return {
            "libs": [dict(l) for l in self.libs],
            "services_api": [s.to_dict() for s in self.services_api],
            "composants": [c.to_dict() for c in self.composants],
            "composants_layout": [c.to_dict() for c in self.composants_layout],
            "bibliotheque_actions": self.bibliotheque_actions.to_dict(),
            "tasks": [t.to_dict() for t in self.tasks],
            "projets_batch": [p.to_dict() for p in self.projets_batch],
            "corbeille": list(self.corbeille),
        }

    @staticmethod
    def from_dict(d: dict) -> "Project":
        projet = Project._from_dict_base(d)
        projet.libs = [
            {"id": str(x.get("id") or uuid.uuid4().hex), "nom": str(x["nom"]), "code": str(x.get("code") or ""),
             "modifie_le": str(x.get("modifie_le") or "")}
            for x in (d.get("libs") or []) if isinstance(x, dict) and x.get("nom")
        ]
        _rafraichir_registre_libs(projet)
        return projet

    @staticmethod
    def _from_dict_base(d: dict) -> "Project":
        # Migration silencieuse, plusieurs générations de formats à couvrir
        # pour ne jamais perdre d'Actions déjà configurées par l'utilisateur :
        #
        #   1. Format le plus récent ("services_api" présent, SANS
        #      "api_features" imbriqué -- déjà migré vers la bibliothèque
        #      globale) : bibliotheque_actions est lue directement.
        #
        #   2. Format intermédiaire ("services_api" présent, avec
        #      "api_features" imbriqué dans CHAQUE service -- généré avant
        #      le retrait de Feature/APIFeatures) : on regroupe toutes les
        #      Actions de tous les api_features de tous les services_api
        #      en une seule bibliothèque plate (ordre : service par
        #      service, dans l'ordre de la liste).
        #
        #   3. Très ancien format ("interfaces" + "works" au niveau
        #      racine, avant même la notion de ServiceAPI unifié) : chaque
        #      ancien "work" est traité comme un api_features imbriqué
        #      (même logique que le cas 2 une fois reconstruit).
        if "services_api" in d:
            services_api_data = d.get("services_api", [])
            if d.get("bibliotheque_actions") is not None:
                # Cas 1 : déjà au format final.
                return Project(
                    services_api=[ServiceAPI.from_dict(s) for s in services_api_data],
                    composants=[Composant.from_dict(c) for c in d.get("composants", [])],
                    # AJOUT (cL, section 9) : absent des projets sauvegardés
                    # avant l'introduction de cL -> [] par défaut, cohérent
                    # avec ServiceAPI.composants_layout (même garde .get()).
                    composants_layout=[ComposantLayout.from_dict(c) for c in d.get("composants_layout", [])],
                    bibliotheque_actions=BibliothequeActions.from_dict(d["bibliotheque_actions"]),
                    tasks=[Task.from_dict(t) for t in d.get("tasks", [])],
                    projets_batch=[ProjetBatch.from_dict(p) for p in d.get("projets_batch", [])],
                    # PATCH (demande utilisateur explicite : corbeille) --
                    # "corbeille" absente = projet sauvegardé AVANT ce
                    # patch (aucune entrée, cf. décision "liste de dicts
                    # génériques" -- pas de migration nécessaire, une
                    # entrée de corbeille n'existait tout simplement pas
                    # avant). list() défensif : copie plutôt que la
                    # référence brute du JSON décodé.
                    corbeille=list(d.get("corbeille", [])),
                )
            # Cas 2 : regrouper les api_features imbriqués de chaque service.
            actions_migrees: list = []
            variables_migrees: list = []
            for s in services_api_data:
                api_features_d = s.get("api_features")
                if not api_features_d:
                    continue
                bib = BibliothequeActions.from_dict(api_features_d)
                actions_migrees.extend(bib.actions)
                variables_migrees.extend(bib.variables)
            return Project(
                services_api=[ServiceAPI.from_dict(s) for s in services_api_data],
                composants=[Composant.from_dict(c) for c in d.get("composants", [])],
                composants_layout=[ComposantLayout.from_dict(c) for c in d.get("composants_layout", [])],
                bibliotheque_actions=BibliothequeActions(actions=actions_migrees, variables=variables_migrees),
                tasks=[Task.from_dict(t) for t in d.get("tasks", [])],
                projets_batch=[ProjetBatch.from_dict(p) for p in d.get("projets_batch", [])],
                corbeille=list(d.get("corbeille", [])),
            )

        # Cas 3 : très ancien format "interfaces" + "works" au niveau racine.
        anciennes_interfaces = d.get("interfaces", [])
        anciens_works = d.get("works", [])
        services_api = []
        actions_migrees = []
        variables_migrees = []
        for i, interface_d in enumerate(anciennes_interfaces):
            api_features_d = anciens_works[i] if i < len(anciens_works) else {}
            services_api.append(ServiceAPI(
                nom=interface_d["nom"],
                composants=list(interface_d.get("composants", [])),
            ))
            bib = BibliothequeActions.from_dict(api_features_d)
            actions_migrees.extend(bib.actions)
            variables_migrees.extend(bib.variables)
        # Works surnuméraires (plus de Works que d'Interfaces) : conservés
        # comme ServiceAPI sans composants, pour ne rien perdre.
        for work_d in anciens_works[len(anciennes_interfaces):]:
            services_api.append(ServiceAPI(
                nom=work_d.get("nom", "Nouveau ServiceAPI"),
                composants=[],
            ))
            bib = BibliothequeActions.from_dict(work_d)
            actions_migrees.extend(bib.actions)
            variables_migrees.extend(bib.variables)

        return Project(
            services_api=services_api,
            composants=[Composant.from_dict(c) for c in d.get("composants", [])],
            bibliotheque_actions=BibliothequeActions(actions=actions_migrees, variables=variables_migrees),
            tasks=[],
            projets_batch=[],
        )

    def save(self, path: Optional[Path] = None):
        path = path or get_project_json_path()
        _rafraichir_registre_libs(self)
        # BUGFIX (LIST_TASKS persisté rempli, cf. docstring de
        # _nettoyer_list_tasks_avant_sauvegarde) : dernier filet, sur le
        # DICT déjà sérialisé -- self.tasks (l'état en mémoire) n'est
        # jamais modifié par cet appel, seul le JSON écrit sur disque
        # l'est.
        data = _nettoyer_list_tasks_avant_sauvegarde(self.to_dict())
        path.write_text(
            json.dumps(data, ensure_ascii=False, indent=2),
            encoding="utf-8",
        )

    @staticmethod
    def load(path: Optional[Path] = None) -> "Project":
        path = path or get_project_json_path()
        if not path.exists():
            return Project()
        data = json.loads(path.read_text(encoding="utf-8"))
        projet = Project.from_dict(data)
        # BLINDAGE (bug constaté sur données réelles : un ComposantLayout
        # nommé "VideoTemplate" alors que service_api.composants_layout
        # référençait encore "NouveauServiceAPI-NouveauComposantLayout" --
        # cause racine jamais identifiée avec certitude [ancienne version
        # du renommage avant le correctif de rename_composant_layout,
        # édition manuelle du JSON, ou autre], mais PEU IMPORTE la cause :
        # plutôt que de compter uniquement sur "le code qui écrit est
        # correct" (rename_composant_layout est correct AUJOURD'HUI, mais
        # rien n'empêchait un JSON déjà désynchronisé -- produit par une
        # ancienne version, une migration future, ou une édition à la
        # main -- de rester silencieusement cassé pour toujours, la
        # grille se contentant de filtrer les entrées introuvables sans
        # jamais rien signaler). Réparation systématique à CHAQUE
        # chargement : seule garantie qui ne dépend pas de "tous les
        # sites d'écriture sont bien tous corrects, pour toujours".
        projet._reparer_coherence_composants_layout()
        return projet

    def _reparer_coherence_composants_layout(self):
        """Corrige et journalise toute incohérence nom/préfixe détectée
        entre self.composants_layout (objets réels) et
        service_api.composants_layout (listes de noms) -- cf. Project.load
        pour le contexte complet du bug d'origine.

        Deux invariants sont imposés ici, pour CHAQUE ComposantLayout :
          1. composant_layout.nom DOIT commencer par
             "{composant_layout.service_api_nom}-" (même contrat que
             add_composant_layout_avec_nom_auto/rename_composant_layout).
          2. Le nom de CET objet doit apparaître dans
             service_api.composants_layout (et réciproquement, aucune
             entrée de cette liste ne doit pointer vers un objet absent).

        Ne touche JAMAIS à image_reference ni ne tente de deviner un
        fichier image correspondant : un chemin de fichier qui ne
        correspond à aucun fichier réel sur disque reste un problème
        distinct (cf. _verifier_images_manquantes), pas résolu ici pour
        ne pas risquer de rattacher la mauvaise image à la mauvaise
        entrée -- un préfixe de nom peut se déduire avec certitude,
        une image ne peut PAS se deviner sans risque."""
        self.avertissements_chargement: list[str] = getattr(self, "avertissements_chargement", [])

        for cl in self.composants_layout:
            prefixe_attendu = f"{cl.service_api_nom}-"
            if cl.service_api_nom and not cl.nom.startswith(prefixe_attendu):
                ancien_nom = cl.nom
                nouveau_nom = f"{prefixe_attendu}{ancien_nom}"
                # Unicité : si ce nom complet existe déjà (cas
                # extrêmement improbable), on suffixe plutôt que
                # d'écraser silencieusement un autre ComposantLayout.
                suffixe = 2
                nom_final = nouveau_nom
                while self.find_composant_layout(nom_final) is not None:
                    nom_final = f"{nouveau_nom}_{suffixe}"
                    suffixe += 1
                cl.nom = nom_final
                self.avertissements_chargement.append(
                    f"ComposantLayout renommé automatiquement pour cohérence : "
                    f"« {ancien_nom} » -> « {nom_final} » (le nom sauvegardé ne "
                    f"portait pas le préfixe attendu « {prefixe_attendu} »)."
                )
                # Répercute immédiatement sur la liste de noms du
                # ServiceAPI concerné avant l'étape de resynchronisation
                # générale ci-dessous, pour que le lookup par nom la
                # retrouve correctement dans la boucle suivante.
                service_api = self.find_service_api(cl.service_api_nom)
                if service_api and ancien_nom in service_api.composants_layout:
                    idx = service_api.composants_layout.index(ancien_nom)
                    service_api.composants_layout[idx] = nom_final

        # Resynchronise chaque service_api.composants_layout avec la
        # réalité des objets existants : retire les noms fantômes (plus
        # aucun objet correspondant), ajoute les objets orphelins (objet
        # existant mais absent de la liste de son propre ServiceAPI --
        # ne devrait plus arriver après le correctif ci-dessus, mais
        # coûte rien de le garantir aussi dans l'autre sens).
        noms_cl_par_service: dict[str, list[str]] = {}
        for cl in self.composants_layout:
            noms_cl_par_service.setdefault(cl.service_api_nom, []).append(cl.nom)

        for service_api in self.services_api:
            noms_reels = noms_cl_par_service.get(service_api.nom, [])
            noms_fantomes = [n for n in service_api.composants_layout if n not in noms_reels]
            for n in noms_fantomes:
                service_api.composants_layout.remove(n)
                self.avertissements_chargement.append(
                    f"Référence orpheline retirée de « {service_api.nom} » : "
                    f"« {n} » ne correspond à aucun ComposantLayout existant."
                )
            for n in noms_reels:
                if n not in service_api.composants_layout:
                    service_api.composants_layout.append(n)
                    self.avertissements_chargement.append(
                        f"ComposantLayout « {n} » réintégré à la liste de "
                        f"« {service_api.nom} » (absent alors que l'objet existe)."
                    )

    # --- Helpers d'accès ---
    def find_composant(self, nom: str) -> Optional[Composant]:
        return next((c for c in self.composants if c.nom == nom), None)

    def find_composant_layout(self, nom: str) -> Optional["ComposantLayout"]:
        # AJOUT (cL, section 9) : symétrique de find_composant ci-dessus.
        return next((c for c in self.composants_layout if c.nom == nom), None)

    def find_service_api(self, nom: str) -> Optional[ServiceAPI]:
        return next((s for s in self.services_api if s.nom == nom), None)

    def find_task(self, id_: str) -> Optional[Task]:
        return next((t for t in self.tasks if t.id == id_), None)

    def add_service_api(self, nom: str) -> ServiceAPI:
        """Ajoute un ServiceAPI si le nom n'existe pas déjà (unique, insensible à la casse)."""
        nom = nom.strip()
        if not nom:
            raise ValueError("Le nom du ServiceAPI ne peut pas être vide.")
        if self.find_service_api(nom):
            raise ValueError(f"Un ServiceAPI nommé « {nom} » existe déjà.")
        service_api = ServiceAPI(nom=nom)
        self.services_api.append(service_api)
        get_components_dir(nom)  # crée le sous-dossier components/<nom> immédiatement
        return service_api

    def add_service_api_avec_nom_auto(self) -> ServiceAPI:
        """Crée immédiatement un ServiceAPI avec un nom par défaut auto-généré
        et unique (ex: "NouveauServiceAPI", "NouveauServiceAPI2"...), destiné à
        être renommé ensuite par l'utilisateur (même logique que
        add_composant_avec_nom_auto : jamais de dialogue de nommage séparé)."""
        base = "NouveauServiceAPI"
        candidat = base
        i = 1
        while self.find_service_api(candidat):
            i += 1
            candidat = f"{base}{i}"
        return self.add_service_api(candidat)

    def remove_service_api(self, nom: str):
        """PATCH (demande utilisateur explicite : corbeille) -- même
        principe que remove_composant ci-dessus : les Composants de ce
        ServiceAPI et leurs images sont déplacés vers la corbeille (pas
        supprimés) ; le dossier components/<nom> lui-même est déplacé en
        bloc plutôt que fichier par fichier (plus simple et garantit de
        ne rien laisser en cas d'ajout futur de fichiers non référencés
        dans variantes). N'affecte pas bibliotheque_actions (globale au
        Project, indépendante de ce ServiceAPI) -- une Action référençant
        un composant supprimé avec ce ServiceAPI garde sa référence telle
        quelle (même comportement qu'avant ce patch)."""
        service_api = self.find_service_api(nom)
        if not service_api:
            return
        composants_supprimes_dicts = []
        for comp_nom in list(service_api.composants):
            comp = self.find_composant(comp_nom)
            if comp:
                composants_supprimes_dicts.append(comp.to_dict())
                self.composants.remove(comp)
        # BUG FIX (composants_layout perdus définitivement lors de la
        # suppression d'un ServiceAPI, même défaut que celui corrigé dans
        # rename_service_api ci-dessus -- ici la boucle Composant
        # ci-dessus n'avait pas d'équivalent pour ComposantLayout) : sans
        # cette boucle, self.composants_layout gardait des entrées
        # orphelines pointant vers un service_api_nom qui n'existe plus
        # (ni supprimées, ni dans la corbeille), tandis que leurs images
        # disparaissaient quand même (déplacées avec tout le dossier
        # components/<nom> juste en dessous) -- objets fantômes en
        # mémoire, jamais nettoyés, jamais restaurables. MÊME PATTERN que
        # les Composant ci-dessus : on les retire de self.composants_layout
        # et on garde leur dict pour restauration dans "extra".
        composants_layout_supprimes_dicts = []
        for cl_nom in list(service_api.composants_layout):
            cl = self.find_composant_layout(cl_nom)
            if cl:
                composants_layout_supprimes_dicts.append(cl.to_dict())
                self.composants_layout.remove(cl)
        self.services_api.remove(service_api)
        comp_dir = get_app_data_dir() / "components" / nom
        chemin_deplace = None
        if comp_dir.exists():
            chemin_deplace = _deplacer_dossier_vers_corbeille(comp_dir)
        self._ajouter_a_corbeille(
            "service_api", service_api.nom, service_api.to_dict(),
            fichiers=[chemin_deplace] if chemin_deplace else [],
            extra={
                "composants": composants_supprimes_dicts,
                "composants_layout": composants_layout_supprimes_dicts,
            },
        )

    def rename_service_api(self, ancien_nom: str, nouveau_nom: str):
        """Renomme un ServiceAPI : dossier sur disque, Composants (nom, service_api_nom,
        image_path) et fichiers PNG associés sont tous mis à jour en cascade."""
        nouveau_nom = nouveau_nom.strip()
        if not nouveau_nom:
            raise ValueError("Le nom du ServiceAPI ne peut pas être vide.")
        if nouveau_nom == ancien_nom:
            return  # rien à faire
        service_api = self.find_service_api(ancien_nom)
        if not service_api:
            raise ValueError(f"ServiceAPI « {ancien_nom} » introuvable.")
        if self.find_service_api(nouveau_nom):
            raise ValueError(f"Un ServiceAPI nommé « {nouveau_nom} » existe déjà.")

        ancien_dir = get_app_data_dir() / "components" / ancien_nom
        nouveau_dir = get_app_data_dir() / "components" / nouveau_nom
        nouveau_dir.parent.mkdir(parents=True, exist_ok=True)
        # BUG FIX (perte silencieuse de variantes lors d'un renommage) :
        # cette fonction renommait auparavant TOUT LE DOSSIER
        # components/<ancien_nom> en bloc, ICI, AVANT la boucle ci-dessous
        # qui déplace chaque variante individuellement en cherchant le
        # fichier à son ancien chemin complet (get_app_data_dir() /
        # ancien_variant_path, lequel pointe justement vers ce dossier).
        # Une fois le dossier déjà renommé en bloc, ce chemin n'existe
        # plus -- la boucle concluait alors (à tort) que le fichier
        # "n'existait déjà plus avant même le renommage" et l'ignorait :
        # la variante disparaissait du modèle alors que le fichier était
        # toujours sur disque, juste déplacé sous l'ancien nom de fichier
        # dans le nouveau dossier. On ne renomme donc plus le dossier en
        # bloc à l'avance : seule sa création est assurée ici (vide s'il
        # n'existait pas encore), et c'est la boucle plus bas -- déjà
        # capable de gérer collisions et noms de fichiers non standards --
        # qui déplace chaque fichier individuellement vers sa destination
        # finale. L'ancien dossier est retiré seulement s'il se retrouve
        # vide une fois tous les fichiers déplacés (jamais avant).
        nouveau_dir.mkdir(parents=True, exist_ok=True)

        nouveaux_noms_composants = []
        for comp_nom in list(service_api.composants):
            comp = self.find_composant(comp_nom)
            if not comp:
                continue
            # Partie après le préfixe "AncienNom-" (ex: "BoutonOK" dans "Word-BoutonOK")
            suffixe = comp.nom[len(ancien_nom) + 1:] if comp.nom.startswith(ancien_nom + "-") else comp.nom
            nouveau_comp_nom = f"{nouveau_nom}-{suffixe}"

            nouvelles_variantes = []
            for ancienne_variante in comp.variantes:
                # PATCH (SPEC_GLOBALE_AutoniaX.md, Partie A §4.3) --
                # ancienne_variante peut être une Variante (réglages
                # personnalisés par variante) ou, cas limite défensif, un
                # str brut (projet pas encore migré) : str(...) via
                # l'héritage str donne le chemin dans les deux cas, sans
                # changer la logique de déplacement de fichier ci-dessous.
                ancien_variant_path = str(ancienne_variante)
                ancien_fichier = Path(ancien_variant_path).name
                # Le nom de fichier peut ne pas commencer exactement par
                # l'ancien nom de ServiceAPI (composant capturé avant un
                # précédent renommage, caractères particuliers, etc.) :
                # dans ce cas on garde le nom de fichier tel quel plutôt
                # que de construire un nouveau chemin vers un fichier qui
                # n'existera jamais (bug précédent : le chemin stocké
                # pointait vers un fichier inexistant, variante "perdue").
                nouveau_fichier = ancien_fichier.replace(ancien_nom, nouveau_nom, 1) \
                    if ancien_fichier.startswith(ancien_nom) else ancien_fichier
                ancien_img_abs = get_app_data_dir() / ancien_variant_path
                nouveau_image_path = f"components/{nouveau_nom}/{nouveau_fichier}"
                nouveau_img_abs = get_app_data_dir() / nouveau_image_path
                if ancien_img_abs.exists() and ancien_img_abs != nouveau_img_abs:
                    nouveau_img_abs.parent.mkdir(parents=True, exist_ok=True)
                    if nouveau_img_abs.exists():
                        # Collision de nom au nouvel emplacement : on
                        # suffixe plutôt que d'écraser un fichier existant
                        # ou d'abandonner silencieusement l'ancien.
                        i = 2
                        base_stem, ext = Path(nouveau_fichier).stem, Path(nouveau_fichier).suffix
                        while nouveau_img_abs.exists():
                            nouveau_fichier = f"{base_stem}_{i}{ext}"
                            nouveau_image_path = f"components/{nouveau_nom}/{nouveau_fichier}"
                            nouveau_img_abs = get_app_data_dir() / nouveau_image_path
                            i += 1
                    ancien_img_abs.rename(nouveau_img_abs)
                elif not ancien_img_abs.exists():
                    # Le fichier référencé n'existe déjà plus avant même le
                    # renommage (variante déjà orpheline) : on ignore cette
                    # variante plutôt que de garder un chemin mort, pour ne
                    # pas propager silencieusement une référence cassée.
                    print(f"[AutoniaX] Variante déjà introuvable pour « {comp.nom} », ignorée lors du renommage : {ancien_img_abs}")
                    continue
                # PATCH (§4.3) -- préserve les réglages par-variante
                # (seuil_confiance, flou_noyau, etc.) via avec_chemin() au
                # lieu de reconstruire un str brut ici : sans ça, tout
                # réglage personnalisé sur cette variante serait perdu
                # (silencieusement réinitialisé aux défauts de la classe
                # Variante) à chaque renommage de ServiceAPI.
                nouvelles_variantes.append(
                    ancienne_variante.avec_chemin(nouveau_image_path)
                    if isinstance(ancienne_variante, Variante)
                    else Variante(chemin=nouveau_image_path)
                )

            comp.nom = nouveau_comp_nom
            comp.service_api_nom = nouveau_nom
            comp.variantes = nouvelles_variantes
            nouveaux_noms_composants.append(nouveau_comp_nom)

        # BUG FIX (composants_layout orphelins après renommage d'un
        # ServiceAPI, cf. rapport utilisateur : renommage "yt-view" ayant
        # laissé 6 ComposantLayout et leur dossier physique bloqués sous
        # l'ancien nom) -- cette boucle était absente : rename_service_api
        # migrait bien service_api.composants (Composant, ci-dessus) et
        # task.services_api_importes (plus bas), mais jamais
        # service_api.composants_layout ni les ComposantLayout eux-mêmes
        # (self.composants_layout, liste séparée de self.composants).
        # MÊME PATTERN que la boucle Composant ci-dessus : préserve le
        # suffixe après "AncienNom-", déplace image_reference sur disque
        # (variante unique, pas de liste comme Composant.variantes), gère
        # les collisions de nom de fichier au nouvel emplacement, et
        # ignore proprement (avec message) une référence déjà orpheline
        # plutôt que de la propager silencieusement.
        nouveaux_noms_composants_layout = []
        for cl_nom in list(service_api.composants_layout):
            cl = self.find_composant_layout(cl_nom)
            if not cl:
                continue
            suffixe = cl.nom[len(ancien_nom) + 1:] if cl.nom.startswith(ancien_nom + "-") else cl.nom
            nouveau_cl_nom = f"{nouveau_nom}-{suffixe}"

            nouvelle_image_reference = cl.image_reference
            if cl.image_reference:
                ancien_img_abs = get_app_data_dir() / cl.image_reference
                ancien_fichier = Path(cl.image_reference).name
                nouveau_fichier = ancien_fichier.replace(ancien_nom, nouveau_nom, 1) \
                    if ancien_fichier.startswith(ancien_nom) else ancien_fichier
                nouvelle_image_reference = f"components/{nouveau_nom}/{nouveau_fichier}"
                nouveau_img_abs = get_app_data_dir() / nouvelle_image_reference
                if ancien_img_abs.exists() and ancien_img_abs != nouveau_img_abs:
                    nouveau_img_abs.parent.mkdir(parents=True, exist_ok=True)
                    if nouveau_img_abs.exists():
                        i = 2
                        base_stem, ext = Path(nouveau_fichier).stem, Path(nouveau_fichier).suffix
                        while nouveau_img_abs.exists():
                            nouveau_fichier = f"{base_stem}_{i}{ext}"
                            nouvelle_image_reference = f"components/{nouveau_nom}/{nouveau_fichier}"
                            nouveau_img_abs = get_app_data_dir() / nouvelle_image_reference
                            i += 1
                    ancien_img_abs.rename(nouveau_img_abs)
                elif not ancien_img_abs.exists():
                    print(f"[AutoniaX] image_reference déjà introuvable pour « {cl.nom} », ignorée lors du renommage : {ancien_img_abs}")

            # Sous-dossier d'images de test (cf. rename_composant_layout) :
            # même migration, par cohérence, lors d'un renommage en masse.
            ancien_dossier_tests = get_components_dir(ancien_nom) / f"{suffixe}_tests"
            if ancien_dossier_tests.exists():
                nouveau_dossier_tests = get_components_dir(nouveau_nom) / f"{suffixe}_tests"
                if ancien_dossier_tests != nouveau_dossier_tests and not nouveau_dossier_tests.exists():
                    ancien_dossier_tests.rename(nouveau_dossier_tests)

            cl.nom = nouveau_cl_nom
            cl.service_api_nom = nouveau_nom
            cl.image_reference = nouvelle_image_reference
            nouveaux_noms_composants_layout.append(nouveau_cl_nom)

        service_api.composants_layout = nouveaux_noms_composants_layout

        # Une fois toutes les variantes déplacées individuellement par la
        # boucle ci-dessus, l'ancien dossier ne doit plus contenir que des
        # fichiers déjà orphelins avant le renommage (jamais un fichier
        # qu'on vient de perdre : cf. le BUG FIX plus haut qui a justement
        # supprimé le rename en bloc responsable de ça). On ne le retire
        # que s'il est bien vide, jamais en forçant une suppression qui
        # emporterait des fichiers qu'on n'a pas su rattacher.
        if ancien_dir.exists() and ancien_dir != nouveau_dir:
            try:
                if not any(ancien_dir.iterdir()):
                    ancien_dir.rmdir()
            except OSError:
                pass  # non bloquant : un dossier non vide ou verrouillé reste tel quel, sans faire échouer le renommage

        service_api.composants = nouveaux_noms_composants
        service_api.nom = nouveau_nom

        # BUG FIX (renommage d'un ServiceAPI cassait les Tasks qui l'avaient
        # importé) : Task.services_api_importes est un dict {nom_service_api:
        # instance_id} indexé par NOM, jamais touché ci-dessus. Sans cette
        # migration, chaque Task gardait l'ANCIEN nom comme clé alors que
        # tous les Composant ont déjà basculé vers service_api_nom ==
        # nouveau_nom : composants_importes_task(task) ne retrouvait plus
        # aucun composant pour ce ServiceAPI (find_service_api(ancien_nom)
        # échoue, et le repli sur service_api_nom == ancien_nom ne matche
        # plus rien non plus), et la liaison à l'instance nodriver associée
        # (instance_id) était perdue. On migre la clé en conservant sa
        # position dans le dict et son instance_id, sans toucher aux autres
        # entrées ni à l'ordre des Tasks eux-mêmes.
        for task in self.tasks:
            if ancien_nom in task.services_api_importes:
                task.services_api_importes = {
                    (nouveau_nom if nom == ancien_nom else nom): instance_id
                    for nom, instance_id in task.services_api_importes.items()
                }

        # BUG FIX (même trou que celui corrigé dans rename_composant
        # ci-dessus, mais pour un renommage de ServiceAPI entier) :
        # chaque Composant de ce service a déjà été renommé plus haut
        # (AncienNom-X -> NouveauNom-X), donc toute Action de la
        # bibliothèque globale (cf. BibliothequeActions, référencée par
        # composant_reference) qui visait un de CES composants doit
        # suivre le même préfixe, sinon elle se retrouve à pointer vers
        # un nom de composant qui n'existe plus après le renommage.
        for action in self.bibliotheque_actions.actions:
            ref = action.composant_reference
            if ref and ref.startswith(ancien_nom + "-"):
                action.composant_reference = nouveau_nom + ref[len(ancien_nom):]

    def add_composant(self, service_api_nom: str, composant_nom_court: str, image: QImage) -> Composant:
        """Crée un Composant à partir d'une image déjà découpée (point 2).
        `composant_nom_court` est la partie après le préfixe (ex: "BoutonOK"
        pour "Word-BoutonOK") ; le nom complet est reconstruit ici et doit
        être unique globalement dans le projet, comme l'exige la spec."""
        service_api = self.find_service_api(service_api_nom)
        if not service_api:
            raise ValueError(f"ServiceAPI « {service_api_nom} » introuvable.")

        composant_nom_court = composant_nom_court.strip()
        if not composant_nom_court:
            raise ValueError("Le nom du composant ne peut pas être vide.")
        if "-" in composant_nom_court:
            raise ValueError("Le nom du composant ne peut pas contenir de tiret « - ».")

        nom_complet = f"{service_api_nom}-{composant_nom_court}"
        if self.find_composant(nom_complet):
            raise ValueError(f"Un composant nommé « {nom_complet} » existe déjà.")

        if image.isNull():
            raise ValueError("L'image capturée est vide.")

        image_path = f"components/{service_api_nom}/{nom_complet}.png"
        chemin_absolu = get_app_data_dir() / image_path
        chemin_absolu.parent.mkdir(parents=True, exist_ok=True)
        if not image.save(str(chemin_absolu), "PNG"):
            raise ValueError(f"Échec de l'écriture de l'image sur disque : {chemin_absolu}")

        # PATCH (bug rapporté : AttributeError 'str' object has no attribute
        # 'priorite_selection' à l'ouverture du panneau de réglages d'un
        # composant single fraîchement créé) -- image_path ci-dessus est une
        # str nue (f-string), pas une Variante : sans ce Variante(...), la
        # toute première variante du composant restait une str brute au lieu
        # d'un objet Variante, et _rafraichir_widgets_reglages_detection
        # (qui lit variante.priorite_selection/seuil_confiance/etc. dès que
        # cette variante est sélectionnée -- le cas par défaut à l'ouverture
        # du panneau) plantait dessus. Tous les AUTRES points d'ajout de
        # variante du fichier (cf. Variante(chemin=...) dans les blocs
        # nouvelles_variantes.append(...) plus bas) construisaient déjà
        # correctement un Variante -- seul ce chemin de création via
        # add_composant() avait été oublié.
        composant = Composant(nom=nom_complet, service_api_nom=service_api_nom, variantes=[Variante(image_path)])
        self.composants.append(composant)
        service_api.composants.append(nom_complet)
        return composant

    def _nom_court_disponible(self, service_api_nom: str, base: str) -> str:
        """Trouve un nom court unique (globalement) à partir d'une base,
        en ajoutant un suffixe numérique croissant si nécessaire (ex:
        NouveauComposant, NouveauComposant2, NouveauComposant3...)."""
        candidat = base
        i = 1
        while self.find_composant(f"{service_api_nom}-{candidat}"):
            i += 1
            candidat = f"{base}{i}"
        return candidat

    def add_composant_avec_nom_auto(self, service_api_nom: str, image: QImage) -> Composant:
        """Crée immédiatement un Composant avec un nom par défaut auto-généré
        et unique (ex: "NouveauComposant"), destiné à être renommé ensuite par
        l'utilisateur directement dans le panneau de réglages inline — plus de
        QDialog de nommage séparé (point 18 : jamais de dialogue qui casse le
        flux). Le nom par défaut est garanti unique globalement dès la création."""
        nom_court = self._nom_court_disponible(service_api_nom, "NouveauComposant")
        return self.add_composant(service_api_nom, nom_court, image)

    def rename_composant(self, ancien_nom_complet: str, nouveau_nom_court: str) -> Composant:
        """Renomme un Composant (partie courte seulement, le préfixe ServiceAPI
        reste fixe) avec contrôle d'unicité globale (ServiceAPI-Nom). Renomme
        aussi le fichier PNG sur disque et met à jour la référence dans
        le ServiceAPI parent."""
        composant = self.find_composant(ancien_nom_complet)
        if not composant:
            raise ValueError(f"Composant « {ancien_nom_complet} » introuvable.")

        nouveau_nom_court = nouveau_nom_court.strip()
        if not nouveau_nom_court:
            raise ValueError("Le nom du composant ne peut pas être vide.")
        if "-" in nouveau_nom_court:
            raise ValueError("Le nom du composant ne peut pas contenir de tiret « - ».")

        service_api_nom = composant.service_api_nom
        nouveau_nom_complet = f"{service_api_nom}-{nouveau_nom_court}"
        if nouveau_nom_complet == ancien_nom_complet:
            return composant  # rien à faire

        if self.find_composant(nouveau_nom_complet):
            raise ValueError(f"Un composant nommé « {nouveau_nom_complet} » existe déjà.")

        # Renomme le fichier de CHAQUE variante (pas seulement la principale),
        # en gardant un suffixe numérique pour les distinguer sur disque
        # (Word-BoutonOK.png, Word-BoutonOK_2.png, Word-BoutonOK_3.png...).
        nouvelles_variantes = []
        for i, ancienne_variante in enumerate(composant.variantes):
            # PATCH (SPEC_GLOBALE_AutoniaX.md, Partie A §4.3, même correctif
            # qu'appliqué à rename_service_api -- rename_composant a
            # exactement le même pattern de reconstruction de
            # nouvelles_variantes et souffrirait de la même perte
            # silencieuse des réglages par-variante sans ce changement).
            ancien_variant_path = str(ancienne_variante)
            ancien_img_abs = get_app_data_dir() / ancien_variant_path
            suffixe = "" if i == 0 else f"_{i + 1}"
            nouveau_variant_path = f"components/{service_api_nom}/{nouveau_nom_complet}{suffixe}.png"
            nouveau_img_abs = get_app_data_dir() / nouveau_variant_path
            # CORRECTIF (bug de casse Windows/Linux) : Path.__eq__ normalise
            # la casse sous Windows (os.path.normcase), donc "!=" vaut False
            # quand seule la casse change (ex: "...Composant1.png" vs
            # "...composant1.png") -- le .rename() était alors sauté alors
            # que le nom stocké dans project.json (nouveau_variant_path)
            # est bien mis à jour avec la nouvelle casse. Résultat : le
            # fichier physique gardait l'ANCIENNE casse indéfiniment, alors
            # que project.json pointait vers la NOUVELLE -- incohérence
            # invisible sur Windows (insensible à la casse) mais fatale une
            # fois le service_api.zip envoyé vers un sAutoniax Linux
            # (sensible à la casse), où le fichier référencé n'existe pas.
            # On distingue maintenant explicitement deux cas : chemins
            # réellement différents (comportement inchangé), et chemins
            # identiques à la casse près (renommage forcé en 2 temps via un
            # nom temporaire, nécessaire car un rename direct entre deux
            # noms qui ne diffèrent que par la casse est un no-op silencieux
            # sur la plupart des filesystems insensibles à la casse).
            chemins_diff_casse_seulement = (
                ancien_img_abs != nouveau_img_abs
                and str(ancien_img_abs).lower() == str(nouveau_img_abs).lower()
            )
            log.info(
                f"[DIAG-RENAME] variante {i} -- ancien_img_abs={ancien_img_abs!s} "
                f"nouveau_img_abs={nouveau_img_abs!s} "
                f"ancien_img_abs.exists()={ancien_img_abs.exists()} "
                f"ancien_img_abs != nouveau_img_abs -> {ancien_img_abs != nouveau_img_abs} "
                f"(str égales ? {str(ancien_img_abs) == str(nouveau_img_abs)!r}, "
                f"str égales insensible casse ? {str(ancien_img_abs).lower() == str(nouveau_img_abs).lower()!r}, "
                f"diff_casse_seulement={chemins_diff_casse_seulement!r})"
            )
            if ancien_img_abs.exists() and (ancien_img_abs != nouveau_img_abs or chemins_diff_casse_seulement):
                nouveau_img_abs.parent.mkdir(parents=True, exist_ok=True)
                try:
                    contenu_avant = sorted(os.listdir(ancien_img_abs.parent))
                except OSError:
                    contenu_avant = ["<erreur>"]
                if chemins_diff_casse_seulement:
                    # Renommage en 2 temps via un nom temporaire : un
                    # rename() direct entre deux noms qui ne diffèrent que
                    # par la casse est un no-op silencieux sur un FS
                    # insensible à la casse (Windows/macOS par défaut) --
                    # passer par un nom intermédiaire garantit que l'entrée
                    # de répertoire est bien réécrite avec la nouvelle casse.
                    temp_abs = nouveau_img_abs.with_name(f".__renommage_temp__{nouveau_img_abs.name}")
                    ancien_img_abs.rename(temp_abs)
                    temp_abs.rename(nouveau_img_abs)
                else:
                    ancien_img_abs.rename(nouveau_img_abs)
                try:
                    contenu_apres = sorted(os.listdir(nouveau_img_abs.parent))
                except OSError:
                    contenu_apres = ["<erreur>"]
                log.info(
                    f"[DIAG-RENAME] .rename() EXÉCUTÉ (via_nom_temp={chemins_diff_casse_seulement!r}) -- "
                    f"contenu_dossier_AVANT={contenu_avant!r} "
                    f"contenu_dossier_APRÈS={contenu_apres!r} "
                    f"nouveau_img_abs.exists()={nouveau_img_abs.exists()!r}"
                )
            else:
                log.info(
                    f"[DIAG-RENAME] .rename() SAUTÉ (condition fausse) -- "
                    f"raison probable : exists={ancien_img_abs.exists()!r}, "
                    f"chemins_juges_identiques={ancien_img_abs == nouveau_img_abs!r}"
                )
            nouvelles_variantes.append(
                ancienne_variante.avec_chemin(nouveau_variant_path)
                if isinstance(ancienne_variante, Variante)
                else Variante(chemin=nouveau_variant_path)
            )

        service_api = self.find_service_api(service_api_nom)
        if service_api and ancien_nom_complet in service_api.composants:
            idx = service_api.composants.index(ancien_nom_complet)
            service_api.composants[idx] = nouveau_nom_complet

        composant.nom = nouveau_nom_complet
        composant.variantes = nouvelles_variantes

        # BUG FIX (Action.composant_reference non migré lors d'un
        # renommage de Composant) : bibliotheque_actions est GLOBALE au
        # Project (cf. sa docstring -- "une Action référence directement
        # n'importe quel composant du Project entier") et une Action
        # stocke le nom complet du composant visé dans composant_reference
        # (ex: "Word-BoutonEnregistrer"). Rien ne migrait cette chaîne
        # jusqu'ici : renommer un Composant laissait silencieusement
        # toute Action qui le référençait pointer vers un nom qui n'existe
        # plus -- aucune erreur au renommage, l'Action semble intacte dans
        # la bibliothèque, mais échoue (ou pire, ne matche simplement
        # plus rien) à l'exécution. On met à jour la référence texte pour
        # chaque Action concernée, sans toucher aux autres champs.
        for action in self.bibliotheque_actions.actions:
            if action.composant_reference == ancien_nom_complet:
                action.composant_reference = nouveau_nom_complet

        return composant

    def update_composant_image(self, nom_complet: str, image: QImage):
        """Re-capture d'un Composant existant : écrase le PNG de la variante
        PRINCIPALE (la première) au même chemin (mise à jour globale et
        automatique, point 2 — toutes les Features qui référencent ce nom voient
        la nouvelle image immédiatement). Les autres variantes, s'il y en a,
        ne sont pas affectées : utiliser add_variante_composant/
        remove_variante_composant pour les gérer individuellement."""
        composant = self.find_composant(nom_complet)
        if not composant:
            raise ValueError(f"Composant « {nom_complet} » introuvable.")
        if image.isNull():
            raise ValueError("L'image capturée est vide.")

        if composant.variantes:
            chemin_absolu = get_app_data_dir() / composant.variantes[0]
        else:
            chemin_absolu = get_app_data_dir() / f"components/{composant.service_api_nom}/{nom_complet}.png"
        chemin_absolu.parent.mkdir(parents=True, exist_ok=True)
        if not image.save(str(chemin_absolu), "PNG"):
            raise ValueError(f"Échec de l'écriture de l'image sur disque : {chemin_absolu}")
        if not composant.variantes:
            # PATCH (SPEC_GLOBALE_AutoniaX.md, Partie A §4.1) -- la toute
            # première variante d'un composant doit être une Variante
            # (pas un str brut) initialisée avec les valeurs PAR DÉFAUT DU
            # COMPOSANT (cf. §2.2 : ces 8 champs restent sur ComposantSingle
            # justement comme gabarit pour toute nouvelle variante), sinon
            # le moteur de détection (qui lit Variante.<champ>, cf. §3.2)
            # se rabattrait silencieusement sur les défauts de la classe
            # Variante plutôt que sur les réglages réels déjà configurés
            # pour ce composant.
            nouveau_chemin = str(chemin_absolu.relative_to(get_app_data_dir())).replace("\\", "/")
            composant.variantes = [Variante(
                chemin=nouveau_chemin,
                priorite_selection=composant.priorite_selection,
                seuil_confiance=composant.seuil_confiance,
                flou_noyau=composant.flou_noyau,
                seuil_candidats_potentiels=composant.seuil_candidats_potentiels,
                delta_conflit=composant.delta_conflit,
                couleur_succes=composant.couleur_succes,
                couleur_echec=composant.couleur_echec,
                code_filtre=composant.code_filtre,
            )]

    def add_variante_composant(self, nom_complet: str, image: QImage) -> str:
        """Ajoute une variante supplémentaire à un Composant existant (bouton
        « + Variante » du panneau de réglages). Écrit une nouvelle image PNG
        sur disque (nom suffixé _2, _3... pour ne pas écraser les variantes
        déjà présentes) et l'ajoute à la liste `variantes`. Retourne le
        chemin relatif de la nouvelle variante."""
        composant = self.find_composant(nom_complet)
        if not composant:
            raise ValueError(f"Composant « {nom_complet} » introuvable.")
        if image.isNull():
            raise ValueError("L'image capturée est vide.")

        i = len(composant.variantes) + 1
        while True:
            suffixe = "" if i == 1 else f"_{i}"
            variant_path = f"components/{composant.service_api_nom}/{nom_complet}{suffixe}.png"
            if variant_path not in composant.variantes and not (get_app_data_dir() / variant_path).exists():
                break
            i += 1

        chemin_absolu = get_app_data_dir() / variant_path
        chemin_absolu.parent.mkdir(parents=True, exist_ok=True)
        if not image.save(str(chemin_absolu), "PNG"):
            raise ValueError(f"Échec de l'écriture de l'image sur disque : {chemin_absolu}")

        # PATCH (SPEC_GLOBALE_AutoniaX.md, Partie A §4.1) -- ajoute une
        # VRAIE Variante (pas un str brut) initialisée avec les valeurs
        # PAR DÉFAUT DU COMPOSANT (cf. §2.2, ces 8 champs servent de
        # gabarit pour toute nouvelle variante) : sans ça, cette nouvelle
        # variante retomberait sur les défauts codés en dur de la classe
        # Variante (seuil_confiance=0.9, etc.) au lieu des réglages déjà
        # personnalisés pour ce composant, un changement de comportement
        # de détection silencieux et non voulu au moment même de l'ajout.
        nouvelle_variante = Variante(
            chemin=variant_path,
            priorite_selection=composant.priorite_selection,
            seuil_confiance=composant.seuil_confiance,
            flou_noyau=composant.flou_noyau,
            seuil_candidats_potentiels=composant.seuil_candidats_potentiels,
            delta_conflit=composant.delta_conflit,
            couleur_succes=composant.couleur_succes,
            couleur_echec=composant.couleur_echec,
            code_filtre=composant.code_filtre,
        )
        composant.variantes.append(nouvelle_variante)
        return variant_path

    def remove_variante_composant(self, nom_complet: str, variant_path: str):
        """Retire une variante précise d'un Composant (image + entrée dans
        la liste). Refuse de supprimer la dernière variante restante : un
        composant doit toujours garder au moins une image (sinon plus rien
        à reconnaître à l'écran) — pour retirer la dernière, il faut
        supprimer le composant entier."""
        composant = self.find_composant(nom_complet)
        if not composant:
            raise ValueError(f"Composant « {nom_complet} » introuvable.")
        if variant_path not in composant.variantes:
            return
        if len(composant.variantes) <= 1:
            raise ValueError(
                "Impossible de supprimer la dernière variante : "
                "un composant doit garder au moins une image."
            )
        composant.variantes.remove(variant_path)
        img_abs = get_app_data_dir() / variant_path
        if img_abs.exists():
            img_abs.unlink()

    def remove_composant(self, nom_complet: str):
        """PATCH (demande utilisateur explicite : "je veux mettre l'onglet
        de corbeille dans la sidebar ... lorsque on supprime une task, un
        composant, un service, un projet ... [ces éléments passent par la
        corbeille]") -- retire la référence de son ServiceAPI et l'entrée
        du modèle (comportement inchangé pour ça), mais ne supprime PLUS
        les images sur disque : elles sont DÉPLACÉES vers un sous-dossier
        dédié de la corbeille (cf. _chemin_corbeille_fichiers), pour
        pouvoir être restaurées à l'identique tant que l'entrée reste dans
        la corbeille (décision utilisateur explicite : "garder aussi les
        images/fichiers liés jusqu'à la suppression définitive"). La
        suppression RÉELLE (fichiers + entrée) n'a lieu que depuis la
        corbeille elle-même (cf. purger_definitivement_corbeille)."""
        composant = self.find_composant(nom_complet)
        if not composant:
            return
        service_api = self.find_service_api(composant.service_api_nom)
        if service_api and nom_complet in service_api.composants:
            service_api.composants.remove(nom_complet)
        fichiers_deplaces = _deplacer_fichiers_vers_corbeille(composant.variantes)
        self.composants.remove(composant)
        self._ajouter_a_corbeille("composant", composant.nom, composant.to_dict(), fichiers_deplaces)

    def remove_composant_layout(self, nom_complet: str):
        """BUGFIX (retour utilisateur : "lorsque je supprime un
        ComposantLayout ça ne va pas dans la corbeille") -- CAUSE RACINE
        CONFIRMÉE : cette méthode supprimait jusqu'ici DIRECTEMENT et
        DÉFINITIVEMENT (ancienne docstring : "décision explicite de
        l'utilisateur ... suppression immédiate confirmée explicitement"),
        contrairement à TOUS les autres remove_* comparables du même
        écran/de la même famille visuelle -- remove_composant (cS, juste
        au-dessus) ET remove_service_api (qui restaure d'ailleurs déjà
        correctement composants_layout dans son "extra", cf. son
        BUG FIX -- preuve que composant_layout est bien censé transiter
        par la corbeille comme le reste). Un ComposantLayout supprimé par
        erreur était donc perdu pour de bon, sans aucun repli, alors que
        chaque autre élément comparable (Composant, ServiceAPI, Task,
        ProjetBatch) atterrit dans la corbeille via _ajouter_a_corbeille.

        CORRECTIF : même patron EXACT que remove_composant -- l'image
        (variante unique d'un ComposantLayout, cf. image_reference) est
        DÉPLACÉE vers la corbeille (pas supprimée) via
        _deplacer_fichiers_vers_corbeille, l'entrée du modèle est
        retirée de self.composants_layout puis ajoutée à self.corbeille
        avec type_element="composant_layout" -- restaurable via
        restaurer_depuis_corbeille (cf. son branch composant_layout,
        symétrique du branch composant) tant qu'elle n'est pas purgée
        manuellement, exactement comme un Composant classique."""
        composant_layout = self.find_composant_layout(nom_complet)
        if not composant_layout:
            return
        service_api = self.find_service_api(composant_layout.service_api_nom)
        if service_api and nom_complet in service_api.composants_layout:
            service_api.composants_layout.remove(nom_complet)
        fichiers_deplaces = _deplacer_fichiers_vers_corbeille(
            [composant_layout.image_reference] if composant_layout.image_reference else []
        )
        self.composants_layout.remove(composant_layout)
        self._ajouter_a_corbeille(
            "composant_layout", composant_layout.nom, composant_layout.to_dict(), fichiers_deplaces
        )

    def _nom_court_disponible_layout(self, service_api_nom: str, base: str) -> str:
        """Symétrique de _nom_court_disponible (cS) ci-dessus, pour
        ComposantLayout."""
        candidat = base
        i = 1
        while self.find_composant_layout(f"{service_api_nom}-{candidat}"):
            i += 1
            candidat = f"{base}{i}"
        return candidat

    def add_composant_layout_avec_nom_auto(self, service_api_nom: str, image: QImage) -> "ComposantLayout":
        """CORRECTIF (trou fonctionnel signalé après relecture de la SPEC :
        aucun site du fichier n'appelait jamais `ComposantLayout(...)` pour
        en CRÉER un -- ComposantLayoutConfigScreen n'était instanciable que
        sur un cL déjà existant, via le bouton "Modifier" du panneau
        flottant).

        CORRECTIF 2 (demande explicite utilisateur : "le bouton d'ajout de
        cL doit etre exactement comme celui de cS, ça doit faire une
        sélection au bureau") : prend maintenant une image DÉJÀ DÉCOUPÉE en
        entrée, MÊME CONTRAT que add_composant (cS) juste au-dessus --
        capture bureau + SelectionZoneOverlay + découpe AVANT l'appel,
        géré par ComposantsLayoutScreen._sur_nouveau (même flux que
        ComposantsScreen._start_capture_composant/_on_zone_selectionnee).
        Écrit l'image sur disque comme image_reference et crée le
        ComposantLayout en un seul appel -- contrairement à la version
        précédente qui créait un cL vide, sans image, l'utilisateur devant
        ensuite cliquer "Capturer une zone" une seconde fois dans l'app de
        config : ce n'est plus nécessaire, mais reste possible (le bouton
        "Capturer une zone" de l'onglet Formes permet de RE-capturer,
        cf. section 5.1)."""
        service_api = self.find_service_api(service_api_nom)
        if not service_api:
            raise ValueError(f"ServiceAPI « {service_api_nom} » introuvable.")
        if image.isNull():
            raise ValueError("L'image capturée est vide.")

        nom_court = self._nom_court_disponible_layout(service_api_nom, "NouveauComposantLayout")
        nom_complet = f"{service_api_nom}-{nom_court}"

        image_path = f"components/{service_api_nom}/{nom_complet}.png"
        chemin_absolu = get_app_data_dir() / image_path
        chemin_absolu.parent.mkdir(parents=True, exist_ok=True)
        if not image.save(str(chemin_absolu), "PNG"):
            raise ValueError(f"Échec de l'écriture de l'image sur disque : {chemin_absolu}")

        composant_layout = ComposantLayout(nom=nom_complet, service_api_nom=service_api_nom, image_reference=image_path)
        self.composants_layout.append(composant_layout)
        service_api.composants_layout.append(nom_complet)
        return composant_layout

    def rename_composant_layout(self, ancien_nom_complet: str, nouveau_nom_court: str) -> "ComposantLayout":
        """Renomme un ComposantLayout (partie courte seulement, le préfixe
        ServiceAPI reste fixe) -- MÊME PATTERN que rename_composant
        ci-dessus (contrôle d'unicité, mise à jour de la référence dans
        le ServiceAPI parent, renommage du fichier sur disque), simplifié
        puisqu'un ComposantLayout n'a qu'une seule image_reference (pas
        de variantes multiples comme Composant).

        CORRECTIF (bug rapporté : "j'ai renommé un cL et ça n'apparaît
        plus") -- ComposantLayoutConfigScreen._sur_nom_composant_layout_
        change faisait auparavant un simple `self.composant_layout.nom =
        ...`, qui change bien composant.nom mais laisse
        service_api.composants_layout (liste de NOMS, cf. sa docstring)
        pointer vers l'ANCIEN nom. La grille (ComposantsLayoutScreen,
        cf. ApplicationsScreen._rafraichir_grille_layout et son usage de
        service_api.composants_layout + find_composant_layout) retrouve
        alors ses éléments via ces noms devenus périmés : find_composant_
        layout(ancien_nom) ne trouve plus rien puisque l'objet porte
        maintenant nouveau_nom -- le composant disparaît de la grille
        (silencieusement filtré par `if c is not None`), bien qu'il
        reste présent et sauvegardé dans self.composants_layout."""
        composant_layout = self.find_composant_layout(ancien_nom_complet)
        if not composant_layout:
            raise ValueError(f"ComposantLayout « {ancien_nom_complet} » introuvable.")

        nouveau_nom_court = nouveau_nom_court.strip()
        if not nouveau_nom_court:
            raise ValueError("Le nom du ComposantLayout ne peut pas être vide.")
        if "-" in nouveau_nom_court:
            raise ValueError("Le nom du ComposantLayout ne peut pas contenir de tiret « - ».")

        service_api_nom = composant_layout.service_api_nom
        nouveau_nom_complet = f"{service_api_nom}-{nouveau_nom_court}"
        if nouveau_nom_complet == ancien_nom_complet:
            return composant_layout  # rien à faire

        if self.find_composant_layout(nouveau_nom_complet):
            raise ValueError(f"Un ComposantLayout nommé « {nouveau_nom_complet} » existe déjà.")

        # Renomme le fichier image_reference sur disque (même correctif
        # de casse Windows/Linux que rename_composant -- cf. sa
        # docstring [DIAG-RENAME] pour la justification détaillée du
        # passage par un nom temporaire quand seule la casse diffère).
        nouveau_image_reference = composant_layout.image_reference
        if composant_layout.image_reference:
            ancien_img_abs = get_app_data_dir() / composant_layout.image_reference
            nouveau_image_reference = f"components/{service_api_nom}/{nouveau_nom_complet}.png"
            nouveau_img_abs = get_app_data_dir() / nouveau_image_reference
            if ancien_img_abs.exists():
                chemins_diff_casse_seulement = (
                    ancien_img_abs != nouveau_img_abs
                    and str(ancien_img_abs).lower() == str(nouveau_img_abs).lower()
                )
                nouveau_img_abs.parent.mkdir(parents=True, exist_ok=True)
                if chemins_diff_casse_seulement:
                    temp_abs = nouveau_img_abs.with_name(f".__renommage_temp__{nouveau_img_abs.name}")
                    ancien_img_abs.rename(temp_abs)
                    temp_abs.rename(nouveau_img_abs)
                elif ancien_img_abs != nouveau_img_abs:
                    ancien_img_abs.rename(nouveau_img_abs)

        service_api = self.find_service_api(service_api_nom)
        if service_api and ancien_nom_complet in service_api.composants_layout:
            idx = service_api.composants_layout.index(ancien_nom_complet)
            service_api.composants_layout[idx] = nouveau_nom_complet

        # AJOUT -- déplace le sous-dossier d'images de test (cf.
        # get_composant_layout_tests_dir : components/<ServiceAPI>/
        # <nom_court>_tests/) pour suivre le nouveau nom, même principe
        # que le renommage de l'image de référence juste au-dessus. Le
        # nom court de départ est extrait de ancien_nom_complet (pas de
        # composant_layout.nom, pas encore réassigné à ce stade) --
        # ancien_nom_complet = f"{service_api_nom}-{ancien_nom_court}".
        ancien_nom_court = ancien_nom_complet.split("-", 1)[1] if "-" in ancien_nom_complet else ancien_nom_complet
        ancien_dossier_tests = get_components_dir(service_api_nom) / f"{ancien_nom_court}_tests"
        if ancien_dossier_tests.exists():
            nouveau_dossier_tests = get_components_dir(service_api_nom) / f"{nouveau_nom_court}_tests"
            if ancien_dossier_tests != nouveau_dossier_tests and not nouveau_dossier_tests.exists():
                ancien_dossier_tests.rename(nouveau_dossier_tests)

        composant_layout.nom = nouveau_nom_complet
        composant_layout.image_reference = nouveau_image_reference

        # GARDE-FOU (bug constaté sur données réelles, cf. docstring de
        # Project.load/_reparer_coherence_composants_layout) : vérifie
        # l'invariant nom/préfixe/référence AVANT de rendre la main,
        # plutôt que de découvrir la désynchronisation bien plus tard au
        # rechargement du projet. Si ça se déclenche un jour, c'est cette
        # méthode-ci qui vient d'introduire une régression -- fail-fast
        # avec un message explicite plutôt que sauvegarder un JSON
        # silencieusement incohérent comme la fois précédente.
        assert composant_layout.nom == nouveau_nom_complet, (
            f"Incohérence interne après renommage : composant_layout.nom="
            f"{composant_layout.nom!r} != nouveau_nom_complet={nouveau_nom_complet!r}"
        )
        assert composant_layout.nom.startswith(f"{service_api_nom}-"), (
            f"Incohérence interne : {composant_layout.nom!r} ne commence pas "
            f"par le préfixe attendu {service_api_nom!r}-"
        )
        if service_api:
            assert nouveau_nom_complet in service_api.composants_layout, (
                f"Incohérence interne : {nouveau_nom_complet!r} absent de "
                f"service_api.composants_layout après renommage : "
                f"{service_api.composants_layout!r}"
            )
            assert ancien_nom_complet not in service_api.composants_layout, (
                f"Incohérence interne : l'ancien nom {ancien_nom_complet!r} "
                f"est encore présent dans service_api.composants_layout après "
                f"renommage : {service_api.composants_layout!r}"
            )

        return composant_layout

    # --- Tasks (TaskConfig) ---
    # --- Libs (fichiers Python purs, section « Lib » de TaskConfig) ---
    def find_lib(self, id_: str):
        return next((l for l in self.libs if l.get("id") == id_), None)

    def verifier_nom_lib(self, nom: str, ignorer_id: Optional[str] = None) -> str:
        """Retourne le nom normalisé (sans « .py ») ou lève ValueError avec un message lisible."""
        nom = (nom or "").strip()
        if nom.lower().endswith(".py"):
            nom = nom[:-3]
        if not nom.isidentifier() or keyword.iskeyword(nom):
            raise ValueError("Le nom doit être un nom de module Python valide (lettres, chiffres, « _ », sans espace ni tiret, ne commence pas par un chiffre).")
        if any(l["nom"] == nom and l["id"] != ignorer_id for l in self.libs):
            raise ValueError(f"Une lib « {nom} » existe déjà.")
        return nom

    def add_lib(self, nom: str, code: str = "") -> dict:
        lib = {"id": uuid.uuid4().hex, "nom": self.verifier_nom_lib(nom), "code": code,
               "modifie_le": datetime.now(timezone.utc).isoformat(timespec="seconds")}
        self.libs.append(lib)
        _rafraichir_registre_libs(self)
        return lib

    def remove_lib(self, id_: str):
        lib = self.find_lib(id_)
        if lib:
            self.libs.remove(lib)
            _rafraichir_registre_libs(self)

    def add_task(self, nom: str = "Nouveau Task") -> Task:
        """Crée un nouveau Task vide (aucun ServiceAPI importé, script
        vide) et l'ajoute au Project."""
        task = Task(nom=nom)
        self.tasks.append(task)
        return task

    def remove_task(self, id_: str):
        """PATCH (demande utilisateur explicite : corbeille) -- déplace
        l'entrée vers la corbeille au lieu de la supprimer définitivement.
        Aucun fichier sur disque associé à un Task (script/imports vivent
        entièrement dans project.json, cf. to_dict) -- seule la donnée
        structurée est concernée ici, pas de fichiers à déplacer."""
        task = self.find_task(id_)
        if task:
            self.tasks.remove(task)
            self._ajouter_a_corbeille("task", task.nom, task.to_dict(), fichiers=[])

    def composants_importes_task(self, task: Task) -> dict:
        """Retourne les Composants réellement importés dans ce Task,
        GROUPÉS PAR ServiceAPI (décision explicite utilisateur : ne pas
        mélanger les composants de différents ServiceAPI à l'affichage) :
        {nom_service_api: [Composant, ...], ...}, recalculé à chaque appel
        depuis self.composants (donc toujours à jour si des composants ont
        été ajoutés/supprimés côté ServiceAPI depuis l'import initial dans
        ce Task -- cf. Task.services_api_importes). L'ordre des clés suit
        l'ordre de task.services_api_importes ; l'ordre des composants dans
        chaque liste suit celui de ServiceAPI.composants quand ce
        ServiceAPI existe encore, sinon l'ordre d'apparition dans
        self.composants (ServiceAPI supprimé du Project depuis l'import,
        cas limite géré sans perdre les composants déjà là)."""
        resultat: dict = {}
        for nom_service in task.services_api_importes:
            service_api = self.find_service_api(nom_service)
            if service_api:
                noms_ordonnes = list(service_api.composants)
                composants = [self.find_composant(n) for n in noms_ordonnes]
                composants = [c for c in composants if c is not None]
            else:
                composants = [c for c in self.composants if c.service_api_nom == nom_service]
            resultat[nom_service] = composants
        return resultat

    def composants_layout_importes_task(self, task: Task) -> dict:
        """AJOUT (cL, SPEC_composantLayout.md section 6) : symétrique de
        composants_importes_task ci-dessus, pour les ComposantLayout.
        {nom_service_api: [ComposantLayout, ...], ...}, recalculé à chaque
        appel depuis self.composants_layout via ServiceAPI.composants_layout
        (liste de NOMS, cf. sa docstring) -- même fallback (ServiceAPI
        supprimé du Project depuis l'import) que la version cS : CORRECTIF,
        ComposantLayout a bien un champ service_api_nom (section 3.3,
        contrairement à ce qu'affirmait un commentaire précédent ici) --
        même fallback par balayage de self.composants_layout que la
        version cS ci-dessus, plutôt que la liste vide utilisée
        auparavant par erreur."""
        resultat: dict = {}
        for nom_service in task.services_api_importes:
            service_api = self.find_service_api(nom_service)
            if service_api:
                noms_ordonnes = list(service_api.composants_layout)
                composants = [self.find_composant_layout(n) for n in noms_ordonnes]
                composants = [c for c in composants if c is not None]
            else:
                composants = [c for c in self.composants_layout if c.service_api_nom == nom_service]
            resultat[nom_service] = composants
        return resultat

    # --- Projets Batch (cf. PATCH_projet_batch.md) ---
    def find_projet_batch(self, id_: str) -> Optional[ProjetBatch]:
        return next((p for p in self.projets_batch if p.id == id_), None)

    def add_projet_batch(self, nom: str = "Nouveau Projet Batch") -> ProjetBatch:
        """Crée un nouveau ProjetBatch vide (aucun Task choisi, aucun
        mapping) et l'ajoute au Project -- même logique que add_task."""
        projet = ProjetBatch(nom=nom)
        self.projets_batch.append(projet)
        return projet

    def remove_projet_batch(self, id_: str):
        """PATCH (demande utilisateur explicite : corbeille) -- déplace
        l'entrée vers la corbeille au lieu de la supprimer définitivement.
        Cette suppression n'a JAMAIS touché aux fichiers sur disque (cf.
        l'ancien message de confirmation, retiré par ce même patch :
        "Cette action ne supprime AUCUN fichier sur disque [...] seule la
        configuration du Projet Batch est retirée") -- rien à déplacer ici
        non plus, seule la donnée structurée va en corbeille."""
        projet = self.find_projet_batch(id_)
        if projet:
            self.projets_batch.remove(projet)
            self._ajouter_a_corbeille("projet_batch", projet.nom, projet.to_dict(), fichiers=[])

    # --- Corbeille (demande utilisateur explicite : "je veux mettre
    # l'onglet de corbeille dans la sidebar ... lorsque on supprime une
    # task, un composant, un service, un projet ... [ces éléments passent
    # par la corbeille]") ---
    #
    # Chaque entrée de self.corbeille est un dict générique :
    #   {"id_corbeille": str, "type": "task"|"composant"|"service_api"|
    #    "projet_batch", "nom_repere": str, "supprime_le": timestamp ISO,
    #    "donnees": <to_dict() de l'élément original>,
    #    "fichiers": [chemins relatifs à get_app_data_dir() des fichiers/
    #                 dossiers déplacés vers _chemin_corbeille_fichiers(),
    #                 vide si l'élément n'a aucun fichier associé (Task,
    #                 ProjetBatch)],
    #    "extra": dict optionnel, réservé aux données annexes qu'un type
    #             précis doit conserver pour une restauration complète
    #             (ex: "composants" pour un service_api -- ses Composants
    #             enfants, eux-mêmes retirés de self.composants au moment
    #             de la suppression, doivent être recréés EN MÊME TEMPS
    #             que le ServiceAPI restauré, sinon ce dernier réapparaît
    #             vide)}.
    #
    # PAS de purge automatique (décision utilisateur explicite : "non" à
    # la purge après un délai) -- une entrée reste en corbeille jusqu'à
    # une action MANUELLE (restaurer ou supprimer définitivement, cf.
    # CorbeilleScreen), indéfiniment sinon.
    def _ajouter_a_corbeille(self, type_element: str, nom_repere: str, donnees: dict,
                              fichiers: list, extra: Optional[dict] = None):
        """Construit et ajoute une entrée de corbeille -- helper commun
        aux 4 remove_* ci-dessus, pour ne pas dupliquer la construction du
        dict 4 fois. `fichiers` : chemins relatifs déjà déplacés par
        l'appelant (cf. _deplacer_fichiers_vers_corbeille/
        _deplacer_dossier_vers_corbeille) -- cette méthode n'effectue
        elle-même AUCUNE opération disque, uniquement la construction de
        l'entrée en mémoire."""
        entree = {
            "id_corbeille": _new_id(),
            "type": type_element,
            "nom_repere": nom_repere,
            "supprime_le": datetime.now().isoformat(timespec="seconds"),
            "donnees": donnees,
            "fichiers": list(fichiers),
        }
        if extra:
            entree["extra"] = extra
        self.corbeille.append(entree)

    def find_entree_corbeille(self, id_corbeille: str) -> Optional[dict]:
        return next((e for e in self.corbeille if e.get("id_corbeille") == id_corbeille), None)

    def restaurer_depuis_corbeille(self, id_corbeille: str) -> bool:
        """Reconstruit l'élément original depuis son entrée de corbeille
        et le réinjecte dans la bonne liste du Project (cf. from_dict de
        chaque dataclass -- réutilisé tel quel, une entrée de corbeille
        contient exactement la même forme de dict qu'un project.json),
        déplace ses fichiers (s'il y en a) de la corbeille vers leur
        emplacement d'origine, puis retire l'entrée de self.corbeille.

        Ne recrée PAS le ServiceAPI parent d'un Composant restauré s'il a
        depuis été supprimé lui-même (cas limite rare, cohérent avec le
        comportement historique de add_composant : un Composant peut
        exister en mémoire avec un service_api_nom qui ne correspond plus
        à aucun ServiceAPI réel, cf. composants_importes_task qui gère
        déjà ce cas).

        Retourne False si l'entrée n'existe pas ou si un élément du MÊME
        NOM a été recréé entre-temps (conflit -- restauration refusée
        plutôt que d'écraser silencieusement autre chose, l'utilisateur
        garde alors le choix de renommer l'un des deux avant de
        réessayer)."""
        entree = self.find_entree_corbeille(id_corbeille)
        if entree is None:
            return False
        type_element = entree["type"]
        donnees = entree["donnees"]

        if type_element == "task":
            if self.find_task(donnees.get("id", "")) is not None:
                return False
            self.tasks.append(Task.from_dict(donnees))
        elif type_element == "projet_batch":
            if self.find_projet_batch(donnees.get("id", "")) is not None:
                return False
            self.projets_batch.append(ProjetBatch.from_dict(donnees))
        elif type_element == "composant":
            if self.find_composant(donnees.get("nom", "")) is not None:
                return False
            composant = Composant.from_dict(donnees)
            self.composants.append(composant)
            service_api = self.find_service_api(composant.service_api_nom)
            if service_api and composant.nom not in service_api.composants:
                service_api.composants.append(composant.nom)
            _restaurer_fichiers_depuis_corbeille(entree["fichiers"])
        elif type_element == "composant_layout":
            # BUGFIX (cf. docstring de Project.remove_composant_layout
            # pour la cause racine complète) -- branch symétrique du
            # branch "composant" juste au-dessus : même contrat exact
            # (refus si un ComposantLayout du même nom a été recréé
            # entre-temps, réattachement à son ServiceAPI d'origine s'il
            # existe toujours, restauration de l'unique fichier image
            # déplacé par _deplacer_fichiers_vers_corbeille lors de la
            # suppression). _restaurer_fichiers_depuis_corbeille retrouve
            # seul le bon dossier components/<ServiceAPI>/ cible à partir
            # du nom de fichier (préfixe NomServiceAPI- avant le premier
            # "-", cf. sa docstring) -- même format de nommage qu'un
            # Composant classique (add_composant_layout_avec_nom_auto
            # écrit "components/<service_api_nom>/<nom_complet>.png"),
            # donc aucune adaptation nécessaire de ce côté.
            if self.find_composant_layout(donnees.get("nom", "")) is not None:
                return False
            composant_layout = ComposantLayout.from_dict(donnees)
            self.composants_layout.append(composant_layout)
            service_api = self.find_service_api(composant_layout.service_api_nom)
            if service_api and composant_layout.nom not in service_api.composants_layout:
                service_api.composants_layout.append(composant_layout.nom)
            _restaurer_fichiers_depuis_corbeille(entree["fichiers"])
        elif type_element == "service_api":
            if self.find_service_api(donnees.get("nom", "")) is not None:
                return False
            self.services_api.append(ServiceAPI.from_dict(donnees))
            for comp_dict in entree.get("extra", {}).get("composants", []):
                if self.find_composant(comp_dict.get("nom", "")) is None:
                    self.composants.append(Composant.from_dict(comp_dict))
            # BUG FIX (symétrique de remove_service_api ci-dessus) :
            # restaure aussi les ComposantLayout sauvegardés dans
            # extra["composants_layout"]. Sans ce bloc, un ServiceAPI
            # restauré depuis la corbeille revenait avec ses Composant
            # mais SANS ses ComposantLayout (dans self.composants_layout,
            # liste séparée), qui restaient perdus même après restauration
            # -- alors que le dict était bien conservé (une fois le patch
            # de remove_service_api ci-dessus appliqué) et que les images
            # elles-mêmes revenaient physiquement via _restaurer_fichiers_
            # depuis_corbeille juste en dessous (tout le dossier
            # components/<nom> est restauré en bloc).
            for cl_dict in entree.get("extra", {}).get("composants_layout", []):
                if self.find_composant_layout(cl_dict.get("nom", "")) is None:
                    self.composants_layout.append(ComposantLayout.from_dict(cl_dict))
            _restaurer_fichiers_depuis_corbeille(entree["fichiers"])
        else:
            return False

        self.corbeille.remove(entree)
        return True

    def purger_definitivement_corbeille(self, id_corbeille: str) -> bool:
        """Supprime pour de bon une entrée de corbeille : ses fichiers
        (s'il y en a) ET l'entrée elle-même. AUCUN repli possible après
        cet appel -- c'est CETTE action, et uniquement celle-ci parmi
        toutes les suppressions de ce fichier, qui doit encore demander
        confirmation à l'utilisateur (décision explicite : "enlève tous
        les messages de confirmation de suppression sauf pour la
        corbeille"), cf. CorbeilleScreen._confirmer_suppression_definitive."""
        entree = self.find_entree_corbeille(id_corbeille)
        if entree is None:
            return False
        for chemin_relatif in entree.get("fichiers", []):
            cible = get_app_data_dir() / chemin_relatif
            if cible.is_dir():
                shutil.rmtree(cible, ignore_errors=True)
            elif cible.exists():
                cible.unlink()
        self.corbeille.remove(entree)
        return True

    def vider_corbeille(self):
        """Purge TOUTES les entrées d'un coup -- bouton "Vider la
        corbeille" de CorbeilleScreen (même confirmation obligatoire que
        purger_definitivement_corbeille, une seule fois pour tout le
        lot)."""
        for entree in list(self.corbeille):
            self.purger_definitivement_corbeille(entree["id_corbeille"])


# ---------------------------------------------------------------------------
# Import d'un ServiceAPI complet depuis un pack .autoniaxservice (PATCH
# demandé par l'utilisateur : "importer un service api deja creer avec
# tout les composant" -- distinct de add_service_api_avec_nom_auto, qui crée
# un ServiceAPI VIDE à remplir ensuite manuellement dans l'éditeur).
#
# Format du pack (zip, cf. EXTENSION_FICHIER_SERVICE_API) :
#   manifest.json           -- {"service_api": {...}, "composants": [{...}, ...]}
#                               mêmes structures que ServiceAPI.to_dict() /
#                               Composant.to_dict(), donc réutilisables
#                               telles quelles via from_dict.
#   components/<...>.png    -- une entrée par chemin apparaissant dans les
#                               variantes d'un Composant du manifest --
#                               chemins RELATIFS à get_app_data_dir(), donc
#                               déjà au bon format pour être recopiés tels
#                               quels sous get_components_dir(nouveau_nom).
#
# Le ServiceAPI et ses Composants sont RENOMMÉS à l'import si un ServiceAPI
# du même nom existe déjà dans ce Project (jamais d'écrasement silencieux
# d'un ServiceAPI existant -- même prudence que _demande_import_task côté
# TaskConfigScreen pour les Tasks).
# ---------------------------------------------------------------------------

def exporter_service_api_vers_zip(project: "Project", service_api_nom: str, chemin_zip) -> None:
    """Écrit un pack .autoniaxservice pour le ServiceAPI `service_api_nom`
    (et tous ses Composants/variantes) à `chemin_zip`. Contrepartie
    d'importer_service_api_depuis_zip -- pas de bouton dédié dans l'UI pour
    l'instant (export utilisé ici pour PRODUIRE des packs, ex: le pack de
    démonstration "PageTest"), mais rien n'empêche de la brancher plus tard
    sur un bouton, sur le modèle de _demande_export_task.

    Lève ValueError si le ServiceAPI n'existe pas."""
    service_api = project.find_service_api(service_api_nom)
    if not service_api:
        raise ValueError(f"ServiceAPI « {service_api_nom} » introuvable.")

    composants_data = []
    chemins_images: list[str] = []
    for comp_nom in service_api.composants:
        comp = project.find_composant(comp_nom)
        if not comp:
            continue
        composants_data.append(comp.to_dict())
        chemins_images.extend(comp.variantes)

    manifest = {
        "format": 1,
        "service_api": service_api.to_dict(),
        "composants": composants_data,
    }

    with zipfile.ZipFile(chemin_zip, "w", zipfile.ZIP_DEFLATED) as zf:
        zf.writestr("manifest.json", json.dumps(manifest, ensure_ascii=False, indent=2))
        base = get_app_data_dir()
        for chemin_relatif in chemins_images:
            chemin_abs = base / chemin_relatif
            if chemin_abs.exists():
                zf.write(chemin_abs, arcname=chemin_relatif)


def importer_service_api_depuis_zip(project: "Project", chemin_zip) -> tuple["ServiceAPI", list[str]]:
    """Lit un pack .autoniaxservice et ajoute le ServiceAPI (+ tous ses
    Composants + leurs images) reconstruit au Project courant. Retourne
    (service_api_ajouté, avertissements) -- avertissements : liste de
    messages non bloquants (ex: image manquante dans le zip pour une
    variante listée dans le manifest), sur le même principe que
    importer_task_depuis_json.

    Lève ValueError si le zip est invalide/corrompu ou si le manifest est
    illisible -- toujours capturé par l'appelant UI (cf. _demande_import_
    service_api côté ServiceAPIScreen) pour l'afficher proprement plutôt
    que de remonter une trace brute à l'utilisateur."""
    try:
        zf = zipfile.ZipFile(chemin_zip, "r")
    except (zipfile.BadZipFile, OSError) as e:
        raise ValueError(f"Fichier .autoniaxservice invalide ou corrompu : {e}")

    with zf:
        try:
            manifest = json.loads(zf.read("manifest.json").decode("utf-8"))
        except KeyError:
            raise ValueError("Pack invalide : manifest.json absent du fichier.")
        except (json.JSONDecodeError, UnicodeDecodeError) as e:
            raise ValueError(f"Pack invalide : manifest.json illisible ({e}).")

        try:
            service_api_importe = ServiceAPI.from_dict(manifest["service_api"])
            composants_importes = [Composant.from_dict(c) for c in manifest.get("composants", [])]
        except (KeyError, TypeError) as e:
            raise ValueError(f"Pack invalide : structure du manifest inattendue ({e}).")

        avertissements: list[str] = []

        # --- Anti-collision du nom de ServiceAPI (jamais d'écrasement
        # silencieux d'un ServiceAPI déjà présent dans ce Project, même
        # logique de suffixe que _demande_import_task pour les Tasks). ---
        nom_original = service_api_importe.nom
        nom_final = nom_original
        if project.find_service_api(nom_final):
            i = 1
            candidat = f"{nom_original} (importé)"
            while project.find_service_api(candidat):
                i += 1
                candidat = f"{nom_original} (importé {i})"
            nom_final = candidat
            avertissements.append(
                f"Un ServiceAPI « {nom_original} » existait déjà -- importé sous « {nom_final} »."
            )

        dossier_dest = get_components_dir(nom_final)  # crée components/<nom_final>/ si absent

        composants_finaux = []
        noms_composants_finaux = []
        for comp in composants_importes:
            # Nom complet reconstruit sous le NOUVEAU préfixe de ServiceAPI
            # (cf. rename_service_api : même logique de préfixe "Nom-").
            suffixe = comp.nom[len(nom_original) + 1:] if comp.nom.startswith(nom_original + "-") else comp.nom
            nouveau_nom_complet = f"{nom_final}-{suffixe}"
            if project.find_composant(nouveau_nom_complet):
                avertissements.append(
                    f"Composant « {nouveau_nom_complet} » ignoré (nom déjà utilisé dans ce Project)."
                )
                continue

            nouvelles_variantes = []
            for ancienne_variante in comp.variantes:
                # PATCH (SPEC_GLOBALE_AutoniaX.md, Partie A §4.4) --
                # ancienne_variante vient de comp.variantes, déjà désérialisé
                # par Composant.from_dict (cf. §2.3) : c'est donc déjà une
                # VRAIE Variante avec ses réglages par-variante d'origine
                # (seuil_confiance, flou_noyau, etc. du composant exporté),
                # pas seulement un chemin. str(...) via l'héritage str
                # donne le chemin dans le zip pour zf.read(), sans rien
                # changer à la logique d'extraction ci-dessous.
                variant_path = str(ancienne_variante)
                nom_fichier = Path(variant_path).name
                chemin_dest_relatif = f"components/{nom_final}/{nom_fichier}"
                chemin_dest_abs = get_app_data_dir() / chemin_dest_relatif
                try:
                    donnees_image = zf.read(variant_path)
                except KeyError:
                    avertissements.append(
                        f"Image manquante dans le pack pour « {nouveau_nom_complet} » : {variant_path} (variante ignorée)."
                    )
                    continue
                # Anti-collision de fichier sur disque (ex: pack déjà
                # importé une première fois puis re-importé) -- suffixe
                # plutôt qu'écrasement, même principe que rename_service_api.
                if chemin_dest_abs.exists():
                    i = 2
                    stem, ext = Path(nom_fichier).stem, Path(nom_fichier).suffix
                    while chemin_dest_abs.exists():
                        chemin_dest_relatif = f"components/{nom_final}/{stem}_{i}{ext}"
                        chemin_dest_abs = get_app_data_dir() / chemin_dest_relatif
                        i += 1
                chemin_dest_abs.parent.mkdir(parents=True, exist_ok=True)
                chemin_dest_abs.write_bytes(donnees_image)
                # PATCH (§4.4) -- avec_chemin() préserve TOUS les réglages
                # par-variante importés du pack ; sans ça, le composant
                # importé perdrait silencieusement ses réglages personnalisés
                # au profit des défauts de la classe Variante, dès le
                # premier import.
                nouvelles_variantes.append(
                    ancienne_variante.avec_chemin(chemin_dest_relatif)
                    if isinstance(ancienne_variante, Variante)
                    else Variante(chemin=chemin_dest_relatif)
                )

            comp.nom = nouveau_nom_complet
            comp.service_api_nom = nom_final
            comp.variantes = nouvelles_variantes
            composants_finaux.append(comp)
            noms_composants_finaux.append(nouveau_nom_complet)

        service_api_importe.nom = nom_final
        service_api_importe.composants = noms_composants_finaux

        project.services_api.append(service_api_importe)
        project.composants.extend(composants_finaux)

        return service_api_importe, avertissements


