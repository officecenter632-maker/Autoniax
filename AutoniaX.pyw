        self._corps_infos_profil.setVisible(not self._profil_infos_pliee)
        icone = "mdi6.chevron-right" if self._profil_infos_pliee else "mdi6.chevron-down"
        self._chevron_infos_profil.setPixmap(qta.icon(icone, color=Mocha.subtext0).pixmap(16, 16))

    def definir_infos_profil(self, nom_profil: Optional[str], proxy: Optional[dict], pays: Optional[str]):
        """Met à jour les 3 lignes de la section pliable "Profil" --
        appelée par FenetreRenduTaskReseau à chaque (ré)ouverture du
        panneau et à chaque changement de sAutoniax ciblé (cf.
