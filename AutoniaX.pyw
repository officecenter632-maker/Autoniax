    def _rafraichir_raccourci_toujours_arriere_plan(self):
        """(Re)synchronise le QKeySequence du QShortcut
        "toujours_arriere_plan_toggle" -- même patron EXACT que
        _rafraichir_raccourci_redemarrer_application juste au-dessus
        (combo vide/invalide désactive le raccourci plutôt que de
        lever).

        PATCH : resynchronise ENSUITE le listener pynput global
        (_demarrer_hotkey_globale_arriere_plan) sur ce même combo --
        appelée non seulement à la construction mais aussi à chaque
        modification réelle du raccourci depuis l'onglet Raccourcis
        (cf. connexion à raccourcis_app_changes dans __init__), pour
        que la personnalisation de la touche par l'utilisateur
        s'applique aussi au raccourci global, pas seulement au
        QShortcut interne."""
        combo = charger_raccourcis_app().get("toujours_arriere_plan_toggle", {}).get("combo", "")
        try:
            ks = QKeySequence(combo) if combo else QKeySequence()
        except Exception:
            ks = QKeySequence()
        self._raccourci_toujours_arriere_plan.setKey(ks)
        self._raccourci_toujours_arriere_plan.setEnabled(not ks.isEmpty())
        # Le listener global n'existe qu'à partir de la fin de __init__
        # (cf. self._hotkey_globale_arriere_plan posé à None juste avant
        # le premier appel à _demarrer_hotkey_globale_arriere_plan) --
        # cette méthode est aussi appelée une première fois AVANT cette
        # initialisation (self._rafraichir_raccourci_toujours_arriere_plan()
        # dans __init__, juste avant la mise en place du listener), d'où
        # ce hasattr défensif plutôt qu'un attribut supposé déjà présent.
        if hasattr(self, "_hotkey_globale_arriere_plan"):
            self._demarrer_hotkey_globale_arriere_plan()

    def _demarrer_hotkey_globale_arriere_plan(self):
        """PATCH (demande explicite utilisateur : "le raccourci ne
        fonctionne pas quand la fenêtre est réduite ... utilise pynput,
        regarde comment les raccourcis globaux sont gérés dans
        [IngeniaXExplorer] et implémente juste pour ce raccourci-là") --
        démarre (ou redémarre, si déjà actif) un listener pynput.keyboard
        GLOBAL dédié exclusivement au combo actuellement configuré pour
        "toujours_arriere_plan_toggle". Contrairement au QShortcut Qt
        (Qt.ApplicationShortcut, cf. plus haut), ce listener tourne dans
        son propre thread OS et reçoit l'appui clavier MÊME QUAND
        AutoniaX n'a plus le focus natif -- notamment une fois la
        fenêtre minimisée par ce même raccourci, cas qui bloquait
        totalement le retour en mode normal avec le seul QShortcut.

        Le combo est lu depuis charger_raccourcis_app() (même source que
        _rafraichir_raccourci_toujours_arriere_plan) et converti au
        format pynput via _normaliser_combo_vers_pynput. Combo vide/
        invalide/pynput indisponible -> aucun listener global démarré,
        le QShortcut Qt reste seul actif (dégradation silencieuse,
        cohérente avec le comportement "combo vide désactive le
        raccourci" du reste du fichier) -- aucune levée d'exception.

        Un listener déjà actif est toujours arrêté avant d'en recréer un
        nouveau (pynput.GlobalHotKeys ne permet pas de changer le combo
        d'un listener déjà démarré), pour rester synchronisé après
        chaque modification du raccourci depuis l'onglet Raccourcis."""
        # Arrêt de l'éventuel listener précédent (changement de combo,
        # ou double appel défensif) -- jamais deux listeners actifs en
        # même temps pour ce raccourci.
        ancien = getattr(self, "_hotkey_globale_arriere_plan", None)
        if ancien is not None:
            try:
                ancien.stop()
            except Exception:
                pass
            self._hotkey_globale_arriere_plan = None

        if not _PYNPUT_ARRIERE_PLAN_DISPONIBLE:
            return

        combo = charger_raccourcis_app().get("toujours_arriere_plan_toggle", {}).get("combo", "")
        combo_pynput = _normaliser_combo_vers_pynput(combo)
        if not combo_pynput:
            return

        # IMPORTANT : quand la fenêtre a le focus natif, le QShortcut Qt
        # (Qt.ApplicationShortcut, toujours actif en parallèle) reçoit
        # LUI AUSSI cet appui clavier -- sans garde, les deux chemins
        # déclencheraient _sur_raccourci_toujours_arriere_plan_toggle
        # pour un seul appui, ce qui annulerait la bascule (double
        # inversion de la valeur). Cette garde limite donc le listener
        # global au SEUL cas où il est réellement nécessaire, la fenêtre
        # étant minimisée (donc sans focus, le QShortcut Qt ne recevant
        # alors jamais l'événement) -- fenêtre non minimisée : on ignore
        # l'appui ici, le QShortcut Qt s'en charge seul comme avant.
        def _callback_filtre_minimisee():
            if self.isMinimized():
                self._sur_raccourci_toujours_arriere_plan_toggle()

        # Le pont Qt (QObject + Signal) doit être recréé avec le
        # listener : un seul callback est concerné, pas besoin de le
        # garder au-delà de la durée de vie du listener courant.
        pont = _PontRaccourciGlobalArrierePlan(_callback_filtre_minimisee)
        self._pont_hotkey_globale_arriere_plan = pont

        try:
            listener = _pynput_kb_arriere_plan.GlobalHotKeys({
                combo_pynput: pont.depuis_thread_pynput,
            })
            listener.daemon = True
            listener.start()
            self._hotkey_globale_arriere_plan = listener
        except Exception:
            log.exception(
                "Échec du démarrage du raccourci clavier global "
                "\u00ab toujours_arriere_plan_toggle \u00bb (pynput) -- "
                "le raccourci restera fonctionnel via QShortcut tant que "
                "la fenêtre n'est pas réduite."
            )
            self._hotkey_globale_arriere_plan = None

    def _sur_raccourci_toujours_arriere_plan_toggle(self):
        """Handler du QShortcut "toujours_arriere_plan_toggle" -- bascule
        ReglagesApp.toujours_arriere_plan (inverse sa valeur actuelle),
        persiste, puis applique EN DIRECT sur cette fenêtre soit une
        réduction (showMinimized()) soit une restauration au premier
        plan ponctuelle (flash WindowStaysOnTopHint, non permanent),
        selon la nouvelle valeur -- cf. docstring de _appliquer_toujours_
        arriere_plan pour le détail complet du nouveau comportement.
        Resynchronise ensuite le toggle de l'onglet Général de
        ParametresScreen (s'il est déjà construit) pour qu'il reflète le
        nouvel état sans attendre une réouverture de l'écran Paramètres
        -- même esprit que les autres handlers de raccourci "Application"
        qui répliquent l'effet exact du contrôle UI correspondant."""
        nouvelle_valeur = not self.reglages.toujours_arriere_plan
        self.reglages.toujours_arriere_plan = nouvelle_valeur
        self.reglages.save()
        self._appliquer_toujours_arriere_plan(nouvelle_valeur)
        parametres_screen = self.screens.get("parametres")
        if parametres_screen is not None and hasattr(parametres_screen, "case_toujours_arriere_plan"):
            case = parametres_screen.case_toujours_arriere_plan
            case.blockSignals(True)
            case.setChecked(nouvelle_valeur)
            case.blockSignals(False)

    def _appliquer_toujours_arriere_plan(self, actif: bool):
        """PATCH (demande explicite utilisateur : "je veux que tu modifie
        le comportement du raccourci qui permet de faire a ce que la
        fenetre passe en arriere plan et devient normal, desormais sa
        dois se reduire, et lorsque je reviens en mode normal sa doit
        dabord apraitre en top most et etre directement mis en normal,
        parceque je veux que sa apparait directement au dessus de toutes
        les fenetres, mais pas de facon permanente") -- REMPLACE
        l'ancien comportement (Qt.WindowType.WindowStaysOnBottomHint,
        qui maintenait la fenêtre derrière toutes les autres de façon
        permanente) par un cycle minimiser/restaurer.

        PATCH ULTÉRIEUR (demande explicite utilisateur : "maintenant je
        veux que on puisse parametrer si sa doit se reduire ou juste
        rester en bottom most, visible mais en dessous de toutes les
        fenetres de l'ecran") -- le "quoi" (actif) ne change pas de
        sens, mais le "comment" quand actif=True se choisit désormais
        via self.reglages.mode_arriere_plan :

        - mode "reduire" (défaut, comportement historique inchangé) :
          la fenêtre est simplement RÉDUITE (minimisée, showMinimized())
          -- elle disparaît de l'écran comme n'importe quelle fenêtre
          minimisée, sans flag de calque particulier.
        - mode "bottom" (nouveau) : la fenêtre RESTE VISIBLE à l'écran,
          à sa position/taille courantes, mais posée derrière TOUTES
          les autres fenêtres (Qt.WindowStaysOnBottomHint) -- et ce
          flag est cette fois MAINTENU tant que le mode reste actif
          (contrairement au flash ponctuel de WindowStaysOnTopHint
          utilisé à la restauration ci-dessous), pour qu'elle ne puisse
          jamais remonter seule au premier plan par-dessus une autre
          fenêtre qu'on vient de cliquer.

        Dans les deux cas, actif=False restaure la fenêtre au premier
        plan de façon PONCTUELLE (pas permanente) : on pose brièvement
        WindowStaysOnTopHint pour qu'elle s'affiche bien AU-DESSUS de
        toutes les fenêtres actuellement ouvertes (même une fenêtre qui
        était déjà "always on top"), puis on retire immédiatement ce
        flag (ainsi que WindowStaysOnBottomHint, si le mode "bottom"
        l'avait laissé posé) pour revenir à un comportement de fenêtre
        normal -- sans quoi elle resterait indéfiniment au-dessus (ou
        en dessous) des autres, ce qui n'est pas l'effet recherché
        ("pas de façon permanente").

        setWindowFlags() sous Qt force une re-création du handle natif
        de la fenêtre, ce qui la cache implicitement -- un show() après
        coup est donc indispensable pour la rendre visible à nouveau
        (même contrainte que tout appel à setWindowFlags sur une fenêtre
        déjà affichée, cf. doc Qt).

        PATCH (raccourci global pynput) : cette méthode peut désormais
        être déclenchée alors que la fenêtre n'a AUCUN focus natif --
        callback pynput reçu alors que la fenêtre est minimisée et
        qu'AutoniaX n'est pas l'application active. Sous Windows, l'OS
        bloque SetForegroundWindow()/le passage au premier plan pour un
        processus qui ne "possède" pas déjà le focus, ce que
        self.raise_()/self.activateWindow() seuls ne débloquent PAS dans
        ce contexte précis -- d'où l'appel à _forcer_premier_plan_windows
        (même hack que IngeniaXExplorer._force_foreground : ShowWindow
        SW_RESTORE + simulation Alt + SetForegroundWindow) AVANT le
        cycle Qt show()/raise_()/activateWindow() ci-dessous. Sans effet
        (no-op) sur toute plateforme non-Windows."""
        mode = getattr(self.reglages, "mode_arriere_plan", "reduire")
        if mode not in ("reduire", "bottom"):
            mode = "reduire"

        if actif:
            if mode == "bottom":
                # Mode "bottom most" : la fenêtre reste ENTIÈREMENT
                # visible (pas de showMinimized()), simplement reléguée
                # derrière toutes les autres fenêtres de l'écran. Le
                # flag est maintenu -- contrairement au flash TopHint de
                # la restauration plus bas -- donc setWindowFlags() n'est
                # appelé qu'une fois ici (pas de retrait immédiat).
                drapeaux_actuels = self.windowFlags()
                self.setWindowFlags(drapeaux_actuels | Qt.WindowType.WindowStaysOnBottomHint)
                # Même BUGFIX icône que dans la branche restauration plus
                # bas : setWindowFlags() recrée le handle natif (HWND) et
                # fait perdre l'icône de la barre des tâches sous Windows
                # tant qu'elle n'est pas réappliquée explicitement.
                self.setWindowIcon(QIcon(_generate_icon_pixmap_autoniax(256)))
                self.show()
                return

            # Mode "reduire" (défaut) : équivalent au clic sur
            # "Minimiser" dans la barre de titre (cf. AutoniaXTitleBar).
            # L'état maximisé/position sous-jacent est conservé par Qt
            # et sera restauré tel quel au prochain
            # showNormal()/showMinimized(False).
            self.showMinimized()
            return

        # Restauration : si la fenêtre était réduite, on la sort d'abord
        # de l'état minimisé au niveau NATIF (nécessaire quand ce
        # callback vient du thread pynput, sans focus -- Qt seul ne
        # suffit pas toujours ici sous Windows), puis on retire
        # uniquement le bit WindowMinimized de windowState() -- SANS
        # passer par showNormal(), qui écraserait un état maximisé en le
        # forçant en taille "normale" (cf. commentaire de MainWindow.
        # __init__ : la fenêtre démarre maximisée et cet état doit
        # survivre aux cycles show/hide de ce toggle). Qt.WindowMaximized
        # (s'il était déjà posé) reste intact.
        etait_minimisee = self.isMinimized()

        # Mode "bottom" : la fenêtre n'a jamais été minimisée (elle est
        # restée visible en arrière-plan), donc etait_minimisee est
        # toujours False ici -- mais WindowStaysOnBottomHint peut être
        # posé et doit être détecté pour ne pas retomber, plus bas, dans
        # le court-circuit "rien à restaurer" prévu pour le tout premier
        # démarrage (cf. BUGFIX ci-dessous).
        etait_en_bottom = bool(self.windowFlags() & Qt.WindowType.WindowStaysOnBottomHint)

        # BUGFIX (régression signalée : "la fenêtre a cessé de démarrer
        # toujours en taille max") -- CAUSE : cette méthode est aussi
        # appelée depuis MainWindow.__init__ (self._appliquer_toujours_
        # arriere_plan(self.reglages.toujours_arriere_plan), tout à la
        # fin du constructeur) AVANT le tout premier show() de la
        # fenêtre. Avec actif=False (valeur par défaut), le code
        # ci-dessous jouait alors le cycle setWindowFlags(|TopHint) ->
        # show() -> setWindowFlags(sans TopHint) -> show() dès ce tout
        # premier affichage -- DEUX appels setWindowFlags() avant même
        # que le widget natif existe, ce qui pouvait faire perdre le
        # Qt.WindowState.WindowMaximized posé juste avant dans __init__
        # (cf. self.setWindowState(... | WindowMaximized) plus haut).
        # Le cycle "flash top-most" n'a de sens QUE pour un retour au
        # premier plan APRÈS une réduction/mise en bottom en cours de
        # session -- s'il n'y a rien à restaurer (fenêtre jamais
        # montrée, ou déjà visible, non minimisée et sans
        # WindowStaysOnBottomHint), on ne touche à AUCUN flag/état et on
        # laisse __init__/le splashscreen gérer l'affichage normal.
        if not etait_minimisee and not etait_en_bottom and not self.isVisible():
            return

        if etait_minimisee:
            _forcer_premier_plan_windows(self)
            self.setWindowState(self.windowState() & ~Qt.WindowState.WindowMinimized)

        drapeaux_actuels = self.windowFlags()
        # Retire dès maintenant WindowStaysOnBottomHint s'il était posé
        # (mode "bottom") -- il ne doit PAS survivre à la restauration,
        # sans quoi le flash WindowStaysOnTopHint posé juste après
        # entrerait en conflit avec un WindowStaysOnBottomHint toujours
        # actif sur le même handle.
        drapeaux_actuels &= ~Qt.WindowType.WindowStaysOnBottomHint

        # 1) Pose temporairement WindowStaysOnTopHint et affiche : la
        #    fenêtre saute alors au-dessus de TOUTES les autres fenêtres
        #    de l'écran, exactement ce qui est recherché ("apparaît
        #    directement au-dessus de toutes les fenêtres").
        self.setWindowFlags(drapeaux_actuels | Qt.WindowType.WindowStaysOnTopHint)
        # BUGFIX (signalé : "le logo sur la barre des tâches a disparu,
        # parfois ça disparaît, parfois ça réapparaît quand je fais le
        # toggle") -- CAUSE : setWindowFlags() force Qt à détruire et
        # recréer le handle natif (HWND) de la fenêtre à CHAQUE appel ;
        # sous Windows, un HWND fraîchement recréé perd l'icône de barre
        # des tâches tant qu'elle n'est pas réappliquée dessus (posée
        # une seule fois à la construction, cf. self.setWindowIcon dans
        # __init__ -- elle ne "survit" pas automatiquement à une
        # recréation de handle). Cette méthode appelle setWindowFlags()
        # DEUX FOIS par restauration (pose puis retrait du TopHint,
        # cf. étape 2 plus bas) : reposer explicitement l'icône après
        # CHAQUE appel évite l'aléatoire observé (parfois disparue,
        # parfois pas, selon l'appel qui "gagnait" la dernière recréation
        # de handle).
        self.setWindowIcon(QIcon(_generate_icon_pixmap_autoniax(256)))
        self.show()
        # Appelé aussi hors du cas "était minimisée" : un déclenchement
        # via le raccourci global pynput arrive toujours sans focus
        # natif préalable, donc le même déblocage Windows est nécessaire
        # pour que raise_()/activateWindow() ci-dessous produisent
        # réellement un passage au premier plan visible (no-op déjà géré
        # si la fenêtre était minimisée, cf. ligne ci-dessus -- appeler
        # deux fois ne pose aucun problème, la fonction est idempotente).
        _forcer_premier_plan_windows(self)
        self.raise_()
        self.activateWindow()

        # 2) Retire immédiatement le flag pour repasser en fenêtre
        #    normale -- "pas de façon permanente" : une fois affichée au
        #    premier plan, elle redevient une fenêtre standard, capable
        #    d'être recouverte par d'autres fenêtres normalement par la
        #    suite, plutôt que de rester "always on top" en continu.
        self.setWindowFlags(drapeaux_actuels)
        # Même correctif qu'à l'étape 1 -- ce second setWindowFlags()
        # recrée À NOUVEAU le handle natif, donc l'icône doit être
        # reposée une seconde fois ici.
        self.setWindowIcon(QIcon(_generate_icon_pixmap_autoniax(256)))
        self.show()


