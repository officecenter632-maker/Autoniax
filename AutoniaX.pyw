# ---------------------------------------------------------------------------
# Capture d'écran -- équivalent capturer_frame_reelle (client nodriver).
# page.screenshot() Playwright remplace cdp.page.capture_screenshot ; même
# timeout explicite (asyncio.wait_for) pour ne jamais bloquer indéfiniment
# si Camoufox/Firefox se fige, même précaution que côté CDP.
# ---------------------------------------------------------------------------


# LOG DIAGNOSTIC (demande utilisateur explicite : logs détaillés à tous les
# niveaux) -- compteur global de captures page.screenshot() EN COURS sur le
# process. page.screenshot() (Playwright/Firefox) n'est PAS garanti
# parallélisable proprement sur la même page : si le streaming (cf.
# _boucle_streaming_frames_camoufox, tourne en tâche de fond dès que
# set_streaming actif=true) ET une commande 'capture_propre' pilotée
# déclenchent un screenshot au même instant sur la MÊME page, l'un des deux
# peut se retrouver silencieusement mis en attente côté navigateur -- ce
# compteur permet de voir si un appel qui traîne coïncide avec un autre
# appel déjà en cours (contention), plutôt qu'un blocage isolé.
_camoufox_captures_en_cours: dict = {"n": 0}


async def camoufox_capturer_frame_reelle(page, contexte_log: str = "frame", haute_qualite: bool = False) -> Optional[str]:
    """Retourne l'image en base64 (JPEG), ou None en cas d'échec
    transitoire. Lève NavigateurFermeCamoufox si le navigateur/onglet est
    fermé -- même contrat que capturer_frame_reelle côté nodriver."""
    _camoufox_captures_en_cours["n"] += 1
    n_concurrentes = _camoufox_captures_en_cours["n"]
    debut = _horloge()
    if n_concurrentes > 1:
        log.warning(
            f"[camoufox] capture ({contexte_log}) : DÉMARRE avec {n_concurrentes} capture(s) "
            f"page.screenshot() déjà en cours en parallèle sur ce process -- contention possible "
            f"(ex: streaming + capture_propre pilotée simultanés sur la même page)"
        )
    else:
        log.debug(f"[camoufox] capture ({contexte_log}) : démarre (aucune autre capture en cours)")
    try:
        # OBJECTIF 2 (demande explicite utilisateur) : 5.0s -> 15.0s -- même
        # raison que TIMEOUT_CAPTURE_PROPRE_CDP_S et _boucle_streaming_frames :
        # 5s confondait contention CPU normale (charge multi-instances) avec
        # un vrai blocage CDP.
        image_bytes = await asyncio.wait_for(
            # PATCH capture haute qualité : PNG sans perte pour capture_propre,
            # le streaming garde JPEG qualité 80 (haute_qualite=False).
            (page.screenshot(type="png", full_page=False) if haute_qualite
             else page.screenshot(type="jpeg", quality=80, full_page=False)),
            timeout=15.0,
        )
        duree = _horloge() - debut
        if duree > 1.0:
            log.warning(f"[camoufox] capture ({contexte_log}) : réussie mais LENTE -- {duree:.3f}s (n_concurrentes_au_départ={n_concurrentes})")
        else:
            log.debug(f"[camoufox] capture ({contexte_log}) : réussie en {duree:.3f}s")
        return base64.b64encode(image_bytes).decode("ascii")
    except asyncio.TimeoutError:
        log.warning(
            f"[camoufox] capture ({contexte_log}) : TIMEOUT après {_horloge() - debut:.3f}s "
            f"(limite 15s) -- abandonnée pour cette tentative (n_concurrentes_au_départ={n_concurrentes})"
        )
        return None
    except Exception as exc:
        _camoufox_relever_si_fermeture(exc)
        log.warning(f"[camoufox] capture ({contexte_log}) : échec après {_horloge() - debut:.3f}s -- {exc!r}")
        return None
    finally:
        _camoufox_captures_en_cours["n"] -= 1


async def _boucle_streaming_frames_camoufox(ws, etat_navigateur: dict, instance_id: str, etat_stream: dict):
    """STREAMING IMPLÉMENTÉ (demande utilisateur explicite : "implémente
    vraiment le streaming pour Camoufox") -- équivalent Playwright de
    _boucle_streaming_frames (client nodriver/CDP, cf. sa docstring pour
    le rythme auto-régulé et la tolérance aux erreurs transitoires) :
    avant ce patch, 'set_streaming'/'set_fps' n'étaient traités NULLE PART
    côté Camoufox (ni ici, absente, ni dans _executer_commande_camoufox,
    qui ne les connaît pas non plus) -- ces deux actions tombaient dans le
    'else' générique de _session_camoufox_minimale, répondant
    "action inconnue : set_streaming" (cf. capture d'écran utilisateur,
    onglet Test de composant : "Échec : action inconnue : set_streaming"),
    et aucune frame n'était jamais envoyée : l'aperçu restait bloqué sur
    "En attente du flux de ...".

    Utilise etat_navigateur["page"] (PAS un paramètre `page` figé) --
    même raison que get_fingerprint plus haut dans ce fichier : suit
    l'onglet réellement actif si switchTab/newTab/resetInterface l'ont
    changé entre-temps. Lève NavigateurFermeCamoufox dès que
    camoufox_capturer_frame_reelle signale une déconnexion définitive,
    exactement comme NavigateurFerme côté nodriver."""
    numero_sequence = 0
    log.info(f"[camoufox] _boucle_streaming_frames_camoufox() : démarrage pour {instance_id} (fps={etat_stream['fps']}, actif={etat_stream['actif']})")
    try:
        while True:
            if not etat_stream["actif"]:
                await asyncio.sleep(0.1)
                continue
            if etat_navigateur.get("reset_en_cours"):
                # CORRECTIF (plantage reset/capture) -- resetInterface en cours : pas de capture.
                await asyncio.sleep(0.1)
                continue
            debut = _horloge()
            page_active = etat_navigateur.get("page")
            if page_active is None:
                # Fenêtre de démarrage très courte (etat_navigateur["page"]
                # pas encore posée) -- cf. bug KeyError 'page' déjà corrigé
                # en amont pour ce même dict, même esprit défensif ici :
                # on patiente plutôt que de lever une exception qui
                # tuerait toute la session pour une frame ratée.
                image_b64 = None
            else:
                # CORRECTIF (demande explicite utilisateur : "dès qu'on
                # passe en mode rafraîchissement manuel, tout les autres
                # frame doivent être bloquer, je ne veux plus aucun autre
                # téléchargement") -- même correctif que _boucle_streaming_
                # frames côté nodriver (cf. son commentaire détaillé) :
                # avant, camoufox_capturer_frame_reelle était await-é
                # directement, donc si set_streaming(actif=False) arrivait
                # PENDANT cette attente, la capture en vol finissait quand
                # même et sa frame était envoyée avant que la boucle ne
                # revienne vérifier le flag. La capture est désormais une
                # tâche asyncio séparée, référencée dans etat_stream
                # ["tache_capture_courante"] pour que le handler
                # set_streaming (cf. _session_camoufox_minimale) puisse
                # l'annuler immédiatement dès réception de actif=False.
                tache_capture = asyncio.ensure_future(
                    camoufox_capturer_frame_reelle(page_active, f"stream seq={numero_sequence}")
                )
                etat_stream["tache_capture_courante"] = tache_capture
                try:
                    image_b64 = await tache_capture
                except asyncio.CancelledError:
                    # Annulée par le handler set_streaming (passage en mode
                    # manuel pendant cette capture précise) -- frame
                    # abandonnée, jamais envoyée. Retour au sommet de la
                    # boucle : `if not etat_stream["actif"]` y renvoie
                    # directement vers le sleep(0.1).
                    log.debug(f"[camoufox] capture seq={numero_sequence} annulée (passage en mode manuel)")
                    etat_stream["tache_capture_courante"] = None
                    continue
                except NavigateurFermeCamoufox:
                    # CORRECTIF (plantage reset/capture) -- distinguer onglet fermé / contexte mort.
                    contexte = etat_navigateur.get("context")
                    contexte_vivant = False
                    pages_valides = []
                    if contexte is not None:
                        try:
                            pages_valides = [pg for pg in contexte.pages if not pg.is_closed()]
                            contexte_vivant = True
                        except Exception:
                            contexte_vivant = False
                    if contexte_vivant:
                        etat_navigateur["page"] = pages_valides[-1] if pages_valides else None
                        log.warning(
                            f"[camoufox] streaming '{instance_id}' : page capturée fermée mais navigateur vivant "
                            f"-> resynchronisation sur la dernière page valide (seq={numero_sequence})"
                        )
                        await asyncio.sleep(0.2)
                        continue
                    log.warning(f"[camoufox] navigateur de l'instance '{instance_id}' fermé -> arrêt du streaming (seq={numero_sequence})")
                    raise
                finally:
                    etat_stream["tache_capture_courante"] = None
            # CORRECTIF (même demande) : re-vérifie actif juste APRÈS la
            # capture, avant tout envoi -- couvre la fenêtre où actif
            # serait repassé à False PENDANT la capture mais où celle-ci
            # aurait quand même fini par aboutir (course entre
            # l'annulation et la fin naturelle de la tâche) -- même
            # raisonnement que côté nodriver, cf. son commentaire.
            if not etat_stream["actif"]:
                log.debug(f"[camoufox] capture seq={numero_sequence} obtenue mais mode manuel actif entre-temps -- frame abandonnée")
                continue
            if image_b64 is None:
                image_b64 = generer_capture_simulee(instance_id)
            try:
                await ws.send(json.dumps({
                    "type": "frame", "instance_id": instance_id, "image_b64": image_b64,
                    "seq": numero_sequence, "ts_capture": debut,
                }))
            except websockets.exceptions.ConnectionClosed as e:
                log.warning(f"[camoufox] envoi de la frame #{numero_sequence} impossible : connexion déjà fermée -- {e!r}")
                raise
            if numero_sequence < 5 or numero_sequence % 50 == 0:
                log.debug(f"[camoufox] frame #{numero_sequence} envoyée pour {instance_id}")
            numero_sequence += 1
            ecoule = _horloge() - debut
            attente = max(0.0, (1.0 / etat_stream["fps"]) - ecoule)
            await asyncio.sleep(attente)
    finally:
        log.info(f"[camoufox] _boucle_streaming_frames_camoufox() : sortie de boucle pour {instance_id} (seq={numero_sequence})")


