        # texte_presse_papier) plutôt qu'une valeur périmée renvoyée en
        # silence comme avant ce patch.
        message = (
            f"aucune copie presse-papier détectée après le clic "
            f"(timeout {float(delai_max_s):.1f}s"
            + (f", id_dom={id_dom_cible!r}" if id_dom_cible else "")
            + ")"
        )
        log.warning(f"{prefixe_log}{message}")
        return {"texte": None, "frais": False, "origine": "aucune", "message": message}
    except Exception as e:
        # Défensif par construction : aucune erreur inattendue de ce
        # nouveau code ne doit casser un click() qui fonctionnait avant --
        # on dégrade vers l'ANCIEN comportement (dernière valeur connue,
        # potentiellement obsolète) plutôt que de lever.
        log.warning(
            f"{prefixe_log}détection de copie presse-papier en échec interne ({e!r}) -- "
            f"repli sur l'ancien comportement (dernière valeur connue, fraîcheur non garantie)."
        )
        return {
            "texte": str(etat_navigateur.get("presse_papier_virtuel", "")),
            "frais": True, "origine": "repli_erreur", "message": None,
        }


