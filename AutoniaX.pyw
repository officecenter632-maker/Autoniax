def charger_raccourcis_app() -> dict:
    """Charge raccourcis_app.json et le fusionne avec DEFAULT_RACCOURCIS_APP
    pour que toute entrée ajoutée plus tard à DEFAULT_RACCOURCIS_APP
    apparaisse automatiquement même si le fichier sur disque est ancien --
    même principe que load_app_shortcuts côté IngeniaX Explorer (cf. sa
    docstring). Ne fait jamais planter l'appelant : un fichier absent,
    corrompu, ou de mauvais type retombe silencieusement sur les valeurs
    par défaut (comme côté IngeniaX)."""
    base = {k: dict(v) for k, v in DEFAULT_RACCOURCIS_APP.items()}
    chemin = get_raccourcis_json_path()
    if chemin.exists():
        try:
            data = json.loads(chemin.read_text(encoding="utf-8"))
            if isinstance(data, dict):
                for k, v in data.items():
                    if k in base and isinstance(v, dict):
                        base[k].update(v)
        except Exception:
            pass
    return base


def sauvegarder_raccourcis_app(raccourcis: dict):
    """Écrit raccourcis_app.json. Échec silencieux (ex. disque plein,
    permissions) -- même principe que save_app_shortcuts côté IngeniaX :
    ne jamais faire planter l'UI pour un raccourci non sauvegardé, au pire
    le changement ne survivra pas au redémarrage."""
    try:
        get_raccourcis_json_path().write_text(
            json.dumps(raccourcis, ensure_ascii=False, indent=2), encoding="utf-8")
    except Exception:
        pass



# QKeySequence("Ctrl") seul est mal interprété par Qt (retombe sur
# Qt.Key_unknown au lieu de Qt.Key_Control -- contrairement à "Shift",
# "Alt" ou "Meta" seuls, qui eux se parsent correctement) : Qt part du
# principe qu'un modificateur textuel est TOUJOURS suivi d'une touche
# dans la chaîne. _touche_correspond_au_raccourci ci-dessous court-
# circuite donc QKeySequence pour ces 4 cas et compare directement
# event.key() au code du modificateur -- même dict que RaccourciCapture
# Dialog._MODIFICATEURS_SEULS/noms pour rester cohérent avec ce que ce
# dialogue peut produire comme combo.
_MODIFICATEURS_SEULS_LABELS = {
    "Ctrl": Qt.Key_Control,
    "Shift": Qt.Key_Shift,
    "Alt": Qt.Key_Alt,
    "Win": Qt.Key_Meta,
}


def _touche_correspond_au_raccourci(event, action_id: str) -> bool:
    """Vérifie si un QKeyEvent correspond au combo configuré pour
    action_id dans charger_raccourcis_app() -- réplique de
    _event_matches_action côté IngeniaX Explorer (signature (event,
    action_id) uniquement : pas besoin ici de la variante (key, mod,
    action_id), aucun appelant AutoniaX n'a key/mod pré-extraits).
    Retourne False (plutôt que lever) sur tout combo vide, invalide, ou
    erreur de comparaison -- un raccourci mal configuré ne doit jamais
    faire planter keyPressEvent."""
    try:
        combo = charger_raccourcis_app().get(action_id, {}).get("combo", "")
        if not combo:
            return False
        # Cas modificateur seul ("Shift", "Ctrl"...) : cf. note ci-dessus,
        # comparaison directe sans passer par QKeySequence. Comparaison
        # sur event.key() SEUL, sans vérifier event.modifiers() : quand on
        # presse Shift lui-même, Qt reporte déjà ShiftModifier comme actif
        # dans event.modifiers() (le modificateur qu'on est en train
        # d'enfoncer compte comme son propre modificateur), donc exiger
        # NoModifier ici aurait cassé la détection de Shift/Ctrl/Alt/Win
        # pressés seuls -- exactement le cas du raccourci "Shift" par
        # défaut (selection_capture_toggle) que ce code doit reproduire à
        # l'identique.
        if combo in _MODIFICATEURS_SEULS_LABELS:
            return event.key() == _MODIFICATEURS_SEULS_LABELS[combo]
        ks = QKeySequence(combo)
        if ks.isEmpty():
            return False
        combined = ks[0]
        if hasattr(combined, "key"):            # Qt 6 : QKeyCombination
            touche_attendue = combined.key()
            modificateurs_attendus = combined.keyboardModifiers()
        else:                                     # Qt 5 : int packé
            touche_attendue = Qt.Key(combined & ~int(Qt.KeyboardModifier.KeyboardModifierMask))
            modificateurs_attendus = Qt.KeyboardModifiers(combined & int(Qt.KeyboardModifier.KeyboardModifierMask))
        return event.key() == touche_attendue and event.modifiers() == modificateurs_attendus
    except Exception:
        return False


class RaccourciCaptureDialog(DialogueAutoniaXBase):
    """Capture une combinaison de touches pour l'onglet "Raccourcis" de
    ParametresScreen -- réplique EXACTE du comportement/UI de
    ShortcutCaptureDialog côté IngeniaX Explorer (cf. sa docstring), mais
    via QKeyEvent Qt natif plutôt que pynput : le mode Global (capture
    niveau OS, indépendante du focus) a été explicitement écarté ici
    (décision utilisateur "Interne seulement"), donc aucune raison de
    payer le coût d'un listener pynput + thread + QTimer de polling --
    keyPressEvent suffit largement pour un dialogue qui a le focus Qt
    pendant toute la capture.

    Capture Espace/Shift seuls (sans modificateur) correctement : contrairement
    à un raccourci classique Ctrl+X, les 2 raccourcis actuels d'AutoniaX sont
    des touches nues (cf. DEFAULT_RACCOURCIS_APP) -- _est_modificateur_seul
    ci-dessous les traite explicitement plutôt que de les rejeter comme
    "combo vide"."""

    _MODIFICATEURS_SEULS = {
        Qt.Key_Control, Qt.Key_Shift, Qt.Key_Alt, Qt.Key_Meta,
        Qt.Key_AltGr,
    }

    def __init__(self, label: str, combo_actuel: str = "", parent=None):
        super().__init__(f"Raccourci — {label}", parent, largeur_min=420)
        # MIGRÉ (section 6) : ex-setFixedSize(420, 190) -- largeur gardée
        # via largeur_min, hauteur désormais laissée au layout (plus
        # robuste maintenant que DialogueTitleBar ajoute 32px fixes en
        # haut : une hauteur figée à l'identique aurait pu couper le
        # contenu de quelques pixels selon la police système).
        self.setWindowFlags(self.windowFlags() | Qt.WindowType.WindowStaysOnTopHint)
        self._capture = combo_actuel
        self._construire(label, combo_actuel)

    def _construire(self, label: str, combo_actuel: str):
        lbl_titre = QLabel(f"Définir un raccourci pour :  <b>{label}</b>", self.zone_contenu)
        lbl_titre.setWordWrap(True)
        self.ajouter_widget(lbl_titre)

        lbl_astuce = QLabel(
            "Appuyez sur la touche ou la combinaison souhaitée.\n"
            "Validez avec le bouton OK.", self.zone_contenu,
        )
        lbl_astuce.setObjectName("PlaceholderSubtitle")
        self.ajouter_widget(lbl_astuce)

        self._label_capture = QLabel(
            combo_actuel if combo_actuel else "— appuyez sur une touche —", self.zone_contenu,
        )
        self._label_capture.setAlignment(Qt.AlignCenter)
        self._label_capture.setMinimumHeight(40)
        self._label_capture.setObjectName("RaccourciCaptureZone")
        self.ajouter_widget(self._label_capture)

        rangee_boutons = QHBoxLayout()
        bouton_effacer = _creer_bouton_dialogue("Effacer", primaire=False, parent=self.zone_contenu)
        bouton_effacer.clicked.connect(self._effacer)
        rangee_boutons.addWidget(bouton_effacer)
        rangee_boutons.addStretch(1)

        bouton_annuler = _creer_bouton_dialogue("Annuler", primaire=False, parent=self.zone_contenu)
        bouton_annuler.clicked.connect(self.reject)
        rangee_boutons.addWidget(bouton_annuler)

        bouton_ok = _creer_bouton_dialogue("OK", primaire=True, parent=self.zone_contenu)
        bouton_ok.setDefault(True)
        bouton_ok.clicked.connect(self.accept)
        rangee_boutons.addWidget(bouton_ok)

        self.ajouter_layout(rangee_boutons)

    def _effacer(self):
        self._capture = ""
        self._label_capture.setText("— appuyez sur une touche —")

    def keyPressEvent(self, event):
        # Échap ferme normalement un QDialog (reject) -- mais Échap est
        # une touche parfaitement valide à capturer comme raccourci futur.
        # Ici on la laisse malgré tout fermer le dialogue (comme tout
        # QDialog standard) plutôt que de la capturer, pour garder un
        # moyen d'annulation clavier évident : seul le bouton "Annuler"
        # ou la fermeture (x) restent le moyen d'annuler autrement, ce qui
        # est cohérent avec le fait qu'aucun des 2 raccourcis actuels
        # (Espace, Shift) n'a besoin d'Échap.
        if event.key() == Qt.Key_Escape:
            super().keyPressEvent(event)
            return
        touche = event.key()
        if touche in self._MODIFICATEURS_SEULS:
            # Modificateur pressé seul (ex. Shift) : combo = ce
            # modificateur seul, sans attendre une 2e touche -- cohérent
            # avec DEFAULT_RACCOURCIS_APP["selection_capture_toggle"]
            # ("Shift" seul, pas "Shift+quelquechose").
            noms = {
                Qt.Key_Control: "Ctrl", Qt.Key_Shift: "Shift",
                Qt.Key_Alt: "Alt", Qt.Key_Meta: "Win", Qt.Key_AltGr: "Alt",
            }
            combo = noms.get(touche, "")
        else:
            sequence = QKeySequence(event.modifiers() | Qt.Key(touche))
            combo = sequence.toString(QKeySequence.PortableText)
        if not combo:
            return
        self._capture = combo
        self._label_capture.setText(combo)

    def get_raccourci(self) -> str:
        """Retourne la combinaison capturée (ex: 'Shift', 'Ctrl+Space') ou
        '' si effacée/jamais capturée."""
        return self._capture


# ---------------------------------------------------------------------------
# Écran Paramètres — section Débogage (remplace le PlaceholderScreen "à
# venir" pour cette section de la sidebar). Permet de choisir une fenêtre de
# débogage qui sera présélectionnée automatiquement dans tout écran de test
# ayant besoin d'un rendu de fenêtre (TestComposantScreen,
# CoordonneeActionScreen, TestActionScreen), au lieu de reprendre par défaut
# le premier élément de la liste à chaque nouvel onglet. Réglage persisté
# séparément du projet (reglages.json — cf. ReglagesApp), donc valable pour
# tous les projets ouverts sur cette machine.
# ---------------------------------------------------------------------------
class ParametresScreen(QWidget):
    # PATCH (bouton "Copier tous les logs") -- identifiants fixes pour
    # les deux lignes toujours présentes de liste_sources_logs (cf.
    # __init__ plus bas), stockés comme Qt.UserRole de leur
    # QListWidgetItem au même titre que l'id_executant réel d'une ligne
    # sAutoniax -- garantit qu'aucune valeur réelle d'id_executant ne
    # peut jamais coïncider avec l'une des deux (ce sont des chaînes
    # avec un espace, jamais produites par str(id(websocket)) côté
    # serveur.py).
    ID_LOGS_MAUTONIAX = "__mautoniax_local__"
    ID_LOGS_SERVEUR = "__serveur_t__"

    # Émis quand la taille de police de l'éditeur de script Task change,
    # pour que MainWindow puisse la propager en direct à un TaskScriptEditor
    # déjà ouvert (cf. connexion dans MainWindow._build_screens), sans
    # attendre une fermeture/réouverture de Task.
    taille_police_editeur_changee = Signal(int)
    # PATCH (demande explicite utilisateur : "un bouton toggle dans les
    # paramètres qui va désactiver la sortie de cellules... je veux pouvoir
    # bloquer l'affichage de sortie") -- émis à chaque bascule du toggle,
    # pour que MainWindow applique le blocage IMMÉDIATEMENT aux cellules d'un
    # notebook déjà ouvert (cf. connexion dans MainWindow._build_screens,
    # même circuit que taille_police_editeur_changee juste au-dessus).
    # Porte la nouvelle valeur (bool : True = affichage bloqué).
    bloquer_sortie_cellules_changee = Signal(bool)
    # PATCH (retour utilisateur : désactiver "Fermer les instances à la
    # fermeture" en cours de session puis fermer l'app tuait quand même
    # les instances) -- émis quand ce réglage bascule, pour que
    # MainWindow puisse resynchroniser immédiatement le Job Object
    # Windows de ProfilsInstancesScreen sur le nouvel état (cf.
    # ProfilsInstancesScreen._synchroniser_job_object_instances),
    # au lieu d'attendre le prochain lancement d'instance ou un
    # redémarrage complet de l'app pour que le changement soit
    # réellement pris en compte.
    fermer_instances_a_fermeture_changee = Signal(bool)
    # AJOUT (toggle "Toujours en arrière-plan", onglet Général) -- émis à
    # chaque bascule du toggle, pour que MainWindow applique le nouveau
    # window flag (WindowStaysOnBottomHint) IMMÉDIATEMENT à la fenêtre
    # réelle, dans la session en cours -- même principe que
    # fermer_instances_a_fermeture_changee juste au-dessus (réglage qui a
    # un effet direct, pas seulement au prochain redémarrage comme
    # splash_actif). Porte la nouvelle valeur (bool).
    toujours_arriere_plan_changee = Signal(bool)
    # Émis quand l'utilisateur clique sur le bouton "Charger les banques"
    # (cf. section MOUVEMENT HUMAIN ci-dessous) -- MainWindow écoute ce
    # signal et lance réellement le chargement (cf. MainWindow.
    # lancer_prechargement_banques), le thread/worker restant possédé par
    # MainWindow plutôt que par cet écran (cohérent avec le reste de la
    # classe : ParametresScreen ne fait qu'émettre des signaux, jamais de
    # travail lourd lui-même).
    demande_precharger_banques = Signal()
    # AJOUT (bouton "Redémarrer le serveurT", cf. ClientServeurT.
    # forcer_reconnexion pour la raison d'être de ce signal) --
    # ParametresScreen ne possède pas non plus client_serveur_t (même
    # principe que demande_precharger_banques juste au-dessus : le
    # travail réel reste délégué à MainWindow, seule à posséder
    # self.client_serveur_t). Émis SANS argument, une fois le signal de
    # redémarrage confirmé écrit sur B2 (cf. _on_clic_redemarrer_
    # serveurt) -- MainWindow écoute ce signal pour appeler directement
    # client_serveur_t.forcer_reconnexion(), sans attendre le filet de
    # sécurité générique du heartbeat (DELAI_TIMEOUT_PONG_SECONDES).
    demande_redemarrer_serveurt = Signal()
    # PATCH (bouton "Copier tous les logs") -- ParametresScreen ne
    # possède ni ClientServeurT ni accès réseau direct (même principe
    # que demande_precharger_banques ci-dessus : le travail réel est
    # délégué à MainWindow). Porte la liste des id_executant sAutoniax
    # cochés (liste vide si aucun sAutoniax coché) -- mAutoniax/Serveur
    # cochés ou non sont lus directement par MainWindow via les méthodes
    # ci-dessous au moment de traiter le signal, pas besoin de les
    # transporter dans ce signal.
    # AJOUT (demande explicite utilisateur : "on met un txt edit a coter
    # qui vas contenir le type de logs a copier" -- filtre par motif
    # littéral plutôt que par niveau, pour traquer un tag de diagnostic
    # précis, ex: "DIAG_X", "[BADGE-TRACE]" -- peu importe la source ou
    # le niveau, seules les lignes CONTENANT ce motif survivent au filtre
    # final, cf. MainWindow._tenter_finaliser_copie_logs) -- second
    # paramètre str, chaîne vide = aucun filtre (comportement identique
    # à avant cet ajout).
    # AJOUT (demande explicite utilisateur : "un entry box ou l'on doit
    # specifier le pourcentage de logs a conserver [...] si je met 50
    # pourcent sa veut dire que je vais garder 50 pourcent des logs en
    # allant du plus recent au plus ancien", cf. champ_pourcentage_logs)
    # -- troisième paramètre int (0-100), 100 = comportement identique à
    # avant cet ajout (aucune troncature). Appliqué APRÈS le filtre par
    # motif, PAR SOURCE (décision explicite utilisateur), cf.
    # MainWindow._tenter_finaliser_copie_logs.
    demande_copier_tous_logs = Signal(list, str, int)
    # PATCH (onglet Raccourcis) -- émis à chaque changement RÉEL de
    # raccourci (modification ou reset), sans argument -- MainWindow
    # écoute ce signal pour que FenetreRenduTaskReseau (seul lecteur
    # actuel des raccourcis, cf. RACCOURCI_TOGGLE_AUTO/RACCOURCI_
    # SELECTION_CAPTURE) prenne en compte le nouveau combo IMMÉDIATEMENT,
    # sans attendre un redémarrage de l'app.
    raccourcis_app_changes = Signal()

    def __init__(self, reglages: ReglagesApp, parent=None):
        super().__init__(parent)
        self.reglages = reglages

        # PATCH (demande explicite utilisateur : "met dans les parametre,
        # il yauras longlet shotcut et la page actuels seras longlet
        # actuel general") -- ParametresScreen devient un conteneur à 2
        # onglets : "Général" (contenu EXACT d'avant ce patch, inchangé
        # à l'identique -- juste reparenté sur onglet_general au lieu de
        # self) et "Raccourcis" (nouveau, cf. _construire_onglet_
        # raccourcis plus bas). self ne porte plus qu'un layout minimal
        # contenant ce QTabWidget -- tout le reste de cette méthode
        # (root_layout.addWidget/addLayout ci-dessous) est STRICTEMENT
        # inchangé, seul son PARENT final change.
        root_layout_ecran = QVBoxLayout(self)
        root_layout_ecran.setContentsMargins(0, 0, 0, 0)
        root_layout_ecran.setSpacing(0)
        self._onglets = QTabWidget(self)
        root_layout_ecran.addWidget(self._onglets)

        # BUGFIX (retour utilisateur : "quand l'interface est un peu
        # réduite les éléments se compriment et ne marchent plus dessus")
        # -- CAUSE RACINE : onglet_general portait directement root_layout
        # (QVBoxLayout) sans aucune QScrollArea autour. Qt ne réduit
        # jamais le nombre/la hauteur naturelle des widgets empilés dans
        # un QVBoxLayout quand l'espace manque : il les COMPRESSE en
        # dessous de leur sizeHint (labels tronqués/superposés, QLineEdit
        # et boutons qui se chevauchent -- cf. capture utilisateur : "Copier
        # les logs" empiétant sur le nom du sAutoniax, "Filtrer par motif"
        # sorti du cadre) au lieu de rendre le contenu défilable. Cette
        # page est de toute façon plus haute que beaucoup de résolutions
        # d'écran une fois tout affiché (INSTANCES + SERVEUR CENTRAL +
        # DÉMARRAGE + ÉDITEUR + MOUVEMENT HUMAIN + TERMINAL + COPIER TOUS
        # LES LOGS), donc un scroll vertical est de toute façon la seule
        # solution correcte, pas un cas limite.
        #
        # CORRECTIF : onglet_general (l'onglet visible dans le
        # QTabWidget) ne porte plus lui-même root_layout -- il ne
        # contient plus qu'une QScrollArea occupant tout son espace, qui
        # embarque un widget interne SÉPARÉ (_general_contenu) portant
        # STRICTEMENT le même root_layout qu'avant ce patch (aucune ligne
        # de root_layout.addWidget/addLayout plus bas n'est modifiée).
        # setWidgetResizable(True) laisse le widget interne s'étirer à la
        # largeur disponible (donc le wrap des QLabel en setWordWrap(True)
        # continue de fonctionner normalement) tout en autorisant le
        # défilement vertical dès que le contenu dépasse la hauteur
        # visible, plutôt que de tout comprimer.
        onglet_general = QWidget(self._onglets)
        layout_onglet_general = QVBoxLayout(onglet_general)
        layout_onglet_general.setContentsMargins(0, 0, 0, 0)
        layout_onglet_general.setSpacing(0)
        zone_defilement_general = QScrollArea(onglet_general)
        zone_defilement_general.setObjectName("ParametresScrollArea")
        zone_defilement_general.setWidgetResizable(True)
        zone_defilement_general.setFrameShape(QFrame.NoFrame)
        zone_defilement_general.setHorizontalScrollBarPolicy(Qt.ScrollBarAsNeeded)
        zone_defilement_general.setVerticalScrollBarPolicy(Qt.ScrollBarAsNeeded)
        layout_onglet_general.addWidget(zone_defilement_general)
        self._onglets.addTab(onglet_general, "Général")

        contenu_general = QWidget(zone_defilement_general)
        # Largeur minimale pour que la ligne "sources de logs + filtre"
        # (QHBoxLayout à deux colonnes, cf. ligne_sources_et_filtre plus
        # bas) garde assez de place pour ses DEUX colonnes sans jamais se
        # chevaucher -- en dessous de cette largeur, la QScrollArea fait
        # apparaître une scrollbar horizontale plutôt que d'écraser le
        # contenu (même principe que le scroll vertical ci-dessus,
        # appliqué à la largeur).
        contenu_general.setMinimumWidth(520)
        zone_defilement_general.setWidget(contenu_general)

        root_layout = QVBoxLayout(contenu_general)
        root_layout.setContentsMargins(24, 24, 24, 24)
        root_layout.setSpacing(12)
        root_layout.setAlignment(Qt.AlignTop)

        titre = QLabel("PARAMÈTRES", self)
        titre.setObjectName("ReglagesPanelTitle")
        root_layout.addWidget(titre)

        # --- Section Instances (demande explicite utilisateur) : fermer
        # AutoniaX tue désormais TOUJOURS le serveur central (plus de
        # réglage à ce sujet), mais les instances nodriver (navigateurs),
