# Exécutables par navigateur (4.8/6.2 : "chemin de profil personnalisé, choix
# Vivaldi" -- laissé configurable via --navigateur/--executable plutôt que
# deviné, les chemins d'installation variant trop d'une machine à l'autre).
#
# PATCH (diagnostic "Chrome se ferme quand même à la fermeture d'AutoniaX,
# même avec fermer_instances_a_fermeture désactivé -- Vivaldi ne posait
# jamais ce problème") : "chrome": None laissait nodriver AUTO-DÉTECTER
# l'exécutable (cf. find_chrome_executable() de la lib nodriver), qui ne
# cherche que dans Program Files/Chrome/Application/chrome.exe -- ce
# binaire est en réalité un petit lanceur système Chrome, qui délègue à un
# process Chrome déjà existant sur la machine puis se termine lui-même,
# plutôt que d'ouvrir une instance véritablement isolée. Le PID capturé par
# nodriver dans ce cas ne correspond alors pas de façon fiable au process
# réellement responsable de la fenêtre, ce qui casse l'hypothèse
# "un PID = une instance isolée" que fermer_instances_a_fermeture=False
# (arreter_tout(), plus haut dans ce fichier) suppose implicitement pour
# laisser les instances survivre à la fermeture d'AutoniaX. Vivaldi n'a
# jamais ce souci car son chemin est déjà en dur ci-dessous -- même
# traitement appliqué maintenant à Chrome, avec le chemin d'installation
# standard SUR WINDOWS. Si l'installation Chrome réelle est ailleurs sur la
# machine, adapter ce chemin (ou passer --executable explicitement en ligne
# de commande, qui reste toujours prioritaire, cf. demarrer_navigateur).
#
# BUGFIX (erreur constatée sur sAutoniax Kaggle/Colab -- FileNotFoundError
# "Could not determine browser executable" : le chemin Windows en dur
# ci-dessus était utilisé tel quel sous Linux, où il ne peut évidemment
# jamais exister, empêchant même nodriver de retomber sur sa propre
# auto-détection puisqu'un chemin non vide est prioritaire, cf.
# demarrer_navigateur, chemin_exe = executable or EXECUTABLES_CONNUS.get(...))
# -- "chrome" est désormais résolu UNE FOIS ici, EN FONCTION DE
# L'ENVIRONNEMENT :
#   - Windows (sys.platform == "win32") : chemin en dur inchangé
#     ci-dessus, conservé précisément pour éviter le bug de PID/lanceur
#     système décrit plus haut (toujours d'actualité sur cette plateforme).
#   - Autre OS (Linux -- notebooks sAutoniax Kaggle/Colab, cf.
#     sAutoniax.ipynb section "_installer_chrome" : `playwright install
#     chrome --with-deps` installe un vrai binaire Google Chrome, PAS un
#     lanceur délégant, sous le nom `google-chrome`/`google-chrome-stable`
#     directement sur le PATH -- donc PAS le même bug de PID que sur
#     Windows) : recherche via shutil.which, dans l'ordre des noms de
#     binaire les plus courants sur les distributions Linux. None si
#     rien n'est trouvé -- EXECUTABLES_CONNUS.get("chrome") redevient
#     alors falsy, donc demarrer_navigateur laisse nodriver AUTO-DÉTECTER
#     lui-même (find_chrome_executable(), qui teste déjà d'autres
#     emplacements Linux usuels) plutôt que de forcer un chemin invalide.
def _resoudre_executable_chrome() -> Optional[str]:
    if sys.platform == "win32":
        return r"C:\Program Files\Google\Chrome\Application\chrome.exe"
    for nom_candidat in ("google-chrome-stable", "google-chrome", "chromium-browser", "chromium"):
        chemin_trouve = shutil.which(nom_candidat)
        if chemin_trouve:
            return chemin_trouve
    return None


EXECUTABLES_CONNUS = {
    "chrome": _resoudre_executable_chrome(),
    "vivaldi": r"C:\Users\Office\AppData\Local\Vivaldi\Application\vivaldi.exe",
}

