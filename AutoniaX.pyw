            # bien détruit à la fermeture ; on s'appuie dessus via
            # sip.isdeleted-like check (RuntimeError capturé) pour éviter
            # d'écrire dans un dialogue fermé si la réponse réseau arrive
            # après que l'utilisateur a fermé la fenêtre.
            dialogue.setAttribute(Qt.WA_DeleteOnClose)

            def _sur_reponse(id_recu: str, lignes: list, offset_utc_secondes: float):
                if id_recu != id_executant:
                    return
                self.client_serveur_t.logs_executant_recu.disconnect(_sur_reponse)
                try:
                    dialogue.definir_lignes(lignes)
                except RuntimeError:
                    # Dialogue déjà fermé/détruit (WA_DeleteOnClose) avant
                    # que la réponse n'arrive -- rien à afficher, pas une
                    # erreur en soi.
                    pass

            self.client_serveur_t.logs_executant_recu.connect(_sur_reponse)
            dialogue.show()
            self.client_serveur_t.demander_logs_executant(id_executant)

