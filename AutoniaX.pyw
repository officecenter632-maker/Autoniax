        self.bouton_copier_racine.setIcon(qta.icon("mdi6.content-copy", color=Mocha.subtext0))
        self.bouton_copier_racine.setIconSize(QSize(18, 18))
        self.bouton_copier_racine.setCursor(Qt.PointingHandCursor)
        self.bouton_copier_racine.setToolTip("Copier le chemin du dossier racine du projet")
        self.bouton_copier_racine.clicked.connect(self._copier_path_racine)
        ligne_racine.addWidget(self.bouton_copier_racine)

        layout.addLayout(ligne_racine)

        return bloc

    def _copier_path_racine(self):
        """Bouton copier à côté de racine_edit/bouton_choisir_racine (cf.
        _build_bloc_config) -- copie le chemin actuellement affiché (donc
        déjà résolu, que ce soit via _choisir_dossier_racine ou une
        saisie manuelle validée par _on_racine_edited_manuellement) dans
        le presse-papier système. Même pattern que
        TaskScriptEditor._copier_sortie : rien à faire si le champ est
        vide (aucun dossier choisi pour l'instant), feedback bref (icône
        "check" verte 1.2s) sinon."""
        texte = self.racine_edit.text()
        if not texte:
            return
        QGuiApplication.clipboard().setText(texte)
        self.bouton_copier_racine.setIcon(qta.icon("mdi6.check", color=Mocha.green))
        self.bouton_copier_racine.setToolTip("Copié !")
        QTimer.singleShot(1200, self._restaurer_icone_copier_racine)

    def _restaurer_icone_copier_racine(self):
        self.bouton_copier_racine.setIcon(qta.icon("mdi6.content-copy", color=Mocha.subtext0))
        self.bouton_copier_racine.setToolTip("Copier le chemin du dossier racine du projet")

    def _build_bloc_mapping(self, parent) -> QWidget:
        """Panneau de mapping variable <-> fichier (section 3 et 7 du
        patch) : variables dynamiques détectées à gauche, explorateur de
        fichiers de chemin_racine/1/data/ (pris comme sous-projet de
        référence, cf. décision -- tous les sous-projets partagent la même
        architecture) à droite, clic sur une variable PUIS clic sur un
        fichier pour associer les deux."""
        bloc = QWidget(parent)
        layout = QVBoxLayout(bloc)
        layout.setContentsMargins(0, 0, 0, 0)
        layout.setSpacing(10)

        titre = QLabel("Association fichier ↔ variable", bloc)
        titre.setObjectName("PlaceholderTitle")
        layout.addWidget(titre)

        sous_titre = QLabel(
            "Sélectionnez une variable détectée, puis cliquez sur le fichier ou "
            "le dossier (dans le sous-projet 1, pris comme référence) à lui "
            "associer. Le CHEMIN sera injecté dans la variable -- pas son "
            "contenu. Les variables numériques/booléennes (colonne de droite) "
            "ne se mappent pas à un fichier -- éditez directement leur valeur, "
            "ou utilisez la flèche de réinitialisation pour revenir à la "
            "valeur par défaut du script.",
            bloc,
        )
        sous_titre.setObjectName("PlaceholderSubtitle")
