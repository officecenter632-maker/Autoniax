# CORRECTIF .pyw (pythonw.exe) -- sans console, Python met sys.stdout et
# sys.stderr à None. Plus bas, _FluxStdoutParThread(sys.stdout) et
# logging.basicConfig() s'appuyaient sur ces flux : le premier print()/log
# levait AttributeError ('NoneType' has no attribute 'write') et l'app se
# fermait sans aucun message. On substitue donc un flux réel AVANT tout
# le reste (les sous-processus --serveur/--instance-id, lancés avec
# sys.executable = pythonw.exe, bénéficient du même correctif).
# Les sorties sont écrites dans ~/AutoniaX_pyw.log (utile pour diagnostiquer).
if sys.stdout is None or sys.stderr is None:
    try:
        _flux_pyw = open(
            os.path.join(os.path.expanduser("~"), "AutoniaX_pyw.log"),
            "a", encoding="utf-8", errors="replace", buffering=1,
        )
    except Exception:
        _flux_pyw = open(os.devnull, "w", encoding="utf-8")
    if sys.stdout is None:
        sys.stdout = _flux_pyw
    if sys.stderr is None:
        sys.stderr = _flux_pyw

# PATCH « instance légère » : `AutoniaX.pyw --generer-instance-legere` régénère
# AutoniaX_instance.py SANS charger Qt ni le reste du fichier (sinon la
# régénération coûterait un démarrage complet de l'app). Le code du générateur
# est lu dans ce même fichier, entre ses deux marqueurs. Contient __name__ à
# dessein : l'extraction du fichier léger ignore ainsi cette instruction.
if __name__ == "__main__" and "--generer-instance-legere" in sys.argv:
    import subprocess
    import threading
    import traceback
    from pathlib import Path
    _src_gen = Path(__file__).resolve()
    _txt_gen = _src_gen.read_text(encoding="utf-8")
    _a_gen = _txt_gen.index("# >>> INSTANCE_" + "LEGERE_DEBUT")
    _b_gen = _txt_gen.index("# <<< INSTANCE_" + "LEGERE_FIN")
    _ns_gen = {
        "os": os, "sys": sys, "subprocess": subprocess, "threading": threading,
        "traceback": traceback, "Path": Path, "SCRIPT_INSTANCE_DASHBOARD": _src_gen,
        "__name__": "autoniax_generateur_instance",
    }
    print("[instance légère] branche précoce atteinte (avant le chargement de Qt)", flush=True)
    exec(compile(_txt_gen[_a_gen:_b_gen], str(_src_gen) + "[instance_legere]", "exec"), _ns_gen)
    sys.exit(_ns_gen["_generer_instance_legere_cli"]())
