def get_serveur_t_dir() -> Path:
    """Dossier contenant le code du "serveurT" (onglet Git de la section
    Réseau, cf. GitScreen) -- serveur.py y est lu/écrit directement en
    texte brut à chaque frappe dans l'éditeur, PAS de notebook/JSON de
    cellules sur disque (décision explicite utilisateur : l'aspect
    notebook une-seule-cellule est purement une réutilisation du widget
    d'édition côté UI, la persistance reste un .py classique pour rester
    poussable tel quel sur GitHub).

    PATCH (demande explicite utilisateur : "je veux que on enleve le
    dossier data, en fait les donnee du serveur seront envoyer
    directement au serveur par notre application, github ne sert que a
    mettre a jour le serveur") -- plus de sous-dossier data/ ici : ce
    dossier ne contient QUE le code source poussé vers GitHub/Render
    (serveur.py, et tout autre fichier de code ajouté plus tard). Les
    données runtime du serveurT transitent par le protocole WebSocket de
    l'app elle-même (cf. cahier réseau, section 5.3), jamais par Git.

    Nettoie aussi un éventuel data/ VIDE laissé par une version
    antérieure de get_serveur_t_dir() qui le créait systématiquement --
    silencieux, best-effort (un data/ non vide, laissé volontairement par
    l'utilisateur, n'est PAS touché : on ne supprime jamais de contenu
    sans confirmation explicite, seul le dossier automatique vide créé
    par erreur par l'ancienne version disparaît tout seul)."""
    d = get_app_data_dir() / "serveur_t"
    d.mkdir(parents=True, exist_ok=True)
    ancien_dossier_data = d / "data"
    if ancien_dossier_data.is_dir():
        try:
            ancien_dossier_data.rmdir()  # échoue silencieusement si non vide -- volontaire, cf. docstring
        except OSError:
            pass
    return d


def get_notebook_execution_path() -> Path:
    """PATCH (Patch 4.8 -- emplacement de stockage dédié du notebook
    d'exécution) : emplacement STABLE et dédié du notebook Jupyter
    (.ipynb) qui démarre une instance sAutoniax sur Kaggle -- PAS un
    fichier généré à la volée par l'app (contrairement à .autoniaxtask
    via NotebookDragHandle/NotebookDragHandleCompact, cf. leurs
    docstrings) : c'est un fichier STATIQUE vivant UNIQUEMENT sur disque
    (plus aucun contenu par défaut embarqué en dur dans le code Python,
    cf. get_serveur_t_dir pour le même principe côté serveur.py), que
    l'utilisateur glisse-dépose directement vers Kaggle pour lancer un
    exécutant headless (cf. sa cellule 1 : installation des
    dépendances, cellule 3 : AUTONIAX_DATA_DIR, cellule 5 : lancement
    de `AutoniaX.py --sautoniax`).

    Même principe que get_serveur_t_dir() juste au-dessus (dossier sous
    get_app_data_dir(), cf. _chemin_donnees pour la résolution
    AUTONIAX_DATA_ROOT/chemin Windows en dur), mais un seul fichier
    UNIQUE et GLOBAL (pas par sAutoniax ni par projet, cf. point ouvert
    de la spec §4.8 tranché ainsi : le notebook ne fait que TÉLÉCHARGER
    AutoniaX.py et démarrer main_sautoniax() en process séparé --
    aucune donnée spécifique à un sAutoniax ou un projet n'y est écrite
    en dur, cf. son contenu -- NOM_PROFIL/INSTANCE_ID/SERVEUR_T_URL sont
    des variables éditées À LA MAIN par l'utilisateur une fois le
    notebook ouvert sur Kaggle, pas substituées ici avant l'envoi -- un
    seul et même fichier convient donc pour toutes les instances).

    PATCH (demande explicite utilisateur : "enleve aussi les notebook
    embarquer du code, fait les stocker comme serveur") -- PLUS de
    contenu par défaut embarqué en dur dans le code Python : ce fichier
    vit UNIQUEMENT sur disque, comme serveur.py (cf. get_serveur_t_dir),
    jamais fabriqué automatiquement depuis une constante Python. Si le
    fichier n'existe pas encore, cette fonction ne crée RIEN -- elle
    retourne juste le chemin où l'utilisateur doit le déposer lui-même
    (glisser-déposer manuel, comme pour serveur.py à l'origine)."""
    d = get_app_data_dir() / "notebook_execution"
    d.mkdir(parents=True, exist_ok=True)
    chemin = d / "sAutoniax.ipynb"
    return chemin


def renumeroter_instance_id_notebook(numero: int) -> None:
    """PATCH (demande explicite utilisateur : boutons radio 1-10 dans
    l'onglet "sAutoniax Manager" pour changer le numéro d'instance sans
    avoir à éditer le notebook à la main sur Kaggle) -- ouvre le fichier
    .ipynb réel sur disque (get_notebook_execution_path, cf. sa
    docstring : fichier STATIQUE, pas de contenu embarqué en dur ici) et
    réécrit en place la ligne `INSTANCE_ID = "sAutoniax-N"` trouvée dans
    ses cellules de code, en remplaçant N par `numero`.

    Modifie UNIQUEMENT cette ligne (regex ciblée sur le nom de variable,
    tolérante aux espaces et à un éventuel commentaire inline `# ...`
    qui la suit) -- tout le reste du notebook (autres cellules, autres
    variables NOM_PROFIL/SERVEUR_T_URL, outputs, métadonnées) reste
    strictement inchangé, y compris l'ordre et le formatage JSON.

    Lève FileNotFoundError si le notebook n'a encore jamais été déposé
    (cf. get_notebook_execution_path : "ne crée RIEN"), et ValueError si
    le fichier existe mais qu'aucune ligne INSTANCE_ID n'y a été
    trouvée -- dans les deux cas c'est à l'appelant (bouton radio ci-
    dessous) d'afficher un message clair plutôt que de laisser
    remonter une exception brute."""
    chemin = get_notebook_execution_path()
    if not chemin.is_file():
        raise FileNotFoundError(
            f"{chemin.name} n'existe pas encore -- dépose d'abord le notebook."
        )

    with open(chemin, "r", encoding="utf-8") as f:
        notebook = json.load(f)

    motif = re.compile(r'INSTANCE_ID\s*=\s*"[^"]*"')
    trouve = False
    for cell in notebook.get("cells", []):
        if cell.get("cell_type") != "code":
            continue
        source = cell.get("source", [])
        for i, ligne in enumerate(source):
            if motif.search(ligne):
                source[i] = motif.sub(f'INSTANCE_ID = "sAutoniax-{numero}"', ligne)
                trouve = True
        if trouve:
            break

    if not trouve:
        raise ValueError(
            f"Aucune ligne INSTANCE_ID trouvée dans {chemin.name}."
        )

    with open(chemin, "w", encoding="utf-8") as f:
        json.dump(notebook, f, ensure_ascii=False, indent=1)
        f.write("\n")


