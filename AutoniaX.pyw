class AutoCompletionPopup(QListWidget):
    """Popup flottant sans décoration listant les méthodes de
    ComposantExecutable disponibles après "NomComposant.". Fenêtre-outil
    indépendante (pas un enfant en layout) pour flotter par-dessus l'éditeur
    à la position du curseur texte, comme un vrai popup d'IDE. Thème Darcula
    appliqué via #AutoCompletionPopup dans build_stylesheet(). Un clic (ou
    Entrée/Tab) insère la SIGNATURE COMPLÈTE de la méthode (décision
    explicite utilisateur), pas seulement son nom -- ex: cliquer sur "click"
    insère "click(bouton='gauche', duree_appui_ms=60, nb_clics=1,
    copier_presse_papier=False)" tel quel, prêt à être ajusté par
    l'utilisateur."""

    methode_choisie = Signal(str, str)  # (nom_methode, signature_complete)

    def __init__(self, parent=None):
        super().__init__(parent)
        self.setObjectName("AutoCompletionPopup")
        self.setWindowFlags(Qt.ToolTip | Qt.FramelessWindowHint)
        self.setFocusPolicy(Qt.NoFocus)  # le focus clavier reste dans l'éditeur
        self.setHorizontalScrollBarPolicy(Qt.ScrollBarAlwaysOff)
        self.setUniformItemSizes(True)
        self.itemClicked.connect(self._sur_clic_item)

    def peupler(self, methodes: list):
        """methodes : liste de (nom, signature, description), déjà triée par
        probabilité d'usage décroissante -- l'ordre d'insertion EST l'ordre
        d'affichage (pas de tri supplémentaire ici)."""
        self.clear()
        for nom, signature, description in methodes:
            item = QListWidgetItem(signature)
            item.setData(Qt.UserRole, nom)
            item.setData(Qt.UserRole + 1, signature)
            item.setToolTip(description)
            self.addItem(item)
        if self.count():
            self.setCurrentRow(0)
        hauteur = min(self.count(), 8) * 26 + 10
        largeur = max(self.sizeHintForColumn(0) + 24, 260)
        self.setFixedSize(largeur, hauteur)

    def _sur_clic_item(self, item: QListWidgetItem):
        self.methode_choisie.emit(item.data(Qt.UserRole), item.data(Qt.UserRole + 1))

    def selection_actuelle(self) -> Optional[tuple]:
        """Retourne (nom_methode, signature_complete) de l'item sélectionné,
        ou None si le popup est vide."""
        item = self.currentItem()
        if item is None:
            return None
        return (item.data(Qt.UserRole), item.data(Qt.UserRole + 1))

    def deplacer_selection(self, delta: int):
        if not self.count():
            return
        nouvelle_ligne = (self.currentRow() + delta) % self.count()
        self.setCurrentRow(nouvelle_ligne)


class LineNumberArea(QWidget):
    """Bande étroite collée au bord gauche d'un TaskScriptEditor, affichant
    le numéro de chaque ligne de CETTE cellule (demande explicite
    utilisateur : "je crois que il vas falloir numeroter chque ligne de
    code de cellule, et je veux que ce soit relatifs a chque celleule, je
    veux dire les numeros de compte donc a chque debut de celelule sa
    recomence a 1"). Pattern Qt standard ("Code Editor Example" de la doc
    officielle QPlainTextEdit) : un widget séparé, PAS peint à l'intérieur
    de l'éditeur lui-même -- delègue toute la largeur/dessin à l'éditeur
    parent (cf. TaskScriptEditor.line_number_area_width/
    _peindre_numeros_lignes) pour rester un pur widget d'affichage sans
    logique propre.

    "Relatif à chaque cellule" est satisfait NATURELLEMENT ici : chaque
    TaskCelluleWidget possède son propre TaskScriptEditor avec son propre
    QTextDocument (cf. QPlainTextEdit), donc blockNumber() (base 0, +1
    pour l'affichage) recommence toujours à 1 en haut de CE document --
    aucune numérotation globale au notebook entier à soustraire ou décaler,
    contrairement à label_index (numéro de POSITION de la cellule dans le
    notebook, lui bien global -- cf. TaskCelluleWidget, sémantique
    différente et volontairement non mélangée à celle-ci)."""

    def __init__(self, editeur: "TaskScriptEditor"):
        super().__init__(editeur)
        self._editeur = editeur

    def sizeHint(self):
        return QSize(self._editeur.line_number_area_width(), 0)

    def paintEvent(self, event):
        self._editeur._peindre_numeros_lignes(event)


class BadgeStatutNotebook(QWidget):
    """Petit indicateur circulaire de statut global du notebook (demande
    explicite utilisateur : badge dans la barre de boutons principaux
    reflétant le résultat de la DERNIÈRE séquence "Tout exécuter", cf.
    TaskConfigScreen._rafraichir_badge_statut_notebook). Remplace un
    simple QLabel+pixmap parce qu'il faut aussi représenter un état "en
    cours" ANIMÉ, explicitement demandé DIFFÉRENT du spin existant du
    bouton ▶→⏹ (qui fait pivoter une icône pleine mdi6.loading, cf.
    TaskCelluleWidget._animation_spin) -- ici : "un genre que on a
    l'impression que le serpent est en train de tourner en rond", donc un
    ARC PARTIEL en rotation continue autour du badge (pattern spinner
    circulaire classique), pas une icône qui pivote sur elle-même. Un
    QLabel+setPixmap ne peut pas dessiner un arc qui progresse frame par
    frame -- d'où ce petit widget dédié avec son propre paintEvent.

    Deux modes, exclusifs :
      - Statique : disque plein d'une couleur (rouge/jaune/vert/gris),
        cf. definir_statut() -- rendu identique à l'ancien QLabel+pixmap.
      - Animé ("en cours") : anneau de fond discret + arc mauve
        (Mocha.mauve) qui tourne en boucle, cf. definir_en_cours(True) --
        démarre/arrête un QTimer interne, pas de dépendance à qtawesome
        ici (contrairement au spin du bouton ▶, volontairement pour
        rester visuellement distinct)."""

    # PATCH10 : minuteur PARTAGÉ par tous les badges (cf. _tick_partage).
    _FPS_ANIMATION = 2
    _INTERVALLE_MS = 1000 // _FPS_ANIMATION
    _PAS_DEGRES = 60  # 60 deg x 2 images/s = 120 deg/s, soit ~3 s par tour
    _badges_animes: set = set()
    _minuteur_partage = None
    _angle_partage = 0

    @classmethod
    def _tick_partage(cls):
        cls._angle_partage = (cls._angle_partage + cls._PAS_DEGRES) % 360
        for badge in list(cls._badges_animes):
            try:
                badge._angle_courant = cls._angle_partage
                badge.update()
            except RuntimeError:   # widget C++ déjà détruit
                cls._badges_animes.discard(badge)
        if not cls._badges_animes and cls._minuteur_partage is not None:
            cls._minuteur_partage.stop()

    @classmethod
    def _demarrer_minuteur_partage(cls):
        if cls._minuteur_partage is None:
            cls._minuteur_partage = QTimer(QApplication.instance())
            cls._minuteur_partage.timeout.connect(cls._tick_partage)
        if not cls._minuteur_partage.isActive():
            cls._minuteur_partage.start(cls._INTERVALLE_MS)
    _ETENDUE_ARC_DEGRES = 100  # longueur de l'arc mauve visible, le reste de l'anneau reste discret

    def __init__(self, parent=None):
        super().__init__(parent)
        self.setFixedSize(18, 18)
        self.setCursor(Qt.ArrowCursor)
        self._couleur_statique: Optional[str] = None  # None tant qu'aucun statut n'a encore été posé
        self._en_cours = False
        self._angle_courant = 0
        self._minuteur = QTimer(self)
        self._minuteur.timeout.connect(self._avancer_animation)

    def definir_statut(self, couleur_hex: str, tooltip: str):
        """Bascule (ou reste) en mode statique -- disque plein de
        `couleur_hex`. Arrête le minuteur d'animation s'il tournait (cf.
        definir_en_cours), sinon deux QTimer.timeout concurrents
        continueraient à se disputer l'affichage de ce widget."""
        self._minuteur.stop()
        type(self)._badges_animes.discard(self)   # PATCH10
        self._en_cours = False
        self._couleur_statique = couleur_hex
        self.setToolTip(tooltip)
        self.update()
        # [SYNC-DIAG] heure à laquelle le statut final (vert/rouge...) est appliqué
        _sync_diag_marquer_ui("BADGE statut appliqué", f"couleur={couleur_hex} tooltip={tooltip!r}")
        self._sync_diag_repaint_attendu = True

    def definir_en_cours(self, tooltip: str = "Exécution en cours..."):
        """Bascule en mode animé (arc mauve tournant) -- démarre le
        minuteur s'il ne tournait pas déjà (idempotent : un second appel
        pendant que c'est déjà animé ne redémarre pas l'angle à zéro,
        évite un micro-à-coup visuel si _rafraichir_bouton_global est
        appelée plusieurs fois de suite pendant la même séquence)."""
        self.setToolTip(tooltip)
        if self._en_cours:
            return
        self._en_cours = True
        # PATCH10 : plus de QTimer par badge ; l'angle suit le minuteur partagé.
        self._angle_courant = type(self)._angle_partage
        type(self)._badges_animes.add(self)
        type(self)._demarrer_minuteur_partage()
        self.update()

    def _avancer_animation(self):
        self._angle_courant = (self._angle_courant + self._PAS_DEGRES) % 360
        self.update()

    def paintEvent(self, event):
        # [SYNC-DIAG] premier repaint réel après definir_statut()
        if getattr(self, "_sync_diag_repaint_attendu", False):
            self._sync_diag_repaint_attendu = False
            _sync_diag_marquer_ui("BADGE repeint à l'écran")
        painter = QPainter(self)
        painter.setRenderHint(QPainter.Antialiasing)
        rect = QRectF(2, 2, self.width() - 4, self.height() - 4)

        if self._en_cours:
            # Anneau de fond discret (toujours visible, donne le
            # "rail" sur lequel l'arc mauve semble glisser) + arc mauve
            # de longueur fixe dont l'angle de départ avance à chaque
            # frame -- QPainter.drawArc compte les angles en 1/16e de
            # degré et dans le sens ANTI-horaire depuis 3h, d'où les
            # conversions ci-dessous.
            pen_fond = QPen(QColor(Mocha.surface2))
            pen_fond.setWidth(2)
            painter.setPen(pen_fond)
            painter.drawEllipse(rect)

            pen_arc = QPen(QColor(Mocha.mauve))
            pen_arc.setWidth(2)
            pen_arc.setCapStyle(Qt.RoundCap)
            painter.setPen(pen_arc)
            painter.drawArc(
                rect,
                int(-self._angle_courant * 16),
                int(-self._ETENDUE_ARC_DEGRES * 16),
            )
        elif self._couleur_statique is not None:
            painter.setPen(Qt.NoPen)
            painter.setBrush(QBrush(QColor(self._couleur_statique)))
            painter.drawEllipse(rect)
        # _couleur_statique is None ET pas en_cours (tout premier
        # affichage, avant le premier _rafraichir_badge_statut_notebook) :
        # rien à peindre, widget transparent -- évite d'imposer une
        # couleur par défaut arbitraire avant que l'état réel soit connu.

        painter.end()


class TaskScriptEditor(PlainTextEditAvecEditingFinished):
    """Éditeur de code d'UNE cellule de Task (mode notebook, décision
    explicite utilisateur) : QPlainTextEdit avec coloration syntaxique
    Python thème Darcula (cf. PythonHighlighter), police à chasse fixe
    configurable (cf. ReglagesApp.taille_police_editeur_script -- réglage
    persistant, valeur par défaut raisonnable), tabulation de 4 espaces
    (convention Python standard, plutôt qu'une vraie tabulation qui rendrait
    l'indentation instable d'un éditeur à l'autre), et auto-complétion des
    méthodes de ComposantExecutable déclenchée après "NomComposantConnu."
    (seulement pour les composants réellement importés dans le Task
    courant -- cf. definir_composants_connus).

    Auto-redimensionnement en hauteur selon le contenu (comme une cellule
    Jupyter) : pas de scrollbar interne propre à la cellule, elle grandit
    avec son code -- c'est le notebook entier (TaskConfigScreen) qui
    défile, pas chaque cellule individuellement."""

    def __init__(self, reglages: Optional["ReglagesApp"] = None, parent=None):
        super().__init__(parent)
        self.setObjectName("TaskScriptEditor")
        self.reglages = reglages
        self._composants_connus: set = set()
        # AJOUT (demande explicite utilisateur : "chaque zone doit avoir
        # les meme methode que un composantSingle" -- prérequis : que
        # ComposantLayoutExecutable/ZoneDetectee soient d'abord reconnus
        # par l'auto-complétion, cf. METHODES_COMPOSANT_LAYOUT_EXECUTABLE/
        # METHODES_ZONE_DETECTEE) -- noms FIXES des ComposantLayout
        # importés dans ce Task (ex: "videoTemplateItems"), même principe
        # que _composants_connus ci-dessus mais pour cL au lieu de cS
        # (cf. definir_composants_layout_connus, alimenté par
        # TaskConfigScreen._rafraichir_composants_connus_editeur, même
        # source que pour les Composant : Project.composants_layout_
        # importes_task, symétrique de composants_importes_task).
        self._composants_layout_connus: set = set()
        # AJOUT -- noms de VARIABLE choisis librement par l'utilisateur
        # via "z = monComposantLayout.choose().nom_zone" (ou
        # "instance = monComposantLayout.choose() ; z = instance.
        # nom_zone", cf. _rescanner_zones_connues pour les deux formes
        # couvertes) -- détectés dynamiquement, même mécanisme que
        # _instances_connues/_resultats_connus ci-dessous mais pour
        # ZoneDetectee (SPEC section 6). Contrairement à _instances_connues,
        # AUCUNE vérification du nom de zone n'est possible ici (les noms
        # de zone sont définis dynamiquement par le code_filtre de CHAQUE
        # ComposantLayout, jamais visibles depuis le texte du script
        # lui-même) -- volontairement permissif, cf. docstring de
        # _REGEX_AFFECTATION_ZONE plus bas : seul le fait que la variable
        # de gauche vienne d'un ".choose()." (deux points d'affilée, un
        # nom de ComposantLayout connu suivi de n'importe quel nom
        # d'attribut) suffit à la reconnaître comme une ZoneDetectee.
        self._zones_connues: set = set()
        # Auto-complétion des méthodes de InstanceExecutable (cf.
        # METHODES_INSTANCE_EXECUTABLE) : _services_api_connus est la liste
        # des noms de ServiceAPI importés dans ce Task (ex: "Word"), REÇUE
        # de l'extérieur (cf. definir_services_api_connus). _instances_connues
        # est calculée EN INTERNE, dynamiquement, à chaque modification du
        # texte (cf. _rescanner_instances_connues) : contrairement aux
        # composants (dont le nom de variable est fixe, imposé par l'import),
        # une variable d'instance n'a pas de nom fixe -- l'utilisateur écrit
        # "ma_variable = Word.instance()" avec le nom qu'il veut. On doit
        # donc analyser le texte de LA CELLULE COURANTE pour repérer ce
        # pattern et savoir après quels noms de variable proposer les
        # méthodes de InstanceExecutable plutôt que celles de
        # ComposantExecutable.
        self._services_api_connus: set = set()
        self._instances_connues: set = set()
        # AJOUT (demande explicite utilisateur : "le resultat de chaque
        # methode est un objet ... r. doit me proposer les differentes
        # variable") -- Auto-complétion des attributs de ResultatAction
        # (cf. METHODES_RESULTAT_ACTION) : même mécanisme que
        # _instances_connues juste au-dessus (nom de variable choisi
        # librement par l'utilisateur, détecté dynamiquement en scannant
        # le texte de la cellule à chaque modification, cf.
        # _rescanner_instances_connues qui peuple maintenant AUSSI cet
        # ensemble) plutôt qu'un nom fixe/importé comme les composants.
        self._resultats_connus: set = set()
        # PATCH (retour utilisateur : auto-complétion manquante sur le
        # retour de screenshot()) -- même principe EXACT que
        # _resultats_connus juste au-dessus, mais pour les variables
        # affectées à un objet Image (cf. METHODES_IMAGE/
        # NOMS_METHODES_RETOURNANT_IMAGE/_REGEX_AFFECTATION_IMAGE).
        self._images_connues: set = set()
        # Auto-complétion des noms de VARIABLE déjà écrits dans la cellule
        # (ex: taper "r" propose "resultat" si "resultat = ..." apparaît
        # plus haut) -- calculé en interne comme _instances_connues, mais
        # déclenché SANS "." devant (cf. _REGEX_CONTEXTE_MOT) : c'est de la
        # complétion de NOM de variable, pas de méthode après un point.
        self._variables_connues: set = set()
        # Variables/instances connues à l'échelle du NOTEBOOK ENTIER (les
        # autres cellules du même Task, cf. TaskConfigScreen.
        # _rafraichir_variables_globales_editeur) -- distinct de
        # _variables_connues/_instances_connues ci-dessus qui, elles, ne
        # scannent QUE le texte de cette cellule. BUGFIX (retour
        # utilisateur : "la suggestion de variable concerne uniquement les
        # variable locale a la cellule et pourtant sa doit etre global au
        # notebook") : le namespace d'exécution réel est déjà partagé
        # entre toutes les cellules (cf. TaskConfigScreen._namespace_task,
        # "comme un vrai notebook Jupyter"), donc l'auto-complétion doit
        # refléter la même portée -- une variable déclarée dans
        # cellule_variables ou dans une cellule précédente doit être
        # proposable ici aussi, pas seulement les siennes propres. Mis à
        # jour par TaskConfigScreen à chaque frappe dans N'IMPORTE QUELLE
        # cellule du Task (cf. _sur_code_cellule_modifie), pas seulement à
        # l'ouverture -- sinon une variable tout juste tapée dans une
        # autre cellule resterait invisible ici jusqu'au prochain
        # rechargement du Task.
        self._variables_globales_connues: set = set()
        self._instances_globales_connues: set = set()
        # AJOUT, même principe que _instances_globales_connues juste
        # au-dessus mais pour les variables ResultatAction déclarées dans
        # les AUTRES cellules du Task (cf. definir_resultats_globaux_connus).
        self._resultats_globaux_connus: set = set()
        self._taille_police_courante = (
            reglages.taille_police_editeur_script if reglages is not None else 14
        )

        # AJOUT (GitScreen -- demande explicite utilisateur : "je veux que
        # la hauteur de la cellule reste maximal ... sa doit etre un
        # editeur") -- flag désactivant tout le mécanisme setFixedHeight()
        # de _ajuster_hauteur ci-dessous, pour les contextes où cet éditeur
        # doit se comporter comme un éditeur de fichier plein-écran
        # classique (scrollbar verticale propre, occupe tout l'espace
        # disponible) plutôt que comme une cellule Jupyter qui épouse son
        # contenu. Désactivé par défaut : AUCUN changement de comportement
        # pour TaskConfigScreen (toutes les vraies cellules de notebook
        # restent inchangées) -- seul activer_mode_editeur_pleine_hauteur()
        # (cf. plus bas) peut le faire basculer, appelé uniquement par
        # GitScreen. DOIT être posé ICI, avant tout appel pouvant
        # déclencher _ajuster_hauteur() (appliquer_taille_police() juste
        # plus bas notamment) -- posé trop tard, _ajuster_hauteur() lève
        # AttributeError au tout premier appel (bug constaté).
        self._mode_editeur_pleine_hauteur = False

        # OPTIMISATION (SPEC_patch_ouverture_task.md §H4 -- "cause non
        # identifiée" : c'est ELLE) -- mémo de la dernière hauteur calculée
        # en mode retour-à-la-ligne, sous la forme (clé, hauteur). Voir
        # _ajuster_hauteur ci-dessous pour le raisonnement complet. Doit
        # être initialisé ICI, avant appliquer_taille_police() juste plus
        # bas, qui déclenche déjà un premier _ajuster_hauteur().
        self._cache_hauteur_wrap: Optional[tuple] = None

        # PATCH (demande explicite utilisateur : Ctrl+F "selection de tout
        # les occurence dans tout le notebook") -- id de la cellule portée
        # par CET éditeur, renseigné par TaskCelluleWidget juste après
        # construction (cf. son __init__), None pour un éditeur en lecture
        # seule sans cellule associée (cf.
        # NotebookExecutionLectureSeule._construire_bloc_cellule) : la
        # recherche globale y est alors simplement inerte (cf.
        # _notebook_parent, qui retourne None dans ce cas).
        self._cellule_id_associee: Optional[str] = None

        # AJOUT (cf. surligner_ligne_erreur/_selections_erreur plus haut
        # dans la classe) -- numéro de ligne (1-based) actuellement
        # surligné en rouge suite à une erreur d'exécution, ou None si
        # aucune erreur en cours. Doit exister AVANT le premier appel
        # possible à _appliquer_surlignage_occurrences (déclenché dès
        # blockCountChanged/updateRequest juste en dessous), d'où
        # l'initialisation ici plutôt que paresseusement via getattr
        # seul -- getattr(..., None) dans _selections_erreur reste un
        # filet de sécurité, pas le mécanisme principal.
        self._ligne_erreur_surlignee: Optional[int] = None

        # PATCH (demande utilisateur : numérotation de ligne par cellule,
        # cf. docstring de LineNumberArea) -- widget dédié + connexions
        # standard Qt (cf. exemple officiel "Code Editor") : la largeur de
        # la marge gauche dépend du nombre de chiffres du plus grand numéro
        # (blockCountChanged), son CONTENU doit être repeint à chaque
        # défilement/frappe (updateRequest), et sa géométrie doit suivre le
        # redimensionnement de l'éditeur (cf. resizeEvent, plus bas). Créée
        # AVANT appliquer_taille_police()/_ajuster_hauteur() juste en
        # dessous : ces derniers déclenchent déjà un premier calcul de
        # marge qui a besoin que ce widget existe.
        self._zone_numeros_lignes = LineNumberArea(self)
        self.blockCountChanged.connect(self._mettre_a_jour_largeur_zone_numeros)
        self.updateRequest.connect(self._mettre_a_jour_zone_numeros)

        self.appliquer_taille_police(self._taille_police_courante)
        self.setTabStopDistance(4 * self.fontMetrics().horizontalAdvance(" "))
        # PATCH (demande utilisateur : "je veux que tu mets un retour a la
        # ligne pour le code... dans la barre de bouton principlae en haut
        # il vas faloir mettre un bouton qui gere le retour a la ligne") --
        # état initial pris depuis le réglage persistant (cf.
        # ReglagesApp.retour_a_la_ligne_editeur_script), pour qu'une cellule
        # nouvellement créée/ouverte respecte immédiatement le dernier choix
        # de l'utilisateur plutôt que de toujours redémarrer en NoWrap.
        # Ensuite piloté depuis l'EXTÉRIEUR par definir_retour_a_la_ligne
        # (cf. TaskConfigScreen._sur_clic_retour_ligne, qui l'appelle sur
        # TOUTES les cellules d'un coup depuis le bouton de la toolbar).
        self.setLineWrapMode(
            QPlainTextEdit.WidgetWidth
            if (reglages is not None and reglages.retour_a_la_ligne_editeur_script)
            else QPlainTextEdit.NoWrap
        )
        self.setPlaceholderText(
            "if MonComposant.visible():\n    MonComposant.click()\n"
        )
        self._highlighter = PythonHighlighter(self.document())
        self._mettre_a_jour_largeur_zone_numeros(0)

        self._popup = AutoCompletionPopup(self)
        self._popup.methode_choisie.connect(self._inserer_methode)
        self.textChanged.connect(self._sur_texte_modifie)

        # Auto-redimensionnement en hauteur façon cellule de notebook.
        self.setVerticalScrollBarPolicy(Qt.ScrollBarAlwaysOff)
        # Barre horizontale masquée elle aussi (policy, pas CSS -- le CSS seul
        # ne suffit jamais à supprimer une scrollbar native Qt tant que la
        # policy dit de l'afficher) : le scroll horizontal reste fonctionnel
        # via molette/Shift+molette et clavier, la barre n'est simplement
        # jamais dessinée.
        self.setHorizontalScrollBarPolicy(Qt.ScrollBarAlwaysOff)
        self.setSizePolicy(QSizePolicy.Expanding, QSizePolicy.Fixed)
        self.document().documentLayout().documentSizeChanged.connect(
            self._ajuster_hauteur
        )
        self.blockCountChanged.connect(self._ajuster_hauteur)
        self._ajuster_hauteur()

    def showEvent(self, event):
        """Réapplique la police courante une fois le widget réellement
        affiché à l'écran. NÉCESSAIRE : au moment de __init__, le widget
        n'a pas encore de fenêtre top-level visible, donc la règle CSS
        globale "QWidget { font-family: 'Segoe UI'; font-size: 13px; }"
        (cf. build_stylesheet) écrase silencieusement le setFont() fait
        dans appliquer_taille_police() au premier repolish Qt -- observé
        concrètement : le widget se retrouvait avec Segoe UI au lieu de
        Consolas à la taille demandée, tant qu'aucune interaction (ex.
        incrémenter/décrémenter le spinbox) ne redéclenchait setFont()
        après que le widget soit devenu visible. On réapplique donc ici la
        taille COURANTE (pas une valeur par défaut) pour ne pas écraser un
        changement de police fait entre-temps par l'utilisateur."""
        super().showEvent(event)
        self.appliquer_taille_police(self._taille_police_courante)

    # ------------------------------------------------------------------
    # Numérotation de ligne PAR CELLULE (demande explicite utilisateur,
    # cf. docstring de LineNumberArea) -- pattern Qt standard ("Code Editor
    # Example") : une marge gauche dédiée, jamais peinte à l'intérieur du
    # texte lui-même.
    # ------------------------------------------------------------------
    def line_number_area_width(self) -> int:
        """Largeur en pixels de la marge, dépendante du nombre de chiffres
        du plus grand numéro de ligne actuellement affiché (une cellule de
        3 lignes n'a besoin que d'1 chiffre de large, une cellule de 120
        lignes en a besoin de 3) -- recalculée à chaque changement de
        blockCount() (cf. _mettre_a_jour_largeur_zone_numeros), jamais figée
        à une largeur fixe qui gâcherait de l'espace pour les petites
        cellules ou tronquerait les numéros des grandes."""
        nb_chiffres = len(str(max(1, self.blockCount())))
        # PATCH8 : mémo (nb de chiffres, police) -> largeur. QFont se compare
        # en O(1) ; un changement de police (setFont, repolish QSS) invalide
        # donc le mémo tout seul, sans dépendre d'un événement.
        police = self.font()
        memo = getattr(self, "_memo_largeur_numeros", None)
        if memo is not None and memo[0] == nb_chiffres and memo[1] == police:
            return memo[2]
        # 3px de marge de chaque côté du chiffre le plus large pour rester
        # lisible sans coller au texte de code juste à droite.
        largeur = 6 + self.fontMetrics().horizontalAdvance("9") * nb_chiffres
        self._memo_largeur_numeros = (nb_chiffres, police, largeur)
        return largeur

    def _mettre_a_jour_largeur_zone_numeros(self, _nb_blocs: int = 0):
        """Connecté à blockCountChanged -- setViewportMargins réserve la
        place à GAUCHE du texte réel pour que la zone de numéros ne
        recouvre jamais le code (contrairement à un simple widget flottant
        par-dessus, qui masquerait les premiers caractères de chaque
        ligne)."""
        largeur = self.line_number_area_width()
        # PATCH8 : setViewportMargins déclenche un relayout du viewport ; inutile
        # (et appelé à chaque repeinte complète) quand la marge est déjà bonne.
        if self.viewportMargins().left() != largeur:
            self.setViewportMargins(largeur, 0, 0, 0)

    def _mettre_a_jour_zone_numeros(self, rect: QRect, dy: int):
        """Connecté à updateRequest (émis par QPlainTextEdit à chaque
        défilement ET à chaque frappe qui modifie la zone visible) --
        fait défiler ou repeindre la marge en cohérence avec le texte,
        exactement comme le fait l'exemple officiel Qt. dy != 0 lors d'un
        défilement vertical (scroll(0, dy) déplace la zone déjà peinte au
        lieu d'un repaint complet, plus fluide) ; sinon, seule la portion
        rect a besoin d'être repeinte (ex: une seule ligne modifiée)."""
        if dy:
            self._zone_numeros_lignes.scroll(0, dy)
        else:
            self._zone_numeros_lignes.update(0, rect.y(), self._zone_numeros_lignes.width(), rect.height())
        if rect.contains(self.viewport().rect()):
            self._mettre_a_jour_largeur_zone_numeros()

    def resizeEvent(self, event):
        """Doit suivre le redimensionnement de l'éditeur (largeur de la
        cellule qui change avec la fenêtre, cf. FlowGrid/notebook
        responsive) -- la zone de numéros garde toujours la pleine hauteur
        du viewport, collée au bord gauche.

        BUGFIX WRAP (retour à la ligne cassé, constaté par l'utilisateur :
        le texte débordait au lieu de revenir à la ligne) : en mode
        WidgetWidth, document().size().height() dépend de la LARGEUR
        actuelle du viewport au moment du calcul (cf. docstring
        _ajuster_hauteur) -- donc dès que cette largeur change (fenêtre
        redimensionnée, panneau latéral ouvert/fermé, ou même la toute
        première mise en page où la largeur définitive de la cellule n'est
        connue qu'après ce resizeEvent), la hauteur figée par
        setFixedHeight() devient fausse : trop petite, ce qui tronque
        visuellement les lignes wrappées au lieu d'étirer la cellule vers
        le bas comme attendu. Il faut donc réappeler _ajuster_hauteur()
        ICI, après le changement de largeur, pas seulement à la frappe."""
        super().resizeEvent(event)
        rect_contenu = self.contentsRect()
        self._zone_numeros_lignes.setGeometry(
            QRect(rect_contenu.left(), rect_contenu.top(), self.line_number_area_width(), rect_contenu.height())
        )
        if self.lineWrapMode() != QPlainTextEdit.NoWrap:
            # PATCH8 : seule une variation de LARGEUR change le retour à la
            # ligne (le resizeEvent provoqué par setFixedHeight ne change que
            # la hauteur), et pendant une mise en page la largeur bouge
            # plusieurs fois de suite : on ne mesure qu'à la dernière.
            if event.oldSize().width() != event.size().width():
                self._planifier_ajustement_hauteur()

    def _peindre_numeros_lignes(self, event):
        """Dessine effectivement les numéros -- appelé par
        LineNumberArea.paintEvent (délégation, cf. docstring de cette
        classe). Ne peint QUE les blocs réellement visibles dans le
        viewport (boucle bornée par event.rect().bottom()), jamais tout le
        document d'un coup -- important pour rester performant même sur
        une cellule de plusieurs centaines de lignes.

        blockNumber() est TOUJOURS relatif au document de CETTE cellule
        (base 0, +1 pour l'affichage humain) -- cf. docstring de
        LineNumberArea : c'est ce qui garantit nativement que la
        numérotation recommence à 1 à chaque cellule, sans le moindre
        calcul de décalage ici."""
        painter = QPainter(self._zone_numeros_lignes)
        painter.fillRect(event.rect(), QColor(DarculaTheme.fond_ligne_courante))
        bloc = self.firstVisibleBlock()
        numero_bloc = bloc.blockNumber()
        haut = int(self.blockBoundingGeometry(bloc).translated(self.contentOffset()).top())
        bas = haut + int(self.blockBoundingRect(bloc).height())
        couleur_numero = QColor(DarculaTheme.commentaire)
        while bloc.isValid() and haut <= event.rect().bottom():
            if bloc.isVisible() and bas >= event.rect().top():
                texte_numero = str(numero_bloc + 1)
                painter.setPen(couleur_numero)
                painter.drawText(
                    0, haut, self._zone_numeros_lignes.width() - 6, self.fontMetrics().height(),
                    Qt.AlignRight, texte_numero,
                )
            bloc = bloc.next()
            haut = bas
            bas = haut + int(self.blockBoundingRect(bloc).height())
            numero_bloc += 1
        painter.end()

    # ------------------------------------------------------------------
    # Retour à la ligne (demande explicite utilisateur, bouton dans la
    # toolbar principale de TaskConfigScreen -- cf.
    # TaskConfigScreen._sur_clic_retour_ligne, qui appelle cette méthode
    # sur TOUTES les cellules du notebook d'un coup).
    # ------------------------------------------------------------------
    def definir_retour_a_la_ligne(self, actif: bool):
        """Bascule le mode de retour à la ligne. WidgetWidth (au lieu de
        NoWrap) fait revenir le texte à la ligne suivante à la largeur du
        viewport, sans jamais faire apparaître de scrollbar horizontale --
        même esprit que le comportement existant "pas de scrollbar
        interne, la cellule grandit avec son contenu", juste étendu au
        sens horizontal désormais géré par le retour à la ligne plutôt que
        par un défilement latéral cf. _ajuster_hauteur, qui recalcule la
        hauteur différemment selon ce mode (une ligne logique peut occuper
        plusieurs lignes visuelles une fois le wrap actif).

        BUGFIX (constaté par l'utilisateur captures à l'appui : le texte
        wrappe bien VISUELLEMENT à l'intérieur de la cellule -- Qt dessine
        correctement le retour à la ligne dans le viewport -- mais la
        CELLULE elle-même ne s'agrandit pas, donc les lignes wrappées
        supplémentaires restent invisibles/coupées en bas). Cause réelle :
        _ajuster_hauteur() fixe maintenant elle-même explicitement la
        largeur du document via setTextWidth(viewport().width()) avant de
        lire sa hauteur (cf. cette méthode), ce qui règle le cas normal de
        façon synchrone, sans dépendre d'un relayout automatique différé
        de Qt. Le seul angle mort restant est le tout premier appel ici :
        juste après setLineWrapMode(), self.viewport().width() peut ne
        pas encore refléter sa taille finale si la cellule elle-même est
        encore en cours de mise en page (ex. notebook qui vient de
        s'afficher) -- QTimer.singleShot(0, ...) reprogramme donc un
        second passage juste après que Qt ait fini ce cycle de layout,
        une fois que viewport().width() est fiable à 100% -- même pattern
        déjà utilisé ailleurs dans ce fichier pour ce type de situation
        (cf. FlowGrid._relayout, recherche "QTimer.singleShot(0,")."""
        self.setLineWrapMode(QPlainTextEdit.WidgetWidth if actif else QPlainTextEdit.NoWrap)
        # Le mode de wrap fait partie de la clé du mémo de hauteur (cf.
        # _ajuster_hauteur), donc une bascule serait déjà correctement
        # détectée. On invalide quand même explicitement : c'est le seul
        # endroit du fichier qui change ce mode, et un mémo purgé ici
        # garantit que la toute première mesure après bascule est faite
        # sur la géométrie réelle du nouveau mode, sans aucune dépendance
        # à ce que valait la clé précédente.
        self._cache_hauteur_wrap = None
        self._ajuster_hauteur()
        QTimer.singleShot(0, self._ajuster_hauteur)

    # Doit correspondre exactement au padding CSS de #TaskScriptEditor
    # (cf. feuille de style) : QPlainTextEdit stylé applique son padding via
    # viewportMargins en interne, PAS via contentsMargins() -- contentsMargins()
    # renvoie 0 même avec un padding CSS non nul, d'où un calcul de hauteur
    # qui sous-estimait l'espace réel et tronquait visuellement le texte.
    _PADDING_VERTICAL_CSS = 10

    # PATCH7 : garde de réentrance (voir docstring de patch7.py).
    _ajustement_en_cours = False
    _ajustement_redemande = False

    # PATCH8 : regroupement des demandes issues de resizeEvent.
    _ajustement_differe_planifie = False

    def _planifier_ajustement_hauteur(self):
        if self._ajustement_differe_planifie:
            return
        self._ajustement_differe_planifie = True
        try:
            # Forme (délai, contexte, rappel) : annulée si l'éditeur est détruit.
            QTimer.singleShot(0, self, self._executer_ajustement_differe)
        except Exception:
            self._ajustement_differe_planifie = False
            self._ajuster_hauteur()   # repli : comportement d'avant le patch

    def _executer_ajustement_differe(self):
        self._ajustement_differe_planifie = False
        self._ajuster_hauteur()

    _hauteur_obsolete = False

    def _ajuster_hauteur(self, *_args):
        # PATCH9 : un éditeur non affiché n'a pas de largeur de viewport
        # fiable et sera de toute façon remesuré au showEvent.
        if (not self._mode_editeur_pleine_hauteur
                and self.lineWrapMode() != QPlainTextEdit.NoWrap
                and not self.isVisible()):
            self._hauteur_obsolete = True
            return
        self._hauteur_obsolete = False
        if self._ajustement_en_cours:
            # Appel déclenché PAR le calcul en cours (documentSizeChanged,
            # resizeEvent consécutif à setFixedHeight...) : on le mémorise.
            self._ajustement_redemande = True
            return
        self._ajustement_en_cours = True
        try:
            for _passe in range(3):
                self._ajustement_redemande = False
                self._ajuster_hauteur_impl()
                if not self._ajustement_redemande:
                    break
        finally:
            self._ajustement_en_cours = False

    def _ajuster_hauteur_impl(self):
        """Recalcule la hauteur de la cellule pour qu'elle épouse
        exactement son contenu (padding CSS + bordure inclus), sans
        scrollbar interne -- appelé à chaque frappe et à chaque changement
        de police.

        IMPORTANT : en mode NoWrap (par défaut), on calcule à partir de
        blockCount() * lineSpacing(), PAS de document().size().height().
        Ce dernier ne renvoie pas une hauteur en pixels pour un
        QPlainTextEdit tant qu'aucune largeur de document n'a été fixée
        explicitement (setTextWidth) -- il renvoie en pratique le nombre de
        blocs (1, 2, 3...), quasi identique pour 1 ligne ou 5 lignes une
        fois arrondi par le max() de sécurité. C'est ce qui produisait des
        cellules de hauteur quasi identique peu importe le nombre de lignes
        de code (bug constaté). Vérifié empiriquement :
        document().size().height() valait 1.0/2.0/3.0/5.0 pour 1/2/3/5
        lignes -- des blocs, pas des pixels.

        BUGFIX WRAP (demande utilisateur : retour à la ligne) : blockCount()
        cesse d'être fiable dès que le wrap est actif -- une SEULE ligne
        logique trop longue pour la largeur de la cellule occupe alors
        PLUSIEURS lignes visuelles, que blockCount() ne compte jamais (il
        ne compte que les blocs/paragraphes réels, jamais les lignes
        visuelles wrappées à l'intérieur d'un même bloc). Utiliser
        blockCount() * lineSpacing() en mode wrap sous-estimerait donc la
        hauteur réelle et tronquerait le bas des lignes wrappées. En mode
        WidgetWidth, la largeur du document EST correctement synchronisée
        par Qt à la largeur du viewport (contrairement au cas NoWrap
        documenté ci-dessus, où aucune largeur n'est jamais fixée) --
        document().size().height() redevient alors une vraie mesure en
        pixels, lignes visuelles wrappées incluses, et c'est cette valeur
        qu'on utilise dans ce mode.

        BUGFIX (constaté par l'utilisateur : le texte wrappe bien
        visuellement mais la cellule ne s'agrandit pas) : la synchro
        automatique de la largeur du document sur celle du viewport en
        mode WidgetWidth n'est pas toujours instantanée -- Qt la fait
        généralement au prochain cycle de layout/peinture, pas au moment
        exact où setLineWrapMode() est appelé. Résultat : un appel à
        _ajuster_hauteur() juste après avoir activé le wrap pouvait lire
        document().size().height() AVANT que cette synchro n'ait eu lieu,
        et récupérer une hauteur encore basée sur l'ancienne largeur (donc
        trop petite). Pour ne plus dépendre de ce timing, on fixe
        nous-mêmes explicitement la largeur du document AVANT de lire sa
        hauteur, via setTextWidth() sur le layout du document -- c'est la
        façon robuste et synchrone documentée par Qt pour obtenir une
        mesure fiable de document().size(), qui ne dépend d'aucun cycle
        d'affichage préalable. On utilise viewport().width() (l'espace
        RÉELLEMENT disponible pour le texte, après retrait de la zone de
        numéros de ligne via setViewportMargins -- cf. __init__), pas
        BUGFIX WRAP #2 (constaté par l'utilisateur, captures à l'appui :
        le wrap est ACTIF -- le texte revient bien à la ligne à l'écran
        -- mais la hauteur de la cellule reste calculée pour BEAUCOUP
        moins de lignes que ce qui est réellement affiché, laissant un
        vide en bas de certaines cellules et tronquant potentiellement
        d'autres). CAUSE RÉELLE, différente de tout ce que documentaient
        les BUGFIX précédents ci-dessus : un QPlainTextEdit n'utilise
        PAS un QTextDocumentLayout standard mais un
        QPlainTextDocumentLayout dédié, qui IGNORE silencieusement
        document().setTextWidth() appelé manuellement comme ci-dessus --
        document().size().height() continue de renvoyer une valeur basée
        sur le nombre de BLOCS (paragraphes), pas de lignes visuelles
        wrappées, peu importe setTextWidth(). Vérifié empiriquement :
        pour un texte de 3 lignes logiques dont une wrappe sur 4 lignes
        visuelles (donc 6 lignes visuelles au total), document().size().
        height() valait 7.0 (proche du nombre de BLOCS, pas de lignes)
        quand la somme des blockBoundingRect() de chaque bloc valait
        165.0 -- soit la vraie hauteur en pixels, cohérente avec
        fontMetrics().lineSpacing() (22px/ligne visuelle). C'est
        exactement la même API déjà utilisée par _peindre_numeros_lignes
        un peu plus haut dans cette classe pour peindre les numéros de
        ligne au bon endroit -- elle EST fiable pour un QPlainTextEdit,
        contrairement à document().size().height()."""
        if self._mode_editeur_pleine_hauteur:
            # cf. activer_mode_editeur_pleine_hauteur() -- aucun
            # setFixedHeight() dans ce mode, la hauteur est pilotée par le
            # layout parent (Expanding), pas par le contenu.
            return

        # ------------------------------------------------------------------
        # CORRECTIF PRINCIPAL du blocage de ~40 s à l'ouverture d'un Task
        # (SPEC_patch_ouverture_task.md : c'est la cause "H4, non
        # identifiée" -- ni H1 ni H2 ni H3).
        #
        # CE QUI A ÉTÉ MESURÉ (banc reproduisant cette classe avec la vraie
        # feuille de style et le vrai PythonHighlighter, temps de
        # stack.setCurrentWidget sur la 2e ouverture) :
        #
        #     cellules x lignes   NoWrap    retour à la ligne
        #     2 x  40              16 ms         123 ms
        #     2 x 200              57 ms       2 437 ms
        #     2 x 600             179 ms      21 057 ms
        #     6 x 600             297 ms      48 888 ms   <-- les 42 s du log
        #
        # POURQUOI. En mode retour-à-la-ligne, cette méthode ne peut pas
        # utiliser blockCount() (cf. BUGFIX WRAP ci-dessus) : elle doit
        # parcourir TOUS les blocs du document et sommer leurs
        # blockBoundingRect(), ce qui force Qt à en refaire la mise en page.
        # Le coût d'UN appel est donc proportionnel à la taille du document.
        # Or elle n'est pas appelée une fois : elle est branchée sur
        # documentSizeChanged ET blockCountChanged, rappelée par
        # resizeEvent à chaque changement de largeur, et par
        # appliquer_taille_police à chaque showEvent -- et chaque
        # setFixedHeight() qu'elle pose invalide le layout parent, ce qui
        # provoque une nouvelle passe de mise en page, donc de nouveaux
        # resizeEvent, donc de nouveaux appels. Compté au banc : 3 584
        # appels pour 6 cellules. Coût total = appels x blocs : quadratique.
        # En NoWrap le calcul est une simple multiplication, d'où l'écart.
        #
        # LE CONSTAT QUI DÉBLOQUE : sur ces 3 584 appels, 3 549 (99 %)
        # recalculaient une hauteur STRICTEMENT IDENTIQUE à la précédente,
        # parce que rien de ce dont elle dépend n'avait changé. On mémorise
        # donc le résultat, indexé par TOUT ce qui peut le faire varier :
        #
        #   - lineWrapMode()          : NoWrap et wrap ne donnent pas la
        #                               même hauteur pour le même texte ;
        #   - viewport().width()      : c'est la largeur de wrap ;
        #   - document().revision()   : incrémentée par Qt à chaque
        #                               modification du contenu ;
        #   - blockCount() ET characterCount() : INDISPENSABLES, et pas
        #                               redondants avec revision(). Piège
        #                               vérifié au banc : setPlainText()
        #                               n'incrémente la révision qu'UNE
        #                               fois pour toute l'opération, alors
        #                               qu'elle passe par un état
        #                               intermédiaire (document vidé,
        #                               1 bloc) AVANT d'insérer le nouveau
        #                               texte -- et _ajuster_hauteur est
        #                               appelée dans cet état intermédiaire
        #                               comme après. Avec la seule
        #                               révision, la hauteur du document
        #                               VIDE était mémorisée puis
        #                               ré-appliquée au document plein :
        #                               68 px au lieu de 2448. Ces deux
        #                               compteurs, en O(1) sur
        #                               QTextDocument, distinguent sans
        #                               ambiguïté les états successifs
        #                               d'une même révision ;
        #   - font().toString()       : famille + taille + style, dont
        #                               dépendent lineSpacing() et la mise
        #                               en page des blocs ;
        #   - frameWidth()            : entre dans la formule finale et
        #                               peut bouger à un repolish QSS.
        #
        # Quand la clé est inchangée, on NE RECALCULE PAS -- mais on
        # réapplique quand même la hauteur mémorisée via la garde
        # habituelle en fin de méthode. Ce point est important : si autre
        # chose a modifié la hauteur entre-temps (bascule de mode,
        # activer_mode_editeur_pleine_hauteur, setFixedHeight externe), on
        # reconverge vers la bonne valeur sans payer le parcours des blocs.
        # Le résultat observable est donc identique à la version d'avant,
        # à la seule différence qu'on ne recalcule plus ce qui est déjà
        # connu.
        #
        # Mesure après correctif : 48 888 ms -> 721 ms (6 cellules x 600
        # lignes), 21 057 ms -> 421 ms (2 x 600).
        # ------------------------------------------------------------------
        cle_hauteur = None
        if self.lineWrapMode() != QPlainTextEdit.NoWrap:
            document = self.document()
            cle_hauteur = (
                self.lineWrapMode(),  # QPlainTextEdit.LineWrapMode : comparable tel quel
                self.viewport().width(),
                document.revision(),
                document.blockCount(),
                document.characterCount(),
                self.font().toString(),
                self.frameWidth(),
            )
            memo = self._cache_hauteur_wrap
            if memo is not None and memo[0] == cle_hauteur:
                if self.height() != memo[1]:
                    self.setFixedHeight(memo[1])
                return

        if self.lineWrapMode() == QPlainTextEdit.NoWrap:
            nb_lignes = max(1, self.blockCount())
            hauteur_contenu = nb_lignes * self.fontMetrics().lineSpacing()
        else:
            largeur_viewport = max(1, self.viewport().width())
            self.document().setTextWidth(largeur_viewport)
            hauteur_blocs = 0.0
            bloc = self.document().begin()
            while bloc.isValid():
                hauteur_blocs += self.blockBoundingRect(bloc).height()
                bloc = bloc.next()
            hauteur_contenu = max(
                self.fontMetrics().lineSpacing(),
                int(hauteur_blocs),
            )
        hauteur = int(
            hauteur_contenu
            + 2 * self._PADDING_VERTICAL_CSS
            + 2 * self.frameWidth()
            + 2  # bordure CSS (1px, cf. #TaskScriptEditor)
        )
        # Garde : ne réappliquer setFixedHeight() que si la valeur change
        # réellement. setFixedHeight() redéclenche un resizeEvent (cf.
        # resizeEvent ci-dessus, qui rappelle _ajuster_hauteur() en mode
        # wrap) -- sans cette garde, chaque appel réappellerait
        # inconditionnellement setFixedHeight() même à valeur identique,
        # ce qui redéclencherait un resizeEvent en boucle (Qt ne filtre
        # PAS automatiquement les appels à taille inchangée)."""
        if cle_hauteur is not None:
            self._cache_hauteur_wrap = (cle_hauteur, hauteur)
        if self.height() != hauteur:
            self.setFixedHeight(hauteur)

    # ------------------------------------------------------------------
    # Mode "éditeur plein-écran" (GitScreen -- demande explicite
    # utilisateur : "je veux que la hauteur de la cellule reste maximal
    # ... sa doit etre un editeur"), par opposition au mode "cellule
    # notebook" par défaut (hauteur épouse le contenu, cf.
    # _ajuster_hauteur ci-dessus). N'affecte QUE l'instance sur laquelle
    # elle est appelée -- TaskConfigScreen n'appelle jamais cette méthode,
    # donc aucune vraie cellule de notebook n'est concernée.
    # ------------------------------------------------------------------
    def activer_mode_editeur_pleine_hauteur(self):
        self._mode_editeur_pleine_hauteur = True
        # Le mémo de hauteur (cf. _ajuster_hauteur) n'a plus aucun sens
        # dans ce mode : la hauteur n'est plus pilotée par le contenu.
        self._cache_hauteur_wrap = None
        # setMaximumHeight(16777215) annule tout setFixedHeight() déjà
        # posé par un _ajuster_hauteur() antérieur à cet appel (setFixed
        # Height fige à la fois min ET max -- QWIDGETSIZE_MAX est la
        # constante Qt qui retire la borne max sans toucher à minimumHeight,
        # laissée à 0 par défaut).
        self.setMinimumHeight(0)
        self.setMaximumHeight(16777215)
        self.setSizePolicy(QSizePolicy.Expanding, QSizePolicy.Expanding)
        self.setVerticalScrollBarPolicy(Qt.ScrollBarAsNeeded)

    # ------------------------------------------------------------------
    # Taille de police (config utilisateur, cf. ReglagesApp)
    # ------------------------------------------------------------------
    def appliquer_taille_police(self, taille_pt: int, forcer: bool = False):
        """Applique une nouvelle taille de police à chasse fixe (bornée
        8-24pt côté appelant, ParametresScreen). Recalcule aussi la
        tabulation (4 espaces) car sa largeur en pixels dépend de la police,
        et réajuste la hauteur de la cellule (mode notebook) car elle
        dépend elle aussi de la hauteur d'une ligne.

        IMPORTANT : ensurePolished() encadre setFont() ci-dessous. Sans ça,
        la règle CSS globale "QWidget { font-family: 'Segoe UI'; font-size:
        13px; }" (cf. build_stylesheet) écrase silencieusement setFont() au
        prochain repolish Qt (déclenché par n'importe quel événement de
        style ultérieur) -- observé concrètement : font().pointSize()
        valait -1 et family() restait "Segoe UI" au lieu de Consolas à la
        taille demandée, alors même que setFont() avait bien été appelé.
        C'est pour ça qu'incrémenter/décrémenter le spinbox "réparait"
        temporairement l'affichage : ça réappliquait setFont() juste après
        un repolish, gagnant la course jusqu'au repolish suivant. Le
        ensurePolished() force Qt à synchroniser immédiatement l'état du
        widget avec le style courant, ce qui rend le setFont() qui suit
        réellement définitif.

        OPTIMISATION (SPEC_patch_ouverture_task.md §8, "pourquoi
        stack.setCurrentWidget coûte déjà ~1,5 s en 1re ouverture pour 2
        cellules") -- SORTIE ANTICIPÉE ci-dessous.

        Le problème mesuré : showEvent() rappelle cette méthode À CHAQUE
        AFFICHAGE de l'éditeur, et elle refaisait alors systématiquement
        2 ensurePolished() + 1 setFont() + 1 setTabStopDistance() + 1
        _ajuster_hauteur(). Or ensurePolished() et setFont() sont, de
        loin, les opérations les plus chères de tout l'écran : la feuille
        de style globale fait ~75 000 caractères pour ~347 règles (cf.
        build_stylesheet), et QStyleSheetStyle réévalue cet ensemble de
        règles contre le widget ET tout son sous-arbre à chaque polish /
        changement de police. Multiplié par le nombre d'éditeurs affichés,
        c'est le gros du temps passé dans stack.setCurrentWidget.

        Ce travail n'a de sens qu'une fois : le jour où la règle CSS
        globale a effectivement écrasé la police. On teste donc
        EXACTEMENT ce symptôme -- font().family() retombé sur "Segoe UI"
        et/ou pointSize() qui ne vaut plus la taille demandée (typiquement
        -1, cf. le constat ci-dessus) -- et on ne repaie le polish que
        dans ce cas. Si la police en place est déjà la bonne, il n'y a
        rien à réparer et on sort.

        Le comportement observable est strictement identique : on ne
        court-circuite que des appels dont le résultat est déjà acquis.
        `forcer=True` permet de réappliquer inconditionnellement si un
        appelant futur en a besoin.

        _ajuster_hauteur() reste appelée dans les DEUX cas : elle est
        gardée par `if self.height() != hauteur` (cf. sa fin), donc elle
        ne déclenche aucun relayout quand rien n'a bougé, et la sauter
        ferait courir le risque d'une cellule affichée à une hauteur
        périmée après un changement de largeur."""
        taille_pt = max(8, min(24, taille_pt))
        self._taille_police_courante = taille_pt
        police_en_place = self.font()
        if (not forcer
                and police_en_place.family() == "Consolas"
                and police_en_place.pointSize() == taille_pt):
            self._ajuster_hauteur()
            return
        police = QFont("Consolas", taille_pt)
        police.setStyleHint(QFont.Monospace)
        self.ensurePolished()
        self.setFont(police)
        self.ensurePolished()
        self.setTabStopDistance(4 * self.fontMetrics().horizontalAdvance(" "))
        self._ajuster_hauteur()

    # ------------------------------------------------------------------
    # Composants connus (pour coloration ET auto-complétion) -- mis à jour
    # par TaskConfigScreen à chaque ouverture de Task / import de ServiceAPI.
    # ------------------------------------------------------------------
    def definir_composants_connus(self, noms_variables: list):
        self._noms_connus_appliques = None
        self._composants_connus = set(noms_variables)
        self._highlighter.definir_composants_connus(noms_variables)

    def definir_composants_layout_connus(self, noms_variables: list):
        """AJOUT -- symétrique de definir_composants_connus ci-dessus,
        pour les ComposantLayout (ex: "videoTemplateItems") plutôt que
        les ComposantSingle. Réutilise le MÊME highlighter/même regex de
        coloration que les composants (cf. PythonHighlighter.
        definir_composants_connus -- une seule catégorie visuelle
        "composant connu", pas de couleur séparée pour cL, cohérent avec
        le fait que ComposantLayoutExecutable est déjà traité comme
        symétrique de ComposantExecutable partout ailleurs dans ce
        fichier) : les deux listes de noms sont simplement FUSIONNÉES
        avant d'être transmises au highlighter -- ni l'une ni l'autre
        n'est écrasée par cet appel (cf. TaskConfigScreen.
        _rafraichir_composants_connus_editeur, qui appelle toujours les
        deux définitions ensemble avec l'union complète)."""
        self._noms_connus_appliques = None
        self._composants_layout_connus = set(noms_variables)
        self._highlighter.definir_composants_connus(list(self._composants_connus | self._composants_layout_connus))

    def definir_services_api_connus(self, noms_variables: list):
        """Met à jour _services_api_connus (ex: {"Word"}) -- utilisé à la
        fois pour la coloration syntaxique distincte (cf. highlighter) ET
        pour l'auto-complétion des instances (cf. _rescanner_instances_connues,
        qui a besoin de savoir quels noms à droite du "=" correspondent à un
        VRAI ServiceAPI importé, pas n'importe quel identifiant suivi de
        ".instance()")."""
        self._noms_connus_appliques = None
        self._services_api_connus = set(noms_variables)
        self._highlighter.definir_services_api_connus(noms_variables)
        self._rescanner_instances_connues()

    def definir_noms_connus_en_une_passe(self, noms_composants, noms_composants_layout, noms_services_api):
        """AJOUT (optimisation de l'ouverture d'un Task) : équivalent EXACT
        de l'appel successif de definir_composants_connus +
        definir_composants_layout_connus + definir_services_api_connus, mais
        avec UN SEUL rehighlight() au lieu de trois (cf.
        PythonHighlighter.definir_noms_connus_en_une_passe pour la mesure).

        Même état final que les trois setters : _composants_connus,
        _composants_layout_connus et _services_api_connus posés, regex du
        highlighter = union composants+layout / services, et
        _rescanner_instances_connues() rappelé en dernier (comme le fait
        definir_services_api_connus) puisque _instances_connues dépend de
        _services_api_connus."""
        # PATCH : mêmes noms que la dernière application -> rien à refaire (évite
        # un rehighlight() complet + rescan par cellule à chaque ouverture).
        _nouveaux = (frozenset(noms_composants), frozenset(noms_composants_layout), frozenset(noms_services_api))
        if getattr(self, "_noms_connus_appliques", None) == _nouveaux:
            return
        self._noms_connus_appliques = _nouveaux
        self._composants_connus = set(noms_composants)
        self._composants_layout_connus = set(noms_composants_layout)
        self._services_api_connus = set(noms_services_api)
        self._highlighter.definir_noms_connus_en_une_passe(
            list(self._composants_connus | self._composants_layout_connus),
            noms_services_api,
        )
        self._rescanner_instances_connues()

    def definir_variables_globales_connues(self, noms_variables: set):
        """Reçoit l'ensemble des noms de variable déclarés dans TOUTES les
        cellules du Task (cf. TaskConfigScreen.
        _rafraichir_variables_globales_editeur) -- fusionné avec
        _variables_connues (local à cette cellule) dans _proposer_variables,
        jamais utilisé seul."""
        self._variables_globales_connues = set(noms_variables)

    def definir_instances_globales_connues(self, noms_variables: set):
        """Reçoit l'ensemble des noms de variable "ma_var = NomServiceAPI.
        instance()" déclarés dans TOUTES les cellules du Task -- fusionné
        avec _instances_connues (local à cette cellule) dans
        _proposer_methodes, même principe que
        definir_variables_globales_connues ci-dessus."""
        self._instances_globales_connues = set(noms_variables)

    def definir_resultats_globaux_connus(self, noms_variables: set):
        """Reçoit l'ensemble des noms de variable "r = quelquechose.click(...)"
        (ou toute autre méthode de NOMS_METHODES_RETOURNANT_RESULTAT_ACTION)
        déclarés dans TOUTES les cellules du Task -- fusionné avec
        _resultats_connus (local à cette cellule) dans _proposer_methodes,
        même principe que definir_instances_globales_connues ci-dessus."""
        self._resultats_globaux_connus = set(noms_variables)

    # ------------------------------------------------------------------
    # Auto-complétion : détection du contexte "NomConnu." juste avant le
    # curseur, ouverture/fermeture du popup, navigation clavier.
    #
    # Deux familles de "noms connus" déclenchent le popup :
    #   - _composants_connus (ComposantExecutable) : noms FIXES, imposés
    #     par l'import du ServiceAPI (cf. definir_composants_connus) ->
    #     propose METHODES_COMPOSANT_EXECUTABLE.
    #   - _instances_connues (InstanceExecutable) : noms de VARIABLE
    #     choisis librement par l'utilisateur via
    #     "ma_variable = NomServiceAPI.instance()" -> détectés
    #     dynamiquement en scannant le texte de la cellule à chaque
    #     modification (cf. _rescanner_instances_connues) -> propose
    #     METHODES_INSTANCE_EXECUTABLE.
    #
    # AJOUT -- une TROISIÈME famille (demande explicite utilisateur :
    # "le resultat de chaque methode est un objet ... r. doit me
    # proposer les differentes variable") :
    #   - _resultats_connus (ResultatAction) : noms de VARIABLE choisis
    #     librement par l'utilisateur via "r = mon_composant.click(...)"
    #     ou "r = mon_instance.new_tab(...)" -- détectés dynamiquement,
    #     même mécanisme que _instances_connues (cf.
    #     _rescanner_instances_connues, qui peuple maintenant les DEUX
    #     ensembles en un seul passage) -> propose METHODES_RESULTAT_ACTION.
    # ------------------------------------------------------------------
    _REGEX_CONTEXTE_POINT = re.compile(r"([A-Za-z_][A-Za-z0-9_]*)\.([A-Za-z_][A-Za-z0-9_]*)?$")
    # Complétion de NOM DE VARIABLE (pas de méthode) : identifiant en cours
    # de frappe, PAS précédé d'un "." (sinon c'est le contexte ci-dessus
    # qui doit gérer -- appel de méthode, pas nom de variable). Le lookbehind
    # négatif "(?<!\.)" est la seule différence avec _REGEX_CONTEXTE_POINT ;
    # groupe unique = le préfixe déjà tapé (ex: "r" dans "resultat" en
    # cours d'écriture).
    _REGEX_CONTEXTE_MOT = re.compile(r"(?<!\.)\b([A-Za-z_][A-Za-z0-9_]*)$")
    # Capture "nom_variable = NomServiceAPI . instance ( )" -- espaces
    # optionnels autour du "=" et du ".", comme un utilisateur pourrait
    # raisonnablement les écrire. group(1) = nom de variable affecté,
    # group(2) = nom du ServiceAPI dont on appelle .instance().
    _REGEX_AFFECTATION_INSTANCE = re.compile(
        r"([A-Za-z_][A-Za-z0-9_]*)\s*=\s*([A-Za-z_][A-Za-z0-9_]*)\s*\.\s*instance\s*\(\s*\)"
    )

    # AJOUT -- capture les DEUX formes documentées dans _zones_connues
    # ci-dessus, permettant de reconnaître une variable comme provenant
    # d'une ZoneDetectee :
    #   Forme A (directe) : "z = videoTemplateItems.choose().nom_zone"
    #     group(1) = "z", group(2) = "videoTemplateItems" (doit être un
    #     ComposantLayout connu, cf. _composants_layout_connus),
    #     group(3) = "nom_zone" (non vérifié -- cf. docstring de
    #     _zones_connues, aucune liste de noms de zone possible ici).
    #   Forme B (en deux temps, via une InstanceLayoutDetectee
    #     intermédiaire) : "instance = monComposantLayout.choose()" PUIS
    #     "z = instance.nom_zone" -- gérée par un second passage plus bas
    #     dans _rescanner_zones_connues (nécessite d'abord de connaître
    #     les noms de variable "instance", pas capturable par une seule
    #     regex statique puisque le nom d'instance lui-même est libre).
    # Espaces optionnels autour de "=" et des ".", même convention que
    # _REGEX_AFFECTATION_INSTANCE.
    _REGEX_AFFECTATION_ZONE = re.compile(
        r"([A-Za-z_][A-Za-z0-9_]*)\s*=\s*([A-Za-z_][A-Za-z0-9_]*)\s*\.\s*choose\s*\([^)]*\)\s*\.\s*([A-Za-z_][A-Za-z0-9_]*)"
    )
    # Forme B ci-dessus, étape 1 : "instance = monComposantLayout.choose()"
    # (SANS ".nom_zone" à la suite -- juste l'InstanceLayoutDetectee brute).
    # group(1) = nom de variable affecté, group(2) = nom du ComposantLayout.
    _REGEX_AFFECTATION_INSTANCE_LAYOUT = re.compile(
        r"([A-Za-z_][A-Za-z0-9_]*)\s*=\s*([A-Za-z_][A-Za-z0-9_]*)\s*\.\s*choose\s*\([^)]*\)\s*(?!\.\s*[A-Za-z_])"
    )
    # Forme B, étape 2 : "z = instance.nom_zone" où "instance" est un nom
    # de variable déjà reconnu comme InstanceLayoutDetectee à l'étape 1
    # (vérifié dans _rescanner_zones_connues, pas ici -- cette regex se
    # contente d'isoler la forme générale "a = b.c", volontairement large
    # puisque le filtrage sémantique se fait ensuite sur group(2)).
    _REGEX_AFFECTATION_ATTRIBUT_SIMPLE = re.compile(
        r"([A-Za-z_][A-Za-z0-9_]*)\s*=\s*([A-Za-z_][A-Za-z0-9_]*)\s*\.\s*([A-Za-z_][A-Za-z0-9_]*)\s*$"
    )

    # AJOUT -- noms de TOUTES les méthodes qui retournent un
    # ResultatAction (cf. leurs classes plus haut dans ce fichier) :
    # les 9 méthodes "action" de ComposantExecutable (tout SAUF visible(),
    # qui retourne bool) + new_tab()/mouse_move() de InstanceExecutable
    # (seules méthodes de cette classe qui retournent un ResultatAction --
    # les autres lèvent une exception ou retournent un type simple
    # str/bool/tuple, cf. capture()/get_presse_papier()/tab_accueil()/
    # est_interface_initialisee()/position_aleatoire()). Utilisé par
    # _REGEX_AFFECTATION_RESULTAT juste en dessous ET par
    # _rescanner_instances_connues pour valider qu'un ".methode(" repéré
    # correspond bien à une méthode connue plutôt qu'un nom arbitraire.
    NOMS_METHODES_RETOURNANT_RESULTAT_ACTION = frozenset({
        "click", "mousemove", "move_cursor", "scroll", "paste", "clear",
        "saisir", "drag", "drop", "glisser_souris", "new_tab", "mouse_move", "click_element", "remplir",
    })
    # Capture "nom_variable = quelquechose . nom_methode ( ... )" où
    # nom_methode fait partie de NOMS_METHODES_RETOURNANT_RESULTAT_ACTION
    # -- espaces optionnels autour du "=" et du ".", comme
    # _REGEX_AFFECTATION_INSTANCE ci-dessus. "quelquechose" n'est PAS
    # vérifié ici (pourrait être un composant, une instance, ou même une
    # variable quelconque qui porterait par coïncidence une méthode de ce
    # nom) -- volontairement permissif, dans le même esprit que
    # _rescanner_variables_connues (proposer plutôt que sur-filtrer) :
    # mieux vaut proposer .statut/.message/.tab_id sur un faux positif
    # rare que ne jamais les proposer sur un vrai positif à cause d'un
    # composant/instance mal détecté par ailleurs. Le contenu des
    # parenthèses n'est PAS capturé (juste consommé par ".*?", non
    # gourmand, laissant la parenthèse fermante fermer l'appel) --
    # peu importe les arguments passés, seul le nom de la méthode compte
    # ici. group(1) = nom de variable affecté, group(2) = nom de la
    # méthode appelée.
    _REGEX_AFFECTATION_RESULTAT = re.compile(
        r"([A-Za-z_][A-Za-z0-9_]*)\s*=\s*[A-Za-z_][A-Za-z0-9_]*\s*\.\s*"
        r"(" + "|".join(re.escape(n) for n in sorted(NOMS_METHODES_RETOURNANT_RESULTAT_ACTION)) + r")"
        r"\s*\([^)]*\)"
    )

    # PATCH (retour utilisateur : "pourquoi il n'y a pas d'auto
    # completion qui fonctionne pour les objet retourner par la methode
    # screenshot()") -- même patron EXACT que NOMS_METHODES_RETOURNANT_
    # RESULTAT_ACTION/_REGEX_AFFECTATION_RESULTAT ci-dessus, mais pour
    # les méthodes qui retournent un objet Image (cf. sa classe) plutôt
    # qu'un ResultatAction. screenshot() est pour l'instant la SEULE
    # méthode de ce genre (ComposantSingleExecutable.screenshot() ET
    # ZoneDetectee.screenshot(), même nom sur les deux classes) -- gardé
    # sous forme de frozenset (plutôt qu'une simple chaîne) pour rester
    # extensible de la même façon que son équivalent RESULTAT_ACTION, si
    # une autre méthode Image venait à s'ajouter plus tard.
    NOMS_METHODES_RETOURNANT_IMAGE = frozenset({"screenshot"})
    _REGEX_AFFECTATION_IMAGE = re.compile(
        r"([A-Za-z_][A-Za-z0-9_]*)\s*=\s*[A-Za-z_][A-Za-z0-9_]*\s*\.\s*"
        r"(" + "|".join(re.escape(n) for n in sorted(NOMS_METHODES_RETOURNANT_IMAGE)) + r")"
        r"\s*\([^)]*\)"
    )

    # Repère tout nom de variable Python DÉCLARÉ quelque part dans la
    # cellule, toutes formes courantes confondues -- pas seulement
    # "nom = ..." (décision explicite utilisateur : "il doit y avoir des
    # suggestions pour chaque variable déjà écrite", donc peu importe la
    # forme de déclaration, le nom doit être proposable ensuite) :
    #   - affectation simple/multiple : "resultat = ...", "a = b = ..."
    #   - boucle for : "for item in ...", "for cle, valeur in ...items()"
    #   - contexte with...as : "with X() as f"
    #   - exception as : "except ValueError as e"
    #   - paramètre de fonction : "def f(a, b=1, *args, **kwargs)"
    # Volontairement une regex simple par ligne (même esprit que le reste
    # de cet éditeur, cf. PythonHighlighter) plutôt qu'un vrai parseur ast
    # : suffisant pour proposer des noms, pas besoin de comprendre la
    # sémantique complète du script pour ça.
    _REGEX_DECLARATION_VARIABLE = re.compile(
        # Groupe 1 : chaîne d'affectations "a = b = c = ..." (une ou
        # plusieurs cibles séparées par "=", chacune éventuellement une
        # affectation multiple "a, b = ..."). Le "(?!=)" final exclut "=="
        # (comparaison, pas déclaration). Le bloc capturé se termine juste
        # avant la valeur assignée -- cf. _rescanner_variables_connues qui
        # le redécoupe sur "=" pour en extraire chaque nom de cible.
        r"^\s*((?:[A-Za-z_][A-Za-z0-9_]*(?:\s*,\s*[A-Za-z_][A-Za-z0-9_]*)*\s*=\s*)+)(?!=)"
        r"|^\s*for\s+([A-Za-z_][A-Za-z0-9_]*(?:\s*,\s*[A-Za-z_][A-Za-z0-9_]*)*)\s+in\b"
        r"|\bas\s+([A-Za-z_][A-Za-z0-9_]*)\b"
        # Groupes 4 (paramètres) + 5 (nom de la fonction), dans la MÊME
        # branche "def" -- BUGFIX (retour utilisateur : "l'auto complétion
        # ne prend pas en charge les fonctions définies par l'utilisateur") :
        # une regex alternée par "|" s'arrête à la PREMIÈRE branche qui
        # matche à une position donnée -- avoir eu deux branches "def"
        # séparées (une pour le nom, une pour les paramètres) aurait fait
        # que seule la première des deux matchait jamais, l'autre n'étant
        # plus jamais essayée à cette même position. D'où un seul "def
        # nom(params)" avec les deux capturés ensemble.
        r"|^\s*def\s+([A-Za-z_][A-Za-z0-9_]*)\s*\(([^)]*)\)",
        re.MULTILINE,
    )
    # Sépare les paramètres d'une signature "def f(...)" déjà isolée par
    # la regex ci-dessus (groupe 4) -- ignore *args/**kwargs (préfixe "*"
    # gardé tel quel puis nettoyé) et les valeurs par défaut après "=".
    _REGEX_NOM_PARAMETRE = re.compile(r"\*{0,2}([A-Za-z_][A-Za-z0-9_]*)")

    def _rescanner_instances_connues(self):
        """Reparcourt TOUT le texte de cette cellule pour retrouver chaque
        "ma_variable = NomServiceAPI.instance()" où NomServiceAPI fait
        partie des ServiceAPI réellement importés dans ce Task (cf.
        _services_api_connus) -- écarte tout faux positif du style
        "x = NimporteQuoi.instance()" où "NimporteQuoi" ne serait pas un
        ServiceAPI connu (fonction/objet arbitraire du script). Reconstruit
        entièrement _instances_connues à chaque appel (pas de diff
        incrémental) : le texte d'une cellule Task reste court, un
        re-scan complet à chaque frappe est largement assez rapide et
        beaucoup plus simple/fiable qu'un suivi ligne par ligne.

        AJOUT (demande explicite utilisateur -- cf. _resultats_connus) :
        peuple AUSSI _resultats_connus dans le même passage, via
        _REGEX_AFFECTATION_RESULTAT -- même esprit que ci-dessus mais sur
        "ma_variable = quelquechose.click(...)"/".new_tab(...)"/etc.
        Contrairement à _instances_connues, "quelquechose" n'est PAS
        vérifié ici (cf. docstring de _REGEX_AFFECTATION_RESULTAT --
        volontairement permissif, seul le nom de la méthode compte).

        PATCH (retour utilisateur : auto-complétion manquante sur le
        retour de screenshot()) : peuple AUSSI _images_connues, même
        principe EXACT via _REGEX_AFFECTATION_IMAGE -- "ma_variable =
        quelquechose.screenshot(...)"."""
        texte = self.toPlainText()
        self._instances_connues = {
            nom_variable
            for nom_variable, nom_service in self._REGEX_AFFECTATION_INSTANCE.findall(texte)
            if nom_service in self._services_api_connus
        }
        self._resultats_connus = {
            nom_variable
            for nom_variable, _nom_methode in self._REGEX_AFFECTATION_RESULTAT.findall(texte)
        }
        self._images_connues = {
            nom_variable
            for nom_variable, _nom_methode in self._REGEX_AFFECTATION_IMAGE.findall(texte)
        }

    def _rescanner_zones_connues(self):
        """Reparcourt TOUT le texte de cette cellule pour retrouver chaque
        variable provenant d'une ZoneDetectee (cf. docstring de
        _zones_connues plus haut) -- même principe que
        _rescanner_instances_connues (re-scan complet à chaque frappe,
        pas de suivi incrémental), mais couvre les DEUX formes que
        l'utilisateur peut raisonnablement écrire :

        Le nom à gauche du ".choose(...)" peut être SOIT le nom FIXE d'un
        ComposantLayout réellement importé dans ce Task (cf.
        _composants_layout_connus), SOIT le nom d'une variable déjà
        reconnue comme InstanceLayoutDetectee (résultat d'un .choose()
        précédent -- ex explicite de l'utilisateur : "videoTemplateItems
        = videoTemplate.choose(random)" PUIS ré-appel de ".choose()" sur
        "videoTemplateItems" elle-même) -- d'où un calcul en DEUX PASSES :
        la première pose la base (noms FIXES uniquement), la seconde
        élargit à tout nom de variable qui vient d'être découvert comme
        InstanceLayoutDetectee -- répété jusqu'à stabilisation (peu de
        chaînages réalistes dans un script utilisateur, une poignée
        d'itérations suffit largement, mais la boucle "while" couvre
        n'importe quelle profondeur sans limite arbitraire).

        Forme A (directe) : "z = videoTemplateItems.choose().nom_zone"
        -- cf. _REGEX_AFFECTATION_ZONE.

        Forme B (en deux temps) : "instance = monComposantLayout.choose()"
        puis, potentiellement sur une autre ligne, "z = instance.nom_zone"
        -- résolue via _REGEX_AFFECTATION_INSTANCE_LAYOUT (qui alimente
        aussi la base de noms "choose()-ables" ci-dessus, cf. plus haut)
        puis _REGEX_AFFECTATION_ATTRIBUT_SIMPLE pour repérer tout
        "z = instance.nom_zone" où "instance" fait partie de cet ensemble.

        Le nom de zone lui-même ("nom_zone") n'est jamais vérifié dans
        aucune des deux formes -- volontairement permissif, cf. docstring
        de _zones_connues (les noms de zone dépendent du code_filtre de
        chaque ComposantLayout, jamais visibles depuis le texte du
        script)."""
        texte = self.toPlainText()

        # Base des noms sur lesquels ".choose(...)" est significatif :
        # les ComposantLayout fixes pour commencer, élargie ensuite à
        # toute variable reconnue comme InstanceLayoutDetectee (cf.
        # docstring ci-dessus -- chaînage "videoTemplateItems =
        # videoTemplate.choose(random)" puis re-.choose() dessus).
        noms_choose_valides = set(self._composants_layout_connus)
        instances_layout: set = set()
        while True:
            nouvelles_instances = {
                nom_variable
                for nom_variable, nom_source in self._REGEX_AFFECTATION_INSTANCE_LAYOUT.findall(texte)
                if nom_source in noms_choose_valides
            }
            if nouvelles_instances <= instances_layout:
                break
            instances_layout |= nouvelles_instances
            noms_choose_valides |= instances_layout

        # Forme A : "z = <nom_valide>.choose(...).nom_zone", en une seule
        # ligne -- <nom_valide> = ComposantLayout fixe OU instance_layout
        # déjà chaînée ci-dessus.
        zones = {
            nom_variable
            for nom_variable, nom_source, _nom_zone in self._REGEX_AFFECTATION_ZONE.findall(texte)
            if nom_source in noms_choose_valides
        }

        # Forme B, étape finale : tout "z = instance.nom_zone" où
        # "instance" a été reconnue ci-dessus comme InstanceLayoutDetectee
        # -- ligne par ligne (_REGEX_AFFECTATION_ATTRIBUT_SIMPLE ancre sa
        # fin sur la fin de ligne, un search par ligne est donc plus sûr
        # qu'un findall global ici).
        for ligne in texte.splitlines():
            m_attr = self._REGEX_AFFECTATION_ATTRIBUT_SIMPLE.match(ligne.strip())
            if m_attr and m_attr.group(2) in instances_layout:
                zones.add(m_attr.group(1))

        self._zones_connues = zones

    def _rescanner_variables_connues(self):
        """Reparcourt TOUT le texte de cette cellule pour retrouver tout nom
        de variable déclaré (affectation, "for...in", "...as...", paramètre
        de "def") -- cf. _REGEX_DECLARATION_VARIABLE. Reconstruit
        entièrement _variables_connues à chaque appel, même principe et
        mêmes raisons que _rescanner_instances_connues ci-dessus (texte
        court, re-scan complet largement assez rapide).

        Volontairement PAS de filtrage sémantique ici (contrairement à
        _rescanner_instances_connues qui vérifie le ServiceAPI) : toute
        variable déclarée est un nom légitime à proposer, peu importe ce
        qui lui a été affecté -- décision explicite utilisateur, la
        complétion demandée porte sur le NOM, pas sur les méthodes d'un
        type deviné."""
        texte = self.toPlainText()
        variables = set()
        for groupe_egal, groupe_for, groupe_as, groupe_nom_def, groupe_params_def in self._REGEX_DECLARATION_VARIABLE.findall(texte):
            if groupe_egal:
                # groupe_egal = "a = b = " pour "a = b = 5" (ou "a, b = "
                # pour une affectation multiple simple) -- le dernier
                # segment après split("=") est toujours vide (rien après
                # le "=" final capturé), donc [:-1] garde uniquement les
                # cibles réelles.
                for segment in groupe_egal.split("=")[:-1]:
                    variables.update(n.strip() for n in segment.split(",") if n.strip())
            if groupe_for:
                variables.update(n.strip() for n in groupe_for.split(","))
            if groupe_as:
                variables.add(groupe_as.strip())
            if groupe_nom_def:
                # Nom de la fonction elle-même -- BUGFIX (retour
                # utilisateur : "l'auto complétion ne prend pas en charge
                # les fonctions définies par l'utilisateur").
                variables.add(groupe_nom_def.strip())
            if groupe_params_def:
                for param in groupe_params_def.split(","):
                    m_param = self._REGEX_NOM_PARAMETRE.match(param.strip())
                    if m_param:
                        variables.add(m_param.group(1))
        # "_" seul (variable jetable conventionnelle, ex: "for _ in ...")
        # n'apporte rien à l'auto-complétion -- exclu.
        variables.discard("_")
        self._variables_connues = variables

    def _sur_texte_modifie(self):
        # AJOUT : un surlignage rouge de ligne d'erreur qui resterait
        # affiché après que l'utilisateur ait retapé du code deviendrait
        # trompeur -- il pointerait sur du texte qui a changé depuis
        # l'erreur qui l'a causé (potentiellement même plus la ligne
        # fautive du tout). Effacé dès la toute première frappe suivant
        # l'erreur ; une éventuelle NOUVELLE erreur le réappliquera de
        # toute façon au prochain échec d'exécution (cf. callback_termine
        # dans _executer_cellule).
        self.effacer_surlignage_erreur()
        self._rescanner_instances_connues()
        # AJOUT (demande explicite utilisateur : "chaque zone doit avoir
        # les meme methode que un composantSingle") -- cf.
        # _rescanner_zones_connues/_zones_connues.
        self._rescanner_zones_connues()
        self._rescanner_variables_connues()
        self._mettre_a_jour_popup()

    def _mettre_a_jour_popup(self):
        curseur = self.textCursor()
        texte_avant = curseur.block().text()[: curseur.positionInBlock()]

        m = self._REGEX_CONTEXTE_POINT.search(texte_avant)
        if m:
            self._proposer_methodes(m)
            return

        # Pas de "." juste avant le curseur -- tente le second mode
        # (décision explicite utilisateur : "je veux l'autocomplétion pour
        # écrire juste le nom d'une variable" -- ex: taper "r" propose
        # "resultat" si déclaré plus haut dans la cellule, cf.
        # _rescanner_variables_connues).
        m_mot = self._REGEX_CONTEXTE_MOT.search(texte_avant)
        if m_mot:
            self._proposer_variables(m_mot)
            return

        self._popup.hide()

    def _proposer_methodes(self, m: re.Match):
        """Popup de méthodes/attributs après "NomConnu." (composant,
        instance, ServiceAPI ou ResultatAction) -- comportement historique
        de _mettre_a_jour_popup, extrait tel quel dans sa propre méthode
        pour cohabiter proprement avec _proposer_variables ci-dessous."""
        nom_avant_point = m.group(1)
        if nom_avant_point in self._composants_connus:
            liste_methodes = METHODES_COMPOSANT_EXECUTABLE
        elif nom_avant_point in self._composants_layout_connus:
            # AJOUT -- "videoTemplateItems." (nom FIXE, imposé par
            # l'import du ComposantLayout, même principe que
            # _composants_connus ci-dessus) -> propose visible()/choose().
            liste_methodes = METHODES_COMPOSANT_LAYOUT_EXECUTABLE
        elif nom_avant_point in self._zones_connues:
            # AJOUT (demande explicite utilisateur : "chaque zone doit
            # avoir les meme methode que un composantSingle") -- nom de
            # VARIABLE détecté dynamiquement via .choose().nom_zone ou
            # instance.nom_zone, cf. _zones_connues/_rescanner_zones_connues.
            liste_methodes = METHODES_ZONE_DETECTEE
        elif nom_avant_point in self._instances_connues or nom_avant_point in self._instances_globales_connues:
            liste_methodes = METHODES_INSTANCE_EXECUTABLE
        elif nom_avant_point in self._services_api_connus:
            liste_methodes = METHODES_SERVICE_API_EXECUTABLE
        elif nom_avant_point in self._resultats_connus or nom_avant_point in self._resultats_globaux_connus:
            # AJOUT (demande explicite utilisateur : "r=new_chat.click(...) ;
            # r. -- sa doit me proposer les differentes variable") -- cf.
            # _resultats_connus/_REGEX_AFFECTATION_RESULTAT.
            liste_methodes = METHODES_RESULTAT_ACTION
        elif nom_avant_point in self._images_connues:
            # PATCH (retour utilisateur : "pourquoi il n'y a pas d'auto
            # completion qui fonctionne pour les objet retourner par la
            # methode screenshot()") -- cf. _images_connues/
            # _REGEX_AFFECTATION_IMAGE/METHODES_IMAGE.
            liste_methodes = METHODES_IMAGE
        else:
            self._popup.hide()
            return

        prefixe = (m.group(2) or "").lower()
        methodes_filtrees = [
            t for t in liste_methodes if t[0].lower().startswith(prefixe)
        ] if prefixe else list(liste_methodes)

        if not methodes_filtrees:
            self._popup.hide()
            return

        self._popup.peupler(methodes_filtrees)
        self._positionner_popup()
        self._popup.show()
        self._popup.raise_()

    def _proposer_variables(self, m_mot: re.Match):
        """Popup de NOMS DE VARIABLE (pas de méthode) : propose toute
        variable connue (cf. _variables_connues) OU tout builtin Python
        courant (cf. BUILTINS_PYTHON_COURANTS -- décision explicite
        utilisateur : "autocomplétion pour les fonctions de base Python
        comme print()") dont le nom commence par le préfixe en cours de
        frappe. Les deux sources apparaissent dans le MÊME popup (même
        mécanisme de déclenchement -- pas de "." devant), mais PAS
        mélangées par un tri alphabétique global (décision explicite
        utilisateur : "les noms de variable doivent être prioritaires sur
        les noms de fonction") -- TOUTES les variables d'abord (triées
        entre elles), PUIS tous les builtins (triés entre eux). En cas de
        collision (variable qui porterait le même nom qu'un builtin, ex:
        quelqu'un qui écrirait "list = [...]"), la variable gagne -- elle
        reflète un choix explicite de l'utilisateur dans SON script, plus
        pertinent ici que le builtin générique.

        Le préfixe lui-même est exclu quand il correspond déjà exactement
        à une variable complète (pas d'intérêt à se proposer soi-même une
        fois le mot entièrement tapé) ; les builtins n'ont pas ce
        problème, leur nom est toujours suivi de "()" donc jamais
        identique au préfixe seul.

        Réutilise AutoCompletionPopup.peupler(), qui attend des triplets
        (nom, signature, description) -- pour une variable, "signature" =
        le nom seul (rien à insérer entre parenthèses) ; pour un builtin,
        "signature" = "nom()" (même mécanisme d'insertion + repositionnement
        du curseur que pour une méthode, cf. _inserer_methode, réutilisé
        tel quel)."""
        prefixe = m_mot.group(1)
        if not prefixe:
            self._popup.hide()
            return

        prefixe_min = prefixe.lower()
        # Toutes les variables connues qui matchent le préfixe -- LOCALES
        # (cette cellule) ET GLOBALES (reste du notebook, cf.
        # definir_variables_globales_connues -- BUGFIX : le namespace
        # d'exécution est partagé entre toutes les cellules du Task, la
        # complétion doit donc l'être aussi). Utilisé à la fois pour la
        # liste affichée (avec le préfixe exact exclu, cf. ci-dessous) ET
        # pour savoir quels builtins doivent céder la priorité à une
        # variable de même nom (l'exclusion du préfixe exact ne doit PAS
        # affaiblir cette seconde vérification : une variable "list"
        # entièrement tapée doit quand même faire céder le builtin
        # "list", même si elle n'apparaît plus dans la liste affichée
        # puisqu'elle correspond exactement à ce qui est déjà là).
        noms_locaux_correspondants = {
            n for n in self._variables_connues if n.lower().startswith(prefixe_min)
        }
        noms_globaux_correspondants = {
            n for n in self._variables_globales_connues
            if n.lower().startswith(prefixe_min) and n not in noms_locaux_correspondants
        }
        noms_variables_correspondants = noms_locaux_correspondants | noms_globaux_correspondants
        noms_locaux_filtres = sorted(n for n in noms_locaux_correspondants if n != prefixe)
        noms_globaux_filtres = sorted(n for n in noms_globaux_correspondants if n != prefixe)
        # Bloc SERVICE API connus (ex: "Word", "Gmail") -- BUGFIX (retour
        # utilisateur : l'auto-complétion des méthodes après "NomServiceAPI."
        # fonctionnait déjà, cf. _proposer_methodes/_services_api_connus,
        # mais le nom du ServiceAPI lui-même, en cours de frappe (donc AVANT
        # même le "."), n'était jamais proposé ici -- contrairement à une
        # variable, un nom de ServiceAPI est FIXE (imposé par l'import, pas
        # choisi librement par l'utilisateur), il ne pouvait donc jamais
        # apparaître dans _variables_connues/_variables_globales_connues et
        # restait invisible de ce popup. Ajouté comme troisième bloc,
        # trié alphabétiquement en interne, entre variables et builtins --
        # ni avant les variables (une variable qu'on vient de déclarer reste
        # la suggestion la plus probable) ni mélangé aux builtins (nature
        # différente : un ServiceAPI est propre à ce Project, pas une
        # fonction générique du langage).
        noms_services_api_correspondants = {
            n for n in self._services_api_connus if n.lower().startswith(prefixe_min)
        }
        noms_services_api_filtres = sorted(n for n in noms_services_api_correspondants if n != prefixe)
        # Bloc VARIABLES en premier (priorité voulue), trié alphabétiquement
        # en interne seulement -- jamais mélangé avec le bloc builtins
        # ci-dessous. Locales avant globales (une variable qu'on vient de
        # taper dans CETTE cellule reste la plus probable) ; description
        # distincte selon l'origine, pour que l'utilisateur comprenne
        # qu'une suggestion "globale" vient d'une AUTRE cellule du même
        # Task (namespace partagé, cf. docstring definir_variables_globales_connues).
        propositions = (
            [(n, n, "Variable déjà déclarée dans cette cellule") for n in noms_locaux_filtres]
            + [(n, n, "Variable déclarée ailleurs dans ce notebook") for n in noms_globaux_filtres]
            + [(n, n, "ServiceAPI importé dans ce Task") for n in noms_services_api_filtres]
        )

        # Bloc BUILTINS ensuite, trié alphabétiquement en interne aussi,
        # mais toujours APRÈS la totalité du bloc variables ci-dessus --
        # sorted() sur BUILTINS_PYTHON_COURANTS lui-même (pas sur
        # "propositions" combiné) garantit qu'aucun builtin ne remonte
        # avant une variable, quel que soit l'ordre alphabétique des noms.
        # L'exclusion tient aussi compte des ServiceAPI connus (même
        # logique de préséance que pour les variables -- cf. bloc
        # ci-dessus -- un nom de ServiceAPI qui coïnciderait avec un
        # builtin doit lui aussi faire céder ce dernier).
        builtins_filtres = sorted(
            (nom, signature, description)
            for nom, signature, description in BUILTINS_PYTHON_COURANTS
            if nom not in noms_variables_correspondants
            and nom not in noms_services_api_correspondants
            and nom.lower().startswith(prefixe_min)
        )
        propositions.extend(builtins_filtres)

        if not propositions:
            self._popup.hide()
            return

        self._popup.peupler(propositions)
        self._positionner_popup()
        self._popup.show()
        self._popup.raise_()

    def _positionner_popup(self):
        rect_curseur = self.cursorRect()
        point_global = self.mapToGlobal(rect_curseur.bottomLeft())
        self._popup.move(point_global)

    # AJOUT (demande explicite utilisateur : "lors de lauto completion des
    # methode qui prend en prametre ces parametre au lieu de mettre none ,
    # sa doit directememtn autocomplete avec ces variable") -- les 4
    # paramètres retry/timeout/latence_avant/latence_apres correspondent
    # EXACTEMENT aux 4 variables pré-remplies dans la cellule "Variable
    # dynamique" (cf. CODE_VARIABLES_DYNAMIQUES_DEFAUT et
    # ComposantExecutable._global_defaut() / InstanceExecutable._global_defaut()
    # qui les lisent déjà au runtime quand la valeur vaut None). Ce
    # remplacement est purement TEXTUEL/COSMÉTIQUE au moment de
    # l'insertion : il ne change rien au comportement d'exécution (None
    # retombait déjà sur RETRY/TIMEOUT/LATENCE_AVANT/LATENCE_APRES via
    # _global_defaut), juste ce qui apparaît explicitement dans le script
    # généré pour que l'utilisateur voie/ajuste la vraie valeur tout de
    # suite plutôt qu'un None opaque. Clé = motif exact tel qu'il apparaît
    # dans TOUTES les signatures statiques (retry=None, timeout=None,
    # latence_avant=None, latence_apres=None -- vérifié cohérent partout,
    # aucune collision avec d'autres paramètres comme texte=None/zone=None),
    # valeur = remplacement.
    _DEFAUTS_SIGNATURE_VERS_VARIABLE_GLOBALE = {
        "retry=None": "retry=RETRY",
        "timeout=None": "timeout=TIMEOUT",
        "latence_avant=None": "latence_avant=LATENCE_AVANT",
        "latence_apres=None": "latence_apres=LATENCE_APRES",
    }

    def _inserer_methode(self, nom_methode: str, signature: str):
        """Remplace le préfixe éventuel déjà tapé après le "." par la
        SIGNATURE COMPLÈTE de la méthode choisie (décision explicite
        utilisateur -- ex: cliquer sur "click" insère
        "click(bouton='gauche', duree_appui_ms=60, nb_clics=1,
        copier_presse_papier=False)" tel quel, pas juste "click"). Le
        curseur est repositionné juste après la
        parenthèse ouvrante si la méthode prend des arguments (prêt à les
        ajuster immédiatement), ou après les parenthèses vides sinon.

        Les 4 paramètres retry/timeout/latence_avant/latence_apres sont
        insérés directement avec la variable prédéfinie correspondante
        (RETRY/TIMEOUT/LATENCE_AVANT/LATENCE_APRES) au lieu de None -- cf.
        _DEFAUTS_SIGNATURE_VERS_VARIABLE_GLOBALE ci-dessus."""
        for motif_none, remplacement in self._DEFAUTS_SIGNATURE_VERS_VARIABLE_GLOBALE.items():
            signature = signature.replace(motif_none, remplacement)
        curseur = self.textCursor()
        texte_avant = curseur.block().text()[: curseur.positionInBlock()]
        m = self._REGEX_CONTEXTE_POINT.search(texte_avant)
        if m:
            longueur_prefixe = len(m.group(2) or "")
        else:
            # Mode "nom de variable" (cf. _proposer_variables) : pas de
            # "." devant, le préfixe à effacer est tout le mot en cours
            # de frappe juste avant le curseur (ex: "r" avant "resultat").
            m_mot = self._REGEX_CONTEXTE_MOT.search(texte_avant)
            longueur_prefixe = len(m_mot.group(1)) if m_mot else 0
        for _ in range(longueur_prefixe):
            curseur.deletePreviousChar()
        curseur.insertText(signature)
        position_fin_insertion = curseur.position()

        # Repositionne le curseur juste après la parenthèse ouvrante quand
        # la signature a des arguments (ex: "click(bouton='gauche', ...)"),
        # pour permettre d'ajuster immédiatement les valeurs par défaut.
        # Calcul par position absolue (plus robuste qu'une boucle de
        # déplacements relatifs) : position_fin_insertion correspond à la
        # fin de "signature" tout juste inséré, donc
        # position_fin_insertion - len(signature) + index_parenthese + 1
        # tombe exactement juste après le "(".
        #
        # Cas particulier des BUILTINS Python (cf. BUILTINS_PYTHON_COURANTS) :
        # leur signature insérée est TOUJOURS "nom()" (parenthèses vides,
        # pas de gabarit d'arguments -- contrairement aux méthodes du
        # domaine dont les valeurs par défaut sont explicites dans la
        # signature). Mais contrairement à une méthode comme "visible()"
        # où "()" vide signifie vraiment "aucun argument", un builtin
        # comme "print()"/"len()" est presque toujours appelé avec un
        # argument -- le curseur doit donc être placé ENTRE les
        # parenthèses même vides, pour ce cas précis seulement.
        index_parenthese = signature.find("(")
        est_builtin_parentheses_vides = (
            index_parenthese != -1
            and signature.endswith("()")
            and any(nom_methode == b[0] for b in BUILTINS_PYTHON_COURANTS)
        )
        if index_parenthese != -1 and (
            (index_parenthese + 1 < len(signature) and signature[index_parenthese + 1] != ")")
            or est_builtin_parentheses_vides
        ):
            position_apres_parenthese = position_fin_insertion - len(signature) + index_parenthese + 1
            curseur.setPosition(position_apres_parenthese)
            self.setTextCursor(curseur)

        self._popup.hide()
        self.setFocus()

    # Paires de caractères auto-fermées à la frappe de l'ouvrant (décision
    # explicite utilisateur : "quand on ouvre une parenthèse ça se ferme
    # automatiquement, même chose avec les crochets") -- accolades et
    # guillemets inclus par cohérence, un éditeur de code Python sans ça
    # serait incohérent avec l'usage courant. Clé = touche Qt de
    # l'OUVRANT, valeur = caractère fermant correspondant.
    _PAIRES_AUTO_FERMEES = {
        Qt.Key_ParenLeft: ")",
        Qt.Key_BracketLeft: "]",
        Qt.Key_BraceLeft: "}",
        Qt.Key_Apostrophe: "'",
        Qt.Key_QuoteDbl: '"',
    }
    _FERMANTS = {")", "]", "}", "'", '"'}

    def keyPressEvent(self, event):
        # PATCH (demande explicite utilisateur : "si on a selectionner une
        # expression et bien le raccourci ctrl+f fait la selection de tout
        # les occurence dans tout le notebook" + "ctrl+d vas faire a ce
        # que les curseur se creer a ces endroit de mots pour une
        # modifcation multiple au meme moment") -- traité en TOUT premier,
        # avant même Ctrl+/, pour que ces raccourcis fonctionnent quel que
        # soit l'état de l'éditeur (cohérent avec le traitement prioritaire
        # déjà appliqué à Ctrl+/ juste en dessous).
        if event.key() == Qt.Key_F and event.modifiers() == Qt.ControlModifier:
            if self._gerer_ctrl_f():
                return
        if event.key() == Qt.Key_D and event.modifiers() == Qt.ControlModifier:
            if self._gerer_ctrl_d():
                return
        if event.key() == Qt.Key_Escape:
            notebook = self._notebook_parent()
            if notebook is not None and notebook._multi_curseur_etat is not None:
                notebook.annuler_multi_curseur()
                return

        # PATCH (demande explicite utilisateur : "supposons maintenant
        # qu on veut revenir a la position, comment on peut faire") --
        # Alt+Gauche ("Go Back", même touche que la navigation arrière
        # d'un navigateur/VSCode) dépile la dernière position quittée par
        # "Aller à la définition" et y retourne. Traité ici, au même
        # niveau de priorité que Ctrl+F/Ctrl+D, pour fonctionner quel que
        # soit l'état de l'éditeur.
        if event.key() == Qt.Key_Left and event.modifiers() == Qt.AltModifier:
            notebook = self._notebook_parent()
            if notebook is not None and notebook.revenir_position_precedente():
                return

        # Si une édition multi-curseur est active ET que cette touche
        # correspond à une frappe de texte "normale" (caractère, Backspace,
        # Delete, collage...), l'opération doit être répercutée sur toutes
        # les autres occurrences actives AVANT d'être traitée normalement
        # ici -- cf. _propager_si_multi_curseur_actif, qui laisse ensuite
        # le traitement standard de la touche suivre son cours pour CET
        # éditeur (occurrence sous le focus).
        self._propager_si_multi_curseur_actif(event)

        # Ctrl+/ : commente/décommente la ligne courante (ou toutes les
        # lignes touchées par la sélection) -- raccourci standard de tout
        # éditeur de code (VSCode, PyCharm, Jupyter). Traité en tout
        # premier, avant même le popup d'auto-complétion, pour que le
        # raccourci fonctionne quel que soit l'état de l'éditeur.
        if event.key() == Qt.Key_Slash and event.modifiers() == Qt.ControlModifier:
            self._toggle_commentaire_selection()
            return

        if self._popup.isVisible():
            if event.key() in (Qt.Key_Down,):
                self._popup.deplacer_selection(1)
                return
            if event.key() in (Qt.Key_Up,):
                self._popup.deplacer_selection(-1)
                return
            if event.key() in (Qt.Key_Return, Qt.Key_Enter, Qt.Key_Tab):
                choix = self._popup.selection_actuelle()
                if choix:
                    nom_methode, signature = choix
                    self._inserer_methode(nom_methode, signature)
                    return
            if event.key() == Qt.Key_Escape:
                self._popup.hide()
                return

        # Tab / Shift+Tab : indentation et désindentation de bloc. Traité
        # AVANT super().keyPressEvent() -- sans ça, Qt applique son
        # comportement par défaut sur QPlainTextEdit qui, quand du texte
        # est sélectionné, REMPLACE la sélection par un simple caractère
        # de tabulation (perte du texte sélectionné, jamais une
        # indentation). Qt.Key_Backtab est la touche effectivement reçue
        # pour Shift+Tab sur la plupart des plateformes/styles -- on
        # vérifie aussi Key_Tab + ShiftModifier par sécurité.
        if event.key() in (Qt.Key_Tab, Qt.Key_Backtab):
            est_shift = (
                event.key() == Qt.Key_Backtab
                or bool(event.modifiers() & Qt.ShiftModifier)
            )
            if self._gerer_indentation_tab(est_shift):
                return

        if self._gerer_auto_fermeture(event):
            return

        super().keyPressEvent(event)
        # Réévalue le popup après le traitement normal de la touche (ex:
        # backspace qui repasse sous le seuil de déclenchement du ".").
        if event.key() not in (Qt.Key_Down, Qt.Key_Up, Qt.Key_Return, Qt.Key_Enter, Qt.Key_Tab, Qt.Key_Escape):
            self._mettre_a_jour_popup()

    _INDENTATION = "    "  # 4 espaces par niveau, cohérent avec le reste de l'éditeur.

    def _gerer_indentation_tab(self, est_shift: bool) -> bool:
        """Gère Tab et Shift+Tab pour l'indentation/désindentation.

        Retourne True si l'événement a été entièrement pris en charge ici
        (ne pas laisser super().keyPressEvent() le traiter en plus).

        - Sans sélection : Tab insère 4 espaces au curseur (comportement
          normal de saisie) ; Shift+Tab retire jusqu'à 4 espaces
          d'indentation juste avant le curseur, si présents.
        - Avec une sélection qui ne couvre qu'une seule ligne partielle
          (pas de retour à la ligne dans la sélection) : Tab remplace la
          sélection par 4 espaces, comme la saisie normale d'un
          caractère -- laissé à super() pour rester cohérent avec le
          reste de l'éditeur (retourne False).
        - Avec une sélection couvrant plusieurs lignes (ou une ligne
          entière) : Tab/Shift+Tab indente/désindente CHAQUE ligne
          touchée en bloc, sans effacer le texte sélectionné, comme dans
          VSCode/PyCharm.
        """
        curseur = self.textCursor()

        if not curseur.hasSelection():
            if not est_shift:
                curseur.insertText(self._INDENTATION)
                return True
            # Shift+Tab sans sélection : désindente la ligne courante en
            # retirant jusqu'à un niveau d'indentation avant le curseur.
            bloc = curseur.block()
            texte_avant_curseur = bloc.text()[: curseur.positionInBlock()]
            if texte_avant_curseur and texte_avant_curseur[-1] == " ":
                a_retirer = 0
                for i in range(min(len(self._INDENTATION), len(texte_avant_curseur))):
                    if texte_avant_curseur[-(i + 1)] == " ":
                        a_retirer += 1
                    else:
                        break
                if a_retirer:
                    curseur.setPosition(curseur.position() - a_retirer, QTextCursor.KeepAnchor)
                    curseur.removeSelectedText()
                    return True
            return True  # rien à retirer -- on ignore la touche sans rien faire d'autre.

        depart = curseur.selectionStart()
        fin = curseur.selectionEnd()
        bloc_depart = self.document().findBlock(depart)
        bloc_fin = self.document().findBlock(fin)

        # Sélection contenue dans une seule ligne (pas de \n traversé) :
        # laisse le comportement normal (Tab remplace la sélection par
        # une tabulation, comme n'importe quelle frappe de caractère).
        # Shift+Tab dans ce cas n'a rien à faire (pas de "caractère
        # inverse") -- on avale l'événement sans effet.
        if bloc_depart == bloc_fin:
            if est_shift:
                return True
            return False

        # Si la sélection se termine exactement au tout début d'un bloc,
        # ne pas inclure ce bloc suivant (cohérent avec _toggle_commentaire_selection).
        if bloc_fin.position() == fin and bloc_fin != bloc_depart:
            bloc_fin = bloc_fin.previous()

        blocs = []
        b = bloc_depart
        while True:
            blocs.append(b)
            if b == bloc_fin or not b.isValid():
                break
            b = b.next()

        curseur.beginEditBlock()
        premiere_ligne_delta = 0
        derniere_ligne_delta = 0
        for i, b in enumerate(blocs):
            texte = b.text()
            c = QTextCursor(b)
            if not est_shift:
                c.setPosition(b.position())
                c.insertText(self._INDENTATION)
                delta = len(self._INDENTATION)
            else:
                indentation_len = len(texte) - len(texte.lstrip(" "))
                a_retirer = min(len(self._INDENTATION), indentation_len)
                delta = 0
                if a_retirer:
                    c.setPosition(b.position())
                    c.setPosition(b.position() + a_retirer, QTextCursor.KeepAnchor)
                    c.removeSelectedText()
                    delta = -a_retirer
            if i == 0:
                premiere_ligne_delta = delta
            if i == len(blocs) - 1:
                derniere_ligne_delta = delta
        curseur.endEditBlock()

        # Réajuste la sélection visible pour qu'elle continue de couvrir
        # les mêmes lignes après le décalage d'indentation (cohérent avec
        # un IDE : on peut appuyer plusieurs fois de suite sur Tab/Shift+Tab
        # sans perdre la sélection).
        nouveau_depart = max(bloc_depart.position(), depart + premiere_ligne_delta)
        nouveau_curseur = self.textCursor()
        nouveau_curseur.setPosition(nouveau_depart)
        nouveau_curseur.setPosition(bloc_fin.position() + bloc_fin.length() - 1 + derniere_ligne_delta, QTextCursor.KeepAnchor)
        self.setTextCursor(nouveau_curseur)

        return True

    def _toggle_commentaire_selection(self):
        """Ctrl+/ : commente ou décommente en bloc la ou les lignes
        couvertes par la sélection (ou juste la ligne du curseur si rien
        n'est sélectionné), comme dans VSCode/PyCharm/Jupyter.

        Règle de bascule : si TOUTES les lignes non vides du bloc sont
        déjà commentées (préfixées par "# ", éventuel indentation
        conservée), on décommente ; sinon on commente celles qui ne le
        sont pas encore. Cohérent avec le comportement standard "ajouter
        commentaire si au moins une ligne n'est pas commentée, sinon
        retirer" plutôt qu'un simple toggle ligne par ligne indépendant
        (qui donnerait un résultat incohérent sur une sélection mixte).

        Les lignes entièrement vides (pas de caractère non-espace) sont
        ignorées pour la décision ET pour l'insertion/retrait -- pas de
        "# " ajouté sur une ligne blanche.
        """
        curseur = self.textCursor()
        depart = curseur.selectionStart()
        fin = curseur.selectionEnd()

        bloc_depart = self.document().findBlock(depart)
        bloc_fin = self.document().findBlock(fin)
        # Si la sélection se termine exactement au début d'un bloc (ex:
        # sélection qui s'arrête juste avant le \n suivant), ne pas
        # inclure ce bloc suivant dans la bascule -- correspond à
        # l'intuition "j'ai sélectionné jusqu'à la fin de cette ligne-là".
        if bloc_fin.position() == fin and bloc_fin != bloc_depart:
            bloc_fin = bloc_fin.previous()

        blocs = []
        b = bloc_depart
        while True:
            blocs.append(b)
            if b == bloc_fin or not b.isValid():
                break
            b = b.next()

        lignes_non_vides = [b for b in blocs if b.text().strip() != ""]
        if not lignes_non_vides:
            return

        toutes_commentees = all(b.text().lstrip().startswith("#") for b in lignes_non_vides)

        curseur.beginEditBlock()
        for b in lignes_non_vides:
            texte = b.text()
            indentation_len = len(texte) - len(texte.lstrip(" \t"))
            indentation = texte[:indentation_len]
            reste = texte[indentation_len:]

            c = QTextCursor(b)
            if toutes_commentees:
                # Décommente : retire un "# " ou, à défaut, un "#" seul.
                if reste.startswith("# "):
                    a_retirer = 2
                elif reste.startswith("#"):
                    a_retirer = 1
                else:
                    a_retirer = 0
                if a_retirer:
                    c.setPosition(b.position() + indentation_len)
                    c.setPosition(b.position() + indentation_len + a_retirer, QTextCursor.KeepAnchor)
                    c.removeSelectedText()
            else:
                if not reste.startswith("#"):
                    c.setPosition(b.position() + indentation_len)
                    c.insertText("# ")

        curseur.endEditBlock()

    # ------------------------------------------------------------------
    # PATCH : Ctrl+F (toutes les occurrences dans tout le notebook) et
    # Ctrl+D (multi-curseur simulé, synchronisé entre toutes les
    # cellules) -- cf. docstring de TaskConfigScreen._multi_curseur_etat
    # pour le raisonnement d'ensemble ; les méthodes ci-dessous sont la
    # partie "côté éditeur individuel" du mécanisme.
    # ------------------------------------------------------------------

    def cellule_id_associee(self) -> Optional[str]:
        """Id de la cellule portée par cet éditeur (cf. _cellule_id_associee,
        renseigné par TaskCelluleWidget), ou None pour un éditeur en
        lecture seule sans cellule (historique d'exécution)."""
        return self._cellule_id_associee

    def _notebook_parent(self) -> Optional["TaskConfigScreen"]:
        """Remonte la hiérarchie Qt (même pattern que TaskConfigScreen.
        _widget_est_descendant) jusqu'au TaskConfigScreen ancêtre, qui
        seul a la vue d'ensemble sur toutes les cellules du notebook
        nécessaire à Ctrl+F/Ctrl+D. Retourne None si cet éditeur n'a pas
        de cellule associée (lecture seule) ou n'est, pour une raison
        quelconque, pas logé dans un TaskConfigScreen -- Ctrl+F/Ctrl+D
        deviennent alors simplement inertes plutôt que de lever une
        exception."""
        if self._cellule_id_associee is None:
            return None
        courant = self.parentWidget()
        while courant is not None:
            if isinstance(courant, TaskConfigScreen):
                return courant
            courant = courant.parentWidget()
        return None

    def _gerer_ctrl_f(self) -> bool:
        """Ctrl+F : si une sélection non vide est active, sélectionne/
        surligne toutes ses occurrences dans TOUTES les cellules du
        notebook (cf. TaskConfigScreen.lancer_recherche_toutes_occurrences).
        Retourne False (raccourci non pris en charge ici) si aucune
        sélection n'est active ou si l'éditeur n'est pas dans un notebook
        -- laisse alors la touche suivre son traitement Qt normal plutôt
        que de l'avaler silencieusement."""
        texte = self.textCursor().selectedText()
        if not texte:
            return False
        notebook = self._notebook_parent()
        if notebook is None:
            return False
        notebook.lancer_recherche_toutes_occurrences(texte, self._cellule_id_associee)
        return True

    def _mot_sous_curseur(self) -> Optional[str]:
        """Mot (identifiant Python : lettres/chiffres/underscore) sous le
        curseur, quand rien n'est sélectionné -- même logique que
        QTextCursor.select(QTextCursor.WordUnderCursor), utilisée pour que
        Ctrl+D fonctionne aussi sans sélection préalable (comme dans
        VSCode : premier Ctrl+D sélectionne le mot courant)."""
        curseur = self.textCursor()
        curseur.select(QTextCursor.WordUnderCursor)
        mot = curseur.selectedText()
        return mot if mot else None

    def _mot_a_la_position(self, position_widget: "QPoint") -> Optional[str]:
        """Variante de _mot_sous_curseur basée sur des coordonnées LOCALES
        AU WIDGET (event.pos() d'un clic droit) plutôt que sur le curseur
        d'édition courant -- cursorForPosition() traduit ces coordonnées en
        QTextCursor sans déplacer self.textCursor() (donc sans perturber la
        sélection/position d'édition réelle juste parce que l'utilisateur a
        fait un clic droit ailleurs). Utilisée par contextMenuEvent pour
        "Aller à la définition" : le mot ciblé doit être celui sous le
        pointeur au moment du clic droit, pas celui où était le curseur
        avant ce clic."""
        curseur = self.cursorForPosition(position_widget)
        curseur.select(QTextCursor.WordUnderCursor)
        mot = curseur.selectedText()
        return mot if mot else None

    def contextMenuEvent(self, event):
        """PATCH (demande explicite utilisateur : clic droit sur une
        fonction ou une variable déjà déclarée -> "Aller à la définition")
        -- complète le menu contextuel standard de QPlainTextEdit (Couper/
        Copier/Coller/etc., construit par createStandardContextMenu, jamais
        remplacé ici) d'une entrée supplémentaire QUAND le mot sous le
        pointeur a effectivement une déclaration trouvable quelque part
        dans le notebook (cf. TaskConfigScreen._trouver_declaration) --
        entrée absente si le clic droit tombe sur du texte quelconque, un
        mot-clé Python, ou un identifiant jamais déclaré, plutôt que de
        toujours l'afficher et échouer silencieusement au clic.

        Recherche la déclaration UNE SEULE FOIS ici (pas à chaque frappe,
        contrairement à l'auto-complétion) -- un clic droit est un
        événement ponctuel, le coût d'un parcours de toutes les cellules
        à cet instant précis est négligeable."""
        mot = self._mot_a_la_position(event.pos())
        notebook = self._notebook_parent() if mot else None

        menu = self.createStandardContextMenu()
        premiere_action_standard = menu.actions()[0] if menu.actions() else None

        # PATCH (retour utilisateur : "je veux que aller a la definiton
        # soit la premier proposiiton pas la derniere, je dit dans le
        # popup") -- insertAction/insertSeparator(avant, ...) placent
        # AVANT l'action de référence passée en premier argument,
        # contrairement à addAction/addSeparator qui ajoutent toujours en
        # fin de liste (ce qui plaçait ces entrées tout en bas, après
        # Couper/Copier/Coller/Sélectionner tout). On construit donc les
        # actions de navigation dans l'ordre visuel voulu et on les
        # insère TOUTES avant premiere_action_standard, dans l'ordre où
        # on les insère (chaque insertAction place juste avant la
        # référence, donc en insérant Retour puis Définition dans cet
        # ordre on obtient bien Définition au-dessus de Retour à
        # l'écran -- réfléchi pour éviter une inversion silencieuse).
        actions_navigation_a_inserer = []
        if mot and notebook is not None and notebook._trouver_declaration(mot) is not None:
            action_definition = QAction(f"Aller à la définition de « {mot} »", menu)
            action_definition.triggered.connect(
                lambda: notebook.aller_a_la_definition(mot)
            )
            actions_navigation_a_inserer.append(action_definition)

        # AJOUT (demande explicite utilisateur : "clic droit sur le
        # composant layout, proposer aussi les noms des zones, copie dans
        # le presse-papier le nom qu'on souhaite utiliser") -- SI le mot
        # sous le pointeur est le nom de variable d'un ComposantLayout
        # importé dans ce Task (ex: NouveauServiceAPI_VideoTemplate),
        # propose un SOUS-MENU listant chaque zone que son code_filtre
        # nomme réellement (cf. _zones_composant_layout_pour_variable,
        # qui exécute le vrai pipeline scindement+filtre sur
        # image_reference -- jamais de nom deviné/inventé). Chaque entrée
        # copie dans le presse-papier EXACTEMENT le texte à taper après
        # le "." (ex: "vignette"), même geste que le clic sur une tuile
        # de composant dans le panneau gauche (cf. _sur_clic_composant,
        # QGuiApplication.clipboard().setText -- même mécanisme de copie,
        # cohérent avec le reste de l'app). Sous-menu ABSENT (pas une
        # entrée grisée) si le mot ne correspond à aucun cL importé ici,
        # même principe "jamais d'entrée qui échouerait silencieusement
        # au clic" que Définition/Retour ci-dessus.
        #
        # sous_menu_zones est parenté à `menu` (pas à self) pour être
        # détruit avec lui -- inséré via menu.insertMenu (PAS
        # menu.insertAction sur .menuAction() pris isolément : c'est le
        # pattern Qt correct pour faire apparaître un sous-menu en
        # cascade à un endroit précis parmi des actions déjà existantes,
        # cf. doc QMenu.insertMenu).
        sous_menu_zones = None
        if mot and notebook is not None:
            noms_zones = notebook._zones_composant_layout_pour_variable(mot)
            if noms_zones is not None:
                sous_menu_zones = QMenu(f"Copier le nom d'une zone de « {mot} »", menu)
                if noms_zones:
                    for nom_zone in noms_zones:
                        action_zone = QAction(nom_zone, sous_menu_zones)
                        action_zone.triggered.connect(
                            lambda checked=False, nz=nom_zone: QGuiApplication.clipboard().setText(nz)
                        )
                        sous_menu_zones.addAction(action_zone)
                else:
                    action_aucune = QAction("(aucune zone détectée -- vérifier code_filtre)", sous_menu_zones)
                    action_aucune.setEnabled(False)
                    sous_menu_zones.addAction(action_aucune)

        # PATCH (demande explicite utilisateur : "revenir a la position")
        # -- entrée "Retour" proposée dans le menu contextuel EN PLUS du
        # raccourci Alt+Gauche, mais seulement quand l'historique n'est
        # pas vide (cohérent avec la même logique que Définition
        # ci-dessus : pas d'entrée qui échouerait silencieusement au
        # clic).
        if notebook is not None and notebook._historique_navigation_definition:
            action_retour = QAction("Retour à la position précédente", menu)
            action_retour.triggered.connect(notebook.revenir_position_precedente)
            actions_navigation_a_inserer.append(action_retour)

        if actions_navigation_a_inserer or sous_menu_zones is not None:
            if premiere_action_standard is not None:
                for action in reversed(actions_navigation_a_inserer):
                    menu.insertAction(premiere_action_standard, action)
                # AJOUT : sous_menu_zones inséré à part (insertMenu, PAS
                # insertAction -- un QMenu n'est pas une QAction, cf.
                # docstring ci-dessus) juste avant premiere_action_standard,
                # donc juste APRÈS Définition/Retour puisqu'eux-mêmes
                # viennent d'être insérés avant cette même référence.
                if sous_menu_zones is not None:
                    menu.insertMenu(premiere_action_standard, sous_menu_zones)
                if actions_navigation_a_inserer or sous_menu_zones is not None:
                    menu.insertSeparator(premiere_action_standard)
            else:
                # Menu standard vide (cas limite, en pratique jamais
                # rencontré pour un clic droit dans un éditeur de texte
                # non vide) -- ajoute simplement à la suite, l'ordre
                # relatif entre elles reste correct puisqu'on parcourt
                # actions_navigation_a_inserer dans l'ordre naturel ici
                # (pas reversed, contrairement à insertAction ci-dessus).
                for action in actions_navigation_a_inserer:
                    menu.addAction(action)
                if sous_menu_zones is not None:
                    menu.addMenu(sous_menu_zones)
        menu.exec(event.globalPos())

    def _gerer_ctrl_d(self) -> bool:
        """Ctrl+D : ajoute la prochaine occurrence du texte sélectionné
        (ou du mot sous le curseur si rien n'est sélectionné, cf.
        _mot_sous_curseur) à l'édition multi-curseur, à l'échelle de tout
        le notebook (cf. TaskConfigScreen.ajouter_occurrence_suivante_ctrl_d).
        Retourne False si l'éditeur n'est pas dans un notebook."""
        curseur = self.textCursor()
        texte = curseur.selectedText()
        position_reference = curseur.selectionStart()
        if not texte:
            texte = self._mot_sous_curseur()
            if not texte:
                return False
            # Sélectionne effectivement ce mot pour que l'utilisateur voie
            # tout de suite ce qui est devenu la cible du multi-curseur,
            # cohérent avec le comportement VSCode.
            curseur.select(QTextCursor.WordUnderCursor)
            self.setTextCursor(curseur)
            position_reference = curseur.selectionStart()

        notebook = self._notebook_parent()
        if notebook is None:
            return False
        notebook.ajouter_occurrence_suivante_ctrl_d(texte, self._cellule_id_associee, position_reference)
        return True

    def _appliquer_surlignage_occurrences(self, occurrences: list, actives: list):
        """Repeint les occurrences trouvées (Ctrl+F) et/ou actives en
        édition multi-curseur (Ctrl+D) via QTextEdit.ExtraSelection --
        mécanisme Qt standard de surlignage superposé au texte, qui ne
        modifie ni le contenu ni le curseur réel de l'éditeur (cf.
        setExtraSelections). Deux teintes distinctes : sélection standard
        (DarculaTheme.selection) pour une occurrence simplement TROUVÉE
        (mode "recherche"), fond jaune semi-transparent pour une
        occurrence ACTIVEMENT éditée (mode "edition") -- pour que
        l'utilisateur distingue d'un coup d'oeil ce qui va changer sous sa
        frappe de ce qui a juste été repéré.

        BUGFIX (cf. surligner_ligne_erreur ci-dessous) : cette méthode
        est le SEUL point qui appelle setExtraSelections sur cet éditeur
        (cf. _rafraichir_surlignage_multi_curseur, unique appelant côté
        notebook) -- setExtraSelections REMPLACE toute la liste
        précédente plutôt que de la compléter. Sans précaution, un
        Ctrl+F/Ctrl+D déclenché après une erreur d'exécution effacerait
        silencieusement le surlignage rouge de la ligne fautive, et
        inversement une erreur qui arrive pendant une recherche active
        écraserait le jaune/bleu de la recherche. On compose donc
        toujours les deux sources ici plutôt que de les traiter comme
        deux appelants indépendants à setExtraSelections."""
        selections = []
        actives_set = set(actives)
        for debut, fin in occurrences:
            fmt = QTextCharFormat()
            if (debut, fin) in actives_set:
                couleur = QColor(DarculaTheme.jaune)
                couleur.setAlpha(90)
            else:
                couleur = QColor(DarculaTheme.selection)
                couleur.setAlpha(140)
            fmt.setBackground(QBrush(couleur))
            sel = QTextEdit.ExtraSelection()
            sel.format = fmt
            c = QTextCursor(self.document())
            c.setPosition(debut)
            c.setPosition(fin, QTextCursor.KeepAnchor)
            sel.cursor = c
            selections.append(sel)
        selections.extend(self._selections_erreur())
        # PATCH (cf. flasher_ligne_navigation plus bas) : sans ceci, le
        # flash bleu de "Aller à la définition" est écrasé dès le
        # prochain appel à setExtraSelections (seul point d'appel, cf.
        # docstring ci-dessus) -- composé ici pour la même raison que
        # _selections_erreur juste au-dessus.
        selections.extend(self._selections_navigation())
        self.setExtraSelections(selections)

    def _selections_erreur(self) -> list:
        """Construit la (au plus une) ExtraSelection représentant le
        surlignage rouge de la ligne d'erreur courante, d'après
        self._ligne_erreur_surlignee -- séparé de
        surligner_ligne_erreur() pour pouvoir être recombiné à chaque
        appel de _appliquer_surlignage_occurrences (cf. docstring
        ci-dessus) sans dupliquer la construction du QTextCursor/format.
        Fond rouge semi-transparent sur toute la largeur de la ligne
        (FullWidthSelection), pour rester lisible même si la ligne est
        courte -- c'est le même principe visuel qu'un IDE (PyCharm,
        VSCode) qui souligne/teinte la ligne fautive plutôt qu'un simple
        soulignement de mot."""
        numero_ligne = getattr(self, "_ligne_erreur_surlignee", None)
        if numero_ligne is None:
            return []
        bloc = self.document().findBlockByNumber(numero_ligne - 1)
        if not bloc.isValid():
            # Numéro de ligne hors bornes (ex : code modifié depuis
            # l'erreur, ou traceback pointant sur une ligne qui n'existe
            # plus dans cette version du texte) -- ne rien surligner
            # plutôt que de crasher ou de surligner la mauvaise ligne.
            return []
        fmt = QTextCharFormat()
        couleur = QColor(DarculaTheme.rouge)
        couleur.setAlpha(70)
        fmt.setBackground(QBrush(couleur))
        fmt.setProperty(QTextFormat.FullWidthSelection, True)
        sel = QTextEdit.ExtraSelection()
        sel.format = fmt
        c = QTextCursor(bloc)
        c.clearSelection()
        sel.cursor = c
        return [sel]

    def surligner_ligne_erreur(self, numero_ligne: Optional[int]):
        """Point d'entrée public (cf. callback_termine dans
        _executer_cellule) -- pose le surlignage rouge sur la ligne
        `numero_ligne` (1-based, tel que renvoyé par
        _extraire_ligne_erreur) et réapplique setExtraSelections en
        composant avec un éventuel surlignage Ctrl+F/Ctrl+D déjà actif.
        numero_ligne=None efface simplement le surlignage d'erreur
        (équivalent à effacer_surlignage_erreur, exposé séparément pour
        un appel plus explicite côté appelant)."""
        self._ligne_erreur_surlignee = numero_ligne
        notebook = self._notebook_parent()
        if notebook is not None:
            # Repasse par le point central existant : garantit qu'on ne
            # perd jamais le surlignage Ctrl+F/Ctrl+D en cours (cf.
            # _rafraichir_surlignage_multi_curseur), qui ne connaît que
            # cet éditeur-ci de toute façon (etat.get(...) renvoie [] par
            # défaut pour les autres cellules).
            notebook._rafraichir_surlignage_multi_curseur()
        else:
            self._appliquer_surlignage_occurrences([], [])

    def effacer_surlignage_erreur(self):
        """Retire le surlignage rouge de ligne d'erreur, s'il y en a un
        -- appelé dès que l'utilisateur retape dans l'éditeur (cf.
        textChanged plus bas) ou dès qu'une nouvelle exécution démarre,
        pour ne jamais laisser le surlignage pointer sur du code déjà
        modifié depuis l'erreur qui l'a déclenché."""
        if getattr(self, "_ligne_erreur_surlignee", None) is not None:
            self.surligner_ligne_erreur(None)

    # ------------------------------------------------------------------
    # PATCH (demande explicite utilisateur : clic droit -> "Aller à la
    # définition" ne slidait pas exactement jusqu'à la ligne visée, et
    # demandait un repère visuel façon "coloration de navigation" mais en
    # bleu) -- même principe que _ligne_erreur_surlignee/_selections_erreur
    # juste au-dessus (ExtraSelection, FullWidthSelection) mais :
    #   - couleur bleue (DarculaTheme.bleu_clair) au lieu de rouge, pour ne
    #     pas se confondre visuellement avec une ligne en erreur ;
    #   - TEMPORAIRE (retiré après un court délai via QTimer.singleShot),
    #     comme le flash de bordure de _surligner_cellule, plutôt que
    #     persistant jusqu'à modification du texte -- une navigation
    #     "aller à la définition" est un repère ponctuel, pas un état
    #     durable comme une erreur d'exécution.
    # ------------------------------------------------------------------

    def _selections_navigation(self) -> list:
        """Construit la (au plus une) ExtraSelection du flash bleu de
        navigation, d'après self._ligne_navigation_surlignee -- même
        raisonnement que _selections_erreur, séparé pour pouvoir être
        recombiné dans _appliquer_surlignage_occurrences sans dupliquer la
        construction du QTextCursor/format."""
        numero_ligne = getattr(self, "_ligne_navigation_surlignee", None)
        if numero_ligne is None:
            return []
        bloc = self.document().findBlockByNumber(numero_ligne - 1)
        if not bloc.isValid():
            return []
        fmt = QTextCharFormat()
        couleur = QColor(DarculaTheme.bleu_clair)
        couleur.setAlpha(70)
        fmt.setBackground(QBrush(couleur))
        fmt.setProperty(QTextFormat.FullWidthSelection, True)
        sel = QTextEdit.ExtraSelection()
        sel.format = fmt
        c = QTextCursor(bloc)
        c.clearSelection()
        sel.cursor = c
        return [sel]

    def flasher_ligne_navigation(self, numero_ligne: int, duree_ms: int = 1200):
        """Point d'entrée public (cf. TaskConfigScreen.aller_a_la_definition)
        -- pose le flash bleu sur `numero_ligne` (1-based) et le retire
        automatiquement après `duree_ms`. Un nouvel appel pendant qu'un
        flash est déjà actif remplace simplement la ligne visée (pas
        d'empilement de timers concurrents à démêler -- le dernier appelé
        l'emporte, cohérent avec le fait qu'une seule navigation à la fois
        a du sens pour l'utilisateur)."""
        self._ligne_navigation_surlignee = numero_ligne
        notebook = self._notebook_parent()
        if notebook is not None:
            notebook._rafraichir_surlignage_multi_curseur()
        else:
            self._appliquer_surlignage_occurrences([], [])

        def _retirer():
            # Défense si la ligne visée a été retapée/le flash déjà
            # remplacé par un appel plus récent entre-temps -- ne retire
            # que si c'est encore CE flash-ci qui est actif, pour ne pas
            # effacer par erreur une navigation plus récente déclenchée
            # avant l'expiration de celle-ci.
            if getattr(self, "_ligne_navigation_surlignee", None) != numero_ligne:
                return
            self._ligne_navigation_surlignee = None
            notebook2 = self._notebook_parent()
            if notebook2 is not None:
                notebook2._rafraichir_surlignage_multi_curseur()
            else:
                self._appliquer_surlignage_occurrences([], [])

        QTimer.singleShot(duree_ms, _retirer)

    def _propager_si_multi_curseur_actif(self, event):
        """Décode l'opération représentée par `event` (frappe de
        caractère, Backspace, Delete) et la transmet au notebook parent
        AVANT que Qt ne l'applique normalement à cet éditeur -- seulement
        si une édition multi-curseur (mode "edition") est active ET que
        cette cellule y participe. Ne fait rien pour les touches de
        navigation pure (flèches, Home/End...) ni les raccourcis déjà
        gérés ailleurs (Ctrl+/, Tab...) -- seule une frappe qui MODIFIE le
        texte doit être répercutée sur les autres occurrences."""
        notebook = self._notebook_parent()
        if notebook is None:
            return
        etat = notebook._multi_curseur_etat
        if etat is None or etat.get("mode") != "edition":
            return
        if self._cellule_id_associee not in etat["actives"]:
            return
        if self._applique_operation_multi_curseur:
            # Réentrance : cette frappe est elle-même le résultat d'une
            # propagation reçue d'une AUTRE cellule (cf.
            # _appliquer_operation_a_position) -- ne pas la repropager.
            return

        curseur = self.textCursor()
        position_avant = curseur.selectionStart()
        texte_selectionne = curseur.selectedText()

        touche = event.key()
        modificateurs = event.modifiers()
        est_edition_ctrl_ou_alt = bool(modificateurs & (Qt.ControlModifier | Qt.AltModifier)) and touche not in (
            Qt.Key_Backspace, Qt.Key_Delete,
        )
        if est_edition_ctrl_ou_alt:
            # Laisse passer les combinaisons Ctrl/Alt (copier/coller/
            # undo/redo...) sans les interpréter comme une frappe de
            # caractère simple -- trop de cas particuliers pour les
            # rejouer fidèlement, cf. limite documentée à l'utilisateur.
            return

        if touche == Qt.Key_Backspace:
            if texte_selectionne:
                self.propager_frappe_multi_curseur_texte(notebook, position_avant, "", len(texte_selectionne))
            else:
                self.propager_frappe_multi_curseur_texte(notebook, max(0, position_avant - 1), "", 1)
        elif touche == Qt.Key_Delete:
            self.propager_frappe_multi_curseur_texte(notebook, position_avant, "", 1 if not texte_selectionne else len(texte_selectionne))
        elif event.text() and event.text().isprintable():
            self.propager_frappe_multi_curseur_texte(notebook, position_avant, event.text(), len(texte_selectionne))
        elif touche in (Qt.Key_Return, Qt.Key_Enter):
            self.propager_frappe_multi_curseur_texte(notebook, position_avant, "\n", len(texte_selectionne))
        elif touche == Qt.Key_Tab:
            self.propager_frappe_multi_curseur_texte(notebook, position_avant, "    ", len(texte_selectionne))

    def propager_frappe_multi_curseur_texte(self, notebook: "TaskConfigScreen", position_avant: int, texte_insere: str, longueur_remplacee: int):
        """Petit relais vers TaskConfigScreen.propager_frappe_multi_curseur
        -- isolé dans sa propre méthode uniquement pour garder
        _propager_si_multi_curseur_actif lisible (un appel par branche de
        touche plutôt que de dupliquer les 4 arguments partout)."""
        notebook.propager_frappe_multi_curseur(
            self._cellule_id_associee, position_avant, texte_insere, longueur_remplacee
        )

    def _appliquer_operation_a_position(self, position: int, longueur_remplacee: int, texte_insere: str):
        """Applique programmatiquement, dans CET éditeur, la même
        opération qu'une frappe utilisateur aurait produite : retire
        `longueur_remplacee` caractères à partir de `position` puis insère
        `texte_insere` -- utilisé pour rejouer une frappe multi-curseur
        reçue d'une autre cellule (ou d'une autre occurrence de la même
        cellule, cf. TaskConfigScreen.propager_frappe_multi_curseur).

        _applique_operation_multi_curseur=True le temps de l'opération
        pour que le textChanged qu'elle déclenche ne soit pas réinterprété
        comme une nouvelle frappe utilisateur à repropager (cf.
        _propager_si_multi_curseur_actif)."""
        self._applique_operation_multi_curseur = True
        try:
            c = QTextCursor(self.document())
            c.setPosition(position)
            if longueur_remplacee:
                c.setPosition(position + longueur_remplacee, QTextCursor.KeepAnchor)
            if longueur_remplacee and texte_insere:
                c.insertText(texte_insere)
            elif longueur_remplacee:
                c.removeSelectedText()
            elif texte_insere:
                c.insertText(texte_insere)
        finally:
            self._applique_operation_multi_curseur = False

    def _gerer_auto_fermeture(self, event) -> bool:
        """Gère l'auto-fermeture des paires ( ) [ ] { } ' " -- retourne
        True si l'événement a été entièrement pris en charge ici (ne pas
        laisser super().keyPressEvent() le traiter en plus). Trois cas :

        1. Touche d'OUVRANT ( [ { ' " -- insère la paire complète et
           replace le curseur entre les deux (ex: "(" -> "()" avec le
           curseur avant le ")").
        2. Touche de FERMANT alors que le caractère juste après le curseur
           EST déjà ce même fermant -- "saute" par-dessus au lieu de
           dupliquer (évite de taper "(" puis ")" et de finir avec "())"),
           comportement standard de tout IDE.
        3. Backspace juste avant une paire vide fraîchement ouverte (ex:
           curseur entre "(" et ")" avec rien entre les deux) -- supprime
           les deux caractères d'un coup plutôt que de laisser un fermant
           orphelin.

        Guillemets : même logique que les autres paires plutôt qu'un cas
        spécial -- assez pour l'usage courant de cet éditeur (pas de
        distinction guillemet ouvrant/fermant façon traitement de texte,
        un script Python n'en a pas besoin)."""
        curseur = self.textCursor()
        texte_bloc = curseur.block().text()
        position = curseur.positionInBlock()
        caractere_suivant = texte_bloc[position] if position < len(texte_bloc) else ""
        caractere_precedent = texte_bloc[position - 1] if position > 0 else ""

        touche = event.key()
        texte_touche = event.text()

        # Cas 1 : ouvrant -- insère la paire, curseur entre les deux.
        if touche in self._PAIRES_AUTO_FERMEES and curseur.selectedText() == "":
            fermant = self._PAIRES_AUTO_FERMEES[touche]
            curseur.insertText(texte_touche + fermant)
            curseur.setPosition(curseur.position() - 1)
            self.setTextCursor(curseur)
            return True

        # Cas 2 : fermant tapé juste devant ce même fermant existant --
        # saute par-dessus au lieu de dupliquer.
        if texte_touche in self._FERMANTS and caractere_suivant == texte_touche:
            curseur.setPosition(curseur.position() + 1)
            self.setTextCursor(curseur)
            return True

        # Cas 3 : backspace entre une paire vide fraîchement ouverte --
        # supprime les deux d'un coup.
        if touche == Qt.Key_Backspace and curseur.selectedText() == "":
            paires_valides = {"(": ")", "[": "]", "{": "}", "'": "'", '"': '"'}
            if caractere_precedent in paires_valides and caractere_suivant == paires_valides[caractere_precedent]:
                curseur.deleteChar()
                curseur.deletePreviousChar()
                self.setTextCursor(curseur)
                return True

        return False

    def focusOutEvent(self, event):
        # Ne pas fermer le popup si c'est lui-même qui prend un focus
        # transitoire (il est NoFocus, donc en pratique ce cas ne se
        # présente pas, mais on protège quand même contre une fermeture
        # prématurée pendant un clic sur un item du popup).
        self._popup.hide()
        super().focusOutEvent(event)


class CelluleZoneMarkdown(QWidget):
    """Zone de texte Markdown éditable, utilisée pour le titre et la
    description d'une TaskCellule -- comme une cellule Markdown de notebook
    Jupyter : affichage en rendu formaté (gras, titres ##, code `inline`,
    etc. via Qt.MarkdownText) au repos, bascule vers le texte brut éditable
    au clic, et revient au rendu à la perte de focus (cohérent avec le
    pattern editingFinished déjà utilisé ailleurs dans l'app -- persistance
    à la perte de focus, pas à chaque frappe).

    Deux variantes : ligne unique (titre, QLineEdit) ou multi-lignes
    (description, QPlainTextEdit) -- cf. paramètre multiligne."""

    texte_modifie = Signal(str)

    def __init__(
        self,
        placeholder: str,
        objet_nom_affichage: str,
        objet_nom_edition: str,
        multiligne: bool = False,
        parent=None,
    ):
        super().__init__(parent)
        self._placeholder = placeholder
        self._multiligne = multiligne
        self._texte = ""

        self._layout = QVBoxLayout(self)
        self._layout.setContentsMargins(0, 0, 0, 0)
        self._layout.setSpacing(0)

        self._label = QLabel(self)
        self._label.setObjectName(objet_nom_affichage)
        self._label.setTextFormat(Qt.MarkdownText)
        self._label.setWordWrap(True)
        self._label.setAlignment(Qt.AlignLeft | Qt.AlignVCenter)
        self._label.setCursor(Qt.IBeamCursor)
        self._label.mousePressEvent = self._sur_clic_label
        self._layout.addWidget(self._label)

        if multiligne:
            self._editeur = QPlainTextEdit(self)
            self._editeur.setFixedHeight(60)
        else:
            self._editeur = QLineEdit(self)
        self._editeur.setObjectName(objet_nom_edition)
        self._editeur.hide()
        if multiligne:
            self._editeur.installEventFilter(self)
        else:
            self._editeur.editingFinished.connect(self._sur_fin_edition)
        self._layout.addWidget(self._editeur)

        self._afficher_rendu()

    def eventFilter(self, obj, event):
        if obj is self._editeur and event.type() == event.Type.FocusOut:
            self._sur_fin_edition()
        return super().eventFilter(obj, event)

    def definir_texte(self, texte: str):
        self._texte = texte or ""
        self._afficher_rendu()

    def texte_actuel(self) -> str:
        return self._texte

    def _afficher_rendu(self):
        if self._texte.strip():
            self._label.setText(self._texte)
            self._label.setProperty("vide", False)
        else:
            self._label.setText(self._placeholder)
            self._label.setProperty("vide", True)
        self._label.style().unpolish(self._label)
        self._label.style().polish(self._label)
        self._label.show()
        self._editeur.hide()

    def _sur_clic_label(self, event):
        if self._multiligne:
            self._editeur.setPlainText(self._texte)
        else:
            self._editeur.setText(self._texte)
        self._label.hide()
        self._editeur.show()
        self._editeur.setFocus()
        if not self._multiligne:
            self._editeur.selectAll()

    def _sur_fin_edition(self):
        nouveau = (
            self._editeur.toPlainText() if self._multiligne else self._editeur.text()
        ).strip()
        if nouveau != self._texte:
            self._texte = nouveau
            self.texte_modifie.emit(self._texte)
        self._afficher_rendu()


class QToolButtonAvecClicDroit(QToolButton):
    """QToolButton générique émettant un signal clic_droit distinct du
    clic gauche standard (clicked) -- factorisation du pattern déjà
    utilisé par BoutonAjoutCellule (ajout avant/après une cellule),
    réutilisé tel quel par TaskCelluleWidget.bouton_executer (clic droit =
    activer/désactiver la cellule, cf. demande_toggle_active)."""

    clic_droit = Signal()

    def mousePressEvent(self, event):
        if event.button() == Qt.RightButton:
            self.clic_droit.emit()
            return
        super().mousePressEvent(event)


class MenuAvecClicDroitSurAction(QMenu):
    """QMenu qui distingue le clic droit du clic gauche sur une entrée :
    le clic gauche garde le comportement standard (triggered), le clic
    droit émet clic_droit_action(QAction) et ferme le menu. Sans cette
    surcharge, Qt déclenche l'action sur n'importe quel bouton relâché,
    ce qui rendrait gauche et droit indiscernables."""

    clic_droit_action = Signal(QAction)

    def mouseReleaseEvent(self, event):
        if event.button() == Qt.RightButton:
            action = self.actionAt(event.position().toPoint())
            if action is not None and action.isEnabled() and not action.isSeparator():
                self.close()
                self.clic_droit_action.emit(action)
            else:
                event.accept()
            return
        super().mouseReleaseEvent(event)


class BoutonAjoutCellule(QToolButtonAvecClicDroit):
    """QToolButton du "+" d'ajout de cellule : clic gauche ajoute la
    nouvelle cellule après celle-ci (comportement standard, via le signal
    hérité clicked), clic droit l'ajoute avant (clic_droit) -- évite de
    dupliquer un bouton séparé juste pour l'insertion vers le haut."""


class _BloquableAffichageMixin:
    """PATCH (demande explicite utilisateur : "je veux pouvoir bloquer
    l'affichage de sortie" des cellules d'un notebook) -- mixin qui permet
    à un widget d'être MASQUÉ DE FORCE, de façon centralisée.

    POURQUOI un mixin plutôt que de tester le réglage aux endroits qui
    affichent la sortie : zone_sortie/entete_sortie sont montrées/cachées
    directement (`.show()`/`.hide()`/`.setVisible()`) à une bonne dizaine
    d'endroits, y compris HORS de TaskCelluleWidget (TaskConfigScreen :
    flux d'exécution réseau, réaffichage d'image, changement de profil...).
    Patcher chaque site serait fragile -- n'importe quel futur `.show()`
    ajouté ailleurs contournerait silencieusement le blocage. En
    interceptant setVisible() sur le widget LUI-MÊME, aucun appelant
    (existant ou futur) ne peut le réafficher tant que le blocage est actif.

    Le blocage ne touche QUE la visibilité : le texte/contenu du widget
    reste intact (lecture par "Copier", persistance...), et il redevient
    visible normalement au déblocage (cf. definir_bloque -- il rappelle
    la visibilité voulue par le dernier appelant, mémorisée dans
    _visibilite_demandee, pour ne pas réafficher un widget qui devait
    rester caché : ex. cellule sans sortie ou repliée).

    setVisible() est la SEULE méthode surchargée : show()/hide()/
    setHidden() de QWidget passent tous par elle en interne (vérifié
    empiriquement), donc aucune autre surcharge n'est nécessaire."""

    def _init_blocage_affichage(self):
        self._affichage_bloque = False
        # Dernière visibilité DEMANDÉE par le code appelant, indépendamment
        # du blocage -- sert à restaurer le bon état au déblocage.
        self._visibilite_demandee = False

    def est_affichage_bloque(self) -> bool:
        return self._affichage_bloque

    def definir_bloque(self, bloque: bool):
        if bloque == self._affichage_bloque:
            return
        self._affichage_bloque = bloque
        # Réapplique l'état effectif : caché si bloqué, sinon la
        # visibilité que le code appelant avait demandée en dernier.
        super().setVisible(False if bloque else self._visibilite_demandee)

    def setVisible(self, visible: bool):
        self._visibilite_demandee = bool(visible)
        super().setVisible(False if self._affichage_bloque else bool(visible))


class LabelSortieCellule(_BloquableAffichageMixin, QLabel):
    """QLabel de sortie d'une cellule (cf. TaskCelluleWidget.zone_sortie),
    dont l'affichage peut être bloqué -- cf. _BloquableAffichageMixin."""

    def __init__(self, *args, **kwargs):
        super().__init__(*args, **kwargs)
        self._init_blocage_affichage()


class EnteteSortieCellule(_BloquableAffichageMixin, QWidget):
    """En-tête de sortie (boutons copier/vider, cf.
    TaskCelluleWidget.entete_sortie), dont l'affichage peut être bloqué --
    cf. _BloquableAffichageMixin. Bloqué EN MÊME TEMPS que la zone de sortie :
    des boutons copier/vider sans sortie visible n'auraient aucun sens."""

    def __init__(self, *args, **kwargs):
        super().__init__(*args, **kwargs)
        self._init_blocage_affichage()


# ======================================================================
# PATCH (spec « éditeur partagé et cellules virtuelles », ÉTAPE 2)
#
# Au lieu d'un QPlainTextEdit complet PAR cellule, chaque cellule ne porte
# plus qu'un QTextDocument (SessionCellule) peint par une vue légère
# (VueCelluleStatique) ; UN SEUL TaskScriptEditor (PartageEditeur) est
# déplacé dans la cellule active. ProxyEditeur garde l'API historique
# `cadre.editeur` pour les ~50 sites d'appel de TaskConfigScreen.
#
# Tout ceci n'est utilisé que si EDITEUR_PARTAGE est actif ET que le retour
# à la ligne est désactivé (cf. PartageEditeur.disponible) : la hauteur
# d'une cellule vaut alors EXACTEMENT blockCount() * lineSpacing() + marges
# (cf. TaskScriptEditor._ajuster_hauteur), sans aucune mesure. Désactivé,
# aucune de ces classes n'est instanciée.
#
# Règles respectées : aucun processEvents ; aucun widget construit hors du
# thread principal ; l'éditeur partagé n'est JAMAIS emporté par la
# destruction d'un cadre (cf. PartageEditeur.desactiver, appelé avant tout
# retrait de cadre).
# ======================================================================
import shiboken6 as _shiboken
from types import SimpleNamespace as _SimpleNamespace
from PySide6.QtGui import (
    QRegion,
    QTextDocument as _QTextDocument,
    QContextMenuEvent as _QContextMenuEvent,
    QTextLayout as _QTextLayout,
)
from PySide6.QtWidgets import QPlainTextDocumentLayout as _QPlainTextDocumentLayout


def _vivant(objet) -> bool:
    """True si l'objet Qt existe encore côté C++ (un cadre détruit laisse un
    wrapper Python dont tout accès lèverait RuntimeError)."""
    try:
        return objet is not None and _shiboken.isValid(objet)
    except Exception:
        return False


def _etat_initial_session() -> dict:
    """État que l'éditeur partagé porte NORMALEMENT lui-même (cf.
    TaskScriptEditor.__init__) et qui doit pourtant rester propre à chaque
    cellule : noms connus (influencent la coloration et l'auto-complétion),
    surlignages d'erreur/navigation. Copié dans l'éditeur à l'activation,
    relu à la désactivation."""
    return {
        "_composants_connus": set(),
        "_composants_layout_connus": set(),
        "_services_api_connus": set(),
        "_variables_globales_connues": set(),
        "_instances_globales_connues": set(),
        "_resultats_globaux_connus": set(),
        "_noms_connus_appliques": None,
        "_ligne_erreur_surlignee": None,
        "_ligne_navigation_surlignee": None,
    }


class SessionCellule:
    """Tout ce qui appartient à UNE cellule quand elle n'a pas d'éditeur :
    son document (texte, historique Ctrl+Z, coloration), la position du
    curseur sauvegardée, ses noms connus et ses surlignages. Créer une
    session ne construit AUCUN widget.

    C'est aussi la couche d'accès unique de la spec (code_actuel,
    definir_code, definir_noms_connus..., surligner_ligne_erreur,
    donner_focus, curseur) : chaque méthode agit sur l'éditeur partagé si
    cette cellule est active, sur le document sinon -- l'appelant n'a pas à
    le savoir."""

    def __init__(self, partage: "PartageEditeur", cellule_id: str, code: str):
        self.partage = partage
        self.cellule_id = cellule_id
        self.frame = None                      # TaskCelluleWidget courant (ou None)
        self.etat = _etat_initial_session()
        self.curseur_pos = (0, 0)              # (ancre, position) quand inactive
        self.occurrences: list = []            # surlignage Ctrl+F / Ctrl+D
        self.actives: list = []
        self.signaux_bloques = False           # équivalent de editeur.blockSignals
        self.doc = _QTextDocument(partage)     # parent = partage : jamais détruit par un éditeur
        self.doc.setDocumentLayout(_QPlainTextDocumentLayout(self.doc))
        self.formater_document()
        # PATCH (étape 4) : pas de highlighter ici -- une cellule non montée
        # n'est jamais peinte, donc jamais colorée. Il est attaché par
        # colorer() quand un cadre se lie à la cellule (ou à l'activation).
        self.highlighter = None
        self.doc.setPlainText(code)
        self._revision = self.doc.revision()
        self.doc.contentsChanged.connect(self._sur_contenu)

    # -- coloration paresseuse (PATCH étape 4) ------------------------
    def colorer(self):
        """Attache le coloriseur au document, avec les noms connus déjà
        mémorisés, en UNE seule passe (le coloriseur est d'abord créé sur un
        document vide, réglé, puis déplacé sur le vrai document)."""
        if self.highlighter is not None:
            return
        tmp = _QTextDocument(self.partage)
        h = PythonHighlighter(tmp)
        comp = set(self.etat.get("_composants_connus", ())) | set(self.etat.get("_composants_layout_connus", ()))
        serv = set(self.etat.get("_services_api_connus", ()))
        if comp or serv:
            h.definir_noms_connus_en_une_passe(list(comp), list(serv))
        h.setDocument(self.doc)
        h.rehighlight()                # synchrone : coloré avant la première peinture
        h.setParent(self.doc)          # tmp va être supprimé : h ne doit pas partir avec
        tmp.deleteLater()
        self.highlighter = h

    def decolorer(self):
        """Détache le coloriseur (Qt efface alors les formats du document).
        Jamais sur la cellule active : l'éditeur partagé s'en sert."""
        h = self.highlighter
        if h is None or self.est_active():
            return
        self.highlighter = None
        try:
            h.setDocument(None)
        except Exception:
            pass
        h.deleteLater()

    # -- état ---------------------------------------------------------
    def est_active(self) -> bool:
        return self.partage.session_active is self

    def frame_valide(self):
        return self.frame if _vivant(self.frame) else None

    def _editeur_si_actif(self):
        return self.partage.editeur() if self.est_active() else None

    def formater_document(self):
        """Police, marge et options de texte IDENTIQUES à celles de l'éditeur
        (sinon la vue sauterait au changement de cellule active)."""
        m = self.partage.metriques()
        self.doc.setDefaultFont(m.police)
        self.doc.setDocumentMargin(m.marge_document)
        self.doc.setDefaultTextOption(m.option_texte)

    def hauteur(self) -> int:
        m = self.partage.metriques()
        return self.doc.blockCount() * m.interligne + m.pad_h

    def largeur_numeros(self) -> int:
        m = self.partage.metriques()
        chiffres = len(str(max(1, self.doc.blockCount())))
        return m.larg_num_1 + m.adv_chiffre * (chiffres - 1)

    def _sur_contenu(self):
        rev = self.doc.revision()
        if rev == self._revision:   # formatage de coloration, pas une édition
            return
        self._revision = rev
        frame = self.frame_valide()
        if not self.est_active():
            # Comme TaskScriptEditor._sur_texte_modifie : un surlignage
            # d'erreur ne survit pas à une modification du texte.
            self.etat["_ligne_erreur_surlignee"] = None
            if frame is not None:
                frame._rafraichir_vue()
        if frame is None or getattr(frame, "_lier_en_cours", False) or self.signaux_bloques:
            return
        frame.code_modifie.emit(self.cellule_id)

    def _notebook(self):
        w = self.frame_valide()
        while w is not None:
            if isinstance(w, TaskConfigScreen):
                return w
            w = w.parentWidget()
        return None

    # -- code et curseur ----------------------------------------------
    def code_actuel(self) -> str:
        return self.doc.toPlainText()

    def definir_code(self, texte: str):
        ed = self._editeur_si_actif()
        if ed is not None:
            ed.setPlainText(texte)
        else:
            self.doc.setPlainText(texte)

    def curseur(self) -> QTextCursor:
        ed = self._editeur_si_actif()
        if ed is not None:
            return ed.textCursor()
        c = QTextCursor(self.doc)
        ancre, pos = self.curseur_pos
        n = max(0, self.doc.characterCount() - 1)
        c.setPosition(min(ancre, n))
        c.setPosition(min(pos, n), QTextCursor.KeepAnchor)
        return c

    def definir_curseur(self, curseur: QTextCursor):
        ed = self._editeur_si_actif()
        if ed is not None:
            ed.setTextCursor(curseur)
        else:
            self.curseur_pos = (curseur.anchor(), curseur.position())

    def donner_focus(self):
        self.partage.activer(self, focus=True)

    # -- surlignages --------------------------------------------------
    def _lire_etat(self, nom):
        ed = self._editeur_si_actif()
        return getattr(ed, nom, None) if ed is not None else self.etat.get(nom)

    def _ecrire_etat(self, nom, valeur):
        ed = self._editeur_si_actif()
        if ed is not None:
            setattr(ed, nom, valeur)
        else:
            self.etat[nom] = valeur

    def _rafraichir_surlignages(self):
        nb = self._notebook()
        if nb is not None:
            nb._rafraichir_surlignage_multi_curseur()
        else:
            self.appliquer_surlignage_occurrences([], [])

    def appliquer_surlignage_occurrences(self, occurrences: list, actives: list):
        self.occurrences = list(occurrences)
        self.actives = list(actives)
        ed = self._editeur_si_actif()
        if ed is not None:
            ed._appliquer_surlignage_occurrences(occurrences, actives)
        else:
            frame = self.frame_valide()
            if frame is not None and frame._vue is not None:
                frame._vue.update()

    def surligner_ligne_erreur(self, numero_ligne):
        ed = self._editeur_si_actif()
        if ed is not None:
            ed.surligner_ligne_erreur(numero_ligne)
            return
        self.etat["_ligne_erreur_surlignee"] = numero_ligne
        self._rafraichir_surlignages()

    def effacer_surlignage_erreur(self):
        ed = self._editeur_si_actif()
        if ed is not None:
            ed.effacer_surlignage_erreur()
        elif self.etat["_ligne_erreur_surlignee"] is not None:
            self.surligner_ligne_erreur(None)

    def flasher_ligne_navigation(self, numero_ligne: int, duree_ms: int = 1200):
        ed = self._editeur_si_actif()
        if ed is not None:
            ed.flasher_ligne_navigation(numero_ligne, duree_ms)
            return
        self.etat["_ligne_navigation_surlignee"] = numero_ligne
        self._rafraichir_surlignages()

        def _retirer():
            if self._lire_etat("_ligne_navigation_surlignee") != numero_ligne:
                return
            self._ecrire_etat("_ligne_navigation_surlignee", None)
            self._rafraichir_surlignages()
        QTimer.singleShot(duree_ms, _retirer)

    # -- noms connus (coloration + auto-complétion) -------------------
    def definir_composants_connus(self, noms):
        ed = self._editeur_si_actif()
        if ed is not None:
            ed.definir_composants_connus(noms)
            return
        self.etat["_noms_connus_appliques"] = None
        self.etat["_composants_connus"] = set(noms)
        if self.highlighter is not None:   # PATCH (étape 4)
            self.highlighter.definir_composants_connus(noms)

    def definir_composants_layout_connus(self, noms):
        ed = self._editeur_si_actif()
        if ed is not None:
            ed.definir_composants_layout_connus(noms)
            return
        self.etat["_noms_connus_appliques"] = None
        self.etat["_composants_layout_connus"] = set(noms)
        if self.highlighter is not None:   # PATCH (étape 4)
            self.highlighter.definir_composants_connus(
                list(self.etat["_composants_connus"] | self.etat["_composants_layout_connus"]))

    def definir_services_api_connus(self, noms):
        ed = self._editeur_si_actif()
        if ed is not None:
            ed.definir_services_api_connus(noms)
            return
        self.etat["_noms_connus_appliques"] = None
        self.etat["_services_api_connus"] = set(noms)
        if self.highlighter is not None:   # PATCH (étape 4)
            self.highlighter.definir_services_api_connus(noms)

    def definir_noms_connus_en_une_passe(self, noms_composants, noms_composants_layout, noms_services_api):
        ed = self._editeur_si_actif()
        if ed is not None:
            ed.definir_noms_connus_en_une_passe(noms_composants, noms_composants_layout, noms_services_api)
            return
        nouveaux = (frozenset(noms_composants), frozenset(noms_composants_layout), frozenset(noms_services_api))
        if self.etat["_noms_connus_appliques"] == nouveaux:
            return
        self.etat["_noms_connus_appliques"] = nouveaux
        self.etat["_composants_connus"] = set(noms_composants)
        self.etat["_composants_layout_connus"] = set(noms_composants_layout)
        self.etat["_services_api_connus"] = set(noms_services_api)
        if self.highlighter is not None:   # PATCH (étape 4)
            self.highlighter.definir_noms_connus_en_une_passe(
                list(self.etat["_composants_connus"] | self.etat["_composants_layout_connus"]),
                noms_services_api,
            )
        # _instances_connues & co dépendent du texte : recalculées à l'activation.

    def definir_variables_globales_connues(self, noms):
        self._ecrire_etat("_variables_globales_connues", set(noms))

    def definir_instances_globales_connues(self, noms):
        self._ecrire_etat("_instances_globales_connues", set(noms))

    def definir_resultats_globaux_connus(self, noms):
        self._ecrire_etat("_resultats_globaux_connus", set(noms))


class PartageEditeur(QObject):
    """Possède l'UNIQUE TaskScriptEditor d'un notebook et les sessions de
    toutes ses cellules. L'éditeur vit « garé » (caché, dans un widget de
    parking) tant qu'aucune cellule n'est active, et n'est donc jamais
    détruit avec un cadre."""

    @staticmethod
    def disponible(reglages) -> bool:
        """Interrupteur + prérequis. Le retour à la ligne n'est pas pris en
        charge (hauteurs non calculables sans mesure) : s'il est actif, on
        retombe sur le comportement classique."""
        if not EDITEUR_PARTAGE:
            return False
        return not bool(reglages is not None and getattr(reglages, "retour_a_la_ligne_editeur_script", False))

    def __init__(self, reglages=None, parent=None):
        super().__init__(parent if isinstance(parent, QObject) else None)
        self.reglages = reglages
        self.session_active: Optional[SessionCellule] = None
        self._sessions: dict = {}
        self._editeur = None
        self._parking = None
        self._doc_attente = None
        self._metr = None
        self._taille = reglages.taille_police_editeur_script if reglages is not None else 14

    # -- sessions -----------------------------------------------------
    def session_pour(self, cellule_id: str, code: str) -> SessionCellule:
        s = self._sessions.get(cellule_id)
        if s is None:
            s = SessionCellule(self, cellule_id, code)
            self._sessions[cellule_id] = s
        return s

    def oublier_session(self, cellule_id: str):
        s = self._sessions.get(cellule_id)
        if s is None:
            return
        if self.session_active is s:
            self.desactiver()
        self._sessions.pop(cellule_id, None)
        s.doc.deleteLater()

    # -- métriques : lues UNE fois sur un éditeur réel -----------------
    def metriques(self):
        if self._metr is None:
            self._metr = self._mesurer()
        return self._metr

    def _mesurer(self):
        """Mesure sur un éditeur jetable (même feuille de style, même
        police) tout ce dont la vue a besoin pour peindre au pixel près :
        c'est exactement ce que fait proto_vue.py (0 pixel d'écart)."""
        hote = QWidget()
        hote.setAttribute(Qt.WA_DontShowOnScreen, True)
        hote.resize(520, 300)
        ed = TaskScriptEditor(self.reglages, hote)
        ed.appliquer_taille_police(self._taille)
        ed.setPlainText("a\nb\nc")
        hote.show()
        ed.show()
        ed._ajuster_hauteur()
        ed.setGeometry(0, 0, 520, ed.height())
        # Rendu SANS fond de fenêtre sur une image transparente : grab() y
        # mettrait le fond de la fenêtre hôte, alors que dans un cadre les
        # coins arrondis laissent voir le fond du cadre.
        dpr = ed.devicePixelRatioF()
        img = QImage(int(ed.width() * dpr), int(ed.height() * dpr), QImage.Format_ARGB32_Premultiplied)
        img.setDevicePixelRatio(dpr)
        img.fill(Qt.transparent)
        pr = QPainter(img)
        ed.render(pr, QPoint(), QRegion(), QWidget.RenderFlag.DrawChildren)
        pr.end()
        vp = ed.viewport().geometry()
        zone = ed._zone_numeros_lignes.geometry()
        off = ed.contentOffset()
        interligne = ed.fontMetrics().lineSpacing()
        larg_num_1 = ed.line_number_area_width()
        W, H = ed.width(), ed.height()
        c = RADIUS + 2
        s = img.devicePixelRatio() or 1.0
        patchs = [
            img.copy(int(x * s), int(y * s), int(c * s), int(c * s))
            for (x, y) in ((0, 0), (W - c, 0), (0, H - c), (W - c, H - c))
        ]
        m = _SimpleNamespace(
            police=QFont(ed.font()),
            police_numeros=QFont(ed._zone_numeros_lignes.font()),
            option_texte=ed.document().defaultTextOption(),
            marge_document=ed.document().documentMargin(),
            interligne=interligne,
            pad_h=ed.height() - 3 * interligne,
            hauteur_ligne=ed.fontMetrics().height(),
            larg_num_1=larg_num_1,
            adv_chiffre=ed.fontMetrics().horizontalAdvance("9"),
            base_x=vp.x() - larg_num_1,
            zone_x=zone.x(), zone_y=zone.y(),
            vp_y=vp.y(),
            x_delta=off.x(),
            y_texte=vp.y() + off.y() + ed.blockBoundingGeometry(ed.document().begin()).top(),
            marge_droite=W - (vp.x() + vp.width()),
            coin=c, patchs=patchs,
        )
        hote.hide()
        hote.deleteLater()
        return m

    # -- l'éditeur partagé ---------------------------------------------
    def editeur(self) -> "TaskScriptEditor":
        if not _vivant(self._editeur):
            self._creer_editeur()
        return self._editeur

    def _creer_editeur(self):
        self.session_active = None
        parent_w = self.parent() if isinstance(self.parent(), QWidget) else None
        self._parking = QWidget(parent_w)
        self._parking.hide()
        ed = TaskScriptEditor(self.reglages, self._parking)
        ed.appliquer_taille_police(self._taille)
        # Le document d'origine de l'éditeur est SON enfant : Qt le détruit au
        # premier setDocument(), avec son highlighter. On le remplace tout de
        # suite par un document d'attente qui appartient à ce partage.
        doc0 = _QTextDocument(self)
        doc0.setDocumentLayout(_QPlainTextDocumentLayout(doc0))
        m = self.metriques()
        doc0.setDefaultFont(m.police)
        doc0.setDocumentMargin(m.marge_document)
        doc0.setDefaultTextOption(m.option_texte)
        ed.blockSignals(True)
        ed.setDocument(doc0)
        ed.blockSignals(False)
        ed._highlighter = PythonHighlighter(doc0)
        ed._mettre_a_jour_largeur_zone_numeros(0)
        ed.hide()
        self._doc_attente = doc0
        self._editeur = ed

    def activer(self, session: SessionCellule, focus: bool = False):
        """Déplace l'éditeur partagé dans le cadre de `session` (et rend la
        main à la vue légère de la cellule précédente). Retourne l'éditeur,
        ou None si la cellule n'est pas montée."""
        frame = session.frame_valide()
        if frame is None or frame._vue is None:
            return None
        ed = self.editeur()
        if self.session_active is session:
            if focus:
                ed.setFocus()
            return ed
        self.desactiver()
        vue = frame._vue
        lay = frame._colonne_layout
        if lay.indexOf(vue) < 0:
            return None
        visible = not vue.isHidden()
        geo = vue.geometry()

        session.colorer()   # PATCH (étape 4)
        ed.blockSignals(True)
        ed.setDocument(session.doc)
        ed._highlighter = session.highlighter
        for nom, val in session.etat.items():
            setattr(ed, nom, set(val) if isinstance(val, set) else val)
        ed._cellule_id_associee = session.cellule_id
        ed._popup.hide()
        ed.blockSignals(False)

        lay.replaceWidget(vue, ed)
        vue.hide()
        ed.setVisible(visible)
        ed.setGeometry(geo)
        self.session_active = session
        ed._mettre_a_jour_largeur_zone_numeros(0)
        ed._ajuster_hauteur()
        ed._rescanner_instances_connues()
        ed._rescanner_zones_connues()
        ed._rescanner_variables_connues()
        ancre, pos = session.curseur_pos
        n = max(0, session.doc.characterCount() - 1)
        c = QTextCursor(session.doc)
        c.setPosition(min(ancre, n))
        c.setPosition(min(pos, n), QTextCursor.KeepAnchor)
        ed.setTextCursor(c)
        ed._appliquer_surlignage_occurrences(session.occurrences, session.actives)
        if focus:
            ed.setFocus()
        return ed

    def desactiver(self):
        """Rend la main à la vue légère et gare l'éditeur. À appeler AVANT de
        retirer ou détruire le cadre qui le porte."""
        s = self.session_active
        self.session_active = None
        if s is None:
            return
        if not _vivant(self._editeur):
            self._editeur = None
            return
        ed = self._editeur
        c = ed.textCursor()
        s.curseur_pos = (c.anchor(), c.position())
        for nom in s.etat:
            val = getattr(ed, nom, s.etat[nom])
            s.etat[nom] = set(val) if isinstance(val, set) else val
        ed._popup.hide()
        ed.clearFocus()
        frame = s.frame_valide()
        if frame is not None and frame._vue is not None and _vivant(frame._vue):
            visible = not ed.isHidden()
            lay = frame._colonne_layout
            if lay.indexOf(ed) >= 0:
                lay.replaceWidget(ed, frame._vue)
            frame._vue.setVisible(visible)
            frame._rafraichir_vue()
        ed.hide()
        ed.setParent(self._parking)
        ed.blockSignals(True)
        ed.setDocument(self._doc_attente)
        ed.blockSignals(False)

    # -- réglages globaux ----------------------------------------------
    def appliquer_taille_police(self, taille_pt: int):
        taille_pt = max(8, min(24, taille_pt))
        if taille_pt == self._taille and self._metr is not None:
            return
        self._taille = taille_pt
        if _vivant(self._editeur):
            self._editeur.appliquer_taille_police(taille_pt)
        self._metr = None
        m = self.metriques()
        if _vivant(self._doc_attente):
            self._doc_attente.setDefaultFont(m.police)
        for s in self._sessions.values():
            if not s.est_active():
                s.formater_document()
            else:
                s.doc.setDefaultFont(m.police)
            frame = s.frame_valide()
            if frame is not None:
                frame._rafraichir_vue()


class VueCelluleStatique(QWidget):
    """Peint le document d'une cellule INACTIVE à l'identique de
    TaskScriptEditor (cadre, coins, numéros, texte coloré, surlignages) sans
    en être un : pas de feuille de style, pas de popup, pas de barres de
    défilement. Validé au pixel par proto_vue.py. Un clic la remplace par
    l'éditeur partagé, au même endroit."""

    def __init__(self, partage: PartageEditeur, parent=None):
        super().__init__(parent)
        self.setObjectName("VueCelluleStatique")
        self._partage = partage
        self._session: Optional[SessionCellule] = None
        self.setSizePolicy(QSizePolicy.Expanding, QSizePolicy.Fixed)
        self.setCursor(Qt.IBeamCursor)

    def definir_session(self, session: SessionCellule):
        self._session = session
        self.setFixedHeight(session.hauteur())
        self.update()

    # -- peinture ------------------------------------------------------
    def paintEvent(self, ev):
        s = self._session
        if s is None:
            return
        m = self._partage.metriques()
        D = DarculaTheme
        W, H = self.width(), self.height()
        doc = s.doc
        lay = doc.documentLayout()
        p = QPainter(self)
        # Cadre QSS : fond, bordure 1px, rayon -- peints HORS des 4 carrés de
        # coin, qui viennent des patchs pré-rendus (coins transparents : le
        # fond du cadre doit y rester visible, comme avec le vrai éditeur).
        c = m.coin
        pos_coins = ((0, 0), (W - c, 0), (0, H - c), (W - c, H - c))
        zone = QRegion(self.rect())
        for (px, py) in pos_coins:
            zone = zone.subtracted(QRegion(QRect(px, py, c, c)))
        p.setClipRegion(zone)
        p.setRenderHint(QPainter.Antialiasing, True)
        p.fillRect(self.rect(), QColor(D.fond))
        p.setPen(QPen(QColor(D.bordure), 1))
        p.setBrush(Qt.NoBrush)
        p.drawRoundedRect(QRectF(0.5, 0.5, W - 1, H - 1), RADIUS, RADIUS)
        p.setRenderHint(QPainter.Antialiasing, False)
        p.setClipping(False)
        for (px, py), patch in zip(pos_coins, m.patchs):
            p.drawImage(px, py, patch)

        haut_vis, bas_vis = ev.rect().top(), ev.rect().bottom()
        numw = s.largeur_numeros()
        vp_x = m.base_x + numw
        zone_h = H - 2 * m.zone_y
        rect_num = QRect(m.zone_x, m.zone_y, numw, zone_h)
        p.fillRect(rect_num, QColor(D.fond_ligne_courante))

        # Numéros de ligne.
        p.save()
        p.setClipRect(rect_num)
        p.setFont(m.police_numeros)
        p.setPen(QColor(D.commentaire))
        y = m.y_texte
        bloc = doc.begin()
        while bloc.isValid():
            h = int(lay.blockBoundingRect(bloc).height())
            if y > bas_vis:
                break
            if y + h >= haut_vis:
                p.drawText(m.zone_x, int(y), numw - 6, m.hauteur_ligne, Qt.AlignRight, str(bloc.blockNumber() + 1))
            y += h
            bloc = bloc.next()
        p.restore()

        # Texte, bloc par bloc (le draw() de QPlainTextDocumentLayout est vide).
        p.save()
        p.setClipRect(QRect(vp_x, m.vp_y, W - vp_x - m.marge_droite, H - 2 * m.vp_y))
        p.setPen(QColor(D.texte))
        x = vp_x + m.x_delta
        y = m.y_texte
        ligne_err = s.etat.get("_ligne_erreur_surlignee")
        ligne_nav = s.etat.get("_ligne_navigation_surlignee")
        x0 = x + doc.documentMargin()
        x1 = W - m.marge_droite - 2
        actives = set(s.actives)
        bloc = doc.begin()
        while bloc.isValid():
            hb = lay.blockBoundingRect(bloc).height()
            if y > bas_vis:
                break
            if y + hb >= haut_vis:
                numero = bloc.blockNumber() + 1
                # Même rectangle que le vrai éditeur (mesuré : de vp.x + marge
                # du document jusqu'à vp.right() - 2).
                for ligne, couleur, alpha in ((ligne_err, D.rouge, 70), (ligne_nav, D.bleu_clair, 70)):
                    if ligne is not None and numero == ligne:
                        col = QColor(couleur)
                        col.setAlpha(alpha)
                        p.fillRect(QRectF(x0, y, x1 - x0, hb), col)
                selections = self._selections_occurrences(bloc, actives) if s.occurrences else None
                if selections:
                    bloc.layout().draw(p, QPointF(x, y), selections)
                else:
                    bloc.layout().draw(p, QPointF(x, y))
            y += hb
            bloc = bloc.next()
        p.restore()
        p.end()

    def _selections_occurrences(self, bloc, actives: set) -> list:
        """Surlignage Ctrl+F / Ctrl+D des occurrences qui touchent ce bloc
        (mêmes teintes que TaskScriptEditor._appliquer_surlignage_occurrences)."""
        debut_bloc = bloc.position()
        # length() INCLUT le séparateur de paragraphe : une sélection qui le
        # traverse le surligne aussi (Qt le peint comme un espace).
        fin_bloc = debut_bloc + bloc.length()
        res = []
        for debut, fin in self._session.occurrences:
            if fin <= debut_bloc or debut >= fin_bloc:
                continue
            fmt = QTextCharFormat()
            if (debut, fin) in actives:
                couleur = QColor(DarculaTheme.jaune)
                couleur.setAlpha(90)
            else:
                couleur = QColor(DarculaTheme.selection)
                couleur.setAlpha(140)
            fmt.setBackground(QBrush(couleur))
            r = _QTextLayout.FormatRange()
            r.start = max(debut, debut_bloc) - debut_bloc
            r.length = min(fin, fin_bloc) - max(debut, debut_bloc)
            r.format = fmt
            res.append(r)
        return res

    # -- interaction : un clic rend la cellule active --------------------
    def mousePressEvent(self, ev):
        s = self._session
        if s is None or ev.button() != Qt.LeftButton:
            super().mousePressEvent(ev)
            return
        pos = ev.position().toPoint()
        ed = self._partage.activer(s, focus=True)
        if ed is not None:
            ed.setTextCursor(ed.cursorForPosition(pos - ed.viewport().pos()))
        ev.accept()

    def contextMenuEvent(self, ev):
        s = self._session
        if s is None:
            return
        ed = self._partage.activer(s, focus=True)
        if ed is not None:
            ev2 = _QContextMenuEvent(ev.reason(), ev.pos(), ev.globalPos())
            QTimer.singleShot(0, lambda: QApplication.sendEvent(ed, ev2))
        ev.accept()


class ProxyEditeur:
    """Ce que `TaskCelluleWidget.editeur` renvoie en mode partagé. Ce n'est
    PAS un QWidget : ne jamais le passer à une API Qt (layout, mapTo,
    setTabOrder...). Les opérations qui n'ont besoin que du document
    (texte, curseur, surlignages, noms connus) passent par la session sans
    rien activer ; tout le reste (cursorRect, mapTo, viewport...) active la
    cellule et s'adresse à l'éditeur partagé réel."""

    __slots__ = ("_frame",)

    def __init__(self, frame):
        object.__setattr__(self, "_frame", frame)

    @property
    def _session(self) -> SessionCellule:
        return self._frame._session

    # -- texte et curseur ------------------------------------------------
    def toPlainText(self) -> str:
        return self._session.code_actuel()

    def setPlainText(self, texte: str):
        self._session.definir_code(texte)

    def textCursor(self) -> QTextCursor:
        return self._session.curseur()

    def setTextCursor(self, curseur: QTextCursor):
        self._session.definir_curseur(curseur)

    def document(self):
        return self._session.doc

    def blockSignals(self, bloquer: bool) -> bool:
        s = self._session
        avant = s.signaux_bloques
        s.signaux_bloques = bool(bloquer)
        ed = s._editeur_si_actif()
        if ed is not None:
            ed.blockSignals(bool(bloquer))
        return avant

    def _appliquer_operation_a_position(self, position, longueur_remplacee, texte_insere):
        ed = self._session._editeur_si_actif()
        if ed is not None:
            ed._appliquer_operation_a_position(position, longueur_remplacee, texte_insere)
            return
        c = QTextCursor(self._session.doc)
        c.setPosition(position)
        if longueur_remplacee:
            c.setPosition(position + longueur_remplacee, QTextCursor.KeepAnchor)
        if longueur_remplacee and texte_insere:
            c.insertText(texte_insere)
        elif longueur_remplacee:
            c.removeSelectedText()
        elif texte_insere:
            c.insertText(texte_insere)

    # -- surlignages -----------------------------------------------------
    def surligner_ligne_erreur(self, numero_ligne):
        self._session.surligner_ligne_erreur(numero_ligne)

    def effacer_surlignage_erreur(self):
        self._session.effacer_surlignage_erreur()

    def flasher_ligne_navigation(self, numero_ligne, duree_ms=1200):
        self._session.flasher_ligne_navigation(numero_ligne, duree_ms)

    def _appliquer_surlignage_occurrences(self, occurrences, actives):
        self._session.appliquer_surlignage_occurrences(occurrences, actives)

    # -- identité et noms connus -----------------------------------------
    def cellule_id_associee(self):
        return self._session.cellule_id

    def definir_composants_connus(self, noms):
        self._session.definir_composants_connus(noms)

    def definir_composants_layout_connus(self, noms):
        self._session.definir_composants_layout_connus(noms)

    def definir_services_api_connus(self, noms):
        self._session.definir_services_api_connus(noms)

    def definir_noms_connus_en_une_passe(self, noms_composants, noms_composants_layout, noms_services_api):
        self._session.definir_noms_connus_en_une_passe(noms_composants, noms_composants_layout, noms_services_api)

    def definir_variables_globales_connues(self, noms):
        self._session.definir_variables_globales_connues(noms)

    def definir_instances_globales_connues(self, noms):
        self._session.definir_instances_globales_connues(noms)

    def definir_resultats_globaux_connus(self, noms):
        self._session.definir_resultats_globaux_connus(noms)

    # -- police, hauteur, retour à la ligne --------------------------------
    def appliquer_taille_police(self, taille_pt: int, forcer: bool = False):
        self._session.partage.appliquer_taille_police(taille_pt)

    def setFont(self, police):
        self._session.partage.appliquer_taille_police(police.pointSize())

    def definir_retour_a_la_ligne(self, actif: bool):
        """Non pris en charge en mode partagé (cf. PartageEditeur.disponible) :
        sans effet. Le prochain notebook ouvert avec ce réglage actif
        retombera sur le comportement classique."""

    def setLineWrapMode(self, mode):
        """Idem definir_retour_a_la_ligne."""

    def _ajuster_hauteur(self, *_args):
        s = self._session
        ed = s._editeur_si_actif()
        if ed is not None:
            ed._ajuster_hauteur()
        else:
            self._frame._rafraichir_vue()

    # -- focus et visibilité -----------------------------------------------
    def setFocus(self, *_args):
        self._session.donner_focus()

    def donner_focus(self):
        self._session.donner_focus()

    def hasFocus(self) -> bool:
        ed = self._session._editeur_si_actif()
        return bool(ed is not None and ed.hasFocus())

    def setVisible(self, visible: bool):
        self._frame._widget_code().setVisible(visible)

    def show(self):
        self.setVisible(True)

    def hide(self):
        self.setVisible(False)

    def isVisible(self) -> bool:
        return self._frame._widget_code().isVisible()

    def parentWidget(self):
        return self._frame._widget_code().parentWidget()

    # -- tout le reste : active la cellule et délègue ------------------------
    def __getattr__(self, nom: str):
        if nom.startswith("__"):
            raise AttributeError(nom)
        if nom.startswith("_REGEX") or nom[:1].isupper():
            return getattr(TaskScriptEditor, nom)     # constantes de classe : rien à activer
        s = self._frame._session
        ed = s.partage.activer(s) if s is not None else None
        if ed is None:
            raise AttributeError(f"éditeur partagé indisponible pour « {nom} » (cellule non montée)")
        return getattr(ed, nom)

    def __setattr__(self, nom, valeur):
        if nom == "_cellule_id_associee":
            return    # la session porte l'id ; l'éditeur le reçoit à l'activation
        s = self._frame._session
        ed = s.partage.activer(s) if s is not None else None
        if ed is None:
            raise AttributeError(nom)
        setattr(ed, nom, valeur)


class TaskCelluleWidget(QFrame):
    """Une cellule complète de notebook (décision explicite utilisateur :
    "exactement le meme mecanisme que un notebok") : bandeau gauche avec
    bouton ▶ Exécuter + indicateur In[n]/statut, éditeur de code
    (TaskScriptEditor), et zone de sortie affichée juste en dessous après
    exécution (texte + éventuelle erreur en rouge) -- même pattern visuel
    que Jupyter.

    Ne connaît PAS le mécanisme d'exécution réel (pont ComposantExecutable/
    namespace partagé) : elle expose juste le signal demande_execution et
    reçoit en retour set_resultat_execution(...) depuis TaskConfigScreen,
    qui orchestre le namespace partagé entre toutes les cellules d'un même
    Task -- séparation propre, l'exécution réelle pourra être branchée plus
    tard côté TaskConfigScreen sans toucher à ce widget."""

    demande_execution = Signal(str)  # id de la cellule
    demande_suppression = Signal(str)  # id de la cellule
    demande_ajout_apres = Signal(str, bool)  # (id de la cellule, avant=True/après=False) -- bouton "+" : clic gauche = après, clic droit = avant
    demande_vider = Signal(str)  # id de la cellule (icône vider la sortie)
    code_modifie = Signal(str)  # id de la cellule, pour persistance immédiate
    titre_modifie = Signal(str, str)  # (id de la cellule, nouveau titre)
    description_modifie = Signal(str, str)  # (id de la cellule, nouvelle description)
    etiquette_basculee = Signal(str, bool)  # (id de la cellule, nouvel état étiqueté) -- cellule 0 uniquement
    demande_toggle_active = Signal(str)  # id de la cellule -- clic droit sur le bouton ▶ (active/désactive la cellule)
    repliee_basculee = Signal(str, bool)  # (id de la cellule, nouvel état replié) -- bouton chevron du bandeau gauche
    # AJOUT (demande explicite utilisateur, suite au bug TabError/
    # IndentationError : "je veux que tu met ce bouton donc de
    # auto-correction parmi les bouton de option de cellule [...] c'est
    # le user qui doit declencher cela, pas toujours automatique") --
    # bouton dédié du bandeau gauche, cf. bouton_reparer_indentation.
    demande_reparation_indentation = Signal(str)  # id de la cellule

    def __init__(
        self,
        cellule: "TaskCellule",
        reglages: Optional["ReglagesApp"] = None,
        parent=None,
        est_premiere: bool = False,
        etiquetee: bool = True,
        insuprimable: Optional[bool] = None,
        afficher_bouton_etiquette: Optional[bool] = None,
        active: bool = True,
        epinglee_visuelle: Optional[bool] = None,
        partage: Optional["PartageEditeur"] = None,
    ):
        super().__init__(parent)
        self.cellule_id = cellule.id
        # PATCH (étape 2, éditeur partagé) : None == comportement classique
        # (un TaskScriptEditor par cellule). Sinon, ce cadre n'a qu'une vue
        # légère et `editeur` est un ProxyEditeur (cf. ces classes).
        self._partage = partage
        self._session = None
        self._vue = None
        # PATCH (étape 1, lier) : réglages gardés pour que lier() puisse
        # réappliquer le blocage des sorties, et id de la cellule
        # actuellement liée (None tant que lier() n'a jamais tourné).
        self._reglages_cellule = reglages
        self._cellule_id_lie: Optional[str] = None
        self._lier_en_cours = False
        self.setObjectName("TaskCelluleWidget")
        # Cellule activée/désactivée (cf. TaskCellule.active) -- piloté par
        # un clic droit sur le bouton ▶ (cf. mousePressEvent ci-dessous).
        self._active = active

        # Cellule 0 / "Main" (décision explicite utilisateur : "je veux
        # que la premiere cellule soit la insuprimable... je ne veux pas
        # que lon puisse la suprimer") -- non supprimable, mais MAJ
        # décision explicite utilisateur ultérieure : n'est plus épinglée
        # en haut du notebook et ne porte plus le bouton "étiquette" --
        # elle vit désormais en permanence dans le notebook scrollable
        # comme une cellule normale (cf. TaskConfigScreen._peupler_
        # cellules). Seule task.cellule_variables ("Variable dynamique")
        # reste sticky et porte ce bouton (cf. juste en dessous).
        #
        # insuprimable/afficher_bouton_etiquette par défaut alignés sur
        # est_premiere (rétrocompatible avec les appels existants), mais
        # désormais dissociables : la cellule "variables dynamiques" de la
        # row 0 (cf. Task.cellule_variables, décision explicite
        # utilisateur : "insuprimable comme la cellule 0") est insuprimable
        # et porte SEULE le bouton étiquette qui pilote son propre sticky
        # (MAJ décision utilisateur : ce bouton ne pilote plus "Main").
        self._est_premiere = est_premiere
        self._etiquetee = etiquetee
        self._insuprimable = est_premiere if insuprimable is None else insuprimable
        self._afficher_bouton_etiquette = (
            est_premiere if afficher_bouton_etiquette is None else afficher_bouton_etiquette
        )
        # MAJ décision explicite utilisateur : le style visuel "épinglé"
        # (QSS #TaskCelluleWidget[epinglee="true"]) ne doit plus s'afficher
        # sur la cellule "Main" -- seule la cellule "Variable
        # dynamique" le conserve. Découplé de _insuprimable (qui, lui,
        # continue de protéger les DEUX cellules contre la suppression) via
        # ce nouveau paramètre epinglee_visuelle, explicitement à False
        # pour "Main" (cf. TaskConfigScreen._inserer_widget_cellule,
        # appelée pour task.cellules[0] avec insuprimable=True) et à True
        # pour cellule_variables (cf. _inserer_widget_cellule_variables).
        # Par défaut (None), reste aligné sur _insuprimable pour ne rien
        # changer aux autres cellules (notebook scrollable).
        self._epinglee_visuelle = (
            self._insuprimable if epinglee_visuelle is None else epinglee_visuelle
        )

        layout_racine = QHBoxLayout(self)
        layout_racine.setContentsMargins(0, 0, 0, 0)
        layout_racine.setSpacing(4)  # PATCH : 8 -> 4 (espace bandeau/cellule réduit)

        # Propriété QSS pilotant le style visuel "étiqueté" (cf. règle
        # #TaskCelluleWidget[epinglee="true"]) -- posée dès la construction
        # pour que la row 0 s'affiche correctement étiquetée par défaut
        # sans attendre un premier clic sur le bouton. Basée sur
        # _epinglee_visuelle (cf. commentaire ci-dessus) plutôt que
        # _insuprimable seul, afin que seule la cellule "Variable
        # dynamique" porte désormais ce style, et non plus les deux
        # cellules de la row 0.
        self.setProperty("epinglee", bool(self._epinglee_visuelle and self._etiquetee))

        # --- Bandeau gauche : bouton Exécuter + indicateur In[n] ---
        bandeau = QWidget(self)
        bandeau.setFixedWidth(40)  # PATCH : 44 -> 40
        bandeau_layout = QVBoxLayout(bandeau)
        bandeau_layout.setContentsMargins(0, 6, 0, 0)
        bandeau_layout.setSpacing(4)
        bandeau_layout.setAlignment(Qt.AlignHCenter)

        # Numéro de POSITION de la cellule dans le notebook (1, 2, 3... --
        # décision explicite utilisateur : "numerote les celleuel [...] je
        # veux que se soit lindex de celleule, pas lordre dexecution [...]
        # un numeros qui se met a jour uniquement quand on ajoute ou retire
        # une celucle"). Distinct de label_indicateur juste en dessous, qui
        # reste le compteur In[n] Jupyter classique (numéro d'EXÉCUTION,
        # vide tant que la cellule n'a jamais tourné). Police Consolas
        # (déjà utilisée pour l'éditeur de code, cf. plus bas dans ce
        # fichier) + gras + mauve, pour le distinguer visuellement du reste
        # du bandeau (vert/jaune/rouge déjà réservés au statut d'exécution
        # de label_indicateur). Mis à jour UNIQUEMENT via definir_index(),
        # jamais ici à la construction -- TaskConfigScreen appelle
        # definir_index() sur tous les widgets juste après _peupler_cellules/
        # _ajouter_cellule/_supprimer_cellule (cf. _rafraichir_index_cellules).
        # Stretch de tête (AJOUT, demande explicite utilisateur : "sa doit
        # toujour etre centrer" -- les boutons du bandeau gauche doivent
        # rester centrés verticalement quelle que soit la hauteur de la
        # cellule, pas juste ancrés en haut/bas). Combiné au stretch de
        # fin ajouté après le dernier widget du bandeau, ce stretch pousse
        # tout le bloc (index/exécuter/indicateur/ajouter/replier/réparer/
        # supprimer/étiquette) vers le centre. Le stretch existant entre
        # label_indicateur et bouton_ajouter_apres est conservé tel quel :
        # il ne sert plus à pousser vers le bas/haut mais simplement à
        # garder l'espacement visuel actuel entre les deux sous-groupes
        # (exécution vs actions) à l'intérieur du bloc centré.
        bandeau_layout.addStretch(1)

        self.label_index = QLabel(bandeau)
        self.label_index.setObjectName("CelluleIndex")
        self.label_index.setAlignment(Qt.AlignCenter)
        self.label_index.setFont(QFont("Consolas", 9, QFont.Weight.Bold))
        self.label_index.setStyleSheet(f"color: {Mocha.mauve};")
        bandeau_layout.addWidget(self.label_index)

        self.bouton_executer = QToolButtonAvecClicDroit(bandeau)
        self.bouton_executer.setObjectName("CelluleBoutonExecuter")
        self._icone_jouer = qta.icon("mdi6.play", color=Mocha.green)
        # BUGFIX (crash utilisateur : "Invalid icon name 'play-off' in
        # font 'mdi6'") -- cette icône n'existe pas dans Material Design
        # Icons v6, contrairement à ce que son nom laissait supposer.
        # "play-outline" (même triangle ▶, juste en contour) existe bien
        # et reste visuellement cohérent avec l'icône ▶ pleine active.
        self._icone_desactivee = qta.icon("mdi6.play-outline", color=Mocha.overlay0)
        self.bouton_executer.setIcon(self._icone_jouer)
        self.bouton_executer.setIconSize(QSize(20, 20))
        self.bouton_executer.setCursor(Qt.PointingHandCursor)
        self.bouton_executer.setToolTip(
            "Exécuter cette cellule (clic droit : désactiver)"
        )
        # BUGFIX (rapporté par l'utilisateur : "le clic droit sur le
        # bouton de run [...] ne fonctionne plus pour réactiver la
        # cellule") -- routé via _sur_clic_bouton_executer plutôt que
        # directement vers demande_execution : voir sa docstring pour le
        # détail du bug (setEnabled(False) bloquait aussi le clic droit).
        self.bouton_executer.clicked.connect(self._sur_clic_bouton_executer)
        # Clic droit : bascule active/désactivée (décision explicite
        # utilisateur : "si on fait un clic droit sur botuon de run dune
        # celleule sa la desactive ou active") -- même pattern que
        # BoutonAjoutCellule.clic_droit. Le bouton reste TOUJOURS
        # setEnabled(True) (cf. _rafraichir_etat_actif) précisément pour
        # que ce signal continue d'être émis même cellule désactivée --
        # sinon plus aucun clic (gauche ou droit) n'atteint
        # mousePressEvent, cf. QToolButtonAvecClicDroit.
        self.bouton_executer.clic_droit.connect(
            lambda: self.demande_toggle_active.emit(self.cellule_id)
        )
        bandeau_layout.addWidget(self.bouton_executer)

        # Spinner qtawesome (décision explicite utilisateur : "le symbole
        # qui symbolise lexecution... cest le bouton qui caree que le
        # cerlce tourne un peu autoiur" -- le bouton ▶ lui-même doit
        # tourner pendant l'exécution, pas juste l'indicateur [*] à côté).
        # autostart=False : ne tourne jamais tant qu'indiquer_en_cours()
        # ne l'a pas explicitement démarré -- un spinner qui tourne en
        # permanence dans une cellule au repos serait trompeur.
        self._animation_spin = qta.Spin(self.bouton_executer, interval=500, step=60, autostart=False)  # PATCH11 : 2 fps
        self._icone_en_cours = qta.icon(
            "mdi6.loading", color=Mocha.yellow, animation=self._animation_spin,
        )
        # Icônes ⏹ pour les états de séquence globale (cf.
        # indiquer_en_attente_sequence/indiquer_en_cours_sequence) --
        # grisées car non cliquables dans les deux cas (bouton désactivé),
        # seule la nuance de gris diffère légèrement pour rester lisible.
        self._icone_stop_inactif = qta.icon("mdi6.stop", color=Mocha.overlay0)
        self._icone_stop_en_cours = qta.icon(
            "mdi6.stop", color=Mocha.yellow, animation=self._animation_spin,
        )

        self.label_indicateur = QLabel(bandeau)
        self.label_indicateur.setObjectName("CelluleIndicateur")
        self.label_indicateur.setAlignment(Qt.AlignCenter)
        bandeau_layout.addWidget(self.label_indicateur)

        # (Ancien addStretch(1) ici RETIRÉ -- demande explicite utilisateur :
        # "les bouton ne sont pas grouper au milieu" -- un stretch entre
        # label_indicateur et bouton_ajouter_apres scindait le bandeau en
        # deux groupes distincts, chacun poussé vers une extrémité, au lieu
        # d'un seul bloc compact centré. Le centrage vertical du bloc entier
        # est désormais assuré uniquement par les deux stretches qui
        # encadrent tout le bandeau : un juste avant label_index, un juste
        # après le dernier widget (bouton_supprimer/bouton_etiquette) --
        # cf. plus bas. Entre les widgets du bloc lui-même, seul
        # bandeau_layout.setSpacing(4) règle l'espacement, plus aucun
        # stretch intermédiaire.)

        self.bouton_ajouter_apres = BoutonAjoutCellule(bandeau)
        self.bouton_ajouter_apres.setObjectName("CelluleBoutonExecuter")
        self.bouton_ajouter_apres.setIcon(qta.icon("mdi6.plus", color=Mocha.subtext0))
        self.bouton_ajouter_apres.setIconSize(QSize(16, 16))
        self.bouton_ajouter_apres.setCursor(Qt.PointingHandCursor)
        self.bouton_ajouter_apres.setToolTip(
            "Ajouter une cellule après celle-ci (clic droit : avant)"
        )
        self.bouton_ajouter_apres.clicked.connect(
            lambda: self.demande_ajout_apres.emit(self.cellule_id, False)
        )
        self.bouton_ajouter_apres.clic_droit.connect(
            lambda: self.demande_ajout_apres.emit(self.cellule_id, True)
        )
        bandeau_layout.addWidget(self.bouton_ajouter_apres)

        # --- Bouton "replier" : masque l'éditeur de code + la zone de
        # sortie, garde titre/description et le bandeau (▶, index,
        # statut) visibles -- pour parcourir rapidement un notebook à
        # beaucoup de cellules sans perdre le fil de ce que fait chacune.
        # Icône chevron qui bascule (bas = déplié/normal, droite =
        # replié), même pattern visuel que bouton_etiquette
        # (QToolButton.setCheckable + icônes différentes selon l'état).
        self._icone_repliee_bas = qta.icon("mdi6.chevron-down", color=Mocha.subtext0)
        self._icone_repliee_droite = qta.icon("mdi6.chevron-right", color=Mocha.subtext0)
        self.bouton_replier = QToolButton(bandeau)
        self.bouton_replier.setObjectName("CelluleBoutonReplier")
        self.bouton_replier.setIcon(self._icone_repliee_bas)
        self.bouton_replier.setIconSize(QSize(16, 16))
        self.bouton_replier.setCursor(Qt.PointingHandCursor)
        self.bouton_replier.setCheckable(True)
        self.bouton_replier.setToolTip("Replier cette cellule (masquer le code et la sortie)")
        self.bouton_replier.toggled.connect(self._sur_toggle_replier)
        bandeau_layout.addWidget(self.bouton_replier)

        # --- Bouton "réparer l'indentation" (AJOUT, demande explicite
        # utilisateur suite au TabError/IndentationError rencontré à
        # l'exécution : "je veux que tu met ce bouton donc de
        # auto-correction parmi les bouton de option de cellule [...]
        # c'est le user qui doit declencher cela, pas toujours
        # automatique") -- déclenche reparer_structure_indentation() sur
        # le code de CETTE cellule uniquement, jamais appelé
        # automatiquement (contrairement à la normalisation tab/espaces
        # de _thread_execution, sans ambiguïté possible celle-là) :
        # reconstruire une profondeur de bloc à partir d'une indentation
        # fautive revient à deviner une intention, décision explicite
        # utilisateur de garder ça sous contrôle manuel. Icône distincte
        # (mdi6.format-indent-increase) pour ne pas être confondue avec
        # le chevron de repli juste au-dessus.
        self.bouton_reparer_indentation = QToolButton(bandeau)
        self.bouton_reparer_indentation.setObjectName("CelluleBoutonExecuter")
        self.bouton_reparer_indentation.setIcon(qta.icon("mdi6.format-indent-increase", color=Mocha.subtext0))
        self.bouton_reparer_indentation.setIconSize(QSize(16, 16))
        self.bouton_reparer_indentation.setCursor(Qt.PointingHandCursor)
        self.bouton_reparer_indentation.setToolTip(
            "Réparer l'indentation du code de cette cellule\n"
            "(corrige les erreurs de type TabError / IndentationError)"
        )
        self.bouton_reparer_indentation.clicked.connect(
            lambda: self.demande_reparation_indentation.emit(self.cellule_id)
        )
        bandeau_layout.addWidget(self.bouton_reparer_indentation)

        self.bouton_supprimer = QToolButton(bandeau)
        self.bouton_supprimer.setObjectName("SupprimerCelluleButton")
        self.bouton_supprimer.setIcon(qta.icon("mdi6.close", color=Mocha.subtext0))
        self.bouton_supprimer.setIconSize(QSize(14, 14))
        self.bouton_supprimer.setCursor(Qt.PointingHandCursor)
        self.bouton_supprimer.setToolTip("Supprimer cette cellule")
        self.bouton_supprimer.clicked.connect(self._sur_clic_supprimer)
        # PATCH (étape 1, lier) : le bouton est TOUJOURS dans le layout et
        # sa visibilité est pilotée par lier() -- un cadre recyclé peut
        # passer d'une cellule supprimable à une insuprimable sans créer ni
        # détruire de widget. Un widget caché ne prend aucune place dans un
        # QBoxLayout : rendu identique à l'ancien code.
        bandeau_layout.addWidget(self.bouton_supprimer)
        if self._insuprimable:
            # Cellule insuprimable (cellules[0] ou cellule_variables) :
            # bouton totalement caché plutôt que simplement désactivé --
            # évite toute ambiguïté visuelle et libère la place pour le
            # bouton étiquette ci-dessous, quand il est présent.
            self.bouton_supprimer.hide()

        # --- Bouton "étiquette" (décision explicite utilisateur : "tu vas
        # mettre un bouon detquette on doit pouvour desactiver ce cote
        # etiquetter, mais pardefaut cest bein etiquetter") -- toggle
        # visuel indiquant que la row 0 est la row d'initialisation ;
        # piloté par _etiquetee, activé par défaut. Un SEUL bouton pour
        # toute la row (décision explicite utilisateur : "un seul bouton
        # pour la row, les deux cellules bougent ensemble").
        #
        # MAJ décision explicite utilisateur : ce bouton (et le style
        # visuel épinglé associé) vit désormais sur "Variable dynamique"
        # (afficher_bouton_etiquette=True côté TaskConfigScreen), et non
        # plus sur "Main" (cellules[0], qui n'affiche plus le sien) --
        # même mécanique qu'avant, juste déplacée : ce bouton reste celui
        # qui pilote le sticky des deux cellules ensemble via
        # TaskConfigScreen._sur_etiquette_cellule_basculee.
        self.bouton_etiquette = QToolButton(bandeau)
        self.bouton_etiquette.setObjectName("CelluleBoutonEtiquette")
        self.bouton_etiquette.setIconSize(QSize(14, 14))
        self.bouton_etiquette.setCursor(Qt.PointingHandCursor)
        self.bouton_etiquette.setCheckable(True)
        self.bouton_etiquette.clicked.connect(self._sur_clic_etiquette)
        # PATCH (étape 1, lier) : toujours dans le layout, visibilité pilotée
        # par lier() (cf. bouton_supprimer ci-dessus).
        bandeau_layout.addWidget(self.bouton_etiquette)
        if self._afficher_bouton_etiquette:
            self._rafraichir_bouton_etiquette()
        else:
            self.bouton_etiquette.hide()

        # Stretch de fin (cf. stretch de tête juste avant label_index) --
        # ferme le bloc de boutons par le bas, symétrique au stretch de
        # tête, pour que tout le bandeau (label_index → bouton_etiquette)
        # reste centré verticalement quelle que soit la hauteur prise par
        # la cellule (éditeur de code + sortie qui s'étirent).
        bandeau_layout.addStretch(1)

        # Confirmation en 2 clics rapprochés (décision explicite utilisateur,
        # "a caue des erruer plausible") : le premier clic arme la
        # suppression et fait passer le bouton en rouge, le second clic dans
        # le délai confirme réellement. Sans second clic, réarmement
        # automatique après _DELAI_CONFIRMATION_MS.
        self._suppression_armee = False
        self._timer_confirmation_suppression = QTimer(self)
        self._timer_confirmation_suppression.setSingleShot(True)
        self._timer_confirmation_suppression.timeout.connect(self._desarmer_suppression)

        layout_racine.addWidget(bandeau)

        # --- Colonne droite : éditeur de code + zone de sortie ---
        colonne = QWidget(self)
        colonne_layout = QVBoxLayout(colonne)
        colonne_layout.setContentsMargins(0, 0, 0, 0)
        colonne_layout.setSpacing(6)

        self.zone_titre = CelluleZoneMarkdown(
            placeholder="*Titre de la cellule (cliquer pour éditer)*",
            objet_nom_affichage="CelluleTitreLabel",
            objet_nom_edition="CelluleTitreEdit",
            multiligne=False,
            parent=colonne,
        )
        # PATCH (étape 1) : le texte est posé par lier() en fin d'__init__.
        self.zone_titre.texte_modifie.connect(
            lambda texte: self.titre_modifie.emit(self.cellule_id, texte)
        )
        colonne_layout.addWidget(self.zone_titre)

        self.zone_description = CelluleZoneMarkdown(
            placeholder="*Description (optionnelle, cliquer pour éditer)*",
            objet_nom_affichage="CelluleDescriptionLabel",
            objet_nom_edition="CelluleDescriptionEdit",
            multiligne=True,
            parent=colonne,
        )
        # PATCH (étape 1) : le texte est posé par lier() en fin d'__init__.
        self.zone_description.texte_modifie.connect(
            lambda texte: self.description_modifie.emit(self.cellule_id, texte)
        )
        colonne_layout.addWidget(self.zone_description)

        # AJOUT (affichage de la vraie valeur WORKSPACE du profil clone
        # actif) : quand l'éditeur montre autre chose que le vrai code
        # source de la cellule, ces deux champs mémorisent le couple
        # (ce qui est AFFICHÉ, ce qui doit être PERSISTÉ) -- cf.
        # definir_code_affiche plus bas pour le raisonnement complet.
        # Tous deux None == aucun affichage cosmétique en cours, cas de
        # TOUTES les cellules sauf cellule_variables avec une attribution
        # WORKSPACE non vide.
        self._code_reel_sous_affichage: Optional[str] = None
        self._code_affiche_cosmetique: Optional[str] = None

        if partage is None:
            self.editeur = TaskScriptEditor(reglages, colonne)
            # PATCH (étape 1) : le code est posé par lier() en fin d'__init__.
            # PATCH (Ctrl+F/Ctrl+D multi-notebook) -- l'éditeur a besoin de
            # connaître l'id de SA propre cellule pour s'identifier auprès du
            # notebook parent (TaskConfigScreen._cellule_widgets est indexé
            # par cellule_id, cf. TaskScriptEditor.cellule_id_associee).
            self.editeur._cellule_id_associee = self.cellule_id
            # PATCH (étape 1, lier) : pendant lier() le texte change sans que
            # l'utilisateur ait tapé quoi que ce soit : on ne doit surtout pas
            # émettre code_modifie (sinon sauvegarde et écriture parasites).
            self.editeur.textChanged.connect(
                lambda: None if self._lier_en_cours else self.code_modifie.emit(self.cellule_id)
            )
            colonne_layout.addWidget(self.editeur)
        else:
            # PATCH (étape 2) : vue légère à la place de l'éditeur. Le signal
            # code_modifie vient de la session (cf. SessionCellule._sur_contenu),
            # qui le route vers le cadre COURANT : aucune connexion à refaire
            # quand le cadre est rebranché sur une autre cellule.
            self._vue = VueCelluleStatique(partage, colonne)
            self.editeur = ProxyEditeur(self)
            colonne_layout.addWidget(self._vue)
        # Exposé pour GitScreen (cf. activer_mode_editeur_pleine_hauteur) :
        # permet d'appliquer colonne_layout.setStretchFactor(self.editeur, 1)
        # depuis l'extérieur, SANS dupliquer ce layout ni modifier le
        # comportement par défaut (stretch factor implicite 0, inchangé
        # tant que rien n'appelle explicitement setStretchFactor dessus --
        # cf. TaskConfigScreen, qui ne le fait jamais).
        self._colonne_layout = colonne_layout

        # --- En-tête de la zone de sortie : bouton "copier" + bouton
        # "vider", alignés à droite -- masqués en même temps que
        # zone_sortie quand il n'y a rien à vider/copier (cf.
        # afficher_resultat). Bouton "copier" ajouté à côté de "vider"
        # (décision explicite utilisateur). ---
        self.entete_sortie = EnteteSortieCellule(colonne)
        entete_sortie_layout = QHBoxLayout(self.entete_sortie)
        entete_sortie_layout.setContentsMargins(0, 0, 0, 0)
        entete_sortie_layout.setSpacing(4)
        entete_sortie_layout.addStretch(1)

        self.bouton_copier_sortie = QToolButton(self.entete_sortie)
        self.bouton_copier_sortie.setObjectName("CelluleBoutonCopierSortie")
        self.bouton_copier_sortie.setIcon(qta.icon("mdi6.content-copy", color=Mocha.subtext0))
        self.bouton_copier_sortie.setIconSize(QSize(14, 14))
        self.bouton_copier_sortie.setCursor(Qt.PointingHandCursor)
        self.bouton_copier_sortie.setToolTip("Copier la sortie de cette cellule")
        self.bouton_copier_sortie.clicked.connect(self._copier_sortie)
        entete_sortie_layout.addWidget(self.bouton_copier_sortie)

        self.bouton_vider_sortie = QToolButton(self.entete_sortie)
        self.bouton_vider_sortie.setObjectName("CelluleBoutonViderSortie")
        self.bouton_vider_sortie.setIcon(qta.icon("mdi6.eraser", color=Mocha.subtext0))
        self.bouton_vider_sortie.setIconSize(QSize(14, 14))
        self.bouton_vider_sortie.setCursor(Qt.PointingHandCursor)
        self.bouton_vider_sortie.setToolTip("Vider la sortie de cette cellule")
        self.bouton_vider_sortie.clicked.connect(
            lambda: self.demande_vider.emit(self.cellule_id)
        )
        entete_sortie_layout.addWidget(self.bouton_vider_sortie)
        colonne_layout.addWidget(self.entete_sortie)

        self.zone_sortie = LabelSortieCellule(colonne)
        self.zone_sortie.setObjectName("CelluleSortie")
        self.zone_sortie.setWordWrap(True)
        self.zone_sortie.setTextInteractionFlags(Qt.TextSelectableByMouse)
        self.zone_sortie.setAlignment(Qt.AlignLeft | Qt.AlignTop)
        colonne_layout.addWidget(self.zone_sortie)

        layout_racine.addWidget(colonne, 1)

        # PATCH (bloquer l'affichage des sorties) -- état initial pris
        # depuis le réglage persistant (cf. ReglagesApp.bloquer_sortie_
        # cellules), APPLIQUÉ AVANT afficher_resultat() : une cellule créée
        # ou rouverte respecte immédiatement le dernier choix de
        # l'utilisateur, sans jamais faire clignoter une sortie qui doit
        # rester cachée. Ensuite piloté depuis l'EXTÉRIEUR par
        # definir_sortie_bloquee (cf. MainWindow, signal
        # ParametresScreen.bloquer_sortie_cellules_changee).
        # PATCH (étape 1) : toute la lecture des données de la cellule vit
        # dans lier() (blocage des sorties, titre, description, code,
        # résultat, état replié...). __init__ ne fait que construire les
        # widgets puis déléguer.
        self.lier(
            cellule,
            insuprimable=self._insuprimable,
            epinglee_visuelle=self._epinglee_visuelle,
            afficher_bouton_etiquette=self._afficher_bouton_etiquette,
            etiquetee=self._etiquetee,
            active=self._active,
        )

    def _widget_code(self):
        """PATCH (étape 2) : le widget qui affiche le code de ce cadre en ce
        moment -- l'éditeur partagé s'il est actif ici, la vue légère sinon
        (le TaskScriptEditor propre du cadre en mode classique)."""
        if self._partage is None:
            return self.editeur
        s = self._session
        if s is not None and s.est_active() and s.frame_valide() is self:
            return self._partage.editeur()
        return self._vue

    # ------------------------------------------------------------------
    # PATCH (spec éditeur partagé, étape 1) -- rebrancher ce cadre sur une
    # AUTRE cellule sans rien recréer. Prérequis de la liste virtuelle.
    # ------------------------------------------------------------------
    def lier(
        self,
        cellule: "TaskCellule",
        *,
        insuprimable: Optional[bool] = None,
        epinglee_visuelle: Optional[bool] = None,
        afficher_bouton_etiquette: Optional[bool] = None,
        etiquetee: Optional[bool] = None,
        active: Optional[bool] = None,
        index: Optional[int] = None,
    ):
        """Branche ce cadre sur `cellule` : identité, titre, description,
        code, indicateur [n] + couleur de statut, sortie (plafond 50 000
        caractères, cf. afficher_resultat), état replié/actif/étiqueté,
        visibilité des boutons supprimer/étiquette.

        Contrat : ne crée ni ne détruit AUCUN widget enfant et ne
        reconnecte AUCUN signal (les connexions relisent self.cellule_id
        au moment du clic, cf. __init__). Les paramètres à None prennent
        la même valeur par défaut qu'à la construction ; etiquetee et
        active, s'ils sont None, sont lus sur la cellule.

        Remet à zéro tout ce qui dépendait de l'ancienne cellule : sortie,
        surlignage de ligne d'erreur, popup d'auto-complétion, spinner
        « en cours »/« en attente », bouton supprimer armé, numéro de
        position (laissé vide si `index` n'est pas fourni et que la cellule
        change -- _rafraichir_index_cellules le posera).

        Si le cadre est déjà lié à la MÊME cellule avec le même texte de
        code, le texte n'est pas reposé (curseur et pile Ctrl+Z conservés,
        même raisonnement que definir_code_affiche)."""
        self._lier_en_cours = True
        try:
            meme_cellule = (self._cellule_id_lie == cellule.id)

            # --- 1. Ce qui dépendait de l'ancienne cellule ---
            self._animation_spin.stop()
            self._timer_confirmation_suppression.stop()
            if self._suppression_armee:
                self._desarmer_suppression()
            self._code_reel_sous_affichage = None
            self._code_affiche_cosmetique = None

            # --- 2. Identité et drapeaux (mêmes défauts que __init__) ---
            self.cellule_id = cellule.id
            if self._partage is not None:
                self._lier_session(cellule)
            else:
                self.editeur._cellule_id_associee = cellule.id
            self._insuprimable = self._est_premiere if insuprimable is None else insuprimable
            self._afficher_bouton_etiquette = (
                self._est_premiere if afficher_bouton_etiquette is None else afficher_bouton_etiquette
            )
            self._epinglee_visuelle = (
                self._insuprimable if epinglee_visuelle is None else epinglee_visuelle
            )
            self._etiquetee = getattr(cellule, "etiquetee", True) if etiquetee is None else etiquetee
            self._active = getattr(cellule, "active", True) if active is None else active
            # Le repolish de la propriété « epinglee » est fait par
            # _rafraichir_etat_actif (appelé via afficher_resultat plus bas).
            self.setProperty("epinglee", bool(self._epinglee_visuelle and self._etiquetee))

            self.bouton_supprimer.setVisible(not self._insuprimable)
            self.bouton_etiquette.setVisible(bool(self._afficher_bouton_etiquette))
            if self._afficher_bouton_etiquette:
                self._rafraichir_bouton_etiquette()

            # --- 3. Titre et description ---
            self.zone_titre.definir_texte(cellule.titre)
            self.zone_description.definir_texte(cellule.description)

            # --- 4. Code ---
            ed = self.editeur
            if self._partage is not None:
                if ed.toPlainText() != cellule.code:
                    ed.setPlainText(cellule.code)
            elif not meme_cellule or ed.toPlainText() != cellule.code:
                # setPlainText vide la pile d'annulation et replace le
                # curseur : voulu quand le cadre change de cellule.
                ed.setPlainText(cellule.code)
            if self._partage is None:
                ed.effacer_surlignage_erreur()
                ed._popup.hide()
            ed._ajuster_hauteur()

            # --- 5. Numéro de position ---
            if index is not None:
                self.definir_index(index)
            elif not meme_cellule:
                self.label_index.setText("")

            # --- 6. Sortie, statut, état actif ---
            reglages = self._reglages_cellule
            self.definir_sortie_bloquee(
                bool(reglages is not None and reglages.bloquer_sortie_cellules)
            )
            self.afficher_resultat(cellule)

            # --- 7. État replié (APRÈS afficher_resultat, cf. ancien __init__) ---
            self.bouton_replier.blockSignals(True)
            self.bouton_replier.setChecked(cellule.repliee)
            self.bouton_replier.blockSignals(False)
            self._appliquer_etat_replie(cellule.repliee)

            self._cellule_id_lie = cellule.id
        finally:
            self._lier_en_cours = False

    # ------------------------------------------------------------------
    # PATCH (étape 2) -- éditeur partagé
    # ------------------------------------------------------------------
    def _lier_session(self, cellule: "TaskCellule"):
        partage = self._partage
        ancienne = self._session
        nouvelle = partage.session_pour(cellule.id, cellule.code)
        if ancienne is nouvelle:
            return
        if partage.session_active in (ancienne, nouvelle):
            partage.desactiver()
        if ancienne is not None and ancienne.frame is self:
            ancienne.frame = None
            ancienne.decolorer()   # PATCH (étape 4)
        nouvelle.frame = self
        nouvelle.colorer()         # PATCH (étape 4)
        self._session = nouvelle
        self._vue.definir_session(nouvelle)

    def _rafraichir_vue(self):
        if self._vue is not None and self._session is not None:
            self._vue.setFixedHeight(self._session.hauteur())
            self._vue.update()

    def liberer_editeur_partage(self):
        """Avant de retirer/détruire ce cadre : l'éditeur partagé ne doit
        JAMAIS être emporté par la destruction d'un cadre."""
        if self._partage is not None and self._session is not None and self._session.est_active():
            self._partage.desactiver()

    def deleteLater(self):
        self.liberer_editeur_partage()
        super().deleteLater()

    # ------------------------------------------------------------------
    # Code (accès direct utilisé par TaskConfigScreen à la sauvegarde)
    # ------------------------------------------------------------------
    def code_actuel(self) -> str:
        return self.editeur.toPlainText()

    def definir_code_affiche(self, code: str, code_reel: Optional[str] = None):
        """AJOUT (demande explicite utilisateur -- affichage fidèle de la
        vraie valeur WORKSPACE injectée pour le profil clone actif, cf.
        code_variables_avec_workspace_affiche) : pose `code` dans
        l'éditeur pour un affichage PUREMENT COSMÉTIQUE, sans jamais
        déclencher la persistance normale (self.editeur.textChanged ->
        code_modifie -> TaskConfigScreen._sur_code_cellule_modifie, qui
        écrirait autrement ce texte affiché DANS task.cellule_variables.
        code lui-même, en écrasant la vraie déclaration éditée par
        l'utilisateur -- cf. BUG identifié en revue : afficher_resultat()
        ne touche JAMAIS self.editeur, uniquement l'indicateur/la sortie,
        donc poser cellule_temp.code seul n'a AUCUN effet visuel ; c'est
        CETTE méthode, pas afficher_resultat, qui doit être appelée pour
        changer ce qui est réellement affiché dans l'éditeur).

        blockSignals(True/False) est le patron déjà utilisé partout
        ailleurs dans ce fichier pour ce même besoin (poser un widget par
        programme sans redéclencher sa propre réaction au changement,
        cf. tous les autres sites blockSignals de ce fichier).

        `code_reel` : le vrai code source sous-jacent, à persister à la
        place du texte affiché si l'utilisateur tape dans cette cellule
        (cf. TaskConfigScreen._code_a_persister_depuis_editeur). Laissé
        à None -- ou égal à `code` -- pour SORTIR de l'affichage
        cosmétique : la cellule redevient alors une cellule normale dont
        le texte affiché EST le code source.

        Idempotente : si l'éditeur affiche déjà exactement `code`, le
        texte n'est PAS reposé. C'est indispensable et pas une simple
        optimisation -- setPlainText réinitialise le curseur en position
        0 et vide la pile d'annulation (Ctrl+Z), ce qui serait très
        visible pour un utilisateur en train d'éditer la cellule pendant
        qu'une séquence clone tourne en arrière-plan et déclenche des
        rafraîchissements. Le curseur est de toute façon restauré à sa
        position d'origine quand une réécriture est réellement
        nécessaire."""
        if code_reel is not None and code_reel != code:
            self._code_reel_sous_affichage = code_reel
            self._code_affiche_cosmetique = code
        else:
            self._code_reel_sous_affichage = None
            self._code_affiche_cosmetique = None
        if self.editeur.toPlainText() == code:
            return
        position_curseur = self.editeur.textCursor().position()
        self.editeur.blockSignals(True)
        self.editeur.setPlainText(code)
        curseur = self.editeur.textCursor()
        curseur.setPosition(min(position_curseur, len(code)))
        self.editeur.setTextCursor(curseur)
        self.editeur.blockSignals(False)
        self.editeur._ajuster_hauteur()

    def code_reel_sous_affichage(self) -> Optional[str]:
        """Le vrai code source si un affichage cosmétique est en cours
        sur cette cellule, None sinon (cas de toutes les cellules
        ordinaires) -- cf. definir_code_affiche."""
        return self._code_reel_sous_affichage

    def code_affiche_cosmetique(self) -> Optional[str]:
        """Le texte exact posé par le dernier definir_code_affiche
        cosmétique, None si aucun n'est en cours. Sert de point de
        comparaison pour savoir si l'utilisateur a lui-même retouché la
        ligne WORKSPACE affichée (cf. TaskConfigScreen._code_a_persister_
        depuis_editeur)."""
        return self._code_affiche_cosmetique

    def restaurer_code_reel(self) -> bool:
        """Repose le vrai code source dans l'éditeur et sort de
        l'affichage cosmétique. Retourne True si un affichage cosmétique
        était effectivement en cours (donc si quelque chose a changé),
        False sinon -- permet à l'appelant de savoir s'il doit le
        réappliquer après coup (cf. _reparer_indentation_cellule)."""
        code_reel = self._code_reel_sous_affichage
        if code_reel is None:
            return False
        self.definir_code_affiche(code_reel)
        return True

    def definir_index(self, index: int):
        """Met à jour le numéro de POSITION affiché au-dessus du bouton ▶
        (cf. label_index) -- PAS le numéro d'exécution In[n] de
        label_indicateur, qui reste géré séparément par afficher_resultat().
        Appelé uniquement par TaskConfigScreen._rafraichir_index_cellules,
        jamais depuis l'exécution d'une cellule."""
        self.label_index.setText(str(index))

    # ------------------------------------------------------------------
    # Repli/dépli de la cellule (bouton chevron du bandeau gauche) --
    # masque l'éditeur de code + la zone de sortie, garde titre/
    # description et le bandeau visibles.
    # ------------------------------------------------------------------
    def _sur_toggle_replier(self, replie: bool):
        """Connecté à bouton_replier.toggled -- UNIQUEMENT déclenché par
        un clic utilisateur réel (cf. blockSignals dans __init__ pour la
        restauration initiale). Applique l'effet visuel immédiatement ET
        émet repliee_basculee pour que TaskConfigScreen persiste le
        nouvel état sur TaskCellule.repliee (même pattern que
        titre_modifie/description_modifie -- ce widget ne touche jamais
        le modèle directement, il notifie et laisse TaskConfigScreen
        écrire dans task.cellules)."""
        self._appliquer_etat_replie(replie)
        self.repliee_basculee.emit(self.cellule_id, replie)

    def definir_sortie_bloquee(self, bloquee: bool):
        """PATCH (demande explicite utilisateur : "bloquer l'affichage de
        sortie") -- bloque/débloque l'AFFICHAGE de la sortie de cette
        cellule (zone de texte + en-tête copier/vider), sans jamais toucher
        au texte lui-même (cf. _BloquableAffichageMixin). Appelée à la
        construction (état persisté) et par MainWindow à chaque bascule du
        toggle des Paramètres, sur TOUTES les cellules d'un notebook déjà
        ouvert -- effet immédiat, sans avoir à ré-exécuter quoi que ce
        soit."""
        self.zone_sortie.definir_bloque(bloquee)
        self.entete_sortie.definir_bloque(bloquee)

    def _appliquer_etat_replie(self, replie: bool):
        """Effet visuel pur, sans toucher au modèle ni émettre de signal
        -- appelée à la fois par _sur_toggle_replier (clic utilisateur)
        et par __init__ (restauration de l'état persisté). L'éditeur de
        code est masqué inconditionnellement ; la zone de sortie et son
        en-tête (copier/vider) ne sont réaffichés au dépli que s'il y a
        réellement une sortie à montrer (même condition que
        afficher_resultat) -- une cellule jamais exécutée ne doit pas
        faire apparaître un en-tête de sortie vide en dépliant."""
        self.editeur.setVisible(not replie)
        if replie:
            self.zone_sortie.hide()
            self.entete_sortie.hide()
        else:
            a_une_sortie = bool(self.zone_sortie.text())
            self.zone_sortie.setVisible(a_une_sortie)
            self.entete_sortie.setVisible(a_une_sortie)
        self.bouton_replier.setIcon(
            self._icone_repliee_droite if replie else self._icone_repliee_bas
        )
        self.bouton_replier.setToolTip(
            "Déplier cette cellule" if replie else "Replier cette cellule (masquer le code et la sortie)"
        )

    def definir_repliee(self, replie: bool):
        """Appelé par TaskConfigScreen si l'état replié doit être
        resynchronisé depuis l'extérieur (ex: action globale "tout
        replier/déplier", cf. TaskConfigScreen) -- même contrat que
        definir_active : ne PAS appeler directement depuis un simple
        rafraîchissement, blockSignals pour ne pas re-déclencher
        repliee_basculee en boucle."""
        self.bouton_replier.blockSignals(True)
        self.bouton_replier.setChecked(replie)
        self.bouton_replier.blockSignals(False)
        self._appliquer_etat_replie(replie)

    # ------------------------------------------------------------------
    # Affichage du résultat de la dernière exécution (statut + sortie),
    # appelé à la construction (résultat déjà connu, persisté) et après
    # chaque exécution demandée par l'utilisateur.
    # ------------------------------------------------------------------
    def afficher_resultat(self, cellule: "TaskCellule"):
        # Fin de l'exécution (ou premier affichage à la construction, où le
        # spin n'a de toute façon jamais été démarré -- cf. autostart=False)
        # : le bouton revient à ▶, réactivé.
        self._animation_spin.stop()
        self.bouton_executer.setIcon(self._icone_jouer)
        self.bouton_executer.setEnabled(True)
        self.bouton_executer.setToolTip("Exécuter cette cellule")
        # [SYNC-DIAG] bouton ▶ de la cellule revenu à l'état repos
        _sync_diag_marquer_ui("BOUTON ▶ cellule revenu au repos", f"statut_cellule={cellule.statut!r}")

        if cellule.numero_execution is not None:
            self.label_indicateur.setText(f"[{cellule.numero_execution}]")
        else:
            self.label_indicateur.setText("[ ]")

        if cellule.statut == "erreur":
            self.label_indicateur.setStyleSheet(f"color: {DarculaTheme.rouge};")
        elif cellule.statut == "succes":
            self.label_indicateur.setStyleSheet(f"color: {DarculaTheme.vert};")
        elif cellule.statut == "interrompu":
            # Cf. docstring TaskCellule.statut : coupée par "Tout arrêter"
            # avant la fin -- orange, distinct du rouge (erreur réelle).
            self.label_indicateur.setStyleSheet(f"color: {Mocha.peach};")
        else:
            self.label_indicateur.setStyleSheet(f"color: {Mocha.subtext0};")

        if cellule.sortie:
            # PATCH anti-gel : un QLabel avec plusieurs Mo de texte fige l'UI.
            _s = cellule.sortie
            if len(_s) > 50000:
                _s = f"[… sortie tronquée à l'affichage ({len(_s)} caractères au total) …]\n" + _s[-50000:]
            self.zone_sortie.setText(_s)
            self.zone_sortie.setProperty("erreur", cellule.statut == "erreur")
            self.zone_sortie.style().unpolish(self.zone_sortie)
            self.zone_sortie.style().polish(self.zone_sortie)
            # BUGFIX repli : le texte est toujours posé (setText ci-dessus)
            # pour être prêt dès le dépli, mais l'affichage réel (show)
            # reste soumis à l'état replié -- sans ce garde-fou, une
            # cellule repliée dont l'exécution vient de se terminer
            # verrait sa sortie réapparaître malgré elle, cf.
            # _appliquer_etat_replie qui gère ce même cas à la
            # construction/au toggle.
            if not self.bouton_replier.isChecked():
                self.zone_sortie.show()
                self.entete_sortie.show()
        else:
            self.zone_sortie.clear()
            self.zone_sortie.hide()
            self.entete_sortie.hide()

        # Réapplique l'état actif/désactivé PAR-DESSUS ce qui précède --
        # afficher_resultat() vient de réactiver bouton_executer
        # inconditionnellement (fin normale d'exécution), donc une cellule
        # désactivée doit être regrisée ici plutôt que de repasser
        # cliquable à chaque rafraîchissement (cf. _rafraichir_etat_actif).
        self._rafraichir_etat_actif()

    def afficher_sortie_en_direct(self, texte: str):
        """PATCH logs en direct (local) : affiche le texte déjà imprimé PENDANT l'exécution (le bouton reste « en
        cours » ; seul afficher_resultat() le remet au repos)."""
        if not texte:
            return
        _s = texte
        if len(_s) > 50000:
            _s = f"[… sortie tronquée à l'affichage ({len(_s)} caractères au total) …]\n" + _s[-50000:]
        self.zone_sortie.setText(_s)
        if self.zone_sortie.property("erreur"):
            self.zone_sortie.setProperty("erreur", False)
            self.zone_sortie.style().unpolish(self.zone_sortie)
            self.zone_sortie.style().polish(self.zone_sortie)
        if not self.bouton_replier.isChecked():
            self.zone_sortie.show()
            self.entete_sortie.show()

    def _copier_sortie(self):
        """Bouton "copier" de l'en-tête de sortie (à côté du bouton
        "vider", décision explicite utilisateur) -- copie le texte BRUT de
        la sortie affichée (pas de mise en forme) dans le presse-papier
        SYSTÈME (QGuiApplication.clipboard(), même pattern que
        PanneauComposantsImportesTask._sur_clic_composant), jamais le
        presse-papier VIRTUEL propre à une instance nodriver (get_clipboard/
        set_clipboard, sans rapport). Feedback bref (tooltip + icône
        confirmée) pour indiquer que la copie a eu lieu, sans bloquer
        l'interaction -- revient à l'icône normale après 1.2s."""
        texte = self.zone_sortie.text()
        if not texte:
            return
        QGuiApplication.clipboard().setText(texte)
        self.bouton_copier_sortie.setIcon(qta.icon("mdi6.check", color=Mocha.green))
        self.bouton_copier_sortie.setToolTip("Copié !")
        QTimer.singleShot(1200, self._restaurer_icone_copier_sortie)

    def _restaurer_icone_copier_sortie(self):
        self.bouton_copier_sortie.setIcon(qta.icon("mdi6.content-copy", color=Mocha.subtext0))
        self.bouton_copier_sortie.setToolTip("Copier la sortie de cette cellule")

    # ------------------------------------------------------------------
    # Activer/désactiver la cellule (clic droit sur ▶, cf.
    # demande_toggle_active) -- décision explicite utilisateur : "chque
    # cellule peu etre desactiver donc une cellule qui quad on desactive
    # on ne peu plus executer, si je lance lexecution globale elle est
    # ignorer".
    # ------------------------------------------------------------------
    def definir_active(self, active: bool):
        """Appelé par TaskConfigScreen après bascule (source de vérité :
        TaskCellule.active persisté) -- ne PAS appeler directement depuis
        l'UI, passer par demande_toggle_active pour que l'état persisté et
        l'affichage restent synchronisés."""
        self._active = active
        self._rafraichir_etat_actif()

    def est_active(self) -> bool:
        return self._active

    def _sur_clic_bouton_executer(self):
        """BUGFIX (rapporté par l'utilisateur : le clic droit sur ▶ ne
        réactivait plus une cellule désactivée) -- CAUSE : avant ce patch,
        _rafraichir_etat_actif() appelait bouton_executer.setEnabled(False)
        pour une cellule désactivée. Un QWidget désactivé (Qt.WA_Disabled)
        cesse de recevoir TOUT événement souris, y compris les clics
        droits -- pas seulement les clics gauches visés. Donc
        mousePressEvent (cf. QToolButtonAvecClicDroit), qui détecte le
        clic droit et émet clic_droit, n'était plus jamais appelé une fois
        la cellule désactivée : plus aucun clic droit ne pouvait
        réactiver.

        FIX : le bouton reste maintenant TOUJOURS setEnabled(True) (cf.
        _rafraichir_etat_actif), donc mousePressEvent continue de recevoir
        les deux boutons. Le filtrage du clic GAUCHE (qui ne doit
        toujours pas lancer l'exécution d'une cellule désactivée) se fait
        ICI plutôt que via setEnabled -- ignore simplement le clic si
        _active est False, sans jamais bloquer le clic droit."""
        if not self._active:
            return
        self.demande_execution.emit(self.cellule_id)

    def _rafraichir_etat_actif(self):
        """Applique l'état visuel actif/désactivé sur le bouton ▶ --
        appelée à la construction, après bascule, et à la fin de
        afficher_resultat() (pour ne pas être écrasée par la remise à ▶
        normale qui suit toute exécution).

        setEnabled(True) dans les DEUX branches (actif et désactivé) --
        volontaire, cf. docstring de _sur_clic_bouton_executer : le
        bouton doit rester activé même cellule désactivée, sinon plus
        aucun clic droit n'atteint mousePressEvent et la cellule reste
        bloquée désactivée pour de bon. Le clic gauche est filtré côté
        _sur_clic_bouton_executer, pas via setEnabled."""
        if self._active:
            self.setProperty("celluleDesactivee", False)
            self.bouton_executer.setIcon(self._icone_jouer)
            self.bouton_executer.setEnabled(True)
            self.bouton_executer.setToolTip(
                "Exécuter cette cellule (clic droit : désactiver)"
            )
        else:
            self.setProperty("celluleDesactivee", True)
            self.bouton_executer.setIcon(self._icone_desactivee)
            self.bouton_executer.setEnabled(True)
            self.bouton_executer.setToolTip(
                "Cellule désactivée -- ignorée par « Tout exécuter » (clic droit : réactiver)"
            )
        self.style().unpolish(self)
        self.style().polish(self)

    def indiquer_en_cours(self):
        """Feedback immédiat au clic sur ▶, avant que le résultat réel
        n'arrive -- le bouton ▶ lui-même se change en icône de chargement
        qui tourne (décision explicite utilisateur), pas seulement
        l'indicateur [*] texte à côté."""
        self.label_indicateur.setText("[*]")
        self.label_indicateur.setStyleSheet(f"color: {Mocha.yellow};")
        self.bouton_executer.setIcon(self._icone_en_cours)
        self._animation_spin.start()
        self.bouton_executer.setEnabled(False)
        self.bouton_executer.setToolTip("Exécution en cours...")

    # ------------------------------------------------------------------
    # États visuels PROPRES à "Tout exécuter" (séquence globale, cf.
    # TaskConfigScreen._executer_toutes_cellules) -- distincts de
    # indiquer_en_cours()/afficher_resultat() ci-dessus, qui restent
    # inchangés pour l'exécution individuelle (décision explicite
    # utilisateur : "l'exécution individuelle reste séparée de ça").
    #
    # Pendant une séquence globale, TOUTE cellule qui n'a pas encore
    # terminé son tour (en attente OU en cours) affiche ⏹ désactivé au
    # lieu de ▶ -- clic impossible, seul "Tout arrêter" coupe la
    # séquence (décision explicite utilisateur : "on ne peut pas, ça
    # doit être légèrement gris, la seule façon d'arrêter c'est
    # d'utiliser l'arrêt global").
    # ------------------------------------------------------------------
    def indiquer_en_attente_sequence(self):
        """Cellule pas encore passée dans la séquence en cours :
        indicateur gris, bouton ⏹ désactivé (non cliquable)."""
        self._animation_spin.stop()
        self.label_indicateur.setText("[ ]")
        self.label_indicateur.setStyleSheet(f"color: {Mocha.subtext0};")
        self.bouton_executer.setIcon(self._icone_stop_inactif)
        self.bouton_executer.setEnabled(False)
        self.bouton_executer.setToolTip("En attente -- utilisez « Tout arrêter » pour couper la séquence")

    def indiquer_en_cours_sequence(self):
        """Cellule actuellement exécutée par la séquence : indicateur
        jaune + spinner qui tourne, bouton ⏹ désactivé (non cliquable --
        seul l'arrêt global peut couper CETTE cellule précise)."""
        self.label_indicateur.setText("[*]")
        self.label_indicateur.setStyleSheet(f"color: {Mocha.yellow};")
        self.bouton_executer.setIcon(self._icone_stop_en_cours)
        self._animation_spin.start()
        self.bouton_executer.setEnabled(False)
        self.bouton_executer.setToolTip("En cours -- utilisez « Tout arrêter » pour couper la séquence")

    def indiquer_interrompu(self, cellule: "TaskCellule"):
        """Cellule qui tournait au moment d'un "Tout arrêter" : indicateur
        orange, bouton ▶ redevient normal et cliquable tout de suite
        (décision explicite utilisateur -- pas d'état gelé après coupure)."""
        cellule.statut = "interrompu"
        self.afficher_resultat(cellule)

    # ------------------------------------------------------------------
    # Suppression de cellule -- confirmation en 2 clics rapprochés (cf.
    # docstring du bouton_supprimer plus haut).
    # ------------------------------------------------------------------
    _DELAI_CONFIRMATION_MS = 2500

    def _sur_clic_supprimer(self):
        if not self._suppression_armee:
            self._armer_suppression()
        else:
            self._timer_confirmation_suppression.stop()
            self._suppression_armee = False
            self.demande_suppression.emit(self.cellule_id)

    def _armer_suppression(self):
        self._suppression_armee = True
        self.bouton_supprimer.setIcon(qta.icon("mdi6.close", color=DarculaTheme.rouge))
        self.bouton_supprimer.setToolTip("Cliquez à nouveau pour confirmer la suppression")
        self._timer_confirmation_suppression.start(self._DELAI_CONFIRMATION_MS)

    def _desarmer_suppression(self):
        self._suppression_armee = False
        self.bouton_supprimer.setIcon(qta.icon("mdi6.close", color=Mocha.subtext0))
        self.bouton_supprimer.setToolTip("Supprimer cette cellule")

    # ------------------------------------------------------------------
    # Bouton "étiquette" -- cellule "Variable dynamique" uniquement (MAJ
    # déplacé depuis cellules[0]/"Main"), pilote aussi le sticky de
    # cellules[0] voisine sur la même row (cf. __init__ et
    # TaskConfigScreen._sur_etiquette_cellule_basculee).
    # ------------------------------------------------------------------
    def _rafraichir_bouton_etiquette(self):
        self.bouton_etiquette.blockSignals(True)
        self.bouton_etiquette.setChecked(self._etiquetee)
        self.bouton_etiquette.blockSignals(False)
        if self._etiquetee:
            self.bouton_etiquette.setIcon(qta.icon("mdi6.label", color=Mocha.lavender))
            self.bouton_etiquette.setToolTip("Row d'initialisation étiquetée (cliquer pour désactiver)")
        else:
            self.bouton_etiquette.setIcon(qta.icon("mdi6.label-outline", color=Mocha.subtext0))
            self.bouton_etiquette.setToolTip("Row d'initialisation non étiquetée (cliquer pour activer)")

    def _sur_clic_etiquette(self):
        self._etiquetee = self.bouton_etiquette.isChecked()
        self._rafraichir_bouton_etiquette()
        # Cf. __init__ : _epinglee_visuelle (pas _insuprimable) pilote
        # désormais le style visuel épinglé, pour que seule la cellule
        # "Variable dynamique" le porte -- même si ce bouton (celui de
        # cellules[0]) reste celui qui pilote le sticky des deux cellules.
        self.setProperty("epinglee", bool(self._epinglee_visuelle and self._etiquetee))
        self.style().unpolish(self)
        self.style().polish(self)
        self.etiquette_basculee.emit(self.cellule_id, self._etiquetee)


class NotebookExecutionLectureSeule(QWidget):
    """Notebook en LECTURE SEULE affichant la séquence de cellules d'un
    Task en cours (ou déjà terminé) d'exécution sur UN sous-projet donné
    -- cf. onglet "Aperçu d'exécution" de ProjetBatchScreen, Brique E du
    plan de patch. NE réutilise PAS TaskCelluleWidget tel quel (pas de
    bouton exécuter/supprimer/ajouter/étiquette -- pure lecture) mais
    reprend les mêmes objectNames pour le titre et la sortie
    (#CelluleTitreLabel, #CelluleSortie) afin d'hériter automatiquement
    du même style QSS que TaskConfigScreen (cf. build_stylesheet),
    plutôt que dupliquer ces règles.

    Deux modes d'alimentation, jamais mélangés dans une même vue :
      - HISTORIQUE (charger_tentative) : reconstruit tout l'affichage
        d'un coup à partir d'une tentative déjà terminée (cf. structure
        Brique B, SousProjet.lire_historique_executions), rien ne bouge
        plus après -- navigation précédent/suivant dans l'historique
        d'une instance (cf. ProjetBatchScreen).
      - LIVE (demarrer_sequence puis marquer_cellule_demarree/
        marquer_cellule_terminee au fil de l'exécution) : construit
        d'abord tous les blocs à l'état "non_atteinte" (grisés), puis
        les fait progresser un par un au fil des signaux relayés par
        MoteurExecutionBatch (cf. Brique D)."""

    # États visuels d'un bloc de cellule (cf. _rafraichir_etat_bloc) --
    # noms distincts de TaskCellule.statut ("inedit"/"succes"/"erreur"/
    # "interrompu") : ce widget n'édite jamais de TaskCellule réelle, il
    # affiche la progression d'UNE tentative précise, dont le vocabulaire
    # est volontairement propre à Brique B/E plutôt que réemprunté tel
    # quel à TaskCellule.
    ETAT_NON_ATTEINTE = "non_atteinte"
    ETAT_EN_COURS = "en_cours"
    ETAT_TERMINEE_OK = "terminee_ok"
    ETAT_TERMINEE_ERREUR = "terminee_erreur"

    def __init__(self, reglages: Optional["ReglagesApp"] = None, parent=None):
        super().__init__(parent)
        self.setObjectName("NotebookExecutionLectureSeule")
        self.reglages = reglages

        # id de cellule -> dict des widgets de son bloc (cf. _construire_bloc)
        # -- reconstruit entièrement à chaque charger_tentative/
        # demarrer_sequence (jamais réutilisé d'une séquence à l'autre :
        # les cellule_id peuvent différer d'un Task à l'autre, et même
        # d'une tentative à l'autre si le Task a été modifié entre-temps).
        self._blocs: dict = {}
        # Ordre des cellule_id de la séquence actuellement affichée --
        # utilisé pour un futur besoin de parcours ordonné (badge "cellule
        # i/n", cf. _construire_bloc) sans avoir à refouiller un dict.
        self._ordre_cellule_ids: list = []

        layout_racine = QVBoxLayout(self)
        layout_racine.setContentsMargins(0, 0, 0, 0)
        layout_racine.setSpacing(0)

        self._scroll = QScrollArea(self)
        self._scroll.setObjectName("NotebookExecutionScrollArea")
        self._scroll.setWidgetResizable(True)
        self._scroll.setFrameShape(QFrame.NoFrame)
        self._scroll.setHorizontalScrollBarPolicy(Qt.ScrollBarAlwaysOff)
        layout_racine.addWidget(self._scroll)

        self._contenu = QWidget()
        self._contenu_layout = QVBoxLayout(self._contenu)
        self._contenu_layout.setContentsMargins(16, 16, 16, 16)
        self._contenu_layout.setSpacing(14)
        self._contenu_layout.addStretch(1)
        self._scroll.setWidget(self._contenu)

        # Label affiché quand aucune séquence n'est chargée (avant la
        # toute première sélection d'instance/tentative côté
        # ProjetBatchScreen) -- évite une zone vide déroutante.
        self._label_vide = QLabel("Aucune exécution à afficher pour l'instant.", self._contenu)
        self._label_vide.setObjectName("NotebookExecutionLabelVide")
        self._label_vide.setAlignment(Qt.AlignCenter)
        self._contenu_layout.insertWidget(0, self._label_vide)

    # ------------------------------------------------------------------
    # Construction des blocs
    # ------------------------------------------------------------------
    def _vider(self):
        for bloc in self._blocs.values():
            bloc["widget"].setParent(None)
            bloc["widget"].deleteLater()
        self._blocs = {}
        self._ordre_cellule_ids = []

    def _construire_bloc(self, cellule_id: str, titre: str, code: str, index: int, total: int) -> dict:
        """Construit UN bloc de cellule en lecture seule (titre + badge
        "cellule i/n" + code repliable + zone de sortie + zone d'image de
        bug), retourne un dict de ses widgets internes pour mise à jour
        ultérieure par _rafraichir_etat_bloc/_afficher_sortie -- ajouté à
        self._contenu_layout par l'appelant (juste avant le stretch
        final).

        RE-PATCH (retour utilisateur explicite -- "le meux est qu eon
        laise laffihcage du notebo k , mais les cellcule doivent etre
        plier") : le code (TaskScriptEditor) n'est plus affiché en
        permanence. Titre + badge + état + sortie/erreur restent TOUJOURS
        visibles sans interaction ; seul le code est caché derrière un
        bouton toggle (bouton_code), REPLIÉ PAR DÉFAUT pour toute cellule
        -- y compris celles en erreur (décision explicite utilisateur :
        "Toutes les cellules repliées par défaut", pas d'exception pour
        les erreurs, la sortie/erreur textuelle affichée en permanence
        suffit à voir ce qui a échoué sans déplier)."""
        widget = QFrame(self._contenu)
        widget.setObjectName("NotebookExecutionBloc")

        layout = QVBoxLayout(widget)
        layout.setContentsMargins(12, 10, 12, 10)
        layout.setSpacing(6)

        entete = QWidget(widget)
        entete_layout = QHBoxLayout(entete)
        entete_layout.setContentsMargins(0, 0, 0, 0)
        entete_layout.setSpacing(8)

        # Bouton plier/déplier le code -- placé en tête de la rangée de
        # titre (chevron), bascule uniquement la visibilité de `editeur`
        # ci-dessous (cf. _sur_toggle_code) ; jamais l'état d'exécution
        # ni la sortie, qui restent affichés indépendamment de ce bouton.
        bouton_code = QToolButton(entete)
        bouton_code.setObjectName("NotebookExecutionToggleCode")
        bouton_code.setCheckable(True)
        bouton_code.setChecked(False)
        bouton_code.setAutoRaise(True)
        bouton_code.setCursor(Qt.PointingHandCursor)
        bouton_code.setIcon(qta.icon("mdi6.chevron-right", color=Mocha.subtext0))
        bouton_code.setIconSize(QSize(16, 16))
        bouton_code.setToolTip("Afficher/masquer le code de cette cellule")
        entete_layout.addWidget(bouton_code)

        label_titre = QLabel(titre or "*(cellule sans titre)*", entete)
        label_titre.setObjectName("CelluleTitreLabel")
        label_titre.setProperty("vide", not bool(titre))
        entete_layout.addWidget(label_titre, 1)

        label_badge = QLabel(f"cellule {index}/{total}", entete)
        label_badge.setObjectName("NotebookExecutionBadge")
        entete_layout.addWidget(label_badge)

        label_etat = QLabel(entete)
        label_etat.setObjectName("NotebookExecutionEtat")
        label_etat.setFixedWidth(20)
        label_etat.setAlignment(Qt.AlignCenter)
        entete_layout.addWidget(label_etat)

        layout.addWidget(entete)

        editeur = TaskScriptEditor(self.reglages, widget)
        editeur.setPlainText(code)
        editeur.setReadOnly(True)
        # Pas de curseur clignotant ni de focus visuel sur un éditeur
        # qu'on ne peut jamais modifier -- évite de laisser croire qu'on
        # peut cliquer dedans pour éditer.
        editeur.setFocusPolicy(Qt.NoFocus)
        editeur._ajuster_hauteur()
        # Replié par défaut (cf. docstring ci-dessus) -- bouton_code.
        # setChecked(False) juste au-dessus reflète déjà cet état, ici on
        # applique l'effet réel sur la visibilité du widget.
        editeur.setVisible(False)
        layout.addWidget(editeur)

        def _sur_toggle_code(coche: bool, _editeur=editeur, _bouton=bouton_code):
            _editeur.setVisible(coche)
            _bouton.setIcon(qta.icon(
                "mdi6.chevron-down" if coche else "mdi6.chevron-right", color=Mocha.subtext0,
            ))

        bouton_code.toggled.connect(_sur_toggle_code)

        zone_sortie = QLabel(widget)
        zone_sortie.setObjectName("CelluleSortie")
        zone_sortie.setWordWrap(True)
        zone_sortie.setTextInteractionFlags(Qt.TextSelectableByMouse)
        zone_sortie.setAlignment(Qt.AlignLeft | Qt.AlignTop)
        zone_sortie.hide()
        layout.addWidget(zone_sortie)

        # Image de la capture d'écran de l'instance au moment d'une
        # erreur (cf. _afficher_sortie, alimentée par le champ "image_bug"
        # de la tentative/du signal cellule_terminee) -- cachée par défaut
        # et RESTE cachée tant qu'aucune image n'est fournie (décision
        # explicite utilisateur : "sil ya pas diamage alors on lnaffiche
        # pas juste"), jamais un cadre vide à la place.
        label_image_bug = QLabel(widget)
        label_image_bug.setObjectName("NotebookExecutionImageBug")
        label_image_bug.setAlignment(Qt.AlignLeft | Qt.AlignTop)
        label_image_bug.hide()
        layout.addWidget(label_image_bug)

        # Spinner qtawesome réutilisé sur le label d'état, même pattern
        # que TaskCelluleWidget.indiquer_en_cours (cf. sa docstring : "le
        # bouton qui carré que le cercle tourne un peu autour"), ici
        # appliqué à une icône simple faute de bouton exécuter.
        animation_spin = qta.Spin(label_etat, interval=500, step=60, autostart=False)  # PATCH11 : 2 fps
        icones = {
            "en_cours": qta.icon("mdi6.loading", color=Mocha.yellow, animation=animation_spin),
            "ok": qta.icon("mdi6.check-circle", color=Mocha.green),
            "erreur": qta.icon("mdi6.close-circle", color=Mocha.red),
        }

        return {
            "widget": widget,
            "label_titre": label_titre,
            "label_badge": label_badge,
            "label_etat": label_etat,
            "bouton_code": bouton_code,
            "editeur": editeur,
            "zone_sortie": zone_sortie,
            "label_image_bug": label_image_bug,
            "animation_spin": animation_spin,
            "icones": icones,
            "etat": None,
        }

    def _rafraichir_etat_bloc(self, bloc: dict, etat: str):
        """Applique l'état visuel demandé (cf. constantes ETAT_*) à un
        bloc déjà construit : grisé pour non_atteinte, spinner pour
        en_cours, icône verte/rouge pour terminee_ok/terminee_erreur --
        pilote à la fois la propriété QSS "etat" du QFrame (grisage
        global via #NotebookExecutionBloc[etat=...]) et l'icône du label
        d'état à droite du titre."""
        bloc["etat"] = etat
        bloc["animation_spin"].stop()
        if etat == self.ETAT_NON_ATTEINTE:
            bloc["label_etat"].clear()
        elif etat == self.ETAT_EN_COURS:
            bloc["label_etat"].setPixmap(bloc["icones"]["en_cours"].pixmap(16, 16))
            bloc["animation_spin"].start()
        elif etat == self.ETAT_TERMINEE_OK:
            bloc["label_etat"].setPixmap(bloc["icones"]["ok"].pixmap(16, 16))
        elif etat == self.ETAT_TERMINEE_ERREUR:
            bloc["label_etat"].setPixmap(bloc["icones"]["erreur"].pixmap(16, 16))
        bloc["widget"].setProperty("etat", etat)
        bloc["widget"].style().unpolish(bloc["widget"])
        bloc["widget"].style().polish(bloc["widget"])

    def _afficher_sortie(self, bloc: dict, sortie: Optional[str], erreur: Optional[str], image_bug: Optional[str] = None):
        texte = erreur or sortie
        if texte:
            bloc["zone_sortie"].setText(texte)
            bloc["zone_sortie"].setProperty("erreur", bool(erreur))
            bloc["zone_sortie"].style().unpolish(bloc["zone_sortie"])
            bloc["zone_sortie"].style().polish(bloc["zone_sortie"])
            bloc["zone_sortie"].show()
        else:
            bloc["zone_sortie"].clear()
            bloc["zone_sortie"].hide()
        self._afficher_image_bug(bloc, image_bug)

    def _afficher_image_bug(self, bloc: dict, image_bug: Optional[str]):
        """Affiche la capture d'écran sauvegardée au moment d'une erreur
        de cellule (cf. chemin écrit par MoteurExecutionBatch, action
        réseau capture_propre) sous la zone de sortie -- décision
        explicite utilisateur : "sil ya pas diamage alors on lnaffiche
        pas juste", donc AUCUN cadre/placeholder tant qu'il n'y a pas
        d'image réellement chargeable : `image_bug` vide, chemin
        inexistant, ou fichier illisible/corrompu retombent tous
        silencieusement sur le label caché, jamais une icône d'erreur de
        chargement à la place."""
        label = bloc["label_image_bug"]
        if not image_bug:
            label.clear()
            label.hide()
            return
        chemin = Path(image_bug)
        if not chemin.is_file():
            label.clear()
            label.hide()
            return
        pixmap = QPixmap(str(chemin))
        if pixmap.isNull():
            label.clear()
            label.hide()
            return
        # Largeur bornée pour ne pas déborder du panneau (le notebook vit
        # dans un onglet de taille limitée) -- hauteur proportionnelle,
        # image jamais agrandie au-delà de sa taille réelle.
        largeur_max = 640
        if pixmap.width() > largeur_max:
            pixmap = pixmap.scaledToWidth(largeur_max, Qt.SmoothTransformation)
        label.setPixmap(pixmap)
        label.show()

    # ------------------------------------------------------------------
    # Mode HISTORIQUE -- reconstruction d'une tentative déjà terminée
    # ------------------------------------------------------------------
    def charger_tentative(self, tentative: dict):
        """Reconstruit tout l'affichage à partir d'un dict de tentative
        déjà terminée (cf. structure Brique B, un élément de SousProjet.
        lire_historique_executions()) -- mode HISTORIQUE, rien ne bouge
        plus après cet appel tant qu'un autre charger_tentative/
        demarrer_sequence n'est pas appelé."""
        self._label_vide.hide()
        self._vider()
        cellules = tentative.get("cellules") or []
        total = len(cellules)
        for index, cellule_dict in enumerate(cellules, start=1):
            cellule_id = cellule_dict.get("cellule_id", "")
            bloc = self._construire_bloc(
                cellule_id, cellule_dict.get("titre", ""), cellule_dict.get("code", ""),
                index, total,
            )
            self._contenu_layout.insertWidget(self._contenu_layout.count() - 1, bloc["widget"])
            self._blocs[cellule_id] = bloc
            self._ordre_cellule_ids.append(cellule_id)

            if not cellule_dict.get("atteinte", False):
                self._rafraichir_etat_bloc(bloc, self.ETAT_NON_ATTEINTE)
                continue
            erreur = cellule_dict.get("erreur")
            self._rafraichir_etat_bloc(
                bloc, self.ETAT_TERMINEE_ERREUR if erreur else self.ETAT_TERMINEE_OK,
            )
            # image_bug : chemin du screenshot capturé au moment de
            # l'erreur (cf. MoteurExecutionBatch._finir_sous_projet,
            # absent/None pour une cellule réussie ou si la capture a
            # échoué -- _afficher_image_bug gère déjà l'absence).
            self._afficher_sortie(bloc, cellule_dict.get("sortie"), erreur, cellule_dict.get("image_bug"))

    # ------------------------------------------------------------------
    # Mode LIVE -- progression au fil de l'exécution en cours
    # ------------------------------------------------------------------
    def demarrer_sequence(self, sequence_cellules: list):
        """Construit les blocs vides (tout en ETAT_NON_ATTEINTE) à partir
        de sequence_cellules (list[TaskCellule], cf. MoteurExecutionBatch.
        sequence_cellules_pour_instance) -- appelé quand un sous-projet
        démarre en LIVE sur l'instance actuellement affichée, AVANT que
        la première cellule n'ait démarré (aucune sortie encore connue à
        ce stade). marquer_cellule_demarree/marquer_cellule_terminee font
        ensuite progresser ces blocs un par un."""
        self._label_vide.hide()
        self._vider()
        total = len(sequence_cellules)
        for index, cellule in enumerate(sequence_cellules, start=1):
            bloc = self._construire_bloc(cellule.id, cellule.titre, cellule.code, index, total)
            self._contenu_layout.insertWidget(self._contenu_layout.count() - 1, bloc["widget"])
            self._blocs[cellule.id] = bloc
            self._ordre_cellule_ids.append(cellule.id)
            self._rafraichir_etat_bloc(bloc, self.ETAT_NON_ATTEINTE)

    def marquer_cellule_demarree(self, cellule_id: str, titre: str):
        """cf. MoteurExecutionBatch.sous_projet_cellule_demarree, relayé
        par ProjetBatchScreen UNIQUEMENT si instance_id correspond à
        l'instance actuellement affichée dans l'onglet Aperçu. Ignoré
        silencieusement si cellule_id est inconnu de la séquence
        actuellement affichée (ex: notebook pas encore reconstruit par
        demarrer_sequence au moment où ce signal arrive -- ne devrait
        normalement pas se produire vu l'ordre garanti par Brique D, mais
        gardé par prudence plutôt que de lever une exception)."""
        bloc = self._blocs.get(cellule_id)
        if bloc is None:
            return
        self._rafraichir_etat_bloc(bloc, self.ETAT_EN_COURS)
        self._scroll.ensureWidgetVisible(bloc["widget"], 0, 40)

    def marquer_cellule_terminee(self, cellule_id: str, ok: bool, sortie_ou_erreur: str):
        """cf. MoteurExecutionBatch.sous_projet_cellule_terminee, même
        garde que marquer_cellule_demarree ci-dessus. Ne connaît PAS
        encore l'image de bug à cet instant (cf. afficher_image_bug_
        cellule ci-dessous) : la capture_propre demandée à l'instance en
        cas d'erreur est asynchrone (aller-retour réseau) et arrive
        toujours APRÈS ce signal, jamais avec -- ce signal ne porte que
        cellule_id/ok/sortie_ou_erreur (cf. sa signature côté
        MoteurExecutionBatch, inchangée pour ne rien casser côté
        historique/callers existants)."""
        bloc = self._blocs.get(cellule_id)
        if bloc is None:
            return
        self._rafraichir_etat_bloc(bloc, self.ETAT_TERMINEE_OK if ok else self.ETAT_TERMINEE_ERREUR)
        self._afficher_sortie(bloc, sortie_ou_erreur if ok else None, None if ok else sortie_ou_erreur)

    def afficher_image_bug_cellule(self, cellule_id: str, image_bug: Optional[str]):
        """Attache la capture d'écran de l'erreur à un bloc déjà terminé
        (cf. marquer_cellule_terminee ci-dessus) -- appelée séparément,
        une fois que MoteurExecutionBatch a reçu la réponse de
        capture_propre (cf. son signal sous_projet_cellule_image_bug),
        puisque cette capture arrive toujours après le signal cellule_
        terminee. Ignorée silencieusement si le bloc n'existe plus (ex:
        un autre onglet/tentative a déjà été chargé entre-temps) ou si
        image_bug est vide (_afficher_image_bug gère déjà ce cas :
        n'affiche rien)."""
        bloc = self._blocs.get(cellule_id)
        if bloc is None:
            return
        self._afficher_image_bug(bloc, image_bug)

    def vider_affichage(self):
        """Revient à l'état initial (label "Aucune exécution à afficher")
        -- utilisé par ProjetBatchScreen quand aucune instance n'est
        sélectionnée dans la colonne de gauche, ou avant un rechargement."""
        self._vider()
        self._label_vide.show()


def _formater_date_carte(iso: str) -> str:
    """Formate une date ISO (Task.date_creation/date_derniere_ouverture)
    pour affichage compact sur une TaskCarte -- "07/08/2026 10:42".
    Défensif : une chaîne vide/invalide (ne devrait pas arriver, cf.
    migration EPOCH_ISO, mais un futur format de sauvegarde corrompu ne
    doit pas faire planter l'affichage de toute la grille) retombe sur
    "--" plutôt que de lever une exception dans _rafraichir_info."""
    try:
        dt = datetime.fromisoformat(iso)
    except (ValueError, TypeError):
        return "--"
    return dt.strftime("%d/%m/%Y %H:%M")


def _formater_taille_octets(taille: int) -> str:
    """o / Ko / Mo, une décimale au-delà de l'octet -- pas besoin d'aller
    plus loin (Go+) pour la taille sérialisée d'un seul Task."""
    if taille < 1024:
        return f"{taille} o"
    taille_ko = taille / 1024
    if taille_ko < 1024:
        return f"{taille_ko:.1f} Ko"
    return f"{taille_ko / 1024:.1f} Mo"


class TaskCarte(QFrame):
    """Mini-card d'un Task dans la grille du haut.

    RE-PATCH (retour utilisateur explicite, après un premier essai jugé
    encore trop chargé -- "tu na spas bein faire pour les icon de task,
    idiot jai dit juste le logo, avec le noms de la task en bas, comme un
    fichier, rien de plus... pourquoi tu met des contour bizare. unseule
    gros icone et le noms en bas.") : plus AUCUN élément que l'icône et le
    nom. Concrètement, par rapport à la version précédente :
    - Suppression totale du sous-titre "N ServiceAPI importé" (info_label)
      qui restait affiché en permanence sous le nom -- il n'y a plus que
      deux widgets dans la card : l'icône et le nom.
    - Suppression du cadre/fond visible au repos (cf. #TaskCarte dans la
      feuille de style : plus de border ni de background-color tant que
      la souris n'est pas dessus) -- c'est ce que l'utilisateur appelait
      les "contour bizare".
    - Icône encore agrandie (56px, était 40px) : c'est elle qui doit
      porter toute l'identité visuelle de la card, comme une icône de
      fichier sur un bureau.
    - Card resserrée en hauteur (140px, était 160px) puisqu'il n'y a plus
      qu'icône + nom à caser, plus besoin de l'espace du sous-titre.

    Cliquer dessus OUVRE l'éditeur du Task.

    MAJ décision utilisateur : renommer/supprimer directement depuis
    cette card (menu ⋮, coin haut-droit) SANS devoir d'abord ouvrir
    l'éditeur du Task -- "on doit pouvoir renomer, suprimer une task meme
    quand on est dans la prmeier interface task config elle meme". Le
    renommage se fait en place (nom_label devient un QLineEdit éditable),
    la suppression délègue à TaskConfigScreen._confirm_delete_task_id
    (même confirmation que depuis l'éditeur, cf. demande_suppression).

    Les propriétés (dernière ouverture, création, taille -- demandées à
    l'origine par l'utilisateur : "afficher plus de propiete pour chque
    fichier notebook... la date de dernier ouverture, creations...
    taille") restent disponibles, mais UNIQUEMENT en tooltip au survol de
    la card entière (cf. _rafraichir_info) -- jamais affichées en
    permanence sur la card elle-même, pour rester fidèle à "rien de plus"
    que l'icône et le nom. Ce Project ne stocke PAS un Task comme un
    fichier séparé sur disque (tout vit dans un seul project.json, cf.
    docstring Project), donc il n'existe pas de vraie taille/date fichier
    OS à lire -- la "taille" affichée est celle du JSON sérialisé de ce
    Task seul (len(json.dumps(task.to_dict()))), une mesure honnête de
    "combien ce Task pèse" sans prétendre à un fichier qui n'existe pas."""

    clique = Signal(str)  # id du Task
    demande_renommage = Signal(str, str)  # id du Task, nouveau nom
    demande_suppression = Signal(str)  # id du Task
    # AJOUT (spec B.5, épinglage) -- bascule task.epingle, câblé côté
    # TaskConfigScreen (seul détenteur du Project pour persister),
    # même patron que demande_renommage/demande_suppression ci-dessus.
    demande_toggle_epingle = Signal(str)  # id du Task
    # AJOUT -- teinte de l'icône ("" = défaut) et réordonnancement manuel
    # des épinglés par glisser-déposer (id déplacé, id cible).
    demande_couleur_icone = Signal(str, str)  # id du Task, "#rrggbb" ou ""
    demande_deplacement = Signal(str, str)  # id déplacé, id cible

    MIME_TASK_EPINGLE = "application/x-autoniax-task-epingle"
    PALETTE_COULEURS_ICONE = (
        ("Rouge", Mocha.red), ("Orange", Mocha.peach), ("Jaune", Mocha.yellow),
        ("Vert", Mocha.green), ("Turquoise", Mocha.teal), ("Bleu", Mocha.blue),
        ("Violet", Mocha.mauve), ("Rose", Mocha.pink),
    )

    def __init__(self, task: Task, parent=None):
        super().__init__(parent)
        self.task_id = task.id
        self._en_edition = False
        self._couleur_icone = task.couleur_icone
        self._epingle = task.epingle
        self._pos_appui = None
        self._drag_en_cours = False
        self.setAcceptDrops(True)
        self.setObjectName("TaskCarte")
        self.setFixedSize(200, 140)
        self.setCursor(Qt.PointingHandCursor)

        layout = QVBoxLayout(self)
        layout.setContentsMargins(14, 8, 14, 10)
        layout.setSpacing(4)

        # Rangée du haut : icône punaise (coin gauche, discrète, visible
        # UNIQUEMENT si task.epingle -- spec B.5) puis menu ⋮ (aligné à
        # droite, inchangé).
        header_row = QHBoxLayout()
        self.pin_label = QLabel(self)
        self.pin_label.setPixmap(qta.icon("mdi6.pin", color=Mocha.mauve).pixmap(14, 14))
        self.pin_label.setToolTip("Épinglé")
        self.pin_label.setVisible(task.epingle)
        header_row.addWidget(self.pin_label)
        header_row.addStretch(1)

        self.menu_button = QToolButton(self)
        self.menu_button.setObjectName("TaskCarteMenuButton")
        self.menu_button.setIcon(qta.icon("mdi6.dots-vertical", color=Mocha.subtext0))
        self.menu_button.setIconSize(QSize(16, 16))
        self.menu_button.setCursor(Qt.PointingHandCursor)
        self.menu_button.setToolTip("Options du Task")
        self.menu_button.setAutoRaise(True)
        self.menu_button.clicked.connect(self._afficher_menu)
        header_row.addWidget(self.menu_button)
        layout.addLayout(header_row)

        layout.addStretch(1)

        # LA grande icône "fichier" -- seul élément graphique de la card
        # avec le nom, rien d'autre autour (pas de cadre propre à
        # l'icône, pas de fond) : juste un pixmap posé, centré.
        self.icon_label = QLabel(self)
        self.icon_label.setAlignment(Qt.AlignCenter)
        self._appliquer_couleur_icone()
        layout.addWidget(self.icon_label)

        # Nom : QLabel en temps normal, basculé en QLineEdit le temps du
        # renommage inline (cf. _entrer_edition_nom/_sortir_edition_nom) --
        # même widget de mise en page, pas de dialog séparé. Centré, sous
        # l'icône, comme le nom d'un fichier sous son icône.
        self.nom_label = QLabel(task.nom, self)
        self.nom_label.setObjectName("TaskCarteNom")
        self.nom_label.setWordWrap(True)
        self.nom_label.setAlignment(Qt.AlignCenter)
        layout.addWidget(self.nom_label)

        self.nom_edit = QLineEdit(task.nom, self)
        self.nom_edit.setObjectName("TaskCarteNomEdit")
        self.nom_edit.setAlignment(Qt.AlignCenter)
        self.nom_edit.hide()
        self.nom_edit.editingFinished.connect(self._sortir_edition_nom)
        layout.addWidget(self.nom_edit)

        layout.addStretch(1)

        self._rafraichir_info(task)

    def _appliquer_couleur_icone(self):
        couleur = self._couleur_icone if QColor(self._couleur_icone).isValid() else Mocha.lavender
        self.icon_label.setPixmap(qta.icon("mdi6.script-text-outline", color=couleur).pixmap(56, 56))

    def _rafraichir_info(self, task: Task):
        # Propriétés détaillées (dernière ouverture, création, taille,
        # nombre de ServiceAPI importés) : UNIQUEMENT en tooltip, sur la
        # card entière -- cf. docstring de la classe. Rien de tout ça ne
        # doit apparaître comme widget visible en permanence.
        nb = len(task.services_api_importes)
        taille = len(json.dumps(task.to_dict(), ensure_ascii=False).encode("utf-8"))
        self.setToolTip(
            f"{task.nom}\n"
            f"{nb} ServiceAPI importé{'s' if nb > 1 else ''}\n"
            f"Dernière ouverture : {_formater_date_carte(task.date_derniere_ouverture)}\n"
            f"Création : {_formater_date_carte(task.date_creation)}\n"
            f"Taille (JSON sérialisé) : {_formater_taille_octets(taille)}"
        )
        # AJOUT (spec B.5) -- resynchronise la visibilité de la punaise à
        # chaque rafraîchissement (ex. après un toggle épinglé/désépinglé,
        # cf. TaskConfigScreen._reload_grille rappelée après le menu).
        self.pin_label.setVisible(task.epingle)
        self._epingle = task.epingle
        self._couleur_icone = task.couleur_icone
        self._appliquer_couleur_icone()

    def rafraichir(self, task: Task):
        self.nom_label.setText(task.nom)
        self.nom_edit.setText(task.nom)
        self._rafraichir_info(task)

    # ------------------------------------------------------------------
    # Menu ⋮ : Renommer (édition inline) / Supprimer (délègue à l'écran
    # parent, qui seul connaît le Project pour confirmer/persister).
    # ------------------------------------------------------------------
    def _afficher_menu(self):
        menu = QMenu(self)
        renommer_action = menu.addAction(qta.icon("mdi6.pencil-outline", color=Mocha.subtext0), "Renommer")
        # AJOUT (spec B.5) -- libellé dépend de l'état courant, lu via
        # pin_label.isVisible() (tenu à jour par _rafraichir_info à chaque
        # rechargement de la grille, cf. task.epingle) -- pas besoin de
        # garder une référence séparée au Task complet ici.
        if self.pin_label.isVisible():
            epingle_action = menu.addAction(qta.icon("mdi6.pin-off-outline", color=Mocha.subtext0), "Désépingler")
        else:
            epingle_action = menu.addAction(qta.icon("mdi6.pin-outline", color=Mocha.subtext0), "Épingler")
        # AJOUT -- sous-menu de teinte de l'icône (palette + libre + défaut).
        menu_couleur = menu.addMenu(qta.icon("mdi6.palette-outline", color=Mocha.subtext0), "Couleur de l'icône")
        actions_couleur = {}
        for nom_c, hex_c in self.PALETTE_COULEURS_ICONE:
            a = menu_couleur.addAction(qta.icon("mdi6.circle", color=hex_c), nom_c)
            actions_couleur[a] = hex_c
        menu_couleur.addSeparator()
        perso_action = menu_couleur.addAction(qta.icon("mdi6.eyedropper-variant", color=Mocha.subtext0), "Personnalisée...")
        defaut_action = menu_couleur.addAction(qta.icon("mdi6.restore", color=Mocha.subtext0), "Par défaut")
        supprimer_action = menu.addAction(qta.icon("mdi6.trash-can-outline", color=Mocha.red), "Supprimer")
        chosen = menu.exec(self.menu_button.mapToGlobal(self.menu_button.rect().bottomRight()))
        if chosen in actions_couleur:
            self.demande_couleur_icone.emit(self.task_id, actions_couleur[chosen])
        elif chosen == perso_action:
            depart = QColor(self._couleur_icone) if QColor(self._couleur_icone).isValid() else QColor(Mocha.lavender)
            choisie = QColorDialog.getColor(depart, self, "Couleur de l'icône")
            if choisie.isValid():
                self.demande_couleur_icone.emit(self.task_id, choisie.name())
        elif chosen == defaut_action:
            self.demande_couleur_icone.emit(self.task_id, "")
        elif chosen == renommer_action:
            self._entrer_edition_nom()
        elif chosen == epingle_action:
            self.demande_toggle_epingle.emit(self.task_id)
        elif chosen == supprimer_action:
            self.demande_suppression.emit(self.task_id)

    def _entrer_edition_nom(self):
        self._en_edition = True
        self.nom_edit.setText(self.nom_label.text())
        self.nom_label.hide()
        self.nom_edit.show()
        self.nom_edit.setFocus()
        self.nom_edit.selectAll()

    def _sortir_edition_nom(self):
        if not self._en_edition:
            return
        self._en_edition = False
        self.nom_edit.hide()
        self.nom_label.show()
        nouveau_nom = self.nom_edit.text().strip()
        if nouveau_nom and nouveau_nom != self.nom_label.text():
            self.demande_renommage.emit(self.task_id, nouveau_nom)
        else:
            # Nom vide ou inchangé : pas de signal, la card garde
            # simplement son nom actuel (rafraîchir() sera de toute façon
            # rappelé par TaskConfigScreen._renommer_task_id dans le cas
            # où le nom a réellement changé -- ici on remet juste
            # l'affichage local en cohérence tout de suite).
            self.nom_edit.setText(self.nom_label.text())

    # ------------------------------------------------------------------
    # Clic = à la RELÂCHE (et seulement si aucun glisser n'a eu lieu), pour
    # qu'un épinglé puisse être saisi et déplacé sans ouvrir son éditeur.
    # Seules les cartes ÉPINGLÉES sont déplaçables (les autres restent
    # triées par dernière ouverture).
    # ------------------------------------------------------------------
    def mousePressEvent(self, event):
        if self._en_edition:
            super().mousePressEvent(event)
            return
        if event.button() == Qt.LeftButton:
            self._pos_appui = event.position().toPoint()
            self._drag_en_cours = False
        super().mousePressEvent(event)

    def mouseMoveEvent(self, event):
        if (
            self._epingle and not self._en_edition and self._pos_appui is not None
            and (event.buttons() & Qt.LeftButton)
            and (event.position().toPoint() - self._pos_appui).manhattanLength() >= QApplication.startDragDistance()
        ):
            self._drag_en_cours = True
            self._pos_appui = None
            mime = QMimeData()
            mime.setData(self.MIME_TASK_EPINGLE, self.task_id.encode("utf-8"))
            drag = QDrag(self)
            drag.setMimeData(mime)
            drag.setPixmap(self.grab())
            drag.setHotSpot(event.position().toPoint())
            drag.exec(Qt.MoveAction)
            return
        super().mouseMoveEvent(event)

    def mouseReleaseEvent(self, event):
        if (
            event.button() == Qt.LeftButton and self._pos_appui is not None
            and not self._drag_en_cours and not self._en_edition
        ):
            self._pos_appui = None
            self.clique.emit(self.task_id)
        self._pos_appui = None
        super().mouseReleaseEvent(event)

    def dragEnterEvent(self, event):
        if self._epingle and event.mimeData().hasFormat(self.MIME_TASK_EPINGLE):
            event.acceptProposedAction()
        else:
            event.ignore()

    def dropEvent(self, event):
        if not (self._epingle and event.mimeData().hasFormat(self.MIME_TASK_EPINGLE)):
            event.ignore()
            return
        source_id = bytes(event.mimeData().data(self.MIME_TASK_EPINGLE)).decode("utf-8")
        event.acceptProposedAction()
        if source_id and source_id != self.task_id:
            self.demande_deplacement.emit(source_id, self.task_id)


class ZoneDefilementHorizontaleSansBarre(QScrollArea):
    """QScrollArea horizontale SANS barre visible (cf. TaskConfigScreen,
    toolbar réduite -- décision explicite utilisateur : "enleve le slide
    mais laisse la surface scrollable, je ne veux pas voir un slider").

    Masquer la barre (ScrollBarAlwaysOff) NE SUFFIT PAS pour rester
    utilisable à la souris : Qt ne redirige PAS automatiquement une
    molette verticale classique vers le scroll horizontal, même avec la
    barre verticale désactivée (vérifié empiriquement -- hbar.value()
    reste à 0 après un wheelEvent vertical standard sans cette
    redirection). Seuls trackpad (swipe horizontal natif) et Shift+molette
    fonctionneraient sans cette classe, ce qui pièges un utilisateur
    souris classique face à une zone qui semble scrollable (curseur,
    contenu tronqué) mais ne répond pas à sa molette. Cette sous-classe
    redirige explicitement tout wheelEvent vertical vers le scrollbar
    horizontal.
    """

    def wheelEvent(self, event):
        delta = event.angleDelta().y() or event.angleDelta().x()
        if delta:
            hbar = self.horizontalScrollBar()
            hbar.setValue(hbar.value() - delta)
            event.accept()
            return
        super().wheelEvent(event)


class GaleriePopupCapturesReseau(QWidget):
    """Petite fenêtre popup (PATCH -- demande explicite utilisateur :
    "si on fait un clic droit sur le bouton en question sa affiche tout
    ce qui a deja ete capturer") listant, en grille de miniatures, toutes
    les zones déjà découpées via FenetreRenduTaskReseau._demarrer_
    selection_zone et encore en attente d'import (self._captures_
    selectionnees côté FenetreRenduTaskReseau -- cette popup ne fait
    qu'AFFICHER une liste qui lui est donnée, elle ne la possède pas).

    Même esprit visuel que ZoneClicSelector (fenêtre top-level centrée,
    fond Mocha.crust) et ComposantTuile (vignette image + nom + action de
    suppression) déjà présents dans ce fichier, plutôt qu'un nouveau
    patron : simple liste, pas d'édition/zoom ici (juste consultation et
    suppression individuelle, cf. demande_suppression_index).

    Purement une vue : ne modifie jamais `images` elle-même (une COPIE
    de la liste est prise en __init__, cf. self._images) -- la
    suppression réelle est déléguée à FenetreRenduTaskReseau via le
    signal, qui reconstruira/rouvrira cette popup si besoin (cf.
    FenetreRenduTaskReseau._supprimer_capture_selectionnee)."""

    demande_suppression_index = Signal(int)  # index dans la liste d'origine

    _MINIATURE_LARGEUR = 160
    _MINIATURE_HAUTEUR = 110

    def __init__(self, images: list, parent=None):
        super().__init__(parent)
        self.setWindowFlags(Qt.Dialog | Qt.FramelessWindowHint | Qt.WindowStaysOnTopHint)
        self.setWindowTitle("Sélections en attente")
        self._images = list(images)  # copie défensive, cf. docstring de classe

        layout_racine = QVBoxLayout(self)
        layout_racine.setContentsMargins(16, 16, 16, 16)
        layout_racine.setSpacing(12)

        entete = QWidget(self)
        entete_layout = QHBoxLayout(entete)
        entete_layout.setContentsMargins(0, 0, 0, 0)
        titre = QLabel(
            f"{len(self._images)} sélection(s) en attente" if self._images else "Aucune sélection en attente",
            self,
        )
        titre.setObjectName("ReglagesLabel")
        entete_layout.addWidget(titre, stretch=1)
        bouton_fermer = QToolButton(self)
        bouton_fermer.setObjectName("APIFeaturesMenuButton")
        bouton_fermer.setIcon(qta.icon("mdi6.close", color=Mocha.subtext0))
        bouton_fermer.setIconSize(QSize(16, 16))
        bouton_fermer.setCursor(Qt.PointingHandCursor)
        bouton_fermer.setToolTip("Fermer")
        bouton_fermer.clicked.connect(self.close)
        entete_layout.addWidget(bouton_fermer)
        layout_racine.addWidget(entete)

        if not self._images:
            vide_label = QLabel(
                "Cliquez sur l'icône ciseau du panneau de rendu pour découper une zone.", self
            )
            vide_label.setObjectName("ReglagesLabel")
            vide_label.setWordWrap(True)
            layout_racine.addWidget(vide_label)
            self.resize(320, 120)
        else:
            grille_container = QWidget(self)
            grille = FlowGrid(item_width=self._MINIATURE_LARGEUR, spacing=12, parent=grille_container)
            grille_layout = QVBoxLayout(grille_container)
            grille_layout.setContentsMargins(0, 0, 0, 0)
            grille_layout.addWidget(grille)
            for index, image in enumerate(self._images):
                grille.add_item(self._creer_vignette(index, image))
            scroll = QScrollArea(self)
            scroll.setWidgetResizable(True)
            scroll.setWidget(grille_container)
            scroll.setFrameShape(QFrame.NoFrame)
            layout_racine.addWidget(scroll, 1)
            colonnes = max(1, min(4, len(self._images)))
            largeur_estimee = colonnes * (self._MINIATURE_LARGEUR + 12) + 40
            self.resize(min(largeur_estimee, 820), 420)

        self._centrer_sur_ecran()

    def _creer_vignette(self, index: int, image: QImage) -> QFrame:
        cadre = QFrame(self)
        cadre.setObjectName("ComposantTuile")
        cadre.setFixedWidth(self._MINIATURE_LARGEUR)
        layout = QVBoxLayout(cadre)
        layout.setContentsMargins(8, 8, 8, 8)
        layout.setSpacing(6)

        image_label = QLabel(cadre)
        image_label.setAlignment(Qt.AlignCenter)
        if not image.isNull():
            pixmap = QPixmap.fromImage(image).scaled(
                self._MINIATURE_LARGEUR - 16, self._MINIATURE_HAUTEUR,
                Qt.KeepAspectRatio, Qt.SmoothTransformation,
            )
            image_label.setPixmap(pixmap)
        layout.addWidget(image_label, alignment=Qt.AlignCenter)

        bas_layout = QHBoxLayout()
        bas_layout.setContentsMargins(0, 0, 0, 0)
        numero_label = QLabel(f"Sélection {index + 1}", cadre)
        numero_label.setObjectName("ComposantTuileNom")
        bas_layout.addWidget(numero_label, stretch=1)
        bouton_supprimer = QToolButton(cadre)
        bouton_supprimer.setObjectName("APIFeaturesMenuButton")
        bouton_supprimer.setIcon(qta.icon("mdi6.close", color=Mocha.subtext0))
        bouton_supprimer.setIconSize(QSize(13, 13))
        bouton_supprimer.setCursor(Qt.PointingHandCursor)
        bouton_supprimer.setToolTip("Retirer cette sélection")
        bouton_supprimer.clicked.connect(lambda: self._sur_clic_supprimer(index))
        bas_layout.addWidget(bouton_supprimer)
        layout.addLayout(bas_layout)
        return cadre

    def _sur_clic_supprimer(self, index: int):
        """Émet la demande vers FenetreRenduTaskReseau (seule détentrice
        réelle de la liste, cf. docstring de classe) puis referme cette
        popup -- FenetreRenduTaskReseau la rouvrira à jour si l'utilisateur
        reclique sur le clic droit, plus simple/fiable qu'un retrait en
        place de cette grille déjà construite."""
        self.demande_suppression_index.emit(index)
        self.close()

    def _centrer_sur_ecran(self):
        ecran = QGuiApplication.primaryScreen()
        geometry = ecran.availableGeometry() if ecran else QRect(0, 0, 1280, 800)
        x = geometry.x() + (geometry.width() - self.width()) // 2
        y = geometry.y() + (geometry.height() - self.height()) // 2
        self.move(x, y)

    def keyPressEvent(self, event):
        if event.key() == Qt.Key_Escape:
            self.close()
            return
        super().keyPressEvent(event)


class DialogueChoixCaptureOuNouvelle(QWidget):
    """Popup (AJOUT -- demande explicite utilisateur : "au moment ou on
    clic sur mettre a jour alors une boite de dialogue apparait et
    affiche la liste des capture (sil yen a) et un autre bouton nouveau,
    quand on clic sur nouveau sa fait le comportement normal, donc
    capture libre, ou sa on clic juste sur limage que lon veut", même
    logique reprise pour « + Variante ») ouverte par ComposantsScreen._
    start_update_composant_image et ._start_ajouter_variante AVANT de
    lancer quoi que ce soit : affiche en grille les captures déjà
    découpées et en attente dans FenetreRenduTaskReseau (cf. self.
    _consulter_captures_selectionnees_reseau, qui ne consomme PAS la
    liste -- contrairement à GaleriePopupCapturesReseau, une vignette
    cliquée ici sélectionne immédiatement CETTE image comme résultat),
    plus un bouton « Nouveau » toujours présent qui déclenche le chemin
    de capture libre existant (capture_bureau_complet + SelectionZoneOverlay).

    Même esprit visuel que GaleriePopupCapturesReseau (fenêtre top-level
    centrée, grille de vignettes) mais SANS bouton de suppression sur les
    vignettes ici : cliquer une vignette VAUT choix immédiat (ferme la
    popup et émet capture_choisie), il n'y a pas de mode "gérer la
    liste" séparé -- pour ça, la galerie existante (clic droit sur le
    ciseau) reste l'outil dédié, inchangée.

    Émet SOIT capture_choisie(image, index_origine) SOIT nouvelle_demandee
    -- jamais les deux, jamais aucun si l'utilisateur ferme/Échap sans
    choisir (annulation silencieuse, même geste que fermer n'importe
    quelle popup de ce fichier)."""

    capture_choisie = Signal(QImage, int)  # image choisie, son index dans la liste d'origine
    nouvelle_demandee = Signal()  # bouton "Nouveau" cliqué

    _MINIATURE_LARGEUR = 160
    _MINIATURE_HAUTEUR = 110

    def __init__(self, images: list, titre: str, parent=None):
        super().__init__(parent)
        self.setWindowFlags(Qt.Dialog | Qt.FramelessWindowHint | Qt.WindowStaysOnTopHint)
        self.setWindowTitle(titre)
        self._images = list(images)  # copie défensive -- purement une vue, cf. docstring de classe

        layout_racine = QVBoxLayout(self)
        layout_racine.setContentsMargins(16, 16, 16, 16)
        layout_racine.setSpacing(12)

        entete = QWidget(self)
        entete_layout = QHBoxLayout(entete)
        entete_layout.setContentsMargins(0, 0, 0, 0)
        titre_label = QLabel(titre, self)
        titre_label.setObjectName("ReglagesLabel")
        entete_layout.addWidget(titre_label, stretch=1)
        bouton_fermer = QToolButton(self)
        bouton_fermer.setObjectName("APIFeaturesMenuButton")
        bouton_fermer.setIcon(qta.icon("mdi6.close", color=Mocha.subtext0))
        bouton_fermer.setIconSize(QSize(16, 16))
        bouton_fermer.setCursor(Qt.PointingHandCursor)
        bouton_fermer.setToolTip("Annuler")
        bouton_fermer.clicked.connect(self.close)
        entete_layout.addWidget(bouton_fermer)
        layout_racine.addWidget(entete)

        # Bouton "Nouveau" -- TOUJOURS présent, qu'il y ait ou non des
        # captures en attente (comportement de repli identique à avant
        # ce patch, jamais retiré ni caché).
        bouton_nouveau = _creer_bouton_dialogue("📷  Nouveau (capture libre)", primaire=True, parent=self)
        bouton_nouveau.clicked.connect(self._sur_clic_nouveau)
        layout_racine.addWidget(bouton_nouveau)

        if self._images:
            info_label = QLabel(
                f"Ou choisissez une des {len(self._images)} capture(s) déjà en attente :", self,
            )
            info_label.setObjectName("ReglagesLabel")
            layout_racine.addWidget(info_label)

            grille_container = QWidget(self)
            grille = FlowGrid(item_width=self._MINIATURE_LARGEUR, spacing=12, parent=grille_container)
            grille_layout = QVBoxLayout(grille_container)
            grille_layout.setContentsMargins(0, 0, 0, 0)
            grille_layout.addWidget(grille)
            for index, image in enumerate(self._images):
                grille.add_item(self._creer_vignette(index, image))
            scroll = QScrollArea(self)
            scroll.setWidgetResizable(True)
            scroll.setWidget(grille_container)
            scroll.setFrameShape(QFrame.NoFrame)
            layout_racine.addWidget(scroll, 1)
            colonnes = max(1, min(4, len(self._images)))
            largeur_estimee = colonnes * (self._MINIATURE_LARGEUR + 12) + 40
            self.resize(min(largeur_estimee, 820), 460)
        else:
            self.resize(360, 140)

        self._centrer_sur_ecran()

    def _creer_vignette(self, index: int, image: QImage) -> QFrame:
        cadre = QFrame(self)
        cadre.setObjectName("ComposantTuile")
        cadre.setFixedWidth(self._MINIATURE_LARGEUR)
        cadre.setCursor(Qt.PointingHandCursor)
        layout = QVBoxLayout(cadre)
        layout.setContentsMargins(8, 8, 8, 8)
        layout.setSpacing(6)

        image_label = QLabel(cadre)
        image_label.setAlignment(Qt.AlignCenter)
        if not image.isNull():
            pixmap = QPixmap.fromImage(image).scaled(
                self._MINIATURE_LARGEUR - 16, self._MINIATURE_HAUTEUR,
                Qt.KeepAspectRatio, Qt.SmoothTransformation,
            )
            image_label.setPixmap(pixmap)
        layout.addWidget(image_label, alignment=Qt.AlignCenter)

        numero_label = QLabel(f"Sélection {index + 1}", cadre)
        numero_label.setObjectName("ComposantTuileNom")
        numero_label.setAlignment(Qt.AlignCenter)
        layout.addWidget(numero_label)

        # Toute la vignette est cliquable (clic sur l'image OU le
        # libellé) -- un clic VAUT choix immédiat, cf. docstring de
        # classe : pas de bouton "valider" séparé.
        cadre.mousePressEvent = lambda event, i=index: self._sur_clic_vignette(i)
        image_label.mousePressEvent = lambda event, i=index: self._sur_clic_vignette(i)
        numero_label.mousePressEvent = lambda event, i=index: self._sur_clic_vignette(i)
        return cadre

    def _sur_clic_vignette(self, index: int):
        if 0 <= index < len(self._images):
            self.capture_choisie.emit(self._images[index], index)
        self.close()

    def _sur_clic_nouveau(self):
        self.nouvelle_demandee.emit()
        self.close()

    def _centrer_sur_ecran(self):
        ecran = QGuiApplication.primaryScreen()
        geometry = ecran.availableGeometry() if ecran else QRect(0, 0, 1280, 800)
        x = geometry.x() + (geometry.width() - self.width()) // 2
        y = geometry.y() + (geometry.height() - self.height()) // 2
        self.move(x, y)

    def keyPressEvent(self, event):
        if event.key() == Qt.Key_Escape:
            self.close()
            return
        super().keyPressEvent(event)


class BarreOngletsReseau(QWidget):
    """PATCH (demande explicite utilisateur : \"une barre minimaliste
    d'onglets sur une ligne, avec des boutons en horizontal représentant
    les onglets en cours, plus dans la page latérale droite\") -- bande
    fine, tout en haut de FenetreRenduTaskReseau, un bouton par onglet
    ouvert sur l'instance distante (l'onglet actif est coché).

    MIROIR de `combo` (panneau.onglet_combo), PAS une seconde source de
    vérité : les trois écrans hôtes (TaskConfigScreen,
    ProjetsDistribuesScreen, l'écran de clones) continuent de remplir ce
    combo (listTabs) et d'écouter son currentIndexChanged (switchTab)
    SANS aucune modification. Ce widget (1) se reconstruit quand le
    contenu du combo change, (2) répercute un clic sur un bouton en
    `combo.setCurrentIndex(i)`, ce qui déclenche le switchTab existant.
    Le combo lui-même reste dans panneau.bande_onglet, désormais masquée.
    """

    TAILLE_MAX_BOUTON = 110
    TAILLE_MIN_BOUTON = 44
    LONGUEUR_MAX_TITRE = 13

    def __init__(self, combo, bouton_rafraichir, parent=None):
        super().__init__(parent)
        self.setObjectName("BarreOngletsReseau")
        self.setAttribute(Qt.WA_StyledBackground, True)
        self.setFixedHeight(28)
        self._combo = combo
        self._bouton_rafraichir_source = bouton_rafraichir
        self._signature = None
        self._reconstruction_planifiee = False
        self._survol = False
        self._nb_reels = 0

        self.setStyleSheet(
            f"""
            #BarreOngletsReseau {{
                background: {Mocha.mantle};
                border-bottom: 1px solid {Mocha.surface0};
            }}
            #BarreOngletsReseau QPushButton {{
                background: transparent; color: {Mocha.subtext0};
                border: none; border-radius: 6px;
                padding: 2px 10px; font-size: 11px;
            }}
            #BarreOngletsReseau QPushButton:hover {{
                background: {Mocha.surface0}; color: {Mocha.text};
            }}
            #BarreOngletsReseau QPushButton:checked {{
                background: {Mocha.surface1}; color: {Mocha.text};
            }}
            #BarreOngletsReseau QToolButton {{
                background: transparent; border: none; border-radius: 6px; padding: 2px;
            }}
            #BarreOngletsReseau QToolButton:hover {{ background: {Mocha.surface0}; }}
            """
        )

        layout = QHBoxLayout(self)
        layout.setContentsMargins(6, 2, 6, 2)
        layout.setSpacing(4)

        self._zone_boutons = QWidget(self)
        self._layout_boutons = QHBoxLayout(self._zone_boutons)
        self._layout_boutons.setContentsMargins(0, 0, 0, 0)
        self._layout_boutons.setSpacing(4)
        layout.addWidget(self._zone_boutons, 1)

        self._bouton_rafraichir = QToolButton(self)
        self._bouton_rafraichir.setIcon(qta.icon("mdi6.refresh", color=Mocha.subtext0))
        self._bouton_rafraichir.setIconSize(QSize(14, 14))
        self._bouton_rafraichir.setCursor(Qt.PointingHandCursor)
        self._bouton_rafraichir.setFocusPolicy(Qt.NoFocus)
        self._bouton_rafraichir.setToolTip("Actualiser la liste des onglets")
        self._bouton_rafraichir.clicked.connect(self._sur_clic_rafraichir)
        layout.addWidget(self._bouton_rafraichir)

        # Écoute du combo-source. blockSignals(True) côté appelants ne
        # coupe QUE les signaux du combo, pas ceux de son modèle : on
        # écoute donc le modèle pour le contenu et le combo pour la
        # sélection. Reconstruction différée (singleShot 0) : elle
        # s'exécute après la fin du handler appelant, quand le combo est
        # dans son état final (clear -> addItem... -> setCurrentIndex).
        modele = combo.model()
        modele.rowsInserted.connect(self._planifier_reconstruction)
        modele.rowsRemoved.connect(self._planifier_reconstruction)
        modele.modelReset.connect(self._planifier_reconstruction)
        modele.dataChanged.connect(self._planifier_reconstruction)
        combo.currentIndexChanged.connect(self._planifier_reconstruction)

        self.setVisible(False)  # n'apparaît qu'au survol de la zone sensible

    def definir_survol(self, survol: bool) -> bool:
        """Affiche/masque la barre. Renvoie True si elle vient d'APPARAÎTRE
        (le parent en profite pour demander UNE actualisation)."""
        if survol == self._survol:
            return False
        self._survol = survol
        self.setVisible(survol)
        return survol

    def _sur_clic_rafraichir(self):
        if self._bouton_rafraichir_source.isEnabled():
            self._bouton_rafraichir_source.click()

    def _planifier_reconstruction(self, *_args):
        if self._reconstruction_planifiee:
            return
        self._reconstruction_planifiee = True
        QTimer.singleShot(0, self._reconstruire)

    def _sur_clic_onglet(self, index: int):
        # setCurrentIndex émet currentIndexChanged (signaux du combo NON
        # bloqués ici) -> le handler existant des écrans hôtes envoie
        # switchTab. Si l'index est déjà le courant, Qt n'émet rien.
        if 0 <= index < self._combo.count():
            self._combo.setCurrentIndex(index)

    def _reconstruire(self):
        self._reconstruction_planifiee = False
        combo = self._combo
        elements = [(combo.itemText(i), combo.itemData(i)) for i in range(combo.count())]
        actif = combo.currentIndex()
        signature = (tuple(elements), actif)
        if signature == self._signature:
            return  # rien de changé : évite le clignotement à chaque actualisation auto
        self._signature = signature

        while self._layout_boutons.count():
            item = self._layout_boutons.takeAt(0)
            widget = item.widget()
            if widget is not None:
                widget.setParent(None)
                widget.deleteLater()

        nb_reels = 0
        for index, (titre, tab_id) in enumerate(elements):
            if tab_id is None:  # entrée factice \"Aucun onglet ouvert\"
                continue
            nb_reels += 1
            court = titre if len(titre) <= self.LONGUEUR_MAX_TITRE else titre[: self.LONGUEUR_MAX_TITRE - 1] + "…"
            bouton = QPushButton(court, self._zone_boutons)
            bouton.setCheckable(True)
            bouton.setChecked(index == actif)
            bouton.setToolTip(titre)
            bouton.setCursor(Qt.PointingHandCursor)
            # NoFocus : sinon Espace (raccourci Auto/Manuel de la fenêtre)
            # activerait le dernier bouton cliqué.
            bouton.setFocusPolicy(Qt.NoFocus)
            bouton.setMinimumWidth(self.TAILLE_MIN_BOUTON)
            bouton.setMaximumWidth(self.TAILLE_MAX_BOUTON)
            bouton.clicked.connect(lambda _checked=False, i=index: self._sur_clic_onglet(i))
            self._layout_boutons.addWidget(bouton)
        self._nb_reels = nb_reels
        if nb_reels == 0:
            vide = QLabel("Aucun onglet", self._zone_boutons)
            vide.setStyleSheet(f"color: {Mocha.overlay1}; font-size: 11px; padding-left: 6px;")
            self._layout_boutons.addWidget(vide)
        self._layout_boutons.addStretch(1)


class FenetreRenduTaskReseau(QWidget):
    """Widget affichant le rendu de l'instance Camoufox en cours
    d'exécution sur le sAutoniax sélectionné dans TaskConfigScreen (mode
    réseau) -- ouvert via le bouton "Voir le rendu" de la toolbar (cf.
    TaskConfigScreen._sur_clic_voir_rendu_reseau).

    PATCH B.5 (cf. cahier des charges patchs.md) -- ouverture par défaut
    DANS la zone d'application (ApplicationsScreen.tabs, cf.
    ApplicationsScreen.ouvrir_rendu_task_reseau), PAS en fenêtre séparée
    qui vole le focus, contrairement à la version précédente (Qt.Window
    systématique). Reste DÉTACHABLE à la demande (bouton "Détacher" dans
    sa barre -- cf. detacher_demande/_sur_clic_detacher) : dans ce cas
    seulement, ce widget devient une vraie fenêtre top-level (Qt.Window
    posé dynamiquement via setWindowFlag, PAS au constructeur -- un
    widget ajouté à un QTabWidget ne doit JAMAIS avoir Qt.Window, sous
    peine de s'afficher comme fenêtre séparée AU LIEU d'un onglet). Un
    bouton symétrique ("Réattacher") permet de revenir dans la zone
    d'application. self.detache (bool) reflète l'état courant -- c'est
    TaskConfigScreen/MainWindow qui orchestrent le VRAI déplacement du
    widget entre le QTabWidget d'ApplicationsScreen et un top-level
    (cf. _sur_clic_detacher/_sur_clic_reattacher), ce widget ne fait que
    demander via un signal, jamais l'opération lui-même (il ne connaît
    pas ApplicationsScreen).

    RÉUTILISE RÉELLEMENT PanneauRenduInstance (pas une réimplémentation
    pauvre à côté -- cf. audit de session précédente sur
    FenetreRenduNotebookDistant, qui promettait dans son propre
    commentaire "tout les éléments widget que screenAppView de base
    possède" mais livrait un simple QLabel dans un QScrollArea, sans
    bouton Rafraîchir ni mode auto/FPS ni statut. Cette fois le vrai
    panneau est composé tel quel, comme DashboardScreen le fait déjà
    pour son propre usage -- cf. docstring de PanneauRenduInstance,
    "seul le RENDU est partagé, en composition").

    Contrairement à l'usage NORMAL de PanneauRenduInstance (qui pilote
    une instance nodriver LOCALE via le protocole réseau existant --
    set_streaming/set_fps), ses contrôles Rafraîchir/Mode auto/Taux sont
    ici RECÂBLÉS pour piloter le sAutoniax DISTANT (décision explicite
    utilisateur -- "dont sa veut dire que tu vas gerer le resau ? / Oui")
    via demande_rafraichissement/taux_capture_change, PAS connectés en
    interne au protocole nodriver habituel (ce widget n'a aucune
    connexion réseau propre, cf. docstring de PanneauRenduInstance sur
    InstanceApercuScreen qui câble ces mêmes signaux différemment --
    ici c'est TaskConfigScreen qui les relaie, même séparation de
    responsabilités que le reste du fichier réseau).

    L'"Onglet navigateur" de PanneauRenduInstance (listTabs/switchTab)
    n'a pas de sens pour une page Camoufox headless pilotée à distance
    -- masqué, pas retiré (widget public de PanneauRenduInstance, pas
    de variante sans -- plus simple de masquer que de dupliquer la
    classe pour ce seul cas).

    PATCH (mode sélection multiple + Espace = manuel direct, demande
    explicite utilisateur) -- deux ajouts indépendants de ce qui précède :
    1. Bouton ciseau (self.bouton_selection_zone, coin nord-ouest, juste
       après bouton_precedent/bouton_suivant) : ouvre SelectionZoneOverlay
       sur la dernière image reçue pour en découper une zone (Espace
       valide et ferme, Échap annule et ferme). Chaque zone validée
       s'AJOUTE à self._captures_selectionnees (jamais un remplacement),
       qui persiste tant que le bouton poubelle (self.bouton_vider_
       selection, juste à côté) ou un import effectif (cf. ComposantsScreen.
       _start_capture_composant_depuis_rendu_reseau) ne la vide pas. Clic
       droit sur le ciseau : ouvre une galerie (GaleriePopupCapturesReseau)
       listant tout ce qui est déjà en attente, avec suppression
       individuelle.
    2. Espace (keyPressEvent, HORS mode sélection ci-dessus et hors
       contrôle à distance actif) : BASCULE (toggle) case_auto dans les
       deux sens -- Auto -> Manuel si actuellement auto, Manuel -> Auto
       si actuellement manuel -- sans passer par le panneau de réglages.
       Complété suite à demande explicite ("la touche espace doit aussi
       basculer vers le rafraichesiement automqitque si cetait deja en
       maneusl") : la version initiale ne forçait que vers Manuel. Cf.
       keyPressEvent pour le détail des cas où ce raccourci ne
       s'applique pas.
    3. Badge texte permanent (self.badge_mode_rafraichissement, demande
       explicite utilisateur : "je veux que tu met a un indicatuer
       visuels toujour en idicie qui vas directement dit si le
       rafraicheasment automaiqure est actier ou pas") -- affiche "AUTO"
       ou "MANUEL" selon l'état courant de case_auto, empilé en COLONNE
       sous la rangée d'icônes existante (précédent/suivant/ciseau/
       poubelle), donc toujours dans le coin nord-ouest de l'image mais
       jamais sur la même ligne qu'elles (demande explicite : "je veux
       que tu met maintenant sur la collen, pas sur la ligne denhaut").
       Toujours visible dès qu'une image est affichée, contrairement à
       label_statut_rafraichissement (même information mais seulement
       visible en ouvrant le panneau de réglages flottant, survol du
       bord droit) -- les deux restent synchronisés en parallèle, aucun
       ne remplace l'autre. Mis à jour via _rafraichir_badge_mode_
       rafraichissement, appelée depuis _rafraichir_statut_local (point
       d'entrée commun à TOUTE source de changement de mode : Espace,
       clic direct sur case_auto, ouverture automatique via
       afficher_par_dessus_tout/_auto_a_ouverture) -- jamais appelée
       séparément pour rester garantie synchrone avec case_auto."""

    fermeture_demandee = Signal()
    demande_rafraichissement = Signal()
    taux_capture_change = Signal(float)
    # PATCH B.4 (contrôle à distance réel) -- émis pour CHAQUE événement de
    # pilotage capté sur l'image (clic/double-clic/scroll/texte -- PLUS de
    # mousemove relayé en direct, cf. retrait explicite : le clic génère
    # déjà sa propre trajectoire via action_camoufox_click, relayer aussi
    # le déplacement de la souris du pilote était redondant), écouté par
    # TaskConfigScreen (cf. _sur_clic_voir_rendu_reseau) pour relayer vers
    # ClientServeurT.envoyer_commande_instance -> serveur.py (handler
    # "commande_instance") -> sAutoniax ciblé. Signal(dict) : le
    # dict transporte directement le sous-objet "commande" attendu par
    # _executer_commande_camoufox (action + paramètres propres), PLUS
    # "requete_id" -- ce widget ne connaît ni id_executant ni la connexion
    # réseau elle-même (même séparation de responsabilités que
    # demande_rafraichissement/taux_capture_change ci-dessus).
    commande_controle_distance = Signal(dict)
    # PATCH B.5 -- demande de bascule embarqué <-> flottant. bool : True
    # = "détache-moi" (bouton Détacher cliqué), False = "réattache-moi"
    # (bouton Réattacher cliqué, uniquement visible une fois détaché).
    # Ce widget ne fait QUE demander -- c'est TaskConfigScreen qui décide
    # comment (cf. docstring de classe) : retrait/ajout réel du
    # QTabWidget d'ApplicationsScreen, pose/retrait de Qt.Window, etc.
    detacher_demande = Signal(bool)

    def __init__(self, parent=None):
        super().__init__(parent)
        self.setObjectName("FenetreRenduTaskReseau")
        self.setWindowTitle("Rendu -- Task (réseau)")
        self.setMinimumSize(420, 320)
        self.resize(720, 540)
        # État de rattachement -- cf. docstring de classe et
        # detacher_demande. Faux par défaut : ce widget est construit
        # pour vivre EMBARQUÉ dans ApplicationsScreen.tabs (B.5), jamais
        # comme fenêtre flottante d'emblée -- contrairement à l'ancien
        # comportement (Qt.Window systématique au constructeur).
        self.detache = False
        # PATCH (demande explicite utilisateur : "lorsque je clic sur le
        # bouton qui permet le rendu panneau alors ça active directement
        # le mode rafraîchissement automatique, dès que je sors donc
        # appui sur esc ça désactive automatiquement, ça passe en mode
        # manuel") -- comportement ACTIF PAR DÉFAUT (True) : cf.
        # afficher_par_dessus_tout (coche case_auto à l'ouverture) et
        # keyPressEvent (Échap, décoche case_auto avant de masquer).
        # Un toggle dédié dans l'entête du panneau flottant (cf.
        # case_auto_a_ouverture ci-dessous) permet de désactiver CE
        # comportement précis -- sans jamais toucher à case_auto
        # elle-même, qui reste pilotable manuellement dans tous les cas.
        self._auto_a_ouverture = True

        layout_racine = QVBoxLayout(self)
        layout_racine.setContentsMargins(0, 0, 0, 0)
        layout_racine.setSpacing(0)

        # --- SUPPRESSION de la barre du haut (demande explicite
        # utilisateur : "je veux que tu enleve le lables qui est en haut
        # de limage , je ne veux rien daure que limage , cest dans le
        # [pan]neau flottant que tu doit donner le nons du sautoniax et
        # du profils") -- l'ancienne "barre" (QWidget au-dessus de
        # self.panneau, avec titre_label + boutons Détacher/Fermer)
        # n'existe plus DU TOUT : rien ne doit plus se trouver au-dessus
        # de l'image.
        #
        # self.titre_label et self.bouton_fermer sont créés ICI, SANS
        # être ajoutés à un layout tout de suite (BUG ÉVITÉ : les deux
        # appelants -- TaskConfigScreen/ProjetsDistribuesScreen -- font
        # self._fenetre_rendu_reseau.titre_label.setText(...) AVANT
        # d'appeler afficher_par_dessus_tout(), donc AVANT que
        # _preparer_mode_overlay ait pu construire quoi que ce soit ; si
        # ces deux attributs n'existaient qu'à partir de là, le tout
        # premier clic sur "Voir le rendu" plantait (AttributeError)).
        # _preparer_mode_overlay les insère ensuite dans colonne_reglages
        # (le panneau flottant), cf. _construire_entete_panneau_flottant
        # -- contrat d'attribut inchangé pour les deux appelants, seul
        # l'EMPLACEMENT visuel change.
        self.titre_label = QLabel("Aucun sAutoniax sélectionné", self)
        self.titre_label.setObjectName("ReglagesLabel")
        self.titre_label.setWordWrap(True)

        self.bouton_fermer = QToolButton(self)
        self.bouton_fermer.setObjectName("APIFeaturesMenuButton")
        self.bouton_fermer.setIcon(qta.icon("mdi6.close", color=Mocha.subtext0))
        self.bouton_fermer.setIconSize(QSize(16, 16))
        self.bouton_fermer.setCursor(Qt.PointingHandCursor)
        self.bouton_fermer.setToolTip("Fermer")
        self.bouton_fermer.clicked.connect(self.close)

        # PATCH (toggle "auto à l'ouverture / manuel à Échap", cf.
        # docstring de self._auto_a_ouverture) -- même composant visuel
        # que case_auto (ToggleSwitch), créé ICI (comme titre_label/
        # bouton_fermer juste au-dessus) SANS être ajouté à un layout
        # tout de suite : _construire_entete_panneau_flottant l'insère
        # ensuite dans l'entête du panneau flottant, même patron exact
        # que les deux widgets précédents (cf. leur commentaire sur le
        # bug évité en créant hors-layout dès __init__).
        self.case_auto_a_ouverture = QCheckBox(self)
        self.case_auto_a_ouverture.setObjectName("ToggleSwitch")
        self.case_auto_a_ouverture.setCursor(Qt.PointingHandCursor)
        self.case_auto_a_ouverture.setChecked(True)  # comportement actif PAR DÉFAUT, cf. self._auto_a_ouverture
        self.case_auto_a_ouverture.setToolTip(
            "Coché (par défaut) : l'ouverture de ce panneau active automatiquement\n"
            "le rafraîchissement automatique, et Échap le repasse en manuel.\n"
            "Décoché : le mode Auto/Manuel n'est plus jamais touché automatiquement,\n"
            "seule la case \"Mode\" ci-dessous le pilote."
        )
        self.case_auto_a_ouverture.toggled.connect(self._sur_bascule_auto_a_ouverture)

        # PATCH (demande explicite utilisateur : "paneau de rendu
        # dintace en mdoe reaau, sa affiche limage avec les dimesion
        # rell du navigatuer, le problme es t que sa varie en fontion
        # du fongerprinting" -- clarifié : "Taille réelle par défaut,
        # mais avec un bouton pour basculer en 'ajuster à la fenêtre'").
        # DÉPLACÉ (retour utilisateur ultérieur : "je veux que tu
        # laffiche a la taille diponible avec les slide, je ne veux pas
        # que le contenue soit comprimer" -- le widget créé ici SANS
        # layout n'était visible qu'en mode overlay flottant, cf.
        # _construire_entete_panneau_flottant, jamais en usage EMBARQUÉ
        # normal de ce widget dans une zone fixe d'un layout) -- le vrai
        # QCheckBox vit maintenant dans PanneauRenduInstance lui-même
        # (self.panneau.case_ajuster_a_la_fenetre, cf. bande_ajuster_a_la_
        # fenetre/definir_ajuster_a_la_fenetre_visible), visible dans les
        # DEUX modes (embarqué ET overlay -- réparenté par _construire_
        # entete_panneau_flottant comme case_controle_distance/tous les
        # autres widgets de l'en-tête flottant, même patron). Alias
        # conservé ici (self.case_ajuster_a_la_fenetre) pour que tout le
        # reste de cette classe (_sur_bascule_ajuster_a_la_fenetre,
        # _appliquer_pixmap_a_l_echelle, _construire_entete_panneau_
        # flottant) continue de fonctionner SANS aucun changement --
        # seul le point de CRÉATION du QCheckBox change, jamais son
        # usage ailleurs dans cette classe. Câblage réel effectué PLUS
        # BAS (juste après la construction de self.panneau, cf. section
        # "Panneau de rendu RÉEL" -- self.panneau n'existe pas encore à
        # ce stade du constructeur).
        self._ajuster_a_la_fenetre = False

        # self.bouton_detacher (PATCH B.5, mode "détaché" retiré) n'a
        # plus de barre où vivre -- l'attribut est conservé (référencé
        # par definir_bouton_detacher_visible/_rafraichir_bouton_
        # detacher, jamais appelés en pratique désormais) mais n'est
        # PAS ajouté à un layout, donc jamais visible.
        self.bouton_detacher = QToolButton(self)
        self.bouton_detacher.setObjectName("APIFeaturesMenuButton")
        self.bouton_detacher.setCursor(Qt.PointingHandCursor)
        self.bouton_detacher.clicked.connect(self._sur_clic_bouton_detacher)
        self.bouton_detacher.setVisible(False)
        self._rafraichir_bouton_detacher()

        # --- Panneau de rendu RÉEL, réutilisé tel quel. ---
        # CORRECTIF (spec D.1) -- mode_bitmap_direct_capture=True
        # uniquement ici : le bouton "copier" de CE panneau doit copier un
        # bitmap directement dans le presse-papier (setPixmap), pas une
        # liste de fichiers CF_HDROP, cf. docstring de ApercuDragHandle.
        # Aucun autre écran hôte de PanneauRenduInstance n'est concerné.
        self.panneau = PanneauRenduInstance(
            "Rendu de l'instance distante (sAutoniax)", self,
            mode_bitmap_direct_capture=True,
        )
        layout_racine.addWidget(self.panneau, stretch=1)

        # --- PATCH barre d'onglets horizontale (cf. BarreOngletsReseau) :
        # tout en haut, au-dessus de l'image, fine et sur une ligne.
        self.barre_onglets = BarreOngletsReseau(
            self.panneau.onglet_combo, self.panneau.rafraichir_onglets_button, self,
        )
        # Surcouche (hors layout, ne prend AUCUNE place) : n'apparaît que
        # quand le curseur touche le bord haut, au centre -- cf.
        # _verifier_survol_barre_onglets. Actualisation à l'apparition
        # seulement, plus de minuteur périodique.
        self.barre_onglets.hide()

        # --- Toggle "Ajuster à la fenêtre" -- câblage RÉEL (cf. bloc
        # self._ajuster_a_la_fenetre plus haut, avant self.panneau) : le
        # vrai QCheckBox vit dans PanneauRenduInstance lui-même (cf.
        # bande_ajuster_a_la_fenetre/definir_ajuster_a_la_fenetre_visible
        # côté PanneauRenduInstance) -- rendu visible ICI (jamais pour un
        # rendu LOCAL, InstanceApercuScreen/DashboardScreen, qui n'appelle
        # jamais cette méthode), et alias conservé sur self pour que le
        # reste de cette classe continue de fonctionner sans changement.
        self.panneau.definir_ajuster_a_la_fenetre_visible(True)
        self.case_ajuster_a_la_fenetre = self.panneau.case_ajuster_a_la_fenetre
        self.case_ajuster_a_la_fenetre.toggled.connect(self._sur_bascule_ajuster_a_la_fenetre)

        # --- Label indicatif de PanneauRenduInstance (self.panneau.
        # titre_label, "Rendu de l'instance distante (sAutoniax)") --
        # masqué ICI aussi : même demande ("rien d'autre que l'image"),
        # ce label vit dans _layout_racine de PanneauRenduInstance,
        # AU-DESSUS de _corps_layout (donc au-dessus de l'image), pas
        # seulement dans l'ex-"barre" retirée ci-dessus. Masqué plutôt
        # que retiré du layout : PanneauRenduInstance est une classe
        # PARTAGÉE (InstanceApercuScreen/DashboardScreen l'utilisent
        # aussi, avec leur propre besoin d'un titre visible) -- setVisible
        # (False) n'affecte que CETTE instance du panneau, propre à
        # FenetreRenduTaskReseau, sans toucher au comportement par défaut
        # de la classe pour ses autres usages.
        self.panneau.titre_label.setVisible(False)

        # PATCH (demande explicite utilisateur : "je veux que dans le
        # paneau de reglage tu ajoute la possibliter de changer donglet,
        # puisque sur camoufox il est impossible de switcher manuelement
        # facilement ... je veux que dans la panneau de reglage tu met
        # une liste deroulante pour rendre un onglet actifs") -- réactivé
        # (auparavant masqué comme "sans objet pour Camoufox headless
        # distant", cf. historique ci-dessus) : c'est justement PARCE
        # QUE c'est du headless distant, où aucun clic manuel sur les
        # onglets natifs du navigateur n'est possible, que ce contrôle
        # devient nécessaire. Recâblé plus bas (cf. bloc "Onglet
        # navigateur distant") vers le protocole commande_instance/
        # listTabs-switchTab existant (déjà supporté par _executer_
        # commande_camoufox, cf. son corps), PAS vers le protocole local
        # WebSocket (_envoyer_commande_liee) utilisé par InstanceApercuScreen/
        # DashboardScreen -- ce widget n'a aucune connexion réseau propre,
        # même séparation de responsabilités que Rafraîchir/Mode/Taux.
        # PATCH : la bande \"Onglet\" (combo) ne s'affiche plus dans le panneau
        # latéral droit -- remplacée par self.barre_onglets (en haut). Le combo
        # reste vivant (masqué) : il sert de modèle à la barre.
        self.panneau.bande_onglet.setVisible(False)

        # --- Recâblage des contrôles (cf. docstring de classe) : PAS de
        # connexion au protocole nodriver local -- relais vers CE widget,
        # que TaskConfigScreen écoute pour piloter le sAutoniax distant.
        # ---
        self.panneau.rafraichir_button.clicked.connect(self.demande_rafraichissement.emit)
        self.panneau.fps_auto_spin.valueChanged.connect(self._sur_changement_taux)
        self.panneau.case_auto.toggled.connect(self._sur_bascule_mode_auto)
        # SIMPLIFICATION (cf. docstring de classe ApercuDragHandle) : ce
        # bouton fonctionne désormais par simple clic (copie presse-papier),
        # plus par QDrag -- plus de signaux drag_demarre/drag_termine à
        # connecter, donc plus besoin de masquer/restaurer colonne_reglages
        # pendant le geste. _sur_drag_capture_demarre/_sur_drag_capture_
        # termine restent définies ci-dessous mais ne sont plus appelées.
        self._rafraichir_statut_local()

        # BUG CORRIGÉ (demande explicite utilisateur : "quand on passe de
        # full a moyen ou economie sa naffiche plus l'image en plein
        # dimension, je veux que sa reste redimensionner en la taille
        # d'origine meme si sa seras flou") -- contrairement à
        # InstanceApercuScreen (rendu LOCAL), definir_image ci-dessous
        # posait le pixmap reçu tel quel (setPixmap brut, sans .scaled()) :
        # à résolution serveur réduite (Medium/Économie, cf. B.3), l'image
        # décodée est plus petite en pixels et s'affichait donc plus
        # petite dans le panneau au lieu de remplir l'espace disponible en
        # étant agrandie (quitte à perdre en netteté). Fixé en gardant la
        # dernière image reçue (self._derniere_image, même nom que
        # InstanceApercuScreen) et en la réappliquant à la taille ACTUELLE
        # du label à chaque frame ET à chaque redimensionnement -- même
        # patron exact que InstanceApercuScreen._sur_redimensionnement_
        # apercu/_afficher_apercu_defaut (Qt.KeepAspectRatio : agrandit ou
        # réduit en conservant le ratio, ne déforme jamais).
        self._derniere_image: Optional[QImage] = None
        self.panneau.apercu_label.redimensionne.connect(self._sur_redimensionnement_apercu)

        # --- PATCH (mode sélection multiple sur le rendu réseau, demande
        # explicite utilisateur : "on doit pourvoir faire une selection a
        # lecran [...] si on repete loperation [...] les image en
        # selction odit etre coserver et non suppromimer") -- liste des
        # images DÉJÀ DÉCOUPÉES (une entrée par sélection validée à
        # l'Espace dans SelectionZoneOverlay, cf. bouton_selection_zone/
        # _demarrer_selection_zone/_sur_zone_selection_validee plus bas),
        # PAS remise à zéro entre deux sélections successives -- seule
        # _vider_captures_selectionnees (bouton poubelle) ou l'import
        # effectif côté ComposantsScreen (cf. _start_capture_composant_
        # depuis_rendu_reseau) la vide. Persiste tant que ce widget
        # n'est pas détruit (survit à un Échap qui masque juste la
        # fenêtre, cf. keyPressEvent/_masquer_comme_echap -- ce hide()
        # ne touche jamais à cette liste).
        self._captures_selectionnees: list[QImage] = []
        # Référence forte vers l'overlay de sélection en cours (même
        # raison que ComposantsScreen._overlay_capture : éviter le
        # garbage-collect prématuré tant que l'overlay est affiché).
        self._overlay_selection_zone: Optional["SelectionZoneOverlay"] = None
        # Image sur laquelle porte la sélection EN COURS (cf. docstring
        # de _demarrer_selection_zone) -- distincte de self._derniere_
        # image, qui peut changer pendant que l'overlay est ouvert.
        self._image_en_cours_de_selection: Optional[QImage] = None
        # Référence forte vers la popup galerie (clic droit sur le
        # bouton ciseau, cf. _afficher_galerie_captures_selectionnees) --
        # même raison, fenêtre top-level sans parent réel tant qu'ouverte.
        self._galerie_captures: Optional["GaleriePopupCapturesReseau"] = None

        # --- PATCH B.4 (contrôle à distance réel, cf. cahier des charges
        # patchs.md) : toggle visible UNIQUEMENT ici (mode réseau, même
        # principe que definir_reglages_capture_reseau_visibles) --
        # jamais pour un rendu LOCAL, cf. docstring de bande_controle_
        # distance côté PanneauRenduInstance. ---
        self.panneau.definir_controle_distance_visible(True)
        self.panneau.case_controle_distance.toggled.connect(self._sur_bascule_controle_distance)
        self.panneau.bouton_glisser_souris.toggled.connect(self._sur_bascule_glisser_souris)

        # --- Terminal de sortie de cellule (AJOUT -- demande explicite
        # utilisateur : "rajouter un terminal de sortie lorsqu'on exécute
        # un notebook sur une instance, le terminal du panneau de task
        # doit renvoyer les sorties de cellule") -- visible UNIQUEMENT
        # ici (mode réseau, même principe que definir_reglages_capture_
        # reseau_visibles/definir_controle_distance_visible ci-dessus) :
        # jamais pour un rendu LOCAL, cf. docstring de bande_terminal
        # côté PanneauRenduInstance. La sortie elle-même est poussée par
        # TaskConfigScreen (qui détient les sessions d'exécution et les
        # cellules), pas par ce widget -- cf. TaskConfigScreen.sur_log_
        # execution_reseau_recu, qui appelle self._fenetre_rendu_reseau.
        # panneau.ajouter_ligne_terminal(...) au fil de l'eau.
        self.panneau.definir_terminal_visible(True)

        # eventFilter sur apercu_label (pas de sous-classe dédiée, cf.
        # ApercuTraceableLabel plus haut dans le fichier qui fait un
        # choix différent -- ici on ne modifie JAMAIS le pixmap affiché,
        # seulement la CAPTURE d'événements, donc un simple eventFilter
        # posé depuis l'extérieur suffit et évite de complexifier
        # LabelApercuRedimensionnable pour tous ses autres usages) --
        # actif en permanence, mais n'agit que si le toggle est coché
        # (cf. eventFilter ci-dessous, vérifie self._controle_distance_actif
        # avant toute conversion/envoi).
        self._controle_distance_actif = False
        self._glisser_souris_actif = False
        self._glisser_point_depart: Optional[tuple[int, int]] = None
        self.panneau.apercu_label.installEventFilter(self)
        self.panneau.apercu_label.setFocusPolicy(Qt.StrongFocus)
        # CORRECTIF (bug rapporté : "quand jessaie de faire le scroll sa
        # ne fonctionne pas") -- apercu_label est posé DANS un QScrollArea
        # réel (self.panneau.apercu_scroll, cf. PanneauRenduInstance.
        # __init__ -- échelle réelle 1:1, scrollbars natives dès que
        # l'image dépasse l'espace du panneau). C'est le VIEWPORT de ce
        # QScrollArea, pas apercu_label lui-même, qui reçoit réellement
        # les QEvent.Wheel dans un widget scrollable Qt -- l'eventFilter
        # posé uniquement sur apercu_label ne les voyait donc jamais : la
        # molette scrollait le petit cadre d'aperçu LOCALEMENT (comportement
        # natif du QScrollArea) au lieu d'être relayée à l'instance
        # distante. Filtré ici en plus, sur le viewport -- cf. eventFilter,
        # qui absorbe désormais (return True) le Wheel reçu par CE widget
        # aussi quand le contrôle à distance est actif, pour empêcher le
        # double effet (scroll local ET relayé en même temps).
        self.panneau.apercu_scroll.viewport().installEventFilter(self)
        # PATCH (demande explicite utilisateur : "je veux que les
        # mouvement de la souris ne soit plus relayer en direct ...
        # normalement quand je clic a quelque part sa doit generer la
        # trajectoire automatiquement et cliquer, donc le mouvement de la
        # souris est inutile a relayer") -- mousemove relayé en direct
        # RETIRÉ : action_camoufox_click (cf. sa docstring) déplace déjà
        # la souris avec une trajectoire humaine JUSQU'AU point cliqué
        # avant d'effectuer le clic (réutilise action_camoufox_mousemove
        # en interne) -- relayer aussi chaque position intermédiaire de
        # la souris DU PILOTE était donc redondant avec ce que le clic
        # fait déjà tout seul, pour un trafic WebSocket inutile.
        # setMouseTracking(True) retiré avec lui : ne servait qu'à
        # recevoir MouseMove sans bouton enfoncé, plus aucun utilisateur
        # depuis ce retrait.

        # Position du DERNIER clic/mousedown envoyé (coordonnées image
        # réelle, pas widget) -- réutilisée comme x/y pour "type_text" à
        # l'envoi du texte accumulé (cf. _sur_debounce_texte_clavier) :
        # "type_text" côté sAutoniax reclique systématiquement à x,y avant
        # de taper (cf. _camoufox_clic_simple_focus), donc on rejoue le
        # clic le plus récent plutôt qu'une position arbitraire.
        self._derniere_position_clic: Optional[tuple[int, int]] = None
        # PATCH (retour utilisateur explicite : "lorsque je saisis le
        # texte très rapidement, ça se décale, ça ne met pas souvent dans
        # le bon ordre") -- cf. docstring complète du diagnostic côté
        # action_camoufox_type_text (avec_clic). True tant qu'AUCUN
        # "type_text" n'a encore été envoyé depuis le dernier vrai clic
        # souris (cf. _sur_clic_controle_distance, qui remet ce flag à
        # True à CHAQUE nouveau clic) -- le premier morceau d'une saisie
        # continue re-clique donc normalement (avec_clic=True), mais si le
        # débounce a coupé cette même saisie en plusieurs morceaux (frappe
        # rapide + micro-pause > 400ms), les morceaux suivants n'ont plus
        # besoin de re-cliquer : le curseur est déjà à la bonne position
        # côté page (page.keyboard.type() l'y laisse), un second clic au
        # même point fixe risquerait au contraire de le replacer au milieu
        # du texte déjà tapé. Remis à True aussi par Entrée/Backspace-en-
        # press_key/Ctrl+A (cf. _sur_touche_controle_distance) : ces
        # actions reclique ELLES-MÊMES à (x, y) côté sAutoniax (cf.
        # action_camoufox_press_key), donc le curseur y est de nouveau
        # positionné par CE clic-là après leur exécution -- pas de raison
        # de faire l'hypothèse qu'il reste au même endroit pour le
        # prochain type_text.
        self._clic_a_consommer_pour_type_text = True

        # Accumulation + debounce pour la saisie clavier (cf. eventFilter,
        # KeyPress) : "type_text" est la SEULE action clavier exposée par
        # le dispatcher sAutoniax (_executer_commande_camoufox) -- pas de
        # "key_press" touche-par-touche -- et elle reclique à x,y à
        # CHAQUE appel (cf. ci-dessus). Envoyer un type_text par touche
        # taperait donc un caractère puis re-cliquerait avant le suivant,
        # ce qui casserait toute sélection/curseur en cours côté page.
        # Le texte est donc accumulé et envoyé en UN SEUL type_text après
        # un court silence clavier (debounce), limite connue et acceptée
        # pour cette V1 -- cf. docstring _sur_debounce_texte_clavier pour
        # le détail des cas limites (touches fléchées entre-temps, etc).
        self._CONTROLE_DISTANCE_DEBOUNCE_TEXTE_MS = 400
        # PATCH (retour utilisateur explicite : "la saisie de texte est
        # très lente, je veux que ce soit très rapide, juste pour le mode
        # réseau pilotage direct" -- "80 pourcent" de réduction demandée)
        # -- transmis en tant que "facteur_vitesse" à action_camoufox_
        # type_text (cf. sa docstring, et celle de _resoudre_delai_frappe_ms,
        # pour le pourquoi de multiplier le délai APRÈS résolution plutôt
        # que de réduire delai_min_ms/delai_max_ms : la banque de frappe
        # réelle -- Data/files/mouseData.sqlite3 -- prime INCONDITIONNELLEMENT
        # sur ces deux bornes dès qu'elle est disponible, réduire les
        # bornes seules n'aurait donc eu aucun effet visible dans ce cas).
        # 0.2 = il ne reste que 20% du délai normal (réduction de 80%).
        # Constante PROPRE à ce widget (pilotage réseau direct) -- aucun
        # autre appelant de type_text/action_camoufox_type_text
        # (TestComposantScreen/SequenceurAction, mode local nodriver) n'est
        # concerné, leur délai reste inchangé (facteur_vitesse=1.0 par
        # défaut côté action_camoufox_type_text).
        self._FACTEUR_VITESSE_SAISIE_PILOTAGE_DIRECT = 0.2
        self._texte_clavier_en_attente = ""
        self._minuteur_debounce_texte = QTimer(self)
        self._minuteur_debounce_texte.setSingleShot(True)
        self._minuteur_debounce_texte.setInterval(self._CONTROLE_DISTANCE_DEBOUNCE_TEXTE_MS)
        self._minuteur_debounce_texte.timeout.connect(self._sur_debounce_texte_clavier)

        # PATCH (retour utilisateur explicite : "au lieu d'envoyer
        # l'événement scroll en direct ... enregistre d'abord l'événement
        # scroll complet, jusqu'à détecter que l'utilisateur ne scrolle
        # plus, et exécute maintenant de l'autre côté sAutoniax", "je ne
        # veux pas de perte de temps") -- même principe qu'au-dessus pour
        # le clavier (accumulation + debounce), PAS un simple throttle
        # (qui enverrait quand même plusieurs commandes, juste espacées) :
        # un geste de molette humain envoie facilement 10-20 QEvent.Wheel
        # en une fraction de seconde (cf. eventFilter), et CHAQUE commande
        # "scroll" envoyée déclenche côté sAutoniax un rejeu HUMANISÉ cran
        # par cran de plusieurs secondes (cf. action_camoufox_scroll) --
        # les envoyer une par une empile donc des dizaines de secondes de
        # rejeu, très en retard sur le geste réel. En accumulant tous les
        # deltaX/deltaY de la rafale et en n'envoyant qu'UNE SEULE
        # commande "scroll" une fois le silence détecté (fin du geste),
        # une seule exécution suffit côté sAutoniax -- cf.
        # action_camoufox_scroll, paramètre rapide=True (voir plus bas) :
        # applique ce delta déjà "joué" côté pilote SANS le rejouer une
        # seconde fois au ralenti, pour une exécution immédiate ("je ne
        # veux pas de perte de temps").
        self._CONTROLE_DISTANCE_DEBOUNCE_SCROLL_MS = 150  # court -- juste assez pour fusionner une rafale de crans, pas pour retarder perceptiblement l'exécution
        self._delta_scroll_x_en_attente = 0.0
        self._delta_scroll_y_en_attente = 0.0
        self._derniere_position_scroll: Optional[tuple[int, int]] = None
        self._minuteur_debounce_scroll = QTimer(self)
        self._minuteur_debounce_scroll.setSingleShot(True)
        self._minuteur_debounce_scroll.setInterval(self._CONTROLE_DISTANCE_DEBOUNCE_SCROLL_MS)
        self._minuteur_debounce_scroll.timeout.connect(self._sur_debounce_scroll)

        # Compteur local de requete_id (cf. serveur.py, handler
        # commande_instance/command_result -- corrélation en mémoire côté
        # serveurT) : un simple compteur préfixé par un uuid court suffit,
        # unique PAR FENÊTRE, ce qui est la seule garantie nécessaire (le
        # serveur route par requete_id brut, pas besoin d'unicité globale
        # process-wide).
        self._prefixe_requete_controle = uuid.uuid4().hex[:8]
        self._compteur_requete_controle = 0

        # --- Point de statut de connexion à l'instance distante (demande
        # explicite utilisateur : "dans le panneau de rendu d'instance
        # réseau, un petit point vers l'angle nord-ouest qui est vert
        # quand la connexion passe bien, et gris si non") -- petit
        # QLabel rond posé en OVERLAY sur colonne_image (même patron que
        # colonne_reglages/_repositionner_panneau_flottant ci-dessus :
        # setParent(colonne_image) + setGeometry en coordonnées de
        # colonne_image + raise_()), PAS dans le layout normal
        # (_corps_layout/droite_layout) pour ne rien décaler dans le
        # reste du panneau. Créé ICI (dans __init__, pas dans
        # _preparer_mode_overlay) car definir_image() -- qui pilote sa
        # couleur -- peut être appelée AVANT _preparer_mode_overlay
        # (cf. ProjetsDistribuesScreen._sur_clic_apercu_execution :
        # definir_image(None) puis SEULEMENT ENSUITE afficher_par_
        # dessus_tout(), qui est ce qui déclenche _preparer_mode_overlay)
        # -- le point doit donc déjà exister au tout premier appel.
        #
        # "Passe bien" = une capture VALIDE vient d'être reçue et
        # affichée (cf. definir_image ci-dessous) -- pas un simple état
        # de rattachement au serveurT (qui concerne la connexion
        # mAutoniax<->serveurT, pas mAutoniax<->CETTE instance
        # sAutoniax précise, cf. réponse explicite utilisateur : "la
        # connexion à cette instance précise (nodriver/sAutoniax)").
        # Gris par défaut (aucune capture reçue pour l'instant), jamais
        # rouge/orange : demande explicite ne mentionne que deux états.
        self._POINT_STATUT_DIAMETRE = 10
        self._POINT_STATUT_MARGE = 8
        # PATCH -- espace horizontal entre point_statut_connexion et
        # point_statut_execution (cf. plus bas), assez large pour bien
        # distinguer visuellement les deux points sans les coller.
        self._POINT_STATUT_ESPACEMENT = 6
        self.point_statut_connexion = QLabel(self.panneau.colonne_image)
        self.point_statut_connexion.setFixedSize(self._POINT_STATUT_DIAMETRE, self._POINT_STATUT_DIAMETRE)
        self.point_statut_connexion.setStyleSheet(
            f"background-color: {Mocha.overlay0}; border-radius: {self._POINT_STATUT_DIAMETRE // 2}px;"
        )
        self.point_statut_connexion.setToolTip("Connexion à l'instance : aucune capture reçue pour l'instant.")

        # --- PATCH -- second point, juste à côté du précédent (demande
        # explicite utilisateur : "mettre un point pareil apres le point
        # vert flottant de statut de connexion, histoire de vite se
        # rendre compte si lexecution a echouer"). Reflète le statut de
        # la DERNIÈRE SÉQUENCE GLOBALE ("Tout exécuter"), EXACTEMENT la
        # même donnée que BadgeStatutNotebook/_rafraichir_badge_statut_
        # notebook (cf. TaskConfigScreen._dernier_statut_sequence) --
        # même palette (vert=succès, rouge=erreur, orange/peach=
        # interrompu, gris=aucune exécution) pour rester cohérent avec
        # ce que l'utilisateur voit déjà dans la barre de boutons
        # principale du notebook, plutôt que d'inventer une seconde
        # convention de couleurs à retenir. Piloté depuis TaskConfigScreen
        # (cf. definir_statut_derniere_execution ci-dessous, appelée
        # depuis _rafraichir_bouton_global -- même point d'orchestration
        # central que le badge, jamais dupliqué séparément) : ce widget
        # lui-même reste un simple point QLabel comme point_statut_
        # connexion, PAS BadgeStatutNotebook (pas besoin de l'anneau
        # animé ici, le badge de la barre principale remplit déjà ce
        # rôle "en cours" -- ce point-ci ne fait que résumer le dernier
        # résultat connu, glanceable même quand le panneau flottant est
        # la seule chose regardée).
        self.point_statut_execution = QLabel(self.panneau.colonne_image)
        self.point_statut_execution.setFixedSize(self._POINT_STATUT_DIAMETRE, self._POINT_STATUT_DIAMETRE)
        self.point_statut_execution.setStyleSheet(
            f"background-color: {Mocha.overlay0}; border-radius: {self._POINT_STATUT_DIAMETRE // 2}px;"
        )
        self.point_statut_execution.setToolTip("Dernière exécution globale : aucune pour l'instant.")

        # --- PATCH -- boutons Précédent/Suivant (retour utilisateur
        # explicite : "mon seul probleme avec le panneau rendu cest la
        # navigation, il aucun bouton de retour [...] des que on ouvre une
        # pae web on s t pieger" -- confirmé : goBack/goForward n'avaient
        # aucun mécanisme de contrôle à distance, contrairement à
        # click/scroll/type_text/press_key -- cf. action_go_back/
        # action_go_forward et action_camoufox_go_back/_go_forward côté
        # sAutoniax). Demande explicite de positionnement : "a coter des
        # 2 point de statut flotant [...] cest eu qui serviront de
        # switch" -- même patron flottant que point_statut_connexion/
        # point_statut_execution juste au-dessus (QWidget enfant direct
        # de colonne_image, geometry() posée à la main dans
        # _repositionner_point_statut_connexion, PAS dans un layout, PAS
        # dans l'entête du panneau réglages -- rien à voir avec les
        # toggles case_auto_a_ouverture/case_ajuster_a_la_fenetre) --
        # QToolButton plutôt que QLabel (les deux points restent de
        # simples indicateurs non cliquables, ces deux boutons doivent
        # l'être). Style/icônes/curseur : même patron que self.bouton_
        # fermer un peu plus haut dans ce __init__ (APIFeaturesMenuButton,
        # qta.icon, PointingHandCursor).
        self._BOUTON_NAV_TAILLE = 20
        self.bouton_precedent = QToolButton(self.panneau.colonne_image)
