    def api2api_requete_bloquant(self, id_api2api: str, donnees: list, timeout_s: float) -> dict:
        """Envoie une requête (Api2ApiTask.request(...) côté script) au
        Task Api2Api verrouillé par ce client, et BLOQUE jusqu'à la
        réponse du fournisseur (api2api_reponse, relayée par le
        serveurT) ou jusqu'à `timeout_s`. `donnees` : liste de
        {"nom": str, "contenu_b64": str} -- cf. Api2Api.request pour la
        construction, un seul paquet réseau groupé même pour plusieurs
        fichiers (décision explicite utilisateur : "sa seras trasformer
        en un seul paquet pour lotimisation")."""
        if self._loop is None or not self._loop.is_running() or self._ws is None:
            return {"ok": False, "erreur": "Non connecté au serveurT."}
        requete_id = uuid.uuid4().hex[:12]
        asyncio.run_coroutine_threadsafe(
            self._ws.send(json.dumps({
                "type": "api2api_requete", "id_api2api": id_api2api,
                "requete_id": requete_id, "donnees": donnees,
            })), self._loop,
        )
        return self._api2api_attendre_future(requete_id, timeout_s)

    def api2api_attendre_requete_bloquant(self, id_api2api: str, timeout_s: Optional[float] = None) -> dict:
        """Côté FOURNISSEUR (attendre_requete() côté script) -- BLOQUE
        jusqu'à ce qu'une requête arrive pour ce Task Api2Api verrouillé
        par un client (message api2api_requete_recue, cf. _traiter_message
        plus bas qui résout la future correspondante). Contrairement aux
        méthodes ci-dessus, n'envoie RIEN au serveurT : cette méthode ne
        fait qu'attendre passivement, la future est enregistrée sous la
        clé `id_api2api` elle-même (PAS un requete_id généré ici -- côté
        fournisseur, on ne sait pas encore QUELLE requête arrivera) plutôt
        que sous un requete_id qu'on ne connaît pas encore à l'avance.
        timeout_s=None (défaut) : attente indéfinie -- cohérent avec
        l'usage attendu (while True: req = attendre_requete()), un Task
        Api2Api fournisseur n'a normalement AUCUNE raison de cesser
        d'attendre tant qu'il n'est pas arrêté explicitement.

        BUGFIX (diagnostic confirmé par logs [DIAG-API2API]) -- le message
        serveur "api2api_requete_recue" (cf. serveur.py, handler
        api2api_requete) N'A JAMAIS de clé "ok" : sa seule réception
        signifie déjà un succès (une vraie requête est arrivée), contrairement
        aux messages *_ack (api2api_enregistrer_ack, api2api_verrouiller_ack,
        etc.) qui, eux, portent toujours "ok" explicitement. Avant ce
        correctif, cette méthode renvoyait ce dict tel quel en cas de succès
        -- attendre_requete() (module-level, plus bas dans ce fichier)
        teste ensuite resultat.get("ok", False), qui retombe sur False
        faute de clé "ok", et lève RuntimeError("erreur inconnue") même
        quand la requête a été reçue avec succès et contient des données
        valides. Résultat : TOUTE requête Api2Api légitime faisait planter
        le Task fournisseur au moment même où il recevait enfin sa requête
        -- rien à voir avec une déconnexion ou une course entre Tasks
        (fausses pistes explorées avant l'ajout des logs [DIAG-API2API]).
        Normalisé ICI (à la source, dans la seule méthode qui connaît le
        format réel des deux issues possibles) plutôt que dans l'appelant,
        pour que api2api_attendre_requete_bloquant garde un contrat de
        retour cohérent : {"ok": True, ...} dans tous les cas de succès."""
        if self._loop is None or not self._loop.is_running() or self._ws is None:
            return {"ok": False, "erreur": "Non connecté au serveurT."}
        cle_future = f"attente_requete:{id_api2api}"
        # BUGFIX (log observé : "api2api_requete_recue reçue sans
        # attendre_requete() en cours ... requête perdue") -- avant de
        # poser une NOUVELLE future et d'attendre, vérifie d'abord si une
        # requête est déjà arrivée EN AVANCE pour ce id_api2api (cf.
        # _api2api_requetes_en_avance, alimentée par _traiter_message
        # quand api2api_requete_recue arrive alors qu'aucune future
        # n'était encore posée ici -- même clé cle_future des deux côtés).
        # Cas réel : le fournisseur vient de finir de traiter une requête
        # précédente (req.repondre(...), redevenu "libre" côté serveurT)
        # et un nouveau client verrouille + envoie sa requête AVANT que ce
        # thread n'ait fini de repasser en haut de sa boucle while True:
        # pour rappeler attendre_requete() -- sans ce correctif, le
        # message arrivait dans le vide (perdu) et ce thread se serait
        # ensuite bloqué indéfiniment sur une future qui n'aurait jamais
        # pu être résolue (personne ne renvoie deux fois le même message).
        requete_en_avance = self._api2api_requetes_en_avance.pop(cle_future, None)
        if requete_en_avance is not None:
            resultat = requete_en_avance
            if "ok" not in resultat:
                resultat = {**resultat, "ok": True}
            return resultat
        future: concurrent.futures.Future = concurrent.futures.Future()
        self._api2api_futures[cle_future] = future
        try:
            if timeout_s is None:
                resultat = future.result()
            else:
                resultat = future.result(timeout=timeout_s)
            # cf. docstring BUGFIX ci-dessus -- resultat est ici TOUJOURS
            # le message brut "api2api_requete_recue" du serveur (seule
            # façon dont cette Future est résolue avec succès, cf.
            # _traiter_message), qui n'a jamais "ok" : on l'ajoute donc
            # explicitement plutôt que de propager un dict sans "ok" que
            # l'appelant interprèterait à tort comme un échec.
            if "ok" not in resultat:
                resultat = {**resultat, "ok": True}
            return resultat
        except concurrent.futures.TimeoutError:
            return {"ok": False, "erreur": f"timeout ({timeout_s}s) : aucune requête reçue pour '{id_api2api}'"}
        finally:
            self._api2api_futures.pop(cle_future, None)

    def api2api_repondre(self, requete_id: str, ok: bool, donnees: list, erreur: Optional[str] = None):
        """Fire-and-forget -- réponse du fournisseur (req.repondre(...)
        côté script) à une requête reçue via api2api_attendre_requete_
        bloquant. Pas d'ack attendu : le CLIENT, lui, attend cette
        réponse via api2api_requete_bloquant (côté symétrique, corrélé
        par le même requete_id) -- si ce message se perd en route, c'est
        le timeout côté client qui le détectera, pas un ack ici."""
        if self._loop is None or not self._loop.is_running() or self._ws is None:
            return
        asyncio.run_coroutine_threadsafe(
            self._ws.send(json.dumps({
                "type": "api2api_reponse", "requete_id": requete_id,
                "ok": ok, "donnees": donnees, "erreur": erreur,
            })), self._loop,
        )

    # --- Implémentation interne (tourne dans le thread réseau) ---

    def _thread_principal(self):
        self._loop = asyncio.new_event_loop()
        asyncio.set_event_loop(self._loop)
        try:
            self._tache_boucle = self._loop.create_task(self._boucle_async())
            self._loop.run_until_complete(self._tache_boucle)
        except asyncio.CancelledError:
            log_reseau_t.debug("Boucle réseau serveurT annulée proprement (arreter())")
        finally:
            self._tache_boucle = None
            self._loop.close()
            self._loop = None

    async def _boucle_async(self):
        """Boucle EXTERNE infinie (retry 10s), enveloppant une boucle
        INTERNE de réception -- cf. docstring de classe pour la raison
        du choix (un seul chemin de code pour "premier démarrage" et
        "après coupure", contrairement à ClientReseauAutoniaX)."""
        try:
            while not self._arret_demande.is_set():
                # PATCH (migration Colab+tunnel -- URL dynamique) --
                # relit l'URL courante sur B2 À CHAQUE tentative (cf.
                # resoudre_url_serveurt), PAS une seule fois au
                # démarrage : le Quick Tunnel change d'URL à chaque
                # redémarrage du notebook ServeurT Manager, donc une URL
                # qui a échoué il y a DELAI_RETRY_SECONDES peut très bien
                # avoir changé entre-temps. self.server_url reste mis à
                # jour en continu (pas seulement local à cette boucle)
                # pour que les logs/l'UI affichent toujours l'URL
                # RÉELLEMENT utilisée pour la tentative en cours.
                #
                # PATCH (plus de repli Render) -- resoudre_url_serveurt()
                # lève désormais une RuntimeError explicite si B2 est
                # injoignable (au lieu de retomber sur une adresse morte)
                # : on l'attrape ICI, au même titre qu'un échec de
                # websockets.connect() -- un B2 injoignable est un échec
                # de connexion comme un autre, on retente simplement après
                # DELAI_RETRY_SECONDES, sans jamais faire planter le
                # thread réseau.
                try:
                    self.server_url = resoudre_url_serveurt()
                    # BUGFIX (retour utilisateur explicite : "je ne veux
                    # pas de limite sur le processus de téléchargement")
                    # -- max_size=None retire TOUTE limite de taille de
                    # message côté lib websockets (le défaut est 1 Mo,
                    # ce qui aurait silencieusement rejeté un chunk trop
                    # gros). Cela ne garantit PAS que le fichier entier
                    # tienne en un seul message pour autant : le tunnel
                    # Cloudflare gratuit (trycloudflare.com) impose ses
                    # PROPRES limites de taille de frame côté
                    # infrastructure, hors de contrôle de ce code -- si
                    # un chunk dépasse CETTE limite-là, la coupure vient
                    # du tunnel lui-même (fermeture de connexion), pas
                    # d'un refus explicite ici. TAILLE_CHUNK_PROFIL_OCTETS
                    # reste donc réglée à une valeur prudente (cf. son
                    # propre commentaire) : lever cette limite-ci ne
                    # revient pas à lever celle, invisible, du tunnel.
                    # BUGFIX (keepalive ping timeout, code 1011) -- en plus du
                    # heartbeat APPLICATIF JSON ci-dessus (DELAI_HEARTBEAT_
                    # SECONDES/DELAI_TIMEOUT_PONG_SECONDES), la lib websockets
                    # gère SON PROPRE ping/pong natif au niveau protocole,
                    # totalement indépendant et invisible dans ce code.
                    # Tentative précédente : aligner ping_timeout sur
                    # DELAI_TIMEOUT_PONG_SECONDES (60s, ping_interval=20s
                    # laissé à son défaut) -- INSUFFISANT (cf. logs :
                    # déconnexion "keepalive ping timeout" toujours observée
                    # ~88s après l'envoi d'un chunk de mouseData.sqlite3,
                    # soit au-delà des 20+60=80s de marge). Même cause de
                    # fond que le BUGFIX DELAI_TIMEOUT_PONG_SECONDES
                    # juste au-dessus (le pong natif est RETARDÉ, pas
                    # absent, par la congestion pendant qu'un gros chunk
                    # est en transit sur cette même connexion) mais ce
                    # ping/pong-ci est géré ENTIÈREMENT en interne par la
                    # lib -- impossible de le suspendre dynamiquement
                    # pendant un transfert actif (cf. self._transferts_
                    # chunk_actifs) comme on l'a fait pour _tache_heartbeat,
                    # puisque ping_interval/ping_timeout sont figés au
                    # moment de websockets.connect() et ne s'appliquent
                    # qu'à CE ping-là, invisible et non pilotable depuis
                    # ce code une fois la connexion établie. Repousser
                    # encore le délai ne ferait que déplacer le seuil
                    # (même défaut que la version précédente), jamais
                    # l'éliminer, tant qu'un chunk peut mettre plus de
                    # temps à transiter que n'importe quelle marge choisie.
                    # CORRECTIF RADICAL (cohérent avec _tache_heartbeat) --
                    # ping_interval=None désactive ENTIÈREMENT ce ping/pong
                    # natif : plus aucun risque qu'il ferme la connexion de
                    # force pendant un transfert, quelle que soit sa durée.
                    # La détection de connexion morte repose désormais
                    # UNIQUEMENT sur le heartbeat applicatif JSON
                    # (_tache_heartbeat), qui sait déjà, lui, ignorer un
                    # pong en retard tant qu'un transfert en chunks est
                    # actif (cf. self._transferts_chunk_actifs) tout en
                    # continuant d'envoyer un ping régulier -- donc le
                    # même filet de sécurité reste en place, mais un seul
                    # mécanisme le porte au lieu de deux qui se marchaient
                    # dessus.
                    self._ws = await websockets.connect(
                        self.server_url,
                        max_size=None,
                        ping_interval=None,
                    )
                    # AJOUT (retour utilisateur : bruit récurrent -- le
                    # warning ci-dessous répétait le même message toutes
                    # les DELAI_RETRY_SECONDES tant que le serveurT restait
                    # injoignable) -- compteur remis à zéro dès qu'une
                    # connexion WS aboutit, cf. son incrémentation dans le
                    # except juste en dessous.
                    self._echecs_connexion_consecutifs = 0
                except Exception as e:
                    # AJOUT (retour utilisateur : bruit récurrent en
                    # .warning() à CHAQUE tentative, soit toutes les
                    # DELAI_RETRY_SECONDES (10s) tant que le serveurT est
                    # injoignable) -- .warning() seulement sur la PREMIÈRE
                    # tentative échouée d'une série (le passage de 0 à 1
                    # échec consécutif est l'info utile : "la connexion
                    # vient de tomber/n'a jamais pu s'établir"), .debug()
                    # pour les tentatives suivantes de la même série (déjà
                    # signalées, pas la peine de répéter) -- toujours
                    # visible en entier avec AUTONIAX_DEBUG=1.
                    self._echecs_connexion_consecutifs = getattr(self, "_echecs_connexion_consecutifs", 0) + 1
                    message = f"Connexion au serveurT impossible ({e!r}), nouvel essai dans {self.DELAI_RETRY_SECONDES:.0f}s"
                    if self._echecs_connexion_consecutifs == 1:
                        log_reseau_t.warning(message)
                    else:
                        log_reseau_t.debug(f"{message} (échec consécutif #{self._echecs_connexion_consecutifs})")
                    self.nombre_executants_change.emit(0)
                    await asyncio.sleep(self.DELAI_RETRY_SECONDES)
                    continue

                # PATCH (migration Colab+tunnel -- message de confirmation)
                # -- demande explicite utilisateur : "il faut que
                # lorsque sa seconecte au serveurT et bien sa envoie un
                # message de conformation valide, donc si en sessayent
                # de se connecter les mautoniax ou sautoniax echoue ou
                # se connecte un une mauvaise url ou puisse refuser".
                # Le serveur envoie IMMÉDIATEMENT "serveurT_bonjour" à
                # l'ouverture de la connexion (cf. serveur.py,
                # route_websocket, AVANT tout register) -- on l'attend
                # explicitement ICI, avant même d'envoyer "register" :
                # une URL périmée (ancien tunnel Cloudflare qui répond
                # par hasard sur un tout autre service, ou timeout pur)
                # ne produira jamais ce message précis dans le délai
                # imparti, ce qui distingue "connexion TCP/WS ouverte
                # mais vers le mauvais service" d'une vraie connexion au
                # serveurT -- alors qu'un simple succès de websockets.
                # connect() ci-dessus ne le garantit PAS à lui seul.
                try:
                    bonjour_brut = await asyncio.wait_for(self._ws.recv(), timeout=self.DELAI_TIMEOUT_REGISTER_SECONDES)
                    bonjour = json.loads(bonjour_brut)
                except Exception as e:
                    log_reseau_t.warning(f"Pas de confirmation serveurT_bonjour reçue ({e!r}) -- URL probablement périmée, nouvel essai dans {self.DELAI_RETRY_SECONDES:.0f}s")
                    with contextlib.suppress(Exception):
                        await self._ws.close()
                    await asyncio.sleep(self.DELAI_RETRY_SECONDES)
                    continue
                if bonjour.get("type") != "serveurT_bonjour":
                    log_reseau_t.warning(f"Réponse inattendue à la connexion ({bonjour.get('type')!r} au lieu de 'serveurT_bonjour') -- URL probablement invalide, nouvel essai dans {self.DELAI_RETRY_SECONDES:.0f}s")
                    with contextlib.suppress(Exception):
                        await self._ws.close()
                    await asyncio.sleep(self.DELAI_RETRY_SECONDES)
                    continue

                # AJOUT (cf. docstring self._id_pilote_stable dans
                # __init__) : "id_pilote_stable" transmis à CHAQUE register
                # (donc aussi à chaque reconnexion) -- reste identique d'une
                # connexion à l'autre puisque généré une seule fois à la
                # construction de ce client, contrairement à l'id_connexion
                # que le serveur attribuerait sinon. Champ additif, ignoré
                # sans erreur par un serveurT pas encore mis à jour (register
                # reste fonctionnellement inchangé pour lui) -- rétrocompatible.
                await self._ws.send(json.dumps({
                    "type": "register", "role": self.role, "nom": self.nom,
                    "id_pilote_stable": self._id_pilote_stable,
                }))

                # PATCH (identité stable par nom) -- AVANT ce patch,
                # connecte.emit() avait lieu ici, juste après l'ENVOI du
                # register, sans jamais attendre la réponse du serveur.
                # Ça fonctionnait tant que le serveur acceptait TOUJOURS
                # un register (aucun refus possible) : le seul risque
                # d'échec réel était la coupure TCP elle-même, déjà gérée
                # par le except ConnectionClosed plus bas. Mais depuis
                # que le serveur peut désormais RENVOYER {"type":
                # "erreur"} et NE PAS ajouter la connexion au registre
                # (cf. serveur.py, route_websocket : nom vide pour un
                # exécutant), ce n'est plus vrai -- émettre connecte ici
                # ferait croire à main_sautoniax() que tout est en ordre
                # (cf. connecte_event.wait() dans main_sautoniax) alors
                # que le serveur vient de rejeter la connexion : le
                # sAutoniax continuerait tout son démarrage (téléchargement
                # de profil, lancement du navigateur...) sur une socket
                # ouverte mais jamais enregistrée, sans qu'aucune capture
                # ni aucun message applicatif ne puisse jamais aboutir
                # (le serveur ignore tout message d'une connexion qu'il
                # n'a pas dans son registre). On lit donc explicitement
                # LA PREMIÈRE réponse avant d'émettre connecte, plutôt que
                # de se fier au seul succès du handshake WebSocket.
                try:
                    premiere_reponse_brute = await asyncio.wait_for(self._ws.recv(), timeout=self.DELAI_TIMEOUT_REGISTER_SECONDES)
                except (asyncio.TimeoutError, websockets.exceptions.ConnectionClosed) as e:
                    log_reseau_t.warning(f"Pas de réponse au register ({e!r}), nouvel essai dans {self.DELAI_RETRY_SECONDES:.0f}s")
                    with contextlib.suppress(Exception):
                        await self._ws.close()
                    await asyncio.sleep(self.DELAI_RETRY_SECONDES)
                    continue
                try:
                    premiere_reponse = json.loads(premiere_reponse_brute)
                except json.JSONDecodeError:
                    premiere_reponse = {}
                if premiere_reponse.get("type") == "erreur":
                    # Refus explicite et DÉFINITIF pour ce nom (nom vide,
                    # ou rôle invalide) -- retenter dans DELAI_RETRY_
                    # SECONDES ne changera RIEN au résultat tant que
                    # self.nom reste identique, contrairement à une simple
                    # coupure réseau transitoire. On retente quand même
                    # (plutôt que d'arrêter net ce thread) : self.nom
                    # pourrait en théorie changer entre deux tentatives
                    # via un futur appel externe, et ça reste cohérent
                    # avec "boucle infinie, retry toutes les 10s" déjà
                    # actée pour toute autre forme d'échec -- mais
                    # _traiter_message n'aura pas encore tourné pour ce
                    # message, donc on émet register_refuse nous-mêmes ici
                    # pour que l'appelant (main_sautoniax notamment) soit
                    # informé sans dépendre de la boucle de réception
                    # normale, qui ne démarre jamais dans ce cas.
                    message_erreur = premiere_reponse.get("message", "(raison inconnue)")
                    log_reseau_t.error(f"<- erreur (register refusé) : {message_erreur} -- nouvel essai dans {self.DELAI_RETRY_SECONDES:.0f}s")
                    self.register_refuse.emit(message_erreur)
                    with contextlib.suppress(Exception):
                        await self._ws.close()
                    await asyncio.sleep(self.DELAI_RETRY_SECONDES)
                    continue
                # register_ok (ou tout autre message que le serveur
                # aurait, contre toute attente, envoyé en premier) :
                # traité normalement via le circuit habituel pour ne pas
                # dupliquer la logique de _traiter_message (id_serveur_
                # recu, etc.), PUIS seulement la boucle de réception
                # générale prend le relai pour tout message suivant.
                self._traiter_message(premiere_reponse_brute)

                self.connecte.emit()
                log_reseau_t.info(f"Client serveurT connecté ({self.server_url})")

                # Envoi de la config de stockage R2 juste après le
                # register, à CHAQUE (re)connexion -- le serveurT n'a
                # pour l'instant aucune persistance disque (registre en
                # mémoire simple, cf. cahier 5.4), donc il oublie la
                # config à chaque redémarrage/coupure. Rien n'est envoyé
                # si aucun champ n'est encore renseigné côté Réglages.
                # Réservé au rôle "pilote" (cf. serveur.py, configurer_
                # stockage refuse ce message pour un "executant") --
                # PATCH mode sAutoniax : un exécutant n'a jamais à
                # configurer le stockage global du serveurT.
                if self.role == "pilote":
                    await self._envoyer_config_stockage()
                    # PATCH (recompression par pilote) -- même raison que
                    # _envoyer_config_stockage juste au-dessus : le
                    # serveurT ne persiste rien, donc la préférence
                    # résolution/qualité de CE pilote doit être renvoyée
                    # à chaque reconnexion (cf. docstring de self.
                    # _preference_capture).
                    await self._envoyer_preference_capture()
                elif self.role == "executant" and self._sautoniax_deja_pret:
                    # CORRECTIF (ligne grisée indéfiniment après reconnexion,
                    # cf. docstring envoyer_sautoniax_pret) -- même raison
                    # que le bloc "pilote" ci-dessus : le serveurT ne
                    # persiste rien (registre en mémoire simple), donc il
                    # oublie qu'un exécutant était déjà "prêt" à chaque
                    # redémarrage/coupure du serveurT. self._sautoniax_
                    # deja_pret reste True d'une reconnexion à l'autre une
                    # fois mis à True (jamais remis à False), donc ce
                    # renvoi est automatique à CHAQUE reconnexion suivante,
                    # sans dépendre d'un nouvel appel explicite de
                    # main_sautoniax (qui n'appelle envoyer_sautoniax_pret()
                    # qu'une seule fois, au tout premier démarrage réussi
                    # du process, après téléchargement des dépendances).
                    self.envoyer_sautoniax_pret()

                try:
                    # PATCH heartbeat -- tâche de fond lancée EN PARALLÈLE
                    # de la boucle de réception ci-dessous (create_task,
                    # pas await direct : les deux doivent tourner en même
                    # temps, cf. _tache_heartbeat qui boucle indéfiniment
                    # tant que la connexion est vivante). Lancée ICI
                    # (après connexion + register réussis, PAS avant) et
                    # annulée dans le finally correspondant -- une tâche
                    # par connexion, jamais deux en parallèle après une
                    # reconnexion (cf. annulation explicite avant de
                    # ressortir de ce bloc).
                    # BUGFIX (cf. DELAI_TIMEOUT_PONG_SECONDES) -- remis à
                    # None ICI, à CHAQUE nouvelle connexion établie, pour
                    # ne jamais réutiliser par erreur un timestamp de pong
                    # hérité d'une connexion précédente déjà morte (qui
                    # rendrait la toute première vérification de _tache_
                    # heartbeat faussement positive sur cette nouvelle
                    # connexion).
                    self._dernier_pong_recu = None
                    tache_heartbeat = self._loop.create_task(self._tache_heartbeat())
                    tache_lag = self._loop.create_task(self._tache_moniteur_boucle())
                    tache_garantie = self._loop.create_task(self._tache_garantie())
                    if self.role == "executant" and self._file_garantie:
                        self._tache_rejeu = self._loop.create_task(self._garantie_rejouer())   # renvoi après coupure
                    try:
                        async for brut in self._ws:
                            self._traiter_message(brut)
                    finally:
                        tache_garantie.cancel()
                        with contextlib.suppress(asyncio.CancelledError):
                            await tache_garantie
                        tache_heartbeat.cancel()
                        tache_lag.cancel()
                        with contextlib.suppress(asyncio.CancelledError):
                            await tache_heartbeat
                        with contextlib.suppress(asyncio.CancelledError):
                            await tache_lag
                except websockets.exceptions.ConnectionClosed as e:
                    log_reseau_t.warning(f"Connexion serveurT fermée ({e!r}), nouvel essai dans {self.DELAI_RETRY_SECONDES:.0f}s")
                finally:
                    self.deconnecte.emit()
                    self.nombre_executants_change.emit(0)

                if self._arret_demande.is_set():
                    return
                await asyncio.sleep(self.DELAI_RETRY_SECONDES)
        except asyncio.CancelledError:
            if self._ws is not None:
                await self._ws.close()
            raise

    async def _envoyer_config_stockage(self):
        """Envoie (ou ré-envoie) les identifiants R2 au serveurT --
        no-op silencieux si aucun champ n'est renseigné, pour ne pas
        spammer un message vide à chaque connexion tant que
        l'utilisateur n'a pas rempli l'onglet Réglages correspondant."""
        if not self._config_stockage or not self._config_stockage.get("dossier_racine_id"):
            return
        if self._ws is None:
            return
        try:
            await self._ws.send(json.dumps({
                "type": "configurer_stockage",
                **self._config_stockage,
            }))
            log_reseau_t.info("-> configurer_stockage envoyé au serveurT")
        except Exception as e:
            log_reseau_t.warning(f"Échec envoi configurer_stockage : {e!r}")

    async def _envoyer_mise_a_jour_app(self, element: str, chemin_autoniax: "Path", chemin_mouse_data: "Path",
                                        chemin_dossier_service_api: Optional["Path"] = None,
                                        chemin_project: Optional["Path"] = None):
        """PATCH D, puis PATCH upload fiabilisé, puis MIGRATION Drive
        direct (demande explicite utilisateur : "mAutoniax upload
        directement ... Les 5 (autoniax, mouse_data, project,
        service_api, serveur_t) : tout en upload direct Drive ... plus
        de envoie autonome de fichier du serveur vers les sautoniax").
        Résout `element` en (chemin, nom_fichier, cle) exactement comme
        avant (cf. docstring historique ci-dessous, inchangée pour cette
        partie), mais uploade désormais DIRECTEMENT sur Drive (cf.
        GestionnaireStockageDriveDirect.envoyer_fichier_vers_cloud, ou
        .envoyer_serveur_py pour le cas serveur_t) au lieu d'envoyer un
        protocole mettre_a_jour_app_debut/_chunk/_fin au serveurT :
        ZÉRO octet de fichier ne transite plus par serveur.py pour ce
        bouton. Appel bloquant (googleapiclient) déporté via
        run_in_executor, jamais directement sur la boucle asyncio, même
        précaution que _telecharger_fichier. Retry avec backoff
        exponentiel déjà géré à l'intérieur de ces deux méthodes (cf.
        _put_object_avec_retry) -- pas de protocole de pause/reprise par
        chunks à ce niveau (point ouvert 3 de la spec, tranché : un seul
        appel bloquant avec retry, jamais de reprise partielle).

        `element` :
        - "autoniax" -> envoie chemin_autoniax tel quel (AutoniaX.py) ->
          clé Drive App/AutoniaX.py.
        - "mouse_data" -> envoie chemin_mouse_data tel quel
          (mouseData.sqlite3) -> clé Drive App/mouseData.sqlite3.
        - "service_api" -> zippe D'ABORD chemin_dossier_service_api
          (déporté via run_in_executor -- même raison que
          _zipper_dossier_profil : peut prendre plusieurs secondes sur un
          gros dossier de composants, ne doit jamais bloquer la boucle
          asyncio du thread réseau), puis envoie le zip résultant sous le
          nom fixe "service_api.zip" -> clé Drive App/service_api.zip
          (même clé que le Flux B ciblé, cf. point ouvert 2 de la spec).
          Un dossier vide (aucun composant/service API local pour
          l'instant) est envoyé quand même comme un zip vide plutôt que
          sauté silencieusement -- cohérent avec le choix déjà acté pour
          un fichier absent ci-dessous (échec explicite, jamais un skip
          silencieux).
        - "project" -> envoie chemin_project tel quel (project.json) ->
          clé Drive App/project.json. Fichier texte unique, aucun
          zippage nécessaire (contrairement à service_api qui est un
          DOSSIER d'images).
        - "serveur_t" -> cas SPÉCIAL, réutilise TEL QUEL
          GestionnaireStockageDriveDirect.envoyer_serveur_py (déjà
          écrite + déjà marque ServeurT/stat.json updated=True) plutôt
          que la méthode générique envoyer_fichier_vers_cloud, cf.
          docstring d'envoyer_serveur_py -- c'est CE flag que le
          notebook ServeurT Manager sonde toutes les 10s pour savoir
          qu'il doit retélécharger et relancer.

        Un fichier absent (ex. mouseData.sqlite3 pas encore généré sur
        cette machine) émet un résultat en échec pour CE fichier précis
        -- comportement inchangé depuis avant le patch D."""
        chemin_zip_service_api: Optional[Path] = None
        cle_drive: str = ""
        if element == "autoniax":
            chemin = chemin_autoniax
            nom_fichier = chemin_autoniax.name
            cle_drive = DRIVE_CLE_AUTONIAX_XZ  # compresse avant l'envoi (cf. plus bas)
        elif element == "mouse_data":
            chemin = chemin_mouse_data
            nom_fichier = chemin_mouse_data.name
            cle_drive = DRIVE_CLE_MOUSE_DATA
        elif element == "project":
            # AJOUT (project.json sur Drive -- retour explicite
            # utilisateur : "je coris uqe projetjson doit donc faire
            # partir des ficher a stocker sur le cloud", suite au bug
            # .visible()/AttributeError : _construire_composants_direct
            # cherchait des fichiers *.json par Composant dans
            # service_api.zip, qui n'a JAMAIS existé -- les métadonnées
            # Composant (nom, seuil de confiance, zone de clic...) vivent
            # exclusivement dans project.json, cf. sa docstring de classe
            # Project. Même patron EXACT que "autoniax"/"mouse_data"
            # ci-dessus : fichier local envoyé tel quel, aucun zippage
            # nécessaire (project.json est déjà un fichier texte unique,
            # contrairement à service_api qui est un DOSSIER d'images).
            # chemin_project résolu côté MainWindow (cf.
            # get_project_json_path()), passé ici en paramètre comme les
            # deux autres chemins déjà existants.
            if chemin_project is None:
                self.mise_a_jour_app_resultat.emit(False, "project.json", "chemin_project non fourni (appelant pas à jour).")
                return
            chemin = chemin_project
            nom_fichier = chemin_project.name
            cle_drive = DRIVE_CLE_PROJECT_JSON
        elif element == "service_api":
            nom_fichier = "service_api.zip"
            cle_drive = DRIVE_CLE_SERVICE_API_ZIP
            if chemin_dossier_service_api is None or not chemin_dossier_service_api.exists():
                log_reseau_t.warning(
                    f"mise_a_jour_app : dossier service API introuvable ({chemin_dossier_service_api})"
                )
                self.mise_a_jour_app_resultat.emit(
                    False, nom_fichier, f"Dossier introuvable : {chemin_dossier_service_api}",
                )
                return
            try:
                loop = asyncio.get_running_loop()
                chemin_zip_service_api = await loop.run_in_executor(
                    None, _zipper_dossier_profil, str(chemin_dossier_service_api),
                )
                chemin = chemin_zip_service_api
            except Exception as e:
                log_reseau_t.warning(f"Échec compression dossier service API : {e!r}")
                self.mise_a_jour_app_resultat.emit(False, nom_fichier, f"Échec de la compression : {e}")
                return
        elif element == "serveur_t":
            # PATCH (migration Colab+tunnel, puis migration Drive direct
            # -- demande explicite utilisateur : "sur BB il vas falloir
            # stoker aussi le script du serveur, donc quand je clic sur
            # mise a jour ... sa envoie sur mon cloud BB") -- cas spécial,
            # traité séparément plus bas via envoyer_serveur_py (pas de
            # clé Drive générique ici, cf. docstring de la méthode).
            # chemin_autoniax est détourné ici pour porter le chemin de
            # serveur.py (cf. GitScreen._pousser_vers_bb, seul appelant
            # de ce cas) -- pas de nouveau paramètre dédié, cohérent avec
            # le fait qu'un seul chemin est utile par appel de toute
            # façon (même paramètre que "autoniax" réutilise son sens
            # normal, juste avec un fichier différent dedans).
            chemin = chemin_autoniax
            nom_fichier = "serveur.py"
        else:
            log_reseau_t.warning(f"mise_a_jour_app : élément inconnu ({element!r})")
            self.mise_a_jour_app_resultat.emit(False, "", f"Élément inconnu : {element}")
            return
        if not chemin.exists():
            log_reseau_t.warning(f"mise_a_jour_app : fichier introuvable ({chemin})")
            self.mise_a_jour_app_resultat.emit(False, nom_fichier, f"Fichier introuvable : {chemin}")
            if chemin_zip_service_api is not None:
                chemin_zip_service_api.unlink(missing_ok=True)
            return

        try:
            loop = asyncio.get_running_loop()
            contenu = chemin.read_bytes()
            # BUGFIX (retour utilisateur : "avant je voyais une barre de
            # progresion ... mais maintenant je ne voir plus") -- cf.
            # docstring de _ClientDriveMinimal.put_object pour la cause
            # racine complète (resumable=False, upload en un seul bloc
            # sans jamais appeler next_chunk()). mise_a_jour_app_
            # progression restait déclaré et connecté côté UI (cf.
            # MiseAJourSysteme.sur_progression_mise_a_jour_app) mais
            # n'était plus jamais émis depuis la migration vers l'upload
            # direct Drive -- d'où la barre invisible malgré un envoi qui
            # fonctionne bien (le message "envoyé avec succès." final
            # arrivait quand même, seule la progression intermédiaire
            # manquait). _rappeler_progression tourne dans le THREAD de
            # l'executor (put_object est synchrone, cf. sa docstring) --
            # jamais d'appel direct à un signal Qt depuis un thread
            # autre que celui de la boucle asyncio/Qt : on repasse par
            # loop.call_soon_threadsafe, même précaution que le reste de
            # ce fichier (cf. RelaisProxyLocol/ClientServeurT).
            def _rappeler_progression(pourcentage: int, _nom_fichier=nom_fichier):
                loop.call_soon_threadsafe(
                    self.mise_a_jour_app_progression.emit, _nom_fichier, pourcentage,
                )
            self.mise_a_jour_app_progression.emit(nom_fichier, -1)
            if element == "autoniax":
                # Mise a jour de l'application : le fichier est d'abord compresse (XZ maximal), puis
                # seul l'archive part sur Drive (App/AutoniaX.pyw.xz). Le notebook sAutoniax la decompresse.
                taille_origine = len(contenu)
                contenu = await loop.run_in_executor(None, compresser_xz_maximal, contenu)
                log_reseau_t.info(f"mise_a_jour_app 'AutoniaX.py' compresse : {taille_origine} -> {len(contenu)} octets")
            if element == "serveur_t":
                await loop.run_in_executor(
                    None, lambda: GestionnaireStockageDriveDirect().envoyer_serveur_py(
                        contenu, progression_callback=_rappeler_progression,
                    ),
                )
            else:
                await loop.run_in_executor(
                    None, lambda: GestionnaireStockageDriveDirect().envoyer_fichier_vers_cloud(
                        cle_drive, contenu, progression_callback=_rappeler_progression,
                    ),
                )
            log_reseau_t.info(f"-> mise_a_jour_app '{nom_fichier}' uploadé directement sur Drive ({len(contenu)} octets, cle {cle_drive or 'serveur_t'})")
            self.mise_a_jour_app_resultat.emit(True, nom_fichier, "")
        except Exception as e:
            log_reseau_t.warning(f"mise_a_jour_app '{nom_fichier}' : échec upload Drive direct ({e!r})")
            self.mise_a_jour_app_resultat.emit(False, nom_fichier, str(e))
        finally:
            if chemin_zip_service_api is not None:
                chemin_zip_service_api.unlink(missing_ok=True)

    def reprendre_mise_a_jour_app(self) -> bool:
        """DEVENU NO-OP (migration "Mettre à jour" vers Drive direct --
        demande explicite utilisateur : "mAutoniax upload directement").
        L'ancien protocole en chunks avec pause/reprise (cf. ex-classe
        TransfertMiseAJourEnCours, retirée par cette migration) n'a plus
        cours : _envoyer_mise_a_jour_app fait désormais un seul appel
        bloquant put_object (avec son propre retry interne à backoff
        exponentiel, cf. GestionnaireStockageDriveDirect.
        _put_object_avec_retry), qui soit réussit soit échoue
        définitivement -- aucun état "en pause" n'existe plus pour cette
        méthode à reprendre (point ouvert 3 de la spec, tranché : gardée
        en no-op qui log un avertissement plutôt que supprimée, au cas
        où un bouton "Reprendre" resterait câblé côté UI, cf.
        MiseAJourStockageScreen -- il ne fera simplement plus rien
        d'utile). Toujours False (jamais de transfert à reprendre)."""
        log_reseau_t.warning(
            "reprendre_mise_a_jour_app : n'a plus d'effet (upload Drive direct sans "
            "protocole de pause/reprise, cf. _envoyer_mise_a_jour_app)."
        )
        return False

    # Taille d'un chunk AVANT encodage base64 (l'encodage gonfle
    # d'environ 33%, donc ~13,3 Mo réels sur le fil par message avec la
    # valeur ci-dessous) -- compromis entre nombre de messages (overhead
    # JSON/latence si trop petit) et taille de message WebSocket
    # (mémoire, risque de dépassement d'une limite serveur si trop gros).
    #
    # BUGFIX (retour utilisateur : téléchargement de mouseData.sqlite3,
    # ~10 Mo, prenait plus de 2 MINUTES sur un tunnel Cloudflare
    # trycloudflare.com reliant Kaggle au serveurT) -- la cause n'était
    # PAS la bande passante réelle (10 Mo à cette vitesse ferait ~80
    # kbps, anormalement lent pour un vrai débit) mais le NOMBRE
    # D'ALLERS-RETOURS : chaque chunk est demandé un par un avec un
    # accusé de réception BLOQUANT avant le suivant (cf. Phase 2 de
    # _telecharger_fichier, jamais de pipeline) -- à 512 Ko, ~10 Mo
    # faisaient 22 chunks = 22 round-trips complets, chacun payant en
    # plein la latence du tunnel. Le contenu est déjà lu une seule fois
    # depuis B2 et gardé en RAM côté serveurT (cf. TelechargementFichier
    # EnCours, serveur.py) : le serveur sert chaque chunk instantanément,
    # la latence cumulée était donc QUASI ENTIÈREMENT due au nombre de
    # round-trips, pas au débit ni au traitement serveur.
    #
    # 10 Mo (retour utilisateur explicite, valeur choisie directement par
    # lui après discussion sur 4 Mo) réduit encore plus ce nombre de
    # round-trips (~10 Mo -> 1 seul chunk pour mouseData.sqlite3) sans
    # changer le protocole séquentiel lui-même (toujours un accusé par
    # chunk, cf. Phase 2 -- un vrai pipeline parallèle serait un
    # changement de protocole plus large, pas fait ici). Nécessite
    # max_size=None sur ClientServeurT.websockets.connect (cf. son propre
    # commentaire) : le défaut de la lib websockets est 1 Mo par message
    # reçu, largement sous les ~13,3 Mo encodés d'un chunk de 10 Mo --
    # cette limite par défaut a donc été explicitement retirée, mais la
    # limite RÉELLE et NON documentée du tunnel Cloudflare gratuit
    # (trycloudflare.com) côté infrastructure reste hors de contrôle de
    # ce code (cf. commentaire de max_size=None) : si le tunnel rejette
    # ou coupe un message de cette taille, la cause sera lui, pas ce
    # réglage.
    TAILLE_CHUNK_PROFIL_OCTETS = 5 * 1024 * 1024

    async def _attendre_ack_profil(self, timeout_s: float = 30.0) -> dict:
        """Attend la prochaine résolution de self._future_ack_profil
        (posée par _traiter_message dès qu'un accusé arrive), avec
        timeout -- évite un blocage infini si le serveur ne répond
        jamais (ex. crash serveur en plein milieu d'un envoi)."""
        self._future_ack_profil = self._loop.create_future()
        try:
            return await asyncio.wait_for(self._future_ack_profil, timeout=timeout_s)
        finally:
            self._future_ack_profil = None

    async def _attendre_ack_telechargement(self, timeout_s: float = 600.0) -> dict:
        """Miroir exact de _attendre_ack_profil, pour la Future dédiée
        au téléchargement (cf. _future_ack_telechargement -- Future
        séparée plutôt que réutilisée, voir docstring de son
        déclaration dans __init__ pour la raison).

        CORRECTIF RADICAL (retour utilisateur explicite -- même cause de
        fond que self._transferts_chunk_actifs, cf. sa docstring) --
        30.0s (valeur d'origine) ne laissait aucune marge pour le
        transit réel d'un gros chunk (plusieurs Mo encodés en base64) sur
        un tunnel Cloudflare gratuit congestionné : le temps mesuré par
        les logs DIAG_TELECHARGEMENT côté serveur (lecture/b64encode/
        json_dumps/envoi) ne couvre QUE la préparation et la mise en
        buffer local d'émission, jamais le temps de trajet réel jusqu'à
        ce client -- un `send_text()` qui rend la main vite ne prouve pas
        une livraison rapide. 120s donne une marge large pour ce trajet,
        y compris sur un tunnel lent, sans distinguer selon la taille du
        chunk (pas besoin : passé ce délai, il ne s'agit de toute façon
        plus d'une lenteur normale mais d'un blocage réel)."""
        self._future_ack_telechargement = self._loop.create_future()
        try:
            return await asyncio.wait_for(self._future_ack_telechargement, timeout=timeout_s)
        finally:
            self._future_ack_telechargement = None

    async def _attendre_ack_session(self, session_id: str, timeout_s: float = 30.0) -> dict:
        """Variante de _attendre_ack_profil indexée par session_id (cf.
        docstring de _future_ack_par_session dans __init__) -- utilisée
        par tous les transferts en chunks du Patch 4.9 relayés en direct
        par le serveurT (envoyer_projet_vers_sautoniax_*, mettre_a_jour_
        service_api_*), où plusieurs sessions peuvent être en vol EN
        PARALLÈLE sur cette même connexion pilote."""
        future = self._loop.create_future()
        self._future_ack_par_session[session_id] = future
        try:
            return await asyncio.wait_for(future, timeout=timeout_s)
        finally:
            self._future_ack_par_session.pop(session_id, None)

    # RETRAIT (migration "Mettre à jour" vers Drive direct) : l'ancienne
    # _attendre_ack_mise_a_jour (Future dédiée aux accusés du protocole
    # mettre_a_jour_app_debut/_chunk/_fin) a été retirée avec ce
    # protocole -- _envoyer_mise_a_jour_app n'attend plus aucun accusé
    # réseau, juste le retour (bloquant, déporté via run_in_executor) de
    # l'appel put_object Drive.

    async def _telecharger_fichier_via_websocket(self, cle: str, chemin_destination: str):
        """Télécharge le fichier identifié par `cle` (ex. "App/AutoniaX.py",
        "Profils/<nom>.zip") depuis le stockage B2, EN CHUNKS
        (protocole générique -- demande explicite utilisateur : "sAutoniax
        vas directement demander la requette au serveur et telecharger"),
        via le serveurT (jamais d'accès B2 direct depuis cette méthode --
        le sAutoniax ne connaît jamais les identifiants B2, cf. cahier :
        c'est mAutoniax seul qui les envoie au serveurT via
        _envoyer_config_stockage). Écrit le résultat assemblé sur disque
        à chemin_destination (créé/écrasé), en écriture incrémentale au
        fil des chunks reçus -- pas d'accumulation en mémoire, symétrique
        à UploadProfilEnCours.ecrire_chunk côté serveurT pour l'upload.

        Émet telechargement_fichier_progression(cle, -1) au tout début
        (convention "indéterminé" le temps que le serveurT réponde à
        telecharger_fichier_debut -- taille/nb_chunks pas encore connus
        à cet instant), puis telechargement_fichier_progression(cle,
        0..100) après chaque chunk reçu, et enfin
        telechargement_fichier_resultat une fois le fichier assemblé sur
        disque (ou en cas d'échec à n'importe quelle étape).

        RENOMMÉE depuis _telecharger_fichier (PATCH -- retour explicite
        utilisateur : "je veux exactement le meme mecanisme de
        telechargement" que celui utilisé pour AutoniaX.py lui-même,
        c-à-d HTTP direct plutôt que ce protocole chunké) : reste le
        MÊME code, inchangé, maintenant appelé en repli depuis la
        nouvelle _telecharger_fichier (cf. juste en dessous) si le HTTP
        direct échoue pour quelque raison que ce soit -- jamais de
        régression de fonctionnalité, juste un chemin plus rapide
        tenté en premier."""
        if self._ws is None:
            self.telechargement_fichier_resultat.emit(False, cle, "Non connecté au serveurT.")
            return

        self.telechargement_fichier_progression.emit(cle, -1)
        chemin_dest = Path(chemin_destination)
        try:
            # --- Phase 1 : telecharger_fichier_debut ---
            # PATCH corrélation cle/index (cf. docstring de self._attente_
            # cle_telechargement/_attente_index_chunk_telechargement dans
            # __init__, et le filtrage correspondant dans _traiter_message)
            # -- posé AVANT l'envoi, jamais après, pour qu'un ack qui
            # arriverait de façon anormalement rapide ne puisse jamais
            # trouver l'attente pas encore posée. Pas d'index attendu
            # tant qu'on n'est pas encore en Phase 2 (chunks).
            self._attente_cle_telechargement = cle
            self._attente_index_chunk_telechargement = None
            # CORRECTIF (bug identifié : le heartbeat fermait la connexion
            # de force après DELAI_TIMEOUT_PONG_SECONDES=60s d'absence de
            # pong MÊME quand on n'était encore qu'en Phase 1, en train
            # d'attendre l'ack de 'telecharger_fichier_debut' -- avant ce
            # correctif, self._transferts_chunk_actifs n'était incrémenté
            # qu'au tout début de la Phase 2 (juste avant la boucle des
            # chunks), donc valait encore 0 pendant toute la Phase 1. Sur
            # un tunnel lent/congestionné, l'ack de début peut lui aussi
            # tarder plus de 60s (cf. _attendre_ack_telechargement, monté
            # à 600s) -- le heartcheck voyait alors _transferts_chunk_
            # actifs == 0, concluait à tort à une connexion zombie, et
            # fermait la connexion (self._ws.close()) en plein milieu de
            # cette attente légitime, ce qui faisait échouer le
            # téléchargement AVANT même que le nouveau timeout de 600s
            # n'ait sa chance. Incrémenté maintenant AVANT l'envoi de
            # telecharger_fichier_debut (donc dès la Phase 1), décrémenté
            # dans le `finally` global ci-dessous qui couvre les DEUX
            # phases -- symétrique à la garantie déjà en place pour la
            # Phase 2 seule (cf. ancien commentaire "CORRECTIF RADICAL"
            # conservé plus bas). Résultat : le heartbeat considère
            # maintenant TOUTE la durée d'un telecharger_fichier() (Phase
            # 1 + Phase 2) comme "transfert actif", et ne fermera plus la
            # connexion sur un pong simplement retardé pendant cette
            # période, quelle que soit la phase en cours.
            self._transferts_chunk_actifs += 1
            try:
                # DIAGNOSTIC (demande explicite utilisateur : "patcher les
                # fichiers pour que ca logs assez d'infos ciblees pour
                # trancher rapidement sur l'origine du probleme") --
                # timestamps monotonic à chaque étape.
                log_reseau_t.info(f"-> telecharger_fichier_debut envoyé au serveurT ('{cle}')")
                t_avant_envoi_debut = time.monotonic()
                await self._ws.send(json.dumps({"type": "telecharger_fichier_debut", "cle": cle}))
                t_apres_envoi_debut = time.monotonic()
                log_reseau_t.info(
                    f"DIAG_TELECHARGEMENT debut : '{cle}' -- "
                    f"envoi_local={t_apres_envoi_debut - t_avant_envoi_debut:.3f}s (temps de self._ws.send lui-même)"
                )
                t_avant_attente_ack_debut = time.monotonic()
                ack_debut = await self._attendre_ack_telechargement()
                t_apres_attente_ack_debut = time.monotonic()
                log_reseau_t.info(
                    f"DIAG_TELECHARGEMENT debut_ack : '{cle}' -- "
                    f"attente_ack={t_apres_attente_ack_debut - t_avant_attente_ack_debut:.3f}s "
                    f"(temps entre envoi et réception de l'ack, ok={ack_debut.get('ok')})"
                )
                if not ack_debut.get("ok", False):
                    erreur = ack_debut.get("erreur", "Erreur inconnue")
                    log_reseau_t.warning(f"<- telechargement_fichier_debut_ack (ok=False, '{cle}') : {erreur}")
                    self.telechargement_fichier_resultat.emit(False, cle, erreur)
                    return
                nb_chunks = ack_debut.get("nb_chunks", 0)
                if not isinstance(nb_chunks, int) or nb_chunks <= 0:
                    log_reseau_t.warning(f"<- telechargement_fichier_debut_ack ('{cle}') : nb_chunks invalide ({nb_chunks!r})")
                    self.telechargement_fichier_resultat.emit(False, cle, "Réponse serveur invalide (nb_chunks).")
                    return

                # --- Phase 2 : chunks, un par un, chacun demandé
                # explicitement (cf. docstring de méthode) ---
                # CORRECTIF RADICAL (cf. docstring de self._transferts_
                # chunk_actifs dans __init__) -- suspend la fermeture du
                # heartbeat pour toute la durée de cette boucle (et
                # maintenant aussi pour la Phase 1 ci-dessus, cf.
                # commentaire au-dessus de l'incrémentation).
                chemin_dest.parent.mkdir(parents=True, exist_ok=True)
                with open(chemin_dest, "wb") as f:
                    for index in range(nb_chunks):
                        # cle inchangée depuis la Phase 1 (déjà posée),
                        # seul l'index attendu avance à chaque itération
                        # -- cf. commentaire Phase 1 ci-dessus.
                        self._attente_index_chunk_telechargement = index
                        t_avant_envoi_chunk = time.monotonic()
                        await self._ws.send(json.dumps({
                            "type": "telecharger_fichier_chunk",
                            "cle": cle,
                            "index": index,
                        }))
                        t_apres_envoi_chunk = time.monotonic()
                        ack_chunk = await self._attendre_ack_telechargement()
                        t_apres_attente_chunk = time.monotonic()
                        log_reseau_t.info(
                            f"DIAG_TELECHARGEMENT chunk : '{cle}' index={index}/{nb_chunks} -- "
                            f"envoi_local={t_apres_envoi_chunk - t_avant_envoi_chunk:.3f}s "
                            f"attente_ack={t_apres_attente_chunk - t_apres_envoi_chunk:.3f}s "
                            f"total_chunk={t_apres_attente_chunk - t_avant_envoi_chunk:.3f}s"
                        )
                        if not ack_chunk.get("ok", False):
                            erreur = ack_chunk.get("erreur", "Erreur inconnue")
                            log_reseau_t.warning(
                                f"<- telechargement_fichier_chunk_ack (ok=False, '{cle}', index={index}) : {erreur}"
                            )
                            self.telechargement_fichier_resultat.emit(False, cle, erreur)
                            return
                        t_avant_ecriture = time.monotonic()
                        contenu_b64 = ack_chunk.get("contenu_b64", "")
                        f.write(base64.b64decode(contenu_b64))
                        pourcentage = round((index + 1) / nb_chunks * 100)
                        self.telechargement_fichier_progression.emit(cle, pourcentage)
                        t_apres_ecriture = time.monotonic()
                        log_reseau_t.info(
                            f"DIAG_TELECHARGEMENT ecriture : '{cle}' index={index}/{nb_chunks} -- "
                            f"decode_ecriture_et_signal={t_apres_ecriture - t_avant_ecriture:.3f}s"
                        )
            finally:
                self._transferts_chunk_actifs -= 1

            # --- Phase 3 : telecharger_fichier_fin (purement déclaratif,
            # cf. docstring du handler côté serveurT) ---
            await self._ws.send(json.dumps({"type": "telecharger_fichier_fin", "cle": cle}))
            log_reseau_t.info(f"<- téléchargement terminé ('{cle}', {nb_chunks} chunk(s)) -> {chemin_dest}")
            self.telechargement_fichier_resultat.emit(True, cle, "")
        except Exception as e:
            log_reseau_t.warning(f"Échec téléchargement '{cle}' : {e!r}")
            self.telechargement_fichier_resultat.emit(False, cle, str(e))
            # Un fichier partiel sur disque serait trompeur (ex. un .py
            # tronqué qu'on pourrait tenter d'exécuter) -- nettoyé sur
            # tout chemin d'échec après l'ouverture du fichier.
            chemin_dest.unlink(missing_ok=True)
        finally:
            # PATCH corrélation cle/index : ne JAMAIS laisser une attente
            # périmée en mémoire après la fin de CETTE requête (succès,
            # erreur précoce -- ack ok=False --, timeout, ou exception),
            # sur TOUS les chemins de sortie -- sinon un ack tardif pour
            # cette même requête, reçu après coup, pourrait être pris à
            # tort pour correspondre à une requête FUTURE qui réutiliserait
            # la même 'cle' (ex. re-téléchargement après un premier échec).
            self._attente_cle_telechargement = None
            self._attente_index_chunk_telechargement = None

    def _telecharger_fichier_via_http_bloquant(self, cle: str, chemin_destination: str) -> None:
        """Partie SYNCHRONE (bloquante) du téléchargement HTTP direct --
        exécutée dans le threadpool par _telecharger_fichier (jamais
        directement sur la boucle asyncio). Même route que celle déjà
        utilisée pour AutoniaX.py lui-même côté sAutoniaxLauncher.ipynb
        (GET /fichier/{cle}, cf. serveur.py/telecharger_fichier_http) --
        un seul flux HTTP, pas de chunking manuel, pas d'ack par
        message : mécanisme identique demandé explicitement par
        l'utilisateur ("je veux exactement le meme mecanisme de
        telechargement... fait le pour tout"), désormais utilisé pour
        TOUS les fichiers (App/, Profils/...), plus seulement AutoniaX.py.
        Écrit en flux (shutil.copyfileobj), pas de gros bytes accumulés
        en mémoire avant écriture."""
        url_http_base = _url_http_depuis_url_websocket_serveur_t(self.server_url)
        url_fichier = f"{url_http_base}/fichier/{cle}"
        requete = urllib.request.Request(url_fichier, method="GET")
        chemin_dest = Path(chemin_destination)
        chemin_dest.parent.mkdir(parents=True, exist_ok=True)
        with urllib.request.urlopen(requete, timeout=120) as reponse:
            if reponse.status != 200:
                raise RuntimeError(f"HTTP {reponse.status} en téléchargeant '{cle}'.")
            with open(chemin_dest, "wb") as f:
                shutil.copyfileobj(reponse, f)

    async def _telecharger_fichier(self, cle: str, chemin_destination: str):
        """Point d'entrée UNIQUE de téléchargement (cf. telecharger_fichier,
        méthode publique Qt qui appelle celle-ci).

        CHANGEMENT (demande explicite utilisateur : "je ne veux plus
        que le telechargement passe par le serveur ... sa doit etre
        direct au cloud ... les identifiant sont deja telechargeer dans
        drive.json") -- tente désormais un accès **Drive DIRECT** en
        PREMIER (GestionnaireStockageDriveDirect.telecharger_vers_fichier,
        via la clé de service déjà présente sur disque, cf.
        ReglagesApp.drive_chemin_cle_json_resolu) : plus aucun aller-
        retour réseau vers serveur.py dans le cas normal, ni HTTP ni
        WebSocket -- juste l'API Google Drive v3, exactement comme le
        fait déjà resoudre_url_serveurt()/envoyer_serveur_py() pour
        d'autres usages dans ce même fichier.

        Repli AUTOMATIQUE (uniquement si l'accès Drive direct échoue --
        clé de service absente/invalide, dossier racine mal configuré,
        fichier réellement introuvable sur Drive, coupure réseau...) sur
        l'ancien mécanisme HTTP direct via serveur.py (_telecharger_
        fichier_via_http_bloquant), lui-même replié sur le protocole
        WebSocket chunké (_telecharger_fichier_via_websocket) si le HTTP
        échoue aussi -- jamais de régression par rapport au comportement
        précédent, juste un chemin direct tenté en priorité. Ce repli ne
        peut réussir que si une connexion serveurT est disponible
        (self.server_url résolu) ; sinon il échoue à son tour et
        l'échec final est rapporté normalement."""
        loop = self._loop or asyncio.get_running_loop()
        log_reseau_t.info(f"-> téléchargement Drive direct tenté en premier ('{cle}')")

        def _callback_progression(pourcentage: int):
            # Appelée depuis le thread du threadpool (googleapiclient est
            # synchrone) -- jamais émettre un signal Qt directement depuis
            # ce thread, on repasse par call_soon_threadsafe pour que
            # l'emit() ait lieu sur le thread réseau (celui qui possède
            # ClientServeurT), même précaution que les autres callbacks
            # thread-safe de cette classe (cf. run_coroutine_threadsafe).
            loop.call_soon_threadsafe(self.telechargement_fichier_progression.emit, cle, pourcentage)

        try:
            await loop.run_in_executor(
                None,
                lambda: GestionnaireStockageDriveDirect().telecharger_vers_fichier(
                    cle, chemin_destination, _callback_progression,
                ),
            )
        except Exception as e_drive:
            log_reseau_t.warning(
                f"Échec téléchargement Drive direct '{cle}' ({e_drive!r}) -- "
                "repli sur le protocole HTTP/WebSocket via le serveurT."
            )
            Path(chemin_destination).unlink(missing_ok=True)
            try:
                await loop.run_in_executor(None, self._telecharger_fichier_via_http_bloquant, cle, chemin_destination)
            except Exception as e_http:
                log_reseau_t.warning(
                    f"Échec téléchargement HTTP direct '{cle}' ({e_http!r}) -- repli sur le protocole WebSocket chunké."
                )
                Path(chemin_destination).unlink(missing_ok=True)
                await self._telecharger_fichier_via_websocket(cle, chemin_destination)
                return
            log_reseau_t.info(f"<- téléchargement HTTP direct terminé ('{cle}') -> {chemin_destination}")
            self.telechargement_fichier_resultat.emit(True, cle, "")
            return
        log_reseau_t.info(f"<- téléchargement Drive direct terminé ('{cle}') -> {chemin_destination}")
        self.telechargement_fichier_resultat.emit(True, cle, "")

    async def _envoyer_profil(self, nom_profil: str, chemin_dossier_profil: str, meta: Optional[dict] = None, id_pilote_cible: str = ""):
        """AJOUT (SPEC_upload_profil_drive_direct.md, section 3.1) --
        point d'entrée UNIQUE d'envoi de profil (cf. envoyer_profil,
        méthode publique Qt qui appelle celle-ci), symétrique EXACT de
        _telecharger_fichier pour le sens inverse (upload plutôt que
        download) : tente désormais un upload Drive DIRECT en PREMIER
        (GestionnaireStockageDriveDirect.envoyer_fichier_vers_cloud, même
        classe/identifiants déjà utilisés pour envoyer_serveur_py et la
        migration "Mettre à jour" -- clé de service déjà présente sur
        disque, cf. ReglagesApp.drive_chemin_cle_json_resolu) -- AUCUN
        octet du profil ne transite JAMAIS par serveur.py.

        PATCH (demande explicite utilisateur : "je ne veux jamais que sa
        se replie sur serveurT pour le upload") -- PLUS de repli sur
        l'ancien protocole chunké (_envoyer_profil_via_chunks_serveur,
        conservée dans le fichier pour référence mais n'est plus jamais
        appelée) si l'upload Drive direct échoue (clé de service absente/
        invalide, dossier racine mal configuré, coupure réseau...) :
        l'échec est désormais NET et remonté tel quel (cf. _echec_local),
        jamais masqué par un aiguillage silencieux des octets vers/via
        serverT.

        Convention de clés INCHANGÉE (cf. spec section 2) : un seul
        dossier plat "Profils/" à la racine du bucket, "Profils/<nom>.zip"
        + "Profils/<nom>.meta.json" optionnel -- aucun sous-dossier par
        profil, le dossier "Profils/" lui-même est résolu/créé
        automatiquement au premier upload par _ClientDriveMinimal.

        `id_pilote_cible` (upload demandé à distance par un pilote, cf.
        _sur_upload_profil_vers_cloud_demande côté main_sautoniax) : le
        serveur ne voit jamais les octets du profil -- _notifier_upload_
        profil_resultat (message léger, cf. serveur.py handler notifier_
        upload_profil_resultat) est appelée explicitement pour que le
        pilote distant soit informé du résultat réel (succès), et
        _echec_local appelle envoyer_upload_profil_echec_local en cas
        d'échec -- dans les deux cas, plus jamais "bloqué en cours"
        indéfiniment.

        Progression (envoi_profil_progression) : émise en mode
        indéterminé (-1) pendant tout l'upload Drive direct -- pas de
        progression fine par chunk possible sur ce chemin (put_object est
        un seul appel HTTP synchrone)."""
        def _echec_local(message_erreur: str):
            self.envoi_profil_resultat.emit(False, nom_profil, message_erreur)
            if id_pilote_cible:
                self.envoyer_upload_profil_echec_local(nom_profil, message_erreur)

        loop = asyncio.get_running_loop()

        # --- Phase 1 : compression (déportée, bloquante) -- faite ICI,
        # une seule fois, réutilisée par le chemin Drive direct ET par
        # le repli chunké en cas d'échec (évite de zipper deux fois le
        # même dossier si le repli doit être tenté). ---
        self.envoi_profil_progression.emit(nom_profil, -1)
        try:
            chemin_zip = await loop.run_in_executor(None, _zipper_dossier_profil_diag, chemin_dossier_profil)
        except Exception as e:
            log_reseau_t.warning(f"Échec compression profil '{nom_profil}' : {e!r}")
            _echec_local(f"Échec de la compression : {e}")
            return

        # --- Phase 2 : upload Drive direct (zip + meta.json optionnel) ---
        log_reseau_t.info(f"-> upload Drive direct tenté en premier ('{nom_profil}')")
        try:
            contenu_zip = await loop.run_in_executor(None, chemin_zip.read_bytes)
            cle_zip = f"Profils/{nom_profil}.zip"
            await loop.run_in_executor(
                None, lambda: GestionnaireStockageDriveDirect().envoyer_fichier_vers_cloud(cle_zip, contenu_zip),
            )
            if isinstance(meta, dict) and meta:
                try:
                    cle_meta = f"Profils/{nom_profil}.meta.json"
                    contenu_meta = json.dumps(meta).encode("utf-8")
                    await loop.run_in_executor(
                        None, lambda: GestionnaireStockageDriveDirect().envoyer_fichier_vers_cloud(cle_meta, contenu_meta),
                    )
                except Exception:
                    log_reseau_t.warning(f"upload Drive direct : échec écriture meta.json pour '{nom_profil}' (ignoré)", exc_info=True)
        except Exception as e_drive:
            # PATCH (demande explicite utilisateur : "je ne veux jamais
            # que sa se replie sur serveurT pour le upload") -- PLUS de
            # repli sur _envoyer_profil_via_chunks_serveur ici : un échec
            # de l'upload Drive direct est désormais un échec NET de tout
            # l'envoi, jamais un aiguillage silencieux des octets du
            # profil vers/via serverT. _echec_local gère les DEUX publics
            # (envoi local classique via envoi_profil_resultat, ET upload
            # demandé à distance par un pilote via envoyer_upload_profil_
            # echec_local) -- même fonction déjà utilisée pour l'échec de
            # compression en Phase 1 ci-dessus.
            log_reseau_t.warning(f"Échec upload Drive direct '{nom_profil}' ({e_drive!r}) -- aucun repli serveurT, envoi en échec.")
            _echec_local(f"Échec de l'upload direct vers le cloud : {e_drive}")
            return
        finally:
            chemin_zip.unlink(missing_ok=True)

        # --- Succès Drive direct ---
        taille_octets = len(contenu_zip)
        log_reseau_t.info(f"<- upload Drive direct terminé ('{nom_profil}', {taille_octets} octets)")
        log.info(f"[sAutoniax] '{nom_profil}' envoyé avec succès.")
        self.envoi_profil_resultat.emit(True, nom_profil, "")
        self._notifier_upload_profil_resultat(id_pilote_cible, nom_profil, True, taille_octets=taille_octets)

    async def _envoyer_profil_via_chunks_serveur(self, nom_profil: str, chemin_dossier_profil: str, meta: Optional[dict] = None, id_pilote_cible: str = ""):
        """PLUS APPELÉE (PATCH -- demande explicite utilisateur : "je ne
        veux jamais que sa se replie sur serveurT pour le upload") :
        _envoyer_profil n'invoque plus cette méthode en cas d'échec de
        l'upload Drive direct, elle échoue net à la place. Conservée
        SEULEMENT pour référence/historique -- ne pas la reconnecter sans
        redemander explicitement à l'utilisateur, qui a refusé ce
        comportement.

        Ancienne docstring (chemin principal AVANT la migration Drive
        direct, RENOMMÉE depuis _envoyer_profil, cf. SPEC_upload_profil_
        drive_direct.md section 3.1) -- corps de fonction inchangé :

        Zippe (PATCH -- demande explicite utilisateur : "on effectue
        une copie de ce qui est sur notre machine et on l'envoie ...
        zipper le dossier entier en un seul fichier .zip avant envoi")
        puis envoie le dossier persistant d'un profil vers Profils/
        du bucket, EN CHUNKS de TAILLE_CHUNK_PROFIL_OCTETS (PATCH --
        demande explicite utilisateur : "vraie progression par chunks
        ... % précis pendant l'upload"), avec un accusé de réception
        serveur attendu après CHAQUE chunk avant d'envoyer le suivant --
        cf. serveur.py, handlers envoyer_profil_debut/_chunk/_fin pour
        le protocole exact côté serveur.

        `meta` (PATCH -- Patch 4.3) : cf. docstring de envoyer_profil
        (méthode publique qui appelle celle-ci) -- transmis tel quel dans
        le champ "meta" du message envoyer_profil_fin.

        Émet envoi_profil_progression(nom_profil, -1) pendant la
        compression (durée non prévisible à l'avance -- convention
        "indéterminé"), puis envoi_profil_progression(nom_profil, 0..100)
        après chaque chunk confirmé, et enfin envoi_profil_resultat une
        fois l'upload B2 terminé côté serveur (ou en cas d'échec à
        n'importe quelle étape)."""
        # PATCH (correctif) : self.envoi_profil_resultat (signal LOCAL,
        # utile pour un envoi déclenché depuis CE process -- écouté par
        # MiseAJourStockageScreen/ProfilsCloudScreen) n'a AUCUN écouteur
        # quand cet appel vient de _sur_upload_profil_vers_cloud_demande
        # (upload demandé à distance par un pilote via demander_upload_
        # profil_vers_cloud) -- seul le message "envoyer_profil_fin" (cf.
        # phase 4 plus bas) transporte id_pilote_cible jusqu'au serveur,
        # qui est le SEUL point où le résultat est relayé au pilote
        # distant. Un échec AVANT cette phase (connexion absente,
        # compression, envoyer_profil_debut, un chunk) sortait donc en
        # silence total pour ce pilote -- son bouton "Mettre à jour vers
        # le cloud" restait bloqué "en cours" indéfiniment, sans succès
        # NI message d'erreur. Ce helper relaie systématiquement au
        # pilote distant (best-effort, fire-and-forget -- cf. envoyer_
        # upload_profil_echec_local, même patron) en PLUS d'émettre le
        # signal local existant, sans changer son comportement pour un
        # envoi classique (id_pilote_cible vide -> rien envoyé de plus).
        def _echec(message_erreur: str):
            self.envoi_profil_resultat.emit(False, nom_profil, message_erreur)
            if id_pilote_cible:
                self.envoyer_upload_profil_echec_local(nom_profil, message_erreur)

        if self._ws is None:
            _echec("Non connecté au serveurT.")
            return

        # --- Phase 1 : compression (déportée, bloquante -- cf. docstring
        # _zipper_dossier_profil) ---
        self.envoi_profil_progression.emit(nom_profil, -1)
        try:
            loop = asyncio.get_running_loop()
            chemin_zip = await loop.run_in_executor(None, _zipper_dossier_profil_diag, chemin_dossier_profil)
        except Exception as e:
            log_reseau_t.warning(f"Échec compression profil '{nom_profil}' : {e!r}")
            _echec(f"Échec de la compression : {e}")
            return

        try:
            taille_totale = chemin_zip.stat().st_size
            nb_chunks = max(1, -(-taille_totale // self.TAILLE_CHUNK_PROFIL_OCTETS))  # division entière arrondie au-dessus

            # --- Phase 2 : envoyer_profil_debut ---
            log_reseau_t.info(
                f"-> envoyer_profil_debut envoyé au serveurT ('{nom_profil}', {taille_totale} octets, {nb_chunks} chunk(s))"
            )
            await self._ws.send(json.dumps({
                "type": "envoyer_profil_debut",
                "nom_profil": nom_profil,
                "taille_totale_octets": taille_totale,
                "nb_chunks": nb_chunks,
            }))
            ack_debut = await self._attendre_ack_profil()
            if not ack_debut.get("ok", False):
                erreur = ack_debut.get("erreur", "Erreur inconnue")
                log_reseau_t.warning(f"<- envoi_profil_debut_ack (ok=False, '{nom_profil}') : {erreur}")
                _echec(erreur)
                return

            # --- Phase 3 : chunks, un par un, chacun confirmé avant le
            # suivant (cf. docstring de méthode) ---
            with open(chemin_zip, "rb") as f:
                for index in range(nb_chunks):
                    morceau = f.read(self.TAILLE_CHUNK_PROFIL_OCTETS)
                    contenu_b64 = base64.b64encode(morceau).decode("ascii")
                    await self._ws.send(json.dumps({
                        "type": "envoyer_profil_chunk",
                        "nom_profil": nom_profil,
                        "index": index,
                        "contenu_b64": contenu_b64,
                    }))
                    ack_chunk = await self._attendre_ack_profil()
                    if not ack_chunk.get("ok", False):
                        erreur = ack_chunk.get("erreur", "Erreur inconnue")
                        log_reseau_t.warning(
                            f"<- envoi_profil_chunk_ack (ok=False, '{nom_profil}', index={index}) : {erreur}"
                        )
                        _echec(erreur)
                        return
                    pourcentage = round((index + 1) / nb_chunks * 100)
                    self.envoi_profil_progression.emit(nom_profil, pourcentage)

            # --- Phase 4 : envoyer_profil_fin (upload B2 côté serveur) ---
            # PATCH (Patch 4.3) : "meta" inclus dans ce message uniquement
            # s'il a été fourni (dict non vide) -- cf. serveur.py, qui
            # ignore silencieusement le champ s'il est absent ou invalide.
            # Un appelant historique (avant Patch 4.3, meta=None) envoie
            # donc EXACTEMENT le même message qu'avant ce patch.
            message_fin = {"type": "envoyer_profil_fin", "nom_profil": nom_profil}
            if isinstance(meta, dict) and meta:
                message_fin["meta"] = meta
            if id_pilote_cible:
                message_fin["id_pilote"] = id_pilote_cible
            log_reseau_t.info(
                f"-> envoyer_profil_fin envoyé au serveurT ('{nom_profil}', meta={'oui' if 'meta' in message_fin else 'non'})"
            )
            await self._ws.send(json.dumps(message_fin))
            ack_fin = await self._attendre_ack_profil(timeout_s=120.0)  # upload B2 peut prendre plus longtemps qu'un simple accusé
            if ack_fin.get("ok", False):
                taille = ack_fin.get("taille_octets", 0)
                log_reseau_t.info(f"<- envoi_profil_resultat (ok=True, '{nom_profil}', {taille} octets)")
                self.envoi_profil_resultat.emit(True, nom_profil, "")
            else:
                erreur = ack_fin.get("erreur", "Erreur inconnue")
                log_reseau_t.warning(f"<- envoi_profil_resultat (ok=False, '{nom_profil}') : {erreur}")
                self.envoi_profil_resultat.emit(False, nom_profil, erreur)
        except Exception as e:
            # PATCH (correctif) : _echec() plutôt que le seul signal
            # local ici aussi -- ce bloc couvre notamment un timeout de
            # _attendre_ack_profil APRÈS l'envoi de envoyer_profil_fin
            # (message jamais traité côté serveur, ou sa réponse perdue),
            # cas où le relais normal via "id_pilote" dans ce message n'a
            # justement pas pu avoir lieu. Léger risque de doublon si le
            # serveur AVAIT bien relayé et que seul l'ack de retour s'est
            # perdu -- sans gravité (le pilote distant recevrait alors
            # deux résultats au lieu d'aucun), toujours préférable à un
            # bouton bloqué indéfiniment.
            log_reseau_t.warning(f"Échec envoi profil '{nom_profil}' : {e!r}")
            _echec(str(e))
        finally:
            # Le zip temporaire LOCAL (créé par _zipper_dossier_profil)
            # est toujours supprimé, succès ou échec -- distinct du zip
            # temporaire CÔTÉ SERVEUR (cf. UploadProfilEnCours.nettoyer),
            # les deux sont indépendants.
            chemin_zip.unlink(missing_ok=True)

    async def _envoyer_capture(self, image_b64_png: str, instance_id: str, forcer_qualite_100: bool = False):
        """Envoie une capture au serveurT en un seul message JSON -- PAS
        de chunking (contrairement à _envoyer_profil) : une capture
        d'écran compressée reste largement dans la limite confortable
        d'un message WebSocket, même patron que _envoyer_mise_a_jour_app.

        `forcer_qualite_100` (AJOUT, cf. docstring de envoyer_capture,
        méthode publique appelante) : posé tel quel dans le message JSON
        (`"forcer_qualite_100"`) -- c'est _recompresser_pour_diffusion
        côté serveur.py qui l'interprète (bypass de la préférence de
        qualité du pilote UNIQUEMENT pour cette capture précise, jamais
        une modification de preference_capture elle-même). Absent du
        message (donc absent côté serveur, donc `False` par défaut via
        `.get(...)`) quand ce paramètre vaut False -- comportement
        strictement inchangé pour le streaming normal.

        CORRECTIF (retour utilisateur explicite : "changer le protocole
        de communication pour que ce soit plus fluide") -- l'ancienne
        version appelait TOUJOURS _compresser_capture_webp(qualite=100)
        ici, quel que soit le contenu reçu : décodait le JPEG qualité 80
        déjà produit par la source (cf. camoufox_capturer_frame_reelle/
        capturer_frame_reelle, page.screenshot(type="jpeg", quality=80))
        puis le RÉENCODAIT en WebP qualité 100 avant envoi. Un réencodage
        quasi sans perte (qualité 100) d'un JPEG déjà compressé à 80 ne
        peut, par construction, jamais réduire la taille du fichier en
        dessous de sa taille JPEG d'origine -- confirmé par les logs
        réels observés : ratio de compression régulièrement >100% (ex.
        "129.6%", un fichier 210 844 -> 273 230 octets, donc PLUS gros
        après "compression"). Ce réencodage coûtait un aller-retour
        Pillow (CPU, executor) et alourdissait chaque frame envoyée,
        pour AUCUN gain de fidélité (le JPEG q80 source reste la limite
        réelle de qualité de toute façon, WebP q100 ne fait que
        l'emballer différemment).

        Le JPEG source est donc envoyé TEL QUEL désormais -- decoder_
        image_b64 (QImage.loadFromData) et _recompresser_pour_diffusion
        (PILImage.open) détectent tous deux le format automatiquement
        via les en-têtes du fichier, aucun des deux ne suppose que
        l'image reçue est nécessairement du WebP : rien à changer côté
        réception, pilote ou serveurT, pour ce changement. Si un pilote
        demande une qualité de diffusion < 100, _recompresser_pour_
        diffusion continue de décoder puis réencoder normalement --
        cette fois à partir d'un JPEG plus léger au départ plutôt que
        d'un WebP artificiellement gonflé, donc strictement plus rapide
        et moins coûteux en CPU sur ce chemin aussi."""
        if self._ws is None:
            log_reseau_t.warning("_envoyer_capture : non connecté au serveurT -- capture perdue.")
            return
        try:
            image_b64_webp = image_b64_png
            message = {
                "type": "envoyer_capture",
                "instance_id": instance_id,
                "image_b64": image_b64_webp,
            }
            if forcer_qualite_100:
                message["forcer_qualite_100"] = True
            if getattr(self, "_prio_fin", 0) > 0:
                return  # PRIORITE FIN : capture abandonnée (obsolète), signal de fin en cours
            await self._ws.send(json.dumps(message))
            # PATCH (demande explicite utilisateur : "remet le logs des
            # cpature ... mais je veu que leur frequece daffichage chute
            # aussi drastiquement" -- réactivé en .info après avoir été
            # passé en .debug, cf. l'ancien commentaire ci-dessus resté
            # pour l'historique) -- THROTTLÉ à DELAI_THROTTLE_LOGS_
            # CAPTURE_SECONDES par instance_id (cf. son __init__) : compte
            # les captures envoyées depuis le dernier log affiché pour
            # CETTE instance, et n'affiche qu'un résumé "N captures
            # envoyées, taille de la dernière" une fois l'intervalle
            # écoulé -- jamais une ligne par frame individuelle, même en
            # capture continue plusieurs fps.
            maintenant = time.monotonic()
            derniere_fois, compte = self._dernier_log_capture_par_instance.get(instance_id, (0.0, 0))
            compte += 1
            if maintenant - derniere_fois >= self.DELAI_THROTTLE_LOGS_CAPTURE_SECONDES:
                log_reseau_t.info(
                    f"-> envoyer_capture : {compte} capture(s) envoyée(s) au serveurT sur les "
                    f"{self.DELAI_THROTTLE_LOGS_CAPTURE_SECONDES:.0f} dernières secondes "
                    f"(instance_id={instance_id!r}, dernière = {len(image_b64_webp)} octets b64)"
                )
                self._dernier_log_capture_par_instance[instance_id] = (maintenant, 0)
            else:
                self._dernier_log_capture_par_instance[instance_id] = (derniere_fois, compte)
        except Exception as e:
            log_reseau_t.warning(f"Échec envoi capture (instance_id={instance_id!r}) : {e!r}")

    async def _envoyer_lister_stockage(self):
        """Demande au serveurT la liste brute des clés du bucket
        configuré -- cf. StockageCloudScreen, bouton "Actualiser". Le
        résultat (liste de clés OU erreur) arrive de façon asynchrone
        via _traiter_message (réponse "stockage_liste" du serveur)."""
        if self._ws is None:
            self.stockage_liste_resultat.emit(False, [], "Non connecté au serveurT.")
            return
        try:
            log_reseau_t.info("-> lister_stockage envoyé au serveurT")
            await self._ws.send(json.dumps({"type": "lister_stockage"}))
        except Exception as e:
            log_reseau_t.warning(f"Échec envoi lister_stockage : {e!r}")
            self.stockage_liste_resultat.emit(False, [], str(e))

    async def _envoyer_supprimer_stockage(self, cles: list):
        """Demande au serveurT de supprimer UN OU PLUSIEURS éléments du
        bucket configuré en un seul appel -- cf. StockageCloudScreen,
        clic-droit "Supprimer" sur une ligne de l'arborescence (fichier
        individuel = une clé, dossier reconstruit ou série groupée =
        plusieurs, cf. PATCH "je veux aussi que même les dossiers
        puissent supprimer"). Le résultat arrive de façon asynchrone
        via _traiter_message (réponse "stockage_supprimer_resultat" du
        serveur), même patron que _envoyer_lister_stockage juste
        au-dessus."""
        if self._ws is None:
            self.stockage_supprimer_resultat.emit(False, cles, "Non connecté au serveurT.")
            return
        try:
            log_reseau_t.info(f"-> supprimer_stockage envoyé au serveurT ({len(cles)} clé(s))")
            await self._ws.send(json.dumps({"type": "supprimer_stockage", "cles": cles}))
        except Exception as e:
            log_reseau_t.warning(f"Échec envoi supprimer_stockage ({len(cles)} clé(s)) : {e!r}")
            self.stockage_supprimer_resultat.emit(False, cles, str(e))

