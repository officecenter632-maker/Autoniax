    async def _envoyer_retour_projet_execute(self, session_id: str, id_pilote: str, chemin_dossier_projet: str, nom_projet: str = ""):
        """Côté EXÉCUTANT -- symétrique de _envoyer_projet_vers_sautoniax,
        sens inverse (Patch 4.4.d). Pas de Future d'accusé attendue ici :
        le sAutoniax n'a pas d'UI à bloquer en attendant confirmation,
        contrairement au pilote -- envoi best-effort, chunk par chunk,
        sans attendre d'ack entre eux (le serveur relaie sans stocker,
        rien à confirmer d'utile côté sAutoniax au-delà de l'envoi
        WebSocket réussi lui-même).

        PATCH E.2 -- `nom_projet` est un paramètre PUREMENT informatif
        transporté jusqu'au serveurT (cf. son handler retour_projet_
        execute_fin) pour qu'il puisse nommer lisiblement l'entrée
        "Batch Traité" archivée sur B2 (ex. "MonProjet — 20260819T..." au
        lieu d'un session_id opaque). Absence tolérée (chaîne vide) --
        le serveur retombe alors sur un nom générique, jamais une raison
        de bloquer l'envoi du résultat lui-même."""
        try:
            loop = asyncio.get_running_loop()
            chemin_zip = await loop.run_in_executor(None, _zipper_dossier_profil, chemin_dossier_projet)
        except Exception as e:
            log_reseau_t.warning(f"Échec compression retour projet (session={session_id}) : {e!r}")
            return
        try:
            taille_totale = chemin_zip.stat().st_size
            nb_chunks = max(1, -(-taille_totale // self.TAILLE_CHUNK_RELAIS_OCTETS))
            await self._ws.send(json.dumps({
                "type": "retour_projet_execute_debut", "session_id": session_id,
                "id_pilote": id_pilote, "nb_chunks": nb_chunks,
            }))
            with open(chemin_zip, "rb") as f:
                for index in range(nb_chunks):
                    morceau = f.read(self.TAILLE_CHUNK_RELAIS_OCTETS)
                    await self._ws.send(json.dumps({
                        "type": "retour_projet_execute_chunk", "session_id": session_id,
                        "id_pilote": id_pilote, "index": index,
                        "contenu_b64": base64.b64encode(morceau).decode("ascii"),
                    }))
            await self._ws.send(json.dumps({
                "type": "retour_projet_execute_fin", "session_id": session_id, "id_pilote": id_pilote,
                "nom_projet": nom_projet,
            }))
            log_reseau_t.info(f"<- retour projet exécuté envoyé (session={session_id}, {nb_chunks} chunk(s))")
        except Exception as e:
            log_reseau_t.warning(f"Échec envoi retour projet exécuté (session={session_id}) : {e!r}")
        finally:
            chemin_zip.unlink(missing_ok=True)

    async def _tache_moniteur_boucle(self):
        """DIAG latence : détecte un blocage de la boucle asyncio réseau (si elle gèle, plus rien n'est lu sur le WebSocket)."""
        while True:
            _t = time.monotonic()
            await asyncio.sleep(0.1)
            _lag = time.monotonic() - _t - 0.1
            if _lag > 0.5:
                log_reseau_t.warning(f"[LAG-BOUCLE] boucle asyncio réseau bloquée pendant {_lag:.2f}s (rien n'a été lu sur le WebSocket pendant ce temps)")

    async def _tache_heartbeat(self):
        """PATCH heartbeat (cf. DELAI_HEARTBEAT_SECONDES) -- envoie un
        message applicatif {"type": "ping"} toutes les
        DELAI_HEARTBEAT_SECONDES tant que la connexion WebSocket est
        vivante. Diagnostic d'origine (demande explicite utilisateur :
        "pourquoi sa cest déconnecter ?") : aucun trafic applicatif ne
        circule pendant les périodes d'inactivité (ex. capture
        automatique désactivée, fps=0), et le proxy/infra de Render
        (hébergeur du serveurT) coupe alors la connexion WebSocket
        silencieuse au bout d'un court délai -- le ping/pong natif du
        protocole WebSocket (frames de contrôle, géré automatiquement
        par la lib `websockets`) ne suffit pas car certains proxys
        intermédiaires ne relaient/respectent pas ces frames, seul un
        vrai message JSON (data frame applicative) est fiable.

        Lancée en tâche de fond par _boucle_async juste après connexion
        + register réussis, EN PARALLÈLE de la boucle `async for brut in
        self._ws`, et annulée dans le `finally` correspondant -- cf.
        docstring de _boucle_async. Boucle indéfiniment (jusqu'à
        annulation) : ce n'est PAS une boucle avec retry, la moindre
        exception d'envoi signifie que la connexion est déjà morte, donc
        on s'arrête immédiatement plutôt que de logger une erreur en
        boucle -- la boucle de réception externe (_boucle_async) détecte
        de toute façon la coupure de son côté (ConnectionClosed) et
        relancera une nouvelle tâche heartbeat à la prochaine
        reconnexion.

        BUGFIX (cf. DELAI_TIMEOUT_PONG_SECONDES) -- un send() réussi ne
        prouve PAS que la connexion est vivante côté serveur (cf.
        docstring complète du bug corrigé sur DELAI_TIMEOUT_PONG_
        SECONDES) : après chaque ping envoyé avec succès, on attend
        maintenant explicitement qu'un pong soit arrivé (_dernier_pong_
        recu mis à jour par _traiter_message) dans les DELAI_TIMEOUT_
        PONG_SECONDES qui suivent -- sinon, la connexion est considérée
        morte et fermée de force (self._ws.close()), ce qui fait lever
        ConnectionClosed dans la boucle `async for` de _boucle_async et
        relance son cycle de retry déjà existant, exactement comme une
        vraie coupure réseau détectée nativement.

        CORRECTIF RADICAL (retour utilisateur explicite -- cf. docstring
        complète de self._transferts_chunk_actifs dans __init__) --
        AUCUNE taille de chunk n'est fiable à 100% face à ce mécanisme :
        un pong peut TOUJOURS arriver en retard derrière un gros message
        encore en transit sur la même connexion, quelle que soit la
        marge choisie pour DELAI_TIMEOUT_PONG_SECONDES.

        CORRECTIF (suite -- régression découverte au test du correctif
        ci-dessus : suspendre ENTIÈREMENT le ping pendant un transfert
        coupait tout trafic applicatif dans le sens client -> serveur
        pour toute la durée du transfert, ce qui a fini par faire tomber
        la connexion quand même -- pas via CE mécanisme de pong (qui,
        lui, ne fermait plus rien), mais par un autre acteur en amont
        (tunnel/infra) qui a interprété ce silence prolongé côté client
        comme une connexion morte, exactement le scénario que ce
        heartbeat existe pour prévenir en premier lieu -- cf. docstring
        de classe). Le ping continue donc d'être envoyé normalement à
        CHAQUE cycle, transfert actif ou non -- un ping est un tout petit
        message, il n'est pas concerné par la lenteur de transit d'un
        gros chunk, rien ne l'empêche de partir. Seule la RÉACTION à un
        pong absent change : si un transfert est actif, un pong en
        retard ou manquant à l'issue du délai n'entraîne PLUS la
        fermeture de la connexion (juste un WARNING) -- c'est. UNIQUEMENT
        cette fermeture prématurée sur un pong simplement ralenti par la
        congestion du transfert qui posait problème, jamais l'envoi du
        ping lui-même.
        """
        try:
            while True:
                await asyncio.sleep(self.DELAI_HEARTBEAT_SECONDES)
                if self._ws is None:
                    return
                horodatage_avant_envoi = time.monotonic()
                try:
                    await self._ws.send(json.dumps({"type": "ping"}))
                    log_reseau_t.debug("-> ping")
                except Exception as e:
                    log_reseau_t.debug(f"Échec envoi ping (connexion probablement déjà coupée) : {e!r}")
                    return
                # BUGFIX -- attend DELAI_TIMEOUT_PONG_SECONDES, en
                # vérifiant périodiquement (pas un seul sleep bloquant
                # unique) si un pong POSTÉRIEUR à CET envoi est arrivé
                # entre-temps -- _dernier_pong_recu peut déjà contenir un
                # timestamp d'un pong ANTÉRIEUR (réponse au ping
                # précédent), d'où la comparaison stricte avec
                # horodatage_avant_envoi plutôt qu'un simple "is not None".
                # Sort dès qu'un pong valide arrive, pas la peine
                # d'attendre le plein délai à chaque cycle.
                delai_ecoule = 0.0
                intervalle_verification = 1.0
                while delai_ecoule < self.DELAI_TIMEOUT_PONG_SECONDES:
                    await asyncio.sleep(intervalle_verification)
                    delai_ecoule += intervalle_verification
                    if self._ws is None:
                        return
                    if self._dernier_pong_recu is not None and self._dernier_pong_recu >= horodatage_avant_envoi:
                        break
                else:
                    # CORRECTIF RADICAL (cf. docstring ci-dessus) -- un
                    # transfert en chunks actif explique à lui seul un
                    # pong en retard (congestion sur cette même
                    # connexion, cf. le mécanisme documenté en tête de
                    # méthode) : ne JAMAIS fermer la connexion dans ce
                    # cas, seulement le signaler. Le ping suivant, dans
                    # DELAI_HEARTBEAT_SECONDES, retentera normalement.
                    if self._transferts_chunk_actifs > 0:
                        log_reseau_t.debug(
                            f"Aucun pong reçu depuis {self.DELAI_TIMEOUT_PONG_SECONDES:.0f}s, mais "
                            f"{self._transferts_chunk_actifs} transfert(s) en chunks actif(s) -- "
                            "pong probablement juste retardé par la congestion, pas de fermeture."
                        )
                        continue
                    log_reseau_t.warning(
                        f"Aucun pong reçu du serveurT depuis {self.DELAI_TIMEOUT_PONG_SECONDES:.0f}s "
                        "(connexion probablement zombie -- ex. serveurT redémarré derrière le même "
                        "tunnel) -- fermeture forcée pour déclencher une reconnexion."
                    )
                    with contextlib.suppress(Exception):
                        await self._ws.close()
                    return
        except asyncio.CancelledError:
            raise
        except asyncio.CancelledError:
            raise


    def _traiter_message(self, brut: str):
        _sync_diag_t_entree = time.time()  # [SYNC-DIAG]
        try:
            data = json.loads(brut)
        except json.JSONDecodeError:
            log_reseau_t.warning(f"Message non-JSON reçu du serveurT : {brut[:100]!r}")
            return
        if isinstance(data.get("t_srv_envoi"), (int, float)) and data.get("type") != "morceau":
            _d = time.time() - data["t_srv_envoi"]
            if _d > 0.5:
                log_reseau_t.warning(f"[LAG-RECEPTION] {data.get('type')} : {_d:.2f}s entre l'envoi du serveurT et l'arrivée ici (horloges serveur/pilote supposées synchrones)")
        # PATCH PRIORITE FIN -- gros messages reçus par morceaux (cf. _envoyer_par_morceaux) :
        # on réassemble, puis on retraite le message d'origine comme s'il était arrivé d'un bloc.
        if data.get("type") == "morceau":
            if not hasattr(self, "_morceaux_en_cours"):
                self._morceaux_en_cours = {}
            _tampon = self._morceaux_en_cours.setdefault(data.get("mid"), {})
            _tampon[data.get("i")] = data.get("d", "")
            if len(_tampon) >= data.get("n", 1):
                self._morceaux_en_cours.pop(data.get("mid"), None)
                _complet = "".join(_tampon[_i] for _i in range(data.get("n", 1)))
                _ex = data.get("id_executant")
                if _ex and _complet.startswith("{"):
                    _complet = '{"id_executant": ' + json.dumps(_ex) + ", " + _complet[1:]
                self._traiter_message(_complet)
            return
        # PATCH heartbeat (cf. DELAI_HEARTBEAT_SECONDES/_tache_heartbeat)
        # -- réponse du serveur à notre "ping" périodique. Rien à faire
        # de spécial : le seul but de l'aller-retour ping/pong est de
        # maintenir un trafic applicatif régulier pour empêcher la
        # coupure de connexion par un proxy intermédiaire pendant les
        # périodes d'inactivité -- traité en tout premier (avant même
        # register_ok) pour ne pas dépendre de l'ordre du reste de la
        # chaîne if/elif. Loggé en debug (pas info) : un message toutes
        # les DELAI_HEARTBEAT_SECONDES ne doit pas polluer les logs
        # normaux, même raison que le passage de _compresser_capture_webp
        # de .info à .debug ci-dessus.
        if self._noter_vie_session(data):   # côté pilote : signe de vie d'un clone (« sessions_vivantes » traité ici)
            return
        if data.get("type") == "pong":
            log_reseau_t.debug("<- pong")
            # BUGFIX (cf. DELAI_TIMEOUT_PONG_SECONDES/_tache_heartbeat) --
            # marque cette connexion comme réellement vivante (pas
            # seulement "socket local ouvert", cf. leurs docstrings pour
            # le scénario exact corrigé). time.monotonic() : jamais affecté
            # par un changement d'horloge système, seule mesure fiable pour
            # un delta de timeout.
            self._dernier_pong_recu = time.monotonic()
            return
        if data.get("type") == "register_ok":
            # CORRECTIF (cf. docstring du signal id_serveur_recu) :
            # mémorise l'id_connexion attribué par le serveurT et le
            # republie via id_serveur_recu -- jusqu'ici ce message était
            # silencieusement ignoré (aucune branche ne le traitait),
            # d'où l'instance_id local ("sautoniax") jamais aligné sur
            # l'id_executant utilisé par le pilote dans ses demandes de
            # capture. Réémis à CHAQUE reconnexion (id_connexion recréé
            # par le serveur à chaque nouvelle connexion WebSocket,
            # cf. Connexion, donc potentiellement différent après une
            # coupure) -- pas seulement au premier register.
            id_recu = data.get("id", "")
            self._id_serveur = id_recu
            log_reseau_t.info(f"<- register_ok (id={id_recu!r})")
            self.id_serveur_recu.emit(id_recu)
        elif data.get("type") == "erreur":
            # PATCH (identité stable par nom, cf. docstring de register_
            # refuse) -- réponse du serveur à notre PROPRE "register",
            # PAS un message applicatif ordinaire : ni exécutants_
            # connectes ni executant_silencieux ne seront jamais émis
            # après ça pour cette connexion (le serveur n'a pas ajouté
            # cette connexion au registre, cf. `continue` juste avant
            # l'envoi côté serveur.py). Loggé en ERROR (pas warning) :
            # contrairement à executant_silencieux (anomalie transitoire,
            # peut se résoudre seule), un register refusé ne se résoudra
            # JAMAIS tout seul par une simple reconnexion.
            message_erreur = data.get("message", "(raison inconnue)")
            log_reseau_t.error(f"<- erreur (register refusé) : {message_erreur}")
            self.register_refuse.emit(message_erreur)
        elif data.get("type") in ("transit_attribue", "transit_libere"):
            # AJOUT (Transit Drive, cf. transit_demander_zip / transit_liberer_zip) -- réponse du serveurT à une demande
            # faite par ce client : réveille l'appelant bloqué, corrélé par « rid ». Un rid inconnu (appelant déjà
            # parti sur timeout) est ignoré.
            _futur_transit = self.__dict__.get("_transit_attentes", {}).get(data.get("rid"))
            if _futur_transit is not None and not _futur_transit.done():
                _futur_transit.set_result(data)
        elif data.get("type") == "executants_connectes":
            executants = data.get("executants", [])
            log_reseau_t.info(f"<- executants_connectes ({len(executants)})")
            self.nombre_executants_change.emit(len(executants))
            # PATCH (Patch 4.2) -- le message porte désormais aussi le
            # statut détaillé par sAutoniax (cf. Connexion.vers_dict côté
            # serveurT) ; nombre_executants_change reste émis ci-dessus,
            # inchangé, pour ne rien casser côté InstancesConnecteesScreen
            # existant -- ce nouveau signal est un AJOUT pur.
            self.executants_detail_change.emit(executants)
        elif data.get("type") == "executant_silencieux":
            # PATCH (watchdog exécutants silencieux) -- alerte poussée
            # par le serveurT (cf. _boucle_watchdog_executants côté
            # serveur.py), PAS une réponse à une demande du pilote :
            # arrive de façon asynchrone, à tout moment, dès qu'un
            # exécutant connecté n'a plus rien envoyé (heartbeat compris)
            # depuis SEUIL_SILENCE_SUSPECT_SECONDES. WARNING (pas info) :
            # c'est une anomalie potentielle à surveiller, même logique
            # que "Connexion serveurT fermée" plus haut dans ce fichier.
            id_executant = data.get("id_executant", "")
            nom_executant = data.get("nom", "") or id_executant
            silence_secondes = data.get("silence_secondes", 0.0)
            log_reseau_t.warning(
                f"<- executant_silencieux : '{nom_executant}' (id={id_executant}) "
                f"silencieux depuis {silence_secondes:.0f}s -- process potentiellement "
                f"gelé/bloqué côté sAutoniax, ou coupure réseau non détectée par le "
                f"WebSocket lui-même."
            )
            self.executant_silencieux_recu.emit(id_executant, nom_executant, float(silence_secondes))
        elif data.get("type") == "stockage_configure":
            ok = data.get("ok", False)
            message = data.get("erreur", "") if not ok else ""
            log_reseau_t.info(f"<- stockage_configure (ok={ok})")
            self.stockage_configure_resultat.emit(ok, message)
        # RETRAIT (migration "Mettre à jour" vers Drive direct) : le
        # bloc dispatcher pour ("mettre_a_jour_app_debut_ack",
        # "mettre_a_jour_app_chunk_ack", "app_mise_a_jour") a été retiré
        # -- ces accusés répondaient au protocole en chunks mettre_a_
        # jour_app_debut/_chunk/_fin, plus jamais envoyé par ce pilote
        # (cf. _envoyer_mise_a_jour_app) ni jamais renvoyé par serveur.py
        # (handlers retirés côté serveur, coupure nette des deux côtés).
        elif data.get("type") == "stockage_liste":
            ok = data.get("ok", False)
            if ok:
                # PATCH (taille des fichiers .py affichée à côté d'eux
                # dans l'onglet Stockage cloud) -- "objets" contient
                # désormais {"cle": ..., "taille_octets": ...} par
                # élément (serveur.py, lister_avec_taille). Repli sur
                # "cles" (taille_octets=None par élément) si un
                # serveurT plus ancien, sans ce PATCH, ne renvoie que
                # l'ancien format -- l'arborescence reste affichable,
                # juste sans les tailles.
                objets = data.get("objets")
                if objets is None:
                    cles = data.get("cles", [])
                    objets = [{"cle": c, "taille_octets": None} for c in cles]
                log_reseau_t.info(f"<- stockage_liste (ok=True, {len(objets)} clé(s))")
                self.stockage_liste_resultat.emit(True, objets, "")
            else:
                erreur = data.get("erreur", "Erreur inconnue")
                log_reseau_t.warning(f"<- stockage_liste (ok=False) : {erreur}")
                self.stockage_liste_resultat.emit(False, [], erreur)
        elif data.get("type") == "stockage_supprimer_resultat":
            ok = data.get("ok", False)
            cles = data.get("cles", [])
            if ok:
                log_reseau_t.info(f"<- stockage_supprimer_resultat (ok=True, {len(cles)} clé(s))")
                self.stockage_supprimer_resultat.emit(True, cles, "")
            else:
                erreur = data.get("erreur", "Erreur inconnue")
                log_reseau_t.warning(f"<- stockage_supprimer_resultat (ok=False, {len(cles)} clé(s)) : {erreur}")
                self.stockage_supprimer_resultat.emit(False, cles, erreur)
        elif data.get("type") == "meta_profil_maj_resultat":
            ok = data.get("ok", False)
            nom_profil = data.get("nom_profil", "")
            champ = data.get("champ", "")
            valeur = bool(data.get("valeur", False))
            if ok:
                log_reseau_t.info(f"<- meta_profil_maj_resultat (ok=True, '{nom_profil}'.{champ}={valeur})")
                self.meta_profil_maj_resultat.emit(True, nom_profil, champ, valeur, "")
            else:
                erreur = data.get("erreur", "Erreur inconnue")
                log_reseau_t.warning(f"<- meta_profil_maj_resultat (ok=False, '{nom_profil}'.{champ}) : {erreur}")
                self.meta_profil_maj_resultat.emit(False, nom_profil, champ, valeur, erreur)
        elif data.get("type") == "renommer_profil_cloud_resultat":
            ok = data.get("ok", False)
            ancien_nom = data.get("ancien_nom", "")
            nouveau_nom = data.get("nouveau_nom", "")
            if ok:
                log_reseau_t.info(f"<- renommer_profil_cloud_resultat (ok=True, '{ancien_nom}' -> '{nouveau_nom}')")
                self.renommer_profil_cloud_resultat.emit(True, ancien_nom, nouveau_nom, "")
            else:
                erreur = data.get("erreur", "Erreur inconnue")
                log_reseau_t.warning(f"<- renommer_profil_cloud_resultat (ok=False, '{ancien_nom}' -> '{nouveau_nom}') : {erreur}")
                self.renommer_profil_cloud_resultat.emit(False, ancien_nom, nouveau_nom, erreur)
        elif data.get("type") in ("envoi_profil_debut_ack", "envoi_profil_chunk_ack", "envoi_profil_resultat"):
            # PATCH (bloc "Envoyer un profil" -- protocole en chunks).
            # _envoyer_profil ATTEND chacun de ces 3 accusés avant de
            # continuer (cf. _attendre_ack_profil) -- on résout juste la
            # Future en cours avec le dict complet, toute l'interprétation
            # (ok/erreur/index/taille_octets) reste dans _envoyer_profil
            # pour ne pas dupliquer cette logique ici. Un accusé reçu
            # alors qu'aucune Future n'est en attente (ex. timeout déjà
            # écoulé côté _envoyer_profil, ou accusé en double) est
            # simplement ignoré -- pas une erreur.
            if self._future_ack_profil is not None and not self._future_ack_profil.done():
                self._future_ack_profil.set_result(data)
        elif data.get("type") in ("telechargement_fichier_debut_ack", "telechargement_fichier_chunk_ack"):
            # PATCH (protocole de téléchargement générique, sens inverse)
            # -- miroir exact du bloc envoi_profil_*_ack ci-dessus, pour
            # _future_ack_telechargement plutôt que _future_ack_profil
            # (cf. docstring de sa déclaration dans __init__).
            #
            # BUGFIX (cf. docstring de self._attente_cle_telechargement/
            # _attente_index_chunk_telechargement) : vérifie désormais
            # que cet ack correspond bien à la requête EN COURS avant de
            # résoudre la Future -- un ack en retard pour une AUTRE clé
            # (ou, pour un chunk_ack, un AUTRE index) est ignoré ici,
            # exactement comme un accusé reçu sans Future en attente
            # (ex. timeout déjà écoulé) l'est déjà juste au-dessus pour
            # _future_ack_profil : ni l'un ni l'autre n'est une erreur en
            # soi, juste une réponse qui n'a plus de destinataire valide.
            cle_recue = data.get("cle")
            if self._attente_cle_telechargement is not None and cle_recue != self._attente_cle_telechargement:
                log_reseau_t.warning(
                    f"<- {data.get('type')} ignoré : clé inattendue ('{cle_recue}' reçu, "
                    f"'{self._attente_cle_telechargement}' attendu) -- probablement un ack en retard "
                    f"d'une requête déjà abandonnée par timeout."
                )
                return
            if (
                data.get("type") == "telechargement_fichier_chunk_ack"
                and self._attente_index_chunk_telechargement is not None
                and data.get("index") != self._attente_index_chunk_telechargement
            ):
                log_reseau_t.warning(
                    f"<- telechargement_fichier_chunk_ack ignoré : index inattendu "
                    f"({data.get('index')!r} reçu, {self._attente_index_chunk_telechargement!r} attendu) "
                    f"pour '{cle_recue}' -- probablement un ack en retard."
                )
                return
            if self._future_ack_telechargement is not None and not self._future_ack_telechargement.done():
                self._future_ack_telechargement.set_result(data)
        elif data.get("type") == "capture_recue":
            # PATCH (mode sAutoniax -- demande explicite utilisateur :
            # "la capture envoyer au serveurT, le serveurT evoie
            # directement a mautoniax sur forme de messae de reception").
            # Reçu uniquement côté PILOTE (le serveurT ne relaie ce
            # message qu'aux connexions role="pilote", cf. serveur.py) --
            # simple relais vers ReceptionScreen via ce signal, aucune
            # interprétation/état conservé ici.
            id_executant = data.get("id_executant", "")
            nom_executant = data.get("nom_executant", "")
            instance_id = data.get("instance_id", "")
            image_b64 = data.get("image_b64", "")
            # PATCH (demande utilisateur explicite -- même raison que les
            # logs 'envoyer_capture'/'téléchargement profil' côté
            # sAutoniax) -- passé en DEBUG (pas supprimé) : une ligne par
            # capture reçue, très bruyant en mode capture continue.
            # Réactivable via le niveau de logging.
            log_reseau_t.info(
                f"<- capture_recue (exécutant='{nom_executant}', id_executant={id_executant!r}, instance_id={instance_id!r}, {len(image_b64)} octets b64)"
            )
            self.capture_recue.emit(id_executant, nom_executant, instance_id, image_b64)

        # ------------------------------------------------------------------
        # PATCH (Patch 4.9) -- dispatch entrant des 6 nouveaux messages de
        # protocole. Chaque bloc gère le sens PILOTE (accusés/résultats
        # reçus en réponse à une action déclenchée par ce même client) ET
        # le sens EXÉCUTANT (ordres/transferts reçus depuis un pilote,
        # relayés tel quel par le serveurT) quand les deux existent pour
        # ce message -- cf. docstrings des Signal correspondants
        # (déclarés juste avant DELAI_RETRY_SECONDES) pour la signature
        # exacte émise dans chaque cas.
        # ------------------------------------------------------------------

        elif data.get("type") == "kill_projet_ack":
            # Côté PILOTE -- réponse à kill_projet(). ok=True confirme
            # seulement que l'ORDRE a été transmis au sAutoniax visé (cf.
            # docstring serveur.py) -- pas que le projet est déjà arrêté,
            # ça redescendra séparément via statut_executant.
            ok = data.get("ok", False)
            id_executant = data.get("id_executant", "")
            erreur = data.get("erreur", "")
            if ok:
                log_reseau_t.info(f"<- kill_projet_ack (ok=True, id_executant={id_executant!r})")
            else:
                log_reseau_t.warning(f"<- kill_projet_ack (ok=False, id_executant={id_executant!r}) : {erreur}")
            self.kill_projet_resultat.emit(ok, id_executant, erreur)

        elif data.get("type") == "kill_projet":
            # Côté EXÉCUTANT -- ordre de kill reçu du pilote (relayé tel
            # quel par le serveurT, cf. handler kill_projet ci-dessus côté
            # serveur : {"type": "kill_projet"} sans autre champ). Signal
            # sans paramètre (cf. sa docstring) : main_sautoniax est seul
            # responsable d'interpréter "le projet en cours, quel qu'il
            # soit".
            log_reseau_t.info("<- kill_projet reçu du pilote")
            self.kill_projet_demande.emit()

        elif data.get("type") == "redemarrer_executant_ack":
            # Côté PILOTE -- réponse à redemarrer_executant(). Même
            # contrat que kill_projet_ack (ok=True confirme seulement la
            # TRANSMISSION de l'ordre, pas que le redémarrage a eu lieu).
            ok = data.get("ok", False)
            id_executant = data.get("id_executant", "")
            erreur = data.get("erreur", "")
            if ok:
                log_reseau_t.info(f"<- redemarrer_executant_ack (ok=True, id_executant={id_executant!r})")
            else:
                log_reseau_t.warning(f"<- redemarrer_executant_ack (ok=False, id_executant={id_executant!r}) : {erreur}")
            self.redemarrer_executant_resultat.emit(ok, id_executant, erreur)

        elif data.get("type") == "redemarrer_executant":
            # Côté EXÉCUTANT -- ordre de redémarrage reçu du pilote
            # (relayé tel quel par le serveurT). Signal sans paramètre,
            # même patron que kill_projet_demande -- main_sautoniax est
            # seul responsable d'interpréter "ferme proprement et quitte
            # avec un code de sortie distinct, pour que la boucle de
            # supervision du notebook Kaggle sache qu'il doit retélécharger
            # AutoniaX.py et relancer, plutôt que de traiter ça comme un
            # crash".
            log_reseau_t.info("<- redemarrer_executant reçu du pilote")
            self.redemarrer_executant_demande.emit()

        elif data.get("type") == "kill_profil_ack":
            # Côté PILOTE -- réponse à kill_profil()/redemarrer_profil().
            # Même contrat que kill_projet_ack (ok=True confirme
            # seulement la TRANSMISSION à l'exécutant visé) -- "redemarrer"
            # distingue quel signal ré-émettre, cf. serveur.py handler
            # kill_profil qui relaie ce même champ tel quel dans son ack.
            ok = data.get("ok", False)
            id_executant = data.get("id_executant", "")
            nom_profil = data.get("nom_profil", "")
            redemarrer = data.get("redemarrer", False)
            erreur = data.get("erreur", "")
            if ok:
                log_reseau_t.info(f"<- kill_profil_ack (ok=True, id_executant={id_executant!r}, nom_profil={nom_profil!r}, redemarrer={redemarrer})")
            else:
                log_reseau_t.warning(f"<- kill_profil_ack (ok=False, id_executant={id_executant!r}, nom_profil={nom_profil!r}) : {erreur}")
            if redemarrer:
                self.redemarrer_profil_resultat.emit(ok, id_executant, nom_profil, erreur)
            else:
                self.kill_profil_resultat.emit(ok, id_executant, nom_profil, erreur)

        elif data.get("type") == "kill_profil":
            # Côté EXÉCUTANT -- ordre d'arrêt/redémarrage CIBLÉ sur un
            # profil précis, relayé tel quel par le serveurT (cf. handler
            # kill_profil côté serveur). Signal (nom_profil, redemarrer) --
            # main_sautoniax route vers l'orchestrateur actif (cf.
            # _sur_kill_profil_demande, même patron que _sur_kill_projet_
            # demande mais ciblé).
            nom_profil = data.get("nom_profil", "")
            redemarrer = data.get("redemarrer", False)
            log_reseau_t.info(f"<- kill_profil reçu du pilote (nom_profil={nom_profil!r}, redemarrer={redemarrer})")
            self.kill_profil_demande.emit(nom_profil, redemarrer)

        elif data.get("type") == "kill_profil_resultat_reel":
            # Côté PILOTE -- résultat RÉEL de l'action (cf. docstring du
            # signal kill_profil_resultat_reel_recu), relayé par le
            # serveur avec id_executant ajouté (cf. serveur.py).
            id_executant = data.get("id_executant", "")
            nom_profil = data.get("nom_profil", "")
            redemarrer = data.get("redemarrer", False)
            ok = data.get("ok", False)
            message = data.get("message", "")
            log_reseau_t.info(
                f"<- kill_profil_resultat_reel (id_executant={id_executant!r}, nom_profil={nom_profil!r}, "
                f"redemarrer={redemarrer}, ok={ok}) : {message}"
            )
            self.kill_profil_resultat_reel_recu.emit(id_executant, nom_profil, redemarrer, ok, message)

        elif data.get("type") == "arreter_execution_profil_ack":
            # Côté PILOTE -- réponse à arreter_execution_profil() (Section
            # 8). Même contrat que kill_profil_ack (ok=True confirme
            # seulement la TRANSMISSION à l'exécutant visé, pas l'arrêt
            # effectif du code) -- mais PAS de champ "redemarrer" ici
            # (n'a pas de sens, cf. serveur.py handler arreter_execution_
            # profil qui ne le transporte pas non plus).
            ok = data.get("ok", False)
            id_executant = data.get("id_executant", "")
            nom_profil = data.get("nom_profil", "")
            erreur = data.get("erreur", "")
            if ok:
                log_reseau_t.info(f"<- arreter_execution_profil_ack (ok=True, id_executant={id_executant!r}, nom_profil={nom_profil!r})")
            else:
                log_reseau_t.warning(f"<- arreter_execution_profil_ack (ok=False, id_executant={id_executant!r}, nom_profil={nom_profil!r}) : {erreur}")
            self.arreter_execution_profil_resultat.emit(ok, id_executant, nom_profil, erreur)

        elif data.get("type") == "arreter_execution_profil":
            # Côté EXÉCUTANT -- ordre d'arrêt du CODE (pas du profil) reçu
            # du pilote, relayé tel quel par le serveurT (Section 8, cf.
            # handler arreter_execution_profil côté serveur). Signal
            # (nom_profil,) -- main_sautoniax route vers un nouveau
            # handler dédié qui ne touche QUE _executeurs_isoles (cf.
            # _sur_kill_profil_demande pour le patron équivalent côté
            # kill_profil, mais qui lui touche aussi le navigateur/
            # _procs_isoles -- pas voulu ici.
            nom_profil = data.get("nom_profil", "")
            log_reseau_t.info(f"<- arreter_execution_profil reçu du pilote (nom_profil={nom_profil!r})")
            self.arreter_execution_profil_demande.emit(nom_profil)

        elif data.get("type") == "arreter_execution_profil_resultat_reel":
            # Côté PILOTE -- résultat RÉEL de l'arrêt du code (cf.
            # docstring du signal arreter_execution_profil_resultat_reel_
            # recu), relayé par le serveur avec id_executant ajouté (cf.
            # serveur.py). SIGNATURE À 4 CHAMPS (PAS 5 comme kill_profil_
            # resultat_reel_recu) : pas de "redemarrer" ici.
            id_executant = data.get("id_executant", "")
            nom_profil = data.get("nom_profil", "")
            ok = data.get("ok", False)
            message = data.get("message", "")
            log_reseau_t.info(
                f"<- arreter_execution_profil_resultat_reel (id_executant={id_executant!r}, "
                f"nom_profil={nom_profil!r}, ok={ok}) : {message}"
            )
            self.arreter_execution_profil_resultat_reel_recu.emit(id_executant, nom_profil, ok, message)

        elif data.get("type") == "demander_upload_profil_vers_cloud_ack":
            # Côté PILOTE -- réponse à demander_upload_profil_vers_cloud().
            # Même contrat que kill_profil_ack (ok=True confirme
            # seulement la TRANSMISSION à l'exécutant visé, pas que
            # l'upload a eu lieu -- cf. upload_profil_executant_resultat
            # plus bas pour ça).
            ok = data.get("ok", False)
            id_executant = data.get("id_executant", "")
            nom_profil = data.get("nom_profil", "")
            erreur = data.get("erreur", "")
            if ok:
                log_reseau_t.info(f"<- demander_upload_profil_vers_cloud_ack (ok=True, id_executant={id_executant!r}, nom_profil={nom_profil!r})")
            else:
                log_reseau_t.warning(f"<- demander_upload_profil_vers_cloud_ack (ok=False, id_executant={id_executant!r}, nom_profil={nom_profil!r}) : {erreur}")
            self.demander_upload_profil_vers_cloud_resultat.emit(ok, id_executant, nom_profil, erreur)

        elif data.get("type") == "demander_upload_profil_vers_cloud":
            # Côté EXÉCUTANT -- ordre reçu du pilote (relayé tel quel par
            # le serveurT, avec id_pilote ajouté -- cf. handler côté
            # serveur.py). main_sautoniax (_sur_upload_profil_vers_cloud_
            # demande) retrouve le dossier local du profil et déclenche
            # self.envoyer_profil(...).
            nom_profil = data.get("nom_profil", "")
            id_pilote = data.get("id_pilote", "")
            log_reseau_t.info(f"<- demander_upload_profil_vers_cloud reçu du pilote (nom_profil={nom_profil!r})")
            self.upload_profil_vers_cloud_demande.emit(nom_profil, id_pilote)

        elif data.get("type") == "upload_profil_executant_resultat":
            # Côté PILOTE -- résultat RÉEL de l'upload (cf. docstring du
            # signal upload_profil_executant_resultat_recu), relayé par
            # le serveur une fois que l'exécutant visé a fini d'uploader
            # (ou échoué), avec id_executant ajouté.
            ok = data.get("ok", False)
            id_executant = data.get("id_executant", "")
            nom_profil = data.get("nom_profil", "")
            taille_octets = data.get("taille_octets", 0)
            erreur = data.get("erreur", "")
            if ok:
                log_reseau_t.info(f"<- upload_profil_executant_resultat (ok=True, id_executant={id_executant!r}, nom_profil={nom_profil!r}, {taille_octets} octets)")
            else:
                log_reseau_t.warning(f"<- upload_profil_executant_resultat (ok=False, id_executant={id_executant!r}, nom_profil={nom_profil!r}) : {erreur}")
            self.upload_profil_executant_resultat_recu.emit(ok, id_executant, nom_profil, taille_octets, erreur)

        elif data.get("type") == "demander_renommer_profil_sautoniax_ack":
            # Côté PILOTE -- réponse à demander_renommer_profil_sautoniax().
            # Même contrat que demander_upload_profil_vers_cloud_ack
            # (ok=True confirme seulement la TRANSMISSION à l'exécutant
            # visé, pas que le renommage a eu lieu -- cf. renommer_profil_
            # sautoniax_resultat plus bas pour ça).
            ok = data.get("ok", False)
            id_executant = data.get("id_executant", "")
            ancien_nom = data.get("ancien_nom", "")
            nouveau_nom = data.get("nouveau_nom", "")
            erreur = data.get("erreur", "")
            if ok:
                log_reseau_t.info(f"<- demander_renommer_profil_sautoniax_ack (ok=True, id_executant={id_executant!r}, '{ancien_nom}' -> '{nouveau_nom}')")
            else:
                log_reseau_t.warning(f"<- demander_renommer_profil_sautoniax_ack (ok=False, id_executant={id_executant!r}, '{ancien_nom}' -> '{nouveau_nom}') : {erreur}")
            self.demander_renommer_profil_sautoniax_resultat.emit(ok, id_executant, ancien_nom, nouveau_nom, erreur)

        elif data.get("type") == "demander_renommer_profil_sautoniax":
            # Côté EXÉCUTANT -- ordre reçu du pilote (relayé tel quel par
            # le serveurT, avec id_pilote ajouté -- cf. handler côté
            # serveur.py). main_sautoniax (_sur_renommer_profil_sautoniax_
            # demande) retrouve le dossier local du profil, vérifie qu'il
            # est bien inactif, puis renomme.
            ancien_nom = data.get("ancien_nom", "")
            nouveau_nom = data.get("nouveau_nom", "")
            id_pilote = data.get("id_pilote", "")
            log_reseau_t.info(f"<- demander_renommer_profil_sautoniax reçu du pilote ('{ancien_nom}' -> '{nouveau_nom}')")
            self.renommer_profil_sautoniax_demande.emit(ancien_nom, nouveau_nom, id_pilote)

        elif data.get("type") == "renommer_profil_sautoniax_resultat":
            # Côté PILOTE -- résultat RÉEL du renommage (cf. docstring du
            # signal renommer_profil_sautoniax_resultat_recu), relayé par
            # le serveur une fois que l'exécutant visé a fini de renommer
            # (ou refusé/échoué), avec id_executant ajouté.
            ok = data.get("ok", False)
            id_executant = data.get("id_executant", "")
            ancien_nom = data.get("ancien_nom", "")
            nouveau_nom = data.get("nouveau_nom", "")
            erreur = data.get("erreur", "")
            if ok:
                log_reseau_t.info(f"<- renommer_profil_sautoniax_resultat (ok=True, id_executant={id_executant!r}, '{ancien_nom}' -> '{nouveau_nom}')")
            else:
                log_reseau_t.warning(f"<- renommer_profil_sautoniax_resultat (ok=False, id_executant={id_executant!r}, '{ancien_nom}' -> '{nouveau_nom}') : {erreur}")
            self.renommer_profil_sautoniax_resultat_recu.emit(ok, id_executant, ancien_nom, nouveau_nom, erreur)

        elif data.get("type") == "demander_toggle_proxy_natif_ack":
            # Côté PILOTE -- réponse à demander_toggle_proxy_natif().
            # Même contrat que demander_upload_profil_vers_cloud_ack
            # (ok=True confirme seulement la TRANSMISSION à l'exécutant
            # visé, pas que le changement a réellement été appliqué --
            # cf. toggle_proxy_natif_resultat plus bas pour ça, y
            # compris le refus possible si le profil est actif, spec
            # section 13.5).
            ok = data.get("ok", False)
            id_executant = data.get("id_executant", "")
            nom_profil = data.get("nom_profil", "")
            erreur = data.get("erreur", "")
            if ok:
                log_reseau_t.info(f"<- demander_toggle_proxy_natif_ack (ok=True, id_executant={id_executant!r}, nom_profil={nom_profil!r})")
            else:
                log_reseau_t.warning(f"<- demander_toggle_proxy_natif_ack (ok=False, id_executant={id_executant!r}, nom_profil={nom_profil!r}) : {erreur}")
            self.demander_toggle_proxy_natif_resultat.emit(ok, id_executant, nom_profil, erreur)

        elif data.get("type") == "demander_toggle_proxy_natif":
            # Côté EXÉCUTANT -- ordre reçu du pilote (relayé tel quel par
            # le serveurT, avec id_pilote ajouté -- cf. handler côté
            # serveur.py). main_sautoniax (_sur_toggle_proxy_natif_
            # demande) vérifie que le profil n'est pas actif (spec
            # section 13.5) puis écrit definir_proxy_natif_config_profil.
            nom_profil = data.get("nom_profil", "")
            actif = bool(data.get("actif", False))
            id_pilote = data.get("id_pilote", "")
            log_reseau_t.info(f"<- demander_toggle_proxy_natif reçu du pilote (nom_profil={nom_profil!r}, actif={actif!r})")
            self.toggle_proxy_natif_demande.emit(nom_profil, actif, id_pilote)

        elif data.get("type") == "toggle_proxy_natif_resultat":
            # Côté PILOTE -- résultat RÉEL du changement (cf. docstring
            # du signal toggle_proxy_natif_resultat_recu), DIFFUSÉ par le
            # serveur à tous les pilotes une fois que l'exécutant visé a
            # traité la demande (acceptée ET écrite, ou refusée -- ex.
            # profil actif), avec id_executant ajouté.
            ok = data.get("ok", False)
            id_executant = data.get("id_executant", "")
            nom_profil = data.get("nom_profil", "")
            actif = bool(data.get("actif", False))
            erreur = data.get("erreur", "")
            if ok:
                log_reseau_t.info(f"<- toggle_proxy_natif_resultat (ok=True, id_executant={id_executant!r}, nom_profil={nom_profil!r}, actif={actif!r})")
            else:
                log_reseau_t.warning(f"<- toggle_proxy_natif_resultat (ok=False, id_executant={id_executant!r}, nom_profil={nom_profil!r}) : {erreur}")
            self.toggle_proxy_natif_resultat_recu.emit(ok, id_executant, nom_profil, actif, erreur)

        elif data.get("type") == "demander_profils_sautoniax_ack":
            # Côté PILOTE -- réponse à demander_profils_sautoniax(). Même
            # contrat que kill_profil_ack (ok=True confirme seulement la
            # TRANSMISSION à l'exécutant visé, pas que la liste est
            # prête -- cf. profils_sautoniax_resultat plus bas pour ça).
            ok = data.get("ok", False)
            id_executant = data.get("id_executant", "")
            erreur = data.get("erreur", "")
            if ok:
                log_reseau_t.info(f"<- demander_profils_sautoniax_ack (ok=True, id_executant={id_executant!r})")
            else:
                log_reseau_t.warning(f"<- demander_profils_sautoniax_ack (ok=False, id_executant={id_executant!r}) : {erreur}")
            self.demander_profils_sautoniax_resultat.emit(ok, id_executant, erreur)

        elif data.get("type") == "demander_profils_sautoniax":
            # Côté EXÉCUTANT -- ordre reçu du pilote (relayé tel quel par
            # le serveurT, avec id_pilote ajouté -- cf. handler côté
            # serveur.py). main_sautoniax (_sur_demander_profils_
            # sautoniax_demande) scanne son dossier de profils locaux et
            # répond via self.envoyer_profils_sautoniax_resultat(...).
            id_pilote = data.get("id_pilote", "")
            log_reseau_t.info(f"<- demander_profils_sautoniax reçu du pilote (id_pilote={id_pilote!r})")
            self.profils_sautoniax_demande.emit(id_pilote)

        elif data.get("type") == "profils_sautoniax_resultat":
            # Côté PILOTE -- liste RÉELLE des profils (actifs + inactifs)
            # d'un sAutoniax précis (cf. docstring du signal profils_
            # sautoniax_recu), relayée DIRECTEMENT par le serveur au
            # pilote demandeur (id_executant ajouté par le serveur, PAS
            # une diffusion -- contrairement à kill_profil_resultat_reel).
            id_executant = data.get("id_executant", "")
            profils = data.get("profils", [])
            log_reseau_t.info(f"<- profils_sautoniax_resultat (id_executant={id_executant!r}, {len(profils)} profil(s))")
            self.profils_sautoniax_recu.emit(id_executant, profils)

        elif data.get("type") in ("kaggle_lister_profils", "kaggle_envoyer_profils", "kaggle_telecharger_profils"):
            # Côté EXÉCUTANT -- ordre Kaggle relayé par le serveurT (id_pilote ajouté).
            log_reseau_t.info(f"<- {data.get('type')} reçu du pilote (op={data.get('id_operation')!r})")
            self.kaggle_ordre_recu.emit(data.get("type"), dict(data))

        elif data.get("type") in ("kaggle_lister_profils_ack", "kaggle_envoyer_profils_ack", "kaggle_telecharger_profils_ack"):
            # Côté PILOTE -- accusé de TRANSMISSION d'un ordre (pas du résultat).
            ok = bool(data.get("ok", False))
            if not ok:
                log_reseau_t.warning(f"<- {data.get('type')} (ok=False) : {data.get('erreur', '')}")
            self.kaggle_ack_recu.emit(str(data.get("type", ""))[:-4], data.get("id_executant", ""),
                                       data.get("id_operation", ""), ok, data.get("erreur", ""))

        elif data.get("type") == "kaggle_lister_profils_resultat":
            profils = data.get("profils", [])
            self.kaggle_profils_recus.emit(data.get("id_executant", ""), profils if isinstance(profils, list) else [])

        elif data.get("type") == "kaggle_progression":
            try:
                pct = int(data.get("pourcentage", 0))
            except (TypeError, ValueError):
                pct = 0
            self.kaggle_progression_recue.emit(data.get("id_operation", ""), data.get("id_executant", ""),
                                                data.get("nom_local", ""), str(data.get("etape", "")), pct)

        elif data.get("type") == "kaggle_resultat":
            self.kaggle_resultat_recu.emit(data.get("id_operation", ""), data.get("id_executant", ""),
                                            data.get("nom_local", ""), bool(data.get("ok", False)),
                                            str(data.get("message", "")))

        elif data.get("type") == "demander_horloge_mautoniax":
            # Côté PILOTE -- un sAutoniax vient de demander l'heure (cf.
            # RelaisProxyLocal.obtenir_horloge_mautoniax), relayé tel
            # quel par le serveurT avec id_executant ajouté (cf. serveur.
            # py, handler du même nom). AUCUN Signal Qt, AUCUN câblage
            # MainWindow : calcul pur (datetime.now().astimezone(), même
            # raisonnement que l'ancien _construire_trame_horloge_locale
            # sur /ws_tunnel -- aucune requête réseau ni lookup GeoLite2/
            # ip-api.com), répondu directement DEPUIS CE THREAD RÉSEAU
            # (self._loop, via create_task -- même patron que _tache_
            # heartbeat ci-dessus) plutôt que de faire l'aller-retour par
            # le thread Qt principal pour une réponse qui ne dépend
            # d'aucun état applicatif.
            id_executant = data.get("id_executant", "")
            iso_local, nom_fuseau = _horloge_locale_iso_et_fuseau()
            log_reseau_t.info(f"<- demander_horloge_mautoniax reçu de '{id_executant}' -- réponse : {iso_local} ({nom_fuseau or 'fuseau inconnu'})")
            self.envoyer_horloge_mautoniax_resultat(id_executant, iso_local, nom_fuseau)

        elif data.get("type") == "horloge_mautoniax_resultat":
            # Côté EXÉCUTANT -- réponse RÉELLE du pilote à notre propre
            # demander_horloge_mautoniax (cf. ClientServeurT.demander_
            # horloge_mautoniax). Résout _attente_horloge_mautoniax si
            # elle correspond encore à CETTE demande (pas déjà résolue/
            # annulée par une demande plus récente, cf. docstring de
            # demander_horloge_mautoniax) -- AUCUN Signal Qt ici non plus
            # : RelaisProxyLocal (le seul appelant, côté sAutoniax, pas
            # d'UI) attend directement cette Future.
            iso_local = data.get("iso_local", "")
            nom_fuseau = data.get("nom_fuseau", "")
            log_reseau_t.info(f"<- horloge_mautoniax_resultat reçu ({iso_local}, fuseau={nom_fuseau or 'inconnu'})")
            future = self._attente_horloge_mautoniax
            if future is not None and not future.done():
                future.set_result((iso_local, nom_fuseau))

        elif data.get("type") == "demander_demarrer_profil_isole_ack":
            # Côté PILOTE -- réponse à demander_demarrer_profil_isole().
            # Même contrat que kill_profil_ack (ok=True confirme
            # seulement la TRANSMISSION, pas que le démarrage a réussi --
            # cf. demarrer_profil_isole_resultat plus bas pour ça).
            ok = data.get("ok", False)
            id_executant = data.get("id_executant", "")
            nom_profil = data.get("nom_profil", "")
            erreur = data.get("erreur", "")
            if ok:
                log_reseau_t.info(f"<- demander_demarrer_profil_isole_ack (ok=True, id_executant={id_executant!r}, nom_profil={nom_profil!r})")
            else:
                log_reseau_t.warning(f"<- demander_demarrer_profil_isole_ack (ok=False, id_executant={id_executant!r}, nom_profil={nom_profil!r}) : {erreur}")
            self.demander_demarrer_profil_isole_resultat.emit(ok, id_executant, nom_profil, erreur)

        elif data.get("type") == "demander_demarrer_profil_isole":
            # Côté EXÉCUTANT -- ordre reçu du pilote (relayé tel quel par
            # le serveurT, avec id_pilote ajouté -- cf. handler côté
            # serveur.py). main_sautoniax (_sur_demarrer_profil_isole_
            # demande) télécharge le profil si besoin puis lance Camoufox
            # dessus, même mécanisme que le Notebook Distant.
            nom_profil = data.get("nom_profil", "")
            id_pilote = data.get("id_pilote", "")
            log_reseau_t.info(f"<- demander_demarrer_profil_isole reçu du pilote (nom_profil={nom_profil!r})")
            self.demarrer_profil_isole_demande.emit(nom_profil, id_pilote)

        elif data.get("type") == "demarrer_profil_isole_resultat":
            # Côté PILOTE -- résultat RÉEL du démarrage (cf. docstring du
            # signal demarrer_profil_isole_resultat_recu), DIFFUSÉ par le
            # serveur à tous les pilotes (id_executant ajouté).
            id_executant = data.get("id_executant", "")
            nom_profil = data.get("nom_profil", "")
            ok = data.get("ok", False)
            instance_id = data.get("instance_id", "")
            message = data.get("message", "")
            if ok:
                log_reseau_t.info(f"<- demarrer_profil_isole_resultat (ok=True, id_executant={id_executant!r}, nom_profil={nom_profil!r}, instance_id={instance_id!r})")
            else:
                log_reseau_t.warning(f"<- demarrer_profil_isole_resultat (ok=False, id_executant={id_executant!r}, nom_profil={nom_profil!r}) : {message}")
            self.demarrer_profil_isole_resultat_recu.emit(id_executant, nom_profil, ok, instance_id, message)

        elif data.get("type") == "demander_tester_proxy_sautoniax_ack":
            # Côté PILOTE -- réponse à demander_tester_proxy_sautoniax().
            # Même contrat que demander_demarrer_profil_isole_ack ci-dessus
            # (ok=True confirme seulement la TRANSMISSION).
            ok = data.get("ok", False)
            id_executant = data.get("id_executant", "")
            erreur = data.get("erreur", "")
            if ok:
                log_reseau_t.info(f"<- demander_tester_proxy_sautoniax_ack (ok=True, id_executant={id_executant!r})")
            else:
                log_reseau_t.warning(f"<- demander_tester_proxy_sautoniax_ack (ok=False, id_executant={id_executant!r}) : {erreur}")
            self.demander_tester_proxy_sautoniax_resultat.emit(ok, id_executant, erreur)

        elif data.get("type") == "demander_tester_proxy_sautoniax":
            # Côté EXÉCUTANT -- ordre reçu du pilote (relayé tel quel par
            # le serveurT, avec id_pilote ajouté -- cf. handler côté
            # serveur.py). main_sautoniax (_sur_tester_proxy_sautoniax_
            # demande) exécute _tester_proxy_sync localement (le proxy
            # est testé DEPUIS CE sAutoniax, cf. décision explicite
            # utilisateur) puis répond via envoyer_tester_proxy_
            # sautoniax_resultat.
            proxy_texte = data.get("proxy_texte", "")
            id_pilote = data.get("id_pilote", "")
            log_reseau_t.info("<- demander_tester_proxy_sautoniax reçu du pilote")
            self.tester_proxy_sautoniax_demande.emit(proxy_texte, id_pilote)

        elif data.get("type") == "tester_proxy_sautoniax_resultat":
            # Côté PILOTE -- résultat RÉEL du test (cf. docstring du
            # signal tester_proxy_sautoniax_resultat_recu), RELAYÉ
            # UNIQUEMENT au pilote demandeur (PAS de diffusion, cf.
            # serveur.py -- un test de proxy ne concerne que celui qui
            # l'a lancé, contrairement à un profil qui change d'état).
            id_executant = data.get("id_executant", "")
            succes = data.get("succes", False)
            infos = data.get("infos", {}) or {}
            if succes:
                log_reseau_t.info(f"<- tester_proxy_sautoniax_resultat (succes=True, id_executant={id_executant!r}, ip={infos.get('ip')!r})")
            else:
                log_reseau_t.warning(f"<- tester_proxy_sautoniax_resultat (succes=False, id_executant={id_executant!r}) : {infos.get('erreur')}")
            self.tester_proxy_sautoniax_resultat_recu.emit(id_executant, succes, infos)

        elif data.get("type") == "demander_creer_profil_sautoniax_ack":
            # Côté PILOTE -- réponse à demander_creer_profil_sautoniax().
            # Même contrat que demander_demarrer_profil_isole_ack ci-dessus
            # (ok=True confirme seulement la TRANSMISSION).
            ok = data.get("ok", False)
            id_executant = data.get("id_executant", "")
            nom_profil = data.get("nom_profil", "")
            erreur = data.get("erreur", "")
            if ok:
                log_reseau_t.info(f"<- demander_creer_profil_sautoniax_ack (ok=True, id_executant={id_executant!r}, nom_profil={nom_profil!r})")
            else:
                log_reseau_t.warning(f"<- demander_creer_profil_sautoniax_ack (ok=False, id_executant={id_executant!r}, nom_profil={nom_profil!r}) : {erreur}")
            self.demander_creer_profil_sautoniax_resultat.emit(ok, id_executant, nom_profil, erreur)

        elif data.get("type") == "demander_creer_profil_sautoniax":
            # Côté EXÉCUTANT -- ordre reçu du pilote (relayé tel quel par
            # le serveurT, avec id_pilote ajouté -- cf. handler côté
            # serveur.py). main_sautoniax (_sur_creer_profil_sautoniax_
            # demande) crée le dossier sous sautoniax_profils/<nom> +
            # enregistre type/proxy (cf. _sautoniax_creer_profil), PAS de
