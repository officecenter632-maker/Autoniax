# explicite -- "seul le serveur doit être séparé"). Toujours lancée en
# PROCESS SÉPARÉ (cf. main_instance_nodriver()/if __name__ == "__main__" en
# fin de fichier, section "Point d'entrée" -- AutoniaX.py --instance-id ...
# --port ... au lieu de python instance_nodriver.py --instance-id ...),
# jamais importée : chaque instance de navigateur garde sa PROPRE boucle
# asyncio, indépendante de la boucle Qt de l'application principale
# (nodriver/CDP tourne en asyncio pur -- l'intégrer à la boucle Qt sans
# passerelle type qasync mélangerait les deux boucles événementielles).
#
# Se connecte au serveur central en tant que client WebSocket (rôle
# "instance"), lance un vrai navigateur Chromium via nodriver/CDP, puis
# pousse ses frames en continu dès que le navigateur est prêt. Répond aussi
# aux commandes d'action (moveCursor, click, scroll, paste, copy,
# mousemove, listTabs, switchTab), reçues du serveur et relayées depuis un
# programme de pilotage (ex: TestComposantScreen/SequenceurActionReseau
# côté AutoniaX).
#
# Logger dédié ("autoniax.instance", distinct de "autoniax" utilisé par le
# reste de l'app) -- même convention que log_test_composant/
# log_instance_apercu ailleurs dans ce fichier, conservé identique à
# l'ancien fichier séparé pour ne pas casser un filtrage de logs existant.
# ===========================================================================

log = logging.getLogger("autoniax.instance")

# PATCH (nettoyage des logs -- problème #1 : "Des logs affichent
# l'intégralité du code HTML de la page d'accueil Camoufox... plus de
# 15 000 caractères") : les data: URL de la welcome page (cf.
# _data_url_page_accueil) réapparaissent en clair dans le MESSAGE d'une
# exception Playwright quand page.goto() échoue ou time-out dessus (le
# message d'erreur standard de Playwright inclut la commande de
# navigation tentée). Les logs applicatifs ci-dessous journalisent
# `{exc!r}`/`{exc}` -- str(exc) contient donc potentiellement cette URL
# complète. Repasser ces f-strings par ce helper AVANT de les loguer
# règle le problème sans toucher au comportement (l'exception continue
# de remonter intacte, seul le TEXTE LOGUÉ est raccourci).
_TAILLE_MAX_MESSAGE_LOG = 500


def _resume_pour_log(texte) -> str:
    """Convertit `texte` (str, ou objet type exception via str()) en une
    version bornée à _TAILLE_MAX_MESSAGE_LOG caractères pour un log
    lisible -- jamais de silence sur la troncature (mention explicite en
    fin de chaîne, même esprit que _tronquer_pour_historique un peu plus
    haut dans ce fichier, mais pensé pour un message de log sur une seule
    ligne plutôt qu'une sortie de cellule)."""
    texte = str(texte)
    if len(texte) <= _TAILLE_MAX_MESSAGE_LOG:
        return texte
    return texte[:_TAILLE_MAX_MESSAGE_LOG] + f"... (tronqué, {len(texte):,} caractères au total)"

