    def showEvent(self, event):
        """Charge automatiquement la liste des profils cloud ET la liste
        des profils locaux la toute première fois que cet onglet devient
        visible -- même patron que StockageCloudScreen.showEvent.

        BUGFIX : l'émission initiale de demande_liste_stockage en
        fin de __init__ partait AVANT que ReseauScreen n'ait eu la
        chance de connecter ce signal (connexion faite juste après
        l'instanciation de cet écran, cf. ReseauScreen.__init__) --
        ce premier emit() était donc silencieusement perdu. Réémis
        ici, au premier affichage réel (les connexions Qt sont alors
        forcément établies).

        NOTE : demande_liste_profils_locaux n'est plus émis ICI (le
        bloc "Envoyer un profil" qui en avait besoin -- combo_profils
        -- a été retiré de cet onglet, cf. __init__) -- ProfilsLocal
        Screen.showEvent émet déjà sa propre copie de ce signal pour
        alimenter SON propre combo, donc rien n'est perdu."""
        super().showEvent(event)
        if not self._deja_charge_une_fois:
            self._deja_charge_une_fois = True
            self.demande_liste_stockage.emit()
            self.demande_liste_sautoniax_disponibles.emit()

    # --- Bloc "Envoyer un profil" : RETIRÉ de cet écran (demande
    # explicite utilisateur, capture d'écran à l'appui -- "je veux que
    # tu enlève ça de cette page, l'envoie de profils ne se fait pas
    # ici, mais dans l'onglet profils locale"). definir_profils_
    # disponibles / _sur_clic_envoyer_profil / sur_progression_envoi_
    # profil / sur_resultat_envoi_profil vivent désormais UNIQUEMENT sur
    # ProfilsLocalScreen (cf. plus bas dans ce fichier) -- ProfilsScreen
    # (le parent aux deux sous-onglets) ne délègue plus ces appels qu'à
    # local_screen, cf. sa propre définition plus bas.

    def noms_profils_cloud(self) -> list:
        """PATCH (Patch 4.4.a -- dialogue "Envoyer vers un sAutoniax", cf.
        DialogueEnvoiSautoniax) : liste des profils actuellement connus
        dans Profils/ du cloud (source de vérité déjà entretenue par
        sur_resultat_liste_stockage ci-dessous), pour que le dialogue
        d'envoi propose les mêmes profils à cocher que cette table --
        sans dupliquer d'état réseau ni redemander la liste au serveurT."""
        return sorted(self._profils_cloud.keys())

    def infos_profils_cloud(self) -> dict:
        """PATCH E.7 (cf. cahier des charges patchs.md, section E.7 --
        mini-app "Attribuer les profils") : symétrique de noms_profils_
        cloud() ci-dessus, mais porte en plus les MÉTADONNÉES par profil
        (proxy_configure, pays, date_envoi_iso) -- nécessaires à la
        sélection semi-automatique par "badge"/date de dernière
        utilisation (cf. AttributionProfilsScreen). Même source
        (self._profils_cloud), aucun appel réseau supplémentaire, aucun
        changement de noms_profils_cloud() lui-même (qui reste utilisé
        tel quel par DialogueEnvoiSautoniax -- ne PAS risquer de casser
        ce dialogue déjà stable pour un besoin qui ne le concerne pas).

        {nom_profil: {"proxy_configure": bool|None, "pays": str|None,
        "date_envoi_iso": str|None}} -- meta absent ou pas encore
        téléchargé (cf. sur_meta_profil_recu) : les 3 valeurs sont None,
        jamais une KeyError qui bloquerait l'écran appelant."""
        resultat = {}
        for nom_profil, infos in self._profils_cloud.items():
            meta = infos.get("meta") or {}
            resultat[nom_profil] = {
                "proxy_configure": meta.get("proxy_configure"),
                "pays": meta.get("pays"),
                "date_envoi_iso": meta.get("date_envoi_iso"),
            }
        return resultat

