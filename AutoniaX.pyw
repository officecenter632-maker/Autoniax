            # intacte ci-dessous, plus appelée depuis le panneau de rendu
            # -- cf. PanneauRenduInstance._sur_debounce_scroll) -- demande
            # utilisateur explicite : "je m'en fous de la valeur du
            # scroll réel, simule juste le scroll", "tout ce que
            # l'événement doit transmettre c'est le sens", "cette valeur
            # constante, on passe en paramètre dans le panneau de rendu".
            # `sens` : "haut"/"bas". `amplitude` : réglée côté pilote
            # (spin_amplitude_scroll), repli sur WHEEL_DELTA si absente
            # (cf. action_camoufox_scroll_simple).
            await action_camoufox_scroll_simple(
                page, str(data.get("sens", "bas")),
                amplitude=float(data.get("amplitude", WHEEL_DELTA)),
            )
        elif action == "mouse_drag":
            await action_camoufox_mouse_drag(
                page, int(data["x1"]), int(data["y1"]), int(data["x2"]), int(data["y2"]),
                bouton=data.get("bouton", "gauche"),
                etat_navigateur=etat_navigateur,
                speed_percent=float(data.get("speedPercent", 0)),
                instantane=bool(data.get("instantane", False)),
            )
        elif action == "scroll":
            # targetDeltaX/Y (nouveau, scroll humanisé) prioritaire ; repli
            # sur l'ancien nommage deltaX/deltaY si un appelant plus ancien
            # (ou externe) envoie encore ce format -- même correction que
            # le dispatcher nodriver (_executer_commande), cf. docstring
            # action_camoufox_scroll pour le sens exact de la quantité
            # transmise.
            #
            # rapide (PATCH -- retour utilisateur explicite : accumulation
            # + debounce côté pilote, cf. PanneauRenduInstance._sur_
            # debounce_scroll) : transmis tel quel depuis "data", absent
            # (False par défaut) pour tout appelant plus ancien qui
            # n'enverrait pas ce champ -- comportement humanisé inchangé
            # dans ce cas.
            await action_camoufox_scroll(
                page, int(data["x"]), int(data["y"]),
                delta_x=float(data.get("targetDeltaX", data.get("deltaX", 0.0))),
                delta_y=float(data.get("targetDeltaY", data.get("deltaY", 0.0))),
                frequence_crans_par_sec=float(data.get("frequenceCransParSec", 5.0)),
                speed_percent=float(data.get("speedPercent", 0.0)),
                rapide=bool(data.get("rapide", False)),
            )
        elif action == "paste":
            if "texte" in data:
                texte_a_coller = str(data["texte"])
            else:
                texte_a_coller = str(etat_navigateur.get("presse_papier_virtuel", ""))
            await action_camoufox_paste(page, int(data["x"]), int(data["y"]), texte_a_coller)
        elif action == "clear":
            await action_camoufox_clear(page, int(data["x"]), int(data["y"]))
        elif action == "dom_paste":
            # PATCH (portage réel du support Camoufox, cf. docstring
            # action_camoufox_dom_paste plus haut) -- même principe que la
            # branche "dom_paste" côté _executer_commande (CDP) : AUCUNE
            # coordonnée, sortie anticipée en {"ok": False, "error": ...}
            # si l'élément est introuvable ou non éditable, plutôt que de
            # tomber dans reponse_ok = {"ok": True, ...} en bas de cette
            # fonction.
            resultat_dom = await action_camoufox_dom_paste(page, str(data.get("selecteur", "")), str(data.get("texte", "")))
            if not resultat_dom.get("trouve"):
                return {"ok": False, "error": resultat_dom.get("erreur") or "élément introuvable pour dom_paste"}
            if resultat_dom.get("erreur"):
                return {"ok": False, "error": resultat_dom["erreur"]}
        elif action == "dom_clear":
            # Même principe que dom_paste juste au-dessus, sans texte à
            # transmettre.
            resultat_dom = await action_camoufox_dom_clear(page, str(data.get("selecteur", "")))
            if not resultat_dom.get("trouve"):
                return {"ok": False, "error": resultat_dom.get("erreur") or "élément introuvable pour dom_clear"}
            if resultat_dom.get("erreur"):
                return {"ok": False, "error": resultat_dom["erreur"]}
        elif action == "type_text":
            await action_camoufox_type_text(
                page, int(data["x"]), int(data["y"]), str(data.get("texte", "")),
                delai_min_ms=int(data.get("delai_min_ms", 60)),
                delai_max_ms=int(data.get("delai_max_ms", 180)),
                avec_clic=bool(data.get("avec_clic", True)),
                facteur_vitesse=float(data.get("facteur_vitesse", 1.0)),
            )
        elif action == "press_key":
            # PATCH (contrôle à distance -- relais de la touche Entrée,
            # cf. docstring action_camoufox_press_key/_TOUCHES_CAMOUFOX_
            # AUTORISEES juste au-dessus pour la liste blanche).
            _ts_avant = etat_navigateur.get("presse_papier_virtuel_ts")
            await action_camoufox_press_key(page, int(data["x"]), int(data["y"]), str(data.get("touche", "")))
            if str(data.get("touche", "")) == "Control+c":
                resultat = await _attendre_copie_fraiche(etat_navigateur, _ts_avant)
                if not resultat.get("copie"):
                    resultat = await _copie_secours_camoufox(
                        page, etat_navigateur, int(data["x"]), int(data["y"]), resultat,
                    )
        elif action == "copy":
            await action_camoufox_copy(page)
            resultat = etat_navigateur.get("presse_papier_virtuel", "")
        elif action == "get_clipboard":
            resultat = action_camoufox_get_clipboard(etat_navigateur)
        elif action == "get_last_assistant_message":
            # AJOUT (cf. docstring InstanceExecutable.get_derniere_reponse_
            # assistant) -- même principe que dom_paste/dom_clear juste
            # au-dessus : AUCUNE coordonnée, sortie anticipée en {"ok":
            # False, "error": ...} si aucun élément ne correspond au
            # sélecteur, plutôt que de tomber dans reponse_ok en bas de
            # cette fonction.
            resultat_msg = await action_camoufox_derniere_reponse_assistant(page, str(data.get("selecteur", "")))
            if not resultat_msg.get("trouve"):
                return {"ok": False, "error": resultat_msg.get("erreur") or "élément introuvable pour get_last_assistant_message"}
            resultat = resultat_msg.get("texte", "")
        elif action == "get_html":
            # PATCH get_html -- HTML du DOM vivant de l'onglet actif.
            resultat_html = await action_camoufox_get_html(page, str(data.get("selecteur", "")), str(data.get("cadre") or ""))
            if not resultat_html.get("trouve"):
                return {"ok": False, "error": resultat_html.get("erreur") or "lecture HTML impossible"}
            resultat = resultat_html.get("html", "")
        elif action == "find_elements":
            # PATCH éléments DOM : liste / localisation par sélecteur CSS.
            resultat_el = await action_camoufox_find_elements(page, {
                "selecteur": str(data.get("selecteur", "")),
                "cadre": str(data.get("cadre") or ""),
                "limite": int(data.get("limite", 100)),
                "visibles": bool(data.get("visibles", True)),
                "index": data.get("index"),
                "scroll": bool(data.get("scroll", False)),
            })
            if not resultat_el.get("ok"):
                return {"ok": False, "error": resultat_el.get("erreur") or "find_elements impossible"}
            resultat = {"total": resultat_el.get("total", 0), "elements": resultat_el.get("elements", [])}
        elif action == "evaluer_js":
            # AJOUT (cadre/evaluer_js) -- exécute du JavaScript dans la page ou dans l'iframe `cadre`.
            resultat_js = await action_camoufox_evaluer_js(page, str(data.get("code", "")), str(data.get("cadre") or ""))
            if not resultat_js.get("ok"):
                return {"ok": False, "error": resultat_js.get("erreur") or "evaluer_js impossible"}
            resultat = resultat_js.get("valeur")
        elif action == "drag":
            resultat_drag = await action_camoufox_drag(page, int(data["x"]), int(data["y"]), str(data.get("chemin_fichier", "")))
            if not resultat_drag["trouve"]:
                return {"ok": False, "error": resultat_drag["erreur"]}
        elif action == "drag_page":
            # PATCH (même piège que dom_paste/naviguer/list_tabs avant lui) :
            # "drag_page" est déclarée dans ACTIONS_ETENDUES/srv_ACTIONS_SUPPORTEES
            # et câblée côté CDP (action_drag_page, elif "drag_page" dans
            # _executer_commande), et action_camoufox_drag_page() existe déjà
            # (portage complet, voir sa définition) -- mais cette branche
            # elif n'avait jamais été ajoutée ici, donc une instance Camoufox
            # recevant "drag_page" tombait dans le catch-all ("action inconnue
            # : drag_page") sans jamais appeler la fonction déjà écrite.
            resultat_drag_page = await action_camoufox_drag_page(page, str(data.get("chemin_fichier", "")))
            if not resultat_drag_page["trouve"]:
                return {"ok": False, "error": resultat_drag_page["erreur"]}
        elif action == "capture_propre":
            resultat = await action_camoufox_capture_propre(page)
        elif action == "getScreenInfo":
            # Pure lecture -- même principe que isInterfaceInitialisee
            # juste plus bas, ne touche jamais etat_navigateur["page"].
            resultat = await action_camoufox_get_screen_info(page, etat_navigateur=etat_navigateur)
        elif action == "diagRawMouseMove":
            # DIAGNOSTIC TEMPORAIRE (demande explicite utilisateur : isoler
            # page.mouse.move() SEUL, sans generate_mouse_path ni curseur
            # virtuel, pour confirmer/infirmer que le coût observé
            # (~250-450ms/point, jusqu'à ~1.9s) vient bien de l'appel
            # Playwright natif lui-même et pas d'un des deux autres
            # composants de la boucle de action_camoufox_mousemove. Court-
            # circuite volontairement TOUT le pipeline habituel (banque de
            # trajectoire, tremblement, curseur virtuel affiché) -- juste
            # N appels page.mouse.move() bruts, chronométrés un par un.
            # À retirer une fois le diagnostic conclu (aucun appelant
            # utilisateur normal n'utilise cette action).
            resultat = await action_camoufox_diag_raw_mouse_move(
                page, int(data["x"]), int(data["y"]),
                nb_appels=int(data.get("nb_appels", 5)),
                sleep_entre_appels_s=float(data.get("sleep_entre_appels_s", 0.0)),
            )
        elif action == "diagAlternanceCurseurMouse":
            # DIAGNOSTIC TEMPORAIRE (suite de diagRawMouseMove -- demande
            # explicite utilisateur : TEST DIAG 3). Reproduit l'ALTERNANCE
            # curseur virtuel (page.evaluate) + mouse.move + sleep, à
            # l'identique de la vraie boucle de action_camoufox_mousemove
            # (cf. action_camoufox_diag_alternance_curseur_mouse pour le
            # détail complet), pour confirmer si c'est cette alternance
            # -- pas l'un des deux appels pris isolément (déjà écartés par
            # diagRawMouseMove) -- qui recrée la lenteur de 250-450ms/point.
            # À retirer une fois le diagnostic conclu.
            resultat = await action_camoufox_diag_alternance_curseur_mouse(
                page, int(data["x"]), int(data["y"]),
                nb_appels=int(data.get("nb_appels", 8)),
                sleep_entre_appels_s=float(data.get("sleep_entre_appels_s", 0.02)),
            )
        elif action == "diagMouvementReel":
            # DIAGNOSTIC TEMPORAIRE (TEST DIAG 5 -- suite de
            # diagAlternanceCurseurMouse). Seule différence : la position
            # envoyée à mouse.move change réellement à chaque point (au
            # lieu de rester fixe comme DIAG 3/4), pour isoler si c'est le
            # fait même d'un déplacement (par opposition à un mousemove
            # "sur place") qui coûte cher côté Camoufox/Firefox. À retirer
            # une fois le diagnostic conclu.
            resultat = await action_camoufox_diag_mouvement_reel(
                page, int(data["x"]), int(data["y"]),
                nb_appels=int(data.get("nb_appels", 8)),
                sleep_entre_appels_s=float(data.get("sleep_entre_appels_s", 0.02)),
                pas_px=int(data.get("pas_px", 1)),
            )
        elif action == "listTabs":
            resultat = await action_camoufox_list_tabs(context, gestion, page)
        elif action == "goBack":
            # PATCH (retour utilisateur -- panneau de rendu réseau
            # "piégé" après un clic sur un lien, aucun bouton retour) --
            # cf. docstring action_camoufox_go_back.
            resultat = {"navigue": await action_camoufox_go_back(page)}
        elif action == "goForward":
            resultat = {"navigue": await action_camoufox_go_forward(page)}
        elif action == "switchTab":
            nouvel_onglet = await action_camoufox_switch_tab(context, gestion, str(data["tabId"]))
            etat_navigateur["page"] = nouvel_onglet
        elif action == "bringToFront":
            # AJOUT (clic droit "voir ce profil" dans le panneau clone,
            # cf. docstring de action_camoufox_bring_to_front) -- pas de
            # tabId ici contrairement à switchTab : on remonte l'onglet
            # DÉJÀ actif, etat_navigateur["page"] n'est donc jamais
            # réécrit (aucun changement d'onglet, seulement un focus
            # fenêtre ponctuel).
            await action_camoufox_bring_to_front(page)
        elif action == "newTab":
            timeout_attente_page_s = float(data.get("timeout_attente_page_s", 8.0))
            # CORRECTIF (toggle "bloquer médias" -- volet Camoufox) : même
            # convention que côté nodriver (cf. le même bloc dans
            # _executer_commande) -- absent côté pilote == False. Posé
            # AVANT la navigation : l'interception de contexte (cf.
            # camoufox_installer_blocage_media) relit cette clé à chaque
            # requête, il n'y a donc aucun filtre à installer/retirer ici,
            # seulement l'intention du Task à enregistrer. Le drapeau reste
            # valable jusqu'au prochain navigate/newTab, exactement comme
            # le filtre CDP persiste par session côté Chrome.
            etat_navigateur["bloquer_media_explicite"] = bool(data.get("bloquer_media", False))
            # Filet : si l'installation au démarrage avait échoué (cf.
            # camoufox_demarrer_navigateur), on retente ici. Idempotent.
            await camoufox_installer_blocage_media(context, etat_navigateur)
            nouvel_onglet, charge, erreur_attente = await action_camoufox_new_tab(
                context, gestion, _url_nouvel_onglet(str(data.get("url", ""))), timeout_attente_page_s,
            )
            etat_navigateur["page"] = nouvel_onglet
            if not charge:
                return {"ok": False, "error": erreur_attente or "la page n'a pas fini de charger"}
            resultat = {"id": gestion.enregistrer(nouvel_onglet)}
        elif action == "navigate":
            # AJOUT (demande explicite utilisateur -- rester sur l'onglet
            # actif et naviguer vers un lien précis) -- contrairement à
            # newTab ci-dessus, etat_navigateur["page"] n'est PAS réécrit :
            # `page` (déjà l'onglet actif au moment de cet appel) est
            # navigué sur place, cf. docstring action_camoufox_navigate.
            timeout_attente_page_s = float(data.get("timeout_attente_page_s", 8.0))
            # CORRECTIF (toggle "bloquer médias" -- volet Camoufox) : cf. le
            # commentaire détaillé du bloc newTab juste au-dessus.
            etat_navigateur["bloquer_media_explicite"] = bool(data.get("bloquer_media", False))
            await camoufox_installer_blocage_media(context, etat_navigateur)
            charge, erreur_attente = await action_camoufox_navigate(
                page, str(data.get("url", "")), timeout_attente_page_s,
            )
            if not charge:
                return {"ok": False, "error": erreur_attente or "la page n'a pas fini de charger"}
        elif action == "resetInterface":
            instance_id_reset = str(data.get("instance_id", ""))
            # CORRECTIF (plantage reset/capture) -- le streaming se met en pause pendant tout le reset.
            etat_navigateur["reset_en_cours"] = True
            try:
                # PATCH : resetInterface NE VIDE PLUS les données de navigation par défaut (cookies, localStorage,
                # sessionStorage, IndexedDB, caches... sont conservés -- sinon la session était perdue à chaque reset).
                # Pour les vider : reset_interface(vider_donnees=True) (paramètre "vider_donnees"). Le vidage se fait
                # AVANT la fermeture des onglets (le nettoyage du stockage passe par du JS exécuté dans les pages
                # ouvertes). Best-effort : un échec est journalisé, il ne bloque jamais la réinitialisation.
                if data.get("vider_donnees"):
                    try:
                        _rapport_vidage = await asyncio.wait_for(action_camoufox_clear_browsing_data(context), timeout=25.0)
                        log.info(f"[camoufox] resetInterface : données de navigation vidées -- ok={_rapport_vidage.get('ok')} erreurs={_rapport_vidage.get('erreurs')}")
                    except Exception as exc:
                        log.warning(f"[camoufox] resetInterface : vidage des données de navigation échoué -- {exc!r}")
                nouvel_onglet = await action_camoufox_reset_interface(
                    context, gestion, _data_url_page_accueil(instance_id_reset), etat_navigateur,
                )
                etat_navigateur["page"] = nouvel_onglet
            finally:
                etat_navigateur["reset_en_cours"] = False
        elif action == "remplacerRessources":
            # PATCH : même action que côté nodriver ; une route de contexte couvre toutes les pages, présentes et futures.
            _rep_ro = await _ro_executer_commande(data, etat_navigateur, lambda: camoufox_installer_remplacement_ressources(context, etat_navigateur))
            if not _rep_ro.get("ok"):
                return _rep_ro
            resultat = _rep_ro["result"]
        elif action == "clearBrowsingData":
            resultat = await action_camoufox_clear_browsing_data(context)
            if not resultat.get("ok"):
                return {"ok": False, "error": "Échec du vidage des données de navigation : " + "; ".join(resultat.get("erreurs") or ["cookies non vidés"])}
        elif action == "isInterfaceInitialisee":
            instance_id_lecture = str(data.get("instance_id", ""))
            resultat = {"initialisee": await action_camoufox_is_interface_initialisee(context, instance_id_lecture)}
        elif action == "getHomeTabId":
            instance_id_accueil = str(data.get("instance_id", ""))
            tab_id_accueil = await action_camoufox_get_home_tab_id(context, gestion, instance_id_accueil)
            if tab_id_accueil is None:
                return {"ok": False, "error": "Aucun onglet welcome page trouvé pour cette instance (fermé, ou instance démarrée avec une url_ouverture personnalisée)."}
            resultat = {"tabId": tab_id_accueil}
        elif action == "set_download_dir":
            reussi = await action_camoufox_set_download_dir(page, str(data.get("download_dir", "")), str(data.get("instance_id", "")))
            resultat = {"applique": reussi}
            if not reussi:
                return {"ok": False, "error": "Échec de l'application du dossier de téléchargement (voir logs)."}
        elif action == "shutdown":
            # Même principe que côté nodriver : déclenche le même
            # asyncio.Event que le handler SIGTERM de l'appelant, sans
            # fermer quoi que ce soit ICI -- command_result ok=True
            # confirme juste la RÉCEPTION de l'ordre (fire-and-forget),
            # pas la fermeture elle-même.
            if arret_demande is not None:
                log.info("[camoufox] action 'shutdown' reçue -- déclenchement de l'arrêt propre de l'instance.")
                arret_demande.set()
            else:
                log.warning("[camoufox] action 'shutdown' reçue mais aucun arret_demande fourni -- ignorée.")
                return {"ok": False, "error": "shutdown non supporté par cette instance (arret_demande absent)"}
        else:
            return {"ok": False, "error": f"action inconnue : {action}"}
        reponse_ok: dict = {"ok": True, "result": resultat}
        if extras_reponse:
            reponse_ok.update(extras_reponse)
        return reponse_ok
    except KeyError as e:
        log.warning(f"[camoufox] _executer_commande_camoufox({action!r}) : paramètre manquant -- {e}")
        return {"ok": False, "error": f"paramètre manquant pour '{action}' : {e}"}
    except NavigateurFermeCamoufox:
        raise
    except Exception as e:
        log.warning(f"[camoufox] échec de l'action '{action}' : {e!r}")
        return {"ok": False, "error": str(e)}


# ---------------------------------------------------------------------------
# PATCH (Notebook Distant -- "je veux que claude.instance() fonctionne" --
# suite au bug RESPONSE_DIR/NameError puis à la découverte, en creusant,
# que ServiceAPIExecutable/InstanceExecutable n'ont jamais été utilisables
# depuis le code d'une cellule notebook distant : leurs méthodes passent
# TOUJOURS par MoteurExecutionCellule._appeler, qui envoie une commande
# réseau {"type": "command", ...} via un client WebSocket vers le SERVEUR
# LOCAL (ws://127.0.0.1:8765) et ATTEND (threading.Event.wait(), bloquant)
# la réponse d'une instance nodriver/Camoufox enregistrée là-bas -- or le
# profil piloté par le notebook distant (mode mono-profil, cf.
# _main_async_sautoniax/_sautoniax_initialiser_notebook_distant) n'a
# JAMAIS été une telle instance enregistrée : c'est un `page` Playwright
# piloté EN MÉMOIRE, DANS CE MÊME PROCESS, directement par
# _executer_commande_camoufox (cf. juste au-dessus) -- il n'y a tout
# simplement personne à l'autre bout du WebSocket pour répondre à ces
# commandes, ni même de raison d'emprunter ce détour réseau local/
# serveurT puisque tout ce dont on a besoin (context/gestion/page/
# etat_navigateur) est déjà une variable Python directement accessible
# ici, dans la même boucle asyncio.
#
# Solution : CETTE classe réplique EXACTEMENT le contrat public
# d'InstanceExecutable (mêmes noms de méthode, mêmes paramètres, mêmes
# valeurs de retour/exceptions -- cf. chaque docstring ci-dessous, qui
# renvoie à la méthode originale pour la justification complète de
# chaque comportement, non redupliquée ici) mais BRANCHÉE DIRECTEMENT
# sur _executer_commande_camoufox plutôt que sur un aller-retour réseau.
# Seule différence structurelle assumée (cf. décision explicite
# utilisateur, "await claude.instance().capture() ok") : chaque méthode
# est une COROUTINE (async def), à `await`-er par le code de la cellule
# -- puisqu'on est déjà dans la boucle asyncio du sAutoniax, jamais dans
# un thread séparé comme MoteurExecutionCellule._thread_execution
# (mode Task local), il n'existe aucun moyen sûr de bloquer
# "normalement" ici sans geler toute la boucle (streaming compris)
# pendant l'attente.
# ---------------------------------------------------------------------------

class InstanceExecutableDirecteCamoufox:
    """Équivalent DIRECT (sans réseau, cf. bloc de commentaire ci-dessus)
    d'InstanceExecutable, pour un usage EXCLUSIF depuis une cellule de
    Notebook Distant (_sautoniax_executer_notebook_distant) -- jamais
    utilisée ailleurs, jamais construite par MoteurExecutionCellule ni
    MoteurExecutionTaskHeadless (qui continuent d'utiliser
    InstanceExecutable classique, réseau/local, inchangé).

    CORRECTIF (bug rapporté : `RuntimeWarning: coroutine 'new_tab' was
    never awaited`, notebook distant plante silencieusement -- le nouvel
    onglet ne s'ouvre jamais). Cause de fond : le code utilisateur des
    .autoniaxtask est écrit dans le style ENTIÈREMENT SYNCHRONE du mode
    Task normal (aucun `await` nulle part, même sur des fonctions locales
    comme go_to_the_page() -- confirmé en lisant plusieurs fichiers
    réels) -- exactement comme InstanceExecutable (mode Task normal,
    réseau/local) est elle-même synchrone de bout en bout, cf. sa
    docstring et _appeler côté MoteurExecutionCellule (threading.Event().
    wait(), PAS async/await). Cette classe-ci était `async def` sur
    CHAQUE méthode -- appelée sans `await` (le code utilisateur n'en
    écrit jamais), Python crée l'objet coroutine puis l'abandonne aussitôt
    SANS l'exécuter : d'où le warning, et surtout aucune action réelle.

    PyCF_ALLOW_TOP_LEVEL_AWAIT (cf. _sautoniax_executer_notebook_distant)
    ne résout PAS ce problème : ce flag permet au code utilisateur
    d'utiliser `await` s'il le VEUT, il ne force jamais un `await`
    implicite sur un appel qui n'en porte pas.

    Correctif retenu (même patron EXACT que MoteurExecutionCellule
    ._thread_execution/._appeler, cf. leurs docstrings) : chaque méthode
    publique ci-dessous est désormais SYNCHRONE (plus de `async def`).
    _appeler() délègue le vrai travail asynchrone (_executer_commande_
    camoufox, sur `page`/Playwright) à la boucle asyncio PRINCIPALE du
    sAutoniax -- celle qui fait tourner Camoufox -- via asyncio.run_
    coroutine_threadsafe(coro, self._loop).result(timeout=...), qui
    BLOQUE le thread appelant (jamais la boucle elle-même) jusqu'au
    résultat. Pour que ça fonctionne, tout le CODE UTILISATEUR (la
    cellule entière, pas seulement les appels à cette classe) doit
    lui-même tourner sur un thread séparé de cette boucle -- cf.
    _sautoniax_executer_notebook_distant, désormais restructurée pour
    lancer un threading.Thread, exactement comme _thread_execution
    lance le sien en mode local. Depuis CE thread séparé, `Instance.
    new_tab(...)` bloque normalement (comme n'importe quel appel Python
    synchrone) jusqu'à ce que Camoufox ait réellement fini d'ouvrir
    l'onglet sur l'autre thread -- exactement le comportement attendu
    par du code écrit pour le mode Task normal, sans qu'il ait besoin de
    changer une seule ligne.

    self._loop : la boucle asyncio principale du sAutoniax (asyncio.
    get_running_loop(), résolue une fois dans _main_async_sautoniax et
    transmise ici en cascade -- cf. _sautoniax_executer_notebook_distant)
    -- PAS la boucle du thread qui exécute le code utilisateur (ce
    thread-là n'a et ne doit avoir AUCUNE boucle asyncio propre, cf.
    _thread_execution qui, en mode local, n'en a pas non plus)."""

    # Timeout par défaut d'un aller-retour vers la boucle principale
    # (secondes) -- utilisé quand ni `timeout` (paramètre public de la
    # méthode appelée) ni self._namespace["TIMEOUT"] (cf. _global_defaut)
    # ne fournissent de valeur. Généreux à dessein : certaines actions
    # (chargement de page, capture) peuvent légitimement prendre
    # plusieurs secondes -- mieux vaut un délai large ici que de tronquer
    # une action qui aurait fini par réussir (contrairement au mode
    # réseau, où TIMEOUT_COMMANDE_MS protège aussi contre une vraie
    # perte de connexion, absente ici : la boucle cible est locale au
    # même process).
    _TIMEOUT_LIAISON_THREAD_S_DEFAUT = 60.0

    def __init__(self, instance_id: str, context, gestion: "GestionOngletsCamoufox",
                 etat_navigateur: dict, arret_demande: Optional["asyncio.Event"],
                 namespace: Optional[dict] = None, loop: Optional["asyncio.AbstractEventLoop"] = None):
        self.instance_id = instance_id
        self._context = context
        self._gestion = gestion
        self._etat_navigateur = etat_navigateur
        self._arret_demande = arret_demande
        self._namespace = namespace
        self._loop = loop
        self.path: Optional[str] = None

    def __repr__(self) -> str:
        return f"InstanceExecutableDirecteCamoufox({self.instance_id!r})"

    def _global_defaut(self, nom_variable: str, valeur_systeme):
        """Même mécanisme que InstanceExecutable._global_defaut (cf. sa
        docstring) -- RETRY/TIMEOUT/LATENCE_AVANT/LATENCE_APRES lus
        depuis le MÊME namespace de cellule (cellule_variables) que le
        reste du notebook distant, cohérent avec le mode Task normal."""
        if self._namespace is None:
            return valeur_systeme
        return self._namespace.get(nom_variable, valeur_systeme)

    def _appeler(self, action: str, params: dict, timeout: Optional[float] = None) -> dict:
        """Équivalent SYNCHRONE de MoteurExecutionCellule._appeler (cf.
        sa docstring et celle de la classe ci-dessus pour le pourquoi de
        ce choix). BLOQUE le thread appelant (JAMAIS la boucle asyncio
        principale -- cf. run_coroutine_threadsafe, qui planifie sur
        self._loop depuis n'importe quel thread) jusqu'à ce que
        _executer_commande_camoufox ait réellement terminé sur `page`.

        Ne lève PAS d'exception réseau (aucun réseau ici) -- mais PEUT
        lever RuntimeError si self._loop est absente (construction hors
        contexte notebook distant, ne devrait jamais arriver en usage
        normal, cf. _sautoniax_executer_notebook_distant qui la fournit
        systématiquement) ou si le thread appelant EST déjà la boucle
        elle-même (run_coroutine_threadsafe interdit explicitement cet
        appel depuis son propre thread -- signe que cette méthode aurait
        été appelée directement depuis la boucle principale au lieu du
        thread séparé du code utilisateur, erreur d'intégration à
        corriger plutôt qu'à masquer)."""
        if self._loop is None:
            raise RuntimeError(
                f"InstanceExecutableDirecteCamoufox('{self.instance_id}') construite sans boucle asyncio "
                "(self._loop) -- impossible d'exécuter une commande. Ceci indique un bug d'intégration "
                "(cf. docstring de classe), pas une erreur du code utilisateur."
            )
        requete_id = uuid.uuid4().hex[:12]
        data = {"type": "command", "instance_id": self.instance_id, "action": action, "requete_id": requete_id, **params}

        async def _coroutine():
            try:
                return await _executer_commande_camoufox(
                    self._context, self._gestion, self._etat_navigateur, data, self._arret_demande,
                )
            except NavigateurFermeCamoufox as e:
                return {"ok": False, "error": f"navigateur fermé : {e}"}

        delai_s = timeout if timeout is not None else self._TIMEOUT_LIAISON_THREAD_S_DEFAUT
        # PATCH arrêt : si « Arrêter » a été demandé pour ce notebook distant,
        # on ne lance plus aucune commande, et un appel en cours est annulé.
        controle_arret = self._namespace.get("__controle_arret_autoniax__") if self._namespace is not None else None
        if controle_arret is not None:
            controle_arret.verifier()
        future = asyncio.run_coroutine_threadsafe(_coroutine(), self._loop)
        if controle_arret is not None:
            controle_arret.enregistrer(future)
        try:
            return future.result(timeout=delai_s)
        except concurrent.futures.TimeoutError:
            return {"ok": False, "error": f"timeout ({delai_s}s) : aucune réponse pour l'action '{action}'"}
        except (concurrent.futures.CancelledError, asyncio.CancelledError):
            if controle_arret is not None and controle_arret._arrete.is_set():
                raise ArretExecutionNotebookDistant("exécution interrompue (Arrêter)")
            return {"ok": False, "error": f"action '{action}' annulée"}
        finally:
            if controle_arret is not None:
                controle_arret.retirer(future)

    def capture(self, timeout: Optional[float] = None) -> str:
        """Équivalent direct de InstanceExecutable.capture() -- cf. sa
        docstring pour le comportement complet (capture PNG écrite sur
        disque, self.path mis à jour et retourné, RuntimeError si
        échec)."""
        timeout = timeout if timeout is not None else self._global_defaut("TIMEOUT", None)
        params = {"timeout_action_s": timeout} if timeout is not None else {}
        reponse = self._appeler("capture_propre", params, timeout=timeout)
        if not reponse.get("ok"):
            raise RuntimeError(f"Échec de capture pour l'instance « {self.instance_id} » : {reponse.get('error')}")
        image_b64 = reponse.get("result", {}).get("image_b64")
        image = decoder_image_b64(image_b64) if image_b64 else None
        if image is None:
            raise RuntimeError(f"Capture invalide reçue pour l'instance « {self.instance_id} ».")
        nom_fichier = f"{self.instance_id}_{uuid.uuid4().hex[:8]}.png"
        chemin = get_captures_dir() / nom_fichier
        if not image.save(str(chemin), "PNG"):
            raise RuntimeError(f"Échec d'écriture de la capture sur disque : {chemin}")
        self.path = str(chemin)
        return self.path

    def capture_b64(self, qualite: int = 70, timeout: Optional[float] = None) -> str:
        """capture_b64(qualite=70) -- MÊME capture que capture() et que le bouton de capture du notebook (action « capture_propre »),
        mais retournée en base64 (WebP qualité `qualite`, PNG si Pillow est absent) au lieu d'être écrite sur disque. Indispensable
        sur un sAutoniax : le disque où capture() écrit est celui du clone, pas celui du PC -- l'image doit voyager dans la valeur
        de retour. Lève RuntimeError si la capture échoue."""
        timeout = timeout if timeout is not None else self._global_defaut("TIMEOUT", None)
        params = {"timeout_action_s": timeout} if timeout is not None else {}
        reponse = self._appeler("capture_propre", params, timeout=timeout)
        if not reponse.get("ok"):
            raise RuntimeError(f"Échec de capture pour l'instance « {self.instance_id} » : {reponse.get('error')}")
        image_b64 = reponse.get("result", {}).get("image_b64")
        if not image_b64 or decoder_image_b64(image_b64) is None:
            raise RuntimeError(f"Capture invalide reçue pour l'instance « {self.instance_id} ».")
        return _compresser_capture_webp(image_b64, int(qualite))

    def get_presse_papier(self) -> str:
        """Équivalent direct de InstanceExecutable.get_presse_papier()
        -- cf. sa docstring."""
        reponse = self._appeler("get_clipboard", {})
        if not reponse.get("ok"):
            raise RuntimeError(f"Échec de lecture du presse-papier pour l'instance « {self.instance_id} » : {reponse.get('error')}")
        valeur = reponse.get("result")
        return valeur if isinstance(valeur, str) else ""

    def get_derniere_reponse_assistant(self, selecteur: str,
                                         retry: Optional[int] = None, timeout: Optional[float] = None) -> str:
        """Équivalent direct de InstanceExecutable.get_derniere_reponse_
        assistant() -- cf. sa docstring pour le comportement complet
        (lecture DOM directe via document.querySelectorAll(selecteur),
        dernier élément, .innerText/.textContent -- contourne le
        presse-papier et navigator.clipboard.write()/writeText()).
        selecteur OBLIGATOIRE, aucun défaut -- même raison que la version
        CDP (cf. sa docstring)."""
        retry_resolu = retry if retry is not None else self._global_defaut("RETRY", 0)
        timeout_resolu = timeout if timeout is not None else self._global_defaut("TIMEOUT", None)
        essais_total = 1 + max(0, retry_resolu)
        derniere_erreur = None
        for _ in range(essais_total):
            reponse = self._appeler("get_last_assistant_message", {"selecteur": selecteur}, timeout=timeout_resolu)
            if reponse.get("ok"):
                valeur = reponse.get("result")
                return valeur if isinstance(valeur, str) else ""
            derniere_erreur = reponse.get("error")
        raise RuntimeError(
            f"Échec de lecture de la dernière réponse assistant pour l'instance « {self.instance_id} » "
            f"(selecteur={selecteur!r}, après {essais_total} tentative(s)) : {derniere_erreur}"
        )

    def get_html(self, selecteur: Optional[str] = None,
                 retry: Optional[int] = None, timeout: Optional[float] = None,
                 cadre: Optional[str] = None) -> str:
        """get_html(selecteur=None) -- retourne le code HTML ACTUEL (DOM vivant,
        donc après exécution du JavaScript de la page) de l'ONGLET ACTIF de
        cette instance. Sans argument : document complet (doctype +
        <html>...</html>). Avec `selecteur` (sélecteur CSS, ex. "#main") :
        outerHTML du PREMIER élément trouvé.

        cadre : sélecteur CSS d'une <iframe> de MÊME origine (ex. "iframe.browse-frame") ;
        "a >>> b" pour des iframes imbriquées ; "auto" = la plus grande iframe accessible.
        Le HTML renvoyé est alors celui du document DE L'IFRAME (et `selecteur` s'y applique).
        Limites : sans `cadre`, le contenu des <iframe> n'est pas inclus ; les shadow DOM
        (même ouverts) ne sont jamais inclus. Lève RuntimeError si
        aucun élément ne correspond au sélecteur ou si la lecture échoue,
        après `retry` tentative(s) supplémentaire(s) (défaut : variable RETRY
        de la cellule, 0 si absente)."""
        retry_resolu = retry if retry is not None else self._global_defaut("RETRY", 0)
        timeout_resolu = timeout if timeout is not None else self._global_defaut("TIMEOUT", None)
        essais_total = 1 + max(0, retry_resolu)
        derniere_erreur = None
        for _ in range(essais_total):
            reponse = self._appeler("get_html", {"selecteur": selecteur or "", "cadre": cadre or ""}, timeout=timeout_resolu)
            if reponse.get("ok"):
                valeur = reponse.get("result")
                return valeur if isinstance(valeur, str) else ""
            derniere_erreur = reponse.get("error")
        raise RuntimeError(
            f"Échec de lecture du HTML pour l'instance « {self.instance_id} » "
            f"(selecteur={selecteur!r}, cadre={cadre!r}, après {essais_total} tentative(s)) : {derniere_erreur}"
        )

    def _appel_brut(self, action: str, params: dict, timeout=None) -> dict:
        return self._appeler(action, params, timeout=timeout)

    def _localiser_element(self, selecteur: str, index: int, scroll: bool, timeout=None, cadre=None):
        """(element, erreur) -- l'élément d'index `index` parmi les éléments VISIBLES
        qui correspondent à `selecteur`, éventuellement amené à l'écran."""
        reponse = self._appel_brut("find_elements", {"selecteur": selecteur, "visibles": True, "cadre": cadre or "",
                                                      "index": int(index), "scroll": bool(scroll)}, timeout)
        if not reponse.get("ok"):
            return None, reponse.get("error")
        res = reponse.get("result") or {}
        elements = res.get("elements") or []
        if not elements:
            return None, (f"aucun élément visible d'index {index} pour {selecteur!r} "
                          f"({res.get('total', 0)} élément(s) visible(s) trouvé(s))")
        return elements[0], None

    def elements(self, selecteur: Optional[str] = None, limite: int = 100, visibles_seulement: bool = True,
                 retry: Optional[int] = None, timeout: Optional[float] = None,
                 cadre: Optional[str] = None) -> list:
        """elements(selecteur=None) -- liste les éléments de l'ONGLET ACTIF.
        Sans selecteur : éléments interactifs (liens, boutons, champs, select,
        [role=button]...). Avec un sélecteur CSS : tous les éléments qui y
        correspondent. Retourne une liste de dict : index, tag, id, name, type,
        role, texte, placeholder, valeur (vide pour un mot de passe), href,
        classe, selecteur (sélecteur CSS UNIQUE de cet élément), visible,
        couvert (recouvert par un autre élément), x, y (centre) et
        largeur/hauteur en pixels. `index` = position dans cette liste, la
        même que celle attendue par click_element()/remplir() (qui comptent
        les éléments visibles). `cadre` (sélecteur CSS d'une <iframe> de même origine, ou "auto") :
        liste les éléments DE L'IFRAME ; x, y restent des coordonnées de la fenêtre de l'onglet et
        `selecteur` est à repasser tel quel avec le même `cadre`. Exemple :
            for e in Instance.elements():
                print(e["index"], e["tag"], e["texte"], e["selecteur"])"""
        retry_resolu = retry if retry is not None else self._global_defaut("RETRY", 0)
        timeout_resolu = timeout if timeout is not None else self._global_defaut("TIMEOUT", None)
        essais_total = 1 + max(0, retry_resolu)
        derniere_erreur = None
        for _ in range(essais_total):
            reponse = self._appel_brut("find_elements", {"selecteur": selecteur or "", "limite": int(limite), "cadre": cadre or "",
                                                          "visibles": bool(visibles_seulement)}, timeout_resolu)
            if reponse.get("ok"):
                res = reponse.get("result")
                return list(res.get("elements", [])) if isinstance(res, dict) else []
            derniere_erreur = reponse.get("error")
        raise RuntimeError(f"Échec de elements() pour l'instance « {self.instance_id} » "
                           f"(selecteur={selecteur!r}, après {essais_total} tentative(s)) : {derniere_erreur}")

    def click_element(self, selecteur: str, index: int = 0, bouton: str = "gauche", nb_clics: int = 1,
                      duree_appui_ms: int = 60, speed_percent: float = 0, scroll: bool = True,
                      ignorer_couverture: bool = False, retry: Optional[int] = None,
                      timeout: Optional[float] = None, latence_avant: Optional[float] = None,
                      latence_apres: Optional[float] = None, cadre: Optional[str] = None) -> "ResultatAction":
        """click_element(selecteur, index=0, cadre=None) -- clique sur l'élément ciblé par un
        sélecteur CSS (ex. "#valider", "button[type=submit]", "a[href*=login]").
        L'élément est amené à l'écran (scroll=True), puis le clic part avec la
        trajectoire de souris HUMAINE habituelle, vers un point proche du
        centre. `index` : quel élément visible prendre si plusieurs
        correspondent (0 = le premier). Échec explicite (ResultatAction False)
        si l'élément est introuvable, invisible, ou recouvert par un autre
        (popup, bandeau) -- ignorer_couverture=True pour cliquer quand même.
        `cadre` : sélecteur CSS d'une <iframe> de même origine (ou "auto") -- le sélecteur s'applique
        alors DANS l'iframe (le clic reste un vrai clic souris, aux coordonnées de la fenêtre).
            r = Instance.click_element("button[type=submit]")
            if not r: print(r.message)"""
        retry = retry if retry is not None else self._global_defaut("RETRY", 0)
        timeout = timeout if timeout is not None else self._global_defaut("TIMEOUT", None)
        latence_avant = latence_avant if latence_avant is not None else self._global_defaut("LATENCE_AVANT", 0.0)
        latence_apres = latence_apres if latence_apres is not None else self._global_defaut("LATENCE_APRES", 0.0)
        essais_total = max(1, retry + 1)
        derniere_erreur = None
        for _ in range(essais_total):
            if latence_avant:
                time.sleep(latence_avant)
            el, erreur = self._localiser_element(selecteur, index, scroll, timeout, cadre)
            if el is None:
                derniere_erreur = erreur
                continue
            if el.get("couvert") and not ignorer_couverture:
                derniere_erreur = ("l'élément est recouvert par un autre élément (popup, bandeau...) ; "
                                   "ignorer_couverture=True pour cliquer quand même")
                continue
            x, y = _point_dans_element(el)
            params = {"x": x, "y": y, "bouton": bouton, "duree_appui_ms": duree_appui_ms, "nb_clics": nb_clics,
                      "speedPercent": speed_percent, "instantane": self._global_defaut("SOURIS_INSTANTANEE", False)}
            reponse = self._appel_brut("click", params, timeout)
            if latence_apres:
                time.sleep(latence_apres)
            if reponse.get("ok"):
                return ResultatAction(True)
            derniere_erreur = reponse.get("error")
        return ResultatAction(False, f"Échec de click_element({selecteur!r}, index={index}, cadre={cadre!r}) pour l'instance "
                                     f"« {self.instance_id} » (après {essais_total} tentative(s)) : {derniere_erreur}")

    def remplir(self, selecteur: str, texte: str, index: int = 0, humain: bool = False, vider: bool = True,
                delai_min_ms: int = 60, delai_max_ms: int = 180, scroll: bool = True,
                retry: Optional[int] = None, timeout: Optional[float] = None,
                cadre: Optional[str] = None) -> "ResultatAction":
        """remplir(selecteur, texte, cadre=None) -- met `texte` dans le champ (input, textarea,
        contenteditable) ciblé par un sélecteur CSS.
          - humain=False (défaut) : valeur posée directement + événements
            input/change (instantané, compatible React/Vue). Remplace le contenu.
          - humain=True : clic humain sur le champ, (vider=True) Ctrl+A+Suppr,
            puis frappe caractère par caractère avec délais réalistes -- plus
            lent, mais indiscernable d'une vraie saisie pour les sites sensibles.
            vider=False ajoute le texte à l'endroit du clic.
          - cadre : sélecteur CSS d'une <iframe> de même origine (ou "auto") : le champ est cherché
            DANS l'iframe (fonctionne en mode direct comme en mode humain).
            Instance.remplir("input[name=email]", "moi@exemple.com", humain=True)"""
        retry = retry if retry is not None else self._global_defaut("RETRY", 0)
        timeout = timeout if timeout is not None else self._global_defaut("TIMEOUT", None)
        essais_total = max(1, retry + 1)
        derniere_erreur = None
        for _ in range(essais_total):
            el, erreur = self._localiser_element(selecteur, index, bool(scroll and humain), timeout, cadre)
            if el is None:
                derniere_erreur = erreur
                continue
            if not humain and cadre:
                # dom_paste ne connaît pas les iframes : même logique, exécutée DANS le cadre.
                reponse = self._appel_brut("evaluer_js", {"code": _JS_REMPLIR_DANS_CADRE
                                                          .replace("__SEL__", json.dumps(el["selecteur"]))
                                                          .replace("__TXT__", json.dumps(texte)), "cadre": cadre}, timeout)
                if reponse.get("ok"):
                    res_js = reponse.get("result") or {}
                    if res_js.get("trouve") and not res_js.get("erreur"):
                        return ResultatAction(True)
                    derniere_erreur = res_js.get("erreur") or "élément introuvable dans le cadre"
                else:
                    derniere_erreur = reponse.get("error")
                continue
            if not humain:
                reponse = self._appel_brut("dom_paste", {"selecteur": el["selecteur"], "texte": texte}, timeout)
                if reponse.get("ok"):
                    return ResultatAction(True)
                derniere_erreur = reponse.get("error")
                continue
            x, y = _point_dans_element(el)
            if vider:
                reponse = self._appel_brut("clear", {"x": x, "y": y}, timeout)
                if not reponse.get("ok"):
                    derniere_erreur = reponse.get("error")
                    continue
            reponse = self._appel_brut("type_text", {"x": x, "y": y, "texte": texte, "delai_min_ms": delai_min_ms,
                                                      "delai_max_ms": delai_max_ms, "avec_clic": not vider}, timeout)
            if reponse.get("ok"):
                return ResultatAction(True)
            derniere_erreur = reponse.get("error")
        return ResultatAction(False, f"Échec de remplir({selecteur!r}, index={index}, cadre={cadre!r}) pour l'instance "
                                     f"« {self.instance_id} » (après {essais_total} tentative(s)) : {derniere_erreur}")

    def evaluer_js(self, code: str, cadre: Optional[str] = None,
                   retry: Optional[int] = None, timeout: Optional[float] = None):
        """evaluer_js(code, cadre=None) -- exécute du JavaScript dans l'ONGLET ACTIF (ou dans l'iframe
        `cadre`) et renvoie la valeur obtenue (str, nombre, bool, liste, dict ; None si rien).
          - `code` : UNE expression (renvoyée directement) OU plusieurs instructions avec `return`.
          - Avec `cadre` (sélecteur CSS d'une <iframe> de même origine, "a >>> b" pour des iframes
            imbriquées, "auto" = la plus grande), `document` et `window` désignent ceux DE L'IFRAME.
          - await est utilisable ; un élément DOM renvoyé est converti en son outerHTML.
          - Lève RuntimeError si le JS échoue. PAS de retry automatique (le code peut avoir des
            effets de bord) sauf si `retry` est fourni.
            titre = Instance.evaluer_js("document.title", cadre="iframe.browse-frame")
            html = Instance.evaluer_js("return document.documentElement.outerHTML", cadre="auto")
            Instance.evaluer_js("document.querySelector('#popup').remove()", cadre="auto")"""
        retry_resolu = retry if retry is not None else 0
        timeout_resolu = timeout if timeout is not None else self._global_defaut("TIMEOUT", None)
        essais_total = 1 + max(0, retry_resolu)
        derniere_erreur = None
        for _ in range(essais_total):
            reponse = self._appel_brut("evaluer_js", {"code": code, "cadre": cadre or ""}, timeout_resolu)
            if reponse.get("ok"):
                return reponse.get("result")
            derniere_erreur = reponse.get("error")
        raise RuntimeError(
            f"Échec de evaluer_js pour l'instance « {self.instance_id} » "
            f"(cadre={cadre!r}, après {essais_total} tentative(s)) : {derniere_erreur}"
        )

    def drag(self, chemin_fichier: str, retry: Optional[int] = None, timeout: Optional[float] = None,
              latence_avant: Optional[float] = None, latence_apres: Optional[float] = None) -> "ResultatAction":
        """Équivalent direct de InstanceExecutable.drag() -- cf. sa
        docstring pour le comportement complet (dépose sur le PREMIER
        <input type="file"> trouvé n'importe où sur la page actuellement
        active, PAGE ENTIÈRE, sans viser un point ni un Composant précis).
        AJOUT (même piège que naviguer/list_tabs/scroll/centrer_curseur
        ci-dessous : l'action réseau "drag_page" est déjà câblée côté
        _executer_commande_camoufox -- action_camoufox_drag_page -- mais
        cette méthode publique n'avait jamais été écrite ici)."""
        retry = retry if retry is not None else self._global_defaut("RETRY", 0)
        timeout = timeout if timeout is not None else self._global_defaut("TIMEOUT", None)
        latence_avant = latence_avant if latence_avant is not None else self._global_defaut("LATENCE_AVANT", 0.0)
        latence_apres = latence_apres if latence_apres is not None else self._global_defaut("LATENCE_APRES", 0.0)
        essais_total = max(1, retry + 1)
        derniere_erreur: Optional[str] = None
        for _tentative in range(essais_total):
            if latence_avant:
                time.sleep(latence_avant)
            reponse = self._appeler("drag_page", {"chemin_fichier": chemin_fichier}, timeout=timeout)
            if latence_apres:
                time.sleep(latence_apres)
            if reponse.get("ok"):
                return ResultatAction(True)
            derniere_erreur = reponse.get("error")
        return ResultatAction(
            False,
            f"Échec du drag pour l'instance « {self.instance_id} » "
            f"(après {essais_total} tentative(s)) : {derniere_erreur}",
        )

    def drop(self, chemin_fichier: str, retry: Optional[int] = None, timeout: Optional[float] = None,
              latence_avant: Optional[float] = None, latence_apres: Optional[float] = None) -> "ResultatAction":
        """Alias de drag() (même nommage que InstanceExecutable.drop())."""
        return self.drag(chemin_fichier, retry=retry, timeout=timeout,
                          latence_avant=latence_avant, latence_apres=latence_apres)

    def new_tab(self, url: str, retry: Optional[int] = None, timeout: Optional[float] = None,
                latence_avant: Optional[float] = None, latence_apres: Optional[float] = None) -> "ResultatAction":
        """Équivalent direct de InstanceExecutable.new_tab() -- cf. sa
        docstring pour le comportement complet (retry, ResultatAction
        avec tab_id en cas de succès). SYNCHRONE (cf. docstring de
        classe) -- time.sleep, PAS asyncio.sleep, pour les latences :
        ce thread n'a pas de boucle asyncio à lui, il DOIT bloquer
        réellement, comme le ferait InstanceExecutable en mode Task
        normal."""
        retry = retry if retry is not None else self._global_defaut("RETRY", 0)
        timeout = timeout if timeout is not None else self._global_defaut("TIMEOUT", None)
        timeout_attente_page_s = timeout if timeout is not None else DELAI_ATTENTE_CHARGEMENT_PAGE_DEFAUT_S
        latence_avant = latence_avant if latence_avant is not None else self._global_defaut("LATENCE_AVANT", 0.0)
        latence_apres = latence_apres if latence_apres is not None else self._global_defaut("LATENCE_APRES", 0.0)
        essais_total = max(1, retry + 1)
        derniere_erreur: Optional[str] = None
        # Timeout de l'aller-retour thread -> boucle principale : au
        # moins timeout_attente_page_s + une marge, sinon future.result()
        # couperait AVANT même que _executer_commande_camoufox ait fini
        # d'attendre le chargement de la page en interne.
        timeout_liaison = max(self._TIMEOUT_LIAISON_THREAD_S_DEFAUT, timeout_attente_page_s + 10.0)
        for _tentative in range(essais_total):
            if latence_avant:
                time.sleep(latence_avant)
            reponse = self._appeler(
                "newTab", {"url": url, "timeout_attente_page_s": timeout_attente_page_s}, timeout=timeout_liaison,
            )
            if latence_apres:
                time.sleep(latence_apres)
            if reponse.get("ok"):
                return ResultatAction(True, tab_id=(reponse.get("result") or {}).get("id", ""))
            derniere_erreur = reponse.get("error")
        return ResultatAction(
            False,
            f"Échec d'ouverture d'un nouvel onglet pour l'instance « {self.instance_id} » "
            f"(après {essais_total} tentative(s)) : {derniere_erreur}",
        )

    def naviguer(self, url: str, retry: Optional[int] = None, timeout: Optional[float] = None,
                 latence_avant: Optional[float] = None, latence_apres: Optional[float] = None,
                 bloquer_media: bool = False) -> "ResultatAction":
        """Équivalent direct de InstanceExecutable.naviguer() -- cf. sa
        docstring pour le comportement complet (navigue sur l'onglet
        ACTUELLEMENT actif, sans en ouvrir un nouveau, contrairement à
        new_tab() ci-dessus ; bloquer_media, retry, ResultatAction sans
        tab_id). AJOUT (bug rapporté : AttributeError 'naviguer' absente
        de cette classe, alors que l'action réseau "navigate" est déjà
        câblée côté _executer_commande_camoufox -- même piège que
        list_tabs ci-dessous, seule la méthode publique manquait ici).
        SYNCHRONE (cf. docstring de classe) -- time.sleep, PAS
        asyncio.sleep, même raison que new_tab()."""
        retry = retry if retry is not None else self._global_defaut("RETRY", 0)
        timeout = timeout if timeout is not None else self._global_defaut("TIMEOUT", None)
        timeout_attente_page_s = timeout if timeout is not None else DELAI_ATTENTE_CHARGEMENT_PAGE_DEFAUT_S
        latence_avant = latence_avant if latence_avant is not None else self._global_defaut("LATENCE_AVANT", 0.0)
        latence_apres = latence_apres if latence_apres is not None else self._global_defaut("LATENCE_APRES", 0.0)
        essais_total = max(1, retry + 1)
        derniere_erreur: Optional[str] = None
        timeout_liaison = max(self._TIMEOUT_LIAISON_THREAD_S_DEFAUT, timeout_attente_page_s + 10.0)
        for _tentative in range(essais_total):
            if latence_avant:
                time.sleep(latence_avant)
            reponse = self._appeler(
                "navigate",
                {"url": url, "timeout_attente_page_s": timeout_attente_page_s, "bloquer_media": bloquer_media},
                timeout=timeout_liaison,
            )
            if latence_apres:
                time.sleep(latence_apres)
            if reponse.get("ok"):
                return ResultatAction(True)
            derniere_erreur = reponse.get("error")
        return ResultatAction(
            False,
            f"Échec de navigation vers « {url} » pour l'instance « {self.instance_id} » "
            f"(après {essais_total} tentative(s)) : {derniere_erreur}",
        )

    def switch_tab(self, tab_id: str):
