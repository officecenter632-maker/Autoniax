def _horloge() -> float:
    import time
    return time.monotonic()


class NavigateurFerme(Exception):
    """Levée quand le navigateur (ou sa connexion CDP) a été fermé de façon
    définitive -- cf. tout_en_un.py, correctif déjà validé en conditions
    réelles (transcript fourni) : capturer_frame_reelle distingue une
    erreur CDP transitoire (page pas encore attachée, tolérée avec un
    fallback simulé) d'une déconnexion définitive (navigateur fermé,
    propagée pour arrêter proprement le streaming plutôt que spammer des
    frames de secours à l'infini)."""


class EnregistrementRefuse(Exception):
    """BUG CORRIGÉ (reconnexion automatique bloquée définitivement) : levée
    par _recevoir_messages_serveur quand le serveur répond {"type": "error"}
    à un "register" (ex: "instance 'Default-1' déjà enregistrée" -- cf.
    srv_gerer_register côté serveur, qui refuse un id déjà présent dans
    srv_registre.instances, notamment juste après un redémarrage rapide du
    serveur où l'ancien enregistrement de cette même instance n'a pas
    encore été purgé par srv_retirer_connexion).

    AVANT ce correctif : le cas "error" était seulement loggé (log.error),
    puis la boucle async for continuait normalement -- l'instance restait
    connectée en websocket (aucune exception, donc _session_connexion_
    serveur ne voyait AUCUNE cause de fin de session) mais jamais
    réellement enregistrée côté serveur (son id absent de
    srv_registre.instances), donc invisible du Dashboard et incapable de
    recevoir la moindre commande -- ET la boucle de retry de _main_async
    (qui ne se déclenche que sur ConnectionError/ConnectionClosed) ne se
    redéclenchait JAMAIS non plus, puisqu'aucune exception n'était levée.
    Zombie silencieux, seul un redémarrage du process instance (fermeture
    manuelle du navigateur) en sortait.

    APRÈS : cette exception est levée et propagée jusqu'à _session_
    connexion_serveur, qui la traite comme "connexion_perdue" (cf. usage),
    exactement le même chemin qu'une coupure réseau -- fermeture de la
    connexion en cours puis nouvelle tentative dans DELAI_RECONNEXION_S
    (5s, cf. _main_async), jusqu'à ce que le register soit accepté."""


TIMEOUT_FERMETURE_ONGLET_ARRIERE_PLAN_S = 2

# PATCH (bug Vivaldi/Runtime documenté en tête de fichier -- capture_propre
# qui bloque des dizaines de secondes, retry impuissant car l'appel CDP ne
# revient jamais) : timeout appliqué individuellement à CHAQUE appel CDP
# (page.send) de action_capture_propre/_masquer_curseur_virtuel/
# _reafficher_curseur_virtuel, cf. leurs docstrings.
# OBJECTIF 2 (demande explicite utilisateur) : 5.0s -> 20.0s -- 5s
# déclenchait trop de faux positifs "CDP figé" sous charge normale
# (20 instances Camoufox en parallèle, cf. contexte), en confondant
# contention CPU transitoire et vrai blocage CDP. Même valeur que
# _boucle_streaming_frames (cf. son propre asyncio.wait_for) pour
# rester cohérent.
TIMEOUT_CAPTURE_PROPRE_CDP_S = 20.0


async def _fermer_onglet_arriere_plan(onglet) -> None:
    """Ferme `onglet` en tâche de fond, avec un timeout court, sans jamais
    faire attendre l'appelant (à lancer via asyncio.create_task, jamais
    awaité directement).

    HISTORIQUE -- diagnostiqué via test_reproduction_complete.py (logs
    avant/après chaque await CDP) : certains onglets internes de
    Vivaldi/Chrome -- ex. chrome://vivaldi-webui/startpage, ou
    chrome-extension://.../session-recovery.html (page de récupération de
    session elle-même, ouverte par --restore-last-session) -- ne répondent
    JAMAIS à la commande CDP Target.closeTarget. Or Tab.close() (comme
    tout Tab.send() sous-jacent, cf. nodriver/connection.py) n'a AUCUN
    timeout interne : un `await onglet.close()` sur un de ces onglets
    bloque indéfiniment, sans exception, sans log -- ce qui gelait
    silencieusement tout le démarrage de l'instance (demarrer_navigateur)
    ou tout resetInterface() dès qu'un onglet restauré tombait dans ce
    cas. Cette fonction encapsule le seul fix fiable trouvé : timeout
    court + tolérance à l'échec, appelée en fire-and-forget après que la
    welcome page est déjà affichée -- ces fermetures sont un nettoyage de
    confort, jamais un pré-requis à l'affichage de la page."""
    try:
        await asyncio.wait_for(onglet.close(), timeout=TIMEOUT_FERMETURE_ONGLET_ARRIERE_PLAN_S)
    except asyncio.TimeoutError:
        # PATCH (demande utilisateur) : ne plus logger l'URL brute de
        # l'onglet. Les welcome pages sont des data: URL (cf.
        # _data_url_page_accueil) qui contiennent tout le HTML/CSS/JS
        # encodé -- souvent des dizaines de milliers de caractères -- ce
        # qui polluait le terminal/fichier de log à CHAQUE timeout de
        # fermeture (cas fréquent, cf. RÈGLE 2 plus haut sur les onglets
        # internes Vivaldi qui ne répondent jamais à Target.closeTarget).
        # On logue désormais un résumé court, suffisant pour diagnostiquer
        # (type de page + longueur), jamais le contenu.
        url_brute = onglet.target.url or ""
        if url_brute.startswith("data:"):
            url_resume = f"<data: URL, {len(url_brute)} caractères -- probablement une welcome page AutoniaX>"
        elif len(url_brute) > 120:
            url_resume = url_brute[:120] + f"... ({len(url_brute)} caractères)"
        else:
            url_resume = url_brute
        log.warning(
            f"Fermeture d'un onglet ({onglet.target.target_id}, "
            f"url={url_resume!r}) abandonnée après "
            f"{TIMEOUT_FERMETURE_ONGLET_ARRIERE_PLAN_S}s -- probablement une "
            f"page interne du navigateur qui ne répond pas à "
            f"Target.closeTarget (ex: session-recovery, vivaldi-webui). "
            f"Sans conséquence : l'onglet reste ouvert mais invisible pour "
            f"l'utilisateur, qui voit déjà la welcome page."
        )
    except Exception as e:
        log.warning(f"Fermeture d'un onglet échouée (ignorée) : {e!r}")


def _corriger_exit_type_profil(chemin_profil: str) -> None:
    """Réécrit exit_type="Normal" et exited_cleanly=true dans le(s)
    fichier(s) Preferences du profil Chrome donné, AVANT chaque
    lancement -- cf. demarrer_navigateur, PATCH popup "Restaurer les
    pages ?".

    Chrome stocke ces deux clés sous la racine "profile" du JSON
    Preferences, à l'intérieur de CHAQUE sous-dossier de profil
    (--user-data-dir lui-même contient un ou plusieurs profils : "Default"
    au minimum, éventuellement "Profile 1", "Profile 2", etc. si
    plusieurs profils Chrome ont un jour existé dans ce même
    user-data-dir). On corrige donc TOUS les Preferences trouvés à un
    niveau de profondeur, pas seulement Default/ -- un seul oublié
    suffirait à laisser réapparaître le dialogue si Chrome choisit ce
    profil-là au démarrage.

    Best-effort intentionnel : profil neuf (aucun Preferences pour
    l'instant -- Chrome le créera lui-même à ce premier lancement, rien
    à corriger), JSON absent/corrompu/verrouillé par un autre process --
    dans tous ces cas, on log et on continue SANS lever d'exception :
    ce correctif est un confort visuel, il ne doit jamais empêcher le
    lancement réel de l'instance."""
    try:
        racine = Path(chemin_profil)
        if not racine.is_dir():
            return
        # Default/Preferences existe toujours pour un profil déjà lancé
        # au moins une fois ; Profile 1/, Profile 2/... si applicable.
        candidats = [racine / "Default" / "Preferences"]
        candidats += list(racine.glob("Profile */Preferences"))
        for chemin_prefs in candidats:
            if not chemin_prefs.is_file():
                continue
            try:
                donnees = json.loads(chemin_prefs.read_text(encoding="utf-8"))
            except (OSError, json.JSONDecodeError) as exc:
                log.warning(f"Preferences illisible ({chemin_prefs}), ignoré : {exc}")
                continue
            profil_dict = donnees.setdefault("profile", {})
            if (
                profil_dict.get("exit_type") == "Normal"
                and profil_dict.get("exited_cleanly") is True
            ):
                continue  # déjà propre -- pas de réécriture inutile du fichier
            profil_dict["exit_type"] = "Normal"
            profil_dict["exited_cleanly"] = True
            try:
                chemin_prefs.write_text(
                    json.dumps(donnees, ensure_ascii=False), encoding="utf-8",
                )
            except OSError as exc:
                log.warning(f"Impossible d'écrire Preferences ({chemin_prefs}) : {exc}")
    except Exception as exc:  # noqa: BLE001 -- best-effort, ne jamais bloquer le lancement
        log.warning(f"Correctif exit_type ignoré pour {chemin_profil} : {exc}")


# ---------------------------------------------------------------------------
# PATCH (demande utilisateur : "comment faire pour que la configuration
# géométrique des navigateurs soit sauvegardée pour qu'à leur prochain
# démarrage il l'utilise directement" -- périmètre confirmé : Chrome/Vivaldi
# (nodriver) uniquement, position ET taille, 1920x1080 conservé comme repli
# quand rien n'est sauvegardé) -- mémorisation de la géométrie de la fenêtre.
#
# POURQUOI UNE SURVEILLANCE CONTINUE ET PAS UNE SAUVEGARDE À LA FERMETURE :
# cf. commentaires de demarrer_navigateur -- les instances sont fermées en
# tuant le process (kill_profil, arrêt brutal), jamais via une sortie propre
# de Chrome, et browser.stop() n'est atteint que sur arrêt "propre" (cf.
# _main_async). Aucun hook de fermeture n'est donc fiable : la géométrie
# doit être écrite DÈS qu'elle change, pas au moment où l'instance meurt.
#
# STOCKAGE : un petit fichier JSON DANS le dossier du profil (user_data_dir),
# pas dans profils_config.json -- la géométrie suit ainsi le profil physique
# (copie, sauvegarde, migration du dossier) sans dépendre du nom du profil
# dans le registre (renommer_config_profil/supprimer_config_profil n'ont
# alors rien à faire), et il n'y a aucune écriture concurrente sur le
# registre partagé profils_config.json (plusieurs instances tournent en
# parallèle, chacune dans son propre profil).
# ---------------------------------------------------------------------------
NOM_FICHIER_GEOMETRIE_FENETRE = "geometrie_fenetre_autoniax.json"
# Période de lecture de Browser.getWindowBounds. 2s : assez réactif pour ne
# rien perdre si l'instance est tuée juste après un déplacement/redimension,
# assez rare pour ne pas peser (un seul appel CDP léger, écriture disque
# UNIQUEMENT si la valeur a changé).
INTERVALLE_SURVEILLANCE_GEOMETRIE_FENETRE_S = 2.0
# Un appel CDP sans réponse ne doit jamais geler la surveillance (cf. RÈGLE 1
# de _injecter_page_accueil : Tab.send() n'a AUCUN timeout interne).
TIMEOUT_LECTURE_GEOMETRIE_FENETRE_S = 5.0
# Bornes de validation d'une géométrie lue sur disque OU renvoyée par CDP :
# une valeur hors de ces bornes est traitée comme absente/corrompue, jamais
# appliquée (une fenêtre de 1x1 px ou placée à -32000 -- coordonnée que
# Windows attribue à une fenêtre MINIMISÉE -- serait inutilisable).
LARGEUR_FENETRE_MIN_PX = 300
HAUTEUR_FENETRE_MIN_PX = 200
LARGEUR_FENETRE_MAX_PX = 16384
HAUTEUR_FENETRE_MAX_PX = 16384
POSITION_FENETRE_MIN_PX = -16000
POSITION_FENETRE_MAX_PX = 16000


def _geometrie_fenetre_valide(donnees) -> Optional[dict]:
    """Retourne {"left", "top", "width", "height"} (entiers) si `donnees`
    est un dict décrivant une géométrie utilisable, sinon None. Une seule
    source de vérité pour la validation, appliquée aussi bien à la LECTURE
    du fichier (fichier édité à la main/corrompu) qu'à l'ÉCRITURE (valeur
    renvoyée par CDP) -- jamais deux logiques divergentes.

    Refusés : valeurs non entières (bool exclu -- True == 1 en Python, un
    booléen ne doit jamais passer pour une coordonnée), taille sous le
    minimum ou au-dessus du maximum, position hors bornes (cf.
    POSITION_FENETRE_MIN_PX : couvre le -32000 d'une fenêtre minimisée)."""
    if not isinstance(donnees, dict):
        return None
    resultat: dict[str, int] = {}
    for cle in ("left", "top", "width", "height"):
        valeur = donnees.get(cle)
        if isinstance(valeur, bool):
            return None
        if isinstance(valeur, float) and valeur.is_integer():
            valeur = int(valeur)
        if not isinstance(valeur, int):
            return None
        resultat[cle] = valeur
    if not (LARGEUR_FENETRE_MIN_PX <= resultat["width"] <= LARGEUR_FENETRE_MAX_PX):
        return None
    if not (HAUTEUR_FENETRE_MIN_PX <= resultat["height"] <= HAUTEUR_FENETRE_MAX_PX):
        return None
    for cle in ("left", "top"):
        if not (POSITION_FENETRE_MIN_PX <= resultat[cle] <= POSITION_FENETRE_MAX_PX):
            return None
    return resultat


def _lire_geometrie_fenetre_sauvegardee(chemin_profil: Optional[str]) -> Optional[dict]:
    """Lit la géométrie mémorisée pour le profil `chemin_profil`, ou None
    si absente/illisible/invalide (auquel cas l'appelant retombe sur
    LARGEUR_FENETRE_CHROME x HAUTEUR_FENETRE_CHROME, comportement d'avant ce
    patch). Best-effort : ne lève JAMAIS -- ce confort ne doit pas pouvoir
    empêcher le lancement d'une instance."""
    if not chemin_profil:
        return None
    try:
        chemin = Path(chemin_profil) / NOM_FICHIER_GEOMETRIE_FENETRE
        if not chemin.is_file():
            return None
        geometrie = _geometrie_fenetre_valide(json.loads(chemin.read_text(encoding="utf-8")))
        if geometrie is None:
            log.warning(f"Géométrie de fenêtre ignorée (valeurs invalides) : {chemin}")
        return geometrie
    except Exception as exc:  # noqa: BLE001 -- best-effort, cf. docstring
        log.warning(f"Géométrie de fenêtre illisible pour {chemin_profil} : {exc!r}")
        return None


def _ecrire_geometrie_fenetre(chemin_profil: str, geometrie: dict) -> bool:
    """Écrit `geometrie` (déjà validée) dans le dossier du profil, de façon
    ATOMIQUE (fichier temporaire + os.replace) : l'instance peut être tuée
    à n'importe quel instant, un fichier à moitié écrit ne doit jamais
    exister -- au pire l'ancienne valeur reste en place. Retourne True si
    l'écriture a réussi. Ne lève jamais."""
    chemin_tmp = None
    try:
        dossier = Path(chemin_profil)
        if not dossier.is_dir():
            return False
        chemin = dossier / NOM_FICHIER_GEOMETRIE_FENETRE
        chemin_tmp = chemin.with_name(chemin.name + f".{os.getpid()}.tmp")
        chemin_tmp.write_text(json.dumps(geometrie), encoding="utf-8")
        os.replace(chemin_tmp, chemin)
        return True
    except Exception as exc:  # noqa: BLE001 -- best-effort, cf. docstring
        log.warning(f"Écriture de la géométrie de fenêtre impossible ({chemin_profil}) : {exc!r}")
        if chemin_tmp is not None:
            try:
                chemin_tmp.unlink(missing_ok=True)
            except OSError:
                pass
        return False


async def _lire_geometrie_fenetre_courante(browser, etat_navigateur: Optional[dict] = None) -> Optional[dict]:
    """Interroge Chrome via CDP (Browser.getWindowForTarget) et retourne la
    géométrie de la fenêtre si elle est exploitable, sinon None.

    CORRECTIF (bug rapporté : "ça ne fonctionne pas" -- aucune géométrie
    jamais écrite) : la première version lisait browser.tabs[0]. Or
    browser.tabs est une liste EN CACHE (cf. nodriver Browser.tabs ->
    self._targets, rafraîchie uniquement par update_targets() ou par des
    événements CDP) : son premier élément pouvait être un onglet DÉJÀ FERMÉ
    (l'onglet restauré par --restore-last-session, fermé en arrière-plan
    par _fermer_onglet_arriere_plan juste après le démarrage) -- get_window()
    échouait alors à chaque tour, l'erreur était avalée en log.debug, et
    RIEN n'était jamais écrit. On utilise désormais, dans l'ordre :
      1. etat_navigateur["page"] -- l'onglet ACTIF réel de l'instance, même
         source que toutes les autres actions (cf. switchTab/newTab) ;
      2. à défaut, les onglets de browser.tabs APRÈS update_targets(),
         essayés un par un jusqu'au premier qui répond.
    Toutes les fenêtres d'une instance partagent de toute façon la même
    géométrie tant qu'il n'y a qu'une fenêtre.

    Ignoré volontairement (retourne None -- l'ancienne valeur sauvegardée
    est alors conservée, jamais écrasée par une valeur transitoire) :
      - fenêtre minimisée / maximisée / plein écran : ses left/top/
        width/height ne décrivent pas la fenêtre "normale" que
        --window-position/--window-size sont capables de restaurer ;
      - valeurs hors bornes (cf. _geometrie_fenetre_valide).

    Lève l'exception du DERNIER onglet essayé si AUCUN ne répond (au lieu
    de la masquer en retournant None) : l'appelant, _surveiller_geometrie_
    fenetre, la journalise en warning -- un échec systématique ne doit
    plus jamais rester invisible."""
    candidats = []
    if etat_navigateur is not None and etat_navigateur.get("page") is not None:
        candidats.append(etat_navigateur["page"])
    try:
        await asyncio.wait_for(browser.update_targets(), timeout=TIMEOUT_LECTURE_GEOMETRIE_FENETRE_S)
    except asyncio.TimeoutError:
        pass
    for onglet in list(browser.tabs):
        if onglet not in candidats:
            candidats.append(onglet)
    if not candidats:
        return None

    derniere_erreur: Optional[BaseException] = None
    bounds = None
    for onglet in candidats:
        try:
            _window_id, bounds = await asyncio.wait_for(
                onglet.get_window(), timeout=TIMEOUT_LECTURE_GEOMETRIE_FENETRE_S,
            )
            derniere_erreur = None
            break
        except asyncio.TimeoutError:
            derniere_erreur = TimeoutError(
                f"Browser.getWindowForTarget sans réponse après {TIMEOUT_LECTURE_GEOMETRIE_FENETRE_S}s"
            )
        except Exception as exc:  # noqa: BLE001 -- essayer l'onglet suivant
            derniere_erreur = exc
    if derniere_erreur is not None:
        raise derniere_erreur
    etat = getattr(bounds, "window_state", None)
    nom_etat = getattr(etat, "value", etat)
    if nom_etat not in (None, "normal"):
        return None
    return _geometrie_fenetre_valide({
        "left": bounds.left, "top": bounds.top,
        "width": bounds.width, "height": bounds.height,
    })


async def _surveiller_geometrie_fenetre(
    browser, chemin_profil: Optional[str], instance_id: str = "", etat_navigateur: Optional[dict] = None,
) -> None:
    """Boucle de fond : mémorise la géométrie de la fenêtre dès qu'elle
    change (cf. bloc de commentaires ci-dessus -- pas de sauvegarde à la
    fermeture, les instances étant tuées brutalement). À lancer UNE fois
    par instance via asyncio.create_task, jamais awaitée directement ; elle
    ne se termine que par annulation (fin du process) ou si `chemin_profil`
    est vide (profil sans dossier : rien où écrire).

    Cette surveillance est un confort, elle ne doit JAMAIS pouvoir faire
    tomber l'instance : toute exception est capturée. MAIS -- CORRECTIF
    (bug rapporté : "ça ne fonctionne pas", cause masquée par un
    log.debug) -- les échecs sont journalisés en WARNING, une seule fois
    par message distinct (pas à chaque tour de 2s, cf. derniere_erreur) :
    un échec systématique doit être visible dans les logs, jamais
    silencieux. Un log info n'est émis qu'au CHANGEMENT de géométrie
    effectivement écrit."""
    if not chemin_profil:
        log.warning(f"Instance '{instance_id}' : géométrie de fenêtre NON mémorisée -- aucun dossier de profil.")
        return
    log.info(f"Instance '{instance_id}' : surveillance de la géométrie de fenêtre démarrée -> {chemin_profil}")
    derniere_ecrite = _lire_geometrie_fenetre_sauvegardee(chemin_profil)
    derniere_erreur: Optional[str] = None
    while True:
        try:
            await asyncio.sleep(INTERVALLE_SURVEILLANCE_GEOMETRIE_FENETRE_S)
            courante = await _lire_geometrie_fenetre_courante(browser, etat_navigateur)
            derniere_erreur = None
            if courante is None or courante == derniere_ecrite:
                continue
            if _ecrire_geometrie_fenetre(chemin_profil, courante):
                derniere_ecrite = courante
                log.info(
                    f"Instance '{instance_id}' : géométrie de fenêtre mémorisée -> "
                    f"{courante['width']}x{courante['height']} à ({courante['left']}, {courante['top']})"
                )
        except asyncio.CancelledError:
            raise
        except Exception as exc:  # noqa: BLE001 -- best-effort, cf. docstring
            message = repr(exc)
            if message != derniere_erreur:
                derniere_erreur = message
                log.warning(f"Instance '{instance_id}' : lecture de la géométrie de fenêtre impossible -- {message}")


# ---------------------------------------------------------------------------
# PATCH (demande utilisateur explicite : "es til possible de patcher lapp de
# tels sorte que a la fermeture d'un profil chrome, la derniere page soit
# vraiment restauree, je ne veux plus que le dashboard s'affiche si l'app a
# vraiment sauvegarde la derniere page, et ca va aussi empecher de tout
# recharger la page") -- MÊME PRINCIPE EXACT que la géométrie de fenêtre
# ci-dessus (cf. bloc de commentaires juste au-dessus de
# NOM_FICHIER_GEOMETRIE_FENETRE) : --restore-last-session est fondamentalement
# non fiable ici, PAS à cause de exit_type="Crashed" (déjà corrigé par
# _corriger_exit_type_profil) mais parce que les instances sont fermées en
# TUANT le process (kill_profil/_tuer_pid_direct/SIGTERM+SIGKILL), jamais via
# une vraie fermeture de Chrome -- Chrome n'a alors jamais l'occasion d'écrire
# proprement son propre session storage sur disque avant de mourir. On ne
# dépend donc plus DU TOUT de --restore-last-session pour l'URL affichée :
# on mémorise nous-mêmes, en continu (même intervalle que la géométrie), la
# dernière URL de l'onglet ACTIF réel de l'instance (etat_navigateur["page"],
# même source que _lire_geometrie_fenetre_courante) dans un petit fichier
# JSON DANS le dossier du profil -- écriture atomique, best-effort, jamais
# bloquante. Au prochain lancement (cf. demarrer_navigateur), si une URL valide
# est mémorisée pour ce profil ET qu'aucune url_ouverture explicite n'est
# demandée, on navigue DIRECTEMENT vers cette URL mémorisée au lieu d'afficher
# la welcome page AutoniaX -- un seul Page.navigate, aucun rechargement
# supplémentaire ensuite.
# ---------------------------------------------------------------------------

NOM_FICHIER_DERNIERE_URL = "derniere_url_autoniax.json"
# Même période que la géométrie (cf. INTERVALLE_SURVEILLANCE_GEOMETRIE_FENETRE_S) :
# assez réactif pour ne rien perdre si l'instance est tuée juste après une
# navigation, assez rare pour ne pas peser (écriture disque UNIQUEMENT si
# l'URL a changé).
INTERVALLE_SURVEILLANCE_DERNIERE_URL_S = 2.0

# URLs qu'il est inutile (ou dangereux) de mémoriser comme "dernière page" --
# une about:blank ou une page interne du navigateur redonnerait de toute façon
# un onglet vide au prochain lancement, autant alors afficher la welcome page
# AutoniaX plutôt qu'un onglet blanc silencieux. data: est également exclue :
# c'est le mécanisme même de la welcome page (_data_url_page_accueil) --
# la mémoriser la ferait réapparaître alors que l'utilisateur a justement
# navigué ailleurs depuis (ou, si l'onglet actif EST encore la welcome page,
# il n'y a de toute façon rien d'utile à restaurer).
PREFIXES_URL_NON_MEMORISABLES = (
    "about:", "chrome:", "chrome-extension:", "chrome-error:",
    "devtools:", "vivaldi:", "data:", "edge:",
)


def _url_memorisable(url: Optional[str]) -> bool:
    """True si `url` désigne une vraie page de contenu, qu'il est utile de
    mémoriser comme « dernière page » de ce profil. False pour une URL
    vide/None ou l'un des schémas internes listés ci-dessus (cf.
    PREFIXES_URL_NON_MEMORISABLES)."""
    if not url:
        return False
    url_min = url.strip().lower()
    if not url_min:
        return False
    return not url_min.startswith(PREFIXES_URL_NON_MEMORISABLES)


def _lire_derniere_url_sauvegardee(chemin_profil: Optional[str]) -> Optional[str]:
    """Lit l'URL mémorisée pour le profil `chemin_profil`, ou None si
    absente/illisible/invalide (auquel cas l'appelant retombe sur la welcome
    page AutoniaX, comportement d'avant ce patch). Best-effort : ne lève
    JAMAIS -- ce confort ne doit jamais pouvoir empêcher le lancement d'une
    instance."""
    if not chemin_profil:
        return None
    try:
        chemin = Path(chemin_profil) / NOM_FICHIER_DERNIERE_URL
        if not chemin.is_file():
            return None
        donnees = json.loads(chemin.read_text(encoding="utf-8"))
        url = donnees.get("url") if isinstance(donnees, dict) else None
        if not _url_memorisable(url):
            return None
        return url
    except Exception as exc:  # noqa: BLE001 -- best-effort, cf. docstring
        log.warning(f"Dernière URL illisible pour {chemin_profil} : {exc!r}")
        return None


def _ecrire_derniere_url(chemin_profil: str, url: str) -> bool:
    """Écrit `url` (déjà validée par _url_memorisable) dans le dossier du
    profil, de façon ATOMIQUE (fichier temporaire + os.replace) -- même
    principe que _ecrire_geometrie_fenetre : l'instance peut être tuée à
    n'importe quel instant, un fichier à moitié écrit ne doit jamais exister.
    Retourne True si l'écriture a réussi. Ne lève jamais."""
    chemin_tmp = None
    try:
        dossier = Path(chemin_profil)
        if not dossier.is_dir():
            return False
        chemin = dossier / NOM_FICHIER_DERNIERE_URL
        chemin_tmp = chemin.with_name(chemin.name + f".{os.getpid()}.tmp")
        chemin_tmp.write_text(json.dumps({"url": url}), encoding="utf-8")
        os.replace(chemin_tmp, chemin)
        return True
    except Exception as exc:  # noqa: BLE001 -- best-effort, cf. docstring
        log.warning(f"Écriture de la dernière URL impossible ({chemin_profil}) : {exc!r}")
        if chemin_tmp is not None:
            try:
                chemin_tmp.unlink(missing_ok=True)
            except OSError:
                pass
        return False


async def _surveiller_derniere_url(
    browser, chemin_profil: Optional[str], instance_id: str = "", etat_navigateur: Optional[dict] = None,
) -> None:
    """Boucle de fond : mémorise l'URL de l'onglet actif dès qu'elle change
    (même principe exact que _surveiller_geometrie_fenetre -- pas de
    sauvegarde à la fermeture, les instances étant tuées brutalement). À
    lancer UNE fois par instance via asyncio.create_task, jamais awaitée
    directement ; elle ne se termine que par annulation (fin du process) ou
    si `chemin_profil` est vide (profil sans dossier : rien où écrire).

    Lit etat_navigateur["page"] -- l'onglet ACTIF réel de l'instance, même
    source que _lire_geometrie_fenetre_courante -- plutôt que browser.tabs[0]
    qui peut être un onglet déjà fermé (cf. son docstring pour le détail du
    bug déjà rencontré avec cette approche).

    Cette surveillance est un confort, elle ne doit JAMAIS pouvoir faire
    tomber l'instance : toute exception est capturée et journalisée une
    seule fois par message distinct (jamais à chaque tour de 2s)."""
    if not chemin_profil:
        log.warning(f"Instance '{instance_id}' : dernière URL NON mémorisée -- aucun dossier de profil.")
        return
    log.info(f"Instance '{instance_id}' : surveillance de la dernière URL démarrée -> {chemin_profil}")
    derniere_ecrite = _lire_derniere_url_sauvegardee(chemin_profil)
    derniere_erreur: Optional[str] = None
    while True:
        try:
            await asyncio.sleep(INTERVALLE_SURVEILLANCE_DERNIERE_URL_S)
            page_active = etat_navigateur.get("page") if etat_navigateur else None
            if page_active is None:
                continue
            url_courante = getattr(page_active, "url", None) or getattr(page_active.target, "url", None)
            derniere_erreur = None
            if not _url_memorisable(url_courante) or url_courante == derniere_ecrite:
                continue
            if _ecrire_derniere_url(chemin_profil, url_courante):
                derniere_ecrite = url_courante
                log.info(f"Instance '{instance_id}' : dernière URL mémorisée -> {url_courante}")
        except asyncio.CancelledError:
            raise
        except Exception as exc:  # noqa: BLE001 -- best-effort, cf. docstring
            message = repr(exc)
            if message != derniere_erreur:
                derniere_erreur = message
                log.warning(f"Instance '{instance_id}' : lecture de la dernière URL impossible -- {message}")


DOSSIER_EXTENSIONS_PROXY = _chemin_donnees("cache_extensions_proxy")


# ---------------------------------------------------------------------------
# PATCH (demande utilisateur : « patch autoniax pour que ça démarre désormais
# Chrome avec le minimum de ressources ») -- jeu d'options « Chrome léger »
# appliqué à TOUT lancement Chrome/Vivaldi par nodriver (chemin
# demarrer_navigateur), pas à Feather ni à Camoufox.
#
# Niveaux, via la variable d'environnement AUTONIAX_CHROME_LEGER :
#   "0" -> désactivé (comportement d'avant ce patch)
#   "1" -> léger (DÉFAUT) : coupe les services d'arrière-plan, la mise à jour
#          des composants, la synchro, la traduction, MediaRouter, etc.,
#          limite le nombre de processus de rendu et la taille des caches
#   "2" -> agressif : "1" + --enable-low-end-device-mode + plafond de tas V8
#          (peut faire planter une page très lourde -- à réserver aux
#          machines vraiment justes)
#
# Choix volontaires (NE PAS les « corriger ») :
#   - PAS de --disable-extensions : l'extension d'auto-auth du proxy est
#     chargée par --load-extension (cf. _construire_args_proxy_chrome).
#   - PAS de --blink-settings=imagesEnabled=false : casse les captchas (zone
#     grise vide vue sur Proton) et n'est pas révocable à chaud (cf. SPEC
#     blocage médias, FLAGS_LANCEMENT_BLOCAGE_MEDIA).
#   - PAS de --disable-gpu (déplace la charge vers le CPU), PAS de
#     --single-process (instable), PAS de --mute-audio (les pipelines
#     peuvent avoir besoin du son), PAS de désactivation du BackForwardCache
#     (go_back/go_forward est déjà géré, cf. action_go_back).
#   - nodriver ajoute déjà --disable-features=IsolateOrigins,site-per-process
#     (isolation de site coupée = moins de processus). Chrome ne retient que
#     le DERNIER --disable-features : _fusionner_flags_chrome() fusionne donc
#     tous les --disable-features en UN SEUL, en réincluant ceux de nodriver,
#     sinon l'isolation de site serait réactivée (plus de RAM).
# ---------------------------------------------------------------------------
NIVEAU_CHROME_LEGER = os.environ.get("AUTONIAX_CHROME_LEGER", "1").strip()
NB_PROCESSUS_RENDU_CHROME_MAX = 2

FLAGS_CHROME_LEGER = [
    "--disable-background-networking",
    "--disable-component-update",
    "--disable-default-apps",
    "--disable-sync",
    "--disable-client-side-phishing-detection",
    "--disable-domain-reliability",
    "--disable-component-extensions-with-background-pages",
    "--metrics-recording-only",
    f"--renderer-process-limit={NB_PROCESSUS_RENDU_CHROME_MAX}",
    "--disk-cache-size=52428800",
    "--media-cache-size=10485760",
    "--disable-features=Translate,MediaRouter,OptimizationHints,"
    "OptimizationGuideModelDownloading,AutofillServerCommunication,"
    "InterestFeedContentSuggestions,CertificateTransparencyComponentUpdater",
]
FLAGS_CHROME_LEGER_AGRESSIF = [
    "--enable-low-end-device-mode",
    "--js-flags=--max-old-space-size=1024",
    "--disable-smooth-scrolling",
]
# Fonctionnalités déjà désactivées par nodriver (cf. Config.__call__) --
# à conserver dans le --disable-features fusionné.
FEATURES_DESACTIVEES_PAR_NODRIVER = ["IsolateOrigins", "site-per-process"]


def _flags_chrome_leger() -> list:
    """Flags « Chrome léger » selon AUTONIAX_CHROME_LEGER (voir plus haut)."""
    if NIVEAU_CHROME_LEGER == "0":
        return []
    flags = list(FLAGS_CHROME_LEGER)
    if NIVEAU_CHROME_LEGER == "2":
        flags += FLAGS_CHROME_LEGER_AGRESSIF
    return flags


def _fusionner_flags_chrome(args: list) -> list:
    """Fusionne tous les --disable-features= en un seul (Chrome ignore tous
    sauf le dernier), réinclut ceux de nodriver, et retire les doublons en
    gardant l'ordre."""
    prefixe = "--disable-features="
    features = list(FEATURES_DESACTIVEES_PAR_NODRIVER)
    autres = []
    for a in args:
        if a.startswith(prefixe):
            features += [f for f in a[len(prefixe):].split(",") if f]
        elif a not in autres:
            autres.append(a)
    vues = []
    for f in features:
        if f not in vues:
            vues.append(f)
    return autres + [prefixe + ",".join(vues)]


def _construire_args_proxy_chrome(proxy: Optional[dict], instance_id: str) -> list[str]:
    """PATCH (demande utilisateur explicite : "es til possible de activer
    un proxy" sur un profil Chrome standard) -- jusqu'ici, le chemin
    Chrome/nodriver (demarrer_navigateur ci-dessous) ignorait totalement
    le proxy du profil : `proxy` n'apparaissait même pas dans sa
    signature, et enregistrer_config_profil/obtenir_config_profil
    stockaient déjà cette donnée pour TOUS les types (cf. docstring de
    _on_clic_nouveau_profil : "Le proxy n'est pas réservé à Camoufox")
    sans qu'elle soit jamais lue au lancement réel pour "chrome"/
    "vivaldi" (seul Camoufox, via camoufox_demarrer_navigateur, l'utilisait
    -- cf. son propre correctif "diag-proxy").

    Construit les browser_args nodriver/Chrome nécessaires pour ce
    proxy : --proxy-server=protocole://host:port TOUJOURS (couvre le cas
    sans authentification, host:port seul). Si user/password sont
    présents, --proxy-server seul ne suffit PAS -- Chrome (contrairement
    à Camoufox/Firefox, qui accepte proxy.username/proxy.password
    directement dans le fingerprint) n'a AUCUN flag CLI pour fournir des
    identifiants de proxy : sans rien de plus, une popup d'authentification
    HTTP Basic bloquerait chaque lancement, incompatible avec un usage
    automatisé/headless. --load-extension=<dossier> avec une extension
    Manifest V3 minimale générée à la volée (cf. _generer_extension_
    auth_proxy_chrome) répond automatiquement à webRequest.onAuthRequired
    avec ces identifiants, sans aucune interaction utilisateur -- solution
    standard pour ce problème connu de Chrome/Chromium.

    Retourne une liste vide si `proxy` est None ou sans host (rien à
    ajouter, comportement Chrome inchangé)."""
    if not proxy or not proxy.get("host"):
        return []
    protocole = proxy.get("protocole") or "http"
    host = proxy["host"]
    port = proxy.get("port")
    serveur = f"{protocole}://{host}:{port}" if port else f"{protocole}://{host}"
    args = [f"--proxy-server={serveur}"]
    if proxy.get("user"):
        dossier_extension = _generer_extension_auth_proxy_chrome(proxy, instance_id)
        if dossier_extension is not None:
            args.append(f"--load-extension={dossier_extension}")
            # Nécessaire depuis Chrome 137+ : --load-extension seul est
            # désormais ignoré en dehors du mode développeur explicite
            # (cf. changelog Chrome -- durcissement anti-abus des
            # extensions non empaquetées). Sans ce flag, l'extension
            # d'auto-auth ne se charge simplement pas, silencieusement,
            # et la popup d'authentification réapparaît.
            args.append("--enable-unsafe-extension-debugging")
    return args


def _generer_extension_auth_proxy_chrome(proxy: dict, instance_id: str) -> Optional[Path]:
    """Génère (à chaque lancement, écrase l'ancien contenu si présent --
    les identifiants peuvent changer d'un profil à l'autre, jamais de
    résidu d'un proxy précédent) un dossier d'extension Chrome non
    empaquetée Manifest V3 minimale, dédiée à CETTE instance (dossier
    nommé par instance_id -- plusieurs instances Chrome tournant en
    parallèle avec des proxies différents ne doivent jamais partager le
    même dossier d'extension, sous peine de courses/écrasements croisés).

    Le mot de passe est écrit en clair dans background.js sur le DISQUE
    LOCAL de la machine qui lance l'instance (jamais transmis au-delà) --
    même niveau d'exposition que le fichier profils_config.json local
    lui-même, qui contient déjà ce mot de passe en clair.

    chrome.webRequest.onAuthRequired (permission "webRequest"/
    "webRequestAuthProvider", host_permissions "<all_urls>") intercepte
    la demande d'authentification du proxy et répond directement avec
    les identifiants -- AUCUNE fenêtre de dialogue n'est jamais affichée
    à l'utilisateur, contrairement au comportement Chrome par défaut sans
    cette extension.

    Retourne None (log d'erreur, --load-extension omis par l'appelant --
    le proxy fonctionne quand même pour le trafic, seule l'auth sera
    manquante) si l'écriture sur disque échoue."""
    dossier = DOSSIER_EXTENSIONS_PROXY / _nom_dossier_valide(instance_id)
    try:
        dossier.mkdir(parents=True, exist_ok=True)
        manifest = {
            "manifest_version": 3,
            "name": "Auth proxy AutoniaX (généré automatiquement)",
            "version": "1.0",
            "permissions": ["webRequest", "webRequestAuthProvider"],
            "host_permissions": ["<all_urls>"],
            "background": {"service_worker": "background.js"},
            "minimum_chrome_version": "108",
        }
        (dossier / "manifest.json").write_text(
            json.dumps(manifest, ensure_ascii=False, indent=2), encoding="utf-8",
        )
        # json.dumps sur les identifiants (pas une simple f-string) --
        # échappe correctement un éventuel guillemet/backslash dans le
        # user/password, plutôt que de générer un background.js invalide
        # (ou pire, injectable) si ces caractères apparaissent un jour.
        user_js = json.dumps(proxy.get("user") or "")
        password_js = json.dumps(proxy.get("password") or "")
        background_js = (
            "chrome.webRequest.onAuthRequired.addListener(\n"
            "  function(details, callback) {\n"
            "    callback({authCredentials: {username: " + user_js + ", password: " + password_js + "}});\n"
            "  },\n"
            "  {urls: [\"<all_urls>\"]},\n"
            "  [\"asyncBlocking\"]\n"
            ");\n"
        )
        (dossier / "background.js").write_text(background_js, encoding="utf-8")
        log.info(f"[proxy-chrome] extension d'auto-auth générée pour '{instance_id}' -> {dossier}")
        return dossier
    except OSError as e:
        log.error(f"[proxy-chrome] génération de l'extension d'auto-auth échouée pour '{instance_id}' ({e!r}) -- le proxy fonctionnera mais une popup d'authentification pourrait apparaître.")
        return None


# ---------------------------------------------------------------------------
# PATCH Feather -- pilotage du navigateur maison Feather (featherBrowser.pyw).
#
# Feather est une app pywebview/WebView2 (= Chromium). Lancée avec --cdp-port,
# elle expose un port de debug CDP standard : nodriver s'y connecte
# (nodriver.start(host=, port=) = connexion à un navigateur DÉJÀ lancé, aucun
# exécutable Chrome n'est démarré). Toute la couche d'actions existante
# (clics, captures, saisie, etc.) fonctionne donc sans changement.
#
# Particularités :
#   - une seule vue : on réutilise l'onglet existant, jamais de new_tab
#     (un 2e onglet CDP serait invisible dans la fenêtre Feather) ;
#   - Feather est lancé avec --sans-barre : la barre d'adresse injectée
#     décalerait la page de 28 px et fausserait les captures/détections ;
#   - mode headless non supporté (WebView2 exige une vraie fenêtre) ;
#   - proxy : seul un proxy SANS authentification est supporté (WebView2
#     n'accepte pas les extensions qui gèrent l'auth du proxy).
# Local uniquement (Windows / mAutoniax) : rien à faire côté sAutoniax.
# ---------------------------------------------------------------------------
FEATHER_SCRIPT = Path(r"D:\ScaleTube\CHANNELS\IngeniaX\Code\AutoniaX\Feather\featherBrowser.pyw")
FEATHER_SANS_BARRE = True          # False : garder la barre d'adresse Feather (décale la page de 28 px)
FEATHER_TIMEOUT_CDP_S = 45.0       # attente max de l'ouverture du port CDP
FEATHER_GEOMETRIE_PAR_DEFAUT = (70, 5, 1129, 1026)  # gauche, haut, largeur, hauteur (comme Chrome)

_PROCESSUS_FEATHER: dict = {}      # instance_id -> subprocess.Popen


def _port_local_libre() -> int:
    with socket.socket(socket.AF_INET, socket.SOCK_STREAM) as sock:
        sock.bind(("127.0.0.1", 0))
        return sock.getsockname()[1]


def _python_sans_console() -> str:
    exe = sys.executable
    if exe.lower().endswith("python.exe"):
        candidat = exe[:-len("python.exe")] + "pythonw.exe"
        if os.path.exists(candidat):
            return candidat
    return exe


def _arreter_feather(instance_id: str) -> None:
    """Ferme le process Feather de cette instance (no-op si absent)."""
    proc = _PROCESSUS_FEATHER.pop(instance_id, None)
    if proc is None:
        return
    try:
        if proc.poll() is None:
            proc.terminate()
            try:
                proc.wait(timeout=5)
            except Exception:  # noqa: BLE001
                proc.kill()
    except Exception as exc:  # noqa: BLE001
        log.debug(f"Arrêt de Feather (instance '{instance_id}') ignoré : {exc!r}")


def _cdp_pret(port: int) -> bool:
    try:
        with urllib.request.urlopen(f"http://127.0.0.1:{port}/json/version", timeout=1.5) as rep:
            return rep.status == 200
    except Exception:  # noqa: BLE001
        return False


async def _demarrer_feather(profil, url_cible, page_accueil_demandee, instance_id, download_dir, proxy,
                            headless: bool = False, nom_profil=None):
    import nodriver

    if not FEATHER_SCRIPT.exists():
        raise FileNotFoundError(f"Feather introuvable : {FEATHER_SCRIPT} (cf. FEATHER_SCRIPT dans AutoniaX)")
    if headless:
        log.warning("Feather ne supporte pas le mode headless -- fenêtre visible lancée quand même.")

    port = _port_local_libre()
    geom = _lire_geometrie_fenetre_sauvegardee(profil)
    if geom is not None:
        g = (geom["left"], geom["top"], geom["width"], geom["height"])
    else:
        g = FEATHER_GEOMETRIE_PAR_DEFAUT

    commande = [
        _python_sans_console(), str(FEATHER_SCRIPT),
        "--cdp-port", str(port),
        "--images",  # les captures/détections ont besoin des images
        "--geometrie", ",".join(str(int(v)) for v in g),
        "--titre", f"Feather · {nom_profil or instance_id}",
    ]
    if FEATHER_SANS_BARRE:
        commande.append("--sans-barre")
    if profil:
        commande += ["--dossier-profil", str(profil)]
    if proxy and proxy.get("host"):
        if proxy.get("user"):
            log.warning("Feather : proxy avec identifiants non supporté (pas d'extension d'auth sous WebView2) -- lancé SANS proxy.")
        else:
            serveur = f"{proxy.get('protocole') or 'http'}://{proxy['host']}" + (f":{proxy['port']}" if proxy.get("port") else "")
            commande += ["--proxy-server", serveur]
            log.info(f"Proxy Feather activé : {serveur}")
    commande.append("about:blank")

    log.info(f"Lancement de Feather (port CDP {port}) ...")
    proc = subprocess.Popen(commande, stdout=subprocess.DEVNULL, stderr=subprocess.DEVNULL)
    _PROCESSUS_FEATHER[instance_id] = proc
    try:
        debut = time.monotonic()
        while not await asyncio.to_thread(_cdp_pret, port):
            if proc.poll() is not None:
                raise RuntimeError(
                    f"Feather s'est arrêté (code {proc.returncode}) avant d'ouvrir son port CDP "
                    f"-- profil déjà ouvert dans une autre fenêtre Feather ?"
                )
            if time.monotonic() - debut > FEATHER_TIMEOUT_CDP_S:
                raise RuntimeError(f"Failed to connect to browser (Feather n'a pas ouvert son port CDP {port} en {FEATHER_TIMEOUT_CDP_S:.0f}s)")
            await asyncio.sleep(0.4)

        # browser_executable_path : jamais lancé (connexion à un navigateur existant),
        # mais nodriver exige un chemin valide -- sys.executable existe toujours.
        browser = await nodriver.start(
            host="127.0.0.1", port=port,
            user_data_dir=profil,
            browser_executable_path=sys.executable,
        )
        for tentative in range(1, 21):
            await browser.update_targets()
            if browser.tabs:
                break
            log.info(f"En attente de la page Feather (tentative {tentative}/20) ...")
            await asyncio.sleep(0.5)
        if not browser.tabs:
            raise RuntimeError("Feather n'expose aucune page CDP.")
        page = browser.tabs[0]

        if page_accueil_demandee:
            await _injecter_page_accueil(page, instance_id)
        elif url_cible and url_cible != "about:blank":
            await page.get(url_cible)

        await _aligner_fuseau_horaire_proxy(page, proxy, instance_id)
        await _assurer_permissions_presse_papier(page)
        if download_dir:
            await _appliquer_download_dir(page, download_dir, instance_id)
    except BaseException:
        _arreter_feather(instance_id)
        raise
    log.info(f"Navigateur Feather lancé avec succès -> {'welcome page AutoniaX' if page_accueil_demandee else url_cible}")
    return browser, page


async def demarrer_navigateur(navigateur: str, executable: str | None, profil: str | None, url_ouverture: str | None = None, instance_id: str = "", download_dir: str | None = None, proxy: Optional[dict] = None, headless: bool = False, nom_profil: str | None = None):
    """download_dir (cf. PATCH_projet_batch.md, section 6) : si fourni,
    applique Browser.setDownloadBehavior('allow', download_path=download_dir)
    juste après que la page soit prête -- tous les téléchargements
    déclenchés par cette instance atterrissent dans ce dossier précis
    (le download/ du sous-projet en cours de traitement, cf.
    MoteurExecutionBatch). None (par défaut) : comportement Chrome
    inchangé, aucun appel CDP supplémentaire.

    Browser.setDownloadBehavior (pas Page.setDownloadBehavior, dépréciée
    depuis CDP 1.3) -- vérifié disponible dans la version de nodriver
    utilisée ici (cf. cdp.browser.set_download_behavior). Sans
    browser_context_id : s'applique au contexte par défaut, suffisant
    puisqu'il n'y a qu'un seul profil/contexte par instance.

    BUGFIX (erreur constatée sur sAutoniax Kaggle/Colab -- Exception
    "Failed to connect to browser" au lancement d'un profil "chrome" :
    nodriver.start() attendait la réponse HTTP du port de debug CDP du
    process Chrome fraîchement lancé, jamais obtenue) -- `headless` (AJOUT,
    False par défaut pour ne rien changer au comportement existant en
    lancement interactif pilote) était REÇU par _main_async (cf. son
    paramètre du même nom, déjà branché correctement vers
    camoufox_demarrer_navigateur pour le navigateur "camoufox") mais
    n'était jusqu'ici JAMAIS transmis à cette fonction pour "chrome"/
    "vivaldi" -- Chrome démarrait donc toujours en mode fenêtré normal
    (aucun "--headless" dans browser_args), qui exige un vrai serveur
    d'affichage X. Sur une machine sAutoniax Kaggle/Colab (aucun DISPLAY,
    cf. AUTONIAX_OFFSCREEN en tête de ce fichier -- qui ne concerne QUE Qt,
    jamais Chrome), Chrome échouait alors à ouvrir correctement son port
    de debug CDP -- d'où le timeout "Failed to connect to browser" côté
    nodriver (son propre message suggère `no_sandbox=True`, mais la vraie
    cause ici était l'absence de mode headless, PAS le sandbox -- déjà
    auto-désactivé par nodriver lui-même en environnement root, cf. sa
    propre détection is_root() dans Config.__init__). Passé tel quel à
    nodriver.start(headless=...), qui ajoute lui-même "--headless=new" à
    la volée (cf. Config.__call__) -- comportement natif de Chrome
    109+, fonctionne SANS aucun serveur X, symétrique du traitement déjà
    fait pour Camoufox/Firefox (cf. camoufox_demarrer_navigateur,
    correctif "headless" du fingerprint)."""
    import nodriver

    # PATCH (demande utilisateur) : au démarrage, on ne veut PLUS jamais
    # voir les onglets de la session précédente -- uniquement la page
    # d'accueil AutoniaX (welcome page), seule et unique, quel que soit ce
    # que --restore-last-session a rouvert. url_ouverture reste prioritaire
    # si explicitement fourni (site d'ouverture personnalisé par instance,
    # cf. DashboardScreen) ; sinon on ouvre un about:blank marqué qui
    # recevra le HTML de la welcome page directement par CDP juste après
    # (cf. _injecter_page_accueil, thème Anthropic/Claude codé en dur
    # dans ce fichier -- plus de fichier disque, plus de chemin externe
    # D:\ScaleTube\..., plus de welcome_{id}.html).
    # PATCH (demande utilisateur explicite : "je ne veux plus que le
    # dashboard s'affiche si l'app a vraiment sauvegardé la dernière page")
    # -- avant d'imposer la welcome page par défaut, on regarde si une
    # dernière URL a été mémorisée pour CE profil précis par
    # _surveiller_derniere_url (cf. son bloc de commentaires, juste avant
    # DOSSIER_EXTENSIONS_PROXY, pour le raisonnement complet : on ne compte
    # plus du tout sur --restore-last-session, non fiable ici puisque les
    # instances sont tuées brutalement). Une url_ouverture explicite
    # (site d'ouverture personnalisé par instance, cf. DashboardScreen)
    # reste TOUJOURS prioritaire sur cette URL mémorisée, exactement comme
    # elle l'était déjà sur la welcome page.
    derniere_url_memorisee = _lire_derniere_url_sauvegardee(profil) if url_ouverture is None else None
    page_accueil_demandee = url_ouverture is None and derniere_url_memorisee is None
    # Peu importe l'URL initiale de cet onglet si c'est la welcome page qui
    # est demandée : _injecter_page_accueil l'écrase de toute façon juste
    # après par un Page.navigate direct vers la data: URL finale (cf.
    # _injecter_page_accueil). Le marqueur about:blank#... n'est donc plus
    # nécessaire ici. Si une dernière URL a été mémorisée, c'est elle qui
    # devient la cible d'ouverture -- un seul Page.navigate vers cette URL
    # (via browser.get() plus bas), jamais de rechargement supplémentaire
    # ensuite.
    url_cible = url_ouverture or derniere_url_memorisee or "about:blank"
    if derniere_url_memorisee:
        log.info(
            f"Dernière page mémorisée pour ce profil -> restauration directe de "
            f"{derniere_url_memorisee!r} (welcome page ignorée)."
        )

    if navigateur == "feather":
        # PATCH Feather -- chemin dédié : pas de Chrome à lancer, on démarre
        # featherBrowser.pyw avec un port CDP puis nodriver s'y CONNECTE.
        return await _demarrer_feather(
            profil, url_cible, page_accueil_demandee, instance_id, download_dir, proxy,
            headless=headless, nom_profil=nom_profil,
        )

    chemin_exe = executable or EXECUTABLES_CONNUS.get(navigateur)
    # PATCH (diagnostic proxy Chrome, même esprit que le log équivalent
    # côté camoufox_demarrer_navigateur) -- avant ce correctif, rien
    # n'indiquait dans les logs si un proxy était réellement pris en
    # compte pour ce lancement Chrome/Vivaldi, ce qui compliquait le
    # diagnostic (cf. le bug "proxy transmis mais silencieusement
    # ignoré" déjà rencontré côté sAutoniax/type_instance). host/port
    # seulement -- jamais user/password en clair dans les logs.
    if proxy and proxy.get("host"):
        log.info(f"Proxy Chrome activé pour cette instance : {proxy.get('protocole') or 'http'}://{proxy['host']}:{proxy.get('port') or '(défaut)'} (auth extension : {'oui' if proxy.get('user') else 'non'})")
    log.info(f"Lancement du navigateur ({navigateur}, exécutable={chemin_exe or '(auto-détecté)'}) ...")
    # --restore-last-session conservé (cf. décision utilisateur d'origine) :
    # utile pour préserver cookies/état de connexion des sites déjà visités
    # dans CE profil persistant. Mais les onglets qu'il rouvre ne sont plus
    # affichés tels quels (cf. fermeture ci-dessous) -- seule la welcome
    # page reste visible. Sans profil persistant (user_data_dir=None), ce
    # flag n'a simplement aucun effet -- rien à conditionner ici.
    #
    # PATCH (retour utilisateur : "il ya toujour ce maudit message popup
    # Restaurer les pages ?") -- CORRECTIF #2, --disable-session-crashed-
    # bubble (tenté d'abord) s'est révélé sans effet : nodriver l'ajoute
    # DÉJÀ tout seul par défaut (cf. Config._default_browser_args et
    # Config.__call__ dans le package nodriver -- vérifié dans le code
    # source installé), donc notre ajout explicite ne changeait rien. Et
    # ce flag ne couvre de toute façon que l'ancienne INFOBAR discrète
    # sous la barre d'adresse -- le popup vu ici est une vraie boîte de
    # dialogue MODALE ("Restaurer les pages ?"), un composant Chrome
    # différent, pas concerné par ce flag.
    #
    # Cause racine réelle : Chrome marque exit_type="Crashed" dans le
    # fichier Preferences du profil dès qu'il ne se termine pas proprement
    # -- systématique ici puisque les instances sont fermées en tuant le
    # process (cf. commentaires plus haut), jamais via une sortie propre
    # de Chrome. Au lancement SUIVANT, Chrome lit cette valeur et affiche
    # ce dialogue. _corriger_exit_type_profil réécrit exit_type="Normal"
    # dans TOUS les dossiers profil (Default + Profile N) AVANT de
    # démarrer Chrome -- le prochain lancement ne voit donc plus jamais
    # de sortie "Crashed", quelle que soit la façon dont l'instance
    # précédente a été arrêtée.
    if profil:
        _corriger_exit_type_profil(profil)
    # PATCH (demande utilisateur explicite : "es til possible de activer
    # un proxy" sur un profil Chrome standard) -- cf. docstring de
    # _construire_args_proxy_chrome pour le détail complet (--proxy-server
    # + extension d'auto-auth générée si user/password présents). Liste
    # vide si `proxy` est None -- browser_args reste alors identique à
    # avant ce correctif, aucun changement de comportement pour les
    # profils sans proxy.
    # PATCH (demande utilisateur explicite : "pour chrome on garde une
    # seule résolution ... je voulais la taille plein écran natifs normal
    # classique", en distinguant explicitement de Camoufox : "cest
    # camoufox qui est aleatoire") -- contrairement à Camoufox (résolution
    # tirée par BrowserForge, éventuellement contrainte via
    # contraintes_ecran/_construire_screen_camoufox_depuis_contraintes,
    # cf. plus haut dans ce fichier), Chrome/nodriver n'a JAMAIS eu de
    # taille de fenêtre explicite : sans --window-size, Chrome retombe sur
    # une taille par défaut minuscule et non garantie (800x600, parfois
    # moins en --headless=new selon la plateforme, cf. bugs Chromium
    # connus) -- c'est ce qui produisait un rendu "mal formaté"/tronqué
    # dans le panneau d'aperçu distant (StockageCloudScreen n'est pas
    # concerné, il s'agit ici du flux vidéo capturer_frame_reelle, qui
    # capture exactement le viewport réel de l'onglet, capture_beyond_
    # viewport=False). Une SEULE résolution desktop standard fixe,
    # volontairement STATIQUE (pas de tirage aléatoire ni de contrainte
    # min/max façon Camoufox -- décision explicite : "on garde une seul
    # resolution"), appliquée à TOUTE instance Chrome/Vivaldi, headless ou
    # non : --window-size fonctionne aussi bien en mode fenêtré classique
    # qu'en --headless=new (cf. Config.__call__ nodriver, qui ajoute déjà
    # --headless=new séparément, cf. paramètre `headless` ci-dessus).
    # --force-device-scale-factor=1 : neutralise un éventuel scaling DPI
    # hérité de la machine hôte (Kaggle/Colab n'ayant de toute façon aucun
    # écran physique dont hériter un DPI), pour que LARGEUR_FENETRE_CHROME
    # x HAUTEUR_FENETRE_CHROME soit la taille RÉELLE du viewport capturé,
    # jamais mise à l'échelle.
    #
    # PATCH (demande utilisateur : mémoriser la géométrie des navigateurs
    # d'un lancement à l'autre, cf. _surveiller_geometrie_fenetre) -- si une
    # géométrie valide a été sauvegardée pour CE profil, elle PREND LE
    # DESSUS : --window-size ET --window-position en dérivent. Sinon
    # (premier lancement, fichier absent/corrompu/hors bornes) :
    # 1920x1080 exactement comme avant ce patch, sans --window-position
    # (Chrome place alors la fenêtre lui-même).
    geometrie_sauvegardee = _lire_geometrie_fenetre_sauvegardee(profil)
    if geometrie_sauvegardee is not None:
        log.info(
            f"Géométrie de fenêtre restaurée pour ce profil : "
            f"{geometrie_sauvegardee['width']}x{geometrie_sauvegardee['height']} "
            f"à ({geometrie_sauvegardee['left']}, {geometrie_sauvegardee['top']})"
        )
        args_resolution_fixe = [
            f"--window-size={geometrie_sauvegardee['width']},{geometrie_sauvegardee['height']}",
            f"--window-position={geometrie_sauvegardee['left']},{geometrie_sauvegardee['top']}",
            "--force-device-scale-factor=1",
        ]
    else:
        # PATCH (demande utilisateur explicite : "pour un profil de chrome
        # qui demare et qui na pas de position anterieur sauvegarder tu
        # dois desormais appliquer la config suivante : 1129x1026 à
        # (70, 5)") -- remplace l'ancien comportement (1920x1080 SANS
        # --window-position, Chrome plaçant alors la fenêtre lui-même) :
        # dorénavant, un profil sans géométrie sauvegardée (premier
        # lancement, fichier absent/corrompu/hors bornes) démarre
        # directement avec cette taille ET cette position fixes, au lieu
        # de dépendre du placement par défaut de Chrome. LARGEUR_FENETRE_
        # CHROME/HAUTEUR_FENETRE_CHROME (1920x1080) restent définies et
        # inchangées ailleurs dans le fichier (documentation/valeurs de
        # référence) mais ne sont plus utilisées ici pour ce cas.
        args_resolution_fixe = [
            "--window-size=1129,1026",
            "--window-position=70,5",
            "--force-device-scale-factor=1",
        ]
    args_proxy = _construire_args_proxy_chrome(proxy, instance_id)
    # AJOUT (SPEC §2.4, couche 3 « empêcher l'émission de la requête ») --
    # flags ajoutés UNIQUEMENT si le toggle « bloquer médias » de ce profil
    # est déjà ON au lancement. Volontairement PAS de
    # --blink-settings=imagesEnabled=false ni de content-setting images=2 :
    # ils ne sont pas révocables sans redémarrage, ce qui casserait
    # l'exigence « révocable à tout moment même si le profil a déjà démarré »
    # (cf. _gm_flags_lancement pour le raisonnement complet).
    args_media = _gm_flags_lancement(nom_profil, profil)
    if args_media:
        log.info(f"Blocage médias actif au lancement -- flags moteur ajoutés : {' '.join(args_media)}")
    log.info(f"Chrome léger : niveau {NIVEAU_CHROME_LEGER!r} ({len(_flags_chrome_leger())} flags ajoutés).")
    browser = await nodriver.start(
        browser_executable_path=chemin_exe,
        user_data_dir=profil,
        browser_args=_fusionner_flags_chrome(
            ["--restore-last-session"] + args_resolution_fixe + args_proxy + args_media + _flags_chrome_leger()
        ),
        headless=headless,
    )
    # nodriver.Browser.get() fait next(filter(item.type_ == "page", ...))
    # sur self.targets en interne : tant que self.targets ne contient aucun
    # target de type "page", cet appel lève StopIteration -- que Python
    # (PEP 479) convertit en RuntimeError('coroutine raised StopIteration')
    # puisqu'on est dans une coroutine. self.targets N'EST PAS rafraîchi
    # automatiquement en continu : il ne se remplit que via les événements
    # CDP TargetCreated (si le navigateur les émet à temps) ou via un appel
    # explicite à update_targets(). Se contenter d'attendre puis de
    # réessayer browser.get() (comme avant) ne suffit pas si ces événements
    # n'arrivent jamais assez vite sur Vivaldi -- il faut forcer nous-mêmes
    # le rafraîchissement et vérifier browser.tabs (qui filtre déjà sur
    # type_=="page") avant de retenter.
    NB_TENTATIVES_ATTENTE_PAGE = 20
    DELAI_ENTRE_TENTATIVES_S = 0.5
    for tentative in range(1, NB_TENTATIVES_ATTENTE_PAGE + 1):
        await browser.update_targets()
        if browser.tabs:
            break
        log.info(
            f"En attente d'une page exposée par le navigateur (tentative "
            f"{tentative}/{NB_TENTATIVES_ATTENTE_PAGE}) ..."
        )
        await asyncio.sleep(DELAI_ENTRE_TENTATIVES_S)
    else:
        log.info(
            "Aucune page détectée après l'attente -- tentative de "
            "browser.get() quand même (dernier recours, peut échouer)."
        )
    # PATCH (demande utilisateur) : on ouvre TOUJOURS un nouvel onglet vers
    # la welcome page en PREMIER (garantit qu'un onglet "vivant" existe
    # avant de fermer quoi que ce soit -- fermer TOUS les onglets d'un
    # profil éteint le process Chrome/Vivaldi entier, cf. retour utilisateur
    # explicite), PUIS on ferme tout ce qui a pu être restauré par
    # --restore-last-session. Jamais l'inverse (fermer d'abord) : il y
    # aurait un instant, même bref, où plus aucun onglet n'existe.
    onglets_restaures = list(browser.tabs)
    # HISTORIQUE (tentative abandonnée -- demande utilisateur : "sa veut que
    # je soit connecter pour rechargez encore la page") : une version
    # antérieure de ce patch essayait de RÉUTILISER tel quel un onglet
    # restauré par --restore-last-session (recherche par correspondance
    # d'URL dans onglets_restaures) pour éviter tout Page.navigate
    # supplémentaire. Abandonné après recherche : un onglet restauré au
    # démarrage reste "discarded" (non chargé) tant qu'il n'est pas activé,
    # et Chrome l'expose alors comme un target de type "tab" (architecture
    # MPArch) -- PAS "page". Or browser.tabs (nodriver) filtre strictement
    # sur type_ == "page" (cf. Browser.tabs dans nodriver/core/browser.py),
    # donc ces onglets restaurés-mais-pas-encore-chargés n'apparaissent
    # jamais dans onglets_restaures : la correspondance d'URL ne pouvait
    # objectivement rien trouver. Par ailleurs, --restore-last-session
    # lui-même a TOUJOURS rechargé les pages depuis le réseau dès qu'elles
    # redeviennent actives (comportement natif de Chrome, pas une
    # particularité de nodriver) -- il n'existe donc pas de mécanisme CDP
    # fiable pour une restauration "gratuite" sans requête réseau. On
    # revient donc ici à une navigation explicite simple (browser.get
    # ci-dessous) : un SEUL Page.navigate vers la dernière URL mémorisée
    # (derniere_url_memorisee, cf. plus haut) quand elle existe, ce qui
    # reste largement suffisant pour éviter le Dashboard et tout
    # rechargement RÉPÉTÉ -- la session/les cookies restent de toute façon
    # intacts (profil persistant), donc aucune reconnexion n'est requise
    # malgré ce rechargement.
    #
    # HISTORIQUE -- CORRECTIF #4 (blocage indéfini au démarrage) : le
    # 'await page' qui suivait directement ce browser.get() a été retiré.
    # browser.get() a déjà retourné l'objet Tab prêt à l'emploi (attend en
    # interne que le target existe) ; un second await dessus n'existe dans
    # aucun des scripts de repro qui fonctionnent et est superflu ici.
    page = await browser.get(url_cible, new_tab=True)
    # PATCH (demande utilisateur) : plus d'écriture sur disque -- si c'est
    # la welcome page qui doit s'afficher (pas d'url_ouverture explicite),
    # on injecte le HTML directement dans cet onglet fraîchement créé via
    # CDP Page.setDocumentContent, une fois qu'il est bien sur le
    # about:blank marqué (cf. _injecter_page_accueil / incident
    # file:// qui restait bloqué sur about:blank sans erreur remontée).
    if page_accueil_demandee:
        await _injecter_page_accueil(page, instance_id)
    # HISTORIQUE -- CORRECTIF #5 (blocage indéfini au démarrage,
    # diagnostiqué via test_reproduction_complete.py) : 'await onglet.close()'
    # SANS timeout, ici, bloquait indéfiniment tout le démarrage de
    # l'instance quand l'un des onglets restaurés par --restore-last-session
    # était une page interne de Vivaldi (ex: chrome://vivaldi-webui/startpage,
    # ou chrome-extension://.../session-recovery.html) -- ces onglets ne
    # répondent JAMAIS à Target.closeTarget envoyé via CDP, et Tab.close()
    # (comme tout Tab.send()) n'a aucun timeout interne. Fix : fermeture en
    # arrière-plan (fire-and-forget, timeout court par onglet) -- la welcome
    # page est déjà affichée à ce stade (juste au-dessus), donc ces
    # fermetures n'ont plus besoin de bloquer le retour de la fonction.
    for onglet in onglets_restaures:
        asyncio.create_task(_fermer_onglet_arriere_plan(onglet))
    url_effective = "welcome page AutoniaX (injectée par CDP, aucun fichier disque)" if page_accueil_demandee else url_cible
    # PATCH (demande utilisateur : "comment regler maintenant la date et
    # lheur du navigatuer chrome pour que il utilse celui de mon proxy
    # natifs") -- posé ici, après que `page` existe mais AVANT le log de
    # succès, pour la même raison que _assurer_permissions_presse_papier
    # juste en dessous : un avertissement éventuel (fuseau non détecté/
    # non appliqué) doit rester visible près du reste du démarrage,
    # jamais noyé plus tard dans les logs de streaming. Ne fait RIEN
    # (aucune requête réseau) si `proxy` est None -- comportement Chrome
    # inchangé pour les profils sans proxy, cf. docstring de la fonction.
    # Fonctionne identiquement que ce soit un proxy externe classique OU
    # le tunnel 127.0.0.1:<port> du proxy natif (cf. _resoudre_proxy_
    # effectif_profil) : dans les deux cas la détection traverse la
    # vraie sortie internet du proxy, jamais la machine sAutoniax elle-même.
    await _aligner_fuseau_horaire_proxy(page, proxy, instance_id)
    # Accordé une fois ici, pas à chaque copy/paste (cf. docstring de la
    # fonction) -- avant le log de succès pour que l'avertissement
    # éventuel (permissions non accordées) reste visible près du reste du
    # démarrage plutôt que noyé plus tard dans les logs de streaming.
    await _assurer_permissions_presse_papier(page)
    if download_dir:
        await _appliquer_download_dir(page, download_dir, instance_id)
    log.info(f"Navigateur lancé avec succès -> {url_effective}")
    return browser, page


# ---------------------------------------------------------------------------
# PATCH (demande utilisateur : "des que ça crash, automatiquement on retente
# 3 fois avant de complètement tuer le process") -- retry automatique du
# DÉMARRAGE du navigateur Chrome/Vivaldi (nodriver). Périmètre : uniquement
# l'échec au démarrage (nodriver.start / connexion CDP / injection de la
# welcome page), pas un crash survenu plus tard pendant que l'instance
# tourne. Camoufox non concerné (chemin séparé, cf. camoufox_demarrer_navigateur).
#
# CAUSE VISÉE (logs rapportés : "Failed to connect to browser" et
# "Page.navigate n'a reçu aucune réponse CDP après 4.0s", surtout quand
# plusieurs profils démarrent en même temps) : Chrome démarre trop lentement
# sous charge CPU/disque et manque sa fenêtre de connexion CDP. Le même
# lancement, retenté quelques secondes plus tard, aboutit en général.
#
# POINT CRITIQUE -- nettoyage AVANT chaque nouvelle tentative : quand
# nodriver.start() échoue avec "Failed to connect to browser", nodriver NE TUE
# PAS le Chrome qu'il vient de lancer (le process reste enregistré dans
# nodriver.core.util.get_registered_instances() et n'est arrêté qu'à la SORTIE
# du process Python, via son hook atexit -- c'est ce qui produisait le log
# "terminated browser with pid ..." APRÈS "erreur fatale"). Un retry dans le
# même process laisserait donc ce Chrome vivant, qui garde le dossier du
# profil verrouillé : la tentative suivante échouerait à coup sûr. On arrête
# donc explicitement tout Chrome apparu pendant la tentative ratée, et on
# attend sa fin réelle, avant de réessayer.
# ---------------------------------------------------------------------------
# Nombre de RÉESSAIS après le premier échec (3 réessais = 4 tentatives au
# total). Mettre 0 pour désactiver complètement le retry.
NB_REESSAIS_DEMARRAGE_NAVIGATEUR = 3
# Attente avant le réessai n°k : DELAI_BASE * k + gigue aléatoire dans
# [0, GIGUE_MAX]. La gigue est là pour DÉSYNCHRONISER des instances qui ont
# échoué ensemble : sans elle, elles réessaieraient toutes au même instant et
# recréeraient la surcharge qui les a fait échouer.
DELAI_BASE_REESSAI_DEMARRAGE_S = 3.0
GIGUE_MAX_REESSAI_DEMARRAGE_S = 2.0
# Temps maximum d'attente de la fin réelle d'un Chrome orphelin tué, pour que
# le verrou de son dossier de profil soit libéré avant la tentative suivante.
TIMEOUT_FIN_PROCESS_ORPHELIN_S = 3.0


def _instances_nodriver_enregistrees() -> set:
    """Copie de l'ensemble des Browser nodriver actuellement enregistrés
    (cf. nodriver.core.util.get_registered_instances). Retourne un set vide
    si l'API interne est indisponible -- best-effort : sans elle, le retry
    fonctionne quand même, seul le nettoyage des orphelins est perdu."""
    try:
        from nodriver.core import util as nd_util
        return set(nd_util.get_registered_instances())
    except Exception as exc:  # noqa: BLE001 -- best-effort, cf. docstring
        log.debug(f"Instances nodriver enregistrées illisibles : {exc!r}")
        return set()


async def _nettoyer_navigateurs_orphelins(instances_avant: set, instance_id: str = "") -> int:
    """Arrête tout Chrome/Vivaldi apparu depuis `instances_avant` (instantané
    pris AVANT la tentative de démarrage) qui tourne encore, et attend sa
    fin réelle (max TIMEOUT_FIN_PROCESS_ORPHELIN_S chacun) pour que le
    verrou du dossier de profil soit libéré. Retourne le nombre de
    navigateurs orphelins arrêtés. Ne lève jamais : un nettoyage raté est
    journalisé, la tentative suivante aura simplement plus de chances
    d'échouer -- ce n'est pas une raison de tout casser ici."""
    nb_arretes = 0
    for navigateur_orphelin in _instances_nodriver_enregistrees() - instances_avant:
        # Le process est lu AVANT stop() : stop() peut remettre _process à None.
        processus = getattr(navigateur_orphelin, "_process", None)
        try:
            if navigateur_orphelin.stopped:
                continue
            navigateur_orphelin.stop()
            nb_arretes += 1
        except Exception as exc:  # noqa: BLE001 -- best-effort, cf. docstring
            log.warning(f"Instance '{instance_id}' : arrêt d'un navigateur orphelin impossible -- {exc!r}")
            continue
        if processus is not None:
            try:
                await asyncio.wait_for(processus.wait(), timeout=TIMEOUT_FIN_PROCESS_ORPHELIN_S)
            except asyncio.TimeoutError:
                log.warning(
                    f"Instance '{instance_id}' : un navigateur orphelin n'est pas terminé après "
                    f"{TIMEOUT_FIN_PROCESS_ORPHELIN_S}s -- le profil peut rester verrouillé pour la tentative suivante."
                )
            except Exception as exc:  # noqa: BLE001 -- best-effort, cf. docstring
                log.debug(f"Attente de fin d'un navigateur orphelin -- {exc!r}")
    return nb_arretes


async def _demarrer_navigateur_avec_reessais(
    navigateur: str, executable: str | None, profil: str | None, url_ouverture: str | None = None,
    instance_id: str = "", download_dir: str | None = None, proxy: Optional[dict] = None, headless: bool = False,
    nom_profil: str | None = None,
):
    """demarrer_navigateur() avec retry automatique : au 1er échec, arrête
    proprement le Chrome resté à moitié démarré, attend un délai croissant
    (avec gigue), puis réessaie -- jusqu'à NB_REESSAIS_DEMARRAGE_NAVIGATEUR
    réessais. Si TOUTES les tentatives échouent, la DERNIÈRE exception est
    relancée telle quelle : l'appelant (_main_async -> main_instance_nodriver)
    la journalise comme "erreur fatale" et arrête le process, exactement
    comme avant ce patch.

    Pas de réessai pour FileNotFoundError (exécutable Chrome introuvable) :
    c'est un problème permanent, réessayer ne ferait que perdre du temps.
    asyncio.CancelledError/KeyboardInterrupt ne sont jamais interceptés
    (ce ne sont pas des Exception) -- un arrêt demandé pendant le démarrage
    n'est pas retardé par les réessais."""
    nb_tentatives_max = 1 + max(0, NB_REESSAIS_DEMARRAGE_NAVIGATEUR)
    for tentative in range(1, nb_tentatives_max + 1):
        instances_avant = _instances_nodriver_enregistrees()
        try:
            return await demarrer_navigateur(
                navigateur, executable, profil, url_ouverture, instance_id, download_dir, proxy, headless=headless,
                nom_profil=nom_profil,
            )
        except FileNotFoundError:
            raise
        except Exception as exc:
            # Message nodriver multi-lignes (tirets, retours à la ligne) -> une seule ligne courte.
            # "Failed to connect to browser" est remplacé par un libellé net : son texte d'origine
            # parle de "root"/no_sandbox, sans rapport avec le cas réel (Chrome trop lent à ouvrir
            # son port de debug CDP, surtout sous Windows / au lancement simultané de plusieurs profils).
            brut = " ".join(str(exc).split())
            if "Failed to connect to browser" in brut:
                resume = "Failed to connect to browser (Chrome n'a pas ouvert son port de debug CDP à temps)"
            else:
                resume = brut[:160] + ("..." if len(brut) > 160 else "")
            resume = f"{type(exc).__name__}: {resume}" if resume else repr(exc)
            nb_arretes = await _nettoyer_navigateurs_orphelins(instances_avant, instance_id)
            _arreter_feather(instance_id)  # PATCH Feather : pas de fenêtre orpheline entre deux tentatives
            if tentative >= nb_tentatives_max:
                log.error(
                    f"Instance '{instance_id}' : démarrage du navigateur ÉCHOUÉ après {nb_tentatives_max} "
                    f"tentative(s) -- abandon. Dernière erreur : {resume}"
                )
                raise
            delai = DELAI_BASE_REESSAI_DEMARRAGE_S * tentative + random.uniform(0, GIGUE_MAX_REESSAI_DEMARRAGE_S)
            log.warning(
                f"Instance '{instance_id}' : échec du démarrage du navigateur (tentative {tentative}/{nb_tentatives_max}) "
                f"-- {resume}. {nb_arretes} navigateur(s) orphelin(s) arrêté(s). "
                f"Nouvelle tentative dans {delai:.1f}s ..."
            )
            await asyncio.sleep(delai)
    raise RuntimeError("_demarrer_navigateur_avec_reessais : sortie de boucle inattendue")  # inatteignable


async def _appliquer_download_dir(page, download_dir: str, instance_id: str = "") -> bool:
    """Applique Browser.setDownloadBehavior('allow', download_path=...) sur
    une page CDP déjà ouverte -- extrait de demarrer_navigateur pour être
    réutilisable aussi bien au DÉMARRAGE d'une instance (cf. ci-dessus) qu'à
    CHAUD sur une instance déjà connectée et réutilisée entre plusieurs
    sous-projets d'un même ProjetBatch (cf. action réseau "set_download_dir",
    PATCH "Projet Batch" -- réutilisation d'instances déjà lancées plutôt
    qu'un subprocess dédié par sous-projet).

    mkdir défensif : le dossier download/ d'un sous-projet est déjà créé
    par valider_conformite_projet_batch() avant tout démarrage (cf. section
    2 du patch), mais un appelant hors de ce flux (test manuel, usage
    direct) ne passe pas forcément par cette validation -- Chrome refuse
    silencieusement les téléchargements si downloadPath n'existe pas
    encore, mieux vaut le garantir ici que déboguer un téléchargement
    "perdu" plus tard.

    Non bloquant par construction : retourne True/False plutôt que de
    lever, une erreur CDP secondaire ne doit jamais empêcher le reste du
    Task/de l'instance de continuer (cohérent avec le reste de ce fichier,
    ex. capturer_frame_reelle). L'appelant peut logguer/agir selon le
    retour s'il le souhaite (cf. _executer_commande, action
    "set_download_dir", qui traduit un False en command_result ok=False)."""
    Path(download_dir).mkdir(parents=True, exist_ok=True)
    try:
        await page.send(
            cdp.browser.set_download_behavior(behavior="allow", download_path=download_dir)
        )
        log.info(f"Téléchargements de l'instance '{instance_id}' redirigés vers {download_dir}")
        return True
    except Exception as e:
        log.warning(f"Échec de configuration du dossier de téléchargement ({download_dir!r}) : {e!r}")
        return False


# NOTE (décision utilisateur) : une tentative de détection automatique de
# l'onglet réellement affiché à l'écran (via document.visibilityState) a
# été retirée ici -- elle ne fonctionne pas de façon fiable sur un
# navigateur piloté par CDP/automation : Chrome/Chromium/Vivaldi forcent
# artificiellement ce champ à "visible" sur les onglets attachés au
# débogueur, qu'ils soient réellement au premier plan ou non (mécanisme
# interne d'émulation de focus, utilisé pour rendre l'automation
# déterministe). CDP n'a exposé aucun champ fiable et natif pour "onglet
# visuellement actif côté tab-strip" avant Chrome 150 (mai 2026,
# `embedderData.tabActive` sur `Target.getTargets`), et cette version de
# nodriver ne le supporte pas encore. On reste donc sur le mécanisme
# d'origine : etat_navigateur["page"] n'est mis à jour QUE par une
# commande switchTab explicite du pilote (cf. action_switch_tab
# ci-dessus) -- fiable à 100%, au prix de ne pas suivre un changement
# d'onglet fait à la main par l'utilisateur dans la fenêtre Vivaldi.


async def capturer_frame_reelle(page, instance_id: str, haute_qualite: bool = False) -> str | None:
    """Cf. tout_en_un.py pour la justification complète (pas de
    Tab.save_screenshot(), qui cache un sleep ~1s incompatible avec un flux
    à plusieurs images/seconde -- appel direct à la commande CDP bas
    niveau à la place). Retourne None pour une erreur transitoire (à
    tolérer avec un fallback), laisse remonter l'exception pour une
    déconnexion définitive (à ne PAS masquer).

    Cf. action_new_tab pour le diagnostic complet du bug Vivaldi (onglet
    créé en arrière-plan = canal Runtime.* mort) -- cette fonction n'est
    pas directement en cause (le blocage survient avant, dans
    action_capture_propre/_masquer_curseur_virtuel), mais hérite du même
    onglet potentiellement affecté.

    PATCH (même bug, cf. _masquer_curseur_virtuel) : page.send() sur
    capture_screenshot n'avait lui non plus AUCUN timeout -- appelé
    directement par _boucle_streaming_frames, il était déjà protégé côté
    appelant par un asyncio.wait_for(..., timeout=5.0) externe. Mais
    action_capture_propre (cellule de test OpenCV, PAS le streaming)
    appelle cette fonction SANS ce filet -- d'où le blocage de 40+
    secondes observé en usage réel (RETRY impuissant : l'appel ne revient
    jamais, il n'y a rien à "retry"). Le timeout est donc posé ICI, à la
    source, pour protéger TOUS les appelants (streaming et
    capture_propre) sans dépendre de chacun d'eux pour s'en souvenir."""
    t0 = _horloge()
    try:
        image_b64 = await asyncio.wait_for(
            page.send(
                cdp.page.capture_screenshot(
                    # PATCH capture haute qualité (bouton capture de la barre) :
                    # PNG sans perte, encodage non optimisé pour la vitesse.
                    # Le streaming garde JPEG qualité 65 (haute_qualite=False).
                    format_="png" if haute_qualite else FORMAT_CAPTURE,
                    quality=None if haute_qualite else QUALITE_CAPTURE_JPEG,
                    capture_beyond_viewport=False,
                    optimize_for_speed=False if haute_qualite else OPTIMISER_ENCODAGE_POUR_VITESSE,
                )
            ),
            timeout=TIMEOUT_CAPTURE_PROPRE_CDP_S,
        )
        if not image_b64:
            log.warning("Capture CDP réussie mais image_b64 vide/None")
            return None
        return image_b64
    except asyncio.TimeoutError:
        log.warning(
            f"capturer_frame_reelle() : timeout CDP après {TIMEOUT_CAPTURE_PROPRE_CDP_S}s "
            f"(bug Vivaldi/Runtime probable, cf. action_new_tab) -- capture abandonnée pour "
            f"cette tentative, laisse le RETRY de l'appelant reprendre la main"
        )
        return None
    except (ConnectionError, websockets.exceptions.ConnectionClosed) as e:
        log.warning(f"capturer_frame_reelle() : déconnexion réelle détectée -- {e!r}")
        raise
    except Exception as e:
        duree = _horloge() - t0
        # exc_info=True force le logger à imprimer le traceback entier,
        # indispensable pour distinguer une exception CDP nommée d'un
        # blocage réel (timeout géré par l'appelant, cf.
        # _boucle_streaming_frames / _consommer_file_commandes).
        log.error(
            f"capturer_frame_reelle() : échec après {duree:.3f}s -- type={type(e).__name__} repr={e!r}",
            exc_info=True,
        )
        log.warning(f"Échec de capture CDP ({e!r})")
        return None


def generer_capture_simulee(instance_id: str, motif: str = "démarrage") -> str:
    """Fallback affiché pendant les tout premiers instants (CDP pas encore
    attaché) -- PAS pour une déconnexion définitive (cf. NavigateurFerme,
    qui arrête le streaming plutôt que d'appeler cette fonction pour
    toujours)."""
    import base64
    import io
    try:
        from PIL import Image, ImageDraw
        img = Image.new("RGB", (640, 360), color=(30, 30, 46))
        draw = ImageDraw.Draw(img)
        draw.multiline_text((30, 150), f"[EN ATTENTE]\nInstance: {instance_id}\n({motif})", fill=(205, 214, 244))
        buf = io.BytesIO()
        img.save(buf, format="PNG")
        return base64.b64encode(buf.getvalue()).decode("ascii")
    except ImportError:
        png_1x1_gris = base64.b64decode(
            "iVBORw0KGgoAAAANSUhEUgAAAAEAAAABCAQAAAC1HAwCAAAAC0lEQVR42mNk+A8AAQUBAScY42YAAAAASUVORK5CYII="
        )
        return base64.b64encode(png_1x1_gris).decode("ascii")


# ---------------------------------------------------------------------------
# Actions (cf. cahier des charges 4.2) -- toutes exécutées via CDP/nodriver
# sur `page` (l'onglet actif, sauf switchTab qui en change explicitement,
# cf. 4.5/5.5). Chaque fonction lève l'exception CDP telle quelle en cas
# d'échec ; c'est _executer_commande qui attrape et transforme en réponse
# d'erreur pour ne jamais faire planter la boucle de réception.
# ---------------------------------------------------------------------------

# --- Curseur virtuel (4.3) : petit cercle translucide bleu injecté dans
# la page (PATCH -- demande explicite utilisateur : "le dsing du curseur
# virtuels ... cest trop moche, je veux juste que tu met un cercel
# translucide qui a la couleur bleu" -- remplace l'ancien cercle jaune à
# bordure sombre opaque), suit moveCursor/click, jamais d'interception de
# clic réel (pointer-events: none). Un seul appel JS idempotent (id fixe) :
# ne crée l'élément qu'une fois par page, le repositionne sinon. Couleur
# alignée sur Mocha.blue (#89b4fa = rgb(137, 180, 250)), déjà utilisée
# partout ailleurs dans l'app -- pas une teinte bleue arbitraire. ---
JS_CURSEUR_ASSURER_ET_DEPLACER = """
(function(x, y) {
    var c = document.getElementById('__autoniax_curseur_virtuel__');
    if (!c) {
        c = document.createElement('div');
        c.id = '__autoniax_curseur_virtuel__';
        c.style.position = 'fixed';
        c.style.width = '20px';
        c.style.height = '20px';
        c.style.borderRadius = '50%';
        c.style.background = 'rgba(137, 180, 250, 0.35)';
        c.style.border = '1.5px solid rgba(137, 180, 250, 0.75)';
        c.style.pointerEvents = 'none';
        c.style.zIndex = '2147483647';
        c.style.transition = 'left 0.05s linear, top 0.05s linear';
        c.style.transform = 'translate(-50%, -50%)';
        document.documentElement.appendChild(c);
    }
    c.style.left = __AUTONIAX_X__ + 'px';
    c.style.top = __AUTONIAX_Y__ + 'px';
})(__AUTONIAX_X__, __AUTONIAX_Y__);
"""
# BUG CORRIGÉ (trouvé en testant action_type_text, présent depuis le
# premier jet -- touchait TOUTES les actions, pas seulement celle-ci) :
# le CSS ci-dessus contient plusieurs '%' littéraux (border-radius: 50%,
# translate(-50%, -50%)) qui entraient en conflit avec l'opérateur de
# formatage % de Python -- '50%' était lu comme le début d'un
# spécificateur de format invalide et levait ValueError, silencieusement
# avalée par le except Exception de _deplacer_curseur_virtuel (prévu pour
# tolérer une page pas encore prête, pas pour masquer une erreur de code
# systématique). Le curseur virtuel n'a donc jamais été réellement injecté
# depuis le début, sans qu'aucune erreur ne remonte nulle part -- corrigé
# via des marqueurs uniques + .replace(), qui ne peuvent entrer en
# collision avec aucun caractère du CSS (contrairement à % ou à
# .format()/f-string, qui auraient le même problème avec les accolades
# CSS ({ }) déjà présentes dans ce template).


async def _deplacer_curseur_virtuel(page, x: int, y: int):
    """Injecte/déplace le cercle translucide bleu (4.3). Erreur non
    bloquante -- un échec de curseur virtuel (page sans body pas encore
    chargée, etc.) ne doit jamais empêcher l'action réelle (moveCursor/
    click) de s'exécuter."""
    script = (
        JS_CURSEUR_ASSURER_ET_DEPLACER
        .replace("__AUTONIAX_X__", str(int(x)))
        .replace("__AUTONIAX_Y__", str(int(y)))
    )
    try:
        await page.send(cdp.runtime.evaluate(script))
    except Exception as e:
        log.debug(f"Curseur virtuel non déplacé (page pas prête ?) : {e!r}")


# --- Masquage temporaire du curseur virtuel pour capture_propre --
# uniquement pour la capture dédiée à la détection OpenCV (cf.
# action_capture_propre) : le curseur reste un élément DOM (position
# fixed) tant qu'il a été positionné une fois sur la page -- une capture
# CDP le voit systématiquement, ce qui fausserait matchTemplate/ORB/SSIM
# (faux positifs sur le cercle, ou décalage de la zone recherchée si le
# curseur chevauche le composant cherché). display='none' plutôt que
# suppression de l'élément : évite de perdre sa position (left/top déjà
# posés par JS_CURSEUR_ASSURER_ET_DEPLACER) et reste réversible en un
# aller-retour CDP minimal, pas un recalcul de style complet. Si
# l'élément n'existe pas encore (aucun moveCursor/click envoyé avant le
# tout premier test), querySelector renvoie null -- l'opérateur ?. rend
# les deux scripts idempotents sans erreur JS dans ce cas.
JS_CURSEUR_MASQUER = (
    "var __c = document.getElementById('__autoniax_curseur_virtuel__'); "
    "if (__c) { __c.style.display = 'none'; }"
)
JS_CURSEUR_REAFFICHER = (
    "var __c = document.getElementById('__autoniax_curseur_virtuel__'); "
    "if (__c) { __c.style.display = ''; }"
)


async def _masquer_curseur_virtuel(page):
    """Cache le curseur virtuel avant une capture_propre. Erreur non
    bloquante -- même logique tolérante que _deplacer_curseur_virtuel :
    une page pas encore prête ne doit jamais empêcher la capture elle-même
    de s'exécuter (au pire le curseur reste visible sur cette capture,
    pas idéal mais jamais bloquant).

    Cf. action_new_tab pour le bug Vivaldi (canal Runtime.* mort sur un
    onglet créé en arrière-plan) qui peut faire traîner cet appel bien
    au-delà du "page pas prête" attendu par le commentaire ci-dessus.

    PATCH (résolution définitive du bug Vivaldi/Runtime pour
    capture_propre) : le except Exception ci-dessous ne protégeait QUE
    contre une exception effectivement levée par page.send() -- pas
    contre le cas réel du bug (aucune exception, aucune réponse, silence
    total indéfini). asyncio.wait_for force une TimeoutError explicite
    après TIMEOUT_CAPTURE_PROPRE_CDP_S, qui EST une exception et tombe
    donc bien dans le except ci-dessous -- l'appel se libère enfin au
    lieu de bloquer éternellement."""
    try:
        await asyncio.wait_for(
            page.send(cdp.runtime.evaluate(JS_CURSEUR_MASQUER)),
            timeout=TIMEOUT_CAPTURE_PROPRE_CDP_S,
        )
    except Exception as e:
        log.debug(f"Curseur virtuel non masqué (page pas prête ?) : {e!r}")


async def _reafficher_curseur_virtuel(page):
    """Réaffiche le curseur virtuel après une capture_propre -- toujours
    tenté même si la capture elle-même a échoué (cf. action_capture_propre,
    try/finally), pour ne jamais laisser le curseur durablement invisible
    dans le flux de streaming normal suite à un test.

    PATCH : même timeout explicite que _masquer_curseur_virtuel (cf. sa
    docstring) -- sans ça, ce finally pouvait lui-même bloquer
    indéfiniment sur le bug Vivaldi/Runtime, empêchant même l'exception
    de capturer_frame_reelle de remonter à l'appelant."""
    try:
        await asyncio.wait_for(
            page.send(cdp.runtime.evaluate(JS_CURSEUR_REAFFICHER)),
            timeout=TIMEOUT_CAPTURE_PROPRE_CDP_S,
        )
    except Exception as e:
        log.debug(f"Curseur virtuel non réaffiché (page pas prête ?) : {e!r}")


async def action_move_cursor(page, x: int, y: int):
    """moveCursor(x, y) -- déplace le curseur virtuel seulement, aucun
    événement souris réel envoyé au navigateur (cf. 4.2 : distinct de
    mousemove, qui lui dispatche un vrai mouseMoved CDP)."""
    await _deplacer_curseur_virtuel(page, x, y)


async def action_get_screen_info(page, etat_navigateur: Optional[dict] = None) -> dict:
    """getScreenInfo() -- AJOUT (demande explicite utilisateur --
    InstanceExecutable.position_aleatoire(), cf. sa docstring) : renvoie
    la taille de l'écran piloté (viewport visible de l'onglet actif, EN
    PIXELS CSS -- MÊMES unités que x/y sur moveCursor/mousemove/click,
    cf. cssLayoutViewport ci-dessous) ainsi que la position actuelle du
    curseur VIRTUEL de cette instance (etat_navigateur["curseur_x"/"curseur_y"],
    même source que action_mousemove/action_click -- cf. leurs docstrings),
    None/None si aucun mousemove/click n'a encore eu lieu sur cette
    instance.

    Taille écran : Page.getLayoutMetrics (CDP) -- cssLayoutViewport
    (4e élément du tuple retourné) donne client_width/client_height en
    pixels CSS, EXCLUANT toute scrollbar, dans les mêmes unités que les
    coordonnées x/y déjà envoyées par toutes les actions souris de ce
    fichier (cf. dispatch_mouse_event(x=float(x), y=float(y)) dans
    action_click/action_mousemove) -- pas de conversion supplémentaire
    nécessaire côté appelant.

    Retourne {"largeur": int, "hauteur": int, "curseur_x": float | None,
    "curseur_y": float | None}."""
    _, _, _, css_layout_viewport, _, _ = await page.send(cdp.page.get_layout_metrics())
    curseur_x = curseur_y = None
    if etat_navigateur is not None:
        curseur_x = etat_navigateur.get("curseur_x")
        curseur_y = etat_navigateur.get("curseur_y")
    return {
        "largeur": int(css_layout_viewport.client_width),
        "hauteur": int(css_layout_viewport.client_height),
        "curseur_x": curseur_x,
        "curseur_y": curseur_y,
    }


async def action_mousemove(page, x: int, y: int, etat_navigateur: Optional[dict] = None,
                            speed_percent: float = 0, instantane: bool = False, buttons: int = 0):
    """mousemove(x, y) -- déplacement souris HUMAIN (même patch que côté
    Camoufox, cf. action_camoufox_mousemove -- demande utilisateur
    explicite : "jespere que le move du client chrome fonctionne aussi") :
    génère un trajet A->B dérivé statistiquement des mouvements réels
    enregistrés (cf. generate_mouse_path / _charger_banque_trajectoire_souris),
    puis rejoue chaque point via un mouseMoved CDP en respectant les délais
    générés (au lieu du saut instantané précédent, un seul mouseMoved).

    ATTENTION -- comme côté Camoufox, ce comportement ne s'applique QU'À
    mousemove : action_click reste inchangée (saut instantané avant
    mousePressed/mouseReleased CDP), même contrainte utilisateur explicite
    que pour action_camoufox_click.

    point_a (départ du trajet) : position actuelle du curseur virtuel,
    trackée dans etat_navigateur["curseur_x"/"curseur_y"]. Si
    etat_navigateur est absent, ou si aucun mousemove n'a encore eu lieu
    (curseur_x/y à None -- premier mousemove de la session), (x, y)
    lui-même est utilisé comme point de départ (trajet de longueur nulle).

    speed_percent (demande utilisateur explicite : "jamireas que clik et
    move prend en parametre la parametre speed pour que on puisse
    controler la vitesse dexecution") -- transmis tel quel à
    generate_mouse_path (cf. sa docstring pour la formule exacte) : 0 =
    vitesse normale/mesurée (défaut, comportement inchangé), positif =
    plus rapide, négatif = plus lent. N'affecte QUE la cadence temporelle
    des délais entre points, pas la forme géométrique du trajet ni
    l'amplitude du tremblement.

    Lève TrajectoireSourisIndisponible si aucune trajectoire ne peut être
    générée (scipy absent, mouseData.sqlite3 introuvable, ou banque vide)
    -- échec explicite, pas de repli silencieux sur l'ancien comportement.

    instantane (AJOUT, cf. docstring de SOURIS_INSTANTANEE dans
    CODE_VARIABLES_DYNAMIQUES_DEFAUT -- transmis depuis le script Task via
    la variable de la cellule "Variable dynamique", PAS un paramètre que
    l'utilisateur passe explicitement à mousemove()/click(), cf. sa
    docstring pour le mécanisme complet) : même effet que le drapeau
    global TRAJECTOIRE_SOURIS_INSTANTANEE ci-dessous, mais RÉSOLU PAR
    REQUÊTE plutôt que figé pour tout le process -- soit l'un, soit
    l'autre déclenche le court-circuit (OR logique), jamais besoin des
    deux à la fois. Court-circute TOTALEMENT ce qui précède (aucun
    chargement de banque, aucun appel à generate_mouse_path) -- un seul
    mouseMoved CDP envoyé directement vers (x, y), curseur virtuel
    repositionné une seule fois sur ce même point final."""
    if TRAJECTOIRE_SOURIS_INSTANTANEE or instantane:
        await _deplacer_curseur_virtuel(page, int(round(x)), int(round(y)))
        await page.send(cdp.input_.dispatch_mouse_event(type_="mouseMoved", x=float(x), y=float(y), buttons=buttons))
        if etat_navigateur is not None:
            etat_navigateur["curseur_x"] = float(x)
            etat_navigateur["curseur_y"] = float(y)
        return

    if etat_navigateur is not None and etat_navigateur.get("curseur_x") is not None:
        depart_x = etat_navigateur["curseur_x"]
        depart_y = etat_navigateur["curseur_y"]
    else:
        depart_x, depart_y = x, y

    bank = _charger_banque_trajectoire_souris()
    evenements = generate_mouse_path(
        str(get_mouse_data_path()), (depart_x, depart_y), (x, y),
        intent="move", bank=bank, speed_percent=speed_percent,
    )

    for ev in evenements:
        if ev["dt"] > 0:
            await asyncio.sleep(ev["dt"])
        await _deplacer_curseur_virtuel(page, int(round(ev["x"])), int(round(ev["y"])))
        await page.send(cdp.input_.dispatch_mouse_event(type_="mouseMoved", x=float(ev["x"]), y=float(ev["y"]), buttons=buttons))

    if etat_navigateur is not None:
        etat_navigateur["curseur_x"] = float(x)
        etat_navigateur["curseur_y"] = float(y)


async def action_capture_propre(page) -> dict:
    """capture_propre() -- action HORS 4.2 (cf. ACTIONS_ETENDUES), dédiée
    UNIQUEMENT à la détection OpenCV côté test (TestComposantScreen/
    TestActionScreen), jamais utilisée par _boucle_streaming_frames (le
    flux de visualisation continue d'inclure le curseur, comportement
    inchangé, cf. demande utilisateur).

    Séquence : masquer le curseur virtuel -> capturer (CDP, réutilise
    capturer_frame_reelle) -> réafficher le curseur, TOUJOURS (finally),
    même si la capture a levé une exception -- sans quoi un échec de
    capture laisserait le curseur invisible en permanence dans le
    streaming normal jusqu'au prochain moveCursor.

    Retourne {"image_b64": ...}, même format de payload qu'un frame
    normal -- le CLIENT (pas cette fonction) est responsable de
    réincruster ensuite le curseur sur l'image affichée s'il le souhaite,
    cf. décision utilisateur : cette image ne sert QU'au traitement
    OpenCV, jamais montrée telle quelle.

    Cf. action_new_tab pour le diagnostic complet du bug Vivaldi qui peut
    faire échouer cette action quand `page` est un onglet créé en
    arrière-plan pendant qu'un autre onglet reste affiché."""
    image_b64 = None
    await _masquer_curseur_virtuel(page)
    try:
        image_b64 = await capturer_frame_reelle(page, "capture_propre", haute_qualite=True)
    finally:
        await _reafficher_curseur_virtuel(page)
    if image_b64 is None:
        raise RuntimeError("capture_propre : échec de capture CDP (image_b64 vide)")
    return {"image_b64": image_b64}





# cdp.input_.MouseButton est un enum.Enum "nu" (pas de mixin str) : son
# .to_json() est appelé en interne par dispatch_mouse_event pour sérialiser
# le paramètre 'button'. Passer une chaîne brute ("left") au lieu du membre
# d'enum fait planter l'appel (AttributeError: 'str' object has no
# attribute 'to_json'), vérifié par introspection de la lib installée.
#
# Protégé contre l'absence de nodriver (cf. NODRIVER_DISPONIBLE plus haut) :
# vide plutôt qu'une exception à l'import -- seul un lancement effectif en
# mode --instance-id sans nodriver installé doit échouer, jamais l'import
# du fichier entier (qui casserait aussi le Dashboard/les écrans de test,
# qui n'ont besoin ni de cdp ni de nodriver).
BOUTONS_CDP = {
    "gauche": cdp.input_.MouseButton.LEFT,
    "droit": cdp.input_.MouseButton.RIGHT,
    "milieu": cdp.input_.MouseButton.MIDDLE,
} if NODRIVER_DISPONIBLE else {}


def _resoudre_duree_appui_ms(duree_appui_ms_fournie: int, contexte_log: str = "click") -> float:
    """Décide de la durée d'appui RÉELLEMENT utilisée pour un clic
    (mousedown->mouseup), partagée par action_click (CDP/nodriver) et
    action_camoufox_click (Playwright/Camoufox) -- même logique de
    résolution des deux côtés, un seul endroit à maintenir.

    PATCH (retour utilisateur explicite, en 2 temps) :
    1. "je veux vraiment un algo robuste" pour la durée de clic, une fois
       les données réelles fournies (table `clicks`, cf. ClickBank/
       generate_click_duration_ms plus bas dans ce fichier) ;
    2. précision explicite ensuite : "non, je veux que on ignore celle qui
       a été donnée en paramètre, dorénavant c'est cette valeur [la banque]
       que l'on doit toujours utiliser si il y a déjà la bd" -- donc PAS un
       simple défaut appliqué seulement quand rien n'est fourni : la banque
       prime INCONDITIONNELLEMENT sur duree_appui_ms_fournie dès qu'elle
       est exploitable, même si l'appelant a explicitement demandé une
       autre valeur.

    Repli EXPLICITE (retour utilisateur explicite, choisi parmi les options
    proposées : "repli sur duree_appui_ms fourni par l'appelant -- comme
    avant") -- si la banque est indisponible (Data/files/mouseData.sqlite3
    absent, ou pas assez de clics exploitables après filtrage des maintiens
    longs, cf. MIN_CLICS_BANK), on retombe sur duree_appui_ms_fournie telle
    quelle (comportement identique à celui d'avant ce patch) plutôt que de
    faire échouer le clic -- contrairement à mousemove/scroll qui lèvent
    TrajectoireSourisIndisponible sans repli, un clic reste une action
    suffisamment critique pour ne jamais échouer juste faute de banque de
    durées, décision utilisateur explicite ici (différente de celle prise
    pour mousemove).

    Passe par _charger_banque_click_souris() (PAS un appel direct à
    generate_click_duration_ms) précisément pour bénéficier de sa
    vérification chemin.is_file() AVANT toute tentative de connexion
    SQLite -- sans ce détour, un mouseData.sqlite3 absent remonterait une
    FileNotFoundError/sqlite3.OperationalError brute au lieu de la
    TrajectoireSourisIndisponible attendue ici, cassant le repli ci-dessus
    (bug détecté et corrigé pendant les tests de cette fonction, avant
    d'être branché dans action_click/action_camoufox_click)."""
    try:
        bank = _charger_banque_click_souris()
        duree_tiree = generate_click_duration_ms(str(get_mouse_data_path()), bank=bank)
        log.debug(
            f"[{contexte_log}] durée d'appui tirée de la banque de clics réels : "
            f"{duree_tiree:.1f}ms (paramètre fourni={duree_appui_ms_fournie}ms, ignoré)."
        )
        return duree_tiree
    except TrajectoireSourisIndisponible as exc:
        log.debug(
            f"[{contexte_log}] banque de durées de clic indisponible ({exc!r}) -- "
            f"repli sur duree_appui_ms fourni={duree_appui_ms_fournie}ms."
        )
        return float(duree_appui_ms_fournie)


async def action_click(page, x: int, y: int, bouton: str = "gauche", duree_appui_ms: int = 60,
                        nb_clics: int = 1, etat_navigateur: Optional[dict] = None,
                        speed_percent: float = 0, instantane: bool = False):
    """click(x, y) -- déplace d'abord la souris jusqu'à (x, y) avec une
    trajectoire HUMAINE (réutilise action_mousemove telle quelle -- même
    génération de trajectoire, même tracking de position via
    etat_navigateur["curseur_x"/"curseur_y"], même échec explicite
    TrajectoireSourisIndisponible si aucune trajectoire n'est disponible),
    PUIS effectue mousePressed/mouseReleased CDP à l'arrivée, avec un
    délai d'appui configurable (params.duree_clic_ms côté
    SequenceurAction/AutoniaX) pour un comportement moins instantané
    qu'un simple down/up sans délai (demande utilisateur explicite :
    "clik deplace dabord le cursuer jusaqua la position avant deffectuer
    le click"). bouton: gauche/droit/milieu. nb_clics: 2 pour un
    double-clic (click_count CDP, gère le délai interne entre les deux
    clics comme un vrai double-clic navigateur).

    speed_percent (demande utilisateur explicite, cf. action_mousemove)
    -- s'applique UNIQUEMENT au déplacement préalable (mousemove interne),
    indépendant de tout speed_percent utilisé par un mousemove appelé par
    ailleurs (demande utilisateur explicite : "click prend son propre
    paramètre speed, independant de celui du mousemove"). N'affecte pas
    duree_appui_ms (le délai mousedown->mouseup reste tel quel).

    instantane (cf. docstring de action_mousemove/SOURIS_INSTANTANEE) --
    transmis tel quel au déplacement préalable (mousemove interne), même
    principe que speed_percent juste au-dessus : hérité automatiquement,
    aucune autre modification nécessaire ici. N'affecte que ce
    déplacement -- mousePressed/mouseReleased qui suivent restent
    instantanés comme toujours (comportement historique inchangé, cf.
    docstring de classe : "action_click reste inchangée").

    duree_appui_ms (PATCH -- retour utilisateur explicite : "je veux
    vraiment un algo robuste" pour la durée d'appui, puis "ignore celle
    qui a été donnée en paramètre, dorénavant c'est cette valeur [la
    banque] que l'on doit toujours utiliser si il y a déjà la bd") -- ce
    paramètre n'est PLUS la valeur réellement utilisée dès que
    Data/files/mouseData.sqlite3 contient assez de clics réels
    exploitables (cf. MIN_CLICS_BANK, _resoudre_duree_appui_ms) : la durée
    RÉELLEMENT appliquée est alors tirée par bootstrap dans les durées de
    clic mesurées (cf. generate_click_duration_ms), et duree_appui_ms reçu
    ici est ignoré silencieusement -- y compris si l'appelant l'a fourni
    explicitement (comportement voulu, pas un oubli). Il ne redevient la
    valeur utilisée QUE si la banque est indisponible (fichier absent, ou
    pas assez de clics après filtrage des maintiens longs) -- repli
    explicite, décision utilisateur, cf. _resoudre_duree_appui_ms.

    etat_navigateur est optionnel pour compatibilité arrière (appel direct
    hors du dispatcher) : si absent, action_mousemove utilise (x, y)
    lui-même comme point de départ (trajet de longueur nulle -- revient au
    comportement de positionnement direct)."""
    await action_mousemove(page, x, y, etat_navigateur=etat_navigateur, speed_percent=speed_percent, instantane=instantane)
    bouton_cdp = BOUTONS_CDP.get(bouton, cdp.input_.MouseButton.LEFT)
    duree_reelle_ms = _resoudre_duree_appui_ms(duree_appui_ms, contexte_log="action_click")
    # PATCH (clic HUMAIN sur un bouton "Copier" du site, Chrome) : un clic
    # envoyé par AutoniaX est indiscernable d'un vrai clic côté page
    # (isTrusted=True dans les deux cas). On pose donc, juste avant le
    # clic, un marqueur temporel que le script d'interception lit pour
    # savoir si une copie vient du SCRIPT (-> presse-papier virtuel
    # uniquement, isolation par instance conservée) ou d'un humain (->
    # AUSSI le presse-papier Windows, comme Ctrl+C).
    await _marquer_action_script_presse_papier(page)
    await page.send(cdp.input_.dispatch_mouse_event(
        type_="mousePressed", x=float(x), y=float(y), button=bouton_cdp, click_count=nb_clics,
    ))
    await asyncio.sleep(max(0.0, duree_reelle_ms) / 1000.0)
    await page.send(cdp.input_.dispatch_mouse_event(
        type_="mouseReleased", x=float(x), y=float(y), button=bouton_cdp, click_count=nb_clics,
    ))


async def action_mouse_drag(page, x1, y1, x2, y2, bouton="gauche", etat_navigateur=None,
                            speed_percent=0, instantane=False, pause_ms=120):
    """Glisser (souris) : déplacement humain vers (x1, y1), bouton enfoncé,
    déplacement humain vers (x2, y2) bouton maintenu, relâchement. Distinct
    de action_drag (dépôt de fichier). Le bouton est TOUJOURS relâché."""
    bouton_cdp = BOUTONS_CDP.get(bouton, cdp.input_.MouseButton.LEFT)
    masque = {"gauche": 1, "droit": 2, "milieu": 4}.get(bouton, 1)
    await action_mousemove(page, x1, y1, etat_navigateur=etat_navigateur,
                           speed_percent=speed_percent, instantane=instantane)
    await asyncio.sleep(pause_ms / 1000)
    try:
        await page.send(cdp.input_.dispatch_mouse_event(
            type_="mousePressed", x=float(x1), y=float(y1),
            button=bouton_cdp, buttons=masque, click_count=1))
        await asyncio.sleep(pause_ms / 1000)
        await action_mousemove(page, x2, y2, etat_navigateur=etat_navigateur,
                               speed_percent=speed_percent, instantane=instantane,
                               buttons=masque)
        await asyncio.sleep(pause_ms / 1000)
    finally:
        await page.send(cdp.input_.dispatch_mouse_event(
            type_="mouseReleased", x=float(x2), y=float(y2),
            button=bouton_cdp, buttons=0, click_count=1))


async def action_scroll(page, x: int, y: int, delta_x: float = 0.0, delta_y: float = 0.0,
                         frequence_crans_par_sec: float = 5.0, speed_percent: float = 0.0,
                         instantane: bool = False):
    """scroll(targetDeltaX, targetDeltaY) -- défilement HUMAIN (même
    branchement que action_mousemove, cf. sa docstring) : (delta_x, delta_y)
    est ici la quantité TOTALE à scroller (pas un delta de cran unique,
    malgré le nom des paramètres conservé pour compatibilité arrière avec
    les appelants existants) -- generate_scroll_events (ScrollBank,
    bootstrap multi-sources sur les rafales de scroll réelles enregistrées
    dans mouseData.sqlite3, cf. sa docstring) dérive une séquence de crans
    (dt, dy, dx) dont la somme fait exactement (delta_x, delta_y), rejouée
    ici cran par cran via mouseWheel CDP en respectant les délais générés
    -- au lieu de l'ancien envoi d'un seul événement wheel par appel (la
    rafale était alors composée côté pilote Qt, cf. _lancer_scroll).

    speed_percent : transmis tel quel à generate_scroll_events (même
    formule que action_mousemove/generate_mouse_path) -- 0 = cadence
    mesurée/normale, positif = plus rapide, négatif = plus lent. N'affecte
    QUE les délais entre crans, jamais l'amplitude dy/dx de chacun.

    instantane (AJOUT, cf. docstring de SOURIS_INSTANTANEE dans
    CODE_VARIABLES_DYNAMIQUES_DEFAUT -- même mécanisme EXACT que
    action_mousemove : transmis depuis le script Task via la variable de
    la cellule "Variable dynamique", RÉSOLU PAR REQUÊTE, OR logique avec
    TRAJECTOIRE_SOURIS_INSTANTANEE) : court-circuite TOTALEMENT la
    génération de rafale humanisée (aucun chargement de banque, aucun
    appel à generate_scroll_events, aucun repli sur l'ancien comportement
    par crans réguliers ci-dessous) -- un SEUL événement mouseWheel envoyé
    directement avec (delta_x, delta_y) COMPLET, zéro délai. Demande
    explicite utilisateur : "scroll extrêmement rapide", "le brut".

    REPLI EXPLICITE (pas de crash silencieux, même esprit défensif que
    TrajectoireSourisIndisponible ailleurs dans ce fichier) : si la banque
    de scroll est indisponible (scipy absent, mouseData.sqlite3 introuvable
    ou sans rafale exploitable) ou si generate_scroll_events échoue pour
    toute autre raison, on retombe sur l'ANCIEN comportement -- des crans
    de WHEEL_DELTA (ou fraction, cf. calcul ci-dessous) espacés selon
    frequence_crans_par_sec, un seul mouseWheel par cran -- plutôt que de
    faire échouer toute la commande scroll. Un log.warning trace ce repli
    pour qu'il reste visible en diagnostic (cf. docstring de la classe
    SequenceurActionReseau : distinguer un échec réseau/CDP d'un simple
    repli sur l'ancien comportement)."""
    if TRAJECTOIRE_SOURIS_INSTANTANEE or instantane:
        await page.send(cdp.input_.dispatch_mouse_event(
            type_="mouseWheel", x=float(x), y=float(y), delta_x=float(delta_x), delta_y=float(delta_y),
        ))
        return
    try:
        bank = _charger_banque_scroll_souris()
        evenements = generate_scroll_events(
            str(get_mouse_data_path()), target_dy=float(delta_y), target_dx=float(delta_x),
            bank=bank, speed_percent=speed_percent,
        )
    except (TrajectoireSourisIndisponible, ValueError) as exc:
        log.warning(
            f"action_scroll() : scroll humanisé indisponible ({exc!r}) -- "
            "repli sur l'ancien comportement (crans réguliers)."
        )
        intervalle_s = 1.0 / max(0.1, float(frequence_crans_par_sec))
        nb_crans = max(1, round(max(abs(delta_x), abs(delta_y)) / WHEEL_DELTA))
        pas_x = delta_x / nb_crans
        pas_y = delta_y / nb_crans
        for i in range(nb_crans):
            if i > 0:
                await asyncio.sleep(intervalle_s)
            await page.send(cdp.input_.dispatch_mouse_event(
                type_="mouseWheel", x=float(x), y=float(y), delta_x=float(pas_x), delta_y=float(pas_y),
            ))
        return

    for ev in evenements:
        if ev["dt"] > 0:
            await asyncio.sleep(ev["dt"])
        await page.send(cdp.input_.dispatch_mouse_event(
            type_="mouseWheel", x=float(x), y=float(y), delta_x=float(ev["dx"]), delta_y=float(ev["dy"]),
        ))


# PATCH (contrôle à distance sur Chrome standard -- retour utilisateur :
# "es ce que le scroll [...] sont geré pour chrome, je ne pense pas") --
# diagnostic confirmé : PanneauRenduInstance._sur_debounce_scroll (le
# gestionnaire RÉEL de la molette pendant le contrôle à distance, cf. sa
# docstring) n'envoie plus l'action "scroll" depuis son remplacement par
# "scroll_simple" -- action_scroll ci-dessus reste donc correctement
# câblée (ACTIONS_4_2, _executer_commande) mais n'est en réalité plus
# jamais appelée par le contrôle à distance. "scroll_simple" n'existait
# que côté Camoufox (action_camoufox_scroll_simple, dispatchée dans
# _executer_commande_camoufox) -- absente de ACTIONS_SUPPORTEES et de
# _executer_commande (chemin CDP/nodriver), donc rejetée en silence sur
# tout profil Chrome/Vivaldi exactement comme press_key (cf. son
# correctif juste au-dessus dans ce fichier).
async def action_scroll_simple(page, x: int, y: int, sens: str, amplitude: float = WHEEL_DELTA) -> None:
    """scroll_simple(x, y, sens, amplitude) -- équivalent CDP/nodriver de
    action_camoufox_scroll_simple : UN seul mouseWheel, aucune
    humanisation/banque de trajectoire, cf. sa docstring pour le détail
    des décisions utilisateur reprises ici à l'identique. `sens` :
    "haut"/"bas" (seul le signe du delta compte, pas de valeur
    intermédiaire). `x`/`y` (contrairement à Playwright, transmis par
    l'appelant -- cf. commentaire sur PanneauRenduInstance._sur_debounce_
    scroll ci-dessus) : mouseWheel CDP n'a pas de notion de "position
    actuelle de la souris", ces coordonnées lui sont donc nécessaires."""
    pas_y = -abs(amplitude) if sens == "haut" else abs(amplitude)
    await page.send(cdp.input_.dispatch_mouse_event(
        type_="mouseWheel", x=float(x), y=float(y), delta_x=0.0, delta_y=float(pas_y),
    ))


def _detecter_fuseau_horaire_via_proxy_sync(proxy: Optional[dict]) -> Optional[str]:
    """PATCH (demande utilisateur : "comment regler maintenant la date et
    lheur du navigatuer chrome pour que il utilse celui de mon proxy
    natifs") -- équivalent Chrome de ce que geoip=True fait déjà
    NATIVEMENT pour Camoufox (cf. commentaire de module juste avant
    _camoufox_chemin_fingerprint : "aligne timezone/locale/géolocalisation
    sur l'IP réelle DU PROXY"). nodriver/Chrome n'a aucun équivalent
    intégré à geoip=True -- il faut détecter le fuseau nous-mêmes puis le
    forcer via CDP (cf. _aligner_fuseau_horaire_proxy ci-dessous).

    Réutilise EXACTEMENT le même service que _tester_proxy_sync
    (ip-api.com/json, urllib.request stdlib -- pas de nouvelle dépendance
    comme `requests`), en ajoutant simplement le champ `timezone` à la
    liste demandée. Fonction SYNCHRONE pure (aucun await ni objet CDP à
    l'intérieur) -- à appeler depuis loop.run_in_executor, jamais
    directement sur la boucle asyncio (une requête HTTP à travers un
    proxy potentiellement lent peut prendre plusieurs secondes), même
    raisonnement que _tester_proxy_sync/TestProxyWorker.

    proxy=None (aucun proxy pour cette instance) : retourne None
    directement, sans requête réseau -- Chrome garde alors le fuseau
    système par défaut, comportement inchangé pour les profils sans
    proxy. proxy avec host="127.0.0.1" (tunnel RelaisProxyLocal du proxy
    natif, cf. _resoudre_proxy_effectif_profil) : fonctionne EXACTEMENT
    pareil, le tunnel relaie cette requête de bout en bout jusqu'à la
    vraie sortie internet côté mAutoniax, tout comme il relaierait une
    navigation normale -- la réponse contient donc bien le fuseau réel
    DU PROXY, jamais UTC/local par défaut de la machine sAutoniax.

    BUGFIX (log constaté en usage réel : "RemoteDisconnected('Remote end
    closed connection without response')") -- RelaisProxyLocal
    (_gerer_connexion_navigateur) est un relais TCP BRUT, pas un vrai
    proxy HTTP conforme : il ne sait ni réémettre une requête sur un
    nouveau socket si le serveur distant coupe la connexion (keep-alive
    expiré côté ip-api.com, ou coupure transitoire sur le trajet sAutoniax
    -> serveurT -> mAutoniax -> internet), ni distinguer ce cas d'un
    échec définitif -- la connexion se ferme simplement sans réponse,
    ce qu'http.client remonte comme RemoteDisconnected plutôt qu'un
    URLError classique. "Connection: close" explicite (au lieu du
    keep-alive implicite par défaut d'HTTP/1.1) demande à ip-api.com de
    fermer proprement APRÈS avoir répondu plutôt que de laisser la
    connexion traîner jusqu'à un timeout qui casse le relais -- et un
    court retry (2 tentatives, même esprit que _put_object_avec_retry
    mais sans backoff, cf. ci-dessous) absorbe le résidu de coupures
    transitoires puisqu'une nouvelle tentative ouvre un nouveau socket
    (donc un nouveau stream_id côté RelaisProxyLocal, indépendant de
    celui qui vient d'échouer).

    Retourne l'identifiant de fuseau IANA tel quel (ex: "Europe/Paris",
    directement compatible avec cdp.emulation.set_timezone_override), ou
    None en cas d'échec (proxy mort, SOCKS non supporté par
    urllib.request, champ absent de la réponse, etc.) -- l'appelant doit
    alors renoncer silencieusement, jamais lever."""
    if not proxy or not proxy.get("host"):
        return None
    if (proxy.get("protocole") or "http") in ("socks4", "socks5"):
        # Même limitation que _tester_proxy_sync : urllib.request ne sait
        # nativement parler qu'HTTP/HTTPS à un proxy. Un proxy SOCKS
        # reste utilisable par Chrome lui-même (--proxy-server le gère),
        # seule CETTE détection de fuseau est impossible depuis ce
        # process -- on renonce proprement plutôt que de planter.
        return None

    NB_TENTATIVES = 2
    for tentative in range(1, NB_TENTATIVES + 1):
        try:
            url_test = "http://ip-api.com/json/?fields=status,message,timezone,query"
            port = proxy.get("port") or 8080
            auth = ""
            if proxy.get("user"):
                mdp = proxy.get("password") or ""
                auth = f"{proxy['user']}:{mdp}@"
            url_proxy = f"{proxy.get('protocole') or 'http'}://{auth}{proxy['host']}:{port}"
            gestionnaire = urllib.request.ProxyHandler({"http": url_proxy, "https": url_proxy})
            opener = urllib.request.build_opener(gestionnaire)
            # "Connection: close" (cf. docstring ci-dessus) -- évite de
            # laisser ip-api.com garder la connexion ouverte en
            # keep-alive à travers un relais qui ne sait pas la
            # réutiliser proprement de toute façon (une seule requête
            # par appel de cette fonction).
            requete = urllib.request.Request(
                url_test, headers={"User-Agent": "AutoniaX/1.0", "Connection": "close"},
            )
            with opener.open(requete, timeout=10) as reponse:
                donnees = json.loads(reponse.read().decode("utf-8"))
            if donnees.get("status") != "success":
                log.warning(f"[fuseau-proxy] détection du fuseau échouée : {donnees.get('message') or 'réponse inattendue du service.'}")
                return None
            fuseau = donnees.get("timezone")
            if not fuseau:
                log.warning("[fuseau-proxy] réponse ip-api.com sans champ 'timezone' -- fuseau Chrome inchangé.")
                return None
            return fuseau
        except urllib.error.URLError as e:
            if tentative < NB_TENTATIVES:
                log.info(f"[fuseau-proxy] connexion impossible ({e.reason}) -- nouvel essai ({tentative}/{NB_TENTATIVES}).")
                continue
            log.warning(f"[fuseau-proxy] connexion impossible pour détecter le fuseau ({e.reason}) -- fuseau Chrome inchangé.")
            return None
        except TimeoutError:
            if tentative < NB_TENTATIVES:
                log.info(f"[fuseau-proxy] délai dépassé -- nouvel essai ({tentative}/{NB_TENTATIVES}).")
                continue
            log.warning("[fuseau-proxy] délai dépassé (10s) pour détecter le fuseau -- fuseau Chrome inchangé.")
            return None
        except Exception as e:
            # BUGFIX -- RemoteDisconnected (http.client.RemoteDisconnected,
            # sous-classe de http.client.HTTPException) tombait ici,
            # PAS dans urllib.error.URLError comme les autres échecs
            # réseau : elle survient une fois la connexion TCP acceptée
            # par le relais, quand le bout distant la ferme sans avoir
            # renvoyé de réponse HTTP -- cf. docstring de la fonction
            # pour le mécanisme complet. Retentée comme les deux cas
            # ci-dessus plutôt que d'abandonner immédiatement.
            if tentative < NB_TENTATIVES:
                log.info(f"[fuseau-proxy] erreur réseau ({e!r}) -- nouvel essai ({tentative}/{NB_TENTATIVES}).")
                continue
            log.warning(f"[fuseau-proxy] erreur inattendue lors de la détection du fuseau : {e!r}")
            return None
    return None


async def _aligner_fuseau_horaire_proxy(page, proxy: Optional[dict], instance_id: str = "") -> None:
    """Applique sur `page` (déjà ouverte, cf. demarrer_navigateur) le
    fuseau horaire détecté via _detecter_fuseau_horaire_via_proxy_sync,
    par cdp.emulation.set_timezone_override -- l'équivalent Chrome/CDP de
    geoip=True côté Camoufox, mais posé explicitement plutôt
    qu'automatique (rien dans nodriver ne fait ça tout seul).

    Emulation.setTimezoneOverride agit uniquement sur ce que le
    JavaScript de la page observe (Date/Intl.DateTimeFormat --
    new Date().getTimezoneOffset(), Intl.DateTimeFormat().resolvedOptions
    ().timeZone, etc.) : indépendant de l'horloge système de la machine
    sAutoniax (Kaggle/Colab, souvent UTC), sans redémarrer Chrome ni
    toucher au système d'exploitation -- exactement le comportement
    recherché ("que le navigateur utilise celui de mon proxy natif").

    Déporté via run_in_executor (cf. docstring de
    _detecter_fuseau_horaire_via_proxy_sync : requête réseau bloquante,
    jamais directement sur la boucle asyncio). Non bloquant par
    construction, comme _assurer_permissions_presse_papier juste en
    dessous : un échec de détection ou d'application CDP ne doit jamais
    empêcher le reste du démarrage de l'instance de continuer -- log en
    warning, silence sinon (aucun proxy pour cette instance)."""
    if not proxy or not proxy.get("host"):
        return
    loop = asyncio.get_running_loop()
    fuseau = await loop.run_in_executor(None, _detecter_fuseau_horaire_via_proxy_sync, proxy)
    if not fuseau:
        return
    try:
        await page.send(cdp.emulation.set_timezone_override(timezone_id=fuseau))
        log.info(f"[fuseau-proxy] fuseau Chrome aligné sur le proxy pour '{instance_id}' -> {fuseau}")
    except Exception as e:
        log.warning(f"[fuseau-proxy] échec d'application du fuseau '{fuseau}' via CDP pour '{instance_id}' : {e!r}")


def _heure_locale_lisible_pour_fuseau(fuseau: str) -> Optional[str]:
    """PATCH (demande utilisateur : "quand on vas apuyer sur le bouton de
    toogle proxy natifs sa vas affihcer aussi le lheure du mautniax, juste
    pour nootifier que sa a bien la bonne heure ... dans les sortie de
    sautoniax") -- traduit un identifiant de fuseau IANA (ex:
    "Europe/Paris", déjà détecté par _detecter_fuseau_horaire_via_proxy_
    sync, MÊME source que celle utilisée pour aligner Chrome via CDP un
    peu plus haut) en une heure locale lisible, pour un simple log
    d'information côté sAutoniax -- pas de nouvelle requête réseau ici,
    juste un calcul local à partir de l'heure système (peu importe le
    fuseau système de la machine sAutoniax elle-même, cf. datetime.now
    (tz=...), qui convertit toujours correctement quel que soit le
    fuseau local du process).

    zoneinfo (stdlib depuis Python 3.9, PAS listé dans les imports
    globaux de ce fichier jusqu'ici) importé en LOCAL à cette fonction --
    même style défensif que les autres modules optionnels de ce fichier
    (ex. googleapiclient/google.oauth2) : si la base de données de
    fuseaux IANA n'est pas installée sur la machine (tzdata absent sur
    certains Linux minimalistes/Windows), lève une exception que
    l'appelant doit tolérer plutôt que planter tout le toggle pour un
    simple log informatif.

    Retourne une chaîne du type "14:32:07 (Europe/Paris)", ou None en cas
    d'échec (fuseau invalide, tzdata absent) -- l'appelant doit alors
    renoncer silencieusement à ce log, jamais lever."""
    try:
        from zoneinfo import ZoneInfo
        heure = datetime.now(ZoneInfo(fuseau))
        return f"{heure:%H:%M:%S} ({fuseau})"
    except Exception as e:
        log.warning(f"[fuseau-proxy] impossible de calculer l'heure locale pour le fuseau '{fuseau}' : {e!r}")
        return None





async def _assurer_permissions_presse_papier(page):
    """Autorise l'accès à navigator.clipboard depuis la page (nécessaire
    pour copy/paste via Runtime.evaluate -- sans grantPermissions, ces
    appels échouent silencieusement ou lèvent NotAllowedError selon les
    versions de Chrome). Appelé une fois au démarrage (cf. demarrer_navigateur),
    pas à chaque copy/paste."""
    try:
        # cdp.browser.PermissionType est aussi un enum.Enum nu -- même
        # classe de bug que MouseButton (grant_permissions fait
        # `[i.to_json() for i in permissions]` en interne). Vérifié par
        # introspection : des chaînes brutes ("clipboardReadWrite") font
        # planter l'appel avant même d'atteindre le navigateur.
        await page.send(cdp.browser.grant_permissions(
            permissions=[
                cdp.browser.PermissionType.CLIPBOARD_READ_WRITE,
                cdp.browser.PermissionType.CLIPBOARD_SANITIZED_WRITE,
            ],
        ))
    except Exception as e:
        log.warning(f"Permissions presse-papier non accordées (copy/paste pourraient échouer) : {e!r}")


async def action_paste(page, x: int, y: int, texte: str):
    """paste(x, y, texte) -- focus l'élément à cette position (clic
    simple, pour positionner le curseur texte dedans) puis insère `texte`
    (le contenu du PRESSE-PAPIER VIRTUEL de cette instance, cf. docstring
    action_copy -- fourni par l'appelant, _executer_commande, qui le lit
    dans etat_navigateur["presse_papier_virtuel"]) caractère par
    caractère, EXACTEMENT comme action_type_text (même séquence CDP
    keyDown -> char -> keyUp, sans délai entre caractères -- un collage
    reste instantané, contrairement à une frappe simulée).

    BUG CORRIGÉ (demande explicite utilisateur : "je veux que ce
    presse-papier soit uniquement lié à l'instance") : simulait auparavant
    un vrai Ctrl+V (dispatch_key_event avec modifiers=2, key='v'), qui
    colle le contenu du presse-papier SYSTÈME (Windows) -- CDP ne permet
    aucune isolation de navigator.clipboard par instance, cette API parle
    toujours au presse-papier OS réel, quel que soit le navigateur piloté.
    Plusieurs instances en parallèle se marchaient donc dessus sur un seul
    presse-papier partagé. Insérer le texte directement via la même
    mécanique que action_type_text évite tout contact avec le presse-papier
    Windows, tout en déclenchant les mêmes événements JS keydown/keyup/
    input attendus par la page qu'un vrai raccourci clavier."""
    await _deplacer_curseur_virtuel(page, x, y)
    await page.send(cdp.input_.dispatch_mouse_event(type_="mousePressed", x=float(x), y=float(y), button=cdp.input_.MouseButton.LEFT, click_count=1))
    await page.send(cdp.input_.dispatch_mouse_event(type_="mouseReleased", x=float(x), y=float(y), button=cdp.input_.MouseButton.LEFT, click_count=1))
    log.info(f"[DIAG paste] action_paste() : texte reçu par la fonction={texte!r} (longueur={len(texte)})")
    for caractere in texte:
        await page.send(cdp.input_.dispatch_key_event(type_="keyDown"))
        await page.send(cdp.input_.dispatch_key_event(type_="char", text=caractere))
        await page.send(cdp.input_.dispatch_key_event(type_="keyUp"))
    log.info(f"[DIAG paste] action_paste() : boucle d'insertion terminée -- {len(texte)} caractère(s) envoyé(s) via CDP")


async def action_clear(page, x: int, y: int):
    """clear(x, y) -- focus l'élément à cette position (clic simple, comme
    action_paste) puis sélectionne tout son contenu (Ctrl+A) et l'efface
    (Delete), via dispatch_key_event -- deux combinaisons de touches
    simulées telles qu'un utilisateur les taperait réellement, plutôt
    qu'une manipulation JS directe de la value (mêmes raisons que
    action_paste : déclenche les vrais événements clavier/input attendus
    par la page). Action "banale" unique côté modèle (type_action="clear",
    cf. discussion) : l'appelant n'a besoin de connaître AUCUNE
    combinaison de touches, seulement la position -- sélection et
    effacement sont enchaînés ici en une seule commande, pas deux actions
    séparées à composer manuellement."""
    await _deplacer_curseur_virtuel(page, x, y)
    await page.send(cdp.input_.dispatch_mouse_event(type_="mousePressed", x=float(x), y=float(y), button=cdp.input_.MouseButton.LEFT, click_count=1))
    await page.send(cdp.input_.dispatch_mouse_event(type_="mouseReleased", x=float(x), y=float(y), button=cdp.input_.MouseButton.LEFT, click_count=1))
    # Ctrl+A : sélectionne tout le contenu du champ focus.
    await page.send(cdp.input_.dispatch_key_event(
        type_="keyDown", modifiers=2, key="a", code="KeyA", windows_virtual_key_code=65,
    ))
    await page.send(cdp.input_.dispatch_key_event(
        type_="keyUp", modifiers=2, key="a", code="KeyA", windows_virtual_key_code=65,
    ))
    # Delete : efface la sélection tout juste faite. windows_virtual_key_code
    # 46 = VK_DELETE ; key/code "Delete" (et non "Backspace") pour rester
    # cohérent avec une sélection déjà en place (indifférent de toute façon
    # puisque tout le contenu est sélectionné, mais garde le sens explicite
    # "supprimer" plutôt que "revenir en arrière").
    await page.send(cdp.input_.dispatch_key_event(
        type_="keyDown", key="Delete", code="Delete", windows_virtual_key_code=46,
    ))
    await page.send(cdp.input_.dispatch_key_event(
        type_="keyUp", key="Delete", code="Delete", windows_virtual_key_code=46,
    ))


# ---------------------------------------------------------------------------
# dom_paste / dom_clear -- PATCH (demande explicite utilisateur : généraliser
# Composant.id_dom au-delà du seul ciblage presse-papier, "composant.id_dom.
# paste(), et clear()" -- reformulé ensuite en composant.dom_paste()/
# dom_clear(), préfixe "dom" pour éviter toute confusion avec paste()/clear()
# existants qui, eux, cliquent par COORDONNÉES x,y sur le composant détecté
# visuellement, cf. leurs docstrings juste au-dessus).
#
# Différence fondamentale avec action_paste/action_clear ci-dessus :
# AUCUNE détection visuelle, AUCUNE coordonnée -- l'élément est retrouvé
# directement dans le DOM via document.querySelector(id_dom), id_dom étant
# soit un id brut historique ("action-bar-copy", requête reconstruite en
# "#action-bar-copy" pour rester un sélecteur CSS valide), soit un sélecteur
# CSS complet déjà valide tel quel (ex: '[data-testid="chat-input"]'),
# fourni tel quel par l'utilisateur -- cf. Composant.id_dom.
#
# Câblées sur les DEUX moteurs : action_dom_paste/action_dom_clear
# ci-dessous pour CDP (Chrome/Vivaldi), action_camoufox_dom_paste/
# action_camoufox_dom_clear (cf. plus haut, juste après action_camoufox_
# clear) pour Camoufox (Firefox) -- même logique JS (_JS_DOM_RESOUDRE_
# SELECTEUR), seule l'API d'évaluation change (cdp.runtime.evaluate côté
# CDP, page.evaluate() côté Playwright/Camoufox).
#
# Insertion de texte par setter natif HTMLInputElement/HTMLTextAreaElement
# (Object.getOwnPropertyDescriptor sur le prototype) plutôt qu'une simple
# affectation `element.value = texte` : un champ contrôlé React/Vue
# intercepte l'affectation directe via son propre setter et l'ignore --
# passer par le setter NATIF du prototype, puis déclencher "input"/"change"
# manuellement, est la technique standard pour qu'un framework moderne
# détecte le changement comme il détecterait une vraie frappe. Aucun contact
# avec le presse-papier (ni virtuel ni système) : le texte est injecté
# directement dans l'élément, cf. docstring de ComposantExecutable.dom_paste.
# ---------------------------------------------------------------------------
_JS_DOM_RESOUDRE_SELECTEUR = """
  // AJOUT (demande explicite utilisateur : plusieurs sélecteurs candidats
  // dans un même id_dom) : la chaîne brute peut désormais contenir
  // plusieurs sélecteurs séparés par "||" (ex: '#foo || [aria-label="x"]
  // || .ma-classe'), essayés DANS L'ORDRE -- le premier qui matche un
  // élément gagne, chacun bénéficiant individuellement du même repli
  // "id brut -> #id" qu'avant. Un id_dom historique à un seul sélecteur
  // (sans "||") continue de fonctionner à l'identique (tableau à un seul
  // élément après split).
  function autoniaxResoudreUnSelecteur(s) {
    if (!s) { return null; }
    var el = null;
    try { el = document.querySelector(s); } catch (e) { el = null; }
    if (el) { return el; }
    var ressembleAUnIdBrut = /^[A-Za-z][A-Za-z0-9_-]*$/.test(s);
    if (ressembleAUnIdBrut) {
      try { el = document.querySelector("#" + s); } catch (e) { el = null; }
    }
    return el;
  }

  function autoniaxResoudreSelecteur(selecteurBrut) {
    var brut = String(selecteurBrut || "");
    if (!brut) { return null; }
    var candidats = brut.split("||").map(function (s) { return s.trim(); }).filter(function (s) { return s.length > 0; });
    if (candidats.length === 0) { return null; }
    for (var i = 0; i < candidats.length; i++) {
      var el = autoniaxResoudreUnSelecteur(candidats[i]);
      if (el) { return el; }
    }
    return null;
  }
"""


async def action_dom_paste(page, selecteur: str, texte: str) -> dict:
    """dom_paste(selecteur, texte) -- retrouve l'élément par
    document.querySelector(selecteur) (cf. _JS_DOM_RESOUDRE_SELECTEUR pour
    le repli id brut -> "#id") et y insère `texte` directement, SANS clic ni
    coordonnées (contrairement à action_paste ci-dessus, qui clique d'abord
    à x,y) -- focus l'élément, écrit `texte` via le setter natif value
    (compatible champ contrôlé React/Vue, cf. commentaire de section
    ci-dessus) puis déclenche "input" et "change" pour que la page réagisse
    comme à une vraie saisie.

    Retourne {"trouve": bool, "erreur": str|None} -- jamais d'exception :
    un sélecteur qui ne matche rien, ou un élément non éditable (ni
    value ni contentEditable), est un échec DOM normal, remonté à
    l'appelant (_executer_commande) comme n'importe quel autre échec
    d'action, pas un crash de l'instance."""
    script = _JS_DOM_RESOUDRE_SELECTEUR + """
    (function () {
      var el = autoniaxResoudreSelecteur(%s);
      if (!el) { return {trouve: false, erreur: "aucun élément ne correspond à ce sélecteur"}; }
      try {
        el.focus();
        var texte = %s;
        var estChampValue = ("value" in el) && (el.tagName === "INPUT" || el.tagName === "TEXTAREA");
        if (estChampValue) {
          var proto = el.tagName === "TEXTAREA" ? window.HTMLTextAreaElement.prototype : window.HTMLInputElement.prototype;
          var descripteur = Object.getOwnPropertyDescriptor(proto, "value");
          if (descripteur && descripteur.set) {
            descripteur.set.call(el, texte);
          } else {
            el.value = texte;
          }
        } else if (el.isContentEditable) {
          el.textContent = texte;
        } else {
          return {trouve: true, erreur: "élément trouvé mais ni champ value ni contentEditable"};
        }
        el.dispatchEvent(new Event("input", {bubbles: true}));
        el.dispatchEvent(new Event("change", {bubbles: true}));
        return {trouve: true, erreur: null};
      } catch (e) {
        return {trouve: true, erreur: "échec d'insertion : " + String(e)};
      }
    })();
    """ % (json.dumps(selecteur), json.dumps(texte))
    resultat, exception_details = await page.send(cdp.runtime.evaluate(script, return_by_value=True))
    if exception_details is not None:
        return {"trouve": False, "erreur": f"échec JS dom_paste : {exception_details}"}
    valeur = resultat.value if resultat is not None else None
    if not isinstance(valeur, dict):
        return {"trouve": False, "erreur": "réponse JS inattendue"}
    return valeur


async def action_dom_clear(page, selecteur: str) -> dict:
    """dom_clear(selecteur) -- retrouve l'élément par
    document.querySelector(selecteur) (même résolution que action_dom_paste,
    cf. _JS_DOM_RESOUDRE_SELECTEUR) et vide son contenu directement, SANS
    clic ni coordonnées -- focus l'élément, écrit "" via le setter natif
    value (ou textContent="" pour un contentEditable), puis déclenche
    "input"/"change".

    Retourne {"trouve": bool, "erreur": str|None}, même contrat que
    action_dom_paste -- jamais d'exception levée."""
    script = _JS_DOM_RESOUDRE_SELECTEUR + """
    (function () {
      var el = autoniaxResoudreSelecteur(%s);
      if (!el) { return {trouve: false, erreur: "aucun élément ne correspond à ce sélecteur"}; }
      try {
        el.focus();
        var estChampValue = ("value" in el) && (el.tagName === "INPUT" || el.tagName === "TEXTAREA");
        if (estChampValue) {
          var proto = el.tagName === "TEXTAREA" ? window.HTMLTextAreaElement.prototype : window.HTMLInputElement.prototype;
          var descripteur = Object.getOwnPropertyDescriptor(proto, "value");
          if (descripteur && descripteur.set) {
            descripteur.set.call(el, "");
          } else {
            el.value = "";
          }
        } else if (el.isContentEditable) {
          el.textContent = "";
        } else {
          return {trouve: true, erreur: "élément trouvé mais ni champ value ni contentEditable"};
        }
        el.dispatchEvent(new Event("input", {bubbles: true}));
        el.dispatchEvent(new Event("change", {bubbles: true}));
        return {trouve: true, erreur: null};
      } catch (e) {
        return {trouve: true, erreur: "échec d'effacement : " + String(e)};
      }
    })();
    """ % (json.dumps(selecteur),)
    resultat, exception_details = await page.send(cdp.runtime.evaluate(script, return_by_value=True))
    if exception_details is not None:
        return {"trouve": False, "erreur": f"échec JS dom_clear : {exception_details}"}
    valeur = resultat.value if resultat is not None else None
    if not isinstance(valeur, dict):
        return {"trouve": False, "erreur": "réponse JS inattendue"}
    return valeur


async def action_derniere_reponse_assistant(page, selecteur: str) -> dict:
    """get_last_assistant_message(selecteur) -- équivalent strict de
    action_camoufox_derniere_reponse_assistant, côté CDP/nodriver :
    document.querySelectorAll(selecteur), DERNIER élément trouvé,
    .innerText (repli .textContent). AUCUN contact avec le
    presse-papier ni le bouton Copy -- contourne navigator.clipboard.
    write()/writeText() (cf. diagnostic "transient activation" côté
    Camoufox -- même contournement appliqué ici pour Chrome/CDP par
    cohérence, même si le diagnostic d'origine portait sur Camoufox).
    Retourne {"trouve": bool, "erreur": str|None, "texte": str}, jamais
    d'exception pour un sélecteur qui ne matche rien."""
    script = """
    (function () {
      var elements = null;
      try { elements = document.querySelectorAll(%s); } catch (e) { elements = null; }
      if (!elements || elements.length === 0) {
        return {trouve: false, erreur: "aucun élément ne correspond à ce sélecteur", texte: ""};
      }
      var dernier = elements[elements.length - 1];
      var texte = (dernier.innerText !== undefined && dernier.innerText !== null)
        ? dernier.innerText
        : (dernier.textContent || "");
      return {trouve: true, erreur: null, texte: texte};
    })();
    """ % (json.dumps(selecteur),)
    resultat, exception_details = await page.send(cdp.runtime.evaluate(script, return_by_value=True))
    if exception_details is not None:
        return {"trouve": False, "erreur": f"échec JS get_last_assistant_message : {exception_details}", "texte": ""}
    valeur = resultat.value if resultat is not None else None
    if not isinstance(valeur, dict):
        return {"trouve": False, "erreur": "réponse JS inattendue", "texte": ""}
    return valeur


# AJOUT (demande utilisateur : "manipuler le code html de la page reddit" affichee dans une
# <iframe> par un proxy web) -- parametre `cadre` : sélecteur CSS d'une <iframe> (ou chaîne
# "a >>> b" pour des iframes imbriquées, ou "auto" = la plus grande iframe accessible).
# Les iframes de MÊME origine uniquement (contentDocument inaccessible sinon -> erreur claire).
_JS_RESOUDRE_CADRE = r"""
  function autoniaxResoudreCadre(cadre) {
    if (!cadre) { return {ok: true, doc: document, win: window, chaine: [], erreur: null}; }
    var morceaux = (cadre === "auto") ? ["auto"] : String(cadre).split(">>>");
    var doc = document, win = window, chaine = [];
    for (var i = 0; i < morceaux.length; i++) {
      var sel = morceaux[i].replace(/^\s+|\s+$/g, ""), fr = null;
      if (sel === "auto") {
        var meilleure = -1, cand = doc.querySelectorAll("iframe, frame");
        for (var k = 0; k < cand.length; k++) {
          var dk = null;
          try { dk = cand[k].contentDocument; } catch (e) { dk = null; }
          if (!dk) { continue; }
          var rk = cand[k].getBoundingClientRect(), aire = rk.width * rk.height;
          if (aire > meilleure) { fr = cand[k]; meilleure = aire; }
        }
      } else {
        try { fr = doc.querySelector(sel); }
        catch (e) { return {ok: false, erreur: "sélecteur de cadre invalide (" + sel + ") : " + String(e)}; }
      }
      if (!fr) { return {ok: false, erreur: "cadre introuvable : " + sel}; }
      var balise = fr.tagName ? fr.tagName.toLowerCase() : "";
      if (balise !== "iframe" && balise !== "frame") {
        return {ok: false, erreur: "« " + sel + " » n'est pas une iframe (balise " + balise + ")"};
      }
      var d = null;
      try { d = fr.contentDocument; } catch (e) { d = null; }
      if (!d) { return {ok: false, erreur: "contenu du cadre inaccessible (iframe d'une autre origine ?) : " + sel}; }
      chaine.push(fr); doc = d; win = fr.contentWindow;
    }
    return {ok: true, doc: doc, win: win, chaine: chaine, erreur: null};
  }
  function autoniaxDecalageCadre(chaine) {
    var x = 0, y = 0;
    for (var i = 0; i < chaine.length; i++) {
      var r = chaine[i].getBoundingClientRect();
      x += r.left + (chaine[i].clientLeft || 0);
      y += r.top + (chaine[i].clientTop || 0);
    }
    return {x: x, y: y};
  }
"""


_JS_GET_HTML = (r"""
(arg) => {
""" + _JS_RESOUDRE_CADRE + r"""
  try {
    var selecteur = (typeof arg === "string") ? arg : ((arg && arg.selecteur) || "");
    var cadre = (arg && typeof arg === "object") ? (arg.cadre || "") : "";
    var c = autoniaxResoudreCadre(cadre);
    if (!c.ok) { return {trouve: false, erreur: c.erreur, html: ""}; }
    var doc = c.doc;
    if (selecteur) {
      var el = null;
      try { el = doc.querySelector(selecteur); } catch (e) { el = null; }
      if (!el) { return {trouve: false, erreur: "aucun élément ne correspond à ce sélecteur", html: ""}; }
      return {trouve: true, erreur: null, html: el.outerHTML};
    }
    var dt = doc.doctype ? new XMLSerializer().serializeToString(doc.doctype) + "\n" : "";
    return {trouve: true, erreur: null, html: dt + doc.documentElement.outerHTML};
  } catch (e) {
    return {trouve: false, erreur: "exception JS get_html : " + String(e), html: ""};
  }
}
""").strip()


_JS_FIND_ELEMENTS = (r"""
(a) => {
""" + _JS_RESOUDRE_CADRE + r"""
  var c = autoniaxResoudreCadre(a.cadre || "");
  if (!c.ok) { return {ok: false, erreur: c.erreur, total: 0, elements: []}; }
  var doc = c.doc, win = c.win, chaine = c.chaine;
  var DEFAUT = "a[href], button, input, textarea, select, summary, [role=button], [role=link], [role=checkbox], [role=tab], [role=menuitem], [contenteditable=''], [contenteditable=true], [onclick]";
  var sel = a.selecteur || DEFAUT;
  var liste;
  try { liste = Array.prototype.slice.call(doc.querySelectorAll(sel)); }
  catch (e) { return {ok: false, erreur: "sélecteur CSS invalide : " + String(e), total: 0, elements: []}; }
  function estVisible(el, r) {
    if (r.width <= 0 || r.height <= 0) { return false; }
    var st = win.getComputedStyle(el);
    return st.visibility !== "hidden" && st.display !== "none" && parseFloat(st.opacity) !== 0;
  }
  function selecteurUnique(el) {
    if (el.id) {
      var s1 = "#" + CSS.escape(el.id);
      try { if (doc.querySelectorAll(s1).length === 1) { return s1; } } catch (e) {}
    }
    var chemin = [];
    var cur = el;
    while (cur && cur.nodeType === 1 && cur !== doc.documentElement) {
      var part = cur.tagName.toLowerCase();
      if (cur.id) {
        var s2 = "#" + CSS.escape(cur.id);
        try { if (doc.querySelectorAll(s2).length === 1) { chemin.unshift(s2); break; } } catch (e) {}
      }
      var parent = cur.parentElement;
      if (parent) {
        var memes = Array.prototype.filter.call(parent.children, function (c2) { return c2.tagName === cur.tagName; });
        if (memes.length > 1) { part += ":nth-of-type(" + (memes.indexOf(cur) + 1) + ")"; }
      }
      chemin.unshift(part);
      cur = parent;
    }
    return chemin.join(" > ");
  }
  function decrire(el, numero) {
    var r = el.getBoundingClientRect();
    var cx = r.left + r.width / 2, cy = r.top + r.height / 2;
    var haut = null;
    try { haut = doc.elementFromPoint(cx, cy); } catch (e) { haut = null; }
    var couvert = !!haut && !(haut === el || el.contains(haut) || haut.contains(el));
    // Décalage de l'iframe (recalculé ICI, après un éventuel scrollIntoView) : x, y sont toujours
    // des coordonnées de la fenêtre de l'onglet, directement utilisables par click_element().
    var dec = autoniaxDecalageCadre(chaine);
    if (chaine.length && !couvert) {
      // Recouvrement par la page parente (barre d'outils, bandeau...) au-dessus de l'iframe.
      var htop = null;
      try { htop = document.elementFromPoint(cx + dec.x, cy + dec.y); } catch (e) { htop = null; }
      if (htop && htop !== chaine[0]) { couvert = true; }
    }
    var type = (el.getAttribute("type") || "").toLowerCase();
    var texte = (el.innerText || el.value || el.getAttribute("aria-label") || el.getAttribute("title") || "");
    texte = String(texte).replace(/\s+/g, " ").trim().slice(0, 120);
    return {
      index: numero, tag: el.tagName.toLowerCase(), id: el.id || "",
      name: el.getAttribute("name") || "", type: type, role: el.getAttribute("role") || "",
      texte: texte, placeholder: el.getAttribute("placeholder") || "",
      valeur: (type === "password") ? "" : String(el.value !== undefined && el.value !== null ? el.value : ""),
      href: el.getAttribute("href") || "", classe: String(el.className && el.className.baseVal !== undefined ? el.className.baseVal : (el.className || "")),
      selecteur: selecteurUnique(el), visible: estVisible(el, r), couvert: couvert,
      x: Math.round(cx + dec.x), y: Math.round(cy + dec.y), largeur: Math.round(r.width), hauteur: Math.round(r.height)
    };
  }
  var retenus = [];
  for (var i = 0; i < liste.length; i++) {
    var el = liste[i];
    if (a.visibles && !estVisible(el, el.getBoundingClientRect())) { continue; }
    retenus.push(el);
  }
  var total = retenus.length;
  if (typeof a.index === "number") {
    if (a.index < 0 || a.index >= total) { return {ok: true, erreur: null, total: total, elements: []}; }
    var cible = retenus[a.index];
    if (a.scroll) { try { cible.scrollIntoView({block: "center", inline: "center"}); } catch (e) {} }
    return {ok: true, erreur: null, total: total, elements: [decrire(cible, a.index)]};
  }
  var limite = (typeof a.limite === "number" && a.limite > 0) ? a.limite : 100;
  var out = [];
  for (var k = 0; k < retenus.length && out.length < limite; k++) { out.push(decrire(retenus[k], k)); }
  return {ok: true, erreur: null, total: total, elements: out};
}
""").strip()


# AJOUT -- evaluer_js(code, cadre=None) : exécute du JavaScript dans la page (ou dans l'iframe
# `cadre`, dont le document remplace `document` et `window` dans le code). Le code est inséré
# TEL QUEL dans le script évalué par le moteur (protocole CDP/Playwright), PAS passé à eval()/
# new Function() : il n'est donc pas bloqué par la CSP de la page.
_JS_SERIALISER_EVALUER = r"""
  function autoniaxSerialiser(v) {
    if (v === undefined || v === null) { return null; }
    var t = typeof v;
    if (t === "string" || t === "number" || t === "boolean") { return v; }
    if (t === "function") { return String(v); }
    if (v.nodeType === 1) { return v.outerHTML; }
    if (v.nodeType === 9) { return v.documentElement ? v.documentElement.outerHTML : ""; }
    var tag = Object.prototype.toString.call(v);
    if (tag === "[object NodeList]" || tag === "[object HTMLCollection]") {
      return Array.prototype.map.call(v, function (n) { return n.nodeType === 1 ? n.outerHTML : String(n.textContent); });
    }
    try { return JSON.parse(JSON.stringify(v)); } catch (e) { return String(v); }
  }
"""

_DEBUTS_INSTRUCTION_JS = re.compile(
    r"^\s*(var|let|const|if|for|while|do|function|async\s+function|try|throw|switch|class|return|import)\b")


def _corps_evaluer_js(code: str) -> str:
    """Une SEULE expression (ex. `document.title`, `document.querySelectorAll('a').length`) est
    renvoyée directement ; dès qu'il y a plusieurs instructions, utilisez `return` explicitement."""
    brut = (code or "").strip()
    sans_pv = brut.rstrip(";").strip()
    if (sans_pv and "\n" not in sans_pv and ";" not in sans_pv
            and not _DEBUTS_INSTRUCTION_JS.match(sans_pv)):
        return "return (" + sans_pv + ");"
    return brut


def _construire_script_evaluer_js(code: str, cadre: str = "") -> str:
    modele = ("(async function () {\n" + _JS_RESOUDRE_CADRE + _JS_SERIALISER_EVALUER + r"""
  try {
    var c = autoniaxResoudreCadre(__CADRE__);
    if (!c.ok) { return {ok: false, erreur: c.erreur, valeur: null}; }
    var autoniaxCorps = async function (document, window) {
__CODE__
    };
    var v = await autoniaxCorps(c.doc, c.win);
    return {ok: true, erreur: null, valeur: autoniaxSerialiser(v)};
  } catch (e) {
    return {ok: false, erreur: "exception JS : " + (e && e.stack ? e.stack : String(e)), valeur: null};
  }
})()""")
    return modele.replace("__CADRE__", json.dumps(cadre or "")).replace("__CODE__", _corps_evaluer_js(code))


async def action_find_elements(page, params: dict) -> dict:
    """find_elements côté CDP/nodriver -- liste les éléments DOM (ou décrit celui
    d'index `index`, éventuellement amené à l'écran). Retourne
    {"ok", "erreur", "total", "elements"}."""
    script = "(" + _JS_FIND_ELEMENTS + ")(" + json.dumps(params) + ");"
    resultat, exception_details = await page.send(cdp.runtime.evaluate(script, return_by_value=True))
    if exception_details is not None:
        return {"ok": False, "erreur": f"échec JS find_elements : {exception_details}", "total": 0, "elements": []}
    valeur = resultat.value if resultat is not None else None
    if not isinstance(valeur, dict):
        return {"ok": False, "erreur": "réponse JS inattendue", "total": 0, "elements": []}
    return valeur


async def action_get_html(page, selecteur: str, cadre: str = "") -> dict:
    """get_html(selecteur, cadre) côté CDP/nodriver -- HTML du DOM vivant de l'onglet
    actif (ou de l'iframe `cadre`) : document entier si selecteur vide, sinon outerHTML du
    premier élément. Retourne {"trouve", "erreur", "html"}, jamais d'exception pour
    un sélecteur qui ne matche rien."""
    script = "(" + _JS_GET_HTML + ")(" + json.dumps({"selecteur": selecteur or "", "cadre": cadre or ""}) + ");"
    resultat, exception_details = await page.send(cdp.runtime.evaluate(script, return_by_value=True))
    if exception_details is not None:
        return {"trouve": False, "erreur": f"échec JS get_html : {exception_details}", "html": ""}
    valeur = resultat.value if resultat is not None else None
    if not isinstance(valeur, dict):
        return {"trouve": False, "erreur": "réponse JS inattendue", "html": ""}
    return valeur


async def action_evaluer_js(page, code: str, cadre: str = "") -> dict:
    """evaluer_js(code, cadre) côté CDP/nodriver -- exécute `code` dans la page (ou dans l'iframe
    `cadre`, dont le document remplace `document`/`window`). Retourne {"ok", "erreur", "valeur"}."""
    script = _construire_script_evaluer_js(code, cadre)
    resultat, exception_details = await page.send(
        cdp.runtime.evaluate(script, return_by_value=True, await_promise=True))
    if exception_details is not None:
        return {"ok": False, "erreur": f"échec JS evaluer_js : {exception_details}", "valeur": None}
    valeur = resultat.value if resultat is not None else None
    if not isinstance(valeur, dict):
        return {"ok": False, "erreur": "réponse JS inattendue", "valeur": None}
    return valeur


# PATCH (contrôle à distance sur profil Chrome standard -- retour
# utilisateur explicite : "es ce que le scroll, et raccourci clavier
# sont geré pour chrome, je ne pense pas") -- diagnostic confirmé :
# _sur_touche_controle_distance (cf. sa docstring côté client) émet
# TOUJOURS l'action "press_key" pour Entrée/Backspace/Ctrl+A, quel que
# soit le navigateur piloté. Côté sAutoniax, cette action n'existait
# QUE pour Camoufox (action_camoufox_press_key, dispatchée dans
# _executer_commande_camoufox) -- jamais dans ACTIONS_SUPPORTEES ni
# _executer_commande (chemin CDP/nodriver, Chrome/Vivaldi), donc
# systématiquement rejetée en silence côté Chrome ("Action non
# supportée : press_key", cf. _recevoir_messages_serveur) : la
# commande partait bien du client, mais ne touchait jamais le
# navigateur. Le scroll et type_text, eux, étaient déjà correctement
# câblés des deux côtés (ACTIONS_4_2/ACTIONS_ETENDUES) -- seul
# press_key manquait.
#
# Miroir CDP exact de action_camoufox_press_key : même liste blanche
# (_TOUCHES_CAMOUFOX_AUTORISEES, réutilisée telle quelle -- pas de
# copie séparée qui risquerait de diverger), même préalable (reclique
# à (x, y) pour poser le focus AVANT la touche, cf. action_clear/
# action_paste ci-dessus pour le même patron déjà utilisé côté CDP),
# et même mapping de touches que action_clear (Ctrl+A déjà présent
# ci-dessus, Delete -> Backspace/Enter ajoutés ici avec le même
# dispatch_key_event(keyDown puis keyUp)).
_TOUCHES_CDP_PAR_NOM = {
    "Enter": {"key": "Enter", "code": "Enter", "windows_virtual_key_code": 13},
    "Backspace": {"key": "Backspace", "code": "Backspace", "windows_virtual_key_code": 8},
    "Control+a": {"key": "a", "code": "KeyA", "windows_virtual_key_code": 65, "modifiers": 2},
    "Control+c": {"key": "c", "code": "KeyC", "windows_virtual_key_code": 67, "modifiers": 2},  # PATCH Ctrl+C
}


async def _attendre_copie_fraiche(etat_navigateur: dict, ts_avant, delai_max_s: float = 1.0) -> dict:
    """PATCH Ctrl+C -- après un Control+c relayé, attend que le presse-papier
    VIRTUEL de l'instance soit réécrit (horodatage changé) et renvoie
    {"copie": texte}, ou {"copie": None} si rien n'a été copié (aucune
    sélection) : évite de rapatrier une VIEILLE copie."""
    fin = time.monotonic() + delai_max_s
    while time.monotonic() < fin:
        ts = etat_navigateur.get("presse_papier_virtuel_ts")
        if ts is not None and ts != ts_avant:
            return {"copie": str(etat_navigateur.get("presse_papier_virtuel", ""))}
        await asyncio.sleep(0.05)
    return {"copie": None}


async def action_press_key(page, x: int, y: int, touche: str) -> None:
    """press_key(x, y, touche) -- équivalent CDP/nodriver (Chrome/Vivaldi)
    de action_camoufox_press_key (Playwright/Camoufox) ci-dessus : reclique
    d'abord à (x, y) pour poser le focus (même précaution que action_clear/
    action_paste), puis envoie un vrai keyDown+keyUp via dispatch_key_event
    -- ce que page.keyboard n'existe même pas ici (API CDP bas niveau, pas
    Playwright). `touche` vérifiée contre la MÊME liste blanche que côté
    Camoufox (_TOUCHES_CAMOUFOX_AUTORISEES) : ce paramètre vient du réseau
    (pilote -> serveurT -> sAutoniax), jamais transmis tel quel à CDP.

    CORRECTIF (relu après coup -- même bug déjà documenté et réglé côté
    Camoufox, cf. le commentaire "BUG CORRIGÉ" dans action_camoufox_
    press_key ci-dessous, initialement PAS reproduit ici) : un vrai clic
    souris (mousePressed/mouseReleased) avant CHAQUE touche défait
    systématiquement toute sélection en cours et replace le curseur au
    point cliqué -- donc Ctrl+A (sélectionne tout) suivi de Backspace
    ferait, dans cet ordre réel côté page : sélectionne tout, PUIS un
    second clic à (x, y) qui redéfait cette sélection, PUIS Backspace qui
    n'efface alors qu'un seul caractère (même symptôme exact : "ça
    n'efface pas"). Seul Control+a re-clique réellement (il en a besoin
    pour poser un focus initial fiable avant de sélectionner) ; Enter et
    Backspace se contentent de déplacer le curseur virtuel (repère visuel
    seul, cf. _deplacer_curseur_virtuel) sans clic -- un focus existe déjà
    dans ce cas (posé par le Ctrl+A/type_text qui précède dans le même
    geste utilisateur, cf. _sur_touche_controle_distance côté client)."""
    if touche not in _TOUCHES_CAMOUFOX_AUTORISEES:
        raise ValueError(f"touche non autorisée pour press_key : {touche!r}")
    parametres_touche = _TOUCHES_CDP_PAR_NOM[touche]
    if touche == "Control+a":
        await _deplacer_curseur_virtuel(page, x, y)
        await page.send(cdp.input_.dispatch_mouse_event(type_="mousePressed", x=float(x), y=float(y), button=cdp.input_.MouseButton.LEFT, click_count=1))
        await page.send(cdp.input_.dispatch_mouse_event(type_="mouseReleased", x=float(x), y=float(y), button=cdp.input_.MouseButton.LEFT, click_count=1))
    else:
        await _deplacer_curseur_virtuel(page, x, y)
    await page.send(cdp.input_.dispatch_key_event(type_="keyDown", **parametres_touche))
    await page.send(cdp.input_.dispatch_key_event(type_="keyUp", **parametres_touche))


def _resoudre_delai_frappe_ms(delai_min_ms_fourni: int, delai_max_ms_fourni: int, contexte_log: str = "type_text", facteur_vitesse: float = 1.0) -> float:
    """Décide du délai inter-touche RÉELLEMENT utilisé lors de la saisie
    (type_text), partagée par action_type_text (CDP/nodriver) et
    action_camoufox_type_text (Playwright/Camoufox) -- même logique de
    résolution des deux côtés, un seul endroit à maintenir. Miroir exact de
    _resoudre_duree_appui_ms (cf. sa docstring pour le détail des décisions
    utilisateur, reprises ici à l'identique pour la saisie) :

    - Si Data/files/mouseData.sqlite3 contient assez d'intervalles de
      frappe exploitables (cf. MIN_INTERVALLES_FRAPPE_BANK), la banque
      prime INCONDITIONNELLEMENT : un délai est tiré par bootstrap dans
      les intervalles inter-touches RÉELS mesurés (cf.
      generate_keystroke_delay_ms), et delai_min_ms_fourni/
      delai_max_ms_fourni sont ignorés -- même si l'appelant les a fournis
      explicitement.
    - Sinon (banque indisponible), repli explicite sur
      random.randint(delai_min_ms_fourni, delai_max_ms_fourni) --
      comportement identique à celui d'avant ce patch.

    Passe par _charger_banque_frappe_souris() (pas un appel direct à
    generate_keystroke_delay_ms) pour bénéficier de sa vérification
    chemin.is_file() avant toute tentative de connexion SQLite -- même
    précaution que _resoudre_duree_appui_ms (cf. sa docstring, bug détecté
    et corrigé lors du branchement du clic, évité ici dès l'écriture).

    facteur_vitesse (PATCH -- retour utilisateur explicite : "la saisie
    de texte est très lente, je veux que ce soit très rapide, juste pour
    le mode réseau pilotage direct" -- 80% de réduction demandée) :
    multiplie le délai final APRÈS résolution (banque OU repli aléatoire),
    1.0 par défaut = comportement inchangé pour tout appelant qui ne le
    précise pas (mode local nodriver, TestComposantScreen/SequenceurAction,
    etc.). Appliqué ici plutôt qu'en réduisant delai_min_ms_fourni/
    delai_max_ms_fourni côté appelant : la banque de frappe prime sur ces
    bornes de toute façon (cf. ci-dessus), donc les réduire n'aurait eu
    AUCUN effet dès que la banque est disponible -- un facteur appliqué
    ici, après coup, réduit le délai quelle que soit son origine."""
    try:
        bank = _charger_banque_frappe_souris()
        delai_tire = generate_keystroke_delay_ms(str(get_mouse_data_path()), bank=bank)
        delai_tire *= facteur_vitesse
        log.debug(
            f"[{contexte_log}] délai inter-touche tiré de la banque de frappe réelle : "
            f"{delai_tire:.1f}ms (bornes fournies={delai_min_ms_fourni}-{delai_max_ms_fourni}ms, ignorées ; "
            f"facteur_vitesse={facteur_vitesse:.2f})."
        )
        return delai_tire
    except TrajectoireSourisIndisponible as exc:
        log.debug(
            f"[{contexte_log}] banque de frappe indisponible ({exc!r}) -- "
            f"repli sur bornes fournies={delai_min_ms_fourni}-{delai_max_ms_fourni}ms "
            f"(facteur_vitesse={facteur_vitesse:.2f})."
        )
        delai_min = max(0, delai_min_ms_fourni)
        delai_max = max(delai_min, delai_max_ms_fourni)
        delai_resolu = float(random.randint(delai_min, delai_max)) if delai_max > 0 else 0.0
        return delai_resolu * facteur_vitesse


async def action_type_text(page, x: int, y: int, texte: str, delai_min_ms: int = 60, delai_max_ms: int = 180):
    """type_text(x, y, texte, delai_min_ms, delai_max_ms) -- saisie
    caractère par caractère avec délai aléatoire entre chaque frappe
    (comportement plus proche d'une frappe humaine qu'un collage
    instantané). N'appartient PAS aux 8 actions officielles de la section
    4.2 (qui n'ont que paste() pour le texte) -- ajoutée à la demande
    explicite de l'utilisateur, car TestComposantScreen/SequenceurAction
    avait déjà une action "saisir" côté AutoniaX (envoi caractère par
    caractère via PostMessage/WM_CHAR) sans équivalent CDP.

    Une SEULE commande côté fil WebSocket (décision explicite de
    l'utilisateur, cf. discussion : plutôt qu'une commande par caractère
    depuis le pilote) -- toute la boucle et les délais sont gérés ICI,
    dans l'instance, avec un unique command_result renvoyé à la fin de la
    saisie complète, pas un aller-retour réseau par caractère.

    Focus l'élément à (x, y) par un clic simple, comme action_paste, pour
    positionner le curseur texte avant de taper.

    Séquence CDP par caractère -- keyDown -> char -> keyUp. Le paramètre
    `text` ne doit être rempli QUE sur l'événement "char" : c'est lui seul
    qui déclenche l'insertion réelle du caractère dans un champ. Le
    remplir aussi sur keyDown/keyUp provoque une double insertion (chaque
    caractère apparaît deux fois, ex. "i" -> "ii") car Chromium traite un
    keyDown avec `text` non vide comme produisant lui-même de l'input, en
    plus de l'événement char qui suit -- bug constaté et corrigé ici.
    keyDown/keyUp sans `text` restent nécessaires pour la mécanique de
    touche (focus, événements JS keydown/keyup côté page) mais n'insèrent
    rien par eux-mêmes une fois `text` retiré.

    delai_min_ms/delai_max_ms (PATCH -- même logique que duree_appui_ms
    côté action_click, cf. _resoudre_delai_frappe_ms pour le détail
    complet) -- ces deux paramètres sont IGNORÉS dès que
    Data/files/mouseData.sqlite3 contient assez d'intervalles de frappe
    réels exploitables (table `keystrokes`) : le délai RÉELLEMENT appliqué
    entre chaque caractère est alors tiré par bootstrap dans les
    intervalles inter-touches mesurés, même si l'appelant a fourni
    explicitement d'autres bornes. Ne redeviennent la valeur utilisée
    qu'en repli, si la banque est indisponible (fichier absent, ou pas
    assez d'intervalles après filtrage des pauses de frappe)."""
    await _deplacer_curseur_virtuel(page, x, y)
    await page.send(cdp.input_.dispatch_mouse_event(type_="mousePressed", x=float(x), y=float(y), button=cdp.input_.MouseButton.LEFT, click_count=1))
    await page.send(cdp.input_.dispatch_mouse_event(type_="mouseReleased", x=float(x), y=float(y), button=cdp.input_.MouseButton.LEFT, click_count=1))

    for caractere in texte:
        await page.send(cdp.input_.dispatch_key_event(type_="keyDown"))
        await page.send(cdp.input_.dispatch_key_event(type_="char", text=caractere))
        await page.send(cdp.input_.dispatch_key_event(type_="keyUp"))
        delai_reel_ms = _resoudre_delai_frappe_ms(delai_min_ms, delai_max_ms, contexte_log="action_type_text")
        if delai_reel_ms > 0:
            await asyncio.sleep(delai_reel_ms / 1000.0)


async def action_drag(page, x: int, y: int, chemin_fichier: str) -> dict:
    """drag(x, y, chemin_fichier) -- dépose un fichier LOCAL, ou tout le
    contenu fichier d'un DOSSIER local (déjà présent sur le disque de la
    machine qui exécute le navigateur, cf. Action.fichier_drag) sur
    l'élément <input type="file"> repéré à (x, y), via
    DOM.setFileInputFiles -- la méthode CDP standard pour l'upload de
    fichier (cf. discussion), qui attache directement le(s) chemin(s) à
    l'input sans passer par la boîte de dialogue système native (que CDP ne
    peut de toute façon pas piloter).

    Si chemin_fichier pointe vers un DOSSIER (cf. discussion : "le drag de
    dossier doit envoyer tout son contenu fichier"), les fichiers DIRECTS
    de ce dossier (pas les sous-dossiers, pas de récursion) sont listés et
    envoyés comme une sélection multiple -- un <input type="file"> ne peut
    de toute façon jamais recevoir un dossier en tant que tel. Si l'input
    cible n'a pas l'attribut "multiple", Chromium tronque lui-même à 1 seul
    fichier ; rien à vérifier côté ici.

    Ce n'est PAS un vrai drag HTML5 (pas de dragstart/dragover/drop) : la
    plupart des zones de dépôt stylées (dropzone) sont en réalité un
    <input type="file"> cliquable, souvent invisible (display:none/
    opacity:0/hors-écran) superposé à un habillage visuel -- attacher le
    fichier directement à cet input déclenche le même événement 'change'
    qu'un vrai dépôt utilisateur pour la quasi-totalité des implémentations
    JS (Dropzone.js, react-dropzone, FilePond...).

    Localisation de l'input, en 2 passes (cf. discussion, cohérent avec le
    reste du moteur qui vise un point (x, y), pas un sélecteur CSS) :
      1. document.elementFromPoint(x, y) -- si c'est déjà un input file (ou
         un de ses ancêtres proches l'est, cf. closest), on le prend direct.
      2. Sinon (cas fréquent : la dropzone visuelle n'est pas l'input lui-
         même mais un habillage à côté), on cherche le input[type=file] le
         plus proche du point cliqué dans TOUTE la page (candidats visibles
         ou non), via une passe getBoundingClientRect -- distance au centre.

    Retourne {"trouve": bool, "erreur": str|None} : "trouve"=False n'est
    PAS une exception (le point ciblé peut légitimement n'avoir aucun input
    file à proximité, ou le chemin/dossier fourni être invalide) -- laissé
    à l'appelant (command_result ok=False côté _executer_commande, cf.
    bloc except générique) de décider si c'est une erreur bloquante."""
    script_localisation = """
        (function(px, py) {
            function estInputFichier(el) {
                return el && el.tagName === 'INPUT' && el.type === 'file';
            }
            var direct = document.elementFromPoint(px, py);
            var candidat = direct ? (estInputFichier(direct) ? direct : direct.closest('input[type="file"]')) : null;
            if (candidat) return candidat;
            // Repli : aucun input file exactement sous le point (dropzone
            // stylée avec l'input caché ailleurs dans le DOM) -- on prend
            // le input[type=file] de la page le plus proche du point ciblé.
            var tous = Array.prototype.slice.call(document.querySelectorAll('input[type="file"]'));
            if (tous.length === 0) return null;
            var meilleur = null, meilleureDistance = Infinity;
            for (var i = 0; i < tous.length; i++) {
                var r = tous[i].getBoundingClientRect();
                var cx = r.left + r.width / 2, cy = r.top + r.height / 2;
                var d = Math.hypot(cx - px, cy - py);
                if (d < meilleureDistance) { meilleureDistance = d; meilleur = tous[i]; }
            }
            return meilleur;
        })(PLACEHOLDER_X, PLACEHOLDER_Y)
    """
    # Runtime.evaluate seul n'accepte pas d'arguments positionnels (pas de
    # callFunctionOn ici) -- x/y injectés directement dans l'expression
    # plutôt que via des arguments, pour rester sur un simple evaluate
    # comme le reste du fichier (cf. action_copy, _deplacer_curseur_virtuel).
    expression = script_localisation.replace("PLACEHOLDER_X", str(float(x))).replace("PLACEHOLDER_Y", str(float(y)))
    resultat, exception_details = await page.send(cdp.runtime.evaluate(expression, return_by_value=False))
    if exception_details is not None:
        return {"trouve": False, "erreur": f"échec de localisation de l'input file : {exception_details}"}
    if resultat is None or resultat.object_id is None:
        return {"trouve": False, "erreur": "aucun <input type=\"file\"> trouvé à proximité du point ciblé"}
    # Validation du chemin AVANT l'appel CDP : un chemin mal formé (espaces
    # de fin, guillemets encadrants restés d'un copier-coller depuis
    # l'explorateur, chemin inexistant sur CETTE machine -- celle qui
    # exécute le navigateur, pas forcément celle où l'utilisateur a tapé le
    # chemin) fait échouer DOM.setFileInputFiles silencieusement côté
    # Chromium : l'input reçoit une liste de fichiers vide/invalide, le
    # site voit un dépôt vide ou une erreur d'upload générique (parfois
    # affichée à tort comme un problème de connexion). On échoue ici avec
    # un message explicite plutôt que de laisser ce cas passer inaperçu.
    chemin_nettoye = chemin_fichier.strip().strip('"').strip("'")
    if not chemin_nettoye:
        return {"trouve": False, "erreur": "aucun chemin de fichier fourni pour le drag"}
    if os.path.isdir(chemin_nettoye):
        # Drag de DOSSIER (cf. discussion) : un <input type="file"> ne
        # peut jamais recevoir un dossier lui-même -- on envoie donc tout
        # son CONTENU fichier (les entrées directes qui sont des fichiers,
        # pas les sous-dossiers -- pas de récursion) comme une sélection
        # multiple. Chromium tronque lui-même à 1 seul fichier si l'input
        # cible n'a pas l'attribut "multiple" -- rien à vérifier ici.
        fichiers = sorted(
            os.path.join(chemin_nettoye, nom)
            for nom in os.listdir(chemin_nettoye)
            if os.path.isfile(os.path.join(chemin_nettoye, nom))
        )
        if not fichiers:
            return {"trouve": False, "erreur": f"dossier vide (aucun fichier direct) : {chemin_nettoye!r}"}
    elif os.path.isfile(chemin_nettoye):
        fichiers = [chemin_nettoye]
    else:
        return {"trouve": False, "erreur": f"fichier ou dossier introuvable sur la machine du navigateur : {chemin_nettoye!r}"}
    await page.send(cdp.dom.set_file_input_files(files=fichiers, object_id=resultat.object_id))
    return {"trouve": True, "erreur": None}


async def action_drag_page(page, chemin_fichier: str) -> dict:
    """drag_page(chemin_fichier) -- AJOUT (demande explicite utilisateur :
    "je veux que drag soit plutôt lié à la page web actuelle et non à un
    composant, c'est-à-dire dragger sur la page web actuelle") -- variante
    de action_drag ci-dessus qui ne vise AUCUN point (x, y) précis : toute
    la logique de ciblage par COMPOSANT (élément exact sous un point, puis
    repli sur l'input file le plus proche de ce point) est retirée, il ne
    reste que la recherche PAGE ENTIÈRE -- utile quand l'input file réel
    d'une page (souvent invisible/hors-écran, cf. docstring action_drag)
    n'est pas nécessairement sous le composant visuel qu'on ciblerait,
    voire quand aucun Composant n'a même été détouré pour cette zone de
    dépôt.

    Toujours PAS un vrai drag HTML5 (pas de dragstart/dragover/drop),
    toujours via DOM.setFileInputFiles -- mêmes limites et même
    comportement que action_drag pour tout le reste (dossier -> tous ses
    fichiers directs envoyés comme sélection multiple, validation du
    chemin AVANT l'appel CDP, etc.), factorisé ci-dessous plutôt que
    dupliqué.

    S'il y a PLUSIEURS input[type=file] sur la page (cas réel : une page
    de chat peut avoir un input caché pour les pièces jointes ET un autre
    pour un avatar de profil, par exemple), le PREMIER trouvé dans l'ordre
    du DOM (document.querySelectorAll) est utilisé -- pas de notion de
    "plus proche" possible ici puisqu'aucun point de référence n'existe.
    Sur une page à input file unique (cas de loin le plus courant), ce
    choix est sans ambiguïté.

    Retourne {"trouve": bool, "erreur": str|None}, même contrat que
    action_drag."""
    script_localisation = """
        (function() {
            var tous = document.querySelectorAll('input[type="file"]');
            return tous.length > 0 ? tous[0] : null;
        })()
    """
    resultat, exception_details = await page.send(cdp.runtime.evaluate(script_localisation, return_by_value=False))
    if exception_details is not None:
        return {"trouve": False, "erreur": f"échec de localisation de l'input file : {exception_details}"}
    if resultat is None or resultat.object_id is None:
        return {"trouve": False, "erreur": "aucun <input type=\"file\"> trouvé sur cette page"}
    # Même validation de chemin que action_drag (cf. sa docstring pour le
    # pourquoi -- DOM.setFileInputFiles échoue silencieusement sur un
    # chemin mal formé).
    chemin_nettoye = chemin_fichier.strip().strip('"').strip("'")
    if not chemin_nettoye:
        return {"trouve": False, "erreur": "aucun chemin de fichier fourni pour le drag"}
    if os.path.isdir(chemin_nettoye):
        fichiers = sorted(
            os.path.join(chemin_nettoye, nom)
            for nom in os.listdir(chemin_nettoye)
            if os.path.isfile(os.path.join(chemin_nettoye, nom))
        )
        if not fichiers:
            return {"trouve": False, "erreur": f"dossier vide (aucun fichier direct) : {chemin_nettoye!r}"}
    elif os.path.isfile(chemin_nettoye):
        fichiers = [chemin_nettoye]
    else:
        return {"trouve": False, "erreur": f"fichier ou dossier introuvable sur la machine du navigateur : {chemin_nettoye!r}"}
    await page.send(cdp.dom.set_file_input_files(files=fichiers, object_id=resultat.object_id))
    return {"trouve": True, "erreur": None}


# AJOUT (demande explicite utilisateur : "je veux que lorsque on clic sur
# un bouton de copy de texte dans une page web qui es censé copier du
# texte alors sa reste dans le presse papier de l'instance et non du
# presse papier de l'ordinateur, et je veux pouvoir récupérer ce texte la
# via la méthode get_presse_papier de l'instance") -- DISTINCT
# d'action_copy/action_get_clipboard juste en dessous (ceux-là couvrent le
# cas où c'est le SCRIPT AutoniaX qui déclenche lui-même une copie).
# Ici : la PAGE elle-même déclenche la copie (bouton "Copier" natif de la
# page, via document.execCommand('copy') ou navigator.clipboard.writeText()
# en JS) -- SANS action pilotée par AutoniaX, donc rien dans
# _executer_commande ne peut intercepter ça au moment où ça arrive. Il faut
# rediriger la copie AVANT que Chrome ne l'exécute nativement (ce qui
# écrirait dans le presse-papier Windows, cf. bug rapporté).
#
# Mécanisme : un script JS injecté dans CHAQUE document de CHAQUE onglet
# de cette instance (cf. Page.addScriptToEvaluateOnNewDocument -- s'exécute
# AVANT tout script de la page elle-même, donc peut redéfinir
# navigator.clipboard.writeText avant que le bouton "Copier" de la page ne
# s'en serve) :
#   1. Redéfinit navigator.clipboard.writeText pour envoyer le texte à
#      Python via un binding CDP (cf. _POSER_BINDING_PRESSE_PAPIER),
#      SANS jamais appeler l'implémentation native -- rien n'atteint donc
#      jamais le presse-papier Windows par ce chemin.
#   2. Intercepte aussi l'événement DOM "copy" (déclenché par
#      document.execCommand('copy') OU par un vrai Ctrl+C humain) en
#      preventDefault() + en lisant window.getSelection().toString() nous-
#      mêmes, avant que le navigateur n'écrive quoi que ce soit dans le
#      presse-papier système.
#
# ---------------------------------------------------------------------------
# PATCH (robustesse capture de copie presse-papier) -- constantes nommées
# plutôt que valeurs magiques noyées dans le code, cf. style du fichier.
#
# DELAI_DETECTION_COPIE_PRESSE_PAPIER_S : budget total accordé à la
# détection d'une copie APRÈS un click(copier_presse_papier=True).
# Remplace l'ancien `await asyncio.sleep(0.1)` fixe, qui échouait dès que
# le site mettait plus de 100 ms à copier (requête réseau préalable,
# animation, traitement JS lourd) -- un budget large ne coûte RIEN dans le
# cas nominal puisque le polling rend la main dès la première copie
# fraîche détectée (return immédiat dans la boucle de
# _attendre_copie_presse_papier_fraiche, JAMAIS d'attente jusqu'à
# l'échéance quand la copie arrive plus tôt), souvent en une ou deux
# itérations.
#
# PATCH (demande utilisateur explicite : "fait monter a 5 seconde" -- plus
# de marge en cas de machine chargée : plusieurs instances tournant en
# parallèle peuvent ralentir à la fois la boucle asyncio elle-même
# (asyncio.sleep(INTERVALLE_POLL_COPIE_PRESSE_PAPIER_S) rend la main plus
# tard que prévu si l'event loop est occupée ailleurs) ET le site web
# piloté (JS de copie plus lent à s'exécuter si le rendu est ralenti par la
# charge CPU globale de la machine) -- 2.0 s pouvait alors ne pas suffire.
# Passé de 2.0 à 5.0 : élargit uniquement le pire cas (site lent/machine
# chargée) avant abandon (frais=False) ; le cas nominal, qui rend la main
# dès la première copie fraîche détectée, reste tout aussi rapide qu'avant
# ce patch.
#
# INTERVALLE_POLL_COPIE_PRESSE_PAPIER_S : granularité du polling. 25 ms est
# un compromis : assez fin pour que le cas nominal reste imperceptible
# (une seule itération dans l'immense majorité des cas), assez gros pour
# ne pas saturer la boucle asyncio de l'instance pendant le budget total.
#
# GRACE_COPIE_GLOBALE_S : cf. _attendre_copie_presse_papier_fraiche -- une
# fois qu'une copie fraîche est apparue sur le presse-papier GLOBAL sans
# id correspondant, on n'attend pas bêtement la fin du budget total (l'id
# et le global sont écrits par le MÊME callback, donc un global frais sans
# id frais signifie presque toujours que le JS n'a pas su déterminer d'id)
# -- juste ce court délai de grâce, qui couvre le cas limite de deux
# copies successives dont seule la seconde porte l'id attendu.
# ---------------------------------------------------------------------------
DELAI_DETECTION_COPIE_PRESSE_PAPIER_S = 5.0
INTERVALLE_POLL_COPIE_PRESSE_PAPIER_S = 0.025
GRACE_COPIE_GLOBALE_S = 0.2


# PATCH (clic HUMAIN sur un bouton "Copier" du site) -- durée pendant
# laquelle une copie est considérée comme issue d'une action du SCRIPT
# après un clic envoyé par action_click : le budget de détection de copie
# (DELAI_DETECTION_COPIE_PRESSE_PAPIER_S) + 1 s de marge. Au-delà, un clic
# sur "Copier" est considéré comme humain et écrit aussi dans le
# presse-papier Windows. Limite connue : un humain qui clique sur "Copier"
# dans cette fenêtre juste après un clic du script reste traité comme script.
DELAI_MARQUE_ACTION_SCRIPT_S = 1.5


async def _marquer_action_script_presse_papier(page) -> None:
    """Pose window.__autoniax_script_jusqua__ dans la page (cf.
    _JS_INTERCEPTION_PRESSE_PAPIER, actionScriptRecente). Jamais bloquant :
    si l'évaluation échoue (navigation en cours...), le marqueur reste
    absent côté JS."""
    try:
        await page.send(cdp.runtime.evaluate(
            f"window.__autoniax_script_jusqua__ = Date.now() + {int(DELAI_MARQUE_ACTION_SCRIPT_S * 1000)};"
        ))
    except Exception as e:
        log.debug(f"[presse-papier] marquage action script impossible : {e!r}")


def _memoriser_copie_presse_papier(etat_navigateur: dict, texte: str, id_declencheur: str = "") -> float:
    """Point d'écriture UNIQUE du presse-papier virtuel d'une instance --
    partagé par les deux moteurs (binding CDP _sur_binding_appele et
    callback Camoufox _sur_copie) ET par l'action "copy" explicite, pour
    qu'aucun chemin d'écriture ne puisse oublier l'horodatage.

    PATCH (robustesse capture de copie) : horodate CHAQUE écriture avec
    time.monotonic() -- volontairement PAS time.time(), qui peut reculer
    (synchronisation NTP, changement d'heure système) et invaliderait
    silencieusement toute comparaison de fraîcheur. Sans cet horodatage,
    il était impossible de distinguer une copie qui vient de se produire
    d'une copie vieille de plusieurs minutes sur le même id -- cas
    parfaitement réel d'une SPA qui réutilise le même id à travers
    plusieurs re-renders, où click(copier_presse_papier=True) renvoyait
    alors une valeur périmée sans le moindre signal.

    COMPATIBILITÉ : etat_navigateur["presse_papier_virtuel"] reste une
    SIMPLE CHAÎNE (l'horodatage va dans une clé SÉPARÉE,
    "presse_papier_virtuel_ts"), parce que cette valeur est relue telle
    quelle par action_get_clipboard / action_camoufox_get_clipboard /
    l'action "paste" / l'action "copy" -- tous doivent continuer à voir
    une chaîne, cf. leurs docstrings. Seul
    "presse_papier_virtuel_par_id", qui n'est lu QUE par le chemin
    click(copier_presse_papier=True), change de forme et stocke désormais
    {"texte": ..., "ts": ...}.

    Retourne l'horodatage posé (utile aux appelants qui veulent logger)."""
    horodatage = time.monotonic()
    etat_navigateur["presse_papier_virtuel"] = texte
    etat_navigateur["presse_papier_virtuel_ts"] = horodatage
    if id_declencheur:
        etat_navigateur.setdefault("presse_papier_virtuel_par_id", {})[id_declencheur] = {
            "texte": texte, "ts": horodatage,
        }
    return horodatage


def _texte_et_horodatage_copie(entree) -> tuple:
    """Lit une entrée de etat_navigateur["presse_papier_virtuel_par_id"]
    et retourne (texte, horodatage).

    REPLI RÉTROCOMPATIBLE délibéré : une entrée peut encore être une
    simple chaîne si elle a été écrite par une version antérieure du code
    encore vivante dans le même process (ou par un chemin oublié ici) --
    on la traite alors comme "texte sans horodatage connu", horodatage
    None, donc jamais considérée comme fraîche mais jamais cause de
    plantage non plus (principe défensif : dégrader vers l'ancien
    comportement plutôt que lever une exception qu'aucun appelant
    existant n'attend)."""
    if isinstance(entree, dict):
        return str(entree.get("texte", "")), entree.get("ts")
    if entree is None:
        return None, None
    return str(entree), None


async def _attendre_copie_presse_papier_fraiche(
    etat_navigateur: dict, id_dom_cible: str, horodatage_reference: float,
    delai_max_s: float = DELAI_DETECTION_COPIE_PRESSE_PAPIER_S,
    prefixe_log: str = "",
) -> dict:
    """Attend qu'une copie POSTÉRIEURE à `horodatage_reference` (capturé
    juste AVANT l'envoi du clic) apparaisse dans le presse-papier virtuel
    de cette instance, et la retourne.

    PATCH (robustesse capture de copie) -- remplace l'ancien
    `await asyncio.sleep(0.1)` suivi d'une lecture directe, qui cumulait
    deux défauts distincts :
      1. délai fixe trop court dès que le site tarde à copier ;
      2. AUCUNE garantie que la valeur lue venait de CE clic -- si aucune
         copie n'arrivait, l'ancien code retournait quand même la dernière
         valeur connue, donc potentiellement la copie d'un clic précédent
         totalement sans rapport, silencieusement.

    On NE VIDE JAMAIS l'entrée existante avant le clic (ce serait pourtant
    la solution la plus simple) : deux clics rapprochés sur le MÊME
    composant doivent chacun réussir, et vider l'état casserait le second
    si le premier n'a pas encore été relu. La comparaison d'horodatages
    donne la même garantie sans détruire d'information.

    Retourne toujours un dict (jamais d'exception) :
      {"texte": str|None, "frais": bool, "origine": "id"|"global"|"aucune",
       "message": str|None}
    `frais=False` signifie "aucune copie imputable à CE clic n'a été
    observée" -- l'appelant doit alors le remonter explicitement plutôt
    que de faire passer une valeur périmée pour un succès."""
    try:
        # AJOUT (demande explicite utilisateur : plusieurs sélecteurs
        # candidats dans un même id_dom, séparés par "||") : id_dom_cible
        # peut désormais contenir plusieurs clés candidates -- chacune est
        # vérifiée dans presse_papier_virtuel_par_id, la première fraîche
        # trouvée gagne. Un id_dom historique à un seul sélecteur (sans
        # "||") continue de fonctionner à l'identique (liste à un élément).
        ids_candidats = [c.strip() for c in id_dom_cible.split("||") if c.strip()] if id_dom_cible else []
        echeance = horodatage_reference + max(0.0, float(delai_max_s))
        echeance_grace_globale = None
        texte_global_frais = None
        while True:
            valeurs_par_id = etat_navigateur.get("presse_papier_virtuel_par_id", {}) or {}
            for id_candidat in ids_candidats:
                texte_id, ts_id = _texte_et_horodatage_copie(valeurs_par_id.get(id_candidat))
                if ts_id is not None and ts_id >= horodatage_reference:
                    return {"texte": texte_id, "frais": True, "origine": "id", "message": None}
            ts_global = etat_navigateur.get("presse_papier_virtuel_ts")
            global_est_frais = ts_global is not None and ts_global >= horodatage_reference
            if global_est_frais:
                texte_global_frais = str(etat_navigateur.get("presse_papier_virtuel", ""))
                if not ids_candidats:
                    return {"texte": texte_global_frais, "frais": True, "origine": "global", "message": None}
