async def action_camoufox_type_text(
    page, x: int, y: int, texte: str,
    delai_min_ms: int = 60, delai_max_ms: int = 180, avec_clic: bool = True,
    facteur_vitesse: float = 1.0,
) -> None:
    """type_text(x, y, texte, delai_min_ms, delai_max_ms, avec_clic,
    facteur_vitesse) -- frappe caractère par caractère avec délai
    aléatoire entre chaque touche, même contrat que action_type_text côté
    nodriver (une seule commande, toute la boucle + délais gérés ici, un
    seul command_result renvoyé une fois le texte entier tapé).

    avec_clic (PATCH -- retour utilisateur explicite : "lorsque je saisis
    le texte très rapidement, ça se décale, ça ne met pas souvent dans le
    bon ordre" -- diagnostic complet côté PanneauRenduInstance/
    FenetreRenduTaskReseau._sur_debounce_texte_clavier) : True par défaut
    (comportement inchangé pour tout appelant qui ne le précise pas). Une
    saisie continue rapide peut être coupée en PLUSIEURS commandes
    "type_text" successives par le débounce du pilote (une micro-pause de
    frappe > 400ms en plein milieu du geste suffit) -- avant ce patch,
    CHAQUE morceau re-cliquait à (x, y), qui reste le point du tout
    PREMIER clic de la session de contrôle, PAS la fin du texte déjà
    inséré par le morceau précédent. Sur un champ qui s'agrandit au fil
    de la frappe, ce point fixe finit par tomber au milieu du texte déjà
    tapé une fois le champ assez rempli -- le clic de refocus y replaçait
    alors le curseur, et la suite du texte s'insérait à cet endroit
    plutôt qu'à la fin : exactement le symptôme "le texte se décale, mal
    ordonné" en frappe rapide. Fixé en ne cliquant que pour le PREMIER
    morceau d'une saisie continue (avec_clic=True, cf. FenetreRenduTaskReseau
    ._sur_debounce_texte_clavier côté pilote, qui met avec_clic=False pour
    tout morceau suivant tant qu'aucun NOUVEAU clic souris réel n'a eu
    lieu entre-temps) : les morceaux suivants tapent directement à la
    position COURANTE du curseur (déjà à la fin du texte précédent,
    puisque page.keyboard.type() y laisse le curseur), sans jamais le
    redéplacer.

    facteur_vitesse (PATCH -- retour utilisateur explicite : "la saisie
    de texte est très lente, je veux que ce soit très rapide, juste pour
    le mode réseau pilotage direct", "80 pourcent" de réduction) --
    transmis tel quel à _resoudre_delai_frappe_ms (cf. sa docstring pour
    le pourquoi de l'appliquer APRÈS résolution du délai plutôt qu'en
    réduisant delai_min_ms/delai_max_ms). 1.0 par défaut = comportement
    inchangé pour tout appelant qui ne le précise pas -- seul
    FenetreRenduTaskReseau (pilotage réseau direct, cf. _executer_
    commande_camoufox) envoie une valeur réduite."""
    try:
        if avec_clic:
            await _camoufox_clic_simple_focus(page, x, y)
        for caractere in texte:
            await page.keyboard.type(caractere, delay=0)
            delai_reel_ms = _resoudre_delai_frappe_ms(
                delai_min_ms, delai_max_ms, contexte_log="camoufox][action_camoufox_type_text",
                facteur_vitesse=facteur_vitesse,
            )
            if delai_reel_ms > 0:
                await asyncio.sleep(delai_reel_ms / 1000.0)
    except Exception as exc:
        _camoufox_relever_si_fermeture(exc)
        raise


# PATCH (contrôle à distance -- demande explicite utilisateur : "je veux
# aussi que les touche entrer soit relayer"). page.keyboard.type() (cf.
# action_camoufox_type_text ci-dessus) tape des caractères IMPRIMABLES --
# "\n" n'y déclenche PAS un vrai événement keydown/keyup Enter côté page
# (Playwright ne l'interprète pas comme la touche, contrairement à un
# éventuel .press("Enter") natif). D'où cette action séparée, minimale :
# touches de contrôle nommées (pas de refonte du dispatcher clavier
# entier) -- Enter puis Backspace (PATCH -- demande explicite
# utilisateur : "modifie aussi pour que la touche backspace soit pris en
# compte comme enter", cf. docstring _sur_touche_controle_distance côté
# client : Backspace efface localement le texte pas encore flush, ou
# part en press_key si rien n'est en attente), puis Control+a (PATCH --
# demande explicite utilisateur : "je veux que le combo ctrl+a la
# selection de texte soit aussi géré comme entrer et backspace" -- même
# détection explicite AVANT le filtre texte imprimable côté
# _sur_touche_controle_distance, cf. sa docstring : Qt renvoie un
# event.text() vide/non imprimable pour ce combo de toute façon, mais
# mieux vaut le détecter explicitement plutôt que de compter sur ce
# comportement implicite). "Control+a" est la syntaxe native Playwright
# pour .press() (modificateur+touche séparés par "+"), transmise telle
# quelle à page.keyboard.press() ci-dessous -- aucune traduction
# supplémentaire nécessaire. Les flèches restent hors périmètre de ce
# patch, limite connue de cette V1.
_TOUCHES_CAMOUFOX_AUTORISEES = {"Enter", "Backspace", "Control+a", "Control+c"}  # PATCH Ctrl+C


async def action_camoufox_press_key(page, x: int, y: int, touche: str) -> None:
    """press_key(x, y, touche) -- reclique d'abord à (x, y) pour poser le
    focus (même précaution que type_text/paste, cf. _camoufox_clic_simple_
    focus : sans focus explicite, Enter partirait vers l'élément qui a le
    focus par défaut/résiduel, potentiellement pas le bon), puis envoie un
    vrai .press() Playwright -- keydown+keyup natifs, ce que page.keyboard.
    type("\\n") ne fait pas. `touche` est vérifiée contre une liste
    blanche fixe (_TOUCHES_CAMOUFOX_AUTORISEES) plutôt que transmise
    telle quelle à Playwright : ce paramètre vient du réseau (pilote ->
    serveurT -> sAutoniax), donc jamais une valeur arbitraire côté page
    -- même prudence que pour toute commande relayée depuis un client
    distant ailleurs dans ce fichier."""
    if touche not in _TOUCHES_CAMOUFOX_AUTORISEES:
        raise ValueError(f"touche non autorisée pour press_key : {touche!r}")
    try:
        # BUG CORRIGÉ (retour utilisateur explicite : "quand je fais ctrl a
        # sur le texte et que jappui backspace sa nefface pas") --
        # _camoufox_clic_simple_focus() ci-dessus faisait un VRAI
        # page.mouse.click(x, y) avant CHAQUE touche relayée, Control+a
        # inclus. Or un clic souris dans un champ de texte défait
        # systématiquement toute sélection en cours et repositionne le
        # curseur au point cliqué (comportement standard de n'importe
        # quel champ texte/textarea/contenteditable) -- donc la séquence
        # Ctrl+A (sélectionne tout) -> Backspace faisait, dans cet ordre
        # réel côté page : sélectionne tout, PUIS un second clic à (x, y)
        # qui redéfait cette sélection et replace juste le curseur, PUIS
        # Backspace qui n'efface alors qu'un seul caractère à cet endroit
        # -- d'où l'impression que "ça n'efface pas" (rien de visible ne
        # disparaissait, la sélection entière restant intacte).
        #
        # Fix : seul Control+a re-clique réellement (page.mouse.click) --
        # il en a besoin pour poser un focus initial fiable avant de
        # sélectionner (même cas qu'avant ce patch, ex. un champ qui n'a
        # encore reçu aucune interaction dans cette session de contrôle).
        # Enter et Backspace n'ont plus besoin de ce vrai clic : soit un
        # focus existe déjà (posé par le Ctrl+A/type_text qui précède
        # dans le même geste utilisateur, cf. _sur_touche_controle_distance
        # côté client -- Ctrl+A/Enter/Backspace flush toujours le texte
        # en attente AVANT d'être émis, donc un focus a déjà été posé par
        # ce flush ou par un clic explicite antérieur), soit aucun focus
        # n'existe et ces deux touches n'ont de toute façon aucun texte/
        # sélection sur lequel agir utilement. Le curseur virtuel (cercle
        # bleu, feedback visuel pour l'utilisateur distant) continue lui
        # d'être déplacé dans tous les cas via
        # _camoufox_deplacer_curseur_virtuel seule -- SANS le
        # page.mouse.click() qui l'accompagnait dans
        # _camoufox_clic_simple_focus.
        if touche == "Control+a":
            await _camoufox_clic_simple_focus(page, x, y)
        else:
            await _camoufox_deplacer_curseur_virtuel(page, x, y)
        await page.keyboard.press(touche)
    except Exception as exc:
        _camoufox_relever_si_fermeture(exc)
        raise


