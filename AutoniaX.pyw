    }}
    """


def build_palette() -> QPalette:
    """QPalette Fusion basée sur Catppuccin Mocha (utile pour les widgets natifs)."""
    m = Mocha
    pal = QPalette()
    pal.setColor(QPalette.Window, QColor(m.base))
    pal.setColor(QPalette.WindowText, QColor(m.text))
    pal.setColor(QPalette.Base, QColor(m.surface0))
    pal.setColor(QPalette.AlternateBase, QColor(m.surface1))
    pal.setColor(QPalette.ToolTipBase, QColor(m.surface0))
    pal.setColor(QPalette.ToolTipText, QColor(m.text))
    pal.setColor(QPalette.Text, QColor(m.text))
    pal.setColor(QPalette.Button, QColor(m.surface0))
    pal.setColor(QPalette.ButtonText, QColor(m.text))
    pal.setColor(QPalette.BrightText, QColor(m.red))
    pal.setColor(QPalette.Link, QColor(m.blue))
    pal.setColor(QPalette.Highlight, QColor(m.mauve))
    pal.setColor(QPalette.HighlightedText, QColor(m.crust))
    pal.setColor(QPalette.PlaceholderText, QColor(m.overlay0))

    pal.setColor(QPalette.Disabled, QPalette.Text, QColor(m.overlay0))
    pal.setColor(QPalette.Disabled, QPalette.ButtonText, QColor(m.overlay0))
    pal.setColor(QPalette.Disabled, QPalette.WindowText, QColor(m.overlay0))
    return pal


# ---------------------------------------------------------------------------
# QComboBox avec signal de fermeture de popup (utilisé par TestComposantScreen
# pour restaurer l'aperçu de la sélection réelle après un survol sans clic :
# QComboBox n'expose aucun signal natif "popup fermé sans validation", donc
# on surcharge hidePopup() pour émettre popup_ferme() à chaque fermeture,
# que ce soit par clic (validation) ou par Échap/clic extérieur (annulation).
# ---------------------------------------------------------------------------
class ComboBoxAvecFermeturePopup(QComboBox):
    popup_ferme = Signal()
    popup_ouvert = Signal()

    def showPopup(self):
        self.popup_ouvert.emit()
        super().showPopup()

    def hidePopup(self):
        super().hidePopup()
        self.popup_ferme.emit()


