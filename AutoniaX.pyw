    def _notifier_upload_profil_resultat(self, id_pilote_cible: str, nom_profil: str, ok: bool, taille_octets: int = 0, erreur: str = ""):
        """AJOUT (SPEC_upload_profil_drive_direct.md, section 3.3) --
        notifie le serveur du résultat RÉEL d'un upload de profil qui
        vient de se faire en Drive DIRECT (donc sans que le serveur en
        ait jamais vu les octets), UNIQUEMENT quand cet upload avait été
        demandé à distance par un pilote (id_pilote_cible non vide) --
        appelée depuis _envoyer_profil, jamais directement depuis l'UI.
        Fire-and-forget, même patron que envoyer_upload_profil_echec_local
        ci-dessus : le serveur relaie ce résultat au pilote ciblé (cf.
        serveur.py, handler notifier_upload_profil_resultat) en best-
        effort, sans jamais faire échouer l'upload lui-même (déjà terminé
        à ce stade, succès ou échec)."""
        if not id_pilote_cible or self._loop is None or not self._loop.is_running() or self._ws is None:
            return
        message = {
            "type": "notifier_upload_profil_resultat",
            "id_pilote": id_pilote_cible, "nom_profil": nom_profil, "ok": ok,
        }
        if ok:
            message["taille_octets"] = taille_octets
        else:
            message["erreur"] = erreur

        # BUGFIX -- run_coroutine_threadsafe() ne fait QUE planifier la
        # coroutine sur self._loop ; son Future est ici jeté sans jamais
        # être consulté (ni .result(), ni add_done_callback). Si self._ws.
        # send() lève (connexion coupée entre l'émission du succès Drive
        # et cet appel -- fenêtre réelle), l'exception restait auparavant
        # invisible : elle finit seulement dans les logs asyncio internes
        # ("Future exception was never retrieved"), jamais dans
        # log_reseau_t comme le reste de ce fichier, ET violait la
        # promesse "best-effort" de la docstring ci-dessus. _sur_echec_
        # envoi ci-dessous consulte explicitement le résultat de la tâche
        # pour ne jamais laisser d'exception orpheline, tout en restant
        # fire-and-forget (aucun await ici, le flux appelant --
        # _envoyer_profil -- n'est jamais bloqué ni mis en échec par ceci).
        def _sur_echec_envoi(tache: "asyncio.Future"):
            exc = tache.exception()
            if exc is not None:
                log_reseau_t.warning(
                    f"Échec notification résultat upload profil '{nom_profil}' "
                    f"vers pilote '{id_pilote_cible}' : {exc!r} (best-effort, ignoré)."
                )

        future = asyncio.run_coroutine_threadsafe(self._ws.send(json.dumps(message)), self._loop)
        future.add_done_callback(_sur_echec_envoi)

