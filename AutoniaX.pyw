    def __init__(self, parent=None):
        super().__init__(parent)
        # id_executant -> dict brut reçu (cf. Connexion.vers_dict côté
        # serveurT : "id", "role", "nom", "connecte_le", "statut") --
        # source de vérité pour reconstruire la table à chaque réception,
        # et pour résoudre id_executant/nom depuis une ligne sélectionnée
        # dans les actions du menu contextuel.
        self._executants: dict[str, dict] = {}
        # AJOUT (retour explicite utilisateur, capture annotée -- "je ne
        # veux plus que on met inactifs, sa doit etre actifs si on est
        # toujour connecter, inactifs si la connexion a été perdue ou ne
        # repond plus") -- ids d'exécutants actuellement considérés
        # SILENCIEUX (watchdog serveurT, cf. ClientServeurT.
        # executant_silencieux_recu -- jusqu'ici défini/émis mais jamais
        # connecté nulle part, cf. sa docstring de classe : "purement
        # informatif ici [...] sans qu'aucun écran n'y soit encore
        # connecté à ce stade"). Piloté par sur_executant_silencieux ci-
        # dessous : ajouté à chaque alerte reçue, jamais retiré
        # explicitement par un signal de résolution (le serveur n'en émet
        # aucun, cf. sa docstring : "un seul par épisode de silence") --
        # retiré ici par déduction, à chaque reconstruction normale de la
        # table (cf. sur_executants_detail_change) : un id encore présent
        # dans `executants` prouve qu'il communique de nouveau avec le
        # serveurT (sinon le registre l'aurait retiré), donc son silence
        # est résolu. Distinct de `statut` (Connexion.statut, "inactif"/
        # "demarrage_profils"/... -- REFLÈTE une activité, pas une
        # connectivité, cf. _libelle_statut) : "Inactif" affiché en
        # colonne Statut dépend maintenant UNIQUEMENT de cet ensemble, pas
        # de `statut`.
        self._executants_silencieux: set[str] = set()
        # AJOUT (retour explicite utilisateur : "si tout n'a pas été
        # téléchargé pour un sAutoniax ça ne devrait même pas apparaître
        # dans la liste des instances ... normalement quand tout a été
        # téléchargé avant que ça doit être actif ... ça doit être
        # grisé, on ne peut pas avoir de détails sur lui, c'est quand il
        # a complètement été chargé (toutes ses dépendances téléchargées
        # côté sAutoniax) avant que il ne doit plus être grisé et on
        # peut voir les propriétés (panneau de la liste des profils) et
        # il devient actif, et non inactif").
        #
        # Un sAutoniax apparaît dans la table dès son "register" (cf.
        # serveur.py, registre.ajouter() + diffuser_liste_executants()
        # appelés synchroneement au register, BIEN AVANT que
        # _sautoniax_assurer_donnees_de_base ait fini de télécharger
        # mouseData.sqlite3/service_api.zip côté AutoniaX.py) -- il
        # n'existe aucun moyen de le retirer de la liste sans casser la
        # source de vérité côté serveur (registre), donc la ligne reste
        # affichée, mais visuellement GRISÉE et NON SÉLECTIONNABLE tant
        # que "sautoniax_pret" (cf. ClientServeurT.sautoniax_pret_recu,
        # déjà diffusé par le serveur une fois que TOUTES les données de
        # base sont prêtes côté sAutoniax, cf. AutoniaX.py
        # _main_async_sautoniax : "prêt" n'est émis qu'après
        # _sautoniax_assurer_donnees_de_base ET tous les .connect() de
        # gestionnaires de commandes) n'a pas encore été reçu pour cet
        # id_executant précis.
        #
        # Même patron EXACT que PanneauProprietesSautoniax._sautoniax_
        # prets (jamais retiré une fois ajouté, cf. sa docstring) --
        # tenu ICI EN PLUS (pas à la place) car le panneau de droite ne
        # contrôle que son propre bouton "Générer", pas la sélectionna-
        # bilité de la ligne de gauche ni son apparence.
        self._sautoniax_prets: set[str] = set()
        # PATCH (barre de progression -- "on vas mettre la barre de
        # progresison de telechargement aussi dans l'interface de
        # instance", demande explicite utilisateur) : id_executant ->
        # (nom_profil, pourcentage) pour LE téléchargement cloud ->
        # sAutoniax actuellement en cours sur cet exécutant, s'il y en a
        # un (absent sinon -- pas d'entrée "à 0%" par défaut). Un seul
        # téléchargement affiché par sAutoniax à la fois : si plusieurs
        # profils cochés sont envoyés au même sAutoniax d'un coup (cf.
        # onglet Profils Cloud), ils sont traités séquentiellement côté
        # sAutoniax (un seul appel telecharger_fichier à la fois, cf.
        # docstring _future_ack_telechargement) -- cette colonne reflète
        # donc toujours EXACTEMENT ce qui est réellement en train de se
        # télécharger, jamais un mélange de plusieurs profils empilés.
        self._telechargements_en_cours: dict[str, tuple] = {}

        # AJOUT (SPEC_lot_corrections_2026-09.md section 13) : id_executant
        # -> coché (bool), source de vérité pour la case à cocher de chaque
        # ligne -- COCHÉ PAR DÉFAUT (cf. décision : "toutes cochées par
        # défaut au démarrage"). Persistant à travers les reconstructions
        # de table (cf. sur_executants_detail_change, qui fait clear() +
        # recrée les items à chaque diffusion serveur) : un id absent de ce
        # dict au moment de (re)créer sa ligne est traité comme "pas encore
        # vu" -> coché par défaut (cf. .get(id_executant, True) plus bas),
        # jamais redemandé à l'utilisateur. Un id qui disparaît de la table
        # (sAutoniax déconnecté puis reconnecté plus tard) garde sa
        # dernière valeur connue si son entrée est encore dans ce dict --
        # jamais purgé explicitement (même philosophie que self._executants_
        # silencieux : rien ne force à l'oublier). Lu par les boutons
        # globaux (cf. _ids_executants_coches) pour savoir sur quels
        # sAutoniax agir "en silence".
        self._sautoniax_coches: dict[str, bool] = {}

        # PATCH (refonte deux colonnes, demande explicite utilisateur :
        # "je veux que tu reorgnise de facon tres coherente,
        # professionels") -- QSplitter horizontal : colonne de GAUCHE
        # (tout ce qui existait déjà : statut, table des sAutoniax,
        # légende -- RIEN retiré, cf. docstring de classe) et colonne de
        # DROITE (nouveau PanneauProprietesSautoniax -- profils du
        # sAutoniax sélectionné, actions dessus, aperçu réseau). Le
        # panneau contextuel (clic droit) et la colonne "Actions"
        # existants restent l'accès RAPIDE aux actions globales
        # (Kill/Redémarrer/Maj API/Logs) -- le panneau de droite est
        # l'accès DÉTAILLÉ, par profil, qui n'existait pas avant ce patch.
        layout_racine = QVBoxLayout(self)
        layout_racine.setContentsMargins(0, 0, 0, 0)
        layout_racine.setSpacing(0)

        splitter = QSplitter(Qt.Horizontal, self)
        splitter.setObjectName("InstancesSplitter")
        splitter.setChildrenCollapsible(False)
        layout_racine.addWidget(splitter)

        colonne_gauche = QWidget(splitter)
        layout = QVBoxLayout(colonne_gauche)
        layout.setContentsMargins(24, 20, 12, 20)
        layout.setSpacing(8)
        layout.setAlignment(Qt.AlignTop)

        self.label_statut = QLabel("Connexion au serveurT...", self)
        self.label_statut.setObjectName("InstancesStatutLabel")
        layout.addWidget(self.label_statut)

        self.table_executants = _ArbreSelectionPersistante(self)
        self.table_executants.setObjectName("InstancesTable")
        self.table_executants.setRootIsDecorated(False)
        # PATCH C -- la hauteur de ligne n'est plus uniforme car chaque
        # ligne embarque désormais un petit widget de boutons (colonne
        # Actions, cf. _construire_widget_actions_ligne) dont la hauteur
        # native dépasse légèrement celle d'une ligne de texte seule ;
        # setUniformRowHeights(True) figerait toutes les lignes à la
        # hauteur d'une ligne texte-seul et rognerait les boutons.
        self.table_executants.setUniformRowHeights(False)
        self.table_executants.setSortingEnabled(True)
        self.table_executants.setSelectionMode(QAbstractItemView.ExtendedSelection)
        self.table_executants.setSelectionBehavior(QAbstractItemView.SelectRows)
        # PATCH C (cf. cahier des charges patchs.md, section C) --
        # colonne "Connecté depuis" ajoutée (uptime, cf. _formater_duree_
        # depuis_iso) et colonne "Actions" pour les boutons Stop/Logs par
        # ligne, en plus du menu contextuel existant (conservé tel quel,
        # rien à casser -- cf. docstring de classe).
        self.table_executants.setHeaderLabels(
            ["sAutoniax", "instance_id", "Statut", "Connecté depuis", "Téléchargement", "Actions"]
        )
        self.table_executants.header().setStretchLastSection(False)
        self.table_executants.header().setSectionResizeMode(2, QHeaderView.Stretch)
        self.table_executants.setContextMenuPolicy(Qt.CustomContextMenu)
        self.table_executants.customContextMenuRequested.connect(self._afficher_menu_executants)
        # PATCH (refonte deux colonnes) -- change la sélection de la
        # ligne courante (SingleSelection au sens "cible du panneau" --
        # une sélection multiple reste possible pour les actions en
        # masse du menu contextuel, cf. docstring de classe, mais SEULE
        # la DERNIÈRE ligne cliquée pilote le panneau de droite, cf.
        # _sur_selection_changee : currentItem(), pas selectedItems()).
        self.table_executants.itemSelectionChanged.connect(self._sur_selection_changee)
        # AJOUT (SPEC_lot_corrections_2026-09.md section 13) : capture les
        # clics sur la case à cocher de colonne 0 -- même patron EXACT que
        # PanneauExecutionClone/PanneauProprietesSautoniax (itemChanged +
        # filtre colonne==0 dans le handler, cf. _sur_item_changed_
        # executant). Ce connect coexiste avec itemSelectionChanged
        # ci-dessus (deux signaux Qt distincts sur la même vue, aucun
        # conflit -- un clic sur la case ne modifie jamais la SÉLECTION de
        # ligne, et un clic de sélection ne déclenche jamais itemChanged).
        self.table_executants.itemChanged.connect(self._sur_item_changed_executant)
        # PATCH (demande explicite utilisateur : "je veux juste que tu
        # classe bien les sAutniax en fonction du noms par ordre
        # croissant de noms, pas par ordre de connexion") -- tri par
        # défaut désormais sur la colonne 0 ("sAutoniax"), NUMÉRIQUE (cf.
        # _ItemExecutantTriable.__lt__ / _cle_tri_numerique_generique) :
        # sAutoniax-1, sAutoniax-2, ..., sAutoniax-10, plutôt que l'ancien
        # tri par défaut sur "Connecté depuis" (colonne 3, toujours
        # disponible en cliquant sur son en-tête si besoin -- cf.
        # docstring de _ItemExecutantTriable, comportement Qt standard
        # inchangé pour le choix manuel d'une autre colonne de tri).
        self.table_executants.sortByColumn(0, Qt.AscendingOrder)
        layout.addWidget(self.table_executants, stretch=1)

        self.label_legende = QLabel("instance(s) AutoniaX connectée(s) -- clic droit ou boutons pour les actions", self)
        self.label_legende.setObjectName("InstancesLegendeLabel")
        layout.addWidget(self.label_legende)

        # AJOUT (SPEC_lot_corrections_2026-09.md section 13) -- barre de
        # boutons globaux, EN BAS du layout de la liste des sAutoniax (cf.
        # décision : "en bas du layout de la liste des sAutoniax"),
        # reproduisant terme à terme les contrôles individuels de
        # PanneauProprietesSautoniax (cf. décision 1) mais appliqués à
        # TOUS LES PROFILS DE TOUS LES SAUTONIAX COCHÉS (cf. _ids_
        # executants_coches ci-dessus) via OrchestrateurActionsGlobales
        # Instances -- cette classe headless ignore tout de l'UI qui
        # l'affiche (cf. son docstring), donc c'est ICI que son signal
        # `progression` est branché sur un label de statut dédié, et ICI
        # que chaque bouton résout la liste des ids cochés/prêts au
        # moment du clic (jamais mise en cache -- un sAutoniax peut être
        # coché/décoché ou devenir prêt entre deux clics).
        self.orchestrateur_actions_globales = OrchestrateurActionsGlobalesInstances(self)
        self.orchestrateur_actions_globales.progression.connect(self._sur_progression_actions_globales)

        self._bloc_actions_globales = self._construire_bloc_actions_globales()
        layout.addWidget(self._bloc_actions_globales)

        splitter.addWidget(colonne_gauche)

        # PATCH (refonte deux colonnes) -- panneau de droite, cf.
        # docstring de PanneauProprietesSautoniax. Poids initial 3:2 en
        # faveur de la table (colonne gauche plus dense en information),
        # ajustable librement par l'utilisateur ensuite (setStretchFactor
        # ne fixe qu'une proportion INITIALE, cf. doc Qt).
        self.panneau_proprietes = PanneauProprietesSautoniax(splitter)
        splitter.addWidget(self.panneau_proprietes)
        splitter.setStretchFactor(0, 3)
        splitter.setStretchFactor(1, 2)

        # PATCH C -- rafraîchit uniquement le texte de la colonne
        # "Connecté depuis" toutes les 30s (même esprit que le
        # rafraîchissement périodique de _formater_duree_activite dans
        # ProfilsInstancesScreen), sans reconstruire toute la table ni
        # retoucher au tri/sélection -- seul le libellé affiché doit
        # avancer avec le temps, connecte_le lui ne change pas.
        self._minuteur_rafraichissement_duree = QTimer(self)
        self._minuteur_rafraichissement_duree.setInterval(30_000)
        self._minuteur_rafraichissement_duree.timeout.connect(self._rafraichir_colonne_duree)
        self._minuteur_rafraichissement_duree.start()

    def _sur_selection_changee(self):
        """PATCH (refonte deux colonnes) -- pilote PanneauProprietesSautoniax
        avec la sélection courante. Basé sur selectedItems() plutôt que
        currentItem() : après un rafraîchissement de la table (cf.
        sur_executants_detail_change, qui fait clear() puis restaure la
        sélection via setSelected(True) sur les nouveaux items), Qt ne
        garantit PAS que currentItem() pointe vers un item resélectionné
        de cette façon -- seul selectedItems() reflète fidèlement l'état
        réel de sélection dans ce cas. En sélection multiple (action en
        masse via le menu contextuel), le panneau de droite reflète le
        PREMIER sAutoniax de la sélection -- un seul panneau, jamais un
        état ambigu "plusieurs sAutoniax à la fois"."""
        items = self.table_executants.selectedItems()
        if not items:
            self.panneau_proprietes.definir_sautoniax_selectionne(None)
            return
        id_executant = items[0].data(0, Qt.UserRole)
        nom = self._executants.get(id_executant, {}).get("nom", id_executant)
        # CORRECTIF (ligne grisée indéfiniment / bouton "Générer" figé
        # toujours actif par contournement -- cf. docstring de
        # definir_sautoniax_selectionne côté PanneauProprietesSautoniax
        # pour l'historique complet du compromis) -- une ligne grisée
        # n'étant PAS sélectionnable (Qt.ItemIsSelectable retiré, cf.
        # sur_executants_detail_change), tout id_executant qui arrive
        # jusqu'ici est garanti déjà présent dans self._sautoniax_prets :
        # transmis tel quel au panneau de droite, qui peut donc à nouveau
        # se fier à une info fraîche plutôt qu'à son propre
        # _sautoniax_prets (alimenté par le seul signal live, susceptible
        # de retard pour un pilote connecté après coup).
        self.panneau_proprietes.definir_sautoniax_selectionne(id_executant, nom, sautoniax_pret=True)

    def actualiser_selection_courante(self):
        """PATCH (demande explicite utilisateur : "lorsque je clic sur
        longlet de sautonix dans la sidebar reseau sa doit automaquement
        tout actuelaiser ... je suis parfois obliger de clicquer sur la
        ligne de lautoniax pour que les statut sur proofils se
        actuelaise") -- appelé par ReseauScreen à chaque fois que cet
        onglet ("Instances sAutoniax") REDEVIENT l'onglet actif (cf.
        ReseauScreen.__init__, onglets.currentChanged). Cause du bug :
        PanneauProprietesSautoniax.definir_sautoniax_selectionne (seul
        endroit qui émet demande_rafraichir_profils, cf. sa docstring)
        ignore silencieusement tout appel où id_executant ==
        self._id_executant_courant déjà en place -- un garde-fou
        pertinent pour éviter un aller-retour réseau inutile quand on
        clique deux fois de suite sur la MÊME ligne de la table, mais
        qui bloque aussi tout rafraîchissement automatique en quittant
        puis revenant sur cet onglet SANS changer la sélection (le cas
        le plus courant) -- il fallait jusqu'ici cliquer ailleurs puis
        recliquer sur la ligne pour forcer artificiellement ce garde-fou
        à devenir faux. Solution : réinitialiser explicitement le cache
        du panneau (_id_executant_courant = None, cf. son __init__) AVANT
        de rappeler _sur_selection_changee ci-dessus -- reproduit alors
        EXACTEMENT le même chemin qu'une sélection fraîche, sans dupliquer
        sa logique (nom résolu depuis self._executants, cf. ci-dessus)."""
        self.panneau_proprietes._id_executant_courant = None
        self._sur_selection_changee()

    # --- Slots connectés aux signaux de ClientServeurT (cf. MainWindow) ---

    def sur_connecte(self):
        log_reseau_t.info("[UI] InstancesConnecteesScreen.sur_connecte() appelé")
        self.label_statut.setText("Connecté au serveurT")

    def sur_deconnecte(self):
        log_reseau_t.info("[UI] InstancesConnecteesScreen.sur_deconnecte() appelé")
        self.label_statut.setText("Hors ligne -- nouvelle tentative dans quelques secondes...")

    def sur_nombre_executants_change(self, nombre: int):
        """Toujours émis en même temps qu'executants_detail_change (cf.
        ClientServeurT._traiter_message, bloc executants_connectes) --
        gardé pour la légende, la table elle-même est peuplée par
        sur_executants_detail_change ci-dessous."""
        # AJOUT (retour utilisateur : bruit récurrent en .info(), appelé
        # à chaque changement ET à chaque tentative de reconnexion --
        # cf. le log jumeau "Connexion au serveurT impossible" ci-dessous
        # qui émet nombre_executants_change.emit(0) à chaque échec) --
        # passé en .debug(), visible seulement avec AUTONIAX_DEBUG=1
        # (cf. logging.basicConfig en tête de fichier).
        log_reseau_t.debug(f"[UI] InstancesConnecteesScreen.sur_nombre_executants_change({nombre}) appelé")
        self.label_legende.setText(f"{nombre} instance(s) AutoniaX connectée(s) -- clic droit pour les actions")

    def sur_sautoniax_pret(self, id_executant: str):
        """AJOUT (retour explicite utilisateur, cf. docstring complète
        de self._sautoniax_prets dans __init__) -- connecté par
        MainWindow à ClientServeurT.sautoniax_pret_recu, EN PLUS du
        câblage existant vers panneau_proprietes.sur_sautoniax_pret
        (les deux coexistent, chacun gère sa propre partie de l'écran).
        Marque cet id_executant comme réellement prêt (toutes ses
        dépendances chargées) puis reconstruit la table pour que la
        ligne concernée cesse immédiatement d'être grisée -- sans
        attendre le prochain executants_detail_change naturel (qui
        peut mettre un moment à arriver si rien d'autre ne change côté
        registre)."""
        if id_executant in self._sautoniax_prets:
            return
        self._sautoniax_prets.add(id_executant)
        # CORRECTIF (cf. bloc "CORRECTIF 2" dans sur_executants_detail_
        # change ci-dessous, qui retire désormais explicitement un id de
        # self._sautoniax_prets quand son entrée indique sautoniax_pret=
        # False) -- self._executants ci-dessous reste le DERNIER
        # snapshot reçu du serveur, qui peut très bien encore porter
        # sautoniax_pret=False pour CET id_executant à cet instant précis
        # (ce signal live et le prochain instances_list sont deux canaux
        # distincts, cf. docstring de classe) : sans cette ligne, le
        # rappel juste en dessous relirait ce False obsolète et
        # retirerait aussitôt l'id qu'on vient d'ajouter au-dessus,
        # annulant ce signal en un aller-retour. On met donc à jour ce
        # même snapshot local en mémoire pour qu'il reflète la même
        # vérité que self._sautoniax_prets avant de le relire.
        if id_executant in self._executants:
            self._executants[id_executant]["sautoniax_pret"] = True
        self.sur_executants_detail_change(list(self._executants.values()))

    def sur_executant_silencieux(self, id_executant: str, nom_executant: str, silence_secondes: float):
        """AJOUT (retour explicite utilisateur, capture annotée --
        annotation 3 : "je ne veux plus que on met inactifs, sa doit etre
        actifs si on est toujour connecter, inactifs si la connexion a
        été perdue ou ne repond plus") -- connecté par MainWindow à
        ClientServeurT.executant_silencieux_recu (jusqu'ici défini/émis
        mais jamais connecté nulle part, cf. sa docstring de classe :
        "purement informatif ici [...] sans qu'aucun écran n'y soit
        encore connecté à ce stade"). Marque cet id_executant comme
        silencieux (cf. self._executants_silencieux) puis reconstruit la
        table immédiatement, même patron EXACT que sur_sautoniax_pret
        juste au-dessus -- sans attendre le prochain executants_detail_
        change naturel pour que la ligne passe à "Inactif" sans délai.

        Résolu par déduction uniquement (cf. docstring de self.
        _executants_silencieux) -- aucun signal de "silence terminé"
        n'existe côté serveur, donc aucun sur_executant_reactive
        symétrique ici."""
        if id_executant in self._executants_silencieux:
            return
        self._executants_silencieux.add(id_executant)
        self.sur_executants_detail_change(list(self._executants.values()))

    def tous_ids_executants_connectes(self) -> list:
        """CORRECTIF (demande explicite utilisateur : le bouton "Mettre à
        jour le dossier service API" de Stockage > Mise à jour Système
        doit aussi pousser directement le dossier à TOUS les sAutoniax
        actuellement connectés, en plus d'envoyer la copie de référence
        sur le cloud). self._executants (rempli par sur_executants_
        detail_change ci-dessus) est déjà la source de vérité de la
        liste des sAutoniax connectés à l'instant présent -- exposée ici
        pour que MainWindow puisse la lire sans dupliquer cet état ni
        redemander quoi que ce soit au serveurT."""
        return list(self._executants.keys())

    def sur_executants_detail_change(self, executants: list):
        """Connecté par MainWindow à ClientServeurT.executants_detail_
        change -- reconstruit la table en entier (liste complète reçue à
        chaque changement, cf. docstring de classe), en conservant la
        sélection courante par id_executant si elle existe encore.

        AJOUT (retour explicite utilisateur, cf. docstring de self.
        _sautoniax_prets dans __init__) -- un exécutant qui vient tout
        juste de "register" (donc déjà présent dans `executants`, cf.
        serveur.py registre.ajouter()) mais dont "sautoniax_pret" n'a
        PAS encore été reçu (self._sautoniax_prets) est affiché GRISÉ,
        avec un statut "Chargement..." forcé (peu importe ce que
        Connexion.statut vaut réellement à cet instant -- ça n'a aucun
        sens tant que ses dépendances de base ne sont pas confirmées
        chargées), NON sélectionnable (Qt.ItemIsSelectable retiré) et
        ses boutons Stop/Logs désactivés -- pas de détails consultables
        sur un sAutoniax pas encore réellement opérationnel. Redevient
        une ligne normale (statut réel, sélectionnable, actions
        actives) dès que sur_sautoniax_pret l'ajoute à self.
        _sautoniax_prets -- et peut à nouveau devenir grisée si ce même
        exécutant redémarre et revient avec sautoniax_pret=False (cf.
        "CORRECTIF 2" plus bas dans cette méthode)."""
        ids_selectionnes_avant = {
            item.data(0, Qt.UserRole) for item in self.table_executants.selectedItems()
        }
        self._executants = {e.get("id", ""): e for e in executants if e.get("id")}

        # AJOUT (cf. docstring de self._executants_silencieux) -- un id
        # encore présent dans cette liste fraîche prouve qu'il communique
        # de nouveau avec le serveurT (sinon le registre l'aurait retiré
        # du tout) : son épisode de silence, s'il y en avait un, est donc
        # résolu. Seul moyen de "guérir" cet état, faute d'un signal
        # explicite de résolution côté serveur (cf. sa docstring :
        # "un seul par épisode de silence").
        self._executants_silencieux &= self._executants.keys()

        # CORRECTIF (retour utilisateur explicite : "sa ligne est resté
        # grisée et pourtant il avait déjà téléchargé ses dépendances" --
        # cf. Connexion.sautoniax_pret côté serveur.py) -- self.
        # _sautoniax_prets n'était alimenté QUE par le signal ponctuel
        # sautoniax_pret_recu (cf. sur_sautoniax_pret), émis UNE SEULE
        # FOIS par le serveur au moment exact où l'exécutant a fini de se
        # déclarer prêt. Un pilote connecté APRÈS ce moment (redémarrage
        # du serveurT en mémoire volatile, nouvelle fenêtre pilote,
        # reconnexion suite à une coupure...) ne recevait jamais ce
        # signal pour un exécutant pourtant déjà prêt de longue date, et
        # sa ligne restait grisée indéfiniment faute d'alternative. Le
        # serveur expose désormais ce même fait directement dans chaque
        # entrée de instances_list (champ "sautoniax_pret", persistant
        # côté Connexion) -- on le fusionne ici dans _sautoniax_prets à
        # CHAQUE reconstruction de la table, en plus du signal live
        # ci-dessus.
        #
        # CORRECTIF 2 (retour utilisateur explicite : "lorsque je lance
        # le redémarrage du sAutoniax depuis mAutoniax, sa ligne ne se
        # grise plus lors du téléchargement des dépendances") -- depuis
        # le patch d'identité stable par nom (cf. Registre côté
        # serveur.py, docstring de classe : "id" public = connexion.nom,
        # stable d'un lancement à l'autre, PLUS id_connexion qui changeait
        # à chaque reconnexion), un sAutoniax redémarré revient avec
        # EXACTEMENT le même id_executant qu'avant redémarrage -- déjà
        # présent dans self._sautoniax_prets depuis son lancement
        # précédent. La règle "jamais en retrait" ci-dessus (correcte
        # pour son cas d'origine : ne pas perdre un signal live raté)
        # ignorait alors silencieusement le cas où le serveur redescend
        # EXPLICITEMENT sautoniax_pret=False pour ce même nom (nouvelle
        # Connexion fraîchement enregistrée après le redémarrage, cf.
        # Connexion.__init__ côté serveur.py : sautoniax_pret=False par
        # défaut) -- rien ne retirait alors jamais l'id, donc la ligne
        # restait à tort affichée comme prête pendant tout le
        # rechargement des dépendances. On retire donc explicitement
        # l'id dès que le serveur confirme False pour lui, en plus de
        # l'ajout existant quand il confirme True -- un id remonté par
        # sur_sautoniax_pret (signal live) juste avant cette reconstruction
        # de table n'est pas perdu pour autant : le champ "sautoniax_pret"
        # de l'entrée fraîchement reçue reflète alors déjà True lui aussi
        # (même Connexion serveur, cf. vers_dict), donc jamais retiré au
        # tour suivant de cette même boucle.
        for id_executant, infos in self._executants.items():
            if infos.get("role") != "executant":
                continue
            if infos.get("sautoniax_pret"):
                self._sautoniax_prets.add(id_executant)
            else:
                self._sautoniax_prets.discard(id_executant)

        self.table_executants.setSortingEnabled(False)
        self.table_executants.clear()
        for id_executant, infos in sorted(self._executants.items(), key=lambda kv: _cle_tri_numerique_generique(kv[1].get("nom", ""))):
            connecte_le = infos.get("connecte_le", "")
            en_chargement = infos.get("role") == "executant" and id_executant not in self._sautoniax_prets
            item = _ItemExecutantTriable()
            # AJOUT (SPEC_lot_corrections_2026-09.md section 13) : case à
            # cocher posée AVANT addTopLevelItem (même patron EXACT que
            # PanneauExecutionClone/PanneauProprietesSautoniax, cf. leurs
            # docstrings -- évite tout itemChanged prématuré pendant la
            # reconstruction, l'état coché est lu ici depuis self.
            # _sautoniax_coches, jamais modifié par cette boucle).
            # .get(id_executant, True) : coché par défaut pour tout id
            # jamais vu jusqu'ici (cf. décision "toutes cochées par défaut
            # au démarrage" et docstring de self._sautoniax_coches).
            item.setFlags(item.flags() | Qt.ItemIsUserCheckable)
            item.setCheckState(
                0, Qt.Checked if self._sautoniax_coches.get(id_executant, True) else Qt.Unchecked
            )
            item.setText(0, infos.get("nom") or id_executant)
            item.setText(1, id_executant)
            item.setText(
                2,
                "Chargement des dépendances..." if en_chargement
                else self._libelle_statut_connectivite(id_executant, infos.get("statut", "")),
            )
            # PATCH C -- colonne 3 : texte affiché = durée relative
            # formatée (recalculée par _rafraichir_colonne_duree),
            # Qt.UserRole = horodatage ISO brut pour le tri (cf.
            # _ItemExecutantTriable.__lt__).
            item.setText(3, _formater_duree_depuis_iso(connecte_le))
            item.setData(3, Qt.UserRole, connecte_le)
            item.setData(0, Qt.UserRole, id_executant)
            if en_chargement:
                # Grisé (même teinte que les placeholders/labels
                # secondaires du thème, cf. Mocha.overlay1 déjà utilisé
                # ailleurs dans ce fichier pour du texte atténué) sur
                # toutes les colonnes texte, et NON sélectionnable --
                # un clic dessus ne doit jamais pouvoir ouvrir le
                # panneau de droite (cf. _sur_selection_changee, qui ne
                # reçoit alors simplement jamais cette ligne comme
                # item sélectionné).
                item.setFlags(item.flags() & ~Qt.ItemIsSelectable)
                for colonne in range(4):
                    item.setForeground(colonne, QColor(Mocha.overlay1))
                item.setToolTip(0, "Ce sAutoniax termine son chargement (dépendances de base en cours de téléchargement) -- pas encore utilisable.")
            elif id_executant in ids_selectionnes_avant:
                item.setSelected(True)
            self.table_executants.addTopLevelItem(item)
            self.table_executants.setItemWidget(
                item, 4, self._construire_widget_telechargement_ligne(id_executant)
            )
            self.table_executants.setItemWidget(
                item, 5, self._construire_widget_actions_ligne(id_executant, infos, en_chargement)
            )
        self.table_executants.setSortingEnabled(True)
        for i in range(4):
            self.table_executants.resizeColumnToContents(i)

    def _sur_item_changed_executant(self, item: QTreeWidgetItem, colonne: int):
        """AJOUT (SPEC_lot_corrections_2026-09.md section 13) -- même
        patron EXACT que PanneauExecutionClone._sur_item_changed /
        PanneauProprietesSautoniax._sur_item_changed_profil : déclenché
        par le clic sur la case de colonne 0, filtré ici pour ignorer
        tout itemChanged qui ne concernerait pas la case (aucun autre
        setText ne se produit sur cette table en dehors de sur_
        executants_detail_change, mais ce garde-fou reste peu coûteux)."""
        if colonne != 0:
            return
        id_executant = item.data(0, Qt.UserRole)
        if not id_executant:
            return
        self._sautoniax_coches[id_executant] = item.checkState(0) == Qt.Checked

    def _ids_executants_coches(self) -> list:
        """AJOUT (SPEC_lot_corrections_2026-09.md section 13) -- liste des
        id_executant actuellement COCHÉS et PRÊTS (cf. self._sautoniax_
        prets -- un sAutoniax encore en chargement de ses dépendances de
        base n'a par construction aucune action valide, cf. docstring de
        _construire_widget_actions_ligne : "aucune action [...] n'a de
        sens à proposer dessus"), triée dans le même ordre numérique que
        la table affichée (cf. _cle_tri_numerique_generique) -- consommée
        par tous les boutons globaux de la nouvelle barre (cf. _bloc_
        actions_globales) pour savoir sur quels sAutoniax agir."""
        return [
            id_executant for id_executant, _infos in sorted(
                self._executants.items(),
                key=lambda kv: _cle_tri_numerique_generique(kv[1].get("nom", "")),
            )
            if self._sautoniax_coches.get(id_executant, True) and id_executant in self._sautoniax_prets
        ]

    def _construire_bloc_actions_globales(self) -> QWidget:
        """REFONTE VISUELLE (demande explicite utilisateur : "concernant
        les bouton global que lon a ajouter . cest presque identique
        visuelement , je veux pas sa . et sa pred trop despace , je veux
        quelque chose de plus minimaliste... je veux que tu ne copie pas
        exactement le meme deign, je veux que tu met un degin assez
        diferent, mais meme fontionaliter") -- construit la barre de
        boutons globaux, EN BAS du layout de la liste des sAutoniax,
        MÊMES 4 fonctionnalités qu'avant (sélection de profils, tout
        démarrer/arrêter, génération, suppression -- toutes appliquées
        aux sAutoniax cochés, cf. OrchestrateurActionsGlobalesInstances)
        mais sous une forme délibérément DIFFÉRENTE de PanneauProprietes
        Sautoniax (contrôles individuels, à droite) plutôt qu'une
        répétition terme à terme de ses gros boutons pleine largeur :

        - UNE SEULE barre compacte (#ActionsGlobalesBarre), au lieu de 4
          lignes empilées -- gain d'espace vertical net.
        - Boutons ICÔNE SEULE avec tooltip (#ActionGlobaleBouton, cadre
          discret transparent au repos -- même esprit que
          #ProfilMenuButton) plutôt que des #CaptureButton/#DangerButton
          pleins et larges : au premier coup d'œil, cette barre ne se
          confond plus avec les contrôles individuels du panneau de
          droite alors même qu'elle en reprend l'ensemble des actions.
        - Groupes séparés par un simple filet vertical (#ActionGlobale
          Separateur) plutôt que par des lignes/labels intermédiaires.
        - Couleur d'icône reprise de #BatchLancerButton/#BatchArreterButton
          (sapphire démarrer / peach arrêter, déjà la convention de
          l'app pour une action de LOT) + mauve pour générer (cohérent
          avec #CaptureButton, action de création) + rouge pour
          supprimer (cohérent avec #DangerButton, action destructrice)
          -- seule la couleur d'ICÔNE distingue les groupes, le bouton
          lui-même reste discret et de taille identique pour tous.

        Un unique label de statut (self.label_statut_actions_globales),
        toujours alimenté par le signal `progression` de l'orchestrateur,
        posé sous la barre en petit texte discret plutôt qu'en pleine
        largeur -- n'occupe de la place que lorsqu'il y a effectivement
        un message à afficher (texte vide par défaut, cf. sa
        construction plus bas, inchangée)."""
        bloc = QWidget(self)
        layout_bloc = QVBoxLayout(bloc)
        layout_bloc.setContentsMargins(0, 6, 0, 0)
        layout_bloc.setSpacing(4)

        barre = QFrame(bloc)
        barre.setObjectName("ActionsGlobalesBarre")
        layout_barre = QHBoxLayout(barre)
        layout_barre.setContentsMargins(6, 4, 6, 4)
        layout_barre.setSpacing(4)

        def _separateur() -> QFrame:
            trait = QFrame(barre)
            trait.setObjectName("ActionGlobaleSeparateur")
            trait.setFrameShape(QFrame.VLine)
            return trait

        # -- Préfixe discret (remplace l'ancien gros titre "Actions
        # globales (sAutoniax cochés)" -- l'info reste disponible via les
        # tooltips de chaque bouton, pas besoin d'un label pleine largeur
        # pour une barre aussi compacte).
        prefixe = QLabel("LOT", barre)
        prefixe.setObjectName("ActionsGlobalesTitre")
        prefixe.setToolTip("Actions appliquées aux sAutoniax cochés dans la liste ci-dessus.")
        layout_barre.addWidget(prefixe)
        layout_barre.addWidget(_separateur())

        # -- Groupe 1 : sélection de profils (menu Tout/Aucun/Actifs/
        # Inactifs) -- même orchestrateur, même 4 actions qu'avant.
        self.bouton_menu_selection_globale = QToolButton(barre)
        self.bouton_menu_selection_globale.setIcon(
            qta.icon("mdi6.checkbox-multiple-marked-outline", color=Mocha.subtext0)
        )
        self.bouton_menu_selection_globale.setToolTip(
            "Sélectionner des profils sur TOUS les sAutoniax cochés ci-dessus "
            "(tous, aucun, actifs, inactifs) -- actualise d'abord chaque "
            "sAutoniax coché avant d'appliquer le filtre."
        )
        self.bouton_menu_selection_globale.setObjectName("ActionGlobaleBouton")
        self.bouton_menu_selection_globale.setCursor(Qt.PointingHandCursor)
        self.bouton_menu_selection_globale.setPopupMode(QToolButton.InstantPopup)

        menu_selection_globale = QMenu(self.bouton_menu_selection_globale)
        action_tout = menu_selection_globale.addAction(
            qta.icon("mdi6.checkbox-multiple-marked-outline", color=Mocha.subtext0), "Tout sélectionner",
        )
        action_tout.triggered.connect(
            lambda: self.orchestrateur_actions_globales.lancer_tout_selectionner(self._ids_executants_coches())
        )
        action_aucun = menu_selection_globale.addAction(
            qta.icon("mdi6.checkbox-multiple-blank-outline", color=Mocha.subtext0), "Tout désélectionner",
        )
        action_aucun.triggered.connect(
            lambda: self.orchestrateur_actions_globales.lancer_tout_deselectionner(self._ids_executants_coches())
        )
        menu_selection_globale.addSeparator()
        action_actifs = menu_selection_globale.addAction(
            qta.icon("mdi6.circle-slice-8", color=Mocha.green), "Sélectionner les actifs",
        )
        action_actifs.triggered.connect(
            lambda: self.orchestrateur_actions_globales.lancer_selectionner_actifs(self._ids_executants_coches())
        )
        action_inactifs = menu_selection_globale.addAction(
            qta.icon("mdi6.circle-outline", color=Mocha.subtext0), "Sélectionner les inactifs",
        )
        action_inactifs.triggered.connect(
            lambda: self.orchestrateur_actions_globales.lancer_selectionner_inactifs(self._ids_executants_coches())
        )
        self.bouton_menu_selection_globale.setMenu(menu_selection_globale)
        layout_barre.addWidget(self.bouton_menu_selection_globale)
        layout_barre.addWidget(_separateur())

        # -- Groupe 2 : Tout démarrer / Tout arrêter (icône seule,
        # couleurs sapphire/peach -- même convention que #BatchLancer
        # Button/#BatchArreterButton pour une action de LOT).
        self.bouton_tout_demarrer_global = QToolButton(barre)
        self.bouton_tout_demarrer_global.setIcon(
            qta.icon("mdi6.play-box-multiple-outline", color=Mocha.sapphire)
        )
        self.bouton_tout_demarrer_global.setObjectName("ActionGlobaleBouton")
        self.bouton_tout_demarrer_global.setCursor(Qt.PointingHandCursor)
        self.bouton_tout_demarrer_global.setToolTip(
            "Tout démarrer -- lance les profils COCHÉS et inactifs sur "
            "chaque sAutoniax coché ci-dessus (cf. menu de sélection pour "
            "cocher des profils)."
        )
        self.bouton_tout_demarrer_global.clicked.connect(
            lambda: self.orchestrateur_actions_globales.lancer_tout_demarrer(self._ids_executants_coches())
        )
        layout_barre.addWidget(self.bouton_tout_demarrer_global)

        self.bouton_tout_arreter_global = QToolButton(barre)
        self.bouton_tout_arreter_global.setIcon(
            qta.icon("mdi6.stop-circle-outline", color=Mocha.peach)
        )
        self.bouton_tout_arreter_global.setObjectName("ActionGlobaleBouton")
        self.bouton_tout_arreter_global.setCursor(Qt.PointingHandCursor)
        self.bouton_tout_arreter_global.setToolTip(
            "Tout arrêter -- coupe (kill) les profils COCHÉS et actifs sur "
            "chaque sAutoniax coché ci-dessus (cf. menu de sélection pour "
            "cocher des profils)."
        )
        self.bouton_tout_arreter_global.clicked.connect(
            lambda: self.orchestrateur_actions_globales.lancer_tout_arreter(self._ids_executants_coches())
        )
        layout_barre.addWidget(self.bouton_tout_arreter_global)
        layout_barre.addWidget(_separateur())

        # -- Groupe 2bis : filtre de génération (CORRECTIF -- retour
        # utilisateur : "il a oublie de mettre le filtre global",
        # SPEC_lot_corrections_2026-09.md section 13 : "Un bouton de
        # filtre global + le widget de génération de profils global").
        # MÊME mécanique EXACTE que PanneauProprietesSautoniax.bouton_
        # coller_contraintes/point_statut_contraintes (bouton "Coller"
        # qui lit le presse-papier + point d'état coloré, JSON jamais
        # affiché à l'écran, cf. leurs docstrings) -- posée ici juste
        # avant le groupe génération (même ordre que dans le panneau
        # individuel : filtre d'abord, quantité+génération ensuite),
        # mais avec l'icône-seule #ActionGlobaleBouton de cette barre
        # plutôt que #ProfilMenuButton, pour rester cohérente avec le
        # reste du groupe. La validation elle-même est déléguée à
        # l'orchestrateur (sur_clic_coller_contraintes_globales, cf. son
        # docstring) -- cette classe ne fait qu'appliquer le (texte,
        # couleur_nom) retourné à son propre point d'état/tooltip.
        self.bouton_coller_contraintes_globale = QToolButton(barre)
        self.bouton_coller_contraintes_globale.setIcon(
            qta.icon("mdi6.content-paste", color=Mocha.subtext0)
        )
        self.bouton_coller_contraintes_globale.setObjectName("ActionGlobaleBouton")
        self.bouton_coller_contraintes_globale.setCursor(Qt.PointingHandCursor)
        self.bouton_coller_contraintes_globale.setToolTip(
            "Coller les contraintes -- aucun filtre de génération actif.\n"
            "Colle un JSON de contraintes depuis le presse-papier "
            "(ex. {\"Résolution d'écran\": [\"height>700\", \"width>600\"]}), "
            "appliqué à CHAQUE sAutoniax coché ci-dessus -- un presse-papier "
            "vide efface le filtre actif."
        )
        self.bouton_coller_contraintes_globale.clicked.connect(
            self._sur_clic_coller_contraintes_globale
        )
        layout_barre.addWidget(self.bouton_coller_contraintes_globale)

        self.point_statut_contraintes_globale = QLabel("●", barre)
        self.point_statut_contraintes_globale.setStyleSheet(f"color: {Mocha.surface2}; font-size: 10px;")
        self.point_statut_contraintes_globale.setToolTip("Aucun filtre de génération actif.")
        layout_barre.addWidget(self.point_statut_contraintes_globale)
        layout_barre.addWidget(_separateur())

        # -- Groupe 3 : génération (combo type + spinbox N compact +
        # bouton icône seule, mauve -- cohérent avec #CaptureButton,
        # action de création) -- N profils PAR sAutoniax coché.
        #
        # PATCH (demande explicite utilisateur : "on doit pouvoir choisir
        # entre generer des profils chrome ou camoufox, dans le panneau
        # de profils des sautoniax") -- même sélecteur EXACT que
        # PanneauProprietesSautoniax.combo_type_generation (génération
        # individuelle) : userData porte le type_instance réel
        # ("chrome"/"camoufox"), lu au clic sur "Générer" plutôt que
        # mis en cache, jamais camoufox figé en dur comme avant ce patch.
        self.combo_type_generation_globale = QComboBox(barre)
        self.combo_type_generation_globale.addItem("Camoufox", "camoufox")
        self.combo_type_generation_globale.addItem("Chrome", "chrome")
        self.combo_type_generation_globale.addItem("CloakBrowser", "cloakbrowser")
        self.combo_type_generation_globale.setCursor(Qt.PointingHandCursor)
        self.combo_type_generation_globale.setToolTip(
            "Type de profil créé par « Générer » ci-contre -- Camoufox ou Chrome."
        )
        self.combo_type_generation_globale.currentIndexChanged.connect(
            self._sur_changement_type_generation_globale
        )
        layout_barre.addWidget(self.combo_type_generation_globale)

        self.spin_nombre_generation_globale = QSpinBox(barre)
        self.spin_nombre_generation_globale.setMinimum(1)
        self.spin_nombre_generation_globale.setMaximum(200)
        self.spin_nombre_generation_globale.setValue(5)
        self.spin_nombre_generation_globale.setCursor(Qt.PointingHandCursor)
        self.spin_nombre_generation_globale.setFixedWidth(48)
        self.spin_nombre_generation_globale.setObjectName("ActionGlobaleSpin")
        self.spin_nombre_generation_globale.setToolTip(
            "Nombre de profils à créer PAR sAutoniax coché."
        )
        layout_barre.addWidget(self.spin_nombre_generation_globale)

        self.bouton_generer_profils_global = QToolButton(barre)
        self.bouton_generer_profils_global.setIcon(qta.icon("mdi6.auto-fix", color=Mocha.mauve))
        self.bouton_generer_profils_global.setObjectName("ActionGlobaleBouton")
        self.bouton_generer_profils_global.setCursor(Qt.PointingHandCursor)
        self.bouton_generer_profils_global.clicked.connect(self._on_clic_generer_profils_masse_globale)
        layout_barre.addWidget(self.bouton_generer_profils_global)
        layout_barre.addWidget(_separateur())
        # Tooltip initial cohérent avec le premier item du combo
        # ci-dessus ("Camoufox") -- tenu à jour ensuite par
        # _sur_changement_type_generation_globale à chaque changement.
        self._rafraichir_tooltip_bouton_generer_globale()

        # -- Groupe 4 : suppression globale (icône seule, rouge --
        # cohérent avec #DangerButton, action destructrice), profils
        # cochés uniquement, inchangé.
        self.bouton_supprimer_profils_global = QToolButton(barre)
        self.bouton_supprimer_profils_global.setIcon(qta.icon("mdi6.trash-can-outline", color=Mocha.red))
        self.bouton_supprimer_profils_global.setObjectName("ActionGlobaleBouton")
        self.bouton_supprimer_profils_global.setCursor(Qt.PointingHandCursor)
        self.bouton_supprimer_profils_global.setToolTip(
            "Supprimer les profils cochés -- sur chaque sAutoniax coché "
            "ci-dessus (cf. menu de sélection pour cocher des profils) -- "
            "un profil actif est ignoré, arrêtez-le d'abord."
        )
        self.bouton_supprimer_profils_global.clicked.connect(
            lambda: self.orchestrateur_actions_globales.lancer_suppression(self._ids_executants_coches())
        )
        layout_barre.addWidget(self.bouton_supprimer_profils_global)
        layout_barre.addStretch(1)

        layout_bloc.addWidget(barre)

        self.label_statut_actions_globales = QLabel("", bloc)
        self.label_statut_actions_globales.setObjectName("InstancesStatutActionsGlobalesLabel")
        self.label_statut_actions_globales.setWordWrap(True)
        layout_bloc.addWidget(self.label_statut_actions_globales)

        return bloc

    def _rafraichir_tooltip_bouton_generer_globale(self):
        """Tooltip du bouton Générer global, dépendant du type
        actuellement choisi dans self.combo_type_generation_globale --
        rappelée à la construction ET à chaque changement de ce combo
        (cf. _sur_changement_type_generation_globale). Même patron EXACT
        que PanneauProprietesSautoniax._rafraichir_tooltip_bouton_generer."""
        libelle = self.combo_type_generation_globale.currentText() or "Camoufox"
        self.bouton_generer_profils_global.setToolTip(
            f"Générer -- crée N profils {libelle} (sans proxy) sur CHAQUE "
            "sAutoniax coché ci-dessus (N réglé par le champ à gauche) -- "
            "ex. N=5 et 3 sAutoniax cochés = 15 profils créés au total "
            "(5 sur chacun)."
        )

    def _sur_changement_type_generation_globale(self, _index: int):
        self._rafraichir_tooltip_bouton_generer_globale()

    def _on_clic_generer_profils_masse_globale(self):
        """Sépare la lecture du spinbox/combo du simple passe-plat des
        autres boutons ci-dessus (lambda directe) -- lancer_generation
        attend le nombre et le type en second/troisième paramètres
        positionnels, lus ici au moment du clic (jamais mis en cache, cf.
        docstring de _construire_bloc_actions_globales). PATCH (demande
        explicite utilisateur : choix Chrome/Camoufox) -- type_instance
        n'est plus figé en dur sur "camoufox" côté orchestrateur, il est
        désormais transmis explicitement depuis ce combo."""
        self.orchestrateur_actions_globales.lancer_generation(
            self._ids_executants_coches(), self.spin_nombre_generation_globale.value(),
            self.combo_type_generation_globale.currentData() or "camoufox",
        )

    def _sur_clic_coller_contraintes_globale(self):
        """CORRECTIF (retour utilisateur : "il a oublie de mettre le
        filtre global") -- délègue toute la logique de lecture/validation
        du presse-papier à l'orchestrateur (sur_clic_coller_contraintes_
        globales, cf. son docstring -- cette classe n'a pas accès direct
        à parser_contraintes_generation_profil ni au clipboard, le
        widget garde la responsabilité de l'affichage uniquement), puis
        applique (texte, couleur_nom) reçu au point d'état + tooltip du
        bouton -- MÊME patron EXACT que PanneauProprietesSautoniax.
        _definir_statut_contraintes."""
        texte, couleur_nom = self.orchestrateur_actions_globales.sur_clic_coller_contraintes_globales()
        couleur = {"gris": Mocha.surface2, "vert": Mocha.green, "rouge": Mocha.red}[couleur_nom]
        self.point_statut_contraintes_globale.setStyleSheet(f"color: {couleur}; font-size: 10px;")
        self.point_statut_contraintes_globale.setToolTip(texte)
        self.bouton_coller_contraintes_globale.setToolTip(
            f"Coller les contraintes -- {texte}\n"
            "Colle un JSON de contraintes depuis le presse-papier "
            "(ex. {\"Résolution d'écran\": [\"height>700\", \"width>600\"]}), "
            "appliqué à CHAQUE sAutoniax coché ci-dessus -- un presse-papier "
            "vide efface le filtre actif."
        )

    def _sur_progression_actions_globales(self, ok: bool, message: str):
        """Connecté sur OrchestrateurActionsGlobalesInstances.progression
        (cf. son docstring de classe) -- affiche le message tel quel,
        coloré en rouge doux pour un échec/avertissement (même teinte que
        les tooltips d'erreur ailleurs dans ce fichier), texte normal
        sinon. Ne fait QUE de l'affichage -- l'orchestrateur a déjà
        entièrement traité l'action au moment où ce signal arrive."""
        self.label_statut_actions_globales.setText(message)
        if ok:
            self.label_statut_actions_globales.setStyleSheet(f"color: {Mocha.subtext0};")
        else:
            self.label_statut_actions_globales.setStyleSheet(f"color: {Mocha.red};")

    def _construire_widget_telechargement_ligne(self, id_executant: str) -> QWidget:
        """PATCH (barre de progression par sAutoniax, demande explicite
        utilisateur) -- même patron EXACT que _construire_widget_actions_
        ligne (petit widget posé via setItemWidget, reconstruit à chaque
        rafraîchissement de la table). Vide (juste un tiret) tant
        qu'aucun téléchargement n'est en cours pour CE sAutoniax --
        cf. self._telechargements_en_cours, alimenté par sur_progression_
        telechargement_profil ci-dessous."""
        conteneur = QWidget()
        ligne = QHBoxLayout(conteneur)
        ligne.setContentsMargins(4, 2, 4, 2)
        ligne.setSpacing(6)

        info = self._telechargements_en_cours.get(id_executant)
        if info is None:
            label_vide = QLabel("--", conteneur)
            label_vide.setObjectName("PlaceholderSubtitle")
            ligne.addWidget(label_vide)
            return conteneur

        nom_profil, pourcentage = info
        label_nom = QLabel(nom_profil, conteneur)
        label_nom.setObjectName("PlaceholderSubtitle")
        label_nom.setMaximumWidth(120)
        ligne.addWidget(label_nom)

        barre = QProgressBar(conteneur)
        barre.setObjectName("ProfilEnvoiProgress")
        barre.setFixedWidth(90)
        barre.setTextVisible(True)
        if pourcentage < 0:
            barre.setRange(0, 0)  # démarrage indéterminé, cf. convention -1
        else:
            barre.setRange(0, 100)
            barre.setValue(pourcentage)
        ligne.addWidget(barre)

        return conteneur

    def sur_progression_telechargement_profil(self, id_executant: str, nom_profil: str, pourcentage: int):
        """Connecté par MainWindow à ClientServeurT.telecharger_profil_
        vers_sautoniax_progression_recu (PATCH, barre de progression
        demande explicite utilisateur). Met à jour uniquement le widget
        de la ligne concernée (pas de reconstruction complète de la
        table, cf. _rafraichir_colonne_duree pour le même principe) --
        pourcentage=100 (ou réception du résultat final, cf. sur_
        resultat_telechargement_profil) retire l'entrée du registre."""
        self._telechargements_en_cours[id_executant] = (nom_profil, pourcentage)
        self._rafraichir_widget_telechargement(id_executant)

    def sur_resultat_telechargement_profil(self, id_executant: str, nom_profil: str, ok: bool, message: str):
        """Connecté par MainWindow à ClientServeurT.telecharger_profil_
        vers_sautoniax_resultat_recu -- le téléchargement pour ce
        sAutoniax est terminé (succès ou échec) : retire l'entrée de
        self._telechargements_en_cours, la colonne redevient "--"."""
        self._telechargements_en_cours.pop(id_executant, None)
        self._rafraichir_widget_telechargement(id_executant)
        if not ok:
            nom = self._executants.get(id_executant, {}).get("nom", id_executant)
            self.label_statut.setText(f"Échec du téléchargement de '{nom_profil}' vers '{nom}' : {message}")

    def _rafraichir_widget_telechargement(self, id_executant: str):
        """Reconstruit UNIQUEMENT le petit widget de la colonne
        Téléchargement pour la ligne de cet id_executant, sans toucher
        au reste de la table (tri/sélection/scroll intacts) -- même
        principe que _rafraichir_colonne_duree."""
        racine = self.table_executants.invisibleRootItem()
        for i in range(racine.childCount()):
            item = racine.child(i)
            if item.data(0, Qt.UserRole) == id_executant:
                self.table_executants.setItemWidget(
                    item, 4, self._construire_widget_telechargement_ligne(id_executant)
                )
                return

    def _construire_widget_actions_ligne(self, id_executant: str, infos: dict, en_chargement: bool = False) -> QWidget:
        """PATCH C -- petit widget (2 boutons icône) posé via
        setItemWidget sur la colonne "Actions" de CETTE ligne. Pattern
        standard QTreeWidget pour des actions par ligne sans casser le
        mécanisme de peinture de la table (cf. exploration du fichier
        avant écriture -- les autres usages de delegate peint dans ce
        fichier concernent des grilles différentes, non réutilisables
        ici). Un nouveau widget est reconstruit à chaque rafraîchissement
        de la table (même fréquence que les QTreeWidgetItem eux-mêmes,
        cf. sur_executants_detail_change qui fait table.clear() à chaque
        appel) -- pas de réutilisation d'instance entre deux réceptions.

        AJOUT `en_chargement` (retour explicite utilisateur, cf.
        docstring de self._sautoniax_prets dans __init__) -- tant que ce
        sAutoniax n'a pas envoyé "sautoniax_pret", aucune action (Stop/
        Logs) n'a de sens à proposer dessus : les deux boutons sont
        désactivés, quel que soit le statut brut reçu."""
        conteneur = QWidget()
        ligne = QHBoxLayout(conteneur)
        ligne.setContentsMargins(4, 2, 4, 2)
        ligne.setSpacing(4)

        deja_inactif = infos.get("statut", "") == "inactif"
        bouton_stop = QToolButton(conteneur)
        bouton_stop.setIcon(qta.icon("mdi6.stop-circle-outline", color=Mocha.red))
        bouton_stop.setToolTip(
            "Ce sAutoniax termine son chargement -- pas encore utilisable." if en_chargement
            # CORRECTIF (cf. _libelle_statut/_libelle_statut_connectivite
            # -- "inactif" affiché en colonne Statut est devenu "Actif")
            # -- message reformulé pour ne plus contredire la colonne
            # Statut de la même ligne : deja_inactif reste le même calcul
            # fonctionnel ("aucun projet en cours", donc rien à stopper),
            # seul le TEXTE change, pas la variable ni son usage plus bas.
            else "Aucun projet en cours sur ce sAutoniax -- rien à arrêter." if deja_inactif
            else "Stop -- arrête le projet en cours sur ce sAutoniax (kill)."
        )
        bouton_stop.setEnabled(not en_chargement and not deja_inactif)
        bouton_stop.setAutoRaise(True)
        bouton_stop.clicked.connect(lambda: self.demande_kill_projet.emit(id_executant))
        ligne.addWidget(bouton_stop)

        bouton_logs = QToolButton(conteneur)
        bouton_logs.setIcon(qta.icon("mdi6.text-box-search-outline", color=Mocha.subtext0))
        bouton_logs.setToolTip(
            "Ce sAutoniax termine son chargement -- pas encore utilisable." if en_chargement
            else "Logs -- consulter les logs de sortie de ce sAutoniax."
        )
        bouton_logs.setEnabled(not en_chargement)
        bouton_logs.setAutoRaise(True)
        bouton_logs.clicked.connect(lambda: self.demande_logs_sautoniax.emit(id_executant))
        ligne.addWidget(bouton_logs)

        ligne.addStretch(1)
        return conteneur

    def _rafraichir_colonne_duree(self):
        """PATCH C -- toutes les 30s (cf. self._minuteur_rafraichissement_
        duree dans __init__), remet à jour uniquement le TEXTE affiché de
        la colonne "Connecté depuis" pour chaque ligne existante, sans
        reconstruire la table (pas de clear(), sélection/tri/scroll
        intacts) -- connecte_le lui-même (Qt.UserRole) ne change pas,
        seul le texte relatif doit avancer avec le temps."""
        racine = self.table_executants.invisibleRootItem()
        for i in range(racine.childCount()):
            item = racine.child(i)
            connecte_le = item.data(3, Qt.UserRole) or ""
            item.setText(3, _formater_duree_depuis_iso(connecte_le))

    @staticmethod
    def _libelle_statut(statut: str) -> str:
        """Traduit la chaîne brute reçue (cf. Connexion.statut côté
        serveurT : "inactif" / "demarrage_profils" / "execution_projet:
        <nom>" / "erreur", non validée par le serveur, cf. principe
        "aucune logique métier" -- un sAutoniax pourrait en théorie
        envoyer autre chose) vers un libellé lisible pour la table.

        CORRECTIF (retour explicite utilisateur, capture annotée -- "je
        ne veux plus que on met inactifs, sa doit etre actifs si on est
        toujour connecter, inactifs si la connexion a été perdue ou ne
        repond plus") -- "inactif" ne veut PLUS dire "aucun projet en
        cours" à l'affichage (ça reste vrai pour deja_inactif/le bouton
        Stop, cf. _construire_widget_actions_ligne, volontairement
        inchangé) : un sAutoniax connecté sans tâche en cours est
        maintenant affiché "Actif" -- cf. _libelle_statut_connectivite
        ci-dessous, seul point d'entrée utilisé pour la colonne "Statut"
        de la table, qui appelle celle-ci uniquement pour les statuts
        d'ACTIVITÉ réelle (démarrage/exécution/erreur), jamais pour
        "inactif" tel quel."""
        if statut == "inactif":
            return "Actif"
        if statut == "demarrage_profils":
            return "Démarrage des profils"
        if statut.startswith("execution_projet:"):
            nom_projet = statut.split(":", 1)[1]
            return f"Exécution projet '{nom_projet}'"
        if statut == "erreur":
            return "En erreur"
        return statut or "Inconnu"

    def _libelle_statut_connectivite(self, id_executant: str, statut: str) -> str:
        """AJOUT (retour explicite utilisateur, capture annotée --
        annotation 3) -- point d'entrée réel de la colonne "Statut" de la
        table (cf. sur_executants_detail_change) : force "Inactif" si CET
        id_executant est actuellement dans self._executants_silencieux
        (watchdog serveurT, cf. sa docstring et sur_executant_silencieux
        ci-dessous), peu importe ce que `statut` vaut par ailleurs -- un
        sAutoniax qui ne répond plus reste dans le registre serveur (donc
        toujours présent dans `executants`, avec son dernier `statut`
        connu, potentiellement encore "execution_projet:..." si le
        silence a commencé EN PLEINE tâche) mais la connexion réelle est
        suspecte, donc affiché "Inactif" avant toute autre considération.
        Sinon, délègue à _libelle_statut (désormais "Actif" pour le cas
        "inactif" brut, cf. sa docstring)."""
        if id_executant in self._executants_silencieux:
            return "Inactif"
        return self._libelle_statut(statut)

    # --- Menu contextuel (Kill / Mettre à jour service API) ---

    def _afficher_menu_executants(self, position):
        item_sous_curseur = self.table_executants.itemAt(position)
        if item_sous_curseur is None:
            return
        # AJOUT (retour explicite utilisateur, cf. docstring de self.
        # _sautoniax_prets dans __init__) -- garde-fou explicite en plus
        # de Qt.ItemIsSelectable déjà retiré sur ces lignes (cf.
        # sur_executants_detail_change) : aucune action de menu sur un
        # sAutoniax pas encore réellement prêt, "pas de détails sur lui"
        # tant qu'il n'a pas fini de charger ses dépendances de base.
        id_sous_curseur = item_sous_curseur.data(0, Qt.UserRole)
        if (
            self._executants.get(id_sous_curseur, {}).get("role") == "executant"
            and id_sous_curseur not in self._sautoniax_prets
        ):
            return
        if item_sous_curseur not in self.table_executants.selectedItems():
            # Un clic droit hors de la sélection courante la remplace --
            # même comportement standard qu'un explorateur de fichiers,
            # plutôt que d'agir sur une sélection multiple obsolète.
            self.table_executants.setCurrentItem(item_sous_curseur)

        items_selectionnes = self.table_executants.selectedItems()
        if not items_selectionnes:
            return
        ids_selectionnes = [item.data(0, Qt.UserRole) for item in items_selectionnes]
        statuts_selectionnes = [
            self._executants.get(id_exec, {}).get("statut", "") for id_exec in ids_selectionnes
        ]

        menu = QMenu(self)

        if len(ids_selectionnes) == 1:
            id_executant = ids_selectionnes[0]
            deja_inactif = statuts_selectionnes[0] == "inactif"
            action_kill = menu.addAction(qta.icon("mdi6.stop-circle-outline", color=Mocha.red), "Kill")
            action_kill.setEnabled(not deja_inactif)
            if deja_inactif:
                # CORRECTIF (cf. _libelle_statut/_libelle_statut_
                # connectivite -- "inactif" affiché en colonne Statut est
                # devenu "Actif") -- même reformulation que le tooltip du
                # bouton Stop de _construire_widget_actions_ligne.
                action_kill.setToolTip("Aucun projet en cours sur ce sAutoniax -- rien à arrêter.")
            action_kill.triggered.connect(lambda: self.demande_kill_projet.emit(id_executant))

            action_redemarrer = menu.addAction(
                qta.icon("mdi6.restart", color=Mocha.yellow), "Redémarrer"
            )
            action_redemarrer.setToolTip(
                "Retélécharge AutoniaX.py depuis le serveurT et relance ce "
                "sAutoniax (nécessaire après une mise à jour du fichier)."
            )
            action_redemarrer.triggered.connect(lambda: self.demande_redemarrer_executant.emit(id_executant))
            menu.addSeparator()

        libelle_maj = (
            "Mettre à jour le dossier service API"
            if len(ids_selectionnes) == 1
            else f"Mettre à jour le dossier service API ({len(ids_selectionnes)} sAutoniax)"
        )
        action_maj_api = menu.addAction(qta.icon("mdi6.folder-sync-outline", color=Mocha.subtext0), libelle_maj)
        action_maj_api.triggered.connect(lambda: self.demande_maj_service_api.emit(list(ids_selectionnes)))

        menu.exec(self.table_executants.viewport().mapToGlobal(position))

    # Signaux émis vers MainWindow (résolution du chemin service API
    # local et appel réel à ClientServeurT laissés à MainWindow, même
    # séparation de responsabilités que le reste du fichier -- cet écran
    # ne connaît ni get_service_api_dir() ni ClientServeurT directement).
    demande_kill_projet = Signal(str)  # id_executant
    demande_redemarrer_executant = Signal(str)  # id_executant
    demande_maj_service_api = Signal(list)  # liste d'id_executant
    # PATCH C -- bouton "Logs" par ligne (colonne Actions). Cet écran ne
    # fait aucun appel réseau lui-même (même séparation de responsabilités
    # que les 3 signaux ci-dessus) : MainWindow ouvre le dialogue et gère
    # la connexion temporaire à ClientServeurT.logs_executant_recu, cf.
    # DialogueLogsSautoniax et _sur_demande_logs_sautoniax dans MainWindow.
    demande_logs_sautoniax = Signal(str)  # id_executant
    # PATCH A (cf. cahier des charges patchs.md) -- émis par les 3
    # handlers ci-dessous une fois le NOM déjà résolu (self._executants,
    # interne à cet écran) -- MainWindow s'y connecte pour relayer vers
    # la statusBar globale sans dupliquer la logique de résolution du
    # nom ni le wording exact déjà utilisé pour label_statut.
    resultat_action_confirme = Signal(bool, str)

    # PATCH (retour utilisateur explicite : "il y a ce message de
    # redemarage qui ne veux pas quitter, essai de bien enlever sa") --
    # label_statut de cet écran n'avait jusqu'ici AUCUN mécanisme
    # d'auto-effacement : setText() pose le texte et il reste affiché
    # indéfiniment tant qu'aucun autre message ne vient le remplacer
    # (contrairement à d'autres labels de confirmation du fichier, cf.
    # gabarit_confirmation_label, qui utilisent déjà QTimer.singleShot).
    # Les 3 méthodes ci-dessous (résultat ponctuel d'une action déjà
    # terminée : kill/redémarrage/maj service API) programment
    # maintenant un effacement différé -- _effacer_label_statut_si_
    # inchange vérifie que le label contient TOUJOURS ce texte précis
    # au moment où le timer se déclenche avant de le vider, pour ne
    # jamais écraser un message plus récent (ex. un autre résultat
    # d'action, ou "Hors ligne..."/"Connecté au serveurT" arrivé entre
    # temps) qui aurait déjà remplacé celui-ci.
    DUREE_AFFICHAGE_STATUT_MS = 4000

    def _effacer_label_statut_si_inchange(self, texte_attendu: str):
        if self.label_statut.text() == texte_attendu:
            self.label_statut.setText("")

    def sur_resultat_kill_projet(self, ok: bool, id_executant: str, message: str):
        nom = self._executants.get(id_executant, {}).get("nom", id_executant)
        if ok:
            texte = f"Kill transmis à '{nom}'."
            self.label_statut.setText(texte)
        else:
            texte = f"Échec du kill pour '{nom}' : {message}"
            self.label_statut.setText(texte)
        QTimer.singleShot(self.DUREE_AFFICHAGE_STATUT_MS, lambda: self._effacer_label_statut_si_inchange(texte))
        self.resultat_action_confirme.emit(ok, texte)

    def sur_resultat_redemarrer_executant(self, ok: bool, id_executant: str, message: str):
        nom = self._executants.get(id_executant, {}).get("nom", id_executant)
        if ok:
            texte = f"Redémarrage transmis à '{nom}' -- retéléchargement et relance en cours."
            self.label_statut.setText(texte)
        else:
            texte = f"Échec du redémarrage pour '{nom}' : {message}"
            self.label_statut.setText(texte)
        QTimer.singleShot(self.DUREE_AFFICHAGE_STATUT_MS, lambda: self._effacer_label_statut_si_inchange(texte))
        self.resultat_action_confirme.emit(ok, texte)

    def sur_resultat_maj_service_api(self, ok: bool, id_executant: str, message: str):
        nom = self._executants.get(id_executant, {}).get("nom", id_executant)
        if ok:
            texte = f"Dossier service API mis à jour sur '{nom}'."
            self.label_statut.setText(texte)
        else:
            texte = f"Échec de mise à jour du service API sur '{nom}' : {message}"
            self.label_statut.setText(texte)
        QTimer.singleShot(self.DUREE_AFFICHAGE_STATUT_MS, lambda: self._effacer_label_statut_si_inchange(texte))
        self.resultat_action_confirme.emit(ok, texte)


class ProjetsDistribuesScreen(QWidget):
    """Onglet "Projets Distribués" de ReseauScreen (Patch 4.4.b -- cœur
    du patch réseau). Deux zones :

    1. Table du haut (une ligne par envoi) : sAutoniax cible, nom du
       projet, statut global (PATCH E.3 -- "En attente" / "En exécution"
       / "Terminé", plus "Échec d'envoi" conservé comme 4e statut
       technique distinct, cf. _LIBELLES_STATUT_GLOBAL), colonne
       "Résultat" unique (PATCH E.3, remplace les 3 anciennes colonnes
       Traités/En échec/Restants -- cf. _texte_resultat : "—" tant
       qu'aucune exécution n'a eu lieu, compteur succès/échec mis à jour
       en continu pendant l'exécution, compteur final une fois terminé)
       -- alimentée par TROIS sources, toutes best-effort et indexées
       par session_id (cf. spec §4.4.b, "réutilise une session apparaît
       dès l'envoi") :
         - demande_envoi_projet_sautoniax (relayée par MainWindow depuis
           ProjetBatchScreen, Option A validée -- cf. sur_envoi_demande) :
           crée la ligne, statut "En attente".
         - ClientServeurT.envoi_projet_sautoniax_resultat : passe la
           ligne à "En exécution" (succès d'envoi -- le traitement
           démarre côté sAutoniax) ou "Échec d'envoi" (échec, cf.
           sur_resultat_envoi).
         - ClientServeurT.projet_distant_progression_recu : met à jour
           les compteurs + le détail par sous-projet au fil du
           traitement (cf. sur_progression_recue).
         - ClientServeurT.retour_projet_execute_recu : passe la ligne à
           "Terminé" (avec le compteur succès/échec final dans la
           colonne Résultat -- l'ancienne distinction "Terminé"/"Échec
           partiel" reste suivie en interne, cf. session["statut"], mais
           ne se reflète plus dans un libellé de statut séparé) et
           active le bouton "Récupérer en local" (§4.4.d point 4).

    2. Zone détail (cachée tant qu'aucune ligne n'est sélectionnée) :
       réutilisation de SousProjetCarte en lecture seule (cf.
       SousProjetCarte.creer_lecture_seule), une FlowGrid par session --
       alimentée par le statuts_sous_projets déjà accumulé pour la ligne
       sélectionnée (pas de requête réseau supplémentaire, la donnée est
       déjà là dès la première mise à jour de progression reçue)."""

    # Émis quand l'utilisateur clique "Récupérer en local" sur une ligne
    # terminée -- MainWindow réalise la fusion réelle dans le ProjetBatch
    # local correspondant (cet écran ne connaît que le chemin reçu, pas la
    # logique de fusion elle-même, même séparation de responsabilités que
    # le reste du fichier). Porte (session_id, id_projet_batch, chemin_dossier_recu).
    demande_recuperation_locale = Signal(str, str, str)
    # PATCH A (cf. cahier des charges patchs.md) -- émis UNIQUEMENT sur
    # le résultat de l'ENVOI initial (succès/échec de transmission au
    # sAutoniax, cf. sur_resultat_envoi ci-dessous) -- pas sur chaque
    # tick de progression ni sur "Terminé" : ces deux derniers restent
    # visibles en continu dans la table de cet écran (colonne Statut),
    # les répéter dans la statusBar globale à chaque mise à jour serait
    # du bruit. Le premier événement (envoi) est en revanche un
    # équivalent direct d'un clic bouton avec confirmation immédiate --
    # même trou que kill/redémarrer/maj service API avant ce patch.
    resultat_envoi_confirme = Signal(bool, str)

    # PATCH E.1 (cf. cahier des charges patchs.md, section E.1 + B.5) --
    # même séparation de responsabilités que TaskConfigScreen.demande_
    # ouvrir_rendu_reseau : ce widget ne connaît ni ApplicationsScreen ni
    # ClientServeurT directement, il demande. Porte (widget
    # FenetreRenduTaskReseau déjà construit, titre) -- MainWindow route
    # vers ApplicationsScreen.ouvrir_rendu_task_reseau, RÉUTILISANT la
    # même méthode générique que pour TaskConfigScreen (cf. sa docstring :
    # "accepte n'importe quel widget déjà construit").
    demande_ouvrir_rendu_reseau = Signal(object, str)
    # PATCH E.1 -- pilotage du sAutoniax DISTANT pour l'instance ciblée
    # par le panneau actuellement ouvert. Contrairement à TaskConfigScreen
    # (un seul sAutoniax ciblé via le profil actif du panneau clone,
    # résolu au moment de CHAQUE émission), ce widget peut avoir plusieurs lignes
    # -- la cible (id_executant, instance_id) est donc figée AU MOMENT DE
    # L'OUVERTURE du panneau (session["id_executant"] + l'instance_id
    # résolue via _profil_en_cours_pour_apercu, cf. _sur_clic_apercu_
    # execution) et mémorisée dans self._rendu_reseau_cible le temps que
    # ce panneau précis reste ouvert -- un seul panneau d'aperçu à la
    # fois pour cet écran (même simplicité que TaskConfigScreen, pas de
    # multi-fenêtre : rouvrir "Aperçu" sur une autre ligne reconfigure la
    # même fenêtre vers la nouvelle cible plutôt que d'en empiler une
    # seconde). Porte (id_executant, instance_id, requete_id, commande).
    demande_commande_instance_reseau = Signal(str, str, str, dict)
    demande_capture_ponctuelle_instance_reseau = Signal(str, str)  # (id_executant, instance_id)
    demande_taux_capture_instance_reseau = Signal(str, str, float)  # (id_executant, instance_id, fps)
    # PATCH B.3 -- relais du panneau vers MainWindow (ClientServeurT.
    # definir_preference_capture n'a pas de notion de session/instance,
    # c'est un réglage global par PILOTE, cf. docstring de
    # _sur_clic_apercu_execution pour le détail). Signal(str, int) :
    # (resolution, qualite), même signature que PanneauRenduInstance.
    # demande_preference_capture.
    demande_preference_capture_reseau = Signal(str, int)

    _LIBELLES_STATUT_GLOBAL = {
        # PATCH E.3 (cf. cahier des charges patchs.md, section E.3) --
        # renommage aligné sur les 3 statuts demandés ("En attente" / "En
        # exécution" / "Terminé"), PLUS "Échec d'envoi" conservé comme
        # 4e statut technique distinct (décision explicite utilisateur :
        # ne pas le fondre dans les 3 autres -- un échec de transmission
        # réseau, avant même que le sAutoniax ait reçu quoi que ce soit,
        # n'est ni "en attente d'exécution" ni "terminé" au sens métier).
        # "envoi" = en attente de démarrage réel côté sAutoniax (transmission
        # réseau en cours ou déjà réussie, mais aucune progression encore
        # reçue) -- c'est le SEUL état qui correspond à "En attente" dans
        # ce cycle de vie, pas un 5e état séparé à inventer.
        "envoi": "En attente",
        "echec_envoi": "Échec d'envoi",
        "en_cours": "En exécution",
        # "termine" et "echec_partiel" étaient auparavant deux libellés
        # distincts -- fusionnés ici sous un seul statut "Terminé" (cf.
        # E.3 : seuls 3 statuts, le détail succès/échec vit désormais
        # dans la colonne "Résultat", pas dans le libellé du statut
        # lui-même). "echec_partiel" reste écrit tel quel en interne
        # (session["statut"], cf. sur_retour_recu, INCHANGÉ) pour ne pas
        # perdre l'information utilisée ailleurs (ex. _rafraichir_detail,
        # bouton "Récupérer en local") -- seul ce dict d'AFFICHAGE fusionne
        # les deux vers le même libellé.
        "termine": "Terminé",
        "echec_partiel": "Terminé",
    }

