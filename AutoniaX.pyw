    def executer_notebook_distant(self, id_executant: str, profil_nom: str, code: str,
                                   services_api_lies: Optional[dict] = None,
                                   session_id: Optional[str] = None,
                                   reinitialiser_result_color: bool = False,
                                   lire_result_color_finale: bool = False) -> str:
        """Onglet Notebook Distant (Patch 4.5) -- envoie `code` pour
        exécution sur `profil_nom` du sAutoniax `id_executant`. Retourne
        le session_id (l'appelant, ProjetBatchScreen/l'écran dédié, le
        garde pour corréler les notebook_distant_log_recu/notebook_
        distant_resultat_recu à venir, qui portent tous ce même
        session_id).

        services_api_lies (CORRECTIF, retour explicite utilisateur --
        "je veux le filtrage precis comme en local") : {nom_service_api:
        instance_id/id_executant}, cf. Task.services_api_importes -- passé
        par MoteurExecutionCelluleReseau.lancer (mode Task réseau), reste
        None pour les autres appelants (NotebookDistantScreen, usage
        manuel hors Task -- aucun ServiceAPI/Composant à injecter dans ce
        cas, comportement inchangé).

        session_id (CORRECTIF bug race condition "spinner bloqué après
        succès instantané", même patron EXACT que initialiser_notebook_
        distant/fermer_notebook_distant -- Option A, cf. leur docstring) :
        permet à L'APPELANT (MoteurExecutionCelluleReseau.lancer) de
        choisir le session_id à l'avance et de l'enregistrer dans
        _sessions_execution_reseau AVANT cet appel, plutôt que de le
        récupérer seulement en retour. Sans ça, notebook_distant_
        resultat_recu peut être émis par la coroutine réseau (sur le
        thread de la boucle asyncio) AVANT que le thread Qt appelant
        n'ait fini d'exécuter la ligne d'enregistrement juste après le
        retour de cette méthode -- résultat ignoré, spinner bloqué. Reste
        None pour les autres appelants (NotebookDistantScreen, usage
        manuel hors Task -- génération interne comme avant, comportement
        inchangé).

        reinitialiser_result_color/lire_result_color_finale (AJOUT,
        SPEC_lot_corrections_2026-09.md section 11) : transmis tels quels
        au sAutoniax (cf. _executer_notebook_distant/_sur_executer_
        notebook_distant_demande/_sautoniax_executer_notebook_distant_
        sur_instance_isolee) -- False par défaut pour les deux, aucun
        changement de comportement pour NotebookDistantScreen (usage
        manuel hors Task) ni pour _executer_cellule (mode réseau
        non-clone). Seul _lancer_sequence_clone_profil (via
        MoteurExecutionCelluleReseau) active l'un ou l'autre, cf. sa
        docstring pour le calcul exact de ces deux booléens."""
        if session_id is None:
            session_id = uuid.uuid4().hex[:12]
        if self._loop is None or not self._loop.is_running() or self._ws is None:
            # AJOUT (spec B.2) -- signal étendu à 6 arguments (cf. sa
            # déclaration) : None, None explicites ici, aucune exécution
            # n'a eu lieu (échec avant même l'envoi réseau), donc aucun
            # horodatage réel à rapporter.
            self.notebook_distant_resultat_recu.emit(session_id, id_executant, False, "Non connecté au serveurT.", None, None, None, None)
            return session_id
        asyncio.run_coroutine_threadsafe(
            self._executer_notebook_distant(
                id_executant, profil_nom, code, session_id, services_api_lies,
                reinitialiser_result_color, lire_result_color_finale,
            ), self._loop,
        )
        return session_id

    def initialiser_notebook_distant(self, id_executant: str, profil_nom: str, session_id: Optional[str] = None) -> str:
        """Onglet Notebook Distant -- bouton "Initialiser" (demande
        explicite utilisateur : "initialiser vas juste bien configurer
        tout pour que l'execution se passe comme prevue"). Même patron
        EXACT que executer_notebook_distant ci-dessus, mais demande au
        sAutoniax `id_executant` de charger `profil_nom` (téléchargement
        B2 + lancement Camoufox headless, cf. _sautoniax_initialiser_
        notebook_distant) plutôt que d'exécuter du code -- aucune cellule
        ne doit pouvoir s'exécuter tant que ceci n'a pas réussi. Retourne
        le session_id (généré ici si `session_id` non fourni -- cf.
        NotebookDistantScreen, qui le garde pour corréler les
        initialiser_notebook_distant_log_recu/_resultat_recu à venir).

        `session_id` (optionnel, PATCH mode réseau Task) : permet à
        l'APPELANT de choisir le session_id à l'avance plutôt que d'avoir
        à le récupérer en retour -- nécessaire pour TaskConfigScreen
        (Option A, cf. demande_initialisation_reseau_emettre) qui
        enregistre déjà sa correspondance (task_id, id_executant,
        profil_nom) dans _sessions_initialisation_reseau AVANT que
        MainWindow ne fasse cet appel, pour ne rater aucun log/résultat
        arrivant plus vite que le retour synchrone de cette méthode.
        NotebookDistantScreen continue de ne rien passer ici (repli sur
        la génération interne ci-dessous, comportement inchangé)."""
        if session_id is None:
            session_id = uuid.uuid4().hex[:12]
        if self._loop is None or not self._loop.is_running() or self._ws is None:
            self.initialiser_notebook_distant_resultat_recu.emit(session_id, id_executant, False, "Non connecté au serveurT.")
            return session_id
        asyncio.run_coroutine_threadsafe(
            self._initialiser_notebook_distant(id_executant, profil_nom, session_id), self._loop,
        )
        return session_id

    def fermer_notebook_distant(self, id_executant: str, session_id: Optional[str] = None) -> str:
        """Bouton "Fermer" (à côté d'"Initialiser", Task réseau -- demande
        explicite utilisateur : "il faut que onlajoute a coter du bouton
        initialiser , la il vas detruit le prfils lancer"). Même patron
        EXACT que initialiser_notebook_distant ci-dessus, mais demande au
        sAutoniax `id_executant` de FERMER le profil actuellement chargé
        (Camoufox + capture périodique, cf. _sautoniax_fermer_notebook_
        distant) sans en recharger un nouveau -- symétrique du kill_profil
        du panneau Instances, mais pour ce mode mono-profil "Initialiser"
        qui n'a pas de nom_profil à cibler (un seul profil chargé à la
        fois, cf. docstring de _sautoniax_initialiser_notebook_distant).
        Retourne le session_id (généré ici si non fourni)."""
        if session_id is None:
            session_id = uuid.uuid4().hex[:12]
        if self._loop is None or not self._loop.is_running() or self._ws is None:
            self.fermer_notebook_distant_resultat_recu.emit(session_id, id_executant, False, "Non connecté au serveurT.")
            return session_id
        asyncio.run_coroutine_threadsafe(
            self._fermer_notebook_distant(id_executant, session_id), self._loop,
        )
        return session_id

