class DriveNoSuchKey(Exception):
    """Levée quand une clé demandée (get_object/head_object) n'existe
    pas -- équivalent du ClientError/NoSuchKey de boto3, pour que le
    code appelant existant (qui testait déjà ce cas) continue de
    fonctionner avec un minimum de changements."""
    pass


def _echapper_nom_drive(nom: str) -> str:
    """Échappe une apostrophe dans un nom de fichier/dossier pour
    l'insérer sans risque dans une requête Drive `q=...` (syntaxe de
    requête Drive : une apostrophe littérale s'échappe par \\')."""
    return nom.replace("'", "\\'")


class _ClientDriveMinimal:
    """Enveloppe minimale autour de l'API Google Drive v3, exposant les
    mêmes noms de méthodes que boto3 (put_object/get_object/head_object/
    list_objects_v2/delete_object/copy_object) pour minimiser les
    changements dans le code appelant existant (GestionnaireStockageDrive
    Direct ci-dessous). Les clés façon S3 ("ServeurT/serveur.py") sont
    traduites en chemins de dossiers/fichiers Drive réels, résolus (et
    créés si besoin, pour les écritures) sous UN SEUL dossier racine --
    ce dossier doit déjà exister et avoir été partagé manuellement en
    Éditeur avec l'adresse e-mail du compte de service AVANT le premier
    appel. Import de googleapiclient/google.oauth2 fait PARESSEUSEMENT
    à l'intérieur de __init__ (jamais au niveau module, même patron
    défensif que boto3 avant cette migration) -- l'erreur ne remonte
    qu'au moment réel de l'appel, pas au démarrage d'AutoniaX.py."""

    MIME_DOSSIER = "application/vnd.google-apps.folder"

    def __init__(self, chemin_cle_json: str, dossier_racine_id: str):
        from google.oauth2 import service_account as _drive_service_account
        from googleapiclient.discovery import build as _drive_build

        creds = _drive_service_account.Credentials.from_service_account_file(
            chemin_cle_json,
            scopes=["https://www.googleapis.com/auth/drive"],
        )
        self._service = _drive_build("drive", "v3", credentials=creds)
        self._racine_id = dossier_racine_id
        self._cache_dossiers: dict[str, str] = {}

    def _resoudre_dossier(self, segments_dossier: list[str], creer_si_absent: bool) -> str:
        cle_cache = "/".join(segments_dossier)
        if cle_cache in self._cache_dossiers:
            return self._cache_dossiers[cle_cache]

        parent_id = self._racine_id
        chemin_partiel = []
        for segment in segments_dossier:
            chemin_partiel.append(segment)
            cle_partielle = "/".join(chemin_partiel)
            if cle_partielle in self._cache_dossiers:
                parent_id = self._cache_dossiers[cle_partielle]
                continue

            requete = (
                f"'{parent_id}' in parents and name = '{_echapper_nom_drive(segment)}' "
                f"and mimeType = '{self.MIME_DOSSIER}' and trashed = false"
            )
            resultats = self._service.files().list(
                q=requete, fields="files(id, name)", pageSize=1,
            ).execute().get("files", [])

            if resultats:
                dossier_id = resultats[0]["id"]
            elif creer_si_absent:
                metadata = {"name": segment, "mimeType": self.MIME_DOSSIER, "parents": [parent_id]}
                dossier_id = self._service.files().create(body=metadata, fields="id").execute()["id"]
            else:
                raise DriveNoSuchKey(f"Dossier '{cle_partielle}' introuvable sous la racine Drive.")

            self._cache_dossiers[cle_partielle] = dossier_id
            parent_id = dossier_id

        return parent_id

    @staticmethod
    def _decouper_cle(cle: str) -> tuple[list[str], str]:
        segments = cle.split("/")
        return segments[:-1], segments[-1]

    def _trouver_fichier(self, cle: str) -> Optional[dict]:
        segments_dossier, nom_fichier = self._decouper_cle(cle)
        try:
            parent_id = self._resoudre_dossier(segments_dossier, creer_si_absent=False)
        except DriveNoSuchKey:
            return None
        requete = f"'{parent_id}' in parents and name = '{_echapper_nom_drive(nom_fichier)}' and trashed = false"
        resultats = self._service.files().list(
            q=requete, fields="files(id, name, size)", pageSize=1,
        ).execute().get("files", [])
        return resultats[0] if resultats else None

    def put_object(self, Key: str, Body: bytes, progression_callback=None) -> None:
        """BUGFIX (retour utilisateur : "avant je voyais une barre de
        progresion lorsque je mettais ajour autoniax.py vers le cloud
        google drive, mais maintenant je ne voir plus") -- cause racine :
        resumable=False (comportement d'origine, cf. historique)
        envoyait tout le fichier en UN SEUL appel HTTP bloquant
        .execute(), sans jamais passer par next_chunk() -- structurel-
        lement impossible d'en tirer une progression intermédiaire,
        quel que soit ce qui est branché côté UI (cf. mise_a_jour_app_
        progression, déclaré et connecté mais plus jamais émis depuis la
        migration vers l'upload direct Drive).

        resumable=True (comme le fait déjà get_object ci-dessous pour le
        téléchargement, via MediaIoBaseDownload.next_chunk()) --
        symétrique côté upload : l'appel .execute() devient un objet
        HttpRequest qu'on avance nous-mêmes chunk par chunk via
        next_chunk(), chaque itération renvoyant (status, done) --
        status.progress() donne la fraction 0.0-1.0 déjà envoyée.
        progression_callback(pourcentage: int), si fourni, est appelé
        après chaque chunk -- reste bloquant/synchrone comme le reste de
        cette méthode (appelée depuis un threadpool par l'appelant, cf.
        docstring de classe), à charge de CE callback de revenir sur la
        boucle asyncio/Qt si besoin (cf. GestionnaireStockageDriveDirect.
        _put_object_avec_retry, qui le propage tel quel)."""
        from googleapiclient.http import MediaIoBaseUpload as _DriveMediaUpload

        segments_dossier, nom_fichier = self._decouper_cle(Key)
        parent_id = self._resoudre_dossier(segments_dossier, creer_si_absent=True)
        media = _DriveMediaUpload(io.BytesIO(Body), mimetype="application/octet-stream", resumable=True)
        existant = self._trouver_fichier(Key)
        if existant is not None:
            requete = self._service.files().update(fileId=existant["id"], media_body=media)
        else:
            metadata = {"name": nom_fichier, "parents": [parent_id]}
            requete = self._service.files().create(body=metadata, media_body=media, fields="id")
        termine = False
        while not termine:
            status, reponse = requete.next_chunk()
            if status is not None and progression_callback is not None:
                progression_callback(int(status.progress() * 100))
            termine = reponse is not None

    def get_object(self, Key: str) -> dict:
        from googleapiclient.http import MediaIoBaseDownload as _DriveMediaDownload

        fichier = self._trouver_fichier(Key)
        if fichier is None:
            raise DriveNoSuchKey(f"Clé introuvable : '{Key}'")
        requete = self._service.files().get_media(fileId=fichier["id"])
        buffer = io.BytesIO()
        downloader = _DriveMediaDownload(buffer, requete)
        termine = False
        while not termine:
            _, termine = downloader.next_chunk()
        buffer.seek(0)
        return {"Body": buffer}

    def telecharger_objet_vers_fichier(self, Key: str, chemin_destination: str, callback_progression=None) -> None:
        """AJOUT (téléchargement Drive DIRECT, sans passer par serveur.py) --
        demande explicite utilisateur : "je ne veux plus que le
        telechargement passe par le serveur ... sa doit etre direct au
        cloud". Équivalent de get_object() ci-dessus mais écrit
        directement sur disque au fil des chunks (MediaIoBaseDownload
        télécharge déjà par blocs en interne, cf. son fonctionnement),
        au lieu d'accumuler tout le fichier en mémoire dans un
        io.BytesIO avant de le recopier -- important pour les gros
        fichiers (profils zip, service_api.zip). `callback_progression`
        (optionnel) : appelé après chaque chunk avec un int 0..100 (cf.
        downloader.next_chunk() -> (status, done), status.progress()
        renvoie une fraction 0..1) -- même contrat que le signal
        telechargement_fichier_progression déjà émis par l'ancien
        chemin WebSocket chunké, pour ne rien changer côté appelants
        UI. Écrit dans un fichier temporaire puis renomme atomiquement
        à la fin (os.replace) -- jamais de fichier partiel visible au
        chemin final en cas d'échec/interruption en cours de route."""
        from googleapiclient.http import MediaIoBaseDownload as _DriveMediaDownload

        fichier = self._trouver_fichier(Key)
        if fichier is None:
            raise DriveNoSuchKey(f"Clé introuvable : '{Key}'")
        requete = self._service.files().get_media(fileId=fichier["id"])

        chemin_dest = Path(chemin_destination)
        chemin_dest.parent.mkdir(parents=True, exist_ok=True)
        chemin_tmp = chemin_dest.with_suffix(chemin_dest.suffix + ".part")

        with open(chemin_tmp, "wb") as f:
            downloader = _DriveMediaDownload(f, requete)
            termine = False
            while not termine:
                statut, termine = downloader.next_chunk()
                if callback_progression is not None and statut is not None:
                    callback_progression(int(statut.progress() * 100))
        os.replace(chemin_tmp, chemin_dest)

    def head_object(self, Key: str) -> dict:
        fichier = self._trouver_fichier(Key)
        if fichier is None:
            raise DriveNoSuchKey(f"Clé introuvable : '{Key}'")
        return fichier

    def list_objects_v2(self, Prefix: str = "") -> dict:
        """PATCH (bug post-migration B2 -> Drive : contrairement à S3/B2,
        où un préfixe liste TOUTES les clés en dessous quelle que soit
        leur profondeur -- pas de vrais dossiers --, Drive a de vrais
        sous-dossiers, et la version précédente de cette méthode ne
        listait que les enfants DIRECTS du dossier résolu, en excluant
        les sous-dossiers eux-mêmes de la sortie. Résultat : tout ce qui
        vivait sous un sous-dossier -- ex. "App/AutoniaX.py" -- restait
        invisible pour list_objects_v2("") (racine), et l'onglet
        "Stockage cloud" affichait "(bucket vide)" même quand Drive
        contenait bel et bien des fichiers. Cette version descend
        récursivement dans chaque sous-dossier rencontré pour reproduire
        fidèlement le comportement plat qu'attend le reste du code
        (StockageCloudScreen._construire_noeuds_arborescence_stockage
        reconstruit lui-même une arborescence à partir de clés plates,
        exactement comme avec B2)."""
        prefixe_nettoye = Prefix.rstrip("/")
        segments_dossier = [s for s in prefixe_nettoye.split("/") if s] if prefixe_nettoye else []
        try:
            parent_id = self._resoudre_dossier(segments_dossier, creer_si_absent=False)
        except DriveNoSuchKey:
            return {"Contents": []}
        prefixe_affiche = f"{prefixe_nettoye}/" if prefixe_nettoye else ""
        contenu = self._lister_recursif(parent_id, prefixe_affiche)
        return {"Contents": contenu}

    def _lister_recursif(self, dossier_id: str, prefixe_affiche: str) -> list[dict]:
        """Descend récursivement sous dossier_id, en accumulant
        {"Key": ..., "Size": ...} pour chaque FICHIER rencontré (jamais
        les dossiers eux-mêmes, cohérent avec le comportement plat de
        S3/B2) -- cf. docstring de list_objects_v2 pour le contexte."""
        requete = f"'{dossier_id}' in parents and trashed = false"
        resultats = self._service.files().list(
            q=requete, fields="files(id, name, size, mimeType)", pageSize=1000,
        ).execute().get("files", [])
        contenu: list[dict] = []
        for f in resultats:
            if f.get("mimeType") == self.MIME_DOSSIER:
                contenu.extend(
                    self._lister_recursif(f["id"], f"{prefixe_affiche}{f['name']}/")
                )
            else:
                contenu.append({
                    "Key": f"{prefixe_affiche}{f['name']}",
                    "Size": int(f.get("size", 0)),
                })
        return contenu

    def delete_object(self, Key: str) -> None:
        fichier = self._trouver_fichier(Key)
        if fichier is not None:
            self._service.files().delete(fileId=fichier["id"]).execute()

    def copy_object(self, CopySource: dict, Key: str) -> None:
        cle_source = CopySource["Key"]
        fichier_source = self._trouver_fichier(cle_source)
        if fichier_source is None:
            raise DriveNoSuchKey(f"Clé source introuvable : '{cle_source}'")
        segments_dossier, nom_fichier = self._decouper_cle(Key)
        parent_id = self._resoudre_dossier(segments_dossier, creer_si_absent=True)
        metadata = {"name": nom_fichier, "parents": [parent_id]}
        self._service.files().copy(fileId=fichier_source["id"], body=metadata).execute()


# =====================================================================================================
# TRANSIT DRIVE (spec « Transit Drive : sortir les données lourdes du pont pilote », étape 1)
# -----------------------------------------------------------------------------------------------------
# Écrit / lit un zip PRÉ-CRÉÉ de Transit/ (dataN.zip) directement par son fileId, avec le compte de service :
# ni le pont ni le serveurT ne voient les données. Le fileId (et le jeton) viennent du serveurT, qui attribue
# un zip libre (cf. ClientServeurT.transit_demander_zip / transit_liberer_zip).
#
# Contenu d'un zip : « manifest.json » (nom, taille, SHA-256 du contenu) + « contenu » (nom interne FIXE : le
# vrai nom n'est que dans le manifest, jamais utilisé comme chemin). ZIP_STORED pour les formats déjà compressés
# (png, jpg, webp, zip...), ZIP_DEFLATED niveau 1 sinon.
#
# Intégrité : l'expéditeur compare la taille et le MD5 renvoyés par Drive à ceux du zip envoyé ; le destinataire
# vérifie le SHA-256 du zip téléchargé (transmis dans l'appel logique) PUIS celui du contenu (manifest). Le
# contenu d'un zip change d'un transfert à l'autre : ne jamais se fier au seul nom.
#
# Erreurs : TransitErreur avec un message clair, JAMAIS de repli sur le pont. Seules les erreurs transitoires
# (réseau, 429, 5xx, quota de débit) sont reprises ; un refus (403 quota, 404) échoue tout de suite.
# Bloquant : à appeler dans un thread (jamais sur le thread Qt ni sur la boucle asyncio).
class TransitErreur(Exception):
    """Transfert Transit impossible (Drive a échoué/refusé, empreinte différente, serveurT injoignable...)."""
    pass


class _ErreurHttpRequests(Exception):
    """Réponse HTTP d'erreur reçue via 'requests', présentée comme celle de googleapiclient (.resp.status, .content) pour que
    TransitDrive._est_transitoire / _decrire / _raison_http fonctionnent sans changement."""
    def __init__(self, statut: int, contenu: bytes):
        super().__init__(f"HTTP {statut}")
        self.resp = type("_Resp", (), {"status": statut})()
        self.content = contenu


_TRANSIT_EXT_DEJA_COMPRESSEES = {
    ".png", ".jpg", ".jpeg", ".webp", ".gif", ".zip", ".gz", ".7z", ".rar", ".mp4", ".mp3", ".xz", ".bz2",
}


class TransitDrive:
    # Battement de connexion : une mini-requête Drive toutes les N secondes sur la session partagée, pour que la connexion ne soit
    # JAMAIS froide. Mesuré hors AutoniaX : la 1re requête d'une série prend 5 à 13 s, les suivantes 2 à 4 s ; dans AutoniaX les
    # transferts sont espacés de 10 à 30 s, donc presque tous tombent sur une connexion froide. 0 = désactivé.
    BATTEMENT_DRIVE_S = 4.0
    MAX_TENTATIVES = 4
    PAUSE_INITIALE_S = 1.0
    SEUIL_RESUMABLE = 0                      # TOUJOURS résumable : mesuré sur le PC, 6,7 s au lieu de 15,6 s pour 768 Ko en une seule requête
    TAILLE_MORCEAU = 8 * 1024 * 1024        # multiple de 256 Ko, exigé par Drive pour l'upload résumable

    def __init__(self, chemin_cle_json: Optional[str] = None, cle_service_json: Optional[dict] = None):
        if (chemin_cle_json is None) == (cle_service_json is None):
            raise ValueError("TransitDrive : fournir soit chemin_cle_json, soit cle_service_json (un seul).")
        self._chemin_cle_json = chemin_cle_json
        self._cle_service_json = cle_service_json
        self._local = threading.local()      # un client Drive par thread (googleapiclient/httplib2 n'est pas thread-safe)
        self._verrou_session = threading.Lock()
        self._session_partagee_obj = None    # session 'requests' UNIQUE pour tous les threads (voir _session_partagee)
        self._creds_partagees = None
        self._verrou_nettoyage = threading.Lock()
        self._nettoyages_en_cours: set = set()

    @classmethod
    def depuis_reglages(cls, reglages: Optional["ReglagesApp"] = None) -> "TransitDrive":
        """Côté pilote : clé du compte de service lue depuis le chemin des réglages (comme GestionnaireStockageDriveDirect)."""
        reglages = reglages or ReglagesApp.load()
        return cls(chemin_cle_json=reglages.drive_chemin_cle_json_resolu)

    # ---------------------------------------------------------------------------------------------
    # Client Drive (par thread) et gestion d'erreurs
    # ---------------------------------------------------------------------------------------------
    def _session_partagee(self):
        """Session 'requests' UNIQUE, partagée par tous les threads du processus.
        CORRECTIF PERF : avant, session + identifiants étaient PAR THREAD (self._local). Le pont exécute chaque opération dans un
        pool de 8 threads : un thread neuf refaisait à chaque fois jeton OAuth + connexion TLS (~2 s, vu dans les logs :
        'premier_appel_s' 1,8 à 2,0 s sur le PC contre 0,1 à 0,3 s sur le clone, et lecture réelle 5,7 s contre 2,6 s en test).
        Ici : créée une fois, jeton obtenu tout de suite, pool de connexions keep-alive réutilisées par tous les threads."""
        session = self._session_partagee_obj
        if session is not None:
            return session
        with self._verrou_session:
            if self._session_partagee_obj is None:
                from google.oauth2 import service_account as _sa
                from google.auth.transport.requests import AuthorizedSession as _AuthSession, Request as _Req
                from requests.adapters import HTTPAdapter as _Adapter
                portees = ["https://www.googleapis.com/auth/drive"]
                if self._chemin_cle_json is not None:
                    creds = _sa.Credentials.from_service_account_file(self._chemin_cle_json, scopes=portees)
                else:
                    creds = _sa.Credentials.from_service_account_info(self._cle_service_json, scopes=portees)
                sess = _AuthSession(creds)
                adaptateur = _Adapter(pool_connections=4, pool_maxsize=16)
                sess.mount("https://", adaptateur)
                try:
                    creds.refresh(_Req())          # jeton obtenu UNE fois, maintenant (puis renouvelé automatiquement)
                except Exception as e:
                    log_reseau_t.debug(f"[transit] préchauffage du jeton impossible (sera retenté à la 1re requête) : {e!r}")
                self._creds_partagees = creds
                self._session_partagee_obj = sess
                if self.BATTEMENT_DRIVE_S and self.BATTEMENT_DRIVE_S > 0:
                    self._demarrer_battement()
        return self._session_partagee_obj

    def _demarrer_battement(self):
        """Thread daemon : garde la connexion Drive de la session partagée chaude (voir BATTEMENT_DRIVE_S). Journalise (WARNING)
        uniquement un battement > 3 s : c'est la mesure directe des à-coups de la ligne, même sans aucun transfert."""
        def _boucle():
            while True:
                time.sleep(self.BATTEMENT_DRIVE_S)
                sess = self._session_partagee_obj
                if sess is None:
                    return
                t0 = time.time()
                try:
                    sess.get("https://www.googleapis.com/drive/v3/about?fields=kind", timeout=20)
                except Exception as e:
                    log_reseau_t.debug(f"[transit] battement Drive en échec : {e!r}")
                    continue
                duree = time.time() - t0
                if duree > 3.0:
                    log_reseau_t.warning(f"[transit] battement Drive lent : {duree:.1f}s (à-coup de la ligne vers Google)")
        threading.Thread(target=_boucle, name="transit-battement", daemon=True).start()

    def _session_neuve(self):
        """Session 'requests' avec CONNEXION NEUVE (mêmes identifiants) : sert aux tentatives de secours."""
        self._session_partagee()
        from google.auth.transport.requests import AuthorizedSession as _AuthSession
        return _AuthSession(self._creds_partagees)

    def _couvert(self, libelle: str, faire, delai_s: float):
        """CORRECTIF PERF (à-coups de ligne) : mesuré hors AutoniaX, ~1 opération sur 5 subit un blocage de 5 à 15 s sur SA
        connexion (paquets perdus -> retransmissions TCP : TLS 2,7 s au lieu de 0,2 s, lecture 7,9 s au lieu de 2 s).
        Si l'opération n'est pas finie après `delai_s`, on lance la MÊME opération sur une connexion neuve ; la première qui
        réussit gagne. Lecture et écriture du même zip sont idempotentes (même contenu, même fichier : dernier écrivain = même
        octets ; taille et MD5 sont vérifiés ensuite par l'appelant). `faire(session)` -> résultat. Une erreur de la tentative
        principale avant le délai est relancée telle quelle (les reprises habituelles s'en chargent)."""
        import queue as _queue
        q = _queue.Queue()

        def _lancer(session, etiquette):
            def _t():
                try:
                    q.put((etiquette, True, faire(session)))
                except BaseException as e:      # noqa: BLE001 -- transmise au thread appelant
                    q.put((etiquette, False, e))
            threading.Thread(target=_t, name=f"transit-{etiquette}", daemon=True).start()

        t0 = time.time()
        _lancer(self._session_partagee(), "principal")
        en_cours, secours_lance = 1, False
        while True:
            try:
                reste = None if secours_lance else max(0.05, delai_s - (time.time() - t0))
                etiquette, ok, valeur = q.get(timeout=reste)
            except _queue.Empty:
                secours_lance = True
                en_cours += 1
                log_reseau_t.warning(f"[transit] {libelle} : pas fini après {time.time() - t0:.1f}s (à-coup de connexion probable) "
                                     f"-> tentative de secours sur une connexion neuve.")
                try:
                    _lancer(self._session_neuve(), "secours")
                except Exception as e:
                    en_cours -= 1
                    log_reseau_t.warning(f"[transit] {libelle} : secours impossible : {e!r}")
                continue
            en_cours -= 1
            if ok:
                if secours_lance:
                    log_reseau_t.info(f"[transit] {libelle} : fini par la tentative '{etiquette}' en {time.time() - t0:.1f}s.")
                return valeur
            if en_cours <= 0:
                raise valeur

    def _service(self):
        service = getattr(self._local, "service", None)
        if service is None:
            from google.oauth2 import service_account as _sa
            from googleapiclient.discovery import build as _build
            portees = ["https://www.googleapis.com/auth/drive"]
            if self._chemin_cle_json is not None:
                creds = _sa.Credentials.from_service_account_file(self._chemin_cle_json, scopes=portees)
            else:
                creds = _sa.Credentials.from_service_account_info(self._cle_service_json, scopes=portees)
            service = _build("drive", "v3", credentials=creds, cache_discovery=False)
            self._local.service = service
            self._local.creds = creds
        return service

    @staticmethod
    def _raison_http(e) -> str:
        try:
            return str(json.loads(e.content)["error"]["errors"][0]["reason"])
        except Exception:
            return ""

    @classmethod
    def _est_transitoire(cls, e) -> bool:
        statut = getattr(getattr(e, "resp", None), "status", None)
        if statut is not None:
            if statut in (408, 429) or statut >= 500:
                return True
            if statut == 403:
                return cls._raison_http(e) in ("rateLimitExceeded", "userRateLimitExceeded", "backendError")
            return False
        if isinstance(e, OSError):          # inclut ConnectionError, TimeoutError, ssl.SSLError, socket.error
            return True
        return any(c.__module__.startswith("httplib2") or c.__name__ == "TransportError" for c in type(e).__mro__)

    @classmethod
    def _decrire(cls, e) -> str:
        statut = getattr(getattr(e, "resp", None), "status", None)
        if statut is None:
            return f"{type(e).__name__} : {e}"
        raison = cls._raison_http(e)
        texte = f"Drive HTTP {statut}" + (f" ({raison})" if raison else "")
        if raison == "storageQuotaExceeded":
            texte += (" -- le compte de service ne peut pas écrire ici : le zip doit déjà exister et appartenir à "
                      "l'utilisateur (le compte de service ne fait que l'écraser)")
        elif statut == 404:
            texte += " -- zip introuvable ou non partagé avec le compte de service"
        elif statut == 403:
            texte += " -- accès refusé (zip non partagé en Éditeur avec le compte de service ?)"
        return texte

    def _avec_reprises(self, libelle: str, fonction):
        derniere: Optional[Exception] = None
        for tentative in range(1, self.MAX_TENTATIVES + 1):
            try:
                return fonction()
            except TransitErreur:
                raise
            except Exception as e:
                derniere = e
                if tentative >= self.MAX_TENTATIVES or not self._est_transitoire(e):
                    break
                pause = self.PAUSE_INITIALE_S * (2 ** (tentative - 1))
                log_reseau_t.warning(f"[transit] {libelle} : échec transitoire ({self._decrire(e)}), "
                                     f"tentative {tentative}/{self.MAX_TENTATIVES}, nouvel essai dans {pause:.0f}s.")
                time.sleep(pause)
        raise TransitErreur(f"{libelle} : {self._decrire(derniere)}") from derniere

    # ---------------------------------------------------------------------------------------------
    # Format du zip
    # ---------------------------------------------------------------------------------------------
    @staticmethod
    def empaqueter(nom_fichier: str, octets: bytes, compresser: Optional[bool] = None):
        """-> (octets_du_zip, sha256_du_zip, sha256_du_contenu). compresser=None : automatique selon l'extension."""
        if compresser is None:
            compresser = os.path.splitext(nom_fichier)[1].lower() not in _TRANSIT_EXT_DEJA_COMPRESSEES
        sha_contenu = hashlib.sha256(octets).hexdigest()
        manifest = json.dumps({"v": 1, "nom": nom_fichier, "taille": len(octets), "sha256": sha_contenu},
                              ensure_ascii=False).encode("utf-8")
        tampon = io.BytesIO()
        with zipfile.ZipFile(tampon, "w") as z:
            z.writestr("manifest.json", manifest, compress_type=zipfile.ZIP_STORED)
            if compresser:
                z.writestr("contenu", octets, compress_type=zipfile.ZIP_DEFLATED, compresslevel=1)
            else:
                z.writestr("contenu", octets, compress_type=zipfile.ZIP_STORED)
        octets_zip = tampon.getvalue()
        return octets_zip, hashlib.sha256(octets_zip).hexdigest(), sha_contenu

    @staticmethod
    def depaqueter(octets_zip: bytes):
        """-> (nom_fichier, octets). Vérifie le manifest (taille + SHA-256 du contenu). Lève TransitErreur sinon."""
        try:
            with zipfile.ZipFile(io.BytesIO(octets_zip)) as z:
                manifest = json.loads(z.read("manifest.json").decode("utf-8"))
                info = z.getinfo("contenu")
                if info.file_size != manifest["taille"]:
                    raise TransitErreur(f"zip incohérent : taille déclarée {manifest['taille']}, réelle {info.file_size}.")
                contenu = z.read("contenu")
        except TransitErreur:
            raise
        except Exception as e:
            raise TransitErreur(f"zip illisible ou sans manifest valide : {type(e).__name__} : {e}") from e
        if hashlib.sha256(contenu).hexdigest() != manifest["sha256"]:
            raise TransitErreur("SHA-256 du contenu différent de celui du manifest (zip corrompu ou réécrit en cours de lecture).")
        return manifest["nom"], contenu

    # ---------------------------------------------------------------------------------------------
    # Écriture / lecture
    # ---------------------------------------------------------------------------------------------
    def ecrire(self, file_id: str, nom_fichier: str, octets: bytes, compresser: Optional[bool] = None,
               nettoyer_revisions: bool = True) -> dict:
        """Écrase le zip `file_id` avec `octets` (sous le nom `nom_fichier` dans le manifest).
        Retourne {"taille", "sha256", "sha256_contenu", "duree_s"} : taille et SHA-256 DU ZIP, à transmettre au
        destinataire dans l'appel logique."""
        from googleapiclient.http import MediaIoBaseUpload as _Upload
        t0 = time.time()
        octets_zip, sha_zip, sha_contenu = self.empaqueter(nom_fichier, octets, compresser)
        md5 = hashlib.md5(octets_zip).hexdigest()
        resumable = len(octets_zip) > self.SEUIL_RESUMABLE
        t_empaquetage = time.time() - t0
        # CORRECTIF PERF (mesuré : écriture PC->Drive 6 à 16 s en résumable httplib2, contre 1 à 3 s en un seul PATCH 'requests',
        # comme la lecture qui l'utilise déjà) : un seul PATCH uploadType=media sur la session requests réutilisée (keep-alive,
        # pas de nouvelle connexion TLS ni de requête d'ouverture de session résumable). Repli sur l'upload résumable au-delà
        # de 64 Mo ou si 'requests' est absent. Reprises, taille et MD5 inchangés (_avec_reprises + vérification plus bas).
        utiliser_requests = len(octets_zip) <= 64 * 1024 * 1024
        if utiliser_requests:
            try:
                from google.auth.transport.requests import AuthorizedSession as _AuthSession
            except ImportError:
                utiliser_requests = False

        def _patch(session):
            r = session.patch(f"https://www.googleapis.com/upload/drive/v3/files/{file_id}?uploadType=media&fields=id,size,md5Checksum",
                              data=octets_zip, headers={"Content-Type": "application/zip"}, timeout=300)
            if r.status_code >= 400:
                raise _ErreurHttpRequests(r.status_code, r.content)
            return r.json()

        def _envoi_requests():
            # normal : ~2 à 3,5 s par Mo hors à-coup ; secours si > 3,5 s + 2,5 s par Mo
            return self._couvert("écriture", _patch, 3.5 + 2.5 * len(octets_zip) / 1048576)

        def _envoi():
            if utiliser_requests:
                return _envoi_requests()
            media = _Upload(io.BytesIO(octets_zip), mimetype="application/zip", resumable=resumable,
                            chunksize=self.TAILLE_MORCEAU if resumable else -1)
            requete = self._service().files().update(fileId=file_id, media_body=media, fields="id,size,md5Checksum")
            if not resumable:
                return requete.execute()
            reponse = None
            while reponse is None:
                _, reponse = requete.next_chunk()
            return reponse

        t1 = time.time()
        if utiliser_requests:
            self._session_partagee()          # session commune à tous les threads (créée une seule fois)
        else:
            self._service()                   # construit le client Drive de CE thread s'il n'existe pas encore (compté à part)
        t_client = time.time() - t1
        t2 = time.time()
        reponse = self._avec_reprises(f"écriture du zip {file_id}", _envoi)
        t_envoi = time.time() - t2
        taille_drive = int(reponse.get("size", -1))
        if taille_drive != len(octets_zip) or (reponse.get("md5Checksum") and reponse["md5Checksum"] != md5):
            raise TransitErreur(f"écriture du zip {file_id} : Drive renvoie une taille/empreinte différente de celle envoyée "
                                f"({taille_drive} octets au lieu de {len(octets_zip)}).")
        if nettoyer_revisions:
            self._nettoyer_revisions_en_fond(file_id)
        duree = time.time() - t0
        etapes = {"empaqueter_s": round(t_empaquetage, 3), "client_drive_s": round(t_client, 3), "envoi_drive_s": round(t_envoi, 3)}
        log_reseau_t.info(f"[transit] écrit {nom_fichier!r} : {len(octets)} octets ({len(octets_zip)} dans le zip) en {duree:.2f}s {etapes} "
                          f"méthode={'requests-PATCH' if utiliser_requests else 'résumable'}")
        return {"taille": len(octets_zip), "sha256": sha_zip, "sha256_contenu": sha_contenu, "duree_s": duree, "etapes": etapes}

    def lire(self, file_id: str, sha256: str, taille: Optional[int] = None):
        """Télécharge le zip `file_id`, vérifie sa taille (si donnée) et son SHA-256, puis celui du contenu.
        -> (nom_fichier, octets). Un SHA-256 différent est repris quelques fois (le zip vient peut-être d'être
        écrasé et Drive n'a pas encore tout propagé), puis TransitErreur."""
        from googleapiclient.http import MediaIoBaseDownload as _Download
        t0 = time.time()

        def _telechargement_google():
            requete = self._service().files().get_media(fileId=file_id)
            tampon = io.BytesIO()
            telecharger = _Download(tampon, requete, chunksize=self.TAILLE_MORCEAU)
            fini = False
            while not fini:
                _, fini = telecharger.next_chunk()
            return tampon.getvalue()

        def _telechargement():
            # Lecture avec 'requests' (mesuré sur le PC : 2,4 s contre 3,2 à 4 s avec httplib2) ; repli sur googleapiclient
            # si 'requests' n'est pas installé.
            try:
                from google.auth.transport.requests import AuthorizedSession
            except ImportError:
                return _telechargement_google()
            def _get(session):
                r = session.get(f"https://www.googleapis.com/drive/v3/files/{file_id}?alt=media", timeout=120)
                if r.status_code >= 400:
                    raise _ErreurHttpRequests(r.status_code, r.content)
                return r.content
            mo = (taille / 1048576) if taille else 0.5
            return self._couvert("lecture", _get, 3.5 + 2.5 * mo)

        t1 = time.time()
        try:
            from google.auth.transport.requests import AuthorizedSession as _AS   # noqa: F401
            self._session_partagee()
        except ImportError:
            self._service()
        t_client = time.time() - t1
        t2 = time.time()
        octets_zip = b""
        for tentative in range(1, self.MAX_TENTATIVES + 1):
            octets_zip = self._avec_reprises(f"lecture du zip {file_id}", _telechargement)
            if hashlib.sha256(octets_zip).hexdigest() == sha256 and (taille is None or len(octets_zip) == taille):
                break
            if tentative < self.MAX_TENTATIVES:
                log_reseau_t.warning(f"[transit] zip {file_id} : empreinte différente de l'attendue "
                                     f"(tentative {tentative}/{self.MAX_TENTATIVES}), nouvelle lecture.")
                time.sleep(0.5 * tentative)
        else:
            raise TransitErreur(f"lecture du zip {file_id} : SHA-256/taille différents de ceux annoncés par l'expéditeur "
                                f"({len(octets_zip)} octets reçus) après {self.MAX_TENTATIVES} lectures.")
        t_telechargement = time.time() - t2
        nom, contenu = self.depaqueter(octets_zip)
        self._local.etapes_lecture = {"client_drive_s": round(t_client, 3), "telechargement_drive_s": round(t_telechargement, 3),
                                      "verification_s": round(time.time() - t0 - t_client - t_telechargement, 3)}
        log_reseau_t.info(f"[transit] lu {nom!r} : {len(contenu)} octets en {time.time() - t0:.2f}s {self._local.etapes_lecture}")
        return nom, contenu

    def lire_requests_duree(self, file_id: str) -> float:
        """DIAGNOSTIC : durée d'un téléchargement du zip avec la bibliothèque 'requests' (autre pile réseau que httplib2)."""
        from google.auth.transport.requests import AuthorizedSession
        self._service()
        t0 = time.time()
        r = AuthorizedSession(self._local.creds).get(f"https://www.googleapis.com/drive/v3/files/{file_id}?alt=media")  # volontairement NEUVE (cas le pire)
        r.raise_for_status()
        return round(time.time() - t0, 3)

    def etapes_lecture(self) -> dict:
        """Chronométrage de la dernière lecture faite PAR CE THREAD."""
        return dict(getattr(self._local, "etapes_lecture", {}) or {})

    def latence_drive(self) -> dict:
        """Latence brute de Drive depuis cette machine, sans aucune donnée : construction du client, premier appel
        (TLS + jeton d'accès), puis aller-retour d'un appel minuscule (médiane de 3)."""
        t0 = time.time()
        service = self._service()
        t_client = time.time() - t0
        t0 = time.time()
        service.about().get(fields="kind").execute()
        t_premier = time.time() - t0
        rtts = []
        for _ in range(3):
            t0 = time.time()
            service.about().get(fields="kind").execute()
            rtts.append(time.time() - t0)
        return {"client_s": round(t_client, 3), "premier_appel_s": round(t_premier, 3), "aller_retour_s": round(sorted(rtts)[1], 3)}

    # ---------------------------------------------------------------------------------------------
    # Hygiène (spec 7.6) : Drive garde les anciennes révisions d'un fichier écrasé
    # ---------------------------------------------------------------------------------------------
    def nettoyer_revisions(self, file_id: str) -> int:
        """Supprime toutes les révisions de `file_id` sauf la plus récente. Meilleur effort : retourne le nombre
        supprimé, ne lève jamais (une révision non supprimable est simplement ignorée)."""
        supprimees = 0
        if getattr(self, "_revisions_interdites", False):
            return 0                       # le compte de service n'a pas le droit de supprimer des révisions : inutile de réessayer
        try:
            service = self._service()
            revisions, page = [], None
            while True:
                reponse = service.revisions().list(
                    fileId=file_id, fields="nextPageToken, revisions(id, modifiedTime)", pageSize=200, pageToken=page,
                ).execute()
                revisions.extend(reponse.get("revisions", []))
                page = reponse.get("nextPageToken")
                if not page:
                    break
            revisions.sort(key=lambda r: r.get("modifiedTime", ""))
            for r in revisions[:-1]:
                try:
                    service.revisions().delete(fileId=file_id, revisionId=r["id"]).execute()
                    supprimees += 1
                except Exception as e:
                    if getattr(getattr(e, "resp", None), "status", None) == 403:
                        # CORRECTIF : chaque suppression refusée (403 insufficientFilePermissions) était suivie de centaines d'autres
                        # (~1 appel/s pendant des minutes après chaque dépôt). Au 1er refus on arrête et on désactive le nettoyage.
                        self._revisions_interdites = True
                        log_reseau_t.warning(f"[transit] suppression de révisions refusée (403) sur {file_id} : nettoyage des révisions "
                                             f"désactivé pour cette session (le compte de service n'a pas ce droit).")
                        break
                    log_reseau_t.debug(f"[transit] révision {r.get('id')} de {file_id} non supprimée : {e!r}")
        except Exception as e:
            log_reseau_t.warning(f"[transit] nettoyage des révisions de {file_id} impossible : {e!r}")
        return supprimees

    def _nettoyer_revisions_en_fond(self, file_id: str) -> None:
        with self._verrou_nettoyage:
            if file_id in self._nettoyages_en_cours:
                return
            self._nettoyages_en_cours.add(file_id)

        def _tache():
            try:
                self.nettoyer_revisions(file_id)
            finally:
                with self._verrou_nettoyage:
                    self._nettoyages_en_cours.discard(file_id)

        threading.Thread(target=_tache, name="transit-revisions", daemon=True).start()


class GestionnaireStockageDriveDirect:
    """Client Drive AUTONOME côté AutoniaX (mAutoniax), symétrique de
    GestionnaireStockageBB côté serveur.py -- AUCUNE dépendance à
    ClientServeurT/websocket : utilise _ClientDriveMinimal directement,
    exactement comme le fait déjà serveur.py pour écrire dans ce même
    dossier racine, et comme le fait le notebook ServeurT Manager pour
    lire serveur.py. Instanciation de _ClientDriveMinimal (import
    paresseux des libs Google à l'intérieur de son __init__) -- même
    patron défensif que boto3 avant cette migration ; l'erreur ne
    remonte qu'au moment réel de l'appel, avec un message clair (cf.
    ses appelants, PousserDriveWorker._executer (cf. GitScreen._pousser_
    vers_drive) et resoudre_url_serveurt)."""

    def __init__(self, reglages: Optional["ReglagesApp"] = None):
        reglages = reglages or ReglagesApp.load()
        self._client = _ClientDriveMinimal(
            chemin_cle_json=reglages.drive_chemin_cle_json_resolu,
            dossier_racine_id=reglages.drive_dossier_racine_id,
        )

    # AJOUT (migration "Mettre à jour" vers Drive direct -- point ouvert
    # 3 de la spec, tranché : retry demandé explicitement par
    # l'utilisateur) -- nombre de tentatives et paliers de pause pour
    # tout appel bloquant put_object() de cette classe (envoyer_
    # serveur_py ET envoyer_fichier_vers_cloud, comportement UNIFORME
    # pour tout le Flux A/B). Un put_object Drive direct est un seul
    # appel HTTP synchrone sans reprise partielle en cas de coupure --
    # ce retry couvre les échecs transitoires (coupure réseau
    # momentanée, erreur 5xx/quota Google passagère), PAS un remplacement
    # du protocole de reprise par chunks retiré par cette migration :
    # chaque tentative renvoie l'intégralité du fichier depuis le début
    # (jamais de reprise partielle au milieu d'un upload).
    MAX_TENTATIVES_UPLOAD_CLOUD = 3
    PAUSE_INITIALE_RETRY_UPLOAD_SECONDES = 1.0

    def _put_object_avec_retry(self, cle: str, contenu: bytes, progression_callback=None) -> None:
        """Appelle self._client.put_object(Key=cle, Body=contenu) avec
        jusqu'à MAX_TENTATIVES_UPLOAD_CLOUD tentatives, backoff
        exponentiel entre chaque (1s, 2s, 4s -- cf. PAUSE_INITIALE_
        RETRY_UPLOAD_SECONDES) en cas d'exception. Bloquant (comme
        put_object lui-même) -- à appeler depuis un threadpool
        (run_in_executor), jamais directement sur la boucle asyncio,
        même précaution que le reste de cette classe. Relève la
        DERNIÈRE exception rencontrée si toutes les tentatives échouent
        -- aucun repli silencieux, l'appelant UI doit voir l'échec final.

        progression_callback (BUGFIX barre de progression disparue,
        cf. docstring de _ClientDriveMinimal.put_object) -- transmis tel
        quel à CHAQUE tentative ; une tentative qui échoue en cours de
        route peut donc avoir déjà rapporté une progression partielle
        avant de repartir de 0% au retry suivant (chaque tentative
        renvoie l'intégralité du fichier depuis le début, cf. commentaire
        de classe -- pas une reprise partielle)."""
        derniere_exception: Optional[Exception] = None
        for tentative in range(1, self.MAX_TENTATIVES_UPLOAD_CLOUD + 1):
            try:
                self._client.put_object(Key=cle, Body=contenu, progression_callback=progression_callback)
                return
            except Exception as e:
                derniere_exception = e
                if tentative < self.MAX_TENTATIVES_UPLOAD_CLOUD:
                    pause = self.PAUSE_INITIALE_RETRY_UPLOAD_SECONDES * (2 ** (tentative - 1))
                    log_reseau_t.warning(
                        f"Échec upload Drive '{cle}' (tentative {tentative}/"
                        f"{self.MAX_TENTATIVES_UPLOAD_CLOUD}) : {e!r} -- nouvel essai dans {pause:.0f}s."
                    )
                    time.sleep(pause)
        raise derniere_exception

    def envoyer_serveur_py(self, contenu: bytes, progression_callback=None) -> None:
        """Écrase ServeurT/serveur.py sur Drive avec `contenu`, puis marque
        ServeurT/stat.json {"updated": true} -- c'est CE flag que le
        notebook ServeurT Manager sonde toutes les 10s (cf. requête
        initiale : "mon notebbook serveur vas verifier toute les 10
        seconde si le fichier a ete modifier sur BB, si cest le cas
        alors sa vas retelechargez le fichier serveurT et lexecuter") pour
        savoir qu'il doit retélécharger et relancer. Lève l'exception
        Drive/réseau telle quelle en cas d'échec APRÈS retry (cf.
        _put_object_avec_retry) -- à charge de l'appelant UI de
        l'afficher (aucun repli silencieux voulu ici : un échec d'upload
        doit être visible).

        progression_callback (BUGFIX barre de progression disparue) --
        appliqué seulement au fichier lui-même (potentiellement gros,
        cf. serveur.py), jamais au petit stat.json qui suit (upload
        quasi instantané, une progression dessus n'aurait aucun intérêt
        visuel)."""
        self._put_object_avec_retry(DRIVE_CLE_SCRIPT_SERVEUR, contenu, progression_callback=progression_callback)
        contenu_stat = json.dumps({"updated": True}).encode("utf-8")
        self._put_object_avec_retry(DRIVE_CLE_STAT, contenu_stat)

    def envoyer_fichier_vers_cloud(self, cle: str, contenu: bytes, progression_callback=None) -> None:
        """AJOUT -- migration "Mettre à jour" vers Drive direct (plus
        aucun octet de fichier via serveur.py, demande explicite
        utilisateur : "mAutoniax upload directement ... Les 5 (autoniax,
        mouse_data, project, service_api, serveur_t) : tout en upload
        direct Drive"). Upload DIRECT (plus de passage par serveur.py) :
        écrase le contenu à la clé Drive donnée. Symétrique de
        telecharger_vers_fichier. Bloquant (appel googleapiclient
        synchrone) -- à appeler depuis un threadpool (run_in_executor),
        jamais directement sur la boucle asyncio, même précaution que
        telecharger_vers_fichier/_telecharger_fichier. Retry avec
        backoff exponentiel via _put_object_avec_retry (cf. sa
        docstring) ; lève l'exception Drive/réseau telle quelle si
        toutes les tentatives échouent (même convention que
        envoyer_serveur_py).

        progression_callback (BUGFIX barre de progression disparue,
        cf. docstring de _ClientDriveMinimal.put_object pour le détail
        complet de la cause racine -- resumable=False) : transmis tel
        quel jusqu'à put_object, appelé après chaque chunk avec le
        pourcentage 0-100 déjà envoyé."""
        self._put_object_avec_retry(cle, contenu, progression_callback=progression_callback)

    def forcer_redemarrage_serveurt(self) -> None:
        """AJOUT -- bouton "Redémarrer le serveurT" (ParametresScreen,
        section Serveur central) : marque ServeurT/stat.json
        {"updated": true} SANS toucher à ServeurT/serveur.py -- même
        flag exactement que envoyer_serveur_py() ci-dessus, mais sans
        réécrire le code. Le notebook ServeurT Manager, en le sondant
        (toutes les 10s), retélécharge un serveur.py IDENTIQUE à celui
        déjà en place puis relance le process -- c'est ce redémarrage
        (nouveau process, nouveau tunnel Cloudflare, nouvelle URL
        réécrite dans url_tunnel.txt par le notebook lui-même) qui est
        l'effet recherché ici, pas une mise à jour de code.

        Toute connexion websocket active (mAutoniax local + tout
        sAutoniax distant) sera coupée le temps du redémarrage --
        ClientServeurT._boucle_async retente déjà indéfiniment toutes
        les 10s (cf. sa docstring) et relira resoudre_url_serveurt() à
        CHAQUE tentative, donc se reconnectera de lui-même dès que le
        nouveau tunnel sera prêt et sa nouvelle URL publiée sur Drive --
        aucune action supplémentaire nécessaire côté client après cet
        appel. Lève l'exception Drive/réseau telle quelle, même
        convention que envoyer_serveur_py (échec visible, pas de repli
        silencieux)."""
        contenu_stat = json.dumps({"updated": True}).encode("utf-8")
        self._client.put_object(Key=DRIVE_CLE_STAT, Body=contenu_stat)

    def lire_url_tunnel(self) -> str:
        """Lit ServeurT/url_tunnel.txt via DriveStockage. Retourne la
        chaîne décodée telle quelle (peut être vide -- c'est l'appelant,
        resoudre_url_serveurt, qui distingue ce cas). Lève DriveNoSuchKey
        si le fichier n'existe pas encore (cf. son appelant, qui traite
        ça comme une URL vide)."""
        reponse = self._client.get_object(Key=DRIVE_CLE_URL_TUNNEL)
        return reponse["Body"].read().decode("utf-8").strip()

    def telecharger_vers_fichier(self, cle: str, chemin_destination: str, callback_progression=None) -> None:
        """AJOUT -- téléchargement DIRECT depuis Drive vers un fichier
        local, SANS passer par serveur.py (demande explicite
        utilisateur : "je ne veux plus que le telechargement passe par
        le serveur ... sa doit etre direct au cloud", les identifiants
        de service Drive étant déjà présents localement, cf.
        drive_chemin_cle_json_resolu). Utilisé par ClientServeurT.
        _telecharger_fichier (cf. sa docstring) comme mécanisme
        PRINCIPAL désormais, avec repli sur l'ancien chemin HTTP/
        WebSocket via serveur.py uniquement en cas d'échec (ex. clé de
        service absente/invalide, fichier réellement introuvable sur
        Drive). Bloquant (appels googleapiclient synchrones) -- à
        appeler depuis un threadpool (run_in_executor), jamais
        directement sur la boucle asyncio, même précaution que
        _telecharger_fichier_via_http_bloquant."""
        self._client.telecharger_objet_vers_fichier(
            Key=cle, chemin_destination=chemin_destination, callback_progression=callback_progression,
        )


def resoudre_url_serveurt() -> str:
    """Lit ServeurT/url_tunnel.txt sur Drive (via GestionnaireStockageDrive
    Direct.lire_url_tunnel) et retourne l'URL WebSocket du serveurT courant.

    AUCUN repli vers une adresse en dur (décision explicite utilisateur
    conservée de l'ère B2 : "faut faire a ce que sa essai plutot de lire
    la BB, fenant ne met plus ce replie idiot vers render") -- si la
    lecture échoue ou si le fichier est vide/absent (coupure réseau,
    clé de service invalide/manquante, dossier racine mal configuré,
    fichier pas encore créé côté notebook ServeurT Manager...), cette
    fonction LÈVE une RuntimeError explicite plutôt que de retourner une
    adresse par défaut. Tous ses appelants (cf. ClientServeurT.
    _boucle_async) DOIVENT attraper cette exception et la traiter comme
    un échec de connexion ordinaire (nouvel essai après DELAI_RETRY_
    SECONDES), exactement comme un timeout réseau.

    Le contenu du fichier est une URL WebSocket telle quelle (ex.
    "wss://xyz123.trycloudflare.com/ws") -- ÉCRITE PAR LE NOTEBOOK
    ServeurT Manager lui-même (PAS par serveur.py, cf. son commentaire de
    tête : le serveur derrière un Quick Tunnel ne connaît pas sa propre
    URL publique, seul cloudflared la génère côté notebook)."""
    try:
        contenu = GestionnaireStockageDriveDirect().lire_url_tunnel()
        if contenu:
            return contenu
        raise RuntimeError("ServeurT/url_tunnel.txt est vide sur Drive -- le notebook ServeurT Manager n'a probablement encore rien publié.")
    except DriveNoSuchKey:
        raise RuntimeError("ServeurT/url_tunnel.txt est introuvable sur Drive -- le notebook ServeurT Manager n'a probablement pas encore démarré.")
    except RuntimeError:
        raise
    except Exception as e:
        raise RuntimeError(f"Lecture de l'URL tunnel sur Drive échouée ({e!r}) -- vérifie que le notebook ServeurT Manager tourne, et que la clé de service/le dossier racine sont correctement configurés.") from e

