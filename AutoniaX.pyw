        titre_label = QLabel("Composants importés", header)
        titre_label.setObjectName("ReglagesLabel")
        header_layout.addWidget(titre_label, 1)
        self._titre_label = titre_label

        self.import_button = QToolButton(header)
        self.import_button.setObjectName("APIFeaturesMenuButton")
        self.import_button.setIcon(qta.icon("mdi6.plus", color=Mocha.subtext0))
        self.import_button.setIconSize(QSize(18, 18))
        self.import_button.setCursor(Qt.PointingHandCursor)
        self.import_button.setToolTip("Importer un ServiceAPI")
        self.import_button.clicked.connect(self.demande_import_service_api.emit)
