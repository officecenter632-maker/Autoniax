        self.champ_requirements.setObjectName("GitRequirementsEdit")
        self.champ_requirements.setPlainText(self._lire_fichier_requirements())
        self.champ_requirements.setFixedHeight(110)
        self.champ_requirements.setPlaceholderText("une dépendance par ligne, ex. fastapi==0.141.1")
        self.champ_requirements.textChanged.connect(self._sur_requirements_modifie)
        self.champ_requirements.hide()
        # Écrit immédiatement le pré-remplissage sur disque si le fichier
        # n'existe pas encore (setPlainText ci-dessus a déjà déclenché
        # textChanged normalement, mais on force explicitement pour ne
        # jamais dépendre de l'ordre des signaux Qt) -- sans ça,
        # requirements.txt ne serait écrit qu'à la première frappe de
        # l'utilisateur, et pourrait manquer du premier push si le
        # contenu par défaut convient déjà tel quel.
        if not self._chemin_fichier_requirements().exists():
            self._sur_requirements_modifie()
        depot_layout.addWidget(self.champ_requirements)

        # Bouton "Pousser" centré sous l'éditeur (PATCH : "je veux que le
        # bouton de push soit en bas de lediteur au centre") -- stretchs
        # de part et d'autre pour le centrer horizontalement sans lui
        # faire prendre toute la largeur.
        bouton_row = QHBoxLayout()
        bouton_row.addStretch(1)
        self.bouton_pousser = QPushButton(
            qta.icon("mdi6.source-branch", color=Mocha.text), " Pousser les changements", self.bloc_depot,
        )
        self.bouton_pousser.setObjectName("UpdateImageButton")
        self.bouton_pousser.setCursor(Qt.PointingHandCursor)
        self.bouton_pousser.clicked.connect(self._pousser_changements)
        bouton_row.addWidget(self.bouton_pousser)
        # PATCH (migration Render -> Colab+tunnel -- demande explicite
        # utilisateur : "je vais vraiment continuer a pusher sur gtihbu
        # tu vas juste rajouter les 3 autre onglet" + "quand je clic sur
        # mise a jour ... sa envoie sur mon cloud BB") -- bouton
        # INDÉPENDANT du push GitHub ci-dessus (celui-ci reste inchangé,
        # géré manuellement par l'utilisateur) : envoie serveur.py vers
        # ServeurT/serveur.py sur Drive. CORRECTIF -- appel Drive
        # DIRECT et local à cet écran (cf. _pousser_vers_drive /
        # GestionnaireStockageDriveDirect), plus aucun passage par
        # ClientServeurT/websocket : l'ancien câblage exigeait une
        # connexion serveurT active, ce qui est structurellement
        # impossible tant que serveur.py n'est pas encore sur Drive.
        #
        # RENOMMAGE (bouton/variables/méthode : ancien nom "BB"/B2 --
        # vestige de l'ère Backblaze B2, abandonnée lors de la
        # "MIGRATION TOTALE B2 -> Google Drive", cf. commentaire de
        # REQUIREMENTS_PAR_DEFAUT ci-dessus) -- le code appelle depuis
        # longtemps déjà _ClientDriveMinimal/GestionnaireStockageDriveDirect
        # (Google Drive), plus rien à voir avec B2 : bouton_pousser_bb ->
        # bouton_pousser_drive, _pousser_vers_bb_direct -> _pousser_vers_drive,
        # texte/tooltip alignés sur "Drive" pour ne plus induire en erreur.
        #
        # CORRECTIF (blocage UI signalé -- appel Drive synchrone
        # directement sur le thread GUI, même défaut déjà corrigé côté
        # serveur.py pour l'event loop asyncio, cf. GestionnaireStockage/
        # _a_thread) : _ClientDriveMinimal.put_object/get_object sont des
        # appels HTTP bloquants (googleapiclient.discovery.build(...)
        # .execute(), sans await/thread) -- les exécuter directement dans
        # _pousser_vers_drive gelait toute la fenêtre mAutoniax pendant
        # tout l'envoi. Déporté dans un QThread dédié (PousserDriveWorker,
        # même patron EXACT que TestProxyWorker plus bas dans ce fichier :
        # QObject + moveToThread + signaux demande_*/*_pret) -- le clic ne
        # fait plus qu'émettre un signal, le résultat revient de façon
        # asynchrone via un slot qui remet à jour le label de statut.
        self._thread_pousser_drive = QThread(self)
        self._worker_pousser_drive = PousserDriveWorker()
        self._worker_pousser_drive.moveToThread(self._thread_pousser_drive)
        self._thread_pousser_drive.start()
        self._worker_pousser_drive.resultat_pret.connect(self._sur_resultat_pousser_drive)

        self.bouton_pousser_drive = QPushButton(
            qta.icon("mdi6.cloud-upload-outline", color=Mocha.text), " Envoyer vers Drive", self.bloc_depot,
        )
        self.bouton_pousser_drive.setObjectName("UpdateImageButton")
        self.bouton_pousser_drive.setCursor(Qt.PointingHandCursor)
        self.bouton_pousser_drive.setToolTip(
            "Envoie serveur.py vers ServeurT/ sur Google Drive (appel Drive direct, "
            "indépendant du serveurT) -- le notebook \"ServeurT Manager\" le détecte "
            "(stat.json) et redémarre automatiquement le serveur avec cette version."
        )
        self.bouton_pousser_drive.clicked.connect(self._pousser_vers_drive)
        bouton_row.addWidget(self.bouton_pousser_drive)
        bouton_row.addStretch(1)
        depot_layout.addLayout(bouton_row)

        self.label_statut_push = QLabel("", self.bloc_depot)
        self.label_statut_push.setWordWrap(True)
        self.label_statut_push.setAlignment(Qt.AlignCenter)
        self.label_statut_push.setObjectName("PlaceholderSubtitle")
        depot_layout.addWidget(self.label_statut_push)

        layout.addWidget(self.bloc_depot, 1)

        self._rafraichir_visibilite_blocs()

        self.sous_onglets.addTab(self.sous_onglet_serveur, "serveur.py")

        # CORRECTIF -- ServeurT Manager et sAutoniax Manager, déplacés ici
        # depuis leur ancienne place en onglets de PREMIER NIVEAU de
        # ReseauScreen (cf. son ancien câblage) : ce sont maintenant des
