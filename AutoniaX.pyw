def _test_patch2():
    """
    Crée des objets du modèle, sauvegarde en JSON dans un fichier de test
    (séparé de project.json pour ne pas polluer de vraies données), recharge,
    et vérifie que rien n'est perdu. Affiche le résultat en console.

    Mis à jour après la refonte Action/BibliothequeActions (Feature,
    APIFeatures, ComposantRef ont été entièrement retirés du modèle --
    décision explicite utilisateur : les Actions sont désormais des
    fonctions natives globales au Project, plus liées à un ServiceAPI).
    """
    print(f"Dossier de données AutoniaX : {get_app_data_dir()}")

    # 1. Construire un petit projet de test
    composant = Composant(
        nom="Word-BoutonEnregistrer",
        service_api_nom="Word",
        variantes=["components/Word/Word-BoutonEnregistrer.png"],
        priorite_selection="mostTop",
        seuil_confiance=0.85,
    )

    service_api = ServiceAPI(nom="Word", composants=[composant.nom])

    action1 = Action(
        type_action="clic",
        composant_reference="Word-BoutonEnregistrer",
        bouton_clic="gauche",
        zone_clic_mode="par_defaut",
    )
    bibliotheque_actions = BibliothequeActions(
        actions=[action1],
        variables=[Variable(nom="var1")],
    )
    project = Project(
        services_api=[service_api],
        composants=[composant],
        bibliotheque_actions=bibliotheque_actions,
    )

    # 2. Sauvegarder dans un fichier de test dédié
    test_path = get_app_data_dir() / "project_test.json"
    project.save(test_path)
    print(f"Projet de test sauvegardé : {test_path}")

    # 3. Recharger et comparer
    reloaded = Project.load(test_path)

    checks = [
        ("nombre de services API", len(reloaded.services_api) == 1),
        ("nombre de composants", len(reloaded.composants) == 1),
        ("nom du composant", reloaded.composants[0].nom == "Word-BoutonEnregistrer"),
        ("seuil de confiance", reloaded.composants[0].seuil_confiance == 0.85),
        ("composants du ServiceAPI", reloaded.services_api[0].composants == ["Word-BoutonEnregistrer"]),
        ("nombre d'actions (bibliothèque globale)", len(reloaded.bibliotheque_actions.actions) == 1),
        ("type de l'action", reloaded.bibliotheque_actions.actions[0].type_action == "clic"),
        ("composant référencé par l'action", reloaded.bibliotheque_actions.actions[0].composant_reference == "Word-BoutonEnregistrer"),
        ("bouton de clic de l'action", reloaded.bibliotheque_actions.actions[0].bouton_clic == "gauche"),
        ("nombre de variables (bibliothèque globale)", len(reloaded.bibliotheque_actions.variables) == 1),
        ("nom de la variable", reloaded.bibliotheque_actions.variables[0].nom == "var1"),
    ]

    print("\nRésultat des vérifications :")
    all_ok = True
    for label, ok in checks:
        status = "OK" if ok else "ÉCHEC"
        if not ok:
            all_ok = False
        print(f"  [{status}] {label}")

    print("\n" + ("TOUT EST OK — rien n'est perdu à la sauvegarde/rechargement." if all_ok else "DES DIFFÉRENCES ONT ÉTÉ DÉTECTÉES."))

    # Nettoyage du fichier de test
    test_path.unlink(missing_ok=True)
    print(f"Fichier de test supprimé : {test_path}")



