class InstanceExecutable:
    """Wrapper d'exécution autour d'une instance (nodriver) déjà liée.
    Ne s'instancie normalement PAS directement depuis un script Task --
    on l'obtient via ServiceAPIExecutable.instance() (cf. cette classe,
    exposée dans le namespace sous le nom du ServiceAPI, ex: Word), qui
    résout automatiquement l'instance_id lié à ce ServiceAPI DANS CE
    TASK. Constructeur encore utilisable directement (instance_id,
    moteur) si besoin, mais sans intérêt en usage normal.

    Méthodes disponibles (liste non exhaustive, cf. docstring de chacune) :
      - capture() : capture propre de l'instance (identique à celle
        utilisée pour la détection de Composant, cf. action_capture_propre),
        écrite en PNG sur disque (D:\\ScaleTube\\...\\Data\\projet\\captures\\) ;
        self.path pointe vers le dernier fichier écrit (None tant que
        capture() n'a pas encore été appelée au moins une fois).
      - get_presse_papier() : lit le texte actuellement présent dans le
        presse-papier DU NAVIGATEUR de cette instance (action_get_clipboard
        côté instance) -- ne déclenche AUCUNE copie elle-même, elle lit
        seulement ce qui s'y trouve déjà (ex: après un clic sur un bouton
        "copier" de la page).

    BUG CORRIGÉ (variable réutilisée d'une cellule à l'autre) : un script
    Task type "Instance = Word.instance()" dans une cellule d'init, puis
    "Instance.new_tab(...)" dans une AUTRE cellule exécutée séparément,
    stocke cet InstanceExecutable dans le namespace PERSISTANT du Task
    (cf. TaskConfigScreen._namespace_task -- comme un vrai notebook).
    L'ancien code figeait moteur=MoteurExecutionCellule DE LA CELLULE QUI
    A FAIT L'AFFECTATION, à la construction -- ce moteur est ensuite
    déconnecté de ses signaux réseau (command_result_recu etc.) à la fin
    de CETTE cellule (cf. MoteurExecutionCellule._terminer). Toute méthode
    appelée depuis une cellule suivante réutilisait donc un moteur mort :
    la commande partait bien (client_reseau partagé) et le serveur
    répondait bien, mais plus personne n'écoutait la réponse -> timeout
    complet (TIMEOUT_COMMANDE_MS, 15s) à chaque fois, alors même que les
    logs montraient un command_result ok=True reçu en moins d'une seconde
    côté réseau.

    Corrigé en acceptant, en plus d'un MoteurExecutionCellule direct
    (compat -- utilisé par ex. côté MoteurExecutionTaskHeadless, où il
    n'existe qu'UN SEUL moteur pour tout le Task, jamais remplacé en
    cours de route), un RÉSOLVEUR (callable sans argument -> moteur
    courant), interrogé à CHAQUE appel de méthode via _moteur_effectif()
    plutôt que figé une fois pour toutes. cf.
    TaskConfigScreen._moteur_courant_par_task, mis à jour à l'entrée/
    sortie de chaque _executer_cellule -- pointe donc toujours vers le
    moteur de la DERNIÈRE cellule en cours d'exécution pour ce Task, quel
    que soit le moteur actif au moment de la construction de cet
    InstanceExecutable."""

    def __init__(self, instance_id: str, moteur, namespace: Optional[dict] = None):
        """moteur : soit un MoteurExecutionCellule direct (comportement
        historique, toujours valide), soit un callable sans argument
        renvoyant le MoteurExecutionCellule courant (cf. docstring de
        classe ci-dessus) -- résolu paresseusement à chaque appel de
        méthode, jamais figé ici.

        namespace (AJOUT -- demande explicite utilisateur : new_tab()
        doit "presque avoir les meme parametre que les methode de
        composant que lon vient dajouter", donc résoudre RETRY/TIMEOUT/
        LATENCE_AVANT/LATENCE_APRES depuis la même cellule "Variable
        statique" du notebook -- cf. ComposantExecutable._global_defaut,
        MÊME mécanisme et mêmes noms de variable réutilisés ici, pas de
        variables séparées propres à InstanceExecutable) : référence vers
        le dict PARTAGÉ passé à exec() pour toutes les cellules de ce
        Task. None accepté (usages hors notebook réel, ex. construction
        directe par un script Task via InstanceExecutable(...)) --
        _global_defaut() retombe alors sur le défaut du système, comme
        pour ComposantExecutable."""
        self.instance_id = instance_id
        self._moteur_ou_resolveur = moteur
        self._namespace = namespace
        self.path: Optional[str] = None

    def __repr__(self) -> str:
        return f"InstanceExecutable({self.instance_id!r})"

    def _global_defaut(self, nom_variable: str, valeur_systeme):
        """Même mécanisme que ComposantExecutable._global_defaut (cf. sa
        docstring) -- réutilisé tel quel ici plutôt que dupliqué, pour que
        RETRY/TIMEOUT/LATENCE_AVANT/LATENCE_APRES restent EXACTEMENT les
        mêmes variables globales, qu'on les lise depuis un Composant ou
        depuis une Instance du même Task."""
        if self._namespace is None:
            return valeur_systeme
        return self._namespace.get(nom_variable, valeur_systeme)

    def _moteur_effectif(self) -> "MoteurExecutionCellule":
        """Résout le moteur à utiliser POUR CET APPEL précis (jamais mis
        en cache sur self) -- cf. docstring de classe pour la raison
        d'être de cette indirection."""
        moteur = self._moteur_ou_resolveur
        if callable(moteur) and not hasattr(moteur, "_appeler"):
            # Résolveur (fonction/lambda), pas un MoteurExecutionCellule
            # directement -- distingué par l'absence de _appeler (un
            # MoteurExecutionCellule n'est pas appelable lui-même).
            moteur = moteur()
        if moteur is None:
            raise RuntimeError(
                f"Aucune exécution en cours pour résoudre l'instance « {self.instance_id} » -- "
                "cette variable a été créée par une cellule précédente et aucune cellule de ce "
                "Task n'est actuellement en cours d'exécution."
            )
        return moteur

    def capture(self, timeout: Optional[float] = None) -> str:
        """capture() -- capture propre de l'instance (toute la page/
        fenêtre pilotée, sans le curseur virtuel), écrite en PNG sur
        disque. Met à jour self.path ET le retourne (pratique pour un
        usage en une ligne, ex: chemin = mon_instance.capture()).
        Lève RuntimeError si la capture échoue côté instance ou si
        l'image reçue est invalide/vide.

        timeout (défaut None -> lit TIMEOUT de la cellule "Variable
        dynamique", 5.0s fixe côté instance si absente/None, comportement
        historique -- EN SECONDES) : AJOUT (même correctif que
        ComposantExecutable._detecter/visible -- "detecter doit prendre
        le timeout de celui qui l'appelle") : capture() n'avait
        auparavant aucun moyen de dépasser le timeout interne fixe de
        5.0s côté instance."""
        timeout = timeout if timeout is not None else self._global_defaut("TIMEOUT", None)
        params = {"timeout_action_s": timeout} if timeout is not None else {}
        reponse = self._moteur_effectif()._appeler(self.instance_id, "capture_propre", params, timeout=timeout)
        if not reponse.get("ok"):
            raise RuntimeError(f"Échec de capture pour l'instance « {self.instance_id} » : {reponse.get('error')}")
        image_b64 = reponse.get("result", {}).get("image_b64")
        image = decoder_image_b64(image_b64) if image_b64 else None
        if image is None:
            raise RuntimeError(f"Capture invalide reçue pour l'instance « {self.instance_id} ».")
        nom_fichier = f"{self.instance_id}_{uuid.uuid4().hex[:8]}.png"
        chemin = get_captures_dir() / nom_fichier
        if not image.save(str(chemin), "PNG"):
            raise RuntimeError(f"Échec d'écriture de la capture sur disque : {chemin}")
        self.path = str(chemin)
        return self.path

    def capture_b64(self, qualite: int = 70, timeout: Optional[float] = None) -> str:
        """capture_b64(qualite=70) -- MÊME capture que capture() et que le bouton de capture du notebook (action « capture_propre »),
        mais retournée en base64 (WebP qualité `qualite`, PNG si Pillow est absent) au lieu d'être écrite sur disque. Indispensable
        sur un sAutoniax : le disque où capture() écrit est celui du clone, pas celui du PC -- l'image doit voyager dans la valeur
        de retour. Lève RuntimeError si la capture échoue."""
        timeout = timeout if timeout is not None else self._global_defaut("TIMEOUT", None)
        params = {"timeout_action_s": timeout} if timeout is not None else {}
        reponse = self._moteur_effectif()._appeler(self.instance_id, "capture_propre", params, timeout=timeout)
        if not reponse.get("ok"):
            raise RuntimeError(f"Échec de capture pour l'instance « {self.instance_id} » : {reponse.get('error')}")
        image_b64 = reponse.get("result", {}).get("image_b64")
        if not image_b64 or decoder_image_b64(image_b64) is None:
            raise RuntimeError(f"Capture invalide reçue pour l'instance « {self.instance_id} ».")
        return _compresser_capture_webp(image_b64, int(qualite))

    def get_presse_papier(self) -> str:
        """get_presse_papier() -- retourne le texte actuellement présent
        dans le presse-papier du navigateur de cette instance. Ne
        déclenche aucune copie : lit simplement ce qui s'y trouve déjà.
        Chaîne vide si rien n'est copié ou si la lecture échoue."""
        reponse = self._moteur_effectif()._appeler(self.instance_id, "get_clipboard", {})
        if not reponse.get("ok"):
            raise RuntimeError(f"Échec de lecture du presse-papier pour l'instance « {self.instance_id} » : {reponse.get('error')}")
        valeur = reponse.get("result")
        return valeur if isinstance(valeur, str) else ""

    def get_derniere_reponse_assistant(self, selecteur: str,
                                         retry: Optional[int] = None, timeout: Optional[float] = None) -> str:
        """get_derniere_reponse_assistant(selecteur) -- lit directement le
        DOM (document.querySelectorAll(selecteur), dernier élément trouvé)
        pour en extraire le texte affiché, SANS passer par le presse-papier
        ni le bouton "Copy" -- contourne entièrement navigator.clipboard.
        write()/writeText() (cf. diagnostic transient-activation : un clic
        synthétique peut ne jamais déclencher ces API sur certains
        environnements, ex. sAutoniax/Kaggle alors que le même clic
        fonctionne en local).

        selecteur : OBLIGATOIRE, PAS de valeur par défaut -- décision
        explicite (retour utilisateur : le sélecteur doit être écrit et
        assumé DANS le code de la cellule, jamais implicite dans cette
        méthode). Un défaut caché ici deviendrait silencieusement faux dès
        que la structure DOM du site ciblé change -- charge à l'auteur de
        la cellule d'inspecter le DOM réel de la page ciblée et de fournir
        le sélecteur exact, ex. pour ChatGPT (structure confirmée par
        inspection DOM au 24/09) : '[data-assistant-markdown]' -- attribut
        posé directement sur le <div> qui n'enveloppe QUE le contenu
        généré par le modèle, jamais sur un message tapé par l'utilisateur.
        Ne PAS passer par l'ancêtre [data-message-author-role="assistant"]
        (essayé d'abord, abandonné) : cet ancêtre est le <li> de tout le
        tour de conversation (attribution "ChatGPT said:" + boutons
        "Response actions" inclus dans son texte), et sa position exacte
        dans l'arbre par rapport à [data-assistant-markdown] s'est révélée
        varier d'une conversation à l'autre -- inutile de dépendre de cette
        relation d'ancêtre quand l'attribut ciblé seul suffit déjà à isoler
        précisément le bon contenu.

        retry (défaut None -> lit RETRY de la cellule "Variable dynamique",
        0 si absente/None) : contrairement à get_presse_papier() (toujours
        un seul essai), un retry a du sens ici car le message peut encore
        être en streaming au moment de la première lecture.

        Statut vérifié EN PREMIER (reponse.get('ok')) avant toute lecture
        des données -- lève RuntimeError si la commande a échoué (élément
        introuvable, erreur JS) après épuisement des tentatives, même
        contrat que get_presse_papier(). Retourne le texte trouvé (chaîne
        vide si l'élément matché n'a pas de texte)."""
        retry_resolu = retry if retry is not None else self._global_defaut("RETRY", 0)
        timeout_resolu = timeout if timeout is not None else self._global_defaut("TIMEOUT", None)
        essais_total = 1 + max(0, retry_resolu)
        derniere_erreur = None
        for _ in range(essais_total):
            reponse = self._moteur_effectif()._appeler(self.instance_id, "get_last_assistant_message",
                                                         {"selecteur": selecteur}, timeout=timeout_resolu)
            if reponse.get("ok"):
                valeur = reponse.get("result")
                return valeur if isinstance(valeur, str) else ""
            derniere_erreur = reponse.get("error")
        raise RuntimeError(
            f"Échec de lecture de la dernière réponse assistant pour l'instance « {self.instance_id} » "
            f"(selecteur={selecteur!r}, après {essais_total} tentative(s)) : {derniere_erreur}"
        )

    def get_html(self, selecteur: Optional[str] = None,
                 retry: Optional[int] = None, timeout: Optional[float] = None,
                 cadre: Optional[str] = None) -> str:
        """get_html(selecteur=None) -- retourne le code HTML ACTUEL (DOM vivant,
        donc après exécution du JavaScript de la page) de l'ONGLET ACTIF de
        cette instance. Sans argument : document complet (doctype +
        <html>...</html>). Avec `selecteur` (sélecteur CSS, ex. "#main") :
        outerHTML du PREMIER élément trouvé.

        cadre : sélecteur CSS d'une <iframe> de MÊME origine (ex. "iframe.browse-frame") ;
        "a >>> b" pour des iframes imbriquées ; "auto" = la plus grande iframe accessible.
        Le HTML renvoyé est alors celui du document DE L'IFRAME (et `selecteur` s'y applique).
        Limites : sans `cadre`, le contenu des <iframe> n'est pas inclus ; les shadow DOM
        (même ouverts) ne sont jamais inclus. Lève RuntimeError si
        aucun élément ne correspond au sélecteur ou si la lecture échoue,
        après `retry` tentative(s) supplémentaire(s) (défaut : variable RETRY
        de la cellule, 0 si absente)."""
        retry_resolu = retry if retry is not None else self._global_defaut("RETRY", 0)
        timeout_resolu = timeout if timeout is not None else self._global_defaut("TIMEOUT", None)
        essais_total = 1 + max(0, retry_resolu)
        derniere_erreur = None
        for _ in range(essais_total):
            reponse = self._moteur_effectif()._appeler(self.instance_id, "get_html", {"selecteur": selecteur or "", "cadre": cadre or ""}, timeout=timeout_resolu)
            if reponse.get("ok"):
                valeur = reponse.get("result")
                return valeur if isinstance(valeur, str) else ""
            derniere_erreur = reponse.get("error")
        raise RuntimeError(
            f"Échec de lecture du HTML pour l'instance « {self.instance_id} » "
            f"(selecteur={selecteur!r}, cadre={cadre!r}, après {essais_total} tentative(s)) : {derniere_erreur}"
        )

    def _appel_brut(self, action: str, params: dict, timeout=None) -> dict:
        return self._moteur_effectif()._appeler(self.instance_id, action, params, timeout=timeout)

    def _localiser_element(self, selecteur: str, index: int, scroll: bool, timeout=None, cadre=None):
        """(element, erreur) -- l'élément d'index `index` parmi les éléments VISIBLES
        qui correspondent à `selecteur`, éventuellement amené à l'écran."""
        reponse = self._appel_brut("find_elements", {"selecteur": selecteur, "visibles": True, "cadre": cadre or "",
                                                      "index": int(index), "scroll": bool(scroll)}, timeout)
        if not reponse.get("ok"):
            return None, reponse.get("error")
        res = reponse.get("result") or {}
        elements = res.get("elements") or []
        if not elements:
            return None, (f"aucun élément visible d'index {index} pour {selecteur!r} "
                          f"({res.get('total', 0)} élément(s) visible(s) trouvé(s))")
        return elements[0], None

    def elements(self, selecteur: Optional[str] = None, limite: int = 100, visibles_seulement: bool = True,
                 retry: Optional[int] = None, timeout: Optional[float] = None,
                 cadre: Optional[str] = None) -> list:
        """elements(selecteur=None) -- liste les éléments de l'ONGLET ACTIF.
        Sans selecteur : éléments interactifs (liens, boutons, champs, select,
        [role=button]...). Avec un sélecteur CSS : tous les éléments qui y
        correspondent. Retourne une liste de dict : index, tag, id, name, type,
        role, texte, placeholder, valeur (vide pour un mot de passe), href,
        classe, selecteur (sélecteur CSS UNIQUE de cet élément), visible,
        couvert (recouvert par un autre élément), x, y (centre) et
        largeur/hauteur en pixels. `index` = position dans cette liste, la
        même que celle attendue par click_element()/remplir() (qui comptent
        les éléments visibles). `cadre` (sélecteur CSS d'une <iframe> de même origine, ou "auto") :
        liste les éléments DE L'IFRAME ; x, y restent des coordonnées de la fenêtre de l'onglet et
        `selecteur` est à repasser tel quel avec le même `cadre`. Exemple :
            for e in Instance.elements():
                print(e["index"], e["tag"], e["texte"], e["selecteur"])"""
        retry_resolu = retry if retry is not None else self._global_defaut("RETRY", 0)
        timeout_resolu = timeout if timeout is not None else self._global_defaut("TIMEOUT", None)
        essais_total = 1 + max(0, retry_resolu)
        derniere_erreur = None
        for _ in range(essais_total):
            reponse = self._appel_brut("find_elements", {"selecteur": selecteur or "", "limite": int(limite), "cadre": cadre or "",
                                                          "visibles": bool(visibles_seulement)}, timeout_resolu)
            if reponse.get("ok"):
                res = reponse.get("result")
                return list(res.get("elements", [])) if isinstance(res, dict) else []
            derniere_erreur = reponse.get("error")
        raise RuntimeError(f"Échec de elements() pour l'instance « {self.instance_id} » "
                           f"(selecteur={selecteur!r}, après {essais_total} tentative(s)) : {derniere_erreur}")

    def click_element(self, selecteur: str, index: int = 0, bouton: str = "gauche", nb_clics: int = 1,
                      duree_appui_ms: int = 60, speed_percent: float = 0, scroll: bool = True,
                      ignorer_couverture: bool = False, retry: Optional[int] = None,
                      timeout: Optional[float] = None, latence_avant: Optional[float] = None,
                      latence_apres: Optional[float] = None, cadre: Optional[str] = None) -> "ResultatAction":
        """click_element(selecteur, index=0, cadre=None) -- clique sur l'élément ciblé par un
        sélecteur CSS (ex. "#valider", "button[type=submit]", "a[href*=login]").
        L'élément est amené à l'écran (scroll=True), puis le clic part avec la
        trajectoire de souris HUMAINE habituelle, vers un point proche du
        centre. `index` : quel élément visible prendre si plusieurs
        correspondent (0 = le premier). Échec explicite (ResultatAction False)
        si l'élément est introuvable, invisible, ou recouvert par un autre
        (popup, bandeau) -- ignorer_couverture=True pour cliquer quand même.
        `cadre` : sélecteur CSS d'une <iframe> de même origine (ou "auto") -- le sélecteur s'applique
        alors DANS l'iframe (le clic reste un vrai clic souris, aux coordonnées de la fenêtre).
            r = Instance.click_element("button[type=submit]")
            if not r: print(r.message)"""
        retry = retry if retry is not None else self._global_defaut("RETRY", 0)
        timeout = timeout if timeout is not None else self._global_defaut("TIMEOUT", None)
        latence_avant = latence_avant if latence_avant is not None else self._global_defaut("LATENCE_AVANT", 0.0)
        latence_apres = latence_apres if latence_apres is not None else self._global_defaut("LATENCE_APRES", 0.0)
        essais_total = max(1, retry + 1)
        derniere_erreur = None
        for _ in range(essais_total):
            if latence_avant:
                time.sleep(latence_avant)
            el, erreur = self._localiser_element(selecteur, index, scroll, timeout, cadre)
            if el is None:
                derniere_erreur = erreur
                continue
            if el.get("couvert") and not ignorer_couverture:
                derniere_erreur = ("l'élément est recouvert par un autre élément (popup, bandeau...) ; "
                                   "ignorer_couverture=True pour cliquer quand même")
                continue
            x, y = _point_dans_element(el)
            params = {"x": x, "y": y, "bouton": bouton, "duree_appui_ms": duree_appui_ms, "nb_clics": nb_clics,
                      "speedPercent": speed_percent, "instantane": self._global_defaut("SOURIS_INSTANTANEE", False)}
            reponse = self._appel_brut("click", params, timeout)
            if latence_apres:
                time.sleep(latence_apres)
            if reponse.get("ok"):
                return ResultatAction(True)
            derniere_erreur = reponse.get("error")
        return ResultatAction(False, f"Échec de click_element({selecteur!r}, index={index}, cadre={cadre!r}) pour l'instance "
                                     f"« {self.instance_id} » (après {essais_total} tentative(s)) : {derniere_erreur}")

    def remplir(self, selecteur: str, texte: str, index: int = 0, humain: bool = False, vider: bool = True,
                delai_min_ms: int = 60, delai_max_ms: int = 180, scroll: bool = True,
                retry: Optional[int] = None, timeout: Optional[float] = None,
                cadre: Optional[str] = None) -> "ResultatAction":
        """remplir(selecteur, texte, cadre=None) -- met `texte` dans le champ (input, textarea,
        contenteditable) ciblé par un sélecteur CSS.
          - humain=False (défaut) : valeur posée directement + événements
            input/change (instantané, compatible React/Vue). Remplace le contenu.
          - humain=True : clic humain sur le champ, (vider=True) Ctrl+A+Suppr,
            puis frappe caractère par caractère avec délais réalistes -- plus
            lent, mais indiscernable d'une vraie saisie pour les sites sensibles.
            vider=False ajoute le texte à l'endroit du clic.
          - cadre : sélecteur CSS d'une <iframe> de même origine (ou "auto") : le champ est cherché
            DANS l'iframe (fonctionne en mode direct comme en mode humain).
            Instance.remplir("input[name=email]", "moi@exemple.com", humain=True)"""
        retry = retry if retry is not None else self._global_defaut("RETRY", 0)
        timeout = timeout if timeout is not None else self._global_defaut("TIMEOUT", None)
        essais_total = max(1, retry + 1)
        derniere_erreur = None
        for _ in range(essais_total):
            el, erreur = self._localiser_element(selecteur, index, bool(scroll and humain), timeout, cadre)
            if el is None:
                derniere_erreur = erreur
                continue
            if not humain and cadre:
                # dom_paste ne connaît pas les iframes : même logique, exécutée DANS le cadre.
                reponse = self._appel_brut("evaluer_js", {"code": _JS_REMPLIR_DANS_CADRE
                                                          .replace("__SEL__", json.dumps(el["selecteur"]))
                                                          .replace("__TXT__", json.dumps(texte)), "cadre": cadre}, timeout)
                if reponse.get("ok"):
                    res_js = reponse.get("result") or {}
                    if res_js.get("trouve") and not res_js.get("erreur"):
                        return ResultatAction(True)
                    derniere_erreur = res_js.get("erreur") or "élément introuvable dans le cadre"
                else:
                    derniere_erreur = reponse.get("error")
                continue
            if not humain:
                reponse = self._appel_brut("dom_paste", {"selecteur": el["selecteur"], "texte": texte}, timeout)
                if reponse.get("ok"):
                    return ResultatAction(True)
                derniere_erreur = reponse.get("error")
                continue
            x, y = _point_dans_element(el)
            if vider:
                reponse = self._appel_brut("clear", {"x": x, "y": y}, timeout)
                if not reponse.get("ok"):
                    derniere_erreur = reponse.get("error")
                    continue
            reponse = self._appel_brut("type_text", {"x": x, "y": y, "texte": texte, "delai_min_ms": delai_min_ms,
                                                      "delai_max_ms": delai_max_ms, "avec_clic": not vider}, timeout)
            if reponse.get("ok"):
                return ResultatAction(True)
            derniere_erreur = reponse.get("error")
        return ResultatAction(False, f"Échec de remplir({selecteur!r}, index={index}, cadre={cadre!r}) pour l'instance "
                                     f"« {self.instance_id} » (après {essais_total} tentative(s)) : {derniere_erreur}")

    def evaluer_js(self, code: str, cadre: Optional[str] = None,
                   retry: Optional[int] = None, timeout: Optional[float] = None):
        """evaluer_js(code, cadre=None) -- exécute du JavaScript dans l'ONGLET ACTIF (ou dans l'iframe
        `cadre`) et renvoie la valeur obtenue (str, nombre, bool, liste, dict ; None si rien).
          - `code` : UNE expression (renvoyée directement) OU plusieurs instructions avec `return`.
          - Avec `cadre` (sélecteur CSS d'une <iframe> de même origine, "a >>> b" pour des iframes
            imbriquées, "auto" = la plus grande), `document` et `window` désignent ceux DE L'IFRAME.
          - await est utilisable ; un élément DOM renvoyé est converti en son outerHTML.
          - Lève RuntimeError si le JS échoue. PAS de retry automatique (le code peut avoir des
            effets de bord) sauf si `retry` est fourni.
            titre = Instance.evaluer_js("document.title", cadre="iframe.browse-frame")
            html = Instance.evaluer_js("return document.documentElement.outerHTML", cadre="auto")
            Instance.evaluer_js("document.querySelector('#popup').remove()", cadre="auto")"""
        retry_resolu = retry if retry is not None else 0
        timeout_resolu = timeout if timeout is not None else self._global_defaut("TIMEOUT", None)
        essais_total = 1 + max(0, retry_resolu)
        derniere_erreur = None
        for _ in range(essais_total):
            reponse = self._appel_brut("evaluer_js", {"code": code, "cadre": cadre or ""}, timeout_resolu)
            if reponse.get("ok"):
                return reponse.get("result")
            derniere_erreur = reponse.get("error")
        raise RuntimeError(
            f"Échec de evaluer_js pour l'instance « {self.instance_id} » "
            f"(cadre={cadre!r}, après {essais_total} tentative(s)) : {derniere_erreur}"
        )

    def drag(self, chemin_fichier: str, retry: Optional[int] = None, timeout: Optional[float] = None,
              latence_avant: Optional[float] = None, latence_apres: Optional[float] = None) -> "ResultatAction":
        """drag(chemin_fichier) -- AJOUT (demande explicite utilisateur :
        "je veux que drag soit plutôt lié à la page web actuelle et non à
        un composant, c'est-à-dire dragger sur la page web actuelle") --
        dépose un fichier local (ou tout le contenu fichier d'un dossier
        local) sur le PREMIER <input type="file"> trouvé n'importe où sur
        la page actuellement active de cette instance, via
        DOM.setFileInputFiles -- cf. action_drag_page côté instance pour
        le détail complet (recherche PAGE ENTIÈRE, sans viser un point ni
        un Composant précis, contrairement à ComposantExecutable.drag()
        qui cible la position d'UN Composant détecté).

        Utile quand l'input file réel d'une page (souvent invisible/
        hors-écran) n'est pas nécessairement sous le composant visuel
        qu'on ciblerait avec une détection OpenCV, ou quand aucun
        Composant n'a même été détouré pour la zone de dépôt visuelle.

        Alias : drop() (même nommage que ComposantExecutable, pour rester
        cohérent).

        chemin_fichier : chemin LOCAL (sur la machine qui exécute le
        navigateur) d'un fichier, ou d'un dossier (auquel cas tous ses
        fichiers directs, sans récursion, sont envoyés comme une
        sélection multiple -- cf. action_drag_page pour le détail).

        retry (défaut None -> lit RETRY de la cellule "Variable
        statique", 0 si absente) : nombre de tentatives SUPPLÉMENTAIRES en
        cas d'échec -- chaque tentative relit la page (l'input file peut
        apparaître après un délai de rendu).
        timeout (défaut None -> lit TIMEOUT de la cellule "Variable
        statique", 5.0s si absente ou None -- EN SECONDES) : délai maximum
        accordé à l'appel réseau pour CETTE tentative.
        latence_avant/latence_apres (défaut None -> lisent LATENCE_AVANT/
        LATENCE_APRES de la cellule "Variable dynamique", 0.0 si
        absentes) : pause EN SECONDES avant l'envoi de la commande / après
        sa réponse, appliquée à CHAQUE tentative -- même sémantique que
        sur ComposantExecutable.

        Retourne un ResultatAction (jamais d'exception sur input introuvable
        ou chemin invalide, cf. ResultatAction) -- même convention que
        ComposantExecutable.drag()/click()/etc. :
            r = Instance.drag("C:/images/photo.png")
            if r:
                print("Déposé")
            else:
                print(r.message)"""
        retry = retry if retry is not None else self._global_defaut("RETRY", 0)
        timeout = timeout if timeout is not None else self._global_defaut("TIMEOUT", None)
        latence_avant = latence_avant if latence_avant is not None else self._global_defaut("LATENCE_AVANT", 0.0)
        latence_apres = latence_apres if latence_apres is not None else self._global_defaut("LATENCE_APRES", 0.0)
        essais_total = max(1, retry + 1)
        derniere_erreur: Optional[str] = None
        for tentative in range(essais_total):
            if latence_avant:
                time.sleep(latence_avant)
            reponse = self._moteur_effectif()._appeler(
                self.instance_id, "drag_page", {"chemin_fichier": chemin_fichier}, timeout=timeout,
            )
            if latence_apres:
                time.sleep(latence_apres)
            if reponse.get("ok"):
                return ResultatAction(True)
            derniere_erreur = reponse.get("error")
        return ResultatAction(
            False,
            f"Échec du drag pour l'instance « {self.instance_id} » "
            f"(après {essais_total} tentative(s)) : {derniere_erreur}",
        )

    def drop(self, chemin_fichier: str, retry: Optional[int] = None, timeout: Optional[float] = None,
              latence_avant: Optional[float] = None, latence_apres: Optional[float] = None) -> "ResultatAction":
        """Alias de drag() (même nommage que ComposantExecutable.drop())."""
        return self.drag(chemin_fichier, retry=retry, timeout=timeout,
                          latence_avant=latence_avant, latence_apres=latence_apres)

    def new_tab(self, url: str, retry: Optional[int] = None, timeout: Optional[float] = None,
                latence_avant: Optional[float] = None, latence_apres: Optional[float] = None,
                bloquer_media: bool = False) -> "ResultatAction":
        """new_tab(url) -- ouvre un nouvel onglet sur cette instance et
        navigue vers url. Devient l'onglet actif de l'instance. Attend que
        la page ait fini de charger (document.readyState == "complete")
        avant de considérer l'appel réussi -- pas seulement que l'onglet
        ait été créé/attaché (cf. action_new_tab côté instance, PATCH
        demandé par l'utilisateur).

        bloquer_media (défaut False) -- PATCH (demande explicite
        utilisateur : empêcher le chargement des médias lourds d'une
        page, économie de bande passante pour du scraping/RPA) : quand
        True, bloque au niveau réseau (Network.setBlockedURLs, CDP) les
        requêtes vers les vidéos, images et polices avant même qu'elles
        ne partent -- cf. PATTERNS_MEDIA_LOURD_DEFAUT côté instance pour
        la liste exacte des extensions couvertes. N'affecte jamais le
        HTML/CSS/JS de la page : seul le contenu textuel et la structure
        restent chargés normalement, ce qui suffit pour la plupart des
        usages de scraping (extraction de texte, clic sur des éléments,
        etc.) sans jamais consommer la bande passante des ressources
        lourdes. Effet limité à CET appel (cet onglet nouvellement créé) --
        n'affecte aucun autre onglet existant de cette instance.

        retry (défaut None -> lit RETRY de la cellule "Variable
        statique", 0 si absente) : nombre de tentatives SUPPLÉMENTAIRES
        en cas d'échec (retry=3 -> 4 essais au total). Chaque tentative
        ouvre un NOUVEL onglet (l'onglet de la tentative précédente,
        s'il a été créé mais n'a pas fini de charger à temps, reste
        ouvert -- pas de fermeture automatique, cohérent avec le reste
        de cette classe qui ne fait jamais rien de destructeur sans
        demande explicite).
        timeout (défaut None -> lit TIMEOUT de la cellule "Variable
        statique", 8.0s si absente ou None -- PATCH : "8s par défaut" --
        EN SECONDES) : délai maximum accordé à CETTE tentative pour que
        la page finisse de charger, au-delà duquel elle est considérée en
        échec (mais l'onglet reste ouvert, cf. ci-dessus) et une nouvelle
        tentative démarre s'il reste du retry.
        latence_avant/latence_apres (défaut None -> lisent LATENCE_AVANT/
        LATENCE_APRES de la cellule "Variable dynamique", 0.0 si absentes) :
        pause EN SECONDES avant l'envoi de la commande réseau / après sa
        réponse, appliquée à CHAQUE tentative -- même sémantique que sur
        ComposantExecutable (cf. sa docstring _executer_avec_retry).

        Retourne un ResultatAction (jamais d'exception sur échec de
        chargement, cf. ResultatAction) : r.statut, et si succès
        r.tab_id (utilisable ensuite avec switch_tab) ; si échec,
        r.message porte le détail de la dernière erreur -- MÊME
        convention que ComposantExecutable.click()/saisir()/etc. :
            r = Instance.new_tab("https://exemple.com", bloquer_media=True)
            if r:
                tab_id = r.tab_id
            else:
                print(r.message)"""
        retry = retry if retry is not None else self._global_defaut("RETRY", 0)
        timeout = timeout if timeout is not None else self._global_defaut("TIMEOUT", None)
        timeout_attente_page_s = timeout if timeout is not None else DELAI_ATTENTE_CHARGEMENT_PAGE_DEFAUT_S
        latence_avant = latence_avant if latence_avant is not None else self._global_defaut("LATENCE_AVANT", 0.0)
        latence_apres = latence_apres if latence_apres is not None else self._global_defaut("LATENCE_APRES", 0.0)
        essais_total = max(1, retry + 1)
        derniere_erreur: Optional[str] = None
        # Marge au-delà du délai d'attente de chargement transmis à
        # l'instance : le pilote (_appeler) doit attendre AU MOINS aussi
        # longtemps que l'instance elle-même attend le chargement, plus
        # une marge pour l'aller-retour réseau lui-même (cf. décision
        # utilisateur -- même esprit que TIMEOUT_COMMANDE_MS vs le
        # timeout de SequenceurActionReseau, déjà plus long d'une marge
        # comparable dans ce fichier).
        timeout_appel_pilote_s = timeout_attente_page_s + MARGE_RESEAU_ATTENTE_CHARGEMENT_S
        for tentative in range(essais_total):
            if latence_avant:
                time.sleep(latence_avant)
            reponse = self._moteur_effectif()._appeler(
                self.instance_id, "newTab",
                {"url": url, "timeout_attente_page_s": timeout_attente_page_s, "bloquer_media": bloquer_media},
                timeout=timeout_appel_pilote_s,
            )
            if latence_apres:
                time.sleep(latence_apres)
            if reponse.get("ok"):
                return ResultatAction(True, tab_id=(reponse.get("result") or {}).get("id", ""))
            derniere_erreur = reponse.get("error")
        return ResultatAction(
            False,
            f"Échec d'ouverture d'un nouvel onglet pour l'instance « {self.instance_id} » "
            f"(après {essais_total} tentative(s)) : {derniere_erreur}",
        )

    def naviguer(self, url: str, retry: Optional[int] = None, timeout: Optional[float] = None,
                latence_avant: Optional[float] = None, latence_apres: Optional[float] = None,
                bloquer_media: bool = False) -> "ResultatAction":
        """naviguer(url) -- AJOUT demandé par l'utilisateur : navigue vers
        url SUR L'ONGLET ACTUELLEMENT ACTIF de cette instance, SANS en
        ouvrir un nouveau -- contrairement à new_tab() (cf. sa docstring),
        qui crée systématiquement un nouvel onglet. Utile pour changer de
        page sans multiplier les onglets ouverts au fil d'un script.

        bloquer_media (défaut False) -- PATCH (demande explicite
        utilisateur : empêcher le chargement des médias lourds d'une
        page, économie de bande passante pour du scraping/RPA) : même
        comportement et mêmes détails que sur new_tab() (cf. sa
        docstring) -- bloque au niveau réseau (Network.setBlockedURLs,
        CDP) les vidéos, images et polices de la page ciblée, AVANT que
        ces requêtes ne partent. Le filtre est posé sur cet onglet AVANT
        la navigation elle-même, donc s'applique dès ce premier
        chargement -- si cet onglet avait déjà un autre filtre actif
        (posé par un appel précédent), il est simplement remplacé par
        celui-ci (jamais cumulé, cf. _installer_blocage_media côté
        instance). Passer bloquer_media=False (défaut) désactive le
        filtre côté navigateur -- utile pour, sur ce même onglet,
        revenir à un chargement complet sans média bloqué.

        Réutilise EXACTEMENT le même mécanisme d'attente que new_tab()
        (action réseau "navigate", cf. action_navigate/action_camoufox_
        navigate côté instance) : attend que la page ait fini de charger
        (document.readyState == "complete") avant de considérer l'appel
        réussi -- pas seulement que la navigation ait démarré.

        retry (défaut None -> lit RETRY de la cellule "Variable
        statique", 0 si absente) : nombre de tentatives SUPPLÉMENTAIRES
        en cas d'échec (retry=3 -> 4 essais au total). Chaque tentative
        renavigue sur le MÊME onglet (contrairement à new_tab(), aucun
        nouvel onglet n'est créé entre les tentatives).
        timeout (défaut None -> lit TIMEOUT de la cellule "Variable
        statique", 8.0s si absente ou None -- EN SECONDES) : délai
        maximum accordé à CETTE tentative pour que la page finisse de
        charger, même sémantique que new_tab().
        latence_avant/latence_apres (défaut None -> lisent LATENCE_AVANT/
        LATENCE_APRES de la cellule "Variable dynamique", 0.0 si
        absentes) : pause EN SECONDES avant l'envoi de la commande
        réseau / après sa réponse, appliquée à CHAQUE tentative -- même
        sémantique que new_tab()/mouse_move().

        Retourne un ResultatAction (jamais d'exception sur échec de
        chargement, même convention que new_tab()) -- .tab_id RESTE
        VIDE ici (aucun nouvel onglet créé, contrairement à new_tab()) :
            r = Instance.naviguer("https://exemple.com", bloquer_media=True)
            if r:
                print("Page chargée avec succès.")
            else:
                print(r.message)"""
        retry = retry if retry is not None else self._global_defaut("RETRY", 0)
        timeout = timeout if timeout is not None else self._global_defaut("TIMEOUT", None)
        timeout_attente_page_s = timeout if timeout is not None else DELAI_ATTENTE_CHARGEMENT_PAGE_DEFAUT_S
        latence_avant = latence_avant if latence_avant is not None else self._global_defaut("LATENCE_AVANT", 0.0)
        latence_apres = latence_apres if latence_apres is not None else self._global_defaut("LATENCE_APRES", 0.0)
        essais_total = max(1, retry + 1)
        derniere_erreur: Optional[str] = None
        timeout_appel_pilote_s = timeout_attente_page_s + MARGE_RESEAU_ATTENTE_CHARGEMENT_S
        for tentative in range(essais_total):
            if latence_avant:
                time.sleep(latence_avant)
            reponse = self._moteur_effectif()._appeler(
                self.instance_id, "navigate",
                {"url": url, "timeout_attente_page_s": timeout_attente_page_s, "bloquer_media": bloquer_media},
                timeout=timeout_appel_pilote_s,
            )
            if latence_apres:
                time.sleep(latence_apres)
            if reponse.get("ok"):
                return ResultatAction(True)
            derniere_erreur = reponse.get("error")
        return ResultatAction(
            False,
            f"Échec de navigation vers « {url} » pour l'instance « {self.instance_id} » "
            f"(après {essais_total} tentative(s)) : {derniere_erreur}",
        )

    def switch_tab(self, tab_id: str):
        """switch_tab(tab_id) -- bascule l'onglet actif de cette instance
        vers le tab_id donné (obtenu via new_tab() ou en listant les
        onglets côté UI)."""
        reponse = self._moteur_effectif()._appeler(self.instance_id, "switchTab", {"tabId": tab_id})
        if not reponse.get("ok"):
            raise RuntimeError(f"Échec du switch d'onglet pour l'instance « {self.instance_id} » : {reponse.get('error')}")

    def bring_to_front(self):
        """bring_to_front() -- AJOUT (clic droit "voir ce profil" dans le
        panneau clone, cf. docstring de action_bring_to_front) : remonte
        la fenêtre du navigateur de cette instance au premier plan du
        bureau, ponctuellement, SANS changer l'onglet actif (contrairement
        à switch_tab() ci-dessus, qui change aussi la cible)."""
        reponse = self._moteur_effectif()._appeler(self.instance_id, "bringToFront", {})
        if not reponse.get("ok"):
            raise RuntimeError(f"Échec de mise au premier plan pour l'instance « {self.instance_id} » : {reponse.get('error')}")

    def list_tabs(self) -> list:
        """list_tabs() -- AJOUT demandé par l'utilisateur : liste tous les
        onglets actuellement ouverts sur cette instance (relaie la
        commande réseau "listTabs", cf. action_list_tabs/action_camoufox_
        list_tabs côté instance -- déjà utilisée en interne côté UI pour
        le panneau de gestion d'une instance, jusqu'ici jamais exposée à
        un script de Task).

        Retourne une liste de dict, un par onglet ouvert, chacun avec :
            {"id": str, "titre": str, "url": str, "actif": bool}
        "id" est directement réutilisable avec switch_tab(). "actif"
        indique l'onglet actuellement au premier plan de l'instance
        (un seul onglet True au maximum). Liste vide si l'instance n'a
        aucun onglet ouvert (ne devrait normalement pas arriver).

        Pure lecture, ne modifie rien. Appelable depuis un script Task,
        comme new_tab()/switch_tab()/tab_accueil().

        Usage typique -- retrouver un onglet précis par son url sans
        avoir gardé son tab_id :
            onglets = Instance.list_tabs()
            for o in onglets:
                if "exemple.com" in o["url"]:
                    Instance.switch_tab(o["id"])
                    break"""
        reponse = self._moteur_effectif()._appeler(self.instance_id, "listTabs", {})
        if not reponse.get("ok"):
            raise RuntimeError(f"Échec de récupération des onglets pour l'instance « {self.instance_id} » : {reponse.get('error')}")
        resultat = reponse.get("result", [])
        return resultat if isinstance(resultat, list) else []

    def tab_accueil(self) -> str:
        """tab_accueil() -- PATCH demandé par l'utilisateur : retrouve le
        tab_id de l'onglet welcome page de cette instance. Utile car ce
        tab_id est généré par le navigateur à chaque lancement d'instance
        -- il n'existe PAS de constante fixe possible côté script pour y
        revenir après un new_tab() ; il faut le redemander à chaque fois.

        Usage typique -- ouvrir un onglet, y travailler, puis revenir sur
        l'accueil :
            r = Instance.new_tab("https://exemple.com")
            ... # travail dans le nouvel onglet (r.tab_id si besoin)
            Instance.switch_tab(Instance.tab_accueil())

        Lève RuntimeError si aucun onglet welcome page n'est trouvé
        (fermé manuellement, ou instance démarrée avec une URL
        personnalisée plutôt que la welcome page par défaut) -- même
        convention d'erreur que les autres méthodes de cette classe."""
        reponse = self._moteur_effectif()._appeler(self.instance_id, "getHomeTabId", {})
        if not reponse.get("ok"):
            raise RuntimeError(f"Échec de récupération de l'onglet d'accueil pour l'instance « {self.instance_id} » : {reponse.get('error')}")
        return reponse.get("result", {}).get("tabId", "")

    def reset_interface(self, vider_donnees: bool = False):
        """reset_interface(vider_donnees=False) -- PATCH : par défaut les cookies et données de
        navigation sont CONSERVÉS ; vider_donnees=True les vide (cookies, localStorage, IndexedDB,
        caches...) avant la réinitialisation. PATCH demandé par l'utilisateur : referme
        tous les onglets actuellement ouverts sur cette instance et ne
        laisse que la welcome page AutoniaX, comme si l'instance venait
        tout juste de démarrer (cf. action_reset_interface côté
        instance_nodriver.py -- même prudence que demarrer_navigateur :
        un nouvel onglet est ouvert AVANT que les anciens ne soient
        fermés, jamais l'inverse, pour ne jamais tuer le process
        Chrome/Vivaldi en fermant tous les onglets d'un coup).

        Appelable depuis un script Task, comme new_tab()/switch_tab()."""
        reponse = self._moteur_effectif()._appeler(self.instance_id, "resetInterface", {"vider_donnees": bool(vider_donnees)})
        if not reponse.get("ok"):
            raise RuntimeError(f"Échec de réinitialisation de l'interface pour l'instance « {self.instance_id} » : {reponse.get('error')}")

    def vider_donnees_navigation(self, timeout: Optional[float] = None) -> dict:
        """vider_donnees_navigation() -- AJOUT : vide TOUTES les données de navigation de l'instance (cookies, localStorage, sessionStorage, IndexedDB,
        Cache Storage, service workers, cache HTTP, permissions). Marche sur CloakBrowser (Chromium, nettoyage CDP complet), Camoufox (Firefox : cookies +
        stockage de chaque onglet) et Chrome/Vivaldi (CDP). Ne ferme aucun onglet : appeler reset_interface() avant/après si besoin d'une instance « neuve ».
        Les onglets ouverts gardent leur page affichée : recharger (ou naviguer) pour repartir sans session.
        NE vide PAS l'historique, les mots de passe enregistrés ni les favoris (fichiers du profil sur disque, verrouillés par le navigateur en marche).
        timeout (s, défaut 30). Retourne le rapport {"ok", "cookies", "cdp", "pages_nettoyees", "erreurs"...} ; lève RuntimeError en cas d'échec."""
        delai = timeout if timeout is not None else 30.0
        reponse = self._moteur_effectif()._appeler(self.instance_id, "clearBrowsingData", {"timeout_action_s": delai}, timeout=delai)
        if not reponse.get("ok"):
            raise RuntimeError(f"Échec du vidage des données de navigation pour l'instance « {self.instance_id} » : {reponse.get('error')}")
        return reponse.get("result") or {}

    def remplacer_ressource(self, motif: str, ajouter_debut: Optional[str] = None, ajouter_fin: Optional[str] = None,
                            remplacer=None, fichier: Optional[str] = None, contenu=None, content_type: Optional[str] = None,
                            regex: bool = False, cumuler: bool = False, timeout: Optional[float] = None) -> dict:
        """remplacer_ressource(motif, ...) -- AJOUT : fait charger à la page NOTRE version d'un fichier (ex. un .js), modifiée à la volée
        par le navigateur AVANT qu'elle ne s'exécute (aucun fichier du site n'est touché). Les règles s'appliquent aux PROCHAINS
        chargements : appeler AVANT naviguer()/new_tab(). Elles survivent à reset_interface() (effacer_remplacements() pour les retirer).
        motif : morceau d'URL (sensible à la casse), ex. "Main.min" ; regex=True = expression régulière.
        ajouter_fin / ajouter_debut : texte ajouté à la fin / au début du fichier (ex. un setTimeout(...) qui fait un print après 10 s).
        remplacer : {ancien: nouveau} ou liste de paires, remplacements de texte dans le fichier (le journal dit combien d'occurrences trouvées).
        fichier / contenu : remplace le fichier ENTIER par ce fichier local (chemin du poste du Task) ou ce texte/octets ; content_type optionnel.
        cumuler=False (défaut) : remplace les règles précédentes ; True : s'ajoute aux règles existantes.
        Chrome/Vivaldi : onglet piloté uniquement ; Camoufox/Cloak : tout le contexte. Un <script integrity=...> refuse un fichier modifié.
        Retourne {"regles": n, "journal": [...], "installation": ...} ; lève RuntimeError/ValueError en cas d'échec."""
        regle = _ro_construire_regle(motif, ajouter_debut=ajouter_debut, ajouter_fin=ajouter_fin, remplacer=remplacer,
                                     fichier=fichier, contenu=contenu, content_type=content_type, regex=regex)
        return _ro_client_appeler(lambda a, p, t: self._moteur_effectif()._appeler(self.instance_id, a, p, timeout=t), self.instance_id, "ajouter" if cumuler else "definir", [regle], timeout)

    def definir_remplacements(self, regles: list, timeout: Optional[float] = None) -> dict:
        """definir_remplacements(regles) -- AJOUT : remplace TOUTES les règles par la liste donnée (dicts : motif, regex, ajouter_debut,
        ajouter_fin, remplacer, corps_base64, content_type). Voir remplacer_ressource() pour le détail."""
        return _ro_client_appeler(lambda a, p, t: self._moteur_effectif()._appeler(self.instance_id, a, p, timeout=t), self.instance_id, "definir", _ro_normaliser_regles(regles), timeout)

    def effacer_remplacements(self, timeout: Optional[float] = None) -> dict:
        """effacer_remplacements() -- AJOUT : supprime toutes les règles de remplacement (les prochains chargements redeviennent normaux)."""
        return _ro_client_appeler(lambda a, p, t: self._moteur_effectif()._appeler(self.instance_id, a, p, timeout=t), self.instance_id, "definir", [], timeout)

    def lire_journal_remplacements(self, timeout: Optional[float] = None) -> list:
        """lire_journal_remplacements() -- AJOUT : liste des interceptions réalisées (url, regle, ok, avant, apres, remplacements, erreur, t).
        Une liste vide après un naviguer() signifie que la règle n'a rien intercepté (motif qui ne correspond pas, ressource hors interception...)."""
        return list(_ro_client_appeler(lambda a, p, t: self._moteur_effectif()._appeler(self.instance_id, a, p, timeout=t), self.instance_id, "journal", None, timeout).get("journal") or [])

    def est_interface_initialisee(self) -> bool:
        """est_interface_initialisee() -- PATCH demandé par l'utilisateur :
        indique si l'instance est actuellement dans l'état juste après un
        démarrage ou un reset_interface(), càd : un seul onglet ouvert, et
        cet onglet pointe vers la welcome page AutoniaX de cette instance
        (cf. action_is_interface_initialisee côté instance_nodriver.py).

        Pure lecture, ne modifie rien. Appelable depuis un script Task,
        comme new_tab()/switch_tab()/reset_interface()."""
        reponse = self._moteur_effectif()._appeler(self.instance_id, "isInterfaceInitialisee", {})
        if not reponse.get("ok"):
            raise RuntimeError(f"Échec de vérification de l'état d'initialisation pour l'instance « {self.instance_id} » : {reponse.get('error')}")
        valeur = reponse.get("result", {})
        return bool(valeur.get("initialisee", False)) if isinstance(valeur, dict) else False

    def position_aleatoire(self, rayon_cm: float, timeout: Optional[float] = None) -> Tuple[int, int]:
        """position_aleatoire(rayon_cm) -- AJOUT demandé par l'utilisateur :
        tire une position (x, y) aléatoire, EN PIXELS de l'écran piloté par
        cette instance (mêmes coordonnées que celles attendues par
        new_tab()/switch_tab()/click()/mousemove() d'un Composant), tombant
        n'importe où sur le CERCLE de rayon rayon_cm (converti en pixels,
        cf. PIXELS_CSS_PAR_CM -- 96 DPI, référence du standard CSS, aucun
        DPI physique réel n'étant connu pour une page pilotée par CDP/
        Playwright) centré sur :
          - la position ACTUELLE du curseur virtuel de cette instance, si
            un mousemove/move_cursor/click a déjà eu lieu dessus depuis son
            démarrage (cf. action_get_screen_info -- etat_navigateur
            "curseur_x"/"curseur_y" côté instance, MÊME source que
            ComposantExecutable.mousemove()/click()) ;
          - à défaut (curseur virtuel jamais bougé -- toute première
            action sur une instance fraîchement démarrée), le CENTRE de
            l'écran de l'instance (largeur/2, hauteur/2), comme demandé
            explicitement.

        Le point tiré est UNIFORME SUR LE CERCLE lui-même (pas dans le
        disque qu'il délimite) : un angle aléatoire uniforme sur [0, 2π[
        est tiré, puis le point est placé exactement à rayon_cm (en
        pixels) du centre le long de cet angle -- cf. demande utilisateur
        : "sa vas generer une positon aleatore qui se trouve sur ce
        cercle". Si un point DANS le disque (plutôt que sur son contour)
        est un jour nécessaire, une autre méthode serait ajoutée plutôt
        que de changer le comportement de celle-ci.

        Le point est ensuite BORNÉ (clampé) aux dimensions réelles de
        l'écran de l'instance (jamais de coordonnée négative ni au-delà
        de largeur-1/hauteur-1) -- un centre proche d'un bord peut donc
        produire un point strictement plus proche du centre que rayon_cm
        une fois clampé, plutôt qu'une coordonnée hors écran inutilisable
        par un mousemove()/click() ultérieur.

        rayon_cm : rayon du cercle EN CENTIMÈTRES (peut être 0 -- renvoie
        alors exactement le centre).

        timeout (défaut None -> lit TIMEOUT de la cellule "Variable
        statique", 5.0s fixe côté instance si absente/None -- EN
        SECONDES) : délai accordé à la lecture de la taille d'écran/
        position du curseur, même convention que capture()/new_tab().

        Retourne un tuple (x, y) d'entiers, directement utilisable comme
        coordonnées pour toute méthode acceptant x/y de ce fichier. Lève
        RuntimeError si la lecture de l'état de l'instance échoue (même
        convention que capture()/get_presse_papier() -- ne renvoie jamais
        de position invalide silencieusement)."""
        timeout = timeout if timeout is not None else self._global_defaut("TIMEOUT", None)
        params = {"timeout_action_s": timeout} if timeout is not None else {}
        reponse = self._moteur_effectif()._appeler(self.instance_id, "getScreenInfo", params, timeout=timeout)
        if not reponse.get("ok"):
            raise RuntimeError(f"Échec de lecture de l'écran pour l'instance « {self.instance_id} » : {reponse.get('error')}")
        resultat = reponse.get("result") or {}
        largeur = resultat.get("largeur")
        hauteur = resultat.get("hauteur")
        if not isinstance(largeur, (int, float)) or not isinstance(hauteur, (int, float)) or largeur <= 0 or hauteur <= 0:
            raise RuntimeError(f"Dimensions d'écran invalides reçues pour l'instance « {self.instance_id} » : {resultat!r}")
        curseur_x, curseur_y = resultat.get("curseur_x"), resultat.get("curseur_y")
        if curseur_x is not None and curseur_y is not None:
            centre_x, centre_y = float(curseur_x), float(curseur_y)
        else:
            centre_x, centre_y = largeur / 2.0, hauteur / 2.0
        rayon_px = max(0.0, float(rayon_cm)) * PIXELS_CSS_PAR_CM
        angle = random.uniform(0.0, 2.0 * math.pi)
        x = centre_x + rayon_px * math.cos(angle)
        y = centre_y + rayon_px * math.sin(angle)
        x = max(0, min(int(largeur) - 1, round(x)))
        y = max(0, min(int(hauteur) - 1, round(y)))
        return (x, y)

    def mouse_move(self, x: int, y: int, retry: Optional[int] = None, timeout: Optional[float] = None,
                   latence_avant: Optional[float] = None, latence_apres: Optional[float] = None,
                   speed_percent: float = 0) -> "ResultatAction":
        """mouse_move(x, y) -- AJOUT demandé par l'utilisateur : déplace le
        curseur RÉEL de cette instance (vrai mouseMoved CDP/Playwright,
        PAS seulement le curseur virtuel visuel) de sa position ACTUELLE
        vers le point (x, y) donné, EN PIXELS de l'écran de l'instance
        (mêmes coordonnées que celles retournées par position_aleatoire(),
        ou attendues par ComposantExecutable.click()/mousemove()).

        Réutilise l'action réseau "mousemove" déjà existante côté
        instance (cf. action_mousemove / action_camoufox_mousemove) --
        LA MÊME que celle utilisée par ComposantExecutable.mousemove(),
        simplement appelée ici avec un point (x, y) fourni directement
        plutôt que calculé depuis un Composant/zone. Le point de départ
        du trajet est géré côté instance (etat_navigateur["curseur_x"/
        "curseur_y"], cf. leurs docstrings) : la position ACTUELLE du
        curseur virtuel si un mousemove/click a déjà eu lieu sur cette
        instance, sinon (x, y) lui-même (trajet de longueur nulle, tout
        premier mouvement de la session).

        Trajectoire HUMAINE (pas un saut instantané) : dérivée
        statistiquement des mouvements réels enregistrés (cf.
        generate_mouse_path), avec micro-tremblement et timing réaliste
        -- même mécanisme que ComposantExecutable.mousemove().

        speed_percent (défaut 0, cf. ComposantExecutable.click()) --
        contrôle la vitesse du déplacement (0 = vitesse normale/mesurée,
        positif = plus rapide, négatif = plus lent).

        retry (défaut None -> lit RETRY de la cellule "Variable
        statique", 0 si absente) : nombre de tentatives SUPPLÉMENTAIRES
        en cas d'échec.
        timeout (défaut None -> lit TIMEOUT de la cellule "Variable
        dynamique", comportement historique 5.0s fixe côté instance si
        absente/None -- EN SECONDES) : délai maximum accordé à CETTE
        tentative.
        latence_avant/latence_apres (défaut None -> lisent LATENCE_AVANT/
        LATENCE_APRES de la cellule "Variable dynamique", 0.0 si
        absentes) : pause EN SECONDES avant l'envoi de la commande
        réseau / après sa réponse, appliquée à CHAQUE tentative -- même
        sémantique que sur ComposantExecutable (cf. sa docstring
        _executer_avec_retry).

        Retourne un ResultatAction (jamais d'exception sur échec,
        même convention que new_tab()) :
            r = Instance.mouse_move(500, 300)
            if not r:
                print(r.message)

        Usage typique avec position_aleatoire() :
            x, y = Instance.position_aleatoire(3)
            Instance.mouse_move(x, y)"""
        retry = retry if retry is not None else self._global_defaut("RETRY", 0)
        timeout = timeout if timeout is not None else self._global_defaut("TIMEOUT", None)
        latence_avant = latence_avant if latence_avant is not None else self._global_defaut("LATENCE_AVANT", 0.0)
        latence_apres = latence_apres if latence_apres is not None else self._global_defaut("LATENCE_APRES", 0.0)
        essais_total = max(1, retry + 1)
        derniere_erreur: Optional[str] = None
        params = {"x": int(x), "y": int(y), "speedPercent": speed_percent,
                  "instantane": self._global_defaut("SOURIS_INSTANTANEE", False)}
        timeout_appel_pilote = timeout
        if timeout is not None:
            params["timeout_action_s"] = timeout
            timeout_appel_pilote = timeout + MARGE_RESEAU_ATTENTE_CHARGEMENT_S
        for tentative in range(essais_total):
            if latence_avant:
                time.sleep(latence_avant)
            reponse = self._moteur_effectif()._appeler(self.instance_id, "mousemove", params, timeout=timeout_appel_pilote)
            if latence_apres:
                time.sleep(latence_apres)
            if reponse.get("ok"):
                return ResultatAction(True)
            derniere_erreur = reponse.get("error")
        return ResultatAction(
            False,
            f"Échec de mouse_move vers ({x}, {y}) pour l'instance « {self.instance_id} » "
            f"(après {essais_total} tentative(s)) : {derniere_erreur}",
        )

    def centrer_curseur(self, retry: Optional[int] = None, timeout: Optional[float] = None,
                        latence_avant: Optional[float] = None, latence_apres: Optional[float] = None,
                        speed_percent: float = 0) -> "ResultatAction":
        """centrer_curseur() -- AJOUT demandé par l'utilisateur : positionne
        le curseur RÉEL de cette instance (même mouseMoved CDP/Playwright
        que mouse_move()) au CENTRE de la page (largeur/2, hauteur/2), EN
        PIXELS de l'écran de l'instance -- mêmes coordonnées que celles
        retournées par position_aleatoire()/attendues par mouse_move().

        Réutilise EXACTEMENT le même mécanisme que position_aleatoire()
        pour lire les dimensions courantes de l'écran (action réseau
        "getScreenInfo", cf. sa docstring pour le détail), puis délègue le
        déplacement à mouse_move(largeur/2, hauteur/2, ...) -- donc même
        trajectoire humaine (pas un saut instantané), même micro-
        tremblement, même timing réaliste que tout autre déplacement de
        souris de cette classe.

        timeout (défaut None -> lit TIMEOUT de la cellule "Variable
        dynamique", 5.0s fixe côté instance si absente/None -- EN
        SECONDES) : appliqué À LA FOIS à la lecture de la taille d'écran
        ET au mouse_move qui suit (même valeur passée aux deux, comme
        position_aleatoire() puis mouse_move() enchaînés manuellement).
        retry/latence_avant/latence_apres/speed_percent : transmis tels
        quels à mouse_move() (cf. sa docstring) -- non utilisés pour la
        lecture de getScreenInfo elle-même, qui n'est jamais réessayée.

        Retourne un ResultatAction (jamais d'exception sur échec de
        mouse_move ; une RuntimeError reste levée si la lecture de
        l'écran échoue, même convention que position_aleatoire()) :
            r = Instance.centrer_curseur()
            if not r:
                print(r.message)"""
        timeout = timeout if timeout is not None else self._global_defaut("TIMEOUT", None)
        params = {"timeout_action_s": timeout} if timeout is not None else {}
        reponse = self._moteur_effectif()._appeler(self.instance_id, "getScreenInfo", params, timeout=timeout)
        if not reponse.get("ok"):
            raise RuntimeError(f"Échec de lecture de l'écran pour l'instance « {self.instance_id} » : {reponse.get('error')}")
        resultat = reponse.get("result") or {}
        largeur = resultat.get("largeur")
        hauteur = resultat.get("hauteur")
        if not isinstance(largeur, (int, float)) or not isinstance(hauteur, (int, float)) or largeur <= 0 or hauteur <= 0:
            raise RuntimeError(f"Dimensions d'écran invalides reçues pour l'instance « {self.instance_id} » : {resultat!r}")
        centre_x = round(largeur / 2.0)
        centre_y = round(hauteur / 2.0)
        return self.mouse_move(centre_x, centre_y, retry=retry, timeout=timeout,
                                latence_avant=latence_avant, latence_apres=latence_apres,
                                speed_percent=speed_percent)

    def scroll(self, x: int, y: int, delta_x: float = 0.0, delta_y: float = 0.0,
               retry: Optional[int] = None, timeout: Optional[float] = None,
               latence_avant: Optional[float] = None, latence_apres: Optional[float] = None,
               speed_percent: float = 0) -> "ResultatAction":
        """scroll(x, y, delta_x, delta_y) -- AJOUT demandé par l'utilisateur
        ("il faut une fonction scroll qui permet juste de scroller
        indépendamment d'un composant, juste un instance.scroll()") :
        défilement HUMANISÉ au point (x, y) donné, EN PIXELS de l'écran de
        l'instance (mêmes coordonnées que mouse_move()/position_aleatoire()),
        SANS jamais détecter ni dépendre d'un Composant -- contrairement à
        ComposantExecutable.scroll(), qui doit d'abord détecter un
        Composant pour en déduire son propre point de scroll.

        Réutilise l'action réseau "scroll" déjà existante côté instance
        (cf. action_scroll / action_camoufox_scroll) -- LA MÊME que celle
        utilisée par ComposantExecutable.scroll(), simplement appelée ici
        avec un point (x, y) fourni directement plutôt que calculé depuis
        un Composant/zone (même principe que mouse_move() vs
        ComposantExecutable.mousemove() ci-dessus).

        delta_x/delta_y : quantité TOTALE à scroller (mêmes unités que
        WHEEL_DELTA*nb_crans, PAS un delta par cran individuel -- la
        rafale de crans qui réalise ce total est générée et rejouée côté
        instance, cf. docstring ComposantExecutable.scroll()).

        Trajectoire HUMANISÉE (pas un seul événement brut) : dérivée
        statistiquement des rafales de scroll réelles enregistrées (cf.
        generate_scroll_events), même mécanisme que
        ComposantExecutable.scroll() -- sauf si SOURIS_INSTANTANEE est
        actif (cellule "Variable dynamique"), auquel cas un seul
        événement mouseWheel est envoyé avec le delta total, sans délai.

        speed_percent (défaut 0, cf. mouse_move()) -- contrôle la cadence
        temporelle de la rafale (0 = normale/mesurée, positif = plus
        rapide, négatif = plus lent) -- n'affecte jamais delta_x/delta_y.

        retry (défaut None -> lit RETRY de la cellule "Variable
        statique", 0 si absente) : nombre de tentatives SUPPLÉMENTAIRES
        en cas d'échec.
        timeout (défaut None -> lit TIMEOUT de la cellule "Variable
        dynamique", comportement historique 5.0s fixe côté instance si
        absente/None -- EN SECONDES) : délai maximum accordé à CETTE
        tentative.
        latence_avant/latence_apres (défaut None -> lisent LATENCE_AVANT/
        LATENCE_APRES de la cellule "Variable dynamique", 0.0 si
        absentes) : pause EN SECONDES avant l'envoi de la commande
        réseau / après sa réponse, appliquée à CHAQUE tentative.

        Retourne un ResultatAction (jamais d'exception sur échec, même
        convention que mouse_move()) :
            r = Instance.scroll(500, 300, delta_y=90)
            if not r:
                print(r.message)

        Usage typique -- centrer le curseur puis scroller sur place :
            Instance.centrer_curseur()
            x, y = Instance.position_aleatoire(3)
            Instance.scroll(x, y, delta_y=90)"""
        retry = retry if retry is not None else self._global_defaut("RETRY", 0)
        timeout = timeout if timeout is not None else self._global_defaut("TIMEOUT", None)
        latence_avant = latence_avant if latence_avant is not None else self._global_defaut("LATENCE_AVANT", 0.0)
        latence_apres = latence_apres if latence_apres is not None else self._global_defaut("LATENCE_APRES", 0.0)
        essais_total = max(1, retry + 1)
        derniere_erreur: Optional[str] = None
        params = {"x": int(x), "y": int(y), "targetDeltaX": delta_x, "targetDeltaY": delta_y,
                  "speedPercent": speed_percent,
                  "instantane": self._global_defaut("SOURIS_INSTANTANEE", False)}
        timeout_appel_pilote = timeout
        if timeout is not None:
            params["timeout_action_s"] = timeout
            timeout_appel_pilote = timeout + MARGE_RESEAU_ATTENTE_CHARGEMENT_S
        for tentative in range(essais_total):
            if latence_avant:
                time.sleep(latence_avant)
            reponse = self._moteur_effectif()._appeler(self.instance_id, "scroll", params, timeout=timeout_appel_pilote)
            if latence_apres:
                time.sleep(latence_apres)
            if reponse.get("ok"):
                return ResultatAction(True)
            derniere_erreur = reponse.get("error")
        return ResultatAction(
            False,
            f"Échec de scroll à ({x}, {y}) pour l'instance « {self.instance_id} » "
            f"(après {essais_total} tentative(s)) : {derniere_erreur}",
        )

    def glisser_souris(self, depart, arrivee, bouton: str = "gauche",
                       speed_percent: float = 0, retry: Optional[int] = None,
                       timeout: Optional[float] = None, latence_avant: Optional[float] = None,
                       latence_apres: Optional[float] = None) -> "ResultatAction":
        """glisser_souris(depart, arrivee) -- glisser (souris) en coordonnées
        écran : appui au point `depart`, déplacement humain, relâchement au
        point `arrivee`. Chaque paramètre = un point (x, y) ou une zone absolue
        (x, y, largeur, hauteur) dans laquelle un point est tiré au hasard.
        Distinct de drag() (dépôt de fichier)."""
        x1, y1 = point_ecran_depuis_cible(depart, "depart")
        x2, y2 = point_ecran_depuis_cible(arrivee, "arrivee")
        retry = retry if retry is not None else self._global_defaut("RETRY", 0)
        timeout = timeout if timeout is not None else self._global_defaut("TIMEOUT", None)
        latence_avant = latence_avant if latence_avant is not None else self._global_defaut("LATENCE_AVANT", 0.0)
        latence_apres = latence_apres if latence_apres is not None else self._global_defaut("LATENCE_APRES", 0.0)
        essais_total = max(1, retry + 1)
        derniere_erreur: Optional[str] = None
        params = {"x1": int(x1), "y1": int(y1), "x2": int(x2), "y2": int(y2), "bouton": bouton,
                  "speedPercent": speed_percent,
                  "instantane": self._global_defaut("SOURIS_INSTANTANEE", False)}
        timeout_appel_pilote = timeout
        if timeout is not None:
            params["timeout_action_s"] = timeout
            timeout_appel_pilote = timeout + MARGE_RESEAU_ATTENTE_CHARGEMENT_S
        for _tentative in range(essais_total):
            if latence_avant:
                time.sleep(latence_avant)
            reponse = self._moteur_effectif()._appeler(self.instance_id, "mouse_drag", params, timeout=timeout_appel_pilote)
            if latence_apres:
                time.sleep(latence_apres)
            if reponse.get("ok"):
                return ResultatAction(True)
            derniere_erreur = reponse.get("error")
        return ResultatAction(
            False,
            f"Échec du glisser (souris) ({x1}, {y1}) -> ({x2}, {y2}) pour l'instance « {self.instance_id} » "
            f"(après {essais_total} tentative(s)) : {derniere_erreur}",
        )


class ServiceAPIExecutable:
    """Wrapper exposé à un script Task sous le nom du ServiceAPI lui-même
    (cf. nom_variable_python, ex: "Word"), à CÔTÉ des ComposantExecutable
    de ce même ServiceAPI (ex: Word_BoutonOK) -- injecté automatiquement
    dans le namespace comme eux, cf. _executer_cellule.

    Ne porte QU'UNE méthode : instance(), qui construit un
    InstanceExecutable pointant sur l'instance actuellement liée à CE
    ServiceAPI DANS CE TASK (task.services_api_importes[nom_service],
    cf. docstring Task -- liaison propre à chaque Task, pas une
    configuration globale du ServiceAPI). Permet d'écrire dans un script
    Task, sans jamais écrire d'instance_id en dur (utile puisque le même
    script tourne potentiellement en parallèle sur plusieurs instances,
    chacune avec sa propre liaison choisie dans son propre Task) :

        mon_instance = Word.instance()
        chemin = mon_instance.capture()
        texte = mon_instance.get_presse_papier()

    Un nouvel InstanceExecutable est créé à CHAQUE appel de instance()
    (pas de cache/réutilisation) -- cohérent avec ComposantExecutable,
    qui lui aussi ne mémorise aucun état entre deux appels de méthode."""

    def __init__(self, nom_service: str, instance_id: str, moteur, namespace: Optional[dict] = None):
        """moteur : voir InstanceExecutable.__init__ (MoteurExecutionCellule
        direct ou résolveur callable) -- simplement transmis tel quel à
        chaque InstanceExecutable construit par instance() ci-dessous,
        jamais interprété ici.

        namespace (AJOUT, cf. InstanceExecutable.__init__) : simplement
        transmis tel quel lui aussi à chaque InstanceExecutable construit
        par instance() -- permet à mon_instance = Word.instance() de
        résoudre RETRY/TIMEOUT/LATENCE_AVANT/LATENCE_APRES depuis la même
        cellule "Variable dynamique" que les ComposantExecutable de ce
        Task."""
        self.nom_service = nom_service
        self.instance_id = instance_id
        self._moteur = moteur
        self._namespace = namespace

    def __repr__(self) -> str:
        return f"ServiceAPIExecutable({self.nom_service!r})"

    def instance(self) -> "InstanceExecutable":
        """instance() -- retourne un InstanceExecutable pointant sur
        l'instance actuellement liée à ce ServiceAPI dans ce Task."""
        return InstanceExecutable(self.instance_id, self._moteur, self._namespace)


