    def _on_clic_effacer_terminal(self):
        """Bouton "Effacer les logs du terminal" (section TERMINAL) --
        vide la fenêtre de console dans laquelle AutoniaX tourne, via la
        commande native de l'OS ("cls" sous Windows, "clear" ailleurs).
        os.system(...) plutôt qu'un appel API console (ex. Windows
        FillConsoleOutputCharacter) : plus simple, et suffisant puisque
        c'est exactement ce qu'un utilisateur taperait lui-même à la
        main -- pas besoin de ctypes/pywin32 pour ça.

        Si aucune console n'est attachée au process (ex. AutoniaX lancé
        en .pyw, ou en tant que service/tâche planifiée sans fenêtre),
        la commande est silencieusement sans effet -- pas d'erreur pour
        l'utilisateur dans ce cas, juste rien à effacer."""
        try:
            os.system("cls" if os.name == "nt" else "clear")
            log_dashboard_ui.info("[TERMINAL] Console effacée via le bouton Paramètres.")
        except Exception as exc:
            log_dashboard_ui.warning(f"[TERMINAL] Échec de l'effacement de la console : {exc!r}")

    def _on_clic_copier_terminal(self):
        """Bouton "Copier les logs du terminal" (section TERMINAL) --
        copie dans le presse-papier le texte DÉJÀ AFFICHÉ dans la
        fenêtre de console (cmd.exe) où AutoniaX a été lancé (demande
        explicite utilisateur : "je dit copier la sortie du navigateur
        deja sortie" -- ce qui est déjà visible/scrollé dans la
        fenêtre, pas un nouveau système de capture de logs).

        Lit directement le SCREEN BUFFER de la console via l'API
        Windows (kernel32 -- GetStdHandle/GetConsoleScreenBufferInfo/
        ReadConsoleOutputCharacterW), PAS un fichier ni un buffer
        interne à AutoniaX -- rien n'est journalisé nulle part pour ce
        bouton, seule la mémoire d'écran déjà tenue par Windows pour
        cette fenêtre est lue.

        Windows uniquement (os.name == 'nt') : c'est l'API console
        native, pas de portage Unix ici -- notify d'erreur claire sur
        les autres OS plutôt qu'un échec silencieux, cf.
        _lire_buffer_console_windows ci-dessous pour le détail.

        Feedback affiché dans self.label_statut_banques (déjà présent
        sur cet écran, cf. section Mouvement humain plus haut) plutôt
        qu'une méthode _notify_status -- ParametresScreen n'en possède
        pas (contrairement à d'autres écrans de l'app), ce label
        existant remplit déjà exactement ce rôle ici."""
        if os.name != "nt":
            self.label_statut_banques.setText(
                "Copie des logs du terminal : disponible uniquement sous Windows pour le moment."
            )
            return
        try:
            texte = _lire_buffer_console_windows()
        except Exception as exc:
            log_dashboard_ui.warning(f"[TERMINAL] Échec de la lecture du buffer console : {exc!r}")
            self.label_statut_banques.setText(
                "Impossible de lire le contenu du terminal (aucune console attachée ?)."
            )
            return
        if not texte.strip():
            self.label_statut_banques.setText("Le terminal semble vide -- rien à copier.")
            return
        QGuiApplication.clipboard().setText(texte)
        log_dashboard_ui.info(
            f"[TERMINAL] Contenu de la console copié dans le presse-papier ({len(texte)} caractère(s))."
        )
        self.label_statut_banques.setText("Logs du terminal copiés dans le presse-papier.")

    def _rafraichir_liste_sources_logs(self):
        """(Re)peuple liste_sources_logs : mAutoniax + Serveur (toujours
        présentes, cf. ID_LOGS_MAUTONIAX/ID_LOGS_SERVEUR) puis une ligne
        par sAutoniax actuellement connu (cf. definir_executants_connus,
        appelée par MainWindow à chaque executants_detail_change -- donc
        potentiellement plusieurs fois par seconde en pratique : cette
        méthode DOIT rester rapide et surtout préserver les cases déjà
        cochées, même patron que ProjetBatchScreen._rafraichir_liste_
        instances_batch, sinon un simple rafraîchissement de connexion
        déferait silencieusement les choix de l'utilisateur)."""
        self.liste_sources_logs.blockSignals(True)
        self.liste_sources_logs.clear()

        item_mautoniax = QListWidgetItem("mAutoniax (cette instance)")
        item_mautoniax.setFlags(item_mautoniax.flags() | Qt.ItemIsUserCheckable)
        item_mautoniax.setData(Qt.UserRole, self.ID_LOGS_MAUTONIAX)
        item_mautoniax.setCheckState(
            Qt.Checked if self.ID_LOGS_MAUTONIAX in self._sources_logs_cochees else Qt.Unchecked
        )
        self.liste_sources_logs.addItem(item_mautoniax)

        item_serveur = QListWidgetItem("Serveur (serveurT)")
        item_serveur.setFlags(item_serveur.flags() | Qt.ItemIsUserCheckable)
        item_serveur.setData(Qt.UserRole, self.ID_LOGS_SERVEUR)
        item_serveur.setCheckState(
            Qt.Checked if self.ID_LOGS_SERVEUR in self._sources_logs_cochees else Qt.Unchecked
        )
        self.liste_sources_logs.addItem(item_serveur)

        for id_executant, nom_affiche in sorted(
            getattr(self, "_executants_logs_connus", {}).items(), key=lambda paire: paire[1]
        ):
            item = QListWidgetItem(f"sAutoniax : {nom_affiche}")
            item.setFlags(item.flags() | Qt.ItemIsUserCheckable)
            item.setData(Qt.UserRole, id_executant)
            # Un sAutoniax qui vient d'apparaître (pas encore dans
            # _sources_logs_cochees) démarre DÉCOCHÉ -- cf. commentaire
            # au moment de l'initialisation de _sources_logs_cochees
            # dans __init__.
            item.setCheckState(Qt.Checked if id_executant in self._sources_logs_cochees else Qt.Unchecked)
            self.liste_sources_logs.addItem(item)

        self.liste_sources_logs.blockSignals(False)

    def _on_source_logs_item_changed(self, item: "QListWidgetItem"):
        id_source = item.data(Qt.UserRole)
        if item.checkState() == Qt.Checked:
            self._sources_logs_cochees.add(id_source)
        else:
            self._sources_logs_cochees.discard(id_source)

    def definir_executants_connus_logs(self, executants: list):
        """Appelée par MainWindow (câblée sur ClientServeurT.
        executants_detail_change, même signal que tous les autres écrans
        qui ont besoin de connaître les sAutoniax connectés -- cf.
        InstancesConnecteesScreen.sur_executants_detail_change,
        ProjetsDistribuesScreen.definir_executants_connus). Ne garde que
        role="executant" (le message porte aussi les pilotes -- jamais
        pertinent ici, on ne copie jamais les logs d'un AUTRE pilote)."""
        self._executants_logs_connus = {
            e.get("id", ""): e.get("nom") or e.get("id", "")
            for e in executants
            if e.get("id") and e.get("role") == "executant"
        }
        self._rafraichir_liste_sources_logs()

    def _on_clic_copier_tous_logs(self):
        """Bouton "Copier les logs" -- même patron que _on_clic_charger_
        banques (désactive le bouton, statut "en cours", délègue le
        travail réel à MainWindow via un signal, cf. demande_copier_
        tous_logs). Transporte la liste des id_executant sAutoniax
        cochés ; mAutoniax/Serveur cochés ou non sont relus directement
        par MainWindow (cf. sources_mautoniax_et_serveur_cochees).

        AJOUT (filtre par motif, cf. self.champ_filtre_logs) -- le motif
        tapé est transmis tel quel (texte brut, .strip() seulement) ;
        c'est MainWindow._tenter_finaliser_copie_logs qui applique le
        filtre ligne par ligne au moment de l'assemblage final, pas ici
        (cette méthode ne voit jamais le contenu réel des logs).

        AJOUT (pourcentage à conserver, cf. self.champ_pourcentage_logs)
        -- lu et validé ICI plutôt que côté MainWindow : un champ vide
        ou un contenu non numérique (ex. utilisateur qui vide le champ
        avant de cliquer) retombe silencieusement sur 100 (aucune
        troncature) plutôt que de bloquer le clic ou lever une
        exception -- QIntValidator(0, 100) empêche déjà la plupart des
        saisies invalides en amont, ce repli ne couvre que le champ
        laissé vide."""
        ids_sautoniax_coches = [
            item_id for item_id in self._sources_logs_cochees
            if item_id not in (self.ID_LOGS_MAUTONIAX, self.ID_LOGS_SERVEUR)
        ]
        if not self._sources_logs_cochees:
            self.label_statut_logs.setStyleSheet("")
            self.label_statut_logs.setText("Aucune source cochée -- rien à copier.")
            return
        self.bouton_copier_tous_logs.setEnabled(False)
        self.label_statut_logs.setStyleSheet("")
        self.label_statut_logs.setText("Récupération des logs en cours…")
        motif_filtre = self.champ_filtre_logs.text().strip()
        try:
            pourcentage_conservation = int(self.champ_pourcentage_logs.text().strip())
        except ValueError:
            pourcentage_conservation = 100
        pourcentage_conservation = max(0, min(100, pourcentage_conservation))
        self.demande_copier_tous_logs.emit(ids_sautoniax_coches, motif_filtre, pourcentage_conservation)

    def _sur_clic_coller_documentation(self):
        """AJOUT (SPEC_GLOBALE_AutoniaX.md, Partie B §4.3 -- demande
        explicite utilisateur : "je veux que la gestion de mise à jour
        de la doc se fasse dans les paramètres, un bouton coller qui va
        écraser le contenu du fichier de doc actuel dans le dossier de
        données de l'app") -- lit le presse-papier, valide et écrit via
        ecrire_documentation_disque (cf. cette fonction pour la règle de
        validation exacte : présence de "<html", insensible à la casse).

        DÉCISION EXPLICITE UTILISATEUR : si le collage échoue
        (presse-papier vide OU sans "<html"), le bouton NE FAIT RIEN --
        le fichier existant, s'il y en a un, n'est PAS modifié -- seul
        un retour visuel discret (point de statut + tooltip) informe de
        l'échec, pas de boîte de dialogue bloquante."""
        texte = QGuiApplication.clipboard().text()
        if ecrire_documentation_disque(texte):
            self.point_statut_documentation.setStyleSheet(f"color: {Mocha.green}; font-size: 10px;")
            self.point_statut_documentation.setToolTip(
                "Documentation mise à jour depuis le presse-papier."
            )
        else:
            self.point_statut_documentation.setStyleSheet(f"color: {Mocha.red}; font-size: 10px;")
            self.point_statut_documentation.setToolTip(
                "Échec -- le presse-papier est vide ou ne contient pas de "
                "balise <html>. Le fichier documentation.html n'a pas été "
                "modifié."
            )

