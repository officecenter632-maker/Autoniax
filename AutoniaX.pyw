        self.bouton_selectionner_inactifs_profils.setObjectName("ProfilMenuButton")
        self.bouton_selectionner_inactifs_profils.setCursor(Qt.PointingHandCursor)
        self.bouton_selectionner_inactifs_profils.clicked.connect(self._sur_clic_selectionner_inactifs_profils)
        layout_selection.addWidget(self.bouton_selectionner_inactifs_profils)

        # AJOUT (spec A.2) -- bouton "Copier" (propriétés de TOUS les
        # profils COCHÉS et ACTIFS, cf. _sur_clic_copier_proprietes_masse)
        # -- icône seule (tooltip porte l'explication complète), même
        # ligne que le bouton de sélection.
        self.bouton_copier_proprietes_masse = QToolButton(self._bloc_selection_masse)
        self.bouton_copier_proprietes_masse.setIcon(qta.icon("mdi6.content-copy", color=Mocha.subtext0))
        self.bouton_copier_proprietes_masse.setObjectName("ProfilMenuButton")
        self.bouton_copier_proprietes_masse.setCursor(Qt.PointingHandCursor)
        self.bouton_copier_proprietes_masse.setToolTip(
            "Copier -- copie les propriétés (empreinte) de tous les profils "
            "cochés et actifs (les profils cochés mais inactifs sont ignorés)."
        )
        self.bouton_copier_proprietes_masse.clicked.connect(self._sur_clic_copier_proprietes_masse)
        layout_selection.addWidget(self.bouton_copier_proprietes_masse)

        # DÉPLACÉ plus bas (demande explicite utilisateur : "je veux que
        # les bouton tout selectioner et deselctionenr soit aussi en bas
        # et non en haut") -- cf. layout.addWidget(self._bloc_selection_
        # masse) après layout_tout_demarrer_arreter, plus bas dans cette
        # même méthode. Widget inchangé, seul son emplacement dans le
        # layout `layout` (racine) a changé.
        self.table_profils = QTreeWidget(self)
        self.table_profils.setObjectName("PanneauProprietesProfilsTable")
        self.table_profils.setRootIsDecorated(False)
        self.table_profils.setUniformRowHeights(False)
        self.table_profils.setSelectionMode(QAbstractItemView.NoSelection)
        self.table_profils.setHeaderLabels(["Profil", "État", "Actions"])
        self.table_profils.header().setSectionResizeMode(0, QHeaderView.Stretch)
        self.table_profils.setVisible(False)
        # AJOUT (spec A.1) -- itemChanged déclenché par le clic sur la
        # checkbox de colonne 0 (cf. _reconstruire_table qui pose
        # ItemIsUserCheckable + setCheckState), même patron EXACT que
        # PanneauExecutionClone._sur_item_changed (référence visuelle
        # explicitement demandée par la spec pour ce panneau).
        self.table_profils.itemChanged.connect(self._sur_item_changed_profil)
        layout.addWidget(self.table_profils, stretch=1)

        # AJOUT (spec A.4 -- JSON de contraintes de résolution d'écran
        # pour la génération en masse). DÉCISION UTILISATEUR (remplace la
        # décision initiale de la spec, qui prévoyait un QTextEdit visible
        # + bouton Coller) : PLUS de champ texte visible du tout -- juste
        # un bouton "Coller" (lit directement le presse-papier) et un
        # label de statut qui informe si un filtre est actif ou non. Le
        # JSON collé n'est donc JAMAIS affiché tel quel à l'écran -- il
        # est validé immédiatement au clic (cf. _sur_clic_coller_
        # contraintes) et gardé UNIQUEMENT en mémoire (self._contraintes_
        # generation, réglage persistant tant que ce panneau reste
        # ouvert sur ce sAutoniax -- jamais réinitialisé par un
        # changement de sélection de profils ni par un rafraîchissement,
        # seul un nouveau clic sur "Coller" le remplace).
        self._contraintes_generation: dict = {}

        # PATCH (génération en masse -- remplace l'ancien bouton unique
        # "Créer un profil" + son dialogue modal, demande explicite
        # utilisateur : "je veux que la generation se fasse en masse, tu
        # met pluot un endorit qui accepte les chiffre et un bouton de
        # generations, la sa vas generer un nombre de profils aleatoire,
        # tu vas leur nomer : iaX1, iaX2..." -- cf. section 1/2 de
        # SPEC_generation_masse_profils.md, remplacement complet TRANCHÉ,
        # pas un ajout à côté). Même visibilité/emplacement EXACT que
        # l'ancien bouton (masqué tant qu'aucun sAutoniax n'est
        # sélectionné, cf. definir_sautoniax_selectionne, juste en
        # dessous de table_profils).
        #
        # AJOUT (spec A.4) -- layout racine passé de QHBoxLayout à
        # QVBoxLayout pour empiler DEUX rangées : la ligne de contraintes
        # (bouton Coller + label de statut) au-dessus, la ligne Nombre/
        # Générer existante en dessous, inchangée sinon.
        # REFONTE (retour explicite utilisateur : "tu ne peut pas
        # reflechir comme un designer?" -- la version précédente occupait
        # 2 lignes pour 3 idées distinctes : l'état d'un filtre optionnel/
        # occasionnel affiché en toutes lettres ("Aucun filtre de
        # génération actif."), puis la quantité et l'action séparées par
        # des espacements flottants) -- une seule ligne : le filtre
        # (occasionnel) devient une icône + un point d'état coloré
        # (tooltip porte le détail complet, cf. _sur_clic_coller_
        # contraintes plus bas) : gris = aucun filtre, vert = filtre
        # actif, rouge = JSON invalide collé par erreur -- puis la
        # quantité et "Générer" SOUDÉS en bout de ligne (spacing=0 entre
        # les deux) pour lire comme un seul contrôle composé plutôt que
        # deux widgets flottants. Ne peut plus jamais passer à la ligne.
        self._bloc_generation_masse = QWidget(self)
        layout_generation = QHBoxLayout(self._bloc_generation_masse)
        layout_generation.setContentsMargins(0, 0, 0, 0)
        layout_generation.setSpacing(8)

        self.bouton_coller_contraintes = QToolButton(self._bloc_generation_masse)
        self.bouton_coller_contraintes.setIcon(qta.icon("mdi6.content-paste", color=Mocha.subtext0))
        self.bouton_coller_contraintes.setObjectName("ProfilMenuButton")
        self.bouton_coller_contraintes.setCursor(Qt.PointingHandCursor)
        self.bouton_coller_contraintes.setToolTip(
            "Coller les contraintes -- aucun filtre de génération actif.\n"
            "Colle un JSON de contraintes depuis le presse-papier "
            "(ex. {\"Résolution d'écran\": [\"height>700\", \"width>600\"]}) -- "
            "un presse-papier vide efface le filtre actif."
        )
        layout_generation.addWidget(self.bouton_coller_contraintes)
        self.bouton_coller_contraintes.clicked.connect(self._sur_clic_coller_contraintes)

        # Point d'état compact -- remplace l'ancien label en toutes
        # lettres ("Aucun filtre de génération actif." / "Filtre actif --
        # ..." / "JSON invalide : ..."), désormais porté par le tooltip
        # ci-dessus ET celui de ce point (les deux sont tenus synchronisés
        # par _sur_clic_coller_contraintes) plutôt que par du texte fixe
        # dans la mise en page.
        self.point_statut_contraintes = QLabel("●", self._bloc_generation_masse)
        self.point_statut_contraintes.setStyleSheet(f"color: {Mocha.surface2}; font-size: 10px;")
        self.point_statut_contraintes.setToolTip("Aucun filtre de génération actif.")
        layout_generation.addWidget(self.point_statut_contraintes)

        layout_generation.addStretch(1)

        # PATCH (demande explicite utilisateur : "on doit pouvoir choisir
        # entre generer des profils chrome ou camoufox, dans le panneau
        # de profils des sautoniax") -- remplace l'ancien type FIXE
        # ("camoufox", cf. l'ex-attribut self._type_instance_generation_
        # masse retiré) : un profil Chrome ou Camoufox selon le choix
        # explicite ici, jamais mis en cache ailleurs -- lu directement
        # depuis ce combo au moment de _lancer_generation_masse, comme
