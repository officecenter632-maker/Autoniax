# TargetClosedError n'est PAS exposé par playwright.async_api dans les
# versions récentes (vérifié : playwright 1.56 n'expose que Error/
# TimeoutError/WebError à cet endroit) -- seulement par le module interne
# playwright._impl._errors, non garanti stable d'une version à l'autre.
# Repli en cascade : chemin public d'abord si jamais il existe sur une
# autre version, puis chemin interne, puis classe fictive qui ne matchera
# jamais aucune exception réelle (isinstance(exc, classe_locale_vide)
# est toujours False pour une exception venant d'ailleurs) -- dans ce
# dernier cas, la détection de fermeture repose alors uniquement sur le
# filet de mots-clés ("closed"/"crashed"/"disconnected") dans
# _camoufox_est_erreur_fermeture, jamais sur un isinstance qui échouerait.
try:
    from playwright.async_api import TargetClosedError as PlaywrightTargetClosedError
except ImportError:
    try:
        from playwright._impl._errors import TargetClosedError as PlaywrightTargetClosedError
    except ImportError:
        class PlaywrightTargetClosedError(Exception):
            pass


class NavigateurFermeCamoufox(Exception):
    """Équivalent Camoufox/Playwright de NavigateurFerme (utilisée plus
    haut pour le client nodriver/CDP, cf. capturer_frame_reelle) --
    distincte de cette dernière pour ne jamais mélanger les deux clients
    par erreur (chacun lève SA propre exception de fermeture), mais même
    rôle exact : signaler à l'appelant (_executer_commande_camoufox /
    la boucle de streaming Camoufox) qu'il s'agit d'une VRAIE
    déconnexion (navigateur/onglet fermé), pas d'un échec métier
    ponctuel d'une action (élément absent, timeout de chargement...),
    qui doit lui rester un command_result ok=False ordinaire."""


def _camoufox_est_erreur_fermeture(exc: Exception) -> bool:
    if isinstance(exc, PlaywrightTargetClosedError):
        return True
    if isinstance(exc, PlaywrightError):
        message = str(exc).lower()
        if "closed" in message or "crashed" in message or "disconnected" in message:
            return True
    return False


def _camoufox_relever_si_fermeture(exc: Exception) -> None:
    """À appeler dans un `except Exception as exc:` -- relève en
    NavigateurFermeCamoufox si c'est une fermeture, sinon ne fait rien
    (laisse l'appelant traiter l'exception d'origine), même pattern que
    _relever_si_fermeture dans le script standalone de validation.

    DIAGNOSTIC : avant ce patch, le message d'exception d'origine
    (exc!r) n'était JAMAIS loggé sur ce chemin -- l'appelant logue son
    propre message d'échec seulement quand cette fonction NE lève PAS,
    donc dès qu'une fermeture était détectée ici, le texte exact de
    l'erreur Playwright (qui dirait si c'est "Target closed" à cause
    d'une vraie fermeture/crash, d'un context.close() en cours ailleurs,
    d'un timeout réseau contenant incidemment le mot "closed", etc.)
    partait dans le NavigateurFermeCamoufox puis n'était plus ressorti
    nulle part avant la fin de session. Log explicite ici pour pouvoir
    distinguer un vrai crash navigateur d'un faux positif de détection."""
    if _camoufox_est_erreur_fermeture(exc):
        log.warning(f"[camoufox][diag-fermeture] Détecté comme fermeture définitive -- type={type(exc).__name__} message={exc!r}")
        raise NavigateurFermeCamoufox(str(exc)) from exc


