class LabelStatutElide(QLabel):
    """QLabel à hauteur fixe (une seule ligne) dont le texte est TOUJOURS
    élidé ("…") plutôt que wrappé -- utilisé pour label_statut_rafraichissement
    (cf. PanneauRenduInstance), dont le texte change dynamiquement entre une
    version longue et une courte selon l'état actif/inactif du streaming.

    FIX (demande explicite utilisateur : "j'appuie sur le bouton de toggle,
    ça fait bouger le layout") -- un QLabel standard change de sizeHint
    (largeur sans wrap, ou hauteur avec wrap sur 2 lignes) à chaque
    changement de texte, ce qui remontait jusqu'au panneau parent et
    faisait "sauter" tout l'écran. Ce label garde toujours la MÊME
    hauteur (une ligne) et ne dicte plus sa largeur (Ignored) -- seul le
    texte VISIBLE change de longueur (élidé selon la largeur réellement
    disponible), jamais la géométrie du widget lui-même. Le texte complet
    reste consultable via le tooltip, et se ré-élide automatiquement à
    chaque redimensionnement du label (resizeEvent), pas seulement à
    chaque changement de texte."""

    def __init__(self, texte: str = "", parent=None):
        super().__init__(parent)
        self._texte_complet = ""
        self.setSizePolicy(QSizePolicy.Ignored, QSizePolicy.Fixed)
        self.setFixedHeight(self.fontMetrics().height())
        self.definir_texte(texte)

    def definir_texte(self, texte: str):
        self._texte_complet = texte
        self.setToolTip(texte)
        self._reappliquer_elision()

    def _reappliquer_elision(self):
        metrics = self.fontMetrics()
        # width() peut valoir 0 -- juste après construction (avant le
        # premier show()), ou temporairement pendant un recalcul de
        # layout à très faible largeur disponible (ex: fenêtre réduite au
        # point que les autres widgets de la bande absorbent tout
        # l'espace). Dans ce cas, afficher une chaîne vide plutôt que le
        # texte complet non tronqué : ce dernier déborderait visuellement
        # d'un espace nul. resizeEvent rappellera cette méthode dès
        # qu'une largeur réelle sera à nouveau disponible ; le tooltip
        # (déjà posé dans definir_texte) reste consultable entre-temps.
        if self.width() <= 0:
            super().setText("")
            return
        super().setText(metrics.elidedText(self._texte_complet, Qt.ElideRight, self.width()))

    def resizeEvent(self, event):
        super().resizeEvent(event)
        self._reappliquer_elision()


class PanneauRenduInstance(QWidget):
    """Widget de RENDU d'une instance nodriver -- encapsule tout ce qui
    concerne l'affichage de l'aperçu lui-même : titre, contrôles de
    rafraîchissement (bouton ponctuel / auto+FPS / statut), et l'image
    (apercu_label). Possède son PROPRE layout, séparé du panneau de
    réglages spécifiques au composant/action testé.

    Disposition (CORRIGÉ -- demande explicite utilisateur : "les widgets
    de config dans le panneau de rendu sont mal mis, on doit mettre ça
    sur une colonne, ça doit avoir sa colonne complète" -- la version
    précédente empilait TOUT verticalement, y compris les contrôles
    sous l'image en pleine largeur, ce qui n'est PAS une colonne à côté
    de l'image mais un simple empilement en dessous) :
    - Titre indicatif TOUT EN HAUT, sur toute la largeur du panneau
      (layout racine EXTÉRIEUR vertical : titre puis corps).
    - Le CORPS (sous le titre) est HORIZONTAL : l'image à GAUCHE
      (stretch=1, occupe tout l'espace restant), la colonne de réglages
      (Rafraîchir/Mode/Taux/Statut + Onglet + Résolution-Qualité) à
      DROITE, dans sa PROPRE colonne verticale de largeur contenue par
      son contenu (pas étirée), avec un stretch en bas de colonne pour
      que les blocs restent groupés en haut plutôt qu'écartelés sur
      toute la hauteur du panneau.

    CORRIGÉ (demande explicite : "j'appuie sur le bouton de toggle, ça
    fait bouger le layout, je veux pas ça, l'écran doit rester fixe
    statique") -- deux causes cumulées :
      1. self.label_mode_auto changeait de texte ("Manuel" <->
         "Automatique", longueurs différentes) SANS largeur réservée
         fixe : le QHBoxLayout recalculait la largeur de tous les
         widgets à sa droite à chaque toggle, ce qui décalait
         visiblement toute la bande. Fixé via setMinimumWidth() sur ce
         label, calculé sur le texte le plus long des deux états, pour
         que sa largeur ne varie plus jamais.
      2. self.label_statut_rafraichissement n'était JAMAIS ajouté à
         layout_controles (oubli d'un refactor précédent -- créé mais
         aucun addWidget, cf. historique) : un widget avec un parent Qt
         mais hors de tout layout reste positionné/dimensionné en dehors
         du système de layout normal, ce qui pouvait contribuer à des
         sauts visuels imprévisibles au moindre repaint/resize. Ajouté à
         sa place naturelle dans layout_controles.

    apercu_label et droite_layout restent des attributs PUBLICS de ce
    panneau (pas de méthode d'accès dédiée) : CoordonneeActionScreen a
    besoin de remplacer apercu_label EN PLACE (indexOf/removeWidget/
    insertWidget sur droite_layout, cf. son __init__) sans changer sa
    logique existante -- droite_layout désigne ICI la sous-zone qui ne
    contient QUE l'image (pas les contrôles), pour que ce contrat (un
    seul widget géré par ce layout, l'aperçu) reste vrai même après cette
    nouvelle restructuration verticale/horizontale."""

    # PATCH (recompression par pilote, cf. docstring de bande_reglages_
    # capture plus bas) -- émis à chaque changement de résolution OU de
    # qualité sur la 3e ligne de contrôles (masquée par défaut, visible
    # uniquement en mode réseau). Même principe que rafraichir_button.
    # clicked/case_auto.toggled : un widget public directement câblable,
    # mais ici DEUX widgets combinés (deux combos) nécessitent un signal
    # dédié plutôt qu'un widget Qt natif unique à exposer tel quel.
    demande_preference_capture = Signal(str, int)

    def __init__(self, titre_apercu: str, parent=None, largeur_colonne_reglages: int = 260,
                 mode_bitmap_direct_capture: bool = False):
        super().__init__(parent)
        # AJOUT (spec D.1) -- simple relais vers ApercuDragHandle
        # (bouton_drag_capture, cf. sa construction plus bas) : seul
        # FenetreRenduTaskReseau passe True ici, tous les autres appelants
        # (InstanceApercuScreen, ProfilsInstancesScreen, CoordonneeAction-
        # Screen/self._panneau_rendu) gardent la valeur par défaut False,
        # comportement de copie strictement inchangé pour eux.
        self._mode_bitmap_direct_capture = mode_bitmap_direct_capture
        # CORRECTIF (retour utilisateur : "je voulais quil diminue cette
        # zone uniquement dans InstanceApercuScreen, pourquoi ça a aussi
        # coupé ailleurs") -- largeur_colonne_reglages est un PARAMÈTRE du
        # constructeur, plus une constante en dur dans cette classe.
        # PanneauRenduInstance est partagé par 4 écrans (InstanceApercuScreen,
        # FenetreRenduTaskReseau, ProfilsInstancesScreen, et
        # CoordonneeActionScreen/self._panneau_rendu) : la demande passée
        # "diviser cette largeur par 2 (260 -> 130), la rendre pliable" ne
        # visait QUE InstanceApercuScreen (seul appelant de
        # definir_colonne_reglages_repliee, cf. sa docstring) -- écrire
        # 130 directement ici avait donc rétréci la colonne PARTOUT,
        # y compris FenetreRenduTaskReseau (rendu réseau) où rien ne
        # justifiait ce rétrécissement et où le contenu (icône + libellé +
        # toggle + "Automatique" en largeur fixe, ou "2,00 in/s", "Élevé"...)
        # ne rentre plus à 130px. 260 redevient donc la largeur PAR DÉFAUT
        # de ce constructeur (identique au comportement d'avant la
        # régression pour tout appelant qui ne précise rien), et seul
        # InstanceApercuScreen passe explicitement largeur_colonne_
        # reglages=130 à la construction (cf. son appel plus bas).
        self._layout_racine = QVBoxLayout(self)
        self._layout_racine.setContentsMargins(0, 0, 0, 0)
        self._layout_racine.setSpacing(12)

        # --- Label indicatif TOUT EN HAUT du panneau (demande explicite :
        # "je veux aussi que tu mets un label indicatif en haut du
        # screen") -- avant, ce même texte (titre_apercu) était noyé dans
        # la bande de contrôles du bas ; il devient ici un vrai en-tête,
        # visuellement séparé, qui ne bouge jamais au toggle puisqu'il
        # n'est plus dans le même layout que les contrôles. ---
        self.titre_label = QLabel(titre_apercu, self)
        self.titre_label.setObjectName("ReglagesLabel")
        self.titre_label.setWordWrap(True)
        self.titre_label.setAlignment(Qt.AlignLeft | Qt.AlignVCenter)
        self._layout_racine.addWidget(self.titre_label)

        # --- Label "profil actif" (demande explicite utilisateur : "je
        # veux que le nom du profil actuel soit bien écrit ... je veux
        # dire, met un label en haut directement du panneau d'aperçu
        # d'instance") -- juste sous le titre, TOUJOURS visible, mis à
        # jour par definir_profil_actif() (cf. cette méthode) à chaque
        # changement de cible dans InstanceApercuScreen._on_instance_
        # changed. Distinct de titre_label : celui-ci est un texte FIXE
        # ("APERÇU DE L'INSTANCE CIBLE"), profil_label change à chaque
        # sélection -- avant ce patch, le seul indice du profil actif
        # était l'instance_id technique complet (ex.
        # "sautoniax-isole-xian1-7d07745a"), illisible et noyé tout en
        # bas de la page d'accueil affichée DANS le navigateur cible
        # (donc absent si l'instance affiche autre chose), jamais un
        # vrai élément d'UI d'AutoniaX lui-même.
        self.profil_label = QLabel("Profil actif : aucun", self)
        self.profil_label.setObjectName("ProfilActifLabel")
        self.profil_label.setWordWrap(True)
        self.profil_label.setAlignment(Qt.AlignLeft | Qt.AlignVCenter)
        self.profil_label.setStyleSheet(
            f"color: {Mocha.mauve}; font-size: 12px; font-weight: 600;"
        )
        # --- CORRECTIF (retour explicite utilisateur : le bouton de drag
        # de la capture doit être "à côté du label du nom de profil qui
        # est en haut de l'image", PAS dans bande_controles/colonne_
        # reglages -- cette dernière étant entièrement masquée/retirée
        # par TestComposantScreen, cf. _remplacer_colonne_reglages_par_
        # composant, ce qui rendait le bouton invisible sur cet écran).
        # ligne_profil : QHBoxLayout accueillant profil_label (stretch=1,
        # garde tout l'espace + le wrap existant) et bouton_drag_capture
        # posé juste à droite, sur la MÊME ligne, TOUJOURS visible quel
        # que soit l'écran hôte (InstanceApercuScreen, TestComposantScreen,
        # CoordonneeActionScreen...) puisque _layout_racine n'est, lui,
        # jamais masqué/retiré. bouton_drag_capture est construit ICI
        # (avant colonne_reglages/bande_controles plus bas) -- lambda :
        # self.apercu_label, comme avant, pour rester correct même si
        # CoordonneeActionScreen substitue ce widget en place après coup.
        #
        # AJOUT (exposés en self.*, alors que c'étaient de simples
        # variables locales -- demande explicite utilisateur, capture à
        # l'appui : les boutons de navigation < > entre images de test
        # doivent être "sur la même ligne que le nom du profil", cf.
        # TestComposantScreen._construire_barre_navigation_images_test)
        # -- permet à une sous-classe d'insérer un widget supplémentaire
        # sur CETTE MÊME ligne après coup, sans dupliquer sa construction
        # ici pour un besoin propre à un seul écran. Ne change RIEN au
        # comportement existant : ligne_profil/layout_ligne_profil restent
        # utilisés exactement comme avant dans cette méthode, seule leur
        # portée s'élargit (variable locale -> attribut public en plus).
        self.ligne_profil = ligne_profil = QWidget(self)
        self.layout_ligne_profil = layout_ligne_profil = QHBoxLayout(ligne_profil)
        layout_ligne_profil.setContentsMargins(0, 0, 0, 0)
        layout_ligne_profil.setSpacing(8)
        layout_ligne_profil.addWidget(self.profil_label, 1)
        self.bouton_drag_capture = ApercuDragHandle(
            lambda: self.apercu_label, self,
            texte_tooltip="Glisser la capture actuelle hors d'AutoniaX",
            mode_bitmap_direct=self._mode_bitmap_direct_capture,
        )
        layout_ligne_profil.addWidget(self.bouton_drag_capture, 0, Qt.AlignVCenter)
        self._layout_racine.addWidget(ligne_profil)

        # --- CORPS du panneau : HORIZONTAL -- image à gauche (stretch,
        # cf. addWidget(self.colonne_image, 1) plus bas), colonne de
        # réglages à droite (self.colonne_reglages, largeur contenue par
        # son contenu, PAS étirée). C'est ce layout, et non plus
        # _layout_racine, qui reçoit colonne_image et colonne_reglages. ---
        self._corps_layout = QHBoxLayout()
        self._corps_layout.setContentsMargins(0, 0, 0, 0)
        self._corps_layout.setSpacing(16)
        self._layout_racine.addLayout(self._corps_layout, 1)

        # --- Colonne de réglages À DROITE de l'image (CORRIGÉ -- demande
        # explicite : "on doit mettre ça sur une colonne ... ça doit
        # avoir sa colonne complète", l'ancienne disposition empilait ces
        # mêmes blocs sous l'image en pleine largeur, ce qui n'est pas
        # une colonne à côté). self.colonne_reglages est le widget conteneur
        # (largeur fixée par son contenu, cf. setSizePolicy plus bas),
        # layout_controles ci-dessous reste le layout VERTICAL interne
        # (PATCH B.2 -- un contrôle/groupe par ligne, inchangé) qui
        # empile Rafraîchir/Mode/Taux/Statut, puis bande_onglet et
        # bande_reglages_capture y sont ajoutées à la suite (cf. plus
        # bas, à la place de leur ancien addWidget sur _layout_racine). ---
        self.colonne_reglages = QWidget(self)
        self.colonne_reglages.setSizePolicy(QSizePolicy.Fixed, QSizePolicy.Expanding)
        # CORRECTIF (retour utilisateur, cf. docstring de __init__
        # ci-dessus) -- utilise désormais le paramètre largeur_colonne_
        # reglages plutôt qu'une valeur 130 en dur partagée par tous les
        # écrans utilisant PanneauRenduInstance.
        self.colonne_reglages.setFixedWidth(largeur_colonne_reglages)
        layout_colonne_reglages = QVBoxLayout(self.colonne_reglages)
        layout_colonne_reglages.setContentsMargins(0, 0, 0, 0)
        layout_colonne_reglages.setSpacing(14)

        # --- Bande de contrôles (PATCH B.2 -- demande explicite
        # utilisateur : "tout mettre en une seule colonne, un contrôle
        # par ligne") : layout VERTICAL, chaque contrôle/groupe sur sa
        # PROPRE ligne. Vit maintenant DANS colonne_reglages (à droite de
        # l'image) plutôt que sous l'image en pleine largeur. ---
        bande_controles = QWidget(self)
        layout_controles = QVBoxLayout(bande_controles)
        layout_controles.setContentsMargins(0, 0, 0, 0)
        layout_controles.setSpacing(10)

        # --- Ligne 1 : bouton Rafraîchir seul -- style plat/discret
        # (objectName dédié, cf. QSS #PanneauRenduBoutonRafraichir) plutôt
        # que le bouton plein standard : ce panneau doit rester minimaliste,
        # ce n'est pas une action principale d'écran. ---
        self.rafraichir_button = QPushButton(
            qta.icon("mdi6.image-refresh-outline", color=Mocha.text), " Rafraîchir", self
        )
        self.rafraichir_button.setObjectName("PanneauRenduBoutonRafraichir")
        self.rafraichir_button.setCursor(Qt.PointingHandCursor)
        self.rafraichir_button.setToolTip("Demande une image ponctuelle à l'instance cible")
        layout_controles.addWidget(self.rafraichir_button)

        # --- Ligne 2 : Mode (MANUEL <-> AUTOMATIQUE, cf. docstring
        # d'origine) -- interrupteur ON/OFF explicite avec libellé
        # dynamique "Manuel"/"Automatique" à côté, pour qu'il n'y ait
        # aucune ambiguïté sur l'état actuel, même sans lire l'infobulle.
        # Icône qtawesome discrète devant le libellé (mdi6.power-cycle,
        # même famille que rafraîchir/onglet ci-dessous) plutôt qu'un
        # texte "MODE :" en majuscules brut seul -- affinage visuel B.2.
        # Cette ligne reste HORIZONTALE en interne (c'est un seul
        # contrôle logique : icône + titre + case + libellé d'état) --
        # seul l'EMPILEMENT des groupes entre eux devient vertical (B.2),
        # pas chaque groupe pris isolément. ---
        ligne_mode = QWidget(self)
        layout_ligne_mode = QHBoxLayout(ligne_mode)
        layout_ligne_mode.setContentsMargins(0, 0, 0, 0)
        layout_ligne_mode.setSpacing(10)
        icone_mode = QLabel(self)
        icone_mode.setPixmap(qta.icon("mdi6.power-cycle", color=Mocha.overlay1).pixmap(15, 15))
        layout_ligne_mode.addWidget(icone_mode)
        label_mode_titre = QLabel("Mode", self)
        label_mode_titre.setObjectName("ReglagesLabel")
        layout_ligne_mode.addWidget(label_mode_titre)
        self.case_auto = QCheckBox(self)
        self.case_auto.setObjectName("ToggleSwitch")
        self.case_auto.setCursor(Qt.PointingHandCursor)
        self.case_auto.setToolTip(
            "Décoché : rafraîchissement manuel (bouton \"Rafraîchir\").\n"
            "Coché : rafraîchissement automatique en continu, au taux ci-dessous."
        )
        layout_ligne_mode.addWidget(self.case_auto)
        self.label_mode_auto = QLabel("Manuel", self)
        self.label_mode_auto.setObjectName("ReglagesLabel")
        # FIX (layout qui bouge au toggle) : largeur minimale réservée
        # sur le texte le plus long des deux états ("Automatique") --
        # sans ça, ce label rétrécit/s'élargit à chaque bascule et pousse
        # tout ce qui suit, donnant l'impression que tout l'écran "saute".
        # La largeur est calculée dynamiquement sur la police réelle du
        # label plutôt qu'une valeur en dur, pour rester correcte si le
        # thème/la police change.
        largeur_mode_max = self.label_mode_auto.fontMetrics().horizontalAdvance("Automatique")
        # setFixedWidth (pas setMinimumWidth) : une largeur MINIMALE
        # laisse Qt libre de l'agrandir légèrement selon l'algorithme
        # d'arrondi du layout (observé : 1px de différence entre "Manuel"
        # et "Automatique" malgré le minimum) -- une largeur FIXE élimine
        # toute variation résiduelle, le label ne peut plus jamais changer
        # de taille, quel que soit le texte qu'on lui donne.
        self.label_mode_auto.setFixedWidth(largeur_mode_max)
        layout_ligne_mode.addWidget(self.label_mode_auto)
        layout_ligne_mode.addStretch(1)
        self.case_auto.toggled.connect(
            lambda actif: self.label_mode_auto.setText("Automatique" if actif else "Manuel")
        )
        layout_controles.addWidget(ligne_mode)

        # --- Ligne 3 : Taux (spinbox FPS), sur sa propre ligne (B.2 --
        # anciennement accolé à Mode sur la même ligne horizontale).
        # Icône qtawesome discrète (mdi6.speedometer) devant le libellé,
        # même patron que la ligne Mode ci-dessus. ---
        ligne_taux = QWidget(self)
        layout_ligne_taux = QHBoxLayout(ligne_taux)
        layout_ligne_taux.setContentsMargins(0, 0, 0, 0)
        layout_ligne_taux.setSpacing(10)
        icone_taux = QLabel(self)
        icone_taux.setPixmap(qta.icon("mdi6.speedometer", color=Mocha.overlay1).pixmap(15, 15))
        layout_ligne_taux.addWidget(icone_taux)
        label_taux_titre = QLabel("Taux", self)
        label_taux_titre.setObjectName("ReglagesLabel")
        layout_ligne_taux.addWidget(label_taux_titre)
        self.fps_auto_spin = QDoubleSpinBox(self)
        self.fps_auto_spin.setObjectName("ReglagesSpin")
        self.fps_auto_spin.setRange(0.2, 30.0)
        self.fps_auto_spin.setSingleStep(0.5)
        self.fps_auto_spin.setValue(2.0)  # défaut volontairement bas -- jamais un flux lourd sans que
        # l'utilisateur ait explicitement choisi un taux plus élevé
        self.fps_auto_spin.setSuffix(" im/s")
        layout_ligne_taux.addWidget(self.fps_auto_spin)
        layout_ligne_taux.addStretch(1)
        layout_controles.addWidget(ligne_taux)

        # --- Ligne 4 : Statut de rafraîchissement, sur sa propre ligne
        # (B.2 -- anciennement en fin de la même ligne horizontale que
        # Rafraîchir/Mode/Taux, avec stretch=1 pour absorber l'espace
        # restant ; ce stretch n'a plus de sens en colonne, retiré).
        #
        # BUG CORRIGÉ CONSERVÉ (historique) : self.label_statut_
        # rafraichissement était créé mais JAMAIS ajouté au layout par un
        # refactor précédent (aucun addWidget correspondant) -- un widget
        # enfant Qt hors de tout layout ne suit pas le système de tailles
        # du layout parent, ce qui peut provoquer des positions/tailles
        # incohérentes au moindre repaint. Ajouté ici, sur sa ligne.
        #
        # FIX CONSERVÉ (cause RÉELLE du layout qui bougeait au toggle) :
        # ce label change de texte dynamiquement (_rafraichir_statut_
        # rafraichissement) entre une version longue ("désactivé --
        # utilisez le bouton...") et une version courte ("actif (2.0
        # im/s)."). Un QLabel standard recalcule son sizeHint (largeur ET,
        # avec WordWrap, hauteur) à CHAQUE changement de texte, et ce
        # sizeHint remonte jusqu'au panneau entier -> jusqu'au stretch
        # factor du _main_layout parent -> toute la fenêtre semblait
        # "sauter" au toggle. Fixé DÉFINITIVEMENT via setFixedHeight (une
        # ligne, hauteur qui ne varie jamais) + élision du texte trop long
        # avec "…" au lieu de wrap (cf. _rafraichir_statut_rafraichissement,
        # qui appelle elidedText à chaque mise à jour) -- le texte complet
        # reste consultable via le tooltip.
        self.label_statut_rafraichissement = LabelStatutElide("Rafraîchissement automatique désactivé.", self)
        self.label_statut_rafraichissement.setStyleSheet(f"color: {Mocha.subtext0}; font-size: 11px;")
        layout_controles.addWidget(self.label_statut_rafraichissement)

        # --- Deuxième ligne de la bande du bas : "Onglet navigateur"
        # (listTabs/switchTab, cf. action_list_tabs/action_switch_tab
        # côté instance_nodriver.py) -- CORRIGÉ : ce bloc vivait au
        # départ dans la colonne de réglages à GAUCHE de
        # InstanceApercuScreen (widget séparé de ce panneau), ce qui le
        # rendait invisible pour tout écran qui compose ce panneau
        # directement sans hériter d'InstanceApercuScreen (cf.
        # DashboardScreen, qui instancie son PROPRE PanneauRenduInstance,
        # cf. sa docstring "seul le RENDU est partagé, en composition").
        # Un contrôle qui pilote le RENDU (quel onglet du navigateur est
        # affiché/capturé) est un paramètre du RENDU lui-même, pas un
        # réglage propre au composant/action testé -- il doit vivre ICI,
        # dans PanneauRenduInstance, exactement comme Rafraîchir/Mode/
        # Taux, pour que DashboardScreen le récupère automatiquement en
        # composant ce panneau, sans rien dupliquer. Sur sa PROPRE ligne
        # (pas ajouté à layout_controles ci-dessus) : la première ligne
        # est déjà dense (5 widgets + stretch), un 6e groupe la
        # comprimerait au lieu de rester lisible.
        # PUBLIC (self.bande_onglet, pas une variable locale) -- même
        # patron que self.bande_reglages_capture plus bas : nécessaire
        # pour que FenetreRenduTaskReseau puisse la masquer explicitement
        # PAR RÉFÉRENCE (cf. son __init__), plutôt que de deviner sa
        # position dans _layout_racine via itemAt(count()-1), qui ciblait
        # à tort bande_reglages_capture (ajoutée APRÈS bande_onglet,
        # cf. ordre des addWidget ci-dessous) -- BUG CORRIGÉ : "Onglet
        # navigateur"/"Aucune instance liée." restait visible en mode
        # réseau (sans objet pour Camoufox headless distant, cf. docstring
        # de FenetreRenduTaskReseau) alors que c'est Résolution/Qualité
        # qui était masqué par erreur puis immédiatement réaffiché par
        # definir_reglages_capture_reseau_visibles(True).
        self.bande_onglet = QWidget(self)
        bande_onglet = self.bande_onglet
        layout_onglet = QHBoxLayout(bande_onglet)
        layout_onglet.setContentsMargins(0, 0, 0, 0)
        layout_onglet.setSpacing(16)

        icone_onglet = QLabel(self)
        icone_onglet.setPixmap(qta.icon("mdi6.tab", color=Mocha.overlay1).pixmap(15, 15))
        layout_onglet.addWidget(icone_onglet)
        label_onglet_titre = QLabel("Onglet", self)
        label_onglet_titre.setObjectName("ReglagesLabel")
        layout_onglet.addWidget(label_onglet_titre)
        self.onglet_combo = ComboBoxAvecFermeturePopup(self)
        self.onglet_combo.setObjectName("ReglagesCombo")
        self.onglet_combo.setEnabled(False)
        layout_onglet.addWidget(self.onglet_combo, 1)
        self.rafraichir_onglets_button = QToolButton(self)
        self.rafraichir_onglets_button.setIcon(qta.icon("mdi6.refresh", color=Mocha.text))
        self.rafraichir_onglets_button.setCursor(Qt.PointingHandCursor)
        self.rafraichir_onglets_button.setToolTip("Redemander la liste des onglets ouverts à l'instance liée")
        self.rafraichir_onglets_button.setEnabled(False)
        layout_onglet.addWidget(self.rafraichir_onglets_button)
        self.label_statut_onglets = LabelStatutElide("Aucune instance liée.", self)
        self.label_statut_onglets.setStyleSheet(f"color: {Mocha.subtext0}; font-size: 11px;")
        layout_onglet.addWidget(self.label_statut_onglets, 1)

        # --- Zone du MILIEU : l'image SEULE -- droite_layout ne gère QUE
        # apercu_label, pour que le contrat avec CoordonneeActionScreen
        # (indexOf/removeWidget/insertWidget sur un layout à un seul
        # widget) reste valide après la restructuration. Exposée comme
        # attribut public (colonne_image) pour qu'InstanceApercuScreen
        # puisse aliasser _colonne_droite dessus, pas sur le panneau
        # entier -- le parent Qt du futur ApercuTraceableLabel doit être
        # cette sous-zone, cohérente avec droite_layout. Le nom
        # "colonne_image"/"droite_layout" est conservé tel quel (contrat
        # d'attributs existant avec CoordonneeActionScreen) même si la
        # disposition n'est plus une colonne à droite mais une zone
        # centrale -- seul le nom historique reste, pas la géométrie
        # qu'il décrivait à l'origine. ---
        self.colonne_image = QWidget(self)
        self.droite_layout = QVBoxLayout(self.colonne_image)
        self.droite_layout.setContentsMargins(0, 0, 0, 0)

        # CHANGEMENT (demande explicite utilisateur : "lechelle a
        # linterireru de limage doit etre reel et si les pace ne suffit
        # pas sa doit etre une zone scrollabale en hauter et width") --
        # inverse volontairement l'ancien comportement décrit ci-dessous
        # (qui étirait/réduisait toujours le pixmap pour remplir tout
        # l'espace) : apercu_label est maintenant affiché à sa taille
        # RÉELLE en pixels (échelle 1:1, jamais mis à l'échelle), posé
        # dans un QScrollArea qui fait apparaître des barres de
        # défilement horizontale ET verticale dès que l'espace du
        # panneau devient plus petit que l'image, plutôt que de la
        # redimensionner. setWidgetResizable(False) est ESSENTIEL ici :
        # à True (comportement par défaut le plus courant), le
        # QScrollArea forcerait au contraire apercu_label à occuper
        # toute la zone visible, ce qui annulerait l'échelle réelle
        # demandée.
        #
        # ANCIEN COMPORTEMENT (conservé en historique, désormais
        # inversé) : un QLabel simple n'étire jamais son pixmap pour
        # remplir l'espace disponible -- LabelApercuRedimensionnable +
        # Expanding/Expanding + signal redimensionne recalculaient le
        # pixmap à la bonne taille à chaque resize, et les scrollbars
        # étaient alors considérées comme un bug à éliminer plutôt
        # qu'un comportement voulu.
        self.apercu_label = LabelApercuRedimensionnable(self)
        self.apercu_label.setAlignment(Qt.AlignCenter)
        self.apercu_label.setObjectName("ComposantTuileImageFrame")

        self.apercu_scroll = QScrollArea(self)
        self.apercu_scroll.setObjectName("ApercuScrollArea")
        self.apercu_scroll.setFrameShape(QFrame.NoFrame)
        # False : le scroll area ne redimensionne PAS son widget interne
        # pour l'ajuster à la zone visible -- apercu_label garde la
        # taille qu'on lui donne explicitement (cf. resize(pixmap.size())
        # dans chaque endroit qui pose un pixmap), condition nécessaire
        # pour que l'échelle réelle 1:1 soit respectée.
        self.apercu_scroll.setWidgetResizable(False)
        self.apercu_scroll.setHorizontalScrollBarPolicy(Qt.ScrollBarAsNeeded)
        self.apercu_scroll.setVerticalScrollBarPolicy(Qt.ScrollBarAsNeeded)
        self.apercu_scroll.setWidget(self.apercu_label)
        self.apercu_scroll.setMinimumSize(320, 200)
        self.apercu_scroll.setSizePolicy(QSizePolicy.Expanding, QSizePolicy.Expanding)
        self.droite_layout.addWidget(self.apercu_scroll, 1)

        # --- Assemblage CORRIGÉ : colonne_image va dans le CORPS
        # horizontal (_corps_layout), stretch=1 -- elle prend tout
        # l'espace restant une fois la colonne de réglages posée à côté,
        # à sa largeur naturelle. bande_controles et bande_onglet ne vont
        # PLUS sous l'image (ancienne disposition, empilement pleine
        # largeur) mais DANS layout_colonne_reglages, qui est la colonne
        # verticale à DROITE de l'image -- c'est ça, la "colonne
        # complète" demandée : tous ces blocs vivent ensemble, empilés,
        # dans une zone latérale dédiée, jamais sous le rendu. ---
        self._corps_layout.addWidget(self.colonne_image, 1)
        layout_colonne_reglages.addWidget(bande_controles)
        layout_colonne_reglages.addWidget(bande_onglet)

        # --- Troisième ligne, RÉSEAU UNIQUEMENT : "Qualité" (PATCH
        # recompression par pilote -- demande explicite utilisateur,
        # après une première tentative mal placée dans l'onglet
        # Instances sAutoniax de la sidebar : "je disait que tu mets
        # plutôt cest paramètre dans le panneau de rendue" -- donc ICI,
        # à côté de Rafraîchir/MODE/Taux, pas ailleurs). Masquée par
        # défaut (comme bande_onglet ci-dessus) : n'a de sens QUE pour un
        # rendu RÉSEAU (sAutoniax distant, cf. FenetreRenduTaskReseau) --
        # un rendu LOCAL (instance nodriver sur cette même machine, cf.
        # InstanceApercuScreen/DashboardScreen) n'a rien à recompresser,
        # l'image ne transite jamais par le serveurT dans ce cas. Rendue
        # visible explicitement via definir_reglages_capture_reseau_
        # visibles(True), appelée UNIQUEMENT par FenetreRenduTaskReseau
        # -- jamais par défaut, même principe que bande_onglet masquée
        # par défaut ci-dessus.
        #
        # CHANGEMENT (demande explicite utilisateur : "cest au serveur
        # que sa doit compresser ... je veux que dans les parametre de
        # rendue tu mets le parametre de compressioon : 100, 50, 10,
        # webp biensure" + "sa ne doit plus redimensionner ... pourquoi
        # sa ne veux pas juste diminuer la qualiter") -- ancien combo
        # "Résolution" (Économie 240p / Moyen 360p / Qualité origine,
        # qui redimensionnait réellement l'image côté serveurT, cf.
        # RESOLUTIONS_HAUTEUR_PX côté serveur.py) REMPLACÉ par un combo
        # "Qualité" : pilote UNIQUEMENT le paramètre `quality` de la
        # recompression WebP côté serveurT (_recompresser_pour_diffusion,
        # img.resize() entièrement retiré côté serveur) -- les dimensions
        # en pixels envoyées restent TOUJOURS celles de la capture
        # source, quel que soit le niveau choisi ; seule la taille du
        # fichier (donc la netteté) varie. ---
        self.bande_reglages_capture = QWidget(self)
        self.bande_reglages_capture.setVisible(False)
        layout_reglages_capture = QVBoxLayout(self.bande_reglages_capture)
        layout_reglages_capture.setContentsMargins(0, 0, 0, 0)
        layout_reglages_capture.setSpacing(10)

        ligne_qualite = QWidget(self)
        layout_ligne_qualite = QHBoxLayout(ligne_qualite)
        layout_ligne_qualite.setContentsMargins(0, 0, 0, 0)
        layout_ligne_qualite.setSpacing(10)
        icone_qualite = QLabel(self)
        icone_qualite.setPixmap(qta.icon("mdi6.image-size-select-large", color=Mocha.overlay1).pixmap(15, 15))
        layout_ligne_qualite.addWidget(icone_qualite)
        label_qualite_titre = QLabel("Qualité", self)
        label_qualite_titre.setObjectName("ReglagesLabel")
        layout_ligne_qualite.addWidget(label_qualite_titre)
        # (libellé affiché, valeur protocole = qualité WebP réelle
        # transmise à _recompresser_pour_diffusion côté serveur.py,
        # synchronisée avec QUALITES_AUTORISEES = {100, 50, 10}).
        self.QUALITES_CAPTURE_AFFICHEES = [
            ("Élevée (100)", 100),
            ("Moyenne (50)", 50),
            ("Basse (10)", 10),
            ("Très basse (5)", 5),
        ]
        self.combo_qualite_capture = QComboBox(self)
        self.combo_qualite_capture.setObjectName("RenduComboResolution")
        for libelle, _valeur in self.QUALITES_CAPTURE_AFFICHEES:
            self.combo_qualite_capture.addItem(libelle)
        self.combo_qualite_capture.setCurrentIndex(0)  # 100 -- fidèle par défaut, comme avant
        self.combo_qualite_capture.currentIndexChanged.connect(self._sur_reglage_capture_change)
        layout_ligne_qualite.addWidget(self.combo_qualite_capture)
        layout_ligne_qualite.addStretch(1)
        layout_reglages_capture.addWidget(ligne_qualite)

        # --- Amplitude de scroll (PATCH -- demande utilisateur explicite :
        # "je veux que cette valeur constante, on passe en paramètre dans
        # le panneau de rendu, donc ça sera un entry de scroll") -- pilote
        # l'amplitude du wheel() unique envoyé par la nouvelle action
        # "scroll_simple" (cf. action_camoufox_scroll_simple côté
        # AutoniaX.py, qui n'a plus de constante WHEEL_DELTA figée en dur :
        # la valeur vient maintenant du protocole, transmise ici). Ne
        # concerne QUE scroll_simple -- l'ancienne action "scroll"
        # (humanisée, cf. action_camoufox_scroll) reste inchangée et
        # n'utilise pas ce réglage. ---
        ligne_scroll = QWidget(self)
        layout_ligne_scroll = QHBoxLayout(ligne_scroll)
        layout_ligne_scroll.setContentsMargins(0, 0, 0, 0)
        layout_ligne_scroll.setSpacing(10)
        icone_scroll = QLabel(self)
        icone_scroll.setPixmap(qta.icon("mdi6.mouse-move-vertical", color=Mocha.overlay1).pixmap(15, 15))
        layout_ligne_scroll.addWidget(icone_scroll)
        label_scroll_titre = QLabel("Amplitude scroll", self)
        label_scroll_titre.setObjectName("ReglagesLabel")
        layout_ligne_scroll.addWidget(label_scroll_titre)
        self.spin_amplitude_scroll = QSpinBox(self)
        self.spin_amplitude_scroll.setObjectName("ReglagesSpin")
        self.spin_amplitude_scroll.setRange(10, 1000)
        self.spin_amplitude_scroll.setSingleStep(10)
        self.spin_amplitude_scroll.setValue(120)  # cran standard d'une molette (ex-WHEEL_DELTA)
        layout_ligne_scroll.addWidget(self.spin_amplitude_scroll)
        layout_ligne_scroll.addStretch(1)
        layout_reglages_capture.addWidget(ligne_scroll)

        layout_colonne_reglages.addWidget(self.bande_reglages_capture)

        # --- PATCH B.4 (contrôle à distance réel, cf. cahier des charges
        # patchs.md) : toggle "Contrôle à distance" -- même principe de
        # visibilité que bande_reglages_capture juste au-dessus (masqué
        # par défaut, rendu visible UNIQUEMENT par FenetreRenduTaskReseau
        # via definir_controle_distance_visible, jamais pour un rendu
        # LOCAL -- piloter une instance nodriver locale se fait déjà
        # directement à la souris/clavier sur la vraie fenêtre du
        # navigateur, pas à travers ce panneau). Widget public
        # (self.bande_controle_distance/self.case_controle_distance) --
        # c'est FenetreRenduTaskReseau qui écoute case_controle_distance.
        # toggled pour activer/désactiver la capture d'événements sur
        # apercu_label (cf. son __init__ et son eventFilter).
        self.bande_controle_distance = QWidget(self)
        self.bande_controle_distance.setVisible(False)
        layout_controle_distance = QHBoxLayout(self.bande_controle_distance)
        layout_controle_distance.setContentsMargins(0, 0, 0, 0)
        layout_controle_distance.setSpacing(10)
        icone_controle_distance = QLabel(self)
        icone_controle_distance.setPixmap(qta.icon("mdi6.cursor-default-click", color=Mocha.overlay1).pixmap(15, 15))
        layout_controle_distance.addWidget(icone_controle_distance)
        label_controle_distance_titre = QLabel("Contrôle à distance", self)
        label_controle_distance_titre.setObjectName("ReglagesLabel")
        layout_controle_distance.addWidget(label_controle_distance_titre)
        self.case_controle_distance = QCheckBox(self)
        self.case_controle_distance.setObjectName("ToggleSwitch")
        self.case_controle_distance.setCursor(Qt.PointingHandCursor)
        self.case_controle_distance.setToolTip(
            "Coché : clic, double-clic, scroll et saisie clavier sur "
            "l'image ci-dessus sont rejoués dans l'instance distante -- le clic génère "
            "lui-même sa trajectoire jusqu'au point visé, le mouvement de la souris "
            "n'est pas relayé en direct."
        )
        layout_controle_distance.addWidget(self.case_controle_distance)
        # Glisser (souris) manuel : bouton à cocher, puis DEUX clics sur
        # l'aperçu (départ, puis arrivée) -> l'action "mouse_drag" est
        # envoyée au sAutoniax. Géré par FenetreRenduTaskReseau.
        self.bouton_glisser_souris = QPushButton("Glisser", self)
        self.bouton_glisser_souris.setCheckable(True)
        self.bouton_glisser_souris.setCursor(Qt.PointingHandCursor)
        self.bouton_glisser_souris.setToolTip(
            "Glisser (souris) : active, puis clique sur l'aperçu au point de départ, "
            "puis au point d'arrivée. Clic droit = annuler. Active le contrôle à distance si besoin."
        )
        layout_controle_distance.addWidget(self.bouton_glisser_souris)
        layout_controle_distance.addStretch(1)
        layout_colonne_reglages.addWidget(self.bande_controle_distance)

        # --- Toggle "Ajuster à la fenêtre" (DÉPLACÉ ICI depuis
        # FenetreRenduTaskReseau -- retour utilisateur : "je veux que tu
        # laffiche a la taille diponible avec les slide, je ne veux pas
        # que le contenue soit comprimer" -- le widget existait déjà côté
        # FenetreRenduTaskReseau, mais créé SANS jamais être ajouté à un
        # layout visible en usage embarqué normal : il n'était inséré que
        # par _construire_entete_panneau_flottant, appelée UNIQUEMENT en
        # mode overlay plein écran (_preparer_mode_overlay/afficher_par_
        # dessus_tout) -- donc invisible/inaccessible pour tout usage
        # EMBARQUÉ de FenetreRenduTaskReseau dans une zone fixe d'un
        # layout normal (ex. TestComposantScreen en mode réseau), qui
        # n'appelle jamais ce mode overlay. Même principe de visibilité
        # que bande_controle_distance/bande_reglages_capture ci-dessus :
        # masqué par défaut ici (rendu local n'en a pas besoin, son
        # apercu_scroll reste toujours en échelle réelle), révélé
        # UNIQUEMENT par FenetreRenduTaskReseau via definir_ajuster_a_la_
        # fenetre_visible -- que ce soit en mode embarqué (ce panneau
        # reste posé normalement dans _corps_layout, cf. docstring de
        # classe) ou overlay (ce widget est alors réparenté par
        # _construire_entete_panneau_flottant, comme les autres widgets
        # de l'en-tête flottant -- fonctionne dans les deux cas, un seul
        # widget Qt, jamais dupliqué). ---
        self.bande_ajuster_a_la_fenetre = QWidget(self)
        self.bande_ajuster_a_la_fenetre.setVisible(False)
        layout_ajuster_a_la_fenetre = QHBoxLayout(self.bande_ajuster_a_la_fenetre)
        layout_ajuster_a_la_fenetre.setContentsMargins(0, 0, 0, 0)
        layout_ajuster_a_la_fenetre.setSpacing(10)
        icone_ajuster = QLabel(self)
        icone_ajuster.setPixmap(qta.icon("mdi6.arrow-expand-all", color=Mocha.overlay1).pixmap(15, 15))
        layout_ajuster_a_la_fenetre.addWidget(icone_ajuster)
        label_ajuster_titre = QLabel("Ajuster à la fenêtre", self)
        label_ajuster_titre.setObjectName("ReglagesLabel")
        layout_ajuster_a_la_fenetre.addWidget(label_ajuster_titre)
        self.case_ajuster_a_la_fenetre = QCheckBox(self)
        self.case_ajuster_a_la_fenetre.setObjectName("ToggleSwitch")
        self.case_ajuster_a_la_fenetre.setCursor(Qt.PointingHandCursor)
        self.case_ajuster_a_la_fenetre.setChecked(False)
        self.case_ajuster_a_la_fenetre.setToolTip(
            "Décoché (par défaut) : l'image est affichée à sa taille réelle\n"
            "(échelle 1:1, qui varie selon la résolution du fingerprint du\n"
            "profil) -- des barres de défilement apparaissent si besoin.\n"
            "Coché : l'image est redimensionnée pour tenir dans le panneau,\n"
            "ratio conservé (peut légèrement flouter l'image)."
        )
        layout_ajuster_a_la_fenetre.addWidget(self.case_ajuster_a_la_fenetre)
        layout_ajuster_a_la_fenetre.addStretch(1)
        layout_colonne_reglages.addWidget(self.bande_ajuster_a_la_fenetre)

        # --- Section pliable "Profil" (AJOUT -- demande explicite
        # utilisateur : "je veux que on affiche les donnee sur le
        # proxy, address proxy, pays, du profils que on utilise, nom
        # du profils ... silya pas de proxy on mais juste none au pays
        # et proxy" + "tu ne dois pas saturer l'interface avec tu mets
        # ces propriétés supplémentaires dans un plié et déplié") --
        # même principe de visibilité que bande_controle_distance
        # au-dessus (masquée par défaut, rendue visible UNIQUEMENT par
        # FenetreRenduTaskReseau via definir_infos_profil_visibles,
        # jamais pour un rendu LOCAL -- un profil réseau distant a un
        # proxy/pays potentiellement pertinents à surveiller pendant
        # l'exécution, un profil LOCAL nodriver n'a pas cette notion
        # dans ce panneau). Repliée par défaut (self._profil_infos_
        # pliee = True) pour ne pas alourdir visuellement le panneau --
        # seul l'en-tête (icône + "Profil" + chevron) reste visible tant
        # qu'on ne clique pas dessus.
        self.bande_infos_profil = QWidget(self)
        self.bande_infos_profil.setVisible(False)
        layout_infos_profil = QVBoxLayout(self.bande_infos_profil)
        layout_infos_profil.setContentsMargins(0, 0, 0, 0)
        layout_infos_profil.setSpacing(6)

        self._profil_infos_pliee = True
        entete_profil = QWidget(self)
        entete_profil.setCursor(Qt.PointingHandCursor)
        layout_entete_profil = QHBoxLayout(entete_profil)
        layout_entete_profil.setContentsMargins(0, 0, 0, 0)
        layout_entete_profil.setSpacing(10)
        icone_profil = QLabel(self)
        icone_profil.setPixmap(qta.icon("mdi6.account-badge-outline", color=Mocha.overlay1).pixmap(15, 15))
        layout_entete_profil.addWidget(icone_profil)
        label_profil_titre = QLabel("Profil", self)
        label_profil_titre.setObjectName("ReglagesLabel")
        layout_entete_profil.addWidget(label_profil_titre)
        layout_entete_profil.addStretch(1)
        self._chevron_infos_profil = QLabel(self)
        self._chevron_infos_profil.setPixmap(qta.icon("mdi6.chevron-right", color=Mocha.subtext0).pixmap(16, 16))
        layout_entete_profil.addWidget(self._chevron_infos_profil)
        entete_profil.mousePressEvent = lambda event: self._basculer_infos_profil()
        layout_infos_profil.addWidget(entete_profil)

        self._corps_infos_profil = QWidget(self)
        self._corps_infos_profil.setVisible(False)
        layout_corps_infos_profil = QVBoxLayout(self._corps_infos_profil)
        layout_corps_infos_profil.setContentsMargins(23, 2, 0, 0)
        layout_corps_infos_profil.setSpacing(3)

        def _creer_ligne_info(libelle: str) -> QLabel:
            ligne = QLabel(f"{libelle} : —", self)
            ligne.setObjectName("ReglagesLabel")
            ligne.setWordWrap(True)
            layout_corps_infos_profil.addWidget(ligne)
            return ligne

        self._label_profil_nom = _creer_ligne_info("Nom")
        self._label_profil_proxy = _creer_ligne_info("Proxy")
        self._label_profil_pays = _creer_ligne_info("Pays")
        layout_infos_profil.addWidget(self._corps_infos_profil)

        layout_colonne_reglages.addWidget(self.bande_infos_profil)

        # --- Terminal de sortie (AJOUT -- demande explicite utilisateur :
        # "rajouter un terminal de sortie lorsqu'on exécute un notebook
        # sur une instance, le terminal du panneau de task doit renvoyer
        # les sorties de cellule") -- zone de texte en lecture seule,
        # style console, qui affiche au fil de l'eau les lignes de sortie
        # (print(), erreurs, etc.) de la cellule de notebook en cours
        # d'exécution en mode réseau sur l'instance ciblée par CE panneau.
        # Masqué par défaut (même patron que bande_reglages_capture/
        # bande_controle_distance ci-dessus) : n'a de sens QUE pour un
        # rendu RÉSEAU (FenetreRenduTaskReseau), pas pour un rendu LOCAL
        # (InstanceApercuScreen/DashboardScreen, qui n'exécutent pas de
        # notebook à travers ce panneau) -- rendu visible explicitement
        # via definir_terminal_visible(True), même principe que
        # definir_reglages_capture_reseau_visibles/definir_controle_
        # distance_visible.
        #
        # QTextEdit (pas QPlainTextEdit, qui ne peut afficher QUE du texte
        # brut) : ce terminal reste capable d'afficher des images inline
        # via ajouter_image_terminal ci-dessous si un appelant le
        # souhaite, mais ce N'EST PLUS le chemin utilisé par Image.view()
        # (cf. TaskConfigScreen.sur_image_execution_reseau_recu, qui
        # pousse désormais l'image dans la sortie de la cellule elle-même,
        # zone_sortie -- demande explicite utilisateur, revert d'une
        # décision précédente qui ciblait ce terminal). Conservé tel quel
        # (widget + méthode toujours fonctionnels, juste non câblés à ce
        # flux) plutôt que supprimé, au cas où un affichage EN PLUS dans
        # ce terminal serait un jour voulu.
        self.bande_terminal = QWidget(self)
        self.bande_terminal.setVisible(False)
        layout_terminal = QVBoxLayout(self.bande_terminal)
        layout_terminal.setContentsMargins(0, 0, 0, 0)
        layout_terminal.setSpacing(6)

        ligne_titre_terminal = QHBoxLayout()
        ligne_titre_terminal.setContentsMargins(0, 0, 0, 0)
        ligne_titre_terminal.setSpacing(10)
        icone_terminal = QLabel(self)
        icone_terminal.setPixmap(qta.icon("mdi6.console-line", color=Mocha.overlay1).pixmap(15, 15))
        ligne_titre_terminal.addWidget(icone_terminal)
        label_terminal_titre = QLabel("Terminal", self)
        label_terminal_titre.setObjectName("ReglagesLabel")
        ligne_titre_terminal.addWidget(label_terminal_titre)
        ligne_titre_terminal.addStretch(1)
        # PATCH (demande explicite utilisateur : "je veux que tu ajoute
        # un mini bouton qui vas permetre de copier ces sortie") --
        # placé AVANT le bouton effacer (ordre lecture naturel : on
        # copie avant d'effacer, pas l'inverse), même style/taille que
        # bouton_effacer_terminal_rendu pour rester cohérent.
        self.bouton_copier_terminal_rendu = QToolButton(self)
        self.bouton_copier_terminal_rendu.setIcon(qta.icon("mdi6.content-copy", color=Mocha.overlay1))
        self.bouton_copier_terminal_rendu.setIconSize(QSize(14, 14))
        self.bouton_copier_terminal_rendu.setCursor(Qt.PointingHandCursor)
        self.bouton_copier_terminal_rendu.setToolTip("Copier la sortie du terminal")
        self.bouton_copier_terminal_rendu.clicked.connect(self.copier_terminal)
        ligne_titre_terminal.addWidget(self.bouton_copier_terminal_rendu)

        self.bouton_effacer_terminal_rendu = QToolButton(self)
        self.bouton_effacer_terminal_rendu.setIcon(qta.icon("mdi6.notification-clear-all", color=Mocha.overlay1))
        self.bouton_effacer_terminal_rendu.setIconSize(QSize(14, 14))
        self.bouton_effacer_terminal_rendu.setCursor(Qt.PointingHandCursor)
        self.bouton_effacer_terminal_rendu.setToolTip("Effacer le terminal")
        self.bouton_effacer_terminal_rendu.clicked.connect(self.effacer_terminal)
        ligne_titre_terminal.addWidget(self.bouton_effacer_terminal_rendu)
        layout_terminal.addLayout(ligne_titre_terminal)

        self.terminal_sortie = QTextEdit(self)
        self.terminal_sortie.setObjectName("PanneauRenduTerminal")
        self.terminal_sortie.setReadOnly(True)
        self.terminal_sortie.setUndoRedoEnabled(False)
        # PATCH (demande explicite utilisateur : "je veux que le terminal
        # affiche aussi les images ... laffichage de limage dans le
        # terminal") -- QTextEdit remplace QPlainTextEdit : ce dernier ne
        # peut afficher QUE du texte brut, aucune image inline possible.
        # QTextEdit gère du rich text (QTextDocument), ce qui permet
        # d'insérer une image directement dans le flux du terminal, à côté
        # des lignes de log, via ajouter_image_terminal ci-dessous.
        # NOTE : Image.view() ne câble PLUS ce terminal (cf. commentaire
        # juste au-dessus) -- ce mécanisme reste néanmoins fonctionnel,
        # utilisable par un autre appelant.
        self.terminal_sortie.setLineWrapMode(QTextEdit.WidgetWidth)
        self.terminal_sortie.setPlaceholderText("En attente de la sortie d'une cellule...")
        # Police monospace -- lisibilité d'un terminal réel (alignement
        # des colonnes, tracebacks, etc.), cohérent avec l'éditeur de
        # code du reste de l'app.
        police_terminal = QFont("Consolas")
        police_terminal.setStyleHint(QFont.Monospace)
        police_terminal.setPointSize(9)
        self.terminal_sortie.setFont(police_terminal)
        self.terminal_sortie.setStyleSheet(
            f"QTextEdit#PanneauRenduTerminal {{"
            f"background-color: {Mocha.crust};"
            f"color: {Mocha.text};"
            f"border: 1px solid {Mocha.surface0};"
            f"border-radius: 6px;"
            f"padding: 6px;"
            f"}}"
        )
        # Hauteur minimale contenue (pas Expanding sans limite) : ce
        # panneau garde une colonne de largeur fixe, le terminal doit
        # rester lisible sans écraser les contrôles au-dessus lorsqu'il
        # est peu de temps après leur ajout -- stretch=1 (cf. addWidget
        # plus bas) lui laisse absorber l'espace vertical restant une
        # fois les autres blocs posés, exactement comme apercu_scroll le
        # fait pour l'image à gauche.
        self.terminal_sortie.setMinimumHeight(160)
        layout_terminal.addWidget(self.terminal_sortie, 1)

        layout_colonne_reglages.addWidget(self.bande_terminal, 1)

        # --- Stretch en BAS de la colonne de réglages : sans lui, les
        # blocs (Rafraîchir/Mode/Taux/Statut, Onglet, Résolution-Qualité)
        # seraient étirés pour occuper toute la hauteur du panneau (même
        # comportement que l'image à côté, qui est en Expanding) -- ce
        # stretch absorbe l'espace vertical restant à la place des
        # contrôles, qui gardent leur hauteur naturelle groupée en haut
        # de colonne, alignés avec le haut de l'image. ---
        layout_colonne_reglages.addStretch(1)

        # --- Colonne de réglages ajoutée au CORPS horizontal, à la suite
        # de colonne_image (déjà ajoutée plus haut, stretch=1) -- stretch
        # implicite 0 ici : la colonne garde la largeur de son contenu,
        # elle ne se dispute pas l'espace avec l'image. ---
        self._corps_layout.addWidget(self.colonne_reglages)

        # État de repli -- cf. definir_colonne_reglages_repliee. Reprend
        # la largeur réellement passée au constructeur (paramètre
        # largeur_colonne_reglages), plus une valeur 130 en dur qui ne
        # correspondait qu'au cas InstanceApercuScreen.
        self._largeur_colonne_reglages_normale = largeur_colonne_reglages
        self._colonne_reglages_repliee = False

    def definir_image_composant_teste_factory(self, factory):
        """PATCH (demande explicite utilisateur : "je veux maintenant que
        ce bouton de drag prend l'image actuelle mais aussi l'image du
        composant qui est testé") -- setter public permettant à un écran
        hôte de brancher, APRÈS coup, la factory de la 2e image du drag
        (cf. docstring complète de ApercuDragHandle, paramètre image_
        composant_teste_factory). PanneauRenduInstance reste générique et
        partagé (DashboardScreen/CoordonneeActionScreen l'utilisent aussi
        sans notion de "composant testé") -- seul TestComposantScreen
        appelle ce setter, juste après super().__init__() (cf. son
        __init__), puisqu'il ne peut pas passer ce paramètre directement
        au constructeur de ce panneau.

        factory : callable() -> Optional[Path], réévaluée à CHAQUE drag
        (jamais figée) -- TestComposantScreen y résout systématiquement
        le composant ACTUELLEMENT sélectionné au moment du drag, jamais
        celui qui l'était lors de l'appel à ce setter."""
        self.bouton_drag_capture._image_composant_teste_factory = factory

    def definir_colonne_reglages_repliee(self, repliee: bool):
        """PATCH (demande explicite utilisateur : "le paneau de control
        qui est a droit doit etre aussi pliable, donc affihcer audessus")
        -- masque/affiche colonne_reglages EN LARGEUR (setFixedWidth(0)
        plutôt que setVisible(False), qui casserait la structure du
        _corps_layout -- une largeur à 0 laisse le layout HBox
        recalculer instantanément la place rendue disponible pour
        colonne_image juste à côté, sans "trou" figé). Le bouton qui
        pilote ce repli vit AU-DESSUS du panneau (cf.
        InstanceApercuScreen._construire_bande_pliage), pas ici -- ce
        widget ne connaît que l'action, jamais le contrôle lui-même."""
        self._colonne_reglages_repliee = repliee
        self.colonne_reglages.setFixedWidth(0 if repliee else self._largeur_colonne_reglages_normale)
        self.colonne_reglages.setVisible(not repliee)

