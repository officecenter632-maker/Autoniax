        # "Configuration" (demande explicite utilisateur) -- même contenu,
        # seul le libellé changeait déjà avant ce retrait. ---
        self._onglet_formes = QWidget(self._colonne_gauche)
        self._construire_onglet_formes(self._onglet_formes)
        self.layout_reglages.insertWidget(0, self._onglet_formes)

        self._charger_image_reference_existante()
        self._rafraichir_grille_zones()
        self._rafraichir_apercu_zones_nommees()

    def _recalculer_taille_conteneur_apercus(self):
        """Recalcule et applique la taille (largeur ET hauteur) de
        self._conteneur_apercus -- factorisé hors de eventFilter (appelé
        au resize de self._onglet_formes) pour être aussi appelable
        directement après un CHARGEMENT d'image de référence (cf.
        _charger_image_reference_existante / _sur_nouvelle_frame), sans
        attendre un resize de la fenêtre pour que les bandes noires
        disparaissent une fois l'image en place.

        CORRECTIF (retour utilisateur, capture à l'appui : "les maudites
        bandes noires autour de l'image") -- l'ancienne version fixait
        TOUJOURS hauteur = moitié de l'écran, quel que soit le ratio réel
        de l'image chargée. Avec une carte vidéo portrait/étroite et un
        écran large, ça laissait un vide énorme sur les côtés dans chaque
        ApercuLayoutLabel (KeepAspectRatio ne peut QUE réduire l'espace
        occupé, jamais l'agrandir hors de son widget -- cf.
        _rect_pixmap_affiche) -- rendu visuellement comme deux larges
        bandes de fond sombre (Mocha.crust) de part et d'autre de chaque
        image.

        Calcul désormais dérivé du ratio RÉEL de l'image de référence : à
        largeur fixée (deux ApercuLayoutLabel côte à côte, largeur/2
        chacun, cf. layout_apercus), la hauteur qui fait tenir l'image
        PILE (sans bande) est largeur_par_label * (h_image / w_image).
        Toujours plafonné à l'ancienne moitié d'écran (hauteur_plafond)
        pour ne jamais dépasser l'espace raisonnable si l'image est très
        haute (portrait extrême) -- dans ce cas des bandes horizontales
        minimes restent possibles, mais bien moindres que l'ancien
        comportement systématique."""
        if self._conteneur_apercus.parent() is not self._onglet_formes:
            return
        LARGEUR_PANNEAU_FORME = 300  # cf. _construire_panneau_zone, conteneur.setFixedWidth(300)
        ESPACEMENT_GRILLE = 16  # cf. grille.setHorizontalSpacing(16) dans _construire_onglet_formes
        largeur = max(self._onglet_formes.width() - LARGEUR_PANNEAU_FORME - ESPACEMENT_GRILLE, 1)
        hauteur_plafond = max(self._onglet_formes.height() // 2, 1)
        if self._image_reference_bgr is not None:
            h_img, w_img = self._image_reference_bgr.shape[:2]
            if h_img > 0 and w_img > 0:
                ESPACEMENT_APERCUS = 8  # cf. layout_apercus.setSpacing(8)
                largeur_par_label = max((largeur - ESPACEMENT_APERCUS) / 2, 1)
                hauteur_naturelle = largeur_par_label * (h_img / w_img)
                hauteur = max(min(round(hauteur_naturelle), hauteur_plafond), 1)
            else:
                hauteur = hauteur_plafond
        else:
            hauteur = hauteur_plafond
        self._conteneur_apercus.definir_cible(largeur, hauteur)   # PATCH15

    def eventFilter(self, watched, event):
        """CORRECTIF (retour utilisateur explicite : "l'image doit
        occuper juste la moitié en largeur ET en hauteur de l'écran,
        toujours au coin nord-ouest") -- installé sur self._onglet_formes
        (cf. _construire_onglet_formes) : à chaque redimensionnement de
        ce conteneur, fixe apercu_layout_label à EXACTEMENT la moitié de
        sa largeur/hauteur via setFixedSize (Qt.AlignTop|AlignLeft posé
        dans grille.addWidget fait le reste : ancre le widget en haut-
        gauche de sa cellule plutôt qu'au centre).

        CORRECTIF (setMaximumSize -> setFixedSize) : setMaximumSize seul
        ne fait QUE plafonner -- avec la SizePolicy par défaut du widget
        (pas Expanding, cf. suppression du setSizePolicy/setMinimumSize
        fixe précédent dans _construire_onglet_formes) et plus aucun
        stretch de grille dominant pour le pousser à grandir, le widget
        retombait sur son sizeHint naturel (~visiblement 1/3 d'écran sur
        la capture précédente), jamais sur le plafond -- confirmé par
        test offscreen réel. setFixedSize fixe min ET max à la même
        valeur, donc la taille EST la moitié, sans dépendre du sizeHint.

        AJOUT (aperçu brut + filtré côte à côte, cf. docstring de
        _construire_onglet_formes) : la contrainte "moitié du conteneur"
        est désormais posée sur self._conteneur_apercus (le QWidget
        QHBoxLayout englobant LES DEUX ApercuLayoutLabel) plutôt que sur
        apercu_layout_label seul -- LA LIMITE NE CHANGE PAS EN HAUTEUR
        (toujours exactement la moitié de _onglet_formes), seul son
        contenu se partage maintenant en deux moitiés égales via le
        stretch 1/1 posé dans _construire_onglet_formes -- chaque
        ApercuLayoutLabel garde une SizePolicy naturelle (Expanding par
        défaut dans un layout), donc se redimensionne tout seul avec le
        conteneur sans nécessiter de setFixedSize individuel ici.

        CORRECTIF (retour utilisateur, capture à l'appui : "il y avait
        encore de l'espace à la droite, donc on aurait pu plus agrandir
        les images tout en conservant le ratio") -- l'ancien calcul de
        LARGEUR (self._onglet_formes.width() // 2) datait de l'aperçu
        UNIQUE et prenait la moitié de TOUTE la largeur de l'onglet, y
        compris la colonne de droite (_panneau_zone, 300px fixes, cf.
        grille.setColumnStretch(1, 0) dans _construire_onglet_formes) --
        avec un seul aperçu, cette moitié restait cohérente par
        coïncidence pour la hauteur mais gaspillait déjà de la largeur.
        Avec deux aperçus côte à côte, l'écart devenait visible : la
        largeur RÉELLEMENT disponible pour la colonne 0 (celle qui
        contient ce conteneur) est (largeur totale - 300px de panneau -
        l'espacement horizontal de la grille), jamais la moitié de la
        largeur totale. Utilise désormais cette largeur réelle --
        LARGEUR_PANNEAU_FORME/espacement en constantes de classe pour
        rester synchronisé avec conteneur.setFixedWidth(300) et
        grille.setHorizontalSpacing(16) de _construire_onglet_formes
        (même valeurs, dupliquées ici faute d'un accès direct à la
        géométrie déjà calculée de la grille au moment du resize). La
        HAUTEUR, elle, reste la moitié de _onglet_formes -- inchangée,
        aucune plainte dessus.

        REFONTE (retrait de l'onglet Test, cf. docstring du __init__) :
        _conteneur_apercus vit désormais en permanence dans
        _onglet_formes (plus de reparentage possible vers un onglet Test
        -- retiré) -- la garde ci-dessous (parent() is self._onglet_formes)
        reste posée par prudence défensive mais est maintenant toujours
        vraie en pratique.

        AJOUT (sous-onglet "Données de test", cf. _construire_sous_onglet_
        donnees_test) : gère aussi le drag & drop sur self._zone_drop_test
        -- même patron DragEnter/DragMove/DragLeave/Drop que l'eventFilter
        de TestComposantScreen (cf. sa docstring détaillée sur le
        CORRECTIF perf DragMove), mais via les fonctions de MODULE
        mime_data_contient_image/chemin_image_depuis_mime_data (remontées
        depuis TestComposantScreen, cf. leur docstring) plutôt que des
        méthodes -- ce widget n'hérite pas de TestComposantScreen.
        Contrairement à _sur_image_deposee (une seule image à la fois,
        cf. sa docstring), le Drop ici accepte TOUTES les URLs locales
        dont l'extension est reconnue en une seule fois (cf. mime_data.
        urls(), pas juste la première) -- cohérent avec _ajouter_images_
        donnees_test qui prend déjà une liste de chemins, et avec la
        demande d'origine ("glisser des images", au pluriel) plutôt que
        de forcer l'utilisateur à glisser fichier par fichier.
        setProperty("drag_actif", ...) + unpolish/polish : même patron
        que _maj_indicateur/definir_statut_serveur_t (cf. leurs
        docstrings) pour rafraîchir le style QSS #ZoneDeposeImageTest
        [drag_actif="true"] au survol -- un simple :hover ne conviendrait
        pas ici (c'est un survol de DRAG, pas de souris)."""
        if watched is self._onglet_formes and event.type() == QEvent.Resize:
            self._recalculer_taille_conteneur_apercus()
            return super().eventFilter(watched, event)

        if watched is getattr(self, "_zone_drop_test", None):
            type_evt = event.type()
            if type_evt == QEvent.DragMove:
                if getattr(self, "_drag_test_actif", False):
                    event.acceptProposedAction()
                    return True
                return False
            if type_evt == QEvent.DragEnter:
                if mime_data_contient_image(event.mimeData()):
                    self._drag_test_actif = True
                    self._zone_drop_test.setProperty("drag_actif", "true")
                    self._zone_drop_test.style().unpolish(self._zone_drop_test)
                    self._zone_drop_test.style().polish(self._zone_drop_test)
                    event.acceptProposedAction()
                    return True
                self._drag_test_actif = False
                return False
            if type_evt == QEvent.DragLeave:
                self._drag_test_actif = False
                self._zone_drop_test.setProperty("drag_actif", "false")
                self._zone_drop_test.style().unpolish(self._zone_drop_test)
                self._zone_drop_test.style().polish(self._zone_drop_test)
                return False
            if type_evt == QEvent.Drop:
                self._drag_test_actif = False
                self._zone_drop_test.setProperty("drag_actif", "false")
                self._zone_drop_test.style().unpolish(self._zone_drop_test)
                self._zone_drop_test.style().polish(self._zone_drop_test)
                mime_data = event.mimeData()
                if mime_data is not None and mime_data.hasUrls():
                    chemins = [
                        url.toLocalFile()
                        for url in mime_data.urls()
                        if url.isLocalFile()
                        and Path(url.toLocalFile()).suffix.lower() in EXTENSIONS_IMAGE_ACCEPTEES
                    ]
                    if chemins:
                        event.acceptProposedAction()
                        self._ajouter_images_donnees_test(chemins)
                        return True
                return False

        return super().eventFilter(watched, event)

    # ------------------------------------------------------------------
    # Onglet Configuration (5.1 - 5.4)
    # ------------------------------------------------------------------
    def _construire_onglet_formes(self, conteneur: QWidget):
        """FUSION Forme -> Zone (demande explicite : "forme et zone sont
        en fait la même chose ... on va éliminer la notion de forme, et
        conserver zone") -- structure :

        - Coin NORD-OUEST (ligne 0, colonne 0) : conteneur horizontal des
          DEUX aperçus (brut + filtré, cf. plus bas), exactement la
          moitié largeur/hauteur du conteneur (cf. eventFilter).
        - SOUS L'IMAGE (ligne 1, colonne 0) : self._sous_onglets, un
          QTabWidget à 3 sous-onglets -- Général / Filtre / Zone (cf.
          _construire_sous_onglet_general/_filtre/_zones plus bas). Plus
          de sous-onglet "Formes" séparé -- une seule notion, Zone,
          toujours tracée librement (plus de scan-clic sur bloc,
          confirmé explicitement : "on enlève la notion de scan clic,
          nous même on va dessiner la zone").
        - Colonne de DROITE (lignes 0-1, colonne 1) : self._panneau_forme,
          panneau de configuration de la Zone actuellement sélectionnée
          (cf. _construire_panneau_forme) : vide/placeholder tant
          qu'aucune Zone n'est sélectionnée depuis le sous-onglet Zone.

        Changement de flux (conservé) : le filtre n'est PAS exécuté
        automatiquement au debounce de frappe -- _appliquer_filtre
        (exécution du code, fait ressortir les zones à repérer) n'est
        déclenchée QUE par un bouton explicite "Exécuter le filtre" dans
        le sous-onglet Filtre.

        Coin nord-ouest : deux ApercuLayoutLabel côte à côte
        (apercu_layout_label brute + apercu_layout_filtre_label résultat
        du filtre), tracé de Zone synchronisé visuellement sur LES DEUX
        (dessiner sur l'un le montre en direct sur l'autre, cf. docstring
        de ApercuLayoutLabel) -- CONTRAINTE conservée : ce conteneur ne
        dépasse jamais la moitié du conteneur (cf. eventFilter), chaque
        label occupe la moitié de cette zone en largeur, sa hauteur
        pleine."""
        grille = QGridLayout(conteneur)
        grille.setContentsMargins(0, 12, 12, 12)
        grille.setHorizontalSpacing(16)
        grille.setVerticalSpacing(12)

        # --- Coin nord-ouest : conteneur horizontal des DEUX aperçus
        # (brut + filtré), contraint à EXACTEMENT la moitié du conteneur
        # (largeur ET hauteur, cf. eventFilter plus bas). ---
        self._conteneur_apercus = ConteneurApercusSouple(conteneur)   # PATCH15
        self._conteneur_apercus.setObjectName("ConteneurApercusLayout")
        layout_apercus = QHBoxLayout(self._conteneur_apercus)
        layout_apercus.setContentsMargins(0, 0, 0, 0)
        layout_apercus.setSpacing(8)

        self.apercu_layout_label = ApercuLayoutLabel(self._conteneur_apercus)
        self.apercu_layout_label.setObjectName("ComposantTuileImageFrame")
        self.apercu_layout_label.zone_tracee.connect(self._sur_zone_tracee)
        layout_apercus.addWidget(self.apercu_layout_label, 1)

        # Second aperçu, image FILTRÉE -- MODE_INERTE tant que le mode
        # "trace zone" n'est pas actif (cf. _sur_toggle_mode_trace_zone),
        # reste cliquable pour le TRACÉ de Zone une fois ce mode activé :
        # tracer une Zone depuis n'importe lequel des deux aperçus est
        # explicitement voulu (demande : "dessiner sur l'un doit le
        # montrer sur l'autre aussi").
        self.apercu_layout_filtre_label = ApercuLayoutLabel(self._conteneur_apercus)
        self.apercu_layout_filtre_label.setObjectName("ComposantTuileImageFrame")
        self.apercu_layout_filtre_label.definir_mode(ApercuLayoutLabel.MODE_INERTE)
        self.apercu_layout_filtre_label.zone_tracee.connect(self._sur_zone_tracee)
        layout_apercus.addWidget(self.apercu_layout_filtre_label, 1)

        # Synchronisation visuelle bidirectionnelle (demande explicite :
        # "dessiner sur l'un doit le montrer sur l'autre aussi") -- chaque
        # label relaie son trace_en_cours vers le rect_trace_externe de
        # l'AUTRE (jamais vers lui-même, ce qui créerait un rectangle en
        # double par-dessus son propre tracé natif). Les deux affichent
        # la même image à la même échelle logique (cf.
        # _rafraichir_affichage_image) donc les coordonnées IMAGE émises
        # par l'un sont directement valables pour l'autre, sans
        # transformation supplémentaire ici.
        self.apercu_layout_label.trace_en_cours.connect(self.apercu_layout_filtre_label.definir_rect_trace_externe)
        self.apercu_layout_filtre_label.trace_en_cours.connect(self.apercu_layout_label.definir_rect_trace_externe)

        grille.addWidget(self._conteneur_apercus, 0, 0, 1, 1, Qt.AlignTop | Qt.AlignLeft)
        self._grille_onglet_formes = grille
        # cf. eventFilter : recalcule setFixedSize(moitié conteneur) à
        # chaque resize de _onglet_formes -- installé ici (pas dans
        # __init__) puisque conteneur == self._onglet_formes n'existe
        # qu'à partir de cet appel.
        conteneur.installEventFilter(self)

        self.apercu_label = self.apercu_layout_label

        # --- Sous l'image (ligne 1, colonne 0) : sous-onglets Général /
        # Filtre / Zone.
        #
        # Le QTabWidget est enveloppé dans un widget hôte avec un
        # QVBoxLayout qui lui donne une hauteur NATURELLE (stretch 0) et
        # ajoute un addStretch(1) juste après -- ce stretch vide absorbe
        # l'espace excédentaire, pas les onglets eux-mêmes. Le widget
        # hôte, lui, garde le stretch de grille existant (nécessaire pour
        # que la colonne 0 s'étire toujours jusqu'à la hauteur du panneau
        # de droite).
        hote_sous_onglets = QWidget(conteneur)
        layout_hote_sous_onglets = QVBoxLayout(hote_sous_onglets)
        layout_hote_sous_onglets.setContentsMargins(0, 0, 0, 0)
        layout_hote_sous_onglets.setSpacing(0)

        self._sous_onglets = QTabWidget(hote_sous_onglets)
        self._sous_onglets.setObjectName("ComposantLayoutSousOnglets")
        # AJOUT (correctif retour utilisateur : "réduire bien la longueur
        # du corps des onglets d'en bas ... je veux plus une si longue
        # hauteur") -- filet de sécurité en complément du plafonnement de
        # la mini-doc (cf. QScrollArea dans _construire_sous_onglet_
        # filtre/_scindement) : même si un contenu futur d'un sous-onglet
        # grandissait sans plafond propre, ce setMaximumHeight empêche
        # tout le QTabWidget -- et donc toute la fenêtre -- de s'étirer
        # au-delà d'une hauteur raisonnable. La valeur laisse assez de
        # place pour l'éditeur de code (setMinimumHeight(140), cf.
        # code_filtre_edit/code_scindement_edit) + ses boutons/label
        # d'erreur au-dessus, sans dépasser une fenêtre d'écran courant.
        self._sous_onglets.setMaximumHeight(420)
        layout_hote_sous_onglets.addWidget(self._sous_onglets, 0)
        layout_hote_sous_onglets.addStretch(1)

        grille.addWidget(hote_sous_onglets, 1, 0)

        onglet_general = QWidget(self._sous_onglets)
        self._construire_sous_onglet_general(onglet_general)
        self._sous_onglets.addTab(onglet_general, "Général")

        # AJOUT (demande explicite utilisateur : code_scindement OBLIGATOIRE
        # au même titre que code_filtre, les deux utilisés ensemble en
        # production -- cf. docstring du champ sur ComposantLayout et de
        # detecter_toutes_instances_composant_layout_sur_page) -- posé
        # AVANT l'onglet Filtre : ordre logique du pipeline (scindement de
        # la page entière en cartes candidates, PUIS filtre appliqué à
        # chaque carte), même ordre que les paramètres des fonctions
        # concernées.
        onglet_scindement = QWidget(self._sous_onglets)
        self._construire_sous_onglet_scindement(onglet_scindement)
        self._sous_onglets.addTab(onglet_scindement, "Scindement")

        onglet_filtre = QWidget(self._sous_onglets)
        self._construire_sous_onglet_filtre(onglet_filtre)
        self._sous_onglets.addTab(onglet_filtre, "Filtre")

        onglet_zones = QWidget(self._sous_onglets)
        self._construire_sous_onglet_zones(onglet_zones)
        self._sous_onglets.addTab(onglet_zones, "Zone")
        self._onglet_zones_widget = onglet_zones

        # AJOUT (demande explicite utilisateur : "ajouter un sous onglet
        # qui vas juste contenir les donnee du gabarit, comme sa on pourra
        # copier facilement pour une prochaine edition") -- 4e sous-onglet,
        # PUREMENT en lecture (aucun champ éditable, contrairement aux 3
        # autres) : sert seulement à exposer composant_layout.to_dict() en
        # JSON copiable en un clic, pour pouvoir le coller ailleurs (ex:
        # dans une conversation d'analyse/debug, ou en sauvegarde manuelle
        # avant expérimentation) sans devoir ouvrir project.json à la main
        # et y retrouver le bon ComposantLayout dans la liste.
        onglet_gabarit = QWidget(self._sous_onglets)
        self._construire_sous_onglet_gabarit(onglet_gabarit)
        self._sous_onglets.addTab(onglet_gabarit, "Gabarit")
        self._onglet_gabarit_widget = onglet_gabarit

        # AJOUT (demande explicite utilisateur : "je pense que ça serait
        # bien si on pouvait sauvegarder des images pour les tests ...
        # on doit effectuer le test sur plusieurs cas avant de valider,
        # et ça devient précieux de garder certaines images") -- 5e sous-
        # onglet : simple liste d'images de test accumulées pour ce cL au
        # fil des essais (drag & drop pour ajouter, cf. _construire_sous_
        # onglet_donnees_test), rejouables ensuite dans TestComposantScreen
        # via les flèches < > (cf. sa docstring, capture_001.png à
        # l'appui -- même demande, deux écrans reliés par ce même stockage
        # sur disque, cf. get_composant_layout_tests_dir).
        onglet_donnees_test = QWidget(self._sous_onglets)
        self._construire_sous_onglet_donnees_test(onglet_donnees_test)
        self._sous_onglets.addTab(onglet_donnees_test, "Données de test")
        self._onglet_donnees_test_widget = onglet_donnees_test

        self._sous_onglets.currentChanged.connect(self._sur_changement_sous_onglet)

        # --- Colonne de droite : panneau de configuration de la Zone
        # sélectionnée (cf. _construire_panneau_zone). ---
        self._panneau_zone = QWidget(conteneur)
        self._construire_panneau_zone(self._panneau_zone)
        grille.addWidget(self._panneau_zone, 0, 1, 2, 1)

        # Colonne 0 (image + sous-onglets) vs colonne 1 (panneau,
        # largeur FIXE 300px, cf. _construire_panneau_forme) -- stretch
        # 1/0 classique.
        grille.setColumnStretch(0, 1)
        grille.setColumnStretch(1, 0)
        grille.setRowStretch(0, 0)
        grille.setRowStretch(1, 1)  # sous-onglets : prennent le reste de la hauteur sous l'image

        # CORRECTIF (bug rapporté : onglet "Zone" vide à l'ouverture d'un
        # ComposantLayout qui a pourtant déjà des Zones détectées/tracées
        # -- capture_001.png) -- self._grille_zones et self._panneau_zone
        # viennent tout juste d'être construits ci-dessus (_construire_
        # sous_onglet_zones / _construire_panneau_zone) : ils sont donc
        # forcément vides à cet instant, quel que soit le contenu réel de
        # composant_layout.zones. L'appel _rafraichir_grille_zones() fait
        # par InstanceApercuScreen.__init__ (classe parente) arrive lui
        # AVANT ces constructions -- donc sur self._grille_zones qui
        # n'existe pas encore côté sous-classe -- et le seul autre appel
        # existant (_sur_coller_gabarit) ne s'exécute que sur un collage
        # manuel, jamais à l'ouverture normale de l'écran. Sans ce
        # rafraîchissement explicite ici, en fin de construction, la
        # grille de cartes restait donc DÉFINITIVEMENT vide jusqu'au
        # premier collage -- alors même que l'image affichait déjà les
        # contours détectés (_rafraichir_affichage_image, indépendant).
        self._rafraichir_grille_zones()
        self._rafraichir_panneau_zone()

    def _bouton_copier(self, obtenir_texte, parent_widget: QWidget, tooltip: str = "Copier") -> QToolButton:
        """AJOUT (demande explicite : "un bouton de copie pour chaque ...
        entry box de code et de documentation ... sa seras facile de
        copier et de mettre a jour un element" -- usage utilitaire pur,
        pas pensé pour être lu) -- bouton compact au style identique à
        PanneauProprietesInstance.bouton_copier (cf. QToolButton +
        mdi6.content-copy + setAutoRaise, seul pattern copier déjà
        présent dans ce fichier) : icône remplacée brièvement par un
        check vert au clic, restaurée après 1200ms (même feedback).

        `obtenir_texte` est un callable sans argument (pas une valeur
        figée) : le texte à copier est relu à CHAQUE clic, donc reflète
        toujours le contenu actuel du champ au moment du clic, même s'il
        a changé depuis la construction du bouton."""
        bouton = QToolButton(parent_widget)
        bouton.setIcon(qta.icon("mdi6.content-copy", color=Mocha.subtext0))
        bouton.setToolTip(tooltip)
        bouton.setCursor(Qt.PointingHandCursor)
        bouton.setAutoRaise(True)

        def _sur_clic():
            texte = obtenir_texte()
            if not texte:
                return
            QGuiApplication.clipboard().setText(texte)
            bouton.setIcon(qta.icon("mdi6.check", color=Mocha.green))
            QTimer.singleShot(
                1200,
                lambda: (
                    bouton.setIcon(qta.icon("mdi6.content-copy", color=Mocha.subtext0))
                ),
            )

        bouton.clicked.connect(_sur_clic)
        return bouton

    def _bouton_coller(self, definir_texte, parent_widget: QWidget, tooltip: str = "Coller") -> QToolButton:
        """AJOUT -- pendant de _bouton_copier ci-dessus pour le sens
        inverse (injecter le presse-papier système dans un champ) :
        aucun pattern "coller" n'existait encore dans ce fichier (cf.
        grep "content-paste" -- seule une entrée de dictionnaire
        d'icônes, jamais reliée à un QToolButton fonctionnel), celui-ci
        sert donc de référence pour tout futur ajout similaire.

        `definir_texte` est un callable prenant le texte du presse-
        papier en argument (ex: lambda t: self.champ.setText(t)) --
        laissé au niveau de chaque appelant plutôt qu'un setText direct
        ici, pour que QPlainTextEdit (setPlainText) et QLineEdit
        (setText) partagent le même helper sans branchement de type."""
        bouton = QToolButton(parent_widget)
        bouton.setIcon(qta.icon("mdi6.content-paste", color=Mocha.subtext0))
        bouton.setToolTip(tooltip)
        bouton.setCursor(Qt.PointingHandCursor)
        bouton.setAutoRaise(True)

        def _sur_clic():
            texte = QGuiApplication.clipboard().text()
            if not texte:
                return
            definir_texte(texte)
            bouton.setIcon(qta.icon("mdi6.check", color=Mocha.green))
            QTimer.singleShot(
                1200,
                lambda: (
                    bouton.setIcon(qta.icon("mdi6.content-paste", color=Mocha.subtext0))
                ),
            )

        bouton.clicked.connect(_sur_clic)
        return bouton

    def _ligne_section_avec_actions(
        self, texte: str, parent_widget: QWidget, *boutons: QToolButton
    ) -> QHBoxLayout:
        """AJOUT -- variante de _section_label qui pose le libellé de
        section à gauche et une rangée compacte de boutons d'action
        (copier/coller) à droite, sur la même ligne. Évite de dupliquer
        ce petit HBox à chaque appelant (4 sites dans cette refonte :
        nom du ComposantLayout, mini-doc filtre, code filtre, nom de
        zone)."""
        ligne = QHBoxLayout()
        ligne.setSpacing(4)
        ligne.addWidget(self._section_label(texte, parent_widget))
        ligne.addStretch(1)
        for bouton in boutons:
            ligne.addWidget(bouton)
        return ligne

    def _construire_sous_onglet_general(self, conteneur: QWidget):
        """Sous-onglet "Général" -- paramètres globaux du ComposantLayout
        (demande explicite : "les paramètres globaux, comme le seuil, le
        delta, le nom"). delta_conflit AJOUTÉ ici (existait déjà dans la
        dataclass ComposantLayout, cf. sa docstring, mais n'était exposé
        dans aucun formulaire avant cette refonte).

        CORRECTIF (bug rapporté : "j'ai renommé un cL et ça n'apparaît
        plus") -- le champ NOM n'édite plus le nom COMPLET (préfixe
        ServiceAPI- inclus) : seul le préfixe suffisait à confondre
        Project.find_composant_layout, cf. Project.rename_composant_
        layout (AJOUT, même pattern que rename_composant pour cS) qui
        est désormais l'unique point d'entrée pour renommer un cL --
        seul lui met à jour EN MÊME TEMPS composant_layout.nom,
        service_api.composants_layout (liste de noms référencée par la
        grille, cf. sa docstring) et le fichier image_reference sur
        disque. Préfixe affiché à côté, non éditable (même UX que
        PanneauProprietesReglages._on_nom_edited pour cS, cf. son
        nom_edit/prefixe)."""
        layout = QVBoxLayout(conteneur)
        layout.setContentsMargins(0, 12, 0, 0)
        layout.setSpacing(12)

        # CORRECTIF (demande explicite : "les éléments ne doivent plus
        # être étirés avec du vide entre eux ... compact, pas étiré
        # comme du chewing-gum") -- chaque QHBoxLayout ci-dessous se
        # terminait sans addStretch, et le seul widget "élastique" de la
        # ligne (le champ éditable) absorbait donc tout l'espace restant
        # de la largeur du sous-onglet, désormais visible sur des écrans
        # larges (cf. capture_001.png fournie). Fix : largeur MAXIMALE
        # raisonnable sur chaque champ éditable + addStretch(1) en fin de
        # ligne pour pousser le contenu à gauche au lieu de le laisser
        # combler le vide -- même compacité que bouton_supprimer_forme/
        # ligne_actions plus bas dans ce fichier, qui n'avaient jamais ce
        # problème car ils ne contiennent que des QPushButton (largeur
        # naturelle, pas de stretch demandé).
        LARGEUR_CHAMP_COMPACT = 220

        # RETRAIT (demande explicite utilisateur, capture_001.png à
        # l'appui : "enlève ces deux boutons de l'onglet Général") -- les
        # boutons copier/coller sur le champ NOM sont retirés ICI
        # uniquement (le sous-onglet Filtre garde les siens, cf. bouton_
        # copier_code/bouton_coller_code plus bas dans cette même
        # méthode -- demande explicite localisée au NOM du cL, pas à
        # _ligne_section_avec_actions en général, cf. sa docstring qui
        # documente encore ses autres appelants). Simple _section_label,
        # même patron que "SEUILS"/"AFFICHAGE DES ZONES" plus bas.
        layout.addWidget(self._section_label("NOM", conteneur))
        ligne_nom = QHBoxLayout()
        ligne_nom.setSpacing(4)
        self.prefixe_nom_composant_layout_label = QLabel(
            f"{self.composant_layout.service_api_nom}-", conteneur
        )
        self.prefixe_nom_composant_layout_label.setObjectName("ReglagesHintLabel")
        ligne_nom.addWidget(self.prefixe_nom_composant_layout_label)
        self.nom_composant_layout_edit = QLineEdit(conteneur)
        self.nom_composant_layout_edit.setObjectName("ReglagesEdit")
        self.nom_composant_layout_edit.setMaximumWidth(LARGEUR_CHAMP_COMPACT)
        self.nom_composant_layout_edit.setText(self._nom_court_composant_layout(self.composant_layout.nom))
        self.nom_composant_layout_edit.editingFinished.connect(self._sur_nom_composant_layout_change)
        ligne_nom.addWidget(self.nom_composant_layout_edit)
        ligne_nom.addStretch(1)
        layout.addLayout(ligne_nom)

        self.erreur_nom_composant_layout_label = QLabel("", conteneur)
        self.erreur_nom_composant_layout_label.setWordWrap(True)
        self.erreur_nom_composant_layout_label.setStyleSheet(f"color: {Mocha.red};")
        self.erreur_nom_composant_layout_label.hide()
        layout.addWidget(self.erreur_nom_composant_layout_label)

        # RETRAIT (REFONTE, cf. SPEC_refonte_filtre_zones_dynamiques.md) --
        # section "SEUILS" (seuil_confiance/delta_conflit) supprimée : ces
        # deux champs pilotaient l'ancien matching structurel bloc<->Zone,
        # qui n'existe plus. code_filtre nomme et valide lui-même chaque
        # zone (valide[0]/valide[1]), il n'y a plus de notion de score ni
        # de tolérance à régler ici.

        # AJOUT (demande explicite utilisateur : "il faut que la couleur
        # du contour sur les images soit plus foncé et change de couleur,
        # par exemple vert ... ces couleurs doivent être définies dans
        # l'onglet Général ... sa sera persistant et en fonction de chaque
        # cL ... tu mets le sélectionneur de couleur un peu comme le
        # sélectionneur qui est dans TestComposant au niveau du tracé des
        # succès et échecs sur l'image") -- même widget BoutonCouleur que
        # ComposantReglagesNumeriquesPanel.couleur_succes/couleur_echec,
        # réutilisé tel quel ici pour Zone : couleur normale (toutes les
        # Zone SAUF celle sélectionnée) + couleur de la Zone sélectionnée
        # dans le panneau de droite (cf. _sur_carte_zone_cliquee), plus
        # foncée/contrastée par défaut (vert) pour bien se distinguer.
        layout.addWidget(self._section_label("AFFICHAGE DES ZONES", conteneur))

        ligne_couleur_zone = QHBoxLayout()
        label_couleur_zone = QLabel("Couleur du contour", conteneur)
        label_couleur_zone.setObjectName("ReglagesLabel")
        ligne_couleur_zone.addWidget(label_couleur_zone, 1)
        self.couleur_zone_bouton = BoutonCouleur(self.composant_layout.couleur_zone, conteneur)
        self.couleur_zone_bouton.couleur_changee.connect(self._sur_couleur_zone_change)
        ligne_couleur_zone.addWidget(self.couleur_zone_bouton, 0, Qt.AlignRight)
        layout.addLayout(ligne_couleur_zone)

        ligne_couleur_zone_selectionnee = QHBoxLayout()
        label_couleur_zone_selectionnee = QLabel("Couleur de la Zone sélectionnée", conteneur)
        label_couleur_zone_selectionnee.setObjectName("ReglagesLabel")
        ligne_couleur_zone_selectionnee.addWidget(label_couleur_zone_selectionnee, 1)
        self.couleur_zone_selectionnee_bouton = BoutonCouleur(
            self.composant_layout.couleur_zone_selectionnee, conteneur
        )
        self.couleur_zone_selectionnee_bouton.couleur_changee.connect(self._sur_couleur_zone_selectionnee_change)
        ligne_couleur_zone_selectionnee.addWidget(self.couleur_zone_selectionnee_bouton, 0, Qt.AlignRight)
        layout.addLayout(ligne_couleur_zone_selectionnee)

        ligne_epaisseur_zone = QHBoxLayout()
        ligne_epaisseur_zone.addWidget(QLabel("Épaisseur du contour", conteneur))
        self.epaisseur_zone_spin = QSpinBox(conteneur)
        self.epaisseur_zone_spin.setRange(1, 10)
        self.epaisseur_zone_spin.setMaximumWidth(LARGEUR_CHAMP_COMPACT)
        self.epaisseur_zone_spin.setValue(self.composant_layout.epaisseur_zone)
        self.epaisseur_zone_spin.valueChanged.connect(self._sur_epaisseur_zone_change)
        ligne_epaisseur_zone.addWidget(self.epaisseur_zone_spin)
        ligne_epaisseur_zone.addStretch(1)
        layout.addLayout(ligne_epaisseur_zone)

        # AJOUT (demande explicite : bouton Supprimer déplacé ici depuis
        # le panneau flottant, qui ne s'ouvre plus au clic simple sur une
        # tuile -- cf. ComposantsLayoutScreen._sur_tuile_cliquee et le
        # signal demande_suppression déclaré en tête de classe). MÊME
        # style que bouton_supprimer_forme (rouge, delete-outline) pour
        # rester cohérent avec le reste de cet écran. Pas de QMessageBox
        # de confirmation : même contrat que l'ancienne suppression
        # depuis le panneau flottant (cf. ComposantsLayoutScreen.
        # _sur_supprimer, "suppression DIRECTE, pas de confirmation").
        layout.addWidget(self._section_label("ZONE DE DANGER", conteneur))
        self.bouton_supprimer_composant_layout = QPushButton(
            qta.icon("mdi6.delete-outline", color=Mocha.red), " Supprimer ce ComposantLayout", conteneur
        )
        self.bouton_supprimer_composant_layout.setObjectName("ReglagesButton")
        self.bouton_supprimer_composant_layout.setCursor(Qt.PointingHandCursor)
        self.bouton_supprimer_composant_layout.setMaximumWidth(LARGEUR_CHAMP_COMPACT + 100)
        self.bouton_supprimer_composant_layout.clicked.connect(
            lambda: self.demande_suppression.emit(self.composant_layout.nom)
        )
        layout.addWidget(self.bouton_supprimer_composant_layout)

        layout.addStretch(1)

    def _construire_sous_onglet_filtre(self, conteneur: QWidget):
        """Sous-onglet "Filtre" -- code OpenCV + exécution EXPLICITE
        (demande explicite : plus de debounce automatique à la frappe --
        un bouton "Exécuter le filtre" applique le code ET scanne les
        formes en une seule action, cf. _appliquer_filtre qui fait déjà
        les deux).

        REFONTE (demande explicite : "je veux que tu mets la mini doc,
        ça sera juste une zone de texte qui explique comment écrire le
        code d'un filtre ... actuellement tu as classé les éléments à la
        verticale, non, tu dois classer les deux à l'horizontale") --
        aide/mini-doc à GAUCHE (largeur fixe, lecture confortable sans
        prendre toute la largeur) et zone de code à DROITE (toute la
        place restante), au lieu de l'empilement vertical précédent.

        REFONTE 2 (demande explicite : "concernant la zone de code, met
        la coloration qui est utilisée dans TaskScriptEditor") --
        PythonHighlighter (cf. sa docstring de classe, déjà utilisé par
        TaskScriptEditor) attaché directement à code_filtre_edit.
        document() : classe autonome, ne dépend d'aucun contexte Task
        (definir_composants_connus/_services_api_connus sont optionnels,
        jamais appelés ici -- le code de filtre n'a ni Composant ni
        ServiceAPI importé, juste image/resultat/cv2/np). Fond Darcula
        assorti via #CodeFiltreEdit (cf. bloc CSS dupliqué de
        #TaskScriptEditor), sans quoi la coloration serait peu lisible
        sur un fond clair par défaut.

        SUPPRESSION (toggle_brut_filtre) : n'a plus de sens depuis
        l'ajout de l'aperçu filtré à côté de l'aperçu brut dans l'onglet
        Configuration (cf. _rafraichir_affichage_image, refonte) -- les
        deux versions sont maintenant visibles SIMULTANÉMENT, plus
        besoin de bascule entre l'une et l'autre."""
        layout = QHBoxLayout(conteneur)
        layout.setContentsMargins(0, 12, 0, 0)
        layout.setSpacing(16)

        # --- Colonne gauche : mini-doc, largeur fixe ---
        colonne_doc = QWidget(conteneur)
        colonne_doc.setFixedWidth(260)
        layout_doc = QVBoxLayout(colonne_doc)
        layout_doc.setContentsMargins(0, 0, 0, 0)
        layout_doc.setSpacing(8)

        # AJOUT : bouton copier sur la mini-doc (texte informatif, non
        # éditable -- pas de bouton coller ici, cf. docstring de méthode).
        bouton_copier_doc = self._bouton_copier(
            lambda: self._TEXTE_DOC_FILTRE, colonne_doc, "Copier la documentation"
        )
        layout_doc.addLayout(
            self._ligne_section_avec_actions("COMMENT ÉCRIRE UN FILTRE", colonne_doc, bouton_copier_doc)
        )
        # AJOUT : texte de doc sorti en attribut (self._TEXTE_DOC_FILTRE)
        # pour que le bouton copier ci-dessus puisse le relire tel quel
        # (même contenu que le QLabel ci-dessous, une seule source).
        self._TEXTE_DOC_FILTRE = (
            "Le code reçoit l'image d'UNE carte déjà découpée (par le "
            "scindement) et doit produire deux variables : les zones "
            "nommées qu'il y trouve, et si cette carte est un exemplaire "
            "valide.\n\n"
            "• Variable d'entrée : image (numpy.ndarray, format BGR "
            "comme OpenCV).\n\n"
            "• Variable de sortie ATTENDUE n°1 : zones (dict) -- "
            "{\"nom_zone\": (x, y, largeur, hauteur), ...}, coordonnées "
            "en pixels relatifs à image. Le nom de chaque zone est "
            "choisi par VOTRE code (ex: \"vignette\", \"titre\", "
            "\"menu_3points\") -- c'est vous qui savez quel bloc "
            "correspond à quel nom.\n\n"
            "• Variable de sortie ATTENDUE n°2 : valide (tuple) -- "
            "(True, \"raison\") si cette carte est un vrai exemplaire du "
            "gabarit, sinon (False, \"raison\"). La raison s'affiche à "
            "l'utilisateur. Si valide[0] est False, la carte est "
            "ignorée quel que soit le contenu de zones.\n\n"
            "• Bibliothèques disponibles : cv2, np (numpy), plus les "
            "fonctions Python de base usuelles (max, min, len, sorted, "
            "int, range, enumerate, sum...). Aucun import supplémentaire "
            "n'est nécessaire ni autorisé (pas d'accès fichier/réseau). "
            "cv2.boundingRect renvoie déjà des valeurs directement "
            "utilisables dans un tuple de zone.\n\n"
            "• En cas d'erreur d'exécution (variable manquante, mal "
            "formée, exception Python...), le message exact s'affiche "
            "sous le bouton \"Exécuter le filtre\", rien n'est appliqué -- "
            "à distinguer de valide[0]=False, qui n'est PAS une erreur, "
            "juste \"pas une instance ici\".\n\n"
            "• Champ vide = filtre invalide : aucune zone ne peut être "
            "détectée sans code."
        )
        aide = QLabel(self._TEXTE_DOC_FILTRE, colonne_doc)
        aide.setWordWrap(True)
        aide.setObjectName("ReglagesHintLabel")
        # CORRECTIF (retour utilisateur, capture à l'appui : "je veux
        # réduire bien la longueur du corps des onglets d'en bas ... on
        # dirait que c'est le texte de documentation qui étire ça vers le
        # bas") -- un QLabel wordWrap SANS plafond de hauteur impose son
        # sizeHint plein texte (tout le paragraphe déplié) comme hauteur
        # MINIMALE du layout englobant, qui remonte jusqu'à self._sous_
        # onglets puis toute la fenêtre (aucun ancêtre ne peut compresser
        # en dessous de ce minimum). Enveloppé désormais dans un
        # QScrollArea à hauteur PLAFONNÉE (setMaximumHeight) : le texte
        # complet reste consultable via un défilement interne, mais ne
        # peut plus jamais dicter la hauteur de toute la fenêtre.
        scroll_doc = QScrollArea(colonne_doc)
        scroll_doc.setWidgetResizable(True)
        scroll_doc.setFrameShape(QFrame.NoFrame)
        scroll_doc.setMaximumHeight(220)
        scroll_doc.setHorizontalScrollBarPolicy(Qt.ScrollBarAlwaysOff)
        scroll_doc.setWidget(aide)
        layout_doc.addWidget(scroll_doc)

        # AJOUT (REFONTE, cf. SPEC_refonte_filtre_zones_dynamiques.md,
        # section "UI -- sous-onglet Filtre") -- liste "Zones dynamiques"
        # : EN LECTURE SEULE (pas de clic pour nommer/renommer, le nom
        # vient uniquement du code), séparée de la grille des Zone
        # STATIQUES du sous-onglet Zone (espace de noms partagé, mais
        # affichage distinct -- une zone dynamique n'est jamais tracée à
        # la main). Peuplée par _rafraichir_liste_zones_dynamiques à
        # chaque exécution du filtre (cf. _appliquer_filtre) à partir de
        # self._dernieres_zones_filtre -- vide tant que le filtre n'a pas
        # encore été exécuté, ou a échoué.
        layout_doc.addWidget(self._section_label("ZONES DYNAMIQUES", colonne_doc))
        self.liste_zones_dynamiques = QListWidget(colonne_doc)
        self.liste_zones_dynamiques.setObjectName("ListeZonesDynamiques")
        self.liste_zones_dynamiques.setSelectionMode(QListWidget.NoSelection)
        self.liste_zones_dynamiques.setFocusPolicy(Qt.NoFocus)
        self.liste_zones_dynamiques.setMaximumHeight(140)
        layout_doc.addWidget(self.liste_zones_dynamiques)
        self._rafraichir_liste_zones_dynamiques()

        layout_doc.addStretch(1)
        layout.addWidget(colonne_doc)

        # --- Colonne droite : zone de code + actions, prend le reste ---
        colonne_code = QWidget(conteneur)
        layout_code = QVBoxLayout(colonne_code)
        layout_code.setContentsMargins(0, 0, 0, 0)
        layout_code.setSpacing(12)

        # AJOUT (demande explicite : "en haut de l'éditeur de code, il
        # doit y avoir le bouton save, avec confirmation de sauvegarde,
        # il doit y avoir le bouton de réinitialisation") -- Save écrit
        # le contenu actuel de l'éditeur dans composant_layout.code_filtre
        # (persistance disque via composant_layout_modifie, cf. son
        # connect à self.project.save) ; Réinitialiser fait l'inverse,
        # recharge composant_layout.code_filtre dans l'éditeur en
        # écrasant tout ce qui y a été tapé/testé depuis. Posés ICI, dans
        # la ligne d'en-tête au-dessus de l'éditeur (pas dans ligne_
        # actions en bas avec "Exécuter le filtre") -- lecture immédiate
        # avant même de faire défiler jusqu'au code.
        bouton_copier_code = self._bouton_copier(
            lambda: self.code_filtre_edit.toPlainText(), colonne_code, "Copier le code"
        )
        bouton_coller_code = self._bouton_coller(
            lambda t: self.code_filtre_edit.setPlainText(t), colonne_code, "Coller le code"
        )
        layout_code.addLayout(
            self._ligne_section_avec_actions(
                "CODE DU FILTRE", colonne_code, bouton_copier_code, bouton_coller_code
            )
        )

        # AJOUT (demande explicite : "je veux que tu mets le bouton
        # exécuter le filtre avant save, donc en haut de l'éditeur") --
        # les trois actions (tester / sauvegarder / réinitialiser)
        # regroupées sur une seule ligne, dans cet ordre, au-dessus de
        # l'éditeur -- Exécuter le filtre n'était auparavant qu'en bas
        # (cf. ancienne ligne_actions, retirée ci-dessous), loin de Save/
        # Réinitialiser alors que les trois forment un même groupe
        # logique (workflow : tester -> valider -> éventuellement
        # annuler).
        ligne_save_reset = QHBoxLayout()
        ligne_save_reset.setSpacing(8)

        self.bouton_executer_filtre = QPushButton(
            qta.icon("mdi6.play", color=Mocha.text), " Exécuter le filtre", colonne_code
        )
        self.bouton_executer_filtre.setObjectName("ReglagesButton")
        self.bouton_executer_filtre.setCursor(Qt.PointingHandCursor)
        self.bouton_executer_filtre.setToolTip("Applique le code sur l'image de référence et affiche les zones nommées trouvées")
        self.bouton_executer_filtre.clicked.connect(self._appliquer_filtre)
        ligne_save_reset.addWidget(self.bouton_executer_filtre)

        self.bouton_sauvegarder_filtre = QPushButton(
            qta.icon("mdi6.content-save-outline", color=Mocha.text), " Save", colonne_code
        )
        self.bouton_sauvegarder_filtre.setObjectName("ReglagesButton")
        self.bouton_sauvegarder_filtre.setCursor(Qt.PointingHandCursor)
        self.bouton_sauvegarder_filtre.setToolTip(
            "Enregistre le code actuellement affiché comme code du filtre validé"
        )
        self.bouton_sauvegarder_filtre.clicked.connect(self._sauvegarder_code_filtre)
        ligne_save_reset.addWidget(self.bouton_sauvegarder_filtre)

        self.bouton_reinitialiser_filtre = QPushButton(
            qta.icon("mdi6.restore", color=Mocha.text), " Réinitialiser", colonne_code
        )
        self.bouton_reinitialiser_filtre.setObjectName("ReglagesButton")
        self.bouton_reinitialiser_filtre.setCursor(Qt.PointingHandCursor)
        self.bouton_reinitialiser_filtre.setToolTip(
            "Recharge le dernier code sauvegardé (annule les modifications non enregistrées)"
        )
        self.bouton_reinitialiser_filtre.clicked.connect(self._reinitialiser_code_filtre)
        ligne_save_reset.addWidget(self.bouton_reinitialiser_filtre)
        ligne_save_reset.addStretch(1)
        layout_code.addLayout(ligne_save_reset)

        self.filtre_sauvegarde_label = QLabel("", colonne_code)
        self.filtre_sauvegarde_label.setObjectName("ReglagesHintLabel")
        self.filtre_sauvegarde_label.hide()
        layout_code.addWidget(self.filtre_sauvegarde_label)

        self.code_filtre_edit = QPlainTextEdit(colonne_code)
        self.code_filtre_edit.setObjectName("CodeFiltreEdit")
        # AJOUT (demande explicite : "je veux que tu mets un code par
        # défaut pour tester le filtre, donc juste un filtre simple dans
        # l'éditeur") -- si aucun code n'a jamais été sauvegardé pour ce
        # ComposantLayout (composant_layout.code_filtre vide, cas d'un cL
        # tout juste créé), l'éditeur s'ouvre avec un exemple déjà prêt à
        # cliquer "Exécuter le filtre", plutôt qu'une zone vide où il faut
        # deviner la syntaxe attendue avant de pouvoir tester quoi que ce
        # soit. N'écrase JAMAIS un code déjà sauvegardé -- uniquement le
        # texte affiché par défaut au premier chargement ; dès que Save
        # est cliqué une fois, ce code par défaut devient le code
        # sauvegardé comme n'importe quel autre.
        #
        # REFONTE (cf. SPEC_refonte_filtre_zones_dynamiques.md) : réécrit
        # pour illustrer le nouveau contrat de sortie (zones + valide) au
        # lieu de l'ancien (resultat = masque). Même esprit que l'exemple
        # detection_carte_video.py fourni dans la spec : chaque zone
        # dynamique est un rectangle (x, y, largeur, hauteur) en pixels
        # relatifs à `image`, nommé explicitement par le code, et `valide`
        # dit si cette carte est un exemplaire réel du gabarit.
        self.CODE_FILTRE_PAR_DEFAUT = (
            "# Filtre de test simple : détection de contours (Canny) pour\n"
            "# faire ressortir un bloc, puis on le NOMME nous-mêmes.\n"
            "# NB : cv2/np + une liste blanche de builtins de calcul pur\n"
            "# (max, len, int, sorted, range...) sont disponibles ici --\n"
            "# pas d'accès fichier/réseau, mais du Python normal sinon.\n"
            "gris = cv2.cvtColor(image, cv2.COLOR_BGR2GRAY)\n"
            "bords = cv2.Canny(gris, 50, 150)\n"
            "contours, _ = cv2.findContours(bords, cv2.RETR_EXTERNAL, cv2.CHAIN_APPROX_SIMPLE)\n"
            "\n"
            "zones = {}\n"
            "if contours:\n"
            "    plus_grand = max(contours, key=cv2.contourArea)\n"
            "    x, y, largeur, hauteur = cv2.boundingRect(plus_grand)\n"
            "    zones[\"vignette\"] = (x, y, largeur, hauteur)\n"
            "\n"
            "if \"vignette\" in zones:\n"
            "    valide = (True, \"vignette trouvée\")\n"
            "else:\n"
            "    valide = (False, \"aucun contour exploitable\")\n"
        )
        self.code_filtre_edit.setPlainText(
            self.composant_layout.code_filtre or self.CODE_FILTRE_PAR_DEFAUT
        )
        self.code_filtre_edit.setMinimumHeight(140)
        self.code_filtre_edit.setPlaceholderText("zones = {\"vignette\": (x, y, largeur, hauteur)}\nvalide = (True, \"raison\")")
        # AJOUT : même coloration syntaxique Python que TaskScriptEditor
        # (cf. docstring de méthode ci-dessus) -- la référence forte est
        # nécessaire (Qt ne garde pas le highlighter vivant tout seul si
        # rien ne le référence côté Python, même pattern que partout
        # ailleurs dans ce fichier où un QSyntaxHighlighter est attaché).
        self._highlighter_code_filtre = PythonHighlighter(self.code_filtre_edit.document())
        layout_code.addWidget(self.code_filtre_edit, 1)

        self.filtre_erreur_label = QLabel("", colonne_code)
        self.filtre_erreur_label.setWordWrap(True)
        self.filtre_erreur_label.setStyleSheet(f"color: {Mocha.red};")
        self.filtre_erreur_label.hide()
        layout_code.addWidget(self.filtre_erreur_label)

        layout.addWidget(colonne_code, 1)

    def _construire_sous_onglet_scindement(self, conteneur: QWidget):
        """Sous-onglet "Scindement" (AJOUT, demande explicite utilisateur :
        "il faut integrer aussi un code de scindement ... pour un
        composantLayout il doit y avoir sont code de filtre interne et
        sont code de detections de scindement sur une page entire, cest
        ces deux code qui doivent etre utiliser en production") -- MÊME
        STRUCTURE EXACTE que _construire_sous_onglet_filtre juste au-dessus
        (mini-doc à gauche, éditeur + actions à droite), dupliquée à
        l'identique plutôt que factorisée : les deux codes ont des
        contrats différents (image de page entière vs image de carte déjà
        cadrée ; variable de sortie "cartes" vs "resultat") qui rendraient
        une factorisation prématurée plus confuse à lire qu'utile,
        cf. décision déjà prise pour code_filtre/code_scindement de rester
        deux champs séparés plutôt qu'un champ unique avec discriminant.

        code_scindement s'exécute sur la PAGE ENTIÈRE (contrairement à
        code_filtre, qui s'exécute sur UNE carte déjà cadrée) : c'est lui
        qui répond à "combien de cartes candidates y a-t-il sur cette page
        et où", AVANT que code_filtre ne s'applique à chacune séparément
        (cf. detecter_toutes_instances_composant_layout_sur_page pour le
        pipeline complet en deux étapes). Posé comme premier sous-onglet
        du pipeline (juste après Général, avant Filtre) -- ordre logique
        de l'exécution réelle.

        Comme pour Filtre : exécution EXPLICITE via un bouton dédié (pas
        de debounce à la frappe), Save/Réinitialiser séparés de Exécuter
        (test seul, n'écrase jamais composant_layout.code_scindement tant
        que Save n'a pas été cliqué explicitement, cf. _appliquer_
        scindement/_sauvegarder_code_scindement plus bas -- même contrat
        que leurs équivalents filtre)."""
        layout = QHBoxLayout(conteneur)
        layout.setContentsMargins(0, 12, 0, 0)
        layout.setSpacing(16)

        # --- Colonne gauche : mini-doc, largeur fixe ---
        colonne_doc = QWidget(conteneur)
        colonne_doc.setFixedWidth(260)
        layout_doc = QVBoxLayout(colonne_doc)
        layout_doc.setContentsMargins(0, 0, 0, 0)
        layout_doc.setSpacing(8)

        bouton_copier_doc = self._bouton_copier(
            lambda: self._TEXTE_DOC_SCINDEMENT, colonne_doc, "Copier la documentation"
        )
        layout_doc.addLayout(
            self._ligne_section_avec_actions("COMMENT ÉCRIRE UN SCINDEMENT", colonne_doc, bouton_copier_doc)
        )
        self._TEXTE_DOC_SCINDEMENT = (
            "Le code reçoit la PAGE ENTIÈRE (pas une carte déjà cadrée) "
            "et doit produire la liste des rectangles candidats "
            "(\"cartes\") où chercher une instance de ce ComposantLayout.\n\n"
            "• Variable d'entrée : image (numpy.ndarray, page entière, "
            "format BGR comme OpenCV).\n\n"
            "• Variable de sortie ATTENDUE : cartes (list) -- une liste "
            "de tuples (x, y, largeur, hauteur) en pixels ABSOLUS de la "
            "page. Le nom compte, c'est lui qui est relu après "
            "exécution.\n\n"
            "• Bibliothèques disponibles : cv2, np (numpy), plus les "
            "fonctions Python de base usuelles (max, min, len, sorted, "
            "int, range, enumerate, sum...). Aucun import supplémentaire "
            "n'est nécessaire ni autorisé (pas d'accès fichier/réseau).\n\n"
            "• Chaque rectangle de cartes est ensuite découpé de la page "
            "et passé séparément au code du Filtre (sous-onglet suivant) "
            "-- un rectangle qui ne correspond à aucune vraie instance du "
            "gabarit est simplement ignoré, ce n'est pas une erreur.\n\n"
            "• En cas d'erreur d'exécution (variable manquante, "
