        self.liste_variables = QListWidget(bloc)
        self.liste_variables.setObjectName("ServiceAPIList")
        self.liste_variables.setFixedHeight(160)
        self.liste_variables.itemClicked.connect(self._sur_selection_variable)
        colonne_variables.addWidget(self.liste_variables)
        colonnes.addLayout(colonne_variables, 1)

        colonne_fichiers = QVBoxLayout()
        fichiers_label = QLabel("Fichiers et dossiers de <racine>/1/data/", bloc)
        fichiers_label.setObjectName("ReglagesLabel")
        colonne_fichiers.addWidget(fichiers_label)
        self.liste_fichiers = QListWidget(bloc)
        self.liste_fichiers.setObjectName("ServiceAPIList")
        self.liste_fichiers.setFixedHeight(160)
        self.liste_fichiers.itemClicked.connect(self._sur_clic_fichier_mapping)
        colonne_fichiers.addWidget(self.liste_fichiers)
        colonnes.addLayout(colonne_fichiers, 1)

        # PATCH (retour utilisateur -- "les variable int/float/bool ne
        # doivent plus avoir de checkbox, ça doit directement avoir leur
        # entrybox avec la valeur par défaut du script avant, que l'on
        # peut maintenant éditer, et laisse un bouton de réinitialise (un
        # bouton de flèche circulaire) pour remettre à la valeur par
        # défaut") : remplace le QListWidget checkable (coché -> ouvre un
        # QInputDialog) par une colonne de lignes toujours éditables (cf.
        # LigneVariableValeur) -- un QLineEdit déjà rempli avec la valeur
        # courante (personnalisée si déjà définie, sinon celle codée en
        # dur dans le script), modifiable directement, plus un petit
        # bouton "flèche circulaire" par ligne pour revenir à la valeur du
        # script. Scrollable pour garder la même hauteur que les 2 autres
        # colonnes quel que soit le nombre de variables détectées.
        colonne_valeurs = QVBoxLayout()
        valeurs_label = QLabel("Valeurs (int/float/bool)", bloc)
        valeurs_label.setObjectName("ReglagesLabel")
        colonne_valeurs.addWidget(valeurs_label)
        self.scroll_valeurs = QScrollArea(bloc)
