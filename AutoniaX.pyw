    #BatchFreeButton:disabled {{
        background-color: {m.surface1};
        color: {m.overlay0};
    }}

    /* PATCH (retour utilisateur explicite : "on vas enlever ce card ,
    on vas lajouter dans longlet des type de proifls" + "un bouon styler
    diferement" + "autre couleur d'accent (bleu) pour bien le distinguer
