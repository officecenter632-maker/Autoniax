def charger_registre_profils_config() -> dict[str, dict]:
    """Charge le registre {nom_profil: {"type_instance", "proxy", "pays",
    "youtube", "ip"}} depuis FICHIER_REGISTRE_PROFILS_CONFIG -- même
    convention défensive que charger_registre_profils (fichier absent ou
    illisible/corrompu = dict vide, jamais une exception qui empêcherait
    l'ouverture du Dashboard). Une entrée dont la forme est invalide (pas
    un dict, type_instance inconnu) est ignorée individuellement plutôt
    que d'invalider tout le registre.

    "pays"/"youtube" sont lus défensivement (valeur invalide -> repli sur
    la valeur par défaut) pour rester rétro-compatible avec toute entrée
    écrite AVANT ce patch (ni l'une ni l'autre clé n'existait alors dans
    le JSON -- .get() renvoie simplement None/absent, jamais de
    KeyError).

    CORRECTIF (retour utilisateur explicite : "les donné sur ladresse ip
    apparait bien au debut, mais apres sa disparait, pour le profil qui a
    ete demarré") -- cause trouvée : "ip" était bien écrit sur disque par
    definir_pays_config_profil (cf. sa docstring), mais cette fonction-ci
    reconstruisait CHAQUE entrée avec un dict LITTÉRAL ne listant que
    type_instance/proxy/pays/youtube -- "ip" présent dans le JSON brut
    (`config.get(...)` aurait fonctionné) était donc silencieusement
    jeté à CHAQUE appel. _sur_liste_instances_recue (callback réseau,
    tourne en boucle tant que le Dashboard est ouvert) appelle
    _rafraichir_liste_profils qui repasse par charger_registre_profils_config
    -> obtenir_config_profil à chaque cycle : la première reconstruction
    après un test de proxy réussi affichait donc la bonne IP (état encore
    en mémoire sur la carte, pas encore écrasé), puis le cycle suivant du
    callback réseau la remplaçait par None -- exactement le symptôme
    "apparaît bien au début, puis disparaît" décrit."""
    if not FICHIER_REGISTRE_PROFILS_CONFIG.is_file():
        return {}
    try:
        with open(FICHIER_REGISTRE_PROFILS_CONFIG, "r", encoding="utf-8") as f:
            donnees = json.load(f)
        if not isinstance(donnees, dict):
            log.warning(
                f"charger_registre_profils_config() : contenu JSON racine "
                f"n'est pas un dict (type={type(donnees).__name__}) -- retourne {{}}."
            )
            return {}
    except (OSError, ValueError) as e:
        log.warning(f"charger_registre_profils_config() : lecture impossible ({e!r}) -- registre traité comme vide.")
        return {}

    resultat: dict[str, dict] = {}
    # CORRECTIF (migration -- bug "clé fantôme", cf. docstring de
    # definir_youtube_config_profil) -- si le fichier contient déjà une
    # clé non-string (héritée d'un ancien bug, avant le str() forcé à
    # l'écriture), json.load() l'aura de toute façon déjà rendue string
    # (JSON ne connaît que des clés string) -- mais DEUX clés Python
    # distinctes AVANT cette correction ont pu être aplaties en UNE SEULE
    # clé JSON identique lors d'un `json.dump` antérieur (ex. "false" et
    # False -> toutes deux sérialisées "false"), l'une écrasant l'autre
    # silencieusement selon l'ordre d'itération. Rien à migrer ici de
    # plus que la lecture normale ci-dessous : ce commentaire documente
    # le fait que la boucle suivante voit déjà des clés propres --
    # seule l'ÉCRITURE (definir_<badge>_config_profil) pouvait
    # introduire la clé bool, désormais bloqué par le str() forcé.
    for nom, config in donnees.items():
        if not isinstance(config, dict):
            continue
        type_instance = config.get("type_instance")
        if type_instance not in TYPES_INSTANCE_VALIDES:
            type_instance = "chrome"
        proxy = config.get("proxy")
        if not isinstance(proxy, dict):
            proxy = None
        pays = config.get("pays")
        if not (isinstance(pays, str) and len(pays) == 2 and pays.isalpha()):
            pays = None
        youtube = bool(config.get("youtube", False))
        ip = config.get("ip")
        if not isinstance(ip, str) or not ip:
            ip = None
        # PATCH (retour utilisateur explicite : "enlève le badge
        # youtube ... tu vas mettre 3 badges : youtube, tiktok, et un
        # symbole de ia") -- "tiktok"/"ia" lus explicitement ici, comme
        # "ip"/"youtube" ci-dessus -- cf. CORRECTIF plus haut dans cette
        # docstring : une reconstruction de dict qui omettrait un champ
        # existant sur disque le jetterait silencieusement à chaque
        # rechargement (c'est exactement ce qui avait fait disparaître
        # "ip"). Les deux nouveaux champs sont donc inclus dès leur
        # introduction, pas ajoutés après coup.
        tiktok = bool(config.get("tiktok", False))
        ia = bool(config.get("ia", False))
        # PATCH (demande utilisateur explicite : onglet Favoris) -- "favori"
        # lu explicitement ici, même principe que "tiktok"/"ia" ci-dessus
        # (cf. CORRECTIF plus haut dans cette docstring : une reconstruction
        # de dict qui omettrait un champ existant sur disque le jetterait
        # silencieusement à chaque rechargement).
        favori = bool(config.get("favori", False))
        # PATCH (demande utilisateur explicite : "tu vas rajouter le
        # badge Test") -- "test" lu explicitement ici, même principe que
        # "favori"/"tiktok"/"ia" ci-dessus (cf. CORRECTIF plus haut dans
        # cette docstring : une reconstruction de dict qui omettrait un
        # champ existant sur disque le jetterait silencieusement à
        # chaque rechargement -- exactement le bug déjà vécu avec "ip").
        test = bool(config.get("test", False))
        # CORRECTIF (bug n°4, SPEC_proxy_natif_tunnel.md section 13.1 --
        # même piège EXACT documenté juste au-dessus pour "ip"/"tiktok"/
        # "ia"/"favori"/"test" : "proxy_natif" avait été ajouté à
        # CONFIG_PROFIL_PAR_DEFAUT et à obtenir_config_profil (setdefault)
        # mais PAS à cette reconstruction manuelle -- silencieusement jeté
        # à CHAQUE rechargement du registre, donc effacé dès qu'une AUTRE
        # fonction definir_<badge>_config_profil (favori/test/tiktok/ia/
        # youtube) réécrivait le fichier pour ce même profil, peu importe
        # l'ordre d'appel avec definir_proxy_natif_config_profil).
        proxy_natif = bool(config.get("proxy_natif", False))
        # CORRECTIF (toggle "bloquer médias" par profil) -- MÊME piège que
        # "ip"/"tiktok"/"ia"/"favori"/"test"/"proxy_natif" ci-dessus : ce
        # dict est reconstruit champ par champ, donc TOUT champ non listé
        # ici est silencieusement jeté à chaque relecture -- sans cette
        # ligne, bloquer_media écrit sur disque par
        # definir_bloquer_media_config_profil disparaissait à la relecture
        # suivante (obtenir_config_profil retombait alors toujours sur le
        # setdefault False) : le bouton de la carte et la relecture à
        # chaud côté instance restaient TOUJOURS sur OFF, quel que soit
        # le clic.
        bloquer_media = bool(config.get("bloquer_media", False))
        resultat[str(nom)] = {
            "type_instance": type_instance, "proxy": proxy, "pays": pays, "youtube": youtube,
            "ip": ip, "tiktok": tiktok, "ia": ia, "favori": favori, "test": test,
            "proxy_natif": proxy_natif, "bloquer_media": bloquer_media,
        }
    return resultat


def sauvegarder_registre_profils_config(configs: dict[str, dict]) -> bool:
    """Écrit le registre {nom_profil: {"type_instance", "proxy", "pays",
    "youtube"}} sur disque -- même tolérance aux échecs d'écriture que
    sauvegarder_registre_profils (journalisé, jamais bloquant).

    CORRECTIF (retour utilisateur explicite : "dans le profils local sa
    doit etre direct ... actuelement la modifications nes pas
    persistant") -- cause trouvée : cette fonction avalait silencieusement
    tout OSError (dossier D:\\ScaleTube\\... absent/inaccessible sur la
    machine courante, par ex.) sans jamais le signaler à l'appelant --
    les fonctions definir_<badge>_config_profil retournaient alors
    toujours `True` (la valeur demandée, jamais vérifiée), et le badge
    UI était repeint comme un succès alors que RIEN n'avait été écrit sur
    disque. Retourne désormais True/False (succès réel de l'écriture) --
    cf. definir_youtube_config_profil et consorts, qui propagent
    maintenant cette valeur à ProfilsLocalScreen._construire_widget_
    badges pour annuler visuellement un badge dont l'écriture a échoué
    plutôt que de mentir sur son état."""
    try:
        DOSSIER_RACINE_PROFILS.mkdir(parents=True, exist_ok=True)
        with open(FICHIER_REGISTRE_PROFILS_CONFIG, "w", encoding="utf-8") as f:
            json.dump(configs, f, ensure_ascii=False, indent=2)
            f.flush()
            os.fsync(f.fileno())
    except OSError as e:
        log.warning(f"sauvegarder_registre_profils_config() : ÉCHEC ÉCRITURE : {e!r} -- registre non persisté sur disque.")
        return False

    # Vérification post-écriture : on relit IMMÉDIATEMENT ce qui vient
    # d'être écrit, pour détecter tout écart silencieux (permissions
    # bizarres, antivirus qui bloque, sync cloud qui verrouille le
    # fichier, autre process qui écrase juste après, etc.)
    try:
        with open(FICHIER_REGISTRE_PROFILS_CONFIG, "r", encoding="utf-8") as f:
            relu = json.load(f)
        if relu != configs:
            log.warning(
                f"sauvegarder_registre_profils_config() : !!! DIVERGENCE !!! "
                f"ce qui a été écrit != ce qui est relu juste après."
            )
    except Exception as e:
        log.warning(f"sauvegarder_registre_profils_config() : écriture réussie mais relecture de vérification a échoué : {e!r}")

    return True


# ---------------------------------------------------------------------------
# AJOUT (spec A.4 -- JSON de contraintes de résolution d'écran pour la
# génération en masse de profils, panneau "Instances sAutoniax" ->
# PanneauProprietesSautoniax). Format v1, résolution d'écran uniquement :
#     {"Résolution d'écran": ["height>700", "width>600"]}
# Une seule clé fixe reconnue ("Résolution d'écran"), toute autre clé
# silencieusement ignorée (extension future prévue, pas une erreur).
# Fonctions module-level (pas des méthodes) : réutilisées à la fois côté UI
# (validation immédiate au clic "Coller"/"Générer", cf.
# PanneauProprietesSautoniax) et côté génération réelle du fingerprint (cf.
# _camoufox_construire_config_lancement) -- un seul parseur, jamais deux
# logiques différentes qui pourraient diverger.
# ---------------------------------------------------------------------------

_REGEX_CONTRAINTE_RESOLUTION = re.compile(r"^(height|width)\s*(>=|<=|>|<|=)\s*(\d+)$")


def parser_contraintes_generation_profil(texte_json: str) -> tuple[bool, dict, str]:
    """Valide et parse le texte collé/saisi dans le champ de contraintes
    de génération (cf. PanneauProprietesSautoniax, bloc génération en
    masse). Retourne (ok, contraintes, message_erreur) :

    - Texte vide (ou ne contenant que des espaces) -> (True, {}, "") --
      contrainte vide, valide, génération sans aucune contrainte de
      résolution (statu quo actuel).
    - Texte non vide mais JSON syntaxiquement invalide -> (False, {},
      message clair incluant le détail json.JSONDecodeError).
    - JSON valide mais pas un objet (dict) de premier niveau -> (False,
      {}, message clair).
    - Clé "Résolution d'écran" absente, ou JSON valide mais vide {} ->
      (True, {}, "") -- aucune contrainte, résolution laissée aléatoire.
    - Clé "Résolution d'écran" présente : DOIT être une liste de chaînes
      au format "<height|width><opérateur><entier>" (opérateurs >, <, >=,
      <=, =, cf. _REGEX_CONTRAINTE_RESOLUTION). Toute entrée qui ne
      matche pas ce format -> JSON considéré invalide (False, {},
      message pointant l'entrée fautive) -- même traitement bloquant
      qu'une erreur de syntaxe JSON, cf. décision tranchée de la spec.
    - Toutes les entrées valident -> (True, contraintes, "") où
      contraintes = {"Résolution d'écran": [...]} (uniquement cette clé,
      les autres clés du JSON collé sont silencieusement omises du
      résultat, cf. "autres clés silencieusement ignorées en v1").

    FORMAT EXACT ATTENDU PAR CE PARSEUR -- pour toute IA amenée à écrire
    ce JSON (ex. depuis le bouton "Coller les contraintes" du panneau de
    propriétés d'un sAutoniax) :

        {"Résolution d'écran": ["height>700", "width>=1280"]}

    Règles à respecter à la lettre :
    - Un seul objet JSON de premier niveau, UNE SEULE clé reconnue :
      "Résolution d'écran" (accents et majuscule/minuscule exacts --
      toute autre clé est silencieusement ignorée, PAS une erreur en
      soi, mais n'a aucun effet).
    - La valeur de cette clé DOIT être une liste de chaînes (jamais un
      nombre, un objet, ou une chaîne seule hors liste).
    - Chaque chaîne de la liste suit EXACTEMENT le motif
      "<champ><opérateur><entier>" :
        * <champ> : "height" ou "width" (anglais, minuscules, rien
          d'autre -- ni "hauteur"/"largeur", ni majuscule).
        * <opérateur> : l'un de > < >= <= = (espaces autour tolérés,
          mais pas obligatoires).
        * <entier> : un nombre entier positif, sans unité ni décimale
          (ex. "700", jamais "700px" ni "700.0").
      Exemples valides : "height>700", "width<1920", "height>=800",
      "width<=1600", "width=1366".
    - Une contrainte stricte (>, <) borne à ±1 de la valeur donnée côté
      génération (height>700 exclut 700 lui-même) -- >=/<=/= sont
      inclusifs tels quels. Combiner plusieurs entrées sur le même champ
      (ex. "height>700" ET "height<1200") revient à borner un intervalle.
    - N'importe quelle entrée mal formée (mauvaise casse, opérateur
      inconnu, valeur non entière, clé racine différente de "Résolution
      d'écran" pour porter la liste) invalide la TOTALITÉ du JSON envoyé
      : rien n'est appliqué partiellement, et le filtre précédemment actif
      (s'il y en avait un) n'est PAS remplacé -- il faut renvoyer un JSON
      entièrement valide pour changer quoi que ce soit.
    - Un JSON vide ({}), une clé absente, ou un texte totalement vide
      sont tous les trois valides et signifient "aucune contrainte" --
      la résolution d'écran du profil sera alors tirée aléatoirement par
      BrowserForge/Camoufox, comportement par défaut inchangé.
    - Cette contrainte n'a d'effet qu'une seule fois, au tout premier
      lancement réel du profil créé APRÈS l'envoi de ce JSON (cf.
      enregistrer_config_profil / _camoufox_construire_config_lancement)
      -- elle n'a aucun effet rétroactif sur un profil déjà créé ou déjà
      lancé, et n'est pas modifiable ensuite depuis la carte du profil."""
    texte = (texte_json or "").strip()
    if not texte:
        return True, {}, ""

    try:
        brut = json.loads(texte)
    except json.JSONDecodeError as e:
        return False, {}, f"JSON de contraintes invalide : {e}"

    if not isinstance(brut, dict):
        return False, {}, "JSON de contraintes invalide : un objet ({...}) est attendu au premier niveau."

    entrees_resolution = brut.get("Résolution d'écran")
    if entrees_resolution is None:
        # Clé absente (ou JSON vide {}) -- aucune contrainte, autres clés
        # éventuelles silencieusement ignorées (cf. docstring).
        return True, {}, ""

    if not isinstance(entrees_resolution, list) or not all(isinstance(e, str) for e in entrees_resolution):
        return False, {}, "JSON de contraintes invalide : \"Résolution d'écran\" doit être une liste de chaînes."

    for entree in entrees_resolution:
        if not _REGEX_CONTRAINTE_RESOLUTION.match(entree.strip()):
            return False, {}, (
                f"JSON de contraintes invalide : entrée \"{entree}\" mal formée -- "
                f"attendu \"height\"/\"width\" suivi de >, <, >=, <= ou =, puis un entier "
                f"(ex. \"height>700\")."
            )

    return True, {"Résolution d'écran": [e.strip() for e in entrees_resolution]}, ""


def _construire_screen_camoufox_depuis_contraintes(contraintes: Optional[dict]):
    """Traduit le dict de contraintes (cf. parser_contraintes_generation_
    profil) en objet camoufox.utils.Screen borné, prêt à être posé dans
    config["screen"] avant l'appel à launch_options() -- cf. docstring de
    _camoufox_construire_config_lancement pour le point d'appel exact.

    Une contrainte stricte (">" ou "<") est traduite en borne inclusive
    décalée d'une unité (height>700 -> min_height=701 ; width<1920 ->
    max_width=1919), puisque Screen n'expose que des bornes inclusives
    min_*/max_* -- ">="/"<=" sont eux traduits directement sans décalage.

    Retourne None si `contraintes` est vide/absent, si _CamoufoxScreen
    n'est pas disponible (import camoufox trop ancien/absent, cf. son
    docstring d'import), ou si la clé "Résolution d'écran" est absente --
    l'appelant doit alors simplement omettre "screen" de la config
    (résolution laissée aléatoire, comportement actuel inchangé)."""
    if not contraintes or _CamoufoxScreen is None:
        return None
    entrees = contraintes.get("Résolution d'écran")
    if not entrees:
        return None

    bornes: dict[str, int] = {}
    for entree in entrees:
        m = _REGEX_CONTRAINTE_RESOLUTION.match(entree.strip())
        if not m:
            # Défensif -- ne devrait jamais arriver ici puisque
            # parser_contraintes_generation_profil a déjà validé ce
            # format au moment de l'enregistrement, mais une contrainte
            # corrompue directement dans profils_config.json (édition
            # manuelle, ancienne version...) ne doit pas faire planter la
            # génération : cette entrée précise est simplement ignorée.
            continue
        champ, operateur, valeur_str = m.group(1), m.group(2), int(m.group(3))
        if champ == "height":
            cle_min, cle_max = "min_height", "max_height"
        else:
            cle_min, cle_max = "min_width", "max_width"
        if operateur == ">":
            bornes[cle_min] = valeur_str + 1
        elif operateur == ">=":
            bornes[cle_min] = valeur_str
        elif operateur == "<":
            bornes[cle_max] = valeur_str - 1
        elif operateur == "<=":
            bornes[cle_max] = valeur_str
        elif operateur == "=":
            bornes[cle_min] = valeur_str
            bornes[cle_max] = valeur_str

    if not bornes:
        return None
    try:
        return _CamoufoxScreen(**bornes)
    except Exception as e:
        # Bornes incohérentes (ex. min_height > max_height) ou paramètre
        # inattendu selon la version de camoufox installée -- cf.
        # décision tranchée de la spec : repli SILENCIEUX sur une
        # génération sans contrainte de résolution pour ce profil précis,
        # jamais un échec de la création du profil entier pour ce seul
        # motif. Journalisé pour ne pas être totalement invisible.
        log.warning(
            f"[camoufox] contrainte de résolution ignorée (Screen(**{bornes!r}) "
            f"a échoué : {e!r}) -- génération sans contrainte de résolution pour ce profil."
        )
        return None


# PATCH (retour utilisateur explicite : "parfois les donnee recrit ne
# corespond pas avec les donnee reels" -- le filtre affiche bien "900" mais
# le profil généré est visiblement différent) -- root cause identifiée par
# lecture directe du code source de browserforge (fingerprints/generator.py,
# FingerprintGenerator.generate/partial_csp) : par défaut `strict=False`
# (camoufox.utils.launch_options ne passe JAMAIS `strict=True`, vérifié --
# aucune occurrence de ce mot-clé dans camoufox/utils.py), donc si AUCUNE
# résolution du jeu de données BrowserForge ne satisfait à la fois la
# contrainte demandée ET les autres attributs déjà tirés (OS, user-agent...),
# BrowserForge ne lève PAS d'exception : il fait
# `del filtered_values['screen']` en interne et régénère un fingerprint SANS
# AUCUNE contrainte de résolution, silencieusement -- ce n'est donc PAS un
# bug d'affichage ni un bug côté AutoniaX, c'est un repli intégré à
# BrowserForge, invisible jusqu'ici car rien ne comparait la résolution
# obtenue à la résolution demandée après coup.
#
# Cette fonction fait cette comparaison a posteriori, en réutilisant
# EXACTEMENT le même parsing que _construire_screen_camoufox_depuis_contraintes
# (même regex _REGEX_CONTRAINTE_RESOLUTION) mais appliqué au résultat déjà
# généré plutôt qu'à la config d'entrée -- cf. camoufox_demarrer_navigateur,
# qui boucle sur cette vérification (RETRY_MAX_CONTRAINTE_ECRAN tentatives)
# avant d'abandonner PROPREMENT (exception explicite, plus de silence) si
# aucun essai ne satisfait la contrainte -- décision explicite utilisateur :
# "bloquant, regenerer automatiquement... ou echouer proprement apres N essais".
def _verifier_resolution_respecte_contraintes(
    contraintes: Optional[dict], opts_from_options: dict,
) -> tuple[bool, Optional[int], Optional[int]]:
    """Vérifie si le fingerprint fraîchement généré (`opts_from_options`,
    dict complet retourné par camoufox.utils.launch_options()) respecte
    RÉELLEMENT la contrainte "Résolution d'écran" demandée (`contraintes`,
    cf. parser_contraintes_generation_profil).

    Retourne (ok, hauteur_obtenue, largeur_obtenue) :
    - (True, h, l) si aucune contrainte n'était demandée (rien à vérifier),
      ou si la résolution obtenue respecte bien toutes les bornes.
    - (False, h, l) si une contrainte était demandée mais que la résolution
      obtenue ne la respecte pas (repli silencieux BrowserForge détecté) --
      h/l restent renseignés (résolution réellement obtenue) pour un log
      exploitable, même en cas d'échec.
    - (True, None, None) si `screen.width`/`screen.height` sont absents du
      fingerprint généré (config BrowserForge inattendue) -- défensif,
      jamais bloquant pour un cas qu'on ne sait pas interpréter avec
      certitude ; seul un écart AVÉRÉ (valeurs lues, hors bornes) déclenche
      un nouvel essai côté appelant.

    Réutilise _camoufox_extraire_config_brute (même décodage
    env["CAMOU_CONFIG_N"] que l'affichage des propriétés, cf.
    _camoufox_extraire_proprietes_fingerprint) pour lire `screen.width`/
    `screen.height` -- une seule source de vérité pour ce décodage dans
    tout le fichier."""
    if not contraintes:
        return True, None, None
    entrees = contraintes.get("Résolution d'écran")
    if not entrees:
        return True, None, None

    bornes: dict[str, int] = {}
    for entree in entrees:
        m = _REGEX_CONTRAINTE_RESOLUTION.match(entree.strip())
        if not m:
            continue
        champ, operateur, valeur_str = m.group(1), m.group(2), int(m.group(3))
        cle_min, cle_max = ("min_height", "max_height") if champ == "height" else ("min_width", "max_width")
        if operateur == ">":
            bornes[cle_min] = valeur_str + 1
        elif operateur == ">=":
            bornes[cle_min] = valeur_str
        elif operateur == "<":
            bornes[cle_max] = valeur_str - 1
        elif operateur == "<=":
            bornes[cle_max] = valeur_str
        elif operateur == "=":
            bornes[cle_min] = valeur_str
            bornes[cle_max] = valeur_str
    if not bornes:
        return True, None, None

    config_brute = _camoufox_extraire_config_brute(opts_from_options)

    def _get_dimension(nom: str) -> Optional[int]:
        for separateur in (".", ":"):
            variante = f"screen{separateur}{nom}"
            valeur = config_brute.get(variante)
            if isinstance(valeur, int):
                return valeur
        return None

    hauteur = _get_dimension("height")
    largeur = _get_dimension("width")
    if hauteur is None and largeur is None:
        # Structure BrowserForge inattendue (clé absente) -- pas assez
        # d'information pour affirmer un écart, cf. docstring : on ne
        # bloque pas sur un cas qu'on ne sait pas lire avec certitude.
        return True, None, None

    ok = True
    if hauteur is not None:
        if "min_height" in bornes and hauteur < bornes["min_height"]:
            ok = False
        if "max_height" in bornes and hauteur > bornes["max_height"]:
            ok = False
    if largeur is not None:
        if "min_width" in bornes and largeur < bornes["min_width"]:
            ok = False
        if "max_width" in bornes and largeur > bornes["max_width"]:
            ok = False
    return ok, hauteur, largeur


def obtenir_config_profil(nom: str) -> dict:
    """Retourne la config ({"type_instance", "proxy", "pays", "youtube",
    "ip"}) d'un profil nommé, ou CONFIG_PROFIL_PAR_DEFAUT (chrome, sans
    proxy, sans pays, youtube désactivé, sans ip) s'il n'a pas encore
    d'entrée dans profils_config.json -- cas normal pour tout profil créé
    AVANT ce patch, qui doit continuer à se lancer comme avant sans
    qu'aucune migration explicite ne soit nécessaire.

    PATCH (retour utilisateur explicite : "juse en bas de la ligne de
    drapeau on met ladresse proxy, ladress ip") -- "ip" (nouveau champ,
    optionnel) : IP publique détectée lors du DERNIER test de proxy
    réussi (cf. definir_pays_config_profil ci-dessous, qui écrit
    maintenant "pays" ET "ip" ensemble). setdefault ici pour qu'une
    config JSON existante, écrite par une version antérieure du fichier
    AVANT l'ajout de ce champ, continue de fonctionner sans KeyError côté
    ProfilsGridItemDelegate -- pas besoin de migration explicite du
    registre sur disque.

    CORRECTIF (bug "clé fantôme", cf. docstring de
    definir_youtube_config_profil) -- `nom` forcé en str() pour que la
    RECHERCHE (`configs.get(nom, ...)`) utilise exactement la même clé
    que celle utilisée à l'ÉCRITURE (configs[str(nom)] = ...) -- sinon
    un appelant passant un objet non-string ici lirait toujours la
    valeur par défaut, jamais l'entrée réellement enregistrée."""
    nom = str(nom)
    configs = charger_registre_profils_config()
    config = configs.get(nom, dict(CONFIG_PROFIL_PAR_DEFAUT))
    config.setdefault("ip", None)
    # PATCH (retour utilisateur explicite : "tu vas mettre 3 badges :
    # youtube, tiktok, et un symbole de ia") -- même repli defensif que
    # "ip" ci-dessus, pour une config existante écrite AVANT ce patch.
    config.setdefault("tiktok", False)
    config.setdefault("ia", False)
    # PATCH (demande utilisateur explicite : onglet Favoris) -- même
    # repli défensif, pour une config existante écrite AVANT ce patch.
    config.setdefault("favori", False)
    # AJOUT (spec A.4 -- JSON de contraintes de résolution d'écran) --
    # {} par défaut pour toute config existante écrite AVANT ce patch
    # (même repli défensif que les champs ci-dessus) : cf.
    # definir_contraintes_ecran_config_profil, seule fonction qui écrit
    # une valeur non vide ici, appelée UNE FOIS au moment de la création
    # du profil (cf. _sautoniax_creer_profil), PAS modifiable ensuite
    # depuis la carte du profil (contrairement à youtube/tiktok/ia/
    # favori) -- une contrainte n'a de sens qu'au moment où le
    # fingerprint est réellement généré, cf. _camoufox_construire_
    # config_lancement.
    config.setdefault("contraintes_ecran", {})
    # PATCH (SPEC_proxy_natif_tunnel.md, section 13.1) -- False par
    # défaut pour toute config existante écrite AVANT ce patch (même
    # repli défensif que "tiktok"/"ia"/"favori"/"test" ci-dessus).
    config.setdefault("proxy_natif", False)
    # PATCH (toggle "bloquer médias" par profil) -- même repli défensif
    # que "proxy_natif"/"tiktok"/"ia"/"favori" ci-dessus, pour une config
    # existante écrite AVANT ce patch.
    config.setdefault("bloquer_media", False)
    return config


def enregistrer_config_profil(
    nom: str, type_instance: str, proxy: Optional[dict], pays: Optional[str] = None,
    contraintes_ecran: Optional[dict] = None,
) -> None:
    """Écrit/remplace la config d'un profil nommé dans
    profils_config.json. Appelée à la création (cf.
    DialogueNouveauProfil/_on_clic_nouveau_profil) -- le type d'instance
    est ensuite figé (cf. décision utilisateur : choisi une fois pour
    toutes à la création, jamais modifié après coup), donc cette fonction
    n'est PAS censée être rappelée pour changer le type_instance d'un
    profil existant. Elle reste toutefois généraliste (pas de garde
    "si déjà présent, refuser") pour rester simple et symétrique avec
    renommer_config_profil/supprimer_config_profil ci-dessous.

    `pays` (nouveau, optionnel) : code ISO du proxy fourni, cf. docstring
    du bloc "Config étendue par profil" plus haut -- None si le proxy n'a
    pas été testé avec succès avant la création (cas normal, le test est
    facultatif). `youtube` n'est volontairement PAS un paramètre ici :
    toujours False à la création, seul definir_youtube_config_profil
    (plus bas) le fait basculer par la suite, depuis la carte elle-même.

    `contraintes_ecran` (AJOUT, spec A.4) : dict issu de
    parser_contraintes_generation_profil (ex. {"Résolution d'écran":
    ["height>700", "width>600"]}), résolu UNE FOIS par le pilote au
    lancement du lot de génération en masse et transmis jusqu'ici via le
    protocole réseau (cf. _sautoniax_creer_profil) -- écrit tel quel dans
    profils_config.json, PAS modifiable ensuite depuis la carte du profil
    (contrairement à youtube/tiktok/ia/favori, cf. docstring ci-dessus) :
    lu une seule fois par _camoufox_construire_config_lancement, au tout
    premier lancement réel de CE profil (cf. sa docstring -- c'est à ce
    moment précis, pas à la création, que le fingerprint/la résolution
    est réellement généré par BrowserForge)."""
    if type_instance not in TYPES_INSTANCE_VALIDES:
        type_instance = "chrome"
    configs = charger_registre_profils_config()
    # PATCH (retour utilisateur explicite : "tu vas mettre 3 badges :
    # youtube, tiktok, et un symbole de ia") -- "tiktok"/"ia" à False à
    # la création, même principe que "youtube" (cf. docstring ci-dessus :
    # seuls definir_tiktok_config_profil/definir_ia_config_profil les
    # font basculer par la suite, depuis la carte elle-même).
    configs[nom] = {
        "type_instance": type_instance, "proxy": proxy, "pays": pays, "youtube": False, "ip": None,
        "tiktok": False, "ia": False, "favori": False,
        "contraintes_ecran": contraintes_ecran or {},
    }
    sauvegarder_registre_profils_config(configs)


def definir_pays_config_profil(nom: str, pays: Optional[str], ip: Optional[str] = None) -> None:
    """Met à jour les champs "pays" ET "ip" d'un profil déjà enregistré
    -- appelée après un test de proxy réussi (carte de création, menu
    contextuel "Localiser le proxy", ou test automatique au lancement,
    cf. _sur_resultat_localisation_proxy). Ne fait rien si le profil n'a
    pas encore d'entrée (pas d'effet secondaire de création partielle --
    le pays/l'ip seront de toute façon écrits au bon moment si/quand le
    profil est créé, cf. enregistrer_config_profil).

    PATCH (retour utilisateur explicite : "juse en bas de la ligne de
    drapeau on met ladresse proxy, ladress ip") -- `ip` (nouveau
    paramètre, optionnel) : IP publique retournée par TestProxyWorker
    (infos["ip"]) lors du même test qui a fourni `pays` -- écrite dans le
    MÊME appel/write disque plutôt qu'une fonction dédiée séparée, pour
    ne jamais avoir un pays à jour avec une IP d'un test précédent (les
    deux proviennent toujours de la même réponse ip-api.com, cf.
    TestProxyWorker._executer)."""
    configs = charger_registre_profils_config()
    if nom not in configs:
        return
    configs[nom]["pays"] = pays if (pays and len(pays) == 2 and pays.isalpha()) else None
    configs[nom]["ip"] = ip or None
    sauvegarder_registre_profils_config(configs)


def definir_youtube_config_profil(nom: str, youtube: bool) -> bool:
    """Bascule/écrit le badge YouTube d'un profil -- PATCH (demande
    utilisateur explicite : "un badge youtube ... que lon peu activer et
    desactiver par clic dessus, sa doit etre persistant"). Retourne le
    succès RÉEL de l'écriture disque (CORRECTIF -- cf. docstring de
    sauvegarder_registre_profils_config : avant ce correctif, la valeur
    demandée était retournée inconditionnellement, jamais le succès
    effectif de l'écriture, ce qui faisait croire à l'UI qu'un badge
    était persisté alors que l'écriture avait échoué en silence). Si le
    profil n'a pas encore d'entrée dans profils_config.json (créé avant
    ce patch), une entrée par défaut (chrome, sans proxy/pays) est créée
    à la volée avec ce seul champ youtube renseigné -- le badge doit
    rester utilisable même sur un profil ancien.

    CORRECTIF (bug "clé fantôme False" -- retour utilisateur explicite :
    "le badges active desactiver en local ne fonctionne pas") -- `nom`
    est désormais forcé en str() dès l'entrée. Cause trouvée : au moins
    un appelant transmettait parfois `nom` comme un objet non-string
    (ex. False), ce qui créait une DEUXIÈME clé dans profils_config.json
    (le bool False, distinct de la string "false" si un profil portait
    ce nom) -- au prochain rechargement, selon l'ordre d'itération du
    dict, l'une écrasait l'autre silencieusement, donnant l'impression
    que le badge ne se sauvegardait jamais ou revenait en arrière tout
    seul."""
    nom = str(nom)
    configs = charger_registre_profils_config()
    config_existante = configs.get(nom) or dict(CONFIG_PROFIL_PAR_DEFAUT)
    config_existante["youtube"] = bool(youtube)
    configs[nom] = config_existante
    return sauvegarder_registre_profils_config(configs)


