    def position_aleatoire(self, rayon_cm: float, timeout: Optional[float] = None) -> Tuple[int, int]:
        """Équivalent direct de InstanceExecutable.position_aleatoire()
        -- cf. sa docstring pour le comportement complet (tirage sur un
        cercle centré sur le curseur virtuel actuel ou le centre de
        l'écran, borné aux dimensions réelles)."""
        timeout = timeout if timeout is not None else self._global_defaut("TIMEOUT", None)
        params = {"timeout_action_s": timeout} if timeout is not None else {}
        reponse = self._appeler("getScreenInfo", params, timeout=timeout)
        if not reponse.get("ok"):
            raise RuntimeError(f"Échec de lecture de l'écran pour l'instance « {self.instance_id} » : {reponse.get('error')}")
        resultat = reponse.get("result") or {}
        largeur = resultat.get("largeur")
        hauteur = resultat.get("hauteur")
        if not isinstance(largeur, (int, float)) or not isinstance(hauteur, (int, float)) or largeur <= 0 or hauteur <= 0:
            raise RuntimeError(f"Dimensions d'écran invalides reçues pour l'instance « {self.instance_id} » : {resultat!r}")
        curseur_x, curseur_y = resultat.get("curseur_x"), resultat.get("curseur_y")
        if curseur_x is not None and curseur_y is not None:
            centre_x, centre_y = float(curseur_x), float(curseur_y)
        else:
            centre_x, centre_y = largeur / 2.0, hauteur / 2.0
        rayon_px = max(0.0, float(rayon_cm)) * PIXELS_CSS_PAR_CM
        angle = random.uniform(0.0, 2.0 * math.pi)
        x = centre_x + rayon_px * math.cos(angle)
        y = centre_y + rayon_px * math.sin(angle)
        x = max(0, min(int(largeur) - 1, round(x)))
        y = max(0, min(int(hauteur) - 1, round(y)))
        return (x, y)

    def mouse_move(self, x: int, y: int, retry: Optional[int] = None, timeout: Optional[float] = None,
                   latence_avant: Optional[float] = None, latence_apres: Optional[float] = None,
                   speed_percent: float = 0) -> "ResultatAction":
        """Équivalent direct de InstanceExecutable.mouse_move() -- cf.
        sa docstring pour le comportement complet (trajectoire humanisée
        via action_camoufox_mousemove, retry, ResultatAction)."""
        retry = retry if retry is not None else self._global_defaut("RETRY", 0)
        timeout = timeout if timeout is not None else self._global_defaut("TIMEOUT", None)
        latence_avant = latence_avant if latence_avant is not None else self._global_defaut("LATENCE_AVANT", 0.0)
        latence_apres = latence_apres if latence_apres is not None else self._global_defaut("LATENCE_APRES", 0.0)
        essais_total = max(1, retry + 1)
        derniere_erreur: Optional[str] = None
        params = {"x": int(x), "y": int(y), "speedPercent": speed_percent,
                  "instantane": self._global_defaut("SOURIS_INSTANTANEE", False)}
        if timeout is not None:
            params["timeout_action_s"] = timeout
        for _tentative in range(essais_total):
            if latence_avant:
                time.sleep(latence_avant)
            reponse = self._appeler("mousemove", params, timeout=timeout)
            if latence_apres:
                time.sleep(latence_apres)
            if reponse.get("ok"):
                return ResultatAction(True)
            derniere_erreur = reponse.get("error")
        return ResultatAction(
            False,
            f"Échec de mouse_move vers ({x}, {y}) pour l'instance « {self.instance_id} » "
            f"(après {essais_total} tentative(s)) : {derniere_erreur}",
        )

    def centrer_curseur(self, retry: Optional[int] = None, timeout: Optional[float] = None,
                        latence_avant: Optional[float] = None, latence_apres: Optional[float] = None,
                        speed_percent: float = 0) -> "ResultatAction":
        """Équivalent direct de InstanceExecutable.centrer_curseur() --
        cf. sa docstring pour le comportement complet (lit la taille
        d'écran via getScreenInfo -- même mécanisme que
        position_aleatoire() ci-dessus -- puis délègue à mouse_move()).
        AJOUT (même piège que naviguer/list_tabs/drag ci-dessus : cette
        méthode publique n'avait jamais été écrite ici, alors que
        getScreenInfo et mousemove sont tous deux déjà câblés côté
        _executer_commande_camoufox)."""
        timeout = timeout if timeout is not None else self._global_defaut("TIMEOUT", None)
        params = {"timeout_action_s": timeout} if timeout is not None else {}
        reponse = self._appeler("getScreenInfo", params, timeout=timeout)
        if not reponse.get("ok"):
            raise RuntimeError(f"Échec de lecture de l'écran pour l'instance « {self.instance_id} » : {reponse.get('error')}")
        resultat = reponse.get("result") or {}
        largeur = resultat.get("largeur")
        hauteur = resultat.get("hauteur")
        if not isinstance(largeur, (int, float)) or not isinstance(hauteur, (int, float)) or largeur <= 0 or hauteur <= 0:
            raise RuntimeError(f"Dimensions d'écran invalides reçues pour l'instance « {self.instance_id} » : {resultat!r}")
        centre_x = round(largeur / 2.0)
        centre_y = round(hauteur / 2.0)
        return self.mouse_move(centre_x, centre_y, retry=retry, timeout=timeout,
                                latence_avant=latence_avant, latence_apres=latence_apres,
                                speed_percent=speed_percent)

    def scroll(self, x: int, y: int, delta_x: float = 0.0, delta_y: float = 0.0,
               retry: Optional[int] = None, timeout: Optional[float] = None,
               latence_avant: Optional[float] = None, latence_apres: Optional[float] = None,
               speed_percent: float = 0) -> "ResultatAction":
        """Équivalent direct de InstanceExecutable.scroll() -- cf. sa
        docstring pour le comportement complet (défilement humanisé au
        point (x, y) donné, sans dépendre d'un Composant). AJOUT (même
        piège que centrer_curseur ci-dessus : l'action réseau "scroll"
        est déjà câblée côté _executer_commande_camoufox --
        action_camoufox_scroll -- mais cette méthode publique n'avait
        jamais été écrite ici)."""
        retry = retry if retry is not None else self._global_defaut("RETRY", 0)
        timeout = timeout if timeout is not None else self._global_defaut("TIMEOUT", None)
        latence_avant = latence_avant if latence_avant is not None else self._global_defaut("LATENCE_AVANT", 0.0)
        latence_apres = latence_apres if latence_apres is not None else self._global_defaut("LATENCE_APRES", 0.0)
        essais_total = max(1, retry + 1)
        derniere_erreur: Optional[str] = None
        params = {"x": int(x), "y": int(y), "targetDeltaX": delta_x, "targetDeltaY": delta_y,
                  "speedPercent": speed_percent,
                  "instantane": self._global_defaut("SOURIS_INSTANTANEE", False)}
        if timeout is not None:
            params["timeout_action_s"] = timeout
        for _tentative in range(essais_total):
            if latence_avant:
                time.sleep(latence_avant)
            reponse = self._appeler("scroll", params, timeout=timeout)
            if latence_apres:
                time.sleep(latence_apres)
            if reponse.get("ok"):
                return ResultatAction(True)
            derniere_erreur = reponse.get("error")
        return ResultatAction(
            False,
            f"Échec de scroll à ({x}, {y}) pour l'instance « {self.instance_id} » "
            f"(après {essais_total} tentative(s)) : {derniere_erreur}",
        )

    def glisser_souris(self, depart, arrivee, bouton: str = "gauche",
                       speed_percent: float = 0, retry: Optional[int] = None,
                       timeout: Optional[float] = None, latence_avant: Optional[float] = None,
                       latence_apres: Optional[float] = None) -> "ResultatAction":
        """glisser_souris(depart, arrivee) -- glisser (souris) en coordonnées
        écran : appui au point `depart`, déplacement humain, relâchement au
        point `arrivee`. Chaque paramètre = un point (x, y) ou une zone absolue
        (x, y, largeur, hauteur) dans laquelle un point est tiré au hasard.
        Distinct de drag() (dépôt de fichier)."""
        x1, y1 = point_ecran_depuis_cible(depart, "depart")
        x2, y2 = point_ecran_depuis_cible(arrivee, "arrivee")
        retry = retry if retry is not None else self._global_defaut("RETRY", 0)
        timeout = timeout if timeout is not None else self._global_defaut("TIMEOUT", None)
        latence_avant = latence_avant if latence_avant is not None else self._global_defaut("LATENCE_AVANT", 0.0)
        latence_apres = latence_apres if latence_apres is not None else self._global_defaut("LATENCE_APRES", 0.0)
        essais_total = max(1, retry + 1)
        derniere_erreur: Optional[str] = None
        params = {"x1": int(x1), "y1": int(y1), "x2": int(x2), "y2": int(y2), "bouton": bouton,
                  "speedPercent": speed_percent,
                  "instantane": self._global_defaut("SOURIS_INSTANTANEE", False)}
        if timeout is not None:
            params["timeout_action_s"] = timeout
        for _tentative in range(essais_total):
            if latence_avant:
                time.sleep(latence_avant)
            reponse = self._appeler("mouse_drag", params, timeout=timeout)
            if latence_apres:
                time.sleep(latence_apres)
            if reponse.get("ok"):
                return ResultatAction(True)
            derniere_erreur = reponse.get("error")
        return ResultatAction(
            False,
            f"Échec du glisser (souris) ({x1}, {y1}) -> ({x2}, {y2}) pour l'instance « {self.instance_id} » "
            f"(après {essais_total} tentative(s)) : {derniere_erreur}",
        )


class _MoteurDirectPourComposant:
    """PATCH (Composants en notebook distant, demande explicite
    utilisateur : "il ya toujout deja pour que sa sexcute correctement
    su rla machine disatce ... verifie tu me dit ce quil en est" --
    investigation confirmée : service_api.zip est déjà téléchargé et
    extrait côté sAutoniax par _sautoniax_telecharger_donnees_partagees
    (get_service_api_dir()), MAIS rien dans _sautoniax_executer_
    notebook_distant ne s'en servait jusqu'ici pour reconstruire un vrai
    ComposantExecutable -- seul le générique ServiceAPIExecutableDirect
    Camoufox (juste .instance()) était injecté, d'où l'AttributeError
    sur .visible()/.click()/etc. Ce correctif comble ce trou plutôt que
    d'en écrire un contournement côté client (cf. discussion explicite :
    "je veux que lesecution se passe directement sur le resau").

    Adaptateur MINIMAL, PAS une réimplémentation de ComposantExecutable :
    ComposantExecutable (mode local/réseau LAN classique) ne fait QUE
    DEUX appels réseau dans toute sa classe -- self._moteur._appeler(...)
    dans _detecter() et dans _executer_avec_retry() -- et les ~10
    méthodes publiques (visible/click/saisir/scroll/drag/...) ne
    touchent JAMAIS au réseau directement, seulement à ces deux points
    via self._moteur. Un ComposantExecutable(composant, instance_id,
    CET_ADAPTATEUR, namespace) fonctionne donc tel quel, sans une seule
    ligne modifiée dans ComposantExecutable elle-même -- même principe
    exactement que InstanceExecutableDirecteCamoufox pour InstanceExecutable,
    mais ici on RÉUTILISE la classe existante par composition au lieu de
    dupliquer ses ~10 méthodes publiques dans une nouvelle classe.

    Nom volontairement GÉNÉRIQUE (pas "...Camoufox...", cf. retour
    explicite utilisateur : "je veux aussi une seule, ne me complique
    pas") -- même raisonnement que MoteurExecutionCellule côté local, qui
    ne nomme aucun navigateur alors qu'il route indifféremment vers
    Chrome/CDP ou Camoufox selon l'instance visée : ComposantExecutable
    ne connaît QUE self._moteur._appeler(...), jamais le backend derrière.
    Aujourd'hui _executer_commande_camoufox (cf. corps de _appeler
    ci-dessous) est le SEUL dispatcher de commandes qui existe côté
    sAutoniax distant -- Camoufox est donc le seul backend réellement
    branché ici, mais uniquement parce qu'aucun équivalent distant pour
    Chrome/CDP n'existe encore dans ce fichier, pas parce que cet
    adaptateur serait conçu pour s'y limiter. Le jour où un tel
    équivalent existera, cette même classe (ou son corps de _appeler)
    pourra router vers l'un ou l'autre sans que ComposantExecutable ni
    son nom n'aient à changer.

    _appeler(instance_id, action, params, timeout) -- SIGNATURE IDENTIQUE
    à MoteurExecutionCellule._appeler (4 arguments, instance_id inclus,
    contrairement à InstanceExecutableDirecteCamoufox._appeler qui n'en
    a que 3 car self.instance_id est déjà fixé) : c'est cette signature
    précise que ComposantExecutable._detecter/_executer_avec_retry
    appellent en dur (self._moteur._appeler(self.instance_id, action,
    params, timeout=...)) -- instance_id reçu ici est donc IGNORÉ (déjà
    connu de ce côté via self._instance_id, capturé à la construction),
    mais DOIT rester dans la signature pour que l'appel existant, non
    modifié, continue de fonctionner sans TypeError."""

    _TIMEOUT_LIAISON_THREAD_S_DEFAUT = 60.0

    def __init__(self, instance_id: str, context, gestion: "GestionOngletsCamoufox",
                 etat_navigateur: dict, arret_demande: Optional["asyncio.Event"],
                 loop: Optional["asyncio.AbstractEventLoop"] = None):
        self._instance_id = instance_id
        self._context = context
        self._gestion = gestion
        self._etat_navigateur = etat_navigateur
        self._arret_demande = arret_demande
        self._loop = loop

    def _appeler(self, instance_id: str, action: str, params: dict, timeout: Optional[float] = None) -> dict:
        """Même mécanisme EXACT que InstanceExecutableDirecteCamoufox.
        _appeler (cf. sa docstring pour le détail complet du pont thread
        séparé -> boucle asyncio principale via run_coroutine_threadsafe)
        -- seule différence : `action`/`params` viennent ici de
        ComposantExecutable (capture_propre pour la détection, ou
        click/mousemove/scroll/... pour l'action elle-même), au lieu de
        InstanceExecutableDirecteCamoufox.capture()/mouse_move()/etc."""
        if self._loop is None:
            raise RuntimeError(
                f"ComposantExecutable('{instance_id}') exécuté en notebook distant sans boucle "
                "asyncio (self._loop) -- impossible d'exécuter une commande. Ceci indique un bug "
                "d'intégration (cf. docstring de _MoteurDirectPourComposant), pas une "
                "erreur du code utilisateur."
            )
        requete_id = uuid.uuid4().hex[:12]
        data = {"type": "command", "instance_id": self._instance_id, "action": action, "requete_id": requete_id, **params}

        async def _coroutine():
            try:
                return await _executer_commande_camoufox(
                    self._context, self._gestion, self._etat_navigateur, data, self._arret_demande,
                )
            except NavigateurFermeCamoufox as e:
                return {"ok": False, "error": f"navigateur fermé : {e}"}

        delai_s = timeout if timeout is not None else self._TIMEOUT_LIAISON_THREAD_S_DEFAUT
        future = asyncio.run_coroutine_threadsafe(_coroutine(), self._loop)
        try:
            return future.result(timeout=delai_s)
        except concurrent.futures.TimeoutError:
            return {"ok": False, "error": f"timeout ({delai_s}s) : aucune réponse pour l'action '{action}'"}


class _MoteurRelaisPourComposantIsole:
    """PATCH (Run de cellule réseau sur un profil ISOLÉ -- cf. SPEC_
    notebook_distant_profils_isoles.md, section 7) -- jumeau EXACT de
    _MoteurDirectPourComposant (même signature _appeler(instance_id,
    action, params, timeout), même contrat de retour {"ok": bool, ...}),
    mais route la commande vers un SOUS-PROCESSUS séparé (instance
    isolée, démarrée via le bouton "Démarrer" du panneau Instances --
    _instances_isolees, PAS namespace_notebook_distant) au lieu
    d'appeler _executer_commande_camoufox directement en mémoire locale
    (impossible ici : context/gestion/etat_navigateur de CETTE instance
    isolée vivent dans un AUTRE process, jamais accessibles depuis le
    process principal du sAutoniax).

    Réutilise le canal cross-process DÉJÀ fonctionnel et déjà utilisé en
    production pour le pilotage manuel (clic/scroll/frappe) d'une
    instance isolée : client_pilote_instances (ClientReseauAutoniaX
    interne, connecté au serveur LOCAL ws://127.0.0.1:8765 du sAutoniax,
    cf. _main_async_sautoniax) + protocole command/command_result déjà
    relayé par le serveur local (srv_gerer_command/srv_gerer_command_
    result) vers/depuis le subprocess de l'instance isolée. Même
    mécanisme d'attente bloquante (threading.Event + dict résultat) que
    MoteurExecutionCellule._appeler -- ce _appeler() est destiné à
    tourner sur un THREAD SÉPARÉ (cf. _sautoniax_executer_notebook_
    distant_sur_instance_isolee, exec() via loop.run_in_executor),
    jamais sur la boucle asyncio principale.

    _connecter_ecoute(client_pilote_instances) DOIT être appelée une
    seule fois par le code appelant AVANT toute exécution de cellule sur
    un profil isolé (cf. son site d'appel) -- ajoute un second listener
    sur le signal command_result_recu de client_pilote_instances, EN
    PLUS de celui déjà branché par _main_async_sautoniax pour le
    pilotage manuel (_sur_command_result_instance_isolee) : un signal Qt
    accepte nativement plusieurs listeners, chacun filtrant sur son
    propre requete_id (cf. self._callbacks_en_attente) -- AUCUN risque
    de conflit avec le listener existant, qui continue de fonctionner
    pour le pilotage manuel exactement comme avant ce correctif."""

    # CORRECTIF (bug rapporté : reset_interface() reste bloqué jusqu'à 60s
    # avant d'échouer, "obligé d'arrêter manuellement" -- cf. investigation
    # comparative avec AutoniaX_old.py, mode réseau simple/pilotage manuel
    # NON isolé) : 60.0 était copié tel quel du timeout de repli déjà en
    # place dans cette classe sans le confronter au comportement du chemin
    # le plus proche déjà existant. MoteurExecutionCellule._appeler (mode
    # réseau simple, cf. AutoniaX_old.py) -- l'équivalent pilote-vers-
    # instance directe, PAS le mode isolé cross-process, mais le seul autre
    # endroit du code qui attend un command_result de la même façon -- 
    # n'attend jamais plus de TIMEOUT_COMMANDE_MS = 15000ms (15s) avant de
    # renvoyer lui-même {"ok": False, "error": "timeout"} au code appelant,
    # même si l'instance reste bloquée indéfiniment côté CDP (cf. RÈGLE 1,
    # docstring de _injecter_page_accueil : page.send() n'a aucun timeout
    # interne, un .cancel() externe ne l'interrompt pas). Passer de 60.0 à
    # 15.0 aligne ce nouveau chemin (profil isolé) sur le comportement déjà
    # établi ailleurs dans le code : un échec CDP réel remonte proprement
    # en 15s maximum plutôt que de bloquer le spinner/la cellule jusqu'à 60s
    # avant que le pilote n'ait la moindre information exploitable.
    def __init__(self, instance_id: str, client_pilote_instances: "ClientReseauAutoniaX", timeout_defaut_s: float = 20.0):
        self._instance_id = instance_id
        self._client_pilote_instances = client_pilote_instances
        self._timeout_defaut_s = timeout_defaut_s
        self._callbacks_lock = threading.Lock()
        self._callbacks_en_attente: dict[str, tuple] = {}  # requete_id -> (threading.Event, dict résultat)
        # Identifiant court et stable de CETTE instance de moteur_relais
        # (basé sur id() Python), pour distinguer sans ambiguïté
        # plusieurs moteurs concurrents dans les logs, y compris quand
        # ils portent le même instance_id (deux notebooks lancés en
        # parallèle sur le même profil isolé).
        self._diag_moteur_uid = f"{id(self):x}"[-8:]
        # CORRECTIF (bug confirmé en usage réel -- "isInterfaceInitialisee"
        # et toute autre commande via _appeler() timeout systématique au
        # bout de 20s avec "instance ... non liée à ce pilote" côté log
        # serveur local) : client_pilote_instances (le pilote compagnon de
        # l'exécuteur, cf. main() -- id_client="executeur-pilote-{instance_id}-xxxxx")
        # n'a jamais fait de "link" avant d'envoyer une commande, contrairement
        # à ce que la docstring de classe suppose ("canal cross-process DÉJÀ
        # fonctionnel... pour le pilotage manuel", qui LUI se lie bien via
        # _lier_instance_isolee_au_client_pilote, process principal). Sans ce
        # link, srv_gerer_command refuse tout (instance.liee_a pointe encore
        # vers le pilote principal ou reste None) -- cf. srv_gerer_link,
        # "instance.liee_a != pilote_id" -> refus. _lier_si_besoin() ci-dessous
        # comble cet écart, appelée paresseusement au premier _appeler().
        #
        # BUGFIX RÉEL #2 (logs de production -- "instance ... non liée à
        # 'executeur-pilote-...' (liée à : 'sautoniax-pilote-0ecf416f')"
        # au 4e appel alors que les 3 précédents avaient réussi) :
        # _lien_ok=True était traité comme DÉFINITIF une fois obtenu ("un
        # seul link tenté par durée de vie de ce moteur_relais", cf.
        # ancienne docstring de _lier_si_besoin) -- FAUX dans ce système :
        # "le dernier link gagne" (cf. srv_gerer_link) veut dire que N'IMPORTE
        # QUEL AUTRE pilote peut voler la liaison à tout moment (concrètement
        # observé : entre deux exécutions de notebook, le serveur relie
        # automatiquement l'instance au pilote PRINCIPAL pour que le
        # dashboard/écran de test puisse la superviser, cf. "reprise par
        # 'sautoniax-pilote-...'" dans les logs) -- donc self._lien_ok=True
        # devient PÉRIMÉ dès qu'un autre pilote relie cette même instance,
        # sans que ce moteur_relais n'en soit informé... sauf que le serveur
        # envoie déjà "unlinked" à ce client précisément pour ce cas (cf.
        # ClientReseauAutoniaX.instance_deliee, "émis quand LE SERVEUR envoie
        # unlinked à ce client parce qu'un AUTRE pilote vient de reprendre
        # une instance que ce client avait lui-même en liaison"). Ce
        # signal existait déjà et était déjà émis correctement -- personne
        # ne l'écoutait ici. _connecter_ecoute()/_deconnecter_ecoute()
        # ci-dessous s'y abonnent désormais, _sur_instance_deliee() remet
        # self._lien_ok = False dès réception -- _lier_si_besoin() relance
        # alors un vrai link au prochain _appeler(), au lieu de faire
        # confiance à un flag qui ne reflète plus l'état réel côté serveur.
        self._lien_event = threading.Event()
        # CORRECTIF (A4, instance disparue) -- True dès que le serveur répond « instance ... introuvable » :
        # plus aucune retentative (8 s de link par commande), échec immédiat.
        self._instance_morte = False
        self._lien_ok: Optional[bool] = None  # None = jamais tenté, True/False = résultat du dernier essai (peut redevenir False si délié entre-temps, cf. _sur_instance_deliee)
        self._lien_lock = threading.Lock()

    def reinitialiser_liaison(self):
        """AJOUT (régénération du navigateur sous le MÊME instance_id) -- oublie l'état
        « liée »/« morte » : le navigateur a été remplacé, la liaison côté serveur local
        est neuve. Le prochain _appeler() refait un vrai link."""
        self._instance_morte = False
        self._lien_ok = False
        self._lien_event.clear()

    def _connecter_ecoute(self):
        # CORRECTIF CONFIRMÉ PAR LOGS (bug "resetInterface timeout 15s
        # systématique même quand command_result arrive en <5s avec
        # ok=True") : Qt.QueuedConnection poste le slot dans la boucle
        # d'ÉVÉNEMENTS QT du thread récepteur -- or sAutoniax (mode
        # --sautoniax, cf. if __name__ == "__main__" en fin de fichier)
        # ne crée JAMAIS de QApplication/QCoreApplication, donc aucune
        # boucle d'événements Qt ne tourne jamais sur le thread principal
        # pour dépiler cette file -- le signal est bien émis (confirmé :
        # le client réseau logue "<- command_result" avec ok=True), mais
        # _sur_command_result() n'est JAMAIS invoquée (confirmé : aucun
        # log "_sur_command_result() REÇU" n'apparaît jamais dans les
        # logs malgré l'instrumentation posée en tête de cette méthode) --
        # d'où le timeout de 15.0s à chaque fois, quelle que soit la
        # rapidité réelle de l'instance isolée à répondre. Qt.
        # DirectConnection exécute le slot directement dans le thread
        # ÉMETTEUR (celui du thread réseau de client_pilote_instances,
        # cf. ClientReseauAutoniaX._thread_principal), sans dépendre
        # d'une boucle d'événements Qt -- exactement le mécanisme déjà
        # utilisé avec succès par le listener permanent voisin
        # _sur_command_result_instance_isolee (cf. son site de connect,
        # Qt.DirectConnection). _sur_command_result() ne fait que lire
        # data et poser event.set() sous self._callbacks_lock (déjà
        # thread-safe), donc aucun risque supplémentaire à l'exécuter
        # directement sur le thread réseau plutôt que sur un hypothétique
        # thread Qt principal qui n'a jamais existé ici.
        self._client_pilote_instances.command_result_recu.connect(self._sur_command_result, Qt.DirectConnection)
        # CORRECTIF (cf. docstring __init__ -- link manquant) : mêmes raisons
        # exactement que ci-dessus pour command_result_recu (aucune boucle Qt
        # ne tourne dans ce process, DirectConnection obligatoire).
        self._client_pilote_instances.link_ok_recu.connect(self._sur_link_ok, Qt.DirectConnection)
        self._client_pilote_instances.liaison_echouee.connect(self._sur_liaison_echouee, Qt.DirectConnection)
        # BUGFIX RÉEL #2 (cf. docstring __init__ ci-dessus, "le dernier link
        # gagne") -- même raison DirectConnection que les 3 connect()
        # au-dessus : ce process ne fait tourner aucune boucle d'événements
        # Qt, donc QueuedConnection ne livrerait jamais ce signal.
        self._client_pilote_instances.instance_deliee.connect(self._sur_instance_deliee, Qt.DirectConnection)

    def _deconnecter_ecoute(self):
        try:
            self._client_pilote_instances.command_result_recu.disconnect(self._sur_command_result)
        except (RuntimeError, TypeError):
            pass  # déjà déconnecté ou jamais connecté -- comportement normal
        try:
            self._client_pilote_instances.link_ok_recu.disconnect(self._sur_link_ok)
        except (RuntimeError, TypeError):
            pass
        try:
            self._client_pilote_instances.liaison_echouee.disconnect(self._sur_liaison_echouee)
        except (RuntimeError, TypeError):
            pass
        try:
            self._client_pilote_instances.instance_deliee.disconnect(self._sur_instance_deliee)
        except (RuntimeError, TypeError):
            pass

    def _sur_command_result(self, data: dict):
        # Tourne sur le thread Qt principal (Qt.QueuedConnection, cf.
        # _connecter_ecoute) -- même thread que le listener existant
        # _sur_command_result_instance_isolee, aucune concurrence entre
        # les deux, chacun se contente de lire `data` sans le modifier.
        requete_id = data.get("requete_id")
        with self._callbacks_lock:
            entree = self._callbacks_en_attente.get(requete_id)
        if entree is None:
            return  # pas pour nous (autre requête, ou pilotage manuel classique)
        event, boite_resultat = entree
        boite_resultat["data"] = data
        event.set()

    def _sur_link_ok(self, instance_id: str):
        # Tourne sur le thread réseau de client_pilote_instances (Qt.
        # DirectConnection, cf. _connecter_ecoute) -- même patron que
        # _sur_command_result ci-dessus.
        if instance_id != self._instance_id:
            return  # pas pour nous (ne devrait pas arriver, ce client ne lie que self._instance_id)
        self._lien_ok = True
        self._lien_event.set()

    def _sur_liaison_echouee(self, instance_id: str, message: str):
        if instance_id != self._instance_id:
            return
        log.warning(
            f"[relais] liaison_echouee reçue pour {instance_id!r} : {message!r} -- "
            f"les commandes suivantes échoueront tant que le link n'aura pas réussi."
        )
        self._lien_ok = False
        if "introuvable" in (message or ""):
            self._instance_morte = True
        self._lien_event.set()

    def _sur_instance_deliee(self, instance_id: str, raison: str):
        """BUGFIX RÉEL #2 (cf. docstring __init__ -- "le dernier link
        gagne") -- réagit au signal instance_deliee de client_pilote_
        instances (message "unlinked" du serveur, cf. sa docstring :
        "émis quand LE SERVEUR envoie unlinked à CE client parce qu'un
        AUTRE pilote vient de reprendre une instance que ce client avait
        lui-même en liaison"). Remet self._lien_ok à False : la PROCHAINE
        commande (_appeler -> _lier_si_besoin) relancera un vrai "link"
        au lieu de faire confiance à un flag périmé qui affirmerait
        encore être lié alors que le serveur a déjà donné la liaison à
        quelqu'un d'autre entre-temps -- c'est exactement le scénario qui
        provoquait le refus "instance non liée à ce pilote" observé en
        production au 4e appel d'affilée (le pilote principal reprend la
        main entre deux exécutions de notebook, cf. logs).

        PAS de self._lien_lock ici, DÉLIBÉRÉMENT (à la différence de
        _sur_link_ok/_sur_liaison_echouee, qui n'en prennent pas non plus
        d'ailleurs) : _lier_si_besoin() tient ce lock pendant TOUT son
        wait(timeout=8.0) (cf. son corps) -- si ce signal arrivait
        pendant cette fenêtre sur le même thread réseau Qt.DirectConnection,
        prendre le lock ici bloquerait jusqu'à 8s l'acheminement des
        AUTRES signaux réseau (link_ok, liaison_echouee, command_result)
        qui transitent par ce même thread, un vrai risque de blocage en
        cascade. self._lien_ok est un simple bool Python -- son
        affectation est atomique au niveau du GIL, aucun verrou n'est
        nécessaire pour cette seule écriture. Le pire cas sans lock ici :
        une course bénigne avec _lier_si_besoin() qui vient de finir
        d'écrire self._lien_ok=True au moment où ce signal arrive --
        cette écriture-ci (False) gagne alors la course et c'est le
        résultat CORRECT (l'unlinked est par définition plus récent que
        le lien qu'il invalide)."""
        if instance_id != self._instance_id:
            return  # pas pour nous
        log.info(
            f"[relais] instance_deliee reçue pour {instance_id!r} (raison={raison!r}) -- "
            f"liaison marquée périmée, un nouveau link sera tenté au prochain appel."
        )
        self._lien_ok = False

    def _lier_si_besoin(self) -> bool:
        """Envoie "link" pour client_pilote_instances si ce n'est pas déjà
        fait -- IDEMPOTENT TANT QUE LA LIAISON RESTE VALIDE (pas
        "un seul link tenté par durée de vie de ce moteur_relais" comme
        le disait la docstring d'origine : cette hypothèse était FAUSSE
        en pratique, cf. BUGFIX RÉEL #2 dans la docstring __init__ --
        "le dernier link gagne" signifie que la liaison peut être reprise
        par un autre pilote À TOUT MOMENT entre deux appels de cette
        méthode). self._lien_ok ne reflète donc plus "j'ai un jour réussi
        à me lier" mais "je CROIS être encore lié maintenant" -- mis à
        jour à la baisse par _sur_instance_deliee() dès que le serveur
        notifie ce client qu'il a perdu la liaison (message "unlinked").
        Retourne True si la liaison est (ou était déjà, et toujours
        valide) établie, False sinon -- _appeler() envoie quand même la
        commande dans ce dernier cas (comportement inchangé pour ne rien
        casser si jamais ce link échouait pour une raison inattendue) :
        au pire, on retombe sur l'ancien comportement (refus explicite du
        serveur, immédiat depuis le bugfix "command_result au lieu
        d'error" -- plus jamais un timeout aveugle de 20s).

        Pas de verrou=True ici (à la différence de MoteurExecutionCellule.
        _lier_instance_si_besoin) : cet exécuteur est un process dédié à UNE
        seule instance pour toute sa durée de vie (cf. --instance-id), pas une
        cellule ponctuelle parmi d'autres -- il n'a pas besoin de reprendre la
        main de façon temporaire, juste de s'assurer qu'il l'a. Un pilote
        manuel qui relierait cette même instance plus tard délogerait ce
        client comme n'importe quel autre pilote ("le dernier link gagne",
        cf. srv_gerer_link) -- compromis déjà accepté partout ailleurs dans
        le code, pas un risque nouveau introduit ici : ce qui a changé, c'est
        que ce moteur s'en rend maintenant compte (cf. _sur_instance_deliee)
        au lieu de continuer aveuglément sur une liaison périmée."""
        if self._instance_morte:
            return False
        with self._lien_lock:
            if self._lien_ok:
                return True
            self._lien_event.clear()
            self._client_pilote_instances.envoyer_commande({
                "type": "link", "pilote_id": self._client_pilote_instances.id_client,
                "instance_id": self._instance_id,
            })
            obtenu = self._lien_event.wait(timeout=8.0)
            if not obtenu:
                log.warning(
                    f"[relais] _lier_si_besoin() : timeout (8.0s) en attendant link_ok/liaison_echouee "
                    f"pour {self._instance_id!r}."
                )
                return False
            return bool(self._lien_ok)

    def _envoyer_une_commande(self, action: str, params: dict, delai_s: float) -> dict:
        """Envoie UNE commande et attend SA réponse (ou son timeout) --
        factorisée hors de _appeler() pour permettre la retentative avec
        relink forcé ci-dessous (BUGFIX RÉEL #2, cf. docstring __init__)
        sans dupliquer toute la mécanique requete_id/callbacks_en_attente/
        event.wait."""
        requete_id = uuid.uuid4().hex[:12]
        event = threading.Event()
        boite_resultat: dict = {}
        t0 = time.monotonic()
        with self._callbacks_lock:
            self._callbacks_en_attente[requete_id] = (event, boite_resultat)
        message = {
            "type": "command", "instance_id": self._instance_id,
            "action": action, "requete_id": requete_id, **params,
        }
        self._client_pilote_instances.envoyer_commande(message)
        obtenu = event.wait(timeout=delai_s)
        duree_reelle = time.monotonic() - t0
        with self._callbacks_lock:
            self._callbacks_en_attente.pop(requete_id, None)
        if not obtenu:
            log.error(
                f"[relais] _appeler() TIMEOUT -- action={action!r} requete_id={requete_id!r} "
                f"instance_id={self._instance_id!r} après {duree_reelle:.3f}s (limite={delai_s}s)"
            )
            return {"ok": False, "error": f"timeout ({delai_s}s) : aucune réponse de l'instance isolée pour '{action}'"}
        return boite_resultat.get("data", {"ok": False, "error": "réponse vide"})

    def _appeler(self, instance_id: str, action: str, params: dict, timeout: Optional[float] = None) -> dict:
        """Signature IDENTIQUE à _MoteurDirectPourComposant._appeler et
        MoteurExecutionCellule._appeler (cf. leurs docstrings) --
        instance_id reçu ici est ignoré (déjà fixé via self._instance_id
        à la construction), gardé uniquement pour que ComposantExecutable/
        ComposantLayoutExecutable (qui l'appellent en dur avec 4
        arguments) continuent de fonctionner sans modification.

        BUGFIX RÉEL #2 -- FILET DE SÉCURITÉ SUPPLÉMENTAIRE (cf. docstring
        __init__ pour le diagnostic complet, "le dernier link gagne") :
        _sur_instance_deliee() couvre déjà le cas nominal (le serveur
        notifie explicitement la perte de liaison via "unlinked"), mais
        reste best-effort comme tout signal réseau (perte de connexion
        transitoire, message qui se recouperait avec une reconnexion en
        cours...). Si le serveur refuse malgré tout la commande pour
        cause de mauvaise liaison (message contenant "non liée à" --
        cf. srv_gerer_command, refus "instance ... non liée à ..."),
        cette méthode force maintenant un relink et RETENTE la commande
        UNE FOIS avant d'abandonner, plutôt que de renvoyer l'échec tel
        quel à l'appelant -- pour ne plus JAMAIS dépendre uniquement d'un
        signal qui pourrait, en théorie, se perdre. Un vrai problème
        durable (instance introuvable, exécuteur mort) échoue quand même
        au final, mais après cette seconde chance, jamais avant."""
        if self._instance_morte:
            return {"ok": False, "error": "instance introuvable (fermée)"}
        self._lier_si_besoin()
        if self._instance_morte:
            return {"ok": False, "error": "instance introuvable (fermée)"}
        delai_s = timeout if timeout is not None else self._timeout_defaut_s
        resultat = self._envoyer_une_commande(action, params, delai_s)
        erreur = str(resultat.get("error") or "") if not resultat.get("ok") else ""
        if erreur and "introuvable" in erreur and "instance" in erreur.lower():
            self._instance_morte = True
        if erreur and "non liée à" in erreur:
            log.warning(
                f"[relais] _appeler() : refus 'non liée à' pour action={action!r} "
                f"instance_id={self._instance_id!r} -- relink forcé et une retentative."
            )
            self._lien_ok = False  # force _lier_si_besoin() à relancer un vrai link, cf. son corps
            self._lier_si_besoin()
            resultat = self._envoyer_une_commande(action, params, delai_s)
        return resultat


class InstanceExecutableRelaisIsole(InstanceExecutableDirecteCamoufox):
    """PATCH (fallback ServiceAPI générique manquant en profil ISOLÉ --
    cf. NameError: name 'yt_view' is not defined, reproductible à 100%
    dès qu'une cellule utilise le style générique `service.instance()`
    au lieu d'un Composant préfixé, sur un profil isolé). Jumeau EXACT
    d'InstanceExecutableDirecteCamoufox (mêmes ~10 méthodes publiques
    héritées SANS MODIFICATION -- capture/new_tab/switch_tab/mouse_move/
    etc., cf. sa docstring) -- seule _appeler() est réécrite ici pour
    router via _MoteurRelaisPourComposantIsole (canal cross-process déjà
    fonctionnel, cf. sa docstring) au lieu de run_coroutine_threadsafe
    vers une boucle asyncio LOCALE (self._loop, context/gestion/
    etat_navigateur) -- structurellement inutilisable ici puisque
    l'instance visée tourne dans un SOUS-PROCESSUS séparé, jamais dans
    ce process-ci (même raison exactement que _MoteurRelaisPourComposant
    Isole vis-à-vis de _MoteurDirectPourComposant, cf. sa docstring).

    Même principe de composition que _MoteurRelaisPourComposantIsole :
    plutôt que de dupliquer les ~10 méthodes publiques (capture,
    new_tab, switch_tab, tab_accueil, reset_interface,
    est_interface_initialisee, position_aleatoire, mouse_move,
    get_presse_papier...), on hérite de la classe existante et on ne
    remplace que le point d'accès réseau -- ces méthodes ne touchent
    JAMAIS au transport directement, seulement via self._appeler(action,
    params, timeout), donc aucune n'a besoin d'être copiée ni modifiée."""

    def __init__(self, instance_id: str, moteur_relais: "_MoteurRelaisPourComposantIsole",
                 namespace: Optional[dict] = None,
                 _moteurs_relais_courants: Optional[dict] = None):
        # context/gestion/etat_navigateur/arret_demande/loop : jamais
        # utilisés ici (cf. _appeler ci-dessous, entièrement réécrite),
        # transmis à None/absents au constructeur parent -- gardés hors
        # de cette classe pour ne jamais risquer un usage accidentel de
        # run_coroutine_threadsafe local (qui lèverait de toute façon
        # RuntimeError proprement si jamais appelé, cf. self._loop=None).
        super().__init__(instance_id, None, None, None, None, namespace, None)
        # CORRECTIF (routage dynamique -- cf. docstring de
        # `_moteurs_relais_courants` dans _main_async_sautoniax pour le
        # diagnostic complet du bug "timeout 15s alors que command_result
        # arrive en <3s avec ok=True") : moteur_relais reçu ici n'est
        # plus QUE le fallback -- utilisé uniquement si aucun registre
        # dynamique n'est fourni (compat. totale avec tout appelant hors
        # _sautoniax_executer_notebook_distant_sur_instance_isolee, ex.
        # test/appel direct). Quand `_moteurs_relais_courants` est fourni,
        # _appeler() ci-dessous ignore self._moteur_relais et résout la
        # cible à CHAQUE appel via ce registre -- ainsi cet objet, même
        # stocké dans une variable utilisateur du namespace hérité et
        # réutilisé tel quel plusieurs cellules plus tard (ex. `mon_
        # instance = yt_view.instance()`), route TOUJOURS vers le moteur_
        # relais actif de la cellule EN COURS, jamais un moteur périmé
        # déjà _deconnecter_ecoute().
        self._moteur_relais = moteur_relais
        self._moteurs_relais_courants = _moteurs_relais_courants

    def __repr__(self) -> str:
        return f"InstanceExecutableRelaisIsole({self.instance_id!r})"

    def _resoudre_moteur_relais_courant(self) -> "_MoteurRelaisPourComposantIsole":
        """CORRECTIF (routage dynamique) : retourne le moteur_relais à
        utiliser POUR CET APPEL PRÉCIS -- le moteur COURANT du registre
        (instance_id -> moteur_relais le plus récemment créé pour cet
        instance_id, mis à jour à chaque cellule, cf. site de création
        dans _sautoniax_executer_notebook_distant_sur_instance_isolee) si
        un registre a été fourni ET qu'il contient déjà une entrée pour
        self.instance_id, sinon self._moteur_relais (référence figée à la
        construction -- fallback pour compat. avec tout appelant ne
        fournissant pas le registre, ou cas limite où le registre existe
        mais n'a pas encore d'entrée pour cet instance_id précis)."""
        if self._moteurs_relais_courants is not None:
            moteur_courant = self._moteurs_relais_courants.get(self.instance_id)
            if moteur_courant is not None:
                return moteur_courant
        return self._moteur_relais

    def _appeler(self, action: str, params: dict, timeout: Optional[float] = None) -> dict:
        """Remplace InstanceExecutableDirecteCamoufox._appeler (cf. sa
        docstring pour la signature/le contrat de retour, identiques
        ici) -- délègue entièrement à _MoteurRelaisPourComposantIsole.
        _appeler(instance_id, action, params, timeout), déjà fonctionnel
        et déjà utilisé pour router les Composants préfixés vers le
        subprocess isolé (cf. _construire_composants_direct,
        _moteur_direct_override). self.instance_id transmis en premier
        argument même s'il est ignoré côté relais (déjà fixé à sa
        construction, cf. docstring de _MoteurRelaisPourComposantIsole._
        appeler) -- gardé pour respecter sa signature à 4 arguments.

        CORRECTIF (routage dynamique) : le moteur_relais utilisé n'est
        plus self._moteur_relais directement mais le résultat de
        self._resoudre_moteur_relais_courant() -- résolu à CET INSTANT,
        pas à la construction. C'est le coeur du correctif : même si cet
        objet InstanceExecutableRelaisIsole a survécu au-delà de la
        cellule qui l'a créé (stocké dans une variable utilisateur du
        namespace hérité, ex. `mon_instance`), l'appel part vers le
        moteur_relais ACTIF de la cellule en cours d'exécution, jamais un
        moteur périmé dont le listener Qt (_connecter_ecoute) a déjà été
        _deconnecter_ecoute() par la cellule qui l'a créé."""
        moteur_relais_cible = self._resoudre_moteur_relais_courant()
        return moteur_relais_cible._appeler(self.instance_id, action, params, timeout=timeout)


class ServiceAPIExecutableRelaisIsole:
    """Équivalent, pour le mode profil ISOLÉ, de
    ServiceAPIExecutableDirectCamoufox (cf. sa docstring) -- injecté
    sous le nom du ServiceAPI (ex: "yt_view") comme fallback générique
    quand aucun Composant préfixé (yt_view_XXX) ne couvre un candidat
    détecté par analyse statique (cf. site d'appel dans _sautoniax_
    executer_notebook_distant_sur_instance_isolee, même patron EXACT que
    le mode mono-profil). Ne porte que instance(), qui retourne un
    InstanceExecutableRelaisIsole routé vers le SUBPROCESS isolé visé
    (self._instance_id, cf. _MoteurRelaisPourComposantIsole) au lieu de
    l'instance mono-profil en mémoire locale du sAutoniax lui-même."""

    def __init__(self, nom_service: str, instance_id: str,
                 moteur_relais: "_MoteurRelaisPourComposantIsole",
                 namespace: Optional[dict] = None,
                 _moteurs_relais_courants: Optional[dict] = None):
        self.nom_service = nom_service
        self._instance_id = instance_id
        self._moteur_relais = moteur_relais
        self._namespace = namespace
        # CORRECTIF (routage dynamique) : registre transmis tel quel à
        # chaque InstanceExecutableRelaisIsole fabriqué par .instance()
        # ci-dessous (cf. sa docstring/_resoudre_moteur_relais_courant) --
        # ce ServiceAPIExecutableRelaisIsole lui-même peut tout à fait
        # survivre au-delà de sa cellule (variable utilisateur `service =
        # yt_view`), mais peu importe désormais : l'objet Instance qu'il
        # fabrique résout son moteur_relais dynamiquement à l'appel, pas
        # à la fabrication -- donc même un ServiceAPIExecutableRelaisIsole
        # périmé continue de produire des InstanceExecutableRelaisIsole
        # correctement routés.
        self._moteurs_relais_courants = _moteurs_relais_courants

    def __repr__(self) -> str:
        return f"ServiceAPIExecutableRelaisIsole({self.nom_service!r})"

    def instance(self) -> "InstanceExecutableRelaisIsole":
        """instance() -- retourne un InstanceExecutableRelaisIsole
        pointant sur l'instance isolée visée par ce notebook distant
        (cf. docstring de classe : cible unique, l'instance_id fourni à
        _sautoniax_executer_notebook_distant_sur_instance_isolee, quel
        que soit nom_service -- même convention EXACTE que
        ServiceAPIExecutableDirectCamoufox.instance() en mode
        mono-profil).

        CORRECTIF (routage dynamique) : transmet self._moteurs_relais_
        courants (le registre, pas juste self._moteur_relais figé) à
        l'InstanceExecutableRelaisIsole fabriqué -- cf. sa docstring
        pour le mécanisme complet de résolution à l'appel."""
        return InstanceExecutableRelaisIsole(
            self._instance_id, self._moteur_relais, self._namespace,
            _moteurs_relais_courants=self._moteurs_relais_courants,
        )


def _construire_composants_direct(
    context, gestion: "GestionOngletsCamoufox", etat_navigateur: dict,
    arret_demande: Optional["asyncio.Event"], loop: Optional["asyncio.AbstractEventLoop"],
    services_api_lies: Optional[dict] = None, namespace: Optional[dict] = None,
    _contexte_reseau: Optional[dict] = None,
    _moteur_direct_override: Optional["_MoteurDirectPourComposant"] = None,
) -> dict:
    """PATCH (Composants en notebook distant) -- charge les Composants
    dont le ServiceAPI parent apparaît dans `services_api_lies`, avec
    leurs métadonnées lues depuis project.json (cf. CORRECTIF 2
    ci-dessous) et leurs images déjà présentes dans get_service_api_dir()
    (téléchargé/extrait côté sAutoniax -- cf. synchroniser_service_api_
    dir/App/service_api.zip, UN SEUL zip partagé contenant TOUTES les
    images de tous les ServiceAPI du projet, par choix de conception
    assumé ailleurs, cf. sa docstring : "plus simple et plus sûr qu'une
    sélection... UN SEUL dossier service_api.zip de référence est partagé
    par tous"). Retourne {nom_variable_python(composant.nom):
    ComposantExecutable(...)}, prêt à être fusionné dans le namespace
    d'exécution -- même mécanisme de nommage EXACT que le mode local
    (nom_variable_python, cf. TaskConfigScreen._executer_cellule) pour
    qu'un script écrit/testé en local fonctionne SANS AUCUNE modification
    une fois basculé en mode réseau.

    CORRECTIF (retour explicite utilisateur -- "je veux le filtrage
    precis comme en local" : une première version de cette fonction
    chargeait INCONDITIONNELLEMENT tous les Composants du dossier, sans
    aucun rapport avec le Task/les ServiceAPI réellement utilisés,
    contrairement au mode local qui ne construit que les Composants
    importés PAR CE TASK et dont le ServiceAPI parent est réellement lié
    -- cf. Project.composants_importes_task, seule référence de
    comportement). `services_api_lies` reproduit ici EXACTEMENT le même
    filtre : {nom_service_api: instance_id/id_executant} (même forme que
    Task.services_api_importes, cf. sa docstring), transmis depuis
    MoteurExecutionCelluleReseau.lancer via le protocole réseau (cf.
    ClientServeurT.executer_notebook_distant) -- SEULES les clés de ce
    dict comptent ici (un composant dont service_api_nom n'y figure pas
    est ignoré), la valeur elle-même (instance_id/id_executant) n'a pas
    de sens dans ce contexte réseau où il n'y a jamais qu'UNE seule
    instance possible (page_courante) -- cf. paragraphe instance_id
    ci-dessous. None (comportement par défaut si l'appelant ne filtre
    pas) = aucun composant chargé (PAS "tous", contrairement à l'ancien
    comportement) : un filtre absent ne doit jamais recharger table rase
    tout le projet, cohérent avec l'esprit du correctif (précision, pas
    substitution d'un excès par un autre).

    instance_id : toujours "notebook_distant" (chaîne fixe arbitraire,
    jamais transmise nulle part -- _MoteurDirectPourComposant
    l'ignore, cf. sa docstring) puisqu'il n'y a jamais qu'UNE seule
    instance possible ici (page_courante), même raisonnement que
    ServiceAPIExecutableDirectCamoufox/InstanceExecutableDirecteCamoufox
    pour lesquelles instance_id n'est déjà qu'une étiquette d'affichage.

    _contexte_reseau (AJOUT, demande explicite utilisateur : "je veux que
    le terminal affiche aussi les images") : {"client_t": ClientServeurT,
    "session_id": str, "id_pilote": str}, transmis TEL QUEL à chaque
    ComposantExecutable/ComposantLayoutExecutable construit ici -- permet
    à Image.view() (renvoyée par .screenshot()) de savoir vers quel
    pilote envoyer l'image. None (défaut) si l'appelant n'est pas en
    mesure de le fournir (ex. session/pilote pas encore identifiés) --
    Image.view() lève alors RuntimeError plutôt que d'échouer
    silencieusement, cf. sa docstring.

    Ne lève jamais : un projet sans aucun ServiceAPI/Composant valide
    (project.json absent, JSON corrompu, pas encore téléchargé) retourne
    simplement {} -- le code utilisateur obtient alors un NameError normal
    et explicite au premier usage, plutôt qu'un crash de l'infrastructure
    elle-même.

    CORRECTIF 2 (BUG RÉEL, cf. investigation .visible()/AttributeError
    persistant même après le CORRECTIF ci-dessus -- retour explicite
    utilisateur, confirmé par extraction manuelle de service_api.rar) :
    cette fonction cherchait auparavant les métadonnées Composant (nom,
    seuil_confiance, zone_clic_rect...) sous forme de fichiers *.json
    individuels dans service_api.zip (dossier.glob("*/composants/*.json"))
    -- structure qui N'A JAMAIS EXISTÉ. service_api.zip ne contient QUE
    les images (.png) sous components/<NomServiceAPI>/<fichier>.png (cf.
    synchroniser_service_api_dir/get_components_dir, structure réelle
    confirmée). Les métadonnées Composant vivent EXCLUSIVEMENT dans
    project.json (cf. Project.composants, "Racine du modèle : tout ce qui
    est sauvegardé dans project.json") -- jamais dupliquées en fichiers
    séparés, par choix de conception assumé (un seul point de vérité,
    cf. retour utilisateur "je coris uqe projetjson doit donc faire
    partir des ficher a stocker sur le cloud"). Résultat : le glob ne
    trouvait STRUCTURELLEMENT jamais rien (0 fichier, à chaque fois, quel
    que soit le contenu réel du projet), donc AUCUN Composant n'était
    JAMAIS injecté en notebook distant, et le fallback générique
    ServiceAPIExecutableDirectCamoufox (sans .visible()) restait
    systématiquement en place -- bug 100% reproductible, pas un cas
    limite.

    Corrigé en lisant project.json (téléchargé côté sAutoniax au
    démarrage par _sautoniax_assurer_donnees_de_base, même patron que
    mouseData.sqlite3/service_api.zip, cf. get_project_json_path) : les
    CHEMINS D'IMAGES (Composant.variantes, ex. "components/Word/Word-
    BoutonOK.png") restent résolus relativement à get_service_api_dir()
    (là où service_api.zip a été extrait) -- seules les MÉTADONNÉES
    viennent de project.json, les images continuent de venir du zip,
    aucun changement côté transport des images.

    CORRECTIF 3 (BUG RÉEL, demande explicite utilisateur -- "tu dois
    aussi te rassurer que lexecution de tout ce qui concerne les
    composantlayout du cote des sautoniax fonctionne correctement") :
    cette fonction ne chargeait QUE data_project.get("composants", ...)
    (les ComposantSingle) -- data_project.get("composants_layout", ...)
    (les ComposantLayout, cf. Project.composants_layout/to_dict, MÊME
    clé top-level que "composants" dans project.json, juste au pluriel
    différent) n'était JAMAIS lu ici, alors qu'il L'EST bien en mode
    local (cf. TaskConfigScreen._executer_cellule, boucle "groupes_layout
    = self.project.composants_layout_importes_task(task)" juste après la
    boucle Composant équivalente). Résultat : un script Task utilisant un
    ComposantLayout (ex: videoTemplateItems.choose()) fonctionnait en
    local mais levait un NameError/AttributeError une fois basculé en
    notebook distant (sAutoniax) -- exactement le même bug de fond que le
    CORRECTIF 2 ci-dessus, mais pour cL au lieu de cS, jamais couvert par
    ce correctif-là puisqu'il ne parlait que de Composant/ComposantExecutable.

    Corrigé symétriquement : même filtre services_api_lies (un
    ComposantLayout dont service_api_nom n'y figure pas est ignoré,
    identique à Composant ci-dessus), même moteur_direct partagé (un
    seul _MoteurDirectPourComposant suffit pour les deux types -- il
    n'interprète jamais instance_id, cf. son paragraphe plus haut),
    même nommage nom_variable_python(composant_layout.nom). AUCUNE
    image/dossier_service_api à résoudre pour cL (ComposantLayout n'a
    pas de champ variantes -- sa détection repose entièrement sur
    code_scindement/code_filtre, du code, jamais un fichier image, cf.
    docstring ComposantLayout) : ComposantLayoutExecutable() ne prend
    donc PAS dossier_racine_images, contrairement à ComposantExecutable
    ci-dessus -- même signature EXACTE que son site de construction en
    mode local (TaskConfigScreen._executer_cellule)."""
    composants: dict = {}
    # LOGS CIBLÉS (diagnostic .visible()/AttributeError) -- chaque return
    # anticipé ci-dessous est un point où le fournisseur générique
    # ServiceAPIExecutableDirectCamoufox (sans .visible()) reste en place
    # FAUTE d'écrasement, SANS AUCUNE erreur visible avant le AttributeError
    # final -- un log à chacun permet de savoir en un coup d'oeil LEQUEL
    # de ces points a été atteint pour une session donnée.
    if not services_api_lies:
        log.warning(
            "[sAutoniax] _construire_composants_direct : services_api_lies vide/absent "
            f"({services_api_lies!r}) -- AUCUN Composant chargé, retour {{}}."
        )
        return composants
    try:
        chemin_project = get_project_json_path()
        if not chemin_project.exists():
            log.warning(
                f"[sAutoniax] _construire_composants_direct : project.json introuvable ({chemin_project}) "
                f"-- pas encore téléchargé/poussé (cf. bouton 'Mettre à jour project.json') -- retour {{}}."
            )
            return composants
        try:
            data_project = json.loads(chemin_project.read_text(encoding="utf-8"))
        except (OSError, ValueError) as exc:
            log.warning(f"[sAutoniax] _construire_composants_direct : project.json illisible ({chemin_project}) : {exc!r} -- retour {{}}.")
            return composants
        tous_composants = [Composant.from_dict(c) for c in data_project.get("composants", [])]
        composants_lies = [c for c in tous_composants if c.service_api_nom in services_api_lies]
        log.info(
            f"[sAutoniax] _construire_composants_direct : services_api_lies={services_api_lies!r}, "
            f"{len(tous_composants)} Composant(s) au total dans project.json, "
            f"{len(composants_lies)} après filtrage par services_api_lies."
        )
        # CORRECTIF 3 -- même lecture pour les ComposantLayout (cf.
        # docstring ci-dessus), clé top-level "composants_layout"
        # symétrique de "composants" (cf. Project.to_dict).
        tous_composants_layout = [ComposantLayout.from_dict(c) for c in data_project.get("composants_layout", [])]
        composants_layout_lies = [cl for cl in tous_composants_layout if cl.service_api_nom in services_api_lies]
        log.info(
            f"[sAutoniax] _construire_composants_direct : "
            f"{len(tous_composants_layout)} ComposantLayout(s) au total dans project.json, "
            f"{len(composants_layout_lies)} après filtrage par services_api_lies."
        )
        dossier_service_api = get_service_api_dir()
        # PATCH (Run sur profil isolé, cf. SPEC_notebook_distant_profils_
        # isoles.md section 7) : si l'appelant fournit déjà un moteur
        # (_MoteurRelaisPourComposantIsole, routant vers un subprocess
        # isolé via client_pilote_instances), on le réutilise TEL QUEL au
        # lieu de construire un _MoteurDirectPourComposant local -- ce
        # dernier suppose context/gestion/etat_navigateur du process
        # PRINCIPAL, sans rapport avec l'instance isolée visée ici.
        # Comportement RIGOUREUSEMENT INCHANGÉ pour tout appelant existant
        # (mode mono-profil legacy/Initialiser), qui ne fournit jamais ce
        # paramètre.
        moteur_direct = _moteur_direct_override if _moteur_direct_override is not None else _MoteurDirectPourComposant(
            "notebook_distant", context, gestion, etat_navigateur, arret_demande, loop,
        )
        for composant in composants_lies:
            if not composant.variantes:
                log.info(
                    f"[sAutoniax] _construire_composants_direct : Composant {composant.nom!r} ignoré -- "
                    "aucune variante (image) définie."
                )
                continue
            image_principale = dossier_service_api / composant.variantes[0]
            if not image_principale.exists():
                log.warning(
                    f"[sAutoniax] _construire_composants_direct : Composant {composant.nom!r} -- "
                    f"image principale introuvable ({image_principale}), chargé quand même (la "
                    "détection échouera proprement au premier usage, cf. ComposantExecutable._detecter)."
                )
            composants[nom_variable_python(composant.nom)] = ComposantExecutable(
                composant, "notebook_distant", moteur_direct, namespace,
                dossier_racine_images=dossier_service_api,
                _contexte_reseau=_contexte_reseau,
            )
            # DÉSACTIVÉ (demande explicite utilisateur : "logs les plus
            # bruyants" -- cf. analyse logs.txt, 462 occurrences) --
            # passé en debug : redondant avec le log récapitulatif
            # "{n} Composant(s)/ComposantLayout(s) au total" juste après
            # cette boucle, réactivable via la config du logger.
            log.debug(
                f"[sAutoniax] _construire_composants_direct : Composant {composant.nom!r} "
                f"chargé -> variable {nom_variable_python(composant.nom)!r} (écrasera le fallback générique)."
            )
        # CORRECTIF 3 -- même boucle d'injection pour les ComposantLayout,
        # dans le MÊME dict `composants` retourné (fusionné dans le même
        # namespace par l'appelant, cf. paragraphe instance_id plus haut :
        # un cS et un cL du même ServiceAPI ne peuvent déjà pas porter le
        # même nom_variable_python, contrainte imposée côté UI de
        # nommage -- aucun risque d'écrasement croisé ici, même
        # raisonnement qu'en mode local).
        for composant_layout in composants_layout_lies:
            composants[nom_variable_python(composant_layout.nom)] = ComposantLayoutExecutable(
                composant_layout, moteur_direct, "notebook_distant", namespace=namespace,
                _contexte_reseau=_contexte_reseau,
            )
            # DÉSACTIVÉ (demande explicite utilisateur : "logs les plus
            # bruyants" -- cf. analyse logs.txt, 396 occurrences) --
            # passé en debug, même raison que le log Composant ci-dessus
            # (redondant avec le récapitulatif final).
            log.debug(
                f"[sAutoniax] _construire_composants_direct : ComposantLayout {composant_layout.nom!r} "
                f"chargé -> variable {nom_variable_python(composant_layout.nom)!r} (écrasera le fallback générique)."
            )
    except Exception as exc:
        log.warning(f"[sAutoniax] échec du chargement des Composants pour le notebook distant : {exc!r}")
        return {}
    log.info(
        f"[sAutoniax] _construire_composants_direct : {len(composants)} Composant(s)/ComposantLayout(s) "
        "au total prêt(s) à écraser le namespace."
    )
    return composants


class ServiceAPIExecutableDirectCamoufox:
    """Équivalent DIRECT de ServiceAPIExecutable (cf. sa docstring et le
    bloc de commentaire au-dessus d'InstanceExecutableDirecteCamoufox) --
    injecté dans le namespace du notebook distant sous le nom du
    ServiceAPI (ex: "claude"), pour CHAQUE entrée de
    task.services_api_importes connue au moment de l'exécution (cf.
    _sautoniax_executer_notebook_distant). Ne porte qu'une méthode,
    instance(), qui retourne un InstanceExecutableDirecteCamoufox
    pointant TOUJOURS sur l'instance mono-profil actuellement chargée
    par CE sAutoniax -- il n'y a jamais qu'UNE seule instance possible
    ici (contrairement au mode Task normal, où plusieurs ServiceAPI
    peuvent être liés à des instances différentes), donc l'instance_id
    d'origine (task.services_api_importes[nom_service], ex.
    "130556975250640" -- en réalité un id_executant réseau, PAS un
    instance_id local, cf. investigation) n'est ici qu'une étiquette
    d'affichage, jamais utilisée pour router quoi que ce soit : il n'y a
    qu'une seule cible possible, page_courante lui-même.

    CORRECTIF (cf. docstring d'InstanceExecutableDirecteCamoufox) :
    reçoit désormais `loop` (la boucle asyncio principale du sAutoniax)
    et la transmet telle quelle à chaque InstanceExecutableDirecteCamoufox
    construite par instance() -- SYNCHRONE elle-même (plus de coroutine
    à `await` ici non plus, cf. même raison exactement)."""

    def __init__(self, nom_service: str, context, gestion: "GestionOngletsCamoufox",
                 etat_navigateur: dict, arret_demande: Optional["asyncio.Event"],
                 namespace: Optional[dict] = None, loop: Optional["asyncio.AbstractEventLoop"] = None):
        self.nom_service = nom_service
        self._context = context
        self._gestion = gestion
        self._etat_navigateur = etat_navigateur
        self._arret_demande = arret_demande
        self._namespace = namespace
        self._loop = loop

    def __repr__(self) -> str:
        return f"ServiceAPIExecutableDirectCamoufox({self.nom_service!r})"

    def instance(self) -> "InstanceExecutableDirecteCamoufox":
        """instance() -- retourne un InstanceExecutableDirecteCamoufox
        pointant sur l'instance mono-profil actuellement chargée par ce
        sAutoniax (cf. docstring de classe : cible unique, toujours la
        même quel que soit nom_service)."""
        return InstanceExecutableDirecteCamoufox(
            self.nom_service, self._context, self._gestion, self._etat_navigateur,
            self._arret_demande, self._namespace, self._loop,
        )


# Mêmes ensembles ACTIONS_4_2/ACTIONS_ETENDUES/ACTIONS_SUPPORTEES (définis
# juste plus bas) réutilisables tels quels pour filtrer les commandes
# destinées à ce client -- _executer_commande_camoufox dispatche
# exactement les mêmes noms d'action que _executer_commande (client
# nodriver), volontairement, pour rester interchangeable côté serveur.
#
# PATCH (retour utilisateur explicite : "vas-y implémente tout" -- suite à
# "est-ce que le type de profils Camoufox a été complètement implémenté ...
# est-ce qu'il supporte tous les types de requête demandés par le
# serveur ?") -- cette fonction, écrite en même temps que la version
# nodriver (_executer_commande) et pourtant JAMAIS appelée nulle part dans
# ce fichier, est maintenant réellement branchée dans
# _session_camoufox_minimale (cf. sa branche catch-all plus bas, qui
# renvoyait systématiquement ok=False "pilotage à distance non disponible
# pour les profils Camoufox" pour toute action autre que shutdown/
# get_fingerprint/get_fingerprint_reel). Le pilotage à distance complet
# (click, scroll, saisie de texte, drag, onglets, etc.) fonctionne
# désormais pour les instances Camoufox exactement comme pour les
# instances Chrome/nodriver, avec la même liste d'actions
# (ACTIONS_SUPPORTEES, définie juste plus bas) et le même format de
# réponse ({"ok": bool, "result"/"error": ...}).


# Noms d'action tels qu'utilisés sur le fil WebSocket -- alignés
# littéralement sur le tableau de la section 4.2 et sur l'exemple de flux
# de la section 8 ({ action: "click", x: 450, y: 320 }), plutôt que sur la
# convention snake_case déjà en place pour set_fps/set_streaming (celle-ci
# reste inchangée, propre au streaming, pas au cahier des charges 4.2).
ACTIONS_4_2 = {"moveCursor", "mousemove", "click", "scroll", "paste", "copy", "listTabs", "switchTab"}

# Actions ajoutées par nécessité, HORS section 4.2 du cahier des charges --
# type_text n'a pas d'équivalent parmi les 8 actions officielles (qui
# n'ont que paste() pour le texte), mais TestComposantScreen/
# SequenceurAction avait déjà une action "saisir" côté AutoniaX sans
# équivalent CDP. capture_propre : capture CDP sans le curseur virtuel
# (4.3), dédiée à la détection OpenCV pendant un test (cf.
# action_capture_propre) -- jamais utilisée par le flux de streaming
# normal, qui garde le curseur visible (comportement inchangé). Gardé
# séparé de ACTIONS_4_2 pour ne pas fausser la traçabilité avec le cahier
# des charges -- ACTIONS_SUPPORTEES (l'union des deux) est ce qu'utilisent
# réellement le filtrage et le dispatch ci-dessous.
ACTIONS_ETENDUES = {"type_text", "capture_propre", "mouse_drag", "drag", "drag_page", "clear", "get_clipboard", "shutdown", "newTab", "navigate", "resetInterface", "clearBrowsingData", "remplacerRessources", "isInterfaceInitialisee", "getHomeTabId", "set_download_dir", "getScreenInfo", "press_key", "scroll_simple", "goBack", "goForward", "bringToFront", "dom_paste", "dom_clear", "get_last_assistant_message", "get_html", "find_elements", "evaluer_js"}
# PATCH (demande explicite utilisateur -- généralisation de Composant.id_dom,
# "composant.id_dom.paste(), et clear()" -> composant.dom_paste()/
# dom_clear(), cf. action_dom_paste/action_dom_clear juste au-dessus) :
# dom_paste/dom_clear sont câblées sur les DEUX moteurs -- CDP
# (_executer_commande, cette fonction-ci) ET Camoufox
# (_executer_commande_camoufox, cf. action_camoufox_dom_paste/
# action_camoufox_dom_clear). BUG CORRIGÉ (traceback utilisateur : "action
# inconnue : dom_paste" sur une instance Camoufox) : une première tentative
# de patch avait laissé ces deux actions dans ACTIONS_ETENDUES (donc
# acceptées par le garde-fou serveur srv_ACTIONS_SUPPORTEES) SANS jamais
# écrire la branche elif ni la fonction action_camoufox_* correspondantes
# -- toute instance Camoufox recevant l'une de ces deux actions tombait
# alors systématiquement dans le catch-all "else" de _executer_commande_
# camoufox, {"ok": False, "error": "action inconnue : dom_paste"}. Portage
# réel effectué cette fois (cf. action_camoufox_dom_paste/dom_clear).

ACTIONS_SUPPORTEES = ACTIONS_4_2 | ACTIONS_ETENDUES


async def _annuler_et_consommer(tache: "asyncio.Task", contexte: str = "") -> None:
    """PATCH (nettoyage des logs -- problème #5 : "Future exception was
    never retrieved" loguée en boucle par asyncio lui-même, parfois 5
    fois de suite, lors d'un timeout Playwright/CDP) -- source identifiée
    dans _consommer_file_commandes/_consommer_file_commandes_camoufox
    (mode nodriver ET Camoufox) : tache_commande.cancel() y était appelé
    SANS jamais rien attendre/consulter ensuite sur cette Task. Si la
    coroutine sous-jacente (_executer_commande/_executer_commande_
    camoufox) se termine avec une exception AUTRE que CancelledError
    juste au moment de son annulation (course entre le .cancel() externe
    et une exception CDP/Playwright interne déjà en train de se
    propager), personne ne consulte jamais cette exception -- c'est
    précisément ce que asyncio journalise lui-même (indépendamment de
    logging.getLogger) au prochain passage du garbage collector, une
    fois par Task concernée (d'où les répétitions en boucle : plusieurs
    commandes timeoutent à la suite pendant un même incident, ex. perte
    réseau).

    Fix : après .cancel(), on ATTEND explicitement la fin réelle de la
    Task (elle est déjà annulée, donc quasi immédiate) et on avale
    CancelledError (annulation normale, résultat attendu) ainsi que
    toute AUTRE exception résiduelle (déjà journalisée par le log.error/
    log.warning juste avant l'appel à cette fonction côté appelant --
    inutile de la reloguer ici, seul le fait de la CONSULTER suffit à
    empêcher le message asyncio)."""
    tache.cancel()
    try:
        await tache
    except asyncio.CancelledError:
        pass
    except Exception as exc_residuelle:
        log.debug(f"_annuler_et_consommer({contexte}) : exception résiduelle consommée après annulation -- {_resume_pour_log(exc_residuelle)}")


async def _executer_commande(browser, etat_navigateur: dict, data: dict, arret_demande: "asyncio.Event | None" = None) -> dict:
    """Dispatcher central des actions 4.2 + extensions (ACTIONS_ETENDUES,
    ex: type_text) : reçoit le message {"type": "command", "action": ...,
    ...} déjà filtré (action in ACTIONS_SUPPORTEES), appelle la fonction
    action_* correspondante, et construit la réponse command_result
    uniforme {"ok": bool, "result": ..., "error": ...}.

    N'importe quelle action peut échouer côté CDP (élément absent, page
    pas encore prête, onglet fermé entre-temps...) -- ces erreurs sont
    systématiquement transformées en réponse {"ok": False, "error": ...}
    plutôt que laissées remonter, pour ne jamais faire planter la boucle
    de réception (cf. commentaire en tête de section Actions). Seule une
    déconnexion réelle (ConnectionError/ConnectionClosed) remonte telle
    quelle, pour être traitée comme dans capturer_frame_reelle -- une
    action qui échoue parce que le navigateur est fermé n'est pas la même
    chose qu'une action qui échoue parce que la coordonnée était mauvaise.

    etat_navigateur["page"] est lu à chaque appel (jamais mis en cache
    localement) pour toujours cibler l'onglet actif du moment (cf. 4.6) ;
    switchTab est la seule action qui le modifie, ci-dessous."""
    action = data.get("action")
    resultat = None
    # PATCH (robustesse capture de copie) : champs SUPPLÉMENTAIRES
    # fusionnés dans la réponse ok=True (cf. le `return` en fin de
    # fonction). Dict vide pour toutes les actions sauf
    # click(copier_presse_papier=True) -- la réponse reste donc
    # RIGOUREUSEMENT identique à avant ce patch pour tout le reste, et
    # `result` continue de porter le texte brut attendu par les
    # appelants existants (jamais un objet composite, qui aurait cassé
    # get_clipboard/copy/new_tab).
    extras_reponse: dict = {}
    log.info(f"_executer_commande() : action={action!r} requete_id={data.get('requete_id')!r} params={ {k: v for k, v in data.items() if k not in ('type', 'action', 'requete_id', 'instance_id')} }")
    try:
        page = etat_navigateur["page"]
        if action == "moveCursor":
            await action_move_cursor(page, int(data["x"]), int(data["y"]))
        elif action == "mousemove":
            _instantane_extrait = bool(data.get("instantane", False))
            await action_mousemove(page, int(data["x"]), int(data["y"]), etat_navigateur=etat_navigateur,
                                    speed_percent=float(data.get("speedPercent", 0)),
                                    instantane=_instantane_extrait)
        elif action == "click":
            # PATCH (robustesse capture de copie) -- cf. commentaire jumeau
            # dans _executer_commande_camoufox : référence de fraîcheur
            # prise juste AVANT le clic.
            horodatage_avant_clic = time.monotonic()
            _instantane_extrait = bool(data.get("instantane", False))
            await action_click(
                page, int(data["x"]), int(data["y"]),
                bouton=data.get("bouton", "gauche"),
                duree_appui_ms=int(data.get("duree_appui_ms", 60)),
                nb_clics=int(data.get("nb_clics", 1)),
                etat_navigateur=etat_navigateur,
                speed_percent=float(data.get("speedPercent", 0)),
                instantane=_instantane_extrait,
            )
            if data.get("copier_presse_papier"):
                # Même logique que côté Camoufox (cf. commentaire jumeau
                # dans _executer_commande_camoufox) : les trois voies de
                # copie (clipboard.writeText, clipboard.write, événement
                # DOM "copy") sont déjà interceptées sur cet onglet (cf.
                # _installer_interception_presse_papier, posé sur CHAQUE
                # onglet -- premier onglet + chaque newTab/switchTab) et
                # redirigent vers etat_navigateur["presse_papier_virtuel"]
                # via le binding CDP __autoniax_copie__, jamais le
                # presse-papier Windows.
                #
                # PATCH (robustesse capture de copie) : polling ancré sur
                # la fraîcheur à la place de l'ancien sleep(0.1) fixe --
                # implémentation STRICTEMENT symétrique de celle du moteur
                # Camoufox, fonction partagée
                # (_attendre_copie_presse_papier_fraiche) pour qu'elles ne
                # puissent pas diverger.
                id_dom_cible = data.get("id_dom_presse_papier") or ""
                detection = await _attendre_copie_presse_papier_fraiche(
                    etat_navigateur, id_dom_cible, horodatage_avant_clic,
                    delai_max_s=float(data.get(
                        "delai_copie_presse_papier_s", DELAI_DETECTION_COPIE_PRESSE_PAPIER_S,
                    )),
                )
                resultat = detection["texte"]
                extras_reponse["presse_papier_frais"] = bool(detection["frais"])
                extras_reponse["presse_papier_origine"] = detection["origine"]
                if detection["message"]:
                    extras_reponse["presse_papier_message"] = detection["message"]
        elif action == "mouse_drag":
            await action_mouse_drag(
                page, int(data["x1"]), int(data["y1"]), int(data["x2"]), int(data["y2"]),
                bouton=data.get("bouton", "gauche"),
                etat_navigateur=etat_navigateur,
                speed_percent=float(data.get("speedPercent", 0)),
                instantane=bool(data.get("instantane", False)),
            )
        elif action == "scroll":
            # targetDeltaX/Y (nouveau, scroll humanisé) prioritaire ; repli
            # sur l'ancien nommage deltaX/deltaY si un appelant plus ancien
            # (ou externe) envoie encore ce format -- cf. docstring
            # action_scroll pour le sens exact de la quantité transmise.
            await action_scroll(
                page, int(data["x"]), int(data["y"]),
                delta_x=float(data.get("targetDeltaX", data.get("deltaX", 0.0))),
                delta_y=float(data.get("targetDeltaY", data.get("deltaY", 0.0))),
                frequence_crans_par_sec=float(data.get("frequenceCransParSec", 5.0)),
                speed_percent=float(data.get("speedPercent", 0.0)),
                instantane=bool(data.get("instantane", False)),
            )
        elif action == "scroll_simple":
            # PATCH (contrôle à distance sur Chrome standard -- retour
            # utilisateur : "scroll [...] sont geré pour chrome, je ne
            # pense pas") -- cf. docstring action_scroll_simple : miroir
            # CDP exact de action_camoufox_scroll_simple, seule action
            # réellement envoyée par la molette pendant le contrôle à
            # distance (PanneauRenduInstance._sur_debounce_scroll),
            # manquante ici jusqu'à ce correctif.
            await action_scroll_simple(
                page, int(data["x"]), int(data["y"]),
                str(data.get("sens", "bas")),
                amplitude=float(data.get("amplitude", WHEEL_DELTA)),
            )
        elif action == "paste":
            # texte EXPLICITE fourni par l'appelant (ComposantExecutable.
            # paste(texte=...)) a priorité s'il est présent dans le
            # message ; sinon fallback sur le presse-papier VIRTUEL de
            # cette instance (jamais le presse-papier Windows, cf.
            # docstring action_paste) -- rempli par un "copy" précédent
            # dans CETTE MÊME instance.
            log.info(f"[DIAG paste] _executer_commande() : 'texte' in data={'texte' in data!r} -- data reçu complet={data!r}")
            if "texte" in data:
                texte_a_coller = str(data["texte"])
            else:
                texte_a_coller = str(etat_navigateur.get("presse_papier_virtuel", ""))
            log.info(f"[DIAG paste] _executer_commande() : texte_a_coller retenu={texte_a_coller!r}")
            await action_paste(page, int(data["x"]), int(data["y"]), texte_a_coller)
        elif action == "clear":
            # Hors 4.2 (cf. ACTIONS_ETENDUES) -- sélectionne tout puis
            # efface (Ctrl+A + Delete), cf. docstring action_clear. Comme
            # paste, un seul aller-retour réseau, aucune boucle.
            await action_clear(page, int(data["x"]), int(data["y"]))
        elif action == "dom_paste":
            # Hors 4.2 (cf. ACTIONS_ETENDUES) -- PATCH (généralisation de
            # Composant.id_dom, cf. commentaire de section devant
            # action_dom_paste) : AUCUNE coordonnée, contrairement à
            # "paste" ci-dessus -- l'élément est retrouvé directement dans
            # le DOM via querySelector(id_dom), transmis ici sous
            # "selecteur". Un sélecteur qui ne matche rien, ou un élément
            # non éditable, est un échec DOM NORMAL (pas une exception) --
            # remonté tel quel en {"ok": False, "error": ...} plutôt que
            # de tomber dans reponse_ok = {"ok": True, ...} en bas de
            # cette fonction.
            resultat_dom = await action_dom_paste(page, str(data.get("selecteur", "")), str(data.get("texte", "")))
            if not resultat_dom.get("trouve"):
                return {"ok": False, "error": resultat_dom.get("erreur") or "élément introuvable pour dom_paste"}
            if resultat_dom.get("erreur"):
                return {"ok": False, "error": resultat_dom["erreur"]}
        elif action == "dom_clear":
            # Même principe que dom_paste juste au-dessus, sans texte à
            # transmettre.
            resultat_dom = await action_dom_clear(page, str(data.get("selecteur", "")))
            if not resultat_dom.get("trouve"):
                return {"ok": False, "error": resultat_dom.get("erreur") or "élément introuvable pour dom_clear"}
            if resultat_dom.get("erreur"):
                return {"ok": False, "error": resultat_dom["erreur"]}
        elif action == "type_text":
            # Hors 4.2 (cf. ACTIONS_ETENDUES) -- une seule commande,
            # toute la boucle de saisie + délais gérée dans
            # action_type_text elle-même, un seul command_result renvoyé
            # une fois le texte entier tapé.
            await action_type_text(
                page, int(data["x"]), int(data["y"]), str(data.get("texte", "")),
                delai_min_ms=int(data.get("delai_min_ms", 60)),
                delai_max_ms=int(data.get("delai_max_ms", 180)),
            )
        elif action == "press_key":
            # PATCH (contrôle à distance sur Chrome standard -- retour
            # utilisateur : "raccourci clavier sont geré pour chrome, je
            # ne pense pas") -- cf. docstring action_press_key/
            # _TOUCHES_CDP_PAR_NOM : miroir CDP exact de
            # action_camoufox_press_key (Entrée/Backspace/Ctrl+A depuis
            # _sur_touche_controle_distance côté client), manquant ici
            # jusqu'à ce correctif -- cette action était rejetée en
            # silence ("Action non supportée") pour tout profil
            # Chrome/Vivaldi.
            _ts_avant = etat_navigateur.get("presse_papier_virtuel_ts")
            await action_press_key(page, int(data["x"]), int(data["y"]), str(data.get("touche", "")))
            if str(data.get("touche", "")) == "Control+c":
                resultat = await _attendre_copie_fraiche(etat_navigateur, _ts_avant)
        elif action == "copy":
            # Stocke dans le presse-papier VIRTUEL de cette instance
            # (etat_navigateur, jamais le presse-papier Windows, cf.
            # docstring action_copy) -- écrase toute valeur précédente,
            # comme un vrai presse-papier.
            resultat = await action_copy(page)
            # PATCH (robustesse capture de copie) : passe par le point
            # d'écriture unique pour que cette copie soit horodatée comme
            # les autres -- sans quoi un copy() explicite suivi d'un
            # click(copier_presse_papier=True) laisserait le global à un
            # horodatage périmé et fausserait le test de fraîcheur.
            _memoriser_copie_presse_papier(etat_navigateur, resultat)
        elif action == "get_clipboard":
            # Hors 4.2 (cf. ACTIONS_ETENDUES) -- lit le presse-papier
            # VIRTUEL de cette instance SANS déclencher de copie au
            # préalable (cf. docstring action_get_clipboard), contrairement
            # à "copy". Synchrone (pas de await) -- simple lecture mémoire.
            resultat = action_get_clipboard(etat_navigateur)
        elif action == "get_last_assistant_message":
            # AJOUT (cf. docstring InstanceExecutable.get_derniere_reponse_
            # assistant) -- même principe que dom_paste/dom_clear côté CDP :
            # AUCUNE coordonnée, sortie anticipée en {"ok": False, "error":
            # ...} si aucun élément ne correspond au sélecteur.
            resultat_msg = await action_derniere_reponse_assistant(page, str(data.get("selecteur", "")))
            if not resultat_msg.get("trouve"):
                return {"ok": False, "error": resultat_msg.get("erreur") or "élément introuvable pour get_last_assistant_message"}
            resultat = resultat_msg.get("texte", "")
        elif action == "get_html":
            # PATCH get_html -- HTML du DOM vivant de l'onglet actif.
            resultat_html = await action_get_html(page, str(data.get("selecteur", "")), str(data.get("cadre") or ""))
            if not resultat_html.get("trouve"):
                return {"ok": False, "error": resultat_html.get("erreur") or "lecture HTML impossible"}
            resultat = resultat_html.get("html", "")
        elif action == "find_elements":
            # PATCH éléments DOM : liste / localisation par sélecteur CSS.
            resultat_el = await action_find_elements(page, {
                "selecteur": str(data.get("selecteur", "")),
                "cadre": str(data.get("cadre") or ""),
                "limite": int(data.get("limite", 100)),
                "visibles": bool(data.get("visibles", True)),
                "index": data.get("index"),
                "scroll": bool(data.get("scroll", False)),
            })
            if not resultat_el.get("ok"):
                return {"ok": False, "error": resultat_el.get("erreur") or "find_elements impossible"}
            resultat = {"total": resultat_el.get("total", 0), "elements": resultat_el.get("elements", [])}
        elif action == "evaluer_js":
            # AJOUT (cadre/evaluer_js) -- exécute du JavaScript dans la page ou dans l'iframe `cadre`.
            resultat_js = await action_evaluer_js(page, str(data.get("code", "")), str(data.get("cadre") or ""))
            if not resultat_js.get("ok"):
                return {"ok": False, "error": resultat_js.get("erreur") or "evaluer_js impossible"}
            resultat = resultat_js.get("valeur")
        elif action == "drag":
            # Hors 4.2 (cf. ACTIONS_ETENDUES) -- dépose un fichier local sur
            # l'input file repéré à (x, y), cf. docstring action_drag.
            # "trouve"=False (input introuvable) est traduit en command_result
            # ok=False ici -- ce n'est pas une exception CDP mais un échec
            # métier tout aussi bloquant pour l'appelant (cf. docstring).
            resultat_drag = await action_drag(page, int(data["x"]), int(data["y"]), str(data.get("chemin_fichier", "")))
            if not resultat_drag["trouve"]:
                return {"ok": False, "error": resultat_drag["erreur"]}
        elif action == "drag_page":
            # AJOUT (demande explicite utilisateur : "je veux que drag soit
            # plutôt lié à la page web actuelle et non à un composant") --
            # variante de "drag" ci-dessus sans point (x, y) : recherche
            # l'input file sur TOUTE la page, cf. docstring action_drag_page.
            # Même traitement d'échec que "drag".
            resultat_drag = await action_drag_page(page, str(data.get("chemin_fichier", "")))
            if not resultat_drag["trouve"]:
                return {"ok": False, "error": resultat_drag["erreur"]}
        elif action == "capture_propre":
            # Hors 4.2 (cf. ACTIONS_ETENDUES) -- capture CDP sans le
            # curseur virtuel, dédiée à la détection OpenCV (cf. docstring
            # action_capture_propre). N'utilise PAS etat_navigateur["page"]
            # dans une variable locale distincte : même lecture que les
            # autres actions, cible toujours l'onglet actif du moment.
            #
            # Cf. action_new_tab pour le bug Vivaldi connu (onglet créé en
            # arrière-plan = canal Runtime.* mort) qui peut faire échouer
            # cette action après un newTab précédent.
            resultat = await action_capture_propre(page)
        elif action == "getScreenInfo":
            # Hors 4.2 (cf. ACTIONS_ETENDUES) -- AJOUT (demande explicite
            # utilisateur : InstanceExecutable.position_aleatoire()) --
            # pure lecture (taille du viewport + position du curseur
            # virtuel tracké), ne touche jamais etat_navigateur["page"],
            # même principe que isInterfaceInitialisee/getHomeTabId.
            resultat = await action_get_screen_info(page, etat_navigateur=etat_navigateur)
        elif action == "listTabs":
            resultat = await action_list_tabs(browser, page)
        elif action == "goBack":
            # PATCH (retour utilisateur -- panneau de rendu réseau
            # "piégé" après un clic sur un lien, aucun bouton retour) --
            # cf. docstring action_go_back.
            resultat = {"navigue": await action_go_back(page)}
        elif action == "goForward":
            resultat = {"navigue": await action_go_forward(page)}
        elif action == "switchTab":
            nouvel_onglet = await action_switch_tab(browser, str(data["tabId"]))
            etat_navigateur["page"] = nouvel_onglet
            # AJOUT : contrairement à newTab/resetInterface, l'onglet ciblé
            # par switchTab n'a pas forcément été créé par AutoniaX -- il
            # peut avoir été ouvert nativement par la page pilotée (lien
            # target="_blank", window.open() JS, etc.), auquel cas il n'a
            # jamais reçu l'interception (cf. docstring
            # _installer_interception_presse_papier : posée par session CDP,
            # jamais globalement). Idempotent si l'onglet l'avait déjà (ex.
            # switch vers un onglet créé via newTab) -- cf. cette même
            # docstring.
            await _installer_interception_presse_papier(nouvel_onglet, etat_navigateur)
            await _installer_synchro_blocage_media_sur_rechargement(nouvel_onglet, etat_navigateur)
        elif action == "bringToFront":
            # AJOUT (clic droit "voir ce profil" dans le panneau clone,
            # cf. docstring de action_bring_to_front) -- même patron que
            # switchTab ci-dessus (browser/page déjà disponibles dans ce
            # scope), mais SANS écrire etat_navigateur["page"] : l'onglet
            # actif ne change pas, seul le focus de la fenêtre remonte
            # ponctuellement au premier plan du bureau.
            await action_bring_to_front(browser, page)
        elif action == "setBlockageMedia":
            # AJOUT (SPEC §3.3 : « un canal push pour un effet immédiat ; le
            # polling seul n'est qu'un secours ») -- le bouton de la carte
            # écrit profils_config.json, que le gardien relit toutes les
            # 500 ms. Ce message-ci, lui, s'applique dans l'instant, sans
            # attendre le tour de polling. Idempotent.
            gardien = gardien_media_courant()
            voulu = bool(data.get("actif", False))
            if gardien is None:
                await _synchroniser_blocage_media_profil(page, etat_navigateur, voulu)
                return {"ok": True, "gardien": False, "actif": voulu}
            await gardien.set_state(voulu, source="push réseau")
            return {"ok": True, "gardien": True, "actif": gardien.actif, "stats": gardien.stats()}
        elif action == "mediaBlockStats":
            # AJOUT (SPEC §9 : « tu dois pouvoir PROUVER que ça marche ») --
            # expose les compteurs, dont media_bytes_leaked, au pilote.
            gardien = gardien_media_courant()
            if gardien is None:
                return {"ok": True, "gardien": False,
                        "error": "gardien non démarré (repli couche 1b) -- aucune métrique disponible"}
            return {"ok": True, "gardien": True, "stats": gardien.stats(), "etat": gardien.get_state()}
        elif action == "newTab":
            # PATCH (demande explicite utilisateur -- attente de
            # chargement complet, cf. docstring action_new_tab) :
            # timeout_attente_page_s vient du pilote (InstanceExecutable.
            # new_tab(), déjà résolu là-bas via RETRY/TIMEOUT de la
            # cellule "Variable dynamique" ou 8.0s par défaut) -- valeur
            # de repli 8.0 ici uniquement pour un appel newTab qui
            # n'inclurait pas ce paramètre (compat -- ne devrait pas
            # arriver via le pilote actuel, qui le fournit toujours).
            timeout_attente_page_s = float(data.get("timeout_attente_page_s", 8.0))
            # PATCH (demande explicite utilisateur -- blocage médias) :
            # bool(data.get(..., False)) -- même convention que partout
            # ailleurs dans ce dispatch (ex. timeout_attente_page_s
            # juste au-dessus) : absent côté pilote == comportement
            # historique inchangé (False).
            bloquer_media = bool(data.get("bloquer_media", False))
            # PATCH (toggle "bloquer médias" de la carte de profil) : le
            # toggle relu À CET INSTANT sur disque (cf. _lire_toggle_
            # bloquer_media_profil) s'ajoute au paramètre explicite du
            # Task (OU logique -- un True explicite n'est jamais annulé).
            # Un NOUVEL onglet démarre sans aucun filtre CDP, donc il
            # n'y a rien à "débloquer" ici : seul le cas ON compte.
            if not bloquer_media:
                bloquer_media = bool(_lire_toggle_bloquer_media_profil(etat_navigateur.get("nom_profil")))
            nouvel_onglet, charge, erreur_attente = await action_new_tab(
                browser, _url_nouvel_onglet(str(data.get("url", ""))), timeout_attente_page_s,
                bloquer_media=bloquer_media, etat_navigateur=etat_navigateur,
            )
            # L'onglet devient l'onglet actif MÊME si le chargement a
            # dépassé le délai (cf. docstring InstanceExecutable.new_tab :
            # "l'onglet de la tentative précédente ... reste ouvert" --
            # il existe bel et bien côté navigateur, autant que le reste
            # du Task puisse continuer à le cibler s'il le souhaite).
            etat_navigateur["page"] = nouvel_onglet
            # CORRECTION (SPEC §5.4) : plus de handler de resynchro par
            # onglet -- le gardien couvre déjà cette cible (et ses iframes,
            # et ses workers). L'appel reste, en façade, pour le repli sans
            # gardien ; il ne fait rien quand le gardien tourne.
            await _installer_synchro_blocage_media_sur_rechargement(nouvel_onglet, etat_navigateur)
            if not charge:
                # Décision utilisateur explicite : échec propre
                # (ResultatAction/erreur côté pilote), jamais une
                # exception qui remonterait et ferait planter la boucle
                # de commandes -- cf. docstring action_new_tab.
                return {"ok": False, "error": erreur_attente or "la page n'a pas fini de charger"}
            # CORRECTIF : le pilote (InstanceExecutable.new_tab) lit
            # reponse["result"]["id"] -- sans ceci result valait None et
            # provoquait AttributeError: 'NoneType' has no attribute 'get'.
            resultat = {"id": str(nouvel_onglet.target.target_id)}
        elif action == "navigate":
            # AJOUT (demande explicite utilisateur -- rester sur l'onglet
            # actif et naviguer vers un lien précis) -- contrairement à
            # newTab ci-dessus, etat_navigateur["page"] n'est PAS réécrit :
            # `page` (déjà l'onglet actif au moment de cet appel, même
            # lecture que capture_propre/getScreenInfo) est navigué sur
            # place, cf. docstring action_navigate. Même convention
            # d'échec propre que newTab ci-dessus : jamais d'exception
            # sur un simple dépassement de délai de chargement.
            timeout_attente_page_s = float(data.get("timeout_attente_page_s", 8.0))
            # PATCH (demande explicite utilisateur -- blocage médias) :
            # même convention que newTab ci-dessus -- absent côté pilote
            # == comportement historique inchangé (False).
            bloquer_media = bool(data.get("bloquer_media", False))
            # PATCH (toggle "bloquer médias" de la carte de profil,
            # révocable à chaud) : contrairement à newTab, un onglet
            # EXISTANT peut avoir gardé un filtre CDP posé lors d'une
            # navigation précédente (état par session, persistant). On
            # aligne donc le filtre sur le toggle COURANT -- posé si ON,
            # écrasé par une liste vide si OFF (cf. _synchroniser_
            # blocage_media_profil pour la règle de priorité complète).
            # bloquer_media=False est ensuite passé à action_navigate :
            # le filtre est déjà réglé, inutile de le réinstaller.
            await _synchroniser_blocage_media_profil(page, etat_navigateur, bloquer_media)
            # PATCH (remplacement de ressources) : règles réappliquées à l'onglet actif AVANT la navigation
            # (idempotent ; ne fait rien si aucune règle n'a jamais été définie).
            await _ro_synchroniser_page(page, etat_navigateur)
            charge, erreur_attente = await action_navigate(
                page, str(data.get("url", "")), timeout_attente_page_s,
                bloquer_media=False,
            )
            if not charge:
                return {"ok": False, "error": erreur_attente or "la page n'a pas fini de charger"}
            # BUGFIX : "navigate" ne crée jamais de nouvel onglet (cf.
            # docstring action_navigate : "SANS en ouvrir un nouveau",
            # contrairement à newTab) -- la variable `nouvel_onglet`
            # utilisée ici auparavant n'était donc JAMAIS assignée dans
            # cette branche (copiée depuis la branche newTab ci-dessus
            # sans être adaptée), ce qui levait systématiquement
            # UnboundLocalError dès que le chargement réussissait
            # (charge=True), remonté côté pilote comme un échec de
            # navigation ("cannot access local variable 'nouvel_onglet'
            # where it is not associated with a value") -- alors même que
            # la page avait bien fini de charger. `page` (l'onglet déjà
            # actif, réellement navigué par action_navigate) est la seule
            # référence pertinente ici : son ID de target ne change pas
            # (même onglet), et sa session CDP existante reste valide --
            # aucun besoin de réinstaller l'interception presse-papier
            # (déjà en place sur cet onglet depuis sa création), d'où sa
            # suppression ici.
            resultat = {"id": str(page.target.target_id)}
        elif action == "resetInterface":
            # Hors 4.2 (cf. ACTIONS_ETENDUES) -- PATCH demandé par
            # l'utilisateur : referme tous les onglets et ne laisse que la
            # welcome page (cf. action_reset_interface, même logique que
            # demarrer_navigateur : jamais fermer tous les onglets d'un
            # coup, toujours ouvrir le nouvel onglet AVANT de fermer les
            # anciens). instance_id vient du message reçu -- CHAQUE
            # message "command" porte déjà cette clé (cf. log ci-dessus,
            # qui l'exclut explicitement de l'affichage des params), donc
            # pas besoin de la faire transiter séparément.
            instance_id_reset = str(data.get("instance_id", ""))
            # PATCH : resetInterface NE VIDE PLUS les données de navigation par défaut (cache, cookies, stockage de
            # toutes les origines conservés). Pour les vider : reset_interface(vider_donnees=True), AVANT de refermer
            # les onglets. Best-effort.
            if data.get("vider_donnees"):
                try:
                    _rapport_vidage = await asyncio.wait_for(action_clear_browsing_data(page), timeout=25.0)
                    log.info(f"resetInterface : données de navigation vidées -- ok={_rapport_vidage.get('ok')} erreurs={_rapport_vidage.get('erreurs')}")
                except Exception as exc:
                    log.warning(f"resetInterface : vidage des données de navigation échoué -- {exc!r}")
            nouvel_onglet = await action_reset_interface(browser, instance_id_reset)
            etat_navigateur["page"] = nouvel_onglet
            # AJOUT : même raison que pour newTab juste au-dessus -- cet
            # onglet de remplacement a lui aussi sa propre session CDP.
            await _installer_interception_presse_papier(nouvel_onglet, etat_navigateur)
            await _installer_synchro_blocage_media_sur_rechargement(nouvel_onglet, etat_navigateur)
        elif action == "remplacerRessources":
            # PATCH : remplacer/modifier à la volée un fichier chargé par la page (cf. bloc AUTONIAX_RESOURCE_OVERRIDE).
            # Câblée aussi dans ACTIONS_ETENDUES, srv_ACTIONS_SUPPORTEES, le dispatcher Camoufox et les deux classes clientes.
            # Pas dans srv_ACTIONS_OBSERVATEUR_AUTORISEES.
            _rep_ro = await _ro_executer_commande(data, etat_navigateur, lambda: _ro_synchroniser_page(page, etat_navigateur))
            if not _rep_ro.get("ok"):
                return _rep_ro
            resultat = _rep_ro["result"]
        elif action == "clearBrowsingData":
            resultat = await action_clear_browsing_data(page)
            if not resultat.get("ok"):
                return {"ok": False, "error": "Échec du vidage des données de navigation : " + "; ".join(resultat.get("erreurs") or ["cookies non vidés"])}
        elif action == "isInterfaceInitialisee":
            # Hors 4.2 (cf. ACTIONS_ETENDUES) -- PATCH demandé par
            # l'utilisateur : pure lecture, ne touche jamais
            # etat_navigateur["page"] (contrairement à newTab/switchTab/
            # resetInterface ci-dessus qui changent l'onglet actif).
            # instance_id vient de data, même source que resetInterface
            # ci-dessus (chaque message "command" la porte déjà).
            instance_id_lecture = str(data.get("instance_id", ""))
            resultat = {"initialisee": await action_is_interface_initialisee(browser, page, instance_id_lecture)}
        elif action == "getHomeTabId":
            # Hors 4.2 (cf. ACTIONS_ETENDUES) -- PATCH demandé par
            # l'utilisateur : pure lecture, ne touche jamais
            # etat_navigateur["page"], même principe que
            # isInterfaceInitialisee juste au-dessus. instance_id vient de
            # data, même source que resetInterface/isInterfaceInitialisee
            # (chaque message "command" la porte déjà). None (welcome page
            # introuvable, cf. docstring action_get_home_tab_id) devient un
            # command_result ok=False explicite ici -- pas un tab_id vide
            # ou une exception CDP obscure remontée à l'appelant.
            instance_id_accueil = str(data.get("instance_id", ""))
            tab_id_accueil = await action_get_home_tab_id(browser, instance_id_accueil)
            if tab_id_accueil is None:
                return {"ok": False, "error": "Aucun onglet welcome page trouvé pour cette instance (fermé, ou instance démarrée avec une url_ouverture personnalisée)."}
            resultat = {"tabId": tab_id_accueil}
        elif action == "set_download_dir":
            # Hors 4.2 (cf. ACTIONS_ETENDUES) -- PATCH "Projet Batch" :
            # applique un nouveau dossier de téléchargement À CHAUD sur
            # cette instance déjà connectée, réutilisée d'un sous-projet à
            # l'autre par MoteurExecutionBatch (mode pool -- l'instance
            # n'est PAS jetée après chaque sous-projet, contrairement à
            # l'ancien lancer_instance_headless_pour_batch qui en créait
            # une fraîche par sous-projet). Réutilise _appliquer_download_dir
            # (extraite de demarrer_navigateur) -- même appel CDP
            # Browser.setDownloadBehavior, ici rejoué en cours de vie de
            # l'instance plutôt qu'une seule fois à son démarrage.
            reussi = await _appliquer_download_dir(page, str(data.get("download_dir", "")), str(data.get("instance_id", "")))
            resultat = {"applique": reussi}
            if not reussi:
                return {"ok": False, "error": "Échec de l'application du dossier de téléchargement (voir logs serveur/instance)."}
        elif action == "shutdown":
            # Hors 4.2 (cf. ACTIONS_ETENDUES) -- équivalent applicatif d'un
            # SIGTERM, mais joignable via le réseau : PATCH demandé par
            # l'utilisateur pour pouvoir fermer une instance "orpheline"
            # (déjà active côté serveur, lancée par une session AutoniaX
            # précédente ou un autre Dashboard -- cf. _processus_instances,
            # qui ne connaît alors aucun Popen local pour elle, donc aucun
            # moyen de proc.terminate()). En déclenchant le MÊME
            # asyncio.Event que le handler SIGTERM (cf. _demander_arret
            # dans _main_async), on réutilise exactement le chemin de
            # fermeture propre déjà existant : tache_arret se termine dans
            # _session_connexion_serveur -> cause="arret_demande" ->
            # _main_async sort de la boucle de reconnexion et appelle
            # browser.stop() avant que le process ne se termine lui-même.
            # command_result ok=True est renvoyé AVANT que l'event ne soit
            # traité (fire-and-forget, cf. docstring _consommer_file_commandes
            # : ce command_result confirme juste la RÉCEPTION de l'ordre,
            # pas la fermeture elle-même déjà effective -- l'appelant doit
            # se fier à la disparition de l'instance de instances_list pour
            # confirmer la fermeture réelle, pas à ce command_result seul).
            if arret_demande is not None:
                log.info("Action 'shutdown' reçue -- déclenchement de l'arrêt propre de l'instance.")
                arret_demande.set()
            else:
                log.warning("Action 'shutdown' reçue mais aucun arret_demande fourni -- ignorée.")
                return {"ok": False, "error": "shutdown non supporté par cette instance (arret_demande absent)"}
        else:
            # Ne devrait pas arriver si l'appelant filtre déjà sur
            # ACTIONS_SUPPORTEES -- gardé par robustesse.
            return {"ok": False, "error": f"action inconnue : {action}"}
        reponse_ok: dict = {"ok": True, "result": resultat}
        if extras_reponse:
            reponse_ok.update(extras_reponse)
        return reponse_ok
    except KeyError as e:
        log.warning(f"_executer_commande({action!r}) : paramètre manquant -- {e}")
        return {"ok": False, "error": f"paramètre manquant pour '{action}' : {e}"}
    except (ConnectionError, websockets.exceptions.ConnectionClosed) as e:
        log.warning(f"_executer_commande({action!r}) : ConnectionError/ConnectionClosed propagée -- {e!r}")
        raise
    except Exception as e:
        log.warning(f"Échec de l'action '{action}' : {e!r}")
        return {"ok": False, "error": str(e)}


async def _boucle_streaming_frames(ws, etat_navigateur: dict, instance_id: str, etat_stream: dict):
    """Cf. tout_en_un.py pour la justification complète du rythme
    auto-régulé et de la tolérance aux erreurs transitoires. Lève
    NavigateurFerme dès que capturer_frame_reelle signale une déconnexion
    définitive."""
    numero_sequence = 0
    log.info(f"_boucle_streaming_frames() : démarrage pour {instance_id} (fps={etat_stream['fps']}, actif={etat_stream['actif']})")
    try:
        while True:
            if not etat_stream["actif"]:
                await asyncio.sleep(0.1)
                continue
            debut = _horloge()
            # LOG DIAGNOSTIC CIBLÉ (bug "2e test qui gèle") : capturer_frame_reelle
            # était await-é SANS timeout -- si CDP se fige (page/onglet ne répond
            # plus après la rafale de moveCursor du test précédent), cet await ne
            # revient JAMAIS et aucune exception n'est levée : silence total, sans
            # la moindre trace de log, exactement le symptôme observé. Le
            # asyncio.wait_for ci-dessous force une TimeoutError explicite et
            # loggée après 5s, pour distinguer clairement "CDP figé" de toute
            # autre cause -- et le log AVANT l'appel donne l'heure exacte à
            # laquelle la boucle s'est mise à attendre, à comparer avec l'heure
            # de coupure côté AutoniaX.
            log.info(f"_boucle_streaming_frames() : capture seq={numero_sequence} -- appel capturer_frame_reelle...")
            # CORRECTIF (demande explicite utilisateur : "dès qu'on passe en
            # mode rafraîchissement manuel, tout les autres frame doivent
            # être bloquer, je ne veux plus aucun autre téléchargement") --
            # AVANT ce correctif, `etat_stream["actif"]` n'était vérifié
            # qu'au TOUT DÉBUT de chaque itération (cf. `if not etat_stream
            # ["actif"]: ... continue` ci-dessus) : si set_streaming(actif=
            # False) arrivait PENDANT que cette itération attendait déjà
            # capturer_frame_reelle (jusqu'à 15s, cf. timeout ci-dessous),
            # cette capture EN VOL continuait jusqu'à son terme et sa frame
            # était quand même envoyée (ws.send plus bas) avant que la
            # boucle ne revienne vérifier le flag -- d'où le symptôme
            # observé ("certaines captures continuent un peu à venir" après
            # le passage en manuel). La capture est désormais lancée comme
            # une TÂCHE asyncio séparée, référencée dans etat_stream
            # ["tache_capture_courante"] -- le handler "set_streaming" (cf.
            # _recevoir_messages_serveur) peut ainsi l'annuler IMMÉDIATEMENT
            # dès réception de actif=False, plutôt que d'attendre que cette
            # itération se termine naturellement (même principe que
            # "cancel_pending" pour une commande CDP en cours, juste
            # au-dessus dans ce fichier).
            tache_capture = asyncio.ensure_future(
                capturer_frame_reelle(etat_navigateur["page"], instance_id)
            )
            etat_stream["tache_capture_courante"] = tache_capture
            try:
                # OBJECTIF 2 (demande explicite utilisateur) : 5.0s -> 15.0s --
                # même raison que camoufox_capturer_frame_reelle et
                # TIMEOUT_CAPTURE_PROPRE_CDP_S ci-dessus (cohérence des 3
                # timeouts liés à la capture sous charge multi-instances).
                image_b64 = await asyncio.wait_for(tache_capture, timeout=15.0)
                log.info(f"_boucle_streaming_frames() : capture seq={numero_sequence} -- retour OK ({_horloge() - debut:.3f}s)")
            except asyncio.CancelledError:
                # Annulée par le handler set_streaming (passage en mode
                # manuel pendant cette capture précise) -- pas une erreur,
                # cette frame est simplement abandonnée : on ne l'envoie
                # jamais (contrairement au cas TimeoutError ci-dessous, qui,
                # lui, retombe sur une frame simulée plutôt que de ne rien
                # envoyer du tout -- ici il n'y a explicitement plus rien à
                # afficher tant que le mode reste manuel). Retour direct au
                # sommet de la boucle : `if not etat_stream["actif"]` y
                # renvoie immédiatement vers le sleep(0.1) tant que le mode
                # manuel reste actif, sans jamais atteindre ws.send.
                log.debug(f"_boucle_streaming_frames() : capture seq={numero_sequence} annulée (passage en mode manuel)")
                etat_stream["tache_capture_courante"] = None
                continue
            except asyncio.TimeoutError:
                log.error(
                    f"_boucle_streaming_frames() : capture seq={numero_sequence} -- BLOQUÉE plus de 15s sur "
                    f"capturer_frame_reelle (CDP probablement figé) -- passage à une frame simulée pour ne "
                    f"pas geler tout le process instance"
                )
                image_b64 = None
            except (ConnectionError, websockets.exceptions.ConnectionClosed) as e:
                log.warning(
                    f"Navigateur de l'instance '{instance_id}' déconnecté ({e!r}) -> arrêt du streaming "
                    f"(seq={numero_sequence}) -- lève NavigateurFerme, ce qui va terminer _main_async et "
                    f"fermer la connexion websocket instance<->serveur"
                )
                raise NavigateurFerme(str(e)) from e
            finally:
                etat_stream["tache_capture_courante"] = None
            # CORRECTIF (même demande) : re-vérifie actif juste APRÈS la
            # capture, avant d'envoyer quoi que ce soit -- couvre la
            # fenêtre où actif serait repassé à False PENDANT la capture
            # mais où celle-ci aurait quand même fini par aboutir (course
            # entre l'annulation et la fin naturelle de la tâche, cf.
            # asyncio -- une CancelledError n'est pas garantie de "gagner"
            # si le résultat était déjà disponible au moment de l'appel à
            # .cancel()). Sans cette double vérification, une frame
            # capturée juste avant l'annulation mais résolue juste après
            # pourrait quand même être envoyée -- exactement le
            # comportement que ce correctif doit éliminer.
            if not etat_stream["actif"]:
                log.debug(f"_boucle_streaming_frames() : capture seq={numero_sequence} obtenue mais mode manuel actif entre-temps -- frame abandonnée")
                continue
            if image_b64 is None:
                image_b64 = generer_capture_simulee(instance_id)
            try:
                await ws.send(json.dumps({
                    "type": "frame", "instance_id": instance_id, "image_b64": image_b64,
                    "seq": numero_sequence, "ts_capture": debut,
                }))
            except websockets.exceptions.ConnectionClosed as e:
                # LOG DIAGNOSTIC : distinct du cas ci-dessus -- ici c'est
                # l'ENVOI de la frame qui a échoué (connexion websocket
                # instance<->serveur déjà fermée), pas la capture CDP.
                log.warning(f"Envoi de la frame #{numero_sequence} impossible : connexion déjà fermée -- {e!r}")
                raise
            if numero_sequence < 5 or numero_sequence % 50 == 0:
                log.debug(f"Frame #{numero_sequence} envoyée pour {instance_id}")
            numero_sequence += 1
            ecoule = _horloge() - debut
            attente = max(0.0, (1.0 / etat_stream["fps"]) - ecoule)
            await asyncio.sleep(attente)
    finally:
        log.info(f"_boucle_streaming_frames() : sortie de boucle pour {instance_id} (seq={numero_sequence})")


async def _consommer_file_commandes(file_commandes: "asyncio.Queue", ws, instance_id: str, browser, etat_navigateur: dict, arret_demande: "asyncio.Event", etat_annulation: "dict | None" = None):
    """BUG CORRIGÉ (bug "2e test qui bloque" -- keepalive ping timeout) :
    auparavant, _executer_commande() (CDP réel, ex. Runtime.evaluate pour
    chaque moveCursor) était await-é DIRECTEMENT dans le async for de
    _recevoir_messages_serveur. Une rafale de commandes fire-and-forget
    (ex. les 12 moveCursor de SequenceurActionReseau._lancer_deplacement,
    envoyés sans attendre de command_result) arrivait alors toutes dans le
    buffer de réception websocket, mais n'était lue/traitée qu'UNE A LA
    FOIS : tant que _executer_commande() de la commande n°1 n'avait pas
    fini son aller-retour CDP, async for ne reprenait pas la main pour lire
    la commande n°2, et surtout l'event loop restait occupé -- ce qui
    retardait d'autant l'envoi des frames de _boucle_streaming_frames ET
    les pings/pongs internes de la lib websockets sur cette même
    connexion. Sur une rafale de 12 commandes CDP, le cumul suffisait à
    dépasser le timeout keepalive du serveur -> connexion fermée
    (code 1011 'keepalive ping timeout'), côté pilote ET côté dashboard
    presque simultanément (event loop du PROCESSUS INSTANCE saturé, pas
    celui du serveur -- d'où les deux connexions qui tombent ensemble).

    Correctif : _recevoir_messages_serveur ne fait plus qu'empiler les
    commandes reçues dans une asyncio.Queue et boucle immédiatement --
    lecture du websocket jamais bloquée par l'exécution CDP. Cette
    coroutine séparée consomme la file et exécute les commandes une par
    une, DANS L'ORDRE D'ARRIVÉE (FIFO -- indispensable : un click doit
    s'exécuter après le moveCursor qui le précède dans la même séquence),
    mais sans bloquer la lecture des nouveaux messages entrants pendant ce
    temps. set_fps/set_streaming restent traités directement dans
    _recevoir_messages_serveur (déjà quasi instantanés, pas de CDP).

    BUG CORRIGÉ (cf. diagnostic "type_text fantôme après arreter()") :
    quand asyncio.wait_for() ci-dessous expirait sur timeout_interne_s, la
    commande était déclarée abandonnée CÔTÉ LOG SEULEMENT -- la coroutine
    _executer_commande() sous-jacente recevait bien un CancelledError,
    mais rien ne permettait à un signal EXTERNE (ex: le pilote qui a
    cliqué "arrêter" bien avant l'expiration du timeout interne) de la
    couper plus tôt. Résultat observé : un type_text abandonné par le
    pilote (timeout réseau côté moteur, ou arreter()/unlink) continuait
    de taper les caractères restants côté navigateur jusqu'à SA PROPRE
    fin naturelle (timeout_interne_s ou fin du texte), et son
    command_result tardif arrivait en pleine exécution suivante sur la
    même instance -- désynchronisant la file FIFO (cf. log : une capture
    de l'exécution suivante expirait côté moteur pendant que l'instance
    finissait encore de traiter ce type_text fantôme).

    Correctif : la Task créée pour _executer_commande() est maintenant
    gardée dans etat_annulation["tache_courante"] pendant toute son
    exécution. Un message dédié 'cancel_pending' (cf.
    _recevoir_messages_serveur) peut alors appeler .cancel() dessus
    IMMÉDIATEMENT -- sans attendre timeout_interne_s -- et cette même
    coroutine vide aussi le reste de la file (les commandes déjà
    empilées derrière la commande annulée n'ont plus de sens une fois le
    pilote détaché de l'instance)."""
    while True:
        data = await file_commandes.get()
        try:
            action = data.get("action")
            requete_id = data.get("requete_id")
            log.info(f"Commande '{action}' reçue (requete_id={requete_id!r}) -- exécution... (file={file_commandes.qsize()} en attente)")
            debut_cmd = _horloge()
            # LOG DIAGNOSTIC CIBLÉ (bug "2e test qui gèle") : même logique que
            # pour capturer_frame_reelle -- si _executer_commande se fige sur
            # un appel CDP (ex: moveCursor pendant une rafale), sans timeout
            # ici TOUTES les commandes suivantes de la file resteraient
            # bloquées derrière elle indéfiniment, y compris le set_fps/
            # set_streaming du test suivant -- ce qui correspondrait
            # exactement au silence observé après un test précédent.
            # PATCH (demande explicite utilisateur -- attente de chargement
            # complet sur newTab, cf. docstring action_new_tab) : ce timeout
            # interne de 5.0s (documenté ci-dessus) est plus court que le
            # délai que newTab peut légitimement passer à attendre
            # document.readyState == "complete" (timeout_attente_page_s,
            # transmis par le pilote -- 8.0s par défaut, potentiellement
            # plus si TIMEOUT est personnalisé dans la cellule "Variable
            # statique" du Task). Sans ce cas particulier, CETTE boucle
            # couperait systématiquement newTab avant même que
            # action_new_tab ait fini d'attendre proprement -- annulant le
            # patch côté action_new_tab. Toutes les AUTRES actions gardent
            # le timeout fixe 5.0s inchangé (comportement historique) --
            # SAUF type_text, cf. cas particulier juste en dessous.
            #
            # BUG CORRIGÉ (demande explicite utilisateur -- "je viens de
            # mettre a 100 le timeout et sa coupe toujours ... je suis sur
            # que il y a un bugs" -- texte tapé deux fois de suite,
            # coupé exactement au même endroit à chaque tentative) :
            # MÊME PROBLÈME que newTab ci-dessus, jamais corrigé pour
            # type_text -- un texte assez long pour prendre plus de 5s à
            # taper (cf. delai_min_ms/delai_max_ms côté saisir()) se
            # faisait TOUJOURS couper ici après 5.0s pile, peu importe le
            # "timeout" passé par l'utilisateur à saisir() (ce paramètre
            # ne contrôlait QUE le délai réseau côté moteur, jamais
            # transmis jusqu'ici) -- ce qui déclenchait un retry qui
            # retapait le texte ENTIER depuis le début sur le champ déjà
            # partiellement rempli (texte dupliqué en boucle). Corrigé en
            # lisant timeout_saisie_s, transmis par saisir() (cf. sa
            # docstring, "BUG CORRIGÉ" -- calculé automatiquement à partir
            # de la longueur du texte si l'utilisateur ne précise rien).
            #
            # GÉNÉRALISÉ (demande explicite utilisateur -- "je veux juste
            # que ce soit le comportement par defaut mais des que je
            # specifie quelque chose sa doit etre respecter") : MÊME
            # PROBLÈME que ci-dessus pour click/mousemove/moveCursor/
            # scroll/paste/clear/drag/drop -- leur "timeout" ne contrôlait
            # lui aussi QUE le délai réseau côté moteur (cf.
            # _executer_avec_retry), jamais ce timeout interne. Corrigé en
            # lisant timeout_action_s (transmis par ComposantExecutable.
            # _executer_avec_retry UNIQUEMENT si un timeout est
            # explicitement résolu -- cf. sa docstring/commentaire) --
            # ABSENT de data (comportement par défaut, rien précisé par
            # l'utilisateur) -> retombe sur 5.0 fixe, INCHANGÉ.
            if action == "newTab" or action == "navigate":
                # AJOUT ("navigate" -- demande explicite utilisateur :
                # rester sur l'onglet actif et naviguer vers un lien
                # précis) : MÊME besoin EXACT que newTab -- attend elle
                # aussi un chargement de page complet (cf. action_navigate/
                # _attendre_chargement_page), donc MÊME calcul de timeout
                # interne, sur le MÊME paramètre data["timeout_attente_page_s"].
                timeout_interne_s = float(data.get("timeout_attente_page_s", DELAI_ATTENTE_CHARGEMENT_PAGE_DEFAUT_S)) + MARGE_RESEAU_ATTENTE_CHARGEMENT_S
            elif action == "type_text":
                timeout_interne_s = float(data.get("timeout_saisie_s", 5.0))
            else:
                # CORRECTIF (demande utilisateur : 5.0s trop court pour
                # certaines actions comme resetInterface juste après le
                # démarrage d'une instance, pendant que le préchargement
                # des banques de mouvements souris/scroll est encore en
                # cours -- cf. bug rapporté "timeout interne instance :
                # ... ne répond pas (>5.0s)" sur la toute première
                # commande envoyée après lancement d'un profil isolé).
                # Défaut relevé à 15.0s ; reste surchargeable via
                # data["timeout_action_s"] comme avant.
                timeout_interne_s = float(data.get("timeout_action_s", 15.0))
            # 'cancel_pending' reçu entre-temps (cf.
            # _recevoir_messages_serveur) puisse l'annuler IMMÉDIATEMENT
            # via .cancel(), sans attendre timeout_interne_s.
            tache_commande = asyncio.ensure_future(_executer_commande(browser, etat_navigateur, data, arret_demande))
            if etat_annulation is not None:
                etat_annulation["tache_courante"] = tache_commande
                etat_annulation["requete_id_courante"] = requete_id
            try:
                # AJOUT (demande explicite utilisateur -- "je veux voir le
                # message d'erreur pas juste quelque chose qui reste figer
                # sans logs jusqu'à ce qu'on me dise que pendant 40 secondes
                # rien ne s'est passé") : avant ce patch, l'attente ci-dessous
                # se faisait en un seul asyncio.wait_for -- silence total côté
                # logs entre le log de démarrage de _executer_commande() et
                # soit la réussite, soit le message final "BLOQUÉE plus de
                # Xs" une fois le timeout ENTIER écoulé.
                #
                # PATCH (nettoyage des logs -- problème #6 : "pour une même
                # commande, on voit 'toujours en attente après 5.0s', puis
                # '10.0s', puis '15.0s'... ne loguez ces avertissements qu'à
                # deux seuils : 50% du timeout et le timeout final. Supprimez
                # les paliers intermédiaires") -- remplacé le sondage par
                # tranches FIXES de INTERVALLE_LOG_ATTENTE_CDP_S (répété
                # autant de fois que nécessaire) par exactement DEUX tranches :
                # la première jusqu'à 50% de timeout_interne_s (un seul log
                # intermédiaire "toujours en attente" à mi-parcours), la
                # seconde jusqu'au timeout complet (log final "BLOQUÉE plus
                # de..." déjà présent plus bas, inchangé -- pas de log
                # supplémentaire ici). asyncio.shield() conservé à l'identique
                # (même rôle qu'avant : protège tache_commande d'une
                # annulation implicite, cancel_pending reste le seul
                # déclencheur direct) -- seule la façon d'ATTENDRE ce résultat
                # protégé change.
                mi_timeout = timeout_interne_s / 2.0
                try:
                    reponse = await asyncio.wait_for(asyncio.shield(tache_commande), timeout=mi_timeout)
                except asyncio.TimeoutError:
                    log.warning(
                        f"Commande '{action}' (requete_id={requete_id!r}) -- toujours en attente sur CDP "
                        f"après {mi_timeout:.1f}s / {timeout_interne_s:.1f}s (_executer_commande n'a pas "
                        f"encore répondu)"
                    )
                    reponse = await asyncio.wait_for(
                        asyncio.shield(tache_commande), timeout=timeout_interne_s - mi_timeout,
                    )  # 2e et dernière tranche -- TimeoutError ici = timeout final, traité juste en dessous
            except asyncio.CancelledError:
                # Annulation EXTERNE demandée (cancel_pending) -- distincte
                # d'un TimeoutError CDP : le pilote qui a envoyé cette
                # commande n'attend plus de réponse utile (il s'est déjà
                # détaché de l'instance, cf. srv_gerer_unlink), donc pas
                # d'error log bruyant ici, juste une trace info.
                # PATCH (problème #5, cf. _annuler_et_consommer) : cancel()
                # seul laissait une éventuelle exception résiduelle de
                # tache_commande jamais consultée -- asyncio la journalie
                # alors lui-même ("Future exception was never retrieved").
                await _annuler_et_consommer(tache_commande, contexte=f"{action}/{requete_id}")
                log.info(f"Commande '{action}' (requete_id={requete_id!r}) -- annulée sur demande externe (cancel_pending)")
                reponse = {"ok": False, "error": "commande annulée (cancel_pending)"}
            except asyncio.TimeoutError:
                log.error(
                    f"Commande '{action}' (requete_id={requete_id!r}) -- BLOQUÉE plus de {timeout_interne_s:.1f}s sur CDP "
                    f"(_executer_commande ne revient pas) -- abandon de cette commande pour ne pas geler "
                    f"toute la file suivante"
                )
                # asyncio.shield() protège tache_commande de l'annulation
                # implicite que wait_for ferait sur son argument direct --
                # nécessaire pour que cancel_pending (qui cible cette
                # MÊME Task) reste le seul déclencheur d'annulation
                # possible. Sur timeout CDP réel (pas cancel_pending),
                # c'est cette ligne, et non wait_for, qui coupe la Task.
                # PATCH (problème #5) : cf. commentaire identique ci-dessus.
                await _annuler_et_consommer(tache_commande, contexte=f"{action}/{requete_id}")
                reponse = {"ok": False, "error": f"timeout interne instance : CDP ne répond pas (>{timeout_interne_s:.1f}s)"}
            finally:
                if etat_annulation is not None and etat_annulation.get("tache_courante") is tache_commande:
                    etat_annulation["tache_courante"] = None
                    etat_annulation["requete_id_courante"] = None
            duree_cmd = _horloge() - debut_cmd
            if duree_cmd > 1.0:
                log.warning(f"Commande '{action}' (requete_id={requete_id!r}) -- lente : {duree_cmd:.3f}s")
            await ws.send(json.dumps({
                "type": "command_result",
                "instance_id": instance_id,
                "action": action,
                "requete_id": data.get("requete_id"),  # écho tel quel si fourni par le pilote, sinon None
                **reponse,
            }))
            if reponse.get("ok"):
                log.info(f"Action '{action}' exécutée (requete_id={requete_id!r})")
            else:
                log.warning(f"Action '{action}' échouée (requete_id={requete_id!r}) : {reponse.get('error')}")
        except (ConnectionError, websockets.exceptions.ConnectionClosed):
            # Connexion tombée pendant l'exécution/l'envoi de la réponse --
            # remonte à _main_async via la tâche dédiée (cf. ensure_future
            # dans _recevoir_messages_serveur), pas la peine de la ravaler
            # ici silencieusement.
            raise
        finally:
            file_commandes.task_done()


async def _recevoir_messages_serveur(ws, instance_id: str, etat_stream: dict, browser, etat_navigateur: dict, arret_demande: "asyncio.Event"):
    log.info(f"_recevoir_messages_serveur() : démarrage pour {instance_id}")
    file_commandes: asyncio.Queue = asyncio.Queue()
    # Dict partagé (pas une classe dédiée -- cohérent avec etat_navigateur/
    # etat_stream déjà utilisés ainsi ailleurs dans ce fichier) exposant la
    # Task actuellement en cours d'exécution dans _consommer_file_commandes,
    # pour que 'cancel_pending' (cf. plus bas) puisse l'annuler sans passer
    # par la file (une commande d'annulation mise en file attendrait son
    # tour DERRIÈRE la commande bloquée qu'elle est censée couper -- inutile).
    etat_annulation: dict = {"tache_courante": None, "requete_id_courante": None}
    tache_consommateur = asyncio.ensure_future(
        _consommer_file_commandes(file_commandes, ws, instance_id, browser, etat_navigateur, arret_demande, etat_annulation)
    )
    try:
        async for brut in ws:
            data = json.loads(brut)
            type_message = data.get("type")
            if type_message == "registered":
                log.info(f"Enregistrement confirmé par le serveur : id={data['id']}")
            elif type_message == "command":
                action = data.get("action")
                if action == "set_fps":
                    nouveau_fps = max(FPS_MIN, min(FPS_MAX, int(data.get("fps", FPS_DEFAUT))))
                    etat_stream["fps"] = nouveau_fps
                    # CORRECTIF (retour utilisateur explicite : "trop de
                    # logs redondants") -- même raisonnement que le chemin
                    # Camoufox (cf. plus bas dans ce fichier) : commande de
                    # routine relayée à chaque clic Rafraîchir/Automatique.
                    log.debug(f"FPS mis à jour -> {nouveau_fps} (requete_id={data.get('requete_id')!r})")
                elif action == "set_streaming":
                    etat_stream["actif"] = bool(data.get("actif", True))
                    log.debug(
                        f"Streaming {'repris' if etat_stream['actif'] else 'mis en pause'} "
                        f"(requete_id={data.get('requete_id')!r})"
                    )
                    # CORRECTIF (demande explicite utilisateur : "dès qu'on
                    # passe en mode rafraîchissement manuel, tout les autres
                    # frame doivent être bloquer") -- même principe que
                    # cancel_pending juste en dessous : poser le flag seul
                    # ne suffit pas, une capture déjà en vol (jusqu'à 15s,
                    # cf. _boucle_streaming_frames) continuerait sinon
                    # jusqu'à son terme et sa frame serait quand même
                    # envoyée. On annule donc IMMÉDIATEMENT la tâche de
                    # capture en cours (si une l'est) dès réception de
                    # actif=False -- _boucle_streaming_frames intercepte
                    # cette CancelledError et abandonne proprement la frame
                    # sans jamais l'envoyer (cf. son propre commentaire).
                    if not etat_stream["actif"]:
                        tache_capture_courante = etat_stream.get("tache_capture_courante")
                        if tache_capture_courante is not None and not tache_capture_courante.done():
                            tache_capture_courante.cancel()
                            log.debug(
                                f"set_streaming(actif=False) : capture en vol annulée immédiatement "
                                f"pour '{instance_id}'"
                            )
                elif action == "cancel_pending":
                    # AJOUTÉ (correctif "commande fantôme après arreter()/
                    # unlink") -- traité ICI, directement, JAMAIS mis dans
                    # file_commandes : une commande d'annulation mise en
                    # file attendrait son tour derrière la commande
                    # bloquée qu'elle est censée couper, ce qui la rend
                    # inutile. Envoyée par le serveur (cf. srv_gerer_unlink)
                    # au moment où le pilote qui tenait cette instance s'en
                    # détache -- annule la Task en cours d'exécution dans
                    # _consommer_file_commandes (si une commande CDP est
                    # effectivement en cours, ex: type_text en pleine
                    # frappe) ET vide le reste de la file : les commandes
                    # déjà empilées derrière n'ont plus de destinataire une
                    # fois le pilote détaché.
                    tache_en_cours = etat_annulation.get("tache_courante")
                    requete_annulee = etat_annulation.get("requete_id_courante")
                    if tache_en_cours is not None and not tache_en_cours.done():
                        tache_en_cours.cancel()
                        log.info(
                            f"cancel_pending reçu pour '{instance_id}' -- annulation de la commande en cours "
                            f"(requete_id={requete_annulee!r})"
                        )
                    else:
                        log.info(f"cancel_pending reçu pour '{instance_id}' -- aucune commande en cours à annuler")
                    nb_purgees = 0
                    while not file_commandes.empty():
                        try:
                            file_commandes.get_nowait()
                            file_commandes.task_done()
                            nb_purgees += 1
                        except asyncio.QueueEmpty:
                            break
                    if nb_purgees:
                        log.info(f"cancel_pending pour '{instance_id}' -- {nb_purgees} commande(s) en attente purgée(s) de la file")
                elif action in ACTIONS_SUPPORTEES:
                    # Empilée dans la file, pas exécutée ici -- cf. docstring
                    # _consommer_file_commandes ci-dessus. async for reprend
                    # IMMÉDIATEMENT, sans attendre le résultat CDP.
                    log.info(f"Commande '{action}' mise en file (requete_id={data.get('requete_id')!r})")
                    file_commandes.put_nowait(data)
                else:
                    log.warning(f"Action non supportée : {action}")
                    await ws.send(json.dumps({
                        "type": "command_result", "instance_id": instance_id, "action": action,
                        "requete_id": data.get("requete_id"),
                        "ok": False, "error": f"action non supportée : {action}",
                    }))
            elif type_message == "error":
                # BUG CORRIGÉ (cf. docstring EnregistrementRefuse) : NE PLUS
                # se contenter de logger -- une erreur reçue à ce stade
                # signifie très probablement un register refusé (id déjà
                # enregistré côté serveur), donc cette connexion est morte
                # pour de bon (jamais réellement enregistrée). On lève pour
                # forcer _main_async à fermer cette session et retenter,
                # au lieu de rester connecté en silence sans jamais
                # recevoir aucune commande (zombie).
                log.error(
                    f"Instance '{instance_id}' : erreur reçue du serveur -- {data.get('message')!r} "
                    f"-- connexion considérée morte, fermeture pour déclencher une reconnexion"
                )
                raise EnregistrementRefuse(str(data.get("message")))
    except (ConnectionError, websockets.exceptions.ConnectionClosed) as e:
        # LOG DIAGNOSTIC : si ceci apparaît, c'est la boucle de RÉCEPTION
        # (pas celle de streaming) qui a fait tomber la connexion --
        # typiquement parce qu'une action a levé ConnectionError depuis
        # _executer_commande (cf. plus haut). Utile pour savoir laquelle
        # des deux tâches (streaming ou réception) a terminé en premier
        # dans _main_async.
        log.warning(f"_recevoir_messages_serveur() : connexion perdue -- {e!r}")
        raise
    except EnregistrementRefuse:
        # Laissée remonter telle quelle (pas ConnectionError/ConnectionClosed,
        # donc pas interceptée par le except ci-dessus) -- gérée explicitement
        # dans _session_connexion_serveur, cf. docstring EnregistrementRefuse.
        raise
    finally:
        tache_consommateur.cancel()
        try:
            await tache_consommateur
        except (asyncio.CancelledError, ConnectionError, websockets.exceptions.ConnectionClosed):
            pass
        log.info(f"_recevoir_messages_serveur() : sortie de boucle pour {instance_id}")


async def _session_connexion_serveur(
    ws, instance_id: str, browser, page, etat_navigateur: dict, etat_stream: dict, arret_demande: "asyncio.Event",
) -> str:
    """UNE session de connexion WebSocket déjà ouverte (cf. _main_async, qui
    gère l'ouverture/fermeture de `ws` lui-même et la boucle de retry
    autour de cette fonction) : enregistre l'instance auprès du serveur,
    lance streaming + réception de commandes, attend que l'une des 3
    tâches (streaming, réception, arrêt demandé) se termine en premier.

    Retourne une chaîne indiquant la CAUSE de fin de session, pour que
    _main_async décide s'il doit fermer le navigateur ou retenter une
    reconnexion :
      - "arret_demande"   : SIGTERM/SIGINT reçu -- fermeture propre voulue.
      - "navigateur_ferme" : NavigateurFerme levée (CDP planté, Chrome fermé
        manuellement...) -- plus rien à piloter, fermeture définitive.
      - "connexion_perdue" : ConnectionError/ConnectionClosed (serveur
        injoignable/arrêté) -- le NAVIGATEUR, lui, tourne toujours :
        _main_async doit retenter une connexion plutôt que fermer quoi
        que ce soit (cf. demande explicite utilisateur : garder le
        navigateur ouvert et se reconnecter automatiquement tant que
        lui-même n'est pas fermé)."""
    await ws.send(json.dumps({"type": "register", "role": "instance", "id": instance_id, "pid": os.getpid()}))
    log.info(f"Instance '{instance_id}' connectée au serveur, enregistrement en cours... (PID {os.getpid()})")

    tache_streaming = asyncio.ensure_future(_boucle_streaming_frames(ws, etat_navigateur, instance_id, etat_stream))
    tache_reception = asyncio.ensure_future(_recevoir_messages_serveur(ws, instance_id, etat_stream, browser, etat_navigateur, arret_demande))
    tache_arret = asyncio.ensure_future(arret_demande.wait())

    try:
        termine, en_attente = await asyncio.wait(
            [tache_streaming, tache_reception, tache_arret], return_when=asyncio.FIRST_COMPLETED,
        )
        noms_taches = {
            id(tache_streaming): "tache_streaming",
            id(tache_reception): "tache_reception",
            id(tache_arret): "tache_arret",
        }
        for tache in termine:
            exc = tache.exception() if not tache.cancelled() else "CancelledError"
            log.info(
                f"Instance '{instance_id}' : _session_connexion_serveur -- tâche terminée en premier = "
                f"{noms_taches.get(id(tache), '?')} exception={exc!r}"
            )
        for tache in en_attente:
            log.info(f"Instance '{instance_id}' : _session_connexion_serveur -- annulation de {noms_taches.get(id(tache), '?')}")
            tache.cancel()
        for tache in termine:
            if tache is tache_arret:
                log.info(f"Instance '{instance_id}' : arrêt demandé -> fermeture propre")
                return "arret_demande"
            exception = tache.exception()
            if isinstance(exception, NavigateurFerme):
                log.info(f"Instance '{instance_id}' : navigateur fermé -> fermeture de la connexion au serveur")
                return "navigateur_ferme"
            elif isinstance(exception, (ConnectionError, websockets.exceptions.ConnectionClosed)):
                log.warning(f"Instance '{instance_id}' : connexion au serveur perdue -> reconnexion automatique dans 5s")
                return "connexion_perdue"
            elif isinstance(exception, EnregistrementRefuse):
                # BUG CORRIGÉ (cf. docstring EnregistrementRefuse) : AVANT ce
                # correctif, cette branche n'existait pas -- l'exception
                # tombait dans le elif générique juste en dessous, qui la
                # relève telle quelle (raise exception) et fait REMONTER
                # jusqu'à _main_async, hors de la boucle de retry -> crash
                # du process instance au lieu d'une reconnexion automatique.
                # Traité maintenant exactement comme "connexion_perdue" :
                # navigateur intact, nouvelle tentative dans 5s (cf.
                # _main_async), avec un log distinct pour diagnostiquer
                # facilement ce cas précis si ça se reproduit.
                log.warning(
                    f"Instance '{instance_id}' : register refusé par le serveur ({exception}) "
                    f"-> reconnexion automatique dans 5s"
                )
                return "connexion_perdue"
            elif exception is not None and not isinstance(exception, asyncio.CancelledError):
                log.error(f"Instance '{instance_id}' : exception inattendue -> {exception!r}")
                raise exception
        # Aucune tâche n'a levé d'exception identifiable (cas normalement
        # impossible puisque return_when=FIRST_COMPLETED garantit qu'au
        # moins une tâche est terminée) -- traité comme une perte de
        # connexion par prudence, pour ne jamais fermer le navigateur sur
        # un cas non prévu.
        return "connexion_perdue"
    finally:
        log.info(f"Instance '{instance_id}' : _session_connexion_serveur -- fin de session")
        tache_streaming.cancel()
        tache_reception.cancel()
        tache_arret.cancel()


# ---------------------------------------------------------------------------
# Session Camoufox MINIMALE -- PATCH (demande utilisateur explicite : "es ce
# que tu peu modifer l'app de tels sorte que les profisl camoufox se lance
# correctement"), portée volontairement limitée (décision utilisateur
# explicite lors de ce patch : "D'abord juste : que le profil s'ouvre avec
# Camoufox... sans streaming/pilotage à distance pour l'instant").
#
# Ce n'est PAS l'équivalent complet de _session_connexion_serveur : pas de
# streaming vidéo, pas de dispatch de commandes vers
# _executer_commande_camoufox (existe déjà dans ce fichier, cf. plus haut,
# mais PAS appelé ici -- brancher réellement le pilotage à distance est un
# patch séparé, plus large, explicitement mis de côté pour cette étape).
# Cette fonction fait UNIQUEMENT ce qu'il faut pour qu'une instance Camoufox
# apparaisse "active" dans le Dashboard (register) et puisse être arrêtée
# proprement depuis l'UI (arret_demande) -- rien de plus.
#
# Toute commande reçue du serveur (clic, navigation, etc.) reçoit une
# réponse command_result ok=False explicite ("pilotage à distance non
# disponible pour Camoufox pour l'instant") plutôt que d'être silencieusement
# ignorée -- pour que l'UI (qui attend une réponse par requete_id, cf.
# _consommer_file_commandes côté nodriver) ne reste jamais bloquée en
# attente d'un résultat qui ne viendra jamais.
# ---------------------------------------------------------------------------

async def _consommer_file_commandes_camoufox(
    file_commandes: "asyncio.Queue", ws, instance_id: str, context, gestion: "GestionOngletsCamoufox",
    etat_navigateur: dict, arret_demande: "asyncio.Event", etat_annulation: "dict | None" = None,
    etat_scroll_simple: "dict | None" = None,
) -> None:
    """PATCH (retour utilisateur explicite : "ajoute la couche de
    robustesse") -- symétrique EXACT de _consommer_file_commandes (client
    nodriver, cf. sa docstring pour la genèse complète des deux bugs
    corrigés : saturation de l'event loop par une rafale de commandes
    fire-and-forget, puis commande "fantôme" continuant de s'exécuter
    après que le pilote s'en soit détaché). Reproduit les deux mêmes
    correctifs pour les instances Camoufox :

    1) Consomme `file_commandes` une commande à la fois, DANS L'ORDRE
       D'ARRIVÉE (FIFO), sur une Task séparée de la boucle de lecture du
       WebSocket (_ecouter_serveur, qui ne fait plus qu'empiler et boucler
       immédiatement) -- une commande Playwright lente ne bloque donc plus
       jamais la réception des messages suivants ni les pings/pongs
       internes de la lib websockets sur cette même connexion.

    2) La Task créée pour _executer_commande_camoufox() est gardée dans
       etat_annulation["tache_courante"] pendant toute son exécution, pour
       qu'un message 'cancel_pending' (cf. _ecouter_serveur plus bas)
       puisse l'annuler IMMÉDIATEMENT via .cancel(), sans attendre
       timeout_interne_s -- et purge aussi le reste de la file (les
       commandes déjà empilées derrière n'ont plus de destinataire une
       fois le pilote détaché).

    Mêmes constantes de timeout que côté nodriver (DELAI_ATTENTE_
    CHARGEMENT_PAGE_DEFAUT_S, MARGE_RESEAU_ATTENTE_CHARGEMENT_S,
    INTERVALLE_LOG_ATTENTE_CDP_S) -- même cas particulier pour newTab
    (attente de chargement de page, potentiellement plus longue que le
    timeout générique de 5.0s) et type_text (timeout_saisie_s, calculé
    automatiquement à partir de la longueur du texte si non précisé par
    l'appelant -- cf. saisir() côté AutoniaX.py). shutdown/get_fingerprint/
    get_fingerprint_reel restent traités directement dans _ecouter_serveur,
    JAMAIS mis en file (même raison que set_fps/set_streaming côté
    nodriver : déjà quasi instantanés, aucun intérêt à les faire attendre
    derrière une commande Playwright lente)."""
    while True:
        data = await file_commandes.get()
        try:
            action = data.get("action")
            requete_id = data.get("requete_id")
            # DÉSACTIVÉ (demande explicite utilisateur : "logs les plus
            # bruyants" -- cf. analyse logs.txt, ~595 occurrences) --
            # passé en debug, réactivable via la config du logger.
            log.debug(
                f"[camoufox] Commande '{action}' reçue (requete_id={requete_id!r}) -- exécution... "
                f"(file={file_commandes.qsize()} en attente)"
            )
            debut_cmd = _horloge()
            if action == "newTab" or action == "navigate":
                # AJOUT ("navigate" -- même raison que côté nodriver
                # ci-dessus, cf. son commentaire) : même besoin EXACT que
                # newTab, même calcul de timeout interne.
                timeout_interne_s = float(data.get("timeout_attente_page_s", DELAI_ATTENTE_CHARGEMENT_PAGE_DEFAUT_S)) + MARGE_RESEAU_ATTENTE_CHARGEMENT_S
            elif action == "type_text":
                timeout_interne_s = float(data.get("timeout_saisie_s", 5.0))
            else:
                # CORRECTIF (bug rapporté : "timeout interne instance :
                # Playwright ne répond pas (>5.0s)" sur resetInterface,
                # à la toute première commande envoyée juste après le
                # démarrage d'un profil isolé -- l'instance était encore
                # occupée par le préchargement des banques de mouvements
                # souris/scroll, terminé quelques centaines de ms APRÈS
                # l'expiration du timeout de 5s ; cellules suivantes
                # toujours réussies une fois ce préchargement terminé).
                # Défaut relevé à 15.0s ; reste surchargeable via
                # data["timeout_action_s"] comme avant.
                timeout_interne_s = float(data.get("timeout_action_s", 15.0))
            tache_commande = asyncio.ensure_future(
                _executer_commande_camoufox(context, gestion, etat_navigateur, data, arret_demande)
            )
            if etat_annulation is not None:
                etat_annulation["tache_courante"] = tache_commande
                etat_annulation["requete_id_courante"] = requete_id
            # PATCH (demande utilisateur explicite : rejet immédiat à la
            # RÉCEPTION de tout scroll_simple qui arrive pendant qu'un
            # autre est déjà en cours -- cf. _ecouter_serveur, qui lit ce
            # même flag avant de mettre en file). Marqué True ici (juste
            # avant l'exécution réelle), remis à False dans le "finally"
            # externe plus bas (couvre TOUS les chemins de sortie :
            # succès, timeout, cancel_pending, exception) -- jamais
            # laissé bloqué à True si la commande échoue ou est annulée.
            if etat_scroll_simple is not None and action == "scroll_simple":
                etat_scroll_simple["en_cours"] = True
            try:
                # Même principe que côté nodriver (cf. sa docstring/ses
                # commentaires) -- un log intermédiaire à mi-timeout, plutôt
                # qu'un silence total jusqu'au timeout complet.
                #
                # PATCH (nettoyage des logs -- problème #6, cf. commentaire
                # détaillé côté nodriver un peu plus haut) : exactement DEUX
                # tranches (50% du timeout, puis le reste) au lieu du
                # sondage par tranches fixes de INTERVALLE_LOG_ATTENTE_CDP_S
                # répété -- un seul log intermédiaire par commande bloquée,
                # plus le log final "BLOQUÉE plus de..." déjà présent plus
                # bas (inchangé).
                mi_timeout = timeout_interne_s / 2.0
                try:
                    reponse = await asyncio.wait_for(asyncio.shield(tache_commande), timeout=mi_timeout)
                except asyncio.TimeoutError:
                    log.warning(
                        f"[camoufox] Commande '{action}' (requete_id={requete_id!r}) -- toujours en attente "
                        f"après {mi_timeout:.1f}s / {timeout_interne_s:.1f}s "
                        f"(_executer_commande_camoufox n'a pas encore répondu)"
                    )
                    reponse = await asyncio.wait_for(
                        asyncio.shield(tache_commande), timeout=timeout_interne_s - mi_timeout,
                    )  # 2e et dernière tranche -- TimeoutError ici = timeout final, traité juste en dessous
            except asyncio.CancelledError:
                # Annulation EXTERNE demandée (cancel_pending) -- même
                # sémantique que côté nodriver : le pilote qui a envoyé
                # cette commande ne l'attend plus, pas d'error log bruyant.
                # PATCH (problème #5, cf. _annuler_et_consommer) : voir
                # commentaire identique côté nodriver un peu plus haut.
                await _annuler_et_consommer(tache_commande, contexte=f"[camoufox] {action}/{requete_id}")
                log.info(f"[camoufox] Commande '{action}' (requete_id={requete_id!r}) -- annulée sur demande externe (cancel_pending)")
                reponse = {"ok": False, "error": "commande annulée (cancel_pending)"}
            except asyncio.TimeoutError:
                log.error(
                    f"[camoufox] Commande '{action}' (requete_id={requete_id!r}) -- BLOQUÉE plus de "
                    f"{timeout_interne_s:.1f}s (_executer_commande_camoufox ne répond pas) -- abandon de "
                    f"cette commande pour ne pas geler toute la file suivante"
                )
                await _annuler_et_consommer(tache_commande, contexte=f"[camoufox] {action}/{requete_id}")
                reponse = {"ok": False, "error": f"timeout interne instance : Playwright ne répond pas (>{timeout_interne_s:.1f}s)"}
            finally:
                if etat_annulation is not None and etat_annulation.get("tache_courante") is tache_commande:
                    etat_annulation["tache_courante"] = None
                    etat_annulation["requete_id_courante"] = None
            duree_cmd = _horloge() - debut_cmd
            if duree_cmd > 1.0:
                log.warning(f"[camoufox] Commande '{action}' (requete_id={requete_id!r}) -- lente : {duree_cmd:.3f}s")
            # PATCH (nettoyage des logs -- problème #4 : "[DIAG-INSTANCE]
            # sur le point d'envoyer command_result" et "[DIAG-INSTANCE]
            # command_result ENVOYÉ" étaient redondants avec le log
            # "[camoufox] Action '...' exécutée"/"échouée" juste en dessous,
            # qui indique déjà succès/échec -- supprimés, ne restent que ce
            # dernier log (résumé final de la commande).
            await ws.send(json.dumps({
                "type": "command_result",
                "instance_id": instance_id,
                "action": action,
                "requete_id": data.get("requete_id"),
                **reponse,
            }))
            if reponse.get("ok"):
                log.info(f"[camoufox] Action '{action}' exécutée (requete_id={requete_id!r})")
            else:
                log.warning(f"[camoufox] Action '{action}' échouée (requete_id={requete_id!r}) : {reponse.get('error')}")
        except (ConnectionError, websockets.exceptions.ConnectionClosed):
            raise
        finally:
            if etat_scroll_simple is not None and data.get("action") == "scroll_simple":
                etat_scroll_simple["en_cours"] = False
            file_commandes.task_done()


async def _session_camoufox_minimale(
    ws, instance_id: str, context, page, gestion: "GestionOngletsCamoufox", etat_navigateur: dict,
    etat_stream: dict, arret_demande: "asyncio.Event", profil: Optional[str] = None,
) -> str:
    """Équivalent MINIMAL de _session_connexion_serveur pour le client
    Camoufox/Playwright -- mêmes valeurs de retour ("arret_demande",
    "navigateur_ferme", "connexion_perdue"), mêmes conventions de log, pour
    que _main_async puisse réutiliser EXACTEMENT la même boucle de
    reconnexion qu'avec le client nodriver, sans dupliquer cette logique.

    `profil` (nouveau) : nécessaire UNIQUEMENT pour répondre à l'action
    "get_fingerprint" (cf. plus bas) -- retrouve le fichier JSON de
    fingerprint persistant écrit par camoufox_demarrer_navigateur (cf.
    _camoufox_chemin_fingerprint) pour ce même profil. None accepté (get_
    fingerprint répond alors ok=False plutôt que planter).

    `gestion`/`etat_navigateur` (PATCH pilotage à distance complet, retour
    utilisateur : "vas-y implémente tout") -- mêmes objets que ceux
    retournés par camoufox_demarrer_navigateur (cf. _main_async_camoufox,
    qui les transmet tels quels ici), nécessaires pour déléguer TOUTE
    action de pilotage (hors shutdown/get_fingerprint/get_fingerprint_reel,
    déjà gérées directement ci-dessous) à _executer_commande_camoufox --
    exactement les mêmes objets que ceux passés à _executer_commande côté
    client nodriver (browser/etat_navigateur), adaptés au vocabulaire
    Camoufox/Playwright (context + gestion des onglets).

    PATCH (retour utilisateur explicite : "ajoute la couche de
    robustesse") -- les actions de pilotage (tout sauf shutdown/
    get_fingerprint/get_fingerprint_reel, qui restent traitées
    directement ici comme avant) passent désormais par une asyncio.Queue
    + une Task consommatrice dédiée (_consommer_file_commandes_camoufox),
    exactement comme _recevoir_messages_serveur/_consommer_file_commandes
    côté client nodriver -- même mécanisme de timeout par tranches et de
    'cancel_pending' (cf. leurs docstrings respectives pour la genèse
    complète). _ecouter_serveur ci-dessous ne fait plus qu'empiler ces
    commandes et boucler immédiatement, sans jamais bloquer la lecture du
    WebSocket sur une commande Playwright lente."""
    await ws.send(json.dumps({"type": "register", "role": "instance", "id": instance_id, "pid": os.getpid()}))
    log.info(f"Instance Camoufox '{instance_id}' connectée au serveur, enregistrement en cours... (PID {os.getpid()})")

    # PATCH (couche de robustesse) -- mêmes rôles que file_commandes/
    # etat_annulation/tache_consommateur dans _recevoir_messages_serveur
    # (client nodriver) : file FIFO des commandes de pilotage en attente,
    # dict partagé exposant la Task actuellement en cours d'exécution (pour
    # que 'cancel_pending' puisse l'annuler sans passer par la file, cf.
    # _consommer_file_commandes_camoufox), et la Task séparée qui consomme
    # cette file en tâche de fond pendant toute la durée de vie de la
    # session (annulée dans le bloc finally de cette fonction, plus bas).
    file_commandes: asyncio.Queue = asyncio.Queue()
    etat_annulation: dict = {"tache_courante": None, "requete_id_courante": None}
    # PATCH (demande utilisateur explicite : "tant que c'est pas fini, on
    # ne doit même pas considérer ceux qui arrivent, donc ils sont
    # directement rejetés même si le [premier] scroll finit [entre-temps],
    # c'est quand le scroll n'est pas en cours [au moment de la réception]
    # que si quelqu'un vient on l'exécute") -- flag partagé, mis à jour
    # UNIQUEMENT par _consommer_file_commandes_camoufox (juste avant/après
    # l'exécution réelle de "scroll_simple", cf. plus bas), lu par
    # _ecouter_serveur pour rejeter IMMÉDIATEMENT à la réception (avant
    # même file_commandes.put_nowait) tout "scroll_simple" qui arrive
    # pendant qu'un autre est en cours -- volontairement PAS une simple
    # file FIFO (qui empilerait/exécuterait quand même, en retard) : le
    # rejet est décidé au moment de la réception, pas de l'exécution.
    etat_scroll_simple: dict = {"en_cours": False}
    tache_consommateur = asyncio.ensure_future(
        _consommer_file_commandes_camoufox(file_commandes, ws, instance_id, context, gestion, etat_navigateur, arret_demande, etat_annulation, etat_scroll_simple)
    )

    async def _ecouter_serveur() -> None:
        # LOG DIAGNOSTIC (demande utilisateur explicite : logs détaillés à
        # tous les niveaux) -- confirme, message par message, que le socket
        # WebSOCKET de CETTE instance reçoit bien des données brutes AVANT
        # tout parsing/dispatch. Sans ce log, un message jamais reçu ici
        # (perdu en amont : côté pilote/_envoyer_async, ou côté serveur/
        # srv_gerer_command) et une instance qui reçoit le message mais se
        # bloque ENSUITE (dans _executer_commande_camoufox, par exemple sur
        # un page.evaluate() qui ne revient jamais) produisent EXACTEMENT
        # le même symptôme observé côté pilote (timeout après N secondes,
        # aucune autre info) -- ce log seul permet de trancher entre les
        # deux en un coup d'oeil sur les logs de l'instance.
        log.debug(f"[camoufox] _ecouter_serveur() : en attente de messages pour '{instance_id}'...")
        async for brut in ws:
            debut_traitement = _horloge()
            data = json.loads(brut)
            type_message = data.get("type")
            # CORRECTIF (retour utilisateur explicite : "trop de logs
            # redondants") -- set_fps/set_streaming sont des commandes de
            # routine relayées à chaque clic Rafraîchir/Automatique
            # (dédupliquées côté sAutoniax, cf. _sur_regler_capture_
            # instance_demande, mais restent plus fréquentes que le
            # pilotage réel) -- passées en debug, comme les autres points
            # de cette même chaîne de relais (émission pilote, serveur).
            action_msg_recu = data.get("action")
            if type_message == "command" and action_msg_recu in ("set_fps", "set_streaming"):
                log.debug(
                    f"[camoufox] _ecouter_serveur() : message BRUT reçu pour '{instance_id}' -- "
                    f"type={type_message!r} action={action_msg_recu!r} requete_id={data.get('requete_id')!r}"
                )
            else:
                # DÉSACTIVÉ (demande explicite utilisateur : "logs les
                # plus bruyants" -- cf. analyse logs.txt, ~615
                # occurrences pour ce seul point de trace) -- passé en
                # debug plutôt que supprimé : reste réactivable via la
                # config du logger si besoin de diagnostic futur, sans
                # polluer la sortie normale (niveau INFO).
                log.debug(
                    f"[camoufox] _ecouter_serveur() : message BRUT reçu pour '{instance_id}' -- "
                    f"type={type_message!r} action={action_msg_recu!r} requete_id={data.get('requete_id')!r}"
                )
            if type_message == "registered":
                log.info(f"Instance Camoufox '{instance_id}' : enregistrement confirmé par le serveur.")
            elif type_message == "command":
                action = data.get("action")
                if action == "set_fps":
                    # STREAMING IMPLÉMENTÉ (cf. _boucle_streaming_frames_camoufox
                    # plus haut) -- même traitement que côté nodriver
                    # (_recevoir_messages_serveur) : traité DIRECTEMENT ici,
                    # jamais mis en file (pas d'aller-retour Playwright à
                    # attendre, juste une valeur locale à mettre à jour).
                    nouveau_fps = max(FPS_MIN, min(FPS_MAX, int(data.get("fps", FPS_DEFAUT))))
                    etat_stream["fps"] = nouveau_fps
                    log.debug(f"[camoufox] FPS mis à jour -> {nouveau_fps} (requete_id={data.get('requete_id')!r})")
                elif action == "set_streaming":
                    etat_stream["actif"] = bool(data.get("actif", True))
                    log.debug(
                        f"[camoufox] Streaming {'repris' if etat_stream['actif'] else 'mis en pause'} "
                        f"(requete_id={data.get('requete_id')!r})"
                    )
                    # CORRECTIF (demande explicite utilisateur, cf. le même
                    # correctif côté nodriver plus haut dans ce fichier) :
                    # annule immédiatement la capture en vol (si une l'est)
                    # dès réception de actif=False, plutôt que de laisser
                    # _boucle_streaming_frames_camoufox attendre son terme
                    # naturel avant de vérifier le flag.
                    if not etat_stream["actif"]:
                        tache_capture_courante = etat_stream.get("tache_capture_courante")
                        if tache_capture_courante is not None and not tache_capture_courante.done():
                            tache_capture_courante.cancel()
                            log.debug(
                                f"[camoufox] set_streaming(actif=False) : capture en vol annulée immédiatement "
                                f"pour '{instance_id}'"
                            )
                elif action == "cancel_pending":
                    # PATCH (couche de robustesse) -- même traitement que
                    # côté nodriver (cf. _recevoir_messages_serveur) :
                    # JAMAIS mis dans file_commandes (une commande
                    # d'annulation mise en file attendrait son tour
                    # derrière la commande bloquée qu'elle est censée
                    # couper). Envoyée par le serveur (cf. srv_gerer_unlink)
                    # quand le pilote qui tenait cette instance s'en
                    # détache -- annule la Task en cours dans
                    # _consommer_file_commandes_camoufox (si une commande
                    # Playwright est effectivement en cours) ET vide le
                    # reste de la file.
                    tache_en_cours = etat_annulation.get("tache_courante")
                    requete_annulee = etat_annulation.get("requete_id_courante")
                    if tache_en_cours is not None and not tache_en_cours.done():
                        tache_en_cours.cancel()
                        log.info(
                            f"[camoufox] cancel_pending reçu pour '{instance_id}' -- annulation de la commande "
                            f"en cours (requete_id={requete_annulee!r})"
                        )
                    else:
                        log.info(f"[camoufox] cancel_pending reçu pour '{instance_id}' -- aucune commande en cours à annuler")
                    nb_purgees = 0
                    while not file_commandes.empty():
                        try:
                            file_commandes.get_nowait()
                            file_commandes.task_done()
                            nb_purgees += 1
                        except asyncio.QueueEmpty:
                            break
                    if nb_purgees:
                        log.info(f"[camoufox] cancel_pending pour '{instance_id}' -- {nb_purgees} commande(s) en attente purgée(s) de la file")
                elif action == "shutdown":
                    # BUG CORRIGÉ AVANT LIVRAISON : sans ce cas explicite,
                    # "shutdown" tombait dans la branche générique ci-dessous
                    # (command_result ok=False, jamais d'arrêt déclenché) --
                    # le bouton "Arrêter" du Dashboard (cf.
                    # _fermer_instance_orpheline_bloquant, qui envoie
                    # exactement {"type": "command", "action": "shutdown",
                    # ...} par ce même canal WebSocket) n'aurait alors JAMAIS
                    # fonctionné pour une instance Camoufox -- même
                    # sémantique que la branche "shutdown" équivalente dans
                    # _executer_commande_camoufox, traitée ici directement
                    # (comme set_fps/set_streaming côté nodriver) plutôt que
                    # via la file : déclenche arret_demande, confirme la
                    # RÉCEPTION (pas la fermeture elle-même, qui a lieu dans
                    # _main_async_camoufox après sortie de cette boucle).
                    log.info(f"Instance Camoufox '{instance_id}' : action 'shutdown' reçue -- déclenchement de l'arrêt propre.")
                    arret_demande.set()
                    await ws.send(json.dumps({
                        "type": "command_result", "instance_id": instance_id, "action": action,
                        "requete_id": data.get("requete_id"),
                        "ok": True, "result": None,
                    }))
                elif action == "get_fingerprint":
                    # PATCH (demande utilisateur explicite : onglet
                    # "Propriétés" du Dashboard -- afficher les données
                    # générées automatiquement par BrowserForge/geoip
                    # pour l'instance sélectionnée). Relit le JSON déjà
                    # écrit sur disque par camoufox_demarrer_navigateur
                    # (cf. _camoufox_chemin_fingerprint) -- ne régénère
                    # RIEN ici, uniquement une lecture, pour ne jamais
                    # faire dériver le fingerprint réellement utilisé par
                    # CETTE instance déjà lancée.
                    chemin_fp = _camoufox_chemin_fingerprint(profil)
                    if chemin_fp is None or not chemin_fp.exists():
                        log.warning(
                            f"Instance Camoufox '{instance_id}' : get_fingerprint demandé mais "
                            f"aucun fichier de fingerprint trouvé pour le profil '{profil}'."
                        )
                        await ws.send(json.dumps({
                            "type": "command_result", "instance_id": instance_id, "action": action,
                            "requete_id": data.get("requete_id"),
                            "ok": False,
                            "error": "Aucun fingerprint enregistré pour ce profil (relancez l'instance).",
                        }))
                    else:
                        try:
                            opts_from_options = json.loads(chemin_fp.read_text(encoding="utf-8"))
                            # CORRECTIF (rétro-compatibilité affichage) --
                            # un fingerprint sauvegardé AVANT le patch
                            # "langue automatique" (cf. _camoufox_forcer_
                            # langue_navigateur) n'a jamais navigator.
                            # language/navigator.languages dans son JSON.
                            # Sans ce forçage ICI aussi, l'onglet Propriétés
                            # afficherait encore l'ancienne valeur ("-" ou
                            # langue sans région) tant que l'instance n'est
                            # pas relancée -- même si camoufox_demarrer_
                            # navigateur() répare déjà le fichier disque à
                            # la prochaine relance (cf. son propre appel à
                            # cette même fonction). ATTENTION : ceci ne
                            # corrige que L'AFFICHAGE et LE FICHIER DISQUE
                            # -- le navigateur Playwright de CETTE instance,
                            # déjà lancé, tourne toujours avec l'ancien
                            # navigator.language (fixé une fois pour toutes
                            # au démarrage du process, cf. context_options
                            # dans camoufox/fingerprints.py -- aucune API
                            # ne permet de le changer à chaud). D'où le
                            # log explicite ci-dessous plutôt qu'un silence
                            # qui laisserait croire que l'instance en cours
                            # est déjà corrigée.
                            config_avant = json.dumps(opts_from_options.get("config") or {}, sort_keys=True)
                            opts_from_options = _camoufox_forcer_langue_navigateur(opts_from_options)
                            config_apres = json.dumps(opts_from_options.get("config") or {}, sort_keys=True)
                            if config_apres != config_avant:
                                log.info(
                                    f"Instance Camoufox '{instance_id}' : fingerprint réparé "
                                    f"(navigator.language/languages ajoutés rétroactivement, "
                                    f"profil '{profil}') -- RELANCEZ l'instance pour que le "
                                    f"navigateur en cours utilise réellement cette langue, "
                                    f"l'affichage seul ne suffit pas."
                                )
                                try:
                                    chemin_fp.write_text(
                                        json.dumps(opts_from_options, indent=2), encoding="utf-8"
                                    )
                                except OSError as exc_ecriture:
                                    log.warning(
                                        f"Instance Camoufox '{instance_id}' : échec de "
                                        f"réécriture du fingerprint réparé ({exc_ecriture!r})."
                                    )
                            proprietes = _camoufox_extraire_proprietes_fingerprint(opts_from_options)
                            # PATCH (demande utilisateur explicite :
                            # "pourquoi on ne montre pas l'adresse ip que
                            # j'utilise ? c'est ça l'adresse du proxy ?")
                            # -- "Adresse du proxy" ci-dessus n'est que le
                            # serveur de connexion, pas forcément l'IP de
                            # sortie réellement vue par les sites (proxy
                            # résidentiel/rotatif notamment). Mesurée ICI,
                            # au travers de la page COURANTE (donc via le
                            # proxy configuré sur CE contexte), jamais
                            # côté process Python (cf. docstring de
                            # _camoufox_obtenir_ip_publique_via_page).
                            # PATCH (pilotage à distance complet, retour
                            # utilisateur : "vas-y implémente tout") --
                            # etat_navigateur["page"], PAS le paramètre
                            # local `page` (qui reste figé sur l'onglet
                            # ouvert au tout premier lancement) : switchTab/
                            # newTab/resetInterface, désormais réellement
                            # branchées via _executer_commande_camoufox,
                            # peuvent changer l'onglet actif après coup --
                            # utiliser `page` directement ici aurait mesuré
                            # l'IP sur un onglet potentiellement obsolète
                            # (ou fermé) plutôt que celui réellement affiché.
                            proprietes["Adresse IP publique (via proxy)"] = (
                                await _camoufox_obtenir_ip_publique_via_page(etat_navigateur.get("page", page))
                                or "Indisponible (requête réseau échouée ou proxy injoignable)"
                            )
                            await ws.send(json.dumps({
                                "type": "command_result", "instance_id": instance_id, "action": action,
                                "requete_id": data.get("requete_id"),
                                "ok": True, "result": proprietes,
                            }))
                        except (OSError, ValueError) as exc:
                            log.warning(
                                f"Instance Camoufox '{instance_id}' : lecture du fingerprint "
                                f"échouée ({exc!r})."
                            )
                            await ws.send(json.dumps({
                                "type": "command_result", "instance_id": instance_id, "action": action,
                                "requete_id": data.get("requete_id"),
                                "ok": False,
                                "error": f"Lecture du fingerprint impossible ({exc!r}).",
                            }))
                elif action == "get_fingerprint_reel":
                    # PATCH (demande utilisateur explicite : sous-onglet
                    # "Réel" du panneau Propriétés, pour comparaison avec
                    # le fictif ci-dessus) -- symétrique de get_fingerprint,
                    # mais lit les propriétés RÉELLES de la machine hôte
                    # (cf. _reel_extraire_proprietes_machine : platform/
                    # locale/os, plus une requête IP publique directe hors
                    # proxy Camoufox). Contrairement à get_fingerprint, rien
                    # n'est lu sur disque -- tout est mesuré à la volée à
                    # chaque appel (la machine ne change pas de fingerprint
                    # persistant, donc pas de notion de "régénération" ici).
                    # Peut être lent (jusqu'à ~4s, cf. timeout_s de
                    # _reel_obtenir_ip_publique) : n'exécute PAS
                    # d'action_reset_interface/navigation, donc ne bloque
                    # aucune autre action métier pendant cette attente
                    # (juste cette boucle _ecouter_serveur, comme
                    # get_fingerprint avant elle).
                    try:
                        proprietes_reelles = _reel_extraire_proprietes_machine()
                        await ws.send(json.dumps({
                            "type": "command_result", "instance_id": instance_id, "action": action,
                            "requete_id": data.get("requete_id"),
                            "ok": True, "result": proprietes_reelles,
                        }))
                    except Exception as exc:
                        # Défensif large (contrairement à get_fingerprint,
                        # ici aucune E/S fichier connue à l'avance -- platform/
                        # locale peuvent lever des erreurs plateforme-
                        # spécifiques imprévues) : ne jamais laisser cette
                        # boucle _ecouter_serveur crasher pour un champ de
                        # présentation.
                        log.warning(
                            f"Instance Camoufox '{instance_id}' : lecture des propriétés "
                            f"réelles échouée ({exc!r})."
                        )
                        await ws.send(json.dumps({
                            "type": "command_result", "instance_id": instance_id, "action": action,
                            "requete_id": data.get("requete_id"),
                            "ok": False,
                            "error": f"Lecture des propriétés réelles impossible ({exc!r}).",
                        }))
                else:
                    # PATCH (demande utilisateur explicite : "tant que
                    # c'est pas fini, on ne doit même pas considérer
                    # ceux qui arrivent, donc ils sont directement
                    # rejetés même si le scroll finit [entre-temps],
                    # c'est quand le scroll n'est pas en cours [au
                    # moment de la réception] que si quelqu'un vient on
                    # l'exécute") -- rejet IMMÉDIAT à la réception, PAS
                    # une histoire de file : si un "scroll_simple" est
                    # déjà en cours d'exécution (etat_scroll_simple,
                    # mis à jour par _consommer_file_commandes_camoufox),
                    # tout nouveau "scroll_simple" reçu ici est jeté sur
                    # -le-champ (aucun file_commandes.put_nowait), sans
                    # attendre que le précédent se termine. Seul
                    # "scroll_simple" est concerné -- toutes les autres
                    # actions (dont l'ancienne "scroll" humanisée)
                    # continuent d'être mises en file normalement,
                    # ci-dessous, sans changement.
                    if (
                        action == "scroll_simple"
                        and etat_scroll_simple is not None
                        and etat_scroll_simple.get("en_cours")
                    ):
                        log.info(
                            f"[camoufox] _ecouter_serveur() : 'scroll_simple' (requete_id="
                            f"{data.get('requete_id')!r}) REJETÉ -- un scroll_simple est déjà "
                            f"en cours d'exécution"
                        )
                        await ws.send(json.dumps({
                            "type": "command_result", "instance_id": instance_id, "action": action,
                            "requete_id": data.get("requete_id"),
                            "ok": False,
                            "error": "scroll_simple ignoré : un scroll est déjà en cours",
                        }))
                        continue
                    # BUG DE FOND CORRIGÉ (demande utilisateur explicite,
                    # suite à diagnostic de latence : "mouse move sa perd
                    # extremement du temps", "je sens une enorme latence")
                    # -- AVANT ce correctif, cette branche appelait
                    # `await _executer_commande_camoufox(...)` ICI MÊME,
                    # DIRECTEMENT DANS `_ecouter_serveur` (la boucle
                    # `async for brut in ws`) : pendant toute la durée
                    # d'une action lente (ex: mousemove humanisé, 20-40s
                    # pour un déplacement court -- cf. logs [trajectoire]/
                    # action_camoufox_mousemove ajoutés plus haut), cette
                    # boucle était bloquée sur ce seul `await` et ne
                    # pouvait lire AUCUN autre message entrant -- pas
                    # 'cancel_pending', pas la commande suivante, rien --
                    # d'où la latence/les "instants d'inactivité" observés
                    # entre deux actions consécutives.
                    #
                    # `file_commandes` (asyncio.Queue) et sa Task
                    # consommatrice `_consommer_file_commandes_camoufox`
                    # (cf. plus haut dans cette fonction) existaient déjà
                    # dans ce fichier, PRÊTES À L'EMPLOI (file FIFO,
                    # timeout par tranche avec logs de progression,
                    # intégration à `etat_annulation` pour que
                    # cancel_pending puisse annuler la commande EN COURS
                    # sans attendre) -- mais n'étaient JAMAIS alimentées :
                    # `file_commandes.put_nowait` n'apparaissait que dans
                    # la définition de _consommer_file_commandes_camoufox
                    # elle-même, jamais appelé depuis _ecouter_serveur.
                    # Résultat : la Task consommatrice tournait pour rien,
                    # en attente perpétuelle sur une file vide, pendant que
                    # cette branche `else` exécutait tout en direct.
                    #
                    # Correctif : on empile simplement `data` dans
                    # `file_commandes` et on repart IMMÉDIATEMENT lire le
                    # message WebSocket suivant -- exactement le même
                    # partage `file_commandes`/`_recevoir_messages_serveur`
                    # que côté nodriver (cf. _recevoir_messages_serveur,
                    # qui ne fait elle non plus qu'empiler ici). Le
                    # traitement réel (exécution + envoi du command_result)
                    # a lieu dans _consommer_file_commandes_camoufox, sur
                    # sa propre Task, sans bloquer la réception.
                    # DÉSACTIVÉ (demande explicite utilisateur : "logs les
                    # plus bruyants" -- cf. analyse logs.txt) -- passé en
                    # debug, réactivable via la config du logger. Fait
                    # doublon avec "message BRUT reçu" (au-dessus) et
                    # "Commande reçue -- exécution" (déjà désactivés).
                    log.debug(
                        f"[camoufox] _ecouter_serveur() : action '{action}' (requete_id="
                        f"{data.get('requete_id')!r}) mise en file (file_commandes) -- "
                        f"{file_commandes.qsize()} déjà en attente -- reprise immédiate de "
                        f"la lecture du WebSocket"
                    )
                    file_commandes.put_nowait(data)
            elif type_message == "error":
                # cf. EnregistrementRefuse, même traitement que côté
                # nodriver (_recevoir_messages_serveur) : un register
                # refusé rend cette connexion morte, on lève pour forcer
                # une reconnexion plutôt que rester zombie.
                log.error(
                    f"Instance Camoufox '{instance_id}' : erreur reçue du serveur -- {data.get('message')!r} "
                    f"-- connexion considérée morte, fermeture pour déclencher une reconnexion"
                )
                raise EnregistrementRefuse(str(data.get("message")))
            # LOG DIAGNOSTIC : durée du DISPATCH de ce message dans
            # _ecouter_serveur elle-même (hors exécution de l'action pour
            # les commandes mises en file, qui a désormais lieu ailleurs,
            # sur _consommer_file_commandes_camoufox -- cf. correctif
            # ci-dessus). Doit rester de l'ordre de la milliseconde en
            # permanence : une valeur élevée ici signalerait une
            # RÉGRESSION future (une branche qui recommencerait à bloquer
            # cette boucle), donc à surveiller si la latence revient.
            duree_dispatch = _horloge() - debut_traitement
            if duree_dispatch > 0.5:
                log.warning(
                    f"[camoufox] _ecouter_serveur() : dispatch anormalement lent -- "
                    f"{duree_dispatch:.3f}s pour type={type_message!r} action="
                    f"{data.get('action')!r} (devrait être ~instantané -- régression possible "
                    f"si une branche s'est remise à bloquer sur du travail long)"
                )

    async def _detecter_fermeture_navigateur() -> None:
        # Pas d'équivalent direct à "browser.stopped" (nodriver) exposé
        # simplement côté Playwright/Camoufox pour un persistent_context --
        # on sonde périodiquement context.pages : un contexte persistant
        # fermé (fenêtre fermée manuellement) lève sur le premier accès
        # à .pages, qu'on traduit en NavigateurFermeCamoufox, cohérent
        # avec le reste du client Camoufox (cf. _camoufox_relever_si_fermeture).
        while True:
            await asyncio.sleep(1.0)
            try:
                _ = context.pages
            except Exception as exc:
                _camoufox_relever_si_fermeture(exc)
                # Erreur non reconnue comme une fermeture (cf.
                # _camoufox_est_erreur_fermeture) : par prudence, on la
                # traite quand même comme une fermeture ici -- un contexte
                # dont .pages lève N'IMPORTE QUELLE exception n'est de
                # toute façon plus pilotable normalement.
                raise NavigateurFermeCamoufox(str(exc)) from exc

    tache_ecoute = asyncio.ensure_future(_ecouter_serveur())
    tache_streaming = asyncio.ensure_future(_boucle_streaming_frames_camoufox(ws, etat_navigateur, instance_id, etat_stream))
    tache_surveillance = asyncio.ensure_future(_detecter_fermeture_navigateur())
    tache_arret = asyncio.ensure_future(arret_demande.wait())

    try:
        termine, en_attente = await asyncio.wait(
            [tache_ecoute, tache_streaming, tache_surveillance, tache_arret], return_when=asyncio.FIRST_COMPLETED,
        )
        for tache in en_attente:
            tache.cancel()
        for tache in termine:
            if tache is tache_arret:
                log.info(f"Instance Camoufox '{instance_id}' : arrêt demandé -> fermeture propre")
                return "arret_demande"
            exception = tache.exception() if not tache.cancelled() else None
            if isinstance(exception, NavigateurFermeCamoufox):
                log.info(f"Instance Camoufox '{instance_id}' : navigateur fermé -> fermeture de la connexion au serveur")
                return "navigateur_ferme"
            elif isinstance(exception, (ConnectionError, websockets.exceptions.ConnectionClosed)):
                log.warning(f"Instance Camoufox '{instance_id}' : connexion au serveur perdue -> reconnexion automatique dans 5s")
                return "connexion_perdue"
            elif isinstance(exception, EnregistrementRefuse):
                log.warning(
                    f"Instance Camoufox '{instance_id}' : register refusé par le serveur ({exception}) "
                    f"-> reconnexion automatique dans 5s"
                )
                return "connexion_perdue"
            elif exception is not None and not isinstance(exception, asyncio.CancelledError):
                log.error(f"Instance Camoufox '{instance_id}' : exception inattendue -> {exception!r}")
                raise exception
        return "connexion_perdue"
    finally:
        log.info(f"Instance Camoufox '{instance_id}' : _session_camoufox_minimale -- fin de session")
        tache_ecoute.cancel()
        tache_streaming.cancel()
        tache_surveillance.cancel()
        tache_arret.cancel()
        # CORRECTIF (bug scroll x2 en parallèle) -- symétrique EXACT au
        # correctif déjà existant côté nodriver (cf. _recevoir_messages_serveur,
        # finally : "tache_consommateur.cancel()"). Sans ce bloc,
        # tache_consommateur (créée plus haut, juste avant _ecouter_serveur)
        # n'était JAMAIS annulée à la sortie de cette fonction -- à chaque
        # reconnexion, une nouvelle file_commandes + un nouveau
        # _consommer_file_commandes_camoufox étaient recréés sans que
        # l'ancien consommateur soit arrêté, laissant plusieurs Task
        # consommatrices actives en parallèle sur le même context/gestion
        # Playwright : deux commandes (ex. deux scroll consécutifs) pouvaient
        # alors s'exécuter en même temps au lieu d'être strictement FIFO,
        # exactement le symptôme observé dans les logs ("positionnement
        # initial" x2 avant "TERMINÉ" x2).
        tache_consommateur.cancel()
        try:
            await tache_consommateur
        except (asyncio.CancelledError, ConnectionError, websockets.exceptions.ConnectionClosed):
            pass


async def _main_async_camoufox(
    instance_id: str, server_url: str, profil: Optional[str],
    url_ouverture: Optional[str], download_dir: Optional[str], proxy: Optional[dict],
    headless: bool = False, nom_profil: Optional[str] = None,
    moteur: str = "camoufox",
) -> None:
    """Équivalent Camoufox de _main_async (client nodriver/CDP) -- chemin
    séparé, cf. commentaire d'appel dans _main_async pour la justification.
    Lance via camoufox_demarrer_navigateur (fingerprint robuste OS/
    humanize/geoip construit par _camoufox_construire_config_lancement,
    persisté par profil via camoufox.utils.launch_options -- cf. CORRECTIF
    dans la docstring de camoufox_demarrer_navigateur), boucle de
    reconnexion identique en substance à _main_async
    (mêmes noms de variables/mêmes délais, pour rester comparable), et ferme
    proprement le context manager Camoufox (camoufox_cm.__aexit__) en sortie
    -- symétrique à browser.stop() côté nodriver."""
    log.info(f"[DIAG paste] _main_async_camoufox() : DÉMARRAGE instance_id={instance_id!r}")

    camoufox_cm, context, page, gestion, etat_navigateur = await camoufox_demarrer_navigateur(
        profil, instance_id, url_ouverture, download_dir, headless=headless, proxy=proxy,
        # CORRECTIF (toggle "bloquer médias" -- volet Camoufox) : le NOM du
        # profil (clé de profils_config.json) descend maintenant jusqu'au
        # contexte Playwright, seul moyen d'y relire le toggle à chaud --
        # `profil` juste au-dessus est le CHEMIN du dossier, les deux ne
        # sont pas interchangeables (cf. l'aide de --nom-profil).
        nom_profil=nom_profil, moteur=moteur,
    )

    # CORRECTIF (DIAG 6/7 -- trou de ~6s trouvé sur le premier mousemove
    # d'une instance fraîche : _precharger_banques_mouvement() existait déjà,
    # documentée pour être lancée ici "en parallèle du lancement du
    # navigateur" (cf. sa propre docstring), mais n'était en réalité JAMAIS
    # appelée nulle part dans tout le fichier -- TrajectoryBank.build()
    # (lecture SQLite + numpy/scipy + KDTree, CPU-bound, synchrone) se
    # déclenchait donc au premier mousemove/click/scroll réel, dans la
    # boucle asyncio, AVANT le chrono debut_generation de
    # action_camoufox_mousemove (donc invisible dans ses propres logs
    # [trajectoire]/[camoufox] -- d'où l'écart overhead=0.5s vs
    # écart_total=+6.7s observé en DIAG 6). asyncio.create_task (PAS await) :
    # tâche de fond, absorbée pendant la boucle de reconnexion qui suit,
    # jamais bloquante pour le démarrage de l'instance elle-même.
    asyncio.create_task(_precharger_banques_mouvement())

    # État mutable du streaming, partagé entre _boucle_streaming_frames_camoufox
    # et _ecouter_serveur (cf. traitement de set_fps/set_streaming) -- mêmes
    # clés/mêmes valeurs initiales que côté nodriver (cf. _main_async,
    # ~ligne 42265) : actif DÉMARRE À FALSE, le streaming ne s'active que sur
    # réception explicite de {"action": "set_streaming", "actif": true}
    # depuis le GUI (bouton Rafraîchir / case Automatique), jamais tout seul.
    # "tache_capture_courante" : référence la tâche asyncio de capture en
    # vol (si une l'est), pour que le handler set_streaming puisse
    # l'annuler immédiatement au lieu d'attendre son terme naturel (cf.
    # correctif "mode manuel bloque tout" dans _boucle_streaming_frames_
    # camoufox et le handler set_streaming plus bas).
    etat_stream = {"fps": FPS_DEFAUT, "actif": False, "tache_capture_courante": None}

    arret_demande = asyncio.Event()

    def _demander_arret(*_):
        log.info("Signal d'arrêt reçu.")
        arret_demande.set()

    try:
        loop = asyncio.get_running_loop()
        loop.add_signal_handler(signal.SIGTERM, _demander_arret)
        loop.add_signal_handler(signal.SIGINT, _demander_arret)
    except NotImplementedError:
        signal.signal(signal.SIGINT, _demander_arret)

    # Même logique de reconnexion automatique que _main_async (cf. sa
    # docstring/ses commentaires pour la justification complète) --
    # dupliquée plutôt que factorisée : les deux boucles appellent une
    # fonction de session différente (_session_camoufox_minimale vs
    # _session_connexion_serveur) avec une signature différente, factoriser
    # aurait demandé une indirection supplémentaire pour un gain minime.
    DELAI_RECONNEXION_S = 5
    while True:
        try:
            async with websockets.connect(server_url, max_size=None) as ws:
                etat_stream["actif"] = False   # CORRECTIF : après une coupure, le pilote ne sait plus ce qui est allumé -> flux éteint par défaut (il se rallume sur demande explicite)
                cause = await _session_camoufox_minimale(ws, instance_id, context, page, gestion, etat_navigateur, etat_stream, arret_demande, profil)
        except (ConnectionError, websockets.exceptions.ConnectionClosed, OSError) as e:
            log.warning(f"Instance Camoufox '{instance_id}' : connexion au serveur impossible ({e!r}) -> nouvelle tentative dans {DELAI_RECONNEXION_S}s")
            cause = "connexion_perdue"

        if cause == "arret_demande" or cause == "navigateur_ferme":
            break
        try:
            await asyncio.wait_for(arret_demande.wait(), timeout=DELAI_RECONNEXION_S)
            log.info("Instance Camoufox : arrêt demandé pendant l'attente de reconnexion -> fermeture propre")
            break
        except asyncio.TimeoutError:
            pass

    # Fermeture propre du contexte persistant Camoufox -- symétrique à
    # browser.stop() côté nodriver (cf. _main_async). __aexit__ attend
    # (None, None, None) comme un `async with` normal en sortie sans
    # exception -- cf. signature standard d'un __aexit__ de context manager.
    try:
        await camoufox_cm.__aexit__(None, None, None)
    except Exception as e:
        log.debug(f"Fermeture du navigateur Camoufox ignorée (probablement déjà fermé) : {e!r}")


async def _main_async(instance_id: str, server_url: str, navigateur: str, executable: str | None, profil: str | None, url_ouverture: str | None = None, download_dir: str | None = None, proxy: Optional[dict] = None, headless: bool = False, nom_profil: Optional[str] = None):
    log.info(f"[DIAG paste] _main_async() : DÉMARRAGE instance_id={instance_id!r} -- si cette ligne n'apparaît jamais côté AutoniaX, le relais stdout de l'instance est cassé")
    if profil is None:
        # Aucun --profil explicite fourni (ne devrait plus arriver depuis
        # DashboardScreen, qui passe toujours --profil avec le dossier du
        # profil nommé sélectionné -- cf. _on_clic_lancer_ou_arreter) --
        # filet de sécurité : retombe sur un profil nommé "défaut" plutôt
        # que planter, via le même registre persistant que les profils
        # nommés depuis l'UI (cf. creer_ou_obtenir_profil). Ce dossier
        # n'est JAMAIS recopié ni supprimé : la première fois, le
        # navigateur y démarre vierge (l'utilisateur se connecte alors
        # manuellement, une fois, à chaque site voulu, via l'aperçu de
        # l'instance) ; ensuite, les sessions établies persistent d'un
        # lancement à l'autre puisque le dossier reste physiquement le
        # même sur disque -- jamais une copie du profil réel de
        # l'utilisateur (abandonné : une session copiée depuis un autre
        # contexte est détectée comme suspecte par les mécanismes de
        # liaison de session de certains sites).
        _, profil = creer_ou_obtenir_profil("défaut")

    # PATCH (demande utilisateur explicite : "es ce que tu peu modifer
    # l'app de tels sorte que les profisl camoufox se lance correctement")
    # -- chemin ENTIÈREMENT séparé pour Camoufox, plutôt que de complexifier
    # le chemin nodriver/CDP existant ci-dessous avec des `if navigateur ==
    # ...` dispersés partout (browser/page CDP et context/page Playwright
    # ne partagent AUCUNE méthode compatible -- browser.stop(),
    # _installer_interception_presse_papier, _session_connexion_serveur
    # entière sont tous spécifiques à nodriver). Le pilotage à distance
    # complet (cf. _executer_commande_camoufox) ET le streaming vidéo (cf.
    # _boucle_streaming_frames_camoufox, set_fps/set_streaming dans
    # _ecouter_serveur) sont désormais implémentés côté Camoufox, à parité
    # fonctionnelle avec le chemin nodriver -- réutilise la même logique de
    # reconnexion automatique (DELAI_RECONNEXION_S, arret_demande) que le
    # chemin nodriver, pour un comportement cohérent entre les deux clients.
    if navigateur in MOTEURS_PLAYWRIGHT:
        # CORRECTIF (toggle "bloquer médias" -- volet Camoufox) : nom_profil
        # n'était PAS transmis à ce chemin, il s'arrêtait à _main_async.
        # C'est une des deux raisons pour lesquelles le toggle n'avait
        # aucun effet sur un profil Camoufox (l'autre étant l'absence pure
        # et simple d'un mécanisme de blocage côté Playwright, cf.
        # camoufox_installer_blocage_media).
        await _main_async_camoufox(instance_id, server_url, profil, url_ouverture, download_dir, proxy, headless=headless, nom_profil=nom_profil, moteur=navigateur)
        return

    # PATCH (demande utilisateur : "des que ça crash, automatiquement on
    # retente 3 fois avant de complètement tuer le process") -- appel via
    # _demarrer_navigateur_avec_reessais au lieu de demarrer_navigateur
    # directement. Si toutes les tentatives échouent, l'exception d'origine
    # est relancée : le comportement final (log "erreur fatale" + sortie du
    # process) est inchangé, il arrive simplement après les réessais.
    browser, page = await _demarrer_navigateur_avec_reessais(navigateur, executable, profil, url_ouverture, instance_id, download_dir, proxy, headless=headless, nom_profil=nom_profil)

    # PATCH (demande utilisateur : mémoriser la géométrie de la fenêtre
    # d'un lancement à l'autre) -- lancée ICI, juste après le démarrage du
    # navigateur et HORS de _session_connexion_serveur : la surveillance
    # doit vivre aussi longtemps que le navigateur lui-même, y compris
    # pendant les phases de reconnexion au serveur (la boucle plus bas
    # relance _session_connexion_serveur, le navigateur, lui, reste).
    # Inutile en headless : pas de vraie fenêtre à mémoriser (la taille
    # vient uniquement de --window-size, jamais d'un déplacement manuel).
    tache_surveillance_geometrie = None

    # CORRECTIF (DIAG 6/7, cf. commentaire symétrique dans
    # _main_async_camoufox pour le détail complet) -- même trou côté
    # nodriver/CDP : _precharger_banques_mouvement() n'était jamais appelée,
    # donc TrajectoireBank.build() se déclenchait au premier mousemove/
    # click/scroll réel, bloquant la boucle asyncio. Branché ici en tâche
    # de fond, au même point relatif (juste après le lancement du
    # navigateur) que côté Camoufox, pour un comportement cohérent entre
    # les deux clients.
    asyncio.create_task(_precharger_banques_mouvement())

    # CORRIGÉ (demande explicite utilisateur : "le rafraîchissement doit
    # être en mode manuel, pas déjà automatique") -- actif DÉMARRE À
    # FALSE : auparavant True par défaut, la boucle de streaming envoyait
    # des frames en continu dès la connexion de l'instance, AVANT même
    # que le Dashboard/GUI n'ait rien demandé (aucun clic sur
    # "Rafraîchir", case "Automatique" toujours décochée) -- cf. logs
    # utilisateur : capture seq=0, 1, 2... qui s'enchaînent immédiatement
    # après "Instance connectée au serveur". _boucle_streaming_frames()
    # reste inactive (sleep 0.1s en boucle, ligne ~13191) tant qu'aucun
    # message {"action": "set_streaming", "actif": true} n'est reçu --
    # envoyé UNIQUEMENT par une action explicite côté GUI (bouton
    # Rafraîchir ponctuel, ou case "Automatique" cochée), cf.
    # PanneauRenduInstance / InstanceApercuScreen.
    # "tache_capture_courante" : référence la tâche asyncio de capture en
    # vol (si une l'est), pour que le handler set_streaming puisse
    # l'annuler immédiatement au lieu d'attendre son terme naturel (cf.
    # correctif "mode manuel bloque tout" dans _boucle_streaming_frames et
    # le handler set_streaming plus bas).
    etat_stream = {"fps": FPS_DEFAUT, "actif": False, "tache_capture_courante": None}
    # État mutable partagé entre le streaming et l'exécution de commandes :
    # "page" pointe toujours vers l'onglet actif du moment (cf. 4.6). Seule
    # action_switch_tab (via _executer_commande) le modifie ; le streaming
    # et toutes les autres actions le lisent sans jamais le mettre en cache
    # localement, pour suivre un changement d'onglet immédiatement.
    etat_navigateur = {"page": page, "presse_papier_virtuel": "", "curseur_x": None, "curseur_y": None,
                        # PATCH (toggle "bloquer médias" par profil, révocable à chaud) --
                        # nom du profil (clé du registre profils_config.json, cf.
                        # obtenir_config_profil), None si --nom-profil absent. Lu par
                        # _synchroniser_blocage_media_profil() à CHAQUE navigation
                        # (cf. action "navigate"/"newTab" de _executer_commande) pour
                        # que le toggle de la carte prime sans redémarrer l'instance.
                        "nom_profil": nom_profil}

    # CORRECTIF (toggle "bloquer médias") -- l'onglet DÉJÀ OUVERT au
    # démarrage de l'instance n'était couvert par rien : la synchro sur
    # rechargement n'était posée que par switchTab/newTab (cf.
    # _executer_commande), donc tant qu'aucun Task n'avait navigué, un F5
    # manuel dans cet onglet-là ignorait purement et simplement le toggle.
    # Deux gestes ici, dans cet ordre : poser le handler de resynchro pour
    # les rechargements à venir, puis aligner TOUT DE SUITE le filtre sur
    # l'état courant du toggle -- sans ce second appel, un profil lancé
    # avec le toggle déjà ON ne bloquait rien avant sa première navigation.
    # Jamais bloquant : un échec ici dégrade le toggle, il ne doit pas
    # empêcher l'instance de démarrer.
    # CORRECTION -- l'ancienne application « initiale sur l'onglet de
    # démarrage » n'existe plus : le gardien (lancé juste en dessous) équipe
    # TOUTES les cibles, y compris celle-ci, et relit l'état persistant AVANT
    # de reprendre la première d'entre elles (SPEC §5.3). Le chemin de repli
    # (gardien indisponible) refait ces deux gestes lui-même.
    etat_navigateur["chemin_profil"] = profil

    # CORRECTIF (toggle "bloquer médias" -- clic sans effet, Chrome/CDP) --
    # boucle de fond qui réaligne le filtre sur TOUS les onglets dès que le
    # toggle change sur disque, et qui équipe les onglets ouverts à la main
    # (cf. _surveiller_toggle_bloquer_media). Lancée aussi en headless : le
    # filtre réseau, lui, n'a rien à voir avec la présence d'une fenêtre.
    tache_surveillance_toggle_media = asyncio.create_task(
        _surveiller_toggle_bloquer_media(browser, etat_navigateur, instance_id, chemin_profil=profil)
    )

    # PATCH (demande utilisateur : mémoriser la géométrie de la fenêtre
    # d'un lancement à l'autre) -- lancée ICI (et non juste après
    # demarrer_navigateur) car elle a besoin d'etat_navigateur : c'est lui
    # qui désigne l'onglet ACTIF réel (cf. _lire_geometrie_fenetre_courante,
    # CORRECTIF -- browser.tabs[0] pouvait être un onglet déjà fermé).
    # HORS de _session_connexion_serveur : la surveillance doit vivre aussi
    # longtemps que le navigateur lui-même, y compris pendant les phases de
    # reconnexion au serveur (la boucle plus bas relance _session_connexion_
    # serveur, le navigateur, lui, reste). Inutile en headless : pas de
    # vraie fenêtre à mémoriser (la taille vient de --window-size seul).
    if not headless:
        tache_surveillance_geometrie = asyncio.create_task(
            _surveiller_geometrie_fenetre(browser, profil, instance_id, etat_navigateur)
        )

    # PATCH (demande utilisateur explicite : "a la fermeture d'un profil
    # chrome, la derniere page soit vraiment restauree") -- même principe et
    # même source (etat_navigateur) que la surveillance de géométrie
    # juste au-dessus, mais SANS la condition `if not headless` : un profil
    # headless a lui aussi une « dernière page » à restaurer à son prochain
    # lancement, ça n'a rien à voir avec la présence d'une fenêtre visible
    # (cf. bloc de commentaires complet juste avant DOSSIER_EXTENSIONS_PROXY).
    tache_surveillance_derniere_url = asyncio.create_task(
        _surveiller_derniere_url(browser, profil, instance_id, etat_navigateur)
    )

    # PATCH (demande utilisateur explicite : "je veux que pardefaut quand
    # on demare une instance le curseur est positionner a une positon
    # aleatoire et non fixe") -- même patch que côté camoufox (cf.
    # _main_async / AsyncCamoufox plus haut dans ce fichier). AVANT ce
    # patch, curseur_x/curseur_y restaient à None jusqu'au tout premier
    # mousemove/click de la session (cf. action_mousemove/action_click :
    # "aucun mousemove n'a encore eu lieu" -> (x, y) demandé lui-même sert
    # de point de départ, trajet de longueur nulle) -- en pratique le
    # tout premier geste partait donc toujours du point cible lui-même,
    # jamais d'une position réellement aléatoire. On tire maintenant ICI,
    # dès le démarrage de l'instance, une position UNIFORME sur toute la
    # surface de l'écran piloté (PAS une constante fixe comme (0, 0) ou
    # le centre -- demande explicite "non fixe"), via Page.getLayoutMetrics
    # (CDP) -- même source que action_get_screen_info, cssLayoutViewport
    # donnant client_width/client_height en pixels CSS, MÊMES unités que
    # les coordonnées x/y attendues par mousemove/click. Défensif par
    # construction (même esprit que les autres blocs try/except de ce
    # fichier) : un échec de lecture des dimensions ne doit jamais
    # empêcher le démarrage de l'instance -- curseur_x/y retombent alors
    # sur None (comportement identique à avant ce patch).
    try:
        _, _, _, _css_layout_viewport, _, _ = await page.send(cdp.page.get_layout_metrics())
        _largeur_ecran = int(_css_layout_viewport.client_width)
        _hauteur_ecran = int(_css_layout_viewport.client_height)
        if _largeur_ecran > 0 and _hauteur_ecran > 0:
            etat_navigateur["curseur_x"] = float(random.randint(0, _largeur_ecran - 1))
            etat_navigateur["curseur_y"] = float(random.randint(0, _hauteur_ecran - 1))
            log.debug(
                f"[nodriver] curseur virtuel initialisé à une position aléatoire "
                f"({etat_navigateur['curseur_x']:.0f}, {etat_navigateur['curseur_y']:.0f}) "
                f"sur un écran de {_largeur_ecran}x{_hauteur_ecran}."
            )
    except Exception as exc:
        log.debug(
            f"[nodriver] échec de la lecture des dimensions d'écran pour positionner "
            f"le curseur virtuel initial ({exc!r}) -- curseur_x/curseur_y restent à "
            f"None, repli sur le comportement d'avant ce patch (premier mousemove/click "
            f"partira de sa propre destination)."
        )

    # Installe l'interception de copie native (execCommand('copy') /
    # navigator.clipboard.writeText) sur le tout premier onglet ouvert au
    # démarrage de l'instance -- sans cet appel, seuls les onglets ouverts
    # ensuite via newTab/resetInterface (cf. 30905/30922) seraient couverts,
    # et le tout premier onglet écrirait ses copies dans le presse-papier
    # OS réel au lieu de etat_navigateur["presse_papier_virtuel"].
    await _installer_interception_presse_papier(page, etat_navigateur)
    # PATCH (toggle "bloquer médias" révocable à chaud) -- même onglet, même
    # moment que l'interception presse-papier ci-dessus.
    await _installer_synchro_blocage_media_sur_rechargement(page, etat_navigateur)

    arret_demande = asyncio.Event()

    def _demander_arret(*_):
        log.info("Signal d'arrêt reçu.")
        arret_demande.set()

    try:
        loop = asyncio.get_running_loop()
        loop.add_signal_handler(signal.SIGTERM, _demander_arret)
        loop.add_signal_handler(signal.SIGINT, _demander_arret)
    except NotImplementedError:
        signal.signal(signal.SIGINT, _demander_arret)

    # Boucle de RECONNEXION AUTOMATIQUE (demande explicite utilisateur) :
    # tant que ni un arrêt volontaire ni une fermeture du navigateur n'a
    # été constatée, une perte de connexion au serveur (serveur arrêté/
    # injoignable) ne ferme PAS le navigateur -- on retente indéfiniment
    # une nouvelle connexion toutes les DELAI_RECONNEXION_S secondes,
    # jusqu'à ce que le serveur revienne (ex: relancement de l'app
    # AutoniaX) et réenregistre cette même instance (même instance_id,
    # cf. "register" dans _session_connexion_serveur), ou jusqu'à ce que
    # le navigateur lui-même soit fermé/l'arrêt soit demandé.
    DELAI_RECONNEXION_S = 5
    while True:
        try:
            async with websockets.connect(server_url, max_size=None) as ws:
                etat_stream["actif"] = False   # CORRECTIF (idem camoufox ci-dessus)
                cause = await _session_connexion_serveur(
                    ws, instance_id, browser, page, etat_navigateur, etat_stream, arret_demande,
                )
        except (ConnectionError, websockets.exceptions.ConnectionClosed, OSError) as e:
            # Échec de websockets.connect() lui-même (serveur pas encore
            # démarré/injoignable) -- même traitement qu'une connexion
            # perdue APRÈS établissement : on retente, navigateur intact.
            log.warning(f"Instance '{instance_id}' : connexion au serveur impossible ({e!r}) -> nouvelle tentative dans {DELAI_RECONNEXION_S}s")
            cause = "connexion_perdue"

        if cause == "arret_demande" or cause == "navigateur_ferme":
            break
        # cause == "connexion_perdue" : le navigateur reste ouvert, on
        # attend puis on reboucle -- SAUF si un arrêt a été demandé
        # entre-temps (ex: pendant l'attente elle-même), auquel cas on
        # sort immédiatement plutôt que d'attendre inutilement 5s de plus.
        try:
            await asyncio.wait_for(arret_demande.wait(), timeout=DELAI_RECONNEXION_S)
            log.info("Instance : arrêt demandé pendant l'attente de reconnexion -> fermeture propre")
            break
        except asyncio.TimeoutError:
            pass  # délai écoulé sans arrêt demandé -> on retente la connexion

    # Fermeture du navigateur lui-même si le process s'arrête pour une autre
    # raison qu'une fermeture manuelle du navigateur (ex: arrêt demandé
    # depuis le Dashboard alors que Chrome tourne encore) -- sans quoi
    # Chrome resterait ouvert, orphelin, après la fin du process instance.
    # N'est atteint QUE sur "arret_demande" ou "navigateur_ferme" (cf.
    # boucle ci-dessus) -- jamais sur une simple perte de connexion au
    # serveur, qui ne quitte jamais la boucle.
    #
    # PATCH (mémorisation de la géométrie) : la surveillance est annulée
    # AVANT browser.stop() -- sinon, pendant la fermeture, elle pourrait
    # lire une géométrie transitoire (fenêtre en cours de destruction) et
    # l'écrire à la place de la dernière bonne valeur.
    if tache_surveillance_geometrie is not None:
        tache_surveillance_geometrie.cancel()
    # Même raison pour la surveillance du toggle médias : ne plus toucher au
    # CDP pendant que le navigateur se ferme.
    tache_surveillance_toggle_media.cancel()
    try:
        browser.stop()
    except Exception as e:
        log.debug(f"Fermeture du navigateur ignorée (probablement déjà fermé) : {e!r}")
    _arreter_feather(instance_id)  # PATCH Feather : ferme aussi la fenêtre Feather (no-op pour Chrome)


# ---------------------------------------------------------------------------
# Serveur central (ex-serveur.py, cf. cahier des charges, sections 3, 5,
# 12.4 point 1) -- FUSIONNÉ dans ce fichier, sur le même principe que le
# mode "instance" plus haut (ex-instance_nodriver.py, cf.
# main_instance_nodriver()) : ce bloc ne dépend d'aucune classe Qt du
# reste du fichier, il ne connaît que le protocole JSON échangé sur le
# WebSocket -- ce qui lui permet de tourner indépendamment dans SON
# PROPRE PROCESS séparé, lancé par MainWindow via subprocess.Popen()
# ([sys.executable, __file__, "--serveur", "--port", ...], cf. plus bas
# et main_serveur()) exactement comme avant avec serveur.py, ainsi que
# pour du débogage manuel (python AutoniaX_patched.py --serveur, sans
# lancer l'app Qt du tout). Symboles préfixés srv_ pour éviter toute
# collision avec le reste du fichier (ex: ACTIONS_SUPPORTEES, main,
# _main_async existent déjà ailleurs sous ces noms, avec un sens différent).
#
# Registre entièrement en mémoire (cf. 3.2, 12.3, section 10 : pas de
# persistance d'identité entre reconnexions — hors périmètre v1). Un
# redémarrage du serveur efface donc toutes les instances/pilotes/liaisons
# connus ; c'est le comportement attendu.
#
# Le processus tourne indéfiniment jusqu'à un signal d'arrêt (SIGTERM envoyé
# par AutoniaX à la fermeture, ou Ctrl+C en lancement manuel).
#
# argparse, asyncio, json, logging, signal, socket, sys, dataclass/field
# déjà importés plus haut dans ce fichier ; serve (websockets.asyncio.server)
# également déjà importé en tête de fichier dans le même bloc try/except
# optionnel que websockets (cf. RESEAU_DASHBOARD_DISPONIBLE) -- ce bloc
# serveur n'est de toute façon dispatché (cf. main_serveur() et le
# if __name__ == "__main__" en fin de fichier) que si RESEAU_DASHBOARD_
# DISPONIBLE est vrai, donc serve y est garanti non-None.
# ---------------------------------------------------------------------------

srv_log = logging.getLogger("autoniax.serveur")

srv_HOST = "127.0.0.1"
srv_PORT_DEFAUT = 8765


@dataclass
class srv_InstanceInfo:
    id: str
    ws: object
    pid: int | None = None  # PID OS réel du process instance (cf. register, envoyé par
    # instance_nodriver.py) -- PATCH demandé par l'utilisateur : permet à un pilote (Dashboard)
    # de tuer directement le process au niveau OS (os.kill), y compris pour une instance
    # "orpheline" sans Popen local suivi, sans dépendre du mécanisme applicatif "shutdown"
    # (qui peut échouer si l'instance est figée/bloquée -- un kill OS, lui, ne dépend
    # d'aucune logique interne à l'instance).
    liee_a: str | None = None  # pilote_id du PILOTE exclusif (une seule commande à la
    # fois) -- None si aucun pilote ne tient l'instance. Conservé sous ce nom (plutôt que
    # renommé pilote_lie) pour ne pas casser tous les call sites déjà en place.
    verrou_pilote_id: str | None = None  # PATCH (bug confirmé en usage réel, cf. log
    # 09:17:20 : taskexec-xxx lié pour exécuter click(), délogé par autoniax-test-xxx
    # (widget de test manuel) avant même que la commande 'click' ne parte -- celle-ci
    # est refusée par le serveur, timeout 15s côté Task). Cause : "le dernier link gagne
    # toujours" (cf. srv_gerer_link) suppose un seul pilote actif à la fois, faux dès que
    # deux écrans pilotes (Task + test manuel) visent la même instance en parallèle --
    # le widget de test renvoie un link de routine avant CHAQUE commande (cf.
    # _envoyer_commande_liee), qui redevient une vraie reprise (pas un no-op) si un autre
    # pilote est entre-temps devenu liee_a. Ce champ retient le pilote_id qui a posé un
    # verrou EXPLICITE (message link avec verrou=True) : tant qu'il est actif et non
    # expiré, srv_gerer_link REFUSE toute reprise par un pilote différent au lieu de
    # déloger silencieusement (cf. srv_gerer_link). None = aucun verrou actif.
    verrou_pose_a: float | None = None  # time.monotonic() au moment de la pose --
    # filet de sécurité : un verrou plus vieux que SRV_VERROU_TIMEOUT_S est considéré
    # expiré et ignoré (cf. srv_verrou_actif), pour ne jamais bloquer une instance
    # indéfiniment si le détenteur du verrou crashe/se déconnecte sans unlink (ex:
    # exception non catchée avant le finally de _thread_execution côté client).
    observateurs_lies: set = field(default_factory=set)  # {pilote_id, ...} -- 0..N
    # observateurs simultanés (Dashboard, TaskConfigScreen...) : purement visuel, jamais
    # de commande, jamais de conflit entre eux ni avec le pilote. cf. décision utilisateur
    # : "une instance peut avoir plusieurs observateurs mais un seul pilote".


@dataclass
class srv_PiloteInfo:
    id: str
    ws: object
    role: str  # "pilote" (exclusif, envoie de vraies commandes d'action -- un seul à la
    # fois par instance) | "observateur" (aperçu/streaming pur, aucune commande d'action --
    # plusieurs simultanés possibles sur la même instance, jamais de conflit). Ancienne
    # valeur "dashboard" retirée : renommée "observateur" partout (cf. décision
    # utilisateur -- la distinction n'est plus "juste terminologique", elle est
    # maintenant appliquée : seul un pilote peut envoyer des commandes, seul un pilote
    # peut évincer un autre pilote, un observateur ne peut jamais rien évincer).


@dataclass
class srv_ExecuteurInfo:
    """AJOUT (Section 8 -- "Arrêter" interrompt le CODE, pas le profil,
    cf. PLAN_section_8_arreter.md §2/§7 étape 1) -- symétrique de
    srv_InstanceInfo, mais pour le NOUVEAU rôle "executeur" : un
    sous-processus dédié à l'exécution du code utilisateur d'UN profil
    isolé (distinct du sous-processus navigateur, enregistré lui via
    role="instance"). Identifié par `id` = instance_id DU NAVIGATEUR
    qu'il pilote (pas un id propre) -- un seul exécuteur possible par
    instance de navigateur à la fois, donc aucune ambiguïté à indexer de
    cette façon, symétrique de srv_registre.instances déjà indexé ainsi.

    Pas de notion de liaison/pilote/observateur ici (contrairement à
    srv_InstanceInfo.liee_a/observateurs_lies) : un exécuteur n'est
    jamais partagé entre plusieurs pilotes distants -- il appartient de
    bout en bout au SEUL process principal du sAutoniax qui l'a lancé
    (cf. _sautoniax_executer_notebook_distant_sur_instance_isolee), lui
    même déjà connecté au serveur local en role="pilote" via
    client_pilote_instances. Le routage executer_code/executer_code_
    resultat (cf. srv_gerer_executer_code/srv_gerer_executer_code_
    resultat) est donc un simple relais point-à-point par id, sans le
    modèle de liaison/permissions de srv_gerer_command."""
    id: str
    ws: object
    pid: int | None = None


@dataclass
class srv_Registre:
    instances: dict = field(default_factory=dict)
    pilotes: dict = field(default_factory=dict)
    # AJOUT (cf. srv_ExecuteurInfo) -- {instance_id: srv_ExecuteurInfo},
    # même forme que `instances` ci-dessus, registre séparé pour ne rien
    # mélanger avec les instances navigateur (un instance_id peut exister
    # dans les deux dicts simultanément : le navigateur ET son exécuteur
    # de code, chacun sa propre connexion WebSocket).
    executeurs: dict = field(default_factory=dict)
    liaisons: dict = field(default_factory=dict)  # {pilote_id: [instance_id, ...]} — 5.2/11.3
    demandeurs_par_requete: dict = field(default_factory=dict)  # {requete_id: pilote_id} --
    # nécessaire depuis l'introduction des observateurs (cf. srv_gerer_command) : un
    # command_result renvoyé par l'instance ne porte que instance_id/requete_id, jamais
    # l'identité de l'expéditeur original -- avant, cette identité se déduisait sans
    # ambiguïté de instance.liee_a (un seul détenteur possible). Maintenant qu'un
    # OBSERVATEUR peut aussi envoyer une commande autorisée avec une vraie requete_id
    # en attente de réponse (listTabs/switchTab, cf. srv_ACTIONS_OBSERVATEUR_AUTORISEES),
    # instance.liee_a ne suffit plus : il peut valoir un pilote différent (ou None) alors
    # que la réponse est due à un observateur. Rempli dans srv_gerer_command juste avant
    # le relais, consommé (pop) dans srv_gerer_command_result. Entrées sans réponse
    # jamais reçue (rare -- instance plantée entre-temps) : fuite mémoire bornée par le
    # nombre de requêtes en vol, négligeable ; pas de nettoyage périodique ajouté pour
    # ne pas complexifier au-delà du nécessaire.


srv_registre = srv_Registre()

# ---------------------------------------------------------------------------
# ANCIEN mécanisme de copie presse-papier par clic (Win32 direct côté
# serveur : verrou global, listener WM_CLIPBOARDUPDATE, lecture
# OpenClipboard/GetClipboardData) -- RETIRÉ. click(copier_presse_papier=True)
# lit désormais le presse-papier VIRTUEL de l'instance elle-même (déjà
# intercepté via navigator.clipboard.writeText, cf.
# _installer_interception_presse_papier / camoufox_installer_interception_
# presse_papier), rempli directement dans data["result"] côté instance --
# cf. _executer_commande / _executer_commande_camoufox pour la lecture,
# srv_gerer_command / srv_gerer_command_result pour le relais désormais
# sans coordination particulière. Plus de presse-papier Windows physique
# impliqué, plus de collision possible entre instances (chacune isolée).
# ---------------------------------------------------------------------------


async def srv_envoyer(ws, message: dict):
    # LOG DIAGNOSTIC CIBLÉ (bug "2e test qui gèle") : ws.send() est déjà
    # asynchrone, mais si le buffer TCP du destinataire est plein (parce
    # que LUI ne lit plus assez vite son côté -- ex: l'instance saturée
    # par sa propre boucle de traitement), ws.send() peut mettre un temps
    # anormalement long à revenir, ce qui retarderait d'autant TOUT le
    # traitement séquentiel de srv_gerer_connexion (async for) pour CETTE
    # connexion -- donc aussi les prochains messages reçus d'elle. Le
    # wait_for + log ci-dessous rend ce cas visible au lieu de le laisser
    # ralentir silencieusement toute la boucle.
    debut = asyncio.get_running_loop().time()
    try:
        await asyncio.wait_for(ws.send(json.dumps(message)), timeout=3.0)
        duree = asyncio.get_running_loop().time() - debut
        if duree > 0.5:
            srv_log.warning(f"srv_envoyer() : ws.send() anormalement lent ({duree:.3f}s) pour type={message.get('type')!r}")
    except asyncio.TimeoutError:
        srv_log.error(f"srv_envoyer() : ws.send() BLOQUÉ plus de 3s pour type={message.get('type')!r} -- buffer TCP probablement saturé côté destinataire")
    except websockets.exceptions.ConnectionClosed:
        srv_log.debug(f"Envoi ignoré : connexion déjà fermée (type={message.get('type')})")


async def srv_diffuser_a_tous_les_pilotes(message: dict, contexte: str = ""):
    nb_destinataires = len(srv_registre.pilotes)
    if nb_destinataires == 0:
        srv_log.debug(f"Diffusion '{message.get('type')}' ignorée : 0 destinataire(s) {contexte}")
        return
    await asyncio.gather(
        *(srv_envoyer(pilote.ws, message) for pilote in srv_registre.pilotes.values()),
        return_exceptions=True,
    )


def srv_liste_instances_message() -> dict:
    """"libre" reflète l'absence d'un vrai PILOTE (role="pilote") sur
    l'instance -- décision explicite utilisateur : des observateurs
    (role="observateur" -- Dashboard, TaskConfigScreen... simple
    observation du flux vidéo, aucune Action/Task réellement exécutée
    dessus), aussi nombreux soient-ils, ne doivent JAMAIS compter comme
    "occupée" pour les autres -- "sa na aucun sens" que juste regarder un
    aperçu empêche quelqu'un d'autre de piloter réellement l'instance.
    Avec le modèle à deux structures (instance.liee_a = pilote exclusif
    unique | None ; instance.observateurs_lies = ensemble, jamais pris en
    compte ici), le calcul redevient trivial : seul liee_a détermine
    "occupée", observateurs_lies n'entre jamais en jeu."""
    def _compte_comme_occupee(instance: "srv_InstanceInfo") -> bool:
        if instance.liee_a is None:
            return False
        proprietaire = srv_registre.pilotes.get(instance.liee_a)
        if proprietaire is None:
            return True  # propriétaire déconnecté sans unlink propre -- prudence, compte comme occupée
        return proprietaire.role == "pilote"

    return {
        "type": "instances_list",
        "instances": [{"id": i.id, "libre": not _compte_comme_occupee(i), "pid": i.pid} for i in srv_registre.instances.values()],
    }


async def srv_diffuser_liste_instances_a_tous():
    await srv_diffuser_a_tous_les_pilotes(srv_liste_instances_message())


async def srv_gerer_register(ws, data: dict):
    role = data.get("role")
    id_ = data.get("id")
    if not role or not id_:
        await srv_envoyer(ws, {"type": "error", "message": "register: 'role' et 'id' requis"})
        return

    if role == "instance":
        if id_ in srv_registre.instances:
            await srv_envoyer(ws, {"type": "error", "message": f"instance '{id_}' déjà enregistrée"})
            return
        srv_registre.instances[id_] = srv_InstanceInfo(id=id_, ws=ws, pid=data.get("pid"))
        srv_log.info(f"Instance connectée : {id_} (PID {data.get('pid')!r})")
        await srv_diffuser_liste_instances_a_tous()
    elif role == "executeur":
        # AJOUT (cf. srv_ExecuteurInfo) -- même patron que role="instance"
        # ci-dessus (registre dédié indexé par id, refus si déjà présent),
        # mais SANS diffusion de instances_list : les pilotes/observateurs
        # n'ont besoin de rien savoir de l'existence d'un exécuteur, seul
        # le process principal du sAutoniax qui l'a lancé (lui-même
        # role="pilote") lui parle jamais, en ciblant directement son
        # instance_id (cf. srv_gerer_executer_code).
        if id_ in srv_registre.executeurs:
            await srv_envoyer(ws, {"type": "error", "message": f"exécuteur '{id_}' déjà enregistré"})
            return
        srv_registre.executeurs[id_] = srv_ExecuteurInfo(id=id_, ws=ws, pid=data.get("pid"))
        srv_log.info(f"Exécuteur connecté : {id_} (PID {data.get('pid')!r})")
    elif role in ("pilote", "observateur", "dashboard"):
        # "dashboard" gardé en compat ascendante (ancien nom de rôle) : un client qui
        # s'enregistre encore avec ce role est traité exactement comme "observateur" --
        # aucun des deux ne peut plus envoyer de commande ni évincer un pilote (cf. plus
        # bas srv_gerer_link / srv_gerer_command).
        role_normalise = "observateur" if role == "dashboard" else role
        srv_registre.pilotes[id_] = srv_PiloteInfo(id=id_, ws=ws, role=role_normalise)
        srv_log.info(f"{role_normalise.capitalize()} connecté : {id_}")
        role = role_normalise
    else:
        await srv_envoyer(ws, {"type": "error", "message": f"role inconnu : {role}"})
        return

    await srv_envoyer(ws, {"type": "registered", "role": role, "id": id_})
    if role in ("pilote", "observateur"):
        message_liste = srv_liste_instances_message()
        srv_log.info(
            f"Envoi de la liste initiale à '{id_}' ({role}) juste après son register : "
            f"{len(message_liste['instances'])} instance(s) -- {message_liste['instances']}"
        )
        await srv_envoyer(ws, message_liste)


async def srv_gerer_list_instances(ws):
    await srv_envoyer(ws, srv_liste_instances_message())


SRV_VERROU_TIMEOUT_S = 30.0  # PATCH (bug vol de liaison, cf. srv_InstanceInfo.
# verrou_pilote_id) : durée max d'un verrou avant expiration automatique. Filet de
# sécurité seulement -- en usage normal le détenteur lève son verrou lui-même via
# unlink (cf. srv_gerer_unlink) bien avant ce délai (une cellule de Task individuelle
# se termine typiquement en <1s, cf. logs réels). 30s laisse une marge large pour une
# commande lente (ex: capture_propre qui traîne) sans jamais bloquer l'instance pour
# de bon si le détenteur crashe/se déconnecte sans unlink.


def srv_verrou_actif(instance: "srv_InstanceInfo") -> bool:
    """True si l'instance a un verrou posé, non expiré, et dont le détenteur est
    toujours un pilote enregistré (une déconnexion nettoie déjà le verrou via
    srv_detacher_liaison, cf. la boucle de déconnexion plus bas -- ce dernier test est
    un filet de sécurité supplémentaire, pas le mécanisme principal)."""
    if instance.verrou_pilote_id is None or instance.verrou_pose_a is None:
        return False
    if _horloge() - instance.verrou_pose_a > SRV_VERROU_TIMEOUT_S:
        srv_log.warning(
            f"srv_verrou_actif() : verrou de '{instance.verrou_pilote_id}' expiré "
            f"(>{SRV_VERROU_TIMEOUT_S:.0f}s) -- traité comme inactif"
        )
        return False
    return instance.verrou_pilote_id in srv_registre.pilotes


async def srv_gerer_link(ws, data: dict):
    """Deux chemins totalement séparés selon le role de l'expéditeur (cf.
    décision utilisateur : "une instance peut avoir plusieurs observateurs
    mais un seul pilote" -- la contrainte d'exclusivité est PAR INSTANCE,
    pas par client, et ne s'applique qu'aux pilotes) :

    - role="observateur" : rejoint simplement instance.observateurs_lies
      (un set -- déjà présent = no-op silencieux). Jamais de conflit,
      jamais d'éviction, aucun autre observateur ni le pilote éventuel
      n'est affecté.
    - role="pilote" : exclusif via instance.liee_a, mécanisme de reprise
      automatique ("le dernier demandeur reprend la main") -- mais
      seulement entre pilotes, puisque les observateurs ne passent
      jamais par instance.liee_a. SAUF si l'instance porte un VERROU
      actif détenu par un pilote différent (cf. instance.verrou_pilote_id,
      srv_verrou_actif) : dans ce cas la reprise est REFUSÉE (erreur
      explicite renvoyée au demandeur) au lieu de déloger le détenteur.

    PATCH (bug vol de liaison confirmé en usage réel, cf. log 09:17:20 --
    taskexec-xxx délogé par autoniax-test-xxx en plein milieu d'un
    click(), la commande part vers un pilote qui n'est plus liée,
    timeout 15s côté Task) : "le dernier link gagne" suppose qu'un seul
    écran-pilote agit à la fois sur une instance donnée -- faux dès que
    le Task et un écran de test manuel visent la même instance en
    parallèle, chacun renvoyant un link de routine avant chaque commande
    (cf. InstanceApercuScreen._envoyer_commande_liee, dont le commentaire
    d'origine supposait à tort qu'un link répété "reste sans effet").
    Le demandeur peut désormais poser data["verrou"]=True sur son message
    link pour signaler une séquence de commandes qui NE DOIT PAS être
    interrompue par un autre pilote tant qu'elle n'est pas terminée (cf.
    MoteurExecutionCellule._lier_instance_si_besoin, qui pose ce flag --
    le verrou est levé automatiquement au unlink qui suit, cf.
    srv_gerer_unlink, ou expire seul après SRV_VERROU_TIMEOUT_S en filet
    de sécurité si le détenteur ne se délie jamais)."""
    pilote_id = data.get("pilote_id")
    instance_id = data.get("instance_id")
    demande_verrou = bool(data.get("verrou", False))
    instance = srv_registre.instances.get(instance_id)
    if instance is None:
        await srv_envoyer(ws, {"type": "error", "message": f"instance '{instance_id}' introuvable"})
        return
    demandeur = srv_registre.pilotes.get(pilote_id)
    if demandeur is None:
        await srv_envoyer(ws, {"type": "error", "message": f"'{pilote_id}' non enregistré (register requis avant link)"})
        return

    if demandeur.role == "observateur":
        instance.observateurs_lies.add(pilote_id)
        srv_log.info(f"Observateur lié (sans exclusivité) : {pilote_id} <-> {instance_id}")
        await srv_envoyer(ws, {"type": "link_ok", "pilote_id": pilote_id, "instance_id": instance_id})
        # Pas de srv_diffuser_liste_instances_a_tous() ici : un observateur qui se lie
        # ne change jamais "libre" (cf. srv_liste_instances_message), donc rien à
        # rediffuser aux autres clients.
        return

    # role == "pilote" à partir d'ici -- comportement exclusif restreint aux pilotes
    # entre eux (jamais déclenché par/contre un observateur, qui ne touche jamais à
    # liee_a), désormais bloqué par un verrou actif d'un AUTRE pilote (cf. patch
    # ci-dessus) avant même de tenter la reprise habituelle.
    if srv_verrou_actif(instance) and instance.verrou_pilote_id != pilote_id:
        srv_log.warning(
            f"srv_gerer_link() : reprise de '{instance_id}' par '{pilote_id}' REFUSÉE -- "
            f"verrou actif détenu par '{instance.verrou_pilote_id}'"
        )
        await srv_envoyer(ws, {
            "type": "error",
            "message": (
                f"instance '{instance_id}' verrouillée par '{instance.verrou_pilote_id}' "
                "(séquence de commandes en cours) -- réessayez dans un instant"
            ),
        })
        return

    if instance.liee_a is not None and instance.liee_a != pilote_id:
        proprietaire_actuel = srv_registre.pilotes.get(instance.liee_a)
        ancien_proprietaire_id = instance.liee_a
        srv_log.info(
            f"'{ancien_proprietaire_id}' délié automatiquement de '{instance_id}' "
            f"-- reprise par '{pilote_id}'"
        )
        srv_detacher_liaison(ancien_proprietaire_id, instance_id)
        if proprietaire_actuel is not None:
            await srv_envoyer(proprietaire_actuel.ws, {
                "type": "unlinked", "instance_id": instance_id,
                "raison": f"repris par '{pilote_id}'",
            })
    instance.liee_a = pilote_id
    if demande_verrou:
        instance.verrou_pilote_id = pilote_id
        instance.verrou_pose_a = _horloge()
        srv_log.info(f"Verrou posé sur '{instance_id}' par '{pilote_id}' (verrou=True demandé)")
    srv_registre.liaisons.setdefault(pilote_id, [])
    if instance_id not in srv_registre.liaisons[pilote_id]:
        srv_registre.liaisons[pilote_id].append(instance_id)
    srv_log.info(f"Liaison créée : {pilote_id} <-> {instance_id}")
    await srv_envoyer(ws, {"type": "link_ok", "pilote_id": pilote_id, "instance_id": instance_id})
    await srv_diffuser_liste_instances_a_tous()


def srv_detacher_liaison(pilote_id: str | None, instance_id: str):
    """Nettoyage pur (pas d'I/O réseau) d'une liaison PILOTE existante :
    remet instance.liee_a à None et retire instance_id de
    srv_registre.liaisons[pilote_id]. Ne touche jamais à
    observateurs_lies -- cf. srv_detacher_observateur ci-dessous, cas
    structurellement différent (pas d'exclusivité, donc pas de "reprise"
    à gérer, juste un retrait). Factorisé pour être partagé entre
    srv_gerer_unlink (unlink explicite demandé par un pilote) et
    srv_gerer_link (unlink implicite quand un ancien pilote est délié
    pour céder la place à un nouveau pilote demandeur, cf. plus haut).

    PATCH (cf. instance.verrou_pilote_id, srv_gerer_link) : si le pilote
    qui se détache est justement celui qui détenait le verrou de cette
    instance, le verrou est levé ici -- point de passage unique pour
    TOUT détachement de pilote (unlink explicite, reprise par un autre
    pilote, et déconnexion -- cf. appelants), donc le seul endroit qui a
    besoin de connaître cette règle. Un pilote qui se fait déloger par
    un AUTRE pilote alors qu'il détenait un verrou ne devrait normalement
    jamais arriver (srv_gerer_link refuse cette reprise tant que le
    verrou est actif, cf. srv_verrou_actif) -- mais on lève quand même le
    verrou ici par cohérence/robustesse si ce chemin est emprunté malgré
    tout (ex: verrou expiré entre-temps, cf. SRV_VERROU_TIMEOUT_S)."""
    instance = srv_registre.instances.get(instance_id)
    if instance is not None:
        instance.liee_a = None
        if instance.verrou_pilote_id == pilote_id:
            instance.verrou_pilote_id = None
            instance.verrou_pose_a = None
    if pilote_id and pilote_id in srv_registre.liaisons:
        srv_registre.liaisons[pilote_id] = [i for i in srv_registre.liaisons[pilote_id] if i != instance_id]
        if not srv_registre.liaisons[pilote_id]:
            del srv_registre.liaisons[pilote_id]


def srv_detacher_observateur(pilote_id: str, instance_id: str):
    """Symétrique de srv_detacher_liaison mais pour un observateur : simple
    retrait de instance.observateurs_lies, sans notion de "reprise" ni de
    notification 'unlinked' (un observateur n'a jamais été évincé de
    force par personne -- il ne peut que se délier lui-même ou disparaître
    par déconnexion)."""
    instance = srv_registre.instances.get(instance_id)
    if instance is not None:
        instance.observateurs_lies.discard(pilote_id)


async def srv_gerer_unlink(ws, data: dict):
    """Libère une instance liée. Pas dans le protocole du prototype initial
    (qui n'avait pas encore de bouton d'arrêt d'instance) -- ajouté ici car
    le Dashboard (12.4 point 3) doit pouvoir libérer une instance sans
    forcément la fermer (ex: erreur de sélection).

    Le message 'unlink' envoyé côté client ne porte que instance_id (pas
    pilote_id, cf. TaskExecuteur._delier_instance) -- l'expéditeur est
    donc retrouvé via son websocket, exactement comme srv_gerer_command
    le fait déjà pour identifier qui envoie une commande. Nécessaire
    depuis l'introduction des observateurs : instance.liee_a seul ne
    suffit plus à savoir QUI demande à se délier (un observateur qui
    demande unlink ne doit jamais toucher à instance.liee_a -- seulement
    à observateurs_lies).

    BUG CORRIGÉ (cf. diagnostic "type_text fantôme après arreter()") :
    quand un pilote se détache (bouton "Tout arrêter" -> arreter() ->
    unlink, cf. MoteurExecutionCellule.arreter()) alors qu'une commande
    longue (ex: type_text) est encore en cours de traitement côté
    instance, cette commande continuait de s'exécuter en fantôme --
    aucun signal d'annulation n'était jamais envoyé à l'instance
    elle-même, seul le lien pilote<->instance était retiré côté serveur.
    Le command_result tardif de cette commande fantôme arrivait alors en
    pleine EXÉCUTION SUIVANTE sur la même instance (un autre run, ou un
    autre pilote qui la relie ensuite), désynchronisant sa file FIFO de
    commandes (cf. log : une capture de l'exécution suivante expirait
    côté moteur pendant que l'instance finissait encore de traiter ce
    type_text fantôme).

    Correctif, PORTÉE VOLONTAIREMENT ÉTROITE (demande explicite
    utilisateur -- "pas automatiquement toutes les instances", "dans
    l'instance pilotée") : juste avant de délier, un message
    'cancel_pending' est envoyé à instance.ws -- CETTE instance
    précisément, pas les autres instances liées à d'autres pilotes, et
    jamais déclenché pour un observateur (branche ci-dessous, un
    observateur n'a jamais eu la main sur l'exécution de l'instance,
    donc rien à y annuler). Cf. _recevoir_messages_serveur côté instance
    pour le traitement : annule la commande CDP en cours (si une commande
    est effectivement en cours) et vide le reste de la file, puisque le
    pilote qui vient de se délier n'attend plus aucune de ces réponses."""
    instance_id = data.get("instance_id")
    instance = srv_registre.instances.get(instance_id)
    if instance is None:
        await srv_envoyer(ws, {"type": "error", "message": f"instance '{instance_id}' introuvable"})
        return
    demandeur_id = srv_trouver_pilote_id_par_ws(ws)
    demandeur = srv_registre.pilotes.get(demandeur_id) if demandeur_id else None

    if demandeur is not None and demandeur.role == "observateur":
        srv_detacher_observateur(demandeur_id, instance_id)
        srv_log.info(f"Observateur délié : {demandeur_id} <-> {instance_id}")
        # Pas de rediffusion de la liste : un observateur qui se délie ne change
        # jamais "libre" (cf. srv_liste_instances_message).
        return

    # Pilote (ou expéditeur non identifiable -- ancien comportement conservé par
    # prudence : on déduit alors le pilote_id depuis instance.liee_a lui-même).
    pilote_id = demandeur_id if demandeur is not None else instance.liee_a
    # Signal d'annulation envoyé à l'instance AVANT de la délier -- tant
    # que instance.liee_a n'est pas encore remis à None (juste en dessous,
    # dans srv_detacher_liaison), on est certain que cette instance était
    # bien celle tenue par CE pilote, jamais une autre.
    if instance.ws is not None:
        try:
            await srv_envoyer(instance.ws, {"type": "command", "action": "cancel_pending", "instance_id": instance_id})
            srv_log.info(f"cancel_pending envoyé à '{instance_id}' (détachement de '{pilote_id}')")
        except Exception as e:
            # Best-effort : si l'envoi échoue (ex: websocket de l'instance
            # déjà fermé), on continue quand même le unlink normalement --
            # ne jamais bloquer un détachement pour ça.
            srv_log.warning(f"cancel_pending non délivré à '{instance_id}' : {e!r}")
    srv_detacher_liaison(pilote_id, instance_id)
    srv_log.info(f"Liaison retirée : {pilote_id} <-> {instance_id}")
    await srv_diffuser_liste_instances_a_tous()


async def srv_gerer_force_unlink(ws, data: dict):
    """PATCH (retour utilisateur, bouton "Free" du Dashboard -- "sa doit
    absolument le liberer de tout pilote... je veux plus de probleme, et
    sa doit etre confirmer par le serveur") : contrairement à
    srv_gerer_unlink (qui ne libère QUE la liaison de l'EXPÉDITEUR lui-
    même -- inutile ici, le Dashboard n'est pas forcément le pilote qui
    tient l'instance), cette commande libère l'instance du pilote qui la
    détient ACTUELLEMENT, quel qu'il soit, sur simple demande de
    n'importe quel client enregistré (observateur ou pilote).

    Passe outre un verrou actif (instance.verrou_pilote_id, cf.
    srv_gerer_link) -- volontairement, contrairement à la reprise normale
    par un autre pilote qui elle est REFUSÉE tant qu'un verrou tient (cf.
    srv_verrou_actif dans srv_gerer_link) : "Free" est justement le
    bouton de dernier recours pour une instance restée bloquée/liée à un
    pilote mort ou plus jamais responsif, le verrou ne doit donc jamais
    pouvoir l'empêcher.

    Toujours répond explicitement à l'appelant (force_unlink_ok, avec
    l'ancien pilote_id le cas échéant, même si rien n'était lié -- idempotent)
    plutôt que de rester silencieux comme srv_gerer_unlink : le bouton
    "Free" doit être CONFIRMÉ par le serveur avant que l'UI n'annonce le
    succès à l'utilisateur, cf. docstring du bouton côté DashboardScreen."""
    instance_id = data.get("instance_id")
    instance = srv_registre.instances.get(instance_id)
    if instance is None:
        await srv_envoyer(ws, {
            "type": "error", "message": f"instance '{instance_id}' introuvable",
        })
        return

    ancien_pilote_id = instance.liee_a
    ancien_pilote = srv_registre.pilotes.get(ancien_pilote_id) if ancien_pilote_id else None
    verrou_leve = srv_verrou_actif(instance)

    srv_detacher_liaison(ancien_pilote_id, instance_id)
    # BUGFIX défense en profondeur : srv_detacher_liaison ne lève le
    # verrou que s'il appartenait à ancien_pilote_id -- normalement
    # toujours vrai (un verrou n'existe que sur une instance actuellement
    # liée à son détenteur), mais un état incohérent ne doit jamais
    # laisser le verrou survivre à un Free explicite.
    instance.verrou_pilote_id = None
    instance.verrou_pose_a = None

    if ancien_pilote_id:
        srv_log.warning(
            f"srv_gerer_force_unlink() : '{ancien_pilote_id}' délié DE FORCE de "
            f"'{instance_id}' (demandé par un tiers, verrou_leve={verrou_leve})"
        )
        if ancien_pilote is not None:
            await srv_envoyer(ancien_pilote.ws, {
                "type": "unlinked", "instance_id": instance_id,
                "raison": "libérée de force (bouton \"Free\")",
            })
    else:
        srv_log.info(f"srv_gerer_force_unlink() : '{instance_id}' déjà libre, rien à faire")

    await srv_envoyer(ws, {
        "type": "force_unlink_ok", "instance_id": instance_id,
        "ancien_pilote_id": ancien_pilote_id,
    })
    await srv_diffuser_liste_instances_a_tous()


