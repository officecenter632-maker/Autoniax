def _zipper_dossier_profil(chemin_dossier: str) -> Path:
    """Zippe le dossier persistant d'un profil (PATCH -- demande
    explicite utilisateur : "on effectue une copie de ce qui est sur
    notre machine et on l'envoie", puis "zipper le dossier entier en un
    seul fichier .zip avant envoi") dans un fichier temporaire, et
    retourne son chemin. Fonction SYNCHRONE/BLOQUANTE volontairement --
    zipper un user_data_dir Chrome/Camoufox complet (cache, extensions,
    etc.) peut prendre plusieurs secondes voire plus sur un gros profil,
    donc TOUJOURS appelée via loop.run_in_executor (cf. ClientServeurT.
    _envoyer_profil) pour ne jamais bloquer la boucle asyncio du thread
    réseau (qui doit rester réactive pendant ce temps : heartbeats,
    autres messages entrants...), même patron que srv_attendre_maj_
    presse_papier_windows.

    shutil.make_archive plutôt qu'un zipfile manuel -- plus robuste
    (gère déjà récursivité, chemins Windows longs, etc.), cohérent avec
    l'usage déjà fait de shutil ailleurs dans ce fichier.

    CORRECTIF (logs Kaggle -- fingerprint reçu sur une machine différente
    de celle où il a été généré contenait executable_path/user_data_dir/
    headless figés sur la machine D'ORIGINE -- cf. camoufox_demarrer_
    navigateur, qui doit maintenant compenser ça À CHAQUE RECHARGEMENT
    pour rester utilisable) -- on nettoie ICI, À LA SOURCE, ces mêmes
    clés machine-spécifiques DANS LE ZIP produit, une seule fois, pour
    que tout futur profil envoyé (peu importe la machine d'origine :
    Windows de dev, une autre machine Kaggle, etc.) arrive déjà propre
    chez le destinataire -- le correctif de camoufox_demarrer_navigateur
    reste nécessaire pour les profils DÉJÀ zippés avant ce patch-ci (déjà
    présents sur B2), mais les prochains envois n'en auront plus besoin.

    IMPORTANT : on modifie UNIQUEMENT le zip temporaire résultant, JAMAIS
    le camoufox_fingerprint.json du dossier source local -- ce fichier
    reste tel quel sur la machine de l'utilisateur (device/police/WebGL/
    geoip/proxy/cookies/historique intacts, y compris ces 3 clés qui
    restent valides SUR CETTE machine précise). Seule la copie qui part
    vers une autre machine est nettoyée."""
    chemin_zip_sans_extension = Path(tempfile.gettempdir()) / f"autoniax_profil_{uuid.uuid4().hex}"
    chemin_zip_str = shutil.make_archive(
        str(chemin_zip_sans_extension), "zip", root_dir=chemin_dossier,
    )
    chemin_zip = Path(chemin_zip_str)

    # Nettoyage du fingerprint DANS LE ZIP (cf. docstring ci-dessus) --
    # défensif de bout en bout : un zip sans fingerprint (ancien profil,
    # ou profil créé sans proxy/config robuste) ne pose aucun problème
    # (rien à nettoyer, no-op) ; un JSON illisible/corrompu ne doit
    # jamais faire échouer l'ENVOI du profil pour autant -- seul le
    # nettoyage est sauté, journalisé, le zip original (non nettoyé)
    # part quand même (repli identique au comportement actuel).
    nom_entree_fingerprint = "camoufox_fingerprint.json"
    cles_machine_specifiques = ("executable_path", "user_data_dir", "headless")
    try:
        with zipfile.ZipFile(chemin_zip, "r") as zf_lecture:
            noms_presents = zf_lecture.namelist()
            if nom_entree_fingerprint not in noms_presents:
                return chemin_zip  # aucun fingerprint dans ce profil -- rien à nettoyer
            fingerprint_brut = zf_lecture.read(nom_entree_fingerprint)
        fingerprint_dict = json.loads(fingerprint_brut)
        cles_retirees = [c for c in cles_machine_specifiques if c in fingerprint_dict]
        if not cles_retirees:
            return chemin_zip  # déjà propre -- rien à réécrire
        for cle in cles_retirees:
            fingerprint_dict.pop(cle, None)
        fingerprint_nettoye = json.dumps(fingerprint_dict, indent=2).encode("utf-8")

        # zipfile ne permet pas de remplacer une entrée en place -- on
        # reconstruit un second zip (même patron que shutil.make_archive
        # : fichier temporaire dédié, jamais le zip original modifié
        # partiellement en cas d'erreur en cours de route) puis on
        # substitue l'ancien.
        chemin_zip_nettoye = chemin_zip.with_name(chemin_zip.stem + "_nettoye.zip")
        with zipfile.ZipFile(chemin_zip, "r") as zf_lecture, \
             zipfile.ZipFile(chemin_zip_nettoye, "w", zipfile.ZIP_DEFLATED) as zf_ecriture:
            for item in zf_lecture.infolist():
                if item.filename == nom_entree_fingerprint:
                    zf_ecriture.writestr(item, fingerprint_nettoye)
                else:
                    zf_ecriture.writestr(item, zf_lecture.read(item.filename))
        chemin_zip.unlink(missing_ok=True)
        chemin_zip_nettoye.rename(chemin_zip)
        log.info(
            f"[camoufox] profil zippé pour envoi -- clé(s) machine-spécifique(s) "
            f"{cles_retirees} retirée(s) de {nom_entree_fingerprint} dans le zip "
            f"(le fichier local du profil reste inchangé)."
        )
    except Exception as exc_nettoyage:
        # Défensif -- cf. docstring : un échec de nettoyage ne doit
        # jamais bloquer l'envoi, seulement le dégrader (zip envoyé tel
        # quel, non nettoyé -- comportement identique à avant ce patch).
        log.warning(
            f"[camoufox] échec du nettoyage machine-spécifique de "
            f"{nom_entree_fingerprint} dans le zip du profil ({exc_nettoyage!r}) -- "
            f"le zip part tel quel, non nettoyé (le destinataire s'appuiera sur le "
            f"repli de camoufox_demarrer_navigateur au rechargement)."
        )

    return chemin_zip


def _config_stockage_depuis_reglages(reglages: "ReglagesApp") -> dict:
    """Construit le payload "configurer_stockage" envoyé au serveurT --
    MIGRATION TOTALE Backblaze B2 -> Google Drive (décision explicite
    utilisateur : "migration total vers le drive"). Le serveurT tourne
    sur une machine DISTANTE (Colab, cf. cahier réseau) : il n'a aucun
    accès au chemin local de la clé de service sur la machine de
    l'utilisateur -- le CONTENU du fichier JSON est donc lu ICI et
    envoyé tel quel dans le payload (même principe que l'ancien système
    B2, où access_key_id/secret_access_key étaient transmis en VALEUR,
    jamais en référence à un fichier local).

    Dict vide si le fichier de clé est introuvable/illisible, ou si
    aucun dossier racine n'est configuré -- ClientServeurT._envoyer_
    config_stockage traite ça comme "rien à envoyer" (pas encore
    configuré), comportement inchangé par rapport à l'ancien système B2."""
    dossier_racine_id = (reglages.drive_dossier_racine_id or "").strip()
    if not dossier_racine_id:
        return {}
    chemin_cle = Path(reglages.drive_chemin_cle_json_resolu)
    try:
        contenu_cle_json = chemin_cle.read_text(encoding="utf-8")
    except OSError:
        return {}
    return {
        "cle_service_json": contenu_cle_json,
        "dossier_racine_id": dossier_racine_id,
    }


# RETRAIT (migration "Mettre à jour" vers Drive direct -- demande
# explicite utilisateur : "mAutoniax upload directement ... plus de
# envoie autonome de fichier du serveur vers les sautoniax") : l'ancienne
# classe TransfertMiseAJourEnCours (état d'un transfert mettre_a_jour_app
# EN CHUNKS avec retry+pause/reprise côté client) a été entièrement
