        )
        # PATCH (boutons "Renommer"/"Supprimer" de Profils Cloud, demande
        # explicite utilisateur) -- même patron exact que demande_maj_
        # meta_profil/meta_profil_maj_resultat juste au-dessus.
        # Renommage : protocole réseau dédié (ClientServeurT.demander_
        # renommer_profil_cloud / renommer_profil_cloud_resultat).
        reseau_screen.demande_renommer_profil_cloud.connect(self.client_serveur_t.demander_renommer_profil_cloud)
        self.client_serveur_t.renommer_profil_cloud_resultat.connect(
