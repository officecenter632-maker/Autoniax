class NotebookManagerScreen(QWidget):
    """PATCH (migration Render -> Colab+tunnel Cloudflare) -- écran
    minimal générique pour un onglet "glisse-dépose ce notebook et laisse-
    le tourner" : titre, explication, bouton de glisser-déposer SORTANT
    centré (ServeurTDragHandle, exporte une copie du fichier hors
    d'AutoniaX) et zone de dépôt ENTRANTE sur tout l'écran (cf. ci-
    dessous) pour mettre à jour ce même fichier depuis l'extérieur. Base
    commune à ServeurTManagerScreen et SAutoniaxManagerScreen ci-dessous,
    qui ne diffèrent l'un de l'autre que par leur titre/texte/chemin de
    fichier -- pas de logique propre à chacun au-delà de ça, donc une
    seule classe paramétrée plutôt que deux quasi-identiques.

    CORRECTIF (demande explicite utilisateur : "je veux que pour les
    deux autre (Manager) on puisse gliser aussi le fichier notebook pour
    que sa met dirctement a jour lactuels dans leur dossier specifique")
    -- setAcceptDrops(True) + dragEnterEvent/dropEvent ci-dessous :
    accepte un .ipynb glissé depuis l'Explorateur/Finder n'importe où
    sur cet écran, l'écrit à chemin_notebook_factory() (écrase l'ancien
    -- get_notebook_serveurt_path()/get_notebook_execution_path() ne
    fabriquent plus rien automatiquement, cf. leurs docstrings ; c'est
    maintenant CE geste qui les alimente, exactement comme un glisser-
    déposer manuel dans le dossier ferait, mais sans quitter l'app).
    Reste par ailleurs PASSIF côté réseau (aucun signal, aucun accès
    ClientServeurT) : le téléchargement/lancement/supervision se font
    entièrement DANS le notebook une fois sur Colab/Kaggle."""

    def __init__(self, titre: str, description: str, chemin_notebook_factory,
                 texte_tooltip_drag: str, parent=None):
        super().__init__(parent)
        self._chemin_notebook_factory = chemin_notebook_factory
        self.setAcceptDrops(True)

        layout = QVBoxLayout(self)
        layout.setAlignment(Qt.AlignCenter)
        layout.setSpacing(14)
        layout.setContentsMargins(40, 40, 40, 40)

        icon_label = QLabel(self)
        icon_label.setPixmap(qta.icon("mdi6.notebook-outline", color=Mocha.surface2).pixmap(48, 48))
        icon_label.setAlignment(Qt.AlignCenter)
        layout.addWidget(icon_label)

        title_label = QLabel(titre, self)
        title_label.setObjectName("PlaceholderTitle")
        title_label.setAlignment(Qt.AlignCenter)
        layout.addWidget(title_label)

        subtitle_label = QLabel(description, self)
        subtitle_label.setObjectName("PlaceholderSubtitle")
        subtitle_label.setAlignment(Qt.AlignCenter)
        subtitle_label.setWordWrap(True)
        subtitle_label.setMaximumWidth(560)
        layout.addWidget(subtitle_label)

        # Bouton de drag centré, en taille normale (pas le gabarit compact
        # de toolbar utilisé côté GitScreen/en-tête d'éditeur) -- ici
        # c'est l'action PRINCIPALE de tout l'écran, pas un raccourci
        # secondaire en coin. Garde l'objectName "APIFeaturesMenuButton"
        # fixé par ServeurTDragHandle.__init__ (surtout ne PAS le
        # réécraser ici) : c'est le seul style QSS existant pour ce
        # bouton (transparent + hover surface0, cf. feuille de style
        # globale) -- lui donner un objectName dédié le priverait de tout
        # style sans qu'aucune règle QSS n'existe encore pour le
        # remplacer.
        self.bouton_drag = ServeurTDragHandle(
            chemin_notebook_factory, self, texte_tooltip=texte_tooltip_drag,
        )
        self.bouton_drag.setIconSize(QSize(32, 32))
        self.bouton_drag.setFixedSize(64, 64)
        layout.addWidget(self.bouton_drag, 0, Qt.AlignCenter)

        label_drag = QLabel("Glisser-déposer vers Colab/Kaggle (ou un dossier)", self)
        label_drag.setObjectName("PlaceholderSubtitle")
        label_drag.setAlignment(Qt.AlignCenter)
        layout.addWidget(label_drag)

        # CORRECTIF (demande explicite utilisateur : "je veux que tu met
        # une fois un bouon de copy du path du dossier que contineut les
        # notebok, au ccas ou les drag ne fontionn aps") -- filet de
        # sécurité si le glisser-déposer direct échoue (cf. QDrag vers un
        # navigateur, pas garanti sur toutes les configurations Windows) :
        # copie le chemin du DOSSIER contenant le notebook (chemin_
        # notebook_factory().parent, pas le fichier lui-même) dans le
        # presse-papier, pour que l'utilisateur puisse l'ouvrir dans
        # l'Explorateur (Win+R / barre d'adresse) et faire le drag depuis
        # là -- un drag OS natif depuis l'Explorateur passe par un chemin
        # Windows différent (CF_HDROP direct) qui contourne un éventuel
        # problème propre à QDrag.
        self.bouton_copier_dossier = QPushButton("Copier le chemin du dossier", self)
        self.bouton_copier_dossier.setObjectName("APIFeaturesMenuButton")
        self.bouton_copier_dossier.setCursor(Qt.PointingHandCursor)
        self.bouton_copier_dossier.clicked.connect(self._sur_clic_copier_dossier)
        layout.addWidget(self.bouton_copier_dossier, 0, Qt.AlignCenter)

        # CORRECTIF -- label symétrique pour le sens ENTRANT (glisser un
        # .ipynb DEPUIS l'extérieur POUR remplacer celui-ci), sous le
        # même bouton -- même widget visuel que la ligne d'export
        # juste au-dessus, sens inverse.
        self.label_drop_entrant = QLabel(
            "...ou glisser un fichier .ipynb ici pour le mettre à jour", self,
        )
        self.label_drop_entrant.setObjectName("PlaceholderSubtitle")
        self.label_drop_entrant.setAlignment(Qt.AlignCenter)
        layout.addWidget(self.label_drop_entrant)

        self.label_statut_drop = QLabel("", self)
        self.label_statut_drop.setObjectName("PlaceholderSubtitle")
        self.label_statut_drop.setAlignment(Qt.AlignCenter)
        self.label_statut_drop.setWordWrap(True)
        layout.addWidget(self.label_statut_drop)

    def _sur_clic_copier_dossier(self):
        """CORRECTIF -- cf. commentaire sur self.bouton_copier_dossier.
        chemin_notebook_factory() peut retourner un chemin dont le
        fichier n'existe pas encore (cf. get_notebook_execution_path/
        get_notebook_serveurt_path, "cette fonction ne crée RIEN") --
        mais le DOSSIER, lui, est toujours créé par ces factories
        (mkdir(parents=True, exist_ok=True)), donc toujours copiable
        même avant le tout premier dépôt manuel."""
        chemin = self._chemin_notebook_factory()
        if chemin is None:
            return
        QApplication.clipboard().setText(str(chemin.parent))
        self.label_statut_drop.setText(f"Chemin du dossier copié : {chemin.parent}")



    # ------------------------------------------------------------------
    # Dépôt ENTRANT (.ipynb glissé depuis l'extérieur d'AutoniaX)
    # ------------------------------------------------------------------
    # CORRECTIF (demande explicite utilisateur : "le drop vers l'externe
    # de fichier notebook ne fonctionne pas bien sur certaines
    # interfaces") -- l'ancienne version n'acceptait QUE url.isLocalFile()
    # : ça marche pour un glisser depuis l'Explorateur/Finder, mais Colab
    # et Kaggle tournent dans un NAVIGATEUR, et selon l'origine exacte du
    # glisser (onglet navigateur, Google Drive web, certains gestionnaires
    # de fenêtres Wayland...), le MIME reçu n'est pas toujours une URL
    # file://. Le drop était alors silencieusement ignoré (event.ignore(),
    # aucun message), sans que l'utilisateur comprenne pourquoi.
    #
    # Élargi pour reconnaître, dans cet ordre de préférence, TROIS formes
    # de dépôt valides :
    #   1. Fichier LOCAL réel (file://...) -- comportement d'origine,
    #      inchangé, toujours le cas le plus courant.
    #   2. Contenu BRUT déposé (octets du .ipynb directement dans le
    #      MIME, sans passer par un chemin disque) -- certaines
    #      interfaces web exposent le fichier glissé ainsi plutôt que
    #      comme une URL locale.
    #   3. URL DISTANTE http(s)://...ipynb (glissée depuis un onglet
    #      navigateur, ex. un lien direct vers le fichier) -- téléchargée
    #      à la volée avant d'être écrite sur disque.
    # Chaque cas retourne une structure interne uniforme (_DepotIpynb)
    # pour que dropEvent n'ait qu'un seul chemin de traitement, quelle
    # que soit la provenance réelle du fichier.

    def _depot_ipynb_valide(self, mime: "QMimeData") -> Optional["NotebookManagerScreen._DepotIpynb"]:
        """Inspecte le QMimeData d'un drag et retourne un _DepotIpynb
        décrivant comment récupérer son contenu .ipynb, ou None si ce
        drag ne contient rien d'exploitable. Centralisé ici pour que
        dragEnterEvent/dragMoveEvent/dropEvent appliquent exactement la
        même règle d'acceptation."""
        # Cas 1 -- fichier local réel (comportement d'origine).
        if mime.hasUrls():
            for url in mime.urls():
                if url.isLocalFile():
                    chemin = Path(url.toLocalFile())
                    if chemin.suffix.lower() == ".ipynb" and chemin.is_file():
                        return NotebookManagerScreen._DepotIpynb(
                            type_depot="fichier_local", chemin_local=chemin,
                        )

        # Cas 3 -- URL distante http(s) pointant vers un .ipynb (glissée
        # depuis un onglet navigateur). Vérifié via le nom apparent de
        # l'URL plutôt que Content-Type (pas de requête réseau ici, cette
        # méthode doit rester rapide -- appelée à chaque mouvement de
        # souris pendant le drag par dragMoveEvent).
        if mime.hasUrls():
            for url in mime.urls():
                if not url.isLocalFile() and url.scheme() in ("http", "https"):
                    if Path(url.path()).suffix.lower() == ".ipynb":
                        return NotebookManagerScreen._DepotIpynb(
                            type_depot="url_distante", url_distante=url.toString(),
                            nom_affiche=Path(url.path()).name,
                        )

        # Cas 2 -- contenu brut déposé (pas d'URL du tout, ou une URL
        # sans extension .ipynb reconnaissable) : accepté si le MIME
        # contient des octets directement identifiables comme un .ipynb
        # (JSON avec les clés attendues), en dernier recours seulement --
        # évite de confondre un simple texte/image glissé par erreur avec
        # un vrai notebook.
        for format_mime in ("application/x-ipynb+json", "text/plain", "application/octet-stream"):
            if not mime.hasFormat(format_mime):
                continue
            donnees = bytes(mime.data(format_mime))
            if not donnees:
                continue
            if NotebookManagerScreen._ressemble_a_un_ipynb(donnees):
                return NotebookManagerScreen._DepotIpynb(
                    type_depot="contenu_brut", contenu_brut=donnees,
                    nom_affiche="notebook.ipynb",
                )

        return None

    @staticmethod
    def _ressemble_a_un_ipynb(donnees: bytes) -> bool:
        """Vérifie que `donnees` ressemble bien à un fichier .ipynb réel
        (JSON avec les clés nbformat/cells attendues), plutôt que
        d'accepter n'importe quel texte/octet glissé par erreur --
        limité aux 200 premiers Ko pour ne jamais tenter de parser un
        gros fichier binaire sans rapport glissé accidentellement."""
        if len(donnees) > 200_000:
            return False
        try:
            contenu = json.loads(donnees.decode("utf-8"))
        except (UnicodeDecodeError, json.JSONDecodeError):
            return False
        return isinstance(contenu, dict) and "cells" in contenu and "nbformat" in contenu

    @dataclass
    class _DepotIpynb:
        """Résultat uniforme de _depot_ipynb_valide, quelle que soit la
        provenance réelle (fichier local, contenu brut, URL distante) --
        un seul type_depot renseigné parmi les trois, les autres champs
        associés à None/vides."""
        type_depot: str  # "fichier_local" | "contenu_brut" | "url_distante"
        chemin_local: Optional[Path] = None
        contenu_brut: Optional[bytes] = None
        url_distante: Optional[str] = None
        nom_affiche: str = ""

        def __post_init__(self):
            if not self.nom_affiche and self.chemin_local is not None:
                self.nom_affiche = self.chemin_local.name

        def obtenir_octets(self) -> bytes:
            """Retourne le contenu .ipynb sous forme d'octets, quel que
            soit le type_depot -- télécharge l'URL distante si besoin
            (seul cas nécessitant un accès réseau synchrone, acceptable
            ici vu la taille modeste d'un .ipynb et le fait que ce n'est
            déclenché qu'au dropEvent, pas au survol)."""
            if self.type_depot == "fichier_local":
                return self.chemin_local.read_bytes()
            if self.type_depot == "contenu_brut":
                return self.contenu_brut
            if self.type_depot == "url_distante":
                with urllib.request.urlopen(self.url_distante, timeout=15) as reponse:
                    return reponse.read()
            raise ValueError(f"type_depot inconnu : {self.type_depot!r}")

    def dragEnterEvent(self, event):
        if self._depot_ipynb_valide(event.mimeData()) is not None:
            event.acceptProposedAction()
            self.setStyleSheet("NotebookManagerScreen { background-color: rgba(160,160,160,60); }")
        else:
            event.ignore()

    def dragMoveEvent(self, event):
        if self._depot_ipynb_valide(event.mimeData()) is not None:
            event.acceptProposedAction()
        else:
            event.ignore()

    def dragLeaveEvent(self, event):
        self.setStyleSheet("")
        super().dragLeaveEvent(event)

    def dropEvent(self, event):
        self.setStyleSheet("")
        depot = self._depot_ipynb_valide(event.mimeData())
        if depot is None:
            self.label_statut_drop.setText(
                "Dépôt ignoré : aucun fichier .ipynb reconnaissable dans ce que tu as glissé."
            )
            event.ignore()
            return

        chemin_cible = self._chemin_notebook_factory()
        try:
            octets = depot.obtenir_octets()
        except (OSError, urllib.error.URLError, TimeoutError) as e:
            self.label_statut_drop.setText(f"Échec de la récupération du notebook : {e}")
            event.ignore()
            return

        try:
            chemin_cible.write_bytes(octets)
        except OSError as e:
            self.label_statut_drop.setText(f"Échec de la mise à jour : {e}")
            event.ignore()
            return

        self.label_statut_drop.setText(f"{chemin_cible.name} mis à jour ({depot.nom_affiche}).")
        self._apres_depot_notebook()
        event.acceptProposedAction()

    def _apres_depot_notebook(self) -> None:
        """Hook : appele apres l'ecriture d'un notebook depose (rien par defaut)."""




