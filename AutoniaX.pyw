        background-color: {m.sky};
    }}

    #BatchLancerButton:pressed {{
        background-color: {m.sapphire};
    }}

    #BatchLancerButton:disabled {{
        background-color: {m.surface1};
        color: {m.overlay0};
    }}

    #BatchArreterButton {{
        background-color: {m.peach};
        color: {m.crust};
        border: none;
        border-radius: {RADIUS}px;
        padding: 7px 14px;
