        def _programmer():
            tache = loop.create_task(_sautoniax_telecharger_profil_vers_sautoniax_demande(
                client_t, loop, nom_profil, id_pilote,
            ))
            _taches_projets_en_cours.add(tache)
            tache.add_done_callback(_taches_projets_en_cours.discard)
        loop.call_soon_threadsafe(_programmer)

    client_t.telecharger_profil_vers_sautoniax_demande.connect(_sur_telecharger_profil_vers_sautoniax_demande, Qt.DirectConnection)

    # CORRECTIF (contrôle à distance ne fonctionnait jamais en mode
    # sAutoniax -- cf. docstring de commande_instance_recue côté
    # ClientServeurT pour le diagnostic complet). Même patron EXACT que
    # _sur_projet_sautoniax_recu juste en dessous : callback exécuté sur
    # le thread réseau de ClientServeurT (Qt.DirectConnection), qui se
    # contente de programmer le vrai travail sur la boucle asyncio
    # PRINCIPALE via call_soon_threadsafe (jamais d'await direct ici,
    # ce callback n'est pas une coroutine).
    #
    # Utilise namespace_notebook_distant["context"/"gestion"/
    # "etat_navigateur"] -- mêmes objets, quel que soit le chemin qui a
    # chargé le profil actuellement actif (legacy --profil OU bouton
    # "Initialiser" du Notebook Distant, cf. leurs docstrings
    # respectives : les deux peuplent désormais ces 3 clés en plus de
    # page/camoufox_cm). Si aucun profil n'est encore chargé
    # (etat_navigateur is None), répond ok=False plutôt que de planter
    # sur un attribut manquant -- même esprit défensif que le reste de
    # ce fichier (une capture plus tardive vaut mieux qu'un crash pour
    # une commande arrivée trop tôt).
    def _sur_commande_instance_recue(data: dict):
        requete_id = data.get("requete_id", "")
        action = data.get("action", "")
        instance_id = data.get("instance_id", "")

        # PATCH sortie de logs par profil : traitée ICI, avant le routage vers l'instance,
        # car elle ne concerne que le drapeau local lu par l'exécuteur du profil.
        if action == "get_diag_demarrage":
            nom_diag = data.get("nom_profil") or (data.get("commande") or {}).get("nom_profil") or ""
            lignes_diag, total_diag = diag_rapport_profil(nom_diag)
            client_t.envoyer_command_result(
                instance_id, action, requete_id, True, {"lignes": lignes_diag, "total": total_diag}, "",
            )
            return
        if action == "get_journal_profil":
            try:
                nb_demande = int(data.get("lignes", (data.get("commande") or {}).get("lignes", 100)))
            except (TypeError, ValueError):
                nb_demande = 100
            nb_demande = max(1, min(5000, nb_demande))
            lignes_journal, total_journal = _journal_instance_dernieres_lignes(instance_id, nb_demande)
            client_t.envoyer_command_result(
                instance_id, action, requete_id, True, {"lignes": lignes_journal, "total": total_journal}, "",
            )
            return
        if action == "set_sortie_logs":
            coupee_demandee = bool(data.get("coupee", (data.get("commande") or {}).get("coupee", False)))
            ok_drapeau = _definir_sortie_logs_instance(instance_id, coupee_demandee)
            log.info(
                f"[sAutoniax] sortie de logs de l'instance {instance_id!r} -> "
                f"{'COUPÉE' if coupee_demandee else 'ACTIVE'} (ok={ok_drapeau})."
            )
            client_t.envoyer_command_result(
                instance_id, action, requete_id, ok_drapeau, {"coupee": coupee_demandee},
                "" if ok_drapeau else "Écriture du drapeau de logs impossible sur ce sAutoniax.",
            )
            return

        # CORRECTIF (point 3 -- contrôle à distance toujours exécuté sur
        # namespace_notebook_distant peu importe l'instance_id demandé) :
        # si la commande vise une instance ISOLÉE (démarrée via "Démarrer"
        # ou un ProjetBatch, cf. _instances_isolees/_instances_legacy_par_
        # profil/moteur._instances_par_profil), elle tourne dans un
        # SOUS-PROCESSUS séparé -- namespace_notebook_distant ne la
        # concerne jamais (c'est la page du mode mono-profil legacy
        # UNIQUEMENT). On relaie donc via client_pilote_instances (déjà
        # lié à cette instance, cf. _lier_instance_isolee_au_client_
        # pilote, appelée dès son démarrage) -- srv_gerer_command_result
        # renverra la réponse à _sur_command_result_instance_isolee, qui
        # la retransmet elle-même au pilote distant. Ancien comportement
        # (exécution directe sur namespace_notebook_distant) inchangé
        # pour tout instance_id NON reconnu comme isolé, c'est-à-dire le
        # mode mono-profil/Notebook Distant legacy.
        # CORRECTIF (factorisation) : réutilise désormais _est_instance_
        # geree_par_client_pilote (même calcul que ci-dessus, mais un
        # seul point de vérité partagé avec _sur_frame_instance_isolee/
        # _sur_command_result_instance_isolee, cf. sa docstring) plutôt
        # que de dupliquer ce calcul une 4e fois ici.
        if _est_instance_geree_par_client_pilote(instance_id):
            client_pilote_instances.envoyer_commande(data)
            return

        def _programmer():
            async def _executer_et_repondre():
                context = namespace_notebook_distant.get("context")
                gestion = namespace_notebook_distant.get("gestion")
                etat_navigateur = namespace_notebook_distant.get("etat_navigateur")
                if etat_navigateur is None:
                    log.warning(
                        f"[sAutoniax] command '{action}' (requete_id={requete_id!r}) reçue mais "
                        f"aucun profil chargé pour l'instant -- ignorée."
                    )
                    client_t.envoyer_command_result(
                        instance_id, action, requete_id, False,
                        error="Aucun profil chargé sur ce sAutoniax pour l'instant.",
                    )
                    return
                try:
                    reponse = await _executer_commande_camoufox(
                        context, gestion, etat_navigateur, data, arret_demande=None,
                    )
                except Exception as e:
                    log.exception(f"[sAutoniax] échec exécution command '{action}' (requete_id={requete_id!r})")
                    reponse = {"ok": False, "error": f"{e.__class__.__name__}: {e}"}
                client_t.envoyer_command_result(
                    instance_id, action, requete_id,
                    reponse.get("ok", False), reponse.get("result"), reponse.get("error", ""),
                )
            tache = loop.create_task(_executer_et_repondre())
            _taches_projets_en_cours.add(tache)
            tache.add_done_callback(_taches_projets_en_cours.discard)
        loop.call_soon_threadsafe(_programmer)

    client_t.commande_instance_recue.connect(_sur_commande_instance_recue, Qt.DirectConnection)

    def _sur_projet_sautoniax_recu(session_id: str, nom_projet_recu: str, profils_recus: list,
                                    chemin_projet_assemble: str, id_pilote_recu: str):
        # PATCH (§4.4.a/c) : programme le traitement sur la boucle asyncio
        # principale (create_task, thread-safe via call_soon_threadsafe --
        # ce callback est exécuté depuis le thread réseau de ClientServeurT,
        # Qt.DirectConnection, cf. remarque générale en tête de fonction).
        # Traité en TÂCHE DE FOND plutôt qu'attendu ici : un deuxième
        # projet_sautoniax_recu ne doit jamais être bloqué par un premier
        # déjà en cours (le serveurT refuse déjà lui-même un second envoi
        # tant que projet_distribue_en_cours n'est pas vidé, cf. serveur.py
        # -- ce garde-fou suffit, pas besoin d'en rajouter un ici).
        #
        # PATCH (revue de validation 4.4.c) : .clear() explicite AVANT de
        # démarrer ce nouveau projet -- un kill_projet reçu pour un projet
        # PRÉCÉDENT (déjà terminé/échoué entre-temps) ne doit jamais
        # annuler par erreur ce nouveau projet qui vient d'arriver (le
        # garde-fou serveur projet_distribue_en_cours garantit qu'il n'y a
        # jamais deux projets simultanés pour CE sAutoniax, donc ce
        # .clear() est sûr : aucune annulation légitime en vol ne peut
        # être perdue ici).
        _annulation_projet_demandee.clear()
        def _programmer():
            tache = loop.create_task(_sautoniax_traiter_projet_recu(
                client_t, loop, session_id, nom_projet_recu, profils_recus,
                chemin_projet_assemble, id_pilote_recu, serveur_local_proc, _moteur_batch_courant,
                _annulation_projet_demandee, _instances_legacy_par_profil,
                callback_instance_demarree=_lier_instance_isolee_au_client_pilote,
                relais_proxy_local=relais_proxy_local,
            ))
            _taches_projets_en_cours.add(tache)
            tache.add_done_callback(_taches_projets_en_cours.discard)
        loop.call_soon_threadsafe(_programmer)

    client_t.projet_sautoniax_recu.connect(_sur_projet_sautoniax_recu, Qt.DirectConnection)

    # PATCH (demande explicite utilisateur : sAutoniax ne doit plus jamais
    # télécharger/exécuter de profil au démarrage -- mode "connecté, en
    # attente" pur, seul le serveur local + projets distribués restent
    # actifs) -- arret_demande/_demander_arret déclarés ici, AVANT l'étape 2
    # (téléchargement du profil), qui devient elle-même conditionnelle plus
    # bas. Ces deux éléments doivent exister que nom_profil soit fourni ou
    # non : sans profil, ils servent à garder le process vivant (attente
    # pure de SIGTERM/Ctrl+C) ; avec profil (mode legacy) ou via le bouton
    # "Initialiser" (cf. _sur_initialiser_notebook_distant_demande
    # ci-dessous, qui en a besoin), ils gardent leur rôle d'origine pour la
    # boucle de capture (cf. _sautoniax_boucle_capture).
    arret_demande = asyncio.Event()

    def _demander_arret(*_):
        log.info("[sAutoniax] signal d'arrêt reçu.")
        arret_demande.set()

    try:
        loop.add_signal_handler(signal.SIGTERM, _demander_arret)
        loop.add_signal_handler(signal.SIGINT, _demander_arret)
    except NotImplementedError:
        signal.signal(signal.SIGINT, _demander_arret)

    # BOUTON "Redémarrer" (menu contextuel clic droit sur une instance,
    # côté mAutoniax -- retour utilisateur explicite : "peut-être que
    # après que nous avons mis à jour le fichier py de l'app... ça
    # télécharge de nouveau l'app et ça relance, sinon je suis obligé de
    # redémarrer kaggle à chaque fois"). Dict mutable (même patron que
    # etat_capture juste plus bas) plutôt qu'un simple bool de closure --
    # lu par main_sautoniax() après le retour de cette coroutine pour
    # décider du code de sortie du process (cf. CODE_SORTIE_REDEMARRAGE) :
    # arret_demande.set() seul ne dit pas POURQUOI le process s'arrête
    # (SIGTERM normal vs redémarrage explicitement demandé) -- ce dict
    # transporte cette distinction jusqu'à main_sautoniax, qui est seule
    # responsable du code de sortie (cette coroutine-ci ne fait jamais
    # sys.exit() elle-même, cf. son contrat existant).
    etat_redemarrage = {"demande": False}

    def _sur_redemarrer_executant_demande():
        # Réutilise EXACTEMENT le même chemin d'arrêt propre que SIGTERM
        # (arret_demande.set(), cf. _demander_arret ci-dessus) -- Camoufox
        # et la connexion serveurT sont donc fermés proprement par le même
        # `finally` qui gère déjà l'arrêt normal, rien à dupliquer ici.
        # Seule différence : etat_redemarrage["demande"] = True AVANT de
        # déclencher l'arrêt, pour que main_sautoniax sache qu'il doit
        # sortir avec CODE_SORTIE_REDEMARRAGE plutôt que 0 -- c'est ce
        # code de sortie distinct que la boucle de supervision du notebook
        # Kaggle (etape_5_lancer_et_suivre_sautoniax) surveille pour
        # décider de retélécharger AutoniaX.py et relancer automatiquement,
        # plutôt que de traiter la fin du process comme un arrêt normal ou
        # un crash.
        #
        # THREAD-SAFETY (même bug que celui corrigé sur
        # _sur_regler_capture_instance_demande, cf. son commentaire plus
        # bas) : ce callback tourne en Qt.DirectConnection, donc DANS LE
        # THREAD RÉSEAU de ClientServeurT -- arret_demande est un
        # asyncio.Event, PAS un threading.Event, donc .set() doit être
        # posté sur la boucle via call_soon_threadsafe plutôt qu'appelé
        # directement, sous peine de ne jamais réveiller fiablement le
        # `await arret_demande.wait()` qui tourne dans la boucle asyncio.
        # etat_redemarrage["demande"] = True, en revanche, ne touche qu'un
        # dict Python -- sûr à faire directement, comme etat_capture
        # ailleurs dans ce fichier.
        log.info("[sAutoniax] redemarrer_executant reçu -- arrêt propre en cours avant relance côté notebook.")
        etat_redemarrage["demande"] = True
        loop.call_soon_threadsafe(arret_demande.set)

    client_t.redemarrer_executant_demande.connect(_sur_redemarrer_executant_demande, Qt.DirectConnection)

    # --- Pilotage à chaud du taux/capture ponctuelle (cf. protocole
    # regler_capture_instance, serveur.py + ClientServeurT.demander_
    # capture_ponctuelle_instance/definir_taux_capture_instance côté
    # pilote) -- `etat_capture["intervalle_s"]` remplace le paramètre figé
    # `intervalle_capture_s` comme SOURCE DE VÉRITÉ de la boucle de capture
    # (dict plutôt qu'une variable simple : une closure Python ne peut pas
    # réassigner une variable du scope englobant sans `nonlocal`, un
    # conteneur mutable évite ce problème). capture_ponctuelle_demandee :
    # Event séparé de arret_demande -- interrompt l'attente en cours pour
    # capturer IMMÉDIATEMENT, sans attendre la fin du cycle courant, sans
    # pour autant déclencher un arrêt du process. Déclarés ici (AVANT
    # _sur_initialiser_notebook_distant_demande, qui en a besoin dès
    # maintenant -- cf. CORRECTIF aperçu mono-profil vide, docstring de
    # _sautoniax_initialiser_notebook_distant) plutôt qu'au niveau de
    # l'ancienne étape 4 legacy : partagés par TOUTE capture de ce process,
    # peu importe quel chemin a chargé le profil actuellement actif.
    #
    # CORRECTIF (retour utilisateur explicite : "cest moi qui doit activer
    # le rafraichissement que se soit manuel ou auto") : "actif" démarre à
    # False -- même contrat que etat_stream["actif"] côté streaming local
    # (cf. _main_async/_main_async_camoufox) -- AUCUNE capture n'est
    # envoyée tant que le pilote n'a pas explicitement coché "Automatique"
    # (fps>0, cf. ci-dessous) ou cliqué "Rafraîchir" (capture ponctuelle,
    # cf. _sautoniax_boucle_capture -- reste utilisable même en mode
    # inactif, SANS jamais activer le flux continu).
    etat_capture = {"intervalle_s": intervalle_capture_s, "actif": False}
    capture_ponctuelle_demandee = asyncio.Event()
    # CORRECTIF (logs redondants, cf. _sur_regler_capture_instance_demande
    # plus bas) -- dernier (fps, actif) réellement relayé PAR INSTANCE
    # gérée par client_pilote_instances (isolée/batch/legacy), pour éviter
    # de renvoyer set_fps/set_streaming quand l'état demandé est déjà
    # celui en place (le GUI envoie systématiquement "ponctuelle" PUIS
    # "taux" par clic -- sans cette déduplication, les deux redéclenchent
    # chacun l'envoi complet).
    _etat_capture_relaye_par_instance: dict[str, dict] = {}

    # CORRECTIF (bug réel signalé par l'utilisateur : "Capturer tout"
    # déclenchait un streaming continu qui ne s'arrêtait jamais pour les
    # instances isolées/clone, cf. logs "-> envoyer_capture" répétés
    # indéfiniment toutes les ~10s pour chaque profil, alors qu'aucun
    # streaming n'avait été activé manuellement). Cause : le bloc
    # action=="ponctuelle" ci-dessous, pour ces instances, simulait une
    # capture unique en activant set_fps(1)+set_streaming(actif=True) et
    # ne le désactivait JAMAIS -- contrairement au mode mono-profil
    # legacy (cf. plus bas, capture_ponctuelle_demandee) qui, lui, fait
    # une VRAIE capture unique sans toucher à un quelconque état "actif".
    # Le protocole "capture_propre" existe déjà (cf. action_camoufox_
    # capture_propre / action_capture_propre côté instance, ACTIONS_
    # ETENDUES) précisément pour ce cas : une capture ponctuelle CDP,
    # totalement indépendante de set_streaming/set_fps, déjà utilisée
    # ailleurs (détection OpenCV, aperçu manuel de TestComposantScreen,
    # cf. _demander_capture_propre). Ce dict mémorise, par requete_id, le
    # instance_id_visee correspondant, pour que _sur_command_result_
    # instance_isolee (qui reçoit TOUS les command_result de TOUTES les
    # instances isolées/batch, capture_propre inclus) sache reconnaître
    # cette réponse précise et la convertir en un simple envoyer_capture
    # au pilote distant, plutôt que de laisser action=="ponctuelle"
    # allumer un flux continu qu'on n'a ensuite plus aucun moyen propre
    # d'éteindre automatiquement.
    _requetes_capture_propre_en_attente: dict[str, str] = {}

    def _sur_regler_capture_instance_demande(instance_id_visee: str, action: str, fps: float):
        # Filtré sur CETTE instance -- en mono-profil, un seul instance_id
        # existe pour tout le process (celui de ce sAutoniax), mais le
        # signal est générique (cf. sa docstring) et pourrait en théorie
        # transporter une demande pour une autre instance si jamais ce
        # même client_t était un jour partagé -- ce n'est pas le cas
        # aujourd'hui (un seul ClientServeurT par process sAutoniax),
        # gardé par robustesse plutôt que par nécessité actuelle.
        #
        # CORRECTIF (panneau de rendu réseau restait noir malgré des acks
        # ok=True) : le PILOTE envoie systématiquement instance_id =
        # id_executant (cf. MainWindow, lambda id_executant: self.
        # client_serveur_t.demander_capture_ponctuelle_instance(
        # id_executant, id_executant)) -- c'est-à-dire l'id_connexion
        # attribué par le serveurT à CE sAutoniax lors de son register
        # (cf. serveur.py, "register_ok" -> "id": id_connexion), PAS
        # l'instance_id local dérivé de --profil/--instance-id (qui vaut
        # "sautoniax" en mode attente pure, cf. main_sautoniax). Ces deux
        # valeurs ne coïncidaient donc jamais, et cette fonction rejetait
        # silencieusement CHAQUE demande ("Rafraîchir", "Automatique") --
        # aucune erreur, aucun log, juste un `return` immédiat ici. On
        # accepte maintenant AUSSI l'id_connexion réel (client_t.
        # _id_serveur, rempli dès "register_ok" -- cf. ClientServeurT.
        # _traiter_message), en plus de l'instance_id local légataire,
        # pour rester compatible avec un éventuel --instance-id explicite
        # déjà aligné manuellement sur l'id_connexion par ailleurs.
        # CORRECTIF (BUG RÉEL, PAS UN NON-PROBLÈME COMME SUPPOSÉ CI-DESSUS) :
        # l'hypothèse "le flux de capture est déjà autonome et continu côté
        # sous-processus" était FAUSSE -- confirmée par les logs réels :
        # _boucle_streaming_frames_camoufox démarre TOUJOURS avec actif=False
        # (cf. sa docstring dans _main_async_camoufox : "le streaming ne
        # s'active que sur réception explicite de {'action': 'set_streaming',
        # 'actif': true}, jamais tout seul") -- et RIEN, pour une instance
        # isolée/batch/legacy, n'envoyait jamais ce message : ce bloc se
        # contentait de logguer puis `return`, sans jamais relayer set_fps/
        # set_streaming vers l'instance via client_pilote_instances. Résultat
        # observé : "regler_capture_instance" acquitté ok=True à chaque clic
        # sur Rafraîchir/Automatique, mais AUCUNE frame jamais émise (écran
        # définitivement noir), même après plusieurs minutes -- exactement
        # comme pour le bug symétrique du mode mono-profil documenté juste en
        # dessous ("BUG CORRIGÉ (panneau de rendu réseau...)"), jamais
        # corrigé pour ce chemin-ci. Relais direct vers l'instance, même
        # format EXACT que _sur_demande_rafraichissement_rendu_reseau/
        # _appliquer_etat_streaming côté mAutoniax (cf. leurs {"type":
        # "command", "action": "set_fps"/"set_streaming", ...}) -- traité
        # DIRECTEMENT par l'instance (etat_stream local, cf. _ecouter_serveur
        # côté _main_async_camoufox), aucun command_result n'est renvoyé pour
        # ces deux actions, donc rien à attendre ici.
        if _est_instance_geree_par_client_pilote(instance_id_visee):
            # CORRECTIF (retour utilisateur explicite : "pourquoi je ne
            # reçois pas les images" -- log réel : sur un batch de 4
            # instances, 3 répondent normalement à 'capture_propre', UNE
            # SEULE échoue systématiquement avec "instance ... non liée à
            # 'sautoniax-pilote-xxx' (liée à : 'executeur-pilote-...')" --
            # précisément celle sur laquelle une cellule a déjà tourné au
            # moins une fois) : MoteurExecutionCelluleReseau (mAutoniax)
            # ne fait JAMAIS de unlink en fin de cellule, contrairement au
            # moteur local (cf. MoteurExecutionCellule._delier_instance,
            # appelé dans son finally). Le serveur central embarqué relie
            # donc l'EXÉCUTEUR de la cellule ('executeur-pilote-...') à
            # l'instance et l'y laisse indéfiniment une fois la cellule
            # finie -- client_pilote_instances (le pilote normal du
            # sAutoniax) reste délié pour de bon, et TOUTE commande
            # ultérieure sur cette instance précise échoue, que ce soit un
            # clic manuel ('command'/'click', même symptôme constaté par
            # ailleurs) ou une capture ('capture_propre'/'set_fps'/
            # 'set_streaming', ici). Redemande donc explicitement la
            # liaison AVANT d'envoyer quoi que ce soit vers l'instance --
            # une seule fois ici, point d'entrée commun aux deux actions
            # 'ponctuelle' et 'taux' plutôt que dupliqué dans chacune.
            # Fire-and-forget, pas de verrou=True : on ne fait que
            # reprendre la place de pilote par défaut (cf. srv_gerer_link,
            # "le dernier demandeur reprend la main"), sans empêcher une
            # future cellule de reprendre la main à son tour ensuite.
            client_pilote_instances.envoyer_commande({
                "type": "link", "pilote_id": client_pilote_instances.id_client,
                "instance_id": instance_id_visee,
            })
            # CORRECTIF (retour utilisateur explicite : "trop de logs
            # redondants") -- le GUI envoie SYSTÉMATIQUEMENT "ponctuelle"
            # PUIS "taux" à quelques ms d'écart à chaque clic Rafraîchir/
            # Automatique (cf. logs réels : deux 'regler_capture_instance'
            # consécutifs pour un seul geste) -- l'ancien code envoyait sa
            # propre paire set_fps/set_streaming pour CHACUNE des deux,
            # soit 4 commandes réseau (donc ~20 lignes de log réparties
            # sur pilote/serveur/instance) pour un seul clic, la moitié
            # totalement redondante. _etat_capture_relaye_par_instance
            # mémorise le dernier (fps, actif) réellement envoyé PAR
            # INSTANCE (dict, pas juste la dernière -- plusieurs instances
            # isolées/batch peuvent cohabiter sur ce même sAutoniax) : on
            # ne renvoie une commande que si l'état demandé diffère
            # réellement du dernier envoyé, quelle que soit la valeur
            # d'`action` qui l'a déclenché.
            dernier_etat = _etat_capture_relaye_par_instance.get(instance_id_visee, {"fps": None, "actif": None})
            if action == "ponctuelle":
                # CORRECTIF (bug réel : "Capturer tout" laissait un
                # streaming continu tourner indéfiniment, cf. docstring de
                # _requetes_capture_propre_en_attente ci-dessus pour le
                # détail complet) -- une capture ponctuelle ("Rafraîchir"/
                # "Capturer tout") ne doit JAMAIS modifier l'état
                # actif/inactif du streaming, exactement comme le mode
                # mono-profil legacy juste plus bas (capture_ponctuelle_
                # demandee, "ne touche jamais etat_capture['actif']").
                # Utilise donc le protocole capture_propre (déjà existant,
                # déjà utilisé ailleurs pour la détection OpenCV/l'aperçu
                # manuel) au lieu de set_fps/set_streaming : une requête,
                # une réponse, rien de laissé allumé après coup, que le
                # streaming de cette instance soit déjà actif ou non.
                requete_id = uuid.uuid4().hex[:12]
                _requetes_capture_propre_en_attente[requete_id] = instance_id_visee
                log.info(f"[sAutoniax] capture ponctuelle (capture_propre) demandée à l'instance isolée '{instance_id_visee}'.")
                client_pilote_instances.envoyer_commande({
                    "type": "command", "instance_id": instance_id_visee,
                    "action": "capture_propre", "requete_id": requete_id,
                })
                # _etat_capture_relaye_par_instance délibérément PAS mis à
                # jour ici : cette capture n'active ni ne désactive rien,
                # donc elle ne doit pas influencer la déduplication de la
                # prochaine demande "taux" (Automatique).
            elif action == "taux":
                fps_cible = max(1, round(fps)) if fps > 0 else 0
                actif_cible = fps > 0
                # CORRECTIF (aperçu en direct resté allumé malgré une désactivation) : la mémoire de
                # l'état envoyé était mise à jour même si la commande était perdue (instance déconnectée
                # à cet instant, "introuvable"), puis les désactivations suivantes étaient ignorées comme
                # "déjà à l'état demandé". Une DÉSACTIVATION est maintenant toujours envoyée ; une
                # demande identique n'est ignorée que si elle suit la précédente de moins de 2 s
                # (double envoi ponctuelle+taux d'un même clic).
                _maintenant = time.monotonic()
                if (actif_cible
                        and dernier_etat["fps"] == fps_cible and dernier_etat["actif"] == actif_cible
                        and _maintenant - dernier_etat.get("t", 0.0) < 2.0):
                    log.debug(f"[sAutoniax] réglage taux ignoré pour '{instance_id_visee}' : déjà à l'état demandé (fps={fps_cible}, actif={actif_cible}).")
                    return
                if actif_cible:
                    log.info(f"[sAutoniax] capture automatique activée pour l'instance isolée '{instance_id_visee}' : {fps} FPS.")
                    client_pilote_instances.envoyer_commande({
                        "type": "command", "instance_id": instance_id_visee,
                        "action": "set_fps", "fps": fps_cible,
                    })
                    client_pilote_instances.envoyer_commande({
                        "type": "command", "instance_id": instance_id_visee, "action": "set_streaming", "actif": True,
                    })
                else:
                    log.info(f"[sAutoniax] capture automatique désactivée pour l'instance isolée '{instance_id_visee}'.")
                    client_pilote_instances.envoyer_commande({
                        "type": "command", "instance_id": instance_id_visee, "action": "set_streaming", "actif": False,
                    })
                _etat_capture_relaye_par_instance[instance_id_visee] = {"fps": fps_cible, "actif": actif_cible, "t": _maintenant}
            return
        if instance_id_visee != instance_id and instance_id_visee != client_t._id_serveur:
            return

        # BUG CORRIGÉ (panneau de rendu réseau : la demande arrivait bien
        # -- "capture ponctuelle demandée"/"capture automatique activée"
        # étaient loggés, le serveur ET le sAutoniax répondaient ok=True
        # -- mais AUCUNE capture n'était jamais réellement envoyée au
        # serveurT ensuite, cf. absence totale de "-> envoyer_capture"
        # dans les logs malgré des dizaines de "regler_capture_instance"
        # acquittés). Cause : ce callback tourne en Qt.DirectConnection,
        # donc DANS LE THREAD RÉSEAU de ClientServeurT (cf. commentaire
        # de démarrage de main_sautoniax, quelques dizaines de lignes
        # plus haut : "chaque callback ne fait que threading.Event.set()
        # ou loop.call_soon_threadsafe(...), tous deux thread-safe par
        # construction" -- règle explicite déjà posée, mais pas respectée
        # ici). capture_ponctuelle_demandee est un asyncio.Event, PAS un
        # threading.Event : l'appeler .set() directement depuis un thread
        # différent de celui qui fait tourner la boucle asyncio contenant
        # _sautoniax_boucle_capture (cf. son `await
        # capture_ponctuelle_demandee.wait()`) n'est pas garanti de
        # réveiller cette attente -- asyncio.Event n'est thread-safe que
        # si on repasse par loop.call_soon_threadsafe, exactement comme
        # tous les autres callbacks de ce fichier qui touchent à un objet
        # asyncio depuis une DirectConnection (cf. _sur_executer_
        # notebook_distant_demande/_sur_initialiser_notebook_distant_
        # demande juste au-dessus, même patron). La demande était donc
        # posée dans etat_capture/l'Event, mais _sautoniax_boucle_capture
        # pouvait rester bloquée indéfiniment sur son await -- jusqu'à ce
        # qu'un événement SANS RAPPORT (arrêt, ou nouvel appel qui relance
        # un cycle) la réveille par coïncidence, expliquant le caractère
        # imprévisible du bug plutôt qu'un échec systématique à 100%.
        #
        # La logique métier elle-même (accepter/logguer/mettre à jour
        # etat_capture) ne touche que des dicts Python et le logger --
        # sûre à exécuter directement dans le thread réseau, comme avant.
        # Seul le réveil de la boucle asyncio (capture_ponctuelle_
        # demandee.set()) est maintenant posté sur la boucle via
        # call_soon_threadsafe, au lieu d'un appel direct.
        if action == "ponctuelle":
            # "Rafraîchir" (mode manuel OU automatique, cf. docstring de
            # _sur_demande_rafraichissement_rendu_reseau côté pilote) --
            # une capture UNIQUE, ne touche jamais etat_capture["actif"].
            log.info(f"[sAutoniax] capture ponctuelle demandée (instance_id={instance_id!r}).")
            loop.call_soon_threadsafe(capture_ponctuelle_demandee.set)
        elif action == "taux":
            if fps > 0:
                nouvel_intervalle = 1.0 / fps
                log.info(
                    f"[sAutoniax] capture automatique activée (instance_id={instance_id!r}) : "
                    f"{fps} FPS -> intervalle {nouvel_intervalle:.2f}s (était "
                    f"{'active, ' if etat_capture['actif'] else 'inactive, '}"
                    f"{etat_capture['intervalle_s']:.2f}s)."
                )
                etat_capture["intervalle_s"] = nouvel_intervalle
                etat_capture["actif"] = True
            else:
                # fps<=0 : "désactive le flux continu" (cf. docstring de
                # _sur_bascule_mode_auto côté pilote, "0.0 = désactive le
                # flux continu") -- CORRECTIF, ce cas était auparavant
                # silencieusement ignoré ici (condition `fps > 0` sur le
                # elif entier), alors que le pilote l'envoie bel et bien
                # dès que la case "Automatique" est décochée.
                log.info(f"[sAutoniax] capture automatique désactivée (instance_id={instance_id!r}).")
                etat_capture["actif"] = False
            # Réveille la boucle immédiatement si elle est en pleine
            # attente (activation, désactivation, ou nouveau taux sur
            # l'ancien potentiellement long intervalle) -- sans ça, le
            # changement ne prendrait effet qu'après la fin du cycle
            # d'attente déjà entamé, ce qui contredirait "à CHAUD".
            loop.call_soon_threadsafe(capture_ponctuelle_demandee.set)

    client_t.regler_capture_instance_demande.connect(_sur_regler_capture_instance_demande, Qt.DirectConnection)

    def _sur_logs_executant_demande(id_pilote: str):
        # PATCH (bouton "Copier tous les logs", source sAutoniax) -- le
        # pilote demande l'intégralité des logs de CE sAutoniax, depuis
        # son propre démarrage (cf. tampon_journal, TamponJournalMemoire
        # en tête de fichier, alimenté dès logging.basicConfig). Réponse
        # immédiate et synchrone (pas de boucle à réveiller comme pour la
        # capture) : les lignes sont déjà toutes en mémoire.
        log.info(f"[sAutoniax] logs demandés par le pilote '{id_pilote}' ({len(tampon_journal.lignes)} ligne(s)).")
        client_t.envoyer_logs_executant(id_pilote, list(tampon_journal.lignes))

    client_t.logs_executant_demande.connect(_sur_logs_executant_demande, Qt.DirectConnection)

    def _sur_executer_notebook_distant_demande(
        session_id: str, profil_nom_demande: str, code_demande: str, id_pilote_demande: str,
        services_api_lies: dict,
        # AJOUT (SPEC_lot_corrections_2026-09.md section 11) -- cf.
        # docstring de ClientServeurT.executer_notebook_distant.
        reinitialiser_result_color: bool = False,
        lire_result_color_finale: bool = False,
    ):
        # PATCH (§4.5 -- notebook distant) : exécute `code_demande` sur le
        # profil `profil_nom_demande` de CE sAutoniax. Si le profil demandé
        # est celui de la boucle mono-profil en cours (mode legacy, étape
        # 4), réutilise directement `page`/`namespace` déjà actifs.
        #
        # PATCH (Run sur profil ISOLÉ -- cf. SPEC_notebook_distant_profils_
        # isoles.md) : AVANT ce correctif, un profil démarré via le bouton
        # "Démarrer" du panneau Instances (_instances_isolees, subprocess
        # séparé) tombait TOUJOURS dans le cas "aucun profil actif" ci-
        # dessous (page_courante is None), même si l'instance était bel et
        # bien active -- namespace_notebook_distant ne concerne QUE le mode
        # legacy/Initialiser (in-process), jamais les instances isolées.
        # Le profil isolé est maintenant détecté EN PREMIER (_instances_
        # isolees) et routé vers _sautoniax_executer_notebook_distant_sur_
        # instance_isolee (canal cross-process client_pilote_instances,
        # cf. sa docstring) -- comportement du mode legacy/Initialiser
        # RIGOUREUSEMENT INCHANGÉ pour tout profil qui n'est PAS dans
        # _instances_isolees.
        def _programmer():
            if profil_nom_demande in _instances_isolees:
                instance_id_isolee = _instances_isolees[profil_nom_demande]
                # DIAG MASSIF : combien de tâches déjà en vol touchent ce
                # MÊME instance_id_isolee au moment où on en lance une
                # nouvelle -- confirme ou infirme l'hypothèse de deux
                # moteur_relais concurrents sur la même instance isolée.
                taches_concurrentes_meme_instance = [
                    t for t in _taches_projets_en_cours
                    if not t.done() and getattr(t, "_diag_instance_id_isolee", None) == instance_id_isolee
                ]
                log.info(
                    f"[sAutoniax] notebook distant (session={session_id}) -- profil "
                    f"'{profil_nom_demande}' résolu via _instances_isolees "
                    f"(instance_id={instance_id_isolee!r}) -- exécution cross-process."
                )
                log.info(
                    f"[DIAG-CONCURRENCE] AVANT création tâche pour session={session_id!r} instance_id={instance_id_isolee!r} : "
                    f"{len(taches_concurrentes_meme_instance)} tâche(s) DÉJÀ EN VOL sur cette MÊME instance "
                    f"(total taches_en_cours toutes instances confondues={len(_taches_projets_en_cours)}) -- "
                    f"si > 0, DEUX moteur_relais vont coexister sur la même instance_id simultanément."
                )
                tache = loop.create_task(_sautoniax_executer_notebook_distant_sur_instance_isolee(
                    loop, client_t, client_pilote_instances, instance_id_isolee,
                    session_id, code_demande, id_pilote_demande, services_api_lies,
                    _namespaces_isoles,  # CORRECTIF TIMEOUT : namespace persistant par instance_id
                    _moteurs_relais_courants,  # CORRECTIF ROUTAGE DYNAMIQUE : moteur_relais courant par instance_id
                    _executeurs_isoles=_executeurs_isoles,  # AJOUT Section 8 -- registre Popen de l'exécuteur, lancement paresseux
                    _callbacks_executer_code_en_attente=_callbacks_executer_code_en_attente,  # AJOUT Section 8 -- attente executer_code_resultat
                    # AJOUT (SPEC_lot_corrections_2026-09.md section 11) --
                    # SEUL chemin d'exécution réellement emprunté par le
                    # panneau clone (_lancer_sequence_clone_profil ne
                    # cible que des profils isolés, jamais le mode legacy/
                    # Initialiser mono-profil de la branche `else` juste en
                    # dessous) -- c'est donc ici, et seulement ici, que ces
                    # deux flags ont un effet réel (cf. docstring de la
                    # fonction pour le détail complet de l'injection/
                    # lecture de result_color).
                    reinitialiser_result_color=reinitialiser_result_color,
                    lire_result_color_finale=lire_result_color_finale,
                ))
                tache._diag_instance_id_isolee = instance_id_isolee
                tache._diag_session_id = session_id
            else:
                # SPEC_lot_corrections_2026-09.md section 11 : reinitialiser_
                # result_color/lire_result_color_finale ne sont PAS transmis
                # ici -- ce chemin (mode legacy/Initialiser, mono-profil in-
                # process) n'est jamais emprunté par le panneau clone (cf.
                # commentaire ci-dessus), et _sautoniax_executer_notebook_
                # distant n'a de toute façon aucun paramètre prévu pour ces
                # flags (non modifiée par ce chantier -- seule sa jumelle
                # isolée ci-dessus l'est). Un lancement manuel via
                # NotebookDistantScreen sur ce chemin continue donc de se
                # comporter exactement comme avant.
                tache = loop.create_task(_sautoniax_executer_notebook_distant(
                    client_t, loop, session_id, profil_nom_demande, code_demande, id_pilote_demande,
                    namespace_notebook_distant, namespace_notebook_distant.get("page"), services_api_lies,
                ))
            tache._diag_profil_nom = profil_nom_demande   # PATCH H : lu par _sur_profils_sautoniax_demande (champ « en_cours »)
            tache._diag_debut = time.time()
            _taches_projets_en_cours.add(tache)
            tache.add_done_callback(_taches_projets_en_cours.discard)
        loop.call_soon_threadsafe(_programmer)

    client_t.executer_notebook_distant_demande.connect(_sur_executer_notebook_distant_demande, Qt.DirectConnection)

    def _sur_initialiser_notebook_distant_demande(session_id: str, profil_nom_demande: str, id_pilote_demande: str):
        # PATCH (bouton "Initialiser") -- même patron de programmation
        # (create_task via call_soon_threadsafe) que _sur_executer_
        # notebook_distant_demande ci-dessus, pour _sautoniax_initialiser_
        # notebook_distant plutôt que _sautoniax_executer_notebook_distant.
        #
        # CORRECTIF (bug reproductible : "Camoufox is already running, but
        # is not responding" -- BrowserType.launch_persistent_context
        # échoue avec un verrou de profil Firefox) : si `profil_nom_demande`
        # est DÉJÀ actif via le mécanisme "profil isolé" (_instances_
        # isolees, bouton "Démarrer" du panneau propriétés) ou via un
        # ProjetBatch en cours (_moteur_batch_courant._instances_par_profil),
        # ce bouton "Initialiser" tentait quand même de relancer Camoufox
        # sur le MÊME dossier de profil -- deux Firefox sur un seul
        # user_data_dir, le second échoue toujours au lancement (verrou
        # .parentlock). _sautoniax_initialiser_notebook_distant ne fermait
        # que son PROPRE profil précédemment chargé (etat_notebook_distant),
        # jamais un profil actif via un mécanisme SÉPARÉ.
        #
        # DEMANDE EXPLICITE UTILISATEUR ("il faut que si c'est déjà actif
        # ça ferme bien automatiquement") : plutôt que de refuser, on ferme
        # ICI l'instance concurrente AVANT de programmer l'initialisation
        # -- même mécanique de fermeture que _sur_kill_profil_demande
        # ci-dessus (proc.terminate()/kill() + nettoyage des registres pour
        # un profil isolé ; moteur.arreter_profil() pour un ProjetBatch),
        # factorisée ici pour ne jamais diverger des deux comportements
        # déjà existants et éprouvés.
        if profil_nom_demande in _instances_isolees:
            instance_id_concurrente = _instances_isolees.get(profil_nom_demande)
            proc_concurrent = _procs_isoles.get(instance_id_concurrente) if instance_id_concurrente else None
            log.info(
                f"[sAutoniax] initialiser_notebook_distant : profil "
                f"'{profil_nom_demande}' déjà actif (isolé, instance "
                f"'{instance_id_concurrente}') -- fermeture automatique avant réinitialisation."
            )
            if proc_concurrent is not None:
                proc_concurrent.terminate()
                try:
                    proc_concurrent.wait(timeout=3.0)
                except subprocess.TimeoutExpired:
                    log.warning(
                        f"[sAutoniax] instance isolée '{instance_id_concurrente}' "
                        f"(PID {proc_concurrent.pid}) n'a pas répondu à terminate() -> kill()"
                    )
                    proc_concurrent.kill()
                    proc_concurrent.wait(timeout=3.0)
                _procs_isoles.pop(instance_id_concurrente, None)
            _instances_isolees.pop(profil_nom_demande, None)
        else:
            moteur = _moteur_batch_courant.get("moteur")
            deja_actif_batch = (
                moteur is not None and hasattr(moteur, "_instances_par_profil")
                and profil_nom_demande in moteur._instances_par_profil
            )
            if deja_actif_batch and hasattr(moteur, "arreter_profil"):
                log.info(
                    f"[sAutoniax] initialiser_notebook_distant : profil "
                    f"'{profil_nom_demande}' déjà actif (ProjetBatch) -- "
                    f"fermeture automatique avant réinitialisation."
                )
                moteur.arreter_profil(profil_nom_demande, redemarrer=False)

        def _programmer():
            tache = loop.create_task(_sautoniax_initialiser_notebook_distant(
                client_t, loop, session_id, profil_nom_demande, id_pilote_demande,
                instance_id, namespace_notebook_distant,
                etat_capture, capture_ponctuelle_demandee, arret_demande,
                relais_proxy_local=relais_proxy_local,
            ))
            _taches_projets_en_cours.add(tache)
            tache.add_done_callback(_taches_projets_en_cours.discard)
        loop.call_soon_threadsafe(_programmer)

    client_t.initialiser_notebook_distant_demande.connect(_sur_initialiser_notebook_distant_demande, Qt.DirectConnection)

    def _sur_fermer_notebook_distant_demande(session_id: str, id_pilote_demande: str):
        # PATCH (bouton "Fermer") -- même patron de programmation
        # (create_task via call_soon_threadsafe) que _sur_initialiser_
        # notebook_distant_demande ci-dessus, pour _sautoniax_fermer_
        # notebook_distant plutôt que _sautoniax_initialiser_notebook_distant.
        # Pas de nom_profil/instance_id à transmettre ici : ce mode
        # mono-profil n'a qu'un seul profil chargé à la fois (cf. docstring
        # de _sautoniax_fermer_notebook_distant), namespace_notebook_distant
        # suffit à le retrouver.
        def _programmer():
            tache = loop.create_task(_sautoniax_fermer_notebook_distant(
                client_t, session_id, id_pilote_demande, namespace_notebook_distant,
            ))
            _taches_projets_en_cours.add(tache)
            tache.add_done_callback(_taches_projets_en_cours.discard)
        loop.call_soon_threadsafe(_programmer)

    client_t.fermer_notebook_distant_demande.connect(_sur_fermer_notebook_distant_demande, Qt.DirectConnection)

    # BUGFIX CRITIQUE (spec A.3, suite) -- l'appel réel avait disparu lors
    # du déplacement précédent (seul le commentaire expliquant le
    # déplacement avait été inséré plus haut, cf. juste après l'attente de
    # connecte_event -- l'appel lui-même n'avait jamais été réinséré ICI,
    # si bien que "prêt" n'était plus JAMAIS envoyé, ni tôt ni tard). C'est
    # ICI, et seulement ICI, que TOUS les .connect() de commandes
    # (création de profil, logs, kill, démarrage isolé, notebook distant,
    # etc. -- cf. leur liste complète juste au-dessus) sont garantis posés,
    # donc c'est le seul endroit correct pour annoncer au pilote que ce
    # sAutoniax est réellement capable de traiter une commande.
    log.info("[sAutoniax] tous les gestionnaires de commandes sont connectés -- "
             "envoi du signal 'prêt' au serveurT.")
    client_t.envoyer_sautoniax_pret()

    if nom_profil is None:
        # Aucun --profil fourni : sAutoniax reste un pur exécutant en
        # ATTENTE -- connecté au serveurT, serveur local démarré (étape
        # 1bis ci-dessus, déjà capable de recevoir un projet distribué),
        # mais AUCUN téléchargement de profil ni lancement de Camoufox
        # tant qu'aucun projet/ordre distant ne le demande explicitement.
        # C'est le mode normal désormais pour un lancement "juste démarrer
        # l'appli" (cf. notebook Kaggle, plus de --profil dans la commande).
        log.info("[sAutoniax] aucun --profil fourni -- mode attente pure, "
                 "prêt à recevoir un projet distribué. Ctrl+C/SIGTERM pour arrêter.")
        client_t.envoyer_statut_executant("inactif")
        try:
            await arret_demande.wait()
        finally:
            log.info("[sAutoniax] arrêt -- fermeture du client serveurT.")
            for tache in list(_taches_projets_en_cours):
                tache.cancel()
            # PATCH (cf. docstring de _fermer_tous_procs_isoles) -- sans
            # cet appel, tout profil démarré via demander_demarrer_profil_
            # isole restait actif après ce finally et verrouillait son
            # user_data_dir pour la prochaine tentative de lancement.
            _fermer_tous_procs_isoles()
            # PATCH (section 6, "ce qui manque encore" -- câblage réel) :
            # ferme tous les ports TCP locaux + la connexion /ws_tunnel
            # éventuellement ouverts par un profil en proxy natif, avant
            # que le process ne sorte -- sinon les sockets asyncio.Server
            # restent ouverts jusqu'à la fin du process (aucun impact
            # fonctionnel puisque le process va terminer de toute façon,
            # mais évite un avertissement "coroutine never awaited"/
            # ressource non fermée dans les logs, et reste cohérent avec
            # les autres nettoyages explicites de ce même finally).
            try:
                await relais_proxy_local.arreter_tout()
            except Exception as e:
                log.debug(f"[sAutoniax] fermeture RelaisProxyLocal ignorée : {e!r}")
            if serveur_local_proc is not None:
                try:
                    serveur_local_proc.terminate()
                except OSError:
                    pass
            # PATCH (point 3) -- fermeture du client persistant utilisé
            # pour relayer captures/commandes des instances isolées, cf.
            # sa création plus haut. Avant client_t.arreter() : pas de
            # dépendance d'ordre réelle entre les deux (connexions
            # séparées), mais rester cohérent avec l'esprit "fermer les
            # canaux annexes avant le canal principal".
            client_pilote_instances.arreter()
            client_t.arreter()
        return etat_redemarrage["demande"]

    # --- Étape 2 : téléchargement + extraction du profil ---
    # Dossier LOCAL dédié à sAutoniax, sous AUTONIAX_DATA_DIR (cf.
    # _chemin_donnees) -- distinct du registre de profils normal de
    # mAutoniax (DOSSIER_RACINE_PROFILS/registre_profils.json) : un
    # sAutoniax est jetable par construction (aucune UI locale pour
    # gérer un vrai registre de profils nommés), donc un simple dossier
    # "sautoniax_profils/<nom_profil>/" suffit, sans dépendre du
    # registre JSON de mAutoniax.
    dossier_profil = await _sautoniax_assurer_profil_local(client_t, loop, nom_profil)
    if dossier_profil is None:
        client_t.envoyer_statut_executant("erreur")
        client_t.arreter()
        raise RuntimeError(f"Échec téléchargement profil '{nom_profil}'")

    # --- Étape 3 : lancement de Camoufox EN HEADLESS ---
    log.info("[sAutoniax] lancement de Camoufox (headless=True)...")
    # CORRECTIF (même bug que les 4 autres appelants de
    # camoufox_demarrer_navigateur/_sautoniax_lancer_instance_subprocess,
    # cf. docstring de _sautoniax_lancer_instance_subprocess) : proxy=None
    # était codé en dur ici aussi, alors que nom_profil est connu -- le
    # proxy configuré côté cloud pour ce profil n'était jamais lu ni
    # transmis pour ce chemin (mode legacy --profil CLI de sAutoniax).
    # PATCH (SPEC_proxy_natif_tunnel.md, section 13.4) : passe par
    # _resoudre_proxy_effectif_profil -- relais_proxy_local est
    # directement accessible ici (créé au tout début de cette même
    # fonction, cf. section 6).
    proxy_profil = await _resoudre_proxy_effectif_profil(nom_profil, relais_proxy_local)
    camoufox_cm, context, page, gestion, etat_navigateur = await camoufox_demarrer_navigateur(
        str(dossier_profil), instance_id, url_ouverture, download_dir=None, headless=True, proxy=proxy_profil,
        nom_profil=nom_profil, moteur=_moteur_playwright_pour_profil(nom_profil),
    )
    log.info("[sAutoniax] Navigateur Playwright démarré.")
    namespace_notebook_distant["page"] = page
    # PATCH (bouton "Initialiser") : le mode legacy --profil peuple aussi
    # camoufox_cm/profil_charge -- même raisonnement que la docstring de
    # _sautoniax_initialiser_notebook_distant, pour qu'une initialisation
    # demandée PAR LA SUITE depuis le Notebook Distant sache qu'il y a
    # bien un profil (celui du legacy) à fermer proprement avant d'en
    # charger un autre, plutôt que d'empiler un second Camoufox.
    namespace_notebook_distant["camoufox_cm"] = camoufox_cm
    namespace_notebook_distant["profil_charge"] = nom_profil
    # CORRECTIF (contrôle à distance -- cf. docstring de commande_
    # instance_recue côté ClientServeurT) : même ajout que dans
    # _sautoniax_initialiser_notebook_distant, pour que le pilotage à
    # distance fonctionne aussi quand le profil vient du legacy --profil
    # CLI (pas seulement du bouton "Initialiser" du Notebook Distant).
    namespace_notebook_distant["context"] = context
    namespace_notebook_distant["gestion"] = gestion
    namespace_notebook_distant["etat_navigateur"] = etat_navigateur

    # NOTE : arret_demande/_demander_arret, etat_capture/
    # capture_ponctuelle_demandee, et le câblage regler_capture_instance_
    # demande NE SONT PLUS déclarés ici -- déplacés avant l'étape 2 (cf.
    # bloc "mode attente pure" plus haut), pour exister même quand
    # nom_profil est None (CORRECTIF : _sur_initialiser_notebook_distant_
    # demande, câblé encore plus tôt, en a besoin dès qu'"Initialiser" est
    # cliqué -- cf. docstring de _sautoniax_initialiser_notebook_distant).
    # Réutilisés tels quels ci-dessous via _sautoniax_boucle_capture.
    #
    # CAS PARTICULIER volontaire pour CE chemin legacy (`--profil` CLI) :
    # etat_capture["actif"] est forcé à True ici, contrairement à sa valeur
    # par défaut (False, cf. sa déclaration plus haut) -- le notebook
    # Kaggle par défaut (CONTENU_NOTEBOOK_SAUTONIAX, section 6 "Suivi côté
    # mAutoniax") documente explicitement un aperçu "rafraîchi toutes les
    # INTERVALLE_CAPTURE_S secondes" dès le lancement du process, SANS
    # dépendre d'un clic sur "Automatique" côté mAutoniax -- ce chemin
    # n'est d'ailleurs même pas relié à un combo_executant_reseau/case_auto
    # avant que le sAutoniax soit déjà visible et en train de streamer.
    # CORRECTIF (retour utilisateur explicite : "cest moi qui doit activer
    # le rafraichissement") ne s'applique donc QU'au chemin "Initialiser"
    # (cf. _sautoniax_initialiser_notebook_distant, où "actif" reste à
    # False tant que le pilote ne l'active pas) -- jamais à `--profil` CLI,
    # dont le seul mode d'emploi connu (ce notebook) suppose la capture
    # automatique dès le démarrage.
    etat_capture["actif"] = True

    # --- Étape 4 : boucle de capture périodique ---
    try:
        await _sautoniax_boucle_capture(
            client_t, namespace_notebook_distant, instance_id,
            etat_capture, capture_ponctuelle_demandee, arret_demande,
            asyncio.Event(),  # arret_profil : jamais déclenché ici -- seul arret_demande arrête ce chemin legacy
        )
    finally:
        log.info("[sAutoniax] arrêt -- fermeture de Camoufox et du client serveurT.")
        for tache in list(_taches_projets_en_cours):
            tache.cancel()
        # PATCH (cf. docstring de _fermer_tous_procs_isoles, définie plus
        # haut dans cette fonction) -- même correctif que le finally du
        # mode attente pure ci-dessus : ce chemin (mode legacy --profil)
        # ferme jusqu'ici seulement le Camoufox "principal" (cm_a_fermer,
        # cf. plus bas), jamais les profils lancés en instances isolées.
        _fermer_tous_procs_isoles()
        # PATCH (section 6, "ce qui manque encore" -- câblage réel) :
        # même fermeture que le finally du mode attente pure ci-dessus,
        # cf. son commentaire -- ce chemin legacy peut lui aussi avoir
        # activé le proxy natif sur son profil.
        try:
            await relais_proxy_local.arreter_tout()
        except Exception as e:
            log.debug(f"[sAutoniax] fermeture RelaisProxyLocal ignorée : {e!r}")
        # Lu depuis namespace_notebook_distant plutôt que la variable
        # locale `camoufox_cm` de l'étape 3 -- CORRECTIF : si "Initialiser"
        # a remplacé ce profil legacy par un autre entre-temps (cf.
        # _sautoniax_initialiser_notebook_distant), c'est bien le Camoufox
        # ACTUELLEMENT actif qu'il faut fermer ici, pas l'ancien (déjà
        # fermé proprement par _sautoniax_initialiser_notebook_distant
        # elle-même -- un double __aexit__ serait un no-op inoffensif,
        # mais fermer le mauvais objet ne serait pas juste un no-op).
        cm_a_fermer = namespace_notebook_distant.get("camoufox_cm") or camoufox_cm
        try:
            await cm_a_fermer.__aexit__(None, None, None)
        except Exception as e:
            log.debug(f"[sAutoniax] fermeture Camoufox ignorée (probablement déjà fermé) : {e!r}")
        if serveur_local_proc is not None:
            try:
                serveur_local_proc.terminate()
            except OSError:
                pass
        # PATCH (point 3) -- même fermeture que dans le finally du mode
        # attente pure ci-dessus, cf. son commentaire.
        client_pilote_instances.arreter()
        client_t.arreter()

    return etat_redemarrage["demande"]


def main_sautoniax():
    """Point d'entrée du mode sAutoniax (PATCH -- demande explicite
    utilisateur : exécuter un exécutant AutoniaX headless, ex. sur
    Kaggle, connecté au serveurT plutôt qu'au serveur local de
    mAutoniax). Process séparé, lancé manuellement (ex. depuis un
    notebook Kaggle : `python AutoniaX.py --sautoniax --profil <nom>
    --instance-id <id>`) -- PAS lancé par subprocess.Popen depuis
    mAutoniax comme main_instance_nodriver(), puisque le sAutoniax
    tourne par construction sur une machine séparée de mAutoniax.

    Aucune QApplication créée sur ce chemin (cf. dispatch sur sys.argv
    en fin de fichier) -- ClientServeurT hérite de QObject/Signal mais
    fonctionne sans boucle d'événements Qt : les signaux sont utilisés
    ici en mode direct (connect/emit synchrones), pas via un
    QEventLoop, cf. PySide6 -- une QApplication n'est nécessaire que
    pour les widgets et l'intégration de la boucle d'événements Qt native,
    aucun des deux n'est utilisé ici."""
    parser = argparse.ArgumentParser(description="Exécutant sAutoniax (headless, ex. Kaggle)")
    parser.add_argument("--sautoniax", action="store_true", help="Active le mode sAutoniax (cf. dispatch fin de fichier)")
    # PATCH (demande explicite utilisateur : sAutoniax ne doit plus jamais
    # télécharger/exécuter de profil de lui-même au démarrage) : --profil
    # devient OPTIONNEL (était required=True) -- omis, le sAutoniax
    # démarre en mode "connecté, en attente pure" (cf. _main_async_
    # sautoniax, branche nom_profil is None), prêt à recevoir un projet
    # distribué via le serveur local, sans jamais toucher à un profil ni
    # lancer Camoufox tant que rien ne le lui demande explicitement.
    parser.add_argument("--profil", default=None, help="(Optionnel, mode legacy) Nom du profil à télécharger depuis le stockage B2 (Profils/<nom>.zip) et charger immédiatement. Omis par défaut : sAutoniax démarre en simple attente, sans profil.")
    parser.add_argument("--instance-id", default=None, help="Identifiant de l'instance (défaut : dérivé du nom du profil, ou 'sautoniax' si --profil est omis)")
    # PATCH (plus de repli Render -- SERVEUR_T_URL supprimée) -- défaut
    # vide : de toute façon réécrite par resoudre_url_serveurt() à CHAQUE
    # tentative de connexion côté ClientServeurT._boucle_async (lecture
    # ServeurT/url_tunnel.txt sur B2), cette valeur ne sert que de
    # placeholder avant la première tentative.
    parser.add_argument("--server-url-t", default="", help="URL du serveurT (optionnel -- résolue automatiquement via Backblaze B2 à chaque tentative de connexion, cf. resoudre_url_serveurt)")
    parser.add_argument("--url", default=None, help="Site ouvert par défaut au démarrage (prioritaire sur la welcome page AutoniaX)")
    parser.add_argument("--intervalle-capture", type=float, default=5.0, help="Secondes entre deux captures envoyées au serveurT (défaut 5.0)")
    args = parser.parse_args()

    # Garde-fou explicite (PATCH -- demande explicite utilisateur :
    # Kaggle/Linux) : sans AUTONIAX_DATA_DIR, _chemin_donnees() retombe
    # sur le chemin Windows en dur D:\ScaleTube\... (cf. sa docstring),
    # qui échouerait de façon confuse (mkdir sur un chemin Windows
    # invalide sous Linux) une fois le téléchargement de profil déjà
    # bien avancé. Mieux vaut échouer tout de suite avec un message
    # explicite que de laisser _main_async_sautoniax planter à mi-course.
    if sys.platform != "win32" and AUTONIAX_DATA_ROOT is None:
        log.error(
            "[sAutoniax] variable d'environnement AUTONIAX_DATA_DIR non définie -- "
            "requise sur toute machine non-Windows (Kaggle, Linux...) pour savoir où "
            "stocker le profil téléchargé. Exemple : "
            "AUTONIAX_DATA_DIR=/kaggle/working/autoniax_data python AutoniaX.py --sautoniax ..."
        )
        sys.exit(1)

    # PATCH (--profil désormais optionnel) : dérivation de instance_id
    # adaptée -- args.profil peut être None (mode attente pure), auquel
    # cas _nom_dossier_valide(None) n'a pas de sens ; retombe simplement
    # sur "sautoniax" dans ce cas.
    if args.instance_id:
        instance_id = args.instance_id
    elif args.profil:
        instance_id = f"sautoniax-{_nom_dossier_valide(args.profil)}"
    else:
        instance_id = "sautoniax"

    # CORRECTIF (filet de sécurité de dernier recours -- cf. docstring
    # complète du correctif principal dans _fermer_tous_procs_isoles,
    # qui débloque explicitement toute requête executer_code encore en
    # attente AVANT ce point) : asyncio.run() ferme sa boucle via
    # Runner.close(), qui appelle en interne
    # loop.run_until_complete(loop.shutdown_default_executor(
    # constants.THREAD_JOIN_TIMEOUT)) -- THREAD_JOIN_TIMEOUT valant 300s
    # (Python 3.12), CE PROCESS ENTIER RESTE FIGÉ JUSQU'À 5 MINUTES si le
    # moindre thread du pool par défaut (run_in_executor(None, ...), et
    # ce fichier en compte des dizaines de sites d'appel) est encore en
    # vie à la sortie de _main_async_sautoniax, pour QUELQUE RAISON QUE
    # CE SOIT -- y compris une cause future non encore identifiée,
    # distincte de celle déjà corrigée ci-dessus. Le correctif principal
    # traite la cause connue à la racine ; celui-ci borne l'IMPACT même
    # si une autre cause, connue ou non, venait à en laisser un autre
    # trainer -- un exécutant sAutoniax doit redémarrer en quelques
    # secondes, jamais rester injoignable 5 minutes sans aucun signal
    # (aucun log n'est même émis pendant l'attente elle-même, cf. le
    # RuntimeWarning constaté, qui n'apparaît qu'APRÈS coup).
    #
    # Reproduit donc manuellement le corps de asyncio.run() (créer une
    # boucle, y exécuter la coroutine, la fermer) mais avec un délai de
    # jointure du pool RÉDUIT et EXPLICITE plutôt que la valeur par
    # défaut -- toute la logique métier (_main_async_sautoniax et son
    # propre `finally`, qui a déjà eu l'occasion de tout fermer proprement
    # AVANT qu'on atteigne ce point) est strictement inchangée ; seul le
    # comportement de la phase finale de fermeture de la boucle diffère.
    DELAI_JOINTURE_POOL_EXECUTOR_S = 10.0
    loop_principale = asyncio.new_event_loop()
    asyncio.set_event_loop(loop_principale)
    try:
        redemarrage_demande = loop_principale.run_until_complete(_main_async_sautoniax(
            args.server_url_t, args.profil, instance_id, args.url, args.intervalle_capture,
        ))
    except KeyboardInterrupt:
        redemarrage_demande = False
    except Exception as e:
        log.error(f"[sAutoniax] erreur fatale : {e!r}")
        sys.exit(1)
    finally:
        try:
            _taches_restantes = asyncio.all_tasks(loop_principale)
            for _tache_restante in _taches_restantes:
                _tache_restante.cancel()
            if _taches_restantes:
                loop_principale.run_until_complete(
                    asyncio.gather(*_taches_restantes, return_exceptions=True)
                )
            loop_principale.run_until_complete(loop_principale.shutdown_asyncgens())
            try:
                loop_principale.run_until_complete(
                    loop_principale.shutdown_default_executor(DELAI_JOINTURE_POOL_EXECUTOR_S)
                )
            except TypeError:
                # shutdown_default_executor(timeout=...) n'existe que
                # depuis Python 3.9 -- filet de compatibilité best-effort
                # si jamais exécuté sous une version antérieure (ne
                # devrait pas arriver sur Kaggle, gardé par robustesse) :
                # pas de timeout réduit possible dans ce cas précis, mais
                # ne doit jamais empêcher la sortie du process pour
                # autant.
                log.warning(
                    "[sAutoniax] shutdown_default_executor sans paramètre "
                    "timeout sur cette version de Python -- fermeture de "
                    "la boucle sans attente réduite du pool."
                )
        except Exception as e:
            log.warning(f"[sAutoniax] nettoyage final de la boucle asyncio ignoré (non bloquant) : {e!r}")
        finally:
            asyncio.set_event_loop(None)
            loop_principale.close()

    # NOTE : ce bloc n'est plus dans un `else:` du try/except ci-dessus
    # (impossible syntaxiquement avec le `finally` ajouté par le
    # correctif) -- équivalent au comportement précédent puisque les deux
    # branches `except` ci-dessus se terminent soit par une simple
    # affectation (KeyboardInterrupt, redemarrage_demande=False -- ce
    # bloc s'exécute alors mais sort immédiatement sans rien faire vu la
    # condition juste en dessous), soit par sys.exit(1) (Exception, qui
    # empêche d'atteindre ce point de toute façon) -- jamais atteint sur
    # erreur fatale, exactement comme avant.
    if redemarrage_demande:
        log.info(
            f"[sAutoniax] redémarrage demandé par le pilote -- sortie avec le code "
            f"{CODE_SORTIE_REDEMARRAGE} (surveillé par la boucle de supervision du notebook)."
        )
        sys.exit(CODE_SORTIE_REDEMARRAGE)


def _fabriquer_attendre_navigateur_pret(moteur_relais, instance_id: str):
    """AJOUT -- construit attendre_navigateur_pret() exposée au code d'une cellule (process exécuteur)."""
    def attendre_navigateur_pret(timeout_s: float = 60.0, intervalle_s: float = 1.0) -> bool:
        """Bloque jusqu'à ce que le navigateur de cette cellule réponde (commande listTabs réussie).
        Retourne True ; lève TimeoutError au bout de `timeout_s`. Utile après regenerer_navigateur(),
        après un plantage, ou avant une action sensible. Refait la liaison au besoin."""
        fin = time.monotonic() + float(timeout_s)
        derniere_erreur = "aucune réponse"
        while True:
            moteur_relais.reinitialiser_liaison()
            reste = fin - time.monotonic()
            resultat = moteur_relais._appeler(instance_id, "listTabs", {}, max(1.0, min(10.0, reste)))
            if resultat.get("ok"):
                return True
            derniere_erreur = str(resultat.get("error") or "réponse négative")
            if time.monotonic() >= fin:
                raise TimeoutError(
                    f"attendre_navigateur_pret() : le navigateur n'est pas prêt après {timeout_s:.0f}s ({derniere_erreur})."
                )
            time.sleep(float(intervalle_s))
    return attendre_navigateur_pret


def _fabriquer_avec_reessais(attendre_navigateur_pret, namespace: dict):
    """AJOUT -- construit avec_reessais() exposée au code d'une cellule (process exécuteur)."""
    def avec_reessais(fonction, *args, essais=None, attente_s: float = 2.0, exceptions=(Exception,), **kwargs):
        """Appelle fonction(*args, **kwargs). Sur exception (celles de `exceptions`), attend que le
        navigateur soit de nouveau prêt puis réessaie, `essais` fois en plus du premier appel
        (défaut : la variable RETRY de la cellule « Variable dynamique », sinon 3). Relève la
        dernière exception si tous les essais échouent."""
        total = int(essais if essais is not None else namespace.get("RETRY", 3) or 0)
        derniere = None
        for tentative in range(total + 1):
            try:
                return fonction(*args, **kwargs)
            except exceptions as exc:
                derniere = exc
                if tentative >= total:
                    break
                try:
                    attendre_navigateur_pret(timeout_s=30.0)
                except Exception:
                    pass
                time.sleep(float(attente_s))
        raise derniere
    return avec_reessais


def _fabriquer_regenerer_navigateur(client_executeur, client_pilote_instances, moteur_relais, attendre_navigateur_pret,
                                    instance_id: str, session_id: str, id_pilote: str):
    """AJOUT -- construit la fonction regenerer_navigateur() exposée au code d'une cellule exécutée sur
    un profil isolé (process exécuteur). Aucun argument obligatoire : elle s'applique au navigateur de
    CETTE instance. L'exécuteur N'EST PAS arrêté : seul le navigateur est remplacé (même instance_id),
    la cellule reprend après l'appel avec toutes ses variables."""
    def regenerer_navigateur(garder_donnees: bool = False, relancer: bool = True, timeout_s: float = 300.0,
                             attendre_pret: bool = True) -> dict:
        """Régénère le navigateur sur lequel tourne cette cellule : nouvelle empreinte, MÊME proxy/IP et
        même nom de profil. Cookies/données supprimés par défaut (garder_donnees=True pour les garder).

        BLOQUE jusqu'à ce que le nouveau navigateur soit démarré (et, si attendre_pret=True, qu'il
        réponde), puis retourne {"ok": True, "instance_id": ..., "message": ...} ; la cellule continue,
        ses variables sont conservées. Les onglets/pages de l'ancien navigateur sont perdus (le nouveau
        démarre sur une page vierge). Lève RuntimeError si la régénération échoue, TimeoutError si elle
        dépasse `timeout_s` ou si le navigateur ne devient pas prêt."""
        if not relancer:
            raise ValueError("regenerer_navigateur(relancer=False) n'est pas supporté depuis une cellule : sans navigateur le code ne peut plus tourner.")
        evenement = threading.Event()
        boite: dict = {}

        def _sur_resultat(data: dict):
            if data.get("instance_id") != instance_id:
                return
            boite["data"] = data
            evenement.set()

        client_pilote_instances.regenerer_navigateur_resultat_recu.connect(_sur_resultat, Qt.DirectConnection)
        try:
            client_executeur.envoyer_regenerer_navigateur(instance_id, session_id, id_pilote, garder_donnees, True)
            if not evenement.wait(timeout=float(timeout_s)):
                raise TimeoutError(f"regenerer_navigateur() : aucune réponse du sAutoniax après {timeout_s:.0f}s.")
        finally:
            try:
                client_pilote_instances.regenerer_navigateur_resultat_recu.disconnect(_sur_resultat)
            except (RuntimeError, TypeError):
                pass
        reponse = boite["data"]
        if not reponse.get("ok"):
            raise RuntimeError(f"regenerer_navigateur() a échoué : {reponse.get('message', 'erreur inconnue')}")
        moteur_relais.reinitialiser_liaison()
        if attendre_pret:
            attendre_navigateur_pret(timeout_s=60.0)
        return {"ok": True, "instance_id": instance_id, "message": reponse.get("message", "")}
    return regenerer_navigateur


class _ExecuteurClientTAdaptateur:
    """AJOUT (Section 8 -- Image.view() depuis le process exécuteur, cf.
    échange utilisateur : "la plus propre et robuste" -- option B
    retenue : PAS de connexion ClientServeurT distante supplémentaire
    ouverte par l'exécuteur, l'image fait un détour par le process
    principal qui l'envoie via SA connexion existante). Faux "client_t"
    glissé dans _contexte_reseau à la place du VRAI ClientServeurT (cf.
    _construire_composants_direct, propagé jusqu'à Image._contexte_
    reseau) -- implémente UNIQUEMENT envoyer_notebook_distant_image
    (seule méthode de client_t jamais appelée via _contexte_reseau, cf.
    Image.view(), vérifié par grep avant ce choix), ce qui suffit à ce
    que Image.view() continue de fonctionner SANS AUCUNE modification de
    son propre code -- elle continue d'appeler client_t.envoyer_
    notebook_distant_image(session_id, id_pilote, image_b64) exactement
    comme avant, sans savoir qu'elle parle à cet adaptateur plutôt qu'au
    vrai ClientServeurT distant.

    Redirige l'appel vers client_executeur.envoyer_executer_code_image
    (canal LOCAL vers le process principal, cf. sa docstring), qui
    retransmet lui-même au pilote via son propre client_t (celui-là bien
    réel, cf. _sur_executer_code_image_recu dans _main_async_sautoniax).
    Retourne toujours True (fire-and-forget, même contrat apparent que
    ClientServeurT.envoyer_notebook_distant_image qui retourne un bool de
    succès d'ENVOI LOCAL au websocket, jamais une confirmation de bout en
    bout -- cf. sa docstring, aucune différence sémantique ici)."""

    def __init__(self, client_executeur: "ClientReseauAutoniaX", instance_id: str):
        self._client_executeur = client_executeur
        self._instance_id = instance_id

    def envoyer_notebook_distant_image(self, session_id: str, id_pilote: str, image_b64: str) -> bool:
        self._client_executeur.envoyer_executer_code_image(self._instance_id, session_id, id_pilote, image_b64)
        return True

    def envoyer_notebook_distant_log(self, session_id: str, id_pilote: str, ligne: str) -> bool:
        """PATCH sortie en direct : une ligne de stdout/stderr, relayée au pilote par le process principal."""
        self._client_executeur.envoyer_executer_code_image(self._instance_id, session_id, id_pilote, "", ligne=ligne)
        return True


def main_executeur_sautoniax():
    """AJOUT (Section 8, "Arrêter" interrompt le CODE, pas le profil, cf.
    PLAN_section_8_arreter.md §7 étape 2) -- point d'entrée du nouveau
    TROISIÈME process : l'exécuteur de code d'un profil isolé, distinct
    du process principal du sAutoniax ET du sous-processus navigateur
    (_procs_isoles). Lancé paresseusement par _sautoniax_executer_
    notebook_distant_sur_instance_isolee (process principal, cf. son
    corps) via subprocess.Popen([sys.executable, __file__,
    "--mode-executeur", "--instance-id", <id du navigateur>, "--port",
    str(PORT_SERVEUR_DASHBOARD)]) -- un exécuteur par profil isolé,
    vivant tant qu'"Arrêter" n'a pas été cliqué sur ce profil (cf. §3/§4
    du plan : "Arrêter" = terminate() sur CE process, ce qui détruit son
    namespace avec lui -- comportement voulu).

    DEUX connexions simultanées au même serveur local (ws://127.0.0.1:
    <port>, serveur_dashboard) depuis ce seul process, à ne jamais
    confondre (cf. §7.3 du plan) :
      - role="executeur" (self.client_executeur ci-dessous) : reçoit le
        code à exécuter (executer_code_recu) depuis le PROCESS PRINCIPAL
        du sAutoniax, répond via envoyer_executer_code_resultat.
      - role="pilote" (client_pilote_instances ci-dessous) : pilote le
        NAVIGATEUR de ce même profil isolé (instance_id reçu en
        argument), via le protocole command/command_result déjà
        existant -- _MoteurRelaisPourComposantIsole (classe EXISTANTE,
        RÉUTILISÉE TELLE QUELLE, cf. sa docstring) tourne ICI, dans ce
        process exécuteur, au lieu du process principal comme avant ce
        chantier -- aucun changement de code nécessaire dans cette
        classe elle-même, seulement un nouveau site d'instanciation.

    Namespace Python résident (self._namespace, dict simple) : persiste
    tant que CE process vit, entre deux cellules "executer_code" reçues
    -- cf. §3 du plan ("ce qui doit persister entre deux cellules -- et
    où"). Aucune sérialisation : le process principal n'a plus besoin de
    connaître ce namespace du tout pour un profil isolé (simplification
    par rapport à l'ancien _namespaces_isoles, qui vivait côté process
    principal -- cf. §3, dernier paragraphe).

    IMPORTANT (même piège que main_sautoniax, cf. sa docstring et la
    docstring de _MoteurRelaisPourComposantIsole._connecter_ecoute) :
    AUCUNE QApplication/QCoreApplication n'est créée sur ce chemin --
    toute connexion de signal Qt ci-dessous et dans _MoteurRelaisPour
    ComposantIsole DOIT donc utiliser Qt.DirectConnection explicitement,
    jamais le défaut Qt.AutoConnection (qui se comporterait comme
    QueuedConnection entre threads différents et ne se déclencherait
    jamais, faute de boucle d'événements Qt qui tourne ici)."""
    parser = argparse.ArgumentParser(description="Exécuteur de code sAutoniax (profil isolé, cf. Section 8)")
    parser.add_argument("--mode-executeur", action="store_true", help="Active ce mode (cf. dispatch fin de fichier)")
    parser.add_argument("--instance-id", required=True, help="instance_id du NAVIGATEUR piloté (subprocess _procs_isoles existant), PAS un id propre à l'exécuteur -- cf. docstring de classe.")
    parser.add_argument("--port", type=int, default=PORT_SERVEUR_DASHBOARD)
    parser.add_argument("--host", default="127.0.0.1")
    args = parser.parse_args()

    instance_id = args.instance_id
    server_url = f"ws://{args.host}:{args.port}"
    class _HandlerJournalInstance(logging.Handler):
        """PATCH journal par profil : les logs de CE process exécuteur vont aussi au journal du profil."""
        def emit(self, record):
            try:
                _journal_instance_ajouter(instance_id, self.format(record))
            except Exception:
                pass

    _handler_journal = _HandlerJournalInstance()
    _handler_journal.setFormatter(logging.Formatter("%(levelname)s %(name)s: %(message)s"))
    logging.getLogger().addHandler(_handler_journal)
    log.info(f"[executeur:{instance_id}] démarrage -- server_url={server_url!r}")

    namespace: dict = {"__builtins__": __builtins__}

    # --- Connexion n°1 : role="executeur" -- reçoit le code, répond ---
    # id_client = instance_id du navigateur : c'est ainsi que le process
    # principal RETROUVE cet exécuteur précis (cf. srv_gerer_executer_
    # code, routage par instance_id -- un seul exécuteur possible par
    # instance_id de navigateur, cf. docstring de srv_ExecuteurInfo).
    client_executeur = ClientReseauAutoniaX(server_url, role="executeur", id_client=instance_id)

    # --- Connexion n°2 : role="pilote" -- pilote le navigateur ---
    # id_client distinct et unique (cf. AVERTISSEMENT dans la docstring
    # de ClientReseauAutoniaX : deux connexions avec le MÊME id_client
    # s'écraseraient silencieusement côté serveur) -- suffixe "executeur"
    # pour le distinguer dans les logs serveur d'un éventuel pilote
    # classique (TestComposantScreen) ou du client_pilote_instances du
    # process principal du sAutoniax (celui-ci pilote potentiellement
    # PLUSIEURS instances légataires/batch à la fois ; celui-ci n'en
    # pilote qu'une seule, fixée à la construction).
    client_pilote_instances = ClientReseauAutoniaX(
        server_url, role="pilote", id_client=f"executeur-pilote-{instance_id}-{uuid.uuid4().hex[:6]}",
    )

    moteur_relais = _MoteurRelaisPourComposantIsole(instance_id, client_pilote_instances)

    pret_executeur = threading.Event()
    pret_pilote = threading.Event()
    client_executeur.connecte.connect(lambda: pret_executeur.set(), Qt.DirectConnection)
    client_pilote_instances.connecte.connect(lambda: pret_pilote.set(), Qt.DirectConnection)

    def _sur_executer_code(data: dict):
        # Tourne sur le thread réseau de client_executeur (Qt.
        # DirectConnection, cf. docstring de classe ci-dessus) --
        # délègue IMMÉDIATEMENT l'exécution réelle à un thread séparé
        # (même raison EXACTE que _exec_thread/run_in_executor côté
        # process principal, cf. docstring de _sautoniax_executer_
        # notebook_distant_sur_instance_isolee : ne jamais bloquer le
        # thread réseau lui-même le temps d'une cellule potentiellement
        # longue, sous peine de ne plus jamais pouvoir recevoir/émettre
        # le moindre message réseau, y compris un futur executer_code
        # sur ce même canal une fois cette cellule terminée).
        requete_id = data.get("requete_id", "")
        code = data.get("code", "")
        session_id = data.get("session_id", "")
        id_pilote = data.get("id_pilote", "")
        services_api_lies = data.get("services_api_lies") or {}
        reinitialiser_result_color = bool(data.get("reinitialiser_result_color", False))
        lire_result_color_finale = bool(data.get("lire_result_color_finale", False))

        def _executer():
            # AJOUT (§3 du plan -- construction des Composants/ServiceAPI
            # DÉPLACÉE ici depuis _sautoniax_executer_notebook_distant_
            # sur_instance_isolee, cf. son ancienne docstring pour le
            # détail complet du mécanisme repris tel quel : candidats_
            # service_api, ServiceAPIExecutableRelaisIsole générique
            # rafraîchi À CHAQUE cellule, composants_directs qui écrase
            # ensuite pour chaque candidat couvert par un vrai Composant
            # préfixé -- logique INCHANGÉE, seul le PROCESS qui l'exécute
            # change). _contexte_reseau utilise _ExecuteurClientTAdaptateur
            # (PAS le vrai client_t distant, jamais présent dans ce
            # process, cf. sa docstring) -- Image.view() continue de
            # fonctionner sans aucune modification de son propre code.
            _contexte_reseau_local = {
                "client_t": _ExecuteurClientTAdaptateur(client_executeur, instance_id),
                "session_id": session_id, "id_pilote": id_pilote,
            }
            if services_api_lies and "Api2Api" not in namespace:
                # _construire_espace_noms_api2api(client_t) attend un
                # VRAI ClientServeurT (Api2Api parle au serveurT distant
                # pour des opérations qui dépassent le simple envoi
                # d'image) -- hors scope du présent chantier (jamais
                # utilisé par le panneau clone/profils isolés à ce jour,
                # cf. plan). Omis ici plutôt que de faire planter
                # l'exécuteur sur un NameError tardif si un script en
                # fait usage : reste absent du namespace comme c'était
                # déjà tacitement le cas pour tout profil isolé avant ce
                # chantier (l'ancien code l'injectait via client_t du
                # PROCESS PRINCIPAL -- un vrai ClientServeurT existait
                # bien là-bas, mais rien n'indique qu'un script de
                # profil isolé l'ait jamais réellement utilisé).
                namespace.setdefault("textFile", textFile)
                namespace.setdefault("TextFile", TextFile)
            # AJOUT (transfert de fichiers ALLER, cf. CODE_DECODAGE_
            # FICHIERS_LIST_TASKS) -- INCONDITIONNEL (contrairement au bloc
            # ci-dessus, réservé à services_api_lies) : le code injecté en
            # préfixe de LIST_TASKS s'exécute via exec() dans CE namespace,
            # qui ne contient au départ que __builtins__ -- il a donc besoin
            # de `os` et de _decoder_fichiers_api2api (fonction MODULE, non
            # importable par nom car ce fichier est lancé comme script
            # __main__). setdefault : jamais écrasé si déjà présent.
            namespace.setdefault("os", os)
            namespace.setdefault("_decoder_fichiers_api2api", _decoder_fichiers_api2api)
            # AJOUT (regenerer_navigateur() sans argument) -- rebindé à CHAQUE cellule (session_id/id_pilote).
            _attendre_pret = _fabriquer_attendre_navigateur_pret(moteur_relais, instance_id)
            namespace["attendre_navigateur_pret"] = _attendre_pret
            namespace["avec_reessais"] = _fabriquer_avec_reessais(_attendre_pret, namespace)
            namespace["regenerer_navigateur"] = _fabriquer_regenerer_navigateur(
                client_executeur, client_pilote_instances, moteur_relais, _attendre_pret,
                instance_id, session_id, id_pilote,
            )
            # AJOUT (envoi en direct vers le pilote, cf. _fabriquer_envoyer_resultat) --
            # rebinde A CHAQUE cellule : session_id/id_pilote peuvent changer d'un appel à l'autre
            # sur le même exécuteur. Réutilise le canal Image.view() (déjà relayé en direct par
            # le serveurT jusqu'au pilote), le payload est reconnu par son marqueur côté pilote.
            namespace["envoyer_resultat"] = _fabriquer_envoyer_resultat(
                lambda _p, _ctx=_contexte_reseau_local: _ctx["client_t"].envoyer_notebook_distant_image(
                    _ctx["session_id"], _ctx["id_pilote"], MARQUEUR_RESULTAT_LIVE + json.dumps(_p, ensure_ascii=False)
                )
            )
            # AJOUT (pont fichiers pilote <-> clone) -- le code du notebook garde ses open()/os.* sur des chemins du PC
            # (« D:/... ») : `os` et `open` de CET espace de noms passent par le pilote (cf. bloc PONT PILOTE <-> CLONE).
            # Contexte rebindé à chaque cellule (session_id/id_pilote changent d'un appel à l'autre).
            if pont_fichiers_actif_par_defaut():
                def _emetteur_pont(charge, _ns=namespace):
                    _p = _ns.get("__pont_pilote__")
                    if _p is None or not _p.session_id or not _p.id_pilote:
                        return False
                    client_executeur.envoyer_executer_code_image(_p.instance_id, _p.session_id, _p.id_pilote, charge)
                    return True
                installer_pont_fichiers(namespace, _emetteur_pont).definir_contexte(session_id, id_pilote, instance_id)
            if reinitialiser_result_color:
                # AJOUT (alias RESULT_COLOR en majuscule, cohérent avec
                # RETRY/TIMEOUT/.../WORKSPACE de CODE_VARIABLES_DYNAMIQUES_
                # DEFAUT) : les deux clés sont réinitialisées ensemble --
                # "result_color" (minuscule) reste la clé canonique lue
                # plus bas (cf. lire_result_color_finale), RESULT_COLOR
                # n'est qu'un nom d'usage exposé à l'utilisateur dans la
                # cellule Variable dynamique. Réinitialisées à
                # COULEUR_RESULT_COLOR_DEFAUT (vert foncé), pas blanc.
                namespace["result_color"] = COULEUR_RESULT_COLOR_DEFAUT
                namespace["RESULT_COLOR"] = COULEUR_RESULT_COLOR_DEFAUT
                # AJOUT (transfert RESULT_OUTPUT) -- même moment EXACT que
                # RESULT_COLOR : remis à None en début de lot, pour qu'un
                # résultat du lot précédent ne soit jamais renvoyé deux fois.
                namespace["RESULT_OUTPUT"] = None
            if services_api_lies:
                candidats_service_api = _extraire_noms_candidats_service_api(code, namespace)
                noms_service_api_a_rafraichir = set(services_api_lies.keys()) | candidats_service_api
                for nom_candidat in noms_service_api_a_rafraichir:
                    namespace[nom_candidat] = ServiceAPIExecutableRelaisIsole(
                        nom_candidat, instance_id, moteur_relais, namespace,
                    )
                composants_directs = _construire_composants_direct(
                    None, None, None, None, None, services_api_lies, namespace,
                    _contexte_reseau=_contexte_reseau_local,
                    _moteur_direct_override=moteur_relais,
                )
                namespace.update(composants_directs)
                if composants_directs:
                    log.info(
                        f"[executeur:{instance_id}] Composant(s) injecté(s) dynamiquement : {sorted(composants_directs)}."
                    )
            code_normalise = _normaliser_indentation_tabs_espaces(code)
            _client_log = _contexte_reseau_local["client_t"]

            class _FluxEnDirectExecuteur(io.StringIO):
                """PATCH sortie en direct : chaque ligne écrite est envoyée au pilote immédiatement (comme le mode
                mono-profil). Avant, tout restait dans ce tampon jusqu'à la fin de la cellule : « Arrêter » tuait
                l'exécuteur et la sortie était perdue. getvalue() reste vide : plus rien à renvoyer à la fin."""
                _nb_lignes_envoyees = 0

                def write(self_flux, texte):
                    _journal_instance_ajouter(instance_id, texte)  # PATCH journal par profil (même si coupé)
                    # Mode silencieux (AUTONIAX_SILENCIEUX=1), sortie coupée pour ce profil, ou session inconnue :
                    # le texte reste dans le tampon, RIEN n'est envoyé au notebook du pilote.
                    if _sortie_logs_coupee(instance_id) or not session_id or not id_pilote:
                        return super().write(texte)
                    # PATCH forcer l'affichage : sortie réactivée en cours de cellule -> on rattrape d'abord
                    # ce qui a été gardé en tampon pendant la coupure, puis la nouvelle ligne.
                    en_retard = self_flux.getvalue()
                    if en_retard:
                        self_flux.seek(0)
                        self_flux.truncate(0)
                    for ligne in (en_retard + texte).splitlines():
                        if ligne:
                            try:
                                _client_log.envoyer_notebook_distant_log(session_id, id_pilote, ligne)
                                self_flux._nb_lignes_envoyees += 1
                                if self_flux._nb_lignes_envoyees == 1:
                                    log.info(f"[executeur:{instance_id}] sortie en direct : 1re ligne envoyée au pilote (session={session_id!r}).")
                            except Exception as _e_flux:
                                log.warning(f"[executeur:{instance_id}] sortie en direct : envoi impossible ({_e_flux!r}).")
                    return len(texte)

            log.info(
                f"[executeur:{instance_id}] cellule démarrée (requete_id={requete_id!r}, session={session_id!r}, "
                f"id_pilote={id_pilote!r}) -- mode silencieux={'OUI (AUTONIAX_SILENCIEUX=1 : la sortie ne sera envoyee qu a la fin)' if _sortie_logs_coupee(instance_id) else 'non'}."
            )
            flux = _FluxEnDirectExecuteur()
            ok = True
            erreur = ""
            try:
                with _capturer_stdout_stderr_thread_courant(flux):
                    exec(code_normalise, namespace)
            except Exception as e:
                ok = False
                erreur = f"{e.__class__.__name__}: {e}\n{traceback.format_exc()}"
            sortie = flux.getvalue()
            if _sortie_logs_coupee(instance_id):
                sortie = ""  # PATCH : sortie coupée pour ce profil -> rien n'est renvoyé non plus à la fin (le journal la garde)
            result_color = None
            if lire_result_color_finale:
                # AJOUT (alias RESULT_COLOR) : si l'utilisateur a modifié
                # RESULT_COLOR (majuscule, variable dynamique par défaut)
                # à une valeur différente de sa réinitialisation
                # (COULEUR_RESULT_COLOR_DEFAUT, vert foncé), elle est
                # prioritaire -- sinon on retombe sur l'ancienne clé
                # "result_color" (minuscule) pour ne rien casser côté
                # scripts existants qui l'utilisent déjà telle quelle.
                _valeur_majuscule = namespace.get("RESULT_COLOR", COULEUR_RESULT_COLOR_DEFAUT)
                if _hex_couleur_valide(_valeur_majuscule) and _valeur_majuscule.upper() != COULEUR_RESULT_COLOR_DEFAUT.upper():
                    _valeur_brute = _valeur_majuscule
                else:
                    _valeur_brute = namespace.get("result_color", COULEUR_RESULT_COLOR_DEFAUT)
                result_color = _valeur_brute.lower() if _hex_couleur_valide(_valeur_brute) else COULEUR_RESULT_COLOR_DEFAUT
            # AJOUT (transfert RESULT_OUTPUT) -- lu UNIQUEMENT à la fin du
            # lot (même condition que result_color) et seulement si la
            # cellule a réussi. Jamais d'exception vers l'appelant.
            result_output = None
            if lire_result_color_finale and ok:
                try:
                    result_output = _serialiser_result_output(namespace.get("RESULT_OUTPUT"))
                except Exception as e_ro:
                    result_output = {"type": "erreur", "message": f"lecture de RESULT_OUTPUT impossible : {e_ro!r}"}
            log.info(
                f"[executeur:{instance_id}] cellule exécutée (requete_id={requete_id!r}) -- ok={ok} "
                f"sortie={len(sortie)} caractère(s) result_output={'oui' if result_output else 'non'}."
            )
            client_executeur.envoyer_executer_code_resultat(
                instance_id, requete_id, ok, erreur=erreur, sortie=sortie, result_color=result_color,
                result_output=result_output,
            )

        threading.Thread(target=_executer, name=f"executeur-cellule-{requete_id}", daemon=True).start()

    client_executeur.executer_code_recu.connect(_sur_executer_code, Qt.DirectConnection)
    def _sur_pont_reponse(data: dict):
        # AJOUT (pont fichiers pilote <-> clone) -- débloque l'appel de fichier en attente dans le code du notebook.
        _pont = namespace.get("__pont_pilote__")
        if _pont is not None:
            _pont.livrer(data)

    client_executeur.pont_reponse_recue.connect(_sur_pont_reponse, Qt.DirectConnection)

    def _gerer_signal(signum, frame):
        log.info(f"[executeur:{instance_id}] signal {signum} reçu -- arrêt.")
        moteur_relais._deconnecter_ecoute()
        client_pilote_instances.arreter()
        client_executeur.arreter()
        sys.exit(0)

    signal.signal(signal.SIGTERM, _gerer_signal)
    signal.signal(signal.SIGINT, _gerer_signal)

    client_executeur.demarrer()
    client_pilote_instances.demarrer()
    # Attente bloquante des deux connexions -- ce process n'a rien
    # d'autre à faire tant qu'il n'est pas connecté des deux côtés (cf.
    # §8 du plan, point ouvert "attente prêt" : ACK implicite ici via
    # le signal `connecte` déjà existant sur ClientReseauAutoniaX,
    # suffisant -- pas besoin d'un message "executeur_pret" séparé, le
    # process principal attend lui-même sa PROPRE confirmation de
    # connexion réussie côté serveur via le même mécanisme, cf. site
    # d'appel dans _sautoniax_executer_notebook_distant_sur_instance_
    # isolee/le lancement paresseux).
    pret_executeur.wait()
    pret_pilote.wait()
    moteur_relais._connecter_ecoute()
    log.info(f"[executeur:{instance_id}] prêt (connecté en role=executeur ET role=pilote).")
    # PATCH v7 : marqueur lu par le sAutoniax (stdout du Popen) -> le profil n'est déclaré « actif » qu'une fois l'exécuteur prêt.
    print("EXECUTEUR_PRET", flush=True)

    # Boucle d'attente passive -- tout le travail réel se produit dans
    # les threads réseau (Qt.DirectConnection) et les threads de cellule
    # créés à la volée par _sur_executer_code ci-dessus ; ce thread
    # principal n'a plus qu'à rester vivant jusqu'à SIGTERM/SIGINT
    # (cf. _gerer_signal) ou Ctrl+C.
    try:
        while True:
            time.sleep(1.0)
    except KeyboardInterrupt:
        _gerer_signal(signal.SIGINT, None)


def main_instance_nodriver():
    """Point d'entrée du mode "instance" (ex-instance_nodriver.py main()) --
    RENOMMÉ pour ne pas entrer en collision avec main(), le point d'entrée
    de l'application Qt principale, cf. dispatch sur sys.argv en fin de
    fichier (if __name__ == "__main__"). Reste un process Python séparé,
    lancé via subprocess.Popen([sys.executable, __file__, "--instance-id",
    ..., "--port", ...]) -- cf. ApplicationsScreen/DashboardScreen,
    SCRIPT_INSTANCE_DASHBOARD pointe maintenant vers ce fichier lui-même
    plutôt que vers instance_nodriver.py séparé."""
    parser = argparse.ArgumentParser(description="Instance nodriver AutoniaX")
    parser.add_argument("--instance-id", required=True)
    parser.add_argument("--port", type=int, default=8765)
    parser.add_argument("--host", default="127.0.0.1")
    parser.add_argument("--navigateur", choices=["chrome", "vivaldi", "camoufox", "cloakbrowser", "feather"], default="chrome")
    parser.add_argument("--executable", default=None, help="Chemin explicite vers l'exécutable (prioritaire sur --navigateur)")
    parser.add_argument("--profil", default=None, help="Chemin du dossier de profil utilisateur (user_data_dir)")
    parser.add_argument("--url", default=None, help="Site ouvert par défaut au démarrage (prioritaire sur la welcome page AutoniaX)")
    parser.add_argument("--download-dir", default=None, help="Dossier de téléchargement dédié (cf. PATCH_projet_batch.md, section 6) -- absent = comportement Chrome par défaut")
    # PATCH (demande utilisateur explicite : "es ce que tu peu modifer l'app
    # de tels sorte que les profisl camoufox se lance correctement") --
    # proxy du profil, transmis en JSON par _lancer_instance_pour_profil
    # (même format que parser_proxy/obtenir_config_profil()["proxy"] :
    # {"protocole", "host", "port", "user", "password"}).
    # CORRECTIF (demande utilisateur explicite ultérieure : "es til
    # possible de activer un proxy" sur un profil Chrome standard) --
    # n'est plus ignoré pour "chrome"/"vivaldi" : cf. _construire_args_
    # proxy_chrome (--proxy-server + extension d'auto-auth générée si
    # user/password présents), appelée depuis demarrer_navigateur pour
    # tout navigateur autre que "camoufox".
    parser.add_argument("--proxy", default=None, help="Config proxy JSON du profil (host/port/user/password -- tous navigateurs)")
    # PATCH (mode sAutoniax -- demande explicite utilisateur : "on vas
    # juste utiliser camoufox pas chrome" pour faire tourner le
    # navigateur sans écran sur Kaggle). Ignoré si --navigateur n'est
    # pas "camoufox" (cf. _main_async, le chemin nodriver/CDP n'accepte
    # volontairement pas ce paramètre -- inchangé pour le mode Dashboard
    # normal, cf. décision : "on vas juste utiliser camoufox"). Défaut à
    # False pour ne RIEN changer au comportement existant de
    # main_instance_nodriver() lancée par DashboardScreen (mAutoniax
    # desktop, une vraie fenêtre navigateur visible reste attendue là).
    parser.add_argument("--headless", action="store_true", help="Lance le navigateur sans fenêtre visible (camoufox, chrome, vivaldi -- cf. mode sAutoniax)")
    # PATCH (demande utilisateur explicite : toggle "bloquer médias" par
    # profil, "revocable a toutu moment meme si le profils a deja
    # demarer") -- --profil (ci-dessus) porte le CHEMIN du dossier
    # profil (user_data_dir), pas son NOM (clé du registre profils_
    # config.json, cf. obtenir_config_profil) -- les deux ne sont pas
    # interchangeables (chemin slugifié/migré possible, cf. _nom_dossier_
    # valide/_migrer_dossier_profil_si_ancien_emplacement). --nom-profil
    # transmet ce nom explicitement, pour que action_navigate/action_new_tab
    # (cf. leurs docstrings) puissent relire obtenir_config_profil(nom)[
    # "bloquer_media"] à CHAQUE navigation -- c'est cette relecture, pas
    # un état figé au lancement, qui rend le toggle réellement révocable
    # sans redémarrer l'instance. None (absent) : ne devrait pas arriver
    # via _lancer_instance_pour_profil (qui le fournit toujours désormais),
    # mais reste toléré -- dans ce cas, aucune relecture n'est possible et
    # le blocage média reste simplement toujours désactivé pour cette
    # instance (comportement identique à avant ce patch).
    parser.add_argument("--nom-profil", default=None, help="Nom du profil (clé du registre profils_config.json) -- permet de relire bloquer_media à chaque navigation, cf. definir_bloquer_media_config_profil")
    args = parser.parse_args()

    server_url = f"ws://{args.host}:{args.port}"

    proxy_dict = None
    if args.proxy:
        try:
            proxy_dict = json.loads(args.proxy)
            if not isinstance(proxy_dict, dict):
                proxy_dict = None
        except (ValueError, TypeError) as e:
            log.warning(f"--proxy {args.proxy!r} illisible ({e!r}) -- instance lancée SANS proxy.")
            proxy_dict = None

    try:
        asyncio.run(_main_async(args.instance_id, server_url, args.navigateur, args.executable, args.profil, args.url, args.download_dir, proxy_dict, headless=args.headless, nom_profil=args.nom_profil))
    except KeyboardInterrupt:
        pass
    except Exception as e:
        log.error(f"Instance '{args.instance_id}' : erreur fatale ({e!r})")
        sys.exit(1)


# ---------------------------------------------------------------------------
# Point d'entrée
# ---------------------------------------------------------------------------
# ARRET DRASTIQUE (demande utilisateur : "au demarrage de l'app, verifier s'il y a encore des
# zombies en cours et les tuer"). Au lancement, plus aucune autre fenetre AutoniaX ne tourne
# (le refus de double-lancement est teste juste avant) : tout process AutoniaX lance avec un de
# ces drapeaux est donc un reste d'une session precedente. Pas de psutil (volontairement absent) :
# PowerShell/CIM sous Windows, `ps` ailleurs.
TUER_ZOMBIES_AU_DEMARRAGE = True
_DRAPEAUX_PROCESS_AUTONIAX = ("--instance-id", "--sautoniax", "--mode-executeur", "--serveur")


def _lister_processus_ligne_commande() -> list:
    """[(pid, ligne_de_commande)] de tous les process visibles. [] en cas d'echec."""
    sortie = []
    try:
        if sys.platform == "win32":
            r = subprocess.run(
                ["powershell", "-NoProfile", "-NonInteractive", "-Command",
                 "Get-CimInstance Win32_Process | Select-Object ProcessId,CommandLine | ConvertTo-Json -Compress"],
                capture_output=True, text=True, timeout=25, creationflags=0x08000000)
            donnees = json.loads(r.stdout or "[]")
            if isinstance(donnees, dict):
                donnees = [donnees]
            for d in donnees:
                if d.get("CommandLine"):
                    sortie.append((int(d["ProcessId"]), str(d["CommandLine"])))
        else:
            r = subprocess.run(["ps", "-eo", "pid=,args="], capture_output=True, text=True, timeout=15)
            for ligne in r.stdout.splitlines():
                morceaux = ligne.strip().split(None, 1)
                if len(morceaux) == 2 and morceaux[0].isdigit():
                    sortie.append((int(morceaux[0]), morceaux[1]))
    except Exception:
        logging.getLogger("autoniax.zombies").exception("liste des processus impossible")
    return sortie


def _est_process_zombie_autoniax(ligne: str) -> bool:
    bas = ligne.lower()
    return "autoniax" in bas and any(d in ligne for d in _DRAPEAUX_PROCESS_AUTONIAX)


def _tuer_zombies_autoniax(processus=None, tuer=None) -> list:
    """Tue les process AutoniaX (instances, sAutoniax, executeurs, serveur) restes d'une session
    precedente, ainsi que leur arbre (navigateurs enfants). Retourne les PID vises. Ne leve jamais."""
    journal = logging.getLogger("autoniax.zombies")
    cibles = []
    try:
        moi = os.getpid()
        parents = {moi, os.getppid()}
        for pid, ligne in (processus if processus is not None else _lister_processus_ligne_commande()):
            if pid in parents or not _est_process_zombie_autoniax(ligne):
                continue
            cibles.append((pid, ligne))
        for pid, ligne in cibles:
            journal.warning(f"ZOMBIE tue au demarrage : PID {pid} -- {ligne[:200]}")
            if tuer is not None:
                tuer(pid)
            elif sys.platform == "win32":
                subprocess.run(["taskkill", "/F", "/T", "/PID", str(pid)], capture_output=True,
                               timeout=15, creationflags=0x08000000)
            else:
                try:
                    os.kill(pid, signal.SIGKILL)
                except OSError:
                    pass
        if cibles:
            time.sleep(0.5)
    except Exception:
        journal.exception("nettoyage des zombies impossible")
    return [p for p, _ in cibles]


def main():
    # ── Identité Windows de l'app (barre des tâches / Alt+Tab) ─────
    # C'est LA raison pour laquelle setWindowIcon()/app.setWindowIcon()
    # seuls ne suffisent pas : Windows regroupe une fenêtre dans la barre
    # des tâches par AppUserModelID, pas par l'icône Qt. Sans cet appel,
    # le process reste rattaché à l'AppUserModelID par défaut de
    # python.exe/pythonw.exe -- Windows affiche alors l'icône de
    # l'interpréteur Python, quoi que Qt règle de son côté. DOIT être
    # appelé AVANT la création de la QApplication (sinon Windows a déjà
    # figé l'identité du process au moment où Qt crée la fenêtre).
    if sys.platform == "win32":
        try:
            ctypes.windll.shell32.SetCurrentProcessExplicitAppUserModelID(
                "AutoniaX.App.1"
            )
        except Exception:
            pass

    app = QApplication(sys.argv)
    _installer_gui_diag(app)
    app.setStyle("Fusion")
    app.setPalette(build_palette())
    app.setStyleSheet(build_stylesheet())
    # Icône d'application -- barre des tâches Windows, Alt+Tab, etc. En plus
    # de MainWindow.setWindowIcon() (qui couvre l'icône de la fenêtre/du
    # coin haut-gauche une fois la CustomTitleBar en place).
    app.setWindowIcon(QIcon(_generate_icon_pixmap_autoniax(256)))

    default_font = QFont("Segoe UI", 10)  # 10pt ≈ 13px à 96 DPI
    app.setFont(default_font)

    # Refus de double-lancement (demande explicite utilisateur) : depuis
    # que fermer AutoniaX tue TOUJOURS le serveur central désormais (plus
    # de réglage "Éteindre le serveur à la fermeture", cf. ReglagesApp),
    # un serveur déjà actif sur le port signifie forcément qu'une AUTRE
    # fenêtre AutoniaX tourne déjà sur cette machine (ou, cas plus rare,
    # qu'un serveur a été lancé manuellement en mode --serveur à part) --
    # dans les deux cas, on refuse de continuer plutôt que de s'y
    # raccrocher silencieusement comme avant (cf. ancien comportement de
    # MainWindow.__init__/_serveur_dashboard_deja_actif, désormais
    # remplacé par ce refus explicite). Testé AVANT toute construction de
    # MainWindow, pour ne jamais afficher une fenêtre à moitié initialisée.
    if RESEAU_DASHBOARD_DISPONIBLE and _serveur_dashboard_deja_actif():
        BoiteDialogueAutoniaX.critical(
            None, "AutoniaX déjà ouvert",
            "AutoniaX est déjà en cours d'exécution sur cette machine "
            f"(un serveur écoute déjà sur le port {PORT_SERVEUR_DASHBOARD}).\n\n"
            "Fermez l'instance déjà ouverte avant d'en relancer une nouvelle.",
        )
        sys.exit(1)

    # PATCH demandé par l'utilisateur : vide Documents\AutoniaX\captures\
    # à CHAQUE démarrage de l'application, pour éviter une saturation
    # disque au fil des sessions (cf. vider_captures_dir, get_captures_dir
    # -- rien ne supprime spontanément ces PNG ailleurs dans ce fichier).
    # Placé ICI, après le refus de double-lancement ci-dessus : si une
    # autre fenêtre AutoniaX tourne déjà (serveur déjà actif), on vient de
    # sys.exit(1) juste au-dessus SANS jamais atteindre cette ligne --
    # vider ce dossier pendant qu'une autre instance de l'app est en train
    # d'y écrire une capture (InstanceExecutable.capture(), cf. sa
    # docstring) supprimerait un fichier activement en cours d'écriture.
    # Défensif par construction (cf. docstring de vider_captures_dir) :
    # ne peut pas faire échouer le démarrage de l'application.
    vider_captures_dir()

    # ARRET DRASTIQUE : tue les zombies d'une session precedente (cf. _tuer_zombies_autoniax).
    if TUER_ZOMBIES_AU_DEMARRAGE:
        _tuer_zombies_autoniax()

    # PATCH « instance légère » : prépare (en arrière-plan, process séparé) le
    # fichier léger lancé par les profils si absent ou périmé. Sans effet s'il
    # est déjà à jour ; ne peut jamais faire échouer le démarrage.
    try:
        script_instance_pour_profil()
    except Exception:
        pass

    # Splash animé -- QPainter natif, aucune dépendance externe. MainWindow
    # est construite ici (tout son __init__ s'exécute, y compris le
    # lancement du serveur Dashboard) mais n'est PAS affichée tout de suite
    # -- c'est le splash lui-même qui appelle .show() une fois son animation
    # terminée (cf. SplashScreen._finish), pour ne jamais montrer une
    # fenêtre à moitié construite pendant que le splash tourne encore.
    #
    # SPLASH PILOTABLE DEPUIS LES PARAMÈTRES (demande explicite
    # utilisateur : "patch aussi le code dans les parametre tu met un
    # bouton de toogle qui peu desactiver ou activer le splashscreen au
    # prochin redemarage") -- remplace l'ancienne constante SPLASH_ACTIF
    # codée en dur (True, cf. historique : "je veux que tu reactive le
    # splashscreen de mon app", suite à "je veux que tu desactive le
    # splash scrreen... ca me fait perdre du temps") par une lecture du
    # réglage persisté (ReglagesApp.splash_actif, onglet Général des
    # Paramètres) -- CE réglage est désormais la seule source de vérité,
    # modifiable par l'utilisateur lui-même sans jamais retoucher au
    # code. window.reglages est déjà chargé à ce stade (cf. MainWindow.
    # __init__, self.reglages = ReglagesApp.load()) -- pas de second
    # chargement disque nécessaire. Classe SplashScreen inchangée (cf.
    # ligne ~4729).
    window = MainWindow()
    if window.reglages.splash_actif:
        splash = SplashScreen()
        splash.show()
        app.processEvents()
        splash.set_main_window(window)
    else:
        window.show()

    sys.exit(app.exec())


