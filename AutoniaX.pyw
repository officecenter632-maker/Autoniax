class BoutonCouleur(QToolButton):
    """PATCH (demande explicite utilisateur : "jai du mal a lire parfois
    les texte de corespondance ... tu vas mettre une des widget pour la
    configuration de couleur, donc on vas juste choisr la couleur a
    ffficher pour les sucess, et la couleur a afficher pour les echecs")
    -- petit bouton carré affichant un aperçu plein de la couleur
    courante (via styleSheet background-color, pas d'icône) ; un clic
    ouvre BoiteDialogueAutoniaX.couleur() (boîte maison thémée, cf. sa
    docstring pour l'historique du remplacement de QColorDialog.getColor()
    natif) pré-rempli sur cette couleur, et émet
    couleur_changee(nouvelle_couleur_hex) si l'utilisateur valide (choix
    annulé -- QColor invalide, cf. isValid() -- ignoré sans effet,
    couleur inchangée).

    Réutilisable partout où une simple couleur "#rrggbb" doit être
    réglable (ComposantReglagesNumeriquesPanel.couleur_succes/couleur_
    echec ci-dessous en est le premier usage, mais rien ici n'est
    spécifique à ce contexte)."""

    couleur_changee = Signal(str)  # nouvelle couleur, format "#rrggbb"

    _TAILLE = 28

    def __init__(self, couleur_initiale: str, parent=None):
        super().__init__(parent)
        self.setObjectName("BoutonCouleur")
        self.setFixedSize(self._TAILLE, self._TAILLE)
        self.setCursor(Qt.PointingHandCursor)
        self._couleur = couleur_initiale
        self._appliquer_style()
        self.clicked.connect(self._sur_clic)

    def _appliquer_style(self):
        # border-radius légèrement inférieur à la moitié de _TAILLE (pas
        # un cercle plein) -- carré arrondi, cohérent avec RADIUS déjà
        # utilisé ailleurs dans ce fichier pour les boutons standards,
        # plutôt qu'une pastille ronde qui suggérerait un statut/une
        # icône plutôt qu'un aperçu de couleur à éditer.
        self.setStyleSheet(
            f"QToolButton#BoutonCouleur {{ background-color: {self._couleur}; "
            f"border: 1px solid {Mocha.surface2}; border-radius: 6px; }}"
            f"QToolButton#BoutonCouleur:hover {{ border: 1px solid {Mocha.overlay1}; }}"
        )
        self.setToolTip(self._couleur)

    def definir_couleur(self, couleur: str):
        """Met à jour l'aperçu SANS émettre couleur_changee -- utilisé par
        l'appelant (cf. ComposantReglagesNumeriquesPanel.definir_composant)
        pour synchroniser l'affichage sur le composant sélectionné, à
        distinguer d'un choix utilisateur réel (cf. _sur_clic)."""
        self._couleur = couleur
        self._appliquer_style()

    def _sur_clic(self):
        couleur_choisie = BoiteDialogueAutoniaX.couleur(QColor(self._couleur), self, "Choisir une couleur")
        if not couleur_choisie.isValid():
            return  # dialogue annulé -- couleur inchangée
        nouvelle = couleur_choisie.name()
        self._couleur = nouvelle
        self._appliquer_style()
        self.couleur_changee.emit(nouvelle)


class ComposantReglagesNumeriquesPanel(QWidget):
    """PATCH (demande explicite utilisateur : remplacer la colonne de
    droite "Contrôles" (Rafraîchir/Mode/Taux/Rafraîchissement auto) de
    TestComposantScreen par le panneau de réglages du composant
    sélectionné) -- sous-ensemble VOLONTAIREMENT réduit de
    ComposantReglagesPanel : seuls les réglages de DÉTECTION qui ont un
    effet direct sur le test en cours (Priorité de sélection, Seuil de
    confiance, Flou gaussien, Delta de conflit, Seuil des candidats
    potentiels), réponse explicite utilisateur -- PAS l'aperçu image, les
    variantes, la description, le nom, l'ID DOM, la catégorie, le groupe,
    la zone de clic, ni aucun des boutons d'action (Définir la zone/Tester
    le composant/Mettre à jour l'image/Supprimer), qui n'ont pas de sens
    ou créeraient une action croisée déroutante depuis l'écran de test lui-
    même (ex: "Tester le composant" alors qu'on EST déjà dans cet écran).

    Volontairement PAS une réutilisation de ComposantReglagesPanel avec
    des .setVisible(False) en cascade sur tout le superflu : ce panneau-là
    est pensé comme un panneau LATÉRAL COULISSANT non-modal (titre
    "RÉGLAGES DU COMPOSANT" + bouton fermer, cf. sa docstring), pas pour
    vivre encaissé en permanence dans une colonne fixe d'un autre écran --
    dupliquer juste les 5 widgets utiles ici reste plus simple à
    maintenir qu'une longue liste d'exceptions à masquer sur une classe
    pensée pour un tout autre contexte.

    AJOUT (demande explicite utilisateur : "sa ne doit plus tester tout
    dun coup, il faut que sa teste juste la variante qui a ete
    selectionner") -- variante_selection_changee (int) ci-dessous, seul
    signal de cette classe : émis par _on_variante_selection_changed
    (l'utilisateur change de variante dans variante_combo) ET par
    definir_composant (sélection initiale, index 0), pour que
    TestComposantScreen puisse recharger self._templates_bgr avec
    UNIQUEMENT la variante désignée par cet index, au lieu de charger
    systématiquement toutes les variantes du composant (cf.
    TestComposantScreen._on_variante_panneau_changee/_charger_templates_
    variante_unique). Avant cet ajout, ce panneau ne faisait QUE modifier
    composant.<champ> et appeler project.save() directement dans ses
    propres slots (même patron que ComposantReglagesPanel._on_seuil_changed
    etc.), sans communication avec un écran parent -- ce signal reste le
    SEUL ajouté, pour cette seule raison ; les 7 handlers de réglage
    (_on_priorite_changed etc.) continuent de modifier directement l'objet
    Variante partagé sans signal dédié, TestComposantScreen relisant
    simplement le composant à jour à la prochaine détection."""

    variante_selection_changee = Signal(int)  # index de la variante nouvellement sélectionnée

    def __init__(self, parent=None):
        super().__init__(parent)
        self.setObjectName("ReglagesPanel")
        # cf. retour utilisateur explicite : largeur GÉNÉREUSE, pas
        # étroite comme l'ancienne colonne_reglages de PanneauRenduInstance
        # (130px, cf. TestComposantScreen.__init__) ni comme
        # ComposantReglagesPanel (300px, mais pensé pour coulisser PAR-
        # DESSUS le contenu, pas pour partager l'espace horizontal avec
        # l'aperçu à côté). 340px choisi initialement par cohérence avec
        # l'ancienne largeur de self._scroll (colonne gauche) AVANT son
        # propre rétrécissement.
        # PATCH (demande explicite utilisateur : "ainsi l'aperçu d'instance
        # sera plus grand, ne retire aucun autre panneau que lui, et
        # réduire le width de 1/4, je dis le panneau de droite de
        # paramétrage du composant dans l'interface de test" -- confirmé
        # "réduire de 1/4 -> 255px, garder 3/4 de la largeur actuelle")
        # -- 340 -> 255 (340 * 3/4). AUCUN autre panneau touché : la
        # largeur récupérée (85px) revient automatiquement à self.
        # _panneau_rendu.colonne_image (stretch=1 dans _corps_layout,
        # cf. PanneauRenduInstance.__init__), donc à l'aperçu d'instance,
        # sans rien changer d'autre dans le layout.
        self.setFixedWidth(255)
        self.project: Optional[Project] = None
        self._composant_nom: Optional[str] = None
        # AJOUT (SPEC_GLOBALE_AutoniaX.md, Partie A §5.4) -- index de la
        # variante actuellement réglée par les 6 widgets ci-dessous (cf.
        # self.variante_combo). Avant cet ajout, ce panneau n'avait aucune
        # notion de variante : les 6 champs lisaient/écrivaient directement
        # composant.<champ> (les valeurs par défaut du composant, cf.
        # ComposantSingle §2.2), qui ne sont plus utilisées par le moteur
        # de détection réel une fois qu'un composant a des Variante
        # (cf. Partie A §3) -- réglage silencieusement sans effet observable
        # pendant un test. 0 par défaut (première variante).
        self._variante_index_selectionnee: int = 0

        outer_layout = QVBoxLayout(self)
        outer_layout.setContentsMargins(0, 0, 0, 0)
        outer_layout.setSpacing(0)

        header_label = QLabel("RÉGLAGES DU COMPOSANT", self)
        header_label.setObjectName("ReglagesPanelTitle")
        header_label.setContentsMargins(18, 16, 18, 8)
        outer_layout.addWidget(header_label)

        scroll_area = QScrollArea(self)
