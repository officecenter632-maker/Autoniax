    get_notebook_execution_path()/get_notebook_serveurt_path() juste
    au-dessus (même docstring applicable point par point : fichier
    STATIQUE vivant UNIQUEMENT sur disque, aucun contenu par défaut
    embarqué en dur dans le code Python, jamais fabriqué automatiquement
    -- l'utilisateur le dépose une fois par glisser-déposer).

    Fichier DISTINCT de sAutoniax.ipynb et ServeurTLauncher.ipynb (même
    dossier notebook_execution/, nom différent) : lance le serveurT dans
    un thread daemon en arrière-plan puis le sAutoniax au premier plan
    dans le MÊME kernel -- usage test uniquement (un seul point de
    défaillance, ressources partagées, cf. son propre markdown
    d'introduction), pas destiné à remplacer les deux notebooks séparés
    en production.

    Si le fichier n'existe pas encore, cette fonction ne crée RIEN --
    elle retourne juste le chemin où l'utilisateur doit le déposer
    lui-même (glisser-déposer manuel, cf. SAutoniaxAvecServeurManagerScreen)."""
    d = get_app_data_dir() / "notebook_execution"
    d.mkdir(parents=True, exist_ok=True)
    chemin = d / "sAutoniaxAvecServeur.ipynb"
    return chemin


# ---------------------------------------------------------------------------
# Fichiers/dossiers de la corbeille (demande utilisateur explicite : garder
# les images/fichiers liés à un élément supprimé jusqu'à la suppression
# définitive, pour permettre une restauration à l'identique -- cf.
# Project.remove_composant/remove_service_api/restaurer_depuis_corbeille/
# purger_definitivement_corbeille). Un sous-dossier "corbeille/" dédié,
# séparé de "components/", pour ne jamais confondre un fichier "en
# attente de purge" avec un fichier réellement actif -- _charger_grille_
# composants et consorts ne parcourent QUE components/, donc rien ici ne
# peut réapparaître par erreur dans l'UI tant que la restauration n'a pas
# été explicitement demandée.
# ---------------------------------------------------------------------------
def _chemin_corbeille_fichiers() -> Path:
    """Dossier racine où atterrissent les fichiers/dossiers déplacés par
    un remove_* (créé si absent). Chaque appel de _deplacer_fichiers_vers_
    corbeille/_deplacer_dossier_vers_corbeille y ajoute une entrée nommée
    par un id unique (_new_id()), pour ne jamais faire collision entre
    deux éléments supprimés qui porteraient le même nom de fichier."""
    d = get_app_data_dir() / "corbeille"
    d.mkdir(parents=True, exist_ok=True)
    return d


def _deplacer_fichiers_vers_corbeille(chemins_relatifs: list) -> list:
    """Déplace une liste de fichiers (chemins relatifs à get_app_data_dir(),
    ex: variantes d'un Composant) vers _chemin_corbeille_fichiers(), chacun
    sous un sous-dossier nommé par un id unique pour éviter toute collision
    de nom entre deux suppressions. Retourne la liste des NOUVEAUX chemins
    relatifs (même ordre, même longueur que l'entrée) -- c'est cette liste
    qui est stockée dans l'entrée["fichiers"] de la corbeille et réutilisée
    telle quelle par _restaurer_fichiers_depuis_corbeille pour le retour en
    arrière. Un chemin source manquant (déjà absent du disque, cas limite)
    est silencieusement ignoré -- ni erreur, ni entrée correspondante dans
    le résultat, plutôt que de planter toute la suppression pour un seul
    fichier orphelin."""
    racine_corbeille = get_app_data_dir()
    nouveaux_chemins = []
    for chemin_relatif in chemins_relatifs:
        if not chemin_relatif:
            continue
        source = racine_corbeille / chemin_relatif
        if not source.exists():
            continue
        sous_dossier = _chemin_corbeille_fichiers() / _new_id()
        sous_dossier.mkdir(parents=True, exist_ok=True)
        destination = sous_dossier / source.name
        shutil.move(str(source), str(destination))
        nouveaux_chemins.append(str(destination.relative_to(racine_corbeille)))
    return nouveaux_chemins


def _deplacer_dossier_vers_corbeille(dossier_source: Path) -> Optional[str]:
    """Déplace un dossier ENTIER (ex: components/<NomServiceAPI>) en bloc
    vers _chemin_corbeille_fichiers(), sous un sous-dossier nommé par un id
    unique -- garantit que rien n'est laissé derrière (y compris d'éventuels
    fichiers non référencés dans une variante), contrairement à un
    déplacement fichier par fichier. Retourne le chemin relatif (à
    get_app_data_dir()) du dossier déplacé, ou None si `dossier_source`
    n'existe pas (rien à déplacer)."""
    if not dossier_source.exists():
        return None
    racine_corbeille = get_app_data_dir()
    sous_dossier = _chemin_corbeille_fichiers() / _new_id()
    sous_dossier.mkdir(parents=True, exist_ok=True)
    destination = sous_dossier / dossier_source.name
    shutil.move(str(dossier_source), str(destination))
    return str(destination.relative_to(racine_corbeille))


def _restaurer_fichiers_depuis_corbeille(chemins_relatifs: list):
    """Inverse de _deplacer_fichiers_vers_corbeille/_deplacer_dossier_vers_
    corbeille : redéplace chaque chemin (relatif à get_app_data_dir(), tel
    que stocké dans entree["fichiers"]) vers son emplacement d'ORIGINE,
    reconstruit depuis le NOM du fichier/dossier lui-même (un composant
    restaure vers components/<ServiceAPI>/<fichier>.png, un ServiceAPI
    restaure vers components/<NomServiceAPI>/) -- cf. Project.
    restaurer_depuis_corbeille, qui connaît le type d'élément et peut donc
    fournir le bon chemin cible pour chacun. Un chemin source déjà absent
    (cas limite, ex. purge manuelle entre-temps du dossier corbeille sur
    disque) est silencieusement ignoré plutôt que de faire planter toute
    la restauration."""
    racine = get_app_data_dir()
    for chemin_relatif in chemins_relatifs:
        source = racine / chemin_relatif
        if not source.exists():
            continue
        # Un chemin déplacé par les deux helpers ci-dessus a TOUJOURS la
        # forme "corbeille/<id>/<nom_original>" -- reconstruire l'origine
        # exacte (dossier components/<ServiceAPI>/ précis) n'est pas
        # possible depuis le chemin seul pour un COMPOSANT (son
        # service_api_nom n'est pas encodé dans le chemin), donc ce cas
        # est traité en amont : restaurer_depuis_corbeille rappelle le
        # composant/service_api restauré pour connaître le bon dossier
        # cible, cf. usage ci-dessous. Ici, on ne fait que le déplacement
        # générique fichier/dossier -> reconstruction du chemin cible à
        # partir du nom, dans components/ à la racine (le sous-dossier
        # exact est déjà correct pour un ServiceAPI entier, puisque le nom
        # du dossier déplacé EST le nom du ServiceAPI).
        cible = get_app_data_dir() / "components" / source.name
        if source.is_dir():
            if cible.exists():
                shutil.rmtree(cible, ignore_errors=True)
            shutil.move(str(source), str(cible))
        else:
            # Fichier isolé (variante de Composant) : le nom de fichier
            # suit le format NomServiceAPI-NomComposant[...].png (cf.
            # add_composant), donc le préfixe avant le premier "-" donne
            # le dossier ServiceAPI cible.
            service_api_nom = source.stem.split("-")[0]
            dossier_cible = get_app_data_dir() / "components" / service_api_nom
            dossier_cible.mkdir(parents=True, exist_ok=True)
            cible = dossier_cible / source.name
            shutil.move(str(source), str(cible))
        # Nettoie le sous-dossier corbeille/<id>/ maintenant vide, pour ne
        # pas laisser traîner des dossiers fantômes à chaque restauration.
        parent = source.parent
        if parent != _chemin_corbeille_fichiers() and parent.exists() and not any(parent.iterdir()):
            parent.rmdir()


# ---------------------------------------------------------------------------
# Git / GitHub (onglet Git de la sidebar, cf. GitScreen) -- création du
# dépôt distant "serveurT" via l'API GitHub, puis init/add/commit/push du
# contenu de get_serveur_t_dir() via le binaire git en ligne de commande
# (subprocess), pas de dépendance supplémentaire (urllib stdlib pour
# l'appel API, git doit déjà être installé sur la machine pour le push).
# ---------------------------------------------------------------------------
class GitHubErreur(Exception):
    """Erreur levée par les helpers GitHub/Git ci-dessous -- message déjà
    prêt à être affiché tel quel dans GitScreen (pas de traceback brut
    exposé à l'utilisateur)."""
    pass


def _github_creer_depot(token: str, nom: str, prive: bool = True) -> dict:
    """Crée un dépôt GitHub nommé `nom` sur le compte associé au `token`
    (Personal Access Token, scope "repo" requis) via POST /user/repos.
    Retourne le JSON de réponse de l'API GitHub (contient notamment
    "html_url", "clone_url", "owner"."login") en cas de succès.
    Lève GitHubErreur avec un message lisible en cas d'échec (token
    invalide, dépôt déjà existant, pas de réseau, etc.)."""
    corps = json.dumps({"name": nom, "private": prive}).encode("utf-8")
    requete = urllib.request.Request(
        "https://api.github.com/user/repos",
        data=corps,
        method="POST",
        headers={
            "Authorization": f"Bearer {token}",
            "Accept": "application/vnd.github+json",
            "Content-Type": "application/json",
            "X-GitHub-Api-Version": "2022-11-28",
        },
    )
    try:
        with urllib.request.urlopen(requete, timeout=15) as reponse:
            return json.loads(reponse.read().decode("utf-8"))
    except urllib.error.HTTPError as e:
        detail = e.read().decode("utf-8", errors="replace")
        try:
            message_api = json.loads(detail).get("message", detail)
        except (json.JSONDecodeError, AttributeError):
            message_api = detail
        raise GitHubErreur(f"GitHub a refusé la création du dépôt ({e.code}) : {message_api}") from e
    except urllib.error.URLError as e:
        raise GitHubErreur(f"Impossible de contacter GitHub : {e.reason}") from e


def _github_recuperer_utilisateur(token: str) -> dict:
    """Récupère les infos du compte GitHub associé au `token` (GET /user)
    -- utilisé pour retrouver/valider github_username sans que
    l'utilisateur ait à le taper lui-même. Lève GitHubErreur si le token
    est invalide ou en cas d'erreur réseau."""
    requete = urllib.request.Request(
        "https://api.github.com/user",
        method="GET",
        headers={
            "Authorization": f"Bearer {token}",
            "Accept": "application/vnd.github+json",
            "X-GitHub-Api-Version": "2022-11-28",
        },
    )
    try:
        with urllib.request.urlopen(requete, timeout=15) as reponse:
            return json.loads(reponse.read().decode("utf-8"))
    except urllib.error.HTTPError as e:
        raise GitHubErreur(f"Token GitHub invalide ou expiré ({e.code}).") from e
    except urllib.error.URLError as e:
        raise GitHubErreur(f"Impossible de contacter GitHub : {e.reason}") from e


def _git_executer(*args: str, cwd: Path) -> str:
    """Wrapper générique autour de `git <args>` exécuté dans `cwd` --
    lève GitHubErreur (message stderr inclus) si le code de retour est
    non nul, sinon retourne stdout (str, déjà décodé/strippé). Timeout de
    60s pour ne jamais bloquer l'UI indéfiniment sur un push réseau
    défaillant (ex. mauvais token -> git attend une saisie interactive)."""
    try:
        resultat = subprocess.run(
            ["git", *args],
            cwd=str(cwd),
            capture_output=True,
            text=True,
            timeout=60,
            encoding="utf-8",
            errors="replace",
        )
    except FileNotFoundError as e:
        raise GitHubErreur("Git n'est pas installé ou introuvable dans le PATH.") from e
    except subprocess.TimeoutExpired as e:
        raise GitHubErreur(f"La commande git {' '.join(args)} a expiré (60s).") from e
    if resultat.returncode != 0:
        # PATCH -- certains messages git (ex. "nothing to commit,
        # working tree clean") sortent sur STDOUT plutôt que stderr
        # même quand le code de retour est non nul. Se limiter à
        # stderr.strip() produit alors un message d'erreur VIDE
        # (juste "git commit -m ... a échoué : " sans rien après), et
        # empêche par ricochet toute détection de motif sur le texte
        # de l'exception (cf. _git_initialiser_et_pousser, test
        # "nothing to commit" qui ne peut alors jamais matcher). On
        # inclut donc stdout en repli si stderr est vide, pour que le
        # message affiché/loggé reflète toujours la vraie sortie git.
        detail = resultat.stderr.strip() or resultat.stdout.strip() or "(aucune sortie)"
        raise GitHubErreur(f"git {' '.join(args)} a échoué : {detail}")
    return resultat.stdout.strip()


def _git_initialiser_et_pousser(
    dossier: Path,
    fichiers_relatifs: list,
    depot_url: str,
    token: str,
    username: str,
    message_commit: str = "Mise à jour depuis AutoniaX",
) -> None:
    """Init (si absent) / add des `fichiers_relatifs` cochés / commit /
    push du contenu de `dossier` vers `depot_url` (URL https, ex.
    "https://github.com/<user>/<repo>.git"), authentifié en injectant le
    `token` directement dans l'URL distante (https://<token>@github.com/...)
    -- pas de credential helper à configurer, cohérent avec le fait que
    rien n'est persisté par git lui-même (le token reste uniquement dans
    reglages.json côté AutoniaX). `username` n'est utilisé que pour définir
    user.name/user.email localement au dépôt si jamais git ne les connaît
    pas encore (sinon `git commit` échoue sur une machine fraîchement
    installée)."""
    if not fichiers_relatifs:
        raise GitHubErreur("Aucun fichier coché à pousser.")

    est_nouveau_depot = not (dossier / ".git").exists()
    if est_nouveau_depot:
        _git_executer("init", cwd=dossier)
        _git_executer("branch", "-M", "main", cwd=dossier)

    # user.name/user.email locaux (pas globaux) -- ne touche pas à une
    # config git existante de l'utilisateur ailleurs sur la machine,
    # ne sert que de repli si le dépôt vient d'être initialisé.
    try:
        _git_executer("config", "user.name", cwd=dossier)
    except GitHubErreur:
        _git_executer("config", "user.name", username or "AutoniaX", cwd=dossier)
    try:
        _git_executer("config", "user.email", cwd=dossier)
    except GitHubErreur:
        _git_executer("config", "user.email", f"{username or 'autoniax'}@users.noreply.github.com", cwd=dossier)

    _git_executer("add", *fichiers_relatifs, cwd=dossier)

    # Rien à committer (aucun changement depuis le dernier push) -- pas
    # une erreur, git commit renvoie juste un code non nul dans ce cas.
    # PATCH -- couvre aussi la variante française ("rien à valider" /
    # "rien à committer") au cas où git serait localisé sur la
    # machine, en plus de l'anglais ("nothing to commit") : sans ça,
    # une machine avec un git en FR relève systématiquement cette
    # exception au lieu de l'avaler silencieusement comme prévu.
    try:
        _git_executer("commit", "-m", message_commit, cwd=dossier)
    except GitHubErreur as e:
        texte_erreur = str(e).lower()
        est_rien_a_committer = any(motif in texte_erreur for motif in (
            "nothing to commit", "rien à valider", "rien à committer",
        ))
        if not est_rien_a_committer:
            raise

    # Injection du token dans l'URL distante (remote "origin" recréée à
    # chaque push pour toujours refléter le token courant des réglages,
    # au cas où l'utilisateur l'aurait changé entre-temps).
    url_authentifiee = depot_url.replace("https://", f"https://{token}@", 1)
    remotes = _git_executer("remote", cwd=dossier)
    if "origin" in remotes.splitlines():
        _git_executer("remote", "set-url", "origin", url_authentifiee, cwd=dossier)
    else:
        _git_executer("remote", "add", "origin", url_authentifiee, cwd=dossier)

    _git_executer("push", "-u", "origin", "main", cwd=dossier)


def get_project_json_path() -> Path:
    return get_app_data_dir() / "project.json"


def get_reglages_json_path() -> Path:
    """Fichier de réglages de l'application (distinct de project.json : ce
    ne sont pas des données de projet mais des préférences locales à la
    machine, ex. la fenêtre de débogage — cf. ReglagesApp)."""
    return get_app_data_dir() / "reglages.json"


def get_raccourcis_json_path() -> Path:
    """Fichier de persistance des raccourcis clavier configurables (cf.
    onglet "Raccourcis" de ParametresScreen, DEFAULT_RACCOURCIS_APP plus
    bas) -- même dossier que project.json/reglages.json (get_app_data_
    dir()), fichier séparé par cohérence avec APP_SHORTCUTS_FILE côté
    IngeniaX Explorer (app_shortcuts.json, dossier _SAVE_DIR dédié là-bas)."""
    return get_app_data_dir() / "raccourcis_app.json"


def get_documentation_html_path() -> Path:
    """AJOUT (SPEC_GLOBALE_AutoniaX.md, Partie B §2.1 -- demande explicite
    utilisateur : "je veux que la documentation soit dans un fichier html
    sauvegardé sur le disque, dans le dossier de donnée de l'app, ainsi on
    va pouvoir mettre à jour sans modifier le code source de l'app") --
    chemin du fichier HTML contenant la documentation affichée dans la
    welcome page et copiée dans le presse-papier (cf.
    lire_documentation_disque / ecrire_documentation_disque). Fichier
    PLAT à la racine de get_app_data_dir(), même niveau que project.json/
    reglages.json/raccourcis_app.json -- pas de sous-dossier dédié, ce
    fichier unique ne justifie pas une arborescence."""
    return get_app_data_dir() / "documentation.html"


def lire_documentation_disque() -> str:
    """AJOUT (Partie B §2.2, même demande, cf. get_documentation_html_
    path) -- lit le contenu de documentation.html. Retourne une chaîne
    VIDE si le fichier n'existe pas, est vide, ou n'a pas pu être lu
    (encodage invalide, erreur disque) -- DÉCISION EXPLICITE UTILISATEUR :
    "fichier vide/absent = doc vide tant que l'utilisateur n'a pas collé
    son propre contenu", donc AUCUNE génération de contenu par défaut ici,
    contrairement à l'ancien _generer_html_doc_rapide() qu'elle remplace.
    Chaîne vide en retour == documentation vide, traité comme tel par
    tous les appelants (cf. Partie B §3)."""
    chemin = get_documentation_html_path()
    if not chemin.exists():
        return ""
    try:
        return chemin.read_text(encoding="utf-8")
    except Exception:
        return ""


def ecrire_documentation_disque(html_colle: str) -> bool:
    """AJOUT (Partie B §2.3, même demande) -- écrase documentation.html
    avec html_colle, SEULEMENT si html_colle contient la sous-chaîne
    "<html" (recherche insensible à la casse, n'importe où dans le texte
    -- DÉCISION EXPLICITE UTILISATEUR, validation volontairement
    minimale : "juste la balise html", pas de parsing HTML strict). Un
    texte vide/blanc OU sans "<html" ne déclenche AUCUNE écriture (le
    fichier existant, s'il y en a un, reste inchangé) et retourne False --
    c'est à l'appelant (bouton "Coller" des Paramètres, cf. Partie B §4)
    d'afficher le retour visuel discret correspondant. Retourne True si
    l'écriture a réussi."""
    if not html_colle or "<html" not in html_colle.lower():
        return False
    chemin = get_documentation_html_path()
    try:
        chemin.parent.mkdir(parents=True, exist_ok=True)
        chemin.write_text(html_colle, encoding="utf-8")
        return True
    except Exception:
        return False


