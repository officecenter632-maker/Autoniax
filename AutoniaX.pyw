# Classe ENTIÈREMENT PERSONNALISÉE (pas une adaptation de TestComposantScreen
# ni CoordonneeActionScreen) : hérite seulement de InstanceApercuScreen pour
# la mécanique générique de connexion réseau/aperçu (sélecteur d'instance,
# réception de frames, capture_propre) -- tout le reste (onglets, widgets,
# logique de détection/nommage des Forme, gestion du code_filtre) est
# construit ici, propre à cL.
#
# Deux onglets (QTabWidget) : "Configuration" (5.1-5.4, libellé "Formes"
# dans la SPEC écrite -- renommé sur demande explicite utilisateur, même
# contenu) et "Test" (5.5).
# ---------------------------------------------------------------------------
class ConteneurApercusSouple(QWidget):
    """PATCH15 : widget a taille CIBLE sans taille minimale. Remplace
    setFixedSize (qui fixait aussi le minimum et empechait la fenetre de
    retrecir). La cible sert de sizeHint ET de taille maximale ; le minimum
    reste a 0, le layout peut donc le reduire librement."""

    def __init__(self, parent=None):
        super().__init__(parent)
        self._cible = None

    def definir_cible(self, largeur, hauteur):
        self._cible = QSize(int(largeur), int(hauteur))
        self.setMinimumSize(0, 0)
        self.setMaximumSize(self._cible)
        self.updateGeometry()

    def sizeHint(self):
        return QSize(self._cible) if self._cible is not None else super().sizeHint()

    def minimumSizeHint(self):
        return QSize(0, 0)


class ComposantLayoutConfigScreen(InstanceApercuScreen):
    """Écran de configuration d'un ComposantLayout, ouvert en onglet dans
    la section Applications (même registre que TestComposantScreen/
    ComposantLayoutConfigScreen).

    composant_layout : le ComposantLayout en cours d'édition -- MODIFIÉ EN
    PLACE au fil des actions de l'utilisateur (image_reference, code_filtre,
    formes) puis persisté par l'appelant via composant_layout_modifie (cet
    écran ne touche jamais au Project directement, même contrat que
    CoordonneeActionScreen.zone_definie).

    composant_layout_modifie() : émis (sans argument, cf. usage direct de
    self.composant_layout par l'appelant) à chaque changement significatif
    persistable (nouvelle image_reference, code_filtre modifié, Forme
    ajoutée/supprimée, ZoneForme ajoutée) -- laisse l'appelant décider du
    rythme de sauvegarde sur disque (section 9)."""

    composant_layout_modifie = Signal()
    # AJOUT (correctif renommage) : émis APRÈS un renommage réussi
    # (ancien_nom_complet, nouveau_nom_complet) -- même contrat que
    # PanneauProprietesReglages.nom_modifie côté cS, permet à
    # l'appelant (ApplicationsScreen) de resynchroniser tout ce qui
    # indexe un ComposantLayout par son NOM (grille _tuiles, etc.)
    # plutôt que de découvrir la casse par un find_composant_layout qui
    # échoue silencieusement.
    composant_layout_renomme = Signal(str, str)
    # AJOUT (demande explicite : bouton Supprimer déplacé du panneau
    # flottant -- retiré au clic simple sur une tuile, cf.
    # ComposantsLayoutScreen._sur_tuile_cliquee -- vers l'onglet Général
    # de CET écran de config) : nom complet du ComposantLayout à
    # supprimer. Même contrat que composant_layout_renomme -- cet écran
    # ne touche jamais au Project directement, l'appelant
    # (ApplicationsScreen._ouvrir_config_layout) fait l'appel réel à
    # Project.remove_composant_layout + save, PUIS ferme cet onglet
    # (même chemin que retour_button, cf. _retour_et_fermer).
    demande_suppression = Signal(str)
    # AJOUT (retour utilisateur, capture à l'appui : bouton "Tester"
    # directement dans la bande du haut de CET écran, à côté de
    # "Outils" -- accès rapide en plus de celui déjà présent dans le
    # panneau flottant de la grille, cf. PanneauProprietesLayoutFlottant.
    # demande_tester) : nom complet du ComposantLayout, MÊME contrat que
    # demande_suppression ci-dessus (relais pur, cet écran ne construit
    # jamais lui-même TestComposantScreen -- c'est ApplicationsScreen.
    # ouvrir_config_layout qui connecte ce signal vers ouvrir_test_
    # composant_layout, cf. plus bas dans ce fichier).
    demande_tester = Signal(str)

    def __init__(self, project: "Project", composant_layout: "ComposantLayout", reglages: "ReglagesApp", parent=None):
        super().__init__(id_pilote_prefixe="autoniax-cl-config", titre_apercu="APERÇU DE L'INSTANCE CIBLE", parent=parent)
        self.project = project
        self.reglages = reglages
        self.composant_layout = composant_layout
        self.onglet_origine: Optional[str] = None  # cf. ApplicationsScreen, même contrat que TestComposantScreen

        # AJOUT (retour utilisateur, capture à l'appui : bouton "Tester"
        # directement dans la bande du haut, à côté de "Outils") --
        # self._bande_pliage est déjà construite à ce stade (posée par
        # InstanceApercuScreen.__init__ via super().__init__() ci-dessus,
        # cf. sa docstring) : on insère ce bouton directement dans son
        # QHBoxLayout existant, juste après bouton_repli_outils et avant
        # le addStretch(1) qui sépare "Outils" de "Contrôles" (cf.
        # _construire_bande_pliage) -- même position visuelle que le
        # rectangle indiqué sur la capture utilisateur. Émet demande_
        # tester (cf. docstring du signal en tête de classe), simple
        # relais -- ApplicationsScreen.ouvrir_config_layout connecte ce
        # signal vers ouvrir_test_composant_layout, MÊME contrat que
        # demande_suppression déjà branché là-bas.
        self.bouton_tester_depuis_config = QPushButton(
            qta.icon("mdi6.test-tube", color=Mocha.text), " Tester", self._bande_pliage
        )
        self.bouton_tester_depuis_config.setObjectName("BoutonRepliPanneau")
        self.bouton_tester_depuis_config.setCursor(Qt.PointingHandCursor)
        self.bouton_tester_depuis_config.setToolTip("Ouvrir le test de détection de ce ComposantLayout")
        self.bouton_tester_depuis_config.clicked.connect(
            lambda: self.demande_tester.emit(self.composant_layout.nom)
        )
        self._bande_pliage.layout().insertWidget(1, self.bouton_tester_depuis_config)

        # AJOUT (retour utilisateur explicite, capture à l'appui : "je
        # veux que tu met le bouton de copie d'image ici a la ou j'ai
        # entouré avec le rectangle rose, un bouton qui va permettre de
        # copier l'image du composantLayout") -- MÊME emplacement que le
        # rectangle indiqué (bande du haut, juste à côté du bouton
        # "Tester" ajouté ci-dessus), MÊME mécanisme presse-papier que
        # partout ailleurs dans ce fichier (QMimeData.setUrls +
        # QGuiApplication.clipboard().setMimeData, cf. ApercuDragHandle.
