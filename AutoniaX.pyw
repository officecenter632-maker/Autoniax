    def _sur_raccourci_redemarrer_application(self):
        """AJOUT (demande explicite utilisateur : "mettre un raccourci de
        redémarrage de l'app AutoniaX"). Redémarre CE PROCESS-CI (relance
        AutoniaX.py depuis zéro), PAS les sAutoniax distants -- cf.
        docstring DEFAULT_RACCOURCIS_APP["redemarrer_application_autoniax"]
        pour la distinction avec _sur_raccourci_redemarrer_tous_sautoniax
        juste en dessous.

        Confirmation obligatoire (BoiteDialogueAutoniaX.question, même
        patron que les autres actions destructrices de ce fichier, ex.
        suppression de profil) : contrairement à un simple redémarrage de
        sAutoniax distant, ceci ferme et relance l'application ELLE-MÊME --
        toute Task en cours d'édition non sauvegardée, tout état de
        session en mémoire est perdu. Refus par défaut (bouton "Non") pour
        qu'un appui accidentel sur le raccourci n'emporte rien.

        Implémentation : programme la relance AVANT self.close(), plutôt
        que de spawn un nouveau process puis fermer -- sinon le nouveau
        process démarre pendant que l'ancien tient encore le port du
        serveur central (cf. _serveur_dashboard_deja_actif dans main()),
        et se ferait immédiatement refuser par la garde anti-double-
        lancement. La relance réelle est donc déclenchée sur
        QApplication.aboutToQuit (connectée une seule fois, cf. flag
        ci-dessous) : à ce stade, MainWindow.closeEvent s'est déjà
        entièrement exécuté (dashboard.arreter_tout(), client_serveur_t.
        arreter(), process serveur central terminate()/kill(), cf. sa
        docstring) -- le port est donc libre quand le nouveau process
        démarre. Commande de relance = [sys.executable, __file__], sans
        argument -- reproduit exactement le mode par défaut de main()
        (aucun des flags --sautoniax/--instance-id/--serveur testés dans
        if __name__ == "__main__"), cohérent avec le fait que ce
        raccourci ne peut être déclenché QUE depuis l'app graphique
        principale déjà lancée dans ce mode."""
        confirme = BoiteDialogueAutoniaX.question(
            self, "Redémarrer AutoniaX",
            "Redémarrer l'application AutoniaX ?\n\n"
            "Toute modification non sauvegardée dans l'éditeur de Task "
            "sera perdue. Les sAutoniax connectés ne seront pas affectés "
            "(ils retentent automatiquement leur reconnexion).",
        )
        if not confirme:
            return

        if not getattr(self, "_relance_app_programmee", False):
            self._relance_app_programmee = True
            commande_relance = [sys.executable, str(Path(__file__).resolve())]

            def _relancer_nouveau_process():
                try:
                    subprocess.Popen(
                        commande_relance,
                        cwd=str(Path(__file__).resolve().parent),
                        close_fds=True,
                    )
                except Exception as e:
                    log_dashboard_ui.error(
                        f"[REDEMARRAGE-APP] échec du lancement du nouveau process -- {e!r}"
                    )

            QApplication.instance().aboutToQuit.connect(_relancer_nouveau_process)

        self._afficher_message_statut_reseau(True, "Redémarrage d'AutoniaX en cours...", duree_ms=0)
        self.close()

    def _sur_raccourci_redemarrer_tous_sautoniax(self):
        """AJOUT (demande explicite utilisateur : "raccourir pour
        redemarer tout les Sautoniax"). Déclenche, pour CHAQUE sAutoniax
        actuellement connecté, EXACTEMENT le même appel que l'action
        "Redémarrer" du menu contextuel individuel de l'onglet Instances
        (cf. InstancesConnecteesScreen._afficher_menu_executants ->
        demande_redemarrer_executant -> ClientServeurT.redemarrer_
        executant) -- simple boucle, aucune nouvelle logique métier ni
        nouveau message serveurT (redemarrer_executant reste strictement
        ciblé UN id à la fois côté serveur, cf. sa docstring dans
        serveur.py : "simple relais CIBLÉ").

        Liste des cibles = InstancesConnecteesScreen.tous_ids_executants_
        connectes(), déjà exposée pour le même besoin par le bouton
        "Mettre à jour le dossier service API" (cf. sa docstring) --
        aucun état dupliqué ici. CORRECTIF -- contrairement au menu
        contextuel individuel (action_kill/deja_inactif, qui exclut à
        raison un sAutoniax déjà "inactif" puisqu'il n'y a rien à tuer),
        AUCUNE exclusion par statut ici : un redémarrage vise justement
        aussi bien un sAutoniax sans projet en cours (affiché "Inactif"
        à l'époque de cette capture utilisateur -- affiché "Actif"
        depuis le correctif de _libelle_statut, cf. sa docstring ;
        raccourci répondant à tort "Aucun sAutoniax connecté à
        redémarrer" avant CE correctif-ci, sans rapport avec le libellé)
        qu'un sAutoniax en cours d'exécution ou en erreur. Toute connexion présente dans
        tous_ids_executants_connectes() EST par définition un sAutoniax
        connecté, quel que soit son statut -- la seule garde utile est
        donc juste au-dessus (instances_screen/client_serveur_t
        disponibles), pas un filtre sur "statut".

        Message "en cours" affiché ICI immédiatement (même raison que
        _sur_raccourci_mettre_a_jour_autoniax_cloud juste au-dessus :
        déclenchable depuis n'importe quelle page, donc pas de barre de
        progression locale visible). Contrairement à mettre_a_jour_
        autoniax_cloud, il n'existe pas de signal agrégé "tout est fini"
        côté serveurT (redemarrer_executant_ack est UN ack par sAutoniax,
        cf. sa docstring dans serveur.py) -- l'agrégation "X/Y confirmés"
        se fait donc ICI, côté pilote, via un compteur local fermé sur
        cet appel précis (id_appel), pour ne pas mélanger les décomptes
        si l'utilisateur déclenche le raccourci une seconde fois avant
        la fin du premier. sur_resultat_redemarrer_executant de
        InstancesConnecteesScreen (déjà câblé sur ce même signal, cf.
        _build_screens) continue de recevoir et d'afficher chaque ack
        individuellement dans son propre label_statut, sans interférence
        -- multi-connect Qt standard, comme mise_a_jour_service_api_
        resultat plus haut."""
        reseau_screen = self.screens.get("reseau")
        instances_screen = getattr(reseau_screen, "instances_screen", None)
        if instances_screen is None or self.client_serveur_t is None:
            self._afficher_message_statut_reseau(False, "Redémarrage impossible (module réseau indisponible).")
            return

        ids_cibles = instances_screen.tous_ids_executants_connectes()
        if not ids_cibles:
            self._afficher_message_statut_reseau(False, "Aucun sAutoniax connecté à redémarrer.")
            return

        self._afficher_message_statut_reseau(
            True, f"Redémarrage de {len(ids_cibles)} sAutoniax en cours...", duree_ms=0
        )

        id_appel = object()
        self._redemarrage_masse_en_cours = id_appel
        total = len(ids_cibles)
        compteur = {"ok": 0, "echec": 0}
        ids_restants = set(ids_cibles)

        def _sur_ack(ok: bool, id_executant: str, message: str):
            if self._redemarrage_masse_en_cours is not id_appel:
                # Une nouvelle salve de redémarrage masse a été
                # déclenchée entre-temps -- cet ack appartient à
                # l'ancienne, on n'agrège plus dessus (évite un décompte
                # final erroné mélangeant deux appels).
                return
            if id_executant not in ids_restants:
                # Soit un ack d'un redémarrage individuel (menu
                # contextuel) sans rapport avec cette salve, soit un
                # second ack pour un id déjà comptabilisé ici -- ignoré
                # dans les deux cas (déjà traité par ailleurs par
                # instances_screen.sur_resultat_redemarrer_executant).
                return
            ids_restants.discard(id_executant)
            if ok:
                compteur["ok"] += 1
            else:
                compteur["echec"] += 1
            if compteur["ok"] + compteur["echec"] >= total:
                self.client_serveur_t.redemarrer_executant_resultat.disconnect(_sur_ack)
                if self._redemarrage_masse_en_cours is id_appel:
                    self._redemarrage_masse_en_cours = None
                if compteur["echec"] == 0:
                    self._afficher_message_statut_reseau(
                        True, f"Redémarrage transmis à {compteur['ok']}/{total} sAutoniax."
                    )
                else:
                    self._afficher_message_statut_reseau(
                        False,
                        f"Redémarrage : {compteur['ok']}/{total} transmis, "
                        f"{compteur['echec']} échec(s).",
                    )

        self.client_serveur_t.redemarrer_executant_resultat.connect(_sur_ack)
        for id_executant in ids_cibles:
            self.client_serveur_t.redemarrer_executant(id_executant)

    def _sur_raccourci_mettre_a_jour_autoniax_cloud(self):
        """AJOUT (demande explicite utilisateur : "je veux aussi un
        raccourci pour mettre à jour AutoniaX directement sur le cloud
        ... je veux qu'il y ait un message de statut qui dit bien que
        c'est en cours et signale quand c'est fini"). Déclenche
        EXACTEMENT le même appel que le bouton "Mettre à jour AutoniaX.py"
        de MiseAJourStockageScreen (cf. _sur_demande_mise_a_jour_app,
        element="autoniax") -- chemins autoniax/mouse_data/service_api/
        project résolus ici de la même façon, mouse_data/service_api/
        project étant de toute façon ignorés par ClientServeurT.
        _envoyer_mise_a_jour_app pour element="autoniax" (cf. sa
        docstring : "UN SEUL des trois part par appel").

        Message "en cours" affiché ICI immédiatement (avant même l'accusé
        mettre_a_jour_app_debut) car l'utilisateur peut déclencher ce
        raccourci depuis n'importe quelle page -- contrairement au bouton
        de MiseAJourStockageScreen, il n'y a pas de barre de progression
        locale visible pour donner ce retour immédiat. Le message "fini"
        (succès ou échec) arrive séparément, automatiquement, via le
        multi-connect déjà existant de mise_a_jour_app_resultat vers
        _afficher_message_statut_reseau (cf. plus bas dans _build_screens)
        -- aucun câblage supplémentaire nécessaire pour cette partie,
        déjà partagée avec le bouton et avec Sync API."""
        if self.client_serveur_t is None:
