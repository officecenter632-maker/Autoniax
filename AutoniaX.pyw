def _marqueur_page_accueil(instance_id: str) -> str:
    """OBSOLÈTE, CODE MORT depuis le passage à la data: URL (cf.
    _data_url_page_accueil / _injecter_page_accueil) -- conservée
    uniquement pour référence/debug, plus aucun appelant actif dans ce
    fichier. Fragment d'URL utilisé par l'ancienne approche pour
    reconnaître « cet onglet affiche la welcome page de CETTE instance ».
    ABANDONNÉE car une navigation Page.navigate vers un about:blank#fragment
    est traitée par Chrome/Vivaldi comme un simple changement de fragment
    (navigation same-document), ce qui ne réveille PAS le renderer sur
    Vivaldi -- cf. docstring de _injecter_page_accueil pour le détail du
    bug que ça causait."""
    return f"{URL_MARQUEUR_PAGE_ACCUEIL}-{instance_id or 'default'}"


def _html_dashboard_introuvable() -> str:
    """Court message d'aide affiche a la place du Dashboard quand
    dashboard.html est absent ou vide (cf. contenu_page_accueil).
    DECISION EXPLICITE UTILISATEUR : "option 2" -- un message minimal,
    PAS un dashboard de secours code en dur ("surtout n'embarque rien").
    Volontairement sobre : son seul role est d'eviter une page blanche
    qui ressemblerait a un bug, en disant OU deposer le fichier.
    Le chemin est echappe pour l'HTML (get_dashboard_html_path peut
    contenir des caracteres speciaux sous Windows : backslash, espaces)."""
    import html as _html
    chemin = _html.escape(str(get_dashboard_html_path()))
    return (
        '<!DOCTYPE html><html lang="fr"><head><meta charset="utf-8">'
        '<meta name="viewport" content="width=device-width, initial-scale=1">'
        '<title>AutoniaX</title>'
