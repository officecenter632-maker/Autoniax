        MainWindow), jamais seule."""
        if self._loop is None or not self._loop.is_running():
            self.mise_a_jour_project_json_resultat.emit(False, id_executant, "Non connecté au serveurT.")
            return
        asyncio.run_coroutine_threadsafe(
