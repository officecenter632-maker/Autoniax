# ComposantExecutable — classe manipulée par un script Task (TaskConfig, à
# venir), en PUR PYTHON (décision explicite utilisateur -- pas de langage de
# script custom "autone", finalement abandonné au profit de vrai code Python
# exécuté tel quel). Exemple d'usage voulu par l'utilisateur :
#
#   if MonComposant.visible():
#       MonComposant.click()
#       MonComposant.click(ZoneClicRect(x, y, largeur, hauteur))  # zone ponctuelle
#       MonComposant.scroll(depart=depart, arrivee=arrivee)
#   MonComposant.drag(chemin_fichier)
#   MonComposant.saisir("hi here is ...")
#
# Un Task importera des Composants d'un (ou plusieurs) ServiceAPI ; chacun
# sera exposé au script sous une variable Python portant son nom (décision
# explicite utilisateur : "il n'y a pas de tirets dans mon nommage", donc pas
# de logique d'assainissement complexe nécessaire en usage normal -- un
# filet de sécurité minimal est quand même appliqué ci-dessous par prudence,
# au cas où un nom contiendrait un caractère non valide en identifiant
# Python).
#
# Méthodes : reprises 1:1 des fonctions bas niveau déjà existantes plus loin
# dans ce fichier (action_click, action_scroll, action_paste, action_clear,
# action_type_text, action_drag, action_mousemove, action_move_cursor),
# mêmes noms SANS le préfixe "action_" (décision explicite utilisateur),
# mêmes paramètres significatifs (bouton, durée, direction/delta, texte,
# délais, chemin de fichier...).
#
# IMPORTANT — pas encore branché sur une exécution réelle (décision
# explicite utilisateur, "à définir plus tard, se concentrer d'abord sur la
# classe et ses méthodes") : ces fonctions bas niveau sont asynchrones et
# tournent dans le process SÉPARÉ de l'instance navigateur (cf. commentaires
# plus loin dans ce fichier, section "Instance nodriver"), jamais importées
# ici. Un vrai pont d'exécution devra être construit (réseau + boucle
# asyncio + attente de résultat, sur le modèle de SequenceurActionReseau
# déjà utilisé par TestActionScreen) avant que ces méthodes puissent agir
# pour de vrai. En attendant, chaque méthode :
#   - valide ses arguments comme le ferait l'appel réel,
#   - journalise clairement l'action qui SERAIT effectuée,
#   - lève NotImplementedError avec un message explicite plutôt que de
#     réussir silencieusement sans rien faire -- un script Task qui
#     croirait avoir cliqué alors que rien ne s'est passé serait trompeur.
# .visible() suit la même logique : pas encore branché sur la détection
# visuelle OpenCV (matchTemplate, cf. plus haut dans ce fichier), qui
# nécessite elle aussi un frame capturé côté instance.
# ---------------------------------------------------------------------------

log_composant_executable = logging.getLogger("autoniax.composant_executable")


def nom_variable_python(nom_composant: str) -> str:
    """Dérive un nom de variable Python valide à partir du nom d'un
    Composant (ex: "Word-BoutonEnregistrer" -> "Word_BoutonEnregistrer"),
    pour l'exposer tel quel dans l'espace de noms d'un script Task.

    Filet de sécurité défensif seulement (décision explicite utilisateur :
    le nommage réel des composants ne contient pas de tiret) -- caractères
    non valides en identifiant Python remplacés par "_", préfixé par "_" si
    le résultat commence par un chiffre ou est un mot-clé Python réservé
    (ex: "class" -> "_class"), pour ne jamais produire un nom qui ferait
    planter le script à l'exécution."""
    nom = re.sub(r"\W", "_", nom_composant)
    if not nom or nom[0].isdigit():
        nom = f"_{nom}"
    if keyword.iskeyword(nom):
        nom = f"_{nom}"
    return nom


# Capture "nom_variable = NomServiceAPI . instance ( )" -- même regex que
# TaskScriptEditor._REGEX_AFFECTATION_INSTANCE (auto-complétion, portée à
# UNE seule cellule/l'éditeur courant), dupliquée ici au niveau module car
# _services_api_utilises_dans_code doit pouvoir résoudre ce pattern à
# travers TOUTES les cellules d'un Task, y compris depuis le moteur
# headless du Projet Batch qui n'a accès à aucun widget d'éditeur. group(1)
# = nom de variable affecté, group(2) = nom du ServiceAPI dont on appelle
# .instance().
_REGEX_AFFECTATION_INSTANCE_MODULE = re.compile(
    r"([A-Za-z_][A-Za-z0-9_]*)\s*=\s*([A-Za-z_][A-Za-z0-9_]*)\s*\.\s*instance\s*\(\s*\)"
)


def _services_api_utilises_dans_code(project: "Project", task: "Task", code: str) -> set:
    """Détermine quels ServiceAPI importés dans un Task sont RÉELLEMENT
    référencés dans un bout de code précis (une cellule) -- pour chaque
    Composant importé, on cherche son nom de variable Python (cf.
    nom_variable_python) comme identifiant isolé dans le texte du code
    (recherche par mot entier \\b, pour éviter qu'un nom de variable soit
    un simple sous-texte d'un autre identifiant plus long). Analyse
    volontairement simple (pas un vrai parsing AST) : un faux positif
    (nom mentionné mais pas réellement utilisé, ex. dans un commentaire
    ou une chaîne) exige juste une liaison de plus que strictement
    nécessaire -- pas grave. Un faux négatif est pratiquement impossible :
    le composant doit être nommé tel quel pour être utilisé.

    Teste AUSSI le nom du ServiceAPI lui-même (cf. ServiceAPIExecutable,
    ex: Word.instance()) -- un script peut utiliser une instance SANS
    jamais référencer aucun de ses composants (ex: Instance =
    Word.instance(); Instance.capture()), auquel cas la boucle sur les
    composants ci-dessous ne trouverait rien et l'instance ne serait
    jamais liée avant l'exécution (BUG constaté historiquement : timeout
    "aucune réponse de l'instance", instance jamais link-ée côté serveur).

    BUG CORRIGÉ (ce tour -- variante restée non couverte du même bug) :
    ce qui précède ne couvre que "Word.instance()" écrit DIRECTEMENT dans
    LA MÊME cellule que celle qu'on analyse. Mais dans un notebook (espace
    de noms partagé entre cellules, cf. docstring de Task), le pattern
    courant est "Instance = Word.instance()" dans une cellule d'init, puis
    "Instance.new_tab(...)" dans une AUTRE cellule, exécutée séparément
    -- cette dernière ne mentionne ni "Word" ni aucun composant, donc
    services_utilises était vide pour elle, l'instance jamais liée avant
    son exec(), et new_tab (ou toute autre méthode) échouait immédiatement
    côté serveur ("instance non liée") -- confirmé par les logs utilisateur
    (services_utilises détectés dans le code = set() pour une cellule ne
    contenant que "Instance.new_tab(url_cible)"). On résout donc en plus,
    pour chaque service importé, si son nom de variable "Instance" (choisi
    par l'utilisateur via une affectation "Instance = Word.instance()" dans
    N'IMPORTE QUELLE cellule du Task -- avant ou après dans l'ordre
    d'affichage, un notebook n'imposant aucun ordre d'exécution particulier,
    cf. point 3 déjà validé) est ensuite référencé dans le code de LA
    cellule analysée.

    Fonction libre (pas une méthode de TaskConfigScreen) : ne dépend que
    de `project` et `task`, passés explicitement -- réutilisée telle
    quelle par TaskConfigScreen._services_api_utilises_dans_code (simple
    délégation, cf. son corps) ET par le moteur d'exécution headless du
    Projet Batch (cf. MoteurExecutionTaskHeadless), qui n'a accès à
    aucune instance de TaskConfigScreen."""
    groupes = project.composants_importes_task(task)

    # Toutes les affectations "var = NomServiceAPI.instance()" trouvées
    # dans N'IMPORTE QUELLE cellule du Task (cellule_variables + cellules),
    # peu importe si c'est la cellule en cours d'analyse ou une autre --
    # {nom_service: {noms de variables qui lui correspondent}}. Un même
    # service peut avoir plusieurs variables différentes s'il a été
    # instancié sous des noms différents dans plusieurs cellules.
    variables_par_service: dict[str, set] = {}
    codes_task = []
    cellule_variables = getattr(task, "cellule_variables", None)
    if cellule_variables is not None:
        codes_task.append(getattr(cellule_variables, "code", "") or "")
    for c in getattr(task, "cellules", None) or []:
        codes_task.append(getattr(c, "code", "") or "")
    noms_services_connus = set(groupes.keys())
    for code_cellule in codes_task:
        for nom_var, nom_service in _REGEX_AFFECTATION_INSTANCE_MODULE.findall(code_cellule):
            if nom_service in noms_services_connus:
                variables_par_service.setdefault(nom_service, set()).add(nom_var)

    resultat = set()
    for nom_service, composants in groupes.items():
        # DÉCISION UTILISATEUR : dès qu'une variable d'instance existe pour
        # ce service QUELQUE PART dans le notebook (variables_par_service,
        # déjà calculé plus haut sur TOUTES les cellules du Task), ce
        # service est considéré utilisé par TOUTE cellule du Task -- sans
        # exiger que le nom de cette variable (ni celui du service, ni
        # celui d'un composant) apparaisse littéralement dans le texte de
        # la cellule analysée. Raison : l'espace de noms est partagé
        # (notebook), donc une cellule peut très bien utiliser l'instance
        # indirectement via une fonction définie ailleurs (ex. new_chat())
        # sans jamais mentionner "instance"/"claude"/un composant dans son
        # propre texte -- l'ancienne détection au cas par cas la ratait
        # alors systématiquement (timeout "instance non liée" en
        # exécution, cf. logs). Un faux positif ici (cellule liée à un
        # service qu'elle n'utilise en fait pas) coûte juste une liaison
        # de plus que strictement nécessaire -- pas grave (cf. docstring
        # de cette fonction) ; c'est l'ancien comportement, plus restrictif
        # cellule par cellule, qui produisait des faux négatifs bloquants.
        if variables_par_service.get(nom_service):
            resultat.add(nom_service)
            continue

        nom_var_service = nom_variable_python(nom_service)
        if re.search(rf"\b{re.escape(nom_var_service)}\b", code):
            resultat.add(nom_service)
            continue
        for composant in composants:
            nom_var = nom_variable_python(composant.nom)
            if re.search(rf"\b{re.escape(nom_var)}\b", code):
                resultat.add(nom_service)
                break
    return resultat


class _ExtracteurTexteHTML(HTMLParser):
    """Parseur HTML minimal (stdlib uniquement, cf. extraire_texte_fichier)
    qui ne conserve que le texte visible d'une page : ignore le contenu de
    <script>/<style> (jamais du texte destiné à être lu), et insère un saut
    de ligne aux changements de balises de bloc usuelles (p, div, br, li,
    tr, titres...) pour que le résultat reste lisible au lieu d'un mur de
    texte collé -- pas un rendu fidèle (ce n'est pas le but ici, juste une
    EXTRACTION de texte), volontairement simple plutôt qu'une dépendance
    externe (bs4/lxml) non garantie présente dans l'environnement de tous
    les utilisateurs."""

    _BALISES_BLOC = {
        "p", "div", "br", "li", "tr", "h1", "h2", "h3", "h4", "h5", "h6",
        "section", "article", "header", "footer", "table", "ul", "ol",
    }
    _BALISES_IGNOREES = {"script", "style", "head", "noscript"}

    def __init__(self):
        super().__init__(convert_charrefs=True)
        self._morceaux: list = []
        self._profondeur_ignoree = 0  # >0 tant qu'on est dans <script>/<style>/...

    def handle_starttag(self, tag, attrs):
        if tag in self._BALISES_IGNOREES:
            self._profondeur_ignoree += 1
        elif tag in self._BALISES_BLOC:
            self._morceaux.append("\n")

    def handle_endtag(self, tag):
        if tag in self._BALISES_IGNOREES:
            self._profondeur_ignoree = max(0, self._profondeur_ignoree - 1)
        elif tag in self._BALISES_BLOC:
            self._morceaux.append("\n")

    def handle_data(self, data):
        if self._profondeur_ignoree == 0 and data:
            self._morceaux.append(data)

    def texte_final(self) -> str:
        """Assemble les morceaux collectés puis normalise l'espacement :
        espaces/tabulations multiples réduits à un seul espace (les
        retours à la ligne du HTML source lui-même, hors balises de bloc,
        n'ont aucune signification visuelle et ne doivent pas produire des
        sauts de ligne dans le résultat), et jamais plus de deux sauts de
        ligne consécutifs (évite un résultat truffé de lignes vides pour
        du HTML très découpé en balises imbriquées)."""
        brut = "".join(self._morceaux)
        brut = re.sub(r"[ \t\r\f\v]+", " ", brut)
        brut = re.sub(r" *\n *", "\n", brut)
        brut = re.sub(r"\n{3,}", "\n\n", brut)
        return brut.strip()


def extraire_texte_fichier(chemin: str) -> str:
    """Fonction prédéfinie exposée aux scripts Task (cf. _namespace_task) :
    lit un fichier .txt, .md ou .html/.htm sur disque et en renvoie le
    contenu textuel sous forme d'une seule chaîne de caractères.

    - .txt / .md : lu tel quel (le Markdown reste un format texte -- pas
      de rendu HTML/formatage ici, seulement une lecture de fichier ;
      décision cohérente avec "extrait le texte", pas "convertit en
      Markdown rendu").
    - .html / .htm : le texte visible est extrait via un parseur HTML
      minimal (cf. _ExtracteurTexteHTML), le contenu de <script>/<style>
      étant ignoré -- jamais du texte destiné à être lu par un humain.

    Usage typique dans une cellule :
        texte = extraire_texte_fichier("C:/Users/moi/notes.txt")
        texte = extraire_texte_fichier(r"C:\\rapports\\resultat.html")

    Lève FileNotFoundError si le chemin n'existe pas, ValueError si
    l'extension n'est pas .txt/.md/.html/.htm -- plutôt que d'avaler
    l'erreur et renvoyer une chaîne vide, pour que l'utilisateur voie
    immédiatement dans la sortie de la cellule ce qui a concrètement
    échoué (chemin invalide vs mauvais type de fichier), au lieu de
    devoir deviner pourquoi son texte est mystérieusement vide plus loin
    dans le script."""
    chemin_obj = Path(chemin)
    if not chemin_obj.exists():
        raise FileNotFoundError(f"Fichier introuvable : {chemin}")
    if not chemin_obj.is_file():
        raise FileNotFoundError(f"Ce n'est pas un fichier : {chemin}")

    extension = chemin_obj.suffix.lower()
    if extension not in (".txt", ".md", ".html", ".htm"):
        raise ValueError(
            f"Extension non supportée : '{extension}' -- "
            "extraire_texte_fichier() accepte uniquement .txt, .md, .html ou .htm"
        )

    # encoding="utf-8", errors="replace" : ne fait jamais planter
    # l'extraction sur un fichier dans un encodage inattendu (latin-1,
    # etc.) -- un caractère mal décodé devient un caractère de
    # remplacement (�) plutôt qu'une UnicodeDecodeError qui interromprait
    # toute la cellule pour un simple souci d'encodage.
    contenu_brut = chemin_obj.read_text(encoding="utf-8", errors="replace")

    if extension in (".txt", ".md"):
        return contenu_brut

    extracteur = _ExtracteurTexteHTML()
    extracteur.feed(contenu_brut)
    return extracteur.texte_final()


def ecrire_texte_fichier(chemin: str, texte: str) -> None:
    """Fonction prédéfinie exposée aux scripts Task (cf. _namespace_task) :
    écrit `texte` dans le fichier `chemin`, en l'écrasant s'il existe déjà
    et en le créant s'il n'existe pas encore -- symétrique de
    extraire_texte_fichier (lecture), mais volontairement plus permissive
    sur l'extension : contrairement à la lecture (qui doit deviner COMMENT
    interpréter un contenu existant selon son type), l'écriture se contente
    toujours d'une chaîne de caractères brute, quel que soit le nom donné
    au fichier -- aucune vérification d'extension ici.

    Usage typique dans une cellule :
        ecrire_texte_fichier("C:/Users/moi/notes.txt", "Bonjour le monde")
        ecrire_texte_fichier(r"C:\\rapports\\resultat.md", texte_genere)

    Crée aussi les dossiers parents manquants (mkdir avec parents=True,
    exist_ok=True) : cohérent avec "si le fichier n'existe pas, il le
    crée" -- un chemin dont le dossier n'existe pas encore ne doit pas
    faire échouer l'écriture pour cette seule raison.

    Lève TypeError si `texte` n'est pas une chaîne de caractères --
    plutôt que de laisser Path.write_text lever une erreur plus confuse
    plus loin, ou pire, convertir silencieusement une valeur inattendue
    (ex: un ResultatAction passé par erreur) en son repr() écrit tel
    quel dans le fichier."""
    if not isinstance(texte, str):
        raise TypeError(
            f"ecrire_texte_fichier() attend une chaîne de caractères pour "
            f"'texte', reçu : {type(texte).__name__}"
        )

    chemin_obj = Path(chemin)
    if chemin_obj.parent and not chemin_obj.parent.exists():
        chemin_obj.parent.mkdir(parents=True, exist_ok=True)

    # encoding="utf-8" : cohérent avec la lecture (extraire_texte_fichier),
    # qui décode elle aussi en utf-8 -- un fichier écrit ici est donc
    # relisible tel quel par extraire_texte_fichier sans mauvaise surprise
    # d'encodage.
    chemin_obj.write_text(texte, encoding="utf-8")


# Identifiant unique à CE process (généré une seule fois, au chargement
# du module) -- évite toute collision si plusieurs instances AutoniaX
# tournent en même temps sur la même machine (ex. plusieurs sAutoniax
# locaux pour test), chacune avec son propre sous-dossier temporaire.
_ID_PROCESS_TEMP_API2API = uuid.uuid4().hex[:12]


def get_temp_api2api_dir() -> Path:
    """Dossier temporaire dédié à textFile()/TextFile (cf. leur
    docstring) -- et, en interne, aux fichiers reçus/envoyés par
    Api2Api.request()/attendre_requete() (cf. leurs docstrings plus bas)
    avant/après transmission réseau. Volontairement PAS sous
    _chemin_donnees()/AUTONIAX_DATA_DIR : ce dernier est un dossier de
    données PERSISTANT (profils, captures...) sur mAutoniax desktop --
    seul le mode sAutoniax le vide au démarrage (cf. notebook Kaggle/
    Colab, etape_3_configurer_environnement), pas mAutoniax. Or la
    demande explicite (cf. spécification textFile()) est que ce contenu
    "doit disparaître à chaque redémarage [...] cest juste lier a la
    dure dexecution du programme" -- QUEL QUE SOIT l'environnement
    (machine locale, Kaggle, Colab). tempfile.gettempdir() garantit
    exactement ça nativement, sur les trois : %TEMP% sous Windows,
    /tmp sous Linux (Kaggle/Colab inclus) -- vidé par l'OS/la VM
    éphémère elle-même à la prochaine session, sans logique de nettoyage
    à écrire ou maintenir ici. _ID_PROCESS_TEMP_API2API isole les
    fichiers de CE lancement précis des autres (cf. sa docstring)."""
    d = Path(tempfile.gettempdir()) / "autoniax_api2api_tmp" / _ID_PROCESS_TEMP_API2API
    d.mkdir(parents=True, exist_ok=True)
    return d


class TextFile:
    """Fonction prédéfinie exposée aux scripts Task (cf. _namespace_task
    et l'équivalent réseau _sautoniax_executer_notebook_distant) sous le
    nom textFile (cf. plus bas -- alias en minuscule, cohérent avec les
    autres primitives de script comme attendre_requete) : crée un
    fichier texte temporaire à un chemin ALÉATOIRE (nom/emplacement
    exacts sans importance pour l'utilisateur, cf. demande explicite :
    "je mefiche du noms ou path du fichier"), pour préparer des données
    à passer à Api2Api.request() ou pour tout autre usage nécessitant un
    fichier temporaire jetable.

    Usage typique dans une cellule :
        File = textFile()
        File.write("bonjour")
        chemin = File.path   # chemin absolu du fichier, contenant "bonjour"

    Le fichier est créé sous get_temp_api2api_dir() (cf. sa docstring
    pour la garantie "disparaît à chaque redémarrage", identique quel
    que soit l'environnement d'exécution) -- PAS créé tant que .write()
    n'a pas été appelée au moins une fois (cf. .path, qui lève
    explicitement plutôt que de renvoyer un chemin vers un fichier
    inexistant si on y accède avant tout .write())."""

    __slots__ = ("_chemin",)

    def __init__(self):
        self._chemin: Optional[Path] = None

    def write(self, texte: str) -> None:
        """Écrit `texte` dans le fichier (l'écrase s'il existe déjà --
        plusieurs .write() successifs sur le même TextFile réécrivent le
        même fichier, cohérent avec ecrire_texte_fichier ci-dessus).
        Lève TypeError si `texte` n'est pas une chaîne, même garde que
        ecrire_texte_fichier pour la même raison (cf. sa docstring)."""
        if not isinstance(texte, str):
            raise TypeError(f"TextFile.write() attend une chaîne de caractères, reçu : {type(texte).__name__}")
        if self._chemin is None:
            nom_fichier = f"{uuid.uuid4().hex[:16]}.txt"
            self._chemin = get_temp_api2api_dir() / nom_fichier
        self._chemin.write_text(texte, encoding="utf-8")

    @property
    def path(self) -> str:
        """Chemin absolu du fichier temporaire -- lève RuntimeError si
        appelé avant tout .write() (aucun fichier n'existe encore sur
        disque, cf. docstring de classe) plutôt que de renvoyer None ou
        un chemin vers un fichier inexistant qui échouerait plus loin de
        façon confuse (ex. dans Api2Api.request())."""
        if self._chemin is None:
            raise RuntimeError("TextFile.path : aucun fichier créé -- appelle .write(...) au moins une fois avant d'accéder à .path.")
        return str(self._chemin)

    def __repr__(self) -> str:
        return f"TextFile(path={self._chemin!r})" if self._chemin is not None else "TextFile(<pas encore écrit>)"


def textFile() -> "TextFile":
    """Fonction prédéfinie exposée aux scripts Task (cf. _namespace_task)
    -- alias fonctionnel de TextFile() (cf. sa docstring pour l'usage
    complet), nommée ainsi pour correspondre exactement à la syntaxe
    demandée : File = textFile(); File.write("bonjour"); File.path."""
    return TextFile()


# ---------------------------------------------------------------------
# Api2Api -- primitives exposées aux scripts Task (cf. Api2Api_
# specification.md). Contrairement à TextFile/textFile ci-dessus
# (aucune dépendance externe), Api2Api()/attendre_requete() ont
# STRUCTURELLEMENT besoin d'un ClientServeurT pour parler au serveurT
# (cf. ClientServeurT.api2api_enregistrer_bloquant et les méthodes
# api2api_* voisines, déjà écrites plus haut dans ce fichier) -- or la
# syntaxe demandée par la spécification est Api2Api() / attendre_
# requete(), SANS argument. Résolu par injection de fermeture (closure,
# même principe EXACT que `resolveur_moteur` dans TaskConfigScreen.
# _executer_cellule pour ComposantExecutable) : _construire_espace_
# noms_api2api(client_serveur_t) ci-dessous renvoie DEUX callables
# (une classe Api2Api déjà liée à ce client, et une fonction
# attendre_requete déjà liée) prêts à être injectés tels quels dans le
# namespace d'exécution -- ni _namespace_task (mode local) ni
# _sautoniax_executer_notebook_distant (mode réseau) n'ont besoin de
# connaître ce détail : ils appellent juste cette fonction avec LEUR
# propre client_serveur_t/client_t respectif (cf. ces deux points
# d'injection) et injectent son résultat.
# ---------------------------------------------------------------------


class RequeteApi2Api:
    """Une requête reçue côté FOURNISSEUR (cf. attendre_requete()) --
    req.donnees = liste de chemins de fichiers LOCAUX (déjà décodés
    depuis le base64 réseau et matérialisés sur disque sous get_temp_
    api2api_dir(), même mécanisme que TextFile -- l'utilisateur ne
    manipule jamais de base64 lui-même, cf. spécification : "req.donnees
    = liste de chemins de fichiers reçus, code utilisateur normal").
    req.repondre(resultat) renvoie `resultat` au client appelant (cf.
    Api2Api.request, côté symétrique) -- resultat : un chemin de fichier
    (str/Path) unique, OU une liste de chemins, encodés ici en base64
    exactement comme Api2Api.request le fait pour ses propres Data*
    (cf. _encoder_fichiers_api2api, factorisé pour être partagé par les
    deux sens)."""

    __slots__ = ("_client_serveur_t", "_requete_id", "donnees", "_repondue")

    def __init__(self, client_serveur_t: "ClientServeurT", requete_id: str, donnees: list):
        self._client_serveur_t = client_serveur_t
        self._requete_id = requete_id
        self.donnees = donnees
        # BUGFIX (retour utilisateur : "je veux qu'une erreur soit
        # retransmise, pas que la Task cliente tourne indéfiniment") --
        # drapeau consulté par _repondre_echec_si_besoin (cf. sa
        # docstring) pour savoir si CETTE requête a déjà reçu une vraie
        # réponse (succès normal via req.repondre() dans le script) avant
        # d'envoyer un échec automatique en son nom après un crash --
        # jamais écrasé une fois à True (cf. repondre() ci-dessous).
        self._repondue = False

    def repondre(self, resultat) -> None:
        """Envoie `resultat` en réponse à cette requête -- accepte un
        seul chemin de fichier (str/Path) ou une liste/tuple de chemins
        (cf. Api2Api.request, symétrique : "response*" reçus côté
        appelant sont TOUJOURS une liste de chemins, même si un seul
        fichier a été renvoyé ici -- normalisation faite côté Api2Api.
        request, pas ici). Fire-and-forget côté réseau (cf. ClientServeurT
        .api2api_repondre) -- aucune confirmation d'arrivée, cohérent
        avec le choix déjà fait pour cette moitié du protocole."""
        chemins = resultat if isinstance(resultat, (list, tuple)) else [resultat]
        donnees_encodees = _encoder_fichiers_api2api(chemins)
        self._client_serveur_t.api2api_repondre(self._requete_id, True, donnees_encodees)
        self._repondue = True

    def _repondre_echec(self, message_erreur: str) -> None:
        """Réservé à _repondre_echec_si_besoin (cf. sa docstring) --
        envoie un échec explicite {"ok": False, "erreur": ...} au client
        qui attend cette requête, SANS jamais lever elle-même (best-
        effort, cf. api2api_repondre déjà fire-and-forget) : appelée
        depuis un contexte de nettoyage après crash, où une exception
        supplémentaire ici ne ferait qu'aggraver la situation sans
        bénéfice."""
        try:
            self._client_serveur_t.api2api_repondre(self._requete_id, False, [], erreur=message_erreur)
        except Exception:
            pass
        self._repondue = True

    def __repr__(self) -> str:
        return f"RequeteApi2Api(donnees={self.donnees!r})"


def _encoder_fichiers_api2api(chemins) -> list:
    """Factorise l'encodage {"nom": str, "contenu_b64": str} partagé par
    Api2Api.request() (appelant -> fournisseur) ET RequeteApi2Api.
    repondre() (fournisseur -> appelant) -- même format des deux côtés
    (cf. serveur.py, handlers api2api_requete/api2api_reponse, "donnees"
    transporté tel quel sans jamais être interprété par le serveurT).
    `nom` = juste le nom de fichier (pas le chemin complet -- inutile et
    potentiellement révélateur du système de fichiers local de
    l'émetteur) ; le fichier DOIT exister (FileNotFoundError explicite
    sinon, plutôt qu'un échec réseau confus côté fournisseur/appelant
    distant)."""
    resultat = []
    for chemin in chemins:
        p = Path(chemin)
        if not p.is_file():
            raise FileNotFoundError(f"Api2Api : fichier introuvable : {chemin!r}")
        contenu_b64 = base64.b64encode(p.read_bytes()).decode("ascii")
        resultat.append({"nom": p.name, "contenu_b64": contenu_b64})
    return resultat


def _decoder_fichiers_api2api(donnees: list) -> list:
    """Symétrique de _encoder_fichiers_api2api : matérialise chaque
    {"nom": str, "contenu_b64": str} reçu en un vrai fichier sur disque
    sous get_temp_api2api_dir() (même dossier éphémère que TextFile,
    cf. sa docstring -- "disparaît à chaque redémarrage", cohérent),
    préfixé d'un identifiant aléatoire pour éviter toute collision entre
    deux fichiers reçus portant le même nom d'origine (ex. deux requêtes
    successives envoyant chacune un "image.png"). Renvoie la liste des
    chemins absolus (str), dans le même ordre que `donnees` -- c'est
    cette liste, telle quelle, qui devient req.donnees côté fournisseur
    OU response* côté appelant (cf. leurs docstrings respectives)."""
    chemins = []
    dossier = get_temp_api2api_dir()
    for entree in donnees:
        nom_original = entree.get("nom") or "fichier"
        contenu = base64.b64decode(entree.get("contenu_b64", ""))
        chemin = dossier / f"{uuid.uuid4().hex[:12]}_{nom_original}"
        chemin.write_bytes(contenu)
        chemins.append(str(chemin))
    return chemins


def _construire_espace_noms_api2api(client_serveur_t: "ClientServeurT") -> dict:
    """Construit et renvoie {"Api2Api": ..., "attendre_requete": ...}
    déjà liés à `client_serveur_t` (cf. docstring de section, principe
    de la fermeture) -- appelée UNE FOIS par _namespace_task (mode
    local, client_serveur_t = TaskConfigScreen._client_serveur_t) et
    UNE FOIS par _sautoniax_executer_notebook_distant (mode réseau,
    client_serveur_t = client_t, le ClientServeurT du sAutoniax lui-même)
    -- cf. ces deux points d'appel pour le détail de l'injection dans
    chaque namespace."""

    class Api2Api:
        """Exposée au script Task sous ce même nom (cf. spécification) :

            Api2ApiTask = Api2Api()                 # bloque jusqu'à verrouillage d'un Api2Api libre
            reponse = Api2ApiTask.request(Data1, Data2)  # une requête groupée, plusieurs fichiers
            Api2ApiTask.free()                       # libère explicitement le verrou

        Le constructeur BLOQUE (cf. ClientServeurT.api2api_verrouiller_
        bloquant) jusqu'à ce qu'un Task Api2Api libre soit trouvé ET
        verrouillé pour ce client, ou jusqu'au timeout -- lève
        RuntimeError si aucun ne s'est libéré à temps ou en cas d'échec
        réseau (plutôt que de renvoyer un objet à moitié construit que
        .request()/.free() géreraient mal ensuite)."""

        __slots__ = ("_client_serveur_t", "_id_api2api", "_libere")

        _TIMEOUT_ATTENTE_VERROU_S_DEFAUT = 60.0
        _TIMEOUT_REQUETE_S_DEFAUT = 120.0

        def __init__(self, timeout_attente_s: Optional[float] = None):
            self._client_serveur_t = client_serveur_t
            self._libere = False
            resultat = client_serveur_t.api2api_verrouiller_bloquant(
                timeout_attente_s if timeout_attente_s is not None else self._TIMEOUT_ATTENTE_VERROU_S_DEFAUT,
            )
            if not resultat.get("ok", False):
                raise RuntimeError(f"Api2Api() : impossible de verrouiller un Task Api2Api libre -- {resultat.get('erreur', 'erreur inconnue')}")
            self._id_api2api = resultat["id_api2api"]

        def request(self, *fichiers, timeout_s: Optional[float] = None) -> list:
            """Envoie fichiers (chemins locaux, un ou plusieurs -- cf.
            docstring de section : un seul paquet réseau groupé même
            pour plusieurs fichiers) au Task Api2Api verrouillé par
            cette instance, BLOQUE jusqu'à la réponse du fournisseur
            (req.repondre(...) côté script fournisseur), et renvoie la
            réponse matérialisée en chemins de fichiers locaux (TOUJOURS
            une liste, même si le fournisseur n'a répondu qu'un seul
            fichier -- cf. RequeteApi2Api.repondre, normalisation faite
            ici pour un contrat de retour prévisible). Lève RuntimeError
            en cas d'échec (Api2Api introuvable/déconnecté entretemps,
            timeout, erreur explicite du fournisseur)."""
            if self._libere:
                raise RuntimeError("Api2Api.request() : ce verrou a déjà été libéré (.free() déjà appelé).")
            donnees_encodees = _encoder_fichiers_api2api(fichiers)
            resultat = self._client_serveur_t.api2api_requete_bloquant(
                self._id_api2api, donnees_encodees,
                timeout_s if timeout_s is not None else self._TIMEOUT_REQUETE_S_DEFAUT,
            )
            if not resultat.get("ok", False):
                raise RuntimeError(f"Api2Api.request() : {resultat.get('erreur', 'erreur inconnue')}")
            return _decoder_fichiers_api2api(resultat.get("donnees", []))

        def free(self) -> None:
            """Libère EXPLICITEMENT le verrou (cf. spécification :
            libération automatique par inactivité en secours si oublié,
            mais .free() reste la voie normale). Idempotent -- un second
            appel ne fait rien plutôt que d'échouer ou de relibérer un
            id_api2api qui pourrait entretemps appartenir à un autre
            client."""
            if self._libere:
                return
            self._libere = True
            self._client_serveur_t.api2api_liberer(self._id_api2api)

        def __repr__(self) -> str:
            return f"Api2Api(id={self._id_api2api!r}, libere={self._libere!r})"

    def attendre_requete(timeout_s: Optional[float] = None) -> "RequeteApi2Api":
        """Exposée au script Task sous ce même nom (cf. spécification,
        côté FOURNISSEUR -- un Task de type Api2Api) :

            while True:
                req = attendre_requete()
                resultat = traiter(req.donnees)
                req.repondre(resultat)

        S'ENREGISTRE d'abord ce Task comme fournisseur Api2Api disponible
        si ce n'est pas déjà fait (cf. _ID_API2API_ENREGISTRE_PAR_NAMESPACE,
        mémorisé PAR namespace du SCRIPT -- un seul enregistrement pour
        toute la durée de vie du Task, jamais réenregistré à chaque
        appel de attendre_requete() dans la boucle while True:), PUIS
        bloque jusqu'à la prochaine requête (cf. ClientServeurT.api2api_
        attendre_requete_bloquant, timeout_s=None par défaut = attente
        indéfinie, cohérent avec l'usage attendu). Lève RuntimeError en
        cas d'échec d'enregistrement ou de timeout explicite (si
        timeout_s a été précisé).

        BUGFIX (clé de mémorisation) -- indexée par id(namespace_courant),
        PAS id(client_serveur_t) comme avant ce correctif : plusieurs
        Task PARTAGENT la même instance client_serveur_t côté mAutoniax
        (un seul ClientServeurT pour tout le process -- TaskConfigScreen
        ET chaque MoteurExecutionTaskHeadless en parallèle l'utilisent
        tous, cf. leurs constructions respectives). Avec l'ancienne clé
        id(client_serveur_t), arrêter N'IMPORTE QUEL AUTRE Task du même
        process (même sans aucun rapport avec Api2Api) désenregistrait
        par erreur CE Task-ci s'il tournait comme fournisseur -- déjà
        verrouillé par un client, en train de traiter une requête, ou
        simplement en attente -- provoquant une RuntimeError explicite
        côté client (Api2Api introuvable) et une désynchronisation
        totale du fournisseur qui continue pourtant de tourner. Le
        namespace, lui, est unique PAR TASK/PAR EXÉCUTION (cf. self.
        _namespaces_tasks côté TaskConfigScreen, self._namespace neuf par
        instance côté MoteurExecutionTaskHeadless) -- indexer dessus
        garantit qu'on ne désenregistre que le bon fournisseur, jamais un
        autre Task partageant la même connexion."""
        entree_existante = _ID_API2API_ENREGISTRE_PAR_NAMESPACE.get(id(namespace_api2api))
        id_api2api = entree_existante[1] if entree_existante is not None else None
        if id_api2api is None:
            resultat = client_serveur_t.api2api_enregistrer_bloquant()
            if not resultat.get("ok", False):
                raise RuntimeError(f"attendre_requete() : échec d'enregistrement comme Task Api2Api -- {resultat.get('erreur', 'erreur inconnue')}")
            id_api2api = resultat["id_api2api"]
            _ID_API2API_ENREGISTRE_PAR_NAMESPACE[id(namespace_api2api)] = (client_serveur_t, id_api2api)
        resultat = client_serveur_t.api2api_attendre_requete_bloquant(id_api2api, timeout_s)
        if not resultat.get("ok", False):
            raise RuntimeError(f"attendre_requete() : {resultat.get('erreur', 'erreur inconnue')}")
        donnees = _decoder_fichiers_api2api(resultat.get("donnees", []))
        requete = RequeteApi2Api(client_serveur_t, resultat["requete_id"], donnees)
        # BUGFIX (retour utilisateur : "je veux qu'une erreur soit
        # retransmise, pas que la Task cliente tourne indéfiniment") --
        # mémorise CETTE requête comme "en cours de traitement" pour ce
        # namespace, AVANT de la renvoyer au script utilisateur, afin que
        # _repondre_echec_si_besoin puisse la retrouver et lui envoyer un
        # échec explicite si le script plante avant d'appeler req.repondre()
        # lui-même (cf. docstring de _DERNIERE_REQUETE_EN_COURS_PAR_NAMESPACE
        # et de _repondre_echec_si_besoin pour le mécanisme complet).
        _DERNIERE_REQUETE_EN_COURS_PAR_NAMESPACE[id(namespace_api2api)] = requete
        return requete

    def reinitialiser_registre_api2api() -> int:
        """OUTIL DE DÉVELOPPEMENT (retour utilisateur explicite : "j'ai
        besoin d'une commande spéciale qui va réinitialiser le registre,
        mettre tout le monde à free" -> précisé : "vider complètement" ->
        "appelable dans mon notebook TaskScript editor") -- exposée au
        script Task sous ce même nom, à côté de Api2Api/attendre_requete :

            reinitialiser_registre_api2api()

        VIDE ENTIÈREMENT le registre Api2Api du serveurT (cf.
        _api2api_reset_admin côté serveur.py) : TOUS les Task Api2Api
        actuellement enregistrés sur le réseau -- pas seulement ceux de
        CE client/CE script -- disparaissent d'un coup, même s'ils sont
        actuellement verrouillés par un autre client en train de
        traiter une requête. Chaque fournisseur devra RELANCER son Task
        pour se ré-enregistrer (exactement comme après un redémarrage du
        serveurT). Réservé au développement -- casse tout Api2Api en
        cours pour tout le monde sur le réseau, aucune vérification de
        permission côté serveur (cf. sa docstring).

        Bloque jusqu'à l'ack du serveurT (aller-retour réseau simple).
        Renvoie le nombre de Task Api2Api qui étaient enregistrés juste
        avant le vidage. Lève RuntimeError en cas d'échec réseau (pas de
        notion d'échec applicatif ici -- contrairement à Api2Api()/
        .request(), cette opération ne peut pas "échouer" côté serveur
        une fois reçue, seul un problème de connexion peut empêcher son
        exécution)."""
        resultat = client_serveur_t.api2api_reset_admin_bloquant()
        if not resultat.get("ok", False):
            raise RuntimeError(f"reinitialiser_registre_api2api() : {resultat.get('erreur', 'erreur inconnue')}")
        return resultat.get("nombre_retires", 0)

    def regenerer_navigateur(nom_profil: str, id_executant: str, garder_donnees: bool = False,
                             relancer: bool = True, timeout_s: float = 180.0) -> dict:
        """Exposée au notebook / script Task sous ce nom :

            res = regenerer_navigateur("iaX2", "sAutoniax-1")
            nouvel_instance_id = res["instance_id"]

        Remplace le navigateur du profil `nom_profil` sur le sAutoniax
        `id_executant` : nouvelle empreinte, MÊME proxy/IP et même nom de
        profil. Par défaut les cookies/données de navigation sont supprimés
        (garder_donnees=True pour les conserver) et le profil est relancé
        (relancer=False : le nouveau navigateur n'est créé qu'au prochain
        démarrage). L'ancien instance_id n'est plus valide ensuite : utiliser
        res["instance_id"]. BLOQUE jusqu'au résultat réel (par défaut 180 s).
        Retourne {"ok": True, "message", "instance_id"} ; lève RuntimeError en
        cas d'échec (profil actif dans un projet, profil Chrome standard,
        sAutoniax déconnecté, délai dépassé...).
        Doit être appelée depuis un notebook lancé côté pilote (la demande
        passe par le serveurT avec le rôle pilote)."""
        resultat = client_serveur_t.regenerer_profil_bloquant(
            id_executant, nom_profil, bool(garder_donnees), bool(relancer), float(timeout_s),
        )
        if not resultat.get("ok", False):
            raise RuntimeError(f"regenerer_navigateur('{nom_profil}') : {resultat.get('message') or 'erreur inconnue'}")
        return resultat

    namespace_api2api = {
        "Api2Api": Api2Api,
        "attendre_requete": attendre_requete,
        "reinitialiser_registre_api2api": reinitialiser_registre_api2api,
        "regenerer_navigateur": regenerer_navigateur,
    }
    return namespace_api2api


# {id(namespace_du_task): (ClientServeurT, id_api2api)} -- mémorise, PAR
# NAMESPACE de script (id(dict) unique et stable par Task/par exécution,
# cf. docstring de attendre_requete pour la raison de ce choix plutôt que
# id(client_serveur_t)), l'id_api2api déjà enregistré par un appel
# précédent à attendre_requete() pour CE Task précis, pour ne s'enregistrer
# qu'UNE SEULE FOIS même si le script utilisateur appelle attendre_requete()
# en boucle (cf. sa docstring). client_serveur_t est également mémorisé ICI
# (pas seulement passé en paramètre à la désinscription) pour que
# _desenregistrer_api2api_si_besoin puisse retrouver le bon client sans
# dépendre de ce que l'appelant lui passe -- élimine tout risque de
# mismatch si jamais un futur appelant se trompait de client_serveur_t.
# Clé = id(objet) plutôt que l'objet lui-même : un dict n'est pas hashable,
# et il n'y a de toute façon jamais qu'une poignée de namespaces vivants à
# la fois par process -- pas de risque de collision d'id() pratique ici.
_ID_API2API_ENREGISTRE_PAR_NAMESPACE: dict = {}

# {id(namespace_du_task): RequeteApi2Api} -- mémorise, PAR NAMESPACE de
# script (même clé que _ID_API2API_ENREGISTRE_PAR_NAMESPACE ci-dessus,
# même raison de choix), la DERNIÈRE RequeteApi2Api reçue par attendre_
# requete() et pas encore répondue -- cf. BUGFIX "réponse d'échec
# automatique" : _repondre_echec_si_besoin (appelée par MoteurExecution
# TaskHeadless._thread_execution après une exception non gérée dans le
# script) l'utilise pour savoir QUELLE requête, le cas échéant, doit
# recevoir un échec explicite au nom du fournisseur qui vient de
# planter au milieu de son traitement -- sans ça, le CLIENT appelant
# (Api2ApiTask.request(), cf. Api2Api.request) resterait bloqué jusqu'à
# SON PROPRE timeout (par défaut 120s, cf. Api2Api._TIMEOUT_REQUETE_S_
# DEFAUT) sans jamais savoir que le fournisseur a échoué, au lieu d'une
# RuntimeError immédiate et explicite. Retirée (pop) dès que attendre_
# requete() est rappelée pour la requête SUIVANTE (une seule requête
# "en cours" à la fois par namespace, cohérent avec le patron d'usage
# attendu : while True: req = attendre_requete(); ...; req.repondre(...)).
_DERNIERE_REQUETE_EN_COURS_PAR_NAMESPACE: dict = {}


def _repondre_echec_si_besoin(namespace: Optional[dict], message_erreur: str) -> None:
    """BUGFIX (retour utilisateur : "je veux qu'une erreur soit
    retransmise, pas que la Task cliente tourne indéfiniment") -- appelée
    depuis MoteurExecutionTaskHeadless._thread_execution/MoteurExecution
    Cellule._thread_execution (cf. leurs call sites) juste après qu'une
    exception non gérée a fait planter le script utilisateur. Si CE
    namespace précis avait une RequeteApi2Api en cours de traitement
    (cf. _DERNIERE_REQUETE_EN_COURS_PAR_NAMESPACE, posée par attendre_
    requete()) et pas encore répondue (cf. RequeteApi2Api._repondue,
    jamais mise à True si le script a planté avant d'appeler
    req.repondre() dans son propre code), lui envoie un échec explicite
    {"ok": False, "erreur": message_erreur} -- le CLIENT bloqué sur
    Api2Api.request() reçoit alors immédiatement une RuntimeError claire
    au lieu d'attendre son propre timeout en silence.

    Idempotente et sans effet si aucune requête n'était en cours pour ce
    namespace (Task qui n'utilise pas Api2Api du tout, ou crash survenu
    hors de la boucle attendre_requete()/repondre()) -- ne fait alors
    rien plutôt que de lever. Fire-and-forget par construction (cf.
    RequeteApi2Api._repondre_echec, qui absorbe elle-même toute exception
    réseau) : appelée depuis un contexte de nettoyage post-crash, où une
    nouvelle exception ici n'aurait aucun bénéfice."""
    if namespace is None:
        return
    requete = _DERNIERE_REQUETE_EN_COURS_PAR_NAMESPACE.pop(id(namespace), None)
    if requete is None or requete._repondue:
        return
    log_cellule.warning(
        f"_repondre_echec_si_besoin() : envoi d'un échec Api2Api automatique "
        f"(le script fournisseur a planté avant d'appeler req.repondre()) -- {message_erreur}"
    )
    requete._repondre_echec(message_erreur)


def _desenregistrer_api2api_si_besoin(namespace: Optional[dict]) -> None:
    """BUGFIX -- avant ce correctif, arrêter un Task fournisseur Api2Api
    depuis l'UI (bouton "Tout arrêter" du Task Script Editor, ou bouton
    "Arrêter" d'une ligne dans la sidebar Api2Api) ne signalait RIEN au
    serveurT : MoteurExecutionCellule.arreter()/MoteurExecutionTaskHeadless.
    arreter() détachent l'UI et abandonnent le thread Python en arrière-
    plan (cf. leurs docstrings respectives -- limite connue, assumée,
    aucun moyen sûr de tuer un threading.Thread), mais le websocket, lui,
    reste ouvert (rien ne le ferme) : le serveurT continuait donc de
    considérer ce Task comme enregistré/potentiellement verrouillé pour
    toujours, jusqu'à fermeture complète de l'application -- un futur
    appelant pouvait alors rester verrouillé sur un fournisseur mort dont
    le thread abandonné ne lira plus jamais attendre_requete().

    BUGFIX 2 (paramètre `namespace` au lieu de `client_serveur_t`) -- cf.
    docstring de attendre_requete/_ID_API2API_ENREGISTRE_PAR_NAMESPACE :
    l'ancienne signature (client_serveur_t) désenregistrait N'IMPORTE
    QUEL Task fournisseur partageant la même connexion, même sans rapport
    avec le Task qu'on vient réellement d'arrêter -- corrigé en indexant
    par le namespace propre au Task/à l'exécution qu'on arrête VRAIMENT.
    Chaque site d'appel passe désormais son propre namespace (cf. call
    sites : self._namespaces_tasks[task.id] côté TaskConfigScreen, self.
    _namespace côté MoteurExecutionTaskHeadless) plutôt que le client
    réseau partagé.

    Fonction centralisée (appelée depuis TOUS les points d'arrêt UI d'un
    Task, cf. call sites) plutôt que dupliquée à chaque site, pour ne pas
    risquer d'en oublier un. Fire-and-forget, idempotente par construction
    (le .pop() garantit qu'un second appel -- ex. arrêt individuel PUIS
    fermeture de l'app -- ne réenvoie rien) : cohérent avec le principe
    "best effort, jamais bloquant" déjà en place partout ailleurs dans ce
    fichier pour les chemins d'arrêt (cf. MoteurExecutionCellule.arreter).
    Si ce message se perd (déconnexion simultanée, etc.), le nettoyage à
    la déconnexion côté serveurT (cf. serveur.py, finally de
    route_websocket) rattrapera de toute façon la situation le jour où ce
    websocket finira par se fermer pour de bon."""
    if namespace is None:
        return
    entree = _ID_API2API_ENREGISTRE_PAR_NAMESPACE.pop(id(namespace), None)
    if entree is None:
        return  # rien n'était enregistré pour ce Task précis -- rien à faire
    client_serveur_t, id_api2api = entree
    log_cellule.info(f"_desenregistrer_api2api_si_besoin() : désenregistrement de '{id_api2api}' (Task Api2Api arrêté depuis l'UI)")
    client_serveur_t.api2api_desenregistrer(id_api2api)


def charger_templates_bgr(composant: "Composant", dossier_racine: Optional[Path] = None) -> list:
    """Charge toutes les variantes d'image d'un Composant en templates BGR
    -- factorise le pattern déjà utilisé par TestComposantScreen._on_composant_changed.
    Une variante dont le fichier est introuvable ou illisible est ignorée
    silencieusement plutôt que de lever, pour ne pas faire planter tout le
    script utilisateur sur une seule image manquante -- le composant sera
    simplement plus difficile/impossible à détecter si TOUTES ses variantes
    manquent (visible() renverra False, cohérent avec "pas trouvé").

    PATCH (SPEC_GLOBALE_AutoniaX.md, Partie A §3.1 -- demande explicite
    utilisateur : paramètres de détection relatifs à CHAQUE variante) :
    retourne désormais une liste de tuples (image_bgr, variante: Variante)
    au lieu de juste list[image_bgr] -- le tuple permet à
    rechercher_composant_multi_variantes de lire les réglages propres à
    CHAQUE variante (seuil_confiance, flou_noyau, etc.) plutôt que des
    paramètres uniques partagés par tout le composant.

    CORRECTIF (BUG RÉEL -- retour explicite utilisateur, "le resultat de
    test est toujours false" alors que le dossier service API est bien
    synchronisé avec la bonne casse) : composant.variantes contient des
    chemins RELATIFS (ex. "components/NouveauServiceAPI/Nom.png"),
    historiquement toujours résolus ici via get_app_data_dir() -- correct
    en mode LOCAL (pilote), où les images vivent sous get_app_data_dir()/
    "components"/... (cf. Composant.variantes/get_components_dir). MAIS en
    mode RÉSEAU (sAutoniax), les images sont extraites sous
    get_service_api_dir()/"components"/... (cf. synchroniser_service_api_
    dir/App/service_api.zip) -- un dossier PHYSIQUEMENT SÉPARÉ côté
    sAutoniax lui aussi (get_app_data_dir() y pointe vers .../projet, qui
    n'a jamais de sous-dossier "components" rempli, cf. _chemin_donnees).
    Résultat : côté sAutoniax, chaque image existait bien sur disque, mais
    au mauvais chemin absolu -- get_app_data_dir()/variant_path ne
    correspondait jamais à un fichier réel, donc templates_bgr était
    TOUJOURS vide, donc _detecter() retournait TOUJOURS None ("aucune
    variante chargée"), quelle que soit la synchronisation de casse déjà
    corrigée par ailleurs. dossier_racine (nouveau paramètre optionnel)
    permet à l'appelant réseau (cf. ComposantExecutable._detecter) de
    fournir explicitement get_service_api_dir() -- None (défaut) conserve
    le comportement historique get_app_data_dir(), donc AUCUN changement
    pour le mode local (CoordonneeActionScreen/TestComposantScreen, seuls
    autres appelants, tous en mode pilote/local)."""
    templates = []
    if not VISION_DISPONIBLE:
        return templates
    racine = dossier_racine if dossier_racine is not None else get_app_data_dir()
    for variante in composant.variantes:
        chemin = variante.chemin if isinstance(variante, Variante) else str(variante)
        image_absolue = racine / chemin
        if not image_absolue.exists():
            continue
        image = QImage(str(image_absolue))
        if image.isNull():
            continue
        # Filet de sécurité : un projet pas encore migré (composant.
        # variantes contenant encore des str brutes -- ne devrait plus
        # arriver après ComposantSingle.from_dict, mais robustesse
        # défensive) construit une Variante à la volée avec les défauts
        # de la classe.
        v = variante if isinstance(variante, Variante) else Variante(chemin=str(variante))
        templates.append((qimage_vers_bgr(image), v))
    return templates


def _normaliser_zone(zone) -> Optional["ZoneClicRect"]:
    """Normalise le paramètre zone accepté par ComposantExecutable
    (click/mousemove/.../drag) et point_clic_composant. Accepte :
      - None -> None (pas d'override)
      - un ZoneClicRect -> renvoyé tel quel
      - un tuple/list (x, y, largeur, hauteur) -> converti en ZoneClicRect,
        même ordre que celui affiché par le tracé de rectangle
        (CoordonneeActionScreen), ex: (-4, -67, 447, 40)
    Toute autre valeur lève TypeError immédiatement (plutôt qu'un
    AttributeError confus plus loin sur .est_vide())."""
    if zone is None:
        return None
    if isinstance(zone, ZoneClicRect):
        return zone
    if isinstance(zone, (tuple, list)) and len(zone) == 4:
        x, y, largeur, hauteur = zone
        return ZoneClicRect(x=x, y=y, largeur=largeur, hauteur=hauteur)
    raise TypeError(
        f"zone doit être un ZoneClicRect, un tuple/list (x, y, largeur, hauteur) ou None -- reçu {type(zone).__name__}: {zone!r}"
    )


def point_ecran_depuis_cible(cible, nom: str = "cible") -> tuple:
    """Résout un point ÉCRAN absolu : un tuple (x, y), ou une zone absolue
    (ZoneClicRect / (x, y, largeur, hauteur)) dans laquelle un point est tiré
    au hasard. Utilisé par Instance.glisser_souris(depart, arrivee)."""
    if isinstance(cible, (tuple, list)) and len(cible) == 2:
        return int(cible[0]), int(cible[1])
    zone = _normaliser_zone(cible)
    if zone is None or zone.est_vide():
        raise ValueError(f"glisser_souris : « {nom} » doit être un point (x, y) ou une zone (x, y, largeur, hauteur)")
    return (int(zone.x) + random.randint(0, max(1, int(zone.largeur)) - 1),
            int(zone.y) + random.randint(0, max(1, int(zone.hauteur)) - 1))


def point_clic_composant(resultat: dict, composant: "Composant", zone_override: Optional["ZoneLike"] = None) -> tuple:
    """Point de clic pour un Composant détecté, HORS contexte d'Action (cf.
    tirer_point_aleatoire_zone, qui elle a besoin d'une Action -- absente
    ici, ComposantExecutable.click() n'est rattaché à aucune Action de
    Project.bibliotheque_actions). Priorité à zone_override si fourni et
    non vide (zone relative ponctuelle passée par le script Task -- accepte
    un ZoneClicRect OU un tuple (x, y, largeur, hauteur), cf.
    _normaliser_zone -- n'altère jamais composant.zone_clic_rect, effet
    limité à cet appel). Sinon, utilise zone_clic_rect du Composant
    lui-même si zone_clic_mode == "personnalise", sinon un point aléatoire
    dans toute la surface détectée -- même logique que la branche
    "composant" de tirer_point_aleatoire_zone, simplement sans la branche
    "action" (inapplicable ici)."""
    echelle = resultat["echelle"]
    zone_override = _normaliser_zone(zone_override)
    if zone_override is not None and not zone_override.est_vide():
        zone = zone_override
        largeur = max(1, round(zone.largeur * echelle))
        hauteur = max(1, round(zone.hauteur * echelle))
        origine_x = resultat["x"] + round(zone.x * echelle)
        origine_y = resultat["y"] + round(zone.y * echelle)
        _branche_zone_diag = "zone_override"
    elif composant.zone_clic_mode == "personnalise" and not composant.zone_clic_rect.est_vide():
        zone = composant.zone_clic_rect
        largeur = max(1, round(zone.largeur * echelle))
        hauteur = max(1, round(zone.hauteur * echelle))
        origine_x = resultat["x"] + round(zone.x * echelle)
        origine_y = resultat["y"] + round(zone.y * echelle)
        _branche_zone_diag = "personnalise"
    else:
        largeur = max(1, resultat["largeur"])
        hauteur = max(1, resultat["hauteur"])
        origine_x = resultat["x"]
        origine_y = resultat["y"]
        _branche_zone_diag = "toute_surface"
    cx = origine_x + random.randint(0, largeur - 1)
    cy = origine_y + random.randint(0, hauteur - 1)
    # DIAG_ZONE_CLIC (demande explicite utilisateur : "jaurasi beoin que
    # tu mets des logs de diagnostique pour voir reelement si les clic
    # sont dans la zonne personnaliser") -- log temporaire de diagnostic,
    # à retirer/repasser en debug une fois le comportement confirmé.
    # Tag DIAG_ZONE_CLIC recherchable directement via le champ "Filtrer
    # par motif" de l'écran Paramètres (section COPIER TOUS LES LOGS).
    # Trace la branche empruntée (zone_override/personnalise/
    # toute_surface -- confirme laquelle des 3 a réellement été prise),
    # la zone_clic_rect brute du composant (relative, AVANT mise à
    # l'échelle -- ce que l'utilisateur a réglé visuellement), la
    # position/échelle de la détection (resultat), et le rectangle final
    # en coordonnées ÉCRAN RÉELLES (origine_x/y + largeur/hauteur) dans
    # lequel cx/cy est tiré -- permet de vérifier d'un coup d'œil que ce
    # rectangle correspond bien à la zone personnalisée attendue, et pas
    # à toute la surface du composant.
    log_detection.info(
        f"[DIAG_ZONE_CLIC][{composant.nom}] branche={_branche_zone_diag!r} "
        f"zone_clic_mode={composant.zone_clic_mode!r} "
        f"zone_clic_rect(brute)={composant.zone_clic_rect!r} "
        f"detection: x={resultat['x']} y={resultat['y']} "
        f"largeur={resultat['largeur']} hauteur={resultat['hauteur']} echelle={echelle} "
        f"-- rect_final_ecran: origine=({origine_x},{origine_y}) taille=({largeur}x{hauteur}) "
        f"-- point_clic_tire=({cx},{cy})"
    )
    return cx, cy


