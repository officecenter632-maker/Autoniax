        dashboard_screen.projets_batch_screen.demande_ouvrir_attribution_profils.connect(
            self._ouvrir_rendu_task_reseau
        )
        # Chaque ProjetBatch du batch crée sa propre ligne dans la table
        # "Projets Distribués" au moment où son envoi démarre réellement
        # (cf. docstring du signal) -- même méthode sur_envoi_demande que
        # l'envoi mono-projet, avec en plus l'id_batch_distribue transmis
