        self.bouton_choisir_racine.clicked.connect(self._choisir_dossier_racine)
        ligne_racine.addWidget(self.bouton_choisir_racine)

        # PATCH (demande utilisateur explicite : "dans la zone des
        # boutons met aussi copier le path du projet") -- copie le
        # dossier racine (racine_edit.text(), même valeur que celle
        # choisie via _choisir_dossier_racine ou saisie manuellement)
        # dans le presse-papier SYSTÈME. Même pattern que
        # TaskScriptEditor._copier_sortie (icône "check" verte 1.2s en
        # feedback, puis retour à l'icône normale) -- pas de dialogue
        # bloquant, juste une confirmation visuelle brève.
        self.bouton_copier_racine = QToolButton(bloc)
