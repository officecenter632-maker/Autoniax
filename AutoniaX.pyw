#     (3) filtre par onglet uniquement -> iframes cross-origin (OOPIF),
#         workers, service workers, popups : AUCUNE couverture. Un service
#         worker qui préchargeait des médias continuait de consommer de la
#         data alors que le bouton était vert ;
#     (4) filtrage par extension d'URL seulement -> tout média servi par un
#         CDN derrière une URL opaque (/media?id=123) passait ;
#     (5) aucun contrôle du cache/preload ;
#     (6) aucune couverture des médias déguisés (Content-Type média sur une
#         URL sans extension).
#   Et surtout : AUCUNE mesure des octets réellement reçus, donc aucun moyen
#   de savoir que ça ne marchait pas (SPEC §12, dernier point).
#
# NOUVELLE ARCHITECTURE (SPEC §2, défense en couches) :
#
#   Couche 1  -- Fetch.requestPaused, étape Request : classification complète
#                (§4) puis Fetch.failRequest(BlockedByClient). Aucun octet de
#                corps n'est demandé.
#   Couche 1b -- Network.setBlockedURLs en renfort (l'ancien mécanisme, qui
#                reste utile et gratuit, mais n'est plus JAMAIS seul).
#   Couche 2  -- Fetch.requestPaused, étape Response : Content-Type /
#                Content-Length. Filet pour les médias déguisés.
#   Couche 3  -- Page.addScriptToEvaluateOnNewDocument(runImmediately) :
#                neutralise les API qui déclenchent un téléchargement
#                (HTMLMediaElement.load/play, img.src/srcset, createObjectURL,
#                MediaSource, link rel=preload média, data: > N octets,
#                blob: -- ces deux derniers n'atteignant JAMAIS le réseau,
#                ils ne peuvent être traités QUE par cette couche).
#
#   Couverture de TOUS les contextes (SPEC §3) : Target.setAutoAttach(
#   flatten=True, waitForDebuggerOnStart=True) au niveau navigateur ET
#   récursivement sur chaque session -> pages, OOPIF, popups, nouveaux
#   onglets, dedicated/shared workers, service workers. Chaque cible est
#   SUSPENDUE à sa création, équipée, PUIS reprise
#   (Runtime.runIfWaitingForDebugger) : plus aucune requête ne peut partir
#   avant le filtre (SPEC §3.2, la cause n°1 du bug).
#
#   Un SEUL propriétaire du filtre (SPEC §5.4) : cette classe. Plus aucun
#   autre point du fichier n'appelle Fetch/Network.setBlockedURLs de son
#   côté -- les anciennes fonctions sont conservées comme FAÇADES qui
#   délèguent au gardien (compatibilité des appels existants).
#
# POURQUOI UN WEBSOCKET CDP DÉDIÉ (et pas les objets nodriver) :
#   nodriver ouvre UN websocket PAR onglet et n'expose pas les sessions
#   « plates » (sessionId). Or tout ce qui précède -- auto-attach récursif,
#   OOPIF, workers, suspension à la création -- EXIGE des sessions plates.
#   Le gardien ouvre donc sa propre connexion au endpoint navigateur. CDP
#   accepte plusieurs clients simultanés : nodriver continue de piloter les
#   onglets normalement, sans interférence.
# ===========================================================================

# --- §4 : tables de classification ----------------------------------------
# Extensions reprises TELLES QUELLES de la SPEC §4.3 (ne pas « simplifier » :
# chaque entrée correspond à un vecteur de fuite constaté).
_GM_EXT_IMAGE = frozenset("""
    jpg jpeg jpe jfif png gif webp avif apng bmp ico cur heic heif tif tiff
    jxl svg
""".split())
_GM_EXT_VIDEO = frozenset("mp4 m4v webm mkv mov avi ogv 3gp 3g2 flv wmv".split())
_GM_EXT_AUDIO = frozenset("mp3 ogg oga opus wav aac m4a flac weba mid midi wma".split())
_GM_EXT_STREAM = frozenset("m3u8 mpd ts m4s cmfv cmfa m4f".split())
_GM_EXT_FONT = frozenset("woff woff2 ttf otf eot".split())

# §4.2 -- Sec-Fetch-Dest qui désignent sans ambiguïté un média.
_GM_DEST_MEDIA = frozenset({"image", "video", "audio", "track"})
# "object"/"embed" : média SEULEMENT si l'URL le confirme (cf. §4.2, « si
# média ») -- un <object> peut aussi porter un PDF ou une applet.
_GM_DEST_MEDIA_SI_URL = frozenset({"object", "embed"})

# §4.1 -- types de ressource moteur (CDP Fetch/Network ResourceType).
_GM_TYPES_MEDIA = frozenset({"Image", "Media"})
# Types sur lesquels la décision se prend par URL/en-têtes et JAMAIS par le
# type seul (§2.1 dernier point, §4.8 première ligne) : un XHR de données
# JSON ne doit pas être bloqué parce qu'un site l'aurait mal typé.
_GM_TYPES_AMBIGUS = frozenset({"Other", "XHR", "Fetch", "Prefetch", "Preload"})

# §4.6 -- Content-Type de réponse (couche 2).
_GM_MIME_MANIFESTES = frozenset({
    "application/vnd.apple.mpegurl",
    "application/x-mpegurl",
    "audio/x-mpegurl",
    "audio/mpegurl",
    "application/dash+xml",
})

# Jamais bloqué, quoi qu'il arrive (§1.2) : le document principal. Bloquer une
# navigation transformerait le filtre en « plus d'internet », pas en « pas de
# médias ».
_GM_TYPES_JAMAIS_BLOQUES = frozenset({"Document", "Manifest", "CSPViolationReport", "Ping"})

# Estimation d'octets évités quand la taille réelle est inconnue (couche 1 :
# la réponse n'est jamais demandée, donc Content-Length n'existe pas).
# Valeurs volontairement conservatrices -- `blocked_bytes_saved_est` est une
# ESTIMATION et le journal le dit (§9.1). La seule métrique dure reste
# `media_bytes_leaked`.
_GM_TAILLE_ESTIMEE_PAR_CATEGORIE = {
    "image": 120 * 1024,
    "video": 2 * 1024 * 1024,
    "audio": 400 * 1024,
    "stream": 1200 * 1024,
    "font": 60 * 1024,
}

# ---------------------------------------------------------------------------
# §6 : configuration
# ---------------------------------------------------------------------------
NOM_FICHIER_CONFIG_BLOCAGE_MEDIA = "media_block.config.json"
NOM_FICHIER_ETAT_BLOCAGE_MEDIA = "block_media.json"

# Valeurs par défaut EXACTEMENT celles de la SPEC §6, plus quelques clés
# propres à cette implémentation (suffixe explicite dans le commentaire).
CONFIG_BLOCAGE_MEDIA_PAR_DEFAUT = {
    "enabled": False,               # repli si aucun toggle profil lisible
    "block_images": True,
    "block_video": True,
    "block_audio": True,
    "block_streaming_manifests": True,
    "block_fonts": False,
    "block_favicons": True,
    "block_svg": True,
    "data_uri_max_bytes": 2048,
    "allow_domains": [],
    "allow_urls_regex": [],
    "block_urls_regex": [],
    "kill_active_streams_on_enable": True,
    "reload_on_enable": False,
    "reload_on_disable": False,
    "fail_closed": True,
    "poll_interval_ms": 500,
    "log_level": "INFO",
    # --- clés propres à cette implémentation (hors SPEC §6, documentées
    # dans README_blocage_medias.md) ---
    "wait_for_debugger_on_start": True,   # §3.2 -- suspendre chaque cible
    "disable_cache_when_active": True,    # §7, 1re ligne
    "bypass_service_worker": True,        # §7, ligne service worker
    # §3.1 / §7 : arrête les service workers en cours quand le blocage
    # s'active. Chromium ne suspend PAS les cibles service_worker à leur
    # création (waitForDebuggerOnStart est sans effet sur elles, mesuré) :
    # un SW démarre donc toujours quelques millisecondes avant son filtre.
    # Les arrêter réduit cette fenêtre au strict minimum. Désactiver si une
    # application hors-ligne doit continuer à fonctionner pendant le blocage.
    "stop_service_workers": True,
    "inject_page_layer": True,            # couche 3 (§2.4)
    "css_reinforcement": False,           # §7 « renfort visuel » seulement
    "equip_timeout_s": 3.0,               # §8 -- timeout par opération CDP
    "equip_max_retries": 2,
    # Durée MAXIMALE pendant laquelle une cible non protégeable reste
    # suspendue (fail closed §3.4). Au-delà, elle est reprise avec la
    # protection qu'on a pu poser, et l'incident est journalisé en WARN.
    # Une suspension non bornée fige le navigateur : mesuré au selftest, un
    # service worker jamais repris bloque à vie le navigator.serviceWorker.
    # register() de la page, donc la page entière.
    "fail_closed_max_suspend_s": 2.0,
    # Apprentissage : toute URL prise en flagrant délit par la couche 2
    # (Content-Type média) est mémorisée, et ses requêtes SUIVANTES sont
    # refusées dès l'émission (couche 1, zéro octet). Indispensable pour les
    # segments HLS/DASH et les CDN à URL opaque, qui rejouent la même route
    # des dizaines de fois.
    "apprentissage_urls_media": True,
    # Refuse dès l'émission tout fetch/XHR SANS extension et dont l'Accept ne
    # nomme aucun type. Amène les médias déguisés à ZÉRO octet dès la
    # PREMIÈRE requête, mais peut casser une API qui renvoie des données
    # binaires légitimes. Désactivé par défaut, conformément à la décision
    # de la SPEC §4.8 (« Autoriser, la couche 2 rattrape »).
    "block_ambiguous_fetch": False,
    "stats_interval_s": 10.0,             # §9.2 -- résumé INFO
    "launch_flags_when_active": True,     # §2.4 -- flags de lancement
}


def _gm_chemin_config(chemin_profil):
    """Emplacement de media_block.config.json : dossier du profil s'il est
    connu (un réglage par profil a du sens : un profil « scraping » bloque,
    un profil « vidéo » non), sinon dossier de données de l'app."""
    try:
        if chemin_profil:
            dossier = Path(chemin_profil)
            if dossier.is_dir():
                return dossier / NOM_FICHIER_CONFIG_BLOCAGE_MEDIA
    except Exception:
        pass
    try:
        return get_app_data_dir() / NOM_FICHIER_CONFIG_BLOCAGE_MEDIA
    except Exception:
        return Path(NOM_FICHIER_CONFIG_BLOCAGE_MEDIA)


class ConfigBlocageMedia:
    """Config §6, rechargée à chaud. Toute erreur de parsing = on garde
    l'ancienne config et on journalise (SPEC §6, dernière règle) -- JAMAIS
    de retour silencieux aux valeurs par défaut, qui débloquerait tout sur
    une simple faute de frappe dans le JSON."""

    def __init__(self, chemin):
        self.chemin = Path(chemin)
        self.valeurs = dict(CONFIG_BLOCAGE_MEDIA_PAR_DEFAUT)
        self._mtime = None
        self._regex_autorises = []
        self._regex_bloques = []
        self._domaines_autorises = ()
        self._derniere_erreur = None
        self.recharger(premier_chargement=True)

    # -- accès ------------------------------------------------------------
    def __getitem__(self, cle):
        return self.valeurs.get(cle, CONFIG_BLOCAGE_MEDIA_PAR_DEFAUT.get(cle))

    def get(self, cle, defaut=None):
        return self.valeurs.get(cle, CONFIG_BLOCAGE_MEDIA_PAR_DEFAUT.get(cle, defaut))

    # -- (re)chargement ---------------------------------------------------
    def recharger(self, premier_chargement=False) -> bool:
        """Retourne True si les valeurs ont changé. Ne lève jamais."""
        try:
            if not self.chemin.is_file():
                if premier_chargement:
                    self._ecrire_defaut()
                return False
            mtime = self.chemin.stat().st_mtime_ns
            if mtime == self._mtime:
                return False
            brut = json.loads(self.chemin.read_text(encoding="utf-8"))
            if not isinstance(brut, dict):
                raise ValueError("le fichier ne contient pas un objet JSON")
        except Exception as exc:  # noqa: BLE001 -- cf. docstring de classe
            message = repr(exc)
            if message != self._derniere_erreur:
                self._derniere_erreur = message
                log.warning(
                    f"[media_guard] {self.chemin} illisible ({message}) -- "
                    "configuration PRÉCÉDENTE conservée (aucun changement appliqué)."
                )
            return False
        self._derniere_erreur = None
        self._mtime = mtime
        anciennes = dict(self.valeurs)
        valeurs = dict(CONFIG_BLOCAGE_MEDIA_PAR_DEFAUT)
        for cle, valeur in brut.items():
            if cle not in CONFIG_BLOCAGE_MEDIA_PAR_DEFAUT:
                log.warning(f"[media_guard] clé de configuration inconnue ignorée : {cle!r}")
                continue
            valeurs[cle] = valeur
        self.valeurs = valeurs
        self._compiler_regles()
        if not premier_chargement and valeurs != anciennes:
            log.info(f"[media_guard] configuration rechargée depuis {self.chemin}")
        return valeurs != anciennes

    def _ecrire_defaut(self):
        try:
            self.chemin.parent.mkdir(parents=True, exist_ok=True)
            tmp = self.chemin.with_name(self.chemin.name + f".{os.getpid()}.tmp")
            tmp.write_text(
                json.dumps(CONFIG_BLOCAGE_MEDIA_PAR_DEFAUT, ensure_ascii=False, indent=2),
                encoding="utf-8",
            )
            os.replace(tmp, self.chemin)
            self._mtime = self.chemin.stat().st_mtime_ns
            log.info(f"[media_guard] configuration par défaut écrite : {self.chemin}")
        except Exception as exc:  # noqa: BLE001 -- best-effort
            log.warning(f"[media_guard] écriture de la config par défaut impossible : {exc!r}")

    def _compiler_regles(self):
        """Une regex invalide n'invalide QUE cette regex (journalisée), pas
        toute la liste : une faute de frappe dans allow_urls_regex ne doit
        pas faire tomber le filtre entier."""
        def compiler(nom, motifs):
            compiles = []
            for motif in (motifs or []):
                try:
                    compiles.append(re.compile(motif, re.IGNORECASE))
                except Exception as exc:  # noqa: BLE001
                    log.warning(f"[media_guard] {nom} : motif invalide ignoré {motif!r} ({exc!r})")
            return compiles

        self._regex_autorises = compiler("allow_urls_regex", self.get("allow_urls_regex"))
        self._regex_bloques = compiler("block_urls_regex", self.get("block_urls_regex"))
        domaines = []
        for domaine in (self.get("allow_domains") or []):
            try:
                domaines.append(str(domaine).strip().lower().lstrip("."))
            except Exception:  # noqa: BLE001
                continue
        self._domaines_autorises = tuple(d for d in domaines if d)

    # -- listes noires/blanches (§6, règles de priorité) -------------------
    def decision_liste(self, url: str):
        """Retourne "bloquer", "autoriser" ou None (aucune règle ne tranche).

        SPEC §6 : block_urls_regex PRIME sur allow_domains. allow_urls_regex
        est l'exception ciblée (captcha, logo interne) qui prime sur la
        classification, mais pas sur la liste noire explicite."""
        for motif in self._regex_bloques:
            if motif.search(url):
                return "bloquer"
        for motif in self._regex_autorises:
            if motif.search(url):
                return "autoriser"
        if self._domaines_autorises:
            hote = _gm_hote(url)
            if hote:
                for domaine in self._domaines_autorises:
                    if hote == domaine or hote.endswith("." + domaine):
                        return "autoriser"
        return None

    def categorie_active(self, categorie: str) -> bool:
        """Une catégorie désactivée dans la config n'est jamais bloquée."""
        if categorie == "image":
            return bool(self.get("block_images"))
        if categorie == "video":
            return bool(self.get("block_video"))
        if categorie == "audio":
            return bool(self.get("block_audio"))
        if categorie == "stream":
            return bool(self.get("block_streaming_manifests"))
        if categorie == "font":
            return bool(self.get("block_fonts"))
        return True


# ---------------------------------------------------------------------------
# §4 : classification -- UNE SEULE implémentation, partagée par le chemin CDP
# (Chrome/Vivaldi) et le chemin Playwright (Camoufox). Deux classifieurs
# distincts finiraient par diverger, exactement comme les deux listes de
# patterns de l'ancienne version.
# ---------------------------------------------------------------------------

def _gm_hote(url: str) -> str:
    try:
        return (urllib.parse.urlsplit(url).hostname or "").lower()
    except Exception:  # noqa: BLE001
        return ""


def _gm_extension(url: str) -> str:
    """Extension du CHEMIN, avant ? et #, en minuscules, sans le point
    (§4.3). Retourne "" si absente."""
    try:
        chemin = urllib.parse.urlsplit(url).path
    except Exception:  # noqa: BLE001
        chemin = url.split("?", 1)[0].split("#", 1)[0]
    nom = chemin.rsplit("/", 1)[-1]
    if "." not in nom:
        return ""
    return nom.rsplit(".", 1)[-1].lower()


def _gm_categorie_extension(ext: str):
    if not ext:
        return None
    if ext in _GM_EXT_IMAGE:
        return "image"
    if ext in _GM_EXT_VIDEO:
        return "video"
    if ext in _GM_EXT_AUDIO:
        return "audio"
    if ext in _GM_EXT_STREAM:
        return "stream"
    if ext in _GM_EXT_FONT:
        return "font"
    return None


def _gm_categorie_mime(content_type: str):
    """§4.6. Retourne (categorie, certain) -- `certain` est False pour
    application/octet-stream, qui exige une confirmation par l'extension ou
    la taille (§4.8, 2e ligne)."""
    if not content_type:
        return None, True
    ct = content_type.split(";", 1)[0].strip().lower()
    if not ct:
        return None, True
    if ct in _GM_MIME_MANIFESTES:
        return "stream", True
    if ct.startswith("image/"):
        return "image", True
    if ct.startswith("video/"):
        return "video", True
    if ct.startswith("audio/"):
        return "audio", True
    if ct.startswith("font/") or ct in ("application/font-woff", "application/vnd.ms-fontobject"):
        return "font", True
    if ct == "application/octet-stream":
        return None, False
    return None, True


def _gm_classer_requete(url, resource_type, entetes, config):
    """Décision d'ENVOI (couche 1, §4.1 à §4.5). Retourne
    (bloquer: bool, raison: str, categorie: str|None).

    Le OU logique de la SPEC est respecté : une seule condition vraie suffit.
    Les cas ambigus (§4.8) retombent sur « autoriser », la couche 2 rattrapant
    sur le Content-Type -- décision explicite de la SPEC pour ne pas casser
    les pages."""
    url = url or ""
    # Les schémas non réseau ne passent de toute façon pas par Fetch ; ce
    # garde-fou existe pour le chemin Playwright, qui, lui, voit data:.
    if url.startswith("data:"):
        return _gm_classer_data_uri(url, config)

    decision = config.decision_liste(url)
    if decision == "autoriser":
        return False, "liste blanche", None
    force_liste_noire = decision == "bloquer"

    resource_type = resource_type or ""
    if resource_type in _GM_TYPES_JAMAIS_BLOQUES and not force_liste_noire:
        # §1.2 : ne JAMAIS bloquer le document principal.
        return False, "document", None

    ext = _gm_extension(url)
    categorie = _gm_categorie_extension(ext)

    entetes = entetes or {}
    dest = str(entetes.get("sec-fetch-dest", "")).lower()
    accept = str(entetes.get("accept", "")).lower()
    a_range = bool(entetes.get("range"))

    if force_liste_noire:
        return True, "block_urls_regex", categorie or "image"

    # §4.1 -- type moteur
    if resource_type == "Image":
        categorie = categorie or "image"
        raison = "resourceType=Image"
    elif resource_type == "Media":
        categorie = categorie or "video"
        raison = "resourceType=Media"
    elif resource_type == "Font":
        categorie = categorie or "font"
        raison = "resourceType=Font"
    else:
        raison = None

    # §4.2 -- Sec-Fetch-Dest
    if raison is None and dest:
        if dest in _GM_DEST_MEDIA:
            categorie = categorie or ("image" if dest == "image" else ("audio" if dest == "audio" else "video"))
            raison = f"Sec-Fetch-Dest={dest}"
        elif dest in _GM_DEST_MEDIA_SI_URL and categorie is not None:
            raison = f"Sec-Fetch-Dest={dest}+extension"
        elif dest == "font" and categorie is None:
            categorie = "font"
            raison = "Sec-Fetch-Dest=font"

    # §4.3 -- extension d'URL (couvre les types ambigus : Other/XHR/Fetch,
    # typiquement un préchargement JS d'image ou un segment HLS demandé en
    # fetch()).
    if raison is None and categorie is not None:
        raison = f"extension .{ext}"

    # §4.5 -- en-têtes de requête
    if raison is None and accept:
        premier = accept.split(",", 1)[0].strip()
        if premier.startswith(("image/", "video/", "audio/")):
            categorie = categorie or premier.split("/", 1)[0]
            raison = f"Accept={premier}"
    if raison is None and a_range and categorie is not None:
        raison = "Range sur URL média"

    if raison is None:
        # §4.8 -- inconnu : on laisse passer, la couche 2 rattrape.
        return False, "non classé (couche 2 prendra le relais)", None

    # Favicons : catégorie image, mais réglage dédié (§6 block_favicons).
    if categorie == "image" and not config.get("block_favicons"):
        if ext in ("ico", "cur") or "favicon" in url.lower() or dest == "image" and "/favicon" in url.lower():
            return False, "favicon autorisé (block_favicons=false)", "image"
    if ext == "svg" and not config.get("block_svg"):
        return False, "svg autorisé (block_svg=false)", "image"
    if not config.categorie_active(categorie or "image"):
        return False, f"catégorie {categorie} désactivée dans la config", categorie

    return True, raison, categorie


def _gm_cle_url(url: str) -> str:
    """Clé d'apprentissage : schéma + hôte + chemin, SANS la query. Un CDN
    qui sert /media?id=1, /media?id=2, ... n'expose qu'une seule route ; la
    mémoriser une fois suffit pour toutes les suivantes."""
    try:
        parties = urllib.parse.urlsplit(url)
        if not parties.scheme.startswith("http"):
            return ""
        return f"{parties.scheme}://{parties.netloc}{parties.path}"
    except Exception:  # noqa: BLE001
        return ""


def _gm_requete_ambigue(url, resource_type, entetes) -> bool:
    """Mode strict (block_ambiguous_fetch) : fetch/XHR sans extension et
    sans Accept explicite. Le cas §4.8 que la SPEC choisit d'autoriser --
    exposé en option pour qui veut l'économie absolue plutôt que la
    compatibilité maximale."""
    if (resource_type or "") not in _GM_TYPES_AMBIGUS:
        return False
    if _gm_categorie_extension(_gm_extension(url)) is not None:
        return False
    if _gm_extension(url):
        return False
    accept = str((entetes or {}).get("accept", "")).strip().lower()
    return accept in ("", "*/*")


def _gm_classer_data_uri(url: str, config):
    """§4.4 -- data:image/... de plus de data_uri_max_bytes octets. Les
    petits data: (icônes) passent pour ne pas casser les pages."""
    entete = url[5:60].lower()
    if not entete.startswith(("image/", "video/", "audio/")):
        return False, "data: non média", None
    seuil = int(config.get("data_uri_max_bytes") or 0)
    if seuil and len(url) <= seuil:
        return False, f"data: court (<= {seuil} o)", None
    categorie = entete.split("/", 1)[0]
    if not config.categorie_active(categorie):
        return False, f"catégorie {categorie} désactivée", categorie
    return True, f"data: média ({len(url)} o)", categorie


def _gm_classer_reponse(url, content_type, content_length, resource_type, config):
    """Décision de RÉPONSE (couche 2, §4.6 et §4.8). Les en-têtes sont déjà
    reçus (quelques centaines d'octets) mais le CORPS n'a pas été lu : c'est
    le filet, pas la protection principale (§2.3)."""
    decision = config.decision_liste(url or "")
    if decision == "autoriser":
        return False, "liste blanche", None
    if (resource_type or "") in _GM_TYPES_JAMAIS_BLOQUES and decision != "bloquer":
        return False, "document", None

    categorie, certain = _gm_categorie_mime(content_type or "")
    if categorie is not None and certain:
        if not config.categorie_active(categorie):
            return False, f"catégorie {categorie} désactivée", categorie
        ext = _gm_extension(url or "")
        if ext == "svg" and not config.get("block_svg"):
            return False, "svg autorisé", "image"
        if categorie == "image" and not config.get("block_favicons") and ext in ("ico", "cur"):
            return False, "favicon autorisé", "image"
        return True, f"Content-Type={content_type}", categorie

    if categorie is None and not certain:
        # application/octet-stream (§4.8) : bloquer si extension média, ou si
        # la taille annoncée dépasse 100 Ko (seuil de la SPEC).
        ext = _gm_extension(url or "")
        cat_ext = _gm_categorie_extension(ext)
        if cat_ext is not None and config.categorie_active(cat_ext):
            return True, f"octet-stream + .{ext}", cat_ext
        try:
            taille = int(content_length or 0)
        except (TypeError, ValueError):
            taille = 0
        if taille > 100 * 1024 and cat_ext is not None:
            return True, f"octet-stream {taille} o", cat_ext
    return False, "réponse non média", None


# ---------------------------------------------------------------------------
# §2.4 : couche 3 -- script injecté dans CHAQUE document, avant tout script
# de la page (runImmediately=True).
#
# Le drapeau window.__AUTONIAX_MEDIA_BLOCK__ est relu À CHAQUE APPEL des
# hooks (pas capturé à l'injection) : une désactivation du bouton rend donc
# leur comportement natif AUX PAGES DÉJÀ CHARGÉES, sans rechargement
# (SPEC §5.2, « le passage à DÉSACTIVÉ ne recharge pas les pages »).
# ---------------------------------------------------------------------------
_GM_SCRIPT_COUCHE_PAGE = r"""
(function () {
  var CLE = "__AUTONIAX_MEDIA_BLOCK__";
  if (window.__AUTONIAX_MEDIA_HOOKS__) { window[CLE] = %ACTIF%; return; }
  window.__AUTONIAX_MEDIA_HOOKS__ = true;
  window[CLE] = %ACTIF%;
  var MAX_DATA = %MAX_DATA%;
  var PIXEL = "data:image/gif;base64,R0lGODlhAQABAIAAAAAAAP///yH5BAEAAAAALAAAAAABAAEAAAIBRAA7";
  var actif = function () { return !!window[CLE]; };

  var EXT = /\.(jpg|jpeg|jpe|jfif|png|gif|webp|avif|apng|bmp|ico|cur|heic|heif|tif|tiff|jxl|svg|mp4|m4v|webm|mkv|mov|avi|ogv|3gp|3g2|flv|wmv|mp3|ogg|oga|opus|wav|aac|m4a|flac|weba|m3u8|mpd|ts|m4s|cmfv|cmfa|m4f)(\?|#|$)/i;
  var estMedia = function (v) {
    if (typeof v !== "string" || !v) { return false; }
    if (v.lastIndexOf("data:", 0) === 0) {
      return /^data:(image|video|audio)\//i.test(v) && v.length > MAX_DATA;
    }
    if (v.lastIndexOf("blob:", 0) === 0) { return true; }
    return EXT.test(v);
  };

  var remplacer = function (proto, prop, filtre) {
    try {
      var d = Object.getOwnPropertyDescriptor(proto, prop);
      if (!d || !d.set) { return; }
      Object.defineProperty(proto, prop, {
        configurable: true, enumerable: d.enumerable,
        get: function () { return d.get ? d.get.call(this) : ""; },
        set: function (v) {
          if (actif() && filtre(v)) { return d.set.call(this, filtre === estMedia ? PIXEL : ""); }
          return d.set.call(this, v);
        }
      });
    } catch (e) {}
  };

  // <img src/srcset>, <source src/srcset>, <video poster/src>, <audio src>
  if (window.HTMLImageElement) {
    remplacer(HTMLImageElement.prototype, "src", estMedia);
    remplacer(HTMLImageElement.prototype, "srcset", function () { return true; });
  }
  if (window.HTMLSourceElement) {
    remplacer(HTMLSourceElement.prototype, "src", function () { return true; });
    remplacer(HTMLSourceElement.prototype, "srcset", function () { return true; });
  }
  if (window.HTMLMediaElement) {
    remplacer(HTMLMediaElement.prototype, "src", function () { return true; });
    try {
      var pl = HTMLMediaElement.prototype.load, pp = HTMLMediaElement.prototype.play;
      HTMLMediaElement.prototype.load = function () { if (actif()) { return; } return pl.apply(this, arguments); };
      HTMLMediaElement.prototype.play = function () {
        if (actif()) { try { this.pause(); } catch (e) {} return Promise.resolve(); }
        return pp.apply(this, arguments);
      };
      var dpre = Object.getOwnPropertyDescriptor(HTMLMediaElement.prototype, "preload");
      if (dpre) {
        Object.defineProperty(HTMLMediaElement.prototype, "preload", {
          configurable: true,
          get: function () { return actif() ? "none" : dpre.get.call(this); },
          set: function (v) { return dpre.set.call(this, actif() ? "none" : v); }
        });
      }
    } catch (e) {}
  }
  if (window.HTMLVideoElement) { remplacer(HTMLVideoElement.prototype, "poster", estMedia); }

  // setAttribute : chemin parallèle aux propriétés ci-dessus.
  try {
    var sa = Element.prototype.setAttribute;
    Element.prototype.setAttribute = function (nom, valeur) {
      if (actif() && typeof nom === "string") {
        var n = nom.toLowerCase();
        if ((n === "src" || n === "srcset" || n === "poster" || n === "data-src" || n === "data-srcset")
            && estMedia(valeur)) {
          var t = (this.tagName || "").toUpperCase();
          if (t === "IMG" || t === "VIDEO" || t === "AUDIO" || t === "SOURCE" || t === "TRACK") {
            return sa.call(this, nom, n === "poster" || t === "IMG" ? PIXEL : "");
          }
        }
        if (n === "rel" && (this.tagName || "").toUpperCase() === "LINK"
            && /preload|prefetch|preconnect|dns-prefetch|icon/i.test(String(valeur))) {
          var as = (this.getAttribute("as") || "").toLowerCase();
          if (as === "image" || as === "video" || as === "audio" || /icon/i.test(String(valeur))) { return; }
        }
      }
      return sa.apply(this, arguments);
    };
  } catch (e) {}

  // blob: de média -- jamais filtrable par URL côté réseau (§4.4).
  try {
    var cou = URL.createObjectURL;
    URL.createObjectURL = function (obj) {
      if (actif() && obj && typeof obj.type === "string" && /^(image|video|audio)\//i.test(obj.type)) {
        return PIXEL;
      }
      return cou.apply(this, arguments);
    };
  } catch (e) {}

  // MSE : les segments arrivent par XHR/fetch puis sont poussés ici.
  try {
    if (window.SourceBuffer) {
      var ab = SourceBuffer.prototype.appendBuffer;
      SourceBuffer.prototype.appendBuffer = function () { if (actif()) { return; } return ab.apply(this, arguments); };
    }
  } catch (e) {}

  // <link rel=preload as=image|video|audio> et favicons déjà dans le HTML.
  var nettoyerLiens = function () {
    if (!actif()) { return; }
    try {
      var liens = document.querySelectorAll("link[rel]");
      for (var i = 0; i < liens.length; i++) {
        var l = liens[i];
        var rel = (l.getAttribute("rel") || "").toLowerCase();
        var as = (l.getAttribute("as") || "").toLowerCase();
        if ((rel.indexOf("preload") >= 0 || rel.indexOf("prefetch") >= 0)
            && (as === "image" || as === "video" || as === "audio")) { l.parentNode && l.parentNode.removeChild(l); }
        else if (rel.indexOf("icon") >= 0 && %BLOQUER_FAVICON%) { l.parentNode && l.parentNode.removeChild(l); }
      }
    } catch (e) {}
  };
  try {
    var mo = new MutationObserver(nettoyerLiens);
    mo.observe(document.documentElement || document, { childList: true, subtree: true });
  } catch (e) {}
  document.addEventListener("DOMContentLoaded", nettoyerLiens);
  nettoyerLiens();

  if (%CSS_RENFORT%) {
    try {
      var st = document.createElement("style");
      st.textContent = "img,video,audio{visibility:hidden !important}*{background-image:none !important}";
      (document.head || document.documentElement).appendChild(st);
    } catch (e) {}
  }
})();
"""

# Arrêt des flux déjà en cours au passage à ACTIVÉ (§5.2, dernière puce).
_GM_SCRIPT_ARRET_FLUX = r"""
(function () {
  window.__AUTONIAX_MEDIA_BLOCK__ = true;
  var n = 0;
  try {
    var m = document.querySelectorAll("video,audio");
    for (var i = 0; i < m.length; i++) {
      try { m[i].pause(); m[i].removeAttribute("src");
            var s = m[i].querySelectorAll("source");
            for (var j = 0; j < s.length; j++) { s[j].removeAttribute("src"); }
            m[i].load(); n++; } catch (e) {}
    }
  } catch (e) {}
  return n;
})();
"""

_GM_SCRIPT_NEUTRALISER = "window.__AUTONIAX_MEDIA_BLOCK__ = false;"


def _gm_construire_script_page(actif: bool, config) -> str:
    return (
        _GM_SCRIPT_COUCHE_PAGE
        .replace("%ACTIF%", "true" if actif else "false")
        .replace("%MAX_DATA%", str(int(config.get("data_uri_max_bytes") or 0)))
        .replace("%BLOQUER_FAVICON%", "true" if config.get("block_favicons") else "false")
        .replace("%CSS_RENFORT%", "true" if config.get("css_reinforcement") else "false")
    )


# ---------------------------------------------------------------------------
# §2.4 : flags de lancement.
#
# DÉCISION EXPLICITE -- `--blink-settings=imagesEnabled=false` et
# `profile.default_content_setting_values.images=2` (suggérés par la SPEC)
# ne sont PAS utilisés : ils ne sont pas révocables sans redémarrage, ce qui
# CONTREDIT l'exigence produit « révocable à tout moment même si le profil a
# déjà démarré » (le bouton passerait à OFF et les images resteraient
# bloquées jusqu'au prochain lancement). La couche 3 par injection CDP donne
# le même effet et, elle, se révoque à chaud.
# Ne restent donc que les flags SANS effet visible en mode DÉSACTIVÉ.
# ---------------------------------------------------------------------------
FLAGS_LANCEMENT_BLOCAGE_MEDIA = [
    "--autoplay-policy=user-gesture-required",
    "--disable-background-networking",
    "--disable-features=PreloadMediaEngagementData,MediaEngagementBypassAutoplayPolicies,NetworkPrediction",
]


def _gm_flags_lancement(nom_profil, chemin_profil):
    """Flags §2.4 ajoutés UNIQUEMENT si le toggle du profil est déjà ON au
    lancement. Jamais de flag qui casserait l'état DÉSACTIVÉ."""
    try:
        if not _lire_toggle_bloquer_media_profil(nom_profil):
            return []
        config = ConfigBlocageMedia(_gm_chemin_config(chemin_profil))
        if not config.get("launch_flags_when_active"):
            return []
        return list(FLAGS_LANCEMENT_BLOCAGE_MEDIA)
    except Exception as exc:  # noqa: BLE001 -- best-effort
        log.warning(f"[media_guard] flags de lancement non appliqués ({exc!r})")
        return []


# ---------------------------------------------------------------------------
# §5.3 : état persistant, écrit ATOMIQUEMENT (tmp + os.replace).
# ---------------------------------------------------------------------------

def _gm_chemin_etat(chemin_profil):
    try:
        if chemin_profil and Path(chemin_profil).is_dir():
            return Path(chemin_profil) / NOM_FICHIER_ETAT_BLOCAGE_MEDIA
    except Exception:  # noqa: BLE001
        pass
    try:
        return get_app_data_dir() / NOM_FICHIER_ETAT_BLOCAGE_MEDIA
    except Exception:  # noqa: BLE001
        return Path(NOM_FICHIER_ETAT_BLOCAGE_MEDIA)


def _gm_lire_etat_persiste(chemin):
    """Retourne (actif: bool|None, mtime_ns: int|None). None = illisible ou
    absent -- l'appelant décide alors (§5.3 : dernier état connu, sinon
    DÉSACTIVÉ)."""
    try:
        chemin = Path(chemin)
        if not chemin.is_file():
            return None, None
        mtime = chemin.stat().st_mtime_ns
        donnees = json.loads(chemin.read_text(encoding="utf-8"))
        if isinstance(donnees, dict) and isinstance(donnees.get("actif"), bool):
            return bool(donnees["actif"]), mtime
        log.warning(f"[media_guard] état persistant corrompu ({chemin}) -- ignoré.")
        return None, mtime
    except Exception as exc:  # noqa: BLE001
        log.warning(f"[media_guard] état persistant illisible ({chemin}) : {exc!r}")
        return None, None


def _gm_ecrire_etat_persiste(chemin, actif: bool) -> bool:
    chemin_tmp = None
    try:
        chemin = Path(chemin)
        chemin.parent.mkdir(parents=True, exist_ok=True)
        chemin_tmp = chemin.with_name(chemin.name + f".{os.getpid()}.tmp")
        chemin_tmp.write_text(
            json.dumps({"actif": bool(actif), "horodatage": datetime.now().isoformat(timespec="seconds")}),
            encoding="utf-8",
        )
        os.replace(chemin_tmp, chemin)
        return True
    except Exception as exc:  # noqa: BLE001 -- best-effort
        log.warning(f"[media_guard] écriture de l'état persistant impossible : {exc!r}")
        if chemin_tmp is not None:
            try:
                Path(chemin_tmp).unlink(missing_ok=True)
            except OSError:
                pass
        return False


# ---------------------------------------------------------------------------
# Client CDP brut (sessions plates).
# ---------------------------------------------------------------------------

async def _gm_ouvrir_websocket(url: str):
    """websockets a changé d'API entre les versions majeures et nodriver
    tire l'une ou l'autre selon l'installation -- on essaie les deux plutôt
    que d'imposer une version."""
    if websockets is None:
        raise RuntimeError("le module websockets est absent : le gardien média ne peut pas démarrer")
    erreurs = []
    try:
        from websockets.asyncio.client import connect as connect_moderne
        return await connect_moderne(url, max_size=None, ping_interval=None, close_timeout=2)
    except ImportError as exc:
        erreurs.append(repr(exc))
    except Exception as exc:  # noqa: BLE001 -- on retente l'API héritée
        erreurs.append(repr(exc))
    try:
        return await websockets.connect(url, max_size=None, ping_interval=None, close_timeout=2)
    except Exception as exc:  # noqa: BLE001
        erreurs.append(repr(exc))
    raise RuntimeError(f"connexion CDP impossible sur {url} : {' | '.join(erreurs)}")


def _gm_url_websocket_navigateur(browser):
    """Endpoint CDP AU NIVEAU NAVIGATEUR (et non par onglet) : seul niveau
    depuis lequel Target.setAutoAttach voit les nouveaux onglets, popups et
    service workers. Plusieurs attributs possibles selon la version de
    nodriver, d'où les essais successifs."""
    candidats = [
        getattr(browser, "websocket_url", None),
        getattr(getattr(browser, "connection", None), "websocket_url", None),
        getattr(getattr(browser, "info", None), "webSocketDebuggerUrl", None),
    ]
    for url in candidats:
        if isinstance(url, str) and url.startswith("ws") and "/devtools/browser/" in url:
            return url
    for url in candidats:
        if isinstance(url, str) and url.startswith("ws"):
            return url
    config = getattr(browser, "config", None)
    hote = getattr(config, "host", None)
    port = getattr(config, "port", None)
    if hote and port:
        try:
            with urllib.request.urlopen(f"http://{hote}:{port}/json/version", timeout=3) as reponse:
                infos = json.loads(reponse.read().decode("utf-8"))
            url = infos.get("webSocketDebuggerUrl")
            if url:
                return url
        except Exception as exc:  # noqa: BLE001
            raise RuntimeError(f"endpoint CDP navigateur introuvable via http://{hote}:{port}/json/version : {exc!r}")
    raise RuntimeError("endpoint CDP navigateur introuvable sur l'objet browser")


class _GMSession:
    """Une session CDP plate (un sessionId) = une cible équipée."""

    __slots__ = ("session_id", "target_id", "type_", "url", "equipee", "fetch_actif",
                 "fetch_supporte", "protegee", "sw_traite", "script_id", "erreurs", "cree_le")

    def __init__(self, session_id, target_id, type_, url):
        self.session_id = session_id
        self.target_id = target_id
        self.type_ = type_
        self.url = url
        self.equipee = False
        self.fetch_actif = False
        # Faux dès qu'on a constaté que le domaine Fetch n'existe pas sur ce
        # type de cible (cas réel : les dedicated workers de Chromium 141
        # répondent « 'Fetch.enable' wasn't found »). Sans ce drapeau, le
        # watchdog voyait une cible « sans filtre » à chaque tour et
        # relançait l'équipement indéfiniment -- boucle constatée au
        # selftest (12 avertissements par seconde).
        self.fetch_supporte = True
        # Vrai dès qu'AU MOINS une couche réseau est posée (Fetch ou 1b).
        self.protegee = False
        self.sw_traite = False
        self.script_id = None
        self.erreurs = []
        self.cree_le = time.monotonic()


class GardienMediaCDP:
    """Propriétaire UNIQUE du filtre média pour une instance Chrome/Vivaldi
    (SPEC §5.4). Expose set_state / get_state / stats.

    Cycle de vie : demarrer() -> (boucles de fond) -> arreter().
    Aucune exception ne remonte à l'appelant : un gardien en panne se
    journalise en WARN et se reconnecte, il ne fait jamais tomber
    l'instance."""

    def __init__(self, browser, etat_navigateur, instance_id="", chemin_profil=None):
        self.browser = browser
        self.etat_navigateur = etat_navigateur or {}
        self.instance_id = instance_id or ""
        self.nom_profil = self.etat_navigateur.get("nom_profil")
        self.chemin_profil = chemin_profil
        self.config = ConfigBlocageMedia(_gm_chemin_config(chemin_profil))
        self.chemin_etat = _gm_chemin_etat(chemin_profil)

        self._ws = None
        self._prochain_id = 1
        self._attentes = {}
        self._sessions = {}           # sessionId -> _GMSession
        self._cibles_attachees = set()  # targetId déjà attachés par NOUS
        self._verrou_envoi = asyncio.Lock()
        self._taches = []
        self._arret = asyncio.Event()
        self._pret = asyncio.Event()
        self._verrou_etat = asyncio.Lock()

        # état voulu
        self.actif = False
        self._forcage_explicite = False
        self._mtime_etat = None

        # suivi des réponses pour la mesure de fuite (§9.1) -- borné.
        self._requetes_media = {}
        self._ordre_requetes = collections.deque(maxlen=4000)

        self.compteurs = {
            "requests_total": 0,
            "blocked_l1": 0,
            "blocked_l2": 0,
            "blocked_bytes_saved_est": 0,
            "media_bytes_leaked": 0,
            "targets_equipped": 0,
            "targets_total": 0,
            "late_equip_count": 0,
            "equip_failures": 0,
            "reconnexions": 0,
            "basculements": 0,
            "latence_bascule_max_ms": 0,
        }
        self._par_categorie = collections.Counter()
        self._fuites_signalees = set()
        self._erreurs_cdp_vues = set()
        # URLs démasquées par la couche 2 (cf. apprentissage_urls_media).
        # Cibles CRÉÉES pendant que le gardien surveillait -- les seules
        # pour lesquelles un équipement tardif est un défaut. Les cibles
        # déjà ouvertes quand le gardien démarre ne peuvent PAS avoir été
        # suspendues à leur naissance : les compter en late_equip
        # masquerait le vrai indicateur derrière un bruit permanent.
        self._cibles_nees_sous_surveillance = set()
        # Cibles déjà ouvertes quand le gardien s'est connecté. Nécessaire
        # parce que Target.setDiscoverTargets rejoue un Target.targetCreated
        # pour CHAQUE cible existante : sans cette liste, tout onglet déjà
        # ouvert était compté comme « équipement tardif », et le compteur
        # que la SPEC §10.4 exige à 0 ne pouvait structurellement jamais
        # valoir 0.
        self._cibles_preexistantes = set()
        self._urls_media_apprises = {}
        self._ordre_urls_apprises = collections.deque(maxlen=2000)

    # === API publique (§5.4) ==============================================

    async def demarrer(self):
        """Connexion CDP + lecture de l'état AVANT la reprise de la première
        cible (§5.3) + lancement des boucles."""
        etat_persiste, self._mtime_etat = _gm_lire_etat_persiste(self.chemin_etat)
        toggle = _lire_toggle_bloquer_media_profil(self.nom_profil)
        if toggle is not None:
            self.actif = bool(toggle)
        elif etat_persiste is not None:
            self.actif = etat_persiste
            log.info("[media_guard] toggle du profil illisible -- reprise du dernier état connu "
                     f"({'ACTIVÉ' if self.actif else 'désactivé'}, SPEC §5.3).")
        else:
            self.actif = bool(self.config.get("enabled"))
        # ORDRE CRITIQUE (bug trouvé à l'exécution du selftest, pas à la
        # relecture) : _configurer() envoie des commandes CDP et ATTEND
        # leurs réponses. Ces réponses ne peuvent arriver que si quelqu'un
        # lit déjà la socket. Démarrer la boucle de réception après la
        # configuration produisait donc un interblocage parfait : le gardien
        # attendait une réponse que personne n'allait jamais lire, et
        # mourait au timeout de 3 s -- c'est-à-dire, en production, une
        # instance entière SANS filtre. La boucle de réception démarre donc
        # AVANT toute commande, ici et à chaque reconnexion.
        await self._connecter()
        self._taches = [
            asyncio.create_task(self._boucle_reception(), name="media_guard_rx"),
            asyncio.create_task(self._boucle_surveillance(), name="media_guard_watchdog"),
            asyncio.create_task(self._boucle_resume(), name="media_guard_stats"),
        ]
        await self._configurer()
        log.info(
            f"[media_guard] Instance '{self.instance_id}' : gardien démarré "
            f"(profil {self.nom_profil!r}, état initial "
            f"{'ACTIVÉ' if self.actif else 'désactivé'}, config {self.config.chemin})"
        )

    async def arreter(self):
        """Arrêt propre : on RELÂCHE d'abord toute cible suspendue, sinon
        l'utilisateur hériterait d'onglets figés (SPEC §3.2 -- la suspension
        n'a de sens que tant que le gardien vit)."""
        self._arret.set()
        try:
            await self._envoyer("Target.setAutoAttach",
                                {"autoAttach": False, "waitForDebuggerOnStart": False, "flatten": True},
                                timeout=1.0)
        except Exception:  # noqa: BLE001 -- on ferme, tout échec est sans conséquence
            pass
        for session in list(self._sessions.values()):
            try:
                await self._envoyer("Runtime.runIfWaitingForDebugger", {},
                                    session_id=session.session_id, timeout=1.0)
            except Exception:  # noqa: BLE001
                pass
        for tache in self._taches:
            tache.cancel()
        for tache in self._taches:
            try:
                await tache
            except (asyncio.CancelledError, Exception):  # noqa: BLE001
                pass
        if self._ws is not None:
            try:
                await self._ws.close()
            except Exception:  # noqa: BLE001
                pass
        log.info(f"[media_guard] Instance '{self.instance_id}' : gardien arrêté. {self._resume_compteurs()}")

    async def set_state(self, actif: bool, source: str = "toggle") -> None:
        """Idempotent (§5.4). Applique l'état sur TOUTES les sessions en
        ≤ 1 s (§5.2) et mesure la latence réelle."""
        actif = bool(actif)
        async with self._verrou_etat:
            if actif == self.actif and self._pret.is_set():
                return
            debut = time.monotonic()
            self.actif = actif
            _gm_ecrire_etat_persiste(self.chemin_etat, actif)
            try:
                self._mtime_etat = Path(self.chemin_etat).stat().st_mtime_ns
            except Exception:  # noqa: BLE001
                self._mtime_etat = None
            # Les FUTURES cibles doivent être suspendues dès leur création.
            await self._appliquer_auto_attach()
            annulees = await self._appliquer_a_toutes_les_sessions()
            latence_ms = int((time.monotonic() - debut) * 1000)
            self.compteurs["basculements"] += 1
            self.compteurs["latence_bascule_max_ms"] = max(
                self.compteurs["latence_bascule_max_ms"], latence_ms
            )
            self._pret.set()
            log.info(
                f"[media_guard] toggle -> {'ACTIVÉ' if actif else 'DÉSACTIVÉ'} "
                f"| source={source} | cibles={self.compteurs['targets_total']} "
                f"équipées={self.compteurs['targets_equipped']} "
                f"| flux_arrêtés={annulees} | latence={latence_ms} ms"
            )
            if latence_ms > 1000:
                log.warning(f"[media_guard] latence de bascule {latence_ms} ms > 1000 ms (SPEC §5.2)")

    def get_state(self) -> dict:
        """État VOULU et état RÉEL par cible (§5.4)."""
        return {
            "voulu": self.actif,
            "forcage_explicite": self._forcage_explicite,
            "profil": self.nom_profil,
            "connecte": self._ws is not None,
            "cibles": [
                {
                    "target_id": s.target_id,
                    "type": s.type_,
                    "url": (s.url or "")[:120],
                    "equipee": s.equipee,
                    "fetch": s.fetch_actif,
                    "erreurs": list(s.erreurs),
                }
                for s in self._sessions.values()
            ],
        }

    def stats(self) -> dict:
        """Compteurs §9.1."""
        donnees = dict(self.compteurs)
        donnees["par_categorie"] = dict(self._par_categorie)
        donnees["actif"] = self.actif
        return donnees

    async def forcer_explicite(self, actif: bool) -> None:
        """Règle de priorité n°1 conservée depuis l'ancien code : un
        naviguer(..., bloquer_media=True) d'un Task prime sur le bouton et
        n'est jamais annulé par lui."""
        self._forcage_explicite = bool(actif)
        self.etat_navigateur["bloquer_media_explicite"] = bool(actif)
        if actif:
            await self.set_state(True, source="appel explicite du Task")

    # === connexion ========================================================

    async def _connecter(self):
        """Ouvre UNIQUEMENT la socket. Aucune commande CDP ici : elles
        exigent que la boucle de réception tourne déjà (cf. demarrer())."""
        url = _gm_url_websocket_navigateur(self.browser)
        self._ws = await _gm_ouvrir_websocket(url)
        self._sessions.clear()
        self._cibles_attachees.clear()
        self.compteurs["targets_equipped"] = 0

    async def _configurer(self):
        """Découverte + auto-attach + rattrapage des cibles déjà ouvertes.
        Appelée au démarrage ET après chaque reconnexion."""
        # Inventaire AVANT d'activer la découverte : tout ce qui existe déjà
        # ne pourra pas avoir été suspendu à sa naissance, et ne doit donc
        # pas polluer late_equip_count.
        try:
            inventaire = await self._envoyer("Target.getTargets", {})
            self._cibles_preexistantes = {
                t.get("targetId") for t in (inventaire or {}).get("targetInfos", []) if t.get("targetId")
            }
        except Exception as exc:  # noqa: BLE001
            log.debug(f"[media_guard] inventaire initial indisponible : {exc!r}")
            self._cibles_preexistantes = set()
        await self._envoyer("Target.setDiscoverTargets", {"discover": True})
        await self._appliquer_auto_attach()
        await self._attacher_cibles_existantes()
        self._pret.set()

    async def _appliquer_auto_attach(self):
        """§3.1/§3.2. waitForDebuggerOnStart UNIQUEMENT quand le blocage est
        actif : suspendre chaque nouvelle cible alors qu'on ne bloque rien
        n'apporterait que de la latence."""
        attendre = bool(self.actif and self.config.get("wait_for_debugger_on_start") and not _PROCESSUS_FEATHER)  # Feather : jamais de pause des onglets
        params = {"autoAttach": True, "waitForDebuggerOnStart": attendre, "flatten": True}
        await self._envoyer("Target.setAutoAttach", params)
        for session in list(self._sessions.values()):
            try:
                await self._envoyer("Target.setAutoAttach", params, session_id=session.session_id)
            except Exception as exc:  # noqa: BLE001 -- une session morte ne bloque pas les autres
                log.debug(f"[media_guard] auto-attach récursif impossible sur {session.target_id} : {exc!r}")

    async def _attacher_cibles_existantes(self):
        """Les onglets DÉJÀ ouverts au démarrage ne passent pas par
        Target.attachedToTarget : il faut les attacher explicitement
        (§3.1, 1re ligne)."""
        try:
            reponse = await self._envoyer("Target.getTargets", {})
        except Exception as exc:  # noqa: BLE001
            log.warning(f"[media_guard] Target.getTargets a échoué ({exc!r}) -- cibles existantes non équipées.")
            return
        for infos in (reponse or {}).get("targetInfos", []):
            target_id = infos.get("targetId")
            type_ = infos.get("type")
            if not target_id or target_id in self._cibles_attachees:
                continue
            if type_ in ("browser",):
                continue
            try:
                await self._envoyer("Target.attachToTarget", {"targetId": target_id, "flatten": True})
                self._cibles_attachees.add(target_id)
            except Exception as exc:  # noqa: BLE001
                # Jamais silencieux (SPEC §3.4 / §12) : une cible non
                # attachable est une cible non protégée, elle doit se voir.
                self.compteurs["equip_failures"] += 1
                log.warning(f"[media_guard] cible {type_} {target_id} non attachable : {exc!r} "
                            f"-- URL {str(infos.get('url'))[:120]!r}")

    # === envoi / réception ================================================

    async def _envoyer(self, methode, params=None, session_id=None, timeout=None):
        """Appel CDP avec timeout (§8 : un timeout compte comme échec)."""
        if self._ws is None:
            raise RuntimeError("websocket CDP non connecté")
        if timeout is None:
            timeout = float(self.config.get("equip_timeout_s") or 3.0)
        identifiant = self._prochain_id
        self._prochain_id += 1
        message = {"id": identifiant, "method": methode, "params": params or {}}
        if session_id:
            message["sessionId"] = session_id
        future = asyncio.get_event_loop().create_future()
        self._attentes[identifiant] = future
        try:
            async with self._verrou_envoi:
                await self._ws.send(json.dumps(message))
            return await asyncio.wait_for(future, timeout=timeout)
        except asyncio.TimeoutError as exc:
            raise TimeoutError(f"{methode} n'a pas répondu en {timeout}s") from exc
        finally:
            self._attentes.pop(identifiant, None)

    async def _envoyer_sans_reponse(self, methode, params=None, session_id=None):
        """Chemin CHAUD (Fetch.failRequest / continueRequest) : on n'attend
        pas l'accusé de réception. Attendre multiplierait par deux le temps
        de traitement de chaque requête interceptée, sur une page qui en
        émet des centaines."""
        if self._ws is None:
            return
        identifiant = self._prochain_id
        self._prochain_id += 1
        message = {"id": identifiant, "method": methode, "params": params or {}}
        if session_id:
            message["sessionId"] = session_id
        try:
            async with self._verrou_envoi:
                await self._ws.send(json.dumps(message))
        except Exception as exc:  # noqa: BLE001 -- socket fermée : la boucle de réception gère la reconnexion
            log.debug(f"[media_guard] envoi {methode} impossible : {exc!r}")

    async def _boucle_reception(self):
        """Boucle unique de lecture + reconnexion à backoff plafonné (§8)."""
        backoff = 0.5
        while not self._arret.is_set():
            try:
                async for brut in self._ws:
                    backoff = 0.5
                    try:
                        message = json.loads(brut)
                    except Exception:  # noqa: BLE001 -- message non-JSON : rien à faire
                        continue
                    await self._traiter_message(message)
            except asyncio.CancelledError:
                raise
            except Exception as exc:  # noqa: BLE001
                if self._arret.is_set():
                    return
                log.warning(f"[media_guard] connexion CDP perdue ({exc!r}) -- reconnexion dans {backoff:.1f}s")
            if self._arret.is_set():
                return
            # FAIL CLOSED (§3.4) : tant que la connexion n'est pas rétablie,
            # AUCUN filtre n'existe. On le journalise en WARN plutôt que de
            # laisser croire que le blocage tient.
            if self.actif:
                log.warning("[media_guard] FAIL CLOSED : filtre inactif pendant la reconnexion "
                            "-- des médias peuvent passer jusqu'au rétablissement.")
            await asyncio.sleep(backoff)
            backoff = min(backoff * 2, 5.0)
            try:
                self._pret.clear()
                await self._connecter()
                # La boucle de réception, c'est NOUS : on est déjà en train
                # de tourner, donc _configurer() peut envoyer et attendre.
                await self._configurer()
                await self._appliquer_a_toutes_les_sessions()
                self.compteurs["reconnexions"] += 1
                log.info(f"[media_guard] reconnecté -- {self.compteurs['targets_equipped']} cible(s) réequipée(s).")
            except asyncio.CancelledError:
                raise
            except Exception as exc:  # noqa: BLE001
                log.warning(f"[media_guard] reconnexion échouée : {exc!r}")

    async def _traiter_message(self, message):
        identifiant = message.get("id")
        if identifiant is not None:
            future = self._attentes.get(identifiant)
            if future is not None and not future.done():
                if "error" in message:
                    future.set_exception(RuntimeError(str(message["error"])))
                else:
                    future.set_result(message.get("result") or {})
            return
        if "error" in message:
            # Réponse d'erreur à un envoi SANS attente (chemin chaud :
            # Fetch.failRequest / continueRequest / continueResponse). Sans
            # ce compteur, une commande refusée par Chrome disparaissait
            # sans laisser de trace -- et une requête jamais reprise fige la
            # page entière. Constaté au selftest.
            self.compteurs["cdp_errors"] = self.compteurs.get("cdp_errors", 0) + 1
            texte = str(message.get("error"))[:200]
            if texte not in self._erreurs_cdp_vues:
                self._erreurs_cdp_vues.add(texte)
                log.warning(f"[media_guard] erreur CDP non attribuée : {texte}")
            return
        methode = message.get("method")
        params = message.get("params") or {}
        session_id = message.get("sessionId")
        if methode == "Fetch.requestPaused":
            await self._sur_requete_pausee(params, session_id)
        elif methode == "Target.attachedToTarget":
            asyncio.create_task(self._sur_cible_attachee(params, session_id))
        elif methode == "Target.detachedFromTarget":
            self._sur_cible_detachee(params)
        elif methode == "Target.targetCreated":
            # AUCUN attachement manuel ici -- CORRECTION d'un bug mesuré au
            # selftest : Target.targetCreated précède Target.attachedToTarget.
            # Attacher nous-mêmes à ce moment créait une SECONDE session sur
            # la même cible, qui n'héritait pas de waitForDebuggerOnStart :
            # la page repartait avant d'être équipée et ses premières
            # requêtes (hero image, vidéo, CSS background) fuyaient -- très
            # exactement le bug d'origine, réintroduit par une autre porte.
            # L'auto-attach de niveau navigateur délivre déjà chaque cible,
            # y compris celles créées par un AUTRE client CDP (nodriver).
            infos = params.get("targetInfo") or {}
            if infos.get("type") not in ("browser", None):
                self.compteurs["targets_vus"] = self.compteurs.get("targets_vus", 0) + 1
                cible = infos.get("targetId")
                if cible and cible not in self._cibles_preexistantes:
                    if len(self._cibles_nees_sous_surveillance) > 500:
                        self._cibles_nees_sous_surveillance.clear()
                    self._cibles_nees_sous_surveillance.add(cible)
        elif methode == "Network.responseReceived":
            self._sur_reponse_recue(params, session_id)
        elif methode in ("Network.loadingFinished", "Network.dataReceived"):
            self._sur_donnees_recues(methode, params)

    # === équipement des cibles (§3.1, §3.2) ===============================

    async def _attacher_cible(self, infos):
        target_id = infos.get("targetId")
        if not target_id or target_id in self._cibles_attachees:
            return
        try:
            await self._envoyer("Target.attachToTarget", {"targetId": target_id, "flatten": True})
            self._cibles_attachees.add(target_id)
        except Exception as exc:  # noqa: BLE001
            self.compteurs["equip_failures"] += 1
            log.warning(f"[media_guard] attachement impossible sur {infos.get('type')} {target_id} : {exc!r}")

    async def _sur_cible_attachee(self, params, _session_parente):
        """SÉQUENCE OBLIGATOIRE §3.2 : la cible est suspendue -> on équipe ->
        on reprend. Jamais l'inverse."""
        session_id = params.get("sessionId")
        infos = params.get("targetInfo") or {}
        attend_debugger = bool(params.get("waitingForDebugger"))
        if not session_id:
            return
        session = _GMSession(session_id, infos.get("targetId"), infos.get("type"), infos.get("url"))
        self._sessions[session_id] = session
        self._cibles_attachees.add(session.target_id)
        self.compteurs["targets_total"] = len(self._sessions)

        succes = False
        essais = int(self.config.get("equip_max_retries") or 0) + 1
        for tentative in range(1, essais + 1):
            try:
                await self._equiper_filtre(session, attend_debugger=attend_debugger)
                succes = True
                break
            except asyncio.CancelledError:
                raise
            except Exception as exc:  # noqa: BLE001 -- §12 : jamais de `except: pass` ici
                session.erreurs.append(repr(exc))
                log.warning(
                    f"[media_guard] équipement de {session.type_} {session.target_id} "
                    f"(tentative {tentative}/{essais}) échoué : {exc!r} -- URL {str(session.url)[:120]!r}"
                )
                await asyncio.sleep(0.15)

        if not succes:
            self.compteurs["equip_failures"] += 1
            await self._replier_fail_closed(session)

        if attend_debugger:
            if not succes and self.actif and self.config.get("fail_closed"):
                # FAIL CLOSED BORNÉ (§3.4, tempéré par une mesure) : une
                # cible suspendue n'émet aucune requête -- c'est la
                # protection parfaite -- mais une suspension SANS LIMITE
                # fige le navigateur. Constaté au selftest : un service
                # worker jamais repris bloque à vie le
                # navigator.serviceWorker.register() de la page appelante,
                # donc tout le script de la page. On suspend donc le temps
                # de retenter, puis on reprend en journalisant l'incident.
                log.warning(
                    f"[media_guard] FAIL CLOSED : {session.type_} {session.target_id} suspendue "
                    f"({self.config.get('fail_closed_max_suspend_s')} s max) -- non protégeable."
                )
                asyncio.create_task(self._reprendre_apres_fail_closed(session))
            else:
                # SÉQUENCE §3.2 : filtre posé -> reprise IMMÉDIATE -> le
                # reste. Tout aller-retour CDP supplémentaire avant la
                # reprise rallonge le gel de la cible et, sur un service
                # worker, peut faire expirer la session elle-même.
                await self._reprendre_cible(session)
        if succes:
            asyncio.create_task(self._completer_equipement(session))
        if not attend_debugger and self.actif:
            # La cible tournait déjà quand on l'a attachée : ses premières
            # requêtes ont pu partir sans filtre.
            if session.target_id in self._cibles_nees_sous_surveillance:
                # Née sous notre surveillance et pourtant pas suspendue :
                # c'est un VRAI défaut de couverture (§9.1, doit valoir 0).
                self.compteurs["late_equip_count"] += 1
                log.warning(
                    f"[media_guard] ÉQUIPEMENT TARDIF : {session.type_} {session.target_id} "
                    f"a démarré avant son filtre -- {str(session.url)[:120]!r}"
                )
            else:
                # Déjà ouverte avant le démarrage du gardien : inévitable,
                # et sans rapport avec la qualité de la couverture.
                self.compteurs["targets_preexistantes"] = (
                    self.compteurs.get("targets_preexistantes", 0) + 1)
                log.debug(f"[media_guard] cible préexistante équipée : {session.type_} {session.target_id}")

    async def _completer_equipement(self, session):
        """Phase 2 en tâche de fond : ne retarde jamais la reprise."""
        try:
            await self._equiper_complement(session)
        except asyncio.CancelledError:
            raise
        except Exception as exc:  # noqa: BLE001 -- best-effort par construction
            log.debug(f"[media_guard] complément d'équipement sur {session.target_id} : {exc!r}")

    async def _reprendre_apres_fail_closed(self, session):
        """Dernière tentative d'équipement, puis reprise inconditionnelle."""
        await asyncio.sleep(max(0.1, float(self.config.get("fail_closed_max_suspend_s") or 2.0)))
        if session.session_id not in self._sessions:
            return
        try:
            await self._equiper_session(session)
            log.info(f"[media_guard] {session.type_} {session.target_id} finalement équipée -- reprise.")
        except Exception as exc:  # noqa: BLE001
            log.warning(
                f"[media_guard] {session.type_} {session.target_id} reprise SANS protection complète "
                f"({exc!r}) -- surveiller media_bytes_leaked pour cette cible."
            )
        await self._reprendre_cible(session)

    async def _reprendre_cible(self, session):
        try:
            await self._envoyer("Runtime.runIfWaitingForDebugger", {}, session_id=session.session_id)
        except Exception as exc:  # noqa: BLE001
            log.warning(f"[media_guard] reprise de {session.target_id} impossible : {exc!r}")

    async def _replier_fail_closed(self, session):
        """Dernier filet quand Fetch n'a pas pu être posé : on tente au moins
        l'ancien mécanisme (couche 1b). Dégradé et assumé comme tel, mais
        très supérieur à « rien »."""
        if not self.actif:
            return
        try:
            await self._envoyer("Network.enable", {}, session_id=session.session_id, timeout=1.5)
            await self._envoyer("Network.setBlockedURLs", {"urls": PATTERNS_MEDIA_LOURD_DEFAUT},
                                session_id=session.session_id, timeout=1.5)
            log.warning(f"[media_guard] cible {session.target_id} : repli couche 1b "
                        "(Network.setBlockedURLs seul -- protection DÉGRADÉE).")
        except Exception as exc:  # noqa: BLE001
            log.warning(f"[media_guard] cible {session.target_id} : aucun filtre posable ({exc!r}).")

    async def _equiper_session(self, session, attend_debugger=False):
        """Équipement COMPLET (cible déjà en cours d'exécution). Pour une
        cible suspendue, l'appelant utilise _equiper_filtre() puis reprend,
        puis _equiper_complement()."""
        await self._equiper_filtre(session, attend_debugger=attend_debugger)
        await self._equiper_complement(session, attend_debugger=attend_debugger)

    async def _equiper_filtre(self, session, attend_debugger=False):
        """PHASE 1 -- le strict nécessaire AVANT de reprendre une cible
        suspendue : le filtre réseau, et rien d'autre.

        POURQUOI CETTE SCISSION (mesuré, pas supposé) : sur une cible
        suspendue par waitForDebuggerOnStart, le domaine Network NE RÉPOND
        PAS -- Network.enable partait en timeout de 3 s, puis
        Network.setCacheDisabled encore 3 s. Sur un service worker, la
        session était détruite avant qu'on ait pu envoyer
        Runtime.runIfWaitingForDebugger : le worker n'était donc JAMAIS
        repris, et le navigator.serviceWorker.register() de la page
        n'aboutissait jamais -- toute la page restait figée. Fetch, lui,
        répond parfaitement sur une cible suspendue. On pose donc le filtre,
        on reprend, et la métrologie suit une fois la cible vivante.

        Lève si aucune couche réseau n'a pu être posée sur une PAGE alors
        que le blocage est demandé -- c'est cette exception qui déclenche le
        fail closed."""
        sid = session.session_id
        actif = self.actif
        est_page = session.type_ in ("page", "iframe", "webview", "background_page")

        if actif:
            if session.fetch_supporte:
                patterns = [
                    {"urlPattern": "*", "requestStage": "Request"},
                    {"urlPattern": "*", "requestStage": "Response"},
                ]
                try:
                    await self._envoyer("Fetch.enable",
                                        {"patterns": patterns, "handleAuthRequests": False},
                                        session_id=sid)
                    session.fetch_actif = True
                except Exception as exc:  # noqa: BLE001
                    if "wasn't found" in str(exc) or "-32601" in str(exc):
                        # Constaté sur Chromium 141 : le domaine Fetch
                        # n'existe pas sur les cibles `worker`. Ce n'est pas
                        # une panne, c'est une limite du moteur : on bascule
                        # définitivement cette cible sur la couche 1b et on
                        # cesse de réessayer (sinon : boucle d'avertissements).
                        session.fetch_supporte = False
                        log.info(f"[media_guard] {session.type_} {session.target_id} : domaine Fetch "
                                 "indisponible sur ce type de cible -- couche 1b (setBlockedURLs) seule.")
                    else:
                        raise
            # Couche 1b -- renfort gratuit, JAMAIS seul sur une page (§2.1),
            # et seul recours sur les cibles sans domaine Fetch. Repoussée
            # après la reprise quand la cible est suspendue (cf. docstring :
            # Network ne répond pas dans cet état).
            couche1b = False
            if attend_debugger and session.fetch_actif:
                couche1b = None  # « à faire en phase 2 »
            else:
                try:
                    await self._envoyer("Network.enable", {}, session_id=sid)
                    await self._envoyer("Network.setBlockedURLs", {"urls": PATTERNS_MEDIA_LOURD_DEFAUT},
                                        session_id=sid)
                    couche1b = True
                except Exception as exc:  # noqa: BLE001
                    if session.fetch_actif:
                        log.debug(f"[media_guard] couche 1b indisponible : {exc!r}")
                    elif est_page:
                        # Une PAGE sans aucune couche réseau est
                        # inacceptable : on lève, le fail closed prend le
                        # relais.
                        raise
                    else:
                        # Worker/service worker sans Fetch NI Network : on ne
                        # peut rien poser. On le DIT (au lieu de lever, ce qui
                        # figerait la cible et, par ricochet, la page qui
                        # l'attend -- cf. fail_closed_max_suspend_s).
                        log.warning(
                            f"[media_guard] {session.type_} {session.target_id} NON PROTÉGEABLE "
                            f"({exc!r}) -- ses requêtes ne seront pas filtrées ; "
                            "elles resteront visibles dans media_bytes_leaked."
                        )
            session.protegee = bool(session.fetch_actif or couche1b)
        else:
            if session.fetch_actif:
                try:
                    await self._envoyer("Fetch.disable", {}, session_id=sid)
                except Exception as exc:  # noqa: BLE001
                    log.debug(f"[media_guard] Fetch.disable : {exc!r}")
                session.fetch_actif = False
            try:
                await self._envoyer("Network.setBlockedURLs", {"urls": []}, session_id=sid)
            except Exception as exc:  # noqa: BLE001
                log.debug(f"[media_guard] levée couche 1b : {exc!r}")

        # §3.1 -- récursion sur les sous-cibles (OOPIF, workers, service
        # workers). EN PHASE 1, impérativement : une iframe cross-origin est
        # créée pendant le parsing du document, donc AVANT que la phase 2
        # (tâche de fond, post-reprise) ait eu le temps de s'exécuter.
        # Mesuré : placée en phase 2, l'image d'une iframe cross-origin
        # passait systématiquement (vecteur 10b, 125 Ko servis).
        # Le domaine Target répond normalement sur une cible suspendue,
        # contrairement à Network.
        try:
            await self._envoyer(
                "Target.setAutoAttach",
                {"autoAttach": True,
                 "waitForDebuggerOnStart": bool(actif and self.config.get("wait_for_debugger_on_start") and not _PROCESSUS_FEATHER),
                 "flatten": True},
                session_id=sid,
            )
        except Exception as exc:  # noqa: BLE001 -- workers sans domaine Target
            log.debug(f"[media_guard] auto-attach récursif indisponible sur {session.type_} : {exc!r}")

        # Couche 3 -- injection page. Elle DOIT précéder la reprise : le
        # script doit exister avant le premier script du document.
        if est_page and self.config.get("inject_page_layer"):
            await self._appliquer_couche_page(session, actif, attend_debugger)

    async def _equiper_complement(self, session, attend_debugger=False):
        """PHASE 2 -- métrologie et renforts, une fois la cible VIVANTE.
        Entièrement best-effort : un échec ici dégrade la mesure ou le
        confort, jamais le filtre (posé en phase 1)."""
        sid = session.session_id
        actif = self.actif
        est_page = session.type_ in ("page", "iframe", "webview", "background_page")

        # Métrologie (§9.1) : Network activé dans les DEUX états, c'est lui
        # qui mesure media_bytes_leaked.
        try:
            await self._envoyer("Network.enable", {}, session_id=sid)
        except Exception as exc:  # noqa: BLE001 -- la mesure est perdue, pas le filtre
            log.debug(f"[media_guard] Network.enable indisponible sur {session.type_} : {exc!r}")
            return

        # §7 -- service workers : les arrêter pendant que le blocage est
        # actif, faute de pouvoir les suspendre à la création.
        if (actif and est_page and self.config.get("stop_service_workers")
                and not session.sw_traite):
            # UNE SEULE FOIS par session, et sans attendre l'accusé : rejoué
            # à chaque bascule et en série, ce geste faisait passer la
            # latence de bascule de 60 ms à 9 s (mesuré). Un arrêt de
            # service worker n'a pas besoin d'être confirmé pour être utile.
            session.sw_traite = True
            for methode in ("ServiceWorker.enable", "ServiceWorker.stopAllWorkers"):
                await self._envoyer_sans_reponse(methode, {}, session_id=sid)

        # Couche 1b : posée ici quand la phase 1 l'avait repoussée (cible
        # alors suspendue), réappliquée sinon -- l'opération est idempotente
        # et coûte un seul aller-retour.
        if actif:
            try:
                await self._envoyer("Network.setBlockedURLs", {"urls": PATTERNS_MEDIA_LOURD_DEFAUT},
                                    session_id=sid)
                session.protegee = True
            except Exception as exc:  # noqa: BLE001
                log.debug(f"[media_guard] couche 1b (phase 2) : {exc!r}")

        # §7 : cache et service worker.
        for methode, params, condition in (
            ("Network.setCacheDisabled",
             {"cacheDisabled": bool(actif and self.config.get("disable_cache_when_active"))}, True),
            ("Network.setBypassServiceWorker",
             {"bypass": bool(actif and self.config.get("bypass_service_worker"))}, est_page),
        ):
            if not condition:
                continue
            try:
                await self._envoyer(methode, params, session_id=sid)
            except Exception as exc:  # noqa: BLE001
                log.debug(f"[media_guard] {methode} indisponible sur {session.type_} : {exc!r}")

        if not session.equipee:
            self.compteurs["targets_equipped"] += 1
        session.equipee = True
        session.erreurs.clear()

    async def _appliquer_couche_page(self, session, actif, attend_debugger=False):
        sid = session.session_id
        try:
            await self._envoyer("Page.enable", {}, session_id=sid)
        except Exception as exc:  # noqa: BLE001
            log.debug(f"[media_guard] Page.enable indisponible : {exc!r}")
            return
        if session.script_id:
            try:
                await self._envoyer("Page.removeScriptToEvaluateOnNewDocument",
                                    {"identifier": session.script_id}, session_id=sid)
            except Exception as exc:  # noqa: BLE001
                log.debug(f"[media_guard] retrait du script couche 3 : {exc!r}")
            session.script_id = None
        try:
            reponse = await self._envoyer(
                "Page.addScriptToEvaluateOnNewDocument",
                {"source": _gm_construire_script_page(actif, self.config), "runImmediately": True},
                session_id=sid,
            )
            session.script_id = (reponse or {}).get("identifier")
        except Exception as exc:  # noqa: BLE001 -- couche 3 = bonus (§2.4)
            log.debug(f"[media_guard] injection couche 3 impossible : {exc!r}")
        # Document DÉJÀ chargé : on bascule son drapeau à chaud pour que le
        # changement d'état s'applique sans rechargement (§5.2).
        #
        # JAMAIS sur une cible encore suspendue : Runtime.evaluate ne répond
        # pas tant que runIfWaitingForDebugger n'a pas été envoyé (même
        # symptôme que le bug Vivaldi/Runtime documenté en tête de fichier).
        # Mesuré au selftest : 2 s de gel PAR cible, donc 2 s pendant
        # lesquelles la page attend -- pour rien, puisqu'un document qui
        # n'a pas encore démarré n'a ni <video> en lecture ni drapeau à
        # corriger (le script injecté lui donnera la bonne valeur).
        if attend_debugger:
            return
        try:
            await self._envoyer(
                "Runtime.evaluate",
                {"expression": (_GM_SCRIPT_ARRET_FLUX if (actif and self.config.get("kill_active_streams_on_enable"))
                                else _GM_SCRIPT_NEUTRALISER),
                 "returnByValue": True, "awaitPromise": False},
                session_id=sid, timeout=2.0,
            )
        except Exception as exc:  # noqa: BLE001 -- cf. bug Vivaldi/Runtime documenté plus haut
            log.debug(f"[media_guard] évaluation couche 3 sans réponse sur {session.target_id} : {exc!r}")

    def _sur_cible_detachee(self, params):
        session_id = params.get("sessionId")
        session = self._sessions.pop(session_id, None)
        if session is not None:
            self._cibles_attachees.discard(session.target_id)
            if session.equipee:
                self.compteurs["targets_equipped"] = max(0, self.compteurs["targets_equipped"] - 1)
        self.compteurs["targets_total"] = len(self._sessions)

    async def _appliquer_a_toutes_les_sessions(self) -> int:
        """Réconcilie l'état réel avec l'état voulu sur chaque session.
        Retourne le nombre de médias arrêtés en vol."""
        # EN PARALLÈLE, impérativement. En série, la latence de bascule est
        # la SOMME des allers-retours de toutes les cibles : avec une
        # quinzaine de cibles (page + iframes + workers), elle dépassait
        # 9 secondes, très au-delà du seuil d'une seconde de la SPEC §5.2.
        # En parallèle, elle vaut celle de la cible la plus lente.
        async def _traiter(session):
            try:
                await self._equiper_session(session)
            except Exception as exc:  # noqa: BLE001
                self.compteurs["equip_failures"] += 1
                session.erreurs.append(repr(exc))
                log.warning(f"[media_guard] réalignement de {session.type_} {session.target_id} échoué : {exc!r}")
                await self._replier_fail_closed(session)
                return 0
            # Une cible laissée suspendue par un fail closed précédent doit
            # repartir dès qu'elle est protégée (ou déprotégée).
            await self._reprendre_cible(session)
            return 1 if (self.actif and self.config.get("kill_active_streams_on_enable")) else 0

        resultats = await asyncio.gather(
            *(_traiter(s) for s in list(self._sessions.values())), return_exceptions=True)
        arretes = sum(r for r in resultats if isinstance(r, int))
        if self.actif and self.config.get("reload_on_enable"):
            await self._recharger_pages()
        if not self.actif and self.config.get("reload_on_disable"):
            await self._recharger_pages()
        return arretes

    async def _recharger_pages(self):
        for session in list(self._sessions.values()):
            if session.type_ != "page":
                continue
            try:
                await self._envoyer("Page.reload", {"ignoreCache": True}, session_id=session.session_id, timeout=2.0)
            except Exception as exc:  # noqa: BLE001
                log.debug(f"[media_guard] rechargement de {session.target_id} impossible : {exc!r}")

    # === couche 1 & 2 : le cœur ===========================================

    async def _sur_requete_pausee(self, params, session_id):
        """Chemin CHAUD. Tout ce qui est ici s'exécute pour CHAQUE requête
        de CHAQUE cible : aucun accès disque, aucune attente d'accusé."""
        request_id = params.get("requestId")
        if not request_id:
            return
        requete = params.get("request") or {}
        url = requete.get("url") or ""
        resource_type = params.get("resourceType") or ""
        etape_reponse = params.get("responseStatusCode") is not None or params.get("responseErrorReason") is not None

        if not self.actif:
            # Peut arriver entre le basculement et le Fetch.disable effectif.
            await self._laisser_passer(request_id, session_id, etape_reponse)
            return

        if not etape_reponse:
            self.compteurs["requests_total"] += 1
            entetes = {str(k).lower(): v for k, v in (requete.get("headers") or {}).items()}
            bloquer, raison, categorie = _gm_classer_requete(url, resource_type, entetes, self.config)
            if not bloquer:
                # Cette URL a-t-elle DÉJÀ été démasquée par la couche 2 ?
                # Si oui, plus aucune raison de payer une seconde fois le
                # coût d'un aller-retour jusqu'aux en-têtes.
                apprise = self._urls_media_apprises.get(_gm_cle_url(url))
                if apprise is not None:
                    bloquer, raison, categorie = True, "URL déjà démasquée (apprentissage)", apprise
                    self.compteurs["blocked_l1_appris"] = self.compteurs.get("blocked_l1_appris", 0) + 1
                elif self.config.get("block_ambiguous_fetch") and _gm_requete_ambigue(
                        url, resource_type, entetes):
                    bloquer, raison, categorie = True, "fetch ambigu (mode strict)", "image"
            if bloquer:
                await self._envoyer_sans_reponse(
                    "Fetch.failRequest",
                    {"requestId": request_id, "errorReason": "BlockedByClient"},
                    session_id=session_id,
                )
                estimation = _GM_TAILLE_ESTIMEE_PAR_CATEGORIE.get(categorie or "image", 100 * 1024)
                self.compteurs["blocked_l1"] += 1
                self.compteurs["blocked_bytes_saved_est"] += estimation
                self._par_categorie[categorie or "?"] += 1
                log.debug(f"BLOCK L1 {categorie or '?'} {url[:160]} ({raison}, est {estimation // 1024} Ko)")
                return
            await self._envoyer_sans_reponse("Fetch.continueRequest", {"requestId": request_id},
                                             session_id=session_id)
            return

        # --- étape Response (couche 2, §2.3) ---
        entetes_reponse = {}
        for entete in (params.get("responseHeaders") or []):
            try:
                entetes_reponse[str(entete.get("name", "")).lower()] = entete.get("value", "")
            except Exception:  # noqa: BLE001
                continue
        bloquer, raison, categorie = _gm_classer_reponse(
            url, entetes_reponse.get("content-type", ""), entetes_reponse.get("content-length"),
            resource_type, self.config,
        )
        if bloquer:
            try:
                taille = int(entetes_reponse.get("content-length") or 0)
            except (TypeError, ValueError):
                taille = 0
            await self._envoyer_sans_reponse(
                "Fetch.failRequest",
                {"requestId": request_id, "errorReason": "BlockedByClient"},
                session_id=session_id,
            )
            self.compteurs["blocked_l2"] += 1
            if self.config.get("apprentissage_urls_media"):
                cle = _gm_cle_url(url)
                if cle and cle not in self._urls_media_apprises:
                    if len(self._ordre_urls_apprises) == self._ordre_urls_apprises.maxlen:
                        self._urls_media_apprises.pop(self._ordre_urls_apprises[0], None)
                    self._ordre_urls_apprises.append(cle)
                    self._urls_media_apprises[cle] = categorie or "image"
                    log.debug(f"[media_guard] URL mémorisée comme média : {cle}")
            self.compteurs["blocked_bytes_saved_est"] += taille or _GM_TAILLE_ESTIMEE_PAR_CATEGORIE.get(
                categorie or "image", 100 * 1024)
            self._par_categorie[(categorie or "?") + " (déguisé)"] += 1
            log.debug(f"BLOCK L2 {categorie or '?'} {url[:160]} ({raison}, {taille} o annoncés)")
            return
        await self._envoyer_sans_reponse("Fetch.continueResponse", {"requestId": request_id},
                                         session_id=session_id)

    async def _laisser_passer(self, request_id, session_id, etape_reponse):
        methode = "Fetch.continueResponse" if etape_reponse else "Fetch.continueRequest"
        await self._envoyer_sans_reponse(methode, {"requestId": request_id}, session_id=session_id)

    # === §9.1 : mesure de la fuite ========================================

    def _sur_reponse_recue(self, params, _session_id):
        """Marque les réponses classées média qui n'ont PAS été bloquées.
        C'est la métrique qui aurait révélé le bug d'origine (§9.1)."""
        if not self.actif:
            return
        reponse = params.get("response") or {}
        url = reponse.get("url") or ""
        bloquer, _raison, categorie = _gm_classer_reponse(
            url, reponse.get("mimeType", ""), (reponse.get("headers") or {}).get("content-length"),
            params.get("type"), self.config,
        )
        if not bloquer:
            bloquer, _raison, categorie = _gm_classer_requete(
                url, params.get("type"), {}, self.config
            )
        if not bloquer:
            return
        request_id = params.get("requestId")
        if not request_id:
            return
        if len(self._ordre_requetes) == self._ordre_requetes.maxlen:
            self._requetes_media.pop(self._ordre_requetes[0], None)
        self._ordre_requetes.append(request_id)
        self._requetes_media[request_id] = (categorie or "?", url, reponse.get("mimeType", ""))

    def _sur_donnees_recues(self, methode, params):
        request_id = params.get("requestId")
        if not request_id or request_id not in self._requetes_media:
            return
        if methode == "Network.dataReceived":
            octets = int(params.get("encodedDataLength") or 0)
        else:
            octets = int(params.get("encodedDataLength") or 0)
            self._requetes_media.pop(request_id, None)
        if octets <= 0:
            return
        self.compteurs["media_bytes_leaked"] += octets
        categorie, url, mime = self._requetes_media.get(request_id, ("?", "", ""))
        cle = url[:120]
        if cle not in self._fuites_signalees:
            self._fuites_signalees.add(cle)
            if len(self._fuites_signalees) > 200:
                self._fuites_signalees.clear()
            log.warning(
                f"LEAK {mime or categorie} {octets} octets reçus sur {url[:160]} "
                "-- une couche a été contournée, cf. README_blocage_medias.md §diagnostic"
            )

    # === boucles de fond ==================================================

    async def _boucle_surveillance(self):
        """Watchdog §3.3 : réconcilie l'état VOULU (toggle disque + fichier
        d'état + forçage Task) et l'état RÉEL, et rattrape toute cible
        oubliée. Intervalle ≤ 500 ms par défaut (§3.3)."""
        derniere_erreur = None
        while not self._arret.is_set():
            try:
                intervalle = max(0.05, float(self.config.get("poll_interval_ms") or 500) / 1000.0)
                await asyncio.sleep(intervalle)
                self.config.recharger()

                voulu = self._etat_voulu()
                if voulu != self.actif:
                    await self.set_state(voulu, source="watchdog")
                    continue

                # Garde-fou anti-détachement silencieux (§3.3, dernière puce).
                # `fetch_supporte` exclut les cibles dont le moteur n'expose
                # pas Fetch (workers) : les réequiper en boucle ne ferait que
                # rejouer le même échec toutes les 500 ms.
                manquantes = [s for s in self._sessions.values()
                              if self.actif and s.fetch_supporte and not s.fetch_actif
                              and s.type_ != "browser"]
                if manquantes:
                    log.warning(f"[media_guard] {len(manquantes)} cible(s) sans filtre détectée(s) -- réequipement.")
                    await self._appliquer_a_toutes_les_sessions()
                    continue
                derniere_erreur = None
            except asyncio.CancelledError:
                raise
            except Exception as exc:  # noqa: BLE001 -- §8 : la boucle ne s'arrête jamais
                message = repr(exc)
                if message != derniere_erreur:
                    derniere_erreur = message
                    log.warning(f"[media_guard] watchdog : {message}")

    def _etat_voulu(self) -> bool:
        """Priorité : forçage explicite d'un Task > toggle de la carte >
        fichier d'état (canal push) > config.enabled. Identique à l'ancienne
        règle documentée dans _synchroniser_blocage_media_profil, étendue au
        canal push."""
        if self._forcage_explicite:
            return True
        toggle = _lire_toggle_bloquer_media_profil(self.nom_profil)
        if toggle is not None:
            return bool(toggle)
        try:
            mtime = Path(self.chemin_etat).stat().st_mtime_ns
        except Exception:  # noqa: BLE001
            mtime = None
        if mtime is not None and mtime != self._mtime_etat:
            etat, self._mtime_etat = _gm_lire_etat_persiste(self.chemin_etat)
            if etat is not None:
                return etat
        return self.actif

    async def _boucle_resume(self):
        """§9.2 : résumé INFO toutes les stats_interval_s."""
        while not self._arret.is_set():
            try:
                await asyncio.sleep(max(1.0, float(self.config.get("stats_interval_s") or 10.0)))
                if self.compteurs["requests_total"] == 0 and self.compteurs["blocked_l1"] == 0:
                    continue
                log.info(f"[media_guard] {self._resume_compteurs()}")
            except asyncio.CancelledError:
                raise
            except Exception as exc:  # noqa: BLE001
                log.debug(f"[media_guard] résumé : {exc!r}")

    def _resume_compteurs(self) -> str:
        c = self.compteurs
        fuite = c["media_bytes_leaked"]
        return (
            f"requêtes={c['requests_total']} bloquées L1={c['blocked_l1']} L2={c['blocked_l2']} "
            f"économie≈{c['blocked_bytes_saved_est'] // 1024} Ko "
            f"FUITE={fuite} o {'(OK)' if fuite == 0 else '(!! NON CONFORME !!)'} "
            f"cibles={c['targets_equipped']}/{c['targets_total']} "
            f"late_equip={c['late_equip_count']} échecs={c['equip_failures']} "
            f"bascules={c['basculements']} (max {c['latence_bascule_max_ms']} ms)"
        )


# Référence unique au gardien de CE process d'instance (un seul navigateur
# par process -- cf. main_instance_nodriver). Les façades ci-dessous
# l'utilisent pour ne JAMAIS poser de filtre concurrent (§5.4).
_GARDIEN_MEDIA_COURANT: Optional["GardienMediaCDP"] = None


def gardien_media_courant():
    return _GARDIEN_MEDIA_COURANT


# ---------------------------------------------------------------------------
# COUCHE 1b / compatibilité : l'ancienne primitive, conservée telle quelle.
# Elle n'est plus JAMAIS le seul mécanisme (SPEC §2.1) -- uniquement un
# renfort posé par le gardien, et le repli quand le gardien n'a pas pu
# démarrer (websockets absent, endpoint CDP introuvable).
# ---------------------------------------------------------------------------
PATTERNS_MEDIA_LOURD_DEFAUT = (
    [f"*.{ext}" for ext in sorted(_GM_EXT_IMAGE)]
    + [f"*.{ext}" for ext in sorted(_GM_EXT_VIDEO)]
    + [f"*.{ext}" for ext in sorted(_GM_EXT_AUDIO)]
    + [f"*.{ext}" for ext in sorted(_GM_EXT_STREAM)]
    + [f"*.{ext}?*" for ext in sorted(_GM_EXT_IMAGE | _GM_EXT_VIDEO | _GM_EXT_AUDIO | _GM_EXT_STREAM)]
)


async def _installer_blocage_media(page, patterns: list) -> None:
    """Repli couche 1b sur UNE page nodriver (ancien mécanisme).

    CONSERVÉE pour compatibilité des appels existants, mais ce n'est plus la
    protection : sans le gardien, elle ne couvre ni les iframes
    cross-origin, ni les workers, ni les médias sans extension, ni les
    médias déguisés -- c'est précisément le bug corrigé (SPEC §0).
    Une liste vide désactive le filtre."""
    await page.send(cdp.network.enable())
    await page.send(cdp.network.set_blocked_ur_ls(urls=patterns))


def _lire_toggle_bloquer_media_profil(nom_profil: Optional[str]) -> Optional[bool]:
    """Relit sur disque l'état du toggle « bloquer médias » de la carte de
    profil. None = INCONNU (pas de --nom-profil, ou lecture impossible) :
    distinct de False, qui veut dire « l'utilisateur a désactivé »."""
    if not nom_profil:
        return None
    try:
        return bool(obtenir_config_profil(nom_profil).get("bloquer_media", False))
    except Exception as e:  # noqa: BLE001
        log.warning(f"[media_guard] lecture du toggle du profil {nom_profil!r} impossible ({e!r})")
        return None


async def _synchroniser_blocage_media_profil(page, etat_navigateur: Optional[dict],
                                             bloquer_media_explicite: bool) -> bool:
    """FAÇADE (§5.4) -- délègue au gardien, seul propriétaire du filtre.

    Même règle de priorité qu'avant : un naviguer(..., bloquer_media=True)
    d'un Task prime sur le toggle de la carte. La différence est qu'on ne
    pose plus de filtre par onglet ici : on demande au gardien d'appliquer
    l'état à TOUTES les cibles, ce qui couvre aussi les iframes, workers et
    onglets ouverts à la main.

    Repli (gardien absent) : ancien comportement, pour qu'une instance sans
    websockets ne perde pas toute protection."""
    gardien = gardien_media_courant()
    if gardien is not None:
        if bloquer_media_explicite:
            await gardien.forcer_explicite(True)
            return True
        return bool(gardien.actif)

    if bloquer_media_explicite:
        await _installer_blocage_media(page, PATTERNS_MEDIA_LOURD_DEFAUT)
        return True
    nom_profil = (etat_navigateur or {}).get("nom_profil")
    toggle = _lire_toggle_bloquer_media_profil(nom_profil)
    if toggle is None:
        return False
    await _installer_blocage_media(page, PATTERNS_MEDIA_LOURD_DEFAUT if toggle else [])
    return bool(toggle)


async def _installer_synchro_blocage_media_sur_rechargement(page, etat_navigateur: dict) -> None:
    """FAÇADE devenue INUTILE avec le gardien, conservée pour ne pas casser
    les appelants existants.

    L'ancien mécanisme écoutait Page.frameStartedLoading pour réaligner le
    filtre au début de chaque chargement -- avec la « LIMITE HONNÊTE »
    documentée à l'époque : le filtre arrivait APRÈS le départ des premières
    requêtes. Le gardien supprime ce problème à la racine en suspendant
    chaque cible à sa création (§3.2), donc ce handler n'a plus lieu
    d'être : il ne ferait que dupliquer un propriétaire du filtre, ce que la
    SPEC §5.4 interdit explicitement."""
    if gardien_media_courant() is not None:
        return
    if getattr(page, "__autoniax_synchro_media__", False):
        return
    verrou = asyncio.Lock()

    async def _sur_debut_chargement(_evt):
        if verrou.locked():
            return
        async with verrou:
            try:
                await _synchroniser_blocage_media_profil(page, etat_navigateur, False)
            except Exception as e:  # noqa: BLE001
                log.debug(f"[media_guard] resynchronisation sur rechargement échouée ({e!r})")

    try:
        page.add_handler(cdp.page.FrameStartedLoading, _sur_debut_chargement)
        await page.send(cdp.page.enable())
        setattr(page, "__autoniax_synchro_media__", True)
    except Exception as e:  # noqa: BLE001
        log.warning(f"[media_guard] repli sans gardien : synchro sur rechargement non installée ({e!r})")


async def _appliquer_toggle_media_sur_tous_les_onglets(browser, etat_navigateur: dict) -> int:
    """FAÇADE -- le gardien applique déjà l'état à toutes les cibles."""
    gardien = gardien_media_courant()
    if gardien is not None:
        await gardien._appliquer_a_toutes_les_sessions()
        return gardien.compteurs["targets_equipped"]
    nb_ok = 0
    for onglet in list(browser.tabs):
        try:
            cible = getattr(onglet, "target", None)
            if cible is None or cible.type_ != "page":
                continue
            await _synchroniser_blocage_media_profil(onglet, etat_navigateur, False)
            nb_ok += 1
        except Exception as e:  # noqa: BLE001
            log.debug(f"[media_guard] réalignement d'un onglet échoué ({e!r})")
    return nb_ok


async def _surveiller_toggle_bloquer_media(browser, etat_navigateur: dict, instance_id: str = "",
                                           chemin_profil: Optional[str] = None) -> None:
    """Point d'entrée conservé (appelé par _main_async) -- démarre et
    maintient le GARDIEN, au lieu de l'ancienne boucle de polling qui
    réalignait des filtres par onglet.

    Ne se termine que par annulation ; à l'annulation, le gardien relâche
    proprement toute cible suspendue."""
    global _GARDIEN_MEDIA_COURANT
    gardien = GardienMediaCDP(browser, etat_navigateur, instance_id, chemin_profil)
    try:
        await gardien.demarrer()
    except Exception as exc:  # noqa: BLE001
        # Sans gardien, on retombe sur l'ancienne protection dégradée
        # PLUTÔT que sur rien du tout -- et on le dit clairement.
        log.warning(
            f"[media_guard] Instance '{instance_id}' : gardien INDISPONIBLE ({exc!r}). "
            "Repli sur le filtre par onglet (couche 1b seule) -- iframes, workers et "
            "médias sans extension NE SERONT PAS bloqués."
        )
        await _surveiller_toggle_bloquer_media_repli(browser, etat_navigateur, instance_id)
        return
    _GARDIEN_MEDIA_COURANT = gardien
    etat_navigateur["gardien_media"] = gardien
    try:
        await gardien._arret.wait()
    except asyncio.CancelledError:
        raise
    finally:
        _GARDIEN_MEDIA_COURANT = None
        etat_navigateur.pop("gardien_media", None)
        await gardien.arreter()


async def _surveiller_toggle_bloquer_media_repli(browser, etat_navigateur: dict, instance_id: str = "") -> None:
    """Ancienne boucle, conservée UNIQUEMENT comme repli quand le gardien ne
    peut pas démarrer (websockets absent, endpoint CDP introuvable)."""
    nom_profil = (etat_navigateur or {}).get("nom_profil")
    if not nom_profil:
        log.info(f"Instance '{instance_id}' : surveillance du toggle médias NON démarrée -- pas de --nom-profil.")
        return
    dernier_toggle: Optional[bool] = None
    dernier_nb_onglets = -1
    derniere_erreur: Optional[str] = None
    while True:
        try:
            await asyncio.sleep(1.0)
            toggle = _lire_toggle_bloquer_media_profil(nom_profil)
            if toggle is None:
                continue
            await browser.update_targets()
            nb_onglets = sum(1 for o in browser.tabs
                             if getattr(o, "target", None) is not None and o.target.type_ == "page")
            derniere_erreur = None
            if toggle == dernier_toggle and nb_onglets == dernier_nb_onglets:
                continue
            nb_ok = await _appliquer_toggle_media_sur_tous_les_onglets(browser, etat_navigateur)
            if toggle != dernier_toggle:
                log.info(f"[media_guard][repli] toggle -> {'ACTIVÉ' if toggle else 'désactivé'} "
                         f"sur {nb_ok} onglet(s).")
            dernier_toggle = toggle
            dernier_nb_onglets = nb_onglets
        except asyncio.CancelledError:
            raise
        except Exception as exc:  # noqa: BLE001
            message = repr(exc)
            if message != derniere_erreur:
                derniere_erreur = message
                log.warning(f"[media_guard][repli] {message}")


# ---------------------------------------------------------------------------
# Volet CAMOUFOX (Playwright/Firefox) -- SPEC §2.1, « autres moteurs ».
#
# CDP n'existe pas ici. L'interception native de Playwright est posée sur le
# CONTEXTE, ce qui couvre d'office tous les onglets présents et futurs, les
# iframes et les workers -- avantage structurel sur l'ancien filtre CDP par
# onglet. Ce qui MANQUE par rapport au chemin Chrome, et qui est assumé
# explicitement (cf. README §limites) :
#   - pas de couche 2 : Playwright ne permet pas d'abandonner une réponse
#     après lecture des en-têtes sans en télécharger le corps
#     (route.fetch() télécharge). La classification de requête est donc
#     renforcée pour compenser (resource_type + extension + Accept + dest).
#   - pas de suspension à la création de cible : add_init_script couvre le
#     cas en s'exécutant avant tout script de page.
# ---------------------------------------------------------------------------
EXTENSIONS_MEDIA_LOURD_DEFAUT = tuple(
    "." + ext for ext in sorted(_GM_EXT_IMAGE | _GM_EXT_VIDEO | _GM_EXT_AUDIO | _GM_EXT_STREAM)
)

TYPES_RESSOURCE_MEDIA_CAMOUFOX = frozenset({"image", "imageset", "media"})

DELAI_CACHE_TOGGLE_MEDIA_S = 0.5
_CACHE_TOGGLE_MEDIA = {"nom": None, "valeur": False, "expire": 0.0}


def _lire_toggle_bloquer_media_profil_cache(nom_profil: Optional[str]) -> bool:
    """Version mise en cache, pour le chemin chaud de l'interception (une
    page lourde émet des centaines de requêtes -- relire le JSON à chaque
    fois coûterait plus cher que le blocage lui-même). TTL 500 ms : la
    bascule du bouton prend effet en ≤ 0,5 s, conforme au ≤ 1 s de §5.2."""
    if not nom_profil:
        return False
    maintenant = time.monotonic()
    if _CACHE_TOGGLE_MEDIA["nom"] == nom_profil and maintenant < _CACHE_TOGGLE_MEDIA["expire"]:
        return bool(_CACHE_TOGGLE_MEDIA["valeur"])
    valeur = _lire_toggle_bloquer_media_profil(nom_profil)
    valeur = bool(valeur) if valeur is not None else False
    _CACHE_TOGGLE_MEDIA.update({"nom": nom_profil, "valeur": valeur,
                                "expire": maintenant + DELAI_CACHE_TOGGLE_MEDIA_S})
    return valeur


def _blocage_media_actif_camoufox(etat_navigateur: Optional[dict]) -> bool:
    """Même règle de priorité que côté CDP : un bloquer_media=True explicite
    d'un Task prime toujours sur le toggle de la carte."""
    etat = etat_navigateur or {}
    if etat.get("bloquer_media_explicite"):
        return True
    return _lire_toggle_bloquer_media_profil_cache(etat.get("nom_profil"))


def _requete_camoufox_est_media(requete, config) -> bool:
    """Classification §4 appliquée à un objet Request Playwright. Jamais
    d'exception vers la boucle Playwright : un attribut absent retombe sur
    « pas un média » plutôt que sur un plantage de l'interception."""
    try:
        url = getattr(requete, "url", "") or ""
        type_ressource = (getattr(requete, "resource_type", "") or "").lower()
        try:
            entetes = {str(k).lower(): v for k, v in (requete.headers or {}).items()}
        except Exception:  # noqa: BLE001
            entetes = {}
        if type_ressource in TYPES_RESSOURCE_MEDIA_CAMOUFOX:
            categorie = "image" if type_ressource in ("image", "imageset") else "video"
            if config.categorie_active(categorie) and config.decision_liste(url) != "autoriser":
                return True
        if type_ressource == "font":
            return bool(config.get("block_fonts")) and config.decision_liste(url) != "autoriser"
        # Mappe le vocabulaire Playwright sur celui de CDP pour réutiliser le
        # MÊME classifieur (une seule logique, jamais deux qui divergent).
        correspondance = {"image": "Image", "imageset": "Image", "media": "Media",
                          "font": "Font", "document": "Document", "xhr": "XHR",
                          "fetch": "Fetch", "other": "Other"}
        bloquer, _raison, _cat = _gm_classer_requete(
            url, correspondance.get(type_ressource, "Other"), entetes, config)
        return bool(bloquer)
    except Exception:  # noqa: BLE001
        return False


async def camoufox_installer_blocage_media(context, etat_navigateur: dict) -> None:
    """Installe SUR LE CONTEXTE l'interception réseau + la couche 3.

    Idempotent (drapeau dans etat_navigateur). Ne lève JAMAIS : un échec
    d'installation dégrade le toggle mais ne doit pas empêcher l'instance de
    démarrer -- même politique que camoufox_installer_interception_presse_
    papier."""
    if etat_navigateur.get("_route_blocage_media_installee"):
        return
    config = ConfigBlocageMedia(_gm_chemin_config(etat_navigateur.get("chemin_profil")))
    etat_navigateur["_config_blocage_media"] = config
    compteurs = etat_navigateur.setdefault(
        "_stats_blocage_media", {"requests_total": 0, "blocked_l1": 0, "media_bytes_leaked": 0})

    async def _filtre_media(route):
        try:
            config.recharger()
            requete = route.request
            compteurs["requests_total"] += 1
            bloquer = (_blocage_media_actif_camoufox(etat_navigateur)
                       and _requete_camoufox_est_media(requete, config))
        except Exception:  # noqa: BLE001 -- jamais d'exception dans la boucle Playwright
            bloquer = False
        try:
            if bloquer:
                compteurs["blocked_l1"] += 1
                log.debug(f"BLOCK L1 [camoufox] {getattr(route.request, 'url', '')[:160]}")
                await route.abort()
            else:
                await route.continue_()
        except Exception:  # noqa: BLE001 -- onglet fermé / route déjà résolue
            pass

    try:
        await context.route("**/*", _filtre_media)
        # Couche 3 : s'exécute avant tout script de page, sur toutes les
        # pages et frames présentes ET futures du contexte.
        if config.get("inject_page_layer"):
            try:
                await context.add_init_script(
                    _gm_construire_script_page(_blocage_media_actif_camoufox(etat_navigateur), config))
            except Exception as exc:  # noqa: BLE001
                log.warning(f"[camoufox][media_guard] couche 3 non installée ({exc!r})")
        etat_navigateur["_route_blocage_media_installee"] = True
        log.info(
            "[camoufox][media_guard] interception réseau + couche page installées sur le contexte "
            f"(profil {etat_navigateur.get('nom_profil')!r}, config {config.chemin})"
        )
    except Exception as e:  # noqa: BLE001
        log.warning(
            f"[camoufox][media_guard] installation de l'interception échouée ({e!r}) "
            "-- le toggle de la carte restera sans effet sur cette instance"
        )
# <<< AUTONIAX_MEDIA_GUARD_END >>>

# <<< AUTONIAX_RESOURCE_OVERRIDE_BEGIN >>>
# ===========================================================================
# REMPLACEMENT / MODIFICATION DE RESSOURCES À LA VOLÉE (action "remplacerRessources")
# ===========================================================================
#
# BUT (demande utilisateur) : pouvoir faire exécuter par la page NOTRE version
# d'un fichier qu'elle charge (ex. Main.min_xxx.js), AVANT qu'elle ne
# s'exécute -- par exemple l'original + un print après 10 s -- au lieu de
# seulement ajouter du code APRÈS coup (evaluer_js).
#
# PRINCIPE : une règle = un motif d'URL + une transformation du CORPS de la
# réponse (ajout au début / à la fin, remplacements de texte, ou corps
# intégral fourni). Le navigateur est suspendu sur la réponse, AutoniaX
# récupère le corps, le transforme, puis le sert à la page à la place de
# l'original. Aucun fichier du site n'est modifié sur le disque.
#
#   Chrome / Vivaldi (nodriver)  : CDP Fetch (étape Response) sur la session
#       de l'onglet, avec des patterns ÉTROITS (uniquement les motifs des
#       règles -- jamais "*" sauf règle regex) : le reste du trafic ne passe
#       pas par ce code. Installé AVANT la navigation (naviguer/new_tab).
#   Camoufox / CloakBrowser (Playwright) : context.route avec un prédicat
#       (ne s'applique qu'aux URL qui matchent une règle) ; les autres
#       requêtes continuent vers le filtre médias existant (fallback).
#
# ROBUSTESSE :
#   - une requête interceptée n'est JAMAIS laissée suspendue : toute erreur
#     (corps illisible, redirection, timeout...) -> la requête continue
#     telle quelle (original servi) et l'erreur est écrite dans le journal ;
#   - un journal par instance (lecture : Instance.lire_journal_remplacements())
#     dit pour chaque URL interceptée : règle appliquée, tailles avant/après,
#     nombre d'occurrences de chaque remplacement de texte (0 = le texte à
#     remplacer n'existe pas dans le fichier), erreur éventuelle ;
#   - les règles vivent dans etat_navigateur : elles survivent à
#     reset_interface()/changement d'onglet et sont réappliquées à chaque
#     naviguer()/new_tab() ;
#   - ce code n'appelle JAMAIS les fonctions du gardien médias : les deux
#     mécanismes coexistent (sessions CDP / routes Playwright distinctes).
#
# LIMITES CONNUES (honnêtes) :
#   - Chrome/Vivaldi : seul l'onglet piloté est couvert (pas les iframes
#     cross-origin isolées, ni les workers, ni les popups ouvertes par la
#     page). Camoufox/Cloak : tout le contexte est couvert.
#   - Un <script integrity="sha..."> refuse un fichier modifié (le navigateur
#     bloque) -- l'erreur apparaît alors côté page, pas dans le journal.
#   - Motif sensible à la CASSE (même règle sur Chrome et Playwright).
#   - ajouter_debut est inséré AVANT tout : une directive "use strict" en
#     tête du fichier d'origine perd son statut de directive.
# ===========================================================================

_RO_TAILLE_JOURNAL_MAX = 200
_RO_TIMEOUT_CDP_S = 20.0
_RO_CLES_REGLE = frozenset({"motif", "regex", "ajouter_debut", "ajouter_fin",
                            "remplacer", "corps_base64", "content_type"})
_RO_ENTETES_A_RETIRER = frozenset({"content-length", "content-encoding", "transfer-encoding"})


def _ro_construire_regle(motif, ajouter_debut=None, ajouter_fin=None, remplacer=None,
                         fichier=None, contenu=None, content_type=None, regex=False) -> dict:
    """CÔTÉ CLIENT (Task) -- fabrique UNE règle sérialisable (dict JSON) à partir
    des arguments de Instance.remplacer_ressource(). Lève ValueError si la règle
    est invalide (avant tout envoi au navigateur)."""
    if not isinstance(motif, str) or not motif:
        raise ValueError("motif obligatoire (texte non vide)")
    regle = {"motif": motif, "regex": bool(regex)}
    if regex:
        try:
            re.compile(motif)
        except re.error as exc:
            raise ValueError(f"expression régulière invalide : {exc}")
    if ajouter_debut:
        regle["ajouter_debut"] = str(ajouter_debut)
    if ajouter_fin:
        regle["ajouter_fin"] = str(ajouter_fin)
    if remplacer:
        paires = remplacer.items() if isinstance(remplacer, dict) else remplacer
        regle["remplacer"] = [[str(ancien), str(nouveau)] for ancien, nouveau in paires]
    if fichier is not None and contenu is not None:
        raise ValueError("fichier et contenu sont exclusifs")
    if fichier is not None:
        regle["corps_base64"] = base64.b64encode(Path(fichier).read_bytes()).decode("ascii")
    elif contenu is not None:
        octets = contenu.encode("utf-8") if isinstance(contenu, str) else bytes(contenu)
        regle["corps_base64"] = base64.b64encode(octets).decode("ascii")
    if content_type:
        regle["content_type"] = str(content_type)
    if not any(k in regle for k in ("ajouter_debut", "ajouter_fin", "remplacer", "corps_base64")):
        raise ValueError("aucune modification demandée (ajouter_debut, ajouter_fin, remplacer, fichier ou contenu)")
    return regle


def _ro_client_appeler(appeler, instance_id: str, operation: str, regles=None, timeout=None) -> dict:
    """CÔTÉ CLIENT -- envoie l'action réseau "remplacerRessources" et renvoie
    {"regles": n, "journal": [...], "installation": "..."} ; RuntimeError si échec.
    `appeler(action, params, timeout)` = le transport propre à chaque classe cliente."""
    delai = timeout if timeout is not None else 30.0
    params = {"operation": operation, "timeout_action_s": delai}
    if regles is not None:
        params["regles"] = regles
    reponse = appeler("remplacerRessources", params, delai)
    if not reponse.get("ok"):
        raise RuntimeError(
            f"Échec de la commande de remplacement de ressources ({operation}) pour l'instance « {instance_id} » : {reponse.get('error')}")
    return reponse.get("result") or {}


def _ro_normaliser_regles(regles) -> list:
    """CÔTÉ MOTEUR -- valide et normalise la liste reçue. Lève ValueError."""
    if regles is None:
        return []
    if not isinstance(regles, (list, tuple)):
        raise ValueError("« regles » doit être une liste")
    sortie = []
    for i, brute in enumerate(regles):
        if not isinstance(brute, dict):
            raise ValueError(f"règle {i} : un dict est attendu")
        inconnues = set(brute) - _RO_CLES_REGLE
        if inconnues:
            raise ValueError(f"règle {i} : clés inconnues {sorted(inconnues)}")
        motif = brute.get("motif")
        if not isinstance(motif, str) or not motif:
            raise ValueError(f"règle {i} : motif obligatoire")
        regle = {"motif": motif, "regex": bool(brute.get("regex"))}
        if regle["regex"]:
            try:
                re.compile(motif)
            except re.error as exc:
                raise ValueError(f"règle {i} : expression régulière invalide ({exc})")
        for cle in ("ajouter_debut", "ajouter_fin", "content_type"):
            if brute.get(cle):
                regle[cle] = str(brute[cle])
        if brute.get("remplacer"):
            paires = []
            for paire in brute["remplacer"]:
                if not isinstance(paire, (list, tuple)) or len(paire) != 2:
                    raise ValueError(f"règle {i} : « remplacer » = liste de paires [ancien, nouveau]")
                paires.append([str(paire[0]), str(paire[1])])
            regle["remplacer"] = paires
        if brute.get("corps_base64") is not None:
            try:
                base64.b64decode(str(brute["corps_base64"]), validate=True)
            except Exception:
                raise ValueError(f"règle {i} : corps_base64 invalide")
            regle["corps_base64"] = str(brute["corps_base64"])
        if not any(k in regle for k in ("ajouter_debut", "ajouter_fin", "remplacer", "corps_base64")):
            raise ValueError(f"règle {i} : aucune modification demandée")
        sortie.append(regle)
    return sortie


def _ro_trouver_regle(url: str, regles) -> tuple:
    """(index, règle) de la PREMIÈRE règle dont le motif correspond à l'URL (sensible à la casse), sinon (None, None)."""
    for i, regle in enumerate(regles or []):
        try:
            if regle.get("regex"):
                if re.search(regle["motif"], url):
                    return i, regle
            elif regle["motif"] in url:
                return i, regle
        except Exception:  # noqa: BLE001 -- une règle défectueuse ne doit jamais bloquer le trafic
            continue
    return None, None


def _ro_transformer(regle: dict, corps_original) -> tuple:
    """Applique la règle. corps_original = bytes (ou None si la règle fournit le corps entier).
    Retourne (nouveau_corps_bytes, stats)."""
    if "corps_base64" in regle:
        base = base64.b64decode(regle["corps_base64"])
    else:
        base = corps_original or b""
    stats = {"avant": (len(corps_original) if corps_original is not None else None), "remplacements": []}
    if regle.get("remplacer") or regle.get("ajouter_debut") or regle.get("ajouter_fin"):
        # surrogateescape : un fichier qui n'est pas de l'UTF-8 pur repart octet pour octet.
        texte = base.decode("utf-8", "surrogateescape")
        for ancien, nouveau in regle.get("remplacer") or []:
            n = texte.count(ancien) if ancien else 0
            if n:
                texte = texte.replace(ancien, nouveau)
            stats["remplacements"].append(n)
        if regle.get("ajouter_debut"):
            texte = regle["ajouter_debut"] + "\n" + texte
        if regle.get("ajouter_fin"):
            # saut de ligne AVANT : un fichier qui finit par un commentaire "//# sourceMappingURL=..." mangerait sinon le code ajouté.
            texte = texte + "\n" + regle["ajouter_fin"] + "\n"
        base = texte.encode("utf-8", "surrogateescape")
    stats["apres"] = len(base)
    return base, stats


def _ro_journaliser(etat_navigateur: dict, **champs) -> None:
    journal = etat_navigateur.setdefault("remplacements_journal", [])
    champs["t"] = round(time.time(), 3)
    journal.append(champs)
    if len(journal) > _RO_TAILLE_JOURNAL_MAX:
        del journal[: len(journal) - _RO_TAILLE_JOURNAL_MAX]


async def _ro_executer_commande(data: dict, etat_navigateur: dict, installer) -> dict:
    """CÔTÉ MOTEUR, commun à nodriver et Playwright -- opérations : "definir" (remplace toutes les règles),
    "ajouter", "journal", "vider_journal". `installer` = coroutine sans argument qui (ré)applique les règles
    au navigateur et renvoie (ok, message). Retourne {"ok": bool, "result"|"error": ...}."""
    operation = str(data.get("operation") or "definir")
    resultat = {}
    if operation in ("definir", "ajouter"):
        try:
            nouvelles = _ro_normaliser_regles(data.get("regles"))
        except ValueError as exc:
            return {"ok": False, "error": f"règles de remplacement invalides : {exc}"}
        if operation == "ajouter":
            regles = list(etat_navigateur.get("remplacements") or []) + nouvelles
        else:
            regles = nouvelles
            etat_navigateur["remplacements_journal"] = []
        etat_navigateur["remplacements"] = regles
        ok, message = await installer()
        resultat["installation"] = message
        if regles and not ok:
            return {"ok": False, "error": f"installation du remplacement impossible : {message}"}
    elif operation == "vider_journal":
        etat_navigateur["remplacements_journal"] = []
    elif operation != "journal":
        return {"ok": False, "error": f"opération inconnue : {operation}"}
    resultat["regles"] = len(etat_navigateur.get("remplacements") or [])
    resultat["journal"] = list(etat_navigateur.get("remplacements_journal") or [])
    return {"ok": True, "result": resultat}


# --- Chrome / Vivaldi (nodriver, CDP Fetch) ----------------------------------

async def _ro_send(page, commande):
    return await asyncio.wait_for(page.send(commande), timeout=_RO_TIMEOUT_CDP_S)


def _ro_glob_cdp(motif: str) -> str:
    """Motif littéral -> pattern d'URL CDP (« * » et « ? » sont des jokers, « \\ » l'échappement)."""
    protege = motif.replace("\\", "\\\\").replace("*", "\\*").replace("?", "\\?")
    return "*" + protege + "*"


def _ro_fabriquer_handler(page, etat_navigateur: dict):
    async def _sur_requete_pausee(event):
        rid = event.request_id
        etape_reponse = (event.response_status_code is not None) or (event.response_error_reason is not None)

        async def _continuer():
            # Ne JAMAIS laisser une requête suspendue.
            try:
                if etape_reponse:
                    try:
                        await _ro_send(page, cdp.fetch.continue_response(rid))
                    except Exception:  # noqa: BLE001 -- vieux CDP : repli
                        await _ro_send(page, cdp.fetch.continue_request(rid))
                else:
                    await _ro_send(page, cdp.fetch.continue_request(rid))
            except Exception as exc:  # noqa: BLE001 -- déjà résolue / onglet fermé
                log.debug(f"[remplacement] continuation impossible ({exc!r})")

        url = ""
        try:
            url = str(event.request.url)
            regles = etat_navigateur.get("remplacements") or []
            idx, regle = (None, None)
            code = event.response_status_code
            if etape_reponse and regles and event.response_error_reason is None:
                idx, regle = _ro_trouver_regle(url, regles)
            if regle is None or code is None or code in (204, 304) or 300 <= code < 400:
                await _continuer()
                return
            corps = None
            if "corps_base64" not in regle:
                corps_txt, est_b64 = await _ro_send(page, cdp.fetch.get_response_body(rid))
                corps = base64.b64decode(corps_txt) if est_b64 else corps_txt.encode("utf-8", "surrogateescape")
            nouveau, stats = _ro_transformer(regle, corps)
            entetes = [h for h in (event.response_headers or []) if str(h.name).lower() not in _RO_ENTETES_A_RETIRER]
            if regle.get("content_type"):
                entetes = [h for h in entetes if str(h.name).lower() != "content-type"]
                entetes.append(cdp.fetch.HeaderEntry(name="Content-Type", value=regle["content_type"]))
            code_servi = 200 if "corps_base64" in regle else code
            await _ro_send(page, cdp.fetch.fulfill_request(
                rid, response_code=code_servi, response_headers=entetes,
                body=base64.b64encode(nouveau).decode("ascii"),
                response_phrase=(event.response_status_text or None),
            ))
            _ro_journaliser(etat_navigateur, url=url[:300], regle=idx, ok=True, **stats)
            log.info(f"[remplacement] {url[:160]} : règle {idx} appliquée ({stats.get('avant')} -> {stats.get('apres')} octets)")
        except Exception as exc:  # noqa: BLE001 -- l'original est servi tel quel
            _ro_journaliser(etat_navigateur, url=url[:300], ok=False, erreur=repr(exc))
            log.warning(f"[remplacement] échec sur {url[:160]} ({exc!r}) : original servi tel quel")
            await _continuer()

    return _sur_requete_pausee


async def _ro_synchroniser_page(page, etat_navigateur: dict) -> tuple:
    """Idempotent. Aligne l'interception de CET onglet sur les règles courantes (à appeler AVANT chaque navigation).
    Retourne (ok, message) ; ne lève jamais."""
    regles = etat_navigateur.get("remplacements") or []
    signature_posee = getattr(page, "__autoniax_ro_sig__", None)
    if not regles and signature_posee is None:
        return True, "aucune règle"
    try:
        if not regles:
            await _ro_send(page, cdp.fetch.disable())
            setattr(page, "__autoniax_ro_sig__", None)
            return True, "interception retirée"
        signature = json.dumps([[r["motif"], bool(r.get("regex"))] for r in regles])
        if signature_posee == signature:
            return True, "déjà installé"
        if not getattr(page, "__autoniax_ro_handler__", False):
            page.add_handler(cdp.fetch.RequestPaused, _ro_fabriquer_handler(page, etat_navigateur))
            setattr(page, "__autoniax_ro_handler__", True)
        if any(r.get("regex") for r in regles):
            globs = ["*"]
        else:
            globs = list(dict.fromkeys(_ro_glob_cdp(r["motif"]) for r in regles))
        motifs = [cdp.fetch.RequestPattern(url_pattern=g, request_stage=cdp.fetch.RequestStage.RESPONSE) for g in globs]
        await _ro_send(page, cdp.fetch.enable(patterns=motifs))
        # Meilleur effort : sans cache HTTP, la ressource repasse forcément par le réseau (donc par l'interception).
        try:
            await _ro_send(page, cdp.network.enable())
            await _ro_send(page, cdp.network.set_cache_disabled(True))
        except Exception as exc:  # noqa: BLE001
            log.debug(f"[remplacement] cache non désactivé ({exc!r})")
        setattr(page, "__autoniax_ro_sig__", signature)
        log.info(f"[remplacement] interception posée sur l'onglet : {globs}")
        return True, "installé"
    except Exception as exc:  # noqa: BLE001
        log.warning(f"[remplacement] installation sur l'onglet échouée ({exc!r})")
        return False, repr(exc)


# --- Camoufox / CloakBrowser (Playwright) ------------------------------------

async def camoufox_installer_remplacement_ressources(context, etat_navigateur: dict) -> tuple:
    """Idempotent. Pose UNE route de contexte dont le prédicat ne retient que les URL couvertes par une règle
    (lues À CHAQUE requête : changer les règles ne demande aucune réinstallation). Retourne (ok, message)."""
    if etat_navigateur.get("_route_remplacement_installee"):
        return True, "déjà installé"

    def _predicat(url) -> bool:
        try:
            return _ro_trouver_regle(str(url), etat_navigateur.get("remplacements"))[1] is not None
        except Exception:  # noqa: BLE001
            return False

    async def _remplacer(route):
        url = ""
        try:
            url = str(route.request.url)
            idx, regle = _ro_trouver_regle(url, etat_navigateur.get("remplacements"))
            if regle is None:
                await route.fallback()
                return
            if "corps_base64" in regle:
                nouveau, stats = _ro_transformer(regle, None)
                import mimetypes as _mt
                type_mime = regle.get("content_type") or _mt.guess_type(url.split("?", 1)[0])[0] or "application/octet-stream"
                await route.fulfill(status=200, body=nouveau,
                                    headers={"content-type": type_mime, "access-control-allow-origin": "*"})
            else:
                reponse = await route.fetch()
                code = reponse.status
                if code in (204, 304) or 300 <= code < 400:
                    await route.fulfill(response=reponse)
                    return
                corps = await reponse.body()
                nouveau, stats = _ro_transformer(regle, corps)
                entetes = {k: v for k, v in reponse.headers.items() if k.lower() not in _RO_ENTETES_A_RETIRER}
                if regle.get("content_type"):
                    entetes = {k: v for k, v in entetes.items() if k.lower() != "content-type"}
                    entetes["content-type"] = regle["content_type"]
                await route.fulfill(response=reponse, body=nouveau, headers=entetes)
            _ro_journaliser(etat_navigateur, url=url[:300], regle=idx, ok=True, **stats)
            log.info(f"[camoufox][remplacement] {url[:160]} : règle {idx} appliquée ({stats.get('avant')} -> {stats.get('apres')} octets)")
        except Exception as exc:  # noqa: BLE001 -- l'original est servi tel quel
            _ro_journaliser(etat_navigateur, url=url[:300], ok=False, erreur=repr(exc))
            log.warning(f"[camoufox][remplacement] échec sur {url[:160]} ({exc!r}) : original servi tel quel")
            try:
                await route.fallback()
            except Exception:  # noqa: BLE001 -- route déjà résolue
                pass

    try:
        await context.route(_predicat, _remplacer)
        etat_navigateur["_route_remplacement_installee"] = True
        log.info("[camoufox][remplacement] route de remplacement installée sur le contexte")
        return True, "installé"
    except Exception as exc:  # noqa: BLE001
        log.warning(f"[camoufox][remplacement] installation échouée ({exc!r})")
        return False, repr(exc)
