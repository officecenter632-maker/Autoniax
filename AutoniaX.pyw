        self.client_serveur_t.envoi_batch_projet_demarre.connect(
            reseau_screen.projets_distribues_screen.sur_envoi_demande_batch
        )
        self.client_serveur_t.envoi_batch_echec.connect(
            lambda id_batch_distribue, id_projet_batch, message: self._afficher_message_statut_reseau(
                False, f"Batch interrompu à '{id_projet_batch}' : {message}",
            )
