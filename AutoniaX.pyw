# CORRECTIF (demande explicite utilisateur -- 5 profils isolés qui
# devraient tourner en parallèle s'exécutaient en réalité en SÉRIE, un
# lot de 5 x ~53s prenant ~4min25s au lieu de ~53s) : l'ancien
# _verrou_redirection_stdout_global (threading.Lock global, retenu
# pendant tout exec()) empêchait précisément ce chevauchement --
# nécessaire tant que contextlib.redirect_stdout/redirect_stderr
# mutaient sys.stdout/sys.stderr au niveau du PROCESS ENTIER (partagé
# par tous les threads), mais au prix de sérialiser complètement les
# _exec_thread de profils isolés différents (cf. ancien commentaire
# ci-dessous, conservé pour l'historique du bug initial qu'il visait).
#
# NOUVELLE APPROCHE : un flux "routeur" (_FluxStdoutParThread) posé
# UNE SEULE FOIS comme sys.stdout/sys.stderr pour toute la durée du
# process (jamais retiré/remplacé après coup, contrairement à
# contextlib.redirect_stdout qui le fait à chaque with) -- chaque
# write() consulte threading.current_thread() et route vers le
# tampon io.StringIO ENREGISTRÉ pour CE thread précis (dict thread ->
# tampon, protégé par un verrou COURT qui ne protège QUE l'accès au
# dict lui-même, jamais toute la durée de exec()). Élimine le
# mélange de sorties entre profils SANS sérialiser leur exécution :
# plusieurs _exec_thread peuvent désormais tourner en vrai parallèle,
# chacun écrivant dans son propre tampon.
#
# ANCIEN COMMENTAIRE (bug initial que le verrou global visait à
# corriger, cf. contexte ci-dessus toujours valable) -- BUGFIX (mode
# réseau/clone, plusieurs profils exécutés en parallèle sur le même
# sAutoniax) -- contextlib.redirect_stdout/redirect_stderr mutent
# sys.stdout/sys.stderr au niveau du PROCESS ENTIER, pas par thread.
# Quand plusieurs _exec_thread (un par session, chacun lancé via
# loop.run_in_executor sur un thread séparé du pool par défaut)
# tournent en parallèle, leurs `with redirect_stdout(...)` se
# chevauchaient et s'écrasaient mutuellement : le print() d'un thread
# pouvait finir capturé dans le buffer d'un AUTRE thread, dont le
# contenu était ensuite routé vers le mauvais session_id (symptôme
# observé : une sortie contenant plusieurs "True" accumulés dès la
# toute première exécution d'un profil).
class _FluxStdoutParThread:
    """Remplace sys.stdout (ou sys.stderr) UNE SEULE FOIS pour tout le
    process. write()/flush() routent vers le tampon io.StringIO
    enregistré pour le thread appelant (cf. .capturer_dans(tampon)/
    .relacher() ci-dessous), ou vers le flux ORIGINAL (celui capturé à
    la construction, jamais un self.original qui pointerait sur une
    autre instance de ce même routeur en cas d'imbrication) si aucun
    tampon n'est enregistré pour ce thread -- un print() de code qui ne
    tourne dans AUCUN _exec_thread (ex. logs internes d'AutoniaX lui-
    même) continue donc de s'afficher normalement, jamais avalé.

    Le verrou ne protège QUE la lecture/écriture du dict lui-même
    (opération O(1) quasi instantanée), jamais la durée de exec() --
    c'est précisément ce qui restaure le parallélisme réel entre
    threads par rapport à l'ancien threading.Lock tenu pendant tout
    exec()."""

    def __init__(self, flux_original):
        self._flux_original = flux_original
        self._tampons_par_thread: dict[int, "io.StringIO"] = {}
        self._verrou_dict = threading.Lock()

    def capturer_dans(self, tampon: "io.StringIO"):
        with self._verrou_dict:
            self._tampons_par_thread[threading.get_ident()] = tampon

    def relacher(self):
        with self._verrou_dict:
            self._tampons_par_thread.pop(threading.get_ident(), None)

    def _tampon_courant(self):
        with self._verrou_dict:
            return self._tampons_par_thread.get(threading.get_ident())

    def write(self, texte: str) -> int:
        tampon = self._tampon_courant()
        return (tampon or self._flux_original).write(texte)

    def flush(self) -> None:
        tampon = self._tampon_courant()
        (tampon or self._flux_original).flush()

    # Quelques attributs/méthodes que du code tiers (ou exec() lui-même)
    # peut consulter sur sys.stdout -- délégués au flux ORIGINAL, jamais
    # au tampon (un isatty()/encoding par tampon n'aurait pas de sens).
    def isatty(self) -> bool:
        return self._flux_original.isatty()

    @property
    def encoding(self):
        return getattr(self._flux_original, "encoding", "utf-8")


_stdout_par_thread = _FluxStdoutParThread(sys.stdout)
_stderr_par_thread = _FluxStdoutParThread(sys.stderr)
sys.stdout = _stdout_par_thread
sys.stderr = _stderr_par_thread


@contextlib.contextmanager
def _capturer_stdout_stderr_thread_courant(tampon: "io.StringIO", capturer_stderr: bool = True):
    """Remplace contextlib.redirect_stdout(tampon)[, redirect_stderr
    (tampon)] partout où plusieurs _exec_thread peuvent tourner en
    parallèle (cf. docstring de _FluxStdoutParThread ci-dessus) --
    enregistre `tampon` pour LE THREAD APPELANT UNIQUEMENT, le temps du
    bloc `with`, puis le retire dans un `finally` (jamais laissé
    enregistré après une exception, sans quoi un thread du pool réutilisé
    pour une AUTRE tâche plus tard continuerait d'écrire dans ce tampon
    obsolète)."""
    _stdout_par_thread.capturer_dans(tampon)
    if capturer_stderr:
        _stderr_par_thread.capturer_dans(tampon)
    try:
        yield
    finally:
        _stdout_par_thread.relacher()
        if capturer_stderr:
            _stderr_par_thread.relacher()


