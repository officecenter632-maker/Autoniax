def decoder_image_b64(image_b64: str) -> Optional[QImage]:
    """Décode une image base64 (format déjà utilisé par le flux 'frame' et
    par 'capture_propre', cf. _demander_capture_propre) en QImage. Factorise
    le pattern déjà présent dans _sur_frame_recue (InstanceApercuScreen et
    DashboardScreen) -- retourne None sur toute erreur (base64 invalide,
    format image non décodable), jamais d'exception laissée remonter."""
    try:
        donnees = base64.b64decode(image_b64)
    except Exception:
        return None
    image = QImage()
    if not image.loadFromData(QByteArray(donnees)) or image.isNull():
        return None
    return image


# PATCH (throttle log compression, cf. docstring de
# ClientServeurT.DELAI_THROTTLE_LOGS_CAPTURE_SECONDES -- même valeur de
# 10s, dupliquée ICI en constante propre plutôt que référencée depuis
# ClientServeurT : cette fonction utilitaire est définie tout en haut du
# fichier, bien avant la classe, la référencer directement créerait une
# dépendance de lecture fragile vers une zone très éloignée du fichier
# pour gagner uniquement une ligne) -- état de throttle GLOBAL au module
# (pas par instance) : ce log résume un ratio de compression générique,
# pas un flux par sAutoniax distinct comme envoyer_capture, une seule
# ligne périodique suffit pour tout le process, qu'il y ait une ou
# plusieurs instances actives.
DELAI_THROTTLE_LOG_COMPRESSION_SECONDES = 10.0
_DERNIER_LOG_COMPRESSION = [0.0, 0]  # [timestamp dernier log, compte depuis]


def _compresser_capture_webp(image_b64_source: str, qualite: int = 80) -> str:
    """Reçoit une image encodée en base64 (PNG, format retourné par
    capture_propre côté instance) et la recompresse en WebP à la
    qualité demandée (PATCH -- demande explicite utilisateur : "il faut
    compresser en .webp 80 pourenct avant denvoyer", cf. mode sAutoniax
    -- ClientServeurT.envoyer_capture), retourne le nouveau base64.

    Réduit fortement la taille du message WebSocket envoyé au serveurT
    (une capture plein écran en PNG peut peser plusieurs Mo -- WebP
    qualité 80 est typiquement 5 à 10x plus léger pour une perte visuelle
    négligeable sur une capture d'écran, cf. cas d'usage "voir ce qui se
    passe", pas une préservation pixel-perfect).

    Défensif (même esprit que les autres blocs try/except de ce fichier,
    cf. import protégé de PILImage) : si Pillow est absent, OU si la
    compression échoue pour une raison quelconque, retourne l'image
    d'ORIGINE telle quelle (PNG non compressé) plutôt que de faire
    échouer tout l'envoi de la capture pour ce seul motif -- une capture
    plus lourde mais reçue vaut mieux qu'aucune capture du tout."""
    if not PILLOW_DISPONIBLE:
        log_captures.warning(
            "_compresser_capture_webp : Pillow indisponible (pip install pillow) -- "
            "capture envoyée en PNG non compressé."
        )
        return image_b64_source
    try:
        donnees_source = base64.b64decode(image_b64_source)
        with io.BytesIO(donnees_source) as buffer_entree:
            img = PILImage.open(buffer_entree)
            img.load()
            # WebP n'a pas de mode "RGBA" universellement accepté selon
            # le contenu source -- convertir en RGB perd la transparence,
            # mais une capture d'écran plein écran n'en a de toute façon
            # jamais (fond opaque du navigateur) donc rien n'est perdu
            # ici en pratique.
            if img.mode not in ("RGB", "RGBA"):
                img = img.convert("RGB")
            with io.BytesIO() as buffer_sortie:
                img.save(buffer_sortie, format="WEBP", quality=qualite)
                donnees_webp = buffer_sortie.getvalue()
        taille_avant, taille_apres = len(donnees_source), len(donnees_webp)
        # PATCH (demande explicite utilisateur : "remet le logs des ...
        # compresion dimage ... mais je veu que leur frequece daffichage
        # chute aussi drastiquement" -- réactivé en .info après avoir été
        # passé en .debug, cf. l'ancien commentaire ci-dessus resté pour
        # l'historique) -- THROTTLÉ à 10s (cf. _DERNIER_LOG_COMPRESSION en
        # tête de module) : compte les compressions effectuées depuis le
        # dernier log, n'affiche qu'un résumé une fois l'intervalle
        # écoulé, jamais une ligne par frame individuelle.
        maintenant = time.monotonic()
        _DERNIER_LOG_COMPRESSION[1] += 1
        if maintenant - _DERNIER_LOG_COMPRESSION[0] >= DELAI_THROTTLE_LOG_COMPRESSION_SECONDES:
            log_captures.info(
                f"_compresser_capture_webp : {_DERNIER_LOG_COMPRESSION[1]} compression(s) sur les "
                f"{DELAI_THROTTLE_LOG_COMPRESSION_SECONDES:.0f} dernières secondes -- "
                f"dernière = {taille_avant} -> {taille_apres} octets "
                f"(qualité={qualite}, ratio={taille_apres / taille_avant:.1%})"
            )
            _DERNIER_LOG_COMPRESSION[0] = maintenant
            _DERNIER_LOG_COMPRESSION[1] = 0
        return base64.b64encode(donnees_webp).decode("ascii")
    except Exception as e:
        log_captures.warning(f"_compresser_capture_webp : échec de compression ({e!r}) -- capture envoyée en PNG non compressé.")
        return image_b64_source


def bgr_vers_image_b64(image_bgr) -> Optional[str]:
    """Fonction INVERSE de decoder_image_b64/qimage_vers_bgr ci-dessus --
    encode un tableau numpy BGR (format cv2) en PNG puis base64 (str),
    prêt à être transporté sur le WebSocket (cf. Image.view(), AJOUT
    demande explicite utilisateur : "je veux que le terminal affiche
    aussi les images"). PNG choisi ici (pas WEBP, contrairement à
    _compresser_capture_webp) : ces images sont des screenshots PONCTUELS
    de zone/composant, généralement petits (surface détectée, pas plein
    écran) et affichés une seule fois dans un terminal -- la fidélité
    (PNG sans perte) prime sur la taille, contrairement au flux de rendu
    périodique plein écran où la bande passante répétée justifie une
    compression avec perte. Retourne None sur tout échec d'encodage
    (jamais d'exception laissée remonter) -- même convention défensive
    que decoder_image_b64."""
    try:
        ok, buffer_png = cv2.imencode(".png", image_bgr)
        if not ok:
            return None
        return base64.b64encode(buffer_png.tobytes()).decode("ascii")
    except Exception:
        return None


class Image:
    """AJOUT (demande explicite utilisateur : "quand on fait screenshot
    cest cese renvoyer un objet mage qui stoke le path et bon limage , et
    la mehtode view laffihce dans le terminal de la celelule") -- objet
    renvoyé par ComposantSingleExecutable.screenshot()/ZoneDetectee.
    screenshot() (cf. leurs docstrings, remplace l'ancien retour `str`
    nu) : porte à la fois le CHEMIN disque du PNG déjà écrit (`.chemin`,
    str -- même valeur qu'avant ce patch, pour compatibilité : tout code
    qui faisait `str(composant.screenshot())` ou l'utilisait comme
    chemin continue de fonctionner via __str__/__fspath__ ci-dessous) ET
    les données BGR déjà en mémoire (`.image_bgr`, tableau numpy cv2 --
    évite une relecture disque si le script veut retraiter l'image sans
    repasser par cv2.imread).

    .view() envoie cette image au TERMINAL du panneau de rendu réseau
    (cf. FenetreRenduTaskReseau/PanneauRenduInstance.ajouter_image_
    terminal) -- RÉSEAU SEULEMENT (décision explicite utilisateur), pas
    de version locale : lève RuntimeError si cette Image n'a pas été
    construite avec un contexte réseau valide (cf. _contexte_reseau,
    None en mode local -- ComposantSingleExecutable/ZoneDetectee y
    passent toujours None hors mode Task.mode_execution == "reseau",
    cf. leur docstring de construction)."""

    def __init__(self, chemin: str, image_bgr, _contexte_reseau: Optional[dict] = None):
        self.chemin = chemin
        self.image_bgr = image_bgr
        # _contexte_reseau : {"client_t": ClientServeurT, "session_id":
        # str, "id_pilote": str} -- injecté UNIQUEMENT côté sAutoniax
        # exécutant en mode réseau (cf. propagation depuis
        # _construire_composants_direct/InstanceExecutableDirecteCamoufox
        # jusqu'à ComposantSingleExecutable/ZoneDetectee, même canal que
        # `namespace` déjà propagé en cascade). None dans tous les autres
        # cas (mode local, ou objet construit hors exécution de script).
        self._contexte_reseau = _contexte_reseau

    def __repr__(self) -> str:
        return f"Image({self.chemin!r})"

    def __str__(self) -> str:
        # Compatibilité : du code déjà écrit qui traite le retour de
        # screenshot() comme une chaîne (ex: print(composant.screenshot()),
        # ou l'utilise dans une f-string) continue d'afficher le chemin,
        # comportement identique à l'ancien retour `str` nu.
        return self.chemin

    def __fspath__(self) -> str:
        # Compatibilité : permet aussi open(image)/Path(image)/toute API
        # acceptant un os.PathLike, sans que le script ait besoin d'écrire
        # image.chemin explicitement.
        return self.chemin

    def view(self):
        """Envoie cette image dans la sortie de la cellule de notebook
        (côté pilote, cf. TaskConfigScreen.sur_image_execution_reseau_
        recu) -- une entrée par appel, affichée au fil de l'eau à côté
        des lignes de log existantes (même esprit "en direct" que
        envoyer_notebook_distant_log). Lève RuntimeError si appelée en
        mode local (pas de contexte réseau à alimenter), si l'encodage
        échoue, OU si l'envoi WebSocket échoue silencieusement côté
        transport (cf. CORRECTIF ci-dessous -- avant ce correctif,
        aucune des deux (Image.view() ni ClientServeurT.envoyer_
        notebook_distant_image) ne vérifiait/ne logait quoi que ce soit
        en cas d'échec, donc un .view() qui ne s'affichait jamais côté
        pilote échouait de façon totalement invisible : ni exception, ni
        ligne de log, aucun signal permettant de diagnostiquer où
        l'image se perdait entre le sAutoniax et le pilote)."""
        if not self._contexte_reseau:
            raise RuntimeError(
                "Image.view() n'est disponible qu'en exécution réseau "
                "(Task.mode_execution == 'reseau') -- rien à afficher en mode local."
            )
        image_b64 = bgr_vers_image_b64(self.image_bgr)
        if image_b64 is None:
            raise RuntimeError(f"Échec d'encodage de l'image « {self.chemin} » pour l'affichage dans le terminal.")
        client_t = self._contexte_reseau.get("client_t")
        session_id = self._contexte_reseau.get("session_id")
        id_pilote = self._contexte_reseau.get("id_pilote")
        if client_t is None or not session_id or not id_pilote:
            raise RuntimeError("Image.view() : contexte réseau incomplet, impossible d'envoyer l'image.")
        # CORRECTIF (bug rapporté : "je ne vois aucune image affichée
        # dans la sortie de la cellule", aucune erreur ni côté script ni
        # dans les logs) -- log EXPLICITE avant l'envoi (permet de
        # confirmer, dans les logs sAutoniax, que .view() a bien été
        # appelée avec un contexte réseau complet -- sans ce log, rien
        # ne le distinguait d'un .view() jamais atteint par le script).
        log.info(
            f"[sAutoniax] Image.view() : envoi image (session={session_id}, "
            f"id_pilote={id_pilote}, {len(image_b64)} caractère(s) b64)."
        )
        ok = client_t.envoyer_notebook_distant_image(session_id, id_pilote, image_b64)
        if not ok:
            raise RuntimeError(
                "Image.view() : échec d'envoi (connexion serveurT indisponible/fermée à cet "
                "instant) -- l'image n'a pas pu être transmise au pilote."
            )


def qimage_vers_bgr(image: QImage):
    """Convertit une QImage en tableau numpy BGR (format attendu par cv2)."""
    image = image.convertToFormat(QImage.Format_RGB888)
    largeur, hauteur = image.width(), image.height()
    ptr = image.bits()
    tampon = np.array(ptr).reshape(hauteur, image.bytesPerLine())[:, : largeur * 3]
    rgb = tampon.reshape(hauteur, largeur, 3)
    return cv2.cvtColor(rgb, cv2.COLOR_RGB2BGR)


def _redimensionner_template(template_gray, echelle: float):
    # PATCH (retour utilisateur : recherche à l'échelle originale
    # uniquement) -- évite un cv2.resize() en pure perte quand echelle=1.0
    # (seul cas appelé désormais par rechercher_composant) : le template
    # garde sa taille d'origine, resize ne ferait que recopier l'image
    # pour rien à chaque appel de _detecter().
    if echelle == 1.0:
        return template_gray
    h, l = template_gray.shape[:2]
    nouvelle_l, nouvelle_h = max(1, round(l * echelle)), max(1, round(h * echelle))
    interpolation = cv2.INTER_AREA if echelle < 1.0 else cv2.INTER_CUBIC
    return cv2.resize(template_gray, (nouvelle_l, nouvelle_h), interpolation=interpolation)


def _meilleure_correspondance(image_gray, template_gray, echelle: float, flou_noyau: int = 0,
                               seuil: Optional[float] = None, delta_conflit: float = 0.0,
                               priorite: str = "mostTop"):
    """Fait un matchTemplate (NCC) à une échelle de template donnée.
    Retourne (score, x, y, largeur, hauteur) ou None si le template
    redimensionné dépasse la taille de l'image écran à cette échelle.

    CONTEXTE (bug historique constaté : un composant capturé à une
    résolution de fenêtre donnée matchait bien moins bien -- score
    chutant de ~0.98 à ~0.77 -- une fois la fenêtre redimensionnée, alors
    que le contenu visuel de la carte était identique à l'oeil et à la
    même taille en pixels dans les deux captures. Diagnostic confirmé par
    mesure isolée par zone (icône ~0.97, titre ~0.97, fond ~0.97,
    PARAGRAPHE DE TEXTE ~0.76) : le coupable est le texte fin (petite
    police, traits de 2-3px), dont le rendu anti-aliasé se repositionne
    de quelques dixièmes de pixel selon la résolution de la fenêtre / le
    pipeline de capture -- un effet de rendu, pas un changement de
    contenu ni d'échelle. TM_CCOEFF_NORMED compare pixel à pixel et est
    donc très sensible à ce bruit de sous-pixel sur les zones de texte
    fin. Un flou gaussien léger appliqué à l'image ET au template juste
    avant le matchTemplate absorbe ce bruit sans changer la structure ni
    la position de la carte -- testé sur des captures réelles du bug,
    un noyau 9x9 a fait remonter un score de 0.76 à 0.91 avec LA POSITION
    DÉTECTÉE RESTE IDENTIQUE au pixel près.

    PATCH (demande explicite utilisateur, cf. Composant.flou_noyau) :
    CE FLOU N'EST PLUS APPLIQUÉ PAR DÉFAUT. flou_noyau=0 (défaut) =
    matchTemplate brut, sur les pixels d'origine, sans aucun flou --
    comportement le plus prévisible, à privilégier tant qu'aucun besoin
    précis ne justifie d'y toucher. flou_noyau > 0 (réglé au cas par cas
    par l'utilisateur, composant par composant) active le flou avec ce
    noyau -- DOIT être impair (3, 5, 7, 9, 11...), exigence de
    cv2.GaussianBlur ; une valeur paire est silencieusement incrémentée
    de 1 pour rester valide plutôt que de faire planter la détection.
    Un flou trop large peut rendre deux composants visuellement proches
    (icônes qui ne diffèrent que par un détail fin) indiscernables --
    c'est pourquoi ce n'est jamais activé par défaut, seulement sur
    décision explicite pour un composant précis qui en a besoin.

    PATCH (détection de conflit, cf. Composant.delta_conflit, demande
    explicite utilisateur) -- seuil/delta_conflit/priorite optionnels
    (défauts inertes : seuil=None ou delta_conflit=0.0 -> AUCUNE
    recherche de second candidat, comportement strictement identique à
    avant ce patch, cf. plus bas). Quand seuil ET delta_conflit sont
    fournis (cf. rechercher_composant) :

    COURT-CIRCUIT (décision explicite utilisateur après discussion coût
    perf : "pardefaut on vas dabord juste elnever 1 seul de plus, si sa
    echoue sa veut dire que tout le reste ne sert a rien, si cest
    positif avant que on contineu a extrait") -- le second candidat
    n'est cherché QUE si (1) delta_conflit > 0 ET (2) le premier
    (meilleur) score franchit déjà `seuil`. Si le premier échoue, on
    s'arrête immédiatement comme avant : chercher un second candidat ne
    servirait à rien puisque même le meilleur ne passe pas le seuil --
    donc AUCUN coût ajouté sur le cas le plus fréquent d'une boucle de
    pilotage (.visible() qui échoue en boucle en attendant qu'un élément
    apparaisse). Dans le cas positif, un SEUL minMaxLoc supplémentaire
    est fait (masquage de la zone du meilleur candidat sur la carte déjà
    calculée, même technique que rechercher_candidats_multiples, mais
    UNE seule itération -- jamais une boucle de N candidats, réservée au
    mode test) : si ce second score franchit aussi `seuil` ET que l'écart
    avec le premier est <= delta_conflit, les deux candidats sont jugés
    'en conflit' -- priorite (mostTop/mostBottom/mostLeft/mostRight)
    tranche alors entre les deux positions, exactement comme le
    ferait la logique de priorite_selection historique en cas d'égalité."""
    template_redim = _redimensionner_template(template_gray, echelle)
    th, tl = template_redim.shape[:2]
    ih, il = image_gray.shape[:2]
    if th > ih or tl > il:
        return None
    if flou_noyau and flou_noyau > 0:
        k = flou_noyau if flou_noyau % 2 == 1 else flou_noyau + 1
        image_cmp = cv2.GaussianBlur(image_gray, (k, k), 0)
        template_cmp = cv2.GaussianBlur(template_redim, (k, k), 0)
    else:
        image_cmp = image_gray
        template_cmp = template_redim
    carte = cv2.matchTemplate(image_cmp, template_cmp, cv2.TM_CCOEFF_NORMED)
    _, score_max, _, position_max = cv2.minMaxLoc(carte)
    x, y = position_max

    # Recherche du second candidat -- UNIQUEMENT si le premier a déjà
    # franchi le seuil ET que delta_conflit est actif (cf. docstring
    # ci-dessus pour le raisonnement complet du court-circuit).
    if delta_conflit and delta_conflit > 0 and seuil is not None and score_max >= seuil:
        carte_travail = carte.copy()
        x0, x1 = max(0, x - tl // 2), min(carte_travail.shape[1], x + tl // 2 + 1)
        y0, y1 = max(0, y - th // 2), min(carte_travail.shape[0], y + th // 2 + 1)
        carte_travail[y0:y1, x0:x1] = -1.0
        _, score_2, _, position_2 = cv2.minMaxLoc(carte_travail)
        if score_2 >= seuil and (score_max - score_2) <= delta_conflit:
            x2, y2 = position_2
            x, y = _trancher_conflit_position(priorite, (x, y), (x2, y2))
            # Le score rapporté reste celui du candidat RETENU après
            # arbitrage (pas forcément le score_max d'origine) -- si
            # priorite choisit le second point, son score est celui qui
            # doit être comparé au seuil par l'appelant, pas l'ancien.
            score_max = score_max if (x, y) == position_max else score_2

    return (float(score_max), x, y, tl, th)


def _trancher_conflit_position(priorite: str, position_a: tuple, position_b: tuple) -> tuple:
    """Départage deux positions (x, y) en conflit selon priorite
    (mostTop/mostBottom/mostLeft/mostRight, cf. PRIORITES_SELECTION) --
    même sémantique que la logique de priorite_selection historique
    (cf. son introduction pour départager une égalité stricte de score),
    réutilisée ici pour départager un conflit détecté via delta_conflit."""
    xa, ya = position_a
    xb, yb = position_b
    if priorite == "mostTop":
        return position_a if ya <= yb else position_b
    if priorite == "mostBottom":
        return position_a if ya >= yb else position_b
    if priorite == "mostLeft":
        return position_a if xa <= xb else position_b
    if priorite == "mostRight":
        return position_a if xa >= xb else position_b
    return position_a


def _score_orb(patch_a, patch_b) -> Optional[float]:
    """Score de similarité par points-clés ORB (robuste à l'échelle/rotation
    fine). Retourne None si trop peu de points-clés détectés (composant
    uniforme/peu texturé) pour laisser la bascule SSIM prendre le relais."""
    orb = cv2.ORB_create(nfeatures=500)
    kp1, desc1 = orb.detectAndCompute(patch_a, None)
    kp2, desc2 = orb.detectAndCompute(patch_b, None)
    if desc1 is None or desc2 is None or len(kp1) < 6 or len(kp2) < 6:
        return None
    bf = cv2.BFMatcher(cv2.NORM_HAMMING, crossCheck=True)
    matches = bf.match(desc1, desc2)
    if not matches:
        return 0.0
    bonnes = [m for m in matches if m.distance < 64]
    return len(bonnes) / max(len(kp1), len(kp2))


def _score_ssim(patch_a, patch_b) -> float:
    """SSIM implémenté directement (numpy/cv2) pour éviter la dépendance
    scikit-image — bascule utilisée quand ORB manque de points-clés."""
    if patch_a.shape != patch_b.shape:
        patch_b = cv2.resize(patch_b, (patch_a.shape[1], patch_a.shape[0]))
    a = patch_a.astype(np.float64)
    b = patch_b.astype(np.float64)
    c1, c2 = (0.01 * 255) ** 2, (0.03 * 255) ** 2
    mu_a = cv2.GaussianBlur(a, (11, 11), 1.5)
    mu_b = cv2.GaussianBlur(b, (11, 11), 1.5)
    mu_a2, mu_b2, mu_ab = mu_a * mu_a, mu_b * mu_b, mu_a * mu_b
    sigma_a2 = cv2.GaussianBlur(a * a, (11, 11), 1.5) - mu_a2
    sigma_b2 = cv2.GaussianBlur(b * b, (11, 11), 1.5) - mu_b2
    sigma_ab = cv2.GaussianBlur(a * b, (11, 11), 1.5) - mu_ab
    carte_ssim = ((2 * mu_ab + c1) * (2 * sigma_ab + c2)) / (
        (mu_a2 + mu_b2 + c1) * (sigma_a2 + sigma_b2 + c2)
    )
    return float(carte_ssim.mean())


class DetectionAmbigueError(Exception):
    """Ambiguïté persistante après double validation ORB/SSIM (point 10) :
    remontée explicite, jamais de choix arbitraire."""


def rechercher_composant(image_ecran_bgr, template_bgr, seuil: float, priorite: str = "mostTop", flou_noyau: int = 0,
                          delta_conflit: float = 0.0, code_filtre: str = ""):
    """Recherche un composant dans une capture d'écran, à l'échelle
    ORIGINALE UNIQUEMENT (point 10).

    flou_noyau : transmis tel quel à _meilleure_correspondance (cf. sa
    docstring et Composant.flou_noyau) -- 0 (défaut) = aucun flou.

    PATCH (demande explicite utilisateur : "enleve le balayage sur
    plusieurs echelles, je ne veux plus compliquer, on recherche tout
    simplement a echelle original, rien dautre de plus") -- AVANT ce
    patch, cette fonction testait jusqu'à 5 paliers DPI (PALIERS_DPI)
    puis, en secours, 31 paliers de balayage fin (BALAYAGE_FIN), chacun
    via un cv2.matchTemplate complet sur l'image plein écran -- jusqu'à
    36 passages par variante de composant. log_detection (cf. patch
    précédent) a confirmé que cette recherche multi-échelle consommait
    6 à 7s à elle seule sur chaque _detecter() (94-97% du temps total),
    contre 0.2-0.3s pour l'aller-retour réseau. Un seul test à l'échelle
    1.0 -- ni PALIERS_DPI, ni BALAYAGE_FIN, ni la validation croisée
    ORB/SSIM : ce chemin est donc supprimé avec le reste, pas seulement
    désactivé.

    AJOUT (demande explicite utilisateur, cf. ComposantSingle.code_filtre
    et executer_filtre_composant_single) : code_filtre="" (défaut) =
    AUCUN filtre, comportement historique intégralement inchangé
    (comparaison directe des pixels d'origine, exactement comme avant ce
    patch). Non vide -- appliqué à IMAGE_ECRAN_BGR ET TEMPLATE_BGR
    (SÉPARÉMENT, avec exactement le même code les deux fois -- cf.
    docstring de executer_filtre_composant_single) AVANT la conversion en
    niveaux de gris ci-dessous : les deux images filtrées remplacent
    alors les originales pour tout le reste de cette fonction (flou_noyau
    éventuel, matchTemplate, seuil...), inchangé par ailleurs. Une
    DetectionFiltreComposantSingleError levée par le filtre (code invalide
    ou variable 'resultat' absente/mal formée) remonte TELLE QUELLE à
    l'appelant plutôt que d'être avalée -- un filtre cassé doit se
    signaler clairement, jamais retomber silencieusement sur une
    comparaison non filtrée qui masquerait le problème.

    Retourne un TUPLE (resultat, meilleur_score_brut) :
      - resultat : dict {"x","y","largeur","hauteur","score","echelle"}
        (echelle toujours 1.0) si le score franchit le seuil de
        confiance, sinon None.
      - meilleur_score_brut : le score obtenu à l'échelle 1.0, seuil
        franchi ou non (0.0 si le template est plus grand que l'image
        écran -- cf. _meilleure_correspondance). Permet d'informer
        l'utilisateur du taux de correspondance le plus proche même
        quand rien n'est détecté, comme avant ce patch.

    priorite : REDEVENU ACTIF (PATCH, cf. Composant.delta_conflit,
    demande explicite utilisateur) -- uniquement quand delta_conflit > 0
    ET qu'un second candidat "en conflit" est détecté par
    _meilleure_correspondance (cf. sa docstring pour le court-circuit :
    le second candidat n'est même cherché QUE si le premier franchit
    déjà seuil, donc AUCUN coût ajouté quand delta_conflit vaut 0, comme
    avant ce patch). Avec delta_conflit=0.0 (défaut de Composant), un
    seul palier ne peut produire qu'un seul maximum global via
    cv2.minMaxLoc, donc priorite reste sans effet, exactement comme
    avant ce patch."""
    if code_filtre:
        image_ecran_bgr = executer_filtre_composant_single(image_ecran_bgr, code_filtre)
        template_bgr = executer_filtre_composant_single(template_bgr, code_filtre)

    # cv2.cvtColor exige une image à 3 canaux pour BGR2GRAY -- un filtre
    # qui renvoie déjà une image niveaux de gris (2D, un seul canal, cas
    # d'usage courant pour un masque/seuillage) est accepté tel quel sans
    # nouvelle conversion, plutôt que de planter sur un filtre parfaitement
    # légitime qui aurait déjà fait ce travail lui-même.
    image_gray = image_ecran_bgr if image_ecran_bgr.ndim == 2 else cv2.cvtColor(image_ecran_bgr, cv2.COLOR_BGR2GRAY)
    template_gray = template_bgr if template_bgr.ndim == 2 else cv2.cvtColor(template_bgr, cv2.COLOR_BGR2GRAY)

    debut = _horloge()
    r = _meilleure_correspondance(image_gray, template_gray, 1.0, flou_noyau,
                                   seuil=seuil, delta_conflit=delta_conflit, priorite=priorite)
    duree = _horloge() - debut
    if duree > 0.3:
        log_detection.info(f"rechercher_composant() : échelle 1.0 -- {duree:.3f}s (lent)")

    if r is None:
        # Template plus grand que l'image écran à l'échelle 1.0 --
        # jamais détectable, aucun score à rapporter.
        return None, 0.0

    score, x, y, l, h = r
    if score < seuil:
        return None, score

    return {"x": x, "y": y, "largeur": l, "hauteur": h, "score": score, "echelle": 1.0}, score


def rechercher_composant_multi_variantes(image_ecran_bgr, templates_avec_variantes: list,
                                          seuil: Optional[float] = None,
                                          priorite: Optional[str] = None,
                                          flou_noyau: Optional[int] = None,
                                          delta_conflit: Optional[float] = None,
                                          code_filtre: Optional[str] = None):
    """Recherche un composant à PLUSIEURS VARIANTES dans une capture d'écran :
    teste chaque template (une image = une variante) indépendamment via
    rechercher_composant, et retient le résultat au meilleur score. Le
    composant est considéré détecté si AU MOINS UNE variante franchit le
    seuil de confiance (voir Composant.variantes).

    PATCH (demande explicite utilisateur : "enleve le balayage sur
    plusieurs echelles ... on recherche tout simplement a echelle
    original") -- chaque variante est maintenant testée à l'échelle 1.0
    UNIQUEMENT (cf. docstring de rechercher_composant pour le détail
    complet) : plus de paliers DPI, plus de balayage fin, plus de
    validation croisée ORB/SSIM au sein d'un même test -- ces mécanismes
    n'avaient de sens qu'avec plusieurs échelles concurrentes.

    PATCH (SPEC_GLOBALE_AutoniaX.md, Partie A §3.2 -- demande explicite
    utilisateur : paramètres de détection relatifs à CHAQUE variante) --
    templates_avec_variantes remplace templates_bgr : désormais une liste
    de tuples (image_bgr, Variante), cf. charger_templates_bgr. CHAQUE
    variante teste rechercher_composant avec SES PROPRES seuil_confiance/
    flou_noyau/delta_conflit/code_filtre/priorite_selection
    (Variante.<champ>), plus un seul jeu de valeurs partagé par toutes les
    variantes -- le conflit est recherché indépendamment DANS chaque
    variante, pas ENTRE variantes différentes (une variante "thème sombre"
    qui matche par ailleurs n'est jamais un conflit avec la variante
    "thème clair" : ce sont deux candidats légitimes du MÊME composant,
    pas deux occurrences concurrentes -- cf. la sélection au meilleur
    score juste en dessous, inchangée).

    RÉTROCOMPATIBILITÉ (appelant pas encore migré, ou test unitaire
    existant qui passerait encore list[image_bgr] nue) : les paramètres
    seuil/priorite/flou_noyau/delta_conflit/code_filtre deviennent
    optionnels (None par défaut) -- si un élément de
    templates_avec_variantes n'est PAS un tuple (image_bgr, Variante) mais
    une image nue, ces paramètres PASSÉS EN ARGUMENT À CETTE FONCTION
    servent alors de repli, avec les mêmes défauts qu'avant ce patch
    (seuil=0.9, priorite="mostTop", flou_noyau=0, delta_conflit=0.0,
    code_filtre="") -- comportement IDENTIQUE à avant ce patch pour ce cas
    précis.

    Retourne un TUPLE (resultat, meilleur_score_brut) :
      - resultat : dict (même format que rechercher_composant, plus la clé
        "index_variante" indiquant quelle variante a matché) si détecté,
        sinon None.
      - meilleur_score_brut : le plus haut score BRUT rencontré toutes
        variantes confondues, seuil franchi ou non -- pour informer sur le
        "taux de correspondance le plus proche" même en cas d'échec total.

    POINT DE VIGILANCE SÉMANTIQUE -- "au moins une variante détectée
    suffit" (cf. docstring de classe ComposantSingle) reste vrai, mais le
    seuil appliqué à chaque variante est maintenant LE SIEN PROPRE, pas un
    seuil unique. Une variante avec un seuil_confiance personnel plus haut
    peut donc désormais être écartée alors qu'une autre variante, avec un
    score brut inférieur mais un seuil personnel plus bas, "gagne" --
    CE N'EST PAS UN BUG, c'est la conséquence directe et voulue de rendre
    le seuil réglable par variante.

    DetectionAmbigueError n'est plus levée par rechercher_composant (un
    seul palier ne peut plus produire d'ambiguïté multi-candidats), donc
    ce chemin ne se déclenche plus ici -- conservé tel quel (except
    inoffensif) pour ne pas modifier le contrat de cette fonction ni ses
    appelants en aval."""
    meilleur_resultat = None
    meilleur_index = -1
    meilleur_score_brut_global = 0.0
    ambiguite_rencontree = None

    for i, item in enumerate(templates_avec_variantes):
        if isinstance(item, tuple) and len(item) == 2 and isinstance(item[1], Variante):
            template_bgr, variante = item
            seuil_v = variante.seuil_confiance
            priorite_v = variante.priorite_selection
            flou_noyau_v = variante.flou_noyau
            delta_conflit_v = variante.delta_conflit
            code_filtre_v = variante.code_filtre
        else:
            # Repli rétrocompatible -- cf. docstring.
            template_bgr = item
            seuil_v = seuil if seuil is not None else 0.9
            priorite_v = priorite if priorite is not None else "mostTop"
            flou_noyau_v = flou_noyau if flou_noyau is not None else 0
            delta_conflit_v = delta_conflit if delta_conflit is not None else 0.0
            code_filtre_v = code_filtre if code_filtre is not None else ""

        try:
            resultat, score_brut = rechercher_composant(image_ecran_bgr, template_bgr, seuil_v, priorite_v,
                                                          flou_noyau_v, delta_conflit_v, code_filtre_v)
        except DetectionAmbigueError as e:
            ambiguite_rencontree = e
            continue
        meilleur_score_brut_global = max(meilleur_score_brut_global, score_brut)
        if resultat is None:
            continue
        if meilleur_resultat is None or resultat["score"] > meilleur_resultat["score"]:
            meilleur_resultat = resultat
            meilleur_index = i

    if meilleur_resultat is not None:
        meilleur_resultat = dict(meilleur_resultat)
        meilleur_resultat["index_variante"] = meilleur_index
        return meilleur_resultat, meilleur_score_brut_global

    if ambiguite_rencontree is not None:
        raise ambiguite_rencontree

    return None, meilleur_score_brut_global


def rechercher_candidats_multiples(image_ecran_bgr, templates_avec_variantes: list,
                                    seuil_candidats: Optional[float] = None,
                                    flou_noyau: Optional[int] = None, max_candidats: int = 20,
                                    code_filtre: Optional[str] = None):
    """Recherche TOUS les candidats dont le score dépasse le seuil de
    candidats (pas seulement le meilleur) -- toutes variantes confondues,
    résultats fusionnés et triés par score décroissant.

    RÉSERVÉ à l'écran "Test de composant" (TestComposantScreen), appelé
    depuis DetectionWorker.demander_detection_multiple -- JAMAIS utilisé
    par le chemin de production (ComposantExecutable._detecter(), qui
    reste sur rechercher_composant_multi_variantes / un seul candidat via
    minMaxLoc, cf. sa docstring). PATCH (demande explicite utilisateur :
    "lorsque on doit lancer la detection sa doit detecter le plus proche
    mais aussi les autre potentils" / "je ne veux pas que sa fait sa en
    production si non peu tetre que sa sera lent ... je veux sa juste
    lorsque on test un composant a lecran").

    PATCH (SPEC_GLOBALE_AutoniaX.md, Partie A §3.3 -- demande explicite
    utilisateur : paramètres de détection relatifs à CHAQUE variante) :
    templates_avec_variantes remplace templates_bgr -- désormais une liste
    de tuples (image_bgr, Variante), cf. charger_templates_bgr. Pour
    chaque variante, le seuil de candidats potentiels
    (Variante.seuil_candidats_potentiels), le flou (Variante.flou_noyau)
    et le filtre (Variante.code_filtre) PROPRES à cette variante sont
    utilisés -- seuil_candidats/flou_noyau/code_filtre passés en argument
    à cette fonction ne servent plus que de repli rétrocompatible si un
    élément de templates_avec_variantes est une image nue plutôt qu'un
    tuple (image_bgr, Variante), cf. rechercher_composant_multi_variantes
    pour le même principe de repli.

    Algorithme : pour chaque variante, matchTemplate donne une carte de
    corrélation entière (pas juste son maximum global comme minMaxLoc).
    On extrait itérativement le maximum de cette carte tant qu'il dépasse
    le seuil de candidats de cette variante, puis on masque (-1) une zone
    de la taille du template autour de ce point avant de chercher le
    maximum suivant (suppression non-maximale) -- évite de retrouver
    plusieurs fois le même composant à des positions à un ou deux pixels
    d'écart. Résultats de toutes les variantes fusionnés dans une seule
    liste, dédupliqués par proximité de position (cf. plus bas), triés
    par score décroissant.

    code_filtre PAR VARIANTE (cf. Variante.code_filtre/executer_filtre_
    composant_single) : "" (défaut) = aucun filtre, comportement
    historique inchangé. Non vide -- appliqué à CHAQUE template_bgr dans
    la boucle ET à image_ecran_bgr UNE FOIS PAR VARIANTE testée (puisque
    le filtre peut différer d'une variante à l'autre, contrairement à
    avant ce patch où un seul filtre s'appliquait à toutes) -- même
    principe que rechercher_composant, pour que l'écran de test reflète
    EXACTEMENT ce qui se passera en production avec cette variante.

    Retourne une liste de dicts {"x","y","largeur","hauteur","score",
    "index_variante"}, triée par score décroissant (premier élément =
    meilleur candidat, à afficher en vert ; les suivants = candidats
    potentiels, à afficher en jaune). Liste vide si aucun candidat ne
    dépasse le seuil de candidats de sa variante."""
    image_gray_brute = image_ecran_bgr if image_ecran_bgr.ndim == 2 else cv2.cvtColor(image_ecran_bgr, cv2.COLOR_BGR2GRAY)
    tous_candidats = []

    for index_variante, item in enumerate(templates_avec_variantes):
        if isinstance(item, tuple) and len(item) == 2 and isinstance(item[1], Variante):
            template_bgr, variante = item
            seuil_candidats_v = variante.seuil_candidats_potentiels
            flou_noyau_v = variante.flou_noyau
            code_filtre_v = variante.code_filtre
        else:
            # Repli rétrocompatible -- cf. docstring.
            template_bgr = item
            seuil_candidats_v = seuil_candidats if seuil_candidats is not None else 0.5
            flou_noyau_v = flou_noyau if flou_noyau is not None else 0
            code_filtre_v = code_filtre if code_filtre is not None else ""

        image_cmp_source = image_ecran_bgr
        if code_filtre_v:
            image_cmp_source = executer_filtre_composant_single(image_ecran_bgr, code_filtre_v)
            template_bgr = executer_filtre_composant_single(template_bgr, code_filtre_v)
        image_gray = image_gray_brute if not code_filtre_v else (
            image_cmp_source if image_cmp_source.ndim == 2 else cv2.cvtColor(image_cmp_source, cv2.COLOR_BGR2GRAY)
        )
        template_gray = template_bgr if template_bgr.ndim == 2 else cv2.cvtColor(template_bgr, cv2.COLOR_BGR2GRAY)
        th, tl = template_gray.shape[:2]
        ih, il = image_gray.shape[:2]
        if th > ih or tl > il:
            continue

        if flou_noyau_v and flou_noyau_v > 0:
            k = flou_noyau_v if flou_noyau_v % 2 == 1 else flou_noyau_v + 1
            image_cmp = cv2.GaussianBlur(image_gray, (k, k), 0)
            template_cmp = cv2.GaussianBlur(template_gray, (k, k), 0)
        else:
            image_cmp = image_gray
            template_cmp = template_gray

        carte = cv2.matchTemplate(image_cmp, template_cmp, cv2.TM_CCOEFF_NORMED)
        carte_travail = carte.copy()
        for _ in range(max_candidats):
            _, score, _, position = cv2.minMaxLoc(carte_travail)
            if score < seuil_candidats_v:
                break
            x, y = position
            tous_candidats.append({
                "x": x, "y": y, "largeur": tl, "hauteur": th,
                "score": float(score), "index_variante": index_variante,
                "echelle": 1.0,  # cf. rechercher_composant : toujours 1.0, aucun balayage multi-échelle
            })
            x0, x1 = max(0, x - tl // 2), min(carte_travail.shape[1], x + tl // 2 + 1)
            y0, y1 = max(0, y - th // 2), min(carte_travail.shape[0], y + th // 2 + 1)
            carte_travail[y0:y1, x0:x1] = -1.0

    # Dédoublonnage entre variantes : si deux variantes différentes
    # matchent quasiment au même endroit (cas courant -- même composant,
    # variantes "thème clair"/"thème sombre" par ex.), ne garder que le
    # meilleur score des deux plutôt que d'afficher deux rectangles
    # jaunes superposés au même endroit.
    tous_candidats.sort(key=lambda c: c["score"], reverse=True)
    candidats_dedupliques = []
    for c in tous_candidats:
        chevauche = False
        for gardé in candidats_dedupliques:
            dx = abs(c["x"] - gardé["x"])
            dy = abs(c["y"] - gardé["y"])
            if dx < min(c["largeur"], gardé["largeur"]) // 2 and dy < min(c["hauteur"], gardé["hauteur"]) // 2:
                chevauche = True
                break
        if not chevauche:
            candidats_dedupliques.append(c)

    return candidats_dedupliques


# ---------------------------------------------------------------------------
# Détection ComposantLayout (cL) -- cf. SPEC_composantLayout.md section 4.
# Version SIMPLE (composantes connexes, pas de clustering par ratio) :
# le filtre produit un masque binaire, connectedComponentsWithStats donne
# directement les blocs détectés (x, y, largeur, hauteur) en une passe --
# pas besoin de regrouper des contours "à la main" ni de comparer des
# ratios entre référentiels différents. L'englobant de l'instance de cL
# détectée est simplement l'union des blocs assignés aux Forme du gabarit.
# ---------------------------------------------------------------------------

class DetectionLayoutError(Exception):
    """Erreur d'exécution du code_filtre (exec() a levé), ou filtre n'ayant
    pas produit un couple ('zones', 'valide') exploitable -- remontée telle
    quelle à l'appelant (capturée et affichée dans l'app de config, jamais
    de crash de l'app).

    REFONTE (cf. SPEC_refonte_filtre_zones_dynamiques.md) : ceci reste
    réservé à un problème de CODE (exception Python, variable manquante,
    type incorrect) -- PAS au cas où le filtre s'exécute correctement mais
    juge que l'image n'est pas un exemplaire valide du gabarit (valide[0]
    is False), qui n'est jamais une erreur, cf. executer_filtre_layout."""


class DetectionScindementError(Exception):
    """Erreur d'exécution du code_scindement (exec() a levé), ou scindement
    n'ayant pas produit de 'cartes' exploitable -- même contrat que
    DetectionLayoutError (capturée et affichée dans l'app de config,
    jamais de crash de l'app, jamais de crash en production non plus :
    remontée telle quelle à l'appelant qui décide quoi en faire)."""


def _builtins_surs_pour_sandbox_detection():
    """Liste blanche de builtins Python "de calcul pur" exposés au code
    collé par l'utilisateur (code_filtre / code_scindement), en plus de
    cv2/np/image déjà exposés.

    But : permettre d'écrire du code Python normal (max(), min(), len(),
    sorted(), int(), range(), etc. -- ce que produit naturellement
    n'importe quel algorithme de vision, cf. detection_carte_video.py et
    scindement.py) SANS ouvrir l'accès fichier/réseau/système que
    __builtins__ complet donnerait.

    Volontairement EXCLUS (jamais dans cette liste, même si un jour un
    filtre semble en avoir besoin) : open, __import__, exec, eval,
    compile, input, exit, quit, globals, locals, vars, getattr/setattr/
    delattr, breakpoint, help, dir -- tout ce qui permettrait d'accéder au
    système de fichiers, au réseau, d'exécuter du code arbitraire
    supplémentaire, ou d'introspecter/modifier l'environnement Python
    hôte. Cette fonction est le SEUL endroit à modifier si un futur filtre
    a besoin d'un builtin de calcul pur supplémentaire non listé ici."""
    return {
        # types / conversions
        "int": int, "float": float, "str": str, "bool": bool,
        "list": list, "dict": dict, "tuple": tuple, "set": set, "frozenset": frozenset,
        # calcul / agrégation
        "len": len, "abs": abs, "round": round, "min": min, "max": max, "sum": sum,
        "sorted": sorted, "reversed": reversed, "range": range, "enumerate": enumerate,
        "zip": zip, "map": map, "filter": filter, "any": any, "all": all,
        "divmod": divmod, "pow": pow,
        # affichage (utile pour déboguer un filtre pendant sa mise au point)
        "print": print,
        # constantes / types de base
        "None": None, "True": True, "False": False,
        "Exception": Exception, "ValueError": ValueError, "TypeError": TypeError,
        "IndexError": IndexError, "KeyError": KeyError, "ZeroDivisionError": ZeroDivisionError,
        "StopIteration": StopIteration, "ArithmeticError": ArithmeticError,
    }


def executer_code_scindement(image_page_bgr, code_scindement: str):
    """Exécute code_scindement (code Python/OpenCV collé par l'utilisateur,
    même esprit et mêmes contraintes que executer_filtre_layout) dans un
    namespace restreint : `image` (BGR, la PAGE ENTIÈRE -- pas une carte
    déjà cadrée) en entrée, `cartes` (liste de rectangles candidats
    (x, y, largeur, hauteur) en pixels ABSOLUS dans cette page) attendue
    en sortie. cv2/np/image sont exposés, plus une liste blanche de
    builtins de calcul pur (max/min/len/sorted/int/range/...) -- pas
    d'accès fichier/réseau, même sandbox que le filtre. Cf.
    _builtins_surs_pour_sandbox_detection pour le détail.

    C'est ce code qui joue le rôle que jouait jusqu'ici scinder_en_cartes()
    (scindement.py) -- mais PROPRE À CHAQUE ComposantLayout plutôt qu'un
    algorithme unique en dur pour tout le projet : un cL "grille YouTube"
    et un cL "liste verticale" n'ont pas la même façon de découper leur
    page en cartes candidates, chacun a son propre code_scindement écrit
    par l'utilisateur dans l'app de config, exactement comme code_filtre
    aujourd'hui.

    ÉLARGI (liste blanche de builtins de calcul pur, cf.
    _builtins_surs_pour_sandbox_detection) : max/min/len/sorted/int/
    range/etc. sont désormais utilisables directement dans code_scindement,
    sans accès fichier/réseau/système pour autant."""
    namespace = {
        "cv2": cv2, "np": np, "image": image_page_bgr,
        "__builtins__": _builtins_surs_pour_sandbox_detection(),
    }
    try:
        exec(code_scindement, namespace)
    except Exception as e:
        raise DetectionScindementError(f"Erreur d'exécution du scindement : {e}") from e
    cartes = namespace.get("cartes")
    if cartes is None:
        raise DetectionScindementError("Le scindement n'a pas défini de variable 'cartes'.")
    if not isinstance(cartes, (list, tuple)):
        raise DetectionScindementError(
            f"'cartes' doit être une liste de rectangles (x, y, largeur, hauteur), "
            f"reçu {type(cartes).__name__}."
        )
    cartes_validees = []
    for i, c in enumerate(cartes):
        if not isinstance(c, (list, tuple)) or len(c) != 4:
            raise DetectionScindementError(
                f"'cartes'[{i}] doit être un tuple (x, y, largeur, hauteur) de 4 valeurs, reçu {c!r}."
            )
        try:
            x, y, largeur, hauteur = (int(v) for v in c)
        except (TypeError, ValueError):
            raise DetectionScindementError(
                f"'cartes'[{i}] contient une valeur non numérique : {c!r}."
            )
        if largeur <= 0 or hauteur <= 0:
            raise DetectionScindementError(
                f"'cartes'[{i}] a une largeur/hauteur non positive : {c!r}."
            )
        cartes_validees.append((x, y, largeur, hauteur))
    return cartes_validees


def dessiner_rectangle_pointille(image_bgr, pt1, pt2, couleur, epaisseur: int = 2, longueur_tiret: int = 6):
    """AJOUT (overlay zone de clic personnalisée d'une zone DYNAMIQUE, cf.
    ComposantLayoutConfigScreen._appliquer_filtre) -- cv2.rectangle n'a
    pas d'option "pointillé" native, contrairement à certaines libs de
    dessin vectoriel : ce helper trace donc un rectangle en tirets à la
    main, en dessinant des petits segments espacés sur chacun des 4
    côtés (cf. boucle ci-dessous, pattern standard OpenCV en l'absence
    de style de trait). Utilisé pour distinguer visuellement le
    rectangle de la zone de clic personnalisée (pointillé) de celui de
    la zone dynamique elle-même (plein, cf. la boucle juste avant dans
    _appliquer_filtre) -- MÊME couleur que cette zone (demande explicite
    utilisateur), seul le style de trait change."""
    x1, y1 = pt1
    x2, y2 = pt2
    # 4 côtés, chacun tracé en alternant segment dessiné / segment sauté
    # de longueur_tiret pixels -- x1<x2 et y1<y2 supposés (cf. appelant,
    # qui construit toujours pt1=coin haut-gauche/pt2=coin bas-droit).
    for (xa, ya, xb, yb) in ((x1, y1, x2, y1), (x1, y2, x2, y2)):  # haut, bas (horizontaux)
        x = xa
        dessine = True
        while x < xb:
            x_suivant = min(x + longueur_tiret, xb)
            if dessine:
                cv2.line(image_bgr, (x, ya), (x_suivant, yb), couleur, epaisseur)
            x = x_suivant
            dessine = not dessine
    for (xa, ya, xb, yb) in ((x1, y1, x1, y2), (x2, y1, x2, y2)):  # gauche, droite (verticaux)
        y = ya
        dessine = True
        while y < yb:
            y_suivant = min(y + longueur_tiret, yb)
            if dessine:
                cv2.line(image_bgr, (xa, y), (xb, y_suivant), couleur, epaisseur)
            y = y_suivant
            dessine = not dessine


def executer_filtre_layout(image_bgr, code_filtre: str):
    """REFONTE COMPLÈTE (cf. SPEC_refonte_filtre_zones_dynamiques.md) :
    exécute code_filtre (code Python/OpenCV collé par l'utilisateur) dans un
    namespace restreint : `image` (BGR, UNE CARTE déjà découpée par
    code_scindement -- jamais la page entière, jamais d'ambiguïté entre
    deux instances à ce stade) en entrée. cv2/np/image sont exposés, plus
    une liste blanche de builtins de calcul pur (max/min/len/sorted/int/
    range/...) -- pas d'accès fichier/réseau. Cf.
    _builtins_surs_pour_sandbox_detection pour le détail.

    ANCIEN CONTRAT (retiré) : le filtre retournait une image `resultat`
    (masque), ensuite interprétée par _blocs_depuis_masque + _grouper_blocs_
    par_proximite + _evaluer_cluster pour en tirer des blocs anonymes puis
    les faire correspondre par matching structurel à des Zone figées
    (renommage manuel préalable, tracé à la souris). Ce mécanisme est
    entièrement supprimé.

    NOUVEAU CONTRAT : le filtre NOMME lui-même chaque zone qu'il détecte --
    il n'y a plus rien à deviner ni à faire correspondre après coup, cf.
    l'exemple de référence detection_carte_video.py (detecter_toutes_les_
    zones + est_un_template_valide, exactement le même esprit). Deux
    variables OBLIGATOIRES attendues en sortie :

      - `zones` (dict[str, tuple[int,int,int,int]]) : {nom_zone: (x, y,
        largeur, hauteur)} en pixels RELATIFS à `image`. Une clé absente
        signifie que cette zone n'a pas été trouvée sur cette carte.
      - `valide` (tuple[bool, str]) : (True, "raison") ou (False, "raison")
        -- permet au filtre de dire explicitement "ce n'est pas un vrai
        exemplaire du gabarit" MÊME s'il a trouvé des zones (ex : vignette
        trouvée mais pas de menu 3 points -> pas valide), exactement comme
        est_un_template_valide dans l'exemple de référence.

    Distinction stricte entre les deux échecs possibles (cf. SPEC) :
      1. Erreur d'exécution / variable manquante / type incorrect -> lève
         DetectionLayoutError (problème de CODE).
      2. valide[0] is False -> PAS une erreur, retour normal (zones, valide)
         tel quel -- c'est à l'appelant (detecter_toutes_instances_
         composant_layout) de décider qu'aucune instance n'est présente ici,
         en utilisant valide[1] comme message/diagnostic.

    Retourne le tuple (zones, valide) tel quel, jamais rien d'autre (plus de
    'resultat' image dans ce contrat -- si un aperçu visuel a besoin de
    dessiner quelque chose, c'est fait côté système à partir de `zones`,
    jamais par le filtre lui-même).

    ÉLARGI (liste blanche de builtins de calcul pur, cf.
    _builtins_surs_pour_sandbox_detection) : max/min/len/sorted/int/
    range/etc. sont désormais utilisables directement dans code_filtre,
    sans accès fichier/réseau/système pour autant -- cf. cette fonction
    pour la liste exacte et le rationale de ce qui reste exclu."""
    namespace = {
        "cv2": cv2, "np": np, "image": image_bgr,
        "__builtins__": _builtins_surs_pour_sandbox_detection(),
    }
    try:
        exec(code_filtre, namespace)
    except Exception as e:
        raise DetectionLayoutError(f"Erreur d'exécution du filtre : {e}") from e

    zones = namespace.get("zones")
    if zones is None:
        raise DetectionLayoutError("Le filtre n'a pas défini de variable 'zones'.")
    if not isinstance(zones, dict):
        raise DetectionLayoutError(
            f"'zones' doit être un dict {{nom_zone: (x, y, largeur, hauteur)}}, "
            f"reçu {type(zones).__name__}."
        )
    zones_validees = {}
    for nom_zone, rect in zones.items():
        if not isinstance(nom_zone, str) or not nom_zone:
            raise DetectionLayoutError(
                f"'zones' contient une clé de nom invalide : {nom_zone!r} (doit être une chaîne non vide)."
            )
        if not isinstance(rect, (list, tuple)) or len(rect) != 4:
            raise DetectionLayoutError(
                f"'zones'[{nom_zone!r}] doit être un tuple (x, y, largeur, hauteur) de 4 valeurs, reçu {rect!r}."
            )
        try:
            x, y, largeur, hauteur = (int(v) for v in rect)
        except (TypeError, ValueError):
            raise DetectionLayoutError(
                f"'zones'[{nom_zone!r}] contient une valeur non numérique : {rect!r}."
            )
        if largeur <= 0 or hauteur <= 0:
            raise DetectionLayoutError(
                f"'zones'[{nom_zone!r}] a une largeur/hauteur non positive : {rect!r}."
            )
        zones_validees[nom_zone] = (x, y, largeur, hauteur)

    valide = namespace.get("valide")
    if valide is None:
        raise DetectionLayoutError("Le filtre n'a pas défini de variable 'valide'.")
    if not isinstance(valide, (list, tuple)) or len(valide) != 2:
        raise DetectionLayoutError(
            f"'valide' doit être un couple (bool, raison: str), reçu {valide!r}."
        )
    valide_bool, valide_raison = valide
    if not isinstance(valide_bool, bool):
        raise DetectionLayoutError(
            f"'valide'[0] doit être un bool, reçu {type(valide_bool).__name__}."
        )
    if not isinstance(valide_raison, str):
        raise DetectionLayoutError(
            f"'valide'[1] doit être une chaîne (raison), reçu {type(valide_raison).__name__}."
        )

    return zones_validees, (valide_bool, valide_raison)


class DetectionFiltreComposantSingleError(Exception):
    """Levée par executer_filtre_composant_single quand code_filtre (cf.
    ComposantSingle.code_filtre) échoue à l'exécution ou ne définit pas
    correctement la variable 'resultat' attendue -- même esprit que
    DetectionLayoutError pour ComposantLayout.code_filtre, classe séparée
    pour ne jamais mélanger les deux diagnostics (cS et cL restent deux
    pipelines de détection distincts, cf. docstring de ComposantLayout)."""


def executer_filtre_composant_single(image_bgr, code_filtre: str):
    """AJOUT (demande explicite utilisateur : "il faut un filtre pour
    isoler tout le fond et uniquement se concentrer sur lelement a
    rechercher ... lorsque on vas vouloir fait le match template on vas
    appliquer un filtre dabord sur limage") -- cf. ComposantSingle.
    code_filtre.

    MÊME SANDBOX que executer_filtre_layout (cv2/np/image exposés, plus
    la liste blanche de builtins de calcul pur, cf.
    _builtins_surs_pour_sandbox_detection -- pas d'accès fichier/réseau/
    système) mais CONTRAT DE SORTIE différent, plus simple, cohérent avec
    la décision explicite utilisateur : le filtre transforme l'image
    ENTIÈRE (jamais un sous-rectangle) pour faire ressortir l'élément
    recherché du reste -- pas de zones nommées à produire ici (cS n'a
    qu'UN SEUL élément à détecter par variante, contrairement à cL).

    `image` (BGR) en entrée -- soit le TEMPLATE (une variante du
    Composant), soit la CAPTURE ÉCRAN complète : cette fonction est
    appelée UNE FOIS PAR IMAGE, séparément, avec EXACTEMENT le même
    code_filtre les deux fois (cf. rechercher_composant) -- jamais les
    deux images à la fois, le filtre n'a donc aucun moyen de comparer
    l'une à l'autre, seulement de transformer CELLE reçue.

    `resultat` (BGR ou niveaux de gris, mêmes dimensions largeur/hauteur
    que `image`) attendue en sortie -- c'est cette image transformée qui
    remplace `image` pour la suite du pipeline de matchTemplate habituel
    (conversion niveaux de gris si nécessaire, flou_noyau éventuel, puis
    comparaison) : AUCUN paramètre mask natif de cv2.matchTemplate n'est
    utilisé ici (décision explicite utilisateur, cf. discussion) -- le
    filtre est un simple PRÉ-TRAITEMENT appliqué identiquement aux deux
    images avant la comparaison normale, exactement comme un filtre
    Instagram appliqué séparément à deux photos avant de les comparer.
    Un filtre de seuillage couleur/de contours qui isole visuellement
    l'élément recherché rend alors le score de correspondance insensible
    à un arrière-plan qui change d'une capture à l'autre (vidéo en
    lecture, horloge affichée, contenu qui défile...), qui casserait
    sinon un matchTemplate brut pixel à pixel sur l'image d'origine.

    Erreur d'exécution / variable 'resultat' manquante ou de mauvais
    type/dimensions -> lève DetectionFiltreComposantSingleError (problème
    de CODE, jamais silencieux) -- à la différence de code_filtre pour
    ComposantLayout, il n'y a pas de second cas "valide=False" ici : cS
    n'a rien d'équivalent à "cette carte n'est pas un exemplaire valide
    du gabarit", le filtre ne fait QUE transformer une image, point.

    code_filtre="" (défaut de ComposantSingle) -- cette fonction n'est
    JAMAIS appelée dans ce cas (cf. ses appelants, qui testent code_filtre
    avant d'y recourir) : comportement historique intégralement inchangé,
    comparaison directe des pixels d'origine, aucun coût ajouté pour tout
    Composant existant qui ne configure pas ce champ."""
    namespace = {
        "cv2": cv2, "np": np, "image": image_bgr,
        "__builtins__": _builtins_surs_pour_sandbox_detection(),
    }
    try:
        exec(code_filtre, namespace)
    except Exception as e:
        raise DetectionFiltreComposantSingleError(f"Erreur d'exécution du filtre : {e}") from e

    resultat = namespace.get("resultat")
    if resultat is None:
        raise DetectionFiltreComposantSingleError("Le filtre n'a pas défini de variable 'resultat'.")
    if not isinstance(resultat, np.ndarray):
        raise DetectionFiltreComposantSingleError(
            f"'resultat' doit être une image (tableau numpy), reçu {type(resultat).__name__}."
        )
    h_src, l_src = image_bgr.shape[:2]
    h_res, l_res = resultat.shape[:2]
    if (h_res, l_res) != (h_src, l_src):
        raise DetectionFiltreComposantSingleError(
            f"'resultat' doit avoir les mêmes dimensions que 'image' (largeur, hauteur) -- "
            f"attendu ({l_src}, {h_src}), reçu ({l_res}, {h_res})."
        )
    return resultat


def couleur_fond_automatique_layout(image_reference_bgr, taille_echantillon: int = 5):
    """SPEC section 4.3 : détecte la couleur de fond de image_reference en
    échantillonnant les 4 coins (carrés taille_echantillon x
    taille_echantillon px), couleur MAJORITAIRE parmi ces 4 échantillons.
    Donnée informative/suggestion par défaut pour le code de filtre généré
    dans l'app de config -- n'intervient PAS dans l'algorithme de détection
    lui-même (executer_filtre_layout, entièrement piloté par code_filtre,
    cf. sa docstring pour le contrat zones/valide -- rien de comparable à
    une couleur de fond n'y est calculé côté système).

    Retourne un tuple BGR (int, int, int)."""
    h, w = image_reference_bgr.shape[:2]
    t = max(1, min(taille_echantillon, h, w))
    coins = [
        image_reference_bgr[0:t, 0:t],
        image_reference_bgr[0:t, w - t:w],
        image_reference_bgr[h - t:h, 0:t],
        image_reference_bgr[h - t:h, w - t:w],
    ]
    pixels = np.concatenate([c.reshape(-1, 3) for c in coins], axis=0)
    couleurs, comptes = np.unique(pixels, axis=0, return_counts=True)
    couleur_majoritaire = couleurs[np.argmax(comptes)]
    return tuple(int(c) for c in couleur_majoritaire)


def detecter_toutes_instances_composant_layout(image_ecran_bgr, code_filtre: str):
    """REFONTE COMPLÈTE (cf. SPEC_refonte_filtre_zones_dynamiques.md) :
    détecte l'instance de ComposantLayout présente sur UNE CARTE déjà
    découpée (image_ecran_bgr -- malgré son nom historique, ce n'est PLUS
    la page entière depuis l'introduction de code_scindement, cf.
    detecter_toutes_instances_composant_layout_sur_page qui appelle cette
    fonction une fois par carte candidate).

    ANCIEN PIPELINE (retiré) : filtre -> blocs anonymes (composantes
    connexes) -> regroupement spatial en clusters -> matching structurel de
    chaque cluster contre un gabarit de Zone figées (zones_gabarit,
    seuil_confiance, delta_conflit, distance_max_regroupement_px). Tout ce
    mécanisme de clustering/matching est supprimé : plus de gabarit à
    matcher, le filtre nomme lui-même chaque zone qu'il trouve (cf.
    executer_filtre_layout).

    NOUVEAU PIPELINE : le filtre s'exécute UNE fois sur toute la carte et
    retourne directement (zones, valide). Comme une carte ne contient
    qu'UNE SEULE instance possible (le découpage par code_scindement a déjà
    isolé les candidats), il n'y a plus ni clustering ni dédoublonnage à
    faire ici -- une carte produit au plus UNE instance.

    Retourne une liste (0 ou 1 élément, jamais plus) de dicts {"englobant",
    "zones"} -- plus de "score" (supprimé avec seuil_confiance, plus de
    notion de confiance à comparer pour un cL). Liste vide si :
      - le filtre juge que ce n'est pas un exemplaire valide (valide[0] is
        False, cf. sa raison -- valide[1] -- laissée à l'appelant pour
        diagnostic/affichage) ;
      - ou si 'zones' est vide (aucune zone trouvée ne peut jamais
        constituer une instance valide, même si valide[0] valait True par
        erreur du filtre)."""
    zones, valide = executer_filtre_layout(image_ecran_bgr, code_filtre)
    valide_bool, _valide_raison = valide
    if not valide_bool or not zones:
        return []

    xs = [x for (x, y, l, h) in zones.values()]
    ys = [y for (x, y, l, h) in zones.values()]
    x2s = [x + l for (x, y, l, h) in zones.values()]
    y2s = [y + h for (x, y, l, h) in zones.values()]
    englobant = (min(xs), min(ys), max(x2s) - min(xs), max(y2s) - min(ys))
    if englobant[2] <= 0 or englobant[3] <= 0:
        return []

    return [{"englobant": englobant, "zones": dict(zones)}]


def detecter_composant_layout(image_ecran_bgr, code_filtre: str):
    """Compatibilité : retourne la MEILLEURE instance détectée (ou None),
    équivalent à l'ancien comportement mono-instance. Conservé pour les
    appelants qui n'ont besoin que d'une détection simple (ex: tests
    existants) -- le nouveau code (ComposantLayoutExecutable, section 6)
    utilise detecter_toutes_instances_composant_layout directement.

    REFONTE : signature allégée en même temps que detecter_toutes_
    instances_composant_layout (plus de zones_gabarit/seuil_confiance/
    delta_conflit/distance_max_regroupement_px, cf. sa docstring)."""
    instances = detecter_toutes_instances_composant_layout(image_ecran_bgr, code_filtre)
    return instances[0] if instances else None


def detecter_toutes_instances_composant_layout_sur_page(
    image_page_bgr, code_scindement: str, code_filtre: str,
):
    """Point d'entrée RÉEL utilisé en production (cf. ComposantLayoutExecutable.
    visible()) : contrairement à detecter_toutes_instances_composant_layout
    (une seule carte déjà cadrée), cette fonction attend la PAGE ENTIÈRE et
    applique le pipeline en DEUX étapes bien séparées, chacune pilotée par
    son propre code propre à ce ComposantLayout :

      1. code_scindement s'exécute UNE fois sur la page entière
         (executer_code_scindement) -> liste de rectangles candidats
         ("cartes"), en coordonnées ABSOLUES de la page. Rôle exactement
         équivalent à scinder_en_cartes() (scindement.py) : répondre à
         "combien de cartes y a-t-il et où", sans regarder leur contenu.

      2. Pour CHAQUE carte candidate, on découpe le sous-rectangle
         correspondant de la page et on lui applique code_filtre (cf.
         detecter_toutes_instances_composant_layout) : le filtre NOMME
         lui-même chaque zone qu'il trouve sur cette carte et dit si c'est
         un exemplaire valide (cf. SPEC_refonte_filtre_zones_dynamiques.md
         -- executer_filtre_layout, contrat (zones, valide)). Une carte
         candidate jugée non valide par le filtre (valide[0] is False) ne
         produit simplement aucune instance pour ce sous-rectangle -- pas
         une erreur, un candidat de scindement n'est qu'une PROPOSITION,
         rien ne garantit qu'il corresponde réellement au ComposantLayout
         cherché (ex: un bouton "Plus" ou un séparateur pris à tort pour
         une carte par le scindement).

    REFONTE (cf. SPEC) : plus de zones_gabarit/seuil_confiance/delta_
    conflit/distance_max_regroupement_px en paramètre -- le filtre ne
    matche plus contre un gabarit statique, il nomme et valide lui-même
    (cf. detecter_toutes_instances_composant_layout, signature allégée en
    même temps). Plus de "score" non plus dans les résultats : le tri final
    se fait par position (haut en bas, gauche à droite, cf. ci-dessous),
    pas par confiance.

    Seules les instances RÉELLEMENT VALIDÉES par le filtre (étape 2) sont
    retournées -- jamais les cartes candidates brutes de l'étape 1 telles
    quelles. Coordonnées (englobant + chaque Zone) systématiquement
    repositionnées en absolu PAGE (pas relatives à la carte), pour rester
    directement utilisables par l'appelant (ex: un clic à l'écran).

    Une erreur de scindement (DetectionScindementError) n'est PAS
    rattrapée ici -- remontée telle quelle à l'appelant, même contrat que
    DetectionLayoutError pour le filtre (cf. ComposantLayoutExecutable.
    visible(), qui capture les deux au même endroit)."""
    cartes = executer_code_scindement(image_page_bgr, code_scindement)
    if not cartes:
        return []

    h_page, l_page = image_page_bgr.shape[:2]
    resultats = []
    for (x, y, largeur, hauteur) in cartes:
        # Garde-fou : un code_scindement mal écrit peut proposer un
        # rectangle qui déborde de la page (ex: dernière rangée tronquée
        # mal gérée) -- on rogne au lieu de planter, même esprit défensif
        # que le reste du fichier (cf. derniere_bande_de_contenu côté
        # scindement.py, qui borne déjà y_bas à page_gray.shape[0]).
        x_fin = min(x + largeur, l_page)
        y_fin = min(y + hauteur, h_page)
        x_deb = max(x, 0)
        y_deb = max(y, 0)
        if x_fin <= x_deb or y_fin <= y_deb:
            continue
        sous_image = image_page_bgr[y_deb:y_fin, x_deb:x_fin]

        try:
            instances_carte = detecter_toutes_instances_composant_layout(sous_image, code_filtre)
        except DetectionLayoutError:
            # Même logique que ci-dessus : un candidat de scindement qui
            # fait planter le filtre (ex: trop petit pour le code collé)
            # est ignoré comme non-match, pas remonté en erreur globale --
            # sinon UNE carte candidate malformée ferait échouer TOUTE
            # la détection de la page entière, ce qui serait pire que de
            # simplement la rater.
            continue

        for inst in instances_carte:
            ex, ey, el, eh = inst["englobant"]
            englobant_absolu = (ex + x_deb, ey + y_deb, el, eh)
            zones_absolues = {
                nom: (zx + x_deb, zy + y_deb, zl, zh)
                for nom, (zx, zy, zl, zh) in inst["zones"].items()
            }
            resultats.append({
                "englobant": englobant_absolu,
                "zones": zones_absolues,
            })

    # REFONTE : plus de "score" à trier (supprimé avec seuil_confiance) --
    # tri par position (haut en bas, puis gauche à droite) pour un ordre
    # déterministe et lisible plutôt qu'un ordre arbitraire dépendant de
    # celui des cartes retournées par code_scindement.
    resultats.sort(key=lambda r: (r["englobant"][1], r["englobant"][0]))
    return resultats



