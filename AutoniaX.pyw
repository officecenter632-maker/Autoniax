    client_t.dupliquer_profil_sautoniax_demande.connect(_sur_dupliquer_profil_demande, Qt.DirectConnection)

    # ------------------------------------------------------------------
    # AJOUT (régénérer le navigateur d'un profil -- cf. spec) : arrête le
    # profil s'il tourne en isolé, remplace l'empreinte/les données sur disque
    # (regenerer_identite_navigateur_disque, profils_config.json INCHANGÉ ->
    # même proxy), relance, puis vérifie que l'empreinte est bien différente
    # (3 essais max). Réponse DIFFUSÉE à tous les pilotes.
    # ------------------------------------------------------------------
    _regenerations_en_cours: set = set()
    NB_ESSAIS_REGENERATION = 3

    def _detacher_profil_isole_pour_regeneration(nom_profil: str, garder_executeur: bool = False) -> list:
        # Boucle asyncio uniquement : retire le profil des registres et retourne
        # les process à arrêter (même nettoyage que _sur_kill_profil_demande).
        # garder_executeur=True (régénération depuis une cellule) : seul le NAVIGATEUR est
        # détaché ; l'exécuteur (et donc le namespace de la cellule en cours) reste vivant.
        instance_id_isolee = _instances_isolees.pop(nom_profil, None)
        if not instance_id_isolee:
            return []
        if garder_executeur:
            return [pr for pr in [_procs_isoles.pop(instance_id_isolee, None)] if pr is not None]
        procs = [
            _procs_isoles.pop(instance_id_isolee, None),
            _executeurs_isoles.pop(instance_id_isolee, None),
        ]
        _namespaces_isoles.pop(instance_id_isolee, None)
        _moteurs_relais_courants.pop(instance_id_isolee, None)
        return [pr for pr in procs if pr is not None]

    def _arreter_procs_bloquant(procs: list) -> None:
        for pr in procs:
            try:
                pr.terminate()
            except OSError:
                pass
            try:
                pr.wait(timeout=3.0)
            except subprocess.TimeoutExpired:
                log.warning(f"[sAutoniax] process PID {pr.pid} n'a pas répondu à terminate() -> kill()")
                try:
                    pr.kill()
                    pr.wait(timeout=3.0)
                except Exception as exc_kill:
                    log.warning(f"[sAutoniax] kill du PID {pr.pid} échoué : {exc_kill!r}")

    def _debloquer_cellules_en_attente(instance_id, nom_profil: str) -> None:
        # La cellule en cours tourne dans l'exécuteur, qui va être arrêté : on débloque
        # explicitement son attente (même mécanisme que « Arrêter », cf.
        # _sur_arreter_execution_profil_demande) pour que le pilote reçoive un
        # résultat clair au lieu d'attendre indéfiniment.
        if not instance_id:
            return
        for _rid, (_evt, _boite, _iid) in list(_callbacks_executer_code_en_attente.items()):
            if _iid != instance_id:
                continue
            _boite["data"] = {
                "type": "executer_code_resultat", "instance_id": instance_id, "requete_id": _rid, "ok": False,
                "erreur": f"cellule interrompue : le navigateur du profil '{nom_profil}' est en cours de régénération.",
                "sortie": "",
            }
            _evt.set()

    async def _regenerer_profil_async(nom_profil: str, garder_donnees: bool, relancer: bool, id_pilote: str,
                                      instance_id_conserve: Optional[str] = None):
        # instance_id_conserve (régénération demandée DEPUIS UNE CELLULE) : le nouveau navigateur reprend
        # ce MÊME instance_id, l'exécuteur n'est pas arrêté et reçoit le signal « prêt » (ou l'échec).
        nom_profil = (nom_profil or "").strip()

        def _repondre(ok: bool, message: str, instance_id: str = ""):
            if instance_id_conserve:
                client_pilote_instances.envoyer_regenerer_navigateur_resultat(instance_id_conserve, ok, message)
            client_t.envoyer_regenerer_profil_sautoniax_resultat(nom_profil, ok, message, instance_id)

        if instance_id_conserve and not relancer:
            _repondre(False, "Depuis une cellule, relancer=False n'a pas de sens : sans navigateur le code ne peut plus tourner.")
            return
        if not nom_profil:
            _repondre(False, "Le nom du profil est requis.")
            return
        if nom_profil in _regenerations_en_cours:
            _repondre(False, "Une régénération est déjà en cours pour ce profil.")
            return
        _regenerations_en_cours.add(nom_profil)
        try:
            # sAutoniax lance TOUJOURS un moteur Playwright (Camoufox ou
            # CloakBrowser, cf. _moteur_playwright_pour_profil), même pour un
            # profil de type « chrome » -- l'empreinte à régénérer est donc
            # celle de ce moteur.
            moteur = _moteur_playwright_pour_profil(nom_profil)
            dossier_profil = _chemin_donnees("sautoniax_profils") / _nom_dossier_valide(nom_profil)
            if not dossier_profil.is_dir():
                _repondre(False, f"Le profil '{nom_profil}' n'existe pas sur cet exécutant.")
                return
            if nom_profil not in _instances_isolees and _profil_est_actif_sur_ce_sautoniax(nom_profil):
                _repondre(False, f"Le profil '{nom_profil}' est utilisé par un projet ou un notebook -- arrête-le avant de régénérer son navigateur.")
                return

            for tentative in range(1, NB_ESSAIS_REGENERATION + 1):
                if not instance_id_conserve:
                    _debloquer_cellules_en_attente(_instances_isolees.get(nom_profil), nom_profil)
                procs_a_arreter = _detacher_profil_isole_pour_regeneration(nom_profil, garder_executeur=bool(instance_id_conserve))
                if procs_a_arreter:
                    log.info(f"[sAutoniax] régénération '{nom_profil}' : arrêt du navigateur en cours (essai {tentative}).")
                    await loop.run_in_executor(None, _arreter_procs_bloquant, procs_a_arreter)
                if instance_id_conserve:
                    absente = await loop.run_in_executor(None, _sautoniax_attendre_instance_absente, instance_id_conserve, 10.0)
                    if not absente:
                        log.warning(f"[sAutoniax] régénération '{nom_profil}' : l'ancien navigateur figure encore dans le serveur local après 10 s -- on continue.")
                ok, message, signature_ancienne = await loop.run_in_executor(
                    None, regenerer_identite_navigateur_disque, str(dossier_profil), moteur, garder_donnees,
                )
                if not ok:
                    _repondre(False, message)
                    return
                if not relancer:
                    _repondre(True, "Le nouveau navigateur sera généré au prochain démarrage du profil.")
                    return
                await _sautoniax_demarrer_profil_isole(
                    client_t, loop, nom_profil, id_pilote, _instances_isolees, _procs_isoles,
                    callback_instance_prete=_lier_instance_isolee_au_client_pilote,
                    relais_proxy_local=relais_proxy_local,
                    instance_id_force=instance_id_conserve,
                    _executeurs_isoles=_executeurs_isoles,
                )
                instance_id_neuve = _instances_isolees.get(nom_profil, "")
                if not instance_id_neuve:
                    _repondre(False, "L'ancien navigateur a été supprimé mais le nouveau n'a pas démarré (voir les logs sAutoniax).")
                    return
                signature_nouvelle = _signature_empreinte_profil(dossier_profil, moteur)
                if signature_ancienne is None or signature_nouvelle is None:
                    _repondre(True, "Nouveau navigateur démarré (unicité de l'empreinte non vérifiable).", instance_id_neuve)
                    return
                if signature_nouvelle != signature_ancienne:
                    _repondre(True, "Nouveau navigateur démarré avec une nouvelle empreinte.", instance_id_neuve)
                    return
                log.warning(
                    f"[sAutoniax] régénération '{nom_profil}' : empreinte IDENTIQUE à l'ancienne "
                    f"(essai {tentative}/{NB_ESSAIS_REGENERATION}) -- nouvel essai."
                )
            _repondre(False, f"L'empreinte générée est restée identique après {NB_ESSAIS_REGENERATION} essais (contrainte d'écran trop restrictive ?).")
        except Exception as exc:
            log.exception(f"[sAutoniax] régénération du navigateur '{nom_profil}' : exception")
            _repondre(False, f"{exc.__class__.__name__}: {exc}")
        finally:
            _regenerations_en_cours.discard(nom_profil)

    def _lancer_regeneration(nom_profil: str, garder_donnees: bool, relancer: bool, id_pilote: str,
                             instance_id_conserve: Optional[str] = None):
        def _programmer():
            tache = loop.create_task(
                _regenerer_profil_async(nom_profil, garder_donnees, relancer, id_pilote, instance_id_conserve)
            )
            _taches_projets_en_cours.add(tache)
            tache.add_done_callback(_taches_projets_en_cours.discard)
        loop.call_soon_threadsafe(_programmer)

    def _sur_regenerer_profil_demande(nom_profil: str, garder_donnees: bool, relancer: bool, id_pilote: str):
        _lancer_regeneration(nom_profil, garder_donnees, relancer, id_pilote)

    client_t.regenerer_profil_sautoniax_demande.connect(_sur_regenerer_profil_demande, Qt.DirectConnection)

    def _sur_regenerer_navigateur_executeur_recu(data: dict):
        # AJOUT (regenerer_navigateur() sans argument, appelée DEPUIS une cellule) :
        # l'exécuteur donne son instance_id ; on retrouve le profil isolé associé.
        instance_id_demande = data.get("instance_id", "")
        nom_profil_trouve = next((n for n, i in list(_instances_isolees.items()) if i == instance_id_demande), None)
        if nom_profil_trouve is None:
            log.warning(f"[sAutoniax] regenerer_navigateur_executeur ignoré : aucun profil isolé actif pour l'instance {instance_id_demande!r}.")
            client_pilote_instances.envoyer_regenerer_navigateur_resultat(
                instance_id_demande, False, "aucun profil isolé actif pour cette instance (déjà arrêtée ?)",
            )
            return
        log.info(f"[sAutoniax] régénération demandée depuis une cellule -- profil '{nom_profil_trouve}' (instance {instance_id_demande!r}).")
        _lancer_regeneration(
            nom_profil_trouve, bool(data.get("garder_donnees", False)), bool(data.get("relancer", True)),
            data.get("id_pilote", ""), instance_id_conserve=instance_id_demande,
        )

    client_pilote_instances.regenerer_navigateur_recu.connect(_sur_regenerer_navigateur_executeur_recu, Qt.DirectConnection)

    def _sur_toggle_proxy_natif_demande(nom_profil: str, actif: bool, id_pilote: str):
        # PATCH (SPEC_proxy_natif_tunnel.md, section 13.3/13.5 -- toggle
        # "Proxy natif" par profil, déclenché À DISTANCE depuis le
        # pilote). Réutilise _profil_est_actif_sur_ce_sautoniax (même
        # source de vérité EXACTE que _sur_supprimer_profil_demande) pour
        # refuser tout changement tant que le profil est actuellement
        # actif -- un changement de --proxy-server ne peut de toute
        # façon pas s'appliquer à un navigateur déjà lancé (cf. spec
        # section 13.5 : "le toggle est interdit tant que le profil est
        # actif", tranché explicitement, pas de redémarrage automatique
        # ni d'application différée silencieuse).
        if _profil_est_actif_sur_ce_sautoniax(nom_profil):
            log.warning(
                f"[sAutoniax] toggle_proxy_natif refusé pour '{nom_profil}' : profil actuellement actif."
            )
            client_t.envoyer_toggle_proxy_natif_resultat(
                id_pilote, nom_profil, actif, False,
                "Ce profil est actuellement actif -- arrêtez-le avant de changer le proxy natif.",
            )
            return
        ok = definir_proxy_natif_config_profil(nom_profil, actif)
        if not ok:
            log.warning(f"[sAutoniax] toggle_proxy_natif : échec d'écriture pour '{nom_profil}'.")
            client_t.envoyer_toggle_proxy_natif_resultat(
                id_pilote, nom_profil, actif, False,
                "Échec de l'écriture locale (profils_config.json).",
            )
            return
        log.info(f"[sAutoniax] toggle_proxy_natif : '{nom_profil}' -> actif={actif!r} (id_pilote={id_pilote!r}).")

        # PATCH (section 6, "ce qui manque encore" -- câblage réel) :
        # l'écriture disque ci-dessus persiste juste l'intention ; ce qui
        # suit démarre/arrête RÉELLEMENT le port TCP local correspondant.
        # Passe par une coroutine (obtenir_port_local/arreter_pour_profil
        # sont asyncio, contrairement à definir_proxy_natif_config_profil
        # ci-dessus) -- même patron que _sur_supprimer_profil_demande
        # (loop.create_task + _taches_projets_en_cours pour garder une
        # référence forte le temps de l'exécution).
        def _programmer():
            async def _executer():
                erreur = ""
                if actif:
                    # PATCH (section 4) : pose l'id_pilote AVANT tout
                    # appel à obtenir_port_local -- lu par
                    # _id_pilote_stable_cible au moment de l'annonce
                    # /ws_tunnel (cf. docstring de RelaisProxyLocol).
                    relais_proxy_local.dernier_id_pilote_connu = id_pilote
                    try:
                        port = await relais_proxy_local.obtenir_port_local(nom_profil)
                        log.info(f"[sAutoniax] proxy natif actif pour '{nom_profil}' -- port local {port}.")
                    except Exception as e:
                        erreur = f"Échec d'ouverture du tunnel proxy natif : {e!r}"
                        log.warning(f"[sAutoniax] toggle_proxy_natif : {erreur}")
                        # Revert : le port n'a pas pu être ouvert, on ne
                        # laisse pas 'actif=True' persisté sur disque
                        # sans port réel derrière -- cohérent avec
                        # 13.5/13.6 (le pilote doit voir l'échec réel,
                        # pas un état optimiste qui ne se concrétise pas).
                        definir_proxy_natif_config_profil(nom_profil, False)
                    if not erreur:
                        # PATCH (demande utilisateur : "quand on vas
                        # apuyer sur le bouton de toogle proxy natifs sa
                        # vas affihcer aussi le lheure du mautniax, juste
                        # pour nootifier que sa a bien la bonne heure ...
                        # dans les sortie de sautoniax") -- REVU (cf.
                        # discussion "pourquoi mautoniax ne donne pas lui
                        # meme la date directement") : n'interroge plus
                        # ip-api.com à travers le tunnel 127.0.0.1:<port>
                        # tout juste ouvert (c'était justement cette
                        # requête sortante qui timeoutait, cf. section
                        # historique du bug -- le tunnel devait être
                        # fonctionnel juste pour demander une heure que
                        # le mAutoniax connaissait déjà). obtenir_horloge_
                        # mautoniax ci-dessous passe désormais par le
                        # canal /ws JSON standard (demander_horloge_
                        # mautoniax/horloge_mautoniax_resultat, cf. leurs
                        # docstrings), indépendant de /ws_tunnel et de son
                        # ordre de connexion -- aucune requête réseau
                        # applicative, donc plus aucun timeout OPEN
                        # possible sur ce chemin. Try/except DÉLIBÉRÉMENT
                        # séparé de celui
                        # ci-dessus : purement informatif, ne doit jamais
                        # transformer un toggle par ailleurs réussi (port
                        # local bien ouvert) en échec signalé au pilote --
                        # `erreur` n'est jamais modifiée ici, seulement
                        # loggé côté sAutoniax.
                        try:
                            horloge_mautoniax = await relais_proxy_local.obtenir_horloge_mautoniax()
                            if horloge_mautoniax:
                                iso_local, nom_fuseau = horloge_mautoniax
                                if nom_fuseau:
                                    log.info(f"[sAutoniax] proxy natif '{nom_profil}' -- heure du mAutoniax : {iso_local} ({nom_fuseau}).")
                                else:
                                    log.info(f"[sAutoniax] proxy natif '{nom_profil}' -- heure du mAutoniax : {iso_local}.")
                            else:
                                log.warning(f"[sAutoniax] proxy natif '{nom_profil}' -- heure du mAutoniax non reçue (mAutoniax non à jour, ou trame HORLOGE pas encore arrivée).")
                        except Exception as e:
                            log.warning(f"[sAutoniax] proxy natif '{nom_profil}' -- erreur inattendue lors de la vérification de l'heure du mAutoniax : {e!r}")
                else:
                    await relais_proxy_local.arreter_pour_profil(nom_profil)
                client_t.envoyer_toggle_proxy_natif_resultat(
                    id_pilote, nom_profil, actif and not erreur, not erreur, erreur,
                )
            tache = loop.create_task(_executer())
            _taches_projets_en_cours.add(tache)
            tache.add_done_callback(_taches_projets_en_cours.discard)
        loop.call_soon_threadsafe(_programmer)

    client_t.toggle_proxy_natif_demande.connect(_sur_toggle_proxy_natif_demande, Qt.DirectConnection)

    def _sur_telecharger_profil_vers_sautoniax_demande(nom_profil: str, id_pilote: str):
        # PATCH (Patch 4.2 -- bouton "Envoyer du cloud vers ce sAutoniax"
        # du panneau propriétés) : sens INVERSE de upload_profil_vers_
        # cloud_demande ci-dessus. Réutilise _sautoniax_assurer_profil_
        # local TELLE QUELLE (déjà idempotente -- un profil déjà présent
        # localement n'est pas re-téléchargé, cf. sa docstring) : ce
