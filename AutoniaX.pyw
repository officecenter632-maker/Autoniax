# ---------------------------------------------------------------------------
# Lecture du buffer d'écran de la console Windows (AJOUT, demande explicite
# utilisateur : "copier logs du terminal ... sa vas copier les logs dans le
# presse papier", précisé ensuite -- "je dit copier la sortie du terminal
# deja sortie" : le texte DÉJÀ AFFICHÉ dans la fenêtre cmd, pas un nouveau
# système de capture de logs côté AutoniaX). Utilise l'API console de
# kernel32 (GetStdHandle/GetConsoleScreenBufferInfo/
# ReadConsoleOutputCharacterW) pour lire directement la mémoire d'écran que
# Windows tient déjà pour cette fenêtre -- y compris les lignes scrollées
# hors vue, jusqu'à dwSize.Y (hauteur totale du buffer, pas juste la partie
# visible). Aucune ligne n'est journalisée ni écrite sur disque par cette
# fonction : lecture pure, résultat renvoyé tel quel à l'appelant.
# ---------------------------------------------------------------------------
def _lire_buffer_console_windows() -> str:
    """Lit tout le buffer d'écran de la console Windows attachée à ce
    process (celle dans laquelle AutoniaX a été lancé) et le renvoie sous
    forme de texte, une ligne par ligne, espaces de fin de ligne retirés.

    Lève RuntimeError si appelée hors Windows, ou si aucune console n'est
    attachée (ex. AutoniaX lancé en .pyw, ou stdout redirigé vers un
    fichier/pipe sans fenêtre console réelle derrière) -- l'appelant
    (_on_clic_copier_terminal) traduit ça en message utilisateur clair
    plutôt que de laisser remonter une exception ctypes brute."""
    if os.name != "nt":
        raise RuntimeError("lecture du buffer console : Windows uniquement")

    STD_OUTPUT_HANDLE = -11
    INVALID_HANDLE_VALUE = ctypes.c_void_p(-1).value

    kernel32 = ctypes.windll.kernel32
    handle = kernel32.GetStdHandle(STD_OUTPUT_HANDLE)
    if handle in (0, INVALID_HANDLE_VALUE, None):
        raise RuntimeError("aucune console attachée à ce process (GetStdHandle a échoué)")

    class _COORD(ctypes.Structure):
        _fields_ = [("X", ctypes.c_short), ("Y", ctypes.c_short)]

    class _SMALL_RECT(ctypes.Structure):
        _fields_ = [
            ("Left", ctypes.c_short), ("Top", ctypes.c_short),
            ("Right", ctypes.c_short), ("Bottom", ctypes.c_short),
        ]

    class _CONSOLE_SCREEN_BUFFER_INFO(ctypes.Structure):
        _fields_ = [
            ("dwSize", _COORD),
            ("dwCursorPosition", _COORD),
            ("wAttributes", ctypes.c_ushort),
            ("srWindow", _SMALL_RECT),
            ("dwMaximumWindowSize", _COORD),
        ]

    info = _CONSOLE_SCREEN_BUFFER_INFO()
    if not kernel32.GetConsoleScreenBufferInfo(handle, ctypes.byref(info)):
        raise RuntimeError("GetConsoleScreenBufferInfo a échoué (aucune console attachée ?)")

    largeur = info.dwSize.X
    hauteur = info.dwSize.Y  # hauteur TOTALE du buffer, scrollback inclus.
    if largeur <= 0 or hauteur <= 0:
        return ""

    lignes = []
    caracteres_lus = ctypes.c_ulong(0)
    tampon = ctypes.create_unicode_buffer(largeur)
    for y in range(hauteur):
        coord_depart = _COORD(0, y)
        ok = kernel32.ReadConsoleOutputCharacterW(
            handle, tampon, largeur, coord_depart, ctypes.byref(caracteres_lus)
        )
        if not ok:
            break
        lignes.append(tampon.value.rstrip())

    # Retire les lignes vides en fin de buffer (le buffer console est
    # souvent bien plus haut que ce qui a réellement été écrit -- sans
    # ça, le presse-papier serait rempli de milliers de lignes vides
    # après le dernier log réel).
    while lignes and not lignes[-1]:
        lignes.pop()

    return "\n".join(lignes)


