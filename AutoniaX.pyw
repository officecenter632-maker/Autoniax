        )
        self.bouton_selectionner_actifs_profils.setObjectName("ProfilMenuButton")
        self.bouton_selectionner_actifs_profils.setCursor(Qt.PointingHandCursor)
        self.bouton_selectionner_actifs_profils.clicked.connect(self._sur_clic_selectionner_actifs_profils)
        layout_selection.addWidget(self.bouton_selectionner_actifs_profils)

        self.bouton_selectionner_inactifs_profils = QToolButton(self._bloc_selection_masse)
        self.bouton_selectionner_inactifs_profils.setIcon(qta.icon("mdi6.circle-outline", color=Mocha.subtext0))
        self.bouton_selectionner_inactifs_profils.setToolTip(
