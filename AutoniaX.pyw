        self.panneau_recap_selection_batch = QWidget(self.splitter_selection_batch)
        recap_layout = QVBoxLayout(self.panneau_recap_selection_batch)
        recap_layout.setContentsMargins(16, 16, 16, 16)
        recap_layout.setAlignment(Qt.AlignTop)
        recap_titre = QLabel("Ordre d'exécution", self.panneau_recap_selection_batch)
        recap_titre.setObjectName("PlaceholderTitle")
        recap_layout.addWidget(recap_titre)
        recap_sous_titre = QLabel(
            "Les projets cochés s'exécuteront dans l'ordre où vous les "
            "cochez, un par un, sur le même sAutoniax.",
            self.panneau_recap_selection_batch,
        )
        recap_sous_titre.setObjectName("PlaceholderSubtitle")
        recap_sous_titre.setWordWrap(True)
        recap_layout.addWidget(recap_sous_titre)
        self.liste_ordre_selection_batch = QLabel("", self.panneau_recap_selection_batch)
        self.liste_ordre_selection_batch.setObjectName("ReglagesLabel")
        self.liste_ordre_selection_batch.setWordWrap(True)
        recap_layout.addWidget(self.liste_ordre_selection_batch)
        self.splitter_selection_batch.addWidget(self.panneau_recap_selection_batch)

        self.splitter_selection_batch.setStretchFactor(0, 3)
        self.splitter_selection_batch.setStretchFactor(1, 1)
        self.splitter_selection_batch.setVisible(False)
        zone_layout.addWidget(self.splitter_selection_batch, 1)

    def _reload_grille(self):
        self.flow_grid.clear()
        self._projet_batch_cartes = {}
        for projet_batch in self.project.projets_batch:
            carte = ProjetBatchCarte(projet_batch, self.project)
            # PATCH E (E.4) -- routeur unique : _sur_clic_carte_batch décide
            # lui-même, selon self._mode_selection_batch, s'il faut ouvrir
            # la carte ou (dé)cocher la sélection (cf. docstring de
            # ProjetBatchCarte : même signal `clique` pour les deux usages).
            carte.clique.connect(self._sur_clic_carte_batch)
            # Rejoue l'état de mode sélection courant sur toute carte
            # (re)créée par ce rechargement -- une carte fraîchement
            # reconstruite doit refléter un mode sélection déjà actif
            # (ex: création d'un nouveau ProjetBatch pendant qu'on est en
            # train de composer un envoi de batch), avec sa coche à jour
            # si elle était déjà cochée avant le rechargement.
            carte.set_mode_selection(self._mode_selection_batch)
            if projet_batch.id in self._ids_projets_batch_coches:
                carte.set_selectionnee(True)
            self._projet_batch_cartes[projet_batch.id] = carte
            self.flow_grid.add_item(carte)

        # Toute carte disparue (ProjetBatch supprimé) ne doit pas laisser
        # une trace dans la sélection en cours -- purge silencieuse, en
        # préservant l'ordre de coche restant.
        ids_existants = {p.id for p in self.project.projets_batch}
        self._ids_projets_batch_coches = [
            pb_id for pb_id in self._ids_projets_batch_coches if pb_id in ids_existants
        ]

        # PATCH E (E.4) -- reconstruit aussi la vue liste (QSplitter),
        # utilisée à la place de la grille de cartes pendant le mode
        # sélection (cf. _build_grille pour le rôle de chaque colonne).
        # itemChanged bloqué pendant le peuplement : Qt.Checked/Unchecked
        # posé programmatiquement sur chaque QTreeWidgetItem ne doit pas
        # être interprété comme une coche utilisateur par
        # _sur_coche_item_liste_selection_batch (qui, sinon, altérerait
        # self._ids_projets_batch_coches à chaque simple rechargement).
        self.liste_selection_batch.blockSignals(True)
        self.liste_selection_batch.clear()
        for projet_batch in self.project.projets_batch:
            task = self.project.find_task(projet_batch.task_id)
            nom_task = task.nom if task is not None else "(Task non défini)"
            nb_instances = len(projet_batch.instances_selectionnees)
            suffixe = f"{nb_instances} instance(s)" if nb_instances else "aucune instance sélectionnée"
            item = QTreeWidgetItem(self.liste_selection_batch, [projet_batch.nom, f"{nom_task} · {suffixe}"])
            item.setData(0, Qt.UserRole, projet_batch.id)
            item.setFlags(item.flags() | Qt.ItemIsUserCheckable)
            coche = Qt.Checked if projet_batch.id in self._ids_projets_batch_coches else Qt.Unchecked
            item.setCheckState(0, coche)
        self.liste_selection_batch.blockSignals(False)

        vide = len(self.project.projets_batch) == 0
        self.placeholder_widget.setVisible(vide)
        # En mode sélection, la liste (QSplitter) remplace la grille de
        # cartes -- jamais les deux affichées en même temps (cf.
        # _basculer_mode_selection_batch, seul autre endroit qui touche à
        # ces deux visibilités, pour le cas où ce rechargement survient
        # PENDANT le mode sélection, ex: création d'un nouveau ProjetBatch).
        self.grid_scroll.setVisible(not vide and not self._mode_selection_batch)
        self.splitter_selection_batch.setVisible(not vide and self._mode_selection_batch)
        self._maj_recap_ordre_selection_batch()
        # cf. commentaire sur bouton_mode_selection_batch dans _build_grille :
        # désactivé tant qu'il n'y a rien à sélectionner. Ne désactive
        # jamais le bouton PENDANT qu'on est déjà en mode sélection (pour
        # ne pas bloquer la sortie du mode via ce même bouton) -- seulement
        # hors mode sélection, quand il servirait à y entrer.
        if not self._mode_selection_batch:
            self.bouton_mode_selection_batch.setEnabled(not vide)
        self._maj_barre_selection_batch()

    def _basculer_mode_selection_batch(self):
        """PATCH E (E.4) -- bouton bascule de l'en-tête. Entrer/sortir du
        mode sélection multiple. Toujours repart d'une sélection vide en
        ENTRANT (cf. docstring de self._ids_projets_batch_coches :
        ponctuel, jamais préservé d'une session de sélection à l'autre) ;
        SORTIR (via ce même bouton, devenu "Annuler", ou via un envoi
        réussi) vide aussi la sélection par le même mécanisme, cf.
        set_mode_selection(False) sur chaque carte qui déclenche déjà
        set_selectionnee(False).

        Bascule aussi la vue affichée : grille de cartes (défaut) <->
        liste à QSplitter (mode sélection, cf. _build_grille pour la
        justification -- noms longs lisibles/redimensionnables)."""
        self._mode_selection_batch = not self._mode_selection_batch
        if not self._mode_selection_batch:
            self._ids_projets_batch_coches = []

        for carte in self._projet_batch_cartes.values():
            carte.set_mode_selection(self._mode_selection_batch)

        if self._mode_selection_batch:
            self.bouton_mode_selection_batch.setText(" Annuler")
            self.bouton_mode_selection_batch.setIcon(qta.icon("mdi6.close", color=Mocha.crust))
        else:
            self.bouton_mode_selection_batch.setText(" Envoyer un batch")
            self.bouton_mode_selection_batch.setIcon(qta.icon("mdi6.send-outline", color=Mocha.crust))
        self.barre_selection_batch.setVisible(self._mode_selection_batch)

        vide = len(self.project.projets_batch) == 0
        self.grid_scroll.setVisible(not vide and not self._mode_selection_batch)
        self.splitter_selection_batch.setVisible(not vide and self._mode_selection_batch)
        # Repart d'une liste sans coche à chaque entrée/sortie -- même
        # esprit que le vidage de self._ids_projets_batch_coches ci-dessus
        # (blockSignals : poser Qt.Unchecked programmatiquement ne doit
        # pas redéclencher _sur_coche_item_liste_selection_batch).
        self.liste_selection_batch.blockSignals(True)
        for i in range(self.liste_selection_batch.topLevelItemCount()):
            self.liste_selection_batch.topLevelItem(i).setCheckState(0, Qt.Unchecked)
        self.liste_selection_batch.blockSignals(False)

        self._maj_barre_selection_batch()

    def _sur_clic_carte_batch(self, projet_batch_id: str):
        """Routeur unique branché sur ProjetBatchCarte.clique (cf.
        _reload_grille) -- hors mode sélection, comportement inchangé
        (ouvre l'éditeur/suivi) ; en mode sélection, (dé)coche la carte
        à la place, sans jamais ouvrir l'éditeur.

        Hors mode sélection cette méthode est la seule voie de coche
        possible (la liste QSplitter est masquée) ; en mode sélection,
        la grille reste masquée aussi -- ce chemin-ci n'est donc en
        pratique jamais atteint pendant le mode sélection avec la vue
        liste active, gardé néanmoins pour rester robuste si jamais les
        deux visibilités se désynchronisaient."""
        if not self._mode_selection_batch:
            self._ouvrir_projet_batch(projet_batch_id)
            return
        self._basculer_selection_projet_batch(projet_batch_id)

    def _sur_coche_item_liste_selection_batch(self, item: "QTreeWidgetItem", colonne: int):
        """Routeur de coche pour la vue liste (QSplitter), pendant du
        _sur_clic_carte_batch de la grille -- les deux vues partagent le
        même état self._ids_projets_batch_coches, jamais affichées
        simultanément (cf. _basculer_mode_selection_batch)."""
        projet_batch_id = item.data(0, Qt.UserRole)
        if not projet_batch_id:
            return
        coche = item.checkState(0) == Qt.Checked
        deja_coche = projet_batch_id in self._ids_projets_batch_coches
        if coche == deja_coche:
            return  # rechargement programmatique (blockSignals ailleurs) ou aucun changement réel
        self._basculer_selection_projet_batch(projet_batch_id)

    def _basculer_selection_projet_batch(self, projet_batch_id: str):
        """Cœur commun de la (dé)sélection d'un ProjetBatch pour l'envoi
        en batch -- appelé depuis la grille (carte cochée) OU la liste
        (item coché), tient les deux vues synchronisées entre elles peu
        importe laquelle a déclenché le changement."""
        carte = self._projet_batch_cartes.get(projet_batch_id)
        if projet_batch_id in self._ids_projets_batch_coches:
            self._ids_projets_batch_coches.remove(projet_batch_id)
            nouvel_etat = False
        else:
            self._ids_projets_batch_coches.append(projet_batch_id)
            nouvel_etat = True

        if carte is not None:
            carte.set_selectionnee(nouvel_etat)

        self.liste_selection_batch.blockSignals(True)
        for i in range(self.liste_selection_batch.topLevelItemCount()):
            item = self.liste_selection_batch.topLevelItem(i)
            if item.data(0, Qt.UserRole) == projet_batch_id:
                item.setCheckState(0, Qt.Checked if nouvel_etat else Qt.Unchecked)
                break
        self.liste_selection_batch.blockSignals(False)

        self._maj_barre_selection_batch()

    def _maj_barre_selection_batch(self):
        """Tient à jour le label compteur + l'état du bouton "Envoyer (N)"
        de la barre secondaire, ET le récap d'ordre du panneau droit de
        la vue liste -- appelée à chaque bascule de coche et à chaque
        entrée/sortie du mode sélection."""
        n = len(self._ids_projets_batch_coches)
        if n == 0:
            self.label_selection_batch.setText("Aucun projet sélectionné")
        elif n == 1:
            self.label_selection_batch.setText("1 projet sélectionné")
        else:
            self.label_selection_batch.setText(f"{n} projets sélectionnés")
        self.bouton_envoyer_batch_selection.setText(f"Envoyer ({n})")
        self.bouton_envoyer_batch_selection.setEnabled(n > 0)
        self._maj_recap_ordre_selection_batch()

    def _maj_recap_ordre_selection_batch(self):
        """Panneau droit de la vue liste (QSplitter) : rappelle l'ordre
        d'exécution résultant de l'ordre de coche courant, par nom (les
        ids seuls ne diraient rien à l'utilisateur)."""
        if not self._ids_projets_batch_coches:
            self.liste_ordre_selection_batch.setText("(aucun projet coché pour l'instant)")
            return
        lignes = []
        for i, pb_id in enumerate(self._ids_projets_batch_coches, start=1):
            projet_batch = self.project.find_projet_batch(pb_id)
            nom = projet_batch.nom if projet_batch is not None else pb_id
            lignes.append(f"{i}. {nom}")
        self.liste_ordre_selection_batch.setText("\n".join(lignes))

    def _on_clic_envoyer_batch_selection(self):
        """PATCH E (E.4) -- validation de la sélection multiple : ouvre
        DialogueEnvoiSautoniax (réutilisé tel quel, profils en pool
        global -- cf. cahier des charges) puis émet
        demande_envoi_batch_sautoniax avec l'ordre d'exécution voulu.

        Ordre : celui dans lequel les ProjetBatch ont été COCHÉS (pas
        l'ordre d'affichage de la grille) -- le plus prévisible du point
        de vue utilisateur : "j'ai cliqué sur A puis B" = "A s'exécute
        avant B" sur le sAutoniax cible."""
        if not self._ids_projets_batch_coches:
            self._notify_status("Cochez au moins un Projet Batch avant d'envoyer.", error=True)
            return
        if not self._executants_disponibles:
            BoiteDialogueAutoniaX.warning(self, "Aucun sAutoniax connecté", "Aucun sAutoniax n'est actuellement connecté au serveurT.")
            return

        # Validation de conformité minimale par ProjetBatch coché, même
        # règles que _on_clic_envoyer_sautoniax mono-projet -- un batch ne
        # doit pas être envoyé avec un membre incomplet (Task manquant ou
        # dossier racine invalide), sans quoi MainWindow._sur_demande_envoi_
        # batch_sautoniax rejetterait de toute façon tout le batch en
        # cours de résolution, mais avec un message moins précis pour
        # l'utilisateur ici.
        noms_invalides = []
        for pb_id in self._ids_projets_batch_coches:
            projet_batch = self.project.find_projet_batch(pb_id)
            if projet_batch is None:
                continue
            if not projet_batch.task_id:
                noms_invalides.append(f"{projet_batch.nom} (Task manquant)")
            elif not projet_batch.chemin_racine or not Path(projet_batch.chemin_racine).is_dir():
                noms_invalides.append(f"{projet_batch.nom} (dossier racine invalide)")
        if noms_invalides:
            BoiteDialogueAutoniaX.warning(
                self, "Projets incomplets",
                "Corrigez ces Projets Batch avant de les envoyer :\n- " + "\n- ".join(noms_invalides),
            )
            return

        dialogue = DialogueEnvoiSautoniax(self._executants_disponibles, self._profils_cloud_disponibles, self)
        if dialogue.exec() != QDialog.Accepted:
            return
        id_executant = dialogue.id_executant_choisi()
        profils_coches = dialogue.profils_coches()
        if not id_executant:
            BoiteDialogueAutoniaX.warning(self, "Aucune cible", "Choisissez un sAutoniax cible.")
            return
        if not profils_coches:
            BoiteDialogueAutoniaX.warning(self, "Aucun profil", "Cochez au moins un profil cloud à utiliser.")
            return

        # Ordre d'envoi = ordre RÉEL de coche (self._ids_projets_batch_coches
        # est une list qui préserve l'ordre d'insertion, cf. son
        # commentaire dans __init__) -- pas l'ordre d'affichage de la
        # grille. Copie défensive : _basculer_mode_selection_batch juste
        # en dessous vide self._ids_projets_batch_coches, on ne veut pas
        # émettre une liste qui se retrouve vidée sous nos pieds si le
        # signal est traité en synchrone par un slot connecté avant que
        # la ligne suivante ne s'exécute.
        ids_ordonnes = list(self._ids_projets_batch_coches)

        self.demande_envoi_batch_sautoniax.emit(id_executant, ids_ordonnes, profils_coches)

        # Envoi lancé -- referme proprement le mode sélection (même
        # comportement que si l'utilisateur avait cliqué "Annuler").
        self._basculer_mode_selection_batch()
        self._notify_status(f"Envoi du batch ({len(ids_ordonnes)} projet(s)) lancé.")

    def _creer_projet_batch(self):
        base = "Nouveau Projet Batch"
        candidat = base
        i = 1
        noms_existants = {p.nom for p in self.project.projets_batch}
        while candidat in noms_existants:
            i += 1
            candidat = f"{base} {i}"
        projet_batch = self.project.add_projet_batch(candidat)
        self.project.save()
        self._reload_grille()
        self._ouvrir_projet_batch(projet_batch.id)

    def _retour_grille(self):
        # Un batch en cours d'exécution continue de tourner même si
        # l'utilisateur revient à la grille -- MoteurExecutionBatch ne
        # dépend d'aucun widget affiché (cf. section 5 du patch,
        # exécution headless), seuls les signaux sous_projet_maj/
        # batch_termine ne seront simplement plus écoutés tant que cet
        # écran n'est pas rouvert (reconnectés à la réouverture, cf.
        # _ouvrir_projet_batch). Pas d'arrêt implicite du batch juste en
        # quittant l'écran -- serait surprenant pour l'utilisateur qui
        # attend un traitement de fond, pas une exécution couplée à
        # l'affichage.
        self._deconnecter_signaux_moteur_affiche()
        # PATCH -- instance_apercu_batch ne porte plus aucun rendu visuel
        # (cf. docstring de _build_apercu_execution), suspendre_streaming()
        # reste un no-op inoffensif ici (aucun streaming n'est jamais
        # démarré dessus désormais) -- gardé par simple prudence plutôt
        # que de retirer cet appel.
        if hasattr(self, "instance_apercu_batch"):
            self.instance_apercu_batch.suspendre_streaming()
        self._projet_batch_courant = None
        self._reload_grille()
        self.stack.setCurrentWidget(self.grille_page)

    # ------------------------------------------------------------------
    # Vue éditeur (ouverte au clic sur une card) : toolbar + config + mapping
    # + suivi/démarrage, tout au même endroit (cf. décision utilisateur,
    # docstring de classe). Squelette toolbar copié de
    # TaskConfigScreen._build_editeur.
    # ------------------------------------------------------------------
    def _build_editeur(self):
        self.editeur_page = QWidget(self)
        outer_layout = QVBoxLayout(self.editeur_page)
        outer_layout.setContentsMargins(0, 0, 0, 0)
        outer_layout.setSpacing(0)

        # --- Barre d'outils du haut (retour + nom inline) -- commune aux
        # deux onglets ci-dessous, reste au-dessus du QTabWidget. ---
        toolbar = QWidget(self.editeur_page)
        toolbar.setObjectName("APIFeaturesEditeurToolbar")
        toolbar_layout = QHBoxLayout(toolbar)
        toolbar_layout.setContentsMargins(16, 12, 16, 12)
        toolbar_layout.setSpacing(14)

        self.retour_button = QToolButton(toolbar)
        self.retour_button.setObjectName("RetourButton")
        self.retour_button.setIcon(qta.icon("mdi6.arrow-left", color=Mocha.subtext0))
        self.retour_button.setIconSize(QSize(18, 18))
        self.retour_button.setCursor(Qt.PointingHandCursor)
        self.retour_button.setToolTip("Retour à la liste des Projets Batch")
        self.retour_button.clicked.connect(self._retour_grille)
        toolbar_layout.addWidget(self.retour_button)

        nom_label = QLabel("Nom :", toolbar)
        nom_label.setObjectName("ReglagesLabel")
        toolbar_layout.addWidget(nom_label)

        self.nom_edit = QLineEdit(toolbar)
        self.nom_edit.setObjectName("APIFeaturesNomEdit")
        self.nom_edit.setFixedWidth(240)
        self.nom_edit.editingFinished.connect(self._on_nom_edited)
        toolbar_layout.addWidget(self.nom_edit)

        toolbar_layout.addStretch(1)

        self.bouton_supprimer_projet = QToolButton(toolbar)
        self.bouton_supprimer_projet.setObjectName("RetourButton")
        self.bouton_supprimer_projet.setIcon(qta.icon("mdi6.trash-can-outline", color=Mocha.red))
        self.bouton_supprimer_projet.setIconSize(QSize(18, 18))
        self.bouton_supprimer_projet.setCursor(Qt.PointingHandCursor)
        self.bouton_supprimer_projet.setToolTip("Supprimer ce Projet Batch")
        self.bouton_supprimer_projet.clicked.connect(self._supprimer_projet_batch)
        toolbar_layout.addWidget(self.bouton_supprimer_projet)

        outer_layout.addWidget(toolbar)

        # --- Onglets Config / Aperçu d'exécution (cf. Brique F du plan de
        # patch, onglet "Aperçu d'exécution" ajouté À CÔTÉ de l'éditeur de
        # config existant, jamais à sa place) ---
        self.editeur_tabs = QTabWidget(self.editeur_page)
        self.editeur_tabs.setObjectName("ProjetBatchEditeurTabs")
        self.editeur_tabs.currentChanged.connect(self._sur_changement_onglet_editeur)
        outer_layout.addWidget(self.editeur_tabs, 1)

        # --- Onglet "Config" : contenu scrollable existant (config,
        # mapping, suivi/démarrage), inchangé -- simplement déplacé DANS
        # le premier onglet plutôt que directement dans outer_layout. ---
        contenu_scroll = QScrollArea(self.editeur_tabs)
        contenu_scroll.setObjectName("FlowGridViewport")
        contenu_scroll.setWidgetResizable(True)
        contenu_scroll.setFrameShape(QFrame.NoFrame)
        contenu_scroll.setHorizontalScrollBarPolicy(Qt.ScrollBarAlwaysOff)

        contenu = QWidget(contenu_scroll)
        contenu_layout = QVBoxLayout(contenu)
        contenu_layout.setContentsMargins(28, 20, 28, 28)
        contenu_layout.setSpacing(22)
        contenu_scroll.setWidget(contenu)

        contenu_layout.addWidget(self._build_bloc_config(contenu))
        contenu_layout.addWidget(self._build_bloc_mapping(contenu))
        contenu_layout.addWidget(self._build_bloc_suivi(contenu))
        contenu_layout.addStretch(1)

        self.editeur_tabs.addTab(contenu_scroll, "Config")
        self.editeur_tabs.addTab(self._build_apercu_execution(), "Aperçu d'exécution")

    # --- Bloc config : Task / N instances / mode / dossier racine ---
    def _build_bloc_config(self, parent) -> QWidget:
        bloc = QWidget(parent)
        layout = QVBoxLayout(bloc)
        layout.setContentsMargins(0, 0, 0, 0)
        layout.setSpacing(10)

        titre = QLabel("Configuration", bloc)
        titre.setObjectName("PlaceholderTitle")
        layout.addWidget(titre)

        # Task (parmi les Tasks existants du Project) -- fixe après création
        # (décision explicite utilisateur, cf. section 1 du patch : "un
        # projet = un seul Task, choisi à la création et fixe ensuite").
        # Reste néanmoins modifiable ici tant qu'aucun mapping n'a encore de
        # sens (changer de Task change forcément l'ensemble des variables
        # dynamiques détectées, cf. _rafraichir_variables_detectees) -- le
        # patch ne l'interdit pas explicitement après coup, seulement "un
        # seul Task actif à la fois", donc changer de sélection reste permis,
        # mais réinitialise alors le mapping existant (cf. _on_task_changed).
        task_label = QLabel("Task à exécuter", bloc)
        task_label.setObjectName("ReglagesLabel")
        layout.addWidget(task_label)

        self.task_combo = QComboBox(bloc)
        self.task_combo.setObjectName("ReglagesCombo")
        self.task_combo.currentIndexChanged.connect(self._on_task_changed)
        layout.addWidget(self.task_combo)

        # Sélection d'instances déjà lancées (RÉVISION -- décision explicite
        # utilisateur, remplace l'ancien "nombre d'instances parallèles" +
        # "mode d'orchestration") : l'utilisateur coche, parmi les instances
        # actuellement connectées au serveur (cf. ProfilsInstancesScreen,
        # même protocole liste_instances_recue), celles qui seront
        # RÉUTILISÉES pour ce batch -- ce n'est plus un chiffre saisi à la
        # main, et le moteur ne lance plus aucune instance lui-même (cf.
        # MoteurExecutionBatch). Mode "pool" implicite désormais (round
        # retiré, cf. sa docstring) -- plus rien à choisir ici pour ça.
        instances_label = QLabel("Instances à utiliser (déjà lancées, cochez celles à réutiliser)", bloc)
        instances_label.setObjectName("ReglagesLabel")
        layout.addWidget(instances_label)

        self.liste_instances_batch = QListWidget(bloc)
        self.liste_instances_batch.setObjectName("ServiceAPIList")
        self.liste_instances_batch.setFixedHeight(120)
        self.liste_instances_batch.itemChanged.connect(self._on_instance_batch_item_changed)
        # PATCH (demande utilisateur explicite : "je veux aussi que les
        # profils s'affichent sur ... 5 colonne et non ranger sur une
        # seule colonne") -- même principe que ProfilsInstancesScreen.
        # liste_instances (cf. _recalculer_grille_profils), mais en plus
        # léger : pas de delegate custom ici (les items restent du texte
        # + checkbox standard Qt, pas des cartes stylées), juste le
        # bascule en mode grille (IconMode + LeftToRight + Wrapping) et
        # un gridSize recalculé dynamiquement (cf.
        # _recalculer_grille_instances_batch, appelée au premier show et
        # à chaque resize via eventFilter ci-dessous) pour tenir
        # NB_COLONNES_INSTANCES_BATCH colonnes quelle que soit la largeur
        # du panneau.
        self.liste_instances_batch.setViewMode(QListWidget.IconMode)
        self.liste_instances_batch.setFlow(QListWidget.LeftToRight)
        self.liste_instances_batch.setWrapping(True)
        self.liste_instances_batch.setResizeMode(QListWidget.Adjust)
        self.liste_instances_batch.setMovement(QListWidget.Static)
        self.liste_instances_batch.setUniformItemSizes(True)
        self.liste_instances_batch.setSpacing(0)
