        # l'intention "vraiment global" sans dépendre de ce détail
        # d'architecture actuel.
        self._raccourci_fermeture_app = QShortcut(self)
        self._raccourci_fermeture_app.setContext(Qt.ApplicationShortcut)
        self._raccourci_fermeture_app.activated.connect(self.close)
        self._rafraichir_raccourci_fermeture_app()
        # AJOUT (demande explicite utilisateur : "je veux aussi un
        # raccourci pour mettre à jour AutoniaX directement sur le
        # cloud") -- même patron EXACT que _raccourci_fermeture_app
        # juste au-dessus (QShortcut global, context=Qt.ApplicationShortcut,
        # cf. docstring DEFAULT_RACCOURCIS_APP["mettre_a_jour_autoniax_
        # cloud"]). activated -> _sur_raccourci_mettre_a_jour_autoniax_
        # cloud (pas directement envoyer_mise_a_jour_app : il faut
        # d'abord vérifier la connexion et afficher le message "en
        # cours", cf. sa docstring).
        self._raccourci_maj_autoniax_cloud = QShortcut(self)
        self._raccourci_maj_autoniax_cloud.setContext(Qt.ApplicationShortcut)
        self._raccourci_maj_autoniax_cloud.activated.connect(
            self._sur_raccourci_mettre_a_jour_autoniax_cloud
        )
        self._rafraichir_raccourci_maj_autoniax_cloud()
        # AJOUT (demande explicite utilisateur : "raccourir pour
        # redemarer tout les Sautoniax") -- même patron EXACT que
        # _raccourci_maj_autoniax_cloud juste au-dessus (QShortcut
        # global, context=Qt.ApplicationShortcut, cf. docstring
        # DEFAULT_RACCOURCIS_APP["redemarrer_tous_sautoniax"]).
        self._raccourci_redemarrer_tous_sautoniax = QShortcut(self)
        self._raccourci_redemarrer_tous_sautoniax.setContext(Qt.ApplicationShortcut)
        self._raccourci_redemarrer_tous_sautoniax.activated.connect(
            self._sur_raccourci_redemarrer_tous_sautoniax
        )
        self._rafraichir_raccourci_redemarrer_tous_sautoniax()
        # AJOUT (demande explicite utilisateur : "mettre un raccourci de
        # redémarrage de l'app AutoniaX") -- même patron EXACT que
        # _raccourci_redemarrer_tous_sautoniax juste au-dessus (QShortcut
        # global, context=Qt.ApplicationShortcut, cf. docstring
        # DEFAULT_RACCOURCIS_APP["redemarrer_application_autoniax"] pour
        # la distinction avec redemarrer_tous_sautoniax : celui-ci
        # redémarre CE process-ci, pas les sAutoniax distants).
        self._raccourci_redemarrer_application = QShortcut(self)
        self._raccourci_redemarrer_application.setContext(Qt.ApplicationShortcut)
        self._raccourci_redemarrer_application.activated.connect(
            self._sur_raccourci_redemarrer_application
        )
        self._rafraichir_raccourci_redemarrer_application()
        # CORRECTIF (bug rapporté : raccourci copier_doc_ia configuré
        # -- ex. Ctrl+Shift+D -- mais qui ne se déclenche jamais). Cause
        # de fond : posé initialement comme raccourci "Interne" (testé
        # dans MainWindow.keyPressEvent, cf. plus bas), MAIS le focus
        # clavier au moment où l'utilisateur tape un raccourci pendant
        # qu'il édite une Task est presque toujours dans TaskScriptEditor
        # (la zone de texte de la cellule) -- or TaskScriptEditor.
        # keyPressEvent (cf. sa définition) se termine par
        # `super().keyPressEvent(event)` (QPlainTextEdit), qui CONSOMME
        # l'événement pour CE WIDGET précis. En Qt, keyPressEvent ne
        # "remonte" JAMAIS automatiquement d'un widget enfant vers sa
        # fenêtre parente comme un événement DOM en JS -- `super()` ici
        # appelle la classe de BASE du même widget (QPlainTextEdit), pas
        # MainWindow. Résultat : MainWindow.keyPressEvent n'est jamais
        # atteint tant que le focus est dans l'éditeur de code, donc le
        # raccourci "Interne" ne se déclenchait jamais en pratique --
        # exactement le même problème que fermeture_app a déjà résolu en
        # QShortcut global (cf. sa docstring un peu plus haut : "doit
        # rester actif même si le focus clavier est profondément imbriqué
        # dans un widget enfant"). Fix : même patron EXACT que
        # _raccourci_maj_autoniax_cloud/_raccourci_redemarrer_tous_
        # sautoniax au-dessus (QShortcut global, context=
        # Qt.ApplicationShortcut -- un QShortcut, contrairement à
        # keyPressEvent, EST livré directement par Qt à tous les widgets
        # enfants AVANT leur propre keyPressEvent, cf. doc Qt sur la
        # gestion des raccourcis). La garde de page active (contenu
        # réservé à l'éditeur de Task) est déplacée DANS le handler
        # _sur_raccourci_copier_doc_ia ci-dessous plutôt que testée ici :
        # un QShortcut global se déclenche partout, donc le filtrage
        # "page active" doit se faire après coup.
        self._raccourci_copier_doc_ia = QShortcut(self)
        self._raccourci_copier_doc_ia.setContext(Qt.ApplicationShortcut)
        self._raccourci_copier_doc_ia.activated.connect(
            self._sur_raccourci_copier_doc_ia
        )
        self._rafraichir_raccourci_copier_doc_ia()
        # AJOUT (demande explicite utilisateur : "je veux aussi que tu
        # ajoute des raccourcis de copie de fichier .py du code du
        # notebook comme son bouton le fait, tu ajoute aussi un raccourci
        # pour le collage du code notebook") -- même patron EXACT que
        # _raccourci_copier_doc_ia juste au-dessus (QShortcut global,
        # context=Qt.ApplicationShortcut, garde de page active déplacée
        # dans le handler, cf. docstring DEFAULT_RACCOURCIS_APP
        # ["notebook_copier_fichier_py"]).
        self._raccourci_notebook_copier_fichier_py = QShortcut(self)
        self._raccourci_notebook_copier_fichier_py.setContext(Qt.ApplicationShortcut)
        self._raccourci_notebook_copier_fichier_py.activated.connect(
            self._sur_raccourci_notebook_copier_fichier_py
        )
        self._rafraichir_raccourci_notebook_copier_fichier_py()
        # AJOUT (même demande explicite utilisateur, symétrique pour le
        # collage) -- même patron EXACT que _raccourci_notebook_copier_
        # fichier_py juste au-dessus.
        self._raccourci_notebook_coller = QShortcut(self)
        self._raccourci_notebook_coller.setContext(Qt.ApplicationShortcut)
        self._raccourci_notebook_coller.activated.connect(
            self._sur_raccourci_notebook_coller
        )
        self._rafraichir_raccourci_notebook_coller()
        # AJOUT (demande explicite utilisateur : "je veux que tu creer la
        # possibiliter de mettre un raccourci clavier pour mettre a jour
        # projet.json seule, et service api seule") -- même patron EXACT
        # que _raccourci_copier_doc_ia juste au-dessus (QShortcut global,
        # context=Qt.ApplicationShortcut, garde de page active déplacée
        # dans le handler) plutôt que "Interne"/keyPressEvent : POSÉS
        # D'EMBLÉE en QShortcut global, jamais testés dans keyPressEvent
        # (contrairement à la première version de copier_doc_ia, cf. son
        # commentaire CORRECTIF ci-dessus) -- le focus clavier pendant
        # l'édition d'une Task est presque toujours dans TaskScriptEditor
        # (QPlainTextEdit), qui consomme l'événement avant qu'il
        # n'atteigne jamais MainWindow.keyPressEvent.
        self._raccourci_sync_service_api_seul = QShortcut(self)
        self._raccourci_sync_service_api_seul.setContext(Qt.ApplicationShortcut)
        self._raccourci_sync_service_api_seul.activated.connect(
            self._sur_raccourci_sync_service_api_seul
        )
        self._rafraichir_raccourci_sync_service_api_seul()
        self._raccourci_sync_project_json_seul = QShortcut(self)
        self._raccourci_sync_project_json_seul.setContext(Qt.ApplicationShortcut)
        self._raccourci_sync_project_json_seul.activated.connect(
            self._sur_raccourci_sync_project_json_seul
        )
        self._rafraichir_raccourci_sync_project_json_seul()
        # AJOUT (demande explicite utilisateur : raccourci du toggle
        # "Réduire en arrière-plan", onglet Général) -- même patron
        # EXACT que _raccourci_redemarrer_application au-dessus
        # (QShortcut global, context=Qt.ApplicationShortcut, combo vide
        # par défaut -- l'utilisateur personnalise lui-même via l'onglet
        # Raccourcis, "Modifier"). activated -> _sur_raccourci_toujours_
        # arriere_plan_toggle, qui bascule ReglagesApp.toujours_
        # arriere_plan puis réduit/restaure la fenêtre EN DIRECT (cf.
        # _appliquer_toujours_arriere_plan plus bas -- réduction simple
        # ou restauration au premier plan ponctuelle, plus de flag de
        # calque permanent).
        self._raccourci_toujours_arriere_plan = QShortcut(self)
        self._raccourci_toujours_arriere_plan.setContext(Qt.ApplicationShortcut)
        self._raccourci_toujours_arriere_plan.activated.connect(
            self._sur_raccourci_toujours_arriere_plan_toggle
        )
        self._rafraichir_raccourci_toujours_arriere_plan()
        # PATCH (demande explicite utilisateur : "le raccourci ne
        # fonctionne pas quand la fenêtre est réduite ... utilise
        # pynput") -- EN PLUS du QShortcut Qt ci-dessus (qui couvre le
        # cas normal, fenêtre non minimisée, et reste utile tel quel),
        # on démarre un listener pynput GLOBAL dédié à CE SEUL raccourci :
        # lui seul reçoit l'appui clavier une fois la fenêtre minimisée
        # (Qt ne route plus aucun raccourci à une fenêtre sans focus
        # natif). cf. _demarrer_hotkey_globale_arriere_plan plus bas.
        self._hotkey_globale_arriere_plan = None
        self._pont_hotkey_globale_arriere_plan = None
        self._demarrer_hotkey_globale_arriere_plan()
        # Applique dès la construction l'état persisté du réglage (cf.
        # ReglagesApp.toujours_arriere_plan) -- une session précédente
        # fermée alors que la fenêtre était réduite la retrouve réduite
        # dès l'ouverture, pas seulement après une bascule manuelle du
        # toggle/raccourci.
        self._appliquer_toujours_arriere_plan(self.reglages.toujours_arriere_plan)
        # État d'agrégation du redémarrage en masse (cf. docstring de
        # _sur_raccourci_redemarrer_tous_sautoniax) -- None tant qu'aucune
        # salve n'est en cours.
        self._redemarrage_masse_en_cours = None
        # Le signal raccourcis_app_changes est porté par ParametresScreen
        # (émis à chaque modification/reset réel d'un raccourci depuis
        # l'onglet Raccourcis) -- ParametresScreen n'existe qu'après
        # _build_screens() (cf. self.screens["parametres"] plus bas dans
        # cette méthode), donc la connexion se fait à la toute fin de
        # __init__ plutôt qu'ici, juste après sa construction.

    def _rafraichir_raccourci_fermeture_app(self):
        """(Re)synchronise le QKeySequence du QShortcut "fermeture_app"
        sur le combo actuellement configuré (fichier raccourcis_app.json
        via charger_raccourcis_app(), Ctrl+Echap par défaut) -- appelée
        une première fois à la construction, puis à chaque changement
        réel de raccourci (cf. connexion à raccourcis_app_changes plus
        bas dans __init__) pour qu'une réassignation depuis l'onglet
        Raccourcis prenne effet immédiatement, sans attendre un
        redémarrage de l'app. Un combo vide/invalide désactive le
        raccourci plutôt que de lever (cohérent avec le comportement
        défensif de _touche_correspond_au_raccourci pour les raccourcis
        "internes")."""
        combo = charger_raccourcis_app().get("fermeture_app", {}).get("combo", "")
        try:
            ks = QKeySequence(combo) if combo else QKeySequence()
        except Exception:
            ks = QKeySequence()
        self._raccourci_fermeture_app.setKey(ks)
        self._raccourci_fermeture_app.setEnabled(not ks.isEmpty())

