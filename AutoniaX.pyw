def synchroniser_service_api_dir() -> Path:
    """CORRECTIF (retour utilisateur : "je croyais que lors du demarrage
    de lapp tout sa etait deja gerer" -- au sujet des templates de
    composants absents du dossier service API envoyé aux sAutoniax).

    Cause : get_service_api_dir() (§4.7, "nécessaire au template
    matching des tâches exécutées à distance") et get_app_data_dir() /
    "components" / <NomServiceAPI> (où les images de composants sont
    RÉELLEMENT stockées côté pilote, cf. Composant.variantes/
    get_components_dir) sont deux dossiers PHYSIQUEMENT SÉPARÉS -- aucun
    code n'a jamais copié l'un vers l'autre, contrairement à ce que sa
    docstring annonçait. Un dossier service_api envoyé à un sAutoniax
    était donc vide de tout template tant que personne n'y copiait rien
    manuellement.

    Corrigé ICI plutôt que dans get_service_api_dir() elle-même (celle-ci
    reste un simple accesseur de chemin, appelé aussi côté sAutoniax où
    "components" n'existe pas et n'a pas de sens à synchroniser) : copie
    TOUT "components/" (tous les ServiceAPI confondus -- plus simple et
    plus sûr qu'une sélection par Task.services_api_importes, qui peut
    varier d'un Task à l'autre alors qu'UN SEUL dossier service_api.zip
    de référence est partagé par tous) vers get_service_api_dir(),
    fichier par fichier, en ne réécrivant que ce qui a changé (mtime/
    taille) -- pas un miroir destructif : un ancien template renommé/
    supprimé côté "components/" reste présent ici tant qu'aucun nettoyage
    explicite n'est demandé (hors scope de ce correctif, cohérent avec
    l'esprit prudent du reste du fichier, ex. restaurer_depuis_corbeille).

    Appelée automatiquement juste AVANT chaque point d'envoi du dossier
    service API (mise à jour service API par ligne/en masse de l'onglet
    Instances, ET bouton "Mise à jour Système" > service_api.zip) --
    plus jamais besoin d'une copie manuelle. Retourne get_service_api_
    dir() elle-même (pratique pour l'appelant, qui veut de toute façon
    son chemin juste après avoir synchronisé)."""
    dossier_composants = get_app_data_dir() / "components"
    dossier_service_api = get_service_api_dir()
    log.info(f"[DIAG-SYNC] synchroniser_service_api_dir : dossier_composants={dossier_composants} (exists={dossier_composants.exists()}) dossier_service_api={dossier_service_api}")
    if not dossier_composants.exists():
        return dossier_service_api
    for chemin_source in dossier_composants.rglob("*"):
        if chemin_source.is_dir():
            continue
        chemin_relatif = chemin_source.relative_to(dossier_composants)
        # BUG FIX (demande explicite utilisateur : "sync api" envoyait
        # aussi les images de test des ComposantLayout -- cf.
        # get_composant_layout_tests_dir, components/<ServiceAPI>/
        # <nom_court>_tests/*.png -- qui n'ont AUCUNE utilité côté
        # sAutoniax : elles ne servent qu'à l'écran "Données de test" de
        # ComposantLayoutConfigScreen, ici en local, jamais au template
        # matching réellement exécuté à distance. Elles peuvent être très
        # nombreuses/lourdes (un cL peut accumuler des dizaines de
        # captures de test), d'où l'alourdissement inutile du dossier/zip
        # envoyé. On exclut ICI, dans la boucle de copie elle-même
        # (plutôt que par un post-traitement qui purgerait après coup) :
        # tout segment du chemin relatif qui se termine par "_tests" est
        # un dossier de données de test (seule origine possible de ce
        # suffixe dans components/, cf. get_composant_layout_tests_dir),
        # donc on saute le fichier sans le copier ni le comptabiliser.
        if any(segment.endswith("_tests") for segment in chemin_relatif.parts[:-1]):
            continue
        chemin_dest = dossier_service_api / "components" / chemin_relatif
        if "nouveauserviceapi" in str(chemin_relatif).lower():
            try:
                noms_reels_dossier = sorted(os.listdir(chemin_source.parent))
            except OSError as e:
                noms_reels_dossier = [f"<erreur listdir: {e!r}>"]
            log.info(
                f"[DIAG-SYNC] Fichier trouvé par rglob -- "
                f"chemin_source={chemin_source!s} "
                f"nom_tel_que_rglob_le_voit={chemin_source.name!r} "
                f"chemin_relatif={chemin_relatif!s} "
                f"chemin_dest={chemin_dest!s} "
                f"contenu_reel_du_dossier_parent={noms_reels_dossier!r}"
            )
        try:
            # CORRECTIF (bug de casse Windows->Linux) : chemin_dest.exists()
            # renvoie True sur un FS insensible à la casse (Windows/macOS)
            # même quand le fichier RÉELLEMENT présent sur disque ne
            # diffère de chemin_dest.name que par la casse -- ex. le
            # fichier physique est "...composant1.png" (minuscule, déposé
            # là avant un renommage) alors que chemin_source (donc
            # chemin_dest voulu) est "...Composant1.png" (majuscule,
            # casse actuelle et correcte). Comme taille/mtime du fichier
            # minuscule "faisaient illusion" (copie antérieure du même
            # contenu), la copie était sautée et la MAUVAISE casse restait
            # définitivement dans service_api/ -- invisible sur Windows,
            # mais le zip envoyé à un sAutoniax Linux (sensible à la
            # casse) référence alors un fichier qui n'existe pas sous ce
            # nom exact. On détecte ce cas en comparant le nom réellement
            # présent dans le dossier destination (listdir, casse exacte
            # du FS) au nom voulu -- indépendamment de exists().
            noms_reels_dest = {
                p.lower(): p for p in os.listdir(chemin_dest.parent)
            } if chemin_dest.parent.is_dir() else {}
            nom_reel_existant = noms_reels_dest.get(chemin_dest.name.lower())
            divergence_casse = (
                nom_reel_existant is not None and nom_reel_existant != chemin_dest.name
            )
            if chemin_dest.exists() and not divergence_casse:
                stat_source, stat_dest = chemin_source.stat(), chemin_dest.stat()
                if stat_source.st_size == stat_dest.st_size and stat_source.st_mtime <= stat_dest.st_mtime:
                    if "nouveauserviceapi" in str(chemin_relatif).lower():
                        log.info(f"[DIAG-SYNC] '{chemin_relatif}' : SKIP copie (déjà à jour, taille={stat_source.st_size} mtime_src={stat_source.st_mtime} mtime_dst={stat_dest.st_mtime})")
                    continue  # déjà à jour -- évite de réécrire des centaines de PNG identiques à chaque envoi
            chemin_dest.parent.mkdir(parents=True, exist_ok=True)
            if divergence_casse:
                # Le fichier présent sur disque a la mauvaise casse : on le
                # supprime avant de recopier avec le nom exact voulu, pour
                # éviter qu'une copie directe soit un no-op silencieux
                # (mêmes limites qu'un rename() sur FS insensible à la
                # casse -- shutil.copy2 vers un nom qui ne diffère que par
                # la casse écrirait dans l'entrée existante SANS renommer
                # l'entrée de répertoire elle-même sur certains FS).
                ancien_chemin_reel = chemin_dest.parent / nom_reel_existant
                log.info(f"[DIAG-SYNC] '{chemin_relatif}' : divergence de casse détectée -- fichier réel='{nom_reel_existant}' voulu='{chemin_dest.name}' -> suppression puis recopie")
                ancien_chemin_reel.unlink()
            shutil.copy2(chemin_source, chemin_dest)
            if "nouveauserviceapi" in str(chemin_relatif).lower():
                log.info(f"[DIAG-SYNC] '{chemin_relatif}' : COPIÉ vers {chemin_dest!s} (divergence_casse_corrigee={divergence_casse!r})")
        except OSError as e:
            log.warning(f"[service_api] échec de synchronisation de '{chemin_relatif}' : {e!r}")
    if "nouveauserviceapi" in str(dossier_composants).lower() or True:
        dossier_cible_diag = dossier_service_api / "components" / "NouveauServiceAPI"
        if dossier_cible_diag.exists():
            log.info(f"[DIAG-SYNC] Contenu RÉEL final de {dossier_cible_diag!s} (os.listdir) = {sorted(os.listdir(dossier_cible_diag))!r}")
        dossier_source_diag = dossier_composants / "NouveauServiceAPI"
        if dossier_source_diag.exists():
            log.info(f"[DIAG-SYNC] Contenu RÉEL source {dossier_source_diag!s} (os.listdir) = {sorted(os.listdir(dossier_source_diag))!r}")

    # NETTOYAGE (suite du BUG FIX ci-dessus) : purge les dossiers
    # "*_tests" déjà présents côté dossier_service_api (résidus d'envois
    # antérieurs à ce correctif, avant qu'on ne les exclue de la copie
    # plus haut). Sans ce nettoyage, la boucle ci-dessus les ignore
    # simplement désormais (elle ne les copie plus) mais ne les
    # supprime pas non plus -- ils resteraient piégés définitivement
    # dans dossier_service_api, alourdissant quand même le service_api.zip
    # envoyé, ce qui est exactement ce que ce correctif doit éviter.
    # Exception assumée et scoped au seul motif "*_tests" à l'esprit
    # généralement non-destructif de cette fonction (cf. docstring) --
    # ces dossiers n'ont plus aucune utilité côté sAutoniax et n'ont
    # jamais été censés y être envoyés.
    dossier_components_dest = dossier_service_api / "components"
    if dossier_components_dest.exists():
        for chemin_dest_existant in dossier_components_dest.rglob("*_tests"):
            if chemin_dest_existant.is_dir():
                try:
                    shutil.rmtree(chemin_dest_existant)
                    log.info(f"[SYNC] Dossier de test résiduel purgé côté service_api : {chemin_dest_existant!s}")
                except OSError as e:
                    log.warning(f"[service_api] échec de purge du dossier de test '{chemin_dest_existant}' : {e!r}")

    return dossier_service_api


