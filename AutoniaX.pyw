    def _construire_onglet_raccourcis(self) -> QWidget:
        """Gestionnaire de raccourcis clavier -- même patron visuel/
        fonctionnel que ShortcutsManagerDialog d'IngeniaX Explorer (cf.
        DEFAULT_RACCOURCIS_APP/charger_raccourcis_app/sauvegarder_
        raccourcis_app ci-dessous, réplique EXACTE de DEFAULT_APP_
        SHORTCUTS/load_app_shortcuts/save_app_shortcuts côté IngeniaX,
        adaptée à AutoniaX) : une ligne par raccourci (description +
        badge combo + bouton "Modifier"), regroupées par section.

        PATCH -- périmètre initialement restreint aux 2 seuls raccourcis
        existant à l'époque (Espace/rafraichissement_toggle et Shift/
        selection_capture_toggle, cf. décision explicite utilisateur :
        "oui dabord ces deux raccoucir pour linsatant, je vais rajouter
        avec le tmeps"), depuis étendu (task_executer_tout_toggle,
        sync_api_toggle, mettre_a_jour_autoniax_cloud -- cf. entrées
        correspondantes dans DEFAULT_RACCOURCIS_APP) sans migration,
        exactement comme prévu ci-dessous : la structure de données
        (dict id -> {combo, label, section, action}) et la boucle
        for rc_id, rc_data in self._raccourcis_app.items() qui suit
        n'imposent aucune limite au nombre d'entrées -- charger_
        raccourcis_app fusionne toute nouvelle entrée ajoutée à
        DEFAULT_RACCOURCIS_APP avec ce qui existe déjà sur disque, comme
        load_app_shortcuts côté IngeniaX (cf. sa docstring), et cet
        onglet les affiche donc tous automatiquement, groupés par
        section.

        Mode Global (pynput, indépendant du focus) VOLONTAIREMENT absent
        ici (cf. décision explicite utilisateur : "Interne seulement
        (comme actuellement, plus simple)") -- contrairement à
        ShortcutsManagerDialog/ShortcutCaptureDialog qui géraient les
        deux modes, il n'y a donc ni sélecteur de mode Global/Interne ni
        listener pynput dans cette version : chaque raccourci reste
        strictement local à FenetreRenduTaskReseau, actif uniquement
        quand cette fenêtre (l'image du rendu réseau) a le focus -- exactement
        le comportement actuel, juste rendu configurable."""
        # BUGFIX (même cause racine et même correctif que l'onglet
        # "Général" ci-dessus, cf. sa docstring pour le détail complet)
        # -- cet onglet est lui aussi non borné en hauteur (une ligne par
        # raccourci, cf. docstring de cette méthode : "n'imposent aucune
        # limite au nombre d'entrées") et portait directement layout sans
        # QScrollArea, donc sujet à la même compression/chevauchement à
        # fenêtre réduite ou avec suffisamment de raccourcis ajoutés.
        # onglet_conteneur (retourné à la place de l'ancien onglet
        # directement, cf. self._onglets.addTab(...) plus haut) ne porte
        # plus qu'une QScrollArea ; onglet (le widget qui portait déjà
        # tout le contenu ci-dessous, RENOMMÉ implicitement en widget
        # interne) garde le même layout, inchangé à l'identique.
        onglet_conteneur = QWidget(self._onglets)
        layout_conteneur = QVBoxLayout(onglet_conteneur)
        layout_conteneur.setContentsMargins(0, 0, 0, 0)
        layout_conteneur.setSpacing(0)
        zone_defilement_raccourcis = QScrollArea(onglet_conteneur)
        zone_defilement_raccourcis.setObjectName("RaccourcisScrollArea")
        zone_defilement_raccourcis.setWidgetResizable(True)
        zone_defilement_raccourcis.setFrameShape(QFrame.NoFrame)
        zone_defilement_raccourcis.setHorizontalScrollBarPolicy(Qt.ScrollBarAsNeeded)
        zone_defilement_raccourcis.setVerticalScrollBarPolicy(Qt.ScrollBarAsNeeded)
        layout_conteneur.addWidget(zone_defilement_raccourcis)

        onglet = QWidget(zone_defilement_raccourcis)
        onglet.setMinimumWidth(420)
        zone_defilement_raccourcis.setWidget(onglet)
        layout = QVBoxLayout(onglet)
        layout.setContentsMargins(24, 24, 24, 24)
        layout.setSpacing(12)
        layout.setAlignment(Qt.AlignTop)

        titre = QLabel("RACCOURCIS CLAVIER", onglet)
        titre.setObjectName("ReglagesPanelTitle")
        layout.addWidget(titre)

        description = QLabel(
            "Raccourcis actifs quand le contrôle à distance est ouvert "
            "(rendu d'une instance réseau) et que l'image a le focus. "
            "Cliquez sur \u00ab Modifier \u00bb pour changer une combinaison.",
            onglet,
        )
        description.setWordWrap(True)
        description.setObjectName("PlaceholderSubtitle")
        layout.addWidget(description)

        self._raccourcis_app = charger_raccourcis_app()
        by_section: dict[str, list] = {}
        for rc_id, rc_data in self._raccourcis_app.items():
            by_section.setdefault(rc_data.get("section", "Autre"), []).append((rc_id, rc_data))

        self._boite_raccourcis = QWidget(onglet)
        self._boite_raccourcis.setObjectName("RaccourcisBox")
        boite_layout = QVBoxLayout(self._boite_raccourcis)
        boite_layout.setContentsMargins(10, 6, 10, 6)
        boite_layout.setSpacing(3)
        for section, items in by_section.items():
            section_titre = QLabel(section.upper(), self._boite_raccourcis)
            section_titre.setObjectName("ReglagesLabel")
            boite_layout.addWidget(section_titre)
            for rc_id, rc_data in items:
                boite_layout.addWidget(self._construire_ligne_raccourci(rc_id, rc_data))
        layout.addWidget(self._boite_raccourcis)

        ligne_reset = QHBoxLayout()
        ligne_reset.addStretch(1)
        bouton_reset = QPushButton("Réinitialiser les raccourcis", onglet)
        bouton_reset.setCursor(Qt.PointingHandCursor)
        bouton_reset.clicked.connect(self._on_clic_reinitialiser_raccourcis)
        ligne_reset.addWidget(bouton_reset)
        layout.addLayout(ligne_reset)

        layout.addStretch(1)
        return onglet_conteneur

    def _construire_ligne_raccourci(self, rc_id: str, rc_data: dict) -> QWidget:
        """Une ligne : [description] [badge combo] [bouton Modifier] --
        même contenu d'information que _make_shortcut_row côté IngeniaX
        (cf. sa docstring), sans les colonnes Favori/Mode qui n'ont pas
        d'équivalent ici (pas de mode Global, pas de système de favoris
        demandé)."""
        row = QWidget(self._boite_raccourcis)
        rl = QHBoxLayout(row)
        rl.setContentsMargins(2, 3, 2, 3)
        rl.setSpacing(8)

        desc = QLabel(rc_data.get("label", rc_id), row)
        rl.addWidget(desc, 1)

        combo = rc_data.get("combo", "")
        badge = QLabel(combo if combo else "—", row)
        badge.setObjectName("RaccourciBadge")
        badge.setProperty("defini", "true" if combo else "false")
        badge.setFixedWidth(140)
        badge.setAlignment(Qt.AlignCenter)
        rl.addWidget(badge)

        bouton_modifier = QPushButton("Modifier", row)
        bouton_modifier.setCursor(Qt.PointingHandCursor)
        bouton_modifier.setFixedWidth(90)
        bouton_modifier.clicked.connect(
            lambda _c=False, rid=rc_id, rd=rc_data, b=badge: self._on_clic_modifier_raccourci(rid, rd, b)
        )
        rl.addWidget(bouton_modifier)

        return row

    def _on_clic_modifier_raccourci(self, rc_id: str, rc_data: dict, badge: QLabel):
        """Ouvre RaccourciCaptureDialog (cf. sa docstring -- réplique
        directe de ShortcutCaptureDialog côté IngeniaX, en QKeyEvent Qt
        plutôt que pynput puisque mode Global explicitement écarté ici,
        cf. docstring de _construire_onglet_raccourcis). Vérifie les
        conflits ENTRE LES 2 raccourcis eux-mêmes avant sauvegarde --
        même principe que _check_combo_conflict côté IngeniaX, réduit ici
        à seulement 2 entrées puisque c'est tout le périmètre actuel."""
        dialogue = RaccourciCaptureDialog(rc_data.get("label", rc_id), rc_data.get("combo", ""), self)
        if dialogue.exec() != QDialog.Accepted:
            return
        nouveau_combo = dialogue.get_raccourci().strip()

        if nouveau_combo:
            for autre_id, autre_data in self._raccourcis_app.items():
                if autre_id != rc_id and autre_data.get("combo", "") == nouveau_combo:
                    BoiteDialogueAutoniaX.warning(
                        self, "Raccourci déjà utilisé",
                        f"« {nouveau_combo} » est déjà assigné à :\n\n"
                        f"  {autre_data.get('label', autre_id)}\n\n"
                        f"Choisissez une combinaison différente.",
                    )
                    return

        self._raccourcis_app[rc_id]["combo"] = nouveau_combo
        sauvegarder_raccourcis_app(self._raccourcis_app)
        badge.setText(nouveau_combo if nouveau_combo else "—")
        badge.setProperty("defini", "true" if nouveau_combo else "false")
        badge.style().unpolish(badge)
        badge.style().polish(badge)
        self.raccourcis_app_changes.emit()

    def _on_clic_reinitialiser_raccourcis(self):
        confirme = BoiteDialogueAutoniaX.question(
            self, "Réinitialiser les raccourcis",
            "Remettre tous les raccourcis à leurs valeurs par défaut ?",
        )
        if not confirme:
            return
        self._raccourcis_app = {k: dict(v) for k, v in DEFAULT_RACCOURCIS_APP.items()}
        sauvegarder_raccourcis_app(self._raccourcis_app)
        # Reconstruit entièrement la boîte (façon la plus simple de
        # remettre à jour tous les badges d'un coup, cohérent avec
        # _rebuild_all_rows côté IngeniaX qui fait de même après un reset).
        ancien = self._boite_raccourcis
        parent_layout = ancien.parentWidget().layout()
        index = parent_layout.indexOf(ancien)
        nouvelle_boite = QWidget(ancien.parentWidget())
        nouvelle_boite.setObjectName("RaccourcisBox")
        boite_layout = QVBoxLayout(nouvelle_boite)
        boite_layout.setContentsMargins(10, 6, 10, 6)
        boite_layout.setSpacing(3)
        by_section: dict[str, list] = {}
        for rc_id, rc_data in self._raccourcis_app.items():
            by_section.setdefault(rc_data.get("section", "Autre"), []).append((rc_id, rc_data))
        for section, items in by_section.items():
            section_titre = QLabel(section.upper(), nouvelle_boite)
            section_titre.setObjectName("ReglagesLabel")
            boite_layout.addWidget(section_titre)
            for rc_id, rc_data in items:
                boite_layout.addWidget(self._construire_ligne_raccourci(rc_id, rc_data))
        parent_layout.insertWidget(index, nouvelle_boite)
        ancien.deleteLater()
        self._boite_raccourcis = nouvelle_boite
        self.raccourcis_app_changes.emit()

