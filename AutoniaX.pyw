class Variante(str):
    """AJOUT (SPEC_GLOBALE_AutoniaX.md, Partie A -- demande explicite
    utilisateur : rendre les paramètres de détection réglables
    INDIVIDUELLEMENT PAR VARIANTE plutôt qu'un seul jeu de valeurs
    partagé par tout le composant, ex. une variante "thème sombre" peut
    avoir besoin d'un flou_noyau différent de la variante "thème clair"
    du même composant) -- avant cette classe, ComposantSingle.variantes
    était une simple list[str] (chemins), et tous les paramètres de
    détection (seuil_confiance, flou_noyau, delta_conflit,
    seuil_candidats_potentiels, code_filtre, priorite_selection,
    couleur_succes, couleur_echec) étaient GLOBAUX au composant,
    partagés par toutes ses variantes.

    HÉRITE DE str : choix DÉLIBÉRÉ de compatibilité -- des dizaines de
    sites de ce fichier traitent déjà composant.variantes comme une
    list[str] (comparaisons ==, `in`, .remove(), jointure Path / str,
    f-strings, sérialisation JSON de chemins bruts côté ancien format...).
    Faire de Variante une sous-classe de str permet à TOUT ce code
    existant de continuer à fonctionner sans modification quand il ne
    lit QUE le chemin (le cas de très loin le plus fréquent), tout en
    donnant accès aux nouveaux attributs par variante
    (variante.seuil_confiance, etc.) au code qui en a besoin
    (chargement des templates, moteur de détection, UI).

    PAS une @dataclass (piège __new__/héritage str, cf. le test isolé
    dans le commentaire de fin de fichier "TEST ISOLÉ Variante/
    dataclass" -- confirmé qu'une dataclass sur une sous-classe de str
    avec __new__ personnalisé pose un ordre d'arguments incompatible) :
    classe manuelle avec to_dict()/from_dict() écrits à la main, à
    l'image de ZoneClicRect.from_dict déjà présent dans ce fichier
    comme modèle de sérialisation manuelle à côté des vraies
    dataclasses.

    Le chemin lui-même (str, la valeur de l'objet) reste relatif à
    get_app_data_dir() (mode local) ou get_service_api_dir() (mode
    réseau sAutoniax), EXACTEMENT comme avant -- cf. charger_templates_bgr
    pour la résolution."""

    def __new__(cls, chemin: str, *args, **kwargs):
        return str.__new__(cls, chemin)

    def __init__(self, chemin: str, priorite_selection: str = "mostTop",
                 seuil_confiance: float = 0.9, flou_noyau: int = 0,
                 seuil_candidats_potentiels: float = 0.5,
                 delta_conflit: float = 0.0,
                 couleur_succes: str = "#a6e3a1",
                 couleur_echec: str = "#f9e2af",
                 code_filtre: str = ""):
        # str est déjà construite via __new__ ci-dessus (immutable) --
        # __init__ ne fait qu'attacher les attributs supplémentaires.
        self.chemin = chemin
        self.priorite_selection = priorite_selection
        self.seuil_confiance = seuil_confiance
        self.flou_noyau = flou_noyau
        self.seuil_candidats_potentiels = seuil_candidats_potentiels
        self.delta_conflit = delta_conflit
        self.couleur_succes = couleur_succes
        self.couleur_echec = couleur_echec
        self.code_filtre = code_filtre

    def to_dict(self) -> dict:
        return {
            "chemin": self.chemin,
            "priorite_selection": self.priorite_selection,
            "seuil_confiance": self.seuil_confiance,
            "flou_noyau": self.flou_noyau,
            "seuil_candidats_potentiels": self.seuil_candidats_potentiels,
            "delta_conflit": self.delta_conflit,
            "couleur_succes": self.couleur_succes,
            "couleur_echec": self.couleur_echec,
            "code_filtre": self.code_filtre,
        }

    @staticmethod
    def from_dict(d: dict) -> "Variante":
        return Variante(
            chemin=d.get("chemin", ""),
            priorite_selection=d.get("priorite_selection", "mostTop"),
            seuil_confiance=d.get("seuil_confiance", 0.9),
            flou_noyau=d.get("flou_noyau", 0),
            seuil_candidats_potentiels=d.get("seuil_candidats_potentiels", 0.5),
            delta_conflit=d.get("delta_conflit", 0.0),
            couleur_succes=d.get("couleur_succes", "#a6e3a1"),
            couleur_echec=d.get("couleur_echec", "#f9e2af"),
            code_filtre=d.get("code_filtre", ""),
        )

    def avec_chemin(self, nouveau_chemin: str) -> "Variante":
        """Retourne une COPIE de cette Variante avec un chemin différent
        mais TOUS les autres attributs préservés -- utilisé par les
        opérations qui déplacent/renomment le fichier physique
        (rename_service_api, import de pack ServiceAPI) sans vouloir
        perdre les réglages déjà personnalisés de la variante déplacée."""
        d = self.to_dict()
        d["chemin"] = nouveau_chemin
        return Variante.from_dict(d)


@dataclass
class ComposantSingle:
    """RENOMMAGE (demande explicite utilisateur, cf. SPEC_composantLayout.md
    section 2 -- introduction du type ComposantLayout/cL à côté de celui-ci,
    désormais appelé ComposantSingle/cS pour les distinguer) : cette classe
    s'appelait `Composant` jusqu'ici -- un alias `Composant = ComposantSingle`
    est posé juste après cette classe pour que les ~centaines de références
    existantes (Composant(...), isinstance(x, Composant), type hints) dans le
    reste du fichier continuent de fonctionner SANS AUCUN changement de
    comportement. Aucun champ, aucune méthode, aucune sérialisation JSON
    modifiée par ce renommage -- seul le nom canonique change.

    Un élément d'interface capturé visuellement (point 2).

    Peut avoir plusieurs VARIANTES : plusieurs images associées au même
    composant (même nom, mêmes réglages), utile quand l'élément change
    légèrement d'apparence selon le contexte (thème, état survolé, etc.).
    À la reconnaissance, il suffit qu'UNE SEULE variante matche pour que
    le composant soit considéré comme détecté. La première variante de la
    liste sert d'image "principale" pour les aperçus (vignette grille,
    panneau de réglages tant qu'aucune variante précise n'est ciblée)."""
    nom: str  # format NomServiceAPI-NomComposant, unique globalement
    service_api_nom: str  # nom du ServiceAPI auquel il appartient
    # PATCH (SPEC_GLOBALE_AutoniaX.md, Partie A) -- reste une list, mais
    # contient désormais des Variante (cf. cette classe, juste au-dessus)
    # plutôt que des str brutes, une fois passé par from_dict/les
    # opérations d'ajout. Chaque Variante porte SES PROPRES paramètres de
    # détection (seuil_confiance, flou_noyau, etc.) -- cf. les 8 champs
    # ci-dessous pour leur nouveau rôle.
    variantes: list = field(default_factory=list)  # list[Variante], chemins relatifs, ex: components/Word/Word-BoutonOK.png
    # PATCH (SPEC_GLOBALE_AutoniaX.md, Partie A §2.2) -- les 8 champs
    # suivants (priorite_selection, seuil_confiance, flou_noyau,
    # seuil_candidats_potentiels, delta_conflit, couleur_succes,
    # couleur_echec, code_filtre) NE SONT PLUS LUS PAR LE MOTEUR DE
    # DÉTECTION (cf. rechercher_composant_multi_variantes qui lit
    # désormais Variante.<champ> pour chaque variante individuellement).
    # Ils restent sur ComposantSingle uniquement comme VALEURS PAR DÉFAUT
    # appliquées à toute NOUVELLE variante créée pour ce composant (cf.
    # add_variante_composant) -- ne PAS les supprimer : to_dict()/
    # from_dict() d'un composant SANS variante doit rester représentable,
    # et la migration ancien->nouveau format en a besoin comme source des
    # valeurs à copier sur chaque variante migrée (cf. from_dict).
    priorite_selection: str = "mostTop"
    seuil_confiance: float = 0.9
    # Taille (impaire) du noyau de flou gaussien appliqué à l'image ET au
    # template juste avant matchTemplate (cf. docstring de
    # _meilleure_correspondance pour le détail complet du pourquoi) --
    # PATCH (demande explicite utilisateur : rendre ce paramètre réglable
    # PAR COMPOSANT plutôt que fixe pour tous, "moi meme je vais specifier
    # le flou a utiliser pour tels composant, mais pardefaut, on ne doit
    # mettre aucun flou") -- 0 (défaut) = AUCUN flou, matchTemplate brut
    # sur les pixels d'origine. Une valeur > 0 doit être impaire (3, 5, 7,
    # 9, 11...) : c'est une exigence de cv2.GaussianBlur, pas une
    # convention arbitraire. Utile pour absorber le bruit de sous-pixel du
    # texte fin/anti-aliasé quand un composant précis en a besoin -- à
    # activer au cas par cas, jamais par défaut, pour ne pas masquer de
    # vrais détails discriminants sur des composants qui n'en ont pas
    # besoin (cf. discussion : un flou trop large peut rendre deux icônes
    # proches indiscernables).
    flou_noyau: int = 0
    # Seuil (score matchTemplate) à partir duquel un candidat est jugé
    # "potentiellement proche" et affiché en jaune dans l'écran "Test de
    # composant" -- PATCH (demande explicite utilisateur : lors du test
    # d'un composant, voir non seulement le meilleur candidat (vert) mais
    # aussi les autres candidats proches qui auraient pu être confondus,
    # "je veux eviter les mauvaise suprise, on peu comparer quelque chose
    # et ensuite sa detecte une autre chose pas celle voulue" -- "on doit
    # fixer nous meme le seuil que lon veux, pardefaut tu met a 0.5").
    # UNIQUEMENT utilisé par TestComposantScreen (cf.
    # rechercher_candidats_multiples) -- jamais lu par le chemin de
    # production ComposantExecutable._detecter(), qui reste sur un seul
    # candidat (minMaxLoc) pour ne pas ralentir le pilotage réel.
    seuil_candidats_potentiels: float = 0.5
    # Écart de score matchTemplate (valeur absolue, ex: 0.02) en dessous
    # duquel DEUX candidats sont jugés "en conflit" -- PATCH (demande
    # explicite utilisateur : "le dela cest la diference entre le score
    # de 2 candidat pour evaluer sil sont trop proche, sa sers relatifs
    # a chaque composant") -- réglable PAR COMPOSANT, comme flou_noyau et
    # seuil_candidats_potentiels juste au-dessus.
    #
    # UTILISÉ EN PRODUCTION (cf. _meilleure_correspondance), contrairement
    # à seuil_candidats_potentiels qui reste réservé à TestComposantScreen
    # -- décision explicite utilisateur après discussion du coût : le
    # deuxième candidat n'est recherché QUE si le premier a déjà franchi
    # seuil_confiance (cf. docstring de _meilleure_correspondance pour le
    # détail du court-circuit) -- si le premier échoue, chercher un
    # deuxième candidat ne sert à rien puisque même le meilleur ne passe
    # pas le seuil, donc AUCUN coût ajouté sur le cas le plus fréquent
    # d'une boucle de pilotage (.visible() qui échoue en attendant qu'un
    # élément apparaisse). Un seul minMaxLoc de plus dans le cas positif
    # (jamais une boucle de N candidats comme rechercher_candidats_
    # multiples, réservée au mode test) : coût négligeable.
    #
    # 0.0 (défaut) = AUCUNE détection de conflit : dès qu'un candidat
    # franchit seuil_confiance, il est retenu tel quel, comportement
    # identique à avant l'ajout de ce paramètre (le deuxième candidat
    # n'est même pas recherché quand delta_conflit vaut 0 -- cf.
    # _meilleure_correspondance). Une valeur > 0 (ex: 0.02) active la
    # recherche du deuxième meilleur candidat quand le premier réussit :
    # s'il est aussi au-dessus de seuil_confiance ET à moins de
    # delta_conflit du premier, les deux sont "trop proches" pour être
    # départagés par le score seul -- priorite_selection (mostTop/
    # mostBottom/mostLeft/mostRight, déjà existant) tranche alors entre
    # les deux positions.
    delta_conflit: float = 0.0
    # PATCH (demande explicite utilisateur : "jai du mal a lire parfois
    # les texte de corespondance ... tu vas mettre une des widget pour la
    # configuration de couleur, donc on vas juste choisr la couleur a
    # ffficher pour les sucess, et la couleur a afficher pour les
    # echecs") -- couleurs réglables PAR COMPOSANT (même esprit que
    # delta_conflit/seuil_candidats_potentiels/flou_noyau juste au-dessus :
    # un réglage global unique ne convient pas forcément à TOUS les
    # composants, ex: un composant déjà vert dans son image source se
    # confondrait avec un contour vert par défaut). Stockées en chaîne
    # hexadécimale "#rrggbb" (format QColor(str) direct, cf.
    # ComposantReglagesPanel/TestComposantScreen) plutôt qu'un tuple RGB
    # ou un QColor -- une dataclass sérialisée en JSON (to_dict/from_dict,
    # cf. asdict ci-dessous) doit rester composée de types primitifs.
    #
    # "Succès" = le meilleur candidat détecté (et tout candidat en
    # conflit avec lui, cf. candidats_en_conflit plus bas dans ce
    # fichier) -- affiché par TestComposantScreen._afficher_apercu_avec_
    # resultat à la place de Mocha.green (défaut). "Échec" = candidat
    # potentiel (au-dessus de seuil_candidats_potentiels) qui n'est PAS
    # le meilleur -- affiché à la place de Mocha.yellow (défaut) : ce
    # sont les faux-positifs plausibles que seuil_candidats_potentiels
    # sert justement à révéler (cf. sa docstring), donc "échec" au sens
    # de "ce n'est pas la bonne correspondance", pas une non-détection.
    #
    # Défauts = couleurs Mocha déjà utilisées historiquement en dur
    # (green/yellow, cf. Mocha plus bas dans ce fichier) : un composant
    # existant, jamais reconfiguré, garde exactement le rendu actuel.
    # Littéraux "#a6e3a1"/"#f9e2af" (PAS Mocha.green/Mocha.yellow) : la
    # classe Mocha est définie PLUS BAS dans ce fichier (après Composant)
    # -- une référence directe ici lèverait NameError au chargement du
    # module (Composant est évalué avant que Mocha existe). Valeurs
    # recopiées à l'identique de Mocha.green/Mocha.yellow -- si jamais
    # cette palette change, ces deux défauts sont à mettre à jour ici
    # aussi (recherche "cf. Composant.couleur_succes" depuis Mocha).
    couleur_succes: str = "#a6e3a1"
    couleur_echec: str = "#f9e2af"
    categorie: str = "normal"  # normal | intrusif — tag informatif uniquement
    groupe: str = ""  # nom de groupe libre, "" = aucun groupe
    zone_clic_mode: str = "toute_surface"  # toute_surface | personnalise
    zone_clic_rect: ZoneClicRect = field(default_factory=ZoneClicRect)
    description: str = ""  # note libre de l'utilisateur, purement informative
    # PATCH (retour utilisateur explicite -- "je veux que sa devien une
    # propriete du composant, define une seul fois" au sujet de click(
    # copier_presse_papier=True)) : id HTML (ou sélecteur, cf. AJOUT
    # ci-dessous) de l'élément DOM à cibler pour l'interception
    # presse-papier de CE composant (cf. ComposantExecutable.click,
    # _JS_CAMOUFOX_INTERCEPTION_PRESSE_PAPIER) -- "" (défaut) =
    # comportement historique inchangé, interception globale sur toute la
    # page. Renseigné, l'interception se fait EN PLUS de façon ciblée sur
    # cet élément précis (filet de sécurité global toujours actif, décision
    # explicite utilisateur), sans jamais avoir à recoder cet id à chaque
    # site d'appel de click(copier_presse_papier=True) dans un script Task.
    #
    # AJOUT (demande explicite utilisateur : généraliser au-delà du seul
    # id/data-testid) : côté navigateur, idDeLElement (cf.
    # _JS_FRAGMENT_COMMUN_PRESSE_PAPIER) reconnaît maintenant aussi, par
    # ordre de priorité après id/data-testid, aria-label, aria-labelledby,
    # name et data-icon-only -- retournés comme un SÉLECTEUR CSS COMPLET
    # (ex: '[aria-label="Copier la réponse"]'), à coller tel quel dans ce
    # champ. Un id/data-testid reste lui retourné NU (sans crochets),
    # comme avant. Ce même format de sélecteur est aussi celui accepté par
    # dom_paste/dom_clear (cf. _JS_DOM_RESOUDRE_SELECTEUR) : un même
    # id_dom, une fois basé sur un de ces attributs, est donc réutilisable
    # tel quel pour les deux mécanismes.
    # AJOUT (demande explicite utilisateur : plusieurs sélecteurs candidats
    # pour un même composant) : id_dom accepte maintenant plusieurs
    # sélecteurs séparés par "||" (ex: '#foo || [aria-label="x"] || .cls'),
    # essayés DANS L'ORDRE côté résolution (cf. _JS_DOM_RESOUDRE_SELECTEUR
    # pour dom_paste/dom_clear, et _attendre_copie_presse_papier_fraiche
    # pour l'interception presse-papier ciblée) -- le premier qui matche
    # gagne. Un id_dom historique à un seul sélecteur (sans "||") continue
    # de fonctionner exactement comme avant.
    id_dom: str = ""
    # AJOUT (demande explicite utilisateur : "lorsque on vas vouloir fait
    # le match template on vas appliquer un filtre dabord sur limage pour
    # que si lelement en question est sur limage et bien le backfround
    # dynamqie ne cassse pas la detection") -- code Python/OpenCV collé
    # par l'utilisateur, MÊME SANDBOX que ComposantLayout.code_filtre (cf.
    # executer_filtre_composant_single / _builtins_surs_pour_sandbox_
    # detection) : reçoit `image` (BGR) en entrée et doit définir
    # `resultat` (BGR ou niveaux de gris, même dimensions que `image`) en
    # sortie -- exécuté À L'IDENTIQUE sur le template ET sur la capture
    # écran juste avant le matchTemplate habituel (cf. rechercher_
    # composant), pour que les deux images comparées restent dans le
    # même espace après filtrage. But : un filtre qui isole visuellement
    # l'élément recherché (ex: seuillage couleur, détection de contours)
    # rend le score de correspondance insensible à un arrière-plan qui
    # varie d'une capture à l'autre (vidéo en lecture, animation, horloge
    # affichée...), qui casserait sinon un matchTemplate brut pixel à
    # pixel. "" (défaut) = AUCUN filtre, comportement historique inchangé
    # (comparaison directe des pixels d'origine) -- jamais appliqué par
    # défaut, à activer au cas par cas pour un composant précis qui en a
    # besoin, même philosophie que flou_noyau juste au-dessus.
    code_filtre: str = ""

    @property
    def image_path(self) -> str:
        """Chemin de l'image principale (1ère variante). Conservé pour ne
        pas avoir à toucher tout le code qui n'a besoin que d'UNE image
        (vignette, aperçu par défaut, template de test rapide...). Retourne
        une chaîne vide si le composant n'a encore aucune variante."""
        return self.variantes[0] if self.variantes else ""

    def to_dict(self) -> dict:
        # PATCH (SPEC_GLOBALE_AutoniaX.md, Partie A §2.3) -- asdict()
        # d'une dataclass ne sait pas sérialiser automatiquement un objet
        # Variante (classe manuelle, pas une dataclass, cf. sa docstring) :
        # asdict() la traiterait comme une str brute (son type de base) et
        # perdrait tous ses attributs par-variante. On repasse donc sur
        # to_dict() explicitement pour chaque Variante après le asdict()
        # générique.
        d = asdict(self)
        d["variantes"] = [v.to_dict() if isinstance(v, Variante) else v for v in self.variantes]
        return d

    @staticmethod
    def from_dict(d: dict) -> "Composant":
        d = dict(d)
        zone_clic_rect = d.pop("zone_clic_rect", None)
        # Migration : anciens projets sauvegardés avec un champ "image_path"
        # (str unique) au lieu de "variantes" (list) -> on convertit à la
        # volée pour ne rien perdre à l'ouverture d'un projet existant.
        #
        # PATCH (SPEC_GLOBALE_AutoniaX.md, Partie A §2.3) -- le champ JSON
        # "variantes" peut désormais se présenter sous DEUX formes selon
        # l'ancienneté du projet :
        #   - ANCIEN format : ["components/X/Y.png", ...] (liste de str
        #     bruts, ou liste vide/absente -> repli sur l'ancien champ
        #     "image_path" ci-dessus, comportement historique inchangé).
        #   - NOUVEAU format : [{"chemin": "...", "seuil_confiance": 0.92,
        #     ...}, ...] (liste de dicts, une fois ce chantier terminé et
        #     le projet resauvegardé).
        # Dans le cas ANCIEN, chaque variante migrée HÉRITE des réglages
        # ACTUELS du composant (d, avant le filtrage champs_valides plus
        # bas) -- pour un comportement de détection RIGOUREUSEMENT
        # INCHANGÉ juste après cette migration (décision explicite
        # utilisateur). Utilise .get avec les mêmes défauts que
        # ComposantSingle pour tolérer un projet partiellement
        # migré/champs manquants.
        ancien_image_path = d.pop("image_path", None)
        variantes_brutes = d.pop("variantes", None)
        if variantes_brutes is None:
            variantes_brutes = [ancien_image_path] if ancien_image_path else []

        variantes_migrees = []
        for v in variantes_brutes:
            if isinstance(v, dict):
                # Nouveau format déjà écrit une fois -- relu tel quel, les
                # valeurs par variante sont respectées et NE SONT PAS
                # écrasées par les valeurs du composant.
                variantes_migrees.append(Variante.from_dict(v))
            else:
                # Ancien format (str brut) OU migration image_path->variantes
                # ci-dessus.
                variantes_migrees.append(Variante(
                    chemin=v,
                    priorite_selection=d.get("priorite_selection", "mostTop"),
                    seuil_confiance=d.get("seuil_confiance", 0.9),
                    flou_noyau=d.get("flou_noyau", 0),
                    seuil_candidats_potentiels=d.get("seuil_candidats_potentiels", 0.5),
                    delta_conflit=d.get("delta_conflit", 0.0),
                    couleur_succes=d.get("couleur_succes", "#a6e3a1"),
                    couleur_echec=d.get("couleur_echec", "#f9e2af"),
                    code_filtre=d.get("code_filtre", ""),
                ))
        variantes = variantes_migrees
        # Migration silencieuse : les anciens projets utilisaient
        # "interface_nom" (à l'époque de Interface/Work) -> repris comme
        # service_api_nom si ce dernier est absent, pour ne rien perdre à
        # l'ouverture d'un projet existant.
        ancien_interface_nom = d.pop("interface_nom", None)
        if "service_api_nom" not in d and ancien_interface_nom is not None:
            d["service_api_nom"] = ancien_interface_nom
        # Filtre défensif : ignore silencieusement toute autre clé résiduelle
        # d'un ancien format qui n'aurait pas (encore) de règle de migration
        # explicite ci-dessus, plutôt que de planter à l'ouverture.
        champs_valides = {f.name for f in fields(Composant)}
        d = {k: v for k, v in d.items() if k in champs_valides}
        composant = Composant(
            zone_clic_rect=ZoneClicRect.from_dict(zone_clic_rect) if zone_clic_rect else ZoneClicRect(),
            variantes=list(variantes),
            **d,
        )
        return composant


# ALIAS DE COMPATIBILITÉ (cf. docstring de ComposantSingle ci-dessus) : posé
# IMMÉDIATEMENT après la classe, avant toute autre définition du module, pour
# que TOUTE référence existante à `Composant` (littérale ou via fields(),
# isinstance(), type hints en chaîne comme "Composant" ci-dessus qui sont
# résolus par nom au moment de l'appel, pas à la définition) continue de
# fonctionner à l'identique dans le reste du fichier. Ne JAMAIS supprimer
# cet alias tant que les call sites existants n'ont pas été migrés vers
# ComposantSingle -- cf. SPEC_composantLayout.md section 2.
Composant = ComposantSingle


# ---------------------------------------------------------------------------
# ComposantLayout (cL) -- cf. SPEC_composantLayout.md pour la spec complète.
# Second type de composant détectable à l'écran, en complément de
# ComposantSingle (cS, ci-dessus) : plutôt qu'une similarité visuelle brute
# (matchTemplate) sur UNE image, cL détecte un GROUPE STRUCTURÉ de formes
# (ex: une carte vidéo YouTube = vignette + icône chaîne + titre vidéo +
# titre chaîne) par cohérence structurelle -- un filtre fait ressortir les
# formes, OpenCV détecte leurs contours, et ces contours sont mis en
# correspondance avec un gabarit de formes nommées enregistré à la config
# (cf. SPEC section 4 pour l'algorithme complet).
# ---------------------------------------------------------------------------

@dataclass
class Zone:
    """FUSION (demande explicite : "forme et zone sont en fait la même
    chose ... on va éliminer la notion de forme, et conserver zone") --
    Zone est désormais l'UNIQUE notion de rectangle nommé sur un
    ComposantLayout, plus de distinction avec une classe "Forme" séparée.

    Toujours tracée librement à la souris sur l'un des deux aperçus (brut
    ou filtré, cf. ComposantLayoutConfigScreen._construire_sous_onglet_
    zones) -- plus de notion de clic sur un bloc scanné pour la faire
    naître (confirmé explicitement : "on enlève la notion de scan clic,
    nous même on va dessiner la zone").

    `rect` est relatif au ComposantLayout ENTIER, en fractions 0.0-1.0 de
    sa largeur/hauteur -- PAS en pixels absolus. Stockée dans
    ComposantLayout.zones (liste plate).

    Rôle (REFONTE, cf. SPEC_refonte_filtre_zones_dynamiques.md -- le rôle
    2 d'origine, "gabarit de détection structurelle" via _evaluer_cluster,
    a disparu avec l'ancien matching structurel, entièrement supprimé) :
    Rectangle nommé accessible depuis un script Task, à plat, une fois le
    cL détecté (ex: videoTemplateItems.nom_zone), cf. InstanceLayoutDetectee.
    Uniquement les Zone STATIQUES (tracées à la main) sont stockées ici --
    les zones DYNAMIQUES (nommées directement par code_filtre à
    l'exécution) ne sont jamais persistées comme des Zone, cf. docstring
    de ComposantLayout.zones.

    AJOUT (demande explicite utilisateur : "on vas aussi mettre la notion
    de zone personnalisée pour chaque zone pour un ComposantLayout ...
    quand on clic dessus ça suit exactement la même logique que le bouton
    personnaliser d'un ComposantSingle") -- zone_clic_mode/zone_clic_rect
    ici reprennent EXACTEMENT le même contrat que Composant.zone_clic_mode/
    zone_clic_rect (cf. docstring de ces champs et de point_clic_composant/
    tirer_point_clic_aleatoire) : "toute_surface" (défaut) = un clic sur
    CETTE Zone (une fois le cL détecté et cette Zone localisée à l'écran)
    peut atterrir n'importe où dans son rectangle détecté ; "personnalise"
    = restreint au sous-rectangle zone_clic_rect, exprimé en coordonnées
    de l'image DÉCOUPÉE de cette Zone précise (donc relatif à la Zone
    elle-même, PAS au ComposantLayout entier comme `rect` ci-dessus, ni à
    la carte détectée globale -- cf. ZoneClicSelector ouvert sur cette
    image découpée, jamais sur l'image de référence complète). Ces deux
    champs vivent SUR L'OBJET ZONE : un renommage (zone.nom = ...) ou une
    suppression (retrait de composant_layout.zones) les emporte avec lui
    sans code de nettoyage séparé -- aucune clé externe à synchroniser."""
    nom: str = ""
    rect: ZoneClicRect = field(default_factory=ZoneClicRect)
    zone_clic_mode: str = "toute_surface"  # toute_surface | personnalise
    zone_clic_rect: ZoneClicRect = field(default_factory=ZoneClicRect)

    def to_dict(self) -> dict:
        return {
            "nom": self.nom,
            "rect": self.rect.to_dict(),
            "zone_clic_mode": self.zone_clic_mode,
            "zone_clic_rect": self.zone_clic_rect.to_dict(),
        }

    @staticmethod
    def from_dict(d: dict) -> "Zone":
        rect = d.get("rect")
        # RÉTROCOMPATIBILITÉ (champs ajoutés après coup, même principe que
        # couleur_zone/epaisseur_zone sur ComposantLayout) : un projet
        # sauvegardé avant l'introduction de la zone de clic personnalisée
        # par Zone n'a pas ces clés -- repli sur les mêmes défauts que la
        # dataclass (toute_surface / rect vide), jamais réinjectées à
        # l'écriture tant que l'utilisateur n'y touche pas.
        zone_clic_rect = d.get("zone_clic_rect")
        return Zone(
            nom=d.get("nom", ""),
            rect=ZoneClicRect.from_dict(rect) if rect else ZoneClicRect(),
            zone_clic_mode=d.get("zone_clic_mode", "toute_surface"),
            zone_clic_rect=ZoneClicRect.from_dict(zone_clic_rect) if zone_clic_rect else ZoneClicRect(),
        )


@dataclass
class ComposantLayout:
    """Composant de type "layout" (cL) -- cf. SPEC_composantLayout.md section
    3.3 pour le détail complet des champs et la justification de chacun.

    Champs volontairement ABSENTS par rapport à ComposantSingle (liste
    exhaustive donnée par l'utilisateur, cf. SPEC) : groupe,
    priorite_selection, variantes (une seule image_reference ici, pas de
    multi-variantes), id_dom, flou_noyau (le code_filtre collé par
    l'utilisateur gère lui-même tout lissage éventuel), seuil_candidats_
    potentiels. Ne PAS les ajouter, même par cohérence avec ComposantSingle."""
    nom: str = ""  # format NomServiceAPI-NomComposantLayout, unique globalement
    service_api_nom: str = ""
    image_reference: str = ""  # chemin relatif de la capture de référence (PAGE ENTIÈRE désormais, cf. code_scindement)
    code_filtre: str = ""  # code Python/OpenCV collé par l'utilisateur (cf. SPEC section 4.1/5.2)
    # AJOUT (demande explicite utilisateur : un cL doit avoir SON code de
    # scindement en plus de SON code de filtre, les deux utilisés en
    # production -- pas un algorithme de découpage générique unique pour
    # tout le projet) -- code Python/OpenCV collé par l'utilisateur,
    # exécuté sur la PAGE ENTIÈRE (pas une carte déjà cadrée) pour en
    # sortir les rectangles candidats ("cartes"), cf. executer_code_
    # scindement. OBLIGATOIRE au même titre que code_filtre (les deux
    # sont utilisés ensemble en production, cf. detecter_toutes_
    # instances_composant_layout_sur_page) : un cL sans code_scindement
    # ne peut pas être détecté correctement, exactement comme un cL sans
    # code_filtre aujourd'hui -- validé côté UI (cf. ComposantLayoutConfigScreen),
    # pas une contrainte imposée au niveau de la dataclass elle-même (même
    # principe que code_filtre, également str = "" par défaut ici malgré
    # son propre caractère indispensable en pratique).
    code_scindement: str = ""
    # FUSION (demande explicite : "forme et zone sont en fait la même
    # chose ... on va éliminer la notion de forme, et conserver zone") --
    # Zone est désormais l'UNIQUE liste de rectangles nommés STATIQUES du
    # cL (plus de champ formes séparé, cf. docstring de la dataclass Zone).
    # Sert de rectangles accessibles en script (videoTemplateItems.
    # nom_zone). Les zones DYNAMIQUES (nommées directement par code_filtre,
    # cf. SPEC_refonte_filtre_zones_dynamiques.md) ne sont PAS stockées
    # ici : leur nom et position ne sortent que du filtre à l'exécution,
    # jamais persistés à part le code lui-même.
    zones: list = field(default_factory=list)  # list[Zone] -- UNIQUEMENT les Zone statiques
    # AJOUT (demande explicite utilisateur : personnaliser la zone de clic
    # d'une zone DYNAMIQUE, pas seulement des Zone statiques) -- dict
    # nom_zone_dynamique -> ZoneDynamiqueClicConfig. Séparé de `zones`
    # (les Zone statiques) car une zone dynamique n'a pas d'objet Zone
    # qui persiste d'une exécution de filtre à l'autre : SEUL son nom
    # est stable (cf. docstring de ZoneClicRectFraction) -- son rectangle,
    # lui, est recalculé à chaque exécution et jamais stocké ici. Une
    # entrée peut donc survivre ici même si la zone dynamique correspondante
    # n'apparaît plus dans le résultat du dernier filtre exécuté (filtre
    # modifié entre-temps, image de référence changée, etc.) -- elle
    # redevient simplement active dès qu'un nom identique réapparaît,
    # plutôt que d'être perdue silencieusement à la moindre réexécution.
    zones_dynamiques_clic: dict = field(default_factory=dict)  # dict[str, ZoneDynamiqueClicConfig]
    # SUPPRIMÉ (REFONTE, cf. SPEC_refonte_filtre_zones_dynamiques.md) :
    # seuil_confiance, delta_conflit, distance_max_regroupement_px
    # pilotaient l'ancien matching structurel (clustering de blocs anonymes
    # + comparaison de position/taille relative à un gabarit figé). Ce
    # mécanisme est entièrement retiré : le filtre nomme et valide
    # lui-même chaque zone qu'il trouve (variables 'zones' + 'valide' en
    # sortie de code_filtre), il n'y a donc plus de notion de score de
    # confiance ni de tolérance de regroupement spatial pour un cL. Les
    # anciennes clés JSON correspondantes sont ignorées silencieusement à
    # la lecture (cf. from_dict) plutôt que de faire planter l'ouverture
    # d'un projet plus ancien -- jamais réinjectées à l'écriture.
    # "automatique" (défaut) = détecté depuis les coins/bordures de
    # image_reference au moment de la config (cf. SPEC section 4.3).
    # Sinon "#rrggbb" = couleur fixée manuellement par l'utilisateur.
    couleur_fond: str = "automatique"
    # PATCH (demande explicite utilisateur : "il faut que la couleur du
    # contour sur les images soit plus foncé et change de couleur, par
    # exemple vert ... ces couleurs doivent être définies dans l'onglet
    # Général ... sa sera persistant et en fonction de chaque cL") --
    # réglages du TRACÉ des rectangles de Zone sur les deux aperçus (cf.
    # ApercuLayoutLabel.paintEvent), PAR ComposantLayout (même esprit que
    # Composant.couleur_succes/couleur_echec : un défaut global ne
    # convient pas forcément à tous les cL, ex: un cL déjà mauve dans son
    # image source se confondrait avec le contour mauve par défaut).
    # Défauts = couleurs déjà utilisées historiquement en dur (Mocha.mauve/
    # épaisseur 2, cf. ApercuLayoutLabel.paintEvent) -- un cL existant,
    # jamais reconfiguré, garde exactement le rendu actuel. couleur_zone_
    # selectionnee (vert, comme suggéré explicitement en exemple) --
    # DIFFÉRENTE de couleur_zone : la Zone actuellement sélectionnée dans
    # le panneau de droite (cf. _sur_carte_zone_cliquee) se distingue
    # ainsi visuellement des autres, plus foncée/contrastée sur l'aperçu.
    couleur_zone: str = "#cba6f7"  # Mocha.mauve -- littéral, Mocha pas encore défini à ce point du fichier
    epaisseur_zone: int = 2
    couleur_zone_selectionnee: str = "#a6e3a1"  # Mocha.green
    # AJOUT (SPEC_lot_corrections_2026-09.md section 1) : coche PUREMENT
    # MANUELLE, aucune vérification technique automatique -- ne reflète ni
    # un vrai test réussi, ni une détection de changement de code. Simple
    # pense-bête activé/désactivé par l'utilisateur lui-même pour dire
    # "j'ai fini de configurer celui-là" (filtre + scindement). Un
    # ComposantLayout existant, jamais reconfiguré, repart à False --
    # rétrocompatible sans migration nécessaire (cf. from_dict).
    filtre_scindement_valide: bool = False

    @property
    def image_path(self) -> str:
        """Aligné sur ComposantSingle.image_path (même nom de propriété) --
        pratique pour tout code générique qui affiche l'aperçu d'un
        composant sans se soucier de son type exact (cS ou cL)."""
        return self.image_reference

    def to_dict(self) -> dict:
        return {
            "nom": self.nom,
            "service_api_nom": self.service_api_nom,
            "image_reference": self.image_reference,
            "code_filtre": self.code_filtre,
            "code_scindement": self.code_scindement,
            "zones": [z.to_dict() for z in self.zones],
            # AJOUT (cf. docstring du champ) -- sérialisé comme un dict de
            # dicts, nom_zone_dynamique -> ZoneDynamiqueClicConfig.to_dict().
            "zones_dynamiques_clic": {
                nom: config.to_dict() for nom, config in self.zones_dynamiques_clic.items()
            },
            "couleur_fond": self.couleur_fond,
            "couleur_zone": self.couleur_zone,
            "epaisseur_zone": self.epaisseur_zone,
            "couleur_zone_selectionnee": self.couleur_zone_selectionnee,
            "filtre_scindement_valide": self.filtre_scindement_valide,
        }

    @staticmethod
    def from_dict(d: dict) -> "ComposantLayout":
        # RÉTROCOMPATIBILITÉ (fusion Forme -> Zone) : un projet sauvegardé
        # AVANT cette fusion peut encore contenir une clé "formes" (ancien
        # format, liste de dicts {nom, rect_relatif, ...}) -- ignorée
        # silencieusement ici plutôt que de planter à l'ouverture ; ses
        # rectangles ne sont PAS automatiquement convertis en Zone (formats
        # de rect différents : rect_relatif tuple vs rect ZoneClicRect),
        # l'utilisateur devra les retracer si besoin.
        #
        # RÉTROCOMPATIBILITÉ (REFONTE zones dynamiques) : un projet
        # sauvegardé AVANT cette refonte peut encore contenir les clés
        # "seuil_confiance", "delta_conflit", "distance_max_regroupement_px"
        # (ancien matching structurel, supprimé cf. SPEC) -- ignorées
        # silencieusement ici (d.get(...) jamais appelé dessus), jamais
        # réinjectées dans le ComposantLayout reconstruit ni dans un
        # to_dict() ultérieur. Le projet rouvert perd ces réglages, ce qui
        # est sans conséquence puisqu'ils ne pilotent plus rien.
        return ComposantLayout(
            nom=d.get("nom", ""),
            service_api_nom=d.get("service_api_nom", ""),
            image_reference=d.get("image_reference", ""),
            code_filtre=d.get("code_filtre", ""),
            # RÉTROCOMPATIBILITÉ (champ ajouté après coup, même principe
            # que couleur_zone/epaisseur_zone/... plus bas) -- un projet
            # sauvegardé avant l'introduction de code_scindement n'a pas
            # cette clé : repli sur "" comme pour code_filtre lui-même
            # (str = "" par défaut sur la dataclass). Un cL rouvert dans
            # ce cas devra se voir doter d'un code_scindement avant de
            # pouvoir être détecté à nouveau -- pas de migration
            # automatique possible, aucune façon de deviner ce code.
            code_scindement=d.get("code_scindement", ""),
            zones=[Zone.from_dict(z) for z in d.get("zones", [])],
            # RÉTROCOMPATIBILITÉ (champ ajouté après coup, même principe
            # que les autres ci-dessous) : un projet sauvegardé avant
            # l'introduction de la zone de clic personnalisée sur les
            # zones dynamiques n'a pas cette clé -- repli sur {} (aucune
            # zone dynamique n'a de config, donc "toute_surface" pour
            # toutes, cf. défaut de ZoneDynamiqueClicConfig).
            zones_dynamiques_clic={
                nom: ZoneDynamiqueClicConfig.from_dict(c)
                for nom, c in d.get("zones_dynamiques_clic", {}).items()
            },
            couleur_fond=d.get("couleur_fond", "automatique"),
            # RÉTROCOMPATIBILITÉ (3 champs ajoutés après coup) : un projet
            # sauvegardé avant ce patch n'a pas ces clés -- repli sur les
            # mêmes défauts que la dataclass, identiques au rendu en dur
            # préexistant (cf. docstring des champs ci-dessus).
            couleur_zone=d.get("couleur_zone", "#cba6f7"),
            epaisseur_zone=d.get("epaisseur_zone", 2),
            couleur_zone_selectionnee=d.get("couleur_zone_selectionnee", "#a6e3a1"),
            # RÉTROCOMPATIBILITÉ (champ ajouté après coup, cf. docstring
            # ci-dessus) : un projet sauvegardé avant l'introduction de ce
            # badge n'a pas cette clé -- repli sur False (non validé),
            # jamais réinjecté en amont.
            filtre_scindement_valide=d.get("filtre_scindement_valide", False),
        )


@dataclass
class ServiceAPI:
    """Bibliothèque de composants d'un seul service API (point 3).
    (Ancien champ api_features/Feature entièrement retiré -- décision
    explicite utilisateur : les Actions sont désormais globales à tout le
    Project, cf. Project.bibliotheque_actions, réutilisables comme
    fonctions natives par TOUT écran de l'app, plus seulement par ce
    ServiceAPI précis.)"""
    nom: str
    composants: list = field(default_factory=list)  # noms de ComposantSingle (référence par nom)
    # PATCH (groupes de composants, drag & drop) : liste des noms de groupes
    # créés pour ce ServiceAPI, PERSISTÉE même si un groupe est vide (aucun
    # composant dedans) -- distinct de Composant.groupe (le nom de groupe
    # RÉFÉRENCÉ par un composant précis). "Général" n'y figure jamais : c'est
    # une section spéciale toujours présente, non stockée ici (cf.
    # GroupeSection / _charger_grille_composants), correspondant à
    # composant.groupe == "".
    groupes: list = field(default_factory=list)
    # AJOUT (ComposantLayout/cL, cf. SPEC_composantLayout.md section 9) :
    # noms de ComposantLayout (référence par nom, MÊME PATTERN que
    # `composants` ci-dessus pour ComposantSingle) -- LISTE SÉPARÉE plutôt
    # que fusionnée avec `composants` : cS et cL ont des schémas de champs
    # significativement différents (cf. SPEC section 3), un champ
    # discriminant "type" sur une liste unique aurait compliqué chaque site
    # de lecture pour un gain nul. Absent des anciens projets sauvegardés
    # avant l'introduction de cL -> default_factory=list donne [] à
    # l'ouverture, comportement rétrocompatible sans migration nécessaire.
    composants_layout: list = field(default_factory=list)

    def to_dict(self) -> dict:
        return {
            "nom": self.nom,
            "composants": list(self.composants),
            "groupes": list(self.groupes),
            "composants_layout": list(self.composants_layout),
        }

    @staticmethod
    def from_dict(d: dict) -> "ServiceAPI":
        return ServiceAPI(
            nom=d["nom"],
            composants=list(d.get("composants", [])),
            groupes=list(d.get("groupes", [])),
            composants_layout=list(d.get("composants_layout", [])),
        )


@dataclass
class Action:
    """Une Action au sein d'une zone (deb/end) d'une Feature (point 7, étendu).

    7 types d'Action (voir TYPES_ACTION), chacun avec ses paramètres propres :
      - clic       : bouton gauche/droit + durée du clic
      - double_clic: bouton gauche/droit + durée du clic
      - drag       : glisse un fichier (chemin en dur) vers le composant de
                     référence, qui sert de point d'ARRIVÉE (drop)
      - coller     : Ctrl+V sur le presse-papier VIRTUEL de l'instance,
                     sur le composant de référence -- aucun raccourci à
                     saisir, la combinaison est gérée en interne
                     (action_paste côté instance, presse-papier système
                     jamais touché)
      - clear      : sélectionne tout le contenu du composant de référence
                     puis l'efface (Ctrl+A + Suppr en interne) -- comme
                     "coller", aucun raccourci à saisir ; une seule action
                     "banale" plutôt que deux étapes séparées (cf. discussion)
      - type_text  : tape le texte au clavier caractère par caractère
                     (variable associée ou texte littéral) -- PAS un
                     collage presse-papier Ctrl+V, malgré l'ancien nom
                     "paste" (renommé pour éviter la confusion)
      - scroll     : direction (haut/bas/gauche/droite) + nombre de crans

    Ancien type "commande" (raccourci clavier libre en texte, ex: "Ctrl+S")
    entièrement retiré (cf. discussion) : l'utilisateur ne doit jamais avoir
    à connaître/saisir une combinaison de touches -- chaque besoin devient
    une action dédiée ("coller" pour Ctrl+V, "clear" pour Ctrl+A+Suppr...)
    dont la mécanique clavier est gérée en interne, appelable simplement
    depuis l'interface de spécification d'action.

    Pour clic/double_clic/drag/scroll/coller/clear, le composant de référence
    = origine (0,0) ou point d'arrivée (drag), choisi parmi les composants
    déjà présents dans la MÊME zone de la Feature que cette Action (deb ->
    composants de deb, end -> composants de end). Avant tout clic/double-clic/
    drag/scroll/coller/clear, un repositionnement du curseur est simulé (pas
    de déplacement visible réel, seulement les coordonnées calculées puis le
    message PostMessage envoyé directement).

    La durée maximale d'exécution est gérée au niveau de la Feature entière
    (Feature.duree_max), pas Action par Action (point 7.1, simplifié)."""
    id: str = field(default_factory=_new_id)
    type_action: str = "clic"  # voir TYPES_ACTION
    composant_reference: str = ""  # nom du Composant, doit être présent dans la MÊME zone (deb/end) que cette Action

    # --- clic / double_clic ---
    bouton_clic: str = "gauche"  # gauche | droit
    duree_clic: float = 0.1  # secondes, durée d'appui du bouton

    # --- clic / double_clic / drag / scroll : zone de clic sur le composant
    # de référence, 2 modes possibles :
    #   - "par_defaut" : utilise la zone de clic du COMPOSANT lui-même
    #     (composant.zone_clic_mode / composant.zone_clic_rect, définis à sa
    #     création — toute sa surface si le composant n'a pas de zone
    #     personnalisée) ; un point aléatoire y est tiré à l'exécution.
    #   - "personnalise" : ignore la zone de clic du composant, utilise à la
    #     place zone_clic_rect ci-dessous, propre à cette Action précise.
    zone_clic_mode: str = "par_defaut"  # par_defaut | personnalise
    # Rectangle personnalisé de cette Action, tracé par glisser sur l'aperçu
    # live de détection du composant_reference (voir CoordonneeActionScreen),
    # en coordonnées relatives au coin haut-gauche du composant tel que
    # détecté à l'échelle 1.0 (échelle neutralisée au moment du tracé, pour
    # rester stable quelle que soit la taille de la fenêtre en exécution
    # réelle). None tant qu'aucune zone n'a été tracée ainsi.
    zone_clic_rect: Optional[ZoneClicRect] = None

    # --- drag ---
    fichier_drag: str = ""  # chemin de fichier en dur à glisser (point d'arrivée = composant_reference)

    # --- type_text (ex-"paste", renommé -- frappe simulée, pas un vrai Ctrl+V) ---
    variable_associee: Optional[str] = None  # nom de variable APIFeatures, si utilisée
    texte_saisie: str = ""  # texte littéral si pas de variable

    # --- scroll ---
    direction_scroll: str = "bas"  # haut | bas | gauche | droite
    crans_scroll: int = 3

    def to_dict(self) -> dict:
        d = asdict(self)
        d["zone_clic_rect"] = self.zone_clic_rect.to_dict() if self.zone_clic_rect else None
        return d

    @staticmethod
    def from_dict(d: dict) -> "Action":
        d = dict(d)
        # Migration silencieuse : les anciens type_action "clic_gauche" /
        # "clic_droit" (pré-patch) deviennent type_action="clic" +
        # bouton_clic correspondant, pour ne rien perdre à l'ouverture
        # d'un projet existant.
        ancien_type = d.get("type_action")
        if ancien_type == "clic_gauche":
            d["type_action"] = "clic"
            d.setdefault("bouton_clic", "gauche")
        elif ancien_type == "clic_droit":
            d["type_action"] = "clic"
            d.setdefault("bouton_clic", "droit")
        # Migration silencieuse : l'ancien type_action "paste" (renommé
        # "type_text" pour refléter honnêtement son comportement réel --
        # une frappe clavier simulée caractère par caractère, PAS un
        # collage presse-papier Ctrl+V, cf. discussion) devient
        # type_action="type_text", sans toucher aux autres champs
        # (texte_saisie, variable_associee restent inchangés).
        elif ancien_type == "paste":
            d["type_action"] = "type_text"
        # Migration silencieuse : l'ancien type_action "commande" (raccourci
        # clavier libre en texte, ex. "Ctrl+V" saisi à la main, champ
        # raccourci_commande) est remplacé par le type "coller" dédié -- un
        # Ctrl+V sur le presse-papier VIRTUEL de l'instance (action_paste
        # côté instance, presse-papier système jamais touché).
        # Volontairement PAS nommé "paste" en interne : cette chaîne
        # désignait déjà l'ancien type_action pré-renommage (cf. migration
        # ci-dessus, paste -> type_text) -- la réutiliser aurait fait migrer
        # à tort tout projet valide déjà sauvegardé avec ce nouveau type vers
        # type_text au rechargement. L'ancien champ raccourci_commande n'a
        # plus lieu d'être repris : il a été retiré du modèle (le type
        # "commande" est intégralement retiré du code, cette branche ne sert
        # plus qu'à migrer d'anciens projets JSON existants) et ce nouveau
        # type n'a de toute façon pas de raccourci libre, juste
        # composant_reference + zone de clic comme clic/scroll/type_text.
        elif ancien_type == "commande":
            d["type_action"] = "coller"
            d.pop("raccourci_commande", None)
        # Ancien champ "duree" (str "normale"/...) remplacé par duree_clic
        # (float secondes) : on l'ignore simplement si présent, la valeur
        # par défaut de duree_clic s'applique.
        d.pop("duree", None)
        # Migration silencieuse : anciens mode_position/position_x/y +
        # coord_action_x/y (pré-patch "Zone de clic") -> zone_clic_mode /
        # zone_clic_rect. Une coordonnée personnalisée déjà définie (point
        # unique, ancien coord_action_x/y OU ancien mode_position="personnalise"
        # avec position_x/y) devient un petit rectangle de 1x1 centré dessus,
        # pour ne rien perdre : l'utilisateur pourra l'élargir ensuite.
        ancien_mode_position = d.pop("mode_position", None)
        ancien_position_x = d.pop("position_x", None)
        ancien_position_y = d.pop("position_y", None)
        ancien_coord_x = d.pop("coord_action_x", None)
        ancien_coord_y = d.pop("coord_action_y", None)
        if "zone_clic_mode" not in d:
            if ancien_coord_x is not None and ancien_coord_y is not None:
                d["zone_clic_mode"] = "personnalise"
                d["zone_clic_rect"] = {"x": ancien_coord_x, "y": ancien_coord_y, "largeur": 1, "hauteur": 1}
            elif ancien_mode_position == "personnalise":
                d["zone_clic_mode"] = "personnalise"
                d["zone_clic_rect"] = {
                    "x": ancien_position_x or 0, "y": ancien_position_y or 0,
                    "largeur": 1, "hauteur": 1,
                }
            else:
                d["zone_clic_mode"] = "par_defaut"
        zone_clic_rect = d.pop("zone_clic_rect", None)
        champs_valides = {f.name for f in fields(Action)}
        d = {k: v for k, v in d.items() if k in champs_valides}
        d["zone_clic_rect"] = ZoneClicRect.from_dict(zone_clic_rect) if zone_clic_rect else None
        return Action(**d)



@dataclass
class Variable:
    """Variable de données au niveau APIFeatures (point 6). Le path réel n'est jamais sauvegardé."""
    nom: str  # var1, var2... ou renommée par l'utilisateur

    def to_dict(self) -> dict:
        return asdict(self)

    @staticmethod
    def from_dict(d: dict) -> "Variable":
        return Variable(**d)


@dataclass
class BibliothequeActions:
    """Bibliothèque GLOBALE d'Actions du Project (décision explicite
    utilisateur) : contrairement à l'ancien modèle où chaque ServiceAPI
    portait son propre APIFeatures/Feature, les Actions vivent maintenant
    à un seul endroit pour tout le projet, réutilisables comme fonctions
    natives par n'importe quel écran de l'app (TestActionScreen pour le
    test manuel, TaskConfig à venir pour les scripts d'automatisation).
    Une seule instance par Project (cf. Project.bibliotheque_actions).
    Plus de pool "composants_importes" : une Action référence directement
    n'importe quel composant du Project entier, plus de cloisonnement par
    ServiceAPI à gérer."""
    actions: list = field(default_factory=list)  # list[Action], ordre = priorité d'affichage
    variables: list = field(default_factory=list)  # list[Variable]

    def to_dict(self) -> dict:
        return {
            "actions": [a.to_dict() for a in self.actions],
            "variables": [v.to_dict() for v in self.variables],
        }

    @staticmethod
    def from_dict(d: dict) -> "BibliothequeActions":
        return BibliothequeActions(
            actions=[Action.from_dict(a) for a in d.get("actions", [])],
            variables=[Variable.from_dict(v) for v in d.get("variables", [])],
        )

    def find_action(self, id_: str) -> Optional["Action"]:
        return next((a for a in self.actions if a.id == id_), None)

    def add_action(self) -> "Action":
        """Ajoute une Action vide à la fin de la liste ordonnée."""
        action = Action()
        self.actions.append(action)
        return action

    def remove_action(self, id_: str):
        action = self.find_action(id_)
        if action:
            self.actions.remove(action)

    def reordonner_actions(self, ordre_ids: list):
        """Réordonne self.actions selon une liste d'ids dans le nouvel
        ordre voulu (utilisé après un drag dans l'éditeur d'Actions). Les
        Actions dont l'id n'apparaît pas dans ordre_ids (ne devrait pas
        arriver en usage normal) sont conservées à la fin, dans leur ordre
        relatif d'origine, plutôt que silencieusement perdues."""
        par_id = {a.id: a for a in self.actions}
        nouveaux = [par_id[i] for i in ordre_ids if i in par_id]
        restants = [a for a in self.actions if a.id not in ordre_ids]
        self.actions = nouveaux + restants


