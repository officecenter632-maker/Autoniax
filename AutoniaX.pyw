# Écran Composants (Patch 3 : gestion des Interfaces / Patch 4-5 : capture,
# grille de vignettes et panneau de réglages)
# ---------------------------------------------------------------------------
class ComposantsScreen(QWidget):
    """
    Sous-vue "Composants" — onglet interne de ServiceAPIScreen (Phase B :
    fusion des écrans "API" et "Composants" en un seul écran par ServiceAPI,
    à 2 onglets : Composants | Features).

    Ne gère plus la sélection du ServiceAPI elle-même (ni sa création, son
    renommage, ni sa suppression) : tout cela est désormais la responsabilité
    exclusive de ServiceAPIScreen (grille de cards + toolbar + menu ⋮), qui
    pilote cette sous-vue de l'extérieur via set_service_api_actif(nom).

    Ce qui reste ici, inchangé :
    - Zone principale : grille responsive de vignettes des Composants
      du ServiceAPI actif (point 18), + bouton flottant "+ Nouveau composant".
    - Clic sur une vignette -> panneau latéral coulissant (non-modal) avec les
      réglages complets : nom (édition inline), priorité de sélection, seuil
      de confiance, bouton Update (re-capture), bouton supprimer.
    - Capture : overlay plein écran redessinable, Espace valide, Échap annule ;
      dès validation, le Composant est créé IMMÉDIATEMENT dans le modèle avec
      un nom par défaut modifiable (ex: "NouveauComposant") et apparaît dans la
      grille avec son panneau de réglages déjà ouvert — plus de QDialog séparé.
    """

    demande_ouvrir_test_composant = Signal(str)  # nom complet du composant
    # AJOUT (SPEC_lot_corrections_2026-09.md section 3, compteur cL/cS) :
    # émis à chaque fois que le nombre de composants du ServiceAPI actif
    # change (rechargement complet de la grille, ajout ou suppression
    # unitaire -- PAS lors d'un simple renommage, qui ne change pas le
    # total). Écouté par ServiceAPIScreen pour tenir à jour le libellé de
    # l'onglet "ComposantSingle" (cf. sa connexion posée juste après la
    # construction de composants_tab).
    nb_composants_change = Signal(int)

    def __init__(self, project: Project, parent=None):
        super().__init__(parent)
        self.project = project

        root_layout = QHBoxLayout(self)
        root_layout.setContentsMargins(0, 0, 0, 0)
        root_layout.setSpacing(0)

        # --- Panneau latéral de navigation entre groupes (PATCH) ---
        # Liste des groupes du ServiceAPI actif ("Général" en premier) --
        # cliquer sur une entrée fait défiler la grille (grid_scroll,
        # créé plus bas) jusqu'à la GroupeSection correspondante, en
        # animant le scroll ("slide") plutôt qu'un saut instantané.
        self.groupes_nav_panel = GroupesNavPanel(self)
        self.groupes_nav_panel.groupe_choisi.connect(self._scroller_vers_groupe)
        self.groupes_nav_panel.setVisible(False)
        root_layout.addWidget(self.groupes_nav_panel)

        # --- Zone principale : grille de vignettes ---
        main_area = QWidget(self)
        main_area.setObjectName("ComponentsMainArea")
        main_area_outer_layout = QVBoxLayout(main_area)
        main_area_outer_layout.setContentsMargins(0, 0, 0, 0)
        main_area_outer_layout.setSpacing(0)

        # Placeholder affiché tant qu'aucun ServiceAPI n'est sélectionné.
        self.placeholder_widget = QWidget(main_area)
        placeholder_layout = QVBoxLayout(self.placeholder_widget)
        placeholder_layout.setAlignment(Qt.AlignCenter)
        placeholder_layout.setSpacing(16)
        placeholder_icon = QLabel(self.placeholder_widget)
        placeholder_icon.setPixmap(qta.icon("mdi6.image-multiple-outline", color=Mocha.surface2).pixmap(40, 40))
        placeholder_icon.setAlignment(Qt.AlignCenter)
        placeholder_layout.addWidget(placeholder_icon)
        self.main_area_label = QLabel("Sélectionnez un ServiceAPI pour voir ses composants", self.placeholder_widget)
        self.main_area_label.setObjectName("PlaceholderSubtitle")
        self.main_area_label.setAlignment(Qt.AlignCenter)
        placeholder_layout.addWidget(self.main_area_label)
        main_area_outer_layout.addWidget(self.placeholder_widget, 1)

        # Grille de vignettes (dans un QScrollArea pour le défilement vertical).
        # PATCH (groupes de composants, drag & drop) : le contenu du
        # QScrollArea n'est plus une seule FlowGrid mais une colonne de
        # GroupeSection empilées verticalement (une par groupe, "Général"
        # toujours en premier) -- cf. _charger_grille_composants.
        self.grid_scroll = QScrollArea(main_area)
        self.grid_scroll.setObjectName("FlowGridViewport")
        self.grid_scroll.setWidgetResizable(True)
        self.grid_scroll.setFrameShape(QFrame.NoFrame)
        self.grid_scroll.setHorizontalScrollBarPolicy(Qt.ScrollBarAlwaysOff)
        # Policy (pas CSS) : masque la barre native tout en gardant le
        # scroll fonctionnel (molette, drag, clavier).
        self.grid_scroll.setVerticalScrollBarPolicy(Qt.ScrollBarAlwaysOff)
        self.groupes_container = QWidget()
        self.groupes_container.setObjectName("GroupesContainer")
        self.groupes_layout = QVBoxLayout(self.groupes_container)
        self.groupes_layout.setContentsMargins(0, 0, 0, 0)
        self.groupes_layout.setSpacing(18)
        self.groupes_layout.setAlignment(Qt.AlignTop)
        self.grid_scroll.setWidget(self.groupes_container)
        self.grid_scroll.setVisible(False)
        main_area_outer_layout.addWidget(self.grid_scroll, 1)

        # BUG FIX (le panneau de réglages ne se fermait qu'au clic sur son
        # propre bouton de fermeture) : un clic dans la zone des composants,
        # EN DEHORS d'une vignette (donc sur l'espace vide entre/autour des
        # GroupeSection), doit aussi refermer le panneau. On filtre les
        # événements du viewport du QScrollArea plutôt que d'ajouter un
        # mousePressEvent sur chaque widget enfant : childAt(pos) renvoie
        # None (ou un widget qui n'est ni une tuile ni un contrôle interactif)
        # quand le clic tombe réellement dans l'espace vide -- un clic sur
        # une ComposantTuile ou un bouton de menu de groupe est déjà
        # intercepté par CE widget enfant avant d'atteindre le viewport
        # (propagation Qt normale), donc aucun risque de fermer le panneau
        # juste après l'avoir rouvert par un clic sur une tuile.
        self.grid_scroll.viewport().installEventFilter(self)

        root_layout.addWidget(main_area, 1)

        # Boutons flottants, empilés en bas à droite de la zone principale :
        # "+ Nouveau composant" (point 18) au-dessus de "+ Nouveau groupe"
        # (PATCH groupes de composants).
        self.floating_add_button = QToolButton(main_area)
        self.floating_add_button.setObjectName("FloatingAddButton")
        self.floating_add_button.setIcon(qta.icon("mdi6.plus", color=Mocha.crust))
        self.floating_add_button.setIconSize(QSize(26, 26))
        self.floating_add_button.setFixedSize(44, 44)
        self.floating_add_button.setCursor(Qt.PointingHandCursor)
        self.floating_add_button.setToolTip("Nouveau composant (capturer)")
        self.floating_add_button.clicked.connect(self._start_capture_composant)
        self.floating_add_button.setVisible(False)
        self.floating_add_button.raise_()

        self.floating_add_groupe_button = QToolButton(main_area)
        self.floating_add_groupe_button.setObjectName("FloatingAddGroupeButton")
        self.floating_add_groupe_button.setIcon(qta.icon("mdi6.folder-plus-outline", color=Mocha.crust))
        self.floating_add_groupe_button.setIconSize(QSize(22, 22))
        self.floating_add_groupe_button.setFixedSize(44, 44)
        self.floating_add_groupe_button.setCursor(Qt.PointingHandCursor)
        self.floating_add_groupe_button.setToolTip("Nouveau groupe")
        self.floating_add_groupe_button.clicked.connect(self._creer_nouveau_groupe)
        self.floating_add_groupe_button.setVisible(False)
        self.floating_add_groupe_button.raise_()

        # Bouton flottant "capturer depuis le rendu réseau" (PATCH -- demande
        # explicite utilisateur : "sa doit toujour etre la ou cest actuelement,
        # nouveau composant loin dans la classe api ... bouton separer") :
        # BOUTON SÉPARÉ du floating_add_button existant, qui reste INCHANGÉ
        # (capture bureau classique, cf. _start_capture_composant). Celui-ci
        # ouvre le MÊME overlay SelectionZoneOverlay/le même point de fusion
        # _on_zone_selectionnee, mais avec self._derniere_image du panneau de
        # rendu réseau (FenetreRenduTaskReseau, TaskConfigScreen) comme image
        # de base au lieu de capture_bureau_complet() -- cf. _start_capture_
        # composant_depuis_rendu_reseau. N'existe QUE si un ServiceAPI a une
        # instance de rendu réseau active AVEC une image reçue : masqué sinon
        # (cf. self._get_image_rendu_reseau_actif, injecté depuis MainWindow
        # via ServiceAPIScreen.definir_source_rendu_reseau -- ComposantsScreen
        # ne connaît pas TaskConfigScreen directement, même séparation de
        # responsabilités que le reste du fichier).
        self._get_image_rendu_reseau_actif: Optional[Callable[[], Optional[QImage]]] = None
        # PATCH (mode sélection multiple du panneau de rendu réseau,
        # demande explicite utilisateur) -- second callback, injecté au
        # même endroit/moment que le précédent (cf. definir_source_
        # rendu_reseau), qui renvoie la liste des zones déjà découpées
        # dans FenetreRenduTaskReseau (self._captures_selectionnees) et
        # les VIDE côté source une fois consommées (cf. docstring de
        # definir_source_rendu_reseau et de _start_capture_composant_
        # depuis_rendu_reseau). Distinct de _get_image_rendu_reseau_actif
        # (qui reste utile tel quel : c'est encore lui qui décide si
        # floating_add_depuis_rendu_button doit être visible, cf.
        # _rafraichir_visibilite_bouton_depuis_rendu -- une image de
        # rendu affichée suffit, indépendamment de toute sélection en
        # attente).
        self._prendre_captures_selectionnees_reseau: Optional[Callable[[], list]] = None
        # AJOUT (demande explicite utilisateur : choisir une capture déjà
        # en attente pour mettre à jour l'image d'un composant existant
        # ou lui ajouter une variante) -- cf. docstring complète de
        # definir_source_rendu_reseau pour la différence avec le callback
        # ci-dessus (celui-ci consomme toute la liste, ceux-ci consultent/
        # retirent un seul élément).
        self._consulter_captures_selectionnees_reseau: Optional[Callable[[], list]] = None
        self._retirer_capture_selectionnee_reseau: Optional[Callable[[int], None]] = None
        # AJOUT -- référence forte à DialogueChoixCaptureOuNouvelle le
        # temps qu'elle est ouverte (même raison que self._overlay_capture
        # : éviter le garbage-collect prématuré d'une fenêtre top-level).
        self._dialogue_choix_capture: Optional["DialogueChoixCaptureOuNouvelle"] = None
        self.floating_add_depuis_rendu_button = QToolButton(main_area)
        self.floating_add_depuis_rendu_button.setObjectName("FloatingAddDepuisRenduButton")
        self.floating_add_depuis_rendu_button.setIcon(qta.icon("mdi6.monitor-screenshot", color=Mocha.crust))
        self.floating_add_depuis_rendu_button.setIconSize(QSize(22, 22))
        self.floating_add_depuis_rendu_button.setFixedSize(44, 44)
        self.floating_add_depuis_rendu_button.setCursor(Qt.PointingHandCursor)
        self.floating_add_depuis_rendu_button.setToolTip(
            "Nouveau composant (capturer depuis le rendu réseau actif)"
        )
        self.floating_add_depuis_rendu_button.clicked.connect(
            self._start_capture_composant_depuis_rendu_reseau
        )
        self.floating_add_depuis_rendu_button.setVisible(False)
        self.floating_add_depuis_rendu_button.raise_()

        # PATCH (sélection multiple, demande explicite utilisateur) --
        # bouton flottant supplémentaire, empilé encore au-dessus des 3
        # précédents (même colonne) : "Supprimer la sélection" (icône
        # poubelle). Masqué tant que self._selection_multi est vide (cf.
        # _rafraichir_etat_selection_multi) -- ne coexiste jamais visuellement
        # avec un état où rien n'est coché, contrairement aux 3 boutons
        # "+" ci-dessus qui restent affichés en permanence (dès qu'un
        # ServiceAPI est actif). Couleur rouge (fond) pour signaler
        # l'action destructive, cohérent avec la bordure rouge de
        # ComposantTuile[selectionnee_multi="true"].
        self.floating_supprimer_selection_button = QToolButton(main_area)
        self.floating_supprimer_selection_button.setObjectName("FloatingSupprimerSelectionButton")
        self.floating_supprimer_selection_button.setIcon(qta.icon("mdi6.trash-can-outline", color=Mocha.crust))
        self.floating_supprimer_selection_button.setIconSize(QSize(22, 22))
        self.floating_supprimer_selection_button.setFixedSize(44, 44)
        self.floating_supprimer_selection_button.setCursor(Qt.PointingHandCursor)
        self.floating_supprimer_selection_button.clicked.connect(self._supprimer_selection_multi)
        self.floating_supprimer_selection_button.setVisible(False)
        self.floating_supprimer_selection_button.raise_()

        # --- Panneau latéral de réglages (REFONTE : flottant en overlay,
        # demande explicite utilisateur : "je veux que tu rendes le
        # panneau de réglages de ComposantSingle flottant, actuellement
        # quand il apparaît il perturbe le layout des ComposantSingle") --
        # AVANT : root_layout.addWidget(self.reglages_panel) l'ajoutait
        # comme widget FRÈRE de main_area dans le QHBoxLayout externe,
        # donc son apparition/disparition (setFixedWidth(300)) rétrécissait/
        # regrandissait main_area EN DIRECT -- cf. la docstring, désormais
        # obsolète, de l'ancienne _forcer_relayout_grille_apres_toggle_
        # panneau qui documentait déjà ce symptôme exact ("main_area
        # rétrécit/regrandit... les vignettes restent alignées derrière le
        # panneau"). MAINTENANT : parent = main_area (pas root_layout),
        # positionnement en coordonnées ABSOLUES par-dessus la grille (cf.
        # _repositionner_reglages_panel, appelée par le même resizeEvent
        # que les boutons flottants ci-dessus) -- MÊME philosophie que
        # PanneauProprietesLayoutFlottant côté ComposantsLayoutScreen (cf.
        # sa docstring : "Widget OVERLAY ... pas un vrai layout Qt"),
        # adaptée ici en panneau plein-hauteur ancré à droite plutôt qu'en
        # coin bas-gauche (la structure interne du panneau -- scroll,
        # champs -- reste À L'IDENTIQUE, seul son mode d'ancrage change).
        self.reglages_panel = ComposantReglagesPanel(main_area)
        self.reglages_panel.project = self.project
        self.reglages_panel.setVisible(False)
        self.reglages_panel.demande_fermeture.connect(self._fermer_panneau_reglages)
        self.reglages_panel.demande_update_image.connect(self._start_update_composant_image)
        self.reglages_panel.demande_suppression.connect(self._confirm_delete_composant)
        self.reglages_panel.nom_modifie.connect(self._on_composant_renomme)
        self.reglages_panel.demande_definir_zone_clic.connect(self._start_definir_zone_clic)
        self.reglages_panel.demande_tester_composant.connect(self._start_tester_composant)
        self.reglages_panel.demande_ajouter_variante.connect(self._start_ajouter_variante)
        self.reglages_panel.demande_supprimer_variante.connect(self._supprimer_variante)
        self.reglages_panel.raise_()

        # ServiceAPI actuellement actif, piloté depuis l'extérieur par
        # ServiceAPIScreen via set_service_api_actif(nom) — plus de
        # sélection locale (l'ancienne colonne gauche a été retirée).
        self._service_api_actif: Optional[str] = None

        # Référence forte vers l'overlay de capture en cours : sans elle,
        # Python pourrait garbage-collecter le QWidget dès la sortie de
        # _start_capture_composant faute de référence conservée.
        self._overlay_capture: Optional["SelectionZoneOverlay"] = None
        # Composant ciblé par une re-capture (Update) en cours, le cas échéant
        # (None => la capture en cours crée un NOUVEAU composant).
        self._composant_en_recapture: Optional[str] = None
        # Composant ciblé par un AJOUT DE VARIANTE en cours, le cas échéant
        # (None => la capture en cours n'ajoute pas de variante). Distinct de
        # _composant_en_recapture : l'Update remplace l'image principale,
        # l'ajout de variante l'enrichit d'une image supplémentaire.
        self._composant_en_ajout_variante: Optional[str] = None
        # Référence forte vers le sélecteur de zone de clic en cours (même
        # raison que _overlay_capture : éviter le garbage-collect prématuré).
        self._zone_clic_selector: Optional["ZoneClicSelector"] = None

        # Vignettes actuellement affichées, indexées par nom complet de Composant.
        self._tuiles: dict = {}
        self._composant_selectionne: Optional[str] = None
        # Sections de groupe actuellement affichées, indexées par nom de
        # groupe ("" pour Général) -- cf. _charger_grille_composants.
        self._sections_groupe: dict = {}
        # PATCH (navigation rapide entre groupes) : référence forte vers
        # l'animation de scroll en cours (cf. _scroller_vers_groupe), pour
        # pouvoir l'arrêter proprement si l'utilisateur re-clique sur le
        # menu avant la fin d'un défilement précédent.
        self._scroll_animation: Optional[QPropertyAnimation] = None

        # PATCH (sélection multiple, demande explicite utilisateur) --
        # noms complets des composants actuellement cochés pour suppression
        # groupée (Ctrl+clic/Shift+clic, cf. _on_tuile_cliquee_avec_
        # modifiers). Distinct de _composant_selectionne ci-dessus, qui
        # reste la sélection SIMPLE pilotant le panneau de réglages -- les
        # deux mécanismes coexistent mais un Ctrl/Shift+clic ferme toujours
        # le panneau de réglages en pratique (cf. _on_tuile_cliquee_avec_
        # modifiers) pour éviter toute ambiguïté visuelle entre "ouvert
        # dans le panneau" et "coché pour suppression".
        self._selection_multi: set = set()
        # Dernière tuile cliquée SANS Shift, servant de point de départ à
        # une plage Shift+clic (comportement explorateur de fichiers
        # standard) -- reset à None dès que la sélection multi est vidée.
        self._ancre_selection_multi: Optional[str] = None
        # Reçoit les événements clavier (Suppr) même si aucun widget enfant
        # n'a explicitement le focus -- cf. keyPressEvent ci-dessous.
        self.setFocusPolicy(Qt.StrongFocus)

    def resizeEvent(self, event):
        super().resizeEvent(event)
        self._repositionner_bouton_flottant()
        self._repositionner_reglages_panel()

    def keyPressEvent(self, event):
        # PATCH (sélection multiple, demande explicite utilisateur) --
        # Suppr/Retour arrière supprime directement les composants cochés,
        # même raccourci que la plupart des explorateurs de fichiers.
        # Ignoré si rien n'est sélectionné (rien à faire) ou si le panneau
        # de réglages est visible (dans ce cas, Ctrl/Shift+clic aurait déjà
        # fermé le panneau et vidé toute sélection multi précédente -- cf.
        # _on_tuile_cliquee_avec_modifiers -- donc les deux ne peuvent pas
        # être vrais en même temps en pratique ; ce garde-fou reste défensif
        # au cas où un focus clavier resterait sur ComposantsScreen pendant
        # que le panneau capte par ailleurs Suppr pour un autre usage, ex:
        # un champ de texte en cours d'édition).
        if event.key() in (Qt.Key_Delete, Qt.Key_Backspace) and self._selection_multi and not self.reglages_panel.isVisible():
            self._supprimer_selection_multi()
            return
        super().keyPressEvent(event)

    def showEvent(self, event):
        """PATCH -- rafraîchit floating_add_depuis_rendu_button à chaque
        réaffichage de cet écran (ex: l'utilisateur ouvre le rendu réseau
        dans TaskConfigScreen, PUIS bascule vers l'écran API/Composants) :
        self._get_image_rendu_reseau_actif() n'est appelé qu'à la demande
        (cf. sa docstring), donc rien ne met à jour ce bouton tant qu'il
        n'est pas explicitement réinterrogé -- showEvent est le point
        naturel le plus simple pour ça, sans signal cross-écran
        supplémentaire.

        AJOUT (panneau de réglages flottant, cf. docstring d'instanciation
        dans __init__) : repositionne aussi reglages_panel ici -- filet de
        sécurité pour le tout premier affichage de cet écran, où
        resizeEvent peut ne pas s'être encore déclenché avec la géométrie
        finale de main_area au moment où le panneau serait ouvert."""
        super().showEvent(event)
        self._rafraichir_visibilite_bouton_depuis_rendu()
        self._repositionner_reglages_panel()

    def eventFilter(self, obj, event):
        # BUG FIX (fermeture automatique du panneau de réglages) : cf.
        # commentaire à l'installation du filtre (grid_scroll.viewport()
        # dans __init__). Un clic dans la zone des composants, sur l'espace
        # VRAIMENT vide (ni tuile, ni en-tête de groupe, ni bouton), doit
        # refermer le panneau si celui-ci est ouvert.
        #
        # RÉGRESSION CORRIGÉE (v1 de ce filtre) : tester seulement
        # "obj is self.grid_scroll.viewport()" ne suffit pas -- c'est
        # TOUJOURS vrai (seul widget sur lequel le filtre est installé), y
        # compris pour un clic sur une ComposantTuile (le viewport voit
        # passer tous les événements souris de sa zone avant redistribution
        # à l'enfant sous le curseur). Le panneau qu'on venait d'ouvrir
        # (cf. _on_tuile_cliquee) était donc immédiatement refermé par ce
        # même clic. On distingue maintenant précisément l'espace vide d'un
        # widget enfant réel via childAt(), en descendant jusque dans
        # groupes_container (cf. ci-dessous, childAt() sur le viewport lui-
        # même renvoie toujours groupes_container, jamais None).
        #
        # RÉGRESSION CORRIGÉE (v2 de ce filtre) : childAt() sur
        # groupes_container s'arrête au premier widget trouvé -- si le
        # clic tombe dans l'espace vide À L'INTÉRIEUR d'une GroupeSection
        # (sous les tuiles existantes, ou sur une section sans encore de
        # composant), ce premier widget trouvé est la GroupeSection (ou son
        # flow_grid) elle-même, PAS groupes_container et PAS None -- donc
        # l'ancienne condition ne fermait jamais le panneau dans ce cas,
        # alors que ce clic est bien un clic dans l'espace vide au sens où
        # l'utilisateur l'entend (pas sur une tuile, pas sur l'en-tête).
        # On remonte maintenant la hiérarchie de widgets sous le clic pour
        # vérifier s'il s'agit RÉELLEMENT d'une ComposantTuile (ou d'un de
        # ses enfants, ex: son image/label) ou d'un widget du header d'une
        # GroupeSection (titre, bouton menu ⋮) -- seuls ces widgets gèrent
        # déjà leur propre clic et ne doivent donc PAS fermer le panneau.
        # Tout le reste (GroupeSection elle-même, son flow_grid vide,
        # groupes_container, ou None) est de l'espace vide => on ferme.
        if (
            obj is self.grid_scroll.viewport()
            and event.type() == QEvent.MouseButtonPress
            and event.button() == Qt.LeftButton
            and self.reglages_panel.isVisible()
        ):
            pos_dans_container = self.groupes_container.mapFrom(
                self.grid_scroll.viewport(), event.pos()
            )
            widget_sous_clic = self.groupes_container.childAt(pos_dans_container)
            clic_sur_widget_interactif = False
            w = widget_sous_clic
            while w is not None and w is not self.groupes_container:
                if isinstance(w, (ComposantTuile, QToolButton)):
                    clic_sur_widget_interactif = True
                    break
                w = w.parentWidget()
            if not clic_sur_widget_interactif:
                self._fermer_panneau_reglages()
        return super().eventFilter(obj, event)

    def _repositionner_bouton_flottant(self):
        main_area = self.floating_add_button.parentWidget()
        if main_area is None:
            return
        marge = 24
        espacement = 12
        x = main_area.width() - self.floating_add_button.width() - marge
        y = main_area.height() - self.floating_add_button.height() - marge
        self.floating_add_button.move(max(0, x), max(0, y))
        # "+ Nouveau groupe" juste au-dessus de "+ Nouveau composant" (même
        # colonne, empilés) -- PATCH groupes de composants.
        x_groupe = main_area.width() - self.floating_add_groupe_button.width() - marge
        y_groupe = y - self.floating_add_groupe_button.height() - espacement
        self.floating_add_groupe_button.move(max(0, x_groupe), max(0, y_groupe))
        # "Capturer depuis le rendu réseau" empilé encore au-dessus (même
        # colonne) -- PATCH bouton séparé pour capture depuis le rendu.
        x_depuis_rendu = main_area.width() - self.floating_add_depuis_rendu_button.width() - marge
        y_depuis_rendu = y_groupe - self.floating_add_depuis_rendu_button.height() - espacement
        self.floating_add_depuis_rendu_button.move(max(0, x_depuis_rendu), max(0, y_depuis_rendu))
        # "Supprimer la sélection" empilé tout en haut de la colonne (PATCH
        # sélection multiple) -- au-dessus de "Capturer depuis le rendu
        # réseau", pas en dessous : c'est le bouton le moins souvent visible
        # des 4 (seulement si une sélection est en cours), le mettre tout en
        # haut évite qu'il ne décale les 3 autres quand il apparaît/disparaît
        # (leurs positions respectives ne dépendent que les unes des autres,
        # jamais de celle-ci).
        x_supprimer_selection = main_area.width() - self.floating_supprimer_selection_button.width() - marge
        y_supprimer_selection = y_depuis_rendu - self.floating_supprimer_selection_button.height() - espacement
        self.floating_supprimer_selection_button.move(max(0, x_supprimer_selection), max(0, y_supprimer_selection))

    def _repositionner_reglages_panel(self):
        """REFONTE (panneau flottant, cf. docstring d'instanciation de
        reglages_panel dans __init__) : plaque le panneau contre le bord
        DROIT de main_area, sur toute sa hauteur -- MÊME largeur fixe
        (300, cf. ComposantReglagesPanel.setFixedWidth) qu'avant, mais en
        coordonnées absolues (setGeometry) plutôt qu'un widget frère dans
        root_layout, pour que main_area (et donc grid_scroll/flow_grid)
        ne change JAMAIS de taille selon que le panneau est visible ou
        non -- exactement le symptôme signalé ("perturbe le layout des
        composant single") qui disparaît avec ce changement.

        Appelée depuis resizeEvent (cf. ci-dessus) -- il n'est plus
        nécessaire d'appeler ceci séparément à l'ouverture/fermeture du
        panneau : main_area ne redimensionne plus JAMAIS suite à
        reglages_panel.setVisible(), donc raise_() dans _afficher_
        panneau_reglages (cf. plus bas) suffit pour l'amener au premier
        plan à sa géométrie déjà correcte."""
        main_area = self.reglages_panel.parentWidget()
        if main_area is None:
            return
        largeur = self.reglages_panel.width()
        self.reglages_panel.setGeometry(main_area.width() - largeur, 0, largeur, main_area.height())

    @property
    def nb_composants(self) -> int:
        """AJOUT (section 3, compteur cL/cS) : nombre de composants
        actuellement affichés (toutes sections/groupes confondus), pour
        le libellé d'onglet "ComposantSingle (N)" côté ServiceAPIScreen."""
        return len(self._tuiles)

    # ------------------------------------------------------------------
    # Pilotage externe : ServiceAPIScreen appelle cette méthode publique
    # à chaque ouverture d'un ServiceAPI (et après un renommage) pour
    # indiquer quel ServiceAPI cette sous-vue doit afficher. Remplace
    # l'ancien _on_service_api_selected(item), qui dépendait d'un clic
    # local sur une colonne désormais supprimée.
    # ------------------------------------------------------------------
    def set_service_api_actif(self, nom: Optional[str]):
        self._service_api_actif = nom
        self._fermer_panneau_reglages()
        # PATCH (sélection multiple) -- une sélection en cours n'a plus de
        # sens en changeant de ServiceAPI (les tuiles cochées vont être
        # détruites/reconstruites juste en dessous, cf. _clear_sections_
        # groupe/_charger_grille_composants) : on la vide AVANT de perdre
        # les références aux tuiles, sinon _rafraichir_etat_selection_multi
        # itérerait sur self._tuiles déjà vidé sans jamais mettre à jour le
        # bouton flottant en conséquence.
        self._vider_selection_multi()
        if nom is None:
            self._clear_sections_groupe()
            self._tuiles = {}
            self.placeholder_widget.setVisible(True)
            self.grid_scroll.setVisible(False)
            self.main_area_label.setText("Sélectionnez un ServiceAPI pour voir ses composants")
            self.floating_add_button.setVisible(False)
            self.floating_add_groupe_button.setVisible(False)
            self.floating_add_depuis_rendu_button.setVisible(False)
            self.floating_supprimer_selection_button.setVisible(False)
            self.groupes_nav_panel.setVisible(False)
            self.nb_composants_change.emit(self.nb_composants)
            return
        self._charger_grille_composants(nom)
        self.floating_add_button.setVisible(True)
        self.floating_add_groupe_button.setVisible(True)
        self._rafraichir_visibilite_bouton_depuis_rendu()
        self._repositionner_bouton_flottant()
        self.nb_composants_change.emit(self.nb_composants)

    def definir_source_rendu_reseau(
        self,
        get_image: Optional[Callable[[], Optional[QImage]]],
        prendre_captures_selectionnees: Optional[Callable[[], list]] = None,
        consulter_captures_selectionnees: Optional[Callable[[], list]] = None,
        retirer_capture_selectionnee: Optional[Callable[[int], None]] = None,
    ):
        """Injection externe (cf. ServiceAPIScreen.definir_source_rendu_
        reseau, appelée depuis MainWindow -- même patron que les autres
        liens inter-écrans du fichier) : `get_image` est un callback SANS
        argument, appelé à la demande (pas un signal -- ce qui compte
        c'est l'état AU MOMENT du clic, pas un événement ponctuel), qui
        renvoie l'image actuellement affichée dans le panneau de rendu
        réseau (FenetreRenduTaskReseau._derniere_image), ou None si aucun
        rendu réseau n'est actif/n'a encore reçu d'image. Détermine si
        floating_add_depuis_rendu_button doit être visible.

        `prendre_captures_selectionnees` (PATCH -- mode sélection
        multiple, demande explicite utilisateur) : second callback SANS
        argument, optionnel, qui renvoie la liste des zones déjà
        découpées dans FenetreRenduTaskReseau (cf. sa docstring de
        classe, self._captures_selectionnees) ET les retire de cette
        liste d'origine dans la foulée (consommation, pas simple
        lecture) -- cf. _start_capture_composant_depuis_rendu_reseau,
        qui l'appelle au clic sur floating_add_depuis_rendu_button pour
        créer un composant PAR image renvoyée.

        `consulter_captures_selectionnees`/`retirer_capture_selectionnee`
        (AJOUT -- demande explicite utilisateur : choisir UNE capture
        déjà en attente pour mettre à jour l'image d'un composant
        existant, ou lui ajouter une variante, sans consommer toute la
        liste comme le fait prendre_captures_selectionnees ci-dessus) :
        le premier renvoie une COPIE de la liste (jamais vidée), le
        second retire un unique élément par index une fois qu'il a été
        choisi et appliqué -- cf. _start_update_composant_image et
        _start_ajouter_variante, qui ouvrent DialogueChoixCaptureOuNouvelle
        avec ces deux callbacks."""
        self._get_image_rendu_reseau_actif = get_image
        self._prendre_captures_selectionnees_reseau = prendre_captures_selectionnees
        self._consulter_captures_selectionnees_reseau = consulter_captures_selectionnees
        self._retirer_capture_selectionnee_reseau = retirer_capture_selectionnee
        self._rafraichir_visibilite_bouton_depuis_rendu()

    def _rafraichir_visibilite_bouton_depuis_rendu(self):
        """Réévalue si floating_add_depuis_rendu_button doit être affiché --
        appelée à chaque fois que la disponibilité de l'image de rendu
        réseau peut avoir changé (injection du callback, changement de
        ServiceAPI actif, ou juste avant d'ouvrir l'overlay -- cf. ses
        appelants). Masqué par défaut : ni callback injecté, ni
        ServiceAPI actif, ni image actuellement disponible ne doivent
        laisser ce bouton visible mais inopérant."""
        if self._service_api_actif is None or self._get_image_rendu_reseau_actif is None:
            self.floating_add_depuis_rendu_button.setVisible(False)
            return
        try:
            image = self._get_image_rendu_reseau_actif()
        except Exception:
            image = None
        self.floating_add_depuis_rendu_button.setVisible(image is not None and not image.isNull())

    def _clear_sections_groupe(self):
        for section in self._sections_groupe.values():
            self.groupes_layout.removeWidget(section)
            section.setParent(None)
            section.deleteLater()
        self._sections_groupe = {}

    # ------------------------------------------------------------------
    # Grille de vignettes (Patch 5) — restructurée en sections par groupe
    # (PATCH groupes de composants, drag & drop)
    # ------------------------------------------------------------------
    def _creer_section_groupe(self, nom_groupe: str, est_general: bool) -> "GroupeSection":
        section = GroupeSection(nom_groupe, est_general)
        section.demande_deplacement_composant.connect(self._on_deplacement_composant)
        section.demande_renommer_groupe.connect(self._on_renommer_groupe)
        section.demande_supprimer_groupe.connect(self._on_supprimer_groupe)
        self._sections_groupe[nom_groupe] = section
        self.groupes_layout.addWidget(section)
        # PATCH FIX (drop pas réceptif sur un groupe fraîchement créé) :
        # setAcceptDrops(True) est posé dans GroupeSection.__init__, mais
        # tant que ce widget n'a pas terminé au moins un cycle show/polish
        # complet APRÈS avoir été inséré dans son layout parent (ici, un
        # QScrollArea déjà visible), Qt peut ne pas enregistrer sa zone
        # comme cible de drop valide -- le winId()/la géométrie utilisés
        # par le système de drag&drop natif ne sont fiables qu'une fois ce
        # cycle terminé. show() explicite force Qt à créer/polir le widget
        # immédiatement plutôt que d'attendre le prochain passage de la
        # boucle d'événements (ce qui, en pratique, n'arrivait qu'après un
        # redémarrage de l'appli -- premier affichage "propre" de l'écran).
        section.show()
        return section

    def _charger_grille_composants(self, service_api_nom: str):
        """PATCH (groupes de composants, drag & drop) : construit une
        GroupeSection par groupe (Général en premier, TOUJOURS présent
        même sans composant, puis les groupes de service_api.groupes dans
        l'ordre, y compris ceux encore vides), et y répartit les vignettes
        selon composant.groupe. Le placeholder "aucun composant" ne
        s'affiche que si le ServiceAPI n'a NI composant NI groupe créé --
        un groupe vide doit rester visible pour qu'on puisse y glisser un
        composant dedans."""
        service_api = self.project.find_service_api(service_api_nom)
        self._clear_sections_groupe()
        self._tuiles = {}

        if service_api is None:
            self.placeholder_widget.setVisible(True)
            self.grid_scroll.setVisible(False)
            self.groupes_nav_panel.definir_groupes([])
            return

        # BUG FIX (composant nouvellement créé invisible tant qu'on ne
        # ferme/rouvre pas l'écran) : la section "Général" (nom_groupe == "")
        # est désormais TOUJOURS créée dès qu'un ServiceAPI est actif, même
        # sans aucun composant ni groupe -- avant ce correctif, un ServiceAPI
        # vide sortait ici sans jamais appeler _creer_section_groupe("", ...),
        # donc self._sections_groupe restait {} ; le premier composant capturé
        # ensuite (cf. _on_zone_selectionnee) faisait
        # self._sections_groupe.get("") -> None et la vignette n'était jamais
        # insérée dans aucun layout visible (perdue à l'écran, bien que déjà
        # dans le modèle et self._tuiles -- d'où la nécessité de fermer/
        # rouvrir l'écran, seul moment où _charger_grille_composants était
        # rappelée avec service_api.composants non vide cette fois).
        if not service_api.composants and not service_api.groupes:
            self.placeholder_widget.setVisible(True)
            self.grid_scroll.setVisible(False)
            self.groupes_nav_panel.definir_groupes([("", "Général")])
            self.main_area_label.setText(
                f"ServiceAPI « {service_api_nom} » — aucun composant. "
                "Cliquez sur « + » pour en capturer un."
            )
            self._creer_section_groupe("", est_general=True)
            return

        self.placeholder_widget.setVisible(False)
        self.grid_scroll.setVisible(True)

        # Regroupe les composants par groupe (Général = groupe == "").
        composants_par_groupe: dict = {"": []}
        for nom_groupe in service_api.groupes:
            composants_par_groupe.setdefault(nom_groupe, [])
        for comp_nom in service_api.composants:
            composant = self.project.find_composant(comp_nom)
            if composant is None:
                continue
            composants_par_groupe.setdefault(composant.groupe, []).append(composant)

        # Général toujours en premier, puis les groupes dans l'ordre de
        # service_api.groupes (persiste l'ordre de création choisi par
        # l'utilisateur plutôt qu'un tri alphabétique).
        section_generale = self._creer_section_groupe("", est_general=True)
        self._peupler_section(section_generale, composants_par_groupe[""])

        for nom_groupe in service_api.groupes:
            section = self._creer_section_groupe(nom_groupe, est_general=False)
            self._peupler_section(section, composants_par_groupe.get(nom_groupe, []))

        # PATCH (navigation rapide entre groupes) : la liste du panneau
        # latéral suit exactement le même ordre que les GroupeSection
        # créées ci-dessus (Général en premier, puis service_api.groupes).
        entrees_nav = [("", "Général")] + [(g, g) for g in service_api.groupes]
        self.groupes_nav_panel.definir_groupes(entrees_nav)

        # BUG FIX (drop toujours pas réceptif sur un groupe fraîchement créé,
        # malgré show() + un seul processEvents()) : un unique passage de la
        # boucle d'événements ne garantit pas que le QLayout du QScrollArea
        # (grid_scroll) et de son widget porté (groupes_container) ait fini
        # de se stabiliser -- Qt peut avoir besoin de PLUSIEURS itérations
        # (layout invalidé -> recalcul -> repaint -> layout à nouveau
        # invalidé par le repaint précédent) avant que la géométrie finale
        # de la GroupeSection soit posée, géométrie dont dépend
        # l'enregistrement de sa zone comme cible de drop valide. On force
        # d'abord explicitement l'activation des layouts concernés (au lieu
        # d'attendre qu'un futur passage de la boucle d'événements le fasse
        # naturellement), puis on purge la file sur plusieurs itérations
        # plutôt qu'une seule, pour couvrir ce cas à coup sûr sans dépendre
        # du timing de la machine de l'utilisateur.
        self.groupes_container.layout().activate()
        self.grid_scroll.updateGeometry()
        for _ in range(3):
            QApplication.processEvents()

    def _peupler_section(self, section: "GroupeSection", composants: list):
        for composant in composants:
            image_absolue = get_app_data_dir() / composant.image_path
            tuile = ComposantTuile(composant, image_absolue)
            tuile.clique.connect(self._on_tuile_cliquee)
            tuile.clique_avec_modifiers.connect(self._on_tuile_cliquee_avec_modifiers)
            tuile.set_selectionnee(composant.nom == self._composant_selectionne)
            tuile.set_selectionnee_multi(composant.nom in self._selection_multi)
            self._tuiles[composant.nom] = tuile
            section.flow_grid.add_item(tuile)

    # ------------------------------------------------------------------
    # Navigation rapide entre groupes (PATCH) — panneau latéral gauche
    # (self.groupes_nav_panel) listant les groupes du ServiceAPI actif ;
    # cf. GroupesNavPanel pour le widget lui-même, _charger_grille_composants
    # pour la (re)construction de sa liste.
    # ------------------------------------------------------------------
    def _scroller_vers_groupe(self, nom_groupe: str):
        """Fait défiler grid_scroll jusqu'à la GroupeSection nom_groupe,
        en animant la scrollbar verticale plutôt qu'un saut instantané
        (setValue direct) -- c'est le "slide" demandé. Ignore silencieusement
        si le groupe n'existe plus (ex: supprimé entre l'affichage du menu
        et le clic, cas limite improbable mais sans conséquence à ignorer)."""
        section = self._sections_groupe.get(nom_groupe)
        if section is None:
            return

        barre = self.grid_scroll.verticalScrollBar()
        # Position de la section dans les coordonnées du widget porté par
        # le QScrollArea (groupes_container) -- indépendante du défilement
        # actuel, contrairement à section.pos() qui est relative à son
        # parent direct déjà affecté par le layout mais pas par le scroll.
        cible_y = section.mapTo(self.groupes_container, QPoint(0, 0)).y()
        # Petite marge au-dessus pour ne pas coller le titre du groupe tout
        # en haut du viewport (plus confortable à lire juste après le scroll).
        marge = 8
        valeur_cible = max(barre.minimum(), min(barre.maximum(), cible_y - marge))

        # Une animation déjà en cours (clic répété sur le menu pendant un
        # scroll précédent) est arrêtée avant d'en relancer une nouvelle,
        # sinon les deux se disputent la valeur de la scrollbar.
        if self._scroll_animation is not None:
            self._scroll_animation.stop()

        animation = QPropertyAnimation(barre, b"value", self)
        animation.setDuration(350)
        animation.setStartValue(barre.value())
        animation.setEndValue(valeur_cible)
        animation.setEasingCurve(QEasingCurve.OutCubic)
        self._scroll_animation = animation
        animation.start()

    def _on_tuile_cliquee(self, composant_nom: str):
        composant = self.project.find_composant(composant_nom)
        if composant is None:
            return
        self._afficher_panneau_reglages(composant)

    # ------------------------------------------------------------------
    # Sélection multiple (PATCH, demande explicite utilisateur : "modifie
    # linterface des cmposant de tels sote que on puise selectionner
    # plusierr a la fois et suprimer dun coup") -- Ctrl+clic/Shift+clic
    # façon explorateur de fichiers, indépendant du clic simple ci-dessus
    # (_on_tuile_cliquee, panneau de réglages, INCHANGÉ). Les deux signaux
    # (clique et clique_avec_modifiers) sont émis ENSEMBLE à chaque clic
    # gauche sur une ComposantTuile (cf. ComposantTuile.mousePressEvent) :
    # ce second handler ignore volontairement les clics SANS Ctrl ni Shift
    # (déjà entièrement gérés par _on_tuile_cliquee), et se contente de
    # fermer une sélection multiple en cours le cas échéant pour éviter
    # toute ambiguïté visuelle entre "ouvert dans le panneau" (bordure
    # mauve) et "coché pour suppression" (bordure rouge).
    # ------------------------------------------------------------------
    def _ordre_tuiles_affichage(self) -> list:
        """Ordre visuel actuel des noms de composants, toutes GroupeSection
        confondues (Général en premier, puis les groupes dans le MÊME ordre
        que _charger_grille_composants) -- sert d'axe pour une plage
        Shift+clic (comportement explorateur de fichiers standard : la
        plage suit l'ordre d'AFFICHAGE, pas l'ordre de création)."""
        ordre = []
        for section in self._sections_groupe.values():
            for tuile in section.flow_grid._items:
                ordre.append(tuile.composant_nom)
        return ordre

    def _on_tuile_cliquee_avec_modifiers(self, composant_nom: str, modifiers):
        ctrl = bool(modifiers & Qt.ControlModifier)
        shift = bool(modifiers & Qt.ShiftModifier)
        if not ctrl and not shift:
            # Clic simple : déjà entièrement géré par _on_tuile_cliquee
            # (panneau de réglages). Une sélection multiple en cours est
            # abandonnée silencieusement -- un clic "normal" sur une tuile
            # signale clairement l'intention de quitter le mode sélection.
            if self._selection_multi:
                self._vider_selection_multi()
            return

        # Ctrl/Shift+clic ferme toujours le panneau de réglages s'il est
        # ouvert : les deux états (tuile ouverte dans le panneau / tuile
        # cochée pour suppression) ne doivent jamais se superposer
        # visuellement pour rester lisibles (cf. docstring de section).
        if self.reglages_panel.isVisible():
            self._fermer_panneau_reglages()

        if shift and self._ancre_selection_multi is not None:
            ordre = self._ordre_tuiles_affichage()
            if composant_nom in ordre and self._ancre_selection_multi in ordre:
                i_ancre = ordre.index(self._ancre_selection_multi)
                i_cible = ordre.index(composant_nom)
                debut, fin = sorted((i_ancre, i_cible))
                plage = set(ordre[debut:fin + 1])
                if ctrl:
                    # Ctrl+Shift+clic : ÉTEND la sélection existante avec la
                    # plage, sans repartir de zéro (cumul, comme la plupart
                    # des explorateurs de fichiers).
                    self._selection_multi |= plage
                else:
                    # Shift+clic seul : REMPLACE la sélection par la plage
                    # (ancre -> cible), comportement standard.
                    self._selection_multi = plage
                # L'ancre elle-même ne bouge pas sur un Shift+clic (contrairement
                # à Ctrl+clic ci-dessous) : Shift+clic répété étend/rétrécit
                # toujours depuis le MÊME point de départ.
                self._rafraichir_etat_selection_multi()
                return
            # composant_nom ou l'ancre n'est plus dans l'ordre affiché (cas
            # limite improbable, ex: composant supprimé entre-temps) --
            # retombe sur le comportement Ctrl+clic ci-dessous plutôt que
            # de ne rien faire.

        # Ctrl+clic (ou Shift+clic sans ancre encore posée) : bascule
        # (toggle) ce composant précis dans la sélection, et devient la
        # nouvelle ancre pour un éventuel Shift+clic suivant.
        if composant_nom in self._selection_multi:
            self._selection_multi.discard(composant_nom)
        else:
            self._selection_multi.add(composant_nom)
        self._ancre_selection_multi = composant_nom
        self._rafraichir_etat_selection_multi()

    def _vider_selection_multi(self):
        self._selection_multi = set()
        self._ancre_selection_multi = None
        self._rafraichir_etat_selection_multi()

    def _rafraichir_etat_selection_multi(self):
        """Point d'entrée UNIQUE pour resynchroniser l'affichage (bordures
        rouges des tuiles + visibilité du bouton flottant "Supprimer la
        sélection") avec self._selection_multi -- appelé après CHAQUE
        modification de cet ensemble, jamais modifié sans cet appel juste
        après (même pattern que _rafraichir_statut_local dans
        FenetreRenduTaskReseau pour le badge auto/manuel)."""
        for nom, tuile in self._tuiles.items():
            tuile.set_selectionnee_multi(nom in self._selection_multi)
        nb = len(self._selection_multi)
        self.floating_supprimer_selection_button.setVisible(nb > 0)
        if nb > 0:
            self.floating_supprimer_selection_button.setToolTip(
                f"Supprimer les {nb} composants sélectionnés" if nb > 1
                else "Supprimer le composant sélectionné"
            )

    def _supprimer_selection_multi(self):
        """PATCH (sélection multiple) -- suppression groupée, appelée par
        le bouton flottant ET par la touche Suppr (cf. keyPressEvent).
        Réutilise _confirm_delete_composant tel quel (déjà sans QMessageBox
        de confirmation depuis le patch corbeille -- cf. sa docstring) pour
        CHAQUE composant sélectionné : aucune confirmation supplémentaire
        ici non plus, cohérent avec le comportement à un seul composant."""
        if not self._selection_multi:
            return
        noms = list(self._selection_multi)
        # Reset AVANT la boucle de suppression : _confirm_delete_composant
        # ne connaît pas self._selection_multi et ne la nettoie pas lui-même
        # (il ne fait que retirer de self._tuiles) -- la vider d'abord évite
        # tout état incohérent si une exception survenait en cours de boucle.
        self._selection_multi = set()
        self._ancre_selection_multi = None
        for nom in noms:
            self._confirm_delete_composant(nom)
        self.floating_supprimer_selection_button.setVisible(False)
        if len(noms) > 1:
            self._notify_status(f"{len(noms)} composants supprimés.")

    def _afficher_panneau_reglages(self, composant: Composant):
        # Si un nom était en cours de frappe pour le composant précédemment
        # sélectionné, on le valide d'abord pour ne pas le perdre.
        if self.reglages_panel.isVisible():
            self.reglages_panel.valider_nom_en_attente()
        if self._composant_selectionne and self._composant_selectionne in self._tuiles:
            self._tuiles[self._composant_selectionne].set_selectionnee(False)
        self._composant_selectionne = composant.nom
        if composant.nom in self._tuiles:
            self._tuiles[composant.nom].set_selectionnee(True)

        image_absolue = get_app_data_dir() / composant.image_path
        self.reglages_panel.afficher_composant(composant, image_absolue)
        # REFONTE (panneau flottant, cf. docstring d'instanciation dans
        # __init__) : repositionner AVANT setVisible(True) -- le panneau
        # doit déjà être à la bonne géométrie (bord droit, pleine hauteur
        # de main_area) au moment où il apparaît, sinon un premier
        # affichage pourrait le montrer un instant à sa géométrie par
        # défaut (0,0). raise_() l'amène au premier plan par-dessus la
        # grille -- indispensable maintenant qu'il n'est plus positionné
        # par root_layout mais superposé en overlay sur main_area.
        self._repositionner_reglages_panel()
        self.reglages_panel.setVisible(True)
        self.reglages_panel.raise_()

    def _fermer_panneau_reglages(self):
        # Idem : valider un nom tapé mais pas encore confirmé avant de fermer.
        self.reglages_panel.valider_nom_en_attente()
        if self._composant_selectionne and self._composant_selectionne in self._tuiles:
            self._tuiles[self._composant_selectionne].set_selectionnee(False)
        self._composant_selectionne = None
        self.reglages_panel.setVisible(False)

    def _on_composant_renomme(self, ancien_nom_complet: str, nouveau_nom_complet: str):
        # Le renommage a déjà été appliqué au modèle par le panneau lui-même ;
        # ici on met juste à jour la clé de _tuiles, la référence dans
        # le ServiceAPI (déjà à jour côté modèle) et le nom affiché sur la vignette.
        tuile = self._tuiles.pop(ancien_nom_complet, None)
        if tuile is not None:
            tuile.composant_nom = nouveau_nom_complet
            composant = self.project.find_composant(nouveau_nom_complet)
            if composant is not None:
                image_absolue = get_app_data_dir() / composant.image_path
                tuile.rafraichir(composant, image_absolue)
            self._tuiles[nouveau_nom_complet] = tuile
        if self._composant_selectionne == ancien_nom_complet:
            self._composant_selectionne = nouveau_nom_complet
        self._notify_status(f"Composant renommé en « {nouveau_nom_complet} ».")

    # ------------------------------------------------------------------
    # Capture de composant (nouveau composant OU re-capture/Update OU
    # ajout de variante)
    # ------------------------------------------------------------------
    def _start_capture_composant(self):
        """Lance une capture destinée à créer un NOUVEAU composant."""
        if not self._service_api_actif:
            return  # bouton normalement masqué dans ce cas, garde-fou
        self._composant_en_recapture = None
        self._composant_en_ajout_variante = None
        self._lancer_capture_ecran()

    def _start_capture_composant_depuis_rendu_reseau(self):
        """PATCH -- bouton SÉPARÉ (floating_add_depuis_rendu_button) de
        _start_capture_composant ci-dessus, qui reste INCHANGÉ (capture
        bureau classique). Ici : même finalité (créer un NOUVEAU composant,
        pas de recapture/variante -- reprend donc le même garde-fou et la
        même remise à zéro de _composant_en_recapture/_composant_en_ajout_
        variante), mais l'image de base vient de self._get_image_rendu_
        reseau_actif() (callback injecté, cf. definir_source_rendu_reseau)
        au lieu de capture_bureau_complet().

        PATCH (mode sélection multiple, demande explicite utilisateur :
        "lorsque onclic sur ce bouton et bien sa creer directement les
        composant en questin avec les donne par defaut") -- deux chemins
        désormais :
        1. Si des zones ont déjà été découpées dans le panneau de rendu
           réseau (bouton ciseau, cf. FenetreRenduTaskReseau._demarrer_
           selection_zone) : self._prendre_captures_selectionnees_reseau()
           les renvoie TOUTES (et vide la liste d'origine, cf. sa
           docstring) -- UN composant est créé PAR image, immédiatement,
           SANS repasser par SelectionZoneOverlay (la découpe a déjà eu
           lieu). Chemin normal désormais pour ce bouton.
        2. Sinon (aucune sélection en attente, ex: ancien usage ou
           première utilisation) : comportement INCHANGÉ, ouvre
           SelectionZoneOverlay sur l'image actuellement affichée --
           conserve la possibilité de créer un composant d'un coup sans
           passer par le ciseau au préalable."""
        if not self._service_api_actif:
            return  # bouton normalement masqué dans ce cas, garde-fou

        captures_en_attente: list = []
        if self._prendre_captures_selectionnees_reseau is not None:
            try:
                captures_en_attente = self._prendre_captures_selectionnees_reseau() or []
            except Exception:
                captures_en_attente = []

        if captures_en_attente:
            self._composant_en_recapture = None
            self._composant_en_ajout_variante = None
            service_api_nom = self._service_api_actif
            noms_crees = []
            for image_decoupee in captures_en_attente:
                if image_decoupee is None or image_decoupee.isNull():
                    continue
                composant = self._creer_nouveau_composant_depuis_image(service_api_nom, image_decoupee)
                noms_crees.append(composant.nom)
            if noms_crees:
                if len(noms_crees) == 1:
                    self._afficher_panneau_reglages(self.project.find_composant(noms_crees[0]))
                    self.reglages_panel.nom_edit.setFocus()
                    self.reglages_panel.nom_edit.selectAll()
                self._notify_status(
                    f"{len(noms_crees)} composant(s) créé(s) depuis la sélection -- "
                    "modifiez leurs noms/réglages si besoin."
                )
            return

        if self._get_image_rendu_reseau_actif is None:
            return  # bouton normalement masqué dans ce cas, garde-fou
        try:
            image_rendu = self._get_image_rendu_reseau_actif()
        except Exception:
            image_rendu = None
        if image_rendu is None or image_rendu.isNull():
            # Le rendu a pu perdre son image entre l'affichage du bouton et
            # le clic (ex: instance déconnectée) -- on ne plante pas, on
            # informe simplement et on rafraîchit la visibilité du bouton
            # pour refléter l'état réel désormais.
            self._notify_status("Aucune image de rendu réseau disponible pour le moment.", error=True)
            self._rafraichir_visibilite_bouton_depuis_rendu()
            return
        self._composant_en_recapture = None
        self._composant_en_ajout_variante = None
        # Référence forte conservée le temps de l'édition, même raison que
        # _overlay_capture côté capture bureau (cf. _capturer_bureau_et_
        # afficher_overlay) : éviter le garbage-collect prématuré.
        self._overlay_capture = SelectionZoneOverlay(image_rendu)
        self._overlay_capture.zone_selectionnee.connect(
            lambda rect: self._on_zone_selectionnee(image_rendu, rect)
        )
        self._overlay_capture.annulee.connect(self._on_capture_annulee)
        self._overlay_capture.showFullScreen()
        self._overlay_capture.activateWindow()

    def _start_update_composant_image(self, composant_nom: str):
        """Bouton « Mettre à jour l'image » (AJOUT -- demande explicite
        utilisateur : proposer d'abord les captures déjà en attente dans
        le panneau de rendu réseau, plutôt que de lancer systématiquement
        une capture bureau) : pose l'état cible PUIS ouvre
        DialogueChoixCaptureOuNouvelle -- cf. _ouvrir_dialogue_choix_
        capture pour la suite commune avec _start_ajouter_variante."""
        self._composant_en_recapture = composant_nom
        self._composant_en_ajout_variante = None
        self._ouvrir_dialogue_choix_capture(f"Mettre à jour l'image de « {composant_nom} »")

    def _start_ajouter_variante(self, composant_nom: str):
        """Bouton « + Variante » de la galerie (AJOUT -- même logique que
        _start_update_composant_image ci-dessus, demande explicite
        utilisateur : "meme logic avec ajouter variance") : pose l'état
        cible PUIS ouvre DialogueChoixCaptureOuNouvelle."""
        if not composant_nom:
            return
        self._composant_en_recapture = None
        self._composant_en_ajout_variante = composant_nom
        self._ouvrir_dialogue_choix_capture(f"Ajouter une variante à « {composant_nom} »")

    def _ouvrir_dialogue_choix_capture(self, titre: str):
        """Commun à _start_update_composant_image et _start_ajouter_
        variante (AJOUT, demande explicite utilisateur) : self._composant_
        en_recapture/_composant_en_ajout_variante sont déjà posés par
        l'appelant à ce stade -- cette méthode ne fait qu'ouvrir la
        popup et câbler ses deux issues possibles :
          - une vignette choisie -> _sur_capture_choisie_pour_update
            applique DIRECTEMENT l'image, sans repasser par
            SelectionZoneOverlay (la découpe a déjà eu lieu dans
            FenetreRenduTaskReseau._sur_zone_selection_validee) ;
          - « Nouveau » cliqué -> _lancer_capture_ecran, comportement
            EXACTEMENT inchangé par rapport à avant ce patch.
        Si aucun callback de consultation n'a été injecté (cf. definir_
        source_rendu_reseau, panneau de rendu réseau jamais utilisé dans
        cette session), ou s'il ne renvoie rien, la popup s'ouvre quand
        même mais ne liste aucune capture -- le bouton « Nouveau » reste
        le seul chemin, jamais de blocage."""
        captures_en_attente: list = []
        if self._consulter_captures_selectionnees_reseau is not None:
            try:
                captures_en_attente = self._consulter_captures_selectionnees_reseau() or []
            except Exception:
                captures_en_attente = []
        self._dialogue_choix_capture = DialogueChoixCaptureOuNouvelle(captures_en_attente, titre, self)
        self._dialogue_choix_capture.setAttribute(Qt.WA_DeleteOnClose)
        self._dialogue_choix_capture.capture_choisie.connect(self._sur_capture_choisie_pour_update)
        self._dialogue_choix_capture.nouvelle_demandee.connect(self._lancer_capture_ecran)
        self._dialogue_choix_capture.destroyed.connect(self._sur_dialogue_choix_capture_detruite)
        self._dialogue_choix_capture.show()
        self._dialogue_choix_capture.activateWindow()

    def _sur_dialogue_choix_capture_detruite(self):
        self._dialogue_choix_capture = None

    def _sur_capture_choisie_pour_update(self, image: QImage, index_origine: int):
        """Une vignette de DialogueChoixCaptureOuNouvelle a été choisie :
        applique directement l'image comme mise à jour/variante selon
        l'état posé par _start_update_composant_image/_start_ajouter_
        variante (même branchement que _on_zone_selectionnee, réutilisé
        tel quel pour ne pas dupliquer la logique projet/rafraîchissement
        UI), puis retire cette unique capture de la liste d'origine côté
        FenetreRenduTaskReseau pour qu'elle ne soit pas réutilisable deux
        fois (cf. self._retirer_capture_selectionnee_reseau)."""
        if image is None or image.isNull():
            return
        self._on_zone_selectionnee(image, QRect(0, 0, image.width(), image.height()))
        if self._retirer_capture_selectionnee_reseau is not None:
            try:
                self._retirer_capture_selectionnee_reseau(index_origine)
            except Exception:
                pass

    def _supprimer_variante(self, composant_nom: str, variant_path: str):
        """Retire une variante précise d'un composant (bouton "x" sur une
        vignette de la galerie). Refuse silencieusement si c'était la
        dernière variante — le modèle lève une ValueError dans ce cas,
        affichée dans la barre de statut plutôt que de planter."""
        try:
            self.project.remove_variante_composant(composant_nom, variant_path)
        except ValueError as e:
            self._notify_status(str(e), error=True)
            return
        self.project.save()

        composant = self.project.find_composant(composant_nom)
        if composant is None:
            return
        # La vignette de grille affiche la variante principale (variantes[0]) :
        # si celle-ci n'a pas changé (on a retiré une AUTRE variante), pas
        # besoin de la recharger — mais on le fait quand même par simplicité
        # et cohérence, le coût est négligeable.
        image_absolue = get_app_data_dir() / composant.image_path
        if composant_nom in self._tuiles:
            self._tuiles[composant_nom].rafraichir(composant, image_absolue)
        if self._composant_selectionne == composant_nom:
            self.reglages_panel.rafraichir_apercu(image_absolue)
        self._notify_status(f"Variante retirée du composant « {composant_nom} ».")

    # ------------------------------------------------------------------
    # Zone de clic personnalisée : fenêtre zoom séparée sur l'image du composant
    # ------------------------------------------------------------------
    def _start_definir_zone_clic(self, composant_nom: str):
        composant = self.project.find_composant(composant_nom)
        if composant is None:
            return
        image_absolue = get_app_data_dir() / composant.image_path
        if not image_absolue.exists():
            self._notify_status("Image du composant introuvable sur disque.", error=True)
            return

        image = QImage(str(image_absolue))
        if image.isNull():
            self._notify_status("Impossible de charger l'image du composant.", error=True)
            return

        zone_initiale = None
        if not composant.zone_clic_rect.est_vide():
            r = composant.zone_clic_rect
            zone_initiale = QRect(r.x, r.y, r.largeur, r.hauteur)

        # Référence forte conservée le temps de l'édition (même raison que
        # pour _overlay_capture : éviter le garbage-collect prématuré).
        self._zone_clic_selector = ZoneClicSelector(image, zone_initiale)
        self._zone_clic_selector.zone_selectionnee.connect(
            lambda rect: self._on_zone_clic_definie(composant_nom, rect)
        )
        self._zone_clic_selector.annulee.connect(self._on_zone_clic_annulee)
        self._zone_clic_selector.show()
        self._zone_clic_selector.activateWindow()

    def _on_zone_clic_annulee(self):
        self._zone_clic_selector = None
        self._notify_status("Définition de la zone de clic annulée.")

    def _on_zone_clic_definie(self, composant_nom: str, rect: QRect):
        self._zone_clic_selector = None
        composant = self.project.find_composant(composant_nom)
        if composant is None:
            return
        composant.zone_clic_rect = ZoneClicRect(
            x=rect.x(), y=rect.y(), largeur=rect.width(), hauteur=rect.height()
        )
        self.project.save()
        # Le panneau garde une référence à ce même objet composant : on
        # redessine directement le contour jaune sans tout recharger.
        if self.reglages_panel._composant_nom == composant_nom:
            self.reglages_panel._rafraichir_apercu_avec_zone()
        self._notify_status(f"Zone de clic définie pour « {composant_nom} ».")

    # ------------------------------------------------------------------
    # Test manuel d'un composant (onglet dédié — voir TestComposantScreen)
    # ------------------------------------------------------------------
    def _start_tester_composant(self, composant_nom: str):
        # Ne fait plus qu'un relais : l'onglet Test (5ème section sidebar)
        # gère lui-même le chargement du composant et l'affichage d'un
        # message d'erreur si l'image est introuvable.
        self.demande_ouvrir_test_composant.emit(composant_nom)

    def _lancer_capture_ecran(self):
        # La fenêtre AutoniaX doit disparaître pour ne pas polluer la
        # capture ni gêner la sélection de la zone voulue en dessous.
        main_window = self.window()
        main_window.hide()
        QApplication.processEvents()
        # Laisse le temps au gestionnaire de fenêtres/compositeur de
        # retirer réellement AutoniaX de l'écran avant la capture — un
        # simple hide() suivi d'une capture immédiate peut, sur certains
        # systèmes, capturer une frame où la fenêtre est encore visible.
        QTimer.singleShot(150, self._capturer_bureau_et_afficher_overlay)

    def _capturer_bureau_et_afficher_overlay(self):
        image_bureau = capture_bureau_complet()
        main_window = self.window()

        if image_bureau is None or image_bureau.isNull():
            main_window.show()
            self._notify_status("Échec de la capture d'écran.", error=True)
            return

        # L'overlay est conservé comme attribut d'instance pour ne pas être
        # détruit prématurément par le garbage collector Python (aucune
        # référence forte sinon une fois sorti de cette méthode).
        self._overlay_capture = SelectionZoneOverlay(image_bureau)
        self._overlay_capture.zone_selectionnee.connect(
            lambda rect: self._on_zone_selectionnee(image_bureau, rect)
        )
        self._overlay_capture.annulee.connect(self._on_capture_annulee)
        self._overlay_capture.showFullScreen()
        self._overlay_capture.activateWindow()

    def _on_capture_annulee(self):
        self._overlay_capture = None
        self._composant_en_recapture = None
        self._composant_en_ajout_variante = None
        self.window().show()
        self._notify_status("Capture annulée.")

    def _on_zone_selectionnee(self, image_source: QImage, rect: QRect):
        self._overlay_capture = None
        image_decoupee = image_source.copy(rect)

        # La fenêtre AutoniaX réapparaît immédiatement : la capture elle-même
        # est terminée, et il n'y a plus de dialog séparé à afficher — le
        # composant (nouveau ou mis à jour) apparaît directement dans la grille
        # / le panneau intégré (point 18 : jamais de dialogue qui casse le flux).
        self.window().show()

        service_api_nom = self._service_api_actif

        if self._composant_en_recapture:
            # --- Cas Update : remplace l'image d'un composant EXISTANT ---
            composant_nom = self._composant_en_recapture
            self._composant_en_recapture = None
            try:
                self.project.update_composant_image(composant_nom, image_decoupee)
            except ValueError as e:
                self._notify_status(str(e), error=True)
                return
            self.project.save()

            composant = self.project.find_composant(composant_nom)
            image_absolue = get_app_data_dir() / composant.image_path
            if composant_nom in self._tuiles:
                self._tuiles[composant_nom].rafraichir(composant, image_absolue)
            if self._composant_selectionne == composant_nom:
                self.reglages_panel.rafraichir_apercu(image_absolue)
            self._notify_status(f"Image du composant « {composant_nom} » mise à jour.")
            return

        if self._composant_en_ajout_variante:
            # --- Cas Ajout de variante : enrichit un composant EXISTANT
            # d'une image supplémentaire, sans toucher aux autres variantes ---
            composant_nom = self._composant_en_ajout_variante
            self._composant_en_ajout_variante = None
            try:
                self.project.add_variante_composant(composant_nom, image_decoupee)
            except ValueError as e:
                self._notify_status(str(e), error=True)
                return
            self.project.save()

            composant = self.project.find_composant(composant_nom)
            if self._composant_selectionne == composant_nom:
                # Rafraîchit la galerie de variantes (nouvelle vignette) sans
                # changer l'aperçu principal, qui reste la variante 0.
                self.reglages_panel._rafraichir_galerie_variantes()
            self._notify_status(f"Variante ajoutée au composant « {composant_nom} ».")
            return

        # --- Cas nouveau composant : créé IMMÉDIATEMENT avec un nom par
        # défaut modifiable (ex: "NouveauComposant"), pas de nommage préalable. ---
        composant = self._creer_nouveau_composant_depuis_image(service_api_nom, image_decoupee)
        self._afficher_panneau_reglages(composant)
        self.reglages_panel.nom_edit.setFocus()
        self.reglages_panel.nom_edit.selectAll()
        self._notify_status(f"Composant « {composant.nom} » créé — modifiez son nom si besoin.")

    def _creer_nouveau_composant_depuis_image(self, service_api_nom: str, image_decoupee: QImage) -> "Composant":
        """Factorisé (PATCH -- mode sélection multiple du rendu réseau) à
        partir du "cas nouveau composant" de _on_zone_selectionnee
        ci-dessus, pour être réutilisé TEL QUEL par _start_capture_
        composant_depuis_rendu_reseau lors d'un import en masse (une
        image de _captures_selectionnees -> un appel ici, cf. sa
        docstring) -- même comportement EXACT dans les deux cas : nom
        par défaut auto-généré (ex: "NouveauComposant"), groupe "Général"
        (composant.groupe == ""), aucune valeur pré-remplie au-delà de
        ça, modifiable ensuite par l'utilisateur (décision explicite :
        "sa creer directement les composant en questin avec les donne
        par defaut, le user lui mmeeme vas modifeir plutard").

        Ne gère PAS l'affichage du panneau de réglages ni la notification
        de statut : ce sont les DEUX appelants qui diffèrent sur ce point
        (un seul composant sélectionné et focus sur son nom pour l'un,
        plusieurs composants créés d'un coup pour l'autre -- cf. leurs
        corps respectifs)."""
        composant = self.project.add_composant_avec_nom_auto(service_api_nom, image_decoupee)
        self.project.save()

        image_absolue = get_app_data_dir() / composant.image_path
        tuile = ComposantTuile(composant, image_absolue)
        tuile.clique.connect(self._on_tuile_cliquee)
        tuile.clique_avec_modifiers.connect(self._on_tuile_cliquee_avec_modifiers)
        self._tuiles[composant.nom] = tuile
        # Un nouveau composant n'a jamais de groupe assigné à la création
        # (composant.groupe == "") -- il va toujours dans "Général" (cf.
        # décision explicite utilisateur). La section "" est TOUJOURS
        # présente dès qu'un ServiceAPI est actif (cf. _charger_grille_composants).
        section_generale = self._sections_groupe.get("")
        if section_generale is not None:
            section_generale.flow_grid.add_item(tuile)
        else:
            # Filet de sécurité (bug corrigé : ne devrait plus arriver depuis
            # que _charger_grille_composants crée toujours la section
            # Général, mais on ne veut plus JAMAIS silencieusement perdre
            # une vignette d'un layout visible si ce cas se reproduit pour
            # une autre raison -- on recharge toute la grille, ce qui
            # retrouve bien le composant puisqu'il est déjà dans le modèle.
            self._charger_grille_composants(service_api_nom)
        self.placeholder_widget.setVisible(False)
        self.grid_scroll.setVisible(True)
        # AJOUT (section 3, compteur cL/cS) : ajout unitaire hors rebuild
        # complet -- couvre aussi le chemin "filet de sécurité" ci-dessus
        # qui appelle _charger_grille_composants directement (pas via
        # set_service_api_actif, donc pas déjà couvert par son propre emit).
        self.nb_composants_change.emit(self.nb_composants)
        return composant

    # ------------------------------------------------------------------
    # Suppression d'un composant (depuis le panneau de réglages)
    # ------------------------------------------------------------------
    def _confirm_delete_composant(self, composant_nom: str):
        """PATCH (demande utilisateur explicite : corbeille -- "enleve
        tout les messsage de confrimtion de supresion sauf pour la
        corbeille") : plus de QMessageBox ici, la suppression est
        immédiate -- remove_composant déplace désormais le composant (et
        son image) vers la corbeille au lieu de les supprimer pour de
        bon, donc rien à confirmer avant ce point-là ; seule la
        suppression DÉFINITIVE depuis la corbeille reste confirmée (cf.
        CorbeilleScreen._confirmer_suppression_definitive)."""
        self.project.remove_composant(composant_nom)
        self.project.save()

        tuile = self._tuiles.pop(composant_nom, None)
        if tuile is not None:
            # PATCH (groupes de composants) : la vignette vit dans la
            # FlowGrid de SA GroupeSection, pas une flow_grid unique -- on
            # cherche la section qui la contient réellement plutôt que de
            # supposer laquelle (rester correct même si le composant
            # supprimé était dans un groupe personnalisé).
            for section in self._sections_groupe.values():
                if tuile in section.flow_grid._items:
                    # CORRECTIF (flow_grid est désormais un MasonryGrid,
                    # cf. sa docstring) : plus de section.flow_grid._grid
                    # (QGridLayout) à nettoyer -- MasonryGrid positionne
                    # ses items en coordonnées absolues (setGeometry), pas
                    # via un QLayout Qt. Retirer l'item de _items suffit
                    # avant de relayouter.
                    section.flow_grid._items.remove(tuile)
                    section.flow_grid._relayout()
                    break
            tuile.setParent(None)
            tuile.deleteLater()

        if self._composant_selectionne == composant_nom:
            self._fermer_panneau_reglages()

        # PATCH (groupes de composants) : le placeholder ne doit s'afficher
        # que si le ServiceAPI n'a plus NI composant NI groupe créé -- un
        # groupe vide (même sans composant restant) doit rester visible.
        service_api = self.project.find_service_api(self._service_api_actif) if self._service_api_actif else None
        if not self._tuiles and service_api is not None and not service_api.groupes:
            self.placeholder_widget.setVisible(True)
            self.grid_scroll.setVisible(False)
            self.main_area_label.setText(
                f"ServiceAPI « {self._service_api_actif} » — aucun composant. "
                "Cliquez sur « + » pour en capturer un."
            )

        self._notify_status(f"Composant « {composant_nom} » supprimé.")
        # AJOUT (section 3, compteur cL/cS) : suppression unitaire hors
        # rebuild complet -- même raisonnement que l'ajout unitaire.
        self.nb_composants_change.emit(self.nb_composants)

    # ------------------------------------------------------------------
    # Groupes de composants (PATCH : création, drag & drop, renommage,
    # suppression) — cf. GroupeSection pour le widget, ServiceAPI.groupes
    # pour la persistance de la liste de noms.
    # ------------------------------------------------------------------
    def _creer_nouveau_groupe(self):
        if not self._service_api_actif:
            return  # bouton normalement masqué dans ce cas, garde-fou
        service_api = self.project.find_service_api(self._service_api_actif)
        if service_api is None:
            return

        nom_groupe, ok = BoiteDialogueAutoniaX.saisie_texte(
            self, "Nouveau groupe", "Nom du groupe :", QLineEdit.EchoMode.Normal, "",
        )
        if not ok:
            return
        nom_groupe = nom_groupe.strip()
        if not nom_groupe:
            return
        if nom_groupe == "" or nom_groupe.lower() == "général" or nom_groupe.lower() == "general":
            self._notify_status("« Général » est réservé et ne peut pas être utilisé comme nom de groupe.", error=True)
            return
        if nom_groupe in service_api.groupes:
            self._notify_status(f"Le groupe « {nom_groupe} » existe déjà.", error=True)
            return

        service_api.groupes.append(nom_groupe)
        self.project.save()
        self._charger_grille_composants(self._service_api_actif)
        self._notify_status(f"Groupe « {nom_groupe} » créé.")

    def _on_deplacement_composant(self, composant_nom: str, nom_groupe_cible: str):
        """Appelé au drop d'une ComposantTuile sur une GroupeSection (cf.
        GroupeSection.demande_deplacement_composant) : met à jour
        composant.groupe et déplace visuellement la vignette vers la
        FlowGrid de la section cible, sans reconstruire toute la grille
        (évite un scintillement/reset du scroll pour un simple déplacement)."""
        composant = self.project.find_composant(composant_nom)
        if composant is None:
            return
        if composant.groupe == nom_groupe_cible:
            return  # déjà dans ce groupe (ex: redrop sur la même section) -- rien à faire

        composant.groupe = nom_groupe_cible
        self.project.save()

        tuile = self._tuiles.get(composant_nom)
        section_cible = self._sections_groupe.get(nom_groupe_cible)
        if tuile is None or section_cible is None:
            # Cas de repli défensif (ne devrait pas arriver en pratique) :
            # on recharge toute la grille plutôt que de laisser un état
            # visuel incohérent avec le modèle déjà sauvegardé.
            if self._service_api_actif:
                self._charger_grille_composants(self._service_api_actif)
            return

        for section in self._sections_groupe.values():
            if tuile in section.flow_grid._items:
                # CORRECTIF (flow_grid est désormais un MasonryGrid, cf.
                # sa docstring et le correctif identique juste au-dessus
                # dans _confirm_delete_composant) : plus de _grid
                # (QGridLayout) à nettoyer.
                section.flow_grid._items.remove(tuile)
                section.flow_grid._relayout()
                break

        tuile.setParent(section_cible.flow_grid)
        section_cible.flow_grid.add_item(tuile)

        nom_affiche = "Général" if nom_groupe_cible == "" else nom_groupe_cible
        self._notify_status(f"Composant « {composant_nom} » déplacé vers « {nom_affiche} ».")

    def _on_renommer_groupe(self, nom_groupe_actuel: str):
        if not self._service_api_actif:
            return
        service_api = self.project.find_service_api(self._service_api_actif)
        if service_api is None or nom_groupe_actuel not in service_api.groupes:
            return

        nouveau_nom, ok = BoiteDialogueAutoniaX.saisie_texte(
            self, "Renommer le groupe", "Nouveau nom :", QLineEdit.EchoMode.Normal, nom_groupe_actuel,
        )
        if not ok:
            return
        nouveau_nom = nouveau_nom.strip()
        if not nouveau_nom or nouveau_nom == nom_groupe_actuel:
            return
        if nouveau_nom.lower() in ("", "général", "general"):
            self._notify_status("« Général » est réservé et ne peut pas être utilisé comme nom de groupe.", error=True)
            return
        if nouveau_nom in service_api.groupes:
            self._notify_status(f"Le groupe « {nouveau_nom} » existe déjà.", error=True)
            return

        index = service_api.groupes.index(nom_groupe_actuel)
        service_api.groupes[index] = nouveau_nom
        # Répercute le renommage sur tous les composants qui référençaient
        # l'ancien nom -- sinon ils se retrouveraient orphelins (groupe
        # inexistant dans service_api.groupes, mais toujours affiché nulle
        # part vu que _charger_grille_composants ne connaît que les noms
        # de service_api.groupes).
        for comp_nom in service_api.composants:
            composant = self.project.find_composant(comp_nom)
            if composant is not None and composant.groupe == nom_groupe_actuel:
                composant.groupe = nouveau_nom

        self.project.save()
        self._charger_grille_composants(self._service_api_actif)
        self._notify_status(f"Groupe « {nom_groupe_actuel} » renommé en « {nouveau_nom} ».")

    def _on_supprimer_groupe(self, nom_groupe: str):
        if not self._service_api_actif:
            return
        service_api = self.project.find_service_api(self._service_api_actif)
        if service_api is None or nom_groupe not in service_api.groupes:
            return

        box = BoiteDialogueAutoniaX.question(
            self,
            "Supprimer le groupe",
            f"Supprimer le groupe « {nom_groupe} » ?",
            texte_oui="Oui",
            texte_non="Annuler",
            texte_informatif="Les composants de ce groupe seront renvoyés vers « Général ».",
        )
        if not box:
            return

        # Composants renvoyés vers Général (groupe = "") avant de retirer
        # le groupe de la liste -- décision explicite utilisateur (jamais
        # de suppression en cascade des composants eux-mêmes).
        for comp_nom in service_api.composants:
            composant = self.project.find_composant(comp_nom)
            if composant is not None and composant.groupe == nom_groupe:
                composant.groupe = ""

        service_api.groupes.remove(nom_groupe)
        self.project.save()
        if self._composant_selectionne:
            composant_selectionne = self.project.find_composant(self._composant_selectionne)
            if composant_selectionne is None:
                self._composant_selectionne = None
        self._charger_grille_composants(self._service_api_actif)
        self._notify_status(f"Groupe « {nom_groupe} » supprimé — composants renvoyés vers « Général ».")

    # ------------------------------------------------------------------
    def _notify_status(self, message: str, error: bool = False):
        window = self.window()
        if hasattr(window, "statusBar"):
            window.statusBar().showMessage(message, 4000)


# ---------------------------------------------------------------------------
# ComposantsLayoutScreen / PanneauProprietesLayoutFlottant -- SPEC
# SPEC_composantLayout.md section 7. Classes ENTIÈREMENT NOUVELLES : la
# spec demande une structure "similaire" à ComposantsScreen ci-dessus
# (grille de tuiles) mais explicitement plus simple -- pas de groupes, pas
# de drag & drop VERS des groupes internes, pas de sélection multiple :
# aucun de ces mécanismes n'est demandé par la spec pour cL, donc aucun
# n'est repris ici (cohérent avec la philosophie de tout ce fichier :
# n'implémenter que ce qui est demandé). Seuls sont repris : FlowGrid
# (générique, cf. sa docstring) et le mécanisme de QDrag EXTERNE de
# ComposantTuile.mouseMoveEvent (demandé explicitement, section 7.1).
# ---------------------------------------------------------------------------
class ComposantLayoutTuile(QFrame):
    """Vignette d'un ComposantLayout dans la grille de ComposantsLayoutScreen
    -- SPEC section 7.1.

    REFONTE (demande explicite utilisateur, avec capture_001.png à
    l'appui : "le card d'affichage d'un composantLayout ... actuellement
    il ressemble exactement à un composant single simple ... rend-le plus
    stylé ... augmente/triple la taille d'affichage") -- deux changements
    distincts :

    1) IDENTITÉ VISUELLE PROPRE (plus de ressemblance avec ComposantTuile,
       le cS) : au lieu du même patron "image centrée + label sous
       l'image" que ComposantTuile, cette tuile a désormais SA propre
       feuille de style (#ComposantLayoutTuile*, cf. bloc QSS dédié) --
       bordure sapphire/sky (froide, DIFFÉRENTE du mauve de ComposantTuile
       ET du dégradé mauve/bleu du ServiceAPI, cf. l'échange précédent sur
       ZoneCarte qui a explicitement rejeté ce dégradé), un bandeau de
       PIED DE CARTE séparé de l'image par une ligne fine (au lieu d'un
       simple label flottant sous l'image comme ComposantTuile) portant
       l'icône view-grid-outline déjà utilisée ailleurs pour cL (cf.
       ComposantsLayoutScreen.placeholder_icon et le badge d'onglet
       Applications, même icône réutilisée ici pour cohérence) + le nom,
       et un petit BADGE DE COIN "cL" en haut à droite de l'image pour
       identifier le type de carte au premier coup d'oeil.

    2) TAILLE (demande explicite : "triple la taille") : LARGEUR_IMAGE
       420 (= 140 x 3, cf. ComposantTuile.image_frame historique) au lieu
       de 140. La hauteur reste dérivée du RATIO réel de image_reference
       (**[DÉCISION ASSUMÉE]** déjà en place avant cette refonte, cf.
       ancienne docstring : "grille adaptative à la forme du cL")-- mais
       la demande explicite qui suit immédiatement ("les composants
       n'auront pas forcément la même forme ... pas forcément de ligne ou
       de colonne, relatif à la taille de chaque composant") impose de
       remplacer la grille rigide FlowGrid par MasonryGrid (cf. sa
       docstring) : plus de plancher/plafond de hauteur artificiels ici
       (HAUTEUR_MIN/MAX supprimés) puisque MasonryGrid absorbe nativement
       des hauteurs très différentes d'un item à l'autre sans "tirer" les
       voisines -- une tuile extrêmement large/étroite ou haute/étroite
       garde donc désormais son ratio RÉEL sans être écrasée dans une
       fourchette arbitraire.

    hauteur_pour_largeur(largeur) : nouvelle méthode, contrat attendu par
    MasonryGrid._relayout (cf. sa docstring) pour connaître la hauteur
    totale de la tuile (image + pied de carte + marges) AVANT de la
    positionner, sans dépendre de sizeHint() (peu fiable tant que le
    widget n'a pas encore été redimensionné une première fois par Qt).

    PAS de clique_avec_modifiers ni de sélection multiple (cf. docstring
    de section) : SPEC 7.1 dit explicitement que le clic simple ouvre le
    panneau flottant, rien de plus n'est demandé ici."""

    MIME_TYPE = "application/x-autoniax-composant-layout"
    LARGEUR_IMAGE = 420  # 140 x 3 (demande explicite : "triple la taille")
    PIED_DE_CARTE_HAUTEUR = 44
    MARGES = 14  # marge du QFrame (haut+bas séparés, cf. layout.setContentsMargins)

    clique = Signal(str)  # émet le nom complet du ComposantLayout

    def __init__(self, composant_layout: "ComposantLayout", image_absolue: Path, parent=None):
        super().__init__(parent)
        self.composant_layout_nom = composant_layout.nom
        self._image_absolue = image_absolue
        self._nom_affiche = self._nom_court(composant_layout.nom, composant_layout.service_api_nom)
        self._ratio_image = 100 / 140  # défaut si pas d'image -- recalculé par _charger_image
        self.setObjectName("ComposantLayoutTuile")
        self.setProperty("selectionnee", "false")
        self.setCursor(Qt.PointingHandCursor)

        layout = QVBoxLayout(self)
        layout.setContentsMargins(self.MARGES, self.MARGES, self.MARGES, self.MARGES)
        layout.setSpacing(0)

        # --- Zone image + badge de coin "cL" (superposés via un QStackedLayout
        # maison -- ici plus simplement un QFrame avec le badge en enfant
        # positionné manuellement dans resizeEvent, cf. plus bas) ---
        self.image_frame = QFrame(self)
        self.image_frame.setObjectName("ComposantLayoutTuileImageFrame")
        image_layout = QVBoxLayout(self.image_frame)
        image_layout.setContentsMargins(0, 0, 0, 0)

        self.image_label = QLabel(self.image_frame)
        self.image_label.setAlignment(Qt.AlignCenter)
        image_layout.addWidget(self.image_label)
        layout.addWidget(self.image_frame)

        # AJOUT (identité visuelle propre) : badge de coin "cL", enfant
        # DIRECT de image_frame (positionnement absolu dans _repositionner_
        # badge, appelé après chaque resize de l'image) plutôt que dans le
        # layout -- un badge flottant en surimpression ne peut pas passer
        # par un QVBoxLayout classique sans complexifier toute la
        # structure pour un simple coin coloré.
        self.badge_type = QLabel("cL", self.image_frame)
        self.badge_type.setObjectName("ComposantLayoutTuileBadge")
        self.badge_type.setAlignment(Qt.AlignCenter)
        self.badge_type.adjustSize()

        # --- Pied de carte : ligne séparatrice + icône + nom (REFONTE :
        # remplace le simple nom_label flottant de l'ancienne version) ---
        pied = QFrame(self)
        pied.setObjectName("ComposantLayoutTuilePied")
        pied_layout = QHBoxLayout(pied)
        pied_layout.setContentsMargins(2, 10, 2, 0)
        pied_layout.setSpacing(8)

        self.icone_type_label = QLabel(pied)
        self.icone_type_label.setPixmap(qta.icon("mdi6.view-grid-outline", color=Mocha.sapphire).pixmap(18, 18))
        pied_layout.addWidget(self.icone_type_label)

        self.nom_label = QLabel(self._nom_affiche, pied)
        self.nom_label.setObjectName("ComposantLayoutTuileNom")
        self.nom_label.setWordWrap(True)
        pied_layout.addWidget(self.nom_label, 1)

        # AJOUT (SPEC_lot_corrections_2026-09.md section 1) : badge de
        # validation manuelle, APRÈS le nom (demande explicite) -- vert
        # si filtre_scindement_valide est True, gris sinon. Purement
        # décoratif ici (aucune interaction), le toggle qui pilote cet
        # état vit dans ComposantLayoutConfigScreen.
        #
        # CORRECTIF (retour utilisateur : "le badge de validation... il
        # nes pas assez grand, il est trop petit") -- remplace l'ancien
        # simple caractère "●" (16px, à peine visible dans le pied de
        # carte) par un vrai texte court ("Validé"/"À valider") sur fond
        # plein (cf. #ComposantLayoutTuileBadgeValide dans la feuille de
        # style globale, même patron que #ComposantLayoutTuileBadge
        # "cL") -- la couleur passe désormais par la propriété Qt
        # dynamique "valide" (lue par le sélecteur QSS [valide="true"/
        # "false"]) plutôt qu'un setStyleSheet ad hoc posé ici : cf.
        # _appliquer_couleur_badge_valide ci-dessous pour le mécanisme
        # setProperty + unpolish/polish (identique à set_selectionnee
        # plus bas dans cette même classe).
        self.badge_valide = QLabel(pied)
        self.badge_valide.setObjectName("ComposantLayoutTuileBadgeValide")
        self.badge_valide.setAlignment(Qt.AlignCenter)
        self.badge_valide.setToolTip("Validé manuellement" if composant_layout.filtre_scindement_valide else "Non validé")
        self._appliquer_couleur_badge_valide(composant_layout.filtre_scindement_valide)
        pied_layout.addWidget(self.badge_valide)

        layout.addWidget(pied)

        self._charger_image(image_absolue)

    def _appliquer_couleur_badge_valide(self, valide: bool):
        """CORRECTIF (cf. docstring de la construction du badge
        ci-dessus) -- texte + propriété Qt dynamique "valide", plutôt
        qu'un setStyleSheet direct : setProperty puis unpolish/polish
        (même mécanisme EXACT que set_selectionnee plus bas dans cette
        classe) force Qt à réévaluer les sélecteurs QSS [valide="..."]
        de #ComposantLayoutTuileBadgeValide -- la couleur vient donc de
        la feuille de style globale, jamais recalculée ici à la main."""
        self.badge_valide.setText("Validé" if valide else "À valider")
        self.badge_valide.setProperty("valide", "true" if valide else "false")
        self.badge_valide.style().unpolish(self.badge_valide)
        self.badge_valide.style().polish(self.badge_valide)

    @staticmethod
    def _nom_court(nom_complet: str, service_api_nom: str) -> str:
        prefixe = f"{service_api_nom}-"
        return nom_complet[len(prefixe):] if nom_complet.startswith(prefixe) else nom_complet

    def hauteur_pour_largeur(self, largeur: int) -> int:
        """Contrat MasonryGrid (cf. sa docstring) : hauteur totale de la
        tuile (image mise à l'échelle de `largeur` + pied de carte fixe +
        marges) pour que le packing masonry puisse positionner cette
        tuile SANS avoir eu besoin de la redimensionner au préalable.

        CORRECTIF : la largeur RÉELLEMENT accordée par MasonryGrid
        (colonne_largeur, cf. ComposantsLayoutScreen -- construite ÉGALE
        à LARGEUR_IMAGE + 2*MARGES, cf. plus bas) peut en théorie différer
        de LARGEUR_IMAGE si jamais l'un des deux change sans l'autre :
        cette méthode recalcule donc TOUJOURS le ratio par rapport à la
        largeur réellement passée par l'appelant, jamais par rapport à
        la constante LARGEUR_IMAGE codée en dur -- même image_frame.
        setFixedSize ci-dessous, cf. resizeEvent."""
        largeur_image = max(1, largeur - 2 * self.MARGES)
        hauteur_image = max(1, round(largeur_image * self._ratio_image))
        return hauteur_image + self.PIED_DE_CARTE_HAUTEUR + 2 * self.MARGES

    def _repositionner_badge(self):
        # Coin haut-droit de l'image, léger retrait (6px) -- cf. usage
        # dans resizeEvent et _charger_image (la taille de l'image change
        # à chaque nouveau chargement, donc le coin doit être recalculé).
        self.badge_type.move(self.image_frame.width() - self.badge_type.width() - 6, 6)

    def _appliquer_taille_image(self):
        # CORRECTIF (masonry responsive) -- appelée depuis resizeEvent
        # (largeur imposée par MasonryGrid.setGeometry, cf. sa docstring)
        # ET depuis _charger_image (nouveau ratio après chargement d'une
        # nouvelle image) : dans les deux cas, l'image doit occuper toute
        # la largeur RÉELLE actuelle de la tuile, pas une constante fixe
        # -- sinon une tuile positionnée par MasonryGrid à une largeur de
        # colonne différente de LARGEUR_IMAGE afficherait une image mal
        # centrée/débordante.
        largeur_image = max(1, self.width() - 2 * self.MARGES)
        hauteur_image = max(1, round(largeur_image * self._ratio_image))
        self.image_frame.setFixedSize(largeur_image, hauteur_image)
        if not self._pixmap_brute.isNull():
            pixmap = self._pixmap_brute.scaled(
                largeur_image, hauteur_image, Qt.KeepAspectRatio, Qt.SmoothTransformation
            )
            self.image_label.setPixmap(pixmap)
        self._repositionner_badge()

    def resizeEvent(self, event):
        super().resizeEvent(event)
        self._appliquer_taille_image()

    def _charger_image(self, image_absolue: Path):
        self._image_absolue = image_absolue
        pixmap = QPixmap(str(image_absolue)) if image_absolue.exists() else QPixmap()
        if pixmap.isNull():
            self._ratio_image = 100 / 140
            self._pixmap_brute = QPixmap()
            self.image_label.setText("Aperçu indisponible")
            self.image_label.setPixmap(QPixmap())
        else:
            self.image_label.setText("")
            self._ratio_image = pixmap.height() / pixmap.width() if pixmap.width() > 0 else 100 / 140
            self._pixmap_brute = pixmap
        self._appliquer_taille_image()

    def set_selectionnee(self, selectionnee: bool):
        self.setProperty("selectionnee", "true" if selectionnee else "false")
        self.style().unpolish(self)
        self.style().polish(self)

    def rafraichir(self, composant_layout: "ComposantLayout", image_absolue: Path):
        self._nom_affiche = self._nom_court(composant_layout.nom, composant_layout.service_api_nom)
        self.nom_label.setText(self._nom_affiche)
        self.badge_valide.setToolTip("Validé manuellement" if composant_layout.filtre_scindement_valide else "Non validé")
        self._appliquer_couleur_badge_valide(composant_layout.filtre_scindement_valide)
        self._charger_image(image_absolue)

    def mousePressEvent(self, event):
        if event.button() == Qt.LeftButton:
            self._pos_depart = event.pos()
            self.clique.emit(self.composant_layout_nom)
        super().mousePressEvent(event)

    def mouseMoveEvent(self, event):
        # MÊME mécanisme que ComposantTuile.mouseMoveEvent (SPEC 7.1 :
        # "Draggable vers une autre interface, même mécanisme que cS") --
        # copie du seuil anti-clic-accidentel et du drop externe
        # (text/uri-list), MIME interne propre à cL (MIME_TYPE ci-dessus)
        # pour ne jamais être confondu avec un drop de cS ailleurs dans
        # l'app (ex: GroupeSection.dropEvent, qui ne teste QUE le MIME cS).
        if not (event.buttons() & Qt.LeftButton) or not hasattr(self, "_pos_depart"):
            return super().mouseMoveEvent(event)
        if (event.pos() - self._pos_depart).manhattanLength() < QApplication.startDragDistance():
            return super().mouseMoveEvent(event)

        mime = QMimeData()
        mime.setData(self.MIME_TYPE, self.composant_layout_nom.encode("utf-8"))

        if self._image_absolue.exists():
            nom_suggere = re.sub(r'[<>:"/\\|?*]', "_", self.composant_layout_nom).strip() or "composant_layout"
            dossier_tmp = Path(tempfile.gettempdir()) / "AutoniaX_drag"
            try:
                dossier_tmp.mkdir(parents=True, exist_ok=True)
                chemin = dossier_tmp / f"{nom_suggere}{self._image_absolue.suffix}"
                shutil.copyfile(self._image_absolue, chemin)
                mime.setUrls([QUrl.fromLocalFile(str(chemin))])
            except OSError:
                pass

        drag = QDrag(self)
        drag.setMimeData(mime)
        apercu = self.grab().scaled(80, 60, Qt.KeepAspectRatio, Qt.SmoothTransformation)
        drag.setPixmap(apercu)
        drag.setHotSpot(QPoint(apercu.width() // 2, apercu.height() // 2))
        # DÉSACTIVÉ (même demande, appliquée par cohérence à cL --
        # cf. ComposantTuile.mouseMoveEvent) -- l'ancien fenetre.hide()/
        # show() qui masquait la fenêtre principale pendant drag.exec()
        # est retiré : la fenêtre reste visible pendant tout le drag.
        drag.exec(Qt.CopyAction | Qt.MoveAction)


class PanneauProprietesLayoutFlottant(QFrame):
    """Panneau flottant de propriétés d'un ComposantLayout -- SPEC section
    7.2. Widget OVERLAY par-dessus la grille de ComposantsLayoutScreen
    (position absolue, PAS un QDockWidget/QSplitter Qt classique -- cf.
    SPEC : "un panneau flottant, pas intrusif", et la justification
    détaillée dans la SPEC sur pourquoi un vrai QSplitter ne s'applique
    pas ici).

    Ancré coin bas-gauche du parent, taille par défaut 1/3 hauteur x 1/2
    largeur du parent (cf. repositionner()), redimensionnable par deux
    poignées maison (bande de quelques px en haut = hauteur, bande à
    droite = largeur) -- **[DÉCISION ASSUMÉE]**, largeur poignée 6px.

    demande_modifier(str) : émis sur clic "Modifier" (nom complet du cL).
    demande_suppression(str) : émis sur clic "Supprimer" (nom complet).
    demande_fermeture() : émis sur clic croix de fermeture.
    Ne touche JAMAIS au modèle lui-même (aucun appel à self.project ici)
    -- toute action de fond est déléguée à ComposantsLayoutScreen, même
    contrat que le reglages_panel de ComposantsScreen (séparation
    affichage / logique).

    AJOUT (retrait de l'onglet Test intégré à ComposantLayoutConfigScreen,
    demande explicite utilisateur : "enlève l'onglet Test, on va
    directement réutiliser l'interface de test de composant actuelle") --
    demande_tester(str) : émis sur clic "Tester" (nom complet du cL),
    MÊME patron que demande_modifier ci-dessus et que demande_tester_
    composant de ComposantReglagesPanel (panneau flottant équivalent
    côté ComposantSingle) -- ouvre désormais TestComposantScreen en
    MODE_COMPOSANT_LAYOUT (cf. ApplicationsScreen.ouvrir_test_composant_
    layout) plutôt que l'ancien onglet "Test" local à
    ComposantLayoutConfigScreen, retiré."""

    demande_modifier = Signal(str)
    demande_suppression = Signal(str)
    demande_fermeture = Signal()
    demande_toggle_change = Signal()  # émis quand un des 2 toggles change -- ComposantsLayoutScreen redessine l'image
    demande_tester = Signal(str)  # nom complet du ComposantLayout, cf. AJOUT ci-dessus

    LARGEUR_POIGNEE = 6

    def __init__(self, parent=None):
        super().__init__(parent)
        self.setObjectName("PanneauProprietesLayoutFlottant")
        self._composant_layout_nom: Optional[str] = None
        self._largeur_ratio = 0.5   # fraction de la largeur du parent
        self._hauteur_ratio = 1/3   # fraction de la hauteur du parent
        self._drag_hauteur = False
        self._drag_largeur = False
        self._pos_drag_depart = QPoint()
        self._taille_drag_depart = QSize()

