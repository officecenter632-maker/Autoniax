        # de rendu réseau hérité n'a plus aucun usage sur cet écran. ---
        # CORRECTIF (retrait exact) : l'apercu_label par défaut ne vit
        # pas directement dans _droite_layout mais DEDANS apercu_scroll
        # (QScrollArea.setWidget, cf. PanneauRenduInstance.__init__) --
        # un removeWidget sur _droite_layout était donc un no-op muet.
        # takeWidget() est le retrait correct.
        ancien_label = self.apercu_label
        self._panneau_rendu.apercu_scroll.takeWidget()
        ancien_label.setParent(None)
        ancien_label.deleteLater()
        self.apercu_label = None  # réassigné à apercu_layout_label plus bas

        # --- CORRECTIF (demande explicite utilisateur : "pour l'instant
        # on doit se concentrer sur l'interface de modifications ... pour
        # l'instant limitons-nous à la configuration, donc il ne doit pas
        # avoir de panneau de rendu") -- l'onglet Configuration (ex-
        # "Formes") N'A PAS BESOIN de tout l'appareillage réseau hérité
        # de InstanceApercuScreen (bloc "INSTANCE CIBLE" + titre/profil/
        # colonne de réglages Rafraîchir-Mode-Taux du panneau de rendu) :
        # il ne travaille QUE sur image_reference, une image déjà figée,
        # jamais sur un flux d'instance vivante.
        #
        # REFONTE (retrait de l'onglet Test, demande explicite
        # utilisateur : "enlève l'onglet Test [de ComposantLayoutConfigScreen],
        # on va directement réutiliser l'interface de test de composant
        # actuelle, exactement la même interface") -- l'onglet Test et
        # tout son appareillage de bascule (QTabWidget Configuration/Test,
        # reparentage d'apercu_layout_label entre les deux, masquage
        # conditionnel de _panneau_rendu/bloc INSTANCE CIBLE selon
        # l'onglet actif) sont retirés : cet écran n'affiche plus QUE la
        # Configuration, en permanence -- tester un ComposantLayout passe
        # désormais par TestComposantScreen en MODE_COMPOSANT_LAYOUT (cf.
        # ApplicationsScreen.ouvrir_test_composant_layout, bouton "Tester"
        # du panneau flottant, PanneauProprietesLayoutFlottant.demande_tester).
        # Tout l'appareillage réseau hérité de InstanceApercuScreen (bloc
        # "INSTANCE CIBLE" + _panneau_rendu) n'a donc plus AUCUN usage ici
        # -- masqué une seule fois, définitivement, pas de bascule à gérer
        # (cf. _sur_changement_onglet_cl et son eventFilter/showEvent,
        # tous deux retirés avec l'onglet Test).
        #
        # 1) Bloc "INSTANCE CIBLE" (section_label + combo + boutons +
        # statut réseau) : tous ces widgets sont déjà posés directement
        # dans self.layout_reglages par InstanceApercuScreen.__init__,
        # AVANT que ce __init__-ci ne s'exécute -- on les récupère donc
        # en listant les items déjà présents dans ce layout (aucun autre
        # widget n'y a encore été ajouté à ce stade) plutôt que de les
        # re-déclarer, pour ne pas dupliquer la logique métier associée
        # (connexion réseau, _on_instance_changed, etc.) qui reste
        # déclarée côté Python (héritée, inoffensive si jamais invoquée)
        # même si les widgets restent masqués en permanence désormais.
        self._widgets_instance_cible: list[QWidget] = []
        for i in range(self.layout_reglages.count()):
            item = self.layout_reglages.itemAt(i)
            w = item.widget()
            if w is not None:
                self._widgets_instance_cible.append(w)
            elif item.layout() is not None:
                # ligne_instance : QHBoxLayout imbriqué (combo + boutons),
                # pas un widget direct -- on masque chacun de ses enfants
                # individuellement (un QLayout n'a pas de setVisible()).
                sous_layout = item.layout()
                for j in range(sous_layout.count()):
                    sous_w = sous_layout.itemAt(j).widget()
                    if sous_w is not None:
                        self._widgets_instance_cible.append(sous_w)
        for w in self._widgets_instance_cible:
            w.setVisible(False)

        # 2) CORRECTIF (test offscreen réel : capture montrant toute
        # l'interface de Configuration écrasée dans une bande étroite à
        # gauche, malgré le masquage détaillé titre/profil/colonne de
        # réglages ci-dessus) -- masquer seulement le CONTENU de
        # _panneau_rendu ne suffit pas : ce widget reste posé dans
        # _main_layout avec un stretch de 30 contre 1 pour _scroll (cf.
        # _main_layout.addWidget(self._panneau_rendu, 30) dans
        # InstanceApercuScreen.__init__), donc même masqué à l'intérieur,
        # il continue de RÉSERVER 30/31 de la largeur totale. Masqué EN
        # BLOC, stretch rééquilibré une seule fois -- définitivement,
        # plus de bascule Test à prévoir.
        self._panneau_rendu.setVisible(False)
        self._main_layout.setStretch(self._main_layout.indexOf(self._scroll), 1)
        self._main_layout.setStretch(self._main_layout.indexOf(self._panneau_rendu), 0)

        # 3) bouton_repli_controles vit dans _bande_pliage (bande fixe
