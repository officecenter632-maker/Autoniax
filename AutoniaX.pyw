    def _sur_clic_renommer_local(self, nom_profil: str):
        """Renomme IMMÉDIATEMENT (registre profils.json + profils_
        config.json, cf. docstring de _construire_widget_actions) --
        même patron de dialogue que ProfilsInstancesScreen._on_clic_
        renommer_profil, mais sans la vérification d'instance active
        (non gérée ici, cf. docstring de classe/méthode appelante)."""
        nouveau_nom, ok = BoiteDialogueAutoniaX.saisie_texte(
            self, "Renommer le profil", "Nouveau nom :", QLineEdit.EchoMode.Normal, nom_profil,
        )
        if not ok:
            return
        nouveau_nom = nouveau_nom.strip()
        if not nouveau_nom or nouveau_nom == nom_profil:
            return
        if nouveau_nom in self._noms_profils:
            self.label_statut_liste.setText(f"Le profil '{nouveau_nom}' existe déjà.")
            return

        ok = renommer_profil(nom_profil, nouveau_nom)
        if not ok:
            self.label_statut_liste.setText(f"Impossible de renommer '{nom_profil}'.")
            return
        renommer_config_profil(nom_profil, nouveau_nom)

        self._noms_profils = sorted(
            [nouveau_nom if n == nom_profil else n for n in self._noms_profils], key=str,
        )
        self._infos_profils[nouveau_nom] = self._infos_profils.pop(nom_profil, {})
        self.label_statut_liste.setText(f"Profil '{nom_profil}' renommé en '{nouveau_nom}'.")
        self._reconstruire_table()

    def _sur_clic_supprimer_local(self, nom_profil: str):
        """Supprime IMMÉDIATEMENT après confirmation (registre +
        dossier disque + profils_config.json, cf. docstring de
        _construire_widget_actions) -- même patron de QMessageBox que
        ProfilsInstancesScreen._on_clic_supprimer_profil, mais sans la
        vérification/arrêt d'instance active (non géré ici)."""
        box = BoiteDialogueAutoniaX.question(
            self,
            "Supprimer le profil",
            f"Supprimer définitivement le profil « {nom_profil} » ?",
            texte_oui="Oui",
            texte_non="Annuler",
            texte_informatif="Son dossier de données (cookies, sessions connectées) sera définitivement supprimé du disque.",
        )
        if not box:
            return

        ok = supprimer_profil(nom_profil)
        if ok:
            supprimer_config_profil(nom_profil)
            self._noms_profils = [n for n in self._noms_profils if n != nom_profil]
            self._infos_profils.pop(nom_profil, None)
            self.label_statut_liste.setText(f"Profil '{nom_profil}' supprimé.")
        else:
            self.label_statut_liste.setText(f"Le profil '{nom_profil}' était déjà introuvable.")
        self._reconstruire_table()

    def _noms_profils_coches(self) -> list:
        racine = self.table_profils.invisibleRootItem()
        return [
            racine.child(i).text(0)
            for i in range(racine.childCount())
            if racine.child(i).checkState(0) == Qt.Checked
        ]

    def _sur_case_profil_changee(self, item: QTreeWidgetItem, colonne: int):
        if colonne == 0:
            self._rafraichir_libelle_envoi()

    def _rafraichir_libelle_envoi(self):
        nb_coches = len(self._noms_profils_coches())
        un_envoi_en_cours = bool(self._file_profils_a_envoyer) or self._nb_profils_total_envoi > 0 and self._nb_profils_traites_envoi < self._nb_profils_total_envoi
        self.bouton_envoyer.setEnabled(nb_coches > 0 and not un_envoi_en_cours)
        if not un_envoi_en_cours:
            self.bouton_envoyer.setText(
                f"Envoyer vers le cloud ({nb_coches})" if nb_coches else "Envoyer vers le cloud"
            )

    def _sur_clic_envoyer(self):
        noms_coches = self._noms_profils_coches()
        if not noms_coches:
            return
        self._file_profils_a_envoyer = list(noms_coches)
        self._nb_profils_total_envoi = len(noms_coches)
        self._nb_profils_traites_envoi = 0
        self.bouton_envoyer.setEnabled(False)
        self.label_statut_envoi.setText("")
        self.barre_progression.setRange(0, 100)
        self.barre_progression.setValue(0)
        self.barre_progression.setVisible(True)
        self._envoyer_prochain_profil()

    def _envoyer_prochain_profil(self):
        if not self._file_profils_a_envoyer:
            self.barre_progression.setVisible(False)
            self._nb_profils_total_envoi = 0
            self._nb_profils_traites_envoi = 0
            self._rafraichir_libelle_envoi()
            return
        nom_profil = self._file_profils_a_envoyer[0]
        self.label_statut_envoi.setText(
            f"Envoi de '{nom_profil}' ({self._nb_profils_traites_envoi + 1}/{self._nb_profils_total_envoi})..."
        )
        self.demande_envoi_profil.emit(nom_profil)

    def sur_progression_envoi_profil(self, nom_profil: str, pourcentage: int):
        # Filtre sur le profil réellement en tête de file -- ignore tout
        # signal résiduel concernant un profil déjà traité (même
        # prudence que ProfilsCloudScreen pour l'envoi vers sAutoniax).
        if not self._file_profils_a_envoyer or self._file_profils_a_envoyer[0] != nom_profil:
            return
        if pourcentage < 0:
            self.barre_progression.setRange(0, 0)
        else:
            self.barre_progression.setRange(0, 100)
            self.barre_progression.setValue(pourcentage)

    def sur_resultat_envoi_profil(self, ok: bool, nom_profil: str, message: str):
        if not self._file_profils_a_envoyer or self._file_profils_a_envoyer[0] != nom_profil:
            return  # résultat d'un envoi qui ne concerne pas la file en cours ici
        self._file_profils_a_envoyer.pop(0)
        self._nb_profils_traites_envoi += 1
        if not ok:
            self.label_statut_envoi.setText(f"Échec pour '{nom_profil}' : {message}")
        if self._file_profils_a_envoyer:
            self.barre_progression.setRange(0, 0)
            self._envoyer_prochain_profil()
        else:
            self.label_statut_envoi.setText(
                f"{self._nb_profils_traites_envoi} profil(s) envoyé(s) vers Profils/ du cloud."
                if ok else self.label_statut_envoi.text()
            )
            self._envoyer_prochain_profil()  # vide la file -> masque la barre, réactive le bouton

    def _demander_drapeau(self, code_pays: str):
        if code_pays in self._pixmaps_drapeaux or code_pays in self._codes_pays_demandes:
            return
        self._codes_pays_demandes.add(code_pays)
        self._drapeau_worker.demande_drapeau.emit(code_pays, code_pays)

    def _sur_drapeau_recu(self, code_pays: str, chemin):
        self._codes_pays_demandes.discard(code_pays)
        self._pixmaps_drapeaux[code_pays] = QPixmap(str(chemin)) if chemin else None
        self._reconstruire_table()


