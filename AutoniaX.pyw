# >>> INSTANCE_LEGERE_DEBUT
# ---------------------------------------------------------------------------
# PATCH « instance légère » (demande utilisateur : les profils ne doivent plus
# recharger les 139 000 lignes de l'application, interface Qt comprise).
#
# Le code du pilote de navigateur (main_instance_nodriver et tout ce qu'il
# utilise, ~12 % du fichier, aucune classe Qt) est extrait AUTOMATIQUEMENT dans
# AutoniaX_instance.py, à côté de ce fichier. Les profils (--instance-id)
# lancent ce fichier léger quand il est à jour ; sinon, ils lancent ce fichier
# complet exactement comme avant. On n'édite donc toujours QUE AutoniaX.pyw.
#
# Fonctionnement :
#   - extraction par analyse statique (ast) : on part de main_instance_nodriver
#     et on suit les noms de module qu'il référence (fonctions, classes,
#     constantes, imports) + les instructions de module qui modifient ce qui est
#     suivi (ex. `Classe.methode = ...`, logging.basicConfig...) ;
#   - le fichier généré est VÉRIFIÉ avant d'être écrit (compilation, noms
#     globaux tous définis, aucune trace de Qt) : au moindre doute il n'est pas
#     écrit, la raison est notée dans AutoniaX_instance.erreur.txt, et les
#     profils continuent d'utiliser ce fichier complet ;
#   - le fichier léger porte le hash du source dans sa 1re ligne : il est
#     régénéré tout seul (process séparé, en arrière-plan, sans geler
#     l'interface) dès que AutoniaX.pyw change ; tant qu'il est périmé, les
#     profils utilisent ce fichier complet ;
#   - interrupteur de secours : AUTONIAX_INSTANCE_COMPLETE=1 dans
#     l'environnement force le lancement des profils avec le fichier complet.
# ---------------------------------------------------------------------------
GENERATEUR_INSTANCE_VERSION = 1
NOM_FICHIER_INSTANCE_LEGERE = "AutoniaX_instance.py"
POINT_ENTREE_INSTANCE = "main_instance_nodriver"
_STAMP_PREFIXE_INSTANCE_LEGERE = "# AUTONIAX_SOURCE_STAMP="


def _noeuds_definis_et_refs(noeud):
    """(noms définis au niveau module par ce noeud, noms référencés par ce noeud)."""
    import ast

    definis = set()

    def parcourir_definitions(n):
        if isinstance(n, (ast.FunctionDef, ast.AsyncFunctionDef, ast.ClassDef)):
            definis.add(n.name)
            return  # le corps est local, ne définit rien au niveau module
        if isinstance(n, ast.Lambda):
            return
        if isinstance(n, (ast.Import, ast.ImportFrom)):
            for a in n.names:
                definis.add((a.asname or a.name).split(".")[0])
            return
        if isinstance(n, ast.Name) and isinstance(n.ctx, (ast.Store, ast.Del)):
            definis.add(n.id)
        if isinstance(n, ast.ExceptHandler) and n.name:
            definis.add(n.name)
        for enfant in ast.iter_child_nodes(n):
            parcourir_definitions(enfant)

    parcourir_definitions(noeud)

    refs = set()
    for n in ast.walk(noeud):
        if isinstance(n, ast.Name):
            refs.add(n.id)
    return definis, refs


def _racine_mutee(noeud):
    """Nom racine modifié par une instruction de module du type `X.attr = v`,
    `X[k] = v`, `X.methode(...)` (None si l'instruction n'est pas de ce type)."""
    import ast

    def racine(e):
        while isinstance(e, (ast.Attribute, ast.Subscript, ast.Call)):
            e = e.value if not isinstance(e, ast.Call) else e.func
        return e.id if isinstance(e, ast.Name) else None

    if isinstance(noeud, (ast.Assign, ast.AugAssign, ast.AnnAssign)):
        cibles = noeud.targets if isinstance(noeud, ast.Assign) else [noeud.target]
        racines = [racine(c) for c in cibles if isinstance(c, (ast.Attribute, ast.Subscript))]
        racines = [r for r in racines if r]
        return racines[0] if racines else None
    if isinstance(noeud, ast.Expr) and isinstance(noeud.value, ast.Call):
        return racine(noeud.value)
    return None


def extraire_code_instance(source: str):
    """Retourne (code_genere, rapport). Lève une exception si l'extraction est
    impossible ou jugée dangereuse (l'appelant retombe alors sur le fichier complet)."""
    import ast
    import builtins as _builtins

    arbre = ast.parse(source)
    corps = arbre.body
    infos = []  # (noeud, definis, refs)
    noms_vers_idx = {}
    for i, n in enumerate(corps):
        d, r = _noeuds_definis_et_refs(n)
        if isinstance(n, ast.If) and "__name__" in r:
            d = set()  # bloc « point d'entrée » (if __name__ == ...) : jamais extrait
        infos.append((n, d, r))
        for nom in d:
            noms_vers_idx.setdefault(nom, []).append(i)

    if POINT_ENTREE_INSTANCE not in noms_vers_idx:
        raise RuntimeError(f"{POINT_ENTREE_INSTANCE} introuvable")

    inclus = set()      # indices de noeuds retenus
    noms_suivis = set()
    a_traiter = [POINT_ENTREE_INSTANCE]

    def ajouter_noeud(i):
        if i in inclus:
            return
        inclus.add(i)
        _, d, r = infos[i]
        for nom in d:
            if nom not in noms_suivis:
                a_traiter.append(nom)
        for nom in r:
            if nom not in noms_suivis:
                a_traiter.append(nom)

    instructions_module = []  # indices des instructions candidates (Expr / If / mutations)
    for i, (n, d, r) in enumerate(infos):
        if isinstance(n, (ast.Expr, ast.If, ast.Assign, ast.AugAssign, ast.AnnAssign)):
            if isinstance(n, ast.If) and "__name__" in r:
                continue
            if isinstance(n, ast.Expr) and isinstance(n.value, ast.Constant):
                continue  # docstring / chaîne isolée
            if isinstance(n, (ast.Assign, ast.AugAssign, ast.AnnAssign)) and _racine_mutee(n) is None:
                continue  # simple définition : traitée par le suivi des noms
            instructions_module.append(i)
    instructions_module_set = set(instructions_module)

    builtins_noms = set(dir(_builtins)) | {"__name__", "__file__", "__doc__"}
    while True:
        while a_traiter:
            nom = a_traiter.pop()
            if nom in noms_suivis:
                continue
            noms_suivis.add(nom)
            for i in noms_vers_idx.get(nom, []):
                ajouter_noeud(i)
        # instructions de module qui touchent ce qu'on suit (mutations, journalisation...)
        progres = False
        for i in instructions_module:
            if i in inclus:
                continue
            n, d, r = infos[i]
            racine = _racine_mutee(n)
            if isinstance(n, ast.If) or racine is None:
                # Expr / If sans receveur : retenue seulement si TOUT ce qu'elle référence est déjà suivi
                # (hors ce qu'elle définit elle-même, ex. le flux de repli .pyw qui crée _flux_pyw)
                r = r - d
                modules_refs = {x for x in r if x in noms_vers_idx}
                if modules_refs and modules_refs <= noms_suivis:
                    ajouter_noeud(i)
                    progres = True
                elif not modules_refs and (r - builtins_noms) <= noms_suivis:
                    ajouter_noeud(i)
                    progres = True
            elif racine in noms_suivis:
                ajouter_noeud(i)
                progres = True
        if not progres and not a_traiter:
            break

    lignes = source.splitlines()
    morceaux = []
    for i in sorted(inclus):
        n = infos[i][0]
        debut = n.lineno
        if isinstance(n, (ast.FunctionDef, ast.AsyncFunctionDef, ast.ClassDef)) and n.decorator_list:
            debut = min([debut] + [dec.lineno for dec in n.decorator_list])
        morceaux.append("\n".join(lignes[debut - 1:n.end_lineno]))

    en_tete = (
        '"""Fichier GÉNÉRÉ AUTOMATIQUEMENT par AutoniaX.pyw (extraction du pilote de navigateur,\n'
        'cf. extraire_code_instance). NE PAS ÉDITER : il est régénéré quand AutoniaX.pyw change."""\n'
    )
    code = en_tete + "\n\n".join(morceaux) + (
        f'\n\n\nif __name__ == "__main__":\n    {POINT_ENTREE_INSTANCE}()\n'
    )
    rapport = {
        "noeuds": len(inclus),
        "lignes_source": sum(infos[i][0].end_lineno - infos[i][0].lineno + 1 for i in inclus),
        "mutations": [f"L{infos[i][0].lineno}" for i in sorted(inclus) if i in instructions_module_set],
    }
    verifier_code_instance(code)
    return code, rapport


def verifier_code_instance(code: str) -> None:
    """Lève RuntimeError si le code extrait n'est pas autonome."""
    import builtins as _builtins
    import symtable

    compile(code, NOM_FICHIER_INSTANCE_LEGERE, "exec")  # SyntaxError éventuelle

    if "PySide6" in code or "qtawesome" in code:
        raise RuntimeError("le code extrait référence Qt/qtawesome -- extraction refusée")

    table = symtable.symtable(code, NOM_FICHIER_INSTANCE_LEGERE, "exec")
    definis_module = {
        s.get_name() for s in table.get_symbols()
        if s.is_assigned() or s.is_imported() or s.is_namespace()
    }
    declares_globaux = set()
    utilises = set()

    def visiter(t):
        for s in t.get_symbols():
            nom = s.get_name()
            if t.get_type() == "module":
                continue
            if s.is_declared_global() and (s.is_assigned() or s.is_namespace()):
                declares_globaux.add(nom)
            if s.is_global() and s.is_referenced():
                utilises.add(nom)
        for enfant in t.get_children():
            visiter(enfant)

    visiter(table)
    # noms référencés directement au niveau module
    for s in table.get_symbols():
        if s.is_referenced() and not (s.is_assigned() or s.is_imported() or s.is_namespace()):
            utilises.add(s.get_name())
    connus = definis_module | declares_globaux | set(dir(_builtins)) | {"__name__", "__file__", "__doc__"}
    # Symboles créés implicitement par le compilateur selon la version de Python
    # (ex. 3.14 : __conditional_annotations__, __annotate__ ; classes : __class__,
    # __classdict__...) -- ils n'ont rien à voir avec un nom manquant du source.
    implicites = {
        "__conditional_annotations__", "__annotate__", "__annotate_func__",
        "__classdict__", "__class__", "__classcell__", "__qualname__", "__module__",
        "__firstlineno__", "__static_attributes__",
    }
    manquants = sorted(utilises - connus - implicites)
    if manquants:
        raise RuntimeError(f"noms non définis dans le code extrait : {manquants[:15]}")


_cache_stamp_source_instance = {}  # chemin -> (mtime_ns, taille, stamp)


def _stamp_depuis_octets(donnees: bytes) -> str:
    import hashlib

    return f"v{GENERATEUR_INSTANCE_VERSION}-{hashlib.sha256(donnees).hexdigest()}"


def _stamp_source_instance(chemin_source) -> str:
    """Stamp (version du générateur + sha256) du fichier complet ; mis en cache
    sur (mtime, taille) pour ne pas re-hacher 8 Mo à chaque lancement de profil."""
    chemin_source = Path(chemin_source)
    st = chemin_source.stat()
    cle = str(chemin_source)
    c = _cache_stamp_source_instance.get(cle)
    if c and c[0] == st.st_mtime_ns and c[1] == st.st_size:
        return c[2]
    stamp = _stamp_depuis_octets(chemin_source.read_bytes())
    _cache_stamp_source_instance[cle] = (st.st_mtime_ns, st.st_size, stamp)
    return stamp


def _lire_stamp_instance_legere(chemin_leger):
    try:
        with open(chemin_leger, "r", encoding="utf-8") as f:
            ligne = f.readline().strip()
    except OSError:
        return None
    if ligne.startswith(_STAMP_PREFIXE_INSTANCE_LEGERE):
        return ligne[len(_STAMP_PREFIXE_INSTANCE_LEGERE):]
    return None


def ecrire_instance_legere(chemin_source, chemin_cible) -> dict:
    """Extrait, vérifie puis écrit (atomiquement) le fichier léger. Lève une
    exception, sans toucher à l'éventuel ancien fichier, si quoi que ce soit cloche."""
    chemin_source = Path(chemin_source)
    chemin_cible = Path(chemin_cible)
    donnees = chemin_source.read_bytes()
    stamp = _stamp_depuis_octets(donnees)  # calculé sur les octets réellement analysés
    code, rapport = extraire_code_instance(donnees.decode("utf-8"))
    contenu = f"{_STAMP_PREFIXE_INSTANCE_LEGERE}{stamp}\n{code}"
    tmp = chemin_cible.with_name(f"{chemin_cible.name}.{os.getpid()}.tmp")
    try:
        with open(tmp, "w", encoding="utf-8", newline="\n") as f:
            f.write(contenu)
        os.replace(tmp, chemin_cible)
    finally:
        try:
            if tmp.exists():
                tmp.unlink()
        except OSError:
            pass
    return rapport


def _generer_instance_legere_cli() -> int:
    """Point d'entrée de `AutoniaX.pyw --generer-instance-legere` (process
    séparé lancé en arrière-plan par _lancer_regeneration_instance_legere).
    Écrit son déroulement sur la sortie standard (= AutoniaX_instance.regen.log)."""
    import time as _time

    source = Path(SCRIPT_INSTANCE_DASHBOARD)
    cible = source.with_name(NOM_FICHIER_INSTANCE_LEGERE)
    fichier_erreur = cible.with_name(cible.stem + ".erreur.txt")
    t0 = _time.time()
    print(f"[instance légère] démarrage -- Python {sys.version.split()[0]}, source={source}", flush=True)
    try:
        rapport = ecrire_instance_legere(source, cible)
        try:
            if fichier_erreur.exists():
                fichier_erreur.unlink()
        except OSError:
            pass
        print(
            f"[instance légère] OK -- {cible} écrit en {_time.time() - t0:.1f}s "
            f"({rapport['lignes_source']} lignes de source retenues)", flush=True,
        )
        return 0
    except BaseException:
        detail = traceback.format_exc()
        print(f"[instance légère] ÉCHEC après {_time.time() - t0:.1f}s :\n{detail}", flush=True)
        try:
            fichier_erreur.write_text(detail, encoding="utf-8")
        except Exception:
            pass
        return 1


_regen_instance_legere_proc = None
_regen_instance_legere_echecs = 0
_regen_instance_legere_lancements = 0
_regen_instance_legere_verrou = threading.Lock()


def _lancer_regeneration_instance_legere() -> None:
    """Lance (au plus un à la fois, au plus 5 par process, arrêt après 2 échecs)
    la régénération du fichier léger dans un process séparé, sans bloquer l'appelant."""
    global _regen_instance_legere_proc, _regen_instance_legere_echecs, _regen_instance_legere_lancements
    with _regen_instance_legere_verrou:
        if _regen_instance_legere_proc is not None:
            if _regen_instance_legere_proc.poll() is None:
                return  # déjà en cours
            if _regen_instance_legere_proc.returncode != 0:
                _regen_instance_legere_echecs += 1
            _regen_instance_legere_proc = None
        if _regen_instance_legere_echecs >= 2 or _regen_instance_legere_lancements >= 5:
            return
        flux_journal = None
        try:
            _regen_instance_legere_lancements += 1
            try:
                flux_journal = open(
                    Path(SCRIPT_INSTANCE_DASHBOARD).with_name("AutoniaX_instance.regen.log"),
                    "w", encoding="utf-8", errors="replace",
                )
            except OSError:
                flux_journal = None
            if flux_journal is not None:
                import datetime as _dt
                flux_journal.write(f"[instance légère] lancé par le pid {os.getpid()} à {_dt.datetime.now():%H:%M:%S}\n")
                flux_journal.flush()
            sortie = flux_journal if flux_journal is not None else subprocess.DEVNULL
            _regen_instance_legere_proc = subprocess.Popen(
                [sys.executable, str(SCRIPT_INSTANCE_DASHBOARD), "--generer-instance-legere"],
                stdin=subprocess.DEVNULL, stdout=sortie, stderr=sortie,
                cwd=str(Path(SCRIPT_INSTANCE_DASHBOARD).parent),
                creationflags=getattr(subprocess, "CREATE_NO_WINDOW", 0),
            )
        except Exception:
            _regen_instance_legere_echecs += 1
        finally:
            if flux_journal is not None:
                flux_journal.close()


def script_instance_pour_profil() -> Path:
    """Script à lancer pour un profil (--instance-id) : le fichier léger s'il
    existe et correspond EXACTEMENT au source actuel, sinon le fichier complet
    (comportement d'avant) -- en déclenchant alors la régénération en arrière-plan."""
    complet = SCRIPT_INSTANCE_DASHBOARD
    try:
        if os.environ.get("AUTONIAX_INSTANCE_COMPLETE") == "1" or getattr(sys, "frozen", False):
            return complet
        leger = complet.with_name(NOM_FICHIER_INSTANCE_LEGERE)
        if leger.is_file() and _lire_stamp_instance_legere(leger) == _stamp_source_instance(complet):
            return leger
        _lancer_regeneration_instance_legere()
    except Exception:
        pass
    return complet
