        # dicts sont de simples RÉFÉRENCES vers ceux tenus à jour par
        # TaskConfigScreen (_noms_executants_reseau/_profils_reseau_actifs)
        # -- injectées via definir_contexte_reseau ci-dessous, jamais
        # recopiées, pour ne jamais se retrouver périmées.
        self._noms_executants_reseau_ref: dict = {}
        self._profils_reseau_actifs_ref: dict = {}

        root_layout = QVBoxLayout(self)
        root_layout.setContentsMargins(0, 0, 0, 0)
        root_layout.setSpacing(0)

        header = QWidget(self)
        header.setObjectName("PanneauComposantsImportesHeader")
        header_layout = QHBoxLayout(header)
        header_layout.setContentsMargins(14, 12, 14, 12)
        header_layout.setSpacing(8)
        self._header_layout = header_layout  # PATCH : marges réduites quand le panneau est replié

        # AJOUT (demande explicite utilisateur, cf. docstring de classe) --
        # bouton chevron de pliage, TOUJOURS le premier élément du header
        # (visible aussi bien déployé que replié, contrairement au titre
        # et au bouton "+" ci-dessous qui eux disparaissent au repli) :
        # même bouton pour plier ET déplier (setCheckable), même pattern
        # que TaskCelluleWidget.bouton_replier (icône qui s'inverse selon
