    # Manipulent le contenu de la page (navigation) -- réservées au
    # pilote exclusif, mêmes raisons que click/type_text.
    "goBack",
    "goForward",
}

# Sous-ensemble de srv_ACTIONS_SUPPORTEES autorisé pour un OBSERVATEUR (cf. décision
# utilisateur : "tant que l'autre fait seulement des requêtes visuelles [...] je ne
# veux pas juste que deux pilotes envoient des commandes"). Ces 7 actions ne
# manipulent jamais le contenu de la page -- elles ne font que contrôler/interroger
# ce qui est AFFICHÉ en aperçu (flux vidéo, liste des onglets, onglet actif visible,
# état d'initialisation) ou lire une donnée déjà générée/mesurée (fingerprint fictif
# sur disque, propriétés réelles de la machine) :
# - set_fps / set_streaming : active/désactive et règle le débit du flux vidéo renvoyé
#   au client -- aucun effet sur la page elle-même.
# - listTabs : pure lecture, retourne la liste des onglets existants.
# - switchTab : change quel onglet est actif/affiché -- utilisée aussi bien par le
#   Dashboard (choix de l'onglet à prévisualiser) que par InstanceApercuScreen
#   (role="pilote", cf. _demander_switch_onglet_navigateur) pour le MÊME usage de
#   présentation, jamais pour manipuler le contenu d'une page.
# - isInterfaceInitialisee : pure lecture, comme listTabs -- répond juste à une
#   question sur l'état actuel des onglets, sans jamais les modifier.
# - get_fingerprint : pure lecture du fingerprint BrowserForge/geoip déjà généré et
#   sauvegardé sur disque pour une instance Camoufox (cf. onglet "Propriétés" du
#   Dashboard, _camoufox_extraire_proprietes_fingerprint) -- ne manipule jamais le
#   contenu de la page, même raison que listTabs/isInterfaceInitialisee. AJOUTÉE ICI
#   (le commentaire au-dessus de sa déclaration dans srv_ACTIONS_SUPPORTEES
#   l'annonçait déjà, mais l'ajout au set réel avait été omis -- corrigé).
# - get_fingerprint_reel : symétrique de get_fingerprint pour le sous-onglet "Réel"
#   (cf. _reel_extraire_proprietes_machine) -- même raison, pure lecture.
# - getScreenInfo : pure lecture (taille du viewport CDP + position du curseur virtuel
#   déjà tracké côté instance) -- même raison que isInterfaceInitialisee, ne manipule
#   jamais le contenu de la page. AJOUTÉE ICI dès sa création pour ne PAS reproduire
#   l'oubli déjà vécu une fois avec get_fingerprint (cf. commentaire ci-dessus).
# Tout le reste (click, scroll, paste, copy, type_text, capture_propre, drag, clear,
# moveCursor, mousemove) reste réservé au pilote exclusif -- ce sont ces actions-là,
# et uniquement celles-ci, qui justifient l'exclusivité "un seul pilote à la fois".
srv_ACTIONS_OBSERVATEUR_AUTORISEES = {"set_fps", "set_streaming", "listTabs", "switchTab", "isInterfaceInitialisee", "get_fingerprint", "get_fingerprint_reel", "getScreenInfo"}


def srv_trouver_pilote_id_par_ws(ws) -> str | None:
    for id_, pilote in srv_registre.pilotes.items():
        if pilote.ws is ws:
            return id_
    return None


async def srv_gerer_command(ws, data: dict):
    instance_id = data.get("instance_id")
    action = data.get("action")
    requete_id = data.get("requete_id")
    # LOG DIAGNOSTIC CIBLÉ (bug "2e test qui gèle") : log d'ENTRÉE dès
    # réception, avant tout traitement -- pour vérifier si le serveur
    # reçoit set_streaming immédiatement après l'envoi côté AutoniaX (log
    # "-> ENVOI commande"), ou avec un retard qui indiquerait que
    # srv_gerer_connexion (async for de CETTE connexion pilote) était occupée
    # ailleurs à ce moment-là.
    # CORRECTIF (retour utilisateur explicite : "trop de logs redondants")
    # -- passé en debug : ce log d'entrée s'exécute pour CHAQUE commande,
    # y compris set_fps/set_streaming de routine relayés en rafale à
    # chaque clic Rafraîchir/Automatique (cf. _sur_regler_capture_instance_
    # demande côté AutoniaX) -- gardé en info UNIQUEMENT pour les actions
    # de pilotage réel (click/type_text/scroll_simple/listTabs/switchTab),
    # qui restent des événements ponctuels utiles à voir passer.
    if action in ("set_fps", "set_streaming"):
        srv_log.debug(f"srv_gerer_command() : reçu action={action!r} instance_id={instance_id!r} requete_id={requete_id!r}")
    else:
        # DÉSACTIVÉ (demande explicite utilisateur : "logs les plus
        # bruyants" -- cf. analyse logs.txt, ~605 occurrences) -- passé
        # en debug plutôt que supprimé, réactivable via la config du
        # logger. Le commentaire ci-dessus qui justifiait le info() pour
        # "pilotage réel ponctuel" ne tenait pas compte de capture_propre
        # et des commandes caméra, elles aussi envoyées en rafale.
        srv_log.debug(f"srv_gerer_command() : reçu action={action!r} instance_id={instance_id!r} requete_id={requete_id!r}")
    instance = srv_registre.instances.get(instance_id)
    if instance is None:
        # BUGFIX (confirmé en usage réel -- "list_tabs()" sur une instance
        # ISOLÉE timeout systématiquement à 20.0s avec "aucune réponse de
        # l'instance isolée", alors que le serveur refusait en réalité la
        # commande INSTANTANÉMENT) : ce refus n'envoyait QU'un message
        # "error" générique, SANS requete_id (cf. ancien commentaire
        # diagnostic ci-dessus, qui avait déjà identifié le mécanisme mais
        # pas encore corrigé). Côté client, ClientReseauAutoniaX._traiter_
        # message route TOUT message "error" vers erreur_recue (juste un
        # texte de statut, jamais lu par _MoteurRelaisPourComposantIsole/
        # MoteurExecutionCellule/SequenceurActionReseau) -- JAMAIS vers
        # command_result_recu, qui est le SEUL signal que ces appelants
        # écoutent (cf. _sur_command_result dans les trois). Résultat :
        # l'appelant qui attend ce requete_id précis ne se réveille JAMAIS
        # sur ce refus, seulement sur son propre timeout local (20.0s côté
        # _MoteurRelaisPourComposantIsole, 15.0s ou 8.0s ailleurs selon le
        # site d'appel) -- une réponse serveur immédiate et parfaitement
        # claire se retrouvait donc masquée derrière un délai d'attente
        # complet et un message trompeur ("aucune réponse") alors que le
        # serveur AVAIT répondu, juste pas de la façon que l'appelant sait
        # entendre.
        #
        # Correctif : envoie EN PLUS un command_result (ok=False, avec le
        # requete_id d'origine si fourni) -- même mécanisme exact que
        # n'importe quel échec normal relayé par l'instance elle-même (cf.
        # plus bas, srv_gerer_command_result) -- pour que TOUT appelant qui
        # attend ce requete_id via command_result_recu échoue immédiatement
        # avec le message d'erreur réel, plutôt que de bloquer jusqu'à son
        # timeout local. Le message "error" générique est conservé tel
        # quel juste après (aucun appelant existant ne doit perdre ce
        # signal, ex. code qui n'utilise que erreur_recue pour du diagnostic
        # UI) -- ce correctif AJOUTE un signal, n'en retire aucun.
        srv_log.warning(f"Commande '{action}' refusée (requete_id={requete_id!r}) : instance '{instance_id}' introuvable")
        message_erreur = f"instance '{instance_id}' introuvable"
        if requete_id:
            await srv_envoyer(ws, {
                "type": "command_result", "requete_id": requete_id,
                "ok": False, "error": message_erreur,
            })
        await srv_envoyer(ws, {"type": "error", "message": message_erreur})
        return
    if action not in srv_ACTIONS_SUPPORTEES:
        # BUGFIX -- même correctif que le refus "instance introuvable"
        # plus haut (cf. son commentaire pour le mécanisme complet) :
        # tous les refus de srv_gerer_command partageaient ce même trou.
        srv_log.warning(f"Commande '{action}' refusée (requete_id={requete_id!r}) : action non supportée")
        message_erreur = f"action non supportée : {action}"
        if requete_id:
            await srv_envoyer(ws, {
                "type": "command_result", "requete_id": requete_id,
                "ok": False, "error": message_erreur,
            })
        await srv_envoyer(ws, {"type": "error", "message": message_erreur})
        return
    # 5.2 : "le serveur vérifie que cette instance fait bien partie des
    # instances liées à ce pilote avant de router" -- absent du premier
    # jet (n'importe quel expéditeur pouvait commander n'importe quelle
    # instance, liée ou non, du moment qu'il en connaissait l'id). Sert
    # aussi de base au routage retour : srv_gerer_command_result relaie via
    # instance.liee_a, donc une commande acceptée sans liaison n'aurait
    # de toute façon aucun moyen fiable de recevoir sa réponse.
    pilote_id = srv_trouver_pilote_id_par_ws(ws)
    if pilote_id is None:
        # BUGFIX -- même correctif que le refus "instance introuvable"
        # plus haut (cf. son commentaire pour le mécanisme complet).
        srv_log.warning(f"Commande '{action}' refusée (requete_id={requete_id!r}) : expéditeur non enregistré")
        message_erreur = "commande refusée : expéditeur non enregistré comme pilote/observateur"
        if requete_id:
            await srv_envoyer(ws, {
                "type": "command_result", "requete_id": requete_id,
                "ok": False, "error": message_erreur,
            })
        await srv_envoyer(ws, {"type": "error", "message": message_erreur})
        return
    expediteur = srv_registre.pilotes.get(pilote_id)
    est_observateur = expediteur is not None and expediteur.role == "observateur"

    # BUG CORRIGÉ (ce tour -- "le rafraîchissement du dashboard ne fonctionne pas") :
    # le premier jet de ce refus bloquait TOUTE commande d'un observateur, y compris
    # set_streaming/listTabs/switchTab -- indispensables au Dashboard pour afficher
    # quoi que ce soit. Un observateur reste bloqué UNIQUEMENT sur les actions de
    # pilotage réel (hors srv_ACTIONS_OBSERVATEUR_AUTORISEES) -- jamais sur le
    # contrôle d'aperçu, cf. constante définie plus haut pour le détail du découpage.
    if est_observateur and action not in srv_ACTIONS_OBSERVATEUR_AUTORISEES:
        # BUGFIX -- même correctif que le refus "instance introuvable"
        # plus haut (cf. son commentaire pour le mécanisme complet).
        srv_log.warning(
            f"Commande '{action}' refusée (requete_id={requete_id!r}) : '{pilote_id}' est un "
            f"observateur (aperçu visuel seul), action de pilotage non autorisée"
        )
        message_erreur = f"'{pilote_id}' est un observateur : '{action}' nécessite d'être pilote"
        if requete_id:
            await srv_envoyer(ws, {
                "type": "command_result", "requete_id": requete_id,
                "ok": False, "error": message_erreur,
            })
        await srv_envoyer(ws, {"type": "error", "message": message_erreur})
        return

    if est_observateur:
        # Action de contrôle d'aperçu autorisée pour un observateur : routée
        # directement à l'instance SANS passer par la vérification instance.liee_a
        # ci-dessous, qui ne concerne que l'exclusivité PILOTE (instance.liee_a ne
        # contient jamais un observateur, cf. srv_gerer_link -- observateurs_lies
        # est la structure séparée qui les concerne). Vérifie seulement que cet
        # observateur est bien dans observateurs_lies de l'instance visée.
        if pilote_id not in instance.observateurs_lies:
            # BUGFIX -- même correctif que le refus "instance introuvable"
            # plus haut (cf. son commentaire pour le mécanisme complet).
            srv_log.warning(
                f"Commande '{action}' refusée (requete_id={requete_id!r}) : observateur '{pilote_id}' "
                f"pas lié à '{instance_id}' (observateurs_lies={instance.observateurs_lies!r})"
            )
            message_erreur = f"'{pilote_id}' n'est pas observateur de '{instance_id}' (link requis avant command)"
            if requete_id:
                await srv_envoyer(ws, {
                    "type": "command_result", "requete_id": requete_id,
                    "ok": False, "error": message_erreur,
                })
            await srv_envoyer(ws, {"type": "error", "message": message_erreur})
            return
        if requete_id:
            srv_registre.demandeurs_par_requete[requete_id] = pilote_id
        await srv_envoyer(instance.ws, data)
        srv_log.info(f"Commande '{action}' (aperçu) relayée à {instance_id} (demandée par l'observateur {pilote_id}, requete_id={requete_id!r})")
        return

    # CORRECTIF (bug confirmé en usage réel -- écran noir systématique dès
    # qu'un notebook distant s'exécute sur un profil isolé) : set_fps/
    # set_streaming envoyés par un PILOTE (pas seulement un observateur,
    # cf. cas déjà traité juste au-dessus) tombaient sous la vérification
    # d'exclusivité instance.liee_a == pilote_id ci-dessous. Or depuis que
    # l'exécuteur cross-process se lie lui-même à l'instance pour la durée
    # d'une cellule (cf. _MoteurRelaisPourComposantIsole._lier_si_besoin),
    # le pilote PRINCIPAL -- celui-là même qui pilote le flux d'aperçu
    # affiché dans le Dashboard/panneau clone via regler_capture_instance,
    # cf. son docstring -- se retrouve régulièrement délogé de la liaison
    # pendant qu'une cellule tourne. Ses set_fps/set_streaming étaient donc
    # rejetés en silence (l'appelant ne vérifie jamais le retour, cf. leurs
    # sites d'appel -- aucun requete_id fourni), la boucle de streaming
    # côté navigateur ne démarrait jamais, d'où l'écran noir malgré
    # regler_capture_instance_ack(ok=True) (qui ne confirme que l'envoi,
    # pas l'acceptation par ce garde-fou serveur).
    #
    # Ces deux actions sont déjà documentées (cf. srv_ACTIONS_OBSERVATEUR_
    # AUTORISEES ci-dessus) comme ne manipulant JAMAIS le contenu de la
    # page -- seulement le débit/l'état du flux vidéo renvoyé au client.
    # L'exclusivité "un seul pilote à la fois" n'a donc aucune raison de
    # s'appliquer à elles : plusieurs pilotes (le principal ET un exécuteur
    # temporairement lié) doivent pouvoir régler l'aperçu de la même
    # instance sans se déloger mutuellement, exactement comme un
    # observateur le peut déjà. Routée directement, sans toucher à
    # instance.liee_a ni exiger que pilote_id y figure.
    if action in ("set_fps", "set_streaming"):
        if requete_id:
            srv_registre.demandeurs_par_requete[requete_id] = pilote_id
        await srv_envoyer(instance.ws, data)
        srv_log.debug(f"Commande '{action}' (aperçu, hors exclusivité) relayée à {instance_id} (demandée par {pilote_id}, requete_id={requete_id!r})")
        return

    # SUPPRIMÉ (demande explicite utilisateur) : vérification d'exclusivité
    # instance.liee_a != pilote_id retirée. Toute commande est désormais
    # relayée à l'instance quel que soit le pilote/exécuteur qui l'envoie,
    # sans vérifier qui détient la liaison. Attention : si deux pilotes/
    # exécuteurs envoient des commandes à la même instance en même temps,
    # plus rien n'empêche qu'elles s'entrelacent (plus d'exclusivité).
    if requete_id:
        srv_registre.demandeurs_par_requete[requete_id] = pilote_id
        # DÉSACTIVÉ (demande explicite utilisateur : "logs les plus
        # bruyants" -- cf. analyse logs.txt, ~605 occurrences, une pour
        # chaque commande relayée) -- passé en debug, réactivable via la
        # config du logger.
        srv_log.debug(
            f"[DIAG-SRV] srv_gerer_command() : demandeurs_par_requete[{requete_id!r}] = {pilote_id!r} "
            f"ENREGISTRÉ -- taille_registre_totale={len(srv_registre.demandeurs_par_requete)}"
        )
    if action == "paste":
        srv_log.info(f"[DIAG paste] srv_gerer_command() : relais vers instance -- data complet envoyé={data!r}")
    # click(copier_presse_papier=True) : PLUS de coordination serveur ici
    # (ancien verrou global srv_verrou_copie_presse_papier + listener Win32
    # WM_CLIPBOARDUPDATE, retirés -- cf. srv_gerer_command_result juste en
    # dessous). L'instance (nodriver/Camoufox) lit directement son propre
    # etat_navigateur["presse_papier_virtuel"] après le clic (déjà tenu à
    # jour par l'interception navigator.clipboard.writeText installée sur
    # chaque onglet/contexte, cf. _installer_interception_presse_papier /
    # camoufox_installer_interception_presse_papier) et remplit elle-même
    # le "result" du command_result -- comme get_clipboard ou n'importe
    # quelle autre action à résultat. Isolé par instance, donc plusieurs
    # instances peuvent copier en parallèle sans jamais se marcher dessus
    # (plus besoin de sérialisation FIFO).
    await srv_envoyer(instance.ws, data)
    if action in ("set_fps", "set_streaming"):
        srv_log.debug(f"Commande '{action}' relayée à {instance_id} (demandée par {pilote_id}, requete_id={requete_id!r})")
    else:
        # DÉSACTIVÉ (demande explicite utilisateur : "logs les plus
        # bruyants" -- cf. analyse logs.txt) -- passé en debug,
        # réactivable via la config du logger.
        srv_log.debug(f"Commande '{action}' relayée à {instance_id} (demandée par {pilote_id}, requete_id={requete_id!r})")


async def srv_gerer_command_result(data: dict):
    """Relaie le résultat d'une action (cf. instance_nodriver.py,
    _executer_commande -- message {"type": "command_result", ...}) au
    DEMANDEUR original -- pilote OU observateur, selon qui a envoyé la
    commande correspondante.

    BUG CORRIGÉ (ce tour) : routait auparavant uniquement via
    instance.liee_a, ce qui suffisait tant que seul un pilote pouvait
    commander. Depuis l'introduction des observateurs autorisés à envoyer
    listTabs/switchTab (cf. srv_ACTIONS_OBSERVATEUR_AUTORISEES), liee_a
    peut valoir un pilote différent (ou None) alors que la réponse est
    due à un observateur -- la réponse partait alors vers le mauvais
    destinataire (ou nulle part), et le Dashboard restait bloqué en
    attente de son listTabs (combo d'onglets jamais peuplé). On consulte
    donc en priorité srv_registre.demandeurs_par_requete (alimenté dans
    srv_gerer_command juste avant le relais), qui connaît le VRAI
    expéditeur peu importe son rôle. Repli sur instance.liee_a seulement
    si aucune entrée n'existe (requete_id absent/vide côté appelant, ou
    entrée déjà consommée -- comportement d'avant conservé par prudence
    plutôt que de tout simplement ignorer la réponse)."""
    instance_id = data.get("instance_id")
    requete_id = data.get("requete_id")
    instance = srv_registre.instances.get(instance_id)
    if instance is None:
        srv_log.warning(f"command_result ignoré (requete_id={requete_id!r}) : instance '{instance_id}' introuvable")
        return

    # click(copier_presse_papier=True) : PLUS de traitement spécial ici
    # (ancien verrou global + attente WM_CLIPBOARDUPDATE + lecture Win32,
    # retirés -- cf. srv_gerer_command). data["result"] arrive déjà rempli
    # par l'instance elle-même (presse-papier virtuel, isolé par instance),
    # le relais normal juste en dessous suffit, comme pour n'importe quelle
    # autre action à résultat (get_clipboard, copy, etc.).

    # PATCH (nettoyage des logs -- problème #4 : "[DIAG-SRV]
    # srv_gerer_command_result() ENTRÉE" et "[DIAG-SRV] ... pop(...)"
    # étaient redondants avec le log final "command_result relayé" plus
    # bas, qui contient déjà requete_id/destinataire_id/ok -- supprimés.
    # "repli sur instance.liee_a" (utile pour diagnostiquer un routage par
    # corrélation manqué) est conservé mais fusionné DANS le log de relais
    # final ci-dessous plutôt que loggé séparément à chaque appel.
    repli_sur_liee_a = False
    destinataire_id = srv_registre.demandeurs_par_requete.pop(requete_id, None) if requete_id else None
    if destinataire_id is None:
        destinataire_id = instance.liee_a
        repli_sur_liee_a = True
        if destinataire_id is None:
            # LOG DIAGNOSTIC : passé en warning (pas debug) -- si ceci apparaît
            # pendant qu'un SequenceurActionReseau attend ce requete_id, son
            # callback ne sera jamais résolu par cette réponse (seul le
            # QTimer 8s le débloquera). Piste directe pour un blocage observé.
            srv_log.warning(f"command_result ignoré (requete_id={requete_id!r}) : aucun demandeur connu pour '{instance_id}' (ni corrélation, ni pilote lié)")
            return

    destinataire = srv_registre.pilotes.get(destinataire_id)
    if destinataire is None:
        srv_log.warning(f"command_result ignoré (requete_id={requete_id!r}) : demandeur '{destinataire_id}' non connecté")
        return
    # DÉSACTIVÉ (demande explicite utilisateur : "logs les plus bruyants"
    # -- cf. analyse logs.txt, ~605 occurrences, une par commande
    # relayée) -- passé en debug plutôt que supprimé : reste réactivable
    # via la config du logger pour diagnostiquer un futur blocage.
    srv_log.debug(
        f"command_result relayé (requete_id={requete_id!r}) à '{destinataire_id}' : "
        f"ok={data.get('ok')!r}" + (" [repli sur instance.liee_a]" if repli_sur_liee_a else "")
    )
    await srv_envoyer(destinataire.ws, data)


srv_compteur_frames: dict[str, int] = {}


_srv_requetes_executeur_introuvable_loguees: set = set()


async def srv_gerer_executer_code(ws, data: dict):
    """AJOUT (Section 8 -- cf. PLAN_section_8_arreter.md §5/§7 étape 1) --
    relais process principal (role="pilote") -> exécuteur (role=
    "executeur") de la demande d'exécution d'une cellule. Simple relais
    CIBLÉ par instance_id, calqué sur srv_gerer_command mais SANS son
    modèle de liaison/permissions (link/liee_a/observateurs_lies) :
    un exécuteur n'appartient jamais qu'au seul process principal qui
    l'a lancé, aucune notion de partage/eviction n'a de sens ici."""
    instance_id = data.get("instance_id")
    requete_id = data.get("requete_id")
    executeur = srv_registre.executeurs.get(instance_id)
    if executeur is None:
        # PATCH : le process principal réessaie toutes les 0,5 s tant que l'exécuteur démarre -- un seul message par requête.
        if requete_id not in _srv_requetes_executeur_introuvable_loguees:
            _srv_requetes_executeur_introuvable_loguees.add(requete_id)
            if len(_srv_requetes_executeur_introuvable_loguees) > 500:
                _srv_requetes_executeur_introuvable_loguees.clear()
            srv_log.info(f"executer_code : exécuteur '{instance_id}' pas encore connecté (démarrage en cours, imports lents possibles) -- nouvelles tentatives automatiques (requete_id={requete_id!r}).")
        await srv_envoyer(ws, {
            "type": "executer_code_resultat", "instance_id": instance_id, "requete_id": requete_id,
            "ok": False, "erreur": f"exécuteur '{instance_id}' introuvable ou déconnecté", "sortie": "",
            # CORRECTIF (bug confirmé en usage réel -- une cellule échoue
            # systématiquement "introuvable ou déconnecté" au tout premier
            # executer_notebook_distant sur un exécuteur qui vient d'être
            # lancé, cf. _sautoniax_executer_notebook_distant_sur_instance_
            # isolee, qui reçoit CE message via le même canal Qu'un vrai
            # executer_code_resultat -- sans marqueur explicite, il ne peut
            # pas distinguer "l'exécuteur n'est pas encore connecté, réessaie"
            # d'un "la cellule a réellement échoué", et abandonnait à tort dès
            # la première réponse reçue au lieu de relancer sa boucle de
            # retry. Champ dédié plutôt que de faire dépendre le client du
            # texte exact du message d'erreur (fragile, sujet à dérive).
            "executeur_introuvable": True,
        })
        return
    await srv_envoyer(executeur.ws, data)
    srv_log.debug(f"executer_code relayé à l'exécuteur '{instance_id}' (requete_id={requete_id!r})")


async def srv_gerer_executer_code_resultat(ws, data: dict):
    """Relais exécuteur -> process principal (symétrique de srv_gerer_
    executer_code) : contrairement à srv_gerer_command_result, pas besoin
    de retrouver un demandeur par requete_id/instance.liee_a -- un
    exécuteur n'a qu'UN SEUL interlocuteur possible, le pilote qui l'a
    enregistré/lui a envoyé sa dernière commande "executer_code". On
    relaie donc directement à TOUS les pilotes connectés en tant que
    "pilote" (jamais aux observateurs, non concernés) -- en pratique un
    seul processus principal de sAutoniax tourne par serveur local, donc
    un seul destinataire réel recevra ce message ; diffuser plutôt que
    cibler évite d'avoir à faire porter un id_pilote de bout en bout dans
    ce protocole strictement local, purement point-à-point par
    construction (cf. docstring de srv_ExecuteurInfo)."""
    instance_id = data.get("instance_id")
    requete_id = data.get("requete_id")
    destinataires = [p for p in srv_registre.pilotes.values() if p.role == "pilote"]
    if not destinataires:
        srv_log.warning(f"executer_code_resultat ignoré (requete_id={requete_id!r}) : aucun pilote connecté pour '{instance_id}'")
        return
    await asyncio.gather(*(srv_envoyer(p.ws, data) for p in destinataires), return_exceptions=True)
    srv_log.debug(f"executer_code_resultat relayé ({len(destinataires)} pilote(s)) pour '{instance_id}' (requete_id={requete_id!r})")


async def srv_gerer_executer_code_image(ws, data: dict):
    """AJOUT (Section 8 -- suite logique de srv_gerer_executer_code, cf.
    échange utilisateur : Image.view() doit continuer de fonctionner une
    fois le code utilisateur exécuté DANS le process exécuteur plutôt
    que dans le process principal). Fire-and-forget, un message par
    appel .view() du code utilisateur -- PAS groupé avec executer_code_
    resultat en fin de cellule : Image.view() envoie "au fil de l'eau"
    (cf. sa docstring, "affichée au fil de l'eau à côté des lignes de
    log existantes"), un envoi différé à la fin casserait ce
    comportement déjà en place pour tout profil non-isolé. Même relais
    que executer_code_resultat (diffusion à tous les rôles "pilote",
    aucun tracking par id_pilote nécessaire -- même justification, cf.
    sa docstring)."""
    instance_id = data.get("instance_id")
    destinataires = [p for p in srv_registre.pilotes.values() if p.role == "pilote"]
    if not destinataires:
        srv_log.warning(f"executer_code_image ignoré : aucun pilote connecté pour '{instance_id}'")
        return
    await asyncio.gather(*(srv_envoyer(p.ws, data) for p in destinataires), return_exceptions=True)
    srv_log.debug(f"executer_code_image relayé ({len(destinataires)} pilote(s)) pour '{instance_id}'")


async def srv_gerer_regenerer_navigateur_executeur(ws, data: dict):
    """AJOUT (regenerer_navigateur() depuis une cellule) -- relais exécuteur ->
    process principal, même principe que srv_gerer_executer_code_image :
    diffusion à tous les clients de rôle "pilote" (en pratique, le process
    principal du sAutoniax)."""
    instance_id = data.get("instance_id")
    destinataires = [p for p in srv_registre.pilotes.values() if p.role == "pilote"]
    if not destinataires:
        srv_log.warning(f"regenerer_navigateur_executeur ignoré : aucun pilote connecté pour '{instance_id}'")
        return
    await asyncio.gather(*(srv_envoyer(p.ws, data) for p in destinataires), return_exceptions=True)
    srv_log.info(f"regenerer_navigateur_executeur relayé ({len(destinataires)} destinataire(s)) pour '{instance_id}'")


async def srv_gerer_pont_reponse(ws, data: dict):
    """AJOUT (pont fichiers pilote <-> clone) -- relais process principal -> exécuteur : réponse du pilote à une demande de
    fichier. Ciblé sur l'exécuteur de `instance_id` (le clone qui a posé la question), jamais diffusé. Exécuteur absent
    (arrêté entre-temps) : journalisé, rien d'autre -- il n'attend plus."""
    instance_id = data.get("instance_id")
    executeur = srv_registre.executeurs.get(instance_id)
    if executeur is None:
        srv_log.warning(f"pont_reponse_executeur ignoré : exécuteur '{instance_id}' introuvable")
        return
    await srv_envoyer(executeur.ws, data)


async def srv_gerer_frame(data: dict):
    taille_ko = len(data.get("image_b64", "")) / 1024
    contexte = f"(instance={data.get('instance_id')} seq={data.get('seq')} ~{taille_ko:.0f} Ko)"
    # LOG DIAGNOSTIC CIBLÉ (bug "2e test qui gèle") : débit échantillonné
    # (1 log toutes les 30 frames par instance) -- pour voir si le flux de
    # frames de l'instance ralentit ou s'arrête net avant la coupure, sans
    # noyer le log à 10-30 lignes/seconde comme le ferait un log par frame.
    instance_id = data.get("instance_id", "?")
    srv_compteur_frames[instance_id] = srv_compteur_frames.get(instance_id, 0) + 1
    if srv_compteur_frames[instance_id] % 30 == 0:
        srv_log.info(f"srv_gerer_frame() : {srv_compteur_frames[instance_id]} frames reçues de {instance_id} (dernière seq={data.get('seq')})")
    await srv_diffuser_a_tous_les_pilotes(data, contexte)


async def srv_retirer_connexion(ws):
    # AJOUT (cf. srv_ExecuteurInfo) -- symétrique du nettoyage des
    # instances navigateur ci-dessous, mais pour le registre executeurs :
    # aucune liaison/verrou/observateur à nettoyer en plus (cf. docstring
    # de srv_ExecuteurInfo, aucun de ces mécanismes ne s'applique à un
    # exécuteur), un simple retrait du dict suffit.
    for id_, executeur in list(srv_registre.executeurs.items()):
        if executeur.ws is ws:
            del srv_registre.executeurs[id_]
            srv_log.info(f"Exécuteur déconnecté : {id_}")
    for id_, inst in list(srv_registre.instances.items()):
        if inst.ws is ws:
            del srv_registre.instances[id_]
            srv_log.info(f"Instance déconnectée : {id_}")
            if inst.liee_a and inst.liee_a in srv_registre.liaisons:
                srv_registre.liaisons[inst.liee_a] = [i for i in srv_registre.liaisons[inst.liee_a] if i != id_]
                if not srv_registre.liaisons[inst.liee_a]:
                    del srv_registre.liaisons[inst.liee_a]
            # ANCIEN filet de sécurité pour le verrou global copier_presse_
            # papier -- retiré avec lui (cf. bloc "ANCIEN mécanisme..." plus
            # haut) : le presse-papier virtuel est isolé par instance, plus
            # aucun état serveur partagé ne peut rester bloqué si une
            # instance se déconnecte en cours de commande.
            await srv_diffuser_liste_instances_a_tous()
    # BUG CORRIGÉ (instances bloquées définitivement après fermeture d'un
    # onglet/écran) : symétrique de la boucle ci-dessus, mais dans l'autre
    # sens. Quand c'est un PILOTE (pas une instance) qui se déconnecte
    # (fermeture d'onglet TestComposantScreen/CoordonneeActionScreen,
    # Dashboard, etc.), les instances qu'il tenait via liee_a n'étaient
    # JAMAIS libérées ici -- seul del srv_registre.pilotes[id_] avait lieu.
    # instance.liee_a continuait donc à pointer vers un pilote_id qui
    # n'existait plus dans srv_registre.pilotes, ce qui bloquait
    # DÉFINITIVEMENT toute nouvelle liaison sur cette instance (srv_gerer_link
    # refuse tant que liee_a n'est pas None ou égal au nouveau demandeur)
    # -- seul un redémarrage complet du serveur purgeait ce blocage,
    # jamais la simple fermeture/réouverture d'un écran côté AutoniaX.
    instances_liberees = False
    for id_, pil in list(srv_registre.pilotes.items()):
        if pil.ws is ws:
            del srv_registre.pilotes[id_]
            srv_log.info(f"{pil.role.capitalize()} déconnecté : {id_}")
            for instance in srv_registre.instances.values():
                if instance.liee_a == id_:
                    instance.liee_a = None
                    instances_liberees = True
                    srv_log.info(f"Instance '{instance.id}' libérée (pilote '{id_}' déconnecté)")
                # PATCH (cf. instance.verrou_pilote_id, srv_gerer_link) : sans ce
                # nettoyage, un pilote qui détient un verrou et se déconnecte SANS
                # unlink propre (crash, fermeture brutale) le laisserait bloqué
                # jusqu'à expiration (SRV_VERROU_TIMEOUT_S, 30s) au lieu d'être libéré
                # immédiatement -- ici la déconnexion est déjà détectée avec certitude,
                # pas besoin d'attendre le filet de sécurité du timeout.
                if instance.verrou_pilote_id == id_:
                    instance.verrou_pilote_id = None
                    instance.verrou_pose_a = None
                    srv_log.info(f"Verrou de '{instance.id}' levé (détenteur '{id_}' déconnecté)")
                # Nettoyage symétrique pour les OBSERVATEURS (nouveau -- avant
                # l'introduction d'observateurs_lies ce cas n'existait pas) : sans ce
                # retrait, un observateur déconnecté resterait indéfiniment fantôme
                # dans observateurs_lies de chaque instance qu'il observait -- fuite
                # mémoire mineure, mais retiré par cohérence puisque l'id ne
                # correspond plus à personne de connecté.
                instance.observateurs_lies.discard(id_)
            srv_registre.liaisons.pop(id_, None)
    if instances_liberees:
        await srv_diffuser_liste_instances_a_tous()


async def srv_gerer_connexion(ws):
    srv_log.info("Nouvelle connexion WebSocket")
    try:
        async for brut in ws:
            try:
                data = json.loads(brut)
            except json.JSONDecodeError:
                await srv_envoyer(ws, {"type": "error", "message": "message non-JSON reçu"})
                continue
            type_message = data.get("type")
            if type_message == "register":
                await srv_gerer_register(ws, data)
            elif type_message == "list_instances":
                await srv_gerer_list_instances(ws)
            elif type_message == "link":
                await srv_gerer_link(ws, data)
            elif type_message == "unlink":
                await srv_gerer_unlink(ws, data)
            elif type_message == "force_unlink":
                await srv_gerer_force_unlink(ws, data)
            elif type_message == "command":
                await srv_gerer_command(ws, data)
            elif type_message == "command_result":
                await srv_gerer_command_result(data)
            elif type_message == "executer_code":
                await srv_gerer_executer_code(ws, data)
            elif type_message == "executer_code_resultat":
                await srv_gerer_executer_code_resultat(ws, data)
            elif type_message == "executer_code_image":
                # AJOUT (Section 8 -- Image.view() depuis le process
                # exécuteur, cf. srv_gerer_executer_code_image) --
                # `ws` non requis (relais toujours par diffusion, jamais
                # ciblé), gardé en argument pour une signature uniforme
                # avec les autres branches de ce dispatch.
                await srv_gerer_executer_code_image(ws, data)
            elif type_message == "pont_reponse_executeur":
                await srv_gerer_pont_reponse(ws, data)
            elif type_message in ("regenerer_navigateur_executeur", "regenerer_navigateur_resultat_executeur"):
                await srv_gerer_regenerer_navigateur_executeur(ws, data)
            elif type_message == "frame":
                await srv_gerer_frame(data)
            else:
                await srv_envoyer(ws, {"type": "error", "message": f"type de message inconnu : {type_message}"})
    except websockets.exceptions.ConnectionClosed as e:
        # LOG DIAGNOSTIC : code/raison de fermeture vus CÔTÉ SERVEUR --
        # à comparer avec ceux vus côté AutoniaX (ClientReseauAutoniaX)
        # pour la même connexion. Si les deux logs ne montrent PAS le même
        # code au même moment, la coupure ne vient pas d'un simple
        # ping_timeout mais d'un problème réseau/OS entre les deux process.
        srv_log.warning(
            f"Connexion WebSocket fermée -- "
            f"code_recu={getattr(e.rcvd, 'code', None)} raison_recue={getattr(e.rcvd, 'reason', None)!r} "
            f"code_envoye={getattr(e.sent, 'code', None)} raison_envoyee={getattr(e.sent, 'reason', None)!r}"
        )
    finally:
        await srv_retirer_connexion(ws)


async def srv_main_async(port: int):
    arret = asyncio.Event()

    def _demander_arret(*_):
        srv_log.info("Signal d'arrêt reçu, fermeture du serveur...")
        arret.set()

    # SIGTERM = ce qu'AutoniaX enverra via Popen().terminate() à sa fermeture
    # (cf. closeEvent côté AutoniaX.py). SIGINT = Ctrl+C en lancement manuel.
    # add_signal_handler n'existe pas sur Windows pour SIGTERM -> repli sur
    # signal.signal (fonctionne pour SIGINT partout, et pour la fermeture
    # "propre" déclenchée par Popen.terminate() sous Windows, qui envoie en
    # réalité un TerminateProcess sans passer par un signal Python géré ;
    # AutoniaX doit donc aussi prévoir un message "shutdown" applicatif en
    # secours si une fermeture plus propre que TerminateProcess est voulue
    # -- non fait dans cette version, cf. limitation notée plus bas).
    try:
        loop = asyncio.get_running_loop()
        loop.add_signal_handler(signal.SIGTERM, _demander_arret)
        loop.add_signal_handler(signal.SIGINT, _demander_arret)
    except NotImplementedError:
        # Windows : add_signal_handler non supporté pour ces signaux.
        signal.signal(signal.SIGINT, _demander_arret)

    # ANCIEN démarrage du listener Win32 WM_CLIPBOARDUPDATE -- retiré (cf.
    # bloc "ANCIEN mécanisme..." plus haut) : click(copier_presse_papier=True)
    # ne dépend plus du presse-papier Windows physique.

    async with serve(srv_gerer_connexion, srv_HOST, port, family=socket.AF_INET, max_size=None):
        srv_log.info(f"Serveur central à l'écoute sur ws://{srv_HOST}:{port}")
        await arret.wait()
    srv_log.info("Serveur arrêté proprement.")


def main_serveur():
    """Point d'entrée du mode "serveur" (ex-serveur.py main()) -- RENOMMÉ
    pour ne pas entrer en collision avec main(), le point d'entrée de
    l'application Qt principale, et pour rester cohérent avec le nommage
    de main_instance_nodriver() ci-dessus. Reste un process Python séparé,
    lancé via subprocess.Popen([sys.executable, __file__, "--serveur",
    "--port", ...]) -- cf. MainWindow.__init__, qui lance maintenant ce
    fichier lui-même plutôt que serveur.py séparé. Cf. dispatch sur
    sys.argv en fin de fichier (if __name__ == "__main__")."""
    parser = argparse.ArgumentParser(description="Serveur central AutoniaX")
    parser.add_argument("--serveur", action="store_true", help="Mode serveur (dispatch, cf. fin de fichier)")
    parser.add_argument("--port", type=int, default=srv_PORT_DEFAUT)
    args = parser.parse_args()

    try:
        asyncio.run(srv_main_async(args.port))
    except OSError as e:
        # Port déjà occupé (ex: un serveur d'une session précédente n'a pas
        # été nettoyé) -> message explicite en stderr + code de sortie non-nul,
        # qu'AutoniaX peut détecter via Popen.poll() (cf. lancement du process
        # côté AutoniaX.py, qui vérifie que le process est toujours vivant
        # juste après le lancement plutôt que de supposer que ça a marché).
        srv_log.error(f"Impossible de démarrer le serveur sur le port {args.port} : {e!r}")
        sys.exit(1)
    except KeyboardInterrupt:
        pass


# ---------------------------------------------------------------------------
# PATCH (Patch 4.4.c -- démarrage automatique multi-profils côté sAutoniax).
# Un sAutoniax n'a aucune interface graphique pour démarrer manuellement un
# profil (contrairement à mAutoniax, ProfilsInstancesScreen). Ces fonctions
# reproduisent le MÊME mécanisme que mAutoniax (serveur local + une instance
# subprocess par profil, cf. MainWindow.__init__ et
# ProfilsInstancesScreen._lancer_instance_pour_profil) plutôt que d'inventer
# un chemin d'exécution parallèle : MoteurExecutionBatch (déjà utilisé par
# ProjetBatchScreen en local) est ensuite réutilisé TEL QUEL, sans aucune
# modification, une fois les instances connectées au serveur local. Extraites
# ici en fonctions autonomes (pas des méthodes d'écran) car _main_async_
# sautoniax ne dispose d'aucun widget Qt (mode headless, cf. docstring de
# main_sautoniax) -- la logique métier de _lancer_instance_pour_profil est
# reprise à l'identique (mêmes flags de détachement process, même lecture de
# stdout en thread daemon), seules les touches UI (labels, rafraîchissement
# de grille, worker de localisation proxy) sont retirées.
# ---------------------------------------------------------------------------

def _sautoniax_demarrer_serveur_local() -> Optional[subprocess.Popen]:
    """Lance le serveur central LOCAL (main_serveur(), même process que ce
    fichier -- cf. SCRIPT_SERVEUR_DASHBOARD) en subprocess, exactement comme
    MainWindow.__init__ le fait côté mAutoniax desktop. Nécessaire pour que
    MoteurExecutionBatch (qui pilote les instances via websocket LOCAL,
    jamais directement en mémoire) fonctionne côté sAutoniax sans aucune
    modification. Retourne None si un serveur écoute déjà sur ce port
    (réutilisé tel quel plutôt que de faire échouer tout le sAutoniax pour
    un conflit de port bénin -- ex. un serveur laissé actif par une
    exécution précédente du même process Kaggle)."""
    if _serveur_dashboard_deja_actif():
        log.info(f"[sAutoniax] serveur local déjà actif sur le port {PORT_SERVEUR_DASHBOARD} -- réutilisé tel quel.")
        return None
    try:
        proc = subprocess.Popen(
            [sys.executable, str(SCRIPT_SERVEUR_DASHBOARD), "--serveur", "--port", str(PORT_SERVEUR_DASHBOARD)],
            stdout=subprocess.PIPE, stderr=subprocess.STDOUT, text=True,
            creationflags=FLAGS_DETACHEMENT_PROCESS_WINDOWS,
        )
    except OSError as e:
        log.error(f"[sAutoniax] impossible de lancer le serveur local : {e!r}")
        return None
    if proc.poll() is not None:
        log.error(f"[sAutoniax] serveur local arrêté immédiatement (code {proc.returncode}) -- port {PORT_SERVEUR_DASHBOARD} déjà occupé ?")
        return None

    def _lire_stdout_serveur(p: subprocess.Popen):
        try:
            for ligne in iter(p.stdout.readline, ""):
                if not ligne:
                    break
                log.info(f"[sAutoniax][serveur] {ligne.rstrip()}")
        except (ValueError, OSError):
            pass
    threading.Thread(target=_lire_stdout_serveur, args=(proc,), name="sautoniax-lecture-stdout-serveur", daemon=True).start()
    log.info(f"[sAutoniax] serveur local lancé (PID {proc.pid}, port {PORT_SERVEUR_DASHBOARD}).")
    return proc


def _sautoniax_fichier_pids_isoles() -> Path:
    """Chemin du registre PERSISTANT (survit à un redémarrage du process
    sAutoniax) des PID d'instances isolées lancées via
    demander_demarrer_profil_isole -- sous AUTONIAX_DATA_DIR (cf.
    _chemin_donnees), donc valide aussi bien sur Kaggle/Linux qu'en local
    Windows.

    BUG CORRIGÉ (retour utilisateur explicite : "je croyais que le
    redémarrage allait tuer tous les profils en cours" -- confirmé en
    conditions réelles : même après le patch précédent sur les DEUX
    `finally` de _main_async_sautoniax fermant _procs_isoles, le même
    PID Camoufox zombie (ex. PID 8868) survivait À TRAVERS PLUSIEURS
    redémarrages successifs de l'exécutant, provoquant systématiquement
    l'échec "Camoufox is already running, but is not responding" au
    prochain lancement du même profil) -- cause racine identifiée :
    _procs_isoles est une variable LOCALE à _main_async_sautoniax, donc
    réinitialisée à {} vide à chaque redémarrage (redemarrer_executant
    fait sortir le process Python ENTIER via sys.exit(CODE_SORTIE_
    REDEMARRAGE), cf. main_sautoniax -- ce n'est pas juste une boucle
    interne qui se relance). Un PID d'instance isolée lancé par une
    génération PRÉCÉDENTE du process sAutoniax n'a donc jamais existé
    dans le _procs_isoles de la génération qui exécute le finally : le
    fermer proprement dans ce finally était structurellement impossible,
    quel que soit le luxe de précautions qu'on y mettait.

    Ce fichier JSON (liste de PID bruts) comble ce trou : écrit à chaque
    lancement réussi d'instance isolée (cf. _sautoniax_enregistrer_pid_
    isole), il est lu et VIDÉ au tout début de chaque nouvelle génération
    de _main_async_sautoniax (cf. _sautoniax_nettoyer_anciens_procs_
    isoles), qui tue alors tout PID encore vivant AVANT de faire quoi que
    ce soit d'autre -- garantissant qu'un profil n'est jamais retrouvé
    "déjà en cours" par un reliquat d'une exécution précédente."""
    return _chemin_donnees("sautoniax_procs_isoles.json")


def _sautoniax_enregistrer_pid_isole(instance_id: str, pid: int) -> None:
    """Ajoute (instance_id, pid) au registre persistant (cf. docstring de
    _sautoniax_fichier_pids_isoles). Best-effort : une erreur d'écriture
    (disque plein, permissions...) est journalisée mais ne doit jamais
    empêcher l'instance elle-même de démarrer -- ce registre est un
    filet de sécurité pour le PROCHAIN redémarrage, pas une condition de
    fonctionnement de l'instance en cours."""
    chemin = _sautoniax_fichier_pids_isoles()
    try:
        chemin.parent.mkdir(parents=True, exist_ok=True)
        registre = {}
        if chemin.exists():
            try:
                registre = json.loads(chemin.read_text(encoding="utf-8"))
            except (json.JSONDecodeError, OSError):
                registre = {}
        registre[instance_id] = pid
        chemin.write_text(json.dumps(registre), encoding="utf-8")
    except OSError as e:
        log.warning(f"[sAutoniax] échec d'écriture du registre PID isolés (non bloquant) : {e!r}")


def _sautoniax_nettoyer_anciens_procs_isoles() -> None:
    """Lit le registre persistant (cf. _sautoniax_fichier_pids_isoles),
    tue (SIGTERM puis SIGKILL en secours) tout PID encore vivant, puis
    vide le fichier -- appelée UNE FOIS tout au début de chaque nouvelle
    génération de _main_async_sautoniax, avant tout lancement d'instance,
    pour repartir sur un état propre même après un redémarrage qui a
    laissé des instances isolées orphelines (cf. docstring de
    _sautoniax_fichier_pids_isoles pour le détail complet du bug).

    os.kill(pid, 0) est le test de vivacité standard sur POSIX (Kaggle/
    Linux, l'environnement réel de sAutoniax) : ne tue rien, lève
    ProcessLookupError si le PID n'existe plus. Sur Windows (mAutoniax
    desktop n'exécute jamais ce chemin sAutoniax, cf. docstring de
    main_sautoniax -- filet de sécurité seulement), os.kill lève
    OSError/NotImplementedError selon le cas : capturé et journalisé,
    jamais fatal."""
    chemin = _sautoniax_fichier_pids_isoles()
    if not chemin.exists():
        return
    try:
        registre = json.loads(chemin.read_text(encoding="utf-8"))
    except (json.JSONDecodeError, OSError) as e:
        log.warning(f"[sAutoniax] registre PID isolés illisible (ignoré) : {e!r}")
        registre = {}
    for instance_id, pid in registre.items():
        if not isinstance(pid, int) or pid <= 0:
            # GARDE-FOU : os.kill avec un PID <= 0 cible un GROUPE de
            # process sur POSIX (0 = groupe de l'appelant, négatif =
            # groupe explicite), jamais un process isolé -- un registre
            # corrompu ou une valeur invalide ne doit jamais risquer de
            # tuer autre chose que l'instance visée. Ignoré silencieusement.
            continue
        try:
            os.kill(pid, 0)  # lève si le PID n'existe plus -- rien à faire
        except (ProcessLookupError, OSError):
            continue
        except Exception:
            continue
        log.warning(
            f"[sAutoniax] instance isolée orpheline '{instance_id}' (PID {pid}) détectée "
            f"depuis une génération précédente -- fermeture avant de continuer."
        )
        try:
            os.kill(pid, signal.SIGTERM)
            time.sleep(0.5)
            os.kill(pid, 0)  # encore vivant ?
            time.sleep(4.5)
            os.kill(pid, 0)
            log.warning(f"[sAutoniax] PID {pid} ne répond pas à SIGTERM après 5s -- SIGKILL forcé.")
            os.kill(pid, signal.SIGKILL)
        except (ProcessLookupError, OSError):
            pass  # déjà mort entre-temps, c'est le résultat voulu
    try:
        chemin.write_text("{}", encoding="utf-8")
    except OSError as e:
        log.warning(f"[sAutoniax] échec de vidage du registre PID isolés (non bloquant) : {e!r}")


def _sautoniax_lancer_instance_subprocess(
    nom_profil: str, chemin_profil: str, instance_id: str, proxy_profil: Optional[dict] = None,
) -> Optional[subprocess.Popen]:
    """Lance une instance nodriver/Camoufox en subprocess pour UN profil,
    même mécanique que ProfilsInstancesScreen._lancer_instance_pour_profil
    côté mAutoniax (commande, flags de détachement, lecture stdout en
    thread daemon) sans les touches UI (pas de label, pas de
    rafraîchissement de grille, pas de test de proxy séparé).

    CORRECTIF (retour utilisateur explicite : "fudev500 est configuré
    chrome (profils_config.json le confirme) mais se lance quand même en
    camoufox -- goBack/goForward ok=True mais rien ne bouge, cf. tout le
    diagnostic bfcache Playwright qui a suivi") -- creusé jusqu'au bout :
    la cause n'était PAS bfcache pour ce profil précis, c'était --navigateur
    "camoufox" codé EN DUR juste en dessous, quel que soit le
    type_instance réellement configuré pour le profil. L'ancienne
    docstring l'assumait explicitement ("tous les profils sAutoniax sont
    Camoufox") -- hypothèse fausse dans le cas général : rien n'empêche
    un profil sAutoniax d'être "chrome" (cf. obtenir_config_profil,
    profils_config.json), et le chemin mAutoniax local (cf.
    ProfilsInstancesScreen._lancer_instance_pour_profil un peu plus haut
    dans ce fichier) respecte déjà ce choix -- ce chemin sAutoniax était
    le seul des deux à l'ignorer. type_instance est maintenant lu ICI
    (même obtenir_config_profil(nom_profil) que proxy_profil juste
    au-dessus dans les 3 appelants, un seul appel local supplémentaire,
    aucun site d'appel à modifier) et pilote --navigateur exactement
    comme côté mAutoniax : "camoufox" seulement si le profil est
    réellement configuré ainsi, "chrome" pour tout le reste (y compris
    les profils créés avant ce registre, cf. CONFIG_PROFIL_PAR_DEFAUT).

    CORRECTIF (retour utilisateur explicite : "pourquoi le sAutoniax pour
    démarrer un profil n'active pas le proxy s'il y en a") -- l'ancienne
    docstring affirmait "le proxy est déjà porté par le fingerprint du
    profil lui-même, rechargé automatiquement sans --proxy explicite" :
    c'est une hypothèse FAUSSE dans le cas général, jamais vérifiée
    jusqu'au bout. camoufox_demarrer_navigateur ne recharge un proxy
    depuis le fingerprint.json QUE s'il y en avait déjà un au moment où ce
    fichier a été généré pour la toute première fois (cf. sa docstring,
    section "diag-proxy") -- si ce profil a été lancé au moins une fois
    SANS --proxy avant ce correctif (ce qui était systématiquement le cas
    ici, cet argument n'était jamais construit), aucun fingerprint
    contenant un proxy n'existe jamais sur disque, et la comparaison
    interne (None vs None) le déclare à tort "cohérent" -- l'instance
    démarre alors indéfiniment SANS proxy, quelle que soit la
    configuration du profil côté cloud (obtenir_config_profil(nom)
    ["proxy"]), sans aucune erreur visible pour l'expliquer.

    `proxy_profil` (même format que obtenir_config_profil(nom)["proxy"] :
    {"protocole","host","port","user","password"} ou None) est maintenant
    transmis en JSON via --proxy, EXACTEMENT le même patron que
    ProfilsInstancesScreen._lancer_instance_pour_profil côté mAutoniax
    (cf. son propre `commande += ["--proxy", json.dumps(proxy_profil)]`,
    juste au-dessus dans ce fichier) -- reconstruit côté _main_async/
    camoufox_demarrer_navigateur pour construire ou régénérer un
    fingerprint robuste avec ce proxy si le fingerprint existant ne le
    contient pas déjà (cf. la vérification "proxy cohérent avec la
    demande" dans camoufox_demarrer_navigateur, qui gère elle-même la
    régénération le cas échéant -- rien à dupliquer ici)."""
    type_instance_profil = obtenir_config_profil(nom_profil).get("type_instance", "chrome")
    navigateur_a_lancer = type_instance_profil if type_instance_profil in MOTEURS_PLAYWRIGHT else "chrome"
    # PATCH GARDE-FOU MOTEUR -- un dossier qui contient camoufox_fingerprint.json EST un profil Camoufox : le lancer
    # avec Chrome (cas d'une config absente/par défaut sur cette machine -> "chrome") ignore le fingerprint
    # (viewport/identité différents) et salit le dossier avec des fichiers Chrome (Default/, Local State...).
    # La config locale est alors corrigée une fois pour toutes pour ce nom de profil.
    if navigateur_a_lancer == "chrome":
        try:
            if os.path.isfile(os.path.join(str(chemin_profil), "camoufox_fingerprint.json")):
                cfg_corr = obtenir_config_profil(nom_profil) or {}
                log.warning(
                    f"[PROFIL-DEMARRAGE][CORRECTION MOTEUR] profil '{nom_profil}' : type_instance={type_instance_profil!r} "
                    f"sur cette machine mais le dossier contient camoufox_fingerprint.json -> lancé avec CAMOUFOX (et non "
                    f"Chrome). Config locale corrigée.")
                _diag_log(str(chemin_profil), "warning",
                          f"[PROFIL-DEMARRAGE][CORRECTION MOTEUR] type_instance={type_instance_profil!r} -> 'camoufox' "
                          f"(camoufox_fingerprint.json présent dans le profil).")
                enregistrer_config_profil(nom_profil, "camoufox", cfg_corr.get("proxy"), cfg_corr.get("pays"),
                                          cfg_corr.get("contraintes_ecran") or {})
                navigateur_a_lancer = "camoufox"
        except Exception as exc_moteur:
            log.warning(f"[PROFIL-DEMARRAGE] garde-fou moteur impossible ({exc_moteur!r}) -- moteur inchangé.")
    commande = [
        sys.executable, str(script_instance_pour_profil()),
        "--instance-id", instance_id,
        "--port", str(PORT_SERVEUR_DASHBOARD),
        "--navigateur", navigateur_a_lancer,
        "--profil", chemin_profil,
        "--headless",
        # PATCH (toggle "bloquer médias" par profil) -- même argument que le
        # chemin mAutoniax (cf. _lancer_instance_pour_profil).
        "--nom-profil", nom_profil,
    ]
    if proxy_profil:
        # cf. argparse --proxy (mode instance) -- même transmission JSON
        # que le chemin mAutoniax équivalent (cf. docstring ci-dessus).
        commande += ["--proxy", json.dumps(proxy_profil)]
    try:
        proc = subprocess.Popen(
            commande,
            stdout=subprocess.PIPE, stderr=subprocess.STDOUT, text=True,
            creationflags=FLAGS_DETACHEMENT_PROCESS_WINDOWS,
        )
    except OSError as e:
        log.error(f"[sAutoniax] impossible de lancer l'instance pour le profil '{nom_profil}' : {e!r}")
        return None

    def _lire_stdout_instance(p: subprocess.Popen, iid: str = instance_id):
        try:
            for ligne in iter(p.stdout.readline, ""):
                if not ligne:
                    break
                log.info(f"[sAutoniax][instance:{iid}] {ligne.rstrip()}")
        except (ValueError, OSError):
            pass
    threading.Thread(target=_lire_stdout_instance, args=(proc,), name=f"sautoniax-lecture-stdout-{instance_id}", daemon=True).start()
    log.info(f"[sAutoniax] instance '{instance_id}' (profil '{nom_profil}') lancée (PID {proc.pid}).")
    return proc


# PATCH (revue de validation 4.4.c, point 1) : TIMEOUT_VERIF_INSTANCES_S de
# MoteurExecutionBatch (8.0s, cf. sa définition) est calibré pour le flux
# mAutoniax desktop, où un humain a déjà lancé les instances manuellement
# et patienté (cf. commentaire de _lancer_instance_pour_profil : "environ
# 30 ou 50 sec" avant que Camoufox soit réellement prêt) AVANT de cliquer
# "Démarrer" sur le batch -- 8s suffisent alors, il ne s'agit que de
# confirmer un état déjà acquis. Côté sAutoniax, les subprocess Camoufox
# viennent tout juste d'être lancés (cf. _sautoniax_lancer_instance_
# subprocess, appelé juste avant) : sans une vraie attente ici, moteur.
# lancer() échouerait quasi systématiquement avec InstancesIndisponibles
# Error. Ce timeout-ci est donc volontairement beaucoup plus généreux (et
# CONFIGURABLE, contrairement à la constante de classe figée) qu'un simple
# alignement sur "30-50s" -- démarrage à froid (premier lancement Camoufox
# sur un environnement Kaggle possiblement plus lent, téléchargement de
# binaire navigateur inclus) non testé en conditions réelles.
TIMEOUT_DEMARRAGE_INSTANCES_SAUTONIAX_S = 120.0


def _sautoniax_attendre_instances_pretes(instances_visees: list, annulation_demandee: threading.Event,
                                          timeout_s: float = TIMEOUT_DEMARRAGE_INSTANCES_SAUTONIAX_S) -> tuple:
    """Attend activement (bloquant -- appelé via run_in_executor par
    l'appelant asyncio, cf. _sautoniax_traiter_projet_recu) que TOUTES les
    `instances_visees` (liste d'instance_id) apparaissent connectées ET
    libres dans le instances_list du serveur local -- même critère que
    MoteurExecutionBatch._verifier_instances_bloquant (§4.4.c point 2:
    "vérifier que chaque profil a démarré avec succès"), réimplémenté ici
    en amont, PAS pour dupliquer cette dernière (qui reste appelée par
    lancer() -- filet de sécurité final rapide, cf. son propre timeout de
    8s toujours en place), mais pour donner aux instances tout le temps
    réel de démarrage effectif avant même d'y arriver.

    Poll périodique (plutôt qu'un simple threading.Event bloquant sur le
    premier message, cf. _verifier_instances_bloquant) car ici on doit
    aussi pouvoir sortir tôt sur annulation_demandee.set() (PATCH -- revue
    de validation 4.4.c point 2, kill_projet pendant le démarrage) sans
    attendre le timeout complet.

    Retourne (True, "") si toutes prêtes ; (False, message) sinon --
    jamais d'exception, même convention que _verifier_instances_bloquant."""
    if not instances_visees:
        return True, ""

    client_verif = ClientReseauAutoniaX(
        SERVER_URL_DASHBOARD, role="pilote", id_client=f"sautoniax-attente-demarrage-{uuid.uuid4().hex[:8]}",
    )
    dernier_etat: dict = {"instances": []}
    evenement_maj = threading.Event()

    def _sur_liste(instances: list):
        dernier_etat["instances"] = instances
        evenement_maj.set()

    client_verif.liste_instances_recue.connect(_sur_liste, Qt.DirectConnection)
    client_verif.demarrer()
    try:
        intervalle_poll_s = 2.0
        debut = time.monotonic()
        while True:
            if annulation_demandee.is_set():
                return False, "Annulé (kill_projet reçu pendant le démarrage des profils)."
            evenement_maj.wait(timeout=intervalle_poll_s)
            evenement_maj.clear()
            par_id = {i.get("id"): i for i in dernier_etat["instances"]}
            manquantes = [
                iid for iid in instances_visees
                if par_id.get(iid) is None or not par_id[iid].get("libre", False)
            ]
            if not manquantes:
                return True, ""
            if time.monotonic() - debut >= timeout_s:
                return False, (
                    f"Délai dépassé ({timeout_s:.0f}s) en attendant le démarrage des instances : "
                    f"{', '.join(manquantes)} jamais confirmée(s) connectée(s)/libre(s) par le serveur local."
                )
    finally:
        client_verif.liste_instances_recue.disconnect(_sur_liste)
        # Fermeture fire-and-forget -- même raisonnement que
        # MoteurExecutionBatch._verifier_instances_bloquant (client jetable,
        # plus aucun usage après cette attente).
        MoteurExecutionTaskHeadless._CLIENTS_RESEAU_EN_ARRET.add(client_verif)

        def _finir_arret():
            client_verif.arreter()
            MoteurExecutionTaskHeadless._CLIENTS_RESEAU_EN_ARRET.discard(client_verif)
        threading.Thread(target=_finir_arret, daemon=True).start()


def _sautoniax_attendre_instance_absente(instance_id: str, timeout_s: float = 10.0) -> bool:
    """AJOUT (régénération sous le même instance_id) -- bloquant (run_in_executor) : attend que le
    serveur local ne liste plus `instance_id` (l'ancien navigateur est bien déconnecté), pour que
    _sautoniax_attendre_instances_pretes ne prenne pas l'ancienne entrée pour le nouveau navigateur.
    Retourne True si absente, False au timeout. Jamais d'exception."""
    client_verif = ClientReseauAutoniaX(
        SERVER_URL_DASHBOARD, role="pilote", id_client=f"sautoniax-attente-absence-{uuid.uuid4().hex[:8]}",
    )
    dernier_etat: dict = {"instances": None}
    evenement_maj = threading.Event()

    def _sur_liste(instances: list):
        dernier_etat["instances"] = instances
        evenement_maj.set()

    client_verif.liste_instances_recue.connect(_sur_liste, Qt.DirectConnection)
    client_verif.demarrer()
    try:
        debut = time.monotonic()
        while time.monotonic() - debut < timeout_s:
            evenement_maj.wait(timeout=1.0)
            evenement_maj.clear()
            if dernier_etat["instances"] is not None and not any(i.get("id") == instance_id for i in dernier_etat["instances"]):
                return True
        return False
    except Exception as exc:
        log.warning(f"[sAutoniax] attente d'absence de '{instance_id}' interrompue : {exc!r}")
        return False
    finally:
        try:
            client_verif.liste_instances_recue.disconnect(_sur_liste)
        except (RuntimeError, TypeError):
            pass
        MoteurExecutionTaskHeadless._CLIENTS_RESEAU_EN_ARRET.add(client_verif)

        def _finir_arret():
            client_verif.arreter()
            MoteurExecutionTaskHeadless._CLIENTS_RESEAU_EN_ARRET.discard(client_verif)
        threading.Thread(target=_finir_arret, daemon=True).start()


async def _sautoniax_assurer_donnees_de_base(client_t: "ClientServeurT", loop: asyncio.AbstractEventLoop) -> None:
    """PATCH (Patch 4.7 -- données de base côté sAutoniax) : télécharge
    mouseData.sqlite3 et le dossier service API depuis App/ du bucket
    (cf. App/mouseData.sqlite3, App/service_api.zip -- écrits là par
    ClientServeurT._envoyer_mise_a_jour_app côté pilote, cf. les deux
    cases "Inclure mouseData.sqlite3"/"Inclure le dossier service API"
    de MiseAJourStockageScreen, §4.6), SEULEMENT si absents localement --
    cf. spec §4.7 : "au premier chargement de l'app / première exécution
    d'un notebook sur un sAutoniax fraîchement provisionné, ces données
    de base sont téléchargées automatiquement (si absentes localement),
    avant toute exécution".

    Appelée en tout début de _main_async_sautoniax, AVANT le téléchargement
    du profil lui-même (mouseData est nécessaire dès la première
    trajectoire de souris générée, cf. get_mouse_data_path/
    generate_click_duration_ms -- le service API est nécessaire dès la
    première tâche de template matching, cf. get_service_api_dir) --
    échec NON BLOQUANT pour chacun des deux (juste un log d'avertissement) :
    un sAutoniax qui ne fait QUE de la capture périodique (mode mono-
    profil legacy) ou du Notebook Distant sans template matching reste
    utilisable même si App/mouseData.sqlite3 ou App/service_api.zip
    n'ont encore jamais été poussés par un pilote -- cf. get_mouse_data_
    path/generate_click_duration_ms, déjà tolérants à un fichier
    manquant (repli 5.0s/8.0s fixe, cf. docstring de ces réglages),
    donc rien de plus fragile qu'aujourd'hui si le téléchargement échoue
    ici. Contrairement à _sautoniax_assurer_profil_local (§4.4.c, échec
    = projet refusé), cette fonction ne fait jamais échouer le
    démarrage du sAutoniax lui-même."""

    async def _telecharger_si_absent(cle: str, chemin_destination: Path, libelle: str) -> bool:
        if chemin_destination.exists():
            log.info(f"[sAutoniax] {libelle} déjà présent localement ({chemin_destination}) -- téléchargement ignoré.")
            return True
        log.info(f"[sAutoniax] téléchargement de {libelle} depuis le stockage B2 ({cle})...")
        resultat_telechargement: asyncio.Future = loop.create_future()

        def _sur_resultat(ok: bool, cle_recue: str, message: str):
            if cle_recue == cle and not resultat_telechargement.done():
                loop.call_soon_threadsafe(resultat_telechargement.set_result, (ok, message))

        client_t.telechargement_fichier_resultat.connect(_sur_resultat, Qt.DirectConnection)
        try:
            client_t.telecharger_fichier(cle, str(chemin_destination))
            ok, message = await resultat_telechargement
        finally:
            client_t.telechargement_fichier_resultat.disconnect(_sur_resultat)
        if not ok:
            log.warning(
                f"[sAutoniax] {libelle} indisponible pour l'instant ({message}) -- "
                f"aucun pilote ne l'a encore envoyé via 'Mettre à jour l'app', ou hors ligne."
            )
            chemin_destination.unlink(missing_ok=True)  # repli propre -- jamais un fichier partiel/vide laissé sur place
            return False
        log.info(f"[sAutoniax] {libelle} prêt ({chemin_destination}).")
        return True

    def _telecharger_via_http_bloquant(cle: str, chemin_destination: Path) -> None:
        """CONSERVÉE pour compatibilité de lecture -- désormais un simple
        alias, la logique HTTP-first vit maintenant directement dans
        ClientServeurT._telecharger_fichier (cf. sa docstring : "je veux
        exactement le meme mecanisme de telechargement... fait le pour
        tout"), donc appliquée automatiquement à TOUT appel de
        client_t.telecharger_fichier(), plus seulement à mouseData.
        sqlite3/project.json ici. Non utilisée plus bas -- gardée
        uniquement si un futur appel direct (hors client_t) en a besoin."""
        url_http_base = _url_http_depuis_url_websocket_serveur_t(client_t.server_url)
        url_fichier = f"{url_http_base}/fichier/{cle}"
        requete = urllib.request.Request(url_fichier, method="GET")
        chemin_destination.parent.mkdir(parents=True, exist_ok=True)
        with urllib.request.urlopen(requete, timeout=120) as reponse:
            if reponse.status != 200:
                raise RuntimeError(f"HTTP {reponse.status} en téléchargeant '{cle}'.")
            with open(chemin_destination, "wb") as f:
                shutil.copyfileobj(reponse, f)

    # --- mouseData.sqlite3 : téléchargement direct, aucune extraction --
    # même fichier final que get_mouse_data_path() côté pilote.
    # _telecharger_si_absent appelle client_t.telecharger_fichier(), qui
    # tente désormais le HTTP direct EN PREMIER (cf. ClientServeurT.
    # _telecharger_fichier) avec repli automatique sur l'ancien
    # protocole WebSocket chunké -- rien de plus à faire ici. ---
    await _telecharger_si_absent("App/mouseData.sqlite3", get_mouse_data_path(), "mouseData.sqlite3")

    # --- project.json : téléchargement direct, aucune extraction -- même
    # fichier final que get_project_json_path() côté pilote (AJOUT --
    # retour explicite utilisateur : "je coris uqe projetjson doit donc
    # faire partir des ficher a stocker sur le cloud"). Nécessaire ICI
    # (PAS seulement côté pilote) pour que _construire_composants_direct
    # puisse retrouver les métadonnées Composant (nom, seuil de confiance,
    # zone de clic...) associées aux images déjà présentes dans service_
    # api.zip -- ces métadonnées n'ont JAMAIS existé sous forme de
    # fichiers .json individuels dans service_api.zip (qui ne contient que
    # des .png, cf. investigation service_api.rar), uniquement dans
    # project.json (cf. Project.composants, docstring de classe Project).
    # Même échec NON BLOQUANT que mouseData.sqlite3 ci-dessus : un
    # sAutoniax qui ne fait que du Notebook Distant pur ServiceAPI (sans
    # aucun Composant lié) reste utilisable même si project.json n'a
    # jamais été poussé. Même HTTP-first automatique que mouseData.sqlite3
    # ci-dessus (via _telecharger_si_absent -> client_t.telecharger_
    # fichier). ---
    await _telecharger_si_absent("App/project.json", get_project_json_path(), "project.json")

    # --- service_api.zip : téléchargé puis extrait dans get_service_api_
    # dir() -- ce dossier est déjà créé (mkdir) par get_service_api_dir()
    # elle-même, donc "absent" se vérifie sur son CONTENU plutôt que son
    # existence pure (cf. même garde-fou que _sautoniax_assurer_profil_
    # local : `and any(dossier.iterdir())`). ---
    dossier_service_api = get_service_api_dir()
    if dossier_service_api.exists() and any(dossier_service_api.iterdir()):
        log.info(f"[sAutoniax] dossier service API déjà présent localement ({dossier_service_api}) -- téléchargement ignoré.")
        return
    chemin_zip = Path(tempfile.gettempdir()) / f"sautoniax_service_api_{uuid.uuid4().hex}.zip"
    try:
        ok = await _telecharger_si_absent("App/service_api.zip", chemin_zip, "dossier service API (zip)")
        if not ok:
            return
        log.info(f"[sAutoniax] extraction du dossier service API vers {dossier_service_api}...")
        await loop.run_in_executor(None, shutil.unpack_archive, str(chemin_zip), str(dossier_service_api), "zip")
    finally:
        chemin_zip.unlink(missing_ok=True)


def _sautoniax_appliquer_meta_proxy(nom_profil: str, chemin_meta: Path) -> None:
    """Partie synchrone pure de la synchronisation proxy (parsing du
    meta.json déjà téléchargé + écriture dans le registre local) --
    factorisée pour être appelée à l'identique par _sautoniax_
    synchroniser_proxy_depuis_meta (async, boucle événementielle) et
    _sautoniax_synchroniser_proxy_depuis_meta_bloquant (thread sans
    boucle, cf. leurs docstrings respectives pour le contexte complet).
    Ne lève jamais -- journalise et retourne silencieusement sur tout
    problème (fichier absent/illisible, clé "proxy" absente d'un
    meta.json uploadé avant ce correctif)."""
    try:
        meta = json.loads(chemin_meta.read_text(encoding="utf-8"))
    except (OSError, ValueError) as exc:
        log.warning(f"[sAutoniax] meta.json de '{nom_profil}' illisible ({exc!r}) -- proxy non synchronisé.")
        return
    finally:
        chemin_meta.unlink(missing_ok=True)

    if "proxy" not in meta:
        log.info(
            f"[sAutoniax] meta.json de '{nom_profil}' ne contient pas la clé "
            f"'proxy' (uploadé avant ce correctif) -- proxy non synchronisé, "
            f"le profil démarrera sans proxy tant qu'il n'est pas ré-uploadé "
            f"depuis un mAutoniax à jour."
        )
        return

    proxy = meta.get("proxy")
    config_actuelle = obtenir_config_profil(nom_profil)
    # CORRECTIF (audit de précaution -- "des données supplémentaires
    # oubliées pour qu'un profil transféré fonctionne toujours bien ?") :
    # type_instance/pays/ip doivent être lus depuis LE MEME meta.json
    # cloud que le proxy (source de vérité, cf. son propre correctif),
    # PAS depuis config_actuelle -- avant ce correctif, config_actuelle
    # ÉTAIT la valeur par défaut (CONFIG_PROFIL_PAR_DEFAUT) pour tout
    # profil jamais encore vu sur CETTE instance sAutoniax précise (Kaggle/
    # Colab neuf, ou premier téléchargement de ce profil) : type_instance
    # retombait alors silencieusement à "chrome" (masqué par coïncidence
    # pour les profils déjà connus localement, dont camoufox4 dans nos
    # tests -- déjà téléchargé plusieurs fois avant ce correctif), et
    # pays/ip à None, alors que le meta.json cloud contenait déjà les
    # bonnes valeurs (cf. _sur_demande_envoi_profil côté mAutoniax, qui
    # les inclut toutes les trois). `.get(..., config_actuelle.get(...))`
    # -- repli sur la config locale UNIQUEMENT si la clé est absente du
    # meta (vieux profil uploadé avant CE patch, où meta ne contient pas
    # encore ces 3 clés), jamais si présente mais None (un proxy retiré
    # intentionnellement, par exemple, doit rester None).
    type_instance = meta["type_instance"] if "type_instance" in meta else config_actuelle.get("type_instance")
    pays = meta["pays"] if "pays" in meta else config_actuelle.get("pays")
    ip = meta["ip"] if "ip" in meta else config_actuelle.get("ip")
    enregistrer_config_profil(nom_profil, type_instance or "camoufox", proxy, pays)
    # enregistrer_config_profil (cf. sa propre docstring) n'accepte pas
    # "ip" en paramètre -- écrit séparément ici, même registre, sans
    # perturber le reste de l'entrée qui vient d'être écrite au-dessus.
    if ip is not None:
        configs = charger_registre_profils_config()
        if nom_profil in configs:
            configs[nom_profil]["ip"] = ip
            sauvegarder_registre_profils_config(configs)
    log.info(
        f"[sAutoniax] proxy synchronisé pour le profil '{nom_profil}' depuis "
        f"le meta.json cloud ({'configuré : ' + str(proxy.get('host')) if proxy else 'aucun'}), "
        f"type_instance='{type_instance or 'camoufox'}', pays={pays!r}."
    )


async def _sautoniax_synchroniser_proxy_depuis_meta(
    client_t: "ClientServeurT", loop: asyncio.AbstractEventLoop, nom_profil: str,
) -> None:
    """CORRECTIF (retour utilisateur explicite : "pourquoi le sAutoniax
    pour démarrer un profil n'active pas le proxy s'il y en a", creusé
    jusqu'au bout) : sAutoniax tourne sur une machine jetable (Kaggle/
    Colab), avec son PROPRE profils_config.json local (cf. _chemin_
    donnees/AUTONIAX_DATA_ROOT) -- jamais le même fichier que celui du
    pilote qui a configuré le proxy. obtenir_config_profil(nom_profil)
    appelé côté sAutoniax n'a donc AUCUN moyen de connaître ce proxy,
    quel que soit l'appelant (bouton "Démarrer", Notebook Distant,
    batch E.7, mode legacy --profil) -- ce n'est pas un bug de lecture,
    c'est une absence totale de la donnée à cet endroit.

    Téléchargé et parsé ICI, juste après (ou à la place, si déjà présent
    localement) le téléchargement du zip du profil dans _sautoniax_
    assurer_profil_local -- Profils/<nom>.meta.json contient maintenant
    le proxy RÉEL (cf. son propre correctif, _sur_demande_envoi_profil
    côté pilote : "proxy" ajouté au dict `meta`, plus seulement le
    booléen "proxy_configure" utilisé pour l'affichage). Écrit dans le
    profils_config.json LOCAL de sAutoniax via _sautoniax_appliquer_
    meta_proxy (parsing + écriture factorisés, cf. sa docstring) -- une
    seule fois, au moment du téléchargement, après quoi
    obtenir_config_profil(nom_profil) fonctionne nativement pour TOUS
    les chemins de démarrage (cf. leurs docstrings respectives), sans
    jamais dépendre d'un mAutoniax ouvert au moment du clic "Démarrer".

    Best-effort : un échec ici (meta.json absent -- ancien profil
    uploadé avant ce correctif -- ou téléchargement impossible) est
    journalisé mais ne bloque jamais le démarrage de l'instance, qui se
    contente alors de démarrer sans proxy comme avant ce correctif.

    DÉSACTIVÉ TEMPORAIREMENT (retour utilisateur explicite : "je veux
    que tu desactive la lecture de ce fichier meta.json, sa doit etre
    pour l'instant ignorer") -- ce téléchargement HTTP (GET /fichier/
    Profils/<nom>.meta.json sur serveur.py) déclenché en rafale par un
    démarrage simultané de plusieurs profils sur plusieurs sAutoniax
    (ex. 4 sAutoniax x 5 profils = 20 requêtes quasi simultanées) a été
    identifié comme le déclencheur du crash serveurT -11/SIGSEGV
    observé le 2026-09-10 (concurrence sur le client Google Drive
    partagé côté serveur.py, httplib2 n'étant pas thread-safe). Simple
    retour anticipé : plus aucun appel réseau vers ce fichier tant que
    cette ligne n'est pas retirée. Effet de bord accepté (best-effort
    par design, cf. docstring ci-dessus) : le proxy éventuellement
    configuré dans le meta.json cloud n'est plus resynchronisé --
    chaque profil démarre sans proxy jusqu'à réactivation."""
    log.info(f"[sAutoniax] synchronisation proxy depuis meta.json désactivée pour '{nom_profil}' (temporaire).")
    return

    cle_meta = f"Profils/{nom_profil}.meta.json"
    chemin_meta = Path(tempfile.gettempdir()) / f"sautoniax_meta_proxy_{uuid.uuid4().hex}.json"

    resultat_telechargement: asyncio.Future = loop.create_future()

    def _sur_resultat(ok: bool, cle: str, message: str):
        if not resultat_telechargement.done():
            loop.call_soon_threadsafe(resultat_telechargement.set_result, (ok, message))

    client_t.telechargement_fichier_resultat.connect(_sur_resultat, Qt.DirectConnection)
    try:
        client_t.telecharger_fichier(cle_meta, str(chemin_meta))
        ok, message = await resultat_telechargement
    finally:
        client_t.telechargement_fichier_resultat.disconnect(_sur_resultat)

    if not ok:
        log.info(
            f"[sAutoniax] pas de meta.json pour le profil '{nom_profil}' "
            f"({message}) -- proxy non synchronisé, profil probablement "
            f"uploadé avant ce correctif ou sans meta.json."
        )
        return

    _sautoniax_appliquer_meta_proxy(nom_profil, chemin_meta)


def _sautoniax_synchroniser_proxy_depuis_meta_bloquant(client_t: "ClientServeurT", nom_profil: str) -> None:
    """Équivalent bloquant (threading.Event, même patron que
    _sautoniax_assurer_profil_local_bloquant, cf. sa docstring pour la
    justification -- _Orchestrateur_MappingProfils.lancer_bloquant
    tourne sur un thread SANS boucle asyncio) de _sautoniax_
    synchroniser_proxy_depuis_meta, pour le chemin E.7 (mapping
    profils/sous-projets). Réutilise _sautoniax_appliquer_meta_proxy
    (cf. sa docstring) pour la partie parsing/écriture, identique aux
    deux variantes.

    DÉSACTIVÉ TEMPORAIREMENT -- même correctif et même raison que la
    version async _sautoniax_synchroniser_proxy_depuis_meta (cf. sa
    docstring pour le détail complet) : ce téléchargement du meta.json
    a été identifié comme déclencheur du crash serveurT -11/SIGSEGV du
    2026-09-10 lors d'un démarrage simultané de plusieurs profils."""
    log.info(f"[sAutoniax][E.7] synchronisation proxy depuis meta.json désactivée pour '{nom_profil}' (temporaire).")
    return

    cle_meta = f"Profils/{nom_profil}.meta.json"
    chemin_meta = Path(tempfile.gettempdir()) / f"sautoniax_meta_proxy_{uuid.uuid4().hex}.json"

    evenement = threading.Event()
    resultat: dict = {"ok": False, "message": ""}

    def _sur_resultat(ok: bool, cle: str, message: str):
        if cle == cle_meta:
            resultat["ok"] = ok
            resultat["message"] = message
            evenement.set()

    client_t.telechargement_fichier_resultat.connect(_sur_resultat, Qt.DirectConnection)
    try:
        client_t.telecharger_fichier(cle_meta, str(chemin_meta))
        evenement.wait()
    finally:
        client_t.telechargement_fichier_resultat.disconnect(_sur_resultat)

    if not resultat["ok"]:
        log.info(
            f"[sAutoniax][E.7] pas de meta.json pour le profil '{nom_profil}' "
            f"({resultat['message']}) -- proxy non synchronisé."
        )
        return

    _sautoniax_appliquer_meta_proxy(nom_profil, chemin_meta)


async def _sautoniax_assurer_profil_local(
    client_t: "ClientServeurT", loop: asyncio.AbstractEventLoop, nom_profil: str,
    callback_progression: Optional[callable] = None, forcer: bool = False,
) -> Optional[Path]:
    """Télécharge (si absent localement, ou si `forcer=True`) puis retourne
    le dossier local d'UN profil nommé, depuis le stockage B2 (Profils/
    <nom>.zip) -- factorisation de l'étape 2 de _main_async_sautoniax (mode
    mono-profil historique) pour être réutilisable aussi bien par ce mode
    que par le nouveau mode multi-profils (Patch 4.4.c, cf. _sautoniax_
    traiter_projet_recu). None en cas d'échec de téléchargement --
    l'appelant décide de la sévérité (mono-profil : erreur fatale ;
    multi-profils : ce profil est juste exclu, cf. §4.4.c point 3 : "en cas
    d'échec de démarrage d'un ou plusieurs profils, ne pas lancer
    l'exécution").

    `callback_progression` (PATCH -- barre de progression du téléchargement
    cloud -> sAutoniax déclenché par un pilote, cf. _sautoniax_telecharger_
    profil_vers_sautoniax_demande) : optionnel, appelé avec le même
    pourcentage que le log .debug ci-dessous (-1 = démarrage indéterminé,
    0-100 = progression réelle par chunk reçu). None par défaut -- les
    appelants existants (mono-profil, E.7, notebook distant) n'ont besoin
    d'aucune notification de progression et restent inchangés.

    `forcer` (PATCH -- demande explicite utilisateur : "le bouton qui
    permet de retélécharger un profil vers une instance, actuellement si
    il y a déjà le profil en question dans le stockage de sAutoniax ça va
    refuser de retélécharger et écraser" -- comportement voulu : quand le
    pilote clique EXPLICITEMENT sur le bouton de téléchargement cloud ->
    sAutoniax, l'intention est justement de rapatrier la dernière version
    et d'écraser l'ancienne, pas de réutiliser silencieusement ce qui est
    déjà là). False par défaut -- garde l'idempotence existante (ne pas
    retélécharger inutilement) pour tous les appelants qui ne sont PAS ce
    bouton explicite (démarrage isolé, E.7, mono-profil, notebook distant),
    où retélécharger à chaque démarrage serait un gaspillage de bande
    passante/temps sans bénéfice."""
    dossier_profils_sautoniax = _chemin_donnees("sautoniax_profils")
    dossier_profil = dossier_profils_sautoniax / _nom_dossier_valide(nom_profil)

    if not forcer and dossier_profil.exists() and any(dossier_profil.iterdir()):
        log.info(f"[sAutoniax] profil '{nom_profil}' déjà présent localement ({dossier_profil}) -- téléchargement ignoré.")
        # CORRECTIF (cf. docstring de _sautoniax_synchroniser_proxy_depuis_
        # meta) : le zip local est réutilisé tel quel (comportement voulu,
        # cf. docstring `forcer` ci-dessus), mais le proxy configuré côté
        # cloud a pu changer depuis le dernier téléchargement -- resynchronisé
        # à CHAQUE appel (pas seulement au premier téléchargement), léger
        # (un seul petit fichier JSON) et sans effet si rien n'a changé.
        await _sautoniax_synchroniser_proxy_depuis_meta(client_t, loop, nom_profil)
        return dossier_profil

    if forcer and dossier_profil.exists():
        log.info(f"[sAutoniax] profil '{nom_profil}' déjà présent localement ({dossier_profil}) -- retéléchargement forcé, écrasement.")
        await loop.run_in_executor(None, shutil.rmtree, str(dossier_profil))

    log.info(f"[sAutoniax] téléchargement du profil '{nom_profil}' depuis le stockage B2...")
    cle_profil = f"Profils/{nom_profil}.zip"
    chemin_zip = Path(tempfile.gettempdir()) / f"sautoniax_profil_{uuid.uuid4().hex}.zip"

    resultat_telechargement: asyncio.Future = loop.create_future()

    def _sur_resultat(ok: bool, cle: str, message: str):
        if not resultat_telechargement.done():
            loop.call_soon_threadsafe(resultat_telechargement.set_result, (ok, message))

    def _sur_progression(cle: str, pourcentage: int):
        # PATCH (demande utilisateur explicite -- même raison que le log
        # 'envoyer_capture envoyé au serveurT' ci-dessus) -- passé en
        # DEBUG (pas supprimé) : une ligne par pourcentage/chunk reçu,
        # très bruyant sur un profil volumineux (souvent 2 lignes par %,
        # cf. logs utilisateur). Réactivable via le niveau de logging.
        if pourcentage >= 0:
            log.debug(f"[sAutoniax] téléchargement profil '{nom_profil}' : {pourcentage}%")
        if callback_progression is not None:
            callback_progression(pourcentage)

    client_t.telechargement_fichier_resultat.connect(_sur_resultat, Qt.DirectConnection)
    client_t.telechargement_fichier_progression.connect(_sur_progression, Qt.DirectConnection)
    try:
        client_t.telecharger_fichier(cle_profil, str(chemin_zip))
        ok, message = await resultat_telechargement
    finally:
        client_t.telechargement_fichier_resultat.disconnect(_sur_resultat)
        client_t.telechargement_fichier_progression.disconnect(_sur_progression)

    if not ok:
        log.error(f"[sAutoniax] échec du téléchargement du profil '{nom_profil}' : {message}")
        return None

    log.info(f"[sAutoniax] extraction de l'archive profil '{nom_profil}' vers {dossier_profil}...")
    dossier_profil.mkdir(parents=True, exist_ok=True)
    await loop.run_in_executor(None, shutil.unpack_archive, str(chemin_zip), str(dossier_profil), "zip")
    chemin_zip.unlink(missing_ok=True)
    await loop.run_in_executor(None, diag_verifier_profil_extrait, str(dossier_profil), nom_profil, "async")
    # CORRECTIF (cf. docstring de _sautoniax_synchroniser_proxy_depuis_meta) :
    # le zip ne contient QUE les données du navigateur (cookies, fingerprint
    # camoufox déjà persisté si présent, etc.), jamais la config proxy --
    # celle-ci vit dans le meta.json séparé, synchronisée ici vers le
    # profils_config.json LOCAL de sAutoniax, pour que obtenir_config_profil
    # fonctionne nativement dès ce premier téléchargement.
    await _sautoniax_synchroniser_proxy_depuis_meta(client_t, loop, nom_profil)
    log.info(f"[sAutoniax] profil '{nom_profil}' prêt ({dossier_profil}).")
    return dossier_profil


def _sautoniax_appliquer_service_api_recu(chemin_zip: Path, session_id: str) -> tuple[bool, str]:
    """EXTRAIT (migration "Mettre à jour" vers Drive direct) de l'ancien
    bloc dispatcher "mettre_a_jour_service_api_fin" -- logique
    d'application TELLE QUELLE (dézippage vers dossier temporaire, puis
    remplacement atomique de get_service_api_dir() : ancien dossier
    renommé en *_bak_<session_id> avant, supprimé après succès, restauré
    si shutil.move échoue), désormais réutilisable aussi bien par
    l'ancien chemin (chunks WebSocket, mort après cette migration) que
    par le nouveau (fichier téléchargé directement depuis Drive, cf.
    _sautoniax_retelecharger_et_appliquer_service_api). `chemin_zip` doit
    déjà exister sur disque (peu importe sa provenance) ; `session_id`
    sert uniquement à fabriquer un nom de dossier temporaire/bak unique,
    pas à retrouver un état de réception. Ne touche PAS à chemin_zip lui-
    même (nettoyage à charge de l'appelant, cf. finally des deux
    appelants). Retourne (ok, message_erreur -- vide si ok)."""
    chemin_extrait_tmp = Path(tempfile.gettempdir()) / f"autoniax_service_api_assemble_{session_id}"
    try:
        shutil.unpack_archive(str(chemin_zip), str(chemin_extrait_tmp), "zip")
        chemin_final = get_service_api_dir()
        chemin_ancien_bak = None
        if chemin_final.exists():
            chemin_ancien_bak = chemin_final.with_name(chemin_final.name + f"_bak_{session_id}")
            chemin_final.rename(chemin_ancien_bak)
        try:
            chemin_final.parent.mkdir(parents=True, exist_ok=True)
            shutil.move(str(chemin_extrait_tmp), str(chemin_final))
        except Exception:
            if chemin_ancien_bak is not None and chemin_ancien_bak.exists():
                chemin_ancien_bak.rename(chemin_final)
            raise
        if chemin_ancien_bak is not None and chemin_ancien_bak.exists():
            shutil.rmtree(chemin_ancien_bak, ignore_errors=True)
        log.info(f"[sAutoniax] dossier service API mis à jour localement (session={session_id}) -> {chemin_final}")
        return True, ""
    except Exception as e:
        log.warning(f"[sAutoniax] échec application service API reçu (session={session_id}) : {e!r}")
        return False, str(e)
    finally:
        shutil.rmtree(chemin_extrait_tmp, ignore_errors=True)


def _sautoniax_appliquer_project_json_recu(chemin_recu: Path, session_id: str) -> tuple[bool, str]:
    """EXTRAIT (migration "Mettre à jour" vers Drive direct) de l'ancien
    bloc dispatcher "mettre_a_jour_project_json_fin" -- logique
    d'application TELLE QUELLE (remplacement atomique direct de
    get_project_json_path() via os.replace, avec repli copie+os.replace
    local en cas de cross-device / errno.EXDEV, typique de Kaggle /tmp vs
    /kaggle/working), miroir de _sautoniax_appliquer_service_api_recu
    ci-dessus pour le fichier texte unique project.json (aucun dézippage
    ici). Consomme/déplace `chemin_recu` (il n'existe plus après un
    remplacement réussi, os.replace ayant consommé l'inode) -- le
    `finally` de l'appelant reste néanmoins sûr (unlink avec
    missing_ok=True). Retourne (ok, message_erreur -- vide si ok)."""
    try:
        chemin_final = get_project_json_path()
        chemin_final.parent.mkdir(parents=True, exist_ok=True)
        try:
            # Chemin rapide : marche tant que /tmp et le dossier final
            # sont sur le même montage (cas Colab/local).
            os.replace(str(chemin_recu), str(chemin_final))
        except OSError as e_replace:
            if e_replace.errno != errno.EXDEV:
                raise
            # Cross-device (Errno 18) : copie d'abord sur le même montage
            # que la cible, puis os.replace() local (atomique), avant de
            # nettoyer la source -- cf. docstring historique du bloc
            # mettre_a_jour_project_json_fin (même raisonnement, inchangé).
            chemin_tmp_local = chemin_final.with_name(chemin_final.name + f".tmp_{session_id}")
            shutil.copy2(str(chemin_recu), str(chemin_tmp_local))
            os.replace(str(chemin_tmp_local), str(chemin_final))
            chemin_recu.unlink(missing_ok=True)
        log.info(f"[sAutoniax] project.json mis à jour localement (session={session_id}) -> {chemin_final}")
        return True, ""
    except Exception as e:
        log.warning(f"[sAutoniax] échec application project.json reçu (session={session_id}) : {e!r}")
        return False, str(e)


async def _sautoniax_retelecharger_et_appliquer_service_api(
    client_t: "ClientServeurT", loop: asyncio.AbstractEventLoop, id_pilote: str,
) -> None:
    """AJOUT (migration "Mettre à jour" vers Drive direct -- demande
    explicite utilisateur : "le serveur envoie juste un message de
    retélarchement au sautoniax, il le retélécharge eux même directement
    sur le cloud"). Déclenchée par la réception du signal léger
    "demander_retelechargement_service_api" (cf. _traiter_message,
    dispatcher côté exécutant) : télécharge App/service_api.zip via le
    mécanisme Drive-direct déjà en place (client_t.telecharger_fichier,
    avec repli HTTP/WebSocket automatique en cas d'échec Drive -- patch
    précédent, RÉUTILISÉ tel quel, pas de nouveau chemin de
    téléchargement), même patron Future+callback que
    _sautoniax_assurer_profil_local ci-dessus pour attendre le résultat
    asynchrone, puis applique le fichier reçu via
    _sautoniax_appliquer_service_api_recu (extrait, partagé). Renvoie
    ensuite le résultat au pilote via
    envoyer_mise_a_jour_service_api_resultat (méthode existante,
    inchangée) -- jamais de levée d'exception vers l'appelant
    (asyncio.create_task, cf. dispatcher), toute erreur est capturée et
    transformée en résultat (ok=False, message) envoyé au pilote."""
    session_id = uuid.uuid4().hex[:12]
    chemin_zip = Path(tempfile.gettempdir()) / f"autoniax_service_api_recu_{session_id}.zip"
    resultat_telechargement: asyncio.Future = loop.create_future()

    def _sur_resultat(ok: bool, cle: str, message: str):
        if not resultat_telechargement.done():
            loop.call_soon_threadsafe(resultat_telechargement.set_result, (ok, message))

    client_t.telechargement_fichier_resultat.connect(_sur_resultat, Qt.DirectConnection)
    try:
        client_t.telecharger_fichier(DRIVE_CLE_SERVICE_API_ZIP, str(chemin_zip))
        ok, message = await resultat_telechargement
    except Exception as e:
        ok, message = False, str(e)
    finally:
        client_t.telechargement_fichier_resultat.disconnect(_sur_resultat)

    if not ok:
        log.error(f"[sAutoniax] échec du retéléchargement de service_api.zip : {message}")
        client_t.envoyer_mise_a_jour_service_api_resultat(id_pilote, False, message)
        chemin_zip.unlink(missing_ok=True)
        return

    try:
        ok_application, message_application = await loop.run_in_executor(
            None, _sautoniax_appliquer_service_api_recu, chemin_zip, session_id,
        )
        client_t.envoyer_mise_a_jour_service_api_resultat(id_pilote, ok_application, message_application)
    finally:
        chemin_zip.unlink(missing_ok=True)


async def _sautoniax_retelecharger_et_appliquer_project_json(
    client_t: "ClientServeurT", loop: asyncio.AbstractEventLoop, id_pilote: str,
) -> None:
    """AJOUT -- miroir EXACT de
    _sautoniax_retelecharger_et_appliquer_service_api ci-dessus, pour
    project.json (fichier texte unique, aucun dézippage). Télécharge
    App/project.json via le même mécanisme Drive-direct, puis applique
    via _sautoniax_appliquer_project_json_recu (extrait, partagé), puis
    renvoie le résultat au pilote via
    envoyer_mise_a_jour_project_json_resultat (méthode existante,
    inchangée)."""
    session_id = uuid.uuid4().hex[:12]
    chemin_recu = Path(tempfile.gettempdir()) / f"autoniax_project_json_recu_{session_id}.json"
    resultat_telechargement: asyncio.Future = loop.create_future()

    def _sur_resultat(ok: bool, cle: str, message: str):
        if not resultat_telechargement.done():
            loop.call_soon_threadsafe(resultat_telechargement.set_result, (ok, message))

    client_t.telechargement_fichier_resultat.connect(_sur_resultat, Qt.DirectConnection)
    try:
        client_t.telecharger_fichier(DRIVE_CLE_PROJECT_JSON, str(chemin_recu))
        ok, message = await resultat_telechargement
    except Exception as e:
        ok, message = False, str(e)
    finally:
        client_t.telechargement_fichier_resultat.disconnect(_sur_resultat)

    if not ok:
        log.error(f"[sAutoniax] échec du retéléchargement de project.json : {message}")
        client_t.envoyer_mise_a_jour_project_json_resultat(id_pilote, False, message)
        chemin_recu.unlink(missing_ok=True)
        return

    try:
        ok_application, message_application = await loop.run_in_executor(
            None, _sautoniax_appliquer_project_json_recu, chemin_recu, session_id,
        )
        client_t.envoyer_mise_a_jour_project_json_resultat(id_pilote, ok_application, message_application)
    finally:
        chemin_recu.unlink(missing_ok=True)


async def _sautoniax_tester_proxy(loop: asyncio.AbstractEventLoop, proxy_texte: str) -> tuple[bool, dict]:
    """PATCH (bouton "+" du panneau de propriétés -- dialogue de création
    de profil, bouton "Tester le proxy" -- décision explicite
    utilisateur : "test EN LOCAL par le sAutoniax distant lui-même").
    Parse `proxy_texte` (chaîne brute reçue du pilote via le serveurT,
    cf. demander_tester_proxy_sautoniax côté ClientServeurT) avec
    parser_proxy -- LA MÊME fonction module-level que le dialogue de
    création de profil local (ProfilsInstancesScreen), déjà présente
    dans ce fichier -- puis délègue le test réel à _tester_proxy_sync
    (factorisée de TestProxyWorker, cf. sa docstring), exécutée via
    run_in_executor pour ne jamais bloquer la boucle asyncio de ce
    process sAutoniax (une requête HTTP via un proxy lent/hors service
    peut prendre plusieurs secondes, cf. timeout de 10s dans
    _tester_proxy_sync).

    Retourne (False, {"erreur": ...}) directement, sans solliciter
    _tester_proxy_sync, si `proxy_texte` est vide ou illisible -- même
    distinction que _on_clic_tester_proxy côté UI locale (un champ vide
    ne doit jamais tester la connexion directe du sAutoniax et la faire
    passer pour un succès de proxy)."""
    texte = (proxy_texte or "").strip()
    if not texte:
        return False, {"erreur": "Aucun proxy renseigné -- l'IP réelle du sAutoniax ne sera pas masquée."}
    proxy = parser_proxy(texte)
    if proxy is None:
        return False, {"erreur": "Format de proxy non reconnu -- ex: http://utilisateur:motdepasse@hote:port ou hote:port."}
    return await loop.run_in_executor(None, _tester_proxy_sync, proxy)


# ---------------------------------------------------------------------------
# RÉGÉNÉRATION DU NAVIGATEUR D'UN PROFIL (spec "Régénération du navigateur") --
# remplace l'identité navigateur (empreinte + données de navigation) d'un
# profil SANS toucher à sa config réseau (profils_config.json : proxy, pays,
# IP, proxy natif, badges...) -- même proxy => même sortie réseau, mais
# nouvel appareil (BrowserForge/graine CloakBrowser) au prochain démarrage.
# Fonction PARTAGÉE par le chemin sAutoniax et le Dashboard local.
# ---------------------------------------------------------------------------
_NOM_FINGERPRINT_CAMOUFOX = "camoufox_fingerprint.json"
_NOM_ARCHIVE_FINGERPRINT = "camoufox_fingerprint.previous.json"
_NOM_GRAINE_CLOAKBROWSER = ".cloakbrowser-seed"
_NOM_MARQUEUR_PROFIL = ".autoniax_profil"


def _signature_empreinte_profil(dossier_profil, moteur: str, depuis_archive: bool = False) -> Optional[str]:
    """Signature (sha256) de l'empreinte stockée dans le dossier d'un profil,
    ou None si absente/illisible. Camoufox : config BrowserForge brute
    (cf. _camoufox_extraire_config_brute) ; CloakBrowser : contenu de la
    graine. Deux signatures égales = même empreinte."""
    try:
        dossier = Path(dossier_profil)
        if moteur == "cloakbrowser":
            fichier = dossier / _NOM_GRAINE_CLOAKBROWSER
            if not fichier.is_file():
                return None
            return hashlib.sha256(fichier.read_bytes()).hexdigest()
        fichier = dossier / (_NOM_ARCHIVE_FINGERPRINT if depuis_archive else _NOM_FINGERPRINT_CAMOUFOX)
        if not fichier.is_file():
            return None
        opts = json.loads(fichier.read_text(encoding="utf-8"))
        config = _camoufox_extraire_config_brute(opts)
        if not config:
            return None
        return hashlib.sha256(json.dumps(config, sort_keys=True).encode("utf-8")).hexdigest()
    except (OSError, ValueError, TypeError):
        return None


def _supprimer_chemin_avec_reessais(chemin: Path, tentatives: int = 4, pause_s: float = 0.5) -> Optional[str]:
    """Supprime un fichier ou dossier ; quelques réessais courts (verrous
    Windows juste après l'arrêt du navigateur). Retourne None si réussi,
    sinon le message d'erreur de la dernière tentative."""
    derniere_erreur = None
    for essai in range(tentatives):
        try:
            if chemin.is_dir() and not chemin.is_symlink():
                shutil.rmtree(chemin)
            else:
                chemin.unlink()
            return None
        except FileNotFoundError:
            return None
        except OSError as exc:
            derniere_erreur = f"{exc!r}"
            if essai < tentatives - 1:
                time.sleep(pause_s)
    return derniere_erreur


def regenerer_identite_navigateur_disque(dossier_profil, moteur: str, garder_donnees: bool = False) -> tuple:
    """Prépare, sur disque, le remplacement du navigateur d'un profil --
    le navigateur DOIT être arrêté avant l'appel. `moteur` : "camoufox" ou
    "cloakbrowser". Étapes : (1) signature de l'ancienne empreinte, (2)
    archivage de l'empreinte Camoufox en camoufox_fingerprint.previous.json
    (CloakBrowser : suppression de la graine), (3) si garder_donnees est
    False, suppression de tout le reste du dossier (cookies, stockage,
    historique, cache) sauf le marqueur .autoniax_profil et l'archive, (4)
    marqueur recréé. NE TOUCHE JAMAIS à profils_config.json. L'empreinte
    neuve est générée par le prochain lancement (cf. _camoufox_creer_
    contexte : fichier absent => génération BrowserForge avec le proxy du
    profil). Retourne (ok, message, signature_ancienne|None)."""
    if moteur not in MOTEURS_PLAYWRIGHT:
        return False, "Ce profil n'a pas d'empreinte à régénérer (type Chrome standard).", None
    try:
        dossier = Path(dossier_profil)
    except TypeError:
        return False, "Dossier de profil invalide.", None
    if not dossier.is_dir():
        return False, f"Le dossier du profil est introuvable ({dossier}).", None

    fichier_empreinte = dossier / (_NOM_GRAINE_CLOAKBROWSER if moteur == "cloakbrowser" else _NOM_FINGERPRINT_CAMOUFOX)
    archive = dossier / _NOM_ARCHIVE_FINGERPRINT
    signature_ancienne = _signature_empreinte_profil(dossier, moteur)
    if signature_ancienne is None and moteur == "camoufox":
        # Reprise après un essai précédent interrompu : l'ancienne empreinte est déjà archivée.
        signature_ancienne = _signature_empreinte_profil(dossier, moteur, depuis_archive=True)
    try:
        if moteur == "camoufox" and fichier_empreinte.exists():
            archive.unlink(missing_ok=True)
            fichier_empreinte.replace(archive)
        elif moteur == "cloakbrowser" and fichier_empreinte.exists():
            fichier_empreinte.unlink()
    except OSError as exc:
        return False, f"Impossible de retirer l'ancienne empreinte : {exc}", None

    if not garder_donnees:
        erreurs = []
        for enfant in list(dossier.iterdir()):
            if enfant.name in (_NOM_MARQUEUR_PROFIL, _NOM_ARCHIVE_FINGERPRINT):
                continue
            erreur = _supprimer_chemin_avec_reessais(enfant)
            if erreur:
                erreurs.append(f"{enfant.name} ({erreur})")
        if erreurs:
            return False, (
                f"Nettoyage incomplet ({len(erreurs)} élément(s) non supprimé(s), "
                f"navigateur encore ouvert ?) : {'; '.join(erreurs[:3])}"
            ), signature_ancienne
    try:
        (dossier / _NOM_MARQUEUR_PROFIL).write_text(
            "Profil géré par AutoniaX (navigateur régénéré).\n", encoding="utf-8",
        )
    except OSError as exc:
        return False, f"Impossible de recréer le marqueur du profil : {exc}", signature_ancienne
    log.info(
        f"[profil] identité navigateur réinitialisée -- dossier={dossier} moteur={moteur} "
        f"garder_donnees={garder_donnees} (profils_config.json inchangé : même proxy)."
    )
    return True, "", signature_ancienne


async def _sautoniax_creer_profil(
    loop: asyncio.AbstractEventLoop, nom_profil: str, type_instance: str, proxy_texte: str,
    contraintes: Optional[dict] = None,
) -> tuple[bool, str]:
    """PATCH (bouton "+" du panneau de propriétés de l'onglet "Instances
    sAutoniax" -- demande explicite utilisateur : "je veux que desormais
    on puisse creer un profils [...] lorsque onclic sur ce bouon, il ya
    exactement un fenetre de dialogue [...] noms du profils, type de
    profils, donnnee proxy"). Crée le dossier PERSISTANT du nouveau
    profil sous sautoniax_profils/<nom> (MÊME registre que celui scanné
    par _sur_profils_sautoniax_demande/_sautoniax_assurer_profil_local --
    PAS DOSSIER_RACINE_PROFILS, qui lui sert au Dashboard LOCAL du pilote,
    un espace de noms entièrement distinct) puis enregistre sa config
    (type_instance/proxy) via enregistrer_config_profil, qui écrit dans
    LE PROPRE profils_config.json de CE PROCESS sAutoniax -- exactement
    le même fichier déjà lu par obtenir_config_profil au démarrage d'un
    profil réseau (cf. _sautoniax_demarrer_profil_isole), donc aucun
    nouveau mécanisme de lecture à ajouter côté démarrage.

    Refuse si le dossier existe déjà et n'est pas vide (cf. même critère
    que _sur_profils_sautoniax_demande : un dossier non vide = un profil
    déjà présent) -- jamais d'écrasement silencieux d'un profil existant,
    même raisonnement que creer_ou_obtenir_profil côté Dashboard local.

    PAS de démarrage automatique ici (décision explicite utilisateur :
    "creer seulement, reste inactif, le bouton Demarrer existant sen
    charge ensuite") -- le profil créé apparaîtra "Inactif" au prochain
    _sur_profils_sautoniax_demande, démarrable ensuite via le bouton
    Démarrer déjà existant (_sur_demarrer_profil_isole_demande).

    Retourne (True, "") en cas de succès, (False, message_erreur) sinon
    -- jamais d'exception laissée remonter à l'appelant (cf. try/except
    autour de l'écriture disque), pour toujours répondre au pilote
    demandeur plutôt que de le laisser sans résultat.

    `contraintes` (AJOUT, spec A.4) : dict de contraintes de résolution
    d'écran (cf. parser_contraintes_generation_profil côté pilote),
    écrit tel quel dans profils_config.json via enregistrer_config_profil
    -- n'a d'effet qu'au tout premier lancement réel de ce profil, cf.
    _camoufox_construire_config_lancement."""
    nom_profil = (nom_profil or "").strip()
    if not nom_profil:
        return False, "Le nom du profil est requis."
    if type_instance not in TYPES_INSTANCE_VALIDES:
        type_instance = "chrome"

    proxy = None
    texte_proxy = (proxy_texte or "").strip()
    if texte_proxy:
        proxy = parser_proxy(texte_proxy)
        if proxy is None:
            return False, "Format de proxy non reconnu -- ex: http://utilisateur:motdepasse@hote:port ou hote:port."

    def _creer_dossier_sync() -> tuple[bool, str]:
        dossier_profils_sautoniax = _chemin_donnees("sautoniax_profils")
        dossier_profil = dossier_profils_sautoniax / _nom_dossier_valide(nom_profil)
        if dossier_profil.exists() and any(dossier_profil.iterdir()):
            return False, f"Le profil '{nom_profil}' existe déjà sur cet exécutant."
        try:
            dossier_profil.mkdir(parents=True, exist_ok=True)
            # Un dossier de profil VIDE ne compte jamais comme "présent"
            # pour le scan _sur_profils_sautoniax_demande (cf. son
            # critère any(p.iterdir())) -- un petit fichier marqueur est
            # donc nécessaire pour que ce profil fraîchement créé
            # apparaisse bien dans la liste avant même son premier
            # lancement Camoufox (qui, lui, peuplera le dossier de ses
            # propres fichiers de profil navigateur au premier démarrage).
            (dossier_profil / ".autoniax_profil").write_text(
                f"Profil '{nom_profil}' créé via le panneau de propriétés (Instances sAutoniax).\n",
                encoding="utf-8",
            )
        except OSError as e:
            return False, f"Échec de création du dossier local : {e}"
        return True, ""

    ok, message = await loop.run_in_executor(None, _creer_dossier_sync)
    if not ok:
        return False, message

    enregistrer_config_profil(nom_profil, type_instance, proxy, None, contraintes or {})
    log.info(
        f"[sAutoniax] profil '{nom_profil}' créé localement (type={type_instance}, proxy={'oui' if proxy else 'non'})."
    )
    return True, ""


async def _sautoniax_supprimer_profil(
    loop: asyncio.AbstractEventLoop, nom_profil: str,
    profil_actif: bool,
) -> tuple[bool, str]:
    """PATCH (bouton "Supprimer tous les profils" du panneau de
    propriétés de l'onglet "Instances sAutoniax" -- demande explicite
    utilisateur : "je veux que tu ajoute un bouton pour suprimer tout
    les profils"). Symétrique EXACT de _sautoniax_creer_profil (même
    registre sautoniax_profils/<nom>, même profils_config.json partagé
    via supprimer_config_profil) : supprime le dossier PERSISTANT du
    profil sur CET exécutant ainsi que son entrée de config le cas
    échéant.

    `profil_actif` est calculé par l'APPELANT (cf. _sur_supprimer_
    profil_demande) à partir des mêmes trois registres que _sur_kill_
    profil_demande (profil_charge / _instances_isolees / moteur batch)
    -- cette fonction refuse toujours de supprimer un profil actif :
    jamais de suppression du dossier --user-data-dir d'un Camoufox
    encore ouvert dessus (même principe de sécurité que la docstring de
    supprimer_profil() -- registre local du Dashboard -- qui délègue
    cette vérification à son appelant). Le pilote doit arrêter le
    profil (Kill) avant de pouvoir le supprimer.

    Retourne (True, "") en cas de succès, (False, message_erreur) sinon
    -- jamais d'exception laissée remonter à l'appelant, même patron que
    _sautoniax_creer_profil."""
    nom_profil = (nom_profil or "").strip()
    if not nom_profil:
        return False, "Le nom du profil est requis."
    if profil_actif:
        return False, f"Le profil '{nom_profil}' est actuellement actif -- arrête-le (Kill) avant de le supprimer."

    def _supprimer_dossier_sync() -> tuple[bool, str]:
        dossier_profils_sautoniax = _chemin_donnees("sautoniax_profils")
        dossier_profil = dossier_profils_sautoniax / _nom_dossier_valide(nom_profil)
        if not dossier_profil.exists():
            return False, f"Le profil '{nom_profil}' n'existe pas sur cet exécutant."
        try:
            shutil.rmtree(dossier_profil)
        except OSError as e:
            return False, f"Échec de suppression du dossier local : {e}"
        return True, ""

    ok, message = await loop.run_in_executor(None, _supprimer_dossier_sync)
    if not ok:
        return False, message

    supprimer_config_profil(nom_profil)
    log.info(f"[sAutoniax] profil '{nom_profil}' supprimé localement.")
    return True, ""


async def _sautoniax_dupliquer_profil(
    loop: asyncio.AbstractEventLoop, nom_source: str, noms_cibles: list[str],
    profil_source_actif: bool,
) -> tuple[bool, str]:
    """AJOUT (demande explicite utilisateur : \"je veux pouvoir dupliquer un
    profil cible, et non regenerer d'autres profils de facon aleatoire\").
    Copie RÉCURSIVEMENT le dossier PERSISTANT d'un profil existant
    (sautoniax_profils/<nom_source>, cookies + fingerprint Camoufox déjà
    peuplés) vers N nouveaux dossiers sautoniax_profils/<nom_cible> -- pour
    obtenir des profils IDENTIQUES au profil source (même fingerprint,
    même config), contrairement à _sautoniax_creer_profil qui crée un
    dossier vide au fingerprint aléatoire.

    Même patron de sécurité que _sautoniax_creer_profil / _sautoniax_
    supprimer_profil :
    - refuse si le profil source est actif (son --user-data-dir peut être
      en cours d'écriture par Camoufox -- copie incohérente possible) ;
    - refuse si un profil cible existe déjà (jamais d'écrasement silencieux) ;
    - tout le travail disque se fait dans un executor (boucle non gelée).

    La config (type_instance/proxy/contraintes) du profil source est relue
    via obtenir_config_profil puis réenregistrée pour chaque cible, pour que
    les copies démarrent avec exactement le même paramétrage.

    CORRECTIF #1 -- collision de nommage (retour utilisateur : "concenrnant
    la duplication sa ne fotnionne pas ... idiot je ne veux plus de problem
    de path ou de nomage" -- capture d'écran : "Échec de la duplication de
    'beauty' : Le profil 'iaX1' existe déjà sur cet exécutant") : le nom
    cible 'iaX1' est calculé CÔTÉ PILOTE, à partir de son dernier scan connu
    (cf. docstring PanneauProprietesSautoniax._prochains_noms_iax, "un
    TOCTOU reste possible") -- un renommage ('iaX1' -> 'beauty') fait sur
    cet exécutant sans que le pilote ait rafraîchi depuis suffit à ce qu'il
    propose un indice qu'il croit libre mais qui ne l'est pas RÉELLEMENT.
    Plutôt que de faire confiance à `noms_cibles`, l'exécutant est
    désormais la SEULE source de vérité pour le nommage : un nom cible au
    format 'iaX{n}' (motif EXACT de _prochains_noms_iax côté pilote,
    insensible à la casse) qui entre en collision avec un dossier déjà
    présent est transparemment remplacé par le prochain indice 'iaX{n}'
    RÉELLEMENT libre sur CE disque, sans jamais échouer pour ce seul motif.
    Un nom "manuel" (hors de ce format, ex. renommé à la main) en collision
    reste un refus explicite -- aucun indice évident à incrémenter, et un
    renommage silencieux d'un nom choisi par l'utilisateur serait surprenant.

    CORRECTIF #2 -- échec de copie sur fichier transitoire (retour
    utilisateur, seconde capture d'écran : "Échec de copie vers 'iaX2' :
    [...]/beauty/lock -> [...]/iaX2/lock, [Errno 2] No such file or
    directory") : 'lock' n'est écrit nulle part par CE code -- c'est un
    fichier que Camoufox/Firefox dépose et retire lui-même dans le dossier
    de profil (comportement standard des navigateurs Gecko), y compris
    alors que le profil est affiché "Inactif" côté pilote (ex. un
    sous-processus qui vient tout juste de se terminer, ou un scan
    antivirus/indexeur qui le touche brièvement). shutil.copytree()
    n'est PAS résilient à un fichier qui disparaît entre le moment où il
    liste le dossier source et le moment où il le copie -- il lève
    FileNotFoundError (Errno 2) et abandonne toute la copie. _copier_
    arbre_resilient ci-dessous fait sa propre copie récursive, fichier
    par fichier, et ignore silencieusement (avec un simple log.debug)
    tout fichier introuvable au moment précis de sa copie -- un profil
    dupliqué sans son fichier 'lock' (ou tout autre fichier temporaire du
    même genre) reste un profil parfaitement fonctionnel, Camoufox le
    recrée de toute façon à son prochain lancement.

    Retourne (True, "") si TOUTES les copies réussissent, (False, message)
    sinon -- en cas d'échec partiel, les copies déjà créées sont conservées
    (le pilote voit ainsi précisément lesquelles existent via la liste).
    Le nom RÉELLEMENT utilisé pour chaque cible (après renumérotation
    éventuelle) est journalisé en fin de fonction, pour que la
    correspondance nom-demandé -> nom-réel reste traçable même si elle
    diffère de ce que le pilote avait proposé."""
    nom_source = (nom_source or "").strip()
    noms_cibles = [(n or "").strip() for n in noms_cibles]
    if not nom_source:
        return False, "Le nom du profil source est requis."
    if not noms_cibles or any(not n for n in noms_cibles):
        return False, "Aucun nom de profil cible valide."
    if len(set(noms_cibles)) != len(noms_cibles):
        return False, "Deux profils cibles portent le même nom."
    if nom_source in noms_cibles:
        return False, f"Le nom cible '{nom_source}' est déjà celui du profil source."
    if profil_source_actif:
        return False, f"Le profil '{nom_source}' est actuellement actif -- arrête-le (Kill) avant de le dupliquer."

    motif_iax = re.compile(r"^iaX(\d+)$", re.IGNORECASE)

    def _copier_arbre_resilient(source: Path, cible: Path) -> None:
        """CORRECTIF #2, cf. docstring ci-dessus -- remplace shutil.
        copytree(source, cible) par une copie récursive maison qui
        ignore un fichier/dossier disparu ENTRE le listage de son parent
        et sa copie (FileNotFoundError), au lieu de laisser cette race
        condition faire échouer toute la duplication. Toute autre erreur
        (permissions, disque plein...) reste levée telle quelle -- seule
        l'absence pure et simple du fichier au moment de le copier est
        tolérée."""
        cible.mkdir(parents=True, exist_ok=True)
        try:
            entrees = list(source.iterdir())
        except FileNotFoundError:
            return
        for entree in entrees:
            dest = cible / entree.name
            try:
                if entree.is_symlink():
                    lien = os.readlink(entree)
                    os.symlink(lien, dest)
                elif entree.is_dir():
                    _copier_arbre_resilient(entree, dest)
                else:
                    shutil.copy2(entree, dest)
            except FileNotFoundError:
                # Fichier/dossier disparu entre le listage ci-dessus et
                # sa copie (ex. 'lock' Camoufox/Firefox) -- ignoré, cf.
                # CORRECTIF #2.
                log.debug(f"[sAutoniax] duplication : '{entree}' disparu pendant la copie, ignoré.")
                continue

    def _dupliquer_sync() -> tuple[bool, str, dict[str, str]]:
        dossier_profils_sautoniax = _chemin_donnees("sautoniax_profils")
        dossier_source = dossier_profils_sautoniax / _nom_dossier_valide(nom_source)
        if not dossier_source.exists() or not any(dossier_source.iterdir()):
            return False, f"Le profil source '{nom_source}' n'existe pas ou est vide sur cet exécutant.", {}

        def _dossier_occupe(nom: str) -> bool:
            d = dossier_profils_sautoniax / _nom_dossier_valide(nom)
            return d.exists() and any(d.iterdir())

        # Indices iaX{n} déjà occupés sur CE disque (RÉEL, pas la copie
        # potentiellement périmée du pilote) -- cf. CORRECTIF #1.
        indices_occupes = set()
        if dossier_profils_sautoniax.exists():
            for p in dossier_profils_sautoniax.iterdir():
                if p.is_dir() and any(p.iterdir()):
                    m = motif_iax.match(p.name)
                    if m:
                        indices_occupes.add(int(m.group(1)))

        noms_deja_attribues = set()  # cibles de CETTE requête (y compris renumérotées), pour éviter toute collision interne
        noms_reels: dict[str, str] = {}  # nom demandé -> nom réellement utilisé
        for nom_cible in noms_cibles:
            nom_final = nom_cible
            m = motif_iax.match(nom_cible)
            if m and (_dossier_occupe(nom_final) or nom_final in noms_deja_attribues):
                indice = max(indices_occupes, default=0) + 1
                nom_final = f"iaX{indice}"
                while _dossier_occupe(nom_final) or nom_final in noms_deja_attribues:
                    indice += 1
                    nom_final = f"iaX{indice}"
                indices_occupes.add(indice)
            elif not m and (_dossier_occupe(nom_final) or nom_final in noms_deja_attribues):
                # Nom "manuel" (hors format iaX{n}) déjà pris -- aucun
                # indice évident à incrémenter, refus explicite comme avant.
                return False, f"Le profil '{nom_cible}' existe déjà sur cet exécutant.", {}
            noms_deja_attribues.add(nom_final)
            noms_reels[nom_cible] = nom_final

        for nom_cible, nom_final in noms_reels.items():
            dossier_cible = dossier_profils_sautoniax / _nom_dossier_valide(nom_final)
            try:
                if dossier_cible.exists():
                    shutil.rmtree(dossier_cible)
                _copier_arbre_resilient(dossier_source, dossier_cible)
            except OSError as e:
                return False, f"Échec de copie vers '{nom_final}' : {e}", {}
        return True, "", noms_reels

    ok, message, noms_reels = await loop.run_in_executor(None, _dupliquer_sync)
    if not ok:
        return False, message

    config_source = obtenir_config_profil(nom_source)
    for nom_final in noms_reels.values():
        enregistrer_config_profil(
            nom_final,
            config_source.get("type_instance", "chrome"),
            config_source.get("proxy"),
            config_source.get("pays"),
            config_source.get("contraintes_ecran") or {},
        )
    renommages = {k: v for k, v in noms_reels.items() if k != v}
    if renommages:
        log.info(
            f"[sAutoniax] profil '{nom_source}' dupliqué en {len(noms_reels)} copie(s) : "
            f"{list(noms_reels.values())} (renumérotés pour éviter une collision : {renommages})."
        )
    else:
        log.info(
            f"[sAutoniax] profil '{nom_source}' dupliqué en {len(noms_reels)} copie(s) : {list(noms_reels.values())}."
        )
    return True, ""


_EXECUTEURS_PRETS: dict = {}     # instance_id -> threading.Event posé quand l'exécuteur est connecté (v7)


def _sautoniax_lancer_executeur_isole(instance_id: str, _executeurs_isoles: Optional[dict]):
    """PATCH v7 : lance le process exécuteur d'un profil isolé (même commande que l'ancien lancement paresseux).
    Retourne (Popen, threading.Event « prêt »). L'event est posé quand l'exécuteur affiche EXECUTEUR_PRET
    (connecté au serveur local en role=executeur ET role=pilote). Lève OSError si le lancement échoue."""
    commande = [
        sys.executable, str(SCRIPT_INSTANCE_DASHBOARD),
        "--mode-executeur", "--instance-id", instance_id, "--port", str(PORT_SERVEUR_DASHBOARD),
    ]
    proc = subprocess.Popen(
        commande,
        stdout=subprocess.PIPE, stderr=subprocess.STDOUT, text=True,
        creationflags=FLAGS_DETACHEMENT_PROCESS_WINDOWS,
    )
    pret = threading.Event()
    _EXECUTEURS_PRETS[instance_id] = pret

    def _lire_stdout(p: subprocess.Popen = proc, iid: str = instance_id, ev: threading.Event = pret):
        try:
            for ligne in iter(p.stdout.readline, ""):
                if not ligne:
                    break
                if ligne.strip() == "EXECUTEUR_PRET":
                    ev.set()
                log.info(f"[sAutoniax][executeur:{iid}] {ligne.rstrip()}")
        except (ValueError, OSError):
            pass
    threading.Thread(target=_lire_stdout, name=f"sautoniax-lecture-stdout-executeur-{instance_id}", daemon=True).start()
    if _executeurs_isoles is not None:
        _executeurs_isoles[instance_id] = proc
    log.info(f"[sAutoniax] exécuteur '{instance_id}' lancé (PID {proc.pid}).")
    return proc, pret


async def _sautoniax_demarrer_profil_isole(
    client_t: "ClientServeurT", loop: asyncio.AbstractEventLoop, nom_profil: str, id_pilote: str,
    _instances_isolees: dict, _procs_isoles: dict,
    callback_instance_prete: Optional[Callable[[str], None]] = None,
    relais_proxy_local: Optional["RelaisProxyLocal"] = None,
    instance_id_force: Optional[str] = None,
    _executeurs_isoles: Optional[dict] = None,
) -> None:
    """PATCH (Patch 4.2 -- bouton "Démarrer" du panneau propriétés,
    profil isolé SANS ProjetBatch) : télécharge le profil si besoin
    (_sautoniax_assurer_profil_local, réutilisée telle quelle), lance
    Camoufox dessus (_sautoniax_lancer_instance_subprocess, même
    mécanisme que le mode E.7), attend que l'instance soit réellement
    prête (_sautoniax_attendre_instances_pretes, bloquant -- exécuté via
    run_in_executor pour ne pas geler la boucle asyncio), puis répond au
    pilote demandeur. En cas de succès, peuple _instances_isolees/
    _procs_isoles (dicts partagés avec le reste de _main_async_sautoniax,
    mutés ici directement -- même patron que _moteur_batch_courant, un
    seul thread asyncio les touche jamais concurremment).

    PATCH (point 3 -- contrôle à distance réel sur une instance isolée) :
    callback_instance_prete(instance_id), si fourni, est appelée UNE FOIS
    l'instance confirmée prête et juste avant de répondre au pilote --
    cf. son appelant dans _main_async_sautoniax, qui l'utilise pour lier
    (link) cette instance à client_pilote_instances (sans quoi
    srv_gerer_command refuserait toute commande de pilotage vers elle).
    Optionnel (None par défaut) pour ne rien casser des autres appelants
    éventuels de cette fonction qui n'auraient pas ce besoin."""
    dossier_profil = await _sautoniax_assurer_profil_local(client_t, loop, nom_profil)
    if dossier_profil is None:
        client_t.envoyer_demarrer_profil_isole_resultat(
            nom_profil, False, "", "Échec du téléchargement du profil depuis le stockage cloud."
        )
        return

    # AJOUT (régénération depuis une cellule) : instance_id_force réutilise l'instance_id de l'ancien
    # navigateur -- l'exécuteur, son moteur relais et son namespace restent valides tels quels.
    instance_id = instance_id_force or f"sautoniax-isole-{_nom_dossier_valide(nom_profil)}-{uuid.uuid4().hex[:8]}"
    # CORRECTIF (même bug que les deux autres appelants, cf. docstring de
    # _sautoniax_lancer_instance_subprocess) : lire le proxy réellement
    # configuré pour ce profil AVANT de lancer l'instance, au lieu de
    # compter à tort sur un fingerprint qui ne le "porte" jamais tout seul.
    # PATCH (SPEC_proxy_natif_tunnel.md, section 13.4) : passe désormais
    # par _resoudre_proxy_effectif_profil (priorité proxy natif si actif
    # et démarré, sinon repli sur ce même obtenir_config_profil(...)
    # ["proxy"] -- comportement inchangé pour tout profil sans proxy
    # natif).
    # v7 : l'exécuteur de code démarre EN PARALLÈLE du navigateur (≈17 s chacun) au lieu d'après lui.
    proc_exec, pret_exec = None, None
    if _executeurs_isoles is not None:
        proc_exec = _executeurs_isoles.get(instance_id)
        if proc_exec is None or proc_exec.poll() is not None:
            try:
                proc_exec, pret_exec = _sautoniax_lancer_executeur_isole(instance_id, _executeurs_isoles)
            except OSError as e:
                log.error(f"[sAutoniax] exécuteur '{instance_id}' : lancement impossible : {e!r}")
                proc_exec = None

    def _abandonner_executeur():
        if _executeurs_isoles is not None and pret_exec is not None and proc_exec is not None:
            try:
                proc_exec.terminate()
            except OSError:
                pass
            _executeurs_isoles.pop(instance_id, None)

    proxy_profil = await _resoudre_proxy_effectif_profil(nom_profil, relais_proxy_local)
    proc = await loop.run_in_executor(
        None, _sautoniax_lancer_instance_subprocess, nom_profil, str(dossier_profil), instance_id, proxy_profil,
    )
    if proc is None:
        _abandonner_executeur()
        client_t.envoyer_demarrer_profil_isole_resultat(
            nom_profil, False, "", f"Échec de démarrage de l'instance pour le profil '{nom_profil}'."
        )
        return

    ok_pret, message_pret = await loop.run_in_executor(
        None, _sautoniax_attendre_instances_pretes, [instance_id], threading.Event(),
    )
    if not ok_pret:
        log.error(f"[sAutoniax] instance isolée '{instance_id}' jamais prête (profil '{nom_profil}') : {message_pret}")
        try:
            proc.terminate()
        except OSError:
            pass
        _abandonner_executeur()
        client_t.envoyer_demarrer_profil_isole_resultat(nom_profil, False, "", message_pret)
        return

    # PATCH v7 : un profil n'est « actif » (donc visible/utilisable dans le panneau clone) que si son EXÉCUTEUR est prêt.
    # Avant : actif dès que le navigateur était prêt, l'exécuteur étant lancé à la 1re cellule (~10 s) -> « exécuteur introuvable ».
    if pret_exec is not None:
        if True:
            def _attendre_pret(ev=pret_exec, p=proc_exec):
                fin = time.monotonic() + 120.0
                while time.monotonic() < fin:
                    if ev.wait(0.5):
                        return True
                    if p.poll() is not None:
                        return False
                return False
            exec_pret = await loop.run_in_executor(None, _attendre_pret)
            if not exec_pret:
                log.error(f"[sAutoniax] exécuteur '{instance_id}' jamais prêt (profil '{nom_profil}') -- démarrage annulé.")
                for _p in (proc_exec, proc):
                    try:
                        _p.terminate()
                    except (OSError, AttributeError):
                        pass
                _executeurs_isoles.pop(instance_id, None)
                client_t.envoyer_demarrer_profil_isole_resultat(
                    nom_profil, False, "", "L'exécuteur de code du profil ne s'est pas connecté (voir les logs sAutoniax)."
                )
                return

    _instances_isolees[nom_profil] = instance_id
    _procs_isoles[instance_id] = proc
    # PATCH (cf. docstring de _sautoniax_fichier_pids_isoles) -- registre
    # persistant sur disque, en plus de _procs_isoles en mémoire : c'est
    # ce qui permet à la PROCHAINE génération du process sAutoniax (après
    # un redémarrage) de retrouver et fermer ce PID, alors que
    # _procs_isoles lui-même ne survit jamais à un redémarrage.
    _sautoniax_enregistrer_pid_isole(instance_id, proc.pid)
    log.info(f"[sAutoniax] profil isolé '{nom_profil}' démarré (instance_id={instance_id!r}, demandé par '{id_pilote}').")
    if callback_instance_prete is not None:
        callback_instance_prete(instance_id)
    client_t.envoyer_demarrer_profil_isole_resultat(nom_profil, True, instance_id, "")


async def _sautoniax_telecharger_profil_vers_sautoniax_demande(
    client_t: "ClientServeurT", loop: asyncio.AbstractEventLoop, nom_profil: str, id_pilote: str,
) -> None:
    """PATCH (Patch 4.2 -- bouton "Envoyer du cloud vers ce sAutoniax" du
    panneau propriétés) : simple enveloppe autour de _sautoniax_assurer_
    profil_local (déjà idempotente) pour répondre au pilote demandeur via
    envoyer_telecharger_profil_vers_sautoniax_resultat -- RELAIS DIRECT
    (id_pilote), pas une diffusion (cf. docstring côté ClientServeurT).

    PATCH (barre de progression) : callback_progression branché sur
    envoyer_telecharger_profil_vers_sautoniax_progression -- le pilote
    demandeur voit la progression réelle du téléchargement, même
    granularité que l'upload pilote -> cloud (envoi_profil_progression)."""
    def _callback_progression(pourcentage: int):
        client_t.envoyer_telecharger_profil_vers_sautoniax_progression(id_pilote, nom_profil, pourcentage)

    dossier_profil = await _sautoniax_assurer_profil_local(client_t, loop, nom_profil, _callback_progression, forcer=True)
    if dossier_profil is None:
        client_t.envoyer_telecharger_profil_vers_sautoniax_resultat(
            id_pilote, nom_profil, False, "Échec du téléchargement du profil depuis le stockage cloud."
        )
        return
    client_t.envoyer_telecharger_profil_vers_sautoniax_resultat(id_pilote, nom_profil, True, "")


# ---------------------------------------------------------------------------
# PATCH E.7 (cf. cahier des charges patchs.md, section E.7, et clarification
# utilisateur explicite en session : "pour traiter un sous-projet on démarre
# d'abord son profil avant de l'exécuter dessus" -- décision : PARALLÈLE
# entre profils différents, mais un MÊME profil ne peut jamais tourner sur
# deux sous-projets à la fois (sérialisation stricte par profil), sous un
# plafond global de LIMITE_INSTANCES_PAR_EXECUTANT (30) profils démarrés
# simultanément sur ce sAutoniax -- vérifié LOCALEMENT ici (compteur simple
# en mémoire), PAS par un aller-retour serveur supplémentaire (décision
# utilisateur explicite : le registre serveur existant, cf. serveur.py
# LIMITE_INSTANCES_PAR_EXECUTANT/Registre.nb_instances_totales_sur, est
# pensé pour un lot envoyé d'un coup en amont d'un lancement, pas pour un
# démarrage dynamique profil par profil pendant l'exécution -- reste
# notifié via envoyer_profils_demarres/envoyer_profils_fermes à chaque
# démarrage/fermeture réel, au fil de l'eau, pour que E.6.2 (conflit de
# profil détecté par un AUTRE sAutoniax/pilote) continue de fonctionner
# correctement même avec ce nouveau dispatch).
#
# PÉRIMÈTRE (décision utilisateur explicite) : ce dispatch dynamique
# s'applique UNIQUEMENT côté sAutoniax distant (cette fonction). Le moteur
# local MoteurExecutionBatch (mAutoniax desktop, pool d'instances déjà
# lancées/cochées par l'utilisateur) N'EST PAS MODIFIÉ par ce patch --
# reporté à une session dédiée si le besoin se confirme aussi en local.
#
# Réutilise MoteurExecutionTaskHeadless TEL QUEL pour l'exécution
# cellule-par-cellule d'UN sous-projet sur UNE instance (même moteur que
# MoteurExecutionBatch._sur_instance_prete, même contrat callback(ok,
# message_erreur)) -- ce qui change ici, c'est UNIQUEMENT le dispatch :
# quelle instance traite quel sous-projet, et quand cette instance est
# démarrée/fermée. Aucune notion de pool FIFO partagé : chaque sous-projet
# est déjà assigné à un profil précis via projet_batch.mapping_profils_
# sous_projets (garanti complet à ce stade, vérifié en amont côté pilote --
# cf. clarification utilisateur explicite, aucun sous-projet sans profil
# assigné à gérer ici).
# ---------------------------------------------------------------------------

class _OrchestrateurMappingProfils:
    """Orchestre l'exécution d'un ProjetBatch dont mapping_profils_sous_
    projets est rempli (PATCH E.7) : pour CHAQUE profil distinct du
    mapping, ses sous-projets assignés sont traités SÉQUENTIELLEMENT (un
    seul à la fois pour ce profil précis -- jamais deux instances du même
    profil en même temps, cf. clarification utilisateur explicite) ; les
    files de profils DIFFÉRENTS tournent EN PARALLÈLE entre elles, sous
    réserve du plafond global self.limite_instances (30 par défaut, cf.
    serveur.py LIMITE_INSTANCES_PAR_EXECUTANT).

    Tourne entièrement sur UN thread dédié (appelé via run_in_executor
    par _sautoniax_traiter_projet_recu, même pattern que MoteurExecution
    Batch.lancer() -- ni QApplication ni QEventLoop Qt dans ce mode, cf.
    docstring de main_sautoniax) : un thread par profil (jamais plus, cf.
    _fil_profil ci-dessous), chacun bloquant sur son propre
    threading.Event() pour attendre la fin de MoteurExecutionTaskHeadless
    avant de passer à son sous-projet suivant -- exactement le même
    pattern bloquant que _appliquer_download_dir_bloquant/_sur_instance_
    prete dans MoteurExecutionBatch, simplement multiplié par profil
    plutôt que par instance déjà connectée.

    Notifie le serveurT (envoyer_profils_demarres/fermes) à CHAQUE
    démarrage/fermeture réel d'instance (pas une seule fois en bloc au
    début/à la fin comme l'ancien flux) -- indispensable puisque les
    profils démarrent et se ferment en continu tout au long de
    l'exécution, pas tous ensemble."""

    LIMITE_INSTANCES_PAR_SAUTONIAX = 30  # cf. serveur.py LIMITE_INSTANCES_PAR_EXECUTANT -- même valeur, vérifiée ici localement

    def __init__(
        self, client_t: "ClientServeurT", session_id: str, id_projet_batch: str, nom_projet: str,
        id_pilote: str, project: "Project", task: "Task", annulation_demandee: threading.Event,
        loop: Optional[asyncio.AbstractEventLoop] = None,
        relais_proxy_local: Optional["RelaisProxyLocal"] = None,
    ):
        self.client_t = client_t
        self.session_id = session_id
        self.id_projet_batch = id_projet_batch
        self.nom_projet = nom_projet
        self.id_pilote = id_pilote
        self.project = project
        self.task = task
        self.annulation_demandee = annulation_demandee
        # PATCH (SPEC_proxy_natif_tunnel.md, section 13.4) : cette classe
        # tourne sur un thread dédié (cf. docstring de classe -- run_in_
        # executor, PAS la boucle asyncio principale), donc _resoudre_
        # proxy_effectif_profil (coroutine) ne peut pas être `await`-ée
        # directement ici -- `loop` sert à la déporter via asyncio.
        # run_coroutine_threadsafe (cf. _traiter_un_sous_projet), même
        # patron déjà utilisé ailleurs dans ce fichier pour ce même besoin
        # thread -> boucle asyncio. Optionnels (None par défaut) pour ne
        # rien casser un éventuel appelant qui ne les fournirait pas --
        # dans ce cas, _resoudre_proxy_effectif_profil retombe simplement
        # sur le proxy externe classique (cf. son repli côté relais_
        # proxy_local=None).
        self.loop = loop
        self.relais_proxy_local = relais_proxy_local

        # Compteur local du nombre de profils ACTUELLEMENT démarrés sur ce
        # sAutoniax pour CE traitement -- protégé par self._verrou (accédé
        # depuis plusieurs threads-profil concurrents). Décision explicite
        # utilisateur : vérification LOCALE, pas d'aller-retour serveur.
        self._verrou = threading.Lock()
        self._nb_instances_actives = 0
        self._condition_place_libre = threading.Condition(self._verrou)

        self._instances_par_profil: dict[str, str] = {}  # nom_profil -> instance_id EN COURS (absent si aucune instance active pour ce profil)
        self._procs_en_cours: dict[str, subprocess.Popen] = {}  # instance_id -> Popen, pour fermeture par arreter()
        self._arret_demande = False
        # PATCH (arrêt/redémarrage PAR PROFIL -- demande explicite
        # utilisateur : "je veux que on puisse arreter aussi un profils
        # en execution, que on puisse redemarer un profils", tranchée en
        # granularité RÉELLE, pas au niveau du projet entier comme
        # kill_projet/redemarrer_executant existants). self._verrou
        # protège aussi ces deux structures (mêmes threads-profil
        # concurrents que _nb_instances_actives ci-dessus) :
        # - _profils_stop_demande : noms de profil dont l'ARRÊT a été
        #   demandé (via arreter_profil ci-dessous) -- _fil_profil sort
        #   de sa boucle AVANT le sous-projet suivant de CE profil dès
        #   qu'il y figure, sans toucher aux autres fils de profil (cf.
        #   contraste avec self._arret_demande, global à TOUS les
        #   profils). Un profil qui termine son sous-projet en cours
        #   normalement (ou qui n'en a plus) est retiré de ce set par
        #   _fil_profil lui-même une fois sorti, pour qu'un redémarrage
        #   ultérieur du MÊME profil (nouvelle demande utilisateur) ne
        #   reste jamais bloqué par un arrêt déjà consommé.
        # - _profils_redemarrage_demande : noms de profil dont le
        #   REDÉMARRAGE (pas un simple arrêt) a été demandé -- cf.
        #   redemarrer_profil() : le sous-projet interrompu est remis en
        #   tête de la file propre à ce profil plutôt qu'abandonné, pour
        #   qu'il soit repris depuis le début à la prochaine itération de
        #   _fil_profil (jamais de reprise EN COURS de cellule -- même
        #   granularité que le reste du fichier, cf. arreter() legacy de
        #   MoteurExecutionBatch : la perte de connexion suffit, aucune
        #   tentative de reprise à mi-cellule).
        self._profils_stop_demande: set = set()
        self._profils_redemarrage_demande: set = set()
        # nom_profil -> list[SousProjet] à réinsérer en tête de la file de
        # ce profil suite à un redemarrer_profil() -- protégé par
        # self._verrou_statuts (accédé depuis _traiter_un_sous_projet ET
        # _fil_profil, comme _statuts_par_numero juste au-dessus).
        self._sous_projets_a_reinserer: dict[str, list] = {}

        # Agrégat de statuts pour la progression envoyée au pilote (même
        # format que _sur_sous_projet_maj de _sautoniax_traiter_projet_recu
        # -- réutilisé tel quel côté pilote, aucun changement de contrat).
        self._statuts_par_numero: dict[int, str] = {}
        self._verrou_statuts = threading.Lock()

    def arreter(self):
        """Cf. kill_projet reçu en cours de route -- signale l'arrêt à
        tous les fils de profil (ils sortent à la prochaine vérification,
        entre deux sous-projets, jamais en coupant une exécution de
        cellule déjà en cours -- même granularité que MoteurExecutionBatch.
        arreter()) et termine sans attendre les instances déjà lancées
        (fermées explicitement ici, pas laissées orphelines)."""
        self._arret_demande = True
        with self._condition_place_libre:
            self._condition_place_libre.notify_all()  # réveille les threads en attente d'une place, pour qu'ils sortent tout de suite
        for proc in list(self._procs_en_cours.values()):
            proc.terminate()

    def arreter_profil(self, nom_profil: str, redemarrer: bool = False) -> bool:
        """PATCH (arrêt/redémarrage PAR PROFIL, cf. docstring de
        self._profils_stop_demande) -- symétrique CIBLÉ de arreter()
        ci-dessus : termine UNIQUEMENT le Popen de nom_profil (les autres
        profils/fils continuent sans interruption), et marque son arrêt
        pour que _fil_profil ne relance pas immédiatement un sous-projet
        suivant sur ce même profil à la prochaine itération.

        `redemarrer` (PATCH -- demande explicite utilisateur : "que on
        puisse redemarer un profils") : si True, le sous-projet EN COURS
        au moment de l'appel est remis en tête de la file restante de ce
        profil (cf. _fil_profil) plutôt qu'abandonné -- il sera donc
        repris depuis le début (nouvelle instance, nouvelle exécution
        complète du Task) dès que le fil de ce profil ressort de son
        _traiter_un_sous_projet actuel. Si False (simple arrêt), le
        sous-projet en cours n'est PAS ré-enfilé : il reste tel quel
        (ni "succes" ni "echec" dans son statut.json, même convention que
        arreter() legacy) et ce profil ne traite plus rien pour le reste
        de ce batch, sauf redémarrage explicite ultérieur.

        Retourne False si nom_profil n'a actuellement aucune instance en
        cours (rien à arrêter -- profil déjà inactif ou inconnu de ce
        batch), True si l'ordre a bien été transmis au subprocess."""
        with self._verrou:
            instance_id = self._instances_par_profil.get(nom_profil)
            if instance_id is None:
                return False
            self._profils_stop_demande.add(nom_profil)
            if redemarrer:
                self._profils_redemarrage_demande.add(nom_profil)
            proc = self._procs_en_cours.get(instance_id)
        if proc is not None:
            log.info(
                f"[sAutoniax][E.7] arrêt {'(avec redémarrage) ' if redemarrer else ''}"
                f"demandé pour le profil '{nom_profil}' (instance '{instance_id}')."
            )
            proc.terminate()
        return True

    def _attendre_place_libre(self) -> bool:
        """Bloque jusqu'à ce qu'une place soit disponible sous le plafond
        global, ou que l'arrêt soit demandé. Retourne False si l'appelant
        doit abandonner (arrêt demandé), True s'il peut procéder -- la
        place est réservée (compteur incrémenté) AVANT le retour True,
        symétrique de _liberer_place appelé une fois l'instance fermée."""
        with self._condition_place_libre:
            while not self._arret_demande and self._nb_instances_actives >= self.LIMITE_INSTANCES_PAR_SAUTONIAX:
                self._condition_place_libre.wait(timeout=1.0)
            if self._arret_demande:
                return False
            self._nb_instances_actives += 1
            return True

    def _liberer_place(self):
        with self._condition_place_libre:
            self._nb_instances_actives = max(0, self._nb_instances_actives - 1)
            self._condition_place_libre.notify_all()

    def _construire_variables_pour_sous_projet(self, projet_batch: "ProjetBatch", sous_projet: "SousProjet") -> dict:
        """Copie EXACTE de MoteurExecutionBatch._construire_variables_
        pour_sous_projet (cf. son docstring pour le détail des deux types
        de variables) -- dupliquée ici plutôt qu'appelée sur une instance
        de MoteurExecutionBatch, puisque ce dispatch-ci n'en construit
        justement plus (aucun pool FIFO à orchestrer, cf. docstring de
        classe) ; garder la logique identique est indispensable pour que
        le comportement des Tasks (mapping_variables/variables_
        personnalisees) reste identique quel que soit le dispatch utilisé."""
        variables = {
            nom_variable: (sous_projet.dossier_data / nom_fichier).resolve()
            for nom_variable, nom_fichier in projet_batch.mapping_variables.items()
        }
        for nom_variable in projet_batch.variables_a_personnaliser:
            if nom_variable in projet_batch.variables_personnalisees:
                variables[nom_variable] = projet_batch.variables_personnalisees[nom_variable]
        return variables

    def _emettre_progression(self, numero: int, statut: str, total: int):
        with self._verrou_statuts:
            self._statuts_par_numero[numero] = statut
            traites = sum(1 for s in self._statuts_par_numero.values() if s in ("succes", "echec"))
            en_echec = sum(1 for s in self._statuts_par_numero.values() if s == "echec")
            snapshot = sorted(self._statuts_par_numero.items())
        self.client_t.envoyer_projet_distant_progression(
            self.id_pilote, self.session_id, total, traites, en_echec, total - traites, snapshot,
        )

    def _resoudre_proxy_bloquant(self, nom_profil: str) -> Optional[dict]:
        """PATCH (SPEC_proxy_natif_tunnel.md, section 13.4) -- variante
        bloquante de _resoudre_proxy_effectif_profil pour ce thread dédié
        (cf. docstring de __init__ : self.loop/self.relais_proxy_local).
        Sans `loop` fourni (appelant qui n'a pas encore été mis à jour,
        ou contexte de test), retombe directement sur l'ancien
        comportement (obtenir_config_profil(nom)["proxy"]) plutôt que de
        lever -- ce composant a toujours fonctionné sans proxy natif
        jusqu'ici, aucune régression à introduire pour ce cas limite."""
        if self.loop is None:
            return obtenir_config_profil(nom_profil)["proxy"]
        future = asyncio.run_coroutine_threadsafe(
            _resoudre_proxy_effectif_profil(nom_profil, self.relais_proxy_local), self.loop,
        )
        try:
            return future.result(timeout=5.0)
        except Exception as e:
            log.warning(f"[sAutoniax][E.7] résolution du proxy effectif échouée pour '{nom_profil}' ({e!r}) -- repli sur le proxy externe classique.")
            return obtenir_config_profil(nom_profil)["proxy"]

    def _traiter_un_sous_projet(self, nom_profil: str, dossier_profil: Path, sous_projet: "SousProjet", projet_batch: "ProjetBatch", total: int) -> None:
        """Démarre l'instance pour nom_profil, exécute CE sous-projet
        dessus via MoteurExecutionTaskHeadless (réutilisé tel quel), puis
        ferme l'instance -- bloquant, appelé séquentiellement pour chaque
        sous-projet d'un même profil par _fil_profil ci-dessous."""
        instance_id = f"sautoniax-{self.session_id}-{_nom_dossier_valide(nom_profil)}-{sous_projet.numero}"

        # CORRECTIF (même bug que les deux autres appelants, cf. docstring de
        # _sautoniax_lancer_instance_subprocess) : sans ceci, un batch E.7
        # démarrait chaque instance sans jamais activer le proxy configuré
        # côté cloud pour ce profil.
        # PATCH (SPEC_proxy_natif_tunnel.md, section 13.4) : passe par
        # _resoudre_proxy_bloquant (priorité proxy natif si actif et
        # démarré, cf. son docstring) -- comportement inchangé pour tout
        # profil sans proxy natif.
        proxy_profil = self._resoudre_proxy_bloquant(nom_profil)
        proc = _sautoniax_lancer_instance_subprocess(nom_profil, str(dossier_profil), instance_id, proxy_profil)
        if proc is None:
            log.error(f"[sAutoniax][E.7] échec de démarrage de l'instance pour le profil '{nom_profil}' (sous-projet {sous_projet.numero}).")
            sous_projet.ecrire_statut("echec", f"Échec de démarrage de l'instance pour le profil '{nom_profil}'.")
            self._emettre_progression(sous_projet.numero, "echec", total)
            return
        self._procs_en_cours[instance_id] = proc
        self._instances_par_profil[nom_profil] = instance_id
        if self._callback_instance_demarree is not None:
            self._callback_instance_demarree(instance_id)

        try:
            # self.annulation_demandee est directement compatible (même
            # contrat threading.Event) -- inutile de le relayer via un
            # Event local/thread intermédiaire, cf. signature de
            # _sautoniax_attendre_instances_pretes.
            ok_pret, message_pret = _sautoniax_attendre_instances_pretes([instance_id], self.annulation_demandee)
            if self._arret_demande or self.annulation_demandee.is_set():
                sous_projet.ecrire_statut("echec", "Batch annulé (kill_projet) pendant le démarrage de l'instance.")
                self._emettre_progression(sous_projet.numero, "echec", total)
                return
            if not ok_pret:
                log.error(f"[sAutoniax][E.7] instance '{instance_id}' jamais prête (sous-projet {sous_projet.numero}) : {message_pret}")
                sous_projet.ecrire_statut("echec", message_pret)
                self._emettre_progression(sous_projet.numero, "echec", total)
                return

            self.client_t.envoyer_profils_demarres(self.session_id, self.id_projet_batch, self.nom_projet, [nom_profil])
            self.client_t.envoyer_instances_projet(self.session_id, self.id_pilote, {nom_profil: instance_id})
            self._emettre_progression(sous_projet.numero, "en_cours", total)

            variables = self._construire_variables_pour_sous_projet(projet_batch, sous_projet)
            evenement_fin = threading.Event()
            resultat_fin: dict = {"ok": False, "message": None}

            def _callback_task(task_ok: bool, task_message_erreur: Optional[str]):
                resultat_fin["ok"] = task_ok
                resultat_fin["message"] = task_message_erreur
                evenement_fin.set()

            moteur_task = MoteurExecutionTaskHeadless(
                project=self.project, task=self.task, instance_id=instance_id,
                variables_supplementaires=variables, server_url=SERVER_URL_DASHBOARD,
            )
            moteur_task.lancer(_callback_task)
            evenement_fin.wait()

            # PATCH (arrêt PAR PROFIL, cf. arreter_profil ci-dessus) --
            # si CE profil précis a été explicitement arrêté PENDANT ce
            # sous-projet (proc.terminate() déjà envoyé par
            # arreter_profil, ce qui a fait échouer la cellule en cours
            # par perte de connexion, même mécanisme que arreter() legacy
            # de MoteurExecutionBatch, cf. son docstring) : statut dédié
            # "annule" plutôt que "echec" générique, pour rester
            # identifiable sans ambiguïté côté pilote -- même distinction
            # que _annuler() vs _echouer() dans _sautoniax_traiter_projet_
            # recu. Vérifié APRÈS evenement_fin.wait() (pas avant) car
            # c'est justement ce terminate() qui a débloqué l'attente ici.
            # PATCH (correctif) : on NE VIDE PAS _profils_stop_demande ici
            # -- seule LECTURE. C'est _fil_profil (appelant) qui doit voir
            # encore nom_profil dans ce set à SA prochaine itération pour
            # sortir de sa boucle while (cf. son check `arret_cible`) ; le
            # vider prématurément ici ferait continuer la file comme si
            # de rien n'était pour un arrêt SIMPLE (sans redémarrage),
            # puisque redemarrage_demande=False ne réinsère rien dans
            # _sous_projets_a_reinserer pour justifier l'arrêt autrement.
            # Le nettoyage effectif des deux sets est fait par _fil_profil
            # lui-même, une fois qu'il a consommé l'information (cf. plus
            # bas dans sa boucle), pour ne jamais laisser un arrêt déjà
            # traité bloquer un redémarrage ultérieur du MÊME profil.
            with self._verrou:
                arret_cible_demande = nom_profil in self._profils_stop_demande
                redemarrage_demande = nom_profil in self._profils_redemarrage_demande
                if redemarrage_demande:
                    # Le redémarrage, lui, EST consommé ici : le
                    # sous-projet est sur le point d'être réinséré en
                    # tête de file (ci-dessous) -- laisser ce flag vivant
                    # ferait boucler indéfiniment sur un "redémarrage" qui
                    # n'a plus lieu d'être une fois la reprise enclenchée.
                    self._profils_redemarrage_demande.discard(nom_profil)
            if arret_cible_demande and not resultat_fin["ok"]:
                if redemarrage_demande:
                    # Remis en tête de la file restante de CE profil (cf.
                    # docstring de arreter_profil) -- _fil_profil (appelant)
                    # le reprendra depuis le début à sa prochaine itération,
                    # jamais de reprise à mi-cellule.
                    with self._verrou_statuts:
                        self._sous_projets_a_reinserer.setdefault(nom_profil, []).append(sous_projet)
                    statut = "en_attente"
                    sous_projet.ecrire_statut(statut, "Redémarrage demandé -- sera repris depuis le début.")
                    log.info(f"[sAutoniax][E.7] profil '{nom_profil}' : sous-projet {sous_projet.numero} interrompu pour redémarrage, remis en file.")
                else:
                    statut = "annule"
                    sous_projet.ecrire_statut(statut, "Arrêt demandé par le pilote pour ce profil.")
                    log.info(f"[sAutoniax][E.7] profil '{nom_profil}' : sous-projet {sous_projet.numero} annulé (arrêt ciblé demandé).")
            else:
                statut = "succes" if resultat_fin["ok"] else "echec"
                sous_projet.ecrire_statut(statut, resultat_fin["message"])
                log.info(f"[sAutoniax][E.7] sous-projet {sous_projet.numero} (profil '{nom_profil}') : {statut}" + (f" -- {resultat_fin['message']}" if resultat_fin["message"] else ""))
            self._emettre_progression(sous_projet.numero, statut, total)
        finally:
            self._procs_en_cours.pop(instance_id, None)
            self._instances_par_profil.pop(nom_profil, None)
            proc.terminate()
            self.client_t.envoyer_profils_fermes([nom_profil])
            self._liberer_place()

    def _fil_profil(self, nom_profil: str, dossier_profil: Path, sous_projets: list, projet_batch: "ProjetBatch", total: int) -> None:
        """Traite SÉQUENTIELLEMENT tous les sous-projets assignés à
        nom_profil (triés par numero à l'appel, cf. lancer() ci-dessous)
        -- un seul à la fois pour ce profil, jamais en parallèle avec
        lui-même (cf. clarification utilisateur explicite).

        PATCH (arrêt/redémarrage PAR PROFIL) : self._profils_stop_demande
        est vérifié à CHAQUE itération, exactement comme self._arret_
        demande/annulation_demandee juste en dessous -- un arrêt ciblé
        (sans redémarrage) sur nom_profil retire ce profil de la boucle
        AVANT son sous-projet suivant, sans toucher aux autres fils. Un
        redémarrage éventuel du sous-projet interrompu (cf. _sous_projets_
        a_reinserer, peuplé par _traiter_un_sous_projet) est repris ici en
        PREMIER, avant tout sous-projet restant de la file d'origine --
        cf. boucle while ci-dessous plutôt qu'un simple for, pour pouvoir
        insérer dynamiquement en tête sans réordonner `sous_projets`."""
        file_restante = list(sous_projets)
        while file_restante:
            with self._verrou:
                arret_cible = nom_profil in self._profils_stop_demande and nom_profil not in self._profils_redemarrage_demande
                if arret_cible:
                    # PATCH (correctif) : consommé ICI, pas dans
                    # _traiter_un_sous_projet -- cf. son commentaire. On
                    # sort de la boucle juste après, donc plus besoin de
                    # le garder ; le vider maintenant permet à un
                    # redémarrage ultérieur du MÊME profil (nouvelle
                    # demande utilisateur après cet arrêt) de fonctionner
                    # sans être bloqué par un arrêt déjà traité.
                    self._profils_stop_demande.discard(nom_profil)
            if arret_cible or self._arret_demande or self.annulation_demandee.is_set():
                return
            if not self._attendre_place_libre():
                return  # arrêt demandé pendant l'attente d'une place sous le plafond global
            sous_projet = file_restante.pop(0)
            self._traiter_un_sous_projet(nom_profil, dossier_profil, sous_projet, projet_batch, total)
            # Un redémarrage demandé PENDANT ce sous-projet réinsère sa
            # propre copie en tête de la file restante -- cf. _sous_
            # projets_a_reinserer, peuplé par _traiter_un_sous_projet
            # juste avant que ce fil ne revienne ici.
            with self._verrou_statuts:
                a_reinserer = self._sous_projets_a_reinserer.pop(nom_profil, None)
            if a_reinserer:
                file_restante = a_reinserer + file_restante

    def lancer_bloquant(self, projet_batch: "ProjetBatch", sous_projets_a_traiter: list) -> None:
        """Bloquant -- regroupe sous_projets_a_traiter par profil assigné
        (cf. projet_batch.mapping_profils_sous_projets, garanti complet à
        ce stade), lance UN thread par profil distinct (_fil_profil
        ci-dessus, sérialisé en interne), attend que tous se terminent.
        Clés du mapping en str (cf. docstring du champ) -- str(numero)
        pour la recherche, jamais l'inverse."""
        par_profil: dict[str, list] = {}
        for sous_projet in sous_projets_a_traiter:
            nom_profil = projet_batch.mapping_profils_sous_projets.get(str(sous_projet.numero))
            if not nom_profil:
                # Ne devrait pas arriver ici (mapping garanti complet en
                # amont, cf. docstring de classe) -- filet de sécurité :
                # marqué en échec explicite plutôt qu'oublié silencieusement.
                log.error(f"[sAutoniax][E.7] sous-projet {sous_projet.numero} sans profil assigné dans le mapping -- marqué en échec.")
                sous_projet.ecrire_statut("echec", "Aucun profil assigné à ce sous-projet dans mapping_profils_sous_projets.")
                continue
            par_profil.setdefault(nom_profil, []).append(sous_projet)
        for sous_projets in par_profil.values():
            sous_projets.sort(key=lambda sp: sp.numero)

        total = len(sous_projets_a_traiter)
        for sous_projet in sous_projets_a_traiter:
            self._statuts_par_numero[sous_projet.numero] = sous_projet.statut

        # Téléchargement des profils requis AVANT de lancer les fils --
        # séquentiel (même raisonnement que l'ancienne boucle de
        # _sautoniax_traiter_projet_recu : chaque téléchargement peut être
        # long, autant échouer tôt et clairement plutôt qu'en parallèle
        # dans N fils à la fois). Un profil qui échoue à se télécharger
        # retire TOUS ses sous-projets du lot (marqués en échec) plutôt
        # que de bloquer les autres profils.
        dossiers_par_profil: dict[str, Path] = {}
        for nom_profil in list(par_profil.keys()):
            if self._arret_demande or self.annulation_demandee.is_set():
                # BUGFIX -- un profil restant SANS entrée dans dossiers_
                # par_profil ne doit jamais atteindre la boucne de
                # lancement des fils juste en dessous (KeyError garanti,
                # cf. dossiers_par_profil[nom_profil]) : on le retire ici
                # au lieu d'un simple break, pour que par_profil et
                # dossiers_par_profil restent cohérents entre eux quel
                # que soit le point d'interruption.
                del par_profil[nom_profil]
                continue
            dossier_profil = _sautoniax_assurer_profil_local_bloquant(self.client_t, nom_profil)
            if dossier_profil is None:
                log.error(f"[sAutoniax][E.7] échec de préparation du profil '{nom_profil}' -- {len(par_profil[nom_profil])} sous-projet(s) marqué(s) en échec.")
                for sous_projet in par_profil[nom_profil]:
                    sous_projet.ecrire_statut("echec", f"Échec de préparation du profil '{nom_profil}'.")
                    self._emettre_progression(sous_projet.numero, "echec", total)
                del par_profil[nom_profil]
                continue
            dossiers_par_profil[nom_profil] = dossier_profil

        fils = []
        for nom_profil, sous_projets in par_profil.items():
            fil = threading.Thread(
                target=self._fil_profil,
                args=(nom_profil, dossiers_par_profil[nom_profil], sous_projets, projet_batch, total),
                name=f"orchestrateur-mapping-{nom_profil}",
                daemon=True,
            )
            fils.append(fil)
            fil.start()
        for fil in fils:
            fil.join()


def _sautoniax_assurer_profil_local_bloquant(client_t: "ClientServeurT", nom_profil: str) -> Optional[Path]:
    """Variante BLOQUANTE (thread ordinaire, pas de coroutine) de
    _sautoniax_assurer_profil_local -- nécessaire ici car _Orchestrateur
    MappingProfils.lancer_bloquant tourne sur un thread SANS boucle
    asyncio (cf. docstring de classe : appelé via run_in_executor,
    lui-même déjà hors de la boucle asyncio principale). Même
    comportement/contrat (None en cas d'échec), simplement rejoué avec
    des threading.Event()/callbacks locaux au lieu d'un await."""
    dossier_profils_sautoniax = _chemin_donnees("sautoniax_profils")
    dossier_profil = dossier_profils_sautoniax / _nom_dossier_valide(nom_profil)

    if dossier_profil.exists() and any(dossier_profil.iterdir()):
        log.info(f"[sAutoniax][E.7] profil '{nom_profil}' déjà présent localement ({dossier_profil}) -- téléchargement ignoré.")
        # CORRECTIF (cf. docstring de _sautoniax_synchroniser_proxy_depuis_
        # meta_bloquant) : resynchronisé à chaque appel, même raison que le
        # correctif miroir dans _sautoniax_assurer_profil_local (async).
        _sautoniax_synchroniser_proxy_depuis_meta_bloquant(client_t, nom_profil)
        return dossier_profil

    log.info(f"[sAutoniax][E.7] téléchargement du profil '{nom_profil}' depuis le stockage B2...")
    cle_profil = f"Profils/{nom_profil}.zip"
    chemin_zip = Path(tempfile.gettempdir()) / f"sautoniax_profil_{uuid.uuid4().hex}.zip"

    evenement = threading.Event()
    resultat: dict = {"ok": False, "message": ""}

    def _sur_resultat(ok: bool, cle: str, message: str):
        if cle == cle_profil:
            resultat["ok"] = ok
            resultat["message"] = message
            evenement.set()

    client_t.telechargement_fichier_resultat.connect(_sur_resultat, Qt.DirectConnection)
    try:
        client_t.telecharger_fichier(cle_profil, str(chemin_zip))
        evenement.wait()
    finally:
        client_t.telechargement_fichier_resultat.disconnect(_sur_resultat)

    if not resultat["ok"]:
        log.error(f"[sAutoniax][E.7] échec du téléchargement du profil '{nom_profil}' : {resultat['message']}")
        chemin_zip.unlink(missing_ok=True)
        return None

    log.info(f"[sAutoniax][E.7] extraction de l'archive profil '{nom_profil}' vers {dossier_profil}...")
    dossier_profil.mkdir(parents=True, exist_ok=True)
    try:
        shutil.unpack_archive(str(chemin_zip), str(dossier_profil), "zip")
    except (shutil.ReadError, OSError) as e:
        log.error(f"[sAutoniax][E.7] extraction échouée pour le profil '{nom_profil}' : {e!r}")
        chemin_zip.unlink(missing_ok=True)
        return None
    chemin_zip.unlink(missing_ok=True)
    diag_verifier_profil_extrait(dossier_profil, nom_profil, "bloquant")
    # CORRECTIF (cf. docstring de _sautoniax_synchroniser_proxy_depuis_meta_
    # bloquant) : même raison que le correctif miroir côté async.
    _sautoniax_synchroniser_proxy_depuis_meta_bloquant(client_t, nom_profil)
    log.info(f"[sAutoniax][E.7] profil '{nom_profil}' prêt ({dossier_profil}).")
    return dossier_profil


async def _sautoniax_traiter_projet_recu(
    client_t: "ClientServeurT", loop: asyncio.AbstractEventLoop,
    session_id: str, nom_projet: str, profils: list, chemin_dossier_projet_assemble: str, id_pilote: str,
    serveur_local_proc: Optional[subprocess.Popen], moteur_batch_courant: dict,
    annulation_demandee: threading.Event, instances_legacy_par_profil: dict,
    callback_instance_demarree: Optional[Callable[[str], None]] = None,
    relais_proxy_local: Optional["RelaisProxyLocal"] = None,
) -> None:
    """Traite un projet reçu d'un pilote (Patch 4.4.a/c/d) : télécharge/
    démarre TOUS les profils requis (§4.4.c point 1), vérifie qu'ils
    démarrent tous avec succès avant de lancer le traitement (point 2), et
    en cas d'échec de l'un d'eux, N'EXÉCUTE PAS le projet et remonte
    l'erreur (point 3) -- au lieu de ça, renvoie directement un retour en
    échec (via envoyer_retour_projet_execute d'un dossier contenant juste un
    fichier d'erreur) plutôt que de laisser le pilote sans réponse.

    `chemin_dossier_projet_assemble` (cf. ClientServeurT._traiter_message,
    bloc envoyer_projet_vers_sautoniax_fin) DOIT contenir, à sa racine, un
    project.json au même format que celui sauvegardé par mAutoniax (cf.
    Project.to_dict()/MainWindow._sauvegarder_project ou équivalent) --
    c'est la SEULE façon pour le sAutoniax de connaître le Task et le
    ProjetBatch à exécuter sans dépendre d'un état préexistant. Les
    sous-dossiers numérotés (1/, 2/, ...) sont au même niveau. Convention à
    respecter par l'écran "Projets Distribués" (Patch 4.4.a, pas encore
    implémenté) au moment de construire ce dossier avant l'appel à
    ClientServeurT.envoyer_projet_vers_sautoniax.

    PATCH (point 3 -- contrôle à distance réel) : callback_instance_
    demarree, si fourni, est transmis tel quel à MoteurExecutionBatch.
    _callback_instance_demarree (cf. sa docstring) -- appelé pour CHAQUE
    instance que ce batch démarre, afin que _main_async_sautoniax puisse
    la lier (link) à client_pilote_instances dès qu'elle existe.

    `annulation_demandee` (PATCH -- revue de validation 4.4.c, point 2) :
    threading.Event() partagé avec _sur_kill_projet_demande (cf.
    _main_async_sautoniax), vérifié à chaque étape bloquante DE CETTE
    fonction (téléchargement/lancement de chaque profil) -- avant que
    MoteurExecutionBatch n'existe, c'est le SEUL moyen d'interrompre un
    kill_projet reçu pendant cette phase (potentiellement la plus longue
    du flux entier, cf. §4.2 : "le projet en cours, quel qu'il soit").
    Une fois MoteurExecutionBatch actif, le kill passe par moteur.arreter()
    comme avant -- cet Event n'est alors plus consulté (le batch a sa
    propre gestion d'arrêt).

    `instances_legacy_par_profil` (PATCH -- demande explicite utilisateur :
    un profil lancé via ce flux LEGACY, càd sans mapping_profils_sous_
    projets, n'apparaissait jamais "actif" dans le panneau propriétés de
    l'onglet Instances, cf. _sur_profils_sautoniax_demande) : dict
    partagé avec _main_async_sautoniax, peuplé ci-dessous nom_profil ->
    instance_id juste avant moteur.lancer() (flux legacy uniquement --
    le mode E.7/_OrchestrateurMappingProfils expose déjà son propre
    mapping via _instances_par_profil, pas besoin de doublon ici), vidé
    en bloc à la fin du traitement (succès ou échec) puisque
    MoteurExecutionBatch garde ses instances vivantes pour tout le batch,
    pas seulement le sous-projet en cours."""
    log.info(f"[sAutoniax] projet reçu : '{nom_projet}' (session={session_id}, {len(profils)} profil(s) requis).")
    dossier_projet = Path(chemin_dossier_projet_assemble)
    fichier_project_json = dossier_projet / "project.json"

    def _echouer(message: str):
        log.error(f"[sAutoniax] échec traitement projet '{nom_projet}' (session={session_id}) : {message}")
        client_t.envoyer_statut_executant("erreur")
        try:
            (dossier_projet / "erreur_sautoniax.txt").write_text(message, encoding="utf-8")
        except OSError:
            pass
        client_t.envoyer_retour_projet_execute(session_id, id_pilote, str(dossier_projet), nom_projet)

    def _annuler(instances_a_fermer: dict) -> None:
        # PATCH (revue de validation 4.4.c, point 2) -- distinct de
        # _echouer() : un kill_projet est une décision VOLONTAIRE du
        # pilote, pas un échec technique -- statut/fichier/log différents
        # pour que ce soit identifiable sans ambiguïté côté pilote/logs,
        # même mécanique de retour (envoyer_retour_projet_execute) pour
        # que le pilote ne reste jamais sans réponse.
        log.info(f"[sAutoniax] projet '{nom_projet}' annulé (kill_projet, session={session_id}) -- fermeture des instances déjà lancées.")
        for p in instances_a_fermer.values():
            p.terminate()
        client_t.envoyer_statut_executant("inactif")
        try:
            (dossier_projet / "annule_sautoniax.txt").write_text(
                "Projet annulé (kill_projet reçu pendant le démarrage des profils).", encoding="utf-8",
            )
        except OSError:
            pass
        client_t.envoyer_retour_projet_execute(session_id, id_pilote, str(dossier_projet), nom_projet)

    if not fichier_project_json.exists():
        _echouer(f"project.json absent du dossier de projet reçu ({fichier_project_json}) -- envoi mal formé côté pilote.")
        return
    try:
        project_data = json.loads(fichier_project_json.read_text(encoding="utf-8"))
        project = Project.from_dict(project_data)
    except (json.JSONDecodeError, OSError, TypeError, KeyError) as e:
        _echouer(f"project.json illisible/invalide : {e!r}")
        return

    projet_batch = next((p for p in project.projets_batch if p.nom == nom_projet or p.id == nom_projet), None)
    if projet_batch is None and project.projets_batch:
        # Repli -- un seul ProjetBatch dans le project.json envoyé (cas
        # attendu normal, cf. §4.4.a : l'écran envoie CE ProjetBatch précis,
        # pas tout le Project) : pas besoin que nom_projet corresponde
        # exactement si un seul candidat existe.
        projet_batch = project.projets_batch[0]
    if projet_batch is None:
        _echouer("Aucun ProjetBatch trouvé dans project.json.")
        return
    # chemin_racine doit pointer vers CE dossier reçu (jamais celui d'origine
    # côté pilote, invalide sur cette machine) -- les sous-dossiers numérotés
    # sont au même niveau que project.json, cf. docstring ci-dessus.
    projet_batch.chemin_racine = str(dossier_projet)

    task = project.find_task(projet_batch.task_id)
    if task is None:
        _echouer(f"Task '{projet_batch.task_id}' introuvable dans project.json.")
        return

    # PATCH E.7 -- bascule vers le dispatch dynamique (un profil démarré
    # juste avant l'exécution de SON sous-projet assigné, cf. docstring de
    # _OrchestrateurMappingProfils) dès que mapping_profils_sous_projets
    # est rempli, à la place du flux historique ci-dessous (pool de TOUS
    # les profils démarrés d'un bloc puis partagés en FIFO par
    # MoteurExecutionBatch). Le mapping est garanti complet à ce stade
    # (vérifié en amont côté pilote avant l'envoi, cf. clarification
    # utilisateur explicite) -- un ProjetBatch envoyé sans aucune entrée
    # dans ce dict retombe entièrement sur l'ancien flux, inchangé.
    if projet_batch.mapping_profils_sous_projets:
        sous_projets_a_traiter = [SousProjet.depuis_dossier(d) for d in projet_batch.lister_sous_projets()]
        if not sous_projets_a_traiter:
            _echouer("Aucun sous-projet (dossier numéroté) trouvé dans le projet reçu.")
            return
        client_t.envoyer_statut_executant(f"execution_projet:{nom_projet}")
        orchestrateur = _OrchestrateurMappingProfils(
            client_t=client_t, session_id=session_id, id_projet_batch=projet_batch.id, nom_projet=nom_projet,
            id_pilote=id_pilote, project=project, task=task, annulation_demandee=annulation_demandee,
            loop=loop, relais_proxy_local=relais_proxy_local,
        )
        moteur_batch_courant["moteur"] = orchestrateur  # cf. _sur_kill_projet_demande -- même contrat .arreter(), substituable telle quelle
        await loop.run_in_executor(None, orchestrateur.lancer_bloquant, projet_batch, sous_projets_a_traiter)
        moteur_batch_courant["moteur"] = None
        log.info(f"[sAutoniax][E.7] traitement du projet '{nom_projet}' terminé (session={session_id}).")
        client_t.envoyer_statut_executant("inactif")
        client_t.envoyer_retour_projet_execute(session_id, id_pilote, str(dossier_projet), nom_projet)
        return

    # --- Étape 1/2 : démarrage + vérification de TOUS les profils requis
    # (§4.4.c points 1-2) -- séquentiel plutôt qu'en parallèle : chaque
    # subprocess est lourd (démarrage Camoufox complet), un échec de
    # téléchargement d'un profil ne doit pas laisser les autres à moitié
    # démarrés inutilement si on peut s'arrêter tôt. ---
    client_t.envoyer_statut_executant("demarrage_profils")
    instances_lancees: dict[str, subprocess.Popen] = {}
    instance_id_par_profil: dict[str, str] = {}
    for nom_profil in profils:
        # PATCH (revue de validation 4.4.c, point 2) : vérifié à CHAQUE
        # itération -- entre deux profils est le point naturel pour sortir
        # tôt d'un kill_projet reçu pendant cette phase (potentiellement
        # longue, plusieurs profils enchaînés), sans attendre que le
        # profil suivant démarre inutilement avant de constater l'arrêt.
        if annulation_demandee.is_set():
            _annuler(instances_lancees)
            return
        dossier_profil = await _sautoniax_assurer_profil_local(client_t, loop, nom_profil)
        if dossier_profil is None:
            for p in instances_lancees.values():
                p.terminate()
            _echouer(f"Échec de préparation du profil '{nom_profil}' -- aucun profil ne sera démarré (§4.4.c point 3).")
            return
        if annulation_demandee.is_set():
            # Re-vérifié juste après le téléchargement (peut être long à
            # lui seul) -- même raisonnement, sortir avant de lancer un
            # subprocess Camoufox pour rien.
            _annuler(instances_lancees)
            return
        instance_id = f"sautoniax-{session_id}-{_nom_dossier_valide(nom_profil)}"
        # CORRECTIF (même bug que les deux autres appelants, cf. docstring de
        # _sautoniax_lancer_instance_subprocess) : idem, le proxy configuré
        # côté cloud pour ce profil n'était jamais lu ni transmis ici.
        # PATCH (SPEC_proxy_natif_tunnel.md, section 13.4) : passe par
        # _resoudre_proxy_effectif_profil, coroutine appelable directement
        # ici (même boucle asyncio que relais_proxy_local, contrairement
        # à _OrchestrateurMappingProfils.
        proxy_profil = await _resoudre_proxy_effectif_profil(nom_profil, relais_proxy_local)
        proc = await loop.run_in_executor(
            None, _sautoniax_lancer_instance_subprocess, nom_profil, str(dossier_profil), instance_id, proxy_profil,
        )
        if proc is None:
            for p in instances_lancees.values():
                p.terminate()
            _echouer(f"Échec de démarrage de l'instance pour le profil '{nom_profil}' -- aucun profil ne sera démarré (§4.4.c point 3).")
            return
        instances_lancees[nom_profil] = proc
        instance_id_par_profil[nom_profil] = instance_id

    projet_batch.instances_selectionnees = list(instance_id_par_profil.values())
    # Partagé avec le panneau propriétés (cf. docstring du paramètre
    # instances_legacy_par_profil ci-dessus) -- update() plutôt que
    # réassignation, pour muter le MÊME dict que celui vu par
    # _sur_profils_sautoniax_demande (fermeture partagée avec
    # _main_async_sautoniax, une réassignation locale ici ne serait pas
    # visible depuis l'extérieur de cette fonction).
    instances_legacy_par_profil.update(instance_id_par_profil)
    # PATCH (point 3 -- contrôle à distance réel sur ce pool legacy) :
    # même raisonnement que _sautoniax_demarrer_profil_isole/
    # MoteurExecutionBatch._callback_instance_demarree -- sans ce link,
    # srv_gerer_command refuserait toute commande de pilotage vers ces
    # instances (cf. docstring de _sur_commande_instance_recue côté
    # _main_async_sautoniax, qui route désormais ce cas vers
    # client_pilote_instances).
    if callback_instance_demarree is not None:
        for instance_id_lancee in instance_id_par_profil.values():
            callback_instance_demarree(instance_id_lancee)

    # PATCH (revue de validation 4.4.c, point 1) : attente ACTIVE que
    # chaque instance tout juste lancée (subprocess Camoufox headless,
    # ci-dessus) soit réellement connectée ET libre sur le serveur local,
    # AVANT d'appeler moteur.lancer() -- cf. docstring de
    # _sautoniax_attendre_instances_pretes : sans ça, le
    # TIMEOUT_VERIF_INSTANCES_S de 8s (interne à MoteurExecutionBatch,
    # calibré pour un flux où l'humain a déjà attendu manuellement côté
    # mAutoniax desktop) ferait quasi systématiquement échouer le batch en
    # environnement sAutoniax, où les instances viennent tout juste
    # d'être lancées.
    ok_demarrage, message_demarrage = await loop.run_in_executor(
        None, _sautoniax_attendre_instances_pretes, list(instance_id_par_profil.values()), annulation_demandee,
    )
    if annulation_demandee.is_set():
        _annuler(instances_lancees)
        for nom_profil in instance_id_par_profil:
            instances_legacy_par_profil.pop(nom_profil, None)
        return
    if not ok_demarrage:
        for p in instances_lancees.values():
            p.terminate()
        _echouer(f"Échec de démarrage des instances (§4.4.c point 2/3) : {message_demarrage}")
        for nom_profil in instance_id_par_profil:
            instances_legacy_par_profil.pop(nom_profil, None)
        return

    # PATCH E (E.6.1) -- notifie le serveurT que ces profils sont
    # maintenant "en cours" (cf. ClientServeurT.envoyer_profils_demarres)
    # -- ICI précisément, une fois TOUS les profils confirmés démarrés ET
    # vérifiés réellement prêts (ok_demarrage True), pas avant : placé
    # avant _sautoniax_attendre_instances_pretes, un échec de CETTE
    # vérification aurait laissé les profils marqués "en cours" côté
    # serveur sans jamais être libérés (aucun appel à envoyer_profils_
    # fermes sur ce chemin de sortie anticipée, cf. _annuler/_echouer
    # ci-dessus qui ne notifient pas la fermeture -- ils n'ont jamais
    # notifié le démarrage non plus avec ce placement, donc rien à fuir).
    client_t.envoyer_profils_demarres(session_id, projet_batch.id, nom_projet, list(instance_id_par_profil.keys()))
    # PATCH E.1 -- transmet la table RÉELLE nom_profil -> instance_id au
    # pilote (cf. docstring de ClientServeurT.envoyer_instances_projet
    # pour le pourquoi : "profils_demarres" juste au-dessus ne fait QUE
    # mettre à jour l'état interne du serveurT, jamais relayé au pilote).
    # Best-effort, comme tout ce bloc : un échec de transmission laisse
    # simplement le bouton "Aperçu" indisponible côté pilote pour ce
    # projet, sans jamais faire échouer le traitement réel du batch.
    client_t.envoyer_instances_projet(session_id, id_pilote, instance_id_par_profil)


    # --- Étape 3 : traitement du projet, via MoteurExecutionBatch RÉUTILISÉ
    # TEL QUEL (cf. docstring du bloc de fonctions) -- fait tourner dans un
    # thread dédié car MoteurExecutionBatch.lancer() bloque brièvement
    # (vérification des instances, cf. _verifier_instances_bloquant) et
    # s'appuie sur des signaux Qt en QueuedConnection ; ce mode sAutoniax n'a
    # pas de QEventLoop Qt tournant sur le thread principal (cf. docstring de
    # main_sautoniax), donc les callbacks sont ramenés vers la boucle asyncio
    # via un asyncio.Event, thread-safe par call_soon_threadsafe. ---
    sous_projets_a_traiter = [SousProjet.depuis_dossier(d) for d in projet_batch.lister_sous_projets()]
    if not sous_projets_a_traiter:
        for p in instances_lancees.values():
            p.terminate()
        _echouer("Aucun sous-projet (dossier numéroté) trouvé dans le projet reçu.")
        for nom_profil in instance_id_par_profil:
            instances_legacy_par_profil.pop(nom_profil, None)
        return

    client_t.envoyer_statut_executant(f"execution_projet:{nom_projet}")
    moteur = MoteurExecutionBatch(project=project, projet_batch=projet_batch)
    moteur._callback_instance_demarree = callback_instance_demarree
    moteur_batch_courant["moteur"] = moteur  # cf. _sur_kill_projet_demande, qui lit ce même dict partagé
    batch_termine_event = threading.Event()

    def _sur_batch_termine():
        batch_termine_event.set()
    moteur.batch_termine.connect(_sur_batch_termine, Qt.DirectConnection)

    # PATCH (Patch 4.4.b -- suivi temps réel côté pilote) : agrège le
    # statut de chaque sous-projet (numero -> statut) au fil des
    # sous_projet_maj émis par le moteur, et renvoie l'état complet au
    # pilote à chaque changement. total = nombre de sous-projets réellement
    # soumis à CE lancement (sous_projets_a_traiter, pas tous les dossiers
    # numérotés du projet -- cohérent avec ce que le moteur traite
    # effectivement). Qt.DirectConnection (comme batch_termine ci-dessus) :
    # sous_projet_maj est émis depuis le thread de _lancer_bloquant
    # (run_in_executor), sans QEventLoop Qt tournant dessus -- une
    # QueuedConnection ne serait jamais livrée dans ce mode. Le slot ne
    # fait qu'un calcul local (dict) + un appel réseau déjà thread-safe
    # (envoyer_projet_distant_progression -> run_coroutine_threadsafe),
    # donc sûr en connexion directe.
    statuts_par_numero: dict[int, str] = {sp.numero: sp.statut for sp in sous_projets_a_traiter}

    def _sur_sous_projet_maj(numero: int, statut: str):
        statuts_par_numero[numero] = statut
        traites = sum(1 for s in statuts_par_numero.values() if s in ("succes", "echec"))
        en_echec = sum(1 for s in statuts_par_numero.values() if s == "echec")
        total = len(statuts_par_numero)
        client_t.envoyer_projet_distant_progression(
            id_pilote, session_id, total, traites, en_echec, total - traites,
            sorted(statuts_par_numero.items()),
        )
    moteur.sous_projet_maj.connect(_sur_sous_projet_maj, Qt.DirectConnection)

    def _lancer_bloquant():
        try:
            moteur.lancer(sous_projets_a_traiter, lambda: None)
        except (NonConformiteSousProjetError, InstancesIndisponiblesError) as e:
            log.error(f"[sAutoniax] démarrage du batch refusé (session={session_id}) : {e}")
            batch_termine_event.set()
    await loop.run_in_executor(None, _lancer_bloquant)
    await loop.run_in_executor(None, batch_termine_event.wait)
    moteur_batch_courant["moteur"] = None

    log.info(f"[sAutoniax] traitement du projet '{nom_projet}' terminé (session={session_id}) -- fermeture des instances.")
    for proc in instances_lancees.values():
        proc.terminate()
    client_t.envoyer_statut_executant("inactif")
    # PATCH E (E.6.1) -- symétrique de envoyer_profils_demarres plus haut :
    # ces profils ne sont plus "en cours" une fois toutes leurs instances
    # terminées, quel que soit le résultat (succès ou échec partiel du
    # batch, cf. moteur.lancer ci-dessus) -- libère la place côté serveurT
    # pour un futur lancement (ici ou ailleurs, cf. Registre.profils_deja_
    # utilises côté serveur).
    client_t.envoyer_profils_fermes(list(instance_id_par_profil.keys()))
    # Symétrique de instances_legacy_par_profil.update(...) plus haut --
    # retire précisément LES ENTRÉES DE CE BATCH (pas un .clear() global :
    # même si un seul traitement de projet tourne à la fois par sAutoniax,
    # cf. garde-fou projet_distribue_en_cours côté serveurT, ce dict reste
    # partagé avec _main_async_sautoniax) : ces instances viennent d'être
    # proc.terminate() ci-dessus, plus "actives" pour aucun sens désormais.
    for nom_profil in instance_id_par_profil:
        instances_legacy_par_profil.pop(nom_profil, None)

    # --- Étape 4 (§4.4.d) : retour du dossier de projet complet (profils
    # mis à jour inclus -- cf. dossier_profil téléchargé plus haut sous
    # sautoniax_profils/, jamais recopié DANS dossier_projet : seuls les
    # sous-projets eux-mêmes, déjà mis à jour sur place par MoteurExecution
    # Batch, sont renvoyés). ---
    client_t.envoyer_retour_projet_execute(session_id, id_pilote, str(dossier_projet), nom_projet)


async def _sautoniax_boucle_capture(
    client_t: "ClientServeurT", etat_notebook_distant: dict, instance_id: str,
    etat_capture: dict, capture_ponctuelle_demandee: asyncio.Event,
    arret_demande: asyncio.Event, arret_profil: asyncio.Event,
) -> None:
    """PATCH (correctif -- l'aperçu mono-profil restait vide quand le
    profil était chargé via le bouton "Initialiser" du Notebook Distant
    plutôt que via `--profil` au lancement) : capture_propre (cf.
    action_camoufox_capture_propre) toutes les etat_capture["intervalle_s"]
    secondes, envoyée au serveurT (cf. ClientServeurT.envoyer_capture) --
    EXTRAIT de l'ancien corps de _main_async_sautoniax (étape 4), pour être
    démarrable en tâche de fond aussi bien depuis le chemin legacy
    (`--profil` CLI, où elle est directement `await`-ée) que depuis
    _sautoniax_initialiser_notebook_distant (chargement à la demande, où
    elle est lancée via loop.create_task -- cf. docstring de cette
    dernière). `etat_notebook_distant` est lu à CHAQUE itération (jamais
    capturé une seule fois) pour toujours capturer la `page` actuellement
    active, y compris si "Initialiser" charge un nouveau profil entre-temps
    (cf. remplacement de page/camoufox_cm côté appelant).

    CORRECTIF (retour utilisateur explicite : "cest moi qui doit activer
    le rafraichissement que se soit manuel ou auto" -- la toute première
    version de cette boucle envoyait une capture automatiquement dès que
    Camoufox était prêt, AVANT tout clic sur "Rafraîchir"/case
    "Automatique", cf. logs : `envoyer_capture` parti 1s après
    l'initialisation). Même contrat que etat_stream["actif"] côté
    streaming local (cf. _main_async/_main_async_camoufox, PATCH
    "le rafraîchissement doit être en mode manuel, pas déjà automatique") :
    etat_capture["actif"] DÉMARRE À FALSE (posé par l'appelant), la boucle
    tourne quand même en permanence (jamais arrêtée par l'inactivité) mais
    ne capture/n'envoie RIEN tant qu'elle n'est pas explicitement activée --
    par un fps>0 (cf. action="taux", _sur_regler_capture_instance_demande)
    OU par une capture ponctuelle (action="ponctuelle", laquelle reste
    utilisable même en mode inactif : "Rafraîchir" doit toujours fonctionner
    en mode manuel, capture UNIQUE sans jamais activer le flux continu).

    S'arrête sur SOIT `arret_demande` (arrêt global du process, SIGTERM/
    Ctrl+C) SOIT `arret_profil` (CE profil précis est en train d'être
    remplacé par un autre via "Initialiser" -- propre à chaque appel,
    contrairement à arret_demande qui est partagé par tout le process)."""
    try:
        while not arret_demande.is_set() and not arret_profil.is_set():
            # Capture ponctuelle demandée ("Rafraîchir") OU flux continu
            # actif ("Automatique" coché, fps>0) -- capture_ponctuelle_
            # demandee.is_set() plutôt que .wait() ici : la vraie attente
            # (et le .clear()) a lieu plus bas, ce test synchrone décide
            # juste s'il faut capturer CETTE itération.
            _ponctuelle_demandee = capture_ponctuelle_demandee.is_set()
            doit_capturer = etat_capture.get("actif", False) or _ponctuelle_demandee
            if _mode_silencieux() and not _ponctuelle_demandee:
                # MODE SILENCIEUX : le flux automatique ne capture ni n'envoie rien ;
                # on attend simplement une capture ponctuelle ou l'arrêt.
                doit_capturer = False
            if not doit_capturer:
                # Rien à faire tant qu'aucune activation explicite n'est
                # reçue -- dort jusqu'au prochain événement (arrêt, ou
                # activation via _sur_regler_capture_instance_demande) SANS
                # jamais capturer/envoyer entre-temps, cf. docstring
                # ci-dessus. Pas de timeout ici : contrairement au mode
                # actif, aucune notion d'« intervalle » ne s'applique à une
                # attente purement passive.
                capture_ponctuelle_demandee.clear()
                attente_arret = asyncio.ensure_future(arret_demande.wait())
                attente_arret_profil = asyncio.ensure_future(arret_profil.wait())
                attente_activation = asyncio.ensure_future(capture_ponctuelle_demandee.wait())
                try:
                    await asyncio.wait(
                        {attente_arret, attente_arret_profil, attente_activation},
                        return_when=asyncio.FIRST_COMPLETED,
                    )
                finally:
                    for tache_attente in (attente_arret, attente_arret_profil, attente_activation):
                        if not tache_attente.done():
                            tache_attente.cancel()
                continue

            # BUG CORRIGÉ (logs utilisateur : "échec d'une capture
            # périodique (ignoré) : NavigateurFermeCamoufox('Page.
            # screenshot: Target page, context or browser has been
            # closed')" en boucle infinie après un newTab/resetInterface
            # exécuté PENDANT la session, ex. cellule "Main" relancée) --
            # AVANT ce correctif, cette ligne lisait
            # etat_notebook_distant["page"], une COPIE figée au moment de
            # _sautoniax_initialiser_notebook_distant (cf. son commentaire :
            # "etat_navigateur contient déjà 'page' en interne... pas
            # besoin de dupliquer 'page' séparément ici" -- affirmation
            # correcte, mais cette ligne ne la respectait pas). Or
            # resetInterface/newTab (cf. _executer_commande_camoufox,
            # "etat_navigateur['page'] = nouvel_onglet") ferment l'ancien
            # onglet et mettent à jour UNIQUEMENT etat_navigateur["page"],
            # jamais cette copie -- la boucle continuait donc de
            # screenshoter un onglet fermé, indéfiniment, sans jamais se
            # resynchroniser sur le nouvel onglet réellement actif.
            # Lit maintenant etat_navigateur["page"] (le dict PARTAGÉ,
            # cf. etat_notebook_distant["etat_navigateur"] = etat_navigateur
            # plus haut) en priorité -- repli sur l'ancien champ "page"
            # uniquement si "etat_navigateur" est absent (compatibilité
            # avec un éventuel appelant plus ancien).
            etat_navigateur_courant = etat_notebook_distant.get("etat_navigateur")
            if etat_navigateur_courant is not None:
                page = etat_navigateur_courant.get("page")
            else:
                page = etat_notebook_distant.get("page")
            if page is None:
                # Profil en cours de fermeture/pas encore prêt -- rien à
                # capturer cette itération, on retente au prochain cycle
                # plutôt que de planter la tâche de fond.
                pass
            else:
                try:
                    resultat_capture = await action_camoufox_capture_propre(page)
                    client_t.envoyer_capture(resultat_capture["image_b64"], instance_id)
                    log.debug(f"[sAutoniax] capture envoyée (instance_id={instance_id!r}).")
                except Exception as e:
                    # Une capture ratée (page pas encore chargée, onglet
                    # fermé...) ne doit jamais arrêter toute l'instance --
                    # simple log, on retente à la prochaine itération.
                    log.warning(f"[sAutoniax] échec d'une capture périodique (ignoré) : {e!r}")

            capture_ponctuelle_demandee.clear()
            if not etat_capture.get("actif", False):
                # Capture ponctuelle venant d'être servie, mode toujours
                # inactif -- retour immédiat en attente passive plutôt que
                # d'attendre `intervalle_s` (qui n'a de sens qu'en mode
                # "Automatique") avant de réévaluer doit_capturer.
                continue
            attente_arret = asyncio.ensure_future(arret_demande.wait())
            attente_arret_profil = asyncio.ensure_future(arret_profil.wait())
            attente_ponctuelle = asyncio.ensure_future(capture_ponctuelle_demandee.wait())
            try:
                await asyncio.wait(
                    {attente_arret, attente_arret_profil, attente_ponctuelle},
                    timeout=etat_capture["intervalle_s"], return_when=asyncio.FIRST_COMPLETED,
                )
            finally:
                # Annule proprement les Task non déclenchées -- sans ça,
                # une Task "wait()" jamais awaitée/annulée sur un Event
                # jamais set() s'accumulerait silencieusement à chaque
                # itération (fuite de Task, cf. asyncio.wait qui NE les
                # annule PAS lui-même contrairement à wait_for).
                for tache_attente in (attente_arret, attente_arret_profil, attente_ponctuelle):
                    if not tache_attente.done():
                        tache_attente.cancel()
    except asyncio.CancelledError:
        # Annulation explicite (cf. _sautoniax_initialiser_notebook_distant,
        # remplacement d'un profil par un autre) -- propre, pas une erreur.
        raise


async def _sautoniax_fermer_profil_notebook_distant_charge(
    client_t: "ClientServeurT", etat_notebook_distant: dict, _log,
) -> bool:
    """Arrête + ferme proprement le profil ACTUELLEMENT chargé dans
    `etat_notebook_distant` (Camoufox + sa capture périodique), s'il y en
    a un -- EXTRAIT tel quel de l'ancien corps de _sautoniax_initialiser_
    notebook_distant (PATCH factorisation, cf. docstring d'appel), pour
    être réutilisable à l'identique par :
      - _sautoniax_initialiser_notebook_distant, qui l'appelle EN TÊTE
        avant de charger le nouveau profil demandé (remplacement implicite).
      - _sautoniax_fermer_notebook_distant (bouton "Fermer", PATCH --
        demande explicite utilisateur : "il faut que onlajoute a coter du
        bouton initialiser , la il vas detruit le prfils lancer"), qui
        l'appelle SEULE, sans rien charger derrière (fermeture explicite).

    Ne fait RIEN (silencieusement) si aucun profil n'est chargé --
    `etat_notebook_distant.get("camoufox_cm")` est alors None, cf. appelants
    qui distinguent ce cas ("rien à fermer") d'une vraie fermeture pour
    leur propre message utilisateur/log.

    `_log` : callback `(ligne: str) -> None` pour la progression au fil de
    l'eau (cf. envoyer_initialiser_notebook_distant_log/envoyer_fermer_
    notebook_distant_log côté appelants respectifs -- chacun le sien, cette
    fonction ne connaît PAS quel canal de log utiliser).

    Retourne True si un profil a bien été trouvé et fermé, False si rien
    n'était chargé (permet à _sautoniax_fermer_notebook_distant de
    distinguer les deux pour son propre message de résultat)."""
    ancienne_tache_capture = etat_notebook_distant.get("tache_capture")
    ancien_arret_profil = etat_notebook_distant.get("arret_profil")
    if ancien_arret_profil is not None:
        ancien_arret_profil.set()
    if ancienne_tache_capture is not None and not ancienne_tache_capture.done():
        ancienne_tache_capture.cancel()
        try:
            await ancienne_tache_capture
        except (asyncio.CancelledError, Exception):
            pass

    ancien_cm = etat_notebook_distant.get("camoufox_cm")
    if ancien_cm is None:
        return False

    ancien_profil = etat_notebook_distant.get("profil_charge") or "?"
    _log(f"Fermeture du profil actuellement chargé ('{ancien_profil}')...")
    try:
        await ancien_cm.__aexit__(None, None, None)
    except Exception as e:
        # Non bloquant (cf. même raisonnement que la fermeture finale
        # de _main_async_sautoniax) -- un ancien navigateur déjà mort
        # (crash, page fermée côté distant) ne doit jamais empêcher de
        # considérer la fermeture comme réussie (l'état voulu -- plus de
        # Camoufox actif pour ce profil -- est de toute façon atteint).
        log.debug(f"[sAutoniax] fermeture de l'ancien profil ignorée (probablement déjà fermé) : {e!r}")
    # PATCH (visibilité serveur du profil Notebook Distant -- demande
    # explicite utilisateur : "noublie pas que il ya aussi un progils
    # qui peu etre lancer pour le notebok dexecution en reau ...
    # lajouter au signalement serveur"). Symétrique de profils_fermes
    # envoyé par _OrchestrateurMappingProfils -- ce profil quitte
    # profils_en_cours côté serveur AVANT que le nouveau (s'il y en a
    # un) ne le remplace, jamais deux entrées simultanées pour ce mode
    # mono-profil (cf. docstring de classe : un seul profil chargé à
    # la fois via ce bouton "Initialiser").
    if ancien_profil and ancien_profil != "?":
        client_t.envoyer_profils_fermes([ancien_profil])
    etat_notebook_distant["page"] = None
    etat_notebook_distant["namespace"] = None
    etat_notebook_distant["camoufox_cm"] = None
    etat_notebook_distant["profil_charge"] = None
    etat_notebook_distant["tache_capture"] = None
    etat_notebook_distant["arret_profil"] = None
    etat_notebook_distant["context"] = None
    etat_notebook_distant["gestion"] = None
    etat_notebook_distant["etat_navigateur"] = None
    return True


async def _sautoniax_fermer_notebook_distant(
    client_t: "ClientServeurT", session_id: str, id_pilote: str,
    etat_notebook_distant: dict,
) -> None:
    """PATCH (bouton "Fermer", à côté d'"Initialiser" -- demande explicite
    utilisateur : "un autre soucis ... il faut que au niveau de la barre
    de bouton dans taskscript editor a coter de initialiser il y a bien
    fermer?? ... continue avec le patch ce bouton la n'existe pas je veux
    que on l'ajoute a coter du bouton initialiser , la il vas detruit le
    prfils lancer").

    Jusqu'ici, le SEUL moyen de fermer le profil chargé par "Initialiser"
    était d'en charger un autre par-dessus (fermeture implicite en tête de
    _sautoniax_initialiser_notebook_distant) ou de tuer tout le process
    sAutoniax -- aucun des deux ne permet de simplement arrêter le profil
    en cours et laisser l'exécutant en attente, prêt pour un futur
    "Initialiser". Symétrique du kill_profil du panneau Instances (onglet
    Instances, PanneauProprietesSautoniax), mais pour CE mode mono-profil
    précis, qui n'a pas de nom_profil à cibler explicitement -- un seul
    profil chargé à la fois via ce bouton, cf. docstring de classe de
    _sautoniax_initialiser_notebook_distant.

    Ne PLANTE JAMAIS si rien n'est chargé (etat_notebook_distant["camoufox_
    cm"] déjà None, ex. double-clic sur "Fermer", ou profil jamais chargé)
    -- traité comme un SUCCÈS (ok=True), pas une erreur : l'état voulu
    ("rien de chargé sur cet exécutant") est déjà atteint, cf. docstring de
    _sautoniax_fermer_profil_notebook_distant_charge."""
    def _log(ligne: str):
        client_t.envoyer_initialiser_notebook_distant_log(session_id, id_pilote, ligne)

    log.info(f"[sAutoniax] fermeture notebook distant demandée (session={session_id}).")
    try:
        ferme = await _sautoniax_fermer_profil_notebook_distant_charge(client_t, etat_notebook_distant, _log)
        if ferme:
            _log("Profil fermé.")
            log.info(f"[sAutoniax] profil notebook distant fermé avec succès (session={session_id}).")
        else:
            log.info(f"[sAutoniax] fermeture notebook distant (session={session_id}) -- aucun profil chargé, rien à faire.")
        client_t.envoyer_fermer_notebook_distant_resultat(session_id, id_pilote, True, "")
    except Exception as e:
        message_erreur = f"{e.__class__.__name__}: {e}"
        log.warning(f"[sAutoniax] échec fermeture notebook distant (session={session_id}) : {e!r}")
        client_t.envoyer_fermer_notebook_distant_resultat(session_id, id_pilote, False, message_erreur)


async def _sautoniax_initialiser_notebook_distant(
    client_t: "ClientServeurT", loop: asyncio.AbstractEventLoop,
    session_id: str, profil_nom: str, id_pilote: str,
    instance_id: str, etat_notebook_distant: dict,
    etat_capture: dict, capture_ponctuelle_demandee: asyncio.Event,
    arret_demande: asyncio.Event,
    relais_proxy_local: Optional["RelaisProxyLocal"] = None,
) -> None:
    """PATCH (bouton "Initialiser" du Notebook Distant -- demande
    explicite utilisateur : "on doit selectionner un profils disponible
    sur le cloud, et une instance sautoniax, on vas initaliser, sa veut
    dire que on vas charger ce profils la vers le sauoniax, ainsi tout
    seras pres pour une vrai execution").

    Réutilise EXACTEMENT les mêmes briques que le mode mono-profil legacy
    de _main_async_sautoniax (étapes 2-3 : _sautoniax_assurer_profil_local
    puis camoufox_demarrer_navigateur(headless=True)) -- aucune nouvelle
    mécanique de téléchargement/lancement, seulement un déclenchement À LA
    DEMANDE plutôt qu'automatique au démarrage du process, pour permettre
    au pilote de choisir le profil depuis l'onglet Notebook Distant plutôt
    que de dépendre du `--profil` figé au lancement du notebook Kaggle.

    `etat_notebook_distant` (même dict que namespace_notebook_distant
    passé à _sautoniax_executer_notebook_distant, ÉTENDU ici avec les clés
    "camoufox_cm"/"profil_charge"/"tache_capture"/"arret_profil") est MUTÉ
    en place : c'est le point de partage unique entre cette fonction et
    l'exécution de cellule (qui lit juste etat_notebook_distant["page"],
    sans se soucier de savoir si elle vient du mode legacy ou de ce bouton
    "Initialiser" -- même contrat).

    Si un profil est DÉJÀ chargé (page/camoufox_cm présents dans l'état,
    peu importe qu'il vienne du mode legacy --profil ou d'un appel
    précédent à cette fonction) : il est fermé proprement AVANT de charger
    le nouveau, jamais deux Camoufox empilés sur le même sAutoniax (mode
    mono-profil, cf. docstring de _sautoniax_executer_notebook_distant).

    CORRECTIF (aperçu mono-profil resté vide via ce chemin -- la boucle de
    capture périodique, cf. _sautoniax_boucle_capture, n'était auparavant
    démarrée QUE par le chemin legacy `--profil` CLI, jamais ici) : une
    fois Camoufox lancé, une tâche de capture dédiée est démarrée en fond
    (loop.create_task, jamais `await`-ée ici -- cette fonction doit
    renvoyer le résultat au pilote sans attendre indéfiniment) et stockée
    dans etat_notebook_distant["tache_capture"] pour pouvoir être annulée
    proprement si un profil ultérieur la remplace."""
    def _log(ligne: str):
        client_t.envoyer_initialiser_notebook_distant_log(session_id, id_pilote, ligne)

    # --- Arrêt + fermeture propre d'un profil précédemment chargé, s'il y en a un. ---
    # PATCH (factorisation, cf. _sautoniax_fermer_profil_notebook_distant_
    # charge/_sautoniax_fermer_notebook_distant, bouton "Fermer") : cette
    # logique était auparavant écrite en dur ici -- extraite pour être
    # réutilisée à l'identique par la fermeture EXPLICITE (bouton "Fermer"),
    # sans risquer que les deux chemins divergent avec le temps.
    await _sautoniax_fermer_profil_notebook_distant_charge(client_t, etat_notebook_distant, _log)

    log.info(f"[sAutoniax] initialisation notebook distant (session={session_id}, profil={profil_nom!r}).")
    _log(f"Téléchargement du profil '{profil_nom}' depuis le cloud...")

    try:
        dossier_profil = await _sautoniax_assurer_profil_local(client_t, loop, profil_nom)
        if dossier_profil is None:
            message_erreur = f"Échec du téléchargement du profil '{profil_nom}' (introuvable sur le cloud ou stockage non configuré)."
            _log(message_erreur)
            client_t.envoyer_initialiser_notebook_distant_resultat(session_id, id_pilote, False, message_erreur)
            log.warning(f"[sAutoniax] {message_erreur}")
            return

        _log("Profil prêt localement -- lancement de Camoufox (headless)...")
        # CORRECTIF (même bug que les 3 autres appelants de
        # camoufox_demarrer_navigateur/_sautoniax_lancer_instance_subprocess,
        # cf. docstring de _sautoniax_lancer_instance_subprocess) :
        # proxy=None était codé en dur ici, alors que profil_nom est connu
        # -- le proxy configuré côté cloud pour ce profil n'était jamais lu
        # ni transmis, l'instance sortait donc toujours par l'IP réelle de
        # la machine pour ce chemin (bouton "Initialiser" du Notebook
        # Distant) en particulier.
        # PATCH (SPEC_proxy_natif_tunnel.md, section 13.4) : passe par
        # _resoudre_proxy_effectif_profil -- cette coroutine tourne dans
        # le process principal (même boucle que relais_proxy_local),
        # appel direct sans détour par un thread.
        proxy_profil = await _resoudre_proxy_effectif_profil(profil_nom, relais_proxy_local)
        camoufox_cm, context, page, gestion, etat_navigateur = await camoufox_demarrer_navigateur(
            str(dossier_profil), instance_id, None, download_dir=None, headless=True, proxy=proxy_profil,
            nom_profil=profil_nom, moteur=_moteur_playwright_pour_profil(profil_nom),
        )
        etat_notebook_distant["page"] = page
        etat_notebook_distant["namespace"] = None
        etat_notebook_distant["camoufox_cm"] = camoufox_cm
        etat_notebook_distant["profil_charge"] = profil_nom
        # CORRECTIF (contrôle à distance -- cf. docstring de
        # commande_instance_recue côté ClientServeurT pour le diagnostic
        # complet) : context/gestion/etat_navigateur n'étaient jusqu'ici
        # JAMAIS conservés au-delà de cette fonction (variables locales
        # perdues au retour) -- indispensables pourtant à
        # _executer_commande_camoufox(context, gestion, etat_navigateur,
        # data, ...) pour exécuter une commande de pilotage (mousemove/
        # click/scroll/etc.) reçue APRÈS l'initialisation. etat_navigateur
        # contient déjà "page" en interne (cf. _executer_commande_
        # camoufox qui le relit via etat_navigateur["page"]), donc pas
        # besoin de dupliquer "page" séparément ici.
        etat_notebook_distant["context"] = context
        etat_notebook_distant["gestion"] = gestion
        etat_notebook_distant["etat_navigateur"] = etat_navigateur

        # --- Démarre la capture périodique pour CE profil (cf. docstring
        # ci-dessus) -- arret_profil dédié à cette instance de capture,
        # DIFFÉRENT de arret_demande (global au process) : remplacer ce
        # profil par un autre plus tard doit arrêter CETTE tâche de
        # capture sans jamais toucher au process entier.
        arret_profil = asyncio.Event()
        etat_notebook_distant["arret_profil"] = arret_profil
        etat_notebook_distant["tache_capture"] = loop.create_task(_sautoniax_boucle_capture(
            client_t, etat_notebook_distant, instance_id,
            etat_capture, capture_ponctuelle_demandee, arret_demande, arret_profil,
        ))

        # PATCH (visibilité serveur du profil Notebook Distant, cf.
        # commentaire symétrique plus haut à la fermeture) -- nom_projet
        # marqué "[Notebook Distant]" plutôt qu'une chaîne vide : permet
        # au panneau de propriétés (onglet Instances côté pilote) de
        # distinguer ce mode d'un vrai ProjetBatch sans champ dédié
        # supplémentaire côté serveur (cf. Connexion.profils_en_cours,
        # relais pur -- "aucune logique métier AutoniaX" de ce fichier).
        # id_projet_batch vide : ce mode n'a pas de notion de ProjetBatch.
        client_t.envoyer_profils_demarres(session_id, "", "[Notebook Distant]", [profil_nom])

        _log(f"Profil '{profil_nom}' chargé et prêt pour exécution.")
        client_t.envoyer_initialiser_notebook_distant_resultat(session_id, id_pilote, True, "")
        log.info(f"[sAutoniax] notebook distant initialisé avec succès (session={session_id}, profil={profil_nom!r}).")
    except Exception as e:
        message_erreur = f"{e.__class__.__name__}: {e}"
        _log(f"Échec de l'initialisation : {message_erreur}")
        client_t.envoyer_initialiser_notebook_distant_resultat(session_id, id_pilote, False, message_erreur)
        log.warning(f"[sAutoniax] échec initialisation notebook distant (session={session_id}) : {e!r}")


class ArretExecutionNotebookDistant(BaseException):
    """Levée DANS le thread du code utilisateur quand « Arrêter » est demandé
    pour un notebook distant (mode mono-profil Camoufox). BaseException et
    non Exception : un `except Exception` du code utilisateur ne doit jamais
    l'avaler, mais ses `finally` s'exécutent (nettoyage normal)."""


class ControleArretNotebookDistant:
    """Mécanisme d'arrêt d'UNE exécution de notebook distant (thread dédié).

    Un thread Python ne peut pas être tué de force : l'arrêt combine donc
      1) un Event `_arrete` (lisible par le code via la pile d'appels, cf.
         arret_autoniax() du bot CAA, qui cherche `self._arrete`),
      2) l'annulation des appels navigateur en cours (futures posés par
         InstanceExecutableDirecteCamoufox._appeler) pour réveiller le thread,
      3) une exception asynchrone ArretExecutionNotebookDistant injectée
         dans le thread, qui interrompt aussi les boucles de calcul pur.
    L'exception n'est injectée que tant que le thread exécute réellement le
    code (`actif`), pour ne jamais toucher un thread du pool réutilisé."""

    def __init__(self):
        self._arrete = threading.Event()
        self._verrou = threading.Lock()
        self._futures: set = set()
        self.thread_id: Optional[int] = None
        self.actif: bool = False

    def demarrer(self):
        with self._verrou:
            self.thread_id = threading.get_ident()
            self.actif = True
            # ARRET DRASTIQUE : threads existants AVANT le code utilisateur ; tout thread
            # apparu ensuite (battement, surveillances de l'agent...) sera arrete aussi.
            try:
                self._threads_avant = {t.ident for t in threading.enumerate()}
            except Exception:
                self._threads_avant = set()
        self.verifier()

    def desactiver(self):
        with self._verrou:
            self.actif = False

    def verifier(self):
        if self._arrete.is_set():
            raise ArretExecutionNotebookDistant("exécution interrompue (Arrêter)")

    def enregistrer(self, future):
        with self._verrou:
            self._futures.add(future)

    def retirer(self, future):
        with self._verrou:
            self._futures.discard(future)

    def arreter(self) -> bool:
        """True si l'arrêt vient d'être déclenché, False s'il l'était déjà."""
        with self._verrou:
            if self._arrete.is_set():
                return False
            self._arrete.set()
            futures = list(self._futures)
            injecter = self.actif and self.thread_id is not None
            tid = self.thread_id
        for future in futures:
            try:
                future.cancel()
            except Exception:
                pass
        if injecter:
            try:
                import ctypes
                with self._verrou:
                    if self.actif:
                        ctypes.pythonapi.PyThreadState_SetAsyncExc(
                            ctypes.c_ulong(tid), ctypes.py_object(ArretExecutionNotebookDistant),
                        )
            except Exception as exc:
                log.warning(f"[sAutoniax] arrêt notebook distant : injection d'exception impossible ({exc!r}).")
        # ARRET DRASTIQUE : filet de securite -- reessaie, vise les threads lances par le code,
        # puis tue le process si quelque chose survit (voir _tueur_arret_drastique).
        try:
            threading.Thread(target=self._tueur_arret_drastique, name="autoniax-tueur-arret", daemon=True).start()
        except Exception as exc:
            log.warning(f"[sAutoniax] arrêt drastique : démarrage du tueur impossible ({exc!r}).")
        return True

    # Delai (s) apres « Arreter » avant de tuer le PROCESS si un thread du code resiste.
    # Mettre 0 pour desactiver le kill du process (il resterait alors l'injection repetee).
    DELAI_KILL_PROCESS_S = 6.0

    def _threads_cibles(self):
        """Threads a arreter : le thread d'execution + tout thread cree pendant le code
        utilisateur (hors pool executor/asyncio du moteur et hors ce tueur)."""
        avant = getattr(self, "_threads_avant", set())
        moi = threading.get_ident()
        cibles = []
        for t in threading.enumerate():
            if t.ident is None or t.ident == moi or not t.is_alive():
                continue
            if t.ident == self.thread_id:
                cibles.append(t)
                continue
            if t.ident in avant or t is threading.main_thread():
                continue
            nom = t.name or ""
            if nom.startswith(("ThreadPoolExecutor", "asyncio_", "autoniax-tueur")):
                continue
            cibles.append(t)
        return cibles

    def _tueur_arret_drastique(self):
        import ctypes
        debut = time.time()
        delai = float(self.DELAI_KILL_PROCESS_S)
        while True:
            restants = []
            try:
                for t in self._threads_cibles():
                    if t.ident == self.thread_id and not self.actif:
                        continue
                    restants.append(t)
                    try:
                        ctypes.pythonapi.PyThreadState_SetAsyncExc(
                            ctypes.c_ulong(t.ident), ctypes.py_object(ArretExecutionNotebookDistant))
                    except Exception:
                        pass
            except Exception as exc:
                log.warning(f"[sAutoniax] arrêt drastique : balayage impossible ({exc!r}).")
            if not restants:
                log.info("[sAutoniax] ARRET TOTAL : plus aucun thread du code utilisateur.")
                return
            if delai > 0 and time.time() - debut >= delai:
                noms = ", ".join(sorted(t.name for t in restants))
                log.error(f"[sAutoniax] ARRET TOTAL FORCE : threads encore vivants apres {delai:.0f}s ({noms}) -> kill du process.")
                try:
                    for h in list(log.handlers) + list(logging.getLogger().handlers):
                        try: h.flush()
                        except Exception: pass
                except Exception:
                    pass
                os._exit(1)
            if delai <= 0 and time.time() - debut >= 30:
                return
            time.sleep(0.5)


def _extraire_noms_candidats_service_api(code: str, namespace_deja_present: dict) -> set:
    """Analyse statique (module `ast`, PAS d'exécution) du code d'une
    cellule de Notebook Distant, pour deviner quels noms top-level
    pourraient être des ServiceAPI (ex. `claude` dans `claude.instance()
    .capture()`) -- cf. docstring de ServiceAPIExecutableDirectCamoufox :
    le protocole réseau `executer_notebook_distant` ne transmet que
    `code` (texte brut), jamais `task.services_api_importes` (ce concept
    de Task structuré n'existe même pas côté sAutoniax) -- il n'y a donc
    AUCUN moyen de savoir à l'avance quels noms injecter, à part
    regarder ce que le code utilisateur lit réellement.

    Principe : un nom est un candidat s'il est LU (ast.Load) quelque
    part dans le code ET qu'il n'est écrit/lié NULLE PART ailleurs dans
    ce même code -- peu importe l'ordre des lignes (un `import Path`
    plus bas dans la cellule doit exclure `Path` même si un usage
    apparaît avant dans le code source, cf. le cas RESPONSE_DIR/Path
    identifié pendant les tests) -- ET qu'il n'est pas déjà un builtin,
    un mot-clé Python, ou déjà présent dans le namespace hérité des
    cellules précédentes (`namespace_deja_present`, cf. etat_notebook_
    distant["namespace"] -- un nom déjà résolu par une cellule
    antérieure, ex. une vraie variable ou un service déjà injecté avant,
    ne doit pas être écrasé par un nouveau service vide).

    Faux positifs POSSIBLES et ACCEPTÉS (cf. investigation) : une
    variable de boucle (`for x in range(3)`) utilisée après sa propre
    liaison est tout de même candidate, puisque ast.walk ne modélise pas
    l'ordre d'exécution -- injecter un ServiceAPIExecutableDirectCamoufox
    nommé `x` puis le voir immédiatement écrasé par la boucle ne cause
    aucun problème réel (juste un objet créé pour rien). Un nom local à
    une fonction/lambda DÉFINIE DANS la cellule (donc son propre scope)
    peut en théorie masquer un vrai nom de service pour ce sous-scope
    précis -- cas limite jugé acceptable (cf. discussion), le code
    utilisateur garde de toute façon accès au service via le namespace
    global si besoin.

    LIMITATION CONFIRMÉE (testé avec un vrai fichier .autoniaxtask
    exporté depuis un Task normal, ex. Example_CreateStory) : un
    ComposantExecutable (ex. `claude_zone_saisir.saisir(...)`, détection
    visuelle liée à un template image -- concept DIFFÉRENT d'un
    ServiceAPI comme `claude`) sera lui aussi détecté à tort comme
    candidat, faute de moyen de les distinguer par la seule analyse
    statique du nom. Conséquence : un `ServiceAPIExecutableDirectCamoufox`
    inoffensif est injecté à sa place -- le code échoue alors PROPREMENT
    au premier usage réel (AttributeError explicite, ex. l'objet n'a pas
    de méthode `.saisir()`/`.visible()`), jamais silencieusement. Support
    des ComposantExecutable en notebook distant : hors scope de ce
    correctif (nécessiterait de transmettre les templates images associés
    via le protocole réseau, qui ne transporte aujourd'hui que du texte).

    Ne lève jamais d'exception : un code syntaxiquement invalide
    retourne un ensemble vide plutôt que de faire planter l'injection
    avant même que l'erreur de syntaxe ne soit proprement remontée par
    l'exec() réel plus loin (cf. appelant, qui laissera compile()
    produire le vrai SyntaxError au bon endroit)."""
    try:
        arbre = ast.parse(code)
    except SyntaxError:
        return set()

    noms_lus: set = set()
    noms_lies: set = set()

    for noeud in ast.walk(arbre):
        # Toute forme de liaison de nom : affectation simple/augmentée/
        # annotée, cible de `with ... as x` / `except ... as x` /
        # `for x in ...`, paramètre de fonction/lambda, nom de fonction/
        # classe elle-même, et bien sûr les imports (cf. cas Path).
        if isinstance(noeud, (ast.Import, ast.ImportFrom)):
            for alias in noeud.names:
                nom_lie = alias.asname or alias.name.split(".")[0]
                noms_lies.add(nom_lie)
        elif isinstance(noeud, (ast.FunctionDef, ast.AsyncFunctionDef, ast.ClassDef)):
            noms_lies.add(noeud.name)
        elif isinstance(noeud, ast.arg):
            noms_lies.add(noeud.arg)
        elif isinstance(noeud, ast.Global) or isinstance(noeud, ast.Nonlocal):
            for nom in noeud.names:
                noms_lies.add(nom)
        elif isinstance(noeud, ast.Name):
            if isinstance(noeud.ctx, ast.Load):
                noms_lus.add(noeud.id)
            else:  # ast.Store, ast.Del -- affectation, for-target, with-target, etc.
                noms_lies.add(noeud.id)

    candidats = noms_lus - noms_lies
    # BUG CORRIGÉ (trouvé en testant isolément avant intégration) :
    # dir(vars(__builtins__)) fait dir() sur le DICT lui-même (ses
    # méthodes __contains__/__iter__/keys/etc.), PAS sur les noms de
    # builtins qu'il contient -- filtre qui ne filtrait donc presque
    # rien, laissant passer print/range/len/... comme "candidats
    # ServiceAPI". __builtins__/vars(__builtins__) sont déjà eux-mêmes
    # des mappings {nom: objet} : `set(...)` dessus suffit à obtenir
    # l'ensemble des noms, aucun dir() nécessaire ni correct ici.
    dict_builtins = __builtins__ if isinstance(__builtins__, dict) else vars(__builtins__)
    candidats -= set(dict_builtins)
    candidats -= set(keyword.kwlist) | set(keyword.softkwlist)
    candidats -= set(namespace_deja_present.keys())
    # Deux noms techniques que le namespace injecte lui-même juste après
    # cette analyse (cf. appelant) -- ne jamais les traiter comme des
    # ServiceAPI même s'ils sont lus avant d'être (re)posés.
    candidats -= {"page", "__builtins__"}
    return candidats


async def _sautoniax_executer_notebook_distant(
    client_t: "ClientServeurT", loop: asyncio.AbstractEventLoop,
    session_id: str, profil_nom: str, code: str, id_pilote: str,
    etat_notebook_distant: dict, page_courante, services_api_lies: Optional[dict] = None,
) -> None:
    """Exécute `code` (Patch 4.5 -- Notebook Distant) sur le profil
    actuellement chargé par CE sAutoniax (mode mono-profil, cf. `page`
    ouverte par _main_async_sautoniax) -- namespace exposant `page`
    (objet Playwright/Camoufox actif, cf. camoufox_demarrer_navigateur),
    tout builtin standard, ET désormais un ServiceAPIExecutableDirectCamoufox
    injecté DYNAMIQUEMENT pour chaque nom candidat détecté par analyse
    statique du code (cf. _extraire_noms_candidats_service_api) --
    permet à `claude.instance().capture()` (ou n'importe quel autre nom
    de service, ex. `Word`) de fonctionner nativement, SANS passer par
    aucun réseau local (contrairement à InstanceExecutable/
    ServiceAPIExecutable classiques, qui exigent un client réseau LOCAL
    lié à une instance déjà enregistrée -- incompatible avec un sAutoniax
    distant sur Kaggle, cf. investigation : capture()/get_presse_papier()/
    etc. passent par MoteurExecutionCellule._appeler, lui-même un aller-
    retour WebSocket vers ws://127.0.0.1:8765, qui n'existe pas dans ce
    contexte). stdout/stderr capturés et renvoyés LIGNE PAR LIGNE au fil
    de l'exécution (cf. envoyer_notebook_distant_log, §4.5 : "indicateurs
    de statut en temps réel") plutôt qu'accumulés puis renvoyés d'un bloc
    à la fin.

    CORRECTIF (bug rapporté : `RuntimeWarning: coroutine 'new_tab' was
    never awaited`, notebook distant plante silencieusement -- cf.
    docstring d'InstanceExecutableDirecteCamoufox pour l'analyse complète
    de la cause). Le code utilisateur des .autoniaxtask est écrit dans le
    style ENTIÈREMENT SYNCHRONE du mode Task normal -- aucun `await`
    nulle part, jamais. L'ancien code compilait avec PyCF_ALLOW_TOP_
    LEVEL_AWAIT et exécutait via eval() directement DANS cette coroutine
    (donc sur la boucle asyncio principale du sAutoniax) : ce flag permet
    au code d'utiliser `await` s'IL LE VEUT, mais ne force jamais un
    `await` implicite sur un appel qui n'en écrit pas -- InstanceExecutable
    DirecteCamoufox étant `async def` sur chaque méthode, `Instance.
    new_tab(...)` créait la coroutine puis l'abandonnait aussitôt, sans
    jamais l'exécuter.

    Corrigé en exécutant désormais le code utilisateur dans un VRAI THREAD
    séparé (via loop.run_in_executor, cf. plus bas) -- exactement le même
    principe que MoteurExecutionCellule._thread_execution en mode local
    (threading.Thread dédié, exec(code, namespace) synchrone). Depuis ce
    thread, InstanceExecutableDirecteCamoufox/ServiceAPIExecutableDirect
    Camoufox (désormais SYNCHRONES, cf. leurs docstrings) bloquent
    normalement jusqu'à ce que leur travail réel, délégué à CETTE boucle
    (`loop`, reçue en paramètre et transmise en cascade) via asyncio.run_
    coroutine_threadsafe, soit terminé -- Playwright/Camoufox continuent
    de tourner exclusivement sur `loop`, jamais sur le thread du code
    utilisateur. PyCF_ALLOW_TOP_LEVEL_AWAIT abandonné : exec(code,
    namespace) classique désormais (même choix que _thread_execution en
    mode local) -- un `await` écrit explicitement dans une cellule lèverait
    SyntaxError, ce qui est le comportement attendu pour du code écrit
    dans le style Task normal (qui n'a jamais eu la possibilité d'`await`
    non plus).

    CORRECTIF (bug rapporté : `NameError: RESPONSE_DIR` dès la 2e cellule
    exécutée, alors que la cellule "# Variable dynamique" qui la définit
    venait de s'exécuter avec succès juste avant). Cause : `etat_
    notebook_distant["namespace"]` (cf. son initialisation à None dans
    _main_async_sautoniax) n'était JAMAIS réécrit après une exécution --
    chaque cellule repartait donc d'un namespace vierge (seulement `page`
    + builtins), perdant tout ce que la cellule précédente avait défini
    (imports, variables, fonctions). `etat_notebook_distant` (le dict
    MUTABLE partagé, plutôt que juste sa clé "namespace" déjà résolue en
    valeur figée par l'appelant comme avant) est maintenant reçu
    directement ici pour pouvoir y réécrire le namespace mis à jour à la
    fin -- succès ET échec (une cellule qui plante à mi-chemin a quand
    même pu définir des imports/variables avant l'erreur, qu'une cellule
    suivante ou une re-exécution corrigée doit pouvoir réutiliser, exactement
    comme un vrai notebook Jupyter conserve son état après une exception).

    BUG CORRIGÉ (retour explicite utilisateur -- "si je met l'appel de la
    fonction dans une autre cellule, la détection qui marchait dans la
    même cellule se met à échouer") : le correctif ci-dessus recréait un
    NOUVEAU dict à chaque appel (`namespace = dict(ancien_namespace)`,
    une COPIE) plutôt que de MUTER en place l'ancien. Or `exec(code,
    namespace)` fait pointer `__globals__` de CHAQUE fonction définie
    dans ce code sur CE dict précis, PAR RÉFÉRENCE (pas une copie
    figée) -- une fonction définie en cellule 1 (ex. go_to_proxy_website,
    qui lit un Composant comme yt_view_CroxyProxyLogo SANS jamais
    l'assigner localement) continue donc, pour toujours, de chercher ses
    variables globales dans le dict de LA CELLULE OÙ ELLE A ÉTÉ DÉFINIE
    -- jamais dans celui, pourtant à jour, d'une cellule ultérieure qui
    se contente de l'appeler. Résultat : le Composant fraîchement
    réinjecté par _construire_composants_direct plus bas (nouveau
    ComposantExecutable, nouveau moteur_direct) est invisible pour cette
    fonction, qui continue silencieusement d'utiliser l'ancien objet
    périmé de la cellule où elle a été définie -- d'où la détection qui
    réussissait "dans la même cellule" (fonction ET Composant du même
    dict) mais échouait une fois l'appel déplacé seul dans une cellule
    suivante (fonction restée liée à l'ancien dict, Composant réinjecté
    dans le nouveau). Une variable LOCALE à la fonction (ex. mon_instance
    = yt_view.instance(), assignée avant tout usage) n'est PAS concernée
    -- Python la résout comme locale, jamais via __globals__ -- d'où
    l'apparente incohérence "new_tab() fonctionne mais pas visible() sur
    le composant".

    Corrigé en MUTANT le dict existant EN PLACE (namespace.clear() puis
    namespace.update(...), jamais un nouveau dict réassigné à la
    variable locale `namespace`) : le MÊME objet dict vit ainsi pendant
    toute la durée du Task, exactement comme le namespace persistant du
    mode local (cf. TaskConfigScreen._namespace_task, qui n'a jamais
    cette réassignation) -- une fonction définie n'importe quand reste
    donc TOUJOURS branchée sur les dernières valeurs/derniers Composants
    injectés, quelle que soit la cellule qui l'appelle ensuite.

    LIMITATION (cf. commentaire de _sur_executer_notebook_distant_demande,
    _main_async_sautoniax) : ne gère que le profil actuellement actif sur
    CETTE instance mono-profil -- un profil_nom différent de celui déjà
    chargé est un échec explicite immédiat plutôt qu'un lancement
    silencieux d'une instance supplémentaire."""
    if page_courante is None:
        client_t.envoyer_notebook_distant_resultat(
            session_id, id_pilote, False,
            "Aucun profil actif sur ce sAutoniax pour l'instant (Camoufox pas encore démarré).",
        )
        return

    log.info(f"[sAutoniax] exécution notebook distant (session={session_id}, profil demandé={profil_nom!r}).")

    class _FluxLigneParLigne(io.StringIO):
        """Redirige stdout/stderr vers envoyer_notebook_distant_log ligne
        par ligne au fil de l'écriture, plutôt que d'attendre la fin de
        l'exécution -- cf. docstring de la fonction. write() est appelée
        depuis le THREAD séparé (cf. exec() plus bas) -- envoyer_
        notebook_distant_log elle-même envoie sur le WebSocket via
        client_t, dont l'implémentation gère déjà son propre passage
        thread -> boucle asyncio en interne (mêmes garanties que les
        autres envoyer_xxx de ClientServeurT, tous déjà appelés
        indifféremment depuis des threads ou la boucle ailleurs dans ce
        fichier -- cf. _sur_logs_executant_demande par ex.)."""
        def write(self_flux, texte):
            if _sortie_logs_coupee():   # sortie coupée (défaut) : aucune ligne envoyée au serveurT
                return len(texte)
            for ligne in texte.splitlines():
                if ligne:
                    client_t.envoyer_notebook_distant_log(session_id, id_pilote, ligne)
            return len(texte)

    # CORRECTIF (cf. docstring de fonction, bug "détection qui marche en
    # même cellule mais pas depuis une cellule suivante") : le dict
    # persistant est désormais MUTÉ EN PLACE, jamais recopié dans une
    # nouvelle variable locale `namespace` -- une fonction définie par le
    # code utilisateur (exec() plus bas) capture ce dict PAR RÉFÉRENCE
    # comme son __globals__ ; le réassigner à un nouvel objet à chaque
    # appel casserait irrémédiablement le lien pour toute fonction
    # définie lors d'une cellule antérieure (cf. docstring). Premier
    # appel (etat_notebook_distant["namespace"] encore None) : on crée le
    # dict UNE SEULE FOIS et on le stocke immédiatement -- tous les
    # appels suivants réutilisent ce même objet.
    namespace = etat_notebook_distant.get("namespace")
    if namespace is None:
        namespace = {}
        etat_notebook_distant["namespace"] = namespace
    namespace["page"] = page_courante
    namespace.setdefault("__builtins__", __builtins__)
    # Api2Api/attendre_requete/textFile/TextFile (cf. Api2Api_
    # specification.md) -- même injection EXACTE que _namespace_task
    # côté mode local (cf. sa docstring), mais liée ICI à `client_t`, le
    # ClientServeurT PROPRE à ce sAutoniax (cf. sa construction dans
    # _main_async_sautoniax) -- pas celui d'un éventuel mAutoniax pilote,
    # cohérent avec la spécification ("n'importe quel Task, local ou
    # réseau, sur n'importe quelle machine du réseau"). setdefault (pas
    # un update inconditionnel) : ce namespace peut déjà porter ces
    # clés d'une exécution de cellule précédente (cf. etat_notebook_
    # distant["namespace"] réutilisé d'un appel à l'autre, docstring de
    # fonction) -- pas la peine de reconstruire une nouvelle closure
    # Api2Api/attendre_requete identique à chaque cellule.
    if "Api2Api" not in namespace:
        namespace.update(_construire_espace_noms_api2api(client_t))
        namespace.setdefault("textFile", textFile)
        namespace.setdefault("TextFile", TextFile)
    # AJOUT (transfert de fichiers ALLER, cf. CODE_DECODAGE_FICHIERS_LIST_
    # TASKS) -- même raison et même injection inconditionnelle/idempotente
    # que dans main_executeur_sautoniax (exécuteur isolé) : un préfixe
    # LIST_TASKS décodant des fichiers embarqués a besoin de `os` et de
    # _decoder_fichiers_api2api dans ce namespace.
    namespace.setdefault("os", os)
    namespace.setdefault("_decoder_fichiers_api2api", _decoder_fichiers_api2api)

    # PATCH -- injection dynamique des ServiceAPI (cf. docstring de
    # fonction, "vas-y implémente tout" : claude.instance() doit
    # fonctionner nativement ici). context/gestion/etat_navigateur : cf.
    # leur peuplement dans namespace_notebook_distant par _main_async_
    # sautoniax (legacy --profil OU bouton "Initialiser" du Notebook
    # Distant), même patron EXACT que _sur_commande_instance_recue un
    # peu plus haut dans ce fichier -- si l'un des trois manque encore
    # (profil chargé via un chemin qui ne les peuple pas, cas normalement
    # impossible vu page_courante déjà vérifié non-None ci-dessus, mais
    # gardé défensif), les candidats détectés sont simplement ignorés :
    # une cellule qui utilise `claude` échouera alors avec un NameError
    # normal plutôt qu'un objet à moitié construit qui planterait de
    # façon plus confuse au premier appel.
    context_camoufox = etat_notebook_distant.get("context")
    gestion_camoufox = etat_notebook_distant.get("gestion")
    etat_navigateur_camoufox = etat_notebook_distant.get("etat_navigateur")
    candidats_service_api: set = set()
    if context_camoufox is not None and gestion_camoufox is not None and etat_navigateur_camoufox is not None:
        candidats_service_api = _extraire_noms_candidats_service_api(code, namespace)
        for nom_candidat in candidats_service_api:
            namespace[nom_candidat] = ServiceAPIExecutableDirectCamoufox(
                nom_candidat, context_camoufox, gestion_camoufox, etat_navigateur_camoufox,
                None, namespace, loop,
            )
        if candidats_service_api:
            log.info(
                f"[sAutoniax] notebook distant (session={session_id}) -- "
                f"ServiceAPI injecté(s) dynamiquement : {sorted(candidats_service_api)}."
            )

        # PATCH (Composants en notebook distant, retour explicite
        # utilisateur -- "je veux le filtrage precis comme en local") --
        # même filtre EXACT que Project.composants_importes_task côté
        # mode local : SEULS les Composants dont le ServiceAPI parent
        # apparaît dans `services_api_lies` (transmis depuis
        # MoteurExecutionCelluleReseau.lancer, via le protocole réseau,
        # cf. docstring de _construire_composants_direct pour le détail
        # complet) sont chargés/injectés -- jamais "tous par défaut".
        # Sous la même garde que les ServiceAPI ci-dessus (context/
        # gestion/etat_navigateur tous non-None) : un Composant a de
        # toute façon besoin exactement des mêmes trois éléments pour
        # être détecté/cliqué (cf. _MoteurDirectPourComposant, mêmes
        # paramètres que ServiceAPIExecutableDirectCamoufox).
        # AJOUT (demande explicite utilisateur : "je veux que le terminal
        # affiche aussi les images") -- client_t/session_id/id_pilote sont
        # déjà tous les trois des paramètres de CETTE fonction (aucun
        # nouveau paramètre à faire remonter plus loin), transmis en
        # contexte réseau pour qu'Image.view() (cf. sa docstring) sache
        # vers quel pilote envoyer une image capturée par .screenshot().
        composants_directs = _construire_composants_direct(
            context_camoufox, gestion_camoufox, etat_navigateur_camoufox,
            None, loop, services_api_lies, namespace,
            _contexte_reseau={"client_t": client_t, "session_id": session_id, "id_pilote": id_pilote},
        )
        namespace.update(composants_directs)
        if composants_directs:
            log.info(
                f"[sAutoniax] notebook distant (session={session_id}) -- "
                f"Composant(s) injecté(s) dynamiquement : {sorted(composants_directs)}."
            )
        elif candidats_service_api:
            # LOG CIBLÉ (diagnostic .visible()/AttributeError) -- au moins
            # un candidat a été traité comme ServiceAPI générique
            # (ligne au-dessus) mais AUCUN Composant ne l'a écrasé : c'est
            # exactement la signature du bug .visible()/AttributeError.
            # Le pourquoi précis (services_api_lies vide ? dossier
            # absent ? nom non trouvé ?) est déjà dans les logs internes
            # de _construire_composants_direct juste au-dessus.
            log.warning(
                f"[sAutoniax] notebook distant (session={session_id}) -- "
                f"AUCUN Composant n'a écrasé les {len(candidats_service_api)} candidat(s) ServiceAPI "
                f"générique(s) {sorted(candidats_service_api)} -- risque élevé d'AttributeError "
                f"(.visible()/.click()/etc.) au premier usage. Cf. logs _construire_composants_direct ci-dessus pour la cause exacte."
            )

    # PATCH -- normalisation tabs/espaces AVANT exec(), même correctif
    # que MoteurExecutionCellule._thread_execution en mode local (cf. sa
    # docstring/_normaliser_indentation_tabs_espaces) -- absent ici
    # jusqu'à ce correctif, alors que le code utilisateur provient EXACTEMENT
    # de la même source (fichiers .autoniaxtask) et peut donc souffrir du
    # même mélange tabs/espaces selon l'éditeur d'origine.
    code_normalise = _normaliser_indentation_tabs_espaces(code)

    # PATCH arrêt d'une exécution Camoufox (mode mono-profil) : contrôleur
    # visible (1) du code via namespace["__controle_arret_autoniax__"]
    # (utilisé par InstanceExecutableDirecteCamoufox._appeler) et (2) du
    # gestionnaire « arreter_execution_profil » via etat_notebook_distant.
    controle_arret = ControleArretNotebookDistant()
    namespace["__controle_arret_autoniax__"] = controle_arret
    etat_notebook_distant["controle_arret"] = controle_arret

    def _exec_thread() -> dict:
        """Tourne sur un THREAD SÉPARÉ (cf. loop.run_in_executor plus
        bas) -- JAMAIS sur la boucle asyncio principale. exec() ici est
        un appel Python parfaitement synchrone et bloquant : chaque appel
        à Instance.new_tab(...)/claude.instance().capture()/etc. dans le
        code utilisateur bloque CE thread (jamais `loop`) jusqu'à ce que
        InstanceExecutableDirecteCamoufox._appeler ait reçu sa réponse de
        `loop` via run_coroutine_threadsafe -- cf. docstring de cette
        classe pour le détail complet du mécanisme.

        Retourne {"ok": bool, "erreur": str|None} -- ne lève jamais,
        toute exception de exec() est capturée et transformée en valeur
        de retour, pour rester compatible avec run_in_executor (qui
        propagerait sinon l'exception SUR loop, dans le contexte await
        de l'appelant -- acceptable en soi, mais on préfère ici le même
        contrat explicite {"ok":...} que partout ailleurs dans ce
        fichier plutôt qu'une exception qui traverserait deux contextes
        d'exécution différents)."""
        try:
            # CORRECTIF (cf. docstring de _FluxStdoutParThread/
            # _capturer_stdout_stderr_thread_courant, tout en haut du
            # fichier) : routage par thread au lieu du verrou global --
            # restaure le parallélisme réel entre profils isolés
            # (chacun dans son propre sous-processus Camoufox) sans
            # réintroduire le mélange de sorties.
            with _capturer_stdout_stderr_thread_courant(flux):
                controle_arret.demarrer()
                exec(code_normalise, namespace)
            return {"ok": True, "erreur": None}
        except ArretExecutionNotebookDistant:
            return {"ok": False, "erreur": "Exécution interrompue (Arrêter).", "interrompu": True}
        except Exception as e:
            return {"ok": False, "erreur": f"{e.__class__.__name__}: {e}\n{traceback.format_exc()}"}
        finally:
            controle_arret.desactiver()

    def _exec_thread_garde() -> dict:
        """Filet : l'exception d'arrêt est asynchrone et peut tomber hors du
        try de _exec_thread (ex. pendant son finally) -- elle ne doit jamais
        traverser run_in_executor et empêcher l'envoi du résultat."""
        # NOM `self` VOLONTAIRE : arret_autoniax() (bot CAA) remonte la pile
        # en cherchant une variable `self` portant `_arrete` -- comme le
        # moteur d'exécution local. Ici c'est le contrôleur d'arrêt.
        self = controle_arret  # noqa: F841
        try:
            return _exec_thread()
        except ArretExecutionNotebookDistant:
            return {"ok": False, "erreur": "Exécution interrompue (Arrêter).", "interrompu": True}

    flux = _FluxLigneParLigne()
    try:
        # run_in_executor (pool par défaut, thread dédié) : équivalent
        # naturel de threading.Thread + Event côté coroutine asyncio --
        # await-able directement, sans bloquer `loop` pendant que
        # _exec_thread() tourne sur son propre thread (cf. docstring de
        # fonction pour le détail du mécanisme complet).
        resultat = await loop.run_in_executor(None, _exec_thread_garde)
        if resultat["ok"]:
            client_t.envoyer_notebook_distant_resultat(session_id, id_pilote, True, "")
            log.info(f"[sAutoniax] notebook distant terminé avec succès (session={session_id}).")
        else:
            client_t.envoyer_notebook_distant_log(session_id, id_pilote, resultat["erreur"])
            client_t.envoyer_notebook_distant_resultat(session_id, id_pilote, False, resultat["erreur"])
            log.warning(f"[sAutoniax] échec notebook distant (session={session_id}) : {resultat['erreur']}")
    finally:
        # cf. docstring de la fonction (CORRECTIF namespace partagé) --
        # `page` retiré avant sauvegarde : déjà réinjecté explicitement en
        # tête de fonction à chaque appel depuis page_courante, le garder
        # ici figerait la référence de LA session où il a été capturé,
        # potentiellement périmée si jamais le profil est rechargé entre
        # deux exécutions.
        #
        # Même raison exactement pour les ServiceAPIExecutableDirectCamoufox
        # injectés plus haut : chacun capture context_camoufox/gestion_
        # camoufox/etat_navigateur_camoufox (ET loop, désormais) par
        # référence AU MOMENT de cette exécution -- les garder en cache
        # d'une cellule à l'autre les figerait sur un contexte
        # potentiellement périmé après un rechargement de profil entre
        # deux cellules. Retirés ici (donc jamais présents dans etat_
        # notebook_distant["namespace"]) pour être systématiquement
        # RE-détectés et RE-construits à chaque appel (cf. plus haut, à
        # partir des objets à jour du moment) -- léger surcoût (une
        # analyse ast par cellule), négligeable et bien plus sûr qu'un
        # service API pointant dans le vide.
        for nom_candidat in candidats_service_api:
            namespace.pop(nom_candidat, None)
        namespace.pop("page", None)
        namespace.pop("__controle_arret_autoniax__", None)   # PATCH arrêt : contrôleur propre à CETTE exécution
        if etat_notebook_distant.get("controle_arret") is controle_arret:
            etat_notebook_distant["controle_arret"] = None
        # Réaffectation redondante mais gardée par prudence/lisibilité --
        # `namespace` a été MUTÉ EN PLACE tout du long (cf. sa
        # construction en tête de fonction, CORRECTIF "détection qui
        # marche en même cellule mais pas depuis une cellule suivante") :
        # etat_notebook_distant["namespace"] pointe déjà vers ce même
        # objet, cette ligne ne fait que le confirmer explicitement.
        etat_notebook_distant["namespace"] = namespace


# AJOUT (retour utilisateur explicite : "on fonctionne maintenant avec
# le code hexadécimal" -- ajout d'un color picker natif dans le panneau
# clone, qui ne peut produire QUE du hex, cf. BoiteDialogueAutoniaX.
# couleur()/QColor.name()) -- remplace QColor.isValidColorName() (qui
# acceptait aussi bien "red" qu'un hex, trop permissif par rapport à la
# décision de n'accepter QUE le format hexadécimal désormais). Regex
# volontairement stricte : "#" obligatoire (pas de repli sur une forme
# sans "#"), 3 ou 6 chiffres hexadécimaux (forme courte "#rgb" et longue
# "#rrggbb", toutes deux valides pour QColor), insensible à la casse.
_MOTIF_HEX_COULEUR = re.compile(r"^#(?:[0-9a-fA-F]{3}|[0-9a-fA-F]{6})$")


def _hex_couleur_valide(valeur) -> bool:
    """True si `valeur` est une chaîne au format hexadécimal Qt/CSS
    valide ("#rgb" ou "#rrggbb"). Utilisée à la place de QColor.
    isValidColorName() (cf. commentaire ci-dessus) -- volontairement
    plus stricte : n'accepte plus les noms Qt/CSS ("red", "green"...),
    seulement le hexadécimal, conformément à la décision utilisateur."""
    return isinstance(valeur, str) and bool(_MOTIF_HEX_COULEUR.match(valeur))


async def _sautoniax_executer_notebook_distant_sur_instance_isolee(
    loop: asyncio.AbstractEventLoop, client_t: "ClientServeurT",
    client_pilote_instances: "ClientReseauAutoniaX", instance_id: str,
    session_id: str, code: str, id_pilote: str, services_api_lies: Optional[dict],
    _namespaces_isoles: Optional[dict] = None,
    _moteurs_relais_courants: Optional[dict] = None,
    # AJOUT (SPEC_lot_corrections_2026-09.md section 11) : cf. docstring
    # ci-dessous, section "result_color", pour le détail complet.
    reinitialiser_result_color: bool = False,
    lire_result_color_finale: bool = False,
    # AJOUT (Section 8 -- "Arrêter" interrompt le CODE, pas le profil,
    # cf. PLAN_section_8_arreter.md §3/§4/§7 étape 4) : registre Popen du
    # process EXÉCUTEUR par instance_id (navigateur), et registre de
    # callbacks en attente de executer_code_resultat -- cf. leurs sites
    # de construction dans _main_async_sautoniax, transmis ici en
    # paramètres (même patron EXACT que _namespaces_isoles/_moteurs_
    # relais_courants ci-dessus : cette fonction est définie au niveau
    # MODULE, pas en closure de _main_async_sautoniax, donc tout ce dont
    # elle a besoin de cette fonction englobante doit lui être transmis
    # explicitement).
    _executeurs_isoles: Optional[dict] = None,
    _callbacks_executer_code_en_attente: Optional[dict] = None,
) -> None:
    """PATCH (Run de cellule réseau sur un profil ISOLÉ -- bouton
    "Démarrer" du panneau Instances, cf. SPEC_notebook_distant_profils_
    isoles.md section 7) -- RÉÉCRITE (Section 8, cf. PLAN_section_8_
    arreter.md §3/§4 : "Arrêter" doit interrompre le CODE de façon
    fiable, ce qu'un thread Python ne permet structurellement pas, cf.
    §1 du plan). Ne s'exécute PLUS elle-même le code utilisateur (ancien
    comportement : namespace local + _exec_thread + loop.run_in_executor,
    cf. historique git pour le détail complet de cet ancien corps) --
    délègue désormais entièrement l'exécution à un TROISIÈME process
    séparé (l'exécuteur, cf. main_executeur_sautoniax), lancé
    PARESSEUSEMENT ici même si aucun n'existe encore pour cet
    instance_id (cf. §4 du plan, option B retenue).

    Namespace, injection des Composants/ServiceAPI, capture stdout : tout
    ceci vit désormais DANS le process exécuteur (cf. sa docstring et
    celle de _sur_executer_code/_ExecuteurClientTAdaptateur pour le détail
    complet, notamment le mécanisme Image.view() qui fait maintenant un
    détour par CE process via executer_code_image_recu plutôt que
    d'appeler client_t directement depuis l'exécuteur) -- cette fonction-
    ci se contente de :
      1. s'assurer qu'un exécuteur existe pour cet instance_id (le
         lancer sinon, cf. _executeurs_isoles) ;
      2. lui envoyer la cellule via client_pilote_instances.envoyer_
         executer_code(...) (canal LOCAL déjà existant, réutilisé tel
         quel -- PAS une nouvelle connexion) ;
      3. attendre son executer_code_resultat (bloquant sur un
         threading.Event, même patron que _MoteurRelaisPourComposant
         Isole._appeler, cf. sa docstring -- SANS timeout d'exécution,
         cf. §4/§8 du plan : "seul terminate() explicite doit
         interrompre", une cellule peut légitimement tourner longtemps) ;
      4. transmettre le résultat au pilote exactement comme avant
         (client_t.envoyer_notebook_distant_resultat/_log) -- contrat
         EXTERNE de cette fonction (ce que ses appelants observent)
         INCHANGÉ, cf. §4 du plan, dernier paragraphe.

    _namespaces_isoles/_moteurs_relais_courants (paramètres CONSERVÉS
    pour compatibilité de signature) NE SONT PLUS UTILISÉS par cette
    fonction -- le namespace et le moteur_relais vivent maintenant
    exclusivement dans le process exécuteur (cf. §3 du plan, dernier
    paragraphe : "le process principal n'a plus besoin de connaître
    _namespaces_isoles du tout pour les profils isolés"). Conservés en
    paramètres plutôt que supprimés pour ne pas casser le seul site
    d'appel existant sans raison -- un futur nettoyage pourra les retirer
    si aucun autre appelant n'apparaît."""
    log.info(
        f"[sAutoniax] notebook distant sur profil ISOLÉ (session={session_id}, "
        f"instance_id={instance_id!r}) : exécution démarrée (délégation réseau vers l'exécuteur)."
    )
    horodatage_debut_exec = time.time()

    # --- Étape 1 : s'assurer qu'un exécuteur tourne pour cet instance_id ---
    proc_executeur = _executeurs_isoles.get(instance_id) if _executeurs_isoles is not None else None
    executeur_vient_d_etre_lance = False
    if proc_executeur is None or proc_executeur.poll() is not None:
        if proc_executeur is not None:
            log.warning(
                f"[sAutoniax] exécuteur '{instance_id}' trouvé mort (code={proc_executeur.poll()}) -- relance."
            )
            if _executeurs_isoles is not None:
                _executeurs_isoles.pop(instance_id, None)
        try:
            proc_executeur, _pret_ignore = _sautoniax_lancer_executeur_isole(instance_id, _executeurs_isoles)
        except OSError as e:
            message_erreur = f"impossible de lancer l'exécuteur pour '{instance_id}' : {e!r}"
            log.error(f"[sAutoniax] {message_erreur}")
            client_t.envoyer_notebook_distant_resultat(
                session_id, id_pilote, False, message_erreur,
                horodatage_debut=horodatage_debut_exec, horodatage_fin=time.time(),
            )
            return
        executeur_vient_d_etre_lance = True
    else:
        _ev_pret = _EXECUTEURS_PRETS.get(instance_id)
        if _ev_pret is not None and not _ev_pret.is_set():
            executeur_vient_d_etre_lance = True      # v7 : lancé à l'avance (démarrage du profil / après « Arrêter »), encore en train de se connecter

    # --- Étape 2 : envoyer la cellule, avec retry court si l'exécuteur ---
    # vient d'être lancé et n'a pas encore fini de se connecter au
    # serveur local (cf. §8 du plan, point ouvert "attente prêt" -- ACK
    # implicite retenu : srv_gerer_executer_code répond IMMÉDIATEMENT
    # {"ok": False, "erreur": "exécuteur ... introuvable"} si la
    # connexion "executeur" n'existe pas encore côté serveur local, cf.
    # sa docstring -- ce refus explicite sert de signal de retry ici,
    # pas besoin d'un message "executeur_pret" séparé).
    requete_id = uuid.uuid4().hex[:12]
    event = threading.Event()
    boite_resultat: dict = {}
    if _callbacks_executer_code_en_attente is not None:
        # CORRECTIF (fuite tâche/thread confirmée en usage réel -- cf. logs
        # "DIAG-CONCURRENCE" affichant 1+ tâche en vol au lieu de 0 sur une
        # même instance après un "Arrêter" pendant qu'une cellule tournait
        # réellement, pas juste pendant la phase de connexion exécuteur) :
        # instance_id ajouté en 3e élément du tuple pour permettre à
        # _sur_arreter_execution_profil_demande de retrouver et débloquer
        # explicitement CETTE requête précise (event.set() avec un résultat
        # d'échec) au moment du terminate()/kill(), au lieu de laisser le
        # event.wait() sans timeout de l'étape 3 ci-dessous bloqué à vie --
        # ce qui fuyait la tâche asyncio (jamais "done", jamais retirée de
        # _taches_projets_en_cours) et le thread run_in_executor associé.
        _callbacks_executer_code_en_attente[requete_id] = (event, boite_resultat, instance_id)

    TIMEOUT_CONNEXION_EXECUTEUR_S = 120.0   # PATCH : 30 s était trop court sur Colab/Kaggle (imports lourds du nouveau process, >30 s possible)
    DELAI_RETRY_S = 0.5
    DELAI_DECISION_S = 2.0
    t0_connexion = time.monotonic()
    while True:
        client_pilote_instances.envoyer_executer_code(
            instance_id, requete_id, code,
            session_id=session_id, id_pilote=id_pilote, services_api_lies=services_api_lies,
            reinitialiser_result_color=reinitialiser_result_color,
            lire_result_color_finale=lire_result_color_finale,
        )
        # Attente courte -- juste assez pour distinguer un refus "exécuteur
        # introuvable" immédiat (l'exécuteur vient d'être lancé et n'a pas
        # fini de se connecter) d'une vraie exécution en cours (qui peut
        # légitimement prendre beaucoup plus longtemps, cf. docstring
        # "pas de timeout d'exécution" -- cette boucle ne s'applique QUE
        # tant qu'aucune réponse n'est encore arrivée du tout).
        # PATCH (bug : la MÊME cellule était renvoyée toutes les 0,5 s à un exécuteur déjà connecté, donc exécutée des dizaines de
        # fois en parallèle, puis « ne s'est pas connecté dans les 30s » alors qu'il l'était). Un refus « introuvable » arrive en
        # quelques ms : si rien n'est revenu après DELAI_DECISION_S, la cellule est DÉJÀ chez l'exécuteur -> on ne la renvoie plus.
        obtenu = await loop.run_in_executor(None, event.wait, DELAI_DECISION_S)
        if obtenu:
            # CORRECTIF (bug confirmé en usage réel -- cf. logs : "exécuteur
            # ... introuvable ou déconnecté" systématique sur le premier
            # executer_notebook_distant après le lancement de l'exécuteur,
            # jamais suivi d'un retry malgré le mécanisme décrit ci-dessus) :
            # srv_gerer_executer_code répond IMMÉDIATEMENT (quelques ms, bien
            # avant DELAI_RETRY_S) quand l'exécuteur ne s'est pas encore
            # connecté -- ce refus arrive par le MÊME canal (executer_code_
            # resultat_recu) qu'un vrai résultat de cellule, et event.wait()
            # ci-dessus devient donc True immédiatement, PAS après le délai
            # complet. Sans ce test, `break` s'exécutait à tort sur ce refus
            # précoce dès la toute première itération -- la boucle de retry
            # n'a donc jamais eu l'occasion de se déclencher, exactement le
            # symptôme observé. srv_gerer_executer_code pose désormais
            # data["executeur_introuvable"]=True sur CE refus précis (cf. sa
            # docstring) : seul ce cas doit reformer la boucle, jamais un
            # vrai résultat de cellule (ok=False "normal", ex. exception
            # utilisateur dans le code) ni la branche executeur_vient_d_etre_
            # lance=False juste en dessous (exécuteur déjà vivant qui met du
            # temps à répondre -- pas un problème de connexion).
            if (
                executeur_vient_d_etre_lance
                and boite_resultat.get("data", {}).get("executeur_introuvable")
            ):
                if time.monotonic() - t0_connexion <= TIMEOUT_CONNEXION_EXECUTEUR_S:
                    event.clear()
                    boite_resultat.clear()
                    await asyncio.sleep(DELAI_RETRY_S)
                    continue
                message_erreur = (
                    f"l'exécuteur '{instance_id}' ne s'est pas connecté au serveur local "
                    f"dans les {TIMEOUT_CONNEXION_EXECUTEUR_S:.0f}s -- abandon."
                )
                log.error(f"[sAutoniax] {message_erreur}")
                if _callbacks_executer_code_en_attente is not None:
                    _callbacks_executer_code_en_attente.pop(requete_id, None)
                client_t.envoyer_notebook_distant_resultat(
                    session_id, id_pilote, False, message_erreur,
                    horodatage_debut=horodatage_debut_exec, horodatage_fin=time.time(),
                )
                return
            break
        # Aucun refus reçu : la cellule est chez l'exécuteur et s'exécute. Jamais renvoyée (cf. PATCH ci-dessus).
        break

    # --- Étape 3 : attente bloquante, SANS timeout d'exécution (cf. §4/§8
    # du plan) -- seul un "Arrêter" explicite (terminate() du Popen,
    # cf. arreter_execution_profil/_sur_kill_profil_demande) doit
    # interrompre une cellule en cours. event a pu être déjà signalé par
    # la boucle de retry ci-dessus (cas normal, la première ou une des
    # premières tentatives aboutit) -- ce second wait() sans timeout ne
    # bloque alors pas du tout (event déjà set()).
    if not event.is_set():
        await loop.run_in_executor(None, event.wait)
    if _callbacks_executer_code_en_attente is not None:
        _callbacks_executer_code_en_attente.pop(requete_id, None)
    horodatage_fin_exec = time.time()
    # [SYNC-DIAG] heure de fin côté sAutoniax : résultat de l'exécuteur reçu vs réveil de la coroutine
    _t_recu_diag = boite_resultat.get("t_recu_diag")
    log_sync_diag.info(
        f"[SYNC-DIAG][sAutoniax] FIN EXECUTEUR session={session_id!r} instance={instance_id!r} "
        f"| résultat reçu de l'exécuteur à {_sync_diag_hms(_t_recu_diag)} "
        f"| coroutine réveillée à {_sync_diag_hms(horodatage_fin_exec)} "
        f"(délai de réveil {_sync_diag_ecart(_t_recu_diag, horodatage_fin_exec)})"
    )

    data_resultat = boite_resultat.get("data")
    if data_resultat is None:
        # Ne devrait jamais arriver (event.wait() sans timeout n'est
        # levé QUE par _sur_executer_code_resultat_recu, qui pose
        # toujours boite_resultat["data"] avant event.set()) -- filet de
        # sécurité défensif seulement.
        message_erreur = f"réponse vide de l'exécuteur '{instance_id}' (requete_id={requete_id!r})."
        log.error(f"[sAutoniax] {message_erreur}")
        client_t.envoyer_notebook_distant_resultat(
            session_id, id_pilote, False, message_erreur,
            horodatage_debut=horodatage_debut_exec, horodatage_fin=horodatage_fin_exec,
        )
        return

    ok = bool(data_resultat.get("ok"))
    erreur = data_resultat.get("erreur", "") or ""
    sortie = data_resultat.get("sortie", "") or ""
    result_color_a_transmettre = data_resultat.get("result_color") if lire_result_color_finale else None
    result_output_a_transmettre = data_resultat.get("result_output") if lire_result_color_finale else None

    if ok:
        if sortie:
            client_t.envoyer_notebook_distant_log(session_id, id_pilote, sortie)
        client_t.envoyer_notebook_distant_resultat(
            session_id, id_pilote, True, "",
            horodatage_debut=horodatage_debut_exec, horodatage_fin=horodatage_fin_exec,
            result_color=result_color_a_transmettre,
            result_output=result_output_a_transmettre,
        )
        log.info(f"[sAutoniax] notebook distant (profil isolé) terminé avec succès (session={session_id}).")
    else:
        if sortie:
            client_t.envoyer_notebook_distant_log(session_id, id_pilote, sortie)
        client_t.envoyer_notebook_distant_log(session_id, id_pilote, erreur)
        client_t.envoyer_notebook_distant_resultat(
            session_id, id_pilote, False, erreur,
            horodatage_debut=horodatage_debut_exec, horodatage_fin=horodatage_fin_exec,
            result_color=result_color_a_transmettre,
        )
        log.warning(f"[sAutoniax] échec notebook distant (profil isolé, session={session_id}) : {erreur}")


# ---------------------------------------------------------------------------
# PATCH (SPEC_proxy_natif_tunnel.md, sections 5 et 6) -- "Proxy natif" :
# RelaisProxyLocal, côté sAutoniaX. Petit serveur TCP local générique
# (aucune connaissance de Chrome/Camoufox, cf. section 6 : "réutilisable
# si un jour vous ajoutez SOCKS5") qui traduit les requêtes HTTP CONNECT/
# GET du navigateur en frames de tunnel envoyées sur /ws_tunnel, relayées
# jusqu'au ServiceSortieProxy du mAutoniaX (section 7) qui ouvre la vraie
# connexion TCP avec SA propre connexion internet.
#
# Un seul RelaisProxyLocal par process sAutoniaX (pas un par profil) :
# section 3 -- "une connexion /ws_tunnel par sAutoniaX actif" suffit,
# plusieurs profils qui utilisent tous le proxy natif partagent le même
# tunnel physique, multiplexé par stream_id. Le port TCP local, lui, EST
# par profil (section 6 : "port choisi dynamiquement... communiqué au
# navigateur au lancement du profil concerné") -- un seul asyncio.
# start_server par profil actif en proxy natif, mais un seul WebSocket
# /ws_tunnel partagé entre tous.
# ---------------------------------------------------------------------------

# Types de trame (section 5) -- mêmes valeurs EXACTES que côté serveur.py
# (RegistreTunnel/route_websocket_tunnel), ce ne sont que des constantes
# protocolaires, aucune dépendance de code entre les deux fichiers.
TAILLE_ENTETE_TRAME_TUNNEL = 5  # 1 octet type + 4 octets stream_id big-endian
TYPE_TRAME_OPEN = 0x01
TYPE_TRAME_OPEN_OK = 0x02
TYPE_TRAME_OPEN_FAIL = 0x03
TYPE_TRAME_DATA = 0x04
TYPE_TRAME_CLOSE = 0x05
# AJOUT (revue de bout en bout -- point trouvé : /ws_tunnel n'avait
# AUCUN moyen de détecter une coupure réseau brutale des deux côtés, le
# ping natif websockets étant désactivé (ping_interval=None sur les deux
# websockets.connect ci-dessous, ET globalement côté serveur -- cf.
# serveur.py, uvicorn.run, désactivé pour un tout autre bug déjà corrigé
# sur /ws avec les gros transferts, donc jamais réactivable juste pour
# ce canal). PING/PONG binaires dédiés, cf. serveur.py pour le protocole
# symétrique complet (réponse PONG immédiate côté serveur, jamais
# relayé à l'autre bout du tunnel).
TYPE_TRAME_PING = 0x06
TYPE_TRAME_PONG = 0x07
# HISTORIQUE (demande utilisateur : notifier l'heure du mAutoniax au
# toggle proxy natif -- cf. discussion "pourquoi mautoniax ne donne pas
# lui meme la date directement") -- deux itérations de trames binaires
# dédiées sur CE canal /ws_tunnel (HORLOGE spontanée à la connexion,
# puis HORLOGE_DEMANDE en demande/réponse) se sont révélées toutes deux
# fragiles pour la même raison de fond : /ws_tunnel est un canal
# ÉPHÉMÈRE, ouvert paresseusement par CHAQUE côté indépendamment au
# moment du toggle, sans AUCUNE garantie sur l'ordre ni le délai de
# connexion des deux tunnels l'un par rapport à l'autre (cf. bugs
# constatés : mAutoniax démarrant après le sAutoniax de façon
# structurelle, ou pire, la demande du sAutoniax partant AVANT que le
# pilote ne soit même connecté côté serveur). Remplacé par demander_
# horloge_mautoniax/horloge_mautoniax_resultat sur le canal /ws JSON
# standard (cf. ClientServeurT, RelaisProxyLocal.obtenir_horloge_
# mautoniax) -- déjà connecté en permanence des deux côtés dès le
# démarrage du process, bien avant tout toggle proxy natif. Les
# anciennes valeurs 0x08/0x09 (TYPE_TRAME_HORLOGE/TYPE_TRAME_HORLOGE_
# DEMANDE) sont volontairement laissées libres (non réattribuées)
# plutôt que réutilisées, au cas où un ancien mAutoniax/sAutoniax non
# mis à jour enverrait encore l'une d'elles par erreur.
STREAM_ID_HEARTBEAT_TUNNEL = 0  # convention -- jamais un vrai stream_id de flux (les compteurs démarrent à 1)
DELAI_HEARTBEAT_TUNNEL_SECONDES = 15.0  # même valeur que DELAI_HEARTBEAT_SECONDES (ClientServeurT), pour cohérence

DELAI_TIMEOUT_OPEN_TUNNEL_SECONDES = 10.0  # cf. section 6, point 3


def _construire_trame_tunnel(type_trame: int, stream_id: int, payload: bytes = b"") -> bytes:
    return bytes([type_trame]) + stream_id.to_bytes(4, "big") + payload


def _lire_entete_trame_tunnel(trame: bytes) -> tuple[int, int, bytes]:
    type_trame = trame[0]
    stream_id = int.from_bytes(trame[1:5], "big")
    payload = trame[TAILLE_ENTETE_TRAME_TUNNEL:]
    return type_trame, stream_id, payload


def _horloge_locale_iso_et_fuseau() -> tuple[str, str]:
    """Calcule l'heure ISO locale DE LA MACHINE QUI APPELLE CETTE
    FONCTION (le mAutoniax, appelée depuis ClientServeurT._traiter_
    message en réponse à demander_horloge_mautoniax, cf. sa docstring
    et celle de RelaisProxyLocal.obtenir_horloge_mautoniax pour le
    mécanisme complet). datetime.now().astimezone() attache le fuseau
    système courant sans requête réseau ni lookup GeoLite2/ip-api.com --
    c'est tout le point de ce mécanisme (cf. discussion "pourquoi
    mautoniax ne donne pas lui meme la date directement"). Le nom IANA
    (ex. "Europe/Paris") n'est pas toujours déductible d'un datetime
    aware (tzname() peut renvoyer une abréviation courte comme "CET"
    selon la plateforme) -- laissé vide plutôt que d'envoyer une valeur
    trompeuse si non disponible. Retourne (iso_local, nom_fuseau),
    nom_fuseau potentiellement vide."""
    maintenant = datetime.now().astimezone()
    iso_local = maintenant.isoformat(timespec="seconds")
    try:
        nom_fuseau = str(maintenant.tzinfo) if maintenant.tzinfo is not None else ""
    except Exception:
        nom_fuseau = ""
    return iso_local, nom_fuseau


class RelaisProxyLocal:
    """PATCH (SPEC_proxy_natif_tunnel.md, section 6) -- un par process
    sAutoniaX (créé paresseusement dans _main_async_sautoniax, cf. son
    docstring), démarré à la toute première activation du proxy natif
    sur N'IMPORTE QUEL profil de ce sAutoniaX.

    Porte :
    - la connexion /ws_tunnel elle-même (une seule, partagée par tous
      les profils "proxy natif" de ce sAutoniaX, cf. docstring de
      module ci-dessus) -- ouverte paresseusement, reconnectée
      automatiquement si coupée tant qu'au moins un profil en a besoin ;
    - un asyncio.start_server par profil actif en proxy natif (port
      choisi dynamiquement via bind(('127.0.0.1', 0)), cf. section 6) ;
    - le compteur de stream_id local (un seul pour tout ce sAutoniaX,
      partagé entre tous les profils -- section 5 : "généré par le
      sAutoniaX... unique tant que le flux est ouvert", rien n'exige
      qu'il soit par profil) et la table stream_id -> StreamWriter du
      navigateur, pour router un DATA/CLOSE entrant vers le bon socket
      local.

    Ne connaît RIEN à Chrome/Camoufox (cf. section 6, dernier
    paragraphe) -- un profil qui veut le proxy natif reçoit juste un
    port local (127.0.0.1:<port>) à donner à --proxy-server, exactement
    comme un proxy externe classique (cf. obtenir_proxy_effectif_
    profil ci-dessous, qui construit ce dict au même format que
    `proxy` externe)."""

    def __init__(self, client_t: "ClientServeurT", loop: asyncio.AbstractEventLoop):
        self._client_t = client_t
        self._loop = loop
        self._ws_tunnel: Optional["websockets.WebSocketClientProtocol"] = None
        self._tache_ws_tunnel: Optional[asyncio.Task] = None
        # AJOUT (cf. docstring de TYPE_TRAME_PING) -- tâche de heartbeat
        # binaire dédiée, séparée de _tache_ws_tunnel (réception) : émet
        # un PING périodique tant que _ws_tunnel existe, seul moyen pour
        # le serveur de savoir que cette connexion est encore vivante
        # (cf. serveur.py, route_websocket_tunnel, wait_for/timeout).
        self._tache_heartbeat_tunnel: Optional[asyncio.Task] = None
        self._prochain_stream_id = 1
        self._writers_par_stream: dict[int, asyncio.StreamWriter] = {}
        # OPEN_OK/OPEN_FAIL en attente, par stream_id -- posé par
        # _gerer_connexion_navigateur juste après OPEN, résolu par
        # _boucle_reception_tunnel dès que la réponse arrive (cf.
        # section 6, point 3 : timeout court, le mAutoniaX peut être
        # lent/déconnecté).
        self._attentes_open: dict[int, asyncio.Future] = {}
        # nom_profil -> (asyncio.Server, port) -- un serveur TCP local
        # par profil actuellement en proxy natif actif ET démarré.
        self._serveurs_par_profil: dict[str, tuple[asyncio.base_events.Server, int]] = {}
        # PATCH (section 4 -- "le pilote propriétaire de ce tunnel") :
        # posé par l'appelant (cf. _sur_toggle_proxy_natif_demande côté
        # _main_async_sautoniax) AVANT tout appel à obtenir_port_local,
        # lu par _id_pilote_stable_cible ci-dessous. Attribut d'INSTANCE
        # (pas de classe) -- un RelaisProxyLocal par process sAutoniaX,
        # cf. docstring de classe, donc aucun risque de partage entre
        # deux sAutoniaX différents, mais gardé explicite ici plutôt que
        # posé en dehors de __init__ pour éviter toute ambiguïté.
        self.dernier_id_pilote_connu: str = ""

    async def obtenir_port_local(self, nom_profil: str) -> int:
        """Démarre (si pas déjà fait) le serveur TCP local dédié à ce
        profil, et s'assure que la connexion /ws_tunnel est ouverte --
        retourne le port local à utiliser dans --proxy-server. Idempotent
        : un profil déjà démarré retourne directement son port existant
        sans rien recréer."""
        existant = self._serveurs_par_profil.get(nom_profil)
        if existant is not None:
            return existant[1]

        await self._assurer_connexion_tunnel()

        async def _gerer(reader: asyncio.StreamReader, writer: asyncio.StreamWriter):
            await self._gerer_connexion_navigateur(reader, writer)

        serveur = await asyncio.start_server(_gerer, host="127.0.0.1", port=0)
        port = serveur.sockets[0].getsockname()[1]
        self._serveurs_par_profil[nom_profil] = (serveur, port)
        log.info(f"[sAutoniax] RelaisProxyLocal : port local {port} ouvert pour le profil '{nom_profil}'.")
        return port

    async def obtenir_horloge_mautoniax(self, delai_max_secondes: float = DELAI_TIMEOUT_OPEN_TUNNEL_SECONDES) -> Optional[tuple[str, str]]:
        """REVU (cf. section historique juste avant demander_horloge_
        mautoniax/horloge_mautoniax_resultat, tout en haut de ce fichier
        -- migration depuis /ws_tunnel vers /ws JSON standard) --
        remplace l'ancien flux _detecter_fuseau_horaire_via_proxy_sync
        (requête ip-api.com à travers le tunnel 127.0.0.1:<port> tout
        juste ouvert, cf. section 6 -- point de départ du bug de timeout
        OPEN), PUIS deux itérations de trames binaires dédiées sur
        /ws_tunnel (HORLOGE spontanée, puis HORLOGE_DEMANDE en demande/
        réponse), toutes deux fragiles pour la même raison de fond :
        /ws_tunnel est un canal ÉPHÉMÈRE, ouvert paresseusement par
        CHAQUE côté indépendamment au moment du toggle, sans AUCUNE
        garantie sur l'ordre ni le délai de connexion des deux tunnels
        l'un par rapport à l'autre (cf. bugs constatés : mAutoniax
        démarrant après le sAutoniax de façon structurelle, ou pire, la
        demande du sAutoniax partant AVANT que le pilote ne soit même
        connecté côté serveur -- registre_tunnel.pilotes_tunnel.get()
        retournant None, une demande one-shot jamais réémise).

        Ici, passe entièrement par le canal /ws JSON standard (déjà
        connecté en permanence des deux côtés dès le démarrage du
        process, bien avant tout toggle proxy natif -- c'est exactement
        lui qui porte déjà demander_toggle_proxy_natif/demander_profils_
        sautoniax) via ClientServeurT.demander_horloge_mautoniax, cible
        `self.dernier_id_pilote_connu` (posé par l'appelant AVANT tout
        appel à obtenir_port_local, cf. docstring de classe). Aucune
        dépendance à l'état ou à l'ordre de connexion de /ws_tunnel --
        ce mécanisme fonctionne même si le proxy natif n'a jamais été
        activé.

        Retourne (iso_local, nom_fuseau) tel que reçu, ou None si :
        - aucun id_pilote n'est connu (dernier_id_pilote_connu vide) ;
        - le client /ws n'est pas connecté au moment de l'envoi ;
        - la réponse n'est pas arrivée dans les delai_max_secondes
          (pilote trop vieux ne traitant pas encore demander_horloge_
          mautoniax -- compatibilité arrière -- OU écart anormalement
          long, ex. réseau très dégradé côté pilote -- cf. côté
          appelant, qui doit alors logguer un simple avertissement
          plutôt que planter, même filet de sécurité que l'ancien
          "fuseau_mautoniax non déterminé")."""
        if not self.dernier_id_pilote_connu:
            return None
        future_cf = self._client_t.demander_horloge_mautoniax(self.dernier_id_pilote_connu)
        try:
            iso_local, nom_fuseau = await asyncio.wait_for(
                asyncio.wrap_future(future_cf), timeout=delai_max_secondes,
            )
        except (asyncio.TimeoutError, Exception):
            return None
        return iso_local, nom_fuseau

    async def arreter_pour_profil(self, nom_profil: str):
        """PATCH (cohérence avec 13.5 -- un profil désactivé ou dont le
        proxy natif est désactivé n'a plus besoin de son serveur TCP
        local). Ferme le asyncio.Server dédié, laisse la connexion
        /ws_tunnel elle-même ouverte (partagée, cf. docstring de
        classe) tant qu'un AUTRE profil l'utilise encore -- fermée
        seulement par arreter_tout ci-dessous."""
        existant = self._serveurs_par_profil.pop(nom_profil, None)
        if existant is None:
            return
        serveur, port = existant
        serveur.close()
        try:
            await serveur.wait_closed()
        except Exception:
            pass
        log.info(f"[sAutoniax] RelaisProxyLocal : port local {port} fermé pour le profil '{nom_profil}'.")

    async def arreter_tout(self):
        """Ferme TOUS les serveurs TCP locaux + la connexion /ws_tunnel
        -- appelé à l'arrêt du process sAutoniaX (cf. finally de
        _main_async_sautoniax)."""
        for nom_profil in list(self._serveurs_par_profil.keys()):
            await self.arreter_pour_profil(nom_profil)
        if self._tache_ws_tunnel is not None:
            self._tache_ws_tunnel.cancel()
            self._tache_ws_tunnel = None
        if self._tache_heartbeat_tunnel is not None:
            self._tache_heartbeat_tunnel.cancel()
            self._tache_heartbeat_tunnel = None
        if self._ws_tunnel is not None:
            try:
                await self._ws_tunnel.close()
            except Exception:
                pass
            self._ws_tunnel = None

    async def _assurer_connexion_tunnel(self):
        if self._ws_tunnel is not None:
            return
        if websockets is None:
            raise RuntimeError("Le paquet 'websockets' n'est pas installé -- proxy natif indisponible.")
        # Même URL que /ws, juste un chemin différent (cf. section 3 :
        # "deuxième connexion WebSocket, binaire, dédiée" sur le MÊME
        # serveurT) -- resoudre_url_serveurt() retourne "wss://.../ws",
        # on substitue le suffixe.
        url_ws = resoudre_url_serveurt()
        if url_ws.endswith("/ws"):
            url_tunnel = url_ws[: -len("/ws")] + "/ws_tunnel"
        else:
            url_tunnel = url_ws.rstrip("/") + "/ws_tunnel"
        self._ws_tunnel = await websockets.connect(url_tunnel, max_size=None, ping_interval=None)
        await self._ws_tunnel.send(json.dumps({
            "role": "executant",
            "id_pilote_stable": self._id_pilote_stable_cible(),
            "id_executant": self._client_t.nom,
        }))
        log.info(f"[sAutoniax] RelaisProxyLocal : /ws_tunnel connecté ({url_tunnel}).")
        self._tache_ws_tunnel = self._loop.create_task(self._boucle_reception_tunnel())
        # AJOUT (cf. docstring de TYPE_TRAME_PING) -- même connexion,
        # tâche séparée : le serveur détecte un silence de plus de
        # SEUIL_SILENCE_SUSPECT_TUNNEL_SECONDES (35s côté serveur.py) et
        # ferme lui-même la connexion dans ce cas, donc CETTE tâche doit
        # tourner tant que _ws_tunnel existe, indépendamment de l'activité
        # DATA (qui peut légitimement s'interrompre entre deux requêtes du
        # navigateur sans que la connexion tunnel elle-même soit morte).
        self._tache_heartbeat_tunnel = self._loop.create_task(self._boucle_heartbeat_tunnel())

    def _id_pilote_stable_cible(self) -> str:
        """PATCH (section 4 -- "le pilote propriétaire de ce tunnel") :
        le sAutoniaX ne peut tunneliser que pour le pilote qui l'a
        démarré/possède ses profils actifs -- cf. 13.3, id_pilote reçu
        avec chaque demander_toggle_proxy_natif. Le dernier id_pilote
        vu suffit (un sAutoniaX n'exécute des profils que pour un seul
        pilote à la fois, cf. contrainte actuelle documentée section 4)
        -- posé par _sur_toggle_proxy_natif_demande via
        self.dernier_id_pilote_connu avant d'appeler obtenir_port_local."""
        return self.dernier_id_pilote_connu

    async def _gerer_connexion_navigateur(self, reader: asyncio.StreamReader, writer: asyncio.StreamWriter):
        """PATCH (section 6, points 1 à 4) -- une tâche par connexion
        TCP entrante (= le navigateur). Détecte CONNECT (https) vs
        requête HTTP en clair, alloue un stream_id, ouvre le tunnel,
        relaie ensuite les octets bruts dans les deux sens jusqu'à
        CLOSE ou coupure."""
        stream_id = self._prochain_stream_id
        self._prochain_stream_id += 1
        premiere_ligne = b""
        reste_apres_premiere_ligne = b""
        try:
            premiere_ligne = await reader.readline()
        except Exception:
            writer.close()
            return
        if not premiere_ligne:
            writer.close()
            return

        est_connect = premiere_ligne.upper().startswith(b"CONNECT ")
        if est_connect:
            # "CONNECT host:port HTTP/1.1" -- on consomme le reste des
            # en-têtes CONNECT (jusqu'à la ligne vide) sans les relayer :
            # ils ne concernent que ce proxy local lui-même, pas la
            # requête HTTPS réelle qui suivra une fois le tunnel TLS
            # établi (cf. section 6, point 1).
            try:
                cible = premiere_ligne.split()[1].decode("ascii", errors="replace")
                host, _, port_texte = cible.rpartition(":")
                port = int(port_texte) if port_texte else 443
            except Exception:
                writer.close()
                return
            while True:
                ligne = await reader.readline()
                if ligne in (b"\r\n", b"\n", b""):
                    break
        else:
            # Requête HTTP en clair -- parse le host depuis la ligne de
            # requête (section 6, point 2), relaie la ligne elle-même
            # TELLE QUELLE en premier payload DATA (rien n'est jeté,
            # contrairement au cas CONNECT ci-dessus).
            #
            # BUGFIX (log constaté en usage réel : RemoteDisconnected
            # systématique sur TOUTE requête http:// en clair sans port
            # explicite dans l'URL, ex. "http://ip-api.com/json/..." --
            # pas seulement ip-api.com, ce bug touchait potentiellement
            # tout le trafic HTTP réel qui passe par ce relais) --
            # host_port.rpartition(":") sur "ip-api.com" (AUCUN ":"
            # dedans, port implicite 80) renvoie ("", "", "ip-api.com") :
            # rpartition ne trouvant pas le séparateur place TOUTE la
            # chaîne dans le 3e élément, pas dans le premier. `host`
            # valait donc "" (chaîne vide) -- `if not host:` fermait
            # alors la connexion SANS RÉPONSE avant même d'atteindre
            # int(port_texte), ce qui produisait exactement le
            # RemoteDisconnected observé côté client (connexion acceptée
            # puis fermée sans un seul octet de réponse HTTP). Un host
            # AVEC port explicite ("exemple.com:8080") ne déclenchait
            # jamais ce bug, d'où sa découverte tardive.
            #
            # Correctif : ":" absent de host_port => host_port EST le
            # host tel quel, port implicite 80 -- jamais de rpartition
            # aveugle. rfind(":") plutôt que rpartition/split pour
            # rester correct même sur un host IPv6 entre crochets
            # ("[::1]:8080" -- rfind trouve le DERNIER ":", celui du
            # port, jamais un des ":" internes à l'adresse IPv6).
            try:
                cible = premiere_ligne.split()[1].decode("ascii", errors="replace")
            except Exception:
                writer.close()
                return
            if cible.startswith("http://"):
                sans_schema = cible[len("http://"):]
                host_port, _, _ = sans_schema.partition("/")
            else:
                host_port = ""
            if not host_port:
                writer.close()
                return
            position_deux_points = host_port.rfind(":")
            if position_deux_points == -1:
                host, port_texte = host_port, ""
            else:
                host, port_texte = host_port[:position_deux_points], host_port[position_deux_points + 1:]
            if not host:
                writer.close()
                return
            try:
                port = int(port_texte) if port_texte else 80
            except ValueError:
                writer.close()
                return
            reste_apres_premiere_ligne = premiere_ligne

        self._writers_par_stream[stream_id] = writer
        future_open = self._loop.create_future()
        self._attentes_open[stream_id] = future_open
        try:
            await self._ws_tunnel.send(_construire_trame_tunnel(
                TYPE_TRAME_OPEN, stream_id,
                len(host).to_bytes(1, "big") + host.encode("utf-8") + port.to_bytes(2, "big"),
            ))
        except Exception as e:
            log.warning(f"[sAutoniax] RelaisProxyLocal : envoi OPEN échoué (stream {stream_id}) : {e!r}")
            self._nettoyer_stream(stream_id)
            writer.close()
            return

        try:
            ouvert = await asyncio.wait_for(future_open, timeout=DELAI_TIMEOUT_OPEN_TUNNEL_SECONDES)
        except asyncio.TimeoutError:
            log.warning(f"[sAutoniax] RelaisProxyLocal : timeout OPEN vers {host}:{port} (stream {stream_id}).")
            self._nettoyer_stream(stream_id)
            writer.close()
            return
        finally:
            self._attentes_open.pop(stream_id, None)

        if not ouvert:
            self._nettoyer_stream(stream_id)
            writer.close()
            return

        if est_connect:
            writer.write(b"HTTP/1.1 200 Connection Established\r\n\r\n")
            await writer.drain()
        elif reste_apres_premiere_ligne:
            # Requête HTTP en clair : le premier payload DATA porte la
            # requête telle quelle (cf. section 6, point 2) -- le reste
            # (corps éventuel, requêtes suivantes du même keep-alive)
            # suit dans la boucle de relais ci-dessous, sans distinction.
            try:
                await self._ws_tunnel.send(_construire_trame_tunnel(TYPE_TRAME_DATA, stream_id, reste_apres_premiere_ligne))
            except Exception:
                self._nettoyer_stream(stream_id)
                writer.close()
                return

        # Relais pur : tout ce qui arrive du navigateur devient DATA
        # sortant (section 6, point 3, fin). _boucle_reception_tunnel
        # gère le sens inverse (DATA entrant -> ce writer).
        try:
            while True:
                donnees = await reader.read(65536)
                if not donnees:
                    break
                await self._ws_tunnel.send(_construire_trame_tunnel(TYPE_TRAME_DATA, stream_id, donnees))
        except Exception:
            pass
        finally:
            # Connexion TCP locale fermée par le navigateur (section 6,
            # point 4) -- prévient l'autre bout symétriquement.
            if stream_id in self._writers_par_stream:
                try:
                    await self._ws_tunnel.send(_construire_trame_tunnel(TYPE_TRAME_CLOSE, stream_id))
                except Exception:
                    pass
            self._nettoyer_stream(stream_id)
            writer.close()

    def _nettoyer_stream(self, stream_id: int):
        self._writers_par_stream.pop(stream_id, None)
        self._attentes_open.pop(stream_id, None)

    async def _boucle_reception_tunnel(self):
        """Tâche de fond, une par connexion /ws_tunnel -- lit les frames
        entrantes (DATA/OPEN_OK/OPEN_FAIL/CLOSE en provenance du
        mAutoniaX, via le serveurT) et les route vers le bon writer
        local (section 6, point 3, fin ; point 4)."""
        try:
            while True:
                trame = await self._ws_tunnel.recv()
                if isinstance(trame, str) or len(trame) < TAILLE_ENTETE_TRAME_TUNNEL:
                    continue
                type_trame, stream_id, payload = _lire_entete_trame_tunnel(trame)
                if type_trame == TYPE_TRAME_OPEN_OK:
                    future = self._attentes_open.get(stream_id)
                    if future is not None and not future.done():
                        future.set_result(True)
                elif type_trame == TYPE_TRAME_OPEN_FAIL:
                    future = self._attentes_open.get(stream_id)
                    if future is not None and not future.done():
                        future.set_result(False)
                elif type_trame == TYPE_TRAME_DATA:
                    writer = self._writers_par_stream.get(stream_id)
                    if writer is not None:
                        try:
                            writer.write(payload)
                            await writer.drain()
                        except Exception:
                            self._nettoyer_stream(stream_id)
                elif type_trame == TYPE_TRAME_CLOSE:
                    writer = self._writers_par_stream.pop(stream_id, None)
                    self._attentes_open.pop(stream_id, None)
                    if writer is not None:
                        writer.close()
                elif type_trame == TYPE_TRAME_PONG:
                    # Réponse à notre propre PING (cf. _boucle_heartbeat_
                    # tunnel) -- rien à faire, la seule preuve de vie
                    # utile est déjà le fait d'avoir reçu N'IMPORTE QUELLE
                    # trame ici (cf. .recv() qui débloque cette boucle),
                    # pas besoin de suivre un compteur de PONG en attente.
                    pass
                # TYPE_TRAME_PING volontairement absent : le serveur ne
                # PING jamais lui-même (cf. serveur.py, docstring de
                # route_websocket_tunnel) -- seuls les clients initient.
        except Exception as e:
            log.warning(f"[sAutoniax] RelaisProxyLocal : connexion /ws_tunnel perdue ({e!r}).")
        finally:
            self._ws_tunnel = None
            if self._tache_heartbeat_tunnel is not None:
                self._tache_heartbeat_tunnel.cancel()
                self._tache_heartbeat_tunnel = None
            # Toute connexion en attente d'OPEN_OK/OPEN_FAIL au moment
            # de la coupure ne recevra jamais de réponse -- résolue en
            # échec explicitement plutôt que de laisser le timeout de
            # DELAI_TIMEOUT_OPEN_TUNNEL_SECONDES faire le travail (plus
            # rapide pour le navigateur, qui voit l'échec immédiatement).
            for future in self._attentes_open.values():
                if not future.done():
                    future.set_result(False)
            self._attentes_open.clear()

    async def _boucle_heartbeat_tunnel(self):
        """AJOUT (cf. docstring de TYPE_TRAME_PING) -- envoie un PING
        toutes les DELAI_HEARTBEAT_TUNNEL_SECONDES tant que _ws_tunnel
        existe. Ne lit jamais de réponse elle-même (cf. _boucle_
        reception_tunnel, qui traite le PONG au passage comme n'importe
        quelle autre trame) -- son seul rôle est l'ÉMISSION périodique,
        symétrique de _tache_heartbeat côté ClientServeurT/ClientReseau
        AutoniaX mais pour ce canal binaire dédié. Annulée par _boucle_
        reception_tunnel dès que la connexion tombe (cf. son finally) --
        pas besoin de se surveiller elle-même, une exception d'envoi sur
        un websocket déjà mort sera de toute façon immédiatement suivie
        par la même exception côté réception, qui fait le nettoyage."""
        try:
            while True:
                await asyncio.sleep(DELAI_HEARTBEAT_TUNNEL_SECONDES)
                if self._ws_tunnel is None:
                    return
                try:
                    await self._ws_tunnel.send(_construire_trame_tunnel(TYPE_TRAME_PING, STREAM_ID_HEARTBEAT_TUNNEL))
                except Exception:
                    # La prochaine lecture de _boucle_reception_tunnel
                    # lèvera la même exception et déclenchera le
                    # nettoyage complet -- rien à faire ici de plus
                    # qu'arrêter proprement cette tâche.
                    return
        except asyncio.CancelledError:
            pass


async def _resoudre_proxy_effectif_profil(
    nom_profil: str, relais_proxy_local: Optional["RelaisProxyLocal"],
) -> Optional[dict]:
    """PATCH (SPEC_proxy_natif_tunnel.md, section 13.4) -- point unique
    de décision "quel proxy utiliser pour lancer Chrome/Camoufox sur ce
    profil", appelé par les 5 sites qui lisaient jusqu'ici directement
    obtenir_config_profil(nom)["proxy"] (cf. section 13.4 de la spec :
    proxy natif prioritaire s'il est actif ET que le RelaisProxyLocal
    est effectivement démarré pour ce profil, sinon repli sur le proxy
    externe classique s'il existe, sinon aucun proxy -- les deux champs
    `proxy_natif`/`proxy` restent mutuellement exclusifs À L'USAGE, même
    si profils_config.json peut en théorie porter les deux, cf. 13.1).

    `relais_proxy_local` est None pour tout appelant qui n'a pas accès à
    l'instance vivante dans ce process (cf. `_sautoniax_lancer_instance_
    subprocess`, qui démarre un SUBPROCESS séparé -- le proxy natif de
    CE process reste néanmoins valide pour lui : 127.0.0.1:<port> est
    joignable depuis n'importe quel process de la même machine, pas
    seulement celui qui a ouvert le port). Dans ce cas, retombe direc-
    tement sur `obtenir_config_profil(nom).get("proxy_natif")` +
    `obtenir_port_local` si un relais existe déjà pour ce profil -- mais
    ne démarre PAS le relais à cet endroit (un subprocess ne doit pas
    déclencher l'ouverture paresseuse du tunnel, qui appartient au
    process principal via le toggle 13.3, cf. docstring de
    RelaisProxyLocal.obtenir_port_local -- créer un relais ici serait un
    second RelaisProxyLocal orphelin, jamais fermé par le finally de
    _main_async_sautoniax).

    Retourne le dict au même format que le `proxy` externe classique
    (`{"protocole", "host", "port", ...}`, cf. obtenir_config_profil) ou
    None si aucun proxy ne s'applique -- appelable tel quel en argument
    `proxy=` de camoufox_demarrer_navigateur / en 4e argument positionnel
    de _sautoniax_lancer_instance_subprocess, sans aucun changement de
    signature de ces deux fonctions.

    Point vérifié explicitement (geoip=True, cf. commentaire de module
    juste avant _camoufox_chemin_fingerprint : "aligne timezone/locale/
    géolocalisation WebRTC sur l'IP réelle DU PROXY, calculé par Camoufox
    via une requête À TRAVERS CE MÊME PROXY") : avec host=127.0.0.1, ce
    calcul reste correct SI le tunnel relaie réellement cette requête de
    bout en bout (ce qu'il fait -- RelaisProxyLocal ne sait pas
    distinguer une requête de vérification d'IP d'une navigation
    normale, tout passe par le même CONNECT/relais). La requête geoip
    traverse donc bien sAutoniaX -> serveurT -> mAutoniaX -> internet, et
    obtient la vraie IP publique DU mAutoniaX -- pas 127.0.0.1, qui
    n'apparaît jamais dans le résultat, seulement comme adresse du saut
    local. Aucun cas particulier nécessaire ici pour ce point."""
    config = obtenir_config_profil(nom_profil)
    if config.get("proxy_natif"):
        port_local: Optional[int] = None
        if relais_proxy_local is not None:
            # Process principal (celui qui possède le RelaisProxyLocal
            # vivant) : source de vérité directe, dict interne plutôt
            # qu'un obtenir_port_local (qui DÉMARRERAIT le serveur s'il
            # n'existe pas encore -- ce n'est pas le rôle de cette
            # fonction, seulement du toggle 13.3, cf. _sur_toggle_proxy_
            # natif_demande) -- lecture seule ici.
            existant = relais_proxy_local._serveurs_par_profil.get(nom_profil)
            if existant is not None:
                port_local = existant[1]
        if port_local is None:
            log.warning(
                f"[sAutoniax] proxy natif actif pour '{nom_profil}' mais aucun port local "
                "ouvert (RelaisProxyLocal pas démarré pour ce profil) -- repli sur le proxy "
                "externe classique le cas échéant (cf. spec 13.4)."
            )
        else:
            return {"protocole": "http", "host": "127.0.0.1", "port": port_local, "user": None, "password": None}
    return config["proxy"]


async def _main_async_sautoniax(
    server_url_t: str, nom_profil: str, instance_id: str,
    url_ouverture: Optional[str], intervalle_capture_s: float,
) -> bool:
    """Orchestration complète du mode sAutoniax (PATCH -- demande
    explicite utilisateur, cf. cahier : exécuter AutoniaX "quelque part
    comme Kaggle" en tant qu'EXÉCUTANT pur, piloté et observé à
    distance via le serveurT plutôt que via le protocole serveur LOCAL
    de mAutoniax, totalement inatteignable depuis un notebook Kaggle).

    Séquence :
      1. Connexion au serveurT en rôle "executant" (cf. ClientServeurT,
         PATCH role paramétrable).
      2. Téléchargement du profil nommé `nom_profil` depuis le stockage
         B2 (cf. ClientServeurT.telecharger_fichier -- le sAutoniax ne
         connaît jamais les identifiants B2 lui-même, cf. docstring de
         _telecharger_fichier) sous forme d'archive .zip, dézippée dans
         un dossier LOCAL sous AUTONIAX_DATA_DIR (cf. _chemin_donnees
         -- jamais D:\\ScaleTube\\... en dur, incompatible Kaggle/Linux).
         Un profil de ce nom déjà présent localement N'EST PAS re-
         téléchargé (cf. plus bas) -- utile pour relancer rapidement
         sans re-télécharger un gros profil à chaque essai.
      3. Lancement de Camoufox EN HEADLESS (cf. PATCH headless
         configurable, camoufox_demarrer_navigateur(headless=True) --
         jamais de fenêtre visible : Kaggle n'a pas d'affichage) sur ce
         profil.
      4. Boucle infinie : capture_propre (cf. action_camoufox_capture_
         propre) toutes les `intervalle_capture_s` secondes, envoyée
         au serveurT (cf. ClientServeurT.envoyer_capture, compression
         WebP qualité 100 automatique -- PATCH recompression par
         pilote, plus de dégradation à la source, cf. docstring
         d'envoyer_capture) -- PAS de pilotage à distance
         complet (souris/clavier/scroll) dans cette première version :
         seule la capture périodique est demandée explicitement par le
         cahier pour le scénario Kaggle, cf. récapitulatif de session.

    Se ferme proprement sur Ctrl+C ou SIGTERM (mêmes signaux que
    _main_async_camoufox) : arrête la boucle de capture, ferme
    Camoufox (camoufox_cm.__aexit__), puis arrête le client serveurT
    (ClientServeurT.arreter)."""
    log.info(
        f"[sAutoniax] démarrage -- instance_id={instance_id!r}, profil={nom_profil!r}, "
        f"serveurT={server_url_t!r}, intervalle_capture={intervalle_capture_s}s"
    )

    # PATCH (cf. docstring de _sautoniax_fichier_pids_isoles) -- tout
    # premier traitement de cette fonction, avant même la connexion
    # réseau : ferme les instances isolées laissées orphelines par une
    # génération précédente de ce même process (ex. après un
    # redemarrer_executant qui a fait sortir tout le process Python).
    # Sans cet appel, un profil lancé en instance isolée puis "perdu" par
    # un redémarrage reste verrouillé indéfiniment (Camoufox refuse de
    # relancer le même profil tant que l'ancien PID est vivant), quel que
    # soit le soin apporté au finally de fermeture -- ce dernier ne peut
    # fermer que ce QU'IL CONNAÎT, jamais les reliquats d'une génération
    # antérieure.
    _sautoniax_nettoyer_anciens_procs_isoles()

    # --- Étape 1 : connexion au serveurT en tant qu'EXÉCUTANT ---
    # IMPORTANT (pas de QApplication/QEventLoop Qt dans ce mode, cf.
    # docstring de main_sautoniax) : les connexions Signal/Slot Qt en
    # AutoConnection (choix par défaut de .connect()) se comportent
    # comme QueuedConnection entre threads différents, et une
    # QueuedConnection n'est délivrée QUE si le thread récepteur fait
    # tourner une boucle d'événements Qt -- ce qui n'est jamais le cas
    # ici (seule une boucle asyncio tourne). Toutes les connexions de
    # signaux ClientServeurT ci-dessous forcent donc Qt.DirectConnection
    # (le callback s'exécute directement dans le thread ÉMETTEUR, ici
    # le thread réseau de ClientServeurT) -- sûr dans notre cas car
    # chaque callback ne fait que threading.Event.set() ou
    # loop.call_soon_threadsafe(...), tous deux thread-safe par
    # construction.
    client_t = ClientServeurT(server_url=server_url_t, nom=instance_id, role="executant")
    loop = asyncio.get_running_loop()
    # PATCH (SPEC_proxy_natif_tunnel.md, section 6 -- câblage) : un seul
    # RelaisProxyLocal par process sAutoniaX, créé ici (avant les deux
    # branches "mode attente pure" / "mode legacy --profil" plus bas,
    # cf. leurs finally respectifs) pour être disponible dès qu'un
    # toggle_proxy_natif_demande arrive, quel que soit le chemin
    # emprunté par ce process. Ne démarre RIEN tout seul (ni port TCP
    # local, ni connexion /ws_tunnel) tant qu'aucun profil n'a
    # explicitement demandé le proxy natif -- cf. docstring de la
    # classe (paresseux par construction).
    relais_proxy_local = RelaisProxyLocal(client_t, loop)
    connecte_event = threading.Event()
    client_t.connecte.connect(lambda: connecte_event.set(), Qt.DirectConnection)
    # PATCH (identité stable par nom) -- log explicite si le serveurT
    # refuse notre register (cf. ClientServeurT.register_refuse -- en
    # pratique, seul cas possible ici : instance_id vide, ce qui
    # n'arrive normalement jamais via main_sautoniax() qui retombe
    # toujours sur "sautoniax" par défaut, cf. sa docstring -- mais
    # reste possible via un `--instance-id ""` explicite, ou tout futur
    # appelant de _main_async_sautoniax qui ne passerait pas par ce
    # même garde-fou). SANS ce log, connecte_event ne serait JAMAIS
    # levé (cf. patch ClientServeurT._boucle_async : connecte n'est
    # plus émis en cas de refus) et l'attente ci-dessous resterait
    # bloquée indéfiniment sans qu'aucun message n'explique pourquoi.
    client_t.register_refuse.connect(
        lambda message: log.error(f"[sAutoniax] register refusé par le serveurT : {message} -- nouvel essai automatique en boucle, aucune action ne débutera tant que ce n'est pas résolu (cf. --instance-id)."),
        Qt.DirectConnection,
    )
    client_t.demarrer()

    # Attend une première connexion effective avant de continuer (pas
    # de sens à télécharger un profil ou lancer un navigateur si le
    # serveurT est injoignable) -- ClientServeurT retente indéfiniment
    # tout seul toutes les 10s (cf. sa docstring), donc cette attente
    # peut prendre plus de 10s si le tout premier essai échoue. Polling
    # via run_in_executor plutôt qu'un asyncio.Event (qui ne serait pas
    # thread-safe à .set() depuis le thread réseau sans repasser par
    # call_soon_threadsafe, cf. remarque DirectConnection ci-dessus --
    # threading.Event.wait() bloquant est plus simple ici, déporté dans
    # un executor pour ne pas bloquer la boucle asyncio elle-même).
    log.info("[sAutoniax] attente de la connexion au serveurT...")
    await loop.run_in_executor(None, connecte_event.wait)
    log.info("[sAutoniax] connecté au serveurT.")

    # BUGFIX CRITIQUE (spec A.3, signal "sAutoniax prêt" envoyé TROP TÔT) --
    # client_t.envoyer_sautoniax_pret() vivait auparavant ICI, juste après
    # la connexion réseau brute -- AVANT _sautoniax_assurer_donnees_de_base
    # (téléchargement mouseData.sqlite3/project.json/service_api.zip,
    # potentiellement PLUSIEURS MINUTES sur une connexion lente, cf. logs
    # réels observés : mouseData.sqlite3 seul a pris 2m10s) ET avant TOUS
    # les client_t.xxx_demande.connect(..., Qt.DirectConnection) posés plus
    # bas dans cette même fonction (création de profil, logs, kill,
    # démarrage isolé, notebook distant, etc. -- cf. leur liste complète
    # juste avant le "if nom_profil is None:" en fin de fonction).
    #
    # Conséquence RÉELLE observée : le pilote voyait "sAutoniax prêt",
    # dégrisait son bouton "Générer" (cf. PanneauProprietesSautoniax.
    # sur_sautoniax_pret), l'utilisateur cliquait -- le message réseau
    # arrivait bien côté exécutant (log "<- demander_creer_profil_
    # sautoniax reçu du pilote" visible), MAIS le signal Qt correspondant
    # (creer_profil_sautoniax_demande) n'avait ENCORE AUCUN SLOT connecté
    # à cet instant précis (le .connect() est plus bas, séquentiellement
    # jamais atteint tant que l'await du téléchargement n'est pas résolu)
    # -- .emit() partait dans le vide, aucune réponse n'était jamais
    # renvoyée au pilote, qui restait bloqué en attente indéfiniment.
    # Même défaut pour TOUTE commande reçue durant cette fenêtre (logs,
    # kill, démarrage de profil...), pas seulement la création.
    #
    # Correctif : l'envoi de "prêt" est déplacé tout en bas de cette
    # fonction, juste après le DERNIER de ces .connect() (cf. son propre
    # commentaire à cet endroit) -- "prêt" signifie désormais réellement
    # "capable de traiter une commande", pas seulement "connecté au
    # réseau". _sautoniax_assurer_donnees_de_base reste lancée ICI (AVANT
    # les connect()) : son échec est non bloquant et n'empêche pas la
    # suite de s'exécuter, cf. sa docstring -- seul le moment de l'ANNONCE
    # "prêt" au pilote change, pas l'ordre des opérations internes.

    # --- Étape 1ter (Patch 4.7) : mouseData.sqlite3 + dossier service API
    # -- téléchargés depuis App/ du bucket SEULEMENT s'ils sont absents
    # localement (cf. docstring de _sautoniax_assurer_donnees_de_base :
    # "au premier chargement de l'app ... avant toute exécution") --
    # placé ICI, avant l'étape 1bis (serveur local) et avant le
    # téléchargement du profil (étape 2 legacy ci-dessous), pour que ces
    # données de base soient prêtes AVANT que la moindre tâche (mono-
    # profil legacy OU projet distribué reçu via le serveur local) ne
    # puisse en avoir besoin. Échec non bloquant pour le démarrage du
    # sAutoniax lui-même (cf. docstring de la fonction) -- volontairement
    # PAS de "return"/RuntimeError ici, contrairement à l'échec du
    # téléchargement du profil quelques lignes plus bas.
    await _sautoniax_assurer_donnees_de_base(client_t, loop)

    # --- Étape 1bis (Patch 4.4.c) : serveur local + gestion des demandes
    # entrantes (projet distribué, kill, notebook distant), pendant toute la
    # durée de vie de ce process -- indépendant du mode mono-profil legacy
    # ci-dessous (étapes 2-4), qui continue de fonctionner à l'identique
    # pour la compatibilité (ex. lancement manuel `--profil` déjà en place
    # sur des notebooks Kaggle existants). Le serveur local sert
    # UNIQUEMENT à MoteurExecutionBatch (cf. _sautoniax_traiter_projet_recu)
    # -- la boucle de capture périodique du profil mono-instance (étape 4)
    # ne passe jamais par lui, elle reste directe (page Camoufox in-process).
    serveur_local_proc = await loop.run_in_executor(None, _sautoniax_demarrer_serveur_local)

    client_t.envoyer_statut_executant("inactif")

    _moteur_batch_courant: dict = {"moteur": None}
    _taches_projets_en_cours: set = set()
    # PATCH (point 3 -- pré-déclaration précoce) : _instances_legacy_par_
    # profil est réellement peuplé beaucoup plus bas dans cette fonction
    # (cf. son commentaire complet à cet endroit), mais doit exister ICI
    # -- avant _est_instance_geree_par_client_pilote juste en dessous, qui
    # la référence par closure. Le dict lui-même reste le même objet tout
    # du long (jamais réassigné, seulement muté via .update()/.pop()),
    # donc cette pré-déclaration ne change rien au comportement, juste à
    # l'ordre textuel.
    _instances_legacy_par_profil: dict[str, str] = {}
    # PATCH (Patch 4.2 -- démarrage d'un profil isolé, sans ProjetBatch,
    # depuis l'onglet Instances du pilote) : registre séparé de
    # _moteur_batch_courant/_OrchestrateurMappingProfils._instances_par_
    # profil (qui n'existe QUE pendant l'exécution d'un ProjetBatch réel)
    # -- nom_profil -> instance_id, pour les profils démarrés UN PAR UN
    # via demander_demarrer_profil_isole. Un même nom_profil ne peut
    # jamais être présent ici ET dans _moteur_batch_courant en même temps
    # (cf. _sur_demarrer_profil_isole_demande, qui refuse si déjà actif
    # par UN OU L'AUTRE mécanisme) -- source de vérité unique par profil,
    # jamais un mélange incohérent des deux registres pour un même nom.
    _instances_isolees: dict[str, str] = {}
    _procs_isoles: dict[str, subprocess.Popen] = {}  # instance_id -> Popen, pour un kill propre plus tard si besoin
    # AJOUT (Section 8 -- "Arrêter" interrompt le CODE, pas le profil, cf.
    # PLAN_section_8_arreter.md §3/§4/§7 étape 4) : instance_id (du
    # NAVIGATEUR, _instances_isolees.values()) -> Popen du process
    # EXÉCUTEUR de code pour ce profil isolé (main_executeur_sautoniax,
    # troisième process, distinct de _procs_isoles qui ne porte QUE le
    # navigateur). Lancé PARESSEUSEMENT (cf. §4 du plan, option B
    # retenue) par _sautoniax_executer_notebook_distant_sur_instance_
    # isolee, uniquement quand une première cellule est réellement
    # envoyée sur ce profil -- un profil isolé piloté seulement à la
    # main (clic/scroll depuis le Dashboard, jamais de notebook lancé
    # dessus) n'a donc jamais d'exécuteur, exactement comme avant ce
    # chantier. "Arrêter" (cf. nouveau message réseau distant arreter_
    # execution_profil, traité plus bas dans cette fonction) fait
    # terminate()/kill() UNIQUEMENT sur le Popen ici présent -- le
    # navigateur (_procs_isoles) n'est jamais touché par "Arrêter" (cf.
    # distinction Arrêter/Kill, §6 du plan). "Kill" (_sur_kill_profil_
    # demande) ferme les DEUX registres pour un même profil.
    _executeurs_isoles: dict[str, subprocess.Popen] = {}
    # CORRECTIF (bug rapporté : TypeError sur `TIMEOUT` -- une variable
    # définie dans une cellule "Variable dynamique" était traitée comme
    # candidate ServiceAPI et écrasée par un ServiceAPIExecutableRelaisIsole
    # dans une cellule SUIVANTE sur le même profil isolé, chaque fois que
    # le namespace de la cellule précédente n'était plus visible -- cf.
    # docstring (avant correctif) de _sautoniax_executer_notebook_distant_
    # sur_instance_isolee, qui créait un `namespace: dict = {...}` NEUF à
    # CHAQUE appel, sans persistance entre deux exécutions de cellule.
    # instance_id -> dict (dernier namespace exec() de ce profil isolé),
    # même rôle EXACT que etat_notebook_distant["namespace"] pour le mode
    # mono-profil (cf. _sautoniax_executer_notebook_distant, ligne ~93775/
    # 93941) -- seule différence : indexé par instance_id (plusieurs
    # profils isolés actifs simultanément) au lieu d'un etat_notebook_
    # distant unique par connexion.
    _namespaces_isoles: dict[str, dict] = {}
    # CORRECTIF (bug rapporté : timeout/mauvais routage quand deux
    # cellules sur la MÊME instance isolée s'exécutent à quelques
    # centaines de ms d'écart -- cf. logs [DIAG-INSTANCE-RELAIS]/
    # [DIAG-RELAIS] et docstring d'InstanceExecutableRelaisIsole._appeler
    # ci-dessous). Cause racine : ServiceAPIExecutableRelaisIsole.
    # instance() (et donc InstanceExecutableRelaisIsole) capturait
    # moteur_relais À LA CONSTRUCTION, figé dans une fermeture Python
    # normale. Or ces objets survivent au-delà de la cellule qui les a
    # créés dès qu'ils sont stockés dans une variable utilisateur du
    # namespace hérité (ex. `mon_instance = yt_view.instance()`, réutilisée
    # telle quelle par une cellule suivante SANS rappeler .instance()) --
    # cf. docstring de _sautoniax_executer_notebook_distant_sur_instance_
    # isolee, `namespace_herite`. Si cette cellule suivante démarre AVANT
    # que le moteur_relais de la cellule précédente ait fini son cycle de
    # vie (_deconnecter_ecoute() dans le finally), OU si deux cellules se
    # chevauchent tout court, mon_instance continue de pointer vers un
    # moteur_relais PÉRIMÉ (déjà déconnecté du signal Qt côté client_
    # pilote_instances) -- toute requête envoyée via cet objet reste sans
    # réponse jusqu'au timeout, même si le command_result correspondant
    # revient correctement mais est reçu par (et ignoré par, faute de
    # requete_id reconnu) un AUTRE moteur_relais.
    #
    # Fix : au lieu de figer moteur_relais à la construction, on le
    # RÉSOUT DYNAMIQUEMENT à chaque appel, via ce registre
    # instance_id -> moteur_relais COURANT (le plus récent créé pour cet
    # instance_id, mis à jour à chaque nouvelle cellule -- cf. site de
    # création ci-dessous). InstanceExecutableRelaisIsole._appeler()
    # consulte ce registre au moment de _appeler() plutôt que d'utiliser
    # une référence capturée à __init__ -- ainsi, même si l'objet Python
    # `mon_instance` lui-même survit dans le namespace hérité, l'appel
    # qu'il déclenche est TOUJOURS routé vers le moteur_relais actif de la
    # cellule EN COURS, jamais un moteur périmé. Même portée/cycle de vie
    # que _namespaces_isoles (même fonction englobante, même nettoyage aux
    # mêmes points : fermeture globale de l'exécutant et kill_profil
    # individuel, cf. plus bas).
    _moteurs_relais_courants: dict[str, "_MoteurRelaisPourComposantIsole"] = {}

    def _fermer_tous_procs_isoles():
        """PATCH (bug constaté : après redemarrer_executant/SIGTERM, les
        profils démarrés via demander_demarrer_profil_isole restaient
        actifs -- processus Camoufox orphelins verrouillant leur
        user_data_dir -- si bien qu'un nouveau lancement du MÊME profil
        échouait ensuite avec "Camoufox is already running, but is not
        responding". Cause : ni le finally du mode attente pure, ni celui
        du mode legacy, ne touchaient _procs_isoles -- seule la fermeture
        explicite d'UN profil (via kill_profil, cf. plus haut dans cette
        fonction) le faisait, jamais l'arrêt global de l'exécutant.

        Cette fonction ferme donc TOUS les processus encore présents dans
        _procs_isoles au moment de l'arrêt (quel qu'en soit le motif :
        redémarrage demandé, SIGTERM, SIGINT) -- terminate() d'abord
        (laisse Camoufox/Firefox se fermer proprement et libérer son
        verrou de profil), puis kill() en secours si le process ne
        répond pas sous 5s. Appelée dans les DEUX finally de cette
        fonction, avant le retour -- best-effort : une exception sur un
        PID (déjà mort, accès refusé...) ne doit jamais empêcher de
        fermer les autres ni de terminer l'arrêt de l'exécutant.

        CORRECTIF (blocage de fermeture du process ~300s à l'arrêt global
        -- redemarrer_executant/SIGTERM/SIGINT pendant qu'une ou plusieurs
        cellules réseau tournent sur des profils isolés) : AVANT de
        terminer quoi que ce soit, débloque explicitement TOUTES les
        requêtes encore présentes dans _callbacks_executer_code_en_
        attente, quel que soit leur instance_id -- même mécanisme EXACT
        que celui déjà existant dans _sur_arreter_execution_profil_
        demande (boite_resultat["data"] + event.set()), simplement
        généralisé ici à l'arrêt global plutôt qu'à l'arrêt ciblé d'un
        seul profil.

        Cause du blocage (diagnostiqué à partir d'un cas réel où sAutoniax
        ne redémarrait plus après un clic "Redémarrer" alors qu'une
        cellule tournait sur un profil isolé) : _sautoniax_executer_
        notebook_distant_sur_instance_isolee attend son executer_code_
        resultat via `await loop.run_in_executor(None, event.wait)`, SANS
        timeout (volontaire -- une cellule légitime peut tourner
        longtemps), donc sur un thread du ThreadPoolExecutor PAR DÉFAUT
        d'asyncio. `tache.cancel()` (cf. les deux finally plus bas)
        interrompt bien la COROUTINE (CancelledError), mais n'a AUCUN
        effet sur le thread OS déjà lancé par run_in_executor : ce
        thread reste bloqué sur son event.wait() tant que personne
        n'appelle event.set(). En temps normal, c'est
        _sur_executer_code_resultat_recu ou _sur_arreter_execution_
        profil_demande qui s'en charge -- mais NI L'UN NI L'AUTRE n'est
        déclenché par un arrêt global : le process exécuteur est tué par
        _fermer_tous_procs_isoles ci-dessous, incapable dès lors de
        répondre, et l'event ne sera donc JAMAIS signalé.
        Conséquence concrète : à la sortie de _main_async_sautoniax,
        asyncio.run() (cf. main_sautoniax) attend que TOUS les threads du
        pool par défaut se terminent avant de rendre la main
        (loop.shutdown_default_executor, cf. asyncio.runners.Runner.
        close) -- délai borné par asyncio.constants.THREAD_JOIN_TIMEOUT,
        soit 300s (Python 3.12). Le process entier restait donc figé
        jusqu'à 5 minutes avant que sys.exit(CODE_SORTIE_REDEMARRAGE) ne
        puisse enfin s'exécuter, retardant d'autant la reconnexion
        attendue par le pilote (et par la boucle de supervision du
        notebook Kaggle, qui ne relance qu'après cette sortie).

        Placé en tout premier dans cette fonction (avant la fermeture des
        _procs_isoles/_executeurs_isoles) : réveiller ces threads le plus
        tôt possible plutôt que d'attendre qu'ils expirent d'eux-mêmes.
        Une copie de .items() est itérée (comme pour _procs_isoles/
        _executeurs_isoles plus bas) car event.set() peut déclencher
        quasi immédiatement, sur la boucle asyncio, le nettoyage de cette
        même entrée (cf. son .pop() juste après l'étape 3 de la fonction
        débloquée) -- muter le dict pendant qu'on l'itère lèverait
        RuntimeError. best-effort, comme le reste de cette fonction :
        une entrée déjà nettoyée entre-temps (event déjà .set() par
        ailleurs) est un no-op inoffensif via .pop(..., None) plus loin,
        jamais une raison d'interrompre le nettoyage des autres."""
        for _requete_id_en_attente, (_event_en_attente, _boite_en_attente, _instance_id_en_attente) in list(
            _callbacks_executer_code_en_attente.items()
        ):
            _boite_en_attente["data"] = {
                "type": "executer_code_resultat", "instance_id": _instance_id_en_attente,
                "requete_id": _requete_id_en_attente, "ok": False,
                "erreur": (
                    f"exécution interrompue : arrêt global de l'exécutant "
                    f"(redémarrage ou fermeture) pendant que cette cellule tournait."
                ),
                "sortie": "",
            }
            _event_en_attente.set()
            log.info(
                f"[sAutoniax] arrêt global : requête executer_code en attente "
                f"(requete_id={_requete_id_en_attente!r}, instance_id={_instance_id_en_attente!r}) "
                f"débloquée avant fermeture des process isolés."
            )
        _callbacks_executer_code_en_attente.clear()
        for instance_id, proc in list(_procs_isoles.items()):
            try:
                if proc.poll() is not None:
                    continue  # déjà terminé
                proc.terminate()
                try:
                    proc.wait(timeout=5)
                except subprocess.TimeoutExpired:
                    log.warning(
                        f"[sAutoniax] profil isolé '{instance_id}' (PID {proc.pid}) "
                        f"ne répond pas à terminate() après 5s -- kill() forcé."
                    )
                    proc.kill()
                    proc.wait(timeout=5)
                log.info(f"[sAutoniax] profil isolé '{instance_id}' (PID {proc.pid}) fermé proprement.")
            except Exception as e:
                log.warning(f"[sAutoniax] fermeture profil isolé '{instance_id}' ignorée (erreur non bloquante) : {e!r}")
        # AJOUT (Section 8 -- "Arrêter" interrompt le CODE, pas le profil,
        # cf. PLAN_section_8_arreter.md §7 étape 8) : fermer aussi tous
        # les exécuteurs de code encore présents, même patron EXACT
        # (terminate() puis wait(timeout=5) puis kill() en repli,
        # best-effort) que la boucle _procs_isoles ci-dessus -- sinon un
        # redémarrage/SIGTERM/SIGINT laisserait des process exécuteurs
        # orphelins tourner pour rien (même bug que celui déjà corrigé
        # pour le navigateur, cf. docstring ci-dessus).
        for instance_id, proc_executeur in list(_executeurs_isoles.items()):
            try:
                if proc_executeur.poll() is not None:
                    continue  # déjà terminé
                proc_executeur.terminate()
                try:
                    proc_executeur.wait(timeout=5)
                except subprocess.TimeoutExpired:
                    log.warning(
                        f"[sAutoniax] exécuteur de '{instance_id}' (PID {proc_executeur.pid}) "
                        f"ne répond pas à terminate() après 5s -- kill() forcé."
                    )
                    proc_executeur.kill()
                    proc_executeur.wait(timeout=5)
                log.info(f"[sAutoniax] exécuteur de '{instance_id}' (PID {proc_executeur.pid}) fermé proprement.")
            except Exception as e:
                log.warning(f"[sAutoniax] fermeture exécuteur de '{instance_id}' ignorée (erreur non bloquante) : {e!r}")
        _procs_isoles.clear()
        _instances_isolees.clear()
        _namespaces_isoles.clear()  # CORRECTIF TIMEOUT : mêmes profils fermés -> namespaces plus valides
        _moteurs_relais_courants.clear()  # CORRECTIF ROUTAGE DYNAMIQUE : idem, plus aucun moteur valide
        _executeurs_isoles.clear()  # AJOUT Section 8 : idem pour les exécuteurs, cf. boucle ci-dessus

    # PATCH (point 3 -- "écran noir" au clic sur "Aperçu"/impossible de
    # cliquer-scroller à distance pour un profil démarré via "Démarrer"
    # isolé ou via un ProjetBatch réseau). Diagnostic : ces profils
    # tournent dans un SOUS-PROCESSUS séparé (_sautoniax_lancer_instance_
    # subprocess, SCRIPT_INSTANCE_DASHBOARD), avec leur propre page
    # Camoufox -- invisible du process principal qui exécute
    # _sautoniax_boucle_capture (celle-ci ne connaît QUE namespace_
    # notebook_distant["etat_navigateur"]["page"], la page du mode
    # mono-profil legacy/Notebook Distant). Sans canal supplémentaire, ni
    # capture ni commande de pilotage ne peut jamais atteindre ces
    # instances-là depuis ce process.
    #
    # Solution : réutiliser ClientReseauAutoniaX (le client Qt déjà écrit
    # pour parler au serveur dashboard local, cf. DashboardScreen/
    # ProfilsInstancesScreen côté mAutoniax desktop -- même protocole
    # srv_gerer_register/srv_gerer_link/srv_gerer_frame/srv_gerer_command,
    # rien de nouveau à inventer côté serveur).
    #
    # DÉCISION EXPLICITE UTILISATEUR (rôle "pilote", pas "observateur") :
    # un rôle "observateur" reçoit bien les frames (aperçu vidéo) mais
    # srv_gerer_command réserve le pilotage réel (clic/scroll/frappe) au
    # rôle "pilote", exclusif par instance (cf. instance.liee_a, "le
    # dernier demandeur reprend la main" -- srv_gerer_link). Utilisateur
    # prévenu du compromis (usage mono-utilisateur assumé : "cest une
    # seule peronne en realite qui vas utiliser le logiciels, je veu xle
    # maniplaiton") -- si jamais un vrai humain ouvrait la MÊME instance
    # dans mAutoniax desktop en parallèle, l'un des deux perdrait la main
    # sans préavis (comportement standard de srv_gerer_link, déjà comment
    # le reste de l'app gère la reprise entre pilotes). Chaque instance
    # isolée est liée (link) dès son démarrage, cf. _lier_instance_isolee_
    # au_client_pilote plus bas -- après quoi TOUTES les actions
    # (listTabs/switchTab/click/scroll/type_text/etc.) passent normalement.
    #
    # Persistant (pas jetable comme l'usage ligne ~69671 côté profil
    # legacy unique) : doit vivre pendant TOUTE la durée du process, pour
    # couvrir n'importe quelle instance isolée démarrée à n'importe quel
    # moment. Fermé dans les DEUX blocs finally de cette fonction (mode
    # attente pure ET mode legacy --profil), cf. plus bas.
    client_pilote_instances = ClientReseauAutoniaX(
        SERVER_URL_DASHBOARD, role="pilote", id_client=f"sautoniax-pilote-{uuid.uuid4().hex[:8]}",
    )

    def _est_instance_geree_par_client_pilote(instance_id_a_verifier: str) -> bool:
        # Factorisé -- UNIQUE point de vérité pour "cette instance est-elle
        # une instance isolée/batch/legacy (sous-processus séparé, gérée
        # via client_pilote_instances) plutôt que le profil mono-instance
        # legacy (namespace_notebook_distant, in-process) ?". Utilisé par
        # les 3 callbacks ci-dessous ET par _sur_commande_instance_recue
        # plus bas -- CORRECTIF : avant cette factorisation, seul
        # _instances_isolees était vérifié dans _sur_frame_instance_isolee/
        # _sur_command_result_instance_isolee (oubli des instances
        # ProjetBatch et du pool legacy FIFO), alors que _sur_commande_
        # instance_recue vérifiait déjà les 3 registres -- incohérence qui
        # aurait cassé l'aperçu vidéo/le retour de commande pour tout
        # profil démarré via un ProjetBatch (seul le contrôle en lui-même
        # aurait fonctionné, sans jamais voir son résultat ni l'image).
        moteur_courant = _moteur_batch_courant.get("moteur")
        instances_batch_en_cours = (
            set(moteur_courant._instances_par_profil.values())
            if moteur_courant is not None and hasattr(moteur_courant, "_instances_par_profil")
            else set()
        )
        return (
            instance_id_a_verifier in _instances_isolees.values()
            or instance_id_a_verifier in _instances_legacy_par_profil.values()
            or instance_id_a_verifier in instances_batch_en_cours
        )

    def _sur_frame_instance_isolee(instance_id_frame: str, image_b64: str, seq: int):
        # Relais DIRECT vers le pilote distant, sans jamais toucher à
        # etat_capture/capture_ponctuelle_demandee (ceux-ci pilotent
        # UNIQUEMENT _sautoniax_boucle_capture, le mode mono-profil legacy
        # -- cf. sa docstring). Le débit de ces frames est entièrement
        # déterminé côté sous-processus instance (main_instance_nodriver,
        # sa propre boucle de capture continue), pas ici : ce callback ne
        # fait que transporter, jamais de décision de fréquence.
        #
        # Filtre : ne relayer QUE les instances gérées par ce client pilote
        # (isolées/batch/legacy, cf. _est_instance_geree_par_client_pilote)
        # -- si jamais un autre sAutoniax/mAutoniax utilisait le MÊME
        # serveur dashboard local (jamais le cas en pratique, un serveur
        # local par process Kaggle, mais gardé par robustesse), ses
        # frames ne seraient pas relayées deux fois vers CE pilote
        # distant par erreur. CORRECTIF : utilise désormais la fonction
        # factorisée (avant, seul _instances_isolees était vérifié ici,
        # ratant les instances ProjetBatch/pool legacy -- cf. docstring
        # de _est_instance_geree_par_client_pilote).
        if not _est_instance_geree_par_client_pilote(instance_id_frame):
            return
        client_t.envoyer_capture(image_b64, instance_id_frame)

    def _sur_command_result_instance_isolee(data: dict):
        # Relais du résultat d'exécution (clic/scroll/etc. réellement
        # exécuté côté sous-processus instance) vers le pilote distant --
        # même format "command_result" que _sur_commande_instance_recue
        # utilise déjà pour le mode legacy (cf. envoyer_command_result),
        # simple retransmission ici puisque srv_gerer_command_result nous
        # l'a déjà livré tout formé (instance_id/action/requete_id/ok/
        # result/error).
        # CORRECTIF : idem _sur_frame_instance_isolee ci-dessus -- utilise
        # désormais la fonction factorisée plutôt que le seul filtre
        # _instances_isolees (ratait les résultats de commande pour les
        # instances ProjetBatch/pool legacy).
        if not _est_instance_geree_par_client_pilote(data.get("instance_id", "")):
            return
        # CORRECTIF (cf. docstring de _requetes_capture_propre_en_attente,
        # plus haut) : intercepte la réponse à une capture_propre demandée
        # par "Capturer tout"/le bouton ponctuel AVANT le relais générique
        # ci-dessous -- celui-ci est destiné aux vraies commandes de
        # pilotage (click/scroll/type_text/...) qu'un pilote distant
        # attend explicitement via son propre command_result_recu ; une
        # capture_propre déclenchée depuis CE sAutoniax (pas par un
        # pilote distant) n'a pas d'appelant qui attend ce format-là, et
        # la relayer telle quelle ne ferait qu'ajouter du bruit réseau
        # sans jamais afficher l'image. On la convertit ici en un simple
        # envoyer_capture -- exactement le même canal que _sur_frame_
        # instance_isolee ci-dessus, que le panneau clone (capture_recue)
        # sait déjà afficher, streaming actif ou non.
        requete_id_recue = data.get("requete_id", "")
        instance_en_attente = _requetes_capture_propre_en_attente.pop(requete_id_recue, None)
        if instance_en_attente is not None:
            if data.get("ok", False):
                image_b64 = (data.get("result") or {}).get("image_b64")
                if image_b64:
                    # PATCH (demande explicite utilisateur : "lorsque on
                    # demande une capture [Capturer tout], la qualité doit
                    # être automatiquement à 100, jamais celle du
                    # FenetreRenduTaskReseau actuel, ça ne doit pas changer
                    # sa qualité actuelle") -- forcer_qualite_100=True
                    # UNIQUEMENT ici : cette capture provient bien d'une
                    # capture_propre déclenchée par "Capturer tout" (cf.
                    # _requetes_capture_propre_en_attente), jamais du
                    # streaming continu normal (_sur_frame_instance_isolee,
                    # ligne au-dessus, qui reste inchangée et continue de
                    # dépendre de preference_capture du pilote).
                    client_t.envoyer_capture(image_b64, instance_en_attente, forcer_qualite_100=True)
                else:
                    log.warning(f"[sAutoniax] capture_propre ('{instance_en_attente}') : réponse ok=True mais image_b64 vide.")
            else:
                log.warning(f"[sAutoniax] capture_propre ('{instance_en_attente}') a échoué : {data.get('error', 'erreur inconnue')}")
            return
        client_t.envoyer_command_result(
            data.get("instance_id", ""), data.get("action", ""), data.get("requete_id", ""),
            data.get("ok", False), data.get("result"), data.get("error", ""),
        )

    def _sur_executer_code_image_recu(data: dict):
        # AJOUT (Section 8 -- Image.view() depuis le process exécuteur,
        # cf. docstring de _ExecuteurClientTAdaptateur/echange
        # utilisateur "la plus propre et robuste") : relaie CHAQUE
        # message executer_code_image reçu du process exécuteur (un par
        # appel .view() du code utilisateur, jamais groupé, cf. sa
        # docstring) vers le pilote distant via client_t -- SEUL point du
        # process principal qui possède une vraie connexion serveurT, cf.
        # décision explicite de ne PAS dupliquer cette connexion dans
        # l'exécuteur lui-même.
        image_b64 = data.get("image_b64", "")
        session_id = data.get("session_id", "")
        id_pilote = data.get("id_pilote", "")
        if data.get("ligne") is not None:
            # PATCH sortie en direct (profil isolé) : ligne de stdout/stderr -> pilote, au fil de l'eau.
            if session_id and id_pilote:
                client_t.envoyer_notebook_distant_log(session_id, id_pilote, data["ligne"])
            return
        if not image_b64 or not session_id or not id_pilote:
            log.warning(
                f"[sAutoniax] executer_code_image_recu ignoré (champ manquant) -- "
                f"instance_id={data.get('instance_id')!r} session_id={session_id!r} id_pilote={id_pilote!r}."
            )
            return
        ok = client_t.envoyer_notebook_distant_image(session_id, id_pilote, image_b64)
        if not ok:
            log.warning(
                f"[sAutoniax] échec relais executer_code_image (instance_id={data.get('instance_id')!r}, "
                f"session_id={session_id!r}) -- connexion serveurT indisponible à cet instant."
            )

    # AJOUT (Section 8 -- cf. PLAN_section_8_arreter.md §7 étape 4) :
    # registre requete_id -> (threading.Event, dict résultat), même
    # patron EXACT que _MoteurRelaisPourComposantIsole._callbacks_en_
    # attente (cf. sa docstring) -- UN SEUL listener permanent sur
    # executer_code_resultat_recu, ici, filtrant par requete_id, plutôt
    # qu'un connect()/disconnect() par cellule (celui-ci vivrait sur le
    # même signal Qt que d'éventuelles autres cellules en vol sur
    # d'autres profils isolés simultanément -- cf. _sautoniax_executer_
    # notebook_distant_sur_instance_isolee, plusieurs profils isolés
    # peuvent exécuter une cellule en parallèle, chacun avec son propre
    # requete_id, jamais de collision possible).
    _callbacks_executer_code_en_attente: dict[str, tuple] = {}

    def _sur_executer_code_resultat_recu(data: dict):
        requete_id = data.get("requete_id")
        entree = _callbacks_executer_code_en_attente.get(requete_id)
        if entree is None:
            return  # pas (ou plus, cf. timeout de connexion exécuteur) pour nous
        event, boite_resultat, _instance_id = entree
        boite_resultat["data"] = data
        boite_resultat["t_recu_diag"] = time.time()  # [SYNC-DIAG]
        event.set()

    client_pilote_instances.frame_recue.connect(_sur_frame_instance_isolee, Qt.DirectConnection)
    client_pilote_instances.command_result_recu.connect(_sur_command_result_instance_isolee, Qt.DirectConnection)
    client_pilote_instances.executer_code_image_recu.connect(_sur_executer_code_image_recu, Qt.DirectConnection)
    def _sur_pont_reponse_recue(data: dict):
        # AJOUT (pont fichiers pilote <-> clone) -- réponse du pilote : à retransmettre à l'exécuteur du clone qui l'attend.
        instance_id_pont = data.get("instance_id", "")
        if not instance_id_pont:
            log.warning("[sAutoniax] pont_pilote_reponse ignoré : instance_id manquant.")
            return
        client_pilote_instances.envoyer_pont_reponse(instance_id_pont, data)

    client_t.pont_reponse_recue.connect(_sur_pont_reponse_recue, Qt.DirectConnection)
    client_pilote_instances.executer_code_resultat_recu.connect(_sur_executer_code_resultat_recu, Qt.DirectConnection)
    client_pilote_instances.demarrer()

    def _lier_instance_isolee_au_client_pilote(instance_id_a_lier: str):
        # À appeler dès qu'une instance isolée est confirmée démarrée
        # (cf. son appelant, dans le bloc de démarrage de profil isolé
        # plus bas) -- sans ce link, srv_gerer_command refuserait TOUTE
        # commande de pilotage vers cette instance (cf. sa docstring :
        # "instance.liee_a != pilote_id" -> refus). "verrou" volontairement
        # PAS posé (cf. srv_gerer_link) : ce lien est censé durer tant que
        # l'instance existe, pas le temps d'une seule séquence de
        # commandes -- poser un verrou ici bloquerait inutilement toute
        # reprise légitime (ex. un autre sAutoniax relié au même serveur
        # local par erreur de configuration).
        client_pilote_instances.envoyer_commande({
            "type": "link", "pilote_id": client_pilote_instances.id_client,
            "instance_id": instance_id_a_lier,
        })

    # PATCH (demande explicite utilisateur : "j'ai lancé un profil que
    # j'ai lancé l'exécution dans TaskScript Editor en mode réseau, le
    # profil est ouvert, mais [le panneau propriétés] n'indique pas que
    # c'est actif") -- registre séparé, CETTE FOIS pour le flux LEGACY de
    # MoteurExecutionBatch (pool FIFO de _sautoniax_traiter_projet_recu,
    # cf. sa docstring -- utilisé quand mapping_profils_sous_projets est
    # vide, contrairement au mode E.7/_OrchestrateurMappingProfils qui,
    # lui, expose déjà nom_profil -> instance_id via son attribut
    # _instances_par_profil). MoteurExecutionBatch lui-même ne connaît
    # QUE des instance_id (cf. sa docstring de classe, "réutilise des
    # instances déjà lancées" sans notion de nom de profil) -- ce dict
    # est peuplé au moment du démarrage legacy (juste avant l'appel à
    # moteur.lancer(), cf. plus bas dans cette fonction), lu par
    # _sur_profils_sautoniax_demande ci-dessous, et jamais muté par
    # MoteurExecutionBatch lui-même : nettoyé en bloc à la fin du
    # traitement (succès ou échec), pas au fil de l'eau -- une instance
    # legacy reste réutilisable pour le sous-projet SUIVANT de la même
    # file tant que le batch entier n'est pas terminé (cf. docstring de
    # MoteurExecutionBatch, "L'INSTANCE N'EST JAMAIS FERMÉE"), donc
    # "actif" doit rester vrai pour toute la durée du batch, pas
    # seulement pendant un sous-projet précis.
    #
    # (Déclaration réelle déplacée plus haut dans cette fonction, cf.
    # "PATCH (point 3 -- pré-déclaration précoce)" -- même dict, jamais
    # réassigné, uniquement pour que _est_instance_geree_par_client_pilote
    # puisse le référencer par closure sans ambiguïté d'ordre textuel.)
    # PATCH (bouton "Initialiser") : "camoufox_cm"/"profil_charge" ajoutés
    # aux clés déjà existantes ("namespace"/"page") -- nécessaires à
    # _sautoniax_initialiser_notebook_distant pour savoir s'il y a un
    # profil PRÉCÉDENT à fermer proprement avant d'en charger un nouveau
    # (cf. sa docstring). Le mode legacy --profil (étape 3 plus bas) les
    # peuple aussi, pour que le bouton "Initialiser" reste capable de
    # fermer proprement CE profil legacy si jamais on lui demande d'en
    # charger un autre par la suite -- un seul point de vérité, quel que
    # soit le chemin qui a chargé le profil actuellement actif.
    namespace_notebook_distant: dict = {
        "namespace": None, "page": None, "camoufox_cm": None, "profil_charge": None,
        # CORRECTIF (contrôle à distance -- cf. docstring de
        # commande_instance_recue côté ClientServeurT) : présentes dès
        # l'init (valeur None) pour qu'un accès .get("context")/etc.
        # avant tout chargement de profil retourne None proprement,
        # plutôt qu'une KeyError si une commande de pilotage arrivait
        # (improbable mais possible en cas de désynchronisation UI) avant
        # la première initialisation.
        "context": None, "gestion": None, "etat_navigateur": None,
    }
    # PATCH (revue de validation 4.4.c -- point 2, kill pendant démarrage
    # des profils) : threading.Event() PLUTÔT qu'un simple bool dans un
    # dict, pour une lisibilité correcte depuis le thread réseau de
    # ClientServeurT (_sur_kill_projet_demande) sans dépendre de l'ordre
    # d'exécution avec la boucle asyncio -- .set()/.is_set() sont déjà
    # thread-safe par construction (CPython), contrairement à un simple
    # attribut muté depuis deux threads. Remis à .clear() À CHAQUE NOUVEAU
    # projet reçu (cf. _sur_projet_sautoniax_recu) -- un kill "consommé"
    # par un projet précédent ne doit jamais annuler le suivant.
    _annulation_projet_demandee = threading.Event()

    def _sur_kill_projet_demande():
        # PATCH (§4.2 -- Kill par ligne) : "le projet en cours, quel qu'il
        # soit" -- deux cas, cf. revue de validation 4.4.c :
        #   1. MoteurExecutionBatch déjà actif (_moteur_batch_courant
        #      peuplé) -- arrêt via moteur.arreter(), comportement
        #      d'origine, inchangé.
        #   2. Un projet est en cours de DÉMARRAGE (téléchargement des
        #      profils / lancement des subprocess instance, AVANT que
        #      MoteurExecutionBatch n'existe -- cf. _sautoniax_traiter_
        #      projet_recu, étape 1/2, potentiellement la phase la plus
        #      longue de tout le flux, 30-50s par profil selon le
        #      commentaire de _lancer_instance_pour_profil) -- sans ce
        #      2e cas, un kill reçu pendant cette fenêtre était un no-op
        #      silencieux : le batch finissait par démarrer quand même,
        #      contraire à "le projet en cours, quel qu'il soit".
        # Les deux cas ne s'excluent pas : on déclenche toujours les deux,
        # chacun est un no-op inoffensif si son propre cas ne s'applique
        # pas actuellement (moteur=None -> rien à arrêter ; event déjà
        # clear ou aucune boucle ne le lit -> rien à annuler).
        _annulation_projet_demandee.set()
        moteur = _moteur_batch_courant.get("moteur")
        if moteur is not None:
            log.info("[sAutoniax] kill_projet reçu -- arrêt du batch en cours.")
            moteur.arreter()
        else:
            log.info("[sAutoniax] kill_projet reçu -- aucun batch actif pour l'instant "
                      "(annulation posée, prise en compte si un démarrage de profils est en cours).")

    client_t.kill_projet_demande.connect(_sur_kill_projet_demande, Qt.DirectConnection)

    def _sur_kill_profil_demande(nom_profil: str, redemarrer: bool):
        # PATCH (arrêt/redémarrage PAR PROFIL -- granularité réelle, cf.
        # docstring de _OrchestrateurMappingProfils.arreter_profil).
        # Un profil actif sur ce sAutoniax provient de TROIS registres
        # possibles, jamais deux à la fois pour un même nom (cf. _sur_
        # profils_sautoniax_demande ci-dessous, même distinction déjà
        # appliquée à l'affichage actif/inactif du panneau propriétés) :
        #   - namespace_notebook_distant["profil_charge"] (PATCH --
        #     demande explicite utilisateur : ce profil apparaissait
        #     désormais "Actif" dans le panneau depuis le correctif de
        #     _sur_profils_sautoniax_demande, mais cliquer "Kill" dessus
        #     tombait avant dans le fallback moteur batch ci-dessous, qui
        #     répondait à TORT "Aucun projet en cours d'exécution sur cet
        #     exécutant" -- message trompeur puisqu'un profil tourne bel
        #     et bien, juste pas via le moteur batch. Vérifié EN PREMIER,
        #     avant _instances_isolees : c'est le cas concerné par la
        #     demande utilisateur actuelle, et il n'y a de toute façon
        #     jamais de recouvrement possible entre les deux (un même nom
        #     ne peut être chargé simultanément par les deux mécanismes).
        #   - _instances_isolees/_procs_isoles (profil démarré seul via
        #     le bouton "Démarrer", subprocess direct SANS file ni
        #     notion de sous-projet).
        #   - le moteur batch courant (_moteur_batch_courant), SEUL le
        #     mode E.7 (_OrchestrateurMappingProfils) sait interrompre un
        #     profil individuellement -- le mode legacy (Moteur
        #     ExecutionBatch, pool FIFO partagé entre profils) n'a pas
        #     cette granularité, cf. sa docstring de classe ("plusieurs
        #     sous-projets tournent en parallèle" sans notion de profil
        #     dédié par fil) : retourne "non disponible" plutôt que
        #     d'agir sur autre chose que le profil demandé par erreur.
        if nom_profil and nom_profil == namespace_notebook_distant.get("profil_charge"):
            if redemarrer:
                # Même raisonnement EXACT que le cas _instances_isolees
                # plus bas : pas de file d'attente pour ce mode mono-
                # profil, "redémarrer" n'a ici aucun sens -- signalé
                # explicitement plutôt que silencieusement ignoré.
                log.warning(f"[sAutoniax] kill_profil reçu (profil='{nom_profil}', redemarrer=True) -- non supporté pour le profil chargé via \"Initialiser\".")
                client_t.envoyer_kill_profil_resultat(
                    nom_profil, redemarrer, False,
                    "Le redémarrage n'est pas supporté pour ce profil (chargé via \"Initialiser\") -- utilise Fermer puis Initialiser.",
                )
                return
            log.info(f"[sAutoniax] kill_profil reçu -- fermeture du profil '{nom_profil}' chargé via \"Initialiser\"/--profil.")

            def _log_kill(ligne: str):
                # Réutilise le même canal que le bouton "Fermer" (cf.
                # _sautoniax_fermer_notebook_distant) -- pas de canal
                # dédié pour un kill_profil déclenché depuis le panneau
                # Instances, cohérent avec le fait que _sur_kill_profil_
                # demande lui-même n'a jamais eu de log de progression
                # (seulement un résultat final).
                pass

            async def _fermer_puis_repondre():
                try:
                    await _sautoniax_fermer_profil_notebook_distant_charge(client_t, namespace_notebook_distant, _log_kill)
                    client_t.envoyer_kill_profil_resultat(nom_profil, redemarrer, True, "")
                except Exception as e:
                    message_erreur = f"{e.__class__.__name__}: {e}"
                    log.warning(f"[sAutoniax] échec fermeture (kill_profil) du profil '{nom_profil}' : {e!r}")
                    client_t.envoyer_kill_profil_resultat(nom_profil, redemarrer, False, message_erreur)

            tache = loop.create_task(_fermer_puis_repondre())
            _taches_projets_en_cours.add(tache)
            tache.add_done_callback(_taches_projets_en_cours.discard)
            return

        if nom_profil in _instances_isolees:
            if redemarrer:
                # Pas de _fil_profil pour un profil isolé (lancement
                # unique et direct, cf. _sautoniax_demarrer_profil_isole)
                # -- contrairement au mode batch, "redémarrer" n'a ici
                # aucune file où remettre le profil en tête : signalé
                # explicitement plutôt que de silencieusement l'ignorer.
                log.warning(f"[sAutoniax] kill_profil reçu (profil='{nom_profil}', redemarrer=True) -- non supporté pour un profil isolé.")
                client_t.envoyer_kill_profil_resultat(
                    nom_profil, redemarrer, False,
                    "Le redémarrage n'est pas supporté pour un profil démarré isolément (utilise Kill puis Démarrer).",
                )
                return
            instance_id = _instances_isolees.get(nom_profil)
            proc = _procs_isoles.get(instance_id) if instance_id else None
            log.info(f"[sAutoniax] kill_profil reçu -- arrêt du profil isolé '{nom_profil}' (instance '{instance_id}').")
            if proc is not None:
                proc.terminate()
                try:
                    proc.wait(timeout=3.0)
                except subprocess.TimeoutExpired:
                    log.warning(f"[sAutoniax] instance isolée '{instance_id}' (PID {proc.pid}) n'a pas répondu à terminate() -> kill()")
                    proc.kill()
                    proc.wait(timeout=3.0)
                _procs_isoles.pop(instance_id, None)
            # AJOUT (Section 8 -- "Arrêter" interrompt le CODE, pas le
            # profil, cf. PLAN_section_8_arreter.md §4/§7 étape 6) :
            # "Kill" doit fermer aussi l'exécuteur de code s'il existe, en
            # plus du navigateur ci-dessus -- sinon un kill_profil
            # laisserait un exécuteur orphelin tournant pour rien. Même
            # patron EXACT (terminate()/wait()/kill() en repli) que le
            # bloc navigateur juste au-dessus.
            proc_executeur = _executeurs_isoles.pop(instance_id, None) if instance_id else None
            if proc_executeur is not None:
                proc_executeur.terminate()
                try:
                    proc_executeur.wait(timeout=3.0)
                except subprocess.TimeoutExpired:
                    log.warning(f"[sAutoniax] exécuteur de '{instance_id}' (PID {proc_executeur.pid}) n'a pas répondu à terminate() -> kill()")
                    proc_executeur.kill()
                    proc_executeur.wait(timeout=3.0)
            _instances_isolees.pop(nom_profil, None)
            _namespaces_isoles.pop(instance_id, None)  # CORRECTIF TIMEOUT : profil tué -> son namespace n'a plus de sens
            _moteurs_relais_courants.pop(instance_id, None)  # CORRECTIF ROUTAGE DYNAMIQUE : idem, plus aucun moteur valide
            client_t.envoyer_kill_profil_resultat(nom_profil, redemarrer, True, "")
            return

        moteur = _moteur_batch_courant.get("moteur")
        if moteur is None:
            log.info(f"[sAutoniax] kill_profil reçu (profil='{nom_profil}') -- aucun batch actif, ignoré.")
            client_t.envoyer_kill_profil_resultat(nom_profil, redemarrer, False, "Aucun projet en cours d'exécution sur cet exécutant.")
            return
        if not hasattr(moteur, "arreter_profil"):
            log.warning(f"[sAutoniax] kill_profil reçu (profil='{nom_profil}') -- mode d'exécution actuel ne supporte pas l'arrêt par profil.")
            client_t.envoyer_kill_profil_resultat(nom_profil, redemarrer, False, "Ce projet ne supporte pas l'arrêt par profil individuel (mode d'exécution hérité).")
            return
        log.info(f"[sAutoniax] kill_profil reçu -- {'redémarrage' if redemarrer else 'arrêt'} demandé pour le profil '{nom_profil}'.")
        ok = moteur.arreter_profil(nom_profil, redemarrer=redemarrer)
        message = "" if ok else f"Le profil '{nom_profil}' n'a actuellement aucune instance en cours sur cet exécutant."
        client_t.envoyer_kill_profil_resultat(nom_profil, redemarrer, ok, message)

    client_t.kill_profil_demande.connect(_sur_kill_profil_demande, Qt.DirectConnection)

    def _sur_arreter_execution_profil_demande(nom_profil: str):
        # AJOUT (Section 8 -- "Arrêter" interrompt le CODE, pas le
        # profil, cf. PLAN_section_8_arreter.md §7 étape 6). Distinct de
        # _sur_kill_profil_demande ci-dessus : ne touche QUE _executeurs_
        # isoles, JAMAIS _procs_isoles/le navigateur/_instances_isolees
        # (lecture seule de ce dernier, pour retrouver l'instance_id du
        # navigateur associé à ce nom de profil -- jamais de .pop()
        # dessus ici, le profil reste actif après un "Arrêter").
        #
        # Cas particuliers propres à "Arrêter" (absents du patron kill) :
        #   - nom_profil pas dans _instances_isolees DU TOUT (profil pas
        #     actif, ou actif via le mode legacy namespace_notebook_
        #     distant/le moteur batch -- "Arrêter" au sens Section 8 est
        #     scope EXCLUSIVEMENT aux profils isolés, cf. plan §6 "Ce qui
        #     ne change pas") : ok=False, message explicite plutôt que de
        #     planter sur un instance_id=None.
        #   - nom_profil dans _instances_isolees mais aucun exécuteur
        #     encore dans _executeurs_isoles pour cet instance_id (aucune
        #     cellule jamais lancée sur ce profil, cf. lancement
        #     paresseux §4) : ok=True quand même -- il n'y a simplement
        #     rien à arrêter, ce n'est pas un échec.
        # PATCH arrêt d'une exécution Camoufox : profil chargé en mode mono-profil
        # (« Initialiser »/--profil). Avant ce patch, l'arrêt n'était accepté que
        # pour les profils isolés (process exécuteur tué) : ici le code tourne
        # dans un thread, interrompu via ControleArretNotebookDistant.
        if nom_profil and nom_profil == namespace_notebook_distant.get("profil_charge") and nom_profil not in _instances_isolees:
            _controle_en_cours = namespace_notebook_distant.get("controle_arret")
            if _controle_en_cours is None:
                log.info(f"[sAutoniax] arreter_execution_profil reçu (profil='{nom_profil}') -- aucune exécution en cours, rien à arrêter.")
            else:
                _declenche = _controle_en_cours.arreter()
                log.info(f"[sAutoniax] arreter_execution_profil reçu (profil='{nom_profil}') -- arrêt de l'exécution notebook {'déclenché' if _declenche else 'déjà demandé'}.")
            client_t.envoyer_arreter_execution_profil_resultat(nom_profil, True, "")
            return
        if nom_profil not in _instances_isolees:
            log.info(f"[sAutoniax] arreter_execution_profil reçu (profil='{nom_profil}') -- pas un profil isolé actif, ignoré.")
            client_t.envoyer_arreter_execution_profil_resultat(
                nom_profil, False,
                "Ce profil n'est pas actif en tant que profil isolé sur cet exécutant (\"Arrêter\" ne s'applique qu'aux profils isolés).",
            )
            return
        instance_id = _instances_isolees.get(nom_profil)
        proc_executeur = _executeurs_isoles.pop(instance_id, None) if instance_id else None
        if proc_executeur is None:
            log.info(f"[sAutoniax] arreter_execution_profil reçu -- aucun exécuteur actif pour le profil isolé '{nom_profil}' (instance '{instance_id}'), rien à arrêter.")
            client_t.envoyer_arreter_execution_profil_resultat(nom_profil, True, "")
            return
        log.info(f"[sAutoniax] arreter_execution_profil reçu -- arrêt de l'exécuteur du profil isolé '{nom_profil}' (instance '{instance_id}').")
        # CORRECTIF (fuite tâche/thread confirmée en usage réel -- cf. logs
        # "DIAG-CONCURRENCE" : une session lancée juste avant un "Arrêter"
        # pendant qu'une cellule tournait réellement (pas juste en attente
        # de connexion exécuteur) restait comptée "en vol" plusieurs
        # minutes après). Cause : _sautoniax_executer_notebook_distant_sur_
        # instance_isolee attend son executer_code_resultat via
        # event.wait() SANS timeout (cf. son étape 3, volontaire pour ne
        # pas couper une cellule légitimement longue) -- mais l'exécuteur
        # tué ici par terminate()/kill() ne peut plus jamais répondre à sa
        # requête en cours, donc cet event n'était jamais signalé : la
        # coroutine restait bloquée à vie (thread run_in_executor jamais
        # libéré, tâche asyncio jamais "done", jamais retirée de
        # _taches_projets_en_cours, entrée _callbacks_executer_code_en_
        # attente jamais nettoyée). On débloque ici, AVANT terminate(),
        # toute requête encore en attente pour CET instance_id précis, en
        # posant un résultat d'échec explicite -- même mécanisme que
        # _sur_executer_code_resultat_recu (boite_resultat["data"] +
        # event.set()), pour que l'étape 3 se réveille immédiatement et
        # transmette proprement l'échec au pilote au lieu de pendre.
        for _requete_id_en_attente, (_event_en_attente, _boite_en_attente, _instance_id_en_attente) in list(
            _callbacks_executer_code_en_attente.items()
        ):
            if _instance_id_en_attente != instance_id:
                continue
            _boite_en_attente["data"] = {
                "type": "executer_code_resultat", "instance_id": instance_id,
                "requete_id": _requete_id_en_attente, "ok": False,
                "erreur": f"exécution interrompue : profil '{nom_profil}' arrêté explicitement (Arrêter) pendant que cette cellule tournait.",
                "sortie": "",
            }
            _event_en_attente.set()
            log.info(
                f"[sAutoniax] arreter_execution_profil : requête executer_code en attente "
                f"(requete_id={_requete_id_en_attente!r}) débloquée avant terminate() de l'exécuteur '{instance_id}'."
            )
        proc_executeur.terminate()
        try:
            proc_executeur.wait(timeout=3.0)
        except subprocess.TimeoutExpired:
            log.warning(f"[sAutoniax] exécuteur de '{instance_id}' (PID {proc_executeur.pid}) n'a pas répondu à terminate() -> kill()")
            proc_executeur.kill()
            proc_executeur.wait(timeout=3.0)
        # v7 : l'exécuteur est relancé tout de suite, en arrière-plan : la prochaine cellule n'attend plus ses ~10-17 s de démarrage.
        try:
            _sautoniax_lancer_executeur_isole(instance_id, _executeurs_isoles)
        except OSError as _e_relance:
            log.warning(f"[sAutoniax] relance de l'exécuteur de '{instance_id}' impossible ({_e_relance!r}) : il sera lancé à la prochaine cellule.")
        client_t.envoyer_arreter_execution_profil_resultat(nom_profil, True, "")

    client_t.arreter_execution_profil_demande.connect(_sur_arreter_execution_profil_demande, Qt.DirectConnection)

    def _sur_upload_profil_vers_cloud_demande(nom_profil: str, id_pilote: str):
        # PATCH (bouton "Mettre à jour vers le cloud" du panneau de
        # propriétés -- demande explicite utilisateur : "un bouton de
        # mise a jour de ce profils vers le cloud en passant par le
        # serveurT"). Le profil DOIT déjà être présent localement (cf.
        # _sautoniax_assurer_profil_local_bloquant/_sautoniax_assurer_
        # profil_local, appelées AVANT toute exécution -- un profil
        # "en cours" affiché côté pilote a nécessairement déjà été
        # téléchargé) : aucun nouveau téléchargement déclenché ici,
        # seulement l'upload de ce qui existe déjà sur ce disque, qui
        # peut avoir été MODIFIÉ par la session en cours (cache, cookies,
        # état du navigateur...) -- c'est justement l'intérêt de ce
        # bouton par rapport à un simple re-upload depuis le pilote, qui
        # n'a lui qu'une copie potentiellement périmée en local.
        dossier_profils_sautoniax = _chemin_donnees("sautoniax_profils")
        dossier_profil = dossier_profils_sautoniax / _nom_dossier_valide(nom_profil)
        if not dossier_profil.exists() or not any(dossier_profil.iterdir()):
            log.warning(f"[sAutoniax] upload_profil_vers_cloud refusé : profil '{nom_profil}' absent localement ({dossier_profil}).")
            client_t.envoyer_upload_profil_echec_local(nom_profil, "Profil absent localement sur cet exécutant.")
            return
        log.info(f"[sAutoniax] Envoi de '{nom_profil}' en cours...")
        client_t.envoyer_profil(nom_profil, str(dossier_profil), id_pilote_cible=id_pilote)

    client_t.upload_profil_vers_cloud_demande.connect(_sur_upload_profil_vers_cloud_demande, Qt.DirectConnection)

    def _sur_renommer_profil_sautoniax_demande(ancien_nom: str, nouveau_nom: str, id_pilote: str):
        # PATCH (bouton "Renommer" du panneau de propriétés -- demande
        # explicite utilisateur : "on puisse renommer un profil qui est
        # sur un sautoniax (on le renomme quand il est fermé, pas en
        # cours)"). Refuse si le profil est actif sur CET exécutant --
        # même critère de détection EXACT (fusion des mêmes quatre
        # registres) que _sur_profils_sautoniax_demande ci-dessus, cf. sa
        # docstring pour le détail des quatre sources. Un renommage à
        # chaud désynchroniserait le nom affiché de l'instance déjà en
        # cours (instance_id dérivé du nom au lancement), même risque
        # exact que documenté sur renommer_profil() (registre local
        # côté pilote).
        nouveau_nom = nouveau_nom.strip()
        if not nouveau_nom:
            client_t.envoyer_renommer_profil_sautoniax_resultat(id_pilote, ancien_nom, nouveau_nom, False, "Le nouveau nom ne peut pas être vide.")
            return
        if nouveau_nom == ancien_nom:
            client_t.envoyer_renommer_profil_sautoniax_resultat(id_pilote, ancien_nom, nouveau_nom, True, "")
            return

        moteur = _moteur_batch_courant.get("moteur")
        instances_actives_batch: dict = {}
        if moteur is not None and hasattr(moteur, "_instances_par_profil"):
            instances_actives_batch = dict(moteur._instances_par_profil)
        profil_notebook_distant_charge = namespace_notebook_distant.get("profil_charge")
        instances_notebook_distant = (
            {profil_notebook_distant_charge: instance_id} if profil_notebook_distant_charge else {}
        )
        registres_fusionnes = {
            **instances_actives_batch, **_instances_isolees,
            **_instances_legacy_par_profil, **instances_notebook_distant,
        }
        if ancien_nom in registres_fusionnes:
            log.warning(f"[sAutoniax] renommer_profil_sautoniax refusé : '{ancien_nom}' est actif sur cet exécutant.")
            client_t.envoyer_renommer_profil_sautoniax_resultat(id_pilote, ancien_nom, nouveau_nom, False, "Ce profil est actif -- arrêtez-le avant de le renommer.")
            return

        dossier_profils_sautoniax = _chemin_donnees("sautoniax_profils")
        dossier_ancien = dossier_profils_sautoniax / _nom_dossier_valide(ancien_nom)
        if not dossier_ancien.exists() or not any(dossier_ancien.iterdir()):
            log.warning(f"[sAutoniax] renommer_profil_sautoniax refusé : profil '{ancien_nom}' absent localement ({dossier_ancien}).")
            client_t.envoyer_renommer_profil_sautoniax_resultat(id_pilote, ancien_nom, nouveau_nom, False, "Profil absent localement sur cet exécutant.")
            return
        dossier_nouveau = dossier_profils_sautoniax / _nom_dossier_valide(nouveau_nom)
        if dossier_nouveau.exists():
            log.warning(f"[sAutoniax] renommer_profil_sautoniax refusé : '{nouveau_nom}' existe déjà ({dossier_nouveau}).")
            client_t.envoyer_renommer_profil_sautoniax_resultat(id_pilote, ancien_nom, nouveau_nom, False, "Un profil porte déjà ce nom sur cet exécutant.")
            return

        try:
            dossier_ancien.rename(dossier_nouveau)
        except OSError as e:
            log.warning(f"[sAutoniax] renommer_profil_sautoniax : échec du renommage du dossier '{ancien_nom}' -> '{nouveau_nom}' ({e!r}).")
            client_t.envoyer_renommer_profil_sautoniax_resultat(id_pilote, ancien_nom, nouveau_nom, False, f"Échec du renommage sur le disque : {e}")
            return

        # Migre la clé dans profils_config.json (type d'instance, proxy,
        # pays, badges youtube/tiktok/ia/favori...) -- même prudence que
        # renommer_profil() côté pilote local : sans ça, le profil
        # renommé "perdrait" sa config et retomberait sur les valeurs
        # par défaut au prochain obtenir_config_profil(nouveau_nom).
        try:
            configs = charger_registre_profils_config()
            if ancien_nom in configs:
                configs[nouveau_nom] = configs.pop(ancien_nom)
                sauvegarder_registre_profils_config(configs)
        except Exception:
            log.warning(f"[sAutoniax] renommer_profil_sautoniax : dossier renommé mais échec de migration de la config ('{ancien_nom}' -> '{nouveau_nom}').", exc_info=True)

        log.info(f"[sAutoniax] renommer_profil_sautoniax : '{ancien_nom}' -> '{nouveau_nom}' effectué (id_pilote={id_pilote!r}).")
        client_t.envoyer_renommer_profil_sautoniax_resultat(id_pilote, ancien_nom, nouveau_nom, True, "")

    client_t.renommer_profil_sautoniax_demande.connect(_sur_renommer_profil_sautoniax_demande, Qt.DirectConnection)

    def _sur_profils_sautoniax_demande(id_pilote: str):
        # PATCH (Patch 4.2 -- panneau propriétés de l'onglet Instances,
        # bouton "Rafraîchir" explicite) : scanne le dossier sautoniax_
        # profils/ (un sous-dossier non vide = un profil présent
        # localement, même critère que _sautoniax_assurer_profil_local)
        # et croise avec les QUATRE registres d'instances actives
        # possibles sur ce sAutoniax :
        #   - _moteur_batch_courant["moteur"]._instances_par_profil (un
        #     ProjetBatch E.7 est en cours -- absent/vide sinon)
        #   - _instances_isolees (profils démarrés un par un, cf. ci-
        #     dessous _sur_demarrer_profil_isole_demande)
        #   - _instances_legacy_par_profil (PATCH -- demande explicite
        #     utilisateur : un profil lancé via TaskScript Editor en mode
        #     réseau, càd le flux LEGACY de MoteurExecutionBatch sans
        #     mapping_profils_sous_projets, n'apparaissait jamais actif
        #     ici -- ce moteur-là ne porte PAS _instances_par_profil, cf.
        #     hasattr ci-dessous, donc son mapping est tenu séparément
        #     par _sautoniax_traiter_projet_recu, cf. sa docstring)
        #   - namespace_notebook_distant["profil_charge"] (PATCH --
        #     demande explicite utilisateur, cf. "je ne comprend pas
        #     pourquoi dans instance quand je clique dessus après avoir
        #     lancé le profil dans TaskScript Editor ça affiche encore
        #     inactif") : le profil chargé par le bouton "Initialiser" du
        #     TaskScript Editor réseau (OU par le legacy `--profil` CLI,
        #     qui peuple le même dict, cf. son commentaire de
        #     déclaration) N'ÉTAIT DANS AUCUN des trois registres
        #     ci-dessus -- ce mode mono-profil vit dans un dict à part
        #     (namespace_notebook_distant), avec un SEUL profil possible
        #     à la fois (son nom dans "profil_charge", None si aucun),
        #     partageant le MÊME instance_id que tout le process
        #     sAutoniax (paramètre `instance_id` de _main_async_sautoniax
        #     -- pas un instance_id par profil comme les trois autres
        #     registres, puisque ce mode ne peut jamais avoir plus d'un
        #     profil actif simultanément).
        # Un profil actif par UN OU PLUSIEURS de ces registres est reporté
        # actif -- aucun ne se recouvre avec un autre en pratique (un même
        # nom_profil ne peut être chargé par deux mécanismes à la fois),
        # donc aucune priorité à trancher en cas de conflit.
        dossier_profils_sautoniax = _chemin_donnees("sautoniax_profils")
        noms_locaux = sorted(
            p.name for p in dossier_profils_sautoniax.iterdir()
            if p.is_dir() and any(p.iterdir())
        ) if dossier_profils_sautoniax.exists() else []

        instances_actives_batch: dict = {}
        moteur = _moteur_batch_courant.get("moteur")
        if moteur is not None and hasattr(moteur, "_instances_par_profil"):
            instances_actives_batch = dict(moteur._instances_par_profil)

        profil_notebook_distant_charge = namespace_notebook_distant.get("profil_charge")
        instances_notebook_distant = (
            {profil_notebook_distant_charge: instance_id} if profil_notebook_distant_charge else {}
        )

        registres_fusionnes = {
            **instances_actives_batch, **_instances_isolees,
            **_instances_legacy_par_profil, **instances_notebook_distant,
        }

        # PATCH H : profils sur lesquels une cellule de notebook distant tourne EN CE MOMENT (tâche non terminée) -> nom : heure de début.
        # Permet au pilote de réafficher « en cours » (et non « play ») après une coupure réseau.
        _en_cours_par_profil = {}
        for _t in list(_taches_projets_en_cours):
            _n = getattr(_t, "_diag_profil_nom", None)
            if _n and not _t.done():
                _en_cours_par_profil[_n] = getattr(_t, "_diag_debut", None)
        profils = []
        noms_vus = set()
        for nom in noms_locaux:
            noms_vus.add(nom)
            instance_id_profil = registres_fusionnes.get(nom, "")
            # PATCH (SPEC_proxy_natif_tunnel.md, section 13.2) -- l'état
            # "proxy natif" est lu depuis profils_config.json (même
            # source que le type d'instance/proxy externe/badges) et
            # transmis tel quel au pilote, qui n'a lui-même aucun accès
            # direct à ce fichier (il vit uniquement sur ce sAutoniax).
            profils.append({
                "nom": nom, "actif": bool(instance_id_profil), "instance_id": instance_id_profil,
                "proxy_natif": bool(obtenir_config_profil(nom).get("proxy_natif")),
                "en_cours": nom in _en_cours_par_profil, "debut_execution": _en_cours_par_profil.get(nom),
            })
        # Un profil peut être ACTIF (instance_id connu côté registre)
        # sans que son dossier local ait été retrouvé par le nom exact
        # scanné ci-dessus (cas limite -- nom assaini différemment, cf.
        # _nom_dossier_valide) : ajouté quand même, plutôt que de faire
        # disparaître une instance réellement en cours de la liste.
        # CORRECTIF -- variable de boucle renommée en `instance_id_profil`
        # (au lieu de `instance_id`) : elle masquait sinon le PARAMÈTRE
        # `instance_id` de _main_async_sautoniax (fonction englobante),
        # que la ligne `instances_notebook_distant = ({... : instance_id}
        # ...)` plus haut lit par closure -- Python classe `instance_id`
        # comme variable LOCALE à _sur_profils_sautoniax_demande dès qu'une
        # affectation existe n'importe où dans son corps (même plus bas,
        # même dans une boucle for), ce qui levait UnboundLocalError à
        # l'exécution de cette ligne plus haut, AVANT que la boucle
        # n'ait eu la chance de l'assigner.
        for nom, instance_id_profil in registres_fusionnes.items():
            if nom not in noms_vus:
                # PATCH (SPEC_proxy_natif_tunnel.md, section 13.2) --
                # même ajout que la boucle ci-dessus, pour ce cas limite
                # (profil actif mais dossier local non retrouvé par nom
                # exact).
                profils.append({
                    "nom": nom, "actif": True, "instance_id": instance_id_profil,
                    "proxy_natif": bool(obtenir_config_profil(nom).get("proxy_natif")),
                    "en_cours": nom in _en_cours_par_profil, "debut_execution": _en_cours_par_profil.get(nom),
                })

        log.info(f"[sAutoniax] profils_sautoniax demandé par le pilote '{id_pilote}' -- {len(profils)} profil(s) ({sum(1 for p in profils if p['actif'])} actif(s)).")
        client_t.envoyer_profils_sautoniax_resultat(id_pilote, profils)

    client_t.profils_sautoniax_demande.connect(_sur_profils_sautoniax_demande, Qt.DirectConnection)

    # PATCH (Profils Kaggle, phase 3) -- ordres Kaggle du pilote (relayes par serveur.py).
    # Les transferts sont BLOQUANTS : chaque ordre tourne dans un thread dedie (jamais sur le
    # thread reseau ni Qt), un seul ordre de transfert a la fois sur ce sAutoniax. Le pilote
    # envoie UN profil par ordre et borne le total a MAX_TRANSFERTS_SIMULTANES.
    _verrou_transfert_kaggle = threading.Lock()

    def _kaggle_noms_actifs() -> set:
        actifs: set = set()
        moteur_k = _moteur_batch_courant.get("moteur")
        if moteur_k is not None and hasattr(moteur_k, "_instances_par_profil"):
            actifs |= {n for n, v in dict(moteur_k._instances_par_profil).items() if v}
        actifs |= {n for n, v in dict(_instances_isolees).items() if v}
        actifs |= {n for n, v in dict(_instances_legacy_par_profil).items() if v}
        if namespace_notebook_distant.get("profil_charge"):
            actifs.add(namespace_notebook_distant["profil_charge"])
        for _tk in list(_taches_projets_en_cours):
            _nk = getattr(_tk, "_diag_profil_nom", None)
            if _nk and not _tk.done():
                actifs.add(_nk)
        return actifs

    def _kaggle_travail(type_ordre: str, msg: dict):
        id_pilote = msg.get("id_pilote", "")
        id_operation = msg.get("id_operation", "")
        dossier_profils = str(_chemin_donnees("sautoniax_profils"))
        try:
            if type_ordre == "kaggle_lister_profils":
                profils_k = scanner_profils_kaggle(dossier_profils, _kaggle_noms_actifs())
                log.info(f"[sAutoniax] kaggle_lister_profils : {len(profils_k)} profil(s).")
                client_t.envoyer_kaggle_vers_pilote("kaggle_lister_profils_resultat", id_pilote,
                                                    id_operation=id_operation, profils=profils_k)
                return
            profils_ordre = [p for p in (msg.get("profils") or []) if isinstance(p, dict)]
            if type_ordre == "kaggle_telecharger_profils":
                with _verrou_transfert_kaggle:
                    gestionnaire = GestionnaireKaggle()
                    for p in profils_ordre:
                        nom_dl = str(p.get("nom_local") or p.get("nom_archive", ""))

                        def _prog_dl(etape, pct, _n=nom_dl):
                            client_t.envoyer_kaggle_vers_pilote("kaggle_progression", id_pilote, id_operation=id_operation,
                                                                nom_local=_n, etape=etape, pourcentage=int(pct))

                        ok_d, message_d = traiter_telechargement_kaggle(
                            gestionnaire, dossier_profils, p, _kaggle_noms_actifs(), progression=_prog_dl)
                        log.info(f"[sAutoniax] kaggle telechargement '{nom_dl}' : ok={ok_d} -- {message_d}")
                        client_t.envoyer_kaggle_vers_pilote("kaggle_resultat", id_pilote, id_operation=id_operation,
                                                            nom_local=nom_dl, ok=ok_d, message=message_d)
                return
            with _verrou_transfert_kaggle:
                gestionnaire = GestionnaireKaggle()
                for p in profils_ordre:
                    nom_local_k = str(p.get("nom_local", ""))

                    def _prog(etape, pct, _n=nom_local_k):
                        client_t.envoyer_kaggle_vers_pilote("kaggle_progression", id_pilote, id_operation=id_operation,
                                                            nom_local=_n, etape=etape, pourcentage=int(pct))

                    # l'arret confirme par le pilote peut mettre quelques secondes a vider les registres
                    for _ in range(15):
                        if nom_local_k not in _kaggle_noms_actifs():
                            break
                        time.sleep(1)
                    ok_k, message_k = traiter_envoi_kaggle(
                        gestionnaire, dossier_profils, p, bool(msg.get("supprimer_local")),
                        _kaggle_noms_actifs(), instance=str(instance_id), progression=_prog)
                    log.info(f"[sAutoniax] kaggle envoi '{nom_local_k}' : ok={ok_k} -- {message_k}")
                    client_t.envoyer_kaggle_vers_pilote("kaggle_resultat", id_pilote, id_operation=id_operation,
                                                        nom_local=nom_local_k, ok=ok_k, message=message_k)
        except Exception as e:
            log.exception("[sAutoniax] ordre Kaggle en echec")
            for p in ([{}] if type_ordre == "kaggle_lister_profils" else (msg.get("profils") or [{}])):
                client_t.envoyer_kaggle_vers_pilote(
                    "kaggle_resultat", id_pilote, id_operation=id_operation,
                    nom_local=str(p.get("nom_local") or p.get("nom_archive", "")) if isinstance(p, dict) else "", ok=False, message=str(e))

    def _sur_kaggle_ordre_recu(type_ordre: str, msg: dict):
        threading.Thread(target=_kaggle_travail, args=(type_ordre, msg), name="kaggle-sautoniax", daemon=True).start()

    client_t.kaggle_ordre_recu.connect(_sur_kaggle_ordre_recu, Qt.DirectConnection)

    def _sur_demarrer_profil_isole_demande(nom_profil: str, id_pilote: str):
        # PATCH (Patch 4.2 -- bouton "Démarrer" sur un profil inactif du
        # panneau propriétés) : démarre CE profil seul, SANS ProjetBatch
        # (même mécanisme que le Notebook Distant -- un profil chargé
        # "pour rien faire de précis dessus" sinon être piloté/observé à
        # distance via FenetreRenduTaskReseau). Refuse si le profil est
        # déjà actif par CE mécanisme OU par un ProjetBatch en cours
        # (_moteur_batch_courant) -- jamais deux instances pour le même
        # nom_profil sur un même sAutoniax (cf. registre _instances_
        # isolees, même principe que le pool E.7).
        moteur = _moteur_batch_courant.get("moteur")
        deja_actif_batch = (
            moteur is not None and hasattr(moteur, "_instances_par_profil")
            and nom_profil in moteur._instances_par_profil
        )
        if nom_profil in _instances_isolees or deja_actif_batch:
            log.warning(f"[sAutoniax] demarrer_profil_isole refusé : '{nom_profil}' déjà actif sur cet exécutant.")
            client_t.envoyer_demarrer_profil_isole_resultat(nom_profil, False, "", "Ce profil est déjà actif sur cet exécutant.")
            return

        def _programmer():
            tache = loop.create_task(_sautoniax_demarrer_profil_isole(
                client_t, loop, nom_profil, id_pilote, _instances_isolees, _procs_isoles,
                callback_instance_prete=_lier_instance_isolee_au_client_pilote,
                relais_proxy_local=relais_proxy_local,
                _executeurs_isoles=_executeurs_isoles,
            ))
            _taches_projets_en_cours.add(tache)
            tache.add_done_callback(_taches_projets_en_cours.discard)
        loop.call_soon_threadsafe(_programmer)

    client_t.demarrer_profil_isole_demande.connect(_sur_demarrer_profil_isole_demande, Qt.DirectConnection)

    def _sur_tester_proxy_sautoniax_demande(proxy_texte: str, id_pilote: str):
        # PATCH (bouton "+" du panneau de propriétés -- dialogue de
        # création de profil, bouton "Tester le proxy" -- décision
        # explicite utilisateur : "test EN LOCAL par le sAutoniax distant
        # lui-même"). Simple enveloppe autour de _sautoniax_tester_proxy
        # (cf. sa docstring) pour répondre au pilote demandeur via
        # envoyer_tester_proxy_sautoniax_resultat -- RELAIS DIRECT
        # (id_pilote), PAS une diffusion (même patron que _sur_
