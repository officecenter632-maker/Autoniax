# ---------------------------------------------------------------------------
# Icône de l'application — anneau de pilotage (3 rayons = 3 pilotes possibles
# sur une instance : humain, IA, séquence automatisée) autour d'un chevron
# "lecture" (l'automatisation en cours d'exécution). SVG inline, généré en
# QPixmap à la volée (aucun fichier .ico/.png externe à livrer à côté du
# script) -- même approche que le reste de l'app pour les icônes vectorielles.
# Distincte du logo IngeniaX Explorer (deux cercles reliés = fichiers) tout
# en restant dans la même famille de palette Mocha (mauve/lavender/blue).
# ---------------------------------------------------------------------------
# Icône AutoniaX : monogramme A (dégradé orange -> rose) avec un X blanc dans le jambage, sur carré arrondi sombre.
_ICON_SVG_AUTONIAX = (
    b'<svg xmlns="http://www.w3.org/2000/svg" viewBox="0 0 256 256">'
    b'<defs><linearGradient id="ax" x1="0" y1="0" x2="1" y2="1">'
    b'<stop offset="0" stop-color="#FF9A3D"/><stop offset="1" stop-color="#FF3D81"/></linearGradient></defs>'
    b'<rect width="256" height="256" rx="58" fill="#13121A"/>'
    b'<path d="M58 212L128 44L198 212" fill="none" stroke="url(#ax)" stroke-width="28" stroke-linecap="round" stroke-linejoin="round"/>'
    b'<path d="M108 138L148 178M148 138L108 178" stroke="#fff" stroke-width="14" stroke-linecap="round"/>'
    b'</svg>'
)


def _generate_icon_pixmap_autoniax(size: int = 64) -> QPixmap:
    """Génère le QPixmap de l'icône AutoniaX depuis le SVG inline ci-dessus.
    Fond transparent -- utilisable aussi bien pour setWindowIcon() (barre des
    tâches Windows) que pour l'icône affichée dans la CustomTitleBar."""
    try:
        renderer = QSvgRenderer(QByteArray(_ICON_SVG_AUTONIAX))
        pixmap = QPixmap(size, size)
        pixmap.fill(Qt.GlobalColor.transparent)
        painter = QPainter(pixmap)
        painter.setRenderHint(QPainter.RenderHint.Antialiasing)
        renderer.render(painter)
        painter.end()
        return pixmap
    except Exception:
        # Filet de sécurité : un carré uni plutôt qu'un crash si le rendu
        # SVG échoue pour une raison quelconque (module Qt SVG absent, etc.)
        pixmap = QPixmap(size, size)
        pixmap.fill(QColor(Mocha.base))
        return pixmap


# ---------------------------------------------------------------------------
# Palette locale au splash -- QColor pré-construites (évite de reconstruire
# un QColor à chaque frame dans paintEvent). Reprend la palette Mocha, mais
# sous forme QColor directement utilisable par QPainter.
# ---------------------------------------------------------------------------
_SP_BG      = QColor(Mocha.base)
_SP_BG_DARK = QColor(Mocha.crust)
_SP_BG_MID  = QColor(Mocha.mantle)
_SP_BORDER  = QColor(Mocha.surface0)
_SP_TEXT    = QColor(Mocha.text)
_SP_COMMENT = QColor(Mocha.overlay0)
_SP_BLUE    = QColor(Mocha.blue)
_SP_MAUVE   = QColor(Mocha.mauve)
_SP_LAVENDER = QColor(Mocha.lavender)
_SP_YELLOW  = QColor(Mocha.yellow)
_SP_TEAL    = QColor(Mocha.teal)


def _sp_ease_out(t: float) -> float:
    t = max(0.0, min(1.0, t))
    return 1 - (1 - t) ** 3


def _sp_ease_in_out(t: float) -> float:
    t = max(0.0, min(1.0, t))
    if t < 0.5:
        return 4 * t * t * t
    return 1 - ((-2 * t + 2) ** 3) / 2


def _sp_lerp(a, b, t):
    return a + (b - a) * max(0.0, min(1.0, t))


def _sp_clamp(t):
    return max(0.0, min(1.0, t))


# ---------------------------------------------------------------------------
# SplashScreen -- QPainter 100% natif, aucune dépendance externe. Rejoue en
# ~6.6s l'anneau de pilotage de l'icône (cf. _ICON_SVG_AUTONIAX) : les 3
# rayons se dessinent un par un (façon "connexion en cours" à un pilote),
# convergent vers le moyeu central qui pulse, puis le nom de l'app s'écrit
# et un scan radar clôt l'animation avant le fondu vers MainWindow.
# ---------------------------------------------------------------------------
class SplashScreen(QWidget):

    W, H  = 620, 380
    FPS   = 60
    TOTAL = 6600

    CX = W // 2
    CY = H // 2 - 30
    R_OUT  = 62     # rayon de l'anneau de pilotage
    R_HUB  = 22     # rayon du moyeu central
    R_TIP  = 7      # rayon des pastilles en bout de rayon

    # Angles des 3 rayons (haut, bas-droite, bas-gauche), comme l'icône SVG.
    _SPOKE_ANGLES = [-90, 30, 150]
    _SPOKE_COLORS = [_SP_YELLOW, _SP_TEAL, _SP_TEAL]

    def __init__(self, parent=None):
        super().__init__(parent)
        self._main_window = None
        self._elapsed = 0
        self.setWindowFlags(
            Qt.WindowType.FramelessWindowHint |
            Qt.WindowType.WindowStaysOnTopHint |
            Qt.WindowType.Tool)
        self.setAttribute(Qt.WidgetAttribute.WA_TranslucentBackground, False)
        self.setFixedSize(self.W, self.H)
        screen = QApplication.primaryScreen().availableGeometry()
        self.move(
            screen.x() + (screen.width() - self.W) // 2,
            screen.y() + (screen.height() - self.H) // 2)
        self._timer = QTimer(self)
        self._timer.setInterval(1000 // self.FPS)
        self._timer.timeout.connect(self._tick)
        self._timer.start()

    def set_main_window(self, win):
        self._main_window = win

    def _tick(self):
        self._elapsed += 1000 // self.FPS
        self.update()
        if self._elapsed >= self.TOTAL:
            self._timer.stop()
            self._finish()

    def _finish(self):
        if self._main_window is not None:
            self._main_window.show()
        self.close()

    def _phase(self, start_ms, end_ms):
        if self._elapsed < start_ms:
            return 0.0
        if self._elapsed >= end_ms:
            return 1.0
        return (self._elapsed - start_ms) / (end_ms - start_ms)

    def _spoke_pos(self, angle_deg, r):
        rad = math.radians(angle_deg)
        return (self.CX + r * math.cos(rad), self.CY + r * math.sin(rad))

    def paintEvent(self, event):
        p = QPainter(self)
        p.setRenderHint(QPainter.RenderHint.Antialiasing)
        p.setRenderHint(QPainter.RenderHint.TextAntialiasing)
        p.fillRect(self.rect(), _SP_BG)
        e = self._elapsed

        self._draw_card(p, _sp_ease_out(self._phase(0, 350)))

        # Anneau extérieur -- se dessine en un tour complet.
        ring_p = _sp_ease_out(self._phase(350, 950))
        if ring_p > 0:
            self._draw_ring(p, ring_p)

        # Les 3 rayons apparaissent l'un après l'autre, du centre vers le
        # bord, chacun suivi de sa pastille -- rejoue "établir une liaison
        # de pilotage" trois fois de suite.
        spoke_windows = [(950, 1300), (1300, 1650), (1650, 2000)]
        for i, (s, en) in enumerate(spoke_windows):
            if e >= s:
                sp = _sp_ease_out(self._phase(s, en))
                self._draw_spoke(p, i, sp)

        # Moyeu central + chevron -- apparaît une fois les 3 rayons posés.
        if e >= 2000:
            hub_p = _sp_ease_out(self._phase(2000, 2450))
            self._draw_hub(p, hub_p)

        # Halo de confirmation -- un battement net une fois le moyeu posé.
        if e >= 2450:
            pulse_t = self._phase(2450, 2900)
            self._draw_confirm_pulse(p, pulse_t)

        # Titre, lettre par lettre.
        if e >= 2750:
            self._draw_title_partial(p, _sp_ease_out(self._phase(2750, 3550)))

        # Sous-titre + tirets déco.
        if e >= 3550:
            sub_a = _sp_ease_out(self._phase(3550, 4200))
            self._draw_subtitle(p, sub_a, _sp_lerp(0, 5, sub_a))

        # Scan radar -- balaie l'intérieur de l'anneau, façon "recherche
        # d'instances actives".
        if e >= 4200:
            self._draw_scan(p, _sp_ease_in_out(self._phase(4200, 5300)))

        # Pulse de sortie -- l'anneau "respire" une dernière fois avant le
        # fondu vers la fenêtre principale.
        if e >= 5300:
            pt = self._phase(5300, 5900)
            self._draw_pulse(p, self.R_OUT + _sp_lerp(0, 20, pt), _sp_lerp(0.55, 0.0, pt))

        if e >= 5800:
            overlay = QColor(_SP_BG)
            overlay.setAlphaF(_sp_ease_out(self._phase(5800, 6600)))
            p.fillRect(self.rect(), overlay)

        p.end()

    # -- Éléments de la scène ------------------------------------------------
    def _draw_card(self, p, alpha):
        if alpha <= 0:
            return
        cw, ch = 420, 300
        cx = self.CX - cw // 2
        cy = self.CY - 132
        p.save()
        p.setOpacity(alpha)
        path = QPainterPath()
        path.addRoundedRect(float(cx), float(cy), float(cw), float(ch), 18.0, 18.0)
        p.fillPath(path, _SP_BG_DARK)
        p.setPen(QPen(_SP_BORDER, 1.5))
        p.drawPath(path)
        p.restore()

    def _draw_ring(self, p, progress):
        p.save()
        pen = QPen(_SP_LAVENDER, 3.0)
        pen.setCapStyle(Qt.PenCapStyle.RoundCap)
        p.setPen(pen)
        p.setBrush(Qt.BrushStyle.NoBrush)
        r = self.R_OUT
        rect = QRect(self.CX - r, self.CY - r, r * 2, r * 2)
        p.drawArc(rect, 90 * 16, -int(360 * 16 * _sp_clamp(progress)))
        p.restore()

    def _draw_spoke(self, p, index, progress):
        if progress <= 0:
            return
        angle = self._SPOKE_ANGLES[index]
        color = self._SPOKE_COLORS[index]
        r_hub_edge = self.R_HUB - 2
        r_full = self.R_OUT - self.R_TIP - 2
        x0, y0 = self._spoke_pos(angle, r_hub_edge)
        x1, y1 = self._spoke_pos(angle, _sp_lerp(r_hub_edge, r_full, progress))
        p.save()
        pen = QPen(QColor(Mocha.lavender), 4.5)
        pen.setCapStyle(Qt.PenCapStyle.RoundCap)
        p.setPen(pen)
        p.drawLine(QPointF(x0, y0), QPointF(x1, y1))
        p.restore()
        if progress >= 0.92:
            tip_a = _sp_clamp((progress - 0.92) / 0.08)
            tx, ty = self._spoke_pos(angle, r_full)
            self._draw_dot(p, tx, ty, self.R_TIP, color, tip_a)

    def _draw_dot(self, p, cx, cy, r, color, alpha):
        if alpha <= 0:
            return
        ar = r * _sp_ease_out(_sp_clamp(alpha))
        if ar <= 0:
            return
        p.save()
        c = QColor(color)
        c.setAlphaF(_sp_clamp(alpha))
        p.setBrush(QBrush(c))
        p.setPen(Qt.PenStyle.NoPen)
        p.drawEllipse(QPointF(cx, cy), ar, ar)
        p.restore()

    def _draw_hub(self, p, progress):
        if progress <= 0:
            return
        r = self.R_HUB * _sp_ease_out(progress)
        p.save()
        p.setOpacity(_sp_clamp(progress))
        grad = QLinearGradient(self.CX - r, self.CY - r, self.CX + r, self.CY + r)
        grad.setColorAt(0.0, QColor(Mocha.mauve))
        grad.setColorAt(1.0, QColor(Mocha.blue))
        p.setBrush(QBrush(grad))
        p.setPen(Qt.PenStyle.NoPen)
        p.drawEllipse(QPointF(self.CX, self.CY), r, r)
        # Chevron "lecture" au centre, une fois le moyeu presque posé.
        if progress >= 0.6:
            chevron_a = _sp_clamp((progress - 0.6) / 0.4)
            p.setOpacity(chevron_a)
            path = QPainterPath()
            s = r * 0.42
            path.moveTo(self.CX - s * 0.5, self.CY - s)
            path.lineTo(self.CX + s * 0.7, self.CY)
            path.lineTo(self.CX - s * 0.5, self.CY + s)
            path.closeSubpath()
            p.fillPath(path, QColor(Mocha.crust))
        p.restore()

    def _draw_confirm_pulse(self, p, t):
        if t <= 0:
            return
        r = self.R_HUB + _sp_lerp(0, 26, t)
        alpha = _sp_lerp(0.5, 0.0, t)
        p.save()
        c = QColor(Mocha.lavender)
        c.setAlphaF(_sp_clamp(alpha))
        p.setPen(QPen(c, 1.6))
        p.setBrush(Qt.BrushStyle.NoBrush)
        p.drawEllipse(QPointF(self.CX, self.CY), r, r)
        p.restore()

    def _draw_title_partial(self, p, progress):
        chars = [('A', _SP_TEXT), ('u', _SP_TEXT), ('t', _SP_TEXT), ('o', _SP_TEXT),
                  ('n', _SP_TEXT), ('i', _SP_TEXT), ('a', _SP_MAUVE), ('X', _SP_LAVENDER)]
        n = math.ceil(len(chars) * _sp_clamp(progress))
        font = QFont('Segoe UI', 27, QFont.Weight.Bold)
        p.setFont(font)
        fm = QFontMetrics(font)
        tw = sum(fm.horizontalAdvance(c) for c, _ in chars)
        x = self.CX - tw // 2
        ty = self.CY + self.R_OUT + 44
        for i in range(n):
            ch, col = chars[i]
            p.setPen(col)
            p.drawText(QPoint(int(x), ty), ch)
            x += fm.horizontalAdvance(ch)

    def _draw_subtitle(self, p, alpha, ls):
        if alpha <= 0:
            return
        label = "From IngeniaX"
        font = QFont('Segoe UI', 9)
        font.setLetterSpacing(QFont.SpacingType.AbsoluteSpacing, ls)
        p.setFont(font)
        fm = QFontMetrics(font)
        p.save()
        p.setOpacity(_sp_clamp(alpha))
        tx = self.CX - fm.horizontalAdvance(label) // 2
        ty = self.CY + self.R_OUT + 76
        p.setPen(_SP_COMMENT)
        p.drawText(QPoint(int(tx), ty), label)
        p.setPen(QPen(_SP_BORDER, 1.0))
        half = fm.horizontalAdvance(label) // 2
        p.drawLine(self.CX - half - 32, ty + 11, self.CX - half - 6, ty + 11)
        p.drawLine(self.CX + half + 6, ty + 11, self.CX + half + 32, ty + 11)
        p.restore()

    def _draw_scan(self, p, t):
        angle_deg = _sp_lerp(-90, 270, t)
        cx, cy = self.CX, self.CY
        r = self.R_OUT - 6
        p.save()
        clip = QPainterPath()
        clip.addEllipse(float(cx - r), float(cy - r), float(r * 2), float(r * 2))
        p.setClipPath(clip)
        trail = QPainterPath()
        trail.moveTo(float(cx), float(cy))
        trail.arcTo(float(cx - r), float(cy - r), float(r * 2), float(r * 2), angle_deg - 58, 58)
        trail.closeSubpath()
        tc = QColor(Mocha.lavender)
        tc.setAlphaF(0.20)
        p.fillPath(trail, tc)
        ex = cx + r * math.cos(math.radians(-angle_deg + 90))
        ey = cy + r * math.sin(math.radians(-angle_deg + 90))
        pen = QPen(QColor(Mocha.lavender), 1.6)
        pen.setCapStyle(Qt.PenCapStyle.RoundCap)
        p.setPen(pen)
        p.drawLine(QPoint(cx, cy), QPoint(int(ex), int(ey)))
        p.restore()

    def _draw_pulse(self, p, radius, alpha):
        if alpha <= 0:
            return
        p.save()
        c = QColor(Mocha.lavender)
        c.setAlphaF(_sp_clamp(alpha))
        p.setPen(QPen(c, 1.6))
        p.setBrush(Qt.BrushStyle.NoBrush)
        p.drawEllipse(QPointF(self.CX, self.CY), radius, radius)
        p.restore()


# ---------------------------------------------------------------------------
# Palette Darcula (couleurs officielles du thème par défaut de PyCharm/IntelliJ)
# — dédiée à l'éditeur de script Task (TaskScriptEditor) uniquement : le reste
# de l'app garde Mocha. Fond SOMBRE (jamais de fond clair/lumineux pour du
# code -- ça fatigue les yeux et casse le contraste des couleurs syntaxiques,
# qui sont calibrées pour un fond sombre).
# ---------------------------------------------------------------------------
class DarculaTheme:
    # --- Couleurs officielles Darcula (PyCharm/IntelliJ) ---
    fond = "#2B2B2B"                  # background éditeur
    fond_ligne_courante = "#323232"   # current line
    selection = "#214283"             # sélection (bleu Darcula)
    texte = "#A9B7C6"                 # foreground par défaut
    commentaire = "#808080"           # comment (gris)
    cyan = "#51B6C3"
    vert = "#6A8759"                  # string
    orange = "#CC7832"                # keyword
    rose = "#DB797C"                  # magenta/rose Darcula
    violet = "#9876AA"                # paramètres/annotations
    bleu = "#6897BB"                  # nombres
    # Bleu plus clair/désaturé que "bleu" (nombres) -- dédié aux appels de
    # fonction (retour utilisateur : "les fonction nont pas de
    # coloration a eux", distinct des méthodes en jaune ci-dessous).
    # Choisi proche de la palette Darcula existante plutôt qu'une teinte
    # saturée qui jurerait avec le reste (cf. cyan/bleu déjà en place).
    bleu_clair = "#8CC4E8"
    rouge = "#BC3F3C"
    jaune = "#FFC66D"                 # noms de fonction/méthode déclarée
    bordure = "#181818"               # plus sombre que le fond, pour délimiter

    # --- Couleurs syntaxiques (mapping standard PyCharm) ---
    mot_cle = orange             # def/if/return/...
    chaine = vert                 # chaînes de caractères
    nombre = bleu                 # nombres
    methode = jaune            # appel de méthode après un point
    # Nom de fonction appelée SANS point avant (ex: print(...),
    # maFonction(...)) -- couleur distincte des méthodes, cf. bleu_clair
    # ci-dessus.
    fonction = bleu_clair
    # Nom de composant importé reconnu (variable connue du Task) -- violet
    # (décision explicite utilisateur, remplace l'ancien cyan/"bleu ciel"),
    # pour le distinguer clairement des méthodes (jaune) et identifiants.
    composant_connu = violet
    # Nom de ServiceAPI importé reconnu (ex: "Word" dans Word.instance()) --
    # cyan, distinct du violet des composants pour bien séparer visuellement
    # les deux catégories de variables connues (demande explicite utilisateur).
    service_api_connu = cyan


RADIUS = 6  # rayon de bordure standard (dans la fourchette 5-8px imposée)


