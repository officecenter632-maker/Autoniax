        # PATCH (Patch 4.3 -- onglet Profils Cloud) : bloc "Envoyer un
        # profil" déplacé depuis MiseAJourStockageScreen vers
        # ProfilsCloudScreen -- demande_liste_profils_locaux/demande_
        # envoi_profil pointent maintenant vers profils_cloud_screen
        # (au lieu de stockage_screen), même logique de résolution
        # locale que l'ancien câblage (lecture de charger_registre_
        # profils(), cet écran ne connaît toujours ni ce registre ni
        # DOSSIER_RACINE_PROFILS).
        #
        # `meta` (nouveau, Patch 4.3) : construit ICI à partir de
        # obtenir_config_profil(nom_profil) -- {"proxy_configure":
        # bool(config["proxy"]), "pays": config["pays"], "date_envoi_
        # iso": datetime.now().isoformat()} -- puis transmis tel quel à
        # ClientServeurT.envoyer_profil, qui le fait écrire par le
        # serveurT dans Profils/<nom>.meta.json en plus du zip
        # (cf. serveur.py, envoyer_profil_fin). Le pilote est le seul
        # endroit qui connaît à la fois le nom du profil ET son
        # profils_config.json local -- c'est pourquoi ce dict est
        # construit ici plutôt que dans ProfilsCloudScreen (qui ignore
        # tout du registre local des profils, cf. séparation de
        # responsabilités déjà en place pour charger_registre_profils
        # ci-dessus) ou dans ClientServeurT (aucune logique métier
        # AutoniaX ne doit y vivre, même principe que côté serveur.py).
        def _sur_demande_envoi_profil(nom_profil: str):
            chemin = charger_registre_profils().get(nom_profil)
            if chemin is None:
                reseau_screen.profils_screen.sur_resultat_envoi_profil(
                    False, nom_profil, "Profil introuvable (a-t-il été supprimé ou renommé ?)."
                )
                return
            config_profil = obtenir_config_profil(nom_profil)
            # PATCH ("ip", demande explicite utilisateur : "sa naffihce
            # pas les adresse ip, sa doit aussi affihcier") -- ajoutée au
            # meta envoyé au serveurT au même titre que pays/proxy_
            # configure, afin que ProfilsCloudScreen puisse l'afficher
            # sans logique métier supplémentaire côté serveur (cf.
            # serveur.py envoyer_profil_fin, qui stocke "meta" tel quel).
            meta = {
                "proxy_configure": bool(config_profil.get("proxy")),
                # CORRECTIF (retour utilisateur explicite : "pourquoi le
                # sAutoniax pour démarrer un profil n'active pas le proxy
                # s'il y en a") -- jusqu'ici, seul un booléen d'affichage
                # ("proxy_configure") était envoyé au cloud, jamais le
                # proxy réel ({"protocole","host","port","user","password"}).
                # sAutoniax n'a donc AUCUN moyen de connaître le proxy d'un
                # profil qu'il télécharge : son propre profils_config.json
                # local (Kaggle/Colab, machine jetable) n'est jamais
                # synchronisé avec celui de ce poste, et n'a par
                # construction aucune raison de l'être. "proxy" (le dict
                # complet, ou None) est maintenant inclus tel quel --
                # _sautoniax_assurer_profil_local (cf. son propre
                # correctif) l'utilise pour écrire ce profil dans SON
                # propre registre local au moment du téléchargement, une
                # fois pour toutes, sans jamais dépendre d'un mAutoniax
                # ouvert au moment du démarrage.
                "proxy": config_profil.get("proxy"),
                "pays": config_profil.get("pays"),
                "ip": config_profil.get("ip"),
                # PATCH (colonne "Type" de ProfilsCloudScreen, demande
                # explicite utilisateur : "affiche le type de navigateur
                # utilisé, camoufox, ou chrom") -- ajouté au meta envoyé
                # au serveurT au même titre que pays/ip/proxy_configure,
                # afin que ProfilsCloudScreen puisse l'afficher sans
                # logique métier supplémentaire côté serveur (cf.
                # serveur.py envoyer_profil_fin, qui stocke "meta" tel
                # quel).
                "type_instance": config_profil.get("type_instance"),
                "date_envoi_iso": datetime.now().isoformat(),
            }
            self.client_serveur_t.envoyer_profil(nom_profil, chemin, meta)

        reseau_screen.demande_liste_profils_locaux.connect(
            lambda: reseau_screen.profils_screen.definir_profils_disponibles(
                sorted(charger_registre_profils().keys())
            )
        )
        # PATCH (onglet "Profils Local", demande explicite utilisateur :
        # "aussi les infos par profil (proxy, pays) comme la table Cloud
        # actuelle") -- construit {nom: {"proxy_configure", "pays"}} à
        # partir du MÊME registre local (obtenir_config_profil) que
        # `meta` ci-dessus pour l'envoi, mais pour TOUS les profils
        # locaux d'un coup (affichage de la table, pas juste celui en
        # cours d'envoi) -- aucun appel réseau, lecture disque directe.
        #
        # PATCH (colonne "Badges" -- demande explicite utilisateur :
        # "youtube, tiktok, ia ...", confirmée "idit tout" -> les 5
        # badges existants, mêmes que sur les cartes de
        # ProfilsInstancesScreen) -- "youtube"/"tiktok"/"ia"/"favori"/
        # "test" ajoutés au dict par profil, MÊME registre
        # (obtenir_config_profil), un seul appel par profil désormais
        # (au lieu de deux) puisque proxy/pays/tous les badges en sont
        # issus.
        # PATCH ("taille", demande explicite utilisateur : "affihcer
        # aussi la taille en mo des profils dans les deux table", puis
        # "sa fait planter lapp" -- calculer _calculer_taille_dossier_
        # octets ICI, pour TOUS les profils, AVANT même d'émettre
        # definir_infos_profils_locaux, bloquait le thread GUI le temps
        # de tout parcourir : un dossier volumineux ou beaucoup de
        # profils suffisait à geler l'appli plusieurs secondes) -- la
        # taille n'est donc PLUS calculée ici. ProfilsLocalScreen la
        # calcule désormais lui-même, profil par profil, sur un QThread
        # dédié (cf. TailleDossierWorker, ProfilsLocalScreen._demander_
        # taille/_sur_taille_recue) : chaque ligne affiche "?" puis se
        # met à jour dès que SA taille est prête, sans attendre les
        # autres (demande explicite utilisateur : "sa doit mettre
        # progressivement a jour la valeur des tailles, pas attendre le
        # compte complet avant dactualiser").
        def _construire_infos_profils_locaux() -> dict:
            resultat = {}
            for nom in charger_registre_profils().keys():
                config = obtenir_config_profil(nom)
                resultat[nom] = {
                    "proxy_configure": bool(config.get("proxy")),
                    "pays": config.get("pays"),
                    # PATCH ("ip", demande explicite utilisateur : "sa
                    # naffihce pas les adresse ip") -- même registre
                    # (obtenir_config_profil), déjà lu pour proxy/pays
                    # juste au-dessus, aucun appel supplémentaire.
                    "ip": config.get("ip"),
                    "youtube": bool(config.get("youtube")),
                    "tiktok": bool(config.get("tiktok")),
                    "ia": bool(config.get("ia")),
                    "favori": bool(config.get("favori")),
                    "test": bool(config.get("test")),
                }
            return resultat

        reseau_screen.demande_liste_profils_locaux.connect(
            lambda: reseau_screen.profils_screen.definir_infos_profils_locaux(
                _construire_infos_profils_locaux()
            )
        )
        reseau_screen.demande_envoi_profil.connect(_sur_demande_envoi_profil)
        self.client_serveur_t.envoi_profil_resultat.connect(
            reseau_screen.profils_screen.sur_resultat_envoi_profil
        )
        # PATCH A -- confirmation centrale en plus du label local.
        self.client_serveur_t.envoi_profil_resultat.connect(
            lambda ok, nom_profil, message: self._afficher_message_statut_reseau(
                ok, f"Profil '{nom_profil}' envoyé avec succès." if ok else f"Échec pour '{nom_profil}' : {message}",
            )
        )
        self.client_serveur_t.envoi_profil_progression.connect(
            reseau_screen.profils_screen.sur_progression_envoi_profil
        )
        # PATCH (Patch 4.3) : téléchargement + parsing d'un <nom>.meta.json
        # précis (cf. ProfilsCloudScreen.demande_telechargement_meta),
        # pour peupler les badges proxy/pays de la table.
        #
        # IMPORTANT -- ClientServeurT._telecharger_fichier repose sur UNE
        # SEULE Future partagée (_future_ack_telechargement, même
        # contrainte que _future_ack_profil pour l'upload) : un second
        # appel à telecharger_fichier() lancé avant que le précédent ne
        # soit terminé casserait la corrélation chunk/accusé des DEUX
        # téléchargements. Or sur_resultat_liste_stockage peut émettre
        # demande_telechargement_meta plusieurs fois d'affilée (un par
        # profil sans meta encore en cache) -- une file d'attente FIFO
        # locale sérialise donc ces téléchargements, un seul en vol à la
        # fois, plutôt que de les laisser partir en parallèle.
        self._file_attente_meta: list[str] = []
        self._telechargement_meta_en_cours = False

        def _lancer_prochain_telechargement_meta():
            if self._telechargement_meta_en_cours or not self._file_attente_meta:
                return
            cle = self._file_attente_meta.pop(0)
            self._telechargement_meta_en_cours = True
            chemin_tmp = Path(tempfile.gettempdir()) / f"autoniax_meta_{uuid.uuid4().hex}.json"

            def _sur_resultat(ok: bool, cle_recue: str, message: str):
                if cle_recue != cle:
                    return
                self.client_serveur_t.telechargement_fichier_resultat.disconnect(_sur_resultat)
                meta = None
                if ok:
                    try:
                        meta = json.loads(chemin_tmp.read_text(encoding="utf-8"))
                        if not isinstance(meta, dict):
                            meta = None
                    except (OSError, ValueError, UnicodeDecodeError) as exc:
                        log_reseau_t.warning(f"[Profils Cloud] meta.json illisible pour '{cle}' : {exc!r}")
                    finally:
                        chemin_tmp.unlink(missing_ok=True)
                else:
                    log_reseau_t.debug(f"[Profils Cloud] échec téléchargement '{cle}' : {message}")
                reseau_screen.profils_screen.sur_meta_profil_recu(cle, meta)
                self._telechargement_meta_en_cours = False
                _lancer_prochain_telechargement_meta()

            self.client_serveur_t.telechargement_fichier_resultat.connect(_sur_resultat)
            self.client_serveur_t.telecharger_fichier(cle, str(chemin_tmp))

        def _sur_demande_telechargement_meta(cle: str):
            self._file_attente_meta.append(cle)
            _lancer_prochain_telechargement_meta()

        reseau_screen.demande_telechargement_meta.connect(_sur_demande_telechargement_meta)

        # PATCH (bouton "Télécharger en local" de l'onglet "Transfert de
        # profils", demande explicite utilisateur) -- télécharge le
        # "Profils/<nom>.zip" du profil cloud depuis B2 (même protocole
        # générique telecharger_fichier que _lancer_prochain_
        # telechargement_meta juste au-dessus), puis le dézippe dans le
        # dossier profil local (creer_ou_obtenir_profil), en ÉCRASANT le
        # contenu existant (convenu explicitement avec l'utilisateur --
        # même comportement que l'envoi d'un profil local vers le cloud).
        # Aucun nouveau message serveur : "vers où" n'a pas de sens ici
        # (toujours le disque du pilote lui-même), donc pas d'aller-
        # retour ClientServeurT au-delà du telecharger_fichier générique
        # déjà utilisé pour le .meta.json. File FIFO locale, un seul
        # téléchargement en vol à la fois, même prudence que _file_
        # attente_meta juste au-dessus.
        self._file_attente_telechargement_local: list[str] = []
        self._telechargement_local_en_cours_mw = False

        def _lancer_prochain_telechargement_local():
            if self._telechargement_local_en_cours_mw or not self._file_attente_telechargement_local:
                return
            nom_profil = self._file_attente_telechargement_local.pop(0)
            self._telechargement_local_en_cours_mw = True
            cle_zip = f"Profils/{nom_profil}.zip"
            chemin_zip_tmp = Path(tempfile.gettempdir()) / f"autoniax_profil_local_{uuid.uuid4().hex}.zip"

            def _sur_progression(cle_recue: str, pourcentage: int):
                if cle_recue != cle_zip:
                    return
                reseau_screen.profils_screen.sur_progression_telechargement_local_profil(
                    nom_profil, pourcentage
                )

            def _terminer(ok: bool, message: str):
                self.client_serveur_t.telechargement_fichier_progression.disconnect(_sur_progression)
                self._telechargement_local_en_cours_mw = False
                reseau_screen.profils_screen.sur_resultat_telechargement_local_profil(nom_profil, ok, message)
                _lancer_prochain_telechargement_local()

            def _sur_resultat(ok: bool, cle_recue: str, message: str):
                if cle_recue != cle_zip:
                    return
                self.client_serveur_t.telechargement_fichier_resultat.disconnect(_sur_resultat)
                if not ok:
                    chemin_zip_tmp.unlink(missing_ok=True)
                    _terminer(False, message)
                    return
                # Dézippage + écrasement, même patron que _lancer_prochain_
                # telechargement_batch_traite (rmtree puis recopie par-
                # dessus) -- ici directement dans le dossier du profil
                # obtenu via creer_ou_obtenir_profil, qui le crée déjà si
                # besoin (aucun profil local homonyme préexistant n'est un
                # cas d'erreur, cf. convention "écraser directement").
                dossier_extrait_tmp = Path(tempfile.gettempdir()) / f"autoniax_profil_local_extrait_{uuid.uuid4().hex}"
                try:
                    _, chemin_profil = creer_ou_obtenir_profil(nom_profil)
                    dossier_profil = Path(chemin_profil)
                    shutil.unpack_archive(str(chemin_zip_tmp), str(dossier_extrait_tmp), "zip")
                    if dossier_profil.exists():
                        shutil.rmtree(dossier_profil)
                    dossier_profil.mkdir(parents=True, exist_ok=True)
                    for element in dossier_extrait_tmp.iterdir():
                        destination = dossier_profil / element.name
                        if element.is_dir():
                            shutil.copytree(element, destination)
                        else:
                            shutil.copy2(element, destination)
                    diag_verifier_profil_extrait(dossier_profil, nom_profil, "local")
                    _terminer(True, "")
                except Exception as e:
                    _terminer(False, f"Échec de l'extraction/écrasement local : {e!r}")
                finally:
                    chemin_zip_tmp.unlink(missing_ok=True)
                    shutil.rmtree(dossier_extrait_tmp, ignore_errors=True)

            self.client_serveur_t.telechargement_fichier_progression.connect(_sur_progression)
            self.client_serveur_t.telechargement_fichier_resultat.connect(_sur_resultat)
            self.client_serveur_t.telecharger_fichier(cle_zip, str(chemin_zip_tmp))

        def _sur_demande_telechargement_local_profil(nom_profil: str):
            self._file_attente_telechargement_local.append(nom_profil)
            _lancer_prochain_telechargement_local()

        reseau_screen.demande_telechargement_local_profil.connect(_sur_demande_telechargement_local_profil)

        # PATCH (Patch 4.2) : executants_detail_change n'était pas encore
        # câblé -- table détaillée de l'onglet Instances (nom, instance_id,
        # statut) + actions Kill / Mettre à jour service API par ligne.
        # Même signal réutilisé pour alimenter la liste de sAutoniax
        # disponibles du dialogue d'envoi (Patch 4.4.a, cf. ProjetBatchScreen.
        # definir_executants_disponibles) et de la table "Projets Distribués"
        # (Patch 4.4.b, résolution id_executant -> nom, cf. ProjetsDistribuesScreen.
        # definir_executants_connus) -- une seule source de vérité pour ces
        # écrans, aucune requête réseau supplémentaire.
        self.client_serveur_t.executants_detail_change.connect(instances_screen.sur_executants_detail_change)
        self.client_serveur_t.executants_detail_change.connect(
            lambda executants: dashboard_screen.projets_batch_screen.definir_executants_disponibles(
                {e.get("id", ""): e.get("nom") or e.get("id", "") for e in executants if e.get("id")}
            )
        )
        self.client_serveur_t.executants_detail_change.connect(
            reseau_screen.projets_distribues_screen.definir_executants_connus
        )
        # PATCH (section "Envoyer vers un sAutoniax" de ProfilsCloudScreen)
        # -- même source unique executants_detail_change que les 3 écrans
        # ci-dessus, reformatée en {id_executant: nom} (même format que
        # definir_executants_disponibles) pour peupler la combo cible.
        self.client_serveur_t.executants_detail_change.connect(
            lambda executants: reseau_screen.profils_screen.definir_sautoniax_disponibles(
                {e.get("id", ""): e.get("nom") or e.get("id", "") for e in executants if e.get("id")}
            )
        )
        # PATCH (Profils Kaggle, phase 3) -- reglages + controleur reseau. Les flux A (envoi) et B
        # (telechargement) sont branches.
        reseau_screen.profils_screen.definir_reglages_kaggle(self.reglages)
        self.controleur_kaggle = ControleurKaggle(
            self.client_serveur_t, reseau_screen.profils_screen.kaggle_screen, parent=self)
        self.client_serveur_t.executants_detail_change.connect(
            lambda executants: self.controleur_kaggle.sur_executants_connectes(
                {e.get("id", ""): e.get("nom") or e.get("id", "") for e in executants if e.get("id")}))
        # PATCH (sélecteur groupé Local/Réseau de TestComposantScreen,
        # cf. ApplicationsScreen.definir_client_serveur_t/definir_
        # executants_reseau_connus) -- même source unique executants_
        # detail_change, même reformatage {id_executant: nom} que les
        # écrans ci-dessus. definir_client_serveur_t appelée UNE FOIS ici
        # (self.client_serveur_t ne change jamais après sa construction,
        # contrairement aux exécutants connus qui varient en continu) --
        # applications_screen la propage elle-même à chaque nouvel onglet
        # Test de composant créé (cf. ouvrir_test_composant), donc aucun
        # câblage supplémentaire nécessaire ici pour les futurs onglets.
        applications_screen.definir_client_serveur_t(self.client_serveur_t)
        self.client_serveur_t.executants_detail_change.connect(
            lambda executants: applications_screen.definir_executants_reseau_connus(
                {e.get("id", ""): e.get("nom") or e.get("id", "") for e in executants if e.get("id")}
            )
        )
        # demande_liste_sautoniax_disponibles n'a pas besoin de câblage
        # séparé : executants_detail_change est déjà émis en continu par
        # le serveur (cf. docstring ProfilsCloudScreen ligne ~11933),
        # donc la combo se peuple automatiquement dès la première mise à
        # jour sans requête explicite à déclencher ici.
        reseau_screen.demande_envoi_profil_vers_sautoniax.connect(
            self.client_serveur_t.demander_telecharger_profil_vers_sautoniax
        )
        self.client_serveur_t.telecharger_profil_vers_sautoniax_resultat_recu.connect(
            reseau_screen.profils_screen.sur_resultat_envoi_vers_sautoniax
        )
        # PATCH -- même signal, deuxième abonné : sans ce câblage, la
        # barre de progression par ligne de InstancesConnecteesScreen
        # (cf. self._telechargements_en_cours, alimentée par le câblage
        # progression_recu ci-dessous) ne serait jamais nettoyée à la fin
        # du téléchargement -- elle resterait affichée figée à son
        # dernier pourcentage sur une ligne où plus rien ne se télécharge
        # réellement (cf. docstring sur_resultat_telechargement_profil).
        self.client_serveur_t.telecharger_profil_vers_sautoniax_resultat_recu.connect(
            instances_screen.sur_resultat_telechargement_profil
        )
        # PATCH -- sans ce câblage, un ack d'échec immédiat (ex. sAutoniax
        # déconnecté au moment de la demande, cf. serveur.py "introuvable/
        # déconnecté") n'est écouté nulle part côté ProfilsCloudScreen : la
        # file d'envoi resterait bloquée indéfiniment sur ce profil, en
        # attente d'un résultat final qui ne viendra jamais puisque
        # l'exécutant n'a jamais reçu la demande. Un ack ok=True n'a rien à
        # faire ici (le vrai résultat suivra via le signal ci-dessus).
        self.client_serveur_t.demander_telecharger_profil_vers_sautoniax_resultat.connect(
            lambda ok, id_executant, nom_profil, erreur: (
                reseau_screen.profils_screen.sur_resultat_envoi_vers_sautoniax(id_executant, nom_profil, ok, erreur)
                if not ok else None
            )
        )
        self.client_serveur_t.telecharger_profil_vers_sautoniax_progression_recu.connect(
            instances_screen.sur_progression_telechargement_profil
        )
        # PATCH (demande explicite utilisateur : progression visible à la
        # fois dans Profils Cloud -- globale -- et Instances -- détail
        # par sAutoniax) -- même signal, troisième abonné : sans ce
        # câblage, la barre de ProfilsCloudScreen restait figée par
        # palier de 100 points (cf. _envoyer_prochain_profil_sautoniax)
        # jusqu'au résultat final de CHAQUE profil, au lieu d'avancer en
