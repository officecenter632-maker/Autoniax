        self._icone_deployee = qta.icon("mdi6.chevron-left", color=Mocha.subtext0)
        self._icone_repliee = qta.icon("mdi6.chevron-right", color=Mocha.subtext0)
        self.bouton_replier = QToolButton(header)
        self.bouton_replier.setObjectName("APIFeaturesMenuButton")
        self.bouton_replier.setIcon(self._icone_deployee)
        self.bouton_replier.setIconSize(QSize(18, 18))
        self.bouton_replier.setCursor(Qt.PointingHandCursor)
        self.bouton_replier.setCheckable(True)
        self.bouton_replier.setToolTip("Replier le panneau des composants importés")
        self.bouton_replier.toggled.connect(self._basculer_replie)
