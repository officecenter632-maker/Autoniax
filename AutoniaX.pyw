        # Même classe NotebookManagerScreen qu'avant, inchangée à part
        # son nouveau dépôt ENTRANT de fichier (cf. sa docstring).
        self.serveurt_manager_screen = ServeurTManagerScreen(self.sous_onglets)
        self.sous_onglets.addTab(self.serveurt_manager_screen, "ServeurT Manager")
        self.sautoniax_manager_screen = SAutoniaxManagerScreen(self.sous_onglets)
        self.sous_onglets.addTab(self.sautoniax_manager_screen, "sAutoniax Manager")

        # PATCH (notebook de test fusionnant ServeurT + sAutoniax en une
        # seule session Kaggle/Colab, demande explicite utilisateur :
        # "je veux juste un seul [notebook], cest pour les test") --
        # troisième et dernier sous-onglet, même patron exact que les
        # deux ci-dessus (cf. SAutoniaxAvecServeurManagerScreen).
        self.sautoniax_avec_serveur_manager_screen = SAutoniaxAvecServeurManagerScreen(self.sous_onglets)
        self.sous_onglets.addTab(self.sautoniax_avec_serveur_manager_screen, "sAutoniax + ServeurT (combiné)")

    # ------------------------------------------------------------------
    # Lecture/écriture disque de serveur.py
    # ------------------------------------------------------------------
    def _chemin_fichier_principal(self) -> Path:
        return self.dossier / self.NOM_FICHIER_PRINCIPAL

    def _chemin_fichier_requirements(self) -> Path:
        return self.dossier / self.NOM_FICHIER_REQUIREMENTS

    def _lire_fichier_principal(self) -> str:
        chemin = self._chemin_fichier_principal()
        if chemin.exists():
            try:
                return chemin.read_text(encoding="utf-8")
            except OSError:
                return ""
        return ""

    def _lire_fichier_requirements(self) -> str:
        """Contenu actuel de requirements.txt, ou le pré-remplissage par
        défaut (REQUIREMENTS_PAR_DEFAUT) si le fichier n'existe pas
        encore sur disque -- jamais appelé une fois le champ déjà
        construit (cf. _sur_requirements_modifie, seule source de vérité
        après la construction initiale)."""
        chemin = self._chemin_fichier_requirements()
        if chemin.exists():
            try:
                return chemin.read_text(encoding="utf-8")
            except OSError:
                return self.REQUIREMENTS_PAR_DEFAUT
        return self.REQUIREMENTS_PAR_DEFAUT

    def _sur_code_modifie(self, _cellule_id: str):
        """Réécrit serveur.py sur disque à chaque frappe -- pas de JSON de
        cellules persisté, uniquement le texte brut (cf. décision
        explicite utilisateur)."""
        try:
            self._chemin_fichier_principal().write_text(
                self.widget_cellule.code_actuel(), encoding="utf-8",
            )
        except OSError as e:
            self.label_statut_push.setText(f"Échec de sauvegarde locale : {e}")

    def _sur_requirements_modifie(self):
        """Réécrit requirements.txt sur disque à chaque frappe -- même
        principe que _sur_code_modifie pour serveur.py, texte brut, pas
        de format intermédiaire."""
        try:
            self._chemin_fichier_requirements().write_text(
                self.champ_requirements.toPlainText(), encoding="utf-8",
            )
        except OSError as e:
            self.label_statut_push.setText(f"Échec de sauvegarde locale : {e}")

    def _basculer_requirements(self, deploye: bool):
        self.champ_requirements.setVisible(deploye)
        icone = "mdi6.chevron-down" if deploye else "mdi6.chevron-right"
        self.bouton_requirements.setIcon(qta.icon(icone, color=Mocha.subtext0))

    # ------------------------------------------------------------------
    # Connexion / création du dépôt GitHub
    # ------------------------------------------------------------------
    def _rafraichir_visibilite_blocs(self):
        depot_existe = bool(self.reglages.github_repo_url)
        self.bloc_connexion.setVisible(not depot_existe)
        self.bloc_depot.setVisible(depot_existe)
        if depot_existe:
            self.label_depot_url.setText(f"Dépôt : {self.reglages.github_repo_url}")

    def _creer_depot(self):
        token = self.champ_token.text().strip()
        if not token:
            self.label_statut_connexion.setText("Renseigne un token GitHub avant de continuer.")
            return

        self.bouton_creer_depot.setEnabled(False)
        self.label_statut_connexion.setText("Création du dépôt en cours…")
        QApplication.processEvents()
        try:
            infos_utilisateur = _github_recuperer_utilisateur(token)
            username = infos_utilisateur.get("login", "")
            infos_depot = _github_creer_depot(token, self.NOM_DEPOT_GITHUB, prive=True)
        except GitHubErreur as e:
            # PATCH (demande explicite utilisateur : "je veux que si il
            # y a erreur lors d'un push git ça apparaît dans le
            # terminal") -- avant ce patch, l'erreur n'existait que dans
            # le QLabel de l'écran Git, invisible si l'utilisateur ne
            # regardait pas cet onglet précis au bon moment.
            log_git.error("Échec création dépôt GitHub : %s", e)
            self.label_statut_connexion.setText(str(e))
            self.bouton_creer_depot.setEnabled(True)
            return
        finally:
            self.bouton_creer_depot.setEnabled(True)

        self.reglages.github_token = token
        self.reglages.github_username = username
        self.reglages.github_repo_url = infos_depot.get("clone_url") or infos_depot.get("html_url", "")
        self.reglages.save()

        log_git.info("Dépôt GitHub créé/connecté : %s (user=%s)", self.reglages.github_repo_url, username)
        self.label_statut_connexion.setText("")
        self._rafraichir_visibilite_blocs()

    # ------------------------------------------------------------------
    # Push (serveur.py + requirements.txt, seuls fichiers du dossier --
    # cf. docstring de classe, plus d'arborescence à cocher)
    # ------------------------------------------------------------------
    def _pousser_changements(self):
        if not self.reglages.github_repo_url or not self.reglages.github_token:
            self.label_statut_push.setText("Aucun dépôt configuré.")
            return

        self.bouton_pousser.setEnabled(False)
        self.label_statut_push.setText("Envoi vers GitHub en cours…")
        log_git.info("-> push vers %s (fichiers : %s, %s)", self.reglages.github_repo_url,
                     self.NOM_FICHIER_PRINCIPAL, self.NOM_FICHIER_REQUIREMENTS)
        QApplication.processEvents()
        try:
            _git_initialiser_et_pousser(
                dossier=self.dossier,
                fichiers_relatifs=[self.NOM_FICHIER_PRINCIPAL, self.NOM_FICHIER_REQUIREMENTS],
                depot_url=self.reglages.github_repo_url,
                token=self.reglages.github_token,
                username=self.reglages.github_username or "",
            )
        except GitHubErreur as e:
            # PATCH (demande explicite utilisateur : "je veux que si il
            # y a erreur lors d'un push git ça apparaît dans le
            # terminal") -- log.error garantit que l'échec apparaît dans
            # le fichier de log / terminal de l'app, même si l'onglet
            # Git n'est pas à l'écran au moment de l'échec (ex. push
            # tenté puis utilisateur reparti sur un autre onglet).
            log_git.error("<- échec du push vers %s : %s", self.reglages.github_repo_url, e)
            self.label_statut_push.setText(f"Échec du push : {e}")
            return
        finally:
            self.bouton_pousser.setEnabled(True)

        log_git.info("<- push réussi vers %s", self.reglages.github_repo_url)
        self.label_statut_push.setText("Changements poussés avec succès.")

    def _pousser_vers_drive(self):
        """Émet demande_envoi vers PousserDriveWorker (thread dédié, cf.
        self._thread_pousser_drive/self._worker_pousser_drive dans
        __init__) -- SANS passer par ClientServeurT ni exiger de
        connexion websocket active. Symétrique de _pousser_changements()
        ci-dessus (même patron bouton désactivé / label de statut), mais
        désormais réellement asynchrone : la lecture disque locale (rapide,
        gardée ici sur le thread GUI) est immédiate, seul l'appel réseau
        Drive (put_object -- de l'ordre de la seconde à quelques secondes
        selon la latence Google) part sur le thread worker. Le résultat
        revient plus tard via _sur_resultat_pousser_drive (cf. son
        docstring), jamais de façon synchrone ici.

        CORRECTIF (blocage UI signalé -- cf. commentaire de tête sur
        self._thread_pousser_drive dans __init__) : cette méthode
        n'appelle plus jamais GestionnaireStockageDriveDirect elle-même,
        contrairement à l'ancienne _pousser_vers_bb_direct."""
        try:
            contenu = self._chemin_fichier_principal().read_bytes()
        except OSError as e:
            self.label_statut_push.setText(f"Échec de lecture locale de {self.NOM_FICHIER_PRINCIPAL} : {e}")
            return
        self.bouton_pousser_drive.setEnabled(False)
        # AJOUT (cf. self.bouton_pousser_drive_rapide dans __init__) --
        # désactivé EN MÊME TEMPS que le bouton du bas : les deux
        # déclenchent le même envoi (même worker, même this._chemin_
        # fichier_principal), donc les deux doivent rester bloqués tant
        # qu'un envoi est en cours, quel que soit celui qui l'a lancé --
        # sans ça, l'autre bouton resterait cliquable et permettrait un
        # second demande_envoi.emit() concurrent vers le MÊME worker
        # pendant que le premier envoi tourne encore.
        self.bouton_pousser_drive_rapide.setEnabled(False)
        self.label_statut_push.setText("Envoi vers Drive en cours…")
        self._worker_pousser_drive.demande_envoi.emit(self.reglages, contenu)

    def _sur_resultat_pousser_drive(self, ok: bool, message: str):
        """Slot connecté à PousserDriveWorker.resultat_pret (cf.
        __init__) -- réactive le bouton et affiche le résultat final,
        succès ou échec confondus, une fois l'envoi Drive réellement
        terminé sur le thread worker."""
        self.bouton_pousser_drive.setEnabled(True)
        self.bouton_pousser_drive_rapide.setEnabled(True)
        if ok:
            log_git.info("<- serveur.py envoyé vers Drive (%s)", DRIVE_CLE_SCRIPT_SERVEUR)
            self.label_statut_push.setText("serveur.py envoyé vers Drive avec succès.")
        else:
            log_git.error("<- échec de l'envoi de serveur.py vers Drive : %s", message)
            self.label_statut_push.setText(f"Échec de l'envoi vers Drive : {message}")


class DialogueLogsSautoniax(DialogueAutoniaXBase):
    """PATCH C (cf. cahier des charges patchs.md, section C -- "bouton
    logs pour voir les logs de sortie de ce sAutoniax précis"). Dialogue
    simple en LECTURE SEULE des logs d'UN sAutoniax, distinct du
    mécanisme "Copier tous les logs" de ParametresScreen (cf. _copie_
    logs_en_cours dans MainWindow) qui agrège toutes les sources cochées
    dans le presse-papier -- ici on affiche directement dans un
    QTextEdit, pour UN seul sAutoniax, sans passer par le presse-papier.

    Ne fait AUCUN appel réseau lui-même : ouvert par MainWindow déjà en
    état "chargement", c'est MainWindow qui appelle demander_logs_
    executant() et pousse le résultat via definir_lignes()/definir_erreur()
    une fois reçu (connexion temporaire à logs_executant_recu, filtrée
    sur cet id_executant puis déconnectée -- même pattern que
    _lancer_prochain_telechargement_meta, cf. exploration du fichier)."""

    def __init__(self, nom_affiche: str, parent=None):
        super().__init__(f"Logs -- {nom_affiche}", parent, largeur_min=640, modal=False)
        self.setMinimumHeight(420)

        self.label_etat = QLabel(f"Récupération des logs de '{nom_affiche}'...", self.zone_contenu)
        self.label_etat.setObjectName("ReglagesLabel")
        self.ajouter_widget(self.label_etat)

        self.zone_logs = QTextEdit(self.zone_contenu)
        self.zone_logs.setObjectName("LogsTexte")
        self.zone_logs.setReadOnly(True)
        self.zone_logs.setLineWrapMode(QTextEdit.NoWrap)
        self.ajouter_widget(self.zone_logs)
        self._zone_contenu_layout.setStretch(self._zone_contenu_layout.indexOf(self.zone_logs), 1)

        ligne_boutons = QHBoxLayout()
        ligne_boutons.addStretch(1)
        bouton_fermer = _creer_bouton_dialogue("Fermer", primaire=True, parent=self.zone_contenu)
        bouton_fermer.clicked.connect(self.accept)
        ligne_boutons.addWidget(bouton_fermer)
        self.ajouter_layout(ligne_boutons)

    def definir_lignes(self, lignes: list):
        if not lignes:
            self.label_etat.setText("Aucune ligne de log pour ce sAutoniax.")
            self.zone_logs.setPlainText("")
            return
        self.label_etat.setText(f"{len(lignes)} ligne(s) de log.")
        self.zone_logs.setPlainText("\n".join(lignes))
        self.zone_logs.moveCursor(QTextCursor.End)

    def definir_erreur(self, message: str):
        self.label_etat.setText(f"Échec de la récupération des logs : {message}")


class _ItemExecutantTriable(QTreeWidgetItem):
    """PATCH C (cf. cahier des charges patchs.md, section C -- "tri par
    ordre de connectivité : du plus ancien au plus récent"). La colonne
    3 ("Connecté depuis") affiche une durée formatée et relative ("12
    min", "1 h 05") qui redevient fausse dès la seconde suivante et qui,
    de toute façon, ne trie pas correctement en tant que texte ("2 h" >
    "10 min" alphabétiquement alors que c'est l'inverse chronologiquement).
    L'ordre réel doit porter sur l'horodatage ISO 8601 brut (connecte_le,
    cf. Connexion.vers_dict côté serveur.py) stocké à part -- ISO 8601 a
    la propriété de préserver l'ordre chronologique en comparaison de
    chaînes, mais on compare ici les chaînes directement (pas de parsing
    dans __lt__, appelé potentiellement très souvent pendant un tri) par
    simplicité et parce que c'est suffisant.

    PATCH (demande explicite utilisateur : "je veux juste que tu classe
    bien les sAutniax en fonction du noms par ordre croissant de noms,
    pas par ordre de connexion") -- colonne 0 ("sAutoniax") triée
    NUMÉRIQUEMENT via _cle_tri_numerique_generique (cf. sa docstring) :
    un tri texte standard donnerait sAutoniax-1, sAutoniax-10,
    sAutoniax-11, sAutoniax-2... au lieu de l'ordre numérique attendu.
    Ce tri par nom devient désormais le tri PAR DÉFAUT de la table (cf.
    sortByColumn(0, ...) dans InstancesConnecteesScreen.__init__,
    remplaçant l'ancien défaut sur la colonne 3) -- ce défaut peut être
    remplacé à tout instant par un clic sur l'en-tête d'une autre
    colonne (comportement Qt standard, inchangé), la colonne 3 reste
    donc triable numériquement elle aussi si l'utilisateur choisit de
    revenir dessus.

    Toutes les AUTRES colonnes gardent le tri texte standard de
    QTreeWidgetItem (comportement hérité, cf. super().__lt__) -- seules
    les colonnes 0 et 3 sont spécialisées."""

    COLONNE_SAUTONIAX = 0
    COLONNE_CONNECTE_DEPUIS = 3

    def __lt__(self, autre):
        colonne = self.treeWidget().sortColumn() if self.treeWidget() else -1
        if colonne == self.COLONNE_SAUTONIAX and isinstance(autre, _ItemExecutantTriable):
            return _cle_tri_numerique_generique(self.text(self.COLONNE_SAUTONIAX)) < \
                _cle_tri_numerique_generique(autre.text(self.COLONNE_SAUTONIAX))
        if colonne == self.COLONNE_CONNECTE_DEPUIS and isinstance(autre, _ItemExecutantTriable):
            iso_self = self.data(self.COLONNE_CONNECTE_DEPUIS, Qt.UserRole) or ""
            iso_autre = autre.data(self.COLONNE_CONNECTE_DEPUIS, Qt.UserRole) or ""
            return iso_self < iso_autre
        return super().__lt__(autre)


class _ArbreSelectionPersistante(QTreeWidget):
    """PATCH (retour explicite utilisateur -- "quand je selcton un
    sauutoniax et que je clic ailleur sa le desactive ... cliquez ailleur
    en bas dans le vide, sa le desactive comme si javais selectionner un
    autre sautonix et pourtant pas") : QTreeWidget (comme toute
    QAbstractItemView) désélectionne TOUT par défaut dès qu'un clic
    gauche atterrit sur une zone vide de la vue (sous la dernière ligne,
    ou dans une colonne sans contenu) -- comportement Qt standard,
    indépendant de tout patch précédent, mais qui casse ici le panneau de
    droite (PanneauProprietesSautoniax) : un simple clic malheureux
    "à côté" fait disparaître le panneau de profils comme si on avait
    explicitement désélectionné le sAutoniax, sans aucune intention de
    l'utilisateur en ce sens.

    Corrigé en interceptant mousePressEvent : si le clic atterrit sur une
    zone vide (itemAt(pos) is None) ET qu'une sélection existe déjà, on
    avale l'event (ne PAS appeler super()) plutôt que de laisser Qt
    exécuter son clearSelection() implicite -- un clic sur une ligne
    RÉELLE, lui, continue de fonctionner normalement (délégué à
    super().mousePressEvent, chemin inchangé), tout comme le clic droit
    (customContextMenuRequested, géré séparément et jamais affecté par ce
    correctif) et la sélection multiple via Ctrl/Shift-clic sur une ligne
    (toujours un clic sur une ligne réelle, donc jamais concerné)."""

    def mousePressEvent(self, event):
        if event.button() == Qt.LeftButton and self.itemAt(event.pos()) is None:
            return
        super().mousePressEvent(event)


_SEPARATEUR_CLE_PROFIL_CLONE = "::"


def _cle_profil_clone(id_executant: str, nom_profil: str) -> str:
    """REFONTE MULTI-SAUTONIAX (correctif collision de noms -- BUG
    RAPPORTÉ : deux sAutoniax distincts peuvent chacun avoir un profil
    nommé "iaX1", "iaX2"... -- un dict keyé par nom_profil SEUL ne peut
    physiquement garder qu'une entrée par nom, donc la réponse du second
    sAutoniax interrogé écrasait silencieusement celle du premier pour
    tout nom en collision, cf. rapport utilisateur : "le panneau de
    clone n'affiche pas tout les profils" / "sautoniax 1 vient
    directement écraser").

    Identifiant UNIQUE d'un profil clone à travers tout le panneau et
    TaskConfigScreen : id_executant + nom_profil, jamais nom_profil
    seul. Utilisée comme clé de ExecutionCloneEtat.profils,
    PanneauExecutionClone._profils/_items, et transportée par tous les
    signaux Qt qui identifiaient auparavant un profil par son nom nu
    (demande_lancer_clones, demande_definir_profil_actif, demande_
    lancer_clone_profil, demande_arreter_clone_profil) -- cf. _nom_
    depuis_cle_profil_clone pour l'opération inverse (affichage
    uniquement, jamais pour ré-indexer quoi que ce soit).

    Format choisi délibérément lisible/débogable (pas un hash) : "
    {id_executant}::{nom_profil}" -- "::" n'apparaît jamais dans un
    id_executant ni un nom_profil réels (noms de fichiers/dossiers
    sAutoniax, format iaX{n} ou noms importés), donc round-trip fiable
    via _nom_depuis_cle_profil_clone/_id_executant_depuis_cle_profil_
    clone sans ambiguïté de parsing."""
    return f"{id_executant}{_SEPARATEUR_CLE_PROFIL_CLONE}{nom_profil}"


def _nom_depuis_cle_profil_clone(cle_profil: str) -> str:
    """Inverse de _cle_profil_clone -- extrait le nom_profil AFFICHABLE
    depuis une clé composite id_executant::nom_profil. Repli sur la clé
    brute telle quelle si le séparateur est absent (ne devrait pas
    arriver pour une clé produite par _cle_profil_clone, mais reste
    défensif pour tout appelant qui passerait encore un nom_profil nu
    par erreur pendant la transition)."""
    if _SEPARATEUR_CLE_PROFIL_CLONE in cle_profil:
        return cle_profil.split(_SEPARATEUR_CLE_PROFIL_CLONE, 1)[1]
    return cle_profil


def _id_executant_depuis_cle_profil_clone(cle_profil: str) -> str:
    """Inverse de _cle_profil_clone -- extrait id_executant depuis une
    clé composite. Repli sur "" si le séparateur est absent (clé brute
    passée par erreur -- id_executant alors inconnu plutôt qu'une
    valeur fausse)."""
    if _SEPARATEUR_CLE_PROFIL_CLONE in cle_profil:
        return cle_profil.split(_SEPARATEUR_CLE_PROFIL_CLONE, 1)[0]
    return ""


# PATCH (mode local dans le panneau clone -- demande explicite utilisateur :
# "je veux que tu gère le mode local, exactement comme le mode réseau, les
# profils actifs localement doivent apparaître dans le panneau de clone")
# -- cf. SPEC_mode_clone_local.md, section 2.1.
#
# Le panneau clone (PanneauExecutionClone) et ses dataclasses (CloneProfilEtat/
# ExecutionCloneEtat) sont bâtis autour de clés composites id_executant::
# nom_profil (cf. _cle_profil_clone ci-dessus) pour supporter PLUSIEURS
# sAutoniax en parallèle. Le mode local n'a qu'un seul "exécutant" implicite :
# cette machine elle-même. Plutôt que de dupliquer tout le panneau/les
# dataclasses pour un second mode d'affichage, on leur fait croire à un
# id_executant de plus, fixe et conventionnel -- ceci permet de réutiliser
# TEL QUEL tout PanneauExecutionClone, CloneProfilEtat, ExecutionCloneEtat,
# _cle_profil_clone/_nom_depuis_cle_profil_clone/_id_executant_depuis_cle_
# profil_clone, sans en modifier une seule ligne. Seule la couche de
# résolution (TaskConfigScreen) change selon task.mode_execution.
#
# Choisi en minuscules, sans espace ni "::" -- ne peut jamais entrer en
# collision avec un id_executant sAutoniax réel (ceux-ci sont générés/nommés
# côté serveurT, jamais égaux à ce littéral fixe en pratique -- et même en
# cas de collision improbable, les deux mondes ne coexistent jamais pour un
# même Task puisque task.mode_execution est soit "local" soit "reseau",
# jamais les deux à la fois pour un Task donné).
ID_EXECUTANT_LOCAL = "local"
# Libellé affiché par le panneau clone pour ID_EXECUTANT_LOCAL (colonne
# sAutoniax par ligne, sous-titre du panneau -- cf. PanneauExecutionClone.
# _nom_executant/rafraichir_liste, paramètre noms_par_id_executant).
NOM_AFFICHE_EXECUTANT_LOCAL = "Local (cette machine)"


def _cle_tri_numerique_generique(nom: str) -> tuple:
    """Clé de tri NUMÉRIQUE générique pour des noms se terminant par un
    indice (ex. "sAutoniax-1", "sAutoniax-2", ..., "sAutoniax-10") --
    contrairement à _cle_tri_numerique_profil ci-dessus (câblée
    spécifiquement sur le format "iaX{n}", sans séparateur), celle-ci
    accepte n'importe quel préfixe/séparateur avant le nombre final
    (extrait via un regex générique "un ou plusieurs chiffres en toute
    fin de chaîne"), pour rester correcte quel que soit le nom réel
    donné à un sAutoniax (renommage manuel, préfixe personnalisé...).

    Même raisonnement que _cle_tri_numerique_profil : un tri texte pur
    donnerait sAutoniax-1, sAutoniax-10, sAutoniax-11, sAutoniax-2...
    -- ici le préfixe (tout ce qui précède le nombre final) est comparé
    EN PREMIER (alphabétiquement), puis le nombre lui-même
    numériquement, pour que "sAutoniax-2" < "sAutoniax-10" tout en
    gardant des préfixes différents (ex. "sAutoniax" vs "AutreExecutant")
    correctement groupés/triés entre eux plutôt que mélangés par indice
    seul. Noms sans suffixe numérique : indice traité comme -1 (placé
    avant tout indice réel du même préfixe), triés alphabétiquement
    entre eux sinon."""
    m = re.match(r"^(.*?)(\d+)$", nom)
    if m:
        return (m.group(1), int(m.group(2)))
    return (nom, -1)


def _cle_tri_numerique_profil(nom_profil: str) -> tuple:
    """Clé de tri NUMÉRIQUE (pas alphabétique) pour les noms iaX{n} --
    PATCH (demande explicite utilisateur : "je classe numeriquement,
    actuellement c'est alphabetique") : un tri alphabétique donnerait
    iaX1, iaX10, iaX11, iaX2... -- ici on extrait l'indice réel pour
    obtenir l'ordre attendu iaX1, iaX2, iaX3...iaX10, iaX11. Les noms
    hors format iaX{n} (profils importés/renommés manuellement) passent
    dans un second groupe, triés alphabétiquement entre eux, plutôt que
    de faire planter le tri ou de les mélanger avec les indices
    numériques. Module-level (pas une méthode) : réutilisée par TOUTES
    les listes de profils de ce fichier qui trient par nom (cf.
    PanneauProprietesSautoniax._reconstruire_table ET PanneauExecution
    Clone._reconstruire_table -- même bug, deux endroits distincts).

    REFONTE MULTI-SAUTONIAX : PanneauExecutionClone trie désormais des
    CLÉS COMPOSITES (id_executant::nom_profil, cf. _cle_profil_clone),
    pas des noms nus -- le nom affichable est donc extrait via _nom_
    depuis_cle_profil_clone AVANT le regex ci-dessous, pour que le tri
    numérique continue à porter sur "iaX{n}" et non sur la clé entière
    (qui ne matcherait jamais ^iaX(\\d+)$ à cause du préfixe id_executant
    + séparateur). PanneauProprietesSautoniax (l'autre appelant, onglet
    Instances) continue de passer des noms nus -- _nom_depuis_cle_
    profil_clone est un no-op sans "::" dans la chaîne, donc son
    comportement est strictement inchangé."""
    nom_profil = _nom_depuis_cle_profil_clone(nom_profil)
    m = re.match(r"^iaX(\d+)$", nom_profil, re.IGNORECASE)
    if m:
        return (0, int(m.group(1)), nom_profil)
    return (1, 0, nom_profil)


def _demander_confirmation_regeneration_navigateur(parent, nom_profil: str):
    """Boîte de confirmation « Régénérer le navigateur » -- retourne None si
    annulé, sinon garder_donnees (bool, case « Garder les données de
    navigation », décochée par défaut)."""
    boite = QMessageBox(parent)
    boite.setIcon(QMessageBox.Warning)
    boite.setWindowTitle("Régénérer le navigateur")
    boite.setText(f"Régénérer le navigateur du profil « {nom_profil} » ?")
    boite.setInformativeText(
        "Le navigateur actuel sera arrêté puis remplacé par un navigateur neuf (nouvelle empreinte). "
        "Le proxy / l'IP du profil reste identique. Par défaut, les cookies et connexions sont supprimés."
    )
    case_garder = QCheckBox("Garder les données de navigation (cookies, connexions)", boite)
    boite.setCheckBox(case_garder)
    bouton_ok = boite.addButton("Régénérer", QMessageBox.AcceptRole)
    boite.addButton("Annuler", QMessageBox.RejectRole)
    boite.exec()
    if boite.clickedButton() is not bouton_ok:
        return None
    return case_garder.isChecked()


class PanneauProprietesSautoniax(QWidget):
    """Panneau de droite de l'onglet "Instances" (PATCH -- refonte deux
    colonnes, demande explicite utilisateur : "je veux que tu reorgnise
    de facon tres coherente, professionels"). Affiche le détail d'UN
    sAutoniax sélectionné dans la liste de gauche (cf. InstancesConnectees
    Screen) : ses profils, actifs ET inactifs (cf. demander_profils_
    sautoniax/profils_sautoniax_recu), avec pour chacun les actions
    Démarrer / Kill / Upload cloud / Télécharger du cloud, un bouton
    Rafraîchir EXPLICITE (pas de scan automatique -- demande explicite
    utilisateur : "il faut mettre un bouton de mise a jour explicite"),
    et un bouton Aperçu par profil ACTIF qui ouvre FenetreRenduTaskReseau
    (même patron EXACT que ProjetsDistribuesScreen._sur_clic_apercu_
    execution -- création paresseuse, câblage des 4 signaux réseau,
    afficher_par_dessus_tout()).

    Ce panneau ne connaît ni ClientServeurT ni le reste de l'app
    directement (même séparation de responsabilités que tout le fichier)
    -- il émet des signaux, MainWindow relaie vers ClientServeurT et lui
    reconnecte les résultats. Vide (placeholder) tant qu'aucun sAutoniax
    n'est sélectionné à gauche."""

    # --- Signaux émis vers MainWindow (résolution réseau laissée à
    # MainWindow, cf. docstring de classe) ---
    demande_rafraichir_profils = Signal(str)  # id_executant
    demande_demarrer_profil = Signal(str, str)  # id_executant, nom_profil
    demande_kill_profil = Signal(str, str)  # id_executant, nom_profil
    demande_upload_profil_cloud = Signal(str, str)  # id_executant, nom_profil
    demande_telecharger_profil_cloud = Signal(str, str)  # id_executant, nom_profil
    # PATCH (bouton "Renommer" -- demande explicite utilisateur : "on
    # puisse renommer un profil qui est sur un sautoniax (on le renomme
    # quand il est fermé, pas en cours)") : (id_executant, ancien_nom,
    # nouveau_nom).
    demande_renommer_profil_sautoniax = Signal(str, str, str)
    # PATCH (SPEC_proxy_natif_tunnel.md, section 13.6 -- toggle "Proxy
    # natif" par profil) : (id_executant, nom_profil, actif_demande).
    demande_toggle_proxy_natif = Signal(str, str, bool)
    # PATCH E.1 (même patron EXACT que ProjetsDistribuesScreen, cf.
    # docstring de classe) -- pilotage réseau du profil actif dont
    # l'aperçu est actuellement ouvert.
    demande_commande_instance_reseau = Signal(str, str, str, dict)
    demande_capture_ponctuelle_instance_reseau = Signal(str, str)  # id_executant, instance_id
    demande_taux_capture_instance_reseau = Signal(str, str, float)  # id_executant, instance_id, fps
    demande_preference_capture_reseau = Signal(str, int)
    # PATCH (demande explicite utilisateur : "je veux que desormais on
    # puisse creer un profils, donc tu vas mettre un bouton + en bas de
    # la liste des prfils sur un sautoniax et lorsque on vas clicquey
    # automatiqument sa doit creer le porfils") -- mêmes conventions que
    # ci-dessus (résolution réseau laissée à MainWindow).
    #
    # PATCH (remplacement du dialogue unitaire par une génération en
    # masse, demande explicite utilisateur : "je veux que la generation
    # se fasse en masse, tu met pluot un endorit qui accepte les chiffre
    # et un bouton de generations, la sa vas generer un nombre de
    # profils aleatoire, tu vas leur nomer : iaX1, iaX2...") -- le
    # dialogue modal unitaire (nom/type Chrome-Camoufox/proxy/test de
    # proxy) est SUPPRIMÉ (cf. section 1 de SPEC_generation_masse_
    # profils.md, "TRANCHÉ" : remplacement complet, pas un ajout à côté).
    # demande_creer_profil reste le SEUL signal de création -- réutilisé
    # tel quel, une fois PAR PROFIL du lot, par _envoyer_prochaine_
    # creation_masse ci-dessous (même protocole réseau qu'avant, juste
    # enchaîné automatiquement au lieu d'être déclenché un par un via un
    # formulaire). demande_tester_proxy disparaît (n'avait plus aucun
    # appelant possible une fois le dialogue de test retiré -- les
    # profils générés en masse n'ont jamais de proxy, cf. section 3.5 de
    # la spec : Camoufox, sans proxy, toujours).
    demande_creer_profil = Signal(str, str, str, str, dict)  # id_executant, nom_profil, type_instance, proxy_texte, contraintes
    # PATCH (demande explicite utilisateur : "je veux que tu ajoute un
    # bouton pour suprimer tout les profils") -- même convention que les
    # signaux ci-dessus (résolution réseau laissée à MainWindow). Émis
    # UNE FOIS PAR PROFIL, séquentiellement (même patron EXACT que
    # _envoyer_prochaine_creation_masse), depuis _envoyer_prochaine_
    # suppression_masse ci-dessous.
    demande_supprimer_profil = Signal(str, str)  # id_executant, nom_profil
    # AJOUT (dupliquer un profil cible) -- id_executant, nom_source, noms_cibles (list)
    demande_dupliquer_profil = Signal(str, str, list)
    # AJOUT (régénérer le navigateur) -- id_executant, nom_profil, garder_donnees, relancer
    demande_regenerer_profil = Signal(str, str, bool, bool)

    def __init__(self, parent=None):
        super().__init__(parent)
        self._id_executant_courant: Optional[str] = None
        self._nom_executant_courant: str = ""
        # AJOUT (spec A.3, signal "sAutoniax prêt") -- ids d'exécutants
        # dont le signal "prêt" a déjà été reçu au moins une fois depuis
        # le lancement de CE pilote (cf. sur_sautoniax_pret ci-dessous) --
        # jamais réinitialisé pour un id donné une fois reçu (ni ici, ni
        # dans definir_sautoniax_selectionne/sur_profils_recus) : un
        # sAutoniax ne redevient jamais "pas prêt" tant qu'il reste dans
        # cette session pilote, même si l'utilisateur change de sélection
        # à gauche puis revient dessus -- décision tranchée explicite de
        # la spec, distincte de _profils/_profils_coches qui eux sont
        # bien remis à zéro à chaque changement de sélection.
        self._sautoniax_prets: set[str] = set()
        # nom_profil -> {"nom", "actif", "instance_id"} -- dernière liste
        # reçue pour LE sAutoniax actuellement affiché (cf. sur_profils_
        # recus). Vidé/reconstruit à chaque nouvelle sélection à gauche
        # ET à chaque rafraîchissement explicite.
        self._profils: dict[str, dict] = {}
        # PATCH (demande explicite utilisateur : "on pourrait littéralement
        # cliquer plusieurs fois sur le bouton en croyant que ça ne
        # fonctionne pas") -- noms de profils pour lesquels une action
        # Démarrer/Kill vient d'être émise mais dont le résultat réel
        # n'est pas encore revenu (aller-retour réseau via le serveurT,
        # 5-13s observés pour un démarrage complet, cf. logs). Consulté
        # par _construire_widget_actions_profil pour désactiver le
        # bouton concerné le temps de l'attente, plutôt que de laisser
        # l'utilisateur re-cliquer en pensant que rien ne s'est passé.
        # Vidé par sur_resultat_demarrer_profil/sur_resultat_kill_profil
        # (succès ET échec), ET par definir_sautoniax_selectionne/
        # sur_profils_recus (changement de sélection ou nouveau scan --
        # un profil "en cours" n'a plus de sens pour un autre contexte).
        self._profils_action_en_cours: set[str] = set()
        # PATCH (SPEC_proxy_natif_tunnel.md, section 13.6 -- toggle
        # "Proxy natif" par profil) : même rôle EXACT que
        # self._profils_action_en_cours ci-dessus, mais dédié au bouton
        # proxy natif (garde séparée -- un profil peut en théorie avoir
        # une action Démarrer/Kill ET un toggle proxy natif en attente
        # simultanément, même si 13.5 l'empêche en pratique pour un
        # profil actif ; les deux boutons doivent pouvoir se désactiver
        # indépendamment). Vidé par sur_resultat_toggle_proxy_natif
        # (succès ET échec) et par definir_sautoniax_selectionne (même
        # raisonnement que _profils_action_en_cours.clear(), qui n'est
        # lui non plus vidé qu'à cet endroit -- pas dans sur_profils_
        # recus, vérifié avant d'écrire ce commentaire).
        self._profils_toggle_proxy_natif_en_cours: set[str] = set()
        # PATCH sortie de logs par profil : instance_id dont la sortie est COUPÉE (état
        # confirmé par le sAutoniax), et requêtes en vol {requete_id: (instance_id, coupee)}.
        # Clé = instance_id (pas le nom) : un redémarrage du profil revient à l'état par défaut.
        self._requetes_logs_profil: dict[str, tuple[str, bool]] = {}
        self._requetes_journal_profil: dict[str, tuple[str, int]] = {}  # requete_id -> (nom_profil, lignes)
        self._requetes_diag_demarrage: dict[str, str] = {}  # requete_id -> nom_profil (copie des logs de démarrage)
        # PATCH (bouton "Renommer" -- demande explicite utilisateur : "on
        # puisse renommer un profil qui est sur un sautoniax (on le
        # renomme quand il est fermé, pas en cours)") : même rôle EXACT
        # que self._profils_action_en_cours ci-dessus, garde séparée
        # dédiée au bouton Renommer -- vidé par sur_resultat_renommer_
        # profil_sautoniax (succès ET échec) et par definir_sautoniax_
        # selectionne, même raisonnement que les deux sets ci-dessus.
        self._profils_renommage_en_cours: set[str] = set()
        # PATCH (bouton "copier les propriétés" par profil -- demande
        # explicite utilisateur : "je veux que tu met un bouton de copie
        # de propiete sur chque profils , notemant la taille de lecran ...
        # et dautre donne que tu peu sur le profils") -- réutilise le
        # protocole "command"/"command_result" existant (cf. PATCH B.4,
        # commande_instance/envoyer_commande_instance côté ClientServeurT,
        # déjà relayé de bout en bout serveurT -> sAutoniax -> instance
        # isolée -- AUCUN nouveau message réseau nécessaire, seulement
        # l'action "get_fingerprint" déjà comprise par le serveur local
        # embarqué de CHAQUE instance, cf. _camoufox_extraire_proprietes_
        # fingerprint côté sAutoniax). requete_id -> nom_profil : plusieurs
        # demandes de copie peuvent en théorie être en vol en même temps
        # (clics rapides sur deux profils différents) -- un simple id
        # unique ne suffirait pas à les distinguer à la réponse, contrairement
        # à _requete_id_liste_onglets_reseau (un seul aperçu ouvert à la
        # fois). Entrée retirée dès la réponse reçue (ok ou erreur), cf.
        # sur_command_result_reseau.
        self._requetes_copie_proprietes: dict[str, str] = {}
        self._fenetre_rendu_reseau: Optional["FenetreRenduTaskReseau"] = None
        self._rendu_reseau_cible: Optional[tuple] = None  # (id_executant, instance_id, nom_profil)
        # PATCH (génération en masse -- remplace l'ancien dialogue
        # unitaire "+", cf. docstring des signaux demande_creer_profil
        # ci-dessus et section 3.3 de SPEC_generation_masse_profils.md) :
        # état du LOT de créations actuellement en cours d'envoi, un seul
        # lot actif à la fois (self.bouton_generer_profils désactivé
        # pendant l'attente, cf. _lancer_generation_masse). Les créations
        # sont envoyées SÉQUENTIELLEMENT (un demande_creer_profil à la
        # fois, le suivant n'est émis qu'après réception du résultat du
        # précédent) plutôt qu'en rafale -- protocole existant conçu pour
        # une création à la fois, jamais éprouvé en concurrence sur le
        # même sAutoniax, cf. décision explicite de la spec.
        #
        # _file_generation_masse : noms restant à créer, dans l'ordre --
        # le nom en tête (index 0) est celui dont la réponse est
        # actuellement attendue, retiré seulement quand sa réponse
        # arrive (cf. sur_resultat_creer_profil).
        self._file_generation_masse: list[str] = []
        # _resultats_generation_masse : nom -> (ok, message), un par nom
        # déjà traité (succès ou échec) dans le lot EN COURS -- vidé au
        # début de chaque nouveau lot, consulté par _terminer_generation_
        # masse pour le bilan final ("X créés, Y échoués").
        self._resultats_generation_masse: dict[str, tuple[bool, str]] = {}
        # id_executant ciblé par le lot en cours -- fixé à l'ouverture du
        # lot (PAS relu depuis self._id_executant_courant à chaque
        # réponse), même raisonnement que l'ancien _id_executant_
        # dialogue_creation : si l'utilisateur change de sélection à
        # gauche PENDANT qu'un lot est en cours d'envoi sur un AUTRE
        # sAutoniax, le lot doit quand même aboutir sur le bon exécutant
        # d'origine.
        self._id_executant_generation_masse: Optional[str] = None
        # Proxy FIXE pour tout profil généré en masse -- jamais de proxy
        # (décision explicite utilisateur, cf. section 3.5 de la spec :
        # "sans proxy (simple)"). Posé en constante d'instance plutôt
        # qu'en dur dans l'appel pour rester un point unique de
        # modification si ce choix change un jour.
        #
        # PATCH (demande explicite utilisateur : "on doit pouvoir choisir
        # entre generer des profils chrome ou camoufox, dans le panneau
        # de profils des sautoniax") -- l'ancien type FIXE ("camoufox",
        # retiré) est remplacé par un sélecteur Chrome/Camoufox dans l'UI
        # (self.combo_type_generation, construit plus bas) : le type
        # réellement utilisé pour un lot est lu depuis ce combo au moment
        # de _lancer_generation_masse, jamais mis en cache ici -- même
        # principe que self.spin_nombre_generation, jamais lui non plus
        # caché dans un attribut à part.
        self._proxy_generation_masse: str = ""
        # Type réellement utilisé pour le lot EN COURS d'envoi (figé au
        # clic sur "Générer", cf. _lancer_generation_masse) -- initialisé
        # ici par défense en profondeur seulement (_envoyer_prochaine_
        # creation_masse n'est en pratique jamais appelée avant un premier
        # _lancer_generation_masse, qui l'écrase toujours avant tout envoi).
        self._type_instance_generation_masse_en_cours: str = "camoufox"

        # PATCH (bouton "Supprimer tous les profils" -- demande explicite
        # utilisateur : "je veux que tu ajoute un bouton pour suprimer
        # tout les profils") -- même patron EXACT que le bloc génération
        # en masse ci-dessus : file SÉQUENTIELLE (un demande_supprimer_
        # profil à la fois, le suivant émis seulement après le résultat
        # réel du précédent, cf. _envoyer_prochaine_suppression_masse).
        self._file_suppression_masse: list[str] = []
        self._resultats_suppression_masse: dict[str, tuple[bool, str]] = {}
        self._id_executant_suppression_masse: Optional[str] = None

        # AJOUT (spec A.1, sélection multiple par case à cocher) -- noms
        # des profils actuellement cochés dans table_profils, RÉINITIALISÉ
        # (pas simplement vidé, cf. CORRECTIF ci-dessous) à chaque
        # changement de sAutoniax sélectionné (definir_sautoniax_
        # selectionne) et purgé des noms disparus à chaque nouvelle liste
        # reçue (sur_profils_recus) -- cf. leurs docstrings respectifs
        # pour le détail exact.
        #
        # CORRECTIF (retour utilisateur : "lorsque je selectionne ou
        # deselectionne avec le bouton global sa le fait bien, mais sa
        # ne met pas a jour les checkbox des profils de chaque sautoniax
        # ... actuellement sa actualise seulement pour le sautoniax qui
