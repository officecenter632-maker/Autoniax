    def envoyer_batch_vers_sautoniax(
        self, id_executant: str, id_batch_distribue: str, projets: list, profils: list,
    ) -> None:
        """PATCH E (E.4 -- "Notion de Batch"). `projets` : liste de
        tuples (id_projet_batch, chemin_racine, nom_projet) DÉJÀ RÉSOLUS
        par l'appelant, DANS L'ORDRE D'EXÉCUTION SOUHAITÉ -- même
        principe de séparation que _sur_demande_envoi_projet_sautoniax
        (MainWindow) pour l'envoi mono-projet : cette classe ne connaît
        ni Project ni ProjetBatch, seulement des chemins et des noms
        (cf. docstring de classe : "aucune logique métier" appliquée
        aussi côté client réseau, pas seulement côté serveurT). C'est
        À L'APPELANT d'écrire le project.json minimal de CHAQUE
        ProjetBatch avant d'appeler cette méthode (cf. MainWindow.
        _sur_demande_envoi_batch_sautoniax, symétrique multi-projets de
        _sur_demande_envoi_projet_sautoniax).

        DÉCISION EXPLICITE UTILISATEUR (E.4) : séquencement CÔTÉ PILOTE
        -- cette méthode ne fait qu'amorcer _sequencer_batch (coroutine
        de fond), qui envoie le premier ProjetBatch, ATTEND sa fin
        d'exécution réelle (retour_projet_execute_recu, pas seulement
        l'ack d'envoi), puis enchaîne sur le suivant, ainsi de suite --
        jamais plusieurs envois en vol à la fois pour un même batch (cf.
        E.4 : "un projet à la fois, pas en parallèle"). Aucune valeur de
        retour utile ici (contrairement à envoyer_projet_vers_sautoniax,
        qui retourne un session_id UNIQUE) : CHAQUE ProjetBatch du batch
        a son propre session_id, généré au fil du séquencement et
        communiqué au fur et à mesure via envoi_batch_projet_demarre
        (cf. docstring du signal) -- aucun identifiant unique ne
        pourrait représenter tout le batch à l'avance.

        `profils` : pool global partagé pour tout le batch (décision
        explicite utilisateur, cf. docstring de BatchDistribue -- E.7
        report la répartition individuelle à plus tard), transmis TEL
        QUEL à chaque ProjetBatch du batch, un par un."""
        if self._loop is None or not self._loop.is_running() or self._ws is None:
            self.envoi_batch_echec.emit(
                id_batch_distribue, projets[0][0] if projets else "", "Non connecté au serveurT.",
            )
            return
        asyncio.run_coroutine_threadsafe(
            self._sequencer_batch(id_executant, id_batch_distribue, list(projets), list(profils)), self._loop,
        )

    async def _sequencer_batch(
        self, id_executant: str, id_batch_distribue: str, projets: list, profils: list,
    ):
        """Coroutine de fond (cf. docstring d'envoyer_batch_vers_
        sautoniax) -- enchaîne les ProjetBatch de `projets` un par un,
        dans l'ordre, sur CET exécutant. Réutilise _envoyer_projet_vers_
        sautoniax TELLE QUELLE pour chaque ProjetBatch (jamais dupliquée
        -- même compression/chunking/gestion d'erreur que l'envoi
        mono-projet actuel, cf. ProjetsDistribuesScreen qui continue de
        recevoir envoi_projet_sautoniax_progression/_resultat
        normalement pour chacun).

        ARRÊT SUR ÉCHEC D'ENVOI (décision de conception, cf. docstring
        du signal envoi_batch_echec) : si l'envoi d'un ProjetBatch du
        batch échoue (conflit de profil E.6.2, limite d'instances E.6.3,
        perte de connexion...), le séquencement s'arrête immédiatement
        -- les ProjetBatch restants du batch ne sont PAS envoyés. Un
        échec D'EXÉCUTION (le ProjetBatch a bien tourné mais avec des
        sous-projets en échec, cf. E.3 "Échec partiel") n'arrête PAS le
        séquencement : c'est un résultat normal, le batch continue avec
        le ProjetBatch suivant -- seule la RÉCEPTION du retour
        (retour_projet_execute_recu) compte ici pour avancer, jamais son
        contenu (cf. §4.4.d, cette classe n'interprète pas les
        compteurs succès/échec, ProjetsDistribuesScreen s'en charge)."""
        nb_reussis = 0
        nb_echoues = 0
        for id_projet_batch, chemin_racine, nom_projet in projets:
            session_id = uuid.uuid4().hex[:12]
            future_fin = self._loop.create_future()
            self._future_fin_projet_par_session[session_id] = future_fin

            # Émis AVANT l'envoi réel -- ProjetsDistribuesScreen doit
            # pouvoir créer sa ligne "Envoi en cours..." pour CE
            # ProjetBatch avant même que le réseau ne réponde, même
            # philosophie que sur_envoi_demande pour l'envoi mono-projet
            # (cf. §4.4.b : "une session apparaît dès la demande").
            self.envoi_batch_projet_demarre.emit(id_executant, id_batch_distribue, session_id, id_projet_batch, nom_projet)

            resultat_future = self._loop.create_future()

            def _relayer_resultat(ok: bool, sid: str, message: str, _attendu=session_id, _cible=resultat_future):
                # Filtre par session_id -- envoi_projet_sautoniax_
                # resultat est un signal PARTAGÉ par tous les envois en
                # cours sur cette connexion pilote (mono-projet ET
                # batch confondus), pas seulement celui-ci.
                if sid == _attendu and not _cible.done():
                    _cible.set_result((ok, message))

            self.envoi_projet_sautoniax_resultat.connect(_relayer_resultat)
            try:
                await self._envoyer_projet_vers_sautoniax(
                    id_executant, nom_projet, profils, chemin_racine, session_id,
                )
                try:
                    ok_envoi, message_envoi = await asyncio.wait_for(resultat_future, timeout=60.0)
                except asyncio.TimeoutError:
                    ok_envoi, message_envoi = False, "Délai dépassé en attendant la confirmation d'envoi."
            finally:
                self.envoi_projet_sautoniax_resultat.disconnect(_relayer_resultat)

            if not ok_envoi:
                self._future_fin_projet_par_session.pop(session_id, None)
                log_reseau_t.warning(
                    f"_sequencer_batch : échec d'envoi de '{nom_projet}' (batch={id_batch_distribue}, "
                    f"session={session_id}) -- arrêt du séquencement : {message_envoi}"
                )
                self.envoi_batch_echec.emit(id_batch_distribue, id_projet_batch, message_envoi)
                return

            # Envoi réussi -- attend maintenant la fin RÉELLE de
            # l'exécution distante (cf. docstring de _future_fin_projet_
            # par_session) avant d'enchaîner sur le ProjetBatch suivant.
            # Pas de timeout ici (contrairement à resultat_future
            # ci-dessus) : un traitement à distance peut légitimement
            # prendre des heures selon le nombre de sous-projets, une
            # limite de temps fixe n'aurait aucun sens -- cf. E.2, la
            # continuité via reconnexion couvre déjà le cas d'une
            # attente très longue.
            try:
                await future_fin
                nb_reussis += 1
            except Exception:
                # Ne devrait normalement pas se produire (la future est
                # toujours résolue avec set_result, jamais set_exception,
                # cf. le bloc retour_projet_execute_fin) -- filet de
                # sécurité seulement, pour ne jamais laisser le
                # séquenceur planter silencieusement sur un cas imprévu.
                nb_echoues += 1
            finally:
                self._future_fin_projet_par_session.pop(session_id, None)

        log_reseau_t.info(
            f"_sequencer_batch : batch={id_batch_distribue} terminé ({nb_reussis} traité(s), {nb_echoues} en anomalie)"
        )
        self.envoi_batch_termine.emit(id_batch_distribue, nb_reussis, nb_echoues)

    def mettre_a_jour_service_api(self, id_executant: str, chemin_dossier_service_api: str):
        """Onglet Instances, action "Mettre à jour le dossier service
        API" -- MIGRÉ vers Drive direct (demande explicite utilisateur :
        "mAutoniax upload directement. et pour le sync, le serveur
        envoie juste un message de retélarchement au sautoniax, il le
        retélécharge eux même directement sur le cloud. plus de envoie
        autonome de fichier du serveur vers les sautoniax"). Zippe PUIS
        uploade DIRECTEMENT sur Drive (clé App/service_api.zip, partagée
        avec le Flux A "Mettre à jour" général -- point ouvert 2 de la
        spec, tranché), PUIS envoie un simple message de signal au
        serveurT qui le relaie à l'exécutant ciblé (cf.
        _mettre_a_jour_service_api). Ne nécessite plus de connexion
        serveurT pour l'upload lui-même (seul le signal léger la
        requiert), même raisonnement que le patch Drive-direct précédent
        sur telecharger_fichier -- garde uniquement sur self._loop."""
        if self._loop is None or not self._loop.is_running():
            self.mise_a_jour_service_api_resultat.emit(False, id_executant, "Non connecté au serveurT.")
            return
        asyncio.run_coroutine_threadsafe(
            self._mettre_a_jour_service_api(id_executant, chemin_dossier_service_api), self._loop,
        )

    def mettre_a_jour_project_json(self, id_executant: str, chemin_project_json: str):
        """AJOUT -- Task Editor, bouton "Mettre à jour service API +
        project.json" : miroir EXACT de mettre_a_jour_service_api
        ci-dessus, migré vers Drive direct de la même façon (clé Drive
