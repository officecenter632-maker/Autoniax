    def envoyer_notebook_distant_image(self, session_id: str, id_pilote: str, image_b64: str) -> bool:
        """PATCH (revert : image affichée dans la sortie de la cellule,
        pas le terminal séparé -- cf. Image.view()/TaskConfigScreen.sur_
        image_execution_reseau_recu). Même patron de base que envoyer_
        notebook_distant_log ci-dessus (fil de l'eau, un message par
        appel), mais transporte une image PNG encodée en base64 (cf.
        Image.view()/bgr_vers_image_b64) plutôt qu'une ligne de texte.
        Relayée TEL QUEL par le serveurT (cf. son bloc générique de
        relais notebook_distant_log/_resultat/..., type ajouté à ce même
        tuple) jusqu'au pilote ciblé.

        CORRECTIF (bug rapporté : Image.view() n'affichait jamais rien,
        sans la moindre erreur ni log) -- CONTRAIREMENT aux autres
        envoyer_* de cette classe (log/résultat, best-effort silencieux
        car un log de plus ou de moins n'est jamais critique), celle-ci
        retourne désormais un bool explicite : False si la connexion
        WebSocket n'est pas prête (self._loop/self._ws), True si le
        message a bien été programmé pour envoi. Un .view() est un appel
        UNIQUE et ponctuel dans le script utilisateur -- contrairement à
        un flux de logs continu où perdre une ligne est sans
        conséquence, perdre CETTE image en silence prive totalement
        l'utilisateur du résultat qu'il attendait, d'où la nécessité que
        l'appelant (Image.view()) puisse le détecter et lever une erreur
        explicite plutôt que de laisser croire que tout s'est bien
        passé."""
        if isinstance(image_b64, str) and image_b64.startswith(MARQUEUR_RESULTAT_LIVE):
            # AJOUT (livraison garantie) -- envoyer_resultat(...) : jamais perdu en silence, cf. _garantie_enregistrer.
            if self._loop is None or not self._loop.is_running():
                return False
            _uid_live = uuid.uuid4().hex
            _texte_live = json.dumps({
                "type": "notebook_distant_image", "session_id": session_id,
                "id_pilote": id_pilote, "image_b64": image_b64, "uid": _uid_live,
            })

            async def _envoyer_live_garanti():
                self._garantie_enregistrer(_uid_live, "notebook_distant_image", session_id, id_pilote, _texte_live, "morceaux")
                try:
                    await self._envoyer_par_morceaux(_texte_live, id_pilote)
                except Exception as _e:
                    log_reseau_t.warning(f"envoyer_resultat : envoi immédiat impossible ({_e!r}) -- conservé, renvoi automatique.")

            asyncio.run_coroutine_threadsafe(_envoyer_live_garanti(), self._loop)
            return True
        if self._loop is None or not self._loop.is_running() or self._ws is None:
            return False
        asyncio.run_coroutine_threadsafe(
            self._envoyer_par_morceaux(json.dumps({
                "type": "notebook_distant_image", "session_id": session_id,
                "id_pilote": id_pilote, "image_b64": image_b64,
            }), id_pilote), self._loop,
        )
        return True

    def envoyer_pont_reponse(self, reponse: dict) -> bool:
        """AJOUT (pont fichiers pilote <-> clone) -- côté PILOTE : réponse à une demande de fichier d'un clone
        (`reponse["id_executant"]` désigne le sAutoniax). Le serveurT la relaie telle quelle (cf. serveur.py,
        « pont_pilote_reponse »). Retourne False si l'envoi local est impossible ; le clone renvoie alors sa demande
        et le pilote répond depuis son cache (aucune opération n'est exécutée deux fois)."""
        if self._loop is None or not self._loop.is_running() or self._ws is None:
            return False
        message = dict(reponse)
        message["type"] = "pont_pilote_reponse"
        asyncio.run_coroutine_threadsafe(self._ws.send(json.dumps(message)), self._loop)
        return True

    # =====================================================================================================
    # TRANSIT DRIVE -- les deux seuls messages du protocole côté client (cf. serveur.py, GestionnaireTransit) :
    # demander un zip libre, le libérer. BLOQUANTS (attendent la réponse du serveurT) : à appeler depuis un thread
    # de travail, jamais depuis le thread Qt. Réponses reçues par _traiter_message (« transit_attribue » /
    # « transit_libere »), corrélées par « rid ».
    # =====================================================================================================
    def _transit_appeler(self, message: dict, timeout_s: float) -> dict:
        if self._loop is None or not self._loop.is_running() or self._ws is None:
            raise TransitErreur("Non connecté au serveurT : impossible de demander/libérer un zip Transit.")
        attentes = self.__dict__.setdefault("_transit_attentes", {})
        rid = uuid.uuid4().hex
        futur: "concurrent.futures.Future" = concurrent.futures.Future()
        attentes[rid] = futur
        message = dict(message, rid=rid)
        try:
            asyncio.run_coroutine_threadsafe(self._ws.send(json.dumps(message)), self._loop)
            try:
                return futur.result(timeout=timeout_s)
            except concurrent.futures.TimeoutError:
                raise TransitErreur(f"Le serveurT n'a pas répondu à « {message.get('type')} » en {timeout_s:g}s.") from None
        finally:
            attentes.pop(rid, None)

    def transit_demander_zip(self, timeout_s: float = 20.0) -> dict:
        """-> {"slot": "data7.zip", "file_id": "...", "jeton": "..."}. Lève TransitErreur si Transit est plein
        (« plein ») ou indisponible : aucun repli sur le pont."""
        reponse = self._transit_appeler({"type": "transit_demander"}, timeout_s)
        if not reponse.get("ok"):
            raise TransitErreur(reponse.get("erreur") or "Le serveurT a refusé d'attribuer un zip Transit.")
        return {"slot": reponse["slot"], "file_id": reponse["file_id"], "jeton": reponse["jeton"]}

    def transit_liberer_zip(self, slot: str, jeton: str, timeout_s: float = 20.0) -> None:
        """Libère le zip auprès du serveurT (idempotent). À appeler seulement APRÈS la lecture par le destinataire."""
        reponse = self._transit_appeler({"type": "transit_liberer", "slot": slot, "jeton": jeton}, timeout_s)
        if not reponse.get("ok"):
            raise TransitErreur(reponse.get("erreur") or f"Le serveurT a refusé de libérer {slot}.")

    # =====================================================================================================
    # LIVRAISON GARANTIE (coupures réseau) -- résultats finaux + envoyer_resultat en direct, sAutoniax -> pilote
    # -----------------------------------------------------------------------------------------------------
    # Avant : « envoie et oublie » -- un message émis pendant une coupure était perdu, le pilote attendait
    # indéfiniment (spinner bloqué) ou une donnée de campagne disparaissait sans erreur.
    # Maintenant : côté EXÉCUTANT, chaque résultat final (notebook_distant_resultat) et chaque envoyer_resultat
    # (canal notebook_distant_image + MARQUEUR_RESULTAT_LIVE) reçoit un « uid », est gardé dans _file_garantie
    # et est (re)envoyé : à chaque reconnexion, puis toutes les 20 s * nb_essais (max 120 s) tant que le pilote
    # n'a pas accusé réception (message pont_pilote_reponse portant « ack_uid », relayé par le serveurT).
    # Côté PILOTE : accuse TOUJOURS réception, mais n'applique un uid qu'UNE fois (doublons ignorés).
    # Signal de vie : l'exécutant envoie toutes les 10 s « sessions_vivantes » (sessions en cours + celles dont
    # le résultat attend encore son accusé) ; le pilote avertit après 30 s de silence, et déclare l'échec après
    # 300 s de silence, ou si le clone, joignable, ne connaît plus la session (3 signaux de suite).
    # Le silence n'est surveillé que pour un exécutant qui a déjà envoyé « sessions_vivantes » (anciens
    # sAutoniax : comportement inchangé).
    DELAI_RETRANSMISSION_GARANTIE = 20.0
    DELAI_RETRANSMISSION_GARANTIE_MAX = 120.0
    DUREE_MAX_GARANTIE = 6 * 3600.0
    MAX_ENTREES_GARANTIE = 2000
    INTERVALLE_SESSIONS_VIVANTES = 10.0
    PAS_TACHE_GARANTIE = 5.0
    DELAI_ALERTE_SILENCE_SESSION = 30.0
    DELAI_ECHEC_SILENCE_SESSION = 300.0

    def _garantie_enregistrer(self, uid: str, type_msg: str, session_id: str, id_pilote: str, texte: str, mode: str):
        """Mémorise un message à livrer (appelé par la boucle réseau, JUSTE AVANT le premier envoi)."""
        with self._verrou_garantie:
            self._file_garantie[uid] = {
                "type": type_msg, "session_id": session_id, "id_pilote": id_pilote, "texte": texte,
                "mode": mode, "t_creation": time.time(), "t_envoi": time.time(), "essais": 1,
            }
            while len(self._file_garantie) > self.MAX_ENTREES_GARANTIE:
                ancien, e = next(iter(self._file_garantie.items()))
                del self._file_garantie[ancien]
                log_reseau_t.warning(f"[GARANTIE] file pleine : message {e['type']} (session={e['session_id']}) abandonné.")

    def _garantie_acquitter(self, uid: str):
        with self._verrou_garantie:
            e = self._file_garantie.pop(uid, None)
        if e is not None:
            log_reseau_t.info(f"[GARANTIE] accusé reçu : {e['type']} (session={e['session_id']}, essais={e['essais']})")

    async def _garantie_envoyer(self, uid: str):
        """(Ré)envoie un message de la file. Une erreur d'envoi n'est pas grave : il sera rejoué."""
        with self._verrou_garantie:
            e = self._file_garantie.get(uid)
            if e is None:
                return
            e["t_envoi"] = time.time()
            e["essais"] += 1
            texte, mode, id_pilote = e["texte"], e["mode"], e["id_pilote"]
        try:
            if self._ws is None:
                return
            if mode == "morceaux":
                await self._envoyer_par_morceaux(texte, id_pilote)
            else:
                await self._ws.send(texte)
        except Exception as exc:
            log_reseau_t.warning(f"[GARANTIE] renvoi impossible pour le moment ({exc!r}) -- nouvelle tentative plus tard.")

    async def _garantie_rejouer(self):
        """Après (re)connexion : renvoie, dans l'ordre d'origine, tout ce qui n'a pas été acquitté."""
        with self._verrou_garantie:
            uids = list(self._file_garantie.keys())
        if uids:
            log_reseau_t.info(f"[GARANTIE] reconnexion : renvoi de {len(uids)} message(s) non acquitté(s).")
        for uid in uids:
            await self._garantie_envoyer(uid)

    def _sessions_a_signaler(self) -> dict:
        """{id_pilote: [session_id, ...]} : sessions en cours + sessions dont le résultat attend son accusé."""
        par_pilote: dict = {}
        for sid, pid in list(self._sessions_actives.items()):
            par_pilote.setdefault(pid, set()).add(sid)
        with self._verrou_garantie:
            for e in self._file_garantie.values():
                if e["session_id"] and e["id_pilote"]:
                    par_pilote.setdefault(e["id_pilote"], set()).add(e["session_id"])
        return {p: sorted(s) for p, s in par_pilote.items()}

    async def _tache_garantie(self):
        """Tâche de fond par connexion (annulée avec le heartbeat). Exécutant : renvois + signal de vie.
        Pilote : surveillance des sessions attendues."""
        derniere_vie = 0.0
        if self.role == "pilote":
            maintenant = time.time()
            for s in self._sessions_attendues.values():   # délai de grâce après (re)connexion du pilote
                s["t_vie"] = maintenant
                s["alerte"] = False
        try:
            while True:
                await asyncio.sleep(self.PAS_TACHE_GARANTIE)
                maintenant = time.time()
                if self.role == "executant":
                    with self._verrou_garantie:
                        items = list(self._file_garantie.items())
                    for uid, e in items:
                        if maintenant - e["t_creation"] > self.DUREE_MAX_GARANTIE:
                            self._garantie_acquitter(uid)
                            log_reseau_t.warning(f"[GARANTIE] {e['type']} (session={e['session_id']}) abandonné après {self.DUREE_MAX_GARANTIE / 3600:.0f} h sans accusé.")
                            continue
                        attente = min(self.DELAI_RETRANSMISSION_GARANTIE * e["essais"], self.DELAI_RETRANSMISSION_GARANTIE_MAX)
                        if maintenant - e["t_envoi"] >= attente:
                            await self._garantie_envoyer(uid)
                    if maintenant - derniere_vie >= self.INTERVALLE_SESSIONS_VIVANTES:
                        derniere_vie = maintenant
                        for pid, sessions in self._sessions_a_signaler().items():
                            try:
                                if self._ws is not None:
                                    await self._ws.send(json.dumps({"type": "sessions_vivantes", "id_pilote": pid, "sessions": sessions}))
                            except Exception as exc:
                                log_reseau_t.debug(f"sessions_vivantes non envoyé : {exc!r}")
                                break
                elif self.role == "pilote":
                    self._surveiller_sessions_attendues(maintenant)
        except asyncio.CancelledError:
            raise

    def _surveiller_sessions_attendues(self, maintenant: float):
        for sid, s in list(self._sessions_attendues.items()):
            if s["id_executant"] not in self._executants_vivantes:
                continue   # ancien sAutoniax : pas de signal de vie, on ne juge pas
            silence = maintenant - s["t_vie"]
            motif = None
            if silence > self.DELAI_ECHEC_SILENCE_SESSION:
                motif = (f"Aucun signe de vie du clone depuis {silence:.0f} s (connexion coupée ou clone arrêté) -- "
                         "exécution considérée comme perdue.")
            elif s["absences"] >= 3 and maintenant - s["t_envoi"] > 40.0:
                motif = "Le clone est joignable mais ne connaît plus cette exécution (redémarré, ou demande perdue)."
            if motif:
                self._sessions_attendues.pop(sid, None)
                log_reseau_t.warning(f"[VIE-SESSION] session={sid} : {motif}")
                self.notebook_distant_resultat_recu.emit(sid, s["id_executant"], False, motif, None, None, None, None)
            elif silence > self.DELAI_ALERTE_SILENCE_SESSION and not s["alerte"]:
                s["alerte"] = True
                log_reseau_t.warning(f"[VIE-SESSION] session={sid} : silence depuis {silence:.0f} s (attente de reconnexion du clone ?)")
                self.notebook_distant_log_recu.emit(
                    sid, s["id_executant"],
                    f"⚠ Aucun signe de vie du clone depuis {silence:.0f} s -- attente de sa reconnexion "
                    f"(abandon automatique après {self.DELAI_ECHEC_SILENCE_SESSION:.0f} s).")

    def _noter_vie_session(self, data: dict) -> bool:
        """Côté PILOTE : tout message d'un clone prouve qu'il est vivant. Retourne True si le message est
        « sessions_vivantes » (entièrement traité ici)."""
        if not self._sessions_attendues and data.get("type") != "sessions_vivantes":
            return False
        maintenant = time.time()
        if data.get("type") == "sessions_vivantes":
            ex = data.get("id_executant", "")
            self._executants_vivantes.add(ex)
            listees = set(data.get("sessions") or [])
            for sid, s in self._sessions_attendues.items():
                if s["id_executant"] != ex:
                    continue
                if sid in listees:
                    s["t_vie"], s["absences"], s["alerte"] = maintenant, 0, False
                else:
                    s["absences"] += 1
            return True
        sid = data.get("session_id")
        s = self._sessions_attendues.get(sid) if sid else None
        if s is not None and data.get("id_executant", s["id_executant"]) == s["id_executant"]:
            s["t_vie"], s["alerte"] = maintenant, False
        return False

    def _pilote_acquitter(self, data: dict) -> bool:
        """Côté PILOTE : accuse réception d'un message à livraison garantie (portant « uid »). Retourne True si
        c'est un DOUBLON (déjà appliqué) -- l'appelant doit alors l'ignorer."""
        uid = data.get("uid")
        if not uid:
            return False
        doublon = uid in self._uids_vus
        self._uids_vus[uid] = time.time()
        self._uids_vus.move_to_end(uid)
        while len(self._uids_vus) > 5000:
            self._uids_vus.popitem(last=False)
        ex = data.get("id_executant", "")
        if ex:
            self.envoyer_pont_reponse({"id_executant": ex, "ack_uid": uid})
        if doublon:
            log_reseau_t.info(f"[GARANTIE] doublon ignoré ({data.get('type')}, uid={uid[:8]}) -- accusé renvoyé.")
        return doublon

    # PATCH PRIORITE FIN -- le signal de fin (notebook_distant_resultat) doit passer avant tout.
    # Les gros messages sont découpés ; pendant qu'un signal de fin est en cours d'envoi,
    # l'émission des morceaux (et des captures) est GELÉE.
    TAILLE_MORCEAU_PRIORITE = 32 * 1024

    async def _envoyer_par_morceaux(self, texte: str, id_pilote: str):
        ws = self._ws
        if ws is None:
            return
        if len(texte) <= self.TAILLE_MORCEAU_PRIORITE:
            while getattr(self, "_prio_fin", 0) > 0:
                await asyncio.sleep(0.002)
            await ws.send(texte)
            return
        mid = uuid.uuid4().hex
        n = (len(texte) + self.TAILLE_MORCEAU_PRIORITE - 1) // self.TAILLE_MORCEAU_PRIORITE
        for i in range(n):
            while getattr(self, "_prio_fin", 0) > 0:   # gel : signal de fin en cours
                await asyncio.sleep(0.002)
            await ws.send(json.dumps({
                "type": "morceau", "mid": mid, "i": i, "n": n, "id_pilote": id_pilote,
                "d": texte[i * self.TAILLE_MORCEAU_PRIORITE:(i + 1) * self.TAILLE_MORCEAU_PRIORITE],
            }))
            await asyncio.sleep(0)

    def envoyer_notebook_distant_resultat(self, session_id: str, id_pilote: str, ok: bool, message: str,
                                           horodatage_debut: Optional[float] = None,
                                           horodatage_fin: Optional[float] = None,
                                           result_color: Optional[str] = None,
                                           result_output: Optional[dict] = None):
        """Résultat final (unique) de l'exécution du notebook distant.

        AJOUT (transfert RESULT_OUTPUT) -- result_output optionnel (défaut
        None), même patron que result_color : dict produit par _serialiser_
        result_output (JSON ou fichier base64), fourni uniquement sur le
        résultat de la DERNIÈRE cellule d'un lot clone réussi.

        AJOUT (spec B.2, colonne "Temps" du panneau clone) --
        horodatage_debut/horodatage_fin optionnels (défaut None, champ
        JSON toujours présent mais éventuellement null pour rester un
        JSON valide/rétrocompatible) : timestamps Unix RÉELS calculés
        côté sAutoniax (cf. _sautoniax_executer_notebook_distant_sur_
        instance_isolee), autour de l'exécution RÉELLE de la cellule
        uniquement (run_in_executor(_exec_thread)), jamais autour du
        transit réseau. None pour tout appelant qui ne les fournit pas
        (ex. chemin mono-profil manuel, NotebookDistantScreen -- pas de
        colonne Temps côté clone à alimenter pour ce chemin).

        AJOUT (SPEC_lot_corrections_2026-09.md section 11) --
        result_color optionnel (défaut None, champ JSON toujours présent
        mais éventuellement null), même patron EXACT que horodatage_
        debut/fin ci-dessus : uniquement fourni par l'appelant sur le
        résultat de la DERNIÈRE cellule d'un lot clone (cf.
        lire_result_color_finale dans _sautoniax_executer_notebook_
        distant_sur_instance_isolee, seul site d'appel qui le fournit
        pour l'instant) -- None pour tout autre appelant (chemin mono-
        profil manuel, résultat d'une cellule intermédiaire du lot,
        chemin d'échec avant toute exécution)."""
        if self._loop is None or not self._loop.is_running():
            return
        # [SYNC-DIAG] mêmes champs qu'avant + horodatage_envoi (heure réelle de l'appel
        # ws.send, côté sAutoniax) ; json.dumps déplacé DANS la coroutine pour mesurer
        # séparément : appel -> début d'envoi (attente de la boucle asyncio), sérialisation,
        # puis ws.send terminé.
        _ws_local = self._ws
        _t_appel_envoi = time.time()
        _uid_garanti = uuid.uuid4().hex   # livraison garantie (cf. _garantie_enregistrer)
        self._prio_fin = getattr(self, "_prio_fin", 0) + 1   # PRIORITE FIN : gèle morceaux + captures dès maintenant

        async def _envoyer_resultat_diag():
            _t_debut_coro = time.time()
            _charge = {
                "type": "notebook_distant_resultat", "session_id": session_id,
                "id_pilote": id_pilote, "ok": ok, "message": message,
                "horodatage_debut": horodatage_debut, "horodatage_fin": horodatage_fin,
                "result_color": result_color, "result_output": result_output,
                "horodatage_envoi": _t_debut_coro, "uid": _uid_garanti,
            }
            _texte = json.dumps(_charge)
            _t_apres_dumps = time.time()
            self._garantie_enregistrer(_uid_garanti, "notebook_distant_resultat", session_id, id_pilote, _texte, "direct")
            self._sessions_actives.pop(session_id, None)
            try:
                _ws_courant = self._ws if self._ws is not None else _ws_local
                if _ws_courant is not None:
                    await _ws_courant.send(_texte)
            except Exception as _e_envoi:
                log_reseau_t.warning(
                    f"Résultat final (session={session_id}) non envoyé ({_e_envoi!r}) -- conservé, il sera renvoyé "
                    "automatiquement (reconnexion / accusé manquant).")
            finally:
                self._prio_fin = max(0, getattr(self, "_prio_fin", 1) - 1)
            _t_apres_send = time.time()
            log_sync_diag.info(
                f"[SYNC-DIAG][sAutoniax] ENVOI RESULTAT session={session_id!r} ok={ok!r} "
                f"| FIN D'EXECUTION (heure de fin) = {_sync_diag_hms(horodatage_fin)} "
                f"| send() demandé à {_sync_diag_hms(_t_appel_envoi)} "
                f"(attente boucle asyncio {_sync_diag_ecart(_t_appel_envoi, _t_debut_coro)}) "
                f"| json.dumps {_sync_diag_ecart(_t_debut_coro, _t_apres_dumps)} ({len(_texte)} octets) "
                f"| ws.send terminé à {_sync_diag_hms(_t_apres_send)} ({_sync_diag_ecart(_t_apres_dumps, _t_apres_send)}) "
                f"| total fin d'exécution -> envoi terminé {_sync_diag_ecart(horodatage_fin, _t_apres_send)}"
            )

        asyncio.run_coroutine_threadsafe(_envoyer_resultat_diag(), self._loop)

    def envoyer_initialiser_notebook_distant_log(self, session_id: str, id_pilote: str, ligne: str):
