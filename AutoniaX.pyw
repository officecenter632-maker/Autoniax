async def action_camoufox_move_cursor(page, x: int, y: int) -> None:
    """moveCursor(x, y) -- déplace UNIQUEMENT le curseur virtuel, aucun
    vrai événement souris envoyé au navigateur (identique en esprit à
    action_move_cursor côté nodriver/CDP)."""
    await _camoufox_deplacer_curseur_virtuel(page, x, y)


async def action_camoufox_get_screen_info(page, etat_navigateur: Optional[dict] = None) -> dict:
    """getScreenInfo() -- identique en esprit à action_get_screen_info
    côté nodriver/CDP (cf. sa docstring), adapté à Playwright : pas de
    Page.getLayoutMetrics ici (API CDP bas niveau absente côté
    Playwright), donc lecture de window.innerWidth/innerHeight en JS --
    MÊMES unités (pixels CSS) que les coordonnées x/y déjà envoyées par
    page.mouse.move()/page.mouse.click() dans ce fichier (cf.
    action_camoufox_mousemove/action_camoufox_click), pas de conversion
    supplémentaire nécessaire côté appelant.

    curseur_x/curseur_y : même source que action_camoufox_mousemove/
    action_camoufox_click (etat_navigateur["curseur_x"/"curseur_y"]),
    None/None si aucun mousemove/click n'a encore eu lieu sur cette
    instance."""
    dimensions = await page.evaluate("({width: window.innerWidth, height: window.innerHeight})")
    curseur_x = curseur_y = None
    if etat_navigateur is not None:
        curseur_x = etat_navigateur.get("curseur_x")
        curseur_y = etat_navigateur.get("curseur_y")
    return {
        "largeur": int(dimensions["width"]),
        "hauteur": int(dimensions["height"]),
        "curseur_x": curseur_x,
        "curseur_y": curseur_y,
    }


# OPTIMISATION (demande utilisateur explicite : "vasy essai les deux cas" --
# piste 1 = parallélisation curseur_virtuel/mouse.move, piste 2 = réduire la
# fréquence du curseur virtuel, cf. discussion DIAG 6/7 + tests A/B/C/D) --
# interrupteur en dur, à modifier ICI directement pour ajuster : 1 = comportement
# IDENTIQUE à avant (curseur virtuel redessiné à CHAQUE point, comme avant ce
# patch) ; 2 ou 3 = curseur virtuel redessiné un point sur 2/3, tous les autres
# points ne font QUE page.mouse.move() (le vrai mouvement, lui, ne saute jamais
# aucun point -- cf. docstring de action_camoufox_mousemove). Le DERNIER point
# du trajet force TOUJOURS une mise à jour du curseur virtuel, quel que soit ce
# réglage, pour que le repère visuel finisse exactement sur la position réelle.
CAMOUFOX_CURSEUR_VIRTUEL_UN_POINT_SUR = 2


async def _mesurer_parallele(coro_mouse_move, coro_curseur_virtuel):
    """Exécute page.mouse.move() et _camoufox_deplacer_curseur_virtuel()
    (via _curseur_avec_timeout) EN PARALLÈLE (asyncio.gather) plutôt qu'en
    série -- les deux sont indépendants (aucun n'a besoin du résultat de
    l'autre), donc les exécuter en série ne fait qu'additionner inutilement
    leurs durées (~20-30ms chacun, par point du trajet). Retourne
    ((résultat_mouse_move, durée_mouse_move), durée_curseur_virtuel) pour
    conserver EXACTEMENT les mêmes logs de diagnostic par point qu'avant ce
    patch (cf. duree_curseur_point/duree_move_point dans
    action_camoufox_mousemove) -- mesurées individuellement malgré
    l'exécution parallèle, via un chrono local à chaque coroutine wrapper."""
    async def _avec_chrono(coro):
        debut = _horloge()
        resultat = await coro
        return resultat, _horloge() - debut

    (resultat_move, duree_move), (_, duree_curseur) = await asyncio.gather(
        _avec_chrono(coro_mouse_move),
        _avec_chrono(coro_curseur_virtuel),
    )
    return (resultat_move, duree_move), duree_curseur


async def action_camoufox_mousemove(page, x: int, y: int, etat_navigateur: Optional[dict] = None,
                                     speed_percent: float = 0, instantane: bool = False) -> None:
    """mousemove(x, y) -- déplacement souris HUMAIN (demande utilisateur
    explicite : "sa doit notre mouse trajectory doit genere le chemin et
    maintenant, l'evenement mouse move l'utilise") : génère un trajet A->B
    dérivé statistiquement des mouvements réels enregistrés (cf.
    generate_mouse_path / _charger_banque_trajectoire_souris), puis rejoue
    chaque point via page.mouse.move() en respectant les délais générés
    (au lieu du saut instantané précédent). Le curseur virtuel visuel suit
    la même trajectoire (cf. CAMOUFOX_CURSEUR_VIRTUEL_UN_POINT_SUR :
    redessiné un point sur N pour alléger le coût, TOUJOURS synchronisé sur
    le dernier point -- page.mouse.move(), lui, reçoit TOUJOURS tous les
    points sans exception, le mouvement réel envoyé au site est inchangé).

    Réutilisée par action_camoufox_click (demande utilisateur explicite :
    "clik deplace dabord le cursuer jusaqua la position avant deffectuer
    le click") -- le clic appelle cette fonction avant son propre
    mousedown/mouseup, avec son propre speed_percent indépendant.

    point_a (départ du trajet) : position actuelle du curseur virtuel,
    trackée dans etat_navigateur["curseur_x"/"curseur_y"] (demande
    utilisateur explicite). Si etat_navigateur est absent, ou si aucun
    mousemove n'a encore eu lieu (curseur_x/y à None -- premier mousemove
    de la session), (x, y) lui-même est utilisé comme point de départ
    (trajet de longueur nulle : équivaut à un simple positionnement direct,
    faute de position de départ connue).

    speed_percent (demande utilisateur explicite : "jamireas que clik et
    move prend en parametre la parametre speed pour que on puisse
    controler la vitesse dexecution") -- transmis tel quel à
    generate_mouse_path (cf. sa docstring pour la formule exacte) : 0 =
    vitesse normale/mesurée (défaut, comportement inchangé), positif =
    plus rapide, négatif = plus lent. N'affecte QUE la cadence temporelle
    des délais entre points, pas la forme géométrique du trajet ni
    l'amplitude du tremblement.

    Lève TrajectoireSourisIndisponible si aucune trajectoire ne peut être
    générée (scipy absent, mouseData.sqlite3 introuvable, ou banque vide)
    -- échec explicite demandé par l'utilisateur, pas de repli silencieux
    sur l'ancien comportement de saut instantané.

    AJOUT (cf. docstring de TRAJECTOIRE_SOURIS_INSTANTANEE) : si ce
    drapeau global est activé, court-circuite TOTALEMENT ce qui précède
    (aucun chargement de banque, aucun appel à generate_mouse_path, aucun
    log de diagnostic par point) -- un seul page.mouse.move envoyé
    directement vers (x, y), curseur virtuel repositionné une seule fois
    sur ce même point final.

    instantane (AJOUT, cf. docstring de SOURIS_INSTANTANEE dans
    CODE_VARIABLES_DYNAMIQUES_DEFAUT et de action_mousemove -- même
    mécanisme CDP/nodriver, résolu par requête via le script Task) : même
    effet que TRAJECTOIRE_SOURIS_INSTANTANEE ci-dessous, OR logique entre
    les deux -- soit l'un soit l'autre déclenche le court-circuit."""
    if TRAJECTOIRE_SOURIS_INSTANTANEE or instantane:
        x_arrondi, y_arrondi = int(round(x)), int(round(y))
        try:
            await asyncio.gather(
                page.mouse.move(x_arrondi, y_arrondi),
                _camoufox_deplacer_curseur_virtuel(page, x_arrondi, y_arrondi),
            )
        except Exception as exc:
            _camoufox_relever_si_fermeture(exc)
            raise
        if etat_navigateur is not None:
            etat_navigateur["curseur_x"] = float(x)
            etat_navigateur["curseur_y"] = float(y)
        return

    if etat_navigateur is not None and etat_navigateur.get("curseur_x") is not None:
        depart_x = etat_navigateur["curseur_x"]
        depart_y = etat_navigateur["curseur_y"]
    else:
        depart_x, depart_y = x, y

    # LOG DIAGNOSTIC (demande utilisateur explicite : logs détaillés à tous
    # les niveaux) -- point de départ/arrivée AVANT tout calcul, pour situer
    # dans le temps le début réel de ce mousemove (à comparer avec le log
    # "-> ENVOI commande" côté pilote et le log symétrique dans
    # _consommer_file_commandes_camoufox, qui mesure le round-trip complet).
    #
    # PATCH (nettoyage des logs -- problème #2 : logs à chaque mouvement de
    # souris, centaines de lignes en usage normal) -- passé en DEBUG,
    # comme les logs [trajectoire] plus haut dans generate_mouse_path.
    # Seul le résumé final ("TERMINÉ en...", tout en bas de cette fonction)
    # reste en INFO en production.
    log.debug(
        f"[camoufox] action_camoufox_mousemove() : départ -- ({depart_x:.0f},{depart_y:.0f}) -> "
        f"({x},{y}) speed_percent={speed_percent:.0f}"
    )
    debut_total = _horloge()

    bank = _charger_banque_trajectoire_souris()
    debut_generation = _horloge()
    evenements = generate_mouse_path(
        str(get_mouse_data_path()), (depart_x, depart_y), (x, y),
        intent="move", bank=bank, speed_percent=speed_percent,
    )
    duree_generation = _horloge() - debut_generation
    duree_trajet_predite = sum(ev["dt"] for ev in evenements if ev["dt"] > 0)
    log.debug(
        f"[camoufox] action_camoufox_mousemove() : trajet généré en {duree_generation * 1000:.1f}ms "
        f"(calcul pur, hors rejeu) -- {len(evenements)} points, durée de rejeu PRÉVUE="
        f"{duree_trajet_predite:.3f}s (cf. logs [trajectoire] ci-dessus pour le détail du calcul)"
    )

    try:
        duree_curseur_virtuel_cumulee = 0.0
        duree_mouse_move_cumulee = 0.0
        for i, ev in enumerate(evenements):
            if ev["dt"] > 0:
                await asyncio.sleep(ev["dt"])

            x_arrondi, y_arrondi = int(round(ev["x"])), int(round(ev["y"]))

            # OPTIMISATION (demande utilisateur explicite : "essai les deux
            # cas" -- piste 1 + piste 2 combinées) :
            #
            # PISTE 1 -- _camoufox_deplacer_curseur_virtuel (page.evaluate,
            # simple dessin DOM) et page.mouse.move (event Playwright natif,
            # ce que le site voit réellement) sont deux appels INDÉPENDANTS
            # -- rien dans l'un n'a besoin du résultat de l'autre. Avant ce
            # patch, ils étaient exécutés en SÉRIE (await puis await), donc
            # leurs durées s'additionnaient point par point (~20ms + ~30ms).
            # Lancés en parallèle via asyncio.gather, seul le plus lent des
            # deux compte par point, pas la somme.
            #
            # PISTE 2 -- CAMOUFOX_CURSEUR_VIRTUEL_UN_POINT_SUR (constante
            # ci-dessous, cf. sa définition) : le curseur virtuel (repère
            # visuel cercle translucide bleu, cf. décision utilisateur de le conserver)
            # n'est redessiné qu'un point sur N -- TOUJOURS forcé sur le
            # DERNIER point du trajet (i == len(evenements) - 1) pour que le
            # repère visuel finisse bien exactement sur la position réelle,
            # jamais en retard. page.mouse.move(), lui, reçoit TOUJOURS
            # TOUS les points, sans exception -- seul le repère visuel est
            # allégé, le trajet réellement rejoué au site est strictement
            # identique à avant.
            maj_curseur_virtuel_ce_point = (
                (i % CAMOUFOX_CURSEUR_VIRTUEL_UN_POINT_SUR == 0)
                or (i == len(evenements) - 1)
            )

            debut_point = _horloge()
            if maj_curseur_virtuel_ce_point:
                # AJOUT : timeout explicite (absent avant ce patch, contrairement
                # à _camoufox_masquer_curseur_virtuel/_camoufox_reafficher_curseur_
                # virtuel qui en ont déjà un) -- appelé sur une FRACTION des
                # points du trajet désormais (cf. PISTE 2 ci-dessus), plus à
                # chaque point comme avant.
                async def _curseur_avec_timeout():
                    try:
                        await asyncio.wait_for(
                            _camoufox_deplacer_curseur_virtuel(page, x_arrondi, y_arrondi),
                            timeout=2.0,
                        )
                    except asyncio.TimeoutError:
                        log.warning(
                            f"[camoufox] action_camoufox_mousemove() : point {i+1}/{len(evenements)} -- "
                            f"_camoufox_deplacer_curseur_virtuel() (page.evaluate) a dépassé 2.0s sans répondre"
                        )

                (_, duree_move_point), duree_curseur_point = await _mesurer_parallele(
                    page.mouse.move(x_arrondi, y_arrondi),
                    _curseur_avec_timeout(),
                )
            else:
                debut_move = _horloge()
                await page.mouse.move(x_arrondi, y_arrondi)
                duree_move_point = _horloge() - debut_move
                duree_curseur_point = 0.0
            duree_totale_point = _horloge() - debut_point
            duree_curseur_virtuel_cumulee += duree_curseur_point
            duree_mouse_move_cumulee += duree_move_point

            if duree_totale_point > 0.2:
                log.warning(
                    f"[camoufox] action_camoufox_mousemove() : point {i+1}/{len(evenements)} LENT -- "
                    f"curseur_virtuel={duree_curseur_point:.3f}s (maj={maj_curseur_virtuel_ce_point}), "
                    f"mouse.move={duree_move_point:.3f}s, point total (parallèle)={duree_totale_point:.3f}s"
                )
        duree_playwright_cumulee = duree_curseur_virtuel_cumulee + duree_mouse_move_cumulee
    except Exception as exc:
        _camoufox_relever_si_fermeture(exc)
        raise

    duree_totale = _horloge() - debut_total
    # Compare la durée RÉELLEMENT observée à la durée prédite par le trajet :
    # un écart significatif (overhead > ~10-20% du prévu) pointe vers
    # page.mouse.move()/_camoufox_deplacer_curseur_virtuel (donc Playwright/
    # le navigateur lui-même) plutôt que vers generate_mouse_path -- distinction
    # cruciale pour savoir OÙ optimiser. Répartition ci-dessous entre les deux
    # (curseur virtuel = page.evaluate JS, mouse.move = event natif Playwright)
    # pour trancher lequel des deux est le vrai coupable.
    #
    # NOTE (depuis la parallélisation asyncio.gather, cf. _mesurer_parallele
    # ci-dessus) : duree_playwright_cumulee (somme de duree_curseur_virtuel_
    # cumulee + duree_mouse_move_cumulee) n'est PLUS un temps réellement
    # écoulé sur le point concerné -- les deux appels tournant en parallèle,
    # leur SOMME peut dépasser le temps horloge effectivement passé sur ce
    # point. C'est désormais une mesure de CHARGE CUMULÉE par mécanisme (utile
    # pour comparer curseur_virtuel vs mouse.move entre eux), pas un budget
    # temps qui s'additionnerait littéralement à duree_trajet_predite.
    overhead = duree_totale - duree_trajet_predite
    log.info(
        f"[camoufox] action_camoufox_mousemove() : TERMINÉ en {duree_totale:.3f}s "
        f"(prévu={duree_trajet_predite:.3f}s, overhead total={duree_playwright_cumulee:.3f}s "
        f"[curseur_virtuel={duree_curseur_virtuel_cumulee:.3f}s, mouse.move={duree_mouse_move_cumulee:.3f}s], "
        f"écart total vs prévu={overhead:+.3f}s)"
    )

    if etat_navigateur is not None:
        etat_navigateur["curseur_x"] = float(x)
        etat_navigateur["curseur_y"] = float(y)


async def action_camoufox_diag_raw_mouse_move(page, x: int, y: int, nb_appels: int = 5,
                                                sleep_entre_appels_s: float = 0.0) -> dict:
    """DIAGNOSTIC TEMPORAIRE (demande explicite utilisateur -- confirmer
    que page.mouse.move() lui-même, isolé de tout le reste, est bien le
    nœud du problème avant d'aller optimiser generate_mouse_path ou le
    curseur virtuel).

    Court-circuite volontairement TOUT ce que fait action_camoufox_
    mousemove autour de l'appel Playwright : pas de generate_mouse_path
    (donc pas de banque de trajectoire chargée, pas de tremblement, pas
    de plusieurs points), pas de _camoufox_deplacer_curseur_virtuel
    (donc pas de page.evaluate). Juste nb_appels appels bruts et
    consécutifs de page.mouse.move(x, y) vers LE MÊME point (trajet nul,
    comme le Test B précédent), chacun chronométré individuellement.

    RÉSULTAT DU PREMIER RUN (sans sleep) -- pas le résultat uniforme
    attendu : un seul premier appel lent (2.37s), puis 7 appels rapides
    (12-31ms). Ça pointe vers un coût de "réveil" (premier appel après
    une pause), PAS une lenteur systémique de Playwright -- différent de
    ce qu'on observait dans action_camoufox_mousemove, où PRESQUE CHAQUE
    point de la boucle réelle était lent, pas juste le premier.

    sleep_entre_appels_s (AJOUT, pour trancher entre les deux
    hypothèses) : si > 0, un asyncio.sleep() de cette durée est inséré
    AVANT chaque appel (sauf le tout premier) -- reproduit le
    `await asyncio.sleep(ev["dt"])` de la vraie boucle de
    action_camoufox_mousemove (où ev["dt"] vaut typiquement 10-30ms
    entre deux points d'un trajet). Si la lenteur revient à CHAQUE appel
    avec ce sleep (pas seulement le premier), ça confirme que c'est le
    sleep/la pause entre deux appels qui fait retomber Playwright dans
    un état lent -- pas juste un cold-start de session. Si la lenteur
    reste isolée au premier appel même avec ce sleep, c'est bien un
    cold-start pur, et la vraie boucle doit avoir une autre cause
    (probablement le curseur virtuel/page.evaluate() intercalé entre
    chaque mouse.move() dans la boucle réelle, qu'on n'a pas ici).

    Retourne un dict JSON-sérialisable (durées en secondes) plutôt que
    de se contenter de logger, pour que le résultat soit lisible
    directement depuis Instance._appeler(...) dans une cellule Task,
    sans avoir à relire les logs bruts."""
    durees = []
    for i in range(max(1, nb_appels)):
        if i > 0 and sleep_entre_appels_s > 0:
            await asyncio.sleep(sleep_entre_appels_s)
        debut = _horloge()
        await page.mouse.move(x, y)
        dt = _horloge() - debut
        durees.append(dt)
        log.info(
            f"[camoufox][diag] diagRawMouseMove() : appel {i+1}/{nb_appels} -- "
            f"page.mouse.move({x},{y}) brut = {dt:.3f}s "
            f"(sleep_avant={sleep_entre_appels_s if i > 0 else 0.0:.3f}s)"
        )
    return {
        "nb_appels": len(durees),
        "sleep_entre_appels_s": sleep_entre_appels_s,
        "durees_s": [round(d, 4) for d in durees],
        "min_s": round(min(durees), 4),
        "max_s": round(max(durees), 4),
        "moyenne_s": round(sum(durees) / len(durees), 4),
        "moyenne_hors_premier_s": round(sum(durees[1:]) / len(durees[1:]), 4) if len(durees) > 1 else None,
    }


async def action_camoufox_diag_alternance_curseur_mouse(page, x: int, y: int, nb_appels: int = 8,
                                                          sleep_entre_appels_s: float = 0.02) -> dict:
    """DIAGNOSTIC TEMPORAIRE (suite de action_camoufox_diag_raw_mouse_move
    -- demande explicite utilisateur : TEST DIAG 3). Les deux tests
    précédents ont éliminé page.mouse.move() seul (rapide une fois la
    session "chauffée") ET le sleep entre appels seul (n'a pas recréé la
    lenteur) comme causes isolées. Il reste UN élément de la vraie
    boucle de action_camoufox_mousemove absent des deux tests
    précédents : l'ALTERNANCE _camoufox_deplacer_curseur_virtuel
    (page.evaluate) PUIS page.mouse.move() PUIS sleep, répétée à chaque
    point -- jamais reproduite isolément jusqu'ici, seulement mouse.move
    seul (DIAG/DIAG 2) ou l'un des deux en isolation dans les logs
    originaux de action_camoufox_mousemove (où les deux étaient DÉJÀ
    entrelacés, donc impossible d'exclure une contention entre les deux
    sur le même objet `page`).

    Reproduit ICI, à l'identique de la boucle réelle (mêmes 3 étapes
    par point, même ordre) :
        pour chaque point :
            await asyncio.sleep(sleep_entre_appels_s)   (si i > 0)
            await _camoufox_deplacer_curseur_virtuel(page, x, y)
            await page.mouse.move(x, y)

    SEULE différence avec action_camoufox_mousemove : x/y restent fixes
    (trajet nul, comme les tests précédents) au lieu de suivre un
    trajet généré par generate_mouse_path -- generate_mouse_path lui-
    même a déjà été écarté par action_camoufox_mousemove (calcul pur,
    mesuré à 20-40ms, jamais la source de lenteur, cf. logs originaux).

    Si la lenteur (250-450ms/point) revient ICI alors qu'elle était
    absente de DIAG (mouse.move seul) et DIAG 2 (mouse.move + sleep
    seuls) : confirme que c'est bien l'ALTERNANCE curseur virtuel +
    mouse.move qui pose problème (contention sur `page`), pas l'un des
    deux appels pris isolément.
    Si la lenteur reste absente même ici : la cause doit être ailleurs
    dans action_camoufox_mousemove (à réexaminer -- peut-être un effet
    de bord du contexte d'exécution réel : etat_navigateur, autre
    tâche asyncio concurrente sur la même page, etc.)."""
    durees_curseur = []
    durees_mouse = []
    for i in range(max(1, nb_appels)):
        if i > 0 and sleep_entre_appels_s > 0:
            await asyncio.sleep(sleep_entre_appels_s)

        debut_curseur = _horloge()
        await _camoufox_deplacer_curseur_virtuel(page, int(x), int(y))
        dt_curseur = _horloge() - debut_curseur
        durees_curseur.append(dt_curseur)

        debut_mouse = _horloge()
        await page.mouse.move(x, y)
        dt_mouse = _horloge() - debut_mouse
        durees_mouse.append(dt_mouse)

        log.info(
            f"[camoufox][diag] diagAlternanceCurseurMouse() : point {i+1}/{nb_appels} -- "
            f"curseur_virtuel={dt_curseur:.3f}s, mouse.move={dt_mouse:.3f}s"
        )
    return {
        "nb_appels": len(durees_mouse),
        "sleep_entre_appels_s": sleep_entre_appels_s,
        "durees_curseur_s": [round(d, 4) for d in durees_curseur],
        "durees_mouse_s": [round(d, 4) for d in durees_mouse],
        "moyenne_curseur_s": round(sum(durees_curseur) / len(durees_curseur), 4),
        "moyenne_mouse_s": round(sum(durees_mouse) / len(durees_mouse), 4),
        "max_curseur_s": round(max(durees_curseur), 4),
        "max_mouse_s": round(max(durees_mouse), 4),
    }


async def action_camoufox_diag_mouvement_reel(page, x: int, y: int, nb_appels: int = 8,
                                               sleep_entre_appels_s: float = 0.02,
                                               pas_px: int = 1) -> dict:
    """DIAGNOSTIC TEMPORAIRE (TEST DIAG 5 -- suite de
    action_camoufox_diag_alternance_curseur_mouse). Différence UNIQUE et
    volontaire avec DIAG 3/4 : x/y ne sont PLUS fixes d'un point à
    l'autre -- chaque appel page.mouse.move() vise une position décalée
    de `pas_px` pixels par rapport au point précédent (mouvement réel,
    en ligne droite), au lieu de renvoyer inlassablement le MÊME point.
    Toujours SANS generate_mouse_path (pas de banque de trajectoire, pas
    de tremblement, pas de dt variable) -- seule la position varie.

    Hypothèse à trancher : DIAG 3/4 (point fixe répété) sont rapides à
    chaque run, mais la vraie boucle (action_camoufox_mousemove, où la
    position change à CHAQUE point via generate_mouse_path) est
    systématiquement lente (~250-300ms/point), y compris dans des cas
    dégénérés à target_distance=0.0px où le déplacement réel entre deux
    points consécutifs est minime. Si la lenteur revient ICI (position
    qui varie, même très légèrement, à chaque point) alors qu'elle est
    absente de DIAG 3/4 (position strictement identique), ça confirme
    que c'est le fait même d'un DÉPLACEMENT (par opposition à un
    mousemove "sur place") qui coûte cher côté Camoufox/Firefox --
    probablement un cycle de layout/hit-testing/repaint (ou un
    event listener injecté par Camoufox sur mousemove à des fins
    d'anti-détection) déclenché uniquement quand la position change
    réellement, pas par l'alternance curseur virtuel/mouse.move, ni par
    le streaming, ni par _appeler/le réseau (déjà tous écartés).

    Reproduit EXACTEMENT la même structure par point que DIAG 3
    (sleep, puis curseur virtuel, puis mouse.move), à la seule
    différence de la position envoyée à mouse.move :
        pour chaque point i :
            await asyncio.sleep(sleep_entre_appels_s)   (si i > 0)
            xi, yi = x + i * pas_px, y                  (déplacement réel)
            await _camoufox_deplacer_curseur_virtuel(page, xi, yi)
            await page.mouse.move(xi, yi)"""
    durees_curseur = []
    durees_mouse = []
    positions = []
    for i in range(max(1, nb_appels)):
        if i > 0 and sleep_entre_appels_s > 0:
            await asyncio.sleep(sleep_entre_appels_s)

        xi = int(x) + i * pas_px
        yi = int(y)
        positions.append((xi, yi))

        debut_curseur = _horloge()
        await _camoufox_deplacer_curseur_virtuel(page, xi, yi)
        dt_curseur = _horloge() - debut_curseur
        durees_curseur.append(dt_curseur)

        debut_mouse = _horloge()
        await page.mouse.move(xi, yi)
        dt_mouse = _horloge() - debut_mouse
        durees_mouse.append(dt_mouse)

        log.info(
            f"[camoufox][diag] diagMouvementReel() : point {i+1}/{nb_appels} -- "
            f"({xi},{yi}) -- curseur_virtuel={dt_curseur:.3f}s, mouse.move={dt_mouse:.3f}s"
        )
    return {
        "nb_appels": len(durees_mouse),
        "sleep_entre_appels_s": sleep_entre_appels_s,
        "pas_px": pas_px,
        "positions": positions,
        "durees_curseur_s": [round(d, 4) for d in durees_curseur],
        "durees_mouse_s": [round(d, 4) for d in durees_mouse],
        "moyenne_curseur_s": round(sum(durees_curseur) / len(durees_curseur), 4),
        "moyenne_mouse_s": round(sum(durees_mouse) / len(durees_mouse), 4),
        "max_curseur_s": round(max(durees_curseur), 4),
        "max_mouse_s": round(max(durees_mouse), 4),
    }


async def action_camoufox_click(
    page, x: int, y: int, bouton: str = "gauche",
    duree_appui_ms: int = 60, nb_clics: int = 1,
    etat_navigateur: Optional[dict] = None,
    speed_percent: float = 0, instantane: bool = False,
) -> None:
    """click(x, y) -- déplace d'abord la souris jusqu'à (x, y) avec une
    trajectoire HUMAINE (réutilise action_camoufox_mousemove telle quelle
    -- même génération de trajectoire, même tracking de position via
    etat_navigateur["curseur_x"/"curseur_y"], même échec explicite
    TrajectoireSourisIndisponible si aucune trajectoire n'est disponible),
    PUIS effectue mousedown/mouseup avec délai configurable entre les deux
    à l'arrivée (demande utilisateur explicite : "clik deplace dabord le
    cursuer jusaqua la position avant deffectuer le click"), équivalent
    mousePressed/mouseReleased CDP.

    speed_percent (demande utilisateur explicite, cf. action_camoufox_
    mousemove) -- s'applique UNIQUEMENT au déplacement préalable
    (mousemove interne), indépendant de tout speed_percent utilisé par un
    mousemove appelé par ailleurs (demande utilisateur explicite : "click
    prend son propre paramètre speed, independant de celui du mousemove").
    N'affecte pas duree_appui_ms (le délai mousedown->mouseup reste tel
    quel).

    instantane (BUGFIX -- retour utilisateur explicite : "jai bien mis le
    parametre de souris intantane a True mais jai toujour limpression que
    sa genere encore la trajectorie") : ce paramètre était ABSENT de cette
    fonction (contrairement à action_click, son équivalent CDP/nodriver,
    qui le porte déjà -- cf. docstring de action_mousemove/
    SOURIS_INSTANTANEE), et le dispatcher Camoufox (cf. _executer_commande_
    camoufox, branche "click") n'extrayait de toute façon jamais
    data["instantane"] pour le transmettre ici (même oubli symétrique côté
    dispatcher CDP/nodriver, corrigé en même temps) -- SOURIS_INSTANTANEE=
    True dans la cellule "Variable dynamique" du Task restait donc SANS
    AUCUN EFFET sur click() en mode Camoufox : la trajectoire humaine était
    TOUJOURS générée, quelle que soit la valeur de cette variable. Transmis
    tel quel au déplacement préalable (mousemove interne), même principe
    que speed_percent juste au-dessus. N'affecte que ce déplacement --
    mousedown/mouseup qui suivent restent instantanés comme toujours
    (comportement historique inchangé).

    duree_appui_ms (PATCH -- cf. docstring de _resoudre_duree_appui_ms
    pour le détail complet, même logique partagée avec action_click côté
    CDP/nodriver) -- ce paramètre est IGNORÉ dès que
    Data/files/mouseData.sqlite3 contient assez de clics réels
    exploitables : la durée réellement appliquée est alors tirée par
    bootstrap dans les durées de clic mesurées (table `clicks`), même si
    l'appelant a fourni explicitement une autre valeur (demande
    utilisateur explicite : la banque prime toujours si elle existe). Ne
    redevient la valeur utilisée qu'en repli, si la banque est
    indisponible (fichier absent, ou pas assez de clics après filtrage
    des maintiens longs).

    etat_navigateur est optionnel pour compatibilité arrière (appel direct
    hors du dispatcher) : si absent, action_camoufox_mousemove utilise
    (x, y) lui-même comme point de départ (trajet de longueur nulle --
    revient au comportement de positionnement direct)."""
    log.info(f"[camoufox] action_camoufox_click() : déplacement préalable vers ({x},{y})...")
    await action_camoufox_mousemove(page, x, y, etat_navigateur=etat_navigateur, speed_percent=speed_percent,
                                     instantane=instantane)
    bouton_pw = _CAMOUFOX_BOUTONS.get(bouton, "left")
    duree_reelle_ms = _resoudre_duree_appui_ms(duree_appui_ms, contexte_log="camoufox][action_camoufox_click")
    debut_clic = _horloge()
    # PATCH (effet visuel de clic -- rétrécissement/élargissement/taille
    # normale, cf. docstring _camoufox_pulser_curseur_virtuel) : lancée
    # AVANT mousedown (coïncide avec l'instant réel du clic, pas après
    # coup) ET sans await sur sa fin -- asyncio.create_task plutôt qu'un
    # simple await, pour que les ~220ms d'animation JS ne retardent
    # jamais le vrai mousedown/mouseup ci-dessous (duree_appui_ms reste
    # le seul délai qui compte pour le TIMING du clic réel, cf. docstring
    # de fonction : "N'affecte pas duree_appui_ms").
    asyncio.create_task(_camoufox_pulser_curseur_virtuel(page))
    # CORRECTIF : marque ce clic comme venant du SCRIPT (cf. copieHumaine
    # dans _JS_CAMOUFOX_INTERCEPTION_PRESSE_PAPIER) -- sans marqueur, les
    # clics du script seraient pris pour des clics humains.
    try:
        await page.evaluate(
            f"window.__autoniax_script_jusqua__ = Date.now() + {int(DELAI_MARQUE_ACTION_SCRIPT_S * 1000)};"
        )
    except Exception as exc_marque:
        log.debug(f"[camoufox][presse-papier] marquage action script impossible : {exc_marque!r}")
    try:
        await page.mouse.down(button=bouton_pw, click_count=nb_clics)
        await asyncio.sleep(max(0.0, duree_reelle_ms) / 1000.0)
        await page.mouse.up(button=bouton_pw, click_count=nb_clics)
    except Exception as exc:
        _camoufox_relever_si_fermeture(exc)
        raise
    log.info(
        f"[camoufox] action_camoufox_click() : mousedown/mouseup terminé en "
        f"{_horloge() - debut_clic:.3f}s (attendu={duree_reelle_ms:.1f}ms, "
        f"paramètre reçu={duree_appui_ms}ms)"
    )


# PATCH (glisser du puzzle CAPTCHA : « le puzzle se redéplace en allant vers Next,
# comme s'il n'avait jamais été relâché ») -- TRAJECTOIRE_SOURIS_INSTANTANEE étant
# activé en dur, le glisser ne produisait qu'UN SEUL mousemove (saut direct du
# départ à l'arrivée) entre mousedown et mouseup : certains CAPTCHA à puzzle
# n'enregistrent alors pas correctement la fin du glisser. True = pendant que le
# bouton est maintenu, le déplacement est découpé en petits pas (avec délais),
# puis un petit mouvement après le relâchement ; False = comportement d'avant.
CAMOUFOX_DRAG_PROGRESSIF = True


async def _camoufox_deplacer_maintenu(page, x1, y1, x2, y2, etat_navigateur=None) -> None:
    """Déplacement en petits pas (courbe douce) de (x1, y1) à (x2, y2), bouton
    déjà maintenu : Playwright garde `buttons` tout seul. Le curseur virtuel et
    etat_navigateur sont mis à jour une seule fois, sur le point final."""
    distance = math.hypot(x2 - x1, y2 - y1)
    nb_pas = max(6, min(60, int(distance / 6)))
    try:
        for i in range(1, nb_pas + 1):
            t = i / nb_pas
            k = t * t * (3.0 - 2.0 * t)
            await page.mouse.move(int(round(x1 + (x2 - x1) * k)), int(round(y1 + (y2 - y1) * k)))
            await asyncio.sleep(0.010 + random.random() * 0.012)
    except Exception as exc:
        _camoufox_relever_si_fermeture(exc)
        raise
    await _camoufox_deplacer_curseur_virtuel(page, int(round(x2)), int(round(y2)))
    if etat_navigateur is not None:
        etat_navigateur["curseur_x"] = float(x2)
        etat_navigateur["curseur_y"] = float(y2)


async def action_camoufox_mouse_drag(page, x1, y1, x2, y2, bouton="gauche", etat_navigateur=None,
                                     speed_percent=0, instantane=False, pause_ms=120):
    """Glisser (souris) côté Camoufox (cf. action_mouse_drag). Playwright
    maintient `buttons` tout seul pendant mouse.move entre down et up."""
    bouton_pw = _CAMOUFOX_BOUTONS.get(bouton, "left")
    await action_camoufox_mousemove(page, x1, y1, etat_navigateur=etat_navigateur,
                                    speed_percent=speed_percent, instantane=instantane)
    await asyncio.sleep(pause_ms / 1000)
    en_saut_unique = TRAJECTOIRE_SOURIS_INSTANTANEE or instantane
    try:
        await page.mouse.down(button=bouton_pw)
        await asyncio.sleep(pause_ms / 1000)
        if CAMOUFOX_DRAG_PROGRESSIF and en_saut_unique:
            await _camoufox_deplacer_maintenu(page, x1, y1, x2, y2, etat_navigateur=etat_navigateur)
        else:
            await action_camoufox_mousemove(page, x2, y2, etat_navigateur=etat_navigateur,
                                            speed_percent=speed_percent, instantane=instantane)
        await asyncio.sleep(pause_ms / 1000)
    finally:
        await page.mouse.up(button=bouton_pw)
    if CAMOUFOX_DRAG_PROGRESSIF:
        # Petit mouvement SANS bouton juste après le relâchement : un CAPTCHA qui
        # termine le glisser en voyant un mousemove avec buttons=0 le reçoit ici.
        await asyncio.sleep(0.08)
        try:
            await page.mouse.move(int(round(x2)) + 1, int(round(y2)))
            if etat_navigateur is not None:
                etat_navigateur["curseur_x"] = float(x2) + 1.0
                etat_navigateur["curseur_y"] = float(y2)
        except Exception as exc:
            log.debug(f"[camoufox] mouvement de dégagement après glisser ignoré : {exc!r}")


async def action_camoufox_scroll_simple(page, sens: str, amplitude: float = WHEEL_DELTA) -> None:
    """Scroll MINIMAL, volontairement séparé de action_camoufox_scroll
    (laissée intacte, ne pas y toucher) -- demande utilisateur explicite :
    "je m'en fous de la valeur du scroll réel, simule juste le scroll",
    "un seul wheel, une seule valeur constante raisonnable", "tout ce que
    l'événement doit transmettre c'est le sens, du haut ou vers le bas",
    puis "je veux que cette valeur constante, on passe en paramètre dans
    le panneau de rendu, donc ça sera un entry de scroll".

    `sens` : "haut" ou "bas" -- avec `amplitude` (réglée côté pilote,
    cf. PanneauRenduInstance.spin_amplitude_scroll et
    _sur_debounce_scroll), SEULES informations transmises par l'appelant --
    aucune coordonnée, aucun delta accumulé. Aucune humanisation, aucun
    repositionnement de souris/curseur virtuel, aucune banque de
    trajectoire : un seul appel à page.mouse.wheel(). `amplitude` garde
    WHEEL_DELTA comme valeur par défaut pour tout appelant qui ne la
    transmettrait pas (repli, pas une valeur figée imposée). L'appelant
    (cf. _executer_commande_camoufox, action == "scroll_simple") est
    responsable d'ignorer les événements de scroll suivants tant que
    celui-ci n'est pas terminé (cf. commentaire à l'appel)."""
    pas_y = -abs(amplitude) if sens == "haut" else abs(amplitude)
    await asyncio.wait_for(page.mouse.wheel(0, pas_y), timeout=5.0)


async def action_camoufox_scroll(page, x: int, y: int, delta_x: float = 0.0, delta_y: float = 0.0,
                                  frequence_crans_par_sec: float = 5.0, speed_percent: float = 0.0,
                                  rapide: bool = False) -> None:
    """scroll(targetDeltaX, targetDeltaY) -- défilement HUMAIN, même
    branchement que action_camoufox_mousemove/action_scroll (nodriver) :
    (delta_x, delta_y) est la quantité TOTALE à scroller (pas un delta de
    cran unique, cf. docstring action_scroll pour le détail complet du
    contrat) -- generate_scroll_events (ScrollBank, bootstrap multi-sources
    sur les rafales de scroll réelles enregistrées dans mouseData.sqlite3)
    dérive une séquence de crans (dt, dy, dx) dont la somme fait exactement
    (delta_x, delta_y), rejouée ici cran par cran via page.mouse.wheel()
    en respectant les délais générés.

    ÉCART CONNU (inchangé, cf. ancienne docstring) : mouse.wheel() de
    Playwright ne prend pas de x/y (contrairement à cdp.input_.
    dispatch_mouse_event(type_="mouseWheel", x=..., y=...)) -- on
    positionne donc la souris NATIVE à (x, y) une seule fois avant la
    rafale de wheel(), pas à chaque cran (repositionner à chaque cran
    n'aurait aucun effet utile ici, la souris ne bouge pas pendant un
    scroll).

    PATCH (retour utilisateur : "le curseur jaune injecté ne se met pas
    à jour quand on scroll, désynchronisé du curseur natif surtout au
    scroll") -- le repère visuel (curseur virtuel, cercle translucide bleu) est
    maintenant repositionné en même temps que la souris native, une
    seule fois au même endroit (x, y), pour la même raison : il ne
    bouge pas non plus pendant le scroll lui-même, donc une seule mise
    à jour au départ suffit à rester synchronisé (cf. _camoufox_
    deplacer_curseur_virtuel juste après page.mouse.move ci-dessous).

    speed_percent : même formule que action_camoufox_mousemove -- 0 =
    cadence mesurée/normale, positif = plus rapide, négatif = plus lent.
    N'affecte QUE les délais entre crans, jamais l'amplitude dy/dx.
    Ignoré si rapide=True (cf. ci-dessous, aucun délai entre crans dans
    ce mode).

    rapide (PATCH -- retour utilisateur explicite : "au lieu d'envoyer
    l'événement scroll en direct, enregistre d'abord l'événement scroll
    complet jusqu'à détecter que l'utilisateur ne scrolle plus, et
    exécute maintenant de l'autre côté sAutoniax, rapidement, je ne veux
    pas de perte de temps") -- utilisé quand delta_x/delta_y représentent
    déjà un geste de molette COMPLET, accumulé côté pilote (cf.
    PanneauRenduInstance._sur_debounce_scroll dans AutoniaX.py) plutôt
    qu'un cran unique en temps réel : le geste a déjà été "joué" au bon
    rythme humain côté pilote (la personne a vraiment tourné la molette
    pendant tout ce temps), donc le REjouer une seconde fois au ralenti
    ici (generate_scroll_events, qui peut étaler plusieurs secondes de
    délais, cf. ev["dt"]) n'apporterait aucun réalisme supplémentaire et
    ajouterait une latence perçue directement par l'utilisateur qui
    attend de voir le résultat. Dans ce mode : AUCUN generate_scroll_
    events, AUCUN délai entre crans -- juste assez de crans de
    WHEEL_DELTA pour que la page (qui peut plafonner l'amplitude d'un
    seul wheel()) défile bien du montant demandé, exécutés dos à dos
    sans attente.

    REPLI EXPLICITE (même esprit que action_scroll, PAS le même contrat
    que action_camoufox_mousemove qui lève TrajectoireSourisIndisponible
    sans repli) : si la banque de scroll est indisponible ou si
    generate_scroll_events échoue pour toute autre raison, on retombe sur
    l'ancien comportement -- des crans de WHEEL_DELTA (ou fraction)
    espacés selon frequence_crans_par_sec, un seul wheel() par cran --
    plutôt que de faire échouer toute la commande scroll. Un log.warning
    trace ce repli. Ce repli n'est PAS utilisé si rapide=True (qui a son
    propre chemin, jamais dépendant de la banque de scroll)."""
    # LOG DIAGNOSTIC (demande utilisateur explicite : logs détaillés à tous
    # les niveaux) -- AVANT ce patch, scroll ne produisait AUCUN log entre
    # son entrée dans _executer_commande_camoufox et le timeout dur de 20s
    # côté _consommer_file_commandes_camoufox (cf. logs : jamais de
    # "TERMINÉ", jamais d'erreur -- juste un silence total jusqu'à
    # "BLOQUÉE plus de 20.0s"). Instrumentation cran par cran ci-dessous
    # pour isoler PRÉCISÉMENT quelle étape ne revient jamais : le
    # positionnement initial (page.mouse.move), la génération des
    # événements (generate_scroll_events, calcul pur, ne devrait jamais
    # bloquer), ou un cran de page.mouse.wheel() en particulier (aucun
    # timeout interne ici avant ce patch -- contrairement à
    # camoufox_capturer_frame_reelle qui a toujours eu son wait_for(5.0)).
    debut_total = _horloge()
    log.info(
        f"[camoufox] action_camoufox_scroll() : départ -- position=({x},{y}) delta=({delta_x:.0f},{delta_y:.0f}) "
        f"speed_percent={speed_percent:.0f} rapide={rapide}"
    )
    try:
        debut_move = _horloge()
        await page.mouse.move(x, y)
        # PATCH (retour utilisateur : "le curseur jaune injecté ne se met
        # pas à jour quand on scroll, il se désynchronise du curseur natif
        # surtout au moment des actions de scroll") -- AVANT ce patch,
        # action_camoufox_scroll positionnait bien la souris NATIVE
        # (page.mouse.move ci-dessus, Playwright, ce que le site voit
        # réellement) à (x, y), mais n'appelait jamais _camoufox_deplacer_
        # curseur_virtuel -- contrairement à action_camoufox_mousemove/
        # click/type_text qui le font systématiquement. Le repère visuel
        # (cercle translucide bleu, position: fixed) restait donc figé à l'endroit
        # où la dernière action mousemove/click l'avait laissé, même
        # après que le scroll ait repositionné la souris réelle ailleurs.
        # Un seul appel suffit ici (pas à chaque cran de la boucle
        # wheel() plus bas) : le curseur ne bouge pas PENDANT un scroll,
        # seule sa position de DÉPART doit refléter (x, y), exactement
        # comme la souris native juste au-dessus.
        await _camoufox_deplacer_curseur_virtuel(page, x, y)
        log.info(f"[camoufox] action_camoufox_scroll() : positionnement initial (page.mouse.move + curseur virtuel) terminé en {_horloge() - debut_move:.3f}s")

        if rapide:
            # PATCH -- chemin dédié, cf. docstring ci-dessus. Peu de
            # crans (pas un par WHEEL_DELTA complet comme le repli plus
            # bas -- ici on vise la RAPIDITÉ, pas le réalisme du rythme,
            # donc de plus gros pas suffisent) et AUCUNE attente entre
            # eux. max(1, ...) : toujours au moins un wheel() même pour
            # un tout petit delta, sinon un scroll léger n'aurait aucun
            # effet.
            nb_crans = max(1, min(4, round(max(abs(delta_x), abs(delta_y)) / (WHEEL_DELTA * 3))))
            pas_x = delta_x / nb_crans
            pas_y = delta_y / nb_crans
            for i in range(nb_crans):
                debut_wheel = _horloge()
                await asyncio.wait_for(page.mouse.wheel(pas_x, pas_y), timeout=5.0)
                duree_wheel = _horloge() - debut_wheel
                if duree_wheel > 0.3:
                    log.warning(
                        f"[camoufox] action_camoufox_scroll() (rapide) : cran {i+1}/{nb_crans} -- "
                        f"page.mouse.wheel(dx={pas_x:.1f}, dy={pas_y:.1f}) LENT -- {duree_wheel:.3f}s"
                    )
            log.info(f"[camoufox] action_camoufox_scroll() (rapide) : TERMINÉ en {_horloge() - debut_total:.3f}s ({nb_crans} cran(s), sans délai)")
            return

        try:
            debut_gen = _horloge()
            bank = _charger_banque_scroll_souris()
            evenements = generate_scroll_events(
                str(get_mouse_data_path()), target_dy=float(delta_y), target_dx=float(delta_x),
                bank=bank, speed_percent=speed_percent,
            )
            log.info(
                f"[camoufox] action_camoufox_scroll() : {len(evenements)} cran(s) généré(s) en "
                f"{(_horloge() - debut_gen) * 1000:.1f}ms -- durée de rejeu prévue="
                f"{sum(ev['dt'] for ev in evenements if ev['dt'] > 0):.3f}s"
            )
        except (TrajectoireSourisIndisponible, ValueError) as exc:
            log.warning(
                f"action_camoufox_scroll() : scroll humanisé indisponible ({exc!r}) -- "
                "repli sur l'ancien comportement (crans réguliers)."
            )
            intervalle_s = 1.0 / max(0.1, float(frequence_crans_par_sec))
            nb_crans = max(1, round(max(abs(delta_x), abs(delta_y)) / WHEEL_DELTA))
            pas_x = delta_x / nb_crans
            pas_y = delta_y / nb_crans
            log.info(f"[camoufox] action_camoufox_scroll() (repli) : {nb_crans} cran(s) réguliers à envoyer, intervalle={intervalle_s:.3f}s")
            for i in range(nb_crans):
                if i > 0:
                    await asyncio.sleep(intervalle_s)
                debut_wheel = _horloge()
                await asyncio.wait_for(page.mouse.wheel(pas_x, pas_y), timeout=5.0)
                duree_wheel = _horloge() - debut_wheel
                if duree_wheel > 0.5:
                    log.warning(f"[camoufox] action_camoufox_scroll() (repli) : cran {i+1}/{nb_crans} -- page.mouse.wheel() LENT ({duree_wheel:.3f}s)")
            log.info(f"[camoufox] action_camoufox_scroll() (repli) : TERMINÉ en {_horloge() - debut_total:.3f}s")
            return

        for i, ev in enumerate(evenements):
            if ev["dt"] > 0:
                await asyncio.sleep(ev["dt"])
            debut_wheel = _horloge()
            # AJOUT : timeout explicite sur CHAQUE cran (absent avant ce
            # patch) -- page.mouse.wheel() n'a jamais eu de garde-fou ici,
            # contrairement à page.screenshot()/page.evaluate() ailleurs
            # dans ce fichier, qui ont tous un asyncio.wait_for. Si un cran
            # se fige (cause encore à déterminer -- ce log le révélera),
            # on lève une TimeoutError explicite au lieu de bloquer
            # silencieusement jusqu'au timeout externe de 20s.
            await asyncio.wait_for(page.mouse.wheel(ev["dx"], ev["dy"]), timeout=5.0)
            duree_wheel = _horloge() - debut_wheel
            if duree_wheel > 0.3:
                log.warning(
                    f"[camoufox] action_camoufox_scroll() : cran {i+1}/{len(evenements)} -- "
                    f"page.mouse.wheel(dx={ev['dx']:.1f}, dy={ev['dy']:.1f}) LENT -- {duree_wheel:.3f}s"
                )
        log.info(f"[camoufox] action_camoufox_scroll() : TERMINÉ en {_horloge() - debut_total:.3f}s ({len(evenements)} cran(s))")
    except asyncio.TimeoutError:
        log.error(
            f"[camoufox] action_camoufox_scroll() : un cran de page.mouse.wheel() a dépassé 5s sans "
            f"répondre (après {_horloge() - debut_total:.3f}s de traitement total) -- Playwright/Firefox "
            f"probablement figé sur cette action"
        )
        raise
    except Exception as exc:
        _camoufox_relever_si_fermeture(exc)
        log.warning(f"[camoufox] action_camoufox_scroll() : échec après {_horloge() - debut_total:.3f}s -- {exc!r}")
        raise


# ---------------------------------------------------------------------------
# Actions clavier / texte -- 4.2 (paste) + étendues (clear, type_text)
# ---------------------------------------------------------------------------

async def _camoufox_clic_simple_focus(page, x: int, y: int) -> None:
    await _camoufox_deplacer_curseur_virtuel(page, x, y)
    await page.mouse.click(x, y)


async def action_camoufox_paste(page, x: int, y: int, texte: str) -> None:
    """paste(x, y, texte) -- insère le texte du presse-papier VIRTUEL de
    cette instance (jamais le presse-papier OS, même contrainte que côté
    nodriver, cf. docstring action_paste). page.keyboard.type() choisi
    plutôt qu'insert_text() : déclenche bien keydown+input+keyup par
    caractère (avec delay=0, quasi instantané), plus proche du
    keyDown->char->keyUp envoyé par le client CDP -- cohérent avec les
    pages qui ont une logique JS sur keydown/keyup (masques de saisie,
    validation en direct)."""
    try:
        await _camoufox_clic_simple_focus(page, x, y)
        await page.keyboard.type(texte, delay=0)
    except Exception as exc:
        _camoufox_relever_si_fermeture(exc)
        raise


async def action_camoufox_clear(page, x: int, y: int) -> None:
    """clear(x, y) -- focus puis Ctrl+A + Delete."""
    try:
        await _camoufox_clic_simple_focus(page, x, y)
        await page.keyboard.press("Control+a")
        await page.keyboard.press("Delete")
    except Exception as exc:
        _camoufox_relever_si_fermeture(exc)
        raise


# PATCH (bug confirmé en usage réel -- traceback utilisateur : "action
# inconnue : dom_paste" sur une instance Camoufox, id_dom='#mobile-composer-
# prompt') : dom_paste/dom_clear étaient déjà listées dans ACTIONS_ETENDUES
# (partagée avec Camoufox, cf. commentaire devant cette constante) mais
# AUCUNE branche elif ni fonction action_camoufox_* correspondante n'avait
# jamais été écrite ici -- malgré une tentative antérieure qui affirmait
# l'avoir fait. Portage réel cette fois : même logique JS que action_dom_
# paste/action_dom_clear côté CDP (même résolution de sélecteur via
# _JS_DOM_RESOUDRE_SELECTEUR, même setter natif value compatible React/Vue,
# mêmes événements input/change déclenchés), mais appelée via page.evaluate()
# de Playwright plutôt que cdp.runtime.evaluate() -- l'argument est passé
# en second paramètre de page.evaluate() (destructuré dans l'arrow
# function), pas interpolé en JSON dans la string comme côté CDP (cf. style
# déjà utilisé par _JS_CAMOUFOX_CURSEUR_ASSURER_ET_DEPLACER plus haut dans
# ce fichier), pour rester cohérent avec le reste du dispatch Camoufox.
_JS_CAMOUFOX_DOM_PASTE = """
([selecteur, texte]) => {
  // BUGFIX (parité avec _JS_DOM_RESOUDRE_SELECTEUR côté CDP) : cette
  // version Camoufox ne découpait jamais la chaîne brute sur "||" --
  // document.querySelector("#a||#b") est un sélecteur CSS invalide, donc
  // échouait TOUJOURS silencieusement (try/catch) dès qu'un id_dom/
  // selecteur à plusieurs candidats était fourni, même si l'un des
  // candidats existait bien seul dans le DOM. Ajout du même découpage
  // "||" + essai dans l'ordre + repli id brut -> #id par candidat, pour
  // que id_dom/selecteur se comporte IDENTIQUEMENT sur Camoufox et CDP.
  function autoniaxResoudreUnSelecteur(s) {
    if (!s) { return null; }
    var el = null;
    try { el = document.querySelector(s); } catch (e) { el = null; }
    if (el) { return el; }
    var ressembleAUnIdBrut = /^[A-Za-z][A-Za-z0-9_-]*$/.test(s);
    if (ressembleAUnIdBrut) {
