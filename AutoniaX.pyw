    }}

    #CelluleBoutonEtiquette {{
        background-color: transparent;
        border: none;
        border-radius: {RADIUS}px;
        padding: 4px;
    }}

    #CelluleBoutonEtiquette:hover {{
        background-color: {DarculaTheme.selection};
    }}

    #CelluleBoutonEtiquette:checked {{
        background-color: transparent;
    }}

    #CelluleIndicateur {{
        font-family: Consolas, monospace;
        font-size: 11px;
        color: {m.subtext0};
