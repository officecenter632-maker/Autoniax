def _diag_log_fingerprint_effectif(profil, source, opts, headless) -> None:
    P = "[PROFIL-DEMARRAGE]"
    d = str(profil) if profil else None
    try:
        resume = _diag_resume_fingerprint(opts, inclure_machine=True)
        _DIAG_DEMARRAGE[profil] = {"source": source, "resume": resume}
        _diag_log(d, "info", f"{P} fingerprint EFFECTIF (source={source!r}, headless={headless!r}) : {len(resume)} valeur(s)")
        for k, v in resume.items():
            _diag_log(d, "info", f"{P} effectif {k} = {v!r}")
        if source != "recharge":
            _diag_log(d, "warning", f"{P} le fingerprint N'EST PAS celui rechargé du profil (source={source!r}) : "
                                    f"l'identité du navigateur change par rapport aux sessions précédentes.")
        if d:
            try:
                with open(os.path.join(d, NOM_MANIFESTE_PROFIL), "r", encoding="utf-8") as f:
                    attendu = (json.load(f) or {}).get("resume_fingerprint") or {}
                comp = {k: v for k, v in resume.items() if k != "_headless"}
                diff = _diag_diff(attendu, comp)
                for ligne in diff:
                    _diag_log(d, "warning", f"{P}[INCOHÉRENCE] fingerprint effectif ≠ fingerprint envoyé -- {ligne}")
                if attendu and not diff:
                    _diag_log(d, "info", f"{P} fingerprint effectif identique à celui du manifeste (envoi).")
            except Exception:
                pass
    except Exception as exc:
        log.warning(f"{P} journal du fingerprint effectif impossible ({exc!r})")


async def camoufox_diag_snapshot_runtime(page, profil, headless) -> None:
    """[PROFIL-DEMARRAGE] -- lit les valeurs RÉELLES dans le navigateur, les compare au fingerprint attendu et au dernier
    démarrage (autre machine ?), puis les enregistre dans autoniax_runtime_snapshot.json (historique des 8 derniers)."""
    P = "[PROFIL-DEMARRAGE]"
    d = str(profil) if profil else None
    try:
        rt = await asyncio.wait_for(page.evaluate(_DIAG_JS_SNAPSHOT), timeout=15.0)
        if not isinstance(rt, dict):
            _diag_log(d, "warning", f"{P} snapshot runtime vide ({rt!r})")
            return
        info = _DIAG_DEMARRAGE.get(profil) or {}
        source, resume = info.get("source"), info.get("resume") or {}
        _diag_log(d, "info", f"{P} RÉEL viewport={rt.get('innerWidth')}x{rt.get('innerHeight')} fenêtre={rt.get('outerWidth')}x{rt.get('outerHeight')} "
                             f"écran={rt.get('screenWidth')}x{rt.get('screenHeight')} dispo={rt.get('availWidth')}x{rt.get('availHeight')} "
                             f"dpr={rt.get('devicePixelRatio')} (headless={headless!r}, source fingerprint={source!r})")
        for k, v in rt.items():
            _diag_log(d, "info", f"{P} réel {k} = {v!r}")
        if source == "repli_minimal":
            _diag_log(d, "warning", f"{P}[INCOHÉRENCE] REPLI MINIMAL actif : AUCUN fingerprint appliqué, viewport/écran/UA = valeurs par défaut du navigateur.")
        if rt.get("webgl") == "AUCUN_CONTEXTE":
            _diag_log(d, "warning", f"{P}[INCOHÉRENCE] AUCUN contexte WebGL dans le navigateur (webgl2={rt.get('webgl2')!r}) alors que le "
                                    f"fingerprint annonce renderer={resume.get('webGl:renderer')!r} : un site qui teste WebGL verra "
                                    f"une machine sans GPU/WebGL (headless sans rendu logiciel ?).")
        nb_cmp = nb_inco = 0
        for cle_rt, cles_fp in _DIAG_ATTENDUS:
            cle_fp = next((c for c in cles_fp if c in resume), None)
            if cle_fp is None:
                continue
            nb_cmp += 1
            if str(resume[cle_fp]) != str(rt.get(cle_rt)):
                nb_inco += 1
                _diag_log(d, "warning", f"{P}[INCOHÉRENCE] {cle_rt}: attendu (fingerprint {cle_fp})={resume[cle_fp]!r} / réel={rt.get(cle_rt)!r}")
        _diag_log(d, "info" if not nb_inco else "warning", f"{P} comparaison fingerprint↔réel : {nb_cmp} valeur(s) comparée(s), {nb_inco} incohérence(s).")
        if not d:
            return
        chemin = os.path.join(d, NOM_SNAPSHOT_RUNTIME)
        try:
            with open(chemin, "r", encoding="utf-8") as f:
                hist = (json.load(f) or {}).get("historique") or []
        except Exception:
            hist = []
        if hist:
            prec = hist[-1]
            for ligne in _diag_diff(prec.get("runtime") or {}, rt):
                _diag_log(d, "warning", f"{P}[CHANGEMENT vs dernier démarrage {prec.get('date')} sur "
                                        f"{(prec.get('machine') or {}).get('hote')}] {ligne}")
            if prec.get("headless") != headless:
                _diag_log(d, "warning", f"{P}[CHANGEMENT] headless : {prec.get('headless')!r} -> {headless!r} (explique souvent un viewport/fenêtre différent).")
        hist.append({"date": time.strftime("%Y-%m-%d %H:%M:%S"), "machine": _diag_info_machine(), "headless": headless,
                     "source": source, "runtime": rt})
        with open(chemin + ".tmp", "w", encoding="utf-8") as f:
            json.dump({"historique": hist[-8:]}, f, ensure_ascii=False)
        os.replace(chemin + ".tmp", chemin)
    except Exception as exc:
        _diag_log(d, "warning", f"{P} snapshot runtime impossible : {exc!r}")



def diag_lire_dernier_demarrage(nom_profil: str, dossier=None):
    """Bouton "copier les logs de démarrage" : retourne (lignes, total) du DERNIER démarrage de ce profil lu dans
    <profil>/autoniax_diag.log, de la ligne "===== démarrage" jusqu'à la fin (viewport réel, comparaison fingerprint,
    incohérences...), précédé du bloc [PROFIL-RESTAURATION] contigu s'il existe (téléchargement juste avant).
    Dossier résolu sur CETTE machine (registre des profils, puis dossier sautoniax_profils). ([], 0) si introuvable."""
    try:
        if dossier is None:
            candidats = []
            try:
                chemin_reg = charger_registre_profils().get(nom_profil)
                if chemin_reg:
                    candidats.append(Path(chemin_reg))
            except Exception:
                pass
            try:
                candidats.append(_chemin_donnees("sautoniax_profils") / _nom_dossier_valide(nom_profil))
            except Exception:
                pass
            dossier = next((c for c in candidats if (c / NOM_JOURNAL_DIAG_PROFIL).is_file()), None)
            if dossier is None:
                return [], 0
        chemin_journal = os.path.join(str(dossier), NOM_JOURNAL_DIAG_PROFIL)
        if not os.path.isfile(chemin_journal):
            return [], 0
        with open(chemin_journal, "r", encoding="utf-8", errors="replace") as f:
            toutes = [l.rstrip("\n") for l in f]
        marque = "[PROFIL-DEMARRAGE] ===== démarrage"
        idx = max((i for i, l in enumerate(toutes) if marque in l), default=None)
        if idx is None:
            return [], len(toutes)
        debut = idx
        while debut > 0 and "[PROFIL-RESTAURATION]" in toutes[debut - 1]:
            debut -= 1
        return toutes[debut:], len(toutes)
    except Exception as exc:
        log.warning(f"[PROFIL-DEMARRAGE] lecture du journal de démarrage impossible ({exc!r})")
        return [], 0


def _diag_resoudre_dossier_profil(nom_profil: str):
    """Dossier du profil sur CETTE machine (registre des profils, puis sautoniax_profils). Préfère un dossier qui
    contient déjà un fingerprint ou un journal ; sinon le premier dossier existant ; None si introuvable."""
    candidats = []
    try:
        chemin_reg = charger_registre_profils().get(nom_profil)
        if chemin_reg:
            candidats.append(Path(chemin_reg))
    except Exception:
        pass
    try:
        candidats.append(_chemin_donnees("sautoniax_profils") / _nom_dossier_valide(nom_profil))
    except Exception:
        pass
    existants = [c for c in candidats if c.is_dir()]
    for c in existants:
        if (c / "camoufox_fingerprint.json").is_file() or (c / NOM_JOURNAL_DIAG_PROFIL).is_file():
            return c
    return existants[0] if existants else None


_DIAG_REGEX_PREFS = re.compile(
    r"width|height|screen|window|dpi|zoom|resist|fingerprint|locale|timezone|geo|proxy|useragent|platform|webgl|"
    r"canvas|font|startup|sessionstore|privacy|network\.http|dom\.(?!.*password)", re.IGNORECASE)


def diag_rapport_profil(nom_profil: str, dossier=None):
    """Bouton "copier les logs" : RAPPORT COMPLET et COMPARABLE (diff entre deux copies d'un même profil) :
    machine, arborescence complète (chemin | octets | sha256), résumé par dossier, fingerprint (TOUTES les clés de
    config, prefs Firefox), cookies (comptes, jamais les valeurs), xulstore.json (taille/position de fenêtre),
    prefs.js/user.js filtrées, derniers snapshots runtime, puis le dernier bloc de démarrage. Les parties comparables
    n'ont ni date ni âge de fichier. Retourne (lignes, total_lignes_du_journal) ; ([], 0) si profil introuvable."""
    try:
        if dossier is None:
            dossier = _diag_resoudre_dossier_profil(nom_profil)
        if dossier is None:
            return [], 0
        dossier = str(dossier)
        L: list = []
        add = L.append
        add(f"===== RAPPORT PROFIL '{nom_profil}' ({time.strftime('%Y-%m-%d %H:%M:%S')}) =====")
        add(f"[DOSSIER] {dossier}")
        add("[MACHINE]")
        for k, v in _diag_info_machine().items():
            add(f"  {k} = {v!r}")

        add("[CONFIG PROFIL] (profils_config.json de CETTE machine, clé = nom du profil)")
        try:
            cfg_p = obtenir_config_profil(nom_profil) or {}
            enregistre = nom_profil in (charger_registre_profils_config() or {})
            ti = cfg_p.get("type_instance")
            moteur_lance = ti if ti in MOTEURS_PLAYWRIGHT else "chrome"
            add(f"  entrée enregistrée sur cette machine : {'oui' if enregistre else 'NON (valeurs par défaut -> chrome)'}")
            add(f"  type_instance = {ti!r} -> moteur qui serait lancé par sAutoniax = {moteur_lance!r}")
            for k in sorted(cfg_p):
                v = cfg_p[k]
                if isinstance(v, dict):
                    v = {kk: vv for kk, vv in v.items() if kk != "password"}
                add(f"  {k} = {v!r}")
        except Exception as exc:
            add(f"  illisible : {exc!r}")
        racine_fichiers = set()
        try:
            racine_fichiers = set(os.listdir(dossier))
        except OSError:
            pass
        indices_firefox = [n for n in ("prefs.js", "xulstore.json", "cookies.sqlite", "places.sqlite", "camoufox_fingerprint.json")
                           if n in racine_fichiers]
        indices_chrome = [n for n in ("Default", "Local State", "Last Version", "GPUPersistentCache", "SingletonSocket")
                          if n in racine_fichiers]
        add(f"[MOTEURS SUR DISQUE] Firefox/Camoufox : {'OUI' if indices_firefox else 'non'} {indices_firefox} ; "
            f"Chrome : {'OUI' if indices_chrome else 'non'} {indices_chrome}")
        if indices_firefox and indices_chrome:
            add("  >>> ALERTE : ce dossier a été utilisé par DEUX moteurs (Camoufox ET Chrome). Le profil a été lancé avec un "
                "moteur différent de celui d'origine -> autre viewport/fingerprint (Chrome ignore camoufox_fingerprint.json).")

        scan = _diag_scanner_profil(dossier)
        add(f"[ARBORESCENCE] {scan['nb']} fichier(s) suivis, {scan['total'] / 1048576:.1f} Mo au total "
            f"(+{scan['ignores_nb']} fichier(s) de cache ignorés) -- format : chemin | octets | sha256[:12] ('-' si > 2 Mo)")
        verrous = [n for n in ("lock", ".parentlock", "parent.lock") if os.path.lexists(os.path.join(dossier, n))]
        add(f"[VERROUS] {verrous if verrous else 'aucun'}")
        par_dossier: dict = {}
        for rel, v in scan["fichiers"].items():
            haut = rel.split("/")[0] if "/" in rel else "(racine)"
            nb, tot = par_dossier.get(haut, (0, 0))
            par_dossier[haut] = (nb + 1, tot + v["t"])
        add("[RESUME PAR DOSSIER] dossier : nb fichiers, octets")
        for haut in sorted(par_dossier):
            add(f"  {haut} : {par_dossier[haut][0]}, {par_dossier[haut][1]}")
        add("[FICHIERS]")
        triees = sorted(scan["fichiers"].items())
        for rel, v in triees[:2500]:
            add(f"  {rel} | {v['t']} | {(v['h'] or '-')[:12]}")
        if len(triees) > 2500:
            add(f"  ... {len(triees) - 2500} fichier(s) non listés (plafond 2500)")

        opts = _diag_lire_fingerprint(dossier)
        add("[FINGERPRINT]")
        if opts is None:
            add("  ABSENT ou illisible (camoufox_fingerprint.json)")
        else:
            add(f"  clés top-level : {sorted(opts.keys())}")
            for cle in ("executable_path", "user_data_dir", "headless"):
                add(f"  {cle} = {opts.get(cle)!r}")
            proxy = opts.get("proxy") or {}
            add(f"  proxy = server={proxy.get('server')!r} username={proxy.get('username')!r}")
            for k, v in sorted((opts.get("firefox_user_prefs") or {}).items()):
                add(f"  firefox_user_prefs {k} = {v!r}")
            cfg = _camoufox_extraire_config_brute(opts) or {}
            add(f"  CONFIG BrowserForge/Camoufox : {len(cfg)} clé(s)")
            for k in sorted(cfg, key=str):
                v = cfg[k]
                if isinstance(v, (list, tuple, dict)):
                    brut = json.dumps(v, sort_keys=True, ensure_ascii=False, default=str)
                    import hashlib as _hl
                    add(f"    {k} = <{type(v).__name__}:{len(v)} sha={_hl.sha256(brut.encode('utf-8')).hexdigest()[:10]}>")
                else:
                    sv = str(v)
                    add(f"    {k} = {sv if len(sv) <= 160 else sv[:157] + '...'}")

        add("[COOKIES]")
        add(f"  cookies.sqlite : {_diag_compter_cookies_sqlite(dossier)}")
        add(f"  {NOM_FICHIER_COOKIES_PROFIL} : {_diag_resume_cookies_json(dossier)}")

        add("[XULSTORE] (taille/position de fenêtre mémorisées par Firefox)")
        try:
            chemin_xul = os.path.join(dossier, "xulstore.json")
            if os.path.isfile(chemin_xul) and os.path.getsize(chemin_xul) <= 20000:
                with open(chemin_xul, "r", encoding="utf-8", errors="replace") as f:
                    add("  " + f.read().replace("\n", " "))
            else:
                add("  absent (ou > 20 Ko)")
        except Exception as exc:
            add(f"  illisible : {exc!r}")

        for nom_pref in ("prefs.js", "user.js"):
            add(f"[{nom_pref.upper()}] lignes pertinentes (taille/écran/fenêtre/langue/proxy/vie privée...)")
            try:
                chemin_pref = os.path.join(dossier, nom_pref)
                if not os.path.isfile(chemin_pref):
                    add("  absent")
                    continue
                n = 0
                with open(chemin_pref, "r", encoding="utf-8", errors="replace") as f:
                    for ligne in f:
                        ligne = ligne.strip()
                        if ligne.startswith(("user_pref", "pref")) and _DIAG_REGEX_PREFS.search(ligne) \
                                and "password" not in ligne.lower():
                            add("  " + (ligne if len(ligne) <= 220 else ligne[:217] + "..."))
                            n += 1
                            if n >= 200:
                                add("  ... plafond 200 lignes")
                                break
                if n == 0:
                    add("  (aucune ligne pertinente)")
            except Exception as exc:
                add(f"  illisible : {exc!r}")

        add("[SNAPSHOTS RUNTIME] (valeurs réelles lues dans le navigateur, 2 derniers démarrages)")
        try:
            with open(os.path.join(dossier, NOM_SNAPSHOT_RUNTIME), "r", encoding="utf-8") as f:
                hist = (json.load(f) or {}).get("historique") or []
            if not hist:
                add("  aucun")
            for h in hist[-2:]:
                mach = h.get("machine") or {}
                add(f"  --- {h.get('date')} sur {mach.get('hote')} ({mach.get('os')}) headless={h.get('headless')!r} "
                    f"source={h.get('source')!r}")
                for k, v in sorted((h.get("runtime") or {}).items()):
                    add(f"    {k} = {v!r}")
        except FileNotFoundError:
            add("  aucun (profil jamais démarré avec le diagnostic)")
        except Exception as exc:
            add(f"  illisible : {exc!r}")

        # DERNIÈRES OPÉRATIONS d'envoi/téléchargement journalisées (même si elles ne sont pas collées au démarrage)
        journal_lignes: list = []
        try:
            with open(os.path.join(dossier, NOM_JOURNAL_DIAG_PROFIL), "r", encoding="utf-8", errors="replace") as f:
                journal_lignes = [l.rstrip("\n") for l in f]
        except OSError:
            pass
        for titre, tag, debut_bloc, absent in (
            ("[DERNIERE RESTAURATION] (téléchargement + extraction, avec contrôle d'intégrité)", "[PROFIL-RESTAURATION]",
             "extrait dans", "aucune restauration journalisée : profil jamais téléchargé avec ce patch, ou dossier réutilisé "
                             "sans téléchargement (téléchargement non forcé)."),
            ("[DERNIERE SAUVEGARDE] (inventaire avant zip d'envoi)", "[PROFIL-SAUVEGARDE]",
             "fichier(s) suivi(s)", "aucune sauvegarde journalisée : profil jamais envoyé depuis cette machine avec ce patch."),
        ):
            add(titre)
            i_debut = max((i for i, l in enumerate(journal_lignes) if tag in l and debut_bloc in l), default=None)
            if i_debut is None:
                add("  " + absent)
                continue
            bloc = [l for l in journal_lignes[i_debut:] if tag in l]
            L.extend("  " + l for l in bloc[:150])
            if len(bloc) > 150:
                add(f"  ... {len(bloc) - 150} ligne(s) non listées")
        lignes_dem, total_journal = diag_lire_dernier_demarrage(nom_profil, dossier)
        add("[DERNIER DEMARRAGE] (journal autoniax_diag.log)")
        if lignes_dem:
            L.extend("  " + l for l in lignes_dem)
        else:
            add("  aucun bloc de démarrage dans le journal")
        add("===== FIN DU RAPPORT =====")
        return L, total_journal
    except Exception as exc:
        log.warning(f"[PROFIL-DEMARRAGE] rapport complet impossible ({exc!r})")
        return [f"Rapport impossible : {exc!r}"], 0


async def _camoufox_creer_contexte(
    profil: Optional[str], instance_id: str, headless: bool,
    proxy: Optional[dict], nom_profil: Optional[str] = None,
):
    """PATCH CloakBrowser -- bloc de création du contexte Camoufox, extrait
    TEL QUEL de camoufox_demarrer_navigateur (fingerprint BrowserForge persisté,
    geoip, repli minimal) pour que celle-ci puisse choisir entre Camoufox et
    CloakBrowser. Retourne (camoufox_cm, context)."""
    if not CAMOUFOX_DISPONIBLE:
        raise RuntimeError(
            "camoufox_demarrer_navigateur() : le package 'camoufox' n'est pas installé "
            "dans cet interpréteur (pip install -U camoufox[geoip] && python -m camoufox fetch)."
        )

    chemin_fingerprint = _camoufox_chemin_fingerprint(profil)
    fingerprint_source = None  # "recharge" | "genere" | None (repli minimal) -- pour le log final
    _diag_log_debut_demarrage(profil, chemin_fingerprint, headless, proxy, instance_id, nom_profil)
    try:
        opts_from_options = None

        if chemin_fingerprint is not None and chemin_fingerprint.exists():
            # Relance sur un profil déjà fingerprinté -- on recharge le
            # JSON tel quel plutôt que de regénérer, cf. docstring
            # ci-dessus. Si le fichier est corrompu/illisible, on retombe
            # sur une régénération plutôt que de faire planter le
            # lancement pour un fichier de cache.
            try:
                opts_from_options = json.loads(chemin_fingerprint.read_text(encoding="utf-8"))
                fingerprint_source = "recharge"
                # CORRECTIF (profils EXISTANTS, créés avant ce patch) --
                # sans cet appel, un fingerprint déjà sauvegardé sur disque
                # serait rechargé "tel quel" pour toujours (cf. commentaire
                # ci-dessus) et ne recevrait donc JAMAIS navigator.language/
                # navigator.languages, même après le patch. Idempotent
                # (cf. docstring de _camoufox_forcer_langue_navigateur) --
                # ne fait rien si locale:language est déjà absent (pas de
                # proxy à l'origine) ou si les clés sont déjà présentes.
                # BUGFIX (comparaison préexistante, cf. discussion) :
                # opts_from_options.get("config") n'est PAS une clé de
                # premier niveau du dict retourné par launch_options() (cf.
                # docstring de _camoufox_extraire_config_brute -- le vrai
                # config est encodé en morceaux dans opts["env"]
                # ["CAMOU_CONFIG_N"]) -- comparer sur "config" valait donc
                # TOUJOURS "{}" == "{}" ci-dessous, quel que soit le
                # changement réel effectué par _camoufox_forcer_langue_
                # navigateur/_camoufox_forcer_humanize (qui modifient bien
                # opts_from_options["env"] en mémoire -- donc la session en
                # cours utilisait déjà la bonne valeur -- mais la
                # condition de réécriture disque juste en dessous ne se
                # déclenchait jamais, silencieusement). Compare maintenant
                # la config brute réellement lue/écrite par ces deux
                # fonctions.
                avant = json.dumps(_camoufox_extraire_config_brute(opts_from_options), sort_keys=True)
                opts_from_options = _camoufox_forcer_langue_navigateur(opts_from_options)
                # DIAGNOSTIC (TEST DIAG 5) : même piège que navigator.language
                # ci-dessus -- un fingerprint déjà sauvegardé sur disque avec
                # humanize=True serait rechargé "tel quel" pour toujours sans
                # cet appel, quelle que soit la valeur de
                # CAMOUFOX_HUMANIZE_ACTIF (cf. docstring de
                # _camoufox_forcer_humanize). Idempotent -- no-op si la
                # valeur cible est déjà en place.
                opts_from_options = _camoufox_forcer_humanize(opts_from_options)
                # PATCH (taille de fenêtre) -- même raison : un fingerprint
                # sauvegardé garde son ancienne taille aléatoire pour toujours
                # sans cet appel. Idempotent, no-op si CAMOUFOX_TAILLE_FENETRE = None.
                opts_from_options = _camoufox_forcer_taille_fenetre(opts_from_options, CAMOUFOX_TAILLE_FENETRE)
                apres = json.dumps(_camoufox_extraire_config_brute(opts_from_options), sort_keys=True)
                # BUG CORRIGÉ (le tout premier patch de ce correctif ne
                # faisait ce forçage qu'EN MÉMOIRE, pour cette session --
                # le fichier fingerprint.json sur disque restait
                # non corrigé. Deux conséquences concrètes : (1) l'onglet
                # Propriétés du Dashboard, qui relit ce fichier DIRECTEMENT
                # sur disque via l'action "get_fingerprint" (cf.
                # _session_camoufox_minimale, sans jamais repasser par
                # cette fonction-ci), continuait d'afficher l'ancienne
                # valeur non corrigée ; (2) à chaque relance suivante, le
                # correctif devait être réappliqué depuis zéro plutôt que
                # d'être définitivement acquis pour ce profil. Réécrit
                # donc le JSON UNIQUEMENT si le forçage a réellement changé
                # quelque chose (évite une écriture disque inutile pour
                # les profils sans proxy/geoip, où la fonction est un
                # no-op, cf. sa docstring).
                if apres != avant:
                    try:
                        chemin_fingerprint.write_text(
                            json.dumps(opts_from_options, indent=2), encoding="utf-8"
                        )
                    except OSError as exc_ecriture:
                        log.warning(
                            f"[camoufox] échec de réécriture du fingerprint (correctif "
                            f"langue) pour le profil '{profil}' ({exc_ecriture!r}) -- "
                            f"le correctif reste actif pour cette session uniquement, "
                            f"l'onglet Propriétés du Dashboard peut afficher l'ancienne "
                            f"valeur tant que l'écriture échoue."
                        )
            except (OSError, ValueError) as exc:
                log.warning(
                    f"[camoufox] fingerprint.json illisible pour le profil "
                    f"'{profil}' ({exc!r}) -- régénération."
                )
                opts_from_options = None

            # CORRECTIF (bug identifié via les logs [diag-proxy] ajoutés
            # précédemment : un fingerprint rechargé "tel quel" ignore
            # TOUJOURS le paramètre `proxy` reçu par cette fonction, cf.
            # commentaire "Relance sur un profil déjà fingerprinté"
            # ci-dessus -- si ce profil a été fingerprinté avant qu'un
            # proxy ne soit configuré dessus, ou si le proxy a changé
            # depuis (nouveau proxy, rotation...), l'instance se relançait
            # SILENCIEUSEMENT sans proxy, ou avec l'ancien, alors qu'un
            # proxy différent était explicitement demandé -- symptôme
            # observé : "le navigateur ne se connecte pas à internet".)
            #
            # BUG CORRIGÉ (dans CE correctif lui-même, cf. logs -- la toute
            # première version cherchait le proxy dans
            # _camoufox_extraire_config_brute(opts_from_options), c'est-à-
            # dire DANS le fingerprint BrowserForge encodé en morceaux
            # env["CAMOU_CONFIG_N"] -- le proxy Playwright n'y a JAMAIS été,
            # ce n'est pas là que camoufox.utils.launch_options()/AsyncCamoufox
            # le placent. Vérifié en relisant le code déjà existant plus
            # haut dans ce fichier (cf. _camoufox_extraire_proprietes_fingerprint,
            # "Adresse du proxy" : `opts_from_options.get("proxy")`, une clé
            # de PREMIER NIVEAU du dict, séparée du fingerprint BrowserForge
            # -- confirmé aussi par les logs [diag-proxy] : "clés top-level
            # de opts_from_options=[..., 'proxy', ...]"). Chercher au
            # mauvais endroit faisait toujours lire un dict vide -> fausse
            # détection d'incohérence -> régénération du fingerprint à
            # CHAQUE lancement, même quand le proxy était déjà correct.
            # Corrigé : on lit maintenant `opts_from_options.get("proxy")`
            # directement, comme le fait déjà le code d'affichage des
            # propriétés.
            if opts_from_options is not None:
                proxy_dans_json = opts_from_options.get("proxy") or {}
                proxy_demande_normalise = None
                if proxy and proxy.get("host"):
                    port_demande = proxy.get("port") or 8080
                    proxy_demande_normalise = {
                        "server": f"{proxy.get('protocole') or 'http'}://{proxy['host']}:{port_demande}",
                        "username": proxy.get("user") or None,
                    }
                proxy_json_normalise = None
                if proxy_dans_json.get("server"):
                    proxy_json_normalise = {
                        "server": proxy_dans_json.get("server"),
                        "username": proxy_dans_json.get("username") or None,
                    }
                if proxy_demande_normalise != proxy_json_normalise:
                    log.warning(
                        f"[camoufox][diag-proxy] fingerprint rechargé pour le profil "
                        f"'{profil}' ne correspond PAS au proxy actuellement demandé -- "
                        f"proxy demandé={proxy_demande_normalise!r}, proxy dans le "
                        f"fingerprint={proxy_json_normalise!r}. Fingerprint jeté, "
                        f"RÉGÉNÉRATION forcée avec le proxy actuel (nouveau device/"
                        f"police/WebGL via BrowserForge, geoip recalculé)."
                    )
                    opts_from_options = None
                    fingerprint_source = None
                else:
                    log.info(
                        f"[camoufox][diag-proxy] fingerprint rechargé pour le profil "
                        f"'{profil}' -- proxy cohérent avec la demande "
                        f"({proxy_json_normalise!r}), pas de régénération."
                    )

        # PATCH (hauteur d'écran minimale) -- un fingerprint déjà sauvegardé dont
        # l'écran est trop bas est jeté et régénéré (le nouveau écrase l'ancien).
        if opts_from_options is not None:
            _h_ok, _h_val = _camoufox_hauteur_ecran_ok(opts_from_options)
            if not _h_ok:
                log.warning(
                    f"[camoufox] fingerprint rechargé pour le profil '{profil}' : "
                    f"hauteur d'écran {_h_val} < {CAMOUFOX_HAUTEUR_ECRAN_MIN} -- "
                    f"fingerprint jeté, RÉGÉNÉRATION."
                )
                opts_from_options = None
                fingerprint_source = None

        if opts_from_options is None:
            if camoufox_launch_options is None:
                raise RuntimeError(
                    "camoufox.utils.launch_options indisponible (import échoué) -- "
                    "impossible de générer un fingerprint persistant."
                )
            config_fingerprint = _camoufox_construire_config_lancement(profil, proxy)
            # PATCH (retour utilisateur explicite : "parfois les donnee
            # recrit ne corespond pas avec les donnee reels" -- cf.
            # docstring complète de _verifier_resolution_respecte_contraintes
            # pour le diagnostic exact) -- REMPLACE l'ancien comportement
            # (un seul retry SANS la contrainte "screen" en cas
            # d'EXCEPTION explicite, et surtout : AUCUNE vérification si
            # launch_options() réussissait sans lever d'exception, alors
            # que BrowserForge peut très bien "réussir" tout en ayant
            # silencieusement abandonné la contrainte en interne --
            # cf. browserforge/fingerprints/generator.py, FingerprintGenerator.
            # generate() : `strict=False` par défaut, jamais changé par
            # camoufox.utils.launch_options() -- c'est la cause racine
            # confirmée par lecture du code source de browserforge 1.2.4).
            #
            # Nouveau comportement (décision explicite utilisateur :
            # "bloquant, regenerer automatiquement... echouer proprement
            # apres N essais") : génère jusqu'à RETRY_MAX_CONTRAINTE_ECRAN
            # fois, en vérifiant RÉELLEMENT à chaque essai (via
            # _verifier_resolution_respecte_contraintes, qui relit
            # screen.width/height dans le résultat déjà généré) si la
            # contrainte demandée est respectée -- s'arrête au premier
            # essai qui la respecte. Si `contraintes_ecran` n'a rien
            # demandé (cas normal, immense majorité des profils), la
            # vérification est un no-op ((True, None, None) immédiat, cf.
            # docstring) et la boucle s'arrête au premier essai comme
            # avant -- AUCUN changement de comportement/performance pour
            # un profil sans contrainte de résolution.
            RETRY_MAX_CONTRAINTE_ECRAN = 20  # (8 avant le patch hauteur min : relevé car Linux a ~16 % de tirages < 1000)
            contraintes_ecran_demandees = (
                obtenir_config_profil(profil).get("contraintes_ecran") if profil else None
            )
            opts_from_options = None
            dernier_essai_hauteur = dernier_essai_largeur = None
            echec_hauteur_min = None
            for tentative in range(1, RETRY_MAX_CONTRAINTE_ECRAN + 1):
                try:
                    candidat = camoufox_launch_options(
                        headless=headless,
                        user_data_dir=profil,
                        **config_fingerprint,
                    )
                except Exception as exc_screen:
                    # Exception EXPLICITE de launch_options()/BrowserForge
                    # (ex. bornes incohérentes détectées par Screen.__post_init__,
                    # ou strict=True quelque part en amont) -- distincte du
                    # repli SILENCIEUX vérifié ci-dessous. Comportement
                    # inchangé pour ce cas précis : un seul retry SANS la
                    # contrainte plutôt que de faire échouer la création du
                    # profil entier pour ce seul motif (une contrainte
                    # incohérente ne se "corrigera" pas en réessayant).
                    if "screen" in config_fingerprint:
                        log.warning(
                            f"[camoufox] échec de génération avec la contrainte de résolution "
                            f"pour le profil '{profil}' ({exc_screen!r}) -- nouvelle tentative "
                            f"SANS contrainte de résolution (résolution laissée aléatoire)."
                        )
                        config_fingerprint.pop("screen", None)
                        opts_from_options = camoufox_launch_options(
                            headless=headless,
                            user_data_dir=profil,
                            **config_fingerprint,
                        )
                        break
                    else:
                        raise

                ok, dernier_essai_hauteur, dernier_essai_largeur = _verifier_resolution_respecte_contraintes(
                    contraintes_ecran_demandees, candidat,
                )
                if ok:
                    # PATCH (hauteur d'écran minimale) -- régénère si trop bas.
                    _h_ok, _h_val = _camoufox_hauteur_ecran_ok(candidat)
                    if not _h_ok:
                        echec_hauteur_min = _h_val
                        log.warning(
                            f"[camoufox] tentative {tentative}/{RETRY_MAX_CONTRAINTE_ECRAN} pour le "
                            f"profil '{profil}' : hauteur d'écran {_h_val} < "
                            f"{CAMOUFOX_HAUTEUR_ECRAN_MIN} -- nouvel essai."
                        )
                        continue
                    opts_from_options = candidat
                    if tentative > 1:
                        log.info(
                            f"[camoufox] contrainte de résolution respectée pour le profil "
                            f"'{profil}' à la tentative {tentative}/{RETRY_MAX_CONTRAINTE_ECRAN} "
                            f"(résolution obtenue : {dernier_essai_largeur}x{dernier_essai_hauteur})."
                        )
                    break
                log.warning(
                    f"[camoufox] tentative {tentative}/{RETRY_MAX_CONTRAINTE_ECRAN} pour le profil "
                    f"'{profil}' : BrowserForge a silencieusement ignoré la contrainte de "
                    f"résolution demandée (résolution obtenue : "
                    f"{dernier_essai_largeur}x{dernier_essai_hauteur}, contrainte="
                    f"{contraintes_ecran_demandees!r}) -- nouvel essai."
                )

            if opts_from_options is None:
                # Toutes les tentatives ont produit une résolution hors
                # contrainte -- ÉCHEC PROPRE (décision explicite
                # utilisateur), plus de repli silencieux sur une
                # résolution aléatoire : mieux vaut un profil qui échoue
                # clairement à la création qu'un profil silencieusement
                # incohérent avec le filtre affiché à l'écran.
                if echec_hauteur_min is not None and not contraintes_ecran_demandees:
                    message_echec = (
                        f"Impossible de générer un écran de hauteur >= {CAMOUFOX_HAUTEUR_ECRAN_MIN} "
                        f"pour le profil '{profil}' après {RETRY_MAX_CONTRAINTE_ECRAN} tentatives "
                        f"(dernière hauteur obtenue : {echec_hauteur_min})."
                    )
                else:
                    message_echec = (
                      f"Impossible de générer une résolution d'écran respectant la contrainte "
                      f"{contraintes_ecran_demandees!r} pour le profil '{profil}' après "
                      f"{RETRY_MAX_CONTRAINTE_ECRAN} tentatives (dernière résolution obtenue : "
                      f"{dernier_essai_largeur}x{dernier_essai_hauteur}) -- cette contrainte n'a "
                      f"probablement aucune correspondance dans le jeu de données BrowserForge "
                      f"pour les autres attributs tirés (OS/user-agent). Essayez une contrainte "
                      f"moins restrictive (ex. une plage plus large plutôt qu'une valeur exacte)."
                  )
                log.error(f"[camoufox] {message_echec}")
                raise RuntimeError(message_echec)
            # CORRECTIF (demande utilisateur explicite : la langue du
            # navigateur doit suivre AUTOMATIQUEMENT le pays du proxy,
            # cf. _camoufox_forcer_langue_navigateur) -- appelé ICI, avant
            # la sauvegarde JSON juste en dessous, pour que le fingerprint
            # persisté sur disque contienne déjà navigator.language/
            # navigator.languages cohérents : un seul calcul à la
            # génération, jamais recalculé aux relances suivantes (qui
            # rechargent ce même JSON tel quel, cf. branche "recharge"
            # au-dessus -- même philosophie que le reste du fingerprint).
            opts_from_options = _camoufox_forcer_langue_navigateur(opts_from_options)
            fingerprint_source = "genere"
            if chemin_fingerprint is not None:
                try:
                    chemin_fingerprint.write_text(
                        json.dumps(opts_from_options, indent=2), encoding="utf-8"
                    )
                except OSError as exc:
                    # Pas bloquant : le navigateur peut démarrer même si
                    # la sauvegarde échoue (disque plein, permissions...)
                    # -- seule la persistance d'une relance à l'autre est
                    # perdue, journalisé pour ne pas être silencieux.
                    log.warning(
                        f"[camoufox] échec de sauvegarde du fingerprint pour le "
                        f"profil '{profil}' ({exc!r}) -- persistance non garantie "
                        f"à la prochaine relance."
                    )

        # DIAGNOSTIC (retour utilisateur : le navigateur camoufox ne se
        # connecte pas à internet) -- vérifie, juste avant l'appel réel à
        # AsyncCamoufox, si le proxy est bien présent dans le fingerprint
        # qu'on s'apprête à utiliser (que ce fingerprint vienne d'être
        # rechargé depuis le JSON du profil OU tout juste généré). Le
        # proxy Playwright est une clé de PREMIER NIVEAU de opts_from_options
        # (opts_from_options["proxy"], PAS dans le fingerprint BrowserForge
        # encodé en morceaux env["CAMOU_CONFIG_N"] -- cf. correctif plus
        # haut dans cette même fonction, où la même confusion avait
        # d'abord été faite par erreur, corrigée en relisant
        # _camoufox_extraire_proprietes_fingerprint qui lit déjà
        # correctement `opts_from_options.get("proxy")`).
        proxy_dans_fingerprint = opts_from_options.get("proxy")
        log.info(
            f"[camoufox][diag-proxy] camoufox_demarrer_navigateur : sur le point "
            f"d'appeler AsyncCamoufox -- fingerprint_source={fingerprint_source!r}, "
            f"proxy argument reçu par cette fonction={ {k: v for k, v in (proxy or {}).items() if k != 'password'} if proxy else None }, "
            f"proxy RÉELLEMENT présent dans le fingerprint utilisé={ {k: v for k, v in proxy_dans_fingerprint.items() if k != 'password'} if proxy_dans_fingerprint else None }, "
            f"clés top-level de opts_from_options={sorted(opts_from_options.keys())}."
        )
        if proxy and proxy.get("host") and not proxy_dans_fingerprint:
            log.warning(
                f"[camoufox][diag-proxy] INCOHÉRENCE DÉTECTÉE : un proxy "
                f"({proxy.get('host')}:{proxy.get('port')}) a été demandé pour "
                f"cette instance, mais le fingerprint {fingerprint_source!r} qui va "
                f"réellement être utilisé par AsyncCamoufox n'en contient AUCUN -- "
                f"probable fingerprint.json généré AVANT la configuration du proxy "
                f"sur ce profil (cf. _camoufox_chemin_fingerprint : {chemin_fingerprint}). "
                f"L'instance va très probablement se lancer et sortir par l'IP RÉELLE "
                f"de la machine, pas par le proxy -- c'est une cause plausible d'un "
                f"navigateur qui 'ne se connecte pas à internet' si le proxy est "
                f"obligatoire côté réseau/pare-feu. Supprimez ce fichier fingerprint "
                f"pour forcer une régénération avec le proxy actuel."
            )

        # CORRECTIF (logs Kaggle -- fingerprint rechargé depuis un profil
        # zippé sur une AUTRE machine contient "executable_path" en dur,
        # pointant vers le cache Camoufox de la machine d'origine, ex.
        # "C:\Users\...\camoufox.exe" sur Windows -- inexistant sur
        # Kaggle/Linux. AsyncCamoufox échouait alors sur CE chemin précis
        # ("Failed to launch firefox because executable doesn't exist"),
        # perdant tout le fingerprint robuste (proxy, device, geoip...)
        # pour un simple problème de portabilité entre machines, avant
        # même d'atteindre le repli minimal. "executable_path" n'a aucune
        # raison d'être persisté tel quel dans le profil : chaque machine
        # a son propre binaire fetché localement (cf. `camoufox fetch` en
        # tête de notebook).
        #
        # RÉGRESSION (logs Kaggle suivants) : un premier correctif
        # RETIRAIT executable_path (pop) pour laisser Camoufox "détecter
        # son propre binaire local" -- mais en son absence,
        # AsyncCamoufox/Playwright retombe sur SON propre défaut interne
        # (le Firefox stock de Playwright, jamais téléchargé ici puisqu'on
        # utilise le binaire Camoufox patché via `camoufox fetch`, pas
        # `playwright install firefox`), d'où "Executable doesn't exist at
        # /root/.cache/ms-playwright/firefox-1522/firefox/firefox" --
        # PAS le chemin voulu (~/.cache/camoufox/browsers/official/.../
        # camoufox-bin, celui réellement présent et vérifié par ldd dans
        # le notebook). Un dict from_options avec persistent_context=True
        # ne laisse PAS Camoufox recalculer lui-même executable_path,
        # contrairement à une génération fraîche sans from_options.
        #
        # CORRECTIF (celui-ci) : on REMPLACE la valeur (ou on l'AJOUTE si
        # absente -- cf. PATCH ci-dessous) au lieu de la retirer, avec
        # camoufox.pkgman.launch_path() -- l'API officielle du package qui
        # résout le chemin exact du binaire Camoufox fetché SUR CETTE
        # machine (get_path(LAUNCH_FILE[OS_NAME]) en interne, même logique
        # que le glob camoufox-bin déjà vérifié par ldd dans le notebook).
        # Lève CamoufoxNotInstalled (sous-classe de FileNotFoundError, donc
        # capturée par le `except Exception` ci-dessous) si `camoufox
        # fetch` n'a pas été fait sur cette machine -- déclenche alors
        # proprement le repli minimal existant plutôt qu'un crash confus.
        #
        # PATCH (bug constaté : profil sauvegardé SANS executable_path du
        # tout dans son fingerprint -- ex. généré sur une machine où le
        # champ n'avait jamais été explicité -- cf. logs Kaggle : aucune
        # ligne "[camoufox] fingerprint rechargé ... executable_path"
        # n'apparaît, la condition `"executable_path" in opts_from_options`
        # est FAUSSE, ce bloc entier était sauté silencieusement, et
        # AsyncCamoufox retombait sur le Firefox stock de Playwright
        # jamais téléchargé -- même symptôme et même cause que la
        # régression documentée plus haut, juste un chemin différent pour
        # y arriver). `"executable_path" in opts_from_options` DEVIENT
        # `opts_from_options is not None` tout court : ce champ doit
        # TOUJOURS être forcé vers le binaire Camoufox local, qu'il soit
        # déjà présent dans le fingerprint ou non -- même raisonnement
        # exact que user_data_dir/headless juste en dessous, qui eux ne
        # sont JAMAIS conditionnés à leur présence préalable. Objectif de
        # cette fonction : préserver le fingerprint (résolution, user
        # agent, etc.), jamais le chemin de binaire, qui n'a par nature
        # aucune raison d'être portable d'une machine à l'autre.
        if opts_from_options is not None:
            chemin_origine = opts_from_options.get("executable_path")
            try:
                from camoufox.pkgman import launch_path as _camoufox_launch_path
                chemin_local = _camoufox_launch_path()
                opts_from_options["executable_path"] = chemin_local
                log.info(
                    f"[camoufox] fingerprint rechargé pour le profil '{profil}' -- "
                    f"executable_path d'origine ({chemin_origine!r}, absent="
                    f"{chemin_origine is None}) spécifique à une autre machine (ou "
                    f"absent du fingerprint), remplacé/forcé vers le binaire Camoufox "
                    f"réellement présent sur CETTE machine ({chemin_local!r})."
                )
            except Exception as exc_chemin:
                # Le binaire Camoufox n'est pas fetché sur cette machine
                # (CamoufoxNotInstalled) ou camoufox.pkgman n'est pas
                # importable pour une autre raison -- on retire quand même
                # la clé plutôt que de garder un chemin d'une autre
                # machine à coup sûr invalide, et on laisse le except
                # Exception englobant plus bas gérer un éventuel échec
                # réel d'AsyncCamoufox (repli minimal).
                opts_from_options.pop("executable_path", None)
                log.warning(
                    f"[camoufox] fingerprint rechargé pour le profil '{profil}' -- "
                    f"executable_path d'origine ({chemin_origine!r}) invalide sur "
                    f"cette machine, ET impossible de résoudre le binaire local via "
                    f"camoufox.pkgman.launch_path() ({exc_chemin!r}) -- clé retirée, "
                    f"AsyncCamoufox tentera sa propre détection par défaut (probable "
                    f"repli sur le Firefox stock de Playwright si absent)."
                )

        # CORRECTIF (logs Kaggle -- même famille de bug que executable_path
        # ci-dessus, sur un champ différent) : "user_data_dir" N'EST PAS un
        # paramètre nommé de camoufox.utils.launch_options() -- il tombe
        # dans son **launch_options fourre-tout et est donc étalé TEL QUEL
        # dans le dict JSON retourné/sauvegardé (vérifié en lisant
        # camoufox/utils.py). Résultat concret observé dans les logs :
        # "-profile /kaggle/working/D:\ScaleTube\CHANNELS\IngeniaX\Code\
        # AutoniaX\Data\profils\camoufox_claude" -- Playwright a reçu le
        # chemin WINDOWS D'ORIGINE (figé dans le fingerprint depuis la
        # toute première génération sur la machine de dev), l'a jugé "non
        # absolu" au sens POSIX (pas de '/' en tête -- un chemin
        # "D:\...\" n'a aucun sens pour os.path sous Linux) et l'a
        # concaténé au répertoire de travail courant, produisant ce
        # chemin hybride absurde. Sur la branche "rechargé"
        # (AsyncCamoufox(from_options=..., persistent_context=True), SANS
        # user_data_dir=profil séparé, cf. ligne plus bas où from_options
        # est bien le SEUL argument passé), rien ne vient jamais écraser
        # cette valeur figée par le chemin RÉEL et actuel du profil sur
        # cette machine (`profil`, déjà résolu correctement plus haut par
        # l'appelant, cf. logs : "profil ... déjà présent localement
        # (/kaggle/working/...)"). On force donc explicitement
        # opts_from_options["user_data_dir"] = profil à chaque rechargement
        # -- exactement la même logique que executable_path : le chemin du
        # profil est par nature propre à CHAQUE machine, il n'a aucune
        # raison d'être persisté dans le fingerprint partagé entre
        # machines.
        if opts_from_options is not None and profil is not None:
            user_data_dir_origine = opts_from_options.get("user_data_dir")
            if user_data_dir_origine != profil:
                opts_from_options["user_data_dir"] = profil
                log.info(
                    f"[camoufox] fingerprint rechargé pour le profil '{profil}' -- "
                    f"user_data_dir d'origine ({user_data_dir_origine!r}) spécifique "
                    f"à une autre machine, remplacé par le chemin réel du profil sur "
                    f"CETTE machine ({profil!r})."
                )

        # CORRECTIF (même famille de bug, sur "headless") : tout comme
        # user_data_dir ci-dessus, "headless" EST bien écrit dans le JSON
        # sauvegardé (paramètre nommé de launch_options(), cf. son
        # docstring -- "headless (Optional[bool])... Defaults to False"),
        # figé à la valeur utilisée lors de la toute première génération
        # -- probablement False sur la machine de dev Windows (un vrai
        # écran y est disponible). Rechargé tel quel sur Kaggle (aucun
        # écran, cf. tête de ce notebook), Firefox tente de s'ouvrir en
        # mode "headed" -> "Error: no DISPLAY environment variable
        # specified" -> échec du lancement, cf. logs. Le paramètre
        # `headless` REÇU PAR CETTE FONCTION (toujours True pour
        # sAutoniax, cf. l'appel dans _main_async_sautoniax) doit TOUJOURS
        # prévaloir sur la valeur sauvegardée -- comme pour
        # executable_path/user_data_dir, ce n'est pas une donnée
        # d'identité du fingerprint (aucun site web ne le voit), juste un
        # détail de démarrage local qui n'a aucune raison d'être persisté
        # tel quel entre machines.
        if opts_from_options is not None:
            headless_origine = opts_from_options.get("headless")
            if headless_origine != headless:
                opts_from_options["headless"] = headless
                log.info(
                    f"[camoufox] fingerprint rechargé pour le profil '{profil}' -- "
                    f"headless d'origine ({headless_origine!r}) ne correspond pas à "
                    f"la valeur demandée pour cette session ({headless!r}) -- "
                    f"remplacé (probablement enregistré sur une machine avec écran)."
                )

        # CORRECTIF (retour utilisateur explicite : "lorsque je lance
        # plusieur clone ... certains sont tres lent, mais des que je
        # selectionne un clone qui est toujour en cours dexecutions ...
        # cest a ce moment la que il se reactive ... se met a bien
        # executer sont notebook" -- confirmé : "le notebook avance très
        # lentement en arrière-plan, puis accélère nettement dès la
        # sélection") -- Firefox (donc Camoufox, qui en dérive) throttle
        # par défaut les timers JS (setTimeout/setInterval/
        # requestAnimationFrame) ET la bande passante réseau des pages
        # considérées "en arrière-plan" (jamais l'onglet actif/visible),
        # indépendamment du mode headless lui-même -- comportement
        # standard de Gecko, AUCUNE préférence anti-throttling n'était
        # configurée jusqu'ici (aucune trace de dom.min_background_
        # timeout_value ni de network.http.throttle.* dans ce fichier
        # avant ce patch). Avec N clones headless lancés en parallèle,
        # tous sauf celui explicitement sélectionné dans le panneau de
        # rendu sont donc considérés "en arrière-plan" par Gecko et
        # ralentis en conséquence -- cohérent avec l'observation "les
        # clones non sélectionnés avancent lentement".
        #
        # Préférences Firefox standard (about:config), toutes documentées
        # et publiques, aucune n'est une donnée de fingerprint détectable
        # par un site (elles ne touchent à rien d'observable côté JS
        # exposé à la page) :
        #   - dom.min_background_timeout_value / .without_budget_
        #     throttling = 0 : supprime le plancher de délai minimum
        #     (défaut 1000ms) imposé aux setTimeout/setInterval d'une
        #     page en arrière-plan.
        #   - dom.timeout.enable_budget_throttling = False : désactive le
        #     mécanisme de "budget" qui ralentit progressivement les
        #     timers d'arrière-plan même sous le plancher ci-dessus.
        #   - dom.suspend_inactive.enabled = False : empêche Firefox de
        #     suspendre carrément l'exécution JS d'un onglet inactif.
        #   - network.http.throttle.enable = False : désactive le
        #     throttling de bande passante réseau des onglets
        #     d'arrière-plan (network.http.throttle.version laissé au
        #     défaut, sans effet une fois throttle.enable=False).
        # Fusionnées dans un dict existant si Camoufox y a déjà placé ses
        # propres firefox_user_prefs internes (cf. issue connue daijro/
        # camoufox#47 -- certaines prefs peuvent être verrouillées en
        # interne pour l'anti-fingerprinting ; AUCUNE des clés ci-dessous
        # ne fait partie de ce périmètre, donc pas de conflit attendu),
        # sans jamais écraser d'éventuelles clés déjà présentes qu'on ne
        # connaît pas -- seules CES clés précises sont forcées. Appliqué
        # inconditionnellement (même patron que headless/user_data_dir
        # juste au-dessus) : que le fingerprint vienne d'être généré ou
        # rechargé depuis un profil déjà existant AVANT ce patch, la
        # préférence est garantie active à CHAQUE lancement -- pas besoin
        # de régénérer le fingerprint des profils déjà créés.
        opts_from_options["firefox_user_prefs"] = {
            **(opts_from_options.get("firefox_user_prefs") or {}),
            "dom.min_background_timeout_value": 0,
            "dom.min_background_timeout_value.without_budget_throttling": 0,
            "dom.timeout.enable_budget_throttling": False,
            "dom.suspend_inactive.enabled": False,
            "network.http.throttle.enable": False,
        }

        # AJOUT (demande explicite utilisateur -- désactiver l'adblocker
        # uBlock Origin embarqué par défaut par Camoufox) -- exclude_addons
        # n'est passé QUE si DefaultAddons a pu être importé (cf. import
        # défensif plus haut) ; sur une version de camoufox trop ancienne
        # pour l'exposer, on démarre normalement, avec uBlock Origin actif
        # comme avant ce patch, plutôt que de faire planter le lancement.
        kwargs_addons = {}
        if _CamoufoxDefaultAddons is not None:
            kwargs_addons["exclude_addons"] = [_CamoufoxDefaultAddons.UBO]
        _diag_log_fingerprint_effectif(profil, fingerprint_source, opts_from_options, headless)
        camoufox_cm = AsyncCamoufox(persistent_context=True, from_options=opts_from_options, **kwargs_addons)
        context = await camoufox_cm.__aenter__()
        log.info(
            f"[camoufox] instance '{instance_id}' lancée -- fingerprint robuste actif "
            f"({fingerprint_source}, geoip={'oui' if proxy and proxy.get('host') else 'non, pas de proxy'}), "
            f"uBlock Origin {'désactivé' if kwargs_addons else 'actif (DefaultAddons indisponible sur cette version de camoufox)'}."
        )
    except Exception as exc:
        # cf. docstring ci-dessus -- repli défensif : un paquet
        # optionnel manquant (camoufox[geoip] non installé), une version
        # de camoufox trop ancienne pour un des paramètres, ou une erreur
        # de génération/sauvegarde du fingerprint ne doit jamais empêcher
        # l'instance de démarrer purement et simplement, seulement
        # dégrader sa protection (journalisé explicitement, jamais
        # silencieux).
        #
        # DIAGNOSTIC (retour utilisateur : pas de connexion internet) --
        # CE REPLI EST LE SUSPECT NUMÉRO 1 : il construit un AsyncCamoufox
        # SANS AUCUN proxy (juste headless/persistent_context/
        # user_data_dir), même si un proxy avait été demandé. Si la
        # machine hôte n'a PAS d'accès internet direct (le proxy étant la
        # seule sortie réseau valide -- cas courant), tomber ici donne
        # exactement le symptôme "le navigateur ne charge rien" tout en
        # semblant démarrer normalement. Le log ci-dessous rend ce cas
        # visible avec le détail de l'exception réelle (au lieu du repr
        # tronqué) et rappelle explicitement que le proxy est perdu.
        log.warning(
            f"[camoufox][diag-proxy] échec du lancement avec la config robuste "
            f"complète -- type={type(exc).__name__}, message={exc}\n"
            f"{traceback.format_exc()}"
        )
        log.warning(
            f"[camoufox] repli sur une config MINIMALE (headless/persistent_context/"
            f"user_data_dir uniquement, SANS geoip/fingerprint persistant/humanize "
            f"ET SANS PROXY, même si un proxy avait été demandé : "
            f"{ {k: v for k, v in (proxy or {}).items() if k != 'password'} if proxy else 'aucun demandé' }). "
            f"Si un proxy est obligatoire pour la connexion internet de cette "
            f"machine, cette instance ne pourra probablement PAS charger de page "
            f"tant que ce repli est utilisé. Vérifiez l'installation : "
            f"pip install -U camoufox[geoip] && python -m camoufox fetch."
        )
        # AJOUT (même demande que sur le chemin robuste ci-dessus) -- même
        # exclusion défensive d'uBlock Origin sur ce repli minimal.
        kwargs_addons = {}
        if _CamoufoxDefaultAddons is not None:
            kwargs_addons["exclude_addons"] = [_CamoufoxDefaultAddons.UBO]
        # CORRECTIF (même retour utilisateur que sur le chemin robuste
        # ci-dessus, cf. son commentaire détaillé pour la justification
        # complète) -- appliqué aussi sur CE repli minimal : un profil qui
        # tombe ici (ex. camoufox[geoip] manquant) ne doit pas perdre la
        # protection anti-throttling pour autant, sinon ses clones
        # resteraient ralentis en arrière-plan comme avant ce patch.
        kwargs_addons["firefox_user_prefs"] = {
            "dom.min_background_timeout_value": 0,
            "dom.min_background_timeout_value.without_budget_throttling": 0,
            "dom.timeout.enable_budget_throttling": False,
            "dom.suspend_inactive.enabled": False,
            "network.http.throttle.enable": False,
        }
        _DIAG_DEMARRAGE[profil] = {"source": "repli_minimal", "resume": {}}
        _diag_log(str(profil) if profil else None, "warning",
                  f"[PROFIL-DEMARRAGE][INCOHÉRENCE] REPLI MINIMAL utilisé ({type(exc).__name__}: {exc}) -- "
                  f"le fingerprint du profil N'est PAS appliqué : viewport, écran, UA, WebGL seront ceux par défaut.")
        camoufox_cm = AsyncCamoufox(
            headless=headless,
            persistent_context=True,
            user_data_dir=profil,
            **kwargs_addons,
        )
        context = await camoufox_cm.__aenter__()
    return camoufox_cm, context


# PATCH (session perdue après envoi/restauration d'un profil vers le cloud) -- Firefox/Camoufox n'écrit
# JAMAIS les cookies de session (sans date d'expiration) sur disque, et écrit les autres avec retard.
# Un profil zippé navigateur ouvert perd donc la connexion. On sauvegarde ici les cookies VIVANTS
# (context.cookies(), session comprise) dans un fichier du dossier du profil toutes les
# INTERVALLE_SAUVEGARDE_COOKIES_S secondes : il part dans le zip à chaque envoi, navigateur ouvert ou
# non, et il est relu au démarrage suivant (camoufox_restaurer_cookies_profil).
NOM_FICHIER_COOKIES_PROFIL = "autoniax_cookies.json"
INTERVALLE_SAUVEGARDE_COOKIES_S = 15.0


def _ecrire_cookies_profil(dossier_profil: str, cookies: list) -> None:
    """Écriture atomique (fichier temporaire puis os.replace) : un zip pris en plein milieu ne voit
    jamais un fichier à moitié écrit."""
    chemin = os.path.join(dossier_profil, NOM_FICHIER_COOKIES_PROFIL)
    chemin_tmp = chemin + ".tmp"
    with open(chemin_tmp, "w", encoding="utf-8") as f:
        json.dump(cookies, f, ensure_ascii=False)
    os.replace(chemin_tmp, chemin)


async def camoufox_restaurer_cookies_profil(context, dossier_profil: Optional[str]) -> int:
    """Relit autoniax_cookies.json du profil et réinjecte les cookies dans le contexte (avant toute
    navigation). Ignore les cookies déjà expirés. Ne lève jamais. Retourne le nombre injecté."""
    if not dossier_profil:
        return 0
    chemin = os.path.join(dossier_profil, NOM_FICHIER_COOKIES_PROFIL)
    if not os.path.isfile(chemin):
        return 0
    try:
        with open(chemin, "r", encoding="utf-8") as f:
            cookies = json.load(f)
        maintenant = time.time()
        valides = [
            c for c in cookies
            if isinstance(c, dict) and c.get("name") and c.get("domain")
            and not (isinstance(c.get("expires"), (int, float)) and 0 < c["expires"] < maintenant)
        ]
        if not valides:
            return 0
        try:
            await context.add_cookies(valides)
            return len(valides)
        except Exception:
            nb = 0
            for c in valides:  # repli : un cookie invalide ne doit pas bloquer les autres
                try:
                    await context.add_cookies([c])
                    nb += 1
                except Exception:
                    pass
            return nb
    except Exception as exc:
        log.warning(f"[camoufox] restauration des cookies du profil impossible ({exc!r}) -- ignoré.")
        return 0


async def camoufox_boucle_sauvegarde_cookies(context, dossier_profil: str, nb_initial: int) -> None:
    """Tâche de fond : sauvegarde périodique des cookies vivants. S'arrête d'elle-même quand le
    contexte est fermé. Un jeu VIDE n'écrase un fichier existant que si le contexte avait des cookies
    juste avant (vidage voulu : reset/déconnexion) -- jamais si la restauration a échoué."""
    dernier_nb = nb_initial
    while True:
        await asyncio.sleep(INTERVALLE_SAUVEGARDE_COOKIES_S)
        try:
            cookies = await asyncio.wait_for(context.cookies(), timeout=10.0)
        except asyncio.CancelledError:
            raise
        except Exception:
            return  # contexte fermé -- fin normale
        if not cookies and dernier_nb == 0 and os.path.isfile(os.path.join(dossier_profil, NOM_FICHIER_COOKIES_PROFIL)):
            continue
        try:
            await asyncio.get_running_loop().run_in_executor(None, _ecrire_cookies_profil, dossier_profil, cookies)
            dernier_nb = len(cookies)
        except Exception as exc:
            log.debug(f"[camoufox] sauvegarde des cookies du profil échouée ({exc!r}).")


async def camoufox_demarrer_navigateur(
    profil: Optional[str], instance_id: str = "", url_ouverture: Optional[str] = None,
    download_dir: Optional[str] = None, headless: bool = True,
    proxy: Optional[dict] = None, nom_profil: Optional[str] = None,
    moteur: str = "camoufox",
):
    """Lance Camoufox (ou CloakBrowser si moteur="cloakbrowser" -- PATCH) avec un
    profil persistant (équivalent user_data_dir
    côté nodriver), ouvre la welcome page AutoniaX (ou url_ouverture si
    fournie, même priorité que demarrer_navigateur côté nodriver),
    installe l'interception presse-papier (une seule fois, niveau
    contexte) et la gestion des téléchargements.

    Réutilise contenu_page_accueil/_data_url_page_accueil (définies plus
    haut pour le rendu de la welcome page côté nodriver) -- c'est le même
    HTML, indépendant du client qui pilote le navigateur ; seule la
    NAVIGATION vers cette data: URL diffère (page.goto ici, Page.navigate
    CDP là-bas).

    IMPORTANT (AsyncCamoufox hérite de PlaywrightContextManager, pas de
    .start()/.stop() propres) : le cycle de vie complet passe par
    __aenter__/__aexit__, appelés ici directement (hors `async with`) pour
    garder le navigateur ouvert au-delà de cette fonction -- l'appelant
    est responsable d'appeler __aexit__ à la fermeture de l'instance
    (symétrique à browser.stop() côté nodriver).

    PATCH (demande utilisateur explicite : "je veux quelque chose de
    extremement robuste") -- `proxy` (même format que parser_proxy /
    obtenir_config_profil()["proxy"] : {"protocole", "host", "port",
    "user", "password"}) : construit un fingerprint COHÉRENT via
    _camoufox_construire_config_lancement (OS/écran/police/GPU cohérents
    entre eux via BrowserForge, geoip pour aligner timezone/locale/
    géolocalisation sur l'IP du proxy, curseur humanisé), PERSISTÉ par
    profil (cf. CORRECTIF ci-dessous). AVANT ce patch initial, seuls
    headless/persistent_context/user_data_dir étaient configurés --
    aucune protection anti-détection au-delà du proxy réseau lui-même.

    CORRECTIF (le tout premier patch passait des kwargs `seed`/`slim`
    directement à AsyncCamoufox -- ni l'un ni l'autre n'existe dans
    l'API publique, d'où `TypeError:
    BrowserType.launch_persistent_context() got an unexpected keyword
    argument 'seed'` en pratique, cf. logs, absorbé silencieusement par
    le repli minimal plus bas mais sans jamais donner la vraie
    protection voulue). La persistance de fingerprint par profil suit
    maintenant le mécanisme officiel (cf. discussions daijro/camoufox
    #40, #151, #332) :
      1. Si un fingerprint JSON existe déjà pour ce profil (cf.
         _camoufox_chemin_fingerprint), il est rechargé tel quel --
         AsyncCamoufox(from_options=..., persistent_context=True,
         user_data_dir=profil). C'est CE dict, déjà entièrement résolu
         par BrowserForge (device/police/WebGL concrets), qui garantit
         un fingerprint IDENTIQUE d'une relance à l'autre -- pas un seed
         qu'on fournirait nous-même (qui n'existe pas côté API).
      2. Sinon, camoufox.utils.launch_options(...) est appelée une
         seule fois avec la config de _camoufox_construire_config_lancement
         (+ user_data_dir), le dict résultant est sauvegardé en JSON
         PUIS utilisé pour ce premier lancement -- pour que le tout
         premier lancement ait déjà exactement le même fingerprint que
         tous les suivants (rien n'est passé "en dur" séparément).

    Défensif si `camoufox[geoip]` (ou une version de camoufox trop
    ancienne pour un des paramètres ci-dessus) manque : un premier essai
    avec la config complète, un REPLI automatique sur une config
    minimale (sans geoip/humanize, sans persistance) si AsyncCamoufox
    lève au lancement -- l'instance doit pouvoir démarrer (dégradée)
    plutôt que ne jamais se lancer du tout pour un paquet optionnel
    manquant, journalisé clairement dans les deux cas pour que ce ne
    soit jamais silencieux.

    Retourne (camoufox_cm, context, page, gestion, etat_navigateur) --
    camoufox_cm est le context manager lui-même (nécessaire pour
    __aexit__ à la fermeture), context EST le contexte persistant
    (persistent_context=True : pas de browser.new_context() séparé,
    l'objet retourné par __aenter__ est directement le BrowserContext,
    vérifié par lecture du code source camoufox/async_api.py)."""
    if moteur == "cloakbrowser":
        camoufox_cm, context = await cloakbrowser_creer_contexte(
            profil, nom_profil, headless, proxy, instance_id
        )
    else:
        camoufox_cm, context = await _camoufox_creer_contexte(
            profil, instance_id, headless, proxy, nom_profil
        )

    etat_navigateur = {"presse_papier_virtuel": "", "curseur_x": None, "curseur_y": None,
                       # CORRECTIF (toggle "bloquer médias" -- volet Camoufox) --
                       # MÊME clé et MÊME rôle que côté nodriver (cf. _main_async) :
                       # nom du profil dans le registre profils_config.json, relu à
                       # chaud par l'interception réseau (cf.
                       # camoufox_installer_blocage_media / _blocage_media_actif_
                       # camoufox). None si --nom-profil absent : le toggle reste
                       # alors simplement sans effet sur cette instance.
                       "nom_profil": nom_profil,
                       # Dernier bloquer_media EXPLICITE reçu du Task (naviguer(...,
                       # bloquer_media=True)) -- (ré)écrit par chaque navigate/newTab
                       # de _executer_commande_camoufox, prime toujours sur le toggle.
                       "bloquer_media_explicite": False,
                       # AJOUT -- où lire media_block.config.json (SPEC §6).
                       "chemin_profil": profil}
    gestion = GestionOngletsCamoufox()

    # DIAGNOSTIC (demande explicite utilisateur : "il faut plus de logs
    # assez robuste") -- posé AVANT l'interception presse-papier, pour
    # capter même son tout premier log ("script bien installé sur cette
    # page") dès le premier onglet.
    await camoufox_installer_diagnostic_console(context, etat_navigateur)
    await camoufox_installer_interception_presse_papier(context, etat_navigateur)
    # CORRECTIF (toggle "bloquer médias" -- volet Camoufox) -- posée DÈS LE
    # DÉMARRAGE, avant même la première page : l'interception est sur le
    # CONTEXTE, donc elle couvre aussi la navigation manuelle et les
    # onglets ouverts par la page elle-même, pas seulement ceux créés par
    # un Task (cf. camoufox_installer_blocage_media).
    await camoufox_installer_blocage_media(context, etat_navigateur)

    page = context.pages[0] if context.pages else await context.new_page()
    gestion.enregistrer(page)
    # BUG CORRIGÉ (traceback utilisateur : KeyError 'page' sur la toute
    # première commande envoyée à une instance camoufox, ex:
    # isInterfaceInitialisee -- _executer_commande_camoufox fait
    # `page = etat_navigateur["page"]` en tout premier, cf. son docstring)
    # -- etat_navigateur était construit plus haut SANS la clé "page"
    # (contrairement au chemin Chrome/nodriver, cf. demarrer_navigateur,
    # qui l'inclut dès la construction du dict : etat_navigateur =
    # {"page": page, ...}), et rien ne l'ajoutait ensuite avant le
    # `return ..., etat_navigateur` en fin de fonction. N'importe quelle
    # commande arrivant avant un premier switchTab/newTab/resetInterface
    # (qui, eux, réassignent etat_navigateur["page"]) faisait donc
    # échouer _executer_commande_camoufox avec ce KeyError, quelle que
    # soit l'action demandée.
    etat_navigateur["page"] = page
    # CORRECTIF (plantage reset/capture) -- contexte et drapeau de reset exposés à la boucle de streaming.
    etat_navigateur["context"] = context
    etat_navigateur["reset_en_cours"] = False

    # PATCH -- persistance des cookies de session (cf. NOM_FICHIER_COOKIES_PROFIL) : restauration AVANT
    # toute navigation, puis sauvegarde périodique en tâche de fond. Best-effort, ne bloque jamais le démarrage.
    if profil:
        try:
            _nb_restaures = await camoufox_restaurer_cookies_profil(context, profil)
            if _nb_restaures:
                log.info(f"[camoufox] {_nb_restaures} cookie(s) du profil restauré(s) (session comprise).")
            try:
                _nb_actuels = len(await asyncio.wait_for(context.cookies(), timeout=10.0))
            except Exception:
                _nb_actuels = 0
            etat_navigateur["tache_cookies"] = asyncio.ensure_future(
                camoufox_boucle_sauvegarde_cookies(context, profil, _nb_actuels)
            )
        except Exception as exc:
            log.warning(f"[camoufox] persistance des cookies non activée ({exc!r}).")
    # PATCH DIAGNOSTIC -- valeurs RÉELLES du navigateur (viewport/écran/UA...) comparées au fingerprint attendu.
    try:
        etat_navigateur["tache_diag_runtime"] = asyncio.ensure_future(
            camoufox_diag_snapshot_runtime(page, profil, headless))
    except Exception as exc_diag:
        log.warning(f"[PROFIL-DEMARRAGE] snapshot runtime non lancé ({exc_diag!r})")

    # PATCH (demande utilisateur explicite : "je veux que pardefaut quand
    # on demare une instance le curseur est positionner a une positon
    # aleatoire et non fixe") -- AVANT ce patch, curseur_x/curseur_y
    # restaient à None jusqu'au tout premier mousemove/click de la
    # session (cf. action_camoufox_mousemove/action_camoufox_click :
    # "aucun mousemove n'a encore eu lieu" -> (x, y) demandé lui-même
    # sert de point de départ, trajet de longueur nulle -- donc en
    # pratique le tout premier geste partait toujours du point cible
    # lui-même, jamais d'un point réellement aléatoire). On tire
    # maintenant ICI, dès le démarrage de l'instance, une position
    # UNIFORME sur toute la surface de l'écran piloté (PAS une constante
    # fixe comme (0, 0) ou le centre -- demande explicite "non fixe") :
    # le tout premier mousemove/click de la session part donc déjà d'un
    # point aléatoire plausible plutôt que de sauter instantanément sur
    # sa cible. Défensif par construction (même esprit que les autres
    # blocs try/except protégeant l'import de dépendances optionnelles
    # plus haut dans ce fichier) : un échec de lecture des dimensions ne
    # doit jamais empêcher le démarrage de l'instance -- curseur_x/y
    # retombent alors sur None (comportement identique à avant ce patch).
    try:
        _dim_ecran = await page.evaluate("({width: window.innerWidth, height: window.innerHeight})")
        _largeur_ecran = int(_dim_ecran.get("width") or 0)
        _hauteur_ecran = int(_dim_ecran.get("height") or 0)
        if _largeur_ecran > 0 and _hauteur_ecran > 0:
            etat_navigateur["curseur_x"] = float(random.randint(0, _largeur_ecran - 1))
            etat_navigateur["curseur_y"] = float(random.randint(0, _hauteur_ecran - 1))
            log.debug(
                f"[camoufox] curseur virtuel initialisé à une position aléatoire "
                f"({etat_navigateur['curseur_x']:.0f}, {etat_navigateur['curseur_y']:.0f}) "
                f"sur un écran de {_largeur_ecran}x{_hauteur_ecran}."
            )
    except Exception as exc:
        log.debug(
            f"[camoufox] échec de la lecture des dimensions d'écran pour positionner "
            f"le curseur virtuel initial ({exc!r}) -- curseur_x/curseur_y restent à "
            f"None, repli sur le comportement d'avant ce patch (premier mousemove/click "
            f"partira de sa propre destination)."
        )

    if url_ouverture:
        # DIAGNOSTIC (retour utilisateur : pas de connexion internet) --
        # page.goto lève une exception explicite (net::ERR_*, timeout...)
        # en cas d'échec réseau -- si ce n'était pas loggé avant, l'appelant
        # ne voyait peut-être qu'une page blanche sans jamais voir la vraie
        # cause (proxy injoignable, credentials refusés, DNS...). On laisse
        # l'exception continuer à remonter (comportement inchangé), mais on
        # la journalise en détail avant qu'elle ne parte.
        log.info(f"[camoufox][diag-proxy] navigation initiale vers url_ouverture={url_ouverture!r}...")
        try:
            await page.goto(url_ouverture)
            log.info(f"[camoufox][diag-proxy] navigation initiale RÉUSSIE vers {url_ouverture!r}.")
        except Exception as exc_goto:
            log.warning(
                f"[camoufox][diag-proxy] navigation initiale ÉCHOUÉE vers "
                f"{url_ouverture!r} -- type={type(exc_goto).__name__}, "
                f"message={_resume_pour_log(exc_goto)}. Si ce message mentionne le proxy "
                f"(ERR_PROXY_CONNECTION_FAILED, ERR_TUNNEL_CONNECTION_FAILED, "
                f"ERR_NO_SUPPORTED_PROXIES, credentials...), c'est la cause "
                f"directe du problème de connexion."
            )
            raise
    else:
        # Même mécanisme de rendu que la welcome page nodriver
        # (contenu_page_accueil/_data_url_page_accueil, définies plus
        # haut dans ce fichier) -- une data: URL contenant le HTML complet,
        # avec instance_id encodé dedans pour la reconnaissance ultérieure
        # (cf. action_camoufox_is_interface_initialisee/get_home_tab_id).
        #
        # PATCH (bug observé : timeout 30s sur cette navigation quand un
        # proxy est configuré) -- une data: URL est purement locale, aucune
        # requête réseau n'est censée partir pour l'afficher. Cependant,
        # certaines configurations (proxy injoignable/lent) semblent
        # malgré tout faire attendre le navigateur sur ce goto, jusqu'au
        # timeout par défaut de Playwright (30s). On réduit donc le timeout
        # à une valeur cohérente avec une page locale, et on retente une
        # seule fois avec wait_until="commit" (n'attend que le début de la
        # navigation, pas les événements load/domcontentloaded qui peuvent
        # être ceux qui bloquent) avant d'abandonner proprement avec un log
        # explicite -- pour ne jamais faire échouer toute l'instance à
        # cause de la seule welcome page.
        url_accueil = _data_url_page_accueil(instance_id)
        try:
            await page.goto(url_accueil, timeout=8000)
        except Exception as exc_goto_accueil:
            log.warning(
                f"[camoufox][diag-proxy] navigation initiale vers la welcome "
                f"page (data: URL locale) a échoué ou a timeout -- "
                f"type={type(exc_goto_accueil).__name__}, message={_resume_pour_log(exc_goto_accueil)}. "
                f"Nouvelle tentative avec wait_until='commit' (ignore les "
                f"événements load qui semblent bloquer, probablement à "
                f"cause du proxy configuré même si aucune requête réseau "
                f"n'est censée être nécessaire ici)."
            )
            try:
                await page.goto(url_accueil, timeout=8000, wait_until="commit")
            except Exception as exc_goto_accueil_retry:
                log.warning(
                    f"[camoufox][diag-proxy] 2e tentative de navigation vers "
                    f"la welcome page également en échec -- "
                    f"type={type(exc_goto_accueil_retry).__name__}, "
                    f"message={_resume_pour_log(exc_goto_accueil_retry)}. L'instance continue "
                    f"son démarrage malgré tout (page potentiellement "
                    f"vierge) plutôt que de bloquer 30s supplémentaires."
                )

    if download_dir:
        await camoufox_installer_gestion_telechargements(page, download_dir)

    return camoufox_cm, context, page, gestion, etat_navigateur


# ---------------------------------------------------------------------------
# Dispatcher central -- équivalent _executer_commande (client nodriver).
# Même contrat exact : reçoit {"type": "command", "action": ..., ...},
# retourne {"ok": bool, "result": ..., "error": ...}. Toute erreur
# "métier" (élément absent, timeout de chargement...) devient un
# command_result ok=False ; seule une vraie déconnexion
# (NavigateurFermeCamoufox) remonte telle quelle à l'appelant, pour être
# traitée comme la boucle de réception le fait déjà côté nodriver pour
# ConnectionError/ConnectionClosed.
# ---------------------------------------------------------------------------

# PATCH copie -- filet de sécurité de Ctrl+C côté Camoufox. Si l'événement DOM
# "copy" n'a rien rapporté (texte vide, ou jamais émis), on relit directement la
# sélection de la page (champ de saisie inclus) ; à défaut, et si le drapeau
# ci-dessous est actif, le texte de l'ÉLÉMENT sous la dernière position cliquée
# (cas "copier un élément" sans sélection). Mettre à False pour ne copier QUE
# une vraie sélection.
COPIE_ELEMENT_SOUS_CURSEUR_SI_AUCUNE_SELECTION = True

_JS_CAMOUFOX_TEXTE_A_COPIER = """
([px, py, repli]) => {
    var el = document.activeElement;
    try {
        while (el && el.tagName === 'IFRAME' && el.contentDocument && el.contentDocument.activeElement) {
            el = el.contentDocument.activeElement;
        }
    } catch (e) { /* iframe cross-origin */ }
    try {
        if (el && (el.tagName === 'TEXTAREA' || (el.tagName === 'INPUT' && typeof el.selectionStart === 'number'))
            && el.selectionStart !== el.selectionEnd) {
            return {texte: String(el.value).substring(el.selectionStart, el.selectionEnd), origine: 'selection-champ'};
        }
    } catch (e) { /* rien */ }
    try {
        var doc = (el && el.ownerDocument) ? el.ownerDocument : document;
        var sel = (doc.defaultView || window).getSelection();
        var t = sel ? String(sel.toString()) : '';
        if (t) { return {texte: t, origine: 'selection'}; }
    } catch (e) { /* rien */ }
    if (repli) {
        var cible = document.elementFromPoint(px, py);
        if (cible && cible.tagName !== 'BODY' && cible.tagName !== 'HTML') {
            var v = (cible.tagName === 'INPUT' || cible.tagName === 'TEXTAREA')
                ? cible.value : (cible.innerText || cible.textContent || '');
            v = String(v || '').trim().substring(0, 20000);
            if (v) { return {texte: v, origine: 'element'}; }
        }
    }
    return {texte: '', origine: 'aucune'};
}
"""


async def _copie_secours_camoufox(page, etat_navigateur: dict, x: int, y: int, resultat_initial: dict) -> dict:
    """Voir le commentaire de COPIE_ELEMENT_SOUS_CURSEUR_SI_AUCUNE_SELECTION. Ne lève jamais."""
    try:
        r = await page.evaluate(
            _JS_CAMOUFOX_TEXTE_A_COPIER, [int(x), int(y), bool(COPIE_ELEMENT_SOUS_CURSEUR_SI_AUCUNE_SELECTION)],
        )
    except Exception as exc:  # noqa: BLE001
        log.warning(f"[camoufox][copie-secours] lecture impossible : {exc!r}")
        return resultat_initial
    texte = str((r or {}).get("texte") or "")
    if not texte:
        log.info("[camoufox][copie-secours] ni sélection ni élément textuel sous le curseur.")
        return resultat_initial
    _memoriser_copie_presse_papier(etat_navigateur, texte)
    threading.Thread(target=_ecrire_presse_papier_windows, args=(texte,), daemon=True).start()
    log.info(f"[camoufox][copie-secours] copie de secours ({(r or {}).get('origine')}) : {len(texte)} caractère(s).")
    return {"copie": texte}


async def _executer_commande_camoufox(
    context, gestion: GestionOngletsCamoufox, etat_navigateur: dict, data: dict,
    arret_demande: "asyncio.Event | None" = None,
) -> dict:
    action = data.get("action")
    resultat = None
    # PATCH (robustesse capture de copie) : champs SUPPLÉMENTAIRES
    # fusionnés dans la réponse ok=True (cf. le `return` en fin de
    # fonction). Dict vide pour toutes les actions sauf
    # click(copier_presse_papier=True) -- la réponse reste donc
    # RIGOUREUSEMENT identique à avant ce patch pour tout le reste, et
    # `result` continue de porter le texte brut attendu par les
    # appelants existants (jamais un objet composite, qui aurait cassé
    # get_clipboard/copy/new_tab).
    extras_reponse: dict = {}
    # DÉSACTIVÉ (demande explicite utilisateur : "logs les plus bruyants"
    # -- cf. analyse logs.txt, ~595 occurrences, une par commande
    # exécutée) -- passé en debug plutôt que supprimé, réactivable via
    # la config du logger.
    log.debug(
        f"[camoufox] _executer_commande_camoufox() : action={action!r} "
        f"requete_id={data.get('requete_id')!r} "
        f"params={ {k: v for k, v in data.items() if k not in ('type', 'action', 'requete_id', 'instance_id')} }"
    )
    try:
        page = etat_navigateur["page"]
        if action == "moveCursor":
            await action_camoufox_move_cursor(page, int(data["x"]), int(data["y"]))
        elif action == "mousemove":
            await action_camoufox_mousemove(page, int(data["x"]), int(data["y"]), etat_navigateur=etat_navigateur,
                                             speed_percent=float(data.get("speedPercent", 0)),
                                             instantane=bool(data.get("instantane", False)))
        elif action == "click":
            # PATCH (robustesse capture de copie) : horodatage pris AVANT
            # l'envoi du clic -- c'est la référence qui permettra de dire
            # "cette copie est bien imputable à CE clic-ci". Capturé
            # inconditionnellement (coût nul) plutôt que dans le `if`
            # ci-dessous, pour qu'aucune latence du clic lui-même ne
            # s'intercale entre la mesure et l'action.
            horodatage_avant_clic = time.monotonic()
            # DIAGNOSTIC (round 3 -- hypothèse A du diagnostic précédent :
            # "le gestionnaire fait quelque chose d'asynchrone avant de
            # copier -- attend une réponse serveur, un state React --
            # donc la copie n'a jamais lieu du tout, pas seulement non
            # interceptée"). Écoute RÉSEAU posée AVANT le clic (sinon les
            # requêtes les plus rapides, potentiellement déclenchées dans
            # la même milliseconde que le clic, seraient ratées) --
            # accumule dans une simple liste plutôt que de logger requête
            # par requête : le clic ne doit jamais attendre le réseau, on
            # veut juste pouvoir dire APRÈS COUP "combien de requêtes, et
            # lesquelles, sont parties dans la fenêtre qui a suivi ce clic
            # précis" (cf. utilisation dans la sonde post-échec plus bas).
            # Retirée dans un `finally` après la fenêtre de détection,
            # jamais laissée branchée au-delà de CE clic précis -- sinon
            # elle grossirait indéfiniment sur toute la session et
            # polluerait le diagnostic d'un futur clic avec des requêtes
            # sans rapport.
            requetes_capturees_diag = []
            ecouteur_requete_diag = None
            if data.get("copier_presse_papier"):
                def _sur_requete_diag(requete, _liste=requetes_capturees_diag, _t0=horodatage_avant_clic):
                    try:
                        _liste.append({
                            "delta_ms": round((time.monotonic() - _t0) * 1000, 1),
                            "methode": requete.method,
                            "url": requete.url[:200],
                            "type_ressource": requete.resource_type,
                        })
                    except Exception:
                        pass  # best-effort total, cf. docstring ci-dessus -- jamais casser le diagnostic lui-même
                ecouteur_requete_diag = _sur_requete_diag
                page.on("request", ecouteur_requete_diag)

                # DIAGNOSTIC (demande explicite utilisateur : "il faut
                # plus de logs assez robuste pour savoir ce qui c'est
                # réellement passé") -- sonde l'état EXACT de
                # l'interception sur CETTE page, AVANT le clic, en une
                # seule ligne structurée. Doit permettre de trancher
                # directement entre les hypothèses déjà écartées à tort
                # ou à raison dans le diagnostic précédent :
                #   - is_secure_context=False -> contexte non sécurisé,
                #     writeText/write n'auraient alors jamais pu être
                #     patchés (cf. leurs try/catch respectifs) ;
                #   - writeText_patchee=False -> le add_init_script ne
                #     s'est PAS appliqué sur cette page précise (onglet
                #     créé autrement, monde JS recréé après le patch...) ;
                #   - binding_present=False -> expose_function n'a pas
                #     (encore) fini de se brancher sur cette page --
                #     appuie ou infirme l'hypothèse de race condition déjà
                #     corrigée par la retentative à 150ms ci-dessus.
                #
                # DIAGNOSTIC (round 4 -- comparaison avec un test EN LOCAL
                # qui a RÉUSSI, cf. logs joints : en local, la copie
                # emprunte navigator.clipboard.write() -- API ClipboardItem
                # -- interceptée avec succès. Sur sAutoniax (Kaggle,
                # cross-process, souris pilotée à distance), aucune des 3
                # voies n'a jamais été appelée. navigator.clipboard.write()
                # est notoirement PLUS STRICTE que writeText() : plusieurs
                # navigateurs refusent silencieusement de l'honorer si le
                # document n'a pas le focus réel de la fenêtre au moment de
                # l'appel (pas seulement document.activeElement, qui lui
                # reste toujours cohérent avec le DOM interne, focus OU
                # PAS). document_has_focus/document_visibility_state
                # ci-dessous permettent de vérifier si CETTE différence
                # (fenêtre non focalisée en exécution headless/distante)
                # explique que React n'invoque jamais clipboard.write() du
                # tout sur sAutoniax, alors qu'il le fait bien en local où
                # la fenêtre a le focus OS réel.
                #
                # RÉSERVE IMPORTANTE (cf. note plus haut dans ce fichier,
                # sur CDP/nodriver et document.visibilityState) : certains
                # navigateurs automatisés forcent artificiellement
                # visibilityState à "visible" même sans focus réel --
                # mécanisme d'émulation pour rendre l'automation
                # déterministe. Cette note concernait CDP/Chromium ;
                # Camoufox est un Firefox patché et PEUT se comporter
                # différemment, mais ce n'est PAS vérifié ici -- si
                # document_has_focus/document_visibility_state reviennent
                # tous les deux "normaux" (focus=true, visible) sur
                # sAutoniax malgré l'échec, ça n'élimine pas forcément
                # l'hypothèse focus : ça voudrait dire que CES DEUX
                # signaux précis sont eux-mêmes émulés/peu fiables ici, et
                # qu'il faudra chercher un signal de focus plus bas niveau
                # (ex. window.top === window.self, ou un test direct de
                # clipboard.write() sur un texte fixe pour voir s'il
                # rejette sa promesse avec une erreur explicite de
                # permission).
                # Best-effort total : un échec de cette sonde elle-même
                # (page.evaluate qui lève) ne doit jamais empêcher le
                # clic réel de partir, juste priver ce diagnostic d'une
                # ligne -- d'où le try/except qui englobe tout le bloc.
                try:
                    etat_avant_clic = await page.evaluate(
                        """() => ({
                            is_secure_context: window.isSecureContext,
                            url: location.href,
                            has_clipboard: !!navigator.clipboard,
                            writeText_patchee: !!(navigator.clipboard && navigator.clipboard.writeText &&
                                navigator.clipboard.writeText.toString().indexOf('native code') === -1),
                            write_patchee: !!(navigator.clipboard && navigator.clipboard.write &&
                                navigator.clipboard.write.toString().indexOf('native code') === -1),
                            binding_present: typeof window.__autoniax_camoufox_copie__ === 'function',
                            script_installe_flag: !!window.__autoniax_presse_papier_installe__,
                            active_element: document.activeElement ? document.activeElement.tagName : null,
                            document_has_focus: document.hasFocus(),
                            document_visibility_state: document.visibilityState,
                        })"""
                    )
                    log.info(
                        f"[camoufox][diag-copie] AVANT clic (id_dom_presse_papier="
                        f"{data.get('id_dom_presse_papier')!r}) : {etat_avant_clic!r}"
                    )
                except Exception as exc_diag:
                    log.warning(f"[camoufox][diag-copie] sonde pré-clic échouée ({exc_diag!r}) -- clic poursuivi normalement.")
            await action_camoufox_click(
                page, int(data["x"]), int(data["y"]),
                bouton=data.get("bouton", "gauche"),
                duree_appui_ms=int(data.get("duree_appui_ms", 60)),
                nb_clics=int(data.get("nb_clics", 1)),
                etat_navigateur=etat_navigateur,
                speed_percent=float(data.get("speedPercent", 0)),
                instantane=bool(data.get("instantane", False)),
            )
            if data.get("copier_presse_papier"):
                # Le clic vient potentiellement de déclencher un bouton
                # "copier" du site -- navigator.clipboard.writeText/write
                # et l'événement DOM "copy" sont déjà interceptés pour
                # TOUTE la durée de vie du contexte (cf.
                # camoufox_installer_interception_presse_papier, posé une
                # seule fois à la création du contexte) et redirigent vers
                # etat_navigateur["presse_papier_virtuel"] via
                # expose_function, jamais le presse-papier Windows.
                #
                # PATCH (robustesse capture de copie) : l'ancien
                # `await asyncio.sleep(0.1)` suivi d'une lecture directe
                # est remplacé par un polling ancré sur la FRAÎCHEUR (cf.
                # _attendre_copie_presse_papier_fraiche). Deux bugs
                # corrigés d'un coup : un site qui met plus de 100 ms à
                # copier n'était jamais capté, et une absence de copie
                # renvoyait silencieusement la valeur d'un clic précédent
                # sans rapport. Le cas nominal n'est pas ralenti : la
                # fonction rend la main dès la première copie détectée.
                id_dom_cible = data.get("id_dom_presse_papier") or ""
                try:
                    detection = await _attendre_copie_presse_papier_fraiche(
                        etat_navigateur, id_dom_cible, horodatage_avant_clic,
                        delai_max_s=float(data.get(
                            "delai_copie_presse_papier_s", DELAI_DETECTION_COPIE_PRESSE_PAPIER_S,
                        )),
                        prefixe_log="[camoufox] ",
                    )
                finally:
                    # DIAGNOSTIC (round 3) -- retire l'écouteur réseau posé
                    # avant le clic (cf. ci-dessus) une fois la fenêtre de
                    # détection close, qu'une copie ait été détectée ou
                    # non : `requetes_capturees_diag` reste néanmoins
                    # peuplée pour la sonde post-échec ci-dessous, seul
                    # l'ÉCOUTEUR est retiré (best-effort : remove_listener
                    # peut lever si la page a déjà été fermée/naviguée
                    # entre-temps, ce qui ne doit jamais faire échouer le
                    # clic lui-même à ce stade).
                    if ecouteur_requete_diag is not None:
                        try:
                            page.remove_listener("request", ecouteur_requete_diag)
                        except Exception:
                            pass
                resultat = detection["texte"]
                # Remonté au pilote en CHAMPS SÉPARÉS (pas encodé dans
                # `result`, qui doit rester le texte brut attendu par les
                # appelants existants) -- cf. _executer_avec_retry, qui en
                # dérive un ResultatAction(statut=False) explicite plutôt
                # qu'un faux succès à texte périmé.
                extras_reponse["presse_papier_frais"] = bool(detection["frais"])
                extras_reponse["presse_papier_origine"] = detection["origine"]
                if detection["message"]:
                    extras_reponse["presse_papier_message"] = detection["message"]
                if not detection["frais"]:
                    # DIAGNOSTIC -- resonde APRÈS l'échec (même forme que
                    # la sonde d'avant-clic) : si writeText_patchee/
                    # write_patchee sont VRAIS ici alors qu'AUCUNE copie
                    # n'a été détectée, la conclusion se resserre fort :
                    # le clic n'a simplement déclenché AUCUNE des 3 voies
                    # interceptées (ni writeText, ni write, ni événement
                    # copy) -- ChatGPT utiliserait alors un 4e mécanisme
                    # non couvert (ex. un execCommand('copy') sur un
                    # <textarea> caché, ou une extension côté navigateur).
                    # Si au contraire binding_present est FAUX ici, la
                    # race condition de branchement expose_function est
                    # confirmée comme cause réelle.
                    #
                    # DIAGNOSTIC (round 2, après confirmation que React
                    # traite bien le clic -- cf. defaultPrevented=true en
                    # phase bulle des logs "click" ajoutés précédemment) --
                    # enrichi de 3 nouvelles sondes pour trancher entre
                    # "React a copié via une voie non interceptée" et "le
                    # site lui-même a échoué à copier (côté React), sans
                    # rapport avec notre interception" :
                    #   1. bouton_html_apres : le outerHTML du bouton
                    #      cliqué -- ChatGPT change typiquement son icône
                    #      copier -> coche après une copie perçue comme
                    #      réussie côté site ; si l'icône n'a PAS changé,
                    #      le site lui-même pense avoir échoué, ce qui
                    #      innocenterait totalement notre interception ;
                    #   2. permission_clipboard_write : état réel de la
                    #      permission "clipboard-write" si l'API Permissions
                    #      est disponible -- une permission refusée
                    #      expliquerait un clipboard.writeText qui rejette
                    #      silencieusement sa promesse AVANT même d'exécuter
                    #      le corps de la fonction patchée (auquel cas notre
                    #      patch ne verrait jamais l'appel, car l'appel
                    #      lève avant d'atteindre notre override -- à
                    #      vérifier, cf. note ci-dessous) ;
                    #   3. textarea_cache_present : détecte un <textarea>
                    #      hors-écran typique de la technique de repli
                    #      execCommand('copy'), non couverte par notre
                    #      interception actuelle (seul l'événement "copy"
                    #      DOM déclenché par Ctrl+C/execCommand est couvert,
                    #      pas la présence du textarea lui-même).
                    # DIAGNOSTIC (round 3) -- 2 sondes supplémentaires,
                    # pour trancher spécifiquement l'hypothèse A du round
                    # précédent ("le gestionnaire fait quelque chose
                    # d'asynchrone avant de copier -- attend une réponse
                    # serveur, un state React -- donc la copie n'a jamais
                    # lieu du tout") :
                    #   4. requetes_reseau_pendant_clic : résumé (méthode,
                    #      url tronquée, delta_ms depuis le clic) de TOUTE
                    #      requête HTTP observée entre le clic et cette
                    #      sonde (cf. l'écouteur page.on("request") posé
                    #      avant le clic, plus haut). Si une requête part
                    #      pile au moment du clic puis que la copie
                    #      n'arrive jamais, ça confirmerait une copie
                    #      conditionnée à une réponse serveur qui échoue
                    #      ou traîne sur CET environnement précis. Si
                    #      AUCUNE requête n'apparaît ici, l'hypothèse A
                    #      est éliminée -- il faudra chercher du côté d'un
                    #      state React local (pas de round-trip réseau).
                    #   5. texte_reponse_visible : les ~300 premiers
                    #      caractères du dernier bloc de réponse assistant
                    #      visible à l'écran au moment de la sonde --
                    #      distingue "la réponse est bien là, complète,
                    #      mais sa copie échoue" de "la réponse est vide/
                    #      en cours de génération/en erreur", ce qui
                    #      expliquerait un bouton Copy présent mais inerte
                    #      sans rapport avec notre interception (hypothèse
                    #      B du diagnostic précédent). Sélecteur best-effort
                    #      (data-message-author-role, structure connue de
                    #      l'UI ChatGPT) -- une absence de correspondance
                    #      donne simplement null, sans faire échouer la
                    #      sonde.
                    try:
                        etat_apres_echec = await page.evaluate(
                            """() => {
                                var boutonCopie = document.querySelector('[aria-label="Copy response"]') ||
                                    document.querySelector('[aria-label*="Copy" i]');
                                var permissionClipboard = 'inconnue (API Permissions absente)';
                                var blocsReponse = document.querySelectorAll('[data-message-author-role="assistant"]');
                                var dernierBloc = blocsReponse.length ? blocsReponse[blocsReponse.length - 1] : null;
                                var texteReponse = dernierBloc ? (dernierBloc.textContent || '') : null;
                                return Promise.resolve().then(function () {
                                    if (navigator.permissions && navigator.permissions.query) {
                                        return navigator.permissions.query({name: 'clipboard-write'})
                                            .then(function (p) { return p.state; })
                                            .catch(function () { return 'requête refusée/non supportée'; });
                                    }
                                    return permissionClipboard;
                                }).then(function (etatPermission) {
                                    return {
                                        is_secure_context: window.isSecureContext,
                                        writeText_patchee: !!(navigator.clipboard && navigator.clipboard.writeText &&
                                            navigator.clipboard.writeText.toString().indexOf('native code') === -1),
                                        write_patchee: !!(navigator.clipboard && navigator.clipboard.write &&
                                            navigator.clipboard.write.toString().indexOf('native code') === -1),
                                        binding_present: typeof window.__autoniax_camoufox_copie__ === 'function',
                                        script_installe_flag: !!window.__autoniax_presse_papier_installe__,
                                        active_element: document.activeElement ? document.activeElement.tagName : null,
                                        active_element_aria: document.activeElement ? document.activeElement.getAttribute('aria-label') : null,
                                        bouton_html_apres: boutonCopie ? boutonCopie.outerHTML.slice(0, 500) : null,
                                        permission_clipboard_write: etatPermission,
                                        textarea_cache_present: !!document.querySelector(
                                            'textarea[style*="left: -"], textarea[style*="position: fixed"][style*="opacity: 0"]'
                                        ),
                                        nb_blocs_reponse_assistant: blocsReponse.length,
                                        texte_reponse_visible: texteReponse ? (
                                            texteReponse.length > 300 ? texteReponse.slice(0, 300) + '…' : texteReponse
                                        ) : null,
                                        document_has_focus: document.hasFocus(),
                                        document_visibility_state: document.visibilityState,
                                    };
                                });
                            }"""
                        )
                        log.warning(
                            f"[camoufox][diag-copie] APRÈS échec de détection (id_dom_presse_papier="
                            f"{data.get('id_dom_presse_papier')!r}) : {etat_apres_echec!r} -- "
                            f"requêtes réseau pendant la fenêtre du clic : {requetes_capturees_diag!r}"
                        )
                    except Exception as exc_diag2:
                        log.warning(f"[camoufox][diag-copie] sonde post-échec échouée ({exc_diag2!r}).")
        elif action == "scroll_simple":
