            workspace_fichiers_recents=(
                [c for c in d.get("workspace_fichiers_recents", []) if isinstance(c, str)]
                if isinstance(d.get("workspace_fichiers_recents"), list)
                else []
            ),
        )

    def save(self, path: Optional[Path] = None):
        path = path or get_reglages_json_path()
        path.write_text(
            json.dumps(self.to_dict(), ensure_ascii=False, indent=2),
            encoding="utf-8",
        )

    @staticmethod
    def load(path: Optional[Path] = None) -> "ReglagesApp":
        path = path or get_reglages_json_path()
        if not path.exists():
            return ReglagesApp()
        try:
            data = json.loads(path.read_text(encoding="utf-8"))
        except (json.JSONDecodeError, OSError):
            return ReglagesApp()
        return ReglagesApp.from_dict(data)


