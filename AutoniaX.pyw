    try {
      for (var i = 0; i < MOTIFS_ID_VOLATILE.length; i++) {
        if (MOTIFS_ID_VOLATILE[i].test(id)) { return true; }
      }
    } catch (e) {
      // Test de motif impossible (id d'un type inattendu) -- on préfère
      // le considérer comme STABLE : c'est le comportement historique,
      // donc le repli le moins surprenant.
      return false;
