        # "Récupérer en local" (§4.4.d point 4) : PAS encore de fusion
        # automatique dans le ProjetBatch local -- ouvre simplement
        # l'emplacement reçu dans l'explorateur de fichiers, pour que
        # l'utilisateur récupère manuellement ce qu'il souhaite (cookies/
        # historique de profils mis à jour, sous-projets traités). Une
        # fusion automatisée (copie ciblée vers le ProjetBatch d'origine)
        # est un développement distinct, volontairement pas fait à la
        # légère ici (risque d'écraser des données locales sans confirmation
        # explicite de l'utilisateur sur CE qui doit être fusionné).
        def _sur_demande_recuperation_locale(session_id: str, id_projet_batch: str, chemin_dossier_recu: str):
            QDesktopServices.openUrl(QUrl.fromLocalFile(chemin_dossier_recu))

        reseau_screen.demande_recuperation_locale.connect(_sur_demande_recuperation_locale)

        # PATCH E.2 -- "Batch Traité", bouton Télécharger (cf. docstring
        # de BatchTraiteScreen) : télécharge resultat.zip depuis B2 puis
        # ÉCRASE chemin_racine_local avec son contenu. File d'attente +
        # connexion/déconnexion ponctuelle sur telechargement_fichier_
        # resultat filtrée par clé -- même patron EXACT que _lancer_
        # prochain_telechargement_meta ci-dessus (ProfilsCloudScreen),
        # pour ne jamais entrer en conflit avec d'autres téléchargements
        # simultanés utilisant ce même signal partagé.
        self._file_attente_batch_traite: list[tuple[str, str]] = []  # [(prefixe_b2, chemin_racine_local)]
        self._telechargement_batch_traite_en_cours = False

        def _lancer_prochain_telechargement_batch_traite():
            if self._telechargement_batch_traite_en_cours or not self._file_attente_batch_traite:
                return
            prefixe_b2, chemin_racine_local = self._file_attente_batch_traite.pop(0)
            self._telechargement_batch_traite_en_cours = True
            cle_zip = f"{prefixe_b2}/resultat.zip"
            # Nom lisible pour les messages de statut -- même convention
            # d'affichage que BatchTraiteScreen._reconstruire_table (1er
            # segment avant " — ", cf. sa docstring : "{nom} — {horodatage}
            # — {session_id}").
            nom_dossier_b2 = prefixe_b2.split("/", 1)[1] if "/" in prefixe_b2 else prefixe_b2
            nom_lisible = nom_dossier_b2.split(" — ")[0]
            chemin_zip_tmp = Path(tempfile.gettempdir()) / f"autoniax_batch_traite_{uuid.uuid4().hex}.zip"

            def _terminer(ok: bool, message: str):
                self._telechargement_batch_traite_en_cours = False
                reseau_screen.batch_traite_screen.sur_resultat_telechargement_batch_traite(ok, nom_lisible, message)
                _lancer_prochain_telechargement_batch_traite()

            def _sur_resultat(ok: bool, cle_recue: str, message: str):
                if cle_recue != cle_zip:
                    return
                self.client_serveur_t.telechargement_fichier_resultat.disconnect(_sur_resultat)
                if not ok:
                    chemin_zip_tmp.unlink(missing_ok=True)
                    _terminer(False, message)
                    return
                # Dézippage + écrasement -- opération disque courte pour
                # ce volume de données (dossiers de sous-projets texte/
                # config, pas de médias volumineux comme un profil
                # navigateur complet), traitée directement ici plutôt que
                # dans un QThread dédié, cohérent avec _sur_resultat de
                # _lancer_prochain_telechargement_meta juste au-dessus
                # (parsing JSON reçu directement dans le callback Qt).
                dossier_racine = Path(chemin_racine_local)
                dossier_extrait_tmp = Path(tempfile.gettempdir()) / f"autoniax_batch_traite_extrait_{uuid.uuid4().hex}"
                try:
                    shutil.unpack_archive(str(chemin_zip_tmp), str(dossier_extrait_tmp), "zip")
                    # Écrasement réel : vide d'abord chemin_racine_local
                    # (rmtree puis recréation), PUIS copie le contenu
                    # extrait par-dessus -- pas une fusion, un remplacement
                    # complet (cf. cahier des charges E.2 : "écrase les
                    # données locales de l'ancien batch non traité").
                    if dossier_racine.exists():
                        shutil.rmtree(dossier_racine)
                    dossier_racine.mkdir(parents=True, exist_ok=True)
                    for element in dossier_extrait_tmp.iterdir():
                        destination = dossier_racine / element.name
                        if element.is_dir():
                            shutil.copytree(element, destination)
                        else:
                            shutil.copy2(element, destination)
                    _terminer(True, "")
                except Exception as e:
                    _terminer(False, f"Échec de l'extraction/écrasement local : {e!r}")
                finally:
                    chemin_zip_tmp.unlink(missing_ok=True)
                    shutil.rmtree(dossier_extrait_tmp, ignore_errors=True)

            self.client_serveur_t.telechargement_fichier_resultat.connect(_sur_resultat)
            self.client_serveur_t.telecharger_fichier(cle_zip, str(chemin_zip_tmp))

        def _sur_demande_telechargement_batch_traite(prefixe_b2: str, chemin_racine_local: str):
            self._file_attente_batch_traite.append((prefixe_b2, chemin_racine_local))
            _lancer_prochain_telechargement_batch_traite()

        reseau_screen.demande_telechargement_batch_traite.connect(_sur_demande_telechargement_batch_traite)

        # PATCH E.2 -- alimente BatchTraiteScreen en ProjetBatch locaux
        # (résolution nom -> chemin_racine, cf. docstring de la classe).
        # Rafraîchi à chaque demande_liste_stockage de cet écran (premier
        # affichage + clic "Actualiser", cf. BatchTraiteScreen.showEvent)
        # plutôt qu'une seule fois au démarrage -- self.project.projets_
        # batch peut changer en cours de session (nouveaux ProjetBatch
        # créés via _creer_projet_batch), une liste figée au lancement de
        # MainWindow deviendrait vite obsolète.
        def _rafraichir_projets_batch_locaux_pour_batch_traite():
            projets = self.project.projets_batch if self.project else []
            reseau_screen.batch_traite_screen.definir_projets_batch_locaux([
                {"id": p.id, "nom": p.nom, "chemin_racine": p.chemin_racine} for p in projets
            ])

        reseau_screen.batch_traite_screen.demande_liste_stockage.connect(
            _rafraichir_projets_batch_locaux_pour_batch_traite
        )
        _rafraichir_projets_batch_locaux_pour_batch_traite()

        self.client_serveur_t.demarrer()

        # Écran Api2Api (8ème section sidebar, cf. Api2Api_ecran_
        # specification.md en entier). Construit ICI (après reseau_screen
        # et self.client_serveur_t juste au-dessus, et après dashboard_
        # screen tout en haut de cette méthode) car cet écran a besoin des
        # DEUX pour son câblage : self.client_serveur_t (injection tardive,
        # cf. definir_client_serveur_t -- pour Api2Api()/textFile() dans
        # le namespace d'un Task lancé depuis cet écran, cf. spec section
        # 2.2/4.2) et dashboard_screen.profils_instances_screen (jamais
        # référencé directement par l'écran lui-même -- seulement par
        # MainWindow, cf. spec section 4.1, "jamais d'appel direct entre
        # deux écrans-frères").
        #
        # RESEAU_DASHBOARD_DISPONIBLE (même garde que plus haut dans cette
        # méthode) : si websockets est absent, dashboard_screen est un
        # PlaceholderScreen sans profils_instances_screen ni client_reseau
        # -- Api2ApiScreen reste alors utilisable (créer/éditer des lignes,
        # cf. spec) mais Démarrer échouera proprement au clic (le profil ne
        # pourra jamais être confirmé actif, cf. sur_instance_id_connu
        # jamais appelée dans ce cas) plutôt que de crasher à la construction.
        api2api_screen = Api2ApiScreen(self.project, self.reglages)
        api2api_screen.definir_client_serveur_t(self.client_serveur_t)

        # PATCH (demande explicite utilisateur : "mettre en indice sur
        # l'icone de la sidebar le nombre de taskapi2api en cours") --
        # même patron que le câblage pastille réseau (cf. self.client_
        # serveur_t.connecte/deconnecte -> sidebar.definir_statut_
        # serveur_t plus haut dans cette méthode) : indépendant de
        # RESEAU_DASHBOARD_DISPONIBLE (le badge doit rester correct même
        # si le Dashboard réseau est indisponible -- Api2ApiScreen reste
        # utilisable dans ce cas, cf. commentaire juste au-dessus).
        api2api_screen.nombre_taches_en_cours_change.connect(
            self.sidebar.definir_nombre_api2api_en_cours
        )

        # Démarrer (cf. spec section 4.1, étape 1) : Api2ApiScreen n'a
        # jamais de référence directe à profils_instances_screen -- son
        # signal demande_demarrer_profil_local est routé ici vers la SEULE
        # source de vérité pour lancer un profil local (méthode privée
        # _lancer_instance_pour_profil, cf. spec section 2.1). Même
        # précédent déjà présent dans ce fichier : _sur_toggle_fermer_
        # instances plus haut dans cette méthode appelle déjà directement
        # une méthode préfixée "_" de dashboard_screen.profils_instances_
        # screen -- ce n'est donc pas une nouvelle exception au patron
        # d'encapsulation, c'est le patron déjà utilisé ailleurs dans ce
        # fichier précis.
        if RESEAU_DASHBOARD_DISPONIBLE:
            api2api_screen.demande_demarrer_profil_local.connect(
                lambda nom_profil: dashboard_screen.profils_instances_screen._lancer_instance_pour_profil(nom_profil)
            )

            # PATCH (mode local dans le panneau clone -- cf. SPEC_mode_
            # clone_local.md, section 3.9) : "Kill" d'un profil local
            # depuis le panneau clone de TaskConfigScreen -- MÊME patron
            # EXACT que demande_demarrer_profil_local juste au-dessus
            # (même bloc RESEAU_DASHBOARD_DISPONIBLE, taskconfig_screen
            # construit après dashboard_screen dans cette méthode -- même
            # ordre déjà garanti pour Api2Api, réutilisé ici). La méthode
            # ciblée (_arreter_instance_pour_profil) est déjà complète et
            # autonome (shutdown réseau propre du navigateur + repli
            # process direct, gestion du thread, anti double-clic, cf. sa
            # docstring) -- rien à dupliquer ici, un simple relais suffit.
            taskconfig_screen.demande_kill_profil_local.connect(
                lambda nom_profil: dashboard_screen.profils_instances_screen._arreter_instance_pour_profil(nom_profil)
            )

            # Démarrer (cf. spec section 4.1, étape 2) : Api2ApiScreen doit
            # savoir QUAND un profil qu'elle attend devient actif côté
            # serveur, sans jamais accéder directement au client_reseau de
            # ProfilsInstancesScreen (point tranché après la spec initiale
            # -- cf. section 6 "hors scope", qui laissait ce mécanisme
            # ouvert). Relais choisi : le MÊME signal brut client_reseau.
            # liste_instances_recue (déjà écouté par ProfilsInstancesScreen.
            # _sur_liste_instances_recue, qui tient à jour self._instance_id_
            # par_profil, cf. cette méthode) est aussi écouté ici par
            # MainWindow -- APRÈS que ProfilsInstancesScreen ait eu la
            # chance de traiter le même signal (connexions Qt appelées dans
            # l'ordre de connexion pour un même signal), donc self._instance_
            # id_par_profil est déjà à jour au moment où ce wrapper tourne.
            #
            # BUGFIX (retour utilisateur : "je suis obligé de démarrer le
            # profil d'abord") -- synchroniser_instances_actives() REMPLACE
            # d'abord ENTIÈREMENT le cache d'Api2ApiScreen avec l'état réel
            # et à jour (donc un profil devenu inactif entretemps disparaît
            # bien d'ici aussi, cf. sa docstring) ; sur_instance_id_connu()
            # ensuite, pour CHAQUE profil réellement actif, débloque les
            # démarrages en attente pour ce profil précis -- avant ce
            # correctif, sur_instance_id_connu était le seul appel et ne
            # faisait qu'ajouter/écraser une clé, jamais retirer les autres,
            # laissant les profils fermés entretemps marqués actifs à tort.
            def _relayer_instances_vers_api2api(_instances):
                instances_actives = dict(dashboard_screen.profils_instances_screen._instance_id_par_profil)
                api2api_screen.synchroniser_instances_actives(instances_actives)
                for nom_profil, instance_id in instances_actives.items():
                    api2api_screen.sur_instance_id_connu(nom_profil, instance_id)

            if dashboard_screen.profils_instances_screen.client_reseau is not None:
                dashboard_screen.profils_instances_screen.client_reseau.liste_instances_recue.connect(
                    _relayer_instances_vers_api2api
                )
                # BUGFIX (suite) -- synchronise aussi IMMÉDIATEMENT à la
                # construction, pas seulement au PROCHAIN signal réseau :
                # sans cet appel, une instance déjà active AVANT même
                # l'ouverture de l'écran Api2Api (profil lancé depuis
                # Dashboard, ou instance orpheline découverte dès le tout
                # premier instances_list, cf. ProfilsInstancesScreen.
                # _sur_liste_instances_recue) ne serait connue d'Api2ApiScreen
                # qu'au signal réseau SUIVANT (un changement quelconque côté
                # serveur), potentiellement jamais pendant toute une session
                # calme -- le cache resterait vide à tort entre-temps.
                _relayer_instances_vers_api2api([])

        self.screens["api2api"] = api2api_screen
        self.content_stack.addWidget(api2api_screen)

        # AJOUT (demande explicite utilisateur : "quand je clic sur sont
        # naviatuer, quand sa prend le focus, sont profils dans le panneau
        # de clone est en surbrillance") -- relais du focus OS détecté par
        # ProfilsInstancesScreen (Dashboard) vers PanneauExecutionClone
        # (TaskConfigScreen), même patron "jamais d'appel direct entre
        # écrans-frères" que les autres relais ci-dessus. VOLONTAIREMENT
        # posé HORS du bloc `if RESEAU_DASHBOARD_DISPONIBLE:` ci-dessus :
        # la détection de focus (cf. ProfilsInstancesScreen.__init__, timer
        # _minuteur_focus_navigateur posé AVANT son propre early-return sur
        # RESEAU_DASHBOARD_DISPONIBLE) ne dépend ni de websockets ni du
        # serveur local -- conditionner ce relais de la même façon aurait
        # cassé la fonctionnalité pour tout utilisateur sans 'websockets'
        # installé, alors qu'elle n'en a structurellement pas besoin.
        #
        # LOG DIAGNOSTIC : confirme au démarrage que la connexion Qt a
        # bien été établie -- si un test de focus ne montre AUCUNE
        # surbrillance, vérifier D'ABORD que cette ligne apparaît bien au
        # lancement (sinon le problème est ici, pas plus loin).
        dashboard_screen.profils_instances_screen.focus_navigateur_local_change.connect(
            taskconfig_screen.panneau_clone._sur_focus_navigateur_local_change
        )
        log_dashboard_ui.info(
            "[FOCUS-NAVIGATEUR] relais MainWindow câblé : "
            "dashboard_screen.profils_instances_screen.focus_navigateur_local_change "
            "-> taskconfig_screen.panneau_clone._sur_focus_navigateur_local_change"
        )

        # Écran Corbeille (dernière section sidebar, cf. Sidebar.
        # SECTIONS -- "tu met licone de corbeille en dernier bas de
        # classement"). Son contenu est reconstruit à chaque navigation
        # vers cette section (cf. _show_screen), pas besoin de connexion
        # supplémentaire ici : la construction initiale suffit à afficher
        # l'état au démarrage (corbeille vide ou reprise d'un projet déjà
        # sauvegardé avec des entrées en attente).
        corbeille_screen = CorbeilleScreen(self.project)
        # AJOUT (spec B.4) -- câblage inter-écrans, même patron que les
        # autres connexions de ce type dans MainWindow (ex.
        # demande_ouvrir_rendu_reseau ci-dessus) : seule MainWindow connaît
        # à la fois CorbeilleScreen et l'écran des tâches. Rappelle
        # _reload_grille() sur taskconfig_screen (déjà construit plus haut,
        # cf. self.screens["taskconfig"]) uniquement quand une "task" a été
        # restaurée -- sans ce câblage, une task restaurée depuis la
        # corbeille restait invisible dans la grille jusqu'au prochain
        # redémarrage complet de l'application.
        corbeille_screen.restauration_corbeille_effectuee.connect(
            self._sur_restauration_corbeille_effectuee
        )
        self.screens["corbeille"] = corbeille_screen
        self.content_stack.addWidget(corbeille_screen)

    def _sur_restauration_corbeille_effectuee(self, type_element: str):
        """AJOUT (spec B.4) -- slot câblé à CorbeilleScreen.restauration_
        corbeille_effectuee (cf. sa docstring de signal). Ne rappelle
        _reload_grille() que pour type_element == "task" : c'est la seule
        vue affectée par le bug rapporté (grille de cartes de tâches).
        Élargi ici comme suggéré par la spec (raisonnement symétrique) aux
        éléments "composant"/"service_api"/"composant_layout" (BUGFIX --
        ce dernier ajouté en même temps que Project.remove_composant_
        layout se met à passer par la corbeille, cf. sa docstring), qui
        vivent tous dans la MÊME clé self.screens["api"] (ServiceAPIScreen,
        cf. sa classe -- pas d'écran séparé pour les ComposantLayout) --
        no-op silencieux si cet écran n'est pas encore construit."""
        taskconfig_screen = self.screens.get("taskconfig")
        if type_element == "task" and isinstance(taskconfig_screen, TaskConfigScreen):
            taskconfig_screen._reload_grille()
            return
        if type_element in ("composant", "service_api", "composant_layout"):
            service_api_screen = self.screens.get("api")
            if service_api_screen is not None and hasattr(service_api_screen, "_reload_grille"):
                service_api_screen._reload_grille()
            return

    def closeEvent(self, event):
        """Arrêt propre du Dashboard réseau (12.4) avant fermeture de la
        fenêtre. Ordre CRITIQUE, ne pas inverser (cf. diagnostic terminate()
        dans dashboard_client_reseau.py) :
          1. dashboard.arreter_tout() -- ferme le websocket, et ne tue les
             process instance QUE si le réglage "Fermer les instances à la
             fermeture de l'app" est activé (cf. ReglagesApp.
             fermer_instances_a_fermeture, désactivé par défaut).
          2. Le process serveur central, tué INCONDITIONNELLEMENT (demande
             explicite utilisateur -- ancien réglage
             "Éteindre le serveur à la fermeture de l'app" supprimé :
             fermer AutoniaX ferme désormais toujours le serveur, ce qui
             est sans risque pour les instances laissées ouvertes puisque
             chacune retente sa propre reconnexion automatique toutes les
             5s tant qu'elle reste ouverte, cf. boucle de retry dans
             _main_async).
        """
        # PATCH (raccourci global pynput "toujours_arriere_plan_toggle")
        # -- arrêt du listener AVANT tout le reste : c'est un thread
        # daemon indépendant de la fenêtre, sans dépendance sur l'ordre
        # dashboard/serveur ci-dessous, autant le stopper tôt et ne plus
        # y penser (même esprit que le commentaire juste en dessous).
        ancien_listener = getattr(self, "_hotkey_globale_arriere_plan", None)
        if ancien_listener is not None:
            try:
                ancien_listener.stop()
            except Exception:
                pass
            self._hotkey_globale_arriere_plan = None

        # BUGFIX (persistance du profil de test sélectionné, non sauvegardée
        # à la fermeture directe de l'app) -- cf. docstring complète de
        # ApplicationsScreen.arreter_tout_avant_fermeture_app. Fait AVANT
        # tout le reste de cette méthode : n'a aucune dépendance sur l'ordre
        # dashboard/serveur ci-dessous (ReglagesApp.save() est un simple
        # écrit fichier synchrone, indépendant du réseau), autant le faire
        # tôt et ne plus y penser.
        applications_screen = self.screens.get("applications")
        if isinstance(applications_screen, ApplicationsScreen):
            applications_screen.arreter_tout_avant_fermeture_app()

        dashboard_screen = self.screens.get("dashboard")
        log_dashboard_ui.info(
            f"[CLOSE-EVENT] MainWindow.closeEvent déclenché -- dashboard_screen={dashboard_screen!r} "
            f"(type={type(dashboard_screen).__name__}), isinstance(DashboardScreen)={isinstance(dashboard_screen, DashboardScreen)!r}"
        )
        if isinstance(dashboard_screen, DashboardScreen):
            dashboard_screen.arreter_tout()

        # Client serveurT (cf. démarrage dans __init__) : arrêté ici,
        # AVANT que les widgets de reseau_screen ne soient détruits par
        # la fermeture de la fenêtre -- sinon un signal nombre_executants_
        # change émis depuis le thread réseau pendant la fermeture pourrait
        # tenter d'atteindre un widget déjà supprimé.
        # PATCH (SPEC_proxy_natif_tunnel.md, section 7) : ServiceSortieProxy
        # AVANT client_serveur_t.arreter() -- il dépend de sa boucle réseau
        # (cf. ServiceSortieProxy.__init__, `boucle_fournisseur`) encore
        # vivante pour fermer proprement sa propre connexion /ws_tunnel.
        if hasattr(self, "service_sortie_proxy"):
            self.service_sortie_proxy.arreter()
        if hasattr(self, "client_serveur_t"):
            self.client_serveur_t.arreter()

        if self._process_serveur_dashboard is not None:
            self._process_serveur_dashboard.terminate()
            try:
                self._process_serveur_dashboard.wait(timeout=3.0)
            except subprocess.TimeoutExpired:
                log_dashboard_ui.warning("Le process serveur n'a pas répondu à terminate() -> kill()")
                self._process_serveur_dashboard.kill()
                self._process_serveur_dashboard.wait(timeout=3.0)
            self._process_serveur_dashboard = None

        # Le serveur est déjà mort à ce stade (terminate()/kill() ci-dessus) :
        # fermer ce handle ne déclenche donc plus rien via
        # JOB_OBJECT_LIMIT_KILL_ON_JOB_CLOSE, ça évite juste une fuite de
        # handle. Si on ne le faisait pas, Windows le fermerait de toute
        # façon à la fin du process -- mais autant nettoyer explicitement
        # puisqu'on a la main ici.
        if self._job_object_serveur is not None:
            try:
                ctypes.windll.kernel32.CloseHandle(self._job_object_serveur)
            except OSError:
                pass
            self._job_object_serveur = None

        super().closeEvent(event)

    def changeEvent(self, event):
        """PATCH (fenêtre maximisée au démarrage, cf. __init__) -- aligne
        AutoniaXTitleBar (icône Agrandir/Restaurer + son drapeau interne
        _maximized) sur l'état RÉEL de la fenêtre à chaque changement,
        quelle qu'en soit la cause : maximisation au démarrage, bouton de
        la barre, double-clic, raccourci système (Win+Flèche), restauration
        après hide()/show()...

        POURQUOI c'est indispensable : sync_maximized_state() existait
        déjà (sa docstring prévoyait ce cas : "restauration de layout au
        démarrage") mais n'était appelée par personne. Sans ce
        changeEvent, la fenêtre démarre maximisée mais la barre croit
        encore qu'elle est en taille normale : l'icône affiche "Agrandir"
        au lieu de "Restaurer", et le PREMIER clic sur ce bouton rappelle
        showMaximized() sur une fenêtre déjà maximisée -- il ne se passe
        rien, il faut cliquer une seconde fois (bug reproduit avant
        correction). QEvent.WindowStateChange est émis par Qt à chaque
        transition, donc aucune autre source d'état à maintenir à la main."""
        super().changeEvent(event)
        if event.type() == QEvent.Type.WindowStateChange:
            barre = getattr(self, "_title_bar", None)
            if barre is not None:
                barre.sync_maximized_state(self.isMaximized())
            self._maj_poignees_redimensionnement()   # PATCH13
            self._log_fenetre("WindowStateChange")   # PATCH16
            try:   # PATCH16 : re-maximisation spontanee juste apres une restauration
                import time as _t
                t0 = getattr(self, "_restauration_demandee_a", None)
                tm = getattr(self, "_max_voulue_a", None)
                if (t0 is not None and self.isMaximized()
                        and (tm is None or tm < t0)
                        and _t.monotonic() - t0 < 0.6
                        and not getattr(self, "_restauration_reessayee", True)):
                    self._restauration_reessayee = True
                    self._log_fenetre("re-maximisation spontanee (ignoree, PATCH18)")
            except Exception:
                pass
            try:   # PATCH14 : restauree mais toujours a la taille agrandie -> corriger
                if event.oldState() & Qt.WindowState.WindowMaximized and not self.isMaximized():
                    QTimer.singleShot(0, self._corriger_si_pleine_taille)
                    QTimer.singleShot(80, self._corriger_si_pleine_taille)
            except Exception:
                pass
            # PATCH12 : revenue en taille normale hors de tout écran -> recentrer.
            try:
                if not (self.isMaximized() or self.isMinimized() or self.isFullScreen()) and self.isVisible():
                    zone = self.frameGeometry()
                    if not any(s.availableGeometry().intersects(zone) for s in QApplication.screens()):
                        ecran = QApplication.primaryScreen().availableGeometry()
                        zone.moveCenter(ecran.center())
                        self.move(zone.topLeft())
            except Exception:
                pass

    _RESIZE_NATIF_WM_NCHITTEST = False   # PATCH13

    def resizeEvent(self, event):
        super().resizeEvent(event)
        self._log_fenetre("resizeEvent %dx%d (ancien %dx%d)" % (
            event.size().width(), event.size().height(),
            event.oldSize().width(), event.oldSize().height()))   # PATCH17
        self._maj_poignees_redimensionnement()   # PATCH13
        self._memoriser_rect_normal()            # PATCH14

    def moveEvent(self, event):
        super().moveEvent(event)
        self._memoriser_rect_normal()            # PATCH14

    # ---- PATCH14 : taille "normale" geree explicitement -------------------
    # Cause : la fenetre est maximisee AVANT son premier show() puis son
    # handle natif est recree (setWindowFlags). Windows/Qt perdent alors la
    # taille a restaurer : "Restaurer" revenait a la taille agrandie (rien ne
    # bougeait). On memorise donc nous-memes la taille normale et on la
    # reapplique a chaque restauration.
    def _zone_ecran(self):
        try:
            ecran = self.screen() or QApplication.primaryScreen()
            return ecran.availableGeometry()
        except Exception:
            return QRect(0, 0, 1280, 800)

    def _est_pleine_taille(self, r):
        z = self._zone_ecran()
        return r.width() >= z.width() - 20 and r.height() >= z.height() - 20

    def _rect_normal_par_defaut(self):
        z = self._zone_ecran()
        l = min(1280, max(self.minimumWidth(), z.width() - 120))
        h = min(800, max(self.minimumHeight(), z.height() - 120))
        r = QRect(0, 0, l, h)
        r.moveCenter(z.center())
        return r

    def _memoriser_rect_normal(self):
        try:
            if (not self.isVisible() or self.isMaximized() or self.isFullScreen()
                    or self.isMinimized()):
                return
            g = self.geometry()
            if self._est_pleine_taille(g):   # transition en cours : on ignore
                return
            self._rect_normal = QRect(g)
        except Exception:
            pass

    def _corriger_si_pleine_taille(self):
        try:
            if self.isMaximized() or self.isFullScreen() or self.isMinimized():
                return
            if self._est_pleine_taille(self.geometry()):
                self.setGeometry(self._rect_normal)
        except Exception:
            pass

    def _log_fenetre(self, msg):
        """PATCH21 : diagnostic retire (ni console, ni fichier)."""
        return

    def showMaximized(self):   # PATCH16 : trace de qui demande l'agrandissement
        import time as _t
        self._max_voulue_a = _t.monotonic()   # agrandissement explicite
        super().showMaximized()

    def _hwnd_natif(self):
        try:
            return int(self.winId())
        except Exception:
            return 0

    def _est_agrandie(self):
        """PATCH18 : verite Windows (IsZoomed), pas le drapeau Qt qui peut etre perime."""
        if sys.platform == "win32":
            try:
                import ctypes
                if ctypes.windll.user32.IsZoomed(self._hwnd_natif()):
                    return True
                # PATCH19 : agrandie par Qt (deplacement manuel, pas WS_MAXIMIZE)
                return bool(self.isMaximized() and self._est_pleine_taille(self.geometry()))
            except Exception:
                pass
        return self.isMaximized()

    def _synchroniser_barre(self):
        try:
            self._title_bar.sync_maximized_state(self._est_agrandie())
        except Exception:
            pass

    def _rect_physique_windows(self, rect):
        """rect logique Qt -> (x, y, l, h) en pixels physiques + infos moniteur."""
        import ctypes
        from ctypes import wintypes

        class MONITORINFO(ctypes.Structure):
            _fields_ = [("cbSize", wintypes.DWORD), ("rcMonitor", wintypes.RECT),
                        ("rcWork", wintypes.RECT), ("dwFlags", wintypes.DWORD)]
        user32 = ctypes.windll.user32
        hmon = user32.MonitorFromWindow(wintypes.HWND(self._hwnd_natif()), 2)
        mi = MONITORINFO(); mi.cbSize = ctypes.sizeof(MONITORINFO)
        user32.GetMonitorInfoW(hmon, ctypes.byref(mi))
        scr = (self.screen() or QApplication.primaryScreen()).geometry()
        dpr = self.devicePixelRatioF()
        x = mi.rcMonitor.left + int(round((rect.x() - scr.x()) * dpr))
        y = mi.rcMonitor.top + int(round((rect.y() - scr.y()) * dpr))
        return x, y, int(round(rect.width() * dpr)), int(round(rect.height() * dpr)), mi

    def _definir_rect_restauration_natif(self, rect):
        """Ecrit rcNormalPosition (taille a restaurer) SANS changer l'etat."""
        import ctypes
        from ctypes import wintypes

        class POINT(ctypes.Structure):
            _fields_ = [("x", ctypes.c_long), ("y", ctypes.c_long)]

        class WINDOWPLACEMENT(ctypes.Structure):
            _fields_ = [("length", wintypes.UINT), ("flags", wintypes.UINT),
                        ("showCmd", wintypes.UINT), ("ptMinPosition", POINT),
                        ("ptMaxPosition", POINT), ("rcNormalPosition", wintypes.RECT)]
        user32 = ctypes.windll.user32
        hwnd = wintypes.HWND(self._hwnd_natif())
        x, y, l, h, mi = self._rect_physique_windows(rect)
        wp = WINDOWPLACEMENT(); wp.length = ctypes.sizeof(WINDOWPLACEMENT)
        if not user32.GetWindowPlacement(hwnd, ctypes.byref(wp)):
            return
        wp.rcNormalPosition.left = x - mi.rcWork.left     # coordonnees "espace de travail"
        wp.rcNormalPosition.top = y - mi.rcWork.top
        wp.rcNormalPosition.right = wp.rcNormalPosition.left + l
        wp.rcNormalPosition.bottom = wp.rcNormalPosition.top + h
        user32.SetWindowPlacement(hwnd, ctypes.byref(wp))
        self._log_fenetre("placement natif = %d,%d %dx%d (showCmd=%d)" % (x, y, l, h, wp.showCmd))

    def _restaurer_natif(self):
        import time as _t
        self._restauration_demandee_a = _t.monotonic()
        self._restauration_reessayee = True
        self._essais_restauration = 0
        if sys.platform == "win32":
            import ctypes
            if ctypes.windll.user32.IsZoomed(self._hwnd_natif()):
                self._definir_rect_restauration_natif(self._rect_normal)
                ctypes.windll.user32.ShowWindow(self._hwnd_natif(), 9)   # SW_RESTORE
                self._log_fenetre("ShowWindow(SW_RESTORE) fait")
            else:   # PATCH19 : agrandie 'a la Qt' -> showNormal, taille posee en differe
                self._log_fenetre("restauration Qt (non zoomed)")
                self.showNormal()
        else:
            self.showNormal()
            self.setGeometry(self._rect_normal)
        for d in (40, 150, 400):
            QTimer.singleShot(d, self._corriger_apres_restauration)
        QTimer.singleShot(60, self._synchroniser_barre)

    def _corriger_apres_restauration(self):
        try:
            self._essais_restauration = getattr(self, "_essais_restauration", 0) + 1
            if self._est_agrandie() or self.isMinimized() or self.isFullScreen():
                return
            g = self.geometry()
            self._log_fenetre("verif restauration #%d" % self._essais_restauration)
            if not self._est_pleine_taille(g):
                return
            if self._essais_restauration < 3 or sys.platform != "win32":
                self.setGeometry(self._rect_normal)
            else:
                import ctypes
                x, y, l, h, _mi = self._rect_physique_windows(self._rect_normal)
                # SWP_NOZORDER | SWP_NOACTIVATE
                ctypes.windll.user32.SetWindowPos(self._hwnd_natif(), 0, x, y, l, h, 0x0004 | 0x0010)
                self._log_fenetre("SetWindowPos natif %d,%d %dx%d" % (x, y, l, h))
        except Exception:
            pass

    def _basculer_agrandir(self):
        self._log_fenetre("bouton (avant) zoomed=%s" % self._est_agrandie())
        if self._est_agrandie():
            self._restaurer_natif()
        else:
            self._memoriser_rect_normal()
            if sys.platform == "win32":   # PATCH19 : vrai agrandissement natif
                import ctypes
                self._max_voulue_a = __import__("time").monotonic()
                ctypes.windll.user32.ShowWindow(self._hwnd_natif(), 3)   # SW_MAXIMIZE
                self._log_fenetre("ShowWindow(SW_MAXIMIZE) fait")
            else:
                self.showMaximized()
            QTimer.singleShot(80, self._verifier_maximisation)
            QTimer.singleShot(60, self._synchroniser_barre)
            QTimer.singleShot(200, self._synchroniser_barre)

    def _restaurer_force(self):   # PATCH16
        try:
            self.showNormal()
            self.setGeometry(self._rect_normal)
        except Exception:
            pass

    def _ecrire_placement_normal_windows(self):
        """PATCH16 : fixe la taille de restauration NATIVE (rcNormalPosition)."""
        if sys.platform != "win32":
            return
        try:
            import ctypes
            from ctypes import wintypes
            user32 = ctypes.windll.user32
            hwnd = int(self.winId())

            class POINT(ctypes.Structure):
                _fields_ = [("x", ctypes.c_long), ("y", ctypes.c_long)]

            class WINDOWPLACEMENT(ctypes.Structure):
                _fields_ = [("length", wintypes.UINT), ("flags", wintypes.UINT),
                            ("showCmd", wintypes.UINT), ("ptMinPosition", POINT),
                            ("ptMaxPosition", POINT), ("rcNormalPosition", wintypes.RECT)]

            class MONITORINFO(ctypes.Structure):
                _fields_ = [("cbSize", wintypes.DWORD), ("rcMonitor", wintypes.RECT),
                            ("rcWork", wintypes.RECT), ("dwFlags", wintypes.DWORD)]

            hmon = user32.MonitorFromWindow(wintypes.HWND(hwnd), 2)   # NEAREST
            mi = MONITORINFO(); mi.cbSize = ctypes.sizeof(MONITORINFO)
            if not user32.GetMonitorInfoW(hmon, ctypes.byref(mi)):
                return
            tw = mi.rcWork.right - mi.rcWork.left
            th = mi.rcWork.bottom - mi.rcWork.top
            dpr = self.devicePixelRatioF()
            l = min(int(1280 * dpr), max(int(self.minimumWidth() * dpr), tw - 120))
            h = min(int(800 * dpr), max(int(self.minimumHeight() * dpr), th - 120))
            x = mi.rcWork.left + (tw - l) // 2
            y = mi.rcWork.top + (th - h) // 2
            wp = WINDOWPLACEMENT(); wp.length = ctypes.sizeof(WINDOWPLACEMENT)
            if not user32.GetWindowPlacement(wintypes.HWND(hwnd), ctypes.byref(wp)):
                return
            # rcNormalPosition est en coordonnees "espace de travail" : on retire
            # le decalage barre des taches / ecran.
            dx = mi.rcWork.left - mi.rcMonitor.left
            dy = mi.rcWork.top - mi.rcMonitor.top
            wp.rcNormalPosition.left = x - mi.rcMonitor.left - dx
            wp.rcNormalPosition.top = y - mi.rcMonitor.top - dy
            wp.rcNormalPosition.right = wp.rcNormalPosition.left + l
            wp.rcNormalPosition.bottom = wp.rcNormalPosition.top + h
            user32.SetWindowPlacement(wintypes.HWND(hwnd), ctypes.byref(wp))
            self._log_fenetre("placement natif ecrit %dx%d" % (l, h))
        except Exception:
            pass

    def _verifier_maximisation(self):
        """Etat Qt 'maximise' mais fenetre restee petite : on force."""
        if sys.platform == "win32":   # PATCH18 : Windows gere seul, on journalise seulement
            self._log_fenetre("verif maximisation (aucune action) zoomed=%s" % self._est_agrandie())
            return
        try:
            if self.isMaximized() and not self._est_pleine_taille(self.geometry()):
                self.showNormal()
                self.setGeometry(self._rect_normal)
                self.showMaximized()
        except Exception:
            pass

    def _maj_poignees_redimensionnement(self):
        """PATCH13 : crée (une fois) et repositionne les 8 poignées."""
        try:
            poignees = getattr(self, "_poignees_redim", None)
            if poignees is None:
                E = Qt.Edge
                C = Qt.CursorShape
                poignees = {
                    "haut": PoigneeRedimensionFenetre(self, E.TopEdge, C.SizeVerCursor),
                    "bas": PoigneeRedimensionFenetre(self, E.BottomEdge, C.SizeVerCursor),
                    "gauche": PoigneeRedimensionFenetre(self, E.LeftEdge, C.SizeHorCursor),
                    "droite": PoigneeRedimensionFenetre(self, E.RightEdge, C.SizeHorCursor),
                    "haut_gauche": PoigneeRedimensionFenetre(self, E.TopEdge | E.LeftEdge, C.SizeFDiagCursor),
                    "haut_droite": PoigneeRedimensionFenetre(self, E.TopEdge | E.RightEdge, C.SizeBDiagCursor),
                    "bas_gauche": PoigneeRedimensionFenetre(self, E.BottomEdge | E.LeftEdge, C.SizeBDiagCursor),
                    "bas_droite": PoigneeRedimensionFenetre(self, E.BottomEdge | E.RightEdge, C.SizeFDiagCursor),
                }
                self._poignees_redim = poignees
            w, h, b, c = self.width(), self.height(), 5, 12
            rects = {
                "haut": (c, 0, w - 2 * c, b), "bas": (c, h - b, w - 2 * c, b),
                "gauche": (0, c, b, h - 2 * c), "droite": (w - b, c, b, h - 2 * c),
                "haut_gauche": (0, 0, c, c), "haut_droite": (w - c, 0, c, c),
                "bas_gauche": (0, h - c, c, c), "bas_droite": (w - c, h - c, c, c),
            }
            actif = self.isVisible() and not (self.isMaximized() or self.isFullScreen() or self.isMinimized())
            for nom, p in poignees.items():
                x, y, ww, hh = rects[nom]
                p.setGeometry(x, y, max(1, ww), max(1, hh))
                p.setVisible(actif)
                if actif:
                    p.raise_()
        except Exception:
            pass

    def showEvent(self, event):
        """PATCH12 : styles natifs pour que le clic sur l'icône de la barre
        des tâches réduise/restaure la fenêtre (cf. docstring du patch)."""
        super().showEvent(event)
        self._log_fenetre("showEvent")   # PATCH17
        self._appliquer_styles_barre_des_taches()
        self._maj_poignees_redimensionnement()   # PATCH13
        if not self._etat_initial_verifie:       # PATCH14
            self._etat_initial_verifie = True
            self._ecrire_placement_normal_windows()   # PATCH16
            QTimer.singleShot(200, self._verifier_maximisation)

    def _appliquer_styles_barre_des_taches(self):
        if sys.platform != "win32":
            return
        try:
            import ctypes
            hwnd = int(self.winId())
            user32 = ctypes.windll.user32
            GWL_STYLE = -16
            WS_MINIMIZEBOX, WS_MAXIMIZEBOX, WS_SYSMENU = 0x00020000, 0x00010000, 0x00080000
            get = getattr(user32, "GetWindowLongPtrW", user32.GetWindowLongW)
            setl = getattr(user32, "SetWindowLongPtrW", user32.SetWindowLongW)
            style = get(hwnd, GWL_STYLE)
            voulu = style | WS_MINIMIZEBOX | WS_MAXIMIZEBOX | WS_SYSMENU
            if voulu != style:
                setl(hwnd, GWL_STYLE, voulu)
                # SWP_NOMOVE|NOSIZE|NOZORDER|NOACTIVATE|FRAMECHANGED
                user32.SetWindowPos(hwnd, 0, 0, 0, 0, 0, 0x0002 | 0x0001 | 0x0004 | 0x0010 | 0x0020)
        except Exception:
            pass

    def nativeEvent(self, eventType, message):
        """WM_NCHITTEST override -- permet de redimensionner la fenêtre en
        tirant ses bords/coins alors qu'elle est FramelessWindowHint (sans
        ça, une fenêtre sans chrome natif ne peut plus être redimensionnée
        du tout à la souris, seul le resize par bord de Windows sait faire
        ça nativement). N'a d'effet que sous Windows -- sur les autres OS,
        nativeEvent retombe simplement sur le comportement Qt par défaut."""
        if sys.platform == "win32" and eventType == b"windows_generic_MSG":
            try:
                import ctypes.wintypes
                msg = ctypes.wintypes.MSG.from_address(int(message))
                WM_NCHITTEST = 0x0084
                if msg.message == WM_NCHITTEST:
                    x = ctypes.c_short(msg.lParam & 0xFFFF).value
                    y = ctypes.c_short((msg.lParam >> 16) & 0xFFFF).value
                    # PATCH12 : fenêtre maximisée/plein écran -> aucune zone de
                    # redimensionnement (sinon dé-maximisation native hors barre).
                    if (not getattr(self, "_RESIZE_NATIF_WM_NCHITTEST", False)   # PATCH13 : remplacé par les poignées
                            or self.isMaximized() or self.isFullScreen()):
                        return super().nativeEvent(eventType, message)
                    # PATCH12 : x/y du message sont en pixels PHYSIQUES ; on compare
                    # donc au rectangle natif (GetWindowRect), pas à self.geometry().
                    _r = ctypes.wintypes.RECT()
                    ctypes.windll.user32.GetWindowRect(msg.hWnd, ctypes.byref(_r))
                    BORDER = max(4, int(round(6 * self.devicePixelRatioF())))
                    left   = x < _r.left   + BORDER
                    right  = x >= _r.right  - BORDER
                    top    = y < _r.top    + BORDER
                    bottom = y >= _r.bottom - BORDER
                    HTLEFT, HTRIGHT, HTTOP = 10, 11, 12
                    HTTOPLEFT, HTTOPRIGHT = 13, 14
                    HTBOTTOM, HTBOTTOMLEFT, HTBOTTOMRIGHT = 15, 16, 17
                    if top and left:     return True, HTTOPLEFT
                    if top and right:    return True, HTTOPRIGHT
                    if bottom and left:  return True, HTBOTTOMLEFT
                    if bottom and right: return True, HTBOTTOMRIGHT
                    if top:              return True, HTTOP
                    if bottom:           return True, HTBOTTOM
                    if left:             return True, HTLEFT
                    if right:            return True, HTRIGHT
            except Exception:
                pass
        return super().nativeEvent(eventType, message)

