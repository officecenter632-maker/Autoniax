        self.floating_import_button = QToolButton(self.grille_page)
        self.floating_import_button.setObjectName("FloatingAddButton")
        self.floating_import_button.setIcon(qta.icon("mdi6.upload-outline", color=Mocha.crust))
        self.floating_import_button.setIconSize(QSize(22, 22))
        self.floating_import_button.setFixedSize(44, 44)
        self.floating_import_button.setCursor(Qt.PointingHandCursor)
        self.floating_import_button.setToolTip("Importer un notebook")
        self.floating_import_button.clicked.connect(self._demande_import_task)
        self.floating_import_button.raise_()

        self.grille_page.installEventFilter(self)

    # ------------------------------------------------------------------
    # Section « Lib » : fichiers Python purs stockés dans project.json (Project.libs). On ne les ouvre pas : clic droit ->
    # « Mettre à jour » remplace leur code par celui du presse-papiers.
    # ------------------------------------------------------------------
    def _build_panneau_lib(self):
        panneau = QWidget(self.grille_page)
        lay = QVBoxLayout(panneau)
        lay.setContentsMargins(0, 10, 0, 0)
        lay.setSpacing(6)
        entete = QHBoxLayout()
        entete.setSpacing(8)
        titre = QLabel("Lib", panneau)
        titre.setStyleSheet(f"color:{Mocha.text}; font-size:16px; font-weight:600;")
        entete.addWidget(titre)
        sous = QLabel("Fichiers Python — clic droit : mettre à jour depuis le presse-papiers", panneau)
        sous.setStyleSheet(f"color:{Mocha.subtext0}; font-size:12px;")
        entete.addWidget(sous, 1)
        self.bouton_nouvelle_lib = QToolButton(panneau)
        self.bouton_nouvelle_lib.setIcon(qta.icon("mdi6.plus", color=Mocha.text))
        self.bouton_nouvelle_lib.setToolTip("Nouvelle lib")
        self.bouton_nouvelle_lib.setCursor(Qt.PointingHandCursor)
        self.bouton_nouvelle_lib.clicked.connect(self._creer_lib)
        entete.addWidget(self.bouton_nouvelle_lib)
        lay.addLayout(entete)
        self.liste_libs = ListeLibsTroisColonnes(panneau)
        self.liste_libs.setFrameShape(QFrame.NoFrame)
        self.liste_libs.setContextMenuPolicy(Qt.CustomContextMenu)
        self.liste_libs.customContextMenuRequested.connect(self._menu_lib)
        self.liste_libs.itemDoubleClicked.connect(self._ouvrir_visionneuse_lib)
        self.liste_libs.setStyleSheet(
            f"QListWidget {{ background:{Mocha.mantle}; border:1px solid {Mocha.surface0}; border-radius:8px; padding:4px; color:{Mocha.text}; }}"
            f"QListWidget::item {{ padding:6px 8px; border-radius:6px; }}"
            f"QListWidget::item:selected {{ background:{Mocha.surface1}; color:{Mocha.text}; }}"
            f"QListWidget::item:hover {{ background:{Mocha.surface0}; }}"
        )
        lay.addWidget(self.liste_libs, 1)
        return panneau

    def _rafraichir_liste_libs(self):
        self._rafraichir_barre_libs()
        if not hasattr(self, "liste_libs"):
            return
        self.liste_libs.clear()
        for lib in sorted(self.project.libs, key=lambda l: l["nom"].lower()):
            nb = len(lib["code"].splitlines())
            item = QListWidgetItem(qta.icon("mdi6.language-python", color=Mocha.blue),
                                   f"{lib['nom']}.py    ({nb} lignes)" if lib["code"].strip() else f"{lib['nom']}.py    (vide)")
            item.setData(Qt.UserRole, lib["id"])
            item.setToolTip(f"Double-clic : voir le code\nPour l'utiliser : ouvrez un Task, bouton + de la bande Lib, puis `from {lib['nom']} import ...`\n\nModifiée le : {lib.get('modifie_le') or '—'}")
            self.liste_libs.addItem(item)
        for _fenetre in list((getattr(self, "_visionneuses_libs", None) or {}).values()):
            try:
                _fenetre.rafraichir()
            except RuntimeError:
                pass

    def _rafraichir_barre_libs(self):
        """Bande des libs IMPORTÉES dans le Task ouvert : [nom] [mettre à jour] [copier] [retirer], icônes seules."""
        if not hasattr(self, "barre_libs_contenu_layout"):
            return
        lay = self.barre_libs_contenu_layout
        while lay.count():
            w = lay.takeAt(0).widget()
            if w is not None:
                w.deleteLater()
        task = self._task_courant_obj()
        noms = list(getattr(task, "libs_importees", []) or []) if task is not None else []
        libs = [l for n in noms for l in [next((x for x in self.project.libs if x["nom"] == n), None)] if l is not None]
        if not libs:
            vide = QLabel("Aucune lib importée -- cliquez sur + pour en ajouter", self.barre_libs_contenu)
            vide.setStyleSheet(f"color:{Mocha.subtext0}; font-size:12px;")
            lay.addWidget(vide)
        for lib in libs:
            cadre = QWidget(self.barre_libs_contenu)
            cl = QHBoxLayout(cadre)
            cl.setContentsMargins(0, 0, 0, 0)
            cl.setSpacing(2)
            nom = QLabel(f"{lib['nom']}.py", cadre)
            nom.setStyleSheet(f"color:{Mocha.text}; font-size:12px;")
            nom.setToolTip(f"{len(lib['code'].splitlines())} lignes -- modifiée le {lib.get('modifie_le') or '—'}\nfrom {lib['nom']} import ...")
            cl.addWidget(nom)
            for icone, tip, action in (
                ("mdi6.clipboard-arrow-down-outline", "Mettre à jour depuis le presse-papiers", self._maj_lib_depuis_presse_papiers),
                ("mdi6.content-copy", "Copier le fichier .py", self._copier_code_lib),
                ("mdi6.close", "Retirer de ce Task", self._retirer_lib_du_task),
            ):
                b = QToolButton(cadre)
                b.setIcon(qta.icon(icone, color=Mocha.text))
                b.setToolTip(tip)
                b.setCursor(Qt.PointingHandCursor)
                b.setAutoRaise(True)
                b.clicked.connect(lambda _=False, i=lib["id"], a=action: a(i))
                cl.addWidget(b)
            lay.addWidget(cadre)
        lay.addStretch(1)

    def _menu_ajouter_lib_task(self):
        task = self._task_courant_obj()
        if task is None:
            return
        menu = QMenu(self.bouton_ajouter_lib_task)
        restantes = [l for l in sorted(self.project.libs, key=lambda l: l["nom"].lower()) if l["nom"] not in task.libs_importees]
        if not restantes:
            vide = menu.addAction("Aucune lib à ajouter (créez-en dans TaskConfig > Lib)")
            vide.setEnabled(False)
        for lib in restantes:
            menu.addAction(qta.icon("mdi6.language-python", color=Mocha.blue), f"{lib['nom']}.py",
                           lambda n=lib["nom"]: self._ajouter_lib_au_task(n))
        menu.exec(self.bouton_ajouter_lib_task.mapToGlobal(QPoint(0, self.bouton_ajouter_lib_task.height())))

    def _ajouter_lib_au_task(self, nom: str):
        task = self._task_courant_obj()
        if task is None or nom in task.libs_importees:
            return
        task.libs_importees.append(nom)
        self.project.save()
        self._rafraichir_barre_libs()
        self._notify_status(f"Lib « {nom}.py » importée dans ce Task (envoyée avec chaque cellule).")

    def _retirer_lib_du_task(self, lib_id: str):
        task = self._task_courant_obj()
        lib = self.project.find_lib(lib_id)
        if task is None or lib is None or lib["nom"] not in task.libs_importees:
            return
        task.libs_importees.remove(lib["nom"])
        self.project.save()
        self._rafraichir_barre_libs()

    def _copie_tout_cfg(self, task) -> dict:
        """PATCH I : config normalisée (et rattachée au Task) du bouton « Copier TOUT »."""
        cfg = getattr(task, "copie_tout_config", None)
        if not isinstance(cfg, dict):
            cfg = {}
            task.copie_tout_config = cfg
        if not isinstance(cfg.get("decoches"), list):
            cfg["decoches"] = []
        externes = cfg.get("externes")
        if not isinstance(externes, list):
            externes = []
        cfg["externes"] = [e for e in externes if isinstance(e, dict) and isinstance(e.get("chemin"), str) and e["chemin"]]
        return cfg

    def _ouvrir_selection_copie_tout(self, _pos=None):
        """PATCH I (clic droit sur « Copier TOUT ») : liste des fichiers copiés, cochables.
        Par défaut : toutes les libs importées, une ligne « notebook », une ligne « sorties », puis les fichiers externes ajoutés avec « + »
        (retirables de la liste, le fichier lui-même n'est jamais supprimé). SEULS les fichiers cochés sont copiés."""
        task = self._task_courant_obj()
        if task is None:
            return
        cfg = self._copie_tout_cfg(task)
        bouton = self.bouton_copier_tout_code
        nom_base = re.sub(r'[\\/:*?"<>|]+', "_", str(getattr(task, "nom", "") or "")).strip() or "notebook"

        popup = QFrame(self, Qt.Popup)
        popup.setObjectName("PopupCopieTout")
        popup.setAttribute(Qt.WA_DeleteOnClose, True)
        popup.setStyleSheet(
            f"#PopupCopieTout {{ background:{Mocha.base}; border:1px solid {Mocha.surface2}; border-radius:8px; }}"
            f"QCheckBox {{ color:{Mocha.text}; font-size:12px; spacing:6px; }}"
            f"QLabel {{ color:{Mocha.subtext0}; font-size:11px; }}"
            f"QToolButton {{ color:{Mocha.text}; font-size:12px; border:none; padding:3px 4px; }}"
            f"QToolButton:hover {{ background:{Mocha.surface1}; border-radius:4px; }}"
        )
        racine = QVBoxLayout(popup)
        racine.setContentsMargins(12, 10, 12, 10)
        racine.setSpacing(6)
        racine.addWidget(QLabel("Fichiers copiés par « Copier TOUT » (cochés = copiés)", popup))
        zone = QWidget(popup)
        zl = QVBoxLayout(zone)
        zl.setContentsMargins(0, 0, 0, 0)
        zl.setSpacing(3)
        racine.addWidget(zone)
        bouton_plus = QToolButton(popup)
        bouton_plus.setText("  Ajouter un fichier externe")
        bouton_plus.setToolButtonStyle(Qt.ToolButtonTextBesideIcon)
        bouton_plus.setCursor(Qt.PointingHandCursor)
        try:
            bouton_plus.setIcon(qta.icon("mdi6.plus", color=Mocha.text))
        except Exception:
            pass
        racine.addWidget(bouton_plus)

        def _icone(nom_icone, couleur):
            try:
                return qta.icon(nom_icone, color=couleur)
            except Exception:
                return QIcon()

        def sauver():
            self.project.save()

        def basculer_decoche(cle, coche):
            if coche:
                cfg["decoches"] = [d for d in cfg["decoches"] if d != cle]
            elif cle not in cfg["decoches"]:
                cfg["decoches"].append(cle)
            sauver()

        def basculer_externe(chemin, coche):
            for e in cfg["externes"]:
                if e["chemin"] == chemin:
                    e["coche"] = bool(coche)
            sauver()

        def retirer_externe(chemin):
            cfg["externes"] = [e for e in cfg["externes"] if e["chemin"] != chemin]
            sauver()
            reconstruire()

        def ajouter_ligne(libelle, nom_icone, couleur, coche, rappel, tip="", retirer=None):
            ligne = QWidget(zone)
            h = QHBoxLayout(ligne)
            h.setContentsMargins(0, 0, 0, 0)
            h.setSpacing(4)
            case = QCheckBox(libelle, ligne)
            case.setIcon(_icone(nom_icone, couleur))
            case.setChecked(bool(coche))
            case.setToolTip(tip)
            case.setCursor(Qt.PointingHandCursor)
            case.toggled.connect(rappel)
            h.addWidget(case, 1)
            if retirer is not None:
                b = QToolButton(ligne)
                b.setIcon(_icone("mdi6.close", Mocha.text))
                b.setToolTip("Retirer de cette liste (le fichier n'est pas supprimé)")
                b.setCursor(Qt.PointingHandCursor)
                b.setAutoRaise(True)
                b.clicked.connect(lambda _=False, f=retirer: f())
                h.addWidget(b)
            zl.addWidget(ligne)

        def reconstruire():
            while zl.count():
                w = zl.takeAt(0).widget()
                if w is not None:
                    w.deleteLater()
            decoches = set(cfg["decoches"])
            for nom in list(getattr(task, "libs_importees", []) or []):
                if not any(x["nom"] == nom for x in self.project.libs):
                    continue
                cle = f"lib:{nom}"
                ajouter_ligne(f"{nom}.py", "mdi6.language-python", Mocha.blue, cle not in decoches,
                              lambda c, k=cle: basculer_decoche(k, c), "Lib importée dans ce Task")
            ajouter_ligne(f"{nom_base}.py  (code du notebook)", "mdi6.notebook-outline", Mocha.green, "notebook" not in decoches,
                          lambda c: basculer_decoche("notebook", c), "Le code de toutes les cellules")
            ajouter_ligne(f"{nom_base}_sorties.txt  (sorties)", "mdi6.text-box-outline", Mocha.yellow, "sorties" not in decoches,
                          lambda c: basculer_decoche("sorties", c), "Les sorties des cellules qui en ont (clone actuellement affiché)")
            for e in cfg["externes"]:
                p = Path(e["chemin"])
                existe = p.is_file()
                ajouter_ligne(p.name + ("" if existe else "  (introuvable)"), "mdi6.file-outline", Mocha.text if existe else Mocha.red,
                              e.get("coche", True), lambda c, ch=e["chemin"]: basculer_externe(ch, c), e["chemin"],
                              retirer=lambda ch=e["chemin"]: retirer_externe(ch))
            popup.adjustSize()

        def placer_et_afficher():
            popup.adjustSize()
            p = bouton.mapToGlobal(QPoint(bouton.width() - popup.width(), bouton.height()))
            ecran = self.screen()
            if ecran is not None:
                zone_ecran = ecran.availableGeometry()
                p.setX(max(zone_ecran.left(), min(p.x(), zone_ecran.right() - popup.width())))
                p.setY(max(zone_ecran.top(), min(p.y(), zone_ecran.bottom() - popup.height())))
            popup.move(p)
            popup.show()

        def ajouter():
            popup.hide()          # un Qt.Popup se ferme au clic ailleurs : on le masque le temps du dialogue puis on le réaffiche
            dossier_initial = str(Path(cfg["externes"][-1]["chemin"]).parent) if cfg["externes"] else ""
            chemins, _filtre = QFileDialog.getOpenFileNames(self, "Fichiers externes à copier avec « Copier TOUT »", dossier_initial)
            deja = {e["chemin"] for e in cfg["externes"]}
            ajoutes = 0
            for c in chemins:
                c = str(Path(c))
                if c not in deja:
                    cfg["externes"].append({"chemin": c, "coche": True})
                    deja.add(c)
                    ajoutes += 1
            if ajoutes:
                sauver()
            reconstruire()
            placer_et_afficher()

        bouton_plus.clicked.connect(lambda _=False: ajouter())
        reconstruire()
        placer_et_afficher()

    def _sur_clic_copier_tout_code(self):
        """Copie dans le presse-papiers les FICHIERS COCHÉS (clic droit sur le bouton pour choisir ; tout est coché par défaut) :
          - un <lib>.py par lib importée du Task ;
          - <notebook>.py : le code de toutes les cellules ;
          - <notebook>_sorties.txt : les SORTIES des cellules qui en ont (celles du clone actuellement affiché) ;
          - les fichiers EXTERNES ajoutés avec « + » (copiés tels quels).
        Collables dans l'explorateur (CF_HDROP). Le texte brut de l'ensemble est aussi mis dans le presse-papiers."""
        task = self._task_courant_obj()
        if task is None:
            return
        cfg = self._copie_tout_cfg(task)
        decoches = set(cfg["decoches"])

        def _nom_sur(n, defaut):
            return re.sub(r'[\\/:*?"<>|]+', "_", str(n or "")).strip() or defaut

        libs = []
        for nom in list(getattr(task, "libs_importees", []) or []):
            if f"lib:{nom}" in decoches:
                continue
            lib = next((x for x in self.project.libs if x["nom"] == nom), None)
            if lib is not None:
                libs.append(lib)
        inclure_notebook = "notebook" not in decoches
        inclure_sorties = "sorties" not in decoches
        externes = [e for e in cfg["externes"] if e.get("coche", True)]
        code_notebook = _construire_texte_notebook_complet(task) if inclure_notebook else ""

        sorties = []
        texte_sorties = ""
        if inclure_sorties:
            cellules = ([(0, task.cellule_variables)] if task.cellule_variables is not None else []) + list(enumerate(task.cellules, start=1))
            for rang, cellule in cellules:
                widget = self._cellule_widgets.get(cellule.id)
                if widget is None:
                    continue
                try:
                    sortie = widget.zone_sortie.text()
                except Exception:
                    continue
                if sortie.strip():
                    sorties.append(f"# ---- SORTIE cellule #{rang} \"{(cellule.titre or '').strip()}\" ----\n{sortie}")
            if sorties:
                etat = self._executions_clone.get(task.id)
                clone = getattr(etat, "profil_actif", None) if etat is not None else None
                entete = "# ==== SORTIES DES CELLULES" + (f" (clone : {clone})" if clone else "") + " ===="
                texte_sorties = entete + "\n\n" + "\n\n".join(sorties)

        if not libs and not inclure_notebook and not externes and not texte_sorties:
            self._notify_status("Rien à copier (fichiers décochés ou sans contenu) -- clic droit sur ce bouton pour choisir les fichiers.")
            return

        manquants = []
        nb_externes = 0
        try:
            nom_base = _nom_sur(getattr(task, "nom", ""), "notebook")
            dossier = Path(tempfile.gettempdir()) / "AutoniaX_copies" / nom_base
            if dossier.exists():
                shutil.rmtree(dossier, ignore_errors=True)  # évite les fichiers périmés d'une copie précédente
            dossier.mkdir(parents=True, exist_ok=True)
            utilises = set()

            def _nom_unique(nom):
                base, ext = os.path.splitext(nom)
                candidat, i = nom, 2
                while candidat.lower() in utilises:
                    candidat = f"{base}_{i}{ext}"
                    i += 1
                utilises.add(candidat.lower())
                return candidat

            fichiers = []   # chemins copiés
            blocs = []      # texte brut de l'ensemble
            for lib in libs:
                chemin = dossier / _nom_unique(f"{_nom_sur(lib['nom'], 'lib')}.py")
                chemin.write_text(lib["code"], encoding="utf-8", newline="\n")
                fichiers.append(chemin)
                blocs.append(f"# ==== LIB {lib['nom']}.py ====\n{lib['code']}")
            if inclure_notebook:
                chemin = dossier / _nom_unique(f"{nom_base}.py")
                chemin.write_text(code_notebook, encoding="utf-8", newline="\n")
                fichiers.append(chemin)
                blocs.append(code_notebook)
            if texte_sorties:
                chemin = dossier / _nom_unique(f"{nom_base}_sorties.txt")
                chemin.write_text(texte_sorties, encoding="utf-8", newline="\n")
                fichiers.append(chemin)
                blocs.append(texte_sorties)
            for e in externes:
                source = Path(e["chemin"])
                try:
                    if not source.is_file():
                        raise FileNotFoundError(str(source))
                    destination = dossier / _nom_unique(source.name)
                    shutil.copy2(source, destination)
                except OSError:
                    manquants.append(source.name)
                    continue
                fichiers.append(destination)
                nb_externes += 1
                try:
                    if source.stat().st_size <= 2_000_000:      # texte brut : seulement les fichiers texte raisonnables
                        blocs.append(f"# ==== EXTERNE {source.name} ====\n{source.read_text(encoding='utf-8')}")
                except (OSError, UnicodeDecodeError):
                    pass
            if not fichiers:
                self._notify_status("Fichiers externes introuvables : " + ", ".join(manquants))
                return
            mime = QMimeData()
            mime.setUrls([QUrl.fromLocalFile(str(c)) for c in fichiers])
            mime.setText("\n\n".join(blocs))
            QApplication.clipboard().setMimeData(mime)
        except OSError as err:
            BoiteDialogueAutoniaX.warning(self, "Copier tout le code", f"Impossible de créer les fichiers : {err}")
            return
        morceaux = []
        if libs:
            morceaux.append(f"{len(libs)} lib(s) .py")
        if inclure_notebook:
            morceaux.append(f"{nom_base}.py")
        if texte_sorties:
            morceaux.append(f"{nom_base}_sorties.txt ({len(sorties)} cellule(s))")
        elif inclure_sorties:
            morceaux.append("aucune sortie")
        if nb_externes:
            morceaux.append(f"{nb_externes} fichier(s) externe(s)")
        message = f"{len(fichiers)} fichier(s) copié(s) : " + " + ".join(morceaux)
        if manquants:
            message += " -- introuvable(s) : " + ", ".join(manquants)
        self._notify_status(message)

    def _ouvrir_visionneuse_lib(self, item):
        """Double-clic sur une lib : ouvre (ou ramène au premier plan) sa fenêtre de visualisation du code."""
        lib_id = item.data(Qt.UserRole)
        if self.project.find_lib(lib_id) is None:
            return
        if not hasattr(self, "_visionneuses_libs"):
            self._visionneuses_libs = {}
        existante = self._visionneuses_libs.get(lib_id)
        if existante is not None:
            try:
                existante.show()
                existante.raise_()
                existante.activateWindow()
                return
            except RuntimeError:
                self._visionneuses_libs.pop(lib_id, None)
        fenetre = VisionneuseLibCode(self, lib_id, self.window())
        self._visionneuses_libs[lib_id] = fenetre
        fenetre.destroyed.connect(lambda _=None, i=lib_id: self._visionneuses_libs.pop(i, None))
        fenetre.show()

    def _enregistrer_code_lib(self, lib_id: str, code: str, parent=None) -> bool:
        """Enregistre le code édité dans la visionneuse (mêmes contrôles que la mise à jour depuis le presse-papiers)."""
        lib = self.project.find_lib(lib_id)
        if lib is None:
            return False
        parent = parent or self
        code = code.replace("\r\n", "\n")
        if not code.strip():
            BoiteDialogueAutoniaX.warning(parent, "Enregistrer la lib", "Le code est vide : la lib n'a pas été modifiée.")
            return False
        if len(code) > 2_000_000:
            BoiteDialogueAutoniaX.warning(parent, "Enregistrer la lib", "Code trop gros (> 2 Mo).")
            return False
        try:
            compile(code, lib["nom"] + ".py", "exec")
        except SyntaxError as err:
            BoiteDialogueAutoniaX.warning(parent, "Enregistrer la lib",
                                          f"Le code n'est pas du Python valide (ligne {err.lineno} : {err.msg}). La lib n'a pas été modifiée.")
            return False
        lib["code"] = code if code.endswith("\n") else code + "\n"
        lib["modifie_le"] = datetime.now(timezone.utc).isoformat(timespec="seconds")
        _rafraichir_registre_libs(self.project)
        self.project.save()
        self._rafraichir_liste_libs()
        self._notify_status(f"Lib « {lib['nom']}.py » enregistrée ({len(lib['code'].splitlines())} lignes).")
        return True

    def _copier_code_lib(self, lib_id: str):
        lib = self.project.find_lib(lib_id)
        if lib is None:
            return
        # Copie le FICHIER nom.py lui-même (collable dans l'Explorateur / un dossier) ; le texte du code reste aussi collable
        # dans un éditeur.
        try:
            dossier = Path(tempfile.gettempdir()) / "AutoniaX_libs"
            dossier.mkdir(parents=True, exist_ok=True)
            chemin = dossier / f"{lib['nom']}.py"
            chemin.write_text(lib["code"], encoding="utf-8", newline="\n")
            mime = QMimeData()
            mime.setUrls([QUrl.fromLocalFile(str(chemin))])
            mime.setText(lib["code"])
            QApplication.clipboard().setMimeData(mime)
        except OSError as err:
            BoiteDialogueAutoniaX.warning(self, "Copier la lib", f"Impossible de créer le fichier : {err}")
            return
        self._notify_status(f"Fichier « {lib['nom']}.py » copié.")

    def _creer_lib(self):
        nom, ok = BoiteDialogueAutoniaX.saisie_texte(self, "Nouvelle lib", "Nom du fichier (sans .py) :", texte_initial="ma_lib")
        if not ok:
            return
        try:
            lib = self.project.add_lib(nom)
        except ValueError as err:
            BoiteDialogueAutoniaX.warning(self, "Nouvelle lib", str(err))
            return
        self.project.save()
        self._rafraichir_liste_libs()
        self._notify_status(f"Lib « {lib['nom']}.py » créée -- clic droit > Mettre à jour pour y coller du code.")

    def _menu_lib(self, pos):
        item = self.liste_libs.itemAt(pos)
        menu = QMenu(self.liste_libs)
        if item is None:
            menu.addAction("Nouvelle lib", self._creer_lib)
        else:
            lib_id = item.data(Qt.UserRole)
            menu.addAction(qta.icon("mdi6.clipboard-arrow-down-outline", color=Mocha.text), "Mettre à jour (depuis le presse-papiers)",
                           lambda: self._maj_lib_depuis_presse_papiers(lib_id))
            menu.addSeparator()
            menu.addAction("Renommer", lambda: self._renommer_lib(lib_id))
            menu.addAction("Supprimer", lambda: self._supprimer_lib(lib_id))
        menu.exec(self.liste_libs.viewport().mapToGlobal(pos))

    def _maj_lib_depuis_presse_papiers(self, lib_id: str):
        lib = self.project.find_lib(lib_id)
        if lib is None:
            return
        code = QApplication.clipboard().text().replace("\r\n", "\n")
        if not code.strip():
            BoiteDialogueAutoniaX.warning(self, "Mettre à jour la lib", "Le presse-papiers est vide : copiez d'abord le code Python.")
            return
        if len(code) > 2_000_000:
            BoiteDialogueAutoniaX.warning(self, "Mettre à jour la lib", "Code trop gros (> 2 Mo).")
            return
        try:
            compile(code, lib["nom"] + ".py", "exec")
        except SyntaxError as err:
            BoiteDialogueAutoniaX.warning(self, "Mettre à jour la lib",
                                          f"Le presse-papiers n'est pas du Python valide (ligne {err.lineno} : {err.msg}). La lib n'a pas été modifiée.")
            return
        lib["code"] = code if code.endswith("\n") else code + "\n"
        lib["modifie_le"] = datetime.now(timezone.utc).isoformat(timespec="seconds")
        _rafraichir_registre_libs(self.project)
        self.project.save()
        self._rafraichir_liste_libs()
        self._notify_status(f"Lib « {lib['nom']}.py » mise à jour ({len(lib['code'].splitlines())} lignes).")

    def _copier_directive_lib(self, lib_id: str):
        lib = self.project.find_lib(lib_id)
        if lib is not None:
            QApplication.clipboard().setText(f"# IMPORT: {lib['nom']}\nfrom {lib['nom']} import *")
            self._notify_status("Directive copiée dans le presse-papiers.")

    def _renommer_lib(self, lib_id: str):
        lib = self.project.find_lib(lib_id)
        if lib is None:
            return
        nom, ok = BoiteDialogueAutoniaX.saisie_texte(self, "Renommer la lib", "Nouveau nom (sans .py) :", texte_initial=lib["nom"])
        if not ok:
            return
        try:
            ancien = lib["nom"]
            lib["nom"] = self.project.verifier_nom_lib(nom, ignorer_id=lib_id)
            for t in self.project.tasks:
                t.libs_importees = [lib["nom"] if n == ancien else n for n in t.libs_importees]
                _dec = (t.copie_tout_config or {}).get("decoches")      # PATCH I
                if isinstance(_dec, list):
                    t.copie_tout_config["decoches"] = [("lib:" + lib["nom"]) if d == "lib:" + ancien else d for d in _dec]
        except ValueError as err:
            BoiteDialogueAutoniaX.warning(self, "Renommer la lib", str(err))
            return
        _rafraichir_registre_libs(self.project)
        self.project.save()
        self._rafraichir_liste_libs()

    def _supprimer_lib(self, lib_id: str):
        lib = self.project.find_lib(lib_id)
        if lib is None:
            return
        if not BoiteDialogueAutoniaX.question(self, "Supprimer la lib", f"Supprimer « {lib['nom']}.py » ?",
                                              texte_oui="Supprimer", texte_non="Annuler",
                                              texte_informatif="Les cellules qui l'importent ne fonctionneront plus."):
            return
        nom = lib["nom"]
        self.project.remove_lib(lib_id)
        for t in self.project.tasks:
            t.libs_importees = [n for n in t.libs_importees if n != nom]
            _dec = (t.copie_tout_config or {}).get("decoches")      # PATCH I
            if isinstance(_dec, list):
                t.copie_tout_config["decoches"] = [d for d in _dec if d != "lib:" + nom]
        self.project.save()
        self._rafraichir_liste_libs()
        self._notify_status(f"Lib « {nom}.py » supprimée.")

    def showEvent(self, event):
        # CORRECTIF (demande explicite utilisateur : "lorsque je crée un
        # composant, ça ne s'ajoute pas automatiquement dans la liste des
        # importer, je suis obligé de toujours réimporter le service api
        # pour que ça apparaisse") -- Project.composants_importes_task est
        # déjà recalculé à jour à CHAQUE appel (cf. sa docstring), le
        # problème n'est donc jamais là : rien ne redéclenchait
        # panneau_composants.rafraichir(task) quand un Composant était créé
        # depuis un AUTRE écran (édition du ServiceAPI) pendant que ce Task
        # restait ouvert en arrière-plan -- ces deux écrans ne se
        # notifiaient jamais l'un l'autre. Plutôt que de câbler un signal
        # dédié entre les deux (fragile : tout futur point de création/
        # suppression de composant devrait alors penser à l'émettre), on
        # rafraîchit systématiquement ici, à chaque fois que cet écran
        # redevient visible (retour depuis n'importe quel autre écran,
        # y compris l'édition de ServiceAPI) -- même filet de sécurité que
        # le rechargement déjà fait par ailleurs sur d'autres transitions
        # d'écran, coût négligeable (un simple recalcul de dict + repaint
        # du panneau gauche, jamais un aller-retour réseau).
        super().showEvent(event)
        task = self._task_courant_obj()
        if task is not None:
            self.panneau_composants.rafraichir(task)
            # CORRECTIF (demande explicite utilisateur, suite : "lorsque
            # j'écris le nom du composant et je mets un point, ça ne
            # propose pas les méthodes donc pas d'autocomplétion, je suis
            # obligé de redémarrer le TaskScriptEditor pour que ça le
            # considère syntaxiquement comme composant") -- rafraîchir
            # panneau_composants (juste au-dessus) ne suffit pas : c'est un
            # widget ENTIÈREMENT SÉPARÉ de l'éditeur de script, alimenté
            # par son propre appel à _rafraichir_composants_connus_editeur
            # (cf. sa docstring -- TaskScriptEditor._composants_connus,
            # utilisé pour la coloration ET pour savoir après quel "."
            # déclencher l'auto-complétion). Sans cet appel ICI aussi, un
            # Composant créé depuis l'écran d'édition du ServiceAPI restait
            # invisible à l'auto-complétion de CHAQUE cellule tant que le
            # Task n'était pas fermé/rouvert -- même bug, même cause
            # (rafraîchissement manquant sur ce retour d'écran), sur un
            # widget différent.
            self._rafraichir_composants_connus_editeur(task)

    def eventFilter(self, watched, event):
        # RAPPEL (cf. historique -- une deuxième `def eventFilter` dans
        # le même corps de classe REMPLACE entièrement la première en
        # Python, jamais les deux ne coexistent) : tout besoin futur de
        # surveillance d'événements dans cette classe doit être AJOUTÉ
        # ici, dans cette même définition, jamais dans une seconde
        # `def eventFilter` séparée -- cf. RemoteViewPanel.eventFilter
        # pour le précédent documenté de ce piège.
        if watched is self.grille_page and event.type() in (QEvent.Resize, QEvent.Show):
            self._repositionner_bouton_flottant()
        return super().eventFilter(watched, event)

    def resizeEvent(self, event):
        super().resizeEvent(event)
        self._repositionner_bouton_flottant()
        if self.overlay_chargement_task.isVisible():
            self.overlay_chargement_task.setGeometry(self.grille_page.rect())

    def _repositionner_bouton_flottant(self):
        parent = self.floating_add_button.parentWidget()
        if parent is None:
            return
        marge = 24
        x = parent.width() - self.floating_add_button.width() - marge
        # PATCH (section « Lib ») : les boutons flottants restent ancrés au bas de la zone Tasks, pas au bas de la page
        zone = getattr(self, "zone_contenu", None)
        bas = parent.height()
        if zone is not None and zone.parentWidget() is not None and zone.isVisible():
            bas = zone.mapTo(parent, QPoint(0, zone.height())).y()
        y = bas - self.floating_add_button.height() - marge
        self.floating_add_button.move(max(0, x), max(0, y))
        # Bouton d'import juste à gauche du "+" -- même y, x décalé d'une
        # largeur de bouton + un petit espacement (cf. constante locale
        # espacement, pas de nouvelle constante globale pour un seul usage).
        espacement = 10
        x_import = x - self.floating_import_button.width() - espacement
        self.floating_import_button.move(max(0, x_import), max(0, y))

    def _reload_grille(self):
        self.flow_grid.clear()
        self._task_cartes = {}
        # MAJ décision utilisateur ("on doit pouvoir ordonne, par defaut
        # sa doit etre ranger par date douverture") : plus récemment
        # ouvert en premier. date_derniere_ouverture est une chaîne ISO
        # 8601 (cf. Task.date_derniere_ouverture) -- comparable directement
        # comme une chaîne sans parser en datetime, l'ordre lexicographique
        # ISO coïncide avec l'ordre chronologique.
        #
        # CORRECTIF (spec B.5, épinglage) -- tri à DEUX passages plutôt
        # qu'une clé composite unique : la date doit rester décroissante
        # alors que l'épinglage doit rester croissant (épinglés d'abord),
        # ce qui ne se combine pas trivialement en une seule clé sans
        # transformer la date ISO en valeur négative (non trivial en
        # chaîne). D'abord le tri existant par date décroissante (identique
        # à avant ce patch), PUIS un second passage par épinglage -- le tri
        # Python est stable par nature, donc l'ordre par date à l'intérieur
        # de chaque groupe épinglé/non-épinglé reste préservé par ce second
        # passage.
        tasks_triees = sorted(
            self.project.tasks,
            key=lambda t: t.date_derniere_ouverture,
            reverse=True,
        )
        # CORRECTIF (demande explicite utilisateur : "les [épinglés] ne
        # bougent pas, c'est ceux qui ne sont pas [épinglés] où le dernier
        # ouvert est premier") -- les ÉPINGLÉS sont triés par leur rang
        # MANUEL (ordre_epingle, modifié seulement par glisser-déposer),
        # JAMAIS par date d'ouverture : ouvrir un épinglé ne le déplace plus.
        # Tri stable : à rang égal (anciens fichiers, tous à 0) l'ordre
        # d'origine de project.tasks est conservé.
        epingles = sorted(
            (t for t in self.project.tasks if t.epingle),
            key=lambda t: t.ordre_epingle,
        )
        non_epingles = [t for t in tasks_triees if not t.epingle]
        tasks_triees = epingles + non_epingles
        for task in tasks_triees:
            carte = TaskCarte(task)
            carte.clique.connect(self._ouvrir_task)
            carte.demande_renommage.connect(self._renommer_task_id)
            carte.demande_suppression.connect(self._confirm_delete_task_id)
            carte.demande_toggle_epingle.connect(self._toggle_epingle_task_id)
            carte.demande_couleur_icone.connect(self._definir_couleur_icone_task_id)
            carte.demande_deplacement.connect(self._deplacer_task_epingle)
            self._task_cartes[task.id] = carte
            self.flow_grid.add_item(carte)

        vide = len(self.project.tasks) == 0
        self.placeholder_widget.setVisible(vide)
        self.grid_scroll.setVisible(not vide)
        self._rafraichir_liste_libs()
        self._repositionner_bouton_flottant()

    def _creer_task(self):
        base = "Nouveau Task"
        candidat = base
        i = 1
        noms_existants = {t.nom for t in self.project.tasks}
        while candidat in noms_existants:
            i += 1
            candidat = f"{base} {i}"
        task = self.project.add_task(candidat)
        self.project.save()
        self._reload_grille()
        self._notify_status(f"Task « {task.nom} » créé.")
        self._ouvrir_task(task.id)

