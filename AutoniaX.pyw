        # logs) plutôt que l'ordre d'arrivée -- un sAutoniax lent à
        # répondre ne doit pas faire sauter sa section au milieu du texte
        # final assemblé.
        self._copie_logs_en_cours = None
        self._thread_copie_logs_serveur = None
        self._worker_copie_logs_serveur = None

        # PATCH (demande explicite utilisateur : "le raccourci de
        # fermeture propre de l'app, par défaut Ctrl+Echap") -- posé en
        # QShortcut plutôt que testé dans keyPressEvent : cf. commentaire
        # DEFAULT_RACCOURCIS_APP["fermeture_app"] pour la justification
        # (doit rester actif même si le focus clavier est profondément
        # imbriqué dans un widget enfant). context=Qt.ApplicationShortcut
        # explicite pour la même raison -- le défaut de QShortcut
        # (WindowShortcut) suffirait déjà ici vu que tout vit dans cette
