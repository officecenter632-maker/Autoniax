        # fais que les boutons run, sauvegarde du code de la page et capture soient aussi statiques à l'extrémité
        # droite, donc ils ne slident plus") -- colonne FIXE à droite, même fond/bordure/hauteur que retour_fixe.
        # Le menu ⋮ (Options du Task) y est aussi, tout à droite, pour garder l'ordre d'origine
        # (sauvegarde, capture, run, ⋮) au lieu de le laisser seul dans la zone qui défile.
        droite_fixe = QWidget(barre_haut)
        droite_fixe.setObjectName("APIFeaturesEditeurToolbar")
        droite_fixe.setAttribute(Qt.WA_StyledBackground, True)
        droite_fixe_layout = QHBoxLayout(droite_fixe)
        droite_fixe_layout.setContentsMargins(14, 12, 16, 12)
        droite_fixe_layout.setSpacing(14)
        droite_fixe_layout.addWidget(self.bouton_voir_rendu_reseau, 0, Qt.AlignVCenter)
        droite_fixe_layout.addWidget(self.bouton_drag_notebook, 0, Qt.AlignVCenter)
        droite_fixe_layout.addWidget(self.bouton_copier_tout_code, 0, Qt.AlignVCenter)
        droite_fixe_layout.addWidget(self.bouton_coller_notebook, 0, Qt.AlignVCenter)
        droite_fixe_layout.addWidget(self.bouton_sauver_page_html, 0, Qt.AlignVCenter)
        droite_fixe_layout.addWidget(self.bouton_capture_propre, 0, Qt.AlignVCenter)
        droite_fixe_layout.addWidget(self.bouton_executer_tout, 0, Qt.AlignVCenter)
        droite_fixe_layout.addWidget(self.menu_task_button, 0, Qt.AlignVCenter)
        # Hauteur commune aux trois blocs de la barre (le bouton run, un peu plus haut que les autres, n'est plus
        # dans `toolbar` : on prend le max pour qu'il ne soit jamais rogné et que les trois blocs restent alignés).
        h_barre = max(toolbar.sizeHint().height(), droite_fixe.sizeHint().height())
        droite_fixe.setFixedHeight(h_barre)
        toolbar_scroll.setFixedHeight(h_barre)
        retour_fixe.setFixedHeight(h_barre)
        barre_haut_layout.addWidget(droite_fixe)
        outer_layout.addWidget(barre_haut)
        outer_layout.addWidget(self.label_statut_reseau)

        # --- Bande "Accès rapide" (décision explicite utilisateur : "a
        # droite il doit y avoir une collone de acces rapide... le
        # numeros et le tuitre de sa celleule pour que si on clic dessus
        # alors linterface slide directement jusqua ce niveau", PUIS
        # "je veux que tu met l'acces rapide ici [zone entourée sous la
        # toolbar]... donc tu enleve le paneau flottant actuels") -- une
        # tuile par cellule (row 0 incluse), cliquable, cf.
        # BarreAccesRapideTask et _sur_clic_acces_rapide. Placée dans
        # outer_layout (PAS corps_layout) : bande pleine largeur en
        # permanence dans la mise en page, entre le statut réseau et le
        # corps de l'éditeur -- exactement l'emplacement que
        # l'utilisateur a entouré sur sa capture d'écran. Toujours
        # visible (contrairement aux deux générations précédentes -- ni
        # panneau replié par bouton, ni panneau flottant au survol),
        # donc pas de hide()/show() ici : rafraîchir() suffit à la tenir
        # à jour, cf. _ouvrir_task plus bas.
        self.barre_acces_rapide = BarreAccesRapideTask(self.editeur_page)
        self.barre_acces_rapide.demande_acces_cellule.connect(self._sur_clic_acces_rapide)
        # AJOUT (demande explicite utilisateur : "clic droit ramene
        # plutot a la sortie de ces cellule") -- cf. AccesRapideItem.
        # clique_droit / BarreAccesRapideTask.demande_acces_sortie_cellule.
        self.barre_acces_rapide.demande_acces_sortie_cellule.connect(
            self._sur_clic_droit_acces_rapide
        )
        outer_layout.addWidget(self.barre_acces_rapide)

        # PATCH (Lib) : bande des libs du projet sous l'accès rapide -- par lib : mettre à jour (presse-papiers) + copier le code.
        self.barre_libs = QFrame(self.editeur_page)
        self.barre_libs.setObjectName("BarreAccesRapideTask")
        barre_libs_layout = QHBoxLayout(self.barre_libs)
        barre_libs_layout.setContentsMargins(12, 4, 12, 4)
        barre_libs_layout.setSpacing(8)
        icone_libs = QLabel(self.barre_libs)
        icone_libs.setPixmap(qta.icon("mdi6.language-python", color=Mocha.blue).pixmap(18, 18))
        icone_libs.setToolTip("Lib : fichiers Python du projet")
        barre_libs_layout.addWidget(icone_libs)
        self.bouton_ajouter_lib_task = QToolButton(self.barre_libs)
        self.bouton_ajouter_lib_task.setIcon(qta.icon("mdi6.plus", color=Mocha.text))
        self.bouton_ajouter_lib_task.setToolTip("Importer une lib dans ce Task")
        self.bouton_ajouter_lib_task.setCursor(Qt.PointingHandCursor)
        self.bouton_ajouter_lib_task.setAutoRaise(True)
        self.bouton_ajouter_lib_task.clicked.connect(self._menu_ajouter_lib_task)
        barre_libs_layout.addWidget(self.bouton_ajouter_lib_task)
        self.barre_libs_scroll = QScrollArea(self.barre_libs)
        self.barre_libs_scroll.setWidgetResizable(True)
        self.barre_libs_scroll.setFrameShape(QFrame.NoFrame)
        self.barre_libs_scroll.setHorizontalScrollBarPolicy(Qt.ScrollBarAsNeeded)
        self.barre_libs_scroll.setVerticalScrollBarPolicy(Qt.ScrollBarAlwaysOff)
        self.barre_libs_scroll.setFixedHeight(40)
        self.barre_libs_scroll.setStyleSheet("QScrollArea { background: transparent; } QScrollArea > QWidget > QWidget { background: transparent; }")
        self.barre_libs_contenu = QWidget()
        self.barre_libs_contenu_layout = QHBoxLayout(self.barre_libs_contenu)
        self.barre_libs_contenu_layout.setContentsMargins(0, 0, 0, 0)
        self.barre_libs_contenu_layout.setSpacing(14)
        self.barre_libs_scroll.setWidget(self.barre_libs_contenu)
        barre_libs_layout.addWidget(self.barre_libs_scroll, 1)
        outer_layout.addWidget(self.barre_libs)
        self._rafraichir_barre_libs()

        # --- Corps : panneau gauche (composants importés) + notebook de
        # cellules à droite (mode notebook, décision explicite utilisateur). ---
        corps = QWidget(self.editeur_page)
        corps_layout = QHBoxLayout(corps)
        corps_layout.setContentsMargins(0, 0, 0, 0)
        corps_layout.setSpacing(0)

        self.panneau_composants = PanneauComposantsImportesTask(self.project, corps)
        # PATCH : pose la RÉFÉRENCE dès la construction (cf. docstring de
        # definir_contexte_reseau/_noms_executants_reseau_ref) -- les deux
        # dicts existent déjà à ce stade (déclarés plus haut dans ce même
        # __init__, cf. self._noms_executants_reseau/_profils_reseau_actifs)
        # et ne sont plus jamais réassignés ensuite (mutation en place
        # uniquement, cf. definir_executants_reseau_connus), donc cette
        # référence reste valide pour toute la durée de vie de l'écran --
        # inutile de la reposer à chaque rafraichir().
        self.panneau_composants.definir_contexte_reseau(self._noms_executants_reseau, self._profils_reseau_actifs)
        self.panneau_composants.demande_import_service_api.connect(self._demande_import_service_api)
        self.panneau_composants.composant_copie.connect(self._sur_composant_copie)
        self.panneau_composants.demande_liaison_instance.connect(self._demande_liaison_instance)
        self.panneau_composants.demande_ouvrir_coordonnee_action.connect(self.demande_ouvrir_coordonnee_action.emit)
        self.panneau_composants.demande_retrait_service_api.connect(self._demande_retrait_service_api)
        # PATCH20 : splitter [composants importes | notebook + clone]
        self.splitter_composants_notebook = SplitterComposantsNotebook(Qt.Horizontal, corps)
        self.splitter_composants_notebook.setObjectName("ComposantsNotebookSplitter")
        self.splitter_composants_notebook.setHandleWidth(8)
        self.splitter_composants_notebook.setChildrenCollapsible(True)
        self.splitter_composants_notebook.addWidget(self.panneau_composants)

        # --- Colonne droite : cellule 0 STATIQUE (sticky) au-dessus, puis
        # zone scrollable pour le reste des cellules en dessous (décision
        # explicite utilisateur : "lorsque on vas slider vers le bas elle
        # reste statique, comme sa on puisse voir toujour sont contenue").
        # La cellule 0 est volontairement sortie du QScrollArea plutôt que
        # "flottée" par-dessus au scroll (peu fiable en Qt) : elle vit dans
        # son propre layout fixe, seules les cellules 1+ défilent en dessous.
        colonne_droite = QWidget(corps)
        colonne_droite_layout = QVBoxLayout(colonne_droite)
        colonne_droite_layout.setContentsMargins(0, 0, 0, 0)
        colonne_droite_layout.setSpacing(0)

        # Conteneur de la row 0 -- peuplé/vidé dans _peupler_cellules,
        # DEUX enfants côte à côte : le TaskCelluleWidget de
        # task.cellules[0] (init statique) et celui de
        # task.cellule_variables (variables dynamiques, cf. docstring
        # Task.cellule_variables) -- décision explicite utilisateur :
        # "litteralement creer deux cellule sur une seule row". QHBoxLayout
        # (pas QVBoxLayout) pour les mettre côte à côte plutôt qu'empilées.
        # MAJ décision utilisateur : les deux cellules de la row 0 sont
        # désormais empilées chacune sur sa propre ligne (QVBoxLayout, plus
        # QHBoxLayout côte à côte) -- "je cois que cest mieux que on mets
        # chquen sur sa ligne et non les deux sur une meme ligne". La
        # cellule "Variable dynamique" passe en premier/tout en haut (avant
        # "Main"), cf. ordre d'insertion dans _peupler_cellules
        # et _positionner_row0 ci-dessous.
        self.cellule_statique_container = QWidget(colonne_droite)
        self.cellule_statique_layout = QVBoxLayout(self.cellule_statique_container)
        self.cellule_statique_layout.setContentsMargins(2, 16, 16, 8)  # PATCH : marge gauche 16 -> 2
        self.cellule_statique_layout.setSpacing(14)
        colonne_droite_layout.addWidget(self.cellule_statique_container)

        # Zone scrollable contenant les cellules restantes empilées, comme
        # un notebook Jupyter -- c'est elle qui défile, pas les cellules
        # individuellement (cf. TaskScriptEditor._ajuster_hauteur).
        self.notebook_scroll = QScrollArea(colonne_droite)
        self.notebook_scroll.setObjectName("NotebookScrollArea")
        self.notebook_scroll.setWidgetResizable(True)
        self.notebook_scroll.setFrameShape(QFrame.NoFrame)
        self.notebook_scroll.setHorizontalScrollBarPolicy(Qt.ScrollBarAlwaysOff)
        self.notebook_scroll.setVerticalScrollBarPolicy(Qt.ScrollBarAlwaysOff)

        self.notebook_contenu = QWidget()
        self.notebook_layout = QVBoxLayout(self.notebook_contenu)
        self.notebook_layout.setContentsMargins(2, 8, 16, 16)  # PATCH : marge gauche 16 -> 2
        self.notebook_layout.setSpacing(14)

        self._cellule_widgets: dict = {}  # id cellule -> TaskCelluleWidget

        # PATCH (demande explicite utilisateur : "supposons maintenant
        # qu on veut revenir a la position, comment on peut faire") --
        # pile LIFO des positions quittées par "Aller à la définition"
        # (cellule_id, position_curseur), pour permettre un retour en
        # arrière (Alt+Gauche, cf. TaskScriptEditor.keyPressEvent) --
        # même principe que le "Go Back" d'un IDE/navigateur : chaque
        # saut vers une définition empile la position DE DÉPART (pas
        # celle d'arrivée), Alt+Gauche dépile et y retourne. Une entrée
        # devenue invalide au moment de dépiler (cellule supprimée
        # depuis) est simplement ignorée, on tente l'entrée suivante.
        self._historique_navigation_definition: list = []

        # PATCH (demande explicite utilisateur : "si on a selectionner une
        # expression et bien le raccourci ctrl+f fait la selection de tout
        # les occurence dans tout le notebook" + "ctrl+d vas faire a ce que
        # les curseur se creer a ces endroit de mots pour une modifcation
        # multiple au meme moment") -- état PARTAGÉ à l'échelle du
        # notebook entier (et non par cellule/éditeur), puisque Ctrl+F et
        # Ctrl+D doivent agir sur TOUTES les cellules du Task ouvert, pas
        # uniquement celle qui a le focus. Porté par TaskConfigScreen (le
        # notebook) plutôt que par TaskScriptEditor lui-même : un
        # TaskScriptEditor individuel ne connaît que sa propre cellule
        # (cf. self._cellule_widgets juste au-dessus), c'est le notebook
        # qui a la vue d'ensemble nécessaire pour parcourir toutes les
        # cellules et y appliquer le même surlignage/la même frappe.
        #
        # Qt ne permet pas d'avoir un vrai curseur clignotant à plusieurs
        # endroits dans un QPlainTextEdit (et encore moins réparti sur
        # PLUSIEURS QPlainTextEdit distincts, un par cellule) -- le
        # multi-curseur est donc SIMULÉ : les occurrences sont surlignées
        # (QTextEdit.ExtraSelection) et chaque frappe/suppression faite
        # dans l'éditeur qui a le focus est répercutée programmatiquement
        # sur toutes les autres occurrences (même cellule ET autres
        # cellules), dans le même ordre que si l'utilisateur avait tapé
        # dans chacune séparément.
        #
        # Structure : {
        #   "texte": str,                     -- expression recherchée/dupliquée
        #   "occurrences": {cellule_id: [(debut, fin), ...], ...},  -- positions
        #       à jour dans le texte ACTUEL de chaque cellule (recalculées à
        #       chaque frappe, cf. TaskScriptEditor._resynchroniser_occurrences)
        #   "actives": {cellule_id: [(debut, fin), ...], ...},  -- sous-ensemble
        #       de "occurrences" réellement en édition multi-curseur (Ctrl+D
        #       ajoute une occurrence à la fois ; Ctrl+F les active toutes
        #       d'un coup, cf. docstrings des méthodes ci-dessous)
        #   "mode": "recherche" | "edition" | None,  -- "recherche" = simple
        #       surlignage (Ctrl+F, pas encore d'édition synchronisée),
        #       "edition" = frappe synchronisée active (au moins un Ctrl+D)
        # }
        # None (pas juste un dict vide) quand aucune recherche/édition
        # multi-curseur n'est en cours -- distingue clairement "jamais
        # démarré" de "démarré puis vidé", utile pour les early-return des
        # méthodes ci-dessous.
        self._multi_curseur_etat: Optional[dict] = None

        # Conteneur horizontal réutilisable pour la row 0 quand elle est
        # DÉTACHÉE du sticky (étiquette désactivée, cf.
        # _sur_etiquette_cellule_basculee) -- BUGFIX : notebook_layout est
        # un QVBoxLayout (empilement vertical), donc y insérer cellules[0]
        # et cellule_variables comme deux éléments séparés les empile l'un
        # sur l'autre au lieu de les garder côte à côte. Ce petit QWidget
        # à QHBoxLayout sert d'unique élément du notebook_layout dans ce
        # cas : les deux TaskCelluleWidget restent côte à côte À
        # L'INTÉRIEUR de lui, qui lui-même défile comme une cellule
        # normale parmi les autres.
        # MAJ décision utilisateur (même changement que cellule_statique_layout
        # ci-dessus) : empilement vertical au lieu de côte à côte, ici aussi.
        self.row0_detachee_container = QWidget(self.notebook_contenu)
        self.row0_detachee_layout = QVBoxLayout(self.row0_detachee_container)
        self.row0_detachee_layout.setContentsMargins(0, 0, 0, 0)
        self.row0_detachee_layout.setSpacing(14)

        # Pas de bouton "+ Ajouter une cellule" séparé (décision explicite
        # utilisateur) -- le petit bouton + présent sur chaque cellule
        # (TaskCelluleWidget.bouton_ajouter_apres) suffit à ajouter une
        # nouvelle cellule juste après la cellule courante.
        self.notebook_layout.addStretch(1)

        self.notebook_scroll.setWidget(self.notebook_contenu)
        colonne_droite_layout.addWidget(self.notebook_scroll, 1)
        # Fin indicateur de défilement (la vraie barre reste masquée) : montre où l'on en est dans le notebook et combien il reste.
        self._indicateur_defilement = IndicateurDefilementFin(self.notebook_scroll)

        # CORRECTIF (retour utilisateur : "je veux que tu met ce panneau
        # sur forme de QSPlitter donc on peu glisser comme on veux, sa
        # alonge ou retrecir lespace du notebbok") -- annule la décision
        # d'origine du patch "Exécution Clone" (cf. commentaire plus bas
        # sur self.panneau_clone, "Widget de largeur fixe plutôt qu'un
        # QSplitter... redimensionnable au clavier/drag laissé en v2 si
        # besoin réel" -- ceci EST ce besoin v2). colonne_droite n'est
        # PLUS ajoutée directement à corps_layout : elle devient le
        # premier enfant de self.splitter_notebook_clone (même patron
        # EXACT que InstancesConnecteesScreen.splitter, cf. son
        # objectName "InstancesSplitter" -- ici "NotebookCloneSplitter"),
        # lui-même ajouté à corps_layout avec le même stretch=1 que
        # colonne_droite portait seule avant (un splitter accepte un
        # stretch de layout parent exactement comme n'importe quel
        # widget). Le second enfant (self.panneau_clone) est ajouté au
        # splitter plus bas, à l'endroit où il était déjà construit --
        # panneau_acces_rapide/etiquette_acces_rapide restent hors du
        # splitter, ajoutés à corps_layout normalement ENTRE les deux
        # ajouts du splitter (cf. leur propre logique d'affichage/
        # masquage indépendante, sans rapport avec ce redimensionnement).
        self.splitter_notebook_clone = QSplitter(Qt.Horizontal, corps)
        self.splitter_notebook_clone.setObjectName("NotebookCloneSplitter")
        self.splitter_notebook_clone.setChildrenCollapsible(False)
        self.splitter_notebook_clone.addWidget(colonne_droite)
        # PATCH20 : le splitter notebook/clone devient le 2e enfant du splitter global
        self.splitter_composants_notebook.addWidget(self.splitter_notebook_clone)
        self.splitter_composants_notebook.setCollapsible(0, True)
        self.splitter_composants_notebook.setCollapsible(1, False)
        self.splitter_composants_notebook.setStretchFactor(0, 0)
        self.splitter_composants_notebook.setStretchFactor(1, 1)
        self.splitter_composants_notebook.setSizes([PanneauComposantsImportesTask.LARGEUR_DEPLOYEE, 10000])
        corps_layout.addWidget(self.splitter_composants_notebook, 1)

        # RETRAIT (cf. BarreAccesRapideTask, construite plus haut dans
        # _build_editeur, juste sous la toolbar/label_statut_reseau --
        # décision explicite utilisateur : "je veux que tu met l'acces
        # rapide ici [rectangle entouré sous la toolbar]... donc tu
        # enleve le paneau flottant actuels") -- la liste de cellules ne
        # vit plus ici du tout : ni comme ancien panneau flottant au
        # survol du bord droit (ZoneSensibleAccesRapide + l'ancienne
        # PanneauAccesRapideTask, toutes deux retirées du fichier), ni
        # comme colonne fixe dans corps_layout (génération encore
        # antérieure). self.barre_acces_rapide (construite en tête de
        # _build_editeur) est le seul widget d'accès rapide restant.

        # PATCH (mode "Exécution Clone", cf. SPEC_mode_execution_clone.md
        # section 4.1) -- panneau masqué par défaut, à l'extrême droite
        # (après la colonne d'accès rapide ci-dessus).
        #
        # CORRECTIF (retour utilisateur : "je veux que tu met ce panneau
        # sur forme de QSPlitter donc on peu glisser comme on veux, sa
        # alonge ou retrecir lespace du notebbok") -- remplace la largeur
        # fixe d'origine (choisie ici comme alternative "plus sûre" pour
        # ne pas migrer tout corps_layout, cf. section 4.1 de la spec) :
        # ce panneau est désormais le SECOND enfant de self.splitter_
        # notebook_clone (posé plus haut, cf. son commentaire pour le
        # détail complet -- colonne_droite/notebook est le premier),
        # ajouté au splitter plus bas au lieu de corps_layout directement.
        self.panneau_clone = PanneauExecutionClone(corps)
        # AJOUT (SPEC_lot_corrections_2026-09.md section 5) : injection
        # de l'objet ReglagesApp pour le bouton "Sélectionner
        # aléatoirement" (cf. PanneauExecutionClone.definir_reglages).
        self.panneau_clone.definir_reglages(self.reglages)
        # HISTORIQUE (largeur FIXE, remplacée par le splitter ci-dessus --
        # gardé pour mémoire du calcul, plus appliqué tel quel) : demande
        # explicite utilisateur "augmente de 1/4 la taille de ce panneau,
        # le width seulement" (255 -> 340, 255 * 1.25 ≈ 319 mais 340
        # explicitement choisi comme valeur cible), puis SPEC_lot_
        # corrections_2026-09.md section 10 : réduction explicite d'1/3
        # (340 * 2/3 ≈ 227). CORRECTIF (cf. commentaire principal
        # ci-dessus) -- 227px devient désormais la largeur INITIALE du
        # panneau dans le splitter (cf. setSizes plus bas) plutôt qu'une
        # contrainte figée : l'utilisateur peut l'élargir/rétrécir
        # librement par glisser-déposer sur la poignée du splitter.
        # Cf. docstring de PanneauExecutionClone._largeur_colonnes_
        # compactes pour le détail du réagencement de colonnes qui reste
        # pertinent tant que le panneau n'est PAS élargi manuellement
        # (largeurs de colonnes toujours redimensionnables ensuite via
        # l'en-tête de table_profils, indépendamment du splitter).
        # Visibilité pilotée uniquement par _rafraichir_visibilite_
        # controles_reseau (section 4.1) -- False ici juste comme état
        # initial tant qu'aucun Task n'est encore affiché.
        self.panneau_clone.setVisible(False)
        self.panneau_clone.demande_rafraichir_profils.connect(self._sur_demande_rafraichir_profils_clone)
        self.panneau_clone.demande_lancer_clones.connect(self._sur_demande_lancer_clones)
        self.panneau_clone.demande_arreter_clones.connect(self._sur_demande_arreter_clones)
        self.panneau_clone.demande_lancer_clone_profil.connect(self._sur_demande_lancer_clone_profil)
        self.panneau_clone.demande_arreter_clone_profil.connect(self._sur_demande_arreter_clone_profil)
        # AJOUT (SPEC_lot_corrections_2026-09.md section 9) : nouveau
        # bouton Kill par ligne de profil, cf. _sur_demande_kill_clone_
        # profil pour le détail (reprend l'ANCIEN comportement de
        # "Arrêter", cf. sa docstring pour la distinction avec la
        # nouvelle sémantique d'Arrêter de la section 8).
        self.panneau_clone.demande_kill_clone_profil.connect(self._sur_demande_kill_clone_profil)
        # AJOUT (demande explicite utilisateur : clic droit -> premier
        # plan ponctuel, LOCAL SEULEMENT) -- cf. _sur_demande_premier_
        # plan_clone_profil pour le détail et le garde-fou local.
        self.panneau_clone.demande_premier_plan_clone_profil.connect(self._sur_demande_premier_plan_clone_profil)
        self.panneau_clone.demande_definir_profil_actif.connect(self._sur_demande_definir_profil_actif)
        self.panneau_clone.demande_capturer_tout.connect(self._sur_demande_capturer_tout)
        self.panneau_clone.demande_vider_sorties_clones.connect(self._sur_demande_vider_sorties_clones)
        # PATCH (mode local, "Capturer tout" -- cf. SPEC_mode_clone_local.md
        # section 2.4/3.5) : réinjection Qt-safe depuis les threads de
        # capture locale dédiés, cf. docstring du signal _capture_locale_
        # ponctuelle_recue. QueuedConnection explicite (même raison que
        # MoteurExecutionCellule._resultat_pret -- .emit() vient d'un
        # threading.Thread sans event loop Qt).
        self._capture_locale_ponctuelle_recue.connect(
            self._sur_capture_locale_ponctuelle_recue, Qt.QueuedConnection
        )
        self.panneau_clone.demande_copier_logs_execution_clone.connect(self._sur_demande_copier_logs_execution_clone)
        self.panneau_clone.demande_copier_logs_par_profil.connect(self._sur_demande_copier_logs_par_profil)
        self.panneau_clone.demande_forcer_sortie_clones.connect(self._sur_demande_forcer_sortie_clones)
        # AJOUT (SPEC_workspace_attribution.md, section 4) : cf. docstring
        # des deux signaux (PanneauExecutionClone) pour la répartition
        # exacte des responsabilités clic gauche/droit.
        self.panneau_clone.demande_attribuer_workspace_silencieux.connect(
            self._sur_demande_attribuer_workspace_silencieux
        )
        self.panneau_clone.demande_attribuer_workspace_dialogue.connect(
            self._sur_demande_attribuer_workspace_dialogue
        )
        # CORRECTIF (cf. commentaire principal sur self.splitter_notebook_
        # clone plus haut) -- second enfant du splitter, PAS corps_layout
        # directement. Tailles initiales posées ici via setSizes : la
        # première valeur (notebook) est volontairement large ("le reste"
        # -- Qt redistribue tout excédent/déficit vers les tailles
        # positionnées EN PREMIER dans une liste dont la somme ne
        # correspond pas exactement à la largeur réelle du splitter, donc
        # une valeur "1" suffit ici comme convention "prends le reste"),
        # la seconde (227) reprend la largeur fixe d'origine comme valeur
        # de DÉPART -- purement indicative, l'utilisateur peut ensuite
        # glisser la poignée pour l'ajuster librement (cf. setChildren
        # Collapsible(False) posé sur le splitter : aucun des deux
        # panneaux ne peut être réduit à 0px par inadvertance).
        self.splitter_notebook_clone.addWidget(self.panneau_clone)
        self.splitter_notebook_clone.setSizes([1, 227])
        self.splitter_notebook_clone.setStretchFactor(0, 1)
        self.splitter_notebook_clone.setStretchFactor(1, 0)

        outer_layout.addWidget(corps, 1)

    # ------------------------------------------------------------------
    # Barre de chargement RÉELLE d'ouverture de Task (cf. OverlayChargementTask)
    # ------------------------------------------------------------------
    # Ordre ET libellés des étapes de _ouvrir_task qui ont un coût
    # significatif. La clé est STABLE (persistée dans reglages.json, cf.
    # ReglagesApp.calibration_ouverture_task) : ne pas la renommer à la
    # légère, sinon la calibration accumulée de cette étape est perdue.
    _ETAPES_OUVERTURE = (
        ("import_lecture", "Lecture du fichier"),
        ("import_conversion", "Conversion du notebook"),
        ("import_precalcul", "Analyse du code"),
        ("prepa", "Préparation"),
        ("peupler_cellules", "Construction des cellules"),
        ("panneau_composants", "Panneau des composants"),
        ("composants_connus", "Coloration syntaxique"),
        ("variables_globales", "Analyse des variables"),
        ("finitions", "Finalisation"),
        ("prechauffage_affichage", "Mise en page"),
        ("affichage", "Affichage"),
    )

    # Poids PAR DÉFAUT (ms) -- mesurés sur le vrai log de l'utilisateur
    # (Task de 2 cellules : stack.setCurrentWidget=1454, rafraichir_
    # composants_connus=1259, peupler_cellules=775, panneau=54, variables=
    # 32). setCurrentWidget est réparti entre "prechauffage_affichage" et
    # "affichage" car Qt y fait le polish + layout + première peinture de
    # tous les widgets construits avant. Ce ne sont que des valeurs de
    # DÉPART : dès la première ouverture réelle, _memoriser_calibration_
    # ouverture les remplace par les durées effectivement mesurées.
    _POIDS_OUVERTURE_DEFAUT = {
        "import_lecture": 60.0,
        "import_conversion": 120.0,
        "import_precalcul": 80.0,
        "prepa": 40.0,
        "peupler_cellules": 775.0,
        "panneau_composants": 54.0,
        "composants_connus": 1259.0,
        "variables_globales": 32.0,
        "finitions": 30.0,
        # REBALANCÉ avec le patch H2 : "prechauffage_affichage" ne fait
        # plus qu'un ensurePolished() sur la page (le layout.activate() +
        # adjustSize() ont été retirés, cf. l'étape elle-même), il ne
        # prend donc plus le gros de setCurrentWidget à sa charge. Les
        # 1454 ms mesurées sur setCurrentWidget en session A retournent
        # dans "affichage", et le préchauffage redescend à une valeur de
        # départ modeste. La CLÉ est inchangée (cf. §6 de la spec : pas de
        # renommage sans migration de reglages.json) -- seule sa valeur
        # par défaut bouge, et la moyenne mobile exponentielle (α=0,4)
        # recale de toute façon une calibration héritée en 2-3 ouvertures.
        "prechauffage_affichage": 120.0,
        "affichage": 1450.0,
    }

    # Coefficient de la moyenne mobile exponentielle : 0.4 = la dernière
    # mesure pèse 40 %, l'historique 60 % -- assez réactif pour suivre un
    # Task très différent, assez lissé pour qu'une mesure aberrante
    # (antivirus, disque lent une fois) ne fausse pas la barre suivante.
    _ALPHA_CALIBRATION = 0.4

    # Étapes dont le coût grandit avec le nombre de cellules : stockées
    # (calibration) et estimées (défauts) en ms PAR CELLULE.
    _ETAPES_PAR_CELLULE = frozenset(
        {"import_lecture", "import_conversion", "import_precalcul",
         "peupler_cellules", "composants_connus", "prechauffage_affichage", "affichage"}
    )

    _ETAPES_IMPORT = ("import_lecture", "import_conversion", "import_precalcul")

    def _poids_ouverture(self, nb_cellules: int, avec_import: bool = False) -> dict:
        """Poids estimé (ms) de chaque étape pour CETTE ouverture.

        Source, par ordre de priorité : (1) calibration mesurée dans
        reglages.json, (2) valeurs par défaut. Les étapes de
        _ETAPES_PAR_CELLULE sont stockées en ms/cellule et multipliées
        ici par le nombre de cellules du Task courant ; les autres sont
        des durées fixes. Les défauts de _POIDS_OUVERTURE_DEFAUT ayant été
        mesurés sur un Task de 2 cellules, ils sont divisés par 2 pour
        obtenir leur équivalent par cellule."""
        calib = {}
        if self.reglages is not None:
            calib = getattr(self.reglages, "calibration_ouverture_task", None) or {}
        n = max(1, nb_cellules)
        poids = {}
        for cle, _libelle in self._ETAPES_OUVERTURE:
            par_cellule = cle in self._ETAPES_PAR_CELLULE
            if cle in calib:
                base = float(calib[cle])
            elif par_cellule:
                base = self._POIDS_OUVERTURE_DEFAUT[cle] / 2.0
            else:
                base = self._POIDS_OUVERTURE_DEFAUT[cle]
            poids[cle] = base * n if par_cellule else base
            if cle in self._ETAPES_IMPORT and not avec_import:
                poids[cle] = 0.0
        return poids

    def _memoriser_calibration_ouverture(self, durees_ms: dict, nb_cellules: int):
        """Fusionne les durées MESURÉES de cette ouverture dans la
        calibration persistée (moyenne mobile exponentielle). Les étapes
        proportionnelles au nombre de cellules sont stockées en ms PAR
        CELLULE, pour que la calibration reste juste d'un Task à l'autre
        quelle que soit leur taille."""
        if self.reglages is None or not hasattr(self.reglages, "calibration_ouverture_task"):
            return
        n = max(1, nb_cellules)
        calib = self.reglages.calibration_ouverture_task
        for cle, duree in durees_ms.items():
            valeur = duree / n if cle in self._ETAPES_PAR_CELLULE else duree
            ancienne = calib.get(cle)
            calib[cle] = valeur if ancienne is None else (
                self._ALPHA_CALIBRATION * valeur + (1.0 - self._ALPHA_CALIBRATION) * ancienne
            )
        try:
            self.reglages.save()
        except Exception as exc:  # jamais bloquer l'ouverture pour un souci de disque
            log_ouverture_task.warning(f"Calibration d'ouverture non sauvegardée : {exc}")

    # ------------------------------------------------------------------
    # Barre UNIQUE pendant un IMPORT : le worker (thread) mesure ses 3
    # phases, cette barre les affiche, puis _ouvrir_task reprend la MÊME
    # barre là où elle s'est arrêtée (aucun retour à 0, aucune 2e barre).
    # ------------------------------------------------------------------
    def _demarrer_barre_import(self, titre: str):
        """Affiche la barre AVANT le lancement du worker. Le nombre de
        cellules du Task importé n'est pas encore connu (le fichier n'est
        pas lu) : les poids sont estimés avec la taille du dernier Task
        ouvert, puis _sur_phase_import_terminee les recale sur la vraie
        taille dès que la conversion la révèle."""
        self._import_nb_cellules_estime = max(1, getattr(self, "_dernier_nb_cellules_ouvert", 2))
        self._import_poids = self._poids_ouverture(self._import_nb_cellules_estime, avec_import=True)
        self._import_cumul = 0.0
        self.overlay_chargement_task.demarrer(titre)
        self.overlay_chargement_task.mettre_a_jour(0.0, dict(self._ETAPES_OUVERTURE)["import_lecture"])
        self._import_mesures = {}

    def _sur_phase_import_terminee(self, cle: str, duree_ms: float):
        """Slot de ImportTaskWorker.phase_terminee (thread UI). Avance la
        barre de la part de poids de la phase terminée, mémorise sa durée
        réelle pour la calibration."""
        poids = getattr(self, "_import_poids", None)
        if poids is None:
            return
        self._import_mesures[cle] = duree_ms
        self._import_cumul += poids.get(cle, 0.0)
        total = sum(poids.values()) or 1.0
        cles = [c for c, _ in self._ETAPES_OUVERTURE]
        idx = cles.index(cle) + 1
        suivante = dict(self._ETAPES_OUVERTURE)[cles[idx]] if idx < len(cles) else ""
        self.overlay_chargement_task.mettre_a_jour(self._import_cumul / total, suivante)

    def _abandonner_barre_import(self):
        """Import échoué/annulé : masque la barre et oublie l'état."""
        self._import_poids = None
        self._import_mesures = {}
        self.overlay_chargement_task.terminer()

    def _connecter_worker_import(self, worker):
        worker.phase_terminee.connect(self._sur_phase_import_terminee)

    # DIAGNOSTIC E4 (SPEC_patch_ouverture_task.md §3) -- au bout de combien
    # de secondes d'ouverture on considère qu'il y a gel, et qu'on veut la
    # pile Python du thread principal. 20 s : très au-dessus d'une
    # ouverture normale (~3 s mesurées, même sur le plus gros Task testé),
    # très en-dessous des 44 s observées lors du blocage -- donc la pile
    # tombe PENDANT le gel, à l'endroit exact où le thread est coincé,
    # plutôt qu'après coup.
    _SEUIL_FAULTHANDLER_OUVERTURE_S = 20.0

    def _ouvrir_task(self, task_id: str, precalcul_editeur: Optional[dict] = None):
        """Point d'entrée UNIQUE d'ouverture d'un Task (clic carte, import,
        nouvelle version, création...) -- délègue à _ouvrir_task_impl en
        ajoutant une GARDE DE RÉENTRANCE.

        Pourquoi : la barre de chargement (cf. OverlayChargementTask) doit
        se repeindre entre chaque étape. Tant que ce repaint passait par
        QApplication.processEvents(), n'importe quel événement en attente
        (raccourci clavier, signal d'import terminé, _reload_grille, slot
        réseau instances_list...) pouvait rappeler _ouvrir_task -- ce qui
        reconstruirait les widgets de cellule (_peupler_cellules) EN PLEIN
        MILIEU de la construction précédente et corromprait
        self._cellule_widgets. Les processEvents ont depuis été remplacés
        par OverlayChargementTask.repeindre_immediatement() (cf. §R5),
        qui ne délivre AUCUN événement en attente : la fenêtre de
        réentrance est donc refermée à la source. Cette garde est
        CONSERVÉE quand même -- elle ne coûte rien, elle couvre les
        appelants qui arriveraient par un autre chemin (un QTimer, un
        dialogue modal ouvert par une étape...), et la retirer
        supposerait de prouver qu'aucune étape n'ouvre jamais de boucle
        d'événements imbriquée. Une ouverture demandée pendant qu'une
        autre est en cours est donc IGNORÉE (et loggée), jamais empilée.

        try/finally : le drapeau est TOUJOURS libéré, même si
        _ouvrir_task_impl lève -- sinon une seule erreur bloquerait
        définitivement l'ouverture de tous les Tasks jusqu'au redémarrage.
        L'overlay est aussi masqué dans ce cas pour ne jamais rester
        affiché après un échec.

        DIAGNOSTIC E4 (§3 de la spec) : avec AUTONIAX_DEBUG=1, un
        faulthandler est armé pour cracher la pile Python du thread
        principal s'il ne rend pas la main au bout de
        _SEUIL_FAULTHANDLER_OUVERTURE_S. C'est la seule façon de
        distinguer "gel très long" de "vrai plantage", et de savoir DANS
        QUELLE fonction le thread est coincé : un traceback classique
        exigerait une exception, ici il n'y en a aucune. Toujours désarmé
        dans le finally -- laisser un dump_traceback_later actif polluerait
        toutes les opérations suivantes."""
        if getattr(self, "_ouverture_task_en_cours", False):
            log_ouverture_task.warning(
                f"[{task_id}] _ouvrir_task ignoré : une ouverture est déjà en cours."
            )
            return
        self._ouverture_task_en_cours = True
        TraceOuverture.demarrer_ouverture(task_id, sys._getframe().f_code)
        surveillance_gel = os.environ.get("AUTONIAX_DEBUG") == "1"
        if surveillance_gel:
            try:
                faulthandler.dump_traceback_later(
                    self._SEUIL_FAULTHANDLER_OUVERTURE_S, exit=False
                )
            except Exception as exc:  # jamais bloquer une ouverture pour du diagnostic
                log_ouverture_task.warning(f"faulthandler non armé : {exc}")
                surveillance_gel = False
        try:
            self._ouvrir_task_impl(task_id, precalcul_editeur)
        finally:
            if surveillance_gel:
                try:
                    faulthandler.cancel_dump_traceback_later()
                except Exception:
                    pass
            self._ouverture_task_en_cours = False
            overlay = getattr(self, "overlay_chargement_task", None)
            if overlay is not None and overlay.isVisible():
                overlay.terminer()
            TraceOuverture.fin_synchrone()

    def _planifier_sauvegarde_projet_differee(self):
        """Sauvegarde de project.json dans un THREAD DE FOND (sérialisation JSON
        + écriture disque hors du thread UI). Coalescée : si une sauvegarde est
        en cours, une seule relance est mémorisée. Écriture atomique."""
        self._sauvegarde_async_demandee = True
        if getattr(self, "_sauvegarde_async_active", False):
            return
        self._sauvegarde_async_active = True
        projet = self.project

        def _travail():
            try:
                while self._sauvegarde_async_demandee:
                    self._sauvegarde_async_demandee = False
                    for essai in range(4):
                        try:
                            _ta = time.perf_counter()
                            data = _nettoyer_list_tasks_avant_sauvegarde(projet.to_dict())
                            _tb = time.perf_counter()
                            texte = json.dumps(data, ensure_ascii=False, indent=2)
                            _tc = time.perf_counter()
                            chemin = get_project_json_path()
                            tmp = chemin.with_suffix(chemin.suffix + ".tmp")
                            tmp.write_text(texte, encoding="utf-8")
                            os.replace(tmp, chemin)
                            _td = time.perf_counter()
                            TraceOuverture.noter_tache_fond(
                                "sauvegarde project.json (thread)", _ta, _td,
                                f"to_dict={(_tb - _ta) * 1000:.0f}ms json.dumps(indent)={(_tc - _tb) * 1000:.0f}ms "
                                f"écriture={(_td - _tc) * 1000:.0f}ms taille={len(texte) // 1024}Ko",
                            )
                            break
                        except RuntimeError:
                            # structure modifiée par l'UI pendant l'itération : on retente
                            time.sleep(0.05)
                        except Exception as exc:
                            log_ouverture_task.warning(f"Sauvegarde async échouée : {exc}")
                            break
            finally:
                self._sauvegarde_async_active = False

        threading.Thread(target=_travail, name="SauvegardeProjet", daemon=False).start()

    def _sauvegarder_projet_differe(self):
        self._planifier_sauvegarde_projet_differee()

    def _ouvrir_task_impl(self, task_id: str, precalcul_editeur: Optional[dict] = None):
        """PATCH (freeze à l'ouverture d'un .autoniaxtask volumineux, cf.
        docstring de _precalculer_editeur_pour_task) : `precalcul_
        editeur`, quand fourni par _sur_import_task_termine/_sur_
        nouvelle_version_task_termine juste après un import, est
        transmis tel quel à _rafraichir_composants_connus_editeur/
        _rafraichir_variables_globales_editeur plus bas pour leur
        éviter de reparcourir toutes les cellules du Task qu'on vient
        justement de finir de construire -- ce travail a déjà été fait
        une fois, côté ImportTaskWorker, pendant que l'UI restait
        libre. None (défaut) pour tout appel normal (clic sur une
        carte de la grille, changement d'onglet...) -- comportement
        entièrement inchangé dans ce cas, recalcul comme avant ce
        patch.

        DIAGNOSTIC (demande explicite utilisateur, cf. log_ouverture_task
        ci-dessus pour le contexte complet -- "la barre de chargement
        pour l'ouverture d'un task ne fonctionne absolument pas [...] je
        veux que tu affiches des logs qui font tracker exactement quelle
        opération fait perdre plus de temps") : chaque étape ci-dessous
        est chronométrée séparément (time.perf_counter, résolution fine,
        insensible aux changements d'horloge système contrairement à
        time.time) et logguée individuellement en DEBUG dès qu'elle
        franchit un seuil de bruit (1 ms -- en-dessous, le temps de log
        lui-même dominerait la mesure), puis un récapitulatif complet est
        loggué en INFO à la fin, TOUJOURS (même si toutes les étapes sont
        rapides), trié par coût décroissant -- pour voir d'un coup d'oeil
        laquelle domine sur CE Task précis, sans avoir à chercher dans le
        détail des lignes DEBUG. Ce chronométrage est PUREMENT
        diagnostique : aucune étape n'est sautée, retardée ni modifiée en
        fonction du temps mesuré -- seul le contenu des logs change."""

        horodatage_debut_ouverture = time.perf_counter()
        durees_etapes: list = []  # [(nom_etape, duree_ms), ...] dans l'ordre d'exécution
        # PATCH6 : le repaint de la barre (_etape_terminee) se faisait entre deux
        # _chrono et était donc compté dans l'étape SUIVANTE. Il est maintenant
        # mesuré à part et retranché de l'étape suivante.
        surcout_attente_ms = 0.0

        def _chrono(nom_etape: str, depart: float) -> float:
            """Mesure l'écart depuis `depart`, l'ajoute à durees_etapes,
            logue en DEBUG si significatif (>1ms), et retourne l'horodatage
            actuel."""
            nonlocal surcout_attente_ms
            maintenant = time.perf_counter()
            duree_ms = (maintenant - depart) * 1000
            if surcout_attente_ms:
                duree_ms = max(0.0, duree_ms - surcout_attente_ms)
                surcout_attente_ms = 0.0
            durees_etapes.append((nom_etape, duree_ms))
            if duree_ms > 1:
                log_ouverture_task.debug(f"[{task_id}] {nom_etape} : {duree_ms:.1f} ms")
            return maintenant

        t = horodatage_debut_ouverture
        task = self.project.find_task(task_id)
        t = _chrono("find_task", t)
        if task is None:
            return
        self._task_courant = task_id

        # ---- Barre de chargement RÉELLE (cf. OverlayChargementTask) ----
        # Poids estimés de chaque étape (calibration mesurée si dispo),
        # normalisés en fraction du total. La barre avance d'un cran APRÈS
        # chaque étape réellement terminée, de la part de coût qu'elle
        # représente -- pas d'animation en boucle décorrélée du travail.
        nb_cellules = len(task.cellules)
        self._dernier_nb_cellules_ouvert = nb_cellules
        # Ouverture consécutive à un IMPORT : la barre est déjà affichée et
        # a déjà avancé pendant les phases du worker. On reprend LA MÊME
        # (poids recalés sur le vrai nombre de cellules, maintenant connu),
        # en repartant de la part déjà accomplie -- jamais de retour à 0.
        apres_import = getattr(self, "_import_poids", None) is not None
        poids = self._poids_ouverture(nb_cellules, avec_import=apres_import)
        total_poids = sum(poids.values()) or 1.0
        mesures_calibration: dict = dict(getattr(self, "_import_mesures", {}) or {})  # {cle_etape: duree_ms}
        cumul_poids = sum(poids[c] for c in mesures_calibration if c in poids)
        libelles = dict(self._ETAPES_OUVERTURE)
        self._import_poids = None
        self._import_mesures = {}

        # N'affiche l'overlay que si l'ouverture est estimée assez longue
        # pour que la barre ait un sens : en dessous, elle ne ferait que
        # clignoter. Seuil = 400 ms estimées.
        afficher_overlay = apres_import or total_poids >= 400.0
        if afficher_overlay and not self.overlay_chargement_task.isVisible():
            self.overlay_chargement_task.demarrer(f"Ouverture de « {task.nom} »…")
            self.overlay_chargement_task.repeindre_immediatement()

        def _etape_terminee(cle: str, depart: float) -> float:
            """Clôt l'étape `cle` : enregistre sa durée pour la
            calibration, avance la barre de sa part de poids, et repeint
            la barre AVANT l'étape suivante (sans ça, le thread UI
            enchaînerait toutes les étapes sans jamais repeindre, et la
            barre resterait figée jusqu'à la fin).

            PATCH R5/H3 : le repaint passe par
            OverlayChargementTask.repeindre_immediatement() et NON PLUS
            par QApplication.processEvents(). Les deux affichent bien la
            barre, mais processEvents() délivre en prime TOUS les
            événements en attente -- timers, DeferredDelete, et surtout
            les slots réseau (ClientReseau.instances_list ->
            _sur_liste_instances_recue -> _invalider_liaisons_instances_
            disparues -> panneau_composants.rafraichir, qui DÉTRUIT et
            RECONSTRUIT des widgets) -- au beau milieu de la
            reconstruction de l'éditeur. repaint() ne fait que peindre."""
            nonlocal cumul_poids, surcout_attente_ms
            maintenant = time.perf_counter()
            mesures_calibration[cle] = mesures_calibration.get(cle, 0.0) + (maintenant - depart) * 1000
            cumul_poids += poids[cle]
            if afficher_overlay:
                # Libellé de l'étape SUIVANTE (celle qui va tourner) : c'est
                # elle que l'utilisateur attend, pas celle qui vient de finir.
                cles = [c for c, _ in self._ETAPES_OUVERTURE]
                idx = cles.index(cle) + 1
                suivante = libelles[cles[idx]] if idx < len(cles) else "Terminé"
                self.overlay_chargement_task.mettre_a_jour(cumul_poids / total_poids, suivante)
                self.overlay_chargement_task.repeindre_immediatement()
            fin_ov = time.perf_counter()
            if afficher_overlay:
                ov_ms = (fin_ov - maintenant) * 1000
                durees_etapes.append((f"[barre] mise à jour + repaint après « {cle} »", ov_ms))
                surcout_attente_ms += ov_ms
            return fin_ov

        # Le premier libellé affiché est celui de la première étape.
        if afficher_overlay and not apres_import:
            self.overlay_chargement_task.mettre_a_jour(cumul_poids / total_poids, libelles["prepa"])
            self.overlay_chargement_task.repeindre_immediatement()

        t = _chrono("poids + overlay.demarrer + 1er repaint", t)
        t_etape = time.perf_counter()

        # --- Étape "prepa" : tout le travail léger avant les widgets ---
        self._invalider_liaisons_instances_disparues(self._instances_actives)
        t = _chrono("invalider_liaisons_instances_disparues", t)

        task.date_derniere_ouverture = datetime.now().isoformat()
        # PATCH anti-gel : plus d'écriture synchrone de TOUT project.json pendant
        # l'ouverture (debounce 1,5 s, hors du chemin critique).
        self._planifier_sauvegarde_projet_differee()
        t = _chrono("project.save différé (date_derniere_ouverture)", t)

        self._sequence_file = None
        self._sequence_cellule_courante = None
        self._sequence_active = False
        self._dernier_statut_sequence = None

        self.nom_edit.blockSignals(True)
        self.nom_edit.setText(task.nom)
        self.nom_edit.blockSignals(False)

        self.combo_mode_execution.blockSignals(True)
        index_mode = self.combo_mode_execution.findData(task.mode_execution)
        self.combo_mode_execution.setCurrentIndex(index_mode if index_mode >= 0 else 0)
        self.combo_mode_execution.blockSignals(False)
        t = _chrono("reinit_sequence + nom_edit + combo_mode_execution", t)
        self._rafraichir_visibilite_controles_reseau(task)
        t = _chrono("rafraichir_visibilite_controles_reseau", t)
        self._rafraichir_apres_changement_executant_actif(task)
        t = _chrono("rafraichir_apres_changement_executant_actif", t)
        self._rafraichir_statut_reseau(task)
        t = _chrono("rafraichir_statut_reseau", t)
        t_etape = _etape_terminee("prepa", t_etape)

        # --- Étape "peupler_cellules" ---
        self._peupler_cellules(task, incremental=True, precalcul_editeur=precalcul_editeur)
        t = _chrono(f"peupler_cellules ({len(task.cellules)} cellule(s))", t)
        t_etape = _etape_terminee("peupler_cellules", t_etape)

        # --- Étape "panneau_composants" ---
        self.panneau_composants.rafraichir(task)
        t = _chrono("panneau_composants.rafraichir", t)
        t_etape = _etape_terminee("panneau_composants", t_etape)

        # --- Étape "composants_connus" (coloration syntaxique) ---
        self._rafraichir_composants_connus_editeur(task, precalcul_editeur)
        t = _chrono("rafraichir_composants_connus_editeur", t)
        t_etape = _etape_terminee("composants_connus", t_etape)

        # --- Étape "variables_globales" ---
        self._rafraichir_variables_globales_editeur(task, precalcul_editeur)
        t = _chrono("rafraichir_variables_globales_editeur", t)
        t_etape = _etape_terminee("variables_globales", t_etape)

        # --- Étape "finitions" ---
        self.barre_acces_rapide.rafraichir(task)
        self._rafraichir_barre_libs()
        t = _chrono("barre_acces_rapide.rafraichir", t)
        self._rafraichir_index_cellules(task)
        t = _chrono("rafraichir_index_cellules", t)
        self._rafraichir_bouton_global()
        t = _chrono("rafraichir_bouton_global", t)
        # (cf. commentaire d'origine) _peupler_cellules a reconstruit tous
        # les TaskCelluleWidget : réappliquer l'affichage WORKSPACE du
        # profil clone actif, sinon WORKSPACE = [] réapparaîtrait.
        self._rafraichir_affichage_workspace_cellule_variables(task)
        t = _chrono("rafraichir_affichage_workspace_cellule_variables", t)
        # AJOUT (demande explicite utilisateur : "le panneau de service api
        # quand on ouvre le notebook soit fermé") -- le panneau des
        # composants importés démarre REPLIÉ (bande étroite avec le seul
        # chevron, cf. PanneauComposantsImportesTask._basculer_replie) à
        # CHAQUE ouverture d'un Task, même s'il avait été déplié lors
        # d'une ouverture précédente. L'utilisateur le déplie à la demande
        # via le chevron (ou double-clic sur la poignée du splitter).
        _bouton_repli = self.panneau_composants.bouton_replier
        if _bouton_repli.isChecked():
            self.panneau_composants._basculer_replie(True)  # ré-applique la largeur repliée
        else:
            _bouton_repli.setChecked(True)  # déclenche _basculer_replie(True)
        t = _chrono("panneau_composants replié par défaut", t)
        t_etape = _etape_terminee("finitions", t_etape)

        # --- Étape "prechauffage_affichage" ---
        # setCurrentWidget déclenche, d'un seul bloc et sans rendre la main,
        # le polish + le layout + la première peinture de TOUS les widgets
        # construits ci-dessus (mesuré : ~1450 ms sur un Task de 2 cellules,
        # 40 % du temps total). Sans préchauffage, la barre resterait figée
        # à ~60 % pendant ce bloc opaque. On avance donc ici, AVANT le
        # changement de page, le polish de la page éditeur -- travail que
        # Qt ferait de toute façon dans setCurrentWidget, simplement rendu
        # mesurable et attribué à une étape de la barre.
        #
        # PATCH H2 (SPEC_patch_ouverture_task.md §2) -- le préchauffage a
        # été RAMENÉ à ce seul ensurePolished(). Les trois opérations
        # supplémentaires qu'il faisait avant sont supprimées :
        #
        #   * la boucle `for w in findChildren(QWidget): w.ensurePolished()`
        #     était redondante -- ensurePolished() polit DÉJÀ le widget ET
        #     tout son sous-arbre (doc Qt : "Ensures that the widget and
        #     its children have been polished by QStyle") -- tout en
        #     payant en plus un findChildren() récursif sur l'arbre entier ;
        #   * layout.activate() et notebook_contenu.adjustSize() forçaient
        #     une passe de mise en page sur une géométrie qui n'est PAS
        #     encore la bonne (la page est toujours masquée, elle n'a pas
        #     sa taille finale). Résultat : toutes les largeurs de cellule
        #     changent une première fois ici, puis une SECONDE fois au
        #     setCurrentWidget -- et chaque changement de largeur déclenche
        #     TaskScriptEditor.resizeEvent -> _ajuster_hauteur ->
        #     setFixedHeight -> invalidation du layout parent -> nouvelle
        #     passe. C'est exactement la cascade décrite en H2, et le code
        #     d'ORIGINE (avant la barre de chargement) ne faisait rien de
        #     tel. Mesuré au banc en mode retour-à-la-ligne :
        #     _ajuster_hauteur appelée 125 à 158 fois pour 3 éditeurs.
        #
        # ensurePolished() seul, lui, ne touche à aucune géométrie : il ne
        # peut pas déclencher de cascade de relayout.
        self.editeur_page.ensurePolished()
        t = _chrono("prechauffage_affichage (polish)", t)
        t_etape = _etape_terminee("prechauffage_affichage", t_etape)

        # --- Étape "affichage" ---
        # DIAGNOSTIC E5 (§3 de la spec) : cProfile ne voit pas le temps
        # passé dans le C++ de Qt, donc un setCurrentWidget de 42 s y
        # apparaîtrait comme un unique appel opaque. Le compteur
        # d'événements, lui, dit si ce temps part dans une CASCADE (des
        # milliers de LayoutRequest/Resize) ou dans un petit nombre
        # d'opérations réellement lentes. Actif uniquement sous
        # AUTONIAX_DEBUG=1 (un filtre d'événements global coûte cher).
        compteur_evenements = None
        if os.environ.get("AUTONIAX_DEBUG") == "1":
            application = QApplication.instance()
            if application is not None:
                compteur_evenements = CompteurEvenementsQt()
                application.installEventFilter(compteur_evenements)
        try:
            self.stack.setCurrentWidget(self.editeur_page)
        finally:
            if compteur_evenements is not None:
                application = QApplication.instance()
                if application is not None:
                    application.removeEventFilter(compteur_evenements)
                log_ouverture_task.debug(
                    f"[{task_id}] événements Qt pendant setCurrentWidget : "
                    f"{compteur_evenements.resume()}"
                )
        t = _chrono("stack.setCurrentWidget", t)
        t_etape = _etape_terminee("affichage", t_etape)

        if afficher_overlay:
            self.overlay_chargement_task.terminer()
        t = _chrono("overlay.terminer", t)

        # Calibration : les durées mesurées servent à pondérer la barre à
        # la PROCHAINE ouverture (moyenne mobile, cf. _memoriser_calibration_
        # ouverture). Faite APRÈS l'affichage pour ne rien retarder.
        self._memoriser_calibration_ouverture(mesures_calibration, nb_cellules)
        t = _chrono("_memoriser_calibration_ouverture", t)

        # DIAGNOSTIC E1 (SPEC_patch_ouverture_task.md §3, "Vérifier la
        # fuite") : taille RÉELLE de l'arbre Qt sous la page éditeur,
        # relevée à chaque ouverture. C'est le seul chiffre qui tranche
        # H1 sur la VRAIE application plutôt qu'au banc de test -- si N et
        # M croissent d'une ouverture à l'autre, des widgets de cellule
        # restent dans l'arbre (chercher alors qui garde une référence :
        # _cellule_widgets, signaux code_modifie/demande_* connectés vers
        # TaskConfigScreen, _multi_curseur_etat, _tous_les_editeurs_du_task) ;
        # s'ils restent STABLES alors que c'est lent, H1 est réfutée et la
        # cause est ailleurs.
        #
        # Valeurs attendues après le correctif setParent(None) de
        # _peupler_cellules : strictement identiques à chaque ouverture
        # d'un même Task (M = nombre de cellules + 1 pour cellule_variables).
        #
        # Relevé APRÈS l'affichage et la calibration : findChildren()
        # parcourt tout l'arbre, donc il ne doit retarder ni la peinture
        # ni la sauvegarde. try/except : un compteur de diagnostic ne doit
        # jamais faire échouer une ouverture.
        try:
            nb_widgets_arbre = len(self.editeur_page.findChildren(QWidget))
            nb_editeurs_arbre = len(self.editeur_page.findChildren(TaskScriptEditor))
            arbre_qt = f"arbre Qt : {nb_widgets_arbre} widgets, {nb_editeurs_arbre} éditeurs"
        except Exception as exc:
            arbre_qt = f"arbre Qt : non mesuré ({exc})"
        t = _chrono("findChildren (compteur d'arbre Qt, diagnostic)", t)

        # Récapitulatif -- TOUJOURS loggué, trié par coût décroissant.
        duree_totale_ms = (time.perf_counter() - horodatage_debut_ouverture) * 1000
        etapes_triees = sorted(durees_etapes, key=lambda x: x[1], reverse=True)
        detail = " | ".join(f"{nom}={duree_ms:.1f}ms" for nom, duree_ms in etapes_triees[:8])
        TraceOuverture.noter_etapes(durees_etapes, len(task.cellules), duree_totale_ms)
        log_ouverture_task.info(
            f"[{task_id}] _ouvrir_task terminé en {duree_totale_ms:.1f} ms "
            f"({len(task.cellules)} cellule(s)) -- {arbre_qt} -- top étapes : {detail}"
        )

    def _rafraichir_index_cellules(self, task: Task):
        """Recalcule et réaffiche le numéro de POSITION (0, 1, 2...) de
        chaque TaskCelluleWidget (cf. TaskCelluleWidget.definir_index) --
        même ordre VISUEL que BarreAccesRapideTask.rafraichir : cellule
        variables dynamiques en premier (numéro 0), PUIS cellules[0]
        statique (numéro 1), PUIS cellules[1:] (cf. _peupler_cellules --
        cellule_variables est insérée avant cellules[0] et donc affichée
        au-dessus à l'écran, "Variable dynamique tout en haut"). Numérote
        bien à partir de 0, pas de task.cellules dans son ordre de
        données, pour que les deux numérotations (bandeau de cellule +
        bande Accès rapide) restent toujours synchronisées entre elles
        ET avec ce que l'utilisateur voit réellement à l'écran. Appelé
        uniquement à l'ajout/suppression d'une cellule (ou à l'ouverture
        d'un Task) -- jamais à l'exécution, contrairement à
        label_indicateur/In[n]."""
        numero = 0
        if task.cellule_variables is not None:
            widget = self._cellule_widgets.get(task.cellule_variables.id)
            if widget is not None:
                widget.definir_index(numero)
            numero += 1
        if task.cellules:
            widget = self._cellule_widgets.get(task.cellules[0].id)
            if widget is not None:
                widget.definir_index(numero)
            numero += 1
        for cellule in task.cellules[1:]:
            widget = self._cellule_widgets.get(cellule.id)
            if widget is not None:
                widget.definir_index(numero)
            numero += 1

    def _sur_clic_acces_rapide(self, cellule_id: str):
        """Handler du clic sur une tuile de BarreAccesRapideTask
        (décision explicite utilisateur : "si on clic dessus alors
        linterface slide directement jusqua ce niveau") -- fait défiler
        notebook_scroll jusqu'au widget de la cellule visée, PUIS la
        surligne brièvement pour un repère visuel clair une fois le slide
        terminé.

        Trois emplacements possibles pour un TaskCelluleWidget (cf.
        _build_editeur/_peupler_cellules) :
        - dans notebook_contenu directement (cas normal, y compris "Main"
          -- MAJ décision utilisateur : elle n'est plus jamais sticky) ;
        - dans row0_detachee_container, lui-même un unique enfant de
          notebook_contenu ("Variable dynamique" détachée, étiquette
          désactivée, cf. _positionner_row0) -- il faut alors faire
          défiler jusqu'au CONTENEUR, pas jusqu'au widget seul
          (ensureWidgetVisible fonctionne avec n'importe quel descendant
          du widget du scroll, donc cibler directement le widget de la
          cellule suffit en pratique, mais le conteneur est explicité ici
          par clarté) ;
        - dans cellule_statique_container ("Variable dynamique" sticky,
          cas par défaut) -- déjà en permanence visible au-dessus du
          notebook scrollable, donc AUCUN scroll n'est nécessaire ni
          possible (elle ne vit pas dans notebook_scroll) : on se
          contente du surlignage.
        """
        self._assurer_cellule_montee(cellule_id)   # PATCH (étape 3)
        widget = self._cellule_widgets.get(cellule_id)
        if widget is None:
            return

        # ensureWidgetVisible marche pour un widget vivant n'importe où
        # dans la hiérarchie du widget affiché par le QScrollArea -- donc
        # aussi bien pour un widget directement dans notebook_contenu que
        # pour un widget niché dans row0_detachee_container (lui-même
        # dans notebook_contenu). Seul le cas "row 0 sticky" (widget dans
        # cellule_statique_container, hors du QScrollArea) doit être
        # exclu, sinon ensureWidgetVisible sur un widget étranger au
        # scroll ne fait simplement rien -- inoffensif, mais autant ne
        # pas l'appeler dans ce cas pour que le code reste lisible.
        widget_est_dans_le_scroll = self._widget_est_descendant(widget, self.notebook_contenu)
        if widget_est_dans_le_scroll:
            # Marge verticale généreuse (80px) pour que la cellule ne
            # colle pas juste au bord supérieur du scroll une fois
            # visible -- petit confort de lecture, cf. QScrollArea.
            self.notebook_scroll.ensureWidgetVisible(widget, 0, 80)

        self._surligner_cellule(widget)

    def _sur_clic_droit_acces_rapide(self, cellule_id: str):
        """Handler du clic DROIT sur une tuile de BarreAccesRapideTask
        (demande explicite utilisateur : "clic droit ramene plutot a la
        sortie de ces cellule", précisé ensuite : "sa doit toujour slider
        a la fin de la celleule meme sil ya pas encore de sortie") --
        vise TOUJOURS le bas du widget de la cellule (donc sa sortie
        quand elle est visible, puisque zone_sortie est le dernier
        widget de colonne_layout -- cf. TaskCelluleWidget.__init__ --
        mais aussi la fin du widget quand il n'y a pas encore de sortie),
        jamais le widget entier comme le fait _sur_clic_acces_rapide
        (qui, lui, cadre sur le HAUT du widget).

        Même mécanique que _naviguer_vers_position (mapTo + ensureVisible
        plutôt que ensureWidgetVisible) : ensureWidgetVisible(widget, ...)
        cadre sur le widget entier et peut retomber n'importe où selon sa
        hauteur (d'où le symptôme rapporté : "sa vas au centre") --
        cibler explicitement le point (x, bas du widget) force le scroll
        à amener précisément la fin de la cellule à l'écran."""
        self._assurer_cellule_montee(cellule_id)   # PATCH (étape 3)
        widget = self._cellule_widgets.get(cellule_id)
        if widget is None:
            return

        widget_est_dans_le_scroll = self._widget_est_descendant(widget, self.notebook_contenu)
        if widget_est_dans_le_scroll:
            bas_widget = QPoint(0, widget.height())
            point_dans_notebook = widget.mapTo(self.notebook_contenu, bas_widget)
            # Marge de 80px des deux côtés (comme _sur_clic_acces_rapide/
            # _naviguer_vers_position) pour ne pas coller la fin de la
            # cellule pile au bord inférieur du scroll une fois visible.
            self.notebook_scroll.ensureVisible(
                point_dans_notebook.x(),
                point_dans_notebook.y(),
                0,
                80,
            )

        self._surligner_cellule(widget)

    def _widget_est_descendant(self, widget: QWidget, ancetre: QWidget) -> bool:
        """Vrai si widget est ancetre lui-même ou l'un de ses descendants
        -- utilisé pour distinguer une cellule vivant dans le notebook
        scrollable (notebook_contenu, y compris nichée dans
        row0_detachee_container) d'une cellule dans la row 0 sticky
        (cellule_statique_container, hors du QScrollArea, cf. docstring
        _sur_clic_acces_rapide)."""
        courant = widget
        while courant is not None:
            if courant is ancetre:
                return True
            courant = courant.parentWidget()
        return False

    # ------------------------------------------------------------------
    # PATCH : Ctrl+F (sélection -> surligner toutes les occurrences dans
    # tout le notebook) et Ctrl+D (ajouter une occurrence à l'édition
    # multi-curseur simulée) -- cf. docstring de self._multi_curseur_etat
    # dans __init__ pour la structure de données et le raisonnement
    # d'ensemble.
    # ------------------------------------------------------------------

    def _tous_les_editeurs_du_task(self) -> list:
        """Liste des TaskScriptEditor de TOUTES les cellules actuellement
        chargées du Task ouvert (self._cellule_widgets), dans l'ordre où
        elles apparaissent dans le notebook -- ordre pas garanti par un
        dict Python en toute rigueur, mais self._cellule_widgets est
        peuplé dans l'ordre d'affichage (cf. _reconstruire_widgets_cellules)
        et jamais réordonné en place, donc l'ordre d'itération correspond
        bien à l'ordre visuel. Utilisé par Ctrl+D pour savoir quelle est
        la "prochaine" occurrence à activer, cellule après cellule."""
        return [w.editeur for w in self._cellule_widgets.values() if w.editeur is not None]

    def _zones_composant_layout_pour_variable(self, nom_variable: str) -> Optional[list]:
        """AJOUT (demande explicite utilisateur : "clic droit sur le
        composant layout, proposer aussi les noms des zones, copie dans
        le presse-papier le nom qu'on souhaite utiliser") -- résout
        nom_variable (ex: "NouveauServiceAPI_VideoTemplate", le mot cliqué
        dans l'éditeur) vers le ComposantLayout importé dans le Task
        ouvert dont nom_variable_python(cl.nom) correspond, PUIS exécute
        RÉELLEMENT code_scindement + code_filtre de ce cL sur son
        image_reference (même pipeline exact que la production, cf.
        detecter_toutes_instances_composant_layout_sur_page) pour obtenir
        la liste vraie des zones DYNAMIQUES qu'il nomme -- pas une regex
        sur le texte de code_filtre (fragile : ne couvrirait qu'un seul
        style d'écriture du dict 'zones', cf. discussion), le même code
        qui tourne en production fait foi.

        Retourne None si nom_variable ne correspond à AUCUN ComposantLayout
        importé dans ce Task (pas une entrée de menu à proposer), ou une
        liste (peut-être vide -- ex: image_reference absente, ou aucune
        instance valide détectée dessus) de noms de zones sinon.

        Ne lève JAMAIS d'exception (DetectionScindementError/
        DetectionLayoutError capturées ici) : un clic droit qui échoue à
        détecter des zones (ex: code_filtre en cours d'écriture, cassé
        temporairement) doit simplement ne rien proposer, pas faire
        planter le menu contextuel."""
        if not VISION_DISPONIBLE:
            return None
        if self._task_courant is None:
            return None
        task = self.project.find_task(self._task_courant)
        if task is None:
            return None
        groupes_layout = self.project.composants_layout_importes_task(task)
        cl_trouve = None
        for composants_layout in groupes_layout.values():
            for cl in composants_layout:
                if nom_variable_python(cl.nom) == nom_variable:
                    cl_trouve = cl
                    break
            if cl_trouve is not None:
                break
        if cl_trouve is None:
            return None

        if not cl_trouve.image_reference:
            return []
        chemin_image = get_app_data_dir() / cl_trouve.image_reference
        if not chemin_image.exists():
            return []
        image_bgr = cv2.imread(str(chemin_image))
        if image_bgr is None:
            return []

        try:
            instances = detecter_toutes_instances_composant_layout_sur_page(
                image_bgr, cl_trouve.code_scindement, cl_trouve.code_filtre,
            )
        except (DetectionScindementError, DetectionLayoutError):
            return []

        # Union des zones sur TOUTES les instances trouvées (pas juste la
        # première) -- deux instances du même cL peuvent, selon le
        # contenu réel de chaque carte, ne pas nommer exactement le même
        # sous-ensemble de zones (ex: 'date' absente si le point
        # séparateur '•' n'a pas été détecté sur cette carte précise, cf.
        # scinder_sur_point_separateur) : proposer l'union donne la liste
        # la plus complète possible plutôt que de dépendre arbitrairement
        # de la première instance de la page.
        noms_zones = set()
        for inst in instances:
            noms_zones.update(inst["zones"].keys())
        return sorted(noms_zones)

    def _trouver_declaration(self, nom: str) -> Optional[tuple]:
        """Cherche la déclaration de `nom` (fonction ou variable) à travers
        TOUTES les cellules du notebook, dans l'ordre d'affichage -- réutilise
        TaskScriptEditor._REGEX_DECLARATION_VARIABLE (déjà utilisée par
        l'auto-complétion, cf. _rescanner_variables_connues) plutôt qu'une
        nouvelle regex, pour que "aller à la définition" retrouve exactement
        les mêmes déclarations que celles proposées à la frappe.

        PRIORITÉ AUX 'def' : un nom peut techniquement être à la fois un
        paramètre de fonction ailleurs et une variable assignée quelque
        part -- la définition la plus utile pour "aller à la définition"
        est presque toujours la fonction elle-même quand elle existe (cas
        d'usage principal : clic droit sur un appel de fonction). Les
        affectations simples ne sont considérées que si aucun 'def' de ce
        nom n'a été trouvé dans TOUT le notebook.

        Retourne (cellule_id, position_debut) de la PREMIÈRE déclaration
        trouvée selon cette priorité, ou None si `nom` n'est déclaré nulle
        part. position_debut est un offset de caractère dans le texte de la
        cellule (cf. QTextCursor.setPosition), pointant sur le nom lui-même
        (pas le début de la ligne) pour que le curseur atterrisse exactement
        dessus, comme un "go to definition" d'IDE classique."""
        regex = TaskScriptEditor._REGEX_DECLARATION_VARIABLE
        premiere_variable = None
        for widget, texte in self._cellules_et_textes():   # PATCH (étape 3)
            for match in regex.finditer(texte):
                groupe_egal, groupe_for, groupe_as, groupe_nom_def, groupe_params_def = match.groups()
                if groupe_nom_def and groupe_nom_def == nom:
                    # "def nom(...)" -- le groupe capture juste le nom,
                    # donc match.start(4) pointe déjà exactement dessus.
                    return (widget.cellule_id, match.start(4))
                if premiere_variable is not None:
                    continue
                if groupe_egal:
                    position_dans_groupe = 0
                    for segment in groupe_egal.split("=")[:-1]:
                        offset_segment = match.start(1) + position_dans_groupe
                        position_dans_curseur = 0
                        for n in segment.split(","):
                            if n.strip() == nom:
                                # Position du nom DANS le segment, pas du
                                # début du match entier (qui peut inclure
                                # d'autres cibles avant lui dans "a = b = 5").
                                # n.strip() retire un espace de tête éventuel
                                # ("a, b" -> segments "a" et " b" après split
                                # sur la virgule) -- le décalage doit être
                                # mesuré sur n lui-même, pas sur le segment
                                # entier (qui, lui, n'a pas cet espace de
                                # tête), sinon l'offset retombe toujours sur
                                # le début du segment au lieu du nom visé.
                                offset_nom = (
                                    offset_segment + position_dans_curseur
                                    + (len(n) - len(n.lstrip()))
                                )
                                premiere_variable = (widget.cellule_id, offset_nom)
                            position_dans_curseur += len(n) + 1  # +1 pour la virgule consommée par split
                        position_dans_groupe += len(segment) + 1  # +1 pour le "=" consommé par split
                if groupe_for and premiere_variable is None:
                    for n in groupe_for.split(","):
                        if n.strip() == nom:
                            offset_n = match.start(2) + groupe_for.index(n)
                            offset_nom = offset_n + (len(n) - len(n.lstrip()))
                            premiere_variable = (widget.cellule_id, offset_nom)
                if groupe_as and groupe_as.strip() == nom and premiere_variable is None:
                    premiere_variable = (widget.cellule_id, match.start(3))
        return premiere_variable

    def _position_curseur_courante(self) -> Optional[tuple]:
        """Capture (cellule_id, position) de la cellule qui a actuellement
        le focus dans le notebook, ou None si aucun éditeur du notebook
        n'a le focus -- utilisé pour empiler le point de départ AVANT un
        saut de "Aller à la définition" (cf. _historique_navigation_definition)."""
        for widget in self._cellule_widgets.values():
            if widget.editeur is not None and widget.editeur.hasFocus():
                return (widget.cellule_id, widget.editeur.textCursor().position())
        return None

    def _naviguer_vers_position(self, cellule_id: str, position: int) -> bool:
        """Coeur commun du scroll+flash précis vers une (cellule_id,
        position) -- factorisé hors de aller_a_la_definition pour être
        réutilisé identiquement par revenir_position_precedente (retour
        en arrière, cf. PATCH plus bas) : les deux doivent amener
        l'utilisateur au même endroit avec le même repère visuel, seule
        la façon dont (cellule_id, position) est obtenue diffère
        (recherche de déclaration vs dépilement d'historique).

        cf. docstring historique de aller_a_la_definition pour le détail
        du POURQUOI de ce mécanisme précis (cursorRect + mapTo +
        ensureVisible plutôt que ensureWidgetVisible seul, qui ne visait
        que le widget-cellule entier sans tenir compte de la ligne à
        l'intérieur)."""
        self._assurer_cellule_montee(cellule_id)   # PATCH (étape 3)
        widget = self._cellule_widgets.get(cellule_id)
        if widget is None or widget.editeur is None:
            return False

        curseur = widget.editeur.textCursor()
        curseur.setPosition(position)
        widget.editeur.setTextCursor(curseur)

        widget_est_dans_le_scroll = self._widget_est_descendant(widget, self.notebook_contenu)
        if widget_est_dans_le_scroll:
            rect_curseur = widget.editeur.cursorRect(curseur)
            point_dans_notebook = widget.editeur.mapTo(
                self.notebook_contenu, rect_curseur.topLeft()
            )
            self.notebook_scroll.ensureVisible(
                point_dans_notebook.x(),
                point_dans_notebook.y(),
                0,
                80,
            )

        self._surligner_cellule(widget)
        numero_ligne = curseur.blockNumber() + 1
        widget.editeur.flasher_ligne_navigation(numero_ligne)

        widget.editeur.setFocus()
        return True

    def aller_a_la_definition(self, nom: str) -> bool:
        """Handler de "Aller à la définition" (menu contextuel de
        TaskScriptEditor, cf. son contextMenuEvent) : localise `nom` via
        _trouver_declaration puis délègue le scroll précis + flash bleu à
        _naviguer_vers_position. Empile D'ABORD la position de départ
        dans _historique_navigation_definition (cf. PATCH : "revenir a la
        position") -- AVANT de sauter, pour que le retour arrière
        (Alt+Gauche, revenir_position_precedente) sache où revenir.
        Retourne False sans aucun effet (et sans empiler quoi que ce
        soit) si `nom` n'est déclaré nulle part."""
        trouvaille = self._trouver_declaration(nom)
        if trouvaille is None:
            return False
        cellule_id, position = trouvaille

        depart = self._position_curseur_courante()
        if depart is not None:
            self._historique_navigation_definition.append(depart)

        return self._naviguer_vers_position(cellule_id, position)

    def revenir_position_precedente(self) -> bool:
        """PATCH (demande explicite utilisateur : "supposons maintenant
        qu on veut revenir a la position, comment on peut faire") --
        dépile la dernière position enregistrée par aller_a_la_definition
        et y retourne (même scroll précis + flash bleu, cf.
        _naviguer_vers_position). Ne réempile PAS la position quittée ici
        : Alt+Gauche est un retour en arrière façon pile d'historique
        (comme un navigateur), pas un aller-retour permanent entre deux
        points -- une deuxième pression d'Alt+Gauche continue de remonter
        l'historique plus loin, elle ne rebondit pas entre A et B.

        Une entrée dont la cellule a été supprimée depuis (widget
        introuvable) est silencieusement ignorée, l'entrée suivante de la
        pile est alors tentée -- jusqu'à épuisement de la pile. Retourne
        False si la pile est vide ou entièrement invalide."""
        while self._historique_navigation_definition:
            cellule_id, position = self._historique_navigation_definition.pop()
            widget = self._cellule_widgets.get(cellule_id)
            if widget is None or widget.editeur is None:
                continue
            return self._naviguer_vers_position(cellule_id, position)
        return False

    def _trouver_toutes_occurrences(self, texte: str) -> dict:
        """Cherche `texte` (recherche EXACTE, sensible à la casse -- cf.
        décision cohérente avec le reste de l'éditeur qui ne fait pas de
        normalisation implicite) dans le texte de CHAQUE cellule du
        notebook. Retourne {cellule_id: [(debut, fin), ...]} -- cellules
        sans aucune occurrence absentes du dict (pas d'entrée vide)."""
        resultat = {}
        if not texte:
            return resultat
        for widget, contenu in self._cellules_et_textes():   # PATCH (étape 3)
            positions = []
            depart = 0
            while True:
                idx = contenu.find(texte, depart)
                if idx == -1:
                    break
                positions.append((idx, idx + len(texte)))
                depart = idx + len(texte)
            if positions:
                resultat[widget.cellule_id] = positions
        return resultat

    def lancer_recherche_toutes_occurrences(self, texte: str, cellule_origine_id: str):
        """Ctrl+F avec une sélection non vide (cf. TaskScriptEditor.
        keyPressEvent) : trouve et surligne TOUTES les occurrences de
        `texte` dans TOUTES les cellules du notebook (mode "recherche" --
        simple surlignage, pas encore d'édition synchronisée tant que
        Ctrl+D n'a pas été pressé, cf. mode "edition" plus bas).

        Réutilise le même état que Ctrl+D (self._multi_curseur_etat) :
        Ctrl+D pressé juste après un Ctrl+F active alors l'édition
        synchronisée sur la PREMIÈRE occurrence trouvée (comportement
        cohérent avec VSCode : Ctrl+Shift+L / "select all occurrences"
        immédiatement éditable)."""
        occurrences = self._trouver_toutes_occurrences(texte)
        if not occurrences:
            self._multi_curseur_etat = None
            self._rafraichir_surlignage_multi_curseur()
            return

        self._multi_curseur_etat = {
            "texte": texte,
            "occurrences": occurrences,
            "actives": {cid: list(pos) for cid, pos in occurrences.items()},
            "mode": "recherche",
        }
        self._rafraichir_surlignage_multi_curseur()

    def ajouter_occurrence_suivante_ctrl_d(self, texte: str, cellule_origine_id: str, position_curseur: int):
        """Ctrl+D (cf. TaskScriptEditor.keyPressEvent) : ajoute la
        PROCHAINE occurrence de `texte` à l'édition multi-curseur, une à
        la fois (comportement standard VSCode), en parcourant les
        cellules dans l'ordre du notebook à partir de la position du
        curseur courant. Si aucun multi-curseur n'est encore actif pour ce
        texte, initialise l'état à partir de la sélection/du mot sous le
        curseur (première occurrence = celle d'où part la sélection
        elle-même, déjà "active" sans qu'il soit besoin de la re-chercher).

        Si Ctrl+F a déjà tout surligné (mode "recherche"), Ctrl+D bascule
        directement en mode "edition" sur l'ensemble déjà trouvé -- pas
        besoin de les ajouter une par une puisqu'elles sont déjà toutes
        identifiées."""
        etat = self._multi_curseur_etat
        if etat is not None and etat.get("texte") == texte and etat.get("mode") == "recherche":
            # Ctrl+F puis Ctrl+D : active directement l'édition sur tout
            # ce qui a déjà été trouvé, plutôt que de ré-ajouter occurrence
            # par occurrence.
            etat["mode"] = "edition"
            self._rafraichir_surlignage_multi_curseur()
            return

        if etat is None or etat.get("texte") != texte:
            # Nouvelle session multi-curseur : la sélection d'origine
            # (celle sous le curseur dans la cellule où l'utilisateur a
            # pressé Ctrl+D) compte comme première occurrence active.
            toutes = self._trouver_toutes_occurrences(texte)
            occurrence_origine = None
            for debut, fin in toutes.get(cellule_origine_id, []):
                if debut <= position_curseur <= fin:
                    occurrence_origine = (debut, fin)
                    break
            self._multi_curseur_etat = {
                "texte": texte,
                "occurrences": toutes,
                "actives": {},
                "mode": "edition",
            }
            if occurrence_origine is not None:
                self._multi_curseur_etat["actives"][cellule_origine_id] = [occurrence_origine]
            self._rafraichir_surlignage_multi_curseur()
            return

        # Session déjà en cours pour ce même texte : ajoute la PROCHAINE
        # occurrence non encore active, en parcourant les cellules dans
        # l'ordre du notebook (et, dans une cellule donnée, les
        # occurrences par position croissante) à partir de la cellule
        # d'origine -- reproduit l'ordre "naturel" de VSCode.
        ordre_cellules = self._ids_cellules_ordre()   # PATCH (étape 3)
        if cellule_origine_id in ordre_cellules:
            idx_origine = ordre_cellules.index(cellule_origine_id)
            ordre_cellules = ordre_cellules[idx_origine:] + ordre_cellules[:idx_origine]

        for cid in ordre_cellules:
            toutes_positions = etat["occurrences"].get(cid, [])
            deja_actives = etat["actives"].get(cid, [])
            for debut, fin in sorted(toutes_positions):
                if (debut, fin) not in deja_actives:
                    etat["actives"].setdefault(cid, []).append((debut, fin))
                    self._rafraichir_surlignage_multi_curseur()
                    return
        # Plus aucune occurrence à ajouter (toutes déjà actives) : rien à
        # faire, silencieux -- cohérent avec VSCode qui ne fait rien de
        # plus une fois toutes les occurrences sélectionnées.

    def annuler_multi_curseur(self):
        """Échap (cf. TaskScriptEditor.keyPressEvent) : sort du mode
        multi-curseur/recherche-globale et retire tout surlignage."""
        if self._multi_curseur_etat is None:
            return
        self._multi_curseur_etat = None
        self._rafraichir_surlignage_multi_curseur()

    def _rafraichir_surlignage_multi_curseur(self):
        """Réapplique le surlignage (ExtraSelection) sur TOUS les éditeurs
        du notebook d'après self._multi_curseur_etat -- à appeler après
        toute modification de cet état. Une cellule sans occurrence reçoit
        une liste vide (efface un éventuel surlignage résiduel)."""
        etat = self._multi_curseur_etat
        for editeur in self._tous_les_editeurs_du_task():
            if etat is None:
                editeur._appliquer_surlignage_occurrences([], [])
                continue
            occurrences = etat["occurrences"].get(editeur.cellule_id_associee(), [])
            actives = etat["actives"].get(editeur.cellule_id_associee(), [])
            editeur._appliquer_surlignage_occurrences(occurrences, actives)

    def propager_frappe_multi_curseur(
        self,
        cellule_origine_id: str,
        position_origine_avant: int,
        texte_insere: str,
        longueur_remplacee: int,
    ):
        """Répercute une frappe/suppression faite dans l'éditeur qui a le
        focus (cellule_origine_id) sur TOUTES les autres occurrences
        actives, dans TOUTES les cellules concernées -- coeur de la
        simulation "multi-curseur" (cf. docstring self._multi_curseur_etat).

        Appelée par TaskScriptEditor.keyPressEvent avec une opération déjà
        DÉCODÉE et sans ambiguïté (pas un diff deviné après coup) :
        - position_origine_avant : position du début de la sélection (ou
          du curseur) dans la cellule d'origine, juste AVANT que Qt
          n'applique la frappe -- sert uniquement à identifier SANS
          AMBIGUÏTÉ laquelle des occurrences actives de cette cellule vient
          d'être éditée par Qt (donc à NE PAS rejouer dessus), les autres
          occurrences actives de la même cellule devant, elles, recevoir
          l'opération normalement.
        - texte_insere : ce que la touche a inséré ("" pour Backspace/
          Delete sans sélection, le caractère tapé sinon, ou le texte
          collé)
        - longueur_remplacee : nombre de caractères à retirer AVANT
          d'insérer texte_insere, comptés depuis la position de chaque
          occurrence active (0 pour une simple frappe de caractère avec
          sélection vide, len(sélection) si une sélection était active,
          1 pour Backspace/Delete)

        Dans chaque cellule, l'opération est rejouée occurrence par
        occurrence en partant de la FIN du texte vers le début, pour que
        le décalage introduit par une édition ne fausse pas la position
        des occurrences suivantes de la même cellule (cf.
        TaskScriptEditor._appliquer_operation_a_position)."""
        etat = self._multi_curseur_etat
        if etat is None or etat.get("mode") != "edition":
            return
        if cellule_origine_id not in etat["actives"]:
            return

        editeurs_par_id = self._editeurs_par_id()   # PATCH (étape 3)

        for cid, occurrences in etat["actives"].items():
            editeur = editeurs_par_id.get(cid)
            if editeur is None:
                continue
            if cid == cellule_origine_id:
                # Déjà appliquée par Qt sur l'occurrence qui contenait
                # position_origine_avant -- seules les AUTRES occurrences
                # actives de cette même cellule (s'il y en a plusieurs)
                # doivent encore recevoir l'opération.
                cibles = sorted(
                    (
                        (d, f) for (d, f) in occurrences
                        if not (d <= position_origine_avant <= f)
                    ),
                    key=lambda p: p[0],
                    reverse=True,
                )
            else:
                cibles = sorted(occurrences, key=lambda p: p[0], reverse=True)

            for debut, fin in cibles:
                editeur._appliquer_operation_a_position(debut, longueur_remplacee, texte_insere)
            self._persister_si_hors_cadre(cid)   # PATCH (étape 3)

        # Le texte recherché lui-même a changé : ré-indexe occurrences et
        # actives en cherchant à nouveau le nouveau texte dans chaque
        # cellule plutôt que de corriger les anciennes positions à la main
        # (plus fiable dès qu'une cellule a plusieurs occurrences actives).
        editeur_origine = editeurs_par_id.get(cellule_origine_id)
        nouveau_texte = etat.get("texte", "")
        if editeur_origine is not None:
            occurrences_origine = etat["actives"].get(cellule_origine_id, [])
            occurrence_contenant = next(
                ((d, f) for d, f in occurrences_origine if d <= position_origine_avant <= f),
                None,
            )
            # Repli défensif : si aucune occurrence active ne contient
            # exactement position_origine_avant (ne devrait normalement
            # pas arriver, cf. appelant), prend la plus proche plutôt que
            # de planter -- le pire cas est une resynchronisation légèrement
            # imprécise, jamais une exception qui interromprait la frappe.
            if occurrence_contenant is None and occurrences_origine:
                occurrence_contenant = min(
                    occurrences_origine, key=lambda p: abs(p[0] - position_origine_avant)
                )
            if occurrence_contenant is not None:
                debut_o, fin_o = occurrence_contenant
                fin_o_maj = debut_o + (fin_o - debut_o) - longueur_remplacee + len(texte_insere)
                nouveau_texte = editeur_origine.toPlainText()[debut_o:max(debut_o, fin_o_maj)]
        self._resynchroniser_occurrences_apres_frappe(nouveau_texte)

    def _resynchroniser_occurrences_apres_frappe(self, nouveau_texte: str):
        """Après une frappe multi-curseur, le texte recherché lui-même a
        changé -- on ré-indexe donc occurrences/actives de
        self._multi_curseur_etat en cherchant à nouveau nouveau_texte dans
        chaque cellule, plutôt que d'essayer de corriger les anciennes
        positions à la main (source d'erreurs dès que plusieurs occurrences
        actives partagent la même cellule)."""
        etat = self._multi_curseur_etat
        if etat is None:
            return
        etat["texte"] = nouveau_texte
        nouvelles_occurrences = self._trouver_toutes_occurrences(nouveau_texte) if nouveau_texte else {}
        # Ne garde comme "actives" QUE les occurrences qui existaient déjà
        # comme actives, réalignées sur les nouvelles positions -- on
        # suppose une correspondance par ORDRE (n-ième occurrence active
        # d'une cellule -> n-ième occurrence trouvée dans cette cellule
        # après frappe), hypothèse valide tant que la frappe ne fait pas
        # apparaître/disparaître le texte ailleurs dans la cellule de
        # façon non liée aux occurrences actives.
        nouvelles_actives = {}
        for cid, actives in etat["actives"].items():
            candidates = nouvelles_occurrences.get(cid, [])
            nouvelles_actives[cid] = candidates[: len(actives)] if candidates else []
        etat["occurrences"] = nouvelles_occurrences
        etat["actives"] = {cid: pos for cid, pos in nouvelles_actives.items() if pos}
        if not etat["actives"] or not nouveau_texte:
            self._multi_curseur_etat = None
        self._rafraichir_surlignage_multi_curseur()

    def _surligner_cellule(self, widget: "TaskCelluleWidget"):
        """Bref flash visuel (bordure jaune, cf. règle QSS
        #TaskCelluleWidget[surlignee="true"]) pour indiquer clairement la
        cellule visée par un clic dans la colonne d'accès rapide, une fois
        le slide terminé (ou immédiatement pour la row 0 sticky, déjà
        visible en permanence -- cf. _sur_clic_acces_rapide). Retiré après
        un court délai par un QTimer.singleShot -- pas besoin de garder
        une référence au timer, le widget cible suffit comme contexte de
        rappel (capturé par la closure)."""
        widget.setProperty("surlignee", True)
        widget.style().unpolish(widget)
        widget.style().polish(widget)

        def _retirer_surlignage():
            # Défense simple si la cellule a été supprimée entre-temps
            # (deleteLater déjà passé) -- setProperty sur un objet Qt
            # C++ détruit lèverait une RuntimeError, donc on vérifie
            # d'abord via sip/shiboken implicitement par un try/except
            # plutôt que d'ajouter une dépendance d'introspection en plus.
            try:
                widget.setProperty("surlignee", False)
                widget.style().unpolish(widget)
                widget.style().polish(widget)
            except RuntimeError:
                pass

        QTimer.singleShot(900, _retirer_surlignage)

    # ------------------------------------------------------------------
    # AJOUT (fusion de l'ancien écran "Notebook Distant" séparé dans
    # TaskConfig, décision explicite utilisateur : "cest miex de juste
    # etendre le mode du task actuel, en mettant le mode reseau") --
    # bascule Local/Réseau, profil cloud, sAutoniax, Initialiser, statut,
    # rendu -- tout ce qui est propre au mode task.mode_execution == "reseau".
    # ------------------------------------------------------------------

    def definir_client_reseau_t(self, client_serveur_t: "ClientServeurT"):
        """Injection tardive (cf. docstring de self._client_serveur_t dans
        __init__ -- MainWindow construit ClientServeurT APRÈS ce Screen).
        Appelé une seule fois par MainWindow, juste après la construction
        du client -- les branchements de signaux entrants (executants_detail_
        change, capture_recue, *_notebook_distant_*) restent câblés côté
        MainWindow (même patron que pour les autres écrans réseau), CE
        Screen n'a besoin que d'une référence pour ÉMETTRE des commandes
        (executer_notebook_distant, initialiser_notebook_distant,
        demander_liste_stockage)."""
        self._client_serveur_t = client_serveur_t

    def definir_executants_reseau_connus(self, executants: list):
        """Branché par MainWindow sur ClientServeurT.executants_detail_change
        (même source que InstancesConnecteesScreen/ProjetsDistribuesScreen)
        -- rafraîchit le combo sAutoniax du Task actuellement ouvert s'il
        est en mode réseau, en préservant la sélection courante quand elle
        reste valide."""
        # PATCH : mutation EN PLACE (.clear()+.update(), jamais de
        # réassignation `self._noms_executants_reseau = {...}`) -- le
        # panneau composants garde une simple RÉFÉRENCE vers CE dict
        # (cf. definir_contexte_reseau/_noms_executants_reseau_ref) ;
        # réassigner créerait un nouveau dict et laisserait sa référence
        # pointer vers l'ancien, à jamais périmé dès ce premier appel.
        ids_avant_reconnexion = set(self._noms_executants_reseau)      # PATCH H
        self._noms_executants_reseau.clear()
        self._noms_executants_reseau.update(
            {e.get("id", ""): e.get("nom") or e.get("id", "") for e in executants if e.get("id")}
        )
        # PATCH (réinitialisation demandée : "quand le sAutoniax se
        # déconnecte, cette liaison doit se réinitialiser") -- purge de
        # _profils_reseau_actifs toute entrée dont l'id_executant n'est
        # plus dans la liste fraîchement reçue. Sans ça, _libelle_liaison
        # continuerait d'afficher un ancien nom de profil (ex.
        # "camoufox_claude") pour un id_executant qui ne désigne plus
        # rien -- trompeur si un AUTRE sAutoniax récupère un jour le même
        # id (peu probable mais pas garanti impossible) et surtout
        # incohérent avec le statut "non lié" qu'affiche déjà ailleurs
        # ce même id_executant disparu (cf. _sur_instances_list_change /
        # liaisons_perdues, même raisonnement en mode local).
        ids_executants_actifs = set(self._noms_executants_reseau)
        cles_perimees = [
            cle for cle in self._profils_reseau_actifs if cle[1] not in ids_executants_actifs
        ]
        for cle in cles_perimees:
            del self._profils_reseau_actifs[cle]
        # AJOUT (spec B.1, revue élargie -- déconnexion sAutoniax en cours
        # de séquence clone, cf. docstring de _invalider_executions_clone_
        # disparues) : même raisonnement EXACT que la purge de
        # _profils_reseau_actifs juste au-dessus, appliqué cette fois à
        # _executions_clone (séquences clone potentiellement en vol).
        self._invalider_executions_clone_disparues(ids_executants_actifs)
        task = self._task_courant_obj()
        if (task is not None and task.mode_execution == "reseau" and self._executions_clone
                and (ids_executants_actifs - ids_avant_reconnexion)):      # PATCH H : un sAutoniax (re)vient
            self._planifier_rafraichissement_clone_apres_reconnexion()
        if task is not None and task.mode_execution == "reseau":
            self._rafraichir_apres_changement_executant_actif(task)
        # Le panneau composants doit voir la table à jour (contexte +
        # purge ci-dessus) pour que son label de liaison (cf.
        # _libelle_liaison) ne reste jamais affiché sur un profil/
        # exécutant obsolète -- rafraîchi seulement si un Task réseau est
        # actuellement ouvert (sinon rien à mettre à jour à l'écran).
        self.panneau_composants.definir_contexte_reseau(self._noms_executants_reseau, self._profils_reseau_actifs)
        if task is not None and task.mode_execution == "reseau" and cles_perimees:
            self.panneau_composants.rafraichir(task)

    def _detacher_moteur_courant_profil(self, profil_etat: "CloneProfilEtat"):
        """PATCH (mode local dans le panneau clone -- cf. SPEC_mode_clone_
        local.md, section 3.8) : détache proprement profil_etat.moteur_
        courant, quel que soit son type (MoteurExecutionCelluleReseau,
        réseau, OU MoteurExecutionCellule, local) -- factorise les 4 sites
        qui répétaient auparavant `self._sessions_execution_reseau_clone.
        pop(profil_etat.moteur_courant._session_id, None)` puis `.arreter()`
        puis `= None`, TOUS écrits en supposant implicitement un moteur
        RÉSEAU.

        BUGFIX : MoteurExecutionCellule (mode local, cf. sa classe) n'a
        PAS d'attribut _session_id (celui-ci n'existe que sur
        MoteurExecutionCelluleReseau, cf. son __init__) -- accéder à
        `.moteur_courant._session_id` sur un moteur LOCAL levait donc un
        AttributeError garanti, à chaque tentative d'arrêt/kill/purge
        d'un profil clone local en cours d'exécution. `getattr(...,
        None)` : accède à l'attribut seulement s'il existe, sans jamais
        planter sur le type local -- _sessions_execution_reseau_clone
        (registre PUREMENT réseau, cf. sa docstring) n'a de toute façon
        aucune entrée à purger pour un moteur local, .pop(None, None)
        étant alors un no-op inoffensif.

        arreter() est une méthode du même nom sur les DEUX classes (cf.
        docstring de MoteurExecutionCelluleReseau : "contrat public
        IDENTIQUE") -- appelée ici indifféremment, sans avoir besoin de
        savoir de quel type il s'agit."""
        moteur = profil_etat.moteur_courant
        if moteur is None:
            return
        session_id = getattr(moteur, "_session_id", None)
        if session_id is not None:
            self._sessions_execution_reseau_clone.pop(session_id, None)
        # PATCH (retour utilisateur : "quand j'appuie sur arrêt, les logs
        # qui devaient s'afficher vers la fin ne s'affichent pas") -- la
        # valeur de retour de arreter() (sortie déjà imprimée) était
        # jetée ici : la cellule du profil restait sans aucune sortie.
        # On la récupère et on l'affiche sur la cellule interrompue.
        try:
            sortie_partielle = moteur.arreter() or ""
        except Exception:
            log_cellule.exception("[arret-profil] moteur.arreter() a échoué")
            sortie_partielle = ""
        profil_etat.moteur_courant = None
        try:
            self._afficher_sortie_partielle_profil(profil_etat, moteur, sortie_partielle)
        except Exception:
            log_cellule.exception("[arret-profil] affichage de la sortie partielle impossible")

    def _afficher_sortie_partielle_profil(self, profil_etat, moteur, sortie_partielle: str):
        """Stocke (et affiche si ce profil est celui affiché) la sortie
        reçue par la cellule d'un profil clone juste avant son arrêt,
        marquée « interrompu ». Ne touche jamais la TaskCellule réelle."""
        cellule_id = getattr(moteur, "cellule_id", None) or profil_etat.cellule_courante_id
        task = getattr(moteur, "task", None) or self._task_courant_obj()
        if cellule_id is None or task is None:
            return
        cellule_reelle = self._trouver_cellule_par_id(task, cellule_id)
        if cellule_reelle is None:
            return
        derniere_image_b64 = None
        for entree in getattr(moteur, "_sortie_accumulee", None) or []:
            if isinstance(entree, tuple) and entree and entree[0] == "image":
                derniere_image_b64 = entree[1]
        if not sortie_partielle and derniere_image_b64 is None:
            return  # rien reçu : on ne remplace pas un résultat plus ancien
        cellule_temp = TaskCellule(
            id=cellule_id,
            titre=getattr(cellule_reelle, "titre", ""),
            description=getattr(cellule_reelle, "description", ""),
            code=cellule_reelle.code,
            sortie=sortie_partielle,
            statut="interrompu",
            numero_execution=len(profil_etat.cellules_resultats) + 1,
            derniere_image_b64=derniere_image_b64,
        )
        profil_etat.cellules_resultats[cellule_id] = cellule_temp
        etat = self._executions_clone.get(task.id)
        profil_affiche = etat is not None and etat.profils.get(etat.profil_actif) is profil_etat
        if profil_affiche and self._task_courant == task.id:
            widget = self._cellule_widgets.get(cellule_id)
            if widget is not None:
                widget.indiquer_interrompu(cellule_temp)
                self._reafficher_image_si_presente(widget, moteur)

    def _invalider_executions_clone_disparues(self, ids_executants_actifs: set):
        """AJOUT (spec B.1, revue élargie -- point explicitement laissé
        "non traité" par le correctif initial : "déconnexion réseau du
        sAutoniax en cours de séquence... aucun mécanisme de callback de
        déconnexion ne redescend actuellement jusqu'à un profil_etat
        clone actif").

        CAUSE DU TROU RÉSIDUEL : MoteurExecutionCelluleReseau.arreter()
        documente déjà qu'AUCUN protocole d'annulation n'existe côté
        réseau -- si le sAutoniax qui exécute un profil clone perd sa
        connexion au serveurT (crash, redémarrage, coupure), le résultat
        de la cellule en vol (callback_termine) n'arrive tout simplement
        JAMAIS : profil_etat.statut reste figé sur "en_attente"/"en_cours"
        POUR TOUJOURS, badge et panneau clone bloqués indéfiniment --
        exactement le symptôme du bug B.1 d'origine, revenu par une porte
        que le correctif ciblé ne couvrait pas (lui ne traitait que
        l'oubli d'appel de rafraîchissement, pas l'absence de tout
        résultat).

        DÉTECTION : appelée à CHAQUE executants_detail_change (même
        source que la purge de _profils_reseau_actifs juste au-dessus,
        déjà présente) -- ids_executants_actifs est l'ensemble des
        id_executant actuellement enregistrés au serveurT. Un sAutoniax
        absent de cet ensemble est, par construction du serveurT (cf.
        serveur.py, retirer_connexion), FORMELLEMENT déconnecté : plus
        aucun message ne pourra jamais plus être relayé pour lui, donc
        toute cellule en vol sur ce sAutoniax est perdue du point de vue
        de CE pilote, qu'elle continue ou non de tourner quelque part
        (aucun moyen de le savoir avec le protocole actuel, cf. décision
        explicite -- ne pas tenter de relancer/reprendre automatiquement).

        PORTÉE : parcourt TOUS les Tasks de self._executions_clone, PAS
        seulement le Task actuellement affiché -- contrairement à
        _invalider_liaisons_instances_disparues (qui ne traite que le
        Task courant, cf. sa docstring), une séquence clone continue
        d'être routée par session_id même quand son Task n'est plus à
        l'écran (cf. sur_resultat_execution_reseau_recu, qui retrouve
        etat via moteur_clone.task.id, indépendamment de self._task_
        courant) -- un lot clone lancé sur un Task fermé entre-temps ne
        doit pas rester bloqué indéfiniment faute d'avoir jamais revu ce
        Task à l'écran.

        SUPPRESSION DIRECTE (SPEC_lot_corrections_2026-09.md section 2,
        remplace l'ancien statut "deconnecte") : décision explicite
        utilisateur -- plus d'état intermédiaire "déconnecté" affiché
        indéfiniment, ni de bouton dédié "revérifier la connexion"
        (bouton_rafraichir_connexion, signal demande_rafraichir_
        connexion_profil et son handler _sur_demande_rafraichir_
        connexion_profil sont supprimés entièrement, cf. leurs anciens
        emplacements). La disparition d'un profil clone se fait
        désormais AU PROCHAIN RAFRAÎCHISSEMENT (pas d'instantanéité en
        dehors de ce cycle) : ici, on retire directement l'entrée de
        etat.profils, y compris si elle est encore "en_attente"/
        "en_cours" -- MÊME logique que la purge appliquée dans
        _reconstruire_agregat_profils_clone (protection contre la purge
        des profils en vol retirée là-bas aussi, cf. sa docstring), y
        compris la gestion de profil_actif_disparu répliquée ici pour ce
        même cas. Le moteur_courant (s'il existe encore) est détaché
        comme un arrêt normal (cf. arreter(), même sémantique documentée :
        détachement UI seulement) et l'entrée de _sessions_execution_
        reseau_clone nettoyée, pour ne pas laisser grossir ce registre
        pour une session dont le résultat n'arrivera de toute façon
        jamais plus (le sAutoniax ne peut plus parler à ce serveurT).
        Décision explicite utilisateur : PAS de relance ni de reprise
        automatique -- l'utilisateur relance lui-même manuellement via le
        bouton ▶ existant une fois qu'il constate que le sAutoniax est
        bel et bien revenu (il devra alors relancer le profil comme un
        profil neuf, puisque son entrée précédente a disparu)."""
        # BUGFIX (cf. profils_touches ci-dessous) -- oublie aussi les réponses
        # brutes en cache d'un sAutoniax disparu, sinon un prochain
        # _reconstruire_agregat_profils_clone les réaffiche.
        for _id_perime in [i for i in self._profils_bruts_par_sautoniax_clone if i not in ids_executants_actifs]:
            del self._profils_bruts_par_sautoniax_clone[_id_perime]
        for _cle_perimee in [
            c for c, i in self._id_executant_par_profil_clone.items()
            if i and i != ID_EXECUTANT_LOCAL and i not in ids_executants_actifs
        ]:
            del self._id_executant_par_profil_clone[_cle_perimee]
        for task_id, etat in self._executions_clone.items():
            # REFONTE MULTI-SAUTONIAX -- filtre par sAutoniax du PROFIL, pas
            # du lot : un lot peut désormais mélanger des profils venant de
            # plusieurs sAutoniax, donc seuls les profils dont LE sAutoniax
            # d'origine a disparu doivent être retirés, pas tout le lot dès
            # qu'un seul de ses sAutoniax tombe (cf. docstring de
            # CloneProfilEtat.id_executant_sautoniax).
            # BUGFIX (mode local dans le panneau clone -- cf. SPEC_mode_
            # clone_local.md) : ids_executants_actifs ne contient QUE des
            # id_executant sAutoniax RÉSEAU (cf. definir_executants_
            # reseau_connus, seul appelant) -- ID_EXECUTANT_LOCAL n'y
            # figure JAMAIS. Sans l'exclusion explicite ci-dessous, un
            # profil clone LOCAL "en_attente"/"en_cours" matchait à tort
            # "id_executant_sautoniax not in ids_executants_actifs" à
            # chaque déconnexion/reconnexion d'un sAutoniax QUELCONQUE
            # ailleurs sur le réseau (executants_detail_change, sans
            # aucun rapport avec ce Task local) -- purge intempestive
            # d'une séquence locale en cours, avec arrêt forcé du moteur.
            # BUGFIX (retour utilisateur : "quand je déconnecte un sautoniax,
            # ses profils continuent d'apparaître dans le panneau clone, et
            # Rafraîchir ne les retire pas") -- DEUX causes :
            # 1) le filtre d'origine ne visait que "en_attente"/"en_cours" :
            #    un profil déjà terminé/en succès/en erreur d'un sAutoniax
            #    disparu restait affiché indéfiniment ;
            # 2) _reconstruire_agregat_profils_clone ne purge un profil que si
            #    SON sAutoniax a répondu dans le cycle -- or un sAutoniax
            #    déconnecté n'est plus interrogé, donc ne répond jamais, donc
            #    ses profils n'étaient JAMAIS purgés, même par Rafraîchir.
            # Désormais : TOUT profil réseau dont le sAutoniax n'est plus
            # enregistré est retiré immédiatement, quel que soit son statut.
            # L'id est lu dans la clé composite (id_executant::nom_profil),
            # avec repli sur id_executant_sautoniax.
            profils_touches = []
            for _cle, _pe in etat.profils.items():
                _id_exec = _id_executant_depuis_cle_profil_clone(_cle) or _pe.id_executant_sautoniax
                if (
                    _id_exec
                    and _id_exec != ID_EXECUTANT_LOCAL
                    and _id_exec not in ids_executants_actifs
                ):
                    profils_touches.append(_pe)
            if not profils_touches:
                continue
            profil_actif_disparu = False
            for profil_etat in profils_touches:
                self._detacher_moteur_courant_profil(profil_etat)
                log.info(
                    f"TaskConfigScreen : profil clone « {profil_etat.nom_profil} » (Task {task_id}) "
                    f"retiré du panneau -- sAutoniax « {profil_etat.id_executant_sautoniax} » "
                    f"disparu de executants_detail_change en cours de séquence."
                )
                for cle_profil, pe in list(etat.profils.items()):
                    if pe is profil_etat:
                        if cle_profil == etat.profil_actif:
                            profil_actif_disparu = True
                        del etat.profils[cle_profil]
                        break
            if profil_actif_disparu:
                etat.profil_actif = None
                task_obj_actif = self._task_courant_obj()
                if task_obj_actif is not None and task_obj_actif.id == task_id:
                    for nom_service in task_obj_actif.services_api_importes:
                        task_obj_actif.services_api_importes[nom_service] = ""
                    self.project.save()
                    self.panneau_composants.rafraichir(task_obj_actif)
                    self._rafraichir_composants_connus_editeur(task_obj_actif)
                    self._rafraichir_variables_globales_editeur(task_obj_actif)
                    carte = self._task_cartes.get(task_id)
                    if carte is not None:
                        carte.rafraichir(task_obj_actif)
                    # AJOUT (affichage WORKSPACE) : le profil actif vient
                    # de disparaître SANS passer par _definir_profil_actif
                    # -- sans cet appel, l'éditeur de cellule_variables
                    # continuerait d'afficher l'attribution d'un profil
                    # qui n'existe plus, et l'utilisateur pourrait la
                    # croire encore active.
                    self._rafraichir_affichage_workspace_cellule_variables(task_obj_actif, etat)
                    self._notify_status(
                        "Le profil actif n'est plus lancé sur son sAutoniax -- désélectionné "
                        "automatiquement. Sélectionnez un profil dans la liste pour continuer.",
                        error=True,
                    )
            etat.sequence_en_cours = any(
                p.statut in ("en_attente", "en_cours") for p in etat.profils.values() if p.coche
            )
            # Rafraîchissement visuel seulement si ce Task précis est
            # actuellement affiché -- même garde que _rafraichir_panneau_
            # clone_si_ouvert (task_courant), appelée directement plutôt
            # que via _rafraichir_apres_transition_clone (pensée pour un
            # seul nom_profil à la fois, cf. sa docstring -- inadaptée
            # ici où plusieurs profils peuvent basculer d'un coup). Le
            # badge global, lui, N'EST PAS filtré par task_id : _rafraichir_
            # bouton_global relit self._task_courant_obj() en interne et
            # n'a d'effet visible que si CE Task est déjà affiché, donc
            # l'appeler inconditionnellement ici reste sûr (même logique
            # déjà actée pour l'appel équivalent dans _sur_demande_
            # arreter_clones).
            #
            # BUGFIX ROBUSTESSE (même cause racine que _rafraichir_
            # panneau_clone_si_ouvert, cf. sa docstring pour le détail
            # complet) -- condition self.panneau_clone.isVisible() ICI
            # RETIRÉE : elle empêchait etat.profils fraîchement marqué
            # "deconnecte" de jamais atteindre table_profils tant que le
            # panneau restait caché au moment précis de la déconnexion
            # sAutoniax, laissant badge/chrono figés sur un état obsolète
            # jusqu'à une correction "tout d'un coup" bien plus tard, sans
            # lien avec une action de l'utilisateur. _rafraichir_panneau_
            # clone_si_ouvert elle-même ne dépend plus de la visibilité
            # (cf. sa docstring) -- cet appel externe ne doit donc plus
            # la revérifier non plus, sous peine de réintroduire le même
            # trou par un chemin différent.
            task_obj = self._task_courant_obj()
            if task_obj is not None and task_obj.id == task_id:
                self._rafraichir_panneau_clone_si_ouvert(task_obj, etat)
            # BUGFIX (désynchronisation badge/résultat rapportée) : cet
            # appel était À TORT à l'intérieur du `if` ci-dessus, donc
            # conditionné par self.panneau_clone.isVisible() -- alors que
            # le commentaire juste au-dessus documentait déjà l'intention
            # inverse ("N'EST PAS filtré par task_id... l'appeler
            # inconditionnellement ici reste sûr"). badge_statut_notebook
            # (toolbar) et panneau_clone (panneau séparé, fermable
            # indépendamment) sont deux widgets distincts : si le panneau
            # clone est fermé au moment de la déconnexion, l'ancien code
            # sautait _rafraichir_bouton_global() et le badge restait
            # figé sur "en cours" alors que profil_etat.statut valait déjà
            # "deconnecte" -- exactement le symptôme rapporté. Sorti du
            # `if` : _rafraichir_bouton_global() relit self._task_courant_
            # obj() en interne et n'a d'effet visible que si CE Task est
            # déjà affiché, donc l'appeler inconditionnellement ici reste
            # sûr (même logique déjà actée pour l'appel équivalent dans
            # _sur_demande_arreter_clones).
            self._rafraichir_bouton_global()

    def _reprise_clone_presente(self) -> bool:
        """PATCH H : au moins un profil clone restauré « en cours » après coupure (cf. CloneProfilEtat.reprise_apres_coupure)."""
        return any(pe.reprise_apres_coupure for e in self._executions_clone.values() for pe in e.profils.values())

    def _assurer_sondage_reprise_clone(self):
        """PATCH H : tant qu'un profil restauré est « en cours », redemande toutes les 5 s la liste des profils aux sAutoniax pour
        savoir quand sa cellule se termine (le moteur du pilote étant détaché, aucun résultat n'arrivera autrement)."""
        m = getattr(self, "_minuteur_reprise_clone", None)
        if m is None:
            m = QTimer(self)
            m.setInterval(5000)
            m.timeout.connect(self._tic_reprise_clone)
            self._minuteur_reprise_clone = m
        if self._reprise_clone_presente():
            if not m.isActive():
                m.start()
        else:
            m.stop()

    def _tic_reprise_clone(self):
        if not self._reprise_clone_presente():
            self._minuteur_reprise_clone.stop()
            return
        self._sur_demande_rafraichir_profils_clone()

    def _planifier_rafraichissement_clone_apres_reconnexion(self):
        """PATCH H : un sAutoniax vient de (re)apparaître sur le serveur : on redemande ses profils (deux fois, le temps qu'il soit
        prêt) pour réafficher l'état réel d'une exécution restée en cours pendant la coupure."""
        QTimer.singleShot(1500, self._sur_demande_rafraichir_profils_clone)
        QTimer.singleShot(6000, self._sur_demande_rafraichir_profils_clone)

    def _sur_changement_mode_execution(self, _index: int):
        task = self._task_courant_obj()
        if task is None:
            return
        nouveau_mode = self.combo_mode_execution.currentData()
        if nouveau_mode == task.mode_execution:
            return
        # Changer de mode alors qu'une cellule tourne déjà mélangerait deux
        # moteurs d'exécution incompatibles (thread local nodriver vs
        # coroutine réseau sAutoniax) sur le MÊME namespace partagé --
        # refusé tant qu'une exécution est en cours pour ce Task, même
        # raisonnement que _demande_liaison_instance (changer une liaison
        # en plein vol casserait le routage en cours).
        if self._moteur_courant_par_task.get(task.id) is not None:
            self._notify_status(
                "Une cellule de ce Task est en cours d'exécution -- attendez la fin avant de changer de mode.",
                error=True,
            )
            self.combo_mode_execution.blockSignals(True)
            index_ancien = self.combo_mode_execution.findData(task.mode_execution)
            self.combo_mode_execution.setCurrentIndex(index_ancien if index_ancien >= 0 else 0)
            self.combo_mode_execution.blockSignals(False)
            return
        task.mode_execution = nouveau_mode
        # CORRECTIF : les profils de l'ancien mode sont retirés TOUT DE SUITE (avant tout rafraîchissement)
        self._purger_profils_autre_mode(task, self._executions_clone.setdefault(task.id, ExecutionCloneEtat()))
        self.project.save()
        self._rafraichir_visibilite_controles_reseau(task)
        self._rafraichir_apres_changement_executant_actif(task)
        self._rafraichir_statut_reseau(task)
        # Le panneau composants affiche le statut de liaison (instance_id
        # local vs id_executant réseau) dans son en-tête -- doit être
        # reconstruit pour refléter le nouveau mode immédiatement.
        self.panneau_composants.rafraichir(task)
        self._notify_status(
            f"« {task.nom} » basculé en mode "
            f"{'réseau (sAutoniax distant)' if nouveau_mode == 'reseau' else 'local'}."
        )

    def _rafraichir_visibilite_controles_reseau(self, task: Task):
        est_reseau = task.mode_execution == "reseau"
        self.groupe_controles_reseau.setVisible(est_reseau)
        self.bouton_voir_rendu_reseau.setVisible(est_reseau)
        self.label_statut_reseau.setVisible(est_reseau)
        # PATCH (mode local dans le panneau clone -- demande explicite
        # utilisateur : "je veux que tu gère le mode local, exactement
        # comme le mode réseau, les profils actifs localement doivent
        # apparaître dans le panneau de clone" -- cf. SPEC_mode_clone_
        # local.md, section 3.3) : le panneau clone (self.panneau_clone)
        # est désormais visible dans LES DEUX modes, plus seulement en
        # réseau -- lui seul change de SOURCE de données (réseau vs
        # local, cf. ID_EXECUTANT_LOCAL et _rafraichir_agregat_profils_
        # clone_local), jamais de visibilité conditionnée à un seul des
        # deux modes. groupe_controles_reseau/label_statut_reseau, EUX,
        # restent strictement réservés au mode réseau (rien à voir avec
        # le panneau clone -- affichent le statut du sAutoniax cible pour
        # les ANCIENS boutons "Initialiser", inchangés par ce patch).
        self.panneau_clone.setVisible(True)
        etat = self._executions_clone.setdefault(task.id, ExecutionCloneEtat())
        etat.actif = True
        if est_reseau:
            self._sur_demande_rafraichir_profils_clone()
        else:
            self._rafraichir_agregat_profils_clone_local(task)

    def _purger_profils_autre_mode(self, task: "Task", etat: "ExecutionCloneEtat") -> bool:
        """CORRECTIF (retour utilisateur : "le type de clone affiché dans le panneau de
        clone n'est pas respecté ... en réseau les profils locaux actifs se listent quand
        même, et vice versa") -- CAUSE RACINE : etat.profils est UN SEUL dict partagé par
        les deux modes (clés composites id_executant::nom_profil, local = ID_EXECUTANT_LOCAL),
        et chaque purge ne nettoyait QUE son propre type : _rafraichir_agregat_profils_clone_
        local ne retire que les clés "local", _reconstruire_agregat_profils_clone ne retire que
        les sAutoniax ayant répondu (jamais "local"). Les profils de l'AUTRE mode, restés
        dans le dict après un changement de mode (ou apparus via une réponse réseau tardive
        reçue en mode local), n'étaient donc jamais retirés et étaient affichés tels quels
        par le panneau, qui rend etat.profils en entier. Pire : ils restaient dans le dict
        et pouvaient être cochés/lancés par les actions groupées.

        Ici : retire de etat.profils tout profil qui n'appartient pas au mode ACTUEL du
        Task (mode local -> seules les clés "local" restent ; mode réseau -> aucune clé
        "local"), détache leur moteur éventuel, désélectionne le profil actif s'il en fait
        partie, et vide les sources purement réseau en mode local. Appelée depuis TOUS les
        points d'entrée du panneau (agrégats local/réseau, point de rendu unique
        _rafraichir_panneau_clone_si_ouvert, demande de rafraîchissement, changement de mode)
        pour que le panneau et etat.profils ne puissent plus jamais contenir l'autre mode.
        Renvoie True si quelque chose a été retiré."""
        est_local = task.mode_execution != "reseau"
        if est_local and (self._profils_bruts_par_sautoniax_clone or self._id_executant_par_profil_clone):
            # sources purement réseau : n'ont aucun sens en mode local (réponses tardives incluses)
            self._profils_bruts_par_sautoniax_clone = {}
            self._id_executant_par_profil_clone = {}

        def _autre_mode(cle_profil: str) -> bool:
            cle_locale = _id_executant_depuis_cle_profil_clone(cle_profil) == ID_EXECUTANT_LOCAL
            return (not cle_locale) if est_local else cle_locale

        a_retirer = [cle for cle in etat.profils if _autre_mode(cle)]
        if not a_retirer:
            return False
        profil_actif_retire = False
        for cle_profil in a_retirer:
            profil_etat = etat.profils[cle_profil]
            if profil_etat.moteur_courant is not None:
                try:
                    self._detacher_moteur_courant_profil(profil_etat)
                except Exception:
                    log_cellule.exception(
                        f"_purger_profils_autre_mode : échec du détachement du moteur de '{cle_profil}' "
                        f"-- sans incidence sur la purge de l'entrée, qui a lieu quand même."
                    )
            if cle_profil == etat.profil_actif:
                profil_actif_retire = True
            del etat.profils[cle_profil]
        log_cellule.info(
            f"_purger_profils_autre_mode : {len(a_retirer)} profil(s) de l'autre mode retiré(s) "
            f"(mode courant : {'local' if est_local else 'réseau'}) : {a_retirer!r}"
        )
        etat.sequence_en_cours = any(
            p.statut in ("en_attente", "en_cours") for p in etat.profils.values() if p.coche
        )
        if profil_actif_retire:
            etat.profil_actif = None
            # même traitement que la disparition du profil actif côté réseau : les liaisons
            # des ServiceAPI pointaient vers une instance de l'autre mode
            if any(task.services_api_importes.values()):
                for nom_service in task.services_api_importes:
                    task.services_api_importes[nom_service] = ""
                self.project.save()
                self.panneau_composants.rafraichir(task)
                self._rafraichir_composants_connus_editeur(task)
                self._rafraichir_variables_globales_editeur(task)
                carte = self._task_cartes.get(task.id)
                if carte is not None:
                    carte.rafraichir(task)
            self._rafraichir_affichage_workspace_cellule_variables(task, etat)
        self._rafraichir_bouton_global()
        return True

    def _rafraichir_agregat_profils_clone_local(self, task: "Task"):
        """Équivalent LOCAL de _reconstruire_agregat_profils_clone (mode
        réseau, cf. plus bas) -- cf. SPEC_mode_clone_local.md, section 3.4.

        Contrairement au mode réseau, AUCUN aller-retour réseau n'est
        nécessaire ici : self._instances_actives est déjà tenu à jour EN
        PERMANENCE par self.client_reseau (role observateur, connecté dès
        le __init__ de cet écran, cf. sa docstring) -- cette méthode ne
        fait donc que RELIRE un état déjà disponible, jamais une nouvelle
        demande asynchrone. Appelée à chaque :
          - passage du Task en mode local (_rafraichir_visibilite_controles_reseau)
          - clic sur le bouton Rafraîchir du panneau clone, en mode local
            (cf. _sur_demande_rafraichir_profils_clone, bifurcation ajoutée)
          - réception d'un nouvel instances_list alors que ce Task (local)
            est affiché (cf. _sur_liste_instances_recue, bloc ajouté)

        Si RESEAU_DASHBOARD_DISPONIBLE est False (module 'websockets'
        absent), self.client_reseau est None et self._instances_actives
        reste "[]" pour toujours -- le panneau affiche alors une liste
        vide en permanence plutôt que de planter (cf. section 5, point 3
        de la spec : filet de sécurité déjà cohérent avec le reste de ce
        fichier pour ce module optionnel)."""
        etat = self._executions_clone.setdefault(task.id, ExecutionCloneEtat())
        self._purger_profils_autre_mode(task, etat)   # CORRECTIF : jamais de profil réseau dans la liste locale
        self._profils_locaux_connus = charger_registre_profils()
        self._instance_id_par_profil_local = _associer_profils_actifs_locaux(
            self._instances_actives,
            list(self._profils_locaux_connus.keys()),
            self._instance_id_par_profil_local,
        )

        cles_actives = set()
        for nom_profil, instance_id in self._instance_id_par_profil_local.items():
            cle_profil = _cle_profil_clone(ID_EXECUTANT_LOCAL, nom_profil)
            cles_actives.add(cle_profil)
            profil_etat = etat.profils.get(cle_profil)
            if profil_etat is None:
                # Nouveau profil local jamais vu pour ce Task -- coche=False
                # par défaut, jamais réinitialisée pour un profil déjà connu
                # (même règle qu'en réseau, cf. _reconstruire_agregat_
                # profils_clone : "ne PAS réinitialiser coche à chaque
                # rafraîchissement").
                profil_etat = CloneProfilEtat(nom_profil=nom_profil)
                etat.profils[cle_profil] = profil_etat
            profil_etat.instance_id = instance_id
            profil_etat.id_executant_sautoniax = ID_EXECUTANT_LOCAL

        # Purge des profils locaux disparus -- même règle qu'en réseau
        # (retrait immédiat, y compris si "en_attente"/"en_cours", cf.
        # SPEC_lot_corrections_2026-09.md section 2 déjà appliquée côté
        # réseau) -- SAUF qu'ici, contrairement au réseau où un sAutoniax
        # distant gère sa propre extinction, un MoteurExecutionCellule
        # local orphelin (instance disparue sous ses pieds) doit être
        # arrêté EXPLICITEMENT avant de perdre sa trace, sans quoi son
        # thread continuerait de tourner en arrière-plan sur une instance
        # déjà morte (cf. SPEC_mode_clone_local.md, section 5 point 1).
        # Filtré sur ID_EXECUTANT_LOCAL uniquement : ne touche jamais aux
        # profils réseau du même etat.profils (cas normalement impossible
        # pour un même Task, mode_execution étant soit local soit réseau,
        # mais défensif -- même esprit que le reste de ce fichier).
        profil_actif_disparu = False
        for cle_profil in list(etat.profils):
            if _id_executant_depuis_cle_profil_clone(cle_profil) != ID_EXECUTANT_LOCAL:
                continue
            if cle_profil in cles_actives:
                continue
            profil_etat = etat.profils[cle_profil]
            if profil_etat.moteur_courant is not None:
                try:
                    profil_etat.moteur_courant.arreter()
                except Exception:
                    log_cellule.exception(
                        f"_rafraichir_agregat_profils_clone_local : échec de l'arrêt du moteur "
                        f"orphelin pour '{cle_profil}' (instance disparue) -- sans incidence sur "
                        f"la purge de l'entrée, qui a lieu quand même juste après."
                    )
            if cle_profil == etat.profil_actif:
                profil_actif_disparu = True
            del etat.profils[cle_profil]
        if profil_actif_disparu:
            etat.profil_actif = None
            # AJOUT (affichage WORKSPACE) -- même raison qu'en mode
            # réseau : profil actif perdu sans passer par
            # _definir_profil_actif, l'éditeur doit repasser sur le vrai
            # code source plutôt que de garder l'attribution d'un profil
            # qui n'existe plus.
            self._rafraichir_affichage_workspace_cellule_variables(task, etat)

        # CORRECTIF (repris en reconstituant l'état d'avancement du
        # patch) : cette méthode appelait _pousser_etat_clone_vers_panneau,
        # qui n'existe pas dans ce fichier -- NameError garanti au tout
        # premier passage en mode local. La fonction déjà existante et
        # équivalente est _rafraichir_panneau_clone_si_ouvert (cf. sa
        # docstring : "Repousse l'état courant vers le panneau"),
        # utilisée par tous les autres points d'entrée du panneau clone
        # (réseau ET local) -- réutilisée ici pour rester cohérent avec
        # eux plutôt que de créer un doublon.
        self._rafraichir_panneau_clone_si_ouvert(task, etat)

    # ------------------------------------------------------------------
    # Liste de profils = environnements (cf. SPEC_profils_environnements.md
    # en entier) -- remplace l'ancien mode "Exécution Clone" à toggle :
    # la liste est désormais TOUJOURS visible en mode réseau, et
    # sélectionner une ligne fait de ce profil l'environnement actif du
    # Task (lie tous ses ServiceAPI importés, section 3), sans plus
    # empêcher les autres profils de tourner en parallèle en arrière-plan
    # (section 2.2, mécanique de _lancer_sequence_clone_profil inchangée).
    # ------------------------------------------------------------------

    def _etat_clone_courant(self) -> Optional["ExecutionCloneEtat"]:
        """Raccourci : ExecutionCloneEtat du Task actuellement affiché,
        None si aucun Task ouvert ou si le mode clone n'a jamais été
        touché pour lui (cf. self._executions_clone, indexé par
        task.id)."""
        task = self._task_courant_obj()
        if task is None:
            return None
        return self._executions_clone.get(task.id)

    # --- 4.2 Peuplement de la liste de profils ---

    def _sur_demande_rafraichir_profils_clone(self):
        """Bouton Rafraîchir du panneau clone, ou passage en mode réseau
        (cf. _rafraichir_visibilite_controles_reseau, qui appelle cette
        fonction dès que le panneau devient visible -- plus de toggle
        toolbar séparé depuis SPEC_profils_environnements.md, la liste
        est désormais permanente) -- cf. section 4.2 de la spec.

        REFONTE MULTI-SAUTONIAX (demande explicite utilisateur : "affiche
        pour tout les sautoniax, actuellement c'est seulement 1
        sautoniax") -- n'interroge plus SEULEMENT un sAutoniax unique
        (l'ancien combo_executant_reseau, depuis retiré -- cf. docstring
        de self.combo_executant_reseau dans __init__) : une demande
        demande_profils_sautoniax_clone est émise pour CHAQUE sAutoniax
        connu de _noms_executants_reseau. Les réponses arrivent de façon
        asynchrone et indépendante les unes des autres (cf.
        sur_profils_sautoniax_clone_recus) -- _profils_bruts_par_
        sautoniax_clone (réinitialisé ici) accumule chaque réponse au fur
        et à mesure, et le panneau se reconstruit à chaque arrivée plutôt
        que d'attendre que TOUS les sAutoniax aient répondu (cohérent
        avec le principe déjà en place ailleurs dans ce fichier : afficher
        au plus tôt ce qui est déjà connu plutôt que de bloquer sur le
        plus lent).

        PATCH (mode local dans le panneau clone -- cf. SPEC_mode_clone_
        local.md, section 3.6) : bifurque en tête sur task.mode_execution.
        En mode local, AUCUNE demande réseau serverT n'a de sens (pas de
        sAutoniax) -- déléguée à _rafraichir_agregat_profils_clone_local,
        qui relit l'état déjà tenu à jour par self.client_reseau (cf. sa
        docstring). Sans cette bifurcation, un clic sur "Rafraîchir" en
        mode local retomberait dans la suite de cette méthode (pensée
        réseau), qui itère sur self._noms_executants_reseau -- vide en
        pratique pour un Task local -- et écraserait la liste locale
        affichée par un panneau vide (branche `if not ids_executants`
        plus bas)."""
        task = self._task_courant_obj()
        if task is None:
            return
        self._purger_profils_autre_mode(task, self._executions_clone.setdefault(task.id, ExecutionCloneEtat()))
        if task.mode_execution == "local":
            self._rafraichir_agregat_profils_clone_local(task)
            return
        ids_executants = list(self._noms_executants_reseau.keys())
        # Réinitialisé à CHAQUE rafraîchissement explicite (bouton, ou
        # passage en mode réseau) -- un sAutoniax déconnecté entre deux
        # rafraîchissements ne doit pas laisser ses anciens profils
        # traîner indéfiniment dans l'agrégat (cf. _sur_profils_multi_
        # sautoniax_recus, qui ne fait que fusionner, jamais purger seul).
        self._profils_bruts_par_sautoniax_clone = {}
        if not ids_executants:
            self._id_executant_par_profil_clone = {}
            # BUGFIX -- appel positionnel ({}, {}, False, None) qui
            # passait un dict vide comme sequence_en_cours (attendu :
            # bool) et False comme profil_actif (attendu : Optional[str])
            # -- fonctionnait "par chance" ({} est falsy, cohérent avec
            # sequence_en_cours=False), mais restait un typage invalide
            # et silencieux, en plus d'omettre noms_par_id_executant/
            # lot_deja_lance (repris à leurs défauts, {} et False) sans
            # que ce soit un choix explicite. Kwargs nommés, cohérents
            # avec les deux autres appelants de rafraichir_liste.
            etat_courant = self._executions_clone.get(task.id)
            self.panneau_clone.rafraichir_liste(
                {}, False, None,
                id_executant_par_profil={},
                noms_par_id_executant={},
                lot_deja_lance=(etat_courant is not None and etat_courant.horodatage_lancement_lot is not None),
            )
            return
        for id_executant in ids_executants:
            self.demande_profils_sautoniax_clone.emit(id_executant)

    def sur_profil_isole_change_ailleurs(self, id_executant: str, _nom_profil: str = "", *_args):
        """BUGFIX (retour utilisateur : "je suis encore obligé d'appuyer
        sur actualiser ... parce que j'ai démarré un autre profil ou
        l'ai arrêté ... et pourtant ça devrait se faire automatiquement") :
        demarrer_profil_isole_resultat_recu et kill_profil_resultat_reel_
        recu (cf. leurs docstrings ClientServeurT) sont DIFFUSÉS par le
        serveur à TOUS les pilotes connectés dès qu'un profil isolé
        démarre ou s'arrête -- y compris quand l'action est déclenchée
        depuis un AUTRE écran (ex. PanneauProprietesSautoniax) pendant
        que TaskEditor/panneau clone reste ouvert. Ces deux signaux
        n'étaient câblés que vers panneau_proprietes (cf. câblage
        MainWindow) -- jamais vers TaskConfigScreen, qui ne se
        rafraîchissait donc QUE sur clic explicite "Actualiser" ou à
        l'ouverture du panneau. Connecté maintenant aux deux (signature
        volontairement permissive via *_args : demarrer_profil_isole_
        resultat_recu émet (id_executant, nom_profil, ok, instance_id,
        message), kill_profil_resultat_reel_recu émet (id_executant,
        nom_profil, redemarrer, ok, message) -- seul id_executant nous
        intéresse ici, le reste est ignoré).

        Filtré par id_executant == sAutoniax du PROFIL ACTIF (panneau
        Exécutions clone -- cf. _id_executant_profil_actif, qui a
        remplacé combo_executant_reseau.currentData() ici, PATCH retrait
        du combo ; même principe que sur_profils_sautoniax_clone_recus
        juste au-dessus -- un événement concernant un autre sAutoniax
        n'a aucune raison de déclencher une redemande réseau ici) ET par
        etat.actif (le panneau clone doit être ouvert pour ce Task --
        sinon on émettrait une demande réseau silencieuse pour un
        panneau que personne ne regarde, à chaque changement de profil
        n'importe où dans l'app)."""
        task = self._task_courant_obj()
        if task is None:
            return
        if task.mode_execution != "reseau":
            return   # CORRECTIF : un événement sAutoniax n'a aucun effet sur un Task en mode local
        if id_executant != self._id_executant_profil_actif(task):
            return
        etat = self._executions_clone.get(task.id)
        if etat is None or not etat.actif:
            return
        self._sur_demande_rafraichir_profils_clone()

    def sur_profils_sautoniax_clone_recus(self, id_executant: str, profils: list):
        """Connecté par MainWindow à ClientServeurT.profils_sautoniax_

        recu -- cf. section 4.2 de SPEC_profils_environnements.md. Ce
        signal réseau (profils_sautoniax_recu) est PARTAGÉ avec d'autres
        usages de cet écran (import cloud, cf. sur_resultat_liste_
        profils_locaux_sautoniax) : distinction faite par MainWindow
        lui-même, qui route ICI seulement les réponses à demande_
        profils_sautoniax_clone (signal réseau dédié, cf. sa docstring
        plus haut) -- aucune ambiguïté possible côté ce handler.

        REFONTE MULTI-SAUTONIAX (demande explicite utilisateur : "affiche
        pour tout les sautoniax") -- n'est plus filtré sur le sAutoniax
        ACTUELLEMENT sélectionné dans combo_executant_reseau (cf. l'ancien
        comportement, qui ignorait toute réponse d'un sAutoniax non
        ciblé) : chaque réponse, quel que soit son id_executant d'origine,
        est acceptée et fusionnée dans _profils_bruts_par_sautoniax_clone
        (cf. _sur_demande_rafraichir_profils_clone, qui interroge
        maintenant TOUS les sAutoniax connus en une fois). Une réponse
        d'un sAutoniax entre-temps déconnecté (absent de
        _noms_executants_reseau) est tout de même acceptée ici -- c'est
        _reconstruire_agregat_profils_clone qui la filtrera au moment de
        l'affichage (cf. sa docstring) plutôt que de la rejeter à la
        réception, pour rester robuste à un léger désordre d'arrivée
        entre l'événement de déconnexion et cette réponse réseau."""
        task = self._task_courant_obj()
        if task is None:
            return
        if task.mode_execution != "reseau":
            # CORRECTIF : réponse réseau tardive (demande émise avant un passage en mode local) --
            # ne doit JAMAIS peupler le panneau d'un Task local.
            return
        self._profils_bruts_par_sautoniax_clone[id_executant] = profils
        self._reconstruire_agregat_profils_clone(task)

    def _reconstruire_agregat_profils_clone(self, task: "Task"):
        """Fusionne _profils_bruts_par_sautoniax_clone (une liste brute
        par sAutoniax interrogé) en une SEULE liste de CloneProfilEtat
        affichée par le panneau clone -- coeur de la REFONTE MULTI-
        SAUTONIAX (demande explicite utilisateur : "affiche pour tout les
        sautoniax, actuellement c'est seulement 1 sautoniax"). Appelée à
        chaque nouvelle réponse reçue (cf. sur_profils_sautoniax_clone_
        recus) : le panneau se met donc à jour progressivement, sAutoniax
        par sAutoniax, plutôt que d'attendre que tous aient répondu.

        Même filtre "actif uniquement" et même logique de disparition/
        conservation d'un profil en cours que l'ancienne sur_profils_
        sautoniax_clone_recus (cf. son ancienne docstring, reprise ici
        telle quelle) -- seule la SOURCE des profils change (plusieurs
        sAutoniax au lieu d'un seul), pas le comportement d'affichage.

        CORRECTIF RACINE (BUG RAPPORTÉ -- "le panneau de clone n'affiche
        pas tout les profils" / "sautoniax 1 vient directement écraser") :
        etat.profils et _id_executant_par_profil_clone sont désormais
        keyés par CLÉ COMPOSITE (id_executant::nom_profil, cf.
        _cle_profil_clone) -- PLUS par nom_profil seul. L'ANCIEN
        comportement, gardé ici pour mémoire, était cassé : deux
        sAutoniax distincts ayant chacun un profil "iaX1" (cas NORMAL,
        pas un cas limite -- les profils générés sont nommés iaX{n} de
        façon identique sur chaque sAutoniax) produisaient une seule
        entrée etat.profils["iaX1"], le second sAutoniax traité dans
        cette boucle écrasant silencieusement l'entrée du premier --
        c'est très exactement pourquoi "sAutoniax 1 vient écraser
        sAutoniax 2" (ou l'inverse selon l'ordre d'arrivée réseau) était
        observé après un clic Rafraîchir. La clé composite élimine la
        collision : chaque (id_executant, nom_profil) obtient sa propre
        entrée, quel que soit le nom partagé.

        _id_executant_par_profil_clone est reconstruit intégralement ici
        (pas seulement complété) : un profil qui change de sAutoniax
        associé entre deux rafraîchissements (cas limite) doit voir son
        entrée mise à jour, pas conserver une ancienne valeur périmée."""
        etat = self._executions_clone.setdefault(task.id, ExecutionCloneEtat())
        self._purger_profils_autre_mode(task, etat)   # CORRECTIF : jamais de profil local dans la liste réseau
        cles_recues_actives = set()
        reprise_touchee = False                          # PATCH H
        self._id_executant_par_profil_clone = {}
        for id_executant, profils in self._profils_bruts_par_sautoniax_clone.items():
            # SPEC_profils_environnements.md section 4.2 point 3 : plus de
            # filtre "profil principal" -- il n'existe plus de notion de
            # profil principal distincte (section 0/1 point 4).
            #
            # RETOUR UTILISATEUR : `profils` liste TOUS les profils
            # présents sur le disque du sAutoniax, lancés ou non (cf.
            # docstring de ClientServeurT.profils_sautoniax_recu --
            # "actifs ET inactifs", "scanner son disque"). Le panneau
            # clone ne doit afficher QUE ceux DÉJÀ LANCÉS (p["actif"] True
            # côté serveur, càd une session sAutoniax déjà chargée
            # dessus) -- un profil jamais lancé n'a de toute façon aucun
            # instance_id exploitable pour le rendu vidéo ou la capture
            # (cf. _cible_rendu_reseau_actuelle), l'afficher ne ferait
            # qu'induire en erreur sur ce qu'on peut réellement en faire
            # depuis ce panneau.
            for p in profils:
                nom_profil = p.get("nom", "")
                if not nom_profil or not p.get("actif"):
                    continue
                cle_profil = _cle_profil_clone(id_executant, nom_profil)
                cles_recues_actives.add(cle_profil)
                self._id_executant_par_profil_clone[cle_profil] = id_executant
                profil_etat = etat.profils.get(cle_profil)
                if profil_etat is None:
                    # Nouveau profil jamais vu -- coche=False par défaut,
                    # jamais réinitialisée pour un profil déjà connu (cf.
                    # section 4.2 point 3 : "ne PAS réinitialiser coche à
                    # chaque rafraîchissement").
                    profil_etat = CloneProfilEtat(nom_profil=nom_profil)
                    etat.profils[cle_profil] = profil_etat
                    if p.get("en_cours"):
                        # PATCH H : profil (re)apparu alors que son sAutoniax y exécute encore une cellule (typiquement après une
                        # coupure : l'ancienne entrée avait été retirée). On réaffiche « en cours » (bouton Arrêter, pas Lancer) ;
                        # AUCUNE relance. coche=True pour que « Tout arrêter » le prenne en compte.
                        profil_etat.statut = "en_cours"
                        profil_etat.coche = True
                        profil_etat.reprise_apres_coupure = True
                        profil_etat.horodatage_debut = p.get("debut_execution") or time.time()
                        profil_etat.horodatage_fin = None
                        reprise_touchee = True
                elif profil_etat.reprise_apres_coupure:
                    reprise_touchee = True
                    if profil_etat.statut != "en_cours":
                        profil_etat.reprise_apres_coupure = False      # arrêté / relancé entre-temps : plus une reprise
                    elif not p.get("en_cours"):
                        # la cellule est terminée côté sAutoniax ; son résultat n'est jamais parvenu à ce pilote (moteur détaché)
                        profil_etat.statut = "inactif"
                        profil_etat.reprise_apres_coupure = False
                        profil_etat.horodatage_fin = time.time()
                if p.get("instance_id"):
                    profil_etat.instance_id = p["instance_id"]
                    # BUGFIX (cause racine du rendu réseau / capture ponctuelle
                    # qui n'affichent jamais rien après un redémarrage des
                    # instances) -- profil_etat.id_executant_sautoniax n'était
                    # JAMAIS assigné ici, alors que instance_id l'est juste
                    # au-dessus. sur_capture_reseau_recue (cf. sa comparaison
                    # "profil_etat.instance_id == instance_id AND profil_etat.
                    # id_executant_sautoniax == id_executant") exige les DEUX
                    # champs corrects pour afficher l'image reçue -- avec
                    # id_executant_sautoniax resté à sa valeur par défaut ""
                    # (cf. CloneProfilEtat), cette comparaison échoue TOUJOURS
                    # (id_executant réel type 'sAutoniax-1' != ""), même quand
                    # instance_id est parfaitement à jour. Confirmé par log
                    # réel : "[DIAG profil_actif] ... instance_id stocké=
                    # 'sautoniax-isole-iaX1-...' id_executant_sautoniax stocké=
                    # ''". id_executant (paramètre de cette fonction, déjà
                    # utilisé juste au-dessus pour peupler _id_executant_par_
                    # profil_clone) est la même valeur attendue ici.
                    profil_etat.id_executant_sautoniax = id_executant
        # Un profil retiré de cette liste (débranché entre deux
        # rafraîchissements, ou son sAutoniax entier disparu) est aussi
        # retiré de etat.profils, y compris s'il est le profil actif (cf.
        # plus bas, profil_actif_disparu) -- SAUF s'il est en cours
        # d'exécution : le perdre silencieusement ferait planter le
        # prochain callback de _lancer_sequence_clone_profil, qui continue
        # de le référencer jusqu'à sa fin naturelle.
        #
        # CORRECTIF RACINE #2 (BUG RAPPORTÉ -- "le panneau clone n'affiche
        # plus que les profils d'UN SEUL sAutoniax après un rafraîchissement,
        # les autres (déjà en Succès) disparaissent" / répercussion directe
        # sur "Capturer tout" qui ne capture plus que ce même sous-ensemble) :
        # cette fonction est appelée à CHAQUE réponse individuelle reçue
        # (cf. docstring de _sur_demande_rafraichir_profils_clone -- "les
        # réponses arrivent de façon asynchrone... le panneau se reconstruit
        # à chaque arrivée plutôt que d'attendre que TOUS les sAutoniax aient
        # répondu"). cles_recues_actives ne contient donc, à un instant T,
        # QUE les profils des sAutoniax ayant DÉJÀ répondu dans CE cycle de
        # rafraîchissement -- pas encore ceux des sAutoniax plus lents.
        #
        # L'ANCIEN code comparait chaque profil connu contre cet ensemble
        # PARTIEL : un profil de sAutoniax-1 (pas encore reparvenu à ce
        # stade) semblait "absent" dès que la réponse de sAutoniax-2 arrivait
        # en premier, et était donc supprimé -- sauf s'il était encore
        # "en_attente"/"en_cours", ce qui ne protège pas un profil déjà
        # "succes". Le lot entier finissait par ne plus contenir que les
        # profils du DERNIER sAutoniax à avoir répondu.
        #
        # Correctif : un profil n'est purgé QUE si son PROPRE sAutoniax
        # d'origine (extrait de sa clé composite via _id_executant_depuis_
        # cle_profil_clone) a LUI-MÊME déjà répondu dans ce cycle (présent
        # dans _profils_bruts_par_sautoniax_clone, cf. sur_profils_
        # sautoniax_clone_recus/_sur_demande_rafraichir_profils_clone) ET
        # que ce profil n'apparaît plus dans SA réponse. Un profil dont le
        # sAutoniax n'a pas encore répondu à ce stade est laissé INTACT,
        # quel que soit son statut -- il sera réévalué correctement dès que
        # la réponse de son propre sAutoniax arrivera (et retombera dans le
        # cas normal ci-dessus si son sAutoniax le confirme toujours actif,
        # ou sera purgé à ce moment-là si son sAutoniax confirme qu'il a
        # disparu).
        sautoniax_ayant_repondu_ce_cycle = set(self._profils_bruts_par_sautoniax_clone.keys())
        profil_actif_disparu = False
        for cle_profil in list(etat.profils):
            if cle_profil in cles_recues_actives:
                continue
            id_executant_profil = _id_executant_depuis_cle_profil_clone(cle_profil)
            if id_executant_profil not in sautoniax_ayant_repondu_ce_cycle:
                # Ce sAutoniax n'a pas encore répondu dans ce cycle --
                # absence d'information, PAS une confirmation de
                # disparition. On ne touche pas à ce profil.
                continue
            profil_etat = etat.profils[cle_profil]
            # SPEC_lot_corrections_2026-09.md section 2 : décision
            # explicite utilisateur -- un profil absent de la réponse de
            # son sAutoniax est désormais retiré IMMÉDIATEMENT au
            # prochain rafraîchissement, MÊME s'il est encore
            # "en_attente"/"en_cours" (ancienne protection ci-dessous
            # retirée). Un profil en cours d'exécution sur un sAutoniax
            # qui a disparu perd donc toute trace visuelle dès ce
            # rafraîchissement, sans état intermédiaire "deconnecte" --
            # ce statut et son mécanisme de reconnexion dédié sont
            # supprimés (cf. _invalider_executions_clone_disparues, qui
            # retire désormais directement l'entrée plutôt que de la
            # marquer).
            if cle_profil == etat.profil_actif:
                profil_actif_disparu = True
            del etat.profils[cle_profil]
        if profil_actif_disparu:
            etat.profil_actif = None
            for nom_service in task.services_api_importes:
                task.services_api_importes[nom_service] = ""
            self.project.save()
            self.panneau_composants.rafraichir(task)
            self._rafraichir_composants_connus_editeur(task)
            self._rafraichir_variables_globales_editeur(task)
            carte = self._task_cartes.get(task.id)
            if carte is not None:
                carte.rafraichir(task)
            self._rafraichir_bouton_global()
            # AJOUT (affichage WORKSPACE) -- cf. les deux autres sites
            # profil_actif_disparu : l'éditeur de cellule_variables doit
            # repasser sur le vrai code source dès que plus aucun profil
            # n'est actif.
            self._rafraichir_affichage_workspace_cellule_variables(task, etat)
            self._notify_status(
                "Le profil actif n'est plus lancé sur son sAutoniax -- désélectionné "
                "automatiquement. Sélectionnez un profil dans la liste pour continuer.",
                error=True,
            )
        # noms_par_id_executant : transmis au panneau pour qu'il affiche
        # le TAG de sAutoniax par ligne (cf. docstring de
        # PanneauExecutionClone -- "avec le nom du sAutoniax en colonne/
        # tag par ligne", décision explicite utilisateur), résolu via
        # _id_executant_par_profil_clone construit juste au-dessus.
        if reprise_touchee:                                  # PATCH H
            etat.sequence_en_cours = any(pe.statut in ("en_attente", "en_cours") for pe in etat.profils.values() if pe.coche)
            self._assurer_sondage_reprise_clone()
            self._rafraichir_bouton_global()
        noms_par_id_executant = dict(self._noms_executants_reseau)
        self.panneau_clone.rafraichir_liste(
            etat.profils, etat.sequence_en_cours, etat.profil_actif,
            id_executant_par_profil=dict(self._id_executant_par_profil_clone),
            noms_par_id_executant=noms_par_id_executant,
            lot_deja_lance=etat.horodatage_lancement_lot is not None,
        )

    # --- 4.4 Lancement des exécutions clone ---

    def _construire_sequence_cellules_clone(self, task: "Task") -> list:
        """Même filtre EXACT que _executer_toutes_cellules : cellule_
        variables en premier si active, puis task.cellules actives dans
        l'ordre. Factorisé ici (référencé par SPEC_profils_environnements.md
        section 2.2 comme "inchangée" -- absente du fichier avant ce
        patch, donc créée maintenant) pour être partagée entre le
        lancement en lot (_sur_demande_lancer_clones) et le lancement
        individuel par ligne (_sur_demande_lancer_clone_profil, ajoutée
        par ce même patch)."""
        sequence_cellules = []
        if task.cellule_variables is not None and getattr(task.cellule_variables, "active", True):
            sequence_cellules.append(task.cellule_variables.id)
        sequence_cellules.extend(c.id for c in task.cellules if getattr(c, "active", True))
        return sequence_cellules

    def _vider_affichage_au_lancement_clones(self, etat, cles_lancees, vider_terminal: bool = False):
        """PATCH (demande utilisateur : « à chaque lancement d'une exécution, la sortie se vide d'abord », cas de
        plusieurs clones lancés à la fois). Les DONNÉES de chaque profil lancé (cellules_resultats, moteur...) étaient déjà
        remises à zéro, mais l'ÉCRAN gardait l'ancienne sortie du profil affiché jusqu'au premier nouveau résultat :
        - si le profil actuellement affiché dans le notebook fait partie des profils lancés, on vide la zone de sortie
          (texte + images) de toutes ses cellules, comme le fait _definir_profil_actif quand on change de profil ;
        - `vider_terminal` : vide aussi le terminal du panneau de rendu réseau (réservé à un NOUVEAU lot : jamais quand
          d'autres profils tournent encore, pour ne pas leur effacer leurs logs)."""
        try:
            if etat.profil_actif in cles_lancees:
                for widget in list(self._cellule_widgets.values()):
                    if getattr(widget, "zone_sortie", None) is None:
                        continue
                    widget.zone_sortie.clear()
                    widget.zone_sortie.hide()
                    widget.entete_sortie.hide()
                    widget.label_indicateur.setText("[ ]")
                    widget.label_indicateur.setStyleSheet(f"color: {Mocha.subtext0};")
            if vider_terminal and self._fenetre_rendu_reseau is not None:
                self._fenetre_rendu_reseau.panneau.effacer_terminal()
        except RuntimeError:
            pass   # widget Qt déjà détruit : rien à vider

    def _sur_demande_lancer_clones(self, cles_profils: list):
        """Cf. section 4.4 de la spec.

        REFONTE MULTI-SAUTONIAX (correctif collision de noms, cf.
        docstring de _cle_profil_clone) : `cles_profils` est une liste de
        CLÉS COMPOSITES (id_executant::nom_profil), pas de noms nus --
        cf. PanneauExecutionClone._sur_clic_lancer_clones, seul
        émetteur du signal demande_lancer_clones.

        PATCH (mode local dans le panneau clone -- cf. SPEC_mode_clone_
        local.md, section 3.7) : bifurque en tête sur task.mode_execution,
        AVANT la garde "!= réseau" qui bloquait auparavant tout lancement
        local ici. Reproduit fidèlement le comportement de PARALLÉLISME
        du mode réseau (demande explicite utilisateur : "reproduit le
        comportement exact d'exécution parallèle comme pour le mode
        réseau") -- un MoteurExecutionCellule (local) PAR profil coché,
        tous démarrés indépendamment (cf. _lancer_sequence_clone_profil_
        local ci-dessous pour le détail de comment le parallélisme est
        rendu possible malgré task.services_api_importes/self._moteur_
        courant_par_task qui, eux, sont partagés par Task, pas par
        profil)."""
        task = self._task_courant_obj()
        if task is None or not cles_profils:
            return
        if task.mode_execution == "local":
            self._sur_demande_lancer_clones_local(task, cles_profils)
            return
        if task.mode_execution != "reseau":
            return
        etat = self._executions_clone.setdefault(task.id, ExecutionCloneEtat())
        if etat.sequence_en_cours:
            return
        # Recommandation TRANCHÉE de la spec (§4.4 point 1) : interdire
        # un run clone pendant que le notebook principal tourne son
        # propre "Tout exécuter", pour éviter toute ambiguïté de partage
        # de ressources -- réévaluable plus tard si besoin réel.
        if self._sequence_active or self._moteurs_en_cours:
            self._notify_status(
                "Le notebook principal est déjà en cours d'exécution -- attendez sa fin avant de lancer des clones.",
                error=True,
            )
            return
        if self._client_serveur_t is None:
            self._notify_status(
                "Réseau indisponible (module 'websockets' manquant) -- exécution impossible.",
                error=True,
            )
            return
        # REFONTE MULTI-SAUTONIAX -- ce lot n'est plus rattaché à UN
        # seul sAutoniax pour tout le lot (l'ancien champ ExecutionCloneEtat.
        # id_executant_sautoniax, retiré -- cf. sa docstring ; distinct du
        # combo UI combo_executant_reseau, retiré séparément depuis, cf.
        # docstring de self.combo_executant_reseau dans __init__) : chaque
        # profil coché porte désormais son propre sAutoniax d'origine, connu depuis la liste
        # agrégée construite par _sur_profils_multi_sautoniax_recus (cf.
        # PanneauExecutionClone.rafraichir_liste). On ne lance donc QUE
        # les profils dont la provenance est effectivement connue --
        # garde défensive contre un profil coché puis disparu entre-temps
        # (sAutoniax déconnecté avant le clic sur "Lancer").
        profils_valides = []  # (cle_profil, nom_profil, id_executant_profil)
        cles_sans_sautoniax = []
        for cle_profil in cles_profils:
            id_executant_profil = self._id_executant_par_profil_clone.get(cle_profil, "")
            if id_executant_profil:
                nom_profil = _nom_depuis_cle_profil_clone(cle_profil)
                profils_valides.append((cle_profil, nom_profil, id_executant_profil))
            else:
                cles_sans_sautoniax.append(cle_profil)
        if cles_sans_sautoniax:
            log_cellule.warning(
                f"[_sur_demande_lancer_clones] profil(s) ignoré(s), sAutoniax "
                f"d'origine inconnu : {cles_sans_sautoniax!r}"
            )
        if not profils_valides:
            self._notify_status(
                "Aucun sAutoniax d'origine connu pour les profils cochés -- rafraîchissez la liste.",
                error=True,
            )
            return

        sequence_cellules = self._construire_sequence_cellules_clone(task)
        if not sequence_cellules:
            self._notify_status("Aucune cellule active à exécuter.", error=True)
            return

        # PATCH : sortie vidée AVANT le lancement (le terminal seulement si aucun clone ne tournait déjà).
        self._vider_affichage_au_lancement_clones(
            etat, {c for c, _n, _i in profils_valides}, vider_terminal=not etat.sequence_en_cours)

        for cle_profil, nom_profil, id_executant_profil in profils_valides:
            profil_etat = etat.profils.get(cle_profil)
            if profil_etat is None:
                profil_etat = CloneProfilEtat(nom_profil=nom_profil)
                etat.profils[cle_profil] = profil_etat
            # CORRECTIF (retour utilisateur : "le bouton de copie de
            # sortie des profils selectionner ne fonctionne pas ... sa
            # ne copie rien" -- SPEC_lot_corrections_2026-09.md section 4,
            # "seuls les profils COCHÉS doivent être copiés") -- CAUSE
            # RACINE : pour un profil lancé pour la toute PREMIÈRE fois
            # (profil_etat is None ci-dessus), un NOUVEL objet CloneProfilEtat
            # est créé sans jamais passer coche=True au constructeur --
            # il démarre donc avec coche=False (valeur par défaut de la
            # dataclass), alors même que ce profil vient d'être lancé
            # PARCE QU'il était coché (cles_profils ne contient QUE des
            # clés cochées, cf. PanneauExecutionClone._sur_clic_lancer_
            # clones : `cles_cochees = [cle for cle, etat_profil in
            # self._profils.items() if etat_profil.coche]`). Pour un
            # profil déjà connu (RELANCÉ), l'objet est partagé par
            # référence avec self._profils du panneau (cf. rafraichir_
            # liste, qui transmet etat.profils tel quel), donc .coche y
            # était déjà correct SAUF si l'utilisateur avait décoché ce
            # profil entre deux lancements sans que cette classe le
            # sache -- même faille dans les deux cas. _sur_demande_
            # copier_logs_par_profil (`if not profil_etat.coche:
            # continue`) filtrait donc TOUS les profils nouvellement/
            # silencieusement décochés, jamais mis à jour ici. Posé à
            # CHAQUE itération (pas seulement à la création) : ce for
            # ne parcourt que des profils qui viennent d'être cochés au
            # moment du clic sur "Lancer", donc coche=True est toujours
            # correct ici, qu'importe l'état précédent de l'objet.
            profil_etat.coche = True
            # Figé ICI, au moment du lancement -- même principe que
            # l'ancien etat.id_executant_sautoniax unique (cf. docstring
            # de CloneProfilEtat.id_executant_sautoniax) : un changement
            # de connexion réseau en cours de route ne doit pas faire
            # dévier ce profil de son sAutoniax d'origine pour CE lot.
            profil_etat.id_executant_sautoniax = id_executant_profil
            profil_etat.statut = "en_attente"
            profil_etat.reprise_apres_coupure = False      # PATCH H
            profil_etat.cellules_resultats = {}
            profil_etat.moteur_courant = None
            profil_etat.cellule_courante_id = None
            # AJOUT (spec B.2, colonne "Temps") -- réinitialisés à None
            # ICI, au relancement d'un profil déjà connu (profil_etat
            # préexistant, coché puis relancé) : sans ce reset, le
            # compteur affiché repartirait de l'horodatage_debut de
            # l'exécution PRÉCÉDENTE de ce même profil (l'objet
            # CloneProfilEtat est réutilisé, jamais recréé, quand
            # cle_profil est déjà connue, cf. quelques lignes plus haut).
            profil_etat.horodatage_debut = None
            profil_etat.horodatage_fin = None
            # AJOUT (SPEC_lot_corrections_2026-09.md section 11) : même
            # raisonnement exactement que horodatage_debut/fin juste
            # au-dessus -- CloneProfilEtat est réutilisé (jamais recréé)
            # d'un lancement à l'autre pour une clé de profil déjà connue,
            # donc sans ce reset explicite, result_color afficherait la
            # pastille de l'exécution PRÉCÉDENTE tant que la nouvelle
            # n'a pas encore atteint sa propre dernière cellule -- "#FFFFFF"
            # cohérent avec la réinitialisation injectée côté sAutoniax
            # dans le namespace au tout début du lot (cf. décisions
            # section 11 : "Réinitialisation systématique", CHANGEMENT
            # hex : cf. commentaire sur CloneProfilEtat.result_color).
            profil_etat.result_color = COULEUR_RESULT_COLOR_DEFAUT
            # REFONTE MULTI-SAUTONIAX -- _lancer_sequence_clone_profil et
            # toute la chaîne réseau en aval identifient un profil par
            # CLÉ COMPOSITE pour l'état interne (etat.profils), mais
            # doivent envoyer le NOM NU réel au sAutoniax (c'est le nom
            # de profil tel qu'il existe sur son disque, la clé composite
            # est une convention purement interne au pilote). cf.
            # _lancer_sequence_clone_profil pour la résolution des deux.
            self._lancer_sequence_clone_profil(task, etat, cle_profil, list(sequence_cellules))

        # AJOUT (bouton "Copier les logs de cette exécution", cf.
        # docstring de ExecutionCloneEtat.horodatage_lancement_lot) --
        # posé ICI, une seule fois pour tout le lot, juste avant que les
        # profils ne commencent réellement à envoyer leurs commandes
        # réseau -- inclut donc la toute première ligne de log de ce
        # lancement (ex. "<- executer_notebook_distant reçu") plutôt que
        # de risquer de la couper si le timestamp était pris après coup.
        # Toujours réécrit (pas de garde `is None`, contrairement à
        # CloneProfilEtat.horodatage_debut) : un nouveau lancement doit
        # TOUJOURS redémarrer la fenêtre de copie, jamais hériter de
        # celle d'un run précédent sur ce même Task.
        etat.horodatage_lancement_lot = time.time()
        etat.horodatage_fin_lot = None
        etat.sequence_en_cours = True
        self._rafraichir_panneau_clone_si_ouvert(task, etat)
        # Section 6.2 : si le profil actif fait partie du lot qui vient
        # d'être lancé, le bouton global doit refléter tout de suite son
        # nouveau statut ("en_attente") plutôt qu'attendre la prochaine
        # transition individuelle.
        cles_profils_lances = {cle_profil for cle_profil, _nom_profil, _id_exec in profils_valides}
        if etat.profil_actif in cles_profils_lances:
            self._rafraichir_bouton_global()

    def _rafraichir_apres_transition_clone(self, task: "Task", etat: "ExecutionCloneEtat", cle_profil: Optional[str] = None):
        """AJOUT (spec B.1, revue élargie) -- point UNIQUE à appeler après
        CHAQUE transition de statut d'un profil clone (démarrage, cellule
        suivante, succès, erreur, arrêt) : regroupe l'appel à
        _rafraichir_panneau_clone_si_ouvert (déjà systématique à chacun de
        ces points) et le rafraîchissement du badge de statut global
        (self._rafraichir_bouton_global(), qui appelle lui-même
        _rafraichir_badge_statut_notebook() en toute fin, cf. sa
        docstring), pour que ces deux mises à jour ne puissent plus être
        oubliées séparément l'une de l'autre -- cause racine exacte du bug
        initial (badge de statut bloqué "en cours" alors que la LISTE de
        profils du panneau clone, elle, se mettait à jour correctement).

        BUGFIX (confirmé par logs BADGE-TRACE, 05:03:05 -- iaX8 et iaX2
        terminent chacun leur DERNIÈRE cellule avec succès, profil_etat.
        statut passe bien à "succes", mais etat.profil_actif valait
        'iaX10' au même instant -- l'ancienne condition ci-dessous
        empêchait alors TOUT appel à _rafraichir_bouton_global() pour ces
        deux transitions) : l'ancienne docstring affirmait que sauter cet
        appel était "sans effet visible mais inoffensif" quand un autre
        profil est actif -- c'était FAUX. Tant que le profil actif
        (ici iaX10) n'a pas lui-même une transition, plus RIEN ne vient
        jamais republier le statut "succes"/"erreur" des autres profils
        déjà terminés -- le badge reste figé indéfiniment sur "en cours"
        même après un clic de sélection ultérieur sur le profil concerné,
        car ce clic ne fait que relire un profil_etat.statut qui, lui,
        était déjà correct : le problème n'a jamais été la lecture, mais
        l'appel sauté au moment de l'écriture.

        _rafraichir_bouton_global() est appelée INCONDITIONNELLEMENT
        ci-dessous, quel que soit cle_profil : elle relit toujours
        etat.profil_actif en interne (cf. sa docstring et celle de
        _rafraichir_badge_statut_notebook), donc un appel "en trop" pour
        un profil qui n'est pas actif ne peut jamais peindre le mauvais
        badge -- il est simplement redondant avec le prochain appel utile,
        au coût négligeable d'un recalcul supplémentaire (déjà fait en
        boucle ailleurs, ex. pendant une séquence de 10 profils).

        REFONTE MULTI-SAUTONIAX -- `cle_profil` (renommé depuis nom_
        profil) n'est utilisé ICI que pour le logging, jamais comparé ni
        indexé -- accepte indifféremment une clé composite ou un nom nu,
        aucun changement fonctionnel requis par cette fonction elle-même."""
        log_cellule.debug(
            f"[BADGE-TRACE][_rafraichir_apres_transition_clone] ENTRÉE -- "
            f"task.id={task.id!r} cle_profil(transition)={cle_profil!r} "
            f"etat.profil_actif(courant)={etat.profil_actif!r} etat_id={id(etat)}"
        )
        self._rafraichir_panneau_clone_si_ouvert(task, etat)
        log_cellule.debug(
            f"[BADGE-TRACE][_rafraichir_apres_transition_clone] APPEL INCONDITIONNEL -- "
            f"_rafraichir_bouton_global() (cle_profil(transition)={cle_profil!r}, "
            f"etat.profil_actif(courant)={etat.profil_actif!r}) -- BUGFIX : ancienne garde "
            f"'nom_profil == etat.profil_actif' RETIRÉE, elle empêchait le badge de refléter "
            f"le succès/l'échec d'un profil terminé pendant qu'un AUTRE profil était affiché"
        )
        self._rafraichir_bouton_global()

    def _ranger_result_output_pilote(self, task: "Task", profil_etat, result_output, nom_profil: str, afficher=None):
        """AJOUT (transfert RESULT_OUTPUT) -- côté PILOTE, fin de lot d'un
        profil : écrit `result_output` (dict reçu du sAutoniax, ou None)
        sous RESULT_SAVE_PATH/<nom_profil>/. RESULT_SAVE_PATH est lue
        statiquement dans cellule_variables (cf. lire_result_save_path_
        dans_code). Rien à ranger -> no-op silencieux. Échec -> log
        WARNING + ligne ajoutée à la sortie de la dernière cellule du
        profil, pour que l'utilisateur le voie dans le panneau clone."""
        if not result_output:
            return
        code_variables = getattr(getattr(task, "cellule_variables", None), "code", "") or ""

        def _signaler(message: str):
            # Journalise (WARNING) ET ajoute une ligne à la sortie de la
            # dernière cellule du profil : visible dans le panneau clone,
            # jamais silencieux, jamais propagé.
            log_cellule.warning(f"[RESULT_OUTPUT] profil {nom_profil!r} : {message}")
            if afficher is not None:
                try:
                    afficher(f"[RESULT_OUTPUT] {message}")
                except Exception:
                    pass
                return
            try:
                for cellule_res in reversed(list(profil_etat.cellules_resultats.values())):
                    cellule_res.sortie = (cellule_res.sortie + "\n" if cellule_res.sortie else "") + f"[RESULT_OUTPUT] {message}"
                    break
            except Exception:
                pass

        # AJOUT (SPEC_result_output_handler.md) -- si la cellule "Variable
        # dynamique" déclare RESULT_OUTPUT_HANDLER, c'est ELLE qui décide
        # de tout (dossier, nom, format...) : RESULT_SAVE_PATH n'est alors
        # plus lue. Repli sur le comportement historique (écriture .json
        # sous RESULT_SAVE_PATH) si la fonction est absente (ancien projet,
        # ligne supprimée) OU si son extraction échoue (erreur de syntaxe)
        # -- dans ce second cas le message est signalé, jamais avalé.
        handler, erreur_extraction = extraire_result_output_handler_du_code(code_variables)
        if erreur_extraction:
            _signaler(f"{erreur_extraction} -- repli sur RESULT_SAVE_PATH.")
        if handler is not None:
            ok_valeur, valeur = valeur_pour_result_output_handler(result_output)
            if not ok_valeur:
                _signaler(str(valeur))
                return
            try:
                handler(valeur)
            except Exception as e:
                # Toute exception du code UTILISATEUR est capturée : un
                # handler mal écrit ne doit jamais faire échouer le lot ni
                # remonter jusqu'au moteur.
                log_cellule.warning(
                    f"[RESULT_OUTPUT] profil {nom_profil!r} : {NOM_FONCTION_RESULT_OUTPUT_HANDLER} a levé "
                    f"{type(e).__name__}: {e}\n{traceback.format_exc()}"
                )
                _signaler(f"{NOM_FONCTION_RESULT_OUTPUT_HANDLER} a levé {type(e).__name__}: {e}")
                return
            log_cellule.info(f"[RESULT_OUTPUT] profil {nom_profil!r} -> {NOM_FONCTION_RESULT_OUTPUT_HANDLER} exécutée")
            return

        # ---- Comportement historique (repli) : .json sous RESULT_SAVE_PATH.
        dossier = lire_result_save_path_dans_code(code_variables)
        ok, message = ecrire_result_output_sur_disque(result_output, dossier, nom_profil)
        if ok:
            log_cellule.info(f"[RESULT_OUTPUT] profil {nom_profil!r} -> {message}")
            return
        _signaler(message)

    def _lancer_sequence_clone_profil(self, task: "Task", etat: "ExecutionCloneEtat", cle_profil: str, file_cellules: list):
        """Une instance de cette logique PAR PROFIL, en parallèle -- cf.
        section 4.4 point 4 de la spec (même principe que
        _lancer_prochaine_cellule_sequence côté notebook réel, mais
        indépendante par profil : pas de round-robin, cf. section 1
        point 5).

        REFONTE MULTI-SAUTONIAX (correctif collision de noms, cf.
        docstring de _cle_profil_clone) : `cle_profil` (id_executant::
        nom_profil) indexe etat.profils et sert de repère d'affichage
        (etat.profil_actif) -- mais le NOM NU réellement envoyé au
        sAutoniax sur le réseau (profil_nom du moteur, services_api_lies_
        override) est toujours profil_etat.nom_profil, jamais la clé
        composite : le sAutoniax ne connaît que ses propres noms de
        profils locaux, pas cette convention purement interne au
        pilote."""
        profil_etat = etat.profils.get(cle_profil)
        nom_profil = profil_etat.nom_profil if profil_etat is not None else _nom_depuis_cle_profil_clone(cle_profil)
        log_cellule.debug(
            f"[BADGE-TRACE][_lancer_sequence_clone_profil] ENTRÉE -- "
            f"cle_profil={cle_profil!r} nom_profil={nom_profil!r} profil_etat_trouvé={profil_etat is not None} "
            f"file_cellules(restante)={file_cellules!r} etat.profil_actif={etat.profil_actif!r}"
        )
        if profil_etat is None or not file_cellules:
            log_cellule.debug(
                f"[BADGE-TRACE][_lancer_sequence_clone_profil] ABANDON -- "
                f"profil_etat_trouvé={profil_etat is not None} file_cellules_vide={not file_cellules} -- "
                f"appel _verifier_fin_sequence_clone puis retour, PAS de _rafraichir_apres_transition_clone ici"
            )
            self._verifier_fin_sequence_clone(task, etat)
            return
        cellule_id = file_cellules[0]
        cellule_reelle = self._trouver_cellule_par_id(task, cellule_id)
        if cellule_reelle is None:
            # Cellule disparue entre la construction de la séquence et
            # son exécution (cas limite : édition concurrente du Task
            # pendant qu'un lot clone tourne) -- passe à la suivante
            # plutôt que de bloquer tout le profil pour une cellule qui
            # n'existe plus.
            self._lancer_sequence_clone_profil(task, etat, cle_profil, file_cellules[1:])
            return
        # AJOUT (demande explicite utilisateur, cf. docstring de
        # code_variables_avec_workspace_affiche) : calculé tôt (avant la
        # définition de _callback_termine plus bas, qui en a besoin dans
        # sa closure) plutôt qu'au niveau de son ancien emplacement juste
        # avant moteur.lancer -- cellule_id/task.cellule_variables ne
        # changent pas entre les deux points, donc même résultat, mais
        # calculé une seule fois et réutilisé aux deux endroits qui en
        # ont besoin (le préfixage réseau ET l'affichage post-exécution).
        est_cellule_variables = (
            task.cellule_variables is not None and cellule_id == task.cellule_variables.id
        )
        # CORRECTIF (revue de cohérence) : figé ICI, AU MÊME MOMENT que
        # est_cellule_variables ci-dessus -- càd AVANT l'envoi réseau,
        # donc AVANT toute latence réseau pendant laquelle une nouvelle
        # attribution WORKSPACE pourrait être déclenchée par l'utilisateur
        # (clic sur le bouton du panneau clone pendant que CETTE cellule
        # est encore en vol). etat.workspace_attribution est un dict
        # MUTABLE, potentiellement réécrit EN ENTIER par TaskConfigScreen.
        # _appliquer_attribution_workspace à tout moment -- une lecture
        # DANS _callback_termine (donc APRÈS le retour réseau, un temps
        # arbitraire plus tard) risquerait de lire une valeur DIFFÉRENTE
        # de celle réellement envoyée dans code_a_envoyer, si une
        # réattribution a eu lieu entretemps. Capturé une seule fois ici
        # (copie -- list(...) -- pas une référence au dict lui-même),
        # réutilisé tel quel pour le préfixage ET pour l'affichage post-
        # exécution, pour que les deux soient TOUJOURS rigoureusement la
        # même valeur, quoi qu'il arrive à etat.workspace_attribution
        # entretemps.
        # RENOMMAGE (PATCH v2, SPEC_patch_tasks_json.md section 5 ; PATCH
        # v4) : chaque élément est désormais DIRECTEMENT un dict de champs
        # métier (PATCH v2 : un dict {"donnees": ..., "fichier_source":
        # ...} ; avant le v2 : un chemin str) -- renommé
        # taches_workspace_pour_ce_lancement pour ne plus induire en
        # erreur sur le type des éléments.
        taches_workspace_pour_ce_lancement = list(
            etat.workspace_attribution.get(cle_profil, [])
        )
        profil_etat.statut = "en_cours"
        profil_etat.cellule_courante_id = cellule_id
        log_cellule.debug(
            f"[BADGE-TRACE][_lancer_sequence_clone_profil] ÉCRITURE profil_etat.statut='en_cours' -- "
            f"cle_profil={cle_profil!r} nom_profil={nom_profil!r} cellule_id={cellule_id!r} "
            f"(profil_etat id={id(profil_etat)})"
        )
        # AJOUT (SPEC_lot_corrections_2026-09.md section 11) : calculés
        # AVANT que profil_etat.horodatage_debut ne soit potentiellement
        # écrit juste en dessous -- `is None` à cet instant précis
        # signifie "aucune cellule encore envoyée pour cette séquence",
        # exactement le même repère déjà utilisé pour horodatage_debut
        # (remis à None à chaque nouveau lancement, cf. _sur_demande_
        # lancer_clones) -- réutilisé ici plutôt que d'introduire un
        # nouveau champ redondant sur CloneProfilEtat pour la même
        # information. `len(file_cellules) == 1` signifie "aucune cellule
        # ne suit celle-ci dans la file restante" -- transmis au
        # sAutoniax pour qu'il sache QUAND réinitialiser result_color à
        # 'white' (début du lot, pas de chaque cellule) et QUAND lire sa
        # valeur finale pour l'inclure dans envoyer_notebook_distant_
        # resultat (fin du lot, pas de chaque cellule) -- cf. décisions
        # de la section 11 ("Une seule pastille par lot complet").
        est_premiere_cellule_du_lot = profil_etat.horodatage_debut is None
        est_derniere_cellule_du_lot = len(file_cellules) == 1
        # AJOUT (spec B.2, colonne "Temps") -- repli LOCAL posé au moment
        # de l'envoi de la PREMIÈRE cellule de la séquence de ce profil
        # seulement (garde `is None` : cette fonction est rappelée pour
        # chaque cellule suivante de la même séquence, cf. l'appel
        # récursif à self._lancer_sequence_clone_profil plus bas -- le
        # chrono doit courir sur toute la séquence du profil, pas
        # redémarrer à chaque cellule). Valeur provisoire, seulement
        # utilisée pour l'affichage LIVE (QTimer, cf. PanneauExecutionClone)
        # pendant que la séquence tourne ; ce repli inclut la latence
        # réseau d'envoi (aucun aller-retour n'a encore eu lieu à cet
        # instant) -- écrasée le cas échéant par la valeur réelle transmise
        # à la fin (cf. _callback_termine ci-dessous, resultat["horodatage_
        # debut"]) une fois la séquence terminée.
        if profil_etat.horodatage_debut is None:
            profil_etat.horodatage_debut = time.time()
        # CORRECTIF (spec B.1) -- regroupe panneau clone + badge de statut
        # global (cf. docstring de _rafraichir_apres_transition_clone) :
        # avant ce patch, seul _rafraichir_panneau_clone_si_ouvert était
        # appelé ici, jamais le badge -- cause du badge bloqué "en cours"
        # alors même que la liste de profils se mettait à jour.
        self._rafraichir_apres_transition_clone(task, etat, cle_profil)

        # CORRECTIF (bug confirmé en prod : NameError sur un Composant
        # en mode clone -- cf. docstring de services_api_lies_override
        # dans MoteurExecutionCelluleReseau.__init__) : construit la
        # liaison RÉSOLUE POUR CE PROFIL (nom_profil, résolu plus haut
        # depuis cle_profil -- le profil RÉELLEMENT exécuté par CE
        # moteur), plutôt que de laisser lancer() lire task.services_
        # api_importes (liaison globale au profil actif unique de
        # l'éditeur, non fiable ici puisque plusieurs profils clone
        # tournent en parallèle sur le même objet task). Même forme que
        # ce que _definir_profil_actif écrit pour UN SEUL profil actif --
        # reproduite ici pour CHAQUE profil clone indépendamment :
        # {nom_service_api: nom_profil}, pour toutes les clés déjà
        # connues de task.services_api_importes.
        services_api_lies_clone = {nom_service: nom_profil for nom_service in task.services_api_importes}
        moteur = MoteurExecutionCelluleReseau(
            client_serveur_t=self._client_serveur_t,
            task=task,
            cellule_id=cellule_id,
            # REFONTE MULTI-SAUTONIAX -- id_executant du PROFIL (figé au
            # lancement, cf. _sur_demande_lancer_clones), pas de l'ancien
            # champ de lot etat.id_executant_sautoniax (retiré) : c'est ce
            # qui permet à chaque profil coché de partir vers son propre
            # sAutoniax d'origine, en parallèle des autres.
            id_executant=profil_etat.id_executant_sautoniax,
            profil_nom=nom_profil,
            services_api_lies_override=services_api_lies_clone,
            # AJOUT (SPEC_lot_corrections_2026-09.md section 11) --
            # cf. docstring de MoteurExecutionCelluleReseau.__init__ pour
            # le détail complet du transport de ces deux flags jusqu'au
            # sAutoniax.
            reinitialiser_result_color=est_premiere_cellule_du_lot,
            lire_result_color_finale=est_derniere_cellule_du_lot,
        )
        profil_etat.moteur_courant = moteur
        # CORRECTIF (cf. docstring de _sessions_execution_reseau_clone) :
        # enregistrement AVANT moteur.lancer(), même principe que le
        # correctif équivalent dans _executer_cellule -- moteur._session_id
        # est déjà généré dans MoteurExecutionCelluleReseau.__init__, donc
        # disponible ici sans avoir besoin d'attendre le retour de
        # lancer(). Registre séparé (session_id -> moteur direct) car
        # plusieurs profils clone peuvent exécuter la MÊME cellule_id en
        # parallèle (cf. docstring du registre).
        self._sessions_execution_reseau_clone[moteur._session_id] = moteur
        log_cellule.info(
            f"[{cellule_id}] [reseau][routage][clone] enregistré dans "
            f"_sessions_execution_reseau_clone AVANT moteur.lancer() : "
            f"session_id={moteur._session_id!r} profil={nom_profil!r} "
            f"services_api_lies_clone={services_api_lies_clone!r}"
        )


        def _callback_termine(resultat: dict):
            # Réinjecté sur le thread Qt principal (cf. contrat de
            # MoteurExecutionCelluleReseau, identique à _executer_cellule
            # ci-dessus).
            # CORRECTIF : retire l'entrée de _sessions_execution_reseau_
            # clone dès que le résultat est traité -- sinon ce dict
            # grossirait indéfiniment sur une longue session (cf. le
            # QTimer.singleShot(5000) équivalent côté _sessions_execution_
            # reseau, ici un retrait immédiat suffit puisqu'aucune image
            # en vol ne dépend de ce registre-ci, contrairement à
            # sur_image_execution_reseau_recu qui lui utilise l'AUTRE
            # registre self._sessions_execution_reseau).
            # BUGFIX (retour utilisateur : "tu dois aussi stoker les
            # images comme le texte en permanence" -- cf. TaskCellule.
            # derniere_image_b64) -- capturé AVANT profil_etat.
            # moteur_courant = None, sans quoi la référence à moteur et
            # donc à _sortie_accumulee (qui porte l'image) serait perdue
            # comme n'importe quel objet Python sans référence. On garde
            # la DERNIÈRE entrée ("image", b64) trouvée, cohérent avec
            # le nom du champ et avec le cas normal d'une cellule qui ne
            # fait qu'un seul .view().
            _derniere_image_b64 = None
            for _entree in getattr(moteur, "_sortie_accumulee", None) or []:
                if isinstance(_entree, tuple) and _entree and _entree[0] == "image":
                    _derniere_image_b64 = _entree[1]
            self._sessions_execution_reseau_clone.pop(moteur._session_id, None)
            profil_etat.moteur_courant = None
            if resultat.get("instance_id"):
                profil_etat.instance_id = resultat["instance_id"]
            # AJOUT (demande explicite utilisateur) : pour cellule_
            # variables UNIQUEMENT, le code affiché post-exécution montre
            # la vraie liste de tâches (LIST_TASKS) attribuée à ce profil
            # -- cf. docstring de code_variables_avec_workspace_affiche.
            # Exact symétrique du mode local (_lancer_sequence_clone_
            # profil_local), même fonction réutilisée pour rester
            # cohérent.
            # CORRECTIF : utilise taches_workspace_pour_ce_lancement
            # (figé AVANT l'envoi réseau, cf. son commentaire plus haut),
            # PAS une relecture de etat.workspace_attribution ici -- sans
            # quoi une réattribution survenue PENDANT le vol réseau de
            # cette cellule afficherait une valeur différente de celle
            # réellement envoyée.
            code_affiche = cellule_reelle.code
            if est_cellule_variables:
                code_affiche = code_variables_avec_workspace_affiche(
                    cellule_reelle.code, taches_workspace_pour_ce_lancement,
                )
            # Résultat stocké dans une COPIE de TaskCellule -- JAMAIS
            # l'objet réel de task.cellules (cf. section 1 point 6).
            cellule_temp = TaskCellule(
                id=cellule_id,
                titre=getattr(cellule_reelle, "titre", ""),
                description=getattr(cellule_reelle, "description", ""),
                code=code_affiche,
                sortie=resultat["sortie"] if resultat["ok"] else (
                    resultat["sortie"] + ("\n" if resultat["sortie"] and resultat["erreur"] else "") + (resultat["erreur"] or "")
                ),
                statut="succes" if resultat["ok"] else "erreur",
                numero_execution=len(profil_etat.cellules_resultats) + 1,
                derniere_image_b64=_derniere_image_b64,
            )
            profil_etat.cellules_resultats[cellule_id] = cellule_temp
            log_cellule.debug(
                f"[BADGE-TRACE][_callback_termine] ENTRÉE -- cle_profil={cle_profil!r} nom_profil={nom_profil!r} "
                f"cellule_id={cellule_id!r} resultat['ok']={resultat.get('ok')!r} "
                f"task.id(de CETTE séquence, en arrière-plan)={task.id!r} "
                f"self._task_courant(id affiché À L'ÉCRAN en ce moment)={getattr(self, '_task_courant', 'ATTR_ABSENT')!r} "
                f"MATCH_task_affiché={task.id == getattr(self, '_task_courant', object())!r} "
                f"etat.profil_actif(AU MOMENT DU CALLBACK)={etat.profil_actif!r} "
                f"MATCH_profil_actif={etat.profil_actif == cle_profil!r} "
                f"profil_etat.statut(avant écriture ok/erreur)={profil_etat.statut!r} "
                f"reste_apres_cette_cellule={file_cellules[1:]!r}"
            )
            # Si CE profil est actuellement affiché dans le vrai
            # notebook (bouton logs, §4.6), rafraîchir tout de suite le
            # widget concerné pour un retour visuel en direct.
            # REFONTE MULTI-SAUTONIAX -- etat.profil_actif est une CLÉ
            # COMPOSITE (cf. _sur_demande_definir_profil_actif) : comparer
            # à cle_profil, pas à nom_profil (qui, seul, redeviendrait
            # ambigu entre deux sAutoniax homonymes).
            if etat.profil_actif == cle_profil:
                widget = self._cellule_widgets.get(cellule_id)
                if widget is not None:
                    widget.afficher_resultat(cellule_temp)
                    # BUGFIX (même trou que sur_image_execution_reseau_recu,
                    # cf. sa docstring) : afficher_resultat pose cellule_
                    # temp.sortie (texte pur, JAMAIS l'image, cf. son
                    # commentaire de construction ci-dessus) -- sans cet
                    # appel, une image .view() capturée pendant cette
                    # cellule disparaissait de l'écran dès que la cellule
                    # se terminait, même si ce profil restait actif.
                    self._reafficher_image_si_presente(widget, moteur)
                # CORRECTIF (bug identifié en revue de bout en bout) :
                # afficher_resultat(cellule_temp) juste au-dessus ne
                # référence NI cellule.code NI self.editeur -- elle ne
                # gère que l'indicateur [n], la couleur et la zone de
                # sortie. Poser code_affiche dans cellule_temp.code
                # n'avait donc AUCUN effet visuel : le texte à l'écran
                # restait celui de l'éditeur, càd le code source brut.
                # C'est definir_code_affiche (via le rafraîchissement
                # ci-dessous) qui change réellement ce qui est affiché.
                # cellule_temp.code reste renseigné pour la trace de
                # données dans cellules_resultats, mais n'est plus la
                # source de l'affichage.
                if est_cellule_variables:
                    self._rafraichir_affichage_workspace_cellule_variables(task, etat)
            if not resultat["ok"]:
                # Même comportement que "Tout exécuter" : la séquence de
                # CE profil s'arrête sur la première erreur (cf. section
                # 4.4 point 4, reproduit à l'identique pour la cohérence
                # UX déjà établie côté notebook réel).
                profil_etat.statut = "erreur"
                profil_etat.cellule_courante_id = None
                # AJOUT (spec B.2, colonne "Temps") -- figé sur la valeur
                # RÉELLE rapportée par le sAutoniax pour CETTE cellule
                # (celle qui a échoué -- la dernière exécutée pour ce
                # profil) si fournie, sinon repli local (time.time() ici,
                # documenté comme incluant la latence réseau retour, cf.
                # docstring du champ sur CloneProfilEtat).
                profil_etat.horodatage_fin = resultat.get("horodatage_fin") or time.time()
                log_cellule.debug(
                    f"[BADGE-TRACE][_callback_termine] ÉCRITURE profil_etat.statut='erreur' (TERMINAL) -- "
                    f"cle_profil={cle_profil!r} cellule_id={cellule_id!r} "
                    f"-- appel _rafraichir_apres_transition_clone(cle_profil={cle_profil!r})"
                )
                # CORRECTIF (spec B.1) -- cf. docstring de _rafraichir_
                # apres_transition_clone.
                self._rafraichir_apres_transition_clone(task, etat, cle_profil)
                self._verifier_fin_sequence_clone(task, etat)
                return
            reste = file_cellules[1:]
            if not reste:
                profil_etat.statut = "succes"
                profil_etat.cellule_courante_id = None
                # AJOUT (spec B.2, colonne "Temps") -- cf. commentaire
                # équivalent ci-dessus dans le cas "erreur" : figé sur la
                # valeur réelle de la DERNIÈRE cellule de la séquence
                # (celle qui vient de se terminer, plus reste après elle),
                # sinon repli local.
                profil_etat.horodatage_fin = resultat.get("horodatage_fin") or time.time()
                # AJOUT (SPEC_lot_corrections_2026-09.md section 11) --
                # `reste` vide ici signifie que CETTE cellule était bien
                # la dernière de la séquence (même condition exacte que
                # est_derniere_cellule_du_lot calculé à l'envoi, cf.
                # _lancer_sequence_clone_profil), donc le sAutoniax a
                # lu et transmis result_color pour cette cellule (cf.
                # _sautoniax_executer_notebook_distant_sur_instance_
                # isolee). resultat.get(...) plutôt qu'un accès direct :
                # reste sur la valeur par défaut "#FFFFFF" de CloneProfilEtat
                # si un ancien sAutoniax pas encore mis à jour n'envoie
                # pas ce champ (JSON absent, cf. envoyer_notebook_distant_
                # resultat) -- jamais None écrit explicitement ici.
                if resultat.get("result_color"):
                    profil_etat.result_color = resultat["result_color"]
                # AJOUT (transfert RESULT_OUTPUT) -- rangé sur le disque du
                # PILOTE, dans RESULT_SAVE_PATH (lu STATIQUEMENT depuis le
                # code de cellule_variables : le pilote n'a pas de namespace
                # partagé avec l'exécution réseau). Un échec d'écriture
                # n'invalide PAS le lot (le traitement a réussi) : il est
                # journalisé et ajouté à la sortie du profil, jamais silencieux.
                self._ranger_result_output_pilote(task, profil_etat, resultat.get("result_output"), nom_profil)
                log_cellule.debug(
                    f"[BADGE-TRACE][_callback_termine] ÉCRITURE profil_etat.statut='succes' (TERMINAL, "
                    f"dernière cellule de la séquence) -- cle_profil={cle_profil!r} cellule_id={cellule_id!r} "
                    f"result_color={profil_etat.result_color!r} "
                    f"-- appel _rafraichir_apres_transition_clone(cle_profil={cle_profil!r})"
                )
                # CORRECTIF (spec B.1) -- cf. docstring de _rafraichir_
                # apres_transition_clone.
                self._rafraichir_apres_transition_clone(task, etat, cle_profil)
                self._verifier_fin_sequence_clone(task, etat)
                return
            log_cellule.debug(
                f"[BADGE-TRACE][_callback_termine] CELLULE INTERMÉDIAIRE OK -- cle_profil={cle_profil!r} "
                f"cellule_id={cellule_id!r} -- passage à la cellule suivante, reste={reste!r} "
                f"(PAS de _rafraichir_apres_transition_clone ici : le statut 'en_cours' sera réécrit "
                f"identique par l'appel récursif -- mais on log quand même son propre passage plus haut)"
            )
            self._lancer_sequence_clone_profil(task, etat, cle_profil, reste)

        # AJOUT (SPEC_workspace_attribution.md, section 8.2) : préfixe le
        # code envoyé pour CE profil précis avec une réassignation
        # explicite `LIST_TASKS = [...]`, SAUF si la cellule en cours
        # d'envoi est cellule_variables elle-même (cf. docstring de
        # prefixer_code_avec_workspace pour le raisonnement complet --
        # cellule_variables pose LIST_TASKS = [] TOUT EN HAUT de son
        # propre bloc, un préfixe ajouté devant serait donc immédiatement
        # écrasé par cette réaffectation qui vient juste après. Exact
        # symétrique du mode local, cf. _lancer_sequence_clone_profil_
        # local : réimposé APRÈS l'exécution de cellule_variables, jamais
        # avant). etat.workspace_attribution est déjà keyé par cle_profil
        # (cf. TaskConfigScreen._appliquer_attribution_workspace) --
        # absent == [] (profil non couvert par la dernière attribution).
        # (est_cellule_variables ET taches_workspace_pour_ce_lancement
        # déjà calculés plus haut dans cette fonction, réutilisés ici
        # tels quels -- même valeur figée que celle qui sera affichée
        # dans _callback_termine, cf. son commentaire.)
        if est_cellule_variables:
            code_a_envoyer = cellule_reelle.code
        else:
            code_a_envoyer = prefixer_code_avec_workspace(
                cellule_reelle.code, taches_workspace_pour_ce_lancement,
            )
        moteur.lancer(namespace={}, code=code_a_envoyer, callback_termine=_callback_termine)

    def _sur_demande_lancer_clones_local(self, task: "Task", cles_profils: list):
        """PATCH (mode local dans le panneau clone -- cf. SPEC_mode_clone_
        local.md, section 3.7) : symétrique de _sur_demande_lancer_clones
        (réseau) ci-dessus, mais résout un `instance_id` LOCAL par profil
        (self._instance_id_par_profil_local, tenu à jour par
        _rafraichir_agregat_profils_clone_local) plutôt qu'un id_executant
        sAutoniax -- pas de notion de "sAutoniax d'origine" en local, un
        seul exécutant implicite (ID_EXECUTANT_LOCAL, cf. sa docstring).

        Même garde-fous que la version réseau (séquence déjà en cours,
        notebook principal en cours, aucune cellule active à exécuter) --
        SAUF la vérification self._client_serveur_t (n'a aucun sens en
        local, cf. self._client_reseau_execution à la place, vérifié dans
        _lancer_sequence_clone_profil_local pour chaque profil, exactement
        comme le fait déjà _executer_cellule pour le ▶ individuel)."""
        etat = self._executions_clone.setdefault(task.id, ExecutionCloneEtat())
        if etat.sequence_en_cours:
            return
        if self._sequence_active or self._moteurs_en_cours:
            self._notify_status(
                "Le notebook principal est déjà en cours d'exécution -- attendez sa fin avant de lancer des clones.",
                error=True,
            )
            return
        if self._client_reseau_execution is None:
            self._notify_status(
                "Réseau indisponible (module 'websockets' manquant) -- exécution impossible.",
                error=True,
            )
            return
        # Contrairement au mode réseau (id_executant_profil connu depuis
        # la liste multi-sAutoniax), le mode local n'a besoin de vérifier
        # qu'une chose par profil coché : que ce profil a bien une
        # instance active en ce moment (cf. self._instance_id_par_profil_
        # local, cf. _rafraichir_agregat_profils_clone_local) -- garde
        # défensive contre un profil coché puis fermé entre-temps (Kill
        # depuis un autre écran juste avant le clic sur "Lancer").
        profils_valides = []  # (cle_profil, nom_profil, instance_id)
        cles_sans_instance = []
        for cle_profil in cles_profils:
            nom_profil = _nom_depuis_cle_profil_clone(cle_profil)
            instance_id = self._instance_id_par_profil_local.get(nom_profil, "")
            if instance_id:
                profils_valides.append((cle_profil, nom_profil, instance_id))
            else:
                cles_sans_instance.append(cle_profil)
        if cles_sans_instance:
            log_cellule.warning(
                f"[_sur_demande_lancer_clones_local] profil(s) ignoré(s), aucune instance "
                f"locale active : {cles_sans_instance!r}"
            )
        if not profils_valides:
            self._notify_status(
                "Aucune instance locale active pour les profils cochés -- rafraîchissez la liste.",
                error=True,
            )
            return

        sequence_cellules = self._construire_sequence_cellules_clone(task)
        if not sequence_cellules:
            self._notify_status("Aucune cellule active à exécuter.", error=True)
            return

        # PATCH : sortie du profil affiché vidée AVANT le lancement (mode local).
        self._vider_affichage_au_lancement_clones(etat, {c for c, _n, _i in profils_valides})

        for cle_profil, nom_profil, instance_id in profils_valides:
            profil_etat = etat.profils.get(cle_profil)
            if profil_etat is None:
                profil_etat = CloneProfilEtat(nom_profil=nom_profil)
                etat.profils[cle_profil] = profil_etat
            # Même raisonnement EXACT que la version réseau (cf. son
            # commentaire détaillé ci-dessus) : coche=True posé à CHAQUE
            # itération, pas seulement à la création.
            profil_etat.coche = True
            profil_etat.id_executant_sautoniax = ID_EXECUTANT_LOCAL
            profil_etat.instance_id = instance_id
            profil_etat.statut = "en_attente"
            profil_etat.reprise_apres_coupure = False      # PATCH H
            profil_etat.cellules_resultats = {}
            profil_etat.moteur_courant = None
            profil_etat.cellule_courante_id = None
            profil_etat.horodatage_debut = None
            profil_etat.horodatage_fin = None
            profil_etat.result_color = COULEUR_RESULT_COLOR_DEFAUT
            # BUGFIX (relecture complète de la chaîne mode local) :
            # self._namespaces_clone_locaux[cle_profil] (cf. docstring de
            # _lancer_sequence_clone_profil_local) est créé UNE SEULE fois
            # au premier lancement d'un profil, puis réutilisé tel quel
            # par tout lancement ULTÉRIEUR sur ce même profil (if
            # namespace is None dans cette fonction) -- sans purge ici,
            # un relancement du même profil réutiliserait le namespace
            # (et donc les variables Python) de la session PRÉCÉDENTE,
            # contaminant silencieusement la nouvelle exécution avec un
            # état résiduel (ex. une variable "x" définie lors d'un
            # premier run resterait visible lors du second, alors que
            # cellules_resultats/statut/horodatages, eux, repartent bien
            # à zéro juste au-dessus). Absent côté réseau : MoteurExecution
            # CelluleReseau.lancer() reçoit toujours namespace={} (ignoré,
            # le code s'exécute côté sAutoniax distant, cf. spec section
            # 1.4) -- ce problème est donc propre au mode local, où le
            # namespace Python persistant vit réellement dans CE process.
            self._namespaces_clone_locaux.pop(cle_profil, None)
            self._lancer_sequence_clone_profil_local(task, etat, cle_profil, instance_id, list(sequence_cellules))

        etat.horodatage_lancement_lot = time.time()
        etat.horodatage_fin_lot = None
        etat.sequence_en_cours = True
        self._rafraichir_panneau_clone_si_ouvert(task, etat)
        cles_profils_lances = {cle_profil for cle_profil, _nom_profil, _instance_id in profils_valides}
        if etat.profil_actif in cles_profils_lances:
            self._rafraichir_bouton_global()

    def _lancer_sequence_clone_profil_local(
        self, task: "Task", etat: "ExecutionCloneEtat", cle_profil: str, instance_id: str, file_cellules: list,
    ):
        """PATCH (mode local dans le panneau clone -- cf. SPEC_mode_clone_
        local.md, section 3.7) : symétrique LOCAL de _lancer_sequence_
        clone_profil (réseau) -- reproduit le MÊME parallélisme (demande
        explicite utilisateur : "reproduit le comportement exact
        d'exécution parallèle comme pour le mode réseau"), une instance
        de cette logique PAR PROFIL, en parallèle.

        DIFFÉRENCE STRUCTURELLE PAR RAPPORT AU ▶ INDIVIDUEL LOCAL
        (_executer_cellule) : celui-ci résout l'instance à lier depuis
        task.services_api_importes (UN SEUL jeu de valeurs par Task) et
        indexe le moteur en cours dans self._moteur_courant_par_task
        (UNE SEULE entrée par task.id) -- tous deux incompatibles avec
        PLUSIEURS profils exécutant la MÊME séquence EN PARALLÈLE sur le
        MÊME Task (le second écraserait la liaison du premier). Cette
        méthode-ci ne touche NI l'un NI l'autre : elle construit, pour ce
        profil précis, un `services_api_lies_local = {nom_service:
        instance_id for ... in task.services_api_importes}` (même
        principe EXACT que services_api_lies_clone côté réseau, cf.
        _lancer_sequence_clone_profil : "TOUS les ServiceAPI importés
        pointent vers l'instance de CE profil pour ce lot") et résout les
        ComposantExecutable/ServiceAPIExecutable directement avec CET
        instance_id, sans jamais lire ni écrire task.services_api_importes
        réel -- exactement le même levier que MoteurExecutionCelluleReseau.
        services_api_lies_override, adapté au fait que MoteurExecutionCellule
        (classe locale) n'expose pas ce paramètre et lit son __init__
        directement task.services_api_importes (cf. sa docstring) : on lui
        passe donc une COPIE SUPERFICIELLE du Task (dataclasses.replace,
        cf. import en tête de fichier), avec services_api_importes
        réécrit pour CE profil -- id/nom/cellules restent ceux du VRAI
        task (même référence de liste `cellules`, jamais copiée : cette
        méthode ne la modifie jamais), donc le registre anti-collision
        (_instances_occupees_par_nos_tasks, clé task.id) continue de
        fonctionner exactement comme avant, réseau ou local, individuel
        ou clone.

        Namespace DÉDIÉ à cette exécution de profil (dict neuf à chaque
        appel initial, PAS self._namespaces_tasks[task.id] -- réservé au
        ▶ individuel/Tout exécuter, cf. sa docstring "comme un vrai
        notebook Jupyter partagé") : contrairement au notebook réel, une
        séquence clone (réseau comme local) n'a jamais eu de notion de
        variables partagées entre profils -- chaque profil clone garde
        son propre stdout/résultat isolé dans profil_etat.cellules_
        resultats, jamais affiché dans le vrai notebook sauf si ce profil
        est etat.profil_actif (cf. plus bas). Un namespace neuf par
        LANCEMENT de séquence (pas par cellule -- passé en paramètre et
        réutilisé d'un appel récursif à l'autre, cf. plus bas) permet
        malgré tout à une variable définie dans la cellule statique
        d'être réutilisée par les cellules suivantes DE CETTE séquence
        précise, cohérent avec le comportement "notebook" à l'intérieur
        d'un seul lancement."""
        profil_etat = etat.profils.get(cle_profil)
        nom_profil = profil_etat.nom_profil if profil_etat is not None else _nom_depuis_cle_profil_clone(cle_profil)
        if profil_etat is None or not file_cellules:
            self._verifier_fin_sequence_clone(task, etat)
            return
        cellule_id = file_cellules[0]
        cellule_reelle = self._trouver_cellule_par_id(task, cellule_id)
        if cellule_reelle is None:
            # Cellule disparue entre la construction de la séquence et
            # son exécution -- même cas limite que la version réseau,
            # cf. son commentaire : passe à la suivante.
            self._lancer_sequence_clone_profil_local(task, etat, cle_profil, instance_id, file_cellules[1:])
            return
        profil_etat.statut = "en_cours"
        profil_etat.cellule_courante_id = cellule_id
        if profil_etat.horodatage_debut is None:
            profil_etat.horodatage_debut = time.time()
        self._rafraichir_apres_transition_clone(task, etat, cle_profil)

        # Namespace dédié à CETTE séquence de CE profil -- cf. docstring
        # de méthode ci-dessus. Créé une seule fois (première cellule,
        # cf. profil_etat.horodatage_debut is None juste avant) et
        # retrouvé ensuite via self._namespaces_clone_locaux (indexé par
        # cle_profil, PAS task.id -- plusieurs profils du même Task ont
        # chacun le leur, contrairement à self._namespaces_tasks).
        namespace = self._namespaces_clone_locaux.get(cle_profil)
        if namespace is None:
            namespace = {
                "__builtins__": __builtins__,
                "ZoneClicRect": ZoneClicRect,
                "InstanceExecutable": InstanceExecutable,
                "extraire_texte_fichier": extraire_texte_fichier,
                "ecrire_texte_fichier": ecrire_texte_fichier,
                "textFile": textFile,
                "TextFile": TextFile,
            }
            namespace.update(_construire_espace_noms_api2api(self._client_serveur_t))
            namespace["envoyer_resultat"] = _fabriquer_envoyer_resultat(
                lambda _p, _t=task, _pe=profil_etat: (self._ranger_result_output_pilote(_t, _pe, _p, _pe.nom_profil), True)[1]
            )
            self._namespaces_clone_locaux[cle_profil] = namespace
        # AJOUT (demande explicite utilisateur, revue de cohérence) :
        # calculé ICI, tôt -- réutilisé pour l'injection juste en dessous
        # ET pour l'affichage post-exécution dans _callback_termine
        # (cf. plus bas), même principe que côté réseau (cf. son propre
        # est_cellule_variables, calculé au même endroit relatif dans
        # _lancer_sequence_clone_profil).
        est_cellule_variables = (
            task.cellule_variables is not None and cellule_id == task.cellule_variables.id
        )
        # CORRECTIF (revue de cohérence -- BUG trouvé) : l'ancien
        # commentaire ici affirmait que "la toute première cellule de
        # cette séquence est TOUJOURS cellule_variables", ce qui est FAUX
        # dès que l'utilisateur désactive cellule_variables (cf.
        # TaskConfigScreen._sur_toggle_active_cellule, qui peut basculer
        # cellule_variables.active à False exactement comme n'importe
        # quelle autre cellule -- _construire_sequence_cellules_clone ne
        # l'inclut alors PLUS DU TOUT dans sequence_cellules). Dans ce
        # cas, la première cellule RÉELLEMENT exécutée est une cellule
        # utilisateur normale, et namespace n'a JAMAIS eu LIST_TASKS posé
        # avant son exécution (la réimposition n'a lieu qu'APRÈS chaque
        # cellule, cf. _callback_termine plus bas) -- un script qui lit
        # LIST_TASKS dans cette toute première cellule levait donc une
        # NameError pure et simple, LIST_TASKS n'ayant aucun filet
        # _global_defaut (cf. son commentaire de déclaration : "PAS lue
        # via self._global_defaut ailleurs dans le code").
        #
        # Correctif : injecté ICI, avant moteur.lancer, mais UNIQUEMENT
        # si la cellule sur le point de s'exécuter n'est PAS cellule_
        # variables elle-même -- pour cellule_variables (quand elle est
        # bien la première, cas normal), le raisonnement d'origine reste
        # valable : son propre code réaffecte LIST_TASKS = [] EN PREMIER
        # dans son bloc, donc une injection faite ICI serait immédiatement
        # écrasée par exec(code, namespace) -- c'est pourquoi la
        # réimposition APRÈS reste le SEUL mécanisme pour cellule_
        # variables (inchangé). Pour toute AUTRE cellule qui se trouve
        # être la première de la séquence (cellule_variables désactivée
        # OU CE n'est simplement plus la première cellule restante après
        # un appel récursif), rien ne va réaffecter LIST_TASKS avant que
        # son propre code ne s'exécute -- l'injecter ici est donc sûr et
        # nécessaire, exact miroir du préfixage réseau (qui, lui,
        # préfixe déjà TOUTE cellule non-cellule_variables, cf.
        # prefixer_code_avec_workspace/_lancer_sequence_clone_profil).
        # Sans effet redondant pour les cellules 2+ de la séquence (déjà
        # réimposé par le callback de la cellule précédente) -- une
        # double écriture de la même valeur n'est jamais un problème.
        if not est_cellule_variables:
            namespace["LIST_TASKS"] = list(etat.workspace_attribution.get(cle_profil, []))
        # AJOUT (transfert RESULT_OUTPUT, mode local) -- même principe que
        # la réinitialisation réseau (cf. main_executeur_sautoniax) : remis
        # à None avant la PREMIÈRE cellule du lot d'un profil (ce namespace
        # est persistant par Task et partagé entre profils/lots), sans quoi
        # un résultat du lot précédent serait re-rangé une seconde fois.
        # Pas de transfert de fichiers en local : pilote et exécution
        # partagent le même disque, les chemins de LIST_TASKS sont déjà
        # valides tels quels.
        # CRITÈRE : `not profil_etat.cellules_resultats` (vidé au début de
        # chaque lot, cf. réinitialisation de cellules_resultats plus haut
        # dans le lanceur de lot local) et NON `horodatage_debut is None` :
        # ce dernier est déjà posé quelques lignes AU-DESSUS par cette même
        # fonction, donc toujours non-None ici -- le test ne se serait
        # JAMAIS déclenché.
        if not profil_etat.cellules_resultats:
            namespace["RESULT_OUTPUT"] = None

        # cf. docstring de méthode : TOUS les ServiceAPI importés de ce
        # Task pointent vers l'instance de CE profil, pour ce lancement --
        # jamais task.services_api_importes réel, jamais partagé entre
        # profils. Même principe EXACT que services_api_lies_clone côté
        # réseau (cf. _lancer_sequence_clone_profil).
        services_api_lies_local = {nom_service: instance_id for nom_service in task.services_api_importes}
        # Copie superficielle du Task avec ce mapping -- cf. docstring de
        # méthode pour le raisonnement complet (id/nom/cellules
        # inchangés, seule services_api_importes diverge pour ce profil).
        task_pour_ce_profil = replace(task, services_api_importes=services_api_lies_local)

        services_utilises = self._services_api_utilises_dans_code(task, cellule_reelle.code)
        try:
            moteur = MoteurExecutionCellule(
                client_reseau=self._client_reseau_execution,
                task=task_pour_ce_profil,
                cellule_id=cellule_id,
                instances_occupees_registre=self._instances_occupees_par_nos_tasks,
                services_api_utilises=services_utilises,
            )
        except (ServiceAPINonLieError, InstanceOccupeeError) as e:
            profil_etat.statut = "erreur"
            profil_etat.cellule_courante_id = None
            profil_etat.horodatage_fin = time.time()
            cellule_temp = TaskCellule(
                id=cellule_id,
                titre=getattr(cellule_reelle, "titre", ""),
                description=getattr(cellule_reelle, "description", ""),
                code=cellule_reelle.code,
                sortie=str(e),
                statut="erreur",
                numero_execution=len(profil_etat.cellules_resultats) + 1,
            )
            profil_etat.cellules_resultats[cellule_id] = cellule_temp
            self._rafraichir_apres_transition_clone(task, etat, cle_profil)
            self._verifier_fin_sequence_clone(task, etat)
            return
        profil_etat.moteur_courant = moteur

        # Réécrit les ComposantExecutable/ServiceAPIExecutable de CE
        # namespace pour qu'ils pointent sur l'instance de CE profil et
        # sur LE moteur de CETTE exécution précise -- même mécanique EXACTE
        # que _executer_cellule (▶ individuel), cf. son commentaire
        # détaillé, mais résolue depuis services_api_lies_local (ce
        # profil) plutôt que task.services_api_importes (le Task réel).
        resolveur_moteur = lambda: (etat.profils.get(cle_profil).moteur_courant if etat.profils.get(cle_profil) else None)
        groupes = self.project.composants_importes_task(task)
        for nom_service, composants in groupes.items():
            instance_id_service = services_api_lies_local.get(nom_service, "")
            if not instance_id_service:
                continue
            for composant in composants:
                namespace[nom_variable_python(composant.nom)] = ComposantExecutable(
                    composant, instance_id_service, moteur, namespace,
                )
            namespace[nom_variable_python(nom_service)] = ServiceAPIExecutable(
                nom_service, instance_id_service, resolveur_moteur, namespace,
            )
        groupes_layout = self.project.composants_layout_importes_task(task)
        for nom_service, composants_layout in groupes_layout.items():
            instance_id_service = services_api_lies_local.get(nom_service, "")
            if not instance_id_service:
                continue
            for composant_layout in composants_layout:
                namespace[nom_variable_python(composant_layout.nom)] = ComposantLayoutExecutable(
                    composant_layout, moteur, instance_id_service, namespace=namespace,
                )

        # (est_cellule_variables déjà calculé plus haut dans cette
        # fonction, avant l'injection pré-moteur.lancer -- réutilisé ici
        # tel quel pour l'affichage post-exécution.)

        def _callback_termine(resultat: dict):
            profil_etat.moteur_courant = None
            # AJOUT (demande explicite utilisateur) : pour cellule_
            # variables UNIQUEMENT, le code affiché post-exécution montre
            # la vraie liste WORKSPACE attribuée à ce profil (repli
            # inhabité géré silencieusement, cf. docstring de la
            # fonction) -- jamais pour les autres cellules, dont le code
            # affiché reste celui écrit par l'utilisateur, inchangé.
            code_affiche = cellule_reelle.code
            if est_cellule_variables:
                code_affiche = code_variables_avec_workspace_affiche(
                    cellule_reelle.code, etat.workspace_attribution.get(cle_profil, []),
                )
            cellule_temp = TaskCellule(
                id=cellule_id,
                titre=getattr(cellule_reelle, "titre", ""),
                description=getattr(cellule_reelle, "description", ""),
                code=code_affiche,
                sortie=resultat["sortie"] if resultat["ok"] else (
                    resultat["sortie"] + ("\n" if resultat["sortie"] and resultat["erreur"] else "") + (resultat["erreur"] or "")
                ),
                statut="succes" if resultat["ok"] else "erreur",
                numero_execution=len(profil_etat.cellules_resultats) + 1,
            )
            profil_etat.cellules_resultats[cellule_id] = cellule_temp
            # AJOUT (SPEC_workspace_attribution.md, section 8.1) : réimpose
            # la liste de tâches attribuée à CE profil, APRÈS l'exécution
            # de la cellule qui vient de se terminer -- même BUGFIX/patron
            # que _reimposer_variables_mappees (ProjetBatch.mapping_
            # variables/RESPONSE_DIR, cf. son commentaire détaillé) :
            # cellule_variables (ou toute cellule ultérieure) peut avoir
            # réaffecté LIST_TASKS dans son propre code, ce qui écraserait
            # purement et simplement l'injection si elle n'était faite
            # qu'une fois au début. Réimposé APRÈS CHAQUE cellule (pas
            # seulement après cellule_variables) pour couvrir aussi une
            # réaffectation accidentelle dans une cellule ultérieure du
            # script. Sans effet sur le RÉSULTAT déjà affiché ci-dessus
            # (cellule_temp.sortie déjà figée) -- ne fait que préparer le
            # namespace pour la PROCHAINE cellule de cette même séquence.
            namespace["LIST_TASKS"] = list(etat.workspace_attribution.get(cle_profil, []))
            # Si CE profil est actuellement affiché dans le vrai notebook
            # (bouton logs, §4.6) -- même mécanisme que la version réseau.
            if etat.profil_actif == cle_profil:
                widget = self._cellule_widgets.get(cellule_id)
                if widget is not None:
                    widget.afficher_resultat(cellule_temp)
                    self._reafficher_image_si_presente(widget, moteur)
                # CORRECTIF -- exact symétrique du mode réseau, cf. son
                # commentaire détaillé : afficher_resultat ne touche
                # jamais l'éditeur, seul definir_code_affiche (via ce
                # rafraîchissement) change le texte réellement affiché.
                if est_cellule_variables:
                    self._rafraichir_affichage_workspace_cellule_variables(task, etat)
            if not resultat["ok"]:
                profil_etat.statut = "erreur"
                profil_etat.cellule_courante_id = None
                profil_etat.horodatage_fin = time.time()
                self._rafraichir_apres_transition_clone(task, etat, cle_profil)
                self._verifier_fin_sequence_clone(task, etat)
                return
            reste = file_cellules[1:]
            if not reste:
                profil_etat.statut = "succes"
                profil_etat.cellule_courante_id = None
                profil_etat.horodatage_fin = time.time()
                # AJOUT (transfert RESULT_OUTPUT, mode local) -- lu
                # directement dans le namespace (aucun protocole réseau),
                # même sérialisation que côté sAutoniax pour que le
                # fichier écrit soit IDENTIQUE dans les deux modes.
                try:
                    _ro_local = _serialiser_result_output(namespace.get("RESULT_OUTPUT"))
                except Exception as _e_ro:
                    _ro_local = {"type": "erreur", "message": f"lecture de RESULT_OUTPUT impossible : {_e_ro!r}"}
                self._ranger_result_output_pilote(task, profil_etat, _ro_local, profil_etat.nom_profil)
                self._rafraichir_apres_transition_clone(task, etat, cle_profil)
                self._verifier_fin_sequence_clone(task, etat)
                return
            self._lancer_sequence_clone_profil_local(task, etat, cle_profil, instance_id, reste)

        moteur.lancer(namespace=namespace, code=cellule_reelle.code, callback_termine=_callback_termine)

    def _verifier_fin_sequence_clone(self, task: "Task", etat: "ExecutionCloneEtat"):
        """Cf. section 4.4 point 4 dernier tiret : si tous les profils
        cochés ont terminé leur séquence (succès, erreur, ou arrêt),
        remet sequence_en_cours à False et rafraîchit le panneau."""
        statuts_en_cours = {"en_attente", "en_cours"}
        if any(p.statut in statuts_en_cours for p in etat.profils.values() if p.coche):
            return
        etat.sequence_en_cours = False
        # AJOUT (bouton "Copier les logs de cette exécution", cf.
        # docstring de ExecutionCloneEtat.horodatage_fin_lot) -- posé ICI,
        # le point UNIQUE où le lot entier est constaté terminé (tous les
        # profils cochés sont sortis de "en_attente"/"en_cours"), plutôt
        # que dans chacun des call-sites de sequence_en_cours=False
        # (arrêt manuel, erreur globale) qui, eux, appellent tous cette
        # même fonction en premier lieu -- garde `is None` absente
        # volontairement : si cette fonction est réappelée après coup
        # (ex. transition tardive d'un profil déjà compté terminé), on
        # veut la dernière valeur réelle, pas la première.
        etat.horodatage_fin_lot = time.time()
        self._rafraichir_panneau_clone_si_ouvert(task, etat)

    def _rafraichir_panneau_clone_si_ouvert(self, task: "Task", etat: "ExecutionCloneEtat"):
        """Repousse l'état courant vers le panneau -- no-op si le Task
        affiché n'est pas celui concerné (ex. callback réseau arrivant
        après que l'utilisateur a changé de Task, cf. self._task_courant_
        obj()).

        BUGFIX ROBUSTESSE (retour utilisateur : badge/chrono restait
        visuellement figé sur "En cours" alors que l'exécution était
        déjà terminée depuis un moment côté serveur, correction
        spontanée "tout d'un coup" bien plus tard sans action de
        l'utilisateur) -- CAUSE RACINE CONFIRMÉE : cette méthode
        sautait ENTIÈREMENT l'appel à panneau_clone.rafraichir_liste()
        quand self.panneau_clone.isVisible() était False (onglet caché,
        fenêtre pas au premier plan, etc.) au moment PRÉCIS de la
        transition réseau. etat.profils (la donnée réelle) était donc
        déjà correcte immédiatement, mais table_profils (l'affichage
        Qt du panneau) ne recevait plus AUCUNE mise à jour tant que le
        panneau restait caché -- ni le texte de statut, ni le widget
        d'actions, ni surtout _synchroniser_timer_temps (jamais rappelée
        dans cette fenêtre), qui est le SEUL point qui arrête
        self._timer_temps : le chrono continuait donc de tourner et
        d'incrémenter visuellement une ligne déjà terminée, jusqu'à ce
        qu'un rafraichir_liste() quelconque, déclenché par tout autre
        événement une fois le panneau redevenu visible, réplique enfin
        etat.profils en bloc -- d'où la correction simultanée de TOUTES
        les lignes en un seul coup, sans lien apparent avec une action
        de l'utilisateur.
        CORRECTIF : retire la garde isVisible() -- _reconstruire_table
        est déjà conçue pour être bon marché (cf. sa docstring : simples
        setText/setForeground, aucune reconstruction de widget sauf
        changement de statut réel) et Qt ignore silencieusement les
        appels de rendu sur un widget cristallisé/caché, donc l'appeler
        même panneau invisible ne coûte rien d'anormal et garantit que
        etat.profils et table_profils ne peuvent plus jamais diverger,
        quelle que soit la visibilité au moment de la transition. Voir
        aussi showEvent() de PanneauExecutionClone, qui force un
        rafraîchissement complet dès que le panneau redevient visible,
        en filet de sécurité supplémentaire pour tout appel qui aurait
        malgré tout été manqué ailleurs."""
        task_courant = self._task_courant_obj()
        if task_courant is None or task_courant.id != task.id:
            return
        # CORRECTIF (panneau clone : profils de l'autre mode affichés) -- point de rendu UNIQUE
        # de tout le panneau : garantit que etat.profils ne contient que le mode actuel du Task.
        self._purger_profils_autre_mode(task, etat)
        # REFONTE MULTI-SAUTONIAX -- même repli que _sur_profils_multi_
        # sautoniax_recus (cf. docstring de rafraichir_liste) : chaque
        # profil résout son propre sAutoniax via profil_etat.id_executant_
        # sautoniax (figé, une fois lancé) ou self._id_executant_par_
        # profil_clone (dernier connu, sinon), plus d'ancien etat.id_
        # executant_sautoniax unique -- le panneau clone n'a d'ailleurs
        # plus jamais été filtré par un sAutoniax unique choisi via combo
        # (widget entièrement retiré depuis, cf. docstring de self.
        # combo_executant_reseau dans __init__).
        # PATCH (mode local dans le panneau clone -- cf. SPEC_mode_clone_
        # local.md, section 7 : "Local (cette machine)" comme libellé
        # affiché pour ID_EXECUTANT_LOCAL) : self._noms_executants_reseau
        # est purement réseau (réassigné en bloc par definir_executants_
        # reseau_connus, cf. sa docstring -- y injecter ID_EXECUTANT_LOCAL
        # directement serait effacé dès la prochaine réponse serveurT).
        # Le libellé local, lui, est une constante FIXE (jamais issue d'un
        # flux réseau) -- fusionnée ici, au point d'appel, plutôt que dans
        # la source elle-même. PanneauExecutionClone lui-même n'est PAS
        # modifié (cf. section 2.1 de la spec : "zéro changement dans
        # PanneauExecutionClone") -- _nom_executant y retombe simplement
        # sur ce libellé tel quel (ne correspond pas au motif "sAutoniax-N"
        # qu'elle abrège, cf. sa docstring).
        noms_par_id_executant = dict(self._noms_executants_reseau)
        noms_par_id_executant[ID_EXECUTANT_LOCAL] = NOM_AFFICHE_EXECUTANT_LOCAL
        # AJOUT (SPEC_mode_clone_local.md section 5 point 3) : en mode
        # local, self.client_reseau/self._client_reseau_execution sont
        # None quand RESEAU_DASHBOARD_DISPONIBLE est False (module
        # 'websockets' absent) -- etat.profils reste alors vide en
        # permanence (aucune instance ne peut jamais être détectée), ce
        # qui afficherait sinon le même message trompeur que "aucun
        # profil actif sur les sAutoniax" (qui n'a pas de sens hors mode
        # réseau). Message explicite prioritaire dans ce cas précis
        # seulement -- le panneau reste visible, rien d'autre ne change.
        message_indisponible = ""
        if task.mode_execution != "reseau" and self.client_reseau is None:
            message_indisponible = (
                "Dashboard réseau indisponible -- module websockets manquant, "
                "exécution clone locale impossible."
            )
        elif (
            task.mode_execution != "reseau"
            and not self._premiere_liste_instances_recue
            and not etat.profils
        ):
            # AJOUT (SPEC_mode_clone_local.md section 5 point 4) : la
            # connexion websocket locale est en cours d'établissement
            # (quasi instantané en pratique, cf. spec, mais pas garanti à
            # 0ms) -- distingue ce cas transitoire d'un état stable "zéro
            # profil actif", pour ne pas laisser croire à tort qu'aucune
            # instance n'existe. `not etat.profils` en plus du flag : si
            # des profils sont déjà connus (ex. Task rouvert après un
            # premier passage qui avait déjà peuplé etat.profils), il n'y
            # a rien de trompeur à afficher tel quel, même avant un
            # nouveau instances_list pour CE Task précis.
            message_indisponible = "(chargement...)"
        self.panneau_clone.rafraichir_liste(
            etat.profils, etat.sequence_en_cours, etat.profil_actif,
            id_executant_par_profil=dict(self._id_executant_par_profil_clone),
            noms_par_id_executant=noms_par_id_executant,
            lot_deja_lance=etat.horodatage_lancement_lot is not None,
            message_indisponible=message_indisponible,
        )

    # --- 4.5 Arrêt global ---

    def _sur_demande_arreter_clones(self):
        """CORRECTIF (retour utilisateur explicite : "ce bouton est censé
        arrêter une exécution en cours et non tout") -- ce bouton
        n'arrête désormais QUE les profils COCHÉS dont le statut est
        RÉELLEMENT "en_cours" au moment du clic (cellule en train de
        s'exécuter). Les profils cochés encore "en_attente" (pas encore
        démarrés, simplement en file) ne sont PLUS touchés : ils
        continuent d'attendre leur tour normalement, exactement comme si
        ce bouton n'avait jamais été cliqué pour eux. Les profils NON
        cochés ne sont jamais concernés, qu'ils tournent ou non --
        cohérent avec le reste du panneau (nb_coches, lancement,
        _verifier_fin_sequence_clone...), qui raisonne toujours en
        "profils cochés" comme périmètre de l'action groupée.

        AVANT ce correctif, cette méthode arrêtait INCONDITIONNELLEMENT
        tout profil "en_attente" OU "en_cours", coché ou non, et forçait
        sequence_en_cours=False -- un seul clic arrêtait donc la totalité
        du lot plutôt que la ou les cellules réellement en train de
        tourner. C'était un choix documenté à l'origine (cf. historique
        git : "un seul bouton Arrêter global, pas d'arrêt individuel par
        profil"), mais ne correspond plus au comportement attendu."""
        task = self._task_courant_obj()
        if task is None:
            return
        etat = self._executions_clone.get(task.id)
        if etat is None:
            return
        profil_actif_arrete = False
        for nom_profil_boucle, profil_etat in etat.profils.items():
            if not profil_etat.coche:
                continue  # non coché -- jamais concerné par cette action groupée
            if profil_etat.statut != "en_cours":
                continue  # "en_attente" (ou tout autre statut) -- laissé intact, continue son tour normalement
            # Même sémantique que l'arrêt du run normal (cf. docstring de
            # MoteurExecutionCelluleReseau.arreter/MoteurExecutionCellule.
            # arreter) : détachement côté UI seulement, la cellule
            # continue de tourner (côté sAutoniax en réseau, ou dans le
            # thread daemon abandonné en local) jusqu'à sa fin naturelle.
            # _detacher_moteur_courant_profil gère les deux types de
            # moteur indifféremment (cf. sa docstring).
            self._detacher_moteur_courant_profil(profil_etat)
            profil_etat.statut = "arrete"
            profil_etat.cellule_courante_id = None
            if nom_profil_boucle == etat.profil_actif:
                profil_actif_arrete = True
        # CORRECTIF (cf. docstring ci-dessus) : sequence_en_cours n'est
        # PLUS forcée à False inconditionnellement ici -- des profils
        # cochés "en_attente" (jamais touchés par la boucle ci-dessus)
        # peuvent très bien encore devoir démarrer après ce clic, et un
        # profil non coché peut être en train de tourner. Délégué à
        # _verifier_fin_sequence_clone (même fonction que celle qui
        # referme déjà la séquence au fil des transitions individuelles,
        # cf. sa docstring) : elle-même se charge de constater si plus
        # AUCUN profil coché ne reste en_attente/en_cours et, seulement
        # dans ce cas, de poser sequence_en_cours=False et horodatage_
        # fin_lot -- exactement le même critère que partout ailleurs dans
        # ce panneau, plutôt qu'un court-circuit local dupliqué ici.
        self._verifier_fin_sequence_clone(task, etat)
        # CORRECTIF (spec B.1) -- cf. docstring de _rafraichir_apres_
        # transition_clone. profil_actif_arrete détermine déjà exactement
        # si etat.profil_actif fait partie des profils qu'on vient
        # d'arrêter -- réutilisé tel quel plutôt que de refaire le test
        # etat.profil_actif == nom_profil dans la fonction groupée (qui ne
        # serait pas pertinent ici : plusieurs profils peuvent être
        # arrêtés d'un coup, alors que _rafraichir_apres_transition_clone
        # est pensée pour un seul nom_profil à la fois).
        self._rafraichir_panneau_clone_si_ouvert(task, etat)
        if profil_actif_arrete:
            self._rafraichir_bouton_global()

    # --- Lancement / arrêt INDIVIDUEL par ligne (bouton unique de
    # _construire_widget_actions_profil, section 4.5 de la spec) --
    # créés par ce patch : la spec les référence comme "déjà
    # implémentées et correctes" mais ils étaient absents du fichier
    # avant ce changement. Factorisent la même mécanique que le lot
    # (_sur_demande_lancer_clones / _sur_demande_arreter_clones)
    # ci-dessus, réduits à un seul nom_profil.

    def _sur_demande_lancer_clone_profil_local(self, task: "Task", cle_profil: str):
        """BUGFIX (relecture complète de la chaîne mode local) : symétrique
        LOCAL de _sur_demande_lancer_clone_profil (réseau) ci-dessous, sur
        le modèle exact de _sur_demande_lancer_clones_local (lot) réduit à
        un seul profil -- cf. docstring de _sur_demande_lancer_clone_profil
        pour le contexte complet du bug corrigé (ce bouton individuel ne
        faisait rien en mode local avant ce correctif).

        Mêmes garde-fous que la version réseau, sauf self._client_serveur_t
        (sans objet en local, cf. self._client_reseau_execution à la
        place) et la résolution de sAutoniax d'origine, remplacée par
        self._instance_id_par_profil_local (même source que la version en
        lot)."""
        etat = self._executions_clone.setdefault(task.id, ExecutionCloneEtat())
        profil_etat = etat.profils.get(cle_profil)
        if profil_etat is not None and profil_etat.statut in ("en_attente", "en_cours"):
            return  # déjà en cours pour ce profil précis -- rien à faire
        if self._sequence_active or self._moteurs_en_cours:
            self._notify_status(
                "Le notebook principal est déjà en cours d'exécution -- attendez sa fin avant de lancer un profil.",
                error=True,
            )
            return
        if self._client_reseau_execution is None:
            self._notify_status(
                "Réseau indisponible (module 'websockets' manquant) -- exécution impossible.",
                error=True,
            )
            return
        nom_profil = _nom_depuis_cle_profil_clone(cle_profil)
        instance_id = self._instance_id_par_profil_local.get(nom_profil, "")
        if not instance_id:
            self._notify_status(
                f"Aucune instance locale active pour « {nom_profil} » -- rafraîchissez la liste.",
                error=True,
            )
            return

        if profil_etat is None:
            profil_etat = CloneProfilEtat(nom_profil=nom_profil)
            etat.profils[cle_profil] = profil_etat
        profil_etat.coche = True
        profil_etat.id_executant_sautoniax = ID_EXECUTANT_LOCAL
        profil_etat.instance_id = instance_id
        if not etat.sequence_en_cours:
            etat.horodatage_lancement_lot = time.time()
            etat.horodatage_fin_lot = None

        sequence_cellules = self._construire_sequence_cellules_clone(task)
        if not sequence_cellules:
            self._notify_status("Aucune cellule active à exécuter.", error=True)
            return

        profil_etat.statut = "en_attente"
        profil_etat.reprise_apres_coupure = False      # PATCH H
        profil_etat.cellules_resultats = {}
        profil_etat.moteur_courant = None
        profil_etat.cellule_courante_id = None
        profil_etat.horodatage_debut = None
        profil_etat.horodatage_fin = None
        profil_etat.result_color = COULEUR_RESULT_COLOR_DEFAUT
        # Même correctif que la version en lot (cf. docstring détaillée de
        # _sur_demande_lancer_clones_local) : purge le namespace résiduel
        # d'un éventuel lancement précédent de ce même profil avant de
        # relancer, pour éviter toute contamination silencieuse par des
        # variables Python de la session précédente.
        self._namespaces_clone_locaux.pop(cle_profil, None)
        etat.sequence_en_cours = True
        self._vider_affichage_au_lancement_clones(etat, {cle_profil})   # PATCH : sortie vidée avant le lancement
        self._lancer_sequence_clone_profil_local(task, etat, cle_profil, instance_id, list(sequence_cellules))
        self._rafraichir_panneau_clone_si_ouvert(task, etat)
        if etat.profil_actif == cle_profil:
            self._rafraichir_bouton_global()

    def _sur_demande_lancer_clone_profil(self, cle_profil: str, ouvrir_rendu_reseau: bool = True):
        """Démarre la séquence pour CE profil seul, sans toucher aux
        autres profils déjà en cours ou déjà terminés -- garde-fous
        identiques à _sur_demande_lancer_clones (notebook principal pas
        en cours, réseau disponible, sAutoniax sélectionné), appliqués
        à un seul profil plutôt qu'à une liste.

        CORRECTIF (bug rapporté : "le run du TaskEditor est censé
        ouvrir le panneau de rendu au clic gauche, mais n'ouvre plus
        rien du tout, même au clic gauche") -- cause : ce chemin
        (lancement d'un profil ACTIF, cf. docstring de _sur_clic_
        bouton_executer_tout) ne comportait, avant ce patch, AUCUN
        appel à _sur_clic_voir_rendu_reseau, contrairement à _executer_
        toutes_cellules (chemin "sans profil"). L'ancien commentaire de
        _sur_clic_droit_bouton_executer_tout affirmait que "_lancer_
        sequence_clone_profil n'ouvre de toute façon jamais le panneau
        automatiquement" comme si c'était voulu -- en réalité c'était
        simplement l'ouverture automatique QUI MANQUAIT sur ce chemin,
        pour le clic gauche comme pour le clic droit : aucun des deux
        boutons n'ouvrait jamais rien dès qu'un profil était actif.
        Fix : paramètre ouvrir_rendu_reseau (True par défaut, clic
        gauche -- cf. _sur_clic_bouton_executer_tout), mis à False
        explicitement par _sur_clic_droit_bouton_executer_tout, exact
        pendant de ouvrir_rendu_reseau sur _executer_toutes_cellules.

        CORRECTIF (audit clé composite) : ce paramètre (cf. le signal
        PanneauExecutionClone.demande_lancer_clone_profil qui l'émet)
        est en réalité une CLÉ COMPOSITE (id_executant::nom_profil, cf.
        _cle_profil_clone), pas un nom nu -- renommé nom_profil ->
        cle_profil pour éviter toute confusion future ; le nom nu réel
        est extrait explicitement ci-dessous via _nom_depuis_cle_profil_
        clone partout où il est réellement nécessaire (message
        utilisateur, construction d'un nouveau CloneProfilEtat).

        BUGFIX (relecture complète de la chaîne mode local) : ce chemin
        ne comportait AUCUNE bifurcation locale -- la garde `task.mode_
        execution != "reseau"` juste en dessous provoquait un `return`
        silencieux pour tout Task en mode local, sans le moindre message
        d'erreur. Concrètement : le bouton ▶ individuel d'une ligne de
        profil (colonne Actions, section 4.5, construit inconditionnellement
        par _construire_widget_actions_profil quel que soit le mode) ne
        faisait RIEN au clic en mode local, contrairement au lancement en
        LOT (_sur_demande_lancer_clones) qui, lui, bifurque correctement
        vers _sur_demande_lancer_clones_local. Fix : bifurcation symétrique
        en tête de fonction, qui délègue à _lancer_sequence_clone_profil_
        local (au lieu de _lancer_sequence_clone_profil, réseau) avec le
        même instance_id que résout _sur_demande_lancer_clones_local
        (self._instance_id_par_profil_local), et sans jamais ouvrir le
        panneau de rendu réseau (ouvrir_rendu_reseau n'a aucun sens en
        local -- le navigateur est déjà visible localement, exactement le
        choix déjà fait par _sur_demande_lancer_clones_local qui n'appelle
        jamais _sur_clic_voir_rendu_reseau)."""
        task = self._task_courant_obj()
        if task is None or not cle_profil:
            return
        if task.mode_execution == "local":
            self._sur_demande_lancer_clone_profil_local(task, cle_profil)
            return
        if task.mode_execution != "reseau":
            return
        etat = self._executions_clone.setdefault(task.id, ExecutionCloneEtat())
        profil_etat = etat.profils.get(cle_profil)
        if profil_etat is not None and profil_etat.statut in ("en_attente", "en_cours"):
            return  # déjà en cours pour ce profil précis -- rien à faire
        if self._sequence_active or self._moteurs_en_cours:
            self._notify_status(
                "Le notebook principal est déjà en cours d'exécution -- attendez sa fin avant de lancer un profil.",
                error=True,
            )
            return
        if self._client_serveur_t is None:
            self._notify_status(
                "Réseau indisponible (module 'websockets' manquant) -- exécution impossible.",
                error=True,
            )
            return
        # REFONTE MULTI-SAUTONIAX -- id_executant vient désormais de
        # _id_executant_par_profil_clone (même source que _sur_demande_
        # lancer_clones, peuplée depuis la liste agrégée multi-sAutoniax,
        # cf. sur_profils_sautoniax_clone_recus), PAS du combo (qui ne
        # filtre plus le panneau clone, cf. docstring de PanneauExecution
        # Clone) : le sAutoniax de CE profil est le sien propre, pas celui
        # actuellement sélectionné dans le combo, qui peut très bien
        # pointer vers un sAutoniax différent de celui d'où vient ce
        # profil précis. Ce dict est indexé par CLÉ COMPOSITE (cf.
        # docstring de _sur_demande_capturer_tout), donc .get(cle_profil)
        # est correct ici.
        id_executant = self._id_executant_par_profil_clone.get(cle_profil, "")
        if not id_executant:
            self._notify_status(
                f"Aucun sAutoniax d'origine connu pour « {_nom_depuis_cle_profil_clone(cle_profil)} » -- "
                f"rafraîchissez la liste.",
                error=True,
            )
            return
        # Fige le sAutoniax de ce profil au lancement -- même principe
        # que l'ancien etat.id_executant_sautoniax unique (cf. docstring
        # de CloneProfilEtat.id_executant_sautoniax) : un changement de
        # connexion réseau en cours de route ne doit pas faire dévier CE
        # profil de son sAutoniax d'origine pour ce lancement individuel.
        if profil_etat is None:
            # BUGFIX (audit clé composite) : CloneProfilEtat.nom_profil
            # doit être le nom NU affichable (cf. sa docstring -- utilisé
            # tel quel par _lancer_sequence_clone_profil pour le réseau,
            # par _traiter_reception_capture_masse pour le nom de
            # fichier, et par la colonne 0 du tableau) -- passer cle_profil
            # brut ici aurait pollué ce champ avec la clé technique pour
            # tout profil encore jamais vu dans etat.profils (cas limite
            # réel : lancement individuel d'un profil tout juste apparu
            # dans la liste agrégée).
            profil_etat = CloneProfilEtat(nom_profil=_nom_depuis_cle_profil_clone(cle_profil))
            etat.profils[cle_profil] = profil_etat
        profil_etat.id_executant_sautoniax = id_executant
        # Fige la fenêtre du lot en cours si un lot tourne déjà (même
        # convention que _sur_demande_lancer_clones : horodatage_
        # lancement_lot n'est réécrit que si aucune séquence n'est déjà en
        # vol, pour ne jamais perdre le début des logs déjà en cours).
        if not etat.sequence_en_cours:
            # AJOUT (bouton "Copier les logs de cette exécution", cf.
            # docstring de ExecutionCloneEtat.horodatage_lancement_lot)
            # -- ce relancement individuel (un seul profil, cf. docstring
            # de fonction) ne redémarre la fenêtre du LOT que si aucun
            # lot n'était déjà en vol -- sinon (relance d'UN profil
            # pendant que d'autres profils du même lot tournent encore)
            # la fenêtre existante doit être préservée, sous peine de
            # perdre le début des logs des profils déjà en cours.
            etat.horodatage_lancement_lot = time.time()
            etat.horodatage_fin_lot = None

        sequence_cellules = self._construire_sequence_cellules_clone(task)
        if not sequence_cellules:
            self._notify_status("Aucune cellule active à exécuter.", error=True)
            return

        profil_etat.statut = "en_attente"
        profil_etat.reprise_apres_coupure = False      # PATCH H
        profil_etat.cellules_resultats = {}
        profil_etat.moteur_courant = None
        profil_etat.cellule_courante_id = None
        # CORRECTIF (bug rapporté : "après un clic sur Arrêter, au
        # prochain démarrage le compteur de temps ne s'est pas
        # réinitialisé") -- CAUSE : contrairement à _sur_demande_lancer_
        # clones (lancement en LOT, qui remet ces deux champs à None,
        # cf. son propre commentaire), ce chemin de lancement INDIVIDUEL
        # par bouton de ligne ne le faisait pas. profil_etat est le MÊME
        # objet réutilisé par référence d'une exécution à l'autre pour
        # une clé de profil déjà connue (cf. docstring de CloneProfilEtat.
        # horodatage_debut) -- sans ce reset, horodatage_debut restait
        # celui de l'exécution PRÉCÉDENTE (T0). Le garde-fou `if
        # profil_etat.horodatage_debut is None: ... = time.time()` de
        # _lancer_sequence_clone_profil (posé à l'envoi de la première
        # cellule) ne se déclenchait donc jamais -- le chrono affiché
        # repartait de T0 au lieu de zéro, incluant toute la durée où le
        # profil était resté arrêté entre les deux lancements. Même
        # raisonnement pour result_color (pastille de l'exécution
        # précédente sinon affichée à tort jusqu'à la fin du nouveau
        # lancement).
        profil_etat.horodatage_debut = None
        profil_etat.horodatage_fin = None
        profil_etat.result_color = COULEUR_RESULT_COLOR_DEFAUT
        etat.sequence_en_cours = True
        # Ouvre le panneau de rendu réseau AVANT le lancement réel, même
        # patron EXACT que _executer_toutes_cellules (cf. son propre
        # commentaire "ouvre directement ce panneau") -- placé ici,
        # après tous les garde-fous ci-dessus (statut déjà en cours,
        # séquence principale déjà active, réseau indisponible, aucun
        # sAutoniax sélectionné, aucune cellule active...), pour ne
        # jamais ouvrir le panneau si le lancement va de toute façon
        # être refusé.
        if ouvrir_rendu_reseau:
            if self._fenetre_rendu_reseau is not None:
                self._fenetre_rendu_reseau.panneau.effacer_terminal()
            self._sur_clic_voir_rendu_reseau()
        self._vider_affichage_au_lancement_clones(etat, {cle_profil})   # PATCH : sortie vidée avant le lancement
        self._lancer_sequence_clone_profil(task, etat, cle_profil, list(sequence_cellules))
        self._rafraichir_panneau_clone_si_ouvert(task, etat)
        # Section 6.2 : lancement individuel d'un profil qui se trouve
        # être le profil actif -- le bouton global doit le refléter tout
        # de suite. etat.profil_actif est lui aussi une clé composite
        # (cf. docstring ci-dessus), donc la comparaison directe est
        # correcte.
        if etat.profil_actif == cle_profil:
            self._rafraichir_bouton_global()

    def _sur_demande_arreter_clone_profil(self, cle_profil: str):
        """Arrête ce profil : détachement UI immédiat (cf. docstring de
        MoteurExecutionCelluleReseau.arreter -- ce détachement local ne
        garantit à lui seul aucun arrêt réel côté sAutoniax) ET, un VRAI
        arrêt réseau du CODE en cours envoyé en parallèle pour interrompre
        réellement l'exécution sur la machine distante -- laisse les
        autres profils en cours intacts. etat.sequence_en_cours ne
        repasse à False que si plus AUCUN profil coché n'est encore
        en_attente/en_cours (même critère que _verifier_fin_sequence_clone).

        REFONTE (Section 8 -- "Arrêter" interrompt le CODE, pas le
        profil, cf. PLAN_section_8_arreter.md) : cette fonction envoyait
        auparavant un VRAI KILL réseau (kill_profil, même mécanisme que
        le bouton "Kill" de l'onglet Instances), qui tue le sous-processus
        navigateur entier -- le profil disparaissait alors de la liste
        des profils actifs, ce qui n'est PAS le comportement voulu pour
        "Arrêter" (cf. docstring d'origine, déjà corrigée en amont de ce
        chantier -- seul le CODE ci-dessous a changé). Remplacé par
        arreter_execution_profil(id_executant, nom_profil) : ne termine
        QUE l'exécuteur de code du profil isolé visé côté sAutoniax (cf.
        _sur_arreter_execution_profil_demande), jamais le navigateur -- le
        profil reste actif et listé, une cellule suivante relance
        simplement un exécuteur neuf à la demande. Pour le VRAI kill
        complet (profil disparaît), cf. le bouton "Kill" séparé
        (_sur_demande_kill_clone_profil, section 9), volontairement NON
        modifié par ce chantier.

        id_executant et nom_profil nu sont extraits ici de la clé
        composite (cf. _id_executant_depuis_cle_profil_clone/_nom_depuis_
        cle_profil_clone), jamais la clé composite elle-même qui n'a
        aucun sens pour le sAutoniax (registre _instances_isolees côté
        sAutoniax est keyé par nom_profil nu, cf. son docstring).
        Fire-and-forget côté ClientServeurT.arreter_execution_profil
        (comme kill_projet/demander_demarrer_profil_isole) : le résultat
        réel arrive plus tard via arreter_execution_profil_resultat_
        reel_recu, connecté à sur_profil_isole_change_ailleurs (cf. sa
        docstring) qui rafraîchit automatiquement ce panneau -- aucun
        câblage supplémentaire nécessaire pour le rafraîchissement. Seul
        l'échec immédiat (non connecté au serveurT) est notifié ici
        explicitement, même patron que les autres appelants réseau.

        LIMITE CONNUE (cf. investigation _sautoniax_executer_notebook_
        distant_sur_instance_isolee) : avec l'exécuteur dans un process
        séparé (Section 8), terminate() interrompt fiablement TOUT code
        en cours (pur calcul CPU, sleep(), ou pilotage du navigateur),
        contrairement à l'ancienne limite qui ne s'appliquait qu'au
        VRAI KILL réseau ci-dessus (désormais réservée à "Kill", cf.
        docstring de _sur_demande_kill_clone_profil).

        CORRECTIF (audit clé composite) : paramètre renommé nom_profil
        -> cle_profil (cf. PanneauExecutionClone.demande_arreter_clone_
        profil, qui émet la CLÉ COMPOSITE id_executant::nom_profil, pas
        le nom nu) -- purement cosmétique ici, cette fonction ne
        consulte/compare jamais rien d'autre que etat.profils (indexé
        par clé composite) et etat.profil_actif (également une clé
        composite), donc aucune correction fonctionnelle nécessaire."""
        task = self._task_courant_obj()
        if task is None:
            return
        etat = self._executions_clone.get(task.id)
        if etat is None:
            return
        profil_etat = etat.profils.get(cle_profil)
        if profil_etat is None:
            return
        # CORRECTIF (cf. docstring de _detacher_moteur_courant_profil) :
        # retire aussi l'entrée du registre de routage clone si le moteur
        # est un moteur RÉSEAU -- sinon elle reste orpheline indéfiniment
        # si le sAutoniax ne répond jamais après cet arrêt manuel (le
        # résultat, s'il finit par arriver, serait de toute façon ignoré
        # par moteur.sur_resultat_recu puisque self._arrete est déjà True
        # à ce point, cf. sa docstring -- mais autant ne pas laisser
        # grossir ce dict pour rien). No-op propre pour un moteur LOCAL
        # (pas de _session_id, cf. sa docstring).
        self._detacher_moteur_courant_profil(profil_etat)
        # VRAI ARRÊT RÉSEAU DU CODE (Section 8, cf. docstring ci-dessus) --
        # envoyé indépendamment du détachement UI qui précède : même si
        # moteur_courant était déjà None ici (cas limite : le profil est
        # "en_attente", pas encore "en_cours", donc jamais eu de moteur --
        # ou le résultat réseau est déjà arrivé entre-temps), le
        # sAutoniax peut malgré tout avoir un exécuteur actif pour ce
        # nom_profil (ex. relance rapide) -- arreter_execution_profil est
        # de toute façon un no-op inoffensif côté sAutoniax si aucun
        # exécuteur n'est trouvé pour ce nom (cf. _sur_arreter_execution_
        # profil_demande, message d'échec propre ou ok=True selon le cas,
        # jamais d'exception).
        #
        # BUGFIX (relecture complète de la chaîne mode local) : la garde
        # `if id_executant and self._client_serveur_t is not None`
        # laissait passer un profil LOCAL (id_executant == "local", une
        # chaîne non vide donc vraie) dès que self._client_serveur_t
        # n'était pas None -- ce qui n'a AUCUN rapport avec le mode du
        # Task actuellement ouvert : self._client_serveur_t est injecté
        # une seule fois par MainWindow (cf. definir_client_reseau_t) et
        # reste vivant tant que le module 'websockets' est disponible et
        # qu'une connexion serveurT existe, INDÉPENDAMMENT du fait que CE
        # Task précis soit en mode local ou réseau. Résultat concret sans
        # ce correctif : sur un Task LOCAL, avec une connexion serveurT
        # par ailleurs active (ex. d'autres Tasks réseau ouverts), cliquer
        # sur "Arrêter" pour un profil local envoyait un VRAI message
        # réseau arreter_execution_profil("local", nom_profil) au serveurT
        # -- un aller-retour réseau inutile pour une action purement
        # locale, avec "local" comme id_executant qui ne correspond à
        # aucun sAutoniax réel (échec propre côté serveur, sans crash,
        # mais confus et hors de propos). Correctif : même garde que
        # _sur_demande_kill_clone_profil (cf. sa docstring), qui bifurque
        # déjà correctement sur ID_EXECUTANT_LOCAL -- pour un profil
        # local, le détachement UI ci-dessus suffit (rien à interrompre
        # côté réseau, cf. spec §3.8 : "Arrêter" en local ne fait que
        # détacher l'UI du thread daemon abandonné, jamais de vrai arrêt
        # réseau puisqu'il n'y en a pas).
        if _id_executant_depuis_cle_profil_clone(cle_profil) != ID_EXECUTANT_LOCAL:
            id_executant = _id_executant_depuis_cle_profil_clone(cle_profil)
            nom_profil_nu = profil_etat.nom_profil or _nom_depuis_cle_profil_clone(cle_profil)
            if id_executant and self._client_serveur_t is not None:
                self._client_serveur_t.arreter_execution_profil(id_executant, nom_profil_nu)
        etait_actif_et_en_cours = (
            cle_profil == etat.profil_actif and profil_etat.statut in ("en_attente", "en_cours")
        )
        if profil_etat.statut in ("en_attente", "en_cours"):
            profil_etat.statut = "arrete"
            profil_etat.cellule_courante_id = None
        self._verifier_fin_sequence_clone(task, etat)
        self._rafraichir_panneau_clone_si_ouvert(task, etat)
        # Section 6.2 : arrêt individuel d'un profil qui se trouve être
        # le profil actif -- le bouton global doit repasser à "Lancer"
        # tout de suite.
        if etait_actif_et_en_cours:
            self._rafraichir_bouton_global()

    def _sur_demande_kill_clone_profil(self, cle_profil: str):
        """AJOUT (SPEC_lot_corrections_2026-09.md section 9) : nouveau
        bouton "Kill" par ligne de profil -- reprend fidèlement l'ANCIEN
        comportement complet de "Arrêter" tel qu'il existait avant la
        refonte de la section 8 (cf. docstring de _sur_demande_arreter_
        clone_profil ci-dessus, qui documente ce même mécanisme en
        détail) : détachement UI immédiat du moteur d'exécution en cours
        PUIS kill réel (réseau : kill_profil sAutoniax ; local, AJOUT cf.
        SPEC_mode_clone_local.md section 3.9 : relais vers
        ProfilsInstancesScreen._arreter_instance_pour_profil, qui ferme
        le navigateur pour de vrai -- shutdown réseau propre + repli
        process direct). Le profil disparaît du registre actif -- même
        comportement que "Kill" dans l'onglet Instances
        (PanneauProprietesSautoniax), cf. section 9 : "Kill = comportement
        actuel de Arrêter".

        Distinct de _sur_demande_arreter_clone_profil (section 8) : Kill
        tue le profil entier peu importe son état ; Arrêter n'interrompt
        que le code utilisateur en cours et laisse le profil vivant. Les
        deux boutons peuvent donc être cliqués sur un même profil avec
        des effets réellement différents désormais.

        Code IDENTIQUE à l'ancien _sur_demande_arreter_clone_profil
        (avant section 8) -- dupliqué ici plutôt que factorisé pour que
        chaque handler reste lisible indépendamment et que la refonte de
        la section 8 (qui modifie EN PROFONDEUR _sur_demande_arreter_
        clone_profil) n'ait aucun risque d'affecter par ricochet le
        comportement de Kill, qui doit rester l'ancien mécanisme éprouvé
        tel quel."""
        task = self._task_courant_obj()
        if task is None:
            return
        etat = self._executions_clone.get(task.id)
        if etat is None:
            return
        profil_etat = etat.profils.get(cle_profil)
        if profil_etat is None:
            return
        # CORRECTIF (cf. docstring de _detacher_moteur_courant_profil) :
        # détachement UI du moteur en cours, réseau OU local indifféremment
        # (getattr sûr sur _session_id, absent pour un moteur local).
        self._detacher_moteur_courant_profil(profil_etat)
        # PATCH (mode local dans le panneau clone -- cf. SPEC_mode_clone_
        # local.md, section 3.9) : bifurcation réseau/local pour le VRAI
        # kill (fermeture du navigateur). Le détachement UI ci-dessus est
        # commun aux deux modes -- seule la suite diverge.
        if _id_executant_depuis_cle_profil_clone(cle_profil) == ID_EXECUTANT_LOCAL:
            nom_profil_nu = profil_etat.nom_profil or _nom_depuis_cle_profil_clone(cle_profil)
            self.demande_kill_profil_local.emit(nom_profil_nu)
        else:
            id_executant = _id_executant_depuis_cle_profil_clone(cle_profil)
            nom_profil_nu = profil_etat.nom_profil or _nom_depuis_cle_profil_clone(cle_profil)
            if id_executant and self._client_serveur_t is not None:
                self._client_serveur_t.kill_profil(id_executant, nom_profil_nu)
        etait_actif_et_en_cours = (
            cle_profil == etat.profil_actif and profil_etat.statut in ("en_attente", "en_cours")
        )
        if profil_etat.statut in ("en_attente", "en_cours"):
            profil_etat.statut = "arrete"
            profil_etat.cellule_courante_id = None
        self._verifier_fin_sequence_clone(task, etat)
        self._rafraichir_panneau_clone_si_ouvert(task, etat)
        if etait_actif_et_en_cours:
            self._rafraichir_bouton_global()

    def _sur_demande_premier_plan_clone_profil(self, cle_profil: str):
        """AJOUT (demande explicite utilisateur : clic droit sur un profil
        clone -> premier plan ponctuel du navigateur, "directement, je ne
        veux pas de menue" -- confirmé LOCAL SEULEMENT, pas de bifurcation
        réseau ici contrairement à _sur_demande_kill_clone_profil).

        Garde-fou explicite : un profil réseau (sAutoniax distant) est
        silencieusement ignoré -- rien dans l'UI n'empêche un clic droit
        sur une ligne réseau (le clic droit réagit à toute la table,
        même patron que _sur_clic_ligne_profil), donc ce garde-fou est le
        seul rempart. Pas de message d'erreur pour ce cas précis (contrairement
        à "aucune instance locale trouvée" plus bas) : un clic droit
        malheureux sur un profil réseau n'a rien de fautif ni d'inattendu
        pour l'utilisateur, pas besoin de le signaler comme une erreur.

        Mécanisme réseau : RÉUTILISE self._client_reseau_execution (le
        même client pilote partagé, stable, "un seul pilote logique" que
        MoteurExecutionCellule -- cf. sa docstring de classe), PLUTÔT que
        d'ouvrir un client jetable comme _fermer_instance_orpheline_
        bloquant. Nécessaire : une instance ne peut être liée qu'à UN
        SEUL pilote à la fois (cf. _lier_instance_si_besoin, verrou=True
        pendant toute cellule active) -- un second client pilote jetable
        se verrait refuser son link pendant qu'une séquence de cellules
        tourne sur ce profil, et la commande échouerait silencieusement.
        En réutilisant CE client (déjà celui qui détient le verrou s'il y
        a une exécution en cours, ou libre sinon), aucun conflit possible.

        Renvoie un link AVANT la commande, sur la même connexion, à
        chaque appel -- cf. docstring de _envoyer_commande_liee : "Un
        link redemandé alors qu'on l'a déjà reste SANS EFFET côté
        serveur ... sans erreur", donc toujours sûr d'en renvoyer un ici
        même si ce moteur a déjà la liaison via une cellule en cours (pas
        de verrou=True ici volontairement : ce lien ponctuel ne doit pas
        évincer un autre pilote légitime s'il y en avait un, simple
        pilotage best-effort pour une action purement visuelle).

        Fire-and-forget (pas de callback ni d'attente de command_result) :
        cohérent avec la nature de l'action ("juste pour que je le voir",
        aucun état à refléter dans l'UI en cas d'échec -- au pire, la
        fenêtre ne remonte pas, sans conséquence sur l'exécution en
        cours)."""
        if _id_executant_depuis_cle_profil_clone(cle_profil) != ID_EXECUTANT_LOCAL:
            return
        nom_profil = _nom_depuis_cle_profil_clone(cle_profil)
        instance_id = self._instance_id_par_profil_local.get(nom_profil, "")
        if not instance_id:
            self._notify_status(
                f"Aucune instance locale active pour « {nom_profil} » -- rafraîchissez la liste.",
                error=True,
            )
            return
        if self._client_reseau_execution is None:
            self._notify_status(
                "Réseau indisponible (module 'websockets' manquant) -- action impossible.",
                error=True,
            )
            return
        self._client_reseau_execution.envoyer_commande({
            "type": "link", "pilote_id": self._client_reseau_execution.id_client,
            "instance_id": instance_id,
        })
        self._client_reseau_execution.envoyer_commande({
            "type": "command", "instance_id": instance_id,
            "action": "bringToFront", "requete_id": uuid.uuid4().hex[:12],
        })

    # SUPPRIMÉ (SPEC_lot_corrections_2026-09.md section 2) : handler
    # _sur_demande_rafraichir_connexion_profil et le statut "deconnecte"
    # qui le motivait -- cf. _invalider_executions_clone_disparues, qui
    # retire désormais directement l'entrée du profil plutôt que de la
    # marquer et d'attendre une revérification manuelle.

    # --- 3.1 Point d'entrée unique pour changer le profil actif ---

    def _definir_profil_actif(self, task: "Task", nom_profil: Optional[str]):
        """Cf. section 3.1 de la spec. SEUL point d'entrée pour changer
        le profil actif -- lie automatiquement TOUS les ServiceAPI déjà
        importés du Task au nouveau profil (ou les délie tous si
        nom_profil est None). Remplace l'ancien duo _demande_import_
        service_api / _demande_liaison_instance (sélection instance par
        instance) par une seule action globale par Task."""
        etat = self._executions_clone.setdefault(task.id, ExecutionCloneEtat())
        ancien_profil = etat.profil_actif
        log_cellule.debug(
            f"[BADGE-TRACE][_definir_profil_actif] ENTRÉE -- task.id={task.id!r} "
            f"ancien_profil={ancien_profil!r} -> nouveau_profil={nom_profil!r} "
            f"etat_id={id(etat)}"
        )

        # CORRECTIF (bug réel : changer de profil actif -- ou désélectionner
        # -- pendant que le mode "Automatique" de _fenetre_rendu_reseau était
        # coché laissait le streaming continu tourner INDÉFINIMENT sur
        # l'ANCIEN profil, cf. logs réels "-> envoyer_capture" répétés toutes
        # les ~10s pour chaque instance clone, même après changement de
        # sélection ou fermeture du panneau. Cause : _sur_taux_capture_
        # reseau_change (cf. sa docstring) cible toujours l'instance
        # COURANTE via _cible_rendu_reseau_actuelle() au moment de l'envoi,
        # mais RIEN ne redemande explicitement la désactivation sur
        # l'ANCIENNE instance quand la cible change sous ses pieds -- ce
        # point d'entrée (_definir_profil_actif, "SEUL point d'entrée pour
        # changer le profil actif", cf. docstring) est donc le bon endroit
        # pour couper le flux avant tout changement de cible, quelle que
        # soit l'action utilisateur qui l'a déclenché (clic sur une autre
        # ligne, désélection, arrêt du profil). PAS de réactivation du mode
        # auto sur le nouveau profil ici : uniquement une coupure explicite
        # de l'ancien, pour ne jamais rallumer un flux sans demande
        # explicite de l'utilisateur (cf. _appliquer_etat_streaming, jamais
        # appelée ici intentionnellement).
        if (
            ancien_profil is not None
            and ancien_profil != nom_profil
            and self._client_serveur_t is not None
        ):
            ancien_profil_etat = etat.profils.get(ancien_profil)
            ancien_instance_id = ancien_profil_etat.instance_id if ancien_profil_etat is not None else ""
            # REFONTE MULTI-SAUTONIAX -- id_executant DE CE PROFIL précis
            # (ancien_profil_etat.id_executant_sautoniax), pas l'ancien
            # champ de lot etat.id_executant_sautoniax (retiré) : cibler
            # le mauvais sAutoniax couperait le flux d'une instance sans
            # rapport (ou ne couperait rien du tout côté serveur) si
            # ancien_profil vient d'un sAutoniax différent des autres
            # profils de ce même lot. PATCH retrait combo_executant_
            # reseau -- l'ancien repli sur combo_executant_reseau.
            # currentData() est retiré (plus de combo) : sans id_
            # executant_sautoniax connu sur le profil lui-même, il n'y a
            # plus de source de repli pertinente, id_executant_cible
            # reste simplement vide et la coupure est no-op (rien de
            # pire que l'ancien comportement si le combo n'était de
            # toute façon pas aligné sur ce profil précis).
            id_executant_cible = ancien_profil_etat.id_executant_sautoniax if ancien_profil_etat is not None else ""
            if ancien_instance_id and id_executant_cible:
                self._client_serveur_t.definir_taux_capture_instance(id_executant_cible, ancien_instance_id, 0.0)

        # Garde d'occupation (point 4) : refuse si l'ANCIEN profil actif
        # est occupé par une cellule de CE Task en cours d'exécution --
        # étendue à TOUTES les clés de services_api_importes (pas une
        # seule instance comme l'ancienne _demande_liaison_instance),
        # puisque le changement de profil actif les touche toutes d'un
        # coup. On s'arrête au premier ServiceAPI occupé trouvé.
        if ancien_profil is not None:
            for nom_service, instance_liee in task.services_api_importes.items():
                if not instance_liee:
                    continue
                occupation = self._instances_occupees_par_nos_tasks.get(instance_liee)
                if occupation is not None and occupation[0] == task.id:
                    log_cellule.debug(
                        f"[BADGE-TRACE][_definir_profil_actif] ABANDON (garde d'occupation) -- "
                        f"nom_service={nom_service!r} instance_liee={instance_liee!r} -- "
                        f"changement REFUSÉ, etat.profil_actif RESTE {ancien_profil!r} "
                        f"(demandé : {nom_profil!r})"
                    )
                    self._notify_status(
                        f"« {nom_service} » est en cours d'utilisation par une cellule en exécution -- "
                        f"attendez la fin avant de changer de profil.",
                        error=True,
                    )
                    return

        # PATCH (SPEC_mode_clone_local.md section 3.10, incohérence
        # corrigée) : task.services_api_importes a une convention DIFFÉRENTE
        # selon le mode (cf. docstring de Task.services_api_importes) --
        # en réseau, chaque valeur est la clé composite `cle_profil`
        # (id_executant::nom_profil, résolue par MoteurExecutionCelluleReseau
        # via id_executant/profil_nom) ; en local, MoteurExecutionCellule
        # (cf. son __init__, `task.services_api_importes[nom]` lu DIRECTEMENT
        # comme un instance_id nodriver classique -- comportement historique
        # inchangé, aucune notion de clé composite ni de "profil" côté ce
        # moteur) attend un instance_id BRUT. Stocker `nom_profil` (qui est
        # en réalité `cle_profil`, cf. _sur_demande_definir_profil_actif,
        # `self.demande_definir_profil_actif.emit(cle_profil)`) tel quel en
        # mode local casserait _executer_cellule/MoteurExecutionCellule dès
        # la cellule suivante (instance_id invalide, la classe tenterait de
        # `link` une instance nommée "local::iaX1", qui n'existe pas côté
        # serveur). Bifurcation nécessaire ici, seul point d'entrée qui
        # écrit dans task.services_api_importes pour le profil actif.
        est_local = task.mode_execution != "reseau"
        if nom_profil is None:
            # Désélection (section 1 point 11) : garder les CLÉS, vider
            # seulement la liaison d'instance de chacune.
            for nom_service in task.services_api_importes:
                task.services_api_importes[nom_service] = ""
            etat.profil_actif = None
            log_reseau_t.info("[DIAG profil_actif] désélectionné -- etat.profil_actif=None")
        else:
            profil_etat_cible = etat.profils.get(nom_profil)
            if est_local:
                # AJOUT (section 3.10) : instance_id brut, jamais la clé
                # composite -- profil_etat_cible.instance_id est déjà
                # peuplé par _rafraichir_agregat_profils_clone_local avant
                # qu'un profil local puisse être cliqué dans le panneau.
                valeur_a_stocker = profil_etat_cible.instance_id if profil_etat_cible is not None else ""
                if profil_etat_cible is not None and not valeur_a_stocker:
                    log_cellule.warning(
                        f"[BADGE-TRACE][_definir_profil_actif] profil local {nom_profil!r} "
                        f"sélectionné SANS instance_id connu -- _executer_cellule échouera "
                        f"tant que ce profil n'aura pas d'instance_id résolu (ServiceAPINonLieError)."
                    )
            else:
                valeur_a_stocker = nom_profil
            for nom_service in task.services_api_importes:
                task.services_api_importes[nom_service] = valeur_a_stocker
            etat.profil_actif = nom_profil
            log_reseau_t.info(
                f"[DIAG profil_actif] nom_profil={nom_profil!r} devient actif (mode="
                f"{'local' if est_local else 'reseau'!r}) -- valeur stockée dans "
                f"services_api_importes={valeur_a_stocker!r} -- "
                f"instance_id du profil={profil_etat_cible.instance_id if profil_etat_cible else '<PROFIL INTROUVABLE DANS etat.profils>'!r} "
                f"id_executant_sautoniax stocké={profil_etat_cible.id_executant_sautoniax if profil_etat_cible else '?'!r}"
            )

        self.project.save()
        self.panneau_composants.rafraichir(task)
        self._rafraichir_composants_connus_editeur(task)
        self._rafraichir_variables_globales_editeur(task)
        carte = self._task_cartes.get(task.id)
        if carte is not None:
            carte.rafraichir(task)
        self._rafraichir_panneau_clone_si_ouvert(task, etat)
        # BUGFIX (retour utilisateur : "lorsque je vais sélectionner une
        # autre ligne ça va réinjecter ses propres sorties" -- attendu,
        # pas encore fait) -- jusqu'ici, changer de profil actif ne
        # touchait QUE le panneau de statuts (ligne au-dessus) ; les
        # widgets de cellule du notebook gardaient l'affichage de
        # l'ANCIEN profil actif (ou restaient vides) au lieu de basculer
        # sur les sorties déjà connues du NOUVEAU profil actif.
        #
        # Pour CHAQUE cellule où ce profil a déjà un résultat connu (cf.
        # CloneProfilEtat.cellules_resultats, peuplé par _callback_
        # termine de _lancer_sequence_clone_profil) : réaffiche ce
        # résultat. Deux cas :
        #   - cellule PAS ENCORE terminée (moteur_courant vivant pour
        #     cette cellule précise) : texte pur d'abord (afficher_
        #     resultat), puis l'image live par-dessus via _reafficher_
        #     image_si_presente (lit moteur._sortie_accumulee).
        #   - cellule DÉJÀ terminée (moteur disparu) : le texte pur
        #     (afficher_resultat) SUFFISAIT plus à couvrir l'image --
        #     cf. TaskCellule.derniere_image_b64, rempli par _callback_
        #     termine avant que moteur_courant ne soit remis à None.
        #     Reconstruction directe du HTML texte+image via la fonction
        #     libre _composer_sortie_affichage_html (extraite de
        #     MoteurExecutionCelluleReseau._construire_sortie_affichage
        #     pour ce cas précis, cf. sa docstring).
        if nom_profil:
            nouveau_profil_etat = etat.profils.get(nom_profil)
            if nouveau_profil_etat is not None:
                cellules_couvertes = set()
                for cid, cellule_resultat in nouveau_profil_etat.cellules_resultats.items():
                    cellules_couvertes.add(cid)
                    widget = self._cellule_widgets.get(cid)
                    if widget is None:
                        continue
                    widget.afficher_resultat(cellule_resultat)
                    moteur_en_cours = nouveau_profil_etat.moteur_courant
                    if moteur_en_cours is not None and moteur_en_cours.cellule_id == cid:
                        self._reafficher_image_si_presente(widget, moteur_en_cours)
                    elif cellule_resultat.derniere_image_b64:
                        _entrees = []
                        if cellule_resultat.sortie:
                            _entrees.append(cellule_resultat.sortie)
                        _entrees.append(("image", cellule_resultat.derniere_image_b64))
                        widget.zone_sortie.setText(_composer_sortie_affichage_html(_entrees))
                        if not widget.bouton_replier.isChecked():
                            widget.zone_sortie.show()
                            widget.entete_sortie.show()
                # CORRECTIF (bug rapporté : "lorsque je vais sélectionner
                # une autre ligne ça va réinjecter ses propres sorties" --
                # partiellement fait ci-dessus, MAIS seules les cellules où
                # le NOUVEAU profil a déjà un résultat connu (cellules_
                # resultats, peuplé uniquement à la fin d'une exécution,
                # cf. _callback_termine) étaient traitées. Toute cellule
                # SANS résultat connu pour ce profil gardait donc
                # l'affichage laissé par l'ANCIEN profil actif (ex :
                # sélectionner iaX9, qui n'a encore rien produit sur cette
                # cellule, laissait voir la sortie de iaX1 précédemment
                # actif) -- symptôme distinct du cas déjà couvert plus
                # haut, jamais traité jusqu'ici.
                #
                # Un moteur_courant vivant POUR CE PROFIL sur cette cellule
                # précise (exécution en cours, pas encore de résultat
                # final) est exclu de ce vidage : vérifié séparément
                # (sur_log_execution_reseau_recu, branche clone) qu'aucun
                # mécanisme ne pousse le texte streamé en direct vers ce
                # widget pour un profil clone -- seules les images le font,
                # via un chemin déjà gardé par etat.profil_actif
                # (sur_image_execution_reseau_recu) qui se chargera de la
                # réafficher normalement dès qu'une image arrive pour ce
                # profil désormais actif. Vider ici n'efface donc rien qui
                # serait autrement rafraîchi en live -- mais on laisse
                # quand même cette cellule intacte plutôt que de la vider
                # puis rester dans le flou sur l'état bouton/spin d'une
                # exécution réellement en cours, qu'on ne touche jamais
                # depuis ce point d'entrée.
                moteur_en_cours_global = nouveau_profil_etat.moteur_courant
                cellule_en_cours_id = (
                    moteur_en_cours_global.cellule_id if moteur_en_cours_global is not None else None
                )
                for cid, widget in self._cellule_widgets.items():
                    if cid in cellules_couvertes:
                        continue
                    if cid == cellule_en_cours_id:
                        # CORRECTIF (trou découvert le 2026-XX-XX) : le
                        # `continue` silencieux d'origine laissait
                        # l'affichage de l'ANCIEN profil (ex : iaX1,
                        # terminé) visible tant qu'aucune nouvelle image
                        # n'était encore arrivée pour le NOUVEAU profil
                        # en cours sur cette même cellule (cf. logs :
                        # jusqu'à 24s d'écart entre le clic et la
                        # première image du nouveau profil). On vide
                        # d'abord l'ancien affichage résiduel, puis on
                        # tente un réaffichage live immédiat si ce
                        # nouveau profil a déjà accumulé quelque chose
                        # (moteur._sortie_accumulee) pour cette cellule.
                        widget.zone_sortie.clear()
                        widget.zone_sortie.hide()
                        widget.entete_sortie.hide()
                        widget.label_indicateur.setText("[ ]")
                        widget.label_indicateur.setStyleSheet(f"color: {Mocha.subtext0};")
                        if moteur_en_cours_global is not None:
                            self._reafficher_image_si_presente(widget, moteur_en_cours_global)
                        continue
                    widget.zone_sortie.clear()
                    widget.zone_sortie.hide()
                    widget.entete_sortie.hide()
                    widget.label_indicateur.setText("[ ]")
                    widget.label_indicateur.setStyleSheet(f"color: {Mocha.subtext0};")
        # AJOUT (demande explicite utilisateur : "rassure-toi que quand
        # je clique sur un profil clone dans le panneau de clone ça
        # affiche bien la valeur à jour de la variable workspace pour ce
        # profil") -- C'EST ICI le point d'entrée de ce besoin : ce clic
        # est le SEUL moment où le profil actif change (cf. docstring de
        # cette méthode, "SEUL point d'entrée pour changer le profil
        # actif"), donc le seul moment où la valeur WORKSPACE à afficher
        # change du fait de l'utilisateur.
        #
        # Volontairement APRÈS la boucle de réaffichage des résultats
        # ci-dessus, et volontairement PAS fondu dedans : cette boucle ne
        # traite que les cellules ayant un résultat CONNU pour ce profil
        # (cellules_resultats, peuplé seulement en fin d'exécution), et
        # n'appelle qu'afficher_resultat, qui ne touche JAMAIS l'éditeur
        # (uniquement l'indicateur [n], la couleur et la zone de sortie).
        # Un profil jamais lancé doit malgré tout afficher son
        # attribution dès le clic -- d'où un appel inconditionnel ici,
        # couvrant aussi bien nom_profil renseigné (affiche l'attribution
        # de ce profil) que None (restaure le vrai code source).
        self._rafraichir_affichage_workspace_cellule_variables(task, etat)

        # Section 6.2 : le bouton global doit refléter le statut du
        # nouveau profil actif (ou revenir au comportement "sans
        # profil" si nom_profil est None) dès que le profil change.
        _profil_etat_pour_trace = etat.profils.get(nom_profil) if nom_profil else None
        log_cellule.debug(
            f"[BADGE-TRACE][_definir_profil_actif] AVANT appel _rafraichir_bouton_global() -- "
            f"etat.profil_actif (écrit)={etat.profil_actif!r} "
            f"profil_etat.statut={(_profil_etat_pour_trace.statut if _profil_etat_pour_trace is not None else 'PROFIL_ETAT_INTROUVABLE_DANS_etat.profils')!r} "
            f"clés_connues_etat.profils={list(etat.profils.keys())!r}"
        )
        self._rafraichir_bouton_global()
        log_cellule.debug(
            "[BADGE-TRACE][_definir_profil_actif] APRÈS _rafraichir_bouton_global() -- SORTIE de _definir_profil_actif"
        )
        # PATCH (retrait de combo_executant_reseau) -- le changement de
        # profil actif est désormais le SEUL déclencheur du sAutoniax
        # "courant" pour ce Task (statut réseau, liste de profils
        # cloud, titre/image du panneau de rendu réseau) : reprend ici
        # ce que l'ancien _sur_changement_executant_reseau faisait au
        # changement de combo, cf. docstring de
        # _rafraichir_apres_changement_executant_actif.
        self._rafraichir_apres_changement_executant_actif(task)
        if nom_profil:
            # CORRECTIF (audit clé composite) : le paramètre nom_profil de
            # cette fonction est en réalité une CLÉ COMPOSITE (id_executant
            # ::nom_profil, cf. _cle_profil_clone -- transportée telle
            # quelle depuis les signaux du panneau, cf. _sur_demande_
            # definir_profil_actif ci-dessous) -- l'afficher tel quel
            # montrerait la clé technique brute au lieu du nom lisible.
            self._notify_status(
                f"Profil actif : « {_nom_depuis_cle_profil_clone(nom_profil)} » -- "
                f"tous les ServiceAPI importés y sont désormais liés."
            )
        else:
            self._notify_status(f"Aucun profil actif -- liaisons des ServiceAPI de « {task.nom} » retirées.")

    def _sur_demande_definir_profil_actif(self, nom_profil: str):
        """Cf. section 4.3 -- handler du signal PanneauExecutionClone.
        demande_definir_profil_actif (clic sur une ligne, hors
        checkbox). Chaîne vide = désélection (bascule si la ligne
        cliquée est déjà celle du profil actif)."""
        log_cellule.debug(
            f"[BADGE-TRACE][_sur_demande_definir_profil_actif] CLIC UTILISATEUR REÇU -- "
            f"nom_profil(brut, signal Qt)={nom_profil!r}"
        )
        task = self._task_courant_obj()
        if task is None:
            log_cellule.debug(
                "[BADGE-TRACE][_sur_demande_definir_profil_actif] ABANDON -- "
                "_task_courant_obj() a retourné None (aucun Task affiché ?)"
            )
            return
        self._definir_profil_actif(task, nom_profil or None)

    # --- 5. Capture en masse ("Capturer tout") ---

    def _sur_demande_capturer_tout(self):
        """Cf. section 5.1 de la spec. Cible les clones COCHÉS dans la
        liste des profils, avec un instance_id connu -- le profil
        principal n'est pas inclus ici en v1 (aucune checkbox "Inclure
        le profil principal" ajoutée au panneau pour cette première
        itération -- extension simple à ajouter plus tard si le besoin
        se confirme, cf. section 5.1 : "à confirmer avec l'utilisateur").

        CORRECTIF (bug signalé explicitement par l'utilisateur : "la
        capture dimage des profils clone capture toujours tout les
        profils meme quand on coche uniquement quelque uns dans la
        liste des profils") -- cibles se limitait avant à `if
        p.instance_id`, sans jamais regarder `p.coche` : TOUS les clones
        avec une instance active étaient donc capturés, peu importe
        l'état des cases à cocher de la liste (CloneProfilEtat.coche,
        déjà utilisé par ailleurs pour lancer/arrêter en masse -- cf.
        _sur_clic_lancer_clones pour le même patron `if etat_profil.
        coche`). Corrigé en ajoutant ce même filtre ici : le nom
        "Capturer tout" reste inchangé (il capture tout ce qui est
        coché, comme les autres actions de masse du panneau), mais son
        comportement est désormais cohérent avec elles."""
        task = self._task_courant_obj()
        if task is None:
            return
        etat = self._executions_clone.get(task.id)
        if etat is None:
            return
        # PATCH (mode local -- cf. SPEC_mode_clone_local.md section 2.4) :
        # protocole ENTIÈREMENT différent (pas de _client_serveur_t, pas
        # de sAutoniax distant à qui demander une capture "libre" -- une
        # instance locale n'accepte qu'UN SEUL pilote exclusif à la fois,
        # cf. docstring de _sur_demande_capturer_tout_local pour le détail
        # de la contrainte). Bifurcation en tête, comme _sur_demande_
        # lancer_clones/_definir_profil_actif.
        if task.mode_execution != "reseau":
            self._sur_demande_capturer_tout_local(task, etat)
            return
        # REFONTE MULTI-SAUTONIAX -- chaque profil coché porte désormais
        # SON PROPRE (id_executant, instance_id), résolu via _resoudre_id_
        # executant_profil (même repli que le panneau -- id_executant_
        # sautoniax figé si déjà lancé, sinon _id_executant_par_profil_
        # clone) : une capture en masse peut désormais mélanger des
        # profils venant de PLUSIEURS sAutoniax, donc un seul id_executant
        # pour tout le batch (ancien comportement) enverrait la commande
        # au mauvais sAutoniax pour les profils qui n'y sont pas -- échec
        # silencieux (instance_id inconnu de ce sAutoniax) ou pire une
        # collision d'instance_id entre deux sAutoniax distincts.
        cibles = {
            cle: (
                p.id_executant_sautoniax or self._id_executant_par_profil_clone.get(cle, ""),
                p.instance_id,
            )
            for cle, p in etat.profils.items() if p.instance_id and p.coche
        }
        cibles = {cle: paire for cle, paire in cibles.items() if paire[0]}
        if not cibles:
            self._notify_status(
                "Aucune instance clone cochée et active à capturer.", error=True
            )
            return
        horodatage = datetime.now().isoformat()
        id_batch = horodatage.replace(":", "-")
        # PATCH (demande explicite utilisateur : "je veux que le noms des
        # images on un prefice aleatoire, pas aleatoire pour chque image,
        # mais pour chque goupe de capture, cest pour que les image ne
        # secrasse pas si je veux stoker plusier groupe de capture") --
        # un seul préfixe généré ICI, une fois par batch (PAS dans la
        # boucle de sauvegarde ci-dessous, cf. _traiter_reception_capture_
        # masse) : toutes les images de CE groupe de capture partagent le
        # même préfixe, mais deux groupes différents ont chacun le leur.
        # Objectif explicite : pouvoir copier/regrouper les images de
        # plusieurs groupes dans un même dossier à plat (hors de la
        # structure dossier/<task>/<id_batch>/ existante) sans qu'un
        # iaX1.png d'un groupe n'écrase celui d'un autre groupe.
        prefixe_aleatoire_batch = uuid.uuid4().hex[:8]
        # REFONTE MULTI-SAUTONIAX -- clé (id_executant, instance_id) au
        # lieu de instance_id seul : deux instances sur deux sAutoniax
        # DIFFÉRENTS pourraient en théorie partager le même instance_id
        # (aucune garantie d'unicité cross-sAutoniax dans le protocole),
        # ce qui écraserait silencieusement une entrée par l'autre si la
        # clé ne portait que instance_id.
        # BUGFIX (audit clé composite) : `cibles` est indexé par CLÉ
        # COMPOSITE (id_executant::nom_profil -- `nom`/`cle` ci-dessus
        # vient de etat.profils.items(), lui-même keyé par clé composite,
        # cf. docstring de _reconstruire_agregat_profils_clone), pas par
        # nom nu. Stocker cette clé telle quelle dans cible_vers_profil
        # aurait fait remonter la clé technique brute jusque dans le nom
        # de FICHIER de la capture (cf. _traiter_reception_capture_masse,
        # nom_fichier = f"..._{_nom_dossier_valide(nom_profil)}.png") --
        # extraction explicite du nom nu affichable ici, une seule fois,
        # pour que le reste de la chaîne (déjà correcte) ne manipule plus
        # que ce nom nu sous l'étiquette "nom_profil".
        #
        # BUGFIX (rapport utilisateur : "on dirait que ça capture bien
        # tout, mais dans le dossier de sauvegarde je ne vois que la
        # moitié des images") -- le nom nu seul (ex. "iaX1") n'est PAS
        # garanti unique CROSS-sAutoniax : deux sAutoniax différents
        # peuvent chacun avoir un profil clone nommé "iaX1" (génération
        # de noms identique sur chaque sAutoniax, cf. ailleurs dans ce
        # fichier). Le compteur "reçues/total" reste correct (il compte
        # sur cle_cible = (id_executant, instance_id), unique par
        # instance), mais AVANT ce correctif le nom de fichier ne
        # dépendait que du nom nu -- deux profils homonymes de
        # sAutoniax distincts écrivaient donc dans le MÊME fichier sur
        # disque, le second écrasant le premier. D'où "compteur 10/10"
        # mais moitié moins de fichiers réellement présents si la
        # moitié des noms se chevauchent entre sAutoniax.
        #
        # Correctif : détecter, pour CE batch, les noms nus qui
        # apparaissent pour plus d'un id_executant distinct, et
        # désambiguïser UNIQUEMENT ceux-là en préfixant le nom du
        # sAutoniax d'origine (résolu via self._noms_executants_reseau,
        # déjà utilisé partout ailleurs pour l'affichage utilisateur).
        # Les noms déjà uniques (cas normal : un seul sAutoniax, ou
        # noms de profils qui ne se chevauchent pas) ne sont PAS
        # modifiés, pour ne rien changer au nommage de fichier existant
        # dans le cas courant.
        noms_nus_par_cible = {
            (id_exec, iid): _nom_depuis_cle_profil_clone(cle) for cle, (id_exec, iid) in cibles.items()
        }
        executants_par_nom_nu: dict[str, set[str]] = {}
        for (id_exec, _iid), nom_nu in noms_nus_par_cible.items():
            executants_par_nom_nu.setdefault(nom_nu, set()).add(id_exec)
        noms_en_collision = {nom for nom, executants in executants_par_nom_nu.items() if len(executants) > 1}
        # Filet de sécurité supplémentaire : si le nom AFFICHÉ du
        # sAutoniax (self._noms_executants_reseau) est lui-même identique
        # pour deux id_executant distincts en collision sur ce batch
        # (deux sAutoniax différents portant le même nom lisible -- cas
        # limite mais pas impossible), le préfixe par nom affiché ne
        # suffirait pas à lever l'ambiguïté. Dans ce cas seulement, on
        # utilise id_executant (l'identifiant technique, garanti unique)
        # en repli pour ce nom nu précis.
        noms_sautoniax_par_nom_nu: dict[str, set[str]] = {}
        for (id_exec, _iid), nom_nu in noms_nus_par_cible.items():
            if nom_nu in noms_en_collision:
                nom_affiche = self._noms_executants_reseau.get(id_exec, id_exec)
                noms_sautoniax_par_nom_nu.setdefault(nom_nu, set()).add(nom_affiche)
        cible_vers_profil = {}
        for (id_exec, iid), nom_nu in noms_nus_par_cible.items():
            if nom_nu in noms_en_collision:
                # Noms affichés distincts entre les sAutoniax en collision
                # pour ce nom_nu -> le nom affiché suffit à désambiguïser.
                # Noms affichés identiques (cas limite) -> repli sur
                # id_executant, seul identifiant garanti unique ici.
                if len(noms_sautoniax_par_nom_nu.get(nom_nu, ())) > 1:
                    prefixe_sautoniax = self._noms_executants_reseau.get(id_exec, id_exec)
                else:
                    prefixe_sautoniax = id_exec
                cible_vers_profil[(id_exec, iid)] = f"{prefixe_sautoniax}_{nom_nu}"
            else:
                cible_vers_profil[(id_exec, iid)] = nom_nu
        self._captures_masse_en_attente[id_batch] = {
            "task_nom": task.nom,
            "cible_vers_profil": cible_vers_profil,
            "recues": set(),
            "dossier": get_captures_clone_dir() / _nom_dossier_valide(task.nom or task.id) / id_batch,
            "prefixe": prefixe_aleatoire_batch,
        }
        for cle_profil, (id_executant, instance_id) in cibles.items():
            self.demande_capture_ponctuelle_instance_clone.emit(id_executant, instance_id)
        self._notify_status(f"Capture en cours... 0/{len(cibles)} reçue(s).")
        # Filet de sécurité (§5.2) : un profil qui ne répond jamais ne
        # doit pas bloquer indéfiniment le batch -- au bout de 120s,
        # termine le batch avec ce qui a été reçu jusque-là.
        # AJOUT (retour utilisateur : "cest trop lent , je veux meme un
        # timeout globla de 120") -- initialement 15000ms (15s), jugé
        # trop court : coupait le batch avant que des instances plus
        # lentes à répondre (charge réseau, sAutoniax chargé, etc.)
        # aient eu le temps de renvoyer leur capture. Ce délai ne
        # retarde QUE le cas d'échec (un profil qui ne répond jamais) --
        # cf. _traiter_reception_capture_masse ci-dessus, qui finalise
        # le batch dès que TOUTES les instances ciblées ont répondu,
        # sans attendre ce timeout dans le cas normal.
        QTimer.singleShot(120000, lambda: self._finaliser_batch_capture_masse(id_batch, par_timeout=True))

    def _sur_demande_capturer_tout_local(self, task: "Task", etat: "ExecutionCloneEtat"):
        """AJOUT (SPEC_mode_clone_local.md section 2.4, "Capturer tout" en
        mode local) -- décision tranchée après analyse du protocole serveur
        local : une instance locale n'accepte qu'UN SEUL pilote exclusif à
        la fois (`link`, cf. srv_gerer_link), et InstanceExecutable.capture()
        passe par self._moteur_effectif()._appeler(...) -- elle exige donc
        qu'un MoteurExecutionCellule soit DÉJÀ lié à cette instance (pas une
        commande "libre" envoyable sans lien actif, contrairement au mode
        réseau où le sAutoniax distant pousse ses captures indépendamment
        du protocole de pilotage). Conséquence assumée (documentée dans la
        spec, pas une limitation de ce patch) : seuls les profils COCHÉS
        dont une séquence de cellules est ACTUELLEMENT en cours (profil_etat.
        moteur_courant is not None) peuvent être capturés ici -- un profil
        coché mais sans moteur actif est ignoré avec un message explicite,
        plutôt qu'une tentative vouée à échouer avec RuntimeError.

        Réutilise TELLE QUELLE l'infrastructure de batch déjà en place pour
        le mode réseau (self._captures_masse_en_attente, _traiter_reception_
        capture_masse, _finaliser_batch_capture_masse, dossier/préfixe) --
        avec id_executant=ID_EXECUTANT_LOCAL pour chaque cible, afin que le
        nommage de fichier et la logique de désambiguïsation existante
        s'appliquent sans modification. Seule la SOURCE de l'image change :
        pas de demande_capture_ponctuelle_instance_clone (réseau, async via
        websocket), mais un threading.Thread dédié par capture qui appelle
        capture() de façon bloquante (jamais depuis le thread Qt principal,
        cf. docstring de InstanceExecutable.capture -- _appeler() bloque ce
        thread en attendant une réponse livrée par la boucle Qt elle-même :
        un appel direct depuis le thread Qt principal serait un deadlock),
        puis réinjecte le résultat via le signal _capture_locale_ponctuelle_
        recue (QueuedConnection, même patron que MoteurExecutionCellule.
        _resultat_pret)."""
        cibles_locales = {
            cle: (p.instance_id, p.moteur_courant)
            for cle, p in etat.profils.items()
            if p.coche and p.instance_id and _id_executant_depuis_cle_profil_clone(cle) == ID_EXECUTANT_LOCAL
        }
        cibles_avec_moteur = {cle: v for cle, v in cibles_locales.items() if v[1] is not None}
        nb_ignores_sans_moteur = len(cibles_locales) - len(cibles_avec_moteur)
        if not cibles_avec_moteur:
            self._notify_status(
                "Capturer tout (local) : aucun profil coché n'a de séquence en cours -- "
                "lancez d'abord les clones avant de capturer.",
                error=True,
            )
            return
        horodatage = datetime.now().isoformat()
        id_batch = horodatage.replace(":", "-")
        prefixe_aleatoire_batch = uuid.uuid4().hex[:8]
        cible_vers_profil = {
            (ID_EXECUTANT_LOCAL, instance_id): _nom_depuis_cle_profil_clone(cle)
            for cle, (instance_id, _moteur) in cibles_avec_moteur.items()
        }
        self._captures_masse_en_attente[id_batch] = {
            "task_nom": task.nom,
            "cible_vers_profil": cible_vers_profil,
            "recues": set(),
            "dossier": get_captures_clone_dir() / _nom_dossier_valide(task.nom or task.id) / id_batch,
            "prefixe": prefixe_aleatoire_batch,
        }
        for _cle, (instance_id, moteur_courant) in cibles_avec_moteur.items():
            self._lancer_thread_capture_locale(instance_id, moteur_courant)
        suffixe_ignores = f" ({nb_ignores_sans_moteur} ignoré(s), pas de séquence en cours)" if nb_ignores_sans_moteur else ""
        self._notify_status(f"Capture en cours... 0/{len(cibles_avec_moteur)} reçue(s){suffixe_ignores}.")
        QTimer.singleShot(120000, lambda: self._finaliser_batch_capture_masse(id_batch, par_timeout=True))

    def _lancer_thread_capture_locale(self, instance_id: str, moteur_courant: "MoteurExecutionCellule"):
        """Thread dédié, une capture -- jamais depuis le thread Qt principal
        (cf. docstring de _sur_demande_capturer_tout_local). Le résultat
        (image_b64 ou message d'erreur) est réinjecté via le signal Qt
        _capture_locale_ponctuelle_recue, jamais par appel direct depuis ce
        thread à _traiter_reception_capture_masse/_notify_status (toutes
        deux touchent l'UI)."""
        def _travail():
            try:
                chemin = InstanceExecutable(instance_id, moteur_courant).capture()
                with open(chemin, "rb") as f:
                    image_b64 = base64.b64encode(f.read()).decode("ascii")
                self._capture_locale_ponctuelle_recue.emit(instance_id, image_b64, "")
            except Exception as e:  # RuntimeError attendu (échec capture), mais on ne laisse rien remonter au thread
                self._capture_locale_ponctuelle_recue.emit(instance_id, "", str(e))
        threading.Thread(target=_travail, daemon=True).start()

    def _sur_capture_locale_ponctuelle_recue(self, instance_id: str, image_b64: str, erreur: str):
        """Slot Qt (thread principal, cf. QueuedConnection à la connexion
        du signal) -- relaie vers _traiter_reception_capture_masse, MÊME
        mécanisme que le mode réseau, avec id_executant=ID_EXECUTANT_LOCAL
        (cf. docstring de _sur_demande_capturer_tout_local pour pourquoi
        c'est sûr de réutiliser cette fonction inchangée)."""
        if not image_b64:
            log.warning(f"[capture locale] échec pour instance_id={instance_id!r} : {erreur}")
            return
        self._traiter_reception_capture_masse(ID_EXECUTANT_LOCAL, instance_id, image_b64)

    def _traiter_reception_capture_masse(self, id_executant: str, instance_id: str, image_b64: str):
        """Cf. section 5.2 de la spec -- cherche (id_executant, instance_id)
        dans le batch en attente le plus récent qui l'attend encore,
        décode et sauvegarde l'image, décrémente le compteur implicite
        (taille de "recues" vs taille de "cible_vers_profil").

        REFONTE MULTI-SAUTONIAX -- la clé de recherche est désormais
        (id_executant, instance_id), pas instance_id seul : un batch peut
        désormais cibler des instances sur PLUSIEURS sAutoniax distincts
        (cf. docstring de _sur_demande_capturer_tout), et rien ne
        garantit qu'un instance_id soit unique CROSS-sAutoniax -- sans
        id_executant dans la clé, deux instances homonymes de sAutoniax
        différents dans le même batch se marqueraient mutuellement comme
        "déjà reçues" l'une pour l'autre.

        BUGFIX (audit clé composite) : `nom_profil` récupéré ci-dessous
        via cible_vers_profil est désormais garanti être le NOM NU
        affichable (résolu une fois pour toutes par _sur_demande_
        capturer_tout au moment de construire cible_vers_profil) --
        avant correction, la clé composite (id_executant::nom_profil)
        remontait jusqu'ici et polluait le nom de fichier produit plus
        bas (nom_fichier)."""
        cle_cible = (id_executant, instance_id)
        for id_batch, batch in list(self._captures_masse_en_attente.items()):
            nom_profil = batch["cible_vers_profil"].get(cle_cible)
            if nom_profil is None or cle_cible in batch["recues"]:
                continue
            try:
                donnees = base64.b64decode(image_b64)
            except (ValueError, binascii.Error) as e:
                log.warning(f"_traiter_reception_capture_masse : décodage échoué pour {nom_profil!r} ({e!r}).")
                continue
            dossier = batch["dossier"]
            dossier.mkdir(parents=True, exist_ok=True)
            # PATCH (préfixe aléatoire par groupe de capture, cf. docstring
            # de _sur_demande_capturer_tout) -- même préfixe pour toutes
            # les images de CE batch (stocké une seule fois sur le batch,
            # pas régénéré ici), différent d'un batch à l'autre.
            prefixe = batch.get("prefixe", "")
            nom_fichier = f"{prefixe}_{_nom_dossier_valide(nom_profil)}.png" if prefixe else f"{_nom_dossier_valide(nom_profil)}.png"
            chemin = dossier / nom_fichier
            try:
                # Fidélité (§5.3) : le PNG reçu est écrit TEL QUEL, sans
                # recompression -- usage "collecte de données".
                chemin.write_bytes(donnees)
            except OSError as e:
                log.warning(f"_traiter_reception_capture_masse : écriture échouée pour {nom_profil!r} ({e!r}).")
                continue
            batch["recues"].add(cle_cible)
            total = len(batch["cible_vers_profil"])
            faits = len(batch["recues"])
            self._notify_status(f"Capture en cours... {faits}/{total} reçue(s).")
            if faits >= total:
                self._finaliser_batch_capture_masse(id_batch, par_timeout=False)
            break

    def _finaliser_batch_capture_masse(self, id_batch: str, par_timeout: bool):
        """Cf. section 5.4 de la spec -- notifie l'utilisateur et propose
        un lien "Ouvrir le dossier" une fois le batch terminé (ou après
        timeout, avec ce qui a été reçu jusque-là).

        CORRECTIF (bug réel, demande explicite utilisateur : "une fois
        toutes les captures faites désactive absolument tout le mode
        automatique... je me fous de savoir comment c'était avant") --
        dès que ce batch "Capturer tout" se termine (peu importe le
        résultat : succès total, partiel, ou timeout complet), on coupe
        EXPLICITEMENT le flux continu (set_streaming) sur CHAQUE instance
        ciblée par ce batch, sans exception et sans condition sur un état
        antérieur. Le protocole "capture_propre" utilisé pour la capture
        elle-même (cf. demande_capture_ponctuelle_instance_clone ->
        demander_capture_ponctuelle_instance -> action="ponctuelle" côté
        sAutoniax) n'active déjà jamais de streaming -- mais si un mode
        Automatique a été activé PAR AILLEURS sur une de ces instances
        (panneau de rendu réseau, profil actif, etc.), rien ne le
        redésactivait jamais après un batch de ce genre. Un simple
        fps=0.0 par instance ciblée, systématique, sans jamais chercher
        à savoir si un flux était réellement actif ou non (idempotent :
        aucun effet si déjà inactif) -- réponse directe et sans ambiguïté
        à la demande explicite, indépendante du correctif apporté par
        ailleurs à _definir_profil_actif."""
        batch = self._captures_masse_en_attente.pop(id_batch, None)
        if batch is None:
            return  # déjà finalisé (cf. le `break` de _traiter_reception_capture_masse)
        if self._client_serveur_t is not None:
            # REFONTE MULTI-SAUTONIAX -- id_executant PAR instance ciblée
            # (cible_vers_profil est désormais keyé par (id_executant,
            # instance_id), cf. docstring de _sur_demande_capturer_tout),
            # pas un seul id_executant partagé pour tout le batch : sinon
            # cette désactivation de streaming raterait sa cible pour
            # toute instance d'un sAutoniax différent de celui choisi.
            # PATCH (mode local, cf. _sur_demande_capturer_tout_local) :
            # exclusion explicite de ID_EXECUTANT_LOCAL -- ce "sAutoniax"
            # n'existe pas côté serveurT distant, et le mode local n'a de
            # toute façon jamais de streaming continu à couper ici (cf.
            # section 2.4 de la spec : le rendu vidéo local est hors
            # scope v1, aucun set_streaming n'est jamais activé pour une
            # instance locale par ce chemin).
            for id_executant, instance_id in batch["cible_vers_profil"]:
                if id_executant == ID_EXECUTANT_LOCAL:
                    continue
                self._client_serveur_t.definir_taux_capture_instance(id_executant, instance_id, 0.0)
        total = len(batch["cible_vers_profil"])
        faits = len(batch["recues"])
        if faits == 0:
            self._notify_status("Capture en masse : aucune réponse reçue (timeout).", error=True)
            return
        suffixe = f" ({total - faits} timeout)" if faits < total else ""
        self._notify_status(f"Capture terminée : {faits}/{total} réussie(s){suffixe}.")
        chemin_dossier = str(batch["dossier"])
        QDesktopServices.openUrl(QUrl.fromLocalFile(chemin_dossier))

    def _id_executant_profil_actif(self, task: "Task") -> str:
        """REMPLACE combo_executant_reseau.currentData() partout (retrait
        du combo, cf. docstring de self.combo_executant_reseau dans
        __init__) -- résout désormais le sAutoniax "courant" du Task à
        partir du PROFIL ACTIF du panneau clone (etat.profil_actif,
        seul mécanisme réel de sélection, piloté par le clic sur une
        ligne du panneau "Exécutions clone" -- cf. _definir_profil_actif).
        Retourne "" si aucun profil n'est actif (aucune ligne cliquée
        pour ce Task), exactement comme l'ancien combo retournait None
        quand rien n'était sélectionné -- tous les appelants existants
        géraient déjà ce cas (`if not id_executant: ...`), donc le
        comportement à vide reste inchangé."""
        etat = self._executions_clone.get(task.id)
        if etat is None or not etat.profil_actif:
            return ""
        profil_etat = etat.profils.get(etat.profil_actif)
        if profil_etat is not None and profil_etat.id_executant_sautoniax:
            return profil_etat.id_executant_sautoniax
        # Repli défensif si profil_etat est absent/pas encore résolu
        # (ne devrait pas arriver en pratique -- profil_actif n'est
        # jamais posé sur une clé inconnue de etat.profils, cf.
        # _sur_demande_definir_profil_actif) : extrait l'id_executant
        # directement depuis la clé composite elle-même.
        return _id_executant_depuis_cle_profil_clone(etat.profil_actif)

    def _demander_liste_profils_cloud(self, task: Optional["Task"] = None):
        """Émet demande_liste_profils_locaux_sautoniax pour le sAutoniax
        du profil actuellement ACTIF (panneau Exécutions clone -- cf.
        _id_executant_profil_actif, qui a remplacé combo_executant_
        reseau.currentData() ici, PATCH retrait du combo). Relayé par
        MainWindow vers ClientServeurT.demander_liste_profils_locaux_
        sautoniax, cf. sur_resultat_liste_profils_locaux_sautoniax pour
        la réponse. No-op silencieux si aucun profil actif ou si le
        client réseau n'est pas encore injecté (ex. tout début du
        démarrage de l'app)."""
        task = task or self._task_courant_obj()
        if task is None:
            return
        id_executant = self._id_executant_profil_actif(task)
        if not id_executant:
            return
        self.demande_liste_profils_locaux_sautoniax.emit(id_executant)

    def _rafraichir_apres_changement_executant_actif(self, task: Task):
        """REMPLACE _rafraichir_combo_executant_reseau + _sur_changement_
        executant_reseau (PATCH retrait de combo_executant_reseau, cf.
        docstring de self.combo_executant_reseau dans __init__) --
        regroupe tout ce qui devait auparavant se rafraîchir soit au
        peuplement du combo, soit à son changement de sélection : ça se
        déclenche désormais au changement du PROFIL ACTIF (panneau
        Exécutions clone), la seule source de vérité pour "quel
        sAutoniax l'utilisateur regarde en ce moment" pour ce Task.
        Appelée depuis _definir_profil_actif (nouveau profil actif
        posé) ET depuis les points qui rafraîchissaient auparavant le
        combo (résultat réseau reçu, liste de profils mise à jour,
        etc.) -- cf. les appelants de _rafraichir_combo_executant_
        reseau avant ce patch, tous convertis vers celle-ci."""
        self._rafraichir_statut_reseau(task)
        # PATCH (demande explicite utilisateur : la liste des profils
        # dépend du sAutoniax actif) -- redemande systématiquement la
        # liste des profils locaux à chaque changement de profil actif
        # (même si déjà en cache : un profil a pu être ajouté/retiré
        # côté sAutoniax entre-temps, mieux vaut une donnée fraîche
        # qu'un cache silencieusement périmé). Le menu de liaison
        # ServiceAPI (cf. _demande_selection_executant_reseau) redemande
        # lui-même une liste fraîche à chaque ouverture -- rien d'autre
        # à rafraîchir ici de façon proactive.
        self._demander_liste_profils_cloud(task)
        if self._fenetre_rendu_reseau is not None:
            id_executant = self._id_executant_profil_actif(task)
            nom = self._noms_executants_reseau.get(id_executant, "") if id_executant else ""
            self._fenetre_rendu_reseau.titre_label.setText(f"sAutoniax : {nom}" if nom else "Aucun sAutoniax sélectionné")
            # BUG CORRIGÉ (panneau de rendu qui restait noir/affichait
            # l'ancien sAutoniax après un changement de profil actif
            # pendant que la fenêtre de rendu est déjà ouverte) : seul
            # le titre était mis à jour ci-dessus, jamais l'image --
            # sur_capture_reseau_recue (cf. plus bas) ne pousse une
            # nouvelle image QUE quand une capture arrive ET correspond
            # déjà au sAutoniax du profil actif à ce moment-là ; rien ne
            # redéclenchait l'affichage de la DERNIÈRE capture déjà
            # connue du nouvel exécutant ciblé ici. Même logique que
            # _sur_clic_voir_rendu_reseau à l'ouverture (definir_image
            # avec _dernieres_captures_reseau.get(id_executant)) : si
            # aucune capture n'a jamais été reçue pour ce sAutoniax, la
            # zone image redevient bien vide/noire (comportement voulu,
            # cf. "c'est moi qui dois activer le rafraîchissement") plutôt
            # que de garder affichée par erreur l'image de l'exécutant
            # précédent.
            self._fenetre_rendu_reseau.definir_image(
                self._dernieres_captures_reseau.get(id_executant) if id_executant else None
            )
            # PATCH B.5 -- si le widget est actuellement embarqué en onglet
            # (pas détaché), synchronise aussi le libellé de l'onglet
            # ApplicationsScreen sur le nouveau sAutoniax ciblé.
            # ouvrir_rendu_task_reseau est idempotente ici (dédup via
            # indexOf, cf. sa docstring) : ne fait que renommer l'onglet
            # existant, n'en crée jamais un second.
            # CORRECTIF : ne JAMAIS pousser le rendu en onglet Applications.
            # Le rendu vit uniquement en overlay (afficher_par_dessus_tout) ;
            # l'ancienne émission ici recréait l'onglet « profil (sAutoniax) »
            # vide à chaque changement de profil actif.
            pass

    def _executant_reseau_pret(self, task: Task) -> bool:
        id_executant = self._id_executant_profil_actif(task)
        if not id_executant:
            return False
        return self._executants_reseau_prets.get((task.id, id_executant), False)

    def _rafraichir_statut_reseau(self, task: Task):
        if task.mode_execution != "reseau":
            return
        id_executant = self._id_executant_profil_actif(task)
        nom_executant = self._noms_executants_reseau.get(id_executant, "") if id_executant else ""
        profil_actif = self._profils_reseau_actifs.get((task.id, id_executant), "") if id_executant else ""
        # PATCH (bouton "Fermer") -- cliquable UNIQUEMENT si un profil est
        # réellement chargé sur le sAutoniax actuellement sélectionné
        # (sinon rien à fermer, cf. garde-fou symétrique dans
        # _sur_clic_fermer_reseau). Réévalué à CHAQUE rafraîchissement du
        # statut (changement de sAutoniax sélectionné, résultat
        # d'initialisation/fermeture reçu, etc.), jamais laissé dans un
        # état périmé.
        self.bouton_fermer_reseau.setEnabled(bool(id_executant) and self._executant_reseau_pret(task))
        if not id_executant:
            self.label_statut_reseau.setText(
                "Choisissez d'abord un profil actif (Exécutions clone)."
            )
        elif not task.profils_lies_reseau:
            self.label_statut_reseau.setText("Liez au moins un ServiceAPI à un profil ci-dessus.")
        elif self._executant_reseau_pret(task):
            self.label_statut_reseau.setText(
                f"« {nom_executant} » initialisé avec le profil « {profil_actif} » -- prêt à exécuter."
            )
        else:
            self.label_statut_reseau.setText(
                f"« {nom_executant} » pas encore initialisé -- cliquez sur \"Initialiser\" avant d'exécuter une cellule."
            )

    def _sur_clic_initialiser_reseau(self):
        """SPEC_profils_environnements.md (retour utilisateur explicite,
        conversation du support) : ce bouton n'initialise plus AUCUNE
        session -- l'ancien flux (vérification cloud, initialiser_
        notebook_distant, menu de choix de profil si plusieurs
        task.profils_lies_reseau) est retiré. Le profil sur lequel
        travailler est désormais choisi UNE FOIS pour toutes par la
        sélection de ligne dans la liste de profils (section 4.3,
        ExecutionCloneEtat.profil_actif) -- ce profil est déjà actif/
        lancé côté sAutoniax au moment où il apparaît dans la liste
        (cf. section 4.2, un profil n'apparaît que si le sAutoniax le
        rapporte comme tel).

        Ce bouton devient donc un simple raccourci pour reset_
        interface() sur l'instance du profil actif -- referme tous les
        onglets ouverts et réaffiche la welcome page, exactement comme
        reset_interface() appelée depuis une cellule de script (cf. sa
        docstring), mais déclenchable en un clic sans avoir à écrire de
        code. Utilise le même protocole/mécanisme déjà en place pour le
        contrôle à distance du panneau de rendu (envoyer_commande_
        instance, cf. _cible_rendu_reseau_actuelle) -- fire-and-forget,
        pas de résultat attendu ici (même patron que resetInterface
        déclenché depuis le panneau de contrôle du rendu vidéo)."""
        task = self._task_courant_obj()
        if task is None:
            return
        if self._client_serveur_t is None:
            self._notify_status("Réseau indisponible (module 'websockets' manquant ?) -- réinitialisation impossible.", error=True)
            return
        id_executant_cible, instance_id_cible = self._cible_rendu_reseau_actuelle()
        if not id_executant_cible or not instance_id_cible:
            self._notify_status(
                "Aucun profil actif avec une instance connue -- sélectionnez d'abord une "
                "ligne dans la liste de profils (Exécutions clone).",
                error=True,
            )
            return
        requete_id = uuid.uuid4().hex[:12]
        self._client_serveur_t.envoyer_commande_instance(
            id_executant_cible, instance_id_cible, requete_id, {"action": "resetInterface"},
        )
        self._notify_status(f"Réinitialisation de l'interface demandée pour « {instance_id_cible} ».")

    def sur_resultat_liste_profils_locaux_sautoniax(self, id_executant: str, ok: bool, profils: list, erreur: str):
        """Résultat de demande_liste_profils_locaux_sautoniax (PATCH --
        remplace sur_resultat_liste_profils_cloud, qui listait TOUS les
        profils du bucket cloud -- demande explicite utilisateur : lister
        uniquement ceux présents sur le sAutoniax sélectionné). `profils`
        est déjà une simple liste de noms (cf. serveur.py, le sAutoniax
        liste lui-même son dossier local sautoniax_profils et renvoie des
        noms nus, pas des clés B2 -- pas de préfixe/extension à retirer
        ici, contrairement à l'ancien filtrage Profils/*.zip).

        Sur échec (`ok` False), ne touche PAS au cache pour CET
        id_executant -- mieux vaut garder la dernière liste connue
        affichée que la vider sur un simple accroc réseau (même logique
        prudente que l'ancien comportement)."""
        if not ok:
            if erreur:
                log_reseau_t.warning(f"sur_resultat_liste_profils_locaux_sautoniax : échec pour '{id_executant}' -- {erreur}")
            return
        self._profils_locaux_par_executant[id_executant] = list(profils)
        task = self._task_courant_obj()
        if (task is not None and task.mode_execution == "reseau"
                and self._id_executant_profil_actif(task) == id_executant):
            self._rafraichir_statut_reseau(task)
        # CORRECTIF (cf. docstring de _demande_selection_executant_reseau
        # -- "je suis obliger de recliquey pour voir") : si le menu de
        # liaison ServiceAPI est encore ouvert au moment où CETTE réponse
        # arrive, ET qu'il a été ouvert pour ce même id_executant, on le
        # repeuple EN PLACE avec les données fraîches plutôt que de
        # laisser l'utilisateur voir "(actualisation...)" jusqu'à sa
        # PROCHAINE ouverture du menu.
        if self._menu_liaison_reseau_ouvert is not None:
            id_executant_menu, menu_ouvert = self._menu_liaison_reseau_ouvert
            if id_executant_menu == id_executant:
                self._peupler_menu_liaison_reseau(menu_ouvert, id_executant, list(profils))

    def demande_initialisation_reseau_emettre(self, id_executant: str, profil_nom: str) -> str:
        """Appelé par _sur_clic_initialiser_reseau -- passe par le signal
        demande_initialisation_notebook_distant (relayé par MainWindow vers
        ClientServeurT.initialiser_notebook_distant, cf. protocole déjà en
        place) plutôt qu'un appel direct : MainWindow reste seul responsable
        de connaître client_serveur_t.initialiser_notebook_distant, ce
        Screen ne fait qu'émettre l'intention -- cohérent avec le reste des
        signaux sortants de cette classe (demande_ouvrir_coordonnee_action,
        etc.)."""
        session_id = uuid.uuid4().hex[:12]
        self.demande_initialisation_notebook_distant.emit(id_executant, profil_nom, session_id)
        return session_id

    def sur_log_initialisation_reseau_recu(self, session_id: str, _id_executant: str, ligne: str):
        cible = self._sessions_initialisation_reseau.get(session_id)
        if cible is None:
            return
        task_id, id_executant, _profil_nom = cible
        task = self.project.find_task(task_id)
        if task is not None and self._task_courant == task_id and self._id_executant_profil_actif(task) == id_executant:
            self.label_statut_reseau.setText(ligne)

    def sur_resultat_initialisation_reseau_recu(self, session_id: str, _id_executant: str, ok: bool, message: str):
        cible = self._sessions_initialisation_reseau.pop(session_id, None)
        if cible is None:
            return
        task_id, id_executant, profil_nom = cible
        self._executants_reseau_prets[(task_id, id_executant)] = ok
        if ok:
            self._profils_reseau_actifs[(task_id, id_executant)] = profil_nom
        task = self.project.find_task(task_id)
        if task is None:
            return
        nom_executant = self._noms_executants_reseau.get(id_executant, id_executant)
        if self._task_courant == task_id:
            self._rafraichir_statut_reseau(task)
            # PATCH (bugfix mode "Exécution Clone") : bouton_mode_clone
            # n'était jamais réévalué ici. clone_disponible dépend de
            # task.profils_lies_reseau (déduit de services_api_importes,
            # cf. sa docstring), qui peut passer de vide à non-vide au
            # moment précis où l'utilisateur lie un ServiceAPI PUIS clique
            # "Initialiser" -- sans ce rafraîchissement, le bouton restait
            # invisible jusqu'au prochain changement de mode ou réouverture
            # du Task, alors que le bandeau de statut et le panneau
            # composants, eux, se mettaient à jour immédiatement (cf.
            # panneau_composants.rafraichir juste en dessous), créant une
            # incohérence visuelle trompeuse.
            self._rafraichir_visibilite_controles_reseau(task)
            # PATCH : le label "lié à «...»" du panneau composants
            # (cf. _libelle_liaison) doit refléter IMMÉDIATEMENT le nom du
            # profil qui vient d'être chargé avec succès (ex. passer de
            # l'id_executant brut à "camoufox_claude"), sans attendre un
            # rafraîchissement fortuit (changement d'onglet, etc.).
            if ok:
                self.panneau_composants.rafraichir(task)
        if ok:
            self._notify_status(f"« {nom_executant} » initialisé avec le profil « {profil_nom} ».")
        else:
            self._notify_status(f"Échec d'initialisation de « {nom_executant} » : {message}", error=True)

    def _sur_clic_fermer_reseau(self):
        # PATCH (bouton "Fermer" à côté d'"Initialiser" -- demande
        # explicite utilisateur : "il faut que on l'ajoute a coter du
        # bouton initialiser , la il vas detruit le prfils lancer"). Même
        # garde-fous que _sur_clic_initialiser_reseau, mais pas de
        # vérification cloud ici (rien à télécharger pour FERMER) --
        # seulement task + sAutoniax choisi + déjà prêt (sinon rien à
        # fermer, cf. bouton désactivé par _rafraichir_statut_reseau dans
        # ce cas -- ce garde-fou reste une sécurité si jamais appelé
        # autrement, ex. futur raccourci clavier).
        task = self._task_courant_obj()
        if task is None:
            return
        if self._client_serveur_t is None:
            self._notify_status("Réseau indisponible (module 'websockets' manquant ?) -- fermeture impossible.", error=True)
            return
        id_executant = self._id_executant_profil_actif(task)
        if not id_executant:
            self._notify_status("Choisissez d'abord un profil actif (Exécutions clone).", error=True)
            return
        if not self._executant_reseau_pret(task):
            self._notify_status("Aucun profil chargé sur ce sAutoniax -- rien à fermer.", error=True)
            return
        self.bouton_fermer_reseau.setEnabled(False)
        nom_executant = self._noms_executants_reseau.get(id_executant, id_executant)
        self.label_statut_reseau.setText(f"Fermeture du profil chargé sur « {nom_executant} »...")
        session_id = self.demande_fermeture_reseau_emettre(id_executant)
        self._sessions_fermeture_reseau[session_id] = (task.id, id_executant)

    def demande_fermeture_reseau_emettre(self, id_executant: str) -> str:
        """Appelé par _sur_clic_fermer_reseau -- passe par le signal
        demande_fermeture_notebook_distant (relayé par MainWindow vers
        ClientServeurT.fermer_notebook_distant), même raisonnement EXACT
        que demande_initialisation_reseau_emettre ci-dessus."""
        session_id = uuid.uuid4().hex[:12]
        self.demande_fermeture_notebook_distant.emit(id_executant, session_id)
        return session_id

    def sur_resultat_fermeture_reseau_recu(self, session_id: str, _id_executant: str, ok: bool, message: str):
        cible = self._sessions_fermeture_reseau.pop(session_id, None)
        if cible is None:
            return
        task_id, id_executant = cible
        nom_executant = self._noms_executants_reseau.get(id_executant, id_executant)
        if ok:
            # Symétrique de sur_resultat_initialisation_reseau_recu (ok=True
            # y marque PRÊT) : ok=True ICI marque au contraire PLUS PRÊT,
            # puisque le profil vient d'être fermé -- prochaine exécution de
            # cellule doit à nouveau passer par "Initialiser" avant de
            # pouvoir tourner. _profils_reseau_actifs est vidé pour ce
            # couple (task, sAutoniax) : plus aucun profil à afficher comme
            # "actif" dans le statut ni dans le panneau composants.
            self._executants_reseau_prets[(task_id, id_executant)] = False
            self._profils_reseau_actifs.pop((task_id, id_executant), None)
        task = self.project.find_task(task_id)
        if task is None:
            return
        if self._task_courant == task_id:
            self._rafraichir_statut_reseau(task)
            # Même raison que sur_resultat_initialisation_reseau_recu : le
            # label "lié à «...»" du panneau composants doit refléter
            # IMMÉDIATEMENT la disparition du profil fermé, sans attendre
            # un rafraîchissement fortuit.
            if ok:
                self.panneau_composants.rafraichir(task)
        if ok:
            self._notify_status(f"Profil fermé sur « {nom_executant} ».")
        else:
            self._notify_status(f"Échec de fermeture sur « {nom_executant} » : {message}", error=True)
            # Échec : le profil est peut-être toujours chargé -- pas de
            # changement d'état local, mais le bouton doit redevenir
            # cliquable pour permettre un nouvel essai (sinon resterait
            # désactivé indéfiniment, cf. setEnabled(False) au clic dans
            # _sur_clic_fermer_reseau, jamais réactivé par un chemin
            # d'échec qui ne repasse pas par _rafraichir_statut_reseau).
            if self._task_courant == task_id:
                self._rafraichir_statut_reseau(task)

    # ------------------------------------------------------------------
    # AJOUT (bouton "Sync API" -- demande explicite utilisateur, cf.
    # docstring de bouton_sync_api_reseau) : pousse EN DIRECT le dossier
    # service API PUIS project.json vers le sAutoniax sélectionné dans
    # CE Task. Contrairement à Initialiser/Fermer ci-dessus (Option A,
    # session_id généré par ce Screen AVANT l'appel), mettre_a_jour_
    # service_api/mettre_a_jour_project_json sont appelées EN DIRECT sur
    # self._client_serveur_t (référence déjà disponible ici, cf.
    # definir_client_reseau_t) -- pas de signal Qt sortant à relayer par
    # MainWindow, même raccourci que MoteurExecutionCelluleReseau.lancer
    # pour executer_notebook_distant. Seuls les DEUX signaux de résultat
    # (mise_a_jour_service_api_resultat/mise_a_jour_project_json_
    # resultat, sans session_id) ont besoin d'un pont MainWindow -- cf.
    # sur_resultat_maj_service_api_reseau/sur_resultat_maj_project_json_
    # reseau ci-dessous, et leur câblage.
    # ------------------------------------------------------------------
    def _sur_clic_sync_api_reseau(self):
        """Comportement HISTORIQUE (inchangé) : pousse service_api PUIS
        project.json à la suite, puis enchaîne sur l'étape cloud -- cf.
        docstring de bouton_sync_api_reseau/DEFAULT_RACCOURCIS_APP
        ["sync_api_toggle"]. Délègue à _lancer_sync_api_reseau(chainer=
        True) -- cf. sa docstring pour le détail des garde-fous et le
        pourquoi de `chainer`."""
        self._lancer_sync_api_reseau(chainer=True)

    def _sur_clic_sync_service_api_seul(self):
        """AJOUT (demande explicite utilisateur : "je veux que tu creer
        la possibiliter de mettre un raccourci clavier pour mettre a
        jour ... service api seule -- un peu comme dans mise a jour
        systeme il ya chaque bouton pour chque mise a jour") -- pousse
        UNIQUEMENT le dossier service API vers le sAutoniax choisi,
        SANS enchaîner sur project.json ni sur le cloud (contrairement à
        _sur_clic_sync_api_reseau) -- cf. _lancer_sync_api_reseau
        (chainer=False) et sur_resultat_maj_service_api_reseau, qui
        s'arrête ici quand chainer vaut False."""
        self._lancer_sync_api_reseau(chainer=False)

    def _sur_clic_sync_project_json_seul(self):
        """AJOUT (même demande explicite utilisateur que _sur_clic_sync_
        service_api_seul, symétrique pour project.json) -- pousse
        UNIQUEMENT project.json vers le sAutoniax choisi, SANS passer
        par service_api ni par le cloud. Contrairement aux deux méthodes
        ci-dessus (qui commencent toutes deux par service_api, cf.
        protocole mettre_a_jour_service_api/mettre_a_jour_project_json
        de ClientServeurT -- deux appels réseau INDÉPENDANTS, aucun ne
        dépend structurellement de l'autre), celle-ci appelle directement
        mettre_a_jour_project_json sans passer par service_api au
        préalable -- cf. _lancer_sync_api_reseau(chainer=False,
        service_api_dabord=False)."""
        self._lancer_sync_api_reseau(chainer=False, service_api_dabord=False)

    def _lancer_sync_api_reseau(self, chainer: bool, service_api_dabord: bool = True):
        """Factorisation commune des 3 points d'entrée ci-dessus (cf.
        leurs docstrings) -- mêmes garde-fous que _sur_clic_fermer_reseau
        (task + réseau dispo + au moins un sAutoniax connu) -- PAS de
        garde _executant_reseau_pret ici : contrairement à Fermer, Sync
        API a un sens même AVANT tout "Initialiser" (un sAutoniax peut
        être à jour en dossier service_api/project.json sans profil
        chargé -- les deux notions sont indépendantes, cf. _construire_
        composants_direct qui les relit tous deux à chaque exécution de
        cellule, pas seulement à l'initialisation).

        chainer (cf. docstring de self._sync_api_en_cours) : True =
        comportement historique (les deux fichiers, puis cloud) ; False
        = un seul fichier, jamais d'enchaînement.
        service_api_dabord : lequel des deux fichiers est poussé quand
        chainer=False -- True (défaut) = service_api, False =
        project.json directement. Ignoré quand chainer=True (l'ordre
        historique service_api -> project.json est toujours respecté).

        REFONTE MULTI-SAUTONIAX (demande explicite utilisateur : "repare
        ... a tout les sautoniax") -- cible désormais TOUS les sAutoniax
        de self._noms_executants_reseau plutôt qu'un seul choix (cf.
        docstring de self._sync_api_en_cours pour le raisonnement
        complet) : Sync API n'a jamais eu de raison de se limiter à une
        seule cible quand plusieurs sAutoniax peuvent chacun exécuter des
        profils clone en parallèle avec un service_api/project.json
        potentiellement périmé (PATCH -- depuis le retrait de combo_
        executant_reseau, cf. docstring de self.combo_executant_reseau
        dans __init__, Initialiser/Fermer résolvent leur cible via le
        profil actif du panneau clone à la place, mais Sync API reste
        inchangé -- il ciblait déjà tous les sAutoniax avant ce retrait)."""
        task = self._task_courant_obj()
        if task is None:
            return
        if self._client_serveur_t is None:
            self._notify_status("Réseau indisponible (module 'websockets' manquant ?) -- synchronisation impossible.", error=True)
            return
        ids_executants = list(self._noms_executants_reseau.keys())
        if not ids_executants:
            self._notify_status("Aucun sAutoniax connecté -- rien à synchroniser.", error=True)
            return
        if self._sync_api_en_cours:
            # Sécurité si jamais appelé alors que le bouton n'a pas eu le
            # temps d'être désactivé (raccourci clavier notamment) --
            # même raisonnement que les gardes équivalentes ci-dessus.
            return
        self.bouton_sync_api_reseau.setEnabled(False)
        self._sync_api_cibles_restantes = len(ids_executants)
        if len(ids_executants) == 1:
            suffixe_cibles = f"« {self._noms_executants_reseau[ids_executants[0]]} »"
        else:
            suffixe_cibles = f"{len(ids_executants)} sAutoniax"
        if not chainer and not service_api_dabord:
            # project.json SEUL, directement -- symétrique du bloc
            # service_api ci-dessous, mais sans passer par service_api
            # au préalable (les deux protocoles réseau sont indépendants,
            # cf. docstring de _sur_clic_sync_project_json_seul).
            self.label_statut_reseau.setText(f"Envoi de project.json vers {suffixe_cibles}...")
            chemin_project_json = str(get_project_json_path())
            for id_executant in ids_executants:
                self._sync_api_en_cours[id_executant] = (task.id, chainer)
                self._client_serveur_t.mettre_a_jour_project_json(id_executant, chemin_project_json)
            return
        self.label_statut_reseau.setText(f"Envoi du service API vers {suffixe_cibles}...")
        chemin_service_api_a_jour = str(synchroniser_service_api_dir())
        for id_executant in ids_executants:
            self._sync_api_en_cours[id_executant] = (task.id, chainer)
            self._client_serveur_t.mettre_a_jour_service_api(id_executant, chemin_service_api_a_jour)

    def _terminer_cible_sync_api(self, id_executant: str) -> None:
        """REFONTE MULTI-SAUTONIAX -- retire CETTE cible de self._sync_
        api_en_cours et décrémente self._sync_api_cibles_restantes ; ne
        réactive bouton_sync_api_reseau que lorsque TOUTES les cibles de
        la vague en cours ont atteint un état terminal (succès ou échec),
        pas au premier résultat individuel -- sinon un clic prématuré
        pendant que d'autres sAutoniax sont encore en vol relancerait une
        seconde vague par-dessus celle déjà partie. Appelée à CHAQUE
        point de sortie terminal des deux handlers ci-dessous, qu'il
        s'agisse d'un succès, d'un échec, ou d'une connexion perdue en
        cours de route -- centralise ce qui était auparavant dupliqué à
        6 endroits différents (un self._sync_api_en_cours = None + un
        bouton_sync_api_reseau.setEnabled(True) par branche)."""
        self._sync_api_en_cours.pop(id_executant, None)
        self._sync_api_cibles_restantes = max(0, self._sync_api_cibles_restantes - 1)
        if self._sync_api_cibles_restantes <= 0 and not self._sync_api_en_cours:
            self.bouton_sync_api_reseau.setEnabled(True)

    def sur_resultat_maj_service_api_reseau(self, ok: bool, id_executant: str, message: str):
        """Branché par MainWindow sur ClientServeurT.mise_a_jour_service_
        api_resultat -- MÊME signal que instances_screen.sur_resultat_
        maj_service_api (multi-connect Qt standard, chacun filtre sur
        son propre _sync_api_en_cours/id_executant, aucune interférence
        entre l'action "par ligne" de l'onglet Instances et ce bouton).
        Étape 1/2 : au succès, enchaîne IMMÉDIATEMENT sur project.json
        POUR CETTE CIBLE (fichiers liés, cf. docstring bouton_sync_api_
        reseau) -- à l'échec, arrête la séquence ICI POUR CETTE CIBLE
        SEULEMENT (pas de project.json poussé sur un service_api resté
        dans un état inconnu côté sAutoniax) -- les autres cibles de la
        même vague continuent leur propre séquence indépendamment (cf.
        docstring de self._sync_api_en_cours).

        AJOUT (cf. docstring de _sur_clic_sync_service_api_seul) : si
        `chainer` (2e élément de la valeur stockée) vaut False, la
        séquence s'arrête ICI même en cas de succès -- ni project.json
        ni le cloud ne sont déclenchés, cf. raccourci "service API
        seule"."""
        cible = self._sync_api_en_cours.get(id_executant)
        if cible is None:
            return  # pas pour nous (autre appelant du même signal, ex. Instances, ou cible déjà terminée)
        task_id, chainer = cible
        nom_executant = self._noms_executants_reseau.get(id_executant, id_executant)
        if not ok:
            self._terminer_cible_sync_api(id_executant)
            self.label_statut_reseau.setText(f"Échec de synchronisation sur « {nom_executant} » (service API) : {message}")
            self._notify_status(f"Échec de mise à jour du service API sur « {nom_executant} » : {message}", error=True)
            return
        if not chainer:
            # Raccourci "service API seule" (cf. _sur_clic_sync_service_
            # api_seul). CORRECTIF (cf. docstring Connexion.upload_
            # service_api côté serveur.py -- demande explicite
            # utilisateur : "tu es sur ? regarde bien ,il ya aussi mise a
            # jour sur le cloud avec ces deux fontion") : ce raccourci
            # utilise EXACTEMENT le même protocole mettre_a_jour_service_
            # api_debut/_chunk/_fin que le bouton "Sync API" chaîné --
            # le serveur uploadant désormais lui-même vers App/service_
            # api.zip dans son handler _fin (à partir des octets déjà
            # transmis pour CE direct, sans rien renvoyer depuis le
            # client), le cloud est donc AUSSI mis à jour ici pour ce
            # raccourci, alors qu'il ne l'était pas avant ce correctif.
            # Rien à déclencher ici côté client : le message reflète
            # simplement ce nouveau comportement serveur.
            self._terminer_cible_sync_api(id_executant)
            self.label_statut_reseau.setText(f"Service API à jour sur « {nom_executant} » et sur le cloud.")
            self._notify_status(f"Service API synchronisé sur « {nom_executant} » et sur le cloud.")
            return
        self.label_statut_reseau.setText(f"Service API à jour sur « {nom_executant} », envoi de project.json...")
        self._client_serveur_t.mettre_a_jour_project_json(id_executant, str(get_project_json_path()))

    def sur_resultat_maj_project_json_reseau(self, ok: bool, id_executant: str, message: str):
        """Branché par MainWindow sur ClientServeurT.mise_a_jour_project_
        json_resultat. Étape 2/3 (cf. AJOUT ci-dessous pour l'étape 3/3
        cloud) : ferme la séquence DIRECTE (succès ou échec) POUR CETTE
        CIBLE, que le résultat de service_api ait ou non déjà été traité
        -- cf. garde sur _sync_api_en_cours, identique en principe à
        sur_resultat_maj_service_api_reseau ci-dessus. Les autres cibles
        de la même vague continuent indépendamment (cf. docstring de
        self._sync_api_en_cours).

        AJOUT (demande explicite utilisateur : "je veux que quand je
        sync les deux sont aussi mis à jour sur le cloud") : au succès du
        direct, enchaîne IMMÉDIATEMENT sur l'upload cloud des deux mêmes
        fichiers (service_api.zip PUIS project.json vers App/service_
        api.zip et App/project.json sur B2/Drive, cf. envoyer_mise_a_jour_
        app) -- sans ça, un redémarrage de l'exécutant (qui retélécharge
        depuis le cloud, cf. _sautoniax_assurer_donnees_de_base) écrase
        silencieusement ce qui vient d'être synchronisé EN DIRECT ici,
        avec l'ancienne version restée sur le cloud. À l'échec du direct,
        n'entame PAS l'étape cloud (même logique prudente que service_api
        -> project.json ci-dessus : ne jamais pousser sur le cloud un
        fichier qu'on sait ne pas être arrivé au sAutoniax).

        AJOUT (cf. docstring de _sur_clic_sync_project_json_seul) : si
        `chainer` (2e élément de la valeur stockée) vaut False, cette
        exécution vient du raccourci "project.json seul" -- ni
        service_api n'a été touché avant (donc rien à annoncer comme
        "les deux à jour"), ni le cloud n'est déclenché après."""
        cible = self._sync_api_en_cours.get(id_executant)
        if cible is None:
            return  # pas pour nous
        task_id, chainer = cible
        nom_executant = self._noms_executants_reseau.get(id_executant, id_executant)
        if not chainer:
            # Raccourci "project.json seul" (cf. _sur_clic_sync_project_
            # json_seul) -- CORRECTIF (demande explicite utilisateur :
            # "pourquoi lors que je sync uniquement le projet.json sa ne
            # vas pas aussi directement sur le cloud", "je me fou de
            # service_api") : jusqu'ici la séquence s'arrêtait ICI au
            # succès du direct, sans jamais toucher le cloud -- exposant
            # exactement le risque déjà décrit pour le cas chaîné (cf.
            # docstring de cette méthode, AJOUT "je veux que quand je
            # sync les deux sont aussi mis à jour sur le cloud") : un
            # redémarrage d'exécutant qui retélécharge depuis le cloud
            # (_sautoniax_assurer_donnees_de_base) écraserait
            # silencieusement ce project.json fraîchement synchronisé en
            # direct par l'ancienne version restée sur le cloud. À
            # l'échec du direct, comportement inchangé : jamais de cloud
            # pour un fichier qu'on sait ne pas être arrivé au sAutoniax
            # (même logique prudente que le cas chaîné ci-dessous).
            # service_api n'est ni touché ni mentionné dans ce chemin,
            # comme avant ce correctif.
            if not ok:
                self._terminer_cible_sync_api(id_executant)
                self.label_statut_reseau.setText(f"Échec de synchronisation sur « {nom_executant} » (project.json) : {message}")
                self._notify_status(f"Échec de mise à jour de project.json sur « {nom_executant} » : {message}", error=True)
                return
            if self._client_serveur_t is None:
                # Même raisonnement que la garde équivalente du cas
                # chaîné plus bas : connexion perdue entre-temps, le
                # direct a réussi, on s'arrête avant l'étape cloud
                # plutôt que de planter.
                self._terminer_cible_sync_api(id_executant)
                self.label_statut_reseau.setText(f"project.json à jour sur « {nom_executant} » (cloud non mis à jour : réseau indisponible).")
                self._notify_status(f"project.json synchronisé sur « {nom_executant} » (cloud non mis à jour).", error=True)
                return
            # RETRAIT (cf. docstring Connexion.upload_project_json côté
            # serveur.py -- "il ya aussi mise a jour sur le cloud avec ces
            # deux fontion" + "surtout pour le bouton sync api direct
            # present dans linterface taskscripeditor et les raccourir")
            # : cette séquence appelait auparavant envoyer_mise_a_jour_app
            # ici pour pousser project.json une SECONDE fois vers le
            # cloud (après le direct ci-dessus). Le serveur (ServeurT)
            # fait désormais lui-même cet upload cloud (App/project.json)
            # dès la réception complète de mettre_a_jour_project_json_fin,
            # à partir des octets déjà transmis pour le direct -- plus
            # aucun second envoi n'est nécessaire ni déclenché ici. Le
            # direct ci-dessus SUFFIT maintenant à couvrir aussi le cloud.
            self._terminer_cible_sync_api(id_executant)
            self.label_statut_reseau.setText(f"project.json à jour sur « {nom_executant} » et sur le cloud.")
            self._notify_status(f"project.json synchronisé sur « {nom_executant} » et sur le cloud.")
            return
        if not ok:
            self._terminer_cible_sync_api(id_executant)
            self.label_statut_reseau.setText(f"Échec de synchronisation sur « {nom_executant} » (project.json) : {message}")
            self._notify_status(f"Service API mis à jour, mais échec de project.json sur « {nom_executant} » : {message}", error=True)
            return
        if self._client_serveur_t is None:
            # Ne devrait pas arriver ici (déjà vérifié au clic initial),
            # mais évite un AttributeError si la connexion a été coupée
            # entre-temps -- le direct a réussi, on s'arrête simplement
            # avant l'étape cloud plutôt que de planter.
            self._terminer_cible_sync_api(id_executant)
            self.label_statut_reseau.setText(f"Service API et project.json à jour sur « {nom_executant} » (cloud non mis à jour : réseau indisponible).")
            self._notify_status(f"Service API et project.json synchronisés sur « {nom_executant} » (cloud non mis à jour).", error=True)
            return
        # RETRAIT (cf. docstring Connexion.upload_service_api/upload_
        # project_json côté serveur.py) : cette séquence appelait
        # auparavant synchroniser_service_api_dir() PUIS envoyer_mise_a_
        # jour_app("service_api", ...) ici pour repousser service_api.zip
        # ET (en chaîne, via sur_resultat_maj_app_cloud_reseau) project.
        # json une SECONDE fois vers le cloud -- alors que les deux
        # venaient d'être envoyés en direct juste au-dessus (service_api
        # puis project.json). Le serveur (ServeurT) fait maintenant
        # lui-même les deux uploads cloud (App/service_api.zip, App/
        # project.json) au fil de la réception de chaque _fin, à partir
        # des octets déjà transmis pour le direct -- ce double envoi
        # réseau (le vrai bug rapporté : "il ya aussi mise a jour sur le
        # cloud avec ces deux fontion") est donc supprimé ici, plus besoin
        # d'un aller-retour cloud distinct ni de _sync_api_cloud_en_cours
        # pour cette séquence.
        self._terminer_cible_sync_api(id_executant)
        self.label_statut_reseau.setText(f"Service API et project.json à jour sur « {nom_executant} » et sur le cloud.")
        self._notify_status(f"Service API et project.json synchronisés sur « {nom_executant} » et sur le cloud.")

    # RETRAIT (cf. docstring Connexion.upload_service_api côté serveur.py)
    # : sur_resultat_maj_app_cloud_reseau (étape 3/3 "Sync API" -> cloud)
    # est supprimée ici. Elle ne servait qu'à enchaîner un second envoi
    # cloud (envoyer_mise_a_jour_app) après le direct, pour service_api.
    # zip PUIS project.json -- ce que le serveur (ServeurT) fait
    # désormais lui-même directement dans ses handlers mettre_a_jour_
    # service_api_fin/mettre_a_jour_project_json_fin, à partir des
    # octets déjà reçus pour le direct. self._sync_api_cloud_en_cours
    # n'est donc plus jamais réglé à autre chose que None (cf. son
    # initialisation ci-dessus) -- son connect vers mise_a_jour_app_
    # resultat a été retiré symétriquement (cf. câblage MainWindow).

    # ------------------------------------------------------------------
    # PATCH (Task.mode_execution == "reseau", exécution de cellule --
    # PAS initialisation, cf. bloc ci-dessus) : routage session_id ->
    # MoteurExecutionCelluleReseau (self._moteurs_en_cours[cellule_id],
    # cf. _sessions_execution_reseau et bifurcation dans _executer_cellule).
    # Branché par MainWindow sur ClientServeurT.notebook_distant_log_recu/
    # _resultat_recu -- MÊME Signal que l'ancien NotebookDistantScreen,
    # cf. son propre câblage (les deux écrans coexistent, chacun filtre
    # via son propre dict de sessions, cf. docstring du câblage MainWindow).
    # ------------------------------------------------------------------
    def _reafficher_image_si_presente(self, widget: "TaskCelluleWidget", moteur: "MoteurExecutionCelluleReseau") -> bool:
        """BUGFIX centralisé (trois points d'écrasement trouvés
        indépendamment -- sur_log_execution_reseau_recu, sur_image_
        execution_reseau_recu, callback_termine -- cf. leurs anciens
        commentaires détaillés remplacés par cet appel commun) : les
        TROIS points ci-dessus appellent widget.afficher_resultat(cellule)
        à un moment ou un autre, qui pose systématiquement cellule.sortie
        (texte PUR, jamais l'image -- cf. filtre isinstance(e, str) dans
        sur_resultat_recu/sur_image_execution_reseau_recu/sur_log_
        execution_reseau_recu) dans zone_sortie, écrasant silencieusement
        une image déjà affichée si l'un de ces trois signaux (log,
        image, résultat) arrive APRÈS que l'image ait été posée -- rien
        ne garantit l'ordre relatif entre ces trois messages WebSocket
        indépendants. Symptôme observé par l'utilisateur : "aucune zone
        de sortie" visible du tout à l'écran, malgré des logs confirmant
        que l'image a bien été reçue et le HTML bien composé.

        Centralise le ré-affichage + les updateGeometry()/update() en
        cascade jusqu'au QScrollArea du notebook (nécessaires pour que
        Qt repeigne réellement l'espace agrandi par l'ajout de l'image,
        pas seulement recalcule sa géométrie interne) -- appelée par les
        TROIS handlers ci-dessous, systématiquement, après TOUT appel à
        widget.afficher_resultat(cellule) dans ce contexte réseau.
        Retourne True si une image a été (re)posée, False si ce moteur
        n'a accumulé aucune image (rien à faire, cas normal d'une
        cellule sans capture)."""
        _sortie_accumulee = getattr(moteur, "_sortie_accumulee", None)
        log_cellule.info(
            f"[_reafficher_image_si_presente] moteur={moteur!r} "
            f"_sortie_accumulee_is_none={_sortie_accumulee is None} "
            f"_sortie_accumulee_len={len(_sortie_accumulee) if _sortie_accumulee else 0}"
        )
        if not _sortie_accumulee or not any(
            isinstance(e, tuple) and e and e[0] == "image" for e in _sortie_accumulee
        ):
            log_cellule.info("[_reafficher_image_si_presente] aucune entrée image trouvée -- return False, rien à faire.")
            return False
        html_compose = moteur._construire_sortie_affichage()
        log_cellule.info(
            f"[_reafficher_image_si_presente] HTML composé, len={len(html_compose)} "
            f"contient_img={'<img' in html_compose} debut={html_compose[:80]!r}"
        )
        widget.zone_sortie.setText(html_compose)
        log_cellule.info(
            f"[_reafficher_image_si_presente] setText() appliqué -- "
            f"zone_sortie.text_len_apres={len(widget.zone_sortie.text())} "
            f"bouton_replier.isChecked()={widget.bouton_replier.isChecked()}"
        )
        if not widget.bouton_replier.isChecked():
            widget.zone_sortie.show()
            widget.entete_sortie.show()
            log_cellule.info(
                f"[_reafficher_image_si_presente] APRES show() -- "
                f"zone_sortie.isVisible()={widget.zone_sortie.isVisible()} "
                f"zone_sortie.isHidden()={widget.zone_sortie.isHidden()} "
                f"zone_sortie.size()={widget.zone_sortie.size()} "
                f"entete_sortie.isVisible()={widget.entete_sortie.isVisible()}"
            )
            widget.zone_sortie.updateGeometry()
            widget.zone_sortie.update()
            widget.entete_sortie.update()
            widget.update()
            widget.updateGeometry()
            self.notebook_layout.activate()
            self.notebook_contenu.updateGeometry()
            self.notebook_contenu.adjustSize()
            self.notebook_contenu.update()
            self.notebook_scroll.viewport().update()
            log_cellule.info(
                f"[_reafficher_image_si_presente] APRES cascade update()/updateGeometry() -- "
                f"zone_sortie.size()={widget.zone_sortie.size()} "
                f"zone_sortie.geometry()={widget.zone_sortie.geometry()} "
                f"widget.size()={widget.size()} "
                f"notebook_contenu.size()={self.notebook_contenu.size()} "
                f"notebook_contenu.sizeHint()={self.notebook_contenu.sizeHint()} "
                f"notebook_scroll.viewport().size()={self.notebook_scroll.viewport().size()} "
                f"notebook_scroll.verticalScrollBar().value()={self.notebook_scroll.verticalScrollBar().value()} "
                f"notebook_scroll.verticalScrollBar().maximum()={self.notebook_scroll.verticalScrollBar().maximum()}"
            )
        else:
            log_cellule.info("[_reafficher_image_si_presente] bouton_replier coché -- pas de show(), reste replié.")
        return True

    def sur_log_execution_reseau_recu(self, session_id: str, _id_executant: str, ligne: str):
        # CORRECTIF (bug rapporté : print() dans une cellule batch/clone
        # n'apparaît jamais dans le notebook, alors que la cellule se
        # termine bien en succès) -- cause EXACTEMENT symétrique à celle
        # documentée dans sur_resultat_execution_reseau_recu ci-dessous :
        # une session lancée via _lancer_sequence_clone_profil n'est
        # enregistrée QUE dans self._sessions_execution_reseau_clone,
        # jamais dans self._sessions_execution_reseau. Ce handler ne
        # vérifiait que ce second registre -> cible=None systématique
        # pour toute session clone -> `return` silencieux -> la ligne de
        # stdout (message WebSocket notebook_distant_log, envoyé et reçu
        # avec succès) n'était jamais poussée dans moteur._sortie_
        # accumulee ni cellule.sortie. Le résultat final (ok=True),
        # envoyé séparément via notebook_distant_resultat, suivait lui
        # le bon chemin (cf. sur_resultat_execution_reseau_recu, déjà
        # corrigé) -- d'où l'observation "succès mais aucune sortie".
        # Fix : même routage clone-first que sur_resultat_execution_
        # reseau_recu -- le moteur clone est retrouvé DIRECTEMENT (pas
        # besoin de cellule_id/self._moteurs_en_cours, invalide en clone
        # où plusieurs profils exécutent la même cellule_id en
        # parallèle), et reçoit sa ligne via sur_log_recu comme le
        # chemin normal ci-dessous.
        moteur_clone = self._sessions_execution_reseau_clone.get(session_id)
        if moteur_clone is not None:
            moteur_clone.sur_log_recu(ligne)
            # CORRECTIF (bug rapporté : "son terminal affiche le cumuler
            # des resultat des autre clone dexecution au lieu daffihcer
            # uniquement pour lui") -- avant ce correctif, CHAQUE ligne
            # de log d'un moteur clone était poussée dans le terminal du
            # panneau de rendu réseau dès que ce panneau était ouvert,
            # sans distinction de profil -- contrairement au chemin
            # image (sur_image_execution_reseau_recu, cf. son filtre
            # moteur_clone.profil_nom != etat.profil_actif), aucun filtre
            # n'existait ici. Résultat : plusieurs profils clone exécutant
            # en parallèle (ex: iaX1, iaX2, iaX3...) écrivaient TOUS dans
            # le même terminal, peu importe lequel était réellement
            # affiché/actif. Fix : même garde-fou que le chemin image --
            # n'affiche que la ligne du profil ACTUELLEMENT actif dans le
            # TaskEditor courant.
            #
            # BUGFIX (audit clé composite) : moteur_clone.profil_nom est
            # le NOM NU (cf. MoteurExecutionCelluleReseau.__init__ et
            # docstring de _lancer_sequence_clone_profil), alors que
            # etat.profil_actif est désormais une CLÉ COMPOSITE (id_
            # executant::nom_profil, cf. _cle_profil_clone) depuis la
            # REFONTE MULTI-SAUTONIAX -- la comparaison directe échouait
            # donc TOUJOURS (nom nu != clé composite), et cette ligne de
            # log n'atteignait plus JAMAIS le terminal, quel que soit le
            # profil actif. Reconstruit la clé composite du moteur via
            # _cle_profil_clone avant de comparer.
            etat = self._executions_clone.get(moteur_clone.task.id)
            if (
                etat is not None
                and _cle_profil_clone(moteur_clone.id_executant, moteur_clone.profil_nom) == etat.profil_actif
                and self._task_courant == moteur_clone.task.id
                and self._fenetre_rendu_reseau is not None
            ):
                self._fenetre_rendu_reseau.panneau.ajouter_ligne_terminal(ligne)
            return
        cible = self._sessions_execution_reseau.get(session_id)
        if cible is None:
            return  # pas pour nous (autre écran, ou session déjà terminée/inconnue)
        task_id, cellule_id = cible
        moteur = self._moteurs_en_cours.get(cellule_id)
        if moteur is None or not isinstance(moteur, MoteurExecutionCelluleReseau):
            return
        moteur.sur_log_recu(ligne)
        # Affichage au fil de l'eau (même comportement que le moteur local,
        # qui écrit sur cellule.sortie/widget.afficher_resultat à CHAQUE
        # print() -- cf. MoteurExecutionCellule._thread_execution) : sans
        # ceci, la sortie n'apparaîtrait qu'au tout dernier moment (callback_
        # termine), ce qui casserait le suivi "en direct" déjà offert par
        # l'ancien NotebookDistantScreen (cf. sur_log_execution_recu).
        # `task_id` du tuple de session (PAS self._task_courant_obj()) --
        # même raison que sur_log_initialisation_reseau_recu : l'exécution
        # peut continuer en tâche de fond après que l'utilisateur ait changé
        # d'écran/de Task ouvert, cf. docstring de _sessions_initialisation_
        # reseau. cellule.sortie est mis à jour dans tous les cas (persiste
        # même Task fermé), le widget seulement si CE Task est encore affiché.
        task = self.project.find_task(task_id)
        if task is None:
            return
        cellule = self._trouver_cellule_par_id(task, cellule_id)
        if cellule is None:
            return
        cellule.sortie = "\n".join(e for e in moteur._sortie_accumulee if isinstance(e, str))
        if self._task_courant == task_id:
            widget = self._cellule_widgets.get(cellule_id)
            if widget is not None:
                widget.afficher_resultat(cellule)
                self._reafficher_image_si_presente(widget, moteur)
            # AJOUT (demande explicite utilisateur : "rajouter un terminal
            # de sortie lorsqu'on exécute un notebook sur une instance, le
            # terminal du panneau de task doit renvoyer les sorties de
            # cellule") -- pousse la même ligne, au fil de l'eau, dans le
            # terminal du panneau de rendu réseau (cf. PanneauRenduInstance.
            # ajouter_ligne_terminal/FenetreRenduTaskReseau.definir_
            # terminal_visible) si ce panneau est actuellement ouvert.
            # Même filtre que ci-dessus (self._task_courant == task_id) :
            # on n'affiche que la sortie du Task actuellement affiché,
            # jamais celle d'un autre Task qui continuerait en tâche de
            # fond (cf. docstring de _sessions_execution_reseau).
            if self._fenetre_rendu_reseau is not None:
                self._fenetre_rendu_reseau.panneau.ajouter_ligne_terminal(ligne)

    def _task_de_session_pont(self, session_id: str):
        moteur_clone = self._sessions_execution_reseau_clone.get(session_id)
        if moteur_clone is not None:
            return getattr(moteur_clone, "task", None)
        cible = self._sessions_execution_reseau.get(session_id)
        if cible is not None:
            return next((t for t in self.project.tasks if t.id == cible[0]), None)
        return None

    def _transit_drive_pilote(self):
        """TransitDrive du pilote (clé du compte de service des réglages), créé à la première utilisation."""
        drive = self.__dict__.get("_transit_drive")
        if drive is None:
            drive = self.__dict__["_transit_drive"] = TransitDrive.depuis_reglages()
        return drive

    def _service_pont_pour_session(self, session_id: str):
        """Service d'accès disque de la session (créé à la première demande, racines autorisées = chemins cités dans le
        code du Task). None si la session est inconnue."""
        services = self.__dict__.setdefault("_services_pont", collections.OrderedDict())
        service = services.get(session_id)
        if service is None:
            task = self._task_de_session_pont(session_id)
            if task is None:
                return None
            racines = []
            cellules = list(getattr(task, "cellules", None) or [])
            if getattr(task, "cellule_variables", None) is not None:
                cellules.append(task.cellule_variables)
            for c in cellules:
                racines.extend(extraire_racines_pont_depuis_code(getattr(c, "code", "") or ""))
            service = ServicePilotePont(racines)
            service.brancher_transit(self._transit_drive_pilote, lambda: self._client_serveur_t)
            services[session_id] = service
            while len(services) > 32:
                services.popitem(last=False)[1].fermer()
            log_cellule.info(f"[pont] session {session_id} : racines autorisées = {[r for _t, r in service.racines()]}")
        return service

    def _traiter_pont_live(self, session_id: str, id_executant: str, charge_json: str):
        """AJOUT (pont fichiers pilote <-> clone) -- côté PILOTE : un message « image » portant MARQUEUR_PONT_REQUETE
        est en réalité une demande d'accès fichier d'un clone. Exécutée dans un thread (jamais bloquer l'interface),
        la réponse repart par le serveurT. Jamais d'exception."""
        try:
            requete = json.loads(charge_json)
            if not isinstance(requete, dict):
                raise ValueError("demande non-objet")
        except ValueError as e:
            log_cellule.warning(f"[pont] demande illisible (session={session_id}) : {e!r}")
            return
        try:
            service = self._service_pont_pour_session(session_id)
        except Exception as e:
            log_cellule.warning(f"[pont] création du service impossible (session={session_id}) : {e!r}")
            service = None
        if service is None:
            self._envoyer_reponse_pont(id_executant, session_id, requete, {
                "ok": False, "refus": True, "errno": errno.EACCES, "exc": "PermissionError",
                "message": "session inconnue ou terminée côté pilote", "rid": requete.get("rid"),
            })
            return
        # PATCH « déclencheur » : une demande « bot_attente » dort jusqu'à 9 s côté PC. Dans le pool commun (8 fils), 8 agents qui attendent
        # suffiraient à bloquer TOUTES les opérations de fichier de tous les clones : elle a donc son propre pool.
        _args_req = requete.get("args") if isinstance(requete.get("args"), dict) else {}
        if requete.get("op") == "appel_logique" and _args_req.get("nom") == "bot_attente":
            pool = self.__dict__.get("_pool_pont_attente")
            if pool is None:
                pool = self.__dict__["_pool_pont_attente"] = concurrent.futures.ThreadPoolExecutor(max_workers=64, thread_name_prefix="pontw")
            pool.submit(self._executer_requete_pont, service, requete, session_id, id_executant)
            return
        pool = self.__dict__.get("_pool_pont")
        if pool is None:
            pool = self.__dict__["_pool_pont"] = concurrent.futures.ThreadPoolExecutor(max_workers=8, thread_name_prefix="pont")
        try:
            _file_diag = pool._work_queue.qsize()
        except Exception:
            _file_diag = -1
        _diag_pont_etape(requete.get("rid"), "2b/5 soumis au pool", f"(file d'attente du pool={_file_diag}, 8 threads max)")
        pool.submit(self._executer_requete_pont, service, requete, session_id, id_executant)

    def _executer_requete_pont(self, service, requete: dict, session_id: str, id_executant: str):
        try:
            _rid_d = requete.get("rid")
            _diag_pont_etape(_rid_d, "3/5 début exécution")
            _t_exec = time.perf_counter()
            reponse = service.traiter(requete)
            if reponse is None:
                log_pont_diag.info(f"[PONT-DIAG] doublon en cours rid={str(_rid_d)[:8]} : réponse partira à la fin du 1er traitement")
                return      # doublon d'une demande déjà en cours : la réponse partira à la fin du premier traitement
            _diag_pont_etape(_rid_d, "4/5 fin exécution  ", f"(exécution seule = {(time.perf_counter() - _t_exec) * 1000:.0f} ms, ok={reponse.get('ok')})")
            if reponse.get("refus"):
                log_cellule.warning(
                    f"[pont] accès REFUSÉ (session={session_id}, op={requete.get('op')}) : {reponse.get('message')} -- "
                    f"ajoutez le dossier dans PILOTE_DOSSIERS_AUTORISES (cellule variables) ou citez-le dans le code."
                )
            self._envoyer_reponse_pont(id_executant, session_id, requete, reponse)
            _diag_pont_etape(_rid_d, "5/5 réponse envoyée", "(ws.send programmé vers le serveurT)")
        except Exception as e:
            log_cellule.warning(f"[pont] échec de traitement (session={session_id}, op={requete.get('op')}) : {e!r}")

    def _envoyer_reponse_pont(self, id_executant: str, session_id: str, requete: dict, reponse: dict):
        message = dict(reponse)
        message.update(id_executant=id_executant, session_id=session_id, instance_id=requete.get("instance_id", ""))
        client = self._client_serveur_t
        if client is None or not client.envoyer_pont_reponse(message):
            log_cellule.warning(f"[pont] réponse non envoyée (op={requete.get('op')}) -- le clone renverra sa demande.")

    def _traiter_resultat_live(self, session_id: str, charge_json: str):
        """AJOUT (envoi en direct, cf. _fabriquer_envoyer_resultat) -- côté PILOTE : un message
        « image » portant MARQUEUR_RESULTAT_LIVE est en réalité un résultat envoyé par le script
        via envoyer_resultat(). Retrouve le Task de la session (clone ou simple) puis le range
        comme un RESULT_OUTPUT de fin de lot (RESULT_OUTPUT_HANDLER, sinon RESULT_SAVE_PATH).
        Jamais d'exception ; tout échec est journalisé ET ajouté à la sortie du profil/cellule."""
        try:
            payload = json.loads(charge_json)
        except ValueError as e:
            log_cellule.warning(f"[envoyer_resultat] charge illisible (session={session_id}) : {e!r}")
            return
        task = None
        nom_profil = ""
        afficher = None
        moteur_clone = self._sessions_execution_reseau_clone.get(session_id)
        if moteur_clone is not None:
            task = getattr(moteur_clone, "task", None)
            nom_profil = getattr(moteur_clone, "profil_nom", "") or ""
            afficher = moteur_clone.sur_log_recu
        else:
            cible = self._sessions_execution_reseau.get(session_id)
            if cible is not None:
                task_id, cellule_id = cible
                task = next((t for t in self.project.tasks if t.id == task_id), None)
                moteur = self._moteurs_en_cours.get(cellule_id)
                if moteur is not None and hasattr(moteur, "sur_log_recu"):
                    afficher = moteur.sur_log_recu
        if task is None:
            log_cellule.warning(f"[envoyer_resultat] session inconnue (session={session_id}) -- résultat ignoré.")
            return
        try:
            self._ranger_result_output_pilote(task, None, payload, nom_profil or getattr(task, "nom", "") or "task", afficher)
        except Exception as e:
            log_cellule.warning(f"[envoyer_resultat] échec de rangement (session={session_id}) : {e!r}")

    def sur_image_execution_reseau_recu(self, session_id: str, _id_executant: str, image_b64: str):
        """PATCH (demande explicite utilisateur : "pourquoi tu na pas
        affhcer plutot dans la sortie de la cellule du notebbok" -- PAS le
        terminal séparé de FenetreRenduTaskReseau, revert de la décision
        précédente qui écrivait uniquement dans ce terminal) -- même
        routage EXACT que sur_log_execution_reseau_recu ci-dessus
        (filtre session_id -> (task_id, cellule_id) -> moteur), mais
        pousse vers moteur.sur_image_recue (cf. sa docstring pour le
        détail : ajoute un tuple ("image", b64) à moteur._sortie_
        accumulee, distinct d'une ligne de texte brut).

        cellule.sortie (persistance) reste TEXTE PUR : les entrées image
        sont filtrées avant le join, exactement comme sur_resultat_recu
        le fait déjà côté MoteurExecutionCelluleReseau -- une balise
        <img> base64 dans cellule.sortie romprait ce contrat pour tout
        code qui logue/relit cette sortie (export, recherche...).

        L'AFFICHAGE (zone_sortie du widget, si ce Task est actuellement
        ouvert) est en revanche posé directement avec le HTML composé
        par moteur._construire_sortie_affichage() -- PAS via widget.
        afficher_resultat(cellule), qui écraserait avec cellule.sortie
        (texte brut, sans l'image) : afficher_resultat gère aussi l'état
        du bouton/spin/couleur d'indicateur, donc appelée d'abord pour
        ça, puis le texte de zone_sortie est remplacé par la version
        HTML juste après.

        CORRECTIF (même bug/même cause que sur_log_execution_reseau_recu
        ci-dessus, malgré ce que dit le paragraphe "même routage EXACT"
        au-dessus : cette fonction ne consultait en réalité QUE self.
        _sessions_execution_reseau, jamais self._sessions_execution_
        reseau_clone -- une session clone perdait donc silencieusement
        toute image capturée en cours de cellule, pas seulement les
        lignes de texte). Fix : routage clone-first identique."""
        if isinstance(image_b64, str) and image_b64.startswith(MARQUEUR_RESULTAT_LIVE):
            # AJOUT (envoyer_resultat) -- pas une image : résultat envoyé en direct par le script.
            self._traiter_resultat_live(session_id, image_b64[len(MARQUEUR_RESULTAT_LIVE):])
            return
        if isinstance(image_b64, str) and image_b64.startswith(MARQUEUR_PONT_REQUETE):
            _m_diag = _RE_DIAG_RID_OP.match(image_b64[len(MARQUEUR_PONT_REQUETE):][:200])
            if _m_diag:
                _diag_pont_etape(_m_diag.group(1), "2/5 thread GUI    ", "(= attente de l'event loop Qt)")
            self._traiter_pont_live(session_id, _id_executant, image_b64[len(MARQUEUR_PONT_REQUETE):])
            return
        moteur_clone = self._sessions_execution_reseau_clone.get(session_id)
        if moteur_clone is not None:
            moteur_clone.sur_image_recue(image_b64)
            log_cellule.info(f"[clone] image reçue (session={session_id}) -- ajoutée à moteur._sortie_accumulee.")
            # BUGFIX (bug rapporté : "je ne vois pas cette image dans les
            # sorties de cellule" en mode profil actif/clone) -- avant ce
            # patch, ce chemin s'arrêtait ICI (return immédiat) : l'image
            # était bien accumulée dans moteur_clone._sortie_accumulee
            # (cf. log ci-dessus, confirmé présent dans les logs
            # utilisateur) mais JAMAIS pousée vers un widget visible --
            # tout le code d'affichage (afficher_resultat +
            # _reafficher_image_si_presente) qui suit plus bas dans cette
            # fonction est écrit pour le chemin _sessions_execution_
            # reseau (mode simple, un seul moteur par cellule) et n'était
            # jamais atteint ici.
            #
            # Choix produit explicite (plusieurs profils clone peuvent
            # exécuter la MÊME cellule en parallèle, donc il n'existe pas
            # UNE sortie de cellule à alimenter -- afficher les 5 en
            # même temps écraserait sans arrêt la même zone_sortie) :
            # n'afficher QUE l'image du profil actuellement actif dans
            # le TaskEditor (etat.profil_actif) -- les images des autres
            # profils restent accumulées dans leur moteur respectif tant
            # qu'il tourne encore (cf. _definir_profil_actif, qui les
            # réaffiche si ce profil devient actif à son tour).
            #
            # LIMITE CONNUE, non couverte par ce correctif : si la
            # cellule de ce profil non-actif se TERMINE avant que
            # l'utilisateur ne sélectionne ce profil, moteur_courant
            # repasse à None (cf. _callback_termine juste au-dessus dans
            # ce fichier) et son _sortie_accumulee (donc l'image) part
            # avec lui -- seul cellule_temp.sortie (texte pur, jamais
            # l'image, cf. sa construction) survit dans cellules_
            # resultats. Réafficher une image après coup pour un profil
            # déjà terminé nécessiterait de conserver le dernier
            # image_b64 par cellule dans CloneProfilEtat lui-même (un
            # champ dédié existe déjà pour le rendu œil, derniere_image_
            # b64, mais il est UN SEUL par profil, pas par cellule --
            # hors périmètre de ce correctif ponctuel).
            # CORRECTIF (audit clé composite) : moteur_clone.profil_nom
            # est le NOM NU (cf. MoteurExecutionCelluleReseau.__init__),
            # alors que etat.profil_actif est une CLÉ COMPOSITE (id_
            # executant::nom_profil) depuis la REFONTE MULTI-SAUTONIAX --
            # la comparaison directe échouait TOUJOURS, donc cette image
            # n'était plus JAMAIS affichée dans le notebook, quel que
            # soit le profil réellement actif. Reconstruit la clé
            # composite du moteur via _cle_profil_clone avant comparaison
            # (même correctif que sur_log_execution_reseau_recu ci-dessus).
            etat = self._executions_clone.get(moteur_clone.task.id)
            if etat is None or _cle_profil_clone(moteur_clone.id_executant, moteur_clone.profil_nom) != etat.profil_actif:
                return
            if self._task_courant != moteur_clone.task.id:
                return
            widget = self._cellule_widgets.get(moteur_clone.cellule_id)
            if widget is None:
                return
            cellule = self._trouver_cellule_par_id(moteur_clone.task, moteur_clone.cellule_id)
            if cellule is None:
                return
            cellule.sortie = "\n".join(e for e in moteur_clone._sortie_accumulee if isinstance(e, str))
            widget.afficher_resultat(cellule)
            self._reafficher_image_si_presente(widget, moteur_clone)
            # CORRECTIF (bug rapporté : "lorsque je ouvre le panneau de
            # rendue fentretaskrendueresaau sa affihce limage de lancien
            # ouverture de du derniere profils que jai ouvert ... sa ne
            # se met pas a jour") -- avant ce correctif, cette image
            # d'une cellule .view() en cours (moteur_clone._sortie_
            # accumulee) n'était poussée QUE vers le widget de cellule du
            # notebook (juste au-dessus), jamais vers self._fenetre_
            # rendu_reseau -- contrairement à sur_capture_reseau_recue
            # (capture "live" basée sur instance_id), qui lui pousse bien
            # vers definir_image() quand profil_actif_instance_id
            # correspond. Résultat : pendant qu'un profil clone exécute
            # une cellule avec .view(), le panneau de rendu (s'il est
            # ouvert) restait figé sur la toute dernière capture reçue
            # AVANT ce .view() -- potentiellement celle d'un tout autre
            # profil consulté précédemment, d'où l'"image de l'ancienne
            # ouverture du dernier profil" rapportée. On réutilise le
            # même filtre de profil actif que ci-dessus (déjà vérifié :
            # moteur_clone.profil_nom == etat.profil_actif et Task
            # courant) avant de pousser cette même image vers le panneau
            # de rendu, si celui-ci est ouvert.
            if self._fenetre_rendu_reseau is not None:
                _derniere_image_clone = None
                for _entree in moteur_clone._sortie_accumulee or []:
                    if isinstance(_entree, tuple) and _entree and _entree[0] == "image":
                        _derniere_image_clone = _entree[1]
                if _derniere_image_clone is not None:
                    self._fenetre_rendu_reseau.definir_image(_derniere_image_clone)
            return
        cible = self._sessions_execution_reseau.get(session_id)
        if cible is None:
            log_cellule.warning(
                f"[image] session={session_id} : aucune cible dans _sessions_execution_reseau "
                f"-- image reçue mais abandonnée (session déjà purgée, ou jamais enregistrée)."
            )
            return  # pas pour nous (autre écran, ou session déjà terminée/inconnue)
        task_id, cellule_id = cible
        moteur = self._moteurs_en_cours.get(cellule_id)
        if moteur is None or not isinstance(moteur, MoteurExecutionCelluleReseau):
            log_cellule.warning(
                f"[{cellule_id}] session={session_id} : moteur introuvable dans "
                f"_moteurs_en_cours (déjà retiré par callback_termine ?) -- image abandonnée."
            )
            return
        moteur.sur_image_recue(image_b64)
        log_cellule.info(f"[{cellule_id}] image reçue (session={session_id}) -- ajoutée à moteur._sortie_accumulee.")
        task = self.project.find_task(task_id)
        if task is None:
            log_cellule.warning(f"[{cellule_id}] session={session_id} : task_id={task_id!r} introuvable dans le projet -- affichage abandonné.")
            return
        cellule = self._trouver_cellule_par_id(task, cellule_id)
        if cellule is None:
            log_cellule.warning(f"[{cellule_id}] session={session_id} : cellule introuvable dans task {task_id!r} -- affichage abandonné.")
            return
        cellule.sortie = "\n".join(e for e in moteur._sortie_accumulee if isinstance(e, str))
        log_cellule.info(
            f"[{cellule_id}] === DEBUT diagnostic affichage image === "
            f"self._task_courant={self._task_courant!r} task_id={task_id!r} egaux={self._task_courant == task_id} "
            f"cellule_id_in_cellule_widgets={cellule_id in self._cellule_widgets} "
            f"nb_cellule_widgets={len(self._cellule_widgets)} "
            f"clefs_cellule_widgets={list(self._cellule_widgets.keys())}"
        )
        if self._task_courant == task_id:
            widget = self._cellule_widgets.get(cellule_id)
            log_cellule.info(f"[{cellule_id}] widget={widget!r} (type={type(widget).__name__ if widget is not None else 'None'})")
            if widget is not None:
                log_cellule.info(
                    f"[{cellule_id}] AVANT afficher_resultat -- "
                    f"widget.isVisible()={widget.isVisible()} widget.size()={widget.size()} "
                    f"zone_sortie.isVisible()={widget.zone_sortie.isVisible()} zone_sortie.text_len={len(widget.zone_sortie.text())} "
                    f"bouton_replier.isChecked()={widget.bouton_replier.isChecked()} "
                    f"cellule.sortie={cellule.sortie!r} (len={len(cellule.sortie)})"
                )
                widget.afficher_resultat(cellule)
                log_cellule.info(
                    f"[{cellule_id}] APRES afficher_resultat -- "
                    f"zone_sortie.isVisible()={widget.zone_sortie.isVisible()} zone_sortie.text_len={len(widget.zone_sortie.text())} "
                    f"entete_sortie.isVisible()={widget.entete_sortie.isVisible()}"
                )
                log_cellule.info(
                    f"[{cellule_id}] moteur._sortie_accumulee AVANT reafficher -- "
                    f"len={len(moteur._sortie_accumulee)} "
                    f"types={[('image' if isinstance(e, tuple) else 'str') for e in moteur._sortie_accumulee]}"
                )
                reposee = self._reafficher_image_si_presente(widget, moteur)
                log_cellule.info(
                    f"[{cellule_id}] APRES _reafficher_image_si_presente -- reposee={reposee} "
                    f"zone_sortie.isVisible()={widget.zone_sortie.isVisible()} "
                    f"zone_sortie.size()={widget.zone_sortie.size()} "
                    f"zone_sortie.geometry()={widget.zone_sortie.geometry()} "
                    f"zone_sortie.text_len={len(widget.zone_sortie.text())} "
                    f"zone_sortie.text_contient_img={'<img' in widget.zone_sortie.text()} "
                    f"entete_sortie.isVisible()={widget.entete_sortie.isVisible()} "
                    f"widget.isVisible()={widget.isVisible()} widget.size()={widget.size()} "
                    f"widget.parentWidget()={widget.parentWidget()!r}"
                )
                # Chaine complete des parents jusqu'à la fenêtre, avec
                # visibilité ET géométrie de chacun -- diagnostic complet
                # demandé explicitement, pas une ligne minimaliste.
                _p = widget.zone_sortie
                _niveau = 0
                while _p is not None:
                    log_cellule.info(
                        f"[{cellule_id}] PARENT[{_niveau}] {type(_p).__name__} "
                        f"visible={_p.isVisible()} isHidden={_p.isHidden()} "
                        f"size={_p.size()} geometry={_p.geometry()}"
                    )
                    _p = _p.parentWidget()
                    _niveau += 1
                log_cellule.info(f"[{cellule_id}] === FIN diagnostic affichage image ===")
            else:
                log_cellule.warning(f"[{cellule_id}] task_courant OK mais widget introuvable dans _cellule_widgets -- image non affichée.")
        else:
            log_cellule.warning(f"[{cellule_id}] task_courant={self._task_courant!r} != task_id={task_id!r} -- image non affichée (autre Task ouvert).")

    def sur_resultat_execution_reseau_recu(self, session_id: str, _id_executant: str, ok: bool, message: str,
                                            horodatage_debut: Optional[float] = None,
                                            horodatage_fin: Optional[float] = None,
                                            result_color: Optional[str] = None,
                                            result_output: Optional[dict] = None):
        """CORRECTIF (bug rapporté : Image.view() ne s'affiche jamais
        dans la sortie de la cellule, sans la moindre erreur nulle part)
        -- cause : notebook_distant_image et notebook_distant_resultat
        sont deux messages WebSocket INDÉPENDANTS envoyés très proches
        dans le temps (un screenshot()+.view() juste avant la fin d'un
        script court, cf. logs : capture puis fin de notebook à la même
        seconde) ; rien ne garantit que le premier soit TRAITÉ côté
        pilote avant le second (deux emit() de signaux Qt séparés,
        aucune relation d'ordre imposée). Si notebook_distant_resultat
        est traité EN PREMIER, ce handler purgeait jusqu'ici IMMÉDIATEMENT
        self._sessions_execution_reseau -- un message image arrivant
        juste après trouvait alors cible=None dans sur_image_execution_
        reseau_recu et était silencieusement abandonné (return, aucune
        erreur, aucun log).

        Fix : le retrait de session_id de self._sessions_execution_reseau
        est retardé de quelques secondes (QTimer.singleShot) plutôt
        qu'immédiat -- laisse le temps à une image en vol d'être traitée
        avant que le routage ne disparaisse. moteur.sur_resultat_recu(...)
        (qui déclenche in fine callback_termine/_moteurs_en_cours.pop,
        cf. _executer_cellule) reste, lui, appelé IMMÉDIATEMENT comme
        avant -- seul le mapping de ROUTAGE session_id -> (task_id,
        cellule_id) est prolongé ici, pas le moteur lui-même : cf.
        sur_image_execution_reseau_recu, qui doit donc aussi retrouver
        son moteur autrement qu'via self._moteurs_en_cours une fois
        celui-ci retiré -- cf. sa propre docstring.

        LOGS DIAGNOSTIC (retour utilisateur : bouton Run qui tourne sans
        jamais s'arrêter en mode réseau) -- ce handler est le SEUL chemin
        par lequel un résultat réseau (succès ou échec) peut débloquer le
        spinner du bouton ▶ (cf. moteur.sur_resultat_recu -> _sur_
        resultat_pret -> callback_termine -> _moteurs_en_cours.pop). Les
        deux `return` ci-dessous sont des sorties SILENCIEUSES existantes
        (aucun log avant ce correctif) : si le bug observé est bien "le
        spinner ne s'arrête jamais", il se manifeste très probablement
        par l'un de ces deux cas, ou par le fait que cette fonction ne
        soit jamais appelée du tout (à vérifier via le log d'ENTRÉE
        ci-dessous, comparé au log '<- notebook_distant_resultat' déjà
        émis côté ClientServeurT.notebook_distant_resultat_recu.emit)."""
        _sync_diag_slot(session_id)  # [SYNC-DIAG]
        log_cellule.info(
            f"[reseau][resultat] ENTRÉE sur_resultat_execution_reseau_recu -- "
            f"session_id={session_id!r} id_executant={_id_executant!r} ok={ok!r} message={message!r} "
            f"-- sessions_connues={list(self._sessions_execution_reseau.keys())!r} "
            f"-- sessions_clone_connues={list(self._sessions_execution_reseau_clone.keys())!r}"
        )
        # CORRECTIF (bug confirmé en prod : spinner du panneau clone
        # bloqué en permanence -- cf. docstring de _sessions_execution_
        # reseau_clone) -- routage clone vérifié EN PREMIER : un
        # session_id de ce registre ne sera JAMAIS dans self._sessions_
        # execution_reseau (routages mutuellement exclusifs, générés par
        # deux chemins de lancement différents -- _executer_cellule vs
        # _lancer_sequence_clone_profil), donc aucun risque de conflit à
        # vérifier celui-ci d'abord. Le moteur est retrouvé DIRECTEMENT
        # (pas besoin de repasser par cellule_id/self._moteurs_en_cours,
        # qui ne supportent qu'un seul moteur actif par cellule_id --
        # invalide en clone où plusieurs profils exécutent la même
        # cellule_id en parallèle).
        moteur_clone = self._sessions_execution_reseau_clone.get(session_id)
        if moteur_clone is not None:
            log_cellule.info(
                f"[reseau][resultat][clone] session_id={session_id!r} -> moteur clone trouvé directement, "
                f"appel moteur.sur_resultat_recu(ok={ok!r}, message={message!r})"
            )
            # AJOUT (spec B.2, colonne "Temps"; étendu SPEC_lot_
            # corrections_2026-09.md section 11 pour result_color) --
            # transmis tel quel au moteur clone, qui les reporte dans le
            # dict `resultat` remis à _callback_termine (cf. _lancer_
            # sequence_clone_profil) ; None si le sAutoniax n'a pas
            # fourni ces champs (ancien sAutoniax, cellule intermédiaire
            # du lot pour result_color, ou chemin d'échec avant
            # exécution, cf. les sites d'émission de notebook_distant_
            # resultat_recu).
            # AJOUT (retour utilisateur : même besoin que le log jumeau
            # côté sAutoniax, cf. sa docstring dans _sautoniax_executer_
            # notebook_distant_sur_instance_isolee) -- motif [RESULT_COLOR]
            # en .info(), visible par défaut sans AUTONIAX_DEBUG=1, côté
            # PILOTE cette fois : confirme ce que CE process a reçu du
            # sAutoniax pour ce session_id précis, juste avant de le
            # transmettre au moteur clone (qui l'écrira ensuite dans
            # profil_etat.result_color UNIQUEMENT si cette cellule était
            # la dernière du lot -- cf. _lancer_sequence_clone_profil/
            # _callback_termine). None ici est un état normal et attendu
            # pour toute cellule qui n'est PAS la dernière du lot -- ne
            # signale un problème que si None apparaît alors que cette
            # ligne correspond à la DERNIÈRE cellule envoyée pour ce
            # profil (comparer avec le log [RESULT_COLOR] émis côté
            # sAutoniax pour la même session_id).
            log_cellule.info(
                f"[RESULT_COLOR] pilote -- session_id={session_id!r} reçu du sAutoniax : "
                f"result_color={result_color!r}."
            )
            moteur_clone.sur_resultat_recu(ok, message, horodatage_debut, horodatage_fin, result_color, result_output)
            # Pas de pop ici : _callback_termine (déclenché par
            # sur_resultat_recu -> _sur_resultat_pret -> callback) s'en
            # charge déjà lui-même, cf. docstring de _sessions_execution_
            # reseau_clone -- un pop en double ici serait inoffensif
            # (dict.pop avec défaut) mais inutile.
            return
        cible = self._sessions_execution_reseau.get(session_id)
        if cible is None:
            log_cellule.warning(
                f"[reseau][resultat] ARRÊT session_id={session_id!r} -- absent de "
                f"self._sessions_execution_reseau (jamais enregistré, ou déjà purgé par le "
                f"QTimer.singleShot(5000) d'un résultat précédent) -- résultat IGNORÉ, spinner "
                f"potentiellement bloqué si c'est le seul résultat attendu pour cette cellule"
            )
            return  # pas pour nous
        _task_id, cellule_id = cible
        log_cellule.info(
            f"[reseau][resultat] session_id={session_id!r} -> cible trouvée (task_id={_task_id!r}, cellule_id={cellule_id!r})"
        )
        moteur = self._moteurs_en_cours.get(cellule_id)
        if moteur is None or not isinstance(moteur, MoteurExecutionCelluleReseau):
            log_cellule.warning(
                f"[reseau][resultat] ARRÊT cellule_id={cellule_id!r} -- moteur={moteur!r} "
                f"(None ou type inattendu, attendu MoteurExecutionCelluleReseau) dans "
                f"self._moteurs_en_cours -- résultat IGNORÉ, self._sessions_execution_reseau "
                f"purgé immédiatement pour ce session_id, spinner potentiellement bloqué"
            )
            self._sessions_execution_reseau.pop(session_id, None)
            return
        log_cellule.info(
            f"[reseau][resultat] cellule_id={cellule_id!r} -- moteur trouvé, appel moteur.sur_resultat_recu(ok={ok!r}, message={message!r})"
        )
        moteur.sur_resultat_recu(ok, message)
        # AJOUT (même terminal que sur_log_execution_reseau_recu ci-dessus)
        # -- affiche le résultat final (succès/échec) dans le terminal du
        # panneau de rendu réseau, pour que l'utilisateur sache que la
        # cellule est terminée sans avoir à regarder l'éditeur de notebook.
        if _task_id == self._task_courant and self._fenetre_rendu_reseau is not None:
            prefixe = "[OK]" if ok else "[ERREUR]"
            self._fenetre_rendu_reseau.panneau.ajouter_ligne_terminal(f"{prefixe} {message}")
        QTimer.singleShot(5000, lambda: self._sessions_execution_reseau.pop(session_id, None))

    def sur_capture_reseau_recue(self, id_executant: str, _nom_executant: str, instance_id: str, image_b64: str):
        """Branché par MainWindow sur ClientServeurT.capture_recue (même
        signal que ReceptionScreen/NotebookDistantScreen -- Signal(str,
        str, str, str), cf. capture_recue déclaré côté ClientServeurT :
        (id_executant, nom_executant, instance_id, image_b64). Seuls
        id_executant et image_b64 sont utiles ici -- même choix que
        NotebookDistantScreen.sur_capture_recue) -- pousse la capture au
        panneau de rendu flottant s'il est ouvert ET ciblé sur ce
        sAutoniax (ou sur le profil actif, cf. section 5 de la spec).

        `instance_id` sert à maintenir à jour CloneProfilEtat.derniere_
        image_b64 de chaque profil (déjà correct, inchangé) ET, cf.
        SPEC_profils_environnements.md section 5 : à pousser directement
        vers self._fenetre_rendu_reseau (fenêtre UNIQUE désormais, plus
        de fenêtre séparée par profil, section 2.1/12) quand un profil
        est actif et que cette capture correspond à SON instance_id."""
        self._dernieres_captures_reseau[id_executant] = image_b64

        etat = self._executions_clone.get(self._task_courant)
        profil_actif_instance_id = ""
        if etat is not None and instance_id:
            # BUGFIX (REFONTE MULTI-SAUTONIAX) -- ne compare plus
            # seulement instance_id : la docstring de CloneProfilEtat.
            # instance_id documente elle-même que "instance_id ==
            # id_executant" (implicitement, l'unicité d'instance_id) est
            # "caduque en multi-profils/multi-sAutoniax" -- rien ne
            # garantit qu'un instance_id soit unique CROSS-sAutoniax.
            # Sans id_executant dans la comparaison, une collision
            # écrirait derniere_image_b64 sur le MAUVAIS profil (et,
            # pire, pousserait potentiellement la mauvaise image dans le
            # rendu vidéo si ce profil homonyme était l'actif) dès que
            # deux sAutoniax différents partagent par malchance le même
            # instance_id. Même correctif de fond que _traiter_reception_
            # capture_masse (clé composite), appliqué ici à la source.
            for nom_profil, profil_etat in etat.profils.items():
                if profil_etat.instance_id == instance_id and profil_etat.id_executant_sautoniax == id_executant:
                    profil_etat.derniere_image_b64 = image_b64
                    self._traiter_reception_capture_masse(id_executant, instance_id, image_b64)
                    if etat.profil_actif == nom_profil:
                        profil_actif_instance_id = instance_id
                    break

        if self._fenetre_rendu_reseau is None:
            return
        task = self._task_courant_obj()
        if task is None or task.mode_execution != "reseau":
            return
        # PATCH (retrait de combo_executant_reseau) -- l'ancien garde-fou
        # (a) "rendu ciblant le sAutoniax choisi dans le combo, pertinent
        # sans profil actif" est retiré : seul (b) subsiste, un profil
        # actif existe et cette capture correspond précisément à son
        # instance_id.
        log_reseau_t.info(
            f"[DIAG capture rendu direct #3 clone] recu id_executant={id_executant!r} instance_id={instance_id!r} "
            f"-> profil_actif_instance_id={profil_actif_instance_id!r} "
            f"-> match={bool(profil_actif_instance_id) and profil_actif_instance_id == instance_id}"
        )
        if profil_actif_instance_id and profil_actif_instance_id == instance_id:
            self._fenetre_rendu_reseau.definir_image(image_b64)

    def _cible_rendu_reseau_actuelle(self) -> tuple:
        """SPEC_profils_environnements.md section 5 : point unique de
        résolution de la cible (id_executant, instance_id) du panneau de
        rendu réseau -- appelé à CHAQUE émission (jamais mémorisé), pour
        que le rendu suive un changement de profil actif pendant que la
        fenêtre reste ouverte.

        Si un profil est actif : (id_executant_sautoniax DE CE PROFIL,
        instance_id réel de ce profil) -- REFONTE MULTI-SAUTONIAX, chaque
        profil peut désormais venir d'un sAutoniax différent des autres
        du même lot (cf. docstring de CloneProfilEtat.id_executant_
        sautoniax), donc la cible doit suivre LE profil actif, pas un
        sAutoniax unique pour tout le lot.

        PATCH (retrait de combo_executant_reseau, demande explicite
        utilisateur -- ce combo ne pilotait de toute façon PAS le
        profil actif, cf. docstring de self.combo_executant_reseau dans
        __init__) : l'ancienne "convention mono-profil" de repli (sans
        profil actif, cibler le sAutoniax choisi dans le combo) n'a
        plus de source -- retourne ("", "") si aucun profil n'est
        actif, le panneau clone (seul sélecteur restant) étant la
        seule façon de désigner une cible."""
        task = self._task_courant_obj()
        etat = self._executions_clone.get(task.id) if task is not None else None
        profil_actif = etat.profil_actif if etat is not None else None
        if profil_actif:
            profil_etat = etat.profils.get(profil_actif)
            id_executant_cible = profil_etat.id_executant_sautoniax if profil_etat is not None else ""
            instance_id_cible = profil_etat.instance_id if profil_etat is not None else ""
            return id_executant_cible, instance_id_cible
        return "", ""

    def sur_command_result_reseau(self, data: dict):
        """PATCH (liste déroulante d'onglet actif) -- connecté
        directement (self._client_serveur_t) à ClientServeurT.command_
        result_recu (signal GLOBAL, tous les command_result confondus,
        cf. sa docstring). Filtre sur les requete_id des commandes
        listTabs/switchTab émises par _demander_liste_onglets_reseau/
        _sur_onglet_reseau_change (cf. _sur_clic_voir_rendu_reseau
        ci-dessous), ignore tout le reste -- même patron EXACT que
        PanneauProprietesSautoniax.sur_command_result_reseau."""
        _fen_copie = getattr(self, "_fenetre_rendu_reseau", None)
        if _fen_copie is not None and _fen_copie.traiter_resultat_copie_distante(data):
            return  # PATCH Ctrl+C : réponse traitée
        if self._fenetre_rendu_reseau is None:
            return
        panneau = self._fenetre_rendu_reseau.panneau
        requete_id = data.get("requete_id")
        if requete_id == getattr(self, "_requete_id_liste_onglets_reseau", None):
            self._requete_id_liste_onglets_reseau = None
            if not data.get("ok", False):
                panneau.label_statut_onglets.definir_texte(f"Échec : {data.get('error', 'erreur inconnue')}")
                panneau.label_statut_onglets.setStyleSheet(f"color: {Mocha.red}; font-size: 11px;")
                return
            onglets = data.get("result") or []
            combo = panneau.onglet_combo
            combo.blockSignals(True)
            combo.clear()
            id_actif = None
            for onglet in onglets:
                titre = onglet.get("titre") or onglet.get("url") or onglet.get("id", "")
                libelle = titre if len(titre) <= 50 else titre[:47] + "…"
                combo.addItem(libelle, onglet.get("id"))
                if onglet.get("actif"):
                    id_actif = onglet.get("id")
            if not onglets:
                combo.addItem("Aucun onglet ouvert", None)
            index_actif = combo.findData(id_actif) if id_actif else -1
            combo.setCurrentIndex(max(0, index_actif))
            combo.blockSignals(False)
            combo.setEnabled(len(onglets) > 0)
            panneau.label_statut_onglets.definir_texte(f"{len(onglets)} onglet(s) trouvé(s).")
            panneau.label_statut_onglets.setStyleSheet(f"color: {Mocha.green}; font-size: 11px;")
        elif requete_id == getattr(self, "_requete_id_switch_onglet_reseau", None):
            self._requete_id_switch_onglet_reseau = None
            if not data.get("ok", False):
                panneau.label_statut_onglets.definir_texte(f"Échec du changement d'onglet : {data.get('error', 'erreur inconnue')}")
                panneau.label_statut_onglets.setStyleSheet(f"color: {Mocha.red}; font-size: 11px;")

    def _sur_clic_voir_rendu_reseau(self):
        task = self._task_courant_obj()
        if task is None:
            return
        if self._fenetre_rendu_reseau is None:
            self._fenetre_rendu_reseau = FenetreRenduTaskReseau(self)
            self._fenetre_rendu_reseau.fermeture_demandee.connect(self._sur_fermeture_rendu_reseau)
            self._fenetre_rendu_reseau.demande_rafraichissement.connect(self._sur_demande_rafraichissement_rendu_reseau)
            self._fenetre_rendu_reseau.taux_capture_change.connect(self._sur_taux_capture_reseau_change)
            # PATCH (recompression par pilote -- demande explicite
            # utilisateur, après une première tentative mal placée dans
            # l'onglet Instances sAutoniax de la sidebar : "je disait
            # que tu mets plutôt cest paramètre dans le panneau de
            # rendue" -- donc ICI, dans PanneauRenduInstance composé par
            # cette fenêtre, à côté de Rafraîchir/MODE/Taux). Rendu
            # visible UNIQUEMENT ici (jamais pour un rendu local, cf.
            # docstring de bande_reglages_capture) -- restauration du
            # dernier réglage connu (cf. ReglagesApp, persisté), sans
            # redéclencher le signal (definir_reglage_capture_initial),
            # puis câblage du signal vers ClientServeurT.definir_
            # preference_capture, avec persistance immédiate à chaque
            # changement (même patron que l'ancien câblage MainWindow
            # qu'il remplace).
            self._fenetre_rendu_reseau.panneau.definir_reglages_capture_reseau_visibles(True)
            # PATCH (demande explicite utilisateur : afficher nom/proxy/
            # pays du profil actif) -- même patron que definir_reglages_
            # capture_reseau_visibles ci-dessus.
            self._fenetre_rendu_reseau.panneau.definir_infos_profil_visibles(True)
            if self.reglages is not None:
                self._fenetre_rendu_reseau.panneau.definir_reglage_capture_initial(
                    self.reglages.preference_capture_resolution, self.reglages.preference_capture_qualite,
                )

            def _sur_demande_preference_capture(resolution: str, qualite: int):
                if self._client_serveur_t is not None:
                    self._client_serveur_t.definir_preference_capture(resolution, qualite)
                if self.reglages is not None:
                    self.reglages.preference_capture_resolution = resolution
                    self.reglages.preference_capture_qualite = qualite
                    self.reglages.save()

            self._fenetre_rendu_reseau.panneau.demande_preference_capture.connect(_sur_demande_preference_capture)

            # PATCH B.4 (contrôle à distance réel) -- câblage du signal
            # commande_controle_distance vers ClientServeurT.envoyer_
            # commande_instance, même patron que _sur_demande_preference_
            # capture juste au-dessus (fonction interne, capture self par
            # closure) -- id_executant et instance_id sont résolus ICI,
            # au moment de CHAQUE émission (pas mémorisés à l'ouverture) :
            # l'utilisateur peut changer de profil actif (panneau
            # Exécutions clone) pendant que la fenêtre de rendu reste
            # ouverte, la commande doit donc toujours partir vers la
            # cible ACTUELLE, jamais celle du moment de l'ouverture.
            def _sur_commande_controle_distance(payload: dict):
                if self._client_serveur_t is None:
                    return
                # SPEC_profils_environnements.md section 5 : relit
                # etat.profil_actif à CHAQUE émission (via
                # _cible_rendu_reseau_actuelle) -- un changement de
                # profil actif pendant que la fenêtre reste ouverte doit
                # être suivi immédiatement.
                id_executant_cible, instance_id_cible = self._cible_rendu_reseau_actuelle()
                if not id_executant_cible:
                    return
                self._client_serveur_t.envoyer_commande_instance(
                    id_executant_cible, instance_id_cible,
                    payload["requete_id"], payload["commande"],
                )

            self._fenetre_rendu_reseau.commande_controle_distance.connect(_sur_commande_controle_distance)

            # PATCH (liste déroulante d'onglet actif, cf. panneau.
            # bande_onglet.setVisible(True) dans FenetreRenduTaskReseau.
            # __init__) -- même protocole/même raisonnement que
            # PanneauProprietesSautoniax/ProjetsDistribuesScreen (cf.
            # leur propre câblage "Onglet navigateur distant"), adapté
            # ici : self._client_serveur_t est une référence DIRECTE
            # dans cette classe (contrairement aux deux écrans réseau qui
            # ne font que relayer via des signaux) -- appel direct à
            # envoyer_commande_instance/command_result_recu, pas de
            # signal intermédiaire ni de câblage MainWindow nécessaire.
            # SPEC_profils_environnements.md section 5 : id_executant_
            # cible/instance_id_cible résolus dynamiquement à CHAQUE
            # émission via _cible_rendu_reseau_actuelle() (même principe
            # que _sur_commande_controle_distance ci-dessus) -- suit
            # l'instance_id réelle du profil actif du panneau Exécutions
            # clone, y compris si ce profil actif change pendant que la
            # fenêtre reste ouverte (rien à afficher si aucun profil
            # n'est actif, cf. docstring de _cible_rendu_reseau_actuelle).
            self._requete_id_liste_onglets_reseau: Optional[str] = None
            self._requete_id_switch_onglet_reseau: Optional[str] = None

            def _demander_liste_onglets_reseau():
                if self._client_serveur_t is None:
                    return
                # Section 5 : relit la cible (sAutoniax + instance réelle
                # du profil actif s'il y en a un) à chaque émission.
                id_executant_cible, instance_id_cible = self._cible_rendu_reseau_actuelle()
                if not id_executant_cible:
                    return
                requete_id = uuid.uuid4().hex[:12]
                self._requete_id_liste_onglets_reseau = requete_id
                self._fenetre_rendu_reseau.panneau.label_statut_onglets.definir_texte("Récupération des onglets…")
                self._fenetre_rendu_reseau.panneau.label_statut_onglets.setStyleSheet(f"color: {Mocha.subtext0}; font-size: 11px;")
                self._client_serveur_t.envoyer_commande_instance(
                    id_executant_cible, instance_id_cible, requete_id, {"action": "listTabs"},
                )

            def _sur_onglet_reseau_change(_index: int):
                if self._client_serveur_t is None:
                    return
                combo = self._fenetre_rendu_reseau.panneau.onglet_combo
                tab_id = combo.currentData()
                id_executant_cible, instance_id_cible = self._cible_rendu_reseau_actuelle()
                if tab_id is None or not id_executant_cible:
                    return
                requete_id = uuid.uuid4().hex[:12]
                self._requete_id_switch_onglet_reseau = requete_id
                self._client_serveur_t.envoyer_commande_instance(
                    id_executant_cible, instance_id_cible, requete_id, {"action": "switchTab", "tabId": tab_id},
                )

            self._fenetre_rendu_reseau.panneau.onglet_combo.currentIndexChanged.connect(_sur_onglet_reseau_change)
            self._fenetre_rendu_reseau.panneau.onglet_combo.popup_ouvert.connect(_demander_liste_onglets_reseau)
            self._fenetre_rendu_reseau.panneau.rafraichir_onglets_button.clicked.connect(_demander_liste_onglets_reseau)
            self._fenetre_rendu_reseau.panneau.onglet_combo.setEnabled(True)
            self._fenetre_rendu_reseau.panneau.rafraichir_onglets_button.setEnabled(True)
            self._demander_liste_onglets_reseau_interne = _demander_liste_onglets_reseau
            if self._client_serveur_t is not None:
                self._client_serveur_t.commande_controle_distance_resultat_recu.connect(self.sur_command_result_reseau)  # BUGFIX: command_result_recu n'existe pas sur ClientServeurT

            # REFONTE (demande explicite utilisateur, cf. docstring de
            # FenetreRenduTaskReseau.afficher_par_dessus_tout) -- l'ancien
            # mode "onglet ApplicationsScreen <-> détaché" est retiré :
            # ce widget vit désormais TOUJOURS en overlay top-level
            # sans bordure, jamais dans self.tabs. Le bouton Détacher/
            # Réattacher n'a donc plus d'utilité et reste masqué (pas
            # d'appel à definir_bouton_detacher_visible(True)).
        # SPEC_profils_environnements.md section 5 : id_executant_cible/
        # instance_id_cible résolus via _cible_rendu_reseau_actuelle()
        # (sAutoniax + instance réelle du profil actif de la liste de
        # profils, ExecutionCloneEtat.profil_actif, s'il y en a un ; sinon
        # ("", ""), PATCH retrait combo_executant_reseau -- plus de
        # convention mono-profil de repli, cf. docstring de
        # _cible_rendu_reseau_actuelle). ATTENTION : ne pas confondre avec
        # self._profils_reseau_actifs ci-dessous, dict distinct et sans
        # rapport (le profil réseau lié à une instance côté serveur pour
        # l'ancien flux d'initialisation d'exécutant -- nom malheureusement
        # proche mais sémantique différente).
        id_executant_cible, instance_id_cible = self._cible_rendu_reseau_actuelle()
        nom = self._noms_executants_reseau.get(id_executant_cible, "") if id_executant_cible else ""
        self._fenetre_rendu_reseau.titre_label.setText(f"sAutoniax : {nom}" if nom else "Aucun sAutoniax sélectionné")
        # PATCH (demande explicite utilisateur : afficher nom/proxy/pays
        # du profil actif) -- self._profils_reseau_actifs mappe déjà
        # (task.id, id_executant) -> nom_profil (cf. sa docstring, rempli
        # à l'initialisation réussie d'un exécutant sur ce profil).
        # obtenir_config_profil(nom_profil) donne ensuite proxy/pays,
        # même fonction que la grille de profils cloud. Aucun profil
        # actif résolu (exécutant pas encore initialisé, ou aucun
        # exécutant sélectionné) -> les 3 lignes retombent sur "—"/None
        # via definir_infos_profil(None, None, None).
        #
        # Section 5 : si un profil de la liste de profils (etat.
        # profil_actif) est actif, ses infos priment -- c'est précisément
        # LE profil dont on affiche le rendu ; sinon on retombe sur
        # l'ancien mécanisme self._profils_reseau_actifs (profil résolu
        # côté initialisation d'exécutant, pertinent seulement sans
        # profil actif dans la nouvelle liste).
        etat = self._executions_clone.get(task.id)
        cle_profil_actif = etat.profil_actif if etat is not None else None
        # BUGFIX (audit clé composite) : etat.profil_actif est une CLÉ
        # COMPOSITE (id_executant::nom_profil, cf. _cle_profil_clone)
        # depuis la REFONTE MULTI-SAUTONIAX -- obtenir_config_profil()
        # cherche par NOM NU réel (str(nom) tel qu'enregistré dans
        # profils_config.json, cf. sa docstring), et definir_infos_profil
        # affiche ce nom directement à l'utilisateur : la clé composite
        # brute ne doit jamais atteindre ni l'un ni l'autre. Extraction
        # explicite du nom nu ici, une seule fois.
        nom_profil_actif = _nom_depuis_cle_profil_clone(cle_profil_actif) if cle_profil_actif else None
        nom_profil_a_afficher = nom_profil_actif or (
            self._profils_reseau_actifs.get((task.id, id_executant_cible), "") if id_executant_cible else ""
        )
        if nom_profil_a_afficher:
            config_profil = obtenir_config_profil(nom_profil_a_afficher)
            self._fenetre_rendu_reseau.panneau.definir_infos_profil(
                nom_profil_a_afficher, config_profil.get("proxy"), config_profil.get("pays")
            )
        else:
            self._fenetre_rendu_reseau.panneau.definir_infos_profil(None, None, None)
        if cle_profil_actif:
            profil_etat_actif = etat.profils.get(cle_profil_actif) if etat is not None else None
            image_a_afficher = profil_etat_actif.derniere_image_b64 if profil_etat_actif is not None else None
        else:
            image_a_afficher = self._dernieres_captures_reseau.get(id_executant_cible) if id_executant_cible else None
        self._fenetre_rendu_reseau.definir_image(image_a_afficher)
        # PATCH -- point_statut_execution doit refléter le dernier statut
        # connu DÈS L'OUVERTURE (pas seulement à la prochaine transition
        # d'exécution) : si le panneau vient d'être (re)créé APRÈS qu'une
        # séquence a déjà échoué/réussi, self._fenetre_rendu_reseau était
        # None au moment de _rafraichir_bouton_global -- sans cet appel
        # ici, le point resterait gris par défaut jusqu'à la prochaine
        # exécution, alors qu'un statut pertinent est déjà connu
        # (self._dernier_statut_sequence). Réutilise le même point
        # d'orchestration central plutôt que de dupliquer la logique de
        # couleur une troisième fois.
        self._rafraichir_badge_statut_notebook()
        # REFONTE -- toujours par-dessus tout, sans bordure, à la taille
        # de l'écran (cf. FenetreRenduTaskReseau.afficher_par_dessus_tout).
        # Le widget n'est jamais reconstruit entre deux clics sur "Voir
        # le rendu" (cf. self._fenetre_rendu_reseau is None ci-dessus) :
        # rouvrir retrouve donc exactement les mêmes réglages Mode/Taux/
        # Qualité/Contrôle à distance qu'à la fermeture (Échap).
        self._fenetre_rendu_reseau.afficher_par_dessus_tout()

    def _titre_rendu_reseau_actuel(self) -> str:
        """Titre à afficher sur l'onglet ApplicationsScreen (et rappelé
        sur titre_label à chaque ouverture/changement de cible) -- cf.
        ouvrir_rendu_task_reseau, qui met à jour setTabText à chaque appel
        même si l'onglet existe déjà (changement de sAutoniax ciblé).

        Extension non explicitement requise par SPEC_profils_
        environnements.md section 5 (qui ne parle que du contenu du
        panneau, pas du titre d'onglet), mais résout la cible via la même
        _cible_rendu_reseau_actuelle() par cohérence -- pour ne pas
        laisser le titre d'onglet référencer un sAutoniax différent de
        celui dont le rendu est réellement affiché quand un profil actif
        fige profil_etat.id_executant_sautoniax.

        CORRECTIF (spec D.2, "nom du profil vide dans le titre du panneau
        clone") -- avant ce correctif, cette fonction ne construisait le
        titre qu'avec le nom du sAutoniax exécutant, jamais avec le nom du
        profil actif : contrairement à PanneauProprietesSautoniax._sur_
        clic_apercu (qui pose bien f"Aperçu : {nom_profil} ({nom_
        executant})"), le nom de profil n'apparaissait jamais ici -- d'où
        le "nom vide" rapporté (en réalité absent, pas vide au sens
        littéral : le nom du sAutoniax s'affichait bien, jamais celui du
        profil). Résolution du profil actif via etat.profil_actif
        (ExecutionCloneEtat), même source que _cible_rendu_reseau_
        actuelle()/la mise à jour des infos de profil un peu plus haut
        dans ce fichier -- repli sur l'ancien format si aucun profil actif
        n'est identifiable à cet instant (cas limite : rendu ouvert sans
        profil actif sélectionné), pour ne jamais régresser ce cas."""
        id_executant, _instance_id = self._cible_rendu_reseau_actuelle()
        nom_executant = self._noms_executants_reseau.get(id_executant, "") if id_executant else ""
        task = self._task_courant_obj()
        etat = self._executions_clone.get(task.id) if task is not None else None
        # BUGFIX (audit clé composite) : etat.profil_actif est une clé
        # composite (id_executant::nom_profil) -- extraction du nom nu
        # affichable avant de composer le titre, pour ne pas afficher la
        # clé technique brute dans l'onglet/titre du panneau.
        nom_profil = _nom_depuis_cle_profil_clone(etat.profil_actif) if etat is not None and etat.profil_actif else None
        if nom_profil and nom_executant:
            return f"{nom_profil} ({nom_executant})"
        if nom_executant:
            return f"Rendu : {nom_executant}"
        return "Rendu réseau"

    def _sur_fermeture_rendu_reseau(self):
        """Fermeture DÉFINITIVE (bouton (x) natif, que ce soit sur l'onglet
        ApplicationsScreen ou sur la fenêtre flottante détachée -- cf.
        FenetreRenduTaskReseau.closeEvent, qui émet fermeture_demandee
        dans les deux cas). Contrairement à l'ancien comportement ("la
        fenêtre se cache elle-même, rien à nettoyer"), le widget peut
        maintenant être possédé par ApplicationsScreen.tabs -- il faut
        explicitement l'en retirer AVANT de le détruire, sinon
        ApplicationsScreen garde une référence pendante dans son
        QTabWidget. La référence locale est ensuite oubliée : rouvrir
        "Voir le rendu" reconstruira une fenêtre neuve."""
        if self._fenetre_rendu_reseau is None:
            return
        applications_screen = self._applications_screen_ou_none()
        if applications_screen is not None:
            applications_screen.retirer_rendu_task_reseau(self._fenetre_rendu_reseau)
        self._fenetre_rendu_reseau.deleteLater()
        self._fenetre_rendu_reseau = None
        # PATCH (liste déroulante d'onglet actif) -- contrairement aux
        # signaux de self._fenetre_rendu_reseau elle-même (morts avec
        # deleteLater), command_result_recu appartient à self._client_
        # serveur_t qui SURVIT à cette fermeture -- sans déconnexion
        # explicite ici, chaque cycle ouverture/fermeture empilerait une
        # connexion supplémentaire vers le même slot (doublons d'appel à
        # la prochaine réouverture, cf. _sur_clic_voir_rendu_reseau qui
        # reconnecte à chaque fois que _fenetre_rendu_reseau est None).
        if self._client_serveur_t is not None:
            try:
                self._client_serveur_t.commande_controle_distance_resultat_recu.disconnect(self.sur_command_result_reseau)  # BUGFIX
            except (TypeError, RuntimeError):
                pass

    def _applications_screen_ou_none(self):
        """Accès best-effort à MainWindow.screens["applications"], pour le
        seul cas de nettoyage (_sur_fermeture_rendu_reseau) où on ne peut
        pas passer par le signal demande_ouvrir_rendu_reseau habituel (il
        faut RETIRER, pas ouvrir). self.window() est toujours MainWindow
        en usage normal (TaskConfigScreen vit dans son content_stack) --
        garde-fou silencieux (getattr) seulement pour ne jamais planter
        pendant la fermeture d'un widget."""
        main_window = self.window()
        return getattr(main_window, "screens", {}).get("applications")

    def _sur_demande_rafraichissement_rendu_reseau(self):
        """Bouton "Rafraîchir" de PanneauRenduInstance, mode réseau : demande
        une capture PONCTUELLE au sAutoniax actuellement ciblé, hors de son
        cycle d'envoi automatique périodique (cf. protocole
        demande_capture_ponctuelle_notebook_distant).

        BUGFIX (retour utilisateur : "je narrive pas a voir le rendue",
        fond noir) : ciblait id_executant SEUL (convention mono-profil),
        jamais l'instance_id réelle du profil actif -- résolu maintenant
        via _cible_rendu_reseau_actuelle(), même principe que le reste de
        la section 5 (contrôle à distance, liste d'onglets)."""
        id_executant_cible, instance_id_cible = self._cible_rendu_reseau_actuelle()
        if not id_executant_cible:
            return
        self.demande_capture_ponctuelle_notebook_distant.emit(id_executant_cible, instance_id_cible)

    def _rafraichir_style_bouton_voir_rendu_reseau(self):
        """Met à jour l'icône/tooltip de bouton_voir_rendu_reseau (le
        bouton qui OUVRE le panneau de rendu, PAS un élément à
        l'intérieur du panneau) selon self._rendu_auto_actif -- demande
        utilisateur explicite : signe distinctif sur ce bouton quand le
        rafraîchissement auto est actif, "parce que si le rendu est auto
        alors ça peut consommer de la data". Reste correct même quand
        self._fenetre_rendu_reseau est None (panneau fermé, capture
        toujours active côté sAutoniax -- cf. docstring de
        self._rendu_auto_actif)."""
        if self._rendu_auto_actif:
            self.bouton_voir_rendu_reseau.setIcon(qta.icon("mdi6.monitor-eye", color=Mocha.peach))
            self.bouton_voir_rendu_reseau.setToolTip(
                "Affiche le rendu de l'instance en cours d'exécution sur le sAutoniax choisi\n"
                "⚠ Rafraîchissement AUTOMATIQUE actif -- consomme de la data en continu."
            )
        else:
            self.bouton_voir_rendu_reseau.setIcon(qta.icon("mdi6.monitor-eye", color=Mocha.subtext0))
            self.bouton_voir_rendu_reseau.setToolTip("Affiche le rendu de l'instance en cours d'exécution sur le sAutoniax choisi")

    def _sur_taux_capture_reseau_change(self, fps: float):
        """Case "Automatique" cochée/décochée ou spin FPS changé sur
        PanneauRenduInstance, mode réseau : reconfigure à CHAUD l'état
        (actif/intervalle) de la capture automatique du sAutoniax ciblé
        (cf. protocole definir_taux_capture_notebook_distant).

        CORRECTIF (retour utilisateur explicite : "cest moi qui doit
        activer le rafraichissement que se soit manuel ou auto") : fps<=0
        (0.0 = décoché, cf. _sur_bascule_mode_auto) N'EST PLUS ignoré ici --
        auparavant `fps <= 0: return` empêchait tout simplement le signal
        de désactivation de partir, donc décocher "Automatique" ne
        remontait jamais jusqu'au sAutoniax, qui continuait de capturer en
        arrière-plan. transmis tel quel, `fps<=0` inclus : c'est
        _sur_regler_capture_instance_demande côté sAutoniax qui interprète
        cette valeur comme "désactive le flux continu" (cf. sa docstring).

        PATCH (indicateur visuel sur bouton_voir_rendu_reseau) : met aussi
        à jour self._rendu_auto_actif + rafraîchit le style du bouton qui
        OUVRE le panneau, AVANT le `return` anticipé ci-dessous (id_executant
        absent) -- l'état affiché doit refléter le dernier fps envoyé avec
        succès, pas être bloqué si aucun profil n'est actif dans le
        panneau clone.

        BUGFIX (retour utilisateur : "je narrive pas a voir le rendue",
        fond noir persistant même après le fix du bouton "Rafraîchir") :
        ciblait id_executant SEUL (convention mono-profil de l'ancien
        combo_executant_reseau, depuis retiré), jamais l'instance_id
        réelle du profil actif -- exactement le même bug que _sur_demande_
        rafraichissement_rendu_reseau, mais resté non corrigé ici car
        défini en dehors de _sur_clic_voir_rendu_reseau. Résolu maintenant
        via _cible_rendu_reseau_actuelle(), même principe. C'est CETTE méthode
        (pas le bouton "Rafraîchir" ponctuel) qui pilote le flux vidéo
        CONTINU affiché -- sans ce fix, regler_capture_instance partait
        toujours avec instance='<id_executant>' au lieu de l'instance_id
        réelle du profil, donc la capture ne démarrait jamais sur la bonne
        instance et le rendu restait noir en permanence."""
        self._rendu_auto_actif = fps > 0
        self._rafraichir_style_bouton_voir_rendu_reseau()
        id_executant_cible, instance_id_cible = self._cible_rendu_reseau_actuelle()
        if not id_executant_cible:
            return
        self.demande_taux_capture_notebook_distant.emit(id_executant_cible, instance_id_cible, fps)

    def sur_echec_reglage_capture_reseau(self, id_executant: str, message: str):
        """PATCH (feedback réseau manquant -- demande explicite
        utilisateur : "lorsque on effectue une action reseau ... il ya
        aucune confirmation dans le status bar"). Connecté par MainWindow
        à ClientServeurT.regler_capture_instance_echec -- affiche l'échec
        de TRANSMISSION (ex. sAutoniax déconnecté) sur le
        label_statut_rafraichissement du panneau réseau, seulement si :
        1) la fenêtre de rendu réseau est actuellement ouverte, et
        2) elle affiche bien le sAutoniax du profil ACTUELLEMENT ACTIF
        (panneau Exécutions clone, cf. _id_executant_profil_actif qui a
        remplacé combo_executant_reseau.currentData() ici, PATCH retrait
        du combo) -- un échec pour un autre sAutoniax que celui affiché
        ne doit pas écraser le message affiché à l'écran."""
        if self._fenetre_rendu_reseau is None:
            return
        task = self._task_courant_obj()
        if task is None or self._id_executant_profil_actif(task) != id_executant:
            return
        self._fenetre_rendu_reseau.panneau.label_statut_rafraichissement.definir_texte(
            f"Échec de la commande : {message}"
        )

    # ------------------------------------------------------------------
    # Mode notebook : gestion des cellules (une par TaskCellule, cf.
    # modèle) -- ajout, suppression, exécution individuelle, persistance
    # du code à chaque frappe (comme un vrai notebook, pas besoin
    # d'attendre la perte de focus pour ne rien perdre au changement
    # d'onglet/fermeture).
    # ------------------------------------------------------------------
    def _peupler_cellules(self, task: Task, incremental: bool = False, precalcul_editeur: Optional[dict] = None):
        """(Re)construit la liste de widgets de cellule à partir de
        task.cellules -- appelé à l'ouverture du Task. Un Task chargé
        d'avant le mode notebook (migré par Task.from_dict) arrive déjà
        ici avec une unique cellule contenant l'ancien script, donc rien
        de spécial à gérer pour la rétrocompatibilité.

        task.cellule_variables forme désormais SEULE la row 0 sticky (MAJ
        décision explicite utilisateur : "Main" n'est plus collante du
        tout) -- construite ici, puis positionnée par _positionner_row0
        selon l'état étiquetee persisté (statique/sticky si True, dans
        row0_detachee_container au sein du notebook scrollable si False).
        task.cellules (dont "Main" en position 0) vont TOUTES dans le
        notebook scrollable normal, comme des cellules 1+ classiques."""
        # CORRECTIF H1 (SPEC_patch_ouverture_task.md §2, MESURÉ au banc :
        # sans ces deux lignes l'arbre de editeur_page passe de 118
        # widgets / 3 éditeurs à 187/6, 256/9, 325/12... à chaque
        # réouverture ; avec elles il reste à 118/3 indéfiniment).
        #
        # POURQUOI deleteLater() SEUL NE SUFFIT PAS : il ne fait que
        # POSTER un événement DeferredDelete. L'objet reste enfant de son
        # parent, donc dans l'arbre Qt, jusqu'à ce que le contrôle revienne
        # à la boucle d'événements. Et il n'y revient pas ici : Qt refuse
        # explicitement de délivrer un DeferredDelete à un niveau de portée
        # plus profond que celui où il a été posté (QScopedScopeLevelCounter),
        # donc même les QApplication.processEvents() qui parsemaient
        # _ouvrir_task_impl ne les purgeaient PAS -- et ils ont de toute
        # façon été remplacés par repeindre_immediatement() depuis.
        # Conséquence : pendant tout le stack.setCurrentWidget() final,
        # les anciennes cellules sont encore là, retirées du layout mais
        # TOUJOURS visibles et TOUJOURS enfants -- Qt les polit, les
        # affiche (TaskScriptEditor.showEvent -> appliquer_taille_police)
        # et, comme elles ne sont plus dans aucun layout, leur
        # setFixedHeight() invalide quand même notebook_layout, ce qui
        # relance une passe de mise en page complète.
        #
        # hide() AVANT setParent(None) : reparenter un widget VISIBLE vers
        # None en ferait une fenêtre top-level (Qt la masque aussitôt,
        # mais autant ne pas dépendre de ce détail et éviter tout
        # clignotement). setParent(None) le sort immédiatement et
        # SYNCHRONEMENT de l'arbre ; deleteLater() libère ensuite la
        # mémoire au prochain vrai tour de boucle, sans risque de détruire
        # un widget encore référencé par une pile d'appel en cours.
        # Même patron que BarreAccesRapideTask.rafraichir /
        # PanneauComposantsImportesTask.rafraichir / FlowGrid.clear.
        # PATCH construction par lots : toute chaîne de construction en cours
        # (ouverture précédente) est annulée.
        self._gen_construction = getattr(self, "_gen_construction", 0) + 1
        self._cellules_a_construire = []
        self._cellules_en_construction = False
        # PATCH (étape 3) : les cadres de la liste virtuelle retournent à SON
        # lot (réutilisés à la prochaine ouverture, aucun widget recréé) ;
        # le conteneur sort du layout tant qu'il ne sert pas.
        _lv = getattr(self, "_liste_virtuelle", None)
        if _lv is not None:
            _lv.reinitialiser()
            _lv.conteneur.hide()
            self.notebook_layout.removeWidget(_lv.conteneur)
        self._liste_virtuelle_en_service = False
        for widget in list(self._cellule_widgets.values()):
            widget.liberer_editeur_partage()  # PATCH étape 2
            self.notebook_layout.removeWidget(widget)
            self.cellule_statique_layout.removeWidget(widget)
            self.row0_detachee_layout.removeWidget(widget)
            widget.hide()
            widget.setParent(None)
            # PATCH réutilisation : on GARDE le widget (même objet, pas de copie)
            # pour le remettre en place à la prochaine ouverture si son contenu
            # n'a pas changé -- plus de reconstruction en masse.
            if getattr(widget, "_sig_pool", None) is not None:
                pool = self._pool_widgets_cellules_obtenir()
                pool.pop(widget.cellule_id, None)
                pool[widget.cellule_id] = widget
            else:
                widget.deleteLater()
        self._cellule_widgets.clear()
        pool = self._pool_widgets_cellules_obtenir()
        while len(pool) > 80:  # plafond mémoire : on libère les plus anciens
            _ancien_id = next(iter(pool))
            pool.pop(_ancien_id).deleteLater()
        self.notebook_layout.removeWidget(self.row0_detachee_container)
        self.row0_detachee_container.hide()

        if not task.cellules:
            task.cellules = [TaskCellule(titre="# Main")]
        if task.cellule_variables is None:
            task.cellule_variables = TaskCellule(code=CODE_VARIABLES_DYNAMIQUES_DEFAUT, titre="# Variable dynamique")

        etiquetee = getattr(task.cellule_variables, "etiquetee", True)
        # MAJ décision utilisateur : "Variable dynamique" reste seule
        # sticky en haut ; "Main" (task.cellules[0]) va directement dans
        # le notebook scrollable, avant les autres cellules, exactement
        # comme n'importe quelle cellule 1+ pour la POSITION/le style --
        # mais reste non-supprimable comme avant (insuprimable=True
        # passé explicitement, seulement pour l'index 0).
        self._inserer_widget_cellule_variables(task.cellule_variables)
        if self._mode_virtuel_pour_task():
            # PATCH (étape 3) : aucune cellule construite ici, la liste monte
            # seulement celles de la zone visible (plus une marge).
            self._liste_virtuelle_en_service = True
            self._liste_virtuelle_obtenir().charger(task)
        elif not incremental:
            for index, cellule in enumerate(task.cellules):
                self._inserer_widget_cellule(cellule, insuprimable=(index == 0))
        else:
            # Les premières cellules (visibles) tout de suite, le reste par
            # petits lots entre deux tours de boucle d'événements : l'interface
            # ne gèle plus pendant la construction.
            NB_INITIAL = 3
            for index, cellule in enumerate(task.cellules[:NB_INITIAL]):
                self._inserer_widget_cellule(cellule, insuprimable=(index == 0))
            restantes = list(enumerate(task.cellules))[NB_INITIAL:]
            if restantes:
                self._cellules_a_construire = restantes
                self._cellules_en_construction = True
                gen = self._gen_construction
                QTimer.singleShot(
                    0, lambda: self._construire_lot_cellules(task.id, gen, precalcul_editeur)
                )

        # Le widget de cellule_variables vient d'être construit
        # directement dans cellule_statique_container (état par défaut) --
        # si l'état persisté est "détaché", on le repositionne tout de
        # suite dans row0_detachee_container via la même logique que le
        # clic sur le bouton, plutôt que de dupliquer le placement ici.
        if not etiquetee:
            self._positionner_row0(task, etiquetee=False)

    def _construire_lot_cellules(self, task_id: str, gen: int, precalcul_editeur: Optional[dict] = None):
        """Construit des cellules par lots de ~12 ms puis rend la main à la boucle
        d'événements (l'UI reste réactive). Annulé si une autre ouverture a eu lieu."""
        if gen != getattr(self, "_gen_construction", None):
            return
        task = self.project.find_task(task_id)
        if task is None or self._task_courant != task_id:
            self._cellules_en_construction = False
            self._cellules_a_construire = []
            return
        ids_valides = {c.id for c in task.cellules}
        debut = time.perf_counter()
        restantes = self._cellules_a_construire
        while restantes and (time.perf_counter() - debut) < 0.012:
            index, cellule = restantes.pop(0)
            if cellule.id in ids_valides:  # supprimée entre-temps -> ignorée
                self._inserer_widget_cellule(cellule, insuprimable=(index == 0))
        if restantes:
            QTimer.singleShot(0, lambda: self._construire_lot_cellules(task_id, gen, precalcul_editeur))
            return
        self._cellules_en_construction = False
        # Finalisation pour les cellules fraîchement construites (idempotent
        # pour les premières déjà traitées).
        self._rafraichir_composants_connus_editeur(task, precalcul_editeur)
        self._rafraichir_variables_globales_editeur(task, precalcul_editeur)
        self._rafraichir_index_cellules(task)
        self._rafraichir_affichage_workspace_cellule_variables(task)

    def _pool_widgets_cellules_obtenir(self) -> dict:
        pool = getattr(self, "_pool_widgets_cellules", None)
        if pool is None:
            pool = {}
            self._pool_widgets_cellules = pool
        return pool

    def _signature_widget_cellule(self, c: "TaskCellule", insuprimable, epinglee) -> tuple:
        """Tout ce dont dépend l'apparence du widget : si identique, le widget
        existant est strictement équivalent à un widget neuf."""
        r = self.reglages
        return (
            c.id, c.titre, getattr(c, "description", ""), c.code, c.sortie, c.statut,
            c.numero_execution, getattr(c, "etiquetee", True), getattr(c, "active", True),
            getattr(c, "repliee", False), bool(insuprimable), bool(epinglee),
            getattr(r, "taille_police_editeur_script", None),
            getattr(r, "retour_a_la_ligne_editeur_script", None),
            getattr(r, "bloquer_sortie_cellules", None),
        )

    def _widget_cellule_du_pool(self, cellule, insuprimable, epinglee):
        pool = self._pool_widgets_cellules_obtenir()
        w = pool.pop(cellule.id, None)
        sig = self._signature_widget_cellule(cellule, insuprimable, epinglee)
        if w is not None and getattr(w, "_sig_pool", None) == sig:
            return w
        if EDITEUR_PARTAGE:
            # PATCH (étape 1, lier) : au lieu de détruire un widget dont le
            # contenu a changé, ou de ne réutiliser que celui du même id, on
            # prend ce widget (ou n'importe quel autre du pool) et on le
            # REBRANCHE. Seuls les réglages cuits dans l'éditeur à la
            # construction (taille de police, retour à la ligne : les deux
            # éléments juste avant le dernier de la signature) interdisent la
            # réutilisation ; le blocage des sorties est réappliqué par lier.
            if w is None and pool:
                for _id_candidat, _w_candidat in list(pool.items()):
                    if getattr(_w_candidat, "_sig_pool", None) is not None and \
                            _w_candidat._sig_pool[-3:-1] == sig[-3:-1]:
                        w = pool.pop(_id_candidat)
                        break
            if w is not None and getattr(w, "_sig_pool", None) is not None \
                    and w._sig_pool[-3:-1] == sig[-3:-1]:
                # Mêmes valeurs que les appels de construction : seule la
                # cellule « Variable dynamique » (epinglee=True) porte le
                # bouton étiquette et lit son état sur la cellule.
                w.lier(
                    cellule,
                    insuprimable=insuprimable,
                    epinglee_visuelle=epinglee,
                    afficher_bouton_etiquette=bool(epinglee),
                    etiquetee=(getattr(cellule, "etiquetee", True) if epinglee else True),
                )
                w._sig_pool = sig
                return w
        if w is not None:
            w.deleteLater()
        return None

    # ------------------------------------------------------------------
    # PATCH (étape 3) -- liste virtuelle : seules les cellules proches de la
    # zone visible ont un cadre. Tout parcours « de toutes les cellules » doit
    # passer par les DONNÉES (task.cellules), jamais par _cellule_widgets.
    # ------------------------------------------------------------------
    def _mode_virtuel_pour_task(self) -> bool:
        return bool(EDITEUR_PARTAGE and PartageEditeur.disponible(self.reglages))

    def _liste_virtuelle_active(self) -> bool:
        return getattr(self, "_liste_virtuelle", None) is not None \
            and bool(getattr(self, "_liste_virtuelle_en_service", False))

    def _liste_virtuelle_obtenir(self) -> "ListeVirtuelleCellules":
        liste = getattr(self, "_liste_virtuelle", None)
        if liste is None:
            liste = ListeVirtuelleCellules(self)
            self._liste_virtuelle = liste
        return liste

    def _assurer_cellule_montee(self, cellule_id: str):
        """Avant tout « aller à cette cellule » : la monte (en y faisant
        défiler) si elle n'a pas de cadre."""
        if self._liste_virtuelle_active():
            liste = self._liste_virtuelle
            if cellule_id in liste.ids and cellule_id not in liste.montes:
                liste.reveler(cellule_id)

    def _appliquer_etat_global_au_cadre(self, cadre):
        """Un cadre qui vient d'être rebranché sur une cellule reçoit ce que les
        passes globales (noms connus, variables globales, surlignage Ctrl+F)
        n'ont pu lui poser quand il n'était pas monté."""
        etat = getattr(self, "_etat_global_editeur", None) or {}
        ed = cadre.editeur
        if "noms" in etat:
            ed.definir_noms_connus_en_une_passe(*etat["noms"])
        if "globales" in etat:
            v, i, r = etat["globales"]
            ed.definir_variables_globales_connues(v)
            ed.definir_instances_globales_connues(i)
            ed.definir_resultats_globaux_connus(r)
        mc = getattr(self, "_multi_curseur_etat", None)
        if mc is None:
            ed._appliquer_surlignage_occurrences([], [])
        else:
            ed._appliquer_surlignage_occurrences(
                mc["occurrences"].get(cadre.cellule_id, []), mc["actives"].get(cadre.cellule_id, []))

    def _cellules_et_textes(self):
        """(objet portant cellule_id, texte) de TOUTES les cellules, montées ou
        non : le texte d'une cellule montée vient de son éditeur, sinon des
        données. Même ordre qu'avant (Variable dynamique, puis task.cellules)."""
        task = self._task_courant_obj()
        if task is None or not self._liste_virtuelle_active():
            for w in self._cellule_widgets.values():
                if w.editeur is not None:
                    yield w, w.editeur.toPlainText()
            return
        cellules = ([task.cellule_variables] if task.cellule_variables is not None else []) + list(task.cellules)
        for c in cellules:
            w = self._cellule_widgets.get(c.id)
            if w is not None:
                yield w, w.editeur.toPlainText()
            else:
                yield _RefCellule(c.id), c.code or ""

    def _ids_cellules_ordre(self) -> list:
        task = self._task_courant_obj()
        if task is None or not self._liste_virtuelle_active():
            return [w.cellule_id for w in self._cellule_widgets.values()]
        ids = [task.cellule_variables.id] if task.cellule_variables is not None else []
        return ids + [c.id for c in task.cellules]

    def _editeur_hors_cadre(self, cellule_id: str):
        """Proxy d'éditeur pour une cellule NON montée : travaille sur le
        document de sa session (créée au besoin), sans aucun widget."""
        if not self._liste_virtuelle_active():
            return None
        task = self._task_courant_obj()
        cellule = self._trouver_cellule_par_id(task, cellule_id) if task is not None else None
        partage = self._partage_editeur_pour_cadres()
        if cellule is None or partage is None:
            return None
        session = partage.session_pour(cellule_id, cellule.code or "")
        return ProxyEditeur(_CadreHorsListe(session))

    def _editeurs_par_id(self) -> dict:
        return _EditeursParId(self, {w.cellule_id: w.editeur for w in self._cellule_widgets.values()})

    def _persister_si_hors_cadre(self, cellule_id: str):
        """Après une édition programmatique (multi-curseur) d'une cellule non
        montée : aucun signal de cadre ne la persistera, on le fait ici."""
        if not self._liste_virtuelle_active() or cellule_id in self._cellule_widgets:
            return
        task = self._task_courant_obj()
        cellule = self._trouver_cellule_par_id(task, cellule_id) if task is not None else None
        partage = self._partage_editeur_pour_cadres()
        session = partage._sessions.get(cellule_id) if partage is not None else None
        if cellule is None or session is None:
            return
        cellule.code = session.code_actuel()
        self._planifier_sauvegarde_projet_differee()
        self._rafraichir_variables_globales_editeur(task)

    def _ajouter_cellule_virtuel(self, task, nouvelle, apres_id, avant):
        """_ajouter_cellule en liste virtuelle : même règles de position que
        l'ancien code, mais sur les données seulement."""
        reveler = False
        if task.cellule_variables is not None and apres_id == task.cellule_variables.id:
            task.cellules.append(nouvelle)
            reveler = True
        else:
            if avant and apres_id is not None and task.cellules and task.cellules[0].id == apres_id:
                avant = False
            if apres_id is None:
                task.cellules.append(nouvelle)
            else:
                index = next((i for i, c in enumerate(task.cellules) if c.id == apres_id), None)
                if index is None:
                    task.cellules.append(nouvelle)
                elif index == 0:
                    task.cellules.insert(1, nouvelle)
                else:
                    task.cellules.insert(index if avant else index + 1, nouvelle)
        self._liste_virtuelle.cellule_inseree(nouvelle)
        if reveler:
            self._liste_virtuelle.reveler(nouvelle.id)
        self._rafraichir_composants_connus_editeur(task)
        self._rafraichir_variables_globales_editeur(task)
        self.project.save()
        self.barre_acces_rapide.rafraichir(task)
        self._rafraichir_index_cellules(task)

    NB_CADRES_PRECHAUFFES = 8

    def precharger_editeur(self, synchrone: bool = False):
        """PATCH (préchauffage) : voir patch5. Étapes :
        1. partage + métriques + éditeur partagé ; 2. liste virtuelle ;
        3. NB_CADRES_PRECHAUFFES cadres vides. Une étape par tour de boucle
        (synchrone=True les enchaîne, pour les tests). Sans effet si
        l'éditeur partagé n'est pas disponible (interrupteur coupé, retour à
        la ligne actif) ou déjà fait."""
        if getattr(self, "_prechauffage_lance", False):
            return
        if not self._mode_virtuel_pour_task():
            return
        self._prechauffage_lance = True

        def etapes():
            partage = self._partage_editeur_pour_cadres()
            if partage is None:
                return
            partage.metriques()
            partage.editeur()
            yield
            liste = self._liste_virtuelle_obtenir()
            yield
            for _ in range(self.NB_CADRES_PRECHAUFFES):
                liste.prechauffer_cadre()
                yield

        gen = etapes()

        def avancer():
            try:
                next(gen)
            except StopIteration:
                return
            except Exception:
                log_cellule.exception("préchauffage de l'éditeur partagé interrompu")
                return
            QTimer.singleShot(0, avancer)

        if synchrone:
            for _ in gen:
                pass
        else:
            QTimer.singleShot(0, avancer)

    def _partage_editeur_pour_cadres(self):
        """PATCH (étape 2) : l'éditeur partagé de CE notebook, ou None si
        l'interrupteur est coupé ou si le retour à la ligne est actif."""
        if not PartageEditeur.disponible(self.reglages):
            return None
        partage = getattr(self, "_partage_editeur", None)
        if partage is None:
            partage = PartageEditeur(self.reglages, self)
            self._partage_editeur = partage
        return partage

    def _inserer_widget_cellule_variables(self, cellule: "TaskCellule"):
        """Construit le widget de la cellule "Variable dynamique" (cf.
        docstring Task.cellule_variables) et le place dans
        cellule_statique_container, au-dessus du notebook scrollable --
        reste donc visible en permanence pendant le défilement des autres
        cellules, y compris "Main" (task.cellules[0]) qui vit désormais
        DANS le notebook scrollable comme une cellule normale (MAJ
        décision explicite utilisateur : "Main" n'est plus collante du
        tout -- seule "Variable dynamique" reste sticky/détachable).
        Insuprimable (insuprimable=True), porte le bouton étiquette
        (afficher_bouton_etiquette=True) qui pilote son propre sticky, et
        le style visuel "épinglé" (epinglee_visuelle=True)."""
        widget = self._widget_cellule_du_pool(cellule, True, True)
        if widget is None:
            widget = TaskCelluleWidget(
                cellule, self.reglages, self.cellule_statique_container,
                est_premiere=False,
                etiquetee=getattr(cellule, "etiquetee", True),
                insuprimable=True,
                afficher_bouton_etiquette=True,
                active=getattr(cellule, "active", True),
                epinglee_visuelle=True,
                partage=self._partage_editeur_pour_cadres(),
            )
            self._connecter_widget_cellule(widget)
            widget._sig_pool = self._signature_widget_cellule(cellule, True, True)
        else:
            self._cellule_widgets[widget.cellule_id] = widget  # déjà connecté
        self.cellule_statique_layout.addWidget(widget, 1)
        widget.show()
        return widget

    def _inserer_widget_cellule(self, cellule: "TaskCellule", insuprimable: Optional[bool] = None):
        """Ajoute le widget d'une cellule (task.cellules, y compris "Main"
        en position 0 -- MAJ décision utilisateur, elle n'est plus
        distinguée visuellement/positionnellement des cellules 1+, mais
        reste non-supprimable comme avant : insuprimable=True lui est
        passé explicitement par l'appelant, cf. _peupler_cellules) en fin
        de notebook scrollable, juste avant le stretch final (toujours en
        dernière position du layout) -- repositionné ensuite si besoin par
        _ajouter_cellule pour une insertion au milieu du notebook."""
        _reutilise = self._widget_cellule_du_pool(cellule, insuprimable, False)
        widget = _reutilise if _reutilise is not None else TaskCelluleWidget(
            cellule, self.reglages, self.notebook_contenu,
            active=getattr(cellule, "active", True),
            insuprimable=insuprimable,
            # Explicite : même "Main" (insuprimable=True) ne doit JAMAIS
            # porter le style visuel "épinglé" -- sans ce paramètre
            # explicite, TaskCelluleWidget l'aurait déduit de
            # insuprimable=True par défaut (cf. son __init__), ce qui
            # aurait recréé exactement le bug signalé par l'utilisateur.
            epinglee_visuelle=False,
            partage=self._partage_editeur_pour_cadres(),
        )
        if _reutilise is None:
            self._connecter_widget_cellule(widget)
            widget._sig_pool = self._signature_widget_cellule(cellule, insuprimable, False)
        else:
            self._cellule_widgets[widget.cellule_id] = widget  # déjà connecté

        # Le stretch final (addStretch(1)) reste toujours le dernier item
        # du layout : on insère juste avant lui pour garder l'ordre.
        index_insertion = self.notebook_layout.count() - 1
        self.notebook_layout.insertWidget(max(index_insertion, 0), widget)
        if _reutilise is not None:
            widget.show()
        return widget

    def _connecter_widget_cellule(self, widget: "TaskCelluleWidget"):
        """Câblage des signaux commun aux deux emplacements possibles
        (cellule statique ou notebook scrollable) -- factorisé pour ne pas
        dupliquer les sept connect() à chaque point d'insertion."""
        widget.demande_execution.connect(self._executer_cellule)
        widget.demande_suppression.connect(self._supprimer_cellule)
        widget.demande_ajout_apres.connect(self._ajouter_cellule)
        widget.demande_vider.connect(self._vider_cellule)
        widget.code_modifie.connect(self._sur_code_cellule_modifie)
        widget.titre_modifie.connect(self._sur_titre_cellule_modifie)
        widget.description_modifie.connect(self._sur_description_cellule_modifie)
        widget.etiquette_basculee.connect(self._sur_etiquette_cellule_basculee)
        widget.demande_toggle_active.connect(self._sur_toggle_active_cellule)
        widget.repliee_basculee.connect(self._sur_repliee_cellule_basculee)
        widget.demande_reparation_indentation.connect(self._reparer_indentation_cellule)
        self._cellule_widgets[widget.cellule_id] = widget

    def _trouver_cellule_par_id(self, task: Task, cellule_id: str) -> Optional["TaskCellule"]:
        """Cherche une TaskCellule par id, dans task.cellules (mode
        notebook classique) PUIS dans task.cellule_variables (deuxième
        cellule de la row 0, cf. docstring Task.cellule_variables) --
        point d'entrée unique pour ne pas dupliquer cette recherche en
        deux temps à chaque handler (persistance du code/titre/
        description, vidage, exécution individuelle doivent tous
        fonctionner identiquement pour les deux cellules de la row 0)."""
        for cellule in task.cellules:
            if cellule.id == cellule_id:
                return cellule
        if task.cellule_variables is not None and task.cellule_variables.id == cellule_id:
            return task.cellule_variables
        return None

    def _ajouter_cellule(self, apres_id: Optional[str], avant: bool = False):
        """Ajoute une nouvelle cellule vide, juste après (ou juste avant si
        avant=True, cf. clic droit sur le bouton "+") celle dont l'id est
        apres_id (ou à la fin du notebook si apres_id est None -- dans ce
        cas avant n'a pas de sens, ignoré).

        LIMITE CONNUE (hors scope demandé) : ajouter une cellule PENDANT
        une séquence "Tout exécuter" en cours l'insère hors de
        self._sequence_file -- elle reste en ▶ normal, cliquable
        individuellement, pendant que la séquence tourne sur les autres.
        Pas cassé (aucun crash, aucun état incohérent bloqué), juste pas
        pris en compte par la séquence en cours -- cas jugé assez rare
        pour ne pas complexifier davantage la gestion de file."""
        task = self._task_courant_obj()
        if task is None:
            return
        nouvelle = TaskCellule()
        if self._liste_virtuelle_active():   # PATCH (étape 3)
            self._ajouter_cellule_virtuel(task, nouvelle, apres_id, avant)
            return

        # Cas particulier : clic sur le "+" de cellule_variables (deuxième
        # cellule de la row 0, cf. docstring Task.cellule_variables) --
        # absente de task.cellules, donc invisible au lookup par index
        # ci-dessous.
        #
        # BUGFIX (rapporté par l'utilisateur : "quand je clic normalement
        # sa cree une celleule tout en haut, ce qui n'est pas normal") --
        # l'ancienne version forçait TOUJOURS task.cellules.insert(1, ...),
        # peu importe le nombre de cellules déjà créées plus bas dans le
        # notebook : la nouvelle cellule atterrissait donc systématiquement
        # tout en haut (juste après cellules[0]), écrasant l'ordre du
        # travail déjà fait, au lieu de suivre le même comportement que
        # n'importe quel autre bouton "+" du notebook (qui insère toujours
        # juste après/avant la cellule réellement cliquée). Comme
        # cellule_variables n'a pas de position dans task.cellules, on
        # calcule maintenant sa position "logique" comme celle
        # immédiatement après cellules[0] SEULEMENT si le notebook est
        # encore vide (aucune cellule après cellules[0]) -- sinon on
        # ajoute à la SUITE de la dernière cellule existante, pour ne
        # jamais réinsérer au milieu d'un travail déjà en cours.
        if task.cellule_variables is not None and apres_id == task.cellule_variables.id:
            if len(task.cellules) <= 1:
                # Notebook encore vide (seule cellules[0] existe) : la
                # nouvelle cellule devient la toute première du notebook
                # scrollable, juste après cellules[0] -- comportement
                # inchangé pour ce cas précis, toujours cohérent puisqu'il
                # n'y a alors rien "en bas" à préserver.
                task.cellules.insert(1, nouvelle)
            else:
                # Des cellules existent déjà plus bas : on les préserve en
                # ajoutant la nouvelle à la SUITE, pas au milieu.
                task.cellules.append(nouvelle)
            widget = self._inserer_widget_cellule(nouvelle)
            self.notebook_layout.removeWidget(widget)
            if len(task.cellules) <= 2:
                # Cas "notebook encore vide" ci-dessus : positionner juste
                # après le widget de cellules[0] s'il est visible dans le
                # notebook scrollable (cellule 0 détachée du sticky).
                widget_cellule0 = self._cellule_widgets.get(task.cellules[0].id) if task.cellules else None
                if widget_cellule0 is not None and widget_cellule0.parent() is self.notebook_contenu:
                    pos = self.notebook_layout.indexOf(widget_cellule0)
                    pos_cible = pos + 1 if pos >= 0 else 0
                    self.notebook_layout.insertWidget(pos_cible, widget)
                else:
                    # Même piège que la branche "cellule 0 comme repère"
                    # plus bas (elif index == 0) : si la row 0 est
                    # actuellement DÉTACHÉE (row0_detachee_container
                    # présent dans notebook_layout, cf. _positionner_row0
                    # etiquetee=False), widget_cellule0.parent() vaut
                    # row0_detachee_container et non notebook_contenu --
                    # insertWidget(0, widget) pousserait alors la nouvelle
                    # cellule AU-DESSUS de toute la row 0 (vérifié
                    # empiriquement avec un test Qt offscreen, même
                    # mécanisme que le bug d'origine). Insérer juste APRÈS
                    # row0_detachee_container s'il est dans le layout ;
                    # sinon (row 0 réellement statique, jamais dans
                    # notebook_layout) 0 reste la seule position sûre.
                    pos_row0 = self.notebook_layout.indexOf(self.row0_detachee_container)
                    pos_cible = pos_row0 + 1 if pos_row0 >= 0 else 0
                    self.notebook_layout.insertWidget(pos_cible, widget)
            else:
                # Cas "ajout à la suite" : juste avant le stretch final,
                # même position que _inserer_widget_cellule utilise déjà
                # pour un ajout normal en fin de notebook.
                index_insertion = self.notebook_layout.count() - 1
                self.notebook_layout.insertWidget(max(index_insertion, 0), widget)
            # BUGFIX (rapporté par l'utilisateur : "quand j'ai déjà créé
            # plusieurs cellules en bas et que je reviens cliquer sur le
            # "+" de la cellule variable statique, ça revient en haut" --
            # puis, indice décisif : "au rechargement du notebook, ça
            # s'aligne correctement") -- ce dernier point prouve que
            # task.cellules et le placement du widget ci-dessus étaient
            # déjà corrects (_peupler_cellules, appelée à la réouverture,
            # reconstruit tout depuis task.cellules et affiche la bonne
            # position) : le bug n'était donc PAS dans les données ni
            # dans le placement du widget, mais dans le fait qu'aucun
            # scroll automatique n'amenait la nouvelle cellule dans le
            # champ visible. cellule_variables vit dans la row sticky
            # TOUT EN HAUT du panneau (cf. docstring TaskConfigScreen sur
            # cellule_statique_container, hors du QScrollArea) : son "+"
            # reste donc visible et cliquable quelle que soit la position
            # de scroll du notebook. Une fois la nouvelle cellule ajoutée
            # à la SUITE (potentiellement très bas, hors du champ visible
            # actuel), sans scroll automatique elle restait invisible --
            # perçue comme "revenue en haut" alors qu'elle était bien
            # présente, plus bas, juste hors champ. Même mécanisme
            # (ensureWidgetVisible sur notebook_scroll) déjà utilisé par
            # _sur_clic_acces_rapide pour amener une cellule dans le
            # champ visible.
            #
            # QTimer.singleShot(0, ...) INDISPENSABLE ici (vérifié
            # empiriquement, pas une précaution gratuite) : le widget
            # vient tout juste d'être inséré dans notebook_layout, sans
            # encore de géométrie stable (pas passé par un cycle de
            # layout complet). Appelé de façon SYNCHRONE à cet instant,
            # ensureWidgetVisible ne se contente pas d'ignorer l'appel --
            # il repositionne le scroll à 0 (tout en haut), ce qui
            # EXPLIQUE précisément le symptôme observé ("ça revient en
            # haut"). Différer d'un cycle d'événements (même pattern déjà
            # en place dans definir_retour_a_la_ligne pour un souci de
            # timing similaire) laisse Qt terminer la mise en page avant
            # de calculer la position de scroll cible.
            widget_a_reveler = widget
            QTimer.singleShot(
                0,
                lambda w=widget_a_reveler: self.notebook_scroll.ensureWidgetVisible(w, 0, 80)
                if w is not None and self._widget_est_descendant(w, self.notebook_contenu)
                else None,
            )
            # Le nouveau widget de cellule démarre avec un état
            # d'auto-complétion vide (_composants_connus,
            # _services_api_connus, _variables_globales_connues,
            # _instances_globales_connues) -- ces deux rafraîchissements
            # bouclent sur TOUS les widgets de self._cellule_widgets (donc
            # aussi le nouveau, déjà inséré ci-dessus) pour lui transmettre
            # l'état déjà connu du Task, sans quoi l'auto-complétion des
            # méthodes/ServiceAPI restait inactive jusqu'à fermer/rouvrir
            # le Task (bug rapporté : "obligé de quitter et revenir").
            self._rafraichir_composants_connus_editeur(task)
            self._rafraichir_variables_globales_editeur(task)
            self.project.save()
            self.barre_acces_rapide.rafraichir(task)
            self._rafraichir_index_cellules(task)
            return


        # Garde-fou cellule 0 (décision explicite utilisateur) : un clic
        # droit "insérer avant" sur la cellule statique insérerait sinon
        # la nouvelle cellule à l'index 0, poussant la vraie cellule 0 en
        # position 1 -- elle perdrait alors son statut statique/insuprimable
        # au prochain _peupler_cellules. On force ce cas précis à "après"
        # à la place (résultat visuel identique : la nouvelle cellule
        # atterrit juste sous la cellule 0, dans le notebook scrollable).
        if avant and apres_id is not None and task.cellules and task.cellules[0].id == apres_id:
            avant = False

        if apres_id is None:
            task.cellules.append(nouvelle)
            self._inserer_widget_cellule(nouvelle)
        else:
            index = next((i for i, c in enumerate(task.cellules) if c.id == apres_id), None)
            if index is None:
                task.cellules.append(nouvelle)
                self._inserer_widget_cellule(nouvelle)
            elif index == 0:
                # La cellule repère est la cellule 0 -- qu'elle soit
                # actuellement statique (hors notebook_layout) ou détachée
                # (étiquette désactivée, donc déjà dans notebook_layout,
                # cf. _sur_etiquette_cellule_basculee) : la nouvelle
                # cellule devient la nouvelle task.cellules[1], et doit
                # apparaître juste APRÈS le widget de la cellule 0 si
                # celle-ci est visible dans le notebook scrollable --
                # sinon (cas statique normal, cellule 0 hors
                # notebook_layout) juste APRÈS LA DERNIÈRE cellule déjà
                # présente dans le notebook scrollable (PAS en position 0
                # forcée -- BUGFIX : insertWidget(0, widget) écrasait
                # l'ordre du travail déjà fait pour toute cellule ajoutée
                # avec la cellule 0 statique comme repère, dès qu'au moins
                # une cellule existait déjà plus bas).
                task.cellules.insert(1, nouvelle)
                widget = self._inserer_widget_cellule(nouvelle)
                self.notebook_layout.removeWidget(widget)
                widget_repere = self._cellule_widgets.get(apres_id)
                if widget_repere is not None and widget_repere.parent() is self.notebook_contenu:
                    pos = self.notebook_layout.indexOf(widget_repere)
                    self.notebook_layout.insertWidget(pos + 1 if pos >= 0 else 0, widget)
                else:
                    # Cellule 0 statique (hors notebook_layout) : chercher
                    # le widget de task.cellules[1] (l'ancienne, avant
                    # notre insert(1, ...) ci-dessus donc désormais
                    # task.cellules[2] si elle existe) pour insérer juste
                    # AVANT elle -- équivalent à "juste après la cellule 0"
                    # sans jamais forcer la position 0 du layout.
                    widget_suivant = None
                    if len(task.cellules) > 2:
                        widget_suivant = self._cellule_widgets.get(task.cellules[2].id)
                    if widget_suivant is not None and widget_suivant.parent() is self.notebook_contenu:
                        pos_suivant = self.notebook_layout.indexOf(widget_suivant)
                        self.notebook_layout.insertWidget(max(pos_suivant, 0), widget)
                    else:
                        # Aucune cellule 1+ après la row 0 : si celle-ci
                        # est actuellement DÉTACHÉE (row0_detachee_container
                        # présent dans notebook_layout, cf. _positionner_row0
                        # etiquetee=False), insertWidget(0, widget) la
                        # pousserait AU-DESSUS de la row 0 -- même symptôme
                        # que le bug d'origine, juste dans ce cas plus rare
                        # (vérifié empiriquement avec un test Qt offscreen).
                        # Insérer juste APRÈS row0_detachee_container s'il
                        # est bien dans le layout ; sinon (cellule 0
                        # statique, notebook scrollable réellement vide)
                        # 0 reste la seule position sûre.
                        pos_row0 = self.notebook_layout.indexOf(self.row0_detachee_container)
                        pos_cible = pos_row0 + 1 if pos_row0 >= 0 else 0
                        self.notebook_layout.insertWidget(pos_cible, widget)
            else:
                index_cible = index if avant else index + 1
                task.cellules.insert(index_cible, nouvelle)
                widget = self._inserer_widget_cellule(nouvelle)
                widget_repere = self._cellule_widgets.get(apres_id)
                if widget_repere is not None:
                    self.notebook_layout.removeWidget(widget)
                    pos = self.notebook_layout.indexOf(widget_repere)
                    pos_cible = pos if avant else pos + 1
                    self.notebook_layout.insertWidget(pos_cible, widget)

        # Même raison que ci-dessus (cas cellule_variables) : le nouveau
        # widget de cellule, quel que soit le chemin d'insertion emprunté
        # ci-dessus, démarre avec un état d'auto-complétion vide -- ces
        # deux appels le mettent à jour comme tous les autres widgets.
        self._rafraichir_composants_connus_editeur(task)
        self._rafraichir_variables_globales_editeur(task)
        self.project.save()
        self.barre_acces_rapide.rafraichir(task)
        self._rafraichir_index_cellules(task)

    def _supprimer_cellule(self, cellule_id: str):
        """LIMITE CONNUE (hors scope demandé) : supprimer une cellule
        encore EN ATTENTE dans self._sequence_file pendant une séquence
        en cours laisse son id dans la file -- _lancer_prochaine_cellule_sequence
        la sautera proprement (widget introuvable -> retour immédiat via
        _executer_cellule, cf. son garde-fou `if widget is None`), sans
        crash ni blocage, juste une cellule "consommée" silencieusement."""
        task = self._task_courant_obj()
        if task is None:
            return
        if len(task.cellules) <= 1:
            self._notify_status("Impossible de supprimer la dernière cellule du Task.", error=True)
            return

        # Cellules insuprimables (décision explicite utilisateur) : la
        # row 0 entière -- cellules[0] ET cellule_variables -- protection
        # logique en plus du bouton déjà caché côté TaskCelluleWidget (au
        # cas où le signal serait émis autrement -- défense en profondeur,
        # pas de chemin connu pour le déclencher vu que le bouton est
        # hidden() dans les deux cas, mais coûte rien à vérifier ici).
        if task.cellules[0].id == cellule_id:
            self._notify_status("La première cellule ne peut pas être supprimée.", error=True)
            return
        if task.cellule_variables is not None and task.cellule_variables.id == cellule_id:
            self._notify_status("La cellule de variables dynamiques ne peut pas être supprimée.", error=True)
            return

        task.cellules = [c for c in task.cellules if c.id != cellule_id]
        if self._liste_virtuelle_active():   # PATCH (étape 3)
            self._liste_virtuelle.cellule_retiree(cellule_id)
        widget = self._cellule_widgets.pop(cellule_id, None)
        if widget is not None:
            self.notebook_layout.removeWidget(widget)
            self.cellule_statique_layout.removeWidget(widget)
            widget.deleteLater()

        self.project.save()
        self.barre_acces_rapide.rafraichir(task)
        self._rafraichir_index_cellules(task)

    def _vider_cellule(self, cellule_id: str):
        """Remet une cellule dans son état "jamais exécutée" (sortie,
        statut, numéro In[n]) sans toucher à son code -- décision explicite
        utilisateur : icône dédiée par cellule pour vider son mini-terminal.
        Une cellule déjà en cours d'exécution n'est pas vidée (son résultat
        n'existe pas encore) -- pas d'action dans ce cas, plutôt qu'un vidage
        silencieux qui serait immédiatement écrasé par le callback à venir.
        Une cellule encore EN ATTENTE dans une séquence "Tout exécuter" en
        cours n'est pas vidée non plus, pour la même raison (son tour n'est
        pas encore passé, un résultat va bientôt lui être écrit dessus).

        BUGFIX (retour utilisateur : "le bouton de effacement de sortie...
        actuelement... ne efface pas vraiment les sortie... quand je rends
        le clone actifs ses sortie apparaissent encore") -- en mode réseau,
        vider une cellule ne touchait QUE task.cellules (le notebook réel),
        jamais CloneProfilEtat.cellules_resultats -- le dict PAR PROFIL qui
        porte la sortie de chaque clone pour cette cellule (cf. docstring de
        CloneProfilEtat.cellules_resultats). Comme _definir_profil_actif
        réaffiche ce dict tel quel dès qu'on reclique sur un profil (cf. sa
        docstring "réinjecter ses propres sorties"), l'ancien résultat
        survivait au vidage et réapparaissait au prochain changement de
        profil actif. Purge donc maintenant cette entrée pour TOUS les
        profils connus de ce Task, pas seulement le profil actuellement
        affiché -- sinon vider pendant que le profil A est actif laisserait
        le profil B réafficher son vieux résultat dès qu'on bascule dessus.

        BUGFIX (relecture complète de la chaîne mode local) : la condition
        posait `etat_clone = ... if task.mode_execution == "reseau" else
        None`, ce qui désactivait TOUT le bugfix ci-dessus pour un Task
        LOCAL -- alors que self._executions_clone est peuplé exactement de
        la même façon dans les deux modes (cf. _sur_demande_lancer_clones_
        local/_lancer_sequence_clone_profil_local, qui écrivent dans
        etat.profils[cle_profil].cellules_resultats comme le fait le
        chemin réseau) et que profil_etat.moteur_courant expose le même
        attribut cellule_id quel que soit le type de moteur (getattr sûr,
        cf. docstring de _detacher_moteur_courant_profil). Résultat sans
        ce correctif : vider une cellule sur un Task en mode local NE
        PURGEAIT JAMAIS les résultats des profils clone locaux -- exact
        bug d'origine que ce patch corrigeait déjà pour le réseau, mais
        reproduit intégralement en local. Retire simplement la condition
        de mode : etat_clone reflète maintenant self._executions_clone
        pour CE Task, réseau ou local indifféremment."""
        if cellule_id in self._moteurs_en_cours:
            self._notify_status("Impossible de vider une cellule en cours d'exécution.", error=True)
            return
        if self._sequence_active and self._sequence_file and cellule_id in self._sequence_file:
            self._notify_status("Impossible de vider une cellule en attente dans la séquence en cours.", error=True)
            return
        task = self._task_courant_obj()
        if task is None:
            return
        etat_clone = self._executions_clone.get(task.id)
        if etat_clone is not None:
            # Même garde que ci-dessus (_moteurs_en_cours), version clone :
            # un profil dont le moteur EST cette cellule précise n'a pas
            # encore de résultat définitif -- le vider maintenant serait
            # immédiatement écrasé par le callback_termine à venir.
            for profil_etat in etat_clone.profils.values():
                moteur = profil_etat.moteur_courant
                if moteur is not None and getattr(moteur, "cellule_id", None) == cellule_id:
                    self._notify_status(
                        "Impossible de vider une cellule en cours d'exécution sur un clone.", error=True,
                    )
                    return
        cellule = self._trouver_cellule_par_id(task, cellule_id)
        if cellule is None:
            return
        cellule.sortie = ""
        cellule.statut = "inedit"
        cellule.numero_execution = None
        self.project.save()
        widget = self._cellule_widgets.get(cellule_id)
        if widget is not None:
            widget.afficher_resultat(cellule)
        if etat_clone is not None:
            for profil_etat in etat_clone.profils.values():
                profil_etat.cellules_resultats.pop(cellule_id, None)
            # Le profil actif réaffiche ses cellules_resultats connus par-
            # dessus le widget (cf. _definir_profil_actif) -- sans ce
            # réaffichage explicite ici, le widget resterait vide seulement
            # jusqu'au PROCHAIN rafraîchissement fortuit, ce qui n'est pas
            # ce que "vider" doit garantir immédiatement.
            if etat_clone.profil_actif and widget is not None:
                widget.afficher_resultat(cellule)
            self._rafraichir_panneau_clone_si_ouvert(task, etat_clone)

    def _reparer_indentation_cellule(self, cellule_id: str):
        """Handler du bouton "réparer l'indentation" du bandeau de cellule
        (AJOUT, demande explicite utilisateur suite au TabError/
        IndentationError rencontré à l'exécution : "je veux que tu met ce
        bouton donc de auto-correction parmi les bouton de option de
        cellule [...] c'est le user qui doit declencher cela, pas toujours
        automatique") -- applique reparer_structure_indentation() (cf. sa
        définition, juste avant MoteurExecutionCellule plus bas dans ce
        fichier) au code de CETTE cellule uniquement, jamais aux autres
        cellules du Task.

        Écrit le résultat directement dans l'éditeur (widget.editeur.
        setPlainText) plutôt que dans cellule.code directement : ça
        déclenche naturellement textChanged -> code_modifie ->
        _sur_code_cellule_modifie, qui persiste déjà cellule.code et
        rafraîchit les variables connues -- pas de double sauvegarde à
        gérer ici.

        Même garde-fou que _vider_cellule : pas d'action sur une cellule
        en cours d'exécution ou en attente dans une séquence -- modifier
        le code d'une cellule dont le thread est en train de lire ce même
        code (cf. exec(code, namespace) dans _thread_execution) serait au
        mieux inutile, au pire déroutant.

        Feedback honnête (cf. docstring de reparer_structure_indentation :
        "NE GARANTIT PAS un code syntaxiquement valide dans tous les
        cas") -- après réparation, on tente une compilation à blanc
        (compile(..., "exec"), jamais exécuté) uniquement pour SAVOIR quoi
        annoncer : succès si ça compile, avertissement sinon (le code est
        quand même mis à jour avec la meilleure tentative -- toujours plus
        proche d'une structure valide qu'avant, même si pas encore
        parfait), jamais un message trompeur de succès garanti."""
        if cellule_id in self._moteurs_en_cours:
            self._notify_status("Impossible de réparer l'indentation d'une cellule en cours d'exécution.", error=True)
            return
        if self._sequence_active and self._sequence_file and cellule_id in self._sequence_file:
            self._notify_status("Impossible de réparer l'indentation d'une cellule en attente dans la séquence en cours.", error=True)
            return
        widget = self._cellule_widgets.get(cellule_id)
        if widget is None:
            return
        # AJOUT (affichage WORKSPACE) : cette méthode est le SEUL autre
        # endroit de TaskConfigScreen qui lit ET réécrit l'éditeur en
        # direct. Si la cellule affiche une vue cosmétique (attribution
        # WORKSPACE du profil clone actif), `code_actuel()` renverrait ce
        # texte cosmétique, et le setPlainText plus bas le persisterait
        # via textChanged -- on réparerait donc l'indentation d'un code
        # qui n'est pas le vrai code source, et on figerait des chemins
        # dans project.json. On sort d'abord de l'affichage cosmétique
        # pour travailler sur le VRAI code source, puis on le rétablit à
        # la fin (try/finally : il doit être rétabli quelle que soit la
        # branche de sortie, y compris les deux retours anticipés).
        affichage_cosmetique_a_retablir = widget.restaurer_code_reel()
        try:
            code_avant = widget.code_actuel()
            code_apres = reparer_structure_indentation(code_avant)

            if code_apres == code_avant:
                self._notify_status("Indentation déjà correcte, rien à réparer.")
                return

            widget.editeur.setPlainText(code_apres)

            try:
                compile(code_apres, "<cellule>", "exec")
            except (SyntaxError, IndentationError, TabError) as e:
                self._notify_status(
                    f"Indentation partiellement réparée, mais une erreur subsiste ligne {e.lineno} : {e.msg}. "
                    "Vérifie la structure du bloc concerné.",
                    error=True,
                )
                return
            self._notify_status("Indentation réparée.")
        finally:
            if affichage_cosmetique_a_retablir:
                self._rafraichir_affichage_workspace_cellule_variables(
                    self._task_courant_obj()
                )

    def _sur_code_cellule_modifie(self, cellule_id: str):
        """Persiste le code de la cellule à chaque frappe (comportement
        notebook standard -- pas d'attente de perte de focus, sinon fermer
        l'app juste après avoir tapé perdrait le dernier changement).

        Déclenche AUSSI _rafraichir_variables_globales_editeur (cf.
        BUGFIX docstring de cette méthode) : une variable tout juste
        déclarée dans CETTE cellule doit devenir proposable dans TOUTES
        LES AUTRES cellules du Task dès cette frappe, exactement comme le
        namespace d'exécution réel serait déjà partagé entre elles."""
        task = self._task_courant_obj()
        if task is None:
            return
        widget = self._cellule_widgets.get(cellule_id)
        if widget is None:
            return
        cellule = self._trouver_cellule_par_id(task, cellule_id)
        if cellule is not None:
            # CORRECTIF CRITIQUE (affichage WORKSPACE) -- NE JAMAIS
            # remettre `widget.code_actuel()` en direct ici. Le texte de
            # l'éditeur de cellule_variables peut être une VUE COSMÉTIQUE
            # (valeur de WORKSPACE remplacée par l'attribution du profil
            # clone actif) : le persister tel quel écraserait dans
            # project.json la vraie déclaration `WORKSPACE = []` par une
            # liste de chemins figée, dès la PREMIÈRE touche tapée dans
            # cette cellule. blockSignals ne protège que les écritures
            # programmatiques (definir_code_affiche), pas la frappe de
            # l'utilisateur, qui passe bien par textChanged ->
            # code_modifie -> ici. Cf. _code_a_persister_depuis_editeur
            # pour le détail des deux sous-cas traités.
            cellule.code = self._code_a_persister_depuis_editeur(widget, task, cellule)
        self.project.save()
        self._rafraichir_variables_globales_editeur(task)

    def _sur_titre_cellule_modifie(self, cellule_id: str, titre: str):
        """Persiste le titre Markdown de la cellule (perte de focus du
        champ titre -- cf. CelluleZoneMarkdown.texte_modifie)."""
        task = self._task_courant_obj()
        if task is None:
            return
        cellule = self._trouver_cellule_par_id(task, cellule_id)
        if cellule is not None:
            cellule.titre = titre
        self.project.save()
        self.barre_acces_rapide.rafraichir_titre(cellule_id, titre)

    def _sur_description_cellule_modifie(self, cellule_id: str, description: str):
        """Persiste la description Markdown de la cellule (perte de focus
        du champ description -- cf. CelluleZoneMarkdown.texte_modifie)."""
        task = self._task_courant_obj()
        if task is None:
            return
        cellule = self._trouver_cellule_par_id(task, cellule_id)
        if cellule is not None:
            cellule.description = description
        self.project.save()

    def _sur_toggle_active_cellule(self, cellule_id: str):
        """Bascule l'état actif/désactivé d'une cellule (clic droit sur
        son bouton ▶, cf. TaskCelluleWidget.demande_toggle_active) --
        décision explicite utilisateur : "chque cellule peu etre
        desactiver donc une cellule qui quad on desactive on ne peu plus
        executer, si je lance lexecution globale elle est ignorer".

        Refusée pendant qu'une exécution (individuelle ou séquence "Tout
        exécuter") est en cours sur CETTE cellule précise -- basculer une
        cellule qui tourne activement laisserait le modèle et le moteur
        d'exécution en désaccord sur son état."""
        task = self._task_courant_obj()
        if task is None:
            return
        cellule = self._trouver_cellule_par_id(task, cellule_id)
        widget = self._cellule_widgets.get(cellule_id)
        if cellule is None or widget is None:
            return
        if cellule_id in self._moteurs_en_cours or cellule_id == self._sequence_cellule_courante:
            self._notify_status(
                "Impossible de désactiver une cellule en cours d'exécution.", error=True,
            )
            return
        cellule.active = not getattr(cellule, "active", True)
        widget.definir_active(cellule.active)
        self.project.save()
        self._notify_status(
            "Cellule désactivée." if not cellule.active else "Cellule réactivée."
        )

    def _sur_etiquette_cellule_basculee(self, cellule_id: str, etiquetee: bool):
        """Persiste l'état du bouton "étiquette" et pilote le comportement
        sticky de la cellule "Variable dynamique" SEULE (MAJ décision
        explicite utilisateur : "Main" -- task.cellules[0] -- n'est plus
        collante du tout, elle reste en permanence une cellule normale du
        notebook scrollable, non concernée par ce toggle). Désactiver
        l'étiquette fait redevenir cellule_variables scrollable comme une
        cellule normale -- seule la non-suppression reste acquise en
        toutes circonstances (cf. TaskCelluleWidget.insuprimable, qui ne
        change jamais ici, contrairement à sa position dans les layouts).
        Le signal ne peut venir que du bouton de cellule_variables (seule
        à afficher_bouton_etiquette=True).

        Le placement effectif du widget est délégué à _positionner_row0
        (partagée avec _peupler_cellules) une fois l'état persisté
        ci-dessous."""
        task = self._task_courant_obj()
        if task is None:
            return

        if task.cellule_variables is not None:
            task.cellule_variables.etiquetee = etiquetee
        self.project.save()

        self._positionner_row0(task, etiquetee)

    def _sur_repliee_cellule_basculee(self, cellule_id: str, repliee: bool):
        """Persiste l'état replié (bouton chevron du bandeau gauche, cf.
        TaskCelluleWidget.bouton_replier) sur la TaskCellule concernée --
        l'effet visuel est déjà appliqué côté widget lui-même (cf.
        _sur_toggle_replier), ce handler ne fait QUE persister, même
        pattern que _sur_code_cellule_modifie/_sur_titre_cellule_modifie.
        _trouver_cellule_par_id couvre aussi bien une cellule normale de
        task.cellules que task.cellule_variables (deuxième cellule de la
        row 0, elle aussi repliable comme n'importe quelle autre)."""
        task = self._task_courant_obj()
        if task is None:
            return
        cellule = self._trouver_cellule_par_id(task, cellule_id)
        if cellule is None:
            return
        cellule.repliee = repliee
        self.project.save()

    def _positionner_row0(self, task: Task, etiquetee: bool):
        """Placement PUR (aucune écriture modèle/persistance ici) du
        widget de cellule_variables ("Variable dynamique") selon l'état
        sticky demandé. Factorisée pour être appelée à la fois depuis
        _sur_etiquette_cellule_basculee (après persistance de l'état par
        le clic utilisateur) et depuis _peupler_cellules (pour replacer
        la cellule selon l'état déjà persisté au chargement d'un Task,
        sans re-déclencher de save()).

        MAJ décision explicite utilisateur : "Main" (task.cellules[0])
        n'est plus concernée par cette fonction -- elle vit désormais en
        permanence dans le notebook scrollable comme une cellule normale,
        seule "Variable dynamique" reste sticky/détachable ici.

        Le widget existant n'est jamais détruit/recréé -- juste déplacé
        d'un conteneur à l'autre (removeWidget/insertWidget), ce qui
        préserve tout son état interne (code en cours d'édition, focus,
        etc.)."""
        if task.cellule_variables is None:
            return
        widget = self._cellule_widgets.get(task.cellule_variables.id)
        if widget is None:
            return

        if etiquetee:
            # Ré-épingler : sortir de row0_detachee_container (ou
            # directement du notebook_layout si jamais le widget s'y
            # trouvait hors de ce conteneur -- défense en profondeur),
            # replacer dans le conteneur statique.
            self.row0_detachee_layout.removeWidget(widget)
            self.notebook_layout.removeWidget(widget)
            self.cellule_statique_layout.addWidget(widget, 1)
            # Le conteneur détaché ne sert plus -- le retirer du
            # notebook_layout s'il y était encore (vide maintenant).
            self.notebook_layout.removeWidget(self.row0_detachee_container)
            self.row0_detachee_container.hide()
        else:
            # Détacher : sortir du conteneur statique, placer dans
            # row0_detachee_container (conteneur à une seule cellule
            # désormais, cf. MAJ ci-dessus), puis insérer ce conteneur en
            # position 0 du notebook scrollable, juste avant "Main" et
            # les autres cellules.
            self.cellule_statique_layout.removeWidget(widget)
            widget.setParent(self.row0_detachee_container)
            self.row0_detachee_layout.addWidget(widget, 1)
            self.notebook_layout.removeWidget(self.row0_detachee_container)
            self.notebook_layout.insertWidget(0, self.row0_detachee_container)
            self.row0_detachee_container.show()

    def _namespace_task(self, task: Task) -> dict:
        """Retourne le namespace Python PERSISTANT de ce Task (cf.
        self._namespaces_tasks, docstring de Task : "comme un vrai
        notebook Jupyter" -- une variable définie par l'utilisateur dans
        une cellule doit rester disponible aux cellules suivantes, donc ce
        dict n'est JAMAIS vidé/recréé tant que le Task reste ouvert).
        N'injecte PAS les ComposantExecutable elle-même : ceux-ci doivent
        pointer sur le MoteurExecutionCellule propre à CHAQUE exécution
        (créé dans _executer_cellule, après cet appel) -- c'est
        _executer_cellule qui les (ré)écrit juste après, pour refléter à
        la fois les imports actuels de services_api_importes ET le moteur
        de l'exécution en cours. Tout le reste du namespace (variables,
        fonctions définies par l'utilisateur dans une cellule précédente)
        est laissé intact d'un appel à l'autre.

        Expose aussi ZoneClicRect directement dans le namespace : la
        touche Espace de ApercuTraceableLabel copie désormais un texte
        du type "ZoneClicRect(x=12, y=-51, largeur=277, hauteur=34)"
        (cf. keyPressEvent) destiné à être collé tel quel comme valeur
        de l'argument zone= dans une cellule Task -- sans cette entrée,
        ce texte lève NameError: name 'ZoneClicRect' is not defined à
        l'exécution, faute de import explicite côté utilisateur.

        Expose aussi extraire_texte_fichier (cf. sa docstring) : fonction
        prédéfinie demandée explicitement par l'utilisateur pour lire le
        texte d'un fichier .txt/.md/.html depuis un script Task sans avoir
        à écrire soi-même la lecture de fichier + le parsing HTML.

        Expose aussi ecrire_texte_fichier (cf. sa docstring), symétrique
        en écriture : demandée explicitement par l'utilisateur pour écrire
        du texte dans un fichier depuis un script Task, en le créant s'il
        n'existe pas encore.

        Expose aussi textFile/TextFile (cf. leurs docstrings) ainsi que
        Api2Api/attendre_requete (cf. Api2Api_specification.md et la
        docstring de section juste au-dessus de _construire_espace_noms_
        api2api) -- ce dernier couple lié ICI à self._client_serveur_t
        (cf. son injection tardive via definir_client_reseau_t, MÊME
        instance que celle utilisée par MoteurExecutionCelluleReseau
        pour le mode "réseau" de ce TaskConfigScreen -- un Task LOCAL
        peut donc verrouiller/appeler un Api2Api qui tourne sur
        n'importe quel sAutoniax du réseau, et réciproquement, cf.
        spécification : "n'importe quel Task (local ou réseau)"). Si
        self._client_serveur_t est encore None au moment de cet appel
        (cf. TaskConfigScreen.__init__, injection tardive pas encore
        arrivée, ou websockets manquant), Api2Api()/attendre_requete()
        lèveront leur propre RuntimeError explicite au premier usage
        (cf. leurs gardes internes sur client_serveur_t.api2api_*
        renvoyant {"ok": False,...} quand self._loop/self._ws valent
        None) -- pas la peine de dupliquer cette garde ici."""
        namespace = self._namespaces_tasks.get(task.id)
        if namespace is None:
            namespace = {
                "__builtins__": __builtins__,
                "ZoneClicRect": ZoneClicRect,
                "InstanceExecutable": InstanceExecutable,
                "extraire_texte_fichier": extraire_texte_fichier,
                "ecrire_texte_fichier": ecrire_texte_fichier,
                "textFile": textFile,
                "TextFile": TextFile,
            }
            namespace.update(_construire_espace_noms_api2api(self._client_serveur_t))
            # AJOUT (envoyer_resultat, mode local) -- appel direct au rangement côté pilote
            # (le Task tourne dans ce même process : aucun transport réseau).
            namespace["envoyer_resultat"] = _fabriquer_envoyer_resultat(
                lambda _p, _t=task: (self._ranger_result_output_pilote(_t, None, _p, getattr(_t, "nom", "") or "task"), True)[1]
            )
            self._namespaces_tasks[task.id] = namespace
        return namespace

    def _services_api_utilises_dans_code(self, task: Task, code: str) -> set:
        """Détermine quels ServiceAPI importés dans ce Task sont
        RÉELLEMENT référencés dans le code d'UNE cellule précise (cf.
        MoteurExecutionCellule.services_api_utilises) : pour chaque
        Composant importé, on cherche son nom de variable Python (cf.
        nom_variable_python) comme identifiant isolé dans le texte du
        code -- recherche par mot entier (\\b) pour éviter qu'un nom de
        variable soit un simple sous-texte d'un autre identifiant plus
        long. Analyse volontairement simple (pas un vrai parsing AST) :
        un faux positif (nom mentionné mais pas réellement utilisé, ex.
        dans un commentaire ou une chaîne) exige juste une liaison de
        plus que strictement nécessaire -- pas grave. Un faux négatif est
        pratiquement impossible : le composant doit être nommé tel quel
        pour être utilisé, cf. exemple d'usage dans la docstring de
        ComposantExecutable.

        Teste AUSSI le nom du ServiceAPI lui-même (cf.
        ServiceAPIExecutable, ex: Word.instance()) -- un script peut
        utiliser une instance SANS jamais référencer aucun de ses
        composants (ex: Instance = Word.instance(); Instance.capture()),
        auquel cas la boucle sur les composants ci-dessous ne trouverait
        rien et l'instance ne serait jamais liée avant l'exécution (BUG
        constaté : timeout 'aucune réponse de l'instance', instance
        jamais link-ée côté serveur, cf. discussion).

        Délègue à la fonction libre module-niveau du même nom (cf. sa
        docstring) -- réutilisée telle quelle par le moteur headless du
        Projet Batch, qui n'a pas accès à self."""
        return _services_api_utilises_dans_code(self.project, task, code)

    def _sur_sortie_live(self, cellule_id: str, morceau: str):
        """PATCH logs en direct (local) : slot thread Qt (QueuedConnection). Ajoute au tampon et planifie UN
        rafraîchissement (regroupe les rafales de print, 60 ms)."""
        if cellule_id not in self._moteurs_en_cours:
            return
        buf = self._sortie_live_buf.get(cellule_id, "") + morceau
        if len(buf) > 200000:
            buf = buf[-200000:]
        self._sortie_live_buf[cellule_id] = buf
        if cellule_id not in self._sortie_live_planifie:
            self._sortie_live_planifie.add(cellule_id)
            QTimer.singleShot(60, lambda cid=cellule_id: self._rafraichir_sortie_live(cid))

    def _rafraichir_sortie_live(self, cellule_id: str):
        self._sortie_live_planifie.discard(cellule_id)
        if cellule_id not in self._moteurs_en_cours:
            return
        widget = self._cellule_widgets.get(cellule_id)
        if widget is None:
            return
        widget.afficher_sortie_en_direct(self._sortie_live_buf.get(cellule_id, ""))

    def _executer_cellule(self, cellule_id: str, _callback_apres_sequence: Optional[callable] = None):
        """Exécute une cellule (bouton ▶) : vérifie que tous les
        ServiceAPI importés du Task ont une instance liée, construit/
        complète le namespace persistant du Task avec les
        ComposantExecutable à jour (pointant sur un MoteurExecutionCellule
        propre à CETTE exécution), puis lance le thread d'exécution réel
        (cf. MoteurExecutionCellule.lancer). Le résultat (sortie/statut/
        numéro In[n]) est écrit sur la TaskCellule et affiché via
        widget.afficher_resultat() une fois le thread terminé (callback
        réinjecté sur le thread Qt principal par MoteurExecutionCellule
        elle-même -- jamais d'appel direct à du code Qt depuis le thread
        d'exécution).

        _callback_apres_sequence : réservé à _executer_toutes_cellules
        (bouton global "Tout exécuter") -- appelé(ok: bool) juste après
        que le résultat de CETTE cellule a été affiché, pour enchaîner
        sur la cellule suivante de la séquence. None en usage normal
        (clic individuel sur le ▶ d'UNE cellule, hors séquence) -- ce
        paramètre ne doit JAMAIS être exposé/appelé depuis
        TaskCelluleWidget.demande_execution (connecté sans argument
        supplémentaire, cf. _inserer_widget_cellule)."""
        log_cellule.info(f"[{cellule_id}] clic reçu -- entrée _executer_cellule")
        task = self._task_courant_obj()
        if task is None:
            log_cellule.warning(f"[{cellule_id}] ARRÊT : aucun task courant (self._task_courant_obj() renvoie None)")
            if _callback_apres_sequence is not None:
                _callback_apres_sequence(False)
            return
        widget = self._cellule_widgets.get(cellule_id)
        if widget is None and self._liste_virtuelle_active() \
                and self._trouver_cellule_par_id(task, cellule_id) is not None:
            widget = _FrameMuet()   # PATCH (étape 3) : cellule non montée
        if widget is None:
            log_cellule.warning(f"[{cellule_id}] ARRÊT : aucun widget trouvé dans self._cellule_widgets")
            if _callback_apres_sequence is not None:
                _callback_apres_sequence(False)
            return
        cellule = self._trouver_cellule_par_id(task, cellule_id)
        if cellule is None:
            log_cellule.warning(f"[{cellule_id}] ARRÊT : aucune TaskCellule correspondante dans task.cellules ni task.cellule_variables")
            if _callback_apres_sequence is not None:
                _callback_apres_sequence(False)
            return

        # Cellule désactivée (clic droit sur ▶, cf. TaskCellule.active) --
        # ni l'exécution individuelle ni "Tout exécuter" ne doivent la
        # lancer (décision explicite utilisateur : "si je lance
        # lexecution globale elle est ignorer"). Le bouton ▶ est déjà
        # grisé côté widget dans ce cas (_rafraichir_etat_actif), mais on
        # se protège quand même ici -- notamment pour _callback_apres_
        # sequence qui doit passer directement à la cellule suivante.
        if not getattr(cellule, "active", True):
            log_cellule.info(f"[{cellule_id}] ignorée : cellule désactivée")
            if _callback_apres_sequence is None:
                self._notify_status("Cette cellule est désactivée.", error=True)
            if _callback_apres_sequence is not None:
                _callback_apres_sequence(True)
            return

        if cellule_id in self._moteurs_en_cours:
            log_cellule.warning(f"[{cellule_id}] ARRÊT : déjà présent dans self._moteurs_en_cours (moteur={self._moteurs_en_cours[cellule_id]!r}) -- refus 'déjà en cours'")
            self._notify_status("Cette cellule est déjà en cours d'exécution.", error=True)
            if _callback_apres_sequence is not None:
                _callback_apres_sequence(False)
            return
        # ------------------------------------------------------------------
        # BIFURCATION (Task.mode_execution == "reseau" vs "local", AJOUT --
        # cf. MoteurExecutionCelluleReseau, docstring de section) : les deux
        # branches ci-dessous produisent chacune un `moteur` (contrat public
        # IDENTIQUE, cf. docstring de MoteurExecutionCelluleReseau) et un
        # `namespace` -- tout ce qui suit (self._moteurs_en_cours[cellule_id]
        # = moteur, callback_termine, moteur.lancer(...)) reste COMMUN aux
        # deux modes, inchangé.
        # ------------------------------------------------------------------
        if task.mode_execution == "reseau":
            if self._client_serveur_t is None:
                log_cellule.warning(f"[{cellule_id}] ARRÊT (mode réseau) : self._client_serveur_t est None (websockets manquant ?)")
                self._notify_status(
                    "Réseau indisponible (module 'websockets' manquant) -- exécution impossible.",
                    error=True,
                )
                if _callback_apres_sequence is not None:
                    _callback_apres_sequence(False)
                return
            # SPEC_profils_environnements.md section 7 : le ▶ individuel
            # doit exécuter sur le PROFIL ACTIF (task.services_api_importes,
            # tenu à jour par _definir_profil_actif à CHAQUE changement de
            # ligne sélectionnée dans la liste de profils), pas sur
            # self._profils_reseau_actifs -- mécanisme distinct et plus
            # ancien (rempli à l'initialisation d'un sAutoniax, cf. sa
            # docstring, sans rapport avec la nouvelle liste de profils).
            # Toutes les valeurs de services_api_importes pointent déjà
            # vers le même profil actif (ou toutes vides) depuis que
            # _definir_profil_actif les réaffecte en bloc -- n'importe
            # quelle valeur non vide suffit donc à identifier ce profil.
            #
            # BUGFIX (audit clé composite) : cette valeur est en réalité
            # une CLÉ COMPOSITE (id_executant::nom_profil, cf. _cle_
            # profil_clone) depuis que _definir_profil_actif y écrit
            # etat.profil_actif tel quel (REFONTE MULTI-SAUTONIAX), pas un
            # nom nu -- `cle_profil_active` porte donc ce nom explicite ;
            # le nom nu réellement envoyé au sAutoniax (profil_nom du
            # moteur, cf. docstring de _lancer_sequence_clone_profil :
            # "le sAutoniax ne connaît que ses propres noms de profils
            # locaux, pas cette convention purement interne au pilote")
            # en est extrait juste après.
            cle_profil_active = next(
                (v for v in task.services_api_importes.values() if v), ""
            )
            # PATCH (retrait de combo_executant_reseau, demande explicite
            # utilisateur -- ce combo ne pilotait de toute façon pas le
            # profil actif) : id_executant est désormais dérivé de
            # cle_profil_active ci-dessus (extrait via _id_executant_
            # depuis_cle_profil_clone, symétrique de _nom_depuis_cle_
            # profil_clone juste en dessous) -- l'ancien repli "sAutoniax
            # choisi dans le combo, sans profil actif" n'a plus de
            # source : sans profil actif (cle_profil_active vide),
            # id_executant reste vide, et le garde-fou juste en dessous
            # (`if not id_executant`) redirige vers le panneau Exécutions
            # clone plutôt que vers un ancien flux "Initialiser" devenu
            # sans objet.
            # BUGFIX (régression du patch précédent) : id_executant était
            # calculé AVANT que cle_profil_active ne soit assignée dans
            # cette fonction (UnboundLocalError garanti au tout premier
            # appel, mode réseau, quel que soit le profil actif) -- les
            # deux lignes ont été réordonnées, cle_profil_active doit
            # exister avant d'en dériver quoi que ce soit.
            id_executant = _id_executant_depuis_cle_profil_clone(cle_profil_active) if cle_profil_active else ""
            profil_nom = _nom_depuis_cle_profil_clone(cle_profil_active) if cle_profil_active else ""
            # BUGFIX (retour utilisateur explicite : "lorsque je lance le
            # notebook avec le bouton de run global je n'ai pas cette
            # erreur (ça exécute directement sur le profil actif)... il
            # faut faire en sorte que si on appuie sur le bouton
            # d'exécution d'une cellule... ça s'exécute uniquement sur le
            # profil actif") -- CAUSE : _executant_reseau_pret(task) ne
            # lit QUE self._executants_reseau_prets, écrit UNIQUEMENT par
            # sur_resultat_initialisation_reseau_recu (déclenché par
            # l'ancien bouton "Initialiser", cf. sa docstring : "ce
            # bouton n'initialise plus AUCUNE session... le profil sur
            # lequel travailler est désormais choisi UNE FOIS pour
            # toutes par la sélection de ligne dans la liste de
            # profils"). Ce flag historique n'est donc JAMAIS mis à jour
            # par _definir_profil_actif (le nouveau et SEUL point
            # d'entrée pour changer de profil actif, cf. sa docstring) --
            # un profil sélectionné dans la liste (donc déjà actif et
            # lancé côté sAutoniax, cf. section 4.2 : "un profil
            # n'apparaît que si le sAutoniax le rapporte comme tel")
            # échouait donc TOUJOURS ce check tant que "Initialiser"
            # n'avait pas été explicitement recliqué pour CE Task précis
            # -- alors que "Tout exécuter"/le lancement d'un profil clone
            # (cf. _sur_demande_lancer_clone_profil) ne consultent JAMAIS
            # ce flag et fonctionnaient donc sans ce problème.
            #
            # FIX : si un profil actif résout déjà `profil_nom` (non
            # vide), il est PAR DÉFINITION déjà chargé/actif côté
            # sAutoniax (cf. section 4.2 citée ci-dessus) -- le check
            # historique est alors ignoré, exactement comme le fait déjà
            # le chemin "Tout exécuter"/clone. Il reste appliqué TEL
            # QUEL uniquement quand AUCUN profil n'est actif (profil_nom
            # vide) -- PATCH retrait combo_executant_reseau : id_executant
            # est désormais TOUJOURS dérivé de cle_profil_active, donc
            # id_executant vide signifie nécessairement "aucun profil
            # actif" (plus d'ancien flux "Initialiser" mono-sAutoniax
            # indépendant de la liste de profils, cf. son propre message
            # d'erreur mis à jour en conséquence ci-dessous).
            if not id_executant:
                log_cellule.warning(f"[{cellule_id}] ARRÊT (mode réseau) : aucun profil actif")
                self._notify_status(
                    "Choisissez d'abord un profil actif (Exécutions clone) avant d'exécuter une cellule.",
                    error=True,
                )
                if _callback_apres_sequence is not None:
                    _callback_apres_sequence(False)
                return
            if not profil_nom and not self._executant_reseau_pret(task):
                log_cellule.warning(f"[{cellule_id}] ARRÊT (mode réseau) : aucun sAutoniax prêt (id_executant={id_executant!r})")
                self._notify_status(
                    "Aucun sAutoniax initialisé -- cliquez sur \"Initialiser\" avant d'exécuter une cellule.",
                    error=True,
                )
                if _callback_apres_sequence is not None:
                    _callback_apres_sequence(False)
                return
            moteur = MoteurExecutionCelluleReseau(
                client_serveur_t=self._client_serveur_t,
                task=task,
                cellule_id=cellule_id,
                id_executant=id_executant,
                profil_nom=profil_nom,
            )
            namespace = {}  # ignoré par MoteurExecutionCelluleReseau.lancer, cf. sa docstring
            log_cellule.info(f"[{cellule_id}] MoteurExecutionCelluleReseau créé -- id_executant={id_executant!r}, profil={profil_nom!r}")
        else:
            # --- Vérification + création du moteur : lève ServiceAPINonLieError
            # ou InstanceOccupeeError AVANT tout lancement de thread (cf.
            # docstring de MoteurExecutionCellule.__init__) -- erreur affichée
            # immédiatement, cellule jamais marquée "en cours" dans ce cas.
            # Seuls les ServiceAPI RÉELLEMENT référencés dans le code de cette
            # cellule sont vérifiés/liés (cf. _services_api_utilises_dans_code)
            # -- un Task peut importer plusieurs ServiceAPI sans que ceux non
            # utilisés ici bloquent l'exécution. ---
            if self._client_reseau_execution is None:
                log_cellule.warning(f"[{cellule_id}] ARRÊT : self._client_reseau_execution est None (websockets manquant ?)")
                self._notify_status(
                    "Réseau indisponible (module 'websockets' manquant) -- exécution impossible.",
                    error=True,
                )
                if _callback_apres_sequence is not None:
                    _callback_apres_sequence(False)
                return
            services_utilises = self._services_api_utilises_dans_code(task, cellule.code)
            log_cellule.info(f"[{cellule_id}] services_utilises détectés dans le code = {services_utilises!r}")
            try:
                moteur = MoteurExecutionCellule(
                    client_reseau=self._client_reseau_execution,
                    task=task,
                    cellule_id=cellule_id,
                    instances_occupees_registre=self._instances_occupees_par_nos_tasks,
                    services_api_utilises=services_utilises,
                )
            except (ServiceAPINonLieError, InstanceOccupeeError) as e:
                log_cellule.warning(f"[{cellule_id}] ARRÊT : MoteurExecutionCellule.__init__ a levé {type(e).__name__}: {e}")
                self._notify_status(str(e), error=True)
                if _callback_apres_sequence is not None:
                    _callback_apres_sequence(False)
                return
            log_cellule.info(f"[{cellule_id}] MoteurExecutionCellule créé sans erreur -- instances_necessaires={moteur._instances_necessaires!r}")
            self._sortie_live_buf[cellule_id] = ""   # PATCH logs en direct
            moteur.sortie_live.connect(self._sur_sortie_live, Qt.QueuedConnection)
            namespace = self._namespace_task(task)
            # BUGFIX (variable InstanceExecutable réutilisée d'une cellule à
            # l'autre, cf. docstring de InstanceExecutable) : un RÉSOLVEUR
            # (closure sur task.id, jamais le moteur lui-même) est passé à
            # ServiceAPIExecutable/ComposantExecutable ci-dessous, pour que
            # toute variable créée via "X = NomService.instance()" et réutilisée
            # dans une cellule ULTÉRIEURE retrouve le moteur de CETTE cellule-là
            # au moment de l'appel, jamais le moteur (mort, déconnecté de ses
            # signaux) de la cellule où elle a été créée.
            #
            # RÉSERVÉ AU MODE LOCAL (cf. bifurcation ci-dessus) : un Task en
            # mode réseau n'a accès à aucun ComposantExecutable/
            # ServiceAPIExecutable -- son `namespace` reste vide (cf.
            # docstring de MoteurExecutionCelluleReseau.lancer, limitation
            # actuelle assumée).
            resolveur_moteur = lambda: self._moteur_courant_par_task.get(task.id)
            # Réécrit les ComposantExecutable de ce namespace pour qu'ils
            # pointent sur LE moteur de CETTE exécution précise (créé
            # ci-dessus) -- _namespace_task seule ne peut pas le savoir à
            # l'avance (moteur créé juste après elle dans l'ordre naturel),
            # donc on complète ici plutôt que de réordonner tout le flux.
            # Seuls les composants des ServiceAPI liés (instance_id non vide)
            # sont exposés dans le namespace -- un composant d'un ServiceAPI
            # importé mais pas encore lié reste simplement absent (NameError
            # explicite si le script tente quand même de l'utiliser, plutôt
            # qu'un objet à moitié fonctionnel).
            groupes = self.project.composants_importes_task(task)
            for nom_service, composants in groupes.items():
                instance_id = task.services_api_importes.get(nom_service, "")
                if not instance_id:
                    continue
                for composant in composants:
                    namespace[nom_variable_python(composant.nom)] = ComposantExecutable(
                        composant, instance_id, moteur, namespace,
                    )
                # Exposé sous le nom du ServiceAPI lui-même (cf. docstring
                # ServiceAPIExecutable), à CÔTÉ des ComposantExecutable
                # ci-dessus -- permet mon_instance = NomService.instance()
                # sans jamais écrire d'instance_id en dur dans le script,
                # important puisque le même script peut tourner en parallèle
                # sur plusieurs instances (chaque Task a sa propre liaison).
                # resolveur_moteur (PAS moteur directement, cf. commentaire
                # au-dessus) : la variable "Instance" qu'un script affecte
                # depuis instance() doit rester valide même réutilisée dans
                # une cellule bien plus tard.
                namespace[nom_variable_python(nom_service)] = ServiceAPIExecutable(
                    nom_service, instance_id, resolveur_moteur, namespace,
                )
            # AJOUT (cL, SPEC_composantLayout.md section 6) : MÊME boucle
            # d'injection que ComposantExecutable ci-dessus, appliquée aux
            # ComposantLayout -- namespace commun (un ComposantSingle et un
            # ComposantLayout du même ServiceAPI ne peuvent pas porter le
            # même nom_variable_python, contrainte déjà implicite côté UI
            # de nommage, donc aucun risque d'écrasement croisé ici).
            # ComposantLayoutExecutable() ne prend PAS resolveur_moteur (pas
            # de "X = NomService.instance()" équivalent pour cL, cf. SPEC
            # section 6 -- seul ServiceAPIExecutable a besoin du résolveur)
            # : moteur directement, comme pour ComposantExecutable ci-dessus.
            groupes_layout = self.project.composants_layout_importes_task(task)
            for nom_service, composants_layout in groupes_layout.items():
                instance_id = task.services_api_importes.get(nom_service, "")
                if not instance_id:
                    continue
                for composant_layout in composants_layout:
                    namespace[nom_variable_python(composant_layout.nom)] = ComposantLayoutExecutable(
                        composant_layout, moteur, instance_id, namespace=namespace,
                    )

        self._moteurs_en_cours[cellule_id] = moteur
        self._moteur_courant_par_task[task.id] = moteur
        if _callback_apres_sequence is not None:
            # Mode séquence globale : l'état visuel "en cours" (jaune +
            # spinner + ⏹ désactivé) a déjà été posé par
            # _executer_toutes_cellules AVANT cet appel -- ne pas écraser
            # avec indiquer_en_cours() (qui remettrait un ▶ désactivé
            # normal au lieu du ⏹, cf. TaskCelluleWidget).
            self._sequence_cellule_courante = cellule_id
        else:
            # PATCH (demande utilisateur : « à chaque lancement d'une exécution, la sortie se vide d'abord ») --
            # l'exécution INDIVIDUELLE (▶) conservait l'ancienne sortie sous la cellule jusqu'à l'arrivée du premier
            # résultat. On vide ici (donnée + affichage), comme le fait déjà « Tout exécuter ». Placé APRÈS tous les
            # contrôles de départ : une exécution refusée (cellule désactivée, aucun sAutoniax...) ne perd rien.
            cellule.sortie = ""
            cellule.statut = "inedit"
            cellule.numero_execution = None
            cellule.derniere_image_b64 = None
            widget.afficher_resultat(cellule)   # zone de sortie (texte + images) vidée et masquée
            widget.indiquer_en_cours()
            # Exécution individuelle démarrée : grise le bouton global
            # "Tout exécuter" (décision explicite utilisateur -- pas de
            # séquence par-dessus une cellule isolée déjà en cours).
            self._rafraichir_bouton_global()
        log_cellule.info(f"[{cellule_id}] marqué EN COURS (self._moteurs_en_cours)")

        numero = getattr(task, "_compteur_execution", 0) + 1
        task._compteur_execution = numero

        def callback_termine(resultat: dict):
            _sortie_log = resultat.get("sortie") or ""
            _sortie_log_tronquee = _sortie_log[:200] + ("..." if len(_sortie_log) > 200 else "")
            _resultat_log = {**resultat, "sortie": _sortie_log_tronquee}
            log_cellule.info(f"[{cellule_id}] callback_termine REÇU -- resultat={_resultat_log!r}")
            self._moteurs_en_cours.pop(cellule_id, None)
            self._sortie_live_buf.pop(cellule_id, None)   # PATCH logs en direct
            # Ne retire du registre "moteur courant du Task" que si c'est
            # encore CE moteur qui y figure -- si une AUTRE cellule du même
            # Task a démarré entre-temps (exécution parallèle, cf.
            # _moteur_courant_par_task), son propre moteur y est déjà
            # inscrit et ne doit pas être effacé par la fin de celui-ci.
            if self._moteur_courant_par_task.get(task.id) is moteur:
                self._moteur_courant_par_task.pop(task.id, None)
            if _callback_apres_sequence is not None:
                self._sequence_cellule_courante = None
            cellule.numero_execution = numero
            cellule.statut = "succes" if resultat["ok"] else "erreur"
            cellule.sortie = resultat["sortie"] if resultat["ok"] else (
                resultat["sortie"] + ("\n" if resultat["sortie"] and resultat["erreur"] else "") + (resultat["erreur"] or "")
            )
            self.project.save()
            # SPEC_profils_environnements.md section 7, dernier paragraphe :
            # un ▶ individuel doit aussi mettre à jour profil_etat.
            # cellules_resultats/statut du profil actif, sinon le
            # badge/statut affiché dans la liste de profils ne refléterait
            # que les exécutions lancées via le bouton global ou le bouton
            # de ligne, jamais les ▶ isolés. Fait dès cette itération
            # plutôt que reporté (ajout localisé qui n'écrase aucun
            # comportement existant : la cellule réelle continue d'être
            # mise à jour ci-dessus exactement comme avant).
            #
            # BUGFIX (relecture complète de la chaîne mode local) : ce
            # bloc était restreint à `task.mode_execution == "reseau"`,
            # avec un commentaire affirmant que "`moteur` est un
            # MoteurExecutionCelluleReseau ici" -- affirmation FAUSSE : la
            # bifurcation plus haut dans _executer_cellule (cf. son
            # commentaire "BIFURCATION Task.mode_execution == reseau vs
            # local") produit un `moteur` MoteurExecutionCellule (local)
            # dans la branche else, avec le même attribut cellule_id, et
            # etat.profil_actif est affecté de façon RIGOUREUSEMENT
            # IDENTIQUE dans les deux modes par _definir_profil_actif
            # (seule la valeur écrite dans task.services_api_importes
            # diffère -- cf. sa docstring section 3.10). Résultat sans ce
            # correctif : en mode local, le ▶ individuel sur le profil
            # actif du panneau clone ne mettait JAMAIS à jour profil_etat.
            # cellules_resultats/statut -- le badge de ce profil dans le
            # panneau clone restait figé sur son dernier statut de lot,
            # ignorant tout ▶ isolé lancé entre-temps, alors que le réseau
            # bénéficiait déjà de cette synchronisation. Retire simplement
            # la condition de mode : ce bloc ne lit/écrit rien de
            # spécifique à un type de moteur, uniquement etat_clone.
            # profil_actif et etat_clone.profils (mêmes structures dans
            # les deux modes).
            etat_clone = self._executions_clone.get(task.id)
            nom_profil_actif = etat_clone.profil_actif if etat_clone is not None else None
            if nom_profil_actif:
                profil_etat_actif = etat_clone.profils.get(nom_profil_actif)
                if profil_etat_actif is not None:
                    profil_etat_actif.statut = cellule.statut
                    profil_etat_actif.cellule_courante_id = None
                    cellule_temp = TaskCellule(
                        id=cellule_id,
                        titre=getattr(cellule, "titre", ""),
                        description=getattr(cellule, "description", ""),
                        code=cellule.code,
                        sortie=cellule.sortie,
                        statut=cellule.statut,
                        numero_execution=numero,
                    )
                    profil_etat_actif.cellules_resultats[cellule_id] = cellule_temp
                    self._rafraichir_panneau_clone_si_ouvert(task, etat_clone)
                    self._rafraichir_bouton_global()
            widget_actuel = self._cellule_widgets.get(cellule_id)
            if widget_actuel is not None:
                widget_actuel.afficher_resultat(cellule)
                self._reafficher_image_si_presente(widget_actuel, moteur)
                # AJOUT (demande explicite utilisateur : "es ce que on peu
                # modifier le code de tels sorte que la ligne specifique en
                # question apprait avec la ligne rouge") -- surligne dans
                # l'éditeur la ligne exacte fautive (cf.
                # _extraire_ligne_erreur dans _thread_execution, qui a
                # calculé resultat["ligne_erreur"]) en cas d'échec, ou
                # efface un éventuel surlignage résiduel d'une exécution
                # PRÉCÉDENTE en cas de succès -- sinon une cellule qui a
                # fini par réussir après correction garderait affichée en
                # rouge une ligne qui n'est plus fautive.
                if resultat["ok"]:
                    widget_actuel.editeur.effacer_surlignage_erreur()
                else:
                    widget_actuel.editeur.surligner_ligne_erreur(resultat.get("ligne_erreur"))
            elif self._liste_virtuelle_active():   # PATCH (étape 3) : cellule non montée, normal
                log_cellule.debug(f"[{cellule_id}] cellule non montée au moment du callback -- l'affichage sera refait au rebranchement")
            else:
                log_cellule.warning(f"[{cellule_id}] widget introuvable au moment du callback -- résultat perdu pour l'affichage (mais cellule.sortie/statut sont bien sauvegardés)")
            if resultat["ok"]:
                self._notify_status(f"Cellule exécutée (In[{numero}]).")
            else:
                self._notify_status(f"Erreur d'exécution (In[{numero}]) -- voir sortie de la cellule.", error=True)
            if _callback_apres_sequence is not None:
                # PATCH BUGFIX (clignotement image en séquence "Tout
                # exécuter" -- l'image s'affichait un instant puis
                # disparaissait) : `moteur` transmis en plus de `ok`
                # -- cf. docstring de _apres dans
                # _lancer_prochaine_cellule_sequence pour le détail
                # complet du bug (afficher_resultat y était rappelé
                # SANS _reafficher_image_si_presente juste après, donc
                # une cellule dont la SEULE sortie est une image --
                # cellule.sortie vide -- se faisait recacher par la
                # branche `else: self.zone_sortie.hide()` de
                # afficher_resultat, sans jamais être reposée).
                _callback_apres_sequence(resultat["ok"], moteur)
            else:
                # Fin d'une exécution individuelle : redonne la main au
                # bouton global si plus aucune cellule ne tourne.
                self._rafraichir_bouton_global()

        # AJOUT : efface tout surlignage rouge résiduel d'une exécution
        # PRÉCÉDENTE dès qu'une nouvelle exécution démarre -- couvre le
        # cas où l'utilisateur relance directement (▶ ou "Tout exécuter")
        # SANS retaper de texte entre-temps (_sur_texte_modifie, qui gère
        # le cas où il modifie le code, ne se déclenche pas ici puisque
        # rien n'a changé dans l'éditeur).
        widget.editeur.effacer_surlignage_erreur()

        # CORRECTIF (bug race condition confirmé en prod : "spinner
        # bloqué malgré un succès réel" -- cf. logs [reseau][resultat]
        # ARRÊT session_id=... absent de self._sessions_execution_reseau,
        # observé sur un succès qui revient en ~1s) -- ANCIEN ORDRE :
        # moteur.lancer() était appelé D'ABORD, puis session_id lu et
        # enregistré APRÈS coup, en supposant qu'aucun résultat ne
        # pourrait revenir avant cet enregistrement. Ce raisonnement était
        # FAUX : moteur.lancer() -> executer_notebook_distant() planifie
        # la commande réseau sur la boucle asyncio (asyncio.run_
        # coroutine_threadsafe, thread SÉPARÉ du thread Qt appelant) puis
        # retourne IMMÉDIATEMENT -- rien ne garantit que la ligne
        # d'enregistrement ci-dessous s'exécute, sur le thread Qt, avant
        # que la coroutine réseau (sur son propre thread) ait déjà reçu
        # la réponse du sAutoniax et émis notebook_distant_resultat_recu.
        # Plus le sAutoniax répond vite (cas nominal, pas un cas
        # d'erreur), plus cette fenêtre de race est franchissable.
        #
        # NOUVEL ORDRE : moteur._session_id est désormais généré dans
        # MoteurExecutionCelluleReseau.__init__ (donc AVANT même cet
        # appel à lancer()) -- l'enregistrement dans _sessions_execution_
        # reseau peut donc être fait ICI, AVANT moteur.lancer(), avec la
        # garantie qu'aucun résultat réseau ne peut arriver avant que ce
        # mapping n'existe. moteur.lancer() (qui transmet ce même
        # session_id à executer_notebook_distant, cf. sa docstring)
        # garantit que le sAutoniax et le routage local sont bien
        # synchronisés sur la même valeur.
        if isinstance(moteur, MoteurExecutionCelluleReseau):
            log_cellule.info(
                f"[{cellule_id}] [reseau][routage] enregistré dans _sessions_execution_reseau "
                f"AVANT moteur.lancer() : session_id={moteur._session_id!r} -> "
                f"(task_id={task.id!r}, cellule_id={cellule_id!r})"
            )
            self._sessions_execution_reseau[moteur._session_id] = (task.id, cellule_id)

        # ------------------------------------------------------------------
        # AJOUT (revue de bout en bout de la chaîne WORKSPACE) -- TROU RÉEL
        # comblé ici : jusqu'à ce patch, l'attribution WORKSPACE n'était
        # honorée QUE par les séquences du panneau clone (_lancer_sequence_
        # clone_profil[_local]). Le ▶ individuel et le bouton global "Tout
        # exécuter" (qui passe par cette même méthode, cf.
        # _callback_apres_sequence) n'injectaient RIEN, alors qu'ils
        # s'exécutent pourtant explicitement SUR LE PROFIL ACTIF (cf. le
        # commentaire "SPEC_profils_environnements.md section 7" plus haut
        # dans cette méthode). Un script lancé au ▶ voyait donc LIST_TASKS =
        # [] là où le même script lancé depuis le panneau clone voyait ses
        # tâches -- incohérence silencieuse, et désormais trompeuse puisque
        # l'éditeur affiche la valeur attribuée à ce profil.
        #
        # Mécanique RIGOUREUSEMENT identique à celle des séquences clone,
        # réutilisée telle quelle plutôt que réinventée (cf. spec section
        # 8) :
        #   - mode local : le namespace est un vrai dict Python partagé,
        #     namespace["LIST_TASKS"] = [...] suffit ;
        #   - mode réseau : le pilote n'a aucun namespace partagé avec le
        #     sAutoniax, il faut préfixer le TEXTE du code envoyé.
        # Et dans les deux cas, JAMAIS pour cellule_variables elle-même :
        # son propre code réaffecte LIST_TASKS = [] tout en haut de son
        # bloc, donc une injection faite avant serait immédiatement
        # écrasée (cf. docstring de prefixer_code_avec_workspace). Pour
        # les cellules suivantes, l'injection a bien lieu avant CHAQUE
        # lancement, ce qui rend inutile toute réimposition après coup :
        # le namespace de Task est persistant, mais on le réécrit de toute
        # façon au lancement suivant.
        #
        # Aucune injection si aucun profil clone n'est actif, ou si ce
        # profil n'a aucune tâche attribuée : comportement stritement
        # inchangé par rapport à avant ce patch dans ces deux cas.
        #
        # RENOMMAGE (PATCH v2, SPEC_patch_tasks_json.md section 5 ; PATCH
        # v4) : `chemins_workspace` s'appelait ainsi quand chaque élément
        # était un chemin (str) de fichier Task_N.json -- désormais une
        # liste de dicts de champs métier DIRECTEMENT (cf.
        # ExecutionCloneEtat.workspace_attribution), renommée
        # `taches_workspace` pour ne plus induire en erreur sur le type
        # des éléments.
        etat_clone_workspace = self._executions_clone.get(task.id)
        cle_profil_workspace = (
            etat_clone_workspace.profil_actif if etat_clone_workspace is not None else None
        )
        taches_workspace = (
            list(etat_clone_workspace.workspace_attribution.get(cle_profil_workspace, []))
            if cle_profil_workspace else []
        )
        est_cellule_variables = (
            getattr(task, "cellule_variables", None) is not None
            and cellule_id == task.cellule_variables.id
        )
        # `cellule.code` reste la source de vérité partout ailleurs
        # (affichage, détection des ServiceAPI utilisés, persistance) --
        # seul le texte RÉELLEMENT transmis au moteur peut différer, et
        # uniquement en mode réseau.
        code_a_executer = cellule.code
        if not est_cellule_variables:
            if task.mode_execution == "reseau":
                if taches_workspace:
                    code_a_executer = prefixer_code_avec_workspace(cellule.code, taches_workspace)
                # Mode réseau, taches_workspace vide : rien à préfixer --
                # le sAutoniax distant n'a de toute façon aucun namespace
                # persistant entre exécutions côté pilote (cf. docstring
                # de prefixer_code_avec_workspace), donc aucune "valeur
                # périmée" possible à réinitialiser ici, contrairement au
                # mode local juste en dessous.
            else:
                # CORRECTIF (aucun profil clone actif, ou profil actif
                # sans tâche attribuée -> taches_workspace == [], donc
                # ancien `if taches_workspace` faux -> bloc entier sauté
                # -> namespace["LIST_TASKS"] jamais réécrit -> conservait
                # la dernière valeur non-vide d'un profil PRÉCÉDEMMENT
                # actif, silencieusement, au lieu de retomber à [] comme
                # attendu) -- namespace est un dict PERSISTANT par Task
                # (self._namespaces_tasks, cf. _namespace_task), donc
                # cette réinitialisation explicite est nécessaire à
                # chaque lancement, que taches_workspace soit vide ou non.
                namespace["LIST_TASKS"] = list(taches_workspace)
            log_cellule.info(
                f"[{cellule_id}] LIST_TASKS {'injecté' if taches_workspace else 'réinitialisé (vide)'} "
                f"pour le profil actif {cle_profil_workspace!r} "
                f"({len(taches_workspace)} tâche(s), mode={task.mode_execution!r})"
            )

        log_cellule.info(f"[{cellule_id}] appel moteur.lancer() -- démarrage du thread d'exécution")
        moteur.lancer(namespace, code_a_executer, callback_termine)

    # ------------------------------------------------------------------
    # Bouton global "Tout exécuter" / "Tout arrêter" (bascule) + "Vider
    # toutes les cellules" -- cf. docstring des attributs _sequence_*
    # dans __init__. Comportement (décisions explicites utilisateur,
    # récapitulées avant implémentation) :
    #   - Bouton global désactivé si une cellule tourne déjà
    #     INDIVIDUELLEMENT (hors séquence) -- pas de séquence par-dessus.
    #   - Pendant la séquence : chaque cellule pas encore passée affiche
    #     ⏹ grisé (non cliquable) ; celle en cours affiche ⏹ jaune +
    #     spinner (non cliquable non plus -- seul l'arrêt global agit) ;
    #     une cellule terminée (succès/erreur) redevient ▶ normal tout de
    #     suite, cliquable individuellement à nouveau.
    #   - "Tout arrêter" coupe la cellule en cours (MoteurExecutionCellule
    #     .arreter(), détachement propre, cf. sa docstring), la marque
    #     "interrompu" (orange, ▶ cliquable de nouveau), et remet TOUTES
    #     les cellules encore en attente en ▶ normal immédiatement -- pas
    #     d'état gelé après une coupure.
    #   - Une cellule qui échoue (statut "erreur") pendant la séquence
    #     INTERROMPT la suite (PATCH, demande explicite utilisateur : "je
    #     veux que ce genre d'exceptions arrete le notebook") -- comportement
    #     standard de notebook (Jupyter "Run All" s'arrête par défaut sur
    #     la première exception non gérée) ; "Tout arrêter" reste
    #     disponible pour couper manuellement une cellule encore en cours.
    # ------------------------------------------------------------------
    def _auto_selectionner_clone_unique(self, task):
        """PATCH (demande utilisateur) : s'il n'y a qu'UN SEUL clone dans le panneau de clones et qu'aucun n'est
        sélectionné, le bouton d'exécution le sélectionne et l'exécute."""
        if task is None:
            return
        etat = self._executions_clone.get(task.id)
        if etat is None or etat.profil_actif or len(etat.profils) != 1:
            return
        self._definir_profil_actif(task, next(iter(etat.profils)))

    def _sur_clic_bouton_executer_tout(self):
        """SPEC_profils_environnements.md section 6.1 : si un profil est
        actif, le bouton global lance/arrête LA SÉQUENCE DE CE PROFIL
        (même logique que le bouton individuel de sa ligne, section 4.5)
        plutôt que le run "sans profil". Comportement inchangé quand
        aucun profil n'est actif.

        CORRECTIF (cf. docstring de _sur_demande_lancer_clone_profil) :
        transmet désormais ouvrir_rendu_reseau=True explicitement sur ce
        chemin -- avant ce patch, le panneau de rendu ne s'ouvrait
        jamais ici, clic gauche ou droit confondus, dès qu'un profil
        était actif."""
        task = self._task_courant_obj()
        self._auto_selectionner_clone_unique(task)
        etat = self._executions_clone.get(task.id) if task is not None else None
        profil_actif = etat.profil_actif if etat is not None else None
        if profil_actif:
            profil_etat = etat.profils.get(profil_actif) if etat is not None else None
            if profil_etat is not None and profil_etat.statut in ("en_attente", "en_cours"):
                self._sur_demande_arreter_clone_profil(profil_actif)
            else:
                self._sur_demande_lancer_clone_profil(profil_actif, ouvrir_rendu_reseau=True)
            return
        if self._sequence_active:
            self._arreter_sequence()
        else:
            self._executer_toutes_cellules()

    def _sur_clic_droit_bouton_executer_tout(self):
        """PATCH (demande explicite utilisateur : "je veux que lorsque
        on clic sur le bouton de run global avec le clic droit ça
        exécute sans ouvrir le visualisateur, donc la
        FenetreRenduTaskReseau") -- même point d'entrée que le clic
        gauche (_sur_clic_bouton_executer_tout ci-dessus), mais force
        ouvrir_rendu_reseau=False sur _executer_toutes_cellules pour
        que le panneau flottant de rendu réseau (cf. docstring de
        _executer_toutes_cellules, PATCH "ouvre directement ce panneau")
        ne s'ouvre PAS automatiquement, même en mode réseau. N'affecte
        que l'ouverture automatique du panneau -- si celui-ci est déjà
        ouvert manuellement (bouton "Voir le rendu" dédié), il reste
        ouvert tel quel, rien ici ne le ferme.

        Un clic droit pendant une séquence déjà active arrête la
        séquence exactement comme un clic gauche (même bascule ▶/⏹
        que le clic gauche, cf. QToolButtonAvecClicDroit -- pas de sens
        à distinguer clic gauche/droit pour "Tout arrêter", seul le
        LANCEMENT a un comportement différent selon le bouton).

        CORRECTIF (bug rapporté : le panneau ne s'ouvrait plus JAMAIS,
        clic gauche ou droit confondus, dès qu'un profil était actif --
        cf. docstring de _sur_demande_lancer_clone_profil) -- ce chemin
        appelait auparavant _sur_clic_bouton_executer_tout() telle
        quelle quand un profil est actif, ce qui route maintenant vers
        ouvrir_rendu_reseau=True (son propre comportement de clic
        gauche) : appeler cette méthode ici aurait donc ouvert le
        panneau au clic DROIT, l'inverse de l'effet voulu. Fix : appel
        direct à _sur_demande_lancer_clone_profil(..., ouvrir_rendu_
        reseau=False), symétrique exact du clic gauche ci-dessus, sans
        repasser par _sur_clic_bouton_executer_tout."""
        task = self._task_courant_obj()
        self._auto_selectionner_clone_unique(task)
        etat = self._executions_clone.get(task.id) if task is not None else None
        profil_actif = etat.profil_actif if etat is not None else None
        if profil_actif:
            profil_etat = etat.profils.get(profil_actif) if etat is not None else None
            if profil_etat is not None and profil_etat.statut in ("en_attente", "en_cours"):
                self._sur_demande_arreter_clone_profil(profil_actif)
            else:
                self._sur_demande_lancer_clone_profil(profil_actif, ouvrir_rendu_reseau=False)
            return
        if self._sequence_active:
            self._arreter_sequence()
        else:
            self._executer_toutes_cellules(ouvrir_rendu_reseau=False)

    def _executer_toutes_cellules(self, ouvrir_rendu_reseau: bool = True):
        task = self._task_courant_obj()
        if task is None:
            return
        if self._sequence_active:
            return  # déjà en cours, un double-clic ne doit rien redémarrer
        if self._moteurs_en_cours:
            # Une cellule tourne déjà individuellement -- le bouton global
            # est censé être désactivé dans ce cas (cf.
            # _rafraichir_bouton_global), mais on se protège quand même
            # d'un clic parvenu malgré tout (ex. double-clic rapide avant
            # que le refresh visuel n'ait eu lieu).
            self._notify_status(
                "Une cellule est déjà en cours d'exécution individuellement -- attendez sa fin avant « Tout exécuter ».",
                error=True,
            )
            return

        # BUGFIX (retour utilisateur : "sa refuse de charger la cellule
        # des variable dynamique") : cellule_variables était absente de
        # cette liste (construite auparavant depuis task.cellules
        # seulement), donc jamais exécutée par "Tout exécuter" -- toute
        # variable qu'elle déclare n'était donc JAMAIS écrite dans
        # _namespace_task avant que le reste du notebook ne s'exécute,
        # d'où le NameError des cellules suivantes qui l'utilisent.
        # Placée EN PREMIER (avant même cellules[0]) : cellule_variables
        # est une init de variables destinées aux cellules suivantes (cf.
        # docstring Task.cellule_variables), elle doit donc toujours
        # s'exécuter avant le reste du notebook, y compris avant
        # cellules[0] -- reste cohérent même si la row 0 est détachée
        # (état "etiquetee" n'affecte que l'affichage, jamais l'ordre
        # d'exécution).
        #
        # Les cellules désactivées (clic droit sur ▶, cf. TaskCellule.
        # active) sont exclues DÈS ICI de la file -- décision explicite
        # utilisateur : "si je lance lexecution globale elle est
        # ignorer". Les en exclure en amont (plutôt que les laisser dans
        # la file et les court-circuiter dans _executer_cellule) évite
        # aussi que indiquer_en_attente_sequence()/indiquer_en_cours_
        # sequence() n'écrasent temporairement leur icône "désactivée"
        # pendant toute la durée de la séquence.
        self._sequence_file = []
        if task.cellule_variables is not None and getattr(task.cellule_variables, "active", True):
            self._sequence_file.append(task.cellule_variables.id)
        self._sequence_file.extend(c.id for c in task.cellules if getattr(c, "active", True))
        self._sequence_active = True
        self._sequence_cellule_courante = None

        # PATCH (demande explicite utilisateur : quand on lance "Tout
        # exécuter", toutes les sorties doivent d'abord se vider) -- même
        # remise à l'état "jamais exécutée" que _vider_cellule (sortie,
        # statut, numéro In[n]), appliquée ici à CHAQUE cellule de la
        # séquence avant le premier lancement, pour ne jamais laisser
        # affiché le résultat d'une exécution précédente pendant qu'une
        # nouvelle séquence tourne. Seulement les cellules de la séquence
        # (donc actives, cf. filtre ci-dessus) -- une cellule désactivée,
        # elle, garde sa dernière sortie affichée puisqu'elle n'est pas
        # concernée par ce lancement. Fait AVANT indiquer_en_attente_
        # sequence() ci-dessous : ce dernier pose déjà son propre état
        # visuel "en attente" par-dessus, donc l'ordre entre les deux
        # n'a pas d'incidence visuelle, mais la donnée (cellule.sortie)
        # doit être vidée dans tous les cas, y compris pour la cellule
        # qui sera immédiatement re-basculée en "en cours".
        for cid in self._sequence_file:
            cellule = self._trouver_cellule_par_id(task, cid)
            if cellule is None:
                continue
            cellule.sortie = ""
            cellule.statut = "inedit"
            cellule.numero_execution = None
            w = self._cellule_widgets.get(cid)
            if w is not None:
                w.afficher_resultat(cellule)
        self.project.save()

        # Pose tout de suite l'état visuel "en attente" (gris, ⏹ désactivé)
        # sur TOUTES les cellules -- la première sera immédiatement
        # re-basculée en "en cours" par _lancer_prochaine_cellule_sequence.
        for cid in self._sequence_file:
            w = self._cellule_widgets.get(cid)
            if w is not None:
                w.indiquer_en_attente_sequence()

        self._rafraichir_bouton_global()
        self._notify_status("Exécution de toutes les cellules...")
        # PATCH (demande explicite utilisateur : "je veux aussi que en
        # mode réseau lorsque je lance l'exécution ça ouvre directement
        # ce panneau ... le run global") -- ouvre le panneau de rendu
        # réseau AUTOMATIQUEMENT au lancement de "Tout exécuter", mais
        # SEULEMENT en mode réseau (task.mode_execution == "reseau",
        # même check que la bifurcation de _executer_cellule ci-dessus) :
        # un run en mode local n'a pas de sAutoniax distant à montrer.
        # Placé ICI (juste avant le lancement réel de la séquence, pas
        # plus tôt dans cette méthode) : le panneau ne s'ouvre que si
        # l'exécution va VRAIMENT démarrer, pas si un garde-fou
        # au-dessus (séquence déjà active, cellule individuelle en
        # cours...) a fait sortir la méthode plus tôt. Réutilise
        # _sur_clic_voir_rendu_reseau tel quel (même méthode que le
        # bouton "Voir le rendu" dédié) -- idempotent si le panneau est
        # déjà ouvert (cf. self._fenetre_rendu_reseau is None dans son
        # corps), et hérite donc aussi du comportement "auto à
        # l'ouverture" (cf. FenetreRenduTaskReseau._auto_a_ouverture)
        # sans rien dupliquer ici.
        #
        # PATCH (demande explicite utilisateur : clic droit sur le
        # bouton global = exécuter sans ouvrir ce panneau) : gardé
        # derrière ouvrir_rendu_reseau, True par défaut (clic gauche,
        # comportement inchangé) -- cf. _sur_clic_droit_bouton_executer_
        # tout, qui appelle cette méthode avec False.
        if task.mode_execution == "reseau" and ouvrir_rendu_reseau:
            # PATCH (demande explicite utilisateur : "lorsque on lance
            # lexecution sa efface automatiquement les logs de terminal
            # dans ce panneau") -- vide le terminal du panneau flottant
            # AVANT de l'ouvrir/rafraîchir (self._sur_clic_voir_rendu_
            # reseau juste en dessous), pour ne jamais laisser affichée
            # la sortie de la précédente exécution pendant que la
            # nouvelle démarre. self._fenetre_rendu_reseau peut déjà
            # exister (panneau ouvert manuellement plus tôt via "Voir le
            # rendu", ou une exécution précédente) -- ne rien faire s'il
            # n'existe pas encore (rien à effacer, panneau.effacer_
            # terminal serait de toute façon un no-op sur un terminal
            # déjà vide à la création).
            if self._fenetre_rendu_reseau is not None:
                self._fenetre_rendu_reseau.panneau.effacer_terminal()
            self._sur_clic_voir_rendu_reseau()
        self._lancer_prochaine_cellule_sequence()

    def _lancer_prochaine_cellule_sequence(self):
        """Dépile self._sequence_file et lance la cellule suivante --
        appelée une première fois par _executer_toutes_cellules, puis en
        boucle par le callback de chaque cellule (_callback_apres_sequence
        passé à _executer_cellule) jusqu'à ce que la file soit vide OU
        qu'une cellule échoue (cf. _apres ci-dessous -- PATCH : la
        séquence s'arrête désormais sur la première erreur rencontrée,
        décision explicite utilisateur : "je veux que ce genre
        d'exceptions arrete le notebook" -- avant ce patch, une cellule en
        échec n'interrompait jamais la suite, cf. discussion, ce qui
        laissait le bouton global bloqué en ⏹ "Tout arrêter" alors que la
        séquence avait en réalité déjà terminé son travail avec une
        cellule en erreur)."""
        if not self._sequence_active or self._sequence_file is None:
            return  # séquence coupée entre-temps par _arreter_sequence
        if not self._sequence_file:
            # Séquence terminée normalement (toutes les cellules sont
            # passées SANS aucune erreur -- cf. _apres ci-dessous, qui
            # arrête désormais la séquence dès la première cellule en
            # échec plutôt que d'atteindre ce point avec une file vide
            # malgré une erreur en cours de route).
            self._sequence_active = False
            self._sequence_file = None
            self._sequence_cellule_courante = None
            # AJOUT : badge global -> vert (séquence allée jusqu'au bout
            # sans qu'aucune cellule n'échoue, cf. docstring plus haut).
            self._dernier_statut_sequence = "succes"
            self._rafraichir_bouton_global()
            self._notify_status("Exécution de toutes les cellules terminée.")
            return

        cellule_id = self._sequence_file.pop(0)
        widget = self._cellule_widgets.get(cellule_id)
        if widget is not None:
            widget.indiquer_en_cours_sequence()

        def _apres(ok: bool, moteur_termine: Optional["MoteurExecutionCelluleReseau"] = None):
            # LOG CIBLÉ (diagnostic) : trace CHAQUE fin de cellule dans une
            # séquence "Tout exécuter" -- avec ok (succès/échec réel) et un
            # extrait de cellule.sortie/cellule.erreur au moment précis où
            # la décision "continuer ou arrêter toute la séquence" est
            # prise juste plus bas (if not ok:). Sans ce log, un arrêt de
            # séquence sur la dernière cellule (échec silencieux dans
            # exec(), ex. RuntimeError levée par une fonction utilisateur)
            # est indiscernable d'une séquence qui n'a simplement jamais
            # atteint cette cellule.
            task_pour_log = self._task_courant_obj()
            cellule_pour_log = self._trouver_cellule_par_id(task_pour_log, cellule_id) if task_pour_log is not None else None
            _sortie_log = (getattr(cellule_pour_log, "sortie", "") or "")[:500] if cellule_pour_log is not None else "<cellule introuvable>"
            log_cellule.info(
                f"[_lancer_prochaine_cellule_sequence/_apres] cellule={cellule_id!r} ok={ok} "
                f"sortie_actuelle={_sortie_log!r} file_restante_avant_decision={list(self._sequence_file) if self._sequence_file else []!r}"
            )
            # Réinjecté sur le thread Qt principal (cf. callback_termine
            # dans _executer_cellule, lui-même déclenché via le signal Qt
            # _resultat_pret -- jamais d'appel direct depuis le thread
            # d'exécution).
            #
            # BUGFIX : si _executer_cellule échoue AVANT de lancer le
            # thread (ex. ServiceAPINonLieError, InstanceOccupeeError,
            # cellule déjà en cours, réseau indisponible...), son
            # callback_termine normal n'est JAMAIS appelé -- la cellule
            # reste donc visuellement bloquée sur l'état ⏹ jaune posé par
            # indiquer_en_cours_sequence() juste au-dessus, alors même que
            # la séquence s'arrête déjà sur cette même cellule (cf.
            # ci-dessous). On force ici un réaffichage depuis le statut
            # réel de la TaskCellule pour la faire ressortir de cet état
            # -- si le thread a bien tourné, afficher_resultat() a déjà
            # été appelé par callback_termine et cet appel est sans effet
            # (juste redondant, pas de risque à le refaire).
            #
            # PATCH BUGFIX (clignotement image en séquence "Tout exécuter"
            # -- rapporté par l'utilisateur : "il vient de se passer un
            # truc etrange, l'image apparait mais repart brutalement")
            # -- CAUSE : ce afficher_resultat() ci-dessous était le
            # QUATRIÈME point d'écrasement de zone_sortie (cf. docstring
            # de _reafficher_image_si_presente, qui n'en documentait que
            # TROIS), jamais suivi d'un _reafficher_image_si_presente --
            # une cellule dont la SEULE sortie est une image (cellule.
            # sortie vide, cf. sur_image_execution_reseau_recu) se faisait
            # donc recacher par la branche `else: self.zone_sortie.hide()`
            # de afficher_resultat, juste après que callback_termine
            # l'ait correctement affichée. `moteur_termine` -- transmis
            # par callback_termine via _callback_apres_sequence, cf. son
            # propre patch -- est le MÊME moteur déjà utilisé par
            # callback_termine juste avant (donc son _sortie_accumulee
            # est déjà peuplé si une image a été reçue), passé ici parce
            # qu'il n'est plus dans self._moteurs_en_cours à ce stade
            # (déjà popped par callback_termine avant d'appeler
            # _callback_apres_sequence).
            if cellule_id in self._moteurs_en_cours:
                # Cas normal : le thread tourne encore, callback_termine
                # se chargera de l'affichage à sa vraie fin -- rien à faire.
                pass
            else:
                task_actuel = self._task_courant_obj()
                if task_actuel is not None:
                    # Même correctif que _arreter_sequence : cellule_variables
                    # fait partie de la séquence désormais, _trouver_cellule_par_id
                    # la retrouve correctement (contrairement à un lookup
                    # limité à task_actuel.cellules).
                    cellule_actuelle = self._trouver_cellule_par_id(task_actuel, cellule_id)
                    widget_actuel = self._cellule_widgets.get(cellule_id)
                    if cellule_actuelle is not None and widget_actuel is not None:
                        widget_actuel.afficher_resultat(cellule_actuelle)
                        if moteur_termine is not None:
                            self._reafficher_image_si_presente(widget_actuel, moteur_termine)

            # PATCH (demande explicite utilisateur, cf. docstring de
            # méthode) : une cellule en échec (exception non gérée dans
            # exec(), ou échec de liaison d'instance AVANT même le
            # lancement du thread, cf. BUGFIX ci-dessus) arrête désormais
            # toute la séquence "Tout exécuter" au lieu de continuer sur
            # la cellule suivante -- reste cohérent avec le comportement
            # standard d'un notebook (ex: Jupyter "Run All"), où une
            # exception interrompt l'exécution du reste des cellules.
            # Symétrique à _arreter_sequence (même remise à plat de
            # l'état de séquence + _rafraichir_bouton_global pour que le
            # bouton global ⏹ redevienne ▶ immédiatement), mais SANS
            # passer par arreter() sur le moteur -- la cellule vient déjà
            # de se terminer d'elle-même (son thread est fini, cf.
            # callback_termine), rien à détacher de force ici,
            # contrairement à un arrêt manuel en cours d'exécution.
            if not ok:
                # Les cellules encore en file (jamais démarrées) repassent
                # en ▶ normal cliquable tout de suite -- même traitement
                # que _arreter_sequence (bouton "Tout arrêter" manuel),
                # pour ne jamais laisser une cellule gelée sur son icône
                # ⏹ grisée "en attente" alors que la séquence vient en
                # réalité de s'arrêter.
                task_pour_reste = self._task_courant_obj()
                if task_pour_reste is not None:
                    for cid in self._sequence_file:
                        w = self._cellule_widgets.get(cid)
                        c = self._trouver_cellule_par_id(task_pour_reste, cid)
                        if w is not None and c is not None:
                            w.afficher_resultat(c)
                self._sequence_active = False
                self._sequence_file = None
                self._sequence_cellule_courante = None
                # AJOUT : badge global -> rouge (au moins une cellule a
                # échoué pendant cette séquence, cf. docstring plus haut).
                self._dernier_statut_sequence = "erreur"
                self._rafraichir_bouton_global()
                self._notify_status(
                    "Exécution interrompue : une cellule a échoué.", error=True,
                )
                return

            self._lancer_prochaine_cellule_sequence()

        self._executer_cellule(cellule_id, _callback_apres_sequence=_apres)

    def _arreter_sequence(self):
        """Bouton global en mode ⏹ ("Tout arrêter") -- coupe la cellule en
        cours (détachement propre, cf. MoteurExecutionCellule.arreter()),
        la marque "interrompu", et remet toutes les cellules encore en
        attente en ▶ normal immédiatement (décisions explicites
        utilisateur, cf. docstring de la section).

        BUGFIX -- désenregistre aussi ce Task du serveurT s'il tournait
        comme fournisseur Api2Api (while True: attendre_requete()) : sans
        ça, le serveurT continuait à le croire enregistré/verrouillable
        indéfiniment après ce clic, alors que le thread qui lit
        attendre_requete() vient d'être abandonné côté UI (cf. docstring
        de _desenregistrer_api2api_si_besoin). Fait AVANT le arreter() du
        moteur ci-dessous n'aurait pas d'importance particulière (les
        deux sont indépendants), mais fait ici pour rester visible au
        même endroit que la coupure de la cellule elle-même."""
        if not self._sequence_active:
            return

        cellule_courante_id = self._sequence_cellule_courante
        task = self._task_courant_obj()
        # LOG CIBLÉ (diagnostic) : trace explicitement CHAQUE appel à
        # _arreter_sequence -- seul point d'entrée qui coupe une séquence
        # "Tout exécuter" en cours -- avec la cellule sur laquelle elle
        # tombe et le reste de la file encore en attente à cet instant.
        # Permet de trancher si l'arrêt vient bien d'un clic utilisateur
        # sur "Tout arrêter" (log absent = jamais appelé, donc à chercher
        # ailleurs) et sur quelle cellule précise la séquence a été coupée.
        log_cellule.info(
            f"[_arreter_sequence] DÉCLENCHÉ -- cellule_courante={cellule_courante_id!r} "
            f"file_restante={list(self._sequence_file)!r}"
        )

        # BUGFIX 2 -- namespace propre à CE Task (self._namespaces_tasks[task.id]),
        # pas self._client_serveur_t (partagé par tous les Tasks de ce
        # TaskConfigScreen) : cf. docstring de _desenregistrer_api2api_si_besoin
        # pour la raison de ce changement de signature.
        _desenregistrer_api2api_si_besoin(
            self._namespaces_tasks.get(task.id) if task is not None else None
        )

        if cellule_courante_id is not None:
            moteur = self._moteurs_en_cours.pop(cellule_courante_id, None)
            sortie_partielle = ""
            _live_restant = self._sortie_live_buf.pop(cellule_courante_id, "") or ""   # PATCH arrêt : sortie live déjà affichée
            if moteur is not None:
                # BUGFIX (retour utilisateur : "la sortie des cellules ne
                # s'affiche pas quand j'arrête l'exécution") -- arreter()
                # RETOURNE la sortie déjà imprimée par le script jusqu'à
                # cet instant précis (cf. son docstring : "c'est le
                # dernier moment où quelqu'un peut la récupérer"), mais
                # cette valeur de retour était jusqu'ici jetée ici : rien
                # ne l'assignait jamais à cellule.sortie avant l'appel à
                # indiquer_interrompu() plus bas, qui affiche donc
                # cellule.sortie -- restée à sa valeur AVANT ce lancement
                # (vidée par _executer_toutes_cellules) ou à celle d'une
                # exécution encore plus ancienne. D'où l'impression que
                # "arrêter" n'affiche jamais rien, alors que le script
                # avait parfois déjà produit une sortie complète juste
                # avant la coupure.
                sortie_partielle = moteur.arreter()
                # PATCH (arrêt sans sortie) : repli sur le tampon live si arreter() ne rend rien (signaux live
                # encore en file, tampon moteur non posé, etc.).
                if not sortie_partielle:
                    sortie_partielle = _live_restant
                # BUGFIX (dom_paste concurrent après "Tout arrêter" -- cf.
                # SPEC vérification double-exécution, et docstring complet
                # de attendre_fin_courte) : cette cellule redevient
                # éligible à une relance dès la sortie de ce bloc (retirée
                # de self._moteurs_en_cours juste au-dessus, AVANT même cet
                # appel). Un court join() ici (150ms, imperceptible) réduit
                # la fenêtre où un nouveau lancer() sur cette même cellule
                # pourrait cohabiter avec le thread tout juste arrêté --
                # mais ne l'élimine pas : la vraie protection contre ses
                # commandes tardives reste le garde self._arrete.is_set()
                # dans _appeler()/_lier_instance_si_besoin (cf. docstrings),
                # qui s'applique quel que soit le résultat de ce join().
                moteur.attendre_fin_courte()
            if task is not None:
                # cellule_variables fait maintenant partie de la séquence
                # (cf. _executer_toutes_cellules) -- _trouver_cellule_par_id
                # la retrouve correctement, contrairement à une recherche
                # limitée à task.cellules qui la manquerait silencieusement.
                cellule = self._trouver_cellule_par_id(task, cellule_courante_id)
                if cellule is not None:
                    cellule.statut = "interrompu"
                    # BUGFIX (cf. commentaire ci-dessus) -- posé AVANT
                    # indiquer_interrompu(cellule), qui lit cellule.sortie
                    # pour l'affichage (cf. TaskCelluleWidget.afficher_
                    # resultat). Seulement si non vide : une cellule
                    # arrêtée AVANT d'avoir rien imprimé (ex. encore en
                    # train de lier ses instances, cf. docstring d'arreter())
                    # garde alors sa sortie déjà à "" (vidée par
                    # _executer_toutes_cellules) plutôt que d'écraser un
                    # champ qui n'a de toute façon rien de nouveau à montrer.
                    if not sortie_partielle:
                        sortie_partielle = _live_restant
                    if sortie_partielle:
                        cellule.sortie = sortie_partielle
                    self.project.save()
                    widget = self._cellule_widgets.get(cellule_courante_id)
                    if widget is not None:
                        widget.indiquer_interrompu(cellule)

        # Toutes les cellules encore en file (jamais démarrées) repassent
        # en ▶ normal cliquable tout de suite -- pas d'état gelé après
        # coupure (décision explicite utilisateur).
        file_restante = self._sequence_file or []
        if task is not None:
            for cid in file_restante:
                widget = self._cellule_widgets.get(cid)
                cellule = self._trouver_cellule_par_id(task, cid)
                if widget is not None and cellule is not None:
                    widget.afficher_resultat(cellule)

        self._sequence_active = False
        self._sequence_file = None
        self._sequence_cellule_courante = None
        # AJOUT : le badge global reflète cette interruption (jaune) --
        # posé AVANT _rafraichir_bouton_global juste en dessous, qui lit
        # cette valeur pour peindre le badge (cf.
        # _rafraichir_badge_statut_notebook).
        self._dernier_statut_sequence = "interrompu"
        self._rafraichir_bouton_global()
        self._notify_status("Séquence arrêtée.", error=True)

    def _rafraichir_bouton_global(self):
        """Met à jour l'icône/tooltip/état du bouton global "Tout
        exécuter"/"Tout arrêter" selon l'état courant -- appelée après
        chaque transition (démarrage/fin de séquence, démarrage/fin d'une
        exécution individuelle).

        SPEC_profils_environnements.md section 6.2 : si un profil est
        actif, icône/tooltip/enabled reflètent profil_etat.statut de CE
        profil (même mapping que le bouton individuel de ligne, section
        4.5) plutôt que self._sequence_active/self._moteurs_en_cours (run
        "sans profil"). Comportement actuel inchangé si aucun profil
        actif."""
        if not hasattr(self, "bouton_executer_tout"):
            log_cellule.debug(
                "[BADGE-TRACE][_rafraichir_bouton_global] ABANDON PRÉCOCE -- "
                "self n'a pas encore d'attribut bouton_executer_tout (UI pas encore construite)"
            )
            return
        task = self._task_courant_obj()
        etat = self._executions_clone.get(task.id) if task is not None else None
        profil_actif = etat.profil_actif if etat is not None else None
        profil_etat = etat.profils.get(profil_actif) if (etat is not None and profil_actif) else None
        log_cellule.debug(
            f"[BADGE-TRACE][_rafraichir_bouton_global] ENTRÉE -- "
            f"self._task_courant(id brut affiché)={getattr(self, '_task_courant', 'ATTR_ABSENT')!r} "
            f"task_resolu={(task.id if task is not None else None)!r} "
            f"etat_trouvé={etat is not None} etat_id={id(etat) if etat is not None else None} "
            f"profil_actif={profil_actif!r} "
            f"profil_etat_trouvé={profil_etat is not None} "
            f"profil_etat.statut={(profil_etat.statut if profil_etat is not None else None)!r} "
            f"self._sequence_active={getattr(self, '_sequence_active', 'ATTR_ABSENT')!r} "
            f"self._moteurs_en_cours={bool(getattr(self, '_moteurs_en_cours', None))!r}"
        )

        if profil_actif and profil_etat is not None:
            # BUGFIX (audit clé composite) : profil_actif (etat.profil_
            # actif) est une CLÉ COMPOSITE -- extraction du nom nu pour
            # les tooltips affichés à l'utilisateur ci-dessous, jamais la
            # clé technique brute.
            nom_profil_actif_affiche = _nom_depuis_cle_profil_clone(profil_actif)
            en_cours = profil_etat.statut in ("en_attente", "en_cours")
            if en_cours:
                self.bouton_executer_tout.setIcon(self._icone_global_stop)
                self.bouton_executer_tout.setEnabled(True)
                self.bouton_executer_tout.setToolTip(f"Arrêter « {nom_profil_actif_affiche} »")
                log_cellule.debug(
                    f"[BADGE-TRACE][_rafraichir_bouton_global] BRANCHE=profil_actif+en_cours -- "
                    f"bouton='Arrêter « {nom_profil_actif_affiche} »' (statut={profil_etat.statut!r})"
                )
            else:
                self.bouton_executer_tout.setIcon(self._icone_global_jouer)
                self.bouton_executer_tout.setEnabled(True)
                self.bouton_executer_tout.setToolTip(f"Lancer « {nom_profil_actif_affiche} »")
                log_cellule.debug(
                    f"[BADGE-TRACE][_rafraichir_bouton_global] BRANCHE=profil_actif+PAS_en_cours -- "
                    f"bouton='Lancer « {nom_profil_actif_affiche} »' (statut={profil_etat.statut!r})"
                )
        elif self._sequence_active:
            self.bouton_executer_tout.setIcon(self._icone_global_stop)
            self.bouton_executer_tout.setEnabled(True)
            self.bouton_executer_tout.setToolTip("Tout arrêter")
            log_cellule.debug(
                f"[BADGE-TRACE][_rafraichir_bouton_global] BRANCHE=sequence_active -- "
                f"(profil_actif={profil_actif!r} profil_etat_trouvé={profil_etat is not None})"
            )
        elif self._moteurs_en_cours:
            # Une cellule tourne individuellement (hors séquence) --
            # bouton global désactivé (décision explicite utilisateur).
            self.bouton_executer_tout.setIcon(self._icone_global_jouer)
            self.bouton_executer_tout.setEnabled(False)
            self.bouton_executer_tout.setToolTip(
                "Indisponible pendant qu'une cellule s'exécute individuellement"
            )
            log_cellule.debug(
                f"[BADGE-TRACE][_rafraichir_bouton_global] BRANCHE=moteurs_en_cours_hors_sequence -- "
                f"(profil_actif={profil_actif!r} profil_etat_trouvé={profil_etat is not None})"
            )
        else:
            self.bouton_executer_tout.setIcon(self._icone_global_jouer)
            self.bouton_executer_tout.setEnabled(True)
            self.bouton_executer_tout.setToolTip("Tout exécuter")
            log_cellule.debug(
                f"[BADGE-TRACE][_rafraichir_bouton_global] BRANCHE=repos_total -- "
                f"(profil_actif={profil_actif!r} profil_etat_trouvé={profil_etat is not None})"
            )

        # "Vider toutes les cellules" grisé pendant toute exécution (cf.
        # _vider_toutes_cellules) -- séquence globale OU cellule isolée.
        if hasattr(self, "bouton_vider_toutes"):
            occupe = self._sequence_active or bool(self._moteurs_en_cours)
            self.bouton_vider_toutes.setEnabled(not occupe)
            self.bouton_vider_toutes.setToolTip(
                "Impossible pendant une exécution en cours" if occupe
                else "Vider la sortie de toutes les cellules"
            )

        # AJOUT : badge de statut global + bouton "aller à l'erreur" --
        # recalculés après CHAQUE transition d'exécution, exactement au
        # même rythme que le bouton "Tout exécuter" ci-dessus (cette
        # méthode est déjà le point d'orchestration central appelé après
        # chaque fin/début d'exécution individuelle ou de séquence).
        log_cellule.debug(
            "[BADGE-TRACE][_rafraichir_bouton_global] AVANT appel _rafraichir_badge_statut_notebook()"
        )
        self._rafraichir_badge_statut_notebook()
        log_cellule.debug(
            "[BADGE-TRACE][_rafraichir_bouton_global] SORTIE (après _rafraichir_badge_statut_notebook())"
        )

    def _toutes_les_cellules_du_task(self, task: "Task") -> list:
        """Liste TOUTES les TaskCellule d'un Task, dans l'ordre du
        notebook -- cellule "Main" et "Variable dynamique"
        (row 0, hors zone scrollable) D'ABORD puisqu'elles sont du code
        exécutable comme les autres (cf. TaskCellule.statut), puis
        task.cellules[1:] dans l'ordre d'affichage. Point d'entrée unique
        pour tout calcul agrégeant l'état de TOUTES les cellules d'un
        Task (cf. _rafraichir_badge_statut_notebook, _aller_prochaine_erreur,
        _effacer_tous_surlignages_erreur) -- évite de dupliquer trois fois
        la même logique "task.cellules[0] + cellule_variables + le
        reste"."""
        cellules = []
        if task.cellules:
            cellules.append(task.cellules[0])
        if task.cellule_variables is not None:
            cellules.append(task.cellule_variables)
        cellules.extend(task.cellules[1:])
        return cellules

    def _rafraichir_badge_statut_notebook(self):
        """Recalcule l'affichage du badge de statut global (cf.
        self.badge_statut_notebook, BadgeStatutNotebook) et la visibilité
        du bouton "aller à l'erreur" (cf. self.bouton_aller_erreur).

        Les deux indicateurs suivent des logiques VOLONTAIREMENT
        différentes (décisions explicites utilisateur, précisées au fil
        de la conversation) :
          - Le BADGE reflète uniquement la DERNIÈRE séquence "Tout
            exécuter" (self._dernier_statut_sequence / self._sequence_active)
            -- un clic ▶ isolé sur une seule cellule NE LE TOUCHE JAMAIS.
            SPEC_profils_environnements.md section 6.3 : si un profil est
            actif, reflète plutôt SON statut (profil_etat.statut), même
            mapping couleur que _construire_widget_actions_profil/
            _couleur_statut du panneau de profils (section 4.5).
          - Le BOUTON "aller à l'erreur", lui, reste basé sur l'état RÉEL
            de chaque TaskCellule (statut=="erreur"), qu'elle vienne d'un
            ▶ isolé ou d'une séquence -- l'utilisateur veut pouvoir
            naviguer vers N'IMPORTE QUELLE cellule en erreur affichée à
            l'écran, pas seulement celles d'une séquence globale."""
        if not hasattr(self, "badge_statut_notebook"):
            log_cellule.debug(
                "[BADGE-TRACE][_rafraichir_badge_statut_notebook] ABANDON PRÉCOCE -- "
                "self n'a pas encore d'attribut badge_statut_notebook"
            )
            return

        task = self._task_courant_obj()
        etat = self._executions_clone.get(task.id) if task is not None else None
        profil_actif = etat.profil_actif if etat is not None else None
        profil_etat = etat.profils.get(profil_actif) if (etat is not None and profil_actif) else None
        log_cellule.debug(
            f"[BADGE-TRACE][_rafraichir_badge_statut_notebook] ENTRÉE -- "
            f"self._task_courant(id brut affiché)={getattr(self, '_task_courant', 'ATTR_ABSENT')!r} "
            f"task_resolu={(task.id if task is not None else None)!r} "
            f"etat_id={id(etat) if etat is not None else None} "
            f"profil_actif={profil_actif!r} "
            f"profil_etat_trouvé={profil_etat is not None} "
            f"profil_etat.statut={(profil_etat.statut if profil_etat is not None else None)!r} "
            f"self._sequence_active={getattr(self, '_sequence_active', 'ATTR_ABSENT')!r} "
            f"self._dernier_statut_sequence={getattr(self, '_dernier_statut_sequence', 'ATTR_ABSENT')!r}"
        )

        # --- Badge : AGRÉGAT de tous les profils clone cochés (mode clone),
        # sinon séquence globale classique ---
        # BUGFIX (demande explicite utilisateur : "si je ne l'affiche pas
        # je ne dois pas savoir qu'il est quand même terminé ?") -- le
        # badge ne reflétait QUE le profil actuellement sélectionné
        # (profil_actif). Un profil qui terminait pendant qu'un AUTRE
        # profil était affiché ne se voyait donc jamais sur le badge,
        # même après le fix de propagation ci-dessus dans
        # _rafraichir_apres_transition_clone -- il fallait cliquer sur
        # CHAQUE ligne pour connaître son état. Remplacé par un compte
        # agrégé sur TOUS les profils cochés de etat.profils, quel que
        # soit profil_actif -- même liste que _verifier_fin_sequence_clone
        # (p.coche), pour rester cohérent avec ce qui détermine la fin de
        # séquence globale.
        profils_coches = (
            [p for p in etat.profils.values() if p.coche] if etat is not None else []
        )
        log_cellule.debug(
            f"[BADGE-TRACE][_rafraichir_badge_statut_notebook] AGRÉGAT -- "
            f"etat_trouvé={etat is not None} nb_profils_coches={len(profils_coches)} "
            f"statuts={[p.statut for p in profils_coches]!r}"
        )
        # DEMANDE UTILISATEUR : à chaque rafraîchissement du badge, dumper
        # dans les logs -- TOUJOURS pour les 10 profils cochés en même
        # temps, jamais seulement le profil affiché -- le statut ET la
        # sortie de leur DERNIÈRE cellule exécutée, avec détection
        # d'incohérence (ex. statut="succes" mais la sortie contient un
        # marqueur d'échec du type "failed"/"echec"/"erreur") pour repérer
        # d'un coup d'œil un décalage entre ce que dit le statut et ce que
        # la sortie réelle rapporte.
        if profils_coches:
            marqueurs_echec = ("failed", "échec", "echec", "erreur", "error")
            for p in profils_coches:
                if p.cellules_resultats:
                    derniere_cellule = max(
                        p.cellules_resultats.values(),
                        key=lambda c: (c.numero_execution or 0),
                    )
                    sortie_brute = derniere_cellule.sortie or ""
                else:
                    sortie_brute = ""
                sortie_normalisee = sortie_brute.strip().replace("\n", " | ")
                incoherent = (
                    p.statut == "succes"
                    and any(m in sortie_brute.lower() for m in marqueurs_echec)
                )
                log_cellule.debug(
                    f"[BADGE-TRACE][_rafraichir_badge_statut_notebook] "
                    f"DETAIL_PROFIL -- profil={p.nom_profil!r} statut={p.statut!r} "
                    f"sortie_derniere_cellule={sortie_normalisee!r} "
                    f"INCOHERENCE={'OUI -- statut succes mais sortie contient un marqueur d’échec' if incoherent else 'non'}"
                )
        if profils_coches:
            nb_total = len(profils_coches)
            nb_en_cours = sum(1 for p in profils_coches if p.statut in ("en_attente", "en_cours"))
            nb_erreur = sum(1 for p in profils_coches if p.statut == "erreur")
            # SUPPRIMÉ (SPEC_lot_corrections_2026-09.md section 2) :
            # nb_deconnecte -- ce statut n'existe plus, un profil dont le
            # sAutoniax disparaît est retiré directement de la liste
            # (cf. _invalider_executions_clone_disparues), donc il ne
            # peut plus jamais apparaître ici parmi profils_coches.
            nb_succes = sum(1 for p in profils_coches if p.statut == "succes")
            nb_arrete = sum(1 for p in profils_coches if p.statut == "arrete")
            nb_termines = nb_erreur + nb_succes + nb_arrete

            if nb_en_cours > 0:
                self.badge_statut_notebook.definir_en_cours(
                    f"Clones : {nb_termines}/{nb_total} terminé(s)..."
                )
                log_cellule.debug(
                    f"[BADGE-TRACE][_rafraichir_badge_statut_notebook] PEINT=agregat_en_cours -- "
                    f"{nb_termines}/{nb_total} terminé(s), {nb_en_cours} encore en cours"
                )
            elif nb_erreur > 0:
                self.badge_statut_notebook.definir_statut(
                    DarculaTheme.rouge, f"Clones : {nb_erreur}/{nb_total} en échec"
                )
                log_cellule.debug(
                    f"[BADGE-TRACE][_rafraichir_badge_statut_notebook] PEINT=agregat_erreur -- "
                    f"{nb_erreur}/{nb_total} en échec (succes={nb_succes} arrete={nb_arrete})"
                )
            elif nb_arrete > 0 and nb_succes == 0:
                self.badge_statut_notebook.definir_statut(
                    Mocha.peach, f"Clones : {nb_arrete}/{nb_total} arrêté(s)"
                )
                log_cellule.debug(
                    f"[BADGE-TRACE][_rafraichir_badge_statut_notebook] PEINT=agregat_arrete -- "
                    f"{nb_arrete}/{nb_total} arrêté(s)"
                )
            elif nb_succes == nb_total:
                self.badge_statut_notebook.definir_statut(
                    Mocha.green, f"Clones : {nb_total}/{nb_total} terminés avec succès"
                )
                log_cellule.debug(
                    f"[BADGE-TRACE][_rafraichir_badge_statut_notebook] PEINT=agregat_succes_total -- "
                    f"{nb_total}/{nb_total} succès"
                )
            elif nb_termines > 0:
                # Mélange succès + arrêtés, aucune erreur ni déconnexion.
                self.badge_statut_notebook.definir_statut(
                    Mocha.green, f"Clones : {nb_succes}/{nb_total} succès, {nb_arrete} arrêté(s)"
                )
                log_cellule.debug(
                    f"[BADGE-TRACE][_rafraichir_badge_statut_notebook] PEINT=agregat_mixte -- "
                    f"succes={nb_succes} arrete={nb_arrete} sur {nb_total}"
                )
            else:
                # Aucun profil n'a encore démarré (tous "inactif"/valeur
                # par défaut) -- équivalent au fallback neutre ci-dessous.
                self.badge_statut_notebook.definir_statut(
                    Mocha.subtext0, "Aucune exécution globale pour l'instant"
                )
                log_cellule.debug(
                    "[BADGE-TRACE][_rafraichir_badge_statut_notebook] PEINT=agregat_aucun_demarre"
                )
        elif self._sequence_active:
            self.badge_statut_notebook.definir_en_cours()
            log_cellule.debug(
                "[BADGE-TRACE][_rafraichir_badge_statut_notebook] PEINT=sequence_active (générique, sans nom de profil)"
            )
        elif self._dernier_statut_sequence == "erreur":
            self.badge_statut_notebook.definir_statut(
                DarculaTheme.rouge, "Dernière exécution globale : échec"
            )
            log_cellule.debug(
                "[BADGE-TRACE][_rafraichir_badge_statut_notebook] PEINT=dernier_statut_sequence=erreur "
                "(sans profil actif)"
            )
        elif self._dernier_statut_sequence == "interrompu":
            self.badge_statut_notebook.definir_statut(
                Mocha.peach, "Dernière exécution globale : interrompue"
            )
            log_cellule.debug(
                "[BADGE-TRACE][_rafraichir_badge_statut_notebook] PEINT=dernier_statut_sequence=interrompu "
                "(sans profil actif)"
            )
        elif self._dernier_statut_sequence == "succes":
            self.badge_statut_notebook.definir_statut(
                Mocha.green, "Dernière exécution globale : succès"
            )
            log_cellule.debug(
                "[BADGE-TRACE][_rafraichir_badge_statut_notebook] PEINT=dernier_statut_sequence=succes "
                "(sans profil actif)"
            )
        else:
            self.badge_statut_notebook.definir_statut(
                Mocha.subtext0, "Aucune exécution globale pour l'instant"
            )
            log_cellule.debug(
                f"[BADGE-TRACE][_rafraichir_badge_statut_notebook] PEINT=fallback_aucune_execution -- "
                f"profil_actif={profil_actif!r} profil_etat_trouvé={profil_etat is not None} "
                f"self._sequence_active={getattr(self, '_sequence_active', 'ATTR_ABSENT')!r} "
                f"self._dernier_statut_sequence={getattr(self, '_dernier_statut_sequence', 'ATTR_ABSENT')!r} "
                f"-- SI profil_actif N'EST PAS None ICI ET profil_etat_trouvé=False, "
                f"C'EST LE SIGNE QUE etat.profils NE CONTIENT PAS CE PROFIL"
            )

        # --- PATCH -- point_statut_execution du panneau de rendu réseau
        # flottant (cf. FenetreRenduTaskReseau.definir_statut_derniere_
        # execution) : EXACTEMENT la même donnée/palette que le badge
        # juste au-dessus, jamais dupliquée séparément -- demande
        # explicite utilisateur : "vite se rendre compte si lexecution a
        # echouer" en gardant l'œil sur le panneau flottant plutôt que
        # sur la barre de boutons principale (souvent hors champ visuel
        # une fois le panneau détaché). N'existe QUE si le panneau a déjà
        # été ouvert au moins une fois (cf. _fenetre_rendu_reseau, None
        # par défaut) -- pas d'ouverture forcée ici, ce point ne fait que
        # suivre le panneau s'il est déjà là.
        if self._fenetre_rendu_reseau is not None:
            if self._dernier_statut_sequence == "erreur":
                self._fenetre_rendu_reseau.definir_statut_derniere_execution(
                    DarculaTheme.rouge, "Dernière exécution globale : échec"
                )
            elif self._dernier_statut_sequence == "interrompu":
                self._fenetre_rendu_reseau.definir_statut_derniere_execution(
                    Mocha.peach, "Dernière exécution globale : interrompue"
                )
            elif self._dernier_statut_sequence == "succes":
                self._fenetre_rendu_reseau.definir_statut_derniere_execution(
                    Mocha.green, "Dernière exécution globale : succès"
                )
            else:
                self._fenetre_rendu_reseau.definir_statut_derniere_execution(
                    Mocha.subtext0, "Aucune exécution globale pour l'instant"
                )

        # --- Bouton "aller à l'erreur" : basé sur les cellules réellement
        # en erreur, indépendamment de la provenance (▶ isolé ou séquence)
        # -- décision explicite utilisateur : "visible seulement si j'ai
        # au moins une erreur", sans restriction à une séquence globale.
        task = self._task_courant_obj()
        cellules = self._toutes_les_cellules_du_task(task) if task is not None else []
        au_moins_une_en_erreur = any(c.statut == "erreur" for c in cellules)
        self.bouton_aller_erreur.setVisible(au_moins_une_en_erreur)
        if not au_moins_une_en_erreur:
            self._derniere_cellule_erreur_visitee = None

    def _aller_prochaine_erreur(self):
        """Clic gauche sur bouton_aller_erreur -- scrolle (SANS déplacer
        le focus/curseur, décision explicite utilisateur) vers la
        PROCHAINE cellule en erreur, dans l'ordre du notebook (haut →
        bas), en boucle après la dernière. Reprend juste après
        self._derniere_cellule_erreur_visitee si elle est encore en
        erreur, sinon repart du début -- pour qu'un clic répété fasse
        avancer d'une erreur à l'autre plutôt que de toujours revenir à
        la première."""
        task = self._task_courant_obj()
        if task is None:
            return
        cellules_en_erreur = [
            c for c in self._toutes_les_cellules_du_task(task) if c.statut == "erreur"
        ]
        if not cellules_en_erreur:
            return

        ids_en_erreur = [c.id for c in cellules_en_erreur]
        if self._derniere_cellule_erreur_visitee in ids_en_erreur:
            index_suivant = (
                ids_en_erreur.index(self._derniere_cellule_erreur_visitee) + 1
            ) % len(ids_en_erreur)
        else:
            index_suivant = 0
        cellule_cible = cellules_en_erreur[index_suivant]
        self._derniere_cellule_erreur_visitee = cellule_cible.id

        self._assurer_cellule_montee(cellule_cible.id)   # PATCH (étape 3)
        widget = self._cellule_widgets.get(cellule_cible.id)
        if widget is None:
            return
        # La cellule "Variable dynamique" (row 0), quand sticky, vit HORS
        # du QScrollArea (cf. docstring self.cellule_statique_container
        # plus haut) -- toujours visible, rien à scroller pour elle dans
        # ce cas (cf. _widget_est_descendant, même garde déjà utilisée par
        # l'accès rapide existant). "Main" (task.cellules[0]), elle, vit
        # désormais TOUJOURS dans le notebook scrollable comme une cellule
        # normale (MAJ décision utilisateur), donc toujours scrollée ici.
        if self._widget_est_descendant(widget, self.notebook_contenu):
            self.notebook_scroll.ensureWidgetVisible(widget, 0, 80)
        self._surligner_cellule(widget)

    def _effacer_tous_surlignages_erreur(self):
        """Clic droit sur bouton_aller_erreur (décision explicite
        utilisateur : "clic droit pour clear") -- efface le surlignage
        rouge de ligne (cf. TaskScriptEditor.effacer_surlignage_erreur)
        dans TOUS les éditeurs du Task ouvert, sans toucher au statut/
        sortie des cellules elles-mêmes (une cellule reste affichée comme
        "erreur", seul le surlignage de LIGNE dans l'éditeur disparaît --
        cohérent avec le fait que ce bouton est un raccourci de confort
        visuel, pas une réinterprétation du résultat d'exécution)."""
        for editeur in self._tous_les_editeurs_du_task():
            editeur.effacer_surlignage_erreur()
        self._derniere_cellule_erreur_visitee = None
        self.bouton_aller_erreur.hide()

    def _vider_toutes_cellules(self):
        """Bouton global "Vider toutes les cellules" -- même effet que
        l'icône gomme par cellule (_vider_cellule), appliqué en masse.
        Refusé en bloc (un seul message clair) si une séquence "Tout
        exécuter" est en cours ou qu'une cellule tourne individuellement
        -- plutôt que de vider silencieusement une partie des cellules et
        déclencher une notification d'erreur par cellule bloquée."""
        task = self._task_courant_obj()
        if task is None:
            return
        if self._sequence_active or self._moteurs_en_cours:
            self._notify_status(
                "Impossible de vider les cellules pendant une exécution en cours.", error=True,
            )
            return
        for cellule in list(task.cellules):
            self._vider_cellule(cellule.id)
        if task.cellule_variables is not None:
            self._vider_cellule(task.cellule_variables.id)
        self._notify_status("Toutes les cellules ont été vidées.")

    def _sur_demande_copier_logs_execution_clone(self):
        """Handler du bouton "Copier les logs de cette exécution" du
        panneau clone (cf. PanneauExecutionClone.demande_copier_logs_
        execution_clone) -- même patron d'accès à l'état que
        _sur_demande_capturer_tout ci-dessus (task courant puis
        ExecutionCloneEtat correspondant). Se contente de résoudre les
        deux horodatages du LOT (pas d'un profil individuel, cf.
        docstring de ExecutionCloneEtat.horodatage_lancement_lot) et de
        déléguer tout le travail réseau/agrégation à MainWindow.
        lancer_copie_logs_execution_clone (cf. sa docstring), exactement
        comme demande_capturer_tout délègue à ClientServeurT plus haut --
        ce panneau ne connaît ni ClientServeurT ni le presse-papier
        directement (cf. docstring de classe de PanneauExecutionClone).

        Refuse silencieusement (juste un message de statut) si aucun lot
        n'a jamais été lancé pour ce Task (horodatage_lancement_lot
        encore None) -- rien à copier, le bouton ne devrait normalement
        pas être cliquable dans cet état (cf. PanneauExecutionClone,
        activé seulement dès qu'un horodatage_lancement_lot existe)."""
        task = self._task_courant_obj()
        if task is None:
            return
        etat = self._executions_clone.get(task.id)
        if etat is None or etat.horodatage_lancement_lot is None:
            self._notify_status(
                "Aucune exécution de clone n'a encore été lancée pour ce Task.", error=True,
            )
            return
        fenetre = self.window()
        if not hasattr(fenetre, "lancer_copie_logs_execution_clone"):
            return
        # BUGFIX (REFONTE MULTI-SAUTONIAX) -- ExecutionCloneEtat.
        # id_executant_sautoniax (ancien champ singleton, un seul
        # sAutoniax pour tout le lot) a été retiré de la classe (cf. sa
        # docstring) : cet appel plantait avec un AttributeError à
        # chaque clic sur "Copier les logs de cette exécution", puisque
        # MainWindow.lancer_copie_logs_execution_clone attend désormais
        # ids_executant_sautoniax: list (cf. sa docstring). Reconstruit
        # ici la liste DÉDUPLIQUÉE des sAutoniax représentés dans ce lot
        # -- même repli à deux niveaux que _sur_demande_capturer_tout
        # ci-dessus (id_executant_sautoniax figé si le profil a déjà été
        # lancé au moins une fois, sinon _id_executant_par_profil_clone
        # pour un profil jamais lancé mais dont le sAutoniax d'origine
        # est connu) -- puis filtre les profils dont le sAutoniax reste
        # malgré tout inconnu (ex. profil jamais vu dans aucune liste
        # rafraîchie) plutôt que de planter ou d'envoyer une chaîne vide
        # au serveur.
        ids_executant_sautoniax = sorted({
            id_executant
            for id_executant in (
                p.id_executant_sautoniax or self._id_executant_par_profil_clone.get(nom, "")
                for nom, p in etat.profils.items()
            )
            if id_executant
        })
        fenetre.lancer_copie_logs_execution_clone(
            ids_executant_sautoniax, etat.horodatage_lancement_lot, etat.horodatage_fin_lot,
        )

    def _sur_demande_vider_sorties_clones(self):
        """Handler du bouton "Vider les sorties" du panneau clone (AJOUT,
        demande explicite utilisateur : "je veux que tu ajoute un bouton
        qui vas permetre de vider toute les sortie de clone quelque part
        ici") -- vide CloneProfilEtat.cellules_resultats pour TOUS les
        profils de ce Task d'un coup, sans passer par _vider_cellule (donc
        SANS toucher task.cellules/le notebook réel, et sans dépendre de
        l'état _moteurs_en_cours/_sequence_active qui ne concerne que le
        notebook réel -- une exécution locale en cours ne doit pas
        bloquer ce vidage, purement côté clone).

        ÉLARGI (retour utilisateur explicite : "modifie une fois plutot
        juste pour vider les sortie, ainsi sa vas aussi reinitialiser une
        fois, pas besoin de creer un autre bouton") -- ce même bouton
        remet maintenant TOUT le panneau à un état vierge en un clic
        plutôt que de se limiter à cellules_resultats : le statut affiché
        (colonne Statut -- "Succès"/"Échec"/etc. -- revient à "inactif",
        l'état neutre d'un profil qui n'a encore jamais été lancé), le
        badge/pastille de couleur (result_color, section 11, revient au
        blanc neutre #FFFFFF), la cellule en cours et les horodatages
        Début/Fin repartent à zéro. Reste volontairement INCHANGÉ :
        `coche` (la sélection de l'utilisateur dans le panneau ne doit
        pas être perturbée par un simple nettoyage visuel), `instance_id`/
        `id_executant_sautoniax` (identité réseau du profil, sans rapport
        avec l'historique d'exécution qu'on efface ici), et
        `moteur_courant` (déjà protégé par la garde sequence_en_cours
        juste en dessous -- aucun moteur ne devrait être actif à ce
        stade, mais on ne touche pas à la référence par prudence).

        Refusé si une séquence clone est actuellement en cours
        (etat.sequence_en_cours) -- même principe que _vider_toutes_
        cellules côté local : un résultat sur le point d'être écrit par un
        moteur clone encore actif ne doit pas être effacé sous ses pieds."""
        task = self._task_courant_obj()
        if task is None:
            return
        etat_clone = self._executions_clone.get(task.id)
        if etat_clone is None or not etat_clone.profils:
            self._notify_status("Aucune sortie de clone à vider.")
            return
        if etat_clone.sequence_en_cours:
            self._notify_status(
                "Impossible de vider les sorties de clone pendant qu'une séquence est en cours.", error=True,
            )
            return
        for profil_etat in etat_clone.profils.values():
            profil_etat.cellules_resultats = {}
            # AJOUT (réinitialisation complète, cf. docstring ci-dessus) :
            # remet le statut/badge/horodatages à leur valeur neutre
            # d'origine (celle posée à la création d'un CloneProfilEtat,
            # AVANT tout lancement) -- même valeurs de repli que la
            # dataclass elle-même, pour rester cohérent si ses défauts
            # changent un jour.
            profil_etat.statut = "inactif"
            profil_etat.cellule_courante_id = None
            profil_etat.derniere_image_b64 = None
            profil_etat.horodatage_debut = None
            profil_etat.horodatage_fin = None
            profil_etat.result_color = COULEUR_RESULT_COLOR_DEFAUT
        # Le profil actif réaffiche ses cellules_resultats connus par-
        # dessus les widgets du notebook (cf. _definir_profil_actif) --
        # maintenant vides, donc chaque widget doit revenir à un affichage
        # "aucun résultat" plutôt que de garder l'ancien HTML affiché
        # jusqu'au prochain changement de profil fortuit.
        if etat_clone.profil_actif:
            for cellule in list(task.cellules) + (
                [task.cellule_variables] if task.cellule_variables is not None else []
            ):
                widget = self._cellule_widgets.get(cellule.id)
                if widget is not None:
                    widget.afficher_resultat(cellule)
        # CORRECTIF (spec D.3, "terminal ne se vide pas au clic sur la
        # gomme") -- cette fonction vidait déjà cellules_resultats et les
        # widgets du notebook réel ci-dessus, mais ne touchait jamais
        # self._fenetre_rendu_reseau.panneau.terminal_sortie (le QTextEdit
        # alimenté au fil de l'eau par ajouter_ligne_terminal, cf. sur_
        # log_execution_reseau_recu) : si le panneau de rendu réseau est
        # ouvert, son terminal continuait donc d'afficher les anciennes
        # lignes après un clic sur la gomme. No-op silencieux si ce
        # panneau n'a jamais été ouvert -- cohérent avec la garde
        # etat_clone.profil_actif juste au-dessus.
        if self._fenetre_rendu_reseau is not None:
            self._fenetre_rendu_reseau.panneau.terminal_sortie.clear()
        self._rafraichir_panneau_clone_si_ouvert(task, etat_clone)
        self._notify_status("Le panneau de clones a été réinitialisé (sorties, statuts et badges).")

    def _sur_demande_forcer_sortie_clones(self):
        """PATCH : réactive la sortie de logs (set_sortie_logs coupee=False) des clones COCHÉS qui tournent,
        via le canal commande_instance, sans arrêter ni relancer quoi que ce soit."""
        task = self._task_courant_obj()
        etat_clone = self._executions_clone.get(task.id) if task is not None else None
        if etat_clone is None or not etat_clone.profils:
            self._notify_status("Aucun clone à traiter.", error=True)
            return
        client = getattr(self, "_client_serveur_t", None)
        envoyes = 0
        for cle_profil, profil_etat in etat_clone.profils.items():
            en_cours = profil_etat.statut == "en_cours" or getattr(profil_etat, "moteur_courant", None) is not None
            if not (profil_etat.coche and en_cours and profil_etat.instance_id):
                continue
            id_executant = profil_etat.id_executant_sautoniax or self._id_executant_par_profil_clone.get(cle_profil, "")
            if not id_executant or client is None:
                continue
            client.envoyer_commande_instance(
                id_executant, profil_etat.instance_id, uuid.uuid4().hex[:12],
                {"action": "set_sortie_logs", "coupee": False},
            )
            _INSTANCES_LOGS_ACTIVES_PILOTE.add(profil_etat.instance_id)
            envoyes += 1
        if envoyes == 0:
            self._notify_status("Aucun clone coché en cours d'exécution à forcer.", error=True)
            return
        self._notify_status(f"Sortie forcée pour {envoyes} clone(s) en cours d'exécution.")

    def _sur_demande_copier_logs_par_profil(self):
        """Handler du bouton "Copier les sorties par profil" du panneau
        clone (AJOUT, demande explicite utilisateur : "un bouton en bas
        du panneau, sa vas copier les sorties de tout les profils sur
        forme de logs, donc noms du sautoniax, noms du profils, log
        renvoyer" -- précisé ensuite : "je dit sortie des cellule, pas
        logs journaux des sautoniax") -- cf. docstring de
        PanneauExecutionClone.demande_copier_logs_par_profil pour la
        distinction avec _sur_demande_copier_logs_execution_clone
        (celui-là : journaux SYSTÈME serveur/mAutoniax/sAutoniax, requête
        réseau asynchrone ; celui-ci : SORTIE DE CODE de chaque profil,
        déjà connue localement dans CloneProfilEtat.cellules_resultats,
        copie synchrone immédiate, même patron que _sur_clic_copier_
        toutes_cellules pour le notebook réel -- cf. sa docstring).

        Une SECTION par profil, triée avec la MÊME clé à deux niveaux que
        l'affichage du tableau (cf. PanneauExecutionClone._reconstruire_
        table_completement -- sAutoniax d'abord, numériquement, puis nom
        de profil, numériquement) pour que l'ordre du texte copié
        corresponde à l'ordre déjà visible à l'écran. À l'intérieur de
        chaque section, les cellules apparaissent dans l'ordre du
        notebook (cellule_variables, puis task.cellules dans l'ordre),
        PAS dans l'ordre d'arrivée réseau (dict cellules_resultats,
        keyé par cellule_id, ordre non garanti) -- même souci déjà
        rencontré et corrigé pour le tri des LIGNES du tableau (cf.
        docstring de _cle_tri_ligne_profil), appliqué ici à l'ordre des
        CELLULES dans une même section. Un profil sans aucun résultat
        connu (cellules_resultats vide) est simplement omis -- pas de
        section vide.

        BUG RÉSIDUEL INVESTIGUÉ (SPEC_lot_corrections_2026-09.md section
        4, "les profils cochés qui n'apparaissaient pas dans la copie
        affichaient pourtant une sortie visible à l'écran au moment du
        clic") -- CAUSE RACINE IDENTIFIÉE, PAS un problème de clé
        composite ni de mauvais task.id : _sur_demande_lancer_clones et
        _sur_demande_lancer_clone_profil réinitialisent tous deux
        profil_etat.cellules_resultats = {} DÈS le lancement/relancement
        d'un profil (cf. leurs propres commentaires), AVANT même que la
        première cellule n'ait produit un résultat. Un profil déjà en
        "Succès" (sortie encore peinte à l'écran par le dernier repaint
        du tableau) puis RELANCÉ dans un nouveau lot voit donc son
        cellules_resultats vidé immédiatement -- s'il est encore
        "en_attente"/"en_cours" au moment du clic sur ce bouton (avant
        que la première cellule du nouveau lot n'ait fini), il est
        omis ici (cellules_resultats vide) alors que l'ancienne sortie
        reste visible à l'écran jusqu'au prochain repaint du widget de
        cellule. Ce n'est PAS un bug de copie à proprement parler : le
        comportement de vidage au relancement est voulu (éviter de
        mélanger l'ancienne et la nouvelle sortie), mais il crée une
        fenêtre où affichage-écran et donnée-source divergent. Aucun
        correctif de fond appliqué ici (changer ce comportement de
        vidage sortirait du périmètre de cette demande) -- documenté
        pour référence si le symptôme est de nouveau rapporté."""
        task = self._task_courant_obj()
        if task is None:
            return
        etat_clone = self._executions_clone.get(task.id)
        if etat_clone is None or not etat_clone.profils:
            self._notify_status("Aucune sortie de clone à copier.", error=True)
            return

        # BUGFIX (traceback utilisateur : AttributeError 'TaskConfigScreen'
        # object has no attribute 'client_serveur_t') -- faute de frappe :
        # TaskConfigScreen stocke son client réseau dans self._client_serveur_t
        # (avec underscore, cf. son __init__), pas self.client_serveur_t (ce
        # dernier nom n'existe que sur MainWindow, cf. ligne ~85158). getattr()
        # évalue self.client_serveur_t AVANT de chercher "_executants", donc
        # le défaut {} ne protégeait pas contre cette AttributeError -- le
        # bouton "Copier les sorties" plantait systématiquement avant même
        # d'atteindre la logique de filtrage par profil coché.
        noms_par_id = getattr(self._client_serveur_t, "_executants", {})

        def _resoudre_id_executant(cle_profil: str, profil_etat: "CloneProfilEtat") -> str:
            # Même repli à deux niveaux que _sur_demande_copier_logs_
            # execution_clone ci-dessus (cf. sa docstring) : sAutoniax
            # figé au lancement si connu, sinon dernier connu via
            # _id_executant_par_profil_clone (profil jamais lancé mais
            # déjà vu dans une liste rafraîchie).
            return profil_etat.id_executant_sautoniax or self._id_executant_par_profil_clone.get(cle_profil, "")

        def _cle_tri(paire):
            cle_profil, profil_etat = paire
            id_executant = _resoudre_id_executant(cle_profil, profil_etat)
            return (
                _cle_tri_numerique_generique(id_executant),
                _cle_tri_numerique_profil(cle_profil),
            )

        # Ordre canonique du notebook : cellule_variables (toujours en
        # premier à l'écran, cf. Task.cellule_variables) puis task.
        # cellules dans l'ordre -- cf. docstring ci-dessus.
        cellules_ordonnees = (
            ([task.cellule_variables] if task.cellule_variables is not None else [])
            + list(task.cellules)
        )

        sections: list[str] = []
        for cle_profil, profil_etat in sorted(etat_clone.profils.items(), key=_cle_tri):
            # CORRECTIF (SPEC_lot_corrections_2026-09.md section 4) :
            # filtre explicite sur la sélection -- seuls les profils
            # COCHÉS doivent être copiés (décision explicite utilisateur,
            # cf. "les logs doivent respecter les cases coché"). Avant ce
            # correctif, la boucle itérait sur TOUS les profils ayant des
            # cellules_resultats non vides, cochés ou non.
            if not profil_etat.coche:
                continue
            # PATCH : sortie EN DIRECT de la cellule en cours (le résultat n'est stocké qu'à la fin de la cellule).
            moteur_live = getattr(profil_etat, "moteur_courant", None)
            lignes_live = [
                e for e in list(getattr(moteur_live, "_sortie_accumulee", None) or []) if isinstance(e, str)
            ] if moteur_live is not None else []
            if not profil_etat.cellules_resultats and not lignes_live:
                continue
            nom_profil = _nom_depuis_cle_profil_clone(cle_profil)
            id_executant = _resoudre_id_executant(cle_profil, profil_etat)
            nom_sautoniax = noms_par_id.get(id_executant, {}).get("nom", id_executant) or "sAutoniax inconnu"

            blocs_cellules: list[str] = []
            for cellule in cellules_ordonnees:
                resultat_cellule = profil_etat.cellules_resultats.get(cellule.id)
                if resultat_cellule is None or not resultat_cellule.sortie.strip():
                    continue
                titre_cellule = resultat_cellule.titre or cellule.titre or "Cellule sans titre"
                blocs_cellules.append(f"---- {titre_cellule} ({resultat_cellule.statut}) ----\n{resultat_cellule.sortie}")

            if lignes_live:
                cellule_en_cours = next((c for c in cellules_ordonnees if c.id == profil_etat.cellule_courante_id), None)
                titre_en_cours = (getattr(cellule_en_cours, "titre", "") if cellule_en_cours else "") or "Cellule en cours"
                blocs_cellules.append(f"---- {titre_en_cours} (en cours) ----\n" + "\n".join(lignes_live))

            if not blocs_cellules:
                continue
            sections.append(
                f"==== sAutoniax : {nom_sautoniax} -- Profil : {nom_profil} ====\n\n"
                + "\n\n".join(blocs_cellules)
            )

        if not sections:
            self._notify_status("Aucune sortie de cellule connue pour les profils de ce Task.", error=True)
            return

        texte_final = "\n\n\n".join(sections)
        QGuiApplication.clipboard().setText(texte_final)
        self._notify_status(f"Sorties de {len(sections)} profil(s) copiées dans le presse-papier.")

    def _rafraichir_composants_connus_editeur(self, task: Task, precalcul_editeur: Optional[dict] = None):
        """Recalcule les noms de variables Python des composants importés
        dans ce Task (cf. nom_variable_python) et les transmet à TOUTES les
        cellules de l'éditeur -- utilisé pour la coloration syntaxique des
        composants connus ET pour savoir après quel "." déclencher
        l'auto-complétion des méthodes de ComposantExecutable.

        Transmet AUSSI les noms de ServiceAPI importés eux-mêmes (ex:
        "Word", cf. ServiceAPIExecutable/Word.instance()) -- coloration
        distincte uniquement (cf. DarculaTheme.service_api_connu), sans
        toucher à l'auto-complétion des composants.

        BUGFIX (demande explicite utilisateur : "chaque zone doit avoir
        les meme methode que un composantSingle", nécessite d'abord que
        l'auto-complétion reconnaisse les ComposantLayout eux-mêmes --
        cf. TaskScriptEditor._composants_layout_connus/
        definir_composants_layout_connus) : transmet maintenant AUSSI les
        ComposantLayout importés dans ce Task, symétriquement à
        composants_importes_task ci-dessus, via
        composants_layout_importes_task -- jusqu'ici cette méthode
        n'appelait JAMAIS definir_composants_layout_connus, rendant
        "videoTemplateItems." invisible à l'auto-complétion (ni
        METHODES_COMPOSANT_LAYOUT_EXECUTABLE ni, par ricochet,
        METHODES_ZONE_DETECTEE via .choose().nom_zone ne pouvaient jamais
        se déclencher, cf. _proposer_methodes).

        PATCH (freeze à l'ouverture d'un .autoniaxtask volumineux, cf.
        docstring de _precalculer_editeur_pour_task) : `precalcul_
        editeur`, quand fourni par _sur_import_task_termine/_sur_
        nouvelle_version_task_termine (déjà calculé côté
        ImportTaskWorker, thread séparé, pendant que l'UI restait
        libre), EFFECTUE À LA PLACE DE ce recalcul -- noms_variables/
        noms_variables_layout/noms_services_api sont alors lus tels
        quels dans le dict plutôt que redemandés à self.project. Reste
        None (comportement inchangé, recalcul ici comme avant ce
        patch) pour tout appel normal (_ouvrir_task sur un Task déjà
        présent dans la grille, pas fraîchement importé) -- seul le
        chemin d'import bénéficie du précalcul, rien d'autre ne
        change."""
        if precalcul_editeur is not None:
            noms_variables = precalcul_editeur["noms_variables"]
            noms_variables_layout = precalcul_editeur["noms_variables_layout"]
            noms_services_api = precalcul_editeur["noms_services_api"]
        else:
            groupes = self.project.composants_importes_task(task)
            noms_variables = [
                nom_variable_python(composant.nom)
                for composants in groupes.values()
                for composant in composants
            ]
            groupes_layout = self.project.composants_layout_importes_task(task)
            noms_variables_layout = [
                nom_variable_python(composant_layout.nom)
                for composants_layout in groupes_layout.values()
                for composant_layout in composants_layout
            ]
            # Union des deux groupes de ServiceAPI (un ServiceAPI peut n'avoir
            # importé QUE des ComposantLayout, ou QUE des ComposantSingle, ou
            # les deux -- dans tous les cas son nom doit rester colorié/connu).
            noms_services_api = [
                nom_variable_python(nom_service)
                for nom_service in (set(groupes) | set(groupes_layout))
            ]
        # PATCH (étape 3) : mémorisé pour les cadres rebranchés plus tard.
        _eg = dict(getattr(self, "_etat_global_editeur", None) or {})
        _eg["noms"] = (noms_variables, noms_variables_layout, noms_services_api)
        self._etat_global_editeur = _eg
        for widget in self._cellule_widgets.values():
            # UN SEUL rehighlight() par cellule au lieu de trois (cf.
            # TaskScriptEditor.definir_noms_connus_en_une_passe) -- même
            # état final que les trois setters d'origine appelés à la suite.
            widget.editeur.definir_noms_connus_en_une_passe(
                noms_variables, noms_variables_layout, noms_services_api,
            )

    def _rafraichir_variables_globales_editeur(self, task: Task, precalcul_editeur: Optional[dict] = None):
        """BUGFIX (retour utilisateur : "la suggestion de varaible concerne
        uniquement les variable local a la cellule et pourtant sa doit
        etre global au notebook") : réanalyse le texte de TOUTES les
        cellules du Task (cellule_variables ET task.cellules -- même
        périmètre que _namespace_task, le vrai namespace d'exécution
        partagé) pour construire l'ensemble des noms de variable et
        d'instance connus à l'échelle du NOTEBOOK ENTIER, puis transmet ce
        même ensemble à CHAQUE widget (cf. definir_variables_globales_connues
        / definir_instances_globales_connues sur TaskScriptEditor) -- ces
        deux méthodes fusionnent ensuite cet ensemble global avec le scan
        local propre à chaque cellule (_rescanner_variables_connues /
        _rescanner_instances_connues), qui reste inchangé et continue de
        tourner à chaque frappe pour la cellule en cours d'édition.

        AJOUT (demande explicite utilisateur -- cf. _resultats_connus sur
        TaskScriptEditor) : construit AUSSI l'ensemble des noms de
        variable "r = quelquechose.click(...)" (ResultatAction) à
        l'échelle du notebook entier, même principe et même passage que
        instances_globales ci-dessous, transmis via
        definir_resultats_globaux_connus.

        Réutilise TELLES QUELLES les regex déjà définies sur
        TaskScriptEditor (_REGEX_DECLARATION_VARIABLE,
        _REGEX_AFFECTATION_INSTANCE, _REGEX_AFFECTATION_RESULTAT) plutôt
        que de dupliquer la logique de parsing -- accédées via n'importe
        quel widget déjà construit (attributs de classe, identiques sur
        toutes les instances).

        Appelée à chaque frappe dans N'IMPORTE QUELLE cellule (cf.
        _sur_code_cellule_modifie) ET à l'ouverture du Task (cf.
        _peupler_cellules) -- pas de debounce, cohérent avec le reste du
        notebook qui persiste déjà à chaque frappe sans attendre.

        PATCH (freeze à l'ouverture d'un .autoniaxtask volumineux, cf.
        docstring de _precalculer_editeur_pour_task) : `precalcul_
        editeur`, quand fourni, EFFECTUE À LA PLACE DE ce recalcul --
        variables_globales/instances_globales/resultats_globaux sont
        alors lus tels quels dans le dict (déjà calculés côté
        ImportTaskWorker, thread séparé) plutôt que recalculés ici en
        reparcourant toutes les cellules du Task. None (défaut) laisse
        le comportement inchangé pour tout appel normal."""
        if not self._cellule_widgets:
            return
        if precalcul_editeur is not None:
            variables_globales = precalcul_editeur["variables_globales"]
            instances_globales = precalcul_editeur["instances_globales"]
            resultats_globaux = precalcul_editeur["resultats_globaux"]
        else:
            # N'importe quel widget donne accès aux regex (attributs de
            # classe partagés par tous les TaskScriptEditor).
            un_editeur = next(iter(self._cellule_widgets.values())).editeur
            regex_variables = un_editeur._REGEX_DECLARATION_VARIABLE
            regex_instances = un_editeur._REGEX_AFFECTATION_INSTANCE
            regex_resultats = un_editeur._REGEX_AFFECTATION_RESULTAT
            # nom_variable_python() : même transformation que celle appliquée
            # aux ServiceAPI transmis via definir_services_api_connus (cf.
            # _rafraichir_composants_connus_editeur juste au-dessus) --
            # _REGEX_AFFECTATION_INSTANCE capture le nom TEL QU'ÉCRIT dans le
            # script (donc déjà un identifiant Python valide), qui doit être
            # comparé au nom VARIABILISÉ du ServiceAPI, pas à sa clé brute
            # dans task.services_api_importes (cf. _rescanner_instances_connues
            # côté TaskScriptEditor, qui compare à _services_api_connus,
            # peuplé avec ces mêmes noms variabilisés).
            services_api_connus = {nom_variable_python(nom) for nom in task.services_api_importes.keys()}

            variables_globales: set = set()
            instances_globales: set = set()
            resultats_globaux: set = set()

            cellules_a_scanner = list(task.cellules)
            if task.cellule_variables is not None:
                cellules_a_scanner.append(task.cellule_variables)

            for cellule in cellules_a_scanner:
                texte = cellule.code or ""
                for groupe_egal, groupe_for, groupe_as, groupe_nom_def, groupe_params_def in regex_variables.findall(texte):
                    if groupe_egal:
                        for segment in groupe_egal.split("=")[:-1]:
                            variables_globales.update(n.strip() for n in segment.split(",") if n.strip())
                    if groupe_for:
                        variables_globales.update(n.strip() for n in groupe_for.split(","))
                    if groupe_as:
                        variables_globales.add(groupe_as.strip())
                    if groupe_nom_def:
                        # Nom de la fonction elle-même -- même bugfix que côté
                        # local, cf. _rescanner_variables_connues.
                        variables_globales.add(groupe_nom_def.strip())
                    if groupe_params_def:
                        for param in groupe_params_def.split(","):
                            m_param = un_editeur._REGEX_NOM_PARAMETRE.match(param.strip())
                            if m_param:
                                variables_globales.add(m_param.group(1))
                for nom_variable, nom_service in regex_instances.findall(texte):
                    if nom_service in services_api_connus:
                        instances_globales.add(nom_variable)
                for nom_variable, _nom_methode in regex_resultats.findall(texte):
                    resultats_globaux.add(nom_variable)

            variables_globales.discard("_")

        _eg = dict(getattr(self, "_etat_global_editeur", None) or {})
        _eg["globales"] = (variables_globales, instances_globales, resultats_globaux)
        self._etat_global_editeur = _eg
        for widget in self._cellule_widgets.values():
            widget.editeur.definir_variables_globales_connues(variables_globales)
            widget.editeur.definir_instances_globales_connues(instances_globales)
            widget.editeur.definir_resultats_globaux_connus(resultats_globaux)

    # ------------------------------------------------------------------
    # Attribution WORKSPACE (SPEC_workspace_attribution.md)
    # ------------------------------------------------------------------

    def _sur_demande_attribuer_workspace_silencieux(self):
        """Handler du CLIC GAUCHE sur bouton_attribuer_workspace (spec
        section 4 ; PATCH v2, SPEC_patch_tasks_json.md section 1.2 --
        un WORKSPACE est désormais UN SEUL fichier JSON, plus une liste
        de dossiers chaînés). Deux cas :
        - Aucun fichier WORKSPACE encore configuré pour ce Task -> ouvre
          le sélecteur de FICHIER JSON ; une fois choisi, persisté comme
          Task.workspace_fichier puis attribution immédiate (même chemin
          que le cas "déjà configuré" ci-dessous).
        - Un fichier est déjà configuré -> ré-attribution immédiate et
          silencieuse sur ce fichier, avec le dernier mode/N mémorisés
          sur le Task -- MÊME SI le fichier ne contient plus aucune
          tâche en attente (fichier vidé, toutes les tâches terminées,
          etc.) : _effectuer_attribution_workspace gère déjà ce cas sans
          planter (liste de tâches vide), et ne doit jamais redemander
          de fichier tant que l'usager n'a pas explicitement redemandé
          d'en changer (clic droit)."""
        task = self._task_courant_obj()
        if task is None:
            return
        if not task.workspace_fichier:
            fichier, _filtre = BoiteDialogueAutoniaX.ouvrir_fichier(
                self, "Choisir le fichier WORKSPACE", "", "Fichiers JSON (*.json)",
            )
            if not fichier:
                return
            task.workspace_fichier = fichier
            if self.reglages is not None:
                enregistrer_workspace_recent(self.reglages, fichier)
                self.reglages.save()
            self.project.save()
        self._effectuer_attribution_workspace(task)

    def _sur_demande_attribuer_workspace_dialogue(self):
        """Handler du CLIC DROIT sur bouton_attribuer_workspace (spec
        section 4 ; PATCH v2, SPEC_patch_tasks_json.md section 1.2).

        CORRECTIF (demande explicite utilisateur : "sa doit ouvrir quand
        meme le widget de configuration [...] sa doit etre global a tout
        les notbook pas relatifs a un notebook" -- BUG confirmé sur
        données réelles : un Task ("ImageCaptions") avait déjà un
        workspace_fichier configuré, tous les autres Tasks du même projet
        avaient workspace_fichier="" -- clic droit sur l'un de ces autres
        Tasks tombait alors dans l'ANCIEN bloc "aucun fichier configuré",
        qui ouvrait un simple QFileDialog brut, SANS accès au mini-
        gestionnaire "Récents" de DialogueWorkspaceConfig -- alors que ce
        fichier récent existe bel et bien, PARTAGÉ globalement entre tous
        les Task/Project de la machine (ReglagesApp.workspace_fichiers_
        recents, cf. docstring de classe DialogueWorkspaceConfig : "ça
        doit persister en global, pas sur le fichier"). L'utilisateur
        devait donc retrouver/re-parcourir le fichier à la main pour
        CHAQUE nouveau Task, alors que DialogueWorkspaceConfig expose
        déjà tout ce qu'il faut (bouton "Choisir un fichier..." ET liste
        "Récents") pour couvrir ce cas -- inutile de dupliquer un chemin
        séparé et appauvri juste parce que CE Task précis n'a pas encore
        de workspace_fichier.

        ANCIEN comportement (SUPPRIMÉ par ce correctif) : tant qu'aucun
        fichier n'était configuré, clic droit == clic gauche (sélecteur
        de fichier brut immédiat, sans boîte). DialogueWorkspaceConfig
        gère déjà nativement task.workspace_fichier == "" sans planter
        (cf. son _rafraichir_liste_taches : scanner_taches_workspace("")
        retombe sur une liste vide, affichée "0 terminée · 0 en attente ·
        0 au total" ; son label d'en-tête affiche "Aucun fichier
        WORKSPACE configuré" dans ce cas, cf. son __init__) -- rien ne
        justifiait de l'éviter pour ce cas précis.

        NOUVEAU comportement, UNIFORME quel que soit l'état de
        task.workspace_fichier pour CE Task : ouvre TOUJOURS
        DialogueWorkspaceConfig (liste des tâches du fichier déjà
        configuré s'il y en a un, ou boîte vide avec le bouton "Choisir
        un fichier..." et le panneau "Récents" déjà déplié sur les
        chemins utilisés par d'autres Task sinon) -- c'est la boîte
        elle-même, pas ce handler, qui décide comment amener l'usager à
        un fichier (choix neuf OU réutilisation immédiate d'un récent
        global, cf. _sur_clic_choisir_fichier/_sur_clic_ouvrir_recent).
        Le projet est sauvegardé après l'appel, que l'attribution ait eu
        lieu ou non (le mode de répartition/N, ou task.workspace_fichier
        lui-même, ont pu changer dans la boîte même si l'usager ferme
        sans cliquer "Attribuer", cf. docstring de classe de
        DialogueWorkspaceConfig)."""
        task = self._task_courant_obj()
        if task is None:
            return
        boite = DialogueWorkspaceConfig(task, self.panneau_clone, self)
        boite.exec()
        if boite.attribution_effectuee:
            self._appliquer_attribution_workspace(task, boite.derniere_attribution)
        self.project.save()

    def _effectuer_attribution_workspace(self, task: "Task"):
        """Scanne le fichier WORKSPACE de `task` (PATCH v2 -- un seul
        fichier désormais, plus une file chaînée de dossiers, cf.
        scanner_taches_workspace), calcule la répartition avec le
        mode/N actuellement mémorisés sur le Task, et applique le
        résultat (spec section 4, "clic gauche" -- silencieux, pas de
        boîte de dialogue). Facteurise le scan+calcul+message de statut,
        réutilisé par le tout premier choix de fichier (clic gauche ET
        clic droit, cf. les deux handlers ci-dessus) et par la ré-
        attribution silencieuse d'un fichier déjà configuré."""
        taches = scanner_taches_workspace(task.workspace_fichier)
        # PATCH v3 : `t.en_attente` (statut == "en_attente") exclut à la
        # fois les tâches terminées ET les abandonnées -- une tâche
        # abandonnée n'est pas "non terminée" au sens où elle resterait
        # candidate à l'attribution, elle est volontairement écartée.
        taches_en_attente = [t for t in taches if t.en_attente]
        cles_profils = self.panneau_clone.ordre_affichage_cles_profils()
        if not cles_profils:
            self._notify_status(
                "Aucun profil dans le panneau clone -- rien à attribuer.", error=True,
            )
            return
        attribution = repartir_taches_workspace(
            taches_en_attente, cles_profils,
            task.workspace_mode_repartition, task.workspace_nombre_fixe,
            champs_exclus=task.workspace_champs_exclus,
        )
        self._appliquer_attribution_workspace(task, attribution)
        # PATCH v2, PATCH v4 : chaque élément attribué est désormais un
        # dict (PATCH v4 : directement les champs métier ; PATCH v2 :
        # {"donnees", "fichier_source"}) -- non hashable, donc on ne peut
        # plus dédoublonner par ensemble (`{c for chemins in ...}` comme
        # au temps des chemins str). Chaque tâche du résultat n'apparaît
        # de toute façon jamais dans deux listes différentes (garanti
        # par repartir_taches_workspace, cf. sa docstring) : une simple
        # somme des longueurs donne donc le même compte, sans risquer de
        # TypeError sur un dict non hashable.
        nb_taches_attribuees = sum(len(v) for v in attribution.values())
        self._notify_status(
            f"{nb_taches_attribuees} tâche(s) réattribuée(s) à {len(attribution)} profil(s)."
            if nb_taches_attribuees else
            "Aucune tâche en attente à attribuer."
        )

    def _appliquer_attribution_workspace(self, task: "Task", attribution: dict):
        """Stocke `attribution` (dict cle_profil -> [tâches...], déjà
        calculé par repartir_taches_workspace -- PATCH v4, chaque tâche
        directement un dict de champs métier ; PATCH v2, un dict
        {"donnees", "fichier_source"}) dans ExecutionCloneEtat.
        workspace_attribution pour ce Task (spec section 7 -- PAS persisté
        sur disque, écrasé en entier à chaque nouvelle attribution, cf.
        docstring du champ). Ne touche ni aux namespaces d'exécution ni
        au texte réseau envoyé -- l'injection réelle (spec section 8) a
        lieu plus tard, au moment de LANCER une séquence sur chaque
        profil (cf. _lancer_sequence_clone_profil_local/_lancer_sequence_
        clone_profil), pas ici : une attribution peut être recalculée
        plusieurs fois AVANT le prochain lancement, sans effet tant qu'un
        lancement n'a pas lieu.

        SEULE EXCEPTION (demande explicite utilisateur : "je voudrais
        qu'un clic rafraîchisse aussi immédiatement l'affichage de la
        cellule cellule_variables pour le profil actif, sans attendre un
        relancement") -- l'AFFICHAGE, lui, est rafraîchi tout de suite
        ci-dessous. Rien n'est exécuté ni persisté pour autant : la
        phrase ci-dessus reste vraie pour tout ce qui touche à
        l'exécution réelle."""
        etat_clone = self._executions_clone.setdefault(task.id, ExecutionCloneEtat())
        etat_clone.workspace_attribution = dict(attribution)
        self._rafraichir_affichage_workspace_cellule_variables(task, etat_clone)

    # ------------------------------------------------------------------
    # Affichage de la valeur WORKSPACE réellement attribuée au profil
    # clone ACTIF, dans l'éditeur de la cellule "# Variable dynamique"
    # (demande explicite utilisateur : "rassure-toi que quand je clique
    # sur un profil clone dans le panneau de clone ça affiche bien la
    # valeur à jour de la variable workspace pour ce profil").
    #
    # RÈGLE UNIQUE, volontairement simple à vérifier : l'éditeur de
    # cellule_variables montre TOUJOURS l'attribution COURANTE du profil
    # COURAMMENT actif -- jamais une valeur figée au moment d'un
    # lancement passé. Deux conséquences assumées :
    #   - un profil jamais lancé affiche quand même son attribution (il
    #     n'existe alors aucun cellules_resultats pour lui, donc aucune
    #     valeur "historique" à montrer de toute façon) ;
    #   - après une ré-attribution, l'affichage montre ce qui SERA
    #     injecté au prochain lancement, pas ce qui l'a été au dernier.
    #     C'est bien le sens de "valeur à jour" demandé.
    # Aucun autre chemin n'écrit dans cet éditeur, ce qui évite toute
    # concurrence entre deux sources d'affichage.
    # ------------------------------------------------------------------

    def _widget_cellule_variables(self, task: "Task"):
        """Retourne (cellule_variables, widget) pour `task`, chacun
        pouvant être None (Task sans cellule variables, ou widgets pas
        encore construits / Task pas affiché)."""
        cellule_variables = getattr(task, "cellule_variables", None)
        if cellule_variables is None:
            return None, None
        return cellule_variables, self._cellule_widgets.get(cellule_variables.id)

    def _rafraichir_affichage_workspace_cellule_variables(
        self, task: Optional["Task"], etat: Optional["ExecutionCloneEtat"] = None,
    ):
        """Repose dans l'éditeur de cellule_variables la valeur WORKSPACE
        du profil clone actif -- ou le vrai code source si aucun profil
        n'est actif / si ce profil n'a aucune tâche attribuée.

        No-op si `task` n'est pas celui actuellement AFFICHÉ : cette
        méthode est appelée depuis des callbacks d'exécution qui peuvent
        très bien arriver après que l'utilisateur a changé de Task (même
        garde que _rafraichir_panneau_clone_si_ouvert), et
        self._cellule_widgets appartient au Task affiché, pas à celui du
        callback -- sans cette garde on écrirait l'attribution d'un Task
        dans la cellule d'un AUTRE.

        Idempotente et bon marché (cf. TaskCelluleWidget.
        definir_code_affiche, qui ne repose le texte que s'il a
        réellement changé) : appelable sans précaution depuis n'importe
        quel point de rafraîchissement."""
        if task is None or task.id != self._task_courant:
            return
        cellule_variables, widget = self._widget_cellule_variables(task)
        if widget is None:
            return
        if etat is None:
            etat = self._executions_clone.get(task.id)
        cle_profil = etat.profil_actif if etat is not None else None
        code_reel = cellule_variables.code
        if not cle_profil:
            # Aucun profil actif -> la cellule redevient une cellule
            # parfaitement ordinaire (texte affiché == code source).
            #
            # BUGFIX (demande explicite utilisateur : "il faut reverifier
            # a cchaque ouverture si le contenue est vide, si non on vide
            # et on resauvregarde directement [...] cest quand on na pas
            # selectionner de profisl claone") -- filet supplémentaire,
            # posé ICI (à chaque affichage de cellule_variables SANS
            # profil actif -- donc à chaque ouverture de Task, cf. appel
            # depuis _ouvrir_task, mais aussi à chaque désactivation d'un
            # profil clone en cours de session) en complément du filet
            # déjà posé côté Project.save (_nettoyer_list_tasks_avant_
            # sauvegarde, qui protège TOUTE sauvegarde quel que soit le
            # chemin qui a rempli LIST_TASKS) : ici on ne se contente pas
            # d'empêcher la valeur remplie d'ATTEINDRE le disque à la
            # prochaine sauvegarde -- on la corrige et on sauvegarde
            # IMMÉDIATEMENT, dès qu'on détecte qu'elle est déjà là,
            # plutôt que d'attendre une action ultérieure de l'usager
            # (frappe dans l'éditeur, etc.) qui pourrait ne jamais venir.
            #
            # valeur_list_tasks_dans_code retourne None si LIST_TASKS
            # n'est pas déclarée du tout dans ce code (utilisateur ayant
            # supprimé la ligne -- rien à faire, cf. sa docstring) ; "[]"
            # si déjà vide (cas normal, écriture évitée). Uniquement une
            # valeur DIFFÉRENTE de "[]" déclenche la correction.
            valeur_actuelle = valeur_list_tasks_dans_code(code_reel)
            if valeur_actuelle is not None and valeur_actuelle != "[]":
                code_reel = remplacer_valeur_list_tasks(code_reel, "[]")
                cellule_variables.code = code_reel
                self.project.save()
            widget.definir_code_affiche(code_reel)
            return
        chemins = list(etat.workspace_attribution.get(cle_profil, []))
        code_affiche = code_variables_avec_workspace_affiche(code_reel, chemins)
        # Si l'attribution de ce profil est vide, code_affiche est
        # RIGOUREUSEMENT égal à code_reel (cf. docstring de
        # code_variables_avec_workspace_affiche) -- definir_code_affiche
        # sort alors d'elle-même du mode cosmétique, la cellule reste
        # une cellule normale, sans réconciliation à gérer à la frappe.
        widget.definir_code_affiche(code_affiche, code_reel)

    def _code_a_persister_depuis_editeur(self, widget, task: "Task" = None, cellule=None) -> str:
        """Retourne le code à écrire dans TaskCellule.code à partir de ce
        que l'éditeur affiche RÉELLEMENT -- point de passage obligé de
        _sur_code_cellule_modifie.

        Cas normal (aucun affichage cosmétique en cours) : le texte de
        l'éditeur EST le code source, rien à faire.

        Cas cellule_variables avec une attribution LIST_TASKS affichée
        (PATCH v2, SPEC_patch_tasks_json.md section 5/6 -- WORKSPACE
        renommée LIST_TASKS) : persister le texte tel quel figerait dans
        project.json une liste de tâches qui n'a rien à y faire
        (l'attribution est recalculée à chaque fois depuis le fichier
        WORKSPACE, cf. spec section 7) ET détruirait la vraie déclaration
        `LIST_TASKS = []` de l'utilisateur. Deux sous-cas, distingués en
        comparant la ligne LIST_TASKS affichée à celle actuellement dans
        l'éditeur :
          - ligne LIST_TASKS INCHANGÉE (l'utilisateur a tapé ailleurs
            dans la cellule : RETRY, TIMEOUT, une nouvelle ligne...) ->
            on persiste sa saisie MAIS avec la vraie valeur LIST_TASKS
            restaurée, et on met à jour la référence "code réel" du
            widget pour que la frappe suivante se réconcilie contre
            cette nouvelle version ;
          - ligne LIST_TASKS RÉÉCRITE OU SUPPRIMÉE par l'utilisateur ->
            il reprend explicitement la main sur cette variable : sa
            saisie fait foi telle quelle, et l'affichage cosmétique est
            abandonné (il sera reposé au prochain clic de profil ou à la
            prochaine attribution).

        Dans les deux sous-cas, definir_code_affiche est rappelée avec un
        `code` STRICTEMENT égal au texte déjà présent dans l'éditeur :
        elle ne repose donc aucun texte (idempotence), ce qui garantit à
        la fois l'absence de saut de curseur pendant la frappe et
        l'impossibilité d'une récursion textChanged -> code_modifie ->
        _sur_code_cellule_modifie -> setPlainText -> textChanged.

        BUGFIX (LIST_TASKS persisté en dur pour certains Tasks) --
        l'ancienne version faisait confiance à
        `widget.code_reel_sous_affichage()` / `widget.code_affiche_
        cosmetique()`, des attributs D'INSTANCE DU WIDGET. Or
        _peupler_cellules détruit et recrée les widgets de cellule à
        chaque reconstruction de la grille (changement de Task,
        ré-ouverture, etc.) : un widget neuf redémarre avec ces deux
        attributs à None ("cellule ordinaire"), MÊME SI un profil clone
        reste actif et qu'un LIST_TASKS rempli est/était affiché à
        l'écran. Dans ce cas `code_reel is None` faisait sortir en
        ligne 1 (ancien comportement) et `code_edite` -- LIST_TASKS
        rempli inclus -- était persisté tel quel dans project.json :
        c'est la cause du bug observé (reproductible uniquement sur un
        Task dont la cellule_variables a été affichée avec une
        attribution active au moment d'une reconstruction de widget).

        Le correctif ne dépend plus SEULEMENT de l'état du widget : il
        revérifie contre la source de vérité (etat_clone.profil_actif +
        etat_clone.workspace_attribution, cf. _appliquer_attribution_
        workspace) si un profil clone est actif ET a une attribution
        pour cette cellule_variables précise. Si oui, la réconciliation
        est TOUJOURS appliquée, que le widget ait ou non son état
        cosmétique interne à jour -- l'état logique (etat_clone) fait
        foi, jamais l'état du widget seul."""
        code_edite = widget.code_actuel()
        code_reel = widget.code_reel_sous_affichage()

        # Détermine indépendamment du widget si CE code (celui de cette
        # cellule précise) doit être protégé par la réconciliation
        # LIST_TASKS -- uniquement pertinent pour cellule_variables.
        code_source_reel = None
        valeur_attribution_active = None
        if (
            task is not None
            and cellule is not None
            and getattr(task, "cellule_variables", None) is cellule
        ):
            etat_clone = self._executions_clone.get(task.id)
            cle_profil = etat_clone.profil_actif if etat_clone is not None else None
            if cle_profil:
                chemins_attribues = etat_clone.workspace_attribution.get(cle_profil)
                if chemins_attribues:
                    # Un profil actif a une attribution non vide pour
                    # cette Task : le vrai code source (celui qui doit
                    # finir dans project.json) est cellule.code TEL
                    # QU'IL ÉTAIT AVANT cette frappe -- jamais
                    # code_edite, qui peut contenir le LIST_TASKS
                    # cosmétique rempli, avec ou sans widget à jour.
                    code_source_reel = cellule.code
                    # La valeur EXACTE que le mode cosmétique affiche
                    # pour ce profil, calculée depuis la source de
                    # vérité (etat_clone) -- PAS depuis
                    # widget.code_affiche_cosmetique(), qui peut être
                    # None si le widget a été recréé entre-temps.
                    valeur_attribution_active = litteral_liste_taches(chemins_attribues)
            # BUGFIX (LIST_TASKS rempli persisté alors qu'AUCUN profil
            # clone n'est actif) -- symétrique du BUGFIX déjà documenté
            # plus haut pour le cas "profil actif", mais pour le cas
            # INVERSE : aucun profil actif (cle_profil vide) ou profil
            # actif SANS attribution pour cette Task (chemins_attribues
            # vide/absent) ne pose ici AUCUN code_source_reel -- alors
            # que _peupler_cellules détruit et recrée les widgets de
            # cellule à chaque reconstruction de la grille (changement
            # de Task, désactivation du panneau clone, ré-ouverture...),
            # laissant `code_reel_sous_affichage()` retomber à None sur
            # le widget neuf MÊME SI l'éditeur affiche encore, à l'écran,
            # un LIST_TASKS rempli hérité d'un affichage cosmétique
            # d'AVANT la recréation (dernier profil actif au moment de
            # la reconstruction). Dans ce cas `code_reel is None` ET
            # `code_source_reel is None` faisaient sortir en ligne 1
            # (return code_edite) : le texte affiché -- LIST_TASKS
            # rempli inclus -- était alors persisté tel quel dans
            # project.json à la première frappe, exactement le bug
            # signalé ("dans le notebook sans profil cloné sélectionné,
            # LIST_TASKS doit être la liste vide, mais reste rempli des
            # valeurs du dernier run").
            #
            # Correctif : `cellule.code` (la vraie source déjà persistée
            # sur disque, jamais réécrite par un affichage cosmétique)
            # sert ICI de référence, exactement comme code_source_reel
            # le fait pour le cas "profil actif" -- que le widget ait ou
            # non son état cosmétique interne à jour, la source de
            # vérité sur disque fait foi.
            elif code_reel is None:
                code_source_reel = cellule.code

        if code_reel is None and code_source_reel is None:
            return code_edite

        # Le widget peut avoir perdu son propre code_reel_sous_affichage
        # (recréation) : dans ce cas on retombe sur code_source_reel
        # (source de vérité indépendante du widget) ci-dessus.
        code_reel_effectif = code_reel if code_reel is not None else code_source_reel

        valeur_affichee = valeur_list_tasks_dans_code(widget.code_affiche_cosmetique() or "")
        valeur_editee = valeur_list_tasks_dans_code(code_edite)
        valeur_reelle_source = valeur_list_tasks_dans_code(code_reel_effectif or "")

        # Réconciliation forcée dès que le profil actif a une
        # attribution en cours (code_source_reel non None) : peu importe
        # que le widget ait un affichage cosmétique cohérent ou non,
        # LIST_TASKS ne doit JAMAIS être persisté rempli tant qu'un
        # profil est actif avec une attribution -- seule une valeur
        # LIST_TASKS DIFFÉRENTE à la fois de celle actuellement
        # attribuée ET de la valeur réelle ([] ou autre) sort du mode
        # protégé (reprise de main explicite par l'utilisateur).
        if code_source_reel is not None:
            if valeur_editee is not None and valeur_editee == valeur_reelle_source:
                # L'utilisateur a tapé ailleurs (ou rien de pertinent n'a
                # changé sur cette ligne) : on persiste sa saisie avec le
                # LIST_TASKS réel restauré.
                code_a_persister = reconcilier_code_edite_avec_workspace_reel(code_edite, code_reel_effectif)
                widget.definir_code_affiche(code_edite, code_a_persister)
                return code_a_persister
            if valeur_editee is not None and valeur_editee == valeur_attribution_active:
                # La valeur éditée correspond exactement à l'attribution
                # cosmétique active connue (recalculée depuis etat_clone,
                # indépendamment de l'état -- potentiellement périmé ou
                # None -- du widget) : c'est le rendu cosmétique intact,
                # jamais une reprise de main volontaire -> protégé.
                code_a_persister = reconcilier_code_edite_avec_workspace_reel(code_edite, code_reel_effectif)
                widget.definir_code_affiche(code_edite, code_a_persister)
                return code_a_persister
            # La ligne LIST_TASKS a été explicitement réécrite par
            # l'utilisateur à une valeur différente à la fois du réel et
            # de l'attribution active : reprise de main assumée, comme
            # avant.
            widget.definir_code_affiche(code_edite)
            return code_edite

        # Chemin d'origine (code_reel du widget seul, aucune attribution
        # active détectée via etat_clone -- ex. Task sans profil clone) :
        # comportement inchangé.
        if valeur_editee is not None and valeur_editee == valeur_affichee:
            code_a_persister = reconcilier_code_edite_avec_workspace_reel(code_edite, code_reel_effectif)
            widget.definir_code_affiche(code_edite, code_a_persister)
            return code_a_persister
        widget.definir_code_affiche(code_edite)
        return code_edite

    def _retour_grille(self):
        self._task_courant = None
        self._reload_grille()
        self.stack.setCurrentWidget(self.grille_page)

    def _task_courant_obj(self) -> Optional[Task]:
        if self._task_courant is None:
            return None
        return self.project.find_task(self._task_courant)

    # ------------------------------------------------------------------
    # Édition (nom, cellules, import de ServiceAPI, suppression)
    # ------------------------------------------------------------------
    def _on_nom_edited(self):
        task = self._task_courant_obj()
        if task is None:
            return
        nouveau_nom = self.nom_edit.text().strip()
        if not nouveau_nom or nouveau_nom == task.nom:
            self.nom_edit.setText(task.nom)
            return
        task.nom = nouveau_nom
        self.project.save()
        carte = self._task_cartes.get(task.id)
        if carte is not None:
            carte.rafraichir(task)
        self._notify_status(f"Task renommé en « {nouveau_nom} ».")

    def _on_taille_police_editeur_changee(self, taille_pt: int):
        """Applique immédiatement la nouvelle taille à TOUTES les cellules
        du notebook et la persiste (source de vérité partagée avec
        ParametresScreen, qui a le même réglage -- cf.
        ReglagesApp.taille_police_editeur_script). Réglage global, pas par
        cellule -- cohérent avec un vrai notebook."""
        for widget in self._cellule_widgets.values():
            widget.editeur.appliquer_taille_police(taille_pt)
        if self._liste_virtuelle_active():   # PATCH (étape 3)
            self._liste_virtuelle.invalider_hauteurs()
        if self.reglages is not None:
            self.reglages.taille_police_editeur_script = taille_pt
            self.reglages.save()

    def _sur_bascule_icone_retour_ligne(self, actif: bool):
        """Met à jour l'icône du bouton retour à la ligne selon son état
        (bascule QToolButton.toggled -- cf. connect dans _build_editeur,
        icônes distinctes déjà préparées : self._icone_retour_ligne_on /
        self._icone_retour_ligne_off), pour que le bouton reste lisible en
        un coup d'oeil même sans lire son tooltip. Séparée de
        _sur_clic_retour_ligne (qui gère elle la logique fonctionnelle :
        appliquer le wrap aux cellules + persister le réglage) -- toggled
        et clicked sont deux signaux distincts branchés tous les deux sur
        ce bouton (cf. _build_editeur), chacun avec sa responsabilité
        propre."""
        self.bouton_retour_ligne.setIcon(
            self._icone_retour_ligne_on if actif else self._icone_retour_ligne_off
        )

    def _sur_clic_retour_ligne(self):
        """Bascule le retour à la ligne (demande utilisateur explicite,
        bouton de la toolbar principale) sur TOUTES les cellules du
        notebook d'un coup -- même pattern global (pas par cellule) que
        _on_taille_police_editeur_changee juste au-dessus, cohérent avec un
        vrai notebook où ce genre de réglage d'affichage s'applique
        uniformément. Persisté (cf. ReglagesApp.retour_a_la_ligne_editeur_script)
        pour que le choix survive à la fermeture/réouverture du Task et de
        l'app."""
        actif = self.bouton_retour_ligne.isChecked()
        for widget in self._cellule_widgets.values():
            widget.editeur.definir_retour_a_la_ligne(actif)
        if self.reglages is not None:
            self.reglages.retour_a_la_ligne_editeur_script = actif
            self.reglages.save()

    def _sur_clic_copier_toutes_cellules(self):
        """Bouton "Copier toutes les cellules" de la toolbar principale
        (demande explicite utilisateur, à côté du réglage de taille de
        police -- CORRECTIF : la première version copiait le CODE des
        cellules, alors que la demande portait sur les SORTIES affichées
        sous chaque cellule après exécution, même contenu que le bouton
        "copier" individuel de chaque cellule -- cf. _copier_sortie/
        self.zone_sortie.text()) -- concatène la sortie de la cellule
        Variable dynamique puis de TOUTES les cellules du notebook, DANS
        L'ORDRE de task.cellules (même ordre que
        _executer_toutes_les_cellules). Chaque bloc non vide est précédé
        d'un en-tête reprenant le titre de la cellule, pour rester lisible
        une fois collé ailleurs. Ne copie que les cellules ACTIVES ET
        possédant une sortie non vide -- une cellule jamais exécutée ou
        désactivée n'a rien à apporter ici.

        RETRAIT (demande explicite utilisateur : "actuellement sa copie
        aussi le code du terminal, je ne veux pas ça, juste uniquement les
        sorties de cellule") -- l'ancien AJOUT qui accolait un dernier
        bloc "# ==== Terminal (console AutoniaX) ====" (lu via
        _lire_buffer_console_windows()) a été retiré : ce bouton ne copie
        plus QUE les sorties de cellules, plus rien d'autre.
        _lire_buffer_console_windows() reste utilisée ailleurs
        (ParametresScreen._on_clic_copier_terminal, bouton dédié "Copier
        terminal") -- seul CE bouton-ci ne l'appelle plus."""
        task = self._task_courant_obj()
        if task is None:
            return

        blocs: list[str] = []

        var_widget = self._cellule_widgets.get(task.cellule_variables.id) if task.cellule_variables else None
        if var_widget is not None and var_widget.est_active():
            sortie_var = var_widget.zone_sortie.text()
            if sortie_var.strip():
                blocs.append(f"# ==== {task.cellule_variables.titre or 'Variable dynamique'} ====\n{sortie_var}")

        for cellule in task.cellules:
            widget = self._cellule_widgets.get(cellule.id)
            if widget is None or not widget.est_active():
                continue
            sortie_cellule = widget.zone_sortie.text()
            if not sortie_cellule.strip():
                continue
            titre = cellule.titre or "Cellule sans titre"
            blocs.append(f"# ==== {titre} ====\n{sortie_cellule}")

        if not blocs:
            self._notify_status("Aucune sortie de cellule à copier.", error=True)
            return

        nb_blocs_cellules = len(blocs)
        texte_final = "\n\n".join(blocs)
        QGuiApplication.clipboard().setText(texte_final)
        self.bouton_copier_toutes_cellules.setIcon(qta.icon("mdi6.check", color=Mocha.green))
        self.bouton_copier_toutes_cellules.setToolTip("Copié !")
        QTimer.singleShot(1200, self._restaurer_icone_copier_toutes_cellules)
        self._notify_status(f"Sorties de {nb_blocs_cellules} cellule(s) copiées dans le presse-papier.")

    def _restaurer_icone_copier_toutes_cellules(self):
        self.bouton_copier_toutes_cellules.setIcon(qta.icon("mdi6.content-copy", color=Mocha.subtext0))
        self.bouton_copier_toutes_cellules.setToolTip(
            "Copier les sorties de toutes les cellules du notebook"
        )

    # ------------------------------------------------------------------
    # Copie du code d'un AUTRE notebook sans le rouvrir (bouton
    # self.bouton_copier_autre_notebook de la toolbar)
    # ------------------------------------------------------------------
    def _sur_clic_copier_autre_notebook(self):
        """Affiche la liste des Tasks du projet (même ordre que la grille :
        épinglés d'abord dans leur ordre manuel, puis les plus récemment
        ouverts). Le Task actuellement ouvert est exclu : on veut le code
        d'un AUTRE notebook. Un clic sur une entrée copie son code."""
        courant = self._task_courant_obj()
        tasks = [t for t in self.project.tasks if courant is None or t.id != courant.id]
        epingles = sorted((t for t in tasks if t.epingle), key=lambda t: t.ordre_epingle)
        autres = sorted((t for t in tasks if not t.epingle), key=lambda t: t.date_derniere_ouverture, reverse=True)

        menu = MenuAvecClicDroitSurAction(self.bouton_copier_autre_notebook)
        menu.setStyleSheet("QMenu { menu-scrollable: 1; }")
        menu.clic_droit_action.connect(
            lambda action: self._copier_code_notebook_par_id(action.data())
        )
        if not tasks:
            vide = menu.addAction("Aucun autre notebook dans ce projet")
            vide.setEnabled(False)
        else:
            for task in epingles + autres:
                nb = len(task.cellules) + (1 if task.cellule_variables is not None else 0)
                prefixe = "\U0001F4CC " if task.epingle else ""
                action = menu.addAction(f"{prefixe}{task.nom}  ({nb} cellule{'s' if nb > 1 else ''})")
                action.setData(task.id)
                action.setToolTip("Clic gauche : ouvrir -- clic droit : copier le code")
                action.triggered.connect(lambda _checked=False, tid=task.id: self._ouvrir_autre_notebook(tid))
        bouton = self.bouton_copier_autre_notebook
        menu.exec(bouton.mapToGlobal(QPoint(0, bouton.height())))

    def _execution_en_cours_dans_editeur(self) -> bool:
        """True si une séquence ou un moteur de cellule tourne (même
        critère que les autres gardes de ce fichier). Ouvrir un autre
        Task réinitialise l'état de séquence : on refuse donc tant que
        quelque chose s'exécute."""
        return bool(
            self._sequence_active
            or self._moteurs_en_cours
            or any(m is not None for m in self._moteur_courant_par_task.values())
        )

    def _ouvrir_autre_notebook(self, task_id: str):
        """Clic gauche dans le menu : remplace le notebook affiché par
        celui choisi, seulement si aucune exécution n'est en cours."""
        if self._execution_en_cours_dans_editeur():
            self._notify_status(
                "Une exécution est en cours -- attendez sa fin ou arrêtez-la avant d'ouvrir un autre notebook.",
                error=True,
            )
            return
        if self.project.find_task(task_id) is None:
            self._notify_status("Notebook introuvable.", error=True)
            return
        self._ouvrir_task(task_id)

    def _copier_code_notebook_par_id(self, task_id: str):
        task = self.project.find_task(task_id)
        if task is None:
            self._notify_status("Notebook introuvable.", error=True)
            return
        texte = _construire_texte_notebook_complet(task)
        if not texte.strip():
            self._notify_status(f"« {task.nom} » ne contient aucun code.", error=True)
            return
        QGuiApplication.clipboard().setText(texte)
        self.bouton_copier_autre_notebook.setIcon(qta.icon("mdi6.check", color=Mocha.green))
        self.bouton_copier_autre_notebook.setToolTip(f"Copié : « {task.nom} »")
        QTimer.singleShot(1200, self._restaurer_icone_copier_autre_notebook)
        self._notify_status(f"Code de « {task.nom} » copié dans le presse-papier.")

    def _restaurer_icone_copier_autre_notebook(self):
        self.bouton_copier_autre_notebook.setIcon(qta.icon("mdi6.notebook-multiple", color=Mocha.subtext0))
        self.bouton_copier_autre_notebook.setToolTip(
            "Autres notebooks : clic gauche sur un nom = ouvrir, clic droit = copier son code"
        )

    # ------------------------------------------------------------------
    # Sauvegarde de la page HTML du navigateur (bouton de la toolbar,
    # cf. self.bouton_sauver_page_html)
    # ------------------------------------------------------------------
    def _dossier_sauvegarde_pages_html(self) -> Path:
        """Même dossier par défaut que CAA_Agent (DOSSIER_SAUVEGARDE vide)."""
        return Path.home() / "Downloads" / "saver_pages"

    def _ouvrir_dossier_sauvegarde_page_html(self):
        dossier = self._dossier_sauvegarde_pages_html()
        try:
            dossier.mkdir(parents=True, exist_ok=True)
        except OSError as exc:
            self._notify_status(f"Dossier de sauvegarde inaccessible : {exc}", error=True)
            return
        QDesktopServices.openUrl(QUrl.fromLocalFile(str(dossier)))

    def _brancher_resultats_sauvegarde_page_html(self, signal, client) -> None:
        """Branche UNE fois (par client) le handler de résultat sur le signal
        de résultat de commande du client réseau utilisé (serveurT ou local).
        Connexion en file d'attente : ces signaux sont émis depuis le thread
        réseau, le handler écrit un fichier et touche l'UI -- thread Qt."""
        if id(client) in self._clients_sauvegarde_page_html_branches:
            return
        signal.connect(self._sur_resultat_sauvegarde_page_html, Qt.QueuedConnection)
        self._clients_sauvegarde_page_html_branches.add(id(client))

    def _instance_locale_cible_page_html(self, task: Task) -> str:
        """Instance LOCALE visée par le bouton : 1) profil actif du panneau
        clone, 2) instance liée à un ServiceAPI importé du Task, 3) l'unique
        instance locale active s'il n'y en a qu'une. "" si aucune."""
        etat = self._executions_clone.get(task.id)
        if etat is not None and etat.profil_actif:
            nom_profil = _nom_depuis_cle_profil_clone(etat.profil_actif)
            instance_id = self._instance_id_par_profil_local.get(nom_profil, "")
            if instance_id:
                return instance_id
        for instance_id in (task.services_api_importes or {}).values():
            if instance_id:
                return instance_id
        instances = [i for i in self._instance_id_par_profil_local.values() if i]
        return instances[0] if len(set(instances)) == 1 else ""

    def _sur_clic_sauvegarder_page_html(self):
        """Demande le HTML (get_html) de l'onglet actif et l'enregistre à la
        réception de la réponse (cf. _sur_resultat_sauvegarde_page_html)."""
        task = self._task_courant_obj()
        if task is None or self._requetes_sauvegarde_page_html:
            return
        requete_id = uuid.uuid4().hex[:12]
        commande = {"action": "get_html", "selecteur": "", "cadre": ""}

        if task.mode_execution == "reseau":
            id_executant, instance_id = self._cible_rendu_reseau_actuelle()
            if not id_executant or not instance_id:
                self._notify_status(
                    "Choisissez d'abord un profil actif (Exécutions clone) pour sauvegarder sa page.", error=True
                )
                return
            if self._client_serveur_t is None:
                self._notify_status("Non connecté au serveurT -- sauvegarde impossible.", error=True)
                return
            self._brancher_resultats_sauvegarde_page_html(
                self._client_serveur_t.commande_controle_distance_resultat_recu, self._client_serveur_t,
            )
            self._requetes_sauvegarde_page_html[requete_id] = True
            self._client_serveur_t.envoyer_commande_instance(id_executant, instance_id, requete_id, commande)
        else:
            instance_id = self._instance_locale_cible_page_html(task)
            if not instance_id:
                self._notify_status(
                    "Aucune instance locale ciblée : choisissez un profil actif (Exécutions clone).", error=True
                )
                return
            client = self._client_reseau_execution
            if client is None:
                self._notify_status("Réseau local indisponible -- sauvegarde impossible.", error=True)
                return
            self._brancher_resultats_sauvegarde_page_html(client.command_result_recu, client)
            self._requetes_sauvegarde_page_html[requete_id] = True
            # link PUIS command, sur la même connexion (le serveur traite
            # dans l'ordre -- même patron que _envoyer_commande_liee). Pas
            # de "verrou" : simple lecture ponctuelle, ne doit rien bloquer.
            client.envoyer_commande({"type": "link", "pilote_id": client.id_client, "instance_id": instance_id})
            client.envoyer_commande({
                "type": "command", "instance_id": instance_id, "requete_id": requete_id, **commande,
            })

        self.bouton_sauver_page_html.setEnabled(False)
        self.bouton_sauver_page_html.setToolTip("Récupération de la page en cours…")
        QTimer.singleShot(30000, lambda rid=requete_id: self._expirer_sauvegarde_page_html(rid))

    def _terminer_sauvegarde_page_html(self, icone: str, couleur, infobulle_temporaire: str):
        self.bouton_sauver_page_html.setEnabled(True)
        self.bouton_sauver_page_html.setIcon(qta.icon(icone, color=couleur))
        self.bouton_sauver_page_html.setToolTip(infobulle_temporaire)
        QTimer.singleShot(1500, self._restaurer_icone_sauvegarde_page_html)

    def _restaurer_icone_sauvegarde_page_html(self):
        self.bouton_sauver_page_html.setIcon(qta.icon("mdi6.content-save-outline", color=Mocha.subtext0))
        self.bouton_sauver_page_html.setToolTip(
            "Sauvegarder la page HTML actuelle du navigateur (onglet actif du profil actif) "
            "et la copier dans le presse-papier\n"
            "Clic droit : ouvrir le dossier des sauvegardes"
        )

    def _expirer_sauvegarde_page_html(self, requete_id: str):
        if self._requetes_sauvegarde_page_html.pop(requete_id, None) is None:
            return  # déjà traitée
        self._notify_status("Sauvegarde de la page : aucune réponse du navigateur (délai dépassé).", error=True)
        self._terminer_sauvegarde_page_html("mdi6.alert-circle-outline", DarculaTheme.rouge, "Délai dépassé")

    def _sur_resultat_sauvegarde_page_html(self, data: dict):
        requete_id = data.get("requete_id")
        if self._requetes_sauvegarde_page_html.pop(requete_id, None) is None:
            return  # résultat d'une autre commande : ignoré
        if not data.get("ok", False):
            self._notify_status(f"Sauvegarde de la page impossible : {data.get('error', 'erreur inconnue')}", error=True)
            self._terminer_sauvegarde_page_html("mdi6.alert-circle-outline", DarculaTheme.rouge, "Échec")
            return
        html = data.get("result")
        if not isinstance(html, str) or not html.strip():
            self._notify_status("Sauvegarde de la page : le navigateur a renvoyé une page vide.", error=True)
            self._terminer_sauvegarde_page_html("mdi6.alert-circle-outline", DarculaTheme.rouge, "Page vide")
            return
        # AJOUT (demande explicite utilisateur : "quand on appuie sur le
        # bouton d'enregistrer le code de la page, ça copie directement dans
        # le presse-papier le code HTML sauvegardé") -- copié AVANT l'écriture
        # disque : même si l'écriture échoue, le HTML reste dans le presse-papier.
        QGuiApplication.clipboard().setText(html)
        try:
            dossier = self._dossier_sauvegarde_pages_html()
            dossier.mkdir(parents=True, exist_ok=True)
            chemin = dossier / f"{time.strftime('%Y%m%d_%H%M%S')}_page.html"
            chemin.write_text(html, encoding="utf-8")
        except OSError as exc:
            self._notify_status(f"Écriture de la page impossible : {exc} (HTML tout de même copié dans le presse-papier)", error=True)
            self._terminer_sauvegarde_page_html("mdi6.alert-circle-outline", DarculaTheme.rouge, "Échec d'écriture")
            return
        self._terminer_sauvegarde_page_html("mdi6.check", Mocha.green, "Page sauvegardée et copiée !")
        self._notify_status(f"Page HTML sauvegardée et copiée dans le presse-papier ({len(html)} caractères) : {chemin}")

    # ------------------------------------------------------------------
    # Capture propre affichée dans une visionneuse (bouton
    # self.bouton_capture_propre de la toolbar)
    # ------------------------------------------------------------------
    def _brancher_resultats_capture_propre(self, signal, client) -> None:
        """Branche UNE fois (par client) le handler de résultat -- même
        patron que _brancher_resultats_sauvegarde_page_html."""
        if id(client) in self._clients_capture_propre_branches:
            return
        signal.connect(self._sur_resultat_capture_propre, Qt.QueuedConnection)
        self._clients_capture_propre_branches.add(id(client))

    def _sur_clic_capture_propre_visionneuse(self):
        task = self._task_courant_obj()
        if task is None or self._requetes_capture_propre_visionneuse:
            return
        requete_id = uuid.uuid4().hex[:12]
        commande = {"action": "capture_propre"}

        if task.mode_execution == "reseau":
            id_executant, instance_id = self._cible_rendu_reseau_actuelle()
            if not id_executant or not instance_id:
                self._notify_status(
                    "Choisissez d'abord un profil actif (Exécutions clone) pour capturer son interface.", error=True
                )
                return
            if self._client_serveur_t is None:
                self._notify_status("Non connecté au serveurT -- capture impossible.", error=True)
                return
            self._brancher_resultats_capture_propre(
                self._client_serveur_t.commande_controle_distance_resultat_recu, self._client_serveur_t,
            )
            self._requetes_capture_propre_visionneuse[requete_id] = True
            self._client_serveur_t.envoyer_commande_instance(id_executant, instance_id, requete_id, commande)
        else:
            instance_id = self._instance_locale_cible_page_html(task)
            if not instance_id:
                self._notify_status(
                    "Aucune instance locale ciblée : choisissez un profil actif (Exécutions clone).", error=True
                )
                return
            client = self._client_reseau_execution
            if client is None:
                self._notify_status("Réseau local indisponible -- capture impossible.", error=True)
                return
            self._brancher_resultats_capture_propre(client.command_result_recu, client)
            self._requetes_capture_propre_visionneuse[requete_id] = True
            client.envoyer_commande({"type": "link", "pilote_id": client.id_client, "instance_id": instance_id})
            client.envoyer_commande({
                "type": "command", "instance_id": instance_id, "requete_id": requete_id, **commande,
            })

        self.bouton_capture_propre.setEnabled(False)
        self.bouton_capture_propre.setToolTip("Capture en cours…")
        # Marge large : l'image revient par la ligne du pilote (plusieurs Mo possibles).
        QTimer.singleShot(60000, lambda rid=requete_id: self._expirer_capture_propre(rid))

    def _terminer_capture_propre(self, icone: str, couleur, infobulle_temporaire: str):
        self.bouton_capture_propre.setEnabled(True)
        self.bouton_capture_propre.setIcon(qta.icon(icone, color=couleur))
        self.bouton_capture_propre.setToolTip(infobulle_temporaire)
        QTimer.singleShot(1500, self._restaurer_icone_capture_propre)

    def _restaurer_icone_capture_propre(self):
        self.bouton_capture_propre.setIcon(qta.icon("mdi6.camera-outline", color=Mocha.subtext0))
        self.bouton_capture_propre.setToolTip(
            "Capture propre de l'interface (onglet actif du profil actif), affichée dans une visionneuse "
            "et copiée dans le presse-papier"
        )

    def _expirer_capture_propre(self, requete_id: str):
        if self._requetes_capture_propre_visionneuse.pop(requete_id, None) is None:
            return  # déjà traitée
        self._notify_status("Capture propre : aucune réponse du navigateur (délai dépassé).", error=True)
        self._terminer_capture_propre("mdi6.alert-circle-outline", DarculaTheme.rouge, "Délai dépassé")

    def _sur_resultat_capture_propre(self, data: dict):
        requete_id = data.get("requete_id")
        if self._requetes_capture_propre_visionneuse.pop(requete_id, None) is None:
            return  # résultat d'une autre commande : ignoré
        if not data.get("ok", False):
            self._notify_status(f"Capture propre impossible : {data.get('error', 'erreur inconnue')}", error=True)
            self._terminer_capture_propre("mdi6.alert-circle-outline", DarculaTheme.rouge, "Échec")
            return
        resultat = data.get("result")
        image_b64 = resultat.get("image_b64") if isinstance(resultat, dict) else resultat
        pixmap = QPixmap()
        if isinstance(image_b64, str) and image_b64:
            try:
                if image_b64.startswith("data:"):
                    image_b64 = image_b64.split(",", 1)[1]
                pixmap.loadFromData(base64.b64decode(image_b64))
            except Exception:
                pixmap = QPixmap()
        if pixmap.isNull():
            self._notify_status("Capture propre : image vide ou illisible.", error=True)
            self._terminer_capture_propre("mdi6.alert-circle-outline", DarculaTheme.rouge, "Image illisible")
            return
        # AJOUT (demande explicite utilisateur : "même chose pour la capture
        # image") -- l'image est aussi copiée directement dans le presse-papier.
        QGuiApplication.clipboard().setPixmap(pixmap)
        titre = f"Capture propre -- {time.strftime('%H:%M:%S')}"
        vis = self._visionneuse_capture_propre
        if vis is not None:
            try:
                vis.definir_image(pixmap, titre)
            except RuntimeError:  # fenêtre déjà détruite (WA_DeleteOnClose)
                vis = None
        if vis is None:
            vis = VisionneuseCapturePropre(pixmap, titre, self)
            vis.setWindowFlag(Qt.Window, True)
            self._visionneuse_capture_propre = vis
        vis.show()
        vis.raise_()
        vis.activateWindow()
        self._terminer_capture_propre("mdi6.check", Mocha.green, "Capture affichée et copiée !")
        self._notify_status(f"Capture propre affichée et copiée dans le presse-papier ({pixmap.width()}x{pixmap.height()}).")

    # ------------------------------------------------------------------
    # Sauvegardes avant « mise à jour du notebook par collage » (PATCH -- demande explicite utilisateur : bouton
    # backup pour restaurer l'ancien, PUIS « oui » pour les garder sur disque). Un fichier JSON par sauvegarde dans
    # <dossier de données>/sauvegardes_notebooks/<id du Task>/, 20 au maximum par Task (les plus anciennes sont
    # supprimées). Survivent donc à la fermeture d'AutoniaX. Seuls titre/description/code sont sauvegardés (sorties
    # et statuts d'exécution ne sont jamais touchés).
    # ------------------------------------------------------------------
    _NB_MAX_SAUVEGARDES_MAJ_NOTEBOOK = 20

    @staticmethod
    def _dossier_sauvegardes_maj_notebook(task_id: str) -> Path:
        nom = re.sub(r'[\\/:*?"<>|]+', "_", str(task_id)) or "task"
        return get_app_data_dir() / "sauvegardes_notebooks" / nom

    def _pile_sauvegardes_maj_notebook(self, task) -> list:
        """Pile (la plus ancienne en premier) des sauvegardes du Task ; lue sur disque à la première utilisation."""
        if not hasattr(self, "_sauvegardes_maj_notebook"):
            self._sauvegardes_maj_notebook = {}
        pile = self._sauvegardes_maj_notebook.get(task.id)
        if pile is None:
            pile = []
            try:
                for f in sorted(self._dossier_sauvegardes_maj_notebook(task.id).glob("*.json")):
                    try:
                        snap = json.loads(f.read_text(encoding="utf-8"))
                        if isinstance(snap, dict) and isinstance(snap.get("cellules"), list):
                            snap["fichier"] = str(f)
                            pile.append(snap)
                    except (OSError, ValueError):
                        continue  # fichier illisible/corrompu : ignoré
            except OSError:
                pass
            self._sauvegardes_maj_notebook[task.id] = pile
        return pile

    def _empiler_sauvegarde_maj_notebook(self, task, libelle: str):
        var = task.cellule_variables
        snap = {
            "heure": time.strftime("%d/%m %H:%M:%S"),
            "libelle": libelle,
            "variables": [var.titre, var.description, var.code] if var is not None else None,
            "cellules": [[c.id, c.titre, c.description, c.code] for c in task.cellules],
        }
        pile = self._pile_sauvegardes_maj_notebook(task)
        try:
            dossier = self._dossier_sauvegardes_maj_notebook(task.id)
            dossier.mkdir(parents=True, exist_ok=True)
            fichier = dossier / f"{int(time.time() * 1000):016d}.json"
            fichier.write_text(json.dumps(snap, ensure_ascii=False), encoding="utf-8")
            snap["fichier"] = str(fichier)
        except OSError:
            pass  # disque indisponible : la sauvegarde reste au moins en mémoire pour cette session
        pile.append(snap)
        while len(pile) > self._NB_MAX_SAUVEGARDES_MAJ_NOTEBOOK:
            ancienne = pile.pop(0)
            try:
                if ancienne.get("fichier"):
                    Path(ancienne["fichier"]).unlink(missing_ok=True)
            except OSError:
                pass

    def _sur_clic_restaurer_maj_notebook(self):
        task = self._task_courant_obj()
        if task is None:
            return
        pile = list(self._pile_sauvegardes_maj_notebook(task))
        if not pile:
            self._notify_status("Aucune sauvegarde : aucune mise à jour du notebook n'a encore été faite pour ce Task.", error=True)
            return
        menu = QMenu(self.bouton_restaurer_maj_notebook)
        for snap in reversed(pile):  # la plus récente en premier
            nb = len(snap["cellules"]) + (1 if snap["variables"] is not None else 0)
            menu.addAction(
                qta.icon("mdi6.backup-restore", color=Mocha.lavender),
                f"{snap['heure']} — {snap['libelle']} ({nb} cellule(s))",
                lambda s_=snap: self._restaurer_sauvegarde_maj_notebook(task.id, s_),
            )
        menu.exec(self.bouton_restaurer_maj_notebook.mapToGlobal(QPoint(0, self.bouton_restaurer_maj_notebook.height())))

    def _restaurer_sauvegarde_maj_notebook(self, task_id: str, snap: dict):
        task = self._task_courant_obj()
        if task is None or task.id != task_id:
            return
        # L'état actuel est lui-même sauvegardé d'abord : la restauration est annulable (via ce même bouton).
        self._empiler_sauvegarde_maj_notebook(task, "avant restauration")
        if snap["variables"] is not None and task.cellule_variables is not None:
            task.cellule_variables.titre, task.cellule_variables.description, task.cellule_variables.code = snap["variables"]
        existantes = {c.id: c for c in task.cellules}
        restaurees = []
        for cid, titre, description, code in snap["cellules"]:
            cellule = existantes.get(cid)
            if cellule is None:  # supprimée depuis : recréée (même id)
                cellule = TaskCellule(id=cid, titre=titre, description=description, code=code)
            else:
                cellule.titre, cellule.description, cellule.code = titre, description, code
            restaurees.append(cellule)
        task.cellules[:] = restaurees  # les cellules AJOUTÉES par la mise à jour disparaissent
        self.project.save()
        self._ouvrir_task(task.id)
        self._notify_status(f"Notebook restauré (état de {snap['heure']}, {snap['libelle']}).")

    def _sur_coller_notebook(self, blocs: dict):
        """Callback de NotebookPasteHandleCompact (bouton "Coller" de la
        toolbar principale, cf. son site de construction) -- reçoit les
        blocs déjà PARSÉS par _parser_texte_notebook_colle ({rang: {titre,
        description, code}}) et les applique au Task actuellement ouvert :

        - rang 0 -> task.cellule_variables (titre/description/code écrasés
          EN PLACE, id inchangé -- décision explicite utilisateur : "je
          veux qu'on puisse modifier aussi le titre et description de
          chaque cellule").
        - rang 1..len(task.cellules) -> la cellule EXISTANTE à cette
          position (task.cellules[rang - 1]), mise à jour EN PLACE (id
          inchangé, donc sortie/statut/historique d'exécution déjà
          attachés à cette cellule survivent) -- correspondance par
          POSITION, jamais par id (cf. docstring NotebookPasteHandleCompact).
        - rang au-delà de len(task.cellules) -> nouvelle TaskCellule créée
          (nouvel id généré normalement) et ajoutée à LA FIN de task.
          cellules, DANS L'ORDRE croissant des rangs en trop (décision
          explicite utilisateur : "ajouter si il y en a plus" -- à la fin
          du notebook, dans l'ordre d'apparition du collage).

        Aucune cellule existante n'est jamais SUPPRIMÉE ici : un rang
        absent du collage (notebook partiellement copié, ou blocs retirés
        à la main) laisse simplement la cellule correspondante inchangée.

        Persistance + rafraîchissement : même pattern que
        _demande_nouvelle_version_task (self.project.save() puis
        self._ouvrir_task(task.id), qui reconstruit tous les
        TaskCelluleWidget à neuf depuis task -- pas de bricolage manuel du
        layout ici, cf. sa docstring)."""
        task = self._task_courant_obj()
        if task is None:
            return

        # PATCH (demande explicite utilisateur : bouton backup) : état AVANT mise à jour, restaurable via
        # bouton_restaurer_maj_notebook.
        self._empiler_sauvegarde_maj_notebook(task, "avant mise à jour")

        nb_cellules_maj = 0
        nb_cellules_ajoutees = 0

        if 0 in blocs and task.cellule_variables is not None:
            bloc_var = blocs.pop(0)
            task.cellule_variables.titre = bloc_var["titre"]
            task.cellule_variables.description = bloc_var["description"]
            task.cellule_variables.code = bloc_var["code"]
            nb_cellules_maj += 1
        else:
            blocs.pop(0, None)

        # Rangs restants, dans l'ordre croissant -- garantit que d'éventuels
        # rangs "en trop" sont ajoutés dans le même ordre que le collage,
        # peu importe l'ordre d'itération du dict (cf. docstring ci-dessus).
        for rang in sorted(blocs.keys()):
            bloc = blocs[rang]
            index_cellule = rang - 1  # rang 1-indexé -> index 0-indexé dans task.cellules
            if 0 <= index_cellule < len(task.cellules):
                cellule = task.cellules[index_cellule]
                cellule.titre = bloc["titre"]
                cellule.description = bloc["description"]
                cellule.code = bloc["code"]
                nb_cellules_maj += 1
            else:
                nouvelle = TaskCellule(titre=bloc["titre"], description=bloc["description"], code=bloc["code"])
                task.cellules.append(nouvelle)
                nb_cellules_ajoutees += 1

        self.project.save()
        self._ouvrir_task(task.id)

        if nb_cellules_ajoutees:
            self._notify_status(
                f"Notebook mis à jour : {nb_cellules_maj} cellule(s) mise(s) à jour, "
                f"{nb_cellules_ajoutees} cellule(s) ajoutée(s)."
            )
        else:
            self._notify_status(f"Notebook mis à jour : {nb_cellules_maj} cellule(s) mise(s) à jour.")

    def _demande_import_service_api(self):
        """SPEC_profils_environnements.md section 3.2 : EN MODE RÉSEAU
        uniquement, ne sert plus qu'à choisir QUEL ServiceAPI importer --
        la sélection d'instance a disparu (c'était l'ancien appel à
        _demande_selection_instance). Le ServiceAPI importé hérite
        immédiatement du profil actif courant s'il y en a un (etat.
        profil_actif), pour que l'utilisateur n'ait pas à recliquer la
        ligne de profil après un import.

        EN MODE LOCAL (hors-scope de cette spec, section 6/8 -- "ne
        concerne que le mode réseau", "comportement local inchangé à
        100%") : comportement historique conservé tel quel, dialogue de
        sélection d'instance ouvert immédiatement à l'import."""
        task = self._task_courant_obj()
        if task is None:
            return
        deja_importes = set(task.services_api_importes)
        disponibles = [s for s in self.project.services_api if s.nom not in deja_importes]
        if not disponibles:
            self._notify_status("Tous les ServiceAPI du Project sont déjà importés dans ce Task.", error=True)
            return

        menu = QMenu(self)
        for service_api in disponibles:
            action = menu.addAction(qta.icon("mdi6.folder-outline", color=Mocha.lavender), service_api.nom)
            action.setData(service_api.nom)
        chosen = menu.exec(self.panneau_composants.import_button.mapToGlobal(
            self.panneau_composants.import_button.rect().bottomRight()
        ))
        if chosen is None:
            return
        nom_service = chosen.data()

        if task.mode_execution != "reseau":
            # Comportement local historique inchangé (hors-scope de la
            # spec) : dialogue de sélection d'instance à l'import.
            instance_id = self._demande_selection_instance(titre=f"Instance pour « {nom_service} »", task=task)
            task.services_api_importes[nom_service] = instance_id or ""
            self.project.save()
            self.panneau_composants.rafraichir(task)
            self._rafraichir_composants_connus_editeur(task)
            self._rafraichir_variables_globales_editeur(task)
            carte = self._task_cartes.get(task.id)
            if carte is not None:
                carte.rafraichir(task)
            if instance_id:
                self._notify_status(f"ServiceAPI « {nom_service} » importé dans « {task.nom} », lié à l'instance « {instance_id} ».")
            else:
                self._notify_status(
                    f"ServiceAPI « {nom_service} » importé dans « {task.nom} » -- pas encore lié à une instance "
                    f"(cliquez sur son en-tête dans le panneau pour en choisir une plus tard)."
                )
            return

        # Section 3.2 (mode réseau) : importé avec instance_id == "" par
        # défaut, PUIS immédiatement réaffecté au profil actif courant
        # s'il y en a déjà un -- sinon l'utilisateur devrait re-
        # sélectionner la ligne de profil pour que ce nouveau ServiceAPI
        # soit lié.
        etat = self._executions_clone.get(task.id)
        profil_actif = etat.profil_actif if etat is not None else None
        task.services_api_importes[nom_service] = profil_actif or ""
        self.project.save()
        self.panneau_composants.rafraichir(task)
        self._rafraichir_composants_connus_editeur(task)
        self._rafraichir_variables_globales_editeur(task)
        if task.mode_execution == "reseau":
            self._rafraichir_visibilite_controles_reseau(task)
        carte = self._task_cartes.get(task.id)
        if carte is not None:
            carte.rafraichir(task)
        mot_cible = "profil" if task.mode_execution == "reseau" else "instance"
        if profil_actif:
            # CORRECTIF (audit clé composite) : profil_actif est ici
            # etat.profil_actif, donc une CLÉ COMPOSITE (id_executant::
            # nom_profil, cf. _cle_profil_clone) depuis la REFONTE MULTI-
            # SAUTONIAX -- l'afficher tel quel montrerait la clé technique
            # brute à l'utilisateur au lieu du nom de profil lisible.
            # _nom_depuis_cle_profil_clone extrait la partie affichable.
            self._notify_status(
                f"ServiceAPI « {nom_service} » importé dans « {task.nom} », lié au {mot_cible} "
                f"« {_nom_depuis_cle_profil_clone(profil_actif)} »."
            )
        else:
            self._notify_status(
                f"ServiceAPI « {nom_service} » importé dans « {task.nom} » -- pas encore lié à un {mot_cible} "
                f"(sélectionnez une ligne dans la liste de profils pour le lier)."
                if task.mode_execution == "reseau" else
                f"ServiceAPI « {nom_service} » importé dans « {task.nom} » -- pas encore lié à une instance."
            )

    def _demande_liaison_instance(self, nom_service: str):
        """SPEC_profils_environnements.md section 3.3 : en MODE RÉSEAU,
        ce handler ne peut plus jamais être déclenché -- EnteteServiceAPITask
        n'émet plus `clique` du tout quand mode_reseau=True (cf. son
        mousePressEvent), la liaison venant désormais exclusivement de
        la sélection de ligne dans la liste de profils (section 4.3,
        _sur_demande_definir_profil_actif). Gardé UNIQUEMENT pour le
        mode local (hors-scope de cette spec, section 6/8 -- comportement
        historique inchangé à 100%), câblé de façon défensive au même
        signal partagé PanneauComposantsImportesTask.demande_liaison_
        instance. Refuse le changement si une exécution de ce Task
        utilise déjà cette liaison (cf. self._instances_occupees_par_
        nos_tasks) -- changer l'instance d'un ServiceAPI en cours
        d'utilisation par une cellule qui tourne casserait le routage en
        plein vol."""
        task = self._task_courant_obj()
        if task is None or task.mode_execution == "reseau":
            return  # défensif -- ne devrait plus jamais arriver en réseau
        if nom_service not in task.services_api_importes:
            return

        ancienne_instance = task.services_api_importes.get(nom_service, "")
        if ancienne_instance:
            occupation = self._instances_occupees_par_nos_tasks.get(ancienne_instance)
            if occupation is not None and occupation[0] == task.id:
                self._notify_status(
                    f"« {nom_service} » est en cours d'utilisation par une cellule en exécution -- "
                    f"attendez la fin avant de changer son instance.",
                    error=True,
                )
                return

        instance_id = self._demande_selection_instance(titre=f"Instance pour « {nom_service} »", task=task)
        if instance_id is None:
            return  # annulé, ou aucune instance disponible -- rien ne change

        task.services_api_importes[nom_service] = instance_id
        self.project.save()
        self.panneau_composants.rafraichir(task)
        self._notify_status(f"« {nom_service} » maintenant lié à l'instance « {instance_id} ».")

    def _demande_retrait_service_api(self, nom_service: str):
        """Clic sur le bouton poubelle de l'en-tête d'un groupe ServiceAPI
        (cf. EnteteServiceAPITask.demande_retrait) : désimporte entièrement
        ce ServiceAPI de ce Task -- jusqu'ici manquant, un ServiceAPI
        importé par erreur ne pouvait plus être retiré une fois l'import
        fait (cf. _demande_import_service_api, qui ne permettait que
        d'AJOUTER).

        Ne supprime QUE la liaison Task.services_api_importes[nom_service]
        (et donc l'affichage groupé de ses composants dans ce Task) --
        NE TOUCHE JAMAIS au ServiceAPI ni à ses composants dans le Project
        (cf. ServiceAPIScreen._confirm_delete_composant pour ça, fonction
        séparée et volontairement distincte : retirer un IMPORT d'un Task
        est une opération locale à ce Task, pas une suppression globale).

        Section 3.4 (spec) : inchangée -- retirer un ServiceAPI du Task
        reste une action indépendante de la notion de profil actif,
        même garde d'occupation qu'avant :refuse le retrait si une
        exécution de ce Task utilise actuellement cette liaison (cf.
        self._instances_occupees_par_nos_tasks) -- retirer un ServiceAPI
        dont une cellule se sert en plein vol casserait son exécution en
        cours plutôt que de simplement échouer proprement au prochain
        lancement.

        Ne vérifie PAS si du code de cellule référence encore ce
        ServiceAPI (cf. nom_variable_python/_REGEX_AFFECTATION_INSTANCE) --
        cohérent avec le reste de l'éditeur, qui ne bloque jamais une
        action sur la base d'une analyse statique du code des cellules
        (cf. suppression d'un Task entier, possible même si son code est
        actuellement invalide) ; une cellule qui référence encore le nom
        après retrait échouera simplement à l'exécution avec un NameError
        normal, visible dans sa sortie."""
        task = self._task_courant_obj()
        if task is None:
            return
        if nom_service not in task.services_api_importes:
            return

        instance_liee = task.services_api_importes.get(nom_service, "")
        if instance_liee:
            occupation = self._instances_occupees_par_nos_tasks.get(instance_liee)
            if occupation is not None and occupation[0] == task.id:
                self._notify_status(
                    f"« {nom_service} » est en cours d'utilisation par une cellule en exécution -- "
                    f"attendez la fin avant de le retirer.",
                    error=True,
                )
                return

        # Patch demandé par l'utilisateur : plus de boîte de confirmation
        # ici -- le retrait d'un ServiceAPI importé dans un Task est
        # maintenant immédiat (le ServiceAPI et ses composants restent
        # de toute façon intacts dans le Project, réimportable via « + »).
        del task.services_api_importes[nom_service]
        self.project.save()
        self.panneau_composants.rafraichir(task)
        self._rafraichir_composants_connus_editeur(task)
        self._rafraichir_variables_globales_editeur(task)
        # La liste de profils reste visible en permanence en mode réseau
        # désormais (section 4.1) -- ce rafraîchissement n'a plus à s'en
        # soucier, il ne fait plus que garder groupe_controles_reseau/
        # label_statut_reseau à jour comme avant.
        if task.mode_execution == "reseau":
            self._rafraichir_visibilite_controles_reseau(task)
        carte = self._task_cartes.get(task.id)
        if carte is not None:
            carte.rafraichir(task)
        self._notify_status(f"« {nom_service} » retiré de « {task.nom} ».")

    def _demande_selection_instance(self, titre: str, task: Optional[Task] = None) -> Optional[str]:
        """Ouvre un menu de sélection de cible pour un ServiceAPI importé.

        BIFURCATION (fusion de l'ancien écran "Notebook Distant" séparé,
        cf. Task.mode_execution) : si `task` est fourni et en mode
        "reseau", délègue entièrement à _demande_selection_executant_reseau
        (liste des sAutoniax connus, cf. definir_executants_reseau_connus)
        -- comportement historique "local" ci-dessous entièrement inchangé
        sinon (task est optionnel, avec défaut None, précisément pour ne
        RIEN changer aux appels existants qui ne le passaient pas encore).

        Menu listant les instances nodriver connues (cf. discussion
        "screen"), avec leur statut : une instance déjà occupée (par un
        AUTRE pilote côté serveur -- champ "libre", cf.
        srv_liste_instances_message -- OU par un de NOS PROPRES Tasks déjà
        en cours d'exécution, cf. self._instances_occupees_par_nos_tasks)
        est affichée mais DÉSACTIVÉE (grisée), jamais sélectionnable --
        décision explicite utilisateur : "sa refuse, cest gris, impossible,
        jusqua ce que la tache soit tuer". Retourne l'instance_id choisi,
        ou None si annulé/aucune instance disponible.

        Demande explicitement une liste fraîche au serveur avant d'ouvrir
        le menu (cf. _demander_liste_instances_fraiche) -- pas de flux
        continu (décision utilisateur), donc self._instances_actives peut
        être périmée sans ce rafraîchissement ponctuel. Reste du best-effort
        (asynchrone) : si la réponse n'arrive pas avant l'ouverture du menu
        (latence réseau), le menu utilise la dernière liste connue plutôt
        que d'attendre indéfiniment -- rafraîchir juste après reste
        possible en rouvrant le menu."""
        if task is not None and task.mode_execution == "reseau":
            return self._demande_selection_executant_reseau(titre)

        self._demander_liste_instances_fraiche()

        if not self._instances_actives:
            self._notify_status(
                "Aucune instance connue du serveur pour l'instant -- vous pourrez en lier une plus tard.",
            )
            return None

        menu = QMenu(self)
        menu.setTitle(titre)
        au_moins_une_activable = False
        for info in self._instances_actives:
            instance_id = info.get("id", "")
            libre_cote_serveur = bool(info.get("libre", False))
            occupation_locale = self._instances_occupees_par_nos_tasks.get(instance_id)

            if occupation_locale is not None:
                _task_id, task_nom, _cellule_id = occupation_locale
                libelle = f"{instance_id} — occupée (Task « {task_nom} » en cours)"
                activable = False
            elif not libre_cote_serveur:
                libelle = f"{instance_id} — occupée (autre pilote)"
                activable = False
            else:
                libelle = f"{instance_id} — libre"
                activable = True

            action = menu.addAction(libelle)
            action.setData(instance_id)
            action.setEnabled(activable)
            au_moins_une_activable = au_moins_une_activable or activable

        if not au_moins_une_activable:
            self._notify_status(
                "Toutes les instances connues sont actuellement occupées.", error=True,
            )
            # Affiché quand même (menu.exec ci-dessous) pour que
            # l'utilisateur VOIE l'état actuel avant de renoncer --
            # décision cohérente avec "affiche d'abord son statut" --
            # mais chosen sera nécessairement None (aucune action activée
            # n'est sélectionnable par un clic).

        chosen = menu.exec(QCursor.pos())
        if chosen is None:
            return None
        return chosen.data()

    def _demande_selection_executant_reseau(self, titre: str) -> Optional[str]:
        """CORRECTIF (retour explicite utilisateur -- "je sélectionne le
        sAutoniax dans le paramètre en haut, et au moment de lier un
        ServiceAPI, c'est les profils qui doivent être affichés, pas les
        sAutoniax") : liste les PROFILS présents sur un sAutoniax (même
        source que le défunt bouton_profils_cloud, cf. self.
        _profils_locaux_par_executant, alimenté par demander_liste_
        profils_locaux_sautoniax/sur_resultat_liste_profils_locaux_
        sautoniax). Retourne un NOM DE PROFIL (ex. "xian1"), pas un
        id_executant -- cf. docstring de Task.services_api_importes.

        PATCH (retrait de combo_executant_reseau, demande explicite
        utilisateur -- ce combo ne pilotait de toute façon pas le
        profil actif) : le sAutoniax cible n'est plus "déjà choisi en
        haut" -- résolu ici en deux temps : (1) si un profil est déjà
        ACTIF pour ce Task (panneau Exécutions clone), on prend
        directement SON sAutoniax (cas le plus courant : l'utilisateur
        a déjà cliqué une ligne avant de lier un ServiceAPI) ; (2) sinon,
        un premier menu demande explicitement de choisir parmi les
        sAutoniax connus (self._noms_executants_reseau), puisqu'il n'y a
        plus d'autre source pour cette information.

        Redemande une liste fraîche à chaque ouverture (même patron que
        l'ancien _peupler_menu_profils_cloud, cf. sa docstring -- un
        profil créé après la dernière réponse reçue pour ce sAutoniax ne
        doit pas manquer indéfiniment) : le menu s'ouvre immédiatement
        avec le cache actuel (jamais vide le temps de l'aller-retour
        réseau), la fraîcheur ne change que pour la PROCHAINE ouverture.

        CORRECTIF (retour explicite utilisateur -- "lorsque je clic pour
        une premiere fois et que sa affiche actualise... je suis obliger
        de recliquey pour voir") : au tout premier clic pour un
        id_executant donné (cache encore vide, jamais interrogé avant),
        le menu s'ouvrait sur "(actualisation...)" et restait figé là --
        menu.exec() ci-dessous est BLOQUANT, et la réponse réseau
        demandée juste au-dessus n'arrive qu'APRÈS l'ouverture du menu,
        donc rien ne le repeuplait tant qu'il restait ouvert (il fallait
        fermer et rouvrir pour qu'au second passage le cache soit déjà
        rempli). self._menu_liaison_reseau_ouvert = (id_executant, menu)
        expose désormais ce menu encore ouvert à sur_resultat_liste_
        profils_locaux_sautoniax, qui le repeuple EN PLACE dès que la
        réponse arrive pour ce même id_executant -- même pattern que
        l'ancien _peupler_menu_profils_cloud (cf. son ex-docstring)."""
        task = self._task_courant_obj()
        id_executant = self._id_executant_profil_actif(task) if task is not None else ""
        if not id_executant:
            id_executant = self._demande_choix_sautoniax_pour_liaison(titre)
        if not id_executant:
            self._notify_status(
                "Aucun sAutoniax choisi -- sélectionnez d'abord un profil actif "
                "(Exécutions clone) ou un sAutoniax dans la liste.",
            )
            return None

        self._demander_liste_profils_cloud()
        profils_connus = self._profils_locaux_par_executant.get(id_executant) or []

        menu = QMenu(self)
        menu.setTitle(titre)
        self._peupler_menu_liaison_reseau(menu, id_executant, profils_connus)
        self._menu_liaison_reseau_ouvert = (id_executant, menu)
        try:
            chosen = menu.exec(QCursor.pos())
        finally:
            self._menu_liaison_reseau_ouvert = None
        if chosen is None:
            return None
        return chosen.data()

    def _demande_choix_sautoniax_pour_liaison(self, titre: str) -> Optional[str]:
        """PATCH (retrait de combo_executant_reseau) -- appelée par
        _demande_selection_executant_reseau UNIQUEMENT quand aucun
        profil n'est actif pour ce Task (donc aucun sAutoniax n'est
        déjà implicite) : premier menu, simple, listant les sAutoniax
        actuellement connus (self._noms_executants_reseau) pour que
        l'utilisateur en choisisse un explicitement avant de voir ses
        profils. Retourne l'id_executant choisi, ou None si annulé/
        aucun sAutoniax connu."""
        if not self._noms_executants_reseau:
            self._notify_status("Aucun sAutoniax connecté.", error=True)
            return None
        menu = QMenu(self)
        menu.setTitle(titre)
        for id_executant, nom in sorted(self._noms_executants_reseau.items(), key=lambda kv: kv[1]):
            action = menu.addAction(nom)
            action.setData(id_executant)
        chosen = menu.exec(QCursor.pos())
        if chosen is None:
            return None
        return chosen.data()

    def _peupler_menu_liaison_reseau(self, menu: QMenu, id_executant: str, profils_connus: list):
        """Remplit (ou vide puis remplit) `menu` avec les profils connus
        pour `id_executant` -- factorisé pour être appelé aussi bien à
        l'ouverture initiale (_demande_selection_executant_reseau)
        qu'au repeuplement en place d'un menu déjà ouvert (cf.
        sur_resultat_liste_profils_locaux_sautoniax, docstring de
        _demande_selection_executant_reseau ci-dessus)."""
        menu.clear()
        if not profils_connus:
            action_vide = menu.addAction(
                "(actualisation...)" if self._profils_locaux_par_executant.get(id_executant) is None
                else "(aucun profil local trouvé sur ce sAutoniax)"
            )
            action_vide.setEnabled(False)
        else:
            for nom_profil in sorted(profils_connus):
                action = menu.addAction(nom_profil)
                action.setData(nom_profil)

    def _sur_composant_copie(self, nom_variable: str):
        self._notify_status(f"« {nom_variable} » copié dans le presse-papier.")

    def _show_task_menu(self):
        menu = QMenu(self)
        export_action = menu.addAction(qta.icon("mdi6.download-outline", color=Mocha.subtext0), "Télécharger le notebook")
        # PATCH (demande explicite utilisateur -- "importer doit etre au
        # niveau de la page daccueil de task... a la place la [dans
        # l'éditeur] sa doit etre update... on importe en ecrassant
        # directement") : "Importer un notebook" retiré d'ici -- créer un
        # NOUVEAU Task depuis un fichier reste réservé au bouton flottant
        # de la grille (cf. _build_grille/_demande_import_task), seul
        # endroit cohérent pour une action qui ajoute un Task au Project.
        # Cet éditeur affiche déjà UN Task précis ouvert : l'action utile
        # ici est de le REMPLACER par le contenu d'un fichier .autoniaxtask
        # (même id, même position dans la liste), pas d'en ouvrir un
        # troisième sans rapport -- cf. _demande_update_task.
        update_action = menu.addAction(qta.icon("mdi6.upload-outline", color=Mocha.subtext0), "Mettre à jour le notebook")
        # PATCH (cf. _demande_nouvelle_version_task, système de versions
        # façon "github v1/v2/v3...") : entrée de menu manquante pour
        # ouvrir _afficher_historique_versions, qui existait déjà mais
        # n'était appelée nulle part -- sans ça, impossible de naviguer
        # entre les versions archivées depuis l'interface.
        historique_action = menu.addAction(qta.icon("mdi6.history", color=Mocha.subtext0), "Historique des versions")
        delete_action = menu.addAction(qta.icon("mdi6.trash-can-outline", color=Mocha.red), "Supprimer le Task")
        chosen = menu.exec(self.menu_task_button.mapToGlobal(self.menu_task_button.rect().bottomRight()))
        if chosen == export_action:
            self._demande_export_task()
        elif chosen == update_action:
            # RENOMMÉ : _demande_update_task -> _demande_nouvelle_version_task
            # (cf. plus haut -- l'update n'écrase plus, elle archive l'état
            # courant dans task.versions avant d'importer le nouveau contenu).
            self._demande_nouvelle_version_task()
        elif chosen == historique_action:
            self._afficher_historique_versions()
        elif chosen == delete_action:
            self._confirm_delete_task()

    def _demande_export_task(self):
        """PATCH demandé par l'utilisateur : "telechagrez un notebook" --
        écrit le Task actuellement ouvert dans un fichier .autoniaxtask
        (cf. exporter_task_vers_json/EXTENSION_FICHIER_TASK).

        RÉVISION (décision explicite utilisateur) : plus de QFileDialog --
        écriture DIRECTE dans le dossier Téléchargements de l'utilisateur
        (cf. get_downloads_dir), sous <nom_task>.autoniaxtask, ÉCRASÉ sans
        confirmation si déjà présent (comportement voulu : retélécharger
        le même Task remplace la version précédente, pas d'accumulation
        de "(1)", "(2)", ... comme le ferait un navigateur). Nom de
        fichier assaini (mêmes caractères interdits Windows/Unix
        qu'ailleurs dans ce fichier)."""
        task = self._task_courant_obj()
        if task is None:
            return
        nom_suggere = re.sub(r'[<>:"/\\|?*]', "_", task.nom).strip() or "task"
        chemin = get_downloads_dir() / f"{nom_suggere}{EXTENSION_FICHIER_TASK}"
        try:
            with open(chemin, "w", encoding="utf-8") as f:
                json.dump(exporter_task_vers_json(task), f, ensure_ascii=False, indent=2)
        except OSError as e:
            BoiteDialogueAutoniaX.critical(self, "Échec du téléchargement", f"Impossible d'écrire le fichier :\n{e}")
            return
        self._notify_status(f"Task « {task.nom} » téléchargé dans {chemin}.")

    def _demande_import_task(self):
        """PATCH demandé par l'utilisateur : "que on puisse importer un
        notebook" -- lit un fichier .autoniaxtask choisi par l'utilisateur
        et ajoute le Task reconstruit au Project courant (cf.
        importer_task_depuis_json). Point d'entrée : bouton dédié dans la
        grille (cf. _build_grille) -- import crée toujours un NOUVEAU
        Task, contrairement à l'export qui agit sur le Task actuellement
        ouvert, donc pas besoin d'être dans l'éditeur pour importer.

        PATCH (point 3 -- retour utilisateur : "il faut mettre le
        chargement de l'ouverture d'un fichier dans un worker", "perd
        souvent le temps et fait freeze l'app") -- SEUL le choix du
        fichier (BoiteDialogueAutoniaX.ouvrir_fichier, déjà une boîte de
        dialogue Qt asynchrone de son côté) reste ici sur le thread UI.
        La lecture disque + le parsing JSON + importer_task_depuis_json
        (potentiellement lourd) sont délégués à ImportTaskWorker dans un
        QThread séparé, même patron que CopieLogsWorker/
        TailleDossierWorker (cf. leur docstring de classe) : moveToThread
        + started.connect(demarrer) + thread.start(). La barre UNIQUE
        (OverlayChargementTask, déterminée) est affichée pendant ce
        temps et avance à chaque phase du worker -- la finalisation (suffixe
        anti-collision, ajout au Project, save(), _reload_grille(),
        ouverture) a lieu dans _sur_import_task_termine, appelée par
        ImportTaskWorker.termine."""
        chemin, _ = BoiteDialogueAutoniaX.ouvrir_fichier(
            self, "Importer un notebook", "",
            f"Notebook AutoniaX (*{EXTENSION_FICHIER_TASK});;Tous les fichiers (*)",
        )
        if not chemin:
            return
        if self._thread_import_task is not None:
            # Garde-fou (import déjà en cours, ex. double-clic pendant le
            # parsing d'un gros fichier) : on ignore ce second lancement
            # plutôt que d'écraser les références du worker/thread en
            # cours, ce qui le laisserait orphelin (cf. docstring
            # _thread_import_task).
            self._notify_status("Un import est déjà en cours, veuillez patienter.")
            return

        noms_disponibles = {s.nom for s in self.project.services_api}
        self._demarrer_barre_import("Import du notebook…")
        self._thread_import_task = QThread(self)
        # PATCH (freeze à l'ouverture d'un .autoniaxtask volumineux, cf.
        # docstring de _precalculer_editeur_pour_task/ImportTaskWorker) :
        # self.project transmis au worker (lu UNIQUEMENT depuis ce
        # thread -- jamais modifié) pour que le précalcul de l'éditeur
        # (noms connus + variables globales) tourne pendant l'import,
        # plutôt qu'après coup sur le thread UI.
        self._worker_import_task = ImportTaskWorker(chemin, noms_disponibles, self.project)
        self._worker_import_task.moveToThread(self._thread_import_task)
        self._connecter_worker_import(self._worker_import_task)
        self._worker_import_task.termine.connect(self._sur_import_task_termine)
        self._thread_import_task.started.connect(self._worker_import_task.demarrer)
        self._thread_import_task.start()

    def _sur_import_task_termine(self, ok: bool, task: Optional["Task"], avertissements: list, erreur: str, precalcul_editeur: dict):
        """Callback d'ImportTaskWorker.termine (cf. _demande_import_task)
        -- même nettoyage de thread que _sur_logs_serveur_recus
        (quit/wait avant de relâcher les références, pour ne jamais
        laisser de QThread orphelin), puis reprend exactement la
        finalisation qui suivait l'ancien bloc bloquant : suffixe
        anti-collision, ajout au Project, sauvegarde, rechargement de
        la grille, avertissements éventuels, ouverture du Task importé.

        PATCH (freeze à l'ouverture d'un .autoniaxtask volumineux, cf.
        docstring de _precalculer_editeur_pour_task) : `precalcul_
        editeur` (dict, potentiellement vide si le précalcul a
        échoué côté worker ou si ok=False) est transmis tel quel à
        _ouvrir_task, qui le fait suivre à _rafraichir_composants_
        connus_editeur/_rafraichir_variables_globales_editeur pour
        leur éviter de reparcourir tout le notebook qu'on vient
        d'ouvrir -- un dict vide y est traité exactement comme None
        (cf. leur garde `is not None`), donc AUCUN risque de crash ou
        de comportement différent si le précalcul a échoué : on
        retombe alors simplement sur l'ancien recalcul synchrone."""
        self._thread_import_task.quit()
        self._thread_import_task.wait()
        self._thread_import_task = None
        self._worker_import_task = None

        if not ok:
            self._abandonner_barre_import()
            BoiteDialogueAutoniaX.critical(self, "Échec de l'import", erreur)
            return

        # Même logique de suffixe anti-collision que _creer_task -- le nom
        # importé peut déjà exister dans CE Project (import d'un notebook
        # déjà exporté depuis ici, ou nom identique par coïncidence).
        noms_existants = {t.nom for t in self.project.tasks}
        if task.nom in noms_existants:
            base = task.nom
            i = 1
            candidat = f"{base} (importé)"
            while candidat in noms_existants:
                i += 1
                candidat = f"{base} (importé {i})"
            task.nom = candidat

        self.project.tasks.append(task)
        self._planifier_sauvegarde_projet_differee()
        self._reload_grille()

        if avertissements:
            BoiteDialogueAutoniaX.warning(
                self, "Notebook importé avec avertissements",
                f"Task « {task.nom} » importé, avec {len(avertissements)} avertissement(s) :\n\n"
                + "\n".join(f"• {a}" for a in avertissements),
            )
        self._notify_status(f"Task « {task.nom} » importé.")
        self._ouvrir_task(task.id, precalcul_editeur or None)

    def _prochain_numero_version(self, task: "Task") -> int:
        """Numéro à attribuer à la PROCHAINE version archivée de ce Task
        -- max des numéros déjà présents + 1, jamais un simple len(versions)
        + 1 (cf. docstring Task.versions : les numéros restent stables même
        si d'anciennes versions sont un jour purgées, donc ne peuvent pas
        se déduire uniquement du compte actuel d'entrées)."""
        if not task.versions:
            return 1
        return max(v["numero"] for v in task.versions) + 1

    def _demande_nouvelle_version_task(self):
        """PATCH (demande explicite utilisateur -- "au lieu de mettre mise
        a jour qui vas ecraser tout ce qui existe, es ce que on peu faire
        a ce que sa cree une nouvelle version, un peu comme github, je veux
        que il ya la version 1, 2, 3... au fur a mesure que on met a jour
        sa vas conserver les precedent, on peut facilement naviguer entre
        les versions") : lit un fichier .autoniaxtask et applique son
        contenu au Task actuellement ouvert, mais ARCHIVE D'ABORD l'état
        actuel du Task (cellules, cellule_variables, services_api_importes)
        comme une nouvelle entrée numérotée dans task.versions -- rien
        n'est donc jamais perdu, contrairement à l'ancien comportement
        "Mettre à jour" qui écrasait directement.

        id et nom du Task restent inchangés (comme l'ancien "Mettre à
        jour") : une nouvelle version reste le MÊME Task, pas un doublon
        -- seul le CONTENU courant change, l'historique s'allonge.

        Symétrique du bouton flottant "Importer un notebook" de la grille
        (cf. _demande_import_task), qui reste la seule façon de créer un
        Task entièrement SÉPARÉ depuis un fichier.

        PATCH (point 3, même raison/même patron qu'_demande_import_task,
        cf. sa docstring et celle d'ImportTaskWorker) : la lecture disque
        + le parsing JSON + importer_task_depuis_json sont délégués à
        ImportTaskWorker dans un QThread séparé -- seul le choix du
        fichier reste ici. task_actuel et chemin sont conservés le temps
        du worker (self._nouvelle_version_task_actuel/_chemin) pour que
        _sur_nouvelle_version_task_termine, qui fait le reste (dialogue
        de confirmation, archivage, application, sauvegarde), puisse les
        retrouver -- cf. cette méthode pour le détail non modifié de
        cette suite."""
        task_actuel = self._task_courant_obj()
        if task_actuel is None:
            return

        chemin, _ = BoiteDialogueAutoniaX.ouvrir_fichier(
            self, "Importer une nouvelle version", "",
            f"Notebook AutoniaX (*{EXTENSION_FICHIER_TASK});;Tous les fichiers (*)",
        )
        if not chemin:
            return
        if self._thread_import_task is not None:
            # Même garde-fou qu'_demande_import_task (cf. sa docstring) --
            # les deux points d'entrée partagent le même thread/worker
            # ImportTaskWorker, un seul à la fois.
            self._notify_status("Un import est déjà en cours, veuillez patienter.")
            return

        noms_disponibles = {s.nom for s in self.project.services_api}
        self._nouvelle_version_task_actuel = task_actuel
        self._nouvelle_version_chemin = chemin
        self._demarrer_barre_import("Import de la nouvelle version…")
        self._thread_import_task = QThread(self)
        # PATCH (freeze à l'ouverture d'un .autoniaxtask volumineux, cf.
        # docstring de _precalculer_editeur_pour_task/ImportTaskWorker,
        # même raison qu'_demande_import_task ci-dessus) : self.project
        # transmis au worker pour le précalcul de l'éditeur.
        self._worker_import_task = ImportTaskWorker(chemin, noms_disponibles, self.project)
        self._worker_import_task.moveToThread(self._thread_import_task)
        self._connecter_worker_import(self._worker_import_task)
        self._worker_import_task.termine.connect(self._sur_nouvelle_version_task_termine)
        self._thread_import_task.started.connect(self._worker_import_task.demarrer)
        self._thread_import_task.start()

    def _sur_nouvelle_version_task_termine(self, ok: bool, task_importe: Optional["Task"], avertissements: list, erreur: str, precalcul_editeur: dict):
        """Callback d'ImportTaskWorker.termine pour _demande_nouvelle_
        version_task (cf. sa docstring) -- même nettoyage de thread que
        _sur_import_task_termine/_sur_logs_serveur_recus, puis reprend
        exactement la suite qui suivait l'ancien bloc bloquant : dialogue
        de confirmation (numero_nouvelle_version calculé depuis
        task_actuel, indépendant du parsing -- inchangé), archivage de
        l'état actuel, application du contenu importé, sauvegarde.

        PATCH (freeze à l'ouverture d'un .autoniaxtask volumineux, cf.
        docstring de _precalculer_editeur_pour_task) : `precalcul_
        editeur` a été calculé côté worker à partir de task_importe --
        reste valide même si son CONTENU (cellules/cellule_variables/
        services_api_importes) est ensuite copié EN PLACE sur
        task_actuel plutôt que sur task_importe lui-même (cf. plus bas) :
        le précalcul ne dépend que de ce contenu, jamais de l'identité
        de l'objet Task, donc transmis tel quel à _ouvrir_task(task_
        actuel.id, ...) en fin de méthode."""
        self._thread_import_task.quit()
        self._thread_import_task.wait()
        self._thread_import_task = None
        self._worker_import_task = None

        task_actuel = self._nouvelle_version_task_actuel
        chemin = self._nouvelle_version_chemin
        self._nouvelle_version_task_actuel = None
        self._nouvelle_version_chemin = None

        if not ok:
            self._abandonner_barre_import()
            BoiteDialogueAutoniaX.critical(self, "Échec de l'import", erreur)
            return

        # Dialogue de confirmation modal à venir : la barre serait masquée
        # par lui de toute façon, et l'utilisateur doit pouvoir lire la
        # question -- on la retire pendant qu'il décide.
        self.overlay_chargement_task.hide()
        numero_nouvelle_version = self._prochain_numero_version(task_actuel)
        confirme = BoiteDialogueAutoniaX.question(
            self, "Importer une nouvelle version",
            f"Créer la version {numero_nouvelle_version} de « {task_actuel.nom} » à partir de "
            f"« {os.path.basename(chemin)} » ?\n\n"
            "Le contenu actuel sera conservé dans l'historique des versions -- "
            "rien n'est perdu, vous pourrez y revenir à tout moment.",
        )
        if not confirme:
            return

        # Archive l'état ACTUEL (avant remplacement) -- même forme que
        # Task.to_dict(), moins id/nom/versions (cf. docstring du champ) :
        # une version figée n'a pas besoin de son propre id/nom, elle
        # appartient au Task courant.
        instantane = {
            "numero": numero_nouvelle_version,
            "date": datetime.now().isoformat(),
            # PATCH anti-gel : la sortie des cellules n'est PAS archivée (elle peut
            # peser des Mo et gonflait project.json à chaque mise à jour).
            "cellules": [{**c.to_dict(), "sortie": ""} for c in task_actuel.cellules],
            "services_api_importes": dict(task_actuel.services_api_importes),
            "cellule_variables": {**task_actuel.cellule_variables.to_dict(), "sortie": ""},
        }
        task_actuel.versions.append(instantane)

        # Applique le contenu importé PAR-DESSUS task_actuel EN PLACE
        # (plutôt que de remplacer l'objet entier dans self.project.tasks,
        # cf. l'ancien _demande_update_task) : task_actuel.versions, déjà
        # mis à jour juste au-dessus, doit survivre à cette étape -- écrire
        # task_importe directement à la place de task_actuel écraserait
        # sinon l'historique qu'on vient tout juste d'archiver.
        task_actuel.cellules = task_importe.cellules
        task_actuel.services_api_importes = task_importe.services_api_importes
        task_actuel.cellule_variables = task_importe.cellule_variables
        task_actuel.date_derniere_ouverture = datetime.now().isoformat()

        self._planifier_sauvegarde_projet_differee()
        self._reload_grille()

        if avertissements:
            BoiteDialogueAutoniaX.warning(
                self, "Nouvelle version importée avec avertissements",
                f"Version {numero_nouvelle_version} de « {task_actuel.nom} » créée, "
                f"avec {len(avertissements)} avertissement(s) :\n\n"
                + "\n".join(f"• {a}" for a in avertissements),
            )
        self._notify_status(
            f"Version {numero_nouvelle_version} de « {task_actuel.nom} » créée depuis {os.path.basename(chemin)}."
        )
        self._ouvrir_task(task_actuel.id, precalcul_editeur or None)

    def _afficher_historique_versions(self):
        """PATCH (cf. _demande_nouvelle_version_task, "naviguer entre les
        versions") : liste toutes les versions archivées du Task ouvert
        (la plus récente en premier) + une entrée "Version actuelle",
        dans une boîte de dialogue simple -- sélectionner une ancienne
        version propose de la restaurer (cf. _restaurer_version), qui
        archive elle-même l'état courant avant de restaurer (jamais de
        perte : restaurer une vieille version crée à son tour une nouvelle
        entrée d'historique pour l'état qu'on quitte)."""
        task = self._task_courant_obj()
        if task is None:
            return

        if not task.versions:
            BoiteDialogueAutoniaX.information(
                self, "Historique des versions",
                f"« {task.nom} » n'a pas encore de version archivée -- "
                "l'historique se remplit à chaque import d'une nouvelle version "
                "(menu ⋮ -> « Mettre à jour le notebook »).",
            )
            return

        dialogue = DialogueAutoniaXBase(f"Historique des versions -- {task.nom}", self, largeur_min=420)

        liste = QListWidget(dialogue.zone_contenu)
        numero_courant = self._prochain_numero_version(task)
        item_actuel = QListWidgetItem(f"Version {numero_courant} (actuelle)")
        item_actuel.setData(Qt.UserRole, None)  # None = version actuelle, pas d'entrée archivée
        liste.addItem(item_actuel)
        for v in sorted(task.versions, key=lambda v: v["numero"], reverse=True):
            date_affichee = v["date"].split("T")[0] if "T" in v.get("date", "") else v.get("date", "")
            item = QListWidgetItem(f"Version {v['numero']} -- {date_affichee}")
            item.setData(Qt.UserRole, v["numero"])
            liste.addItem(item)
        dialogue.ajouter_widget(liste)

        boutons = QHBoxLayout()
        bouton_restaurer = _creer_bouton_dialogue("Restaurer cette version", primaire=True, parent=dialogue.zone_contenu)
        bouton_fermer = _creer_bouton_dialogue("Fermer", primaire=False, parent=dialogue.zone_contenu)
        boutons.addWidget(bouton_fermer)
        boutons.addWidget(bouton_restaurer)
        dialogue.ajouter_layout(boutons)

        bouton_fermer.clicked.connect(dialogue.reject)

        def _sur_restaurer():
            item = liste.currentItem()
            if item is None:
                return
            numero = item.data(Qt.UserRole)
            if numero is None:
                return  # "Version actuelle" sélectionnée -- rien à restaurer
            dialogue.accept()
            self._restaurer_version(task.id, numero)

        bouton_restaurer.clicked.connect(_sur_restaurer)
        dialogue.exec()

    def _restaurer_version(self, task_id: str, numero_version: int):
        """Restaure la version `numero_version` d'un Task comme contenu
        courant -- l'état actuel (avant restauration) est D'ABORD archivé
        comme une nouvelle version (même logique que
        _demande_nouvelle_version_task) : restaurer une ancienne version
        ne supprime jamais rien, ça ajoute simplement une entrée de plus à
        l'historique pour l'état qu'on quitte, exactement comme un "revert"
        Git qui reste lui-même un commit."""
        task = self.project.find_task(task_id)
        if task is None:
            return
        version = next((v for v in task.versions if v["numero"] == numero_version), None)
        if version is None:
            return

        instantane_avant_restauration = {
            "numero": self._prochain_numero_version(task),
            "date": datetime.now().isoformat(),
            "cellules": [{**c.to_dict(), "sortie": ""} for c in task.cellules],
            "services_api_importes": dict(task.services_api_importes),
            "cellule_variables": {**task.cellule_variables.to_dict(), "sortie": ""},
        }
        task.versions.append(instantane_avant_restauration)

        task.cellules = [TaskCellule.from_dict(c) for c in version["cellules"]]
        task.services_api_importes = dict(version["services_api_importes"])
        task.cellule_variables = TaskCellule.from_dict(version["cellule_variables"])
        task.date_derniere_ouverture = datetime.now().isoformat()

        self._planifier_sauvegarde_projet_differee()
        self._reload_grille()
        self._notify_status(f"« {task.nom} » restauré à la version {numero_version}.")
        self._ouvrir_task(task.id)

    def _confirm_delete_task(self):
        """Suppression du Task actuellement OUVERT (bouton "..." de
        l'éditeur, cf. _show_task_menu) -- délègue à _confirm_delete_task_id
        pour partager la même confirmation/logique que la suppression
        directe depuis la grille (cf. TaskCarte.demande_suppression).
        _confirm_delete_task_id fait déjà un _reload_grille() complet ;
        ici on bascule juste la vue sans reload supplémentaire (pas
        besoin de passer par _retour_grille, qui en referait un)."""
        task = self._task_courant_obj()
        if task is None:
            return
        if self._confirm_delete_task_id(task.id):
            self._task_courant = None
            self.stack.setCurrentWidget(self.grille_page)

    def _confirm_delete_task_id(self, task_id: str) -> bool:
        """MAJ décision utilisateur ("on doit pourvoir renomer, suprimer
        une task meme quand on est dans la prmeier interface task config
        elle meme") : version généralisée par task_id, appelable depuis la
        grille SANS ouvrir l'éditeur au préalable -- _confirm_delete_task
        (bouton "..." de l'éditeur) délègue maintenant ici. Retourne True
        si la suppression a bien eu lieu (permet à l'appelant de savoir
        s'il doit lui-même se refermer, cf. _confirm_delete_task), False
        si Task introuvable.

        PATCH (demande utilisateur explicite : corbeille) : plus de
        QMessageBox -- remove_task déplace désormais le Task vers la
        corbeille au lieu de le supprimer pour de bon, donc plus aucune
        confirmation ici (le nom du paramètre garde le préfixe
        "_confirm_" pour ne pas casser les appelants existants, cf.
        _renommer_task_id/grille)."""
        task = self.project.find_task(task_id)
        if task is None:
            return False
        nom = task.nom
        self.project.remove_task(task.id)
        self.project.save()
        # FlowGrid n'expose pas de retrait unitaire (seulement clear()/
        # add_item(), cf. sa docstring) -- un reload complet reste la
        # façon correcte de faire disparaître la card, et refait au passage
        # le tri par défaut (cf. _reload_grille) sans widget orphelin.
        self._reload_grille()
        self._notify_status(f"Task « {nom} » supprimé.")
        return True

    def _renommer_task_id(self, task_id: str, nouveau_nom: str):
        """MAJ décision utilisateur (renommage direct depuis la grille,
        sans ouvrir l'éditeur) -- même règles que _on_nom_edited (nom vide
        ignoré, pas de re-sauvegarde si inchangé), mais visant un task_id
        arbitraire plutôt que forcément self._task_courant. Met à jour la
        card ET le champ nom_edit de l'éditeur si ce Task se trouve être
        celui actuellement ouvert (cohérence si l'utilisateur rouvre
        ensuite l'éditeur sans repasser par _ouvrir_task)."""
        task = self.project.find_task(task_id)
        if task is None:
            return
        nouveau_nom = nouveau_nom.strip()
        if not nouveau_nom or nouveau_nom == task.nom:
            carte = self._task_cartes.get(task_id)
            if carte is not None:
                carte.rafraichir(task)
            return
        task.nom = nouveau_nom
        self.project.save()
        carte = self._task_cartes.get(task_id)
        if carte is not None:
            carte.rafraichir(task)
        if self._task_courant == task_id:
            self.nom_edit.blockSignals(True)
            self.nom_edit.setText(nouveau_nom)
            self.nom_edit.blockSignals(False)
        self._notify_status(f"Task renommé en « {nouveau_nom} ».")

    def _toggle_epingle_task_id(self, task_id: str):
        """AJOUT (spec B.5, système d'épinglage) -- bascule task.epingle,
        sauvegarde le projet, puis rappelle _reload_grille() en entier
        (PAS un simple carte.rafraichir(), contrairement à _renommer_
        task_id ci-dessus) : un changement d'épinglage doit réordonner
        IMMÉDIATEMENT la grille (tri à deux clés, cf. _reload_grille),
        ce qu'un rafraîchissement de card seule ne ferait pas."""
        task = self.project.find_task(task_id)
        if task is None:
            return
        task.epingle = not task.epingle
        if task.epingle:
            # Nouvel épinglé : placé EN FIN du groupe épinglé (les autres
            # gardent leur place), déplaçable ensuite à la souris.
            rangs = [t.ordre_epingle for t in self.project.tasks if t.epingle and t is not task]
            task.ordre_epingle = (max(rangs) + 1) if rangs else 0
        self.project.save()
        self._reload_grille()
        self._notify_status(
            f"Task « {task.nom} » épinglé." if task.epingle
            else f"Task « {task.nom} » désépinglé."
        )

    def _definir_couleur_icone_task_id(self, task_id: str, couleur: str):
        """AJOUT -- fixe la teinte de l'icône du Task ("" = défaut),
        sauvegarde et rafraîchit uniquement la carte concernée (aucun
        réordonnancement : la couleur ne change aucune position)."""
        task = self.project.find_task(task_id)
        if task is None:
            return
        task.couleur_icone = couleur or ""
        self.project.save()
        carte = self._task_cartes.get(task_id)
        if carte is not None:
            carte.rafraichir(task)

    def _deplacer_task_epingle(self, source_id: str, cible_id: str):
        """AJOUT -- glisser-déposer d'un épinglé sur un autre : la source
        prend la place de la cible dans le groupe épinglé, les rangs sont
        renumérotés 0..n-1 puis sauvegardés. Seul geste qui modifie la
        position d'un épinglé."""
        epingles = sorted(
            (t for t in self.project.tasks if t.epingle),
            key=lambda t: t.ordre_epingle,
        )
        source = next((t for t in epingles if t.id == source_id), None)
        cible = next((t for t in epingles if t.id == cible_id), None)
        if source is None or cible is None or source is cible:
            return
        epingles.remove(source)
        epingles.insert(epingles.index(cible) + (1 if self._index_avant(source_id, cible_id) else 0), source)
        for rang, t in enumerate(epingles):
            t.ordre_epingle = rang
        self.project.save()
        self._reload_grille()

    def _index_avant(self, source_id: str, cible_id: str) -> bool:
        """True si la source était AVANT la cible (donc on la place après
        la cible, comportement standard d'un déplacement dans une liste)."""
        ordre = [t.id for t in sorted(
            (t for t in self.project.tasks if t.epingle), key=lambda t: t.ordre_epingle)]
        return ordre.index(source_id) < ordre.index(cible_id)

    # ------------------------------------------------------------------
    def _notify_status(self, message: str, error: bool = False):
        window = self.window()
        if hasattr(window, "statusBar"):
            window.statusBar().showMessage(message, 4000)


# ---------------------------------------------------------------------------
# Dashboard réseau (12.4) : ClientReseauDashboard + DashboardScreen
#
# ClientReseauDashboard tourne dans un thread dédié avec sa propre boucle
# asyncio (le thread Qt principal ne doit jamais bloquer sur de l'I/O
# réseau). Communication vers l'UI exclusivement par signaux Qt (jamais
# d'appel direct à un widget depuis ce thread -- règle stricte de PySide6).
# Peut aussi ENVOYER des commandes (link, unlink, command set_fps/
# set_streaming) à la demande de l'UI, via asyncio.run_coroutine_threadsafe,
# puisque AutoniaX/Dashboard agit à la fois comme pilote et comme
# observateur (cf. 3.1).
#
# Fermeture : arreter() doit être appelée explicitement avant de tuer le
# process serveur (cf. diagnostic terminate() -- un websocket resté ouvert
# côté client empêche le serveur de finaliser proprement le close-handshake
# à l'arrêt). Bloquant par design (attend que le thread se termine avec un
# timeout), pour que closeEvent puisse compter sur un retour déterministe.
#
# DashboardScreen remplace le PlaceholderScreen de l'onglet "dashboard".
# Structure à deux colonnes, sur le modèle de ParametresScreen : liste des
# instances connectées à gauche (#ServiceAPIList, vocabulaire déjà stylé
# dans build_stylesheet), aperçu + contrôles à droite
# (LabelApercuRedimensionnable, déjà utilisée par TestActionScreen --
# réutilisée telle quelle plutôt que dupliquée).
#
# Périmètre de cette étape (12.4 points 2+3 réunis) : lister les instances,
# sélectionner une instance et voir son flux vidéo en direct, lancer une
# nouvelle instance (vrai process instance_nodriver.py), contrôler le FPS
# et mettre en pause/reprendre le streaming d'une instance liée, arrêter
# une instance (tue son process).
# ---------------------------------------------------------------------------

log_dashboard_reseau = logging.getLogger("autoniax.dashboard.reseau")
log_dashboard_ui = logging.getLogger("autoniax.dashboard.ui")
log_coord_action_diag = logging.getLogger("autoniax.diag.coord_action")
log_cellule = logging.getLogger("autoniax.task.cellule")  # DIAGNOSTIC : trace chaque étape du cycle de vie clic -> exec() -> callback
# DIAGNOSTIC (demande explicite utilisateur : "la barre de chargement pour
# l'ouverture d'un task ne fonctionne absolument pas [...] je crois que
# c'est parcequ'on a du mal à déterminer quelle est l'opération la plus
# gourmande [...] je veux que tu affiches des logs qui font tracker
# exactement quelle opération fait perdre plus de temps") -- logger dédié,
# séparé de log_cellule (qui trace le cycle clic -> exec() -> callback
# D'UNE CELLULE, pas l'ouverture du Task dans son ensemble) : cf.
# TaskConfigScreen._ouvrir_task, seul point d'entrée réel de "cliquer sur
# une carte de la grille -> notebook affiché" (à distinguer d'ImportTaskWorker,
# qui a SA PROPRE barre -- barre_progression_import_task -- pour le cas
# différent "importer un .autoniaxtask externe", déjà correctement gérée en
# thread séparé). _ouvrir_task, elle, tourne ENTIÈREMENT sur le thread UI,
# synchrone, sans aucune barre ni mesure -- ce logger sert à mesurer,
# étape par étape (perf_counter, millisecondes), où part réellement le
# temps sur un GROS Task, pour permettre ensuite de rendre la barre
# proportionnelle à la vraie répartition du coût plutôt qu'à une estimation
# hasardeuse.
log_ouverture_task = logging.getLogger("autoniax.task.ouverture")

# ======================================================================
# DIAGNOSTIC -- TraceOuverture (patch6)
# Retour utilisateur : « ça perd encore du temps pour ouvrir un notebook,
# mets des logs qui trouvent ce qui perd exactement le temps ».
#
# Le chronométrage de _ouvrir_task_impl ne voit que le code SYNCHRONE de
# la méthode. Il ne voit pas : ce qui tourne APRÈS son retour (peinture,
# layout, timers différés, montage des cadres), le C++ de Qt, le GC, ni les
# threads de fond qui se disputent le GIL (sauvegarde JSON...). Cette trace
# couvre tout cela, du début de _ouvrir_task jusqu'à ce que la boucle
# d'événements redevienne libre (aucun gel > 40 ms pendant 600 ms).
#
# Rapport : lignes « [TRACE_OUV] ... » au niveau INFO (donc visibles sans
# AUTONIAX_DEBUG, et dans « Copier tous les logs »). AUTONIAX_TRACE=0 coupe.
# ======================================================================
import gc as _gc_trace

_FICHIER_TRACE_OUV = __file__
_BASE_TRACE_OUV = os.path.basename(__file__)


class _EchantillonsTrace:
    """Cumuls (en ms) d'une phase de l'échantillonneur."""
    __slots__ = ("occupe", "cpp", "py", "affame", "evts", "cumul", "lignes", "n")

    def __init__(self):
        self.occupe = 0.0   # temps où le thread principal travaillait
        self.cpp = 0.0      # ... dont C++ Qt pur (aucun code Python en cours)
        self.py = 0.0       # ... dont code Python
        self.affame = 0.0   # intervalles > 30 ms : échantillonneur privé du GIL
        self.evts = {}      # (type d'événement, classe) -> ms, pour le C++ pur
        self.cumul = {}     # fonction -> ms inclusifs
        self.lignes = {}    # ligne de NOTRE code -> ms
        self.n = 0


class TraceOuverture(QObject):
    actif = False
    _inst = None
    _mesures_installees = False
    SEUIL_GEL_MS = 40.0
    CALME_MS = 600.0
    MAX_MS = 20000.0
    PERIODE_S = 0.004
    _MOTS_ATTENTE = frozenset({
        "wait", "sleep", "select", "poll", "acquire", "get", "recv", "recv_into",
        "accept", "read", "readline", "join", "_wait_for_tstate_lock",
        "_worker", "run_forever", "_run_once", "_recv", "_read", "_loop",
    })
    _MESURES = {
        "TaskConfigScreen": [
            "_peupler_cellules", "_rafraichir_composants_connus_editeur",
            "_rafraichir_variables_globales_editeur", "_rafraichir_index_cellules",
            "_rafraichir_bouton_global", "_rafraichir_affichage_workspace_cellule_variables",
            "_rafraichir_visibilite_controles_reseau",
            "_rafraichir_apres_changement_executant_actif", "_rafraichir_statut_reseau",
            "_invalider_liaisons_instances_disparues", "_appliquer_etat_global_au_cadre",
            "_positionner_row0", "_memoriser_calibration_ouverture", "_poids_ouverture",
        ],
        "ListeVirtuelleCellules": [
            "charger", "reinitialiser", "synchroniser", "_monter", "_demonter",
            "_creer_cadre", "_finir_montage", "_positionner", "_appliquer_mesures",
            "invalider_hauteurs", "_recalculer", "_sur_largeur_changee",
            "hauteur_estimee", "prechauffer_cadre",
        ],
        "TaskCelluleWidget": ["__init__", "lier", "liberer_editeur_partage", "definir_index"],
        "PartageEditeur": [
            "__init__", "_mesurer", "_creer_editeur", "activer", "desactiver", "session_pour",
        ],
        "SessionCellule": ["__init__", "colorer", "decolorer"],
        "TaskScriptEditor": ["__init__", "showEvent", "resizeEvent", "_ajuster_hauteur", "_ajuster_hauteur_impl"],
        "BarreAccesRapideTask": ["rafraichir"],
        "PanneauComposantsImportesTask": ["rafraichir"],
        "PythonHighlighter": ["__init__", "highlightBlock"],
        "Project": ["save", "find_task"],
    }

    # ------------------------------------------------------------------
    # API appelée depuis le reste de l'app (toutes protégées : un outil de
    # diagnostic ne doit jamais faire échouer une ouverture)
    # ------------------------------------------------------------------
    @classmethod
    def instance(cls):
        if cls._inst is None:
            cls._inst = cls()
        return cls._inst

    @classmethod
    def preparer(cls):
        """Appelé par QTimer.singleShot(0, ...) au démarrage : mémorise la pile
        « boucle d'événements au repos » avant la première trace."""
        try:
            if os.environ.get("AUTONIAX_TRACE") == "0":
                return
            f = sys._getframe(1)
            if f is not None:
                cls.instance().repos = (f.f_code, f.f_lineno)
        except Exception:
            pass

    @classmethod
    def demarrer_ouverture(cls, task_id, code_ouvrir):
        try:
            if os.environ.get("AUTONIAX_TRACE") == "0":
                return
            cls.instance()._demarrer(task_id, code_ouvrir)
        except Exception:
            log_ouverture_task.exception("[TRACE_OUV] démarrage de la trace impossible")

    @classmethod
    def fin_synchrone(cls):
        try:
            if cls.actif and cls._inst is not None and cls._inst.t_fin_sync is None:
                cls._inst.t_fin_sync = time.perf_counter()
        except Exception:
            pass

    @classmethod
    def noter_etapes(cls, etapes, nb_cellules, duree_totale_ms):
        try:
            if cls.actif and cls._inst is not None:
                cls._inst.etapes = list(etapes)
                cls._inst.nb_cellules = nb_cellules
                cls._inst.duree_impl_ms = duree_totale_ms
        except Exception:
            pass

    @classmethod
    def noter_tache_fond(cls, nom, t_debut, t_fin, detail=""):
        """Tâche exécutée dans un thread de fond (appelable depuis ce thread)."""
        try:
            if cls.actif and cls._inst is not None:
                i = cls._inst
                i.taches_fond.append(
                    ((t_debut - i.t0) * 1000.0, (t_fin - t_debut) * 1000.0, nom, detail)
                )
        except Exception:
            pass

    # ------------------------------------------------------------------
    def __init__(self):
        super().__init__()
        self.repos = None          # (code, ligne) de l'appelant de exec() : « boucle au repos »
        self._run = 0
        self._noms_types = {}
        self._timer = QTimer(self)
        self._timer.setInterval(4)
        self._timer.timeout.connect(self._battement)
        self._reset()

    def _reset(self):
        self.id = ""
        self.nb_cellules = 0
        self.duree_impl_ms = 0.0
        self.t0 = 0.0
        self.t_fin_sync = None
        self.code_ouvrir = None
        self.id_thread_principal = 0
        self.etapes = []
        self.agregats = {}         # nom -> [appels, total ms inclusif, max ms]
        self.chrono = []           # (début ms, profondeur, nom, ms)
        self.profondeur = 0
        self.gels = []             # (fin ms, durée ms)
        self.dernier_battement = 0.0
        self.dernier_gel_fin = 0.0
        self.evt_courant = ("?", "?")
        self.evt_nb = {}
        self.echant = {"sync": _EchantillonsTrace(), "apres": _EchantillonsTrace()}
        self.autres = {}           # threads de fond : « nom @ ligne » -> ms
        self.taches_fond = []
        self.gc = []               # (génération, ms)
        self._gc_t = 0.0

    def _demarrer(self, task_id, code_ouvrir):
        app = QApplication.instance()
        if app is None:
            return
        if TraceOuverture.actif:
            self._terminer("nouvelle ouverture demandée avant la fin de la précédente")
        if not TraceOuverture._mesures_installees:
            TraceOuverture._mesures_installees = True
            self._installer_mesures()
        self._reset()
        self._run += 1
        self.id = task_id
        self.code_ouvrir = code_ouvrir
        self.id_thread_principal = threading.get_ident()
        self.t0 = self.dernier_battement = self.dernier_gel_fin = time.perf_counter()
        app.installEventFilter(self)
        _gc_trace.callbacks.append(self._cb_gc)
        self._timer.start()
        TraceOuverture.actif = True
        threading.Thread(
            target=self._boucle, args=(self._run,),
            name="TraceOuvertureEchantillonneur", daemon=True,
        ).start()

    # ------------------------------------------------------------------
    # Mesure des sous-fonctions (enveloppes posées une seule fois)
    # ------------------------------------------------------------------
    def _installer_mesures(self):
        import functools
        globaux = globals()
        installes, manquants = 0, []
        for nom_classe, methodes in self._MESURES.items():
            cls = globaux.get(nom_classe)
            if cls is None:
                manquants.append(nom_classe)
                continue
            for nom in methodes:
                fn = cls.__dict__.get(nom)
                if fn is None or isinstance(fn, (staticmethod, classmethod)) or not callable(fn):
                    manquants.append(f"{nom_classe}.{nom}")
                    continue
                setattr(cls, nom, self._envelopper(functools, fn, f"{nom_classe}.{nom}"))
                installes += 1
        log_ouverture_task.info(
            f"[TRACE_OUV] {installes} méthodes instrumentées"
            + (f" (introuvables, ignorées : {', '.join(manquants)})" if manquants else "")
        )

    @staticmethod
    def _envelopper(functools, fn, etiquette):
        @functools.wraps(fn)
        def _mesuree(*args, **kwargs):
            if not TraceOuverture.actif:
                return fn(*args, **kwargs)
            inst = TraceOuverture._inst
            prof = inst.profondeur
            inst.profondeur = prof + 1
            t = time.perf_counter()
            try:
                return fn(*args, **kwargs)
            finally:
                ms = (time.perf_counter() - t) * 1000.0
                inst.profondeur = prof
                a = inst.agregats.get(etiquette)
                if a is None:
                    inst.agregats[etiquette] = [1, ms, ms]
                else:
                    a[0] += 1
                    a[1] += ms
                    if ms > a[2]:
                        a[2] = ms
                if ms >= 3.0 and len(inst.chrono) < 600:
                    inst.chrono.append(((t - inst.t0) * 1000.0, prof, etiquette, ms))
        return _mesuree

    # ------------------------------------------------------------------
    # Boucle d'événements : événement en cours, battement, GC
    # ------------------------------------------------------------------
    def eventFilter(self, obj, ev):
        t = ev.type()
        self.evt_courant = (t, type(obj).__name__)
        self.evt_nb[t] = self.evt_nb.get(t, 0) + 1
        return False

    def _nom_type(self, t):
        nom = self._noms_types.get(t)
        if nom is None:
            nom = self._noms_types[t] = getattr(t, "name", None) or str(t)
        return nom

    def _battement(self):
        now = time.perf_counter()
        f = sys._getframe(1)
        if f is not None:
            self.repos = (f.f_code, f.f_lineno)
        gap = (now - self.dernier_battement) * 1000.0
        self.dernier_battement = now
        if gap > self.SEUIL_GEL_MS:
            self.gels.append(((now - self.t0) * 1000.0, gap))
            self.dernier_gel_fin = now
        elif self.t_fin_sync is not None and (now - self.dernier_gel_fin) * 1000.0 > self.CALME_MS:
            self._terminer("boucle d'événements libre")
            return
        if (now - self.t0) * 1000.0 > self.MAX_MS:
            self._terminer("durée maximale de trace atteinte")

    def _cb_gc(self, phase, info):
        if phase == "start":
            self._gc_t = time.perf_counter()
        else:
            self.gc.append((info.get("generation"), (time.perf_counter() - self._gc_t) * 1000.0))

    # ------------------------------------------------------------------
    # Échantillonneur (thread dédié) : pile du thread principal toutes les
    # ~4 ms. Chaque échantillon pèse l'intervalle jusqu'au suivant.
    # ------------------------------------------------------------------
    def _boucle(self, run):
        ident = self.id_thread_principal
        moi = threading.get_ident()
        noms = {}
        prec = None
        prec_t = time.perf_counter()
        n = 0
        while TraceOuverture.actif and self._run == run:
            time.sleep(self.PERIODE_S)
            maintenant = time.perf_counter()
            try:
                dt = (maintenant - prec_t) * 1000.0
                if prec is not None:
                    self._ajouter(prec, dt)
                prec_t = maintenant
                frames = sys._current_frames()
                fr = frames.get(ident)
                prec = self._capturer(fr, maintenant) if fr is not None else None
                if n % 25 == 0:
                    noms = {t.ident: t.name for t in threading.enumerate()}
                n += 1
                for tid, autre in frames.items():
                    if tid == ident or tid == moi or autre.f_code.co_name in self._MOTS_ATTENTE:
                        continue
                    lib = f"{noms.get(tid, tid)} @ {self._etiquette(autre)}"
                    self.autres[lib] = self.autres.get(lib, 0.0) + dt
            except Exception:
                prec = None

    @staticmethod
    def _etiquette(fr, avec_ligne=True):
        code = fr.f_code
        nom = getattr(code, "co_qualname", code.co_name)
        if code.co_filename != _FICHIER_TRACE_OUV and os.path.basename(code.co_filename) != _BASE_TRACE_OUV:
            nom = f"{os.path.basename(code.co_filename)}:{nom}"
        return f"{nom}:{fr.f_lineno}" if avec_ligne else nom

    def _capturer(self, frame, maintenant):
        phase = "sync" if self.t_fin_sync is None else "apres"
        repos = self.repos
        cpp = repos is not None and frame.f_code is repos[0] and frame.f_lineno == repos[1]
        cumul, feuille = [], None
        if not cpp:
            code_repos = repos[0] if repos is not None else None
            f, prof = frame, 0
            while f is not None and prof < 80:
                code = f.f_code
                if code is code_repos:
                    break
                cumul.append(self._etiquette(f, avec_ligne=False))
                if feuille is None and (
                    code.co_filename == _FICHIER_TRACE_OUV
                    or os.path.basename(code.co_filename) == _BASE_TRACE_OUV
                ):
                    feuille = self._etiquette(f)
                if code is self.code_ouvrir:
                    break
                f = f.f_back
                prof += 1
            if feuille is None:
                feuille = self._etiquette(frame)
        if phase == "sync" or not cpp:
            occupe = True
        else:
            occupe = (maintenant - self.dernier_battement) > 0.025
        return (phase, occupe, cpp, self.evt_courant if cpp else None, cumul, feuille)

    def _ajouter(self, prec, dt):
        phase, occupe, cpp, evt, cumul, feuille = prec
        if not occupe:
            return
        e = self.echant[phase]
        e.occupe += dt
        e.n += 1
        if dt > 30.0:
            e.affame += dt
        if cpp:
            e.cpp += dt
            e.evts[evt] = e.evts.get(evt, 0.0) + dt
        else:
            e.py += dt
            for lib in set(cumul):
                e.cumul[lib] = e.cumul.get(lib, 0.0) + dt
            if feuille:
                e.lignes[feuille] = e.lignes.get(feuille, 0.0) + dt

    # ------------------------------------------------------------------
    def _terminer(self, raison):
        if not TraceOuverture.actif:
            return
        TraceOuverture.actif = False
        try:
            self._timer.stop()
            app = QApplication.instance()
            if app is not None:
                app.removeEventFilter(self)
            if self._cb_gc in _gc_trace.callbacks:
                _gc_trace.callbacks.remove(self._cb_gc)
        except Exception:
            pass
        try:
            self._rapport(raison)
        except Exception:
            log_ouverture_task.exception("[TRACE_OUV] rapport impossible")

    @staticmethod
    def _top(d, n):
        return sorted(d.items(), key=lambda kv: kv[1], reverse=True)[:n]

    def _rapport(self, raison):
        L = []
        p = L.append
        t_sync = ((self.t_fin_sync - self.t0) * 1000.0) if self.t_fin_sync else None
        t_libre = (self.dernier_gel_fin - self.t0) * 1000.0
        p(f"═══ TRACE OUVERTURE [{self.id}] -- {self.nb_cellules} cellule(s) -- fin : {raison} ═══")
        if t_sync is not None:
            p(f"Entrée dans _ouvrir_task -> retour (synchrone) : {t_sync:.0f} ms")
            p(f"Entrée -> interface réellement libre (plus aucun gel > {self.SEUIL_GEL_MS:.0f} ms) : {t_libre:.0f} ms")
            p(f"  => perdu APRÈS le retour de _ouvrir_task (peinture, layout, timers différés) : {max(0.0, t_libre - t_sync):.0f} ms")
        else:
            p(f"_ouvrir_task n'a pas rendu la main ; trace stoppée à {t_libre:.0f} ms")
        p("(Le délai clic -> début de _ouvrir_task n'est pas mesuré ici : le signal est direct.)")

        gels = sorted(self.gels, key=lambda g: g[1], reverse=True)[:8]
        if gels:
            p("Gels de la boucle d'événements (début -> durée), les plus longs :")
            for fin, dur in sorted(gels, key=lambda g: g[0]):
                p(f"  +{fin - dur:7.0f} ms  ->  {dur:7.0f} ms")

        if self.etapes:
            somme = sum(ms for _, ms in self.etapes)
            p(f"Étapes de _ouvrir_task_impl (total {self.duree_impl_ms:.0f} ms, dont {somme:.0f} ms attribués) :")
            for nom, ms in sorted(self.etapes, key=lambda x: x[1], reverse=True):
                if ms >= 1.0:
                    p(f"  {ms:8.1f} ms  {nom}")
            p(f"  {max(0.0, self.duree_impl_ms - somme):8.1f} ms  (non attribué)")

        if self.agregats:
            p("Fonctions mesurées, temps INCLUSIF cumulé (appels / total / plus long) :")
            for nom, _tot in self._top({k: v[1] for k, v in self.agregats.items()}, 30):
                a = self.agregats[nom]
                p(f"  {a[1]:8.1f} ms  x{a[0]:<5d} max {a[2]:7.1f} ms  {nom}")

        if self.chrono:
            p("Chronologie des appels mesurés >= 8 ms (début, indentation = imbrication) :")
            for deb, prof, nom, ms in sorted(self.chrono, key=lambda c: c[0])[:80]:
                if ms >= 8.0:
                    p(f"  +{deb:7.0f} ms {'  ' * min(prof, 8)}{nom} = {ms:.1f} ms")

        for phase, titre in (("sync", "PENDANT _ouvrir_task"), ("apres", "APRÈS _ouvrir_task")):
            e = self.echant[phase]
            if e.occupe < 1.0:
                continue
            p(f"Échantillonneur {titre} : thread principal occupé {e.occupe:.0f} ms "
              f"(Python {e.py:.0f} ms, C++ Qt pur {e.cpp:.0f} ms)")
            if e.affame > 0:
                p(f"  dont {e.affame:.0f} ms où l'échantillonneur n'a pas pu tourner (GIL tenu par du C++ : "
                  f"layout/polish/peinture) -- attribués à la dernière pile vue")
            if e.evts:
                p("  C++ Qt pur, par événement en cours (type sur classe) :")
                for (typ, cls), ms in self._top(e.evts, 8):
                    p(f"    {ms:7.0f} ms  {self._nom_type(typ)} sur {cls}")
            if e.cumul:
                p("  Python, par fonction (inclusif) :")
                for nom, ms in self._top(e.cumul, 14):
                    p(f"    {ms:7.0f} ms  {nom}")
            if e.lignes:
                p("  Python, lignes les plus chaudes de notre code (un appel Qt = temps passé dans Qt) :")
                for nom, ms in self._top(e.lignes, 10):
                    p(f"    {ms:7.0f} ms  {nom}")

        if self.evt_nb:
            p("Événements Qt traités (nombre) : " + ", ".join(f"{self._nom_type(k)}={v}" for k, v in self._top(self.evt_nb, 10)))
        if self.gc:
            p(f"Ramasse-miettes : {len(self.gc)} passe(s), {sum(ms for _, ms in self.gc):.0f} ms au total, "
              f"plus longue {max(ms for _, ms in self.gc):.0f} ms")
        else:
            p("Ramasse-miettes : aucune passe pendant la trace")
        if self.taches_fond:
            p("Tâches de fond pendant la trace (début, durée) -- elles se partagent le GIL avec l'interface :")
            for deb, dur, nom, detail in sorted(self.taches_fond):
                p(f"  +{deb:7.0f} ms  {dur:7.0f} ms  {nom} {detail}")
        autres = self._top(self.autres, 8)
        if autres:
            p("Autres threads actifs (approximatif : un thread bloqué en C peut être compté à tort) :")
            for nom, ms in autres:
                p(f"  {ms:7.0f} ms  {nom}")
        p("Note : les lignes enum.py / TraceOuverture.* sont le coût de la trace elle-même (création paresseuse d'enums PySide au premier passage de chaque type d'événement).")
        p("═══ FIN TRACE OUVERTURE ═══")
        for ligne in L:
            log_ouverture_task.info("[TRACE_OUV] " + ligne)


# Les rôles "instance" (ex-instance_nodriver.py, cf. main_instance_nodriver())
# ET "serveur" (ex-serveur.py, cf. main_serveur()) sont fusionnés dans ce
# fichier -- ni l'un ni l'autre n'a plus de script séparé.
# SCRIPT_INSTANCE_DASHBOARD/SCRIPT_SERVEUR_DASHBOARD pointent maintenant
# tous deux sur AutoniaX.py lui-même (résolu via __file__ plutôt qu'un
# chemin codé en dur, pour fonctionner quel que soit l'emplacement du
# dossier projet sur la machine), lancé respectivement avec --instance-id
# ou --serveur, qui route vers main_instance_nodriver() ou main_serveur()
# (cf. if __name__ == "__main__" en fin de fichier) au lieu de créer une
