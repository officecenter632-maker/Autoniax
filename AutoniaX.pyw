    def definir_sautoniax_disponibles(self, executants: dict):
        """Connecté par MainWindow (cf. demande_liste_sautoniax_
        disponibles ET rafraîchi à chaque changement de la liste des
        sAutoniax connectés, même source que l'onglet Instances) --
        {id_executant: nom}, même format que DialogueEnvoiSautoniax.
        Conserve la sélection actuelle par id_executant si le sAutoniax
        choisi est toujours connecté."""
        id_choisi_avant = self.combo_sautoniax_cible.currentData()
        self.combo_sautoniax_cible.clear()
        for id_executant, nom in sorted(executants.items(), key=lambda kv: kv[1]):
            self.combo_sautoniax_cible.addItem(nom, id_executant)
        index_a_restaurer = self.combo_sautoniax_cible.findData(id_choisi_avant)
        if index_a_restaurer >= 0:
            self.combo_sautoniax_cible.setCurrentIndex(index_a_restaurer)
        self._rafraichir_libelle_envoi_sautoniax()

    def _rafraichir_libelle_envoi_sautoniax(self):
        """Active/désactive le bouton "Envoyer vers ce sAutoniax" ET le
        bouton "Télécharger en local" (PATCH -- même sélection cochée
        partagée entre les deux actions de l'onglet "Transfert de
        profils", cf. docstring de __init__), met à jour leur libellé
        avec le nombre de profils cochés -- appelé à chaque case cochée/
        décochée (cf. _sur_case_profil_changee) et à chaque changement
        de la liste des sAutoniax disponibles. Aucun appel réseau ici,
        purement un état d'activation local."""
        nb_coches = len(self._noms_profils_coches())
        un_envoi_en_cours = self._sautoniax_envoi_en_cours is not None
        self.bouton_envoyer_vers_sautoniax.setEnabled(
            nb_coches > 0 and self.combo_sautoniax_cible.count() > 0 and not un_envoi_en_cours
        )
        if not un_envoi_en_cours:
            self.bouton_envoyer_vers_sautoniax.setText(
                f"Envoyer vers ce sAutoniax ({nb_coches})" if nb_coches else "Envoyer vers ce sAutoniax"
            )

        un_telechargement_local_en_cours = bool(self._file_profils_a_telecharger_local) or self._telechargement_local_en_cours
        self.bouton_telecharger_local.setEnabled(nb_coches > 0 and not un_telechargement_local_en_cours)
        if not un_telechargement_local_en_cours:
            self.bouton_telecharger_local.setText(
                f"Télécharger en local ({nb_coches})" if nb_coches else "Télécharger en local"
            )

        # PATCH (onglet "Action rapide" -- bouton "Supprimer") : même
        # sélection cochée, activé dès qu'au moins un profil est coché,
        # aucune notion "d'envoi en cours" à respecter ici (contrairement
        # aux deux boutons ci-dessus) -- marquer pour suppression est
        # instantané et local (cf. _sur_clic_supprimer_rapide), seule la
        # validation groupée envoie réellement au serveurT.
        self.bouton_supprimer_rapide.setText(
            f"Supprimer ({nb_coches})" if nb_coches else "Supprimer"
        )
        self.bouton_supprimer_rapide.setEnabled(nb_coches > 0)

    def _sur_clic_telecharger_local(self):
        """PATCH (bouton "Télécharger en local", demande explicite
        utilisateur) -- même patron exact que _sur_clic_envoyer_vers_
        sautoniax juste au-dessus, mais sans destination à choisir
        (toujours DOSSIER_RACINE_PROFILS du pilote lui-même, cf.
        MainWindow qui gère le téléchargement+dézippage réel -- cet
        écran ne fait qu'émettre demande_telechargement_local_profil,
        un nom à la fois, séquentiellement)."""
        noms_coches = self._noms_profils_coches()
        if not noms_coches:
            return
        self._file_profils_a_telecharger_local = list(noms_coches)
        self._nb_profils_total_telechargement_local = len(noms_coches)
        self._nb_profils_traites_telechargement_local = 0
        self._telechargement_local_en_cours = True
        self.bouton_telecharger_local.setEnabled(False)
        self.barre_progression_local.setRange(0, self._nb_profils_total_telechargement_local * 100)
        self.barre_progression_local.setValue(0)
        self.barre_progression_local.setVisible(True)
        self.label_statut_local.setText("")
        self._telecharger_prochain_profil_local()

    def _telecharger_prochain_profil_local(self):
        """Dépile UN nom de profil de self._file_profils_a_telecharger_
        local et émet demande_telechargement_local_profil pour lui --
        rappelée depuis sur_resultat_telechargement_local_profil une
        fois que CHAQUE profil est confirmé traité (succès ou échec),
        même patron que _envoyer_prochain_profil_sautoniax."""
        if not self._file_profils_a_telecharger_local:
            self._telechargement_local_en_cours = False
            self.barre_progression_local.setVisible(False)
            self.label_statut_local.setText(
                f"{self._nb_profils_traites_telechargement_local}/{self._nb_profils_total_telechargement_local} "
                f"profil(s) téléchargé(s) en local."
            )
            self._nb_profils_total_telechargement_local = 0
            self._nb_profils_traites_telechargement_local = 0
            self._rafraichir_libelle_envoi_sautoniax()
            return
        nom_profil = self._file_profils_a_telecharger_local.pop(0)
        self.label_statut_local.setText(
            f"Téléchargement de '{nom_profil}' ({self._nb_profils_traites_telechargement_local + 1}/"
            f"{self._nb_profils_total_telechargement_local})..."
        )
        self.barre_progression_local.setValue(self._nb_profils_traites_telechargement_local * 100)
        self.demande_telechargement_local_profil.emit(nom_profil)

    def sur_progression_telechargement_local_profil(self, nom_profil: str, pourcentage: int):
        """Connecté par MainWindow -- progression du téléchargement (pas
        du dézippage, quasi-instantané) du profil EN TÊTE de la file
        actuelle, même patron que sur_progression_envoi_vers_sautoniax.
        Ignore tout signal qui ne concerne pas le profil actuellement en
        tête (garde symétrique, même si ici un seul écran émet ce
        signal -- prudence identique au reste du fichier)."""
        if not self._telechargement_local_en_cours:
            return
        base = self._nb_profils_traites_telechargement_local * 100
        if pourcentage >= 0:
            self.barre_progression_local.setValue(base + pourcentage)

    def sur_resultat_telechargement_local_profil(self, nom_profil: str, ok: bool, message: str):
        """Connecté par MainWindow -- résultat final (téléchargement ET
        dézippage) d'UN profil, même patron que sur_resultat_envoi_vers_
        sautoniax. Avance toujours la file, succès ou échec (mieux vaut
        télécharger le maximum possible que tout arrêter sur un premier
        échec, même prudence que le reste du fichier vis-à-vis des
        échecs partiels)."""
        if not self._telechargement_local_en_cours:
            return
        self._nb_profils_traites_telechargement_local += 1
        self.barre_progression_local.setValue(self._nb_profils_traites_telechargement_local * 100)
        if not ok:
            self.label_statut_local.setText(f"Échec pour '{nom_profil}' : {message}")
        self._telecharger_prochain_profil_local()

    def _sur_clic_envoyer_vers_sautoniax(self):
        noms_coches = self._noms_profils_coches()
        id_executant = self.combo_sautoniax_cible.currentData()
        if not noms_coches or not id_executant:
            return
        self._sautoniax_envoi_en_cours = id_executant
        self._sautoniax_file_profils_a_envoyer = list(noms_coches)
        self._sautoniax_nb_profils_total_envoi = len(noms_coches)
        self._sautoniax_nb_profils_traites_envoi = 0
        self.bouton_envoyer_vers_sautoniax.setEnabled(False)
        self.barre_progression_sautoniax.setVisible(True)
        # PATCH -- échelle en centièmes (0..nb_total*100) plutôt qu'un
        # palier par profil complet : chaque profil contribue jusqu'à
        # 100 points selon SA progression réelle de téléchargement en
        # cours (cf. sur_progression_envoi_vers_sautoniax ci-dessous),
        # pas seulement "combien sont terminés". La barre avance donc en
        # continu pendant le téléchargement du profil courant, au lieu
        # de rester figée jusqu'au prochain résultat final.
        self.barre_progression_sautoniax.setRange(0, self._sautoniax_nb_profils_total_envoi * 100)
        self.barre_progression_sautoniax.setValue(0)
        self.label_statut_sautoniax.setText("")
        self._envoyer_prochain_profil_sautoniax()

    def _envoyer_prochain_profil_sautoniax(self):
        """Dépile UN nom de profil de self._sautoniax_file_profils_a_
        envoyer et émet demande_envoi_profil_vers_sautoniax pour lui --
        rappelée depuis sur_resultat_envoi_vers_sautoniax une fois que
        CHAQUE profil est confirmé traité (succès ou échec), jamais
        avant : un seul téléchargement en vol à la fois sur le sAutoniax
        cible, cf. docstring de la section UI dans __init__."""
        if not self._sautoniax_file_profils_a_envoyer:
            # Tous les profils cochés ont été traités.
            id_executant = self._sautoniax_envoi_en_cours
            nom_cible = self.combo_sautoniax_cible.currentText()
            self._sautoniax_envoi_en_cours = None
            self.barre_progression_sautoniax.setVisible(False)
            self.label_statut_sautoniax.setText(
                f"{self._sautoniax_nb_profils_traites_envoi}/{self._sautoniax_nb_profils_total_envoi} "
                f"profil(s) envoyé(s) vers '{nom_cible}'."
            )
            self._rafraichir_libelle_envoi_sautoniax()
            return
        nom_profil = self._sautoniax_file_profils_a_envoyer.pop(0)
        self.label_statut_sautoniax.setText(
            f"Envoi de '{nom_profil}' ({self._sautoniax_nb_profils_traites_envoi + 1}/"
            f"{self._sautoniax_nb_profils_total_envoi})..."
        )
        # Le profil courant démarre à sa base (nb déjà traités * 100) --
        # cf. sur_progression_envoi_vers_sautoniax pour la progression
        # fine à l'intérieur de ce palier.
        self.barre_progression_sautoniax.setValue(self._sautoniax_nb_profils_traites_envoi * 100)
        self.demande_envoi_profil_vers_sautoniax.emit(self._sautoniax_envoi_en_cours, nom_profil)

    def sur_progression_envoi_vers_sautoniax(self, id_executant: str, nom_profil: str, pourcentage: int):
        """Connecté par MainWindow à ClientServeurT.telecharger_profil_
        vers_sautoniax_progression_recu -- PATCH (demande explicite
        utilisateur : la progression globale de cet écran doit refléter
        le téléchargement RÉEL en cours, pas seulement des paliers par
        profil complet). Ignore tout signal qui ne concerne pas l'envoi
        actuellement piloté DEPUIS CET ÉCRAN (même garde que sur_
        resultat_envoi_vers_sautoniax) -- pourcentage=-1 (démarrage
        indéterminé, cf. convention documentée sur envoyer_telecharger_
        profil_vers_sautoniax_progression) n'avance pas la barre au-delà
        de la base du palier courant, elle avancera dès le premier
        pourcentage réel reçu."""
        if id_executant != self._sautoniax_envoi_en_cours:
            return
        base = self._sautoniax_nb_profils_traites_envoi * 100
        if pourcentage >= 0:
            self.barre_progression_sautoniax.setValue(base + pourcentage)

    def sur_resultat_envoi_vers_sautoniax(self, id_executant: str, nom_profil: str, ok: bool, message: str):
        """Connecté par MainWindow à ClientServeurT.telecharger_profil_
        vers_sautoniax_resultat_recu -- ignore tout résultat qui ne
        concerne pas l'envoi actuellement en cours DEPUIS CET ÉCRAN (cf.
        self._sautoniax_envoi_en_cours -- un résultat pour un id_executant
        différent, ou reçu après la fin de la file, ne doit jamais faire
        avancer/reculer la progression affichée ici par erreur)."""
        if id_executant != self._sautoniax_envoi_en_cours:
            return
        self._sautoniax_nb_profils_traites_envoi += 1
        # Complète le palier du profil qui vient de se terminer (100
        # points pleins), même si le dernier pourcentage reçu via sur_
        # progression_envoi_vers_sautoniax n'était pas exactement 100 --
        # évite que la barre reste visuellement "en retard" d'un cran.
        self.barre_progression_sautoniax.setValue(self._sautoniax_nb_profils_traites_envoi * 100)
        if not ok:
            self.label_statut_sautoniax.setText(f"Échec pour '{nom_profil}' : {message}")
        self._envoyer_prochain_profil_sautoniax()

    # --- Table des profils cloud ---

    def _sur_filtre_change(self):
        self._filtre_badge = self.combo_filtre.currentData()
        self._reconstruire_table()

    def sur_resultat_liste_stockage(self, ok: bool, objets: list, message: str):
        """Connecté par MainWindow à ClientServeurT.stockage_liste_
        resultat (même signal que StockageCloudScreen, cf. docstring de
        classe) -- filtre sur le préfixe Profils/, sépare les .zip
        (un profil chacun) des .meta.json associés (métadonnées), puis
        déclenche le téléchargement de chaque .meta.json trouvé (cf.
        demande_telechargement_meta) avant de (re)construire la table."""
        if not ok:
            self.label_statut_liste.setText(f"Échec du chargement : {message}")
            return

        objets_normalises = [
            {"cle": o, "taille_octets": None} if isinstance(o, str) else o
            for o in objets
        ]
        cles_profils = self.PREFIXE_CLOUD
        nouveaux_profils: dict[str, dict] = {}
        cles_meta_a_telecharger: list[str] = []

        for objet in objets_normalises:
            cle = objet.get("cle", "")
            if not cle.startswith(cles_profils):
                continue
            reste = cle[len(cles_profils):]
            if "/" in reste:
                continue  # sous-dossier imprévu -- ignoré, cette table ne gère qu'un niveau plat
            if reste.endswith(".meta.json"):
                nom_profil = reste[:-len(".meta.json")]
                # CORRECTIF (badges qui ne s'appliquent jamais, log
                # serveur "mettre_a_jour_meta_profil (''.test=True)" ->
                # "Requête invalide") -- une clé B2 malformée du type
                # "Profils/.meta.json" (sans nom de profil devant, ex.
                # upload avorté avec un nom vide, ou fichier orphelin)
                # donne nom_profil == "" ici. .strip() en plus du test
                # de vide : un nom composé uniquement d'espace(s) (ex.
                # "Profils/ .meta.json") est tout aussi invalide mais
                # passait le premier "if not nom_profil" (bool(" ") est
                # True en Python) -- sans .strip() ici, cette ligne
                # fantôme quasi invisible (un espace comme nom affiché)
                # survivait toujours et provoquait le même rejet serveur
                # au clic sur un badge. Sans ce garde-fou, une ligne
                # fantôme apparaissait dans le tableau (triée en premier)
                # et tout clic sur un de ses badges envoyait un nom_profil
                # invalide au serveur, qui le rejette (à raison :
                # "nom_profil/champ/valeur manquant ou incorrect").
                if not nom_profil.strip():
                    continue
                cles_meta_a_telecharger.append(cle)
                nouveaux_profils.setdefault(nom_profil, {})
                nouveaux_profils[nom_profil]["cle_meta"] = cle
            elif reste.endswith(".zip"):
                nom_profil = reste[:-len(".zip")]
                # CORRECTIF -- même garde-fou que ci-dessus, symétrique
                # pour "Profils/.zip" (avec .strip(), cf. commentaire
                # juste au-dessus).
                if not nom_profil.strip():
                    continue
                nouveaux_profils.setdefault(nom_profil, {})
                nouveaux_profils[nom_profil]["cle_zip"] = cle
                nouveaux_profils[nom_profil]["taille_octets"] = objet.get("taille_octets")

        # Conserve les métadonnées déjà résolues lors d'un appel
        # précédent pour un profil qui existe toujours (évite de
        # re-télécharger tous les .meta.json à chaque clic sur
        # Actualiser si rien n'a changé côté cloud) -- seule une
        # ligne dont la clé zip/meta a réellement changé (ou qui vient
        # d'apparaître) redemande son téléchargement.
        for nom_profil, infos in nouveaux_profils.items():
            ancien = self._profils_cloud.get(nom_profil)
            if (
                ancien is not None
                and ancien.get("meta") is not None
                and ancien.get("cle_meta") == infos.get("cle_meta")
            ):
                infos["meta"] = ancien["meta"]

        # CORRECTIF (badges éternellement grisés sur Profils Cloud pour
        # un profil SANS .meta.json sur B2 -- profil envoyé avant
        # l'introduction de ce fichier, ou upload dont l'écriture du
        # meta a échoué) -- un profil qui a un .zip mais PAS de clé
        # "cle_meta" ne sera JAMAIS ajouté à cles_meta_a_telecharger
        # ci-dessous (rien à télécharger), donc infos["meta"] restait
        # None pour toujours -> meta_deja_resolu (cf. _reconstruire_
        # table, infos.get("meta") is not None) restait bloqué à False
        # -> _construire_widget_badges_cloud désactivait les boutons en
        # permanence (bouton_badge.setEnabled(meta_deja_resolu and ...)).
        # On résout ce cas explicitement à {} (tous les badges "non
        # activés", ce qui est une information valide, pas une absence
        # d'information) plutôt que de laisser None représenter à la
        # fois "pas encore vérifié" ET "vérifié, n'existe pas".
        for nom_profil, infos in nouveaux_profils.items():
            if infos.get("meta") is None and not infos.get("cle_meta"):
                infos["meta"] = {}

        self._profils_cloud = nouveaux_profils
        self.label_statut_liste.setText(f"{len(nouveaux_profils)} profil(s) dans {cles_profils}.")

        for cle_meta in cles_meta_a_telecharger:
            nom_profil = cle_meta[len(cles_profils):-len(".meta.json")]
            if self._profils_cloud.get(nom_profil, {}).get("meta") is not None:
                continue  # déjà résolu ci-dessus, pas besoin de retélécharger
            self.demande_telechargement_meta.emit(cle_meta)

        self._reconstruire_table()

    def sur_meta_profil_recu(self, cle: str, meta: Optional[dict]):
        """Connecté par MainWindow -- appelé une fois le contenu d'un
        <nom>.meta.json téléchargé et parsé (cf. MainWindow, qui gère le
        téléchargement via telecharger_fichier + lecture du fichier
        temporaire résultant, cette méthode ne reçoit que le dict déjà
        parsé). meta=None si le téléchargement ou le parsing JSON a
        échoué -- la ligne concernée reste alors avec des badges
        "inconnu" plutôt que de planter tout le tableau."""
        prefixe = self.PREFIXE_CLOUD
        if not cle.startswith(prefixe) or not cle.endswith(".meta.json"):
            return
        nom_profil = cle[len(prefixe):-len(".meta.json")]
        if nom_profil not in self._profils_cloud:
            return
        self._profils_cloud[nom_profil]["meta"] = meta or {}
        self._reconstruire_table()

    # PATCH (boutons Renommer/Supprimer, demande explicite utilisateur)
    # -- deux "champs" spéciaux réservés dans _file_validation_en_cours,
    # en plus des 5 vrais champs de badge (youtube/tiktok/ia/favori/
    # test) : "__renommer__" (valeur = nouveau nom, str) et
    # "__supprimer__" (valeur = True). Permet de réutiliser TELLE
    # QUELLE la même file séquentielle/barre de progression que les
    # badges plutôt que d'en dupliquer une deuxième pour ces deux
    # nouvelles actions.
    CHAMP_RENOMMER = "__renommer__"
    CHAMP_SUPPRIMER = "__supprimer__"

    def sur_resultat_maj_meta_profil(self, ok: bool, nom_profil: str, champ: str, valeur: bool, message: str):
        """Connecté par MainWindow -- ClientServeurT.meta_profil_maj_
        resultat, réponse au clic sur un badge de cette table (cf.
        demande_maj_meta_profil / _construire_widget_badges_cloud).

        PATCH (validation groupée -- demande explicite utilisateur : "un
        bouton mise a jour pour vraiment modifie sur le cloud ... global
        pour tout les modifactions") -- appelé maintenant pour CHAQUE
        élément badge de la file de validation groupée (_file_
        validation_en_cours) -- cf. sur_resultat_renommer_profil_cloud
        et sur_resultat_suppression_profil_cloud pour les deux autres
        types d'élément possibles dans cette même file (renommage/
        suppression). Sur succès, met à jour self._profils_cloud[nom]
        ["meta"][champ] EN MÉMOIRE (le serveur a déjà écrit le
        .meta.json sur B2) puis avance la file -- cf. _traiter_
        prochaine_modification_validation. Sur échec, la modification
        concernée reste listée dans le message d'erreur mais N'EST PAS
        remise dans _modifications_en_attente (pour éviter une boucle
        de re-tentative automatique) -- l'utilisateur peut la re-cocher
        lui-même s'il veut réessayer."""
        if ok and nom_profil in self._profils_cloud:
            if not isinstance(self._profils_cloud[nom_profil].get("meta"), dict):
                self._profils_cloud[nom_profil]["meta"] = {}
            self._profils_cloud[nom_profil]["meta"][champ] = valeur
        if not self._avancer_file_validation_si_correspond(nom_profil, champ, valeur):
            self._reconstruire_table()
            return
        if not ok:
            self.label_statut_liste.setText(
                f"Échec de mise à jour de '{nom_profil}' ({champ}) : {message}"
            )
        self._traiter_prochaine_modification_validation()

    def sur_resultat_renommer_profil_cloud(self, ok: bool, ancien_nom: str, nouveau_nom: str, message: str):
        """Connecté par MainWindow -- ClientServeurT.renommer_profil_
        cloud_resultat, réponse à un renommage de la file de validation
        groupée (cf. CHAMP_RENOMMER ci-dessus). Sur succès, retire
        l'ancienne entrée de self._profils_cloud et la réinsère sous le
        nouveau nom (même dict "cle_zip"/"meta"/etc., juste la clé du
        dict qui change) -- pas besoin d'attendre un nouveau lister_
        stockage pour que la table reflète le renommage."""
        if ok and ancien_nom in self._profils_cloud:
            infos = self._profils_cloud.pop(ancien_nom)
            infos["cle_zip"] = f"{self.PREFIXE_CLOUD}{nouveau_nom}.zip"
            if infos.get("cle_meta"):
                infos["cle_meta"] = f"{self.PREFIXE_CLOUD}{nouveau_nom}.meta.json"
            self._profils_cloud[nouveau_nom] = infos
        if not self._avancer_file_validation_si_correspond(ancien_nom, self.CHAMP_RENOMMER, nouveau_nom):
            self._reconstruire_table()
            return
        if not ok:
            self.label_statut_liste.setText(
                f"Échec du renommage de '{ancien_nom}' en '{nouveau_nom}' : {message}"
            )
        self._traiter_prochaine_modification_validation()

    def sur_resultat_suppression_profil_cloud(self, ok: bool, nom_profil: str, message: str):
        """Connecté par MainWindow -- ClientServeurT.stockage_supprimer_
        resultat, réponse à une suppression de la file de validation
        groupée (cf. CHAMP_SUPPRIMER ci-dessus). Réutilise le protocole
        générique demander_suppression_stockage (même que StockageCloud
        Screen), donc "cles" (liste) est reçu ici -- cf. _traiter_
        prochaine_modification_validation, qui envoie toujours les DEUX
        clés (zip + meta.json) d'un seul coup pour un même profil : ok
        porte donc sur les deux ensemble, pas de résultat partiel à
        gérer côté UI. Sur succès, retire la ligne de self._profils_
        cloud immédiatement."""
        if ok:
            self._profils_cloud.pop(nom_profil, None)
        if not self._avancer_file_validation_si_correspond(nom_profil, self.CHAMP_SUPPRIMER, True):
            self._reconstruire_table()
            return
        if not ok:
            self.label_statut_liste.setText(f"Échec de la suppression de '{nom_profil}' : {message}")
        self._traiter_prochaine_modification_validation()

    def _avancer_file_validation_si_correspond(self, nom_profil: str, champ: str, valeur) -> bool:
        """Factorise la vérification "ce résultat correspond bien à
        l'élément en tête de _file_validation_en_cours" -- commune aux
        trois méthodes sur_resultat_* ci-dessus (badge/renommage/
        suppression), cf. leur docstring respective pour le contexte.
        Retourne False (sans rien avancer) si le résultat est résiduel
        et ne concerne pas la validation en cours -- ne devrait pas
        arriver avec ce protocole séquentiel, mais même prudence que
        ProfilsLocalScreen.sur_resultat_envoi_profil."""
        if not self._file_validation_en_cours or self._file_validation_en_cours[0] != (nom_profil, champ, valeur):
            return False
        self._file_validation_en_cours.pop(0)
        self._nb_modifs_traitees_validation += 1
        return True

    def _traiter_prochaine_modification_validation(self):
        """PATCH (validation groupée) -- envoie, une par une, chaque
        modification encore dans _file_validation_en_cours (même
        patron séquentiel que ProfilsLocalScreen._envoyer_prochain_
        profil). Trois natures d'élément possibles selon `champ` (cf.
        CHAMP_RENOMMER/CHAMP_SUPPRIMER ci-dessus) : un badge (5 valeurs
        possibles) réutilise mettre_a_jour_meta_profil, un renommage
        démarre renommer_profil_cloud, une suppression réutilise le
        protocole générique demander_suppression_stockage déjà
        supporté par le serveurT -- AUCUN de ces trois protocoles n'est
        nouveau côté serveur, seul le renommage introduit un handler
        dédié (cf. serveur.py). Une fois la file vide, réactive le
        bouton Valider et masque la barre de progression."""
        if not self._file_validation_en_cours:
            self.barre_progression_validation.setVisible(False)
            self._nb_modifs_total_validation = 0
            self._nb_modifs_traitees_validation = 0
            if not self._modifications_en_attente and not self._renommages_en_attente and not self._suppressions_en_attente:
                self.label_statut_liste.setText("Modifications appliquées sur le cloud.")
            self._rafraichir_barre_validation()
            self._reconstruire_table()
            return
        nom_profil, champ, valeur = self._file_validation_en_cours[0]
        self.barre_progression_validation.setRange(0, self._nb_modifs_total_validation)
        self.barre_progression_validation.setValue(self._nb_modifs_traitees_validation)
        if champ == self.CHAMP_RENOMMER:
            self.barre_progression_validation.setFormat(
                f"Validation {self._nb_modifs_traitees_validation + 1}/{self._nb_modifs_total_validation} : "
                f"renommage '{nom_profil}' -> '{valeur}'"
            )
            self.demande_renommer_profil_cloud.emit(nom_profil, valeur)
        elif champ == self.CHAMP_SUPPRIMER:
            self.barre_progression_validation.setFormat(
                f"Validation {self._nb_modifs_traitees_validation + 1}/{self._nb_modifs_total_validation} : "
                f"suppression '{nom_profil}'"
            )
            infos = self._profils_cloud.get(nom_profil, {})
            cles = [c for c in (infos.get("cle_zip"), infos.get("cle_meta")) if c]
            if not cles:
                # Ligne déjà absente de _profils_cloud (cas limite --
                # ne devrait pas arriver, le bouton Supprimer n'existe
                # que sur une ligne déjà listée) : rien à envoyer au
                # serveurT, on considère la suppression déjà faite.
                self.sur_resultat_suppression_profil_cloud(True, nom_profil, "")
                return
            self.demande_suppression_profil_cloud.emit(cles)
        else:
            self.barre_progression_validation.setFormat(
                f"Validation {self._nb_modifs_traitees_validation + 1}/{self._nb_modifs_total_validation} : "
                f"'{nom_profil}' -- {champ}"
            )
            self.demande_maj_meta_profil.emit(nom_profil, champ, valeur)

    def _sur_clic_valider_modifications(self):
        """PATCH (validation groupée, demande explicite utilisateur) --
        aplatit _modifications_en_attente (badges) + _renommages_en_
        attente + _suppressions_en_attente en une seule file de tuples
        (nom, champ, valeur), retire IMMÉDIATEMENT ces modifications de
        leurs dicts respectifs (elles sont désormais "en cours d'envoi",
        plus "en attente") puis démarre le traitement séquentiel. Ne
        fait rien si aucune modification n'est en attente (bouton
        désactivé dans ce cas, cf. _rafraichir_barre_validation, mais
        garde défensive quand même). Ordre : badges, puis renommages,
        puis suppressions -- une suppression traitée AVANT un renommage
        du même profil serait incohérente (le renommage échouerait sur
        un zip déjà supprimé), cet ordre l'évite naturellement."""
        if not self._modifications_en_attente and not self._renommages_en_attente and not self._suppressions_en_attente:
            return
        file_a_plat = [
            (nom_profil, champ, valeur)
            for nom_profil, champs in self._modifications_en_attente.items()
            for champ, valeur in champs.items()
        ]
        file_a_plat += [
            (nom_profil, self.CHAMP_RENOMMER, nouveau_nom)
            for nom_profil, nouveau_nom in self._renommages_en_attente.items()
        ]
        file_a_plat += [
            (nom_profil, self.CHAMP_SUPPRIMER, True)
            for nom_profil in self._suppressions_en_attente
        ]
        self._modifications_en_attente = {}
        self._renommages_en_attente = {}
        self._suppressions_en_attente = set()
        self._file_validation_en_cours = file_a_plat
        self._nb_modifs_total_validation = len(file_a_plat)
        self._nb_modifs_traitees_validation = 0
        self.label_statut_liste.setText("")
        self.barre_progression_validation.setVisible(True)
        self._rafraichir_barre_validation()
        self._traiter_prochaine_modification_validation()

    def _sur_clic_annuler_modifications(self):
        """PATCH (validation groupée) -- vide _modifications_en_attente/
        _renommages_en_attente/_suppressions_en_attente SANS rien
        envoyer au serveurT (badges/noms/lignes retrouvent leur dernier
        état confirmé côté cloud, cf. _reconstruire_table qui relit
        toujours self._profils_cloud, jamais les modifications en
        attente une fois annulées)."""
        self._modifications_en_attente = {}
        self._renommages_en_attente = {}
        self._suppressions_en_attente = set()
        self._rafraichir_barre_validation()
        self._reconstruire_table()

    def _rafraichir_barre_validation(self):
        """PATCH (validation groupée) -- affiche/masque la barre
        "Valider les modifications" selon qu'il y a ou non des
        modifications en attente, et met à jour son décompte. Le bouton
        Valider reste désactivé pendant qu'une validation est déjà en
        cours d'envoi (_file_validation_en_cours non vide) -- évite un
        double-clic qui mélangerait deux lots de modifications.

        PATCH (boutons Renommer/Supprimer) -- le décompte inclut
        désormais aussi _renommages_en_attente et _suppressions_en_
        attente, en plus des badges (_modifications_en_attente)."""
        nb_modifs_badges = sum(len(champs) for champs in self._modifications_en_attente.values())
        nb_modifs = nb_modifs_badges + len(self._renommages_en_attente) + len(self._suppressions_en_attente)
        un_envoi_en_cours = bool(self._file_validation_en_cours)
        self.widget_ligne_validation.setVisible(nb_modifs > 0 or un_envoi_en_cours)
        self.bouton_valider_modifications.setEnabled(nb_modifs > 0 and not un_envoi_en_cours)
        self.bouton_annuler_modifications.setEnabled(nb_modifs > 0 and not un_envoi_en_cours)
        if not un_envoi_en_cours:
            self.label_modifications_attente.setText(
                f"{nb_modifs} modification(s) en attente de validation."
                if nb_modifs else ""
            )
            self.bouton_valider_modifications.setText(f"Valider les modifications ({nb_modifs})" if nb_modifs else "Valider les modifications")

    def _reconstruire_table(self):
        # Préserve les cases cochées avant reconstruction (le listing
        # cloud peut être rafraîchi -- cf. Actualiser/après un envoi --
        # sans que l'utilisateur veuille perdre sa sélection en cours
        # pour l'envoi vers un sAutoniax).
        noms_coches_avant = set(self._noms_profils_coches())

        self.table_profils.blockSignals(True)  # évite un itemChanged par ligne pendant la reconstruction
        self.table_profils.setSortingEnabled(False)
        self.table_profils.clear()

        for nom_profil in sorted(self._profils_cloud.keys()):
            infos = self._profils_cloud[nom_profil]
            meta = infos.get("meta") or {}

            proxy_configure = meta.get("proxy_configure")
            pays = meta.get("pays")
            # PATCH ("ip", demande explicite utilisateur : "sa naffihce
            # pas les adresse ip") -- même source (meta, déjà téléchargé
            # depuis <nom>.meta.json), aucun appel réseau supplémentaire.
            ip = meta.get("ip")
            date_envoi_iso = meta.get("date_envoi_iso")
            # PATCH ("Type", demande explicite utilisateur : "affiche le
            # type de navigateur utilisé, camoufox, ou chrom") -- même
            # source meta (déjà téléchargé), "?" pour un profil envoyé
            # avant ce patch (meta.json existant sans ce champ).
            type_instance = meta.get("type_instance")
            libelle_type = {"chrome": "Chrome", "camoufox": "Camoufox", "cloakbrowser": "CloakBrowser", "feather": "Feather"}.get(type_instance, "?")

            if self._filtre_badge == "avec_proxy" and not proxy_configure:
                continue
            if self._filtre_badge == "sans_proxy" and proxy_configure:
                continue

            # PATCH (boutons Renommer/Supprimer) -- une ligne marquée
            # pour suppression reste affichée (barrée) jusqu'à la
            # validation, plutôt que de disparaître immédiatement --
            # cohérent avec "rien n'est appliqué avant Valider" : la
            # faire disparaître tout de suite laisserait croire que
            # c'est déjà fait côté cloud.
            marquee_suppression = nom_profil in self._suppressions_en_attente
            nom_affiche = self._renommages_en_attente.get(nom_profil, nom_profil)

            # PATCH ("Taille", demande explicite utilisateur : "affihcer
            # aussi la taille en mo des profils") -- taille_octets déjà
            # connue (cf. sur_resultat_liste_stockage, lue depuis "Size"
            # du .zip S3 via lister_avec_taille côté serveur), aucun
            # appel réseau supplémentaire nécessaire. "?" si inconnue
            # (ex. ancien serveurT sans ce champ, cf. repli objets/cles
            # plus haut).
            taille_octets = infos.get("taille_octets")
            texte_taille = _formater_taille_octets_mo(taille_octets) if taille_octets is not None else "?"

            item = QTreeWidgetItem()
            item.setText(0, f"{nom_affiche} (supprimé après validation)" if marquee_suppression else nom_affiche)
            item.setText(1, texte_taille)
            item.setText(2, self._formater_date(date_envoi_iso))
            item.setText(3, "Oui" if proxy_configure else ("Non" if proxy_configure is not None else "?"))
            item.setText(4, ip or "?")
            item.setText(5, pays or "?")
            item.setText(6, libelle_type)
            item.setText(7, "--")  # dernière exécution -- cf. docstring de classe, pas encore câblé
            item.setFlags(item.flags() | Qt.ItemIsUserCheckable)
            item.setCheckState(0, Qt.Checked if nom_profil in noms_coches_avant else Qt.Unchecked)
            if marquee_suppression:
                police = item.font(0)
                police.setStrikeOut(True)
                for colonne in range(8):
                    item.setFont(colonne, police)
            elif nom_profil in self._renommages_en_attente:
                police = item.font(0)
                police.setItalic(True)
                item.setFont(0, police)

            if pays and len(pays) == 2:
                code_pays = pays.upper()
                self._demander_drapeau(code_pays)
                pixmap = self._pixmaps_drapeaux.get(code_pays)
                if pixmap is not None:
                    item.setIcon(5, QIcon(pixmap))

            self.table_profils.addTopLevelItem(item)
            self.table_profils.setItemWidget(
                item, 8, self._construire_widget_badges_cloud(nom_profil, meta, infos.get("meta") is not None)
            )
            self.table_profils.setItemWidget(
                item, 9, self._construire_widget_actions_cloud(nom_profil, marquee_suppression)
            )

        self.table_profils.setSortingEnabled(True)
        self.table_profils.blockSignals(False)
        for i in range(10):
            self.table_profils.resizeColumnToContents(i)
        self._rafraichir_libelle_envoi_sautoniax()

    def _construire_widget_actions_cloud(self, nom_profil: str, marquee_suppression: bool) -> QWidget:
        """Colonne "Actions" -- PATCH (demande explicite utilisateur :
        "je veux que pour chaque profils tu met un bouton de renomage,
        de suppression"). Deux QToolButton, même style que les badges
        de _construire_widget_badges_cloud (AutoRaise, icônes qta).

        Ni l'un ni l'autre ne touche le cloud immédiatement -- même
        principe de validation groupée que les badges (demande
        explicite utilisateur : "ce n'est qu'en appuyant sur le bouton
        de mise à jour que les données sont sauvegardées et appliquées
        sur le cloud") :
        - Renommer ouvre un QInputDialog, puis stocke le nouveau nom
          dans self._renommages_en_attente (ligne repeinte en italique,
          cf. _reconstruire_table) -- rien envoyé avant Valider.
        - Supprimer ouvre un QMessageBox de confirmation (demande
          explicite utilisateur : "le bouton de suppression demande
          une confirmation"), puis stocke le profil dans self.
          _suppressions_en_attente (ligne barrée) -- rien envoyé avant
          Valider.

        Désactivés pendant qu'une validation est déjà en cours d'envoi
        (_file_validation_en_cours non vide), même garde que les
        badges -- évite de marquer un nouveau changement sur une ligne
        dont l'état confirmé est en train de changer sous nos pieds."""
        conteneur = QWidget()
        ligne = QHBoxLayout(conteneur)
        ligne.setContentsMargins(4, 2, 4, 2)
        ligne.setSpacing(6)

        validation_en_cours = bool(self._file_validation_en_cours)

        bouton_renommer = QToolButton(conteneur)
        bouton_renommer.setAutoRaise(True)
        bouton_renommer.setIconSize(QSize(16, 16))
        bouton_renommer.setIcon(qta.icon("mdi6.pencil-outline", color=Mocha.subtext0))
        bouton_renommer.setEnabled(not validation_en_cours and not marquee_suppression)
        if bouton_renommer.isEnabled():
            bouton_renommer.setCursor(Qt.PointingHandCursor)
        bouton_renommer.setToolTip(
            "Marquer ce profil pour renommage (appliqué au clic sur \"Valider les modifications\")"
            if not marquee_suppression else
            "Ce profil est marqué pour suppression -- annule d'abord la suppression pour pouvoir le renommer."
        )
        bouton_renommer.clicked.connect(lambda: self._sur_clic_renommer(nom_profil))
        ligne.addWidget(bouton_renommer)

        bouton_supprimer = QToolButton(conteneur)
        bouton_supprimer.setAutoRaise(True)
        bouton_supprimer.setIconSize(QSize(16, 16))
        bouton_supprimer.setIcon(qta.icon(
            "mdi6.trash-can-outline", color=Mocha.red if marquee_suppression else Mocha.subtext0,
        ))
        bouton_supprimer.setEnabled(not validation_en_cours)
        if bouton_supprimer.isEnabled():
            bouton_supprimer.setCursor(Qt.PointingHandCursor)
        bouton_supprimer.setToolTip(
            "Annuler la suppression prévue de ce profil" if marquee_suppression else
            "Marquer ce profil pour suppression (demande confirmation, appliqué au clic sur \"Valider les modifications\")"
        )
        bouton_supprimer.clicked.connect(lambda: self._sur_clic_supprimer_profil_cloud(nom_profil))
        ligne.addWidget(bouton_supprimer)

        ligne.addStretch(1)
        return conteneur

    def _sur_clic_renommer(self, nom_profil: str):
        """PATCH (bouton Renommer, demande explicite utilisateur) --
        QInputDialog simple pour saisir le nouveau nom. Validation
        minimale (non vide, différent de l'actuel, pas déjà utilisé par
        un autre profil cloud OU un autre renommage déjà en attente) --
        la vérification définitive "le nom existe déjà sur B2" reste
        faite côté serveur (cf. serveur.py, handler renommer_profil_
        cloud) au moment de la validation, celle-ci n'est qu'un
        confort immédiat pour l'utilisateur."""
        nom_actuel_affiche = self._renommages_en_attente.get(nom_profil, nom_profil)
        nouveau_nom, ok = BoiteDialogueAutoniaX.saisie_texte(
            self, "Renommer le profil",
            f"Nouveau nom pour '{nom_actuel_affiche}' :",
            QLineEdit.EchoMode.Normal, nom_actuel_affiche,
        )
        if not ok:
            return
        nouveau_nom = nouveau_nom.strip()
        if not nouveau_nom or nouveau_nom == nom_profil:
            self._renommages_en_attente.pop(nom_profil, None)
            self._rafraichir_barre_validation()
            self._reconstruire_table()
            return
        noms_deja_pris = set(self._profils_cloud.keys()) | set(self._renommages_en_attente.values())
        noms_deja_pris.discard(nom_profil)
        if nouveau_nom in noms_deja_pris:
            BoiteDialogueAutoniaX.warning(
                self, "Nom déjà utilisé",
                f"'{nouveau_nom}' est déjà utilisé par un autre profil (ou un autre renommage en attente).",
            )
            return
        self._renommages_en_attente[nom_profil] = nouveau_nom
        self._rafraichir_barre_validation()
        self._reconstruire_table()

    def _sur_clic_supprimer_profil_cloud(self, nom_profil: str):
        """PATCH (bouton Supprimer, demande explicite utilisateur : "le
        bouton de suppresion demande une confirmation"). Un second clic
        sur une ligne déjà marquée annule la suppression prévue, sans
        redemander de confirmation (annuler n'est pas destructif)."""
        if nom_profil in self._suppressions_en_attente:
            self._suppressions_en_attente.discard(nom_profil)
            self._rafraichir_barre_validation()
            self._reconstruire_table()
            return
        nom_affiche = self._renommages_en_attente.get(nom_profil, nom_profil)
        confirme = BoiteDialogueAutoniaX.question(
            self, "Supprimer le profil",
            f"Supprimer '{nom_affiche}' du cloud ?\n\n"
            "Cette action ne sera réellement appliquée qu'au clic sur "
            "\"Valider les modifications\".",
        )
        if not confirme:
            return
        self._suppressions_en_attente.add(nom_profil)
        # Un profil marqué pour suppression n'a plus de sens à renommer
        # en même temps -- on annule un éventuel renommage en attente
        # pour éviter d'envoyer les deux dans la même validation (cf.
        # _sur_clic_valider_modifications, qui traite déjà les
        # suppressions après les renommages, mais autant éviter la
        # confusion visuelle d'une ligne à la fois italique et barrée).
        self._renommages_en_attente.pop(nom_profil, None)
        self._rafraichir_barre_validation()
        self._reconstruire_table()

    def _sur_clic_supprimer_rapide(self):
        """PATCH (onglet "Action rapide", demande explicite utilisateur :
        "ajouter un ontre onglet en bas : action rapide, et a linterieur
        tu vas mettre suprimer, sa vas suprimer ceux qui sont cocher") --
        version groupée de _sur_clic_supprimer_profil_cloud juste
        au-dessus (même mécanisme exact : marque dans _suppressions_en_
        attente, rien n'est envoyé au serveurT avant "Valider les
        modifications") appliquée à TOUS les profils actuellement cochés
        dans le tableau au-dessus (cf. _noms_profils_coches, même
        sélection que l'onglet "Transfert de profils" juste à côté), en
        une seule confirmation pour tout le lot plutôt qu'une par
        profil. Ne fait rien si aucun profil n'est coché (bouton
        désactivé dans ce cas, cf. _rafraichir_libelle_envoi_sautoniax,
        mais garde défensive quand même)."""
        noms_coches = self._noms_profils_coches()
        if not noms_coches:
            return
        noms_a_afficher = [self._renommages_en_attente.get(nom, nom) for nom in noms_coches]
        if len(noms_a_afficher) == 1:
            message = f"Supprimer '{noms_a_afficher[0]}' du cloud ?"
        else:
            message = (
                f"Supprimer ces {len(noms_a_afficher)} profils du cloud ?\n\n- "
                + "\n- ".join(noms_a_afficher)
            )
        confirme = BoiteDialogueAutoniaX.question(
            self, "Supprimer les profils cochés",
            message + "\n\nCette action ne sera réellement appliquée qu'au clic sur "
            "\"Valider les modifications\".",
        )
        if not confirme:
            return
        for nom_profil in noms_coches:
            self._suppressions_en_attente.add(nom_profil)
            # Même raison que _sur_clic_supprimer_profil_cloud : un
            # renommage en attente sur un profil qu'on vient de marquer
            # pour suppression n'a plus de sens, on l'annule.
            self._renommages_en_attente.pop(nom_profil, None)
        self._rafraichir_barre_validation()
        self._reconstruire_table()

    def _construire_widget_badges_cloud(self, nom_profil: str, meta: dict, meta_deja_resolu: bool) -> QWidget:
        """Colonne "Badges" de Profils Cloud -- PATCH (demande explicite
        utilisateur : "je veux que il soit aussi activable", clarifié :
        "en cloud ça persiste sur le cloud"). Mêmes 5 icônes que
        ProfilsLocalScreen._construire_widget_badges (cf. sa docstring
        pour couleurs/icônes).

        PATCH (validation groupée -- demande explicite utilisateur : "sa
        doit dabord modifier juste la stcuture en local, apres il yauras
        un bouton mise a jour pour vraiment modifie sur le cloud") -- un
        clic ne persiste plus RIEN sur le cloud immédiatement : il
        bascule l'état dans _modifications_en_attente (mémoire locale
        uniquement) et repeint le badge dans un style "modifié, non
        validé" (bordure orange) pour rester visible même après un tri/
        redimensionnement de la table. La vraie écriture sur B2 n'a lieu
        qu'au clic sur "Valider les modifications" (cf. _sur_clic_
        valider_modifications), qui envoie alors demande_maj_meta_profil
        pour chaque modification en attente -- même protocole serveur
        que l'ancien envoi direct, juste différé.

        `meta_deja_resolu` (bool) : False tant que le .meta.json de CE
        profil n'a pas encore été téléchargé/parsé (cf. sur_meta_profil_
        recu) -- les boutons restent alors DÉSACTIVÉS (grisés, non
        cliquables) plutôt que de risquer un clic qui basculerait "depuis
        False" un badge en réalité déjà True côté cloud mais pas encore
        connu ici (écraserait silencieusement l'état réel par une
        supposition fausse)."""
        conteneur = QWidget()
        ligne = QHBoxLayout(conteneur)
        ligne.setContentsMargins(4, 2, 4, 2)
        ligne.setSpacing(6)

        modifs_profil = self._modifications_en_attente.get(nom_profil, {})

        specs = [
            ("youtube", "mdi6.youtube", "mdi6.youtube", Mocha.green),
            ("tiktok", "fa5b.tiktok", "fa5b.tiktok", Mocha.green),
            ("ia", "mdi6.robot-outline", "mdi6.robot-outline", Mocha.green),
            ("favori", "mdi6.star", "mdi6.star-outline", Mocha.yellow),
            ("test", "mdi6.bug", "mdi6.bug", Mocha.green),
        ]
        for cle, icone_actif, icone_inactif, couleur_actif in specs:
            bouton_badge = QToolButton(conteneur)
            bouton_badge.setAutoRaise(True)
            bouton_badge.setIconSize(QSize(16, 16))
            bouton_badge.setEnabled(meta_deja_resolu and not self._file_validation_en_cours)

            def _repeindre(btn: QToolButton, cle=cle, icone_actif=icone_actif,
                            icone_inactif=icone_inactif, couleur_actif=couleur_actif,
                            actif: bool = False, modifie: bool = False):
                btn.setIcon(qta.icon(
                    icone_actif if actif else icone_inactif,
                    color=couleur_actif if actif else Mocha.overlay0,
                ))
                # PATCH (validation groupée) -- bordure orange tant que
                # ce badge précis a une modification en attente de
                # validation, pour que l'utilisateur voie d'un coup
                # d'œil quelles lignes/badges seront affectés par le
                # prochain clic sur "Valider les modifications".
                btn.setStyleSheet(
                    f"QToolButton {{ border: 1px solid {Mocha.yellow}; border-radius: 4px; }}" if modifie else ""
                )
                if btn.isEnabled():
                    btn.setCursor(Qt.PointingHandCursor)
                    suffixe = " (modification en attente de validation)" if modifie else ""
                    btn.setToolTip(cle.capitalize() + (" activé (clic pour désactiver)" if actif else " désactivé (clic pour activer)") + suffixe)
                elif self._file_validation_en_cours:
                    btn.setToolTip("Validation en cours...")
                else:
                    btn.setToolTip("Chargement des métadonnées en cours...")

            valeur_confirmee = bool(meta.get(cle))
            en_attente = cle in modifs_profil
            actif_affiche = modifs_profil[cle] if en_attente else valeur_confirmee
            _repeindre(bouton_badge, actif=actif_affiche, modifie=en_attente)

            # CORRECTIF (nom_profil vide envoyé au serveur au clic sur un
            # badge, cf. logs "mettre_a_jour_meta_profil (''.test=True)"
            # -> "Requête invalide" + warning Shiboken "Cannot copy-
            # convert ... bool to C++" juste avant) : QToolButton.clicked
            # émet un signal clicked(bool checked). Qt/PySide passe
            # TOUJOURS ce booléen en argument POSITIONNEL au slot
            # connecté -- il écrasait donc systématiquement `nom_profil=
            # nom_profil` (lié par défaut, 1er paramètre) avec `False` à
            # CHAQUE clic, sur CHAQUE badge, quel que soit le profil
            # réellement cliqué. `False` transitait ensuite tel quel
            # jusqu'à demande_maj_meta_profil (Signal(str, str, bool)),
            # où Shiboken échouait à convertir ce bool en str pour le 1er
            # paramètre -- d'où le warning Shiboken ET nom_profil=""
            # côté serveur (conversion échouée => valeur vide). Même
            # bug, même correctif déjà appliqué à ProfilsLocalScreen
            # (cf. sa propre _sur_clic, juste en dessous dans ce fichier)
            # mais jamais reporté ici -- corrigé maintenant : `_checked`
            # absorbe ce booléen Qt en premier paramètre positionnel,
            # `nom_profil` (et les autres, déjà liés par défaut) ne sont
            # alors plus jamais écrasés.
            def _sur_clic(_checked=False, nom_profil=nom_profil, cle=cle, btn=bouton_badge,
                          valeur_confirmee=valeur_confirmee, _repeindre=_repeindre):
                modifs_profil_actuel = self._modifications_en_attente.setdefault(nom_profil, {})
                actif_courant = modifs_profil_actuel.get(cle, valeur_confirmee)
                nouvel_etat = not actif_courant
                if nouvel_etat == valeur_confirmee:
                    # Retour à la valeur déjà confirmée côté cloud --
                    # inutile de garder une "modification en attente"
                    # qui ne changerait finalement rien une fois validée.
                    modifs_profil_actuel.pop(cle, None)
                    if not modifs_profil_actuel:
                        self._modifications_en_attente.pop(nom_profil, None)
                else:
                    modifs_profil_actuel[cle] = nouvel_etat
                _repeindre(btn, actif=nouvel_etat, modifie=cle in self._modifications_en_attente.get(nom_profil, {}))
                self._rafraichir_barre_validation()

            bouton_badge.clicked.connect(_sur_clic)
            ligne.addWidget(bouton_badge)

        ligne.addStretch(1)
        return conteneur

    def _noms_profils_coches(self) -> list:
        racine = self.table_profils.invisibleRootItem()
        return [
            racine.child(i).text(0)
            for i in range(racine.childCount())
            if racine.child(i).checkState(0) == Qt.Checked
        ]

    def _sur_case_profil_changee(self, item: QTreeWidgetItem, colonne: int):
        if colonne == 0:
            self._rafraichir_libelle_envoi_sautoniax()

    @staticmethod
    def _formater_date(date_envoi_iso: Optional[str]) -> str:
        if not date_envoi_iso:
            return "?"
        try:
            dt = datetime.fromisoformat(date_envoi_iso)
            return dt.strftime("%d/%m/%Y %H:%M")
        except (ValueError, TypeError):
            return date_envoi_iso

    def _demander_drapeau(self, code_pays: str):
        """Même patron EXACT que ProfilsInstancesScreen._demander_
        drapeau_grille -- cf. sa docstring."""
        if code_pays in self._pixmaps_drapeaux or code_pays in self._codes_pays_demandes:
            return
        self._codes_pays_demandes.add(code_pays)
        self._drapeau_worker.demande_drapeau.emit(code_pays, code_pays)

    def _sur_drapeau_recu(self, code_pays: str, chemin):
        self._codes_pays_demandes.discard(code_pays)
        self._pixmaps_drapeaux[code_pays] = QPixmap(str(chemin)) if chemin else None
        self._reconstruire_table()


class ProfilsLocalScreen(QWidget):
    """Sous-onglet "Profils Local" de ProfilsScreen (PATCH -- demande
    explicite utilisateur : "je veux que tu renomme Profils Cloud en
    Profils tout simplement, bon, je veux que il y ait deux onglets :
    Profils Cloud et profils local ... maintenant sur profils [locaux],
    on doit juste afficher la liste des profils locaux, on peut cocher
    plusieurs et envoyer sur le cloud dans le dossier profils, ça écrase
    ce qui s'y trouve si ça a le même nom").

    Contenu :
    - Table des profils PRÉSENTS SUR LE DISQUE LOCAL (source :
      charger_registre_profils(), même registre que le combo "Envoyer
      un profil" de ProfilsCloudScreen) avec les MÊMES colonnes
      informatives que Profils Cloud (proxy configuré, pays) --
      demande explicite utilisateur ("aussi les infos par profil
      (proxy, pays) comme la table Cloud actuelle") -- mais lues
      directement depuis obtenir_config_profil(nom) (registre LOCAL
      profils_config.json), AUCUN appel réseau/téléchargement de
      meta.json nécessaire ici contrairement à Profils Cloud (dont les
      badges proxy/pays viennent d'un .meta.json distant à
      télécharger) : c'est précisément parce que ce sont des profils
      locaux que l'info est déjà sur disque, immédiatement disponible.
    - Cases à cocher (une par ligne) + bouton "Envoyer vers le cloud" :
      envoie chaque profil coché SÉQUENTIELLEMENT (même patron que
      ProfilsCloudScreen._sur_clic_envoyer_vers_sautoniax -- un seul
      envoi à la fois, la progression de CHAQUE envoi individuel
      affichée en direct) vers Profils/ du bucket -- réutilise TEL
      QUEL le mécanisme demande_envoi_profil déjà câblé côté MainWindow
      (_sur_demande_envoi_profil, cf. ReseauScreen) : AUCUN nouveau
      message serveur, aucune nouvelle logique d'upload, uniquement une
      boucle côté UI qui émet demande_envoi_profil une fois par profil
      coché. Écrase silencieusement un profil du même nom déjà présent
      dans Profils/ (comportement déjà celui de envoyer_profil côté
      serveurT -- un uploader_bytes() sur une clé existante la
      remplace, cf. serveur.py envoyer_profil_fin) -- demande explicite
      utilisateur confirmée ("ça écrase ce qui s'y trouve si ça a le
      même nom").
    - Bouton "Actualiser" : réémet demande_liste_profils_locaux (même
      signal que le combo de ProfilsCloudScreen -- MainWindow répond
      avec la MÊME liste aux deux écrans, cf. ProfilsScreen)."""

    demande_liste_profils_locaux = Signal()
    demande_envoi_profil = Signal(str)

    def __init__(self, parent=None):
        super().__init__(parent)
        self._deja_charge_une_fois = False
        # nom_profil -> {"proxy_configure": bool, "pays": str|None} --
        # peuplé par definir_infos_profils_locaux (MainWindow, à partir
        # de obtenir_config_profil), reconstruit entièrement à chaque
        # appel (même convention que ProfilsCloudScreen._profils_cloud).
        self._infos_profils: dict[str, dict] = {}
        self._noms_profils: list = []

        # --- Cache drapeaux -- même patron EXACT que ProfilsCloudScreen
        # ci-dessus (worker séparé, aucune raison de partager l'instance).
        self._pixmaps_drapeaux: dict[str, Optional[QPixmap]] = {}
        self._codes_pays_demandes: set[str] = set()
        self._drapeau_thread = QThread(self)
        self._drapeau_worker = DrapeauWorker()
        self._drapeau_worker.moveToThread(self._drapeau_thread)
        self._drapeau_thread.start()
        self._drapeau_worker.resultat_pret.connect(self._sur_drapeau_recu)

        # --- Cache tailles de dossiers -- PATCH (demande explicite
        # utilisateur : "sa fait planter lapp" -- le calcul de taille se
        # faisait avant sur le thread GUI, cf. MainWindow._construire_
        # infos_profils_locaux avant ce patch) -- même patron EXACT que
        # le cache drapeaux juste au-dessus : worker dédié dans son
        # propre QThread, une requête par profil (cf. _demander_taille),
        # jamais un seul calcul global bloquant qui attendrait TOUS les
        # profils avant de répondre (demande explicite utilisateur : "sa
        # doit mettre progressivement a jour la valeur des tailles, pas
        # attendre le compte complet avant dactualiser").
        # nom_profil -> taille_octets|None ; présence de la clé = déjà
        # résolu (None = dossier manquant/illisible, distinct de "pas
        # encore demandé").
        self._tailles_profils: dict[str, Optional[int]] = {}
        self._noms_profils_demandes_taille: set[str] = set()
        # nom_profil -> QTreeWidgetItem de la ligne courante -- peuplé
        # par _reconstruire_table, permet à _sur_taille_recue de mettre à
        # jour UNIQUEMENT la cellule "Taille" concernée (item.setText),
        # sans reconstruire toute la table à chaque profil résolu (ce
        # que fait _sur_drapeau_recu ci-dessus, acceptable pour un
        # drapeau -- peu de codes pays distincts -- mais inadapté ici :
        # un profil = un résultat, potentiellement plusieurs dizaines en
        # rafale, chacun redéclenchant la construction de tous les
        # widgets badges/actions serait inutilement coûteux).
        self._items_par_profil: dict[str, QTreeWidgetItem] = {}
        self._taille_thread = QThread(self)
        self._taille_worker = TailleDossierWorker()
        self._taille_worker.moveToThread(self._taille_thread)
        self._taille_thread.start()
        self._taille_worker.resultat_pret.connect(self._sur_taille_recue)

        # File d'attente séquentielle d'envoi (PATCH -- même principe
        # exact que ProfilsCloudScreen._sautoniax_file_profils_a_envoyer,
        # adapté ici à un envoi vers le CLOUD au lieu d'un sAutoniax :
        # demande_envoi_profil ne porte qu'un seul nom à la fois, cf.
        # sa signature Signal(str) partagée avec ProfilsCloudScreen).
        self._file_profils_a_envoyer: list = []
        self._nb_profils_total_envoi = 0
        self._nb_profils_traites_envoi = 0

        layout = QVBoxLayout(self)
        layout.setContentsMargins(24, 20, 24, 20)
        layout.setSpacing(8)

        ligne_haut = QHBoxLayout()
        label_intro = QLabel("Profils présents sur ce poste :", self)
        label_intro.setObjectName("ReglagesLabel")
        label_intro.setWordWrap(True)
        ligne_haut.addWidget(label_intro, stretch=1)

        self.bouton_actualiser = QPushButton("Actualiser", self)
        self.bouton_actualiser.setCursor(Qt.PointingHandCursor)
        self.bouton_actualiser.clicked.connect(self.demande_liste_profils_locaux)
        ligne_haut.addWidget(self.bouton_actualiser, stretch=0)
        layout.addLayout(ligne_haut)

        # --- Table des profils locaux -- mêmes colonnes que Profils
        # Cloud (nom, proxy, pays), sans "Dernière mise à jour" ni
        # "Dernière exécution" (ces deux infos n'ont de sens que côté
        # cloud/exécution distante, cf. docstring de classe : ce sont
        # des profils SUR CE POSTE, pas des envois horodatés). ---
        self.table_profils = QTreeWidget(self)
        self.table_profils.setObjectName("ProfilsLocalTable")
        self.table_profils.setRootIsDecorated(False)
        self.table_profils.setUniformRowHeights(True)
        self.table_profils.setSortingEnabled(True)
        self.table_profils.setSelectionMode(QAbstractItemView.SingleSelection)
        self.table_profils.setSelectionBehavior(QAbstractItemView.SelectRows)
        # PATCH ("ip", demande explicite utilisateur : "sa naffihce pas
        # les adresse ip, sa doit aussi affihcier") -- nouvelle colonne
        # entre "Proxy" et "Pays", même source (obtenir_config_profil,
        # cf. definir_infos_profils_locaux) que les deux autres.
        # PATCH ("taille", demande explicite utilisateur : "affihcer
        # aussi la taille en mo des profils dans les deux table") --
        # colonne "Taille" ajoutée en position 1 (juste après "Profil"),
        # même emplacement relatif que côté ProfilsCloudScreen (avant
        # "Dernière mise à jour" là-bas) : c'est une propriété du
        # fichier/dossier, affichée avant les métadonnées descriptives.
        self.table_profils.setHeaderLabels(["Profil", "Taille", "Proxy", "IP", "Pays", "Badges", "Actions"])
        self.table_profils.header().setStretchLastSection(True)
        self.table_profils.itemChanged.connect(self._sur_case_profil_changee)
        layout.addWidget(self.table_profils, stretch=1)

        self.label_statut_liste = QLabel("", self)
        self.label_statut_liste.setWordWrap(True)
        self.label_statut_liste.setObjectName("PlaceholderSubtitle")
        layout.addWidget(self.label_statut_liste)

        separateur = QFrame(self)
        separateur.setObjectName("ReglagesSeparateur")
        separateur.setFixedHeight(1)
        layout.addWidget(separateur)

        label_envoi = QLabel(
            "Envoie les profils cochés ci-dessus vers Profils/ du cloud "
            "(bucket configuré dans l'onglet Stockage > Identifiant) -- "
            "écrase tout profil du même nom déjà présent :", self)
        label_envoi.setObjectName("ReglagesLabel")
        label_envoi.setWordWrap(True)
        layout.addWidget(label_envoi)

        self.bouton_envoyer = QPushButton("Envoyer vers le cloud", self)
        self.bouton_envoyer.setCursor(Qt.PointingHandCursor)
        self.bouton_envoyer.setEnabled(False)  # activé dès qu'au moins un profil est coché
        self.bouton_envoyer.clicked.connect(self._sur_clic_envoyer)
        layout.addWidget(self.bouton_envoyer)

        self.barre_progression = QProgressBar(self)
        self.barre_progression.setObjectName("ProfilEnvoiProgress")
        self.barre_progression.setTextVisible(True)
        self.barre_progression.setVisible(False)
        layout.addWidget(self.barre_progression)

        self.label_statut_envoi = QLabel("", self)
        self.label_statut_envoi.setWordWrap(True)
        self.label_statut_envoi.setObjectName("PlaceholderSubtitle")
        layout.addWidget(self.label_statut_envoi)

    def showEvent(self, event):
        """Même patron que ProfilsCloudScreen.showEvent -- charge
        automatiquement au tout premier affichage."""
        super().showEvent(event)
        if not self._deja_charge_une_fois:
            self._deja_charge_une_fois = True
            self.demande_liste_profils_locaux.emit()

    def definir_infos_profils_locaux(self, infos: dict):
        """Appelé par MainWindow (cf. definir_profils_disponibles
        ci-dessous pour la liste des NOMS -- ceci porte les infos
        proxy/pays PAR profil) : {nom: {"proxy_configure": bool,
        "pays": str|None}}, construit à partir de
        obtenir_config_profil(nom) pour chaque profil du registre local
        -- aucun appel réseau, lecture disque directe côté MainWindow
        (même esprit que ProfilsCloudScreen._sur_demande_envoi_profil,
        qui construit déjà `meta` de la même façon)."""
        self._infos_profils = dict(infos)
        self._reconstruire_table()

    def definir_profils_disponibles(self, noms_profils: list):
        """Peuple la liste des noms affichés -- MÊME signal
        demande_liste_profils_locaux que ProfilsCloudScreen.combo_profils,
        connecté à la MÊME réponse côté MainWindow (cf. ProfilsScreen,
        qui relaie ce signal aux deux écrans à la fois)."""
        self._noms_profils = sorted(noms_profils, key=str)
        self.label_statut_liste.setText(f"{len(self._noms_profils)} profil(s) sur ce poste.")
        self._reconstruire_table()

    def _reconstruire_table(self):
        noms_coches_avant = set(self._noms_profils_coches())

        self.table_profils.blockSignals(True)
        self.table_profils.setSortingEnabled(False)
        self.table_profils.clear()

        self._items_par_profil.clear()

        for nom_profil in self._noms_profils:
            infos = self._infos_profils.get(nom_profil, {})
            proxy_configure = infos.get("proxy_configure")
            pays = infos.get("pays")
            ip = infos.get("ip")
            # PATCH ("taille", demande explicite utilisateur : "affihcer
            # aussi la taille en mo des profils dans les deux table",
            # puis "sa fait planter lapp" -- calcul déplacé dans
            # TailleDossierWorker, sur un QThread séparé, JAMAIS ici sur
            # le thread GUI) -- si déjà résolu (présent dans le cache
            # _tailles_profils, y compris None = dossier manquant/
            # illisible), affiche le résultat tout de suite ; sinon "?"
            # provisoire ET déclenche la demande de calcul en tâche de
            # fond (cf. _demander_taille) -- _sur_taille_recue mettra à
            # jour CETTE seule cellule dès que le résultat arrivera, la
            # table entière n'est jamais reconstruite pour ça (PATCH,
            # demande explicite utilisateur : "sa doit mettre
            # progressivement a jour la valeur des tailles, pas attendre
            # le compte complet avant dactualiser").
            if nom_profil in self._tailles_profils:
                taille_octets = self._tailles_profils[nom_profil]
                texte_taille = _formater_taille_octets_mo(taille_octets) if taille_octets is not None else "?"
            else:
                texte_taille = "?"
                self._demander_taille(nom_profil)

            item = QTreeWidgetItem()
            item.setText(0, nom_profil)
            item.setText(1, texte_taille)
            item.setText(2, "Oui" if proxy_configure else ("Non" if proxy_configure is not None else "?"))
            # PATCH ("ip", demande explicite utilisateur) -- colonne 3,
            # même convention "?" que les autres colonnes quand l'info
            # n'a jamais été résolue (aucun test de proxy réussi encore).
            item.setText(3, ip or "?")
            item.setText(4, pays or "?")
            item.setFlags(item.flags() | Qt.ItemIsUserCheckable)
            item.setCheckState(0, Qt.Checked if nom_profil in noms_coches_avant else Qt.Unchecked)

            if pays and len(pays) == 2:
                code_pays = pays.upper()
                self._demander_drapeau(code_pays)
                pixmap = self._pixmaps_drapeaux.get(code_pays)
                if pixmap is not None:
                    item.setIcon(4, QIcon(pixmap))

            self.table_profils.addTopLevelItem(item)
            self.table_profils.setItemWidget(item, 5, self._construire_widget_badges(nom_profil, infos))
            self.table_profils.setItemWidget(item, 6, self._construire_widget_actions(nom_profil))
            self._items_par_profil[nom_profil] = item

        self.table_profils.setSortingEnabled(True)
        self.table_profils.blockSignals(False)
        for i in range(7):
            self.table_profils.resizeColumnToContents(i)
        self._rafraichir_libelle_envoi()

    def _demander_taille(self, nom_profil: str):
        """Déclenche le calcul de taille du dossier d'UN profil sur le
        QThread dédié (cf. _taille_worker) -- jamais de calcul synchrone
        ici (PATCH, demande explicite utilisateur : "sa fait planter
        lapp"). N'émet qu'une seule requête par profil tant qu'elle n'a
        pas abouti (même garde-fou que _demander_drapeau, via l'ensemble
        _noms_profils_demandes_taille) -- une reconstruction de table
        pendant qu'un calcul est déjà en vol (ex. clic sur "Actualiser"
        avant la fin du calcul précédent) ne relance pas une deuxième
        requête pour le même profil."""
        if nom_profil in self._tailles_profils or nom_profil in self._noms_profils_demandes_taille:
            return
        chemin_dossier = charger_registre_profils().get(nom_profil)
        if chemin_dossier is None:
            # Profil listé mais absent du registre local (course avec une
            # suppression concurrente) -- pas de dossier à mesurer,
            # affiché comme non résolu plutôt que de bloquer sur un
            # chemin inexistant.
            self._tailles_profils[nom_profil] = None
            return
        self._noms_profils_demandes_taille.add(nom_profil)
        self._taille_worker.demande_taille.emit(nom_profil, chemin_dossier)

    def _sur_taille_recue(self, nom_profil: str, taille_octets):
        """Reçu depuis _taille_worker (QThread séparé) -- met à jour
        UNIQUEMENT la cellule "Taille" de la ligne concernée via
        item.setText, sans reconstruire toute la table (contrairement à
        _sur_drapeau_recu) : c'est précisément ce qui permet à chaque
        ligne de s'actualiser au fur et à mesure, indépendamment des
        autres profils encore en cours de calcul (PATCH, demande
        explicite utilisateur : "sa doit mettre progressivement a jour
        la valeur des tailles, pas attendre le compte complet avant
        dactualiser").

        Le profil peut avoir disparu de la table entre-temps (Actualiser
        recliqué, ou profil supprimé pendant le calcul) -- item absent de
        _items_par_profil dans ce cas, résultat simplement mis en cache
        pour un futur affichage sans rien redessiner."""
        self._noms_profils_demandes_taille.discard(nom_profil)
        self._tailles_profils[nom_profil] = taille_octets
        item = self._items_par_profil.get(nom_profil)
        if item is None:
            return
        texte_taille = _formater_taille_octets_mo(taille_octets) if taille_octets is not None else "?"
        item.setText(1, texte_taille)

    def _construire_widget_badges(self, nom_profil: str, infos: dict) -> QWidget:
        """Colonne "Badges" -- PATCH (demande explicite utilisateur :
        "youtube, tiktok, ia ...", confirmée "idit tout" -> les 5 badges
        existants). Réutilise les MÊMES icônes/couleurs que
        ProfilsGridItemDelegate.paint (cf. son bloc badges plus haut dans
        le fichier) pour rester visuellement cohérent avec les cartes de
        ProfilsInstancesScreen -- vert si actif, gris (Mocha.overlay0) si
        inactif, jaune (Mocha.yellow) pour Favori actif (seul badge à
        couleur distincte, même raison que sur les cartes : un favori
        n'est pas un "réseau activé"). Les 5 icônes sont TOUJOURS
        affichées (contrairement au delegate des cartes qui masque un
        badge si sa donnée est totalement absente) -- ici `infos` vient
        toujours de obtenir_config_profil (setdefault sur tous les
        champs), donc jamais None, juste vert ou gris.

        PATCH (demande explicite utilisateur : "je veux que il soit
        aussi activable" -- puis clarifié : "en local ça persiste sur le
        disque") -- chaque icône est désormais un QToolButton cliquable
        (pas un QLabel statique) : un clic bascule l'état ET l'écrit
        IMMÉDIATEMENT sur disque via definir_<badge>_config_profil (même
        fonction que le clic sur les cartes de ProfilsInstancesScreen,
        cf. _on_clic_badge_youtube_pour_profil et consorts -- persistance
        identique, profils_config.json). Seule l'icône cliquée est
        repeinte (icon()/setIcon()), pas de reconstruction de toute la
        table pour un simple toggle."""
        conteneur = QWidget()
        ligne = QHBoxLayout(conteneur)
        ligne.setContentsMargins(4, 2, 4, 2)
        ligne.setSpacing(6)

        # (clé, icône "actif", icône "inactif", couleur "actif", fonction de persistance)
        specs = [
            ("youtube", "mdi6.youtube", "mdi6.youtube", Mocha.green, definir_youtube_config_profil),
            ("tiktok", "fa5b.tiktok", "fa5b.tiktok", Mocha.green, definir_tiktok_config_profil),
            ("ia", "mdi6.robot-outline", "mdi6.robot-outline", Mocha.green, definir_ia_config_profil),
            ("favori", "mdi6.star", "mdi6.star-outline", Mocha.yellow, definir_favori_config_profil),
            ("test", "mdi6.bug", "mdi6.bug", Mocha.green, definir_test_config_profil),
        ]
        for cle, icone_actif, icone_inactif, couleur_actif, fonction_persistance in specs:
            bouton_badge = QToolButton(conteneur)
            bouton_badge.setAutoRaise(True)
            bouton_badge.setCursor(Qt.PointingHandCursor)
            bouton_badge.setIconSize(QSize(16, 16))

            def _repeindre(btn: QToolButton, cle=cle, icone_actif=icone_actif,
                            icone_inactif=icone_inactif, couleur_actif=couleur_actif, actif: bool = False):
                btn.setIcon(qta.icon(
                    icone_actif if actif else icone_inactif,
                    color=couleur_actif if actif else Mocha.overlay0,
                ))
                btn.setToolTip(cle.capitalize() + (" activé (clic pour désactiver)" if actif else " désactivé (clic pour activer)"))

            _repeindre(bouton_badge, actif=bool(infos.get(cle)))

            # CORRECTIF #2 (retour utilisateur explicite, très clair : "je
            # met le badges je narrive meme plus a enlever lorsque je
            # reclic dessus") -- cause : nouvel_etat était calculé en
            # RELISANT LE DISQUE à chaque clic (obtenir_config_profil(...)
            # .get(cle)) plutôt qu'à partir de ce qui est RÉELLEMENT
            # affiché à l'écran. Si la première écriture avait échoué ou
            # si le disque contenait une valeur différente de l'affichage
            # pour toute autre raison, chaque clic recalculait depuis
            # cette valeur périmée -- pouvant reproduire le même état au
            # lieu de vraiment le basculer, donnant l'impression que le
            # clic "n'enlève plus rien". `etat_actuel` est maintenant une
            # variable normale (pas une relecture disque), mise à jour
            # UNIQUEMENT après un succès d'écriture confirmé -- le
            # basculement suit alors TOUJOURS ce qui est affiché, jamais
            # le disque.
            etat_actuel = bool(infos.get(cle))

            # CORRECTIF RÉEL DU BUG (trouvé via logs massifs -- merci
            # d'avoir insisté) : QToolButton.clicked émet un signal
            # clicked(bool checked). Qt/PySide passe TOUJOURS ce booléen
            # en argument POSITIONNEL au slot connecté -- il écrasait
            # donc systématiquement `nom_profil=nom_profil` (lié par
            # défaut) avec `False` à CHAQUE clic, sur CHAQUE bouton,
            # quel que soit le profil réellement cliqué. C'est pour ça
            # que les logs montraient nom_profil=False (type=bool) sur
            # tous les clics, alors que la construction de la table
            # elle-même n'avait jamais de nom non-string : les entrées
            # fantômes "false"/"False" nettoyées au tour précédent
            # n'étaient qu'une coïncidence de nommage, pas la cause.
            # FIX : `_checked` absorbe ce booléen Qt en premier
            # paramètre positionnel : `nom_profil` (et les autres,
            # déjà liés par défaut) ne sont alors plus jamais écrasés.
            def _sur_clic(_checked=False, nom_profil=nom_profil, cle=cle, fonction_persistance=fonction_persistance,
                          btn=bouton_badge, _repeindre=_repeindre):
                nonlocal etat_actuel
                nouvel_etat = not etat_actuel
                ok = fonction_persistance(nom_profil, nouvel_etat)
                if not ok:
                    self.label_statut_liste.setText(
                        f"Échec d'enregistrement du badge '{cle}' pour '{nom_profil}' "
                        "-- vérifie que le dossier de données est accessible en écriture."
                    )
                    return
                etat_actuel = nouvel_etat
                self._infos_profils.setdefault(nom_profil, {})[cle] = nouvel_etat
                infos[cle] = nouvel_etat
                _repeindre(btn, actif=nouvel_etat)

            bouton_badge.clicked.connect(_sur_clic)
            ligne.addWidget(bouton_badge)

        ligne.addStretch(1)
        return conteneur

    def _construire_widget_actions(self, nom_profil: str) -> QWidget:
        """Colonne "Actions" -- PATCH (demande explicite utilisateur :
        "pourquoi tu na pas mis la colonne des actions aussi dans
        profils Local", après l'avoir ajoutée côté Profils Cloud).
        Contrairement à ProfilsCloudScreen._construire_widget_actions_
        cloud (qui DIFFÈRE l'action jusqu'au bouton "Valider les
        modifications" -- coût réseau à chaque action), ici renommer/
        supprimer sont des opérations DISQUE LOCAL immédiates, donc
        appliquées tout de suite au clic, même philosophie que les
        badges de ce même écran (cf. _construire_widget_badges,
        persistance immédiate via definir_<badge>_config_profil).
        Réutilise TELLES QUELLES les fonctions module renommer_profil/
        supprimer_profil + renommer_config_profil/supprimer_config_
        profil, déjà utilisées par ProfilsInstancesScreen (même
        registre profils.json/profils_config.json -- un profil renommé/
        supprimé ici est immédiatement cohérent avec l'onglet
        Instances).

        Ne vérifie PAS si le profil a une instance active dans l'onglet
        Instances (demande explicite utilisateur : "je m'en occupe
        manuellement" -- pas géré pour l'instant) : contrairement à
        ProfilsInstancesScreen._on_clic_renommer_profil/_on_clic_
        supprimer_profil qui bloquent/arrêtent l'instance en cours,
        renommer ou supprimer ici un profil actuellement lancé sur
        Instances désynchronisera son nom affiché là-bas, ou pire pour
        une suppression -- risque connu et accepté pour l'instant."""
        conteneur = QWidget()
        ligne = QHBoxLayout(conteneur)
        ligne.setContentsMargins(4, 2, 4, 2)
        ligne.setSpacing(6)

        bouton_renommer = QToolButton(conteneur)
        bouton_renommer.setAutoRaise(True)
        bouton_renommer.setIconSize(QSize(16, 16))
        bouton_renommer.setIcon(qta.icon("mdi6.pencil-outline", color=Mocha.subtext0))
        bouton_renommer.setCursor(Qt.PointingHandCursor)
        bouton_renommer.setToolTip("Renommer ce profil (appliqué immédiatement)")
        bouton_renommer.clicked.connect(lambda: self._sur_clic_renommer_local(nom_profil))
        ligne.addWidget(bouton_renommer)

        bouton_supprimer = QToolButton(conteneur)
        bouton_supprimer.setAutoRaise(True)
        bouton_supprimer.setIconSize(QSize(16, 16))
        bouton_supprimer.setIcon(qta.icon("mdi6.trash-can-outline", color=Mocha.subtext0))
        bouton_supprimer.setCursor(Qt.PointingHandCursor)
        bouton_supprimer.setToolTip("Supprimer ce profil du disque (demande confirmation)")
        bouton_supprimer.clicked.connect(lambda: self._sur_clic_supprimer_local(nom_profil))
        ligne.addWidget(bouton_supprimer)

        ligne.addStretch(1)
