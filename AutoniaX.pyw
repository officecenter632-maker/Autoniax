        self.floating_add_button.setToolTip("Nouveau Task")
        self.floating_add_button.clicked.connect(self._creer_task)
        self.floating_add_button.raise_()

        # PATCH demandé par l'utilisateur : "que on puisse importer un
        # notebook" -- bouton flottant dédié, positionné juste à GAUCHE du
        # bouton "+" (cf. _repositionner_bouton_flottant ci-dessous, même
        # marge/alignement vertical) plutôt qu'un item de menu caché : la
        # grille (vue liste des Tasks) est le bon endroit puisque
        # l'import crée toujours un NOUVEAU Task, contrairement à l'export
        # qui lui reste dans le menu ⋮ de l'éditeur (agit sur le Task
