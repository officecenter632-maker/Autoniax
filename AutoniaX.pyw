        # 260px de large) et "le contenu doit etre toujours directement en
        # bas [...] pas a droite ni a gauche, en bas" (West : le contenu
        # se retrouvait à DROITE de la colonne d'onglets, pas en dessous).
        #
        # Solution retenue : une colonne de QToolButton checkables (un par
        # ServiceAPI, cf. _construire_barre_onglets), dans un QScrollArea
        # de hauteur plafonnée à MAX_ONGLETS_VISIBLES onglets -- décision
        # explicite utilisateur : "3 noms de service dépasser sa devient
        # scroll, pas plus" -- SANS scrollbar visible (retour explicite :
        # "ne met pas de scrollbar visible... mais la surface reste
        # scrollable", molette/drag seulement). Piloté par un QButtonGroup
        # exclusif qui bascule la page correspondante d'un QStackedWidget
        # affiché juste EN DESSOUS de cette colonne -- jamais à droite.
        self.barre_onglets_scroll, self._onglets_layout, self._boutons_service = (
            self._construire_barre_onglets()
        )
        root_layout.addWidget(self.barre_onglets_scroll)

        self._separateur_onglets = QFrame(self)
        self._separateur_onglets.setObjectName("PanneauComposantsImportesSeparateur")
        self._separateur_onglets.setFixedHeight(1)
        root_layout.addWidget(self._separateur_onglets)

        self.stack = QStackedWidget(self)
        self.stack.setObjectName("PanneauComposantsImportesStack")
        root_layout.addWidget(self.stack, 1)

        # Placeholder ("Aucun ServiceAPI importé...") affiché HORS de la
        # barre d'onglets et du stack (aucun sens à afficher un onglet
        # unique vide) -- recréé/masqué dans rafraichir() selon qu'il y a
        # ou non des ServiceAPI importés.
        self.placeholder_label = QLabel(
            "Aucun ServiceAPI importé.\nCliquez sur « + » pour en importer un.",
            self,
        )
        self.placeholder_label.setObjectName("PlaceholderSubtitle")
        self.placeholder_label.setWordWrap(True)
        self.placeholder_label.setAlignment(Qt.AlignCenter)
        self.placeholder_label.setContentsMargins(16, 16, 16, 16)
        self.placeholder_label.setVisible(False)
        root_layout.addWidget(self.placeholder_label, 1)

    def _construire_barre_onglets(self):
        """Construit la colonne de "onglets" (QToolButton checkables, un
        par ServiceAPI) -- cf. commentaire d'__init__ pour le pourquoi de
        cette implémentation plutôt qu'un QTabWidget natif. Retourne
        (scroll_area, layout_interne, dict_boutons_vide) ; le dict des
        boutons est rempli au fil de rafraichir()/_construire_onglet_service,
        PAS ici (cette méthode ne construit que le conteneur, encore vide,
        cf. self._boutons_par_service qui lui accumule les boutons réels)."""
        scroll = QScrollArea(self)
        scroll.setObjectName("PanneauComposantsImportesOngletsScroll")
        scroll.setWidgetResizable(True)
        scroll.setFrameShape(QFrame.NoFrame)
        scroll.setHorizontalScrollBarPolicy(Qt.ScrollBarAlwaysOff)
        # AlwaysOff ET non AsNeeded : la scrollbar elle-même doit rester
        # invisible (retour explicite utilisateur, cf. commentaire
        # d'__init__) -- la zone reste scrollable à la molette/au drag
        # malgré l'absence de piste/curseur visible, exactement comme
        # #FlowGridViewport ailleurs dans ce panneau.
        scroll.setVerticalScrollBarPolicy(Qt.ScrollBarAlwaysOff)
        scroll.setFixedHeight(self.HAUTEUR_ONGLET * self.MAX_ONGLETS_VISIBLES)
        scroll.setVisible(False)  # masqué tant qu'aucun ServiceAPI n'est importé

        contenu = QWidget(scroll)
        contenu.setObjectName("PanneauComposantsImportesOngletsContenu")
        layout = QVBoxLayout(contenu)
        layout.setContentsMargins(0, 0, 0, 0)
        layout.setSpacing(0)
        scroll.setWidget(contenu)

        return scroll, layout, {}

    def definir_contexte_reseau(self, noms_executants_reseau: dict, profils_reseau_actifs: dict):
        """PATCH (cf. docstring de self._noms_executants_reseau_ref dans
        __init__) -- appelé par TaskConfigScreen juste avant chaque
        rafraichir(task) quand ce Task est en mode "reseau", pour que le
        libellé de statut affiché (cf. _libelle_liaison) reflète le nom du
        profil cloud actuellement actif plutôt que l'id_executant brut.
        Simple stockage de RÉFÉRENCE (pas de copie) : ces dicts continuent
        d'être mutés par TaskConfigScreen lui-même, jamais par ce panneau."""
        self._noms_executants_reseau_ref = noms_executants_reseau
        self._profils_reseau_actifs_ref = profils_reseau_actifs

    def _libelle_liaison(self, task: Task, instance_id: str) -> str:
        """Résout le TEXTE à afficher pour la liaison de CE ServiceAPI.

        BUGFIX (SPEC_profils_environnements.md) : en mode "reseau",
        `instance_id` (= task.services_api_importes[nom_service]) vaut
        désormais DIRECTEMENT le nom du profil actif (cf. _definir_profil_
        actif, qui y écrit nom_profil tel quel -- plus un id_executant),
        donc il EST déjà le libellé à afficher, exactement comme en mode
        "local" où instance_id est aussi directement affichable (ex.
        "auto-1") -- même comportement dans les deux modes désormais.
        Ancienne résolution via self._profils_reseau_actifs_ref retirée :
        ce dict est indexé par (task_id, id_executant), mécanisme distinct
        et plus ancien lié à l'initialisation d'un exécutant (cf. sa
        docstring) -- une recherche dessus avec un nom de profil en clé
        ne pouvait jamais aboutir, le libellé de liaison restait donc
        bloqué sur "non lié" même après sélection d'un profil actif.

        BUGFIX (audit clé composite, REFONTE MULTI-SAUTONIAX) : la
        prémisse ci-dessus n'est plus exacte -- _definir_profil_actif
        écrit désormais une CLÉ COMPOSITE (id_executant::nom_profil, cf.
        _cle_profil_clone) dans task.services_api_importes[nom_service]
        en mode réseau, pas le nom nu. Renvoyer instance_id tel quel
        affichait donc la clé technique brute dans ce panneau. En mode
        "local", instance_id reste un vrai identifiant d'instance
        directement affichable (inchangé) -- seule la branche réseau a
        besoin d'une extraction explicite du nom nu."""
        if task.mode_execution == "reseau" and instance_id:
            return _nom_depuis_cle_profil_clone(instance_id)
        return instance_id

    def resizeEvent(self, event):   # PATCH20
        super().resizeEvent(event)
        l = self.width()
        if self.LARGEUR_MIN_SPLITTER <= l <= self.LARGEUR_MAX_SPLITTER:
            self._largeur_memorisee = l

    def _basculer_replie(self, replie: bool):
        """Connecté à bouton_replier.toggled -- bascule la largeur fixe du
        panneau entre LARGEUR_DEPLOYEE et LARGEUR_REPLIEE, et masque tout
        ce qui ne tiendrait pas dans la bande étroite repliée (titre,
        bouton "+", barre d'onglets et stack -- seul le bouton chevron
        reste visible/cliquable pour redéplier). Pas de persistance sur
        disque (contrairement à TaskCellule.repliee) : décision volontaire
        -- ce panneau est REPLIÉ à chaque ouverture du Task (cf.
        TaskConfigScreen._ouvrir_task_impl, étape "finitions"), cf.
        absence de tout champ dédié côté Task/TaskCellule pour cet état."""
        # PATCH20 : contraintes min/max + taille posee dans le splitter parent
        if replie:
            self.setMinimumWidth(self.LARGEUR_REPLIEE)
            self.setMaximumWidth(self.LARGEUR_REPLIEE)
            largeur_cible = self.LARGEUR_REPLIEE
        else:
            self.setMinimumWidth(self.LARGEUR_MIN_SPLITTER)
            self.setMaximumWidth(self.LARGEUR_MAX_SPLITTER)
            largeur_cible = self._largeur_memorisee
        sp = self.parentWidget()
        if isinstance(sp, QSplitter):
            s = sp.sizes()
            sp.setSizes([largeur_cible, max(1, sum(s) - largeur_cible)])
            # PATCH (demande explicite utilisateur : réduire drastiquement l'espace
            # entre le notebook et le panneau gauche replié) : poignée fine tant
            # que le panneau est replié, largeur normale une fois déplié.
            sp.setHandleWidth(4 if replie else 8)
        # PATCH : en-tête compact (chevron seul, quasi sans marge) quand replié.
        if replie:
            self._header_layout.setContentsMargins(1, 12, 1, 12)
            self.bouton_replier.setStyleSheet("padding: 3px;")
        else:
            self._header_layout.setContentsMargins(14, 12, 14, 12)
            self.bouton_replier.setStyleSheet("")
        self._titre_label.setVisible(not replie)
        self.import_button.setVisible(not replie)
        y_a_des_services = self.stack.count() > 0
        self.barre_onglets_scroll.setVisible(not replie and y_a_des_services)
        self._separateur_onglets.setVisible(not replie and y_a_des_services)
        self.stack.setVisible(not replie and y_a_des_services)
        self.placeholder_label.setVisible(not replie and not y_a_des_services)
        self.bouton_replier.setIcon(self._icone_repliee if replie else self._icone_deployee)
        self.bouton_replier.setToolTip(
            "Déplier le panneau des composants importés" if replie
            else "Replier le panneau des composants importés"
        )

    def rafraichir(self, task: Optional[Task]):
        """Reconstruit entièrement la barre d'onglets et le QStackedWidget
        (un "onglet" par ServiceAPI importé dans ce Task) depuis le
        Project (recalculé à chaque appel, cf.
        Project.composants_importes_task -- reste toujours à jour si des
        composants ont été ajoutés/supprimés côté ServiceAPI depuis
        l'import initial dans ce Task).

        Cf. commentaire d'__init__ pour le choix de cette implémentation
        (colonne de boutons + QStackedWidget) plutôt qu'un QTabWidget natif.
        L'onglet actuellement sélectionné est préservé d'un rafraîchissement
        à l'autre quand ce ServiceAPI est toujours importé (sinon un simple
        clic sur « choisir une instance » -- qui déclenche aussi un
        rafraîchissement -- ramènerait sans arrêt au premier onglet)."""
        nom_service_actif = None
        if self.stack.count() > 0:
            index_actif = self.stack.currentIndex()
            if index_actif >= 0:
                widget_actif = self.stack.widget(index_actif)
                nom_service_actif = widget_actif.property("nom_service")

        while self._onglets_layout.count():
            item = self._onglets_layout.takeAt(0)
            widget = item.widget()
            if widget is not None:
                widget.setParent(None)
                widget.deleteLater()
        while self.stack.count():
            widget = self.stack.widget(0)
            self.stack.removeWidget(widget)
            if widget is not None:
                widget.setParent(None)
                widget.deleteLater()
        self._sections_par_groupe = {}
        self._scrolls_par_service = {}
        self._boutons_par_service = {}

        if task is None:
            self._afficher_placeholder()
            return

        groupes = self.project.composants_importes_task(task)
        # CORRECTIF (retour utilisateur : "sa ne met pas les
        # composantLayout") -- ce panneau n'affichait jusqu'ici QUE les
        # ComposantSingle (composants_importes_task), jamais les
        # ComposantLayout du Task (composants_layout_importes_task),
        # contrairement à l'auto-complétion de TaskScriptEditor qui avait
        # déjà reçu ce même correctif (cf. TaskConfigScreen.
        # _rafraichir_composants_connus_editeur). Fusionne les deux
        # sources PAR ServiceAPI (même clé), en respectant l'ordre des
        # groupes déjà présent puis en ajoutant les ServiceAPI qui
        # n'auraient QUE des ComposantLayout importés (aucun ComposantSingle) :
        # groupes est un dict standard, donc dict.setdefault ci-dessous
        # préserve l'ordre d'insertion existant plutôt que de le refondre.
        groupes_layout = self.project.composants_layout_importes_task(task)
        for nom_service, composants_layout in groupes_layout.items():
            if not composants_layout:
                continue
            groupes.setdefault(nom_service, [])
            groupes[nom_service] = list(groupes[nom_service]) + list(composants_layout)
        if not groupes:
            self._afficher_placeholder()
            return

        self.placeholder_label.setVisible(False)
        self.barre_onglets_scroll.setVisible(True)
        self._separateur_onglets.setVisible(True)
        self.stack.setVisible(True)

        groupe_boutons = QButtonGroup(self)
        groupe_boutons.setExclusive(True)
        self._groupe_boutons_onglets = groupe_boutons  # référence forte -- sinon garbage-collecté

        index_a_restaurer = 0
        for index, (nom_service, composants) in enumerate(groupes.items()):
            self._construire_onglet_service(task, nom_service, composants, index, groupe_boutons)
            if nom_service == nom_service_actif:
                index_a_restaurer = index

        groupe_boutons.button(index_a_restaurer).setChecked(True)
        self.stack.setCurrentIndex(index_a_restaurer)

    def _construire_onglet_service(
        self, task: Task, nom_service: str, composants: list, index: int, groupe_boutons: QButtonGroup,
    ):
        """Construit à la fois le bouton d'onglet (colonne de gauche, cf.
        _construire_barre_onglets) et la page de contenu correspondante
        (self.stack) pour le ServiceAPI nom_service : EnteteServiceAPITask
        (nom, statut de liaison, liens de groupes) EN DEHORS du QScrollArea
        de cette page -- décision explicite utilisateur : "le header...
        vont rester statique ainsi facile pour naviguer" -- suivi d'un
        QScrollArea propre à CETTE page contenant les sous-sections de
        groupes (même logique de répartition par groupe qu'avant)."""
        bouton = QToolButton(self)
        bouton.setObjectName("OngletServiceAPIBouton")
        bouton.setText(nom_service)
        bouton.setCheckable(True)
        bouton.setCursor(Qt.PointingHandCursor)
        bouton.setFixedHeight(self.HAUTEUR_ONGLET)
        bouton.setToolTip(nom_service)
        # elideMode natif de QToolButton pour un texte trop long -- pas
        # besoin de dessin custom ici (contrairement à l'ancien essai
        # QTabBar) puisque chaque bouton dispose de toute la largeur du
        # panneau, sur sa propre ligne.
        fm = bouton.fontMetrics()
        bouton.setText(fm.elidedText(nom_service, Qt.ElideRight, self.LARGEUR_DEPLOYEE - 24))
        groupe_boutons.addButton(bouton, index)
        bouton.clicked.connect(lambda checked=False, i=index: self.stack.setCurrentIndex(i))
        self._onglets_layout.addWidget(bouton)
        self._boutons_par_service[nom_service] = bouton

        page = QWidget(self.stack)
        page.setProperty("nom_service", nom_service)
        page_layout = QVBoxLayout(page)
        page_layout.setContentsMargins(0, 0, 0, 0)
        page_layout.setSpacing(0)

        # Répartit les composants importés de CE ServiceAPI par groupe
        # (Général d'abord, puis service_api.groupes dans l'ordre) --
        # même logique que ComposantsScreen._charger_grille_composants.
        # Les groupes créés côté ServiceAPI mais qui n'ont aucun composant
        # importé dans CE Task précis sont omis : rien à afficher ni à
        # cibler pour eux dans ce panneau.
        service_api = self.project.find_service_api(nom_service)
        noms_groupes_ordonnes = service_api.groupes if service_api else []
        composants_par_groupe: dict = {"": []}
        for nom_groupe in noms_groupes_ordonnes:
            composants_par_groupe.setdefault(nom_groupe, [])
        for composant in composants:
            # getattr(..., "") plutôt que composant.groupe direct : un
            # ComposantLayout (fusionné ci-dessus dans groupes, cf.
            # _construire_barre_onglets) n'a PAS de champ groupe
            # (SPEC_composantLayout.md section 3.3, absent
            # délibérément) -- toujours classé en "Général" ici, faute
            # de notion de groupe pour ce type.
            composants_par_groupe.setdefault(getattr(composant, "groupe", ""), []).append(composant)

        noms_groupes_presents = [
            (ng, "Général" if ng == "" else ng)
            for ng in [""] + list(noms_groupes_ordonnes)
            if composants_par_groupe.get(ng)
        ]
        # Le lien "Général" ne s'affiche que si ce ServiceAPI a par
        # ailleurs au moins un AUTRE groupe (cf. docstring
        # EnteteServiceAPITask) -- avec un seul groupe implicite
        # ("Général" seul), la rangée de liens n'apporterait rien puisqu'il
        # n'y a alors rien d'autre vers quoi naviguer.
        liens_groupes = noms_groupes_presents if len(noms_groupes_presents) > 1 else []

        instance_id = task.services_api_importes.get(nom_service, "")
        libelle_liaison = self._libelle_liaison(task, instance_id) if instance_id else instance_id
        entete = EnteteServiceAPITask(
            nom_service, instance_id, liens_groupes, page, libelle=libelle_liaison,
            mode_reseau=(task.mode_execution == "reseau"),
        )
        entete.clique.connect(self.demande_liaison_instance.emit)
        entete.nom_copie.connect(self.composant_copie.emit)
        entete.demande_retrait.connect(self.demande_retrait_service_api.emit)
        entete.groupe_choisi.connect(self._scroller_vers_groupe)
        entete.setContentsMargins(12, 10, 12, 10)
        page_layout.addWidget(entete)

        scroll = QScrollArea(page)
        scroll.setObjectName("FlowGridViewport")
        scroll.setWidgetResizable(True)
        scroll.setFrameShape(QFrame.NoFrame)
        scroll.setHorizontalScrollBarPolicy(Qt.ScrollBarAlwaysOff)
        scroll.setVerticalScrollBarPolicy(Qt.ScrollBarAlwaysOff)

        contenu = QWidget(scroll)
        contenu_layout = QVBoxLayout(contenu)
        contenu_layout.setContentsMargins(12, 8, 12, 10)
        contenu_layout.setSpacing(14)
        contenu_layout.setAlignment(Qt.AlignTop)
        scroll.setWidget(contenu)
        page_layout.addWidget(scroll, 1)
        self._scrolls_par_service[nom_service] = scroll

        self.stack.addWidget(page)

        if not composants:
            vide_label = QLabel("Aucun composant.", contenu)
            vide_label.setObjectName("PlaceholderSubtitle")
            contenu_layout.addWidget(vide_label)
            return

        for nom_groupe, libelle in [("", "Général")] + [(g, g) for g in noms_groupes_ordonnes]:
            composants_du_groupe = composants_par_groupe.get(nom_groupe, [])
            if not composants_du_groupe:
                continue
            sous_section = QWidget(contenu)
            sous_section_layout = QVBoxLayout(sous_section)
            sous_section_layout.setContentsMargins(0, 0, 0, 0)
            sous_section_layout.setSpacing(4)

            # Sous-titre de groupe -- affiché seulement s'il y a plus d'un
            # groupe à distinguer ici (même condition que liens_groupes,
            # cf. plus haut) : avec un seul groupe implicite ("Général"
            # seul), répéter "Général" au-dessus de la grille n'apporterait
            # rien.
            if liens_groupes:
                titre_groupe = QLabel(libelle, sous_section)
                titre_groupe.setObjectName("PanneauComposantsGroupeTitre")
                sous_section_layout.addWidget(titre_groupe)

            grille = FlowGrid(item_width=112, spacing=8)
            for composant in composants_du_groupe:
                tuile = ComposantImportTuile(composant, sous_section)
                tuile.clique.connect(self._sur_clic_composant)
                tuile.demande_ouvrir_coordonnee_action.connect(self.demande_ouvrir_coordonnee_action.emit)
                grille.add_item(tuile)
            sous_section_layout.addWidget(grille)

            contenu_layout.addWidget(sous_section)
            # Mémorisé pour le scroll animé (cf. _scroller_vers_groupe),
            # même si liens_groupes est vide ici (Général seul, rien à
            # cibler en pratique -- inoffensif de le garder).
            self._sections_par_groupe[(nom_service, nom_groupe)] = sous_section

    def _afficher_placeholder(self):
        self.barre_onglets_scroll.setVisible(False)
        self._separateur_onglets.setVisible(False)
        self.stack.setVisible(False)
        self.placeholder_label.setVisible(True)

    def _sur_clic_composant(self, nom_composant: str):
        nom_variable = nom_variable_python(nom_composant)
        QGuiApplication.clipboard().setText(nom_variable)
        self.composant_copie.emit(nom_variable)

    def _scroller_vers_groupe(self, nom_service: str, nom_groupe: str):
        """Handler de EnteteServiceAPITask.groupe_choisi (décision
        explicite utilisateur : "lorsque on clic sur un groupe... ça doit
        nous slider jusqu'à cet endroit") -- bascule d'abord sur l'onglet
        de nom_service (un scroll cible un widget caché dans un AUTRE
        onglet n'aurait aucun effet visible, et sa géométrie n'est de
        toute façon fiable qu'une fois l'onglet réellement affiché), PUIS
        fait défiler le QScrollArea propre à CET onglet jusqu'à la
        sous-section du groupe visé, en animant la scrollbar verticale
        plutôt qu'un saut instantané. Même pattern que
        ComposantsScreen._scroller_vers_groupe (cf. ce widget-là pour le
        détail du calcul de position), dupliqué ici plutôt que partagé :
        les deux panneaux naviguent dans des QScrollArea complètement
        indépendants, sans classe commune utile à en extraire pour
        l'instant."""
        sous_section = self._sections_par_groupe.get((nom_service, nom_groupe))
        scroll = self._scrolls_par_service.get(nom_service)
        if sous_section is None or scroll is None:
            return

        bouton = self._boutons_par_service.get(nom_service)
        if bouton is not None and not bouton.isChecked():
            bouton.setChecked(True)
        index_page = self.stack.indexOf(scroll.parentWidget())
        if index_page >= 0:
            self.stack.setCurrentIndex(index_page)

        barre = scroll.verticalScrollBar()
        cible_y = sous_section.mapTo(scroll.widget(), QPoint(0, 0)).y()
        marge = 8
        valeur_cible = max(barre.minimum(), min(barre.maximum(), cible_y - marge))

        if self._scroll_animation is not None:
            self._scroll_animation.stop()

        animation = QPropertyAnimation(barre, b"value", self)
        animation.setDuration(350)
        animation.setStartValue(barre.value())
        animation.setEndValue(valeur_cible)
        animation.setEasingCurve(QEasingCurve.OutCubic)
        self._scroll_animation = animation
        animation.start()


# ---------------------------------------------------------------------------
# Panneau droit "Accès rapide" de l'éditeur de Task (décision explicite
# utilisateur : "puisque notre editeur est un notebook python je veux que
# tu met le numeros et le tuitre de sa celleule pour que si on clic dessus
# alors linterface slide directement jusqua ce niveau") -- une tuile par
# cellule du notebook (row 0 incluse : cellules[0] ET cellule_variables,
# puis cellules[1:] dans leur ordre), numéro de position (PAS numero_execution/
# In[n], qui peut être None tant que la cellule n'a jamais tourné -- ici
# c'est un simple repère d'ordre dans le notebook, toujours défini) + début
# du titre Markdown de la cellule (ou "(sans titre)" si vide). Clic = signal
# relayé à TaskConfigScreen qui fait défiler jusqu'au widget concerné (cf.
# TaskConfigScreen._sur_clic_acces_rapide).
# ---------------------------------------------------------------------------

class AccesRapideItem(QFrame):
    """Une tuile cliquable de la bande d'accès rapide -- numéro + titre
    tronqué (cf. docstring BarreAccesRapideTask). Widget volontairement
    "bête" (pas de connaissance du notebook ni du scroll réel) : elle émet
    juste son cellule_id au clic, TaskConfigScreen s'occupe du slide --
    même séparation de responsabilité que TaskCelluleWidget/demande_execution."""

    clique = Signal(str)  # cellule_id
    # AJOUT (demande explicite utilisateur : "je modifie de tel sorte que
    # clic droit ramene plutot a la sortie de ces cellule") -- même tuile,
    # même geste que pour bouton_executer/BoutonAjoutCellule
    # (cf. QToolButtonAvecClicDroit) : clic gauche = comportement existant
    # (aller au début/titre de la cellule, inchangé), clic droit = aller
    # directement à sa zone_sortie plutôt qu'à son sommet.
    clique_droit = Signal(str)  # cellule_id

    def __init__(self, cellule_id: str, numero: int, titre: str, parent=None):
        super().__init__(parent)
        self.cellule_id = cellule_id
        self.setObjectName("AccesRapideItem")
        self.setCursor(Qt.PointingHandCursor)

        layout = QHBoxLayout(self)
        layout.setContentsMargins(8, 6, 8, 6)
        layout.setSpacing(6)

        self.label_numero = QLabel(f"[{numero}]", self)
        self.label_numero.setObjectName("AccesRapideItemNumero")
        self.label_numero.setFixedWidth(28)
        layout.addWidget(self.label_numero)

        # Titre Markdown brut affiché tel quel, tronqué -- un simple aperçu
        # de repérage n'a pas besoin d'un rendu Markdown complet (cf.
        # CelluleZoneMarkdown, réservé à l'édition réelle du titre).
        titre_affiche = titre.strip() or "(sans titre)"
        if len(titre_affiche) > 42:
            titre_affiche = titre_affiche[:39] + "…"
        self.label_titre = QLabel(titre_affiche, self)
        self.label_titre.setObjectName("AccesRapideItemTitre")
        self.label_titre.setWordWrap(False)
        layout.addWidget(self.label_titre, 1)

    def definir_titre(self, titre: str):
        """Rafraîchit le libellé affiché sans reconstruire toute la tuile
        -- appelé par BarreAccesRapideTask.rafraichir_titre pour éviter
        de reconstruire toute la liste (et donc perdre la position de
        scroll de la bande) à chaque frappe dans le champ titre d'une
        cellule."""
        titre_affiche = titre.strip() or "(sans titre)"
        if len(titre_affiche) > 42:
            titre_affiche = titre_affiche[:39] + "…"
        self.label_titre.setText(titre_affiche)

    def mousePressEvent(self, event):
        if event.button() == Qt.LeftButton:
            self.clique.emit(self.cellule_id)
        elif event.button() == Qt.RightButton:
            # cf. clique_droit ci-dessus : va directement à la sortie de
            # cette cellule au lieu de son début -- return immédiat
            # (comme QToolButtonAvecClicDroit) pour ne pas laisser
            # remonter un menu contextuel par défaut sur ce clic droit.
            self.clique_droit.emit(self.cellule_id)
            return
        super().mousePressEvent(event)


class BarreAccesRapideTask(QWidget):
    """PATCH (retour utilisateur : "es ce que tu peu une fois mettre la
    liste ici, je veux que tu met l'acces rapide ici, des bouton que
    quand on clique dessus sa rapmende directement a la celleule voulu.
    donc t'enleve le paneau flottant actuels") -- remplace ENTIÈREMENT
    l'ancien panneau flottant vertical (PanneauAccesRapideTask +
    ZoneSensibleAccesRapide au survol du bord droit, cf. leur historique
    dans les commentaires de _build_editeur) par une bande FIXE pleine
    largeur, ajoutée juste sous la toolbar/label_statut_reseau et
    au-dessus de `corps` (cf. TaskConfigScreen._build_editeur) -- même
    emplacement que l'utilisateur a entouré d'un rectangle sur une
    capture d'écran de l'éditeur.

    Différences structurelles avec l'ancienne version :
    - Plus de survol/disparition : cette bande fait partie du layout
      normal en permanence (comme n'importe quelle autre barre de
      l'éditeur), donc plus de ZoneSensibleAccesRapide, plus de
      eventFilter/QTimer de fermeture différée côté TaskConfigScreen.
    - Liste HORIZONTALE scrollable (QScrollArea horizontal) au lieu
      d'une colonne verticale -- une bande pleine largeur mais de
      hauteur fixe modeste n'a la place d'empiler les tuiles que côte à
      côte, pas les unes sous les autres.
    - Le drag du notebook (NotebookDragHandle) et le bouton "Copier
      docs" (DocIACopyButton) ne vivent plus ici : le premier existe
      déjà en double dans la toolbar principale (cf.
      NotebookDragHandleCompact/bouton_drag_notebook) et le second est
      déplacé à côté de lui (cf. TaskConfigScreen._build_editeur) --
      cette bande ne contient donc plus QUE la liste de cellules,
      contrairement à l'ancien panneau qui empilait aussi ces deux
      actions globales en bas.

    Réutilise AccesRapideItem tel quel (même tuile [numéro] + titre,
    même signal clique) -- seul le CONTENEUR change de forme, pas la
    tuile elle-même."""

    demande_acces_cellule = Signal(str)  # cellule_id
    # cf. AccesRapideItem.clique_droit -- clic droit sur une tuile va
    # directement à la sortie de la cellule visée plutôt qu'à son début.
    demande_acces_sortie_cellule = Signal(str)  # cellule_id

    def __init__(self, parent=None):
        super().__init__(parent)
        self.setObjectName("BarreAccesRapideTask")
        self._items: dict = {}  # cellule_id -> AccesRapideItem, cf. rafraichir_titre

        root_layout = QHBoxLayout(self)
        root_layout.setContentsMargins(12, 6, 12, 6)
        root_layout.setSpacing(8)

        titre_label = QLabel("Accès rapide", self)
        titre_label.setObjectName("BarreAccesRapideLabel")
        root_layout.addWidget(titre_label)

        self.scroll = QScrollArea(self)
        self.scroll.setObjectName("BarreAccesRapideScroll")
        self.scroll.setWidgetResizable(True)
        self.scroll.setFrameShape(QFrame.NoFrame)
        self.scroll.setHorizontalScrollBarPolicy(Qt.ScrollBarAsNeeded)
        self.scroll.setVerticalScrollBarPolicy(Qt.ScrollBarAlwaysOff)
        # Hauteur fixe = hauteur d'une tuile + marges du scroll -- une
        # bande d'accès rapide n'a pas vocation à grandir verticalement
        # quel que soit le nombre de cellules (contrairement à l'ancien
        # panneau vertical) : le débordement se gère par scroll
        # horizontal, pas par une bande qui grossirait avec le notebook.
        self.scroll.setFixedHeight(44)

        self.contenu = QWidget(self.scroll)
        self.contenu_layout = QHBoxLayout(self.contenu)
        self.contenu_layout.setContentsMargins(4, 4, 4, 4)
        self.contenu_layout.setSpacing(6)
        self.contenu_layout.setAlignment(Qt.AlignLeft)
        self.scroll.setWidget(self.contenu)
        root_layout.addWidget(self.scroll, 1)

    def rafraichir(self, task: Optional[Task]):
        """Reconstruit entièrement la liste depuis task.cellules +
        task.cellule_variables -- même contrat exact que l'ancien
        PanneauAccesRapideTask.rafraichir (cf. son historique), appelé
        aux mêmes points (ouverture de Task, ajout/suppression de
        cellule)."""
        while self.contenu_layout.count():
            item = self.contenu_layout.takeAt(0)
            w = item.widget()
            if w is not None:
                w.setParent(None)
                w.deleteLater()
        self._items.clear()

        if task is None:
            self._afficher_placeholder()
            return

        # Même ordre VISUEL que _peupler_cellules (cellule_variables
        # avant cellules[0]) -- cf. docstring de l'ancien
        # PanneauAccesRapideTask.rafraichir pour le détail complet du
        # raisonnement, inchangé ici.
        numero = 0
        if task.cellule_variables is not None:
            self._ajouter_item(task.cellule_variables.id, numero, task.cellule_variables.titre)
            numero += 1
        if task.cellules:
            self._ajouter_item(task.cellules[0].id, numero, task.cellules[0].titre)
            numero += 1
        for cellule in task.cellules[1:]:
            self._ajouter_item(cellule.id, numero, cellule.titre)
            numero += 1

        if not self._items:
            self._afficher_placeholder()

    def _ajouter_item(self, cellule_id: str, numero: int, titre: str):
        item = AccesRapideItem(cellule_id, numero, titre, self.contenu)
        # Largeur maximale par tuile (contrairement à l'ancien panneau
        # vertical où chaque tuile prenait toute la largeur disponible,
        # cf. son layout.addWidget(item.label_titre, 1) sans limite) :
        # une bande horizontale doit pouvoir aligner plusieurs tuiles
        # côte à côte sans qu'un seul titre long n'en avale toute la
        # largeur visible.
        item.setMaximumWidth(180)
        item.clique.connect(self.demande_acces_cellule.emit)
        item.clique_droit.connect(self.demande_acces_sortie_cellule.emit)
        self.contenu_layout.addWidget(item)
        self._items[cellule_id] = item

    def rafraichir_titre(self, cellule_id: str, titre: str):
        """Mise à jour légère d'une seule tuile -- même contrat exact
        que l'ancien PanneauAccesRapideTask.rafraichir_titre."""
        item = self._items.get(cellule_id)
        if item is not None:
            item.definir_titre(titre)

    def _afficher_placeholder(self):
        placeholder_label = QLabel("Aucune cellule.", self.contenu)
        placeholder_label.setObjectName("AccesRapideVide")
        self.contenu_layout.addWidget(placeholder_label)


# ---------------------------------------------------------------------------
# Format texte "copier/coller le code du notebook" -- REMPLACE le geste de
# drag du fichier .autoniaxtask entier (demande explicite utilisateur : "au
# lieu de faire un drag, je veux que quand on clic dessus ça copie juste le
# code de chaque cellule ... un motif pour distinguer les cellules, ce même
# motif sera utilisé pour coller le code complet du notebook").
#
# Chaque cellule (cellule_variables PUIS task.cellules, dans l'ordre -- même
# ordre que _executer_toutes_les_cellules/_sur_clic_copier_toutes_cellules)
# est sérialisée en un bloc :
#
#   # ==== CELLULE #<rang> titre="<titre>" ====
#   # description: <description>
#   <code>
#
# <rang> est la POSITION de la cellule dans le notebook (0 = cellule_
# variables, 1..N = task.cellules dans l'ordre), PAS son id interne --
# décision explicite utilisateur : "son id doit être en fonction du
# classement interne par le logiciel, pas récupérer l'id bêtement", pour
# que coller ce texte dans N'IMPORTE QUEL notebook (même un autre, ou le
# même après réouverture) recale chaque bloc sur LA cellule qui occupe
# cette position-là, plutôt que de dépendre d'un id opaque qui n'a de sens
# que dans le notebook d'origine.
_MOTIF_ENTETE_CELLULE = re.compile(
    r'^#\s*====\s*CELLULE\s*#(?P<rang>\d+)\s*titre="(?P<titre>.*?)"\s*====\s*$'
)
_MOTIF_LIGNE_DESCRIPTION = re.compile(r'^#\s*description:\s?(?P<description>.*)$')


def _construire_bloc_cellule_texte(rang: int, titre: str, description: str, code: str) -> str:
    """Sérialise UNE cellule (titre/description/code) au format ci-dessus.
    `titre` ne doit jamais contenir de guillemet double ni de retour à la
    ligne (les deux cassent le motif d'en-tête sur un aller-retour) -- les
    deux sont neutralisés ici plutôt que de complexifier le motif pour un
    cas marginal (titre multi-lignes n'a de toute façon aucun sens pour un
    titre de cellule)."""
    titre_sur = (titre or "").replace('"', "'").replace("\n", " ").strip()
    entete = f'# ==== CELLULE #{rang} titre="{titre_sur}" ===='
    # description toujours sur une seule ligne d'en-tête -- une description
    # multi-lignes est aplatie ici (perte acceptée : le motif de reprise au
    # collage s'arrête à la première ligne qui ne matche plus _MOTIF_LIGNE_
    # DESCRIPTION, donc une vraie description multi-lignes serait de toute
    # façon coupée au collage si elle était sérialisée telle quelle).
    description_sur = (description or "").replace("\n", " ⏎ ").strip()
    ligne_description = f"# description: {description_sur}"
    return f"{entete}\n{ligne_description}\n{code or ''}"


def _construire_texte_notebook_complet(task: "Task") -> str:
    """Concatène le bloc de cellule_variables (rang 0) puis celui de
    chaque task.cellules (rang 1..N), séparés par une ligne vide -- même
    ordre que _sur_clic_copier_toutes_cellules, décision explicite
    utilisateur : "l'inclure comme les autres cellules" pour cellule_
    variables."""
    blocs: list[str] = []
    if task.cellule_variables is not None:
        blocs.append(_construire_bloc_cellule_texte(
            0, task.cellule_variables.titre, task.cellule_variables.description,
            task.cellule_variables.code,
        ))
    for rang, cellule in enumerate(task.cellules, start=1):
        blocs.append(_construire_bloc_cellule_texte(rang, cellule.titre, cellule.description, cellule.code))
    return "\n\n".join(blocs)


# En-tête explicatif du fichier .py exporté par NotebookDragHandleCompact
# (demande explicite utilisateur : "je veux que lorsqu'on clique sur le
# bouton de copie de code, ça le copie directement sous forme de fichier
# python pour que l'édition soit facile, et à l'entête de ce fichier
# python tu dois expliquer exactement comment fonctionne ce fichier là")
# -- des commentaires PURS (aucun code exécutable) : le parser (cf.
# _parser_texte_notebook_colle) ignore silencieusement tout ce qui
# précède le premier "# ==== CELLULE #0 ... ====", donc cet en-tête ne
# perturbe jamais un futur collage de ce même fichier dans AutoniaX.
_ENTETE_FICHIER_NOTEBOOK_PY = '''\
# =============================================================================
# Fichier généré par AutoniaX -- export du CODE de toutes les cellules d'un
# notebook (Task), pour édition facile dans un vrai éditeur externe.
#
# COMMENT ÇA MARCHE :
#
# 1. Chaque cellule du notebook est délimitée par un en-tête reconnaissable :
#
#        # ==== CELLULE #<rang> titre="<titre de la cellule>" ====
#        # description: <description de la cellule>
#        <code de la cellule, sur autant de lignes que nécessaire>
#
#    <rang> est la POSITION de la cellule dans le notebook, PAS un
#    identifiant interne : 0 = la cellule "Variable dynamique" (tout en
#    haut du notebook), 1, 2, 3... = les cellules suivantes, dans l'ordre
#    où elles apparaissent dans AutoniaX.
#
# 2. Vous pouvez modifier LIBREMENT le titre, la description et le code
#    de chaque cellule directement dans ce fichier, avec n'importe quel
#    éditeur de texte ou IDE, MAIS :
#    - le titre ne doit contenir ni guillemet double (") ni retour à la
#      ligne (les deux cassent la ligne d'en-tête au prochain collage) ;
#    - la description doit rester sur UNE SEULE ligne (une description
#      multi-lignes serait coupée à la première ligne au collage) ;
#    - le CODE d'une cellule ne doit jamais contenir une ligne qui
#      ressemble à "# ==== CELLULE #... ====" (même en commentaire ou en
#      exemple) : elle serait alors lue comme le début d'une NOUVELLE
#      cellule au moment du collage.
#
# 3. CE N'EST PAS UN SCRIPT PYTHON AUTONOME -- ce fichier n'est jamais
#    exécuté tel quel (ni par vous, ni par AutoniaX). C'est une VUE TEXTE
#    d'un notebook, où chaque cellule s'exécute dans UN SEUL espace de
#    noms Python PARTAGÉ pour tout le Task (exactement comme un notebook
#    Jupyter) : une variable ou fonction définie dans une cellule reste
#    disponible dans toutes les suivantes, sans réimport. Conséquence
#    directe pour le CODE de chaque cellule :
#    - N'AJOUTEZ JAMAIS de bloc "if __name__ == '__main__':" -- il n'y a
#      pas de point d'entrée unique à protéger, chaque cellule EST déjà
#      son propre point d'entrée, exécutée directement au moment voulu
#      (soit individuellement, soit via "Tout exécuter" dans l'ordre :
#      "# Variable dynamique" en premier, puis "# Main", puis les
#      suivantes dans leur ordre d'affichage) ; un tel bloc empêcherait
#      simplement le code qu'il contient de s'exécuter.
#    - N'ajoutez pas non plus de fonction main() appelée en fin de
#      fichier "à l'ancienne" (def main(): ... ; main()) SAUF si c'est
#      déjà le style utilisé dans la cellule d'origine -- le code au
#      niveau racine de la cellule s'exécute déjà tel quel, une
#      indirection supplémentaire n'apporte rien ici.
#    - Ne réimportez pas ce qui est déjà importé par une cellule
#      précédente de CE MÊME notebook (une cellule plus haut dans l'ordre
#      d'exécution) : l'import reste disponible, comme dans Jupyter.
#    - Respectez le modèle d'exécution et les fonctions/objets déjà
#      disponibles sans import documentés dans l'onglet "Documentation
#      pour IA" d'AutoniaX (ResultatAction, ZoneClicRect,
#      extraire_texte_fichier, Api2Api, etc.) plutôt que d'en inventer ou
#      d'en deviner de nouveaux.
#
# 4. Pour renvoyer vos modifications dans AutoniaX, il FAUT repartir du
#    TEXTE de ce fichier, jamais du fichier lui-même :
#    a. Ouvrez ce fichier .py dans un éditeur de texte ou IDE.
#    b. Sélectionnez tout son contenu et copiez-le (Ctrl+A puis Ctrl+C)
#       DANS CET ÉDITEUR -- pas depuis l'explorateur de fichiers, pas en
#       recliquant sur le bouton qui a généré ce fichier dans AutoniaX.
#    c. Revenez dans AutoniaX et cliquez sur le bouton "Coller" (à côté du
#       bouton qui a généré ce fichier) dans la barre d'outils du notebook
#       ouvert. Chaque cellule existante à la position <rang> est alors
#       mise à jour (titre, description et code) ; si un rang dépasse le
#       nombre de cellules déjà présentes, une NOUVELLE cellule est créée
#       à la fin.
#    Le bouton "Coller" lit TOUJOURS le texte actuellement dans le
#    presse-papier système, jamais un fichier sur disque -- c'est un choix
#    assumé, pas une limitation à contourner. Cliquer sur le bouton qui a
#    généré ce fichier place une RÉFÉRENCE vers ce fichier .py dans le
#    presse-papier (comme un Ctrl+C d'un fichier dans l'Explorateur), PAS
#    son texte : un "Coller" fait juste après ce clic-là ne lira donc rien
#    d'utile, quel que soit le contenu de ce fichier. Le texte doit
#    provenir d'un vrai Ctrl+C fait DANS un éditeur de texte, sur CE
#    fichier ouvert (étape b ci-dessus).
#
# 5. Aucune cellule n'est jamais supprimée par un collage : un rang
#    absent de ce fichier (si vous effacez un bloc entier) laisse
#    simplement la cellule correspondante inchangée dans AutoniaX. Et si
#    la cellule "# Variable dynamique" (rang 0) elle-même est absente du
#    Task ouvert au moment du collage, le bloc de rang 0 de ce fichier est
#    ignoré (rien à mettre à jour) plutôt que de créer une nouvelle
#    cellule à cette position.
#
# ATTENTION : ne modifiez pas la ligne d'en-tête "# ==== CELLULE #... ===="
# elle-même (le numéro de rang et les guillemets autour du titre doivent
# rester dans ce format exact), sous peine que cette cellule ne soit pas
# reconnue au moment du collage.
#
# 6. SI VOUS DEMANDEZ À UNE IA DE MODIFIER CE FICHIER : demandez-lui de
#    PATCHER les cellules concernées (modifier UNIQUEMENT le code des
#    cellules à changer, en conservant TEL QUEL le reste du fichier --
#    en-tête, cellules non concernées, lignes "# ==== CELLULE #... ===="
#    de toutes les cellules), jamais de réécrire tout le fichier depuis
#    zéro. Une réécriture complète risque de renuméroter, fusionner ou
#    reformuler des cellules qui n'avaient pas besoin de changer, ce qui
#    casse silencieusement le repérage par rang au moment du collage
#    (cf. point 4 ci-dessus) et peut faire perdre du code auquel vous
#    teniez dans une cellule que vous ne vouliez pas toucher.
# =============================================================================

'''


def _construire_fichier_notebook_py(task: "Task") -> str:
    """Fichier .py complet exporté par NotebookDragHandleCompact :
    l'en-tête explicatif ci-dessus, suivi du texte des cellules produit
    par _construire_texte_notebook_complet (même motif, inchangé, que
    celui reconnu par _parser_texte_notebook_colle au collage)."""
    return _ENTETE_FICHIER_NOTEBOOK_PY + _construire_texte_notebook_complet(task)


def _parser_texte_notebook_colle(texte: str) -> dict:
    """Inverse de _construire_texte_notebook_complet : reconnaît chaque
    bloc "# ==== CELLULE #<rang> titre="..." ====" suivi de sa ligne
    "# description: ..." puis du code jusqu'au prochain en-tête (ou la fin
    du texte), et retourne {rang: {"titre":..., "description":..., "code":...}}.

    Best effort : un texte qui ne contient AUCUN en-tête reconnu retourne
    un dict vide (cf. appelant -- traité comme "rien à coller", pas une
    erreur bloquante)."""
    lignes = texte.splitlines()
    blocs: dict[int, dict] = {}
    rang_courant: Optional[int] = None
    titre_courant = ""
    description_courante = ""
    lignes_code: list[str] = []
    attend_description = False

    def _cloturer_bloc_courant():
        if rang_courant is not None:
            blocs[rang_courant] = {
                "titre": titre_courant,
                "description": description_courante,
                "code": "\n".join(lignes_code).strip("\n"),
            }

    for ligne in lignes:
        m_entete = _MOTIF_ENTETE_CELLULE.match(ligne)
        if m_entete is not None:
            _cloturer_bloc_courant()
            rang_courant = int(m_entete.group("rang"))
            titre_courant = m_entete.group("titre")
            description_courante = ""
            lignes_code = []
            attend_description = True
            continue
        if attend_description:
            m_desc = _MOTIF_LIGNE_DESCRIPTION.match(ligne)
            attend_description = False
            if m_desc is not None:
                description_courante = m_desc.group("description")
                continue
            # Pas de ligne description (texte modifié à la main) : cette
            # ligne fait déjà partie du code, tombe dans la branche normale.
        if rang_courant is not None:
            lignes_code.append(ligne)
    _cloturer_bloc_courant()
    return blocs


class NotebookDragHandleCompact(QToolButton):
    """PATCH (demande explicite utilisateur : "au lieu de faire un drag, je
    veux que quand on clic dessus ça copie juste le code de chaque cellule
    au lieu de copier le code de tout le fichier .autoniaxtask") -- remplace
    l'ancien geste de drag (fichier .autoniaxtask entier déposé hors
    d'AutoniaX) par un simple CLIC qui écrit le CODE de toutes les cellules
    du notebook (cellule_variables + task.cellules, dans l'ordre) dans un
    vrai fichier .py sur disque, avec un en-tête expliquant le format (cf.
    _ENTETE_FICHIER_NOTEBOOK_PY), PUIS copie CE FICHIER dans le
    presse-papier système (comme un Ctrl+C d'un fichier dans l'Explorateur
    -- décision explicite utilisateur : "je veux copier le fichier .py",
    "pas copier son contenu, copier le fichier lui-même" -- PAS le texte
    du fichier, un vrai CF_HDROP/liste d'URLs collable ensuite avec
    Ctrl+V dans un dossier ou un éditeur qui accepte un fichier déposé).

    Chaque cellule est délimitée par le motif "# ==== CELLULE #<rang>
    titre="..." ====" (cf. _construire_texte_notebook_complet) -- ce même
    motif est celui reconnu par le bouton "Coller" voisin (cf.
    NotebookPasteHandleCompact) pour remettre à jour le notebook depuis ce
    fichier.

    Nom de classe conservé tel quel (NotebookDragHandleCompact) pour ne
    rien casser chez l'appelant existant (TaskConfigScreen._bouton_drag_
    notebook, cf. son site de construction) -- seul le GESTE change, plus
    aucun QDrag natif ici (copie immédiate au clic, pas un vrai
    glisser-déposer).

    task_factory : callable() -> Optional[Task], même contrat qu'avant --
    relu au moment du clic plutôt qu'une référence figée à la construction.

    DISTINCTION VISUELLE (retour utilisateur : "il y aura pas mal de
    boutons avec icône de copie ou collage, gère bien ça, essaie de les
    distinguer visuellement" -- cette toolbar aligne déjà bouton_copier_
    toutes_cellules, ce bouton-ci, le bouton "Coller" voisin, ET "Copier
    docs" un peu plus loin) : icône mdi6.code-tags (évoque explicitement
    DU CODE), PAS mdi6.content-copy déjà pris par bouton_copier_toutes_
    cellules juste à gauche -- deux boutons voisins à l'icône identique
    (seul le tooltip différait) étaient impossibles à distinguer au
    survol rapide."""

    def __init__(self, task_factory, parent=None):
        super().__init__(parent)
        self._task_factory = task_factory
        self.setObjectName("APIFeaturesMenuButton")
        self.setIcon(qta.icon("mdi6.code-tags", color=Mocha.subtext0))
        self.setIconSize(QSize(18, 18))
        self.setCursor(Qt.PointingHandCursor)
        self.setToolTip("Copier le code du notebook (fichier .py)")
        self.clicked.connect(self._sur_clic)

    def _sur_clic(self):
        task = self._task_factory()
        if task is None:
            return
        contenu = _construire_fichier_notebook_py(task)
        if not contenu.strip():
            return

        # Même dossier temporaire dédié que l'ancien geste de drag (PAS
        # Téléchargements, pour ne pas y accumuler un fichier à chaque
        # clic) -- l'emplacement exact importe peu (décision explicite
        # utilisateur : "je m'en fous de où il est stocké"), seul compte
        # le fait qu'un VRAI fichier existe sur disque au moment de la
        # copie, prêt à être collé ailleurs.
        nom_suggere = re.sub(r'[<>:"/\\|?*]', "_", task.nom).strip() or "task"
        dossier_tmp = Path(tempfile.gettempdir()) / "AutoniaX_copie_code"
        dossier_tmp.mkdir(parents=True, exist_ok=True)
        chemin = dossier_tmp / f"{nom_suggere}.py"
        try:
            with open(chemin, "w", encoding="utf-8") as f:
                f.write(contenu)
        except OSError:
            return  # copie silencieusement annulée -- même filet que l'ancien drag

        # Copie le FICHIER lui-même (CF_HDROP sous Windows), PAS son texte
        # -- même mécanisme que ApercuDragHandle (cf. sa docstring) : un
        # Ctrl+V dans l'Explorateur, VSCode, ou tout autre appli acceptant
        # un fichier déposé colle ce .py directement.
        mime = QMimeData()
        mime.setUrls([QUrl.fromLocalFile(str(chemin))])
        QGuiApplication.clipboard().setMimeData(mime)

        self.setIcon(qta.icon("mdi6.check", color=Mocha.green))
        self.setToolTip("Copié ! (Ctrl+V pour coller le fichier .py)")
        QTimer.singleShot(1200, self._restaurer_icone)

    def _restaurer_icone(self):
        self.setIcon(qta.icon("mdi6.code-tags", color=Mocha.subtext0))
        self.setToolTip("Copier le code du notebook (fichier .py)")


class NotebookPasteHandleCompact(QToolButton):
    """Pendant du bouton ci-dessus (demande explicite utilisateur : "le
    bouton coller va être directement utilisé pour mettre à jour le
    notebook") -- lit le presse-papier système, reconnaît les blocs "# ====
    CELLULE #<rang> titre="..." ====" (cf. _parser_texte_notebook_colle,
    même motif que NotebookDragHandleCompact génère) et met à jour le Task
    actuellement ouvert EN PLACE :

    - rang 0            -> cellule_variables (titre/description/code écrasés)
    - rang 1..len(cellules) -> la cellule EXISTANTE à cette position dans
      task.cellules (correspondance par POSITION, jamais par id -- même
      raisonnement que le rang côté copie : coller doit recaler sur "la
      Nième cellule de CE notebook", pas sur un id qui n'a de sens que dans
      le notebook d'origine du texte copié)
    - rang au-delà de len(cellules) -> nouvelle cellule créée et ajoutée à
      LA FIN du notebook, dans l'ordre d'apparition des rangs en trop
      (décision explicite utilisateur : "ajouter si il y en a plus")

    Callback update_callback : callable(dict[int, dict]) -> None, fourni
    par TaskConfigScreen (cf. son site de construction) -- c'est lui qui
    connaît task/self.project/_ouvrir_task, ce widget reste un simple
    bouton sans logique de modèle.

    DISTINCTION VISUELLE (cf. docstring NotebookDragHandleCompact pour le
    contexte complet -- plusieurs boutons copier/coller voisins dans cette
    même toolbar) : icône mdi6.upload-outline (même symbole déjà utilisé
    ailleurs dans ce fichier pour "Mettre à jour le notebook", cf. le menu
    ⋮ de la toolbar -- cohérent sémantiquement : ce bouton MODIFIE le
    notebook, contrairement au bouton "copier" voisin qui est purement
    lecture) EN Mocha.lavender (teinte accentuée, jamais utilisée par les
    autres boutons copier/coller de cette toolbar, tous gris subtext0) --
    signale d'un coup d'œil que ce bouton-ci a un effet, pas seulement les
    deux autres tons (gris = lecture, lavande = écriture)."""

    def __init__(self, update_callback, parent=None):
        super().__init__(parent)
        self._update_callback = update_callback
        self.setObjectName("APIFeaturesMenuButton")
        self.setIcon(qta.icon("mdi6.upload-outline", color=Mocha.lavender))
        self.setIconSize(QSize(18, 18))
        self.setCursor(Qt.PointingHandCursor)
        self.setToolTip("Coller pour mettre à jour le notebook (titre, description et code de chaque cellule)")
        self.clicked.connect(self._sur_clic)

    def _sur_clic(self):
        # Lit TOUJOURS directement le texte du presse-papier -- jamais de
        # lecture de fichier sur disque, même si le presse-papier contient
        # une URL de fichier .py (décision explicite utilisateur, en
        # réaction directe à l'ancien mécanisme qui lisait d'abord un
        # fichier référencé : "le bouton coller doit pas lire de fichier,
        # toujours le contenu direct"). Conséquence assumée : Copier puis
        # Coller enchaînés sans rien d'autre entre les deux ne collent
        # plus rien automatiquement -- le flux attendu est Copier (dépose
        # le .py), éditer ce fichier dans un éditeur externe, Ctrl+A/Ctrl+C
        # DANS cet éditeur, puis Coller dans AutoniaX.
        texte = QGuiApplication.clipboard().text()
        blocs = _parser_texte_notebook_colle(texte) if texte else {}
        if not blocs:
            self.setIcon(qta.icon("mdi6.alert-outline", color=Mocha.red))
            self.setToolTip("Presse-papier vide ou format non reconnu")
            QTimer.singleShot(1600, self._restaurer_icone)
            return
        self._update_callback(blocs)
        self.setIcon(qta.icon("mdi6.check", color=Mocha.green))
        self.setToolTip("Notebook mis à jour !")
        QTimer.singleShot(1200, self._restaurer_icone)

    def _restaurer_icone(self):
        self.setIcon(qta.icon("mdi6.upload-outline", color=Mocha.lavender))
        self.setToolTip("Coller pour mettre à jour le notebook (titre, description et code de chaque cellule)")


class ApercuDragHandle(QToolButton):
    """SIMPLIFICATION (demande explicite utilisateur : "on simplifie
    radicalement : plus de QDrag, plus de hide()/showMinimized() -- juste
    un clic simple qui copie les deux images dans le presse-papier. C'est
    beaucoup plus robuste") -- remplace l'ancien mécanisme de QDrag natif
    (abandonné après plusieurs allers-retours : image de drag non
    reconnaissable, puis drag purement et simplement cassé par le
    hide()/showMinimized() de la fenêtre source pendant drag.exec()
    bloquant, symptôme Windows connu de perte du grab souris natif). Le
    nom de la classe et son constructeur restent inchangés (mêmes deux
    factories) pour ne rien casser chez les appelants existants
    (InstanceApercuScreen, TestComposantScreen, FenetreRenduTaskReseau...)
    -- seul le geste change : un simple clic gauche (plus de drag/drop)
    copie dans le presse-papier système une LISTE de fichiers (CF_HDROP
    sous Windows, via QMimeData.setUrls -- même mécanisme qu'un Ctrl+C de
    fichiers dans l'Explorateur), collable (Ctrl+V) dans n'importe quelle
    appli qui accepte un collage de fichiers. Choix de CF_HDROP plutôt
    qu'un bitmap direct (setImage) : QClipboard ne sait coller qu'UNE
    seule image bitmap à la fois -- une liste de fichiers est le seul
    mécanisme presse-papier standard qui transporte les DEUX images
    demandées (capture + composant testé) en un seul Ctrl+V.

    apercu_label_factory : callable() -> Optional[QLabel], réévalué à
    CHAQUE clic plutôt que figé à la construction -- nécessaire en
    particulier parce que CoordonneeActionScreen substitue apercu_label
    EN PLACE par un ApercuTraceableLabel (cf. sa docstring) : une
    référence figée à la construction pointerait vers un label qui n'est
    plus forcément celui affiché.

    image_composant_teste_factory : callable() -> Optional[Path] optionnel
    (None par défaut), réévalué à CHAQUE clic (même principe que
    apercu_label_factory) -- retourne le chemin ABSOLU de l'image du
    composant actuellement testé (cf. TestComposantScreen.__init__ :
    get_app_data_dir() / self.composant.image_path), ou None si aucun
    composant sélectionné/aucune image valide sur disque. Quand fournie
    et valide, ce SECOND fichier est ajouté à la liste d'URLs copiée EN
    PLUS de la capture actuelle."""

    def __init__(self, apercu_label_factory, parent=None,
                 texte_tooltip: str = "Copier cette capture (Ctrl+V pour coller)",
                 image_composant_teste_factory=None,
                 mode_bitmap_direct: bool = False):
        super().__init__(parent)
        self._apercu_label_factory = apercu_label_factory
        self._image_composant_teste_factory = image_composant_teste_factory
        # AJOUT (spec D.1) -- uniquement utilisé par FenetreRenduTaskReseau :
        # court-circuite toute la sérialisation fichier temporaire/CF_HDROP
        # ci-dessous pour copier directement un bitmap dans le presse-papier
        # (QGuiApplication.clipboard().setPixmap). Comportement par défaut
        # (False) strictement inchangé pour tous les autres appelants
        # (InstanceApercuScreen, TestComposantScreen, DashboardScreen,
        # ProfilsInstancesScreen, CoordonneeActionScreen, etc.).
        self._mode_bitmap_direct = mode_bitmap_direct
        self.setObjectName("APIFeaturesMenuButton")
        self.setIcon(qta.icon("mdi6.content-copy", color=Mocha.subtext0))
        self.setIconSize(QSize(18, 18))
        self.setCursor(Qt.PointingHandCursor)
        self.setToolTip(texte_tooltip)
        self.clicked.connect(self._sur_clic)

    def _sur_clic(self):
        label = self._apercu_label_factory()
        if label is None:
            return
        # ApercuTraceableLabel (substitué EN PLACE par CoordonneeActionScreen,
        # cf. docstring de classe) ne passe jamais par setPixmap() -- il
        # garde son image dans _pixmap_base et se peint lui-même
        # (paintEvent). label.pixmap() y renverrait donc toujours vide
        # même quand une capture est bien affichée à l'écran : on lit
        # _pixmap_base en priorité quand il existe, sinon on retombe sur
        # pixmap() (QLabel standard, cas InstanceApercuScreen/
        # FenetreRenduTaskReseau/DashboardScreen).
        #
        # CORRECTIF (retour explicite utilisateur : "sa doit prendre
        # l'image sans les dessins qui sont dessus, dessins de
        # correspondance") -- TestComposantScreen._afficher_apercu_avec_
        # resultat dessine les rectangles verts/jaunes DIRECTEMENT sur le
        # pixmap posé par setPixmap() (cf. son docstring) : label.pixmap()
        # y renvoie donc l'image ANNOTÉE, pas la capture brute. Cette
        # méthode pose aussi _pixmap_brute_sans_overlay (la QImage reçue
        # avant toute annotation) sur le label -- prioritaire ici sur
        # _pixmap_base ET pixmap(), pour que la copie transporte
        # systématiquement la capture SANS les rectangles de
        # correspondance, quel que soit l'écran hôte.
        pixmap = getattr(label, "_pixmap_brute_sans_overlay", None)
        if pixmap is None:
            pixmap = getattr(label, "_pixmap_base", None)
        if pixmap is None:
            pixmap = label.pixmap()
        if pixmap is None or pixmap.isNull():
            return  # rien à copier tant qu'aucune capture n'a encore été reçue

        # CORRECTIF (spec D.1, FenetreRenduTaskReseau uniquement) -- copie
        # bitmap directe dans le presse-papier système, sans passer par un
        # fichier temporaire ni par CF_HDROP (QMimeData.setUrls). De
        # nombreuses cibles de collage (éditeurs d'image, champs de chat
        # attendant un Ctrl+V d'image bitmap) n'acceptent pas le format
        # CF_HDROP -- d'où le "ça ne fonctionne pas" ressenti sur cet écran
        # précis. image_composant_teste_factory est de toute façon toujours
        # None pour l'appel fait depuis FenetreRenduTaskReseau : ce
        # court-circuit ne perd donc aucune fonctionnalité pour cet
        # appelant. Tous les autres écrans utilisant ApercuDragHandle
        # gardent mode_bitmap_direct=False (valeur par défaut) et
        # continuent d'utiliser le mécanisme de fichier(s) ci-dessous,
        # strictement inchangé.
        if self._mode_bitmap_direct:
            QGuiApplication.clipboard().setPixmap(pixmap)
            return

        # Même dossier temporaire dédié que l'ancien mécanisme de drag
        # (PAS Téléchargements). Nom horodaté (pas de nom de profil/
        # instance fiable ici à tous les appelants, cf. docstring de
        # classe) pour éviter qu'une copie précédente laisse un fichier
        # périmé au même chemin.
        #
        # Le QPixmap est d'abord sérialisé en PNG EN MÉMOIRE (jamais
        # écrit sur disque à cette étape, cf. QBuffer), puis réencodé en
        # WEBP via Pillow avant l'écriture disque réelle -- si Pillow est
        # absent (PILLOW_DISPONIBLE=False) ou si la conversion échoue
        # pour une raison quelconque, retombe sur l'ancien comportement
        # (.png natif QPixmap) plutôt que de faire échouer la copie pour
        # ce seul motif.
        dossier_tmp = Path(tempfile.gettempdir()) / "AutoniaX_drag"
        dossier_tmp.mkdir(parents=True, exist_ok=True)
        horodatage = datetime.now().strftime('%Y%m%d_%H%M%S_%f')
        chemin = None
        if PILLOW_DISPONIBLE:
            try:
                buffer_qt = QBuffer()
                buffer_qt.open(QIODevice.WriteOnly)
                pixmap.save(buffer_qt, "PNG")
                donnees_png = bytes(buffer_qt.data())
                buffer_qt.close()
                with io.BytesIO(donnees_png) as buffer_entree:
                    img = PILImage.open(buffer_entree)
                    img.load()
                    if img.mode not in ("RGB", "RGBA"):
                        img = img.convert("RGB")
                    chemin_webp = dossier_tmp / f"capture_{horodatage}.webp"
                    img.save(str(chemin_webp), "WEBP", quality=70)
                chemin = chemin_webp
            except Exception:
                chemin = None  # retombe sur le PNG natif ci-dessous
        if chemin is None:
            chemin = dossier_tmp / f"capture_{horodatage}.png"
            if not pixmap.save(str(chemin), "PNG"):
                return  # copie silencieusement annulée -- rien de valide à copier

        # urls_copiees commence avec la capture (chemin ci-dessus,
        # TOUJOURS en premier -- c'est elle que récupère une zone de
        # collage qui n'accepte qu'un seul fichier) puis ajoute l'image
        # du composant testé si image_composant_teste_factory est
        # fournie ET renvoie un chemin qui existe réellement sur disque
        # (composant sans variante/image invalide -> None, silencieusement
        # ignoré, la copie de la capture seule reste alors identique au
        # comportement sans cette factory).
        urls_copiees = [QUrl.fromLocalFile(str(chemin))]
        if self._image_composant_teste_factory is not None:
            chemin_composant = self._image_composant_teste_factory()
            if chemin_composant is not None and Path(chemin_composant).exists():
                urls_copiees.append(QUrl.fromLocalFile(str(chemin_composant)))

        mime = QMimeData()
        mime.setUrls(urls_copiees)
        QGuiApplication.clipboard().setMimeData(mime)


class VisionneuseCapturePropre(QDialog):
    """Visionneuse MINIMALE d'une capture (demande explicite utilisateur :
    "une capture propre de l'interface et l'ouvrir directement ici dans un
    visualisateur minimal"). Fenêtre non modale, sans barre d'outils : juste
    l'image, ajustée à la taille de la fenêtre (ratio conservé, redimensionnable).
    Ctrl+C ou clic droit > "Copier l'image" : copie l'image dans le presse-papier.
    Échap : ferme."""

    def __init__(self, pixmap: QPixmap, titre: str = "Capture", parent=None):
        super().__init__(parent)
        self.setWindowTitle(titre)
        self.setAttribute(Qt.WA_DeleteOnClose, True)
        self.setStyleSheet(f"QDialog {{ background: {Mocha.crust}; }}")
        self._pixmap = pixmap
        layout = QVBoxLayout(self)
        layout.setContentsMargins(0, 0, 0, 0)
        self._label = QLabel(self)
        self._label.setAlignment(Qt.AlignCenter)
        self._label.setMinimumSize(1, 1)
        self._label.setSizePolicy(QSizePolicy.Ignored, QSizePolicy.Ignored)
        layout.addWidget(self._label)
        self.setContextMenuPolicy(Qt.CustomContextMenu)
        self.customContextMenuRequested.connect(self._menu_contextuel)
        QShortcut(QKeySequence(QKeySequence.StandardKey.Copy), self, activated=self._copier_image)
        QShortcut(QKeySequence(Qt.Key_Escape), self, activated=self.close)
        self._taille_initiale()
        self._afficher()

    def _taille_initiale(self):
        ecran = QGuiApplication.primaryScreen()
        max_l, max_h = (1280, 800)
        if ecran is not None:
            geo = ecran.availableGeometry()
            max_l, max_h = int(geo.width() * 0.8), int(geo.height() * 0.8)
        l, h = max(self._pixmap.width(), 1), max(self._pixmap.height(), 1)
        ratio = min(1.0, max_l / l, max_h / h)
        self.resize(max(320, int(l * ratio)), max(240, int(h * ratio)))

    def definir_image(self, pixmap: QPixmap, titre: Optional[str] = None):
        self._pixmap = pixmap
        if titre:
            self.setWindowTitle(titre)
        self._afficher()

    def _afficher(self):
        if self._pixmap.isNull():
            return
        self._label.setPixmap(self._pixmap.scaled(
            self._label.size(), Qt.KeepAspectRatio, Qt.SmoothTransformation,
        ))

    def resizeEvent(self, event):
        super().resizeEvent(event)
        self._afficher()

    def _copier_image(self):
        QGuiApplication.clipboard().setPixmap(self._pixmap)

    def _menu_contextuel(self, pos):
        menu = QMenu(self)
        menu.addAction("Copier l'image").triggered.connect(self._copier_image)
        menu.addAction("Fermer").triggered.connect(self.close)
        menu.exec(self.mapToGlobal(pos))


class DocIACopyButton(QWidget):
    """AJOUT (demande explicite utilisateur : "un bouon qui vas pluot
    copier le contenue dans le presse papier , donc un bouton copier
    docs , je veux que nimporte quel ia comprend comment la logique de
    codage de tache fontionne") -- juste sous NotebookDragHandle dans le
    panneau Accès rapide (même endroit, même style de widget "action
    globale" hors du scroll de cellules).

    PATCH (SPEC_GLOBALE_AutoniaX.md, Partie B §3.2 -- demande explicite
    utilisateur : "je veux que la documentation soit dans un fichier html
    sauvegardé sur le disque ... ainsi on va pouvoir mettre à jour sans
    modifier le code source de l'app") -- copie désormais le contenu de
    documentation.html (cf. lire_documentation_disque()) dans le presse-
    papier système, PLUS la génération en dur en Python
    (_generer_html_doc_rapide(), supprimée) : le contenu copié est
    entièrement défini par ce que l'utilisateur a collé une fois via le
    bouton "Coller" des Paramètres (cf. Partie B §4), prêt à coller tel
    quel dans une conversation avec n'importe quelle IA. Si aucun contenu
    n'a encore été renseigné sur cette machine, lire_documentation_disque()
    retourne une chaîne vide -- le bouton copie alors une chaîne vide,
    sans erreur (comportement attendu, pas un cas à gérer spécialement).

    Simple QWidget cliquable (pas de drag ici, contrairement à
    NotebookDragHandle juste au-dessus) : un clic = une copie, pas de
    geste à distinguer d'autre chose sur ce widget précis."""

    def __init__(self, parent=None):
        super().__init__(parent)
        self.setObjectName("DocIACopyButton")
        self.setCursor(Qt.PointingHandCursor)
        self.setToolTip("Copier le fichier documentation.html dans le presse-papier (Ctrl+V pour coller le fichier), pour le transmettre à une IA")

        layout = QHBoxLayout(self)
        layout.setContentsMargins(8, 8, 8, 8)
        layout.setSpacing(8)

        self._icone_label = QLabel(self)
        self._icone_label.setPixmap(qta.icon("mdi6.content-copy", color=Mocha.lavender).pixmap(20, 20))
        layout.addWidget(self._icone_label)

        self._texte_label = QLabel("Copier docs", self)
        self._texte_label.setObjectName("NotebookDragHandleTexte")
        layout.addWidget(self._texte_label, 1)

    def mousePressEvent(self, event):
        if event.button() == Qt.LeftButton:
            # CORRECTIF (demande explicite utilisateur : "je veux que tu
            # modifie la facon dont la documentation est copiee, sa doit
            # copier directement le fichier et non le contenue") -- copie
            # désormais le FICHIER documentation.html lui-même (CF_HDROP),
            # plus son contenu texte -- cf. docstring de
            # copier_fichier_documentation_presse_papier pour le détail et
            # le repli si le fichier n'existe pas encore.
            copier_fichier_documentation_presse_papier()
            # Retour visuel bref (icône coche + texte "Copié !" pendant
            # 1.2s) -- même besoin que n'importe quel bouton "copier" :
            # confirmer que le clic a bien fonctionné, sans boîte de
            # dialogue bloquante pour un geste aussi anodin. Se déclenche
            # même si aucune documentation n'a encore été renseignée sur
            # cette machine (comportement voulu, cf. docstring de la
            # classe et de copier_fichier_documentation_presse_papier).
            self._icone_label.setPixmap(qta.icon("mdi6.check", color=Mocha.green).pixmap(20, 20))
            self._texte_label.setText("Copié !")
            QTimer.singleShot(1200, self._restaurer_apparence)
        super().mousePressEvent(event)

    def _restaurer_apparence(self):
        self._icone_label.setPixmap(qta.icon("mdi6.content-copy", color=Mocha.lavender).pixmap(20, 20))
        self._texte_label.setText("Copier docs")


